# Reference copy of .ssd/ssd.yaml — the real one is gitignored, because deploy
# config names an SSH host from a personal ~/.ssh/config and is machine-local.
#
# On a new machine:  mkdir -p .ssd && cp website/ssd.yaml.example .ssd/ssd.yaml
#
# Keep the two in step by hand. Nothing enforces it: ssd never reads this file.
runtime: k3s
server: byteink.main
stack: /stacks/bitlang

services:
  website:
    # A Dockerfile rather than `image: nginx` + `files:`. `files:` maps ONE file
    # to ONE path, which was fine at three pages and wrong at 34 (#1824): a
    # missing line serves a 404 instead of failing the deploy, and every new page
    # would need one. COPY takes the directory.
    #
    # Context is the repo root because website/public/ is generated from docs/ and
    # examples/ elsewhere in the tree.
    dockerfile: ./website/Dockerfile
    context: .
    port: 80
    domains:
      - bitlang.org
      - www.bitlang.org
      - bitlang.io
      - www.bitlang.io
      - bitlang.net
      - www.bitlang.net
    redirect_to: bitlang.org
    healthcheck:
      # nginx:alpine ships wget (busybox), not curl.
      cmd: "wget -q -O /dev/null http://localhost:80/ || exit 1"
      interval: 30s
      timeout: 5s
      retries: 3
