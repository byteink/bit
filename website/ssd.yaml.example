# Reference copy of .ssd/ssd.yaml — the real one is gitignored, because deploy
# config names an SSH host from a personal ~/.ssh/config and is machine-local.
#
# On a new machine:  mkdir -p .ssd && cp website/ssd.yaml.example .ssd/ssd.yaml
#
# Keep the two in step by hand. Nothing enforces it: ssd never reads this file.
runtime: k3s
server: byteink.main
stack: /stacks/bitlang

services:
  website:
    # Off-the-shelf nginx, no build — the same use of `image:` as playnext's
    # postgres. The site is three static files that already exist in the repo; a
    # Dockerfile would mean an image build and a registry push per content change
    # to ship bytes that are already sitting there. `files:` mounts them instead.
    image: nginx:1.30-alpine
    port: 80
    domains:
      - bitlang.org
      - www.bitlang.org
      - bitlang.io
      - www.bitlang.io
      - bitlang.net
      - www.bitlang.net
    redirect_to: bitlang.org
    # Generated by `sh website/support.sh`, which website/deploy.sh runs first so
    # a deploy can never ship a stale support matrix. Listed one by one because
    # `files:` maps file to path — a NEW page needs a line here too.
    files:
      ./website/public/index.html: /usr/share/nginx/html/index.html
      ./website/public/support.html: /usr/share/nginx/html/support.html
      ./website/public/support.css: /usr/share/nginx/html/support.css
    healthcheck:
      # nginx:alpine ships wget (busybox), not curl.
      cmd: "wget -q -O /dev/null http://localhost:80/ || exit 1"
      interval: 30s
      timeout: 5s
      retries: 3
