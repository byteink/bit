# Reference copy of .ssd/ssd.yaml — the real one is gitignored, because deploy
# config names an SSH host from a personal ~/.ssh/config and is machine-local.
#
# On a new machine:  mkdir -p .ssd && cp website/ssd.yaml.example .ssd/ssd.yaml
#
# Keep the two in step by hand. Nothing enforces it: ssd never reads this file.
#
# `server:` is an SSH alias resolved from YOUR ~/.ssh/config, so it is a
# placeholder here rather than the real host - the deploy target is not repo
# content.
runtime: k3s
server: your-ssh-host        # an SSH alias from your own ~/.ssh/config
stack: /stacks/bitlang

services:
  website:
    # A Dockerfile rather than `image: nginx` + `files:`. `files:` maps ONE file
    # to ONE path, which was fine at three pages and wrong at 34 (#1824): a
    # missing line serves a 404 instead of failing the deploy, and every new page
    # would need one. COPY takes the directory.
    #
    # Context is the repo root because website/public/ is generated from docs/ and
    # examples/ elsewhere in the tree.
    dockerfile: ./website/Dockerfile
    context: .
    # 8080, matching the Dockerfile's ENTRYPOINT and EXPOSE. NOT 80: the image
    # runs as uid 65532, and a non-root process cannot bind a privileged port.
    port: 8080
    domains:
      - bitlang.org
      - www.bitlang.org
      - bitlang.io
      - www.bitlang.io
      - bitlang.net
      - www.bitlang.net
    redirect_to: bitlang.org

    # NO healthcheck, deliberately. ssd offers only exec-style probes (`cmd`, a
    # shell string, or `exec`, an argv), and the image is FROM scratch: there is
    # no shell for `cmd` and no second binary for `exec`. The old
    # `wget -q -O /dev/null ...` line was left over from nginx:alpine (busybox
    # wget); against this image it can never pass, so the container would be
    # marked unhealthy forever.
    #
    # Do not "fix" this by adding busybox to the image - that trades a real
    # security property (one static binary, no shell to escalate into) for a
    # liveness probe on a stateless file server that either serves or is dead.
    # The right fix is an httpGet probe, which needs ssd support.
