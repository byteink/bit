# The bitlang.org site: stock nginx plus the generated pages.
#
# This exists because ssd's `files:` maps ONE file to ONE container path, and the
# site outgrew that. It was three pages when the config was written; the Bit
# generator (#1824) now emits 34, some under docs/, and a `files:` list would
# need a line per page — with a missing line silently serving a 404 rather than
# failing the deploy. COPY takes the directory and needs no list.
#
# Build context is the repo root (ssd's `context: .`), so the path below is
# repo-relative. website/public/ is generated by `website/gen`; website/deploy.sh
# regenerates it before handing over to ssd, so the image can never be built from
# a stale tree.
FROM nginx:1.30-alpine

# Only the generated site. Not the repo — a `COPY . .` here would put the whole
# compiler source, git history and all, inside a public web root.
COPY website/public/ /usr/share/nginx/html/

# nginx:alpine already serves /usr/share/nginx/html on :80 with a sane default
# config, so there is nothing to configure. No CMD, no ENTRYPOINT: the base
# image's are correct.
