// bitlang.org site generator — the markdown subset the docs corpus actually uses.
//
// Not a CommonMark implementation and not trying to be. The whole of `docs/` was
// measured before this was written: 1006 `###`, 582 fenced blocks, 203 `##`, 121
// table rows, 71 `- ` items, 32 `#`, 19 `**`, 4 ordered items, 2 blockquotes. No
// images, no HTML blocks, no footnotes, no nested lists. Anything outside that
// set renders as escaped text rather than being silently dropped, so a doc that
// grows a new construct shows up as visibly wrong instead of vanishing.
//
// The one rule that matters more than the rest: a fenced block's contents are
// NEVER parsed. 582 of them contain `#`, `|` and `-` as Bit source, and treating
// any of it as markdown would corrupt the code a reader is meant to copy.

// Siblings in a directory are ONE module, so these imports serve every file in
// website/gen — importing the same name again in a sibling is E0042 "already
// declared in this scope". They live here because md.bit sorts first.
import { split, hasPrefix, hasSuffix, indexOf, trimSpace, toLower, newBuilder } from "std/strings"
import { readFile, writeFile, readDir, exists, mkdir, isDir } from "std/fs"

// One rendered document: the HTML body, plus the headings for a page's own
// in-page table of contents.
export struct Doc { html: string, headings: []Heading }

// A heading, for the in-page nav. `level` is 1-4, `id` is the slug the <h*>
// carries so an anchor can reach it.
export struct Heading { level: int, text: string, id: string }

// `&`, `<` and `>` to entities. Everything a document contributes goes through
// this — text, code, table cells, link text. A doc containing `<script>` must
// render as visible characters; support.sh's own self-check pins that behaviour
// for the shell generator and this one owes the same guarantee.
//
// `&` FIRST, or every entity this function writes gets re-escaped into
// `&amp;lt;` by the following passes.
export function escapeHtml(s: string): string {
  let b = newBuilder()
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == 38) {
      b = b.write("&amp;")
    } else {
      if (c == 60) {
        b = b.write("&lt;")
      } else {
        if (c == 62) {
          b = b.write("&gt;")
        } else {
          b = b.writeByte(c)
        }
      }
    }
    i = i + 1
  }
  return b.toString()
}

// A heading's text to an id: lowercase, alphanumerics kept, every run of
// anything else collapsed to one `-`, no leading or trailing `-`.
//
// Collision handling is the CALLER's job (see `uniqueId`): two headings named
// "Errors" in one document would otherwise both answer to `#errors` and the
// second anchor would be unreachable.
export function slug(s: string): string {
  let b = newBuilder()
  let lower = toLower(s)
  let lastDash = true
  let i = 0
  while (i < len(lower)) {
    let c = lower[i]
    let isNum = c >= 48 && c <= 57
    let isAlpha = c >= 97 && c <= 122
    if (isNum || isAlpha) {
      b = b.writeByte(c)
      lastDash = false
    } else {
      if (!lastDash) {
        b = b.write("-")
        lastDash = true
      }
    }
    i = i + 1
  }
  let out = b.toString()
  // A trailing separator run left one dash behind.
  if (len(out) > 0 && out[len(out) - 1] == 45) {
    return out[0:len(out) - 1]
  }
  return out
}

// `base`, suffixed `-2`, `-3`, ... until it is not in `seen`. Two same-named
// headings in one page are common (every stdlib doc has several `### Errors`),
// and a duplicate id makes the later anchors dead links.
function uniqueId(seen: []string, base: string): string {
  let candidate = base
  if (len(candidate) == 0) {
    candidate = "section"
  }
  let n = 2
  while (containsStr(seen, candidate)) {
    candidate = "${base}-${n}"
    n = n + 1
  }
  return candidate
}

function containsStr(xs: []string, want: string): bool {
  for x of xs {
    if (x == want) {
      return true
    }
  }
  return false
}

// Markdown inline markers removed, leaving readable plain text: `code` and
// **bold** lose their delimiters, [text](url) keeps only its text. For places
// that need prose without markup — a <title>, a one-line blurb — where escaping
// alone would print the backticks and asterisks at the reader.
export function stripInline(s: string): string {
  let b = newBuilder()
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == 96) {
      i = i + 1
      continue
    }
    if (c == 42) {
      i = i + 1
      continue
    }
    // [text](url) -> text
    if (c == 91) {
      let closeText = indexOfFrom(s, 93, i + 1)
      if (closeText > 0 && closeText + 1 < len(s) && s[closeText + 1] == 40) {
        let closeUrl = indexOfFrom(s, 41, closeText + 2)
        if (closeUrl > 0) {
          b = b.write(s[i + 1:closeText])
          i = closeUrl + 1
          continue
        }
      }
    }
    b = b.writeByte(c)
    i = i + 1
  }
  return b.toString()
}

// `s` cut to at most `max` characters, at a word boundary, with an ellipsis when
// anything was dropped. Cutting mid-word reads like a bug; cutting at a space
// reads like a summary.
export function summarize(s: string, max: int): string {
  if (len(s) <= max) {
    return s
  }
  let cut = max
  while (cut > 0 && s[cut] != 32) {
    cut = cut - 1
  }
  if (cut == 0) {
    cut = max
  }
  return "${s[0:cut]}..."
}

// Inline markup, applied to a line of prose AFTER escaping: `code`, **bold**,
// [text](url). Order matters — inline code is resolved first, so `**` inside a
// code span is left alone.
export function inline(s: string): string {
  return links(bold(code(escapeHtml(s))))
}

// `` `x` `` → <code>x</code>. An unpaired backtick is left as a literal
// backtick rather than swallowing the rest of the line.
function code(s: string): string {
  let b = newBuilder()
  let i = 0
  while (i < len(s)) {
    if (s[i] != 96) {
      b = b.writeByte(s[i])
      i = i + 1
      continue
    }
    let close = indexOfFrom(s, 96, i + 1)
    if (close < 0) {
      b = b.writeByte(s[i])
      i = i + 1
      continue
    }
    b = b.write("<code>")
    b = b.write(s[i + 1:close])
    b = b.write("</code>")
    i = close + 1
  }
  return b.toString()
}

// `**x**` → <strong>x</strong>. An unpaired `**` stays literal.
function bold(s: string): string {
  let b = newBuilder()
  let i = 0
  while (i < len(s)) {
    if (s[i] == 42 && i + 1 < len(s) && s[i + 1] == 42) {
      let close = indexOfPairFrom(s, i + 2)
      if (close >= 0) {
        b = b.write("<strong>")
        b = b.write(s[i + 2:close])
        b = b.write("</strong>")
        i = close + 2
        continue
      }
    }
    b = b.writeByte(s[i])
    i = i + 1
  }
  return b.toString()
}

// `[text](url)` → <a href="url">text</a>. A `.md` target is rewritten to its
// generated page by `rewriteLink`, or every cross-reference in the reference
// docs would 404.
function links(s: string): string {
  let b = newBuilder()
  let i = 0
  while (i < len(s)) {
    if (s[i] != 91) {
      b = b.writeByte(s[i])
      i = i + 1
      continue
    }
    let closeText = indexOfFrom(s, 93, i + 1)
    if (closeText < 0 || closeText + 1 >= len(s) || s[closeText + 1] != 40) {
      b = b.writeByte(s[i])
      i = i + 1
      continue
    }
    let closeUrl = indexOfFrom(s, 41, closeText + 2)
    if (closeUrl < 0) {
      b = b.writeByte(s[i])
      i = i + 1
      continue
    }
    let text = s[i + 1:closeText]
    let url = rewriteLink(s[closeText + 2:closeUrl])
    b = b.write("<a href=\"${url}\">${text}</a>")
    i = closeUrl + 1
  }
  return b.toString()
}

// A relative `foo.md` link becomes `foo.html`; `foo.md#anchor` keeps its anchor.
// Absolute URLs and in-page anchors pass through untouched.
export function rewriteLink(url: string): string {
  if (hasPrefix(url, "http://") || hasPrefix(url, "https://") || hasPrefix(url, "#")) {
    return url
  }
  let hash = indexOf(url, "#")
  let path = url
  let frag = ""
  if (hash >= 0) {
    path = url[0:hash]
    frag = url[hash:len(url)]
  }
  if (hasSuffixStr(path, ".md")) {
    return "${path[0:len(path) - 3]}.html${frag}"
  }
  return url
}

function hasSuffixStr(s: string, suf: string): bool {
  if (len(suf) > len(s)) {
    return false
  }
  return s[len(s) - len(suf):len(s)] == suf
}

function indexOfFrom(s: string, c: u8, start: int): int {
  let i = start
  while (i < len(s)) {
    if (s[i] == c) {
      return i
    }
    i = i + 1
  }
  return -1
}

// The next `**` at or after `start`.
function indexOfPairFrom(s: string, start: int): int {
  let i = start
  while (i + 1 < len(s)) {
    if (s[i] == 42 && s[i + 1] == 42) {
      return i
    }
    i = i + 1
  }
  return -1
}
