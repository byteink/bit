// The block level of the markdown subset: headings, fences, tables, lists,
// blockquotes, paragraphs. Split from md.bit to stay under the 800-line limit;
// siblings are the same module, so nothing here needs an import from it.
//
// One pass over the lines, dispatching on the line's own prefix. No lookahead
// beyond the table separator row, because nothing in the corpus needs it.


// Renders a whole document. `headings` comes back for the page's in-page nav.
export function render(src: string): Doc {
  let lines = split(src, "\n")
  let b = newBuilder()
  let headings = []Heading(0)
  let ids = []string(0)
  let i = 0

  while (i < len(lines)) {
    let line = lines[i]

    // A fence swallows every line up to its closing fence, verbatim. This branch
    // is FIRST because a fenced block's contents look like markdown and must not
    // be treated as any: 582 blocks in the corpus contain `#`, `|` and `-`.
    if (hasPrefix(trimSpace(line), "```")) {
      let lang = trimSpace(trimSpace(line)[3:len(trimSpace(line))])
      let code = newBuilder()
      i = i + 1
      while (i < len(lines) && !hasPrefix(trimSpace(lines[i]), "```")) {
        code = code.write(escapeHtml(lines[i]))
        code = code.write("\n")
        i = i + 1
      }
      // An unterminated fence runs to EOF. Rendering what is there beats
      // dropping the rest of the page.
      i = i + 1
      let cls = ""
      if (len(lang) > 0) {
        cls = " class=\"lang-${lang}\""
      }
      b = b.write("<pre><code${cls}>")
      b = b.write(code.toString())
      b = b.write("</code></pre>\n")
      continue
    }

    if (hasPrefix(line, "#")) {
      let level = 0
      while (level < len(line) && line[level] == 35) {
        level = level + 1
      }
      // `#####` and deeper are not headings here; the corpus stops at ####.
      if (level >= 1 && level <= 4 && level < len(line) && line[level] == 32) {
        let text = trimSpace(line[level:len(line)])
        let id = uniqueId(ids, slug(text))
        ids = append(ids, id)
        headings = append(headings, Heading{ level: level, text: text, id: id })
        b = b.write("<h${level} id=\"${id}\">${inline(text)}</h${level}>\n")
        i = i + 1
        continue
      }
    }

    // A table is a `|` row followed by a `|---|` separator. Without the
    // separator it is just a paragraph that happens to contain pipes.
    if (hasPrefix(trimSpace(line), "|") && i + 1 < len(lines) && isSeparatorRow(lines[i + 1])) {
      b = b.write("<table>\n<thead>\n")
      b = b.write(renderRow(line, true))
      b = b.write("</thead>\n<tbody>\n")
      i = i + 2
      while (i < len(lines) && hasPrefix(trimSpace(lines[i]), "|")) {
        b = b.write(renderRow(lines[i], false))
        i = i + 1
      }
      b = b.write("</tbody>\n</table>\n")
      continue
    }

    if (hasPrefix(line, "- ")) {
      b = b.write("<ul>\n")
      while (i < len(lines) && hasPrefix(lines[i], "- ")) {
        b = b.write("<li>${inline(lines[i][2:len(lines[i])])}</li>\n")
        i = i + 1
      }
      b = b.write("</ul>\n")
      continue
    }

    if (isOrderedItem(line)) {
      b = b.write("<ol>\n")
      while (i < len(lines) && isOrderedItem(lines[i])) {
        let dot = indexOf(lines[i], ". ")
        b = b.write("<li>${inline(lines[i][dot + 2:len(lines[i])])}</li>\n")
        i = i + 1
      }
      b = b.write("</ol>\n")
      continue
    }

    if (hasPrefix(line, "> ")) {
      let quote = newBuilder()
      while (i < len(lines) && hasPrefix(lines[i], "> ")) {
        if (quote.length() > 0) {
          quote = quote.write(" ")
        }
        quote = quote.write(inline(lines[i][2:len(lines[i])]))
        i = i + 1
      }
      b = b.write("<blockquote><p>${quote.toString()}</p></blockquote>\n")
      continue
    }

    // An HTML comment is directive, not content: docs/tutorial.md opens with
    // `<!-- doctest: per-block -->`, which the doc-test harness reads and a
    // reader must never see. Escaping it would print it on the page.
    if (hasPrefix(trimSpace(line), "<!--")) {
      while (i < len(lines) && indexOf(lines[i], "-->") < 0) {
        i = i + 1
      }
      i = i + 1
      continue
    }

    if (len(trimSpace(line)) == 0) {
      i = i + 1
      continue
    }

    // Anything else is a paragraph: consecutive non-blank lines that start no
    // other construct, joined with a space the way markdown reflows them.
    let para = newBuilder()
    while (i < len(lines) && len(trimSpace(lines[i])) > 0 && !startsBlock(lines[i])) {
      if (para.length() > 0) {
        para = para.write(" ")
      }
      para = para.write(inline(trimSpace(lines[i])))
      i = i + 1
    }
    b = b.write("<p>${para.toString()}</p>\n")
  }

  return Doc{ html: b.toString(), headings: headings }
}

// Does this line begin a construct other than a paragraph? Used to end a
// paragraph without consuming the line that ends it.
function startsBlock(line: string): bool {
  let t = trimSpace(line)
  return hasPrefix(t, "```") || hasPrefix(line, "#") || hasPrefix(line, "- ") ||
    hasPrefix(line, "> ") || hasPrefix(t, "|") || hasPrefix(t, "<!--") || isOrderedItem(line)
}

// `1. `, `2. `, ... — digits then ". ".
function isOrderedItem(line: string): bool {
  let i = 0
  while (i < len(line) && line[i] >= 48 && line[i] <= 57) {
    i = i + 1
  }
  if (i == 0 || i + 1 >= len(line)) {
    return false
  }
  return line[i] == 46 && line[i + 1] == 32
}

// A GFM separator row: pipes, dashes, colons and spaces only, and at least one
// dash. `|:-:|---|` qualifies; `| text |` does not.
function isSeparatorRow(line: string): bool {
  let t = trimSpace(line)
  if (!hasPrefix(t, "|")) {
    return false
  }
  let sawDash = false
  let i = 0
  while (i < len(t)) {
    let c = t[i]
    if (c == 45) {
      sawDash = true
    } else {
      if (c != 124 && c != 58 && c != 32) {
        return false
      }
    }
    i = i + 1
  }
  return sawDash
}

// One table row. `head` picks <th> over <td>.
function renderRow(line: string, head: bool): string {
  let cells = splitCells(trimSpace(line))
  let tag = "td"
  if (head) {
    tag = "th"
  }
  let b = newBuilder()
  b = b.write("<tr>")
  for c of cells {
    b = b.write("<${tag}>${inline(c)}</${tag}>")
  }
  b = b.write("</tr>\n")
  return b.toString()
}

// Splits `| a | b |` into its cells, honouring `\|` as a literal pipe inside a
// cell — docs/release/SUPPORT.md has one, and dropping the escape would split
// that row into an extra column and shift every cell after it.
function splitCells(row: string): []string {
  let out = []string(0)
  let cur = newBuilder()
  let i = 0
  // Skip the leading pipe so an empty first cell is not invented.
  if (i < len(row) && row[i] == 124) {
    i = i + 1
  }
  while (i < len(row)) {
    let c = row[i]
    if (c == 92 && i + 1 < len(row) && row[i + 1] == 124) {
      cur = cur.write("|")
      i = i + 2
      continue
    }
    if (c == 124) {
      out = append(out, trimSpace(cur.toString()))
      cur = newBuilder()
      i = i + 1
      continue
    }
    cur = cur.writeByte(c)
    i = i + 1
  }
  // A trailing pipe leaves an empty tail, which is not a cell.
  let tail = trimSpace(cur.toString())
  if (len(tail) > 0) {
    out = append(out, tail)
  }
  return out
}
