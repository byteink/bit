// The shared chrome every generated page wears: head, nav, footer.
//
// One place on purpose. Twenty pages each carrying their own copy of the nav is
// twenty chances for them to drift, and the byteink footer notice (#1822) is
// content the company expects to be identical everywhere it appears.


// One page to generate: where it lands under website/public/, its <title>, and
// how deep it sits (so relative asset links resolve from a subdirectory).
export struct Page { path: string, title: string, depth: int, body: string }

// `../` repeated `depth` times - the prefix that reaches website/public/ from a
// page nested that many directories down. Pages at the root get "".
//
// Root-relative ("/support.css") would be simpler but breaks the local preview,
// where the site is opened from a file path or a subdirectory of a dev server.
function up(depth: int): string {
  let b = newBuilder()
  let i = 0
  while (i < depth) {
    b = b.write("../")
    i = i + 1
  }
  return b.toString()
}

// The full HTML document for one page.
export function document(p: Page, year: string): string {
  let root = up(p.depth)
  let b = newBuilder()
  b = b.write("<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n")
  b = b.write("<meta charset=\"utf-8\">\n")
  b = b.write("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n")
  b = b.write("<title>${p.title}</title>\n")
  b = b.write("<link rel=\"stylesheet\" href=\"${root}site.css\">\n")
  b = b.write("</head>\n<body>\n")
  b = b.write(nav(root))
  b = b.write("<main>\n")
  b = b.write(p.body)
  b = b.write("</main>\n")
  b = b.write(footer(root, year))
  b = b.write("</body>\n</html>\n")
  return b.toString()
}

// The site nav. Deliberately five links: a language site's job is to get a
// reader into "get started" or the reference, not to present a menu.
function nav(root: string): string {
  let b = newBuilder()
  b = b.write("<nav>\n")
  b = b.write("  <a class=\"brand\" href=\"${root}index.html\">Bit</a>\n")
  b = b.write("  <a href=\"${root}get-started.html\">Get started</a>\n")
  b = b.write("  <a href=\"${root}docs/index.html\">Docs</a>\n")
  b = b.write("  <a href=\"${root}examples.html\">Examples</a>\n")
  b = b.write("  <a href=\"${root}support.html\">Support</a>\n")
  b = b.write("  <a href=\"https://github.com/byteink/bit\">GitHub</a>\n")
  b = b.write("</nav>\n")
  return b.toString()
}

// The byteink notice, identical in content to what #1822 put on the support
// page and to what cardova and thinkbyte show: logo linking home, "Bit by
// ByteInk", the legal entity, the copyright, and the license/trademark split.
//
// The logo comes from byteink.io in a light and a dark variant, swapped by
// <picture>, so one brand asset serves every product and this page needs no JS.
function footer(root: string, year: string): string {
  let b = newBuilder()
  b = b.write("<footer>\n")
  b = b.write("  <div class=\"byteink\">\n")
  b = b.write("    <a href=\"https://byteink.io\" rel=\"noopener\">\n")
  b = b.write("      <picture>\n")
  b = b.write("        <source media=\"(prefers-color-scheme: dark)\" srcset=\"https://byteink.io/byteink_dark.svg\">\n")
  b = b.write("        <img src=\"https://byteink.io/byteink_light.svg\" alt=\"ByteInk\" width=\"112\" height=\"32\" loading=\"lazy\">\n")
  b = b.write("      </picture>\n")
  b = b.write("    </a>\n")
  b = b.write("    <p><strong>Bit by ByteInk</strong> - a systems language with\n")
  b = b.write("    TypeScript-flavored syntax and Go-like semantics, compiled to a single\n")
  b = b.write("    static binary.</p>\n")
  b = b.write("    <p class=\"entity\">Bit is a product of Byteink LLC-FZ, Dubai, UAE.</p>\n")
  b = b.write("    <p class=\"entity\">&copy; ${year} Byteink LLC-FZ. All rights reserved.\n")
  b = b.write("    Bit is <a href=\"https://github.com/byteink/bit/blob/main/LICENSE\">Apache-2.0</a>\n")
  b = b.write("    licensed; the name is covered by our naming policy, see\n")
  b = b.write("    <a href=\"https://github.com/byteink/bit/blob/main/TRADEMARK.md\">TRADEMARK.md</a>.</p>\n")
  b = b.write("  </div>\n")
  b = b.write("  <p class=\"provenance\">This site is generated by <code>website/gen</code>, a Bit\n")
  b = b.write("  program, from the same <code>docs/</code> the compiler's own test suite\n")
  b = b.write("  typechecks. If a code sample here does not compile, CI is already red.</p>\n")
  b = b.write("</footer>\n")
  return b.toString()
}

// A page's own in-page table of contents, from its `##`/`###` headings. Skipped
// for a page with fewer than three, where it would be longer than the content
// it indexes.
export function toc(headings: []Heading): string {
  let count = 0
  for h of headings {
    if (h.level == 2 || h.level == 3) {
      count = count + 1
    }
  }
  if (count < 3) {
    return ""
  }
  let b = newBuilder()
  b = b.write("<aside class=\"toc\">\n<p>On this page</p>\n<ul>\n")
  for h of headings {
    if (h.level == 2 || h.level == 3) {
      b = b.write("<li class=\"l${h.level}\"><a href=\"#${h.id}\">${escapeHtml(h.text)}</a></li>\n")
    }
  }
  b = b.write("</ul>\n</aside>\n")
  return b.toString()
}
