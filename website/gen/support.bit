// The Support/Security page, ported from website/support.sh (#1825) so the site
// has ONE generator and every page wears the same chrome.
//
// Two halves with different trust properties:
//
//  1. The policy itself - docs/release/SUPPORT.md, rendered by the same markdown
//     path as every other page. The shell version extracted only the "## Support
//     matrix" table, with its own fence tracker and column checker; rendering the
//     whole document instead drops all of that code AND shows the reader the
//     cadence definitions and pre-1.0 phasing that explain the table.
//
//  2. The advisory feed - read from a JSON file, NOT fetched here. The fetch
//     stays in website/advisories.sh, which owns GitHub auth and the one piece of
//     logic that must not be reimplemented casually: a 404 counts as "no
//     advisories" only after the repo is separately confirmed reachable, because
//     GitHub answers 404 for a repo you cannot see as well as for one with an
//     empty feed. Getting that wrong publishes a false all-clear on a security
//     page.
//
// The rule this file owes: an ABSENT or unparseable feed renders the "unavailable"
// banner. Only an explicit empty array renders "no published advisories". Those
// are different facts and a security page must not conflate them.

// Where the fetched feed lands. Absent is normal - a local `bit run website/gen`
// has no network and no gh CLI, and must still produce a correct page.
const advisoriesPath = "website/advisories.json"

// One advisory, as the page shows it.
struct Advisory {
  id: string,
  url: string,
  severity: string,
  published: string,
  cve: string,
  summary: string,
}

// The whole page: the policy document, then the advisory section.
export function supportPage(): string {
  let b = newBuilder()

  let md = readFile("docs/release/SUPPORT.md") catch e {
    print("gen: read SUPPORT.md: ${e.message()}\n")
    return ""
  }
  let doc = render(md)
  b = b.write(toc(doc.headings))
  b = b.write(doc.html)

  b = b.write("<h2 id=\"security-advisories\">Security advisories</h2>\n")
  b = b.write("<p>Published advisories for <code>byteink/bit</code>. Report a ")
  b = b.write("vulnerability privately through ")
  b = b.write("<a href=\"https://github.com/byteink/bit/security/advisories/new\">GitHub ")
  b = b.write("Security Advisories</a> - never in a public issue. The full policy, ")
  b = b.write("including response times and embargo terms, is in ")
  b = b.write("<a href=\"https://github.com/byteink/bit/blob/main/SECURITY.md\">SECURITY.md</a>.</p>\n")
  b = b.write(advisorySection())

  return b.toString()
}

// The feed, or an honest statement that it could not be read.
function advisorySection(): string {
  if (!exists(advisoriesPath)) {
    return unavailable("the advisory feed was not fetched for this build")
  }
  let raw = readFile(advisoriesPath) catch e {
    return unavailable("the advisory feed could not be read")
  }
  let parsed = jsonParse(raw) catch e {
    return unavailable("the advisory feed was not valid JSON")
  }
  // A feed that is not an array is not a feed. The shell version failed the build
  // on this; here it is a banner, because a malformed feed must not take the
  // whole site down - but it must never read as "no advisories" either.
  if (!jsonIsArray(parsed)) {
    return unavailable("the advisory feed was not a JSON array")
  }

  let items = advisoriesOf(parsed)
  let b = newBuilder()
  b = b.write("<ul class=\"advisories\">\n")
  if (len(items) == 0) {
    // The ONLY path that may say this, and only because the file explicitly
    // held an empty array.
    b = b.write("<li class=\"empty\">No published security advisories.</li>\n")
  }
  for a of items {
    b = b.write("<li>\n")
    b = b.write("  <a href=\"${escapeHtml(a.url)}\">${escapeHtml(a.id)}</a>\n")
    b = b.write("  <span class=\"sev\">${escapeHtml(a.severity)}</span>\n")
    b = b.write("  <time>${escapeHtml(a.published)}</time>\n")
    b = b.write("  <span class=\"cve\">${escapeHtml(a.cve)}</span>\n")
    b = b.write("  <p>${escapeHtml(a.summary)}</p>\n")
    b = b.write("</li>\n")
  }
  b = b.write("</ul>\n")
  return b.toString()
}

// Never a false all-clear: this says the feed is missing, not that the project is
// clear. `why` names which of the failure modes happened, so an operator can tell
// "nobody fetched it" from "GitHub returned junk".
function unavailable(why: string): string {
  let b = newBuilder()
  b = b.write("<p class=\"warn\">The advisory feed is <strong>unavailable</strong> - ")
  b = b.write("${escapeHtml(why)}. This is not a statement that there are no ")
  b = b.write("advisories. See ")
  b = b.write("<a href=\"https://github.com/byteink/bit/security/advisories\">the ")
  b = b.write("advisories page</a> for the authoritative list.</p>\n")
  return b.toString()
}

// The array's published entries, newest first.
//
// `state` is re-checked here even though the fetch already filters server-side,
// for the reason the shell version documents: two independent filters mean a
// future API change cannot turn an embargoed draft into a published-looking row
// on this page.
function advisoriesOf(feed: Json): []Advisory {
  let out = []Advisory(0)
  match (feed) {
    JsonArray(items) => {
      for item of items {
        if (fieldOf(item, "state") != "published") {
          continue
        }
        out = append(out, Advisory{
          id: fallback(fieldOf(item, "ghsa_id"), "GHSA"),
          url: fieldOf(item, "html_url"),
          severity: fallback(fieldOf(item, "severity"), "unknown"),
          published: firstTen(fieldOf(item, "published_at")),
          cve: fallback(fieldOf(item, "cve_id"), "no CVE"),
          summary: fieldOf(item, "summary"),
        })
      }
    }
    JsonNull => return out
    JsonBool(b) => return out
    JsonInt(n) => return out
    JsonFloat(f) => return out
    JsonString(s) => return out
    JsonObject(entries) => return out
  }
  return sortByPublishedDesc(out)
}

// A string field, or "" when absent or not a string. An advisory missing a field
// is rendered with a placeholder rather than dropped - a real advisory with an
// odd shape must still appear on the page.
function fieldOf(item: Json, key: string): string {
  match (jsonGet(item, key)) {
    Some(v) => {
      match (jsonAsString(v)) {
        Some(s) => return s
        None => return ""
      }
    }
    None => return ""
  }
}

function fallback(s: string, alt: string): string {
  if (len(s) == 0) {
    return alt
  }
  return s
}

// An ISO timestamp's date part. GitHub sends "2026-07-26T12:34:56Z"; the page
// shows the day.
function firstTen(s: string): string {
  if (len(s) < 10) {
    return s
  }
  return s[0:10]
}

// Newest first, by the ISO date string - lexicographic order on ISO-8601 IS
// chronological order, so no date parsing is needed. Insertion sort: an advisory
// list is a handful of entries, and a heap here would be pure ceremony.
function sortByPublishedDesc(xs: []Advisory): []Advisory {
  let out = xs
  let i = 1
  while (i < len(out)) {
    let cur = out[i]
    let j = i - 1
    while (j >= 0 && out[j].published < cur.published) {
      out[j + 1] = out[j]
      j = j - 1
    }
    out[j + 1] = cur
    i = i + 1
  }
  return out
}
