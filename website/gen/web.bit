// The driver: which documents become which pages, and where they land.
//
// Named `web.bit` - not `main.bit`, and no longer `run.bit`. Module files
// concatenate in bytewise filename order and the inliner only inlines a callee it
// has already lowered, so the driver must sort AFTER everything it calls:
// md < mdblock < page < support < web. `run.bit` was fine until support.bit
// arrived and sorted after it (CLAUDE.md's #1511 note).
//
// Run from the repo root - every path here is relative to it:
//   bit build website/gen -o /tmp/bitsite && /tmp/bitsite


// Where generated HTML goes, and where the markdown comes from.
const outDir = "website/public"
const contentDir = "website/content"

// The copyright year the footer shows. Threaded from one place so it cannot
// disagree between pages; `bit` has no clock binding in the stdlib yet, so it is
// a constant here rather than silently wrong on every page.
// ponytail: bump on the January it matters, or wire std/time when it lands.
const year = "2026"

function main() {
  ensureDir(outDir)
  ensureDir("${outDir}/docs")

  renderContent("index.md", "index.html", "Bit - a systems language", 0)
  // Get started IS docs/tutorial.md - the same file tests/docs.zig typechecks
  // block by block. A separate copy under website/content/ would be a second
  // tutorial to keep in step, and the one on the site would be the ungated one.
  renderDoc("docs/tutorial.md", "get-started.html", "Get started - Bit")
  renderExamples()
  emit(Page{
    path: "${outDir}/support.html",
    title: "Support and security - Bit",
    depth: 0,
    body: supportPage(),
  })
  renderDocsIndex()
  renderDocsTree("docs/reference", "reference")
  renderDocsTree("docs/stdlib", "stdlib")

  publishInstallers()

  print("gen: wrote ${outDir}\n")
}

// The installer the docs tell people to curl: docs/tutorial.md documents
// `curl -fsSL bitlang.org/install.sh | sh`, so it must be served at the site root
// or that command 404s.
//
// COPIED from dist/ rather than maintained here, because two copies of an
// installer drift and the served one is the one strangers actually run. It lands
// in website/public/, so it is committed and reaches the container through
// `git archive HEAD` like every page.
//
// The script fetches release tarballs from GitHub Releases; the site never hosts a
// binary.
//
// dist/install.ps1 is deliberately NOT served. There is no Windows artifact for it
// to download - the PE/COFF writer landed but the CLI target and the Windows
// runtime port did not - so serving it would publish an install command that
// cannot succeed. It stays in dist/ for when those land; publishing it is one line
// here, and that line belongs in the same change that ships a Windows tarball.
function publishInstallers() {
  copyFile("dist/install.sh", "${outDir}/install.sh")
}

// `src`, not `from`: `from` is a keyword (import syntax) and cannot name a
// parameter.
function copyFile(src: string, to: string) {
  let body = readFile(src) catch e {
    print("gen: read ${src}: ${e.message()}\n")
    return
  }
  writeFile(to, body) catch e {
    print("gen: write ${to}: ${e.message()}\n")
    return
  }
  print("gen: ${to}\n")
}

function ensureDir(path: string) {
  if (exists(path)) {
    return
  }
  mkdir(path) catch e {
    print("gen: mkdir ${path}: ${e.message()}\n")
  }
}

// A hand-written page from website/content/.
function renderContent(src: string, out: string, title: string, depth: int) {
  let md = readFile("${contentDir}/${src}") catch e {
    print("gen: read ${src}: ${e.message()}\n")
    return
  }
  let doc = render(md)
  emit(Page{ path: "${outDir}/${out}", title: title, depth: depth, body: doc.html })
}

// One markdown file straight to a root-level page, with its in-page contents.
function renderDoc(src: string, out: string, title: string) {
  let md = readFile(src) catch e {
    print("gen: read ${src}: ${e.message()}\n")
    return
  }
  let doc = render(md)
  emit(Page{
    path: "${outDir}/${out}",
    title: title,
    depth: 0,
    body: "${toc(doc.headings)}${doc.html}",
  })
}

// One documentation directory (docs/reference or docs/stdlib) to
// website/public/docs/<name>.html, with an in-page table of contents.
//
// README.md is skipped: each directory's README is an index of its siblings, and
// the generated docs index below replaces it.
function renderDocsTree(dir: string, group: string) {
  let names = readDir(dir) catch e {
    print("gen: readDir ${dir}: ${e.message()}\n")
    return
  }
  for name of names {
    if (!hasSuffix(name, ".md") || name == "README.md") {
      continue
    }
    let md = readFile("${dir}/${name}") catch e {
      print("gen: read ${dir}/${name}: ${e.message()}\n")
      continue
    }
    let doc = render(md)
    let stem = name[0:len(name) - 3]
    let body = "${toc(doc.headings)}${doc.html}"
    emit(Page{
      path: "${outDir}/docs/${stem}.html",
      title: "${titleOf(doc, stem)} - Bit ${group}",
      depth: 1,
      body: body,
    })
  }
}

// The docs landing page: every reference and stdlib page, linked, with the first
// paragraph of each as its blurb. Generated rather than hand-maintained so a new
// doc file cannot be added without appearing here.
function renderDocsIndex() {
  let b = newBuilder()
  b = b.write("<h1>Documentation</h1>\n")
  b = b.write("<p>Generated from the <code>docs/</code> tree in the compiler repository. ")
  b = b.write("Every Bit snippet on these pages is typechecked by the compiler's own ")
  b = b.write("test suite, so a sample that does not compile fails CI.</p>\n")
  b = b.write(sectionFor("Language reference", "docs/reference"))
  b = b.write(sectionFor("Standard library", "docs/stdlib"))
  emit(Page{ path: "${outDir}/docs/index.html", title: "Docs - Bit", depth: 1, body: b.toString() })
}

function sectionFor(heading: string, dir: string): string {
  let names = readDir(dir) catch e {
    return ""
  }
  let b = newBuilder()
  b = b.write("<h2 id=\"${slug(heading)}\">${heading}</h2>\n<ul class=\"cards\">\n")
  for name of names {
    if (!hasSuffix(name, ".md") || name == "README.md") {
      continue
    }
    let stem = name[0:len(name) - 3]
    let md = readFile("${dir}/${name}") catch e {
      continue
    }
    let doc = render(md)
    b = b.write("<li><a href=\"${stem}.html\">${escapeHtml(titleOf(doc, stem))}</a>")
    b = b.write("<span>${escapeHtml(blurb(md))}</span></li>\n")
  }
  b = b.write("</ul>\n")
  return b.toString()
}

// A page's own <h1> if it has one, else its filename. Filename is the fallback
// rather than "Untitled" so a doc with no heading is still identifiable.
function titleOf(doc: Doc, stem: string): string {
  for h of doc.headings {
    if (h.level == 1) {
      return stripInline(h.text)
    }
  }
  return stem
}

// A document's opening paragraph as a one-line blurb: markdown markers removed
// and cut at a word boundary. The whole paragraph, not its first LINE - the docs
// are hard-wrapped at ~80 columns, so a first-line blurb ends mid-sentence on
// every single page ("Bit uses result-style error values with explicit", "not").
function blurb(md: string): string {
  let acc = newBuilder()
  for line of split(md, "\n") {
    let t = trimSpace(line)
    if (acc.length() == 0) {
      // Still looking for the opening paragraph.
      if (len(t) == 0 || hasPrefix(t, "#") || hasPrefix(t, "```") || hasPrefix(t, "<!--")) {
        continue
      }
      acc = acc.write(t)
      continue
    }
    // In the paragraph: a blank line ends it.
    if (len(t) == 0) {
      break
    }
    acc = acc.write(" ")
    acc = acc.write(t)
  }
  return summarize(stripInline(acc.toString()), 150)
}

// The examples index, from the examples/ directory itself: one entry per example
// module. Generated, so a new example appears here without anyone remembering to
// add it.
//
// Each entry links to a page ON THIS SITE showing the source, not out to GitHub.
// Reading an example was the one thing the site sent people away to do, which is
// backwards for the page whose whole job is showing what the language looks like.
function renderExamples() {
  let names = readDir("examples") catch e {
    print("gen: readDir examples: ${e.message()}\n")
    return
  }
  ensureDir("${outDir}/examples")
  let b = newBuilder()
  b = b.write("<h1>Examples</h1>\n")
  b = b.write("<p>Every example is a directory under <code>examples/</code> in the ")
  b = b.write("repository, built and run by the test suite on every change - so ")
  b = b.write("none of them can rot. Each one is listed here with its source; to run ")
  b = b.write("one locally, <code>bit run examples/&lt;name&gt;</code>.</p>\n")
  b = b.write("<ul class=\"cards\">\n")
  for name of names {
    if (!isDir("examples/${name}")) {
      continue
    }
    b = b.write("<li><a href=\"examples/${name}.html\">")
    b = b.write("${escapeHtml(name)}</a><span>${escapeHtml(exampleBlurb(name))}</span></li>\n")
    renderExamplePage(name)
  }
  b = b.write("</ul>\n")
  emit(Page{ path: "${outDir}/examples.html", title: "Examples - Bit", depth: 0, body: b.toString() })
}

// One page per example: its blurb, then every `.bit` file in the directory.
//
// ALL of them, not just `<name>.bit`. Sibling `.bit` files in a directory are one
// module, so an example split across files is one program - showing only the file
// that happens to match the directory name would show a fragment and call it the
// example.
function renderExamplePage(name: string) {
  let files = readDir("examples/${name}") catch e {
    print("gen: readDir examples/${name}: ${e.message()}\n")
    return
  }
  let b = newBuilder()
  b = b.write("<h1>${escapeHtml(name)}</h1>\n")
  let blurb = exampleBlurb(name)
  if (len(blurb) > 0) {
    b = b.write("<p>${escapeHtml(blurb)}</p>\n")
  }
  b = b.write("<p>Run it with <code>bit run examples/${escapeHtml(name)}</code>.</p>\n")
  let shown = 0
  for f of files {
    if (!hasSuffix(f, ".bit")) {
      continue
    }
    let src = readFile("examples/${name}/${f}") catch e {
      continue
    }
    // Name each file only when there is more than one, so the common
    // single-file example is not captioned with something the reader can see.
    if (len(files) > 1) {
      b = b.write("<h2>${escapeHtml(f)}</h2>\n")
    }
    b = b.write("<pre><code class=\"language-bit\">${escapeHtml(src)}</code></pre>\n")
    shown = shown + 1
  }
  if (shown == 0) {
    b = b.write("<p>No source files found for this example.</p>\n")
  }
  b = b.write("<p><a href=\"../examples.html\">All examples</a></p>\n")
  emit(Page{
    path: "${outDir}/examples/${name}.html",
    title: "${name} - Bit examples",
    depth: 1,
    body: b.toString(),
  })
}

// An example's blurb: the first line of its leading comment. Every example in
// the tree opens with one describing what it demonstrates.
function exampleBlurb(name: string): string {
  let src = readFile("examples/${name}/${name}.bit") catch e {
    return ""
  }
  for line of split(src, "\n") {
    let t = trimSpace(line)
    if (hasPrefix(t, "//")) {
      let text = trimSpace(t[2:len(t)])
      if (len(text) > 110) {
        return "${text[0:107]}..."
      }
      return text
    }
    if (len(t) > 0) {
      return ""
    }
  }
  return ""
}

function emit(p: Page) {
  writeFile(p.path, document(p, year)) catch e {
    print("gen: write ${p.path}: ${e.message()}\n")
    return
  }
  print("gen: ${p.path}\n")
}
