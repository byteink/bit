// Entry point for the deployed server: bind, then accept until killed.
//
// Named zmain.bit, not main.bit: module files concatenate in bytewise filename
// order and the inliner only inlines a callee it has already lowered, so the file
// that calls everything must sort last (CLAUDE.md's #1511 note). serve < zmain.

// No imports here: serve.bit is the same module and already imports args,
// parseInt and everything else. A second import of a name in a sibling is E0042.

// 0.0.0.0, not 127.0.0.1: inside a container loopback is reachable only from that
// container, so binding it would leave the port open and nothing served.
const defaultHost = "0.0.0.0"
const defaultPort = 8080

function main(): int {
  let argv = args()
  if (len(argv) < 2) {
    print("usage: server <dir> [port]\n")
    return 2
  }
  let port = defaultPort
  if (len(argv) >= 3) {
    port = parseInt(argv[2]) catch e {
      print("server: bad port '${argv[2]}': ${e.message()}\n")
      return 2
    }
  }

  let site = Site{ root: argv[1] }
  let s = serve(defaultHost, port) catch e {
    print("server: serve: ${e.message()}\n")
    return 1
  }
  println("server: serving ${site.root} on ${defaultHost}:${port}")
  while (true) {
    let ex = s.accept() catch e {
      print("server: accept: ${e.message()}\n")
      return 1
    }
    spawn handle(ex, site)
  }
  return 0
}
