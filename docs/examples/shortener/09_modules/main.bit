// 09: main wires the pieces together; the store lives in its own module.
// Demanded by: "split it into files" -- modules, export.
import { now, sleep, Millisecond } from "std/time"
import { Link, memoryStore, shortCode, sweepLoop } from "./store"

fn main() {
  let store = memoryStore<Link>()
  let code = shortCode(12345)
  store.put(
    code,
    Link{
      url: "https://example.com",
      created: now().ns,
      hits: 0,
      expiresAt: now().ns + 10 * Millisecond,
    },
  )

  let stop = chan<bool>(1)
  let done = chan<int>(1)
  spawn sweepLoop(store, stop, done)

  println("has ${code} right after put: ${store.has(code)}")
  sleep(40 * Millisecond)
  stop <- true
  let removed = <- done

  println("swept ${removed} expired link(s)")
  println("has ${code} after the sweep: ${store.has(code)}")
}
