// 02: a Link class with created/hits, in place of a bare URL string.
// Demanded by: "a link has more than a URL" -- classes, zero values.
class Link {
  export url: string,
  export created: i64,
  export hits: int,
}

fn main() {
  let links = map<string, Link>()
  links["abc123"] = Link{ url: "https://example.com", created: 0, hits: 0 }

  let l = links["abc123"]
  println("abc123 -> ${l.url} (hits=${l.hits})")
}
