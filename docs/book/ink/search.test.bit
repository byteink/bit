// search.test.bit — substring and tag-pattern search over an in-memory list.
test "search matches title, body and tags, case-insensitively" {
  let drafts = []Draft{
    Draft{
      id = "1", title = "Morning routine", body = "wake, stretch, coffee",
      tags = []string{ "habits" }, status = Status.Draft, created = 0, updated = 0,
    },
    Draft{
      id = "2", title = "Recipe", body = "flour, water, salt",
      tags = []string{ "kitchen" }, status = Status.Draft, created = 0, updated = 0,
    },
  }
  let byTitle = search(drafts, "MORNING")
  assert(len(byTitle) == 1 && byTitle[0].id == "1", "title match")
  let byBody = search(drafts, "flour")
  assert(len(byBody) == 1 && byBody[0].id == "2", "body match")
  let byTag = search(drafts, "kitchen")
  assert(len(byTag) == 1 && byTag[0].id == "2", "tag match")
  let none = search(drafts, "nonexistent")
  assert(len(none) == 0, "no match, got ${len(none)}")
}

test "searchTagPattern matches a regular expression against tags" {
  let drafts = []Draft{
    Draft{
      id = "1", title = "a", body = "", tags = []string{ "note-1" },
      status = Status.Draft, created = 0, updated = 0,
    },
    Draft{
      id = "2", title = "b", body = "", tags = []string{ "idea" },
      status = Status.Draft, created = 0, updated = 0,
    },
  }
  let got = searchTagPattern(drafts, "^note-\\d+$") catch e {
    panic("searchTagPattern: ${e.message()}")
  }
  assert(len(got) == 1 && got[0].id == "1", "want draft 1, got ${len(got)} matches")
}
