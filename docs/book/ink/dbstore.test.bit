// `remove` (store.test.bit), `envOr` (store.bit) and `pathJoin`
// (config.test.bit) are already bound module-wide - reused here, not
// re-imported (a duplicate import of a name already in scope is an error).
// `Datasource`, `pool` (std/sql) and `adapter` (postgres) are already bound
// module-wide by dbstore.bit, for the same reason.
import { env } from "std/os"

test "openStore with an empty database URL behaves like FileStore" {
  let store = openStore("") catch e {
    panic("openStore: ${e.message()}")
  }
  let d = Draft{
    id = newId(), title = "Via openStore", body = "x", tags = []string(0),
    status = Status.Draft, created = 0, updated = 0,
  }
  store.save(d) catch e {
    panic("save: ${e.message()}")
  }
  let back = store.load(d.id) catch e {
    panic("load: ${e.message()}")
  }
  assert(back.title == "Via openStore", "openStore(\"\") did not use the file store")
  remove(pathJoin(envOr("HOME", "."), ".ink/drafts/${d.id}.md")) catch e {
    panic("cleanup: ${e.message()}")
  }
}

test "FileStore satisfies Store and round-trips a draft to disk" {
  let store: Store = FileStore{}
  let d = Draft{
    id = newId(),
    title = "Test",
    body = "hello",
    tags = ["x"],
    status = Status.Draft,
    created = 1,
    updated = 2,
  }
  store.save(d) catch e {
    panic("save: ${e.message()}")
  }
  let back = store.load(d.id) catch e {
    panic("load: ${e.message()}")
  }
  assert(back.title == "Test" && back.body == "hello", "FileStore round-trips scalars")
  assert(len(back.tags) == 1 && back.tags[0] == "x", "FileStore round-trips tags")

  let all = store.list() catch e {
    panic("list: ${e.message()}")
  }
  let found = false
  for existing of all {
    if (existing.id == d.id) {
      found = true
    }
  }
  assert(found, "FileStore.list() includes the saved draft")

  remove(pathJoin(envOr("HOME", "."), ".ink/drafts/${d.id}.md")) catch e {
    panic("cleanup: ${e.message()}")
  }
}

// The offline stores above are exercised on every `bit test` run; this one
// needs a real PostgreSQL server, so it is skipped when
// INK_TEST_LIVE_PG_URI is unset - the same pattern pkg/postgres's own
// live.test.bit uses, so a machine with no database still gets a green
// `bit test docs/book/ink`. `./make test-book-ink-live` (#6356) starts a
// throwaway PostgreSQL, sets the variable and fails on a skip.
test "SqlStore satisfies Store and round-trips a draft against a real PostgreSQL server" {
  let uri = env("INK_TEST_LIVE_PG_URI")
  if (uri == "") {
    print("  skipped: no live PostgreSQL here, `./make test-book-ink-live` runs this test\n")
    return
  }
  let db = pool(adapter(), Datasource{ uri = uri }) catch e {
    panic("pool: ${e.message()}")
  }
  db.exec("DROP TABLE IF EXISTS drafts", []Value(0)) catch e {
    panic("drop drafts: ${e.message()}")
  }
  db.exec(
      "CREATE TABLE drafts (id text primary key, title text, body text, tags text, " +
      "status text, created bigint, updated bigint)",
    []Value(0),
  ) catch e {
    panic("create drafts: ${e.message()}")
  }

  let store: Store = SqlStore{ db = db }
  let d = Draft{
    id = newId(),
    title = "Live",
    body = "from postgres",
    tags = ["a", "b"],
    status = Status.Published,
    created = 10,
    updated = 20,
  }
  store.save(d) catch e {
    panic("save: ${e.message()}")
  }
  let back = store.load(d.id) catch e {
    panic("load: ${e.message()}")
  }
  assert(back.title == "Live" && back.status == Status.Published, "round-trips scalars and status")
  assert(len(back.tags) == 2 && back.tags[1] == "b", "round-trips tags")

  store.save(
    Draft{
      id = d.id,
      title = "Live (edited)",
      body = back.body,
      tags = back.tags,
      status = back.status,
      created = back.created,
      updated = 30,
    },
  ) catch e {
    panic("upsert: ${e.message()}")
  }
  let edited = store.load(d.id) catch e {
    panic("load after upsert: ${e.message()}")
  }
  assert(edited.title == "Live (edited)" && edited.updated == 30, "save() upserts an existing row")

  let all = store.list() catch e {
    panic("list: ${e.message()}")
  }
  assert(len(all) == 1, "list() sees the one row")

  db.exec("DROP TABLE drafts", []Value(0)) catch e {
    panic("cleanup: ${e.message()}")
  }
  db.close()
}
