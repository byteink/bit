// watch.test.bit — changedSince and the select/timer/cancellation loop
// (docs/book/12-watching-for-changes.md).

import { Millisecond } from "std/time"

fn watchSample(): []Draft {
  return []Draft{
    Draft{
      id = "a", title = "First", body = "one", tags = []string(0),
      status = Status.Draft, created = 0, updated = 1,
    },
    Draft{
      id = "b", title = "Second", body = "two", tags = []string(0),
      status = Status.Draft, created = 0, updated = 2,
    },
  }
}

test "changedSince reports every draft the first time it sees them" {
  let seen = map<string, i64>()
  let changed = changedSince(watchSample(), seen)
  assert(len(changed) == 2, "expected 2 changed ids, got ${len(changed)}")
}

test "changedSince reports nothing once every draft has been seen" {
  let seen = map<string, i64>()
  let _ = changedSince(watchSample(), seen)
  let second = changedSince(watchSample(), seen)
  assert(len(second) == 0, "expected no changes on the second call, got ${len(second)}")
}

test "changedSince reports only the draft whose updated moved forward" {
  let seen = map<string, i64>()
  let _ = changedSince(watchSample(), seen)
  let drafts = watchSample()
  drafts[0].updated = 5
  let changed = changedSince(drafts, seen)
  assert(len(changed) == 1 && changed[0] == "a", "expected [\"a\"], got ${len(changed)} id(s)")
}

test "watchLoop reports the initial drafts, then stops on the stop signal" {
  let stop = chan<bool>(1)
  let changes = chan<string>(4)
  spawn watchLoop(watchSample, 2 * Millisecond, stop, changes)

  let seenIds = map<string, bool>()
  let received = 0
  while (received < 2) {
    let id = <- changes
    seenIds[id] = true
    received = received + 1
  }
  assert(len(seenIds) == 2, "expected ids \"a\" and \"b\", got ${len(seenIds)}")

  stop <- true
  for id of changes {
    assert(false, "unexpected change after stop: ${id}")
  }
}
