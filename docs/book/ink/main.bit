// main.bit — ink's entry point. Reads the command line and dispatches
// `ink new`, `ink list`, `ink search`. Later parts of the book report their
// command names and the function to call here rather than editing this file
// themselves; the dispatch below is Part 1's own three commands. See
// ../01-hello-inkwell.md onward.
import { args } from "std/os"
import { join } from "std/strings"
import { now } from "std/time"

fn usage() {
  println("usage: ink <new|list|search> ...")
}

fn cmdNew(title: string, body: string): ()! {
  let n = now().ns / 1_000_000_000
  let d = Draft{
    id = newId(),
    title = title,
    body = body,
    tags = []string(0),
    status = Status.Draft,
    created = n,
    updated = n,
  }
  saveDraft(d)?
  println("saved ${d.id}: ${d.title}")
}

fn cmdList(): ()! {
  let drafts = listDrafts()?
  let counts = map<string, int>()
  for d of drafts {
    println("${d.id}  ${d.statusLabel()}  ${d.title}")
    let (n, ok) = counts[d.statusLabel()]
    counts[d.statusLabel()] = ok ? n + 1 : 1
  }
  for (label, n) of counts {
    println("${label}: ${n}")
  }
}

fn cmdSearch(query: string): ()! {
  let drafts = listDrafts()?
  for d of search(drafts, query) {
    println("${d.id}  ${d.title}")
  }
}

fn main(): ()! {
  let a = args()
  if (len(a) < 2) {
    usage()
    return
  }
  switch (a[1]) {
    case "new":
      if (len(a) < 3) {
        usage()
        return
      }
      let body = len(a) > 3 ? join(a[3:], " ") : ""
      cmdNew(a[2], body)?
    case "list":
      cmdList()?
    case "search":
      if (len(a) < 3) {
        usage()
        return
      }
      cmdSearch(a[2])?
    default:
      usage()
  }
}
