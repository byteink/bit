// main.bit - ink's entry point. Reads the command line, loads Settings, opens
// the configured Store, and dispatches to one `cmdX` per command. Each
// `cmdX` is added by the chapter that teaches the library functions it
// calls; see docs/book/01-hello-inkwell.md onward for where every line here
// came from.
import { args } from "std/os"
import { join } from "std/strings"
import { now, localZone } from "std/time"
import { waitForSignal, Signal } from "std/signal"

fn usage() {
  println(
    "usage: ink <new|list|search|import|export|stats|index|watch|backup|restore> ...",
  )
}

// `loadSettings` (config.bit) falls back to the built-in defaults on any
// failure to read or parse "ink.toml" - a brand new `ink` install has none.
fn currentSettings(): Settings {
  return loadSettings("ink.toml") catch _ {
    Settings{ draftsDir = "~/.ink/drafts", wordsPerMinute = 200, databaseUrl = "" }
  }
}

fn cmdNew(store: Store, title: string, body: string): ()! {
  let n = now().ns / 1_000_000_000
  let d = Draft{
    id = newId(),
    title = title,
    body = body,
    tags = []string(0),
    status = Status.Draft,
    created = n,
    updated = n,
  }
  store.save(d)?
  println("saved ${d.id}: ${d.title}")
}

fn cmdList(store: Store, wordsPerMinute: int): ()! {
  let drafts = store.list()?
  let z = localZone()
  for d of drafts {
    let minutes = readingMinutes(d.body, wordsPerMinute)
    let when = updatedAt(d, z)?
    println("${d.id}  ${d.statusLabel()}  ${d.title}  (${minutes} min read, updated ${when})")
  }
}

fn cmdSearch(store: Store, query: string): ()! {
  for d of search(store.list()?, query) {
    println("${d.id}  ${d.title}")
  }
}

fn cmdExport(store: Store, path: string): ()! {
  let drafts = store.list()?
  writeFile(path, exportJson(drafts))?
  println("exported ${len(drafts)} draft(s) to ${path}")
}

fn cmdImport(store: Store, path: string): ()! {
  let drafts = importJson(readFile(path)?)?
  for d of drafts {
    store.save(d)?
  }
  println("imported ${len(drafts)} draft(s) from ${path}")
}

// The whole library's word count and estimated reading time, at
// `wordsPerMinute` - chapter 9's `wordCount`/`readingMinutes` summed over
// every draft instead of shown one at a time, the way `ink list` does.
fn cmdStats(store: Store, wordsPerMinute: int): ()! {
  let drafts = store.list()?
  let words = 0
  let minutes = 0
  for d of drafts {
    words = words + wordCount(d.body)
    minutes = minutes + readingMinutes(d.body, wordsPerMinute)
  }
  println("${len(drafts)} draft(s), ${words} word(s), ${minutes} minute(s) total reading time")
}

fn cmdIndex(store: Store): ()! {
  let drafts = store.list()?
  let idx = buildIndex(drafts, 4)
  println("indexed ${len(drafts)} draft(s) into ${len(idx)} distinct word(s)")
}

// Stops `watchLoop` on Ctrl-C or a terminate signal - a named function
// because `spawn` needs a call expression, not a closure.
fn stopOnSignal(stop: chan<bool>) {
  waitForSignal([Signal.Term, Signal.Int])
  stop <- true
}

fn cmdWatch(store: Store): ()! {
  let stop = chan<bool>(1)
  let changes = chan<string>(8)
  let loadAll = () => {
    return store.list() catch []Draft(0)
  }
  spawn watchLoop(loadAll, 2_000_000_000, stop, changes)
  spawn stopOnSignal(stop)
  for id of changes {
    println("changed: ${id}")
  }
}

fn cmdBackup(store: Store, passphrase: string, path: string): ()! {
  let blob = backupWithPassphrase(store.list()?, passphrase)?
  writeFile(path, string(blob))?
  println("backed up to ${path}")
}

fn cmdRestore(store: Store, passphrase: string, path: string): ()! {
  let drafts = restoreWithPassphrase([]byte(readFile(path)?), passphrase)?
  for d of drafts {
    store.save(d)?
  }
  println("restored ${len(drafts)} draft(s) from ${path}")
}

// True once `a` has at least `n` words; prints `usage()` and returns false
// otherwise, so every `runX` below reads as one line instead of repeating
// the same length check.
fn requireArgs(a: []string, n: int): bool {
  if (len(a) < n) {
    usage()
    return false
  }
  return true
}

fn runNew(store: Store, a: []string): ()! {
  if (!requireArgs(a, 3)) {
    return
  }
  let body = len(a) > 3 ? join(a[3:], " ") : ""
  cmdNew(store, a[2], body)?
}

fn runSearch(store: Store, a: []string): ()! {
  if (!requireArgs(a, 3)) {
    return
  }
  cmdSearch(store, a[2])?
}

fn runExport(store: Store, a: []string): ()! {
  if (!requireArgs(a, 3)) {
    return
  }
  cmdExport(store, a[2])?
}

fn runImport(store: Store, a: []string): ()! {
  if (!requireArgs(a, 3)) {
    return
  }
  cmdImport(store, a[2])?
}

fn runBackup(store: Store, a: []string): ()! {
  if (!requireArgs(a, 4)) {
    return
  }
  cmdBackup(store, a[2], a[3])?
}

fn runRestore(store: Store, a: []string): ()! {
  if (!requireArgs(a, 4)) {
    return
  }
  cmdRestore(store, a[2], a[3])?
}

// The commands that need nothing beyond the command word itself. Returns
// `false`, handling nothing, for any other command.
fn dispatchSimple(store: Store, settings: Settings, cmd: string): bool! {
  switch (cmd) {
    case "list":
      cmdList(store, settings.wordsPerMinute)?
    case "stats":
      cmdStats(store, settings.wordsPerMinute)?
    case "index":
      cmdIndex(store)?
    case "watch":
      cmdWatch(store)?
    default:
      return false
  }
  return true
}

// The commands that take extra words after the command itself. Returns
// `false`, handling nothing, for any other command.
fn dispatchWithArgs(store: Store, cmd: string, a: []string): bool! {
  switch (cmd) {
    case "new":
      runNew(store, a)?
    case "search":
      runSearch(store, a)?
    case "export":
      runExport(store, a)?
    case "import":
      runImport(store, a)?
    case "backup":
      runBackup(store, a)?
    case "restore":
      runRestore(store, a)?
    default:
      return false
  }
  return true
}

fn dispatch(store: Store, settings: Settings, a: []string): ()! {
  let cmd = a[1]
  if (dispatchSimple(store, settings, cmd)?) {
    return
  }
  if (dispatchWithArgs(store, cmd, a)?) {
    return
  }
  usage()
}

fn main(): ()! {
  let a = args()
  if (len(a) < 2) {
    usage()
    return
  }
  let settings = currentSettings()
  let store = openStore(settings.databaseUrl)?
  dispatch(store, settings, a)?
}
