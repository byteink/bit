import { utc } from "std/time"

test "wordCount counts whitespace-separated words, ignores leading/trailing space" {
  assert(wordCount("") == 0, "empty body has 0 words")
  assert(wordCount("  hello   world  ") == 2, "counts words, trims runs of space")
  assert(wordCount("one\ntwo\tthree") == 3, "newlines and tabs separate words too")
}

test "readingMinutes rounds up, and is 0 for an empty body" {
  assert(readingMinutes("", 200) == 0, "empty body takes 0 minutes")
  assert(readingMinutes("one two three four five", 2) == 3, "5 words at 2 wpm rounds up to 3")
  assert(readingMinutes("one two", 200) == 1, "a short body still takes at least 1 minute")
}

test "updatedAt formats the unix-seconds field in the given zone" {
  let d = Draft{
    id = "1",
    title = "t",
    body = "b",
    tags = []string(0),
    status = Status.Draft,
    created = 0,
    updated = 1735689600,
  }
  let text = updatedAt(d, utc()) catch e {
    panic("updatedAt: ${e.message()}")
  }
  assert(text == "1 January 2025 at 00:00", "formats to the expected wall clock: ${text}")
}
