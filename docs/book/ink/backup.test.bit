// backup.test.bit — serialize/deserialize, encrypted backup/restore, and the
// checksum catching a corrupted backup (docs/book/13-backups.md).

// `randomBytes` (std/crypto) is already bound module-wide by backup.bit -
// reused here, not re-imported.

fn backupSample(): []Draft {
  return []Draft{
    Draft{
      id = "d1", title = "", body = "first draft body",
      tags = []string(0), status = Status.Draft, created = 0, updated = 0,
    },
    Draft{
      id = "d2", title = "", body = "second draft body, a little longer",
      tags = []string(0), status = Status.Draft, created = 0, updated = 0,
    },
  }
}

test "serializeDrafts then deserializeDrafts round-trips id and body" {
  let drafts = backupSample()
  let back = deserializeDrafts(serializeDrafts(drafts)) catch e {
    assert(false, "deserialize failed: ${e.message()}")
    return
  }
  assert(len(back) == 2, "expected 2 drafts back, got ${len(back)}")
  assert(back[0].id == "d1" && back[0].body == "first draft body", "draft 0 did not round-trip")
  assert(
    back[1].id == "d2" && back[1].body == "second draft body, a little longer",
    "draft 1 did not round-trip",
  )
}

test "backupDrafts then restoreDrafts recovers the original drafts" {
  let key = randomBytes(32)
  let nonce = randomBytes(12)
  let drafts = backupSample()

  let blob = backupDrafts(drafts, key, nonce) catch e {
    assert(false, "backup failed: ${e.message()}")
    return
  }
  let restored = restoreDrafts(blob, key) catch e {
    assert(false, "restore failed: ${e.message()}")
    return
  }
  assert(len(restored) == 2, "expected 2 restored drafts, got ${len(restored)}")
  assert(restored[0].body == "first draft body", "first draft body did not survive backup/restore")
}

test "restoreDrafts rejects a backup with a flipped ciphertext byte" {
  let key = randomBytes(32)
  let nonce = randomBytes(12)
  let blob = backupDrafts(backupSample(), key, nonce) catch e {
    assert(false, "backup failed: ${e.message()}")
    return
  }
  blob[len(blob) - 1] = blob[len(blob) - 1] ^ byte(1)

  let restored = restoreDrafts(blob, key) catch _ {
    return // expected: the checksum (or the AEAD tag) must reject it
  }
  assert(false, "restore accepted a corrupted backup, got ${len(restored)} drafts")
}

test "restoreDrafts rejects the wrong key" {
  let right = randomBytes(32)
  let wrong = randomBytes(32)
  let nonce = randomBytes(12)
  let blob = backupDrafts(backupSample(), right, nonce) catch e {
    assert(false, "backup failed: ${e.message()}")
    return
  }
  let restored = restoreDrafts(blob, wrong) catch _ {
    return // expected: the AEAD tag does not verify under the wrong key
  }
  assert(false, "restore accepted the wrong key, got ${len(restored)} drafts")
}

test "backupWithPassphrase then restoreWithPassphrase recovers the original drafts" {
  let drafts = backupSample()
  let blob = backupWithPassphrase(drafts, "correct horse battery staple") catch e {
    assert(false, "backup failed: ${e.message()}")
    return
  }
  let restored = restoreWithPassphrase(blob, "correct horse battery staple") catch e {
    assert(false, "restore failed: ${e.message()}")
    return
  }
  assert(len(restored) == 2, "expected 2 restored drafts, got ${len(restored)}")
  assert(restored[0].body == "first draft body", "first draft body did not survive backup/restore")
}

test "restoreWithPassphrase rejects the wrong passphrase" {
  let blob = backupWithPassphrase(backupSample(), "right passphrase") catch e {
    assert(false, "backup failed: ${e.message()}")
    return
  }
  let restored = restoreWithPassphrase(blob, "wrong passphrase") catch _ {
    return // expected: the wrong passphrase derives the wrong key
  }
  assert(false, "restore accepted the wrong passphrase, got ${len(restored)} drafts")
}

test "exportCompressed produces a valid gzip header" {
  let out = exportCompressed(backupSample()) catch e {
    assert(false, "export failed: ${e.message()}")
    return
  }
  assert(len(out) > 2, "expected a non-trivial gzip stream, got ${len(out)} bytes")
  assert(out[0] == byte(0x1f) && out[1] == byte(0x8b), "missing the gzip magic bytes")
}
