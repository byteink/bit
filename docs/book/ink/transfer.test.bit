fn sample(): []Draft {
  return [
    Draft{
      id = "1",
      title = "First",
      body = "hello world",
      tags = ["a", "b"],
      status = Status.Draft,
      created = 100,
      updated = 200,
    },
    Draft{
      id = "2",
      title = "Second",
      body = "no tags here",
      tags = []string(0),
      status = Status.Published,
      created = 300,
      updated = 400,
    },
  ]
}

test "exportJson/importJson round-trips every field, including enum status and empty tags" {
  let text = exportJson(sample())
  let back = importJson(text) catch e {
    panic("importJson: ${e.message()}")
  }
  assert(len(back) == 2, "round-trips both drafts")
  assert(back[0].id == "1" && back[0].title == "First", "first draft's scalars round-trip")
  assert(
    len(back[0].tags) == 2 && back[0].tags[0] == "a" && back[0].tags[1] == "b",
    "tags round-trip",
  )
  assert(back[0].status == Status.Draft, "status round-trips as Draft")
  assert(back[1].status == Status.Published, "status round-trips as Published")
  assert(len(back[1].tags) == 0, "an empty tag list round-trips empty")
}

test "exportCsv/importCsv round-trips every field, including empty tags" {
  let text = exportCsv(sample())
  let back = importCsv(text) catch e {
    panic("importCsv: ${e.message()}")
  }
  assert(len(back) == 2, "round-trips both drafts")
  assert(
    back[0].body == "hello world" && back[0].created == 100,
    "first draft's scalars round-trip",
  )
  assert(len(back[0].tags) == 2 && back[0].tags[1] == "b", "tags round-trip through the '|' join")
  assert(back[1].status == Status.Published, "status round-trips through its CSV name")
  assert(len(back[1].tags) == 0, "an empty tag list round-trips empty")
}

test "statusText/statusFromText agree, and an unknown name fails" {
  assert(statusText(Status.Archived) == "Archived", "statusText names the variant")
  let s = statusFromText("Archived") catch e {
    panic("statusFromText: ${e.message()}")
  }
  assert(s == Status.Archived, "statusFromText recovers the variant")
  statusFromText("Deleted") catch e {
    assert(e.message() == "ink: unknown status: Deleted", "names the bad value: ${e.message()}")
    return
  }
  panic("statusFromText must fail on an unknown status name")
}
