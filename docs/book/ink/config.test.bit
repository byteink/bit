import { join as pathJoin } from "std/path"

// `writeFile`, `envOr` (store.bit) and `remove` (store.test.bit) are
// already bound module-wide - reused here, not re-imported.

fn settingsFixture(toml: string): string {
  let path = pathJoin(envOr("TMPDIR", "/tmp"), "ink-config-test.toml")
  writeFile(path, toml) catch e {
    panic("writeFile: ${e.message()}")
  }
  return path
}

test "loadSettings reads drafts_dir and words_per_minute from [ink]" {
  let path = settingsFixture("[ink]\ndrafts_dir = \"~/notes\"\nwords_per_minute = 180\n")
  let settings = loadSettings(path) catch e {
    panic("loadSettings: ${e.message()}")
  }
  assert(settings.draftsDir == "~/notes", "drafts_dir must round-trip")
  assert(settings.wordsPerMinute == 180, "words_per_minute must round-trip")
  remove(path) catch e {
    panic("remove: ${e.message()}")
  }
}

test "loadSettings falls back to defaults when [ink] is absent" {
  let path = settingsFixture("title = \"unrelated\"\n")
  let settings = loadSettings(path) catch e {
    panic("loadSettings: ${e.message()}")
  }
  assert(settings.draftsDir == "~/.ink/drafts", "default drafts_dir")
  assert(settings.wordsPerMinute == 200, "default words_per_minute")
  remove(path) catch e {
    panic("remove: ${e.message()}")
  }
}

test "loadSettings fails on a wrong-typed key, naming it" {
  let path = settingsFixture("[ink]\nwords_per_minute = \"fast\"\n")
  loadSettings(path) catch e {
    assert(
      e.message() == "ink.words_per_minute must be an integer",
      "error names the key: ${e.message()}",
    )
    remove(path) catch e2 {
      panic("remove: ${e2.message()}")
    }
    return
  }
  panic("loadSettings must fail on a wrong-typed key")
}
