// store.test.bit — round-trips a draft through the real ~/.ink/drafts (what
// saveDraft/loadDraft/listDrafts actually write to), then removes what it
// created so the test leaves no trace.
import { remove } from "std/fs"

test "saveDraft then loadDraft returns the same fields" {
  let id = newId()
  let want = Draft{
    id = id, title = "Round trip", body = "line one\nline two",
    tags = []string{ "a", "b" }, status = Status.Published,
    created = 1000, updated = 2000,
  }
  saveDraft(want) catch e {
    panic("saveDraft: ${e.message()}")
  }
  let got = loadDraft(id) catch e {
    panic("loadDraft: ${e.message()}")
  }
  assert(got.id == want.id, "id: got ${got.id}")
  assert(got.title == want.title, "title: got ${got.title}")
  assert(got.body == want.body, "body: got ${got.body}")
  assert(got.status == want.status, "status")
  assert(got.created == want.created, "created: got ${got.created}")
  assert(got.updated == want.updated, "updated: got ${got.updated}")
  assert(
    len(got.tags) == 2 && got.tags[0] == "a" && got.tags[1] == "b",
    "tags: got ${len(got.tags)}",
  )
  remove(draftPath(id)) catch e {
    panic("cleanup: ${e.message()}")
  }
}

test "listDrafts includes a freshly saved draft" {
  let id = newId()
  let d = Draft{
    id = id, title = "Listed", body = "x", tags = []string(0),
    status = Status.Draft, created = 0, updated = 0,
  }
  saveDraft(d) catch e {
    panic("saveDraft: ${e.message()}")
  }
  let all = listDrafts() catch e {
    panic("listDrafts: ${e.message()}")
  }
  let found = false
  for x of all {
    if (x.id == id) {
      found = true
    }
  }
  assert(found, "expected ${id} in listDrafts()")
  remove(draftPath(id)) catch e {
    panic("cleanup: ${e.message()}")
  }
}
