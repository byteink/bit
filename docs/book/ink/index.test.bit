// index.test.bit — buildIndex's worker pool (docs/book/11-indexing-in-parallel.md).

fn sampleDrafts(): []Draft {
  return []Draft{
    Draft{
      id = "1",
      title = "Bit release notes",
      body = "The compiler ships a new worker pool for indexing",
      tags = []string(0),
      status = Status.Published,
      created = 0,
      updated = 0,
    },
    Draft{
      id = "2",
      title = "Channels",
      body = "A channel is a typed pipe between green threads",
      tags = []string(0),
      status = Status.Draft,
      created = 0,
      updated = 0,
    },
    Draft{
      id = "3",
      title = "Worker pools",
      body = "A fixed pool of workers reads jobs off one channel",
      tags = []string(0),
      status = Status.Draft,
      created = 0,
      updated = 0,
    },
  }
}

test "buildIndex finds every draft containing a shared word" {
  let idx = buildIndex(sampleDrafts(), 2)
  let (ids, ok) = idx["worker"]
  assert(ok, "expected \"worker\" in the index")
  assert(len(ids) == 2, "expected 2 drafts containing \"worker\", got ${len(ids)}")
}

test "buildIndex finds a word unique to one draft" {
  let idx = buildIndex(sampleDrafts(), 3)
  let (ids, ok) = idx["release"]
  assert(ok, "expected \"release\" in the index")
  assert(len(ids) == 1 && ids[0] == "1", "expected [\"1\"], got ${len(ids)} id(s)")
}

test "buildIndex is the same result regardless of worker count" {
  let drafts = sampleDrafts()
  let oneWorker = buildIndex(drafts, 1)
  let manyWorkers = buildIndex(drafts, 8)
  let (oneIds, _) = oneWorker["channel"]
  let (manyIds, _) = manyWorkers["channel"]
  assert(
    len(oneIds) == len(manyIds),
    "worker count changed the result: ${len(oneIds)} vs ${len(manyIds)}",
  )
}

test "buildIndex on no drafts returns an empty index" {
  let idx = buildIndex([]Draft(0), 4)
  assert(len(idx) == 0, "expected an empty index, got ${len(idx)} words")
}
