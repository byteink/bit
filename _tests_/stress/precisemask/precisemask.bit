// #4255: exercises the BIT_GC_NO_CONSERVATIVE_SCAN build mode
// (runtime/stw/stwscan.bit's stwSetNoConservativeScan) end to end through a
// real compiled binary and the live collector, so the mode itself — not just
// the private-collector proof below — is proven safe for an ordinary,
// correctly-rooted program. `held` stays referenced by name for the whole
// function, so the compiler emits a real StackMapEntry for it; the precise
// walk (`gcScanSnapshot`) roots it whether or not the conservative fallback
// is enabled, and this must print "ok" either way.
//
// THE MUTATION-TESTED PROOF THAT THE MODE ACTUALLY REMOVES THE MASK lives in
// `_tests_/stress/stwcollect`'s own phase H
// (stwcollectcls8.bit's `phaseH`/`cls8Round`), which already builds exactly
// the case this ticket is about: sixteen raw `int`s, no stack-map coverage at
// all (`snap.ret = 0`, so class 2 cannot see them — see phaseH's own header),
// held live across a poll on the REAL running task's own stack. Its `alive=`
// count is class 8's conservative scan finding what nothing precise ever
// named — a "StackMapEntry that was never there" by construction, which is
// the ticket's regression shape without needing a hand-applied source edit.
//
// Reproduced by hand (never committed this way — one line, forced, observed,
// reverted): add `stwSetNoConservativeScan(env("BIT_GC_NO_CONSERVATIVE_SCAN")
// == "1")` (imports: `stwSetNoConservativeScan` from `../../../runtime/stw`,
// `env` from `std/os`) as the first line of `_tests_/stress/stwcollect/stwcollect.bit`'s
// `main`, build, then run the binary directly (not through the stress
// harness, which never sets this variable) twice:
//   BIT_GC=stress ./bin                                -> "H ... alive=16/16"
//     (masked: class 8 finds the sixteen un-mapped raw ints regardless)
//   BIT_GC=stress BIT_GC_NO_CONSERVATIVE_SCAN=1 ./bin   -> "H ... alive=0/16"
//     (reddens: nothing left names them, so all sixteen are swept)
// The second run's line no longer matches stwcollect.expected — a real,
// observable failure — which is exactly the point: today NOTHING can make
// that line fail, because nothing can turn class 8 off. Revert the one line
// before committing; stwcollect stays green with the mode OFF, which is its
// only supported state.

import { env } from "std/os"
import { stwSetNoConservativeScan } from "../../../runtime/stw"

const MARKER = 4255001
const ITERS = 400000

fn main() {
  // Inert here (held stays precisely rooted either way) — proves the mode
  // does not break an ordinary program, which the private-collector proof
  // above cannot: it never builds or runs a real binary.
  if (env("BIT_GC_NO_CONSERVATIVE_SCAN") == "1") {
    stwSetNoConservativeScan(true)
  }

  let held = []i64(1)
  held[0] = MARKER

  let i = 0
  while (i < ITERS) {
    let junk = []i64(1)
    junk[0] = i
    i = i + 1
  }

  if (held[0] == MARKER) {
    print("ok\n")
  } else {
    print("LOST ROOT\n")
  }
}
