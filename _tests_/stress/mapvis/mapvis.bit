// #5813 race 2: a comma-ok read that sees a key's ctrl tag must see that
// key's VALUE, not the zero word the table was allocated with.
//
// One green thread fills a presized `map<int, int>` (no grow, so the table
// never moves) with keys 1..perRound, every value nonzero (`key * 10 + 1`).
// Before each insert it publishes the key it is about to insert; the readers
// spin on `let (v, ok) = m[key]` for exactly that key. Valid outcomes are
// `ok=false` (not inserted yet) and `v == key * 10 + 1`. `ok=true` with any
// other value means the reader matched the ctrl tag and then loaded a value
// (or key) word the inserting thread had not yet made visible: the tag store
// was reordered ahead of the entry's key/value stores (arm64 does that to
// plain stores), or the reader's key/value loads ran ahead of its tag load.
//
// THE RACE HAS TO BE REAL: `workers` pins BIT_WORKERS=4, and a reader counts
// OVERLAPPED reads (the churner's insert counter moved across ONE read, with
// no back edge between the two loads), see maprace.bit. `concurrent=false`
// fails the `.expected` like a wrong value would.

// flags words: [0] the round being filled (negated once its inserts are done),
// [1] the key the next insert will write.
fn churn(chans: []chan<map<int, int>>, flags: []i64, acks: chan<int>) {
  let fp = ptrOf(flags)
  for (let r = 1; r <= rounds; r++) {
    let m = map<int, int>(perRound)
    atomicStore(fp + 1, 0)
    atomicStore(fp, r)
    for (let c = 0; c < len(chans); c++) {
      chans[c] <- m
    }
    for (let k = 1; k <= perRound; k++) {
      atomicStore(fp + 1, k)
      m[k] = k * 10 + 1
    }
    atomicStore(fp, -r)
    for (let c = 0; c < len(chans); c++) {
      <- acks
    }
  }
}

// One reader: [0] reads, [1] wrong values, [2] unused, [3] overlapped.
fn reader(ch: chan<map<int, int>>, flags: []i64, acks: chan<int>, out: chan<[]int>) {
  let fp = ptrOf(flags)
  let counts = []int(4)
  for (let r = 1; r <= rounds; r++) {
    let m = <- ch
    while (atomicLoad(fp) == r) {
      let k = atomicLoad(fp + 1)
      if (k == 0) {
        continue
      }
      let (v, ok) = m[k]
      let p1 = atomicLoad(fp + 1)
      counts[0] = counts[0] + 1
      if (ok && v != k * 10 + 1) {
        counts[1] = counts[1] + 1
      }
      if (p1 != k) {
        counts[3] = counts[3] + 1
      }
    }
    acks <- 0
  }
  out <- counts
}

const perRound: int = 20000
const rounds: int = 300
const readers: int = 3

fn main() {
  let flags = []i64(2)
  let chans = []chan<map<int, int>>(0)
  let acks = chan<int>(readers)
  let out = chan<[]int>(readers)
  for (let c = 0; c < readers; c++) {
    let ch = chan<map<int, int>>(1)
    chans = append(chans, ch)
    spawn reader(ch, flags, acks, out)
  }
  spawn churn(chans, flags, acks)
  let total = []int(4)
  for (let c = 0; c < readers; c++) {
    let counts = <- out
    for (let i = 0; i < 4; i++) {
      total[i] = total[i] + counts[i]
    }
  }
  eprint("mapvis: reads=${total[0]} overlapped=${total[3]} wrong=${total[1]}\n")
  print("mapvis: concurrent=${total[3] > 0} wrong=${total[1]}\n")
}
