// #6481 with #6480: a startup initializer builds objects, and the only reference
// to each lives in a module cell. The initializers run before `main`, allocate
// heavily, and under `BIT_GC=stress` (this corpus's harness runs each program
// under it) a collection runs at every allocation, so an object built by an
// earlier initializer is already live-and-unreachable-but-for-its-cell while a
// later one runs. The churn in `main` then reuses the freed slots of the sizes
// the live objects have; a collector that does not scan the cells hands those
// slots back and the read-back sees another object's bytes.
//
// The mutation, run through the compiled binary and not a rebuild: call
// `bit_rt_module_roots_register(0)` first in `main` (an `extern fn` of the
// pinned runtime symbol), which empties the table the entry function installed.
// Under stress the program then reads a freed object: it prints a mismatch or
// dies on a bus error. Without that call it prints `ok`.
import { exit } from "std/os"

class Item {
  id: int,
  name: string,
}

class Pool {
  items: []Item,
  tag: string,
}

enum Shape {
  Dot,
  Ring(Item),
}

const count: int = 48
const churnRounds: int = 3000

fn itemName(i: int): string {
  return "item-${i}-${i * 7}"
}

fn build(tag: string): Pool {
  let items = []Item(0)
  let i = 0
  while (i < count) {
    items = append(items, Item{ id = i, name = itemName(i) })
    i = i + 1
  }
  return Pool{ items = items, tag = tag }
}

let pool = build("pool")
const frozen = build("frozen")
let pair = (build("pair"), "pair-${count}")
let ring = Shape.Ring(Item{ id = 77, name = "ring-77" })
let blank: Pool

// Allocates objects of the sizes the live data has, and drops them at once.
fn churn(n: int) {
  let i = 0
  while (i < n) {
    let junk = Item{ id = -1, name = "junk-${i}" }
    let buf = []Item(4)
    buf[0] = junk
    i = i + 1
  }
}

fn failed(what: string): bool {
  print("moduleinit: ${what} corrupted\n")
  return true
}

fn poolOk(p: Pool, tag: string): bool {
  if (p.tag != tag || len(p.items) != count) {
    return false
  }
  let i = 0
  while (i < count) {
    if (p.items[i].id != i || p.items[i].name != itemName(i)) {
      return false
    }
    i = i + 1
  }
  return true
}

fn ringOk(): bool {
  match (ring) {
    Dot => return false
    Ring(it) => return it.id == 77 && it.name == "ring-77"
  }
}

fn check(): bool {
  let bad = false
  if (!poolOk(pool, "pool")) {
    bad = failed("pool")
  }
  if (!poolOk(frozen, "frozen")) {
    bad = failed("frozen")
  }
  if (!poolOk(pair.0, "pair") || pair.1 != "pair-${count}") {
    bad = failed("pair")
  }
  if (!ringOk()) {
    bad = failed("ring")
  }
  if (blank.tag != "" || len(blank.items) != 0) {
    bad = failed("blank")
  }
  return bad
}

fn main() {
  churn(churnRounds)
  if (check()) {
    exit(1)
  }
  print("ok\n")
}
