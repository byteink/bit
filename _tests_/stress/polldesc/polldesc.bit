// Stress harness for #5864's polldesc protocol (`runtime/sched/polldesc.bit`):
// OS-thread-parallel (BIT_WORKERS controls how many real worker threads run
// these green tasks) racing of wait/wake/cancel/close/reopen against a small,
// deliberately reused fd range. NO poller is wired in -- every "readiness
// edge" and "timer firing" below is a direct call into polldesc's exported
// protocol, exactly as the ticket asks for "proven in isolation".
//
// WHAT IS COUNTED, AND WHY IT IS DETERMINISTIC. `claimed` and `ready` depend
// only on the fixed round structure below (which round pre-arms an edge is
// decided by `k % PREWAKE_EVERY`, never by scheduling), so both are pinned
// exactly in `.expected`. WHICH of {pdWake, pdCancel, pdClose} wins a given
// round's race is scheduler-timing dependent and therefore never printed;
// what IS asserted, every round, is that EXACTLY ONE of them won --
// `resolved == claimed`, where `resolved` sums however many total wins were
// recorded across every round. A double-resolve or a lost edge breaks that
// equality, which `ok` catches.
//
// THE STALE-GENERATION PROOF is separate and single-threaded
// (`staleGenCheck`), run after every driver has joined: open, claim, close
// (which legitimately wakes the claim), reopen, then a wake and a cancel
// carrying the OLD generation must both report "nothing to do" and must not
// disturb the fresh generation's slot -- proven by a normal wait/wake on the
// new generation working right afterward.
//
// THE WAIT-VS-CLOSE RACE (`waitCloseDriver`) is separate again: every race
// above pits `pdWake`/`pdCancel`/`pdClose` against an ALREADY-claimed slot,
// never against a `pdWait` still trying to claim it. A design that makes
// `pdClose` authoritative by running its sweep first and bumping the
// generation after (rather than the reverse) can let a `pdWait` racing that
// exact window CAS its task into the slot successfully, under the
// still-current generation, ARM'ED AFTER the close's own sweep already ran
// -- parked forever, since nothing sweeps that slot again. Two dedicated fds
// (`waitCloseFdBase`/`+1`, never touched by `driver` or `staleGenCheck`) race
// `pdWait` directly against `pdClose` thousands of times each; the one
// forbidden outcome is `pdWait` reporting `pdClaimed` while `pdClose`'s own
// report does not name that exact task.

import {
  pdOpen, pdWait, pdWake, pdCancel, pdClose,
  pdDirRead, pdDirWrite, pdClaimed, pdAlreadyReady, pdEmpty, pdBusy,
  pdFdAcquire, pdFdRelease, pdFdMarkClosing,
  pdFdAcquired, pdFdRefusedLast, pdFdCloseNow, pdFdCloseDeferred,
} from "../../../runtime/sched"

const FDS: int = 6
const ROUNDS: int = 2000
const PREWAKE_EVERY: int = 5
const THREEWAY_EVERY: int = 20
const WAITCLOSE_FD_BASE: int = FDS + 1
const WAITCLOSE_FD_COUNT: int = 2
const WAITCLOSE_ROUNDS: int = 4000

// `counters[]` layout, one shared buffer every driver task accumulates into
// through `atomicAdd` -- never a lock, matching the ticket's own constraint.
const cClaimed: int = 0
const cWake: int = 1
const cCancel: int = 2
const cClose: int = 3
const cReady: int = 4
const cBad: int = 5
const cWaitCloseBad: int = 6
const counterCount: int = 7

fn nextId(idCounter: *i64): int {
  return (atomicAdd(idCounter, 1) + 1) * 8
}

fn wakeResolver(fd: int, dir: int, gen: int, out: chan<i64>) {
  out <- pdWake(fd, dir, gen)
}

fn cancelResolver(fd: int, dir: int, taskId: int, gen: int, out: chan<i64>) {
  let hit = 0
  if (pdCancel(fd, dir, taskId, gen)) {
    hit = 1
  }
  out <- hit
}

fn closeResolver(fd: int, dir: int, out: chan<i64>) {
  let rbuf = []i64(1)
  let wbuf = []i64(1)
  pdClose(fd, ptrOf(rbuf), ptrOf(wbuf))
  let woke = rbuf[0]
  if (dir == pdDirWrite) {
    woke = wbuf[0]
  }
  out <- woke
}

// Race wake+cancel -- the deadline-read shape #5861 measured -- against one
// claimed wait. Returns true iff exactly one of the two resolved it.
//
// EACH RESOLVER GETS ITS OWN CHANNEL. A single shared channel would still be
// correct as a rendezvous, but reading two results off ONE channel cannot
// tell which resolver a given value came from without tagging it -- an
// ambiguity in this harness, not in the protocol under test.
fn raceTwo(fd: int, dir: int, gen: int, myId: int, counters: *i64): bool {
  let wakeCh = chan<i64>(1)
  let cancelCh = chan<i64>(1)
  spawn wakeResolver(fd, dir, gen, wakeCh)
  spawn cancelResolver(fd, dir, myId, gen, cancelCh)
  let a = <- wakeCh
  let b = <- cancelCh
  let wins = 0
  if (a == myId) {
    atomicAdd(counters + cWake, 1)
    wins = wins + 1
  }
  if (b == 1) {
    atomicAdd(counters + cCancel, 1)
    wins = wins + 1
  }
  return wins == 1
}

// Race wake+cancel+close together. Returns true iff exactly one resolved it.
fn raceThree(fd: int, dir: int, gen: int, myId: int, counters: *i64): bool {
  let wakeCh = chan<i64>(1)
  let cancelCh = chan<i64>(1)
  let closeCh = chan<i64>(1)
  spawn wakeResolver(fd, dir, gen, wakeCh)
  spawn cancelResolver(fd, dir, myId, gen, cancelCh)
  spawn closeResolver(fd, dir, closeCh)
  let a = <- wakeCh
  let b = <- cancelCh
  let c = <- closeCh
  let wins = 0
  if (a == myId) {
    atomicAdd(counters + cWake, 1)
    wins = wins + 1
  }
  if (b == 1) {
    atomicAdd(counters + cCancel, 1)
    wins = wins + 1
  }
  if (c == myId) {
    atomicAdd(counters + cClose, 1)
    wins = wins + 1
  }
  return wins == 1
}

// One prewake round: fire the edge before anyone waits, then confirm the
// following `pdWait` consumes it immediately (invariant 2, no lost edge).
// Opens `fd` itself (rather than taking `gen` as a parameter) to keep every
// round function at or under the 5-param lint ceiling.
fn prewakeRound(fd: int, dir: int, myId: int, counters: *i64): bool {
  let gen = pdOpen(fd)
  let pw = pdWake(fd, dir, gen)
  if (pw != pdEmpty) {
    return false // a spurious task id: nothing was parked to hand it to
  }
  let r = pdWait(fd, dir, gen, myId)
  if (r != pdAlreadyReady) {
    return false
  }
  atomicAdd(counters + cReady, 1)
  let rbuf = []i64(1)
  let wbuf = []i64(1)
  pdClose(fd, ptrOf(rbuf), ptrOf(wbuf))
  return rbuf[0] == 0 && wbuf[0] == 0
}

// One claim-and-race round: open+claim the slot, then race it against the
// wake and cancel resolvers (and, when `useThree`, close too), then always
// close to reset for the next round's reopen. Opens `fd` itself for the same
// reason `prewakeRound` does.
fn claimRound(fd: int, dir: int, myId: int, useThree: bool, counters: *i64): bool {
  let gen = pdOpen(fd)
  let r = pdWait(fd, dir, gen, myId)
  if (r != pdClaimed) {
    return false
  }
  atomicAdd(counters + cClaimed, 1)
  let clean = false
  if (useThree) {
    clean = raceThree(fd, dir, gen, myId, counters)
  } else {
    clean = raceTwo(fd, dir, gen, myId, counters)
  }
  let rbuf = []i64(1)
  let wbuf = []i64(1)
  pdClose(fd, ptrOf(rbuf), ptrOf(wbuf))
  return clean && rbuf[0] == 0 && wbuf[0] == 0
}

fn driver(fd: int, idCounter: *i64, counters: *i64, done: chan<i64>) {
  let bad = 0
  let k = 0
  while (k < ROUNDS) {
    let dir = k % 2
    let myId = nextId(idCounter)
    let ok = true
    if (k % PREWAKE_EVERY == 0) {
      ok = prewakeRound(fd, dir, myId, counters)
    } else {
      ok = claimRound(fd, dir, myId, k % THREEWAY_EVERY == 1, counters)
    }
    if (!ok) {
      bad = bad + 1
    }
    k = k + 1
  }
  atomicAdd(counters + cBad, bad)
  done <- 1
}

fn waitResolver(fd: int, dir: int, gen: int, taskId: int, out: chan<i64>) {
  out <- pdWait(fd, dir, gen, taskId)
}

fn closeReadResolver(fd: int, out: chan<i64>) {
  let rbuf = []i64(1)
  let wbuf = []i64(1)
  pdClose(fd, ptrOf(rbuf), ptrOf(wbuf))
  out <- rbuf[0]
}

// One wait-vs-close round on `fd`'s read direction: open, then race a
// `pdWait` claim directly against a `pdClose` with no other participant. The
// only forbidden outcome is `pdWait` reporting `pdClaimed` while `pdClose`'s
// own report does not name `myId` -- that would mean the wait's CAS landed
// after the close's sweep already ran, with the task now parked and nothing
// left to ever wake it. `pdBusy` (the wait's retry budget exhausted under
// contention) and `pdStaleGen` (the wait lost the race outright) are both
// fine: the wait saw the close one way or the other.
fn waitCloseRound(fd: int, myId: int): bool {
  let gen = pdOpen(fd)
  let waitCh = chan<i64>(1)
  let closeCh = chan<i64>(1)
  spawn waitResolver(fd, pdDirRead, gen, myId, waitCh)
  spawn closeReadResolver(fd, closeCh)
  let waitResult = <- waitCh
  let closedTask = <- closeCh
  return !(waitResult == pdClaimed && closedTask != myId)
}

fn waitCloseDriver(fd: int, idCounter: *i64, counters: *i64, done: chan<i64>) {
  let bad = 0
  let k = 0
  while (k < WAITCLOSE_ROUNDS) {
    let myId = nextId(idCounter)
    if (!waitCloseRound(fd, myId)) {
      bad = bad + 1
    }
    k = k + 1
  }
  atomicAdd(counters + cWaitCloseBad, bad)
  done <- 1
}

// Single-threaded: proves a stale generation's wake/cancel touches nothing.
fn staleGenCheck(fd: int): bool {
  let gen1 = pdOpen(fd)
  // Wider than 44 bits: the x86-64 task address #5866's first version
  // truncated and then woke.
  let id1 = 0x7cd7f4a03000
  if (pdWait(fd, pdDirRead, gen1, id1) != pdClaimed) {
    return false
  }
  let rbuf = []i64(1)
  let wbuf = []i64(1)
  let gen2 = pdClose(fd, ptrOf(rbuf), ptrOf(wbuf))
  if (rbuf[0] != id1) {
    return false // the close did not wake the outstanding claim
  }
  let gen3 = pdOpen(fd)
  if (gen3 != gen2 + 1) {
    return false
  }
  if (pdWake(fd, pdDirRead, gen1) != pdEmpty) {
    return false // a stale-generation wake must never report a task
  }
  if (pdCancel(fd, pdDirRead, id1, gen1)) {
    return false // a stale-generation cancel must never report success
  }
  // The top of aarch64 Linux's 48-bit user range.
  let id2 = 0xfffffffff000
  if (pdWait(fd, pdDirRead, gen3, id2) != pdClaimed) {
    return false // the stale noise above must not have touched the fresh slot
  }
  if (pdWake(fd, pdDirRead, gen3) != id2) {
    return false
  }
  pdClose(fd, nil, nil)
  return unpackableIdsRefused(fd)
}

// An id `pdTaskOk` cannot pack without losing bits (unaligned, or 2^48 and
// up) is refused, never stored truncated.
fn unpackableIdsRefused(fd: int): bool {
  let gen = pdOpen(fd)
  if (pdWait(fd, pdDirRead, gen, 8000001) != pdBusy) {
    return false
  }
  if (pdWait(fd, pdDirRead, gen, 0x1000000000000) != pdBusy) {
    return false
  }
  pdClose(fd, nil, nil)
  return true
}

// #5888: direct stress of #5886's per-fd ref-count protocol
// (`pdFdAcquire`/`pdFdRelease`/`pdFdMarkClosing`), completely independent of
// the wait/wake/close machinery above -- every driver above acquires its
// task-id slot once at entry and never touches the ref-count API at all, so
// #5886's own verifier found a `pdFdAcquire` that ignores `closing` left
// every one of them green. The closer below is modeled exactly on `netClose`
// (`runtime/net/darwin/sock.bit`): `pdFdCloseNow` means this call's own
// decrement already found "last out" and this caller must close(2) itself;
// `pdFdCloseDeferred` means this call is the first closer, so it still holds
// the ref `pdFdMarkClosing` took and must release it itself (immediately,
// not after a `pdClose`/unregister step, since this driver has none to
// interleave); anything else (`pdFdCloseAlready`) is a no-op second close.
const REF_FD_BASE: int = WAITCLOSE_FD_BASE + WAITCLOSE_FD_COUNT
const REF_FD_COUNT: int = 3
const REF_ROUNDS: int = 1000
const REF_WORKERS: int = 4
const REF_TWOCLOSE_EVERY: int = 7
const REF_POSTOR_PROBES: int = 4

const rcClosed: int = 0      // cycles where exactly one close was owed
const rcBadCycle: int = 1    // cycles where the owed-close total was not 1
const rcLateAcquire: int = 2 // a post-OR probe acquired after closing was visible
const refCounterCount: int = 3

// `armed` reports that this worker's OWN `pdFdAcquire` has already run
// (so `refRound` knows every worker is either holding a ref or has already
// backed one out before the closer's own `pdFdMarkClosing` even starts --
// see `refRound`'s header for why that ordering is what makes "exactly one
// close" provable), then `go` blocks until the closer has started, so the
// release below races it for real.
fn refWorker(fd: int, gen: int, armed: chan<i64>, go: chan<i64>, out: chan<i64>) {
  let r = pdFdAcquire(fd, gen)
  armed <- 1
  let _ = <- go
  let closed = 0
  if (r == pdFdAcquired) {
    if (pdFdRelease(fd)) {
      closed = 1
    }
  } else if (r == pdFdRefusedLast) {
    closed = 1
  }
  out <- closed
}

// The second, truly concurrent `netClose(fd)` a few cycles race in --
// `pdFdMarkClosing` here always observes `closing` already set (the primary
// closer's own OR ran before this task was even spawned) and this call's own
// add+undo races real hardware visibility of that OR the same way a second
// real `netClose` thread would. `pdFdCloseNow` is answered `false`: the
// primary closer's own ref (held for this whole window -- see `refCloser`)
// keeps the live count at 2+ for as long as this call can observe it, so its
// own undo can never be the zero-crossing; only `pdFdCloseAlready` is
// reachable here, proven, not assumed.
fn refSecondCloser(fd: int, out: chan<i64>) {
  let ok = 0
  if (pdFdMarkClosing(fd) != pdFdCloseNow) {
    ok = 1
  }
  out <- ok
}

// Modeled on `netClose`. On `pdFdCloseDeferred` the OR that made `closing`
// visible just ran, in program order, before anything below -- and this
// closer's own ref (taken by `pdFdMarkClosing`) is held until the very last
// line, so the live count cannot reach zero through anyone else in between
// (`refSecondCloser`'s own header proves it, `refWorker`'s refusal path
// never sees a zero-crossing either since `pdFdRelease` only reports true
// when `closing` was already visible to IT). Every post-OR probe below must
// therefore see `closing` and refuse; `p` numbers each one, the "sequence
// number" the ticket asks the closer to record. A probe reporting
// `pdFdAcquired` is the exact violation a `pdFdAcquire` mutated to ignore
// `closing` produces.
fn refCloser(fd: int, gen: int, twoClose: bool, out: chan<i64>, lateCounter: *i64) {
  let decision = pdFdMarkClosing(fd)
  if (decision == pdFdCloseNow) {
    out <- 1
    return
  }
  if (decision != pdFdCloseDeferred) {
    out <- 0
    return
  }
  let secondOk = true
  if (twoClose) {
    let secondCh = chan<i64>(1)
    spawn refSecondCloser(fd, secondCh)
    secondOk = <- secondCh == 1
  }
  let p = 0
  while (p < REF_POSTOR_PROBES) {
    if (pdFdAcquire(fd, gen) == pdFdAcquired) {
      atomicAdd(lateCounter, 1)
    }
    p = p + 1
  }
  let closed = 0
  if (pdFdRelease(fd)) {
    closed = 1
  }
  if (!secondOk) {
    closed = 0 - 1 // impossible per refSecondCloser's proof; force a bad cycle
  }
  out <- closed
}

// One ref-count cycle: open, let `REF_WORKERS` tasks each acquire a ref (all
// of them, before the closer even starts -- `armCh`'s join is what
// guarantees that), then release them concurrently with one closer (which
// itself races a second, concurrent `netClose` on some cycles -- see
// `refCloser`). Acquiring every worker's ref BEFORE `pdFdMarkClosing` runs
// is what makes "exactly one close" provable rather than scheduling-lucky:
// the closer's own ref (held for the whole window, see `refCloser`) then
// keeps the live count at 2+ until every worker AND the closer have each
// released once, so only the SINGLE decrement that empties it can ever see
// `pdFdRelease`'s old-count-was-1 condition. A worker whose fresh, unrelated
// acquire attempt were allowed to land AFTER the count had already emptied
// once could independently re-cross zero and also be told to close -- a real
// double-close hazard this ordering rules out, not one this driver needs to
// reproduce (real callers gate new ops on `pdFdClosing` before ever
// reaching `pdFdAcquire`, exactly like the retry loops `pdFdClosing`'s own
// header describes). `pdFdRelease`'s contract ("true only when THIS call's
// decrement took the count to zero") makes the total below the direct proof
// the count returned to 0 -- a leaked or double-released ref (e.g.
// `pdFdMarkClosing` skipping its own ref) shows up here as anything but 1,
// not a separate counter to read.
fn refRound(fd: int, twoClose: bool, lateCounter: *i64): bool {
  let gen = pdOpen(fd)
  let armCh = chan<i64>(REF_WORKERS)
  let goCh = chan<i64>(REF_WORKERS)
  let workCh = chan<i64>(REF_WORKERS)
  let w = 0
  while (w < REF_WORKERS) {
    spawn refWorker(fd, gen, armCh, goCh, workCh)
    w = w + 1
  }
  let a = 0
  while (a < REF_WORKERS) {
    let _ = <- armCh
    a = a + 1
  }
  let closeCh = chan<i64>(1)
  spawn refCloser(fd, gen, twoClose, closeCh, lateCounter)
  let g = 0
  while (g < REF_WORKERS) {
    goCh <- 1
    g = g + 1
  }
  let total = 0
  let j = 0
  while (j < REF_WORKERS) {
    total = total + <- workCh
    j = j + 1
  }
  total = total + <- closeCh
  return total == 1
}

fn refDriver(fd: int, counters: *i64, done: chan<i64>) {
  let bad = 0
  let closedCycles = 0
  let k = 0
  while (k < REF_ROUNDS) {
    let twoClose = k % REF_TWOCLOSE_EVERY == 0
    if (refRound(fd, twoClose, counters + rcLateAcquire)) {
      closedCycles = closedCycles + 1
    } else {
      bad = bad + 1
    }
    k = k + 1
  }
  atomicAdd(counters + rcClosed, closedCycles)
  atomicAdd(counters + rcBadCycle, bad)
  done <- 1
}

// Runs every `refDriver` to completion and prints the pinned ref-count
// summary line. Split out of `main` to keep it under the complexity ceiling.
fn runRefDrivers() {
  let refCounters = []i64(refCounterCount)
  let rcp = ptrOf(refCounters)
  let refDone = chan<i64>(REF_FD_COUNT)
  let rf = 0
  while (rf < REF_FD_COUNT) {
    spawn refDriver(REF_FD_BASE + rf, rcp, refDone)
    rf = rf + 1
  }
  let rj = 0
  while (rj < REF_FD_COUNT) {
    let _ = <- refDone
    rj = rj + 1
  }

  let refClosed = refCounters[rcClosed]
  let refBad = refCounters[rcBadCycle]
  let refLate = refCounters[rcLateAcquire]
  let refExpectClosed = REF_FD_COUNT * REF_ROUNDS
  let refOk = refBad == 0 && refClosed == refExpectClosed && refLate == 0

  print("refok ${refOk} closed ${refClosed} bad ${refBad} late ${refLate}\n")
}

fn main() {
  let counters = []i64(counterCount)
  let cp = ptrOf(counters)
  let idbuf = []i64(1)
  let idCounter = ptrOf(idbuf)
  let done = chan<i64>(FDS)

  let f = 0
  while (f < FDS) {
    spawn driver(f, idCounter, cp, done)
    f = f + 1
  }
  let wcDone = chan<i64>(WAITCLOSE_FD_COUNT)
  let wf = 0
  while (wf < WAITCLOSE_FD_COUNT) {
    spawn waitCloseDriver(WAITCLOSE_FD_BASE + wf, idCounter, cp, wcDone)
    wf = wf + 1
  }
  let j = 0
  while (j < FDS) {
    let _ = <- done
    j = j + 1
  }
  let wj = 0
  while (wj < WAITCLOSE_FD_COUNT) {
    let _ = <- wcDone
    wj = wj + 1
  }

  runRefDrivers()

  let staleOk = staleGenCheck(FDS)

  let claimed = counters[cClaimed]
  let ready = counters[cReady]
  let bad = counters[cBad]
  let waitCloseBad = counters[cWaitCloseBad]
  let resolved = counters[cWake] + counters[cCancel] + counters[cClose]

  let expectClaimed = FDS * (ROUNDS - ROUNDS / PREWAKE_EVERY)
  let expectReady = FDS * (ROUNDS / PREWAKE_EVERY)

  let ok = staleOk &&
    bad == 0 &&
    claimed == expectClaimed &&
    ready == expectReady &&
    resolved == claimed &&
    waitCloseBad == 0

  print("ok ${ok} claimed ${claimed} ready ${ready} resolved ${resolved} bad ${bad} waitclosebad ${waitCloseBad} stale ${staleOk}\n")
}
