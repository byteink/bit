// Task-local storage isolation under load (#5028, docs/context-propagation.md
// decision B). `main` sets its task-local word, spawns `nTasks` children, and
// each child (a) reads back the value it inherited AT SPAWN TIME — must equal
// `main`'s — before writing anything, (b) overwrites its own word with a value
// unique to that child, spins to give the other `nTasks - 1` children real
// concurrent runtime to interfere in, then (c) reads its own word back — must
// still be what it wrote, never a sibling's. After every child reports in,
// `main` checks its own word is still what it set: a child's write must not
// leak backward, either.
//
// A SHARED SLOT (the bug this decision explicitly rules out — see
// docs/context-propagation.md's "Can B carry a cancellation signal later?"
// section, and the prototype's own mutation-test paragraph) fails this
// differently depending on scheduling, but under `BIT_GC=stress` — a
// collection at every loop back-edge, so `spin` below yields real wall-clock
// window for the other 15 children to run in parallel — some child's
// inherited-value check or own-value check goes wrong on effectively every
// run: `failures` stops being `0`.
import { taskLocalGet, taskLocalSet } from "std/runtime"

const nTasks: int = 16
const parentValue: int = 100
const spinCount: int = 20000

// Bounded busy-work (Power of 10 rule 2): gives the scheduler real wall-clock
// time to run other children on other workers between this child's write and
// its own read-back, without depending on any explicit yield.
fn spin(n: int) {
  let i = 0
  while (i < n) {
    i = i + 1
  }
}

fn worker(id: int, results: chan<int>) {
  let inherited = taskLocalGet()
  let ok = 1
  if (inherited != parentValue) {
    ok = 0
  }
  let own = 1000 + id
  taskLocalSet(own)
  spin(spinCount)
  if (taskLocalGet() != own) {
    ok = 0
  }
  results <- ok
}

fn main() {
  taskLocalSet(parentValue)
  let results = chan<int>(0)
  let i = 0
  while (i < nTasks) {
    spawn worker(i, results)
    i = i + 1
  }
  let failures = 0
  let got = 0
  while (got < nTasks) {
    let ok = <- results
    if (ok == 0) {
      failures = failures + 1
    }
    got = got + 1
  }
  let parentOk = 1
  if (taskLocalGet() != parentValue) {
    parentOk = 0
  }
  print("TASKLOCAL OK n=${nTasks} failures=${failures} parentOk=${parentOk}\n")
}
