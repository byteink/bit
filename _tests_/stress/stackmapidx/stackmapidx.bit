// #5852: the stack-map index (runtime/gc/stackmapidx.bit) names the entry the
// linear walk names, for every pc that can matter.
//
// The table probed is the one linked into THIS binary: this program's
// functions and every runtime member's, one merged extent (ABI.md §4). For
// every entry it probes the first and last byte of the entry's code range, the
// byte before and the byte after it, and the return address of every
// safepoint the entry records; then pcs no entry can hold. Each probe must get
// the same answer from `smIdxFind` as from `smLinearFind`, the walk
// `scanFrame` did for every frame before the index existed.
//
// The walk over the table here is this file's own decoder, not the runtime's
// parse, and every entry with a non-empty range must resolve to its own
// offset. So the oracle is checked too, and a parse fault both lookups share
// cannot pass unseen.
//
// The index is the live one: the program imports the runtime's own module
// state, which `gcInit` built at boot, and `smIdxReady` must say so.
//
// Mutation, observed: making `smIdxFind` return the neighbouring pair (`lo`
// for `lo - 1`) fails every hit probe.

import { loadByte, smIdxBuild, smIdxReady, smIdxFind, smLinearFind } from "../../../runtime/gc"

// A floor far below any real binary's entry count (every runtime function has
// one), so a decoder that walked something other than the table fails here.
const MIN_ENTRIES = 100

// `runtime/gc/stackmap.bit`'s `smMaxEntries`: the linear walk's own bound.
const MAX_ENTRIES = 4194304

const MAX_INT = 9223372036854775807

let nEntries: i64 = 0
let nProbes: i64 = 0
let nHits: i64 = 0
let nMisses: i64 = 0
let nDiffer: i64 = 0 // probes the two lookups disagree on
let nAstray: i64 = 0 // non-empty entries whose first byte resolves elsewhere

@nosplit fn u16At(a: int): int {
  return loadByte(a) | (loadByte(a + 1) << 8)
}

@nosplit fn u32At(a: int): int {
  return u16At(a) | (u16At(a + 2) << 16)
}

@nosplit fn u64At(a: int): int {
  return u32At(a) | (u32At(a + 4) << 32)
}

@nosplit fn probe(pc: int) {
  let want = smLinearFind(pc)
  nProbes = nProbes + 1
  if (smIdxFind(pc) != want) {
    nDiffer = nDiffer + 1
  }
  if (want < 0) {
    nMisses = nMisses + 1
  } else {
    nHits = nHits + 1
  }
}

// Probes the return address of the safepoint record at address `a` and
// returns the address just past the record.
@nosplit fn probeSafepoint(code: int, a: int): int {
  probe(code + u32At(a))
  let p = a + 6 + u16At(a + 4) * 4
  return p + 2 + u16At(p) * 2
}

// Probes the entry at `off` and returns the next entry's offset.
@nosplit fn probeEntry(base: int, off: int): int {
  let a = base + off
  let code = u64At(a)
  let size = u32At(a + 10)
  probe(code - 1)
  probe(code)
  probe(code + size - 1)
  probe(code + size)
  if (size > 0 && smLinearFind(code) != off) {
    nAstray = nAstray + 1
  }
  let p = a + 16 + u16At(a + 14) * 6
  let nsp = u16At(p)
  p = p + 2
  let i = 0
  // Bounded: this entry's safepoint count.
  while (i < nsp) {
    p = probeSafepoint(code, p)
    i = i + 1
  }
  let end = p - base
  return (end + 7) / 8 * 8
}

@nosplit fn probeTable() {
  // First, so the runtime's checked walk has refused a malformed table before
  // this unchecked decoder reads it.
  probe(0)
  probe(1)
  probe(-1)
  probe(MAX_INT)
  let base = int(stackMapsBegin())
  let tblLen = int(stackMapsEnd()) - base
  let off = 0
  // Bounded by the extent and by the linear walk's own entry bound.
  while (off < tblLen && nEntries < MAX_ENTRIES) {
    off = probeEntry(base, off)
    nEntries = nEntries + 1
  }
}

fn main() {
  // A no-op when boot's `gcInit` has built it, which `smIdxReady` checks.
  smIdxBuild()
  if (!smIdxReady()) {
    println("stackmapidx: FAIL: the index was declined, so nothing here tests it")
    return
  }
  probeTable()
  let outside = smIdxFind(0) == -1 && smIdxFind(MAX_INT) == -1
  if (nDiffer != 0 || nAstray != 0 || !outside) {
    println("stackmapidx: FAIL: differ=${nDiffer} astray=${nAstray} outside=${outside}")
    return
  }
  if (nEntries < MIN_ENTRIES || nHits == 0 || nMisses == 0) {
    println("stackmapidx: FAIL: vacuous: entries=${nEntries} hits=${nHits} misses=${nMisses}")
    return
  }
  println("stackmapidx: ok")
}
