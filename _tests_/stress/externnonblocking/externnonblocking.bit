// `@nonblocking` takes an `extern fn` out of the syscall bracket (#7842, SPEC
// §11.7): the control for ../externbracket. Same scene, one worker (`workers`),
// a `blocker` inside `bit_foreign_block` and a `starter` queued behind it, but
// the declaration is `@nonblocking`, so the compiler emits no
// `bit_rt_gc_syscall_begin`/`_end` around the call, the worker's slot stays
// `running`, the monitor's retake never sees it, and `starter` runs only when the
// foreign call returns. A fast, non-blocking foreign function pays no bracket;
// this is what that costs a function that does block.
import { foreignBlock } from "../externbracket/rt"

@nonblocking extern fn bit_foreign_block(ns: i64)

const blockNs: int = 300000000
const lagMinNs: int = 250000000

let entered: [1]i64

fn blocker() {
  atomicAdd(ptrOf(entered), 1)
  bit_foreign_block(blockNs)
}

fn starter(out: chan<int>) {
  out <- int(atomicLoad(ptrOf(entered)))
}

fn main(): int {
  foreignBlock(1) // the Bit-side call: proves ./rt is linked and the pin resolves
  let starts = chan<int>(1)
  let t0 = timeMonoNs()
  spawn blocker()
  spawn starter(starts)
  let sawEntered = <- starts
  let lag = timeMonoNs() - t0
  if (sawEntered != 1) {
    print("externnonblocking FAIL: starter ran before blocker entered the foreign call\n")
    return 1
  }
  if (lag < lagMinNs) {
    print("externnonblocking FAIL: starter ran ${lag / 1000000} ms after spawn (want >= ${lagMinNs / 1000000}): the call was bracketed\n")
    return 1
  }
  print("externnonblocking: ok\n")
  return 0
}
