// #5813: a read racing delete(K) + insert(K2) into K's slot must never return
// K2's value for K.
//
// One green thread churns a small presized `map<int, int>`: `delete(m, K)`,
// `m[K2] = otherVal` (the insert claims K's tombstone whenever K2's probe path
// crosses it, and the table is eight slots, so most do), `delete(m, K2)`,
// `m[K] = probeVal`. The readers spin on `m[K]`, both forms: the two-call
// `let (v, ok) = m[K]` (`bit_rt_map_slot` then `bit_rt_map_val_at`) and the
// one-call plain `m[K]` (`bit_rt_map_get`). K is only ever stored as
// `probeVal`, so a reader that returns `otherVal` was handed ANOTHER key's
// value: SPEC §13.7's "some value some write actually stored there", read as
// "stored under this key" the way maprace (#5796) reads it. Valid outcomes are
// `ok=false` (comma-ok), `probeVal`, and the zero word a delete leaves behind.
//
// THE RACE HAS TO BE REAL: `workers` pins BIT_WORKERS=4, and a reader counts
// OVERLAPPED reads (the churner's iteration counter moved across ONE read, with
// no back edge between the two loads), see maprace.bit. `concurrent=false`
// fails the `.expected` like a wrong value would.

fn churn(m: map<int, int>, flags: []i64) {
  let fp = ptrOf(flags)
  for (let r = 1; r <= rounds; r++) {
    delete(m, probeKey)
    m[probeKey + 1 + r % 13] = otherVal
    delete(m, probeKey + 1 + r % 13)
    m[probeKey] = probeVal
    atomicStore(fp, r)
  }
  atomicStore(fp + 1, 1)
}

// One reader: [0] reads, [1] wrong comma-ok values, [2] wrong plain values,
// [3] overlapped reads.
fn reader(m: map<int, int>, flags: []i64, out: chan<[]int>) {
  let fp = ptrOf(flags)
  let counts = []int(4)
  while (atomicLoad(fp + 1) == 0) {
    let p0 = atomicLoad(fp)
    let (v, ok) = m[probeKey]
    let p1 = atomicLoad(fp)
    if (ok && v == otherVal) {
      counts[1] = counts[1] + 1
    }
    if (p1 != p0) {
      counts[3] = counts[3] + 1
    }
    if (m[probeKey] == otherVal) {
      counts[2] = counts[2] + 1
    }
    counts[0] = counts[0] + 1
  }
  out <- counts
}

const probeKey: int = 1000
const probeVal: int = 777
const otherVal: int = 999
const rounds: int = 3000000
const readers: int = 3

fn main() {
  let m = map<int, int>(4)
  m[probeKey] = probeVal
  let flags = []i64(2)
  let out = chan<[]int>(readers)
  for (let c = 0; c < readers; c++) {
    spawn reader(m, flags, out)
  }
  spawn churn(m, flags)
  let total = []int(4)
  for (let c = 0; c < readers; c++) {
    let counts = <- out
    for (let i = 0; i < 4; i++) {
      total[i] = total[i] + counts[i]
    }
  }
  eprint("mapreuse: reads=${total[0]} overlapped=${total[3]} wrongcommaok=${total[1]} wrongplain=${total[2]}\n")
  print("mapreuse: concurrent=${total[3] > 0} wrong=${total[1] + total[2]}\n")
}
