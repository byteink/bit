// A — Wyhash at every byte ALIGNMENT of its input (#4353).
//
// A sibling of `rootbit.bit`, same directory and therefore the same module, so
// `mine`, `rtStringSlice`, `rtWyhashString`, `loadWord` and `strPtr` are already
// bound here — an import is per-MODULE, and re-importing any of them is E0042.
// It is a separate file only because `rootbit.bit` is 20 lines from the
// 800-line ceiling.
//
// WHY THIS PHASE EXISTS. `wyhash` reads its input as whole 64- and 32-bit
// little-endian words (`loadLe8`/`loadLe4` in `runtime/root/maps.bit`). The byte
// loop those replaced could not care where the input sat; a word load can, and
// the failure is SILENT: `runtime/gc/mem.bit`'s `loadWord` MASKS its argument to
// an 8-byte boundary, so a misaligned read through it returns a different eight
// bytes rather than faulting. That is a wrong hash, and a wrong hash is a map
// that loses entries.
//
// THE SEVEN OFFICIAL VECTORS DO NOT COVER THIS. They are hashed at whatever
// alignment a fresh allocation happens to give — 8-aligned, every one — so only
// the offsets wyhash itself computes are ever unaligned. Two of the seven (26
// and 62 bytes) do land on such an offset and would catch a masked load there;
// none of them says anything about a misaligned BASE, which is what an ordinary
// `s[1:]` produces (`strInitView` sets `ptr = strBytes(src) + lo` — the bytes are
// shared, not copied).
//
// AND `phaseM` CANNOT SEE IT EITHER, which is the reason this is a digest
// comparison and not a map assertion: `phaseM` matches slot order between two
// maps that both use the hash under test, so a hash that is wrong CONSISTENTLY
// passes it. Mutating `loadLe8` back to the masking `loadWord` was measured:
// `map=8/8` still passed while this phase went 88 -> 60 and `wy` went 7 -> 5.
//
// The lengths cover every branch of `wyhash`: 0 and 1 and 7 (the sub-4 and
// smallKey arms), 8/9/15/16 (smallKey's four 4-byte reads), 17 and 47 (final1
// only), 48 and 100 (the 48-byte round loop and its tail).

// The same `n` bytes, placed at byte offset `off` inside a fresh allocation, so
// its address is `off` past 8-aligned. Built by prepending `off` filler bytes
// and slicing them back off: a slice is a VIEW over the same buffer.
fn alignedAt(s: string, off: int): int {
  let pad = ""
  let i = 0
  while (i < off) {
    pad = pad + "#"
    i = i + 1
  }
  return rtStringSlice(mine(pad + s), off, off + len(s))
}

// `n` bytes, distinct per length so no two subjects collide.
fn alignBody(n: int): string {
  let alphabet = "abcdefghijklmnopqrstuvwxyz0123456789"
  let out = ""
  let i = 0
  while (i < n) {
    let d = (i * 7 + n) % 36
    out = out + alphabet[d:d + 1]
    i = i + 1
  }
  return out
}

// How many of the 11 x 8 subjects hash to the same digest as their 8-aligned
// form, and — the control that keeps this from being vacuous — whether all
// eight alignments were really reached. A probe that only ever built aligned
// views would report a perfect score while testing nothing, so the observed
// `ptr & 7` is asserted to be exactly `off`.
fn phaseA(): int {
  let lens = [0, 1, 7, 8, 9, 15, 16, 17, 47, 48, 100]
  let agree = 0
  let li = 0
  while (li < len(lens)) {
    let n = lens[li]
    let s = alignBody(n)
    let want = rtWyhashString(mine(s), u64(7))
    let off = 0
    while (off < 8) {
      let view = alignedAt(s, off)
      let reached = loadWord(view + strPtr) & 7
      if (rtWyhashString(view, u64(7)) == want && reached == off) {
        agree = agree + 1
      }
      off = off + 1
    }
    li = li + 1
  }
  return agree
}
