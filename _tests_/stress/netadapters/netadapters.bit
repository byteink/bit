// Windows nameserver discovery (#7470): `netAdapterDnsServers`
// (runtime/net/adapters.bit) reads every IPv4 DNS server off a
// `GetAdaptersAddresses` result. The call itself is an `extern fn` only a
// Windows build can make, but the parse is byte arithmetic over a linked list of
// 64-bit pointers, so this program builds that list by hand, in the Windows
// layout (iptypes.h), and asserts the exact answer.
//
// Platform-free by construction, so no host marker: the layout is Windows' on
// every target, which is the point of keeping the parse out of ../../../runtime/net/windows.
//
// The chain, in the order Windows would return it:
//
//   adapter 0  UP    10.0.0.1, fe80::1 (IPv6, not asked for, still listed),
//                    10.0.0.2
//   adapter 1  DOWN  192.168.9.9      (a stale entry on a disconnected adapter)
//   adapter 2  UP    10.0.0.1 (the same resolver again, a VPN beside the LAN),
//                    8.8.8.8
//   adapter 3  UP    no DNS servers at all
//
// The answer is 10.0.0.1, 10.0.0.2, 8.8.8.8: adapter order, then each adapter's
// own order; the IPv6 entry, the down adapter's entry and the repeat dropped.
// The first two are what failover walks: a resolver whose first server is
// unreachable is asked the second after one window.

import { netAdapterDnsServers, netMaxAdapterDns, putU64Le, putU32Le, putU8, getU8 } from "../../../runtime/net"

let ad0: [16]i64
let ad1: [16]i64
let ad2: [16]i64
let ad3: [16]i64
let dn0a: [4]i64
let dn0b: [4]i64
let dn0c: [4]i64
let dn1a: [4]i64
let dn2a: [4]i64
let dn2b: [4]i64
let sa0a: [4]i64
let sa0b: [4]i64
let sa0c: [4]i64
let sa1a: [4]i64
let sa2a: [4]i64
let sa2b: [4]i64
let listBuf: [8]i64

// IF_OPER_STATUS (ifdef.h).
const operUp: int = 1
const operDown: int = 2

fn at(a: int): *u8 {
  let z: *u8 = nil
  return z + a
}

fn zero(base: *u8, n: int) {
  let i = 0
  while (i < n) {
    putU8(base, i, 0)
    i = i + 1
  }
}

// A `sockaddr_in` as Windows lays it out: `ADDRESS_FAMILY` (a u16, AF_INET 2) at
// 0, the port at 2, the four octets at 4.
fn sockAddr4(sa: *u8, a: int, b: int, c: int, d: int) {
  zero(sa, 32)
  putU32Le(sa, 0, 2)
  putU8(sa, 4, a)
  putU8(sa, 5, b)
  putU8(sa, 6, c)
  putU8(sa, 7, d)
}

// A `sockaddr_in6`: AF_INET6 is 23 on Windows. The bytes after the family are
// an address `fe80::1`, none of which the parse may read as an IPv4 address.
fn sockAddr6(sa: *u8) {
  zero(sa, 32)
  putU32Le(sa, 0, 23)
  putU8(sa, 8, 254)
  putU8(sa, 9, 128)
  putU8(sa, 23, 1)
}

// An `IP_ADAPTER_DNS_SERVER_ADDRESS`: Next at 8, the `SOCKET_ADDRESS`'s
// `lpSockaddr` at 16.
fn dnsEntry(e: *u8, next: int, sa: int) {
  zero(e, 32)
  putU64Le(e, 8, next)
  putU64Le(e, 16, sa)
}

// An `IP_ADAPTER_ADDRESSES`: Next at 8, FirstDnsServerAddress at 48, OperStatus
// at 104. Everything else the parse must ignore is left as a recognisable
// non-zero byte, so a read at the wrong offset finds garbage, not a null.
fn adapter(a: *u8, next: int, status: int, firstDns: int) {
  let i = 0
  while (i < 128) {
    putU8(a, i, 165)
    i = i + 1
  }
  putU64Le(a, 8, next)
  putU64Le(a, 48, firstDns)
  putU32Le(a, 104, status)
}

fn build() {
  sockAddr4(at(int(ptrOf(sa0a))), 10, 0, 0, 1)
  sockAddr6(at(int(ptrOf(sa0b))))
  sockAddr4(at(int(ptrOf(sa0c))), 10, 0, 0, 2)
  sockAddr4(at(int(ptrOf(sa1a))), 192, 168, 9, 9)
  sockAddr4(at(int(ptrOf(sa2a))), 10, 0, 0, 1)
  sockAddr4(at(int(ptrOf(sa2b))), 8, 8, 8, 8)
  dnsEntry(at(int(ptrOf(dn0c))), 0, int(ptrOf(sa0c)))
  dnsEntry(at(int(ptrOf(dn0b))), int(ptrOf(dn0c)), int(ptrOf(sa0b)))
  dnsEntry(at(int(ptrOf(dn0a))), int(ptrOf(dn0b)), int(ptrOf(sa0a)))
  dnsEntry(at(int(ptrOf(dn1a))), 0, int(ptrOf(sa1a)))
  dnsEntry(at(int(ptrOf(dn2b))), 0, int(ptrOf(sa2b)))
  dnsEntry(at(int(ptrOf(dn2a))), int(ptrOf(dn2b)), int(ptrOf(sa2a)))
  adapter(at(int(ptrOf(ad3))), 0, operUp, 0)
  adapter(at(int(ptrOf(ad2))), int(ptrOf(ad3)), operUp, int(ptrOf(dn2a)))
  adapter(at(int(ptrOf(ad1))), int(ptrOf(ad2)), operDown, int(ptrOf(dn1a)))
  adapter(at(int(ptrOf(ad0))), int(ptrOf(ad1)), operUp, int(ptrOf(dn0a)))
}

fn listBytes(): *u8 { return at(int(ptrOf(listBuf))) }

// Entry `i` of the list as one number, a*2^24 + b*2^16 + c*2^8 + d.
fn entry(i: int): int {
  let l = listBytes()
  return getU8(l, i * 4) * 16777216 +
    getU8(l, i * 4 + 1) * 65536 +
    getU8(l, i * 4 + 2) * 256 +
    getU8(l, i * 4 + 3)
}

const s10001: int = 167772161
const s10002: int = 167772162
const s8888: int = 134744072

fn wipe() {
  zero(listBytes(), 64)
}

fn mixedProps(): bool {
  wipe()
  let n = netAdapterDnsServers(int(ptrOf(ad0)), listBytes(), netMaxAdapterDns)
  return n == 3 && entry(0) == s10001 && entry(1) == s10002 && entry(2) == s8888
}

// A list that holds two: the third is dropped, not written past the end.
fn capProps(): bool {
  wipe()
  let n = netAdapterDnsServers(int(ptrOf(ad0)), listBytes(), 2)
  return n == 2 && entry(0) == s10001 && entry(1) == s10002 && entry(2) == 0
}

fn emptyProps(): bool {
  wipe()
  return netAdapterDnsServers(0, listBytes(), netMaxAdapterDns) == 0 &&
    netAdapterDnsServers(int(ptrOf(ad3)), listBytes(), netMaxAdapterDns) == 0
}

// A corrupt chain, an adapter whose Next is itself: the parse ends and reports
// the one resolver it has, rather than walking forever.
fn loopProps(): bool {
  wipe()
  adapter(at(int(ptrOf(ad3))), int(ptrOf(ad3)), operUp, int(ptrOf(dn2a)))
  let n = netAdapterDnsServers(int(ptrOf(ad3)), listBytes(), netMaxAdapterDns)
  return n == 2 && entry(0) == s10001 && entry(1) == s8888
}

fn main() {
  build()
  println("mixed ${mixedProps()}")
  println("cap ${capProps()}")
  println("empty ${emptyProps()}")
  println("loop ${loopProps()}")
}
