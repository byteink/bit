// A buffered channel's contents survive a collection ONLY because the GC root
// scan walks the chan registry (#1602). This is the behavioural proof for
// `runtime/chan/chanreg.bit`'s `chanScanRegistryRoots`: a buffered word holding
// a GC-allocated payload is reachable through nothing but the ring buffer while
// it sits unreceived — no stack, no register, no other object points at it — so
// if the collector does not treat the registry as a root source the payload is
// swept out from under a live channel (ABI.md §11).
//
// The test drives the Bit collector (runtime/gc, #1363) over raw memory exactly
// as _tests_/stress/gcbit does, builds a channel BY HAND in that raw memory (the
// header layout is runtime/chan/chan.bit's, mirrored in the CH_* constants
// below), fills its ring buffer with freshly `gcAlloc`'d payloads, registers it,
// and runs two collections through the RUNTIME driver `chanDriveCollection`
// (#1610) — the live root-enumeration phase that calls `chanScanRegistryRoots`
// between `gcMarkBegin` and `gcCollectFinish`, not a begin/scan/finish sequence
// hand-composed in this test. The channel registry is the only root source, so
// each collection passes no precise roots (`rootsAddr`/`n` = 0):
//
//   scan1 — the channel holds all PAYLOADS: every one must survive, none swept,
//           and each drained payload must still be owned with its marker intact.
//   scan2 — the channel is emptied first (count := 0), so the same scan now
//           reports no roots: every payload must be swept.
//
// scan2 is what makes scan1 load-bearing rather than incidental — it proves the
// buffered contents, and nothing else, were the roots. MUTATION: dropping the
// `chanScanRegistryRoots` call from `chanDriveCollection` (or neutering the
// `chanIsRef` gate) reddens scan1 to `0 6 0 0`.
//
// #4184: the claim this comment used to make -- that being "held in `main`
// for the whole program" is what "keeps them alive" -- was lexical-scope
// reasoning, and this compiler's precise stack maps are interval-based, not
// scope-based (#4097 found the gap for real in gcbit.bit: a binding whose
// last READ is behind the program counter is not a root, however long it
// stays in scope, and gcbit segfaulted under BIT_GC=stress without an
// explicit trailing read). #4184 measured this file directly: its CURRENT
// codegen keeps arena, indexArena, heapBlock, heapLock, listLock, state,
// meta and ringBuf precisely rooted through virtually this whole function
// regardless -- confirmed by dumping the compiler's own emitted __bit_gc
// stack-map entries for `main` and finding every one of those vregs'
// registers/slots present at every safepoint from definition through the
// tail. That is an accident of the current register allocator's
// conservative interval widening, not a guarantee (see
// chanmakeroots.bit's identical comment for the full measurement). `rooted`
// below, mirroring gcslotbitmap's/gcspanblocks'/gcspanfree's/
// gcspanfreelist's own `rooted` field, makes the keep-alive a CHECKED fact
// instead of a comment.

import { spinUnlocked } from "../../../runtime"
import { heapInit, heapWords } from "../../../runtime/alloc"
import {
  gcInit,
  gcConfigure,
  gcAlloc,
  gcOwns,
  gcNumObjects,
  gcStatCollections,
  gcStatTotalSwept,
  gcWords,
  gcBindMemory,
  storeWord,
  loadWord,
} from "../../../runtime/gc"
import {
  chanRegInit,
  chanRegister,
  chanDriveCollection,
  chanRegWords,
  chanWords,
  chanBufferedCount,
  chanBufferedAt,
} from "../../../runtime/chan"

// Channel header field offsets, in words — runtime/chan/chan.bit's private
// layout, hardcoded because it is module-private. A layout drift fails this test
// loudly, which is the intent.
const CH_LOCK = 0
const CH_BUF = 2
const CH_CAP = 3
const CH_HEAD = 4
const CH_COUNT = 5
const CH_ISREF = 10

const PAYLOADS = 6
const CAP = 8
const MARKER_BASE = 1000

// Collector sizing, matching gcbit's generous arenas so nothing can run out.
const ARENA_WORDS = 131072
const INDEX_WORDS = 8192
const MARK_STACK = 64
const MIN_TRIGGER = 4096
const GROWTH_PCT = 200

// Metadata: one leaf `Node` TypeInfo (16-byte body, NO pointer fields, so the
// marker word is pure data the tracer never reinterprets) plus the
// `ref_array_info` sentinel gcInit matches by address. Seven words each.
const META_WORDS = 14
const MI_NODE = 0
const MI_REFARR = 7

// #4184: whether every backing slice bound into gcBindMemory is still
// exactly the size it was allocated at -- the checked half of the
// keep-alive read, split out so main() does not carry the whole
// eight-condition chain in its own cyclomatic complexity.
fn allStillRooted(
  arena: []i64, indexArena: []i64, heapBlock: []i64, heapLock: []i32,
  state: []i64, meta: []i64, listLock: []i32, ringBuf: []i64,
): bool {
  return len(arena) == ARENA_WORDS &&
    len(indexArena) == INDEX_WORDS &&
    len(heapBlock) == heapWords &&
    len(heapLock) == 1 &&
    len(state) == gcWords &&
    len(meta) == META_WORDS &&
    len(listLock) == 1 &&
    len(ringBuf) == CAP
}

fn main() {
  let arena = []i64(ARENA_WORDS)
  let indexArena = []i64(INDEX_WORDS)
  let heapBlock = []i64(heapWords)
  let heapLock = []i32(1)
  let state = []i64(gcWords)
  let meta = []i64(META_WORDS)
  let listLock = []i32(1)
  let chanBlock = []i64(chanWords)
  let ringBuf = []i64(CAP)
  let regBlock = []i64(chanRegWords)

  let metaAddr = int(ptrOf(meta))
  // Node: leaf, 16-byte body, zero pointer offsets.
  meta[MI_NODE + 0] = 16
  meta[MI_NODE + 1] = 0
  meta[MI_NODE + 2] = 0
  let nodeInfo = metaAddr + MI_NODE * 8
  let refArrInfo = metaAddr + MI_REFARR * 8

  let hp = ptrOf(heapBlock)
  heapInit(hp)
  let hlk = ptrOf(heapLock)
  atomicStore(hlk, spinUnlocked)
  let llk = ptrOf(listLock)
  atomicStore(llk, spinUnlocked)

  let g = ptrOf(state)
  gcBindMemory(g, int(ptrOf(arena)), ARENA_WORDS * 8, int(ptrOf(indexArena)), INDEX_WORDS * 8, 4096)
  if (!gcInit(g, int(hp), int(hlk), int(llk), refArrInfo, MARK_STACK)) {
    print("gcInit failed\n")
    return
  }
  gcConfigure(g, true, false, MIN_TRIGGER, GROWTH_PCT, false)

  // Build the channel by hand in raw memory. The slice is zeroed, so the lock
  // word (CH_LOCK), the ring head and the registry link all start at 0 — a
  // zeroed spin cell is `spinUnlocked`, so no lock init is needed.
  let chPtr = ptrOf(chanBlock)
  let chAddr = int(chPtr)
  let bufAddr = int(ptrOf(ringBuf))
  storeWord(chAddr + CH_BUF * 8, bufAddr)
  storeWord(chAddr + CH_CAP * 8, CAP)
  storeWord(chAddr + CH_ISREF * 8, 1)

  // Fill the ring buffer with fresh managed payloads, each stamped with a
  // distinct marker so a swept-and-reused slot is detectable, not just a null.
  let i = 0
  while (i < PAYLOADS) {
    let p = gcAlloc(g, nodeInfo)
    if (p == 0) {
      print("alloc failed\n")
      return
    }
    storeWord(p + 0, MARKER_BASE + i)
    storeWord(bufAddr + i * 8, p)
    i = i + 1
  }
  storeWord(chAddr + CH_COUNT * 8, PAYLOADS)

  let reg = ptrOf(regBlock)
  chanRegInit(reg)
  chanRegister(reg, chPtr)

  // scan1: the registry is the sole root source. Every payload must survive.
  // Driven through the RUNTIME driver `chanDriveCollection` (#1610), not a
  // hand-composed begin/scan/finish sequence — so the registry scan is exercised
  // as the collector's live root-enumeration phase. No precise roots here (the
  // channel buffer is the only root source), so `rootsAddr`/`n` are 0.
  chanDriveCollection(g, reg, 0, 0)
  let survived1 = gcNumObjects(g)
  let swept1 = gcStatTotalSwept(g)

  // Drain through the cursors and check integrity: still owned, marker intact.
  let intact = 0
  let sum = 0
  let n = chanBufferedCount(chPtr)
  let j = 0
  while (j < n) {
    let p = chanBufferedAt(chPtr, j)
    if (gcOwns(g, p)) {
      let m = loadWord(p + 0)
      if (m == MARKER_BASE + j) {
        intact = intact + 1
        sum = sum + m
      }
    }
    j = j + 1
  }
  print("scan1 ${survived1} ${swept1} ${intact} ${sum}\n")

  // scan2: empty the channel, then the same scan reports no roots — so every
  // payload is now swept. This is what proves the buffered contents were the
  // roots keeping them alive above.
  storeWord(chAddr + CH_COUNT * 8, 0)
  chanDriveCollection(g, reg, 0, 0)
  print("scan2 ${gcNumObjects(g)} ${gcStatTotalSwept(g)}\n")

  // See main()'s own leading comment: this read is load-bearing, not
  // decorative -- it is what makes the keep-alive a checked fact.
  let rooted = 0
  if (allStillRooted(
    arena, indexArena, heapBlock, heapLock, state, meta,
    listLock, ringBuf,
  )) {
    rooted = 1
  }
  print("collections ${gcStatCollections(g)} rooted ${rooted}\n")
}
