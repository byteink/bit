// `bit_rt_fs_open_nofollow_w` (ABI.md §14, #4720) — the runtime primitive
// #4554's "O_NOFOLLOW on the final open plus fstat" ruling needs, proved
// against the three cases its contract distinguishes: a regular file opens,
// a symlink to that same regular file is REFUSED, and a directory is
// REFUSED.
//
// UNDER _tests_/stress/ AND NOT _tests_/cases/, for `./externfn`'s own two
// reasons, both of which apply verbatim here: the program declares an
// `extern fn`, and the golden corpus doubles as the seed-vs-selfhost `check`
// differential's input where an extern declaration registers as a new
// MISSING (#1374). The sibling `darwin-only` marker is likewise `externfn`'s:
// `symlink(2)` below is a libSystem import, and Bit's ELF output is fully
// static with no dynamic symbol table, so this program cannot link on Linux
// at all. The Linux and Windows providers of this primitive are proved by
// their own archive builds, not here.
//
// THIS DECLARES THE PRIMITIVE ITSELF, which `stdlib/fs` deliberately does
// NOT (#4720 is pass 1 of the #3065 two-pass shape): `./make` builds
// `tools/build` with the PINNED stage0 linking stage0's own frozen
// `libbitrt.a`, and `tools/build` imports `std/fs`, so an extern for a
// symbol absent from that archive is E0078 and breaks the cold bootstrap. A
// test program is not on that path — it links THIS tree's freshly built
// `libbitrt.a` — so it can name the symbol a year before `std/fs` can.
//
// `std/fs`'s own `open` is the CONTROL, not decoration: it follows symlinks, so
// its success on the very same link path is what makes the primitive's -1 a
// refusal of the LINK rather than a report of a broken or missing path.

import { envOr } from "std/os"
import { mkdir, writeFile, remove, open } from "std/fs"

extern fn getpid(): i32
extern fn symlink(target: *u8, linkpath: *u8): i32
extern fn bit_rt_fs_open_nofollow_w(words: *byte, n: int): i64
extern fn bit_rt_fs_close(fd: i64): i64

// `path`'s bytes plus a trailing NUL, for a C `extern` that wants a
// `char *`. A Bit `string` carries an explicit length and is not documented
// as NUL-terminated (SPEC §11.7 admits no `string` across a plain `extern
// fn` at all), so the terminator is added here rather than assumed.
//
// BOUNDED: `len(path)` iterations.
fn cstr(path: string): []u8 {
  let n = len(path)
  let b = []u8(n + 1)
  let i = 0
  while (i < n) {
    b[i] = path[i]
    i = i + 1
  }
  b[n] = 0
  return b
}

// `path`'s bytes with NO terminator — the packed-bytes `(words, n)` shape
// every `bit_rt_fs_*_w` symbol takes (ABI.md §14), the same encoding
// `stdlib/fs`'s own `pathWords` builds for `bit_rt_fs_sync_dir_w`.
//
// BOUNDED: `len(path)` iterations.
fn pathWords(path: string): []byte {
  let n = len(path)
  let w = []byte(n)
  let i = 0
  while (i < n) {
    w[i] = path[i]
    i = i + 1
  }
  return w
}

// The primitive under test: "ok" when it hands back a usable fd (closed
// again immediately), "refused" when it returns -1. A negative other than -1
// would be a contract break, so it is reported distinctly rather than
// folded into "refused".
fn nofollow(path: string): string {
  let w = pathWords(path)
  let fd = bit_rt_fs_open_nofollow_w(ptrOf(w), len(path))
  if (fd >= 0) {
    let _ = bit_rt_fs_close(fd)
    return "ok"
  }
  if (fd == -1) {
    return "refused"
  }
  return "bad(${fd})"
}

// `std/fs`'s ordinary read-only open (`bit_rt_fs_open`, reached through the
// compiler's own builtin call form rather than a plain `extern fn` — that
// primitive takes a Bit `string`, which SPEC §11.7 does not admit across an
// `extern` boundary, which is the whole reason the new symbol is `_w`-shaped).
// It FOLLOWS a symlink — the control.
fn follow(path: string): string {
  let f = open(path) catch _ {
    return "refused"
  }
  f.close()
  return "ok"
}

fn main() {
  let dir = "${envOr("TMPDIR", "/tmp")}/bit-fsnofollow-${int(getpid())}"
  let file = "${dir}/regular"
  let link = "${dir}/link"
  mkdir(dir) catch e {
    print("setup failed: ${e.message()}\n")
    return
  }
  writeFile(file, "contents\n") catch e {
    print("setup failed: ${e.message()}\n")
    return
  }
  let target = cstr(file)
  let linkPath = cstr(link)
  let rc = symlink(ptrOf(target), ptrOf(linkPath))
  if (rc != i32(0)) {
    print("setup failed: symlink rc=${int(rc)}\n")
    return
  }

  print("file=${nofollow(file)}")
  print(" link-follows=${follow(link)}")
  print(" link=${nofollow(link)}")
  print(" dir=${nofollow(dir)}\n")

  remove(link) catch e {
    print("cleanup: ${e.message()}\n")
  }
  remove(file) catch e {
    print("cleanup: ${e.message()}\n")
  }
  remove(dir) catch e {
    print("cleanup: ${e.message()}\n")
  }
}
