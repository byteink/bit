// Deep recursion within one goroutine's fixed stack (#1761). `bit fmt --check`
// segfaulted on x86_64, but not aarch64, for ordinary source files: every Bit
// program's `main` runs as the runtime scheduler's first task (`runtime/root/`'s
// `boot`), so the self-hosted compiler's own recursive-descent formatter
// walked each file's AST on that goroutine's fixed, guard-paged stack.
// Confirmed on real x86_64 hardware via gdb: the fault address landed exactly
// inside the mapped guard page at a `call`'s return-address push — a stack
// overflow, not a codegen miscompile. x86-64 frames for the same recursion run
// bigger than AArch64's, so a budget that held on arm64 didn't on x64.
//
// This program isolates the budget itself, independent of the formatter: each
// call pins a fixed-size value-typed local array live across the recursive
// call, so per-frame stack usage is an explicit, portable byte count instead
// of an artifact of register allocation. Every array slot is written and read
// through a runtime-computed (not compile-time-constant) index so the
// compiler cannot narrow the live range down to the one slot an earlier,
// simpler version of this program touched — measured on real x86_64 hardware
// on x86-64: a build that only read/wrote `pad[0]` needed DEPTH in the
// thousands to overflow 64 KiB, because everything past that one slot was
// dead and cost nothing. Touching all 64 slots moved the measured 64 KiB
// crash threshold down to ~410; DEPTH=1000 clears it with margin and stays
// well inside 256 KiB.
//
// The result is a checksum, so a stack-corrupting overflow that survives far
// enough to print something is still caught as a wrong answer, not just a
// non-crash.

const DEPTH = 1000
const WIDTH = 64

fn descend(n: int): int {
  let pad: [64]i64
  let i = 0
  while (i < WIDTH) {
    pad[i] = n + i
    i = i + 1
  }
  if (n <= 0) {
    let total = 0
    let j = 0
    while (j < WIDTH) {
      total = total + pad[j]
      j = j + 1
    }
    return total
  }
  let deeper = descend(n - 1)
  let total = 0
  let k = 0
  while (k < WIDTH) {
    total = total + pad[k]
    k = k + 1
  }
  return deeper + total
}

fn main() {
  let result = descend(DEPTH)
  print("${result}\n")
}
