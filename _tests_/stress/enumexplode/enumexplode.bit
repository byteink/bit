// #5313: `Res` is #5312's conservative-union case — `Ok(i64)` non-ref,
// `Err(string)` ref, same shared payload word — crossing TWO function
// boundaries (`mk`'s return, `eval`'s parameter) with an allocating call
// (`junk`) between construction and the `match` that reads the payload back,
// so a lost precise root would be freed at exactly the point that matters.
// `BIT_GC_NO_CONSERVATIVE_SCAN=1` (runtime/stw/stwscan.bit's
// stwSetNoConservativeScan, landed as #4255) turns a lost root into an
// observable wrong answer instead of a silently rescued one, mirroring
// `_tests_/stress/precisemask/precisemask.bit`'s own pattern.
//
// Built and run by hand (never through this repo's stress harness, which
// does not set the env var): `bit build enumexplode.bit -o <out> && BIT_GC=stress
// BIT_GC_NO_CONSERVATIVE_SCAN=1 <out>` printed `mismatches=0` over 20000
// iterations, 20119 forced collections (`BIT_GC_STATS=1`).
//
// THE MUTATION THIS DID NOT CATCH, reported rather than hidden: inverting
// #5312's `enumPayloadWordIsRef` (lowerlayout.bit) to always answer `false`
// makes `test-selfcheck` panic deterministically ("Option<string>'s payload
// word must be traced", `checkExplodedEnumWordTypes`, ircheck.bit) — this
// probe still printed `mismatches=0` under the same mutant, 20000 iterations,
// stress mode, no-conservative-scan. The allocator did not happen to reuse
// the freed slot before the read landed in this run; `test-selfcheck` is the
// deterministic proof, this file is the runtime-load corroboration, not a
// substitute for it.
import { env } from "std/os"
import { stwSetNoConservativeScan } from "../../../runtime/stw"

enum Res {
  Ok(i64),
  Err(string),
}

// #5340: `Res` above is now REFUSED explosion — two variants carrying
// different payload types have no single type the shared word can take
// (`enumCommonPayloadType`, compiler/lowerexplode.bit), so it is back on the
// boxed path and this file would no longer stress an exploded word at all.
// `Str` is the shape that IS exploded and the one most exposed by #5340: a
// single payload type that is a GC REFERENCE, whose word a match arm now
// binds DIRECTLY (`bindArmPayloadDirect`, compiler/lowerbranch.bit) with no
// box and no load in between. Under `BIT_GC_NO_CONSERVATIVE_SCAN=1` a word
// the stack map failed to trace is freed and the compare below reads freed
// bytes.
enum Str {
  Some(string),
  None,
}

const ITERS = 20000

fn mk(i: i64): Res {
  if (i % 3 == 0) {
    return Res.Err("e${i}")
  }
  return Res.Ok(i * 2)
}

fn eval(r: Res, i: i64): i64 {
  // churn: an allocating call between construction and the match, so a lost
  // root would be swept before the payload is read back.
  let junk = []i64(4)
  junk[0] = i
  match (r) {
    Ok(v) => {
      if (v != i * 2) {
        return -999
      }
      return 0
    }
    Err(s) => {
      if (s != "e${i}") {
        return -998
      }
      return 0
    }
  }
}

fn mkStr(i: i64): Str {
  if (i % 4 == 0) {
    return Str.None
  }
  return Str.Some("s${i}")
}

fn evalStr(o: Str, i: i64): i64 {
  let junk = []i64(4)
  junk[0] = i
  match (o) {
    Some(s) => {
      if (s != "s${i}") {
        return -997
      }
      return 0
    }
    None => {
      if (i % 4 != 0) {
        return -996
      }
      return 0
    }
  }
}

fn main() {
  if (env("BIT_GC_NO_CONSERVATIVE_SCAN") == "1") {
    stwSetNoConservativeScan(true)
  }
  let i = 0
  let mismatches = 0
  while (i < ITERS) {
    let r = mk(i)
    let rc = eval(r, i)
    if (rc != 0) {
      mismatches = mismatches + 1
    }
    // #5340: the subject is the CALL, the shape `matchSubjectWords` could not
    // see and the one bench/cases/json is built from.
    if (evalStr(mkStr(i), i) != 0) {
      mismatches = mismatches + 1
    }
    i = i + 1
  }
  print("mismatches=${mismatches}\n")
}
