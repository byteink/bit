// #6429: a channel timer must fire on time while worker 0 is held busy.
//
// Until the poller role became a token any idle worker can take, only worker 0
// polled timers. Hold it in a CPU loop and a 2ms timer armed by a task on
// another worker waited for a parked peer's `idleParkMaxNs` backstop (100ms,
// `runtime/sched/sleep.bit`): the timer fired 90-100ms late with every other
// worker idle. With the token, the idle worker that ran the arming task takes
// it, blocks in the poller until the deadline and fires the timer itself.
//
// `main` runs on worker 0 and spins on an atomic until the timer task is done,
// so worker 0 never reaches its idle path for the whole run. The timer task is
// spawned, which publishes it for the other workers to take (pinned to
// BIT_WORKERS=4 by the sibling `workers` file). The verdict is the shared
// judge's (`../../bit/timerctl/timerctl.bit`): worst overshoot beyond what the
// OS demonstrably did, against a 50ms budget (ten times that under
// BIT_GC=stress), and no missed wake. The deterministic signal is the missed
// wake count; the wall budget only has to separate the ~100ms backstop shape
// from noise, because a fixed 5ms bound fires under the push gate's load. The
// diag line prints the excess whatever the budget, and the 512-run harness
// beside CPU hogs (x86_64-linux) is what proves it stays under 5ms.

import { after, monotonic, since, Millisecond } from "std/time"
import { newAtomicI64, AtomicI64 } from "std/sync"
import { newProbe, budgetFor, Probe } from "../../bit/timerctl"

const iters: int = 200
const tickNs: int = 2 * Millisecond
const overshootBudgetNs: int = 50 * Millisecond

// Bounds the spin (Power of 10): far more iterations than the run needs, so a
// stalled timer ends the loop with a verdict instead of hanging the gate.
const spinBudget: int = 2000000000

class Run {
  probe: Probe,
  done: AtomicI64,
}

fn timerTask(r: Run) {
  let i = 0
  while (i < iters) {
    let start = monotonic()
    let c = after(tickNs)
    let _ = <- c
    r.probe.sample(start.ns, since(start) - tickNs)
    i = i + 1
  }
  r.done.store(1)
}

fn main() {
  let r = Run{ probe = newProbe(tickNs), done = newAtomicI64(0) }
  spawn timerTask(r)
  let spins = 0
  while (r.done.load() == 0 && spins < spinBudget) {
    spins = spins + 1
  }
  let ok = r.probe.ok(budgetFor(overshootBudgetNs)) && r.done.load() == 1
  let diag = r.probe.report("chantimerbusyworker0", budgetFor(overshootBudgetNs))
  eprint("${diag}\n")
  if (ok) {
    print("chantimerbusyworker0 true\n")
    return
  }
  r.probe.dumpTrace()
  print("chantimerbusyworker0 false\n${diag}\n")
}
