// Function attributes `@naked` and `@nosplit` (SPEC §10.3.1, #1359/#1360) —
// the two Stage-2 attributes the unmanaged runtime subset needs.
//
// These live under _tests_/stress/ rather than _tests_/cases/ deliberately: the
// golden corpus doubles as the seed-vs-selfhost `check` differential's input,
// and selfhost's validator does not diagnose attributes yet (#1374), so an
// attribute case there would register as a new MISSING in
// scripts/selfhost-diffcheck.sh. The rejection rules are unit-tested in
// the deleted seed compiler's `check` module; this program covers what only a real binary can show.
//
// Three properties, all deterministic:
//
//   (a) @naked returns the right value through a raw `ret`. `two` is exported so
//       dead-code elimination keeps it in the module: codegen therefore runs on
//       a function with is_naked set, exercising the suppressed prologue, the
//       suppressed epilogue teardown, and the post-regalloc "no frame" assertion.
//       A broken naked path fails the build, not just the comparison.
//
//   (b) @nosplit compiles and computes correctly with NO back-edge safepoint.
//       `spin` carries a loop, so without the attribute codegen would plant a
//       `bit_rt_safepoint` call on the back-edge; with it, the loop is bare.
//       The function is far past the inliner's size threshold, so it survives to
//       codegen and into the linked binary as a real call.
//
//   (c) a @nosplit chain — a nosplit function calling another nosplit function —
//       links and runs. Transitive safety is enforced one hop at a time, and the
//       attributes are collected before any body is checked, so the callee's
//       attribute is visible regardless of declaration order.
//
// Bit has fixed 64KB guarded green-thread stacks, so there is no stack-growth
// check for @nosplit to remove — only the safepoint poll.
//
// spin(1000) = sum 0..999 = 999 * 1000 / 2 = 499500.
// chain(7) = doubled(7) + 1 = 15.

export @naked fn two(): int {
  return 2
}

@nosplit fn doubled(x: int): int {
  return x + x
}

// Calls only `doubled`, which is itself @nosplit — the one-hop rule composes
// into a whole-chain guarantee by induction.
@nosplit fn chain(x: int): int {
  return doubled(x) + 1
}

// An allocation-free counting loop: the back-edge takes no safepoint poll.
@nosplit fn spin(n: int): int {
  let s = 0
  let i = 0
  while (i < n) {
    s = s + i
    i = i + 1
  }
  return s
}

fn main() {
  print("${two()} ${spin(1000)} ${chain(7)}\n")
}
