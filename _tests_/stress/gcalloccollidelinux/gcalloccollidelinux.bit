// #7139's alloc-cache home-collision proof, Linux binding. The property, and
// why it discriminates, live in `../thread/alloccollide`. This file supplies
// only the platform thread provider, as `../gcallocmigratelinux` does, and is
// Linux-only for that file's reason: the provider issues raw `syscall`s.
import { collideRun } from "../thread/alloccollide"
import { threadStart, threadRelease } from "../../../runtime/thread/linux"
import { parkSleepNs, parkMonoNs } from "../../../runtime/park/linux"

// Adapts `parkSleepNs`/`parkMonoNs` to `collideRun`'s shapes with this thread's
// own scratch, as `../gcallocmigratelinux` does.
let sleepScratch: [2]i64

fn sleepAdapt(ns: int) {
  parkSleepNs(ns, ptrOf(sleepScratch))
}

fn monoAdapt(): int {
  return parkMonoNs(ptrOf(sleepScratch))
}

fn main() {
  let r = collideRun(threadStart, threadRelease, sleepAdapt, monoAdapt)
  print("gcalloccollide started=${r.started} joined=${r.joined} released=${r.released} rival=${r.rival} first=${r.first} steady=${r.steady}\n")
}
