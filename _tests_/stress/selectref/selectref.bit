// Select over channels of *reference* values: two producers each send 300 heap
// `Box`es onto separate unbuffered channels while main multiplexes them with
// select, 600 receives total. Because `Box` is wider than a word it is boxed, so
// each channel carries a GC reference and the value select delivers lands in the
// case descriptor's `word` slot as a live reference. That slot lives only in the
// `bit_rt_select_alloc`'d buffer until main loads it, so under BIT_GC=stress —
// which collects at every safepoint — the descriptor buffer MUST be traced or
// the just-received `Box` is swept before `x.v` reads it (regression guard for
// the leaf-buffer select bug the quicconn KAT hit on x86_64).
// sum(0..299) + sum(10000..10299) = 44850 + 3044850 = 3089700.
class Box {
  v: i64,
  tag: []byte,
}

fn producer(ch: chan<Box>, base: i64) {
  let i = 0
  while (i < 300) {
    ch <- Box{ v: base + i, tag: []byte(4) }
    i = i + 1
  }
}

fn main() {
  let a = chan<Box>(0)
  let b = chan<Box>(0)
  spawn producer(a, 0)
  spawn producer(b, 10000)
  let sum = 0
  let got = 0
  while (got < 600) {
    select {
      case x = <- a:
        sum = sum + x.v
      case y = <- b:
        sum = sum + y.v
    }
    got = got + 1
  }
  print("${sum}\n")
}
