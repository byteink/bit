// #6008: the preemption monitor parks while no task is in flight, and the
// dispatch that ends the idle stretch wakes it. Two halves, each the only
// thing that fails under its own mutation:
//
//   1. IDLE. Across a 200ms sleep the sysmon epoch may move only the tick or
//      two it takes to notice the idle stretch, and the monitor must have
//      parked. At a fixed 2ms period it moved ~93 ticks here, so a monitor
//      that goes back to ticking while idle fails this half.
//   2. WAKE. From that parked state, `../schedpreempt`'s proof: on
//      `BIT_WORKERS=1` a compute-bound task must still be preempted so a peer
//      makes progress while it runs. `preemptStamp`'s wake is the only thing
//      that restarts the ticks; with it removed the monitor stays parked,
//      nothing is ever flagged, and the peer starves.
//
// The real clock is a backstop here, not the discriminator: a slower host
// moves FEWER ticks during the sleep, and the wake half is bounded by the
// same 5s budget `../schedpreempt` uses, against a ~12ms preempt.
//
// Task A's loop is pure integer arithmetic for `../schedpreempt`'s reason:
// any allocation, channel op, sleep or print in it is a voluntary yield that
// would let B run without the mechanism under test. `aIters` is half of that
// program's: B's ten rounds need ten ~12ms preempts of A, about 120ms of A's
// time against ~1s of A's whole run on an M-series core, and a loaded host
// only lengthens A's run, since its slices are wall time. The process waits
// for every task, so B stops at `requiredRounds` and A bounds the run.

import { monotonic, since, sleep, Millisecond, Second } from "std/time"
import { preemptTickNow, sysmonParkCount } from "../../../runtime/sched"

const aIters: int = 4000000000
const requiredRounds: int = 10
const waitBudgetNs: int = 5 * Second
const mainMaxPolls: int = 100000000
const idleTickCeiling: int = 10

let bRounds: int = 0
let aDone: bool = false

fn spinTask(n: int) {
  let i = 0
  while (i < n) {
    i = i + 1
  }
  aDone = true
}

fn peerTask() {
  let r = 0
  while (r < requiredRounds) {
    r = r + 1
    bRounds = r
    sleep(0)
  }
}

// Half 1. Returns "" when the monitor stayed parked through the sleep.
fn idleCheck(): string {
  sleep(20 * Millisecond)
  let e0 = preemptTickNow()
  let p0 = sysmonParkCount()
  sleep(200 * Millisecond)
  let ticks = preemptTickNow() - e0
  let parks = sysmonParkCount() - p0
  if (ticks > idleTickCeiling || parks < 1) {
    return "idle monitor ticked ${ticks} times and parked ${parks} times in 200ms"
  }
  return ""
}

// Half 2. True once B made `requiredRounds` while A was still spinning.
fn peerProgressed(): bool {
  spawn spinTask(aIters)
  spawn peerTask()
  let start = monotonic()
  let p = 0
  while (p < mainMaxPolls) {
    if (bRounds >= requiredRounds && !aDone) {
      return true
    }
    if (since(start) >= waitBudgetNs) {
      return false
    }
    sleep(0)
    p = p + 1
  }
  return false
}

fn main() {
  let idle = idleCheck()
  if (idle != "") {
    print("schedpreemptidle: ${idle}\n")
    osExit(1)
  }
  if (!peerProgressed()) {
    print("schedpreemptidle: peer starved after an idle park, rounds=${bRounds}\n")
    osExit(1)
  }
  print("schedpreemptidle: ok\n")
}
