// #5934: `netAwaitReady` must report the wake when `netClose` lands between
// this op's `netFdAcquire` and its `pdWait` claim. Both platforms, no host
// marker: `Conn.fd` is not exported, so this reaches the fd protocol through
// the same externs `std/net`'s own dial path and `runtime/net/*/sock.bit`
// use, in the order a real blocking op takes them.
//
// 1. Listen and hold a connection open so the fd this program dials never
//    sees a real peer-driven close.
// 2. Dial, then acquire a ref under the connection's OWN generation -- the
//    same cache every retry loop in `runtime/net/*/tcp.bit` keeps across its
//    syscalls (#5886).
// 3. Close the fd while this program still holds that ref: `netClose` marks
//    it closing and bumps the generation, but the real `close(2)` is
//    deferred until the ref above releases.
// 4. `netAwaitReady` on the cached (now stale) generation must answer true --
//    the close IS the wake -- not false, which is what left every caller's
//    retry loop spinning on EAGAIN up to `netMaxSpins` times before this fix.
import { listen, Listener } from "std/net"
import { monotonic, Millisecond } from "std/time"

extern fn bit_rt_net_dial_deadline_w(host: *byte, hostLen: int, port: int, deadlineNs: i64): i64
extern fn bit_rt_net_close_w(fd: i64)
extern fn bit_rt_port_sched_polldesc_gen(fd: int): int
extern fn bit_rt_port_sched_polldesc_fd_acquire(fd: int, gen: int): int
extern fn bit_rt_port_sched_polldesc_fd_release(fd: int): bool
extern fn bit_rt_port_sched_polldesc_fd_closing(fd: int): bool
extern fn bit_rt_port_net_await_ready(fd: int, interest: int, gen: int): bool

fn hold(l: Listener) {
  let c = l.accept() catch _ {
    return
  }
  let _ = c
}

fn main() {
  let l = listen("127.0.0.1", 0) catch _ {
    return
  }
  let port = l.port() catch _ {
    return
  }
  spawn hold(l)

  let host = "127.0.0.1"
  let hostBytes = []byte(len(host))
  let i = 0
  while (i < len(host)) {
    hostBytes[i] = host[i]
    i = i + 1
  }
  let deadline = i64(monotonic().ns + 2000 * Millisecond)
  let fd = int(bit_rt_net_dial_deadline_w(ptrOf(hostBytes), len(host), port, deadline))
  if (fd < 0) {
    return
  }

  let gen = bit_rt_port_sched_polldesc_gen(fd)
  let acquired = bit_rt_port_sched_polldesc_fd_acquire(fd, gen)
  if (acquired != 0) {
    return
  }
  bit_rt_net_close_w(i64(fd))

  print(
      "awaitReady=${bit_rt_port_net_await_ready(fd, 0, gen)} " +
      "closing=${bit_rt_port_sched_polldesc_fd_closing(fd)}\n",
  )
  let _ = bit_rt_port_sched_polldesc_fd_release(fd)
  l.close()
}
