// #5470: the spawn-argument thunk's ONE root while its task is queued is
// `runtime/stw`'s root class 5 — `stwScanTasks`'s
// `gcMarkConservative(g, *(t + taskArg))` (stwscan.bit) — and nothing else.
//
// WHAT #5470 ASKED. `compiler/lowerfuncval.bit`'s `lowerSpawn` packs every
// `spawn f(args)` into a `gc_alloc`'d thunk; `runtime/sched/task.bit`'s
// `schedSpawnTrampoline` reads it back out of the task block as a plain `int`
// and carries it across `taskInvoke`'s opaque `blr`/`call` into the task body
// (`runtime/sched/windows/spawn.bit`'s `winSpawnTrampoline` is the same shape).
// An `int` is not a reference-typed slot, so the precise stack-map walk
// (`../../runtime/gc/stackmap.bit`) names neither trampoline's `arg`. The
// question was whether a collection can therefore sweep the thunk under a live
// reference. This program is the answer: it cannot, because class 5 roots that
// word for the whole life of the registered task — but the guarantee rests
// entirely on that one line, and nothing exercised it through a REAL `spawn`
// before this file. `../stwcollect`'s phase A covers class 5 with a hand-built
// fake task and a private collector; `../spawnfireforget` and `../spawnjoin`
// spawn only argument-less bodies, whose thunk carries no reference at all.
//
// THE SHAPE, and why each part is load-bearing:
//
//   - each task is spawned with TWO heap references packed in its thunk (a
//     `Payload` instance and an interpolated `string`), so a swept-and-recycled
//     thunk hands the trampoline two words that are no longer those objects;
//   - `launch()` spawns and RETURNS, so the producing frame is POPPED before
//     the churn starts (the masking `_tests_/bit/gcdecimalstress.bit`'s header
//     describes: a value still sitting in a live frame is found by the
//     conservative scan by accident, and the bug hides);
//   - `workers` pins `BIT_WORKERS=1`, so the spawned tasks stay QUEUED — not
//     yet unpacked — across `main`'s whole churn loop, which is the window
//     where `taskArg` is the thunk's only reference;
//   - the worker validates both references after it is finally scheduled.
//
// MEASURED ON 48f35fb0 (2026-09-17, aarch64-macos), `BIT_GC=stress`,
// `BIT_WORKERS=1`: 201206 collections, 601927 objects swept, `bad=0/320`.
//
// MUTATION-PROVEN, both directions:
//   - delete `gcMarkConservative(g, *(t + taskArg))` from `stwScanTasks`
//     (runtime/stw/stwscan.bit) and rebuild: this program segfaults 3/3 runs
//     (`bit: fatal signal: segmentation fault`, rc=2). `../stwcollect` phase A
//     reddens with it (`arg=false`), which is the private-collector half of the
//     same claim; this file is the end-to-end half through a real `spawn`.
//   - set `stwNoConservativeScan = true` (same file) with class 5 INTACT, so
//     the conservative stack scan cannot mask anything: `bad=0/320` 3/3. The
//     thunk therefore survives on class 5 alone, not on conservative luck.
class Payload {
  magic: i64,
  id: i64,
}

const MAGIC: i64 = 5470001
const TRIALS: i64 = 40
const TASKS: i64 = 8
const CHURN: i64 = 5000

// Validates both references the thunk carried. A recycled thunk, or a swept
// `Payload`/`string`, shows up as a wrong magic, a wrong id or a wrong tag —
// and a thunk whose words are no longer object addresses at all faults here.
fn worker(p: Payload, s: string, id: i64, done: chan<i64>) {
  let ok: i64 = 1
  if (p.magic != MAGIC) {
    ok = 0
  }
  if (p.id != id) {
    ok = 0
  }
  if (s != "tag-${id}") {
    ok = 0
  }
  done <- ok
}

// Spawns and RETURNS: this frame is popped before any churn runs, so nothing
// on `main`'s stack names the thunks it just allocated.
fn launch(done: chan<i64>, base: i64) {
  let t: i64 = 0
  while (t < TASKS) {
    let id = base + t
    spawn worker(Payload{ magic = MAGIC, id = id }, "tag-${id}", id, done)
    t = t + 1
  }
}

// Allocates the same two size classes the thunks and their payloads use, so a
// swept thunk is reused rather than merely freed.
fn churn(n: i64): i64 {
  let acc: i64 = 0
  let i: i64 = 0
  while (i < n) {
    let junk = Payload{ magic = i, id = i }
    let s = "tag-${i}"
    acc = acc + junk.magic + i64(len(s))
    i = i + 1
  }
  return acc
}

// 40 SMALL trials, not one large one: `_tests_/bit/gcdecimalstress.bit`'s
// header records the measurement behind that choice (one giant churn killed
// 1 of 13 process runs; 40 independent windows killed 40/40).
fn main() {
  let done = chan<i64>(32)
  let bad: i64 = 0
  let seen: i64 = 0
  let k: i64 = 0
  while (k < TRIALS) {
    launch(done, k * 100)
    let acc = churn(CHURN)
    if (acc < 0) {
      print("churn underflowed\n")
    }
    let r: i64 = 0
    while (r < TASKS) {
      if (<- done == 0) {
        bad = bad + 1
      }
      seen = seen + 1
      r = r + 1
    }
    k = k + 1
  }
  print("bad=${bad}/${seen}\n")
}
