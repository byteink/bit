// #6480: startup initializers run on the main task with the scheduler and the
// collector up, so an initializer may allocate and the collector may run in the
// middle of one. `churn` keeps 2000 strings live through one root, the slice
// header, across a safepoint per loop iteration (every one of them a collection
// under BIT_GC=stress) and compares CONTENT, so a swept string is a wrong
// answer. It runs three times: as a `let` initializer, as a `const` initializer
// and from `main`, which must agree.
fn churn(): int {
  let xs = []string(0)
  let i = 0
  while (i < 2000) {
    xs = append(xs, "e${i}")
    i = i + 1
  }
  let bytes = 0
  let j = 0
  while (j < len(xs)) {
    if (xs[j] != "e${j}") {
      return -1
    }
    bytes = bytes + len(xs[j])
    j = j + 1
  }
  return bytes
}

let total: int = churn()
const again: int = churn() + 1

fn main() {
  println("${total} ${again} ${churn()}")
}
