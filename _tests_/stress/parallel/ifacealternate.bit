// #5965: two receiver types alternating at ONE `call_iface` site, from
// STRESS_WORKERS green threads at once, under BIT_GC=stress.
//
// Every site carries an inline cache cell `{info, fn}` (runtime/ABI.md §2.1)
// that the first miss binds. Here every worker races that first bind with the
// other type half the time, and then keeps presenting both types to the same
// site, so a cell that ever paired one type's `info` with the other type's
// `fn`, or a hit test that skipped the `info` compare, calls the wrong method.
// The two methods return values of different parity, so each call is checked
// on its own rather than through a sum two wrong calls could cancel in.

import { envOr, exit } from "std/os"
import { parseInt } from "std/strings"
import { WaitGroup } from "std/sync"

const rounds: int = 20000

interface Tagged {
  tag(): int,
}

class Odd {
  v: int
  tag(): int {
    return this.v * 2 + 1
  }
}

class Even {
  v: int
  tag(): int {
    return this.v * 2
  }
}

// STRESS_WORKERS, defaulting to 8 when unset, empty, non-numeric, or < 1.
fn workerCount(): int {
  let raw = envOr("STRESS_WORKERS", "8")
  let w = parseInt(raw) catch e {
    return 8
  }
  if (w < 1) {
    return 8
  }
  return w
}

// The one shared dispatch site every worker drives.
fn tagOf(t: Tagged): int {
  return t.tag()
}

// A fresh receiver per round, of the type `(i + seed)`'s parity picks, so
// workers with different seeds present different types to the site at once.
fn receiver(i: int, seed: int): Tagged {
  if ((i + seed) % 2 == 0) {
    return Even{ v = i }
  }
  return Odd{ v = i }
}

fn worker(seed: int, bad: chan<int>, wg: WaitGroup) {
  let wrong = 0
  let i = 0
  while (i < rounds) {
    let want = i * 2 + (i + seed) % 2
    if (tagOf(receiver(i, seed)) != want) {
      wrong = wrong + 1
    }
    i = i + 1
  }
  bad <- wrong
  wg.done()
}

fn main() {
  let w = workerCount()
  let bad = chan<int>(w)
  let wg = WaitGroup()
  wg.add(w)
  let k = 0
  while (k < w) {
    spawn worker(k, bad, wg)
    k = k + 1
  }
  wg.wait()
  let wrong = 0
  let got = 0
  while (got < w) {
    wrong = wrong + <- bad
    got = got + 1
  }
  if (wrong != 0) {
    print("ifacealternate FAIL wrong=${wrong}\n")
    exit(1)
  }
  print("ifacealternate OK\n")
}
