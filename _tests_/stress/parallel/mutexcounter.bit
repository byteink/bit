// _tests_/stress/parallel/mutexcounter.bit — #2533 (epic #1253): one shared
// counter incremented by STRESS_WORKERS green threads through std/sync's
// Mutex, no atomics anywhere in the critical section. Every increment is
// lock / read-modify-write / unlock, so a correct mutex makes the final
// count exactly W*50000 regardless of how the scheduler interleaves the
// workers (BIT_MAXPROCS=1 or >1, #1900/#1902) — a single lost update, from a
// missing lock or a wrong critical section boundary, moves the count away
// from that exact value and nothing else can paper over it.
//
// `Counter` needs no []i64/atomic backing cell: structs are reference types
// (SPEC §13.3), so passing `c` into each spawned worker shares the one
// instance and a plain `c.n = c.n + 1` under the lock mutates it for real.
//
// Run standalone via `bit run _tests_/stress/parallel/mutexcounter.bit`. This
// directory holds independent single-file programs for #1253's parallel
// family (each its own root module, not pulled together — #2538 runs each
// file directly), not the legacy _tests_/stress/* corpus that
// _tests_/bit/stress/stress.bit walks one-directory-per-program; see #2538,
// #2539 and #3397 for that scan's own exclusion of this directory.

import { Mutex, newMutex, newWaitGroup, WaitGroup } from "std/sync"
import { env, exit } from "std/os"
import { parseInt } from "std/strings"

const itersPerWorker: int = 50000
const defaultWorkers: int = 8

class Counter { mu: Mutex, n: int }

// STRESS_WORKERS from the environment, or defaultWorkers when unset, empty,
// or not a positive integer.
fn envWorkers(): int {
  let v = env("STRESS_WORKERS")
  if (len(v) == 0) {
    return defaultWorkers
  }
  let n = parseInt(v) catch _ {
    defaultWorkers
  }
  if (n <= 0) {
    return defaultWorkers
  }
  return n
}

fn worker(c: Counter, wg: WaitGroup) {
  let i = 0
  while (i < itersPerWorker) {
    c.mu.lock()
    c.n = c.n + 1
    c.mu.unlock()
    i = i + 1
  }
  wg.done()
}

fn main() {
  let w = envWorkers()
  let c = Counter{ mu: newMutex(), n: 0 }
  let wg = newWaitGroup()
  wg.add(i64(w))

  let i = 0
  while (i < w) {
    spawn worker(c, wg)
    i = i + 1
  }
  wg.wait()

  let want = w * itersPerWorker
  if (c.n == want) {
    print("mutexcounter OK\n")
    exit(0)
  }
  print("mutexcounter FAIL want=${want} got=${c.n}\n")
  exit(1)
}
