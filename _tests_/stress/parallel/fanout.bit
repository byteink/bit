// WaitGroup fan-out / fan-in over N green threads (#2534, epic #1253).
//
// Builds a 100000-element work list, splits it into STRESS_WORKERS equal(-ish)
// chunks, spawns one worker per chunk to sum its slice and send the partial sum
// on a result channel, then uses a WaitGroup (stdlib/sync/waitgroup.bit — found
// via `grep -rn "WaitGroup" stdlib/`, so no substitution is needed) to know every
// worker has finished before fanning the partial sums back in.
//
// THE VERDICT IS A RECONCILING CHECKSUM, NOT A HANG DETECTOR. The reference sum
// of 0..99999 (100000*99999/2 = 4999950000) only comes out right if every worker
// ran over its own chunk exactly once with no overlap and no gap — a lost
// worker, a double-counted chunk, or a miscomputed chunk boundary all move the
// total away from the fixed reference value. sum(0) + 2*sum(chunk_i) or a
// dropped chunk are both silently wrong sums, not hangs, which is what a mere
// "W sends arrived" check would miss.
//
// CHANNEL IS BUFFERED TO CAPACITY W, DELIBERATELY: each worker sends its result
// BEFORE calling wg.done() (the natural "compute, publish, join" order), and an
// unbuffered channel would deadlock exactly there — main is parked in wg.wait()
// and cannot be receiving yet, so every worker's send would block forever
// waiting for a receiver that cannot arrive before wg.wait() itself returns.
// Capacity W lets every send complete immediately, wg.wait() then returns once
// every worker is done, and main drains W already-buffered values with no
// rendezvous at all.

import { envOr, exit } from "std/os"
import { parseInt } from "std/strings"
import { newWaitGroup, WaitGroup } from "std/sync"

const n: int = 100000
const want: int = n * (n - 1) / 2

// STRESS_WORKERS, defaulting to 8 when unset, empty, non-numeric, or < 1 — a
// malformed knob falls back to the documented default rather than crashing the
// harness on a typo.
fn workerCount(): int {
  let raw = envOr("STRESS_WORKERS", "8")
  let w = parseInt(raw) catch e {
    return 8
  }
  if (w < 1) {
    return 8
  }
  return w
}

fn worker(chunk: []int, results: chan<int>, wg: WaitGroup) {
  let sum = 0
  for x of chunk {
    sum = sum + x
  }
  results <- sum
  wg.done()
}

fn main() {
  let w = workerCount()

  let work = []int(n)
  let i = 0
  while (i < n) {
    work[i] = i
    i = i + 1
  }

  // Chunk boundaries: n may not divide w evenly, so the first `n % w` chunks
  // take one extra element rather than dropping the remainder on the floor.
  let base = n / w
  let rem = n % w
  let results = chan<int>(w)
  let wg = newWaitGroup()
  wg.add(w)

  let start = 0
  let k = 0
  while (k < w) {
    let size = base
    if (k < rem) {
      size = size + 1
    }
    let end = start + size
    spawn worker(work[start:end], results, wg)
    start = end
    k = k + 1
  }
  wg.wait()

  let total = 0
  let got = 0
  while (got < w) {
    total = total + <- results
    got = got + 1
  }

  if (total != want) {
    print("fanout FAIL want=${want} got=${total}\n")
    exit(1)
  }
  print("fanout OK\n")
}
