// #6679: a `match` expression in a generic function took its join block's type
// from the PREVIOUS instance of the template (`lowerMatchExpr`, lowermatch.bit,
// read `v`'s stale `declTypes` entry). `hold<i64>` ran first, so `hold<string>`,
// `hold<Node>` and `hold<[]i64>` could build a join param typed `i64`, `i32` or
// `u8` for a reference. Nothing but the type said so: the `None` arm's `mk()`
// is a fresh object whose ONLY reference is the join param, live across
// `churn`'s allocating loop, and a stack map that omits it would free a live
// object. The `string` instance can also trip IR verification (the exploded
// string's base word); the class and slice instances never do.
//
// OBSERVED, NOT CONCLUDED: this program printed `mismatches=0` under BIT_GC=stress
// with BIT_GC_NO_CONSERVATIVE_SCAN=1 on the UNFIXED compiler too (the same
// outcome `enumexplode`'s header reports for its own mutant), so it is
// corroboration that the fixed instances are rooted, not the guard.
// `_tests_/cases/ir_generic_match_join_type.bit` is the deterministic guard: its
// expected IR differs on the unfixed compiler.
import { env } from "std/os"
import { stwSetNoConservativeScan } from "../../../runtime/stw"

class Node {
  id: i64,
  tag: string,
}

class Box<T> {
  v: Option<T>,
}

const ITERS = 4000

// Allocates and loops, so every iteration is a safepoint under BIT_GC=stress,
// and fills the freed size classes with fresh strings, nodes and slices so a
// swept `s${i}`/`t${i}` is overwritten rather than left readable. Never
// negative, so `hold` below never takes its early return.
fn churn(i: i64): i64 {
  let total = 0
  let k = 0
  while (k < 8) {
    let junk = []i64(8)
    junk[0] = i + k
    let filler = "x${i + k}"
    let pair = []i64(2)
    pair[0] = -5
    pair[1] = -6
    let nn = Node{ id = -77, tag = "z${k}" }
    total = total + junk[0] + len(filler) + (pair[0] + 5) + (nn.id + 77) + len(nn.tag)
    k = k + 1
  }
  return total
}

// `r` is the match's join param. On the `None` arm it is `mk()`'s fresh result.
fn hold<T>(o: Option<T>, mk: () => T, i: i64): T {
  let r = match (o) {
    Some(v) => v
    None => mk()
  }
  if (churn(i) < 0) {
    return mk()
  }
  return r
}

fn holdBox<T>(b: Box<T>, mk: () => T, i: i64): T {
  let r = match (b.v) {
    Some(v) => v
    None => mk()
  }
  if (churn(i) < 0) {
    return mk()
  }
  return r
}

// Each instance follows one whose payload is a different class of type, so the
// stale join type is a non-reference (`i64`, `i32`, `u8`) in front of every
// reference instance: `hold<string>` after `hold<i64>`, `hold<Node>` after
// `hold<i32>`, `hold<[]i64>` after `hold<u8>`. Every subject is `None`.
fn check(i: i64): i64 {
  let bad = 0
  let n: Option<i64> = Option.None
  if (hold(n, () => i, i) != i) {
    bad = bad + 1
  }
  let s: Option<string> = Option.None
  if (hold(s, () => "s${i}", i) != "s${i}") {
    bad = bad + 1
  }
  let w: Option<i32> = Option.None
  if (hold(w, () => i32(i % 1000), i) != i32(i % 1000)) {
    bad = bad + 1
  }
  let node: Option<Node> = Option.None
  let got = hold(node, () => Node{ id = i, tag = "t${i}" }, i)
  if (got.id != i || got.tag != "t${i}") {
    bad = bad + 1
  }
  let by: Option<u8> = Option.None
  if (hold(by, () => u8(i % 200), i) != u8(i % 200)) {
    bad = bad + 1
  }
  let sl: Option<[]i64> = Option.None
  let gs = hold(sl, () => [i, i + 1], i)
  if (len(gs) != 2 || gs[0] != i || gs[1] != i + 1) {
    bad = bad + 1
  }
  return bad + checkBox(i)
}

// The same through a generic class field, the ticket's own shape.
fn checkBox(i: i64): i64 {
  let bad = 0
  let bi = Box<i64>{ v = Option.None }
  if (holdBox(bi, () => i, i) != i) {
    bad = bad + 1
  }
  let bs = Box<string>{ v = Option.None }
  if (holdBox(bs, () => "b${i}", i) != "b${i}") {
    bad = bad + 1
  }
  let bn = Box<Node>{ v = Option.None }
  let gn = holdBox(bn, () => Node{ id = i + 5, tag = "n${i}" }, i)
  if (gn.id != i + 5 || gn.tag != "n${i}") {
    bad = bad + 1
  }
  return bad
}

fn main() {
  if (env("BIT_GC_NO_CONSERVATIVE_SCAN") == "1") {
    stwSetNoConservativeScan(true)
  }
  let i = 0
  let mismatches = 0
  while (i < ITERS) {
    mismatches = mismatches + check(i)
    i = i + 1
  }
  print("mismatches=${mismatches}\n")
}
