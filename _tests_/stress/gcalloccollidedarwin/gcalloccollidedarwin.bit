// #7139's alloc-cache home-collision proof, Darwin binding. The property, and
// why it discriminates, live in `../thread/alloccollide`. This file supplies
// only the platform thread provider, as `../gcallocmigratedarwin` does.
import { collideRun } from "../thread/alloccollide"
import { threadStart, threadRelease } from "../../../runtime/thread/darwin"
import { parkSleepNs, parkMonoNs } from "../../../runtime/park/darwin"

// Adapts `parkSleepNs` to `collideRun`'s shape with this thread's own scratch,
// as `../gcallocmigratedarwin` does.
let sleepScratch: [2]i64

fn sleepAdapt(ns: int) {
  parkSleepNs(ns, ptrOf(sleepScratch))
}

fn main() {
  let r = collideRun(threadStart, threadRelease, sleepAdapt, parkMonoNs)
  print("gcalloccollide started=${r.started} joined=${r.joined} released=${r.released} rival=${r.rival} first=${r.first} steady=${r.steady}\n")
}
