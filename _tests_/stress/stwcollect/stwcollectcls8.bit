// _tests_/stress/stwcollect/stwcollectcls8.bit — phase H's body: ROOT-class-8
// machinery, the RUNNING task's own stack, split out of stwcollectphases.bit
// under the 800-line limit (#4249). Sibling files in a directory are the same
// module, so this file holds no import of its own; `wire`'s word indices and
// every other phase live in stwcollectphases.bit, the geometry constants and
// `alive` in stwcollecttail.bit.
//
// This is the phase that could not simply be moved out of `main`: its payloads
// live on the REAL stack rather than in a `main` slice, so it is the one phase
// that could pass for the wrong reason. What makes the move legitimate is the
// second round below, not the move itself — see `phaseH`.
//
// No line in this file may spell a `ROOT CLASS <n>` marker: _tests_/bit/stwwiring
// reads stwcollect.bit by name and scans it for them, and a marker here would
// count for nothing while reading as coverage.

// One survivor, or none: `alive` as a count, so the sixteen payloads below can
// be summed in one expression instead of sixteen `if`s (E0204).
fn aliveN(g: *i64, p: int, marker: int): int {
  if (alive(g, p, marker)) {
    return 1
  }
  return 0
}

// One round of phase H: sixteen payloads allocated, held live across a poll,
// and counted afterwards. Nothing but this frame's stack slots and the
// caller-visible count refers to them, so a round in which class 8 does not
// scan this stack must return 0.
//
// Why SIXTEEN: a raw `int` held across the `stwPoll` call must live either in a
// callee-saved register or in a stack slot. Sixteen simultaneously live values
// cannot all be in the callee-saved file (ten on arm64, five on x64), so any
// allocator spills at least six to the stack, where class 8 is the only
// enumerated class that reaches them. A single payload could have spent its
// whole life in a register and proven nothing.
fn cls8Round(g: *i64, wire: []i64): int {
  let nodeInfo = wire[W_NODEINFO]
  let snap = wire[W_SNAP]
  let p0 = gcAlloc(g, nodeInfo)
  let p1 = gcAlloc(g, nodeInfo)
  let p2 = gcAlloc(g, nodeInfo)
  let p3 = gcAlloc(g, nodeInfo)
  let p4 = gcAlloc(g, nodeInfo)
  let p5 = gcAlloc(g, nodeInfo)
  let p6 = gcAlloc(g, nodeInfo)
  let p7 = gcAlloc(g, nodeInfo)
  let p8 = gcAlloc(g, nodeInfo)
  let p9 = gcAlloc(g, nodeInfo)
  let p10 = gcAlloc(g, nodeInfo)
  let p11 = gcAlloc(g, nodeInfo)
  let p12 = gcAlloc(g, nodeInfo)
  let p13 = gcAlloc(g, nodeInfo)
  let p14 = gcAlloc(g, nodeInfo)
  let p15 = gcAlloc(g, nodeInfo)
  storeWord(p0, M_CLS8)
  storeWord(p1, M_CLS8)
  storeWord(p2, M_CLS8)
  storeWord(p3, M_CLS8)
  storeWord(p4, M_CLS8)
  storeWord(p5, M_CLS8)
  storeWord(p6, M_CLS8)
  storeWord(p7, M_CLS8)
  storeWord(p8, M_CLS8)
  storeWord(p9, M_CLS8)
  storeWord(p10, M_CLS8)
  storeWord(p11, M_CLS8)
  storeWord(p12, M_CLS8)
  storeWord(p13, M_CLS8)
  storeWord(p14, M_CLS8)
  storeWord(p15, M_CLS8)

  storeWord(snap + 0, 0)
  storeWord(snap + 8, 0)
  stwPollOn(int(g), wire[W_SCHED], wire[W_REG], wire[W_WORLD], snap)

  // Counted, not `&&`-ed: the count is what distinguishes "class 8 reaches the
  // spilled slots" from "the allocator happened to keep them all in registers".
  return aliveN(g, p0, M_CLS8) +
    aliveN(g, p1, M_CLS8) +
    aliveN(g, p2, M_CLS8) +
    aliveN(g, p3, M_CLS8) +
    aliveN(g, p4, M_CLS8) +
    aliveN(g, p5, M_CLS8) +
    aliveN(g, p6, M_CLS8) +
    aliveN(g, p7, M_CLS8) +
    aliveN(g, p8, M_CLS8) +
    aliveN(g, p9, M_CLS8) +
    aliveN(g, p10, M_CLS8) +
    aliveN(g, p11, M_CLS8) +
    aliveN(g, p12, M_CLS8) +
    aliveN(g, p13, M_CLS8) +
    aliveN(g, p14, M_CLS8) +
    aliveN(g, p15, M_CLS8)
}

// ---- phase H: the RUNNING task's own stack (#1832) ------------------------
//
// Every other phase FABRICATES its task: a `main` slice stands in for a stack
// and the phase writes its payload into a known slot of it. THAT CANNOT WORK
// HERE. Class 8 fires only for the task holding the REAL stack pointer
// (`stwTaskHoldsSp`), and a fabricated stack never does — module data sits far
// below the stack in the address space, so no `[stackBase, +bytes)` range can
// contain both a module array and `sp`.
//
// Bit also has no stack-allocated aggregate to plant into: `[]i64(n)` is a heap
// slice and a module fixed array is `__DATA`, so there is no way to place a word
// at a chosen address on the running stack.
//
// So this phase does the opposite of fabricate. It COPIES the real stack's
// bounds off the live current task, registers them on its own task block, and
// lets the COMPILER place the payloads — which is exactly the shape of the
// defect: `bit_rt_chan_send` holds the element it is about to store as a bare
// `int`, because E0079 forbids a pinned symbol naming a managed type, and a
// stack map names only reference-typed slots.
//
// WHY THIS IS CALLABLE FROM `main` RATHER THAN INLINE IN IT (#4249). Class 8's
// range is `[sp, stackTop)` of the running task, and `cls8Round`'s frame is
// below `main`'s and at or above `sp` for the whole call — inside that range by
// construction, and inside no other class's range. What the range must NOT be
// is a fabricated one, which is what the second round below asserts.
//
// THE TWO ROUNDS, AND WHY THE SECOND IS THE ASSERTION. Every other class is
// empty for this task by construction: `arg` is 0 (class 5); `ctxSp` is the TOP
// of the stack, so class 4's `[ctxSp, top)` range is empty; `running` is true,
// so class 7's ctx scan is skipped; class 6's scratch scan reads the real
// stack's lowest 266 words (`chanScratchWords`), thousands of words BELOW `sp`
// and below anything a live frame occupies; and `snap` carries `ret = 0` so
// class 2 returns before walking. That is an ARGUMENT, and phase H is the one
// phase whose failure mode is a silent pass, so the same round runs again with
// the task's registered range moved onto `fakeStack` — 64 words of `main`'s
// heap, which provably cannot contain the running `sp`. Class 8 then does not
// fire and no other class reaches the payloads, so `foreign=` must be 0/16.
// A collector that scanned the real stack anyway, or a class that reached the
// spill slots by another route, shows up as a non-zero `foreign=`.
//
// Deleting class 8's `lo = sp` reverts the first round's range to `[ctxSp, top)`
// — empty — and must redden `alive=` alone.
//
// `schedCurrentTask()` is 0 when no green task owns this stack, which is the
// case against the deleted native runtime's `libbitrt.a`. Reported rather than
// skipped silently, so the phase can never read as green while asserting
// nothing.
fn phaseH(g: *i64, wire: []i64, cls8Task: []i64) {
  let curTask = schedCurrentTask()
  if (curTask == 0) {
    print("H ran=false onTask=false alive=0/${CLS8_COUNT} foreign=0/${CLS8_COUNT} abandoned=${stwAbandonedCount()}\n")
    return
  }
  let real = taskAt(curTask)
  let ht = ptrOf(cls8Task)
  *(ht + taskArg) = 0
  *(ht + taskState) = taskParked
  *(ht + taskStackBase) = *(real + taskStackBase)
  *(ht + taskStackBytes) = *(real + taskStackBytes)
  *(ht + ctxSp) = *(real + taskStackBase) + *(real + taskStackBytes)
  *(ht + taskRegNext) = 0
  storeWord(wire[W_SCHED] + scRegHead * 8, int(ht))

  let cH = gcStatCollections(g)
  let onStack = cls8Round(g, wire)

  // Same task, same round, a range that cannot hold the running `sp`.
  *(ht + taskStackBase) = wire[W_FAKESTACK]
  *(ht + taskStackBytes) = TASK_STACK_WORDS * 8
  *(ht + ctxSp) = wire[W_FAKESTACK] + TASK_STACK_WORDS * 8
  let offStack = cls8Round(g, wire)

  print("H ran=${gcStatCollections(g) > cH} onTask=true alive=${onStack}/${CLS8_COUNT} foreign=${offStack}/${CLS8_COUNT} abandoned=${stwAbandonedCount()}\n")
}
