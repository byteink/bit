// Regression fixture for #3288: runtime/net/linux/tcp.bit's `netClockNowNs`
// read its timestamp through `netClockScratch`, a module-level (process-wide)
// `[2]i64` shared and unlocked across every worker OS thread. #3288 converted
// it to per-worker slots (`netClockScratchAt`, indexed by `wkId`); this
// program is the permanent guard against that regressing.
//
// THE OBSERVABLE IS DERIVED FROM THE MECHANISM, NOT FROM A SYMPTOM, and that
// distinction is the entire lesson #3288 produced. `parkMonoNs`
// (runtime/park/linux/wait.bit) writes a kernel `timespec` into the caller's
// scratch buffer, then reads both words back. Two racing callers sharing ONE
// buffer are both reading the SAME real clock microseconds apart, so the
// overwhelmingly common torn interleaving shifts the result by only a few
// microseconds — invisible to any wall-clock LATENCY threshold, which is
// exactly what #3288's first reproduction attempt tried and which found
// nothing (mirrored in the ticket's own #3272/#3273-style deadline-outlier
// program, deliberately not committed here — it does not discriminate). The
// observable failure is a torn read straddling a `tv_sec` ROLLOVER: reader A
// writes `{sec: 100, nsec: 999_999_000}`, is overwritten mid-flight by writer
// B's `{sec: 101, nsec: 1_000}`, and A computes `100e9 + 1_000` — about one
// second in the PAST. That needs the tight interleave AND a second boundary
// crossing during it, so the check that actually catches it is not a
// threshold but an INVARIANT over a WALL-CLOCK duration: a monotonic clock
// must never go backwards. Each worker compares every reading only against
// its own immediately-previous one — `now < prev` is unambiguous, no jitter,
// no judgement call — and runs for real wall-clock time (not a fixed
// iteration count) so it actually crosses multiple `tv_sec` boundaries.
//
// MEASURED ON REAL x86_64 LINUX HARDWARE (#3288, `ssh hl-master`, 6 cores):
// pre-fix BIT_WORKERS=6, 120s: 37,408 violations, worst 999,995,342ns
// backward (within 5us of exactly one second — the predicted rollover).
// pre-fix BIT_WORKERS=1 (no concurrent writers, so the shared buffer is
// never actually contended): 0 violations. post-fix BIT_WORKERS=6 and
// BIT_WORKERS=1: 0 violations both. See #3288's ticket for the full table.
//
// `export` on `netClockNowNs` (runtime/net/linux/tcp.bit) is what lets this
// file call the exact function under test rather than a reimplementation —
// a reimplementation using its own scratch buffer would not exercise
// `netClockScratch`/`netClockScratchAt` at all and could not catch this
// class of regression.
//
// LINUX-ONLY, PERMANENTLY, NOT A GAP TO CLOSE: `netClockNowNs` on Darwin
// (runtime/net/darwin/tcp.bit) calls `parkMonoNs()` with NO scratch argument
// at all — confirmed by #3288 (`grep -n netClockScratch
// runtime/net/darwin/tcp.bit` returns nothing) — so there is no shared
// buffer on that platform and no twin fixture to write. This file imports
// `runtime/net/linux` directly, which reaches the kernel through `syscall`
// (SPEC §11.8) and is rejected by the checker on Darwin even for an unused
// import, exactly like ../netsocklinux — hence the sibling `linux-only`
// marker, which is what makes this program a clean SKIP on macOS rather than
// a build failure.
//
// AMBIENT BIT_WORKERS: this gate's env (tools/build/gates.bit's
// `test-stress-batch` entry) does not set `BIT_WORKERS`, so the harness boots
// at the scheduler's real default of 1 worker and grows on demand from there
// (`runtime/sched/grow.bit`, #2593/#3569/#3583, ABI.md §9 step 2) — NOT the
// CPU count this comment used to claim as the unset default. The 6
// near-simultaneous, never-yielding `RACE_G` spawns below are exactly the
// sustained local-ring backlog grow-on-demand reacts to, and #3716
// re-confirmed it empirically after the default stopped being CPU count:
// `RACE_G=6`, `BIT_WORKERS` unset, real x86_64 Linux hardware (`ssh
// mustafa-desktop-wsl`, 28 cores, and `ssh hl-master`, 6 cores), OS thread
// count sampled via `ps -o nlwp=`/`ps -T` every ~300ms through the whole
// 10s run — 10/10 runs on both hosts grew to exactly 3 OS threads (1 boot
// thread + 2 scheduler workers, against a measured 2-thread baseline at
// `RACE_G=1`), all `RESULT=CLEAN`. On a host where growth somehow never
// fires (or a future `BIT_WORKERS=1` override on this gate's env in
// tools/build/gates.bit) `RACE_G` goroutines still run, but never actually
// concurrently — #3288's own BIT_WORKERS=1 control measured 0 violations on
// the UNFIXED binary for exactly that reason — so this program would become
// a silent no-op there. Check #3716 before trusting a green run on a host
// materially different from the two confirmed above.
//
// This program makes NO allocations in its hot loop (int/atomic arithmetic
// only, plus one `@nosplit` runtime call), so it deliberately carries no
// `no-collect` marker: `checkProgram`'s collection oracle in
// _tests_/bit/stress/verify.bit is satisfied empirically (see this program's
// own registration comment in _tests_/bit/stress/stress.bit for the measured
// counts) rather than declared away.

import { netClockNowNs } from "../../../runtime/net/linux"
import { sleep, Millisecond } from "std/time"
import { env } from "std/os"
import { parseInt } from "std/strings"

const MAXG: int = 64

fn envInt(name: string, def: int): int {
  let v = env(name)
  if (len(v) == 0) { return def }
  let n = parseInt(v) catch _ { def }
  if (n <= 0) { return def }
  return n
}

let doneCount: [1]i64
let violationsArr: [64]i64
let maxBackwardArr: [64]i64

fn worker(idx: int, durationNs: int) {
  let prev = netClockNowNs()
  let startNs = prev
  let violations = 0
  let maxBackward = 0
  while (true) {
    let now = netClockNowNs()
    if (now < prev) {
      violations = violations + 1
      let back = prev - now
      if (back > maxBackward) { maxBackward = back }
    }
    prev = now
    if (now - startNs >= durationNs) {
      violationsArr[idx] = violations
      maxBackwardArr[idx] = maxBackward
      atomicAdd(ptrOf(doneCount), 1)
      return
    }
  }
}

fn main() {
  let g = envInt("RACE_G", 6)
  if (g > MAXG) { g = MAXG }
  let durationS = envInt("RACE_DURATION_S", 10)
  let durationNs = durationS * 1000000000
  let idx = 0
  while (idx < g) { spawn worker(idx, durationNs); idx = idx + 1 }
  let maxPolls = (durationS + 30) * 200
  let polls = 0
  while (int(atomicLoad(ptrOf(doneCount))) < g && polls < maxPolls) {
    sleep(5 * Millisecond); polls = polls + 1
  }
  let completed = int(atomicLoad(ptrOf(doneCount)))
  print("g=${g} durationS=${durationS} completed=${completed}/${g}\n")
  let totalViolations = 0
  let maxBackward = 0
  let i = 0
  while (i < g) {
    totalViolations = totalViolations + violationsArr[i]
    if (maxBackwardArr[i] > maxBackward) { maxBackward = maxBackwardArr[i] }
    i = i + 1
  }
  print("totalViolations=${totalViolations} maxBackwardNs=${maxBackward}\n")
  // No explicit `exit()` call anywhere in this program, deliberately: `std/os`'s
  // `exit` is `osExit` under the hood ("terminate immediately... deferred calls
  // do not run"), and the runtime's `statsReport` (runtime/root/linux/boottail.bit)
  // only runs after the worker threads are joined post-`main`-return — an
  // explicit exit skips it, and this program's aggregate `[bit-gc] collections=`
  // line would silently disappear, which `checkProgram` treats as fatal (see
  // this file's header). A failure is signalled the same way every other
  // program in this corpus signals one: `RESULT=VIOLATION`/`RESULT=INCOMPLETE`
  // fails the exact stdout comparison against `netclockmono.expected`, which
  // only ever contains `RESULT=CLEAN`.
  if (completed < g) { print("RESULT=INCOMPLETE\n"); return }
  if (totalViolations > 0) { print("RESULT=VIOLATION\n"); return }
  print("RESULT=CLEAN\n")
}
