// #5846's alloc-cache migration proof, Linux binding. The properties, and
// why each one discriminates, live in `../thread/allocmigrate`. This file
// supplies only the platform thread provider. Linux-only by construction,
// hence the sibling `linux-only` marker: the provider issues raw `syscall`s
// (SPEC §11.8), which the compiler rejects when targeting Darwin, even for
// an uncalled declaration. Kept identical in shape to its Darwin twin
// (`../gcallocmigratedarwin`), so a future divergence between the two means
// a real platform difference rather than a spelling one.
//
// Own private GC state (`gcBindMemory`/`gcInit`-bound arena), so this needs
// a `no-collect` marker for the same reason `../gcslotbitmap`'s does: none
// of the assertions depend on the AMBIENT collector ever running.
import { migrateRun } from "../thread/allocmigrate"
import { threadStart, threadRelease } from "../../../runtime/thread/linux"
import { parkSleepNs, parkMonoNs } from "../../../runtime/park/linux"

// `migrateRun` takes `sleepFn`/`monoFn` as the generic `(int) => ()` /
// `() => int` shape shared with the Darwin twin — `parkSleepNs`/`parkMonoNs`
// no longer fit it directly now that each takes a caller-owned scratch
// (#2318), so these adapt them back using this thread's own scratch, which
// nothing else on this OS thread touches concurrently.
let sleepScratch: [2]i64

fn sleepAdapt(ns: int) {
  parkSleepNs(ns, ptrOf(sleepScratch))
}

fn monoAdapt(): int {
  return parkMonoNs(ptrOf(sleepScratch))
}

fn main() {
  let r = migrateRun(threadStart, threadRelease, sleepAdapt, monoAdapt)
  print("gcallocmigrate started=${r.started} joined=${r.joined} released=${r.released} naiveShort=${r.naiveShort} exactMatch=${r.exactMatch}\n")
}
