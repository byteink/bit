// #7880: syscall exit and the collector's stop are a Dekker pair.
// A private World isolates the handshake from the live process collector.
// Once rendezvous counts a syscall slot, that slot cannot finish an exit
// before restart. The post-exit delay makes an escape visible in that window.
// Extern calls exercise libbitrt; importing the GC module would compile a
// second implementation and could hide a mutation in the linked archive.
import { WaitGroup } from "std/sync"

@nonblocking extern fn bit_rt_port_gc_world_begin_syscall(world: *i64, slot: int, sp: int)
@nonblocking extern fn bit_rt_port_gc_world_end_syscall(world: *i64, slot: int)
@nonblocking extern fn bit_rt_port_gc_world_rendezvous(
  world: *i64,
  selfSlot: int,
  deadline: int,
): bool
@nonblocking extern fn bit_rt_port_gc_world_restart(world: *i64)
@nonblocking extern fn bit_rt_port_gc_ticks(): int

const ROUNDS: int = 200000
const HOLD_NS: int = 20000
const DELAY: int = 200
const MUTATOR_BOUND: int = 50000000
const CLOCK_BOUND: int = 1000000
let world: [4096]i64
let done: [8]i64
let exits: [8]i64
let dummy: [8]i64
let violations: [1]i64
let completed: [1]i64
let exhausted: [1]i64

@nosplit fn waitNs(ns: int) {
  let until = bit_rt_port_gc_ticks() + ns
  let i = 0
  while (i < CLOCK_BOUND && bit_rt_port_gc_ticks() < until) {
    i = i + 1
  }
  if (i == CLOCK_BOUND) {
    atomicStore(ptrOf(exhausted), i64(1))
  }
}

@nosplit fn mutator() {
  let w = ptrOf(world)
  let i = 0
  while (i < MUTATOR_BOUND && atomicLoad(ptrOf(done)) == 0) {
    bit_rt_port_gc_world_begin_syscall(w, 0, 4096)
    bit_rt_port_gc_world_end_syscall(w, 0)
    let j = 0
    while (j < DELAY) {
      let _ = atomicAdd(ptrOf(dummy), i64(1))
      j = j + 1
    }
    let _ = atomicAdd(ptrOf(exits), i64(1))
    i = i + 1
  }
  if (i == MUTATOR_BOUND) {
    atomicStore(ptrOf(exhausted), i64(1))
  }
}

@nosplit fn collector() {
  let w = ptrOf(world)
  let i = 0
  while (i < ROUNDS) {
    if (bit_rt_port_gc_world_rendezvous(w, 1, 9223372036854775807)) {
      let before = atomicLoad(ptrOf(exits))
      waitNs(HOLD_NS)
      if (atomicLoad(ptrOf(exits)) != before) {
        violations[0] = violations[0] + 1
      }
      completed[0] = completed[0] + 1
    }
    bit_rt_port_gc_world_restart(w)
    waitNs(HOLD_NS / 4)
    i = i + 1
  }
  atomicStore(ptrOf(done), i64(1))
}

fn runMutator(wg: WaitGroup) {
  mutator()
  wg.done()
}

fn runCollector(wg: WaitGroup) {
  collector()
  wg.done()
}

fn main() {
  let wg = WaitGroup()
  wg.add(2)
  spawn runMutator(wg)
  spawn runCollector(wg)
  wg.wait()
  if (violations[0] != 0) {
    print("syscallexitdekker: ${violations[0]} exits during a stop\n")
  }
  assert(completed[0] > 0 && atomicLoad(ptrOf(exits)) > 0)
  assert(atomicLoad(ptrOf(exhausted)) == 0)
  assert(violations[0] == 0)
  println("syscallexitdekker: OK")
}
