// Linux may overrun a timeout. Check untraced wait floors, then inspect the
// real child's kernel arguments to distinguish 400us from rounded 1ms (#8024).
import { args } from "std/os"
import { schedInit, schedSetPollFd, taskAt } from "../../../runtime/sched"
import { pollCreate, pollClose, pollDrain } from "../../../runtime/sched/linux"
import { pollDisablePwait2 } from "../../../runtime/sched/linux"
import { parkMonoNs } from "../../../runtime/park/linux"

const pollWorkers: int = 1

const timeoutNs: int = 400000

const reps: int = 10

const oneFloorNs: int = 250000

const degradeFloorNs: int = 250000

let schedBlock: [16]i64
let workerBlocks: [293]i64
let monoScratch: [2]i64

fn schedAddr(): int {
  return int(ptrOf(schedBlock))
}

fn nowNs(): int {
  return parkMonoNs(ptrOf(monoScratch))
}

fn timedDrain(): int {
  let t0 = nowNs()
  let _ = pollDrain(schedAddr(), timeoutNs)
  return nowNs() - t0
}

fn waits(): bool {
  let s = taskAt(schedAddr())
  schedInit(s, int(ptrOf(workerBlocks)), pollWorkers)

  let pfd = pollCreate()
  let created = pfd >= 0
  schedSetPollFd(s, pfd)

  let fastest = 0
  let i = 0
  while (i < reps) {
    let d = timedDrain()
    if (i == 0 || d < fastest) {
      fastest = d
    }
    i = i + 1
  }

  let one = timedDrain()

  pollDisablePwait2()
  let degraded = timedDrain()

  pollClose(pfd)

  return created && fastest >= oneFloorNs && one >= oneFloorNs && degraded >= degradeFloorNs
}

fn main() {
  let argv = args()
  if (len(argv) == 2 && argv[1] == "--arguments-child") {
    let _ = waits()
    return
  }
  if (!waits()) {
    panic("poll wait returned before its floor")
  }
  println("waited true")
  proveArguments()
}
