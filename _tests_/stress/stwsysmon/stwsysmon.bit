// Nothing enforced sysmon's mutator-slot contract (#4734, from #4287's triage).
//
// Since #4060 every thread started through `threadTrampoline`
// (`runtime/thread/darwin/spawn.bit`) claims a mutator slot unconditionally, so
// an entry body that neither reaches a safepoint nor brackets itself with
// `gcBlockingBegin`/`gcBlockingEnd` holds a slot that reads `mRunning` forever.
// `sysmonRun` (`runtime/root/darwin/boot.bit`, and `runtime/root/linux/sysmon.bit`)
// is `@nosplit` end to end, so codegen emits no back-edge safepoint anywhere in
// it and it can never acknowledge an epoch: its one `gcBlockingBegin()` line is
// the whole of its side of the contract. Deleting that line builds FULLY GREEN
// — libbitrt, selfhost, install, the runtime ABI arity scan and the stack-map
// padding check all pass — and produces a compiler that livelocks 8/8 in
// `worldRendezvous` (`runtime/gc/gcworldstop.bit`) at 70% CPU, because every
// rendezvous burns `stwSpinBound` and gives up. The only trace is a silent
// `stwAbandoned` increment (`runtime/stw/stw.bit`).
//
// This program is the missing oracle, and it is deliberately the smallest thing
// that can see the defect: sysmon is started unconditionally at boot (step 6b of
// `boot`, `runtime/root/darwin/boot.bit`), so ANY program that actually collects
// on the process collector is exposed to an unbracketed entry body. It allocates
// past the default 4 MiB trigger (`gcDefaultMinTrigger`, `runtime/gc/gc.bit`) so
// a real collection happens under the DEFAULT policy too, then reads the two
// process-wide STW counters through the very functions the runtime's own
// `BIT_GC_STATS` exit summary is built from — `stwCollections`
// (`runtime/stw/stwstats.bit`) and `stwAbandonedCount` (`runtime/stw/stw.bit`)
// are what `statsReport` (`runtime/root/darwin/bootstats.bit`) prints as the
// `collections=` and `abandoned=` fields of its `[bit-gc]` line — and prints
// them. No new surface: the same two calls, one process earlier.
//
// WHY A COUNTER AND NOT AN ANSWER. An abandoned rendezvous is SAFE: nothing is
// corrupted, no output changes, the collection simply does not happen. There is
// no wrong answer to catch, so the count is the only oracle — the same reason
// `_tests_/stress/gcslotexitdarwin` exists and carries a `no-abandon` marker.
// This program carries that marker too, and the two are not redundant: the
// marker judges the stats line the harness captured from the `BIT_GC=stress`
// run (`judgeOracled`, `_tests_/bit/stress/verify.bit`), while the reading
// printed below is what a DIRECT run of the binary asserts, against
// `stwsysmon.expected`.
//
// FEW, LARGE ALLOCATIONS, on purpose. 32 x 512 KiB is 16 MiB against the 4 MiB
// default trigger, so the default-policy run collects rather than reporting
// `collected false`; and it is only 32 back edges, so the `BIT_GC=stress` run —
// which polls at every one of them — stays short.

import { stwCollections, stwAbandonedCount } from "../../../runtime/stw"
import { exit } from "std/os"

const SLICE_WORDS = 65536 // 512 KiB per round
const ROUNDS = 32         // 16 MiB in total, 4x the default 4 MiB min trigger

// Allocates and discards `ROUNDS` blocks, writing and reading back the first and
// last word of each so the allocation is not dead, and returns a value derived
// from every round: 2 * (0 + 1 + ... + 31) = 992. A short sum rather than the
// blocks themselves, so nothing here stays live across the loop and the garbage
// the collector is meant to find is real.
fn churn(): int {
  let sum = 0
  let r = 0
  while (r < ROUNDS) {
    let block = []i64(SLICE_WORDS)
    block[0] = i64(r)
    block[SLICE_WORDS - 1] = i64(r)
    sum = sum + int(block[0]) + int(block[SLICE_WORDS - 1])
    r = r + 1
  }
  return sum
}

fn main() {
  let sum = churn()
  let collections = stwCollections()
  let abandoned = stwAbandonedCount()
  print("churn ${sum}\n")
  print("collected ${collections > 0}\n")
  print("abandoned ${abandoned}\n")
  // Self-asserting, so a DIRECT run of this binary is an oracle too and not
  // merely three lines someone has to compare by eye. Only the failing path
  // takes `exit`, which terminates before `statsReport` writes its line — the
  // passing run returns normally and still produces it, so no `no-stats`
  // marker is owed (`checkProgram`, `_tests_/bit/stress/verify.bit`).
  if (abandoned != 0 || collections == 0) {
    exit(1)
  }
}
