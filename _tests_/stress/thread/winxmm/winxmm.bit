// Win64 nonvolatile XMM across a foreign-to-Bit call (#6434, runtime/ABI.md
// section 9.1): xmm6..xmm15 must come back with all 128 bits intact.
//
// An `asm` stub plays the C caller. It loads a known 128-bit pattern into xmm6
// (distinct HIGH half, the half a `movsd` save/restore loses) and into xmm15
// (the backend's float scratch, `xFScratch2`), calls `floatWork`, and writes
// both registers back out. `floatWork` is a plain Bit function with sixteen
// float values live at once, so its allocation uses xmm6..xmm13 and every
// float load/convert goes through xmm14/xmm15. Nothing else runs between the
// stub's load and its store, so a changed bit can only have come from the
// callee's prologue/epilogue.
//
// WINDOWS-ONLY, HAND-RUN FROM `_tests_/bit/windowssmoke.bit`, and placed as a
// subdirectory of `_tests_/stress/thread/` for the reason ../gcthreadswindows
// states: nothing imports it, so the stress corpus walker never loads it.
//
//   BIT_LIBBITRT=<archive> bit build _tests_/stress/thread/winxmm \
//     --target x86_64-windows -o <out>.exe
//
// Prints `winxmm ok` when both registers match, else `winxmm FAIL ...` with
// the two observed values per register.

// One module-level record, so nothing folds. Words 0..1 / 2..3: the patterns
// for xmm6 / xmm15; 4..5 / 6..7: what each register held after the call;
// 8..23: the inputs `floatWork` converts.
let rec: [24]i64

// Sixteen floats live at once: more than the volatile file xmm0..xmm5 can hold,
// and more than fits xmm0..xmm13 without a spill, so the allocator uses the
// nonvolatile registers and the scratch pair. @nosplit: no poll, so the
// asm-made frame above it is never walked.
@nosplit fn floatWork(): f64 {
  let p = ptrOf(rec) + 8
  let a0 = f64(*p)
  let a1 = f64(*(p + 1))
  let a2 = f64(*(p + 2))
  let a3 = f64(*(p + 3))
  let a4 = f64(*(p + 4))
  let a5 = f64(*(p + 5))
  let a6 = f64(*(p + 6))
  let a7 = f64(*(p + 7))
  let a8 = f64(*(p + 8))
  let a9 = f64(*(p + 9))
  let a10 = f64(*(p + 10))
  let a11 = f64(*(p + 11))
  let a12 = f64(*(p + 12))
  let a13 = f64(*(p + 13))
  let a14 = f64(*(p + 14))
  let a15 = f64(*(p + 15))
  let s1 = a0 * a15 + a1 * a14 + a2 * a13 + a3 * a12
  let s2 = a4 * a11 + a5 * a10 + a6 * a9 + a7 * a8
  let s3 = a0 * a8 + a1 * a9 + a2 * a10 + a3 * a11
  let s4 = a4 * a12 + a5 * a13 + a6 * a14 + a7 * a15
  return s1 * s2 + s3 * s4
}

// The C-ABI caller. rsi = the record, rdi = the callee. Both are callee-saved
// under Win64, so `call` preserves them and the asm's own pins make the
// compiler save them for ITS caller. The callee may destroy every volatile
// register, so the clobber list names them all: that makes the block a clobber
// point, and no value of the enclosing function lives in one across it. rbx keeps the pre-alignment rsp and is
// pushed/popped so the stub hands it back as it found it. The stub
// saves and restores the caller's own xmm6/xmm15 on its aligned stack so it
// leaves the registers it borrows as it found them.
@nosplit fn callWithPatterns(r: *i64, target: *byte) {
  asm {
    arm64 { 0xD503201F } // nop: this fixture is x86_64-windows only
    x64 {
      0x53,                               // push rbx
      0x48, 0x89, 0xE3,                   // mov rbx, rsp
      0x48, 0x83, 0xE4, 0xF0,             // and rsp, -16
      0x48, 0x83, 0xEC, 0x40,             // sub rsp, 64   (32 shadow + 32 save area)
      0x0F, 0x11, 0x74, 0x24, 0x20,       // movups [rsp+32], xmm6
      0x44, 0x0F, 0x11, 0x7C, 0x24, 0x30, // movups [rsp+48], xmm15
      0x0F, 0x10, 0x36,                   // movups xmm6, [rsi]
      0x44, 0x0F, 0x10, 0x7E, 0x10,       // movups xmm15, [rsi+16]
      0xFF, 0xD7,                         // call rdi
      0x0F, 0x11, 0x76, 0x20,             // movups [rsi+32], xmm6
      0x44, 0x0F, 0x11, 0x7E, 0x30,       // movups [rsi+48], xmm15
      0x0F, 0x10, 0x74, 0x24, 0x20,       // movups xmm6, [rsp+32]
      0x44, 0x0F, 0x10, 0x7C, 0x24, 0x30, // movups xmm15, [rsp+48]
      0x48, 0x89, 0xDC,                   // mov rsp, rbx
      0x5B,                               // pop rbx
    }
    input arm64 x0 x64 rsi = r
    input arm64 x1 x64 rdi = target
    clobber x64 { rax, rcx, rdx, r8, r9, r10, r11, memory }
    clobber arm64 { memory }
  }
}

fn main() {
  let q = ptrOf(rec)
  let i = 0
  while (i < 16) {
    *(q + 8 + i) = i + 3
    i = i + 1
  }
  *q = 0x0123456789ABCDEF
  *(q + 1) = 0x1122334455667788
  *(q + 2) = 0x0FEDCBA987654321
  *(q + 3) = 0x7766554433221100
  callWithPatterns(q, entryOf(floatWork))
  let lo6 = *(q + 4)
  let hi6 = *(q + 5)
  let lo15 = *(q + 6)
  let hi15 = *(q + 7)
  let ok6 = lo6 == *q && hi6 == *(q + 1)
  let ok15 = lo15 == *(q + 2) && hi15 == *(q + 3)
  if (ok6 && ok15) {
    print("winxmm ok\n")
    return
  }
  print("winxmm FAIL xmm6 ${ok6} ${lo6} ${hi6} xmm15 ${ok15} ${lo15} ${hi15}\n")
}
