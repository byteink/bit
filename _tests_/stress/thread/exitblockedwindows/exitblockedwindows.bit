// A returned `main` ends a Windows process promptly while other threads are blocked
// in a raw Winsock `recvfrom` that has no timeout (#7829). The boot thread used to
// join each scheduler worker with a 15 s `WaitForSingleObject` (`boot`,
// runtime/root/windows/boot.bit, step 8) before it called `ExitProcess`, so a worker
// parked in the kernel cost the process 15 s; now the join is `bootJoinWorkers`
// (runtime/root/windows/bootjoin.bit), one 100 ms deadline for all workers.
//
// WINDOWS-ONLY, HAND-RUN FROM `_tests_/bit/windowssmoke/phases.bit`, and placed as a
// subdirectory of `_tests_/stress/thread/` for the reason ../gcthreadswindows
// states: nothing imports it, so the stress corpus walker never loads it.
//
//   BIT_LIBBITRT=<archive> bit build _tests_/stress/thread/exitblockedwindows \
//     --target x86_64-windows -o <out>.exe
//
// Two kinds of blocked thread, because they sit differently under the boot thread's
// teardown:
//   * a RAW OS thread (`threadStart`, never a scheduler worker), always started. It
//     works at any BIT_WORKERS, including 1.
//   * a green task (`spawn`) that parks a scheduler WORKER thread in `recvfrom`, only
//     when EXITBLOCKED_TASK is set, which the harness does at BIT_WORKERS=4: at one
//     worker the task would take the only worker and `main` would never run again.
// Each binds a UDP socket on 127.0.0.1 and nothing ever sends to it.
//
// `main` waits for every blocked thread to announce itself, gives it `settleMs` to
// enter the kernel, prints `exitblocked return unixms=<milliseconds since the epoch>`
// and returns 7. `runchild.ps1` (WSMOKE_LAG set) reads that stamp and reports
// how long after it the process ended, which is how long the process outlived `main`.
import { envOr } from "std/os"
import { threadStart } from "../../../../runtime/thread/windows"

extern fn WSAStartup(version: i32, data: *byte): i32
extern fn socket(af: i32, ty: i32, proto: i32): i64
extern fn bind(s: i64, name: *byte, namelen: i32): i32
extern fn recvfrom(s: i64, buf: *byte, len: i32, flags: i32, name: *byte, namelen: *i32): i32

const afInet: int = 2
const sockDgram: int = 2
const ipprotoUdp: int = 17
const saLen: int = 16
const wsaDataBytes: int = 512
const wsaVersion22: int = 514
const readyPolls: int = 5000
const settleMs: int = 200
const exitCode: int = 7

let ready: [1]i64
let threadDone: [1]i32

// Binds 127.0.0.1:0 (family 2 as a little-endian u16 at 0, the address at 4), tells
// `main`, then blocks in `recvfrom` for good.
fn blockForever() {
  let sa = []byte(saLen)
  sa[0] = 2
  sa[4] = 127
  sa[7] = 1
  let s = socket(i32(afInet), i32(sockDgram), i32(ipprotoUdp))
  if (int(bind(s, ptrOf(sa), i32(saLen))) != 0) {
    print("exitblocked FAIL bind\n")
    return
  }
  atomicAdd(ptrOf(ready), 1)
  let buf = []byte(64)
  let nobytes: *byte = nil
  let nolen: *i32 = nil
  let _ = recvfrom(s, ptrOf(buf), i32(64), i32(0), nobytes, nolen)
  print("exitblocked FAIL recvfrom returned\n")
}

fn blockedThread(arg: *byte): *byte {
  blockForever()
  return nil
}

fn blockedTask() {
  blockForever()
}

fn main(): int {
  let wsa = []byte(wsaDataBytes)
  if (int(WSAStartup(i32(wsaVersion22), ptrOf(wsa))) != 0) {
    print("exitblocked FAIL WSAStartup\n")
    return 1
  }
  let want = 1
  let nonearg: *byte = nil
  if (threadStart(entryOf(blockedThread), nonearg, ptrOf(threadDone)) == 0) {
    print("exitblocked FAIL threadStart\n")
    return 1
  }
  if (envOr("EXITBLOCKED_TASK", "") != "") {
    spawn blockedTask()
    want = 2
  }
  let polls = 0
  while (int(atomicLoad(ptrOf(ready))) < want && polls < readyPolls) {
    timeSleepNs(1000000)
    polls = polls + 1
  }
  if (int(atomicLoad(ptrOf(ready))) < want) {
    print("exitblocked FAIL not all blocked\n")
    return 1
  }
  timeSleepNs(settleMs * 1000000)
  print("exitblocked return unixms=${timeUnixNs() / 1000000}\n")
  return exitCode
}
