// Native Windows DNS controls (#6351, #7480). The fake IPv6 server is
// nonblocking too: a raw blocking stub would itself prevent GC progress.
// Query arrival synchronizes the unanswered lookup before allocation starts.
// Every wait is bounded; each scenario joins both tasks and closes its socket.
// Built and run by _tests_/bit/windowssmoke with BIT_WORKERS=4.

import { WaitGroup } from "std/sync"
import { monotonic } from "std/time"

extern fn socket(af: i32, ty: i32, proto: i32): i64
extern fn bind(s: i64, name: *byte, namelen: i32): i32
extern fn getsockname(s: i64, name: *byte, namelen: *i32): i32
extern fn ioctlsocket(s: i64, cmd: i32, arg: *byte): i32
extern fn recvfrom(s: i64, buf: *byte, len: i32, flags: i32, name: *byte, namelen: *i32): i32
extern fn sendto(s: i64, buf: *byte, len: i32, flags: i32, name: *byte, namelen: i32): i32
extern fn closesocket(s: i64): i32
extern fn WSAGetLastError(): i32
extern fn bit_rt_port_net_resolve_passes(host: int, hostLen: int, ns: int, out: int): bool
extern fn bit_rt_port_stw_collections(): int
extern fn bit_rt_port_stw_pause_max_ns(): int

const sa6Len: int = 28
const entryBytes: int = 20
const answerBytes: int = 16
const queryMax: int = 512
const windowMs: int = 2000
const maxPolls: int = 5000
const sliceWords: int = 65536
const churnRounds: int = 32
const pauseBudgetNs: int = 50000000

let stubPort: [1]i64
let stubArrived: [1]i64
let stubAnswered: [1]i64
let resolverDone: [1]i64
let resolverOk: [1]i64
let stubDone: [1]i64

fn loopback6(sa: []byte) {
  sa[0] = 23
  sa[23] = 1
}

fn nonblocking(s: i64): bool {
  let one = []byte(4)
  one[0] = 1
  let ok = ioctlsocket(s, i32(0x8004667E), ptrOf(one)) == 0
  keepAlive(one)
  return ok
}

fn answer(q: []byte, n: int): int {
  q[2] = 129
  q[3] = 128
  q[7] = 1
  let rr = [192, 12, 0, 1, 0, 1, 0, 0, 0, 60, 0, 4, 1, 2, 3, 4]
  let i = 0
  while (i < answerBytes) {
    q[n + i] = u8(rr[i])
    i = i + 1
  }
  return n + answerBytes
}

fn receive(s: i64, q: []byte, from: []byte): int {
  let size = []i32(1)
  let polls = 0
  while (polls < maxPolls) {
    size[0] = i32(sa6Len)
    let n = int(recvfrom(s, ptrOf(q), i32(queryMax - answerBytes), i32(0), ptrOf(from), ptrOf(size)))
    if (n >= 0) {
      return n
    }
    if (int(WSAGetLastError()) != 10035) {
      return -1
    }
    timeSleepNs(1000000)
    polls = polls + 1
  }
  return -1
}

fn waitWord(word: *i64): bool {
  let polls = 0
  while (atomicLoad(word) == 0 && polls < maxPolls) {
    timeSleepNs(1000000)
    polls = polls + 1
  }
  return atomicLoad(word) != 0
}

fn serve(s: i64, respond: bool) {
  let q = []byte(queryMax)
  let from = []byte(sa6Len)
  let n = receive(s, q, from)
  assert(n >= 12, "DNS stub receive ${n}")
  atomicAdd(ptrOf(stubArrived), 1)
  if (respond) {
    let m = answer(q, n)
    let sent = sendto(s, ptrOf(q), i32(m), i32(0), ptrOf(from), i32(sa6Len))
    assert(int(sent) == m, "DNS stub send ${int(sent)} of ${m}")
    atomicAdd(ptrOf(stubAnswered), 1)
    return
  }
  assert(waitWord(ptrOf(resolverDone)), "DNS resolver did not finish")
}

fn stub(respond: bool, closed: bool, joined: WaitGroup) {
  let s = socket(i32(23), i32(2), i32(17))
  assert(s != -1, "DNS stub socket")
  let sa = []byte(sa6Len)
  loopback6(sa)
  assert(bind(s, ptrOf(sa), i32(sa6Len)) == 0, "DNS stub bind")
  assert(nonblocking(s), "DNS stub nonblocking")
  let size = []i32(1)
  size[0] = i32(sa6Len)
  assert(getsockname(s, ptrOf(sa), ptrOf(size)) == 0, "DNS stub port")
  let port = int(sa[2]) * 256 + int(sa[3])
  if (closed) {
    assert(closesocket(s) == 0, "DNS closed stub")
    atomicAdd(ptrOf(stubPort), port)
  } else {
    atomicAdd(ptrOf(stubPort), port)
    serve(s, respond)
    assert(closesocket(s) == 0, "DNS stub close")
  }
  atomicAdd(ptrOf(stubDone), 1)
  joined.done()
}

fn resolve(port: int, joined: WaitGroup) {
  let host = []byte(12)
  let name = "example.test"
  let i = 0
  while (i < 12) {
    host[i] = name[i]
    i = i + 1
  }
  let list = []byte(entryBytes)
  list[15] = 1
  let ns = []i64(8)
  ns[2] = windowMs
  ns[3] = 1
  ns[4] = port
  ns[6] = int(ptrOf(list))
  ns[7] = entryBytes
  let out = []byte(8)
  let ok = bit_rt_port_net_resolve_passes(int(ptrOf(host)), 12, int(ptrOf(ns)), int(ptrOf(out)))
  keepAlive(host)
  keepAlive(list)
  keepAlive(ns)
  assert(!ok || (out[0] == 1 && out[1] == 2 && out[2] == 3 && out[3] == 4), "DNS address")
  if (ok) {
    atomicAdd(ptrOf(resolverOk), 1)
  }
  atomicAdd(ptrOf(resolverDone), 1)
  joined.done()
}

fn churn(): int {
  let sum = 0
  let r = 0
  while (r < churnRounds) {
    let block = []i64(sliceWords)
    block[0] = i64(r)
    block[sliceWords - 1] = i64(r)
    sum = sum + int(block[0]) + int(block[sliceWords - 1])
    r = r + 1
  }
  return sum
}

fn checkProgress(): bool {
  let before = bit_rt_port_stw_collections()
  let sum = churn()
  let after = bit_rt_port_stw_collections()
  let pause = bit_rt_port_stw_pause_max_ns()
  let pending = atomicLoad(ptrOf(resolverDone)) == 0
  print("dnsgc collected=${after > before} pending=${pending} pause-ns=${pause} sum=${sum}\n")
  return after > before && pending && pause < pauseBudgetNs && sum == 992
}

fn resetWords() {
  atomicStore(ptrOf(stubPort), 0)
  atomicStore(ptrOf(stubArrived), 0)
  atomicStore(ptrOf(stubAnswered), 0)
  atomicStore(ptrOf(resolverDone), 0)
  atomicStore(ptrOf(resolverOk), 0)
  atomicStore(ptrOf(stubDone), 0)
}

fn scenario(respond: bool, closed: bool): bool {
  resetWords()
  let joined = WaitGroup()
  joined.add(2)
  spawn stub(respond, closed, joined)
  assert(waitWord(ptrOf(stubPort)), "DNS stub never bound")
  let started = monotonic().ns
  spawn resolve(int(atomicLoad(ptrOf(stubPort))), joined)
  let progress = true
  if (!closed) {
    assert(waitWord(ptrOf(stubArrived)), "DNS query never arrived")
    if (!respond) {
      progress = checkProgress()
    }
  }
  assert(waitWord(ptrOf(resolverDone)), "DNS resolver deadline")
  assert(waitWord(ptrOf(stubDone)), "DNS stub deadline")
  joined.wait()
  let elapsed = (monotonic().ns - started) / 1000000
  let answered = atomicLoad(ptrOf(stubAnswered)) == 1
  let resolved = atomicLoad(ptrOf(resolverOk)) == 1
  print("dnsgc answer=${respond} closed=${closed} elapsed-ms=${elapsed} resolved=${resolved}\n")
  return progress && resolved == respond && answered == respond && elapsed <= windowMs + 250
}

fn main() {
  assert(scenario(true, false), "DNS IPv6 success")
  print("dnsv6 ok 1.2.3.4\n")
  assert(scenario(false, false), "DNS GC progress and timeout")
  assert(scenario(false, false), "DNS repeated timeout")
  assert(scenario(true, false), "DNS success after timeout")
  assert(scenario(false, true), "DNS closed server")
  print("dnsgc ok\n")
}
