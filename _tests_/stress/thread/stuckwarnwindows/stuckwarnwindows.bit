// The Windows half of `_tests_/stress/stuckwarn` (#7841): the monitor thread
// (`rootStuckScan`, runtime/root/windows/sysmon.bit) warns once on stderr when a
// worker holds a task past `BIT_STUCK_MS` outside any blocking bracket.
//
// WINDOWS-ONLY, HAND-RUN FROM `_tests_/bit/windowssmoke/phases.bit`, and placed as a
// subdirectory of `_tests_/stress/thread/` for the reason ../gcthreadswindows
// states: nothing imports it, so the stress corpus walker never loads it. The
// harness cannot re-exec a child here as the Linux/macOS twin does, so it runs
// this program once per case with STUCKWARN_MODE set, BIT_WORKERS and
// BIT_STUCK_MS in the environment, and counts the `[bit-rt] worker ` lines in the
// combined output:
//   park     a task in an UNBRACKETED `bit_rt_port_park_sleep_ns`   exactly 1
//   poll     two compute tasks that poll at every back edge         0
//   bracket  a task in a BRACKETED `bit_rt_port_park_sleep_ns`      0
// The program prints `stuckwarnwindows ok <mode>` when the tasks finished.
//
//   BIT_LIBBITRT=<archive> bit build _tests_/stress/thread/stuckwarnwindows \
//     --target x86_64-windows -o <out>.exe
import { envOr } from "std/os"
import { monotonic, Millisecond } from "std/time"

extern fn bit_rt_gc_syscall_begin()
extern fn bit_rt_gc_syscall_end()
extern fn bit_rt_port_park_sleep_ns(ns: int, scratch: *i64)

const holdNs: int = 1000 * Millisecond

let sleepScratch: [2]i64

fn unbracketed(done: chan<int>) {
  bit_rt_port_park_sleep_ns(holdNs, ptrOf(sleepScratch))
  done <- 1
}

fn bracketed(done: chan<int>) {
  bit_rt_gc_syscall_begin()
  bit_rt_port_park_sleep_ns(holdNs, ptrOf(sleepScratch))
  bit_rt_gc_syscall_end()
  done <- 1
}

// Polls at every back edge, so each preempt request is consumed within
// microseconds and the task never reads as held.
fn compute(done: chan<int>) {
  let end = monotonic().ns + holdNs
  let x = 0
  while (monotonic().ns < end) {
    x = x + 1
  }
  done <- x
}

fn main(): int {
  let mode = envOr("STUCKWARN_MODE", "")
  let done = chan<int>(2)
  if (mode == "park") {
    spawn unbracketed(done)
  } else if (mode == "bracket") {
    spawn bracketed(done)
  } else if (mode == "poll") {
    spawn compute(done)
    spawn compute(done)
    let _ = <- done
  } else {
    print("stuckwarnwindows FAIL: STUCKWARN_MODE '${mode}' is not park, poll or bracket\n")
    return 1
  }
  let _ = <- done
  print("stuckwarnwindows ok ${mode}\n")
  return 0
}
