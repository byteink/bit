// `bit_rt_fs_open_beneath_w`/`bit_rt_fs_fstat_w` on Windows (#5808): the
// escape matrix `std/fs/secure`'s `openBeneath` must refuse and the plain
// opens it must serve, run on the real Windows box. Every refusal must be the
// same one the Darwin and Linux providers give: the raw primitive returns -1
// and `openBeneath` fails.
//
// WINDOWS-ONLY, HAND-RUN FROM `_tests_/bit/windowssmoke/windowssmoke.bit`, and placed as a
// subdirectory of `_tests_/stress/thread/` for the reason ../gcthreadswindows
// states: nothing imports it, so the stress corpus walker never loads it.
//
//   BIT_LIBBITRT=<archive> bit build _tests_/stress/thread/fsbeneathwindows \
//     --target x86_64-windows -o <out>.exe
//
// The harness's PowerShell prelude builds the part Bit cannot (std/fs has no
// link creator): `<dir>\root`, `<dir>\outside`, a directory JUNCTION
// `root\jlink` -> `outside`, a junction `<dir>\rootlink` -> `root` (the
// trusted root reached through a link must still open), and, when the account
// may create them, a file symlink `root\flink` and a directory symlink
// `root\dlink` -> `outside`. It exports `<dir>` as BIT_FSB_DIR. This program
// writes the files, runs the matrix, removes everything, and prints
// `fsbeneath ok <served> <refused>` or exits 1 after a `FAIL` line per miss.
import { mkdir, remove, exists, writeFile } from "std/fs"
import { openBeneath, statOpen } from "std/fs/secure"
import { env, exit } from "std/os"

extern fn bit_rt_fs_open_beneath_w(root: *byte, rootN: int, rel: *byte, relN: int): i64

// `\` -> `/`: `std/path` is not platform-aware (see ./fs.bit's header), and
// secure.bit's lexical `contains` runs on the root string.
fn fwd(s: string): string {
  let b = []byte(s)
  let i = 0
  while (i < len(b)) {
    if (b[i] == 92) {
      b[i] = 47
    }
    i = i + 1
  }
  return string(b)
}

fn rawOpen(root: string, rel: string): i64 {
  let r = []byte(root)
  let p = []byte(rel)
  return bit_rt_fs_open_beneath_w(ptrOf(r), len(root), ptrOf(p), len(rel))
}

fn mustWrite(path: string, body: string) {
  writeFile(path, body) catch e {
    panic("fsbeneath setup: write ${path}: ${e.message()}")
  }
}

fn mustMkdir(path: string) {
  mkdir(path) catch e {
    panic("fsbeneath setup: mkdir ${path}: ${e.message()}")
  }
}

// 1 (a miss, already printed) when `rel` under `root` opened through either
// layer; 0 when both refused.
fn missIfOpened(root: string, rel: string): int {
  let fd = rawOpen(root, rel)
  if (fd >= 0) {
    print("FAIL raw primitive opened '${rel}' under ${root} (fd ${fd})\n")
    return 1
  }
  let f = openBeneath(root, rel) catch _ {
    return 0
  }
  f.close()
  print("FAIL openBeneath opened '${rel}' under ${root}\n")
  return 1
}

// 1 (a miss) unless `rel` under `root` opened and read back `want`, as a
// regular file of `len(want)` bytes.
fn missIfNotServed(root: string, rel: string, want: string): int {
  let f = openBeneath(root, rel) catch e {
    print("FAIL openBeneath refused '${rel}' under ${root}: ${e.message()}\n")
    return 1
  }
  let body = f.readAll() catch _ {
    "<read failed>"
  }
  let info = statOpen(f) catch _ {
    f.close()
    print("FAIL statOpen failed on '${rel}'\n")
    return 1
  }
  f.close()
  if (body != want || !info.isRegular || info.isDir || info.isSymlink || info.size != len(want)) {
    print("FAIL '${rel}': body '${body}' regular ${info.isRegular} dir ${info.isDir} size ${info.size}\n")
    return 1
  }
  return 0
}

fn removeQuiet(path: string) {
  remove(path) catch _ {
    return
  }
}

fn cleanup(b: string) {
  removeQuiet("${b}/root/a/b/ok.txt")
  removeQuiet("${b}/root/a/b")
  removeQuiet("${b}/root/a")
  removeQuiet("${b}/root/top.txt")
  removeQuiet("${b}/root/jlink")
  removeQuiet("${b}/root/dlink")
  removeQuiet("${b}/root/flink")
  removeQuiet("${b}/rootlink")
  removeQuiet("${b}/root")
  removeQuiet("${b}/outside/secret.txt")
  removeQuiet("${b}/outside")
  removeQuiet(b)
}

const servedRel: []string = ["top.txt", "a/b/ok.txt", "a\\b\\ok.txt"]

// Paths that must never open, grouped by what they try. `jlink` is the
// junction out of the root.
fn refusedRel(): []string {
  return [
    "../outside/secret.txt", "a/../../outside/secret.txt", "a/b/../../../outside/secret.txt",
    "..\\outside\\secret.txt", "a\\..\\..\\outside\\secret.txt", "a/b/..\\..\\..\\outside\\secret.txt",
    "a/..", "a/../top.txt", "a/./b/ok.txt", "..", ".", "...", ".. /top.txt", ".../top.txt",
    "/outside/secret.txt", "\\outside\\secret.txt", "\\Windows\\win.ini", "C:\\Windows\\win.ini",
    "C:/Windows/win.ini", "C:win.ini", "\\\\?\\C:\\Windows\\win.ini", "\\\\.\\C:\\Windows\\win.ini",
    "\\\\localhost\\C$\\Windows\\win.ini", "//localhost/C$/Windows/win.ini",
    "top.txt:ads", "top.txt::$DATA", "a:b", "a/b/ok.txt:ads",
    "jlink/secret.txt", "jlink\\secret.txt", "jlink", "jlink/", "a/../jlink/secret.txt",
    "top.txt.", "top.txt ", "top.txt/", "a//b/ok.txt", "a/b/ok.txt/",
    "NUL", "con", "COM1", "lpt9", "nul.txt", "a/aux.log", "CONIN$", "CONOUT$",
    "a", "a/b", "nope.txt", "a/nope/ok.txt", "*.txt", "to?.txt", "to<p.txt", "",
  ]
}

fn main() {
  let b = fwd(env("BIT_FSB_DIR"))
  if (len(b) == 0) {
    print("fsbeneath FAIL: BIT_FSB_DIR is not set; run through test-windows-smoke\n")
    exit(1)
  }
  let root = "${b}/root"
  mustMkdir("${root}/a")
  mustMkdir("${root}/a/b")
  mustWrite("${root}/a/b/ok.txt", "INSIDE")
  mustWrite("${root}/top.txt", "TOP")
  mustWrite("${b}/outside/secret.txt", "OUTSIDE-LEAK")
  // Non-vacuity: a junction the prelude failed to create would make every
  // `jlink` refusal below pass because the path does not exist at all.
  if (!exists("${root}/jlink/secret.txt") || !exists("${b}/rootlink/top.txt")) {
    print("fsbeneath FAIL: the prelude's junctions are missing or dangling\n")
    cleanup(b)
    exit(1)
  }
  let misses = 0
  let served = 0
  for rel of servedRel {
    let want = "INSIDE"
    if (rel == "top.txt") {
      want = "TOP"
    }
    misses = misses + missIfNotServed(root, rel, want)
    misses = misses + missIfNotServed("${b}/rootlink", rel, want)
    served = served + 2
  }
  let refused = 0
  for rel of refusedRel() {
    misses = misses + missIfOpened(root, rel)
    refused = refused + 1
  }
  misses = misses + missIfOpened("${b}/rootlink", "jlink/secret.txt")
  refused = refused + 1
  let links = 0
  if (exists("${root}/dlink")) {
    misses = misses + missIfOpened(root, "dlink/secret.txt") + missIfOpened(root, "dlink")
    links = links + 2
  }
  if (exists("${root}/flink")) {
    misses = misses + missIfOpened(root, "flink")
    links = links + 1
  }
  cleanup(b)
  if (misses != 0) {
    print("fsbeneath FAIL: ${misses} miss(es)\n")
    exit(1)
  }
  print("fsbeneath ok served=${served} refused=${refused} symlink-cases=${links}\n")
}
