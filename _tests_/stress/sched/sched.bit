// The green-thread context switch and the two run queues (#1364), exercised as
// a real cooperative scheduler rather than as isolated unit assertions.
//
// WHAT THIS PROVES, AND WHY IT IS SHAPED THIS WAY. The switch is hand-encoded
// machine code (SPEC §11.6) whose PC-relative displacements depend on the exact
// instruction count of the block. Nothing in the compiler checks them: get one
// wrong and the program branches into the middle of its own switch. So the
// check that matters is not "does the encoding look right" but "do several
// tasks, on separate stacks, actually run interleaved and come back with their
// live registers intact". P1 is that end-to-end run; the rest pin the pieces.
//
//   P1  Round-robin interleave. Four tasks on four separate stacks each run
//       three rounds, yielding between them. FIFO requeue means the trace must
//       be 0123 0123 0123 — packed two bits per entry, so any reordering,
//       dropped task or double-run changes the number.
//
//   P2  The callee-saved register file survives a switch. Sentinels are written
//       into named physical registers, the task yields, and they are read back
//       — 12 checks, one per yield. This is the property the deleted native runtime's `sched` module gets from
//       LLVM's clobber-driven spilling and this port must provide explicitly
//       (see runtime/sched/switch.bit's header), so it is the one most likely to
//       break silently. See `yieldTask` for why it cannot be written with
//       ordinary locals.
//
//       x64 probes FIVE registers, not three (#3335): rbx/r12/r13 (SysV AND
//       Win64 callee-saved) plus rsi/rdi (Win64-ONLY callee-saved — SysV
//       treats them as arguments/scratch). rsi/rdi are exactly the pair a
//       switch built only from the SysV set would silently drop on Windows.
//       arm64 stays at three (x19/x20/x21): there is no second arm64 calling
//       convention in this tree to diverge from.
//
//       MUTATION-TESTED, both architectures: dropping the x19 save/restore from
//       the arm64 block, or the rbx save/restore from the x64 block, takes this
//       count from 12 to 0 on the affected target (arm64 verified on
//       aarch64-macos, x64 on real x86_64 hardware). The rsi/rdi addition is
//       independently mutation-tested the same way — dropping EITHER save
//       (leaving the other four intact) also takes the count to 0, confirming
//       each of the two new slots is load-bearing on its own, not redundant
//       with the pre-existing three.
//
//       KNOWN LIMIT — the FP half of the context is NOT covered, on EITHER
//       architecture. `clobber` accepts only GPR names (§11.6 lists
//       `x0`..`x30`, `sp`, `xzr` for arm64 and `rax`..`r15` for x64 — no `d`
//       or `xmm` spelling on either), so a sentinel in d8 (arm64) or xmm6
//       (x64) cannot be reserved against the allocator, and any check built on
//       one would measure allocation, not preservation. Mutating the d8
//       save/restore away is confirmed not to fail this test; the x64
//       xmm6..xmm15 additions (#3335) are unchecked by this file for the same
//       structural reason and are carried on encoding review plus an
//       out-of-suite hardware probe instead — see runtime/sched/switch.bit's
//       header and deviation 2 below for both halves of this limit.
//
//       KNOWN LIMIT, measured rather than assumed. Perturbing the arm64 `adr`
//       displacement BACKWARD by one instruction — so a resume lands on the
//       block's own `br x3` — hangs, and is caught. Perturbing it FORWARD by
//       one or two instructions is NOT caught, and the reason is structural:
//       the resume point is followed by `ldr x29,[sp] ; ldr x30,[sp,#8] ; add
//       sp,sp,#0x10 ; ret`, and the switch has ALREADY restored x29/x30 from
//       the incoming context, so those two reloads are redundant and skipping
//       them changes nothing. A forward slip that lands further out executes a
//       neighbouring leaf and returns through the correctly restored x30. So
//       the displacement is protected against undershoot but only weakly
//       against overshoot; the encoding was verified by disassembly
//       (`otool -tV`) rather than by this test alone.
//
//   P3  Deque ordering and edges — push/pop/steal all take from the oldest end,
//       a full ring refuses, and a drained ring reports empty. the deleted native runtime's `sched` module's
//       own `Deque` unit test, transcribed.
//
//   P4  Global queue FIFO, including the empty-queue answer and the
//       tail-reset-on-drain that a naive unlink gets wrong.
//
//   P5  `schedSwitchAway` (#6378, #6386) zeroes the context a task was just
//       resumed from: words 3..ctxWords-1 held the switch's save when the
//       worker resumed it and read 0 once it runs, words 0..2 (sp, pc, fp) are
//       untouched. 12 checks, one per resume. `clearYieldTask` switches
//       through it, so this is the runtime's own resume path: the worker below
//       resumes a task the way `schedWorkerStep` does, naming the task's block
//       as `new`. Its own yield, not P2's: a call to `schedSwitchAway` passes its
//       arguments in rdi/rsi under SysV, which are P2's x64 sentinels.
//
//   P6  Nothing lives in a caller-saved register across a switch (#6382). On
//       resume every register the switch does not restore holds the WORKER's
//       value, so `schedSwitch`'s clobber lists name the whole caller-saved file
//       and the compiler treats the switch as a clobber point, like a call
//       (SPEC §11.6). `liveAcrossSwitch` keeps eight ints and two floats live
//       across a yield with no call in between, which is exactly the shape the
//       allocator may put in x4..x15 / r8, r9 / d0..d7 / xmm0..xmm5 unless the
//       switch declares them; `runWorker` poisons those registers before every
//       switch into a task, so a value left in one reads back as the poison.
//       12 checks, one per round. It is the only check that sees the allocator's
//       side of the switch: P2 sees the switch's own saves. Before #6382 this
//       count was 0 on both targets.
//
// WHY THE TASK BODIES ARE `@nosplit`. Codegen emits a safepoint at every loop
// back-edge, and a safepoint on a task stack would have the collector scan a
// range it knows nothing about — these stacks are module-level arrays, not
// mappings the runtime registered. Registering task stacks with the collector
// is the scheduler REGISTRY's job (the deleted native runtime's `sched` module's `forEachOtherStack`), which is
// not part of this commit, so until it lands a task body must reach no
// safepoint. `@nosplit` is exactly that guarantee, checked at compile time
// rather than hoped for. It is also why the bodies use pointer arithmetic
// instead of indexing (§10.3 forbids indexing in a `@nosplit` body, E0075).
//
// Trace packing: 12 entries x 2 bits, first entry in the high bits.
// 0123 0123 0123 base-4 = 0x1B1B1B = 1776411.

import { schedSwitch, schedTaskInit, taskAt, taskArg, taskWords } from "../../../runtime/sched"
import { ctxWords, schedSwitchAway } from "../../../runtime/sched"
import { dqCapacity, dqInit, dqPushBottom, dqPopBottom, dqSteal } from "../../../runtime/sched"
import { gqInit, gqPush, gqPop } from "../../../runtime/sched"

const TASKS = 4
const ROUNDS = 3
const STACK_WORDS = 2048
const STEP_LIMIT = 64
// The first context word `schedSwitchAway` must zero: 0..2 are sp, pc, fp.
const CTX_FIRST_REG = 3

// Task stacks, one contiguous block carved into `TASKS` slices. Module state is
// statically allocated and untraced (§11.11), which is what a task stack must
// be — the collector must never walk it as an object graph.
let stacks: [8192]i64
// `TASKS * taskWords` DERIVED (#5034): array-size position now accepts a
// constant expression (#1903), so this can no longer drift out of sync with
// `taskWords` the way it did when #5028 grew `taskWords` 32 -> 33 and this
// literal stayed at the old product. This module's own
// `taskAt(taskBase + i * taskWords * 8)` already strides by the current
// constant, so a stale literal here was silently one task SHORT of what that
// stride expects, corrupting the next task's block one word in.
let tasks: [TASKS * taskWords]i64
let queue: [258]i64
let overflow: [3]i64
let workerCtx: [22]i64

// The task currently switched-to, and how it left the CPU. Both are read and
// written only by the worker's own thread, so neither needs atomicity — the
// same argument the deleted native runtime's `sched` module makes for `Worker.next_disposition`.
let current: i64 = 0
let disposition: i64 = 0
let trace: i64 = 0
let checksum: i64 = 0
let cleared: i64 = 0
let live: i64 = 0

// P5: what the worker saw in the context of the task it is about to resume.
let preSet: i64 = 0
let preSp: i64 = 0
let prePc: i64 = 0
let preFp: i64 = 0

// The worker context's address, resolved once in `main`.
//
// `ptrOf` is not on the `@nosplit` operand allowlist, so a task body cannot take
// the address itself even though §11.11 says reaching module state is pure
// arithmetic. Resolving it once outside and carrying the integer keeps the
// bodies `@nosplit` — and it is what a real scheduler does anyway, since a task
// reaches its worker through a stored pointer rather than a static name.
let workerCtxAddr: i64 = 0

const DISP_YIELD: int = 0
const DISP_DONE: int = 1

// Give the CPU back to the worker, staying runnable — and prove, across that
// switch, that the callee-saved register file survived it.
//
// WHY THE SENTINELS ARE WRITTEN BY HAND. The first version of this test simply
// held eight ordinary locals live across the yield and summed them afterwards.
// That check was VACUOUS: mutation-testing it (dropping the x19 save/restore
// from the switch) did not change the answer, because the allocator had spilled
// those locals to the TASK'S OWN STACK, which the switch restores via `sp`
// whether or not it preserves a single register. The test was measuring the
// stack pointer, not the register file.
//
// So the sentinels go into named physical registers directly, and the seed, the
// switch and the read-back all live in THIS ONE function — because §11.6's
// exclusion is function-wide, naming x19/x20/x21 (rbx/r12/r13 on x64) here is
// what stops this function's own allocator from using them. Nothing between the
// two blocks can touch them, so the only code that can is the switch itself.
//
// Only three registers per architecture, not the whole file: a function
// containing a call may allocate ONLY from the callee-saved subset
// (`compiler/arm64.bit`'s `buildIntRegs`), so excluding all of x19..x28 would
// leave the allocator nothing to work with. Three is enough to catch a switch
// that drops a slot, and this is now mutation-proven on both architectures.
//
// x64 ALSO PROBES rsi/rdi (#3335), two more than arm64's three. Not
// symmetry for its own sake: rsi/rdi are the two Win64-only callee-saved
// GPRs `runtime/sched/switch.bit`'s union-set fix added a save/restore slot
// for, and they are exactly the pair a naive save of "the SysV set" on
// Windows would silently drop (SPEC admits no XMM register name in
// `clobber` — see that file's header — so xmm6..xmm15 cannot be pinned the
// same way and stay argued-by-disassembly, the same accepted limit as
// arm64's d8..d15 below).
@nosplit fn yieldTask(): int {
  asm {
    arm64 {
      0xD2800273, // mov x19, #19
      0xD2800294, // mov x20, #20
      0xD28002B5, // mov x21, #21
    }
    x64 {
      0xBB, 0x03, 0x00, 0x00, 0x00,       // mov ebx, 3
      0x41, 0xBC, 0x0C, 0x00, 0x00, 0x00, // mov r12d, 12
      0x41, 0xBD, 0x0D, 0x00, 0x00, 0x00, // mov r13d, 13
      0xBE, 0x0E, 0x00, 0x00, 0x00,       // mov esi, 14
      0xBF, 0x0F, 0x00, 0x00, 0x00,       // mov edi, 15
    }
    clobber arm64 { x19, x20, x21 }
    clobber x64 { rbx, r12, r13, rsi, rdi }
  }

  disposition = DISP_YIELD
  schedSwitch(taskAt(current), taskAt(workerCtxAddr))

  return asm {
    arm64 {
      0xAA1303E0, // mov x0, x19
      0x8B140000, // add x0, x0, x20
      0x8B150000, // add x0, x0, x21
    }
    x64 {
      0x48, 0x89, 0xD8, // mov rax, rbx
      0x4C, 0x01, 0xE0, // add rax, r12
      0x4C, 0x01, 0xE8, // add rax, r13
      0x48, 0x01, 0xF0, // add rax, rsi
      0x48, 0x01, 0xF8, // add rax, rdi
    }
    result arm64 x0 x64 rax : int
  }
}

// What `yieldTask` must return if the switch preserved the sentinels:
// 19+20+21 on arm64, 3+12+13+14+15 on x64.
@nosplit fn regsExpected(): int {
  return asm {
    arm64 { 0xD2800780 }                 // mov x0, #60
    x64 { 0xB8, 0x39, 0x00, 0x00, 0x00 } // mov eax, 57
    result arm64 x0 x64 rax : int
  }
}

// Non-zero words among a context's register words 3..ctxWords-1.
@nosplit fn ctxRegsSet(ctx: *i64): int {
  let n = 0
  let i = CTX_FIRST_REG
  while (i < ctxWords) {
    if (*(ctx + i) != 0) {
      n = n + 1
    }
    i = i + 1
  }
  return n
}

// P5, worker side: what the context of the task about to be resumed holds.
@nosplit fn ctxSnapshot(ctx: *i64) {
  preSet = ctxRegsSet(ctx)
  preSp = *ctx
  prePc = *(ctx + 1)
  preFp = *(ctx + 2)
}

// P5: yield through `schedSwitchAway`, which zeroes the saved register words
// once this task is resumed. Every register the switch saves past word 2 is
// non-zero first, so the worker can require each of those words to hold
// something and the task can require each to read 0: an offset the clear gets
// wrong, integer or FP, fails here. rsi/rdi carry the call's (non-zero)
// arguments and x30 the return address. `clobber` has no spelling for an FP
// register, so d8..d15 / xmm6..xmm15 are written undeclared: no float is live
// in this task, and the switch restores them as written.
@nosplit fn clearYieldTask() {
  disposition = DISP_YIELD
  asm {
    arm64 {
      0xD2800033, 0xD2800034, 0xD2800035, 0xD2800036, // mov x19..x22, #1
      0xD2800037, 0xD2800038, 0xD2800039, 0xD280003A, // mov x23..x26, #1
      0xD280003B, 0xD280003C,                         // mov x27, x28, #1
      0x2F07E7E8, 0x2F07E7E9, 0x2F07E7EA, 0x2F07E7EB, // movi d8..d11, #-1
      0x2F07E7EC, 0x2F07E7ED, 0x2F07E7EE, 0x2F07E7EF, // movi d12..d15, #-1
    }
    x64 {
      0xBB, 0x01, 0x00, 0x00, 0x00,       // mov ebx, 1
      0x41, 0xBC, 0x01, 0x00, 0x00, 0x00, // mov r12d, 1
      0x41, 0xBD, 0x01, 0x00, 0x00, 0x00, // mov r13d, 1
      0x41, 0xBE, 0x01, 0x00, 0x00, 0x00, // mov r14d, 1
      0x41, 0xBF, 0x01, 0x00, 0x00, 0x00, // mov r15d, 1
      0x66, 0x0F, 0x76, 0xF6,             // pcmpeqd xmm6, xmm6
      0x66, 0x0F, 0x76, 0xFF,             // pcmpeqd xmm7, xmm7
      0x66, 0x45, 0x0F, 0x76, 0xC0,       // pcmpeqd xmm8, xmm8
      0x66, 0x45, 0x0F, 0x76, 0xC9,       // pcmpeqd xmm9, xmm9
      0x66, 0x45, 0x0F, 0x76, 0xD2,       // pcmpeqd xmm10, xmm10
      0x66, 0x45, 0x0F, 0x76, 0xDB,       // pcmpeqd xmm11, xmm11
      0x66, 0x45, 0x0F, 0x76, 0xE4,       // pcmpeqd xmm12, xmm12
      0x66, 0x45, 0x0F, 0x76, 0xED,       // pcmpeqd xmm13, xmm13
      0x66, 0x45, 0x0F, 0x76, 0xF6,       // pcmpeqd xmm14, xmm14
      0x66, 0x45, 0x0F, 0x76, 0xFF,       // pcmpeqd xmm15, xmm15
    }
    clobber arm64 { x19, x20, x21, x22, x23, x24, x25, x26, x27, x28 }
    clobber x64 { rbx, r12, r13, r14, r15 }
  }
  schedSwitchAway(taskAt(current), taskAt(workerCtxAddr))
}

// How many words past 2 this arch's `schedSwitch` saves: x30, x19..x28 and
// d8..d15 on arm64 (3..21); rbx, r12..r15, rsi, rdi and xmm6..xmm15 on x64
// (3..19).
@nosplit fn ctxSavedWords(): int {
  return asm {
    arm64 { 0xD2800260 }                 // mov x0, #19
    x64 { 0xB8, 0x11, 0x00, 0x00, 0x00 } // mov eax, 17
    result arm64 x0 x64 rax : int
  }
}

// P5, task side: 1 when `clearYieldTask`'s `schedSwitchAway` zeroed this task's
// register words on resume and kept sp, pc and fp. The words must have held
// the switch's save when the worker resumed it, every one of them (see
// `clearYieldTask`), or a clear that does nothing would pass.
@nosplit fn ctxClearCheck(): int {
  let ctx = taskAt(current)
  if (preSet != ctxSavedWords()) {
    return 0
  }
  if (ctxRegsSet(ctx) != 0) {
    return 0
  }
  if (*ctx != preSp || *(ctx + 1) != prePc || *(ctx + 2) != preFp) {
    return 0
  }
  return 1
}

// P6: 1 when ten values held across a yield come back intact. No call sits
// between their definition and their use, so nothing but the switch itself can
// disturb them, and the allocator may keep them in any register the switch does
// not declare destroyed. Each is derived from the task's own id and the
// expectation is re-derived from memory AFTER the resume, so a value corrupted
// in a register cannot corrupt the check with it.
@nosplit fn liveAcrossSwitch(): int {
  let id = *(taskAt(current) + taskArg)
  let a = id + 11
  let b = id * 3 + 12
  let c = id * 5 + 13
  let d = id * 7 + 14
  let e = id * 9 + 15
  let g = id * 11 + 16
  let h = id * 13 + 17
  let k = id * 15 + 18
  let x = f64(id) + 0.25
  let y = f64(id) * 2.0 + 0.5

  disposition = DISP_YIELD
  schedSwitch(taskAt(current), taskAt(workerCtxAddr))

  let n = *(taskAt(current) + taskArg)
  // 64n + 116: the coefficients 1+3+..+15 and the constants 11+..+18.
  if (a + b + c + d + e + g + h + k != 64 * n + 116) {
    return 0
  }
  if (x + y != f64(n) * 3.0 + 0.75) {
    return 0
  }
  return 1
}

// Leave for good. Never returns: the worker sees `DISP_DONE` and never queues
// this task again, so nothing will ever switch back to it.
@nosplit fn finishTask() {
  disposition = DISP_DONE
  schedSwitch(taskAt(current), taskAt(workerCtxAddr))
}

// Every task runs this one body and recovers its identity from its own control
// block, exactly as a real trampoline does — a task is entered by a plain
// branch and so can take no arguments.
@nosplit fn taskEntry() {
  // Reserve the probe registers for this whole body: x19..x21 / rbx, r12, r13,
  // rsi, rdi for P2, and the rest of the callee-saved file for P5, whose
  // `clearYieldTask` fills all of it.
  //
  // `yieldTask` writes sentinels into x19/x20/x21 (rbx/r12/r13) and
  // DELIBERATELY does not restore them — restoring is the very thing under
  // test. §11.6's exclusion is per-function, so yieldTask's clobber list says
  // nothing about this function, and without this block the allocator here is
  // free to park a local in one of them and have it overwritten mid-loop.
  //
  // That is not hypothetical: it is the bug this test shipped with for one
  // commit. The seed compiler placed the loop counter `r` in x19, so every task
  // saw `r == 19` after its first yield, left the loop immediately, and the
  // program printed `27 4 4 3` instead of `1776411 12 4 3` — while the
  // self-hosted compiler, which chose a different register, printed the right
  // answer. `./make test` runs both compilers, which is what caught it.
  //
  // The payload is a single `nop`; the block exists only to carry the clobber
  // list, which is the one way to reserve a physical register in Bit.
  asm {
    arm64 { 0xD503201F } // nop
    x64 { 0x90 }         // nop
    clobber arm64 { x19, x20, x21, x22, x23, x24, x25, x26, x27, x28 }
    clobber x64 { rbx, r12, r13, r14, r15, rsi, rdi }
  }

  let id = *(taskAt(current) + taskArg)
  let r = 0
  while (r < ROUNDS) {
    trace = trace * 4 + id
    // P2: one register-file check per yield, TASKS*ROUNDS = 12 in total.
    if (yieldTask() == regsExpected()) {
      checksum = checksum + 1
    }
    clearYieldTask()
    cleared = cleared + ctxClearCheck()
    // Not `live = live + liveAcrossSwitch()`: other tasks bump `live` while this
    // one is switched out, and the left operand would be read before the yield.
    let ok = liveAcrossSwitch()
    live = live + ok
    r = r + 1
  }
  finishTask()
}

// The worker loop: pop, run, requeue if still runnable. FIFO requeue (append at
// the tail, take from the head) is what makes the interleave round-robin.
//
// Bounded by `STEP_LIMIT` rather than looping until the queue drains, so the
// loop's termination is provable by reading it (Power of 10). TASKS*(3*ROUNDS+1)
// = 40 switches are needed (three yields a round, P2, P5 and P6, plus the exit); the limit is comfortably above that, and a scheduler
// that failed to retire its tasks would hit the bound and report a wrong trace
// rather than hang.
fn runWorker() {
  let q = ptrOf(queue)
  let n = 0
  while (n < STEP_LIMIT) {
    let addr = dqPopBottom(q)
    if (addr == 0) {
      return
    }
    current = addr
    ctxSnapshot(taskAt(addr))

    // Poison the probe registers before entering a task.
    //
    // Without this, P2 detects a dropped save/restore only by LUCK — if the
    // switch never touches x19, the task's own sentinel simply stays in the
    // register across the round trip and reads back correct. Detection then
    // depends on whether this loop happens to reuse the register, which is an
    // allocator decision that differs between compilers: mutating away the x19
    // slot was caught under the self-hosted compiler and MISSED under the seed.
    //
    // Writing known-wrong values here removes the luck. While a task is
    // running, these registers demonstrably hold something other than that
    // task's sentinels, so a switch that fails to restore them is caught on
    // every target and under both compilers.
    asm {
      arm64 {
        0xD2801BD3, // mov x19, #222
        0xD28015B4, // mov x20, #173
        0xD28017D5, // mov x21, #190
      }
      x64 {
        0xBB, 0xDE, 0x00, 0x00, 0x00,       // mov ebx, 222
        0x41, 0xBC, 0xAD, 0x00, 0x00, 0x00, // mov r12d, 173
        0x41, 0xBD, 0xBE, 0x00, 0x00, 0x00, // mov r13d, 190
        0xBE, 0xC9, 0x00, 0x00, 0x00,       // mov esi, 201
        0xBF, 0xD1, 0x00, 0x00, 0x00,       // mov edi, 209
      }
      clobber arm64 { x19, x20, x21 }
      clobber x64 { rbx, r12, r13, rsi, rdi }
    }

    // P6: poison the caller-saved file too. x4..x8, x12..x15 (arm64) and r8, r9
    // (x64) are the integer registers the allocator may hand out; d0..d7 / xmm0..
    // xmm5 are filled from the first of them. `clobber` has no spelling for an FP
    // register, so those are written undeclared: this function holds no float,
    // and the stores are the last thing before the switch.
    asm {
      arm64 {
        0xD280B4A4, 0xD280B4A5, 0xD280B4A6, 0xD280B4A7, // mov x4..x7, #0x5a5
        0xD280B4A8, 0xD280B4AC, 0xD280B4AD, 0xD280B4AE, // mov x8, x12..x14
        0xD280B4AF,                                     // mov x15, #0x5a5
        0x9E670080, 0x9E670081, 0x9E670082, 0x9E670083, // fmov d0..d3, x4
        0x9E670084, 0x9E670085, 0x9E670086, 0x9E670087, // fmov d4..d7, x4
      }
      x64 {
        0x41, 0xB8, 0xA5, 0x05, 0x00, 0x00, // mov r8d, 0x5a5
        0x41, 0xB9, 0xA5, 0x05, 0x00, 0x00, // mov r9d, 0x5a5
        0x66, 0x49, 0x0F, 0x6E, 0xC0,       // movq xmm0, r8
        0x66, 0x49, 0x0F, 0x6E, 0xC8,       // movq xmm1, r8
        0x66, 0x49, 0x0F, 0x6E, 0xD0,       // movq xmm2, r8
        0x66, 0x49, 0x0F, 0x6E, 0xD8,       // movq xmm3, r8
        0x66, 0x49, 0x0F, 0x6E, 0xE0,       // movq xmm4, r8
        0x66, 0x49, 0x0F, 0x6E, 0xE8,       // movq xmm5, r8
      }
      clobber arm64 { x4, x5, x6, x7, x8, x12, x13, x14, x15 }
      clobber x64 { r8, r9 }
    }

    schedSwitch(ptrOf(workerCtx), taskAt(addr))
    if (disposition == DISP_YIELD) {
      let requeued = dqPushBottom(q, addr)
      if (!requeued) {
        return
      }
    }
    n = n + 1
  }
}

// Pushes `dqCapacity` opaque tokens; 1 if every push took, 0 otherwise.
// Split out of dequeProps() for the complexity limit, loop unchanged.
fn dqFill(q: *i64): int {
  let i = 0
  let filled = 1
  while (i < dqCapacity) {
    if (!dqPushBottom(q, (i + 1) * 8)) {
      filled = 0
    }
    i = i + 1
  }
  return filled
}

// Pops until the queue reports empty; returns how many entries came out.
// Bounded by dqCapacity + 1 trips either way.
fn dqDrain(q: *i64): int {
  let drained = 0
  let k = 0
  while (k <= dqCapacity) {
    if (dqPopBottom(q) == 0) {
      k = dqCapacity + 1
    } else {
      drained = drained + 1
      k = k + 1
    }
  }
  return drained
}

// P3: the deleted native runtime's `sched` module's Deque test — ordering, the full edge, and the drained edge.
fn dequeProps(): int {
  let q = ptrOf(queue)
  dqInit(q)
  let score = 0

  if (dqPopBottom(q) == 0 && dqSteal(q) == 0) {
    score = score + 1
  }

  // Addresses here are opaque non-zero tokens; the queue never dereferences
  // them, so they need not be real task blocks. 0 is reserved for "empty",
  // hence 8-byte-spaced tokens starting at 8.
  let filled = dqFill(q)
  if (filled == 1 && !dqPushBottom(q, 999999)) {
    score = score + 1
  }

  // Owner pop and steal both take the oldest entry.
  if (dqPopBottom(q) == 8 && dqSteal(q) == 16) {
    score = score + 1
  }

  let drained = dqDrain(q)
  if (drained == dqCapacity - 2 && dqPopBottom(q) == 0) {
    score = score + 1
  }
  return score
}

// P4: global-queue FIFO. Uses real task blocks because `gqPush`/`gqPop` link
// through each task's own `next` word.
fn globalProps(): int {
  let g = ptrOf(overflow)
  gqInit(g)
  let score = 0

  if (gqPop(g) == 0) {
    score = score + 1
  }

  let base = int(ptrOf(tasks))
  let i = 0
  while (i < 3) {
    gqPush(g, base + i * taskWords * 8)
    i = i + 1
  }

  let inOrder = 1
  let k = 0
  while (k < 3) {
    if (gqPop(g) != base + k * taskWords * 8) {
      inOrder = 0
    }
    k = k + 1
  }
  if (inOrder == 1) {
    score = score + 1
  }

  // Draining must reset the tail, or the next push links onto a departed task.
  if (gqPop(g) == 0) {
    gqPush(g, base)
    if (gqPop(g) == base && gqPop(g) == 0) {
      score = score + 1
    }
  }
  return score
}

fn main() {
  // P1/P2: build four tasks on four stacks and run them to completion.
  let stackBase = int(ptrOf(stacks))
  let taskBase = int(ptrOf(tasks))
  workerCtxAddr = int(ptrOf(workerCtx))
  let q = ptrOf(queue)
  dqInit(q)

  let i = 0
  while (i < TASKS) {
    let t = taskAt(taskBase + i * taskWords * 8)
    schedTaskInit(
      t, stackBase + i * STACK_WORDS * 8, STACK_WORDS * 8,
      entryOf(taskEntry), i,
    )
    let _ = dqPushBottom(q, taskBase + i * taskWords * 8)
    i = i + 1
  }

  runWorker()

  // checksum, cleared and live: TASKS * ROUNDS = 12 checks each, all passing.
  print("${trace} ${checksum} ${dequeProps()} ${globalProps()} ${cleared} ${live}\n")
}
