// #4350: `copyBytes`, `rtStringEq`, `rtStringCmp`, `bytesCopy` and `bytesEqual`
// went from one byte per iteration to one 8-byte WORD per iteration whenever
// both ends are 8-aligned, with the 0..7 remainder peeled bytewise.
//
// THE THREE WAYS THAT CHANGE GOES WRONG ARE EACH INVISIBLE TO AN OBVIOUS TEST,
// and every case below exists because a mutation proved the obvious test blind.
//
//   1. OVER-READ. A word loop bounded by `(n + 7) >> 3` instead of `n >> 3`
//      consumes the final PARTIAL word. Comparing two freshly allocated strings
//      cannot see it: an allocation's body is zeroed (ABI.md §1), so the bytes
//      past the length are 0 on both sides and the extra word compares equal.
//      `beyondTheView` is the case that does see it — a string VIEW whose
//      BACKING continues past the view's own length, with the backing differing
//      outside the view. Both mutants that read a partial word then answer
//      "unequal" for two equal strings. Without this family, a `(n + 7) >> 3`
//      bound SURVIVES the whole file.
//
//   2. BYTE ORDER, and only for ORDERING. Two little-endian words compared as
//      integers give the wrong sign, because the low-address byte is the LEAST
//      significant one. `oppositeDiffs` is what catches it: a pair differing at
//      TWO positions in the same word, in OPPOSITE directions, so the correct
//      answer is decided by the earlier byte and a word compare is decided by
//      the later one. A pair differing at ONE position orders the same either
//      way — so a single-mismatch corpus, including one at the last byte,
//      SURVIVES a fully inverted comparison. `highBytes` adds the second half
//      of the trap: an alphabet straddling 0x7f/0x80, so a SIGNED word compare
//      flips sign where an unsigned byte compare does not.
//
//   3. A LOST TAIL or an OVER-WRITE. `bulkBytes` copies into a zeroed buffer at
//      every source and destination residue and checks the 8 bytes PAST the
//      requested length are still zero, so a loop that writes a whole final
//      word is caught by content rather than by a fault.
//
// ALIGNMENT IS TESTED, NOT ASSUMED. `wordAt` masks its argument to an 8-byte
// boundary and Bit has no unaligned word load (SPEC §11.4: `*i64` arithmetic
// scales by 8 and there is no pointer-to-pointer conversion), so the word path
// is guarded by `((pa | pb) & 7) == 0` and an unaligned pair must fall back to
// the bytewise loop and still answer identically. `viewAt` produces a string
// view at every residue 0..7 by slicing past a pad, exactly the way
// `allocStringView` makes an unaligned byte pointer in a real program.
//
// WHAT THIS FIXTURE CANNOT CATCH, said plainly: an over-READ in a COPY. Reading
// past the source never changes the destination, so no output distinguishes it;
// only a source ending exactly on a page boundary would, and that address cannot
// be arranged from Bit. The bound is held by review of `n >> 3` in the source.
//
// The output is one line: the case count and a rolling checksum over EVERY
// verdict. A count alone would not do — a comparison that stopped early still
// gets counted.
import { newBuilder } from "std/strings"

extern fn bit_rt_bytes_copy(dst: *byte, src: *byte, n: int)
extern fn bit_rt_bytes_equal(a: *byte, b: *byte, n: int): bool

let chk: i64 = 0
let cases: i64 = 0

// Fold one verdict into the rolling checksum. Every assertion goes through here.
fn note(v: i64) {
  chk = (chk * 131 + v + 7) % 1000000007
  cases = cases + 1
}

// A string of `n` bytes. `hi` selects an alphabet straddling 0x7f/0x80 (120..135)
// instead of 'a'..'w'; the byte at `p1` is bumped up by one and the byte at `p2`
// down by one, either index skipped when negative.
fn mkStr(n: int, hi: bool, p1: int, p2: int): string {
  let b = newBuilder()
  let i = 0
  while (i < n) {
    let c = 97 + i % 23
    if (hi) {
      c = 120 + i % 16
    }
    if (i == p1) {
      c = c + 1
    }
    if (i == p2) {
      c = c - 1
    }
    b.writeByte(u8(c))
    i = i + 1
  }
  return b.toString()
}

// `s`'s content as a VIEW whose byte pointer sits at residue `k` mod 8.
// `pad + s` is a fresh allocation, so its bytes start 8-aligned; slicing `k` in
// lands on residue `k`.
fn viewAt(s: string, k: int): string {
  let pad = mkStr(k, false, -1, -1)
  let joined = pad + s
  return joined[k:len(joined)]
}

// Three-way order as a small integer, so an inverted comparison moves the
// checksum rather than merely a boolean.
fn ord(a: string, b: string): i64 {
  if (a < b) {
    return 1
  }
  if (a > b) {
    return 2
  }
  return 3
}

// The bytes of `s`, position-weighted — proves a copy moved CONTENT, not length.
fn byteSum(s: string): i64 {
  let t: i64 = 0
  let i = 0
  while (i < len(s)) {
    t = t + i64(s[i]) * i64(i + 1)
    i = i + 1
  }
  return t % 1000000007
}

// Both directions of eq and cmp for one pair, plus the concatenation that runs
// the pair's bytes through `copyBytes` at their own alignments.
fn probe(a: string, b: string) {
  let e: i64 = 0
  if (a == b) {
    e = 1
  }
  note(e)
  note(ord(a, b))
  note(ord(b, a))
  let j = a + b
  note(i64(len(j)))
  note(byteSum(j))
}

// Every length 0..33 against itself and against a copy differing at each single
// byte position, both operands 8-aligned so the WORD path runs.
fn alignedLengths() {
  let n = 0
  while (n <= 33) {
    let a = mkStr(n, false, -1, -1)
    probe(a, mkStr(n, false, -1, -1))
    let p = 0
    while (p < n) {
      probe(a, mkStr(n, false, p, -1))
      p = p + 1
    }
    n = n + 1
  }
}

// TRAP 2. Pairs differing at two positions in OPPOSITE directions: `a` is above
// the base at `i` and below it at `j`, so the correct order is decided by
// whichever index is smaller while a little-endian word compare is decided by
// whichever is larger. Run over both alphabets and across a word boundary.
fn oppositeDiffs() {
  let n = 8
  while (n <= 24) {
    oppositeAtLength(n, false)
    oppositeAtLength(n, true)
    n = n + 8
  }
}

fn oppositeAtLength(n: int, hi: bool) {
  let base = mkStr(n, hi, -1, -1)
  let i = 0
  while (i < n) {
    let j = i + 1
    while (j < n) {
      probe(base, mkStr(n, hi, i, j))
      probe(base, mkStr(n, hi, j, i))
      j = j + 1
    }
    i = i + 1
  }
}

// TRAP 2, second half. The `hi` alphabet alone, every single-byte difference,
// so a signed word compare crossing 0x7f/0x80 flips a sign an unsigned byte
// compare does not.
fn highBytes() {
  let n = 0
  while (n <= 17) {
    let a = mkStr(n, true, -1, -1)
    probe(a, mkStr(n, true, -1, -1))
    let p = 0
    while (p < n) {
      probe(a, mkStr(n, true, p, -1))
      probe(viewAt(a, p % 8), viewAt(mkStr(n, true, p, -1), (p + 5) % 8))
      p = p + 1
    }
    n = n + 1
  }
}

// TRAP 1. A view of length `L` over a backing of `L + 8` bytes, against a view
// of the same content whose BACKING differs at one position past `L`. The two
// views are equal; anything that reads the final partial word says otherwise.
fn beyondTheView() {
  let n = 0
  while (n <= 17) {
    let base = mkStr(n + 8, false, -1, -1)
    let a = base[0:n]
    let k = 0
    while (k < 8) {
      let other = mkStr(n + 8, false, n + k, -1)
      probe(a, other[0:n])
      probe(a, viewAt(other[0:n], k))
      k = k + 1
    }
    n = n + 1
  }
}

// Every (source, other) residue pair 0..7 for a spread of lengths, with the
// mismatch on the LAST byte and on the FIRST.
fn everyAlignment() {
  let n = 0
  while (n <= 17) {
    let ka = 0
    while (ka < 8) {
      alignmentRow(n, ka)
      ka = ka + 1
    }
    n = n + 1
  }
}

fn alignmentRow(n: int, ka: int) {
  let kb = 0
  while (kb < 8) {
    let a = viewAt(mkStr(n, false, -1, -1), ka)
    probe(a, viewAt(mkStr(n, false, -1, -1), kb))
    if (n > 0) {
      probe(a, viewAt(mkStr(n, false, n - 1, -1), kb))
      probe(a, viewAt(mkStr(n, false, 0, -1), kb))
    }
    kb = kb + 1
  }
}

// Unequal lengths sharing a prefix: the shorter must order first, and the word
// loop must not read the longer string's extra bytes into the verdict.
fn prefixLengths() {
  let n = 0
  while (n <= 33) {
    let short = mkStr(n, false, -1, -1)
    let long = mkStr(n + 1, false, -1, -1)
    probe(short, long)
    probe(viewAt(short, n % 8), viewAt(long, (n + 3) % 8))
    n = n + 1
  }
}

// `bit_rt_bytes_copy` / `bit_rt_bytes_equal` directly, at every source and
// destination residue 0..7 and every length 0..33. `ptrOf(buf) + k` is exactly
// how `stdlib/crypto` and `stdlib/http/trustcache` reach these.
fn bulkBytes() {
  let src: []byte = []byte(64)
  let dst: []byte = []byte(64)
  let i = 0
  while (i < 64) {
    src[i] = u8(33 + i % 90)
    i = i + 1
  }
  let n = 0
  while (n <= 33) {
    bulkAtLength(src, dst, n)
    n = n + 1
  }
}

// One length across all 64 residue pairs, kept out of `bulkBytes` so neither
// function carries four nested loops.
fn bulkAtLength(src: []byte, dst: []byte, n: int) {
  let ks = 0
  while (ks < 8) {
    let kd = 0
    while (kd < 8) {
      let j = 0
      while (j < 64) {
        dst[j] = 0
        j = j + 1
      }
      bit_rt_bytes_copy(ptrOf(dst) + kd, ptrOf(src) + ks, n)
      note(bulkVerdict(src, dst, n, ks, kd))
      kd = kd + 1
    }
    ks = ks + 1
  }
}

// Whether `dst[kd:kd+n]` received `src[ks:ks+n]` and NOTHING outside it, folded
// with what `bit_rt_bytes_equal` says about the same range. The out-of-range
// check catches an over-write: a loop that stores a whole final word clobbers
// up to 7 bytes past `n`.
fn bulkVerdict(src: []byte, dst: []byte, n: int, ks: int, kd: int): i64 {
  let v: i64 = 0
  let j = 0
  while (j < n) {
    if (dst[kd + j] != src[ks + j]) {
      v = v + 1
    }
    j = j + 1
  }
  let spill = 0
  while (spill < 8) {
    if (kd + n + spill < 64 && dst[kd + n + spill] != u8(0)) {
      v = v + 1000
    }
    spill = spill + 1
  }
  if (bit_rt_bytes_equal(ptrOf(dst) + kd, ptrOf(src) + ks, n)) {
    v = v + 1000000
  }
  return v
}

fn main() {
  alignedLengths()
  oppositeDiffs()
  highBytes()
  beyondTheView()
  everyAlignment()
  prefixLengths()
  bulkBytes()
  print("${cases} ${chk}\n")
}
