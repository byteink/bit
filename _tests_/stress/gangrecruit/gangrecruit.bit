// #5842: one mutator, eight workers, so every collection wakes the seven idle
// workers into the helper gang and they mark and sweep beside the collector.
//
// A woken worker joins from its `blocked` wait and must stay in that wait
// until the stop clears. One that leaves early did not change this program's
// output in any measured run.
// What catches it is the runtime's own check, `worldGangCheckLeft`
// (runtime/gc/gcworldstop.bit), which ends the process with "gc: a gang
// helper left an open stop". Measured with the wait skipped after a join:
// this program's BIT_GC=stress run died that way 5 of 5 times. Before that
// check existed, `maprace` and every `_tests_/stress/parallel` program passed
// under the same defect.
//
// `workers` pins BIT_WORKERS=8. At the default of one worker there is no idle
// worker, so the gang has no recruit and the path under test never runs.
//
// The live `keep` slice spans every collection so the parallel mark has a
// graph to trace; each round's slice is garbage the parallel sweep
// frees. The sums prove both survived intact.
class Box { v: i64 }
class Node { v: i64, box: Box }

fn build(n: i64, base: i64): []Node {
  let out = []Node(0, n)
  let i = 0
  while (i < n) {
    out = append(out, Node{ v = base + i, box = Box{ v = i } })
    i = i + 1
  }
  return out
}

fn total(nodes: []Node): i64 {
  let s = 0
  for nd of nodes {
    s = s + nd.v + nd.box.v
  }
  return s
}

fn main() {
  let keep = build(1000, 1)
  let junkSum = 0
  let r = 0
  while (r < 20) {
    junkSum = junkSum + total(build(500, r))
    r = r + 1
  }
  print("keep=${total(keep)} junk=${junkSum}\n")
}
