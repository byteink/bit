// The per-task PANIC BOUNDARY (#4742, epic #4739), exercised as a real linked
// binary — the only thing that can catch a wrong offset or a wrong register in
// `runtime/sched/boundary.bit`'s two hand-encoded halves, which no gate reads.
//
// WHY THE EXTERNS ARE DECLARED HERE rather than imported: pass 1 of the epic
// keeps every caller of these symbols inside `libbitrt` (see docs/development.md
// on the two-pass extern rule and `bit_rt_fs_read_all_failed`'s history — a
// stdlib module naming a `bit_rt_*` symbol the PINNED stage0 archive lacks fails
// a clean-tree build with E0078, and repinning cannot fix it). A local `extern
// fn` in a test program is legal in any module — `runtime/chan/chanwrap.bit`
// does exactly this — links against the freshly built archive, and needs no
// stdlib surface. `std/runtime`'s `runRecovering` is child F, after a repin.
//
// WHAT THIS PROVES, and what it cannot:
//
//   (a) A resume returns 1 FROM THE ARM CALL SITE, in the arming frame, with
//       the frames between the panic site and the boundary discarded. `guarded`
//       recurses `depth` frames deep before consulting the boundary, so a
//       resume that restored the wrong `sp` lands in the middle of that
//       recursion instead of in `main` and cannot print the line below.
//   (b) The `{code, msg}` pair survives the resume verbatim. `msg` here is a
//       plain sentinel word rather than a real `*const RtBytes`: the boundary
//       core stores and returns the word without dereferencing it, and the door
//       that supplies a real one is #4743.
//   (c) A CALLEE-SAVED REGISTER LIVE ACROSS THE GUARDED CALL survives it.
//       `keep` is read after the resume, so the compiler must hold it somewhere
//       the restore has to get right — this is the half `gcSaveCalleeRegs` does
//       not have to solve and the one a wrong save/restore offset corrupts.
//   (d) An ordinary call made AFTER the resume returns normally, which is the
//       claim that the stack pointer, frame pointer and link register were all
//       restored consistently and not just enough to reach one `print`.
//   (e) The unarmed path is unchanged. With `BIT_PANICBOUNDARY_UNARMED=1` the
//       program never arms, `bit_rt_panic_boundary_take` answers 0, and the
//       program takes the ordinary `panic` door: `panic: <msg>` on fd 2 and
//       exit 2. The stress harness runs the armed form (this file's
//       `.expected`); the unarmed form is a one-line manual run, since the
//       harness compares stdout on an exit-0 program.
//
// It does NOT prove anything about the panic doors: nothing in `runtime/root`
// consults the boundary yet (#4743), so `guarded` plays the door's part itself.

// Words in a boundary record: `bndWords` in runtime/sched/boundary.bit — 22
// context words (`ctxWords`, runtime/sched/sched.bit) plus prev/code/msg.
const recWords: int = 25

// How deep below the boundary the panic is raised. Any depth proves the same
// thing; several frames make a wrong `sp` land somewhere visibly wrong rather
// than one frame off.
const guardDepth: int = 4

// The sentinel this program hands `take` as the panic's `msg`, and gets back
// through `bit_rt_panic_boundary_msg`. Not a pointer: see (b) above.
const msgSentinel: int = 0x5A17

// The reason code, §12.1's 0 — "a message-carrying panic".
const codeSentinel: int = 0

// The value held live across the guarded call, checked after the resume (c).
const keepSentinel: int = 987654321

extern fn bit_rt_panic_boundary_arm(rec: int): int
extern fn bit_rt_panic_boundary_disarm()
extern fn bit_rt_panic_boundary_take(code: int, msg: int): int
extern fn bit_rt_panic_boundary_code(): int
extern fn bit_rt_panic_boundary_msg(): int

// The panicking call: `depth` frames of recursion, then the consult a real
// panic door will make. `take` does not return when a boundary is armed — it
// resumes in `main`. When none is armed it returns 0 and this takes the
// ordinary panic door, which is case (e).
fn guarded(depth: int): int {
  if (depth > 0) {
    let inner = guarded(depth - 1)
    return inner + 1
  }
  let taken = bit_rt_panic_boundary_take(codeSentinel, msgSentinel)
  if (taken == 0) {
    panic("panicboundary: no boundary")
  }
  return -1
}

// An ordinary call, made after the resume — case (d).
fn quiet(n: int): int {
  let total = 0
  let i = 0
  while (i < n) {
    total = total + i
    i = i + 1
  }
  return total
}

fn main() {
  let unarmed = osEnv("BIT_PANICBOUNDARY_UNARMED") == "1"
  // The record: `bndWords` words the boundary owns for the life of the guarded
  // call. ABI.md §12 puts it on the arming function's own frame; a slice this
  // function holds live is the same guarantee expressed in the one way a Bit
  // program can take the address of memory it owns (§11.5's `ptrOf`), and the
  // scratch word holding it is itself scanned conservatively
  // (`stwScanScratch`, runtime/stw/stwscan.bit), so it cannot be swept while a
  // boundary names it.
  let rec = []i64(recWords)
  let keep = keepSentinel
  let armed = 0
  if (!unarmed) {
    armed = bit_rt_panic_boundary_arm(int(ptrOf(rec)))
  }
  if (armed == 0) {
    // Either the arm itself (armed == 0 is its normal-path answer) or the
    // unarmed run. Both go down the guarded call; only the unarmed one comes
    // back, and it comes back through `panic`, not through here.
    let got = guarded(guardDepth)
    print("unreachable ${got}\n")
    return
  }
  // Reached only by a resume: `armed` is the 1 the arm call site yields the
  // second time (a).
  let code = bit_rt_panic_boundary_code()
  let msg = bit_rt_panic_boundary_msg()
  bit_rt_panic_boundary_disarm()
  print("resumed ${armed} code ${code} msg ${msg}\n")
  print("keep ${keep} quiet ${quiet(10)}\n")
  // A trailing read of the record, so its rooting does not depend on the stack
  // map happening to widen this binding's live interval (#4097).
  print("rec ${len(rec)} taken ${bit_rt_panic_boundary_code()}\n")
}
