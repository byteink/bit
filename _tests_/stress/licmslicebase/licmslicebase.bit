// #8640: the only owner is a nonzero-offset view passed as a temporary.
// The loop allocates nothing; backedge polls must still root its real header
// after LICM replaces repeated buffer/offset reads with an interior i64 base.
class Junk { value: int }
class Empty { xs: []i64 }

fn view(n: int): []i64 {
  let xs = []i64(n + 2)
  let i = 0
  while (i < n + 2) {
    xs[i] = i64(i)
    i = i + 1
  }
  return xs[1:n + 1]
}

fn sum(xs: []i64): i64 {
  let total: i64 = 0
  let i = 0
  while (i < len(xs)) {
    total = total + xs[i]
    xs[i] = xs[i] + 1
    i = i + 1
  }
  return total
}

fn sumUnsigned(xs: []u64): u64 {
  let total: u64 = 0
  let i = 0
  while (i < len(xs)) {
    total = total + xs[i]
    xs[i] = xs[i] + u64(1)
    i = i + 1
  }
  return total
}

fn sumFloat(xs: []f64): f64 {
  let total = 0.0
  let i = 0
  while (i < len(xs)) {
    total = total + xs[i]
    xs[i] = xs[i] + 1.0
    i = i + 1
  }
  return total
}

fn main() {
  let total: i64 = 0
  let r = 0
  while (r < 8) {
    total = total + sum(view(128))
    let junk = []Junk(64)
    let i = 0
    while (i < len(junk)) {
      junk[i] = Junk{ value = i + r }
      i = i + 1
    }
    assert(junk[63].value == 63 + r)
    r = r + 1
  }
  let empty = []i64(0)
  assert(sum(empty) == 0)
  assert(sum(Empty{}.xs) == 0)
  let xs = view(4)
  let alias = xs[1:3]
  assert(sum(alias) == 5)
  assert(xs[1] == 3 && xs[2] == 4)
  assert(sum(xs) == 12)
  let us = [u64(1), u64(2), u64(3), u64(4)]
  assert(sumUnsigned(us[1:3]) == u64(5) && us[1] == u64(3))
  let fs = [1.0, 2.0, 3.0, 4.0]
  assert(sumFloat(fs[1:3]) == 5.0 && fs[1] == 3.0)
  print("${total}\n")
}
