// The Darwin OS-thread provider (runtime/thread/darwin, #1403) against the real
// system: `pthread_create` through libSystem, a child entered by an ordinary C
// call, and a bounded join.
//
// Darwin-only by construction, hence the sibling `darwin-only` marker file: the
// provider declares `extern function`s (SPEC §11.7), which the compiler rejects
// on both Linux targets with E0078 — even for an uncalled declaration, since
// the ELF output is fully static.
//
// The properties, the timing bounds, and the discrimination argument behind
// each are documented in ./../thread/props. This file supplies only the one
// piece that cannot be shared: the waker child, which must call THIS platform's
// `parkWake`.
//
// This program is kept identical in shape to its Linux twin, so that a future
// divergence between the two means a real platform difference rather than a
// spelling one.
//
// It prints only a bool and an int, both derived from arithmetic rather than
// from an `extern function` result, which keeps it clear of #1409 (interpolating
// an extern-derived value corrupts earlier slots when a later slot allocates,
// under BIT_GC=stress, Darwin only). The provider's extern results are consumed
// as control flow inside the property checks and never reach an interpolation.

import { threadProps, threadTotal, threadWakeDelayNs, i32At, i64At } from "../thread/props"
import { threadStart, threadRelease } from "../../../runtime/thread/darwin"
import { parkWait, parkWake, parkSleepNs, parkMonoNs } from "../../../runtime/park/darwin"

// P4's child: sleep long enough that the parent is genuinely blocked in
// `parkWait`, then wake it, then report done.
//
// CLEARING `done` IS MANDATORY ON THIS PLATFORM, unlike on Linux. pthreads has
// no equivalent of `CLONE_CHILD_CLEARTID`, so nothing else can clear it and a
// child that returned without doing so would strand every joiner until its
// deadline. It is the last thing the body does, after the wake it is reporting.
//
// THIS BODY IS NOT `@nosplit`, AND THAT IS ONLY SAFE BECAUSE IT HAS NO LOOP —
// see the Linux twin for the full argument; it applies unchanged here.
// `parkSleepNs` takes a caller-owned 2-word scratch (#2318). `wakeChild` runs
// on its own OS thread and no other thread touches this word, so a plain
// module-level array is safe here.
let sleepScratch: [2]i64

fn wakeChild(arg: *byte): *byte {
  let base = int(arg)
  let done = i32At(int(*i64At(base)))
  let word = i32At(int(*i64At(base + 8)))

  parkSleepNs(threadWakeDelayNs, ptrOf(sleepScratch))
  let woke = parkWake(word, true)
  atomicStore(done, i32(0))
  return nil
}

// `threadProps` takes `sleepFn`/`waitFn` as the generic `(int) => ()` /
// `(*i32, i32, int) => int` shapes shared with the Linux twin (both must fit
// through the same call, since one copy of `threadProps` runs on either
// platform) — `parkSleepNs` no longer fits it directly now that it takes a
// caller-owned scratch (#2318), and `parkWait` no longer fits directly for
// the same reason (#3914). Both adapt back using this thread's own scratch,
// which nothing else on this OS thread touches concurrently, and never
// concurrently with each other since `threadProps` calls them sequentially
// on this one thread. `parkMonoNs` is unchanged on Darwin (its timebase
// ratio is cached, not per-call scratch) and still fits `() => int` as-is.
let mainSleepScratch: [2]i64

fn sleepAdapt(ns: int) {
  parkSleepNs(ns, ptrOf(mainSleepScratch))
}

fn waitAdapt(p: *i32, expected: i32, timeoutNs: int): int {
  return parkWait(p, expected, timeoutNs, ptrOf(mainSleepScratch))
}

fn main() {
  let props = threadProps(
    threadStart, threadRelease, waitAdapt, sleepAdapt,
    parkMonoNs, entryOf(wakeChild),
  )
  let total = threadTotal()
  let ok = props == total
  print("${ok} ${props}\n")
}
