// Portable half of the #1368 verification: `secureZero` (runtime/rand) and
// `strlen` (runtime/shims). Neither needs an OS-specific primitive, so this
// program builds and runs on every target — unlike the entropy sources, which
// live in `randdarwin` and `randlinux` because §11.7 and §11.8 are mutually
// exclusive per target.
//
// The property machinery is in `props/`, shared with those two programs so the
// guard-band regime cannot drift between platforms.

import { zeroProps, zeroTotal, bytePtr } from "./props"
import { strlenScan } from "../../../runtime/shims/scan"

// One `strlen` KAT: `n` bytes of 'A', a NUL, then 0xFF filler.
//
// The filler is the point. A scan that mishandles the terminator — reading a
// word at a time, or comparing the wrong byte — runs on into the 0xFF bytes
// and returns a length larger than `n`. Filling the tail with zeroes instead
// would let exactly that bug pass.
fn checkStrlenOne(n: int): bool {
  let tail = 16
  let total = n + 1 + tail
  let backing = []i64((total + 7) / 8)
  let base = bytePtr(backing)
  let i = 0
  while (i < total) { // bounded by `total`
    let q = base + i
    *q = u8(255)
    i = i + 1
  }
  let k = 0
  while (k < n) { // bounded by `n`
    let q = base + k
    *q = u8(65)
    k = k + 1
  }
  let t = base + n
  *t = u8(0)
  return int(strlenScan(base)) == n
}

// Lengths either side of the 8-byte word boundary, plus the empty string —
// the case where the very first byte is the terminator.
fn strlenLengths(): []int {
  return []int{0, 1, 7, 8, 9, 20}
}

fn strlenProps(): int {
  let pass = 0
  let i = 0
  while (i < len(strlenLengths())) { // bounded by the fixed sweep
    if (checkStrlenOne(strlenLengths()[i])) {
      pass = pass + 1
    }
    i = i + 1
  }
  return pass
}

fn main() {
  // One deterministic line encoding the program's own correctness: each pair
  // is passed/total, so a check that never ran is as visible as one that
  // failed.
  print("rand zero=${zeroProps()}/${zeroTotal()} strlen=${strlenProps()}/${len(strlenLengths())}\n")
}
