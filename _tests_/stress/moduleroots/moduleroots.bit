// #6481: a traced module `let` is a collector root. The only reference to every
// object below lives in a module cell, filled inside `main` (a startup
// initializer is #6480's), so nothing a stack map, a task block or another
// object names keeps it alive. Under `BIT_GC=stress` (this corpus's harness runs
// each program under it) a collection runs at every allocation, and the churn
// between the writes and the reads reuses the freed slots of exactly the sizes
// the live objects have. A collector that does not scan the cells hands those
// slots back, and the read-back below sees another object's bytes.
//
// The mutation, run through the compiled binary and not a rebuild: call
// `bit_rt_module_roots_register(0)` first in `main` (an `extern fn` of the
// pinned runtime symbol), which empties the table the entry function installed.
// Under stress the program then reads a freed object: it prints a mismatch or
// dies on a bus error. Without that call it prints `ok`.
import { exit } from "std/os"

class Item {
  id: int,
  name: string,
}

let held: []Item
let label: string
let slotA: string
let slotB: string
let nested: []Item

const count: int = 64
const churnRounds: int = 3000

fn itemName(i: int): string {
  return "item-${i}-${i * 7}"
}

// Allocates objects of the sizes the live data has, and drops them at once.
fn churn(n: int) {
  let i = 0
  while (i < n) {
    let junk = Item{ id = -1, name = "junk-${i}" }
    let buf = []Item(4)
    buf[0] = junk
    i = i + 1
  }
}

fn fill() {
  let i = 0
  while (i < count) {
    held = append(held, Item{ id = i, name = itemName(i) })
    i = i + 1
  }
  label = "label-${count}-${count * 3}"
  slotA = "slot-a-${count}"
  slotB = "slot-b-${count}"
  nested = []Item(2)
  nested[1] = Item{ id = 900, name = "nested" }
}

fn failed(what: string): bool {
  print("moduleroots: ${what} corrupted\n")
  return true
}

fn check(): bool {
  let bad = false
  let i = 0
  while (i < count) {
    if (held[i].id != i || held[i].name != itemName(i)) {
      bad = failed("held[${i}]")
    }
    i = i + 1
  }
  if (label != "label-${count}-${count * 3}") {
    bad = failed("label")
  }
  if (slotA != "slot-a-${count}" || slotB != "slot-b-${count}") {
    bad = failed("slots")
  }
  if (nested[1].id != 900 || nested[1].name != "nested") {
    bad = failed("nested")
  }
  return bad
}

fn main() {
  fill()
  churn(churnRounds)
  if (check()) {
    exit(1)
  }
  print("ok\n")
}
