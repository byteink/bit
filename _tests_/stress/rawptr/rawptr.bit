// Raw untraced pointer `*T` under the collector (#1355). A `*T` holds a machine
// address the GC must NEVER follow — unlike every other reference type ([]T,
// structs, chan …) it is is_ref=0, so its word stays out of every object's
// pointer map. This is the foundation of the Stage-2 unmanaged subset: the
// collector's own metadata, once ported to Bit, must not be walked by the
// collector.
//
// Two properties, both deterministic:
//   (a) round-trip — a fabricated address goes into a `*T` (via pointer
//       arithmetic off the null pointer) and comes back out unchanged as an
//       int. `*byte` scales arithmetic by 1, so the offset IS the address.
//   (b) non-trace — a LIVE class's `*byte` field holds a wild, non-heap address
//       across 200000 allocations. Run under BIT_GC=stress the collector fires
//       at every safepoint; the class is a root each time, yet its wild word is
//       never treated as a pointer (it is not in Cell's pointer map), so the
//       program neither crashes nor corrupts and the checksum is exact.
//
// Sum of tags 0..199999 = 199999 * 200000 / 2 = 19999900000.
class Cell { p: *byte, tag: i64 }

fn main() {
  // (a) an int address round-trips through a *byte unchanged.
  let base: *byte = nil
  let p = base + 4660 // address 0x1234
  let ok = 0
  if (int(p) == 4660) {
    ok = 1
  }

  // (b) hold a wild address in a live class's *byte field while churning
  // garbage; the field must not be traced.
  let keep = Cell{ p: base + 305419896, tag: 12345 } // wild address 0x12345678
  let i = 0
  let sink = 0
  while (i < 200000) {
    let junk = Cell{ p: nil, tag: i }
    sink = sink + junk.tag
    i = i + 1
  }
  print("${ok} ${keep.tag} ${sink}\n")
}
