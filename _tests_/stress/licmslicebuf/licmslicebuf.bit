// #4053: a loop whose slice ELEMENT-BUFFER POINTER is hoisted into its
// preheader, so the raw `buf` address lives in a register or a spill slot
// across every safepoint the loop contains — including the back-edge poll,
// which under `BIT_GC=stress` collects on EVERY iteration.
//
// Nothing describes that pointer to the collector: it is an `i64`, so
// `isRefType` is false for it and no stack map lists it (ABI.md §4). What keeps
// the buffer alive is the slice HEADER — ref-typed, the loop's invariant block
// parameter, live across the back edge, and therefore in the stack map at the
// poll — plus `riSliceOffs` tracing word 0. `sum`'s loop keeps NO other use of
// the header at all, which is the shape the argument rests on; on `main` the
// same loop still re-reads `xs.buf` every iteration and the header is used
// directly.
//
// `sum` IS CALLED ON A TEMPORARY, so the caller holds no reference of its own.
// The outer loop churns the heap between rounds so a wrongly-freed buffer is
// handed straight back out rather than sitting untouched and reading correct.
//
// WHAT THIS CAN AND CANNOT SEE. It is a regression guard on the SHAPE, not a
// detector: `stwScanTasks` (runtime/stw/stw.bit) also scans the running task's
// stack range conservatively, and a slice buffer's word-0 address is a body
// address, so `gcMarkConservative` retains it there too. Disabling that scan
// makes this program segfault under `BIT_GC=stress` and exit 0 without it — so
// the detection is real, it is just currently masked by a second net. If that
// net is ever narrowed, this is the case that must still pass.
class Node { a: i64, b: i64 }

fn build(n: int): []i64 {
  let xs = []i64(n)
  let i = 0
  while (i < n) {
    xs[i] = i + 1
    i = i + 1
  }
  return xs
}

// No call, no allocation, one `index_get` and one `index_set`, so
// `licmClobbers` lets `buf`, `off` and `len` all leave the loop.
fn sum(xs: []i64): int {
  let t = 0
  let i = 0
  while (i < len(xs)) {
    t = t + xs[i]
    xs[i] = xs[i] + 1
    i = i + 1
  }
  return t
}

fn main() {
  let total = 0
  let junk = []Node(0)
  let r = 0
  while (r < 12) {
    total = total + sum(build(2048))
    junk = []Node(0)
    let g = 0
    while (g < 256) {
      junk = append(junk, Node{ a: g, b: r })
      g = g + 1
    }
    r = r + 1
  }
  print("${total} ${len(junk)}\n")
}
