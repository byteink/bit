// #3447: a map<K,V> whose keys ADVANCE while old keys are DELETED must not
// retain memory for every key ever inserted.
//
// `rtMapSet`'s grow trigger fires off `used` (FULL+TOMB slots), not the live
// count, so a stream of advancing keys with a pinned live set trips it purely
// from tombstone buildup -- `len(m)` never grows. Before the fix, `mapGrow`
// doubled `cap` on EVERY such trigger, so capacity grew monotonically with
// total insertions instead of with the live set: 8M advancing insert+delete
// pairs with 5000 always live reached 62.8 MB, against 3.8 MB at 10k. This
// drives `runtime/root`'s map entry points directly (the rootbit.bit style)
// so the regression is a deterministic CAPACITY bound, not a wall-clock RSS
// sample: `mapCap` after `churnIters` more advancing-key insert+delete pairs
// must be EXACTLY the capacity the live set alone already required, proving
// no rehash past warmup ever needed to double `cap` again.
//
// NOTHING HERE BINDS MEMORY OR CALLS `rootInit`: against the Bit-sourced
// runtime (the only one this repo ships, #1593), `rootBooted()` is already
// true by the time `main` runs -- `boot()` ran it -- so `rtMapNew` and its
// siblings can be called directly, exactly as ordinary `map<K,V>` syntax
// would reach them.

import { loadWord } from "../../../runtime/gc"
import { rtMapNew, rtMapSet, rtMapDelete, rtMapLen, mapCap } from "../../../runtime/root"

// Pinned live-set size, matching the #3447 repro.
const liveTarget: int = 5000

// Advancing-key insert+delete pairs run AFTER the live set first fills.
// Large enough that the unfixed code -- which doubles `cap` on every
// tombstone-driven trigger -- goes through several doublings well within
// this many iterations (the first trigger alone needs on the order of
// `liveTarget` more insertions past warmup); the fixed code's `cap` is
// provably constant once the live count stops changing, regardless of how
// many more iterations run.
const churnIters: int = 20000

fn main() {
  let m = rtMapNew(0, 0)          // scalar int keys, scalar int values

  // Warm up: fill to the pinned live-set size. No deletes yet, so this
  // growth is driven by the live count alone, identically before and after
  // the fix.
  let i = 0
  while (i < liveTarget) {
    rtMapSet(m, i, i)
    i = i + 1
  }
  let capAfterWarmup = loadWord(m + mapCap)

  // Advancing keys + delete: `i` grows without bound, `i - liveTarget` is
  // deleted every step, so the live set stays pinned at `liveTarget`
  // throughout, and the map churns through many more DISTINCT keys than it
  // ever holds at once.
  let n = liveTarget + churnIters
  while (i < n) {
    rtMapSet(m, i, i)
    rtMapDelete(m, i - liveTarget)
    i = i + 1
  }
  let capAfterChurn = loadWord(m + mapCap)

  let liveLen = rtMapLen(m)
  let lenOk = liveLen == liveTarget
  let capOk = capAfterChurn == capAfterWarmup
  print("len=${liveLen} lenOk=${lenOk} capBefore=${capAfterWarmup} capAfter=${capAfterChurn} capOk=${capOk}\n")
}
