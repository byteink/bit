// `extern function` (SPEC §11.7, #1371) — binding a Bit name to an external
// symbol the linker resolves from a dylib at load time.
//
// Darwin-only by construction, hence the sibling `darwin-only` marker file: Bit's
// ELF output is a fully static binary with no interpreter and no libc, so an
// extern symbol there has nothing to resolve against and the compiler rejects it
// (E0078). macOS is the opposite case — Apple does not guarantee stable syscall
// numbers, so libSystem is the *supported* path, and the Mach-O linker already
// binds any still-undefined global as a libSystem import.
//
// This lives under _tests_/stress/ rather than _tests_/cases/ deliberately: the
// golden corpus doubles as the seed-vs-selfhost `check` differential's input, and
// selfhost's validator does not diagnose extern declarations yet (#1374), so a
// golden case here would register as a new MISSING in selfhost-diffcheck.sh.
//
// Three properties, all deterministic despite calling into the real OS:
//
//   (a) getpid() returns this process's id. Its exact value is not predictable,
//       so the check is the strongest predicate that IS stable: a pid is always
//       positive, and getpid is pure within a process, so two calls must agree.
//
//   (b) getentropy(buf, n) fills a buffer and returns 0. The bytes are random by
//       definition, so what is asserted is the contract: the return code, and
//       that a second call into a *raw pointer* argument still round-trips. This
//       exercises an extern taking `*T` + a scalar, not just a niladic one.
//
//   (c) an extern call composes with ordinary Bit code — used inside an
//       expression, and its result flows through arithmetic and a closure.

extern fn getpid(): i32
extern fn getentropy(buf: *u8, n: i64): i32

fn main() {
  // (a) pid is positive and stable across calls.
  let p1 = getpid()
  let p2 = getpid()
  let pid_ok = p1 > 0 && p1 == p2

  // (b) getentropy fills a real buffer through a raw pointer and returns 0.
  // 32 bytes is the documented maximum-friendly size (the cap is 256).
  let buf = []u8(32)
  let rc = getentropy(ptrOf(buf), 32)
  // A filled 32-byte buffer is astronomically unlikely to be all zero
  // (2^-256), so this distinguishes "wrote something" from "did nothing"
  // without depending on any particular random value.
  let nonzero = 0
  for b of buf {
    if (b != 0) { nonzero = nonzero + 1 }
  }
  let entropy_ok = rc == 0 && nonzero > 0

  // (c) an extern result composes with ordinary Bit code and a closure. `rc` is
  // getentropy's own return value — an extern result, and deterministically 0 —
  // so it flows through arithmetic and a closure to a fixed answer.
  let triple = (x: int) => x * 3
  let composed = triple(int(rc) + 14)

  print("${pid_ok} ${entropy_ok} ${composed}\n")
}
