// The #3147/#3176 per-span occupied-slot bitmap, under a real alloc/free
// churn through the GC layer (`runtime/gc/gcalloc.bit`'s `linkObject`,
// `runtime/gc/gcmark.bit`'s `freeObject`).
//
// WHAT THIS PROVES, AND WHY IT IS THE RIGHT INVARIANT. The bitmap is a new
// structure the allocator did not need before; the allocator's own
// `spanFree`/`spanTotal` counters are the pre-existing, independently
// maintained source of truth for the same fact ("how many of this span's
// slots are occupied"). So for every span touched, `popcount(bitmap) ==
// spanTotal - spanFree` ties the new structure to the old one — the two
// cannot silently drift apart, because they are updated by entirely
// different code paths (`heapTakeSmallLocked`/`heapGiveSmallLocked` for the
// counters, `linkObject`/`freeObject` for the bitmap) that only agree if both
// are correct.
//
// WHY A "KEEPER" PER SPAN, RATHER THAN FREEING EVERYTHING. Freeing an entire
// span makes it a `heapReclaimSpansLocked` candidate, which UNMAPS it
// (`memUnmapPages`) once the class's hysteresis fires (#2375) — after that
// the span address is no longer valid memory, and reading its bitmap would be
// undefined. So exactly one object per distinct span allocated here is never
// freed, pinning `spanFree < spanTotal` for that span for the program's
// whole lifetime and keeping every span address this test recorded valid
// until `gcDeinit`.
//
// CLASS 28 (4096-byte slots, 31 slots/span — see `_tests_/stress/alloc/alloc.bit`'s
// OCC_CLASS) is reused deliberately: it is the allocator's own corpus's proof
// that this class carves the way the header says, so a span-count surprise
// here would point at THIS file rather than at the allocator.
//
// Own private GC state (`gcBindMemory`/`gcInit`-bound arena), so this needs a
// `no-collect` marker for the same reason `gcspanfree`'s does: none of the
// assertions depend on the AMBIENT collector ever running.

import { spinUnlocked } from "../../../runtime"
import {
  heapInit, heapWords, allocSpanOf, allocSpanTotal, allocSpanFree,
  allocSpanBitmapWord,
} from "../../../runtime/alloc"
import {
  gcInit, gcConfigure, gcBindMemory, gcAlloc, gcCollectRoots,
  gcLiveBytes, gcDeinit, gcWords, gcHeaderSize, gcSpanViolations,
  gcOwns, gcOwnsLinear,
} from "../../../runtime/gc"

const ARENA_WORDS: int = 163840 // 10 spans' worth (allocSpanBytes/8 * 10)
const INDEX_WORDS: int = 8192
const META_WORDS: int = 8

const BM_BODY_SIZE: int = 4064 // + gcHeaderSize(32) = 4096 total -> class 28
const BM_OBJS: int = 200       // > 6 * 31 slots/span: forces >= 7 distinct spans
const BM_MAX_SPANS: int = 32   // generous bound on distinct spans tracked
const BM_SLOT: int = 4096      // class 28's slot size == BM_BODY_SIZE + gcHeaderSize
const BM_GRID: int = 32        // allocSpanBytes / BM_SLOT: every slot position in a span
const BM_TALLY: int = 3        // checked / mismatches / TRUE answers

// ---------------------------------------------------------------------------
// #3177: the gcOwns differential
// ---------------------------------------------------------------------------
//
// `gcOwns` no longer answers a span-backed address from the hash table: it
// masks the address to its span, probes the table for that SPAN BASE, and
// reads the class and the occupied-slot bit out of the span itself. Three
// things must survive that, and each is a separate way to corrupt the heap
// rather than merely to slow it down:
//
//   INTERIOR pointers must stay false. Floor division maps every address
//   inside a slot onto that slot's own index, so the bit alone cannot tell an
//   interior pointer from its object's base — only `allocSlotIndex`'s
//   remainder check can. Get it wrong and a conservative stack word pointing
//   one field into a live object is decoded as an object base, and
//   `markObject` reads a header 32 bytes before it that is really somebody
//   else's payload.
//
//   FREED slots must stay false, or the sweep retains its own garbage forever.
//
//   FOREIGN addresses must stay false, including addresses that mask to a LIVE
//   span but are not slots of it (the span's own base, its reserved header
//   prefix, unaligned offsets).
//
// SO THE DOMAIN IS ENUMERATED, NOT SAMPLED. A handful of hand-picked addresses
// is exactly the shape of check that passes while the interesting case is
// broken. For every span this run touched, every one of the 32 slot-grid
// positions is probed at five offsets, and one whole slot per span is probed
// at EVERY 8-byte-aligned address inside it — so the entire neighbourhood of a
// live object, base and interior alike, is covered rather than spot-checked.
// The whole domain is replayed after the sweep burst, which is what turns the
// same addresses into the FREED case. `gcOwnsLinear` — the authoritative
// all-objects scan the index has always mirrored — is the oracle for all of
// it.
//
// THE TRUE-COUNT IS PART OF THE ASSERTION, not decoration. A differential over
// a domain that answers false everywhere agrees with any implementation that
// returns false unconditionally; printing how many addresses answered TRUE is
// what proves the domain reaches the live set at all.
//
// The pinned tail is `owns 9832 0 221`: 9832 addresses answered both ways, ZERO
// disagreements, 221 of them live (200 bodies + 7 keepers reached twice over
// pass 1, 7 + 7 over pass 2). All three are deterministic; the DOMAIN SIZE is
// pinned as well as the verdict, because a differential that silently stopped
// probing would otherwise still read `0 mismatches`.
//
// THIS DOMAIN ALREADY CAUGHT ONE BUG OLDER THAN THE BITMAP. Probing the
// degenerate address 1 — the kind of word a conservative stack scan really does
// present — disagreed with the oracle on roughly half of all runs, ASLR
// dependent: `idxTombstone` IS 1, and `idxContains` compared it against the
// query without excluding its own sentinels, so `gcOwns(g, 1)` read TRUE off
// the first tombstone in the probe chain. That predates #3177 (`gcOwns` was
// `idxContains` outright) and is fixed in `runtime/gc/gcindex.bit`. Do not
// prune the degenerate addresses out of this domain to make it quieter.

// One probe. `tally[0]` counts addresses checked, `tally[1]` disagreements,
// `tally[2]` addresses the ORACLE calls live.
fn probe(g: *i64, tally: []i64, addr: int) {
  let mine = gcOwns(g, addr)
  let oracle = gcOwnsLinear(g, addr)
  tally[0] = tally[0] + 1
  if (mine != oracle) {
    tally[1] = tally[1] + 1
  }
  if (oracle) {
    tally[2] = tally[2] + 1
  }
}

// Every 8-byte-aligned address inside one slot, plus the two unaligned
// neighbours of its body base. The dense interior sweep: exactly one of the
// aligned addresses (`slot + gcHeaderSize`) may answer true.
fn probeSlotDense(g: *i64, tally: []i64, slot: int) {
  let j = 0
  while (j < BM_SLOT / 8) { // bounded: 512 iterations
    probe(g, tally, slot + j * 8)
    j = j + 1
  }
  probe(g, tally, slot + gcHeaderSize + 1)
  probe(g, tally, slot + gcHeaderSize - 1)
}

// The domain probeDomain replays twice: everything live, then everything but
// the keepers freed. `spans`/`keeper`/`spanCount` come from the burst
// (burstAllocate, below main), `arenaBase`/`idxBase` are fixed for the whole
// run -- grouped into one class so probeDomain stays under E0202's 5-param
// limit rather than taking all five separately.
class ProbeDomain {
  spans: []i64,
  keeper: []i64,
  spanCount: int,
  arenaBase: int,
  idxBase: int,
}

// The whole address domain, over every span recorded. Called once with
// everything live and once after the sweep burst, so each address is answered
// in both the live and the freed state.
fn probeDomain(g: *i64, tally: []i64, dom: ProbeDomain) {
  let si = 0
  while (si < dom.spanCount) { // bounded: BM_MAX_SPANS iterations
    let span = dom.spans[si]
    let k = 0
    while (k < BM_GRID) { // bounded: BM_GRID iterations
      let slot = span + k * BM_SLOT
      probe(g, tally, slot)                                   // the slot base: never a body
      probe(g, tally, slot + gcHeaderSize)                    // the body base
      probe(g, tally, slot + gcHeaderSize + 8)                // interior, first field
      probe(g, tally, slot + gcHeaderSize + BM_BODY_SIZE / 2) // interior, mid-body
      probe(g, tally, slot + BM_SLOT - 8)                     // interior, last word
      k = k + 1
    }
    probeSlotDense(g, tally, dom.keeper[si] - gcHeaderSize)
    si = si + 1
  }

  // FOREIGN: below the arena, above it, inside the index reserve (mapped, but
  // never a heap object), and the degenerate small/negative addresses a
  // conservative scan really does present.
  let f = 0
  while (f < 64) { // bounded: 64 iterations
    probe(g, tally, dom.arenaBase - (f + 1) * 4096)
    probe(g, tally, dom.arenaBase + ARENA_WORDS * 8 + f * 4096)
    probe(g, tally, dom.idxBase + f * 128)
    f = f + 1
  }
  probe(g, tally, 0)
  probe(g, tally, 8)
  probe(g, tally, 4096)
  probe(g, tally, 1)
  probe(g, tally, -1)
  probe(g, tally, -4096)
}

// Popcount over a u64 word. Bounded: exactly 64 iterations regardless of the
// bit pattern, so a word with the top bit set (a negative `int`) still
// terminates — `int` is signed, but the conversion to `u64` reinterprets the
// same 64 bits so `>>` shifts logically instead of sign-extending.
fn popcountWord(v: int): int {
  let x = u64(v)
  let count = 0
  let i = 0
  while (i < 64) { // bounded: 64 iterations
    if ((x & 1) == 1) {
      count = count + 1
    }
    x = x >> 1
    i = i + 1
  }
  return count
}

// ---------------------------------------------------------------------------
// #4122: a span recycled through the #3045 cache or the #4058 free list must
// arrive with a CLEAN #3176 bitmap. The burst above never reclaims anything
// -- its arena is caller-bound, so `reserveHeadOwns` reports every span
// `owned = false` and `heapReclaimSpansLocked` skips them all. The two
// phases below give the RESERVE spans to recycle instead, push them through
// each path, and re-carve for a different class before checking. See
// `../../../runtime/alloc/bitmap.bit` (the #3925 cache guard) and
// `../../../runtime/gc/mem.bit` (the #4058 free-list guard) for the two
// invariants this proves.
// ---------------------------------------------------------------------------

// The popcount(bitmap) == spanTotal - spanFree tie-in "THE ASSERTION" below
// uses, pulled out so both new phases share it rather than re-deriving it.
// Works for a span from ANY gc instance: allocSpanTotal/Free/BitmapWord are
// pure address reads, not tied to a particular `g`.
fn checkSpanBitmap(span: int): bool {
  let total = allocSpanTotal(span)
  let free = allocSpanFree(span)
  let want = total - free
  let words = (total + 63) / 64
  let got = 0
  let wi = 0
  while (wi < words) { // bounded: <= 256 words, class 0's width, the widest
    got = got + popcountWord(allocSpanBitmapWord(span, wi))
    wi = wi + 1
  }
  return got == want
}

// Runs `total` gcAlloc/checkSpanBitmap cycles against `metaAddr`, tallying
// each distinct span touched. Identical loop for both #4122 phases below --
// only the metadata address and cycle count differ, so it is shared rather
// than duplicated.
fn recycleCycles(g: *i64, metaAddr: int, total: int): (i64, i64) {
  let checked = 0
  let mismatches = 0
  let lastSpan = 0
  let d = 0
  while (d < total) { // bounded: caller-provided total
    let p = gcAlloc(g, metaAddr)
    let span = allocSpanOf(p - gcHeaderSize)
    if (span != lastSpan) {
      lastSpan = span
      checked = checked + 1
      if (!checkSpanBitmap(span)) {
        mismatches = mismatches + 1
      }
    }
    d = d + 1
  }
  return (checked, mismatches)
}

// --- #4122 phase A: the #3925 cache guard -----------------------------------
//
// A span reclaimed into the #3045 cache while carved for SRC (body 160 -> 32
// header = 192 -> class 10, 681 slots/span, carved slots starting at byte
// 192) must arrive clean when refilled for DEST (body 16 -> 48 -> class 3,
// 2721 slots/span), whose bitmap window [80,424) reaches well into class
// 10's own carved slot area. SRC's own bitmap ([80,168)) stays correct
// either way -- ordinary `linkObject`/`freeObject` bit clearing keeps it so,
// unaffected by this guard -- so a same-class reuse could never show this
// corruption; DEST must be narrower than SRC for the stale bytes to fall
// inside DEST's bitmap. A tiny caller arena means every span in this phase
// is reserve-owned (RC_ARENA_WORDS is under one span, so the very first
// refill request already fails `reserveTake` and falls to `reserveGrow`).
const RC_ARENA_WORDS: int = 512
const RC_SRC_BODY: int = 160
const RC_SRC_SPAN_SLOTS: int = 681
const RC_SRC_SPANS: int = 5 // >= allocSpanKeep(2), clears the reclaim
// hysteresis (e * 2 >= spanSpans) with room to spare: 4 non-anchor owned
// spans reclaim, 1 stays the anchor.
const RC_SRC_OBJS: int = RC_SRC_SPANS * RC_SRC_SPAN_SLOTS
const RC_DEST_BODY: int = 16
const RC_DEST_SPAN_SLOTS: int = 2721
const RC_CACHE_CYCLES: int = RC_SRC_SPANS // >= the <= 4 spans that reclaim;
// the extra cycle falls through to a fresh, clean `reserveGrow` span, which
// is a legitimate (clean) measurement rather than wasted work.

// `results` out-param, `checkSpanBitmap`'s own return-shape convention
// extended to four fields: checked, mismatches, span-bookkeeping violations,
// leaked bytes. Never returns raw addresses -- everything this phase reads
// is read and checked before its own private heap's `gcDeinit`, so nothing
// dangles once this function returns.
fn phaseCacheGuard(results: []i64) {
  let arena = []i64(RC_ARENA_WORDS)
  let indexArena = []i64(INDEX_WORDS)
  let heapBlock = []i64(heapWords)
  let heapLock = []i32(1)
  let lock = []i32(1)
  let state = []i64(gcWords)
  let srcMeta = []i64(META_WORDS)
  let destMeta = []i64(META_WORDS)
  let roots = []i64(RC_SRC_OBJS)

  srcMeta[0] = RC_SRC_BODY
  destMeta[0] = RC_DEST_BODY
  let mi = 1
  while (mi < META_WORDS) { // bounded: META_WORDS iterations
    srcMeta[mi] = 0
    destMeta[mi] = 0
    mi = mi + 1
  }
  let srcMetaAddr = int(ptrOf(srcMeta))
  let destMetaAddr = int(ptrOf(destMeta))

  let hp = ptrOf(heapBlock)
  heapInit(hp)
  let hlk = ptrOf(heapLock)
  atomicStore(hlk, spinUnlocked)
  let lp = ptrOf(lock)
  atomicStore(lp, spinUnlocked)

  let g = ptrOf(state)
  let rootsAddr = int(ptrOf(roots))
  gcBindMemory(
    g,
    int(ptrOf(arena)),
    RC_ARENA_WORDS * 8,
    int(ptrOf(indexArena)),
    INDEX_WORDS * 8,
    4096,
  )
  if (!gcInit(g, int(hp), int(hlk), int(lp), srcMetaAddr, 256)) {
    results[0] = 0
    results[1] = 1
    return
  }
  gcConfigure(g, true, true, 4096, 200, false)

  let j = 0
  while (j < RC_SRC_OBJS) { // bounded: RC_SRC_OBJS iterations
    roots[j] = gcAlloc(g, srcMetaAddr)
    j = j + 1
  }
  gcCollectRoots(g, rootsAddr, RC_SRC_OBJS) // still live: nothing swept
  let k = 0
  while (k < RC_SRC_OBJS) { // bounded: RC_SRC_OBJS iterations
    roots[k] = 0
    k = k + 1
  }
  gcCollectRoots(g, rootsAddr, RC_SRC_OBJS) // all garbage: reclaim fires,
  // caching the non-anchor owned spans

  let total = RC_CACHE_CYCLES * RC_DEST_SPAN_SLOTS
  let (checked, mismatches) = recycleCycles(g, destMetaAddr, total)

  let spanBad = gcSpanViolations(g)
  gcDeinit(g)
  results[0] = checked
  results[1] = mismatches
  results[2] = spanBad
  results[3] = gcLiveBytes(g)
}

// --- #4122 phase B: the #4058 free-list node guard --------------------------
//
// A span popped as a free-list NODE ITSELF (not merely named in one) carries
// its own array's addresses in bytes [16, 16 + 8 * entries) -- well past the
// #3176 bitmap of any class, including a fat one, so unlike phase A this
// needs no "different class" trick: the SAME fat class (8000-byte body + 32
// header = 8032 -> class 32, 15 slots/span -- `gcspanblocks`' own fat-body
// trick) is both the burst that crosses the block boundary and the class
// re-carved after. Rather than compute exactly which cycle lands on node
// 2's own pop, this checks the bitmap after EVERY refill along the way: 64
// (#3045 cache) + 511 (`spanNodeCap` + the node itself) can only ever be
// exceeded by a burst this size (never guessed at), so RC_CYCLES only needs
// to be a safe upper bound on however many spans the burst parked -- a
// cycle that runs past the free list just costs one fresh, clean
// `reserveGrow` span, still a legitimate (clean) measurement.
const RC_FAT_BODY: int = 8000
const RC_FAT_SPAN_SLOTS: int = 15
const RC_FAT_OBJS: int = 12000 // `gcspanblocks`' own MIN_CHUNKS=18 burst
// size: >= 576 spans, comfortably past one full free-list node
const RC_FAT_ARENA_WORDS: int = 512 // tiny: every span is reserve-owned
const RC_CYCLES: int = 900          // > 64 + 511 + any plausible node-2 tail

fn phaseFreeListGuard(results: []i64) {
  let arena = []i64(RC_FAT_ARENA_WORDS)
  let indexArena = []i64(INDEX_WORDS)
  let heapBlock = []i64(heapWords)
  let heapLock = []i32(1)
  let lock = []i32(1)
  let state = []i64(gcWords)
  let meta = []i64(META_WORDS)
  let roots = []i64(RC_FAT_OBJS)

  meta[0] = RC_FAT_BODY
  let mi = 1
  while (mi < META_WORDS) { // bounded: META_WORDS iterations
    meta[mi] = 0
    mi = mi + 1
  }
  let metaAddr = int(ptrOf(meta))

  let hp = ptrOf(heapBlock)
  heapInit(hp)
  let hlk = ptrOf(heapLock)
  atomicStore(hlk, spinUnlocked)
  let lp = ptrOf(lock)
  atomicStore(lp, spinUnlocked)

  let g = ptrOf(state)
  let rootsAddr = int(ptrOf(roots))
  gcBindMemory(
    g,
    int(ptrOf(arena)),
    RC_FAT_ARENA_WORDS * 8,
    int(ptrOf(indexArena)),
    INDEX_WORDS * 8,
    4096,
  )
  if (!gcInit(g, int(hp), int(hlk), int(lp), metaAddr, 256)) {
    results[0] = 0
    results[1] = 1
    return
  }
  gcConfigure(g, true, true, 4096, 200, false)

  let j = 0
  while (j < RC_FAT_OBJS) { // bounded: RC_FAT_OBJS iterations
    roots[j] = gcAlloc(g, metaAddr)
    j = j + 1
  }
  gcCollectRoots(g, rootsAddr, RC_FAT_OBJS) // still live: nothing swept
  let k = 0
  while (k < RC_FAT_OBJS) { // bounded: RC_FAT_OBJS iterations
    roots[k] = 0
    k = k + 1
  }
  gcCollectRoots(g, rootsAddr, RC_FAT_OBJS) // all garbage: reclaim fires,
  // crossing the cache and at least one full free-list node

  let total = RC_CYCLES * RC_FAT_SPAN_SLOTS
  let (checked, mismatches) = recycleCycles(g, metaAddr, total)

  let spanBad = gcSpanViolations(g)
  gcDeinit(g)
  results[0] = checked
  results[1] = mismatches
  results[2] = spanBad
  results[3] = gcLiveBytes(g)
}

// Allocate the burst, recording the FIRST object seen in each distinct span
// as that span's keeper. Order within a span is an implementation detail
// (spans fill highest-address-first, #2374) this test does not depend on:
// any object seen first for a new span works as its keeper. `dom` is a
// reference type, so its spans/keeper/spanCount fields are filled in place
// for the caller; the return value is whether every gcAlloc succeeded.
fn burstAllocate(g: *i64, metaAddr: int, rootsAddr: int, roots: []i64, dom: ProbeDomain): int {
  let allocOk = 1
  let i = 0
  while (i < BM_OBJS) { // bounded: BM_OBJS iterations
    let p = gcAlloc(g, metaAddr)
    if (p == 0) {
      allocOk = 0
    }
    roots[i] = p
    let span = allocSpanOf(p - gcHeaderSize)
    let found = -1
    let si = 0
    while (si < dom.spanCount) { // bounded: BM_MAX_SPANS iterations
      if (dom.spans[si] == span) {
        found = si
      }
      si = si + 1
    }
    if (found < 0 && dom.spanCount < BM_MAX_SPANS) {
      dom.spans[dom.spanCount] = span
      dom.keeper[dom.spanCount] = p
      dom.spanCount = dom.spanCount + 1
    }
    i = i + 1
  }
  gcCollectRoots(g, rootsAddr, BM_OBJS) // everything still rooted: nothing swept yet
  return allocOk
}

// THE ASSERTION: for every span this run touched, popcount(bitmap) ==
// spanTotal - spanFree (`checkSpanBitmap`, shared with the two #4122 phases).
fn countSpanMatches(dom: ProbeDomain): (i64, i64) {
  let spansOk = 0
  let mismatches = 0
  let sj = 0
  while (sj < dom.spanCount) { // bounded: BM_MAX_SPANS iterations
    if (checkSpanBitmap(dom.spans[sj])) {
      spansOk = spansOk + 1
    } else {
      mismatches = mismatches + 1
    }
    sj = sj + 1
  }
  return (spansOk, mismatches)
}

// Read span-violations BEFORE `gcDeinit`: teardown frees every object, and a
// heap with no spans left has nowhere to keep the count. `rooted` confirms
// arena/indexArena/roots are still exactly the sizes bound -- see main()'s
// own leading comment for why that read matters under `BIT_GC=stress`.
fn teardownAndCheck(g: *i64, arena: []i64, indexArena: []i64, roots: []i64): (i64, i64, i64) {
  let spanBad = gcSpanViolations(g)
  gcDeinit(g)
  let leaked = gcLiveBytes(g)
  let rooted = 0
  if (len(arena) == ARENA_WORDS && len(indexArena) == INDEX_WORDS && len(roots) == BM_OBJS) {
    rooted = 1
  }
  return (spanBad, leaked, rooted)
}

// Free every object except the keepers -- the CHURN BURST that exercises the
// bit-clear path (`freeObject` -> `clearSlotBit`) across every span at once,
// while never letting a span go fully free.
fn freeNonKeepers(g: *i64, rootsAddr: int, roots: []i64, dom: ProbeDomain) {
  let d = 0
  while (d < BM_OBJS) { // bounded: BM_OBJS iterations
    let p = roots[d]
    let isKeeper = 0
    let ki = 0
    while (ki < dom.spanCount) { // bounded: BM_MAX_SPANS iterations
      if (dom.keeper[ki] == p) {
        isKeeper = 1
      }
      ki = ki + 1
    }
    if (isKeeper == 0) {
      roots[d] = 0
    }
    d = d + 1
  }
  gcCollectRoots(g, rootsAddr, BM_OBJS) // sweeps every non-keeper
}

fn main() {
  // #4097: every one of these bindings, plus phaseCacheGuard's and
  // phaseFreeListGuard's own arena/indexArena/heapBlock/state/meta below, is
  // bound into `gcBindMemory` and never read again by name after that — the
  // same shape that let gcbit's collector sweep its backing slices out from
  // under it. Measured NOT exposed: this program already runs 140k+ ambient
  // collections under BIT_GC=stress (mostly inside the two phase functions'
  // own large loops) with no corruption, and removing the `rooted` read
  // below entirely still did not expose one. That is an accident of where
  // this file's codegen happens to keep these slices alive, not a
  // guarantee — re-measure before trusting it if this file changes.
  let arena = []i64(ARENA_WORDS)
  let indexArena = []i64(INDEX_WORDS)
  let heapBlock = []i64(heapWords)
  let heapLock = []i32(1)
  let lock = []i32(1)
  let state = []i64(gcWords)
  let meta = []i64(META_WORDS)
  let roots = []i64(BM_OBJS)

  let metaAddr = int(ptrOf(meta))
  meta[0] = BM_BODY_SIZE
  meta[1] = 0 // no pointer fields: a leaf, so this is pure allocator traffic
  meta[2] = 0
  meta[3] = 0
  meta[4] = 0
  meta[5] = 0
  meta[6] = 0

  let hp = ptrOf(heapBlock)
  heapInit(hp)
  let hlk = ptrOf(heapLock)
  atomicStore(hlk, spinUnlocked)
  let lp = ptrOf(lock)
  atomicStore(lp, spinUnlocked)

  let g = ptrOf(state)
  let rootsAddr = int(ptrOf(roots))
  gcBindMemory(g, int(ptrOf(arena)), ARENA_WORDS * 8, int(ptrOf(indexArena)), INDEX_WORDS * 8, 4096)
  if (!gcInit(g, int(hp), int(hlk), int(lp), metaAddr, 256)) {
    print("gcInit failed\n")
    return
  }
  gcConfigure(g, true, true, 4096, 200, false) // stress ON: arms the span-bookkeeping check

  let dom = ProbeDomain{
    spans: []i64(BM_MAX_SPANS),
    keeper: []i64(BM_MAX_SPANS),
    spanCount: 0,
    arenaBase: int(ptrOf(arena)),
    idxBase: int(ptrOf(indexArena)),
  }
  let allocOk = burstAllocate(g, metaAddr, rootsAddr, roots, dom)

  // #3177 pass 1: the whole domain with all BM_OBJS objects live.
  let tally = []i64(BM_TALLY)
  probeDomain(g, tally, dom)

  freeNonKeepers(g, rootsAddr, roots, dom)

  // #3177 pass 2: the SAME domain, now that all but the keepers are freed and
  // back on the allocator's free list. Every body address probed as live above
  // is probed again as a freed slot here.
  probeDomain(g, tally, dom)

  let (spansOk, mismatches) = countSpanMatches(dom)
  let (spanBad, leaked, rooted) = teardownAndCheck(g, arena, indexArena, roots)

  // #4122: the two recycling-guard phases, entirely independent private
  // heaps -- each prints its own checked/mismatch/violation/leaked counts,
  // so a failure names which guard (cache or free-list) is broken rather
  // than only that the program failed.
  let cacheResults = []i64(4)
  phaseCacheGuard(cacheResults)
  let flResults = []i64(4)
  phaseFreeListGuard(flResults)

  print("gcslotbitmap ${allocOk} ${dom.spanCount} ${spansOk} ${mismatches} ${spanBad} ${leaked} ${rooted} owns ${tally[0]} ${tally[1]} ${tally[2]} recycle cache ${cacheResults[0]} ${cacheResults[1]} ${cacheResults[2]} ${cacheResults[3]} freelist ${flResults[0]} ${flResults[1]} ${flResults[2]} ${flResults[3]}\n")
}
