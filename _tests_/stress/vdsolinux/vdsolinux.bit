// The Linux vDSO clock (#5959, runtime/park/linux/vdso.bit) against the real
// kernel.
//
// What must hold, and why each line is the observable for it:
//
//   state   boot resolved `clock_gettime` in the vDSO. A lookup that silently
//           stopped resolving (a wrong symbol name, a version check that no
//           longer matches, a walk that reads a table wrong) would still give
//           right answers through the syscall fallback, only slower, so the
//           reason code is printed rather than inferred from timings.
//   refuse  a name the image does not export, and the right name at a version
//           it does not define, both answer 0 and leave "no symbol", not a
//           wild address: the fallback is clean.
//   same    a fresh lookup finds the address boot cached.
//   gnu     the symbol count `DT_GNU_HASH` implies matches `DT_HASH`'s (x86_64
//           ships both; aarch64 ships `DT_HASH` only, which reads true).
//   mono    READS alternating syscall and vDSO reads of CLOCK_MONOTONIC never
//           go backwards across the two paths, and almost every adjacent pair
//           is within DELTA_NS: they read one clock, not two.
//   real    CLOCK_REALTIME through both paths agrees to DELTA_NS, so the
//           clock id reaches the vDSO rather than a fixed clock.
//
// The fraction, not every pair, is held to DELTA_NS because a thread can be
// descheduled between two reads on a loaded box; ordering has no such excuse
// and is checked on every pair.
//
// Linux-only (the sibling marker): the provider issues raw `syscall`s, which
// the compiler rejects for Darwin even uncalled.

import { parkVdsoState, parkVdsoClockFn, parkVdsoCall, parkClockSyscall } from "../../../runtime/park/linux"
import { parkVdsoLookup, parkVdsoImage, parkVdsoClockName, parkVdsoClockVersion } from "../../../runtime/park/linux"
import { parkVdsoGnuAgrees } from "../../../runtime/park/linux"

const READS: int = 20000
const DELTA_NS: int = 1000000
const clockRealtime: int = 0
const clockMonotonic: int = 1

let ts: [2]i64

// One reading through the vDSO entry `f`, or through the syscall when `f` is 0;
// -1 when the call reports failure.
fn readVia(f: int, clock: int): int {
  let rc = 0
  if (f == 0) {
    rc = parkClockSyscall(clock, ptrOf(ts))
  } else {
    rc = parkVdsoCall(f, clock, ptrOf(ts))
  }
  if (rc != 0) {
    return 0 - 1
  }
  return int(ts[0]) * 1000000000 + int(ts[1])
}

fn monoOk(f: int): bool {
  let prev = readVia(0, clockMonotonic)
  let backwards = 0
  let near = 0
  let i = 0
  while (i < READS) {
    let src = f
    if (i % 2 == 1) {
      src = 0
    }
    let now = readVia(src, clockMonotonic)
    if (now < prev) {
      backwards = backwards + 1
    }
    if (now - prev < DELTA_NS) {
      near = near + 1
    }
    prev = now
    i = i + 1
  }
  return backwards == 0 && near * 10 >= READS * 9
}

fn realOk(f: int): bool {
  let a = readVia(0, clockRealtime)
  let b = readVia(f, clockRealtime)
  return a > 0 && b >= a && b - a < DELTA_NS
}

fn main() {
  let f = parkVdsoClockFn()
  let state = parkVdsoState()
  let img = parkVdsoImage()
  let name = parkVdsoClockName()
  let ver = parkVdsoClockVersion()
  let noName = parkVdsoLookup(img, "__vdso_no_such_clock", ver) == 0 && parkVdsoState() == 5
  let noVer = parkVdsoLookup(img, name, "LINUX_0.0") == 0 && parkVdsoState() == 5
  let same = f != 0 && parkVdsoLookup(img, name, ver) == f
  let gnu = parkVdsoGnuAgrees()
  let mono = f != 0 && monoOk(f)
  let real = f != 0 && realOk(f)
  print("state=${state} refuse=${noName && noVer} same=${same} gnu=${gnu} mono=${mono} real=${real}\n")
}
