// #5807: the `keepAlive(x)` proof. `buildAndChurn` takes a fresh buffer's raw
// address (`int(ptrOf(buf))`, an `i64` that roots nothing), hands it to
// `churn` — a call that allocates heavily and, under `BIT_GC=stress`
// (`_tests_/stress`'s own harness sets it on this program only), collects at
// every one of those allocations — then calls `keepAlive(buf)` and returns
// just the address. `oneTrial` reads the buffer back ONLY through that raw
// address (`bit_rt_port_mem_load_byte`, never `buf[i]`, which would keep
// `buf` alive by ordinary SSA liveness and prove nothing).
//
// POSITIVE RESULT (verified, both GC policies): 0 of `trials` corrupted, with
// `--dump-ir` (optimized) showing `keep_alive %<buf>` surviving
// `optimizeModule` immediately after the `churn` call (#5807 ticket comment).
//
// NEGATIVE RESULT NOT REPRODUCED HERE. Commenting out `keepAlive(buf)` did
// NOT corrupt this program in any variant tried (plain, multi-buffer,
// concurrent tasks, real `bit_rt_os_run_captured`, up to 200k churn
// iterations, and with the compiler's own interval-extension for
// `Op.KeepAlive` disabled and rebuilt) — recorded on #5807 rather than
// silently dropped. The four real workarounds this ticket replaces were
// themselves flaky (rc=127, 9 of 10, only under the FULL SUITE's system
// load), so a bounded single-process synthetic reproduction may need
// real OS-level register/stack churn this program does not generate.
import { exit } from "std/os"

extern fn bit_rt_port_mem_load_byte(addr: i64): i64

const trials: int = 20
const bufLen: int = 64
const churnIters: int = 2000

fn patternByte(i: int): int {
  return (i * 37 + 11) % 256
}

// Allocates `churnIters` fresh same-size buffers, discarding each — the
// collector's steady supply of same-class objects to hand `buf`'s freed bytes
// back to under `BIT_GC=stress`.
fn churn(n: int) {
  let i = 0
  while (i < n) {
    let junk = []byte(bufLen)
    junk[0] = byte(i)
    i = i + 1
  }
}

// Builds a fresh pattern-filled buffer, churns the allocator with its raw
// address already severed from any traced reference, and returns only that
// address — `buf` itself does not survive this function's return.
fn buildAndChurn(): int {
  let buf = []byte(bufLen)
  let i = 0
  while (i < bufLen) {
    buf[i] = byte(patternByte(i))
    i = i + 1
  }
  let addr = int(ptrOf(buf))
  churn(churnIters)
  keepAlive(buf)
  return addr
}

// True iff the buffer `buildAndChurn` built, read back through its raw
// address alone, still matches the pattern written before `churn` ran.
fn oneTrial(): bool {
  let addr = buildAndChurn()
  let i = 0
  while (i < bufLen) {
    if (int(bit_rt_port_mem_load_byte(addr + i)) != patternByte(i)) {
      return false
    }
    i = i + 1
  }
  return true
}

fn main() {
  let corruptions = 0
  let t = 0
  while (t < trials) {
    if (!oneTrial()) {
      corruptions = corruptions + 1
    }
    t = t + 1
  }
  print("keepalive: ${corruptions} of ${trials} trials corrupted\n")
  if (corruptions != 0) {
    exit(1)
  }
}
