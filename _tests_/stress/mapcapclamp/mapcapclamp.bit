// #4190 bounded `mapCapForHint`'s DOUBLING COUNT to stop a garbage capHint
// (#4189's arity-mismatch register) walking `cap` to 8*2^56 = 5.7e17 slots
// (observed as 101.81 GB resident before the run was stopped), but it did
// so by CLAMPING -- truncating any hint above 262144 down to a 262144-slot
// table -- which silently defeated every legitimate hint at or above
// 229376 entries (#4299, #4303). This drives the fixed function directly
// with its documented boundary inputs and pins the result, the same style
// the sibling `maptombreclaim.bit` already uses to drive `runtime/root`
// without going through `map<K,V>` syntax.
//
// Boundary values: negative, 0, 1, mapInitCap (8), a genuine large hint
// BELOW the old 229376 cliff (50000), a genuine large hint ABOVE it
// (1500000 -- #4303's witness that a legitimate large map is honoured, not
// truncated), #4189's garbage register, and int64 max.
//
// `huge` = 7*2^55 = 252201579132747776: #4189's actual arity-mismatch
// value. It is far too small to overflow `n*8` (2017612633061982208, well
// under int64's 9223372036854775807 max), so it reaches the
// `n > mapHintMaxEntries` check for real and is IGNORED outright --
// returns `mapInitCap`, not a clamped ceiling table. Nothing large is
// allocated for a garbage hint at all.
//
// int64 max is pinned SEPARATELY on purpose: `n*8` OVERFLOWS for int64 max
// and wraps to -8 (two's complement, SPEC §11.1), so that input is caught
// by the pre-existing overflow-wrap fallback, not by the new
// `mapHintMaxEntries` check. Both paths are exercised so a future change to
// either cannot silently stop covering the other.
//
// Last, an end-to-end map: `rtMapNew` with a garbage-huge capHint must not
// crash or hang, and the map that comes back must still behave like a map
// -- inserts, length and lookups all correct despite the hint being
// ignored. 10000000 is no longer a usable witness for this arm -- it is
// now a legitimate hint under the new bound (mapHintMaxEntries =
// 117440511) and would honestly allocate a ~285 MB table -- so the
// end-to-end arm uses the same garbage register as `huge` above.

import { mapCapForHint, rtMapNew, rtMapSet, rtMapGet, rtMapLen } from "../../../runtime/root"

fn main() {
  let neg = mapCapForHint(-5)
  let zero = mapCapForHint(0)
  let one = mapCapForHint(1)
  let atInit = mapCapForHint(8) // mapInitCap
  let legit50000 = mapCapForHint(50000)
  let legit1500000 = mapCapForHint(1500000)
  let huge = mapCapForHint(252201579132747776) // 7*2^55, #4189's garbage register
  let intMax = mapCapForHint(9223372036854775807)
  print("neg=${neg} zero=${zero} one=${one} atInit=${atInit} huge=${huge} intMax=${intMax}\n")
  print("legit50000=${legit50000} legit1500000=${legit1500000}\n")

  let m = rtMapNew(0, 0, 252201579132747776) // scalar int keys/vals, garbage-huge capHint
  let i = 0
  while (i < 1000) {
    rtMapSet(m, i, i * 2)
    i = i + 1
  }
  let mapLenVal = rtMapLen(m)
  let sampleOk = rtMapGet(m, 500) == 1000
  print("hugeHintLen=${mapLenVal} sampleOk=${sampleOk}\n")
}
