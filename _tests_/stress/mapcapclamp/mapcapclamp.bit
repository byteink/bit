// #4190: `mapCapForHint`'s original loop bounded the DOUBLING COUNT (56,
// Power of 10 rule 2) but not the ALLOCATION -- a garbage capHint (#4189's
// arity-mismatch register) walked `cap` to 8*2^56 = 5.7e17 slots, observed
// as 101.81 GB resident (#4189) before the run was stopped. This drives the
// fixed function directly with its documented boundary inputs and pins the
// result, the same style the sibling `maptombreclaim.bit` already uses to
// drive `runtime/root` without going through `map<K,V>` syntax.
//
// Six boundary values, matching #4190's acceptance: negative, 0, 1,
// mapInitCap (8), the exact `n` that forced all 56 steps under the PRE-FIX
// loop, and int64 max.
//
// `forced56` = 7*2^55 = 252201579132747776: the SMALLEST `n` keeping
// `cap*7 <= n*8` through step 55 of the old 56-step loop -- the exact input
// that used to produce 8*2^56. It is far too small to overflow `n*8`
// (2017612633061982208, well under int64's 9223372036854775807 max), so it
// reaches the loop for real; under the fix it is what proves the new
// `mapCapMaxSteps=15` ceiling, stopping at cap=262144 instead of 8*2^56.
//
// int64 max is pinned SEPARATELY on purpose: `n*8` OVERFLOWS for int64 max
// and wraps to -8 (two's complement, SPEC §11.1), so that input never
// enters the loop at all -- caught by the pre-existing overflow-wrap
// fallback, not by the new step ceiling. Both paths are exercised so a
// future change to either cannot silently stop covering the other.
//
// A genuine large hint BELOW the ceiling (50000) is checked too: capacity
// is honoured (13 steps, cap=65536 -- nowhere near clamped), not silently
// reset to mapInitCap. That is the direction a careless clamp breaks and no
// existing test catches: the point is to bound abuse, not to defeat every
// legitimate large map.
//
// Last, an end-to-end map: `rtMapNew` with a garbage-huge capHint must not
// crash or hang, and the map that comes back must still behave like a map
// -- inserts, length and lookups all correct despite the clamp discarding
// the literal hint.

import { mapCapForHint, rtMapNew, rtMapSet, rtMapGet, rtMapLen } from "../../../runtime/root"

fn main() {
  let neg = mapCapForHint(-5)
  let zero = mapCapForHint(0)
  let one = mapCapForHint(1)
  let atInit = mapCapForHint(8)                    // mapInitCap
  let forced56 = mapCapForHint(252201579132747776) // 7*2^55
  let intMax = mapCapForHint(9223372036854775807)
  print("neg=${neg} zero=${zero} one=${one} atInit=${atInit} forced56=${forced56} intMax=${intMax}\n")

  let legit = mapCapForHint(50000)
  print("legit50000=${legit}\n")

  let m = rtMapNew(0, 0, 10000000) // scalar int keys/vals, garbage-huge capHint
  let i = 0
  while (i < 1000) {
    rtMapSet(m, i, i * 2)
    i = i + 1
  }
  let mapLenVal = rtMapLen(m)
  let sampleOk = rtMapGet(m, 500) == 1000
  print("hugeHintLen=${mapLenVal} sampleOk=${sampleOk}\n")
}
