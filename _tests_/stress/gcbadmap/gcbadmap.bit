// The collector's pointer-map validation (runtime/gc/gc.bit, #1363), with a
// deliberately MALFORMED `TypeInfo`.
//
// WHY THIS IS SEPARATE FROM _tests_/stress/gcbit. That program is one half of a
// differential against the deleted native runtime's `gc` module, so everything
// it does must be something that module did identically. This is not: that
// module handled a bad pointer-map offset with `std.debug.assert`, which
// PANICS in a safety build and compiles out entirely in the shipping
// ReleaseFast one. The Bit port cannot panic — `@nosplit` forbids the call —
// so it counts the violation in `gcStatBadOffsets` and skips the slot, which
// is deviation 5 in gc.bit's header. That behaviour has no counterpart in the
// deleted module to diff against, so it is pinned here on its own.
//
// It also exists because the guard was DEAD until this test was written.
// Mutation-testing the differential showed that replacing the offset check with
// `if (false)` changed nothing — every `TypeInfo` in that program is
// well-formed, so the check never fired. A guard that has never been observed
// to fire is not a verified guard.
//
// Three offsets are declared for a 16-byte body:
//   0   valid — a real reference field, must still be traced
//   4   MISALIGNED (not a multiple of 8), must be counted and skipped
//   16  RUNS PAST the 16-byte body (16 + 8 > 16), must be counted and skipped
//
// So exactly 2 violations are counted per scan of one such object, the valid
// slot is still followed (proved by the referent surviving), and nothing reads
// outside the body.

import { spinUnlocked } from "../../../runtime"
import { heapInit, heapWords } from "../../../runtime/alloc"
import {
  gcInit,
  gcConfigure,
  gcBindMemory,
  gcAlloc,
  gcCollectRoots,
  gcOwns,
  gcNumObjects,
  gcStatBadOffsets,
  gcWords,
  storeWord,
} from "../../../runtime/gc"

const ARENA_WORDS = 65536
const INDEX_WORDS = 4096
const META_WORDS = 24

// Metadata layout, in words: one good TypeInfo, one malformed one, and their
// offset arrays.
const MI_GOOD = 0
const MI_BAD = 7
const MI_GOOD_OFFS = 14 // [0]
const MI_BAD_OFFS = 16  // [0, 4, 16]

fn writeInfo(meta: []i64, at: int, size: int, offsAddr: int, offsLen: int) {
  meta[at + 0] = size
  meta[at + 1] = offsAddr
  meta[at + 2] = offsLen
  meta[at + 3] = 0
  meta[at + 4] = 0
  meta[at + 5] = 0
  meta[at + 6] = 0
}

fn main() {
  let arena = []i64(ARENA_WORDS)
  let indexArena = []i64(INDEX_WORDS)
  let heapBlock = []i64(heapWords)
  let heapLock = []i32(1)
  let lock = []i32(1)
  let state = []i64(gcWords)
  let roots = []i64(2)
  let meta = []i64(META_WORDS)

  let metaAddr = int(ptrOf(meta))
  meta[MI_GOOD_OFFS] = 0
  meta[MI_BAD_OFFS + 0] = 0  // valid
  meta[MI_BAD_OFFS + 1] = 4  // misaligned
  meta[MI_BAD_OFFS + 2] = 16 // past the end of a 16-byte body
  writeInfo(meta, MI_GOOD, 16, metaAddr + MI_GOOD_OFFS * 8, 1)
  writeInfo(meta, MI_BAD, 16, metaAddr + MI_BAD_OFFS * 8, 3)

  let hp = ptrOf(heapBlock)
  heapInit(hp)
  let hlk = ptrOf(heapLock)
  atomicStore(hlk, spinUnlocked)
  let lp = ptrOf(lock)
  atomicStore(lp, spinUnlocked)

  let g = ptrOf(state)
  gcBindMemory(g, int(ptrOf(arena)), ARENA_WORDS * 8, int(ptrOf(indexArena)), INDEX_WORDS * 8, 4096)
  if (!gcInit(g, int(hp), int(hlk), int(lp), metaAddr, 64)) {
    print("gcInit failed\n")
    return
  }
  gcConfigure(g, true, false, 4096, 200, false)

  // `holder` has the malformed map and points at `target` through its ONE valid
  // offset. `garbage` is reachable from nothing and must be reclaimed.
  let holder = gcAlloc(g, metaAddr + MI_BAD * 8)
  let target = gcAlloc(g, metaAddr + MI_GOOD * 8)
  let garbage = gcAlloc(g, metaAddr + MI_GOOD * 8)
  storeWord(holder + 0, target)

  roots[0] = holder
  roots[1] = 0

  let before = gcStatBadOffsets(g)
  gcCollectRoots(g, int(ptrOf(roots)), 2)
  let after = gcStatBadOffsets(g)

  // holder survives (rooted); target survives (traced through the ONE valid
  // offset, which proves the guard skips only the bad slots); garbage goes.
  let survived = 0
  if (gcOwns(g, holder)) {
    survived = survived + 1
  }
  if (gcOwns(g, target)) {
    survived = survived + 1
  }
  let garbageGone = 0
  if (!gcOwns(g, garbage)) {
    garbageGone = 1
  }

  print("badmap ${after - before} ${survived} ${garbageGone} ${gcNumObjects(g)}\n")
}
