// A NON-ROOT module. Every function here would ordinarily be emitted with this
// module's `m<id>$` prefix, where `<id>` is an ordinal the importing build
// assigns — which is exactly why an exported Bit function has no stable external
// name, and why a Bit-sourced runtime could not define the `bit_rt_*` symbols
// code generation calls. `pinnedAdd` opts out with §11.9 `@symbol`.

// Emitted verbatim as `bit_pinned_sub`, with no module prefix. The caller finds
// it by that raw name through an `extern function` declaration (§11.7) — a
// reference emitted with no knowledge of this declaration at all, so the link
// only succeeds if the two spellings match exactly.
//
// SUBTRACTION, not addition, on purpose: it is order-sensitive, so this also
// checks that the two sides agree on argument ORDER across the boundary. A
// commutative operation would return the right answer even if the C-ABI
// argument registers were paired up backwards.
export @symbol("bit_pinned_sub")
fn pinnedSub(a: i64, b: i64): i64 {
  return a - b
}

// The CONTROL: same module, same shape, no pin. This one keeps the `m<id>$`
// prefix, which is what makes it unreachable by raw name — and what proves the
// pin above is doing something rather than the prefix having quietly vanished.
export fn plainSub(a: i64, b: i64): i64 {
  return a - b
}
