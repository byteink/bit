// A returned `main` ends the process promptly while a scheduler worker is blocked in
// a call that never enters the runtime's blocking bracket (#7836; #7829 is the
// Windows half, `_tests_/stress/thread/exitblockedwindows`). `boot()` step 8
// (runtime/root/{linux/boottail,darwin/boot}.bit) joined each worker with a 15 s
// bound before it exited, so one worker parked in a raw kernel wait cost the process
// 15 s after `main` returned. The join is now one shared 100 ms deadline.
//
// The blocked call is `bit_rt_port_park_sleep_ns` with NO `bit_rt_gc_syscall_begin`
// around it: a stand-in for a raw `read`/`recvfrom`/foreign call that polls nothing,
// the shape ABI.md section 8.5 says to bracket and a program may fail to.
//
// SELF-CHECKING BY RE-EXEC. The parent (no argument) runs this same binary as a
// child under `env BIT_WORKERS=4` (a blocked worker leaves other workers to run
// `main`), reads the child's `unixms=` stamp, and compares it with its own clock
// once the child's pipes close: that difference is how long the process outlived
// `main`, plus the parent's own read, a few milliseconds.
import { args } from "std/os"
import { output } from "std/process"
import { indexOf } from "std/strings"

extern fn bit_rt_port_park_sleep_ns(ns: int, scratch: *i64)

const blockNs: int = 60000000000
const readyPolls: int = 5000
const settleMs: int = 100
const childExit: int = 7
const lagMaxMs: int = 1000
const childTimeoutMs: int = 30000
const runs: int = 5

let ready: [1]i64
let blockScratch: [2]i64

fn blocker() {
  atomicAdd(ptrOf(ready), 1)
  bit_rt_port_park_sleep_ns(blockNs, ptrOf(blockScratch))
}

fn child(): int {
  spawn blocker()
  let polls = 0
  while (int(atomicLoad(ptrOf(ready))) < 1 && polls < readyPolls) {
    timeSleepNs(1000000)
    polls = polls + 1
  }
  if (int(atomicLoad(ptrOf(ready))) < 1) {
    print("exitblocked child: blocker never started\n")
    return 1
  }
  timeSleepNs(settleMs * 1000000)
  print("exitblocked return unixms=${timeUnixNs() / 1000000}\n")
  return childExit
}

fn stampOf(out: string): int {
  let key = "unixms="
  let at = indexOf(out, key)
  if (at < 0) {
    return -1
  }
  let i = at + len(key)
  let v = 0
  while (i < len(out) && out[i] >= 48 && out[i] <= 57) {
    v = v * 10 + int(out[i]) - 48
    i = i + 1
  }
  return v
}

fn runOnce(self: string, n: int): bool {
  let r = output("/usr/bin/env", ["BIT_WORKERS=4", self, "child"], childTimeoutMs)
  let nowMs = timeUnixNs() / 1000000
  let stamp = stampOf(r.stdout)
  if (r.exitCode != childExit || stamp < 0) {
    print("exitblocked FAIL run ${n}: exit ${r.exitCode} (want ${childExit}), stamp ${stamp}, stdout '${r.stdout}'\n")
    return false
  }
  let lag = nowMs - stamp
  if (lag > lagMaxMs) {
    print("exitblocked FAIL run ${n}: process outlived main by ${lag} ms (want <= ${lagMaxMs})\n")
    return false
  }
  return true
}

fn main(): int {
  let a = args()
  if (len(a) > 1 && a[1] == "child") {
    return child()
  }
  let n = 0
  while (n < runs) {
    if (!runOnce(a[0], n)) {
      return 1
    }
    n = n + 1
  }
  print("exitblocked: ok\n")
  return 0
}
