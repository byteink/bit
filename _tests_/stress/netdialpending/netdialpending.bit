// #8363: drive the real Linux connect loop through injected syscall results.
// Readiness is forced only in the traced child; production has no test hook.
import { args } from "std/os"
import { netDialTcp, netAwaitReady, netClose } from "../../../runtime/net/linux"

let host: [2]i64

fn dialCase(mode: string) {
  let p = ptrOf(host)
  *p = 0x2e302e302e373231
  *(p + 1) = 0x31
  let raw: *u8 = nil
  let fd = netDialTcp(raw + int(p), 9, 9)
  if (mode == "success") {
    if (fd < 0) {
      panic("pending connect did not complete")
    }
    netClose(fd)
    return
  }
  let expected = 0 - 1
  if (mode == "refused") {
    expected = 0 - 111
  }
  if (fd != expected) {
    panic("pending connect returned ${fd}, expected ${expected}")
  }
}

fn main() {
  let argv = args()
  if (len(argv) == 3 && argv[1] == "--dial-child") {
    dialCase(argv[2])
    return
  }
  provePending(int(entryOf(netAwaitReady)))
  println("pending-connect true")
}
