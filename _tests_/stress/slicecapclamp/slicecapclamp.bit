// #4267: `rtSliceNew`'s `capWant` had NO clamp at all -- not even the `n<=0`
// advisory fallback `mapCapForHint` had before #4190. `c` was `capWant`
// verbatim (or `want` if larger) straight into `allocBuf`'s `c*elemSize`
// multiply, worse than mapCapForHint's PRE-#4190 state: that one at least
// doubled from a small base, while `rtSliceNew` honors a single garbage/huge
// hint in ONE call. This drives the fixed function directly with its
// documented boundary inputs and pins the result, the same style
// `../mapcapclamp/mapcapclamp.bit` (#4190) already uses to drive
// `runtime/root` without going through `[]T(n, m)` syntax.
//
// `sliceCapWantClamp(capWant, elemSize)` clamps the PRE-SIZE HINT to
// `sliceCapWantMaxBytes` (8388608, the same boot-time-arena figure #4190
// derived) bytes: `maxCap = 8388608 / elemSize`. Two `elemSize`s are
// exercised because, unlike a map's fixed 17-bytes/slot, a slice's ceiling
// genuinely moves with the element stride:
//
//   elemSize=8 (every non-packed element)         maxCap = 1048576
//   elemSize=1 (a packed `[]u8`, #3121/#3226)      maxCap = 8388608
//
// Boundary values: negative, 0, 1, exactly `maxCap` (honored, not clamped),
// one past `maxCap` (clamped), and int64 max (clamped) -- for BOTH
// elemSizes, plus `elemSize<=0` (defense-in-depth against a corrupted
// register feeding this ABI entry point directly, #3152's shape; unreachable
// from compiled code today, see `sliceCapWantClamp`'s own comment).
//
// A genuine large hint BELOW the ceiling (500000, elemSize=8) is checked
// too: honoured exactly, not silently reset to something smaller -- the
// direction a careless clamp breaks and no existing test catches, matching
// `mapcapclamp.bit`'s own `legit50000` check.
//
// Then three end-to-end `rtSliceNew` calls, reading the header's `slcCap`
// field back (`c` is what both the header and `allocBuf`'s `c*elemSize`
// multiply share, so a bounded `slcCap` IS proof the actual allocation
// stayed bounded):
//
//   1. capWant=500000 (< ceiling), want=0     -- cap must be 500000 exactly
//   2. capWant=int64-max (garbage), want=100  -- cap must be clamped to
//      1048576, and real writes/reads through `rtSliceSet`/`rtSliceGet` at
//      indices 0..99 (real `want`, inside the clamped buffer) plus 10 real
//      `rtSliceAppend` calls must behave like an ordinary slice
//   3. capWant=0, want=2000000 (> ceiling)    -- cap must be 2000000
//      EXACTLY: `want` is the real, immediate length and must never be
//      clamped (clamping it would corrupt a legitimately sized slice); this
//      also proves a legitimate large *request* is still honoured, not just
//      a legitimate large *hint*

import { sliceCapWantClamp, rtSliceNew, rtSliceAppend, rtSliceGet, rtSliceSet, slcCap, slcLen } from "../../../runtime/root"
import { loadWord } from "../../../runtime/gc"

fn main() {
  let neg8 = sliceCapWantClamp(-5, 8)
  let zero8 = sliceCapWantClamp(0, 8)
  let one8 = sliceCapWantClamp(1, 8)
  let atCeiling8 = sliceCapWantClamp(1048576, 8)
  let overCeiling8 = sliceCapWantClamp(1048577, 8)
  let intMax8 = sliceCapWantClamp(9223372036854775807, 8)
  print("neg8=${neg8} zero8=${zero8} one8=${one8} atCeiling8=${atCeiling8} overCeiling8=${overCeiling8} intMax8=${intMax8}\n")

  let atCeiling1 = sliceCapWantClamp(8388608, 1)
  let overCeiling1 = sliceCapWantClamp(8388609, 1)
  let intMax1 = sliceCapWantClamp(9223372036854775807, 1)
  print("atCeiling1=${atCeiling1} overCeiling1=${overCeiling1} intMax1=${intMax1}\n")

  let zeroElem = sliceCapWantClamp(100, 0)
  let negElem = sliceCapWantClamp(100, -8)
  print("zeroElem=${zeroElem} negElem=${negElem}\n")

  let legit = sliceCapWantClamp(500000, 8)
  print("legit500000=${legit}\n")

  // 1. A genuine large capWant below the ceiling, honoured exactly end to end.
  let h1 = rtSliceNew(0, 500000, 0, 8)
  let cap1 = loadWord(h1 + slcCap)
  print("h1cap=${cap1}\n")

  // 2. A garbage-huge capWant clamped end to end; want=100 real elements
  // live inside the clamped buffer.
  let h2 = rtSliceNew(100, 9223372036854775807, 0, 8)
  let cap2 = loadWord(h2 + slcCap)
  print("h2cap=${cap2}\n")
  let i = 0
  while (i < 100) {
    rtSliceSet(h2, i, i * 3, 8)
    i = i + 1
  }
  let readsOk = true
  i = 0
  while (i < 100) {
    if (rtSliceGet(h2, i, 8) != i * 3) {
      readsOk = false
    }
    i = i + 1
  }
  let j = 0
  while (j < 10) {
    h2 = rtSliceAppend(h2, 1000 + j, 0, 8)
    j = j + 1
  }
  let len2 = loadWord(h2 + slcLen)
  let appendedOk = rtSliceGet(h2, 109, 8) == 1009
  print("h2readsOk=${readsOk} h2len=${len2} h2appendedOk=${appendedOk}\n")

  // 3. `want` itself, exceeding the ceiling, must never be clamped.
  let h3 = rtSliceNew(2000000, 0, 0, 8)
  let cap3 = loadWord(h3 + slcCap)
  let len3 = loadWord(h3 + slcLen)
  rtSliceSet(h3, 1999999, 42, 8)
  let tailOk = rtSliceGet(h3, 1999999, 8) == 42
  print("h3cap=${cap3} h3len=${len3} h3tailOk=${tailOk}\n")
}
