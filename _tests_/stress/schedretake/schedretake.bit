// #7128: a task blocked in the kernel inside a syscall bracket must not strand
// its worker's ring. Default pool (one worker at boot): `blocker` blocks the
// only worker's OS thread for 500 ms, and the two `starter` tasks spawned right
// behind it sit on that worker's ring (1-3 queued tasks never reach
// `growStreakThreshold`, so the depth-driven growth cannot help). The monitor
// thread's retake (`runtime/sched/retake.bit`) must start a second worker that
// runs them while `blocker` is still asleep.
//
// The blocker brackets its sleep with `bit_rt_gc_syscall_begin`/`_end`, the pair
// every runtime syscall wrapper that can block uses (file reads, `waitpid`):
// the retake keys on the collector's registry showing the thread in a bracket,
// because an unbracketed block is indistinguishable from a CPU-bound task.
//
// Without the retake the starters run when the blocker returns, ~500 ms after
// spawn. The bound is 100 ms: the retake needs three 2 ms monitor ticks plus a
// thread create, ~6-10 ms idle, so 100 ms is generous for a loaded host and
// still five times under the stall it detects.

import { monotonic, Millisecond } from "std/time"

extern fn bit_rt_gc_syscall_begin()
extern fn bit_rt_gc_syscall_end()
extern fn bit_rt_port_park_sleep_ns(ns: int, scratch: *i64)

const blockNs: int = 500 * Millisecond
const boundNs: int = 100 * Millisecond

let blockScratch: [2]i64

fn blocker(done: chan<int>) {
  bit_rt_gc_syscall_begin()
  bit_rt_port_park_sleep_ns(blockNs, ptrOf(blockScratch))
  bit_rt_gc_syscall_end()
  done <- 1
}

fn starter(out: chan<int>) {
  out <- monotonic().ns
}

fn main() {
  let done = chan<int>(1)
  let starts = chan<int>(2)
  let t0 = monotonic().ns
  spawn blocker(done)
  spawn starter(starts)
  spawn starter(starts)
  let a = <- starts
  let b = <- starts
  let worst = a - t0
  if (b - t0 > worst) {
    worst = b - t0
  }
  let _ = <- done
  if (worst >= boundNs) {
    print("schedretake: starters began ${worst / 1000000} ms after spawn, want < ${boundNs / 1000000} ms\n")
    osExit(1)
  }
  print("schedretake: ok\n")
}
