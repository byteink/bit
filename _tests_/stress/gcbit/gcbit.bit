// The Bit garbage collector (runtime/gc/gc.bit, #1363) driven through a
// scripted allocation/mutation/collection sequence, as a real linked binary.
//
// THIS FILE USED TO BE ONE HALF OF A DIFFERENTIAL, AND `gcbit.expected` STILL
// CARRIES THAT PROVENANCE. The deleted harness's `gcdiff` module drove the
// deleted native runtime's `gc` module — the collector this is a port of —
// through the byte-for-byte SAME script and
// asserted its table equalled `gcbit.expected`, the same file the stress
// harness compares this program's stdout against. Every record in that golden
// was therefore produced independently by two collectors, neither derived from
// the other, and any behavioural divergence between them failed one side.
//
// Both the deleted native runtime's collector and the differential were
// deleted in #1854: nothing of that runtime shipped in `libbitrt.a` any more,
// and #1849 had already consumed the one
// remaining use for the oracle. The golden is unchanged and still enforced —
// the stress harness diffs this program against it twice per run — but it now
// has ONE witness instead of two.
//
// So: `gcbit.expected` is not a file to regenerate. Its numbers were agreed on
// by two independent implementations, and that agreement cannot be
// re-established once the second one is gone. A change here that alters the
// table is a change to collector BEHAVIOUR and needs to be justified as one.
// Recover the other side with `git show 8e8cd5e:runtime/gc.zig` if you ever
// need to re-derive it.
//
// The recorded quantities are exactly the ones that must not drift, and are all
// implementation-independent (no addresses appear, because the two use
// different allocators — see runtime/gc/region.bit):
//
//   numObjects   the live object count after the step
//   liveBytes    heap bytes handed out and not freed — the growth-trigger input
//   collections  how many times the collector has run, which is the TRIGGER
//                SCHEDULE: it only matches if the growth policy matches
//   totalSwept   cumulative objects reclaimed
//   survivors    objects that survived the most recent collection
//   indexEntries live LARGE-OBJECT entries in the address->object index
//
// #3178 CHANGED WHAT `indexEntries` MEANS, AND EVERY PER-STEP VALUE IN
// `gcbit.expected` MOVED — read this before assuming the golden drifted by
// accident. `linkObject`/`freeObject` (`runtime/gc/gcalloc.bit`,
// `gcmark.bit`) stopped calling `idxInsert`/`idxRemove` for a span-backed
// body once `gcOwns` had #3176's per-span bitmap to read instead (#3177);
// only a LARGE (direct-mapped) object still gets a hash-index body key.
// `Node` (16 bytes) and `Wide` (64 bytes) are both far below the large-object
// cutoff, so this script allocates NONE, and `indexEntries` reads exactly 0
// at every recorded step — not `numObjects`, which is what every prior
// `.expected` line encoded. That is a real, deliberate collector-behaviour
// change (this file's own rule above: justify it, don't silently regenerate)
// and the justification is #3178 itself: the whole point of that ticket is
// that the hash index no longer holds a span-backed object at all. The
// `done` line's own `numObjects`/`indexEntries` fields do not move — the
// script's final collection empties the heap, so both were already 0.
//
// `indexEntries` is still the one that catches an index drifting out of step
// with the authoritative all-objects list — it must equal the count above
// (0, for this script) at every single record, which the final summary line
// asserts across the whole run.
//
// The script is driven by splitmix64 so both sides generate an identical
// operation stream from the same seed, and every step draws exactly four values
// regardless of which operation it picks — a variable draw count would let the
// two streams diverge silently.
//
// The mark worklist is deliberately tiny (MARK_STACK = 64) while the wide
// object fans out 8 ways, so the worklist OVERFLOWS and the bounded-rescan
// recovery path runs for real rather than being dead code.
//
// Under BIT_GC=stress the REAL collector in libbitrt fires at every safepoint.
// (That was the deleted native runtime's one when this was written; since
// #1591 libbitrt is all-Bit, so it is now a second, independent instance of
// the same collector — which
// changes nothing about what this paragraph tests.) It does not collect the
// scripted collector's heap — which lives in
// raw memory carved out of the `[]i64` slices below — but it does prove those
// slices stay rooted through `main` while only raw, untraced pointers reach the
// collector, and that the `@nosplit` collector bodies take no safepoint.

import { spinUnlocked } from "../../../runtime"
import { heapInit, heapWords, allocMaxSmall } from "../../../runtime/alloc"
import {
  gcInit,
  gcConfigure,
  gcAlloc,
  gcAllocRaw,
  gcOwns,
  gcOwnsLinear,
  gcCollectRoots,
  gcSafepointRoots,
  gcNumObjects,
  gcLiveBytes,
  gcStatCollections,
  gcStatTotalSwept,
  gcStatSurvivorsLast,
  gcStatTotalAllocated,
  gcStatBadOffsets,
  gcIndexEntries,
  gcIndexEnabled,
  gcWords,
  gcBindMemory,
  gcMarkBegin,
  gcMarkConservative,
  gcCollectFinish,
  gcHeaderSize,
  storeWord,
  loadWord,
} from "../../../runtime/gc"

const ROOTS = 16
const STEPS = 600
const RECORD_EVERY = 8
// Four entries, against a live set that reaches ~30 objects and a `Wide` that
// fans out 8 ways: the worklist overflows constantly, so the bounded-rescan
// recovery is exercised on nearly every collection rather than being dead code.
// Verified by mutation — see the task report; breaking `recoverOverflow`
// changes the table.
const MARK_STACK = 4
const MIN_TRIGGER = 4096
const GROWTH_PCT = 200

// Arena sizes in i64 words. 1 MiB of object heap and 64 KiB of index region are
// far more than the script needs; the point is that neither ever runs out, so a
// short table can never be an allocation failure in disguise.
const ARENA_WORDS = 131072
const INDEX_WORDS = 8192

// Metadata block layout, in words. Two `TypeInfo`s (ABI.md §2, 7 words each),
// the `ref_array_info` sentinel, and the two pointer-offset arrays.
const MI_NODE = 0
const MI_WIDE = 7
const MI_REFARR = 14
const MI_NODE_OFFS = 21
const MI_WIDE_OFFS = 23
// A LEAF descriptor (empty `ptr_offsets`), deliberately at a DIFFERENT address
// from `MI_REFARR` above: `scanObject` matches the reference-array sentinel by
// ADDRESS, so a leaf that happens to have the same field values must still be
// scanned by the ordinary pointer-map path (#4083's size sweep uses it).
const MI_LEAF = 25
const META_WORDS = 32

// #4083: the mark bit shares bit 63 of the size word, so every reader of that
// word must mask. `SWEEP_STEP` of 8 over the whole small domain walks every
// size class; `allocMaxSmall - gcHeaderSize` is the largest body that still
// takes the span-backed path, so the sweep never reaches the direct-mapped
// allocator (which would map pages this scripted heap does not own).
const SWEEP_STEP = 8
const REFARR_MAX = 96

// splitmix64. Computed in u64 for defined modular arithmetic; the deleted
// harness's side used the identical constants and the identical `+%`/`*%`
// wrapping ops.
fn nextRand(state: []u64): int {
  state[0] = state[0] + 11400714819323198485
  let z = state[0]
  z = (z ^ (z >> 30)) * 13787848793156543929
  z = (z ^ (z >> 27)) * 10723151780598845931
  z = z ^ (z >> 31)
  // Mask to 62 bits so the value is a non-negative `int` on both sides.
  return int(z & 4611686018427387903)
}

// Write one `TypeInfo` (ABI.md §2) at word `at` of the metadata block.
fn writeInfo(meta: []i64, at: int, size: int, offsAddr: int, offsLen: int) {
  meta[at + 0] = size
  meta[at + 1] = offsAddr
  meta[at + 2] = offsLen
  meta[at + 3] = 0
  meta[at + 4] = 0
  meta[at + 5] = 0
  meta[at + 6] = 0
}

// EXHAUSTIVE SIZE ROUND-TRIP (#4083). Every attainable span-backed allocation
// size, allocated, MARKED, unmarked, and freed.
//
// `heapTakeSmallLocked` adds the requested size to the live-byte counter and
// `heapGiveSmallLocked` subtracts whatever `freeObject` read back OUT of the
// header, so a size that does not round-trip through the packed word leaves a
// residue here. The first collection is what makes this a test of the PACKING
// rather than of the counter: it marks every object, so the raw size word is
// NEGATIVE while the object is live, which is the only state in which a
// missing mask is observable at all.
//
// Returns the number of batches whose live-byte residue was non-zero, and
// writes the number of sizes it ACTUALLY allocated into `tally[0]` — a
// denominator the loop produces rather than one the printf recomputes, so a
// sweep that examined nothing cannot print the same line as one that examined
// everything. Bounded: `(allocMaxSmall - gcHeaderSize) / SWEEP_STEP`
// allocations, in batches of `ROOTS`.
fn sizeRoundTrip(g: *i64, leafInfo: int, rootsAddr: int, roots: []i64, tally: []i64): int {
  let bad = 0
  tally[0] = 0
  let base = gcLiveBytes(g)
  let maxBody = allocMaxSmall - gcHeaderSize
  let b = 0
  while (b <= maxBody) {
    let k = 0
    while (k < ROOTS) {
      if (b <= maxBody) {
        roots[k] = gcAllocRaw(g, b, leafInfo)
        b = b + SWEEP_STEP
        tally[0] = tally[0] + 1
      } else {
        roots[k] = 0
      }
      k = k + 1
    }
    gcCollectRoots(g, rootsAddr, ROOTS)
    let j = 0
    while (j < ROOTS) {
      roots[j] = 0
      j = j + 1
    }
    gcCollectRoots(g, rootsAddr, ROOTS)
    if (gcLiveBytes(g) != base) {
      bad = bad + 1
    }
  }
  return bad
}

// REFERENCE-BUFFER TRACING (#4083), the silent-wrongness arm.
//
// `scanObject`'s reference-buffer path derives its word count from the size
// word: `(hdrSize(h) - gcHeaderSize) / 8`. It only ever runs on an object
// `markObject` has already marked, so the raw word is negative there, and an
// unmasked read yields a NEGATIVE count, skips the loop and traces nothing —
// every element of the buffer is then swept while the program still holds the
// buffer. That is under-tracing, the same failure class `runtime/root/`'s
// fabricated leaf header once shipped, and it is a wrong answer rather than a
// crash. So: root ONLY the array, collect, and require every referent to still
// be a live object afterwards.
//
// Returns the number of referents that did NOT survive, and writes the number
// of referents it ACTUALLY checked into `tally[1]`, for the same reason
// `sizeRoundTrip` writes `tally[0]`. Bounded: `REFARR_MAX` lengths, each with
// at most `REFARR_MAX` elements.
fn refArrayTrace(
  g: *i64,
  arrInfo: int,
  nodeInfo: int,
  rootsAddr: int,
  roots: []i64,
  tally: []i64,
): int {
  let lost = 0
  tally[1] = 0
  let n = 1
  while (n <= REFARR_MAX) {
    let arr = gcAllocRaw(g, n * 8, arrInfo)
    roots[0] = arr
    let i = 1
    while (i < ROOTS) {
      roots[i] = 0
      i = i + 1
    }
    let f = 0
    while (f < n) {
      storeWord(arr + f * 8, gcAlloc(g, nodeInfo))
      f = f + 1
    }
    gcCollectRoots(g, rootsAddr, ROOTS)
    let c = 0
    while (c < n) {
      tally[1] = tally[1] + 1
      if (!gcOwns(g, loadWord(arr + c * 8))) {
        lost = lost + 1
      }
      c = c + 1
    }
    roots[0] = 0
    gcCollectRoots(g, rootsAddr, ROOTS)
    n = n + 1
  }
  return lost
}

fn main() {
  // Every backing slice is held in `main` for the whole program: only raw,
  // untraced pointers into them reach the collector, so these bindings are what
  // keeps them alive under BIT_GC=stress.
  let arena = []i64(ARENA_WORDS)
  let indexArena = []i64(INDEX_WORDS)
  let heapBlock = []i64(heapWords)
  let heapLock = []i32(1)
  let state = []i64(gcWords)
  let roots = []i64(ROOTS)
  let meta = []i64(META_WORDS)
  let lock = []i32(1)
  let rng = []u64(1)

  let metaAddr = int(ptrOf(meta))
  meta[MI_NODE_OFFS + 0] = 0
  meta[MI_NODE_OFFS + 1] = 8
  let w = 0
  while (w < 8) {
    meta[MI_WIDE_OFFS + w] = w * 8
    w = w + 1
  }
  // Node: 16-byte body, GC references at 0 and 8.
  writeInfo(meta, MI_NODE, 16, metaAddr + MI_NODE_OFFS * 8, 2)
  // Wide: 64-byte body, 8 references — wide enough to overflow the worklist.
  writeInfo(meta, MI_WIDE, 64, metaAddr + MI_WIDE_OFFS * 8, 8)
  // The `ref_array_info` sentinel: matched by ADDRESS, never by content.
  writeInfo(meta, MI_REFARR, 0, 0, 0)
  // Leaf: no reference fields. Same field VALUES as the sentinel above and a
  // different address, which is the whole point (#4083).
  writeInfo(meta, MI_LEAF, 0, 0, 0)

  let nodeInfo = metaAddr + MI_NODE * 8
  let wideInfo = metaAddr + MI_WIDE * 8
  let refArrInfo = metaAddr + MI_REFARR * 8

  // The REAL allocator (runtime/alloc, #1362) is the collector's heap. Its
  // pages would normally come from mmap; a stress program is not a place to
  // bind a platform module, and the collector takes memory rather than a
  // mapping callback anyway (see runtime/gc/mem.bit), so the reserve is an
  // ordinary slice held live in `main`.
  let hp = ptrOf(heapBlock)
  heapInit(hp)
  let hlk = ptrOf(heapLock)
  atomicStore(hlk, spinUnlocked)

  let lp = ptrOf(lock)
  atomicStore(lp, spinUnlocked)

  let g = ptrOf(state)
  let rootsAddr = int(ptrOf(roots))
  gcBindMemory(g, int(ptrOf(arena)), ARENA_WORDS * 8, int(ptrOf(indexArena)), INDEX_WORDS * 8, 4096)
  if (!gcInit(g, int(hp), int(hlk), int(lp), refArrInfo, MARK_STACK)) {
    print("gcInit failed\n")
    return
  }
  gcConfigure(g, true, false, MIN_TRIGGER, GROWTH_PCT, false)

  rng[0] = u64(88172645463325252)

  // Invariants accumulated across the whole run, reported on the final line.
  // `indexAgree` is the strong one: the fast index must agree with the
  // expected large-object count at every record, which is what proves the
  // index never drifts from the authoritative all-objects list. #3178: that
  // expectation is 0, not `gcNumObjects(g)` — `Node`/`Wide` are both
  // span-backed, so this script never puts an object in the hash index at
  // all (see the header comment's #3178 note).
  let indexAgree = 1
  let ownsAgree = 1

  let step = 0
  // Bounded: exactly STEPS iterations.
  while (step < STEPS) {
    gcSafepointRoots(g, rootsAddr, ROOTS)

    let a = nextRand(rng)
    let b = nextRand(rng)
    let c = nextRand(rng)
    let d = nextRand(rng)
    let op = a % 16
    let slot = b % ROOTS
    let slot2 = c % ROOTS
    let field = d % 2 * 8

    if (op < 8) {
      roots[slot] = gcAlloc(g, nodeInfo)
    } else if (op < 10) {
      roots[slot] = gcAlloc(g, wideInfo)
    } else if (op < 12) {
      // Build an edge between two live roots. Offsets 0 and 8 are valid
      // reference fields of BOTH shapes, so this never needs to know which.
      if (roots[slot] != 0 && roots[slot2] != 0) {
        storeWord(roots[slot] + field, roots[slot2])
      }
    } else if (op == 12) {
      roots[slot] = 0
    } else if (op == 13) {
      gcCollectRoots(g, rootsAddr, ROOTS)
    }

    step = step + 1

    if (step % RECORD_EVERY == 0) {
      let n = gcNumObjects(g)
      // #3178: neither `Node` nor `Wide` is ever large, so the hash index
      // must hold exactly 0 entries at every record — not `n`.
      if (gcIndexEntries(g) != 0) {
        indexAgree = 0
      }
      print("${step} ${n} ${gcLiveBytes(g)} ${gcStatCollections(g)} ${gcStatTotalSwept(g)} ${gcStatSurvivorsLast(g)} ${gcIndexEntries(g)}\n")
    }
  }

  // The index and the authoritative linear scan must give the same answer for
  // every root, for an interior pointer, and for a foreign address — the
  // membership contract of ABI.md §3. This is the property the fast path exists
  // to preserve, so it is checked against the oracle rather than assumed.
  let i = 0
  while (i < ROOTS) {
    let r = roots[i]
    if (r != 0) {
      if (gcOwns(g, r) != gcOwnsLinear(g, r)) {
        ownsAgree = 0
      }
      if (!gcOwns(g, r)) {
        ownsAgree = 0
      }
      // An interior pointer is not an object base and must be rejected by both.
      if (gcOwns(g, r + 8) != gcOwnsLinear(g, r + 8)) {
        ownsAgree = 0
      }
    }
    i = i + 1
  }
  if (gcOwns(g, 4096) || gcOwnsLinear(g, 4096)) {
    ownsAgree = 0
  }

  // CONSERVATIVE ROOT PROBING (ABI.md §5) — and the reason `gcMarkRoot`
  // validates at all.
  //
  // A conservative stack scan hands the collector raw machine words, and the
  // type system additionally calls several single-word values "references" that
  // are NOT GC objects: a `chan` handle is page-allocated and process-lifetime,
  // a bare function value is a code address. Both the stack maps (§4) and object
  // pointer maps (§2) legitimately list them. A blind mark would decode
  // `word - 32` as a `GcHeader` and corrupt the heap.
  //
  // So this collection seeds NO real roots — only words that are inside the
  // collector's address window but are not object bases: the interior of every
  // live object, and every live object's HEADER address. Every one must be
  // rejected, so the outcome is identical to a collection with an empty root
  // set: the entire heap goes. That is what makes the `owns` check in
  // `gcMarkRoot` load-bearing rather than decorative — without it these words
  // mark garbage and the table diverges.
  gcMarkBegin(g)
  let c = 0
  while (c < ROOTS) {
    let r = roots[c]
    if (r != 0) {
      gcMarkConservative(g, r + 8)            // interior pointer
      gcMarkConservative(g, r - gcHeaderSize) // the header, not the body
    }
    c = c + 1
  }
  gcCollectFinish(g)

  let idxOk = 0
  if (gcIndexEnabled(g)) {
    idxOk = 1
  }
  print("done ${gcNumObjects(g)} ${gcStatTotalAllocated(g)} ${gcStatTotalSwept(g)} ${gcStatBadOffsets(g)} ${indexAgree} ${ownsAgree} ${idxOk} ${gcIndexEntries(g)}\n")

  // #4083's two arms. Both denominators are printed so a run that silently
  // examined nothing cannot read as a pass.
  let tally = []i64(2)
  let sizesBad = sizeRoundTrip(g, metaAddr + MI_LEAF * 8, rootsAddr, roots, tally)
  let lost = refArrayTrace(g, refArrInfo, nodeInfo, rootsAddr, roots, tally)

  // `alive` IS LOAD-BEARING AND IS IN THE GOLDEN LINE ON PURPOSE. The file
  // header above says the backing slices stay alive under BIT_GC=stress because
  // they are "held in `main` for the whole program". That is a claim, and it is
  // false: `gcBindMemory` takes their raw addresses early and nothing in `main`
  // READS them again, so once their last use is behind the program counter the
  // LIVE collector may sweep them — and the scripted collector then writes into
  // freed memory. The 600-step workload survived only by sitting close enough
  // to that last use.
  //
  // Measured, not theorised: each of the two arms above segfaults under
  // BIT_GC=stress without this read and passes with it. Reading the lengths
  // into the golden output is what makes the keep-alive a CHECKED fact rather
  // than a comment — delete it and the fixture goes red instead of going quiet.
  let alive = len(arena) + len(indexArena) + len(heapBlock) + len(meta) + len(state) + len(roots)
  print("hdrpack sizes=${tally[0]} residues=${sizesBad} refs=${tally[1]} lost=${lost} bad=${gcStatBadOffsets(g)} alive=${alive}\n")
}
