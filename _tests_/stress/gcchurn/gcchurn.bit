// A nested-reference class and a value-capturing closure, established before a
// loop that allocates and discards a fresh graph every iteration. Under
// BIT_GC=stress the collector runs at every back-edge, so `keep` and `f` are
// re-proven live tens of thousands of times; the precise stack walk and pointer
// maps must keep them (and everything they reach) rooted, or this prints wrong.
class Inner { v: i64 }
class Outer { a: Inner, b: Inner }

fn main() {
  let keep = Outer{ a: Inner{ v: 11 }, b: Inner{ v: 22 } }
  let cap = 33
  let f = (x: i64) => x + cap
  let i = 0
  while (i < 20000) {
    let junk = Outer{ a: Inner{ v: i }, b: Inner{ v: 0 - i } }
    i = i + 1
  }
  print("${keep.a.v + keep.b.v} ${f(0)}\n")
}
