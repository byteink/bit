// The "foreign" side of ../externbracket.bit: a pinned definition (§11.9) the
// root module reaches through an `extern fn` (§11.7), so the call crosses the
// boundary the compiler brackets on every target, with no libc to supply a
// blocking function on a static ELF.
//
// It blocks the calling OS thread in the runtime's raw park sleep, which polls
// nothing and enters no bracket of its own: exactly the shape of a C library
// `read` or `sleep`.
extern fn bit_rt_port_park_sleep_ns(ns: int, scratch: *i64)

let scratch: [2]i64

export @symbol("bit_foreign_block") fn foreignBlock(ns: i64) {
  bit_rt_port_park_sleep_ns(int(ns), ptrOf(scratch))
}
