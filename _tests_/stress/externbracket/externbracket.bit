// A blocking `extern fn` call does not hold its worker (#7842, SPEC §11.7,
// runtime/ABI.md §8.5). The compiler wraps every user extern call in
// `bit_rt_gc_syscall_begin`/`_end`, so the monitor thread's retake
// (`rootRetakeScan`) sees the worker's slot in `syscall` state and runs the tasks
// queued behind it on a peer. ../schedretake is the same scene with the bracket
// written by hand; here the program writes none.
//
// `workers` pins BIT_WORKERS=1, the case where it matters: `blocker` takes the
// only worker into `bit_foreign_block` (a pinned function in ./rt that blocks the
// OS thread in a raw kernel wait, standing in for a C library's `read` or
// `sleep`) and `starter`, spawned behind it, is what `main` waits for. Unbracketed
// `starter` runs when the foreign call returns, measured 2005 ms behind a 2 s
// block (#7836). Bracketed it runs one retake later, a few ms.
//
// Each round also requires that `blocker` really is inside the foreign call when
// `starter` runs (`entered`), so a round in which `starter` ran first cannot pass
// without the bracket.
//
// THE TIMER ROUND RUNS FIRST, while the pool is still the one worker (#7866):
// `main` sleeps 5 ms on a timer behind `blocker`, so the work stranded behind
// the foreign call is a timer, in no queue at all. Before the retake counted
// timers `main` woke when the call returned, 1495-1505 ms late.
import { foreignBlock } from "./rt"

extern fn bit_foreign_block(ns: i64)

const blockNs: int = 1500000000
const lagMaxNs: int = 400000000
const rounds: int = 5
const napNs: int = 5000000

let entered: [1]i64

fn blocker() {
  atomicAdd(ptrOf(entered), 1)
  bit_foreign_block(blockNs)
}

fn starter(out: chan<int>) {
  out <- int(atomicLoad(ptrOf(entered)))
}

// `main` asleep on a timer while the only worker is inside the foreign call.
fn timerRound(): int {
  let t0 = timeMonoNs()
  spawn blocker()
  timeSleepNs(napNs)
  let lag = timeMonoNs() - t0
  if (atomicLoad(ptrOf(entered)) != 1) {
    print("externbracket FAIL timer round: main woke before blocker entered the foreign call\n")
    return 1
  }
  if (lag > lagMaxNs) {
    print("externbracket FAIL timer round: main woke ${lag / 1000000} ms after a ${napNs / 1000000} ms sleep (want <= ${lagMaxNs / 1000000})\n")
    return 1
  }
  return 0
}

fn main(): int {
  foreignBlock(1) // the Bit-side call: proves ./rt is linked and the pin resolves
  let starts = chan<int>(1)
  let bad = timerRound()
  for (let r = 1; r <= rounds; r++) {
    let t0 = timeMonoNs()
    spawn blocker()
    spawn starter(starts)
    let sawEntered = <- starts
    let lag = timeMonoNs() - t0
    if (sawEntered != r + 1) {
      print("externbracket FAIL round ${r}: starter ran before blocker entered the foreign call\n")
      bad = bad + 1
    } else if (lag > lagMaxNs) {
      print("externbracket FAIL round ${r}: starter ran ${lag / 1000000} ms after spawn (want <= ${lagMaxNs / 1000000})\n")
      bad = bad + 1
    }
  }
  if (bad != 0) {
    return 1
  }
  print("externbracket: ok\n")
  return 0
}
