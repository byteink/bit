// #5846's alloc-cache migration proof, Darwin binding. The properties, and
// why each one discriminates, live in `../thread/allocmigrate`. This file
// supplies only the platform thread provider. Darwin-only by construction,
// hence the sibling `darwin-only` marker: the provider declares `extern
// function`s (SPEC §11.7), which the compiler rejects on both Linux targets
// with E0078 even for an uncalled declaration. Kept identical in shape to
// its Linux twin (`../gcallocmigratelinux`), so a future divergence between
// the two means a real platform difference rather than a spelling one.
//
// Own private GC state (`gcBindMemory`/`gcInit`-bound arena), so this needs
// a `no-collect` marker for the same reason `../gcslotbitmap`'s does: none
// of the assertions depend on the AMBIENT collector ever running.
import { migrateRun } from "../thread/allocmigrate"
import { threadStart, threadRelease } from "../../../runtime/thread/darwin"
import { parkSleepNs, parkMonoNs } from "../../../runtime/park/darwin"

// `migrateRun` takes `sleepFn` as the generic `(int) => ()` shape shared
// with the Linux twin — `parkSleepNs` no longer fits it directly now that it
// takes a caller-owned scratch (#2318), so this adapts it back using this
// thread's own scratch, which nothing else on this OS thread touches
// concurrently.
let sleepScratch: [2]i64

fn sleepAdapt(ns: int) {
  parkSleepNs(ns, ptrOf(sleepScratch))
}

fn main() {
  let r = migrateRun(threadStart, threadRelease, sleepAdapt, parkMonoNs)
  print("gcallocmigrate started=${r.started} joined=${r.joined} released=${r.released} naiveShort=${r.naiveShort} exactMatch=${r.exactMatch}\n")
}
