// Property (n), #4044's `allocSlotIndex`. Sibling of `./alloc.bit`, same module
// (SPEC §17.1) — `allocNumClasses`, `allocClassSize`, `allocSpanBytes` and
// `allocSpanSlots` are already imported there and are visible here with no
// import, the same arrangement `./classify.bit` and `./spancache.bit` use.
//
// NO HEAP AND NO ARENA. `allocSlotIndex(addr, idx)` reads no memory at all:
// `allocSpanOf` is a mask over the address and everything else is arithmetic on
// `idx`. So the whole property runs on synthetic addresses derived from a
// nominal span base, which is what makes it cheap enough to sweep every class.
//
// WHAT IT IS FOR, and it is two separate things.
//
//   1. THE GUARDS. `off < 0`, `off % cs != 0` and `n >= slots` are the reason
//      `gcOwns` (ABI.md §3, and #3177 made it the production reader for every
//      span-backed membership query) may be fed an arbitrary conservatively
//      scanned stack word. Floor division alone aliases every interior address
//      inside a slot onto that slot's own index, so an interior pointer would
//      answer as if it were the slot base — and a slot index that answers for a
//      non-base address is a live-object-swept bug, not a tidiness issue. This
//      checks an interior address (base + 8), an address below the carve start,
//      and the first address past the last carved slot.
//
//   2. THE INLINED SLOT COUNT. #4044 stopped `allocSlotIndex` calling
//      `allocSpanSlots` and spelled its one-line body out from values already
//      in hand. That is a COPY of a formula, and a copy that drifts from the
//      exported `allocSpanSlots` would mis-bound the occupied-slot bitmap in
//      exactly the direction nothing else notices — a few slots too many is a
//      write past the bitmap, a few too few is an object the collector cannot
//      see. So the last carved slot and the one past it are asked of THIS
//      function while the boundary between them comes from `allocSpanSlots`:
//      the two must agree for every class or this arm reddens.
//
// EVERY SWEEP IS `@nosplit`, for the same reason `./classify.bit`'s are: this
// program runs under `BIT_GC=stress`, which collects at every safepoint, and a
// back edge is a safepoint. The whole call tree is already `@nosplit` (§17.6),
// so nothing had to be weakened to get it.
//
// The nominal span base is a multiple of `allocSpanBytes` well clear of zero,
// which is all `allocSpanOf`'s mask needs; no page is mapped there and none is
// touched.
const SLOT_SPAN_BASE = 8 * 131072 // 8 * allocSpanBytes

// Checks for one class. Returns the number of assertions that PASSED, so the
// caller's total doubles as the vacuity check — a sweep that ran zero
// iterations reports 0, not "no failures found".
@nosplit fn slotIndexAt(idx: int): int {
  let ok = 0
  let cs = allocClassSize(idx)
  let slots = allocSpanSlots(idx)
  let carve = SLOT_SPAN_BASE + (allocSpanBytes / cs - slots) * cs

  // The first and last carved slot bases answer their own index.
  if (allocSlotIndex(carve, idx) == 0) {
    ok = ok + 1
  }
  if (allocSlotIndex(carve + (slots - 1) * cs, idx) == slots - 1) {
    ok = ok + 1
  }

  // One slot past the last carved slot is out of range.
  if (allocSlotIndex(carve + slots * cs, idx) == -1) {
    ok = ok + 1
  }

  // An interior address inside the first slot is NOT its base. Class 0 is 8
  // bytes and has no interior word, so probe at +8 only where one exists.
  if (cs > 8) {
    if (allocSlotIndex(carve + 8, idx) == -1) {
      ok = ok + 1
    }
  } else {
    ok = ok + 1
  }

  // The span header itself is below the carve start.
  if (allocSlotIndex(SLOT_SPAN_BASE, idx) == -1) {
    ok = ok + 1
  }
  return ok
}

fn slotIndexRun() {
  let checks = 0
  let ok = 0
  let i = 0
  while (i < allocNumClasses) { // bounded: allocNumClasses iterations
    checks = checks + 5
    ok = ok + slotIndexAt(i)
    i = i + 1
  }
  let good = 0
  if (checks > 0 && ok == checks) {
    good = 1
  }
  print("slotidx=${good}/${checks}\n")
}
