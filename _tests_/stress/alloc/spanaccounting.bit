// Properties (j) #2374 and (k) #2375. Sibling of `./alloc.bit`, same module
// (SPEC §17.1) — everything `./alloc.bit` imports (heap*, alloc*, spin*, ...)
// and everything it declares at module scope (`spanTake`, `OCC_CLASS`,
// `OCC_SPANS`, `REC_SPANS`) is visible here with no import, the same
// arrangement `./spancache.bit` and `./classify.bit` use. Split out to keep
// `alloc.bit` under `_tests_/bit/lintfilelines.bit`'s 800-line gate (E0200) —
// see `bitlang-ws/CLAUDE.md`'s "Splitting a file" section: this seam declares
// nothing an earlier-sorting sibling could forward-reference, so there is no
// ordering question, only a diagnostic-order one the differentials would
// catch. `occRun` and `recRun` each recompute their own `perSpan`/`occCs` —
// both pure calls to `allocSpanSlots`/`allocClassSize` — rather than share
// state with the other, so the two properties are independently callable.
//
//   (j) PER-SPAN OCCUPANCY — the property #2374 exists to establish. Every slot
//       of one size class is taken across THREE spans, then freed in a
//       scrambled order, and after every single free each span's own free count
//       must equal a tally this file computes from the slot addresses alone.
//       The independence is the point: `allocSpanOf` is a mask over the
//       address, so a take or give that credited the wrong span leaves every
//       aggregate over the class exactly right — `liveBytes`, the class total,
//       even `sum over spans of (total - free)` — and only a per-span
//       comparison sees it. Mutation-tested: masking one bit too few in
//       `heapGiveSmallLocked` fails this and nothing else in the corpus.
//       The scrambled order is a Fisher-Yates shuffle rather than a stride, so
//       it stays a permutation if the slots-per-span count ever moves; a stride
//       that stopped being coprime would free an address twice.
//
//   (k) SPAN RECLAMATION — the property #2375 exists to establish, and the one
//       that turns 0% returned into 99%. Four spans of one class are filled,
//       every slot is freed, and the class must then hand back all but the
//       anchor: the chain the pass returns is checked span by span, and the
//       retained anchor must still serve exactly its own slot count and no
//       address outside itself. That last half is the one that matters — a pass
//       that unlinks the SPANS but leaves their slots on the class's free list
//       hands out an address inside memory the caller has already unmapped, and
//       every aggregate counter still balances.

// The third private heap plus the per-span and per-slot tallies property (j)
// keeps beside it. `h`/`lk` are RAW pointers into `occRun`'s own `[]i64`/`[]i32`
// locals, which is why those two stay locals of that frame for the whole run —
// nothing else keeps them alive. The four slices here are managed and are traced
// through this class, the same division `../alloc/props`' `PageHeap` draws.
class OccRig {
  h: *i64,
  lk: *i32,
  cs: int,
  perSpan: int,
  span: []i64,
  freed: []i64,
  addr: []i64,
  owner: []i64,
}

// Three spans up front. Each must report the class it was carved for, the
// slot count the class expects, and no slot handed out yet.
fn occFill(r: OccRig, a: []i64): int {
  let ok = 1
  let oi = 0
  while (oi < OCC_SPANS) { // bounded: OCC_SPANS
    let sp = spanTake(a)
    r.freed[oi] = 0
    if (sp == 0) {
      ok = 0 // arena exhausted
    } else {
      r.span[oi] = sp
      spinAcquire(r.lk)
      heapRefillLocked(r.h, OCC_CLASS, sp, false)
      spinRelease(r.lk)
      if (allocSpanOf(sp) != sp) {
        ok = 0
      } // spans are self-aligned
      if (allocSpanClass(sp) != OCC_CLASS) {
        ok = 0
      }
      if (allocSpanTotal(sp) != r.perSpan) {
        ok = 0
      }
      if (allocSpanFree(sp) != r.perSpan) {
        ok = 0
      }
    }
    oi = oi + 1
  }
  return ok
}

// Which of the three spans owns `addr`, by the mask alone; -1 for none.
fn occOwnerOf(r: OccRig, addr: int): int {
  let owner = -1
  let oj = 0
  while (oj < OCC_SPANS) { // bounded: OCC_SPANS
    if (allocSpanOf(addr) == r.span[oj]) {
      owner = oj
    }
    oj = oj + 1
  }
  return owner
}

// Take every slot the three spans hold. Each address must belong to one of
// them, by the mask alone.
fn occTakeAll(r: OccRig): int {
  let ok = 1
  let ti = 0
  while (ti < len(r.addr)) { // bounded: len(r.addr)
    spinAcquire(r.lk)
    let addr = heapTakeSmallLocked(r.h, OCC_CLASS, r.cs)
    spinRelease(r.lk)
    r.addr[ti] = addr
    r.owner[ti] = 0
    let owner = occOwnerOf(r, addr)
    if (addr == 0 || owner < 0) {
      ok = 0
    } else {
      r.owner[ti] = owner
    }
    ti = ti + 1
  }
  return ok
}

// Fully occupied: every span reads zero free, and one more take must FAIL
// rather than re-serve a live slot.
fn occFullCheck(r: OccRig): int {
  let ok = 1
  let oc = 0
  while (oc < OCC_SPANS) { // bounded: OCC_SPANS
    if (allocSpanFree(r.span[oc]) != 0) {
      ok = 0
    }
    oc = oc + 1
  }
  spinAcquire(r.lk)
  let extra = heapTakeSmallLocked(r.h, OCC_CLASS, r.cs)
  spinRelease(r.lk)
  if (extra != 0) {
    ok = 0
  }
  return ok
}

// A deterministic Fisher-Yates over the slot indices. A permutation by
// construction, so no address can be freed twice if `perSpan` ever moves.
fn occOrderOf(n: int): []i64 {
  let order = []i64(n)
  let po = 0
  while (po < n) {
    order[po] = po
    po = po + 1
  } // bounded: n
  let seed = 12345
  let sw = n - 1
  while (sw > 0) { // bounded: n - 1
    seed = (seed * 1103515245 + 12345) % 2147483648
    let pick = seed % (sw + 1)
    let tmp = order[sw]
    order[sw] = order[pick]
    order[pick] = tmp
    sw = sw - 1
  }
  return order
}

// The property: after EVERY free, each span's own free count equals the tally
// kept here from the addresses alone.
//
// `heapGiveSmallLocked`'s result is DISCARDED here, deliberately: it is a
// request for a reclaim pass, and it cannot fire on this heap — the pass is
// only asked for when an emptied span is `owned`, and every span `occFill`
// refills is `owned: false`. Property (k) below is where `owned` is true and
// where that request is asserted (`asked`).
fn occFreeScrambled(r: OccRig, order: []i64): int {
  let ok = 1
  let fi = 0
  while (fi < len(r.addr)) { // bounded: len(r.addr)
    let k = order[fi]
    spinAcquire(r.lk)
    let _ = heapGiveSmallLocked(r.h, r.addr[k], OCC_CLASS, r.cs)
    spinRelease(r.lk)
    let own = r.owner[k]
    r.freed[own] = r.freed[own] + 1
    let cj = 0
    while (cj < OCC_SPANS) { // bounded: OCC_SPANS
      if (allocSpanFree(r.span[cj]) != r.freed[cj]) {
        ok = 0
      }
      cj = cj + 1
    }
    fi = fi + 1
  }
  return ok
}

// Everything back: each span wholly free, no live bytes, and the runtime's own
// cross-check of `sum over spans of (total - free)` against the class's live
// slot count agrees.
fn occDrained(r: OccRig): int {
  let ok = 1
  let oe = 0
  while (oe < OCC_SPANS) { // bounded: OCC_SPANS
    if (r.freed[oe] != r.perSpan || allocSpanFree(r.span[oe]) != r.perSpan) {
      ok = 0
    }
    oe = oe + 1
  }
  if (heapLiveBytes(r.h) != 0) {
    ok = 0
  }
  spinAcquire(r.lk)
  let bad = heapCheckSpansLocked(r.h)
  spinRelease(r.lk)
  if (bad != 0 || heapSpanViolations(r.h) != 0) {
    ok = 0
  }
  return ok
}

// Property (j): every slot of `OCC_CLASS` taken across `OCC_SPANS` spans, then
// freed in a scrambled order, checking each span's own free count after every
// single free. A third private heap, so the class owns exactly the spans below
// and the tally has no other traffic to account for. Returns `(occOk, occN)`.
//
// `h3buf` and `l3buf` are locals of THIS frame for the whole run: `rig.h` and
// `rig.lk` are raw pointers into them and nothing else roots them, and a caller
// frame's slots are traced for the whole of a callee's run. Each phase's verdict
// is bound before they are combined, because every phase must RUN, in order —
// each one leaves the heap in the state the next one asserts against.
fn occRun(a: []i64): (int, int) {
  let h3buf = []i64(heapWords)
  let l3buf = []i32(1)
  let perSpan = allocSpanSlots(OCC_CLASS)
  let occN = OCC_SPANS * perSpan
  let rig = OccRig{
    h: ptrOf(h3buf),
    lk: ptrOf(l3buf),
    cs: allocClassSize(OCC_CLASS),
    perSpan: perSpan,
    span: []i64(OCC_SPANS),
    freed: []i64(OCC_SPANS),
    addr: []i64(occN),
    owner: []i64(occN),
  }
  atomicStore(rig.lk, spinUnlocked)
  heapInit(rig.h)

  let filled = occFill(rig, a)
  let taken = occTakeAll(rig)
  let full = occFullCheck(rig)
  let freed = occFreeScrambled(rig, occOrderOf(occN))
  let drained = occDrained(rig)

  return filled * taken * full * freed * drained, occN
}

// The fourth private heap and the two tallies property (k) keeps beside it.
// Same division as `OccRig`: `h`/`lk` are raw pointers into `recRun`'s locals,
// the slices are managed and traced through the class.
class RecRig {
  h: *i64,
  lk: *i32,
  cs: int,
  perSpan: int,
  span: []i64,
  addr: []i64,
}

// The chain the reclaim pass handed back: how many spans it held, and whether
// every one of them was releasable and none of them the anchor.
class RecChain {
  ok: int,
  got: int,
}

// Fill the class with `REC_SPANS` owned spans; the most recent refill is the
// anchor, and the anchor is what must survive the pass.
fn recFill(r: RecRig, a: []i64): int {
  let ok = 1
  let rs = 0
  while (rs < REC_SPANS) { // bounded: REC_SPANS
    let sp = spanTake(a)
    if (sp == 0) {
      ok = 0 // arena exhausted
      r.span[rs] = 0
    } else {
      r.span[rs] = sp
      spinAcquire(r.lk)
      heapRefillLocked(r.h, OCC_CLASS, sp, true)
      spinRelease(r.lk)
    }
    rs = rs + 1
  }
  if (heapClassSpans(r.h, OCC_CLASS) != REC_SPANS) {
    ok = 0
  }
  if (heapClassEmpty(r.h, OCC_CLASS) != REC_SPANS) {
    ok = 0
  }
  return ok
}

// Fill every span, which must take the releasable count to zero: a span with
// one slot handed out is not reclaimable, and that is the counter that decides.
fn recTakeAll(r: RecRig): int {
  let ok = 1
  let rt = 0
  while (rt < len(r.addr)) { // bounded: len(r.addr)
    spinAcquire(r.lk)
    let addr = heapTakeSmallLocked(r.h, OCC_CLASS, r.cs)
    spinRelease(r.lk)
    r.addr[rt] = addr
    if (addr == 0) {
      ok = 0
    }
    rt = rt + 1
  }
  if (heapClassEmpty(r.h, OCC_CLASS) != 0) {
    ok = 0
  }
  return ok
}

// Give it all back. The allocator must ASK for a pass at least once — a fix
// whose trigger never fires returns exactly as much memory as no fix at all.
fn recGiveAll(r: RecRig): int {
  let ok = 1
  let asked = 0
  let rg = 0
  while (rg < len(r.addr)) { // bounded: len(r.addr)
    spinAcquire(r.lk)
    let want = heapGiveSmallLocked(r.h, r.addr[rg], OCC_CLASS, r.cs)
    spinRelease(r.lk)
    asked = asked + want
    rg = rg + 1
  }
  if (asked == 0) {
    ok = 0
  }
  if (heapClassEmpty(r.h, OCC_CLASS) != REC_SPANS) {
    ok = 0
  }
  return ok
}

// The pass. Every span on the chain must be releasable and must NOT be the
// anchor, and the class must be left holding exactly the anchor.
fn recReclaim(r: RecRig, anchor: int): RecChain {
  let ok = 1
  spinAcquire(r.lk)
  let chain = heapReclaimSpansLocked(r.h, OCC_CLASS)
  spinRelease(r.lk)
  let got = 0
  let rc = chain
  while (rc != 0 && got <= REC_SPANS) { // bounded: REC_SPANS + 1
    if (rc == anchor || allocSpanOwned(rc) == 0) {
      ok = 0
    }
    if (allocSpanFree(rc) != r.perSpan) {
      ok = 0
    }
    got = got + 1
    rc = allocSpanNext(rc)
  }
  if (got != REC_SPANS - 1) {
    ok = 0
  }
  return RecChain{ ok: ok, got: got }
}

// What the class must look like once the pass has run: exactly the anchor, held
// once, with nothing live and the runtime's own span cross-check clean.
fn recSettled(r: RecRig): int {
  let ok = 1
  if (heapClassSpans(r.h, OCC_CLASS) != 1) {
    ok = 0
  }
  if (heapClassEmpty(r.h, OCC_CLASS) != 1) {
    ok = 0
  }
  if (heapLiveBytes(r.h) != 0) {
    ok = 0
  }
  spinAcquire(r.lk)
  let bad = heapCheckSpansLocked(r.h)
  spinRelease(r.lk)
  if (bad != 0 || heapSpanViolations(r.h) != 0) {
    ok = 0
  }
  return ok
}

// THE HALF THAT CATCHES A HALF-DONE UNLINK, and the reason the pass has two
// phases at all: the reclaimed spans' slots must be off the class's FREE list
// too. Leave one behind and the class serves an address inside memory its
// caller has already unmapped — a use-after-free that no aggregate counter can
// see. So the retained anchor must serve exactly `perSpan` slots, every one
// inside itself, and then report empty.
fn recAnchorServes(r: RecRig, anchor: int): int {
  let ok = 1
  let served = 0
  let done = 0
  let guard = 0
  while (done == 0 && guard <= r.perSpan) { // bounded: perSpan + 1
    spinAcquire(r.lk)
    let s5 = heapTakeSmallLocked(r.h, OCC_CLASS, r.cs)
    spinRelease(r.lk)
    if (s5 == 0) {
      done = 1
    } else {
      if (allocSpanOf(s5) != anchor) {
        ok = 0
      }
      served = served + 1
    }
    guard = guard + 1
  }
  if (done == 0 || served != r.perSpan) {
    ok = 0
  }
  if (allocSpanKeep < 2) {
    ok = 0
  } // see `allocSpanKeep`
  return ok
}

// Property (k): a class that has filled several spans and then had every slot
// freed gives all but one of them BACK, and the one it keeps still serves
// every allocation the class asks for.
//
// A FOURTH PRIVATE HEAP, AND THE ONLY PLACE THIS PROPERTY SAYS `owned` IS
// TRUE. The arena is a Bit-managed `[]i64`, so unmapping any of it would punch
// a hole in the live heap — and this test does not unmap. It does not have to:
// the allocator's contract is that IT unlinks and the CALLER releases, so a
// caller that declines to release still exercises every line of the
// bookkeeping. That split is what makes the property testable at all on a
// platform-free allocator. Returns `(recOk, recGot)`.
//
// `h4buf`/`l4buf` stay locals of THIS frame for the same reason `occRun`'s do,
// and each phase's verdict is bound before they are combined because every
// phase must run, in order.
fn recRun(a: []i64): (int, int) {
  let h4buf = []i64(heapWords)
  let l4buf = []i32(1)
  let perSpan = allocSpanSlots(OCC_CLASS)
  let rig = RecRig{
    h: ptrOf(h4buf),
    lk: ptrOf(l4buf),
    cs: allocClassSize(OCC_CLASS),
    perSpan: perSpan,
    span: []i64(REC_SPANS),
    addr: []i64(REC_SPANS * perSpan),
  }
  atomicStore(rig.lk, spinUnlocked)
  heapInit(rig.h)

  let filled = recFill(rig, a)
  let anchor = rig.span[REC_SPANS - 1]
  let taken = recTakeAll(rig)
  let given = recGiveAll(rig)
  let chain = recReclaim(rig, anchor)
  let settled = recSettled(rig)
  let serves = recAnchorServes(rig, anchor)

  return filled * taken * given * chain.ok * settled * serves, chain.got
}
