// Shared property checks for the page providers of runtime/alloc (#1362).
//
// The portable half is covered by `../alloc.bit`, which drives the
// real allocator over a slice-backed arena and so runs on every target. What it
// CANNOT cover is the piece that is genuinely per-platform: actually getting
// pages from the kernel. `runtime/alloc/linux` does that with a raw 6-argument
// `mmap` syscall (§11.8) and `runtime/alloc/darwin` with a libSystem `mmap`
// call (§11.7), and those two cannot appear in one module — so the driver is
// split into `../../alloclinux` and `../../allocdarwin`, and everything they
// assert lives HERE, shared verbatim, so the two platforms are held to an
// identical standard and cannot drift.
//
// The provider is taken as a function value rather than imported, which is what
// lets one copy of the properties serve both platforms (the same shape
// `../../rand/props` uses for its entropy source).
//
// Six properties. The first three are about the pages themselves; the last
// three run the REAL allocator on REAL kernel memory, which is the end-to-end
// path a shipped `libbitrt.a` will take and the only place a page-provider bug
// and an allocator bug can interact.
//
//   P1  PAGE SIZE is a power of two and at least 4096. Not cosmetic: the
//       allocator rounds every direct-mapped request up to it, and Darwin's
//       16384 differs from Linux's 4096, so a provider that guessed would be
//       caught here.
//
//   P2  A MAPPING IS REAL AND WRITABLE. The returned address is non-zero and
//       page-aligned, and every 4096th byte across the whole span is written
//       and read back. A provider that returned a plausible-looking address it
//       never mapped (mis-tested errno, wrong flags) faults or mismatches here
//       rather than corrupting the heap later.
//
//   P3  TWO MAPPINGS DO NOT OVERLAP, and the second survives writing the first.
//       This is what makes span carving safe.
//
//   P4  THE ALLOCATOR RUNS ON REAL PAGES: a churn of allocate/write/verify/free
//       against spans fetched from the kernel, with a unique sentinel per live
//       allocation that must still be intact at free time. Identical in spirit
//       to `../alloc.bit`'s churn, but every byte is kernel memory.
//
//   P5  COUNTERS ARE EXACT over that churn: `liveBytes` returns to 0 and
//       `mappedBytes` equals exactly the spans that were mapped.
//
//   P6  UNMAP SUCCEEDS for every span taken, and is rejected for a null
//       request. Returning the pages is what keeps a long-lived process from
//       growing without bound, and a silent failure is invisible otherwise.

import {
  allocSpanBytes, heapWords, allocAlignUp, allocClassify, allocLargeLen,
  heapInit, heapLiveBytes, heapMappedBytes,
  heapTakeSmallLocked, heapGiveSmallLocked, heapRefillLocked,
  heapLargeAllocLocked, heapLargeFreeLocked,
} from "../../../../runtime/alloc"
import { spinAcquire, spinRelease, spinUnlocked } from "../../../../runtime"

// One span is consumed per size class on that class's first allocation, and
// the churn's size range (1..1500) spans 23 distinct classes, so the cap must
// clear that with headroom or the churn starves and P4 fails.
const MAX_SPANS = 32
const RING = 64
const CHURN = 4000

// All six properties passed: P1|P2|P3|P4|P5|P6 = 1|2|4|8|16|32.
// A bitmask rather than a count so a failure names the property that broke.
export fn pageTotal(): int { return 63 }

// The `*i64` addressing the 8-aligned word at `addr`.
fn wordAt(addr: int): *i64 {
  let z: *i64 = nil
  return z + addr / 8
}

// Is `n` a power of two?
fn isPow2(n: int): bool {
  if (n <= 0) {
    return false
  }
  return (n & (n - 1)) == 0
}

// Span bookkeeping: addresses of the MAPPINGS handed to the heap, so P6 can give
// every one of them back.
//
// EACH MAPPING IS TWICE A SPAN AND THE SPAN IS ALIGNED INSIDE IT (#2374). `mmap`
// promises page alignment and nothing more — 4096 on Linux, 16384 on Darwin —
// while `heapRefillLocked` requires a span to start on a multiple of
// `allocSpanBytes` (131072), because that is what makes `allocSpanOf` a mask.
// The shipped runtime gets that from `runtime/gc/mem.bit`'s reserve, which
// aligns span-sized takes itself (#2373); this file IS the OS for the allocator,
// so it owes the same contract. Over-mapping by one span guarantees an aligned
// span fits, and `spans[]` keeps the RAW base so P6 unmaps exactly what was
// mapped.
const SPAN_MAP_BYTES = 262144 // allocSpanBytes * 2

// The heap under test and everything the composed entry points below need to
// reach it: the heap words, its lock, the page provider, the page size and the
// span bookkeeping. ONE VALUE RATHER THAN THE EIGHT PARAMETERS `heapAlloc` grew
// to (#4249). It holds only the raw `h`/`lk` and the two bookkeeping slices;
// `hbuf`/`lbuf` themselves stay locals of `pageProps` for the whole run, which
// is what keeps those raw pointers backed.
class PageHeap {
  h: *i64,
  lk: *i32,
  mapFn: (int) => int,
  ps: int,
  spans: []i64,
  count: []i64,
}

// P1..P3's verdict plus the result of the two probe unmaps they owe, which is
// P6's to fold in.
class PagePhase {
  mask: int,
  probeOk: bool,
}

// One live allocation per slot: its address, the size it was asked for and the
// sentinel written into its first word.
class Ring {
  addr: []i64,
  size: []i64,
  tag: []i64,
}

class SlotCheck {
  intact: int,
  checked: int,
}

class ChurnResult {
  ok: int,
  intact: int,
  checked: int,
}

fn spanTake(hp: PageHeap): int {
  if (hp.count[0] >= MAX_SPANS) {
    return 0
  }
  let raw = hp.mapFn(SPAN_MAP_BYTES)
  if (raw == 0) {
    return 0
  }
  hp.spans[hp.count[0]] = raw
  hp.count[0] = hp.count[0] + 1
  return allocAlignUp(raw, allocSpanBytes)
}

// The composed allocator entry point over real kernel pages. The lock is held
// across the whole operation including the page map, exactly as the deleted
// native runtime held it across its refill mmap.
fn heapAlloc(hp: PageHeap, size: int, alignment: int): int {
  spinAcquire(hp.lk)
  let addr = 0
  let idx = allocClassify(size, alignment)
  if (idx < 0) {
    let m = hp.mapFn(allocLargeLen(size, hp.ps))
    if (m != 0) {
      heapLargeAllocLocked(hp.h, size, allocLargeLen(size, hp.ps))
      addr = m
    }
  } else {
    addr = heapTakeSmallLocked(hp.h, idx, size)
    if (addr == 0) {
      let span = spanTake(hp)
      if (span != 0) {
        // `owned` is false: these spans come from real kernel pages this file
        // mapped and still owns, and nothing here releases one, so telling the
        // allocator it may unmap them would be a lie (#2375).
        heapRefillLocked(hp.h, idx, span, false)
        addr = heapTakeSmallLocked(hp.h, idx, size)
      }
    }
  }
  spinRelease(hp.lk)
  return addr
}

fn heapFree(hp: PageHeap, addr: int, size: int, alignment: int) {
  spinAcquire(hp.lk)
  let idx = allocClassify(size, alignment)
  if (idx < 0) {
    heapLargeFreeLocked(hp.h, size, allocLargeLen(size, hp.ps))
  } else {
    // The result is a REQUEST FOR A RECLAIM PASS, and it cannot fire here:
    // `heapGiveSmallLocked` counts an emptied span only when it is `owned`, and
    // every span `heapAlloc` refills above is `owned: false`, so the answer is
    // always 0. Discarded deliberately rather than checked, because a check
    // would assert the allocator's hysteresis, which `../alloc.bit` owns.
    let _ = heapGiveSmallLocked(hp.h, addr, idx, size)
  }
  spinRelease(hp.lk)
}

// ---- P2: a mapping is real, aligned and writable ----------------------------
// Leaves `off + 12345` in every 4096th word, and P3 reads the first one back.
fn spanWritable(one: int, ps: int): bool {
  if (one == 0 || one % ps != 0) {
    return false
  }
  // Touch every 4096th byte across the span and read it back.
  let off = 0
  while (off < allocSpanBytes) { // bounded: allocSpanBytes/4096 steps
    let w = wordAt(one + off)
    *w = off + 12345
    off = off + 4096
  }
  let ok = true
  off = 0
  while (off < allocSpanBytes) { // bounded: allocSpanBytes/4096 steps
    let w = wordAt(one + off)
    let got = *w
    if (got != off + 12345) {
      ok = false
    }
    off = off + 4096
  }
  return ok
}

// ---- P3: two mappings are disjoint ------------------------------------------
fn spansDisjoint(one: int, two: int): bool {
  if (two == 0 || one == 0) {
    return false
  }
  let disjoint = two + allocSpanBytes <= one || one + allocSpanBytes <= two
  // The first span's pattern must survive mapping and writing the second.
  let w2 = wordAt(two)
  *w2 = 999
  let w1 = wordAt(one)
  let still = *w1
  return disjoint && still == 12345
}

// ---- P1+P2+P3: the pages themselves, before any allocator runs ---------------
fn mappingProps(
  mapFn: (int) => int, unmapFn: (int, int) => bool, ps: int,
): PagePhase {
  let mask = 0
  // ---- P1: page size --------------------------------------------------------
  if (ps >= 4096 && isPow2(ps)) {
    mask = mask | 1
  }
  let one = mapFn(allocSpanBytes)
  if (spanWritable(one, ps)) {
    mask = mask | 2
  }
  let two = mapFn(allocSpanBytes)
  if (spansDisjoint(one, two)) {
    mask = mask | 4
  }
  return PagePhase{
    mask: mask,
    probeOk: unmapFn(one, allocSpanBytes) && unmapFn(two, allocSpanBytes),
  }
}

// The check-and-free the churn loop and the survivor drain share verbatim: a
// live slot's sentinel must still be intact when it goes back.
fn drainSlot(hp: PageHeap, r: Ring, slot: int): SlotCheck {
  let old = r.addr[slot]
  if (old == 0) {
    return SlotCheck{ intact: 0, checked: 0 }
  }
  let w = wordAt(old)
  let seen = *w
  let intact = 0
  if (seen == r.tag[slot]) {
    intact = 1
  }
  heapFree(hp, old, r.size[slot], 8)
  r.addr[slot] = 0
  return SlotCheck{ intact: intact, checked: 1 }
}

// ---- P4: allocate/write/verify/free against kernel pages ---------------------
fn churnProps(hp: PageHeap): ChurnResult {
  let r = Ring{ addr: []i64(RING), size: []i64(RING), tag: []i64(RING) }
  let intact = 0
  let checked = 0
  let churnOk = 1
  let n = 0
  while (n < CHURN) { // bounded: CHURN iterations
    let slot = n % RING
    let c = drainSlot(hp, r, slot)
    intact = intact + c.intact
    checked = checked + c.checked
    let sz = 1 + n * 37 % 1500
    let addr = heapAlloc(hp, sz, 8)
    if (addr == 0) {
      churnOk = 0 // exhausted: never deref
    } else {
      if (addr % 8 != 0) {
        churnOk = 0
      }
      let tag = n * 2654435761 + 7
      let w2 = wordAt(addr)
      *w2 = tag
      r.addr[slot] = addr
      r.size[slot] = sz
      r.tag[slot] = tag
    }
    n = n + 1
  }
  // Drain survivors.
  let d = 0
  while (d < RING) { // bounded: RING iterations
    let c = drainSlot(hp, r, d)
    intact = intact + c.intact
    checked = checked + c.checked
    d = d + 1
  }
  return ChurnResult{ ok: churnOk, intact: intact, checked: checked }
}

// ---- P6: every span goes back, and a null request is refused -----------------
fn spansReturned(hp: PageHeap, unmapFn: (int, int) => bool): bool {
  let ok = true
  let u = 0
  while (u < hp.count[0]) { // bounded: MAX_SPANS iterations
    if (!unmapFn(hp.spans[u], SPAN_MAP_BYTES)) {
      ok = false
    }
    u = u + 1
  }
  if (unmapFn(0, allocSpanBytes)) {
    ok = false // null must be refused
  }
  return ok
}

// ---- P4/P5/P6: the real allocator over real pages ----------------------------
fn heapProps(hp: PageHeap, unmapFn: (int, int) => bool, probeOk: bool): int {
  let mask = 0
  let churn = churnProps(hp)
  if (churn.ok == 1 && churn.checked == CHURN && churn.intact == CHURN) {
    mask = mask | 8
  }
  if (heapLiveBytes(hp.h) == 0 && heapMappedBytes(hp.h) == hp.count[0] * allocSpanBytes) {
    mask = mask | 16
  }
  if (spansReturned(hp, unmapFn) && probeOk) {
    mask = mask | 32
  }
  return mask
}

// Runs every property against the supplied page provider; returns the number
// that passed as a bitmask (compare against `pageTotal()`).
export fn pageProps(
  mapFn: (int) => int, unmapFn: (int, int) => bool,
  pagesize: () => int,
): int {
  let ps = pagesize()
  let phase = mappingProps(mapFn, unmapFn, ps)

  // `hbuf` and `lbuf` are locals of THIS frame for the whole run: `hp.h` and
  // `hp.lk` are raw pointers into them, and nothing else keeps them alive.
  let hbuf = []i64(heapWords)
  let lbuf = []i32(1)
  let hp = PageHeap{
    h: ptrOf(hbuf),
    lk: ptrOf(lbuf),
    mapFn: mapFn,
    ps: ps,
    spans: []i64(MAX_SPANS),
    count: []i64(1),
  }
  atomicStore(hp.lk, spinUnlocked)
  hp.count[0] = 0
  heapInit(hp.h)

  return phase.mask | heapProps(hp, unmapFn, phase.probeOk)
}
