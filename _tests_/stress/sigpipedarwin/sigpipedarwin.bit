// Darwin proof that `runtime/root/darwin`'s `ignoreSigpipe` (#1615) actually
// changes the process's SIGPIPE disposition — not merely that it links.
//
// The test is the whole point of the primitive: install SIG_IGN, then WRITE to a
// pipe whose read end has been closed. With the disposition changed the write
// returns -1 (EPIPE) and the process lives to print its line; with the default
// disposition the same write raises SIGPIPE and the kernel kills the process
// before any output, which the stress harness sees as a non-zero exit and a
// missing `.expected` — i.e. red. So a wrong signal number, or SIG_DFL instead
// of SIG_IGN, reddens this test rather than passing it silently.
//
// Darwin-only: `pipe`/`close`/`write` here are libSystem `extern function`s
// (§11.7), which Bit's fully static ELF output cannot bind — the Linux mirror is
// ../sigpipelinux, using raw syscalls. Straight-line and about signal
// disposition, not rooting, so it carries a `no-collect` marker.

import { ignoreSigpipe } from "../../../runtime/root/darwin"
import { loadWord } from "../../../runtime/gc"

// libSystem process/IO calls. `pipe(int fds[2])` fills a two-`int` array (read
// fd, write fd); `close`/`write` are the standard POSIX shapes. Pointers cross
// as `*u8`, counts/codes as `i32`/`i64` (§11.7).
extern fn pipe(fds: *u8): i32
extern fn close(fd: i32): i32
extern fn write(fd: i32, buf: *u8, n: i64): i64

// Low-32 / high-32 split of the packed `{read, write}` fd word `pipe` writes.
const fdMask: int = 4294967295
const fdShift: int = 4294967296

fn main() {
  let rc = ignoreSigpipe()

  // A pipe, then close its read end so the write end has no reader. Both fds
  // land packed into one 8-byte cell: read in the low 32 bits, write in the high.
  let fdcell = []i64(1)
  let nilp: *u8 = nil
  let pr = int(pipe(nilp + int(ptrOf(fdcell))))
  if (pr != 0) {
    print("pipe failed pr=${pr}\n")
    return
  }
  let packed = loadWord(int(ptrOf(fdcell)))
  let readFd = packed & fdMask
  let writeFd = (packed / fdShift) & fdMask
  close(i32(readFd))

  // The write that would raise SIGPIPE. Reaching the line below at all proves
  // the signal was ignored; `wrote` proves the kernel reported EPIPE (-1) rather
  // than the write succeeding.
  let msg = []int(1)
  msg[0] = 65
  let wrote = int(write(i32(writeFd), nilp + int(ptrOf(msg)), i64(1)))

  print("sig=${rc} pipe=${pr} wrote=${wrote}\n")
}
