// #7404: a task readied through a channel must run promptly while its waker
// keeps running and every other worker is idle.
//
// `schedUnpark` puts the readied task in the WAKER's next-run slot, which only
// the waker's worker takes on its own find-work pass. A waker that keeps
// running after the send (an atomic `Mutex` unlock, a producer filling a
// buffered channel) left the task there until a parked peer's `idleParkMaxNs`
// timeout (100ms, `runtime/sched/sleep.bit`) or until the waker blocked:
// measured at up to 190ms per round. The slot path now wakes one parked peer
// as a spinner, which steals the slot from its idle turn.
//
// Each round `main` sleeps so the other workers park (pinned to BIT_WORKERS=4
// by the sibling `workers` file), readies `waiter` with a timestamp, then spins
// on an atomic without blocking until the waiter reports its ready-to-run
// latency or `spinCapNs` passes. The budget separates the timeout-bound shape
// from host noise, ten times wider under BIT_GC=stress (`budgetFor`); the diag
// line prints the worst latency whatever the budget.

import { AtomicI64 } from "std/sync"
import { budgetFor } from "../../bit/timerctl"

const rounds: int = 100
const settleNs: int = 1000000
const budgetNs: int = 20000000

class Round {
  ready: chan<int>,
  fin: chan<bool>,
  lat: AtomicI64,
}

fn waiter(r: Round) {
  let t = <- r.ready
  r.lat.store(i64(timeMonoNs() - t))
  r.fin <- true
}

// One round's ready-to-run latency in nanoseconds. The spin is bounded by the
// clock, so a stranded waiter ends it at `spinCapNs` and `main` blocks on `fin`.
fn runRound(spinCapNs: int): int {
  let r = Round{ ready = chan<int>(1), fin = chan<bool>(1), lat = AtomicI64(0) }
  spawn waiter(r)
  timeSleepNs(settleNs)
  r.ready <- timeMonoNs()
  let t0 = timeMonoNs()
  while (r.lat.load() == 0 && timeMonoNs() - t0 < spinCapNs) {}
  let _ = <- r.fin
  return int(r.lat.load())
}

fn main() {
  let budget = budgetFor(budgetNs)
  let worst = 0
  let over = 0
  let i = 0
  while (i < rounds) {
    let lat = runRound(budget * 3)
    if (lat > worst) {
      worst = lat
    }
    if (lat > budget) {
      over = over + 1
    }
    i = i + 1
  }
  eprint("readywake: worst ${worst / 1000}us, ${over}/${rounds} over ${budget / 1000}us\n")
  print("readywake ${over == 0}\n")
}
