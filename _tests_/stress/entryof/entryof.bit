// `entryOf(f)` (§11.10) — a named function's code entry address, and the reason
// it had to exist: without it a green thread cannot be started from Bit at all.
// `initialContext` must write a new task's `pc`, and until this builtin there
// was no expression yielding one. `int(f)` compiles but yields the CLOSURE
// object's heap address — a different value on every run and on every read — so
// a task context built from it would branch into the heap.
//
// The proof here is the ENTRY, not the arithmetic. Nothing below inspects the
// number: a context is built exactly as a scheduler builds one (the address
// written into a saved-register slot), and then a second asm block loads that
// slot back and branches to it. The function only runs — and `main` only prints
// 42 — if the word in the slot really was `taskBody`'s first instruction.
//
// Mutation-tested rather than assumed: perturbing the stored address by +8
// crashes (SIGBUS, exit 138), and pointing the slot at a different function
// returns that function's value instead. Both were checked before this test was
// trusted, on all three targets.

fn taskBody(): int { return 42 }

// The control: a SECOND function, to pin down that the address selects a
// specific body rather than landing somewhere that happens to work. If `entryOf`
// returned a constant, or the same address for everything, `enter` would return
// 42 for this one too and (b) would fail.
fn otherBody(): int { return 99 }

// A task's saved register context, in the shape a scheduler builds: slot 0 is
// the entry `pc`. Four words so the slot is a real offset into a structure
// rather than coincidentally the base address.
fn initialContext(entry: *byte): []i64 {
  let ctx = []i64(4)
  ctx[0] = int(entry)
  return ctx
}

// The context switch's essential move: load `pc` out of the saved context and
// branch to it. `blr`/`call` rather than a jump so the callee returns here.
//
// x30 is the arm64 link register, which `blr` overwrites — it must be declared
// clobbered or the allocator could park a live value there across the block.
// x9 is the scratch holding the loaded address. Both the arm64 and x64 lists
// also name every OTHER caller-saved GPR the indirect call destroys (#3916) —
// `taskBody`/`otherBody` are opaque as far as this block is concerned, so the
// same "excluded from the allocator, not merely x30" rule the runtime's own
// `taskInvoke`/`invokeRaw` copies need applies here too. `memory` joins both
// lists because the call can read or write memory the compiler has no
// visibility into. `x0`/`rax` (`result`) and `x1`/`rcx` (`input`) are excluded
// here, not re-listed as clobbers.
fn enter(ctx: []i64): int {
  let p = ptrOf(ctx)
  return asm {
    // arm64: ldr x9, [x1] ; blr x9
    arm64 { 0xF9400029, 0xD63F0120 }
    // x64: mov rcx, [rcx] ; call rcx
    x64 { 0x48, 0x8B, 0x09, 0xFF, 0xD1 }
    result arm64 x0 x64 rax : int
    input arm64 x1 x64 rcx = p
    clobber arm64 {
      x2,
      x3,
      x4,
      x5,
      x6,
      x7,
      x8,
      x9,
      x10,
      x11,
      x12,
      x13,
      x14,
      x15,
      x16,
      x17,
      x18,
      x30,
      memory,
    }
    clobber x64 { rdx, rsi, rdi, r8, r9, r10, r11, memory }
  }
}

// `entryOf` under `@nosplit` (§10.3.1). This is not decoration: `initialContext`
// in a real scheduler is nosplit-by-nature, so an `entryOf` the nosplit
// allowlist rejected would be useless for the one caller it exists to serve. It
// qualifies on the same PROOF as the atomics — a single inline address
// materialization against a link-time constant, so it can neither allocate nor
// reach a safepoint.
//
// Also the in-run invariance check: two reads of one function must agree (a
// closure object would be a fresh allocation each time), and two different
// functions must not.
@nosplit fn addressesAreStable(): bool {
  let a = entryOf(taskBody)
  let b = entryOf(taskBody)
  let c = entryOf(otherBody)
  return a == b && a != c
}

fn main() {
  // (a) build a task context and actually enter through it.
  let ctx = initialContext(entryOf(taskBody))
  let entered = enter(ctx)

  // (b) the same machinery aimed at the other function — the address selects
  // the body, it does not merely happen to be executable.
  let otherCtx = initialContext(entryOf(otherBody))
  let enteredOther = enter(otherCtx)

  // (c) invariance within a run, computed inside a @nosplit body.
  let stable = addressesAreStable()

  // (d) the gap between two entries is a link-time constant, so it is identical
  // on every run even where the image itself is position-independent and the
  // absolute addresses slide (Mach-O is; the static ELF output is not). This is
  // the run-to-run stability property stated without depending on the loader.
  let delta = int(entryOf(otherBody)) - int(entryOf(taskBody))
  let deltaAgain = int(entryOf(otherBody)) - int(entryOf(taskBody))

  print("${entered} ${enteredOther} ${stable} ${delta == deltaAgain}\n")
}
