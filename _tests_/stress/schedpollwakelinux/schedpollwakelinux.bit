// `pollWake`/eventfd (#5718, epic #3913) against a REAL kernel, Linux/epoll.
// Proves the primitive ../schedpolllinux's `pollDrain` still lacked: a
// producer can interrupt a BLOCKING drain instead of that drain only ever
// being safe to call with a 0 timeout. Same shape as the darwin twin
// ../schedpollwakedarwin for exactly that reason — a divergence between the
// two means a real platform difference rather than a spelling one.
//
// THREE CALLS, ONE EPOLL SET, DELIBERATELY SINGLE-THREADED. A cross-thread
// producer would prove the same thing with a race on the assertion's timing
// budget instead of the mechanism; this program proves the mechanism itself
// by relying on the eventfd counter's documented persistence (see
// `pollWake`'s own header in ../../../runtime/sched/linux) rather than on
// which of two threads the kernel schedules first:
//
//   - call 1: nothing triggered. `pollDrain` must actually block — the
//     regression this guards is the OLD millisecond API truncating a
//     sub-millisecond deadline to 0, which `pollDrainSkippable` reads as the
//     non-blocking form and returns instantly instead of waiting.
//   - call 2: `pollWake` triggered FIRST, with nothing blocked in
//     `epoll_pwait` to receive it. Because the eventfd counter persists in
//     the kernel independent of whether anyone is waiting, this call must
//     still observe it and return almost immediately — proving the wake
//     survived being triggered before anyone was waiting, the exact
//     interleaving a lost-wakeup bug would drop.
//   - call 3: one armed read registration, `pollWake` triggered, and a
//     NON-BLOCKING `pollDrain(s, 0)` — the call
//     ../../../runtime/root/linux/bootworker.bit makes once per idle turn
//     before deciding whether to sleep. It must report the wake rather than
//     0; see its own comment in `main` for why 0 there is a hang and not a
//     delay, and why the registration is load-bearing.
//
// THE TIMEOUT IS DELIBERATELY SUB-MILLISECOND (400us) — the value that would
// have truncated to a non-blocking 0ms drain under the old millisecond-only
// signature. `epoll_pwait` itself has no sub-millisecond resolution, so
// `nsToEpollMs` (../../../runtime/sched/linux/poll.bit) rounds this UP to a
// 1ms actual wait rather than down to 0 — call 1 blocking for real proves
// that rounding happened; call 1 returning instantly would mean it did not.
// The margins below are set for that 1ms actual floor, not for 400us,
// because epoll's own granularity is what call 1 is actually bounded by —
// NOT MEASURED ON REAL LINUX HARDWARE, chosen with generous slack either
// side of the expected 1ms so ordinary scheduler jitter cannot flip the
// verdict; see this ticket's report for what was and was not executed.
//
// Linux-only by construction, hence the sibling `linux-only` marker: it binds
// runtime/sched/linux, which reaches the kernel through `syscall` (SPEC
// §11.8) — rejected on Darwin even for an uncalled declaration.

import { schedInit, schedSetPollFd, taskAt, pollRead } from "../../../runtime/sched"
import { schedPollerArm, schedPollerWaitNs, taskState, taskParked } from "../../../runtime/sched"
import { pollCreate, pollClose, pollWake, pollDrain } from "../../../runtime/sched/linux"
import { pollRegister } from "../../../runtime/sched/linux"
import { parkMonoNs } from "../../../runtime/park/linux"
import { scIdleCount, schedIdleArm, schedWorkerAt, wkPark } from "../../../runtime/sched"

// pipe2(2) as a raw syscall (§11.8) — the ELF output is fully static with no
// libc, so the Darwin twin's `extern` declaration has no counterpart here.
// Numbers read out of the pinned reference toolchain's std/os/linux/syscalls,
// never from memory; `hostTarget()` is 0 for x86_64-linux and 1 for
// aarch64-linux, and this program is only ever built for a Linux target.
//
// pipe2 rather than pipe: aarch64 has NO `pipe` syscall at all, only `pipe2`
// — the same shape of trap as `epoll_wait`'s absence there. Flags 0 makes it
// plain `pipe(2)`. Identical to ../schedpolllinux's own `nrPipe2`.
fn nrPipe2(): int {
  if (hostTarget() == 0) {
    return 293
  }
  return 59
}

// write(2), same numbering source as `nrPipe2` above.
fn nrWrite(): int {
  if (hostTarget() == 0) {
    return 1
  }
  return 64
}

// Two, so call 6 has a peer to park: worker 1 is never run, only armed.
const pollWorkers: int = 2

// Sub-millisecond, per this program's own header: the value the old
// millisecond-only API would have truncated to 0.
const timeoutNs: int = 400000

// Call 1 must block at least this long to count as a real block rather than
// an instant (possibly truncated-to-zero) return. Comfortably under the ~1ms
// `nsToEpollMs` rounds `timeoutNs` up to, generous against scheduler jitter.
const blockedFloorNs: int = 250000

// Call 2 must return well before `blockedFloorNs` to count as woken by the
// already-triggered eventfd rather than having blocked out the deadline too.
const wokenCeilingNs: int = 150000

let schedBlock: [16]i64
let workerBlocks: [584]i64
let monoScratch: [2]i64

// `int fds[2]` is TWO PACKED 32-BIT FIELDS IN ONE 8-BYTE WORD, so this is an
// `[1]i64` read through a byte cursor rather than the `[2]i32` it looks like —
// a Bit array stores one 8-byte word per element (§11.8). ../schedpolllinux
// documents the SIGSEGV the obvious spelling produces.
let pipeFds: [1]i64

// The address call 3's registration carries in its epoll `data` word. NEVER
// DISPATCHED: the pipe is registered and then never written, so the kernel can
// never report it and `schedPollUnpark` is never handed this address. It exists
// only to be non-zero, since `pollArmWake` claimed `data` 0 as the wake
// eventfd's sentinel and a real registration must not collide with it.
let standinTask: [1]i64

// Call 4's pipe and the parked task its registration names. The task is never
// run: `pollDrain` only moves it to this private scheduler's global queue.
let pipeFds4: [1]i64
let parkedTask: [40]i64

// Calls 6 and 7's pipes, one per task, and the parked tasks their
// registrations name. Never run, exactly like call 4's.
let pipeFds6: [3]i64
let parkedTasks6: [120]i64

// Park task `i`, register its pipe and make the pipe readable. True when all
// three steps worked.
fn readyParked(pfd: int, i: int): bool {
  let cell = int(ptrOf(pipeFds6)) + i * 8
  if (int(syscall(nrPipe2(), i64(cell), 0)) != 0) {
    return false
  }
  let fds = pipeFds6[i]
  let task = int(ptrOf(parkedTasks6)) + i * 40 * 8
  *(taskAt(task) + taskState) = taskParked
  let armed = pollRegister(pfd, fds % 4294967296, pollRead, task)
  return armed && int(syscall(nrWrite(), i64(fds / 4294967296), i64(cell), 1)) == 1
}

fn schedAddr(): int {
  return int(ptrOf(schedBlock))
}

fn nowNs(): int {
  return parkMonoNs(ptrOf(monoScratch))
}

// CALLS 6 AND 7 — THE DRAINER RUNS ITS OWN TASK (#5918). Worker 1 is parked
// (armed, and counted idle). A drain that queues ONE task leaves it parked:
// the drainer runs that task itself, and waking the peer for it was one
// futex wake and one re-park per keep-alive request once the pool had
// grown. A drain that queues TWO has work for somebody else, and claims it.
// Split out of `main` to keep it under the complexity ceiling.
fn runOwnTaskCalls(s: *i64, pfd: int): string {
  let peer = schedWorkerAt(s, 1)
  schedIdleArm(peer)
  *(s + scIdleCount) = 1
  let ready6 = readyParked(pfd, 0)
  let n6 = pollDrain(schedAddr(), 0)
  let slept = *(peer + wkPark) == 1
  let ready7 = readyParked(pfd, 1) && readyParked(pfd, 2)
  let n7 = pollDrain(schedAddr(), 0)
  let woken = *(peer + wkPark) == 0
  return "ready6 ${ready6} n6 ${n6} slept ${slept} ready7 ${ready7} n7 ${n7} woken ${woken}"
}

fn main() {
  let s = taskAt(schedAddr())
  schedInit(s, int(ptrOf(workerBlocks)), pollWorkers)

  let pfd = pollCreate()
  let created = pfd >= 0
  schedSetPollFd(s, pfd)

  let t0 = nowNs()
  let n1 = pollDrain(schedAddr(), timeoutNs)
  let elapsed1 = nowNs() - t0

  let woke = pollWake(pfd)

  let t1 = nowNs()
  let n2 = pollDrain(schedAddr(), timeoutNs)
  let elapsed2 = nowNs() - t1

  // CALL 3 — THE DROPPED WAKE. Calls 1 and 2 ask whether a wake ENDS a
  // blocking drain; this asks what a NON-BLOCKING drain REPORTS when the wake
  // is the only thing it finds. Reporting 0 is a hang and not a delay: the
  // producer that fired this wake also claimed worker 0's `scPollWait`, so a
  // worker told "nothing happened" here enters its bounded wait with the
  // eventfd counter already drained AND the claim already spent, and nothing
  // can end that wait before the 1s ceiling.
  //
  // THE ARMED REGISTRATION IS LOAD-BEARING, NOT SCENERY. With nothing armed,
  // `pollDrainSkippable` answers `timeoutNs == 0` without entering the kernel,
  // which leaves the counter for the next call to find — the defect cannot
  // appear at all. One registered pipe, never written so it never produces an
  // event of its own, is what puts `schedPollPendingCount()` above zero and
  // forces the real `epoll_pwait2`.
  pipeFds[0] = 0
  let piped = int(syscall(nrPipe2(), i64(int(ptrOf(pipeFds))), 0)) == 0
  let readFd = int(pipeFds[0]) % 4294967296
  let armed = pollRegister(pfd, readFd, pollRead, int(ptrOf(standinTask)))
  let woke3 = pollWake(pfd)
  let n3 = pollDrain(schedAddr(), 0)

  // CALL 4 — THE DRAIN WAKING ITSELF (#5880). Worker 0 is armed, and the
  // drain it runs unparks a task. The drain holds the poll lock, so it must
  // CLAIM worker 0 (its next wait is non-blocking) but must not fire the
  // eventfd: nothing can be inside the wait but the drain itself. The next
  // non-blocking drain, with call 3's pipe still armed so it enters the
  // kernel, then finds nothing: 0, where a fired eventfd makes it -1.
  pipeFds4[0] = 0
  let piped4 = int(syscall(nrPipe2(), i64(int(ptrOf(pipeFds4))), 0)) == 0
  let readFd4 = int(pipeFds4[0]) % 4294967296
  let writeFd4 = int(pipeFds4[0]) / 4294967296
  parkedTask[taskState] = taskParked
  let armed4 = pollRegister(pfd, readFd4, pollRead, int(ptrOf(parkedTask)))
  let wrote4 = int(syscall(nrWrite(), i64(writeFd4), i64(int(ptrOf(pipeFds4))), 1)) == 1
  schedPollerArm(s)
  let n4 = pollDrain(schedAddr(), 0)
  let claimed = schedPollerWaitNs(s, timeoutNs) == 0
  let n5 = pollDrain(schedAddr(), 0)

  let ownTask = runOwnTaskCalls(s, pfd)

  pollClose(pfd)

  let blocked = elapsed1 >= blockedFloorNs
  let observed = elapsed2 < wokenCeilingNs

  println("poller ${created}")
  println("blocked ${blocked} n1 ${n1}")
  println("woke ${woke} observed ${observed} n2 ${n2}")
  println("piped ${piped} armed ${armed} woke3 ${woke3} n3 ${n3}")
  println("piped4 ${piped4} armed4 ${armed4} wrote4 ${wrote4} n4 ${n4} claimed ${claimed} n5 ${n5}")
  println(ownTask)
}
