// The Darwin parking provider (runtime/park/darwin, #1403) against the real
// kernel.
//
// Darwin-only by construction, hence the sibling `darwin-only` marker file: the
// provider reaches libSystem through `extern function` (SPEC §11.7), which Bit's
// static ELF output cannot resolve and the compiler rejects outright (E0078) —
// the program is not merely expected to fail elsewhere, it cannot compile.
//
// The properties, the timing bounds, and — importantly — the limits of what can
// be proven without a second OS thread are all documented in ./../park/props.
// The one Darwin-specific note: `__ulock_wait` returns 0 both when it is woken
// and when its compare fails, so P2 rests on TIMING rather than on the return
// code. That is exactly why the shared properties assert elapsed time instead
// of trusting a status word.
//
// EVERY CALL IS HOISTED INTO A `let` RATHER THAN PLACED INSIDE THE `print`
// INTERPOLATION, and that is a bug workaround, not a style choice — see #1407.
// Calling a function that allocates from one interpolation slot corrupts every
// EARLIER slot in the same interpolation when the interpolated value derives
// from an `extern function` call: under BIT_GC=stress the earlier slots all
// render with the later call's value, and even a `bool` prints as `1`, so the
// slot's type is lost along with its value. This program is what found it (it
// is the first code to combine §11.7 externs with interpolation), and it must
// keep the workaround until #1407 lands or the suite goes red on Darwin for a
// reason that has nothing to do with parking.

import { parkProps, parkTotal, parkBackoffKat } from "../park/props"
import { parkWait, parkWake, parkSleepNs, parkMonoNs, parkCpuCount } from "../../../runtime/park/darwin"
import { gcSyscallBegin, gcSyscallEnd } from "../../../runtime/gc"

// `parkProps` takes `sleepFn`/`waitFn` as the generic `(int) => ()` /
// `(*i32, i32, int) => int` shapes shared with the Linux twin — `parkSleepNs`
// no longer fits directly now that it takes a caller-owned scratch (#2318),
// and `parkWait` no longer fits directly for the same reason (#3914). Both
// adapt back using this thread's own scratch, which nothing else on this OS
// thread touches concurrently, and never concurrently with each other since
// `parkProps` calls them sequentially on this one thread.
let sleepScratch: [2]i64

//
// BOTH ADAPTERS BRACKET THEIR KERNEL WAIT (`gcSyscallBegin`/`gcSyscallEnd`,
// runtime/ABI.md section 5), which is the fix for #6464. `parkProps` holds this
// thread in `__ulock_wait` and `nanosleep` for 200 ms at a time, and a thread
// inside a kernel call with no safepoint reads `running` to the collector for
// all of it. Another thread collecting under `BIT_GC=stress` then waits on it
// until the rendezvous gives up (239 ms measured, slot 1, 5 of 40 copies run at
// once): the one abandoned stop printed `collections=0` and the program
// "never ran the collector". The syscall pair, not the blocked pair, because
// `parkProps`'s frames hold the function values it was handed and the
// collector must keep scanning them while the thread sleeps.
fn sleepAdapt(ns: int) {
  gcSyscallBegin()
  parkSleepNs(ns, ptrOf(sleepScratch))
  gcSyscallEnd()
}

fn waitAdapt(p: *i32, expected: i32, timeoutNs: int): int {
  gcSyscallBegin()
  let rc = parkWait(p, expected, timeoutNs, ptrOf(sleepScratch))
  gcSyscallEnd()
  return rc
}

// parkProps allocates little and how much depends on timing, so under
// BIT_GC=stress the collector sometimes never ran and the stress gate rightly
// called the run unverified. This churn guarantees collections happen while
// `props`, `total` and `kat` are live, which is the rooting #1407 is about.
fn churn(): int {
  let n = 0
  let i = 0
  while (i < 4096) {
    let s = "${i}:${i * 7}"
    n = n + len(s)
    i = i + 1
  }
  return n
}

fn main() {
  let props = parkProps(waitAdapt, parkWake, sleepAdapt, parkMonoNs, parkCpuCount)
  let total = parkTotal()
  let kat = parkBackoffKat()
  let spun = churn()
  let ok = props == total && spun > 0
  print("${ok} ${props} ${kat}\n")
}
