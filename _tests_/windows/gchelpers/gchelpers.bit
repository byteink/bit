// Native Windows admission proof: one task worker retains a heap above 8 MiB.
extern fn bit_rt_port_stw_gang_joins(): int
extern fn bit_rt_port_stw_collections(): int

fn main() {
  let keep = [][]byte(1024)
  let i = 0
  while (i < 1024) {
    keep[i] = []byte(16384)
    keep[i][0] = byte(i & 255)
    i = i + 1
  }
  i = 0
  while (i < 1024) {
    let junk = []byte(65536)
    junk[0] = byte(i & 255)
    assert(junk[0] == byte(i & 255))
    i = i + 1
  }
  i = 0
  while (i < 1024) {
    assert(len(keep[i]) == 16384 && keep[i][0] == byte(i & 255))
    i = i + 1
  }
  let helpers = bit_rt_port_stw_gang_joins()
  let collections = bit_rt_port_stw_collections()
  assert(collections > 0 && helpers > 0)
  println("windows-gc: collections=${collections} helpers=${helpers} live=16777216")
}
