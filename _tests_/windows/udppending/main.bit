// A pending receive owns payload and sender through collection (#8023).
import { udpBind, UdpSocket, Datagram } from "std/net"
import { sleep, Millisecond } from "std/time"

extern fn bit_rt_port_sched_poll_pending_count(): int
extern fn bit_rt_port_stw_collections(): int

fn receive(s: UdpSocket, done: chan<int>, want: string, port: int) {
  let d = s.recv(1024) catch e {
    panic(e.message())
  }
  assert(d.data == want && d.host == "127.0.0.1" && d.port == port)
  done <- 1
}

fn awaitPending() {
  let i = 0
  while (i < 2000) {
    if (bit_rt_port_sched_poll_pending_count() > 0) {
      return
    }
    sleep(Millisecond)
    i = i + 1
  }
  panic("receive was not posted")
}

fn collectWhilePending() {
  let before = bit_rt_port_stw_collections()
  let i = 0
  while (i < 128) {
    let junk = []byte(65536)
    junk[0] = byte(i)
    assert(junk[0] == byte(i))
    i = i + 1
  }
  assert(bit_rt_port_stw_collections() > before)
}

fn closedReceive(s: UdpSocket, done: chan<int>) {
  let failed = false
  let _ = s.recv(1024) catch _ {
    failed = true
    Datagram{ data = "", host = "", port = 0 }
  }
  assert(failed)
  done <- 1
}

fn main() {
  let server = udpBind("127.0.0.1", 0) catch e {
    panic(e.message())
  }
  defer server.close()
  let client = udpBind("127.0.0.1", 0) catch e {
    panic(e.message())
  }
  defer client.close()
  let port = server.port() catch e {
    panic(e.message())
  }
  let clientPort = client.port() catch e {
    panic(e.message())
  }
  let done = chan<int>(1)
  spawn receive(server, done, "payload after collection", clientPort)
  awaitPending()
  collectWhilePending()
  client.send("127.0.0.1", port, "payload after collection") catch e {
    panic(e.message())
  }
  assert(<- done == 1)
  // Queued completion and an empty datagram preserve the same sender.
  client.send("127.0.0.1", port, "") catch e {
    panic(e.message())
  }
  receive(server, done, "", clientPort)
  assert(<- done == 1)
  checkTruncation(server, client, port)
  let closing = udpBind("127.0.0.1", 0) catch e {
    panic(e.message())
  }
  spawn closedReceive(closing, done)
  awaitPending()
  collectWhilePending()
  closing.close()
  assert(<- done == 1)
  assert(bit_rt_port_sched_poll_pending_count() == 0)
  println("udppending: ok")
}

fn checkTruncation(server: UdpSocket, client: UdpSocket, port: int) {
  client.send("127.0.0.1", port, "too large") catch e {
    panic(e.message())
  }
  let failed = false
  let _ = server.recv(2) catch _ {
    failed = true
    Datagram{ data = "", host = "", port = 0 }
  }
  assert(failed)
  client.send("127.0.0.1", port, "next") catch e {
    panic(e.message())
  }
  let next = server.recv(1024) catch e {
    panic(e.message())
  }
  assert(next.data == "next")
}
