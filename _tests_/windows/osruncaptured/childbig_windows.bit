// Windows child #2 (companion to ../mainwindows.bit, #5782): writes strictly
// more than 64 KiB to BOTH stdout and stderr — the deadlock-freedom property
// ABI.md §19 documents (both pipes must drain to EOF regardless of the
// other's cap). Exit 7.
import { exit } from "std/os"

const chunk: string = "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB\n" // 100 bytes
const errChunk: string = "CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC\n" // 100 bytes

fn main() {
  let i = 0
  while (i < 700) {
    print(chunk)
    i = i + 1
  }
  let j = 0
  while (j < 700) {
    eprint(errChunk)
    j = j + 1
  }
  exit(7)
}
