// Windows child #3 (companion to ../mainwindows.bit, #5782): writes strictly
// more than `osRunCaptureMaxBytes` (4 MiB) to stdout only, to exercise
// `_truncated`'s bit 0. Exit 42. Ten `print()` calls of ~430 KiB each
// (`std/strings`' `repeat`), not thousands of small ones -- a many-small-
// writes-to-a-redirected-pipe path on Windows stdout independently needs its
// own investigation (tracked separately, not this ticket's own primitive).
import { exit } from "std/os"
import { repeat } from "std/strings"

fn main() {
  let big = repeat("A", 430000) // ~430 KB, no trailing newline needed
  let i = 0
  while (i < 10) {
    print(big)
    i = i + 1
  }
  exit(42)
}
