// Windows-reachable companion to _tests_/imports/osruncaptured/main.bit
// (#5782, epic #3459): the same `bit_rt_os_run_captured` end-to-end property,
// on Windows. It lives here, not beside main.bit, because the imports harness
// builds each _tests_/imports directory as ONE module, and these five files
// each declare their own `main`. main.bit's own
// children are `#!/bin/sh` scripts (POSIX shebang, `printf`/`yes`/`head`/
// `sleep`, `fsChmod 0o700` to make them executable) — none of that exists on
// Windows, so this file cannot reuse them; per #5782's own coordinator note,
// this is the "Windows-reachable variant beside it" instead. Its four
// children (./childsmall_windows.bit, ./childbig_windows.bit,
// ./childtrunc_windows.bit, ./childslow_windows.bit) are themselves Bit
// programs, cross-built for `x86_64-windows` and shipped alongside this
// file's own cross-built binary — see `_tests_/bit/windowssmoke.bit`'s own
// `buildProgram`/`shipAndRun` for the exact mechanism this reuses.
//
// SAME MARSHALLING AS main.bit, unchanged: `bit_rt_os_run_captured` is
// deliberately not a compiler builtin (ABI.md §19), so `pathView` below
// builds the raw `*const RtBytes` view by hand exactly as main.bit's own
// `pathView` does, and every call passes `argv = 0` (`bit_rt_os_run`'s own
// "bare `[pathPtr, NULL]`" contract) — this file never needs a non-empty
// argv, since each scenario is its own dedicated child binary rather than
// one child parametrized by an argument.
import { exit, envOr } from "std/os"

extern fn bit_rt_os_run_captured(path: i64, argv: i64, timeoutMs: i64): i64
extern fn bit_rt_os_run_captured_stdout(): i64
extern fn bit_rt_os_run_captured_stderr(): i64
extern fn bit_rt_os_run_captured_truncated(): i64
extern fn bit_rt_port_root_fs_str_data(s: i64): i64
extern fn bit_rt_port_root_fs_str_len_of(s: i64): i64
extern fn bit_rt_port_mem_load_byte(addr: i64): i64

const capMaxBytes: int = 4194304

// The `*const RtBytes` view the raw ABI takes, returned TOGETHER with the
// byte buffer it points into. The caller must keep the returned object live
// until `bit_rt_os_run_captured` returns: the call allocates the captured
// strings, so a collection can run during it, and a view held only as a raw
// `i64` roots nothing. A plain `fn pathView(p): i64` whose locals died at its
// own return let that collection reclaim the path mid-call (rc=127 under the
// full suite, test-osruncap-race).
class PathView { bytes: []byte, view: []i64 }

fn pathView(p: string): PathView {
  let bytes = []byte(p)
  let view = []i64(2)
  view[0] = int(ptrOf(bytes))
  view[1] = len(bytes)
  return PathView{ bytes = bytes, view = view }
}

// Raw address of `pv`'s view, for the ABI call.
fn viewAddr(pv: PathView): i64 {
  return i64(ptrOf(pv.view))
}

fn spawnCaptured(exePath: string, timeoutMs: i64): i64 {
  let pv = pathView(exePath)
  let rc = bit_rt_os_run_captured(viewAddr(pv), 0, timeoutMs)
  if (len(pv.bytes) == 0) { // keeps `pv` live across the call; never taken
    return 0 - 1
  }
  return rc
}

fn capturedLen(raw: i64): i64 {
  return bit_rt_port_root_fs_str_len_of(raw)
}

fn capturedByte(raw: i64, i: i64): i64 {
  return bit_rt_port_mem_load_byte(bit_rt_port_root_fs_str_data(raw) + i)
}

fn bail(msg: string) {
  eprint("FAIL: ${msg}\n")
  exit(1)
}

fn assertContent(label: string, raw: i64, want: string) {
  let n = capturedLen(raw)
  if (n != i64(len(want))) {
    bail("${label}: len=${n} want=${len(want)}")
  }
  let i = 0
  while (i < len(want)) {
    if (capturedByte(raw, i64(i)) != i64(want[i])) {
      bail("${label}: byte ${i} mismatch")
    }
    i = i + 1
  }
}

// 1. Exact byte content of a small capture.
fn testSmall(dir: string) {
  let rc = spawnCaptured(dir + "\\childsmall_windows.exe", 5000)
  if (rc != 0) {
    bail("small: rc=${rc}")
  }
  assertContent("small", bit_rt_os_run_captured_stdout(), "hello-osruncap-42\n")
  if (bit_rt_os_run_captured_truncated() != 0) {
    bail("small: unexpected truncation")
  }
  print("small: OK\n")
}

// 2. > 64 KiB on BOTH stdout and stderr, neither truncated.
fn testBig(dir: string) {
  let rc = spawnCaptured(dir + "\\childbig_windows.exe", 15000)
  if (rc != 7) {
    bail("big: rc=${rc}")
  }
  let outLen = capturedLen(bit_rt_os_run_captured_stdout())
  let errLen = capturedLen(bit_rt_os_run_captured_stderr())
  if (outLen <= 65536) {
    bail("big: stdout too short ${outLen}")
  }
  if (errLen <= 65536) {
    bail("big: stderr too short ${errLen}")
  }
  if (bit_rt_os_run_captured_truncated() != 0) {
    bail("big: unexpected truncation")
  }
  print("big: OK outLen=${outLen} errLen=${errLen}\n")
}

// 3. `_truncated`: a child writing more than the 4 MiB cap to stdout.
fn testTrunc(dir: string) {
  let rc = spawnCaptured(dir + "\\childtrunc_windows.exe", 30000)
  if (rc != 42) {
    bail("trunc: rc=${rc}")
  }
  let n = capturedLen(bit_rt_os_run_captured_stdout())
  let bits = bit_rt_os_run_captured_truncated()
  let errLen = capturedLen(bit_rt_os_run_captured_stderr())
  if (n != i64(capMaxBytes)) {
    bail("trunc: stdout len=${n} want=${capMaxBytes} bits=${bits} errLen=${errLen}")
  }
  if ((bits & 1) == 0) {
    bail("trunc: stdout truncation bit not set")
  }
  if ((bits & 2) != 0) {
    bail("trunc: stderr unexpectedly marked truncated")
  }
  print("trunc: OK\n")
}

// 4. Bounded call against a slow child: `-2`, child terminated.
fn testTimeout(dir: string) {
  let rc = spawnCaptured(dir + "\\childslow_windows.exe", 1000)
  if (rc != 0 - 2) {
    bail("timeout: rc=${rc}")
  }
  print("timeout: OK\n")
}

fn main() {
  // The four child .exe files are shipped into the same directory as this
  // program's own .exe (its cross-build+ship harness's own scratch dir) —
  // `BIT_OSRUNCAP_DIR` names it, since a Windows program has no `$0`-style
  // self-relative path primitive this fixture can rely on.
  let dir = envOr("BIT_OSRUNCAP_DIR", ".")
  testSmall(dir)
  testBig(dir)
  testTrunc(dir)
  testTimeout(dir)
  print("PASS\n")
}
