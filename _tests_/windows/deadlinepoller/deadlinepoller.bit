// Native Windows regression for deadline polling beside the idle token holder (#6787).
// Windows records idle-wait traces only in diagnostic archives with the
// standard schedW0WaitBegin/End hooks added to idleWait (runtime/root/windows/boot.bit).
import { listen, dial, Listener } from "std/net"
import { monotonic, Millisecond } from "std/time"
import { WaitGroup } from "std/sync"

extern fn bit_rt_port_sched_timer_trace_enable()
extern fn bit_rt_port_sched_timer_trace_count(): int
extern fn bit_rt_port_sched_timer_trace_at(n: int, field: int): int

class Args { listener: Listener, wg: WaitGroup }

fn serve(a: Args) {
  defer a.wg.done()
  let c = a.listener.accept() catch e {
    panic(e.message())
  }
  defer c.close()
  // The client deliberately sends nothing until its read deadline expires.
  let s = c.read(1)
  if (s != "x") {
    panic("client completion was lost")
  }
}

fn main() {
  let l = listen("127.0.0.1", 0) catch e {
    panic(e.message())
  }
  defer l.close()
  let port = l.port() catch e {
    panic(e.message())
  }
  let wg = WaitGroup()
  wg.add(1)
  spawn serve(Args{ listener = l, wg = wg })
  let c = dial("127.0.0.1", port) catch e {
    panic(e.message())
  }
  defer c.close()
  bit_rt_port_sched_timer_trace_enable()
  let start = monotonic().ns
  c.setDeadline(start + 2000 * Millisecond)
  let timedOut = false
  let _ = c.readDeadline(1) catch _ {
    timedOut = true
    ""
  }
  let elapsed = monotonic().ns - start
  c.setDeadline(0)
  c.write("x") catch e {
    panic(e.message())
  }
  wg.wait()
  if (!timedOut || elapsed < 1900 * Millisecond || elapsed > 4000 * Millisecond) {
    panic("deadline was early, lost, or unbounded")
  }
  checkTrace(elapsed)
}

fn checkTrace(elapsed: int) {
  let events = bit_rt_port_sched_timer_trace_count()
  if (events == 0) {
    println("deadlinepoller elapsedNs ${elapsed} idle-wait trace unavailable")
    return
  }
  let blocks = 0
  let i = 0
  while (i < events && i < 16384) {
    if (bit_rt_port_sched_timer_trace_at(i, 1) / 256 == 4) {
      blocks = blocks + 1
    }
    i = i + 1
  }
  println("deadlinepoller elapsedNs ${elapsed} events ${events} w0Block ${blocks}")
  if (events >= 16384 || blocks * 1000000000 >= elapsed * 100) {
    panic("idle poller spun during deadline read")
  }
}
