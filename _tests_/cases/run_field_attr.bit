// run
// SPEC §10.5, #3879: an attribute on a class field is sugar for a call to an
// ordinary fallible function, and every attributed class gets a synthesized
// `validateFields(): ()!` running those calls in DECLARATION ORDER -- fields
// top to bottom, attributes top to bottom within a field.
//
// EVERY attribute runs and EVERY failure is reported (#4572), each naming the
// field it came from, joined into the one error the method fails with. The
// first case is the pin: `name` is too short AND `email` is malformed, so the
// message must carry both, in declaration order -- reporting only "name: too
// short" would mean the method stopped at the first failure, which is what it
// used to do and what cost a user one round trip per mistake. The remaining
// cases isolate each attribute, and the last proves the happy path still runs
// every one and reports nothing.
//
// `min`, `max` and `email` are ordinary functions declared right here. Nothing
// registers them and nothing in the compiler knows their names: that is the
// whole design, and `slug` below is the same claim made by a user-defined
// name the compiler has never heard of.

class validationError {
  text: string

  message(): string {
    return this.text
  }
}

fn min(s: string, n: int): ()! {
  if (len(s) < n) {
    fail validationError{ text: "too short" }
  }
}

fn max(s: string, n: int): ()! {
  if (len(s) > n) {
    fail validationError{ text: "too long" }
  }
}

fn email(s: string): ()! {
  let i = 0
  while (i < len(s)) {
    if (s[i] == '@') {
      return
    }
    i = i + 1
  }
  fail validationError{ text: "not an email" }
}

fn slug(s: string): ()! {
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (!((c >= 'a' && c <= 'z') || c == '-')) {
      fail validationError{ text: "not a slug" }
    }
    i = i + 1
  }
}

class NewUser {
  @min(3)
  @max(8)
  name: string

  @email
  email: string

  @slug
  handle: string
}

fn report(u: NewUser) {
  u.validateFields() catch e {
    print("${e.message()}\n")
    return
  }
  print("ok\n")
}

fn main() {
  report(NewUser{ name: "ab", email: "nope", handle: "ok" })
  report(NewUser{ name: "abcdefghij", email: "a@b", handle: "ok" })
  report(NewUser{ name: "abcd", email: "nope", handle: "ok" })
  report(NewUser{ name: "abcd", email: "a@b", handle: "Nope" })
  report(NewUser{ name: "abcd", email: "a@b", handle: "ok-fine" })
}
