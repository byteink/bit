== closed-at-0
  tok Comment [0,10) </* lead */>
  tok LBrace [10,11) <{>
  tok StringTok [11,14) <"a">
  tok Colon [14,15) <:>
  tok StringTok [15,18) <"x">
  tok RBrace [18,19) <}>
  tok Eof [19,19) <>
  parse OK {"a":"x"}
  cst OK </* lead */{"a":"x"}>
== closed-after-value
  tok LBrace [0,1) <{>
  tok StringTok [1,4) <"a">
  tok Colon [4,5) <:>
  tok StringTok [5,8) <"x">
  tok Comment [8,15) </* c */>
  tok RBrace [15,16) <}>
  tok Eof [16,16) <>
  parse OK {"a":"x"}
  cst OK <{"a":"x"/* c */}>
== minimal-closed
  tok Comment [0,4) </**/>
  tok LBrace [4,5) <{>
  tok StringTok [5,8) <"a">
  tok Colon [8,9) <:>
  tok StringTok [9,12) <"x">
  tok RBrace [12,13) <}>
  tok Eof [13,13) <>
  parse OK {"a":"x"}
  cst OK </**/{"a":"x"}>
== non-nesting
  tok Comment [0,8) </* /* */>
  tok LBrace [8,9) <{>
  tok StringTok [9,12) <"a">
  tok Colon [12,13) <:>
  tok StringTok [13,16) <"x">
  tok RBrace [16,17) <}>
  tok Eof [17,17) <>
  parse OK {"a":"x"}
  cst OK </* /* */{"a":"x"}>
== unterminated-at-0
  tok Invalid [0,2) </*>
  tok Eof [2,2) <>
  parse ERR json: unterminated block comment at byte 0 (line 1, column 1)
  cst ERR json: unterminated block comment at byte 0 (line 1, column 1)
== unterminated-at-0-text
  tok Invalid [0,15) </* never closed>
  tok Eof [15,15) <>
  parse ERR json: unterminated block comment at byte 0 (line 1, column 1)
  cst ERR json: unterminated block comment at byte 0 (line 1, column 1)
== unterminated-slash
  tok Invalid [0,3) </*/>
  tok Eof [3,3) <>
  parse ERR json: unterminated block comment at byte 0 (line 1, column 1)
  cst ERR json: unterminated block comment at byte 0 (line 1, column 1)
== unterminated-star
  tok Invalid [0,3) </**>
  tok Eof [3,3) <>
  parse ERR json: unterminated block comment at byte 0 (line 1, column 1)
  cst ERR json: unterminated block comment at byte 0 (line 1, column 1)
== unterminated-after-value
  tok LBrace [0,1) <{>
  tok StringTok [1,4) <"a">
  tok Colon [4,5) <:>
  tok StringTok [5,8) <"x">
  tok RBrace [8,9) <}>
  tok Invalid [9,11) </*>
  tok Eof [11,11) <>
  parse ERR json: trailing garbage after value at byte 9 (line 1, column 10)
  cst ERR json: trailing garbage after value at byte 9 (line 1, column 10)
== unterminated-midobject
  tok LBrace [0,1) <{>
  tok StringTok [1,4) <"a">
  tok Colon [4,5) <:>
  tok Invalid [6,18) </* oops "x"}>
  tok Eof [18,18) <>
  parse ERR json: unterminated block comment at byte 6 (line 1, column 7)
  cst ERR json: unterminated block comment at byte 6 (line 1, column 7)
== lone-slash
  tok Invalid [0,1) </>
  tok Eof [1,1) <>
  parse ERR json: unexpected character in input at byte 0 (line 1, column 1)
  cst ERR json: unexpected character in input at byte 0 (line 1, column 1)
done
