// run
// #4361: the remainder sibling of `run_div_pow2_trunc.bit`. aarch64 now
// reduces `x % 2^k` to a mask instead of `sdiv` + `msub` (x86-64 has since
// #1704), so both backends compute the remainder without dividing.
//
// The property the mask form is easy to get wrong is the same one the shift
// form was: a truncated remainder takes the DIVIDEND's sign (SPEC section
// 13.5). A bare `and` rounds toward negative infinity, so it answers
// (-9) % 8 == 7 where the answer is -1, and (-1) % 8 == 7 where the answer is
// -1 -- a plausible non-negative number on every negative dividend, on every
// program, not a crash. The sign-dependent `2^k - 1` bias before the mask is
// what makes it truncate; dropping it changes 5 of the 8 columns below.
//
// Every dividend is a genuine runtime value (an array load indexed by a loop
// counter, or a loop-carried variable), never a literal: optfold.bit's
// foldBinaryArith folds a `%` whose OPERANDS are already ConstInt nodes, so a
// literal dividend never reaches codegen at all and this would be testing the
// constant folder instead of the backend.
//
// The `% -8`, `% 7` and `% 1` lines are here on purpose: xConstPow2Divisor
// declines a negative divisor, a non-power-of-two and 1, so all three still
// take the real divide -- and must agree with the fast path's neighbours at
// every dividend, which is what makes the two paths comparable side by side.
// `% 1` is 0 everywhere and `% -8` matches `% 8` exactly, because the
// remainder's sign follows the dividend and never the divisor.
//
// The last two lines are unsigned. `u64 % 2^k` is a plain mask with no bias,
// and the all-ones dividend is the discriminator between the two forms: the
// mask gives 7, while the signed bias sequence applied to an unsigned value
// would give 0.
fn main() {
  let a: [8]i64 = [8]i64{ -9, -8, -7, -1, 0, 1, 7, 8 }

  let i = 0
  while (i < 8) {
    print("${a[i] % 8} ")
    i = i + 1
  }
  print("\n")

  i = 0
  while (i < 8) {
    print("${a[i] % 2} ")
    i = i + 1
  }
  print("\n")

  i = 0
  while (i < 8) {
    print("${a[i] % -8} ")
    i = i + 1
  }
  print("\n")

  i = 0
  while (i < 8) {
    print("${a[i] % 7} ")
    i = i + 1
  }
  print("\n")

  i = 0
  while (i < 8) {
    print("${a[i] % 1} ")
    i = i + 1
  }
  print("\n")

  let u: u64 = 0
  while (u < 20) {
    print("${u % 8} ")
    u = u + 3
  }
  print("\n")

  // 2^64 - 1, built at runtime so it survives to codegen.
  let all: u64 = 0
  let step = 0
  while (step < 64) {
    all = all + all + u64(1)
    step = step + 1
  }
  print("${all % 8}\n")
}
