// run
fn exceeds(v: []int, npoly: int, bound: int): bool {
  println("npoly=${npoly}")
  return npoly * 256 > len(v) || bound < 0
}

fn computeZ(y: []int): bool {
  let z = []int(5 * 256)
  let i = 0
  while (i < 5 * 256) {
    z[i] = z[i] + y[i]
    i = i + 1
  }
  return exceeds(z, 5, 524092)
}

fn main() {
  println("bad=${computeZ([]int(1280))}")
}
