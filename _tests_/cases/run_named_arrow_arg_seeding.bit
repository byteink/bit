// run
// #6347: an arrow literal written as a NAMED argument is seeded with its
// expected type exactly as the positional form is (SPEC §12.11, §15.3), for a
// generic callee and for a concrete one. The type parameters bind from the other arguments by the
// declared slot each name fills, the arrow is then checked against the
// parameter's function type with those bindings, and its own result binds the
// rest. Before this the pre-pass paired arguments with parameters by written
// index and skipped a named call, so `f = (x) => x + 1` stayed untyped and
// `U` was never inferred (E0068).
//
// Every call writes its arguments in an order that differs from the declared
// one, so a name read at the wrong slot binds the wrong type parameter and
// prints a wrong value (or fails to check):
//
//  1. `apply<T, U>` - the arrow's own parameter type comes from `v`, written
//     AFTER it.
//  2. `twice<T, U>` - two arrows, each seeded from a different value; the
//     written order is the reverse of the declared one, so swapped slots
//     would hand `f` the string and `g` the i64.
//  3. `mapTo<T, U>` with a defaulted `sep` left out of the call.
//  4. `Runner.run<T, U>` - a generic METHOD's own type parameters.
//  5. `both` and `Runner.pair` - CONCRETE callees whose two parameters are
//     function types over different types. The seeding pre-pass paired
//     arguments with parameters by written position, so the reordered call
//     handed `g` the expectation `(i64) => i64` and failed to check.

fn apply<T, U>(f: (T) => U, v: T): string {
  return "${f(v)}"
}

fn twice<T, U>(f: (T) => T, g: (U) => U, a: T, b: U): string {
  return "${f(a)} ${g(b)}"
}

fn mapTo<T, U>(v: T, f: (T) => U, sep: string = "-", tag: string = ""): string {
  return "${tag}${sep}${f(v)}"
}

fn both(f: (i64) => i64, g: (string) => string): string {
  return "${f(1)} ${g("a")}"
}

class Runner {
  pair(f: (i64) => i64, g: (string) => string): string {
    return "${f(2)} ${g("b")}"
  }
  run<T, U>(f: (T) => U, v: T, label: string): string {
    return "${label}:${f(v)}"
  }
}

fn main() {
  print("${apply(v = 4, f = (x) => x + 1)}\n")
  print("${apply(v = "ab", f = (s) => s + "!")}\n")
  print("${twice(b = "x", g = (s) => s + "!", f = (n) => n + 1, a = 1)}\n")
  print("${mapTo(f = (x) => x * 3, v = 7, tag = "n")}\n")
  let r = Runner{}
  print("${r.run(label = "sq", v = 6, f = (n) => n * n)}\n")
  print("${both(g = (s) => s + "!", f = (n) => n + 1)}\n")
  print("${r.pair(g = (s) => s + "?", f = (n) => n * 10)}\n")
}
