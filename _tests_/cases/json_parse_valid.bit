// run
// stdlib/json/parse.bit's strict recursive-descent parser (#1479's json
// epic, #1721), exercised behaviourally: round-trips a representative
// document through jsonParse then jsonEncode (#1719) and reads every field
// back out through the jsonGet/jsonAsX accessors (#1717).
//
// Used to redeclare the lexer, value type, parser, and compact encoder
// locally on the stated belief that "a golden case is single-file with no
// prelude and cannot import std/json". That belief is false (#2421):
// `_tests_/bit/golden.bit`'s `checkRun` runs `bit build <case>` with
// `BIT_STDLIB` exported, so the import below resolves exactly as it would
// for any other caller. The local copy's float encoding had also drifted
// from the module's (#3056): the copy printed an integral `JsonFloat` as a
// bare `"${f}"`, missing #2282's fix that appends `.0` to the text so it
// round-trips as a float instead of colliding with `JsonInt`'s text — the
// "big" field below (a literal too wide for `i64`, so it falls back to
// `JsonFloat`) now encodes as `100000000000000000000.0`, not the bare
// integer text the copy produced.
//
// Covers: nested object + array, a string needing quote/backslash/newline/
// tab escapes, a `\u` escape (non-ASCII BMP codepoint) and a `\u` surrogate
// pair (astral codepoint), an int, an integral literal too wide for `i64`
// (falls back to `JsonFloat`), a float, true/false, and null.
import {
  jsonParse,
  jsonGet,
  jsonAsString,
  jsonAsInt,
  jsonAsFloat,
  jsonAsBool,
  jsonIsNull,
  jsonAsArray,
  jsonEncode,
} from "std/json"

fn main() {
  let src = "{\"name\": \"bit \\\"lang\\\"\", \"esc\": \"line1\\nline2\\ttab\", \"accent\": \"\\u00e9\", \"emoji\": \"\\ud83d\\ude00\", \"count\": 42, \"big\": 100000000000000000000, \"ratio\": 2.5, \"ok\": true, \"nope\": false, \"nil\": null, \"list\": [1, 2, 3], \"nested\": {\"inner\": true}}"

  let parsed = jsonParse(src) catch e {
    print("parse failed: ${e.message()}\n")
    return
  }

  match (jsonGet(parsed, "name")) {
    Some(v) => {
      match (jsonAsString(v)) {
        Some(s) => print("name=${s}\n")
        None => print("name=wrong-type\n")
      }
    }
    None => print("name=missing\n")
  }

  match (jsonGet(parsed, "esc")) {
    Some(v) => {
      match (jsonAsString(v)) {
        Some(s) => print("esc=${s}\n")
        None => print("esc=wrong-type\n")
      }
    }
    None => print("esc=missing\n")
  }

  match (jsonGet(parsed, "accent")) {
    Some(v) => {
      match (jsonAsString(v)) {
        Some(s) => print("accent=${s}\n")
        None => print("accent=wrong-type\n")
      }
    }
    None => print("accent=missing\n")
  }

  match (jsonGet(parsed, "emoji")) {
    Some(v) => {
      match (jsonAsString(v)) {
        Some(s) => print("emoji=${s}\n")
        None => print("emoji=wrong-type\n")
      }
    }
    None => print("emoji=missing\n")
  }

  match (jsonGet(parsed, "count")) {
    Some(v) => {
      match (jsonAsInt(v)) {
        Some(i) => print("count=${i}\n")
        None => print("count=wrong-type\n")
      }
    }
    None => print("count=missing\n")
  }

  match (jsonGet(parsed, "big")) {
    Some(v) => {
      match (jsonAsFloat(v)) {
        Some(f) => print("big=${f}\n")
        None => print("big=wrong-type\n")
      }
    }
    None => print("big=missing\n")
  }

  match (jsonGet(parsed, "ratio")) {
    Some(v) => {
      match (jsonAsFloat(v)) {
        Some(f) => print("ratio=${f}\n")
        None => print("ratio=wrong-type\n")
      }
    }
    None => print("ratio=missing\n")
  }

  match (jsonGet(parsed, "ok")) {
    Some(v) => {
      match (jsonAsBool(v)) {
        Some(b) => print("ok=${b}\n")
        None => print("ok=wrong-type\n")
      }
    }
    None => print("ok=missing\n")
  }

  match (jsonGet(parsed, "nope")) {
    Some(v) => {
      match (jsonAsBool(v)) {
        Some(b) => print("nope=${b}\n")
        None => print("nope=wrong-type\n")
      }
    }
    None => print("nope=missing\n")
  }

  match (jsonGet(parsed, "nil")) {
    Some(v) => print("nil=${jsonIsNull(v)}\n")
    None => print("nil=missing\n")
  }

  match (jsonGet(parsed, "list")) {
    Some(v) => {
      match (jsonAsArray(v)) {
        Some(items) => {
          print("list_len=${len(items)}\n")
          match (jsonAsInt(items[0])) {
            Some(i) => print("list0=${i}\n")
            None => print("list0=wrong-type\n")
          }
          match (jsonAsInt(items[1])) {
            Some(i) => print("list1=${i}\n")
            None => print("list1=wrong-type\n")
          }
          match (jsonAsInt(items[2])) {
            Some(i) => print("list2=${i}\n")
            None => print("list2=wrong-type\n")
          }
        }
        None => print("list=wrong-type\n")
      }
    }
    None => print("list=missing\n")
  }

  match (jsonGet(parsed, "nested")) {
    Some(v) => {
      match (jsonGet(v, "inner")) {
        Some(inner) => {
          match (jsonAsBool(inner)) {
            Some(b) => print("nested_inner=${b}\n")
            None => print("nested_inner=wrong-type\n")
          }
        }
        None => print("nested_inner=missing\n")
      }
    }
    None => print("nested=missing\n")
  }

  print(jsonEncode(parsed))
  print("\n")
}
