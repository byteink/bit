// run
// #5170: JSXNamespacedName against the REAL pkg/web library - a tag name and
// an attribute name each carrying one namespace (`<svg:circle
// xlink:href="#a">`), the SVG/XLink shape real HTML actually uses. The
// merged name reaches `elem`/`attr` as an ordinary quoted string with the
// colon inside it (parserjsx.bit's `parseJsxName`), so no desugaring work of
// its own is needed - this proves the parse, not a new code path.
import { render, elem, attr, text } from "../../pkg/web"

fn main() {
  let icon = <svg:circle xlink:href="#a">ref</svg:circle>
  println(render(icon))
}
