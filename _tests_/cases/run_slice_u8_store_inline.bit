// run
// #4381: `xs[i] = v` on a `[]u8` stores INLINE — one `strb` at `buf + off + i`
// — instead of through `rt_call slice_set`. A `[]u8` buffer is BYTE-packed
// (ABI.md §9, `elem_size == 1`, #3121/#3226), so the whole assertion here is
// that the store lands at stride 1 and writes exactly one byte: byte for byte
// what the runtime call it replaces does (`storeByte(buf + off + index, word)`,
// runtime/root/slices.bit).
//
// EVERY STORE IS READ BACK AND SO ARE ITS NEIGHBOURS. A store scaled by 8 —
// the word stride every other inline element type uses — leaves the element it
// was asked to write untouched and corrupts heap eight times further along:
// exit 0 with a plausible answer, not a crash. Split across four functions to
// keep each under E0204's complexity limit; the printed order is the assertion.

// The packed arm itself. `bs[2]` is never written, so a wrong stride shows up
// as a moved or missing value rather than as a fault. 200 and 255 are above
// 127 on purpose: a byte store/load pair that sign-extends reads them as -56
// and -1.
fn packed() {
  let bs = []u8(4)
  bs[0] = 1
  bs[3] = 255
  bs[1] = 200
  print("packed=${int(bs[0])},${int(bs[1])},${int(bs[2])},${int(bs[3])}\n")
}

// A reslice carries a NON-ZERO `off` (ABI.md §2, header word 2), so the
// element address is `buf + (off + i)` and not `buf + i`. A store that assumed
// `off == 0` would write over the parent's earlier elements and still read
// back correctly through the view, so the parent is printed too — it is the
// only place that error is visible.
fn viewAtOffset() {
  let parent = []u8(6)
  let i = 0
  while (i < 6) {
    parent[i] = u8(10 + i)
    i = i + 1
  }
  let view = parent[2:5]
  view[0] = 99
  view[2] = 98
  print("view=${int(view[0])},${int(view[1])},${int(view[2])}\n")
  print("parent=${int(parent[0])},${int(parent[1])},${int(parent[2])},${int(parent[3])},${int(parent[4])},${int(parent[5])}\n")
}

// `xs[i] += v` reaches the SAME predicate through a different call site
// (`writeLvalue`, lowerassign.bit) than a plain `xs[i] = v` (`lowerIndexStore`,
// lowerflow.bit). Both values wrap in a `u8` (SPEC §11.1): 250 + 10 is 4 and
// 7 - 9 is 254, which is what a store that silently widened the value to a
// word would get wrong.
fn compound() {
  let bs = []u8(3)
  bs[1] = 250
  bs[1] += 10
  bs[2] = 7
  bs[2] -= 9
  print("compound=${int(bs[0])},${int(bs[1])},${int(bs[2])}\n")
}

// The CONTROL, and the reason the predicate tests `sliceElemSizeFor` rather
// than `widthOf`. `[]i8` and `[]bool` are WORD-strided (`elem_size == 8`)
// while their own width is 1, so they must stay on `rt_call slice_set`: a byte
// store would leave the other seven bytes of the slot holding whatever was
// there before, and `rtSliceGet` still reads the slot whole — `ns[0] /= 2` on
// -1 would then divide 255 and yield 127 instead of 0.
fn narrowControl() {
  let ns = []i8(2)
  ns[0] = -1
  ns[0] /= 2
  ns[1] = -128
  let fs = []bool(3)
  fs[1] = true
  print("i8=${int(ns[0])},${int(ns[1])} bool=${fs[0]},${fs[1]},${fs[2]}\n")
}

fn main() {
  packed()
  viewAtOffset()
  compound()
  narrowControl()
}
