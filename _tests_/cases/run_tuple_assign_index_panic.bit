// panic
// #6681: a multiple assignment bounds-checks each store as a single assignment
// does. The first store lands; the second index is out of range, so the program
// dies loudly at that store instead of writing past the slice.
fn main() {
  let xs = []int{ 1, 2, 3 }
  let i = 5
  println("start")
  xs[0], xs[i] = 9, 8
  println("survived")
}
