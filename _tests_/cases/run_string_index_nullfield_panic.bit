// panic
// #4346, the null string header: reading a byte of a zeroed class's `string`
// field. The field holds the NULL WORD, not an empty header (SPEC §13.4,
// #1564/#1570), which is the arm `bit_rt_string_byte` reached through
// `strSize`'s explicit `s == 0` guard before it looked at a length.
//
// The inline lowering has no null test of its own: it relies on `slice_len`
// reading a null header as 0 (`emitHeaderWordOrZero`, keyed on `isHeaderBase`,
// which answers true for a string), which makes every index fail the bounds
// compare and reach the same panic. That is one fewer branch on the hot path
// and one more thing that can be silently wrong — drop the null guard and this
// read faults at address 8 with SIGSEGV, which is exit 11, not exit 2.
import { args } from "std/os"

class Z { s: string, n: int }

fn zero(): int { return len(args()) - 1 }

fn main() {
  let z = Z{}
  print("start len=${len(z.s)}\n")
  print("byte=${z.s[zero()]}\n")
  print("unreachable\n")
}
