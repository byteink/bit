// run
// #6688: every declared fallible function returns its error word under
// BIT_ERR_REG, so the three call producers that reach one bind it: a method
// called by name (`Box.m`), an interface call through the vtable (`Reader.read`),
// and a generic instance (`firstPos`, and `Cell<T>.get` on a generic class). The
// program prints the same lines with the flag off and on (`BIT_ERR_REG=1 ./make
// test-golden` runs the word path).
//
//   1. `Box.m`        a class method with `?` and `catch`, ok and failing
//   2. `Reader.read`  an interface method with `?` and `catch`, through the vtable
//   3. `firstPos`     a generic free fn, with `?` and `catch`
//   4. `Cell<T>.get`  a generic class's method, with `?` and `catch`
//   5. `Box.make`     a static method
//   6. `Pager.next`   a fallible `next(): Option<int>!` drained by `for x of it?`,
//                     on the class and through the interface

interface Reader {
  read(): int!,
}

class Fixed {
  n: int

  read(): int! {
    if (this.n < 0) {
      fail newError("neg")
    }
    return this.n
  }
}

class Box {
  v: int

  m(): int! {
    if (this.v == 0) {
      fail newError("zero")
    }
    return this.v + 1
  }

  static make(n: int): Box! {
    if (n < 0) {
      fail newError("make")
    }
    return Box{ v = n }
  }
}

class Cell<T> {
  x: T

  get(ok: (T) => bool): T! {
    if (!ok(this.x)) {
      fail newError("cell")
    }
    return this.x
  }
}

fn firstPos<T>(xs: []T, ok: (T) => bool): T! {
  for x of xs {
    if (ok(x)) {
      return x
    }
  }
  fail newError("none")
}

fn viaReader(r: Reader): int! {
  let v = r.read()?
  return v + 100
}

fn viaBox(b: Box): int! {
  let v = b.m()?
  return v * 2
}

fn viaGeneric(xs: []int): int! {
  let v = firstPos(xs, (x: int) => x > 0)?
  return v + 1000
}

fn viaCell(c: Cell<int>): int! {
  let v = c.get((x: int) => x > 0)?
  return v + 10000
}

interface Pager {
  next(): Option<int>!,
}

class Pages {
  n: int
  failAt: int

  next(): Option<int>! {
    if (this.n == this.failAt) {
      fail newError("page")
    }
    if (this.n <= 0) {
      return Option.None
    }
    this.n = this.n - 1
    return Option.Some(this.n)
  }
}

fn drainClass(it: Pages): int! {
  let sum = 0
  for x of it? {
    sum = sum + x
  }
  return sum
}

fn drainIface(it: Pager): int! {
  let sum = 0
  for x of it? {
    sum = sum + x
  }
  return sum
}

fn showPages() {
  println(
    "pages class ok=${drainClass(Pages{ n = 4, failAt = -1 }) catch -1} bad=${drainClass(
      Pages{ n = 4, failAt = 2 },
    ) catch -1}",
  )
  println(
    "pages iface ok=${drainIface(Pages{ n = 4, failAt = -1 }) catch -1} bad=${drainIface(
      Pages{ n = 4, failAt = 2 },
    ) catch -1}",
  )
}

fn showReader() {
  println("reader ok=${viaReader(Fixed{ n = 5 }) catch -1} bad=${viaReader(Fixed{ n = -5 }) catch -1}")
  let r: Reader = Fixed{ n = 8 }
  println("direct=${r.read() catch -2}")
}

fn showBox() {
  println("box ok=${viaBox(Box{ v = 3 }) catch -1} bad=${viaBox(Box{ v = 0 }) catch -1}")
  let made = Box.make(9) catch Box{ v = 0 }
  let failed = Box.make(-9) catch Box{ v = -1 }
  println("make ok=${made.v} bad=${failed.v}")
}

fn showGeneric() {
  println("generic ok=${viaGeneric([0, -1, 7]) catch -1} bad=${viaGeneric([0, -1]) catch -1}")
  println("cell ok=${viaCell(Cell<int>{ x = 4 }) catch -1} bad=${viaCell(Cell<int>{ x = -4 }) catch -1}")
}

fn main() {
  showReader()
  showBox()
  showGeneric()
  showPages()
}
