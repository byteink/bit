// run
// #2278 (ASCII half): std/strings had no case-insensitive comparison at all,
// so every caller had to allocate two lowercased copies first. `equalFold`
// adds that without allocating, for ASCII. #2341 (the Unicode half) then
// extended `equalFold` to Latin-1 Supplement, Latin Extended-A/B, Greek and
// Coptic, and Cyrillic too — see _tests_/cases/run_strings_fold.bit for that
// coverage; this file keeps the original ASCII-only assertions plus the one
// non-ASCII case (É/é) that #2341 changed the answer to.
//
// #5920: `equalFold` compares two ASCII bytes directly and decodes runes only
// where either byte is >= 0x80. Every ASCII byte pair is pinned against
// `toLower` of both sides, and the pairs where exactly one side is ASCII, or
// both are invalid bytes, are pinned to the answers they gave before it.
import { equalFold, toLower } from "std/strings"

// The one-byte string holding `v`.
fn byteString(v: i64): string {
  let bs = []byte(1)
  bs[0] = u8(v)
  return string(bs)
}

// All 128x128 ASCII pairs; returns how many disagreed with `toLower`.
fn asciiPairs(): i64 {
  let bad = 0
  let x = 0
  while (x < 128) {
    let a = byteString(x)
    let y = 0
    while (y < 128) {
      let b = byteString(y)
      if (equalFold(a, b) != (toLower(a) == toLower(b))) {
        println("MISMATCH x=${x} y=${y}")
        bad = bad + 1
      }
      y = y + 1
    }
    x = x + 1
  }
  return bad
}

fn main() {
  assert(equalFold("abc", "ABC"), "pure-ASCII fold must match")
  assert(equalFold("Bob", "bob"), "mixed-case ASCII fold must match")
  assert(!equalFold("abc", "abd"), "different letters must not match")
  assert(!equalFold("abc", "abcd"), "different lengths must not match")
  assert(equalFold("", ""), "two empty strings must match")
  assert(equalFold("HTTP/1.1", "http/1.1"), "non-letter bytes must compare exactly")
  assert(!equalFold("straße", "STRASSE"), "simple folding must not expand ß to ss (#2341 too)")
  // "É" (U+00C9) vs "é" (U+00E9): Latin-1 Supplement case pair, now folded by
  // #2341 — must compare equal.
  assert(equalFold("É", "é"), "Latin-1 Supplement is folded as of #2341")

  println("ascii pairs mismatches=${asciiPairs()}")
  // One side ASCII, the other not: these take the rune path, so none of
  // them folds to its ASCII look-alike in this table.
  println("0130/i ${equalFold("\u{130}", "i")} i/0130 ${equalFold("i", "\u{130}")}")
  println("017F/s ${equalFold("\u{17F}", "s")} s/017F ${equalFold("s", "\u{17F}")}")
  println("212A/k ${equalFold("\u{212A}", "k")} k/212A ${equalFold("k", "\u{212A}")}")
  println("00C9/00E9 ${equalFold("\u{C9}", "\u{E9}")}")
  // Two different invalid bytes both decode to U+FFFD.
  println("80/81 ${equalFold("\x80", "\x81")}")
  // ASCII, then a rune pair, then ASCII again, on both sides.
  println("xEy/XeY ${equalFold("x\u{C9}y", "X\u{E9}Y")} xEy/XeZ ${equalFold("x\u{C9}y", "X\u{E9}Z")}")
}
