// run
// #2278 (ASCII half): std/strings had no case-insensitive comparison at all,
// so every caller had to allocate two lowercased copies first. `equalFold`
// adds that without allocating, for ASCII. #2341 (the Unicode half) then
// extended `equalFold` to Latin-1 Supplement, Latin Extended-A/B, Greek and
// Coptic, and Cyrillic too — see _tests_/cases/run_strings_fold.bit for that
// coverage; this file keeps the original ASCII-only assertions plus the one
// non-ASCII case (É/é) that #2341 changed the answer to.
import { equalFold } from "std/strings"

fn main() {
  assert(equalFold("abc", "ABC"), "pure-ASCII fold must match")
  assert(equalFold("Bob", "bob"), "mixed-case ASCII fold must match")
  assert(!equalFold("abc", "abd"), "different letters must not match")
  assert(!equalFold("abc", "abcd"), "different lengths must not match")
  assert(equalFold("", ""), "two empty strings must match")
  assert(equalFold("HTTP/1.1", "http/1.1"), "non-letter bytes must compare exactly")
  assert(!equalFold("straße", "STRASSE"), "simple folding must not expand ß to ss (#2341 too)")
  // "É" (U+00C9) vs "é" (U+00E9): Latin-1 Supplement case pair, now folded by
  // #2341 — must compare equal.
  assert(equalFold("É", "é"), "Latin-1 Supplement is folded as of #2341")
  println("ok")
}
