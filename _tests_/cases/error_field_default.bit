// error
// SPEC §10.5/§15.4, #3838: a class field default is a CONSTANT expression,
// folded once and stored at every construction site -- so there is no
// run-time initializer, no allocation and no field-to-field ordering. Three
// ways to get it wrong, and each reports the thing that is actually wrong.
//
// The overflow case is deliberately NOT E0064: `MAX + 1` IS a constant
// expression, it simply has no i64, and telling the reader it is not constant
// sends them looking for a function call that is not there.
fn readEnv(): int {
  return 1
}

class NotConst {
  x: int = readEnv(),
}

class WrongType {
  x: int = "hello",
}

class Overflows {
  x: int = 9223372036854775807 + 1,
}

fn main() {
  print("${NotConst{}.x} ${WrongType{}.x} ${Overflows{}.x}\n")
}
