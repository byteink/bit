// run
// A local VALUE shadowing a same-named free function is called through the
// VALUE, never the declaration (SPEC §17.5, #1552). Each case below would print
// the declaration's answer (n + 100) if the call resolved by name instead of
// through the binding the callee actually resolves to.
//
// Every binder that can shadow is covered, because they reach lowering by
// different routes: `let`, `const`, a block-scoped `let`, a parameter, a
// for-of element binding, and a map's value binding. The declaration is written
// to return a VISIBLY different result from every shadow, so a direct call to
// it cannot be mistaken for a correct answer.
fn pick(n: int): int {
  return n + 100
}

fn viaParam(pick: (int) => int): int {
  return pick(21)
}

fn main() {
  let a = (n: int) => n * 2
  print("${a(21)}\n")

  // `let` shadows the declaration.
  let pick = (n: int) => n * 2
  print("${pick(21)}\n")

  // A parameter shadows it inside another function.
  print("${viaParam((n: int) => n * 2)}\n")

  // A for-of element binding shadows it.
  let fs = [](int) => int{ (n: int) => n * 2 }
  for pick of fs {
    print("${pick(21)}\n")
  }

  // A map value binding shadows it.
  let m = map<string, (int) => int>{ "k": (n: int) => n * 2 }
  for (k, pick) of m {
    print("${k}${pick(21)}\n")
  }

  // The declaration is still reachable where nothing shadows it.
  print("${pick2(21)}\n")
}

fn pick2(n: int): int {
  return pick(n)
}
