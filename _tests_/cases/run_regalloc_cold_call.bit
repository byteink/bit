// run
// #7771: a plain call crosses a value only where the value is still needed
// once the call returns. `digits` and `hot` hold values across a cold `fail`
// block whose call reaches no later read, so those values may sit in
// caller-saved registers. `after` reads `k` after the call in the call's own
// block, and `rejoin` reaches a read of `k` through the block the call's block
// jumps to: in both `k` must survive `fib` in a callee-saved register or a
// slot, or the sums below come out wrong.

fn fib(n: int): int {
  if (n < 2) {
    return n
  }
  return fib(n - 1) + fib(n - 2)
}

fn digits(s: string): int! {
  let total = 0
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      fail newError("bad digit at ${i}")
    }
    total = total * 10 + i64(c - '0')
    i = i + 1
  }
  return total
}

fn hot(n: int): int! {
  let sum = 0
  let i = 0
  while (i < n) {
    let a = i * 3
    let b = i ^ 5
    if (a > 100000) {
      fail newError("too big at ${i}")
    }
    sum = sum + a + b
    i = i + 1
  }
  return sum
}

fn after(a: int, flag: bool): int {
  let k = a * 7 + 3
  if (flag) {
    let f = fib(a)
    return k + f
  }
  return k * 2
}

fn rejoin(a: int, flag: bool): int {
  let k = a * 11 + 5
  let extra = 0
  if (flag) {
    extra = fib(a)
  }
  return k + extra
}

fn main() {
  for s of ["12345", "907", "12x4"] {
    let v = digits(s) catch e {
      println("digits ${s}: ${e.message()}")
      continue
    }
    println("digits ${s}: ${v}")
  }
  for n of [10, 40000] {
    let v = hot(n) catch e {
      println("hot ${n}: ${e.message()}")
      continue
    }
    println("hot ${n}: ${v}")
  }
  println("after: ${after(20, true)} ${after(20, false)}")
  println("rejoin: ${rejoin(20, true)} ${rejoin(20, false)}")
}
