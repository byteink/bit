// run
// #5333: `jsx_text` (SPEC §12.12) is "any source byte but '<' or '{', a raw
// run, not tokenized" — the ordinary lexer must never see it. One text run
// carrying the five characters that lexed as ordinary Bit tokens before this
// fix (each opens or is a real Bit token elsewhere: `'` a rune, `"` a
// string, `` ` `` a raw string, `#`/`$` unexpected-byte) and the ten that
// already worked (mere punctuation to the lexer), through the REAL pkg/web
// library so `render`'s HTML-escaping of `'`, `"` and `&` is exercised too —
// a fix that special-cases the five rejected characters would still pass a
// smaller test than this one and leave the accepted ten unchecked.
import { Node, render, elem, attr, frag, text } from "../../pkg/web"

fn main() {
  let p = <p>it's a "quote" and a `backtick`, #5 for $10 & 20% @home! really? yes; done: a=b+c~x</p>;
  println(render(p))

  // `<` and `{` still terminate a `jsx_text` run (SPEC §12.12), even with a
  // rejected character glued to either side of the boundary: `'` right
  // before `{`, `#` right after the nested tag's `>`.
  let name = "x"
  let q = <p>it's{text(name)}
    <b>#tag</b>
  </p>
  println(render(q))
}
