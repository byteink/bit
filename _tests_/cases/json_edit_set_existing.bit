// run
// stdlib/json/edit.bit's cstSetString (#1725), REPLACING an EXISTING key's
// string value in place. A golden case is single-file with no prelude but
// CAN import std/json (see json_cst_roundtrip_one_edit.bit, #3063):
// _tests_/bit/golden.bit's checkRun runs `bit build <case>` with BIT_STDLIB
// exported, so the import below resolves exactly as it would for any other
// caller — this file no longer redeclares the lexer, the CST types, the CST
// parser, or the edit function under test.
//
// This used to assert survival via `CstEntry.trivia.leading[0]`, a field the
// current (post-#1726) CstEntry doesn't have: a per-entry comment is no
// longer a field on the entry, it's part of the parent CstObject's opaque
// `gaps` (stdlib/json/cst.bit). "Did name's own leading comment survive" can
// only be answered now by comparing PRINTED bytes, not by reading a field —
// so this follows json_cst_roundtrip_one_edit.bit's shape (#3063) instead:
// parse, edit, print, and assert via a line-by-line diff that EXACTLY one
// line changed (nothing else moved, so name's own leading comment, its
// keyText, and "count" survived byte-for-byte) AND that the one changed line
// holds the right text (the new value, JSON-quoted-and-escaped, in place).
// This is a strictly stronger check than the original: the old test never
// verified the comment's surrounding whitespace at all, and a byte-level
// comparison can't be fooled by how the model happens to group the trivia
// internally.
import { cstParse, cstSetString, cstPrint } from "std/json"

// --- line-diff assertion helper (json_cst_roundtrip_one_edit.bit, #3063) ---

// `s` split on '\n' (no trailing-newline special case needed: neither the
// fixture nor a valid edit output ends in one). Bounded by `len(s)`.
fn splitLines(s: string): []string {
  let lines = []string(0)
  let start = 0
  let i = 0
  let n = len(s)
  while (i < n) {
    if (s[i] == '\n') {
      lines = append(lines, s[start:i])
      start = i + 1
    }
    i = i + 1
  }
  lines = append(lines, s[start:n])
  return lines
}

// The number of positions where `a` and `b` differ, plus any extra lines one
// side has beyond the other's length (never true for a `cstSetString` edit,
// which only ever replaces one value's text — checked here anyway, so a
// regression that adds/drops a line shows up as more than one changed line
// instead of silently comparing only the shorter prefix).
fn countDiffLines(a: []string, b: []string): int {
  let minN = len(a)
  if (len(b) < minN) {
    minN = len(b)
  }
  let maxN = len(a)
  if (len(b) > maxN) {
    maxN = len(b)
  }
  let count = maxN - minN
  let i = 0
  while (i < minN) {
    if (a[i] != b[i]) {
      count = count + 1
    }
    i = i + 1
  }
  return count
}

// `b`'s text at the first position where `a` and `b` differ ("<none>" if
// they don't), or `b`'s first line past `a`'s end if `b` is strictly longer.
// Complements countDiffLines: the count proves nothing ELSE moved, this
// proves the one line that DID move holds the right text. Bounded by
// min(len(a), len(b)).
fn changedLineText(a: []string, b: []string): string {
  let minN = len(a)
  if (len(b) < minN) {
    minN = len(b)
  }
  let i = 0
  while (i < minN) {
    if (a[i] != b[i]) {
      return b[i]
    }
    i = i + 1
  }
  if (len(b) > minN) {
    return b[minN]
  }
  return "<none>"
}

// --- test -------------------------------------------------------------

fn main() {
  // A leading comment on "name"; cstSetString must leave it (and keyText)
  // untouched when it replaces only "name"'s value. New value has an
  // embedded quote, so rawText must come back JSON-escaped.
  let source = "{\n  // comment before name\n  \"name\": \"old\",\n  \"count\": 1\n}"

  let root = cstParse(source) catch e {
    print("parse-error: ${e.message()}\n")
    return
  }

  let updated = cstSetString(root, []string{ "name" }, "new \"value\"") catch e {
    print("set-error: ${e.message()}\n")
    return
  }

  let printed = cstPrint(updated)
  let sourceLines = splitLines(source)
  let printedLines = splitLines(printed)
  let changed = countDiffLines(sourceLines, printedLines)
  print("changedLines=${changed}\n")
  print("changedLine=${changedLineText(sourceLines, printedLines)}\n")
}
