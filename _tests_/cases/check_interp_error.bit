// error
// The predeclared `error` interface (§10.6) carries `message(): string`, not
// `show(): string`, so an error value does not interpolate either — print
// `e.message()` instead. Rejected here rather than in lowering. E0073 names
// `.message()` in its hint for this exact case (#2156).
class Boom { why: string 
  message(): string { return this.why }
}
fn blow(): i64! {
  fail Boom{why: "no"}
}
fn main() {
  let v = blow() catch e {
    print("${e}\n")
    0
  }
  print("${v}\n")
}
