// run
// #6194: a generic class's OWN type param, spelled the same letter as
// std/core's `Option<T>` own template param, must not be mistaken for
// Option's own rigid parameter just because `isOwnTypeParams`
// (compiler/checkinst.bit) cannot see INTO another module's type
// declarations.
//
// `Box<T>.get(): Option<T>` — `get` declares none of its own type params
// (`methodOwnGenericCount` is 0: the parser merges the RECEIVER's `<T>` in
// front, and `collectFuncDecl` REUSES `Box`'s own class-level `T` id for
// that merged prefix, compiler/checkbindfunc.bit). So `Box<Person>.get()`'s
// recorded result comes from `copyInstMethod` (compiler/checkinstmethods.bit)
// substituting `Box`'s `T` for `Person` inside the TEMPLATE result
// `Option<T>` (compiler/types.bit's `substType`/`substNominal`).
//
// `substNominal` asks `instantiateNamed(oc, "Option", [Box's T])`, where
// `oc` is `Option`'s OWNER checker — std/core, a DIFFERENT module than the
// one declaring `Box`. `instantiateNamed` refuses to instantiate when the
// argument IS the target's own rigid parameter (`isOwnTypeParams`), and that
// check used to scan only `oc.typeDecls` — std/core's OWN module — for a
// type declaration whose generics list contains the argument id. `Box`'s
// `T` lives in THIS module's `typeDecls`, invisible to that scan, so the
// by-NAME match ("T" == Option's own "T") went unchallenged and
// `isOwnTypeParams` answered yes for a genuinely foreign id: `Box<Person>`'s
// `get()` kept the UNSUBSTITUTED template `Option<T>` as its recorded
// result, forever.
//
// WHY A FIXTURE AND NOT A COMMENT. With generic explode off this cost
// nothing observable — every `Option<T>` instantiation boxes to the same
// one-handle shape regardless of which numeric type id names it. #6190
// (generic explode default-on) made the numeric id load-bearing:
// `isSome<Person>`/`unwrap<Person>` explode their OWN `Option<Person>`
// parameter into two words (`explodedWordTypes`, compiler/lowerexplode.bit),
// while the unsubstituted `Option<T>` this bug left behind refuses
// explosion (`enumExplosionEligible` refuses a `TypeParam` payload) — so
// the call site packs one argument for a callee declaring two and
// `callArityEscapesInFunc` (compiler/verify.bit) refuses the module. Both a
// closure body and a plain function body take the identical path, so both
// are pinned here.

class Person {
  id: i64,
}

class Box<T> {
  v: T
  get(): Option<T> {
    return Option<T>.Some(this.v)
  }
}

fn mkBox(id: i64): Box<Person> {
  return Box<Person>{ v = Person{ id = id } }
}

fn readDirect(id: i64): i64 {
  let opt = mkBox(id).get()
  if (!isSome<Person>(opt)) {
    return -1
  }
  return unwrap<Person>(opt).id
}

fn readViaClosure(id: i64): i64 {
  let f = () => {
    let opt = mkBox(id).get()
    if (!isSome<Person>(opt)) {
      return -1
    }
    return unwrap<Person>(opt).id
  }
  return f()
}

fn main() {
  print("direct ${readDirect(7)}\n")
  print("closure ${readViaClosure(9)}\n")
}
