// lint exit=0
// #5077 E0217 `tx-captured-executor`: the documented, safe form. Naming the
// closure parameter `db` -- the same name as the outer handle -- SHADOWS
// it, so the outer `pool` is unreachable by that name inside the block and
// the mistake is unwritable. Same body as lint_tx_escape_captured.bit,
// differing only in the parameter's name.
import { Pool } from "std/sql"

class Entity { id: int }

fn transfer(pool: Pool, a: Entity, b: Entity): ()! {
  pool.tx((pool) => {
    pool.save(a)?
    pool.save(b)?
  })?
}
