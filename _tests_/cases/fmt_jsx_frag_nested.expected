// fmt
// #5165: a nested JSX fragment glued to the text before it (`<>a<>b</></>`)
// must stay on one line: nothing in the body broke, so the closer must not
// dangle alone at the outer indent either -- the positive case, pinning the
// fix in fmtPrintJsxChildren (compiler/fmtjsx.bit).
//
// `stacked` is the negative control the #4412 precedent calls for: a
// genuinely multi-element list (no text anywhere to glue against) must
// still break one child per line with the closer on its own line at the
// statement's indent, exactly as before this fix -- `broke` only gates the
// case where every item rendered glued to adjacent text.
fn flat(): string {
  let list = <>a<>b</></>
  return list
}

fn stacked(): string {
  let page = <Page>
    <Item />
    <Item />
  </Page>
  return page
}
