// run
// #6988, epic #6984: every `@table` class synthesizes `static __className():
// string`, the class identifier exactly as declared — never the table name —
// reachable through a type parameter bound like `__tableName`, so a resource
// registry keys on `Article` whatever `@table("...")` says.
//
// `Article` has the default table name (`article`), `OrderLine` the default
// snake_case one (`order_line`), and `Account` pins `@table("custom")`, whose
// table name differs from its class name.
import { FieldDesc } from "std/sql"

interface Named {
  static __className(): string,
  static __tableName(): string,
  static __columns(): []FieldDesc,
}

@table class Article {
  id: i64,
}

@table class OrderLine {
  id: i64,
}

@table("custom") class Account {
  id: i64,
}

fn describe<T: Named>(): string {
  return "${T.__className()} -> ${T.__tableName()}"
}

fn main() {
  println(describe<Article>())
  println(describe<OrderLine>())
  println(describe<Account>())
  println(Account.__className())
}
