// run
// #6026 control: an empty `[]` literal against a GENERIC slice parameter
// `[]T` must stay accepted — `vExpectSliceLit` (compiler/validate.bit) takes
// the Slice-kind branch (want's own kind, not the literal's), pushes `T`
// into zero elements, and reports nothing; the new EMPTY-literal rejection
// only fires once `want` itself is a KNOWN non-collection type, never here.
fn count<T>(xs: []T): int {
  return len(xs)
}
fn main() {
  print("${count([])}\n")
}
