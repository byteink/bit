// error
// #4685: the four per-monomorphization BODY rules, judged more than one generic
// deep.
//
// #4657 taught `vInstDescend` to follow a generic call into the callee's body,
// but it followed it with `subtreeCallNodes` and so judged CALLS only. The other
// four rules ran from `vInstWalk` over the ledger entry's own body and nothing
// walked a callee body for them, so two generics down each of these compiled
// clean and was refused by the LOWERER instead, as E0092 at a span the reader
// did not write, after `bit check` exited 0:
//
//   - E0073, an interpolation operand with no `show(): string`,
//   - E0052, a map key type that is not comparable,
//   - E0054, a receiver that cannot be indexed,
//   - E0057, an unknown field or method.
//
// Written ONE level deep every one of them is a check-time diagnostic already —
// `_tests_/cases/check_interp_generic.bit` is E0073's — so the depth is the
// cause and it is the only thing this file varies. `vInstDescend` now runs
// `vInstWalk` over the callee body, the same walk `vInstOne` runs over a ledger
// entry's own, so a body reached by descent is judged by the same five rules as
// a body the ledger names.
//
// The primary span stays on the offending construct, where each rule has always
// put it, and the TRAIL underneath is what reaches the reader: the user's own
// call, then one note per generic body between it and the line reported.
// `vInstNoteTrail` names the user's call at every depth (#4695) and adds a hop
// only per body below it, which is the half this file varies.
//
// `sharedA`/`sharedB` are the arithmetic, not decoration. They call ONE bad
// generic from TWO user-written calls, and each of those calls is separately
// wrong and separately fixable, so both are reported — while `twice`, whose one
// body calls the same generic with the same arguments twice, names ONE emitted
// body and reports ONCE (`vInstClaim`). Without that pair a regression that
// deduped by primary span, or one that deduped by nothing at all, would look the
// same as correct.
//
// The no-false-positive side is _tests_/cases/run_generic_body_rules_depth.bit.
class Opaque {}

fn deepInterp<T>(v: T): string {
  return "${v}"
}

fn midInterp<T>(v: T): string {
  return deepInterp(v)
}

fn deepKey<T>(v: T): int {
  let m = map<T, bool>{}
  m[v] = true
  return len(m)
}

fn midKey<T>(v: T): int {
  return deepKey(v)
}

fn deepIndex<T>(v: T): bool {
  return v[0] == 9
}

fn midIndex<T>(v: T): bool {
  return deepIndex(v)
}

fn deepMember<T>(v: T): int {
  return v.n
}

fn midMember<T>(v: T): int {
  return deepMember(v)
}

fn sharedA<T>(v: T): string {
  return deepInterp(v)
}

fn sharedB<T>(v: T): string {
  return deepInterp(v)
}

fn twice<T>(v: T): string {
  return deepInterp(v) + deepInterp(v)
}

fn main() {
  print("${midInterp(Opaque{})}\n")
  print("${midKey([1])}\n")
  print("${midIndex(Opaque{})}\n")
  print("${midMember(Opaque{})}\n")
  print("${sharedA(Opaque{})}\n")
  print("${sharedB(Opaque{})}\n")
  print("${twice(Opaque{})}\n")
}
