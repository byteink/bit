// run
// #6689: every body reachable through a fallible function VALUE returns the
// error word under BIT_ERR_REG, and `Op.CallValue` binds it. The program prints
// the same lines with the flag off and on (`BIT_ERR_REG=1 ./make test-golden`
// runs the word path). Each value is called with `?` and with `catch`:
//
//   1. an arrow, expression-bodied and block-bodied, capturing a local
//   2. an arrow that forwards a fallible call (`(n) => half(n)`)
//   3. a void-ok arrow `(int) => ()!`
//   4. a free fn used as a value (`fnvalue$trampoline`), non-void and void ok
//   5. a class method used as a value (`Box.m`)
//   6. an interface method used as a value (`ifacemethod$trampoline`)
//   7. a fallible value stored in a field

interface Reader {
  read(): int!,
}

class Fixed {
  n: int

  read(): int! {
    if (this.n < 0) {
      fail newError("neg")
    }
    return this.n
  }
}

class Box {
  v: int

  m(k: int): int! {
    if (k == 0) {
      fail newError("zero")
    }
    return this.v + k
  }
}

type IntFn = (int) => int!
type VoidFn = (int) => ()!

class Holder {
  f: IntFn,
}

fn half(n: int): int! {
  if (n % 2 != 0) {
    fail newError("odd")
  }
  return n / 2
}

fn check(n: int): ()! {
  if (n < 0) {
    fail newError("neg")
  }
}

fn useInt(f: IntFn, n: int): int! {
  let v = f(n)?
  return v + 1000
}

fn catchInt(f: IntFn, n: int): int {
  return f(n) catch -1
}

fn useVoid(f: VoidFn, n: int): int! {
  f(n)?
  return n
}

fn catchVoid(f: VoidFn, n: int): int {
  let r = 7
  f(n) catch e {
    r = -len(e.message())
  }
  return r
}

fn useRead(f: () => int!): int! {
  let v = f()?
  return v + 500
}

fn catchRead(f: () => int!): int {
  return f() catch -3
}

fn show(label: string, a: int, b: int) {
  println("${label} ok=${a} bad=${b}")
}

fn main() {
  let base = 10
  let arrow: IntFn = (n) => {
    if (n < 0) {
      fail newError("neg")
    }
    return n + base
  }
  let expr: IntFn = (n) => n * 2
  let fwd: IntFn = (n) => half(n)
  let blockFwd: IntFn = (n) => {
    return half(n)
  }
  show("arrow ?", useInt(arrow, 5) catch -1, useInt(arrow, -5) catch -1)
  show("arrow catch", catchInt(arrow, 5), catchInt(arrow, -5))
  show("expr ?", useInt(expr, 5) catch -1, useInt(expr, 0) catch -1)
  show("fwd ?", useInt(fwd, 8) catch -1, useInt(fwd, 7) catch -1)
  show("fwd catch", catchInt(fwd, 8), catchInt(fwd, 7))
  show("blockFwd", catchInt(blockFwd, 8), catchInt(blockFwd, 7))

  let nop: VoidFn = (n) => {
    if (n < 0) {
      fail newError("neg")
    }
  }
  show("void arrow ?", useVoid(nop, 3) catch -1, useVoid(nop, -3) catch -1)
  show("void arrow catch", catchVoid(nop, 3), catchVoid(nop, -3))

  show("free ?", useInt(half, 8) catch -1, useInt(half, 7) catch -1)
  show("free catch", catchInt(half, 8), catchInt(half, 7))
  show("free void ?", useVoid(check, 3) catch -1, useVoid(check, -3) catch -1)
  show("free void catch", catchVoid(check, 3), catchVoid(check, -3))

  let bx = Box{ v = 100 }
  let mv = bx.m
  show("method ?", useInt(mv, 4) catch -1, useInt(mv, 0) catch -1)
  show("method catch", catchInt(mv, 4), catchInt(mv, 0))

  let good: Reader = Fixed{ n = 6 }
  let bad: Reader = Fixed{ n = -1 }
  let gr = good.read
  let br = bad.read
  show("iface ?", useRead(gr) catch -1, useRead(br) catch -1)
  show("iface catch", catchRead(gr), catchRead(br))

  let h = Holder{ f = half }
  show("field", h.f(10) catch -1, h.f(11) catch -1)
}
