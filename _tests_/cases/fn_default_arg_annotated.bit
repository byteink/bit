// run
// #5244: an annotated default parameter, `x: int = 1` (SPEC §10.3). Omitting
// the argument uses the default; supplying one overrides it.

fn foo(x: int = 1): int {
  return x * 2
}

fn greet(name: string, punct: string = "!"): string {
  return name + punct
}

fn main() {
  print("${foo()}\n")
  print("${foo(3)}\n")
  print("${greet("hi")}\n")
  print("${greet("hi", "?")}\n")
}
