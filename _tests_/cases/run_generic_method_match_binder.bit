// run
// #4538. A generic METHOD whose own type parameter appears as `Option<T>`,
// destructured with `match`. The arm binder kept the bare `T`, so `t.label()`
// had a receiver that was neither a class nor an interface (E0092) while the
// byte-identical FREE function ran.
//
// `isOwnTypeParams` read the `Option<T>` written inside the method as
// `Option`'s OWN rigid parameter — both are spelled `T` — because the only
// foreign-parameter scan covered receiverless free functions and a method's own
// `<T>` is not one. The mention collapsed to the bare template, so the
// instantiation's env had nothing to substitute and the payload binder stayed a
// type param. Renaming either side's `T` also "fixed" it, which is what
// identified the name comparison as the cause.
//
// `viaFree` / `viaMatch` / `viaIf` are the ticket's three-row discriminator (the
// third is #4531's shape) and must all print what `viaFree` prints. `viaMaybe`
// pins that the collision is with the mentioned declaration's parameter NAME
// and has nothing to do with `Option` in particular. `Holder` is the control the
// fix must not break: `Holder<T>` mentioned inside `Holder`'s own method IS the
// template and stays so, because a method's receiver-merged prefix is excluded
// from the ids recorded as the method's own.
interface Named {
  label(): string,
}

class Tag {
  n: string
  export label(): string {
    return this.n
  }
}

// A user enum whose parameter is spelled `T` as well.
enum Maybe<T> {
  Nothing,
  Just(T),
}

fn viaFree<T: Named>(q: Option<T>): string {
  match (q) {
    Some(t) => return t.label()
    None => return "none"
  }
}

class Box {
  export viaMatch<T: Named>(q: Option<T>): string {
    match (q) {
      Some(t) => return t.label()
      None => return "none"
    }
  }

  export viaIf<T: Named>(q: Option<T>): string {
    if (isSome(q)) {
      return unwrap(q).label()
    }
    return "none"
  }

  export viaMaybe<T: Named>(q: Maybe<T>): string {
    match (q) {
      Just(t) => return t.label()
      Nothing => return "none"
    }
  }
}

class Holder<T> {
  v: T
  export get(): T {
    return this.v
  }
  export peer(other: Holder<T>): T {
    return other.get()
  }
}

fn main() {
  let b = Box{}
  print(viaFree(Option.Some(Tag{ n: "tag" })) + "\n")
  print(b.viaMatch(Option.Some(Tag{ n: "tag" })) + "\n")
  print(b.viaIf(Option.Some(Tag{ n: "tag" })) + "\n")
  print(b.viaMaybe(Maybe.Just(Tag{ n: "tag" })) + "\n")
  let empty: Option<Tag> = Option.None
  print(viaFree(empty) + "\n")
  print(b.viaMatch(empty) + "\n")
  print(Holder<string>{ v: "held" }.peer(Holder<string>{ v: "held" }) + "\n")
}
