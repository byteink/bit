// run
// #4563: `jsonDecode<T>` standing in a GENERIC body, resolved once per
// instantiation. Before this it was E0145 -- the pre-check rewrite
// (compiler/classjsondecodecall.bit) resolves the type argument by NAME, and a
// type parameter is not a name -- so no library could wrap the call and
// `pkg/web`'s `c.body<T>()` (#3877) had to take the decoder as a parameter.
//
// BOTH ENTRY SHAPES, into TWO DIFFERENT classes, in ONE program: a free generic
// function and a generic METHOD. One shape working proves nothing about the
// other -- a free call goes through `resolveCallTarget`'s ledger lookup and a
// method call through `methodTypeArgsRaw`, which had to learn to read an
// explicit type argument at all (#4579) before `T` here could be `Reply`.
//
// Two classes rather than one because the whole mechanism is per-instantiation:
// with a single class, a wrapper that ignored its type argument and always
// called the same decoder would pass. `Note` and `Reply` share no field name and
// every field of each is read back off the decoded value.
//
// THE TRANSITIVE CHAIN IS HERE TOO (`relay` -> `once` -> `jsonDecode`): the
// demand collection propagates "decodes into this type parameter" backwards
// along calls that hand a type parameter along, and a one-deep-only closure
// would leave `relay<Note>` with no synthesized specialisation.
//
// The DIRECT `jsonDecode<Note>(j)` at the bottom is the control: it is still
// rewritten at source level to `__json_dec_Note(j, "", 0)`, and both paths must
// answer the same thing for the same input.
//
// One decode runs over a HAND-BUILT `Json` tree rather than a parsed one. The
// wrapper takes a `Json`, not text, so a decoder that only ever worked on what
// `jsonParse` produces would still be wrong for every caller that builds one.
import { Json, JsonEntry, jsonParse, jsonDecode } from "std/json"

@json class Tagline {
  text: string,
  weight: i32,
}

@json class Note {
  id: i64
  title: string
  pinned: bool
  labels: []string
  @key("body_text")
  bodyText: string
  line: Tagline
}

@json class Reply {
  ref: i64,
  author: string,
  score: f64,
  seen: map<string, bool>,
  nick: Option<string>,
  absent: Option<string>,
}

fn showNote(n: Note): string {
  return "id=${n.id} title=${n.title} pinned=${n.pinned} " +
    "labels=${len(n.labels)}:${n.labels[0]},${n.labels[1]} body=${n.bodyText} " +
    "line=${n.line.text}/${n.line.weight}"
}

fn showReply(r: Reply): string {
  let nick = "none"
  if (isSome(r.nick)) {
    nick = unwrap(r.nick)
  }
  let absent = "none"
  if (isSome(r.absent)) {
    absent = unwrap(r.absent)
  }
  let (seen, ok) = r.seen["x"]
  return "ref=${r.ref} author=${r.author} score=${r.score} " +
    "seen[x]=${seen}/${ok} nick=${nick} absent=${absent}"
}

// A free generic function around the call: the shape a library exports.
fn once<T>(j: Json): T! {
  return jsonDecode<T>(j)?
}

// Two levels of indirection on top of it, neither naming a concrete class.
fn relay<T>(j: Json): T! {
  return once<T>(j)?
}

class Box {
  seen: i64

  // A generic METHOD: `pkg/web`'s `c.body<T>()` in miniature.
  read<T>(j: Json): T! {
    this.seen = this.seen + 1
    return jsonDecode<T>(j)?
  }
}

const noteSrc = "{\"id\":7,\"title\":\"first\",\"pinned\":true," +
  "\"labels\":[\"a\",\"b\"],\"body_text\":\"hello\"," +
  "\"line\":{\"text\":\"lead\",\"weight\":3}}"

const replySrc = "{\"ref\":9,\"author\":\"ada\",\"score\":0.5," +
  "\"seen\":{\"x\":true},\"nick\":\"mango\",\"absent\":null}"

const badSrc = "{\"id\":7,\"title\":\"x\",\"pinned\":true,\"labels\":[]," +
  "\"body_text\":\"y\",\"line\":{\"text\":\"z\",\"weight\":\"no\"}}"

// A `Json` built by hand, so the decode path is exercised on a tree no parser
// produced.
fn taglineJson(): Json {
  return Json.JsonObject(
    [
      JsonEntry{ key: "text", value: Json.JsonString("built") },
      JsonEntry{ key: "weight", value: Json.JsonInt(5) },
    ],
  )
}

// The failure path through a generic wrapper: it must still name the field and
// the full dotted path, which is what makes the wrapper usable by a framework.
// Split out of `main` so neither is over the complexity limit.
fn showFailure(b: Box) {
  let bad = jsonParse(badSrc) catch e {
    print("parse bad: ${e.message()}\n")
    return
  }
  let n5 = b.read<Note>(bad) catch e {
    print("method err: ${e.message()}\n")
    return
  }
  print("unreachable ${n5.id}\n")
}

fn main() {
  let nj = jsonParse(noteSrc) catch e {
    print("parse note: ${e.message()}\n")
    return
  }
  let rj = jsonParse(replySrc) catch e {
    print("parse reply: ${e.message()}\n")
    return
  }
  let b = Box{ seen: 0 }

  let n1 = once<Note>(nj) catch e {
    print("free note: ${e.message()}\n")
    return
  }
  print("free ${showNote(n1)}\n")

  let r1 = once<Reply>(rj) catch e {
    print("free reply: ${e.message()}\n")
    return
  }
  print("free ${showReply(r1)}\n")

  let n2 = b.read<Note>(nj) catch e {
    print("method note: ${e.message()}\n")
    return
  }
  print("method ${showNote(n2)}\n")

  let r2 = b.read<Reply>(rj) catch e {
    print("method reply: ${e.message()}\n")
    return
  }
  print("method ${showReply(r2)}\n")

  let n3 = relay<Note>(nj) catch e {
    print("relay note: ${e.message()}\n")
    return
  }
  print("relay ${showNote(n3)}\n")

  let n4 = jsonDecode<Note>(nj) catch e {
    print("direct note: ${e.message()}\n")
    return
  }
  print("direct ${showNote(n4)}\n")
  let t1 = once<Tagline>(taglineJson()) catch e {
    print("built tagline: ${e.message()}\n")
    return
  }
  print("built ${t1.text}/${t1.weight}\n")

  print("calls=${b.seen}\n")
  showFailure(b)
}
