// panic
//
// #4461, arm B. `emitInlineStringSlice` (lowerreslice.bit) points BOTH of its
// bounds `br`s at one shared `oob` block on purpose. Two `s[lo:hi]` with the
// same `lo`/`hi` ids CSE their `lo <=u hi` compare, so the second slice's
// first `br` folds — but its second `br` does not, because each expansion
// re-loads `len` from its own receiver. `computeDeadBoundsBlocks` then killed
// the shared `oob` on one predecessor's evidence while the other still
// pointed at it, and `emitJumpOrFallThrough` walks PAST a dead block, so the
// surviving out-of-range edge fell through into the success path: `t[0:5]` on
// a 3-byte string built a length-5 view over 3 bytes and returned, exit 0.
fn twoSlices(s: string, t: string, a: int, b: int): string {
  let x = s[a:b]
  let y = t[a:b]
  return x + "|" + y
}

fn main() {
  // s[0:5] is legal (10 bytes); t[0:5] is not (3 bytes) and must panic.
  let r = twoSlices("0123456789", "abc", 0, 5)
  print("no panic, len=${len(r)}\n")
}
