// panic-debug
// #4220: `deadCodeElim` (compiler/opt.bit) dropped a signed-overflow-checked
// instruction whose result is never read, so a genuine overflow silently
// disappeared under `bit build --debug` (the OPTIMIZED path — no `--debug`
// golden case ever passes `--no-optimize`, see stage.bit) while the identical
// program still trapped under `bit build --debug --no-optimize`
// (`--no-optimize` skips `optimizeModule` entirely, so nothing is ever
// elided on that side). This is the ticket's own repro, byte-for-byte:
// `seed()` routes its constant through a local string's runtime `len()` so
// `compiler/optfold.bit`'s `foldAddSubMul` cannot resolve the multiply as a
// compile-time constant. Sibling of overflow_trap_mul_debug.bit: that
// fixture PRINTS the overflowing product, so DCE never saw it as dead and
// never exercised this path — this one discards it instead.
fn seed(): i64 {
  let s = "abcd"
  return i64(len(s))
}

fn main() {
  let a = seed() * 1000000000000000000
  let b = seed()
  let x = a * b   // overflows i64; `x` is never read
  print("ok\n")
}
