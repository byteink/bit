// panic
// #4375, the header test's own boundary. Once `proveInductionBounds` marks the
// element load's unsigned test, the LOOP HEADER is the only bounds check left
// on that access — so the header's strictness becomes load-bearing in a way it
// was not before. `<=` admits exactly one index the buffer does not hold, and
// the pass must refuse an `icmp_sle` header outright rather than treat it like
// `icmp_slt`.
//
// The wrong answer here is not a crash. `i == len` addresses the first word
// PAST the live elements, which is still mapped, so a pass that accepted this
// header would print a plausible number and exit 0. The read is therefore
// printed on stderr — the stream a `// panic` case compares — and the loop
// counts its iterations so the fixture pins WHICH iteration panics, not merely
// that one did.
import { args } from "std/os"

fn main() {
  let xs = [7, 8, 9]
  xs = append(xs, 10 - len(args()))
  let i = 0
  while (i <= len(xs)) {
    eprint("i=${i} read=${xs[i]}\n")
    i = i + 1
  }
  eprint("unreachable\n")
}
