// panic
// #4375, the header test's own boundary. Once `proveInductionBounds` marks the
// element load's unsigned test, the LOOP HEADER is the only bounds check left
// on that access — so the header's strictness becomes load-bearing in a way it
// was not before. `<=` admits exactly one index the buffer does not hold, and
// the pass must refuse an `icmp_sle` header outright rather than treat it like
// `icmp_slt`.
//
// The wrong answer is not a crash: `i == len` addresses the first word PAST the
// live elements, which is still mapped. Against a mutant that accepts `<=`,
// this prints a fifth line and exits 0.
//
// The read is the FIRST thing in the body. A call between the header and the
// access ends the availability chain that makes the two lengths one value id,
// and the pass then declines for a reason unrelated to the operator — which
// would leave this fixture unable to fail.
import { args } from "std/os"

fn main() {
  let xs = [7, 8, 9]
  xs = append(xs, 10 - len(args()))
  let i = 0
  while (i <= len(xs)) {
    let got = xs[i]
    eprint("i=${i} read=${got}\n")
    i = i + 1
  }
  eprint("unreachable\n")
}
