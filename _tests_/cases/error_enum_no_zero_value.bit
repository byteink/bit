// error
// #4182 (§13.4, E0083): a payload-carrying enum with NO variant safe to
// default to has no zero value, exactly like a class with a class-typed
// field. `Result<T, E>` (stdlib/core/core.bit) is the prelude's example —
// both `Ok` and `Err` carry a payload, so unlike `Option<T>` there is no
// reordering that gives it a real zero-tag variant. Three surfaces, matching
// error_struct_no_zero_value.bit's class-typed-field cases exactly.
class Box { r: Result<int, string> }

fn main() {
  // Surface 1: a keyed literal leaving the Result-typed field out.
  let b = Box{}

  // Surface 2: no initializer at all.
  let x: Result<int, string>

  // Surface 3: `[]T(n)` means n zero values (§12.9), and there is none to give.
  let xs = []Result<int, string>(2)

  println(itoa(len(xs)))
}

fn itoa(n: int): string {
  if (n == 0) {
    return "0"
  }
  let d = "0123456789"
  let s = ""
  let v = n
  while (v > 0) {
    s = d[v % 10:v % 10 + 1] + s
    v = v / 10
  }
  return s
}
