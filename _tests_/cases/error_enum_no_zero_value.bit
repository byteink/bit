// error
// #4182 (§13.4, E0083): a payload-carrying enum with NO variant safe to
// default to has no zero value, exactly like a class with a class-typed
// field. `Result<T, E>` (stdlib/core/core.bit) is the prelude's example —
// both `Ok` and `Err` carry a payload, so unlike `Option<T>` there is no
// reordering that gives it a real zero-tag variant. Three surfaces, matching
// error_struct_no_zero_value.bit's class-typed-field cases exactly.
//
// Surfaces 4 and 5 pin the same rejection reached through a CLASS whose field
// is such an enum, which is what #4469 leans on. Since #4469, `zeroValue`'s
// struct arm MATERIALIZES a boxed-enum field rather than leaving it null, and
// the only thing standing between that fill and an unsound one -- an enum
// whose tag-0 variant has a payload the fill has nothing to put in -- is this
// check. Surface 1 already covered the literal; `[]T(n)` and a bare binding
// went through a different validator and were untested here.
class Box { r: Result<int, string> }

fn main() {
  // Surface 1: a keyed literal leaving the Result-typed field out.
  let b = Box{}

  // Surface 2: no initializer at all.
  let x: Result<int, string>

  // Surface 3: `[]T(n)` means n zero values (§12.9), and there is none to give.
  let xs = []Result<int, string>(2)

  // Surface 4: `[]T(n)` where T is the CLASS holding the field.
  let bs = []Box(2)

  // Surface 5: a bare binding of that class.
  let y: Box

  // Every binding is read below. That is not decoration: the E0083s above are
  // the point of this fixture and a `let` with no reader would ALSO raise
  // E0211, so an unused binding here quietly makes the file assert two things
  // at once. (`b` and `x` were unread before #4469 extended this; reading them
  // changes no diagnostic, as their spans are on the declarations.)
  println(itoa(len(xs) + len(bs)))
  sink(b)
  sink(y)
  sinkR(x)
}

// Readers, so no surface above is an unused local. Never called at run time --
// this case fails `bit check`.
fn sink(b: Box) {}

fn sinkR(r: Result<int, string>) {}

fn itoa(n: int): string {
  if (n == 0) {
    return "0"
  }
  let d = "0123456789"
  let s = ""
  let v = n
  while (v > 0) {
    s = d[v % 10:v % 10 + 1] + s
    v = v / 10
  }
  return s
}
