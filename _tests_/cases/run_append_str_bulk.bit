// run
// #4371: `append(dst, s)` where `dst` is `[]byte` and `s` is a `string`
// appends the string's BYTES in one `rt_call slice_append_str`
// (runtime/root/slices.bit's `rtSliceAppendStr`) instead of one call per byte.
//
// THE ORACLE IS THE PER-BYTE LOOP, not a hand-written expectation: `perByte`
// below spells the identical program the old way — `s[i]` through
// `bit_rt_string_byte`, one `append` per byte — so every row asserts the two
// mechanisms agree. A hand-typed `.expected` would only prove the new path is
// self-consistent; this proves it against the path it replaces.
//
// Lengths 0/1/15/16/17/4096 straddle `copyBytes`'s word loop (root.bit,
// #4350): 0 is the early return, 15 stays inside the peeled bytewise tail, 16
// is exactly two whole words, 17 is a word loop plus a one-byte tail, and 4096
// is far past any doubling boundary — the length that would cost twelve
// reallocations if the grow were per-element rather than `max(2*cap, len+n)`.
//
// The four destinations are the four header states this entry point can be
// handed: a NULL header (a zeroed class's slice field, §13.4 — `appendTarget`
// must allocate), a real header with cap 0, one with spare capacity (no grow),
// and one that is exactly full (grow on the first byte). `cap` is printed for
// both paths on purpose: the bulk grow is `max(2*cap, len+n)` and the loop's
// is per-element doubling, so these columns are where that policy is pinned.

fn mk(n: int): string {
  let out: []byte = []
  let i = 0
  while (i < n) {
    out = append(out, byte(65 + i % 26))
    i = i + 1
  }
  return string(out)
}

// The pre-#4371 spelling, kept as the oracle. Takes the destination's KIND
// rather than the destination itself so the growth it drives is unambiguously
// its own (E0214, spec/LINT.md): a `[]byte` parameter appended to inside a
// function is exactly the aliasing shape that lint reports, and silencing it
// here would be silencing the rule this fixture's sibling
// (run_append_str_alias.bit) exists to check.
fn perByte(kind: int, s: string): []byte {
  let out = dest(kind)
  let i = 0
  while (i < len(s)) {
    out = append(out, s[i])
    i = i + 1
  }
  return out
}

// 0 = null header, 1 = real header cap 0, 2 = three bytes with spare capacity,
// 3 = three bytes exactly full.
fn dest(kind: int): []byte {
  if (kind == 0) {
    let n: []byte = []
    return n
  }
  if (kind == 1) {
    return []byte(0, 0)
  }
  let room = 3
  if (kind == 2) {
    room = 64
  }
  let d = []byte(3, room)
  d[0] = byte(120)
  d[1] = byte(121)
  d[2] = byte(122)
  return d
}

fn row(name: string, n: int, s: string, kind: int) {
  let a = append(dest(kind), s)
  let b = perByte(kind, s)
  let want = string(dest(kind)) + s
  print("${name} n=${n} eq=${string(a) == string(b)} want=${string(a) == want} len=${len(a)}/${len(b)} cap=${cap(a)}/${cap(b)}\n")
}

fn main() {
  let lens = [0, 1, 15, 16, 17, 4096]
  let names = ["null", "cap0", "spare", "full"]
  let li = 0
  while (li < len(lens)) {
    let n = lens[li]
    let s = mk(n)
    let k = 0
    while (k < len(names)) {
      row(names[k], n, s, k)
      k = k + 1
    }
    li = li + 1
  }

  // Several strings in one call, and a call that MIXES the two operand shapes
  // — the choice is per argument, not per call.
  let m = append(dest(2), "one", "two", "three")
  print("multi=${string(m)} len=${len(m)}\n")
  let x = append(dest(1), byte(65), "BCD", byte(69))
  print("mixed=${string(x)} len=${len(x)}\n")

  // A `[]string` destination keeps the ELEMENT shape: its element type IS
  // `string`, so this stays the one-word append it always was.
  let e: []string = []
  e = append(e, "alpha", "beta")
  print("elems=${e[0]}/${e[1]} len=${len(e)}\n")
}
