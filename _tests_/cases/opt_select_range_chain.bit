// run
// #7761: optselect.bit's rangeAt fuses an `if`'s chained `c >= lo && c <= hi`
// (one `br` per operand) into `(c - lo) <=u (hi - lo)`, right only because the
// unsigned `c - lo` wraps below `lo`. Every u8 is tested against the value of
// the plain compares, which `want` computes without an `if` chain; so is each
// wider type at the edges of its range and of the type. `outside` is the
// `c < lo || c > hi` mirror, `acc` reaches its join with a reassigned local on
// both edges, `nested` puts the range inside a longer chain, and `empty`
// (`lo > hi`) must stay false. The IR half is ir_if_range_chain.bit.

fn digit(c: u8): int {
  if (c >= '0' && c <= '9') {
    return int(c - '0')
  }
  return -1
}

fn outside(c: u8): bool {
  if (c < 'a' || c > 'f') {
    return true
  }
  return false
}

fn acc(c: u8, n: int): int {
  let t = n
  if (c >= 'A' && c <= 'Z') {
    t = t + 1
  }
  return t
}

fn nested(c: u8, on: bool): bool {
  if ((on && c >= 'a' && c <= 'z') || c == '_') {
    return true
  }
  return false
}

fn empty(c: u8): bool {
  if (c >= 200 && c <= 100) {
    return true
  }
  return false
}

fn top(c: u8): bool {
  if (c >= 250 && c <= 255) {
    return true
  }
  return false
}

fn w16(x: u16): bool {
  if (x >= 1000 && x <= 65535) {
    return true
  }
  return false
}

fn w32(x: u32): bool {
  if (x >= 7 && x <= 4000000000) {
    return true
  }
  return false
}

fn w64(x: u64): bool {
  if (x >= 10 && x <= 20) {
    return true
  }
  return false
}

// Whether every u8 helper agrees with the plain compares at `k`.
fn agrees(k: int): bool {
  let c = u8(k)
  let want = -1
  let isDigit = k >= 48 && k <= 57
  if (isDigit) {
    want = k - 48
  }
  let ok = digit(c) == want
  ok = ok && outside(c) == !(k >= 97 && k <= 102)
  let up = k >= 65 && k <= 90
  let wantAcc = 5
  if (up) {
    wantAcc = 6
  }
  ok = ok && acc(c, 5) == wantAcc
  let low = k >= 97 && k <= 122
  ok = ok && nested(c, true) == (low || k == 95)
  ok = ok && nested(c, false) == (k == 95)
  ok = ok && !empty(c)
  return ok && top(c) == (k >= 250)
}

fn wide(): int {
  let bad = 0
  let xs16 = [u16(0), u16(999), u16(1000), u16(1001), u16(65534), u16(65535)]
  let want16 = [false, false, true, true, true, true]
  let i = 0
  while (i < len(xs16)) {
    if (w16(xs16[i]) != want16[i]) {
      bad = bad + 1
    }
    i = i + 1
  }
  let xs32 = [u32(0), u32(6), u32(7), u32(4000000000), u32(4000000001), u32(4294967295)]
  let want32 = [false, false, true, true, false, false]
  i = 0
  while (i < len(xs32)) {
    if (w32(xs32[i]) != want32[i]) {
      bad = bad + 1
    }
    i = i + 1
  }
  let xs64 = [u64(0), u64(9), u64(10), u64(20), u64(21), u64(18446744073709551615)]
  let want64 = [false, false, true, true, false, false]
  i = 0
  while (i < len(xs64)) {
    if (w64(xs64[i]) != want64[i]) {
      bad = bad + 1
    }
    i = i + 1
  }
  return bad
}

fn main() {
  let bad = 0
  let k = 0
  while (k < 256) {
    if (!agrees(k)) {
      println("mismatch at ${k}")
      bad = bad + 1
    }
    k = k + 1
  }
  println("bad=${bad} wide=${wide()}")
}
