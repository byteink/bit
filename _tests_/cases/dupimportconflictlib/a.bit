// #6326's sibling module: `a.bit` and `b.bit` both bind the local name
// `trimSpace`, but from two DIFFERENT source modules — the #6326
// identical-import exemption (same source module, same imported name, same
// local name) does not apply, so this pair must still fail with E0042,
// naming both files.
import { trimSpace } from "std/strings"

export fn conflictProbe(): string {
  return trimSpace("probe")
}
