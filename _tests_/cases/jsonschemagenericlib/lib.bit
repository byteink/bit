// #6205: library module for the jsonSchema<T> generic-forwarding golden
// fixtures (#6201/#6202/#6203/#6204). Neither `wrap<T>()` nor
// `Box.describe<T>()` imports a concrete @json class -- the whole point of
// generic forwarding is that the module declaring the wrapper never needs to
// know the caller's type, and the retarget (classjsonschemagenericretarget.bit)
// synthesizes the per-instantiation specialisation in the CONCRETE type's own
// module, not this one.
import { Json, jsonSchema } from "std/json"

// A generic FREE FUNCTION, the shape a plain helper library exports.
export fn wrap<T>(): Json {
  return jsonSchema<T>()
}

export class Box {
  export tag: string

  // A generic METHOD, matching pkg/web's `Route.requestBody<T>()` shape
  // (#6200): a method on a class declared here, instantiated by a caller in
  // a different module against a @json class this module never sees.
  export describe<T>(): Json {
    return jsonSchema<T>()
  }
}
