// lint exit=0
// #5077 E0217 `tx-captured-executor`: `limit` is captured from the
// enclosing scope and used inside the block too, but it is not the value
// `pool.tx(...)` opened the transaction on -- an unrelated `int`, read-only,
// never a write that could escape it. Only the tx call's own `db` argument
// (`pool`) is ever tracked, so this produces no finding.
import { Pool } from "std/sql"

class Entity { id: int }

fn transferUpTo(pool: Pool, a: Entity, b: Entity, limit: int): ()! {
  pool.tx((t) => {
    print("limit is ${limit}\n")
    t.save(a)?
    t.save(b)?
  })?
}
