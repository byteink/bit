// run
// #4105: `(a, b, ...)` is now a real tuple literal expression (SPEC §12.10),
// matching the tuple TYPE `(T1, T2)` (§11) and the destructuring PATTERN
// `(a, b)` (§10.1) that already existed — the missing third spelling of one
// representation. Each print pins one acceptance point directly:
//
//   scalar     `let t = ("x", 1)` infers `(string, i64)`; `t.0`/`t.1` read it
//   destruct   `let (a, b) = ("x", 1)` binds both through the literal
//   forRound   a slice of tuples `[("x", 1), ("y", 2)]` round-trips through
//              `for`, each element read back by `.0`/`.1`
//   paren      `(2 + 3) * 2` stays a parenthesized expression, never a
//              1-tuple — `tuple_type`/`tuple_pat` both require two or more
//              elements (SPEC :949) and so does `tuple_lit`; a wrongly-built
//              1-tuple could not be multiplied by `int` here at all. The
//              grouping parens are precedence-load-bearing (`bit fmt` would
//              drop a merely redundant `(5)`), which is what keeps this
//              case's own SOURCE canonical rather than reformatted away.
//   pairBare   `return 1, true` (SPEC §13.1's original, no-parens spelling)
//              still builds a tuple result — unaffected by this ticket
//   pairParen  `return (1, true)` — the SAME result via the new literal
//              spelling, migrated from the retired check_tuple_literal_expr
//              checkercase (#2176), where both this and `letParen` below used
//              to be E0094 "tuples have no literal form"
//   letParen   `let t = (1, true)` — the retired fixture's other site
//   argTuple   a tuple literal followed by a comma in an argument list stays
//              bounded by ITS OWN closing paren, not the call's: `addPair((1,
//              2), 3)` is a 2-argument call whose first argument is a
//              2-tuple, never a 3-argument call — the grammar ambiguity a
//              parenthesized value must not create in either direction
//   narrow     an untyped element widens to a DECLARED, narrower element type
//              instead of the literal's own bare default: `(7, "z")` against
//              `(i32, string)` stores an i32, not the i64 `7` alone defaults to

fn pairBare(): (int, bool) {
  return 1, true
}

fn pairParen(): (int, bool) {
  return (1, true)
}

fn letParen(): (int, bool) {
  let t = (1, true)
  return t
}

fn addPair(p: (int, int), extra: int): int {
  return p.0 + p.1 + extra
}

fn main() {
  let t = ("x", 1)
  print("scalar ${t.0} ${t.1}\n")

  let (a, b) = ("x", 1)
  print("destruct ${a} ${b}\n")

  let xs = [("x", 1), ("y", 2)]
  for pair of xs {
    print("forRound ${pair.0}=${pair.1}\n")
  }

  let paren = (2 + 3) * 2
  print("paren ${paren}\n")

  let (pb0, pb1) = pairBare()
  print("pairBare ${pb0} ${pb1}\n")

  let (pp0, pp1) = pairParen()
  print("pairParen ${pp0} ${pp1}\n")

  let (lp0, lp1) = letParen()
  print("letParen ${lp0} ${lp1}\n")

  print("argTuple ${addPair((1, 2), 3)}\n")

  let narrow: (i32, string) = (7, "z")
  print("narrow ${narrow.0} ${narrow.1}\n")
}
