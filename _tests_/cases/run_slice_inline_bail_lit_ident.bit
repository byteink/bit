// run
// #3933: a slice literal item that is a bare Ident — not a fresh
// Tag.CompositeLit of elemTy — disqualifies elemTy from the inline
// representation for the WHOLE module, the same rule append(xs, ...)'s
// trailing arguments already enforce (#3862's scanAppendArgs). Before the
// fix `[n]` panicked outright: storePackedCompositeLit (lowerlit.bit)
// indexed kidsOf(litNode)[1] off the end of an Ident's (empty) kid list.
// This also proves the boxed bail-out is actually taken, not merely that
// the program no longer panics: `n` aliases `xs[0]`, so writing through `n`
// must be observed through `xs[0]` too, which is impossible under the
// packed representation.
class Node { x: i64, y: i64 }

fn main() {
  let n = Node{ x: 1, y: 2 }
  let xs = [n]
  print("${len(xs)}\n")
  n.x = 999
  print("${xs[0].x} ${xs[0].y}\n")
}
