// run
// stdlib/json/cst_parse.bit's error-position tracking (#3074, mirroring
// #2286's fix to stdlib/json/parse.bit): every `cstParse` error carries its
// byte offset and 1-based line:column, not just a bare category string. This
// is a second, independent JSONC parser (the trivia-carrying CST used by the
// edit layer) with its own ten `fail` sites, none of which shared #2286's
// `posError`/`jsonLocate` helper before this fix -- reused here from
// stdlib/json/parse.bit rather than redeclared, since stdlib/json/*.bit is
// one module. A golden case can import std/json (#2421: `checkRun` runs
// `bit build` with `BIT_STDLIB` exported), so this exercises the real module
// rather than a redeclared local copy.
//
// Four distinct malformed shapes:
//   - a bad token mid-object (a missing comma between two entries) --
//     pinned as the "middle of input" case
//   - an unterminated object (the error is at EOF -- the position just past
//     the last byte, not an out-of-range value or a silent zero) -- pinned
//     as the "end of input" case
//   - an invalid number literal mid-array
//   - trailing garbage after an otherwise-valid document
import { cstParse } from "std/json"

fn msg(src: string): string {
  let v = cstParse(src) catch e { return e.message() }
  return "no error"
}

fn main() {
  print("bad_token=" + msg("{\"a\":1 \"b\":2}") + "\n")
  print("unterminated=" + msg("{\"a\":1") + "\n")
  print("invalid_number=" + msg("[01]") + "\n")
  print("trailing_garbage=" + msg("{\"a\":1}x") + "\n")
  print("done\n")
}
