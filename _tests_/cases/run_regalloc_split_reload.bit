// run
// #7665: more values are live across the call to `fib` than there are
// callee-saved registers, so some go to the stack, and the loop after the
// call reads them often enough that the allocator moves them back into a
// register on the one edge into it. Dropping that edge move leaves the
// register stale and the sums below wrong. `spread` spills on arm64 (ten
// callee-saved registers); `narrow` spills on x86-64 (five) and, with no
// division to hold rax and rdx, leaves it registers free after the call.
// Both loops reload through the header's block-parameter moves; `branchy`
// reloads through a split move alone, on both arches.

fn fib(n: int): int {
  if (n < 2) {
    return n
  }
  return fib(n - 1) + fib(n - 2)
}

fn spread(n: int, k: int): int {
  let a = n * 3 + 1
  let b = n * 5 + 2
  let c = n * 7 + 3
  let d = n * 11 + 4
  let e = n * 13 + 5
  let g = n * 17 + 6
  let h = n * 19 + 7
  let j = n * 23 + 8
  let l = n * 29 + 9
  let m = n * 31 + 10
  let o = n * 37 + 11
  let p = n * 41 + 12
  let q = n * 43 + 13
  let r = n * 47 + 14
  let f = fib(k)
  let s = 0
  let i = 0
  while (i < n) {
    if (i % 3 == 0) {
      s = s + a * i + c - e + g
    } else {
      s = s + b - i + d + h - j
    }
    s = s + l * 2 + m - o + p + q - r + i * a - b
    i = i + 1
  }
  return s + f + a + b + c + d + e + g + h + j + l + m + o + p + q + r
}

fn narrow(n: int, k: int): int {
  let a = n * 3 + 1
  let b = n * 5 + 2
  let c = n * 7 + 3
  let d = n * 11 + 4
  let e = n * 13 + 5
  let g = n * 17 + 6
  let h = n * 19 + 7
  let f = fib(k)
  let s = 0
  let i = 0
  while (i < n) {
    if (i + i > n) {
      s = s + a * i + c - e
    } else {
      s = s + b - i + d
    }
    s = s + g * 2 - h + i * a - b
    i = i + 1
  }
  return s + f + a + b + c + d + e + g + h
}

// No loop and no block param here: the reload rides the branch edge itself,
// as a split move alone, so a dropped split move is all that can break it.
fn branchy(n: int, k: int): int {
  let a = n * 3 + 1
  let b = n * 5 + 2
  let c = n * 7 + 3
  let d = n * 11 + 4
  let e = n * 13 + 5
  let g = n * 17 + 6
  let h = n * 19 + 7
  let j = n * 23 + 8
  let l = n * 29 + 9
  let m = n * 31 + 10
  let o = n * 37 + 11
  let p = n * 41 + 12
  let q = n * 43 + 13
  let r = n * 47 + 14
  let f = fib(k)
  if (f > 1) {
    let t = a + b + c + d + e + g + h + j + l + m + o + p + q + r
    return t * 2 + a - b + c - d + e - g + h - j + l - m + o - p + q - r + f
  }
  return f
}

fn main() {
  println("${spread(10, 12)}")
  println("${spread(7, 9)}")
  println("${spread(1, 1)}")
  println("${narrow(10, 12)}")
  println("${narrow(7, 9)}")
  println("${narrow(1, 1)}")
  println("${branchy(10, 12)}")
  println("${branchy(3, 5)}")
  println("${branchy(4, 1)}")
}
