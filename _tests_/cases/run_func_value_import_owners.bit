// run
// #7919: two modules own same-named functions. Returned values must use
// their declaration owner; a name-only trampoline cache returns the left
// function for both. The aliased values also keep their original symbols.
import { pick as left, value as leftValue } from "./funcvalueownerleft"
import { pick as right, value as rightValue } from "./funcvalueownerright"

fn main() {
  let a = left
  let b = right
  let c = leftValue()
  let d = rightValue()
  println("${a(1)} ${b(1)} ${c(1)} ${d(1)}")
}
