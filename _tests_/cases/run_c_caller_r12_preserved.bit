// run
// #6198: r12 is callee-saved under SysV and Win64, so a C caller that holds a
// value in r12 across a call into Bit code expects it back. The x86_64 backend
// used r12 as a never-saved codegen scratch (`xScratch3`, the f64 rounding
// expansion among others), so `viaC` below returned the rounding constants'
// bits instead of the sentinel. Now a function that needs that scratch
// reserves r12 and saves it in its prologue, like any callee-saved register.
//
// `viaC` is the C caller: an `asm` call with the C clobber set (the
// `parkVdsoCall` shape, runtime/park/linux/vdso.bit) that parks the sentinel
// in r12 before the call and reads it back after. The arm64 half only keeps
// the output identical: it parks the sentinel on the stack, since an `asm`
// clobber of a callee-saved arm64 register is not saved there yet.
fn rounded(): int {
  let x = f64(counter) / 4.0
  counter = counter + 1
  return int(ffloor(x)) + int(fceil(x)) + int(fround(x)) + int(ftrunc(-x))
}

let counter = 9

fn viaC(fnp: *byte, sentinel: int): int {
  return asm {
    arm64 {
      0xF81F0FE1, // str x1, [sp, #-16]!
      0xD63F0120, // blr x9
      0xF84107E0, // ldr x0, [sp], #16
    }
    x64 {
      0x49, 0x89, 0xF4, // mov r12, rsi
      0xFF, 0xD0,       // call rax
      0x4C, 0x89, 0xE0, // mov rax, r12
    }
    result arm64 x0 x64 rax : int
    input arm64 x9 x64 rax = int(fnp)
    input arm64 x1 x64 rsi = sentinel
    clobber arm64 {
      x2,
      x3,
      x4,
      x5,
      x6,
      x7,
      x8,
      x10,
      x11,
      x12,
      x13,
      x14,
      x15,
      x16,
      x17,
      x30,
      memory,
    }
    clobber x64 { rcx, rdx, rdi, r8, r9, r10, r11, r12, memory }
  }
}

fn main() {
  print("${viaC(entryOf(rounded), 0x5EED6198)}\n")
  print("${counter} ${rounded()}\n")
}
