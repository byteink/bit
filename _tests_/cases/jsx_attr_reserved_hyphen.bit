// run
// #5155: JSXIdentifier permits reserved words and the hyphen inside a
// tag's name/attribute position (SPEC §12.12) - `class`, `for` and `type`
// are Bit keywords, and `data-id`/`aria-label` are ordinary hyphenated HTML
// attributes. Rendered through the REAL pkg/web, not a local stand-in
// (#5154's own lesson): a parse-tree check cannot see a keyword token
// reach `attr()` as the wrong string.
import { Node, render, elem, attr, frag, text } from "../../pkg/web"

fn main() {
  let page = <div
    class="card"
    data-id="42"
    aria-label="widget"
    type="button"
    for="field"
    id="x"
  >hi</div>
  println(render(page))
}
