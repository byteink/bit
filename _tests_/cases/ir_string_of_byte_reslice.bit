// ir
// #6558: `string(b[lo:hi])` on a byte slice is ONE
// `rt_call string_from_byte_range(b, lo, hi)`. Before, it was
// `rt_call slice_slice(b, lo, hi)` — a 40-byte view header that died at
// once — feeding `rt_call string_from_bytes`. The value, the bounds and the
// panic text are pinned by run_string_of_byte_reslice*.bit.

fn f(b: []byte, lo: int, hi: int): string {
  return string(b[lo:hi])
}
