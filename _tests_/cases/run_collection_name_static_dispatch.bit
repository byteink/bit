// run
// SPEC §10.5, #6254, data-packages-dx.md rule 3: every `@json`
// class gets a synthesized `static __collectionName(): string` -- snake_case
// of the class name by default (`OrderLine -> order_line`), or
// `@collection("...")`'s own argument when the class carries one. `name<T:
// Named>()` below is exactly the ticket's own acceptance: a generic function
// reads each of two distinct `@json` classes' collection names off a type
// parameter alone, through `T.__collectionName()`, never through a value of
// type `T` -- the same zero-instance dispatch shape `@job`'s `__jobName`
// takes (run_job_name_static_dispatch.bit).

interface Named {
  static __collectionName(): string,
}

@json class OrderLine {
  productId: i64,
}

@json @collection("sessions") class Session {
  userId: i64,
}

fn name<T: Named>(): string {
  return T.__collectionName()
}

fn main() {
  print("${name<OrderLine>()}\n")
  print("${name<Session>()}\n")
}
