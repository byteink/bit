// error
// #4270: SPEC §10.3.1's fixed-array-index carve-out (#4194) narrowed to
// PROVABLY-in-range indices once index_get grew a real bounds check — a
// bare variable index is no longer admitted, for the identical reason a
// slice index already was not (vNosplitWalk, validateattr.bit): the
// out-of-range edge now calls `bit_rt_panic`, and @nosplit judges a
// construct by every edge it can take. Mirrors check_nosplit_index.bit's
// slice case one type over. run_nosplit_const_array_read.bit's
// `TAB[i & 3]` — MASKED into range — stays admitted; this is the negative
// space around it.
const TAB: [4]u64 = [4]u64{ 11, 22, 33, 44 }

@nosplit fn pick(i: int): u64 {
  return TAB[i]
}

fn main() {
  print("${pick(0)}\n")
}
