// run
// A `bool` returned from a runtime call must be a full-width 0/1.
//
// The C ABI returns a bool in `al`/`w0` and leaves the rest of the return
// register unspecified, so whether a callee happens to zero it is luck:
// `bit_rt_string_eq` did, `bit_rt_fs_exists` did not, and on x86-64
// `!fsExists(missing)` evaluated to *false* while `fsExists(missing)` printed
// `false`. Codegen now normalizes at the call boundary. Negation and branching
// are what expose it — printing the value alone does not.
fn main() {
  let missing = "/tmp/bit-no-such-path-regression-guard"
  let a = "abc"
  let b = "abd"

  print("exists=${fsExists(missing)} negated=${!fsExists(missing)}\n")
  if (!fsExists(missing)) {
    print("branch=absent\n")
  } else {
    print("branch=present\n")
  }
  print("isdir=${fsIsDir(missing)} negated=${!fsIsDir(missing)}\n")
  print("eq=${a == b} neq=${a != b} negated=${!(a == b)}\n")
}
