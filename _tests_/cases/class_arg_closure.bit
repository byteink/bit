// types
// #7005: a class argument inside a closure body infers `T` the same way, and the
// literal is still checked against the class named.
import { Class, Where } from "std/where"

class Article {
  id: i64,
  authorId: i64,
}

class User {
  id: i64,
}

class Policy {
  can<T>(action: string, res: Class<T>, where: Where<T>): bool {
    return true
  }
}

fn check(f: (Policy, User) => bool): bool {
  return f(Policy{}, User{ id = 1 })
}

fn main() {
  let ok = check((p, user) => p.can("read", Article, { authorId: user.id }))
}
