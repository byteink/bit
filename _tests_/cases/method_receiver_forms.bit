// run
// #2239: negative control for #2238's new checker rejection (a method
// receiver must be a class, SPEC §10.4 post-#3762 — the receiver form and its
// type-alias-receiver spelling are gone). #2736 rejects an enum receiver;
// #2738's type-alias-to-enum rejection is now unreachable (there is no
// syntax left to attempt it, see check_method_enum_alias_receiver.bit).
// What still typechecks, lowers and runs: a class method called directly,
// and the same method called through a transparent type alias to that class
// (SPEC §14.1) — `doubled` is declared once, on `Cart`, and both `c` and
// `b: Basket` can call it.
class Cart {
  n: int

  size(): int {
    return this.n
  }

  doubled(): int {
    return this.n * 2
  }
}

type Basket = Cart

fn main() {
  let c = Cart{ n: 3 }
  print("${c.size()}\n")

  let b: Basket = Cart{ n: 5 }
  print("${b.doubled()}\n")
}
