// types
// #6993: a bare `{ field: value }` literal whose expected type is `Where<T>` is a
// condition on `T`: its keys are field names, not variables. Plain equality
// entries, the empty filter, an untyped constant against a sized field, an enum
// field and a relation field (a class-typed one) all check clean.
import { Where } from "std/where"

enum Status { Draft, Published }

class User {
  id: i64,
}

class Article {
  id: i64,
  authorId: i64,
  status: string,
  score: i32,
  state: Status,
  author: User,
}

fn main() {
  let u = User{ id = 1 }
  let mine: Where<Article> = { authorId: 7, status: "published" }
  let empty: Where<Article> = {}
  let scored: Where<Article> = { score: 3 }
  let live: Where<Article> = { state: Status.Published, author: u }
}
