// fmt
// #3718: the `@threadlocal` storage-class attribute (§11.11) rides in the
// LetDecl node's `main` field, not a child, so a printer that only prints
// the child list silently drops it. Pin the attribute survives a reformat
// that also normalizes unrelated spacing on the same line.
@threadlocal let  counter: int = 0

fn increment() {
  counter = counter + 1
}
