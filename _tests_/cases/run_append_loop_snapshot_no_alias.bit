// run
// #6092 follow-up (coordinator review of the single-use compiler fast path,
// compiler/optappend.bit): a REJECTED stronger draft of `appendExpandable`
// treated a loop accumulator's header (`while (cond) { xs = append(xs, v) }`)
// as safe to mutate in place whenever its only OTHER textual use was the
// loop's own exit branch — true per call site, but the loop body is ONE
// static call site executed once per iteration, and the fast path returns
// the SAME physical header every time. A binding that snapshots the
// accumulator mid-loop (`snap = base` below) then keeps aliasing whatever
// object the loop goes on to mutate on every later iteration, silently
// growing `snap` along with `base` — the exact hazard #6092 fixed, reopened
// through the loop instead of through two `let`s. This case is the reduction
// that caught it in review before it shipped: `snap` must freeze at the
// length `base` had when `snap = base` ran (5), never see `base`'s later
// growth to 10.
fn main() {
  let acc = []int(0, 10)
  let i = 0
  while (i < 10) {
    acc = append(acc, i)
    i = i + 1
  }
  print("loop: len=${len(acc)} last=${acc[9]}\n")

  let base = []int(0, 10)
  let snap: []int = []
  let k = 0
  while (k < 10) {
    base = append(base, k)
    if (k == 4) {
      snap = base
    }
    k = k + 1
  }
  print("snap: baselen=${len(base)} snaplen=${len(snap)} snaplast=${snap[len(snap) - 1]}\n")
}
