// panic
// #3982: scale alignment (`emitDecimalScaleUp`, lowerdecimalarith.bit) checks
// the mantissa's fit EVERY loop iteration, not just at the end — `hi32*10`
// alone can exceed 2^32 well inside the 28-iteration bound, so a check placed
// only after the loop would already be reading a value that wrapped past
// i64. `big` is an 18-digit mantissa at scale 0 (well within a `decimal`'s
// own 96-bit range on its own); `tiny` is scale 12. Aligning them scales
// `big`'s mantissa up by 12 decimal places -- roughly 10^30, past the 96-bit
// range (~7.9x10^28) -- so this must panic rather than silently wrap into a
// truncated, wrong sum.
fn main() {
  let big: decimal = 999999999999999999
  let tiny: decimal = 0.000000000001
  print("start\n")
  print("sum=${big + tiny}\n")
  print("unreachable\n")
}
