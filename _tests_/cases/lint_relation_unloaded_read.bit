// lint exit=1
// #5247 E0218 `relation-unloaded-read`: `orders` carries `@hasMany`
// (compiler/classrelationattr.bit's compiler-known relation mark). `u` is
// bound straight from `find<User>(...)` (pkg/orm's real chain builder,
// #5061, merged 6f676e37) terminated by `.oneOrFail()`, with no
// `.with("orders")` link anywhere in the chain -- the read happens in the
// SAME function, the one shape this rule can see without a resolver that
// carries no type information (this file's own header,
// compiler/lintrelation.bit).
import { Data, find } from "orm"
import { FieldDesc, Rows } from "std/sql"

class Order {
  id: i64,
}

@table class User {
  @id
  id: i64
  @hasMany("userId")
  orders: []Order
}

fn userMapper(rows: Rows): User! {
  return User{ id: 1 } // `orders` left unset on purpose, pkg/orm/docs/relation.md
}

fn report(db: Data, id: i64): ()! {
  let u = find<User>(db, "users", []FieldDesc(0), userMapper).oneOrFail()?
  print("${len(u.orders)}\n")
}
