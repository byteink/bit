// lint exit=1
// #5247 E0218 `relation-unloaded-read`: `orders` carries `@hasMany`
// (compiler/classrelationattr.bit's compiler-known relation mark), `u` is
// bound straight from `findOneOrFail<User>(...)` with no `.with("orders")`
// anywhere in that chain, and the read happens in the SAME function -- the
// one shape this rule can see without a resolver that carries no type
// information (this file's own header, compiler/lintrelation.bit).
import { Executor, findOneOrFail } from "std/sql"

class Order {
  id: i64,
}

@table class User {
  @id
  id: i64
  @hasMany("userId")
  orders: []Order
}

fn report(db: Executor, id: i64): ()! {
  let u = findOneOrFail<User>(db, "select * from users where id = $1", id)?
  print("${len(u.orders)}\n")
}
