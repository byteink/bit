// run
// #4560's other half, and the control that keeps its E0068 from over-firing:
// every way a payload-less variant argument DOES bind a generic's type
// parameter must still build and run. `check_generic_uninferable_type_param
// .bit` holds the one shape that binds nothing.
//
// Five ways, and each is a different mechanism:
//   explicit type arguments  `viaFree<Tag>(Option.None)`   — SPEC §12.7
//   an annotated local       `let empty: Option<Tag>`      — the target type
//   a turbofish receiver     `Option<Tag>.None`            — `enumTurbofish`
//   a sibling argument       `withBinder(Tag{}, ...)`      — `T` from param 0
//   a payload                `Option.Some(Tag{})`          — from the argument
//
// `viaUser` is the same file's proof that none of this is an Option rule: a
// user-declared generic enum's payload-less variant behaves identically, both
// in the refusal and in the escape hatch.
interface Named {
  label(): string,
}

class Tag {
  export label(): string {
    return "tag"
  }
}

enum MyOpt<E> {
  Nothing,
  Just(E),
}

fn viaFree<T: Named>(q: Option<T>): string {
  match (q) {
    Some(t) => return t.label()
    None => return "none"
  }
}

fn withBinder<T: Named>(a: T, q: Option<T>): string {
  match (q) {
    Some(t) => return t.label() + a.label()
    None => return "none-" + a.label()
  }
}

fn viaUser<T: Named>(q: MyOpt<T>): string {
  match (q) {
    Just(t) => return t.label()
    Nothing => return "nothing"
  }
}

fn main() {
  print(viaFree(Option.Some(Tag{})) + "\n")
  print(viaFree<Tag>(Option.None) + "\n")
  let empty: Option<Tag> = Option.None
  print(viaFree(empty) + "\n")
  print(viaFree(Option<Tag>.None) + "\n")
  print(withBinder(Tag{}, Option.None) + "\n")
  print(withBinder(Tag{}, Option.Some(Tag{})) + "\n")
  print(viaUser(MyOpt.Just(Tag{})) + "\n")
  print(viaUser<Tag>(MyOpt.Nothing) + "\n")
}
