// run
// #4421: a `make_closure` standing between an aggregate's construction and its
// explosion at a call site. `make_closure` was a FULL store-table barrier, so
// the earlier aggregate lost every forwarded slot and stayed a live `gc_alloc`
// — the exact shape #4413 fixed for `gc_alloc` and left standing here.
//
// It allocates the {code, env} cell and writes that cell's two words, and
// nothing else: its `lhs` is READ (compiler/opt.bit:337 files it with
// `field_get` as a pure `[ins.lhs]` reader), so it cannot write through any
// base the table tracks. That makes it a partial barrier like `gc_alloc`.
//
// A BEHAVIOUR oracle, not an IR assertion: `.expected` was generated by the
// compiler as it stood BEFORE the change, so it says what these programs must
// print. The IR counts are pinned by compiler/optcheck.bit's selfcheck arms.
//
// Five shapes, because the change draws a line and both sides of it matter.

// 1. THE WIN. `a` is built, a closure is built, `b` is built, and `a` is
// exploded back into words at the call — so the `make_closure` sits between
// `a`'s stores and `a`'s loads.
fn sink(a: (i64, i64), g: () => i64, b: (i64, i64)): i64 {
  return a.0 * 1 + a.1 * 2 + b.0 * 3 + b.1 * 4 + g()
}

fn scalars(n: i64): i64 {
  return sink((n, n + 1), () => n * 2, (n + 2, n + 3))
}

// 2. The same shape with POINTER fields, so the values forwarded across the
// `make_closure`'s safepoint are live GC references and have to be described by
// the stack map at that point.
fn sinkr(a: (string, string), g: () => string, b: (string, string)): string {
  return a.0 + a.1 + b.0 + b.1 + g()
}

fn refs(p: string, q: string): string {
  return sinkr((p, q), () => "!", (q, p))
}

class Cell {
  n: i64

  get(): i64 {
    return this.n
  }
}

// 3. A `make_closure` whose ENVIRONMENT IS a base the table is tracking:
// `p.get` binds the receiver itself as the env (compiler/lowerfuncval.bit:430).
// That is the shape the demotion had to be checked against — the cell records
// the pointer, it does not write through it — so the later store through `p`
// still wins and `p.n` must read 20, not 1.
fn bump(c: Cell): i64 {
  c.n = 20
  return 0
}

fn bound(p: Cell): i64 {
  p.n = 1
  let g = p.get
  let z = bump(p)
  return p.n + z + g()
}

// 4. TWO BASES THE PASS CANNOT TELL APART, with a capture-free closure between
// them: a nil environment means there is no `gc_alloc` in front, so the
// `make_closure` is the only allocation in the block. `main` passes the same
// object twice, so the write through `q` must be observed and `p.n` reads 5.
// A table that treats any base as distinct answers 3 here — not a slower
// program, a wrong one.
fn shadow(p: Cell, q: Cell): i64 {
  p.n = 3
  let g = () => 7
  q.n = 5
  return p.n + g()
}

// 5. A REAL CALL is still a FULL barrier, and this is the arm that says so.
// `a` is an allocation this function made, so its entry `a[0] = 1` is exactly
// the kind the closure's partial barrier KEEPS — and the call then writes that
// slot through a parameter. `mutate` carries a loop so the inliner leaves the
// call standing in the same block as the store and the load, which is what
// makes the barrier decision reachable at all: `a.n` must read 21, not 1.
fn mutate(c: Cell, k: i64): i64 {
  let i = 0
  while (i < k) {
    c.n = c.n + 10
    i = i + 1
  }
  return 0
}

fn callBarrier(): i64 {
  let a = Cell{ n: 1 }
  let g = () => 7
  let z = mutate(a, 2)
  return a.n + z + g()
}

fn main() {
  let total = 0
  let i = 0
  while (i < 4) {
    total = total + scalars(i)
    i = i + 1
  }
  print("scalars ${total}\n")

  let j = 0
  while (j < 3) {
    print("refs ${refs("p${j}", "q${j}")}\n")
    j = j + 1
  }

  let one = Cell{ n: 0 }
  print("bound ${bound(one)}\n")
  print("cell ${one.n}\n")

  let two = Cell{ n: 0 }
  print("shadow ${shadow(two, two)}\n")
  let three = Cell{ n: 0 }
  let four = Cell{ n: 0 }
  print("distinct ${shadow(three, four)}\n")

  print("callBarrier ${callBarrier()}\n")
}
