// lint exit=1
// #6340: `defaultName` is referenced only in a class field's default value,
// which resolvebody.bit's `rResolveStructDecl` never walks — must NOT be flagged.
// `name` is imported and only spelled as a field's own NAME (a declaration,
// not a reference), so it must still be flagged: the negative control.
import { defaultName, name } from "./mod"

class X {
  name: string = defaultName
}

fn main() {}
