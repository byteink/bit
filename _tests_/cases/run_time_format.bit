// run
// #4080: `format(pattern)` with Unicode LDML date field symbols
// (docs/stdlib/time.md, "Formatting"), reached through the public
// `std/time` import surface rather than from inside the module --
// stdlib/time/ldmlfmt.test.bit already covers the token table from within,
// where the unexported fields are in scope, so this fixture is the check
// that ldmlfmt.bit's trait injection actually lands on the exported types a
// caller gets, and that a rejected pattern fails through the public API too.
//
// The value throughout is 2026-09-01T09:05:00+04:00, the example row of the
// token table in docs/stdlib/time.md. 2026-09-01 is a Tuesday, the day
// _tests_/cases/run_time_date_fields.bit already pins, and Asia/Dubai is
// +04:00 all year, which stdlib/time/zone.test.bit pins against this host's
// tzdata.
import { date, zone, Date, DateTime } from "std/time"

fn caseBuild(): DateTime! {
  let dubai = zone("Asia/Dubai")?
  return date(2026, 9, 1)?.atTime(9, 5, 0)?.inZone(dubai)
}

fn caseDateTime(): DateTime {
  return caseBuild() catch e {
    panic("building 2026-09-01T09:05:00+04:00 failed: ${e.message()}")
  }
}

// `t.format(pattern)`, or `"ERR:"` and the failure message. A rendering
// never starts with `ERR:`, so the expected file distinguishes the two
// outcomes without a second flag.
fn caseFormat(t: DateTime, pattern: string): string {
  return t.format(pattern) catch e {
    "ERR:" + e.message()
  }
}

// The same, on a `Date`, which carries no time of day and no zone.
fn caseFormatDate(d: Date, pattern: string): string {
  return d.format(pattern) catch e {
    "ERR:" + e.message()
  }
}

fn caseShow(label: string, rendered: string) {
  println(label + "=" + rendered)
}

fn main() {
  let t = caseDateTime()
  caseShow("iso", caseFormat(t, "yyyy-MM-dd HH:mm"))
  caseShow("long", caseFormat(t, "d MMMM yyyy"))
  caseShow("weekday", caseFormat(t, "EEEE"))
  caseShow("clock", caseFormat(t, "h:mm a"))
  caseShow("quarter", caseFormat(t, "Q"))
  caseShow("basicOffset", caseFormat(t, "Z"))
  caseShow("isoOffset", caseFormat(t, "X"))
  caseShow("zoneId", caseFormat(t, "V"))
  caseShow("quoted", caseFormat(t, "'at' HH:mm"))
  caseShow("monthShort", caseFormat(t, "MMM"))
  caseShow("monthFull", caseFormat(t, "MMMM"))
  caseShow("weekBasedYear", caseFormat(t, "YYYY-MM-dd"))
  caseShow("dayOfYear", caseFormat(t, "yyyy-DDD"))

  let d = t.date()
  caseShow("dateOnly", caseFormatDate(d, "EEEE, d MMMM yyyy"))
  caseShow("timeOnADate", caseFormatDate(d, "HH:mm"))
}
