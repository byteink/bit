// run
// #5324, SPEC §12.12: a `{expr}` JSX attribute value whose own type already
// IS `string` -- a variable (`aria-label={name}`) alongside an ordinary
// STRING_LIT value (`data-id="42"`) -- passes `attr`'s `(string, string)`
// signature unchanged. #5324's new note-on-mismatch check
// (`vNoteStringConversion`, compiler/validatecall.bit) must never fire on
// either, since neither is a mismatch.
fn elem(tag: string, ...kids: string): string {
  let s = "<" + tag + ">"
  for k of kids {
    s = s + k
  }
  return s + "</" + tag + ">"
}

fn attr(name: string, value: string): string {
  return " ${name}=\"${value}\""
}

fn main() {
  let name = "widget"
  print(
    <li
      aria-label={name}
      data-id="42"
    />,
  )
  print("\n")
}
