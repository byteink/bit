// run
// stdlib/json/parse.bit's `\uXXXX` decoder (`decodeUnicodeEscape`), exercised
// behaviourally: every UTF-8 width the decoder can emit, both ends of the
// surrogate-pair range, and all three of its `\u`-specific error messages
// with their byte positions.
//
// WHY THIS EXISTS (#3638). `decodeUnicodeEscape` used to hand its two results
// back through a small result class, which cost one heap allocation per `\u`
// escape in every parsed document; #3638 removed it by writing the decoded
// bytes straight into the caller's Builder (a class is a reference type) and
// returning only the scanner position. That rewrite moves both the emitted
// bytes and every reported error position, and NOTHING IN THE CORPUS COVERED
// EITHER: `json_parse_valid.bit` decodes one BMP escape and one surrogate
// pair and never checks a `\u` error at all, and `json_parse_errors.bit`
// covers `\x` (`invalid escape character`) but none of the three messages
// below. The `unpaired surrogate` / `invalid low surrogate` strings that do
// appear elsewhere in _tests_/cases/ belong to a LOCAL parser copy inside the
// jsonc fixtures and never reach this module.
//
// Positions are asserted, not just messages: a truncated `\u` is reported at
// the escape's own `\`, an unpaired HIGH surrogate at the position just past
// it, and a lone LOW surrogate back at the escape start — three different
// anchors that a refactor threading `i`/`escStart` can silently swap.
//
// Byte output is printed as hex, never as text, so the expectation is exact
// UTF-8 rather than whatever a terminal or a diff tool renders.
import { jsonParse, jsonAsString } from "std/json"
import { newBuilder } from "std/strings"

fn hex(s: string): string {
  let d = "0123456789abcdef"
  let b = newBuilder()
  let i = 0
  while (i < len(s)) {
    let c = int(s[i])
    b.writeByte(d[(c >> 4) & 15])
    b.writeByte(d[c & 15])
    i = i + 1
  }
  return b.toString()
}

fn show(tag: string, src: string) {
  let doc = jsonParse(src) catch e {
    print("${tag}: ERR ${e.message()}\n")
    return
  }
  match (jsonAsString(doc)) {
    Some(s) => print("${tag}: len=${len(s)} hex=${hex(s)}\n")
    None => print("${tag}: not-a-string\n")
  }
}

fn main() {
  // Every UTF-8 width, at both sides of each boundary.
  show("ascii", "\"\\u0041\"")
  show("nul", "\"\\u0000\"")
  show("u007f", "\"\\u007f\"")
  show("u0080", "\"\\u0080\"")
  show("u07ff", "\"\\u07ff\"")
  show("u0800", "\"\\u0800\"")
  show("uffff", "\"\\uffff\"")

  // Surrogate pairs: both ends of the astral range, and hex case-insensitivity.
  show("pairmin", "\"\\ud800\\udc00\"")
  show("pairmax", "\"\\udbff\\udfff\"")
  show("emojilower", "\"\\ud83d\\ude00\"")
  show("emojiupper", "\"\\uD83D\\uDE00\"")

  // A decoded byte that is itself a JSON metacharacter must not re-enter the
  // scanner: `\u005c` is a backslash, `\u0022` a quote.
  show("backslash", "\"\\u005c\"")
  show("quote", "\"\\u0022\"")

  // Escapes interleaved with plain runs and with the other RFC 8259 escapes,
  // which is the path where the scanner position matters most.
  show("mixed", "\"a\\u00e9b\\nc\\td\\u20ace\\ud83d\\ude00f\"")

  // All three `\u` error messages, each at its own anchor position.
  show("truncated", "\"\\u12\"")
  show("badhex", "\"\\u12g4\"")
  show("lonehigh", "\"\\ud83d\"")
  show("highthenplain", "\"\\ud83dx\"")
  show("highthenbmp", "\"\\ud83d\\u0041\"")
  show("highthenhigh", "\"\\ud83d\\ud83d\"")
  show("lonelow", "\"\\udc00\"")
  show("lowthenhigh", "\"\\udc00\\ud83d\"")
  print("done\n")
}
