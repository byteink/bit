// run
// #5264: return covariance one layer inside `!` (SPEC §14.2/§14.3) — the
// gap #5254's own acceptance missed. pkg/web's real `Handler` is
// `(Ctx) => Res!` (pkg/web/router.bit:32), so this mirrors that exact
// shape — `Ctx` in, `Res!` out — rather than a synthetic bare pair, and
// widens it to `(Ctx) => Reply!`. Proven at RUNTIME, not just `bit check`:
// the widened function is called, its fallible result is unwrapped, and
// the interface method invoked on it must run the concrete
// `Res.intoRes()`, not a stub — a green check alone is what let #5254's
// gap through once already.
interface Reply {
  intoRes(): int,
}

class Ctx {
  n: int,
}

class Res {
  code: int
  export intoRes(): int { return this.code }
}

type Wide = (Ctx) => Reply!

fn oldFallible(c: Ctx): Res! { return Res{ code = c.n } }

fn takesFallible(h: Wide): int {
  let r = h(Ctx{ n = 7 }) catch _ {
    panic("unreachable")
  }
  return r.intoRes()
}

fn main() {
  print("${takesFallible(oldFallible)}\n")
}
