// run
// #4442: a variadic `init` used to be checked as though its param list held
// exactly one fixed parameter (SPEC §10.4 admits a rest param in init's
// list the same as any other signature), so `vClassConstructCall` rejected
// every construction call whose arity was not exactly 1 with E0050 even
// though `init` was declared variadic. `vClassConstructCall` is now
// variadic-aware, mirroring vCallArity/vCallSpreadAt (validatecall.bit):
// arity 0, 1 and 2 below are all accepted, and a `...`-spread call is too.
class Foo {
  n: int
  init(...args: string) { this.n = len(args) }
}
fn main() {
  let a = Foo()
  print("a.n=${a.n}\n")
  let b = Foo("x")
  print("b.n=${b.n}\n")
  let c = Foo("x", "y")
  print("c.n=${c.n}\n")
  let xs = ["x", "y", "z"]
  let d = Foo(...xs)
  print("d.n=${d.n}\n")
}
