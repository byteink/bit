// lint exit=1
// the same call, assigned straight back to the parameter it grew — but
// `catchEdgeArgs` never hands `buf` back to ITS OWN caller (only its length,
// an int), so the growth is local and this is the exact aliasing bug the
// rule exists for (#3688). Compare lint_append_param_selfowned.bit, where
// returning `buf` itself is what makes the identical self-assignment safe.
fn catchEdgeArgs(buf: []byte): int {
  buf = append(buf, 1)
  return len(buf)
}
