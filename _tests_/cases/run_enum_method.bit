// run
// #5216 (owner ruling, SPEC §10.6/§14.7): an enum body may declare methods
// alongside its variants, `this` bound to the value exactly as a class
// body's own receiver is bound. A method may call another method on `this`,
// and because interfaces are satisfied structurally (§14.3), an enum with
// the right method satisfies an interface exactly as a class does — storing
// it behind an interface-typed parameter dispatches dynamically.
interface Sized {
  size(): int,
}

enum Shape {
  Dot
  Line(int)

  export size(): int {
    match (this) {
      Dot => return 1
      Line(n) => return n
    }
    return 0
  }

  export label(): string {
    return "size=${this.size()}"
  }
}

fn describe(s: Sized): int {
  return s.size()
}

fn main() {
  let s = Shape.Line(4)
  print("${s.size()}\n")
  print("${s.label()}\n")
  print("${describe(s)}\n")
}
