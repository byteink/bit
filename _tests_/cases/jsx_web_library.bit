// run
// #5154: JSX against the REAL `pkg/web` library, not a local stand-in.
// `jsx_desugar_page.bit` (#3944) proves the desugaring's SHAPE with its own
// `elem`/`attr`/`frag`/`text`; this proves the library epic #3942 was
// supposed to target actually exports those names and that a real `Node`
// tree renders through them: a lowercase element mixing an attribute and a
// text child, a fragment nested inside a fragment, and a component call.
import { Node, render, elem, attr, frag, text } from "../../pkg/web"

fn Row(name: string): Node {
  let item = <li>{text(name)}</li>
  return item
}

fn main() {
  let page = <div id="x">hi</div>
  println(render(page))

  let list = <>a<>b</>
  </>
  println(render(list))

  println(render(<Row name="x" />))
}
