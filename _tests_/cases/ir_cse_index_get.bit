// ir
// #7674: since #7562/#7574 a packed slice element read lowers to `index_get`
// instead of the word-strided `field_get` at a computed address, and optcse.bit
// forwarded only the latter, so a limb read twice across the bounds-check
// block chain was loaded twice. `limb` reads `xs[i]` in the guard and again in
// the body: post-opt it must hold ONE `index_get ... u32`, the body's compare
// and return reading that value.
//
// `stored` is the barrier control: an `index_set` into the buffer between the
// two reads clears the load chain, so its second read must stay a real
// `index_get`. `wide` pins that a `[]i16` element and an `[]f32` element are
// keyed by type and index: two reads of each at the same index collapse to one
// per slice, and the two slices never answer each other.

fn limb(xs: []u32, i: int): u32 {
  if (xs[i] > 7) {
    return xs[i] - 7
  }
  return 0
}

fn stored(xs: []u32, i: int): u32 {
  let a = xs[i]
  xs[i] = a + 1
  return xs[i]
}

fn wide(hs: []i16, fs: []f32, i: int): f32 {
  let h = hs[i] + hs[i]
  let g = fs[i] * fs[i]
  return f32(h) + g
}

fn main() {
  let xs = []u32(4)
  xs[1] = 9
  let hs = []i16(4)
  hs[2] = -3
  let fs = []f32(4)
  fs[2] = 1.5
  println("${limb(xs, 1)} ${stored(xs, 1)} ${wide(hs, fs, 2)}")
}
