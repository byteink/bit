// error
// #4270: a LITERAL array index outside `[0, arrayLen)` costs nothing at
// runtime to reject, so it is a compile error (E0122) rather than the
// runtime panic a variable or computed index gets (run_array_index_read_panic
// .bit) — mirrors check_tuple_index_out_of_range.bit's E0059 exactly, one
// layer over: `vArrayIndexOutOfRange` (validateexpr.bit).
fn f(a: [4]int): int {
  return a[9]
}
