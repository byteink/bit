// run
// #5172: JSX spread attributes against the REAL pkg/web library. A tag whose
// attributes come from BOTH a spread and a literal attribute together, in
// source order: `{...extra}` first, then `class="card"`. Bit's call syntax
// allows a `...` spread only as the sole argument into a variadic parameter
// (SPEC §12.4), so this desugars through `el`/`kidFrom`/`kid`/`kids`
// (pkg/web/node.bit), not a flat `elem(...)` call — proving the fold, not
// just the parse.
import { render, attr, text, el, kidFrom, kid, kids } from "../../pkg/web"

fn main() {
  let extra = [attr("data-id", "42"), attr("aria-label", "card")]
  let card = <div {...extra} class="card">hi</div>
  println(render(card))
}
