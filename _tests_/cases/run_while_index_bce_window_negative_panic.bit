// panic
// #6840: the window needs `i >= 0`; a base of -1 breaks it. `i + 1 < len(s)`
// holds at `i == -1`, and the check on `s[i]` must stay and fire at once.
fn main() {
  let s = "abcd"
  let i = -1
  while (i + 1 < len(s)) {
    eprint("i=${i} b=${s[i]}\n")
    i = i + 1
  }
  eprint("unreachable\n")
}
