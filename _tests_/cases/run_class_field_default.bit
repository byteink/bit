// run
// SPEC §10.5, #4471: a class-typed field default under PER-CONSTRUCTION FILL
// (owner ruling 2026-09-12) -- the default's composite literal is rebuilt at
// EVERY construction site that omits the field, so two omissions never share
// the same object. That is the whole point of the ruling: the rejected
// alternative (a static image, one object handed out to every caller) would
// pass a weaker version of this same fixture, so the fixture mutates one
// side and asserts the other is untouched, not just that both start equal.
//
// The default also nests two levels (`Inner` inside `Outer`, `Meta` inside
// `Inner`) and OMITS a field at each level (`Inner`'s own `tag` inside
// `Outer`'s default; `Meta`'s own `note` is spelled, proving a spelled value
// still overrides ITS field's default within a default).
class Meta {
  note: string = "m",
}

class Inner {
  v: int = 7,
  tag: string = "seed",
  meta: Meta = Meta{ note: "custom" },
}

class Outer {
  a: int,
  b: Inner = Inner{ v: 7, meta: Meta{ note: "custom" } },
}

fn main() {
  // Two omissions of `b` -- each must get its own `Inner`, its own `Meta`.
  let x = Outer{ a: 1 }
  let y = Outer{ a: 2 }
  x.b.v = 99
  x.b.tag = "changed"
  x.b.meta.note = "mutated"
  print("${x.a} ${x.b.v} ${x.b.tag} ${x.b.meta.note}\n")
  print("${y.a} ${y.b.v} ${y.b.tag} ${y.b.meta.note}\n")

  // The same independence through `[]Outer(n)` -- `zeroValueStruct`'s per-
  // element fill, not the literal path above.
  let xs = []Outer(2)
  xs[0].b.v = 55
  print("${xs[0].b.v} ${xs[1].b.v}\n")

  // A bare binding with no initializer at all -- the third construction site
  // `fillOmittedFields` feeds.
  let p: Outer
  print("${p.b.v} ${p.b.tag}\n")
}
