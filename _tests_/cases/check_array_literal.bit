// error
// #1470: `let arr: [2]f32 = [4.5, 4.5]` — the deleted seed compiler REJECTED the
// construct, the self-hosted `bit` ACCEPTED it and miscompiled, so `arr[0] == 4.5`
// was FALSE. One compiler accepting what the other rejects is the worst shape in
// the self-hosting effort, and NO differential could see it: the dump-comparing
// guards (difftypes/diffir/diffexamples) need a pair of dumps, and when the seed
// refuses to emit there is no pair — the case scored SKIP, not MISMATCH.
//
// THE SPEC RULING. SPEC.md §12.3 is explicit that a bare `[ ... ]` element list
// IS a slice literal, whose element type comes from the expected type or the
// join of its elements. §11.2 builds an array only from "an array literal",
// which §12.3 shows as the TYPE-PREFIXED form `[3]int{1, 2, 3}`, and §22 lists
// "arrays are not yet constructible as values" among the v0.1 deferrals. So a
// bare list against an `[N]T` annotation is ILL-TYPED and the seed was right.
// The self-hosted checker was made to agree; the seed was NOT relaxed. See the
// sibling run_array_value.bit for the form that IS legal.
//
// The root cause was far wider than the filed float case, and neither float- nor
// array-specific: the self-hosted validator had NO assignability check on an
// annotated binding AT ALL. vAssignable/vExpect were ported faithfully but had
// no Binding call site, so `let x: string = 5` and `let x: i32 = "hello"` also
// compiled clean. A generated verdict sweep (scripts/selfhost-diffverdict.sh,
// added with this fix) put it at 132 constructs the seed refuses and bit
// admitted, across bindings and call arguments. That sweep is the real guard
// here — it synthesizes constructs rather than reading the corpus, because a
// corpus only ever contains what someone already thought to write down.
//
// The length cases below are not merely wrong-typed, they were a MEMORY-SAFETY
// hole: `let a: [4]i32 = [1, 2]` built a 4-element array from two initializers
// and `a[0]` read uninitialized heap (observed: 81346512).

fn takesArr(a: [2]f32) {
  print("${a[0] == 4.5}\n")
}

fn retArr(): [2]i32 {
  // A bare list is a slice literal (§12.3); it cannot be an array result.
  return [1, 2]
}

fn main() {
  // The filed repro: element types agree, but a slice literal is not an array.
  let arr: [2]f32 = [4.5, 4.5]

  // Not float-specific — the same rule for an integer element type.
  let ints: [2]i32 = [1, 2]

  // Length disagreement, the memory-safety shape. Rejected for being a slice
  // literal at all, so the count never gets a say.
  let short: [4]i32 = [1, 2]

  // The same hole reached through a call argument rather than a binding.
  takesArr([4.5, 4.5])

  // The plain non-array half of the binding hole, which was equally unchecked.
  let s: string = 5
  let n: i32 = "hello"

  // The TYPED array form is legal (§12.3) but its length must match. Both
  // compilers report E0050 here; run_array_value.bit pins the matching case.
  let wrong: [2]f32 = [2]f32{4.5}

  // The remaining slots that carry a declared type, each of which was the same
  // unchecked hole reached through different syntax. Found by widening the
  // generated sweep, not by reading code.
  let mv = map<string, f32>{"k": "s"}   // map VALUE against map<K,V>
  let mk = map<i32, i32>{4.5: 1}        // map KEY
  let ts = []f32{"s"}                   // typed slice literal element
  let ch = chan<f32>(1)
  ch <- "s"                             // channel send against the element type
}

// A module-level `const`/`let` is not reached by the statement walk, so its
// annotation needed its own check — one scope up from the `let` above.
const badConst: f32 = "s"

let badGlobal: f32 = true
