// run
// #6403 (SPEC §10.4.1, §14.7): an enum body may declare a `static` method,
// the same member a class body declares. `Shape.unit()` is called through the
// enum's own name, has its declared result type, and is not a variant: the
// `match` over `Shape` below is exhaustive without an arm for it. A static may
// call another static and, through a value it builds, an instance method. A
// generic enum's static is called through a written instantiation or, when its
// arguments bind every parameter (or it mentions none), through the bare name.
enum Shape {
  Dot
  Line(i64)

  static unit(): Shape {
    return Shape.Line(1)
  }

  static scaled(n: i64): Shape {
    return Shape.Line(Shape.unit().size() * n)
  }

  export static count(): i64 {
    return 2
  }

  size(): i64 {
    return match (this) {
      Dot => 0
      Line(n) => n
    }
  }
}

enum Opt<T> {
  None
  Some(T)

  static wrap(v: T): Opt<T> {
    return Opt<T>.Some(v)
  }

  static empty(): Opt<T> {
    return Opt<T>.None
  }

  static arity(): i64 {
    return 1
  }
}

fn describe(s: Shape): string {
  return match (s) {
    Dot => "dot"
    Line(n) => "line ${n}"
  }
}

fn show(o: Opt<i64>): string {
  return match (o) {
    None => "none"
    Some(v) => "some ${v}"
  }
}

fn main() {
  println("${Shape.count()}")
  println(describe(Shape.unit()))
  println(describe(Shape.scaled(5)))
  println("${Shape.scaled(3).size()}")
  println(show(Opt<i64>.wrap(7)))
  println(show(Opt<i64>.empty()))
  println(show(Opt.wrap(9)))
  println("${Opt.arity()}")
  println("${Opt<string>.arity()}")
}
