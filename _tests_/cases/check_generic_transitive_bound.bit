// error
// #4646: a generic body's own call to a BOUNDED generic, judged once the
// enclosing generic has concrete arguments.
//
// `outer<T>` is legitimately unbound and its body's `inner(x)` is legitimately
// unjudgeable where it stands: the argument is the rigid `T`, and rejecting
// that would reject every generic that forwards to a bounded one. Nothing then
// judged it again per instantiation, so `bit check` exited 0 and the LOWERER
// refused inside `inner`'s own body, as
//
//   error[E0092]: cannot lower a `.` field access on a receiver that is not a
//   class or interface --> at `v.label()`
//   note: while emitting 'inner<()>', instantiated here --> at `inner(x)`
//
// — two spans, neither of them a line the user wrote.
//
// BOTH routes to the degenerate argument are here, because the `()` is not the
// cause. `empty()` reaches it through an EMPTY variadic slot, which binds
// `T = ()` (#4597/#4633); `forward(7)` reaches the identical failure with a
// perfectly ordinary `i64`. The diagnostic's primary span is the call in
// `main` in both cases, and `outer<Tag>()` / `forward(Tag{})` are what it asks
// the user to write instead — pinned as running, in
// _tests_/cases/run_generic_transitive_bound.bit.
interface Named {
  label(): string,
}

class Tag {
  export label(): string {
    return "tag"
  }
}

fn inner<T: Named>(v: T): string {
  return v.label()
}

fn empty<T>(...xs: T): string {
  for x of xs {
    return inner(x)
  }
  return "none"
}

fn forward<T>(v: T): string {
  return inner(v)
}

fn main() {
  print("${empty()}\n")
  print("${forward(7)}\n")
}
