// error
// E0083 (§13.4, #1914): a class type with a class-typed field has NO zero
// value, so the compiler refuses to invent one. Two surfaces, both here.
//
// This replaced a lowering that filled an omitted class field with a fresh
// instance one level deep. That fill left the same SIGSEGV reachable two levels
// down (`Inner` inside `Inner`), and filling every level cannot terminate on a
// type-graph cycle without handing back a null at the back edge — so the
// guarantee kept a hole either way. Refusing is the only rule with no hole.
//
// What is NOT an error is the point of the counter-cases at the bottom: a
// scalar, string, slice or map field stays omittable, because the literal's
// zeroed allocation IS their zero value.
class Deep { ys: []u32 }
class Inner { xs: []u32, d: Deep }
class Outer { a: int, b: Inner }
class Plain { n: int, s: string, xs: []u32, m: map<string, int> }

fn main() {
  // Surface 1: a keyed literal leaving a class-typed field out.
  let o = Outer{ a: 1 }

  // Surface 2: no initializer at all. `lowerctrl`'s zero-value path used to
  // answer this one with a null.
  let p: Outer

  // Two fields missing report as ONE diagnostic, not one each — they share a
  // span and a cause.
  let two = Two{ n: 1 }

  // The rule composes, so there is no depth at which it stops holding: to build
  // an `Outer` you must name `b`, and to build that `Inner` you must name `d`.
  let deep = Outer{ a: 1, b: Inner{ xs: []u32(0) } }

  // `[]S(n)` means "n zero values of S" (§12.9), so an element type with no zero
  // value cannot be built at all — and unlike the literal forms there is no
  // longer spelling to fall back on (#1924). `[]Plain(2)` below is legal and
  // must stay silent.
  let none = []Outer(2)

  // Legal, and must stay silent: every omitted field's zero value is zero bits.
  let plain = Plain{ n: 4 }
  let bare: Plain
  let full = Outer{ a: 1, b: Inner{ d: Deep{} } }
  let fine = []Plain(2)
  print(itoa(plain.n + full.a + len(bare.xs) + len(fine)))
}

class Two { n: int, first: Deep, second: Deep }

fn itoa(n: int): string {
  if (n == 0) {
    return "0"
  }
  let d = "0123456789"
  let s = ""
  let v = n
  while (v > 0) {
    s = d[v % 10:v % 10 + 1] + s
    v = v / 10
  }
  return s
}
