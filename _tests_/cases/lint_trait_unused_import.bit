// lint exit=1
// #6106: `getStreaming` is referenced only inside a `trait { }` method body
// (resolve pass 2 had no visitor case for `Tag.TraitDecl` at all, so a
// trait's own body never touched `nodeSymbols`) — must NOT be flagged.
// `requestWithStreamingBody` is imported and genuinely never referenced
// anywhere, including inside the trait, and must still be flagged: the
// negative control proving the fix does not blanket-exempt every import
// this file happens to name.
import { getStreaming, requestWithStreamingBody } from "./mod"

trait ClientStreaming {
  export getStream(n: i64): i64 {
    return getStreaming(n)
  }
}

fn main() {}
