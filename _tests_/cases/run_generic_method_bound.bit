// run
// #4495. A method may declare its own `generic_params` (SPEC §10.4,
// `scaled<T>(...)`). Before this, the checker accepted every shape below and
// lowering refused the binary: the method's own type params were never
// substituted at the call, so `v.label()` saw a receiver that was neither a
// class nor an interface (E0092) and `"${b.idOf(7)}"` interpolated a value
// "whose type has no show() method". The byte-identical body as a FREE function
// compiled and ran, which is what fixed the shape of the fix: a method is
// monomorphized through the same instantiation ledger, not a second path.
interface Named {
  label(): string,
}

class Dog {
  n: string
  export label(): string {
    return this.n
  }
}

class Box {
  k: int
  // An interface BOUND on the method's own type param — the reported shape.
  nameOf<T: Named>(v: T): string {
    return v.label()
  }
  // A bare type param returned, interpolated DIRECTLY at the call site: the
  // result type has to be substituted by the checker, or lowering has no
  // `show()` to reach for.
  idOf<T>(v: T): T {
    return v
  }
  // A generic free call inside a generic method's body: the instance body is
  // re-scanned under this instantiation's bindings, or `pass` resolves to
  // nothing.
  relay<T>(v: T): T {
    return pass(v)
  }
  // Variadic, and generic in the element type.
  count<T>(...xs: T): int {
    return len(xs)
  }
}

// Generic in its RECEIVER and in itself: the declaration's one `generic_params`
// list holds `A` then `U`, and the two halves bind from different places — `A`
// from the receiver type's own arguments, `U` from this call's.
class Pair<A> {
  a: A
  wrap<U>(u: U): U {
    return u
  }
}

fn pass<T>(v: T): T {
  return v
}

// The control: byte-identical to `Box.nameOf`, as a free function. It compiled
// and ran before the fix, and must still.
fn freeName<T: Named>(v: T): string {
  return v.label()
}

// A generic method called from a generic FREE body, so the call is re-resolved
// once per instantiation of the caller rather than once at the declaration.
fn relayed<T>(b: Box, v: T): T {
  return b.idOf(v)
}

fn main() {
  let b = Box{ k: 1 }
  print(freeName(Dog{ n: "rex" }) + "\n")
  print(b.nameOf(Dog{ n: "rex" }) + "\n")
  // Two instantiations of ONE method: each gets its own body and its own
  // symbol, and neither may collapse onto the unsuffixed method name.
  print("${b.idOf(7)} ${b.idOf("s")}\n")
  print("${b.relay(8)} ${b.relay("t")}\n")
  print("${b.count(1, 2, 3)} ${b.count("x", "y")}\n")
  let p = Pair<int>{ a: 1 }
  print("${p.wrap(9)} ${p.wrap("w")}\n")
  print("${relayed(b, 4)} ${relayed(b, "u")}\n")
}
