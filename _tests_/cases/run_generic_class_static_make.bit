// run
// #6365: a static factory called through the BARE name of a generic class,
// `Pair.make(7, "s")`, infers the class's type arguments from its arguments the
// way a generic function call does (SPEC 10.4.1, 15.3), so it is
// `Pair<i64, string>.make`. Before, the call named the TEMPLATE's `make` symbol,
// which only an instantiation emits, and failed to link (`undefined symbol
// '_make$t<template>'`).
//
// `make` declares `(first, second)`; every named call writes `second` first, so a
// value that lands in the wrong slot prints the wrong text.
//
//  1. positional;
//  2. all-named, reordered;
//  3. a positional prefix with a named suffix;
//  4. inside a generic function, the arguments' types being its own parameters;
//  5. inside the class's own body, where the arguments are the class parameters;
//  6. the written instantiation, which never needed inference.
class Pair<A, B> {
  a: A
  b: B

  init(first: A, second: B) {
    this.a = first
    this.b = second
  }

  static make(first: A, second: B): Pair<A, B> {
    return Pair<A, B>(first, second)
  }

  static swapped(first: A, second: B): Pair<B, A> {
    return Pair.make(second, first)
  }
}

fn via<T>(v: T): string {
  let p = Pair.make(v, true)
  return "${p.a}/${p.b}"
}

fn main() {
  let p = Pair.make(7, "s")
  print("${p.a} ${p.b}\n")
  let q = Pair.make(second = "t", first = 8)
  print("${q.a} ${q.b}\n")
  let r = Pair.make(9, second = "u")
  print("${r.a} ${r.b}\n")
  print("${via("v")} ${via(10)}\n")
  let s = Pair.swapped(second = "c", first = 11)
  print("${s.a} ${s.b}\n")
  let w = Pair<i64, string>.make(second = "w", first = 12)
  print("${w.a} ${w.b}\n")
}
