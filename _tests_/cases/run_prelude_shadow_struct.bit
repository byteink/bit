// run
// #3404: SPEC §17.5 says a name the module declares shadows the prelude
// name, naming `Option<T>` and `Result<T, E>` explicitly. The CHECKER did not
// honor this for TYPE names (only the value side, e.g. a local `fn newError`,
// was already correct) — `bindImports` (compiler/checkproject.bit) injected
// the prelude's `Result`/`Option` into `c.userTypes` unconditionally, and
// `declTypeOf`'s memo (compiler/checkbind.bit) then returned that id for
// every reference, so the local declaration below never got a TypeId at all.
// `bit check` passed cleanly and lowering rejected the composite literal with
// a spurious `error[E0092]: cannot lower a composite literal whose target
// type is not a slice, array, map or class` — the local class was invisible
// to both the checker AND the lowerer, not merely to the lowerer.
class Result { a: int }
class Option { b: int }
fn main() {
  let r = Result{ a: 1 }
  let o = Option{ b: 2 }
  print("${r.a} ${o.b}\n")
}
