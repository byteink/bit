// error
// SPEC §5.7: interpolation needs a string conversion, and an interface without
// `show(): string` has none — Bit has no universal `toString`. The checker must
// say so with a span; before this, lowering died with an unlocated internal error.
interface Shape { area(): i64 }
fn show(s: Shape) {
  print("${s}\n")
}
fn main() {
  show(nil)
}
