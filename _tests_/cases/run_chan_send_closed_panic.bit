// panic
// #2017: `c <- v` on a channel already closed by an earlier `close(c)` must
// panic (SPEC §18.4: "send or close on a closed channel") rather than
// silently dropping `v` and continuing. `chanSend` returns false on a closed
// channel; the ABI wrapper used to drop that boolean. Nil channel send
// (blocks forever, SPEC §16.2) and close-of-closed (#2506) are unaffected --
// this case is send-on-closed only.
fn main() {
  let c = chan<int>(1)
  close(c)
  print("start\n")
  c <- 99
  print("unreachable\n")
}
