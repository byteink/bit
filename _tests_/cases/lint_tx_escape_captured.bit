// lint exit=1
// #5077 E0217 `tx-captured-executor`: the closure is named `t`, so the
// captured outer `pool` stays reachable inside it. `pool.save(a)` lands
// OUTSIDE the transaction `pool.tx(...)` opened -- it commits immediately
// and is never rolled back with `t.save(b)`.
import { Pool } from "std/sql"

class Entity { id: int }

fn transfer(pool: Pool, a: Entity, b: Entity): ()! {
  pool.tx((t) => {
    pool.save(a)?
    t.save(b)?
  })?
}
