// run
// #4339: epic #4332's worked-cases table, pinned in one file. `of` yields THE
// VALUE and `in` yields THE POSITION for every iterable, and a binder pattern
// takes apart whatever its keyword handed it (SPEC §13.1).
//
// Eleven of the table's fifteen rows are ACCEPTING and live here. The other
// four are pinned where their harness can see them: the two rejections by
// checkercases (`for (a, b) of xs` over a `[]int`, E0146, #4336 in
// check_forof_pair_nontuple.bit; `for (k, v) in m`, E0129, #4333 in
// check_forin_map_pair.bit; `for x in c`, E0091, in check_forin_unsupported.bit)
// and the channel's accepting row by run_chan_range.bit, which needs a producer
// task this file has no reason to grow.
//
// Slot order is unspecified for a map, so the map rows sum rather than print an
// order (the convention run_map.bit and for_in_map.bit already use).
//
// A golden case is a single file, so it has no prelude.
class Row {
  name: string,
  n: int,
}

fn main() {
  let xs = [10, 20, 30]

  // []int, `of` yields the element.
  for x of xs {
    print("elem ${x}\n")
  }

  // []int, `in` yields the index.
  for i in xs {
    print("index ${i}\n")
  }

  // []int, `in`'s own pair binder: position AND value.
  for (i, x) in xs {
    print("both ${i}=${x}\n")
  }

  let pairs = [("a", 1), ("b", 2)]

  // [](string, int), `of` yields the whole tuple.
  for t of pairs {
    print("tuple ${t.0}/${t.1}\n")
  }

  // [](string, int), a tuple binder over `of` splits that value.
  for (name, n) of pairs {
    print("split ${name}=${n}\n")
  }

  // [](string, int), `in`'s pair binder: the index, plus the whole tuple.
  for (i, t) in pairs {
    print("posval ${i}:${t.0}/${t.1}\n")
  }

  // [](string, int), the value half split further, nested.
  for (i, (name, n)) in pairs {
    print("nested ${i}:${name}=${n}\n")
  }

  let m = map<string, int>{ "a": 1, "b": 2, "c": 3 }

  // map, `of` yields the (K, V) pair; a tuple binder splits it.
  let psum = 0
  for (k, v) of m {
    psum = psum + len(k) + v
  }
  print("pair ${psum}\n")

  // map, `of` with a single binder yields that same pair whole.
  let wsum = 0
  for x of m {
    wsum = wsum + len(x.0) + x.1
  }
  print("whole ${wsum}\n")

  // map, `in` yields the key.
  let ksum = 0
  for k in m {
    ksum = ksum + len(k) + m[k]
  }
  print("key ${ksum}\n")

  // []Row, a field pattern splits the value by field name (#4106).
  let rows = [Row{ name: "x", n: 4 }, Row{ name: "y", n: 5 }]
  for { n, name } of rows {
    print("field ${name}=${n}\n")
  }
}
