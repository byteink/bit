// panic-debug
// #4220: `deadCodeElim` (compiler/opt.bit) dropped a signed-overflow-checked
// instruction whose result is never read, so a genuine overflow silently
// disappeared under `bit build --debug` (the OPTIMIZED path — no `--debug`
// golden case ever passes `--no-optimize`, see stage.bit) while the identical
// program still trapped under `bit build --debug --no-optimize`
// (`--no-optimize` skips `optimizeModule` entirely, so nothing is ever
// elided on that side). Sibling of overflow_trap_neg_debug.bit: that fixture
// PRINTS the negated value, so DCE never saw it as dead and never exercised
// this path — this one discards it instead. `minRuntime()` routes MIN through
// a non-foldable subtraction (`one()`, from `len(args())`) so
// `compiler/optfold.bit`'s `foldAddSubMul` cannot resolve either it or the
// negation below as compile-time constants.
import { args } from "std/os"

fn one(): int { return len(args()) }

fn minRuntime(): int { return -9223372036854775807 - one() }

fn main() {
  let y = -minRuntime()   // overflows i64; `y` is never read
  print("ok\n")
}
