// run
// Narrow (u32) arithmetic must wrap at 32 bits, not accumulate in the full
// 64-bit register (#1158). Both results overflow u32 to exactly 0.
//
// `blackbox` (multi-block, never inlined/folded at -O1) makes one operand
// opaque so the add and the multiply run in codegen rather than being folded.
fn blackbox(x: u32): u32 {
  if (x == 0) {
    return 0
  }
  return x
}

fn main() {
  let a: u32 = blackbox(0xFFFFFFFF)
  print("${a + 1}\n")

  let m: u32 = blackbox(0x10000)
  print("${m * m}\n")
}
