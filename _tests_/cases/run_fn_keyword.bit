// run
// #2760: `fn` is a synonym for `function` in the lexer keyword table — one
// token (Kind.KwFunction) covers all three declaration forms, so all three
// must parse under the new spelling. #3727: this used `getpid` (SPEC §11.7's
// own example), which links only on aarch64-macos — it is on the libSystem
// admit-list (compiler/machosyms.bit) — because macOS resolves an unlisted
// extern dynamically at load. Linux output is fully static (no libSystem),
// so `getpid` is absent from libbitrt.a there and E0078 fired on both Linux
// targets. `bit_rt_host_target` is a runtime symbol present in the linked
// archive on every target (same reasoning as run_nosplit_extern_call.bit),
// so this `extern fn` links and runs identically everywhere.
class Box {
  v: int
  get(): int { return this.v }
}

extern fn bit_rt_host_target(): i64

fn main() {
  let b = Box{ v: 42 }
  print("hi ${b.get()} extern=${bit_rt_host_target() >= 0}\n")
}
