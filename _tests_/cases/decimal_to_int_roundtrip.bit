// run
// #5409: `i64(decimal)` (§12.9) used to segfault the compiler — the checker
// accepted it, but `lowerConvert` (lowerprim.bit) had no decimal-aware arm
// and fell through to the generic single-register `Op.Convert`, which cannot
// carry a two-word `decimal` value. `lowerIntToDecimalConvert`/
// `lowerDecimalToIntConvert` (lowerdecimalarith.bit) replace that fallthrough
// with the real two-word construction and the 96-bit-by-10 truncation loop
// (`emitDecimalDivPow10`, lowerdecimaldiv.bit).
//
// THE RULE (SPEC §11.1, §12.9): `i64(d)` truncates the fractional part
// toward zero — the same rule already stated for `float -> int` — never
// rounds. `19.99` truncates to `19`, `-19.99` truncates to `-19`, not `-20`.
fn main() {
  // A positive int -> decimal -> i64 round trip.
  let p = 5
  println("${i64(decimal(p))}")
  // A negative one: also proves the sign survives the two's-complement ->
  // sign-magnitude -> two's-complement round trip, including at the i64::MIN
  // representability boundary a naive `Op.Neg` on the magnitude would trap.
  let n = -7
  println("${i64(decimal(n))}")
  let minI64: i64 = -9223372036854775808
  println("${i64(decimal(minI64))}")
  // Zero.
  let z = 0
  println("${i64(decimal(z))}")
  // A non-zero-scale decimal: truncates toward zero, in both sign
  // directions.
  let posFrac: decimal = 19.99
  println("${i64(posFrac)}")
  let negFrac: decimal = -19.99
  println("${i64(negFrac)}")
}
