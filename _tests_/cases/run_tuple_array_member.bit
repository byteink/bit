// run
// #5882: a tuple stores a fixed-array member as an 8-byte POINTER slot
// (layoutFields, compiler/lowerfuncval.bit), not inline the way a class field
// is. Both backends' field_get selector picked the interior-address arm from
// the result type alone, so reading the member read the heap pointer (and the
// bytes after it) as if they were the array's own elements.

class Vec { xs: [3]int, tag: int }

// A list of (array, int) tuples: `ts[i].0` is a field_get on the tuple whose
// result type is [3]int, so this is the direct repro from the ticket.
fn tupleArrayMember() {
  let ts = [([3]int{ 1, 2, 3 }, 10), ([3]int{ 4, 5, 6 }, 20)]
  let i = 0
  while (i < len(ts)) {
    let a = ts[i].0
    println("${a[0]} ${a[1]} ${a[2]} ${ts[i].1}")
    i = i + 1
  }
}

// A closure cell is a tuple too (allocBox goes through buildTupleIn, #2128),
// so a reassigned captured array must read the pointer word, not an interior
// address into the CELL. SPEC §12.8: capture is by reference.
fn closureCapturedArray() {
  let arr = [3]int{ 1, 2, 3 }
  let f = () => arr[0] + arr[1] * 10 + arr[2] * 100
  arr = [3]int{ 4, 5, 6 }
  println("${f()}")
}

// Control: a class field array is still inline storage, unaffected by the fix
// above (baseIsTuple is false for a class base).
fn classFieldArrayControl() {
  let v = Vec{ xs = [3]int{ 7, 8, 9 }, tag = 42 }
  println("${v.xs[0]} ${v.xs[1]} ${v.xs[2]} ${v.tag}")
}

fn main() {
  tupleArrayMember()
  closureCapturedArray()
  classFieldArrayControl()
}
