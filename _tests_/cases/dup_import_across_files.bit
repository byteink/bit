// run
// #6326: migrations/*.bit-style directory module — `dupimportlib/a.bit` and
// `dupimportlib/b.bit` both write `import { trimSpace } from "std/strings"`
// and build as one module instead of E0042 "already declared in this scope"
// (spec/SPEC.md §17.1).
import { greet, shout } from "./dupimportlib"

fn main() {
  println(greet("  world  "))
  println(shout("  hey  "))
}
