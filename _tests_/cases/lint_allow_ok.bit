// lint exit=0
// a per-finding `allow` (spec/LINT.md §5.5, #2438) directly above the
// aliasing call, with an adequate reason: the E0214 finding is gone and the
// override counts toward the summary, same as a file-scoped one in force.
fn catchEdgeArgs(buf: []byte): int {
  // bit:lint allow E0214 -- buf is freshly allocated here and never escapes
  append(buf, 1)
  return len(buf)
}
