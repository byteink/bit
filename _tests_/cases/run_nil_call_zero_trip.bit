// run
// #4355: the nil-function-value check (SPEC §13.4, §18.4) belongs at the CALL,
// not at loop entry. A loop that runs zero times never calls `f`, so the
// program is correct and must print `done 0` — a compiler that hoists the
// check (or the closure cell's {code, env} loads, which fault on a nil cell)
// into the preheader turns this into a panic for a call the program never
// performed. Same shape and the same argument as
// `run_debug_licm_zero_trip_no_trap.bit`, which forbids the overflow-trap
// version of exactly this hoist.
//
// `zero()` is routed through `len(args())` so `compiler/optfold.bit` cannot
// resolve the trip count at compile time and prune the loop; `args()` has
// length 1 for the argument-free run the harness performs.
import { args } from "std/os"

fn zero(): i64 {
  return i64(len(args())) - 1
}

fn main() {
  let f: (i64) => i64
  let n = zero()
  let sink: i64 = 0
  let i: i64 = 0
  while (i < n) {
    sink = sink + f(i)
    i = i + 1
  }
  print("done ${sink}\n")
}
