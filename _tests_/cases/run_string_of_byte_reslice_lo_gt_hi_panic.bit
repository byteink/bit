// panic
// #6558: `string(b[lo:hi])` with `lo > hi` panics with the text `b[lo:hi]`
// itself panics with (run_slice_range_panic.bit): the one-call lowering
// applies `rtSliceSlice`'s bounds and its `oobSliceRange` message.
import { args } from "std/os"

fn lo(): int { return len(args()) + 2 }

fn main() {
  let b = []byte("hello")
  print("start\n")
  let s = string(b[lo():1])
  print("survived ${s}\n")
}
