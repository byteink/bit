// run
// #6566/#6597: a call argument takes a bare `T` where the parameter is
// `Option<T>` (SPEC §14.2 implicit `Some`): positional and named, a free
// function, a method, a class constructor-style literal call and an enum variant
// constructor, for a scalar, a string, `decimal`, a class reference, a bare-tag
// enum, a payload-carrying enum and a tuple. An omitted defaulted parameter and
// an explicit `Option.None` are unchanged. `bump()` counts its calls: the lifted
// argument is evaluated exactly once.
enum Color { Red, Green, Blue }
enum Shape { Dot, Circle(int) }
class Pt { x: int, y: int }
enum Slot { Held(Option<int>), Empty }

let calls = 0

fn shapeText(s: Shape): string {
  match (s) {
    Circle(r) => { return "Circle ${r}" }
    Dot => { return "Dot" }
  }
  return "?"
}

fn bump(): int {
  calls = calls + 1
  return calls * 10
}

fn showInt(label: string, o: Option<int>) {
  match (o) {
    Some(v) => println("${label}=Some(${v})")
    None => println("${label}=None")
  }
}

fn showStr(o: Option<string>) {
  match (o) {
    Some(v) => println("str=Some(${v})")
    None => println("str=None")
  }
}

fn showDec(o: Option<decimal>) {
  match (o) {
    Some(v) => println("dec=Some(${v})")
    None => println("dec=None")
  }
}

fn showPt(o: Option<Pt>) {
  match (o) {
    Some(v) => println("pt=Some(${v.x},${v.y})")
    None => println("pt=None")
  }
}

fn showColor(o: Option<Color>) {
  match (o) {
    Some(v) => println("color=Some(Green: ${v == Color.Green})")
    None => println("color=None")
  }
}

fn showShape(o: Option<Shape>) {
  match (o) {
    Some(v) => println("shape=Some(${shapeText(v)})")
    None => println("shape=None")
  }
}

fn showTuple(o: Option<(int, string)>) {
  match (o) {
    Some(v) => println("tuple=Some(${v.0},${v.1})")
    None => println("tuple=None")
  }
}

fn two(first: Option<int>, second: Option<string> = Option.None) {
  showInt("first", first)
  showStr(second)
}

interface Sink { put(o: Option<int>) }

fn viaFunc(f: (Option<int>) => int): int {
  return f(3)
}

fn unwrapper(o: Option<int>): int {
  return unwrapOr(o, 0)
}

class Box {
  v: int,

  put(o: Option<int>) {
    showInt("method", o)
  }
}

fn main() {
  let dec: decimal = 1.5
  showInt("int", 42)
  showStr("text")
  showDec(dec)
  showPt(Pt{ x = 1, y = 2 })
  showColor(Color.Green)
  showShape(Shape.Circle(8))
  showTuple((3, "three"))
  two(1, "one")
  two(2)
  two(second = "named", first = 3)
  two(Option.None, Option.Some("explicit"))
  Box{ v = 0 }.put(77)
  let sink: Sink = Box{ v = 0 }
  sink.put(78)
  println("func=${viaFunc(unwrapper)}")
  showInt("once", bump())
  println("calls=${calls}")
  match (Slot.Held(5)) {
    Held(o) => showInt("variant", o)
    Empty => println("variant empty")
  }
}
