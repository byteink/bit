// run
// #4336: a tuple binder over `for … of` destructures the VALUE `of` handed
// it, positionally. For a slice or array that value is the element itself, so
// `for (name, n) of xs` over a `[](string, int)` binds the element's two
// parts — NOT (index, element), which is what this shape meant before this
// ticket and is now spelled `for (i, x) in xs` (#4333).
//
// Nesting recurses through the same mechanism `let (a, b) = f()` uses, and a
// map's pair binder is unchanged: its `of`-value IS the (key, value) pair, so
// `for (k, v) of m` is that same positional destructure, not a second rule.
//
// A golden case is a single file, so it has no prelude.
fn main() {
  // Slice of 2-tuples: the element's own parts, not the index.
  let xs = [("a", 1), ("b", 2), ("c", 3)]
  for (name, n) of xs {
    print("pair ${name}=${n}\n")
  }

  // Arity is the element's, not a fixed two.
  let triples = [("x", 1, true), ("y", 2, false)]
  for (name, n, flag) of triples {
    print("triple ${name}=${n}/${flag}\n")
  }

  // Nested pattern, destructured through `let`'s own mechanism.
  let nested = [("a", (1, 2)), ("b", (3, 4))]
  for (name, (lo, hi)) of nested {
    print("nested ${name}=${lo},${hi}\n")
  }

  // A map is unchanged: `of` yields the (key, value) pair either way.
  let m = map<string, int>{ "k": 9 }
  for (k, v) of m {
    print("map ${k}=${v}\n")
  }
}
