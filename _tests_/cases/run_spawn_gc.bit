// run
// Exercises the conservative parked-stack scan (ABI.md §5): `worker` builds a
// heap class, parks on `<- wake` while still holding it, and only reads it
// after being woken. Meanwhile `main` allocates enough garbage to force
// collections. The parked worker is not the running task, so its stack is
// scanned conservatively — `keep` must survive and still read 55555. The
// unbuffered channels pin the interleaving deterministically under the
// single-worker scheduler.
class Box { v: i64 }

fn worker(out: chan<i64>, ready: chan<i64>, wake: chan<i64>) {
  let keep = Box{ v: 55555 }
  ready <- 1    // signal main that keep is built; hands the CPU back
  <- wake       // park here, holding keep, across main's alloc loop
  out <- keep.v // keep must have survived every collection
}

fn main() {
  let out = chan<i64>(0)
  let ready = chan<i64>(0)
  let wake = chan<i64>(0)
  spawn worker(out, ready, wake)
  <- ready // wait until worker parked on `<- wake` holding keep
  let i = 0
  while (i < 300000) {
    let junk = Box{ v: i }
    i = i + 1
  }
  wake <- 1 // wake the worker
  print("${<- out}\n")
}
