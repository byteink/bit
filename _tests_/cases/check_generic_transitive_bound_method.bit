// error
// #4656: a generic body's call to a bounded generic METHOD, judged once the
// enclosing generic has concrete arguments.
//
// #4646 established the rule for a FREE generic callee and reported it at the
// instantiation's own call site. A `Tag.Member` callee -- the same call with
// the generic moved into a class body -- returned unjudged, so `bit check`
// exited 0 and the LOWERER refused, as E0092 inside `Box.mk`'s own body noting
// a call inside `outer`'s body: two spans the user did not write. That is the
// gap #4634 closed for the direct case, one level down.
//
// Three routes into the same rule are here:
//
//   - `box(7)`, an ordinary `i64` reaching `mk<T: Named>` through a plain
//     class receiver,
//   - `slot()`, whose empty variadic slot binds `T = ()` (#4597/#4633) and
//     carries that into the method,
//   - `holder(7)`, whose receiver is `Holder<T>` and so is only resolvable
//     once the instantiation's own bindings are applied.
//
// The RUNS side -- every way of not reaching this diagnostic -- is
// _tests_/cases/run_generic_transitive_bound_method.bit.
interface Named {
  label(): string,
}

class Tag {
  export label(): string { return "tag" }
}

class Box {
  export mk<T: Named>(v: T): string { return v.label() }
}

class Holder<U> {
  slot: U
  export both<T: Named>(v: T): string { return v.label() }
}

// `T` is unbound here and legitimately so: nothing in this body touches a
// method on it. The bound belongs to `mk`, one level down.
fn box<T>(v: T): string {
  let b = Box{}
  return b.mk(v)
}

// The empty-slot route: `slot()` binds `T = ()`, the loop body never runs, and
// the recorded `mk<()>` is what Pass A2 would emit.
fn slot<T>(...xs: T): string {
  let b = Box{}
  for x of xs {
    return b.mk(x)
  }
  return "none"
}

// A receiver whose own type mentions the enclosing template's parameter, so
// the method resolves only under this instantiation's bindings.
fn holder<T>(v: T): string {
  let h = Holder<T>{ slot: v }
  return h.both(v)
}

// `Holder<i64>`'s satisfying use, so the class's instantiated member table is
// populated for the receiver `holder(7)` substitutes to.
fn holderOk(): string {
  let h = Holder<i64>{ slot: 1 }
  return h.both(Tag{})
}

fn main() {
  print("${box(7)}\n")
  print("${slot()}\n")
  print("${holder(7)}\n")
  print("${holderOk()}\n")
}
