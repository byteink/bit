// run
// #2429: `let x: f64 = 1` stored the INTEGER BIT PATTERN instead of the float
// value 1.0. `lowerExprH`'s `IntLit` arm (compiler/lowerexpr.bit) picked up an
// f32/f64 `hint` as its type tag (`isNumericPrim` deliberately admits floats,
// to select an integer's WIDTH) but still emitted `const_int <hint> 1` — the
// literal's own text parsed and stored raw, never converted. `${x}` printed a
// denormal near zero, `x == 1` compared two int-shaped operands and was
// (wrongly, for the wrong reason) true, and `x == 1.0` compared those bits
// against the real double and was false. `check`/`build`/`run` all reported
// rc=0; no diagnostic anywhere.
//
// The value is picked so a leftover bit-pattern mix-up cannot coincide with
// the right answer by chance (an int 1 read as an f64 is a subnormal near
// zero, nothing close to 1.0, 2.0 or 3.0).
//
// Covers the whole family that shares `lowerExprH`'s hint plumbing: a plain
// `let` (f64) and its f32 sibling, a function argument (SPEC §15.4 context
// propagation — `h(1)` where `h(x: f64)`), a class field initializer, an
// array element, a `return` value, and a compound untyped-constant
// expression (`1 + 2`). Also covers a SECOND, independent instance of the
// same bug in `lowerNamedValue`'s const-inlining path
// (compiler/lowerdriver.bit): a top-level `const K: f64 = 1` re-lowered its
// initializer with no type hint at all, so it inlined the raw int bits at
// every reference site regardless of this fix to the literal arm above.
//
// Single-file golden: no prelude.
class P { x: f64 }

const K: f64 = 1

fn h(x: f64): f64 {
  return x
}

fn ret(): f64 {
  return 1
}

fn main() {
  let x: f64 = 1
  let y: f32 = 2
  let z = h(1)
  print("${x}\n")
  print("${x == 1}\n")
  print("${x == 1.0}\n")
  print("${y}\n")
  print("${z == 1.0}\n")

  let p = P{ x: 1 }
  print("${p.x == 1.0}\n")

  let arr: [3]f64 = [3]f64{ 1, 2, 3 }
  print("${arr[0] == 1.0}\n")

  print("${ret() == 1.0}\n")

  let w: f64 = 1 + 2
  print("${w == 3.0}\n")

  print("${K}\n")
  print("${K == 1.0}\n")
}
