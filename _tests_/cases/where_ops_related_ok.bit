// types
// #6997: `related("editor")` is a relationship test. It is accepted as the value
// of a relation field (a class-typed one, or an Option of a class) and of the
// class's own `id`, alone or inside a combinator.
import { Where } from "std/where"

class Relation {
  name: string,
}

fn related(name: string): Relation {
  return Relation{ name = name }
}

class Folder {
  id: i64,
}

class Article {
  id: i64,
  folder: Folder,
  owner: Option<Folder>,
  title: string,
}

fn main() {
  let a: Where<Article> = { folder: related("editor") }
  let b: Where<Article> = { owner: related("viewer"), id: related("owner") }
  let c: Where<Article> = { or: [{ folder: related("editor") }, { title: "pinned" }] }
}
