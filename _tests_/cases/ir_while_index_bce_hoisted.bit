// ir
// #5895: compiler/optbce.bit resolves a loop param passed back to itself on the
// back edge (the trivial-phi rule), so two shapes that kept a bounds check on
// every byte now keep none. The fixture fails in both directions:
//
//   `hoisted`      — `let n = len(w)` reaches the header test and the check as
//                    two params, each fed `len(w)` on entry and itself on the
//                    back edge. No `icmp_ult` and no panic block may appear.
//   `outerCarried` — the outer index crosses an inner loop, whose header passes
//                    it back to itself, so the outer step reads an inner param
//                    and the load after the inner loop reads another. The outer
//                    loop's two loads keep no `icmp_ult`.
//   `limitMoves`   — the limit really grows on the back edge. The check MUST
//                    stay: `i < n` no longer implies `i < len(w)`.
//   `baseMoves`    — `w` is rebound to a shorter string on the back edge, so the
//                    length the check reads changes. The check MUST stay.
//
// _tests_/cases/run_while_index_bce_limit_panic.bit is the semantic half of
// `limitMoves`: it runs the program and must panic, not read past the end.

fn hoisted(w: string, c: u8): int {
  let n = len(w)
  let i = 0
  while (i < n) {
    if (w[i] == c) {
      return i
    }
    i = i + 1
  }
  return -1
}

fn outerCarried(w: string): int {
  let total = 0
  let i = 0
  while (i < len(w)) {
    total = total + int(w[i])
    let j = 0
    while (j < 2) {
      total = total + j
      j = j + 1
    }
    total = total + int(w[i])
    i = i + 1
  }
  return total
}

fn limitMoves(w: string): int {
  let total = 0
  let n = len(w)
  let i = 0
  while (i < n) {
    total = total + int(w[i])
    n = n + 1
    i = i + 1
  }
  return total
}

fn baseMoves(w: string, v: string): int {
  let total = 0
  let n = len(w)
  let i = 0
  while (i < n) {
    total = total + int(w[i])
    w = v
    i = i + 1
  }
  return total
}
