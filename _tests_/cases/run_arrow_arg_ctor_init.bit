// run
// #6564: an arrow argument to a CLASS CONSTRUCTOR takes its expected type from
// `init`'s declared parameter, as it does for a free function. `V(() => g()?)`
// was `E0041: expected '() => i64!', found '() => i64'` plus `E0061: '?' is only
// valid inside a fallible function`: `seedArrowExpectedNamedCall`
// (compiler/checkarrow.bit) finds no free function named `V`, and the value path
// sees a class, not a function, so the arrow stayed unseeded.
//
// Four shapes: a plain class, an explicit instantiation `W<int>(...)` whose
// arrow parameter type comes from the substituted class type argument, a
// generic class whose type argument the other argument binds, and a NAMED
// argument written out of order (it is seeded from the parameter its name
// binds, not its position). The free-function control keeps resolving by name.
class V {
  f: () => int!
  init(f: () => int!) {
    this.f = f
  }
}

class W<T> {
  f: (T) => T!
  init(f: (T) => T!) {
    this.f = f
  }
}

class P<T> {
  v: T
  f: (T) => T!
  init(v: T, f: (T) => T!) {
    this.v = v
    this.f = f
  }
}

class N {
  a: () => int!
  b: (int) => int!
  init(a: () => int!, b: (int) => int!) {
    this.a = a
    this.b = b
  }
}

fn g(): int! {
  return 7
}

fn h(n: int): int! {
  return n + 1
}

fn mk(f: () => int!): int! {
  return f()?
}

fn run(): int! {
  let v = V(() => g()?)
  let w = W<int>((x) => h(x)?)
  let p = P(40, (x) => h(x)?)
  let n = N(b = (x) => h(x)?, a = () => g()?)
  let c = mk(() => g()?)?
  return v.f()? + w.f(1)? + p.f(p.v)? + n.a()? + n.b(2)? + c
}

fn main() {
  let r = run() catch 0
  print("${r}\n")
}
