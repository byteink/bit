// error
// #4323: the MEMBER-callee shape that still rejects a named argument with
// E0128: `b.call(x = 1)` - a func-typed class FIELD (SPEC §9.4). The member
// is a function VALUE; `func_type` is types only, no parameter names, so `x`
// has nothing to resolve against. Same rule, same diagnostic, as a call
// through a local binding. (A generic receiver and a type-parameter receiver
// were also rejected here until #6343; both now bind against their declared
// signature, pinned by `run_named_args_generic.bit`.)

class Box {
  n: i64
  call: (i64) => i64
  put(a: i64, b: i64): i64 { return a * 10 + b }
}

fn main() {
  let b = Box{ n = 1, call = (x: i64) => x }
  let r1 = b.call(x = 1)
  print("${r1}\n")
}
