// error
// #4323: the three MEMBER-callee shapes that still reject a named argument
// with E0128 now that ordinary methods accept one, each for its own reason.
// Pinned because a reader who has just seen `s.serve(port = 3000)` compile
// would expect all three to, and because widening any of them silently is
// exactly the kind of change this file exists to catch.
//
//  1. `b.call(x = 1)` — a func-typed class FIELD (SPEC §9.4). The member is
//     a function VALUE; `func_type` is types only, no parameter names, so
//     `x` has nothing to resolve against. Same rule, same diagnostic, as a
//     call through a local binding.
//  2. `g.set(x = 1)` — a GENERIC receiver. The declaration's parameter types
//     still mention the open `T`, which is what the argument would be
//     type-checked against.
//  3. `t.area(w = 3)` — a TYPE-PARAM receiver inside a generic function. The
//     checker would read the CONSTRAINT interface's parameter names while
//     the lowerer, running after monomorphization, reads the concrete
//     implementation's; an implementation matches an interface by TYPE, not
//     by parameter name, so the two lists may legally disagree and placing
//     by one after resolving against the other is a silent wrong answer.

class Box {
  n: i64
  call: (i64) => i64
  put(a: i64, b: i64): i64 { return a * 10 + b }
}

class GBox<T> {
  v: T
  set(x: T): T { return x }
}

interface Sh {
  area(w: i64, h: i64): i64,
}

fn measure<T: Sh>(t: T): i64 {
  return t.area(w = 3, h = 2)
}

fn main() {
  let b = Box{ n: 1, call: (x: i64) => x }
  let r1 = b.call(x = 1)
  let g = GBox<i64>{ v: 0 }
  let r2 = g.set(x = 1)
  print("${r1}${r2}\n")
}
