// run
// #4074: `NaiveDateTime` composition, field forwarding and toString.
// Builds 2026-09-01T09:00:00 via `date(...)?.atTime(9, 0, 0)?` and prints
// every accessor plus the canonical string; confirms `.date()`/`.time()`
// return the composed halves; and validates `atTime`'s only failure mode
// (an out-of-range hour). Expected values inherited from #4072's and
// #4073's own pinned 2026-09-01 fields (docs/stdlib/time.md, "Reading
// fields", "Converting between types").
import { date } from "std/time"

fn main() {
  let d = date(2026, 9, 1) catch e {
    println("date build failed: ${e.message()}")
    return
  }
  let dt = d.atTime(9, 0, 0) catch e {
    println("atTime build failed: ${e.message()}")
    return
  }
  println("year=${dt.year()}")
  println("month=${dt.month()}")
  println("day=${dt.day()}")
  println("hour=${dt.hour()}")
  println("minute=${dt.minute()}")
  println("second=${dt.second()}")
  println("nanosecond=${dt.nanosecond()}")
  println("dayOfWeek=${dt.dayOfWeek()}")
  println("dayOfYear=${dt.dayOfYear()}")
  println("quarter=${dt.quarter()}")
  println("daysInMonth=${dt.daysInMonth()}")
  println("weekOfYear=${dt.weekOfYear()}")
  println("isLeapYear=${dt.isLeapYear()}")
  println("toString=${dt.toString()}")
  println("date=${dt.date().toString()}")
  println("time=${dt.time().toString()}")

  let bad = d.atTime(24, 0, 0) catch _ {
    println("atTime24Fails=true")
    return
  }
  println("atTime24Fails=false toString=${bad.toString()}")
}
