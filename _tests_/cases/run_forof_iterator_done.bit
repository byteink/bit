// run
// #6567: a fallible `next(): Option<T>!` that never fails drains to `None`, and
// the enclosing function returns normally with the sum (3 + 2 + 1 + 0 = 6) after
// 5 `next()` calls (4 `Some`, then `None`).
class Pages {
  n: i64
  calls: i64
  failAt: i64
  ran: i64
  next(): Option<i64>! {
    this.calls = this.calls + 1
    if (this.calls == this.failAt) {
      fail newError("page ${this.calls} failed")
    }
    if (this.n <= 0) {
      return Option.None
    }
    this.n = this.n - 1
    return Option.Some(this.n)
  }
}

fn drain(it: Pages): i64! {
  let sum: i64 = 0
  for x of it? {
    sum = sum + x
  }
  return sum
}

fn main() {
  let sizer = [1, 1, 1, 1]
  let it = Pages{ n = len(sizer), calls = 0, failAt = 0, ran = 0 }
  let sum = drain(it) catch _ {
    -1
  }
  print("sum=${sum} calls=${it.calls}\n")
}
