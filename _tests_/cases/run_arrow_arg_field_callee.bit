// run
// #4547: an arrow argument to a call through a func-typed FIELD takes its
// unannotated parameter types from the field's own function type.
//
// `seedArrowExpectedCall` (compiler/checkarrow.bit) sent every `Tag.Member`
// callee to `seedArrowExpectedMethodCall` and returned. A func-typed FIELD is
// not a method, so `methodSigLookup` answered 0, nothing was seeded, and the
// arrow's parameter stayed at type 0: `bit check` exited 0 while `bit build`
// refused the file with `error[E0092]: cannot lower a call whose callee does
// not resolve to a function`. The method path now reports "no method by that
// name" and the call falls through to `seedArrowExpectedValueCall` (#4544),
// where `checkMember` types the field. The seventh seeded position.
//
// The control is the shape that must keep resolving through the receiver's
// TYPE: a real METHOD called on the same receiver with the identical arrow
// argument. It exercises the method path's true return, so a fall-through that
// swallowed methods would change its answer here too.
class Thing {
  n: int
  export v(): int { return this.n }
}

type Inner = (Thing) => int
type Fn3 = (Thing, Inner) => int

fn mk(): Fn3 {
  return (t, next) => {
    return next(t)
  }
}

class Holder {
  f: Fn3
  base: int

  // Control: a METHOD of the same name shape as the field above.
  apply(t: Thing, next: Inner): int {
    return next(t) + this.base
  }
}

fn main() {
  let h = Holder{ f: mk(), base: 100 }
  println("field ${h.f(Thing{ n: 5 }, (t) => t.v())}")
  println("method ${h.apply(Thing{ n: 6 }, (t) => t.v())}")
}
