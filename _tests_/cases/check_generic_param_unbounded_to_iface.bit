// error
// #7387 negative: only a type parameter BOUNDED by an interface that carries
// the target's methods fits that interface. An unbounded `T` may be a scalar,
// which has no object pointer to be an interface value (§14.3), and a bound
// that does not carry the target's methods promises nothing about them.
interface Named { name(): string }
interface Aged { age(): i64 }

class Slot {
  held: Named,
}

fn unbounded<T>(x: T): Slot {
  return Slot{ held = x }
}

fn wrongBound<T: Aged>(x: T): Named {
  return x
}

// A bare-tag enum satisfies `Named` structurally but is a raw i64, so the
// instantiation, not the generic body, is where it is refused.
enum Color {
  Red
  Green

  name(): string { return "color" }
}

fn keep<S: Named>(s: S): Slot {
  return Slot{ held = s }
}

fn main() {
  let s = keep(Color.Red)
}
