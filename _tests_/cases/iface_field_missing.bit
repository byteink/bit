// error
// #6990: a class with no field of that name does not satisfy a field
// requirement, and a method of the same name is not a field either.
interface Subject {
  id: string,
}

class Anon {
  export name: string,
}

class Fn {
  id(): string { return "x" }
}

fn main() {
  let a: Subject = Anon{ name = "n" }
  let b: Subject = Fn{}
  print("${a.id}\n")
  print("${b.id}\n")
}
