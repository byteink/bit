// types
// #6997: `and` and `or` take a list of conditions, `not` one; every operand is a
// `Where<T>` literal checked by the same rules, nested to any depth, and mixed
// with ordinary field entries and operator objects.
import { Where } from "std/where"

class Article {
  id: i64,
  authorId: i64,
  status: string,
  views: i64,
}

fn main() {
  let w: Where<Article> = {
    or: [{ status: "published" }, { authorId: 7, views: { gte: 100 } }],
    not: { status: "archived" },
  }
  let deep: Where<Article> = {
    and: [{ or: [{ id: 1 }, { id: 2 }] }, { not: { views: { lt: 1 } } }],
    status: { ne: "draft" },
  }
  let empty: Where<Article> = { or: [] }
}
