// types
// #6997: a field's value may be an operator object: eq, ne, in, lt, lte, gt, gte,
// several on one field ANDed. Each operand has the field's own type; an `in`
// operand is a list of it, and an empty list is allowed.
import { Where } from "std/where"

enum Status { Draft, Published }

class Article {
  id: i64
  age: i64
  score: f64
  title: string
  state: Status
  editor: Option<string>
}

fn main() {
  let a: Where<Article> = { age: { eq: 18 } }
  let b: Where<Article> = { age: { ne: 18 } }
  let c: Where<Article> = { age: { in: [18, 21, 65] } }
  let d: Where<Article> = { age: { lt: 65 }, score: { lte: 2.5 } }
  let e: Where<Article> = { age: { gt: 17 }, title: { gte: "m" } }
  let f: Where<Article> = { age: { gte: 18, lt: 65 } }
  let g: Where<Article> = { title: { in: [] }, state: { ne: Status.Draft } }
  let h: Where<Article> = { editor: { eq: "sara", in: ["sara", "li"] }, id: 4 }
}
