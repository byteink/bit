// run
// #6255, epic #6253, SPEC §10.5: every
// `@table` class synthesizes `static __tableName(): string`, `static
// __fromRow(rows: Rows): T!`, `static __columns(): []FieldDesc` and an
// instance `__values(): []Value` — reachable through a type parameter bound
// exactly like `@job`'s `__jobName` (compiler/classjobdesc.bit), so a
// generic `describe<T: Tabled>` needs no hand-written mapper and no
// dummy-instance `tableDescriptor()` call.
//
// `Account` pins `@table("accounts")`'s override; `OrderLine` pins the
// default snake_case-of-the-class-name rule (`order_line`, never
// pluralized). `main` pins `__fromRow` decoding a synthetic `Rows` and
// `__values()` round-tripping every field back into `Value`s, in column
// order.
//
// A `@table` class cannot be declared INSIDE `stdlib/sql` itself to unit-test
// `__fromRow` there: `classtabledesc.bit`'s E0150 requires an import of
// `FieldDesc`/`AttrDesc` FROM "std/sql", and a module inside "std/sql"
// importing itself is E0044 — the identical self-import limitation
// `stdlib/sql/row.test.bit`'s own header records for `find<T>`. This golden
// case is the equivalent coverage, run from outside the package.
import { FieldDesc, AttrDesc, Rows, Value } from "std/sql"

interface Tabled {
  static __tableName(): string,
  static __columns(): []FieldDesc,
}

@table class OrderLine {
  id: i64,
  qty: i64,
}

@table("accounts") class Account {
  id: i64,
  balance: i64,
}

fn describe<T: Tabled>(): string {
  let out = "${T.__tableName()}:"
  for f of T.__columns() {
    out = out + " ${f.name}"
  }
  return out
}

// A canned single-row result set: `cols`/`row` fixed at construction.
class fakeRows {
  cols: []string
  row: []Value
  done: bool = false
  next(): bool! {
    if (this.done) {
      return false
    }
    this.done = true
    return true
  }

  columns(): []string {
    return this.cols
  }

  value(col: int): Value {
    return this.row[col]
  }

  close() {}
}

fn printValue(v: Value) {
  match (v) {
    Int(n) => print("Int(${n})")
    Text(s) => print("Text(${s})")
    _ => print("other")
  }
}

fn main() {
  print("${describe<OrderLine>()}\n")
  print("${describe<Account>()}\n")

  let rows = fakeRows{ cols = ["id", "qty"], row = [Value.Int(7), Value.Int(3)] }
  let line = OrderLine.__fromRow(rows) catch e {
    panic("__fromRow: ${e.message()}")
  }
  print("decoded: id=${line.id} qty=${line.qty}\n")

  for v of line.__values() {
    printValue(v)
    print(" ")
  }
  print("\n")
}
