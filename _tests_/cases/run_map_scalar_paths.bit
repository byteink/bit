// run
// #4352 split `map_set`/`map_get`/`map_slot`/`map_delete` into an inline
// SCALAR-key probe and the shared descriptor-dispatching path, so the probe
// loop now exists in five places (the four entry points and `mapProbe`). This
// drives all four entry points through the boundaries a copy left behind gets
// wrong -- a map that silently loses ONE entry passes almost every other
// fixture:
//
//   * long probe CHAINS, from a table run at the 0.875 load factor;
//   * probing OVER TOMBSTONES -- delete two thirds, then read and reinsert the
//     same keys, so every probe walks a chain of tombstones. Which slot a
//     reinsert lands in is NOT observable from output (it only changes when the
//     next grow fires), so this asserts the entries are still found, not that
//     the tombstone was reused;
//   * a GROW across a resize with tombstones present, which rehashes through
//     `mapHash` and must agree with the inline scalar hash;
//   * the comma-ok read (`map_slot`), including a present key whose value is
//     the zero word, which a "value != 0 means present" bug would drop;
//   * a COMPOSITE key holding a payload enum (#4341), which must still take the
//     shared path and still collapse two structurally-equal keys to one entry.
enum Port { Default, Explicit(int) }
class Config { host: string, port: Port }

const keyCount: int = 4000

// Sparse and negative, so the splitmix64 finalizer is doing real work rather
// than mapping i -> slot i.
fn keyAt(i: int): int {
  return i * 2654435761 - 1000
}

fn fill(m: map<int, int>) {
  let i = 0
  while (i < keyCount) {
    m[keyAt(i)] = i
    i = i + 1
  }
}

// Every key must read back through BOTH `map_get` and the comma-ok `map_slot`
// read; a lost entry shows up here.
fn countMissing(m: map<int, int>): int {
  let missing = 0
  let i = 0
  while (i < keyCount) {
    let k = keyAt(i)
    if (m[k] != i) {
      missing = missing + 1
    }
    let (v, ok) = m[k]
    if (!ok || v != i) {
      missing = missing + 1
    }
    i = i + 1
  }
  return missing
}

fn sumOverKeys(m: map<int, int>): int {
  let sum = 0
  let i = 0
  while (i < keyCount) {
    sum = sum + m[keyAt(i)]
    i = i + 1
  }
  return sum
}

// Leaves the table full of tombstones for every probe below to walk.
fn deleteTwoThirds(m: map<int, int>) {
  let i = 0
  while (i < keyCount) {
    if (i % 3 != 0) {
      delete(m, keyAt(i))
    }
    i = i + 1
  }
}

fn reinsertDeleted(m: map<int, int>) {
  let i = 0
  while (i < keyCount) {
    if (i % 3 != 0) {
      m[keyAt(i)] = i + 1
    }
    i = i + 1
  }
}

// Insert a second, dense key range so the table resizes with tombstones live,
// then re-read every one of them through the grown table.
fn growAndCount(m: map<int, int>): int {
  let i = 0
  while (i < keyCount) {
    m[i] = i * 3
    i = i + 1
  }
  let lost = 0
  i = 0
  while (i < keyCount) {
    if (m[i] != i * 3) {
      lost = lost + 1
    }
    i = i + 1
  }
  return lost
}

// Two structurally-equal composite keys, each holding an equal payload enum,
// are ONE entry (#4341); a third with a different variant is its own. Packed
// into one number as `len * 10 + value` so this stays a single result.
fn compositeEntries(): int {
  let seen = map<Config, int>{}
  seen[Config{ host: "localhost", port: Port.Explicit(8080) }] = 1
  seen[Config{ host: "localhost", port: Port.Explicit(8080) }] = 2
  seen[Config{ host: "localhost", port: Port.Default }] = 3
  let v = seen[Config{ host: "localhost", port: Port.Explicit(8080) }]
  return len(seen) * 10 + v
}

fn main() {
  let m = map<int, int>()
  fill(m)
  let inserted = len(m)
  let missing = countMissing(m)
  let sum = sumOverKeys(m)

  deleteTwoThirds(m)
  let afterDelete = len(m)
  reinsertDeleted(m)
  let afterReinsert = len(m)
  let sum2 = sumOverKeys(m)

  // Deleting an absent key is a no-op; reading one is the zero value, and the
  // comma-ok read reports absence rather than the zero value.
  delete(m, 7)
  let absent = m[7]
  let (av, aok) = m[7]
  let absentOk = 0
  if (aok) {
    absentOk = 1
  }

  // A present key whose VALUE is zero: `ok` must still be true.
  m[7] = 0
  let (zv, zok) = m[7]
  let zeroOk = 0
  if (zok) {
    zeroOk = 1
  }

  let grownLost = growAndCount(m)
  let composite = compositeEntries()

  print("inserted=${inserted} missing=${missing} sum=${sum}\n")
  print("afterDelete=${afterDelete} afterReinsert=${afterReinsert} sum2=${sum2}\n")
  print("absent=${absent} av=${av} absentOk=${absentOk} zv=${zv} zeroOk=${zeroOk}\n")
  print("grownLost=${grownLost} composite=${composite}\n")
}
