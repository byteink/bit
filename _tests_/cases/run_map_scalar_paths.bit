// run
// #4352 split `map_set`/`map_get`/`map_slot`/`map_delete` into an inline
// SCALAR-key probe and the shared descriptor-dispatching path, so the probe
// loop now exists in five places (the four entry points and `mapProbe`). This
// drives all four entry points through the boundaries a copy left behind gets
// wrong — a map that silently loses ONE entry passes almost every other
// fixture:
//
//   * long probe CHAINS, from a table run at the 0.875 load factor;
//   * probing OVER TOMBSTONES — delete two thirds, then read and reinsert the
//     same keys, so every probe walks a chain of tombstones. Which slot a
//     reinsert lands in is NOT observable from output (it only changes when the
//     next grow fires), so this asserts the entries are still found, not that
//     the tombstone was reused;
//   * a GROW across a resize with tombstones present, which rehashes through
//     `mapHash` and must agree with the inline scalar hash;
//   * the comma-ok read (`map_slot`), including a present key whose value is
//     the zero word, which a "value != 0 means present" bug would drop;
//   * a COMPOSITE key holding a payload enum (#4341), which must still take the
//     shared path and still collapse two structurally-equal keys to one entry.
enum Port { Default, Explicit(int) }
class Config { host: string, port: Port }

fn main() {
  // Scalar keys, sparse and negative so the splitmix64 finalizer is doing real
  // work rather than mapping i -> slot i.
  let m = map<int, int>()
  let n = 4000
  let i = 0
  while (i < n) {
    m[i * 2654435761 - 1000] = i
    i = i + 1
  }
  let inserted = len(m)

  // Every key must read back, through both `map_get` and the comma-ok
  // `map_slot` read. `missing` is the count a lost entry shows up in.
  let missing = 0
  let sum = 0
  i = 0
  while (i < n) {
    let k = i * 2654435761 - 1000
    if (m[k] != i) {
      missing = missing + 1
    }
    let (v, ok) = m[k]
    if (!ok) {
      missing = missing + 1
    }
    sum = sum + v
    i = i + 1
  }

  // Delete two thirds, leaving a table full of tombstones, then reinsert the
  // SAME keys with new values: every probe below walks tombstone chains.
  i = 0
  while (i < n) {
    if (i % 3 != 0) {
      delete(m, i * 2654435761 - 1000)
    }
    i = i + 1
  }
  let afterDelete = len(m)

  i = 0
  while (i < n) {
    if (i % 3 != 0) {
      m[i * 2654435761 - 1000] = i + 1
    }
    i = i + 1
  }
  let afterReinsert = len(m)

  let sum2 = 0
  i = 0
  while (i < n) {
    sum2 = sum2 + m[i * 2654435761 - 1000]
    i = i + 1
  }

  // Deleting an absent key is a no-op; reading one is the zero value; the
  // comma-ok read reports absence rather than the zero value.
  delete(m, 7)
  let absent = m[7]
  let (av, aok) = m[7]
  let absentOk = 0
  if (aok) {
    absentOk = 1
  }

  // A present key whose VALUE is zero: `ok` must still be true.
  m[7] = 0
  let (zv, zok) = m[7]
  let zeroOk = 0
  if (zok) {
    zeroOk = 1
  }

  // Growth: keep inserting past the load factor so the table resizes with
  // tombstones live, then re-read everything through the grown table.
  i = 0
  while (i < n) {
    m[i] = i * 3
    i = i + 1
  }
  let grownLost = 0
  i = 0
  while (i < n) {
    if (m[i] != i * 3) {
      grownLost = grownLost + 1
    }
    i = i + 1
  }

  // The composite/payload-enum key still takes the shared path (#4341): two
  // structurally-equal keys are ONE entry.
  let seen = map<Config, int>{}
  seen[Config{ host: "localhost", port: Port.Explicit(8080) }] = 1
  seen[Config{ host: "localhost", port: Port.Explicit(8080) }] = 2
  seen[Config{ host: "localhost", port: Port.Default }] = 3
  let composite = len(seen)
  let compositeVal = seen[Config{ host: "localhost", port: Port.Explicit(8080) }]

  print("inserted=${inserted} missing=${missing} sum=${sum}\n")
  print("afterDelete=${afterDelete} afterReinsert=${afterReinsert} sum2=${sum2}\n")
  print("absent=${absent} av=${av} absentOk=${absentOk} zv=${zv} zeroOk=${zeroOk}\n")
  print("grownLost=${grownLost} composite=${composite} compositeVal=${compositeVal}\n")
}
