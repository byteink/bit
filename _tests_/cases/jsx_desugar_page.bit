// run
// #3944: golden case for JSX desugaring (SPEC §12.12). One page exercising
// every shape the ticket names: a lowercase element with an attribute and
// mixed text/expr children, an uppercase component call with a prop and
// element children, and a fragment — proving each desugars into a real call
// tree that runs and produces exactly the markup a hand-written call tree
// would.
//
// `elem`/`attr`/`frag` are declared HERE, not imported from `pkg/web`: the
// compiler never implicitly imports JSX's target names (SPEC §12.12), so any
// module exposing them works, and a plain string-concatenation stand-in is
// enough to prove the desugaring's SHAPE without pkg/web's own Node/render
// machinery.

fn elem(tag: string, ...kids: string): string {
  let s = "<" + tag + ">"
  for k of kids {
    s = s + k
  }
  return s + "</" + tag + ">"
}

fn attr(name: string, value: string): string {
  return " ${name}=\"${value}\""
}

fn frag(...kids: string): string {
  let s = ""
  for k of kids {
    s = s + k
  }
  return s
}

fn ListItem(text: string): string {
  return "<li>" + text + "</li>"
}

fn Page(title: string, children: []string): string {
  let body = ""
  for c of children {
    body = body + c
  }
  return "<h1>" + title + "</h1>" + body
}

fn main() {
  let name = "world"
  let greeting = <p id="greeting">hello, {name}!</p>
  print(greeting)
  print("\n")

  let year = "2024"
  let footer = <>copyright {year}</>
  print(footer)
  print("\n")

  let page = <Page title="Items"><ListItem text="one" /><ListItem text="two" /></Page>
  print(page)
  print("\n")
}
