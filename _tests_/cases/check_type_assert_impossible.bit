// error
// A target that cannot satisfy the interface can never be the dynamic type of a
// value held in it, so the assertion would report `false` forever. Reject it at
// compile time instead (SPEC §14.4).
class Circle {
  r: i64,

  area(): i64 {
    return this.r
  }
}

class Blob {
  b: i64,
}

interface Shape {
  area(): i64
}

fn main() {
  let sh: Shape = Circle{ r: 1 }
  let (x, ok) = sh.(Blob)
  print("${ok}\n")
}
