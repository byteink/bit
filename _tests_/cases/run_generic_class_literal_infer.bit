// run
// #6428: a bare literal of a generic class infers its type arguments from its
// field values, and a parameter the fields leave open from a sibling's bound
// (SPEC 11.3, 15.3). `Pair{ store = StrStore{...} }` binds `S` from the field and
// then `K = string` from `Store<K>`'s `get`; the same literal over `IntStore` is
// a `Pair<i64, IntStore>`. A declared target types the literal instead, in every
// position that has one: an argument, a result, a field and an element lay the
// object out under `f32` (not the `f64` its constants alone default to), and an
// expression with no target infers it from its fields.
interface Store<V> {
  get(k: string): V,
}

class StrStore {
  pre: string,

  get(k: string): string {
    return this.pre + k
  }
}

class IntStore {
  base: i64,

  get(k: string): i64 {
    return this.base + len(k)
  }
}

class Pair<K, S: Store<K>> {
  store: S,

  first(k: string): K {
    return this.store.get(k)
  }
}

class Two<A, B> {
  a: A,
  b: B,
}

class Holder {
  w: Two<f32, f32>,
}

fn show(x: Two<f32, f32>): f32 {
  return x.b
}

fn make(): Two<f32, f32> {
  return Two{ a = 1.5, b = 2.5 }
}

fn pick(p: Pair<string, StrStore>): string {
  return p.first("!")
}

fn main() {
  let p = Pair{ store = StrStore{ pre = "x" } }
  println(p.first("y"))
  let q = Pair{ store = IntStore{ base = 40 } }
  println("${q.first("yy")}")
  let t = Two{ a = 1, b = "s" }
  println("${t.a} ${t.b}")
  println("${show(Two{ a = 1.5, b = 2.5 })}")
  println("${make().b}")
  let h = Holder{ w = Two{ a = 1.5, b = 2.5 } }
  println("${h.w.b}")
  let es: []Two<f32, f32> = [Two{ a = 1.5, b = 2.5 }]
  println("${es[0].b}")
  println("${Two{ a = 7, b = 8 }.b}")
  println(pick(Pair{ store = StrStore{ pre = "p" } }))
}
