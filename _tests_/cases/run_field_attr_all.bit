// run
// SPEC §10.5, #4572: the synthesized `validateFields()` runs EVERY attribute,
// not the ones before the first failure, and reports every failure in ONE
// error whose message names the field each came from.
//
// Three things are pinned here and nowhere else.
//
// TWO ATTRIBUTES ON ONE FIELD both fail and are both reported -- `handle`
// carries @short then @lower, and "AB" is wrong on both counts. A run that
// printed only "handle: too short" would be the first-failure-wins behaviour
// this case exists to refuse.
//
// THE FIELD NAME COMES FROM THE SYNTHESIS, NOT FROM THE RULE. `short`, `lower`
// and `digits` are ordinary functions taking the field's VALUE and nothing
// else -- none of them can know which field it ran on, and none of their
// messages says one. The `handle: ` and `pin: ` prefixes are attached at the
// catch, which is the only place the name exists.
//
// THE INDIVIDUAL ERRORS SURVIVE THE JOIN. The one error also answers
// `fieldFailures()`, asserted here through an interface this file declares and
// nothing registers -- the same structural shape any framework would use to
// apply a policy per failure rather than to a joined string. Each inner error
// is the rule's own, with its own message, unprefixed.

class validationError {
  text: string

  message(): string {
    return this.text
  }
}

fn short(s: string, n: int): ()! {
  if (len(s) < n) {
    fail validationError{ text: "too short" }
  }
}

fn lower(s: string): ()! {
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c >= 'A' && c <= 'Z') {
      fail validationError{ text: "not lowercase" }
    }
    i = i + 1
  }
}

fn digits(s: string): ()! {
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      fail validationError{ text: "not a digit" }
    }
    i = i + 1
  }
}

class Account {
  @short(3)
  @lower
  handle: string

  @digits
  pin: string
}

// The structural view of the error `validateFields()` fails with. Nothing
// declares this type to the compiler and nothing registers it: a caller that
// wants the failures one by one asks for them by shape, exactly as it would
// ask any value whether it has a method.
interface FieldFailures {
  message(): string,
  fieldFailures(): []error,
}

fn report(a: Account) {
  a.validateFields() catch e {
    print("${e.message()}\n")
    let (agg, ok) = e.(FieldFailures)
    if (!ok) {
      print("  not an aggregate\n")
      return
    }
    for one of agg.fieldFailures() {
      print("  - ${one.message()}\n")
    }
    return
  }
  print("ok\n")
}

fn main() {
  report(Account{ handle: "AB", pin: "12x4" })
  report(Account{ handle: "abc", pin: "no" })
  report(Account{ handle: "abc", pin: "1234" })
}
