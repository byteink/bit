// ir
// #7770: an if body is entered along one edge only, so each of its params IS
// the argument that edge passes. `digits` fails out on `c < '0' || c > '9'`
// (one unsigned compare on `c - '0'` since #7761) and the body then receives
// the loop's locals as params; its `c - '0'` must key as the range test's `sub`
// and be forwarded to it, so post-opt the body block holds no `sub u8`.
//
// `joined` is the soundness control: its `c` reaches the return through a join
// with two predecessors, equal to `a` on one edge and `b` on the other, so its
// `c - '0'` must stay a real `sub` and never answer to `a - '0'`.

fn digits(s: string): int {
  let v = 0
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      return -1
    }
    v = v * 10 + int(c - '0')
    i = i + 1
  }
  return v
}

fn joined(a: byte, b: byte, first: bool): int {
  let d = a - '0'
  let c = b
  if (first) {
    c = a
  }
  return int(c - '0') + int(d)
}

fn main() {
  println("${digits("1234")} ${digits("12a4")} ${joined('3', '5', false)} ${joined('3', '5', true)}")
}
