// run
// #4354: `for x of xs` no longer bounds-tests the element load. The header has
// already tested `idx < slice_len($iter)` against the same SSA base and the
// body block is that branch's true target with nothing running in between, so
// the second test was provably redundant — but "provably" is a claim about the
// LOWERING, and the shapes that could falsify it are shapes that move a
// slice's length or its buffer WHILE the loop is running. Those are what this
// case pins, from the outside, as program behaviour.
//
// Every arm here produced this exact output before the check was removed; the
// case is worthless unless it is compared against that, which is why the
// sequence and the count are both printed rather than just a sum. A removal
// that reached one element too far would read adjacent heap and print a
// plausible number, not crash (#4346 measured exactly that failure shape on
// the string byte load: four of five fixtures exited 0 with `byte=116`).
import { args } from "std/os"

class Z { xs: []int, s: string }

// Non-foldable 0/1, so nothing below collapses into a constant the optimizer
// could answer without the loop.
fn zero(): int { return len(args()) - 1 }

// APPEND TO THE SLICE BEING ITERATED. `bit_rt_slice_append` mutates the header
// IN PLACE, so `$iter`'s length GROWS under the loop and the elements appended
// during iteration are themselves visited. The first append also grows past
// `cap`, which reallocates the buffer and resets `off` — so the `buf`/`off`
// words this loop reads must be the post-grow ones, not a stale pair.
fn appendDuring(): string {
  let xs = [1, 2, 3]
  let seen = ""
  let n = zero()
  for x of xs {
    seen = seen + "${x} "
    if (n < 3) {
      xs = append(xs, x * 10)
    }
    n = n + 1
  }
  return "${seen}| n=${n} len=${len(xs)}"
}

// RESLICE THE ITERATED NAME. `xs[lo:hi]` allocates a FRESH header
// (runtime/root/slices.bit), so rebinding `xs` inside the body cannot shorten
// the header `$iter` holds: the loop still visits all four elements.
fn resliceDuring(): string {
  let xs = [1, 2, 3, 4]
  let seen = ""
  let n = zero()
  for x of xs {
    seen = seen + "${x} "
    xs = xs[zero():zero() + 1]
    n = n + 1
  }
  return "${seen}| n=${n} len=${len(xs)}"
}

// REBIND THE ITERATED NAME TO A DIFFERENT, SHORTER SLICE. `$iter` is a hidden
// local snapshotted at loop entry and unspellable from the body, so this must
// not shorten the iteration either.
fn rebindDuring(): string {
  let xs = [5, 6, 7]
  let seen = ""
  let n = zero()
  for x of xs {
    seen = seen + "${x} "
    xs = []int(zero())
    n = n + 1
  }
  return "${seen}| n=${n} len=${len(xs)}"
}

// THE ZERO-LENGTH BASES. A zeroed class's slice field is the NULL WORD, not an
// empty header (SPEC §13.4, #1564): `slice_len` reads a null header as 0, so
// the header test fails on the first iteration and the unchecked element load
// is never reached. An empty-but-real header is the same story by a different
// route, and both must iterate zero times rather than fault.
fn emptyBases(): string {
  let z = Z{}
  let n = zero()
  for _ of z.xs {
    n = n + 1000
  }
  let e = []int(zero())
  for _ of e {
    n = n + 100
  }
  return "n=${n} nulllen=${len(z.xs)} emptylen=${len(e)}"
}

// A PACKED `[]u8` (stride 1) and a REFERENCE element type take different arms
// of the element load, so both are walked here rather than only the i64 one.
fn packedAndRef(): string {
  let bs = []u8(zero())
  bs = append(bs, u8(65))
  bs = append(bs, u8(66))
  bs = append(bs, u8(67))
  let out = ""
  for b of bs {
    out = out + "${b} "
  }
  let zs = []Z(zero())
  zs = append(zs, Z{ xs: [9], s: "a" })
  zs = append(zs, Z{ xs: [8, 7], s: "b" })
  for z of zs {
    out = out + "${z.s}${len(z.xs)} "
  }
  return out
}

fn main() {
  print("append: ${appendDuring()}\n")
  print("reslice: ${resliceDuring()}\n")
  print("rebind: ${rebindDuring()}\n")
  print("empty: ${emptyBases()}\n")
  print("mixed: ${packedAndRef()}\n")
}
