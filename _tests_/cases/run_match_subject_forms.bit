// run
// NEGATIVE case for E0069 (#1541): every one of these `match` subjects is a
// valid enum, so none may be refused. E0069 fires when the subject's resolved
// type is confidently not an enum, which makes it exactly the shape that a
// checker with WEAKER inference than the seed's turns into a false positive —
// infer any wrong-but-non-zero type for one of these subjects and a working
// build breaks (the #1522 failure mode). A bare `match (e)` over a local would
// not test that; each subject below reaches the enum through a different
// inference path.
enum Color { Red, Green, Blue }

class Holder {
  c: Color
  get(): Color {
    return this.c
  }
}

fn pick(): Color {
  return Color.Green
}

fn name(c: Color): string {
  match (c) {
    Red => { return "red" }
    Green => { return "green" }
    Blue => { return "blue" }
  }
}

fn main() {
  // subject: a local binding
  let a = Color.Red
  print("${name(a)}\n")
  // subject: a call result
  print("${name(pick())}\n")
  // subject: a class field
  let h = Holder{ c: Color.Blue }
  print("${name(h.c)}\n")
  // subject: a method call result
  print("${name(h.get())}\n")
  // subject: a slice element
  let xs = [Color.Green, Color.Red]
  print("${name(xs[0])}\n")
  // subject: a parenthesized expression
  print("${name(a)}\n")
  // subject inline, matched directly rather than through a helper
  match (pick()) {
    Red => { print("direct red\n") }
    Green => { print("direct green\n") }
    Blue => { print("direct blue\n") }
  }
}
