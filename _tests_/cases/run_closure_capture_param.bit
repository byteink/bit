// run
// #2128: a captured PARAMETER is a local like any other, so it takes a cell at
// entry — `11 11` before. Two calls prove each activation gets its own cell
// rather than sharing one per declaration site.
fn make(n: int): () => int {
  return () => { n = n + 1; return n }
}
fn main() {
  let f = make(10)
  let g = make(100)
  print("${f()} ${f()} ${g()}\n")
}
