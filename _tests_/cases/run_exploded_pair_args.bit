// run
// #4404: a two-word aggregate parameter is passed as TWO words, exploded in
// the lowerer. Every line here is a use of such a parameter that must still
// produce the same answer it did when the aggregate arrived as one handle,
// because the callee no longer holds an object at all — the words are the
// local, and a box is materialized only where something needs the whole thing.
//
//   readPair   `w.0`/`w.1` read the words directly, no load from a header
//   traced     one word is a GC reference and one is not; the reference must
//              still be a live root across the callee's own allocation
//   assign     a parameter is assignable (§13.2) — the rebind has to reach
//              BOTH words, or a later read returns the pre-assignment value
//   join       a value that crosses a control-flow join is threaded through
//              block parameters; an exploded local owes TWO of them, and a
//              loop's back edge is where a missed one shows up
//   whole      passing the parameter on as a whole aggregate, to something
//              that takes it as one value (a slice element here), forces the
//              box to be built back
//   forward    passing it on to ANOTHER exploded parameter keeps it in words
//   destruct   `let (a, b) = w` binds the words positionally
//   fnvalue    called through a function VALUE, whose trampoline keeps the
//              one-word function-type convention and unpacks for the call
//   deferred   `defer f(w)` replays at exit through captured slots
//   overflow   nine integer words against eight argument registers, so one
//              overflows to the outgoing stack-argument area

fn readPair(w: (int, int), k: int): int {
  return w.0 * 3 + w.1 + k
}

fn traced(w: (int, string), k: int): string {
  let pad = "<" + w.1 + ">"
  return "${w.0 + k}${pad}"
}

fn assign(w: (int, int), k: int): int {
  if (k > 0) {
    w = (k * 10, k * 100)
  }
  return w.0 + w.1
}

fn join(w: (int, int), n: int): int {
  let acc = 0
  let i = 0
  while (i < n) {
    acc = acc + w.0 + w.1
    i = i + 1
  }
  return acc
}

fn whole(w: (int, int)): int {
  let xs = [w, w]
  return xs[0].0 + xs[1].1
}

fn forward(w: (int, int), k: int): int {
  return readPair(w, k) + 1
}

fn destruct(w: (int, int)): int {
  let (a, b) = w
  return a * 2 + b
}

fn deferred(w: (int, int)) {
  defer showPair(w)
  print("deferred before\n")
}

fn showPair(w: (int, int)) {
  print("deferred ${w.0} ${w.1}\n")
}

fn overflow(a: (int, int), b: (int, int), c: (int, int), d: int, e: int, f: int): int {
  return a.0 + a.1 * 2 + b.0 * 3 + b.1 * 4 + c.0 * 5 + c.1 * 6 + d * 7 + e * 8 + f * 9
}

fn main() {
  let w = (7, 11)
  print("read ${readPair(w, 5)}\n")
  print("traced ${traced((4, "s"), 2)}\n")
  print("assign ${assign(w, 0)} ${assign(w, 3)}\n")
  print("join ${join(w, 3)}\n")
  print("whole ${whole(w)}\n")
  print("forward ${forward(w, 5)}\n")
  print("destruct ${destruct(w)}\n")
  let f = readPair
  print("fnvalue ${f(w, 5)}\n")
  deferred(w)
  print("overflow ${overflow((1, 2), (3, 4), (5, 6), 7, 8, 9)}\n")
}
