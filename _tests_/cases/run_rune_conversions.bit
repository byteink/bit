// run
// #7101: the UTF-8 rune conversions `string(rune)`, `string([]rune)` and
// `[]rune(s)` (SPEC §12.9), Go semantics. An invalid scalar (negative,
// surrogate, above U+10FFFF) encodes as U+FFFD; an invalid byte decodes to
// U+FFFD and advances one byte.

fn hex(s: string): string {
  let out = ""
  let i = 0
  while (i < len(s)) {
    out = out + "${int(s[i])} "
    i = i + 1
  }
  return out
}

fn show(r: rune) {
  print("${int(r)}: ${hex(string(r))}\n")
}

fn dump(rs: []rune) {
  let out = "${len(rs)}:"
  for r of rs {
    out = out + " ${int(r)}"
  }
  print("${out}\n")
}

fn main() {
  show(0x41)
  show(0xE9)
  show(0x20AC)
  show(0x1F600)
  let neg: rune = -1
  show(neg)
  let five: rune = 5
  show(five - 6)
  show(five * 0x7FFFFFFF)
  show(0xD800)
  show(0xDFFF)
  show(0x110000)
  show(0x10FFFF)
  print("${string('x')}${string('é')}\n")

  let mixed = "aé€😀 hi"
  let rs = []rune(mixed)
  dump(rs)
  print("${string(rs) == mixed} ${len(string(rs))} ${len(mixed)}\n")

  dump([]rune(""))
  print("[${string([]rune(""))}]\n")

  let bs = []byte("a_b")
  bs[1] = 255
  dump([]rune(string(bs)))
  let tr = []byte("x_")
  tr[1] = 0xE2
  dump([]rune(string(tr)))
  let ov = []byte("__")
  ov[0] = 0xC0
  ov[1] = 0x80
  dump([]rune(string(ov)))

  let bad: []rune = [65, -1, 0xD800, 0x110000, 0x20AC]
  print("${hex(string(bad))}\n")

  let total = 0
  let i = 0
  while (i < 20000) {
    total = total + len(string([]rune("k${i}é")))
    i = i + 1
  }
  print("${total}\n")
}
