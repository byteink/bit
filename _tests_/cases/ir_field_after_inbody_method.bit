// ir
// #3810: pins gc_alloc's layout for a class whose in-body method sits
// between two real fields, at the IR level -- program OUTPUT cannot see
// this defect. See run_field_after_inbody_method.bit's own mutation note:
// both the write and the read of `b` resolve through the SAME
// (structFieldNodes-derived) index at every call site, so a phantom
// "field" inserted for the in-body method shifts `b`'s offset
// consistently in both directions and the printed round trip is correct
// either way. `gc_alloc size=16 ptrs=[]` below is the place this
// corruption IS externally observable: before #3762's fix
// (structFieldNodes counting the in-body method as a field) this class
// pinned size=24 ptrs=[%8] instead -- an extra 8 bytes and a bogus GC
// pointer slot, for a class with no pointer fields at all.
class Box {
  a: i64

  greet(): i64 {
    return this.a
  }

  b: i64
}

fn main() {
  let x = Box{ a: 11, b: 22 }
  x.b = 99
  print("${x.a} ${x.b}\n")
}
