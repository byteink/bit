// run
// #3105: `x * 2^k` strength-reduces to a left shift on both backends. A shift
// and a product agree on all 64 bits, so they agree on the low N bits of a
// narrow type too — but ONLY if the shifted result is re-narrowed exactly as
// the product was. These pin the wrapping that must survive the substitution:
// negative operands, and factors that push every significant bit out of the
// declared width. Every value below was produced by the pre-change compiler
// (the pinned 0.1.18 oracle) and must not move.
//
// The multiplies live in functions taking a parameter on purpose: a constant
// operand would be folded away in the optimizer and never reach the backend
// at all, leaving this file green while testing nothing.
//
// `7` and `-8` are here as the negative controls — neither is a positive power
// of two, so both must still emit a real multiply and must still agree.
fn mul2i32(x: i32): i32 { return x * 2 }
fn mul8i32(x: i32): i32 { return x * 8 }
fn mul256i32(x: i32): i32 { return x * 256 }
fn mul256i32c(x: i32): i32 { return 256 * x } // commuted: the constant is lhs
fn mul2i8(x: i8): i8 { return x * 2 }
fn mul8i8(x: i8): i8 { return x * 8 }
fn mul8i8c(x: i8): i8 { return 8 * x }
fn mul2u8(x: u8): u8 { return x * 2 }
fn mul128u8(x: u8): u8 { return x * 128 }
fn mul256u16(x: u16): u16 { return x * 256 }
fn mul8u32(x: u32): u32 { return x * 8 }
fn mul256i64(x: i64): i64 { return x * 256 }
fn mul7i64(x: i64): i64 { return x * 7 }
fn mulneg8i64(x: i64): i64 { return x * -8 }

fn main() {
  println("${mul2i32(i32(-1000000))} ${mul2i32(i32(2000000000))}")
  println("${mul8i32(i32(-1000000))} ${mul8i32(i32(2000000000))}")
  println("${mul256i32(i32(-1000000))} ${mul256i32c(i32(-1000000))}")
  println("${mul2i8(i8(-100))} ${mul2i8(i8(100))}")
  println("${mul8i8(i8(-100))} ${mul8i8c(i8(-100))}")
  println("${mul2u8(u8(200))} ${mul128u8(u8(3))}")
  println("${mul256u16(u16(60000))} ${mul8u32(u32(4000000000))}")
  println("${mul256i64(i64(-3))} ${mul7i64(i64(-3))} ${mulneg8i64(i64(-3))}")
}
