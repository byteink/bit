// lint exit=1
// #6232: `@json` used to read `Json`/`JsonEntry` on the user's behalf (#4497)
// — E0142 (classjson.bit) refused a `@json` class whose module did not import
// both names BY HAND, so this rule (E0210) had to special-case them as used,
// or the import E0142 had just demanded would report dead on the very next
// pass. #6232 removed the demand: the synthesized `toJson` body resolves
// `Json`/`JsonEntry` itself (`jsonClassImportDecls`), so a module never has to
// name either, and this rule needs no special case for them any more — an
// import of `Json`/`JsonEntry` written by hand for a `@json` class that never
// references them directly is an ordinary dead import now, reported like any
// other. `jsonEncode` is imported and genuinely unused too, and is the
// control: all three should report identically.
import { Json, JsonEntry, jsonEncode } from "std/json"

@json class User {
  export id: i64,
  export name: string,
}

fn main() {
  let u = User{ id = 1, name = "a" }
  print("${u.name}\n")
}
