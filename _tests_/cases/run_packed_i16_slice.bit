// run
// #7562: a `[]i16`/`[]u16` buffer is packed at 2 bytes per element, as C and
// Go lay it out, where it used to spend one 8-byte word per element. Every
// path that addresses an element must agree on the stride: the inline read
// and write, the runtime's get/set (the `op=` read) and append (one value,
// growth, a spread), a slice literal, a reslice's offset, `for of`, and
// `ptrOf`, whose `*(p + 1)` is the SECOND element only at a 2-byte stride.
// Negative values come from runtime arithmetic so the sign-extending load is
// exercised on a computed register, not a folded constant.
fn neg(n: int): int {
  return 0 - n
}

fn layout() {
  let xs = []i16{ 7, -2, 300, -32768 }
  let p = ptrOf(xs)
  println("ptr ${*p} ${*(p + 1)} ${*(p + 2)} ${*(p + 3)}")
  let w = []u16(3)
  w[0] = 0xffff
  w[1] = u16(neg(2))
  w[2] = 1
  let q = ptrOf(w)
  println("ptr ${*q} ${*(q + 1)} ${*(q + 2)}")
}

fn elems() {
  let h = []i16(4)
  h[0] = i16(neg(1))
  h[1] = 32767
  h[2] = i16(neg(300))
  h[3] = -32768
  h[0] /= 2
  h[1] -= 1
  h[2] >>= 1
  h[3] += 1
  println("i16 ${h[0]} ${h[1]} ${h[2]} ${h[3]}")
  let u = []u16(2)
  u[0] = 0xffff
  u[1] = 2
  u[0] >>= 4
  u[1] *= 3
  println("u16 ${u[0]} ${u[1]}")
}

fn grow() {
  let a: []i16 = []
  let i = 0
  while (i < 100) {
    a = append(a, i16(neg(i)))
    i = i + 1
  }
  let sum = 0
  for x of a {
    sum += int(x)
  }
  println("append ${len(a)} ${a[0]} ${a[1]} ${a[99]} ${sum}")
  let b = append(a[98:100], ...a[0:3])
  println("spread ${len(b)} ${b[0]} ${b[1]} ${b[2]} ${b[3]} ${b[4]}")
  let v = a[50:53]
  v[0] = 9
  println("reslice ${v[0]} ${v[1]} ${v[2]} ${a[50]} ${a[51]}")
}

fn main() {
  layout()
  elems()
  grow()
}
