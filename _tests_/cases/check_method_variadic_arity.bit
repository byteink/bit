// error
// #4671: a variadic METHOD call's ARITY and a misplaced spread's POSITION were
// never reported. `vCallAgainstFuncSig` (compiler/validateiface.bit) — the
// whole of a method or func-value call's argument judgement — reported E0050
// on its non-variadic arm only and never scanned for a spread at all, so
// `f.tag()` for `tag(label: string, ...xs: i64)` passed `bit check` rc=0 and
// died at IR verification with no diagnostic ("calls @tag$t57 with 2
// argument(s), but @tag$t57 declares 3"), and `f.bar(...ys, 3)` reached the
// lowerer's spanless E0092 catch-all instead of E0063 at the spread argument.
// #4661 closed the argument-TYPE half of the same function; this is the count
// and position half.
//
// Both rules are now the free path's own `vCallArity`/`vCallSpreadAt`
// (compiler/validatecall.bit), CALLED rather than restated: `vCallArity` is
// keyed on the callee's SHAPE (`want` parameters, variadic or not) instead of
// on a `CallDecl` the method path has no honest way to build, so the two
// cannot drift on the wording, the span, or on which shapes report both
// diagnostics. Every diagnostic below is byte-for-byte what the same call
// spelled as a free function produces.
//
// All four call shapes that reach that function are pinned, because one
// missing scan disabled all four: a variadic method short of its fixed prefix,
// a non-final spread on one, a spread aimed at a NON-variadic method (E0063
// and E0050 both, as the free path emits both), a spread past the rest
// parameter's own index, plus interface dispatch and a variadic FUNC VALUE
// (`vCallValue`'s tail, this function's other call site).
//
// `run_method_variadic_spread.bit`, `run_method_variadic_arity.bit`,
// `run_method_variadic_defer.bit` and `run_method_variadic_interface.bit` are
// the no-false-positive half: every legal variadic method call there still
// runs rc=0 with unchanged output.
interface Tagger {
  tag(label: string, ...xs: i64): int,
}

class Foo {
  tag(label: string, ...xs: i64): int { return len(label) + len(xs) }
  bar(...xs: i64): int { return len(xs) }
  one(x: i64): int { return int(x) }
}

fn tally(label: string, ...xs: i64): int { return len(label) + len(xs) }

fn viaIface(t: Tagger): int {
  return t.tag()
}

fn main() {
  let f = Foo{}
  let ys = [1, 2]
  let g = tally
  print("${f.tag()}\n")
  print("${f.bar(...ys, 3)}\n")
  print("${f.one(...ys)}\n")
  print("${f.tag("a", 1, ...ys)}\n")
  print("${g()}\n")
  print("${viaIface(f)}\n")
}
