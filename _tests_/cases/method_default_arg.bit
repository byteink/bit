// run
// #5315: SPEC §10.3 grants a defaulted trailing parameter no exemption for
// methods -- a call may omit it exactly as a free call may. Exercises both
// forms so a regression in either is caught: the free function pins #5244's
// existing behaviour, the method pins the fix.

fn freeFn(a: int, b: int = 7): int {
  return a + b
}

class C {
  export m(a: int, b: int = 7): int {
    return a + b
  }
}

fn main() {
  print("${freeFn(1)}\n")
  print("${freeFn(1, 2)}\n")
  let c = C{}
  print("${c.m(1)}\n")
  print("${c.m(1, 2)}\n")
}
