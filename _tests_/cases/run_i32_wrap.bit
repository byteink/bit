// run
// Signed narrow overflow wraps two's-complement (release-build semantics):
// i32 max + 1 == i32 min == -2147483648 (#1158). The result must be
// sign-extended back to width, not left as the bare 0x80000000 a full-width
// add produces (which would print as +2147483648).
fn main() {
  let a: i32 = 0x7FFFFFFF
  let s: i32 = a + 1
  print("${s}\n")
}
