// run
// #6432: a static call through a type parameter with several `&` bounds
// resolves against the bounds in written order (SPEC 11.3), like an instance
// member does. `T.tag()` is declared by the SECOND bound; it used to be looked
// up on the first bound only and was refused E0057.
interface Sized {
  static zero(): i64
}

interface Named {
  static tag(): string
}

class A {
  n: i64

  static zero(): i64 {
    return 0
  }

  static tag(): string {
    return "a"
  }
}

fn bad<T: Sized & Named>(): string {
  return T.tag()
}

fn both<T: Sized & Named>(): string {
  return "${T.zero()}${T.tag()}"
}

fn main() {
  println(bad<A>())
  println(both<A>())
}
