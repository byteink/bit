// run
// #4567: `jsonDecodeLenient<T>` — a decode that skips keys no field claims, at
// every level, in the single pass the strict decode already makes.
//
// `jsonDecUnknown` (stdlib/json/decode.bit) fails on the first unrecognised key
// and the synthesized decoder called it unconditionally, so there was no way to
// ask for a forgiving decode. `pkg/web`'s `Unknown.Ignore` implemented one by
// decoding, reading the `UnknownKey` failure, rebuilding the document without
// the one key its path named and decoding again — a whole decode and a whole
// tree rebuild per unknown key, which is quadratic on attacker-chosen input and
// was therefore capped at 32 keys, refusing a legitimate client that sent 33.
//
// The policy is now an argument threaded into the synthesized decoder
// (`__json_u`, compiler/classjsondecode.bit), so one decoder serves both entry
// points and the choice is made per CALL. `jsonDecode` is unchanged and is
// still what you get by default: a dropped field and an accepted one are
// indistinguishable to whoever sent the document.
//
// ALL THREE LEVELS ARE HERE because the policy has to reach the whole document:
// `x` at the top, `y` inside a nested object, `z` inside an array element. A
// policy applied only at the root would bind this document and still fail on
// `items[0].z`.
//
// `viaGeneric` is the composability half (#4563): a lenient call standing in a
// generic body retargets to a lenient wrapper of its own, so it stays lenient
// rather than silently becoming the strict decode the existing wrapper makes.
import { Json, JsonEntry, jsonDecode, jsonDecodeLenient, jsonParse } from "std/json"

@json class Addr {
  export city: string,
}

@json class Item {
  export sku: string,
}

@json class User {
  export id: i64,
  export addr: Addr,
  export items: []Item,
}

fn viaGeneric<T>(j: Json): T! {
  return jsonDecodeLenient<T>(j)?
}

fn doc(): Json! {
  return jsonParse(
      "{\"id\":1,\"x\":0,\"addr\":{\"city\":\"cairo\",\"y\":0}," +
      "\"items\":[{\"sku\":\"s1\",\"z\":0}]}",
  )?
}

// The strict decode's answer as one line: its refusal, or the binding it must
// not have made.
fn strictFailure(j: Json): string {
  let u = jsonDecode<User>(j) catch e {
    return e.message()
  }
  return "bound ${u.id}, which it must not"
}

fn main() {
  let j = doc() catch e {
    print("parse: ${e.message()}\n")
    return
  }
  let u = jsonDecodeLenient<User>(j) catch e {
    print("lenient: ${e.message()}\n")
    return
  }
  print("id=${u.id} city=${u.addr.city} sku=${u.items[0].sku}\n")

  let g = viaGeneric<User>(j) catch e {
    print("generic: ${e.message()}\n")
    return
  }
  print("generic id=${g.id} city=${g.addr.city} sku=${g.items[0].sku}\n")

  let n = nestedOnly() catch e {
    print("parse nested: ${e.message()}\n")
    return
  }
  let ln = jsonDecodeLenient<User>(n) catch e {
    print("lenient nested: ${e.message()}\n")
    return
  }
  print("nested id=${ln.id} city=${ln.addr.city} items=${len(ln.items)}\n")

  print("strict: ${strictFailure(j)}\n")
  print("strict nested: ${strictFailure(n)}\n")
}

// A document whose ONLY unknown key is two levels down, so the strict refusal
// has a dotted path to print rather than a bare top-level name.
fn nestedOnly(): Json! {
  return jsonParse(
    "{\"id\":2,\"addr\":{\"city\":\"giza\",\"y\":0},\"items\":[]}",
  )?
}
