// panic
// #4375, the identity of the LIMIT. The header proves `i < L` for one specific
// SSA value; an element load is only that same test when its right operand is
// that same value id. A SECOND, SHORTER slice indexed by the same `i` in the
// same body has a different limit, and the header says nothing about it.
//
// Both loads sit at the top of the body with no call between them, so the
// second one is a live candidate: it passes the index test (same `i`) and must
// be refused on its limit. A mutant that dropped the limit comparison marks it
// and reads element 3 of a two-element buffer — live heap, a plausible number,
// exit 0.
//
// `zero()` keeps both lengths out of reach of constant folding, so the refusal
// has to be made on value identity rather than on arithmetic the optimizer
// could have done itself.
import { args } from "std/os"

fn zero(): int { return len(args()) - 1 }

fn main() {
  let xs = [10, 20, 30, 40]
  let ys = []int(zero())
  ys = append(ys, 100)
  ys = append(ys, 200)
  let i = 0
  while (i < len(xs)) {
    let a = xs[i]
    let b = ys[i]
    eprint("i=${i} a=${a} b=${b}\n")
    i = i + 1
  }
  eprint("unreachable\n")
}
