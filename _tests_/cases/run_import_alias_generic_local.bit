// run
// #7482: an aliased import of a generic class declared in a project-local
// module (`import { Box as B }`, then `B<int>{...}`). The instantiation was
// keyed on the use-site spelling `B`, which the declaring module's typeDecls
// does not know, so the bare template came back and the methods were
// referenced under `init$t<template>` but never emitted: undefined symbol at
// link. The unaliased import is the control and must print the same.
import { Box as B, Box } from "./aliasgenericlib"

fn main() {
  let a = B<int>(7)
  let c = Box<int>(7)
  let old = a.swap(9)
  println("${old} ${a.get()} ${a.hits}")
  println("${c.get()} ${c.hits}")
  let s = B<string>("x")
  println("${s.swap("y")} ${s.get()}")
}
