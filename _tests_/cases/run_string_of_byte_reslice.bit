// run
// #6558: `string(b[lo:hi])` on a byte slice lowers to ONE
// `rt_call string_from_byte_range` instead of `slice_slice` feeding
// `string_from_bytes`. The value must be the bytes `lo..hi`, the receiver and
// both bounds must still be evaluated in reslice order (receiver, lo, hi), an
// omitted bound must still mean 0 / the receiver's length, and a temporary
// receiver held by nothing but the call must survive the copy's allocation.
// The panics are run_string_of_byte_reslice_{lo_gt_hi,hi_gt_cap}_panic.bit.

class Conn {
  rbuf: []byte,
}

fn conv(b: []byte, lo: int, hi: int): string {
  return string(b[lo:hi])
}

fn tick(tag: string, v: int): int {
  print("${tag} ")
  return v
}

fn recv(b: []byte): []byte {
  print("recv ")
  return b
}

fn fresh(i: int): []byte {
  return []byte("k${i}-payload")
}

fn main() {
  let b = []byte("hello")
  print("${string(b[1:3])}\n")
  print("${conv(b, 0, 5)}|${string(b[2:])}|${string(b[:2])}|[${string(b[3:3])}]\n")
  let e: []byte = []
  print("[${string(e[0:0])}]\n")
  let s = string(recv(b)[tick("lo", 1):tick("hi", 4)])
  print("${s}\n")
  let c = Conn{ rbuf = []byte("GET / HTTP/1.1") }
  let got = 3
  print("${string(c.rbuf[0:got])}\n")
  let grown = append([]byte("ab"), 99)
  print("${string(grown[1:3]) == "bc"}\n")
  let total = 0
  let i = 0
  while (i < 20000) {
    total = total + len(string(fresh(i)[1:4]))
    i = i + 1
  }
  print("${total}\n")
}
