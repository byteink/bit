// panic
// #4381: a NEGATIVE index on the inlined `[]u8` store. The inline sequence
// spells `index < 0 || index >= len` as ONE unsigned compare — a negative
// index reads as a huge unsigned and fails it — so this is not a second test
// that could be dropped independently, it is the half of the single test that
// a signed condition code (`lt` where `lo` belongs) silently loses.
//
// Losing it here writes one byte BELOW the buffer, over the allocation header
// of the object in front of it. That is the direction the read side cannot
// reach at all: a bad read returns a wrong byte, a bad write corrupts the
// collector's own metadata.
//
// The index is derived from `args()`, so nothing here folds at compile time.
import { args } from "std/os"

fn below(): int { return 0 - len(args()) }

fn main() {
  let bs = []u8(4)
  bs[0] = 11
  print("start len=${len(bs)}\n")
  bs[below()] = 200
  print("survived bs0=${int(bs[0])}\n")
}
