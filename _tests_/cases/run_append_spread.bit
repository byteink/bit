// run
// #5328: `append(dst, ...src)` raised E0092 at LOWERING — "cannot lower an
// expression form the lowerer does not yet handle" — for every element type,
// not a subset: `lowerAppend` (lowerappend.bit) never special-cased a
// `Tag.ArgSpread` trailing argument at all, so the one AST node standing for
// the whole spread reached `lowerExprH` as if it were an ordinary scalar
// expression. `bit check` accepted every program below; only lowering
// refused them. This fixture pins the boundary as it actually is (every
// element shape lowerAppend can reach: a word scalar, a reference `string`,
// a byte destination, a class/reference element, and a map element) rather
// than only the two shapes #5072's workaround needed.
class Pair { a: i64, b: i64 }

fn main() {
  // Word element, existing destination content preserved ahead of the spread.
  let dst = [10, 20]
  let src = [1, 2, 3, 4]
  dst = append(dst, ...src)
  print("ints: ${dst[0]} ${dst[1]} ${dst[2]} ${dst[3]} ${dst[4]} ${dst[5]} len=${len(dst)}\n")

  // An empty spread leaves the destination exactly as it was.
  let untouched = [7]
  untouched = append(untouched, ...[]int(0))
  print("empty: ${untouched[0]} len=${len(untouched)}\n")

  // string: a reference element, not the []u8 bytes-ambiguity shape.
  let strs = ["a"]
  let moreStrs = ["b", "c"]
  strs = append(strs, ...moreStrs)
  print("strings: ${strs[0]}${strs[1]}${strs[2]} len=${len(strs)}\n")

  // []u8: stride-1 destination, but a spread element is never read as the
  // string-bytes shape (that ambiguity is for a bare `string` ARGUMENT,
  // which a spread's own element never is) — pins the element-by-element
  // path fires here too.
  let bytes = [u8(65)]
  let moreBytes = [u8(66), u8(67)]
  bytes = append(bytes, ...moreBytes)
  print("bytes: ${string(bytes)} len=${len(bytes)}\n")

  // A class element (reference-typed slot, stride 8): proves this is not
  // #5320's generic-receiver mechanism, which never touches append at all.
  let pairs = [Pair{ a = 1, b = 2 }]
  let morePairs = [Pair{ a = 3, b = 4 }, Pair{ a = 5, b = 6 }]
  pairs = append(pairs, ...morePairs)
  print("pairs: ${pairs[0].a},${pairs[0].b} ${pairs[2].a},${pairs[2].b} len=${len(pairs)}\n")

  // map<K,V>: a reference element with no scalar representation at all.
  let maps = [map<string, int>{ "x": 1 }]
  let moreMaps = [map<string, int>{ "y": 2 }]
  maps = append(maps, ...moreMaps)
  print("maps: ${maps[0]["x"]} ${maps[1]["y"]} len=${len(maps)}\n")

  // Crosses a real capacity regrow (`slice_append`'s grow boundary), not just
  // the inline fast path lowerAppend's own header comment describes.
  let big = []int(0, 1)
  let manySrc = []int(0, 0)
  let i = 0
  while (i < 5000) {
    manySrc = append(manySrc, i)
    i = i + 1
  }
  big = append(big, ...manySrc)
  print("grow: len=${len(big)} first=${big[0]} last=${big[4999]}\n")

  // #7377: one bulk move per spread. Every byte count across the word
  // copy's edges (a partial word, exactly one word, many) and both growth
  // arms (`len + n` from empty, `2 * cap` from a non-empty destination).
  for n of [0, 1, 7, 8, 4096, 1 << 20] {
    byteSpread(n)
  }
  overlap()
}

// Appends `n` patterned bytes after a 3-byte prefix; the weighted sum pins
// every byte's value AND position, which a count alone would not.
fn byteSpread(n: int) {
  let src = []u8(n)
  let i = 0
  while (i < n) {
    src[i] = u8(i * 7 + 3)
    i = i + 1
  }
  let dst = [u8(9), u8(8), u8(7)]
  dst = append(dst, ...src)
  let sum = 0
  i = 0
  while (i < len(dst)) {
    sum = sum + int(dst[i]) * (i + 1)
    i = i + 1
  }
  print("bytes ${n}: len=${len(dst)} sum=${sum}\n")
}

// A spread whose source views the destination's own buffer appends what the
// source held AT THE CALL (memmove semantics). `append(s, ...s)` with spare
// capacity used to never terminate: the per-element loop re-read `len(src)`
// of the very header it was growing in place.
fn overlap() {
  let s = []u8(0, 64)
  s = append(s, u8(1), u8(2), u8(3))
  s = append(s, ...s)
  print("self: ${string(digits(s))} len=${len(s)}\n")
  // Source BELOW the destination, overlapping: the case an upward copy breaks.
  let t = s[0:2]
  t = append(t, ...s[1:5])
  print("down: ${string(digits(t))}\n")
  // The same with both ends 8-aligned and a partial tail (19 = 2 words + 3).
  let w = []u8(0, 64)
  let i = 0
  while (i < 27) {
    w = append(w, u8(i % 10))
    i = i + 1
  }
  let w8 = w[0:8]
  w8 = append(w8, ...w[0:19])
  print("words: ${string(digits(w8))}\n")
  // An []i64 (stride 8) and a reference element, both into themselves.
  let ints = []i64(0, 16)
  ints = append(ints, 5, 6, 7, 8, 9)
  let it = ints[0:2]
  it = append(it, ...ints[1:5])
  print("i64: ${it[0]}${it[1]}${it[2]}${it[3]}${it[4]}${it[5]}\n")
  ints = append(ints, ...ints)
  print("i64 self: len=${len(ints)} ${ints[4]}${ints[5]}${ints[9]}\n")
  let strs = []string(0, 8)
  strs = append(strs, "x", "y")
  strs = append(strs, ...strs)
  print("strs: ${strs[0]}${strs[1]}${strs[2]}${strs[3]} len=${len(strs)}\n")
}

fn digits(b: []u8): []u8 {
  let out = []u8(0, len(b))
  for x of b {
    out = append(out, u8(48) + x)
  }
  return out
}
