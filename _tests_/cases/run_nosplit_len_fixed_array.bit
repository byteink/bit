// run
// #3974: `len`/`cap` over a FIXED-SIZE array lower to the array's declared
// length as a compile-time Op.ConstInt (lowerprim.bit's `lowerLen`) — the
// argument is not even evaluated, so like the `run_nosplit_const_array_read`
// index case, there is no call and no safepoint. The @nosplit allowlist
// admits both builtins for this operand type only (a slice/map/string
// argument stays E0075 — see check_nosplit_len_slice/_map/_string.bit).
// Single-file golden: no prelude.
@nosplit fn arrLen(): int {
  let a: [3]i64
  return len(a)
}

@nosplit fn arrCap(): int {
  let a: [3]i64
  return cap(a)
}

fn main() {
  if (arrLen() == 3 && arrCap() == 3) {
    print("nosplit-len-fixed-array-ok\n")
  }
}
