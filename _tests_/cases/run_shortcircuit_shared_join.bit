// run
//
// #4461, arm A. `computeDeadBoundsBlocks` (arm64branch.bit) used to mark a
// redundant `br`'s else-block dead on that one edge's evidence. `&&` lowers
// its short-circuit join as exactly that else-target (lowercond.bit), and a
// join ALWAYS has a second predecessor — the rhs block's jump — so the join's
// own terminator, which is the `x` test itself, was never emitted and the
// then-arm ran unconditionally. `g(1, 2, false)` returned 1.
//
// The outer `if (c)` is what makes the inner `br` foldable: it tests the same
// `c`, and the inner block is reached only through its TRUE edge. `noise`
// exists solely to keep `g` out of the inliner — inlined, `g` is compiled
// again on different IR and comes out right, which is why a smaller program
// hides this.
fn noise(n: int): int {
  let t = 0
  let i = 0
  while (i < n) {
    t = t + i * 3 - (i / 2) + (i % 7)
    i = i + 1
  }
  return t
}

fn g(a: int, b: int, x: bool): int {
  let c = a < b
  if (c) {
    if (c && x) {
      return 1 + noise(a) - noise(a)
    }
    return 2 + noise(b) - noise(b)
  }
  return 3 + noise(a) - noise(a)
}

fn main() {
  // c true, x false -> the inner `&&` is false -> 2. This is the miscompiled one.
  print("g(1,2,false)=${g(1, 2, false)}\n")
  // c true, x true -> 1. The then-arm, reached legitimately.
  print("g(1,2,true)=${g(1, 2, true)}\n")
  // c false -> 3. The outer else, which the fold never touches.
  print("g(2,1,false)=${g(2, 1, false)}\n")
}
