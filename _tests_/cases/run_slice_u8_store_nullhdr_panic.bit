// panic
// #4381: storing into a zeroed class's `[]u8` field. The field holds the NULL
// WORD, not an empty header (SPEC §13.4, #1564/#1570), which is the arm
// `bit_rt_slice_set` spells as an explicit `if (h == 0)` before it looks at a
// length. run_slice_store_nullfield_panic.bit is the `[]int` twin.
//
// The inline lowering has NO `h == 0` test: it relies on `slice_len` reading a
// null header as 0, so every index fails the bounds compare and reaches the
// same panic. Drop that null-safe read and this stops being this panic — the
// store would compute `buf + off + index` from two words read out of the null
// page and write there, which on this platform is exit 11 and on a target with
// page zero mapped is a wild one-byte store into whatever lives at address
// `index`.
import { args } from "std/os"

class Z { bs: []u8, n: int }

fn zero(): int { return len(args()) - 1 }

fn main() {
  let z = Z{}
  print("start len=${len(z.bs)}\n")
  z.bs[zero()] = 200
  print("unreachable\n")
}
