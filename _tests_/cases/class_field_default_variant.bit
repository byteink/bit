// run
// #6698 (SPEC §10.5): a payload-free enum variant - `Option.None`, `Color.Red` -
// is a legal class-field default, for a plain class and for a generic one, and
// an explicit value at the construction site still wins.
enum Color {
  Red,
  Green,
  Blue,
}

enum Shade {
  Light,
  Dark,
}

class Paint {
  o: Option<string> = Option.None,
  c: Color = Color.Green,
  nested: Option<Color> = Option.None,
  n: int = 7,
}

class Box<T> {
  v: Option<T> = Option.None,
  s: Shade = Shade.Dark,
}

fn show(o: Option<string>): string {
  match (o) {
    Some(s) => return "some ${s}"
    None => return "none"
  }
}

fn showColor(o: Option<Color>): string {
  match (o) {
    Some(c) => return "some ${colorName(c)}"
    None => return "none"
  }
}

fn colorName(c: Color): string {
  match (c) {
    Red => return "red"
    Green => return "green"
    Blue => return "blue"
  }
}

fn shadeName(s: Shade): string {
  match (s) {
    Light => return "light"
    Dark => return "dark"
  }
}

fn showInt(o: Option<int>): string {
  match (o) {
    Some(v) => return "some ${v}"
    None => return "none"
  }
}

fn main() {
  let d = Paint{}
  print("${show(d.o)} ${colorName(d.c)} ${showColor(d.nested)} ${d.n}\n")

  let e = Paint{ o = Option.Some("x"), c = Color.Blue, nested = Option.Some(Color.Red) }
  print("${show(e.o)} ${colorName(e.c)} ${showColor(e.nested)} ${e.n}\n")

  let z: Paint
  print("${show(z.o)} ${colorName(z.c)} ${showColor(z.nested)}\n")

  let arr = []Paint(2)
  print("${show(arr[1].o)} ${colorName(arr[1].c)}\n")

  let b = Box<int>{}
  print("${showInt(b.v)} ${shadeName(b.s)}\n")

  let b2 = Box<string>{ v = Option.Some("hi"), s = Shade.Light }
  print("${show(b2.v)} ${shadeName(b2.s)}\n")
}
