// run
// #4371: `append(dst, s)`'s bulk byte path (`rt_call slice_append_str`) has
// the SAME ALIASING CONTRACT as `append`'s element path (spec/LINT.md E0214,
// runtime/root/slices.bit): the header is mutated in place and returned, so a
// fit-in-capacity append is observed through every name bound to it, and a
// grow reallocates from the current view — which un-aliases the two at exactly
// the point `rtSliceAppend` un-aliases them.
//
// That contract is OBSERVABLE, so a faster append must not move it. This case
// is the byte-append sibling of run_append_alias_inline.bit and pins the same
// five things: which header comes back, which buffer the bytes land in, what a
// non-zero `off` does, when the reallocation happens, and what a null header
// does instead.
fn main() {
  // Same header back: both names see the new length and the bytes, because
  // `rtSliceAppendStr` mutates in place when the string fits.
  let a = []byte(0, 8)
  let b = append(a, "hi")
  print("header: a=${len(a)} b=${len(b)} cap=${cap(a)} a0=${a[0]} a1=${a[1]}\n")

  // Shared buffer through a reslice: `v` views `c`'s buffer with room to
  // spare, so appending through `v` writes into `c`'s slots 1 and 2.
  let c = []byte(4, 8)
  c[0] = byte(65)
  c[1] = byte(66)
  c[2] = byte(67)
  c[3] = byte(68)
  let v = c[0:1]
  let v2 = append(v, "xy")
  print("alias:  c=${string(c)} v2=${string(v2)} v2cap=${cap(v2)}\n")

  // Non-zero `off`: the view starts at element 2, so the bytes land at buffer
  // indices 3 and 4 — index 3 overwrites c[3], index 4 is past c's length.
  let w = c[2:3]
  let w2 = append(w, "pq")
  print("offset: c3=${c[3]} w2=${string(w2)} w2len=${len(w2)}\n")

  // The grow boundary. `g` is len 2 cap 2, so a 3-byte string cannot fit and
  // the buffer is reallocated ONCE to max(2*cap, len+n) == max(4, 5) == 5.
  // `g` and `g2` are the SAME header — the reallocation replaces the buffer
  // word inside it — so `g` reads the new length and the new bytes too. What
  // a grow un-aliases is any earlier VIEW of the old buffer, which is the
  // reslice case above, not this one.
  let g = []byte(2, 2)
  g[0] = byte(49)
  g[1] = byte(50)
  let g2 = append(g, "abc")
  g2[0] = byte(90)
  print("grow:   g=${string(g)} g2=${string(g2)} g2cap=${cap(g2)} glen=${len(g)}\n")

  // g2 is now len 5 cap 5, so one more byte grows again — to max(10, 6) == 10,
  // which is the `2 * cap` arm rather than the `len + n` one. Both arms are
  // exercised, and the amortized doubling a loop of appends relies on is what
  // that arm preserves.
  let g3 = append(g2, "d")
  print("regrow: g3=${string(g3)} g3cap=${cap(g3)} g2len=${len(g2)}\n")

  // A null header (a zeroed class's slice field is the null word) has no
  // buffer, so `appendTarget` allocates a FRESH header and the original
  // binding still reads empty.
  let n: []byte = []
  let n2 = append(n, "new")
  print("null:   nlen=${len(n)} n2=${string(n2)} n2cap=${cap(n2)}\n")

  // The empty string appends nothing and still returns a usable header — a
  // null destination must come back as a real, appendable slice, not 0.
  let z: []byte = []
  let z2 = append(z, "")
  z2 = append(z2, "ok")
  print("empty:  z2=${string(z2)} z2len=${len(z2)}\n")

  // The bytes must survive a collection: the destination is a plain byte
  // buffer, but the SOURCE string is a heap object live across the call.
  let s = "keep me"
  let k = append([]byte(0, 0), s)
  let junk: []int = []
  let i = 0
  while (i < 20000) {
    junk = append(junk, i)
    i = i + 1
  }
  print("gc:     k=${string(k)} junk=${len(junk)}\n")
}
