// run
// #6092: `append(dst, s)`'s bulk byte path (`rt_call slice_append_str`) has
// the SAME FIX as `append`'s element path (runtime/root/slices.bit's
// `rtSliceAppendStr`): a non-null `dst` never has its own header mutated any
// more, so `dst` (and any earlier result built from it) must keep its own
// length no matter how many further appends run off the same base. This case
// is the byte-append sibling of run_append_alias_inline.bit and pins the
// same shapes: which header comes back, which buffer the bytes land in, what
// a non-zero `off` does, when a reallocation happens, and what a null header
// does instead.
//
// Buffer sharing on spare capacity is UNCHANGED and still Go's documented
// hazard: two results built from the same base can still overwrite each
// other's newly written bytes in unused capacity. What #6092 fixed is that a
// LENGTH change on one result can never again bleed into another's header.
fn main() {
  // Spare capacity, no grow: `a` keeps its own (unchanged) length; the bytes
  // are only readable through `b`.
  let a = []byte(0, 8)
  let b = append(a, "hi")
  print("header: alen=${len(a)} blen=${len(b)} acap=${cap(a)} b0=${b[0]} b1=${b[1]}\n")

  // Shared buffer through a reslice: `v` views `c`'s buffer with room to
  // spare, so appending through `v` writes into `c`'s slots 1 and 2 — but
  // `v` itself keeps its own length (1, not 3).
  let c = []byte(4, 8)
  c[0] = byte(65)
  c[1] = byte(66)
  c[2] = byte(67)
  c[3] = byte(68)
  let v = c[0:1]
  let v2 = append(v, "xy")
  print("alias:  c=${string(c)} vlen=${len(v)} v2=${string(v2)} v2cap=${cap(v2)}\n")

  // Non-zero `off`: the view starts at element 2, so the bytes land at buffer
  // indices 3 and 4 — index 3 overwrites c[3]. `w` itself keeps length 1.
  let w = c[2:3]
  let w2 = append(w, "pq")
  print("offset: c3=${c[3]} wlen=${len(w)} w2=${string(w2)} w2len=${len(w2)}\n")

  // The grow boundary. `g` is len 2 cap 2, so a 3-byte string cannot fit and
  // the buffer is reallocated to max(2*cap, len+n) == max(4, 5) == 5 — into a
  // BRAND-NEW buffer. `g` keeps its ORIGINAL buffer untouched, so writing
  // through `g2` must not move what `g` reads.
  let g = []byte(2, 2)
  g[0] = byte(49)
  g[1] = byte(50)
  let g2 = append(g, "abc")
  g2[0] = byte(90)
  print("grow:   g=${string(g)} g2=${string(g2)} g2cap=${cap(g2)} glen=${len(g)}\n")

  // g2 is now len 5 cap 5, so one more byte grows again — to max(10, 6) == 10.
  // `g2` itself must still keep its OWN length (5), not `g3`'s (6).
  let g3 = append(g2, "d")
  print("regrow: g3=${string(g3)} g3cap=${cap(g3)} g2len=${len(g2)}\n")

  // A null header (a zeroed class's slice field is the null word) has no
  // buffer, so `appendTarget` allocates a FRESH header nobody else can reach
  // — mutating it in place remains sound and unchanged.
  let n: []byte = []
  let n2 = append(n, "new")
  print("null:   nlen=${len(n)} n2=${string(n2)} n2cap=${cap(n2)}\n")

  // The empty string appends nothing and still returns a usable header — a
  // null destination must come back as a real, appendable slice, not 0.
  let z: []byte = []
  let z2 = append(z, "")
  z2 = append(z2, "ok")
  print("empty:  z2=${string(z2)} z2len=${len(z2)}\n")

  // The bytes must survive a collection: the destination is a plain byte
  // buffer, but the SOURCE string is a heap object live across the call.
  let s = "keep me"
  let k = append([]byte(0, 0), s)
  let junk: []int = []
  let i = 0
  while (i < 20000) {
    junk = append(junk, i)
    i = i + 1
  }
  print("gc:     k=${string(k)} junk=${len(junk)}\n")
}
