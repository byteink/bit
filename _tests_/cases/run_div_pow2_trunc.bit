// run
// #3104: aarch64 gained the power-of-two divisor fast path x86-64 has had
// since #1702, so `x / 8` is now a shift pair instead of a real `sdiv` on both
// backends. This pins the one property the shift form is easy to get wrong:
// signed division truncates TOWARD ZERO (SPEC section 13.5), while a bare
// arithmetic right shift rounds toward negative infinity. Drop the
// sign-dependent `2^k - 1` bias and (-9)/8 comes out -2 instead of -1, and
// (-1)/8 comes out -1 instead of 0 — a silent one-off on every negative
// dividend, on every program, not a crash.
//
// Every dividend is a genuine runtime value (an array load indexed by a loop
// counter, or a loop-carried variable), never a literal: optfold.bit's
// foldBinaryArith folds a `/` whose OPERANDS are already ConstInt nodes, so a
// literal dividend never reaches codegen at all and this would be testing the
// constant folder instead of the backend.
//
// The `/ -8`, `/ 7` and `/ 1` lines are here on purpose: xConstPow2Divisor
// declines a negative divisor, a non-power-of-two and 1, so all three must
// still take the real divide — and must agree with the fast path's neighbours
// at every dividend, which is what makes the two paths comparable side by side.
//
// The last two lines are unsigned. `u64` division is a plain logical right
// shift with no bias, and the all-ones dividend is the discriminator between
// the two shifts: `lsr` gives 2305843009213693951, an `asr` would give the
// dividend straight back.
fn main() {
  let a: [8]i64 = [8]i64{-9, -8, -7, -1, 0, 1, 7, 8}

  let i = 0
  while (i < 8) {
    print("${a[i] / 8} ")
    i = i + 1
  }
  print("\n")

  i = 0
  while (i < 8) {
    print("${a[i] / 2} ")
    i = i + 1
  }
  print("\n")

  i = 0
  while (i < 8) {
    print("${a[i] / -8} ")
    i = i + 1
  }
  print("\n")

  i = 0
  while (i < 8) {
    print("${a[i] / 7} ")
    i = i + 1
  }
  print("\n")

  i = 0
  while (i < 8) {
    print("${a[i] / 1} ")
    i = i + 1
  }
  print("\n")

  let u: u64 = 0
  while (u < 20) {
    print("${u / 8} ")
    u = u + 3
  }
  print("\n")

  // 2^64 - 1, built at runtime so it survives to codegen.
  let all: u64 = 0
  let step = 0
  while (step < 64) {
    all = all + all + u64(1)
    step = step + 1
  }
  print("${all / 8}\n")
}
