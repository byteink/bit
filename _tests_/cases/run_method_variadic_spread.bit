// run
// #4439: spreading a `[]T` into a class method's variadic parameter used to
// hit E0092 (unlowerable) at every arity. It must build the SAME single
// `[]T` slot a positional variadic call does, at an empty and a nonempty
// spread.
class Foo {
  x: int
  bar(...args: string): string { return "n=${len(args)}" }
}
fn call0(f: Foo): string {
  let xs = []string(0)
  return f.bar(...xs)
}
fn call3(f: Foo): string {
  let xs = []string{ "a", "b", "c" }
  return f.bar(...xs)
}
fn main() {
  let f = Foo{ x: 1 }
  print(call0(f))
  print("\n")
  print(call3(f))
  print("\n")
}
