// run
// #4424: a `string` returned to a DEFERRED call, whose result is discarded.
//
// `defer f(...)` resolves its target once and replays the same `Op.Call` at
// every exit of the enclosing function. Nothing reads the result — but the
// instruction still carries a TYPE, and that type is what codegen asks whether
// the return register holds a traced reference. Under the flip the register
// holds word 0 of a `string` — an interior `ptr` — so `deferredResultTy`
// (`lowerdefer.bit`) types the instruction as the word rather than as the
// aggregate, exactly as `synthSpawnTrampoline` already does for a spawned
// call. Measured gate-off on a deferred `(i64, i64)`: the wrong type kept the
// discarded word in a callee-saved register and listed it as a live root, at
// 2 instructions, a register and 16 frame bytes. This is the third of the
// three positions that bind a call result away from a direct call site.
//
//   order       defers run last-in-first-out at each exit
//   arms        a defer registered on one arm of a branch runs only on that arm
//   args        the deferred call's ARGUMENTS are saved at the defer site and
//               replayed at the exit, from outside the block that built them
//   nested      an inner function's own defers run before its caller's, so two
//               frames' worth of discarded `string` results are live at once
fn note(s: string): string {
  print("[${s}]\n")
  return s + "!"
}

fn body(n: int): string {
  defer note("exit${n}")
  let s = "abcdefghij"
  if (n > 0) {
    defer note(s[0:3])
    return note(s[2:6])
  }
  return note(s[4:8])
}

fn outer(): string {
  defer note("outer")
  return body(1) + body(0)
}

fn main() {
  print("one ${body(1)}\n")
  print("zero ${body(0)}\n")
  print("nested ${outer()}\n")
}
