// run
// #4053: LICM lifts `field_get xs[0]` — the slice element-BUFFER pointer — into
// the loop preheader, which runs before the guard is ever tested. `n` is 0 and
// then negative here, so the body never executes, and `xs` is the NULL header a
// zeroed class's slice field holds (#1564, SPEC §13.4) rather than an empty one.
//
// Speculating a header word on a null receiver has to read 0, not fault. Both
// backends route a slice-based `field_get` through `emitHeaderWordOrZero`
// (`isHeaderBase`, codegen.bit), and that null-safe path is exactly what makes
// offset 0 speculable at all — the same property `slice_len` and `field_get`
// at +8/+16/+24 already relied on for #4051.
//
// The `-5` call is the second half: a negative bound also fails the guard, so
// the preheader's three hoisted reads (`slice_len`, `buf`, `off`) are the only
// thing that touches the null header on either call.
class Box { xs: []i64, tag: i64 }

fn total(xs: []i64, n: int): int {
  let t = 0
  let i = 0
  while (i < n) {
    t = t + xs[i]
    i = i + 1
  }
  return t
}

fn main() {
  let boxes = []Box(1)
  let b = boxes[0]
  print("${total(b.xs, 0)} ${total(b.xs, -5)} ${len(b.xs)} ${b.tag}\n")
}
