// run
// #5876: a value narrower than the tuple field it is stored into -- `s[i]` is
// `u8` (SPEC §12.2) -- must be converted to the field's own declared type at
// the STORE (`buildTupleIn`, lowertuple.bit; `fieldSetRhsTarget`,
// optfold.bit), because the optimizer's widening-alias fold
// (`convertAliasesSource`, optfoldconvert.bit) can retype that stored value
// back to its narrow producer after lowering. Getting the extension
// direction wrong -- sign-extending an UNSIGNED `u8` (195 would read back as
// -61) or zero-extending a SIGNED negative `i32` -- prints a wrong value at
// exit 0 (the #4412 class), so this checks printed VALUES, not just whether
// a `gc_alloc` survives (`ir_tuple_layout.bit` covers that side).
//
// Three members keeps `boxedTriple`'s tuple boxed on every target -- see
// `ir_tuple_layout.bit`'s `narrow`, the same shape -- so its field reads run
// through real memory rather than two spilled registers. `explodedPair`'s
// two word-sized members are the shape #4405/#5871 pass back in registers
// with no box at all once forwarding answers both reads -- the same VALUES
// must still come out right once the allocation is gone.
fn boxedTriple(s: string, i: int): (int, i32, bool) {
  return int(s[i]), i32(s[i]) - 200, s[i] > 0x7f
}

fn explodedPair(s: string, i: int): (int, bool) {
  return int(s[i]), s[i] > 0x7f
}

fn main() {
  let lo = "A"      // 0x41 = 65, <= 0x7f
  let hi = "\u{E9}" // UTF-8 0xC3 0xA9: byte 0 is 0xC3 = 195, > 0x7f

  let (n1, s1, big1) = boxedTriple(lo, 0)
  print("boxed lo ${n1} ${s1} ${big1}\n")
  let (n2, s2, big2) = boxedTriple(hi, 0)
  print("boxed hi ${n2} ${s2} ${big2}\n")

  let (n3, big3) = explodedPair(lo, 0)
  print("exploded lo ${n3} ${big3}\n")
  let (n4, big4) = explodedPair(hi, 0)
  print("exploded hi ${n4} ${big4}\n")
}
