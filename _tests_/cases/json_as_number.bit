// run
// stdlib/json/value.bit's jsonAsNumber (#2287). JSON has one number type —
// `3` and `3.0` are the same document to every producer on the wire — so an
// f64-typed field must read the same whichever way it was spelled, unlike
// jsonAsFloat alone, which rejects the integral spelling.
//
// Covers both numeric spellings (JsonInt, JsonFloat), negative zero (its own
// float-formatting corner case, observed rather than predicted here), and
// three non-number shapes — string, bool, null — that must yield None, not
// a panic.
import { jsonParse, jsonAsNumber } from "std/json"

fn printNumber(label: string, source: string) {
  let parsed = jsonParse(source) catch e {
    print("${label}=parse failed: ${e.message()}\n")
    return
  }
  match (jsonAsNumber(parsed)) {
    Some(f) => print("${label}=Some(${f})\n")
    None => print("${label}=None\n")
  }
}

fn main() {
  printNumber("int", "3")
  printNumber("float", "3.5")
  printNumber("negzero", "-0.0")
  printNumber("string", "\"3\"")
  printNumber("bool", "true")
  printNumber("null", "null")
}
