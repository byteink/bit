// run
// #6990: an interface may require FIELDS. A class satisfies `id: string` with
// its own field of the identical type, nothing declares the relationship, and
// the field is read through the interface value. Fields and methods mix, a
// slice field and a generic class work the same way, and an unrelated field
// (`secret`, which no interface names) is untouched.
interface Subject {
  id: string,
  roles: []string,
  label(): string,
}

interface Tagged<T> {
  tag: T,
}

class User {
  export id: string
  export roles: []string
  secret: string
  label(): string { return "user:" + this.id }
}

class Bot {
  export id: string
  export roles: []string
  export version: i64
  label(): string { return "bot" }
}

class Pair<T> {
  export tag: T,
}

fn describe(s: Subject): string {
  return "${s.id} [${len(s.roles)}] ${s.label()}"
}

fn main() {
  let u = User{ id = "u1", roles = ["admin", "dev"], secret = "x" }
  let all: []Subject = [u, Bot{ id = "b1", roles = []string(0), version = 3 }]
  for s of all {
    print("${describe(s)}\n")
  }
  let t: Tagged<i64> = Pair<i64>{ tag = 7 }
  print("${t.tag + 1}\n")
  let w: Tagged<string> = Pair<string>{ tag = "seven" }
  print("${w.tag}\n")
  u.id = "u2"
  print("${describe(u)}\n")
}
