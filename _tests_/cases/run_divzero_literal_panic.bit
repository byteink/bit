// panic
// #4361: `n / 0` where the divisor is a compile-time LITERAL zero must still
// panic (SPEC section 13.5, section 18.4). `run_divzero_panic.bit` covers the
// runtime-divisor path; this covers the constant one, which is a different
// code path since #4361 folds the zero-check away for any divisor
// `xDivisorPlan` proves non-zero.
//
// A wrong fold here is silent, not loud: `bit_rt_panic_div_zero` disappears
// and `sdiv xd, xn, xzr` returns 0 on aarch64, so the program prints `div=0`
// and exits 0. Nothing else in the suite would name it -- `run_divzero_panic`
// passes either way, because its divisor is never a constant.
//
// The dividend comes from `len(args())` so the operand pair is not both
// ConstInt and optfold.bit's foldBinaryArith cannot evaluate the division at
// compile time; only the divisor is a literal, which is exactly the shape
// under test.
import { args } from "std/os"

fn seven(): int { return len(args()) + 6 }

fn main() {
  print("start\n")
  print("div=${seven() / 0}\n")
  print("unreachable\n")
}
