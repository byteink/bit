// run
// #6431: a member call on a type parameter resolves against every bound of an
// `&` list. `label` is declared only by the SECOND bound and `tag` only by the
// THIRD, so the call is typed by that bound and prints its value; before, both
// were typed `<error>`, which `bit check` accepted for any use of the result.
interface Sized {
  size(): i64,
}

interface Named {
  label(): string,
}

interface Tagged {
  tag(): i64,
}

class A {
  n: i64

  size(): i64 {
    return this.n
  }

  label(): string {
    return "a${this.n}"
  }

  tag(): i64 {
    return this.n * 10
  }
}

fn second<S: Sized & Named>(s: S): string {
  return s.label() + "/" + "${s.size()}"
}

fn third<S: Sized & Named & Tagged>(s: S): i64 {
  return s.size() + s.tag() + len(s.label())
}

fn main() {
  println(second(A{ n = 4 }))
  println("${third(A{ n = 4 })}")
}
