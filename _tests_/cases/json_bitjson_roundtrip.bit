// run
// #1479's own gate: cstParse (#1723) a realistically commented `bit.json`
// manifest, cstSetString (#1725) one dependency's pinned version, cstPrint
// (#1726) it, assert every comment survives, every untouched key's
// formatting/order is unchanged, and only the one mutated line differs.
//
// Used to redeclare the comment-emitting lexer, #1720's CST types, #1723's
// parser, #1725's edit fn and #1726's printer locally on the stated belief
// that "a golden case is single-file with no prelude and cannot import
// std/json" (see json_cst_parse_trivia.bit). That belief is false (#2421):
// `_tests_/bit/golden.bit`'s `checkRun` runs `bit build <case>` with
// `BIT_STDLIB` exported, so the import below resolves exactly as it would
// for any other caller. The local copy's `gapForIndex` had also drifted from
// the module's (#2351): the module excludes BOTH edge boundaries (`i == 0`
// and the tail, `i == len(gaps) - 1`) from comma synthesis, so a `None` gap
// there never grows a trailing comma, but the local copy only excluded
// `i == 0`. This test's edit only replaces an EXISTING key's value, so no
// gap is ever `None` here and the output is unchanged -- noted because a
// future edit to this case that appends a new key would otherwise silently
// depend on the stale behaviour.
//
// `source`/`want` below must stay byte-identical to the committed sibling
// fixtures json_bitjson_roundtrip_{fixture,expected}.jsonc (#1480 points
// `bit add`'s tests at those; the harness only runs *.bit, so this embedded
// copy is what actually executes, kept in sync by hand).
import { cstParse, cstSetString, cstPrint } from "std/json"

// --- assertion helpers -------------------------------------------------

// True if `needle` occurs anywhere in `haystack`. Bounded by `len(haystack)`.
fn containsSubstr(haystack: string, needle: string): bool {
  let hn = len(haystack)
  let nn = len(needle)
  if (nn == 0) {
    return true
  }
  let i = 0
  while (i + nn <= hn) {
    if (haystack[i:i + nn] == needle) {
      return true
    }
    i = i + 1
  }
  return false
}

// --- test ------------------------------------------------------------------
// `want` is `source` with exactly "1.9.4" -> "1.9.5" changed (verified by
// construction against the committed .jsonc pair), so the byte-for-byte
// equality check below is itself the "only the one mutated line differs"
// assertion: any other drift makes `printed` diverge from this exact string.

fn main() {
  // Identical to _tests_/cases/json_bitjson_roundtrip_fixture.jsonc.
  let source = "// bit.json -- package manifest for this module.\n// See docs/reference/bitjson.md for the full schema.\n{\n  \"name\": \"widget\",\n  \"version\": \"0.4.2\",\n  /* Build settings control which target triples `bit build --release`\n     produces; see docs/reference/build.md. */\n  \"build\": { // native unless a triple is given\n    \"target\":   \"native\",\n    \"optimize\": \"release\"\n  },\n  \"dependencies\": {\n    \"std/json\": \"^1.2.0\",\n    // pinned: 2.0 renamed `dial` to `dialTimeout`; not yet migrated here.\n    \"std/net\": \"1.9.4\",\n    \"std/crypto\": \"^3.1.0\",\n  },\n  \"devDependencies\": {\n    \"std/testing\": \"^1.0.0\"\n  }\n}\n// end of manifest"
  // Identical to _tests_/cases/json_bitjson_roundtrip_expected.jsonc.
  let want = "// bit.json -- package manifest for this module.\n// See docs/reference/bitjson.md for the full schema.\n{\n  \"name\": \"widget\",\n  \"version\": \"0.4.2\",\n  /* Build settings control which target triples `bit build --release`\n     produces; see docs/reference/build.md. */\n  \"build\": { // native unless a triple is given\n    \"target\":   \"native\",\n    \"optimize\": \"release\"\n  },\n  \"dependencies\": {\n    \"std/json\": \"^1.2.0\",\n    // pinned: 2.0 renamed `dial` to `dialTimeout`; not yet migrated here.\n    \"std/net\": \"1.9.5\",\n    \"std/crypto\": \"^3.1.0\",\n  },\n  \"devDependencies\": {\n    \"std/testing\": \"^1.0.0\"\n  }\n}\n// end of manifest"

  let root = cstParse(source) catch e {
    print("parse-error: ${e.message()}\n")
    return
  }

  let updated = cstSetString(root, []string{ "dependencies", "std/net" }, "1.9.5") catch e {
    print("set-error: ${e.message()}\n")
    return
  }

  let printed = cstPrint(updated)

  // Every comment in the fixture -- both `//` lines, the `/* */` block, and
  // the version-pin comment above the edited dependency -- must survive the
  // edit verbatim.
  let allCommentsPresent = containsSubstr(printed, "// bit.json -- package manifest for this module.") &&
    containsSubstr(printed, "// See docs/reference/bitjson.md for the full schema.") &&
    containsSubstr(printed, "/* Build settings control which target triples `bit build --release`\n     produces; see docs/reference/build.md. */") &&
    containsSubstr(printed, "// pinned: 2.0 renamed `dial` to `dialTimeout`; not yet migrated here.") &&
    // #1729: a comment on the same line as its container's `{` lands in
    // gaps[0], a distinct code path from an interior gap.
    containsSubstr(printed, "\"build\": { // native unless a triple is given") &&
    // #1729: a comment after the closing `}` is the ROOT node's trailing
    // trivia, not any container's gap -- the last unexercised trivia path.
    containsSubstr(printed, "}\n// end of manifest")
  print("comments-present=${allCommentsPresent}\n")

  // The strongest check: every untouched key's formatting/order is
  // unchanged, and only the one mutated value differs -- byte-for-byte equal
  // to the committed expected-output fixture.
  if (printed == want) {
    print("roundtrip=match\n")
  } else {
    print("roundtrip=mismatch\n")
    print("---got---\n${printed}\n---want---\n${want}\n")
  }
}
