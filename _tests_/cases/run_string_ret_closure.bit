// run
// #4424: a `string` returned across a CLOSURE boundary.
//
// A closure body is not a declaration, so it has no `explodesParams` answer and
// its OWN result keeps the one-handle convention — it is reached through
// `Op.CallValue` like any other function value. What changes underneath it is
// every named function it CALLS, whose result now arrives as three registers
// and is put back together inside the closure's own `IrBuilder`, which is not
// the enclosing function's. That is the second of the three positions that bind
// a call result away from a direct call site.
//
//   expr        an expression-bodied closure: its `ret` is emitted by
//               `lowerFuncValue` and never reaches `emitReturnValue`
//   block       a block-bodied one, whose `return` does
//   captured    the closure returns a captured `string` and nothing else, so
//               the capture is the whole result
//   mixed       a call result concatenated with a capture, which is where the
//               rebuilt box and the captured handle meet
//   nested      a closure returned BY a closure, so the result crosses two
//               `Op.CallValue` frames
//   deep        a closure calling a function that itself returns a call result
fn head(s: string): string {
  return s[0:3]
}

fn wrap(s: string): string {
  return "<" + head(s) + ">"
}

fn main() {
  let s = "abcdefgh"
  let held = s[2:6]
  let expr = (t: string) => head(t)
  let block = (t: string) => {
    let inner = head(t)
    return inner + "|"
  }
  let captured = () => held
  let mixed = () => head(s) + held
  let nested = () => (t: string) => wrap(t) + held
  let deep = (t: string) => wrap(t)
  print("expr ${expr("zyxwvu")}\n")
  print("block ${block("qponml")}\n")
  print("captured ${captured()}\n")
  print("mixed ${mixed()}\n")
  print("nested ${nested()("kjihgf")}\n")
  print("deep ${deep("edcbaz")}\n")
}
