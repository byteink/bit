// run
// #7306: a block-bodied closure written inside a generic function, straight
// into a field or a list element, is typed against the field's declared
// function type. That type is written against the function's own type
// parameter (`A`), and it resolved to nothing in the pre-pass that seeds the
// closure's expected type, so a closure returning `Ran<A>{ ... }` or an
// `Option<[]Rule<A>>` failed E0041 ('(i64) => Ran<A>' against '(i64) =>
// Ran<A>').

class Rule<A> {
  action: A,
}

class Ran<A> {
  ok: bool,
  rules: []Rule<A>,
}

class Run<A> {
  name: string,
  run: (i64) => Ran<A>,
  maybe: (i64) => Option<[]Rule<A>>,
}

// Another generic declaring an `A` of its own: the closures below must see
// erase's `A`, never this one.
class Holder<A> {
  v: A,
}

fn erase<S, A>(name: string, action: A, probe: S): Run<A> {
  return Run<A>{
    name = name,
    run = (n: i64) => {
      if (n == 0) {
        return Ran<A>{ ok = false, rules = []Rule<A>(0) }
      }
      return Ran<A>{ ok = true, rules = [Rule<A>{ action = action }] }
    },
    maybe = (n: i64) => {
      if (n == 0) {
        return Option<[]Rule<A>>.None
      }
      return Option<[]Rule<A>>.Some([Rule<A>{ action = action }])
    },
  }
}

fn pair<A>(action: A): [](i64) => Ran<A> {
  return [](i64) => Ran<A>{
    (n: i64) => {
      return Ran<A>{ ok = n > 0, rules = [Rule<A>{ action = action }] }
    },
  }
}

fn main() {
  let r = erase<string, string>("read", "view", "probe")
  println("${r.name} ${r.run(0).ok} ${len(r.run(0).rules)}")
  let got = r.run(1)
  println("${got.ok} ${got.rules[0].action}")
  println("${isSome(r.maybe(0))}")
  let some = unwrap(r.maybe(1))
  println("${len(some)} ${some[0].action}")
  let ps = pair<i64>(7)
  println("${ps[0](1).ok} ${ps[0](1).rules[0].action}")
  let h = Holder<bool>{ v = true }
  println("${h.v}")
}
