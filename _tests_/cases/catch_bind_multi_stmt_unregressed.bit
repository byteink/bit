// run
// #5474: a genuine catch-bind is unregressed by the single-field-init
// disambiguation added to parseCatchTail — this block has more than one
// bare `IDENT = expr` statement (a call, then a trailing value), so it must
// still bind `e` and run the block, never fall through to catch_default.
fn f(): int! { fail newError("boom") }

fn main() {
  let x = f() catch e {
    println("caught: ${e.message()}")
    0
  }
  println("x=${x}")
}
