// run
// #6343: named arguments on generic callees (SPEC §12.11). One rule for every
// call: a name binds to a parameter of the signature the call site statically
// sees, and the call is then checked and lowered exactly as the positional
// call it reorders into.
//
//  1. `pick<T>` - a generic FREE function: names against its declaration,
//     T inferred from the reordered arguments, the defaulted `sep` omitted.
//  2. `GBox<T>.put` - a method of a generic CLASS, arguments checked against
//     the instantiated `i64`, not the open `T`.
//  3. `measure<T: Shape>` - a TYPE-PARAMETER receiver: `s.area(w = 3, h = 4)`
//     binds against the constraint interface's names (w, h). `Rect` names its
//     own parameters `b` and `a` in the OPPOSITE order, so a name resolved
//     against the implementation would swap the slots. Dispatch is positional:
//     w lands in the first slot, h in the second.
//  4. `label<T: Named>` - a STATIC call through a bound type parameter.
//  5. `Queue.schedule<T: Job>` - the motivating shape: a generic method with
//     defaulted parameters skipped and named out of order.

enum Missed {
  RunOnce,
  Skip,
}

interface Shape {
  area(w: i64, h: i64): i64,
}

class Rect {
  area(b: i64, a: i64): i64 {
    return a * 10 + b
  }
}

interface Named {
  static tag(prefix: string, n: i64): string,
}

class Widget {
  static tag(n: string, p: i64): string {
    return "${n}/${p}"
  }
}

interface Job {
  run(): string,
}

class NightlyDigest {
  run(): string {
    return "digest"
  }
}

class GBox<T> {
  v: T
  put(x: T, y: T): string {
    return "${x}|${y}"
  }
}

class Queue {
  schedule<T: Job>(
    expr: string,
    job: T,
    missed: Missed = Missed.RunOnce,
    tz: string = "UTC",
  ): string {
    return "${expr} ${job.run()} ${missed == Missed.Skip} ${tz}"
  }
}

fn pick<T>(a: T, b: T, sep: string = "-"): string {
  return "${a}${sep}${b}"
}

fn measure<T: Shape>(s: T): i64 {
  return s.area(h = 4, w = 3)
}

fn label<T: Named>(): string {
  return T.tag(n = 7, prefix = "w")
}

fn g(): i64 {
  print("g\n")
  return 1
}

fn h(): i64 {
  print("h\n")
  return 2
}

fn main() {
  print("${pick(b = 1, a = 2)}\n")
  print("${pick(b = "y", a = "x", sep = "+")}\n")
  print("${pick(1, b = 5)}\n")
  print("${pick(b = h(), a = g())}\n")
  let box = GBox<i64>{ v = 0 }
  print("${box.put(y = 1, x = 2)}\n")
  print("${measure<Rect>(Rect{})}\n")
  print("${label<Widget>()}\n")
  let q = Queue{}
  print("${q.schedule("0 2 * * *", NightlyDigest{}, missed = Missed.Skip, tz = "America/New_York")}\n")
  print("${q.schedule("0 3 * * *", NightlyDigest{}, tz = "Europe/Paris")}\n")
  print("${q.schedule(job = NightlyDigest{}, expr = "0 4 * * *")}\n")
}
