// error
// #4692: a predeclared name (SPEC §5.3) is the callee whatever type the
// program also declares under it, so the call's arity is judged against the
// BUILTIN. `vCallResolveBuiltin` (validatecall.bit) used to reach its class-
// `init` arm first and return, so `vRuntimeBuiltinArity` never ran and the
// argument count went unchecked — while `checkCall` and `lowerCall`, which
// both reach `userTypeLookup` only below their builtin handling, emitted the
// 0-argument runtime primitive. On main at 7c6a13f0 this file checked clean
// and RAN: `init` was never called and the program printed the working
// directory, with two arguments left in registers `bit_rt_fs_cwd` does not
// read — the register hazard #2998 opened `vRuntimeBuiltinArity` to close,
// reachable again through a name shadow.
class fsCwd {
  n: i64
  init(a: i64, b: i64) { this.n = a + b }
}

fn main() {
  let s = fsCwd(1, 2)
  print("${s}\n")
}
