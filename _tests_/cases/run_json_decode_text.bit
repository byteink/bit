// run
// SPEC §10.5, #4501: `jsonDecodeText<T>` decodes JSON TEXT straight into a
// `@json` class, driving stdlib/json/parse.bit's forward cursor into the
// fields. No `Json` is built at any point -- which is the whole reason it
// exists, since `jsonDecode<T>` takes the DOM as its argument and so cannot
// remove it.
//
// THE ASSERTION IS THAT IT AGREES WITH `jsonDecode`, CASE FOR CASE. Every
// error line below is byte-identical to the corresponding line of
// `run_json_decode_errors.expected`, and the round trip asserts the same
// re-encoding `run_json_decode.expected` does. Two entry points that disagreed
// about what a document MEANS would be worse than one.
//
// One field of every shape: an i64, a string, a bool, an f64, a `[]string`, a
// `map<string, bool>` used as a set, an `Option<string>` that is set, an
// `Option<string>` that is ABSENT, a `@key`-renamed field, and a nested `@json`
// class.
//
// KEY ORDER IS NOT FIELD ORDER, and that is the one thing a streaming decoder
// has to get right that a DOM decoder gets for free: the cursor sees the keys
// in the order the producer wrote them, so `reordered` below sends the same
// document with its keys reversed and asserts the identical result.
//
// DUPLICATE KEYS ARE LAST-WINS, matching `jsonGet` (stdlib/json/value.bit) and
// therefore matching `jsonDecode`. `dup-keys` asserts it for a scalar and for
// an accumulator at once -- a `[]T` that was not reset before its inner walk
// would CONCATENATE the two arrays, silently.
//
// THE DEPTH BOUND IS TESTED FROM TEXT, on the main stack and on a SPAWNED one.
// A goroutine stack is far smaller than main's, so an unbounded walk survives
// `main` and dies inside `spawn`, which is where every HTTP handler runs.
import { Json, JsonEntry, jsonEncode, jsonDecodeText } from "std/json"
import { JsonDecodeError, JsonDecodeCause } from "std/json"

@json class Addr {
  city: string,
  zip: i32,
}

@json class User {
  id: i64
  name: string
  active: bool
  ratio: f64
  tags: []string
  seen: map<string, bool>
  nick: Option<string>
  absent: Option<string>
  @key("created_at")
  createdAt: string
  addr: Addr
}

// The shape `run_json_decode_errors.bit` reports paths against, so the two
// fixtures' error lines can be compared directly.
@json class Post {
  city: string
  @key("post_code")
  postcode: string
}

@json class Doc {
  id: i64,
  addr: Post,
  crumbs: []Post,
}

// A self-referential `@json` class: the depth this decoder recurses to is
// INPUT-controlled, not bounded by the class.
@json class Node {
  tag: string,
  next: Option<Node>,
}

fn describe(u: User): string {
  let nick = "none"
  if (isSome(u.nick)) {
    nick = unwrap(u.nick)
  }
  let absent = "none"
  if (isSome(u.absent)) {
    absent = unwrap(u.absent)
  }
  let (seen, ok) = u.seen["a"]
  return "id=${u.id} name=${u.name} active=${u.active} ratio=${u.ratio} " +
    "tags=${len(u.tags)}:${u.tags[0]},${u.tags[1]} seen[a]=${seen}/${ok} " +
    "nick=${nick} absent=${absent} created=${u.createdAt} " +
    "city=${u.addr.city} zip=${u.addr.zip}"
}

// `toJson` and `jsonDecodeText` are two halves of one mapping, so the class is
// encoded, decoded back and encoded again and the two renderings compared
// EXACTLY. Every field is also read off the decoded value, because an
// encode-decode-encode that lost and re-defaulted a field in the same place
// would still match.
fn roundTrip(u: User) {
  let encoded = jsonEncode(u.toJson())
  let back = jsonDecodeText<User>(encoded) catch e {
    print("decode: ${e.message()}\n")
    return
  }
  print("exact=${jsonEncode(back.toJson()) == encoded}\n")
  print("${describe(back)}\n")
}

fn user(label: string, src: string) {
  let u = jsonDecodeText<User>(src) catch e {
    print("${label}: err: ${e.message()}\n")
    return
  }
  print("${label}: ok ${describe(u)}\n")
}

fn doc(label: string, src: string) {
  let d = jsonDecodeText<Doc>(src) catch e {
    print("${label}: ${e.message()}\n")
    return
  }
  print("${label}: ok id=${d.id} crumbs=${len(d.crumbs)}\n")
}

// `levels` objects of `{"tag":"n","next":` ... `}` around one leaf.
fn nested(levels: i64): string {
  let s = "{\"tag\":\"leaf\",\"next\":null}"
  let i = 0
  while (i < levels) {
    s = "{\"tag\":\"n\",\"next\":" + s + "}"
    i = i + 1
  }
  return s
}

fn deep(levels: i64) {
  let n = jsonDecodeText<Node>(nested(levels)) catch e {
    let d = e.(JsonDecodeError)
    print("deep(${levels}): maxdepth=${isMaxDepth(d.cause)} segments=${pathSegments(d.path)}\n")
    return
  }
  print("deep(${levels}): ok tag=${n.tag}\n")
}

fn deepSpawned(levels: i64) {
  let done = chan<bool>(1)
  spawn deepWorker(levels, done)
  let (_, _) = <- done
}

fn deepWorker(levels: i64, done: chan<bool>) {
  let n = jsonDecodeText<Node>(nested(levels)) catch e {
    let d = e.(JsonDecodeError)
    print("spawned(${levels}): maxdepth=${isMaxDepth(d.cause)}\n")
    done <- true
    return
  }
  print("spawned(${levels}): ok tag=${n.tag}\n")
  done <- true
}

// The cause is a real enum a caller can branch on, not a string it has to
// scrape out of the message.
fn isMaxDepth(c: JsonDecodeCause): bool {
  match (c) {
    MaxDepth => return true
    MissingKey => return false
    TypeMismatch => return false
    UnknownKey => return false
  }
}

fn pathSegments(p: string): i64 {
  let n = 1
  let i = 0
  while (i < len(p)) {
    if (p[i:i + 1] == ".") {
      n = n + 1
    }
    i = i + 1
  }
  return n
}

fn okDoc(): string {
  return "{\"id\":1,\"addr\":{\"city\":\"c\",\"post_code\":\"p\"},\"crumbs\":[]}"
}

fn errors() {
  doc("ok", okDoc())
  doc("missing-top", "{\"addr\":{\"city\":\"c\",\"post_code\":\"p\"},\"crumbs\":[]}")
  doc("missing-nested", "{\"id\":1,\"addr\":{\"city\":\"c\"},\"crumbs\":[]}")
  doc(
    "mismatch-top",
    "{\"id\":\"x\",\"addr\":{\"city\":\"c\",\"post_code\":\"p\"},\"crumbs\":[]}",
  )
  doc("mismatch-nested", "{\"id\":1,\"addr\":{\"city\":\"c\",\"post_code\":3},\"crumbs\":[]}")
  doc(
    "mismatch-in-array",
    "{\"id\":1,\"addr\":{\"city\":\"c\",\"post_code\":\"p\"},\"crumbs\":[{\"city\":\"a\",\"post_code\":\"b\"},{\"city\":\"a\",\"post_code\":7}]}",
  )
  doc(
    "unknown-top",
    "{\"id\":1,\"addr\":{\"city\":\"c\",\"post_code\":\"p\"},\"crumbs\":[],\"nope\":1}",
  )
  doc(
    "unknown-nested",
    "{\"id\":1,\"addr\":{\"city\":\"c\",\"post_code\":\"p\",\"zip\":1},\"crumbs\":[]}",
  )
  // The `@key` rename is what is on the wire: the FIELD name is not accepted.
  doc(
    "field-name-not-key",
    "{\"id\":1,\"addr\":{\"city\":\"c\",\"postcode\":\"p\"},\"crumbs\":[]}",
  )
  doc("not-an-object", "[1,2]")
  doc("field-not-an-object", "{\"id\":1,\"addr\":3,\"crumbs\":[]}")
  // A key explicitly set to `null` is a missing key for a non-Option field,
  // exactly as `jsonDecMember` reads it on the DOM path.
  doc(
    "null-for-required",
    "{\"id\":null,\"addr\":{\"city\":\"c\",\"post_code\":\"p\"},\"crumbs\":[]}",
  )
}

// Malformed JSON is refused with parse.bit's own positional error, the one
// `jsonParse` would have produced -- a text decode never reaches a
// `JsonDecodeError` for a document that is not JSON.
fn malformed() {
  doc("trailing-garbage", "${okDoc()}x")
  doc("trailing-comma", "{\"id\":1,\"addr\":{\"city\":\"c\",\"post_code\":\"p\"},\"crumbs\":[],}")
  doc("missing-comma", "{\"id\":1 \"addr\":{}}")
  doc("unterminated", "{\"id\":1,\"addr\":{\"city\":\"c\"")
}

fn main() {
  let u = User{
    id: 7,
    name: "ada",
    active: true,
    ratio: 0.5,
    tags: ["a", "b"],
    seen: map<string, bool>{ "a": true },
    nick: Option<string>.Some("mango"),
    absent: Option<string>.None,
    createdAt: "2026-01-01",
    addr: Addr{ city: "cairo", zip: 11511 },
  }
  print("${describe(u)}\n")
  roundTrip(u)
  // The absent Option's key REMOVED rather than null, and the whole document in
  // declaration order.
  user(
    "omitted",
      "{\"id\":7,\"name\":\"ada\",\"active\":true,\"ratio\":0.5,\"tags\":[\"a\",\"b\"]," +
      "\"seen\":{\"a\":true},\"nick\":\"mango\",\"created_at\":\"2026-01-01\"," +
      "\"addr\":{\"city\":\"cairo\",\"zip\":11511}}",
  )
  // The same document with every key in the opposite order.
  user(
    "reordered",
      "{\"addr\":{\"zip\":11511,\"city\":\"cairo\"},\"created_at\":\"2026-01-01\"," +
      "\"absent\":null,\"nick\":\"mango\",\"seen\":{\"a\":true}," +
      "\"tags\":[\"a\",\"b\"],\"ratio\":0.5,\"active\":true,\"name\":\"ada\",\"id\":7}",
  )
  // An `f64` field carrying an integer literal: `3` and `3.0` are the same
  // document to every producer, which is `jsonAsNumber`'s own rule.
  user(
    "int-for-float",
      "{\"id\":7,\"name\":\"ada\",\"active\":true,\"ratio\":2,\"tags\":[\"a\",\"b\"]," +
      "\"seen\":{\"a\":true},\"nick\":\"mango\",\"created_at\":\"2026-01-01\"," +
      "\"addr\":{\"city\":\"cairo\",\"zip\":11511}}",
  )
  // Last wins, for a scalar and for an accumulator.
  user(
    "dup-keys",
      "{\"id\":1,\"id\":7,\"name\":\"ada\",\"active\":true,\"ratio\":0.5," +
      "\"tags\":[\"z\"],\"tags\":[\"a\",\"b\"],\"seen\":{\"a\":true}," +
      "\"nick\":\"mango\",\"created_at\":\"2026-01-01\"," +
      "\"addr\":{\"city\":\"cairo\",\"zip\":11511}}",
  )
  errors()
  malformed()
  deep(3)
  deep(10000)
  deepSpawned(10000)
}
