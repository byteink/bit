// run
// #4499. A generic call standing inside another generic's body binds the
// ENCLOSING template's own type parameters, so the check pass recorded a
// degenerate `freeName<T>` — T still a `TypeKind.TypeParam`. Pass A2 emitted a
// body for it and lowering refused the whole (correct) program with
// `E0092: cannot lower a `.` field access on a receiver that is not a class or
// interface`, pointing INTO `freeName`. Deleting the `wrap` indirection made
// the identical program compile, which is what pinned it to the ledger entry.
//
// The concrete instance is recorded by Pass A1 (`recordSubtreeCall`,
// lowerdriver.bit) once per instantiation of the enclosing generic, so
// refusing the degenerate entry loses nothing.

interface Named {
  label(): string,
}

class Dog {
  n: string

  export label(): string {
    return this.n
  }
}

fn freeName<T: Named>(v: T): string {
  return v.label()
}

// One level of indirection: this is what recorded `freeName<T>`.
fn wrap<T: Named>(v: T): string {
  return freeName(v)
}

// Two levels, to pin that the closure is transitive and not one-deep.
fn wrap2<T: Named>(v: T): string {
  return wrap(v)
}

// An UNBOUND generic through the same indirection: it never touches T's
// members, so it survived even before the fix. Kept as the control.
fn idOf<T>(v: T): T {
  return v
}

fn relay<T>(v: T): T {
  return idOf(v)
}

fn main() {
  print(freeName(Dog{ n: "direct" }) + "\n")
  print(wrap(Dog{ n: "rex" }) + "\n")
  print(wrap2(Dog{ n: "fido" }) + "\n")
  print("${relay(7)}\n")
}
