// run
// #6347: named arguments on a receiver that is a VALUE of a GENERIC
// interface type (SPEC §12.11). The call site statically sees only the
// interface, so a name resolves against the interface's own signature
// (`Store<T>.put(key, value)`), exactly as for a non-generic interface value;
// the parameter types are the ones substituted by the value's type argument.
// Dispatch after that is positional.
//
// `Mem` implements `Store<i64>` with its two parameters NAMED IN THE OPPOSITE
// ORDER (`value` first). Both are i64, so a name resolved against `Mem`
// instead of `Store` would place the values in swapped slots and print
// `1:5` where the interface's names demand `5:1`.
//
//  1. a local `let s: Store<i64> = Mem{}`;
//  2. a parameter of a generic function, `use<T>(s: Store<T>, ..)`, where
//     the value's type is an open `T` until instantiation;
//  3. a class field holding a `Store<string>`.

interface Store<T> {
  put(key: i64, value: T): string,
}

class Mem {
  put(value: i64, key: i64): string {
    return "${key}:${value}"
  }
}

class Tagged {
  put(label: i64, text: string): string {
    return "${label}=${text}"
  }
}

class Holder {
  inner: Store<string>
}

fn use<T>(s: Store<T>, v: T): string {
  return s.put(value = v, key = 9)
}

fn main() {
  let s: Store<i64> = Mem{}
  print("${s.put(value = 5, key = 1)}\n")
  print("${use(s, 6)}\n")
  let h = Holder{ inner = Tagged{} }
  print("${h.inner.put(value = "t", key = 2)}\n")
}
