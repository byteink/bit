// run
// #3862: the qualifying shape — a `[]T` where T is a non-exported, non-generic
// class with an empty pointer map and a body wider than one word — lowers to
// the inline element representation `sliceElemSizeFor` (compiler/lowercall.bit)
// now authorizes (#3861 made the runtime accept the stride; this is the
// compiler side that actually emits one). Exercises every safe use the
// ticket's predicate names: a literal, `append` with a fresh composite
// literal (forcing three regrows, so the grow-copy has to preserve earlier
// elements' full bodies — the exact shape that broke before the isRef fix
// below), indexed field read/write, compound assignment, inc/dec, a
// `(index, element)` for-loop, a plain for-loop, `len`, and a reslice sharing
// the same buffer.
class Node { x: i64, y: i64 }

fn main() {
  let batch = [Node{ x: 1, y: 2 }]
  batch = append(batch, Node{ x: 3, y: 4 })
  batch = append(batch, Node{ x: 5, y: 6 })
  batch = append(batch, Node{ x: 7, y: 8 })
  batch = append(batch, Node{ x: 9, y: 10 })
  batch[0].x = 100
  batch[0].x += 1
  batch[0].y++
  print("${len(batch)}\n")
  let total = 0
  for nd of batch {
    total = total + nd.x + nd.y
  }
  print("${total}\n")
  let pairTotal = 0
  for (i, nd) of batch {
    pairTotal = pairTotal + i * 1000 + nd.x
  }
  print("${pairTotal}\n")
  let mid = batch[1:3]
  mid[0].x = 999
  print("${mid[0].x} ${mid[0].y} ${batch[1].x} ${batch[1].y}\n")
}
