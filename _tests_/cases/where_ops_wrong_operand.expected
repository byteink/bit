error[E0302]: field "age" of Article under operator 'gte' is 'i64', found 'string'
  --> where_ops_wrong_operand.bit:14:41
   |
14 |   let a: Where<Article> = { age: { gte: "18" } }
   |                                         ^^^^ the operand of 'gte' has the field's own type
error[E0302]: field "age" of Article under operator 'in' takes a list of 'i64', found 'untyped int'
  --> where_ops_wrong_operand.bit:15:40
   |
15 |   let b: Where<Article> = { age: { in: 18 } }
   |                                        ^^ write `in: [a, b]`, or pass a list of the field's own type
error[E0302]: field "age" of Article under operator 'in' is 'i64', found 'string'
  --> where_ops_wrong_operand.bit:16:44
   |
16 |   let c: Where<Article> = { age: { in: [1, "two"] } }
   |                                            ^^^^^ the operand of 'in' has the field's own type
