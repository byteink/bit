// run
// map<K,V>: literal, index get/set, absent-key zero value, overwrite, delete,
// len, and key iteration (sums are order-independent, so the output is stable
// even though slot order is unspecified). Exercises both a string-keyed map
// (ref keys, byte-hashed) and an int-keyed map (word-hashed).
fn main() {
  let m = map<string, int>{"a": 1, "b": 2, "c": 3}
  print("a=${m["a"]} b=${m["b"]} c=${m["c"]} miss=${m["z"]}\n")
  m["a"] = 100 // overwrite keeps len
  m["d"] = 4 // fresh key grows len
  print("a=${m["a"]} len=${len(m)}\n")
  delete(m, "b")
  delete(m, "gone") // deleting an absent key is a no-op
  print("after_del len=${len(m)} b=${m["b"]}\n") // absent b reads as 0

  let n = map<int, int>()
  let i = 0
  while (i < 5) {
    n[i] = i * i
    i = i + 1
  }
  let ksum = 0
  let vsum = 0
  for (k, v) of n {
    ksum = ksum + k
    vsum = vsum + v
  }
  print("ksum=${ksum} vsum=${vsum} len=${len(n)}\n")
}
