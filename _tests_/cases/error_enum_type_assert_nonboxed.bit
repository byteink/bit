// error
// #6017 (SPEC §14.3/§14.7): a C-like (bare-tag) enum target is a raw `i64`,
// not an object, so it can never be the dynamic type behind an interface
// value — rejected at check time, never a runtime crash.
enum Color { Red, Green, Blue }

fn asColor(e: error) {
  let (_, ok) = e.(Color)
  print("${ok}\n")
}

fn main() {}
