// run
// #4356: closure devirtualisation enumerates a function's call sites from the
// instruction stream, so anything that can ENTER a function without an `Op.Call`
// has to poison it. A method reached through `bit_rt_iface_lookup` is the one
// such edge that no scan of the instructions can see: the target is named only
// in `IrModule.methodTables`, resolved from the receiver's type discriminator at
// run time (runtime/ABI.md §2.1).
//
// `Twice.apply` here is entered BOTH ways with DIFFERENT comparators — directly
// on the concrete receiver with `(x) => x + 1`, and through the `Applier`
// interface with `(x) => x * 2`. The direct site is the only one the
// instruction stream shows. Without the method-table poison the analysis
// concludes `f` is always `x + 1`, devirtualises on that, and the interface
// call silently computes the wrong answer while compiling clean and exiting 0:
// line 2 comes out as 5 instead of 12.
//
// Single-file golden: no prelude.
interface Applier {
  apply(f: (int) => int): int,
}

class Twice {
  n: int
  apply(f: (int) => int): int {
    return f(f(this.n))
  }
}

fn main() {
  let t = Twice{ n: 3 }
  println("direct ${t.apply((x) => x + 1)}")
  let a: Applier = t
  println("iface  ${a.apply((x) => x * 2)}")
}
