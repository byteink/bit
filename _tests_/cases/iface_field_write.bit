// error
// #6990: a field requirement is read-only through the interface. Assignment,
// compound assignment and increment are all E0114; the class's own field is
// still writable on the class value.
interface Counter {
  n: i64,
}

class Hits {
  export n: i64,
}

fn main() {
  let h = Hits{ n = 1 }
  h.n = 2
  let c: Counter = h
  c.n = 5
  c.n += 1
  c.n++
  print("${c.n}\n")
}
