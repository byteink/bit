// run
// #3862: a `for n of xs` binder used as anything but a field read
// disqualifies its element type — here `n` is passed whole to `consume`,
// which needs a real reference. If the bail-out did not fire, `n` would be a
// raw address into the packed slice's untraced buffer, and passing it to a
// function expecting a `Node` reference would misbehave (at best) or corrupt
// the heap (at worst, if that reference ever reached the collector). `Node`
// therefore stays boxed (stride 8) for the whole module.
class Node { x: i64, y: i64 }

fn consume(n: Node): i64 {
  return n.x + n.y
}

fn main() {
  let batch = [Node{ x: 1, y: 2 }, Node{ x: 3, y: 4 }]
  let total = 0
  for nd of batch {
    total = total + consume(nd)
  }
  print("${total}\n")
}
