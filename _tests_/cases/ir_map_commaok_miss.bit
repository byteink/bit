// ir
// #5905: a comma-ok map read over a class value builds its zero object in the
// miss block only when something on the miss path can read it
// (compiler/optcommaok.bit). `hitOnly` and `notOk` read `n` only past an
// ok-true edge, so their miss block passes the raw null word and carries no
// `gc_alloc`. The other three can read `n` after a miss, and each keeps the
// zero object: read after the `if`, passed to a call on both paths, stored
// into a field before the check.
class Obj {
  x: int,
}

class Holder {
  o: Obj,
}

fn hitOnly(m: map<int, Obj>, k: int): int {
  let (n, ok) = m[k]
  if (ok) {
    return n.x
  }
  return -1
}

fn notOk(m: map<int, Obj>, k: int): int {
  let (n, ok) = m[k]
  if (!ok) {
    return -1
  }
  return n.x
}

fn readAfter(m: map<int, Obj>, k: int): int {
  let (n, ok) = m[k]
  let r = 0
  if (ok) {
    r = 1
  }
  return r + n.x
}

fn take(o: Obj): int {
  return o.x
}

fn callBoth(m: map<int, Obj>, k: int): int {
  let (n, ok) = m[k]
  if (ok) {
    return take(n) + 1
  }
  return take(n)
}

fn storeBefore(m: map<int, Obj>, k: int, h: Holder): int {
  let (n, ok) = m[k]
  h.o = n
  if (ok) {
    return n.x
  }
  return -1
}
