// panic
// #3108: `index == len` on the WRITE path. The mirror of
// `run_slice_index_atlen_panic.bit`, and pinned separately from its two siblings
// for the same reason that one is: this is the ONE index a `<=` written where
// `<` belongs would admit, and neither the negative case nor a far-past-the-end
// case would notice.
//
// The write side is where admitting it costs more. A read one word past the live
// data returns a stale value; a WRITE one word past it lands in whatever the
// allocator put next — another object's header, or another slice's element — and
// the program carries on and exits 0. `bit_rt_slice_set` refused this index
// before #3108 inlined the check; the check has to keep refusing it here.
//
// The length is read back through `len(xs)` and the slice is grown by a
// non-foldable amount, so nothing here is decidable at compile time.
import { args } from "std/os"

fn extra(): int { return len(args()) - 1 }

fn main() {
  let xs = [1, 2, 3]
  xs = append(xs, 4 + extra())
  print("start len=${len(xs)}\n")
  xs[len(xs)] = 99
  print("unreachable\n")
}
