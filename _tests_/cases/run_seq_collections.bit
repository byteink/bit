// run
// #2144: the collection half of std/seq — map `keys`/`values`, slice
// `insertAt`/`removeAt`/`concat`/`equal`, and `groupBy`/`indexBy`/`unique`.
//
// A golden case is a single file, so it has no prelude.
import { keys, values, concat, insertAt, removeAt, equal, unique, groupBy, indexBy } from "std/seq"

class Item { id: i64, category: string }

fn sumI64(xs: []i64): i64 {
  let total: i64 = 0
  for x of xs {
    total = total + x
  }
  return total
}

fn printI64Slice(xs: []i64): string {
  let out = "["
  let i = 0
  while (i < len(xs)) {
    if (i > 0) {
      out = out + ","
    }
    out = out + "${xs[i]}"
    i = i + 1
  }
  return out + "]"
}

fn main() {
  // keys/values over a 64-entry map: length and sum, not order — map
  // iteration order is deterministic per build but neither insertion order
  // nor sorted (documented on `keys`/`values`).
  let m = map<i64, i64>()
  let i: i64 = 0
  while (i < 64) {
    m[i] = i * i
    i = i + 1
  }
  let ks = keys(m)
  let vs = values(m)
  print("keys_len=${len(ks)} keys_sum=${sumI64(ks)}\n")
  print("values_len=${len(vs)} values_sum=${sumI64(vs)}\n")

  // insertAt at front, middle, end of the SAME source slice — the source
  // must be left unmodified across all three calls. `append` aliases its
  // backing array, so a naive splice (`append(xs, ...)`) could silently
  // mutate the caller's slice; this is the check that catches it.
  let xs: []i64 = [10, 20, 30, 40]
  let front = insertAt(xs, 0, 99)
  let middle = insertAt(xs, 2, 99)
  let end = insertAt(xs, len(xs), 99)
  print("insert_front=${printI64Slice(front)}\n")
  print("insert_middle=${printI64Slice(middle)}\n")
  print("insert_end=${printI64Slice(end)}\n")
  print("xs_after_insert=${printI64Slice(xs)}\n")

  // removeAt at each index of the same source slice, same aliasing check.
  let ys: []i64 = [10, 20, 30, 40]
  let r0 = removeAt(ys, 0)
  let r1 = removeAt(ys, 1)
  let r2 = removeAt(ys, 2)
  let r3 = removeAt(ys, 3)
  print("remove0=${printI64Slice(r0)}\n")
  print("remove1=${printI64Slice(r1)}\n")
  print("remove2=${printI64Slice(r2)}\n")
  print("remove3=${printI64Slice(r3)}\n")
  print("ys_after_remove=${printI64Slice(ys)}\n")

  // concat, including empty operands.
  let a: []i64 = [1, 2]
  let b: []i64 = [3, 4]
  let empty: []i64 = []i64(0)
  print("concat_both=${printI64Slice(concat(a, b))}\n")
  print("concat_a_empty=${printI64Slice(concat(empty, b))}\n")
  print("concat_b_empty=${printI64Slice(concat(a, empty))}\n")

  // equal: true, false-on-length, false-on-element.
  print("equal_same=${equal([1, 2, 3], [1, 2, 3])}\n")
  print("equal_len=${equal([1, 2], [1, 2, 3])}\n")
  print("equal_elem=${equal([1, 2, 3], [1, 2, 4])}\n")

  // unique: first-seen order preserved.
  let dup: []i64 = [1, 2, 2, 3, 1, 4]
  print("unique=${printI64Slice(unique(dup))}\n")

  // equal/unique over a slice of STRUCTS: element equality goes through
  // `==`, which is field-wise content comparison (#2105), not handle
  // comparison. s1 and s2 are separately constructed with identical
  // fields — distinct handles, equal content — so `equal` must answer true
  // and `unique` must collapse them to one entry.
  let s1 = Item{ id: 1, category: "a" }
  let s2 = Item{ id: 1, category: "a" }
  let s3 = Item{ id: 2, category: "b" }
  print("struct_equal_same=${equal([s1, s3], [s2, s3])}\n")
  print("struct_equal_diff=${equal([s1], [s3])}\n")
  let structUnique = unique([s1, s2, s3])
  print("struct_unique_len=${len(structUnique)} struct_unique_ids=${structUnique[0].id},${structUnique[1].id}\n")

  // groupBy / indexBy over a struct slice.
  let items = [
    Item{ id: 1, category: "a" },
    Item{ id: 2, category: "b" },
    Item{ id: 3, category: "a" },
    Item{ id: 4, category: "c" },
  ]
  let byCat = groupBy(items, (it: Item) => it.category)
  let aGroup = byCat["a"]
  let bGroup = byCat["b"]
  let cGroup = byCat["c"]
  print("group_a_len=${len(aGroup)} group_a_ids=${aGroup[0].id},${aGroup[1].id}\n")
  print("group_b_len=${len(bGroup)} group_b_ids=${bGroup[0].id}\n")
  print("group_c_len=${len(cGroup)} group_c_ids=${cGroup[0].id}\n")

  let byId = indexBy(items, (it: Item) => it.id)
  print("index_1=${byId[1].category} index_2=${byId[2].category} index_3=${byId[3].category} index_4=${byId[4].category}\n")
}
