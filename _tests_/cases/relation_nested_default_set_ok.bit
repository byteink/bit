// run
//
// #6408: a parameter default whose literal sets every hop of the path the body
// reads (`author`, then `posts` inside it, through both elements of the list) is
// a loaded row, so `x.author.posts` passes the E0300 proof and, built by hand,
// really is loaded at run time. The twin that leaves a hop unset is
// bit/checkercases/check_orm_relation_default_nested_missing.bit.

@table class Author {
  @id
  id: i64
  name: string
  @hasMany("authorId")
  posts: []Post
}

@table class Post {
  @id
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn show(
  x: Post = Post{
    id = 1, authorId = 1,
    author = Author{
      id = 1,
      name = "Ada",
      posts = [Post{ id = 1, authorId = 1 }, Post{ id = 2, authorId = 1 }],
    },
  },
): string {
  return "${len(x.author.posts)}"
}

fn main() {
  print("${show()}\n")
}
