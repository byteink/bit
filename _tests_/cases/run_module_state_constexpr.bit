// run
// §11.11 module-state initializers are folded per §15.4 ("constant expressions
// are evaluated at compile time"), not just read as literals (#1430).
//
// `let x: i64 = 0 - 1` passed `bit check` and then failed to lower, because the
// self-hosted checker admitted any expression that was not obviously dynamic
// while its image builder could only render a literal with an optional sign.
// The seed folded all of this already, so the two compilers disagreed and only
// the self-hosted one broke — and it broke by naming whichever FUNCTION read
// the cell, never the declaration at fault.
//
// The checker and the image builder now share one evaluator, so "check accepted
// it" and "lowering can render it" cannot drift apart again. Every form below
// is one the seed folds, which is what makes this case a differential guard
// rather than a snapshot of one compiler's behaviour.
const K = 5

let negated: i64 = 0 - 1
let sum: i64 = 1 + 2
let product: i64 = 6 * 7
let shifted: i64 = 1 << 3
let masked: i64 = 255 & 15
let viaConst: i64 = K + 1
let nested: i64 = (2 + 3) * (10 - 4)
let literal: i64 = -1
let flag: bool = !false
let ratio: f64 = 1.5
let letter: i64 = 'a'

fn main() {
  print("${negated} ${sum} ${product} ${shifted} ${masked}\n")
  print("${viaConst} ${nested} ${literal} ${letter}\n")
  print("${flag} ${ratio}\n")
  // The cells are mutable state, not constants — a fold decides the initial
  // image only.
  sum = sum + 1
  print("mutated=${sum}\n")
}
