// run
// #6567: `for x of it? { }` over a `next(): Option<T>!` iterable. `next()` fails
// on its 3rd call. `ran` is the loop body's own count and must be 2 (the 3rd
// `next()` never reached the body), `calls` must be 3 (the loop stopped at the
// failure, it did not retry or drain), and the caller must see the message.
class Pages {
  n: i64
  calls: i64
  failAt: i64
  ran: i64
  next(): Option<i64>! {
    this.calls = this.calls + 1
    if (this.calls == this.failAt) {
      fail newError("page ${this.calls} failed")
    }
    if (this.n <= 0) {
      return Option.None
    }
    this.n = this.n - 1
    return Option.Some(this.n)
  }
}

fn drain(it: Pages): i64! {
  let sum: i64 = 0
  for x of it? {
    it.ran = it.ran + 1
    sum = sum + x
  }
  return sum
}

fn main() {
  let sizer = [1, 1, 1, 1, 1, 1]
  let it = Pages{ n = len(sizer), calls = 0, failAt = 3, ran = 0 }
  let msg = ""
  drain(it) catch e {
    msg = e.message()
  }
  print("ran=${it.ran} calls=${it.calls} err=${msg}\n")
}
