// lint exit=1
// #5161: `elem`/`attr`/`text` are consumed ONLY through `<div id="x">hi</div>`
// (no bare reference anywhere in this file), so lintUnusedImport must NOT
// report them unused — the positive case. `frag` is imported but this file
// never writes a fragment (`<>...</>`), so it must STILL report unused: the
// fix marks exactly the JSX target words the file's own raw AST would need
// (mirroring desugarjsx.bit's `jsxSynthWords`), never every JSX name at
// once just because some JSX tag exists somewhere in the file.
import { Node, elem, attr, frag, text } from "../../pkg/web"

fn Row(): Node {
  return <div id="x">hi</div>
}
