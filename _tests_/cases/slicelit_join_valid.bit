// run
// #6025: the accept half of check_slice_lit_mixed_second.bit — a bare
// `[e1, e2, ...]` slice literal whose elements DO share one common type
// (SPEC §15.2: identical, or all untyped constants sharing a default type)
// must still compile and run, both for plain untyped-constant elements and
// for a concrete-typed first element with an untyped constant representable
// in it (the same assignability `vExpectExpr`'s Slice-target push-down
// already grants an annotated literal's elements).
fn main() {
  let ints = [1, 2, 3]
  print("${len(ints)} ${ints[0]} ${ints[2]}\n")

  let f: f32 = 1.5
  let floats = [f, 2.5]
  print("${len(floats)} ${floats[1]}\n")

  let nested = [[1, 2], [3, 4, 5]]
  print("${len(nested)} ${len(nested[1])} ${nested[1][2]}\n")
}
