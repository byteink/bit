// panic
// #4375, the identity of the INDEX. The proof covers exactly the value the
// header tested; `xs[i + 1]` is a different index with nothing behind it, and
// it walks off the end on the LAST iteration and nowhere earlier.
//
// The progress lines pin the iteration rather than the fact of a panic: a pass
// that generalised from "the index is the header's own param" to "any index
// derived from it" would read one word past the live elements here, print a
// plausible number and exit 0. Stderr is the stream a `// panic` case compares.
import { args } from "std/os"

fn main() {
  let xs = [3, 4, 5]
  xs = append(xs, 6 - len(args()))
  let i = 0
  while (i < len(xs)) {
    eprint("i=${i} x=${xs[i]}\n")
    eprint("next=${xs[i + 1]}\n")
    i = i + 1
  }
  eprint("unreachable\n")
}
