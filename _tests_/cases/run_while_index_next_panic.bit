// panic
// #4375, the identity of the INDEX. The proof covers exactly the value the
// header tested; `xs[i + 1]` is a different index with nothing behind it, and
// it walks off the end on the LAST iteration and nowhere earlier.
//
// Both reads sit at the top of the body with no call between them, so the
// second one IS a candidate the pass looks at and rejects on its left operand
// alone — its limit is the same value id as the header's. A mutant that keyed
// only on the limit marks it, reads one word past the live elements, prints a
// plausible number and exits 0.
import { args } from "std/os"

fn main() {
  let xs = [3, 4, 5]
  xs = append(xs, 6 - len(args()))
  let i = 0
  while (i < len(xs)) {
    let x = xs[i]
    let nxt = xs[i + 1]
    eprint("i=${i} x=${x} next=${nxt}\n")
    i = i + 1
  }
  eprint("unreachable\n")
}
