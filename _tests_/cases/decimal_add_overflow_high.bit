// panic
// #5288 companion: the fix for the false-positive overflow on a magnitude
// in [2^95, 2^96) must not weaken the genuine overflow panic for a magnitude
// that truly exceeds the type's 96-bit ceiling (2^96-1 ~ 7.9228162514e28).
// `bigVal` sits just under that ceiling (the same near-maximum value
// `run_decimal_words.bit` divides by `1`); doubling it via `+` genuinely
// exceeds 2^96-1 and must still panic.
fn main() {
  let maxHi: decimal = 79228162514
  let p9: decimal = 1000000000
  let p18 = p9 * p9
  let bigVal = maxHi * p18
  print("start\n")
  print("sum=${bigVal + bigVal}\n")
  print("unreachable\n")
}
