// run
// #2378: a `defer` that escapes the conditional region it was registered in
// (control flows PAST the region to a later exit) used to be refused with
// E0092. Each function below covers one shape from the ticket.
fn f(n: int) {
  if (n == 2) {
    defer print("B\n")
  }
  print("A\n")
}

// Two escaping defers, neither branch taken: this exact shape SIGSEGV'd
// (exit 139) on 0.1.8, before #2280 fixed non-escaping scheduling.
fn twoIfsNeitherTaken(n: int) {
  if (n == 100) {
    defer print("never1\n")
  }
  if (n == 200) {
    defer print("never2\n")
  }
  print("neither taken\n")
}

// A defer registered before a `break` that leaves the loop: its call must
// still run at the function's own return, not at the break.
fn breakAfterDefer() {
  let i = 0
  while (true) {
    defer print("loop-defer\n")
    i = i + 1
    if (i == 1) {
      break
    }
  }
  print("after loop\n")
}

// Capture-at-defer-time: arguments are evaluated at the `defer` statement,
// not at execution time (SPEC §18.5) — must print the value `n` had when the
// `defer` statement ran, not its later value.
fn captureAtDeferTime() {
  let n = 1
  if (n == 1) {
    defer print("captured n=${n}\n")
  }
  n = 2
  print("n is now ${n}\n")
}

// Mixed conditional + unconditional defers, reverse (LIFO) order across an
// escaping branch.
fn mixedOrder(n: int) {
  defer print("outer1\n")
  if (n == 2) {
    defer print("inner\n")
  }
  defer print("outer2\n")
  print("body n=${n}\n")
}

fn main() {
  f(1)
  f(2)
  twoIfsNeitherTaken(1)
  breakAfterDefer()
  captureAtDeferTime()
  mixedOrder(1)
  mixedOrder(2)
}
