// ir
// #5949: dead-code elimination drops a block parameter no instruction reads,
// with the matching argument on every edge into its block (`computeLive` in
// compiler/opt.bit, `rebuild` in compiler/optrebuild.bit).
//
// THE FIXTURE FAILS IN BOTH DIRECTIONS, which is why it holds two functions:
//
//   `cycle`    — `d` travels the loop header, the `if`'s join and the back
//                edge, and its only reader is the `add` that feeds it back.
//                One descending sweep cannot see that the cycle has no reader
//                outside it: the back edge's `jump` sits above the body that
//                decides whether the header's parameter is read. The `mul`,
//                the `add` and every parameter carrying `d` must be gone. If
//                the fixpoint goes dark they all come back.
//   `keepBase` — `t`'s base word (the `string` parameter of the loop header)
//                is read by no instruction, only its ptr word is. The
//                keepalive edge `addJoinParams` (compiler/lowerexplode.bit)
//                records from the ptr word to the base is the one thing that
//                keeps it, and must: without it nothing roots the bytes the
//                ptr word points into across the allocating call in the body.
//
// The pruning defaults ON since the 0.32.0 repin (#6191); `BIT_DCE_PARAMS=0`
// still reproduces the old, unpruned shape. The golden harness runs every
// case at the default, so this pins the pruned IR.

fn cycle(n: i64): i64 {
  let i = 0
  let d = n * 3
  while (i < n) {
    if (i < 3) {
      d = d + 1
    }
    i = i + 1
  }
  return i
}

fn keepBase(s: string, n: i64): i64 {
  let t = s[1:3]
  let sum = 0
  let i = 0
  while (i < n) {
    sum = sum + i64(t[i & 1])
    let junk = "${i}"
    i = i + 1
  }
  return sum
}
