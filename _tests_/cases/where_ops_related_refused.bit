// error
// #6997: `related(...)` tests a relation, so it is refused on a plain field, and
// it takes one string literal. A foreign key a @belongsTo names and a field with
// a relation mark are relation fields: lines 34 and 35 draw no error.
import { Where } from "std/where"
import { FieldDesc, AttrDesc } from "std/sql"

class Relation {
  name: string,
}

fn related(name: string): Relation {
  return Relation{ name = name }
}

@table class Article {
  @id
  id: i64
  folderId: i64
  title: string
  @belongsTo("folderId")
  folder: Folder
}

@table class Folder {
  @id
  id: i64
  @hasMany("folderId")
  articles: []Article
}

fn main() {
  let name = "editor"
  let ok1: Where<Article> = { folderId: related("editor") }
  let ok2: Where<Folder> = { articles: related("editor") }
  let a: Where<Article> = { title: related("editor") }
  let b: Where<Article> = { folder: related(name) }
}
