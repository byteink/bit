// run
// SPEC 11.6 / #6440: `callerSaved` in a `clobber` list stands for the whole
// caller-saved file of each target. `keep` is live across the block, so the
// block is a clobber point and `keep` must not sit in a caller-saved register;
// the payload overwrites r8 / x12 as in the SPEC's own `scribble` example.
fn scribble(keep: int): int {
  asm {
    arm64 { 0xD2800FEC }                       // mov x12, #0x7f
    x64 { 0x41, 0xB8, 0x7F, 0x00, 0x00, 0x00 } // mov r8d, 0x7f
    clobber arm64 { callerSaved }
    clobber x64 { callerSaved }
  }
  return keep + 1
}

fn main() {
  println("${scribble(41)}")
}
