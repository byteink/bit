// #6326's sibling module: this file and `b.bit` both write
// `import { trimSpace } from "std/strings"` — one directory module (§17.1),
// so without the identical-import exemption this pair alone would fail to
// build with E0042 "already declared in this scope".
import { trimSpace } from "std/strings"

export fn greet(name: string): string {
  return "hello " + trimSpace(name)
}
