// run
// #4427: the loop-carried induction copy is coalesced onto its param's
// register, so a counted loop closes on `add xN, xN, #1` with no phi copy. That
// is sound only while nothing reads the counter's OLD value after the
// increment — the increment overwrites the register the old value lives in.
//
// Every case below reads a value that is the counter, or shares its register
// with the counter, at a point where the increment has already run. Each one
// prints the value from BEFORE the increment; with the guard removed, each
// prints the value from after it, and the sums move by exactly the trip count.
fn main() {
  // A binding taken before the increment is the same vreg as the param, read
  // after it. Prints 0+1+2+3+4 = 10, not 1+2+3+4+5 = 15.
  let n = 5
  let j = 0
  let sum = 0
  while (j < n) {
    let k = j
    j = j + 1
    sum = sum + k
  }
  print("alias:  ${sum}\n")

  // The same shape carried through a branch, so the read sits in a different
  // block from the increment. Prints 10, not 15.
  let a = 0
  let acc = 0
  while (a < n) {
    let prev = a
    a = a + 1
    if (prev < 100) {
      acc = acc + prev
    }
  }
  print("branch: ${acc}\n")

  // Carried OUT of the loop by a break after the increment. Prints 2, not 3.
  let b = 0
  let out = -1
  while (b < n) {
    let seen = b
    b = b + 1
    if (seen == 2) {
      out = seen
      break
    }
  }
  print("break:  ${out}\n")

  // A nested loop whose outer counter is read after its own increment, through
  // the inner loop's exit param. Prints 0+1+2+3+4 = 10 and 5*5 = 25.
  let i = 0
  let outer = 0
  let inner = 0
  while (i < n) {
    let m = 0
    while (m < n) {
      inner = inner + 1
      m = m + 1
    }
    let was = i
    i = i + 1
    outer = outer + was
  }
  print("nested: ${outer} ${inner}\n")

  // The plain shape the optimization targets: nothing reads the counter after
  // the increment, so this one IS coalesced. Prints 10 and 5.
  let p = 0
  let plain = 0
  while (p < n) {
    plain = plain + p
    p = p + 1
  }
  print("plain:  ${plain} ${p}\n")
}
