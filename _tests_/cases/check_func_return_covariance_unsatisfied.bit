// error
// #5254: return covariance widens a function type's result to an
// interface only when the concrete result actually SATISFIES it (SPEC
// §14.3) — `Widget` declares no `intoRes()`, so `(int) => Widget` stays
// rejected as a `(int) => Reply` exactly like the non-function-type case,
// with the same E0041.
interface Reply {
  intoRes(): int,
}

class Widget {
  label: string,
}

type Handler = (int) => Reply

fn make(x: int): Widget { return Widget{ label: "w" } }

fn takesHandler(h: Handler): int { return h(1).intoRes() }

fn main() {
  print("${takesHandler(make)}\n")
}
