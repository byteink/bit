// run
// #4633: the RUNS side of the empty-variadic-slot rule, whose error side is
// _tests_/bit/checkercases/check_generic_variadic_empty_slot_bound.bit.
//
// An empty variadic slot binds its type parameter to `()`. Where the parameter
// carries an interface BOUND, `()` cannot satisfy it and the call is E0068 at
// the call site; every way of NOT reaching that is here, and if the rule
// widened by one clause none of this would compile:
//
//   - explicit type arguments supply what the empty slot could not,
//   - arguments in the slot bind the element type normally,
//   - an EMPTY interface bound is one `()` does satisfy,
//   - an unbound type parameter promises nothing.
//
// The spread is spelled `joinAll<Tag>("+", ...ts)` on purpose: a spread binds
// NOTHING today whatever its element type, so the inferred `joinAll("+", ...ts)`
// is `joinAll<()>` and E0092 inside the body on main and on this branch alike.
// That is a second, separate route to the degenerate instantiation and it has
// its own ticket; this file pins only what this one fixes.
//
// `joinAll<Tag>("-")` is what the diagnostic tells the user to write, so it
// running is half of that diagnostic being correct.
interface Named {
  label(): string,
}

interface Anything {}

class Tag {
  export label(): string {
    return "tag"
  }
}

fn joinAll<T: Named>(sep: string, ...xs: T): string {
  let s = ""
  for x of xs {
    s = s + x.label() + sep
  }
  return s
}

fn countOnly<T: Named>(...xs: T): int {
  return len(xs)
}

fn anyOf<T: Anything>(...xs: T): int {
  return len(xs)
}

fn each<T>(...xs: T): int {
  return len(xs)
}

fn main() {
  print("[${joinAll<Tag>("-")}]\n")
  print("[${joinAll("-", Tag{}, Tag{})}]\n")
  print("[${joinAll<Tag>("-", Tag{})}]\n")
  let ts = [Tag{}, Tag{}, Tag{}]
  print("[${joinAll<Tag>("+", ...ts)}]\n")
  print("${countOnly<Tag>()} ${countOnly(Tag{}, Tag{})} ${anyOf()} ${each()}\n")
}
