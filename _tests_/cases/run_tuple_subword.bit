// run
// #5871: a tuple with a sub-word member explodes into words when member k
// sits at byte offset 8k under the class layout rule (`tupleWordTypes`,
// compiler/lowerexplode.bit), instead of boxing on every target. Five
// qualifying shapes — `(rune, int)`, `(bool, int)`, `(int, bool)`,
// `(f32, int)`, `(bool, string)` — each carried through the five positions
// that must all agree with the boxed convention they replace: a direct call,
// a `let`-local threaded across a loop's back edge (the join-parameter path,
// #4412's failure class), a parameter, a closure capture, and a map value.
//
// `(rune, int)` is exercised with `rune(-5)` (a negative i32, sign-extension
// through `int()` must round-trip) and U+10FFFF (1114111, the largest valid
// Unicode scalar value, exercising the top of the `rune` range) — the pair
// `decodeRune` (stdlib/strings/utf8.bit) returns.
//
// `pbbiCheck` is the control: `(bool, bool, int)` packs its members at byte
// offsets 0, 1, 8 under the same layout rule, so member 1 (offset 1) misses
// the `8k` grid and `tupleWordTypes` must keep refusing the whole tuple. It
// stays boxed, and must still print the right answer.

fn riMake(a: int): (rune, int) {
  return rune(a), a * 3
}

fn riDirect(a: int): int {
  let p = riMake(a)
  return int(p.0) + p.1
}

fn riLoop(a: int, n: int): int {
  let p = riMake(a)
  let acc = 0
  let i = 0
  while (i < n) {
    acc = acc + int(p.0) + p.1
    i = i + 1
  }
  return acc
}

fn riParam(p: (rune, int)): int {
  return int(p.0) - p.1
}

fn riClosure(a: int): int {
  let p = riMake(a)
  let f = () => int(p.0) * 2 + p.1
  return f()
}

fn riMap(a: int): int {
  let m = map<int, (rune, int)>{}
  m[0] = riMake(a)
  return int(m[0].0) + m[0].1
}

fn biMake(b: bool, n: int): (bool, int) {
  return b, n
}

fn biDirect(b: bool, n: int): int {
  let p = biMake(b, n)
  if (p.0) {
    return p.1 + 1
  }
  return p.1 - 1
}

fn biLoop(b: bool, n: int, iters: int): int {
  let p = biMake(b, n)
  let acc = 0
  let i = 0
  while (i < iters) {
    if (p.0) {
      acc = acc + p.1
    } else {
      acc = acc - p.1
    }
    i = i + 1
  }
  return acc
}

fn biParam(p: (bool, int)): int {
  if (p.0) {
    return p.1 * 2
  }
  return p.1 * -2
}

fn biClosure(b: bool, n: int): int {
  let p = biMake(b, n)
  let f = () => {
    if (p.0) {
      return p.1 + 100
    }
    return p.1 - 100
  }
  return f()
}

fn biMap(b: bool, n: int): int {
  let m = map<int, (bool, int)>{}
  m[0] = biMake(b, n)
  if (m[0].0) {
    return m[0].1 + 1
  }
  return m[0].1 - 1
}

fn ibMake(n: int, b: bool): (int, bool) {
  return n, b
}

fn ibDirect(n: int, b: bool): int {
  let p = ibMake(n, b)
  if (p.1) {
    return p.0 + 1
  }
  return p.0 - 1
}

fn ibLoop(n: int, b: bool, iters: int): int {
  let p = ibMake(n, b)
  let acc = 0
  let i = 0
  while (i < iters) {
    if (p.1) {
      acc = acc + p.0
    } else {
      acc = acc - p.0
    }
    i = i + 1
  }
  return acc
}

fn ibParam(p: (int, bool)): int {
  if (p.1) {
    return p.0 * 2
  }
  return p.0 * -2
}

fn ibClosure(n: int, b: bool): int {
  let p = ibMake(n, b)
  let f = () => {
    if (p.1) {
      return p.0 + 100
    }
    return p.0 - 100
  }
  return f()
}

fn ibMap(n: int, b: bool): int {
  let m = map<int, (int, bool)>{}
  m[0] = ibMake(n, b)
  if (m[0].1) {
    return m[0].0 + 1
  }
  return m[0].0 - 1
}

fn fiMake(x: f32, n: int): (f32, int) {
  return x, n
}

fn fiDirect(x: f32, n: int): f32 {
  let p = fiMake(x, n)
  return p.0 + f32(p.1)
}

fn fiLoop(x: f32, n: int, iters: int): f32 {
  let p = fiMake(x, n)
  let acc: f32 = 0.0
  let i = 0
  while (i < iters) {
    acc = acc + p.0 + f32(p.1)
    i = i + 1
  }
  return acc
}

fn fiParam(p: (f32, int)): f32 {
  return p.0 * f32(p.1)
}

fn fiClosure(x: f32, n: int): f32 {
  let p = fiMake(x, n)
  let f = () => p.0 + f32(p.1) * 2.0
  return f()
}

fn fiMap(x: f32, n: int): f32 {
  let m = map<int, (f32, int)>{}
  m[0] = fiMake(x, n)
  return m[0].0 + f32(m[0].1)
}

fn bsMake(b: bool, s: string): (bool, string) {
  return b, s
}

fn bsDirect(b: bool, s: string): string {
  let p = bsMake(b, s)
  if (p.0) {
    return "T:" + p.1
  }
  return "F:" + p.1
}

fn bsLoop(b: bool, s: string, iters: int): string {
  let p = bsMake(b, s)
  let acc = ""
  let i = 0
  while (i < iters) {
    if (p.0) {
      acc = acc + p.1
    }
    i = i + 1
  }
  return acc
}

fn bsParam(p: (bool, string)): string {
  if (p.0) {
    return p.1 + "!"
  }
  return p.1 + "?"
}

fn bsClosure(b: bool, s: string): string {
  let p = bsMake(b, s)
  let f = () => {
    if (p.0) {
      return p.1 + "X"
    }
    return p.1 + "Y"
  }
  return f()
}

fn bsMap(b: bool, s: string): string {
  let m = map<int, (bool, string)>{}
  m[0] = bsMake(b, s)
  if (m[0].0) {
    return m[0].1 + "!"
  }
  return m[0].1 + "?"
}

// The control (#5871's "why 8k" paragraph): member 1 of `(bool, bool, int)`
// sits at byte offset 1, off the `8k` grid, so the whole tuple must stay
// boxed and still answer correctly.
fn pbbiMake(a: bool, b: bool, n: int): (bool, bool, int) {
  return a, b, n
}

fn pbbiCheck(a: bool, b: bool, n: int): int {
  let p = pbbiMake(a, b, n)
  let r = n
  if (p.0) {
    r = r + 1
  }
  if (p.1) {
    r = r + 10
  }
  return r
}

fn main() {
  print("riDirect(-5)=${riDirect(-5)} riDirect(U+10FFFF)=${riDirect(1114111)}\n")
  print("riLoop(-5)=${riLoop(-5, 4)} riLoop(U+10FFFF)=${riLoop(1114111, 3)}\n")
  print("riParam(-5)=${riParam(riMake(-5))} riParam(U+10FFFF)=${riParam(riMake(1114111))}\n")
  print("riClosure(-5)=${riClosure(-5)} riClosure(U+10FFFF)=${riClosure(1114111)}\n")
  print("riMap(-5)=${riMap(-5)} riMap(U+10FFFF)=${riMap(1114111)}\n")

  print("biDirect=${biDirect(true, 10)},${biDirect(false, 10)}\n")
  print("biLoop=${biLoop(true, 5, 3)},${biLoop(false, 5, 3)}\n")
  print("biParam=${biParam(biMake(true, 7))},${biParam(biMake(false, 7))}\n")
  print("biClosure=${biClosure(true, 7)},${biClosure(false, 7)}\n")
  print("biMap=${biMap(true, 10)},${biMap(false, 10)}\n")

  print("ibDirect=${ibDirect(20, true)},${ibDirect(20, false)}\n")
  print("ibLoop=${ibLoop(6, true, 4)},${ibLoop(6, false, 4)}\n")
  print("ibParam=${ibParam(ibMake(9, true))},${ibParam(ibMake(9, false))}\n")
  print("ibClosure=${ibClosure(3, true)},${ibClosure(3, false)}\n")
  print("ibMap=${ibMap(20, true)},${ibMap(20, false)}\n")

  print("fiDirect=${fiDirect(1.5, 4) == f32(5.5)}\n")
  print("fiLoop=${fiLoop(1.5, 4, 3) == f32(16.5)}\n")
  print("fiParam=${fiParam(fiMake(2.0, 3)) == f32(6.0)}\n")
  print("fiClosure=${fiClosure(1.5, 4) == f32(9.5)}\n")
  print("fiMap=${fiMap(1.5, 4) == f32(5.5)}\n")

  print("bsDirect=${bsDirect(true, "hi")}|${bsDirect(false, "lo")}\n")
  print("bsLoop=${bsLoop(true, "ab", 3)}|${bsLoop(false, "ab", 3)}\n")
  print("bsParam=${bsParam(bsMake(true, "go"))}|${bsParam(bsMake(false, "go"))}\n")
  print("bsClosure=${bsClosure(true, "z")}|${bsClosure(false, "z")}\n")
  print("bsMap=${bsMap(true, "go")}|${bsMap(false, "go")}\n")

  print(
    "pbbi=${pbbiCheck(true, true, 5)},${pbbiCheck(true, false, 5)},${pbbiCheck(false, true, 5)},${pbbiCheck(
      false,
      false,
      5,
    )}\n",
  )
}
