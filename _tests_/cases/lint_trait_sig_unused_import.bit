// lint exit=1
// #6106: a trait's method SIGNATURE, field types and a namespace import used
// only inside a trait body are references too. `Opts` (a parameter type),
// `Extra` (a field type) and the namespace `h` (`h.get`) must NOT be flagged.
// `get` is imported and only ever spelled as a `.member` name and as the
// trait method's own name — declaration slots, not references — so it must
// still be flagged: the negative control.
import { Opts, Extra, get } from "./mod"
import * as h from "./other"

trait T {
  extra: Extra
  export get(o: Opts): i64 {
    return h.get(1)
  }
}

fn main() {}
