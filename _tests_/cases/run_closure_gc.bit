// run
// A closure capturing a value, kept live across a loop that allocates enough
// garbage to force real collections; the captured value must read correctly
// afterward. The precise stack walk (#1106) keeps the closure cell a root and
// its pointer map traces the captured environment, so `cap` survives every
// collection the loop triggers. This is the case removed in 3646bb7, re-added
// now that the stack maps are wired.
class Junk { v: i64 }

fn main() {
  let cap = 777
  let f = (x: i64) => x + cap
  let i = 0
  while (i < 300000) {
    let j = Junk{v: i}
    i = i + 1
  }
  print("${f(1)}\n")
}
