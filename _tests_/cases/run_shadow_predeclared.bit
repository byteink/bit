// run
// #1436: shadowing a predeclared name is LEGAL (E0048 is a warning), so a call
// must resolve to the user's declaration, not the builtin. Self-hosted
// lowerCall/checkCall/vCall matched the callee's raw SOURCE TEXT against the
// ~70-name predeclared list before consulting the resolved declaration, so every
// one of these silently got the builtin instead. `timeMonoNs` was the worst
// shape — it returned the real clock, with a clean build and no diagnostic.
// `close` was noticed only because `bit_rt_chan_close(-1)` happened to fault.
//
// One name per family that reached a different resolution site: a void builtin
// (close/eprint), a runtime primitive (timeMonoNs/fsClose/parseFloat), and a
// validator-checked §11.5 builtin (ptrOf/atomicAdd).
//
// #2984: `close` is ALSO a linked extern (`runtime/root/darwin/fs.bit`'s
// `extern fn close`), so a root-module `fn close` now hits E0096
// (SPEC §11.7) before this file's shadowing precedence is ever exercised —
// that check is correct: the collision is real regardless of `close` also
// being predeclared (#2958). Dropped from this fixture rather than renamed;
// `eprint` still covers the void-builtin family and does not collide with
// any linked extern.
fn eprint(x: i64): i64 {
  return x + 200
}
fn timeMonoNs(x: i64): i64 {
  return x + 300
}
fn fsClose(x: i64): i64 {
  return x + 400
}
fn parseFloat(x: i64): i64 {
  return x + 500
}
fn ptrOf(x: i64): i64 {
  return x + 600
}
fn atomicAdd(x: i64): i64 {
  return x + 700
}
fn main() {
  print("${eprint(5)} ${timeMonoNs(5)} ${fsClose(5)}\n")
  print("${parseFloat(5)} ${ptrOf(5)} ${atomicAdd(5)}\n")
}
