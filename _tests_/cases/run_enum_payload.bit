// run
// Sum types (§14.7): variants that carry data, constructed with arguments and
// unpacked by payload-binding `match` arms (§13.8). Covers a single payload, a
// multi-field payload, a string (GC-ref) payload, and a no-payload variant
// living in the same enum.
enum Shape {
  Circle(f64),
  Rect(f64, f64),
  Unit,
}

fn area(s: Shape): f64 {
  match (s) {
    Circle(r) => { return r * r }
    Rect(w, h) => { return w * h }
    Unit => { return 0.0 }
  }
  return 0.0
}

enum Msg { Text(string), Empty }

fn show(m: Msg): string {
  match (m) {
    Text(s) => { return s }
    Empty => { return "-" }
  }
  return "?"
}

fn main() {
  print("${area(Shape.Circle(3.0))} ${area(Shape.Rect(2.0, 5.0))} ${area(Shape.Unit)}\n")
  print("${show(Msg.Text("hi"))} ${show(Msg.Empty)}\n")
}
