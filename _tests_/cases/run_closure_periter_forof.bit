// run
// SPEC §13.1: a `for x of` binder is per-iteration too. The first loop never
// writes `x`, so the escape rule leaves it an ordinary SSA local and its IR is
// untouched — that is the case that catches an over-broad rule. The second loop
// does write its binder, so it takes a cell, and the closure made before the
// write reads it through: `11 21 31`, one cell per iteration and not one shared.
fn main() {
  let xs = [10, 20, 30]
  let ro = []() => int(0)
  for x of xs {
    ro = append(ro, () => x)
  }
  let rw = []() => int(0)
  for y of xs {
    rw = append(rw, () => y)
    y = y + 1
  }
  print("${ro[0]()} ${ro[1]()} ${ro[2]()}\n")
  print("${rw[0]()} ${rw[1]()} ${rw[2]()}\n")
}
