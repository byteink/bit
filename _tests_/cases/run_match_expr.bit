// run
// `match` as an expression (§13.8): each arm's body is an expression and the
// whole `match` yields their common type. Exercised as a return value, a `let`
// initializer, an operand inside a larger expression, a payload-binding arm over
// a generic enum, and embedded in a string interpolation.
enum Color { Red, Green, Blue }

enum Opt<T> {
  Some(T),
  None,
}

fn label(c: Color): string {
  return match (c) {
    Red => "red"
    Green => "green"
    Blue => "blue"
  }
}

fn unwrapOr(o: Opt<i64>, d: i64): i64 {
  return match (o) {
    Some(v) => v
    None => d
  }
}

fn main() {
  print("${label(Color.Green)}\n")
  print("${unwrapOr(Opt.Some(10), -1)} ${unwrapOr(Opt.None, -1)}\n")

  let score = 100 +
    match (Color.Blue) {
      Red => 1
      Green => 2
      Blue => 3
    }
  print("${score}\n")

  // one-liner, comma-separated arms, inside an interpolation
  print("pick=${match (Color.Red) { Red => 0, Green => 1, Blue => 2 }}\n")
}
