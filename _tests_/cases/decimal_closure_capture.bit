// run
// #5429: a `decimal` local captured by a closure panicked `gpSizeOpc: width
// 16` — a captured local is boxed through `allocBox`/`buildTuple`
// (compiler/lowerclosure.bit), the same anonymous-tuple-shaped object
// `decimal_tuple_member.bit`'s fix covers, plus two more instances of the
// identical mismatch in the closure-specific env pack/unpack
// (compiler/lowerfuncval.bit) and in a mutated capture's cell write
// (`localWrite`, lowerclosure.bit). Covers both a read-only capture and a
// capture the closure reassigns.
fn main() {
  let d: decimal = 9.25
  let read = () => d
  println("${read()}")

  let acc: decimal = 1.0
  let inc = () => { acc = acc + 1.0 }
  inc()
  inc()
  println("${acc}")
}
