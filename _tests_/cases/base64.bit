// run
// #2302: base64 encode/decode (RFC 4648 §4 standard, §5 URL-safe). Pins the
// RFC 4648 §10 test vectors in both directions, a full round-trip over every
// byte value 0..255 (including an embedded NUL) at each length class mod 3,
// and the invalid-input paths decodeBase64 must reject: an out-of-alphabet
// character, a length that is not a multiple of 4, and a '=' outside the
// trailing padding position.
import { encodeBase64, decodeBase64, encodeBase64Url, decodeBase64Url } from "std/crypto"
import { contains } from "std/strings"

fn bytesEqual(a: []byte, b: []byte): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

fn roundTrip(b: []byte): []byte! {
  return decodeBase64(encodeBase64(b))?
}

fn decodeFails(s: string): bool {
  decodeBase64(s) catch e {
    return true
  }
  return false
}

fn main() {
  // RFC 4648 §10 test vectors, both directions.
  let inputs = ["", "f", "fo", "foo", "foob", "fooba", "foobar"]
  let expected = ["", "Zg==", "Zm8=", "Zm9v", "Zm9vYg==", "Zm9vYmE=", "Zm9vYmFy"]
  let vectorsOk = true
  let i = 0
  while (i < len(inputs)) {
    if (encodeBase64([]byte(inputs[i])) != expected[i]) {
      vectorsOk = false
    }
    let dec = decodeBase64(expected[i]) catch []byte(0)
    if (string(dec) != inputs[i]) {
      vectorsOk = false
    }
    i = i + 1
  }
  println("vectors=${vectorsOk}")

  // Round-trip every byte value 0..255, exercised at each length class mod 3
  // (1, 2, and 3 bytes), including an embedded NUL at every value.
  let roundtripOk = true
  let v = 0
  while (v < 256) {
    let b0 = byte(v)
    let one = []byte{ b0 }
    let two = []byte{ b0, byte(255 - v) }
    let three = []byte{ b0, 0, byte(v) }
    let r1 = roundTrip(one) catch []byte(0)
    let r2 = roundTrip(two) catch []byte(0)
    let r3 = roundTrip(three) catch []byte(0)
    if (!bytesEqual(r1, one) || !bytesEqual(r2, two) || !bytesEqual(r3, three)) {
      roundtripOk = false
    }
    v = v + 1
  }
  println("roundtripAll=${roundtripOk}")

  // URL-safe round-trip (unpadded); its alphabet must carry none of the
  // standard alphabet's punctuation.
  let urlBytes = []byte{ 0xfb, 0xff, 0xbf }
  let urlEnc = encodeBase64Url(urlBytes)
  let urlDec = decodeBase64Url(urlEnc) catch []byte(0)
  let urlClean = !contains(urlEnc, "+") && !contains(urlEnc, "/") && !contains(urlEnc, "=")
  println("urlRoundtrip=${bytesEqual(urlDec, urlBytes)}")
  println("urlAlphabetClean=${urlClean}")

  // Rejection path: decodeBase64 must fail, not guess, on malformed input.
  let badChar = decodeFails("AB!=")
  let badLen = decodeFails("Zg")
  let misplacedPad = decodeFails("A=BC")
  println("badChar=${badChar}")
  println("badLen=${badLen}")
  println("misplacedPad=${misplacedPad}")
}
