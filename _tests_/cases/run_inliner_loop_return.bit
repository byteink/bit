// run
// Regression net for the inliner (#1232): a helper that carries loop state and
// returns a value must survive being inlined. Three facets the crypto epic hit,
// all silent-miscompile risks under optimization:
//   1. a loop with a CONDITIONAL accumulator (the p1 "garbage return"),
//   2. a helper returning an untyped-int literal, retyped at the call's u64,
//   3. an inlined single-block slice-returning helper feeding a loop.
// Fixed retroactively by the eviction spill-aliasing fix (1ef0b50) and the
// narrow-width codegen fix (#1158); this pins them so they cannot regress.
fn cnt(): i64 {
  let n = 0
  let c = 0
  while (n <= 64) {
    if (n < 16) {
      c = c + 1
    }
    n = n + 1
  }
  return c
}

fn feMask(): u64 { return 0x7ffffffffffff }

fn seed(): []i64 { return []i64{ 1, 2, 3, 4 } }

fn pickSum(): i64 {
  let xs = seed()
  let s = 0
  let i = 0
  while (i < len(xs)) {
    if (xs[i] > 2) {
      s = s + xs[i]
    }
    i = i + 1
  }
  return s
}

fn main() {
  let h: u64 = 0xFFFFFFFFFFFFFFFF
  print("${cnt()} ${h & feMask()} ${pickSum()}\n")
}
