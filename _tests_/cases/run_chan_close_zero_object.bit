// run
// #5910 / SPEC §13.4: every context that produces a zero value produces the
// SAME zero value. A closed-and-drained channel receive (§16.2) and a failed
// two-result type assertion (§14.4) report their miss through `ok`, exactly
// like a map miss (`run_map_miss_zero.bit`) — but the runtime word both
// report the miss with is a null REFERENCE, not the live object §13.4
// promises for a class, tuple or boxed enum. Every form below must
// materialize that live zero so the field read after it does not fault.
class Point {
  x: i64,
}

enum Shape {
  Unit,
  Circle(i64),
}

interface Named {
  name(): string,
}

class Dot {
  x: i64
  name(): string { return "dot" }
}

class Cat {
  x: i64
  name(): string { return "cat" }
}

fn describeShape(s: Shape): string {
  match (s) {
    Unit => { return "unit" }
    Circle(r) => { return "circle ${r}" }
  }
}

fn main() {
  // Two-result receive: `let (v, ok) = <- c`.
  let c1 = chan<Point>(1)
  close(c1)
  let (p1, pok1) = <- c1
  print("two-result class x=${p1.x} ok=${pok1}\n")

  let c2 = chan<(i64, i64)>(1)
  close(c2)
  let (t1, tok1) = <- c2
  print("two-result tuple ${t1.0} ${t1.1} ok=${tok1}\n")

  let c3 = chan<Shape>(1)
  close(c3)
  let (s1, sok1) = <- c3
  print("two-result enum ${describeShape(s1)} ok=${sok1}\n")

  // Single-result receive: `<- c`, no `ok` at all.
  let c4 = chan<Point>(1)
  close(c4)
  let p2 = <- c4
  print("single-result class x=${p2.x}\n")

  let c5 = chan<(i64, i64)>(1)
  close(c5)
  let t2 = <- c5
  print("single-result tuple ${t2.0} ${t2.1}\n")

  let c6 = chan<Shape>(1)
  close(c6)
  let s2 = <- c6
  print("single-result enum ${describeShape(s2)}\n")

  // select, bare binder: `case v = <- c:`.
  let c7 = chan<Point>(1)
  close(c7)
  select {
    case v = <- c7:
      print("select class x=${v.x}\n")
  }

  let c8 = chan<(i64, i64)>(1)
  close(c8)
  select {
    case v = <- c8:
      print("select tuple ${v.0} ${v.1}\n")
  }

  let c9 = chan<Shape>(1)
  close(c9)
  select {
    case v = <- c9:
      print("select enum ${describeShape(v)}\n")
  }

  // select, pair binder: `case (v, ok) = <- c:`.
  let c10 = chan<Point>(1)
  close(c10)
  select {
    case (v, ok) = <- c10:
      print("select pair class x=${v.x} ok=${ok}\n")
  }

  let c11 = chan<(i64, i64)>(1)
  close(c11)
  select {
    case (v, ok) = <- c11:
      print("select pair tuple ${v.0} ${v.1} ok=${ok}\n")
  }

  let c12 = chan<Shape>(1)
  close(c12)
  select {
    case (v, ok) = <- c12:
      print("select pair enum ${describeShape(v)} ok=${ok}\n")
  }

  // Failed two-result type assertion: `let (v, ok) = iface.(T)`. Only a class
  // or a boxed enum can be the concrete type behind an interface
  // (`vStorableInInterface`), so a tuple target has no analogous case here.
  let n1: Named = Dot{ x = 1 }
  let (miss1, mok1) = n1.(Cat)
  print("assert class x=${miss1.x} ok=${mok1}\n")
}
