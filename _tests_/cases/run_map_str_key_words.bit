// run
// #5906: a map read keyed by a `string` held as its exploded words (a
// parameter, a call result, an `s[lo:hi]` view) goes to `map_get_str` /
// `map_slot_str` as `(ptr, len)` instead of boxing a header first. A key
// stored through a header must be found through its words and the other way
// round, including the empty string, a miss, a tombstone, a nil map and a
// float value (the returned word is bitcast back).

fn get(m: map<string, int>, k: string): int {
  return m[k]
}

fn has(m: map<string, int>, k: string): string {
  let (v, ok) = m[k]
  return "${v}/${ok}"
}

fn getf(m: map<string, f64>, k: string): f64 {
  return m[k]
}

fn name(i: int): string {
  return "k${i}"
}

fn main() {
  let m = map<string, int>{}
  m["alpha"] = 1
  m[name(2)] = 2
  let s = "xalphay"
  print("${get(m, "alpha")} ${get(m, s[1:6])} ${get(m, "k2")} ${get(m, name(2))}\n")
  print("${get(m, "gamma")} ${get(m, s[1:5])} ${has(m, s[1:6])} ${has(m, "zzz")}\n")
  delete(m, "alpha")
  print("${get(m, s[1:6])} ${has(m, s[1:6])} ${get(m, name(2))}\n")
  m[""] = 7
  print("${get(m, "")} ${get(m, s[3:3])} ${has(m, s[0:0])}\n")
  let fm = map<string, f64>{}
  fm[name(1)] = 3.5
  print("${getf(fm, "k1")} ${getf(fm, s[0:1])}\n")
  let nm: map<string, int> = nil
  print("${get(nm, "a")} ${has(nm, "a")}\n")
}
