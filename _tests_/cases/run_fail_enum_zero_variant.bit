// run
// #2939: `fail`ing a bare enum's discriminant-0 variant was silently swallowed
// as "no error" by both `catch` forms. compiler/lowerctrl.bit's err slot
// published/read the enum's raw tag word directly and compared it against a
// zero "no error" sentinel (`neNil`'s `ConstNil`) — a real `fail` of the
// first-declared variant (tag 0) was byte-for-byte indistinguishable from no
// error at all, so the caller silently took the OK path with a zero value.
// The second-declared variant (tag 1) always worked, which is what made this
// easy to miss: `enum Kind { NotFound, Invalid }` is the idiomatic ordering,
// and `NotFound` — the swallowed one — is the common case for any lookup.
//
// Covers both handling forms: the default form (`catch 99`, which never binds
// or reads the error value at all) and the bind form (`catch e { ... }`, which
// additionally proves the caught value is the RIGHT value, not just present —
// `e` must equal `Kind.NotFound`, not some other bit pattern the fix could
// have produced by accident). Deliberately no method call on `e` — a bare
// enum's method dispatch is broken independently of this bug (#2944) and is
// out of scope here; equality is enough to prove the value round-trips.
enum Kind {
  NotFound,
  Invalid,
}

fn failNotFound(): int!Kind {
  fail Kind.NotFound
}

fn failInvalid(): int!Kind {
  fail Kind.Invalid
}

fn main() {
  // The bug: discriminant 0.
  let a = failNotFound() catch 99
  println("default_notfound=${a}")
  // The control: discriminant 1 always worked, and must keep working.
  let b = failInvalid() catch 99
  println("default_invalid=${b}")
  let c = failNotFound() catch e {
    let isNotFound = e == Kind.NotFound
    println("bind_notfound_matches=${isNotFound}")
    100
  }
  println("bind_notfound=${c}")
}
