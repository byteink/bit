// panic
// #3982: `lowerDecimalDivide` (lowerdecimaldiv.bit) checks the divisor's
// 96-bit magnitude for zero before doing any scale-up or division work, and
// panics with its own message (`emitDecimalDivZeroPanic`) rather than
// reusing "decimal arithmetic overflowed" — dividing by zero is not an
// overflow, and SPEC §13.5 already gives integer division by zero its own
// distinct panic too.
fn main() {
  let a: decimal = 5.5
  let z: decimal = 0
  print("start\n")
  print("q=${a / z}\n")
  print("unreachable\n")
}
