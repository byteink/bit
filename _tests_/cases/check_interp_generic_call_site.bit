// error
// #3827: E0073's primary span sits inside the generic body, which for a
// stdlib generic (std/testing's `eq`) names a file the caller does not own.
// The checker now ADDS a note pointing back at the instantiating call, the
// way Rust/C++ report monomorphization errors — the primary span and message
// are unchanged. Two lines apart on purpose, so the primary span (inside
// `show1`) and the note (at the call, line 12) cannot be confused for the
// same location.
class Bad { x: i64 }
fn show1<T>(x: T) {
  print("${x}\n")
}
fn main() {
  show1(Bad{ x: 1 })
}
