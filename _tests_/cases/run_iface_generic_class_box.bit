// run
// #4675: a nominal instantiation of a generic class, converted to an interface
// value. The COMPILER exited 0 and emitted a program that branched to address
// 0 on the first dispatch -- `bit: fatal signal: segmentation fault`, rc=2.
//
// Pass A3' (`collectMethodEntries`, lowerdriver.bit) keyed each method-table
// entry on `userTypeLookup(recvName)`, which for a generic receiver answers the
// TEMPLATE's type id. `gc_alloc` carries the INSTANCE's id, so `methodTableOf`
// (emit.bit) found no table for it, the emitted TypeInfo came out with
// `methods_len == 0`, and `bit_rt_iface_lookup` (runtime/root/iface.bit)
// answered the dispatch with 0. Pass A3 had emitted the body all along, under
// `plain$t<instance>` -- the table simply named a key nothing asks for.
//
// `bit check` is clean for every line below, on the broken compiler too: the
// defect is entirely in lowering, so a checker fixture cannot see it.
interface P {
  plain(): int,
}

interface Gi {
  mine(): int,
}

// `mine` is the method whose signature mentions the class's own type parameter:
// its slot must name the SUBSTITUTED instance body, not the template.
class Holder<U> {
  slot: U
  export plain(): int { return 7 }
  export mine(): U { return this.slot }
}

// The control: a non-generic class reaching the same interface. Its receiver id
// IS its type id, so this dispatched correctly before the fix -- a failure here
// is not #4675.
class Plain {
  export plain(): int { return 1 }
}

fn take(p: P): int {
  return p.plain()
}

fn takeGi(g: Gi): int {
  return g.mine()
}

// Boxed through a generic function's RESULT: `mk(6)` types the value as the
// substituted `Holder<i64>`, with no generic body at the conversion site.
fn mk<T>(v: T): Holder<T> {
  return Holder<T>{ slot: v }
}

fn main() {
  // Direct nominal instantiation, boxed.
  let d = Holder<i64>{ slot: 9 }
  print("${take(d)}\n")
  // Through a generic function's return.
  print("${take(mk(5))} ${takeGi(mk(6))}\n")
  // A method whose signature mentions U, on a direct instantiation.
  print("${takeGi(Holder<i64>{ slot: 4 })}\n")
  // A SECOND instantiation of the same generic, boxed to the same interface:
  // each instance needs its own table, so one shared table would lose one.
  let b = Holder<bool>{ slot: true }
  print("${take(b)} ${take(d)}\n")
  print("${take(Plain{})}\n")
}
