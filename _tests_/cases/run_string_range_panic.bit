// panic
// #2014, the string slice: `s[lo:hi]` outside `0 <= lo <= hi <= len` must panic
// with `string bounds out of range` (SPEC §12.6, §18.4). `bit_rt_string_slice`
// returned 0, indistinguishable from `""`, so an over-long substring silently
// produced the empty string.
//
// `cap` is not the bound here and cannot be: a string slice COPIES its bytes
// (a string header's `ptr` is an interior pointer into its own object, so a
// shared view could not keep the backing alive), and a copy has no spare
// capacity to reslice into.
import { args } from "std/os"

fn oob(): int { return len(args()) + 8 }

fn main() {
  let s = "ab"
  print("start\n")
  let v = s[0:oob()]
  print("survived sub=[${v}]\n")
}
