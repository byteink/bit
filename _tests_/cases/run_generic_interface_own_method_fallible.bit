// run
// The fallible variant of #5276: a generic interface method returning `T!`
// is exactly where a wrapper layer stops looking (#5264). Once the method
// table is copied onto the instantiation at all, `copyInstMethod` substitutes
// the WHOLE `(params) => result` type through `env` — `T!` included — so this
// pins that the fallible result needs no separate handling, only the same fix.
//
// `V`, not `T`, on the implementer: see run_generic_interface_own_method.bit's
// comment — a same-named sibling generic is a separate bug filed on #5276.
interface Store<T> {
  get(key: string): T!,
}
class E {
  m: string

  export message(): string {
    return this.m
  }
}
class ArrayStore<V> {
  v: V
  get(key: string): V! {
    fail E{ m = "missing" }
  }
}
fn main() {
  let s: Store<i64> = ArrayStore<i64>{ v = 42 }
  let v = s.get("k") catch e {
    print("err ${e.message()}\n")
    return
  }
  print("unreachable ${v}\n")
}
