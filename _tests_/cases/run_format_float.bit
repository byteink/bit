// run
// #2660: locks std/strings's fixed-decimal float formatter (#2658) and its
// rune-counting padding helpers (#2659) with one golden case. Each line
// prints one call so a regression in any single case is visible by line
// number rather than lost in an aggregate pass/fail.
//
// The float cases cover: a value that needs no rounding (1234.5), an
// integer-valued float (10.0), an exact binary fraction (150.15's rounding
// is exercised on the DECIMAL text, not scaled arithmetic — see
// stdlib/strings/format.bit's header comment on why `i64(150.15 * 100.0)`
// is the wrong approach), a repeating fraction (1.0/3.0), the sign-from-input
// rule on a value that rounds to all-zero digits (-0.004), carry propagation
// through every digit (9.999 -> 10.00), and decimals == 0 dropping the point
// entirely (2.5 -> "3", half away from zero).
//
// The padding cases cover: padLeft widening a 1-rune string with 3 leading
// spaces, padRight widening the same string with 3 trailing spaces, and
// padLeft on a string already at/over width returned unchanged.
import { formatFloat, padLeft, padRight } from "std/strings"

fn main() {
  println(formatFloat(1234.5, 2))
  println(formatFloat(10.0, 2))
  println(formatFloat(150.15, 2))
  println(formatFloat(1.0 / 3.0, 2))
  println(formatFloat(-0.004, 2))
  println(formatFloat(9.999, 2))
  println(formatFloat(2.5, 0))
  println(padLeft("7", 4))
  println(padRight("7", 4))
  println(padLeft("abcd", 2))
}
