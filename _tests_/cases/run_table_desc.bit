// run
// SPEC §10.5, #5051: `@table` on a class synthesises `tableDescriptor():
// []FieldDesc` from the class's own fields, in declaration order. A field
// attribute whose name does NOT resolve to a function is RECORDED in the
// descriptor -- `@id`, `@unique` and `@index` below, none of them declared
// anywhere in this file. One that DOES resolve, `@maxLen`, keeps #3879's
// behaviour exactly: it is CALLED from `validateFields()` and never appears
// in the descriptor at all -- proven twice over, since this program would
// not even COMPILE if `@id`/`@unique`/`@index` had been routed to a call
// (there is no function named any of them), and `bio`'s printed descriptor
// entry below carries no attributes at all.
import { FieldDesc, AttrDesc } from "std/sql"

class validationError {
  text: string

  message(): string {
    return this.text
  }
}

fn maxLen(s: string, n: int): ()! {
  if (len(s) > n) {
    fail validationError{ text: "too long" }
  }
}

fn longBio(): string {
  let s = ""
  let i = 0
  while (i < 260) {
    s = s + "a"
    i = i + 1
  }
  return s
}

@table class User {
  @id
  id: i64
  @unique
  @index
  email: string
  @maxLen(255)
  bio: string
}

fn describe(u: User) {
  for f of u.tableDescriptor() {
    print("${f.name}:${f.typeName} attrs=[")
    let i = 0
    while (i < len(f.attrs)) {
      if (i > 0) {
        print(",")
      }
      print("@${f.attrs[i].name}")
      i = i + 1
    }
    print("]\n")
  }
}

fn report(u: User) {
  u.validateFields() catch e {
    print("validate: ${e.message()}\n")
    return
  }
  print("validate: ok\n")
}

fn main() {
  let u = User{ id: 1, email: "a@b.com", bio: "short" }
  describe(u)
  report(u)
  report(User{ id: 2, email: "c@d.com", bio: longBio() })
}
