// run
// `==`/`!=` over string VIEWS, the shape #4443's `bit_rt_string_eq_words`
// lowering actually meets. run_string_eq.bit next door compares whole literal
// strings, which are always 8-aligned and never interior, so it cannot see any
// of this: an unaligned `ptr`, a word loop with a byte tail, a length-only
// answer, or a backing that has to stay rooted across the call while only the
// interior pointer and the length travel to it.
fn main() {
  let s = "abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz"

  // Every alignment of the left view against a right view that is equal by
  // content but starts 26 bytes later, so `ptr` is interior on both sides and
  // the two are congruent mod 8 only when the offset is.
  let off = 0
  while (off < 8) {
    let a = s[off:off + 12]
    let b = s[off + 26:off + 38]
    let d = s[off + 25:off + 37]
    if (a == b) {
      print("y")
    } else {
      print("n")
    }
    if (a == d) {
      print("Y")
    } else {
      print("n")
    }
    off = off + 1
  }
  print(" ")

  // A view long enough for the word loop plus a byte tail (13 = 1 word + 5),
  // differing only in the LAST byte, which is the case a word-wise compare
  // that forgot its tail would call equal.
  let p = s[0:13]
  let q = s[26:39]
  let r = s[26:38] + "Z"
  if (p == q) {
    print("wordtail-eq ")
  }
  if (p != r) {
    print("lastbyte-ne ")
  }

  // Length decides before a byte is read, and BOTH orders are tested: a
  // one-sided length test (`an < bn` rather than `an != bn`) answers the
  // shorter-first pair correctly and then compares `an` bytes of a `bn`-byte
  // right side, reading past its end.
  if (s[0:4] != s[0:5]) {
    print("len-ne ")
  }
  if (s[0:5] != s[0:4]) {
    print("len-ne-rev ")
  }
  if (s[0:16] != s[0:13]) {
    print("len-ne-word ")
  }
  let empty = s[3:3]
  if (empty == "") {
    print("empty-eq ")
  }
  if (empty != s[3:4]) {
    print("empty-ne ")
  }

  // A switch on a view: `caseTest` shares `lowerCompare`, so the label test
  // takes the same exploded-word path as `==` and must agree with it (#2407).
  let k = s[8:11]
  switch (k) {
    case "abc":
      {
        print("switch-BAD\n")
      }
    case "ijk":
      {
        print("switch-ijk\n")
      }
    default:
      {
        print("switch-DEFAULT\n")
      }
  }

  // The backing must stay rooted across the comparison while only the
  // interior `ptr` and the `len` are passed (#4406). Allocating hard inside
  // the loop gives the collector every chance to free `base` if lowering
  // dropped the keepalive edge.
  let hits = 0
  let i = 0
  while (i < 20000) {
    let junk = "x${i}"
    let u = s[i % 8:i % 8 + 12]
    let v = s[i % 8 + 26:i % 8 + 38]
    if (u == v) {
      hits = hits + 1
    }
    if (len(junk) == 0) {
      print("unreachable")
    }
    i = i + 1
  }
  print("${hits}\n")
}
