// run
// #4597: an EMPTY variadic slot binds nothing, and that is not a program error.
// `each()` and `tally("b")` check and run on main; they became
// `error[E0068] cannot infer type parameter 'T'` the moment a generic variadic
// call reached `vGenericGap`, which had been measured only on the fixed-arity
// shape. The fix tells "unbound because no argument reached the slot" apart
// from a gap the program owns (`vGapOnlyEmptyRest`, compiler/validategeneric.bit)
// instead of leaving every generic variadic call unchecked, so this file is the
// no-false-positive half: if the carve-out narrowed, none of it would compile.
//
// Every way the slot can be empty or over-full is here — no fixed prefix, a
// fixed prefix that binds nothing, explicit type arguments, a second type
// parameter only the empty slot could bind, a spread, and the ordinary
// individual arguments that DO bind the element type.
fn each<T>(...xs: T): int {
  return len(xs)
}

fn tally<T>(label: string, ...xs: T): int {
  return len(label) + len(xs)
}

fn pairs<T>(first: T, ...rest: T): int {
  return 1 + len(rest)
}

fn kv<K, V>(k: K, ...vs: V): int {
  return len(k) + len(vs)
}

fn main() {
  print("${each()}\n")
  print("${tally("b")}\n")
  print("${each<int>()}\n")
  print("${kv("ab")}\n")
  print("${each(1, 2, 3)}\n")
  print("${each("a", "b")}\n")
  print("${tally("xy", 1, 2)}\n")
  print("${pairs(1, 2, 3)}\n")
  print("${pairs("a")}\n")
  let ys = [1, 2, 3]
  print("${each(...ys)}\n")
}
