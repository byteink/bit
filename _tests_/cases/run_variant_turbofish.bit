// run
// Explicit type arguments at a variant site — turbofish `Enum<Args>.Variant`
// (§14.7) — needs no expected type: `Opt<i64>.None`, `Opt<i64>.Some(5)`,
// `Opt<string>.Some("hi")`. And left-to-right inference threads a solved type
// parameter into a later argument, so a recursive `List.Cons(1, .., List.Nil)`
// types with no annotation at all (the tail's `List.Nil` inherits `i64`).
enum Opt<T> {
  Some(T)
  None
}

enum List<T> {
  Cons(T, List<T>)
  Nil
}

fn unwrap(o: Opt<i64>): i64 {
  return match (o) {
    Some(v) => v
    None    => -1
  }
}

fn sum(xs: List<i64>): i64 {
  return match (xs) {
    Cons(h, t) => h + sum(t)
    Nil        => 0
  }
}

fn main() {
  let a = Opt<i64>.None
  let b = Opt<i64>.Some(5)
  print("${unwrap(a)} ${unwrap(b)}\n")

  match (Opt<string>.Some("hi")) {
    Some(s) => print("${s}\n")
    None    => print("-\n")
  }

  let xs = List.Cons(1, List.Cons(2, List.Cons(3, List.Nil)))
  print("${sum(xs)}\n")
}
