// run
// #6112 (SPEC §10.3): a zero-argument function call as a default, the
// #6033/pkg/redis shape (`noLimit()`) the ticket was filed over. Evaluated
// at the call site below, exactly like any other omitted-argument default.

fn noLimit(): int {
  return -1
}

fn f(limit: int = noLimit()): int {
  return limit
}

fn main() {
  print("${f()}\n")
}
