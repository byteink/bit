// run
// #6112 (SPEC §10.3): a class literal default, and the property the ticket
// pins by name -- "a default that constructs a class gets a fresh instance
// per call". `f()` is called twice; mutating the first call's `Box` must
// never be visible through the second's, which it would be if the default
// were computed once and shared rather than re-lowered at every omission
// (`lowerDeclaredDefault`, lowerslicefill.bit).

class Box {
  n: int,
}

fn f(b: Box = Box{ n = 1 }): Box {
  return b
}

fn main() {
  let a = f()
  a.n = 99
  let b = f()
  print("${a.n} ${b.n}\n")
}
