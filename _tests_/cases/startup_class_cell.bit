// run
// #6481: a module cell holds a class, a tuple or a boxed enum. A `let` set at
// startup is a pool whose fields `main` writes and reads back through the same
// cell; a `const` set at startup is read-only through (E0062) and is only read.
// A cell with no initializer holds the §13.4 zero value, a built record, not a
// null.
class Pool {
  name: string,
  size: int,
  slots: []string,
}

enum Mode {
  Idle,
  Busy(int),
}

fn makePool(name: string): Pool {
  return Pool{ name = name, size = 2, slots = []string(2) }
}

let pool = Pool{ name = "main", size = 4, slots = []string(4) }
const fixed = makePool("fixed")
let spare = makePool("spare")
let blank: Pool
let pair: (int, string)
let mode: Mode
let next = (7, makePool("next"))
let current = Mode.Busy(3)

fn describe(m: Mode): string {
  match (m) {
    Idle => return "idle"
    Busy(n) => return "busy ${n}"
  }
}

fn main() {
  pool.size = 5
  pool.slots[1] = "one"
  spare.name = "spare-${spare.size}"
  blank.size = 9
  println("pool ${pool.name} ${pool.size} ${len(pool.slots)} ${pool.slots[1]}")
  println("spare ${spare.name} fixed ${fixed.name} ${fixed.size}")
  println("blank '${blank.name}' ${blank.size} ${len(blank.slots)}")
  println("pair ${pair.0} '${pair.1}'")
  println("mode ${describe(mode)} ${describe(current)}")
  println("next ${next.0} ${next.1.name}")
}
