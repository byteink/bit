// run
// #4075: the spring gap (docs/stdlib/time.md, "Daylight saving: the two
// awkward days"). On 2026-03-29 in Europe/London the clock goes straight
// from 01:00 to 02:00; the wall times 01:00:00..01:59:59.999999999 never
// happen. `NaiveDateTime.inZone` is total and pushes forward by the size
// of the gap: 01:30 becomes 02:30, at the post-transition offset, +01:00
// (BST). Cross-checked against this host's own `zdump -v Europe/London`:
// the 2026 spring transition is at 2026-03-29T01:00:00Z, GMT(0) -> BST(3600).
import { date, zone } from "std/time"

fn main() {
  let london = zone("Europe/London") catch e {
    println("zone(Europe/London) failed: ${e.message()}")
    return
  }
  let d = date(2026, 3, 29) catch e {
    println("date failed: ${e.message()}")
    return
  }
  let naive = d.atTime(1, 30, 0) catch e {
    println("atTime failed: ${e.message()}")
    return
  }

  let dt = naive.inZone(london)
  println("pushedHour=${dt.hour()}")
  println("pushedMinute=${dt.minute()}")
  println("pushedDay=${dt.day()}")
  println("offset=${dt.offset()}")
  println("isDst=${dt.isDst()}")
  println("toString=${dt.toString()}")

  let ts = dt.toTimestamp() catch e {
    println("toTimestamp failed: ${e.message()}")
    return
  }
  println("timestamp=${ts.toString()}")

  // The instant the gap-pushed reading names must itself read back as
  // 02:30 BST, not 01:30 -- there is no valid offset that makes 01:30
  // itself a real local reading on this day.
  let back = ts.inZone(london)
  println("roundTripEqual=${back.toString() == dt.toString()}")
}
