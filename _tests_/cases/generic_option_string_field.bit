// run
// #6679: a generic `Option<T>` read through a `match` expression typed its join
// block from the PREVIOUS instance of the same template. `lowerMatchExpr`
// (lowermatch.bit) takes the match's type from `checkMatch`, which is the first
// arm body's — for `Some(v) => v` that is `v`'s `declTypes` entry, and an earlier
// instance (`unwrapOr<i64>`) had left `i64` in it. The `string` instance then
// built its join param as `i64` and IR verification refused the program
// ("sets the string view's base from a value that is not a GC reference").
// Every function below is instantiated at `i64` BEFORE `string`, the order that
// failed, and again in the other order.
class Box<T> {
  v: Option<T>,
}

fn wrapBox<T>(x: T): Box<T> {
  return Box<T>{ v = Option.Some(x) }
}

fn viaMatch<T>(o: Option<T>, d: T): T {
  match (o) {
    Some(v) => return v
    None => return d
  }
}

// A match expression nested in a match expression: the outer result type reads
// the INNER arm's binder (`w`) before the inner match has bound it.
fn nested<T>(a: Option<T>, b: Option<T>, d: T): T {
  return match (a) {
    Some(_) => match (b) {
      Some(w) => w
      None => d
    }
    None => d
  }
}

fn main() {
  // The ticket's shape: a generic class field read through `unwrapOr`.
  let n = wrapBox<int>(7)
  println("${unwrapOr(n.v, -1)}")
  let b = wrapBox<string>("g")
  println("${unwrapOr(b.v, "none")}")
  // The direct literal, no generic constructor function.
  let d = Box<string>{ v = Option.Some("direct") }
  println("${unwrapOr(d.v, "none")}")
  let e = Box<string>{ v = Option.None }
  println("${unwrapOr(e.v, "none")}")
  // The statement form of the same read.
  match (b.v) {
    Some(s) => println("match ${s}")
    None => println("match none")
  }
  // `match` expression in a generic function, int instance first.
  let i: Option<int> = Option.Some(3)
  let s: Option<string> = Option.Some("viaMatch")
  println("${viaMatch(i, 0)}")
  println(viaMatch(s, "none"))
  println("${nested(i, i, 0)}")
  println(nested(s, s, "none"))
  // Reverse order: string instance first, then int.
  let s2: Option<string> = Option.Some("rev")
  let i2: Option<int> = Option.Some(9)
  println(unwrapOr(s2, "none"))
  println("${unwrapOr(i2, 0)}")
}
