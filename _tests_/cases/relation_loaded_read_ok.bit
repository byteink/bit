// run
//
// #5271: the same relation field, LOADED -- a real slice assigned before
// the read -- prints its length with no panic. `markLoaded` is not needed
// (#5053's own decision comment): an ordinary field assignment through
// `lowerFieldStore` writes a real slice header, which is never
// classrelationattr.bit's `relationUnloadedSentinel`, so
// compiler/loweraccess.bit's read-side check passes it straight through.
import { FieldDesc, AttrDesc } from "std/sql"

class Order {
  id: i64,
}

@table class User {
  @id
  id: i64
  @hasMany("userId")
  orders: []Order
}

fn main() {
  let u = User{ id = 1 }
  u.orders = [Order{ id = 10 }, Order{ id = 11 }]
  print("${len(u.orders)}\n")
}
