// run
// #6121: a named argument may skip an EARLIER defaulted parameter while
// naming a LATER one — `f("x", nx = true)` fills `ttl` from its own default
// exactly as the fully spelled-out positional call `f("x", 0, true)` would.
// This is not simply "trailing" fill: `ttl` (index 1) stays unfilled while
// `nx` (index 2) IS filled by name, so the compiler must fill the gap by
// declared index, not by walking from the end of the written argument list.
fn f(k: string, ttl: int = 0, nx: bool = false) {
  println("${k} ${ttl} ${nx}")
}

fn main() {
  f("x", nx = true)
  f("y", ttl = 5)
  f("z")
}
