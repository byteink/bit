// run
// String compound-assign (#4438): `+=` on a `string` lvalue must concatenate
// via the runtime `string_concat` call, never a raw pointer `add` over two
// boxed string headers. Before the fix this printed the empty string or
// panicked reading a garbage pointer NONDETERMINISTICALLY -- different
// results across runs of the SAME binary -- while a bare `rc=0` golden case
// could not see the corruption at all: pinning the concatenated TEXT and its
// LENGTH is load-bearing here, not incidental. Covers every lvalue shape
// compound-assign supports: local, class field, map entry, slice element.
class Box { s: string }

fn main() {
  let local = "ab"
  local += "cd"
  print("local=[${local}] len=${len(local)}\n")

  let b = Box{ s: "ab" }
  b.s += "cd"
  print("field=[${b.s}] len=${len(b.s)}\n")

  let m = map<string, string>{ "k": "ab" }
  m["k"] += "cd"
  print("map=[${m["k"]}] len=${len(m["k"])}\n")

  let xs = ["ab", "xy"]
  xs[0] += "cd"
  print("slice=[${xs[0]}] len=${len(xs[0])}\n")
}
