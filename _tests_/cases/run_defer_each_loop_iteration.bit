// run
// SPEC §18.5 (#7745): every EXECUTION of a `defer` schedules its own call,
// evaluated at the defer statement, and all of them run LIFO when the function
// returns. A `defer` in a loop used to share one flag and one argument slot per
// statement, so five iterations ran ONE call (the last iteration's arguments)
// and leaked the other four handles at exit 0.
class Handle {
  id: int
  close() {
    print("close ${this.id}\n")
  }
}

class Boom {
  message(): string {
    return "boom"
  }
}

fn release(id: int) {
  print("release ${id}\n")
}

// Open five handles, defer each close: all five close, newest first, each with
// its own receiver, and the function-level defers around the loop keep their
// place in the order.
fn closeAll() {
  defer print("closeAll first\n")
  let k = 0
  while (k < 5) {
    let h = Handle{ id = k }
    defer h.close()
    k = k + 1
  }
  defer print("closeAll last\n")
  print("closeAll body\n")
}

// Two defers per iteration (a call and a block) interleave across iterations,
// a `continue` skips the defers after it, and a defer before and after the loop
// bracket the whole run.
fn mixed() {
  defer release(100)
  let i = 0
  while (i < 4) {
    i = i + 1
    if (i == 2) {
      continue
    }
    let j = i
    defer release(j)
    defer {
      print("block ${j}\n")
    }
  }
  defer release(200)
  print("mixed body\n")
}

fn step(n: int): int! {
  if (n == 3) {
    fail Boom{}
  }
  return n
}

// The `?` propagation path runs the loop's defers too: four were scheduled
// before step(3) failed.
fn scan(): int! {
  let i = 0
  while (i < 5) {
    defer print("undo ${i}\n")
    let v = step(i)?
    i = v + 1
  }
  return i
}

fn main() {
  closeAll()
  mixed()
  let r = scan() catch e {
    print("scan failed: ${e.message()}\n")
    -1
  }
  print("r=${r}\n")
}
