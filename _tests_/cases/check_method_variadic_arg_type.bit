// error
// #4661: a variadic METHOD call's arguments were never type-checked.
// `vCallAgainstFuncSig` (compiler/validateiface.bit) — the whole of a method
// or func-value call's argument judgement — opened `if (ftt.variadic) {
// return }`, so `f.bar("a")` and `f.bar(...s)` into `bar(...xs: i64)` both
// checked and ran rc=0, printing `1` and `3` where a `for x of xs` body would
// have read the string's pointer as an i64. #4655 closed the same hole for a
// FREE function; this is the method half, in a different file.
//
// The rule is now the free path's, read off an interned signature's `members`
// instead of a declaration's parameter nodes (`vFuncSigArgTypes`/
// `vFuncSigArgWant`, compiler/validatecall.bit): the fixed prefix against its
// declared parameter types, everything past it against the rest parameter's
// element type P, and a `...` spread against `[]P` (SPEC §12.4).
//
// All four reachable shapes are pinned below, because ONE early return
// disabled all four: a direct method call, a spread into one, the fixed prefix
// of a variadic method, and a variadic FUNC VALUE (`vCallValue`'s tail, the
// function's other call site) — plus interface dispatch, which resolves
// through the same `methodSigs` entry.
//
// `run_method_variadic_spread.bit`, `run_method_variadic_arity.bit`,
// `run_method_variadic_defer.bit` and `run_method_variadic_interface.bit` are
// the no-false-positive half: every legal variadic method call there still
// runs unchanged.
interface Barer {
  bar(...xs: i64): int,
}

class Foo {
  bar(...xs: i64): int { return len(xs) }
  tag(label: string, ...xs: i64): int { return len(label) + len(xs) }
}

fn takesInts(...xs: i64): int { return len(xs) }

fn viaIface(b: Barer, s: string): int {
  return b.bar(...s)
}

fn main() {
  let f = Foo{}
  let s = "abc"
  let g = takesInts
  print("${f.bar("a")}\n")
  print("${f.bar(...s)}\n")
  print("${f.tag(7, 1, 2)}\n")
  print("${g("a")}\n")
  print("${viaIface(f, s)}\n")
}
