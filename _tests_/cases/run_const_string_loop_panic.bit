// panic
// #6435: the semantic half of ir_const_string_loop.bit. `len` of a literal
// folds to a constant, and a bounds check is dropped when the header's
// constant bound is no larger than the indexed literal's length. The first
// two loops are covered that way and must answer exactly as before: every
// byte that escapes to a letter, then a param holding one of two literals.
// The last loop is bounded by a 6-byte literal and indexes a 3-byte one, so
// its check must survive and fire at `i == 3`. A rule that compared the two
// lengths the wrong way round would read three bytes past the end of
// `short`, print them, and exit 0, which is what this expected output rejects.
fn escapeLetter(c: u8): u8 {
  let bytes = "\x00\x07\x08\t\n\x0b\x0c\r\x1b\"\\"
  let letters = "0abtnvfre\"\\"
  let i = 0
  while (i < len(bytes)) {
    if (bytes[i] == c) {
      return letters[i]
    }
    i = i + 1
  }
  return 0
}

fn sum(flag: bool): int {
  let s = "abc"
  if (flag) {
    s = "defgh"
  }
  let n = 0
  let i = 0
  while (i < len(s)) {
    n = n + int(s[i])
    i = i + 1
  }
  return n
}

fn main() {
  let c = 0
  while (c < 256) {
    let l = escapeLetter(u8(c))
    if (l != 0) {
      eprint("${c}:${l}\n")
    }
    c = c + 1
  }
  eprint("sum=${sum(false)} ${sum(true)}\n")
  let long = "abcdef"
  let short = "abc"
  let i = 0
  while (i < len(long)) {
    eprint("i=${i} b=${short[i]}\n")
    i = i + 1
  }
  eprint("unreachable: i=${i}\n")
}
