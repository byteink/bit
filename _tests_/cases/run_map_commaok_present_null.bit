// run
// #5911: a map key can be PRESENT and hold null, from a failed two-result
// type assertion (SPEC §14.4) or a receive from a closed channel. That hit
// finds the null word just as a miss does, but `ok` is true, so the guarded
// read must see the value type's zero value (SPEC §12.6, §13.4), never null.
// compiler/optcommaok.bit skips the zero object only on the ok-false edge;
// every look below reads past `if (ok)`, the shape that pass rewrites.
interface Named {
  name(): string,
}

class A {
  n: int
  name(): string { return "a" }
}

class B {
  name(): string { return "b" }
}

enum Shape {
  Unit,
  Circle(int),
}

fn lookA(m: map<int, A>, k: int): int {
  let (a, ok) = m[k]
  if (ok) {
    return a.n
  }
  return -1
}

fn lookStr(m: map<string, A>, k: string): int {
  let (a, ok) = m[k]
  if (ok) {
    return a.n
  }
  return -1
}

fn lookPair(m: map<int, (int, int)>, k: int): int {
  let (t, ok) = m[k]
  if (ok) {
    return t.0 + t.1
  }
  return -1
}

fn lookShape(m: map<int, Shape>, k: int): string {
  let (s, ok) = m[k]
  if (ok) {
    match (s) {
      Unit => { return "unit" }
      Circle(r) => { return "circle ${r}" }
    }
  }
  return "miss"
}

fn fromAssert() {
  let i: Named = B{}
  let (a, aok) = i.(A)
  let m = map<int, A>{}
  m[1] = a
  let s = map<string, A>{}
  s["k"] = a
  print("assert aok=${aok} look=${lookA(m, 1)} miss=${lookA(m, 2)}")
  print(" str=${lookStr(s, "k")} strmiss=${lookStr(s, "x")}\n")
}

fn fromRecv() {
  let c = chan<A>(1)
  close(c)
  let (a, rok) = <- c
  let m = map<int, A>{}
  m[1] = a
  m[2] = <- c
  print("recv rok=${rok} two=${lookA(m, 1)} one=${lookA(m, 2)} miss=${lookA(m, 3)}\n")
}

fn fromSelect() {
  let c = chan<A>(1)
  close(c)
  let m = map<int, A>{}
  select {
    case v = <- c:
      m[1] = v
  }
  print("select look=${lookA(m, 1)} miss=${lookA(m, 2)}\n")
}

fn fromPair() {
  let c = chan<(int, int)>(1)
  close(c)
  let (z, zok) = <- c
  let m = map<int, (int, int)>{}
  m[1] = z
  m[2] = (3, 4)
  print("pair zok=${zok} look=${lookPair(m, 1)} hit=${lookPair(m, 2)} miss=${lookPair(m, 3)}\n")
}

fn fromShape() {
  let c = chan<Shape>(1)
  close(c)
  let (z, zok) = <- c
  let m = map<int, Shape>{}
  m[1] = z
  m[2] = Shape.Circle(3)
  print("shape zok=${zok} ${lookShape(m, 1)} ${lookShape(m, 2)} ${lookShape(m, 3)}\n")
}

fn main() {
  fromAssert()
  fromRecv()
  fromSelect()
  fromPair()
  fromShape()
}
