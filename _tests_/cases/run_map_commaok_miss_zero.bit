// run
// #5905: SPEC §12.6/§13.4, a missing key reads as the value type's zero
// value, and that stays true when the comma-ok miss no longer builds a zero
// object nothing reads (compiler/optcommaok.bit). The guarded reads skip the
// zero object; each read that can happen after a miss still sees `Obj`'s
// zero fields, whether it comes after the `if`, through a call on both paths,
// or from a field the value was stored into before the check.
class Obj {
  x: int,
  s: string,
  t: (int, int),
}

class Holder {
  o: Obj,
}

fn guarded(m: map<string, Obj>, k: string): string {
  let (n, ok) = m[k]
  if (ok) {
    return "${n.x}:${n.s}"
  }
  return "miss"
}

fn notOk(m: map<string, Obj>, k: string): string {
  let (n, ok) = m[k]
  if (!ok) {
    return "miss"
  }
  return "${n.x}:${n.s}"
}

fn readAfter(m: map<string, Obj>, k: string): string {
  let (n, ok) = m[k]
  let tag = "miss"
  if (ok) {
    tag = "hit"
  }
  return "${tag} x=${n.x} s='${n.s}' len=${len(n.s)} t=${n.t.0},${n.t.1}"
}

fn show(o: Obj): string {
  return "x=${o.x} s='${o.s}' t=${o.t.0},${o.t.1}"
}

fn callBoth(m: map<string, Obj>, k: string): string {
  let (n, ok) = m[k]
  if (ok) {
    return "hit ${show(n)}"
  }
  return "miss ${show(n)}"
}

fn storeBefore(m: map<string, Obj>, k: string, h: Holder): string {
  let (n, ok) = m[k]
  h.o = n
  if (ok) {
    return "hit"
  }
  return "miss"
}

fn main() {
  let m = map<string, Obj>{}
  m["a"] = Obj{ x = 7, s = "q", t = (1, 2) }
  println("${guarded(m, "a")} ${guarded(m, "b")}")
  println("${notOk(m, "a")} ${notOk(m, "b")}")
  println(readAfter(m, "a"))
  println(readAfter(m, "b"))
  println(callBoth(m, "a"))
  println(callBoth(m, "b"))
  let h = Holder{ o = Obj{ x = 9, s = "z", t = (3, 4) } }
  let r = storeBefore(m, "b", h)
  h.o.x = h.o.x + 5
  println("${r} ${show(h.o)}")
  let i = 0
  let misses = 0
  while (i < 1000) {
    if (guarded(m, "k${i}") == "miss") {
      misses = misses + 1
    }
    i = i + 1
  }
  println("misses=${misses}")
}
