// run
// #4380: mutation-tested. A mutant that drops one real free variable from an
// arrow's capture set does not crash here — `q` still resolves, just to the
// WRONG binding, because `lowerNamedValue` falls through past "not a local"
// to the module-level const of the same name. An under-capturing lowerer
// would silently print 1000 (1 + the const) instead of 8 (1 + the local),
// exit 0 either way. A fixture that can only fail by segfaulting would have
// missed this class of bug entirely (the same shape #4356 found: an
// under-read env can read a plausible, wrong, non-crashing value).
const q = 999

fn callCmp(f: (int) => int, a: int): int {
  return f(a)
}

fn main() {
  let q = 7
  let r = callCmp((a) => a + q, 1)
  print("${r}\n")
}
