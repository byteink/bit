// run
// #3765: an in-body method (SPEC §10.4) on a GENERIC class instantiates its
// type parameter correctly. The in-body form's implicit receiver reused the
// class's own generics node verbatim when the method declared no extra
// generics of its own, so the checker's per-declaration TypeParam id (minted
// by node identity) got re-registered mid-collection and the method's
// declared result type was left pointing at an orphaned id no substitution
// env ever covered — `bit check` passed but `bit build`/`bit run` refused to
// lower `b.get()` with E0092. Two instantiations of the same generic class,
// and a two-param class, both exercise per-instantiation substitution.
//
// `bit fmt --check` flags this file (pre-existing, unrelated bug tracked as
// #3767: fmt mis-prints a generic method's receiver-derived params, whether
// written in-body or with an explicit receiver — see
// _tests_/cases/run_generic_method.bit, already in this state on `main`).
class Box<T> {
  v: T
  get(): T {
    return this.v
  }
}

class Pair<A, B> {
  a: A
  b: B
  first(): A {
    return this.a
  }
  second(): B {
    return this.b
  }
}

fn main() {
  let bi = Box<int>{ v: 42 }
  print("${bi.get()}\n")
  let bs = Box<string>{ v: "hi" }
  print("${bs.get()}\n")
  let p = Pair<int, string>{ a: 7, b: "z" }
  print("${p.first()} ${p.second()}\n")
}
