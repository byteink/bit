// run
// #4355: the SILENT half of `run_closure_env_mutated_alloc_loop.bit`. Both
// pin the closure cell's env word (+8, the cell's one traced field); this one
// captures two i64s that are never written, so lowerclosure.bit stores them
// DIRECTLY in the env object instead of boxing them, and the closure body
// reads them without dereferencing anything.
//
// That is what makes the failure quiet. Mutation-checked: reading the env from
// the cell's +0 instead of +8 hands the callee the code pointer as its
// environment, and two words of `.text` read as i64 are mapped, aligned and
// arithmetically valid — the program exits 0 and prints
// `sum 8322698358573985108`. The boxed sibling case segfaults on the same
// mutant, so a fixture set holding only that one would look like it was
// testing the env word while catching nothing but crashes.
//
// Routed through `len(args())` so the trip count is not a compile-time
// constant; `args()` has length 1 for the argument-free run the harness does.
import { args } from "std/os"

fn apply(f: (i64) => i64, n: i64): i64 {
  let s: i64 = 0
  let i: i64 = 0
  while (i < n) {
    s = s + f(i)
    i = i + 1
  }
  return s
}

fn trips(): i64 {
  return i64(len(args())) * 5
}

fn main() {
  let bias: i64 = 1000
  let scale: i64 = 7
  let g = (x: i64) => bias + scale * x
  print("sum ${apply(g, trips())}\n")
}
