// run
// #1561: `for { }`, the bare unconditional loop. The self-hosted lowerer had no
// case for it at all, so `lowerStmt` fell through and refused the function even
// though the parser, the checker and the seed all accepted it.
class myErr { code: i64 
  message(): string { return "code=${this.code}" }
}
fn g(ok: bool): i64! {
  if (!ok) { fail myErr{ code: 1 } }
  return 7
}
// The catch block never runs — the point is that it LOWERS. A `for { }` with no
// break diverges, so its exit has no predecessor at all and must terminate the
// block; reopening it would make `lowerCatch` refuse the function (#1519,#1548).
fn f(ok: bool): i64 {
  return g(ok) catch e {
    for {
    }
  }
}
// A `for { }` that breaks falls out normally, carrying `n` through the header.
fn counts(): i64 {
  let n = 0
  for {
    n = n + 1
    if (n > 2) { break }
  }
  return n
}
// `continue` targets the header, so only the even steps reach the sum.
fn evens(): i64 {
  let i = 0
  let sum = 0
  for {
    i = i + 1
    if (i > 6) { break }
    if (i % 2 == 1) { continue }
    sum = sum + i
  }
  return sum
}
fn main() {
  print("a=${f(true)}\n")
  print("b=${counts()}\n")
  print("c=${evens()}\n")
}
