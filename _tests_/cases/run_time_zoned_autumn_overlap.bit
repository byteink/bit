// run
// #4075: the autumn overlap (docs/stdlib/time.md, "Daylight saving: the
// two awkward days"). On 2026-10-25 in Europe/London the clock goes back
// from 02:00 to 01:00; the wall times 01:00:00..01:59:59.999999999 happen
// twice, once at +01:00 and again at +00:00. `NaiveDateTime.inZone` is
// total and takes the FIRST occurrence -- the one with the earlier offset.
// Cross-checked against this host's own `zdump -v Europe/London`: the 2026
// autumn transition is at 2026-10-25T01:00:00Z, BST(3600) -> GMT(0).
import { date, zone } from "std/time"

fn main() {
  let london = zone("Europe/London") catch e {
    println("zone(Europe/London) failed: ${e.message()}")
    return
  }
  let d = date(2026, 10, 25) catch e {
    println("date failed: ${e.message()}")
    return
  }
  let naive = d.atTime(1, 30, 0) catch e {
    println("atTime failed: ${e.message()}")
    return
  }

  let dt = naive.inZone(london)
  println("hour=${dt.hour()}")
  println("minute=${dt.minute()}")
  println("offset=${dt.offset()}")
  println("isDst=${dt.isDst()}")
  println("toString=${dt.toString()}")

  let ts = dt.toTimestamp() catch e {
    println("toTimestamp failed: ${e.message()}")
    return
  }
  println("timestamp=${ts.toString()}")
}
