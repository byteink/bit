// run
// #4323: named arguments on a METHOD call (SPEC §12.11 — "the callee is a
// named function or method whose declaration is in scope"). #3839 shipped
// the free-function half only and rejected every method with E0128; the
// names were simply being looked for on the interned signature, which
// carries parameter TYPES only, instead of on the declaration.
//
// Three receivers, because they resolve the declaration through three
// different routes: a CLASS value (methodDecls -> the class's FuncDecl), an
// INTERFACE value (no FuncDecl exists — the names come off the interface's
// own MethodSig), and `this` inside a method body.
//
// `serve` is deliberately (string, i64, bool): every parameter has a
// distinct type, so a misplaced argument is a TYPE error rather than a wrong
// number silently printed, and `tls`/`port` swapped would not compile.
//
// The last call is the evaluation-order proof, the one no arity or type
// check can make: `g()` and `h()` both print, and are written in the reverse
// of their declared order. Arguments must evaluate in WRITTEN order (g then
// h) while landing in DECLARED slots (app = h()'s value, port = g()'s).
// Placing them straight into slots instead reorders the side effects and
// prints "h" before "g" with every value still correct — a silent wrong
// answer at exit 0.

class Server {
  tag: string
  serve(app: string, port: i64, tls: bool): string {
    return "${this.tag} app=${app} port=${port} tls=${tls}"
  }
  viaThis(port: i64): string {
    return this.serve(tls = false, app = "inner", port = port)
  }
}

interface Sink {
  emit(label: string, count: i64): string,
}

class Log {
  prefix: string
  emit(label: string, count: i64): string {
    return "${this.prefix}:${label}=${count}"
  }
}

fn g(): i64 {
  print("g\n")
  return 1
}

fn h(): string {
  print("h\n")
  return "web"
}

fn main() {
  let s = Server{ tag: "S" }
  print(s.serve("web", 3000, true) + "\n")
  print(s.serve(app = "web", port = 3000, tls = true) + "\n")
  print(s.serve("web", tls = true, port = 3000) + "\n")
  print(s.serve(tls = true, port = 3000, app = "web") + "\n")
  print(s.viaThis(port = 8080) + "\n")

  let k: Sink = Log{ prefix: "L" }
  print(k.emit("hits", 7) + "\n")
  print(k.emit(count = 7, label = "hits") + "\n")

  print(s.serve(port = g(), app = h(), tls = false) + "\n")
}
