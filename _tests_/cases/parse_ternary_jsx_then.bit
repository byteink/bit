// run
// #6421: `cond ? <a /> : <b />` is a ternary with a JSX `then` branch - the
// speculative parse after `?` must accept an element that parses completely
// and is followed by `:`, including one whose text holds a `#` (the eager lex
// reads it as an invalid character and the JSX resync re-lexes the tail), and
// it must leave the token stream and the diagnostics exactly as the real parse
// expects. The last function puts a comparison after a propagated value next
// to a ternary, so a rewind that swallowed tokens would show here as a parse
// error.
import { render, elem, attr, text } from "../../pkg/web"

fn g(): i64! {
  return 1
}

fn pick(c: bool): string {
  return render(c ? <a /> : <b />)
}

fn attrs(c: bool): string {
  return render(c ? <a href="x">a#b</a> : <b>no</b>)
}

fn nested(c: bool, d: bool): string {
  return render(c ? <p>{d ? <i /> : <u />}</p> : <hr />)
}

fn mixed(b: i64): string! {
  let page = render(b > 0 ? <em>c#d</em> : <s />)
  let small = g()? < b
  return "${page} ${small}"
}

fn main() {
  println(pick(true))
  println(pick(false))
  println(attrs(true))
  println(attrs(false))
  println(nested(true, true))
  println(nested(true, false))
  println(nested(false, true))
  println(mixed(3) catch "err")
  println(mixed(0) catch "err")
}
