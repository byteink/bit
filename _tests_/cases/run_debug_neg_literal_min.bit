// run-debug
// #7069: `-<int literal>` lowers to ONE negative `const_int`, not `neg
// (const_int N)`. `9223372036854775808` does not fit i64, so the literal is
// stored wrapped to i64 min and the `neg` of it overflowed: `--debug` printed
// `panic: integer overflow` for a value the checker accepts. The same held
// for `-128` as an i8. A negation that really overflows still traps
// (overflow_trap_neg_debug.bit).

fn main() {
  let a: i64 = -9223372036854775808
  let b: i8 = -128
  let c: i32 = -2147483648
  let d: i16 = -32768
  println("${a} ${b} ${c} ${d}")
  switch (a) {
    case -9223372036854775808:
      println("min")
    default:
      println("other")
  }
}
