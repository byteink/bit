// error
// #5264/#5216: the fallible-AND-bare-tag combination nobody had pinned
// before this ticket. Return covariance unwraps one layer of `!` before
// testing for interface satisfaction, but the unwrapped ok type must still
// route through `vStorableInInterface` — the same predicate #5216 added,
// not a second copy of it. `Color` is bare-tag (no payload-carrying
// variant), so it cannot sit behind an interface value even wrapped in
// `!`; `(int) => Color!` stays rejected as a `(int) => Sized!`, exactly
// like the non-fallible case (check_func_return_covariance_bare_enum.bit).
interface Sized {
  size(): int,
}

enum Color {
  Red
  Green
  Blue

  export size(): int {
    match (this) {
      Red => return 1
      Green => return 2
      Blue => return 3
    }
  }
}

type Sizer = (int) => Sized!

fn pick(x: int): Color! {
  if (x == 1) {
    return Color.Red
  }
  return Color.Green
}

fn takesSizer(s: Sizer): int {
  let c = s(1) catch _ {
    panic("unreachable")
  }
  return c.size()
}

fn main() {
  print("${takesSizer(pick)}\n")
}
