// run
// #6687: the three synthesized sites that BIT_ERR_REG still left on the slot:
// the startup init body and its driver step, the fallible `main` wrapper, and a
// fallible free fn called as a value. The program prints the same lines with the
// flag off and on (`BIT_ERR_REG=1 ./make test-golden` runs the word path).
//
//   1. `let base`   an initializer that calls a fallible free fn, ok and caught
//   2. `main`       a fallible `main` that fails: the wrapper prints the error
//                   and exits 1; the program runs itself with `fail` to see it
//   3. `apply`      a fallible free fn passed as a value, called with `catch`
import { argc, selfExe } from "std/os"
import { output } from "std/process"

fn parse(n: int): int! {
  if (n < 0) {
    fail newError("negative")
  }
  return n * 2
}

let base: int = parse(21)?
let fallback: int = parse(-1) catch 7

type F = (int) => int!

fn apply(f: F, n: int): int {
  return f(n) catch -1
}

fn main(): ()! {
  if (argc() > 1) {
    fail newError("boom")
  }
  println("base=${base} fallback=${fallback}")
  println("apply ok=${apply(parse, 5)} bad=${apply(parse, -5)}")
  let r = output(selfExe(), ["fail"])
  println("exit=${r.exitCode}")
  println("stderr=${r.stderr}")
}
