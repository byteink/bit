// run
// #5669: road A's DIRECT shape, `X{ f = ptrOf(local) }`. Sibling of
// run_ptrof_interior_keepalive.bit (#4467), same technique -- force enough
// default-collector churn that the fixture cannot pass vacuously -- for the
// shape #5637 found live in props.bit: `buf`'s last SSA use is the bare
// `ptrOf` call inside the class literal, and the compiler must keep it rooted
// for as long as `h` (the object holding the pointer) is reachable
// (recordClassFieldPtrOfKeepAlive, compiler/lowerkeepalive.bit).
//
// NO interior-vs-base control arm here, unlike the #4467 fixture. `h.p` is a
// class FIELD, never conservatively scanned regardless of its offset from
// `buf`'s base -- a class's GcAlloc descriptor never lists a `*T` field among
// its traced offsets (`isRefType` says so).
//
// STRAIGHT LINE, ON PURPOSE, from `h`'s construction through `churn` to the
// final read. `t`'s fill loop runs BEFORE `buf`/`h` exist, so it cannot rename
// them across a block boundary; twelve UNROLLED reads (not a loop) hold
// register pressure across `churn` exactly the way #4467's own fixture does,
// so `h` stays a plain, unrenamed value the whole way -- what a call crossing
// a safepoint sees in the real props.bit shape, where the object is a
// straight-line local, not something threaded through a loop header.
extern fn bit_rt_port_stw_collections(): i64

class Holder {
  p: *i64,
}

fn churn(n: i64) {
  let i = 0
  while (i < n) {
    let junk = []i64(8)
    atomicStore(ptrOf(junk), 7)
    i = i + 1
  }
}

fn probe(n: i64): i64 {
  let t = []i64(16)
  let j = 0
  while (j < 16) {
    atomicStore(ptrOf(t) + j, j)
    j = j + 1
  }
  let buf = []i64(8)
  // `buf`'s last SSA use is this `ptrOf`, straight into the class literal.
  let h = Holder{ p = ptrOf(buf) }
  atomicStore(h.p, 555)
  let a0 = int(atomicLoad(ptrOf(t) + 0))
  let a1 = int(atomicLoad(ptrOf(t) + 1))
  let a2 = int(atomicLoad(ptrOf(t) + 2))
  let a3 = int(atomicLoad(ptrOf(t) + 3))
  let a4 = int(atomicLoad(ptrOf(t) + 4))
  let a5 = int(atomicLoad(ptrOf(t) + 5))
  let a6 = int(atomicLoad(ptrOf(t) + 6))
  let a7 = int(atomicLoad(ptrOf(t) + 7))
  let a8 = int(atomicLoad(ptrOf(t) + 8))
  let a9 = int(atomicLoad(ptrOf(t) + 9))
  let aa = int(atomicLoad(ptrOf(t) + 10))
  let ab = int(atomicLoad(ptrOf(t) + 11))
  churn(n)
  // 0+1+...+11 = 66, so a correct run contributes nothing here and the
  // printed number is the dereference through `h.p` alone.
  let sum = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + aa + ab
  return int(atomicLoad(h.p)) + (sum - 66) * 1000
}

fn main() {
  let n = 200000
  let before = int(bit_rt_port_stw_collections())
  let result = probe(n)
  // Without this the case would pass vacuously the day the collector's growth
  // policy stops firing at this volume, and nothing would say so.
  if (int(bit_rt_port_stw_collections()) <= before) {
    panic("no collection ran: this case cannot fail as written")
  }
  print("result=${result}\n")
}
