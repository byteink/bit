// ir
// #6840: a window of `i + 1 < len(s)` admits strides of at most 2. A stride of
// 3 could carry `i` past `len(s)`, and with a length near maxInt `i + 1` would
// wrap negative and still pass the signed test, so compiler/optbce.bit keeps
// the `icmp_ult` on `s[i + 1]` here. No real string is that long, so no run
// case can show the wrap; this IR pins the refusal.
fn stride(s: string): int {
  let total = 0
  let i = 0
  while (i + 1 < len(s)) {
    total = total + int(s[i + 1])
    i = i + 3
  }
  return total
}

fn main() {
  print("${stride("abcdefg")}\n")
}
