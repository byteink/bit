// panic
// #2014, the negative index: `xs[-1]` must panic (SPEC §12.6, §18.4). Pinned
// separately from the past-the-end case because it is the OTHER arm of
// `index < 0 || index >= vlen` — a fix that only compared against the length
// would leave a negative index reading behind the buffer, and that arm has no
// upper bound to save it. It read as 0 before this landed.
import { args } from "std/os"

fn neg(): int { return 0 - len(args()) }

fn main() {
  let xs = [1, 2, 3]
  print("start\n")
  print("read=${xs[neg()]}\n")
  print("unreachable\n")
}
