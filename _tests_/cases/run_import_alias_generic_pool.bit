// run
// #7482: `import { Pool as P }` of std/sync's generic Pool, then `P<slot>(...)`.
// The alias is the only spelling a module that declares its own `Pool` has, and
// it failed to link: `undefined symbol '_m7$init$t443'`. The instantiation's
// methods were referenced but never emitted.
import { Pool as P, PoolOptions } from "std/sync"

class slot {
  n: int,
}

fn main() {
  let c = P<slot>(() => slot{ n = 1 }, (s) => {}, (s) => true, PoolOptions{})
  let l = c.acquire() catch _ {
    return
  }
  c.release(l, true)
  c.close()
  println("ok")
}
