// run
// #6673: a module array cell with a non-constant initializer is filled at
// startup, and a long one is copied by a counted loop, not by one store per
// element. 4096 is far above the unroll limit; 13 is the first length past it and
// 12 the last one unrolled, so both paths and the edge between them run.
fn big(): [4096]int {
  let t: [4096]int
  let i = 0
  while (i < 4096) {
    t[i] = i * 3 + 1
    i = i + 1
  }
  return t
}

fn edge13(): [13]u8 {
  let t: [13]u8
  let i = 0
  while (i < 13) {
    t[i] = u8(i + 10)
    i = i + 1
  }
  return t
}

fn edge12(): [12]f64 {
  let t: [12]f64
  let i = 0
  while (i < 12) {
    t[i] = f64(i) / 2.0
    i = i + 1
  }
  return t
}

let cell: [4096]int = big()
let bytes13: [13]u8 = edge13()
const halves: [12]f64 = edge12()

fn main() {
  let sum = 0
  let i = 0
  while (i < 4096) {
    sum = sum + cell[i]
    i = i + 1
  }
  println("big ${cell[0]} ${cell[4095]} sum ${sum}")
  cell[0] = -1
  println("written ${cell[0]} fresh ${big()[0]}")
  println("u8 ${bytes13[0]} ${bytes13[12]} f64 ${halves[0]} ${halves[11]}")
}
