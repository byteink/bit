// run
// #4665. The mirror of run_namespace_alias_shadowed{,_arity}.bit (#4660): there
// a local shadowed the alias AT the call, so the local had to win; here the
// local is in a DIFFERENT function and never member-accessed, so the genuine
// namespace call must be judged against `std/strings.trim(s, cutset)` and not
// against `Wrap.trim(s)`.
//
// `identEnvType` (compiler/checklookup.bit) answered `envLookup(c, name)` for an
// ident the resolver had bound to `SymbolKind.ImportNamespace`. `Checker.env` is
// keyed by NAME ONLY and flat across the whole module, so `wrapped()`'s local
// supplied the type of the alias in `trimmed()`, `vMethodCall` (validateiface.bit)
// looked up "Wrap.trim", and `bit check` reported on correct code:
//
//   error[E0050]: expected 1 argument(s), found 2
//     --> ...: return strings.trim("  y  ", " ")
//
// An alias is bound only under dotted "ns.member" keys, never as a value under
// its bare name, so the env can only ever answer here with an unrelated
// binding. It now answers 0 and the caller keeps the namespace path.
//
// The two symptoms are independent, which is why this file exists beside #4660's
// two: those measured identically before and after this fix, and this one
// measures identically before and after theirs.

import strings from "std/strings"

class Wrap {
  n: int
  export trim(s: string): string {
    return "WRAP:${s}:${this.n}"
  }
}

// The poisoning binding: same name as the alias, never used as a receiver.
fn wrapped(): int {
  let strings = Wrap{ n: 4 }
  return strings.n
}

// The genuine namespace call, two arguments, in another function entirely.
fn trimmed(): string {
  return strings.trim("  y  ", " ")
}

fn main() {
  println("${wrapped()}")
  println(trimmed())
  // The shadowing local still wins where it IS the receiver (#4660, SPEC §17.5).
  let strings = Wrap{ n: 4 }
  println(strings.trim("x"))
}
