// types
// #4545: two functions that each declare a local named `b`, of a DIFFERENT
// class each. `assignTargetFuncType` (checkarrow.bit) decides the expected
// type of an arrow assigned to `recv.field`, and until #4545 it read a map
// keyed by the receiver's NAME and flat across the module — so the LAST `b`
// declared anywhere decided what every `b` meant, `A.f` was looked up on `B`,
// and `one`'s arrow parameter stayed `<error>` while `two`'s was fine.
//
// #4531 kept that name-keyed map alive for this one consumer because
// `--dump-types` and `--dump-ir` built a Checker and called `checkModule` with
// no resolver at all, so a decl-node key answered 0 here. Those entry points
// resolve now (checkmodule.bit's `checkedSourceModule`), so each `b` answers at
// its own declaration and the name map is gone.
class A { f: (string) => string }

class B { g: (int) => int }

fn one(): string {
  let b = A{ f: (v) => v }
  b.f = (name) => "yo " + name
  return b.f("x")
}

fn two(): int {
  let b = B{ g: (v) => v }
  b.g = (num) => num + 1
  return b.g(1)
}

fn main() {
  print(one() + "\n")
  print("${two()}\n")
}
