// ir
// #7761: an `if`'s `c >= lo && c <= hi` on an unsigned `c` lowers to one `br`
// per operand (lowercondchain.bit), and optselect.bit's rangeAt fuses the pair
// into one `icmp_ule` on `c - lo`, the shape rangeTest gives the value form.
// `outside` is the mirror, `c < lo || c > hi`, with both `br`s' edges swapped.
// `signed` (an `i8`) and `empty` (`lo > hi`) are the controls: each keeps its
// two compares and two `br`s. The runtime half is opt_select_range_chain.bit.

fn digit(c: u8): i64 {
  if (c >= '0' && c <= '9') {
    return i64(c - '0')
  }
  return -1
}

fn outside(c: u8): bool {
  if (c < 'a' || c > 'f') {
    return false
  }
  return true
}

fn signed(x: i8): bool {
  if (x >= -3 && x <= 4) {
    return true
  }
  return false
}

fn empty(c: u8): bool {
  if (c >= 200 && c <= 100) {
    return true
  }
  return false
}

fn main() {
  print("${digit(u8(55))} ${outside(u8(122))} ${signed(i8(1))} ${empty(u8(150))}\n")
}
