// run
// Calling a function VALUE that no declaration backs, so the callee is an
// arbitrary expression rather than a name: a slice element, a map element, a
// returned function, and a func-typed field reached through a slice. Each of
// these dispatches through `call_value` on the callee's own type (#1523).
fn inc(n: int): int {
  return n + 1
}

fn dbl(n: int): int {
  return n * 2
}

fn mk(): (int) => int {
  return inc
}

class Box {
  f: (int) => int,
}

fn main() {
  // A slice literal of function type, mixing named functions and an arrow.
  let fs = [](int) => int{ inc, dbl, (x: int) => x - 1 }
  print("${fs[0](41)} ${fs[1](21)} ${fs[2](43)}\n")

  // A function returned from a call, applied directly.
  print("${mk()(41)}\n")

  // A map element and a func-typed field reached through a slice index.
  let m = map<string, (int) => int>{ "a": dbl }
  let bs = []Box{ Box{ f: inc } }
  print("${m["a"](21)} ${bs[0].f(41)}\n")
}
