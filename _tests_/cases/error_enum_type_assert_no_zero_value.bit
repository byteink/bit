// error
// #6017 (SPEC §14.4/§13.4): a boxed enum whose FIRST variant carries a
// payload has no zero value to yield on a mismatch, so the assertion is
// rejected at check time — never silently accepted and never a runtime
// crash. The ticket's OWN repro shape, and pkg/redis's real `RedisError`
// (#6019), whose first variant `WrongType(string)` has one too.
enum RedisError {
  WrongType(string)
  Timeout
  export message(): string {
    match (this) {
      WrongType(m) => return m
      Timeout => return "timeout"
    }
  }
}

fn doOp(): int! { fail RedisError.Timeout }

fn main() {
  let _ = doOp() catch e {
    let (re, ok) = e.(RedisError)
    if (ok) {
      print("${re.message()}\n")
    }
    0
  }
}
