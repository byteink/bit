// run
// #6472: `let (_, ok) = m[k]` reads no value, and answers presence exactly as
// the full form does: a hit, a miss, a nil map, a value type with no zero
// value (SPEC §13.4), and a present key holding a class value. The key
// expression still runs once per read (`bump`), in the `let` and the
// assignment form alike.
class Obj {
  x: int,
}

class Outer {
  o: Obj,
}

fn bump(c: Obj): int {
  c.x = c.x + 1
  return c.x
}

fn main() {
  let m = map<int, Obj>{}
  m[1] = Obj{ x = 10 }
  let (_, hit) = m[1]
  let (_, miss) = m[2]
  println("${hit} ${miss}")

  let nilMap: map<int, Obj>
  let (_, none) = nilMap[1]
  println("${none}")

  let outer = map<int, Outer>{}
  outer[5] = Outer{ o = Obj{ x = 1 } }
  let (_, oHit) = outer[5]
  let (_, oMiss) = outer[6]
  println("${oHit} ${oMiss}")

  let c = Obj{ x = 0 }
  let (_, first) = m[bump(c)]
  let ok = true
  _, ok = m[bump(c)]
  println("${first} ${ok} ${c.x}")

  let s = map<string, int>{}
  s["k"] = 0
  let (_, sHit) = s["k"]
  let (_, sMiss) = s["q"]
  println("${sHit} ${sMiss} ${len(m)} ${len(s)}")
}
