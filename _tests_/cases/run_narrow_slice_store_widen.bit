// run
// #7173: `xs[i] = v` into a WORD-strided narrow element ([]i8, []i16, []i32,
// []u16, []u32, []bool) is stored inline as a full 8-byte word, the value
// widened first: sign-extended for a signed element, zero-extended for an
// unsigned one, which is the canonical register `rtSliceSet`'s `storeWord`
// wrote before. A store that wrote only the element's low bytes would leave
// the rest of the slot stale, and the compound assignments below read the
// slot back before writing it: `xs[i] /= 2` on an `[]i8` holding -1 must be
// 0, not 127 (255 / 2), and `>>= 1` on a `[]u32` holding 0xffffffff must be
// 0x7fffffff.
//
// Every slot is first filled with a value whose other bytes are set, so a
// narrow store over it cannot pass by landing on a zeroed slot. The stored
// values come from both literals and runtime arithmetic (`neg`), so the
// widening is exercised on a constant and on a computed register.
fn neg(n: int): int {
  return 0 - n
}

fn signed() {
  let a = []i8(2)
  a[0] = 127
  a[1] = 127
  a[0] = -1
  a[1] = i8(neg(1))
  println("i8 ${a[0]} ${a[1]}")
  a[0] /= 2
  a[1] >>= 1
  println("i8 ${a[0]} ${a[1]}")
  let b = []i32(2)
  b[0] = 2147483647
  b[1] = 2147483647
  b[0] = -1
  b[1] = i32(neg(7))
  println("i32 ${b[0]} ${b[1]}")
  b[0] /= 2
  b[1] >>= 1
  println("i32 ${b[0]} ${b[1]}")
  let h = []i16(2)
  h[0] = 32767
  h[1] = 32767
  h[0] = -1
  h[1] = i16(neg(300))
  h[0] /= 2
  h[1] >>= 1
  println("i16 ${h[0]} ${h[1]}")
}

fn unsigned() {
  let u = []u32(2)
  u[0] = 0x7fffffff
  u[1] = 1
  u[0] = 0xffffffff
  u[1] = u32(neg(1))
  println("u32 ${u[0]} ${u[1]}")
  u[0] /= 2
  u[1] >>= 1
  println("u32 ${u[0]} ${u[1]}")
  let w = []u16(2)
  w[0] = 1
  w[1] = 1
  w[0] = 0xffff
  w[1] = u16(neg(2))
  w[0] /= 2
  w[1] >>= 1
  println("u16 ${w[0]} ${w[1]}")
  let f = []bool(2)
  f[0] = true
  f[1] = true
  f[1] = false
  f[0] = !f[1]
  println("bool ${f[0]} ${f[1]}")
  let sum = 0
  for x of u {
    sum += int(x)
  }
  println("sum ${sum}")
}

fn main() {
  signed()
  unsigned()
}
