// run
// SPEC 11.6 / #6457: an f64 live across an `asm` block that CALLS OUT survives
// it. A callee destroys the vector registers too (xmm0..xmm13 on x64, d0..d7 on
// arm64), and `clobber` has no spelling for them, so the allocator must treat
// every calling block as destroying the whole caller-saved file, integer and
// vector, whatever its list names.
//
// `viaPinned` is the shape that used to slip through: every caller-saved
// register the allocator can hand out on x64 (rax rcx rdx r8 r9) is pinned as
// an `input`, which #6440's rule counts as declared and which keeps it out of
// the `clobber` list, so the block was no clobber point and `x` and `y` stayed
// in xmm registers across the `call`. `trash` keeps nine floats live, so it
// overwrites them; on x86_64-linux the line read 3550.5 instead of 10 at exit 0.
// `viaList` declares the same set with `callerSaved`. `len(args())` keeps the
// values out of the constant folder, and `entryOf(trash)` keeps the callee out
// of the inliner.
import { args } from "std/os"

fn trash(n: int): int {
  let a = f64(n) + 1.5
  let b = a * 2.0
  let c = b + a
  let d = c * b
  let e = d - a
  let f = e * c
  let g = f + d
  let h = g * 0.5
  return int(a + b + c + d + e + f + g + h)
}

fn viaPinned(fp: *u8, n: int, x: f64): f64 {
  let y = x * 3.0
  asm {
    arm64 { 0xD63F0100 } // blr x8
    x64 { 0xFF, 0xD0 }   // call rax
    input arm64 x8 x64 rax = fp
    input arm64 x0 x64 rdi = n
    input arm64 x1 x64 rcx = 0
    input arm64 x2 x64 rdx = 0
    input arm64 x3 x64 r8 = 0
    input arm64 x4 x64 r9 = 0
    clobber arm64 { x5, x6, x7, x9, x10, x11, x12, x13, x14, x15, x16, x17, x30, memory }
    clobber x64 { rsi, r10, r11, memory }
  }
  return y + x
}

fn viaList(fp: *u8, n: int, x: f64): f64 {
  let y = x * 3.0
  asm {
    arm64 { 0xD63F0100 } // blr x8
    x64 { 0xFF, 0xD0 }   // call rax
    input arm64 x8 x64 rax = fp
    input arm64 x0 x64 rdi = n
    clobber arm64 { callerSaved, memory }
    clobber x64 { callerSaved, memory }
  }
  return y + x
}

fn main() {
  let k = len(args())
  let x = f64(k) + 1.5
  println("${viaPinned(entryOf(trash), k + 2, x)} ${viaList(entryOf(trash), k + 2, x)}")
}
