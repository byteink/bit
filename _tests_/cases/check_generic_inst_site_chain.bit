// error
// #4684: a generic call with CONCRETE arguments standing inside a generic body
// is a ledger entry of its OWN, and its site was a line in a template.
//
// `slotOne()` inside `fn live<T>(v: T)` binds `T = ()` from its empty variadic
// slot (#4597/#4633) whatever `live` was instantiated with, so the check pass
// records `slotOne<()>` with `site` = that inner call
// (`recordCallInstantiation`, checkproject.bit). `vInstJudgeCall` then reported
// E0051 at that site with a note at `inner(x)` — two spans, both inside
// templates, and `live(7)` in `main` named nowhere. Descending into such a call
// from `live<i64>` is not the answer and is refused on purpose
// (`vInstSubstArgs`): it reported the identical E0051 twice, at two spans.
//
// `vInstOrigin` (validateinstchain.bit) walks the ledger UP instead: an entry
// whose site lies inside the instantiated body of another entry is attributed to
// THAT entry's site, and the hop becomes the chain's first note.
//
// Four shapes, because the hop count and the callee spelling are what vary:
//
//   - `live(7)`, one hop, free callee;
//   - `topB(7)`, TWO hops — `midB(7)` binds `i64` where it stands and so is an
//     entry of its own inside `topB`'s body, and `slotB()` is an entry inside
//     `midB`'s;
//   - `viaMethodHop(7)`, whose hop is a generic METHOD, recorded under the
//     ledger spelling `pass$t<recvTypeId>` (checklookup.bit) — the note has to
//     print `pass`, which is what `vInstPlainName` cuts;
//   - `deadOuter`, which is NEVER instantiated. No entry encloses `slotDead<()>`,
//     the walk stops where it starts, and the diagnostic keeps the site it had
//     before #4684. That is the fallback, and it is pinned here rather than
//     assumed: without it, a regression that lost the walk's stopping condition
//     would still look green on the three cases above.
//
// The satisfying side of the transitive rule is
// _tests_/cases/run_generic_transitive_bound_depth.bit.
interface Named {
  label(): string,
}

class Tag {
  export label(): string {
    return "tag"
  }
}

fn inner<T: Named>(v: T): string {
  return v.label()
}

fn slotOne<T>(...xs: T): string {
  for x of xs {
    return inner(x)
  }
  return "none"
}

fn live<T>(v: T): string {
  return slotOne()
}

fn slotB<T>(...xs: T): string {
  for x of xs {
    return inner(x)
  }
  return "none"
}

fn midB<T>(v: T): string {
  return slotB()
}

fn topB<T>(v: T): string {
  return midB(7)
}

class Hold {
  export pass<U>(v: U): string {
    return slotC()
  }
}

fn slotC<T>(...xs: T): string {
  for x of xs {
    return inner(x)
  }
  return "none"
}

fn viaMethodHop<T>(v: T): string {
  let h = Hold{}
  return h.pass(7)
}

fn slotDead<T>(...xs: T): string {
  for x of xs {
    return inner(x)
  }
  return "none"
}

fn deadOuter<T>(v: T): string {
  return slotDead()
}

fn main() {
  print("${live(7)}\n")
  print("${topB(7)}\n")
  print("${viaMethodHop(7)}\n")
}
