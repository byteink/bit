// error
// #5324, SPEC §12.12: a `{expr}` JSX attribute value has no type rule of
// its own -- it desugars straight into an ordinary call argument, `attr`'s
// own `(string, string)` signature here, so `data-id={n}` for `n: i64` is
// the same E0041 a hand-written `attr("data-id", n)` call gets. The note
// names the `"${n}"` spelling that converts it; Bit adds no coercion.
fn elem(tag: string, ...kids: string): string {
  return tag
}

fn attr(name: string, value: string): string {
  return name
}

fn main() {
  let n: i64 = 1
  let _ = <li data-id={n} />
}
