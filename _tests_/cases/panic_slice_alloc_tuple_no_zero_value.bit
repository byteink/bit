// panic
// The DYNAMIC half of #4721. `[]T(n)` means "n zero values of T" (§12.9), so a
// tuple element with a member that has no zero value cannot be filled — and
// when `n` does not fold, the checker cannot say so. `typeHasNoZeroValue`
// (lowerslicefill.bit) used to answer false for every kind that was not a
// Struct or an Enum, so the fill loop stored a zeroed `P` whose class-typed
// `q` stayed null and the fault landed at the first read, arbitrarily far from
// the slice.
//
// Same split as the array-bounds rule: static where `n` folds (E0083, pinned
// by _tests_/bit/checkercases/check_slice_alloc_tuple_no_zero_value.bit),
// dynamic only where it does not. The panic body is entered only when `n > 0`,
// so `[](i64, P)(0)` stays legal — it asks for no zero values at all.
//
// `nOf()` is a function call rather than a variable so no constant folding can
// reach it and turn this back into the static case.
class Q {
  v: i64,
}

class P {
  q: Q,
}

fn nOf(): i64 {
  return 2
}

fn main() {
  let xs = [](i64, P)(nOf())
  print("${len(xs)}\n")
}
