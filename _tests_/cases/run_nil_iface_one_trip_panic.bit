// panic
// #4379: the companion to `run_nil_iface_zero_trip.bit`. The same loop with a
// trip count of one DOES dispatch through `pm`, so the nil check must still
// fire and the message must be the same one `run_nil_iface_panic.bit` pins for
// the straight-line dispatch. A loop-carried nil receiver is the shape any
// future hoist of the check, or of the `*(recv - 16)` TypeInfo load, has to
// keep working.
import { args } from "std/os"

interface PaymentMethod {
  charge(amount: i64): i64,
}

fn one(): i64 {
  return i64(len(args()))
}

fn main() {
  let pm: PaymentMethod = nil
  let n = one()
  let sink: i64 = 0
  let i: i64 = 0
  print("start\n")
  while (i < n) {
    sink = sink + pm.charge(i)
    i = i + 1
  }
  print("unreachable ${sink}\n")
}
