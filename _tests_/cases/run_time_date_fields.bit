// run
// #4072: `Date` construction, validation, field accessors and toString.
// Builds 2026-09-01 and prints every field plus the canonical string;
// validates date()'s failure modes (out-of-range month, day and year) and
// its leap-day acceptance; and confirms dayOfWeek's ISO 8601 numbering (1
// Monday .. 7 Sunday) on a known Monday and a known Sunday. Every expected
// value is cross-checked against Python's datetime.isocalendar() and
// .timetuple().tm_yday, never derived from this module's own code
// (docs/stdlib/time.md, "Reading fields", "Constructing").
import { date } from "std/time"

fn dateFails(y: int, m: int, d: int): bool {
  date(y, m, d) catch _ {
    return true
  }
  return false
}

fn main() {
  let d = date(2026, 9, 1) catch e {
    println("build failed: ${e.message()}")
    return
  }
  println("year=${d.year()}")
  println("month=${d.month()}")
  println("day=${d.day()}")
  println("dayOfWeek=${d.dayOfWeek()}")
  println("dayOfYear=${d.dayOfYear()}")
  println("quarter=${d.quarter()}")
  println("daysInMonth=${d.daysInMonth()}")
  println("weekOfYear=${d.weekOfYear()}")
  println("toString=${d.toString()}")

  println("invalidDay=${dateFails(2026, 2, 30)}")
  println("invalidMonth=${dateFails(2026, 13, 1)}")
  println("invalidYearLow=${dateFails(0, 1, 1)}")
  println("invalidYearHigh=${dateFails(10000, 1, 1)}")
  println("leapDayOk=${!dateFails(2024, 2, 29)}")

  let monday = date(2024, 1, 1) catch e {
    println("monday build failed: ${e.message()}")
    return
  }
  println("mondayDayOfWeek=${monday.dayOfWeek()}")
  let sunday = date(2024, 1, 7) catch e {
    println("sunday build failed: ${e.message()}")
    return
  }
  println("sundayDayOfWeek=${sunday.dayOfWeek()}")
}
