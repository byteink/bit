// run
// stdlib/json/cst_value.bit's CST-to-Json projection (#1479's json epic,
// #1724), exercised behaviourally. Imports std/json rather than copying its
// CST types, parser and projection (#2458): golden cases can import std/*
// (tests/bit/golden.bit's checkRun exports BIT_STDLIB).
//
// Parses one JSONC document — comments in three positions, plus every Json
// scalar kind, an array, and a nested object — two ways: once through
// cstParse + cstToJson (the CST path under test), once through jsoncParse
// (the direct value parser, #1722). Both are rendered through the same debug
// stringifier and compared: comments must make no difference to the
// projected values.

import { Json, JsonEntry, cstParse, cstToJson, jsoncParse } from "std/json"

// --- debug stringifier, used only to compare the two Json trees ------------

fn jsonToDebugString(j: Json): string {
  match (j) {
    JsonNull => return "null"
    JsonBool(b) => {
      if (b) {
        return "true"
      }
      return "false"
    }
    JsonInt(i) => return "${i}"
    JsonFloat(f) => return "${f}"
    JsonString(s) => return "\"${s}\""
    JsonArray(a) => {
      let out = "["
      let i = 0
      while (i < len(a)) {
        if (i > 0) {
          out = out + ","
        }
        out = out + jsonToDebugString(a[i])
        i = i + 1
      }
      return out + "]"
    }
    JsonObject(entries) => {
      let out = "{"
      let i = 0
      while (i < len(entries)) {
        if (i > 0) {
          out = out + ","
        }
        out = out + "\"${entries[i].key}\":" + jsonToDebugString(entries[i].value)
        i = i + 1
      }
      return out + "}"
    }
  }
}

// --- test --------------------------------------------------------------

fn main() {
  // Comments in three positions (leading block comment on the whole file, a
  // leading `//` before a key, a same-line `/* */` trailing a value) plus
  // every Json scalar kind, an array, and a nested object.
  let src = "/* config */\n{\n  // name comment\n  \"name\": \"bit\", // trailing name comment\n  \"version\": 1,\n  \"pi\": 3.5,\n  \"enabled\": true,\n  \"disabled\": false,\n  \"extra\": null,\n  \"tags\": [\"a\", \"b\", /* mid */ \"c\"],\n  \"nested\": {\n    \"x\": 1,\n    \"y\": 2 // y comment\n  }\n}"

  let cst = cstParse(src) catch e {
    print("cstParse failed: ${e.message()}\n")
    return
  }
  let viaProjection = jsonToDebugString(cstToJson(cst))

  let direct = jsoncParse(src) catch e {
    print("jsoncParse failed: ${e.message()}\n")
    return
  }
  let viaDirect = jsonToDebugString(direct)

  print("projection=${viaProjection}\n")
  print("direct=${viaDirect}\n")
  print("match=${viaProjection == viaDirect}\n")
}
