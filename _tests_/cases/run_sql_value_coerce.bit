// run
// #6280: a parameter declared exactly `std/sql` `Value` — plain, or the
// element type of a variadic `...values: Value` — accepts any argument
// `sqlValue` accepts, converted at the call site AS THOUGH the caller had
// written `sqlValue(arg)`; `values()` (an empty variadic slot) and a call
// mixing several DIFFERENT Bit types in one `...values: Value` spread
// (never possible through a single generic `V`, #6279) both compile and run.
import { Value } from "std/sql"

fn describe(v: Value): string {
  match (v) {
    Null => return "Null"
    Int(n) => return "Int(${n})"
    Float(f) => return "Float(${f})"
    Bool(b) => return "Bool(${b})"
    Text(s) => return "Text(${s})"
    Blob(b) => return "Blob(${string(b)})"
  }
}

fn values(...vs: Value) {
  print("count=${len(vs)}\n")
  for v of vs {
    print("${describe(v)}\n")
  }
}

fn main() {
  values()
  values(1, "x", true, Option.None)
}
