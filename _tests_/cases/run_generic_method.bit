// run
class Stack<T> {
  items: []T
  push(v: T): Stack<T> {
    this.items = append(this.items, v)
    return this
  }
  size(): i64 {
    return len(this.items)
  }
  top(): T {
    return this.items[len(this.items) - 1]
  }
}

class Pair<A, B> {
  a: A
  b: B
  first(): A {
    return this.a
  }
  second(): B {
    return this.b
  }
}

fn main() {
  let ints = Stack<i64>{ items: [1, 2, 3] }
  print("${ints.size()} ${ints.top()}\n")

  let strs = Stack<string>{ items: ["a", "b"] }
  print("${strs.size()} ${strs.top()}\n")

  let grown = Stack<i64>{ items: [] }
  print("${grown.push(10).push(20).size()}\n")

  let p = Pair<i64, string>{ a: 7, b: "z" }
  print("${p.first()} ${p.second()}\n")
}
