// run
// #4071: the public `Zone` surface -- `zone()`/`utc()`/`localZone()`, and
// the name validation guarding `zone()` against path traversal
// (docs/stdlib/time.md, "Zones"). `zoneOffsetAt`/`zoneOffsetForWall` are
// deliberately unexported (constraint) and so cannot be reached from a
// separate module like this one -- proved for #4070's sibling `tzifParse`
// the same way, and re-proved here: `import { zoneOffsetAt } from
// "std/time"` fails E0046. Those two lookups are covered in-module by
// stdlib/time/zone.test.bit instead.
import { zone, utc, localZone } from "std/time"

fn zoneFails(name: string): bool {
  zone(name) catch _ {
    return true
  }
  return false
}

fn main() {
  let dubai = zone("Asia/Dubai") catch e {
    println("zone(Asia/Dubai) failed: ${e.message()}")
    return
  }
  println("dubaiName=${dubai.name}")

  let london = zone("Europe/London") catch e {
    println("zone(Europe/London) failed: ${e.message()}")
    return
  }
  println("londonName=${london.name}")

  println("traversalFails=${zoneFails("../../etc/passwd")}")
  println("absolutePathFails=${zoneFails("/etc/passwd")}")
  println("unknownZoneFails=${zoneFails("Nowhere/Nothing")}")
  println("dotComponentFails=${zoneFails("./Asia/Dubai")}")
  println("dotDotComponentFails=${zoneFails("Asia/../Dubai")}")
  println("emptyNameFails=${zoneFails("")}")
  println("trailingSlashFails=${zoneFails("Asia/Dubai/")}")

  let u = utc()
  println("utcName=${u.name}")

  let local = localZone()
  println("localZoneNonEmptyName=${len(local.name) > 0}")
}
