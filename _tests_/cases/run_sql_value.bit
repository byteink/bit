// run
// #6256: `sqlValue<V>` against every accepted kind, from OUTSIDE `std/sql` —
// the same reason `run_sql_row_find.bit` exists for `find<T>`: the compiler's
// retarget needs an IMPORTER to resolve `std/sql`'s own module id
// (`sqlValueStdModuleId`, compiler/checksqlvalue.bit), which a file inside
// `std/sql` itself cannot be (a self-import is E0044).
import { Value, sqlValue } from "std/sql"

fn describe(v: Value): string {
  match (v) {
    Null => return "Null"
    Int(n) => return "Int(${n})"
    Float(f) => return "Float(${f})"
    Bool(b) => return "Bool(${b})"
    Text(s) => return "Text(${s})"
    Blob(b) => return "Blob(${string(b)})"
  }
}

fn main() {
  print("${describe(sqlValue("sara@example.com"))}\n")
  print("${describe(sqlValue(5))}\n")
  print("${describe(sqlValue(true))}\n")
  print("${describe(sqlValue(3.5))}\n")
  print("${describe(sqlValue([]byte("hi")))}\n")
  print("${describe(sqlValue<Option<string>>(Option.None))}\n")
  print("${describe(sqlValue(Option.Some("x")))}\n")
  print("${describe(sqlValue(Option.Some(7)))}\n")
}
