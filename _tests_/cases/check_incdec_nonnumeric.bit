// error
// #1714/#2556: `++`/`--` require a numeric operand (SPEC §11.4, E0053).
// Positive coverage for the accepted numeric operand types — int, f32/f64,
// rune, an unannotated ("untyped") int local, a class field, a slice
// index, and a map entry — lives in the sibling `run_incdec_*.bit` cases.
// This is the negative side: `string` and `bool` must still be rejected,
// both `++` and `--`, with the exact E0053 text the checker emits.
fn main() {
  let s = "a"
  s++
  let b = true
  b--
  print("done\n")
}
