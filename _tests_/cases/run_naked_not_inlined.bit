// run
// #1636: a @naked body must NEVER be spliced into its caller.
//
// §10.3.1 @naked suppresses the prologue and the epilogue, so `shim`'s body is
// raw machine code that ends the call with its own `ret`. Inlined, that `ret`
// lands in the middle of `main`: `main` returns with its callee-saved registers
// and link register never restored, and everything after the call site — here
// the second `print` and `main`'s own epilogue — becomes unreachable. The
// program prints `pre` and then hangs or faults, with a clean build and no
// diagnostic at any stage.
//
// So the output below is the inline decision: `post` can only be reached
// through a real call instruction that returns to `main`.
@naked fn shim() {
  return asm volatile {
    x64 { 0xC3 }         // ret
    arm64 { 0xD65F03C0 } // ret
    clobber x64 { memory }
    clobber arm64 { memory }
  }
}

fn main() {
  print("pre\n")
  shim()
  print("post\n")
}
