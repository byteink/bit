// run
fn main() {
  let a = chan<i64>(1)
  let b = chan<i64>(1)
  b <- 42
  select {
    case x = <- a:
      print("a=${x}\n")
    case y = <- b:
      print("b=${y}\n")
  }
  select {
    case z = <- a:
      print("z=${z}\n")
    default:
      print("idle\n")
  }
  let c = chan<i64>(1)
  select {
    case c <- 7:
      print("sent\n")
    default:
      print("full\n")
  }
  let g = <- c
  print("got=${g}\n")
}
