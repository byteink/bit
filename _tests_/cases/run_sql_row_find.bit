// run
// #5054: `find<T>`/`findOne<T>`/`findOneOrFail<T>` against a fake `Conn`,
// proving the compiler's rewrite fires from OUTSIDE `std/sql` — the same
// reason `run_json_decode_lenient.bit` exists for `jsonDecode<T>`: a class
// carrying the mark a specialisation needs cannot be declared inside the
// stdlib module that defines it (a self-import is E0044), so the sugar
// itself is proven here instead.
import { Rows, Stmt, Tx, Value, find, findOne, findOneOrFail } from "std/sql"

class User {
  id: i64
  email: string
  @column("e_mail")
  mail: string
  active: bool
  avatar: []byte
  nick: Option<string>
  // No `@column`: the default is the field's own name in snake_case, so
  // this claims the "created_at" column.
  createdAt: string
}

// One canned result set: `cols`/`data` fixed at construction, `next` walks
// it once. `query` always returns the same rows regardless of `sqlText` —
// this fixture asserts what `find` does with a result, not what SQL it sent.
class fakeRows {
  cols: []string
  data: [][]Value
  i: int = -1
  next(): bool! {
    this.i = this.i + 1
    return this.i < len(this.data)
  }

  columns(): []string {
    return this.cols
  }

  value(col: int): Value {
    return this.data[this.i][col]
  }

  close() {}
}

class fakeConn {
  rows: fakeRows
  query(sqlText: string, params: []Value): Rows! {
    return fakeRows{ cols: this.rows.cols, data: this.rows.data }
  }

  exec(sqlText: string, params: []Value): int! {
    return 0
  }

  prepare(sqlText: string): Stmt! {
    fail newError("sql: fakeConn: prepare unused")
  }

  begin(): Tx! {
    fail newError("sql: fakeConn: begin unused")
  }

  close() {}
}

fn oneUserConn(): fakeConn {
  return fakeConn{
    rows: fakeRows{
      cols: ["id", "email", "e_mail", "active", "avatar", "nick", "created_at"],
      data: [
        [
          Value.Int(7), Value.Text("a@b.com"), Value.Text("m@b.com"), Value.Int(1),
          Value.Blob([]byte("px")), Value.Null, Value.Text("2026-01-01"),
        ],
      ],
    },
  }
}

fn emptyConn(): fakeConn {
  return fakeConn{ rows: fakeRows{ cols: []string(0), data: [][]Value(0) } }
}

fn idOnlyConn(): fakeConn {
  return fakeConn{ rows: fakeRows{ cols: ["id"], data: [[Value.Int(7)]] } }
}

fn nickText(u: User): string {
  if (isSome(u.nick)) {
    return unwrap(u.nick)
  }
  return "none"
}

// Wraps the absent-row `findOneOrFail` call so its own `?` propagates a
// unit result: `findOneOrFail<User>(...) catch e { ... }` used as a bare
// statement in `main` would otherwise have to produce a `User` on both
// paths, and printing the error is the only thing this call wants to do.
fn requireAbsentUser(conn: fakeConn): ()! {
  findOneOrFail<User>(conn, "SELECT * FROM users WHERE id = ?", Value.Int(9))?
}

fn main(): ()! {
  let users = find<User>(oneUserConn(), "SELECT * FROM users")?
  let u = users[0]
  print("find count=${len(users)} id=${u.id} email=${u.email} mail=${u.mail} active=${u.active} avatar=${string(u.avatar)} nick=${nickText(u)} createdAt=${u.createdAt}\n")

  let none = findOne<User>(emptyConn(), "SELECT * FROM users WHERE id = ?", Value.Int(9))?
  print("findOne absent isSome=${isSome(none)}\n")

  let some = findOne<User>(oneUserConn(), "SELECT * FROM users WHERE id = ?", Value.Int(7))?
  print("findOne present id=${unwrap(some).id}\n")

  requireAbsentUser(emptyConn()) catch e {
    print("findOneOrFail absent: ${e.message()}\n")
  }

  let must = findOneOrFail<User>(oneUserConn(), "SELECT * FROM users WHERE id = ?", Value.Int(7))?
  print("findOneOrFail present id=${must.id}\n")

  let id = findOneOrFail<i64>(idOnlyConn(), "SELECT id FROM users LIMIT 1")?
  print("findOneOrFail scalar id=${id}\n")
}
