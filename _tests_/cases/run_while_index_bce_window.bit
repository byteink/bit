// run
// #6840: a header testing `i + 3 < len(s)` proves `s[i]` .. `s[i + 3]`, and
// compiler/optbce.bit drops all four bounds checks in this Horspool scan
// (stdlib/http/message.bit's `headerEndIn`). The strides +2, +1 and +4 meet
// in one join, each at most `3 + 1`. The answers below pin that the elided
// loads still read the right bytes, at the start, the middle and the very end.
fn headerEnd(block: string): int {
  let i = 0
  while (i + 3 < len(block)) {
    let c = block[i + 3]
    if (c == '\n') {
      if (block[i] == '\r' && block[i + 1] == '\n' && block[i + 2] == '\r') {
        return i
      }
      i = i + 2
    } else if (c == '\r') {
      i = i + 1
    } else {
      i = i + 4
    }
  }
  return -1
}

// A slice window: `xs[i + 1]` under `i + 1 < len(xs)`, stepping by 2.
fn pairSums(xs: []int): int {
  let total = 0
  let i = 0
  while (i + 1 < len(xs)) {
    total = total + xs[i] * 10 + xs[i + 1]
    i = i + 2
  }
  return total
}

fn main() {
  print("${headerEnd("GET / HTTP/1.1\r\nHost: x\r\n\r\nbody")}\n")
  print("${headerEnd("\r\n\r\n")}\n")
  print("${headerEnd("ab\r\n\r\n")}\n")
  print("${headerEnd("ab\r\n\r")}\n")
  print("${headerEnd("abc")}\n")
  print("${headerEnd("")}\n")
  print("${headerEnd("\n\n\r\r\n\r\n")}\n")
  print("${pairSums([1, 2, 3, 4, 5])}\n")
  print("${pairSums([]int(0))}\n")
}
