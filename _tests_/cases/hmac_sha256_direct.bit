// run
// #2163: `hmac` takes a hash constructor `() => Hash`, and every SHA-2 family
// constructor should be directly usable there with no named wrapper function.
// `Sha256()` and `Sha512()` build the concrete classes, so a lambda
// `() => Sha256()` must satisfy `() => Hash` by itself. This case passes all
// three variants that way, so a regression to an invariant return type fails to
// compile rather than fails a value check.
//
// The tag values are RFC 4231 Test Case 1 (key = twenty 0x0b bytes, data =
// "Hi There"), which defines HMAC-SHA-224, HMAC-SHA-256 and HMAC-SHA-512 over
// the identical key/message pair — cross-checked independently against
// Python's `hmac`/`hashlib` stdlib, not derived from this compiler's own
// output.
import { hmac, encodeHex, Sha256, Sha256Bits, Sha512 } from "std/crypto"

fn repeatByte(n: int, v: byte): []byte {
  let out = []byte(n)
  let i = 0
  while (i < n) {
    out[i] = v
    i = i + 1
  }
  return out
}

fn main() {
  let key = repeatByte(20, 0x0b)
  let msg = []byte("Hi There")
  println("sha224=${encodeHex(hmac(() => Sha256(Sha256Bits.B224), key, msg))}")
  println("sha256=${encodeHex(hmac(() => Sha256(), key, msg))}")
  println("sha512=${encodeHex(hmac(() => Sha512(), key, msg))}")
}
