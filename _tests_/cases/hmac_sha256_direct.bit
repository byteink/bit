// run
// #2163, #6493: `hmac` names its hash with a `HashAlg` value, so every SHA-2
// family member is one enum variant, with no wrapper function and no lambda.
// This case passes the three variants RFC 4231 Test Case 1 defines.
//
// The tag values are RFC 4231 Test Case 1 (key = twenty 0x0b bytes, data =
// "Hi There"), which defines HMAC-SHA-224, HMAC-SHA-256 and HMAC-SHA-512 over
// the identical key/message pair — cross-checked independently against
// Python's `hmac`/`hashlib` stdlib, not derived from this compiler's own
// output.
import { hmac, encodeHex, HashAlg } from "std/crypto"

fn repeatByte(n: int, v: byte): []byte {
  let out = []byte(n)
  let i = 0
  while (i < n) {
    out[i] = v
    i = i + 1
  }
  return out
}

fn main() {
  let key = repeatByte(20, 0x0b)
  let msg = []byte("Hi There")
  println("sha224=${encodeHex(hmac(HashAlg.Sha224, key, msg))}")
  println("sha256=${encodeHex(hmac(HashAlg.Sha256, key, msg))}")
  println("sha512=${encodeHex(hmac(HashAlg.Sha512, key, msg))}")
}
