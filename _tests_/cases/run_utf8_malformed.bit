// run
// #2135: runeAt/runeCount/runes trusted the lead byte completely and read
// past the end of the string on truncated input, returning surrogates,
// overlongs, and values above U+10FFFF. Every malformed input here must
// decode as U+FFFD (65533), never read past len(s)-1, and runeCount/runes
// must agree with each other and terminate.
import { runeAt, runeCount, runes } from "std/strings"

// Builds an n-byte string from up to 4 raw bytes, so malformed UTF-8 (which
// cannot appear in a Bit source-string literal) is constructed byte-by-byte.
fn raw(a: u8, b: u8, c: u8, d: u8, n: int): string {
  let x = []byte(n)
  if (n > 0) {
    x[0] = a
  }
  if (n > 1) {
    x[1] = b
  }
  if (n > 2) {
    x[2] = c
  }
  if (n > 3) {
    x[3] = d
  }
  return string(x)
}

fn checkMalformed(label: string, s: string) {
  let cp = runeAt(s, 0)
  let rc = runeCount(s)
  let rs = runes(s)
  assert(int(cp) == 65533, "${label}: runeAt(0) must be U+FFFD, got ${int(cp)}")
  assert(rc == len(rs), "${label}: runeCount must agree with len(runes), got ${rc} vs ${len(rs)}")
  println("${label} runeAt=${int(cp)} runeCount=${rc} runesLen=${len(rs)}")
}

fn main() {
  checkMalformed("truncated-2of3", raw(0xE6, 0x97, 0, 0, 2))
  checkMalformed("truncated-3of4", raw(0xF0, 0x9F, 0x91, 0, 3))
  checkMalformed("lone-continuation", raw(0x80, 0, 0, 0, 1))
  checkMalformed("lone-surrogate", raw(0xED, 0xA0, 0x80, 0, 3))
  checkMalformed("overlong-2byte", raw(0xC0, 0xAF, 0, 0, 2))
  checkMalformed("overlong-3byte", raw(0xE0, 0x80, 0xAF, 0, 3))
  checkMalformed("impossible-ff", raw(0xFF, 0, 0, 0, 1))

  let t = raw(0xE6, 0x97, 0, 0, 2)
  let past = runeAt(t, 9)
  assert(int(past) == 65533, "past-end: runeAt must be U+FFFD, got ${int(past)}")
  println("past-end runeAt=${int(past)}")

  assert(runeAt("héllo", 1) == rune(233), "well-formed héllo[1] must decode unchanged")
  assert(runeAt("日本語", 0) == rune(26085), "well-formed 日本語[0] must decode unchanged")
  assert(runeAt("👍", 0) == rune(128077), "well-formed 👍[0] must decode unchanged")
  assert(runeCount("👍👍") == 2, "well-formed runeCount must be unchanged")
  assert(len(runes("日本語")) == 3, "well-formed runes length must be unchanged")
  println("wellformed ok")
}
