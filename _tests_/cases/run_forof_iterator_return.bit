// run
// An early `return` from inside `for x of it`, where `it`'s type declares
// `next(): Option<T>`, proven three ways in one printed line: `result` is the
// value the `return` carried out of the function, `calls` stays below `total`
// (the loop did not drain the iterator), and `tailRan` stays 0 (the statement
// after the loop is reachable only if the `return` did NOT fire). `total` and
// `threshold` come from `len` of a slice built at run time.
class Counter {
  n: i64
  calls: i64
  tailRan: i64
  next(): Option<i64> {
    if (this.n <= 0) {
      return Option.None
    }
    this.calls = this.calls + 1
    this.n = this.n - 1
    return Option.Some(this.n)
  }
}

fn findBelow(it: Counter, threshold: i64): i64 {
  for x of it {
    if (x < threshold) {
      return x
    }
  }
  it.tailRan = 1
  return -1
}

fn main() {
  let sizer = [1, 1, 1, 1, 1, 1]
  let total: i64 = len(sizer)
  let threshold = total / 2
  let it = Counter{ n = total, calls = 0, tailRan = 0 }
  let result = findBelow(it, threshold)
  print("result=${result} calls=${it.calls} total=${total} tailRan=${it.tailRan}\n")
}
