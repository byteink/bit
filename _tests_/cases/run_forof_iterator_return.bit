// run
// #5563 (epic #4107): an early `return` from inside `for x of it` where
// `it`'s type declares `next(): Option<T>` (docs/reference/iterator-trait.md,
// "Open questions for the children" — the doc only asserted this needs no
// lowering change beyond the four built-ins; this fixture is the proof).
//
// Three independent proofs in one printed line, all derived at run time:
// `result` is the value the early `return` carried out through the
// function boundary; `calls` (only `next()` calls that returned `Some`)
// stays below `total`, proving the loop did not drain the iterator; and
// `tailRan` stays 0 because the statement after the `for … of` loop, still
// inside `findBelow`, is only reachable if the early `return` did NOT fire.
class Counter {
  n: i64,
  calls: i64,
  tailRan: i64,
  next(): Option<i64> {
    if (this.n <= 0) {
      return Option.None
    }
    this.calls = this.calls + 1
    this.n = this.n - 1
    return Option.Some(this.n)
  }
}

fn findBelow(it: Counter, threshold: i64): i64 {
  for x of it {
    if (x < threshold) {
      return x
    }
  }
  it.tailRan = 1
  return -1
}

fn main() {
  let sizer = [1, 1, 1, 1, 1, 1]
  let total: i64 = len(sizer)
  let threshold = total / 2
  let it = Counter{ n: total, calls: 0, tailRan: 0 }
  let result = findBelow(it, threshold)
  print("result=${result} calls=${it.calls} total=${total} tailRan=${it.tailRan}\n")
}
