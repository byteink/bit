// run
// #5288: `emitDecimalAddCore` (lowerdecimalarith.bit) read the 96-bit
// UNSIGNED magnitude as TWO'S-COMPLEMENT, so any magnitude in [2^95, 2^96) —
// roughly the top half of `decimal`'s documented range — already has bit 95
// set on its own unsigned bit pattern and got misread as negative, false-
// overflow-panicking `+`, `-` and all six comparisons. `big`/`big2` are built
// via multiply (a literal cannot spell 29 digits, §11.1) to sit at
// `5*10^28`/`6*10^28`, both past 2^95 (~3.9614e28) and well under the 96-bit
// ceiling (~7.9228e28).
fn main() {
  let n1e9: decimal = 1000000000
  let n1e18 = n1e9 * n1e9
  let n50: decimal = 50000000000
  let n60: decimal = 60000000000
  let big = n50 * n1e18
  let big2 = n60 * n1e18
  println("${big}")
  println("${big + 1}")
  println("${big2 - big}")
  println("${big < big2}")
  println("${big2 > big}")
  let negBig = -big
  println("${negBig}")
  println("${negBig + 1}")
  println("${negBig < 0}")
}
