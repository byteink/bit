// panic
// #4354, the sibling of run_forof_index_next_panic.bit: the loop index used to
// address a DIFFERENT, SHORTER slice. `for x of xs` proves `i < len(xs)` and
// nothing whatever about `len(ys)`, so `ys[i]` must still be tested and must
// panic on the first index past `ys`.
//
// Pinned separately because the two shapes fail differently under a wrong
// generalisation: `xs[i + 1]` reads one word past a buffer the program owns,
// while `ys[i]` reads arbitrarily far past a much smaller one. The progress
// lines fix the iteration at which the panic is owed.
fn main() {
  let xs = [1, 2, 3, 4, 5]
  let ys = [10, 20]
  for (i, x) of xs {
    eprint("i=${i} x=${x}\n")
    eprint("y=${ys[i]}\n")
  }
  eprint("unreachable\n")
}
