// run
// #2159: repeat/join concatenated in a loop (`out = out + x`), which copies
// everything accumulated so far on every iteration — O(n^2). Both now fill
// one []byte by index, since the output length is known up front. 400,000-char
// repeat and a 200,000-part join must both complete well inside the golden
// harness's timeout (repeat(400_000) used to take ~116s, join(200_000) ~71s).
import { join, repeat } from "std/strings"

fn main() {
  let r = repeat("!", 400000)
  println("repeat len=${len(r)}")

  let parts = []string(200000)
  let i = 0
  while (i < 200000) {
    parts[i] = "x"
    i = i + 1
  }
  let j = join(parts, ",")
  println("join len=${len(j)}")

  println("small=${repeat("ab", 3)}")
  println("empty-n=[${repeat("x", 0)}][${repeat("x", -1)}]")
  println("empty-s=[${repeat("", 5)}]")
  println("join-sep=${join(["a", "b", "c"], "-")}")
  println("join-empty=[${join([]string(0), "-")}]")
}
