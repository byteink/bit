// error
// #6997: a field of `T` named like a combinator wins as a top-level key, so the
// combinator cannot be spelled there; the error says to build it with std/where.
import { Where } from "std/where"

class Rule {
  id: i64
  or: bool
}

fn main() {
  let a: Where<Rule> = { or: true }
  let b: Where<Rule> = { or: [{ id: 1 }, { id: 2 }] }
}
