// run
// #4577: two `a || !b` branches on one condition in a function. The arm64
// redundant-branch fold certified the second branch's block through its
// `fromBlock == targetBlock` early return although that join has TWO
// predecessors (the first `||`'s false arm reaches it with the condition
// still false), so the second test was dropped and c2 became `survives`.
// Only the SECOND of a run was wrong; the third was right again.
fn id(b: bool): bool {
  return b
}

fn show(n: int) {
  let survives = n == 1
  let x = id(false)
  let y = id(false)
  let z = id(false)
  let c1 = survives || !x
  let c2 = survives || !y
  let c3 = survives || !z
  print("c1=${c1} c2=${c2} c3=${c3}\n")
}

fn main() {
  show(4)
  show(1)
}
