// run
// #3862: converting an indexed element to an interface (`let s: Summable =
// xs[0]`) disqualifies its element type — interface dispatch loads the
// method table pointer at a fixed offset behind the receiver (`*(recv - 32)`
// in the boxed representation), which an inline element's computed address
// has no header for at all. `Node` therefore stays boxed (stride 8) for the
// whole module, and dynamic dispatch through the interface value works
// exactly as it would for any other class.
interface Summable {
  sum(): i64,
}

class Node {
  x: i64
  y: i64
  sum(): i64 { return this.x + this.y }
}

fn main() {
  let batch = [Node{ x: 1, y: 2 }, Node{ x: 3, y: 4 }]
  let s: Summable = batch[0]
  print("${s.sum()} ${batch[1].sum()}\n")
}
