// error
// #5315: E0159 (SPEC §10.3) is unchanged by the method arity fix -- a
// method's default value must still be a constant literal, exactly as
// fn_default_arg_not_const.bit pins for a free function.

class C {
  export m(x: int = 1 + 1): int {
    return x
  }
}

fn main() {
  let c = C{}
  print("${c.m()}\n")
}
