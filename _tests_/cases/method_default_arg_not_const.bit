// run
// #6112 (SPEC §10.3): the method arity fix (#5315) still runs the WIDENED
// default rule — a method's default is a call-site-evaluated expression, not
// a bare literal, exactly like a free function's (fn_default_arg_not_const.bit).
// Was `method_default_arg_not_const.bit`'s pinned E0159 error before #6112.

class C {
  export m(x: int = 1 + 1): int {
    return x
  }
}

fn main() {
  let c = C{}
  print("${c.m()}\n")
}
