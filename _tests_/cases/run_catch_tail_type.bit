// run
// #2981: companion ACCEPT case for the reject fixture
// _tests_/bit/checkercases/check_catch_tail_type.bit. A catch-bind block's
// trailing bare expression IS the block's value and must type-check against
// the operand's unwrapped ok type — but only when that ok type is non-void.
// Two shapes here: a correctly-typed tail for a non-void `i64!` operand, and
// a void-ok `()!` catch whose tail is a bare (void) expression statement —
// #2103's exemption, which vCatchBind's new check must not regress.
class myErr {
  code: i64
  message(): string { return "code=${this.code}" }
}
fn f(): i64! { fail myErr{ code: 1 } }
fn g(ok: bool): ()! {
  if (ok) {
    return
  }
  fail myErr{ code: 2 }
}

fn main() {
  let v: i64 = f() catch e {
    len(e.message())
  }
  println("v=${v}")
  g(false) catch e {
    println("caught: ${e.message()}")
  }
  println("done")
}
