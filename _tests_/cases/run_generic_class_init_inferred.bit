// run
// #6364: a generic class constructed with no type arguments written infers
// them from `init`'s arguments, the way a generic function call does (SPEC
// 10.4, 15.3). `Pair(7, "s")` builds a `Pair<i64, string>`; named arguments
// place each value at the parameter its name fills, so `Pair(second = "s",
// first = 7)` infers the same instantiation. Every shape below: positional,
// named, mixed, a defaulted parameter, a fallible `init`, a nested call, a
// construction inside a generic function and inside the class's own method, a
// slice argument, and an `init` whose parameter is itself an instantiation.
class Bad {
  requested: i64

  message(): string {
    return "bad ${this.requested}"
  }
}

class Pair<A, B> {
  a: A
  b: B

  init(first: A, second: B) {
    this.a = first
    this.b = second
  }

  swap(): Pair<B, A> {
    return Pair(this.b, this.a)
  }

  same(): Pair<A, B> {
    return Pair(this.a, this.b)
  }
}

class Checked<T> {
  v: T

  init(v: T, ok: bool)!Bad {
    if (!ok) {
      fail Bad{ requested = 1 }
    }
    this.v = v
  }
}

class Dflt<T> {
  v: T
  n: i64

  init(v: T, n: i64 = 5) {
    this.v = v
    this.n = n
  }
}

class Bag<T> {
  xs: []T

  init(xs: []T) {
    this.xs = xs
  }
}

class Wrap<T> {
  inner: Pair<T, T>

  init(inner: Pair<T, T>) {
    this.inner = inner
  }
}

fn build<X, Y>(x: X, y: Y): Pair<X, Y> {
  return Pair(second = y, first = x)
}

fn main(): ()! {
  let p = Pair(7, "s")
  print("${p.a} ${p.b}\n")
  let q = Pair(second = "t", first = 8)
  print("${q.a} ${q.b}\n")
  let m = Pair(9, second = "u")
  print("${m.a} ${m.b}\n")
  let s = q.swap()
  print("${s.a} ${s.b}\n")
  let t = q.same()
  print("${t.a} ${t.b}\n")
  let n = Pair(Pair(1, 2), "n")
  print("${n.a.a} ${n.a.b} ${n.b}\n")
  let f = Pair(1.5, true)
  print("${f.a} ${f.b}\n")
  let ck = Checked("ok", true)?
  print("${ck.v}\n")
  let d = Dflt("x")
  print("${d.v} ${d.n}\n")
  let d2 = Dflt(n = 9, v = "y")
  print("${d2.v} ${d2.n}\n")
  let g = build(3, true)
  print("${g.a} ${g.b}\n")
  let g2 = build("z", 4.5)
  print("${g2.a} ${g2.b}\n")
  let bag = Bag(["a", "b", "c"])
  print("${len(bag.xs)} ${bag.xs[2]}\n")
  let w = Wrap(Pair(4, 5))
  print("${w.inner.a} ${w.inner.b}\n")
  Checked(ok = false, v = "no") catch e {
    print("rejected: ${e.message()}\n")
    return
  }
}
