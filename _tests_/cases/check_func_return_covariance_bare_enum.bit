// error
// #5254/#5216: a function type's return component is covariant under
// interface satisfaction, but only through `vStorableInInterface` — the
// same predicate #5216 added because a BARE-TAG enum stored behind an
// interface is a raw i64, not the GC object pointer an interface value
// must hold, and SEGFAULTs. `Color` has no payload-carrying variant, so
// `(int) => Color` must stay rejected as a `(int) => Sized`, exactly as a
// bare `Color` value is rejected on its own (SPEC §14.3).
interface Sized {
  size(): int,
}

enum Color {
  Red
  Green
  Blue

  export size(): int {
    match (this) {
      Red => return 1
      Green => return 2
      Blue => return 3
    }
  }
}

type Sizer = (int) => Sized

fn pick(x: int): Color {
  if (x == 1) {
    return Color.Red
  }
  return Color.Green
}

fn takesSizer(s: Sizer): int { return s(1).size() }

fn main() {
  print("${takesSizer(pick)}\n")
}
