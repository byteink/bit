// run
// #2407, the wider matrix: a switch-case label test and `==` are the SAME
// operator, so every comparable subject type must get the same answer from both
// spellings. Each line below prints the switch's verdict next to the `==` on the
// identical pair of values; a line reading anything but two matching verdicts is
// the two paths having drifted apart again.
//
// Every reference-typed subject is built at RUN TIME (a concatenation, a call),
// never written as a literal in the switch: the string pool interns by content,
// so a literal subject and a literal label are the same handle and the
// handle-compare bug this pins was invisible against them. `litSubject` keeps the
// literal form covered too — it worked before the fix and must keep working.
//
// The scalar subjects (int with a multi-label case, u8, rune, bool) are the
// paths that were already correct with a word compare and must not be taken with
// the fix. `f32` is in the same list for a different reason: it was NOT correct
// before — a float subject was compared as two integer registers, so
// `case 1.5:` never matched a 1.5 subject.
//
// Single-file golden: no prelude.
class P { x: int, s: string }

fn cat(a: string, b: string): string {
  return a + b
}

fn pair(a: int, b: string): (int, string) {
  return a, b
}

// The three-way string switch: one exact label, one multi-label case, and a
// default. Called with values that hit each arm.
fn classify(s: string): string {
  switch (s) {
    case "one":
      return "ONE"
    case "two", "three":
      return "MULTI"
    default:
      return "OTHER"
  }
}

fn litSubject(): string {
  switch ("lit") {
    case "lit":
      return "hit"
    default:
      return "miss"
  }
}

fn main() {
  let s = cat("o", "ne")
  let sw = "no"
  switch (s) {
    case "one":
      sw = "yes"
    default:
      sw = "no"
  }
  print("string   switch=${sw} eq=${s == "one"}\n")
  print("literal  switch=${litSubject()}\n")
  print(
    "classify ${classify(cat("o", "ne"))} ${classify(cat("thr", "ee"))} ${classify(cat("fo", "ur"))}\n",
  )

  let p = P{ x: 1, s: cat("a", "b") }
  let ps = "no"
  switch (p) {
    case P{ x: 1, s: "ab" }:
      ps = "yes"
    default:
      ps = "no"
  }
  print("class   switch=${ps} eq=${p == P{ x: 1, s: "ab" }}\n")

  let pn = "no"
  switch (p) {
    case P{ x: 2, s: "ab" }:
      pn = "yes"
    default:
      pn = "no"
  }
  print("class!  switch=${pn} eq=${p == P{ x: 2, s: "ab" }}\n")

  let t = pair(1, cat("a", "b"))
  let ts = "no"
  switch (t) {
    case pair(1, "ab"):
      ts = "yes"
    default:
      ts = "no"
  }
  print("tuple    switch=${ts} eq=${t == pair(1, "ab")}\n")

  let n = 2
  let ns = "no"
  switch (n) {
    case 1, 2:
      ns = "yes"
    default:
      ns = "no"
  }
  print("int      switch=${ns} eq=${n == 2}\n")

  let u: u8 = 200
  let us = "no"
  switch (u) {
    case 200:
      us = "yes"
    default:
      us = "no"
  }
  print("u8       switch=${us} eq=${u == 200}\n")

  let g: f32 = 1.5
  let gs = "no"
  switch (g) {
    case 1.5:
      gs = "yes"
    default:
      gs = "no"
  }
  print("f32      switch=${gs} eq=${g == 1.5}\n")

  let r = 'x'
  let rs = "no"
  switch (r) {
    case 'x':
      rs = "yes"
    default:
      rs = "no"
  }
  print("rune     switch=${rs} eq=${r == 'x'}\n")

  let b = true
  let bs = "no"
  switch (b) {
    case true:
      bs = "yes"
    default:
      bs = "no"
  }
  print("bool     switch=${bs} eq=${b == true}\n")

  // Arms that mix a non-matching literal label with a computed one: the second
  // arm's label is only evaluated because the first did not match.
  let m = cat("z", "z")
  let ms = "none"
  switch (m) {
    case "aa":
      ms = "first"
    case cat("z", "z"):
      ms = "second"
    default:
      ms = "default"
  }
  print("mixed    switch=${ms}\n")

  // A subject-less `switch { case cond: }` tests each label as a bool and has no
  // subject to compare — it must be untouched by any of the above.
  let q = 7
  let cs = "no"
  switch {
    case q < 0:
      cs = "neg"
    default:
      cs = "pos"
  }
  print("cond     switch=${cs}\n")

  // A string switch inside a loop: the subject is a fresh value each iteration
  // and the matching arm breaks out of the switch, not the loop.
  let hits = 0
  let i = 0
  while (i < 3) {
    switch (cat("k", "${i}")) {
      case "k1":
        {
          hits = hits + 1
          break
        }
      default:
        {}
    }
    i = i + 1
  }
  print("loop     hits=${hits}\n")
}
