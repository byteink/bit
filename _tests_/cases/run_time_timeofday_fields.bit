// run
// #4073: `Time` construction, validation, field accessors and toString.
// Builds 09:00:00 (via `time`) and 09:00:00.000000500 (via `timeNs`) and
// prints every field plus the canonical string for each; validates
// `time`/`timeNs`'s failure modes: hour 24 (no end-of-day alias), minute
// 60, second 60 (no leap seconds), and a nanosecond of one whole second
// (docs/stdlib/time.md, "Constructing", "Reading fields", "Formatting").
import { time, timeNs } from "std/time"

fn timeFails(h: int, m: int, s: int): bool {
  time(h, m, s) catch _ {
    return true
  }
  return false
}

fn timeNsFails(h: int, m: int, s: int, ns: int): bool {
  timeNs(h, m, s, ns) catch _ {
    return true
  }
  return false
}

fn main() {
  let a = time(9, 0, 0) catch e {
    println("build a failed: ${e.message()}")
    return
  }
  println("a.hour=${a.hour()}")
  println("a.minute=${a.minute()}")
  println("a.second=${a.second()}")
  println("a.nanosecond=${a.nanosecond()}")
  println("a.toString=${a.toString()}")

  let b = timeNs(9, 0, 0, 500) catch e {
    println("build b failed: ${e.message()}")
    return
  }
  println("b.hour=${b.hour()}")
  println("b.minute=${b.minute()}")
  println("b.second=${b.second()}")
  println("b.nanosecond=${b.nanosecond()}")
  println("b.toString=${b.toString()}")

  println("invalidHour=${timeFails(24, 0, 0)}")
  println("invalidMinute=${timeFails(0, 60, 0)}")
  println("invalidSecond=${timeFails(23, 59, 60)}")
  println("invalidNanosecond=${timeNsFails(0, 0, 0, 1000000000)}")
}
