// run
// stdlib/json/encode.bit's jsonEncode (#1719), exercised behaviourally.
//
// Used to redeclare the same shapes and encoder logic locally on the stated
// belief that "a golden case is single-file with no prelude and cannot
// import std/json". That belief is false (#2421): `_tests_/bit/golden.bit`'s
// `checkRun` runs `bit build <case>` with `BIT_STDLIB` exported, so the
// import below resolves exactly as it would for any other caller. The local
// copy's float formatting had also drifted from the module's (#3042): the
// copy printed a bare `"${f}"`, missing #2282's fix that appends `.0` to an
// integral float's text so it round-trips as a float rather than colliding
// with JsonInt's text.
//
// Covers: nested object + array, a string needing every mandatory escape
// (quote, backslash, newline, tab, and a control byte with no short escape),
// int (no ".0"), float (an integral float still prints ".0"), bool, null —
// and a round-trip check: two independently-built trees that describe the
// same value must encode to the exact same string, since there is no parser
// yet to decode the output back through.
import { Json, JsonEntry, jsonEncode } from "std/json"

// The tree under test: nested object/array, an escape-needing string, int,
// float, bool, null.
fn buildTree(): Json {
  return Json.JsonObject([]JsonEntry{
    JsonEntry{ key: "name", value: Json.JsonString("bit\n\"lang\"\t\u{1}") },
    JsonEntry{ key: "count", value: Json.JsonInt(42) },
    JsonEntry{ key: "ratio", value: Json.JsonFloat(2.0) },
    JsonEntry{ key: "ok", value: Json.JsonBool(true) },
    JsonEntry{ key: "nil", value: Json.JsonNull },
    JsonEntry{ key: "list", value: Json.JsonArray([]Json{
      Json.JsonInt(1),
      Json.JsonInt(2),
      Json.JsonInt(3),
    }) },
    JsonEntry{ key: "nested", value: Json.JsonObject([]JsonEntry{
      JsonEntry{ key: "inner", value: Json.JsonBool(false) },
    }) },
  })
}

fn main() {
  let tree = buildTree()
  print(jsonEncode(tree))
  print("\n")

  // Round-trip check: since #1719 lands before the parser task, there is no
  // decoder to feed the output back through. Instead, two independently
  // built trees describing the same value must encode to the identical
  // string — the closest self-check available without a parser.
  let again = buildTree()
  if (jsonEncode(tree) == jsonEncode(again)) {
    print("roundtrip=ok\n")
  } else {
    print("roundtrip=FAIL\n")
  }
}
