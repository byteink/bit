// run
// #4688: named arguments on a class CONSTRUCTOR call, `Acct(fee = 5,
// start = 100)`. #4323 gave methods named arguments and left `init` out of
// scope, yet a constructor is exactly the call whose bare positional
// arguments say nothing.
//
// The checker rejected it at the top of `vCallResolveBuiltin`
// (validatecall.bit), which was written for a builtin and a conversion —
// callees with no declared parameter list. `init` HAS one, and the lowering
// side already funnelled through `lowerArgsForMethod(.., "init")`, so the
// missing piece was only the checker branch.
//
// `Acct(start, fee)` is deliberately (i64, i64): the two are interchangeable
// by TYPE, so only the printed value can tell a misplaced argument from a
// placed one. `Conn(host, port, tls)` is the opposite case — three distinct
// types, so a swap would not compile at all.
//
// The last constructor is the evaluation-order proof, the one no arity or
// type check can make: `g()` and `h()` both print and are written in the
// reverse of their declared order. Arguments must evaluate in WRITTEN order
// (g then h) while landing in DECLARED slots.

class Acct {
  bal: i64
  init(start: i64, fee: i64) {
    this.bal = start - fee
  }
}

class Conn {
  tag: string
  init(host: string, port: i64, tls: bool) {
    this.tag = "${host}:${port} tls=${tls}"
  }
}

class Bag {
  total: i64
  label: string
  init(label: string, ...ns: i64) {
    this.label = label
    let sum = 0
    for n of ns {
      sum = sum + n
    }
    this.total = sum
  }
}

fn g(): i64 {
  print("g\n")
  return 100
}

fn h(): i64 {
  print("h\n")
  return 5
}

fn main() {
  print("${Acct(100, 5).bal}\n")
  print("${Acct(start = 100, fee = 5).bal}\n")
  print("${Acct(fee = 5, start = 100).bal}\n")
  print("${Acct(100, fee = 5).bal}\n")

  print(Conn(tls = true, host = "db", port = 5432).tag + "\n")

  // A VARIADIC `init`: a named argument fills the fixed prefix and the rest
  // parameter binds the empty slice, never a name of its own.
  let b = Bag(label = "empty")
  print("${b.label}=${b.total}\n")
  let c = Bag("three", 1, 2)
  print("${c.label}=${c.total}\n")

  print("${Acct(fee = h(), start = g()).bal}\n")
}
