// error
// #5244: a defaulted parameter followed by one with no default (SPEC §10.3).
// Once `a` is optional, a call supplying only its own positional prefix could
// never reach the required `b` -- rejected on the signature itself.

fn f(a: int = 1, b: int): int {
  return a + b
}

fn main() {
  print("${f(1, 2)}\n")
}
