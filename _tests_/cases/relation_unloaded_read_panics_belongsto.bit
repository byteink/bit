// panic
//
// #6290: the singular ("bare-class") half of relation_unloaded_read_panics.bit
// -- a `@belongsTo` field, not `@hasMany`'s `[]T`. Before #6290,
// `fieldNeedsUnloadedSentinel` (compiler/classrelationattr.bit) was scoped
// to `TypeKind.Slice` only, so `Post{ id = 1, authorId = 1 }` omitting
// `author` was outright an E0083 compile error ("no zero value") rather
// than a runtime "unloaded" read. Now the same sentinel/panic pair
// `relation_unloaded_read_panics.bit` pins for `[]Order` covers a bare
// `Author` target too: `fillOmittedFields` (compiler/lowerslicefill.bit)
// writes `relationUnloadedSentinel` into `author`'s slot, and
// `p.author` (compiler/loweraccess.bit's `lowerFieldAccess`) panics before
// the sentinel word could be read as a live `Author` reference. Sibling
// fixture relation_loaded_read_ok_belongsto.bit is the required negative: a
// real `Author` assigned before the read, which does not panic.
import { FieldDesc, AttrDesc } from "std/sql"

@table class Author {
  @id
  id: i64
  name: string
}

@table class Post {
  @id
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn main() {
  let p = Post{ id = 1, authorId = 7 }
  print("${p.author.name}\n")
}
