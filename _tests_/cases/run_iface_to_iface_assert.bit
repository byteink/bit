// run
// #7406: `x.(I)` and `let (v, ok) = x.(I)` where `x` has one interface type and
// `I` is ANOTHER interface (SPEC §14.4): true when the dynamic type implements
// `I`, the Go idiom `if s, ok := w.(io.ReaderFrom)`. The verdict is cached per
// (dynamic type, interface), so the loop at the end asks the same question a
// million times and must stay a lookup: that program allocates nothing per
// iteration (checked with `BIT_GC_STATS=1`, swept+live identical at 1000 and at
// 1000000 iterations).
interface Transport {
  send(): int,
}

interface Scheme {
  scheme(): string,
}

interface Closer {
  close(): int,
}

interface Both {
  scheme(): string,
  close(): int,
}

interface Anything {}

class Plain {
  export send(): int { return 1 }
}

class Smtp {
  export send(): int { return 2 }
  export scheme(): string { return "smtp" }
}

class Pooled {
  export send(): int { return 3 }
  export scheme(): string { return "pooled" }
  export close(): int { return 30 }
}

// Same method NAME as `Scheme.scheme`, different result type: never a hit.
class Odd {
  export send(): int { return 4 }
  export scheme(): int { return 7 }
}

fn label(t: Transport): string {
  let (s, ok) = t.(Scheme)
  if (ok) {
    return s.scheme()
  }
  return "custom"
}

fn both(t: Transport): string {
  let (b, ok) = t.(Both)
  if (ok) {
    return "both ${b.scheme()} ${b.close()}"
  }
  return "not both"
}

fn count(t: Transport, n: int): int {
  let hits = 0
  let i = 0
  while (i < n) {
    let (c, ok) = t.(Closer)
    if (ok) {
      hits = hits + c.close()
    }
    i = i + 1
  }
  return hits
}

fn main() {
  let a: Transport = Plain{}
  let b: Transport = Smtp{}
  let c: Transport = Pooled{}
  let d: Transport = Odd{}
  println("label ${label(a)} ${label(b)} ${label(c)} ${label(d)}")
  println("both ${both(a)} | ${both(b)} | ${both(c)}")
  // The one-result form narrows and dispatches through the new interface.
  let s = c.(Scheme)
  println("one ${s.scheme()}")
  // A class implementing both: the same value answers each interface.
  let (cl, ok) = c.(Closer)
  println("closer ${ok} ${cl.close()}")
  // The empty interface is satisfied by every dynamic type.
  let (any, anyOk) = a.(Anything)
  println("any ${anyOk} ${any != nil}")
  // A nil interface value has no dynamic type: a miss, never a crash.
  let n: Transport = nil
  let (ns, nok) = n.(Scheme)
  println("nil ${nok} ${ns == nil}")
  // `error` is an interface too.
  let (e, eok) = b.(error)
  println("error ${eok} ${e == nil}")
  println("loop ${count(c, 1000000)} ${count(a, 1000000)}")
}
