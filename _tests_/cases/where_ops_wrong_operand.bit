// error
// #6997: an operand must have the field's type: a string under `gte` on an
// integer field, a scalar where `in` wants a list, a list of the wrong type, and
// `nil` under an ordering operator.
import { Where } from "std/where"

class Article {
  id: i64,
  age: i64,
  seen: Option<i64>,
}

fn main() {
  let a: Where<Article> = { age: { gte: "18" } }
  let b: Where<Article> = { age: { in: 18 } }
  let c: Where<Article> = { age: { in: [1, "two"] } }
  let d: Where<Article> = { seen: { gt: nil } }
}
