// run
// #6092: `append(dst, v)` on a NON-NULL `dst` must return an INDEPENDENT
// header — `dst` itself (and any earlier `append` result built from it) must
// never observe a later call's growth. Before #6092, `rtSliceAppend` mutated
// `dst`'s own header in place and returned it, so `dst` and every derived
// result aliased the exact same header object; this case pins that they no
// longer do, on every path the runtime distinguishes: spare capacity, a
// reslice view (non-zero and zero `off`), a grow, a regrow, the packed byte
// stride, a null header, reference elements, and floats.
//
// The compiler's own inline expansion of the spare-capacity case (#4039,
// `compiler/optappend.bit`) could not preserve this without a `gcAlloc` call
// inside a block its own GC-hazard comment requires to stay call-free, so
// #6092 retired it: `slice_append`/`slice_append_str` now always reach the
// runtime entry points this file exercises, and there is no separate inline
// shape left to pin against them.
//
// Buffer sharing on spare capacity is UNCHANGED and still Go's documented
// hazard (SPEC §12.6): two results built from the same base can still
// overwrite each other's newly written ELEMENT DATA in unused capacity. What
// #6092 fixed is that a LENGTH change on one result can never again bleed
// into another's header.
fn main() {
  // Spare capacity, no grow: `a` keeps its own (unchanged) length; only `b`
  // observes the new one. The element still lands in the shared buffer, so
  // it is readable through `b`, not through `a` (`a`'s own length is still 0).
  let a = []int(0, 4)
  let b = append(a, 7)
  print("header: alen=${len(a)} blen=${len(b)} acap=${cap(a)} b0=${b[0]}\n")

  // Shared buffer through a reslice: `v` is a view onto `c`'s buffer with room
  // to spare, so appending through `v` writes into `c`'s slot 1 — but `v`
  // itself keeps its own length (1, not 2).
  let c = []int(4, 8)
  c[0] = 10
  c[1] = 11
  c[2] = 12
  c[3] = 13
  let v = c[0:1]
  let v2 = append(v, 99)
  print("alias:  c1=${c[1]} vlen=${len(v)} v2len=${len(v2)} v2cap=${cap(v2)}\n")

  // Non-zero `off`: the view starts at element 2, so the append lands at
  // buffer index 2 + 1 == 3 and overwrites c[3] — `w` itself still reads
  // length 1.
  let w = c[2:3]
  let w2 = append(w, 77)
  print("offset: c3=${c[3]} wlen=${len(w)} w2_1=${w2[1]} w2len=${len(w2)}\n")

  // The grow boundary. `g` is len 2 cap 2, so the append reallocates: `g2`
  // gets a brand-new buffer, `g` keeps its ORIGINAL one untouched — writing
  // through `g2` must not move what `g` reads.
  let g = []int(2, 2)
  g[0] = 1
  g[1] = 2
  let g2 = append(g, 3)
  g2[0] = 500
  print("grow:   g0=${g[0]} g2_0=${g2[0]} g2cap=${cap(g2)} glen=${len(g)}\n")
  // `g2` has room again (len 3, cap 4), so the next append does not grow —
  // and `g2` itself must still keep its OWN length (3), not `g3`'s (4).
  let g3 = append(g2, 4)
  print("regrow: g3len=${len(g3)} g3cap=${cap(g3)} g2len=${len(g2)}\n")

  // Byte slices take the packed stride-1 store, a different arm of the same
  // runtime path. Chained appends off `s`: `s` itself must stay empty the
  // whole way through, since it is never reassigned.
  let s = []byte(0, 4)
  let s2 = append(append(append(s, 65), 66), 67)
  print("bytes:  ${string(s2)} len=${len(s2)} cap=${cap(s2)} slen=${len(s)}\n")

  // A null header (a zeroed class field is the null word) allocates a FRESH
  // header nobody else can reach, so mutating it in place remains sound and
  // unchanged.
  let n: []int = []
  let n2 = append(n, 5)
  print("null:   nlen=${len(n)} n2len=${len(n2)} n2_0=${n2[0]}\n")

  // Reference elements: a []string keeps the word stride and the buffer must
  // stay traced, so the strings survive a collection triggered afterwards.
  // `junk` is properly reassigned every iteration, so it is unaffected.
  let r = []string(0, 2)
  let r2 = append(append(r, "alpha"), "beta")
  let junk = []int(0, 0)
  let k = 0
  while (k < 20000) {
    junk = append(junk, k)
    k = k + 1
  }
  print("refs:   ${r2[0]} ${r2[1]} junk=${len(junk)}\n")

  // Floats take the same word stride through an FP store.
  let f = []f64(0, 2)
  let f2 = append(append(f, 1.5), 2.25)
  print("floats: ${f2[0]} ${f2[1]}\n")
}
