// run
// #4039: `append(xs, v)` lowers to an inline fast path (store + length bump)
// when the header has spare capacity, and to `rt_call slice_append` only on the
// grow. This case pins every way that change could be observed.
//
// `append` ALIASES its argument's backing (spec/LINT.md E0214,
// runtime/root/slices.bit's `rtSliceAppend` header), and the aliasing is
// exactly what a faster `append` must not move: WHICH header comes back, WHICH
// buffer the element lands in, and WHEN a reallocation un-aliases the two. The
// fast path reproduces `rtSliceAppend`'s own `vlen == vcap` grow test as
// `len < cap`, so the reallocation boundary is bit for bit the runtime's.
//
// The expectations below were recorded from the OUT-OF-LINE lowering and must
// not move.
fn main() {
  // Same header back: both names see the new length (`rtSliceAppend` mutates in
  // place), and the element is visible through the original binding.
  let a = []int(0, 4)
  let b = append(a, 7)
  print("header: a=${len(a)} b=${len(b)} cap=${cap(a)} a0=${a[0]}\n")

  // Shared buffer through a reslice: `v` is a view onto `a`'s buffer with room
  // to spare, so appending through `v` writes into `a`'s slot 1.
  let c = []int(4, 8)
  c[0] = 10
  c[1] = 11
  c[2] = 12
  c[3] = 13
  let v = c[0:1]
  let v2 = append(v, 99)
  print("alias:  c1=${c[1]} v2len=${len(v2)} v2cap=${cap(v2)}\n")

  // Non-zero `off`: the view starts at element 2, so the append lands at
  // buffer index 2 + 1 == 3 and overwrites c[3].
  let w = c[2:3]
  let w2 = append(w, 77)
  print("offset: c3=${c[3]} w2_1=${w2[1]} w2len=${len(w2)}\n")

  // The grow boundary. `g` is len 2 cap 2, so the first append reallocates and
  // un-aliases; the second has room again and does not.
  let g = []int(2, 2)
  g[0] = 1
  g[1] = 2
  let g2 = append(g, 3)
  g2[0] = 500
  print("grow:   g0=${g[0]} g2_0=${g2[0]} g2cap=${cap(g2)} glen=${len(g)}\n")
  let g3 = append(g2, 4)
  print("regrow: g3len=${len(g3)} g3cap=${cap(g3)} g2len=${len(g2)}\n")

  // Byte slices take the packed stride-1 store, a different arm of the same
  // fast path.
  let s = []byte(0, 4)
  let s2 = append(append(append(s, 65), 66), 67)
  print("bytes:  ${string(s2)} len=${len(s2)} cap=${cap(s2)} slen=${len(s)}\n")

  // A null header (a zeroed class field is the null word) has cap 0, so the
  // fast path never fires and the runtime allocates, exactly as before.
  let n: []int = []
  let n2 = append(n, 5)
  print("null:   nlen=${len(n)} n2len=${len(n2)} n2_0=${n2[0]}\n")

  // Reference elements: a []string keeps the word stride and the buffer must
  // stay traced, so the strings survive a collection triggered afterwards.
  let r = []string(0, 2)
  let r2 = append(append(r, "alpha"), "beta")
  let junk = []int(0, 0)
  let k = 0
  while (k < 20000) {
    junk = append(junk, k)
    k = k + 1
  }
  print("refs:   ${r2[0]} ${r2[1]} junk=${len(junk)}\n")

  // Floats take the same word stride through an FP store.
  let f = []f64(0, 2)
  let f2 = append(append(f, 1.5), 2.25)
  print("floats: ${f2[0]} ${f2[1]}\n")
}
