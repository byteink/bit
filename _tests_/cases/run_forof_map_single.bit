// run
// #4334 (epic #4332's owner ruling: `of` yields the VALUE, `in` yields the
// POSITION): a single binder over a map binds the whole `(K, V)` pair, so
// `x.0` is the key and `x.1` the value. `for (k, v) of m` is the same value
// destructured positionally, and both must agree.
//
// Slot order is unspecified, so nothing here prints a raw iteration order:
// the single-entry map prints directly, and the four-entry map is summed
// (order-independent) and cross-checked against the pair binder.
fn main() {
  let one = map<string, int>{ "solo": 7 }
  for x of one {
    print("${x.0}=${x.1}\n")
  }

  let m = map<string, int>{ "a": 1, "b": 2, "c": 3, "d": 4 }
  let klen = 0
  let vsum = 0
  for x of m {
    klen = klen + len(x.0)
    vsum = vsum + x.1
  }
  print("single klen=${klen} vsum=${vsum}\n")

  let klen2 = 0
  let vsum2 = 0
  for (k, v) of m {
    klen2 = klen2 + len(k)
    vsum2 = vsum2 + v
  }
  print("pair klen=${klen2} vsum=${vsum2} agree=${klen == klen2 && vsum == vsum2}\n")

  // The pair is a real tuple value: it destructures with `let` and survives
  // being passed as one argument.
  let total = 0
  for e of m {
    let (k3, v3) = e
    total = total + len(k3) + v3
  }
  print("destructured total=${total}\n")

  // An int-keyed map takes the same shape (word-hashed keys, not ref keys).
  let n = map<int, int>{ 2: 20 }
  for p of n {
    print("int ${p.0}=${p.1}\n")
  }
}
