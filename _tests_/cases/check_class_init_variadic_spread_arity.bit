// error
// #4442: a `...`-spread construction call must still supply the fixed
// prefix before the spread — one fixed param plus the rest param, spread
// alone supplies zero fixed arguments.
class Foo {
  n: int
  init(prefix: string, ...args: string) { this.n = len(args) }
}
fn main() {
  let xs = ["a"]
  let a = Foo(...xs)
}
