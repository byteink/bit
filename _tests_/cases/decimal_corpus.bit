// run
// #3982: the 200-op reference corpus (comment 17/18's item (a)) -- the
// instrument that would have caught #5288 (decimal add/compare misreading a
// magnitude >= 2^95 as negative, fixed at f5de0276) at the commit that
// introduced it, rather than by hand afterward. Every value in
// `decimal_corpus.expected` was computed independently of this compiler: a
// one-off Python script (not checked in -- see the dispatch policy against
// adding scripts; a Gate{} runs THIS file instead) reimplements the
// sign-magnitude/96-bit-mantissa/scale-0..28 model from SPEC.md SS11.1/
// SS13.5 and the ticket's comment 10/13/14/16 write-ups using Python's
// arbitrary-precision ints and Fraction, NOT decimal.Decimal's own rounding
// and NOT this compiler's own output. Cross-checked against five
// already-landed, hand-verified values before being trusted for new ones:
// tieUp/2, tieDown/2, bigVal/one (run_decimal_words.bit) and
// big/big+1/big2-big (decimal_add_high_magnitude.bit, #5288's own
// regression fixture) -- all five reproduced byte-identical.
//
// Every operand is a named `let x: decimal = <literal>` (never a bare
// literal in the expression): an untyped float/int literal with no decimal
// operand nearby infers as `untyped float`/`untyped int`, not `decimal`,
// and `+`/`-`/`*`// on those is E0053 -- the same rule every landed decimal
// fixture already follows.
//
// COVERAGE, matching the ticket's "cases the corpus must contain": the
// 64-bit carry boundary in multiply and add (11-18 digit operands whose
// product/aligned-sum crosses 2^64), the scale cap at 28 (two scale-14
// operands multiplied), trimming (exact terminating divisions shed
// trailing digits, e.g. `100.00/99.99`, `10/4`-style pairs), operands at
// different scales throughout, `0.1 + 0.2` (exact in `decimal`; see
// run_decimal_words.bit for the already-gated `f64` contrast), and seven
// non-terminating divisions at varying scales. The SIGN-MAGNITUDE / 2^95
// section below is this ticket's specific dispatch ask: `+`/`-` on operands
// at 5e28-7e28, all >= 2^95 (39614081257132168796771975168) and < 2^96 --
// the exact magnitude range #5288's sign-bit misread affected, built via
// chained `*` on <=18-digit literals the same way the landed fixtures do
// (a literal itself cannot spell a 28-digit number, SS11.1).

fn printCorpusPairs1() {
  let a1: decimal = 19.99
  let b1: decimal = 2.1
  println("${a1 + b1}")
  println("${a1 - b1}")
  println("${a1 * b1}")
  println("${a1 / b1}")
  let a2: decimal = 100.00
  let b2: decimal = 99.99
  println("${a2 + b2}")
  println("${a2 - b2}")
  println("${a2 * b2}")
  println("${a2 / b2}")
  let a3: decimal = 1.05
  let b3: decimal = 2.1
  println("${a3 + b3}")
  println("${a3 - b3}")
  println("${a3 * b3}")
  println("${a3 / b3}")
  let a4: decimal = 0.1
  let b4: decimal = 0.2
  println("${a4 + b4}")
  println("${a4 - b4}")
  println("${a4 * b4}")
  println("${a4 / b4}")
  let a5: decimal = 0.1
  let b5: decimal = 0.3
  println("${a5 + b5}")
  println("${a5 - b5}")
  println("${a5 * b5}")
  println("${a5 / b5}")
  let a6: decimal = 1.5
  let b6: decimal = 3.5
  println("${a6 + b6}")
  println("${a6 - b6}")
  println("${a6 * b6}")
  println("${a6 / b6}")
  let a7: decimal = 2.5
  let b7: decimal = 2
  println("${a7 + b7}")
  println("${a7 - b7}")
  println("${a7 * b7}")
  println("${a7 / b7}")
  let a8: decimal = 3.5
  let b8: decimal = 2
  println("${a8 + b8}")
  println("${a8 - b8}")
  println("${a8 * b8}")
  println("${a8 / b8}")
}

