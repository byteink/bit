fn printSignMagnitudeRegression() {
  let one: decimal = 1
  let p9: decimal = 1000000000
  let p18 = p9 * p9
  let p27 = p18 * p9
  let five: decimal = 5
  let six: decimal = 6
  let seven: decimal = 7
  let ten: decimal = 10
  let fiveP28 = five * p27 * ten
  let sixP28 = six * p27 * ten
  let sevenP28 = seven * p27 * ten
  let bigVal2: decimal = 79228162513
  let bigVal2Full = bigVal2 * p18
  println("${fiveP28 + p27}")
  println("${fiveP28 - p27}")
  println("${sixP28 - fiveP28}")
  println("${sevenP28 + 1}")
  let negFiveP28 = -fiveP28
  println("${negFiveP28 + fiveP28}")
  println("${bigVal2Full + 1}")
  println("${bigVal2Full - 1}")
  println("${bigVal2Full / one}")
}

fn main() {
  printCorpusPairs1()
  printCorpusPairs2()
  printCorpusPairs3()
  printCorpusPairs4()
  printCorpusPairs5()
  printCorpusPairs6()
  printCorpusPairs7()
  printCorpusPairs8()
  printSignMagnitudeRegression()
}
