// run
// #7387: an interface method whose result is `Self` (SPEC §11.3). Called
// through a value of the interface the result is the interface; called
// through a type parameter bounded by it the result is that type parameter,
// which each instantiation maps to its own class. It used to pass the checker
// and then fail at lowering with E0092 on the first call made on the result.
interface Cloner {
  dup(): Self,
  tag(): string,
}

class A {
  v: i64,
  dup(): A { return A{ v = this.v + 1 } }
  tag(): string { return "A${this.v}" }
}

class B {
  s: string,
  dup(): B { return B{ s = this.s + "!" } }
  tag(): string { return this.s }
}

fn twice<T: Cloner>(x: T): T { return x.dup().dup() }

fn viaIface(c: Cloner): string {
  let d = c.dup()
  return d.tag() + " " + c.dup().dup().tag()
}

fn main() {
  println(twice(A{ v = 1 }).tag())
  println(twice(B{ s = "b" }).tag())
  println(viaIface(A{ v = 5 }))
  println(viaIface(B{ s = "x" }))
}
