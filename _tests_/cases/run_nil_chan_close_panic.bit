// panic
// #2505: `close(c)` on a nil channel must panic (SPEC §16.2, §18.4: "close on
// a nil ... channel") rather than silently doing nothing. The channel comes
// from `len(args())` so it cannot fold to a known-nil value at compile time --
// only a real runtime check can catch this. Nil SEND/RECV are unaffected
// (they block forever, SPEC §16.2, #2503) -- this case is close only.
import { args } from "std/os"

fn nilChan(): chan<int> {
  if (len(args()) - 1 == 0) {
    return nil
  }
  return chan<int>()
}

fn main() {
  let c = nilChan()
  print("start\n")
  close(c)
  print("unreachable\n")
}
