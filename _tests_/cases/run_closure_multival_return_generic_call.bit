// run
// #6045: a multi-value `return` inside a closure passed as a generic call's
// argument type-checked but failed to lower (E0092, "cannot lower a
// multi-value `return` whose function result is not a matching tuple"). The
// checker's `arrowExpected` seeding (checkarrow.bit) substituted the
// closure's expected result correctly for validating the `return`, but the
// LOWERER re-derives the closure's own result type from `nodeType`, which
// substitutes only the ENCLOSING function's `genEnv` — never the call's own
// instantiation — so an unwrapped `Fallible` (root cause: `lowerClosureBody`
// never called `unwrapFallible` on a closure's declared result, unlike every
// named function) or an unbound method type param (a method's OWN type
// params are never substituted by `methodSigLookup`'s automatic
// receiver-instantiation substitution) reached `lowerStmtReturnTuple` still
// wrapped or still unbound, and it correctly refused to emit.
//
// Three shapes, all through `call`'s explicit-type-argument path and its
// generic-method twin, plus the argument-inferred form:
//   1. An EXPLICIT type argument on a free generic function.
//   2. The SAME callee with R left to be INFERRED from a value argument.
//   3. A generic METHOD's own type parameter, bound by an explicit type
//      argument (methodOwnGenericCount != 0, receiver not itself generic).
fn callExplicit<R>(f: () => R!error): R!error {
  return f()?
}

fn callInferred<R>(seed: R, f: () => R!error): R!error {
  return f()?
}

class Runner {
  tag: int

  call<R>(f: () => R!error): R!error {
    return f()?
  }
}

fn main(): ()!error {
  let (a, b) = callExplicit<(int, int)>(() => {
    return 1, 2
  })?
  print("${a} ${b}\n")

  let (c, d) = callInferred((0, 0), () => {
    return 3, 4
  })?
  print("${c} ${d}\n")

  let r = Runner{ tag = 1 }
  let (e, f) = r.call<(int, int)>(() => {
    return 5, 6
  })?
  print("${e} ${f}\n")
}
