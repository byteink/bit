// run
// #4349: a compare against a small literal folds into `cmp Xn, #imm12` (or
// `cmn` for a negative one) instead of materializing the literal into a
// register first. The encoding is exact only inside a narrow window, and every
// edge of that window is here — a fold that silently used the wrong form, the
// wrong sign, or the wrong width would change one of these answers.
//
// The AArch64 window, both directions:
//   0..4095                   direct imm12
//   4096..16773120, multiple of 4096   imm12 shifted left by 12
//   anything else             must still materialize
// so 4095 is the largest small value that fits, 4097 the smallest that does
// not, 16773120 the largest shifted value that fits, and 16773121 does not.
//
// The negative side is the part with a real hazard in it: `cmp Xn, #-k` has no
// encoding, so it becomes `cmn Xn, #k` (ADDS). That sets NZCV identically to
// SUBS against the materialized two's complement, for UNSIGNED relational
// compares as well as signed ones, and that identity is what the u64 rows
// below check rather than assume. i64 MIN has no positive magnitude, so it is
// never folded at all.

fn small(x: i64) {
  print("small ${x}")
  print(" 0 ${x == 0} ${x != 0} ${x < 0} ${x <= 0} ${x > 0} ${x >= 0}")
  print(" 4095 ${x == 4095} ${x < 4095} ${x <= 4095} ${x > 4095} ${x >= 4095}")
  print(" 4096 ${x == 4096} ${x < 4096} ${x <= 4096} ${x > 4096} ${x >= 4096}")
  print(" 4097 ${x == 4097} ${x < 4097} ${x <= 4097} ${x > 4097} ${x >= 4097}\n")
}

fn negative(x: i64) {
  print("neg ${x}")
  print(" -1 ${x == -1} ${x != -1} ${x < -1} ${x <= -1} ${x > -1} ${x >= -1}")
  print(" -4095 ${x == -4095} ${x < -4095} ${x >= -4095}")
  print(" -4096 ${x == -4096} ${x < -4096} ${x >= -4096}")
  print(" -4097 ${x == -4097} ${x < -4097} ${x >= -4097}\n")
}

fn shifted(x: i64) {
  print("shift ${x}")
  print(" 8192 ${x == 8192} ${x < 8192} ${x >= 8192}")
  print(" 16773120 ${x == 16773120} ${x < 16773120} ${x >= 16773120}")
  print(" 16773121 ${x == 16773121} ${x < 16773121} ${x >= 16773121}")
  print(" -16773120 ${x == -16773120} ${x < -16773120} ${x >= -16773120}\n")
}

fn extreme(x: i64) {
  print("ext ${x}")
  print(" max ${x == 9223372036854775807} ${x < 9223372036854775807} ${x >= 9223372036854775807}")
  print(" min ${x == -9223372036854775808} ${x > -9223372036854775808} ${x <= -9223372036854775808}\n")
}

// The literal on the LEFT. Only a right-hand constant folds, so these must keep
// producing the same answers through the unchanged register path.
fn leftLiteral(x: i64) {
  print("left ${x} ${4095 == x} ${4095 < x} ${4095 <= x} ${-1 > x} ${-1 >= x}\n")
}

fn unsignedWide(x: u64) {
  print("u64 ${x}")
  print(" ${x == 0} ${x != 0} ${x < 4095} ${x <= 4095} ${x > 4095} ${x >= 4095}")
  print(" ${x < 4096} ${x < 4097} ${x < 16773120} ${x >= 16773121}\n")
}

fn narrow(a: u8, b: i8, c: u32, d: i32) {
  print("narrow ${a} ${a == 255} ${a < 128} ${a >= 1}")
  print(" ${b} ${b == -1} ${b < -100} ${b >= 127}")
  print(" ${c} ${c == 4095} ${c < 4096} ${c >= 4097}")
  print(" ${d} ${d == -4096} ${d < -1} ${d >= 4095}\n")
}

fn runSigned() {
  small(-1)
  small(0)
  small(1)
  small(4095)
  small(4096)
  small(4097)
  negative(-4097)
  negative(-4096)
  negative(-4095)
  negative(-1)
  negative(0)
  shifted(8191)
  shifted(8192)
  shifted(16773120)
  shifted(16773121)
  shifted(-16773120)
}

fn runEdges() {
  extreme(9223372036854775807)
  extreme(-9223372036854775808)
  extreme(0)
  leftLiteral(4094)
  leftLiteral(4095)
  leftLiteral(4096)
  leftLiteral(-1)
  leftLiteral(-2)
}

fn runUnsigned() {
  unsignedWide(u64(0))
  unsignedWide(u64(4095))
  unsignedWide(u64(4096))
  unsignedWide(u64(16773121))
  unsignedWide(u64(18446744073709551615))
  narrow(u8(255), i8(-1), u32(4095), i32(-4096))
  narrow(u8(0), i8(127), u32(4097), i32(4095))
}

fn main() {
  runSigned()
  runEdges()
  runUnsigned()
}
