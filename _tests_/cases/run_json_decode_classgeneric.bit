// run
// #6259: `jsonDecode<T>` where `T` is the enclosing generic CLASS's own type
// parameter, extending #4563's per-instantiation retarget (which only ever
// covered a generic FUNCTION's or METHOD's own `T`) to a class's own `T`.
// Before this it was E0145 at check time — `classjsondecodecall.bit`'s
// pre-check rewrite resolves the type argument BY NAME, and a type parameter
// is not a name, so every receiver-contributed one was refused outright.
//
// DIRECT: `Box<T>.load` calls `jsonDecode<T>` with `T` the class's own
// parameter, written out at the composite literal `Box<Dog>{}` that
// instantiates it.
//
// THROUGH A FACTORY, no `jsonDecode` call in sight at the outer site: `make<T>`
// declares `T` as ITS OWN parameter and returns `Box<T>`, the exact shape
// `pkg/kv`'s `Db.collection<T>(...): Collection<T>` uses (collection.bit's own
// header) — an explicit `make<Cat>()` call must demand `Cat`'s decoder even
// though nothing inside `make` itself mentions `jsonDecode`.
//
// TWO CLASSES, so a wrapper that ignored its type argument and always
// returned the same decoded value would fail.
import { jsonParse, jsonDecode } from "std/json"

@json class Dog {
  name: string,
  age: i32,
}

@json class Cat {
  name: string,
  lives: i32,
}

class Box<T> {
  load(s: string): T! {
    return jsonDecode<T>(jsonParse(s)?)?
  }
}

fn make<T>(): Box<T> {
  return Box<T>{}
}

fn main() {
  let dogBox = Box<Dog>{}
  let d = dogBox.load("{\"name\":\"fido\",\"age\":3}") catch e {
    print("dog: ${e.message()}\n")
    return
  }
  print("dog name=${d.name} age=${d.age}\n")

  let catBox = make<Cat>()
  let c = catBox.load("{\"name\":\"tom\",\"lives\":9}") catch e {
    print("cat: ${e.message()}\n")
    return
  }
  print("cat name=${c.name} lives=${c.lives}\n")
}
