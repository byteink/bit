// run
// stdlib/json/encode.bit's jsonEncode on a large flat array (#2173): the
// original `encodeArray`/`encodeObject` did `out = out + encodeValue(...)`
// per element, copying the entire accumulated output on every element and
// making the encoder quadratic in element count. The fix threads a single
// `[]byte` buffer through the recursion instead (`append` grows a slice's
// backing buffer in place, amortized, unlike `string + string`).
//
// A golden case is single-file with no prelude and cannot import std/json
// (see json_encode_compact.bit / json_parse_valid.bit), so this redeclares
// the value type and the NEW (buffer-threaded) encoder locally, mirroring
// stdlib/json/encode.bit as fixed. It cannot exercise the actual TIME
// complexity here — golden cases have no timing primitive available (no
// std/time import; see this file's own header convention) and must produce
// a fixed, deterministic `.expected`, so a wall-clock assertion does not
// belong in this corpus. What it pins instead is the one thing that IS
// deterministic and does catch a quadratic-reintroducing regression at the
// output-correctness level: the exact byte length of a 100,000-element
// array's encoding (any element that got dropped, duplicated, or
// mis-separated would change this number), plus the exact text of a small
// array for a byte-level sanity check. The actual before/after timing
// (34.8ms -> 1.8ms at 2,000 elements; 3,391.6ms -> 20.8ms at 16,000; a
// 100,000-element array well under 1s, where the old code would take
// roughly 2 minutes) is recorded on #2173 itself, measured out-of-band with
// std/time against the real stdlib/json module, not this reimplementation.

class JsonEntry { key: string, value: Json }

enum Json {
  JsonNull
  JsonBool(bool)
  JsonInt(i64)
  JsonFloat(f64)
  JsonString(string)
  JsonArray([]Json)
  JsonObject([]JsonEntry)
}

fn appendStr(out: []byte, s: string): []byte {
  let i = 0
  let n = len(s)
  while (i < n) {
    out = append(out, s[i])
    i = i + 1
  }
  return out
}

fn encodeBool(b: bool): string {
  if (b) {
    return "true"
  }
  return "false"
}

fn encodeValue(j: Json, out: []byte): []byte {
  match (j) {
    JsonNull => return appendStr(out, "null")
    JsonBool(b) => return appendStr(out, encodeBool(b))
    JsonInt(i) => return appendStr(out, "${i}")
    JsonFloat(f) => return appendStr(out, "${f}")
    JsonString(s) => return appendStr(out, s)
    JsonArray(a) => return encodeArray(a, out)
    JsonObject(o) => return encodeObject(o, out)
  }
}

fn encodeArray(a: []Json, out: []byte): []byte {
  out = append(out, '[')
  let i = 0
  while (i < len(a)) {
    if (i > 0) {
      out = append(out, ',')
    }
    out = encodeValue(a[i], out)
    i = i + 1
  }
  return append(out, ']')
}

fn encodeObject(o: []JsonEntry, out: []byte): []byte {
  out = append(out, '{')
  let i = 0
  while (i < len(o)) {
    if (i > 0) {
      out = append(out, ',')
    }
    out = appendStr(out, o[i].key)
    out = append(out, ':')
    out = encodeValue(o[i].value, out)
    i = i + 1
  }
  return append(out, '}')
}

fn jsonEncode(j: Json): string {
  let out = []byte(0)
  out = encodeValue(j, out)
  return string(out)
}

fn buildIntArray(n: int): Json {
  let items = []Json(0)
  let i = 0
  while (i < n) {
    items = append(items, Json.JsonInt(i))
    i = i + 1
  }
  return Json.JsonArray(items)
}

fn main() {
  // Small array: exact text, byte for byte.
  let small = jsonEncode(buildIntArray(5))
  print("small=${small}\n")

  // Large array: element count that would take ~2 minutes under the old
  // quadratic accumulation. Only the length is deterministic to pin here
  // (the full text is 588,891 bytes); a length change means an element was
  // dropped, duplicated, or a separator went missing.
  let large = jsonEncode(buildIntArray(100000))
  print("large_len=${len(large)}\n")
  print("large_prefix=${large[0:20]}\n")
  print("large_suffix=${large[len(large) - 20:len(large)]}\n")
}
