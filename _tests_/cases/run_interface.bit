// run
// Structural interface dispatch: an interface-typed value holds a concrete
// object; the method call resolves through the object's TypeInfo method table
// (ABI.md §2.1) at runtime. Two types share the method name `kind`.
interface Animal { legs(): i64 }
class Dog {
  legs(): i64 { return 4 }
}
class Bird {
  legs(): i64 { return 2 }
}
fn count(a: Animal): i64 {
  return a.legs()
}
fn main() {
  let d = Dog{}
  let b = Bird{}
  print("dog=${count(d)} bird=${count(b)} sum=${count(d) + count(b)}\n")
}
