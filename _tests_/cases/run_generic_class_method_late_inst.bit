// run
// #4662: a generic class's method, on an instantiation that nothing outside a
// generic body ever names.
//
// `checkModule` copies a generic's method set onto its instantiations with one
// SWEEP (`copyMethodsToInsts`, checkinst.bit) over the instantiations that
// exist at that moment. An instantiation minted after it -- by a substitution
// in the main sweep, or by `validateInstantiations` once every module is
// checked -- was reached by no sweep at all and kept an EMPTY method set for
// the whole compile, which three readers then answered from as if the type had
// no such member:
//
//   - E0057 on a receiver typed by a generic call's substituted result
//     (`vMember`),
//   - E0057 on a receiver inside a generic body (`vInstMember`),
//   - E0041 interface satisfaction.
//
// Writing `Holder<i64>` ANYWHERE outside a generic body minted the same type
// early enough for the sweep and made every one of these compile, which is
// what made it a pass-order bug rather than a lookup bug.
//
// Fields are not part of it: `fillInstMembers` fills those at mint time, so
// `h.slot` always resolved. `slotOf` below is the control -- it passes on the
// broken compiler too, so a failure here is the method half only.
class Holder<U> {
  slot: U
  export plain(): int { return 7 }
  export same(v: U): U { return v }
}

// The reported shape: the instantiation is minted by substituting `U = i64`
// during `validateInstantiations`, long after the sweep.
fn viaGen<U>(u: U): int {
  let h = Holder<U>{ slot: u }
  return h.plain()
}

// A method whose signature mentions the class's own type parameter, so the
// copied signature has to be the SUBSTITUTED one and not the template's.
fn viaGenSame<U>(u: U): U {
  let h = Holder<U>{ slot: u }
  return h.same(u)
}

// The control: a field on the same late-minted instantiation.
fn slotOf<U>(u: U): U {
  let h = Holder<U>{ slot: u }
  return h.slot
}

// No generic body at the call at all: `h` is typed by `mk`'s substituted
// result, which mints `Holder<i64>` during the main sweep -- also after the
// sweep, and also E0057 before this.
fn mk<T>(v: T): Holder<T> {
  return Holder<T>{ slot: v }
}

fn main() {
  print("${viaGen(2)}\n")
  print("${viaGenSame(3)}\n")
  print("${slotOf(4)}\n")
  let h = mk(5)
  print("${h.plain()} ${h.same(6)} ${h.slot}\n")
  let s = mk("x")
  print("${s.same("y")} ${s.slot}\n")
}
