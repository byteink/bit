// run
// #3862: binding an indexed element to a name (`let n = xs[i]`) disqualifies
// its element type from the inline representation for the WHOLE module — an
// inline element has no independent heap reference to hand `n` — so `Node`
// stays boxed (stride 8) here. This proves the boxed bail-out is actually
// taken (not merely that the program still runs): `n` aliases `xs[0]`, so
// writing through `n` must be observed through `batch[0]` too, which is
// impossible under the packed representation and would silently print a
// stale value if the bail-out did not fire.
class Node { x: i64, y: i64 }

fn main() {
  let batch = [Node{ x: 1, y: 2 }, Node{ x: 3, y: 4 }]
  let n = batch[0]
  n.x = 999
  print("${batch[0].x} ${batch[0].y} ${batch[1].x} ${batch[1].y}\n")
}
