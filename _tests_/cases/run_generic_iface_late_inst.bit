// run
// #6248: `Sq<bool>` is minted into `typeInsts` only while `make<bool>`'s
// body is lowered (Pass A2), after Pass A3' (`collectMethodEntries`) already
// walked a shorter prefix of it. Before the fix, neither `area`'s body nor
// its MethodTable slot existed, and dispatching through the interface
// segfaulted.
interface Shape {
  area(): int
}

class Sq<T> {
  side: int
  tag: T
  area(): int {
    return this.side * this.side
  }
}

fn make<U>(x: U): Shape {
  return Sq<U>{ side = 3, tag = x }
}

fn main() {
  let s = make<bool>(true)
  print("${s.area()}\n")
}
