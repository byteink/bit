// run
// #3404: the silent-miscompile shape, and the one that actually mattered.
// `bit check` passed cleanly and `bit run` exited 0 BOTH before and after the
// fix, so exit code alone cannot tell this apart — before the fix stdout was
// EMPTY. `Result.A` was constructing the PRELUDE Result<T,E> enum's boxed
// payload record (the local `enum Result` never got a TypeId), so `r ==
// Result.A` compared two freshly boxed references and evaluated false with
// no diagnostic anywhere. Assert on the printed byte, not just the exit code.
enum Result { A, B }
fn main() {
  let r = Result.A
  if (r == Result.A) { print("A\n") }
}
