// ir
// #6435: a loop over a string literal. A literal is the address of its static
// `__bitstr_N` header, so three things fold that used to reach the backend:
//
//   `escapeLetter`  `len(bytes)` is the constant 11 (`markConstStringLens`,
//                   compiler/optparams.bit), so no `slice_len` survives. The
//                   header test then bounds `i` by 11, and `letters` is 11
//                   bytes long too, so `letters[i]` keeps no `icmp_ult` and
//                   no panic block (`bceLimitCovers`, compiler/optbce.bit).
//                   The loop's `field_get [0]` of `bytes` is hoisted into
//                   bb0 off the literal itself (#6454, `licmReadsLiteralPtr`,
//                   compiler/optloopcand.bit) and threaded round the loop.
//                   `letters` is read after the loop exits, off a
//                   `const_string` emitted in its own block
//                   (`emitStaticHeaderRead`, compiler/optrebuild.bit). Both
//                   bases are literals, so the backend drops both null guards
//                   (`headerMayBeNull`, codegen.bit).
//   `twoLiterals`   `s` holds one of TWO literals, so it is not a constant:
//                   its `slice_len` and its `field_get` stay on the param.
//   `shortIndex`    the loop is bounded by a 6-byte literal and indexes a
//                   3-byte one. `i < 6` does not imply `i < 3`, so the check
//                   and its panic block MUST stay; the `field_get [0]` of the
//                   literal is hoisted all the same.
//   `heapBytes`     `s` is a HEAP string, whose `ptr` is an interior
//                   pointer, so its `field_get [0]` MUST stay in the loop.
//                   Built at run time because a `string` PARAMETER arrives
//                   as its words already and reads no header at all.
//
// _tests_/cases/run_const_string_loop_panic.bit runs the first three.

fn escapeLetter(c: u8): u8 {
  let bytes = "\x00\x07\x08\t\n\x0b\x0c\r\x1b\"\\"
  let letters = "0abtnvfre\"\\"
  let i = 0
  while (i < len(bytes)) {
    if (bytes[i] == c) {
      return letters[i]
    }
    i = i + 1
  }
  return 0
}

fn twoLiterals(flag: bool): int {
  let s = "abc"
  if (flag) {
    s = "defgh"
  }
  let n = 0
  let i = 0
  while (i < len(s)) {
    n = n + int(s[i])
    i = i + 1
  }
  return n
}

fn shortIndex(): int {
  let long = "abcdef"
  let short = "abc"
  let n = 0
  let i = 0
  while (i < len(long)) {
    n = n + int(short[i])
    i = i + 1
  }
  return n
}

fn heapBytes(k: int): int {
  let s = "${k}"
  let n = 0
  let i = 0
  while (i < len(s)) {
    n = n + int(s[i])
    i = i + 1
  }
  return n
}
