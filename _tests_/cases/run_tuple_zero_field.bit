// run
// A tuple's §13.4 zero value is a live, zeroed record, at every site that has
// to materialize one (#4500) — not just the initializer-less binding #4414
// fixed. `run_tuple_zero_binding.bit` covers the binding and names this file
// as the one that covers the other three.
//
// Three separate predicates each kept their own list of "which kinds have a
// zero value that is a live object", and none of the three named Tuple, so on
// `main` at 09006cc7 each of the four forms below segfaulted at exit 2 while
// the class and array forms beside them printed 0:
//
//   omittedFieldValue        lowerslicefill.bit  ->  `let c: C` and `C{}`
//   zeroIsObject             lowermapaccess.bit  ->  a miss on a tuple-valued map
//   sliceAllocElemNeedsFill  lowerlit.bit        ->  `[]( (int,int) )(n)`
//
// They are now one predicate, `zeroIsLiveRecord` (lowerslicefill.bit), which
// all three sites call — so a fourth site cannot answer this differently.
//
// The §10.5 DEFAULT path above this one is not exercisable here: a tuple
// literal is not a compile-time constant expression, so `t: (i64, i64) =
// (1, 2)` is E0064 and no tuple-typed field can carry a default at all.
//
// Each form is exercised past the first member too: a nested tuple member, a
// class member and a boxed-enum member all have zero values that are
// themselves live objects, so they prove the fill recurses rather than
// stopping one level down with a null inside a real tuple.

class P {
  a: i64,
  b: string,
}

enum E {
  A,
  B(i64),
}

class C {
  n: i64,
  t: (i64, i64),
  deep: ((i64, i64), P, E),
}

fn showE(e: E): string {
  match (e) {
    A => { return "A" }
    B(x) => { return "B ${x}" }
  }
}

fn showDeep(d: ((i64, i64), P, E)): string {
  return "${d.0.0} ${d.0.1} ${d.1.a} [${d.1.b}] ${showE(d.2)}"
}

// `omittedFieldValue`: the zero-value construction of a class and its literal
// are one fill since #4469, so both forms go through the same arm.
fn fieldForms() {
  let c: C
  print("field ${c.t.0} ${c.t.1}\n")
  print("field-deep ${showDeep(c.deep)}\n")

  let lit = C{}
  print("lit ${lit.t.0} ${lit.t.1}\n")
  print("lit-deep ${showDeep(lit.deep)}\n")

  // A literal that names a DIFFERENT field still has to fill this one.
  let part = C{n: 7}
  print("lit-partial ${part.n} ${part.t.0} ${part.t.1}\n")
}

// `zeroIsObject`: a miss must hand back the zero record, not `map_get`'s raw
// null word. Both probe forms, since only the non-comma-ok one panics for a
// type with no zero value and a tuple HAS one.
fn mapForms() {
  let m = map<i64, (i64, i64)>()
  let miss = m[1]
  print("map-miss ${miss.0} ${miss.1}\n")

  let (v, ok) = m[2]
  print("map-commaok ${v.0} ${v.1} ${ok}\n")

  // A hit is unaffected: the miss edge is a separate block.
  m[3] = (8, 9)
  let hit = m[3]
  print("map-hit ${hit.0} ${hit.1} ${len(m)}\n")

  let dm = map<i64, ((i64, i64), P, E)>()
  print("map-deep ${showDeep(dm[4])}\n")
}

// `sliceAllocElemNeedsFill`: `slice_new`'s zeroed buffer is a null REFERENCE
// for a tuple element, so every index needs the explicit fill.
fn sliceForms() {
  let xs = []( (i64, i64) )(2)
  print("slice ${len(xs)} ${xs[0].0} ${xs[0].1} ${xs[1].0} ${xs[1].1}\n")

  // Overwriting and reading back proves the fill left usable slots rather
  // than something only readable once.
  xs[1] = (5, 6)
  print("slice-set ${xs[0].0} ${xs[1].0} ${xs[1].1}\n")

  // n = 0: the fill loop must run zero times, not fault.
  let empty = []( (i64, i64) )(0)
  print("slice-empty ${len(empty)}\n")

  // A length from a variable, so the count is not a compile-time constant.
  let n = 3
  let ys = []( (i64, i64) )(n)
  print("slice-var ${len(ys)} ${ys[2].0} ${ys[2].1}\n")

  let ds = []( ((i64, i64), P, E) )(2)
  print("slice-deep ${showDeep(ds[1])}\n")

  // A collection between the fill and the read: a member that is itself an
  // object must be reachable from the element, not a stale nursery address.
  let junk = []i64(0)
  let k = 0
  while (k < 4000) {
    junk = append(junk, k)
    k = k + 1
  }
  print("slice-live ${showDeep(ds[0])} ${len(junk)}\n")
}

fn main() {
  fieldForms()
  mapForms()
  sliceForms()
}
