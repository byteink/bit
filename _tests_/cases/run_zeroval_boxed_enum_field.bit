// run
// SPEC §13.4, #4469: a class's BOXED-ENUM field carries a live `{tag:0}` object
// as its zero value, not zero bits, so every construction form has to
// materialize it. `GcAlloc` alone hands back a NULL reference and the first tag
// read segfaults with no diagnostic.
//
// #4182 wired the fill into the composite literal only, so `Holder{}` printed
// `A` while `[]Holder(1)[0]`, `let p: Holder` and `Holder(...)`'s init object
// all crashed -- same type, same field, same zero value, four construction
// paths, one of them filled. The literal form stays in here as the CONTROL: it
// was always correct, and a fixture without it cannot tell "the fill reached
// every site" from "the fill was deleted and nothing needs it".
//
// A field whose zero value IS zero bits (`n`) is here for the same reason --
// filling every field indiscriminately would be a different bug with the same
// green result on the enum ones.
enum E {
  A,
  B(int),
}

class Holder {
  e: E
  n: int
  init(n: int) { this.n = n }
}

// Both fills firing on ONE construction (#3838 + #4469): `limit` is a default,
// `mode` a boxed enum. They are disjoint by construction -- a default must fold
// to a compile-time constant (§15.4) and no enum value folds -- and this is the
// case that proves neither loop swallowed the other when they were merged.
class Cfg {
  mode: E,
  limit: int = 4096,
  name: string = "cfg",
}

// A generic class reaches the same fill through `structTySubst`, so the field
// type it materializes comes off the INSTANTIATION rather than the declaration.
class Box<T> {
  v: T,
  e: E,
}

fn showE(e: E): string {
  match (e) {
    A => {
      return "A"
    }
    B(x) => {
      return "B ${x}"
    }
  }
}

fn main() {
  // Form 1, the CONTROL: the composite literal, correct since #4182.
  let lit = Holder{ n: 1 }
  print("lit ${showE(lit.e)} ${lit.n}\n")
  // Naming the field explicitly must still win over the fill.
  let named = Holder{ e: E.B(7), n: 2 }
  print("named ${showE(named.e)} ${named.n}\n")
  // Form 2: `[]T(n)` -- n zero values (§12.9), via `fillZeroElems` ->
  // `zeroValue`'s struct arm. Two elements, because the fill runs in an IR loop
  // and a fill that ran once left elements 1..n-1 null (#1925).
  let xs = []Holder(2)
  print("slice0 ${showE(xs[0].e)} ${xs[0].n}\n")
  print("slice1 ${showE(xs[1].e)} ${xs[1].n}\n")
  // Form 3: a bare binding with no initializer.
  let p: Holder
  print("let ${showE(p.e)} ${p.n}\n")
  // Form 4: the object an `init` starts from (§10.4). `init` never assigns
  // `e`, so what it leaves behind is exactly the zero value.
  let h = Holder(3)
  print("init ${showE(h.e)} ${h.n}\n")
  // Form 5: a map miss returns the value type's zero value, and for a class
  // that is the same struct arm again.
  let m = map<string, Holder>{}
  let miss = m["absent"]
  print("miss ${showE(miss.e)} ${miss.n}\n")
  // Both fills, one object, via the literal and via `[]T(n)`.
  let c = Cfg{}
  print("cfg ${showE(c.mode)} ${c.limit} ${c.name}\n")
  let cs = []Cfg(1)
  print("cfgs ${showE(cs[0].mode)} ${cs[0].limit} ${cs[0].name}\n")
  // The generic instantiation, literal and `[]T(n)`.
  let b = Box<int>{ v: 5 }
  print("box ${b.v} ${showE(b.e)}\n")
  let bs = []Box<string>(1)
  print("boxs '${bs[0].v}' ${showE(bs[0].e)}\n")
}
