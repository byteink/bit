// run
// #6566/#6597: a `return` operand and a `let x: Option<T> = v` initializer take
// a bare `T` where `Option<T>` is expected (SPEC §14.2 implicit `Some`), for a
// scalar, a string, `decimal`, a class reference, a bare-tag enum, a
// payload-carrying enum and a tuple, and through a generic function whose result
// is `Option<T>`. `None` and an explicit `Some` are unchanged. `bump()` counts
// its calls: the lifted value is evaluated exactly once.
enum Color { Red, Green, Blue }
enum Shape { Dot, Circle(int) }
class Pt { x: int, y: int }

let calls = 0

fn shapeText(s: Shape): string {
  match (s) {
    Circle(r) => { return "Circle ${r}" }
    Dot => { return "Dot" }
  }
  return "?"
}

fn bump(): int {
  calls = calls + 1
  return calls * 10
}

fn retInt(): Option<int> {
  return 42
}

fn retStr(): Option<string> {
  return "text"
}

fn retDec(): Option<decimal> {
  let d: decimal = 3.75
  return d
}

fn retPt(): Option<Pt> {
  return Pt{ x = 6, y = 7 }
}

fn retColor(): Option<Color> {
  return Color.Green
}

fn retShape(): Option<Shape> {
  return Shape.Circle(4)
}

fn retTuple(): Option<(int, string)> {
  return (8, "eight")
}

fn retOnce(): Option<int> {
  return bump()
}

fn retBranch(flag: bool): Option<int> {
  if (flag) {
    return 1
  }
  if (!flag) {
    return Option.None
  }
  return Option.Some(3)
}

fn retGeneric<T>(v: T): Option<T> {
  return v
}

fn main() {
  match (retInt()) {
    Some(v) => println("int=${v}")
    None => println("int none")
  }
  match (retStr()) {
    Some(v) => println("str=${v}")
    None => println("str none")
  }
  match (retDec()) {
    Some(v) => println("dec=${v}")
    None => println("dec none")
  }
  match (retPt()) {
    Some(v) => println("pt=${v.x},${v.y}")
    None => println("pt none")
  }
  match (retColor()) {
    Some(v) => println("color is Green: ${v == Color.Green}")
    None => println("color none")
  }
  match (retShape()) {
    Some(v) => println("shape=${shapeText(v)}")
    None => println("shape none")
  }
  match (retTuple()) {
    Some(v) => println("tuple=${v.0},${v.1}")
    None => println("tuple none")
  }
  match (retOnce()) {
    Some(v) => println("once=${v} calls=${calls}")
    None => println("once none")
  }
  match (retBranch(true)) {
    Some(v) => println("branch true=${v}")
    None => println("branch true none")
  }
  match (retBranch(false)) {
    Some(v) => println("branch false=${v}")
    None => println("branch false none")
  }
  match (retGeneric<int>(11)) {
    Some(v) => println("generic int=${v}")
    None => println("generic int none")
  }
  match (retGeneric<string>("g")) {
    Some(v) => println("generic string=${v}")
    None => println("generic string none")
  }

  let a: Option<int> = 5
  let b: Option<string> = "bound"
  let d: decimal = 9.5
  let c: Option<decimal> = d
  let e: Option<Pt> = Pt{ x = 1, y = 9 }
  let f: Option<(int, string)> = (2, "two")
  let g: Option<int> = bump()
  let h: Option<int> = Option.None
  match (a) {
    Some(v) => println("let int=${v}")
    None => println("let int none")
  }
  match (b) {
    Some(v) => println("let str=${v}")
    None => println("let str none")
  }
  match (c) {
    Some(v) => println("let dec=${v}")
    None => println("let dec none")
  }
  match (e) {
    Some(v) => println("let pt=${v.x},${v.y}")
    None => println("let pt none")
  }
  match (f) {
    Some(v) => println("let tuple=${v.0},${v.1}")
    None => println("let tuple none")
  }
  match (g) {
    Some(v) => println("let once=${v} calls=${calls}")
    None => println("let once none")
  }
  match (h) {
    Some(v) => println("let none=${v}")
    None => println("let none is None")
  }
}
