// run
// #4410: a two-word aggregate LOCAL is held as two words, not as a box.
//
// #4404 explodes what ARRIVES in words. A local of the same shape stayed boxed,
// and that cost real instructions whenever it outlived the block it was built
// in: threaded through a loop header as a block parameter, its `field_set`s sat
// outside the loop and the call site's `field_get`s inside it, so every
// iteration reloaded both words and the box itself stayed live as a traced root.
//
// Every line here is a use of such a local that must still produce the same
// answer it did when it was one handle. This file's `.expected` was generated by
// the compiler BEFORE the change, so it is an oracle and not a restatement.
//
//   hoisted     declared outside a loop, passed to an exploded call inside it —
//               the shape the change exists for
//   mutated     assigned inside the loop; the rebind must reach BOTH words, or
//               a later iteration reads the pre-assignment value
//   traced      one word is a GC reference; it must stay a live root across the
//               allocations the loop body performs
//   whole       used as one value (a slice element), which forces the box back
//   fromCall    initialized from a function that returns the aggregate
//   destruct    `let (a, b) = w` binds the words positionally
//   captured    read by an arrow function, which packs one word — so the
//               aggregate is materialized for the capture
//   capAssign   captured AND assigned (§12.8): must stay in a heap cell, since
//               a cell holds one word. Both sides must see the write
//   shadowed    an inner binding of the same name in the loop body, dropped at
//               the end of each iteration
//   nested      a tuple whose members are themselves references
//   viaMethod   passed to a METHOD, which never explodes its parameters, so the
//               local has to become a handle again at the call

fn take(w: (int, int), k: int): int {
  return w.0 * 3 + w.1 + k
}

fn hoisted(n: int, a: int, b: int): int {
  let w = (a, b)
  let acc = 0
  let i = 0
  while (i < n) {
    acc = acc + take(w, i)
    i = i + 1
  }
  return acc
}

fn mutated(n: int): int {
  let w = (1, 2)
  let acc = 0
  let i = 0
  while (i < n) {
    acc = acc + w.0 + w.1
    w = (w.1, w.0 + w.1)
    i = i + 1
  }
  return acc
}

fn traced(n: int, s: string): string {
  let w = (n, s)
  let out = ""
  let i = 0
  while (i < 3) {
    out = out + "[" + "${w.0 + i}" + w.1 + "]"
    i = i + 1
  }
  return out
}

fn whole(a: int, b: int): int {
  let w = (a, b)
  let xs = [w, w]
  return xs[0].0 + xs[1].1 + take(w, 0)
}

fn mkPair(x: int): (int, int) {
  return (x, x * 2)
}

fn fromCall(x: int, n: int): int {
  let w = mkPair(x)
  let acc = 0
  let i = 0
  while (i < n) {
    acc = acc + take(w, i)
    i = i + 1
  }
  return acc
}

fn destruct(x: int): int {
  let w = mkPair(x)
  let (a, b) = w
  return a * 100 + b
}

fn captured(a: int, b: int): int {
  let w = (a, b)
  let f = () => w.0 * 10 + w.1
  return f() + take(w, 1)
}

fn capAssign(a: int, b: int): int {
  let w = (a, b)
  let bump = () => {
    w = (w.0 + 1, w.1 + 1)
  }
  bump()
  bump()
  return w.0 * 10 + w.1
}

fn shadowed(n: int): int {
  let w = (1, 2)
  let acc = 0
  let i = 0
  while (i < n) {
    let w = (i, i + 1)
    acc = acc + w.0 * 10 + w.1
    i = i + 1
  }
  return acc + w.0 + w.1
}

fn nested(a: int, b: int): int {
  let inner = (a, b)
  let w = (inner, "n")
  return w.0.0 * 7 + w.0.1 + len(w.1)
}

class Box {
  base: int

  blend(w: (int, int)): int {
    return this.base + w.0 * 5 + w.1
  }
}

fn viaMethod(a: int, b: int): int {
  let w = (a, b)
  let bx = Box{ base: 100 }
  let acc = 0
  let i = 0
  while (i < 2) {
    acc = acc + bx.blend(w)
    i = i + 1
  }
  return acc
}

fn deferred(a: int, b: int) {
  let w = (a, b)
  defer showPair(w)
  print("deferred before\n")
}

fn showPair(w: (int, int)) {
  print("deferred ${w.0} ${w.1}\n")
}

fn main() {
  print("hoisted ${hoisted(3, 7, 11)}\n")
  print("mutated ${mutated(5)}\n")
  print("traced ${traced(4, "s")}\n")
  print("whole ${whole(7, 11)}\n")
  print("fromCall ${fromCall(5, 3)}\n")
  print("destruct ${destruct(6)}\n")
  print("captured ${captured(7, 11)}\n")
  print("capAssign ${capAssign(7, 11)}\n")
  print("shadowed ${shadowed(4)}\n")
  print("nested ${nested(3, 4)}\n")
  print("viaMethod ${viaMethod(7, 11)}\n")
  deferred(7, 11)
}
