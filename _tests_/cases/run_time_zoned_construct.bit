// run
// #4075: `DateTime` -- construction via `NaiveDateTime.inZone`, field
// forwarding, `withZone` (same instant, a different zone's view of it),
// `toTimestamp` (drops the zone) and the round trip back through
// `Timestamp.inZone`. 2026-09-01T09:00:00 in Asia/Dubai (permanently
// +04:00, docs/stdlib/time.md, "Zones") is 2026-09-01T05:00:00Z; the same
// instant read in Europe/London (BST, +01:00, in September) is 06:00:00.
import { date, zone } from "std/time"

fn main() {
  let dubai = zone("Asia/Dubai") catch e {
    println("zone(Asia/Dubai) failed: ${e.message()}")
    return
  }
  let london = zone("Europe/London") catch e {
    println("zone(Europe/London) failed: ${e.message()}")
    return
  }
  let d = date(2026, 9, 1) catch e {
    println("date failed: ${e.message()}")
    return
  }
  let naive = d.atTime(9, 0, 0) catch e {
    println("atTime failed: ${e.message()}")
    return
  }

  let dt = naive.inZone(dubai)
  println("toString=${dt.toString()}")
  println("offset=${dt.offset()}")
  println("isDst=${dt.isDst()}")
  println("zoneName=${dt.zone().name}")
  println("naive=${dt.naive().toString()}")
  println("date=${dt.date().toString()}")
  println("time=${dt.time().toString()}")
  println("year=${dt.year()}")
  println("month=${dt.month()}")
  println("day=${dt.day()}")
  println("hour=${dt.hour()}")
  println("minute=${dt.minute()}")
  println("second=${dt.second()}")
  println("nanosecond=${dt.nanosecond()}")
  println("dayOfWeek=${dt.dayOfWeek()}")

  let ts = dt.toTimestamp() catch e {
    println("toTimestamp failed: ${e.message()}")
    return
  }
  println("timestamp=${ts.toString()}")

  let inLondon = dt.withZone(london)
  println("withZoneToString=${inLondon.toString()}")
  println("withZoneHour=${inLondon.hour()}")
  println("withZoneOffset=${inLondon.offset()}")
  println("withZoneIsDst=${inLondon.isDst()}")

  let back = ts.inZone(dubai)
  println("roundTripEqual=${back.toString() == dt.toString()}")
}
