// run
// #3933: a slice literal item that is a zero-argument Call — not a fresh
// Tag.CompositeLit of elemTy — disqualifies elemTy from the inline
// representation for the WHOLE module, the same rule append(xs, ...)'s
// trailing arguments already enforce (#3862's scanAppendArgs). Before the
// fix `[mk()]` compiled to a silent wrong answer: storePackedCompositeLit
// (lowerlit.bit) iterated kidsOf(litNode)[1] — for a Call node its (empty)
// argument list — so the fill loop ran zero times and the packed slot kept
// slice_new's zero bytes, printing "0,0" instead of the constructed value.
class Node { x: i64, y: i64 }

fn mk(): Node { return Node{ x: 1, y: 2 } }

fn main() {
  let xs = [mk()]
  print("${xs[0].x},${xs[0].y}\n")
}
