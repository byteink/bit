// run
// A panic raised inside a `spawn`ed task is contained by that task's OWN
// boundary (#4746, epic #4739). `runRecovering` (stdlib/runtime/runtime.bit)
// is armed on the worker task, `boom` panics below it, and the recovered
// message crosses back to `main` on a channel while the process stays up.
//
// Going through `spawn` is the point: the boundary record is published in the
// task's scratch word (`scrPanicBoundary`, runtime/sched/scratch.bit), so a
// boundary that were per-thread or per-process instead would either miss this
// panic entirely — taking the program down, and this case with it — or catch
// it on the wrong stack. `main` arms nothing, so the recovery cannot be coming
// from anywhere but the worker.
import { runRecovering } from "std/runtime"

fn boom(n: i64) {
  panic("worker ${n} failed")
}

fn worker(n: i64, out: chan<string>) {
  let (panicked, msg) = runRecovering(() => {
    boom(n)
  })
  if (!panicked) {
    out <- "BUG: the boundary reported no panic"
    return
  }
  out <- msg

  // The task is still runnable after the resume: a boundary that left it
  // wedged, or that resumed onto a discarded frame, would never send this and
  // the unbuffered receive in `main` would hang instead of failing loudly.
  out <- "worker still running"
}

fn main() {
  let out = chan<string>(0)
  spawn worker(7, out)
  print("recovered: ${<- out}\n")
  print("${<- out}\n")
  print("main alive\n")
}
