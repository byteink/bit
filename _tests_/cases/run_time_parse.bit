// run
// #4081: the five parse functions (docs/stdlib/time.md, "Parsing"),
// reached through the public `std/time` import surface rather than from
// inside the module -- stdlib/time/ldmlparse.test.bit already covers them
// from within, where the module's private helpers are in scope, so this
// fixture is the check that they are exported and that the round trip
// holds for a caller who only has the public names.
//
// The property pinned below is print-then-parse: every value here is
// written by the matching `toString`, read back, and printed again, so a
// line that differs from its input is a parser that lost a field. The
// strictness rules follow, one rejection per line: a parser is only as
// good as what it refuses.
import { parseDate, parseTime, parseNaiveDateTime, parseDateTime, parseWith } from "std/time"

// `s` parsed and printed again, or the failure message prefixed "ERR:".
// No canonical form starts with "ERR:", so the expected file tells a
// rejection from a rendering without a second flag.
fn caseDate(s: string): string {
  let v = parseDate(s) catch e {
    return "ERR:" + e.message()
  }
  return v.toString()
}

fn caseTime(s: string): string {
  let v = parseTime(s) catch e {
    return "ERR:" + e.message()
  }
  return v.toString()
}

fn caseNaive(s: string): string {
  let v = parseNaiveDateTime(s) catch e {
    return "ERR:" + e.message()
  }
  return v.toString()
}

fn caseZoned(s: string): string {
  let v = parseDateTime(s) catch e {
    return "ERR:" + e.message()
  }
  return v.toString()
}

fn caseWith(pattern: string, s: string): string {
  let v = parseWith(pattern, s) catch e {
    return "ERR:" + e.message()
  }
  return v.toString()
}

fn caseShow(label: string, value: string) {
  println(label + "=" + value)
}

fn main() {
  caseShow("date", caseDate("2026-09-01"))
  caseShow("time", caseTime("09:00:00"))
  caseShow("timeNanos", caseTime("09:00:00.000000500"))
  caseShow("naive", caseNaive("2026-09-01T09:00:00"))
  caseShow("zoned", caseZoned("2026-09-01T09:00:00+04:00"))
  caseShow("zonedZ", caseZoned("2026-09-01T09:00:00Z"))
  caseShow("shortFraction", caseTime("09:00:00.5"))

  caseShow("lowercase", caseZoned("2026-09-01t09:00:00z"))
  caseShow("colonlessOffset", caseZoned("2026-09-01T09:00:00+0400"))
  caseShow("leapSecond", caseZoned("2026-09-01T09:00:60Z"))
  caseShow("leadingSpace", caseDate(" 2026-09-01"))
  caseShow("trailingChar", caseDate("2026-09-01x"))
  caseShow("tenDigitFraction", caseTime("09:00:00.1234567890"))
  caseShow("missingZone", caseZoned("2026-09-01T09:00:00"))
  caseShow("impossibleDay", caseDate("2026-02-30"))

  caseShow("pattern", caseWith("dd/MM/yyyy", "01/09/2026"))
  caseShow("patternNames", caseWith("EEEE, d MMMM yyyy", "Tuesday, 1 September 2026"))
  caseShow("patternClock", caseWith("h:mm a", "9:05 PM"))
  caseShow("patternWeekBasedYear", caseWith("YYYY-MM-dd", "2026-09-01"))
  caseShow("patternDayOfYear", caseWith("yyyy-DDD", "2026-244"))
  caseShow("patternLeftover", caseWith("dd/MM/yyyy", "01/09/2026 "))
}
