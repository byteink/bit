// run
// #6264: `from` is a CONTEXTUAL keyword (SPEC §5.2), the same shape as
// `static`/`readonly`/`use` — an ordinary identifier everywhere except
// immediately after an `import_decl`'s body. Exercises every non-import
// position at once: a `let` binding, a class field, a function parameter,
// and a method name, alongside a real `import ... from` in the same file.
import { contains } from "std/strings"

class Transfer {
  from: int,
  to: int,
}

fn describe(from: int, to: int): string {
  return "from=${from} to=${to}"
}

class Account {
  from(): int { return 7 }
}

fn main() {
  let from = 1
  print("${from}\n")
  print("${describe(2, 3)}\n")
  let t = Transfer{ from = 4, to = 5 }
  print("${t.from} ${t.to}\n")
  let a = Account{}
  print("${a.from()}\n")
  print("${contains("from", "om")}\n")
}
