// panic
// #2255 added the non-fatal `checkX`/`checkDone()` twins to std/testing but
// shipped no golden fixture (deferred: _tests_/cases/'s pinned census was under
// concurrent edit at the time). #3431 adds it.
//
// `checkEq` records a failure and returns instead of panicking, so a
// table-driven loop reports every bad row rather than only the first; a
// paired `checkDone()` then turns any recorded failure into a real panic.
// Three of the five rows below are deliberately wrong, so the expected
// stderr is all three "check failed" lines, in loop order, followed by
// checkDone()'s own panic message.
import { checkEq, checkDone } from "std/testing"

class C { name: string, got: int, want: int }

fn main() {
  defer checkDone()
  let cases = [
    C{ name: "row1-ok", got: 1, want: 1 },
    C{ name: "row2-BAD", got: 2, want: 99 },
    C{ name: "row3-ok", got: 3, want: 3 },
    C{ name: "row4-BAD", got: 4, want: 88 },
    C{ name: "row5-BAD", got: 5, want: 77 },
  ]
  for (let i = 0; i < len(cases); i++) {
    let c = cases[i]
    checkEq(c.got, c.want, "case ${c.name}")
  }
}
