// run
// #6285: `f() catch e { ... }` at STATEMENT position (§18.3, expr_stmt) has
// its ok value intentionally discarded, so its block needs no value even
// when `f`'s ok type is non-void — a plain assignment tail (no diversion, no
// value expression) is well-formed there, unlike the sibling REJECTION case
// check_catch_value_falls_through.bit, where the identical block shape is
// the operand of a `return` (the value IS used) and E0067 still fires.
// A single-file golden gets NO prelude, so the error value is a local type
// satisfying the predeclared `error` interface structurally.
class myErr {
  code: i64
  message(): string { return "code=${this.code}" }
}
fn f(ok: bool): i64! {
  if (ok) {
    return 9
  }
  fail myErr{ code = 3 }
}

fn main() {
  let mismatched = false
  f(false) catch e {
    mismatched = true
  }
  print("mismatched=${mismatched}\n")
  let mismatched2 = false
  f(true) catch e {
    mismatched2 = true
  }
  print("mismatched2=${mismatched2}\n")
}
