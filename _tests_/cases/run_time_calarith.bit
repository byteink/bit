// run
// #4076: calendar arithmetic (docs/stdlib/time.md, "Arithmetic", "Month
// arithmetic clamps", "Setting a field", "Arithmetic across a transition").
//
// Five clamping rows straight out of the docs table: `addMonths`/`addYears`
// keep the day where possible and clamp to the last day of the target month
// where not, going forward and backward, across a leap year and via
// `withMonth`. Then the reversibility trap the same section names by
// example: `addMonths(1).addMonths(-1)` on 2026-01-31 is 2026-01-28, not
// 2026-01-31, because the forward step already lost the day.
//
// `Time.addMinutes` wraps within the day and never carries into a date; the
// identical shift on a `NaiveDateTime` DOES carry, because it has a date to
// carry into ("Time arithmetic wraps within the day").
//
// `DateTime.addDays` operates on the wall clock and re-resolves the zone
// offset, not on the instant: 2026-10-24T09:00 Europe/London plus one day
// is 2026-10-25T09:00 -- still hour 9 -- even though the clocks went back
// and 25 real hours elapsed ("Arithmetic across a transition").
import { date, time, zone } from "std/time"

fn main() {
  let jan31 = date(2026, 1, 31) catch e {
    println("date build failed: ${e.message()}")
    return
  }
  println("clamp1=${jan31.addMonths(1).toString()}")

  let jan31Leap = date(2024, 1, 31) catch e {
    println("date build failed: ${e.message()}")
    return
  }
  println("clamp2=${jan31Leap.addMonths(1).toString()}")

  let mar31 = date(2026, 3, 31) catch e {
    println("date build failed: ${e.message()}")
    return
  }
  println("clamp3=${mar31.addMonths(-1).toString()}")

  let feb29 = date(2024, 2, 29) catch e {
    println("date build failed: ${e.message()}")
    return
  }
  println("clamp4=${feb29.addYears(1).toString()}")

  println("clamp5=${jan31.withMonth(2).toString()}")

  println("reversibility=${jan31.addMonths(1).addMonths(-1).toString()}")

  let wrap = time(23, 30, 0) catch e {
    println("time build failed: ${e.message()}")
    return
  }
  println("timeWraps=${wrap.addMinutes(60).toString()}")

  let ndt = jan31.atTime(23, 30, 0) catch e {
    println("atTime failed: ${e.message()}")
    return
  }
  println("naiveCarries=${ndt.addMinutes(60).toString()}")

  let london = zone("Europe/London") catch e {
    println("zone(Europe/London) failed: ${e.message()}")
    return
  }
  let before = date(2026, 10, 24) catch e {
    println("date build failed: ${e.message()}")
    return
  }
  let beforeNaive = before.atTime(9, 0, 0) catch e {
    println("atTime failed: ${e.message()}")
    return
  }
  let beforeDt = beforeNaive.inZone(london)
  let afterDt = beforeDt.addDays(1)
  println("afterHour=${afterDt.hour()}")

  let beforeTs = beforeDt.toTimestamp() catch e {
    println("toTimestamp failed: ${e.message()}")
    return
  }
  let afterTs = afterDt.toTimestamp() catch e {
    println("toTimestamp failed: ${e.message()}")
    return
  }
  println("elapsedNs=${afterTs.ns - beforeTs.ns}")
}
