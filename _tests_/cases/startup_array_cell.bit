// run
// #6516: a module cell of array type takes a non-constant initializer. It runs
// at startup, before `main`, and its elements are copied into the cell, so a
// write to the cell in `main` never reaches the array the function returned. The
// 256-entry table is the CRC-style lookup table this form exists for; the
// `const` is the read-only form.
fn buildTable(): [256]u8 {
  let t: [256]u8
  let i = 0
  while (i < 256) {
    t[i] = u8(((i * 7) ^ (i >> 1)) & 255)
    i = i + 1
  }
  return t
}

fn squares(): [4]i64 {
  return [4]i64{ 0, 1, 4, 9 }
}

let table: [256]u8 = buildTable()
const sq: [4]i64 = squares()

fn main() {
  let sum = 0
  let i = 0
  while (i < 256) {
    sum = sum + int(table[i])
    i = i + 1
  }
  println("table ${table[0]} ${table[1]} ${table[255]} sum ${sum}")
  table[1] = 99
  println("written ${table[1]} fresh ${buildTable()[1]}")
  println("sq ${sq[0]} ${sq[1]} ${sq[2]} ${sq[3]}")
}
