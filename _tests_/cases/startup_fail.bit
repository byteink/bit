// run
// #6480: a failing startup initializer stops the program before `main`: one
// line on stderr naming the module, the error and the declaration's file and
// line, then exit code 3 (not a panic's 2, not a fallible `main`'s 1). The
// program runs itself with the argument `fail`; the child never reaches `main`,
// which would otherwise run this program again.
import { argc, selfExe } from "std/os"
import { output } from "std/process"
import { indexOf } from "std/strings"
import { limit } from "./startupfail_mod"

fn main() {
  if (argc() > 1) {
    println("main reached")
    return
  }
  println("limit=${limit}")
  let r = output(selfExe(), ["fail"])
  println("exit=${r.exitCode}")
  println("stdout=[${r.stdout}]")
  let at = indexOf(r.stderr, " failed to start")
  println("stderr starts: ${r.stderr[0:at]}")
  let file = indexOf(r.stderr, " (")
  println("stderr ends: ${r.stderr[at:at + 30]} ... ${r.stderr[file:len(r.stderr)]}")
}
