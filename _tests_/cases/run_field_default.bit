// run
// SPEC §10.5, #3838: a class field may declare a compile-time-constant default,
// used wherever the field is not spelled. The whole point is that the default
// beats the ZERO value, so every assertion here is a field whose default and
// whose zero value differ -- an 8080 that reads 0 is the failure this exists to
// catch, and a fixture defaulting anything to 0 could not see it.
//
// All four construction forms are here on purpose. A default honored only by a
// composite literal would make `Opts{}` and `[]Opts(1)[0]` disagree about a
// field declared exactly once, and the disagreeing half is always the zero.
const KB = 1024

class Opts {
  port: int = 8080,
  host: string = "127.0.0.1",
  maxBody: int = 1000 * KB,
  ratio: f64 = 0.5,
  readonly tag: int = 1 + 2,
  tls: bool,
}

fn show(o: Opts) {
  print("${o.port} ${o.host} ${o.maxBody} ${o.ratio} ${o.tag} ${o.tls}\n")
}

fn main() {
  // Form 1: the empty literal -- every field defaulted.
  show(Opts{})
  // Form 2: a partial literal -- a spelled field beats its own default, and
  // beating one default must not disturb the others.
  show(Opts{ port: 3000 })
  // Form 3: every field spelled, including one whose default it overrides.
  show(Opts{ port: 1, host: "h", maxBody: 2, ratio: 1.5, tag: 9, tls: true })
  // Form 4: `[]T(n)` -- n zero values (§12.9), which for a defaulted field is
  // its default. `zeroValue`'s struct arm, not the literal path.
  let xs = []Opts(2)
  show(xs[0])
  show(xs[1])
  // Form 5: a bare binding with no initializer -- the same zero-value path
  // reached from `let`.
  let p: Opts
  show(p)
}
