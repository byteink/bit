// lint exit=0
// #5247 E0218 `relation-unloaded-read`: `tags` is a plain `[]string` field
// on the SAME class as the real relation field `orders` -- no `@hasMany`/
// `@hasOne`/`@belongsTo` -- so it merely LOOKS like the positive fixture's
// shape (a slice field, read straight off `u`, no `.with()` anywhere). The
// rule must ask the real compiler-known predicate
// (compiler/classrelationattr.bit's `fieldRelationAttr`), never guess from
// the field's own type or name, so this produces zero findings.
import { Data, find } from "orm"
import { FieldDesc, Rows } from "std/sql"

class Order {
  id: i64,
}

@table class User {
  @id
  id: i64
  @hasMany("userId")
  orders: []Order
  tags: []string
}

fn userMapper(rows: Rows): User! {
  return User{ id: 1, tags: []string(0) } // `orders` left unset on purpose
}

fn report(db: Data, id: i64): ()! {
  let u = find<User>(db, "users", []FieldDesc(0), userMapper).oneOrFail()?
  print("${len(u.tags)}\n")
}
