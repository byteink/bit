// run
// #4491 CONTROL. `vAssign` (compiler/validatestmt.bit) judges every plain `=`
// pair against its lhs type, where before only an interface-typed lhs was
// judged at all. That rule must not reach the forms that have their own rule
// or their own conversion, so each one is exercised here rather than argued
// about: the multi-value spellings `a, b = f()` and `(a, b) = t` (vDestructure
// owns their arity and element types), an untyped constant adapting to a sized
// target (vAssignableNode's representability path, not identity), and the
// storage slots whose lhs is not a bare identifier — an element, a field, a
// map value, a tuple-typed local and a nilable set to nil.
class Box {
  n: i64,
  tag: string,
}

interface Speaker {
  say(): string,
}

class Dog {
  name: string

  say(): string {
    return "woof"
  }
}

fn pair(): (i64, string) {
  return (7, "seven")
}

fn main() {
  // Multi-value: one rhs, several lhs — and the parenthesized tuple form.
  let p = 0
  let q = ""
  p, q = pair()
  print("bare ${p} ${q}\n")
  (p, q) = pair()
  print("paren ${p} ${q}\n")

  // A whole tuple value assigned as one thing.
  let t = (1, "one")
  t = pair()
  print("tuple ${t.0} ${t.1}\n")

  // Untyped constants adapt to the target's own width, they are not i64.
  let a: i64 = 0
  let b: f64 = 0.0
  let c: u8 = 0
  let d: i32 = 0
  a = 1
  b = 2.5
  c = 200
  d = 1 << 20
  print("consts ${a} ${b} ${c} ${d}\n")

  // Non-identifier storage slots.
  let xs = []i64(2)
  xs[0] = 42
  let box = Box{ n: 1, tag: "x" }
  box.n = 2
  box.tag = "y"
  let m = map<string, i64>()
  m["k"] = 9
  print("slots ${xs[0]} ${box.n} ${box.tag} ${m["k"]}\n")

  // An interface target still accepts a satisfying class, and a nilable type
  // still accepts nil.
  let s: Speaker = Dog{ name: "rex" }
  s = Dog{ name: "fido" }
  let ptr: *i64 = nil
  ptr = nil
  print("iface ${s.say()} nil=${ptr == nil}\n")
}
