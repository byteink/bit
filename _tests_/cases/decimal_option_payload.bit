// run
// #5427: `Option<decimal>` is the exact shape pkg/mysql's `mysqlOptDecimal`
// (pkg/mysql/decimal.bit) returns, and both `Some` and `None` hit the same
// `explodedEnumWordTypes` payload-word mistyping — `None` panicked too,
// since the panic was in the TYPE's layout, not the payload read.
fn withValue(): Option<decimal> {
  let d: decimal = 7.25
  return Option.Some(d)
}

fn withoutValue(): Option<decimal> {
  return Option<decimal>.None
}

fn main() {
  match (withValue()) {
    Some(v) => println("${v}")
    None => println("none")
  }
  match (withoutValue()) {
    Some(v) => println("${v}")
    None => println("none")
  }
}
