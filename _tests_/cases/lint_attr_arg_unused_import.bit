// lint exit=1
// #6096: a field attribute's ARGUMENTS are references too — `LIMIT` in
// `@minLen(LIMIT)` and `Cascade` in `@rule(onDelete = Cascade)` (a named
// argument's VALUE) — so neither is flagged. `onDelete` is imported and only
// ever appears as that named argument's LABEL, a declaration slot rather than
// a reference, so it must still be flagged: the negative control.
import { minLen, rule, LIMIT, Cascade, onDelete } from "./mod"

class X {
  @minLen(LIMIT)
  @rule(onDelete = Cascade)
  name: string
}

fn main() {}
