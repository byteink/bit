// run
// #4356: the other half of closure devirtualisation — the REFUSAL. The rewrite
// drops `call_value`'s nil test and picks one target, so it is only legal when
// every value that can reach a callee's function-typed parameter comes from the
// same `make_closure`. When two different lambdas reach one monomorphised
// instantiation, the analysis must poison that parameter and leave the indirect
// call alone.
//
// `sortInPlace` and `isSorted` are instantiated ONCE for `[]int` here and each
// is handed three different comparators — ascending, descending, and one chosen
// at run time from a local. A merge that kept the first-seen target instead of
// poisoning compiles and runs, and sorts every slice in ascending order: the
// second and third lines below would come out identical to the first.
//
// The run-time pick is deliberate. Its closure arrives through a block
// parameter with two predecessors passing different `make_closure` values, so
// it also covers the intra-function meet over block-parameter edges, not just
// the meet over call sites.
//
// Single-file golden: no prelude.
import { sortInPlace, isSorted } from "std/sort"

fn showInts(xs: []int): string {
  let s = "["
  let i = 0
  while (i < len(xs)) {
    if (i > 0) {
      s = s + " "
    }
    s = s + "${xs[i]}"
    i = i + 1
  }
  return s + "]"
}

fn copyOf(xs: []int): []int {
  let out: []int = []int(len(xs))
  let i = 0
  while (i < len(xs)) {
    out[i] = xs[i]
    i = i + 1
  }
  return out
}

fn sortedWith(xs: []int, less: (int, int) => bool): []int {
  let out = copyOf(xs)
  sortInPlace(out, less)
  return out
}

fn pick(descending: bool): (int, int) => bool {
  let f = (a: int, b: int) => a < b
  if (descending) {
    f = (a: int, b: int) => b < a
  }
  return f
}

fn main() {
  let src: []int = []int{ 5, 1, 4, 2, 3 }
  let up = sortedWith(src, (a, b) => a < b)
  let down = sortedWith(src, (a, b) => b < a)
  let picked = sortedWith(src, pick(true))
  println("up   ${showInts(up)} isSortedUp=${isSorted(up, (a, b) => a < b)}")
  println("down ${showInts(down)} isSortedUp=${isSorted(down, (a, b) => a < b)}")
  println("pick ${showInts(picked)} isSortedDown=${isSorted(picked, (a, b) => b < a)}")
}
