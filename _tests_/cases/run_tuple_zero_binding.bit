// run
// An initializer-less typed binding is its type's ZERO VALUE (SPEC §13.4), and
// for a tuple that zero value is a live, zeroed record — not nil (#4414).
//
// `zeroValue` (lowerslicefill.bit) had a Struct arm and an Array arm and no
// Tuple arm, so a tuple fell through to the `ConstNil` default. On `main` the
// first arm below lowered to
//
//     %0 = const_nil
//     %1 = field_get %0[0] i64
//
// and segfaulted at exit 2, while the class and array forms beside it — the
// two controls kept here on purpose — printed 0 at exit 0.
//
// A tuple is a boxed record (ABI.md §1.1), so its zero BITS are a null
// reference exactly as a class's are, and every member kind whose own zero
// value is itself a live object has to be materialized rather than left as the
// allocation's zero bytes: a NESTED tuple, an inline ARRAY member (a tuple's
// array member gets a pointer slot from `layoutFields`, where a class's gets
// the array's bytes inline from `structLayout`), a CLASS member, and a boxed
// ENUM member. Each is an arm below.
//
// The second half is the #4410 exploded-local form. `lowerBinding` used to
// bind this shape with `declareLocal` rather than `declareLetLocal`, because
// reading two words out of a `const_nil` would have moved the crash from the
// first USE to the DECLARATION — faulting even in a function that never
// touches the binding. With a real object behind it the exclusion is gone, so
// every use of an exploded local is exercised here too.
//
// FIXED SEPARATELY AND COVERED ELSEWHERE (#4500): a tuple-typed CLASS FIELD, a
// map miss on a tuple-valued map, and `[]( (int,int) )(n)` each handed back a
// null too, because `omittedFieldValue`, `zeroIsObject` and
// `sliceAllocElemNeedsFill` each kept their own list of the kinds whose zero
// bits are wrong and none of the three named Tuple. They are one predicate now
// (`zeroIsLiveRecord`, lowerslicefill.bit); run_tuple_zero_field.bit covers
// those three forms, and this file stays on the binding.

class P {
  a: i64,
  b: string,
}

enum E {
  A,
  B(i64),
}

fn showE(e: E): string {
  match (e) {
    A => { return "A" }
    B(x) => { return "B ${x}" }
  }
}

fn sum(p: (i64, i64)): i64 {
  return p.0 + p.1
}

fn zeroPair(): (i64, i64) {
  let w: (i64, i64)
  return w
}

fn memberKinds() {
  // Every member kind whose zero bits are NOT its zero value.
  let n: ((i64, i64), i64)
  print("nested ${n.0.0} ${n.0.1} ${n.1}\n")
  let ar: (i64, [2]i64)
  print("member-array ${ar.0} ${ar.1[0]} ${ar.1[1]}\n")
  let cl: (i64, P)
  print("member-class ${cl.0} ${cl.1.a} [${cl.1.b}]\n")
  let en: (i64, E)
  print("member-enum ${en.0} ${showE(en.1)}\n")

  // Member kinds whose zero bits ARE their zero value, including the sub-word
  // and float widths a wrong store width would corrupt.
  let tr: (string, []i64)
  print("member-traced [${tr.0}] ${len(tr.1)}\n")
  let mx: (i32, bool, f64)
  print("member-mixed ${mx.0} ${mx.1} ${mx.2}\n")

  // A tuple of more than two words: #4412's shape, where a widened predicate
  // reached the return path and left the argument path truncating.
  let w3: (i64, i64, i64)
  print("wide3 ${w3.0} ${w3.1} ${w3.2}\n")
}

// The exploded-local uses the removed `declareLocal` exclusion blocked, in
// their own function: `main` was over E0201's 80-line ceiling with all of it
// inline.
fn explodedUses() {
  // Whole-value use, then reassignment of the whole binding.
  let rw: (i64, i64)
  print("whole ${sum(rw)}\n")
  rw = (3, 4)
  print("reassigned ${sum(rw)} ${rw.0} ${rw.1}\n")

  // Loop-carried: the words are the loop's own block parameters, so a value
  // that failed to be threaded through the header would read the entry copy.
  let acc: (i64, i64)
  let i = 0
  while (i < 3) {
    acc = (acc.0 + i, acc.1 + 1)
    i = i + 1
  }
  print("loop ${acc.0} ${acc.1}\n")

  // Destructured, and returned from a function whose result is the zero value.
  let d: (i64, i64)
  let (dx, dy) = d
  print("destructure ${dx} ${dy}\n")
  print("returned ${sum(zeroPair())}\n")

  // A traced word must survive a collection: word 0 is the only reference to
  // the string the tuple carries, and the loop below allocates past a nursery.
  let tw: (string, i64)
  let junk = []i64(0)
  let k = 0
  while (k < 4000) {
    junk = append(junk, k)
    k = k + 1
  }
  print("traced-live [${tw.0}] ${tw.1} ${len(junk)}\n")

  // Captured by an arrow, and captured AND assigned (which forces the name
  // into a heap cell instead of exploding it).
  let held: (i64, i64)
  let f = () => {
    return held.0 + held.1 + 5
  }
  print("captured ${f()}\n")
  let boxed: (i64, i64)
  let g = () => {
    boxed = (boxed.0 + 1, boxed.1 + 2)
  }
  g()
  g()
  print("boxed ${boxed.0} ${boxed.1}\n")

  // Read from a deferred call, whose operand slot starts as the placeholder
  // `deferZeroValue` hands out.
  let dv: (i64, i64)
  defer print("deferred ${dv.0} ${dv.1}\n")
  print("done\n")
}

fn main() {
  // The ticket's exact repro, and its two controls.
  let w: (i64, i64)
  print("tuple ${w.0} ${w.1}\n")
  let c: P
  print("class ${c.a} [${c.b}]\n")
  let xs: [2]i64
  print("array ${xs[0]} ${xs[1]}\n")

  memberKinds()
  explodedUses()
}
