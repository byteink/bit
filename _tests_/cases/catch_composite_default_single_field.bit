// run
// #5474: `catch Ident{ singleField = v }` is byte-identical to a one-
// statement catch-bind block (`singleField = v` is a legal assignment
// statement) once field_init accepts `=` (#3840) — parseCatchTail's
// speculative bind parse used to win on a clean parse alone, with no other
// token to break the tie. `Circle{ r = 1 }` below must build a Circle (a
// composite default), never bind `Circle` as the caught error's name and run
// `r = 1` as the handler body (which used to fail with E0040, "undefined
// name 'r'").
class Circle {
  r: int
}
fn f(): Circle! { fail newError("boom") }

fn main() {
  let x = f() catch Circle{ r = 1 }
  println("r=${x.r}")
}
