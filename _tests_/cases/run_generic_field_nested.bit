// run
// A field whose declared type is a GENERIC INSTANCE over the outer class's own
// type param (#1556). `Pair<i64>.a` must be `Box<i64>`, so `p.a.v` is i64 and
// can be added to `p.b`. Both structs spell their parameter `T` on purpose: the
// name collision is what made `isOwnTypeParams` mistake `Box<T>` for Box's own
// template and hand back an uninstantiated type, leaving `p.a.v` typed `T`.
class Box<T> { v: T }
class Pair<T> { a: Box<T>, b: T }

fn fromPair(p: Pair<i64>): i64 {
  return p.a.v + p.b
}

fn main() {
  print("${fromPair(Pair<i64>{ a: Box<i64>{ v: 40 }, b: 2 })}\n")
}
