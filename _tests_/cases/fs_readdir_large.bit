// run
// #2151: `fs.readDir`'s sort must be O(n log n), not the O(n^2) insertion
// sort that cost 105s of CPU at 50,000 entries. 20,000 zero-padded names in
// one directory, sorted and asserted well inside the golden suite's per-case
// timeout — a timing regression back to insertion sort re-fails this case.
import { envOr } from "std/os"
import { repeat } from "std/strings"
import { mkdir, writeFile, readDir, remove } from "std/fs"

fn pad5(n: int): string {
  let s = "${n}"
  let zeros = 5 - len(s)
  if (zeros <= 0) {
    return s
  }
  return repeat("0", zeros) + s
}

fn main() {
  let dir = "${envOr("TMPDIR", "/tmp")}/bit_fs_readdir_large_${timeUnixNs()}"
  mkdir(dir) catch _ {
    println("setup failed: cannot create ${dir}")
    return
  }

  let n = 20000
  let i = 0
  while (i < n) {
    writeFile("${dir}/f${pad5(i)}", "x") catch _ {
      println("setup failed: cannot write entry ${i}")
      return
    }
    i = i + 1
  }

  let names = readDir(dir) catch _ {
    println("readDir failed")
    return
  }
  println("count=${len(names)} first=${names[0]} last=${names[len(names) - 1]}")

  let j = 0
  while (j < n) {
    remove("${dir}/f${pad5(j)}") catch _ {
      return
    }
    j = j + 1
  }
  remove(dir) catch _ {
    return
  }
}
