// run
// Multi-value return and tuple destructuring (SPEC §13.1/§10.1, ABI.md §1.1).
// `return a, b` builds one boxed tuple and returns a single handle, so this
// executes rather than merely type-checking — `bit check` used to pass a program
// `bit build` then refused, which is the trap this case exists to keep closed.
fn pair(): (i64, string) {
  return 7, "hi"
}

fn triple(): (i64, string, bool) {
  return 1, "two", true
}

fn inner(): (i64, i64) {
  return 3, 4
}

fn nested(): ((i64, i64), string) {
  return inner(), "n"
}

// The elements widen to the *declared* element types, not their own inferred
// ones: `5` is an untyped literal and the second element is an f64.
fn widen(): (i64, f64) {
  return 5, 2.5
}

// Narrow elements are the case that makes the declared-type hint load-bearing
// rather than cosmetic. A tuple element is STORED into a field of its own width,
// so an untyped literal lowered at its default i64 width would write 8 bytes
// into a 1-byte slot and scribble over its neighbours. A single-value return
// never shows this — there the return register absorbs the width difference.
fn narrow(): (u8, i32, u8) {
  return 200, 70000, 44
}

// #4718: the two destructures a GENERIC body types with an OPEN type parameter,
// which is the false-positive class the checker's new E0041 must never fire on.
// `p` is a tuple OF type parameters; `idOf<T>(v)` is a bare `T` that is not a
// tuple type at all until it monomorphizes. The checker cannot judge either
// shape here and must stay silent, exactly as it does for an initializer that
// did not infer.
fn swap<A, B>(p: (A, B)): (B, A) {
  let (a, b) = p
  return (b, a)
}

fn idOf<T>(v: T): T {
  return v
}

fn unpackSum<T>(v: T): i64 {
  let (a, b) = idOf<T>(v)
  return a + b
}

fn main() {
  let (n, s) = pair()
  print("pair ${n} ${s}\n")

  // `t.N` reads an element back out of the box.
  let t = pair()
  print("index ${t.0} ${t.1}\n")

  let (a, b, c) = triple()
  print("triple ${a} ${b} ${c}\n")

  // `_` discards an element without binding it.
  let (_, s2, _) = triple()
  print("blank ${s2}\n")

  // A nested pattern destructures a tuple element in the same `let`.
  let ((x, y), z) = nested()
  print("nested ${x} ${y} ${z}\n")

  let (w1, w2) = widen()
  print("widen ${w1} ${w2}\n")

  let (n1, n2, n3) = narrow()
  print("narrow ${n1} ${n2} ${n3}\n")

  // Both assignment spellings target existing locals, matching the two-result
  // forms in run_map_comma_ok.
  let p = 0
  let q = ""
  (p, q) = pair()
  print("paren ${p} ${q}\n")
  p, q = pair()
  print("bare ${p} ${q}\n")

  let (g1, g2) = swap<i64, string>((1, "s"))
  print("generic ${g1} ${g2}\n")
  print("openparam ${unpackSum<(i64, i64)>((2, 3))}\n")
}
