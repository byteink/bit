// run
// #2376's other half, and the constraint on its fix.
//
// The SIGILL that ticket names is only the loudest consumer of the wrong value.
// An f32 binding initialised from a constant EXPRESSION held an f64-typed value,
// so `append` on a `[]f32` stored the double's bit pattern and the element read
// back unequal to the identical literal — a silent wrong answer with no crash:
// `elem` printed false where `lit` printed true. Both are pinned below, together
// with an f32 fed to a function that takes f32 (the ABI passes a single).
//
// The integer lines are the CONSTRAINT, not the bug. An untyped constant
// expression is evaluated at full precision and only its result has to fit the
// target type, so `let a: u8 = 300 / 2` is 150 — the intermediate 300 does not
// fit u8 and does not have to. If the fix had made a constant expression adopt
// its context type for INTEGERS too, the folder would wrap each step to 8 bits
// and answer 22. `i8 = 200 / 2` is the signed twin: wrapping first would give
// -28 instead of 100.
//
// Single-file golden: no prelude.
fn twice(x: f32): f32 {
  return x * 2.0
}

fn main() {
  let lit: f32 = 1.5
  let e: f32 = 1.0 + 0.5
  let m: f32 = 3.0 * 0.5
  print("f32 expr=${e} mul=${m} lit=${lit}\n")

  let xs = []f32(0)
  let ys = append(xs, e)
  print("elem=${ys[0]} same=${ys[0] == lit}\n")
  print("twice=${twice(e)}\n")

  let d: f64 = 1.0 + 0.5
  print("f64 expr=${d}\n")

  let a: u8 = 300 / 2
  let b: i8 = 200 / 2
  let c: i32 = 1 + 2
  print("u8=${a} i8=${b} i32=${c}\n")
}
