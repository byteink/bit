// run
// Every byte of a freshly allocated body must read 0 (runtime/ABI.md §1), for
// EVERY body size, not just the word-aligned ones. #4045 rewrote `zeroBytes`
// (runtime/gc/gcalloc.bit) from one word per iteration into a four-word block
// plus a peeled 0-3 word remainder plus a bytewise tail; each of those three
// arms can drop bytes independently, and a dropped byte is a silent
// wrong-answer path -- the collector traces the uninitialised word as a
// reference -- not a crash.
//
// THE MEMORY IS DIRTIED FIRST, AND THAT IS THE WHOLE TEST. A fresh mmap page is
// already zero, so a `zeroBytes` that wrote nothing at all would pass a test
// that only ever allocated. Each round fills every buffer with 0xA5 and drops
// it; the next round allocates the same size classes back off the free lists,
// so what it reads is what `zeroBytes` actually wrote over 0xA5.
//
// `[]u8(n)` is the arm that reaches the bytewise tail: its body size is `n`
// bytes exactly (packed, ABI.md §2), so n = 1..7 mod 8 is a real non-word
// -aligned `gcAllocRaw` body. `[]i64(n)` and `Wide` cover the word arms.
fn checkBytes(n: int): int {
  let b = []u8(n)
  let bad = 0
  let i = 0
  while (i < n) {
    if (b[i] != u8(0)) {
      bad = bad + 1
    }
    b[i] = u8(165)
    i = i + 1
  }
  return bad
}

fn checkWords(n: int): int {
  let w = []i64(n)
  let bad = 0
  let i = 0
  while (i < n) {
    if (w[i] != 0) {
      bad = bad + 1
    }
    w[i] = 0 - 1
    i = i + 1
  }
  return bad
}

fn main() {
  let bad = 0
  let sizes = 0
  let r = 0
  while (r < 400) {
    let n = 0
    while (n <= 64) {
      bad = bad + checkBytes(n)
      bad = bad + checkWords(n)
      sizes = sizes + 2
      n = n + 1
    }
    r = r + 1
  }
  print("bodies=${sizes} bad=${bad}\n")
}
