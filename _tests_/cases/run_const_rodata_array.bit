// run
// #1231: a module-level `const` whose initializer is a compile-time-constant
// `[N]T{...}` composite literal materializes into a read-only `.rodata` image
// (§11.11) instead of E0064. A reference lowers to a `global_addr` — an `[N]T`'s
// value IS its base address — so `T[i]` is a static read with NO per-use
// allocation (the crypto tables' whole motivation). Reads must return the
// authored bytes across u8 and u64 element widths.
const T: [4]u8 = [4]u8{ 10, 20, 30, 40 }
const K: [3]u64 = [3]u64{ 1, 2, 3735928559 }

fn main() {
  let s = 0
  let i = 0
  while (i < 4) {
    s = s + int(T[i])
    i = i + 1
  }
  if (s == 100 && K[0] == 1 && K[2] == 3735928559) {
    print("rodata-ok\n")
  }
}
