// run
// The positive half of #1529: every call through a function VALUE whose
// arguments ARE acceptable must still compile. The check that rejects the wrong
// argument is the one that could reject a right one, and no differential can
// see a false positive — only a case like this can.
fn twice(a: i32): i32 {
  return a * 2
}

fn sum(...xs: i32): i32 {
  let t: i32 = 0
  for x of xs {
    t = t + x
  }
  return t
}

fn ident<T>(x: T): T {
  return x
}

class Box {
  f: (i32) => i32,
}

fn main() {
  // An exact match, and an UNTYPED constant against a narrower parameter — the
  // literal must not be judged as its default i64.
  let n: i32 = 21
  let t = twice
  print("${t(n)} ${t(21)}\n")

  // An arrow bound to a local, called with a literal.
  let k = (a: i32) => a + 1
  print("${k(41)}\n")

  // Two same-named bindings in sibling scopes, with DIFFERENT signatures. The
  // flat env holds one of them; each call must be judged against the binding it
  // actually resolves to, not whichever was written last.
  if (true) {
    let f = (a: string) => a + "!"
    print("${f("hi")}\n")
  }
  if (true) {
    let f = (a: i32) => a + 1
    print("${f(1)}\n")
  }

  // A variadic and a spread through a value: absorbed arguments have no exact
  // arity, so neither may be measured against the fixed parameter count.
  let v = sum
  let xs = []i32{1, 2, 3}
  print("${v(1, 2, 3)} ${v(...xs)}\n")

  // A generic's signature resolves by instantiation, not by a bare parameter
  // list, so a bare type parameter must never be compared against.
  print("${ident<i32>(7)}\n")

  // A func-typed field and a slice element — callees that are expressions, not
  // names (#1523's shapes, now also argument-checked where they are decidable).
  let b = Box{ f: twice }
  let fs = []((i32) => i32){twice}
  print("${b.f(4)} ${fs[0](5)}\n")
}
