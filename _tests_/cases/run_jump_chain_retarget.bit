// run
// #7159: a branch into a block whose whole body is an argument-free `jump`
// names that jump's target instead, so the edge costs one taken branch, not
// two. Emission-only: the IR keeps the forwarding block, and every path below
// must still reach the same join with the same values.
class Z {
  n: int
  message(): string { return "zero at ${this.n}" }
}

fn nz(x: int): int! {
  if (x == 0) {
    fail Z{ n = x }
  }
  return x
}

// A spliced fallible helper's ok path inside a loop.
fn sum(lo: int, hi: int): int! {
  let s = 0
  let i = lo
  while (i <= hi) {
    s = s + nz(i)?
    i = i + 1
  }
  return s
}

// An `if` whose then-arm is empty, and a nested one, so the join is reached
// through a block that only jumps on. #7186: those blocks pass `r` on, some
// moving it (`jump bb7(%1)` writes the constant 0 into the join's param) and
// some already in place (`jump bb8(%17)`); only the second may be skipped.
fn classify(x: int): int {
  let r = 0
  if (x > 10) {} else if (x > 5) {
    r = 2
  } else {
    if (x > 2) {} else {
      r = 1
    }
  }
  return r
}

// A void fallible call propagated from each arm: each arm's ok path ends in a
// block that only jumps on to the join.
fn step(x: int): ()! {
  if (x == 0) {
    fail Z{ n = x }
  }
}

fn both(sel: int, x: int): ()! {
  if (sel > 0) {
    step(x)?
  } else {
    step(x - 1)?
  }
}

fn tryBoth(sel: int, x: int): string {
  both(sel, x) catch e {
    return e.message()
  }
  return "ok"
}

// Both arms carry code and end in an argument-free jump to the join: a
// branch into either arm must run that arm, not skip to where it jumps.
fn say(c: bool) {
  if (c) {
    print("yes ")
  } else {
    print("no ")
  }
  print("end\n")
}

// #7189: a spliced fallible callee whose ok block passes its value on to the
// join in place. Every branch into that block names the join instead, so the
// block emits nothing and the catch arm is what the call's test falls into:
// both paths must still bind every value the join prints. Recursive, so it
// stays a call.
fn half(x: int): int! {
  if (x == 1) {
    fail Z{ n = x }
  }
  if (x < 2) {
    return 0
  }
  return half(x - 2)? + 1
}

fn halve(x: int, tag: int): string {
  let h = half(x) catch e {
    return "${tag}/${e.message()}"
  }
  return "${tag}/${x}/${h}"
}

fn main() {
  let a = sum(1, 10) catch -1
  let b = sum(-2, 3) catch -1
  print("sum ok ${a} sum fail ${b}\n")
  let x = 0
  while (x < 13) {
    print("classify ${x} = ${classify(x)}\n")
    x = x + 1
  }
  say(true)
  say(false)
  print("both ${tryBoth(1, 0)} ${tryBoth(1, 2)} ${tryBoth(0, 1)} ${tryBoth(0, 2)}\n")
  let k = 0
  while (k < 5) {
    print("halve ${halve(k, k * 10)}\n")
    k = k + 1
  }
}
