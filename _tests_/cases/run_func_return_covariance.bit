// run
// #5254: a function type's RETURN component is covariant under interface
// satisfaction (SPEC §14.1/§14.3) — `(int) => Sub` is assignable to
// `(int) => Super` when `Sub` satisfies `Super`, even though the two
// function types are not identical. A named function and an arrow literal
// both widen the same way; calling either through the widened type and
// invoking the interface method on its result proves the class pointer a
// concrete-returning function hands back is already the exact bytes a
// `Reply`-typed caller expects (§14.3: an interface value IS the object
// pointer, no boxing) — a checker relaxation, not a new thunk.
interface Reply {
  intoRes(): int,
}

class Res {
  code: int
  export intoRes(): int { return this.code }
}

type Handler = (int) => Reply

fn takesHandler(h: Handler): int { return h(3).intoRes() }

fn old(x: int): Res { return Res{ code = x } }

fn main() {
  print("${takesHandler(old)}\n")
  let arrow: Handler = (x: int) => Res{ code = x + 1 }
  print("${takesHandler(arrow)}\n")
}
