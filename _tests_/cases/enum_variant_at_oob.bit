// panic
// SPEC §14.7, #7092: `__variantAt(i)` with `i` outside 0..N-1 panics naming
// the enum and the index, never returns a wrong variant. `Action` has six
// variants, so 6 is the first index past the end.
enum Action { Manage, Read, Update, Create, Delete, Publish }

interface Named {
  static __variantAt(i: int): Self,
  __variantName(): string,
}

fn at<T: Named>(i: int): T {
  return T.__variantAt(i)
}

fn main() {
  print("${at<Action>(5).__variantName()}\n")
  print("${at<Action>(6).__variantName()}\n")
}
