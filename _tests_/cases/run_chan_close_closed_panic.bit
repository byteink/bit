// panic
// #2506: `close(c)` on a channel already closed by an earlier `close(c)` must
// panic (SPEC §18.4: "send or close on a closed channel") rather than
// silently doing nothing. `chanClose` returns false on the second close; the
// ABI wrapper used to drop that boolean. Nil channel close (#2505) and
// send/recv on a closed channel are unaffected -- this case is
// already-closed close only.
fn main() {
  let c = chan<int>(1)
  close(c)
  print("start\n")
  close(c)
  print("unreachable\n")
}
