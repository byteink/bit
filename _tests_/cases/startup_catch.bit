// run
// #6480: `catch` on the initializer line is the explicit fallback: a failure is
// handled there and the program starts.
fn load(): int! {
  fail newError("no config")
}

let retries: int = load() catch 3
let seen: int = load() catch e {
  println("handled: ${e.message()}")
  -1
}
const ok: int = load() catch 5

fn main() {
  println("retries=${retries} seen=${seen} ok=${ok}")
}
