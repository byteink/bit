// error
// #1898: a conversion to a user-declared type was judged by nothing.
// `vConversion` returned early on any user type, so both of these type-checked,
// reached the lowerer, and were refused there as "cannot lower 1 function(s)"
// naming only the enclosing function — no code, no span, no expression.
//
// Pinned as an ERROR case, not merely fixed, because the failure mode was a
// checker that exits 0 on a program the backend cannot emit. If these ever stop
// being reported, `bit check` is lying again.
interface E {
  w(): i64
}

class A {
  x: i64
}

class B {
  y: i64
}

fn f() {
  // An untyped int is not a class, so it cannot be the concrete type behind an
  // interface value.
  let e = E(5)
  // A is not B: two unrelated structs, so the conversion has no meaning.
  let a = A{x: 1}
  let b = B(a)
}
