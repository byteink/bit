// run
// Generic types composed with each other (§14.1, §14.7, §15): a generic function
// that returns a generic enum, a generic class whose field is another generic
// class, type inference through a generic-class parameter, and a recursive
// generic enum (the monomorphizer's reserve-before-fill cycle guard). All are
// monomorphized per instantiation — nested type arguments substitute all the way
// down.
enum Opt<T> {
  Some(T),
  None,
}

class Box<T> { val: T }

class Pair<T> { a: Box<T>, b: T }

enum List<T> {
  Cons(T, List<T>),
  Nil,
}

// Returns a generic enum from a generic function: subst descends into Opt<T>.
fn wrap<T>(x: T): Opt<T> {
  return Opt.Some(x)
}

fn unwrapOr(o: Opt<i64>, d: i64): i64 {
  match (o) {
    Some(v) => { return v }
    None => { return d }
  }
  return d
}

// Infers T from a nested generic-class argument (unify descends into Pair<T>).
fn firstOf<T>(p: Pair<T>): T {
  return p.a.val
}

fn sumList(xs: List<i64>): i64 {
  match (xs) {
    Cons(h, t) => { return h + sumList(t) }
    Nil => { return 0 }
  }
  return 0
}

fn main() {
  print("${unwrapOr(wrap(41), -1)}\n")
  print("${unwrapOr(Opt.None, 7)}\n")

  let p = Pair<i64>{ a: Box<i64>{ val: 7 }, b: 9 }
  print("${firstOf(p)} ${p.b}\n")

  let q = Pair<string>{ a: Box<string>{ val: "hi" }, b: "yo" }
  print("${firstOf(q)} ${q.b}\n")

  let xs: List<i64> = List.Cons(1, List.Cons(2, List.Cons(3, List.Nil)))
  print("${sumList(xs)}\n")
}
