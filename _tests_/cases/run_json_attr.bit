// run
// SPEC §10.5, #3976: `@json` on a class synthesises `toJson(): Json` from the
// class's own fields, in declaration order. The key is the FIELD NAME EXACTLY
// AS WRITTEN -- no case conversion, so the class and the payload read the same
// and nobody translates between two spellings while debugging -- unless
// `@key("...")` overrides it for an API that demands otherwise.
//
// One field of every shape `@json` accepts: an i64, a string, a bool, an f64,
// a `[]string`, an `Option<string>` that is set, an `Option<string>` that is
// ABSENT, a `@key`-renamed field, a nested `@json` class, a `[]T` of nested
// `@json` classes, and a `map<string, T>`.
//
// THE ABSENT OPTION EMITS `null`, IT IS NOT OMITTED. A missing key and an
// explicit null are different to a client, and choosing silently between them
// is how clients break -- `"absent":null` in the expected output below is the
// whole point of that rule and would still pass if the key were dropped, so it
// is asserted by an EXACT string comparison rather than by eyeballing.
//
// `Json` is a value, not text: the synthesised member appends into one growable
// `[]JsonEntry` and `jsonEncode` renders it into one `[]byte`. Nothing here
// concatenates strings.
import { Json, JsonEntry, jsonEncode } from "std/json"

@json class Addr {
  city: string,
  zip: i32,
}

@json class User {
  id: i64
  name: string
  active: bool
  ratio: f64
  tags: []string
  nick: Option<string>
  absent: Option<string>
  @key("created_at")
  createdAt: string
  addr: Addr
  places: []Addr
  meta: map<string, i64>
}

fn main() {
  let u = User{
    id: 7,
    name: "ada",
    active: true,
    ratio: 0.5,
    tags: ["a", "b"],
    nick: Option<string>.Some("mango"),
    absent: Option<string>.None,
    createdAt: "2026-01-01",
    addr: Addr{ city: "cairo", zip: 11511 },
    places: [Addr{ city: "giza", zip: 1 }, Addr{ city: "luxor", zip: 2 }],
    meta: map<string, i64>{ "hits": 3 },
  }
  let got = jsonEncode(u.toJson())
  let want = "{\"id\":7,\"name\":\"ada\",\"active\":true,\"ratio\":0.5," +
    "\"tags\":[\"a\",\"b\"],\"nick\":\"mango\",\"absent\":null," +
    "\"created_at\":\"2026-01-01\",\"addr\":{\"city\":\"cairo\",\"zip\":11511}," +
    "\"places\":[{\"city\":\"giza\",\"zip\":1},{\"city\":\"luxor\",\"zip\":2}]," +
    "\"meta\":{\"hits\":3}}"
  print("${got}\n")
  print("exact=${got == want}\n")
  // The nested class's own synthesised member, called directly: `@json` is not
  // a whole-object trick, every marked class gets a real member of its own.
  print("${jsonEncode(Addr{ city: "aswan", zip: 9 }.toJson())}\n")
}
