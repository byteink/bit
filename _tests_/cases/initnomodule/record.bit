// Support module for init_seal_negative_control.bit (#3371): a class
// declaring NO 'init', imported from a different module than the one
// building its composite literal. Not a case itself — golden.bit's corpus
// walk only reads names ending in '.bit' DIRECTLY inside _tests_/cases/, so
// this nested file is invisible to the census.
export class PlainRecord {
  n: i64,
}
