// panic
// #4512: the ONE-result form with an interface target panics on a miss, like
// the class-target form (SPEC §14.4, §18.4) and with the same exit 2 —
// `bit_rt_panic`, reached from the lowered null test rather than from
// `bit_rt_iface_assert`, which compares against a single descriptor and so
// cannot answer a method-set question.
//
// The message cannot name the dynamic type the way panic_type_assert.bit's
// does: this check reads the method table, so there is no target descriptor in
// hand whose name could be printed.
interface HttpError {
  message(): string,
  status(): int,
}

class Plain {
  msg: string
  export message(): string { return this.msg }
}

fn main() {
  let e: error = Plain{ msg: "plain" }
  let h = e.(HttpError)
  print("unreachable ${h.status()}\n")
}
