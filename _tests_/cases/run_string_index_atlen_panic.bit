// panic
// #4346, the boundary index: `s[len(s)]` must panic (SPEC §12.6, §18.4). The
// sibling `run_string_index_panic.bit` indexes well past the end, which an
// off-by-one bound (`i <= n` instead of `i < n`) still rejects. This is the
// index that separates the two, and it reads the byte immediately after the
// string's own bytes — in the same heap object, so it would not fault.
import { args } from "std/os"

fn two(): int { return len(args()) + 1 }

fn main() {
  let s = "ab"
  print("start\n")
  print("byte=${s[two()]}\n")
  print("unreachable\n")
}
