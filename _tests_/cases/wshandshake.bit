// run
// #3965: std/websocket, real client/server round trip over a loopback
// socket. Pins: the client handshake succeeding against a real server
// (Sec-WebSocket-Accept matched inside `dial`, or it fails), a text message
// and a binary message each round-tripping client-to-server and back
// server-to-client, all three RFC 6455 §5.2 payload-length encodings
// (7-bit at 10 bytes, 16-bit at 200 bytes, 64-bit at 70000 bytes), and the
// close protocol completing as a handshake — the server's `receive()` sees
// the client's close frame, answers with its own, and the client's own
// `close()` call (which waits for that answer) returns without error.
import { serve, Server } from "std/http"
import {
  upgrade,
  dial,
  defaultLimits,
  Conn,
  MessageText,
  MessageBinary,
  closeNormal,
} from "std/websocket"

fn checksum(data: []byte): int {
  let s = 0
  let i = 0
  while (i < len(data)) {
    s = s + int(data[i])
    i = i + 1
  }
  return s
}

fn makePattern(n: int): []byte {
  let out = []byte(n)
  let i = 0
  while (i < n) {
    out[i] = byte(i % 251)
    i = i + 1
  }
  return out
}

fn serverAccept(s: Server): Conn! {
  let ex = s.accept()?
  let req = ex.read()?
  return upgrade(ex, req, defaultLimits())?
}

fn serverEchoOne(wsConn: Conn): bool {
  let msg = wsConn.receive() catch _ {
    return false
  }
  if (msg.kind == MessageText) {
    wsConn.sendText(msg.data) catch _ {
      return false
    }
    return true
  }
  if (msg.kind == MessageBinary) {
    wsConn.sendBinary([]byte(msg.data)) catch _ {
      return false
    }
    return true
  }
  print("serverCloseCode=${msg.code}\n")
  print("serverCloseReason=${msg.data}\n")
  return false
}

fn serverLoop(s: Server, ready: chan<int>) {
  ready <- 0
  let wsConn = serverAccept(s) catch _ {
    return
  }
  while (serverEchoOne(wsConn)) {}
}

fn roundTripBinary(c: Conn, n: int, label: string): bool {
  let payload = makePattern(n)
  c.sendBinary(payload) catch _ {
    print("${label}SendErr\n")
    return false
  }
  let m = c.receive() catch _ {
    print("${label}RecvErr\n")
    return false
  }
  let got = []byte(m.data)
  print("${label}Kind=${m.kind == MessageBinary}\n")
  print("${label}Len=${len(got) == n}\n")
  print("${label}Sum=${checksum(got) == checksum(payload)}\n")
  return true
}

fn main() {
  let s = serve("127.0.0.1", 0) catch _ {
    print("serveFailed\n")
    return
  }
  let port = s.port() catch _ {
    print("portFailed\n")
    return
  }
  let ready = chan<int>(1)
  spawn serverLoop(s, ready)
  let _ = <- ready

  let c = dial("127.0.0.1", port, "/chat", defaultLimits()) catch _ {
    print("dialFailed\n")
    return
  }

  c.sendText("hello") catch _ {
    print("sendTextErr\n")
    return
  }
  let m1 = c.receive() catch _ {
    print("recvTextErr\n")
    return
  }
  print("textKind=${m1.kind == MessageText}\n")
  print("textEcho=${m1.data}\n")

  let _ = roundTripBinary(c, 10, "bin7")
  let _ = roundTripBinary(c, 200, "bin16")
  let _ = roundTripBinary(c, 70000, "bin64")

  c.close(closeNormal, "bye") catch _ {
    print("clientCloseErr\n")
    return
  }
  print("clientClosed=true\n")
}
