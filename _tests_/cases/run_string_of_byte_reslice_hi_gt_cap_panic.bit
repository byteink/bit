// panic
// #6558: `string(b[lo:hi])` with `hi` past the receiver's capacity (here its
// length: a `[]byte(s)` conversion allocates exactly `len(s)`) panics with
// the text `b[lo:hi]` itself panics with (run_slice_range_panic.bit).
import { args } from "std/os"

fn hi(): int { return len(args()) + 8 }

fn main() {
  let b = []byte("hello")
  print("start\n")
  let s = string(b[0:hi()])
  print("survived ${s}\n")
}
