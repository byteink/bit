// run
// #4646: the RUNS side of the transitive-bound rule, whose error side is
// _tests_/cases/check_generic_transitive_bound.bit.
//
// A generic body's call to a BOUNDED generic is now judged once per
// instantiation of the enclosing generic, at the enclosing call's own span.
// Every way of NOT reaching that diagnostic is here, and if the rule widened by
// one clause none of this would compile:
//
//   - explicit type arguments supply what an empty variadic slot could not,
//   - arguments that bind the element type to a type satisfying the bound,
//   - an EMPTY interface bound, which `()` does satisfy,
//   - an inner generic with NO bound, which promises nothing at any argument,
//   - an inner call whose type argument is already CONCRETE in the template, so
//     E0051 on the body sweep already judged it and a second report would
//     duplicate,
//   - a bound satisfied through only one of two type parameters.
interface Named {
  label(): string,
}

interface Anything {}

class Tag {
  export label(): string {
    return "tag"
  }
}

fn inner<T: Named>(v: T): string {
  return v.label()
}

fn anyone<T: Anything>(v: T): int {
  return 1
}

fn plain<T>(v: T): int {
  return 2
}

fn empty<T>(...xs: T): string {
  for x of xs {
    return inner(x)
  }
  return "none"
}

fn forward<T>(v: T): string {
  return inner(v)
}

fn viaAnything<T>(...xs: T): int {
  for x of xs {
    return anyone(x)
  }
  return anyone(Tag{})
}

fn viaUnbound<T>(...xs: T): int {
  for x of xs {
    return plain(x)
  }
  return 3
}

fn pinned<T>(v: T): string {
  return inner(Tag{}) + inner<Tag>(Tag{})
}

fn twoParams<K, V: Named>(k: K, v: V): string {
  return inner(v)
}

fn main() {
  print("${empty<Tag>()}\n")
  print("${empty(Tag{}, Tag{})}\n")
  print("${forward(Tag{})}\n")
  print("${viaAnything()} ${viaAnything(Tag{})}\n")
  print("${viaUnbound()} ${viaUnbound(Tag{})} ${viaUnbound(1, 2)}\n")
  print("${pinned(7)}\n")
  print("${twoParams(1, Tag{})}\n")
}
