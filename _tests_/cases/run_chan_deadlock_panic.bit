// panic
// #2530: sending on a nil channel blocks forever by design (SPEC §16.2,
// #2503, #2505) -- that block is correct and not what this case is about.
// The defect this covers is that nothing in the runtime ever asked "can any
// task in this process still make progress": a nil send parks `main` and
// there is no timer, no netpoller registration and (the default single
// worker) no other worker that could ever wake it, so the scheduler must
// detect that and panic, matching Go's `fatal error: all goroutines are
// asleep - deadlock!` rather than spinning the idle loop forever.
fn main() {
  let c: chan<int> = nil
  print("start\n")
  c <- 1
  print("unreachable\n")
}
