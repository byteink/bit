// run
// #6290 (`.claude/kb/data-packages-dx.md` "Approved 2026-09-29"): before this
// ticket, `Post`'s `@belongsTo author: Author` disabled `__fromRow`
// synthesis (`canFromRow` false, compiler/classtablerow.bit's
// `tableRowCanFromRow`), so `Post` did NOT satisfy `interface Tabled` and
// `db.table<Post>()` was a compile error. This is the same shape
// run_table_static_members.bit already pins for a relation-free class,
// proven here for a class carrying a singular relation field instead:
// `describe<T: Tabled>()` (the generic bound `db.table<T>()` itself needs)
// accepts `Post`, and `Post.__fromRow` decodes a row while leaving `author`
// unloaded -- assigning it directly afterward (never through `.with()`,
// which is pkg/orm's, not the compiler's) proves the field is ordinarily
// readable once loaded.
import { FieldDesc, AttrDesc, Rows, Value } from "std/sql"

interface Tabled {
  static __tableName(): string,
  static __columns(): []FieldDesc,
}

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  title: string
  @belongsTo("authorId")
  author: Author
}

fn describe<T: Tabled>(): string {
  return T.__tableName()
}

// A canned single-row result set: `cols`/`row` fixed at construction.
class fakeRows {
  cols: []string
  row: []Value
  done: bool = false
  next(): bool! {
    if (this.done) {
      return false
    }
    this.done = true
    return true
  }

  columns(): []string {
    return this.cols
  }

  value(col: int): Value {
    return this.row[col]
  }

  close() {}
}

fn main() {
  print("${describe<Author>()}\n")
  print("${describe<Post>()}\n")

  // "author_id", never "authorId": pkg/orm/naming.bit's column rule
  // snake_cases every Bit field name that carries no `@column` override.
  let rows = fakeRows{
    cols = ["id", "author_id", "title"],
    row = [Value.Int(1), Value.Int(7), Value.Text("hello")],
  }
  let post = Post.__fromRow(rows) catch e {
    panic("__fromRow: ${e.message()}")
  }
  print("decoded: id=${post.id} authorId=${post.authorId} title=${post.title}\n")

  post.author = Author{ id = 7, name = "Ada" }
  print("author: ${post.author.name}\n")
}
