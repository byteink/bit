// run
// #2301: golden case for std/rand. The load-bearing property is reproducibility
// - two `Rand`s built from the same seed must produce an identical sequence,
// which is what lets a failing randomized test print its seed and be replayed
// exactly. This also pins that `intn(n)` never returns outside [0, n) over a
// bounded sweep, and that `shuffle` under a fixed seed is itself deterministic.
//
// Single-file golden: no prelude.
import { newRand } from "std/rand"

fn showInts(xs: []int): string {
  let s = "["
  let i = 0
  while (i < len(xs)) {
    if (i > 0) {
      s = s + " "
    }
    s = s + "${xs[i]}"
    i = i + 1
  }
  return s + "]"
}

// Same seed must produce an identical intn() sequence, forever.
fn sameSeedSequence() {
  let a = newRand(1)
  let b = newRand(1)
  let mismatches = 0
  let i = 0
  while (i < 20) {
    let av = a.intn(1000)
    let bv = b.intn(1000)
    if (av != bv) {
      mismatches = mismatches + 1
    }
    i = i + 1
  }
  println("1: mismatches=${mismatches}")
}

// intn(n) must never return outside [0, n), swept over many draws and many
// values of n.
fn intnInRange() {
  let r = newRand(2)
  let violations = 0
  let n = 1
  while (n <= 50) {
    let i = 0
    while (i < 2000) {
      let v = r.intn(n)
      if (v < 0 || v >= n) {
        violations = violations + 1
      }
      i = i + 1
    }
    n = n + 1
  }
  println("2: violations=${violations}")
}

// Same seed must produce an identical shuffle() output.
fn sameSeedShuffle() {
  let s1 = newRand(3)
  let s2 = newRand(3)
  let xs1 = []int(8)
  let xs2 = []int(8)
  let i = 0
  while (i < 8) {
    xs1[i] = i
    xs2[i] = i
    i = i + 1
  }
  s1.shuffle(xs1)
  s2.shuffle(xs2)
  println("3a: ${showInts(xs1)}")
  println("3b: ${showInts(xs2)}")
}

fn main() {
  sameSeedSequence()
  intnInRange()
  sameSeedShuffle()
}
