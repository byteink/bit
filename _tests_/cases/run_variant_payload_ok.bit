// run
// The ACCEPT half of #4487, whose REJECT half is the checkercase
// check_variant_payload_type.bit. Every `Enum.Variant(args)` payload argument
// now goes through `vExpectExpr` (compiler/validatevariant.bit); this is the
// set of legal payload constructions that rule must NOT redden:
//
//   - an untyped INT constant into a NARROWER int payload (`Small(7)` for
//     i32) and into a float payload (`Floaty.Num(1)`) -- `vExpectExpr` reaches
//     `vAssignableNode`, which range-checks the literal against the target.
//     Comparing the constant's DEFAULT type (i64) instead rejects both.
//   - an untyped FLOAT constant into an f32 payload.
//   - a `const` expression over untyped literals into a sized payload.
//   - a bare slice literal (`Sl([1, 2, 3])` for a `[]i32` payload), whose
//     elements need the expectation pushed down: judged whole it infers
//     `[]i64` and is rejected.
//   - a class into an INTERFACE payload, an interface-typed value into one,
//     and `nil` into one -- an interface is a reference type, so `nil` is its
//     zero value. `nil` into a CLASS payload is NOT legal and is the fourth
//     case in the checkercase: it is E0041 in every other position on main
//     (`let a: Circle = nil`, `take(nil)`, `Outer{ i: nil }`), and the payload
//     was the one place it was accepted.
//   - a nested enum value as a payload, and a payload-free variant as one.
//   - a generic enum's payload, both explicitly instantiated and reached
//     through an OPEN type parameter inside a generic function -- the latter
//     is a TypeParam the rule must skip rather than judge.
//
// The `open-f64`/`open-f32` lines are #4509's pin. The declared payload of
// `Hold<T>.Only` is the ENUM's `T`, which the instantiation env (keyed by
// `wrapAny`'s own `T`) cannot bind, so the write type came from the argument --
// itself a bare TypeParam until it is substituted. A TypeParam does not
// classify as `RegClass.Float`, so the float payload was stored through the
// integer path and read back as 0, while the i64 `open` line was correct.
//
// The `hole` line is GONE, and where it went matters. It pinned that
// `Hold.Only(hn)` with `hn: i64` into a `Hold<f64>` binding still COMPILED --
// a checker hole (`sameNominalDecl` ignored type arguments, so `Hold<i64>` was
// assignable to `Hold<f64>`) whose payload read back as a denormal, so its
// value was deliberately not printed. #4562 closed the hole: that program is
// `error[E0041]: expected 'Hold<f64>', found 'Hold<i64>'` now, which no `// run`
// case can hold. It is `_tests_/bit/checkercases/check_generic_type_args.bit`,
// alongside the argument, return and class-field spellings of the same
// mistake.
//
// What the line USED to catch was #4519's first shape, where the expected type
// was taken for a TYPED argument too and `bit build` panicked (`panic:
// assertion failed`, rc=2) on a program `bit check` accepted. That shape is no
// longer constructible from here: the checker rejects the only program that
// reached it, so the `isUntyped` guard in `variantSlotTy` is now guarding a
// path the front end closes first. The `const-*` and `annot-f64` lines below
// still pin the guard's ACCEPT half.
//
// The `const-*`/`annot-f64` lines are #4519's pin, and they are NOT generic-only.
// `Hold.Only(7)` names no type argument, so the checker infers the enum's own
// `T` from the ARGUMENT -- an untyped int, defaulted to i64 -- and mints
// `Hold<i64>` however the context is written. `nodeType` on the callee answers
// the bare TEMPLATE, whose declared payload is a TypeParam, so the write fell
// back to that i64 while the match arm read the slot at f64. Measured on
// b9393c69 both inside a generic body (`wrapConst<f64>()`) and in plain `main`
// (`let ann: Hold<f64> = Hold.Only(7)`): both printed a denormal, exit 0. The
// fix threads `lowerExprH`'s hint -- the DECLARED type, #4494's rule -- through
// `lowerCall` into `lowerVariantConstruction`. `Hold<f64>.Only(7)` spelled out
// was correct all along, which is the control the `hold` line already pins.
//
// The float-payload constructions are split into `Floaty`, whose arms read the
// payload back and print it: that is #4494's pin. Before #4494 the payload word
// was written at the ARGUMENT's type rather than the variant's DECLARED one, so
// an untyped constant landed there unconverted -- `Floaty.Num(1)` read back as
// a denormal near zero and `Floaty.Narrow(0.5)` as 0, while `let x: f64 = 1`
// was already correct. Both halves of the mismatch are here: int constant into
// an f64 payload (`Num(1)`), float constant into a narrower f32 payload
// (`Narrow(0.5)`, and `Many`'s second word both ways).
interface Shape {
  area(): f64,
}

class Circle {
  r: f64
  area(): f64 {
    return this.r * this.r
  }
}

enum Inner {
  A(i32),
  B,
}

enum Outer {
  Wrap(Inner),
  Small(i32),
  Str(string),
  Sl([]i32),
  Sh(Shape),
  Exact(f64),
}

enum Floaty {
  Num(f64),
  Narrow(f32),
  Many(i64, f32),
  Plain,
}

enum Hold<T> {
  Only(T),
  Empty,
}

const wide: i32 = 2 + 3

fn wrapAny<T>(v: T): Hold<T> {
  return Hold.Only(v)
}

fn wrapConst<T>(): Hold<T> {
  return Hold.Only(7)
}

fn describe(o: Outer): string {
  match (o) {
    Wrap(i) => {
      match (i) {
        A(n) => return "wrap-a ${n}"
        B => return "wrap-b"
      }
    }
    Small(n) => return "small ${n}"
    Str(s) => return "str ${s}"
    Sl(xs) => return "sl ${len(xs)} ${xs[2]}"
    Sh(s) => return "sh ${s.area()}"
    Exact(f) => return "exact ${f}"
  }
}

fn nilTag(o: Outer): string {
  match (o) {
    Sh(s) => return "sh-nil ${s == nil}"
    _ => return "other"
  }
}

fn floatyTag(f: Floaty): string {
  match (f) {
    Num(v) => return "num ${v}"
    Narrow(v) => return "narrow ${v}"
    Many(n, v) => return "many ${n} ${v}"
    Plain => return "plain"
  }
}

fn main() {
  print(describe(Outer.Small(7)) + "\n")
  print(describe(Outer.Small(wide)) + "\n")
  print(describe(Outer.Str("hi")) + "\n")
  print(describe(Outer.Sl([1, 2, 3])) + "\n")
  print(describe(Outer.Sh(Circle{ r: 3.0 })) + "\n")
  print(describe(Outer.Wrap(Inner.A(8))) + "\n")
  print(describe(Outer.Wrap(Inner.B)) + "\n")
  let k: f64 = 9.0
  print(describe(Outer.Exact(k)) + "\n")
  let s: Shape = Circle{ r: 2.0 }
  print(describe(Outer.Sh(s)) + "\n")
  print(nilTag(Outer.Sh(nil)) + "\n")
  print(floatyTag(Floaty.Num(1)) + "\n")
  print(floatyTag(Floaty.Num(1.5)) + "\n")
  print(floatyTag(Floaty.Narrow(0.5)) + "\n")
  print(floatyTag(Floaty.Many(4, 2.5)) + "\n")
  print(floatyTag(Floaty.Many(5, 6)) + "\n")
  print(floatyTag(Floaty.Plain) + "\n")
  match (Hold<i64>.Only(11)) {
    Only(v) => print("hold ${v}\n")
    Empty => print("hold empty\n")
  }
  match (wrapAny(12)) {
    Only(v) => print("open ${v}\n")
    Empty => print("open empty\n")
  }
  let od: f64 = 2.5
  match (wrapAny(od)) {
    Only(v) => print("open-f64 ${v}\n")
    Empty => print("open empty\n")
  }
  let ofl: f32 = 1.5
  match (wrapAny(ofl)) {
    Only(v) => print("open-f32 ${v}\n")
    Empty => print("open empty\n")
  }
  match (wrapConst<f64>()) {
    Only(v) => print("const-f64 ${v}\n")
    Empty => print("const empty\n")
  }
  match (wrapConst<f32>()) {
    Only(v) => print("const-f32 ${v}\n")
    Empty => print("const empty\n")
  }
  match (wrapConst<i64>()) {
    Only(v) => print("const-i64 ${v}\n")
    Empty => print("const empty\n")
  }
  let ann: Hold<f64> = Hold.Only(7)
  match (ann) {
    Only(v) => print("annot-f64 ${v}\n")
    Empty => print("annot empty\n")
  }
}
