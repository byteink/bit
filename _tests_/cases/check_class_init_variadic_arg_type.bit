// error
// #4663: a class constructor's variadic slot was never type-checked.
// `vClassConstructCall` (compiler/classinit.bit) judged the FIXED prefix only
// — `while (i < fixed)`, and `fixed` is `want - 1` for a variadic `init` — so
// every argument landing in the rest slot, and a `...` spread among them, was
// skipped: `Foo("a")` and `Foo(...s)` into `init(...args: i64)` both checked
// and ran rc=0, and an `args[0]` used as a number read the string's own
// pointer. `vClassConstructArity` counted those arguments and looked at no
// type. #4655 closed the same hole for a free function, #4661 for a method.
//
// The construction call is now described to `vCallArgTypes` (the free path's
// own loop) as the `CallDecl` a free call builds, so the parameter index
// clamps at the rest parameter's and a spread is judged against `[]P` for its
// element type P (SPEC §12.4) — one rule, not a third copy of it.
//
// `run_class_init_variadic_arity.bit` and `run_method_variadic_init.bit` are
// the no-false-positive half: a variadic `init` called at arity 0, 1, 2 and
// through a legal spread still runs unchanged.
class Foo {
  n: int
  init(...args: i64) {
    this.n = len(args)
  }
}

class Tagged {
  n: int
  init(label: string, ...args: i64) {
    this.n = len(label) + len(args)
  }
}

fn main() {
  let s = "abc"
  let g = Foo("a")
  let h = Foo(...s)
  let t = Tagged(7, 1, 2)
  print("${g.n} ${h.n} ${t.n}\n")
}
