// error
// A unary expression's span must cover its OPERATOR, not just its operand.
//
// The self-hosted parser built its Unary node with `mkNode`, which derives a
// span from the child nodes alone — and the operator is a token, not a child, so
// it was dropped. Diagnostics underlined `p` instead of `*p`, one column short
// and one caret narrow, on every prefix operator. The seed joins the operator
// token's own span, so the two compilers disagreed.
//
// This is a DIFF-class divergence: both compilers report the same code with the
// same message, so a self-hosted-vs-seed check that only watches for missing or
// spurious diagnostics never sees it. Only a golden that pins the exact underline
// catches it — hence this case. Every prefix operator is listed because the bug
// was in the shared node construction, not in any one operator's path.
fn deref(p: *i64): string {
  return *p
}

fn negate(x: i64): string {
  return -x
}

fn plus(x: i64): string {
  return +x
}

fn complement(x: i64): string {
  return ~x
}

fn notted(b: bool): string {
  return !b
}

fn receive(c: chan<i64>): string {
  return <- c
}
