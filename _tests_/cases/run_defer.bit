// run
// defer runs its calls LIFO as the function returns; args are captured when the
// defer executes. Covers the `print` builtin (regression: defer used to reject
// builtins, which never went through resolveCallTarget) and a user function.
fn note(s: string) {
  print(s)
}
fn main() {
  let n = 1
  defer print("end n=${n}\n")
  note("start\n")
  n = 2
  defer note("cleanup\n")
  print("work n=${n}\n")
}
