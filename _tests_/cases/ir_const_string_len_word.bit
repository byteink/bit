// ir
// #6459: a string passed to a callee taking `string` is exploded at the call
// into its `ptr` word (`field_get [0]`), its `len` word (`field_get [8]`) and
// the value itself. The `len` word of a value that only ever holds one string
// literal is that literal's byte count (`markConstStringLens`,
// compiler/optparams.bit), so the call takes a `const_int` instead of a load
// from the header on every trip round the loop.
//
//   `oneLiteral`   the literal is written at the call: its `len` is 5.
//   `threaded`     the literal is a local threaded through the loop header
//                  as a block param that only ever holds it: its `len` is 5
//                  too, and the `ptr` word is read off a copy of the literal
//                  (`emitStaticHeaderRead`, compiler/optrebuild.bit).
//   `twoLiterals`  `key` holds one of TWO literals, so it is not a constant:
//                  both words are still read off the param.

fn count(s: string, c: u8): int {
  let n = 0
  let i = 0
  while (i < len(s)) {
    if (s[i] == c) {
      n = n + 1
    }
    i = i + 1
  }
  return n
}

fn oneLiteral(k: int): int {
  let n = 0
  let i = 0
  while (i < k) {
    n = n + count("hello", 108)
    i = i + 1
  }
  return n
}

fn threaded(k: int): int {
  let key = "world"
  let n = 0
  let i = 0
  while (i < k) {
    n = n + count(key, 111)
    i = i + 1
  }
  return n
}

fn twoLiterals(k: int, flag: bool): int {
  let key = "ab"
  if (flag) {
    key = "xyz"
  }
  let n = 0
  let i = 0
  while (i < k) {
    n = n + count(key, 97)
    i = i + 1
  }
  return n
}
