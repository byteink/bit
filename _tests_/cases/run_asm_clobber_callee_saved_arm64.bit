// run
// SPEC 11.6 / #7399: an `asm` block that names a callee-saved register in
// `clobber arm64` (or pins it as `input`/`result`) takes it out of allocation
// (`reserveAsmArm64`, compiler/arm64dispatch.bit), but the prologue's saved list
// only walked ALLOCATED registers, so the write destroyed the caller's value:
// `run` keeps a..d live in callee-saved registers across the call to `clob`, and
// this printed a wrong value (or died with a segfault at exit) on aarch64 before
// the fix. The x86_64 twin is run_asm_pin_callee_saved (#6197).
//
// The `while` loop keeps `clob` too big to inline into `run`, so the corruption
// shows in the caller's own frame across the call.
fn clob(v: int): int {
  let t = v
  let k = 0
  while (k < v % 3) {
    t = t + 1
    k = k + 1
  }
  return asm {
    arm64 { 0xAA0103F3, 0xAA1303E0 } // mov x19, x1; mov x0, x19
    x64 { 0x48, 0x89, 0xF0 } // mov rax, rsi
    result arm64 x0 x64 rax : int
    input arm64 x1 x64 rsi = t - k
    clobber arm64 { x19 }
  }
}

fn run(a: int, b: int, c: int, d: int): int {
  let r = clob(7)
  return a * 1000 + b * 100 + c * 10 + d + r * 0
}

fn main() {
  print("${run(1, 2, 3, 4)}\n")
}
