// run
// #3839: named arguments evaluate in WRITTEN order, then place into DECLARED
// order (SPEC §12.11). `f(b = g(), a = h())` writes `b` before `a`, so `g()`
// must run before `h()` even though `a` is the FIRST declared parameter --
// naively lowering into declared-order slots would run `h()` first, silently
// reversing the source's side-effect order.
fn g(): int {
  print("g\n")
  return 1
}

fn h(): int {
  print("h\n")
  return 2
}

fn f(a: int, b: int) {
  print("a=${a} b=${b}\n")
}

fn main() {
  f(b = g(), a = h())
}
