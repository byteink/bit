// run
// #2263: signed division of a sub-64-bit type did not narrow its result.
// INT_MIN / -1 is the one operand pair where the 64-bit and N-bit quotients
// differ — operands live sign-extended in full 64-bit registers, so the
// 64-bit idiv/sdiv itself never overflows; it just leaves a result outside
// the declared i32 width (2147483648) unless the backend re-narrows the
// quotient like every other width-breaking op (add/sub/mul/neg/bnot already
// do this, #1158).
fn main() {
  let mn: i32 = i32(-2147483648)
  let q: i32 = mn / i32(-1)
  println("${q}")
  println("${q == mn}")
  println("${q > i32(0)}")
}
