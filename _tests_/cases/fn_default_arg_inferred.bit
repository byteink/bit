// run
// #5258: the inferred spelling `x = 1` (SPEC §10.3) -- no written type, the
// parameter takes the type its default infers to under the same
// untyped-constant defaulting `let x = 5` and `Option.Some(5)` already use
// (§15.4): int -> i64, float -> f64, string -> string, bool -> bool.

fn foo(x = 1): int {
  return x * 2
}

// f64 inference is proven by the `* 2.0` type-checking at all: an
// untyped/invalid inferred type would fail this arithmetic at compile time.
fn scale(n = 1.5): bool {
  return n * 2.0 == 3.0
}

fn tag(name = "a"): string {
  return name + name
}

fn shout(loud = false): string {
  if (loud) {
    return "LOUD"
  }
  return "quiet"
}

fn main() {
  print("${foo()}\n")
  print("${foo(3)}\n")
  print("${scale()}\n")
  print("${tag()}\n")
  print("${shout()}\n")
  print("${shout(true)}\n")
}
