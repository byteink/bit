// ir
// #6679: a `match` expression in a generic function types its join block param
// from the instance being lowered, not from the previous instance of the
// template. `lowerMatchExpr` (lowermatch.bit) reads the match's type off the
// first arm body's binder, whose `declTypes` entry an earlier instance had
// rebound; `pick<Node>` got `i64`'s, and a reference sat in a block param typed
// `i64`, which no stack map lists. Each instance's `bb3` param must be its own
// `T`: `i64`, `Node`, `u8`, `[]i64`.
class Node {
  id: i64,
}

fn pick<T>(o: Option<T>, d: T): T {
  return match (o) {
    Some(v) => v
    None => d
  }
}

fn main() {
  let a: Option<i64> = Option.Some(1)
  let b: Option<Node> = Option.Some(Node{ id = 2 })
  let c: Option<u8> = Option.Some(u8(3))
  let e: Option<[]i64> = Option.Some([4])
  println("${pick(a, 0)}")
  println("${pick(b, Node{ id = 0 }).id}")
  println("${pick(c, u8(0))}")
  println("${len(pick(e, []i64(0)))}")
}
