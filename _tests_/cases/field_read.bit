// run
// #7110, epic #6984: a program that declares an interface with a `__field`
// method gets `__field(name): Option<Json>` on every non-generic class with an
// exported field, read by name without `@json` and without a `toJson` walk.
// Strings, integers, floats, bools, payload-free enums (the variant name) and
// lists of those resolve; an unexported field, a nested class, an `Option` field
// and an unknown name are None.
import { Json } from "std/json"

interface Readable {
  id: string,
  __field(name: string): Option<Json>,
}

enum Level { Junior, Senior }

class Inner {
  export city: string,
}

class User {
  export id: string,
  export team: string,
  export age: int,
  export score: f64,
  export active: bool,
  export level: Level,
  export tags: []string,
  export home: Inner,
  export boss: Option<string>,
  secret: string,
}

fn show(r: Readable, name: string): string {
  return match (r.__field(name)) {
    Some(j) => describe(j)
    None => "none"
  }
}

fn describe(j: Json): string {
  return match (j) {
    JsonString(s) => "str ${s}"
    JsonInt(i) => "int ${i}"
    JsonFloat(f) => "float ${f}"
    JsonBool(b) => "bool ${b}"
    JsonArray(xs) => "list ${len(xs)}"
    _ => "other"
  }
}

fn main() {
  let u = User{
    id = "u1", team = "sport", age = 41, score = 2.5, active = true, level = Level.Senior,
    tags = ["a", "b"], home = Inner{ city = "Oslo" }, boss = Option<string>.None, secret = "s",
  }
  for name of [
    "id",
    "team",
    "age",
    "score",
    "active",
    "level",
    "tags",
    "home",
    "boss",
    "secret",
    "nope",
  ] {
    println("${name}: ${show(u, name)}")
  }
}
