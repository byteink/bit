// run
// #4504: `?` (E0061) and `fail` (E0060) were refused inside ANY arrow body,
// and an EXPRESSION-bodied arrow whose expression was not itself fallible was
// E0041 against a fallible expected type. So a closure could HAVE a fallible
// function type and forward a failure, but could not use either operator SPEC
// §18.3 gives for producing or propagating one — pkg/web's every one-line
// handler had to be spelled around it.
//
// `vArrow` (compiler/validatecall.bit) restarted the fallible context at 0 for
// every arrow, which `vFail`/`vTryExpr` read to raise E0060/E0061; it now
// passes the arrow's own fallible expected result through. `checkArrowFnAt`
// (compiler/checkexpr.bit) now wraps a non-fallible expression body as the
// expected type's OK value, the same thing `return v` does in the block form.
//
// The first three rows are the three faults. `fwdExpr`/`fwdBlk` are the two
// shapes that ALREADY worked and are the regression guard for the lowering
// half: a closure now carries a real ok/err pair (lowerfuncval.bit), which
// turns on lowerfunc.bit's ok-path `clearErr` — and clearing on a `return`
// that is FORWARDING a fallible value deletes the very failure it forwards.
// `retClearsErr` is what keeps those two rows printing their message.
//
// A single-file golden gets NO prelude, so `newError` (stdlib/core) is
// unavailable and the error type is declared locally, as
// run_catch_bind_message.bit does for the same reason.
class Neg {
  n: i64
  message(): string { return "negative (${this.n})" }
}

class Box {
  v: i64,
}

type F = (i64) => i64!
type V = (i64) => ()!
type B = (i64) => Box!

fn boom(n: i64): i64! {
  if (n < 0) {
    fail Neg{ n: n }
  }
  return n
}

fn main() {
  let tryArrow: F = (n) => {
    return boom(n)?
  }
  let failArrow: F = (n) => {
    if (n < 0) {
      fail Neg{ n: n }
    }
    return n
  }
  let wrap: F = (n) => n
  let fwdExpr: F = (n) => boom(n)
  let fwdBlk: F = (n) => {
    return boom(n)
  }
  let voidArrow: V = (n) => {
    if (n < 0) {
      fail Neg{ n: n }
    }
  }
  let boxArrow: B = (n) => {
    if (n < 0) {
      fail Neg{ n: n }
    }
    return Box{ v: n }
  }
  let a = tryArrow(-1) catch e {
    print("tryArrow: ${e.message()}\n")
    0
  }
  print("a=${a}\n")
  let b = failArrow(-2) catch e {
    print("failArrow: ${e.message()}\n")
    0
  }
  print("b=${b}\n")
  let c = fwdExpr(-3) catch e {
    print("fwdExpr: ${e.message()}\n")
    0
  }
  print("c=${c}\n")
  let d = fwdBlk(-4) catch e {
    print("fwdBlk: ${e.message()}\n")
    0
  }
  print("d=${d}\n")
  voidArrow(-5) catch e {
    print("voidArrow: ${e.message()}\n")
  }
  let f = boxArrow(-6) catch e {
    print("boxArrow: ${e.message()}\n")
    Box{ v: 0 }
  }
  print("f=${f.v}\n")
  // The ok paths, each immediately after a failure of the same closure: the
  // error slot must be null again, or these take the catch branch instead.
  let g = tryArrow(7) catch e {
    print("BUG tryArrow ok path took the error branch\n")
    -1
  }
  print("g=${g}\n")
  let h = failArrow(8) catch e {
    print("BUG failArrow ok path took the error branch\n")
    -1
  }
  print("h=${h}\n")
  let i = wrap(9) catch e {
    print("BUG wrap took the error branch\n")
    -1
  }
  print("i=${i}\n")
  voidArrow(10) catch e {
    print("BUG voidArrow ok path took the error branch\n")
  }
  print("voidArrow ok\n")
  let j = boxArrow(11) catch e {
    print("BUG boxArrow ok path took the error branch\n")
    Box{ v: -1 }
  }
  print("j=${j.v}\n")
}
