// run
// SPEC §13.1: a C-style `for`'s init variables are declared afresh each
// iteration, so each closure keeps its own — `0 1 2`, NOT `3 3 3`. One cell per
// declaration site would have given the latter and quietly broken the commonest
// closure idiom there is; Go fixed exactly this in 1.22.
//
// The second loop pins the other half: the new cell is initialised from the
// previous iteration's value AT THE END OF THE BODY, so a body write is visible
// both to the closure that iteration made and to the post statement. `j = j + 10`
// therefore ends the loop after one pass, with that closure reading 10.
fn main() {
  let fs = []() => int(0)
  for (let i = 0; i < 3; i = i + 1) {
    fs = append(fs, () => i)
  }
  let gs = []() => int(0)
  for (let j = 0; j < 3; j = j + 1) {
    gs = append(gs, () => j)
    j = j + 10
  }
  print("${fs[0]()} ${fs[1]()} ${fs[2]()}\n")
  print("${len(gs)} ${gs[0]()}\n")
}
