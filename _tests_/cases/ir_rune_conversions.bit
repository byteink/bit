// ir
// #7101: each rune conversion is ONE runtime call and nothing else allocates:
// `string(r)` -> `string_from_rune`, `string(rs)` -> `string_from_runes`,
// `[]rune(s)` -> `runes_from_string`.
fn enc(r: rune): string {
  return string(r)
}

fn encAll(rs: []rune): string {
  return string(rs)
}

fn dec(): []rune {
  return []rune("é")
}
