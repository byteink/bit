// run
// #6566/#6597: a class-literal field initializer takes a bare `T` where the
// field is `Option<T>` (SPEC §14.2 implicit `Some`). Every value kind the
// payload word can hold: a scalar, a sized int, a float, a bool, a string, the
// two-word `decimal`, a class reference, a bare-tag enum, a payload-carrying
// enum and a tuple. `None` still spells `Option.None`, and a field left
// unwritten is still `None`. `bump()` counts its calls: the lifted value is
// evaluated exactly once.
enum Color { Red, Green, Blue }
enum Shape { Dot, Circle(int) }
class Pt { x: int, y: int }
class Rec {
  n: Option<int>,
  small: Option<i8>,
  f: Option<f64>,
  b: Option<bool>,
  s: Option<string>,
  d: Option<decimal>,
  p: Option<Pt>,
  c: Option<Color>,
  sh: Option<Shape>,
  t: Option<(int, string)>,
  none: Option<int>,
  unset: Option<string>,
  once: Option<int>,
}

class Cell<T> { v: Option<T> }

fn cellOf<T>(x: T): Cell<T> {
  return Cell<T>{ v = x }
}

let calls = 0

fn shapeText(s: Shape): string {
  match (s) {
    Circle(r) => { return "Circle ${r}" }
    Dot => { return "Dot" }
  }
  return "?"
}

fn bump(): int {
  calls = calls + 1
  return calls * 10
}

fn main() {
  let dec: decimal = 7.25
  let rec = Rec{
    n = 42,
    small = 7,
    f = 2.5,
    b = true,
    s = "hello",
    d = dec,
    p = Pt{ x = 3, y = 4 },
    c = Color.Blue,
    sh = Shape.Circle(9),
    t = (5, "five"),
    none = Option.None,
    once = bump(),
  }
  match (rec.n) {
    Some(v) => println("n=${v}")
    None => println("n none")
  }
  match (rec.small) {
    Some(v) => println("small=${v}")
    None => println("small none")
  }
  match (rec.f) {
    Some(v) => println("f=${v}")
    None => println("f none")
  }
  match (rec.b) {
    Some(v) => println("b=${v}")
    None => println("b none")
  }
  match (rec.s) {
    Some(v) => println("s=${v}")
    None => println("s none")
  }
  match (rec.d) {
    Some(v) => println("d=${v}")
    None => println("d none")
  }
  match (rec.p) {
    Some(v) => println("p=${v.x},${v.y}")
    None => println("p none")
  }
  match (rec.c) {
    Some(v) => println("c is Blue: ${v == Color.Blue}")
    None => println("c none")
  }
  match (rec.sh) {
    Some(v) => println("sh=${shapeText(v)}")
    None => println("sh none")
  }
  match (rec.t) {
    Some(v) => println("t=${v.0},${v.1}")
    None => println("t none")
  }
  match (rec.none) {
    Some(v) => println("none=${v}")
    None => println("none is None")
  }
  match (rec.unset) {
    Some(v) => println("unset=${v}")
    None => println("unset is None")
  }
  match (rec.once) {
    Some(v) => println("once=${v} calls=${calls}")
    None => println("once none")
  }
  match (cellOf<string>("generic").v) {
    Some(v) => println("cell=${v}")
    None => println("cell none")
  }
}
