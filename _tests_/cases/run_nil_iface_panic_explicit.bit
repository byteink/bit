// panic
// #2240: the sibling reach path to run_nil_iface_panic.bit -- `nil` is
// assignable to any interface (SPEC §14.3), so this is also a legal program,
// and it must panic the same way rather than dying on SIGSEGV.
interface PaymentMethod { charge(amount: i64): i64 }

fn main() {
  let pm: PaymentMethod = nil
  println("start")
  println("${pm.charge(100)}")
}
