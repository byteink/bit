// run
// #6244: `@json class` needs no import from "std/json" at all. The loader
// (compiler/project.bit's injectImplicitJsonImport) adds std/json as this
// module's implicit dependency the moment it sees `@json` anywhere in the
// tree, so `toJson()`'s synthesized body resolves `Json`/`JsonEntry` the
// same way it always has (#6232) — this file writes zero `import` at all.
//
// Diverges from the pinned 0.33.0 oracle on `types` alone (the oracle
// predates this feature and types `p.toJson()` as `<error>` rather than
// synthesizing `toJson` at all) — declared as scripts/selfhost-ir-
// signatures.sh's `6244-json-attr-implicit-insert`, same shape as #6161's
// json-schema synth before it, expected to retire at the 0.34.0 repin.
// `ir`/`iropt` never compare this file at all: the oracle's own `--dump-ir`/
// `--dump-ir-pre` decline outright (an unresolved `<error>`-typed call
// cannot lower), which selfhost-diffdump.sh's run_ir() treats as SKIP, not
// a divergence to explain.
@json class Point {
  x: i64,
  y: i64,
}

fn main() {
  let j = Point{ x = 1, y = 2 }.toJson()
  match (j) {
    JsonObject(fields) => print("fields=${len(fields)}\n")
    _ => print("not an object\n")
  }
}
