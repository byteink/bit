// run
// #3965: std/websocket's handshake accept key, pinned against RFC 6455
// §1.3's own worked example — the one place implementations can check
// themselves. A transposed character in the fixed GUID or a wrong hash
// algorithm produces a handshake that only fails against a real client, so
// this is checked against the RFC's own numbers rather than only against
// this module's own client/server round trip.
import { acceptKey } from "std/websocket"

fn main() {
  print("accept=${acceptKey("dGhlIHNhbXBsZSBub25jZQ==")}\n")
  // A different key must not produce the same accept value.
  print("differs=${acceptKey("AnotherKeyValue12345==") != acceptKey("dGhlIHNhbXBsZSBub25jZQ==")}\n")
}
