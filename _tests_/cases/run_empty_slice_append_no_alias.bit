// run
// #3648, the one OBSERVABLE change: `append` on a statically-empty slice no
// longer grows the original binding.
//
// `append` mutates a real header in place and hands the same header back
// (spec/LINT.md E0214 names that as a hazard), so `let d = append(c, 2)` used to
// leave `c` reading length 2. A statically-empty slice has no header to grow —
// it is the null word now — so `append` allocates a fresh one and the original
// binding stays empty. That is precisely what SPEC §13.4 already requires of the
// slice ZERO value ("`append` allocates"), and a class field's zero-valued slice
// behaved this way before this change; the three explicit spellings now agree
// with it instead of contradicting it.
//
// The non-empty case below is UNCHANGED and is here to keep that visible: this
// is not a change to `append`, only to what an empty slice is made of.
class Bag {
  xs: []int,
}

fn main() {
  let a = []int(0)
  let b = append(a, 1)
  print("empty ctor: a=${len(a)} b=${len(b)}\n")
  let e: []int = []
  let f = append(e, 1)
  print("empty lit:  e=${len(e)} f=${len(f)}\n")
  let z = Bag{}
  let g = append(z.xs, 1)
  print("zero field: z=${len(z.xs)} g=${len(g)}\n")
  let c = []int(1)
  let d = append(c, 2)
  print("sized ctor: c=${len(c)} d=${len(d)}\n")
}
