// run
// #3648: `append` on a statically-empty slice does not grow the original
// binding — a statically-empty slice has no header to grow, it is the null
// word, so `append` allocates a fresh one and the original binding stays
// empty. That is precisely what SPEC §13.4 already requires of the slice
// ZERO value ("`append` allocates"), and a class field's zero-valued slice
// behaved this way before #3648; the three explicit spellings now agree with
// it instead of contradicting it.
//
// The non-empty case below (`c`/`d`) used to be the CONTRAST: `append`
// mutated a real, non-null header in place and handed the same header back
// (spec/LINT.md E0214 names that as a hazard), so `let d = append(c, 2)`
// left `c` reading length 2 too. #6092 removed that aliasing everywhere,
// non-empty bases included: `append` on a non-null `dst` now always returns
// an INDEPENDENT header, so `c` keeps reading its own, unchanged length (1)
// no matter what `d` is appended to next. This case now pins BOTH facts —
// the null-header case never aliased, and the non-null one no longer does
// either — rather than one against the other.
class Bag {
  xs: []int,
}

fn main() {
  let a = []int(0)
  let b = append(a, 1)
  print("empty ctor: a=${len(a)} b=${len(b)}\n")
  let e: []int = []
  let f = append(e, 1)
  print("empty lit:  e=${len(e)} f=${len(f)}\n")
  let z = Bag{}
  let g = append(z.xs, 1)
  print("zero field: z=${len(z.xs)} g=${len(g)}\n")
  let c = []int(1)
  let d = append(c, 2)
  print("sized ctor: c=${len(c)} d=${len(d)}\n")
}
