// fmt
// SPEC §10.5, #3879: `bit fmt` puts each attribute on its own line ABOVE the
// field, never joined onto it the way a function attribute is (`@naked fn f`),
// and above `export` too -- the grammar is
// `[ attr_list ] [ "export" ] [ "readonly" ] IDENT ":" type`, so the two
// halves of the field straddle the keyword.
//
// One attributed field puts the WHOLE class body in the one-member-per-line
// form: the comma-list rendering a field-only class otherwise gets has nowhere
// to put an attribute. `plain` below is unattributed and proves it goes along.
//
// Arguments print `(a, b)` -- one comma and one space, like any argument list.

class NewUser {
  @min(3)
  @max(200)
  name: string

  @email
  export email: string

  @between(1, 99)
  readonly id: int = 1

  plain: bool
}
