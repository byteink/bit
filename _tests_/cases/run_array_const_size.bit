// run
// #1903: an array size accepted only an INT_LIT, though SPEC §12's prose
// promises "fixed length N (a compile-time constant)". The grammar at
// SPEC.md:713 said `"[" INT_LIT "]" type`, and the parser was faithful to it,
// so the prose described a language nobody had.
//
// The cost was real rather than cosmetic: runtime/root/{linux,darwin}/boot.bit
// sized six boot blocks by hand because `[bootWorkerWords * bootMaxWorkers]i64`
// would not parse, leaving `[9344]i64` as a magic number that must equal
// 292 x 32 in two files with nothing checking it.
const rows: int = 3
const cols: int = 4

fn main() {
  // A named const.
  let a: [rows]i64
  print("${len(a)}\n")

  // Arithmetic over two named consts — the shape boot.bit actually needs.
  let b: [rows * cols]i64
  print("${len(b)}\n")

  // Arithmetic over literals alone.
  let c: [2 * 8]i64
  print("${len(c)}\n")

  // A plain literal must keep working; this is the spelling every existing
  // array in the tree uses.
  let d: [5]i64
  print("${len(d)}\n")

  // The size is a compile-time constant, so elements are addressable and
  // zero-valued exactly as before.
  a[0] = 7
  a[rows - 1] = 9
  print("${a[0] + a[2]}\n")
}
