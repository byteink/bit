// run
// #3738: block params every predecessor binds to one value now SHARE that
// value's location instead of getting their own, so the edge move disappears.
// The shape that exercises it is a loop whose body has an early exit and a
// diamond: the join block's param is reached from two predecessors that pass
// two DIFFERENT vregs which both resolve to the same root, which is the case
// the fixpoint exists for and the case a single pass over the edges misses.
//
// Every loop-invariant below is read AFTER the loop as well as inside it, and
// the expected output is a function of all of them, so an unsound share shows
// up as a wrong number rather than as a crash. `probe` is a real call, which
// puts the whole function in the callee-saved-only register file and is where
// the register pressure that made this worth fixing comes from.

fn probe(base: int, i: int): int {
  return base + i * 7
}

fn scan(lo: int, hi: int, step: int, stop: int): int {
  let acc = 0
  let seen = 0
  let i = lo
  while (i < hi) {
    if (i == stop) {
      // Early return out of the middle of the loop: reads three invariants and
      // the two loop-carried values, all of which must still be intact.
      return acc * 1000 + seen * 100 + lo * 10 + step
    }
    if (i % 2 == 0) {
      acc = acc + probe(lo, i)
    } else {
      acc = acc + step
    }
    seen = seen + 1
    i = i + step
  }
  return acc * 1000 + seen * 100 + hi * 10 + step
}

fn main() {
  // Runs to completion: i = 0,2,4,6,8 (all even) -> acc = sum(i*7) = 140,
  // seen = 5, hi = 10, step = 2.
  print("${scan(0, 10, 2, -1)}\n")
  // Early return at i == 6: i = 0,2,4 contribute 0+14+28 = 42, seen = 3, and
  // the early path reports `lo` (0) where the fall-through reports `hi`.
  print("${scan(0, 10, 2, 6)}\n")
  // step 1 alternates the two arms: i=1 adds step(1), i=2 adds probe(1,2)=15,
  // i=3 adds step(1) -> acc = 17, seen = 3, hi = 4, step = 1.
  print("${scan(1, 4, 1, -1)}\n")
  // Every invariant read on the early-return path, with a non-zero lo: i=1
  // adds step(3), i=4 adds probe(1,4)=29 -> acc = 32, seen = 2, lo = 1.
  print("${scan(1, 9, 3, 7)}\n")
}
