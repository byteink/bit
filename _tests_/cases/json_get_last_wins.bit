// run
// stdlib/json/value.bit's jsonGetFromObject, which #4358 turned from a
// forward scan that kept the last match into a BACKWARD scan that returns at
// the first one. The two are the same function only because the documented
// duplicate-key policy is last-wins; a forward scan with the same early exit
// would silently be first-wins, so the direction is behaviour and is pinned
// here rather than left to the optimization's own comment.
//
// Covers: a duplicate key resolving to the LAST occurrence (2 and 3 copies,
// so an odd/even mix-up shows), the last occurrence winning even when it is
// a different JSON type from the first, all entries still reachable through
// jsonAsObject (the CST layer depends on that and jsonGet must not dedupe),
// keys differing only in their final byte (the length check cannot separate
// them, so the byte compare has to), and a key repeated at several nesting
// depths, where each object's own last-wins answer must be independent.
import { jsonParse, jsonGet, jsonAsObject, jsonAsInt, jsonAsString } from "std/json"

fn show(label: string, doc: string, key: string) {
  let parsed = jsonParse(doc) catch e {
    print("${label}=parse failed: ${e.message()}\n")
    return
  }
  match (jsonGet(parsed, key)) {
    Some(v) => {
      match (jsonAsInt(v)) {
        Some(n) => print("${label}=int ${n}\n")
        None => {
          match (jsonAsString(v)) {
            Some(s) => print("${label}=str ${s}\n")
            None => print("${label}=other\n")
          }
        }
      }
    }
    None => print("${label}=None\n")
  }
}

fn showEntries(label: string, doc: string) {
  let parsed = jsonParse(doc) catch e {
    print("${label}=parse failed: ${e.message()}\n")
    return
  }
  match (jsonAsObject(parsed)) {
    Some(entries) => {
      print("${label}=${len(entries)} entries:")
      for e of entries {
        print(" ${e.key}")
      }
      print("\n")
    }
    None => print("${label}=not an object\n")
  }
}

// The same key at three nesting depths, each object answering for itself.
fn showNested(doc: string) {
  let parsed = jsonParse(doc) catch e {
    print("nested=parse failed: ${e.message()}\n")
    return
  }
  let cur = parsed
  let depth = 0
  while (depth < 3) {
    match (jsonGet(cur, "v")) {
      Some(v) => {
        match (jsonAsInt(v)) {
          Some(n) => print("nested[${depth}].v=${n}\n")
          None => print("nested[${depth}].v=non-int\n")
        }
      }
      None => print("nested[${depth}].v=None\n")
    }
    match (jsonGet(cur, "next")) {
      Some(v) => cur = v
      None => depth = 3
    }
    depth = depth + 1
  }
}

fn main() {
  show("dup2", "{\"a\":1,\"a\":2}", "a")
  show("dup3", "{\"a\":1,\"a\":2,\"a\":3}", "a")
  show("dup-retype", "{\"a\":1,\"a\":\"last\"}", "a")
  show("dup-surrounded", "{\"z\":0,\"a\":1,\"m\":9,\"a\":2,\"q\":7}", "a")
  show("absent", "{\"a\":1,\"b\":2}", "c")
  showEntries("entries", "{\"a\":1,\"a\":2,\"a\":3}")

  // Keys that are the same length and differ only in the final byte: the
  // length test cannot tell them apart.
  show("tail-a", "{\"key1\":10,\"key2\":20,\"key3\":30}", "key1")
  show("tail-b", "{\"key1\":10,\"key2\":20,\"key3\":30}", "key2")
  show("tail-c", "{\"key1\":10,\"key2\":20,\"key3\":30}", "key3")
  show("tail-miss", "{\"key1\":10,\"key2\":20,\"key3\":30}", "key4")

  // A one-entry object: the backward scan's first step is also its last.
  show("single", "{\"only\":42}", "only")
  show("empty-obj", "{}", "a")

  showNested("{\"v\":1,\"next\":{\"v\":2,\"v\":22,\"next\":{\"v\":3}}}")
}
