// error
// #6993: operator objects and the `and`/`or`/`not` keys are not covered by plain
// equality entries; they are E0303, never checked as something else.
import { Where } from "std/where"

class Article {
  id: i64
  score: i32
}

fn main() {
  let a: Where<Article> = { score: { gte: 18 } }
  let b: Where<Article> = { or: 1 }
}
