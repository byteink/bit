// error
// #6993, narrowed by #6997: operator objects, the `and`/`or`/`not` keys and
// `related(...)` are checked now. What stays E0303 is the shape the condition
// literal has no meaning for: a key that is not a name, an operator object with
// no operator, and an operator key that is not a name.
import { Where } from "std/where"

class Article {
  id: i64,
  score: i32,
}

fn main() {
  let a: Where<Article> = { "score": 1 }
  let b: Where<Article> = { score: {} }
  let c: Where<Article> = { score: { "gte": 1 } }
}
