// panic
// #7637: `string(rs[lo:hi])` on a `[]rune` with `lo > hi` panics with the text
// `rs[lo:hi]` itself panics with (run_slice_range_panic.bit):
// `string_from_rune_range` applies `rtSliceSlice`'s bounds and its
// `oobSliceRange` message.
import { args } from "std/os"

fn lo(): int { return len(args()) + 2 }

fn main() {
  let rs = []rune("héllo")
  print("start\n")
  let s = string(rs[lo():1])
  print("survived ${s}\n")
}
