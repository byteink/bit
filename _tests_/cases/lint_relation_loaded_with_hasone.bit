// lint exit=0
// #5247 E0218 `relation-unloaded-read`: same body as
// lint_relation_unloaded_read_hasone.bit, differing only in the chain --
// `.with("profile")` is chained onto `find<User>(...)` before
// `.oneOrFail()`, so `profile` (a `@hasOne` field) is among the fields this
// binding's own chain already loaded. Zero findings -- proves the rule
// stays silent for a loaded `@hasOne` read, not just a loaded `@hasMany`
// one.
import { Data, find } from "orm"
import { FieldDesc, Rows } from "std/sql"

@table class Profile {
  @id
  id: i64
}

@table class User {
  @id
  id: i64
  @hasOne("userId")
  profile: Profile
}

fn userMapper(rows: Rows): User! {
  return User{ id: 1, profile: Profile{ id: 0 } }
}

fn report(db: Data, id: i64): ()! {
  let u = find<User>(db, "users", []FieldDesc(0), userMapper).with("profile").oneOrFail()?
  print("${u.profile.id}\n")
}
