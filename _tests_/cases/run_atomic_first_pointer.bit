// run
// The first pointer type is interned inside the load argument (#8270).
// A prior pointer binding would hide a stale checker type-table header.
let counter: i64 = 7

fn main() {
  let first = atomicLoad(ptrOf(counter))
  let prior = atomicAdd(ptrOf(counter), 5)
  let swapped = atomicCmpxchg(ptrOf(counter), 12, 20)
  atomicStore(ptrOf(counter), 30)
  print("first=${first} prior=${prior} swapped=${swapped} final=${atomicLoad(ptrOf(counter))}\n")
}
