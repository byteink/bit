// run
// #4341's owner ruling: a payload-carrying enum, and a class holding one,
// compare STRUCTURALLY (§14.6) — tags and payload words compare recursively —
// rather than by identity. Before this, `a == b` below answered `false` and a
// `map<Config,int>` keyed on two such values grew to 2 entries instead of
// collapsing to 1 (the map case is pinned separately, run_map_key_payload_enum.bit).
//
// What must STAY illegal (a payload with no value equality of its own) is
// pinned by check_enum_payload_not_comparable.bit and
// check_class_payload_enum_not_comparable.bit.
enum Port { Default, Explicit(int) }
class Config { host: string, port: Port }

fn main() {
  let a = Config{ host: "localhost", port: Port.Default }
  let b = Config{ host: "localhost", port: Port.Default }
  print("${a == b} ") // equal tag, equal (absent) payload

  let c = Config{ host: "localhost", port: Port.Explicit(80) }
  print("${a == c} ") // different tag

  let d = Config{ host: "localhost", port: Port.Explicit(81) }
  print("${c == d}\n") // equal tag, different payload
}
