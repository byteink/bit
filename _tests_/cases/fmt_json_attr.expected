// fmt
// SPEC §10.3.1, #3976: a CLASS attribute prints INLINE ahead of `class`,
// exactly as a function's attributes print ahead of `fn` (`@naked fn f()`) --
// not on its own line the way a FIELD attribute does. The difference is not
// arbitrary: `export` wraps the declaration, so `export @json class C` has to
// stay one line or the marker is split off from what it marks.
//
// `@key("...")` is a field attribute and follows the field rule, so both
// spellings appear in one class body below.
//
// `bit fmt` never runs the synthesis pass, so nothing here is affected by the
// member `@json` adds -- this fixture is about the two markers surviving a
// round trip unchanged, which is what makes them safe to write in real source.
import { Json, JsonEntry } from "std/json"

@json class Small {
  a: i64,
  b: string,
}

export @json class Wide {
  id: i64
  @key("created_at")
  createdAt: string
  @key(`raw_key`)
  rawKey: string
  plain: bool
}
