// panic-debug
// #3087 (epic #3076): arm64/x64 `--debug` builds emit an overflow-checked
// signed multiply (#3084/#3085) that must TRAP when a runtime i64 MAX * 2
// overflows the type's range (SPEC §13.5) -- the same boundary #3084's own
// acceptance case exercises. `two()` is routed through `len(args())` so
// `compiler/optfold.bit`'s `foldAddSubMul` cannot resolve this multiply as
// a compile-time constant. Sibling of overflow_trap_mul_release.bit: the
// identical expression, built WITHOUT `--debug`, where the same overflow
// must silently wrap instead.
import { args } from "std/os"

fn two(): int { return len(args()) + 1 }

fn main() {
  print("start\n")
  let x: i64 = 9223372036854775807
  print("prod=${x * two()}\n")
  print("unreachable\n")
}
