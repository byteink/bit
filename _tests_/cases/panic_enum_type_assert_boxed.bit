// panic
// #6017: `e.(EnumType)` and `let (v, ok) = e.(EnumType)` for a BOXED enum
// target, end to end — a well-formed target (its declaration-order FIRST
// variant carries no payload, so it has a zero value, SPEC §13.4/§14.4)
// proves the two-result match, the two-result MISMATCH (the zero value
// read back through a method call, not just printed), and the one-result
// panicking form, across a 0-arg, a 1-arg and a 2-arg variant — the shapes
// that make a boxed enum's object size vary PER CONSTRUCTION (SPEC §14.7's
// `8 + 8*argc`), which is exactly why `bit_rt_iface_as_enum` compares
// descriptors by their `type_id` word rather than by address (ABI.md
// §2.2a).
enum RedisError {
  Timeout
  WrongType(string)
  Moved(int, string)
  export message(): string {
    match (this) {
      Timeout => return "timeout"
      WrongType(m) => return "wrongtype:${m}"
      Moved(slot, addr) => return "moved:${slot}:${addr}"
    }
  }
}

enum OtherErr {
  Nope
  Oops(string)
  export message(): string {
    match (this) {
      Nope => return "nope"
      Oops(m) => return "oops:${m}"
    }
  }
}

fn doOp(which: int): int! {
  if (which == 0) {
    fail RedisError.Timeout
  }
  if (which == 1) {
    fail RedisError.WrongType("bad")
  }
  fail RedisError.Moved(3, "host:1")
}

fn tryOne(which: int) {
  let _ = doOp(which) catch e {
    let (re, ok) = e.(RedisError)
    print("ok=${ok} ")
    if (ok) {
      print("matched=${re.message()} ")
    }
    let (o, ok2) = e.(OtherErr)
    print("ok2=${ok2} zero=${o.message()}\n")
    0
  }
}

fn panicsOnMismatch() {
  let _ = doOp(0) catch e {
    let v = e.(OtherErr)
    print("unreachable ${v.message()}\n")
    0
  }
}

fn main() {
  tryOne(0)
  tryOne(1)
  tryOne(2)
  panicsOnMismatch()
}
