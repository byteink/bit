// run
// #4660: a local binding that SHADOWS a namespace-import alias is a LOCAL, not
// the namespace. SPEC §17.5 gives the nearer binding, so `let strings = Wrap{}`
// makes both `strings.x(...)` calls below method calls on `Wrap`.
//
// `nsQualifiedName` (compiler/checkproject.bit) used to answer from the
// module-wide `c.namespaces` map, which is keyed by NAME and carries no scope,
// so all eleven of its consumers read `std/strings` here instead. The two calls
// broke in two different ways on 053046f2, which is why both are pinned:
//
//   `strings.trimSpace("  y  ").tag()` was rejected outright — the chain's first
//   link was typed from the module's `trimSpace(s: string): string`, so `.tag()`
//   drew `error[E0057]: no field or method 'tag' on this type`. Renaming the
//   local made the identical program compile.
//
//   `strings.trim("x")` passed `bit check` (rc 0) and then died at `bit run`
//   with `IR verification failed (1 violation(s)) ... main: %1 calls @m2$trim
//   with 1 argument(s), but @m2$trim declares 2 parameter(s)`: the checker took
//   the arity from the module's two-parameter `trim(s, cutset)` while the
//   lowerer resolved `Wrap.trim`, and only the IR verifier stopped the mismatch
//   reaching a binary.
//
// The import is deliberately never called under its own name here. A genuine
// `strings.trim(s, cutset)` in a SIBLING function of a module that binds a local
// named `strings` anywhere is still misjudged as a method on that local's type
// (`error[E0050]: expected 1 argument(s), found 2`) — a separate, pre-existing
// defect in the flat module-wide `env`, measured identical before and after this
// fix and filed as #4665. Writing one here would pin that bug, not this one.

import strings from "std/strings"

class Wrap {
  n: int
  export trim(s: string): string {
    return "WRAP:${s}"
  }
  export trimSpace(s: string): Wrap {
    return this
  }
  export tag(): int {
    return this.n
  }
}

fn main() {
  let strings = Wrap{ n: 7 }
  println(strings.trim("x"))
  println("${strings.trimSpace("  y  ").tag()}")
}
