// run
// #6121, epic #6013: the same defaulted-slot fill as a free call's, on a
// METHOD — `r.set("a", "b", ifAbsent = true)` fills `ttl` from its own
// default while `ifAbsent` is named, unblocking pkg/redis's headline call
// shape (`r.set(k, v, ttl = 60_000, ifAbsent = true)`) without every caller
// having to repeat `ttl`'s default to reach `ifAbsent`.
class Store {
  set(k: string, v: string, ttl: int = 0, ifAbsent: bool = false): string {
    return "${k}=${v} ttl=${ttl} ifAbsent=${ifAbsent}"
  }
}

fn main() {
  let r = Store{}
  print(r.set("a", "b", ifAbsent = true) + "\n")
  print(r.set("c", "d", ttl = 30) + "\n")
}
