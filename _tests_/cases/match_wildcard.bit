// run
// #2294: `_` wildcard arm on `match` (§13.8). A wide enum needs one arm plus
// `_` instead of every remaining variant spelled out — `switch` already has
// `default` for the same reason. `_` still requires the subject to be a real
// enum and still checks arity/binder rules on every OTHER arm; it only lifts
// the exhaustiveness requirement for the variants it did not have to name.
enum Color { Red, Green, Blue, Cyan, Magenta, Yellow, Black }

fn isRed(c: Color): bool {
  match (c) {
    Red => return true
    _ => return false
  }
}

fn main() { println("${isRed(Color.Blue)}") }
