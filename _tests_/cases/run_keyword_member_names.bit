// run
// #7035: a reserved word is a legal member name after a glued `.`, and a
// legal method name where `(` or `<` follows it, so `db.as(user)` can be the
// spelling of the owner-approved API although `as` is reserved (SPEC §5.2).
// A FIELD named by a reserved word stays rejected (#2248, see
// _tests_/bit/checkercases for the diagnostic); only a method is exempt,
// because only a method's name is followed by `(` or `<`.
interface Actor {
  id: string,
}

class User {
  id: string,
}

interface Scoper {
  as(a: Actor, tenant: string): string,
}

class Handle {
  tag: string

  export as(a: Actor, tenant: string = ""): string {
    return "${this.tag}:${a.id}:${tenant}"
  }

  export in<T>(x: T): T {
    return x
  }

  export match(n: int): int {
    return n + 1
  }
}

fn main() {
  let h = Handle{ tag = "h" }
  println(h.as(User{ id = "u7" }))
  println(h.as(User{ id = "u8" }, "acme"))
  println(h.in<string>("kept"))
  println("${h.match(41)}")
  let s: Scoper = Handle{ tag = "i" }
  println(s.as(User{ id = "u9" }, "z"))
}
