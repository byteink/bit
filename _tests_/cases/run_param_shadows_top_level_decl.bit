// run
// #4570: a PARAMETER's name is visible only inside its own function body. It
// must never decide what that name means in another function.
//
// `Checker.env` is keyed by NAME and flat across the whole module, and
// `bindParamOrReceiver` writes every parameter into it from a pre-pass that
// sweeps the entire node arena. `envLookup` therefore answered for a name as
// soon as ANY function bound it, and `checkCall`/`checkExprType` consulted it
// before the declaration tables — so `takesParam`'s `helper: () => string`
// below decided the type of `main`'s call to the top-level `fn helper`.
//
// The failure had no diagnostic: `bit check` exited 0, `helper(1)` was typed
// `string` while lowering emitted the i64-returning call, and interpolating
// that i64 as a string pointer SEGFAULTED (`bit run`, rc=2). `identEnvType`
// (compiler/checklookup.bit) now reads the env through the reference NODE and
// refuses it when the resolver bound that node to something whose type does not
// live in the env — a free function, a class, an alias, a builtin.
//
// It was never only about functions: `MyInt(5)` and `len("abcd")` were retyped
// through a same-named parameter the same way. The alias conversion is pinned
// below; the builtin shape is not, only because shadowing a predeclared name
// also emits E0048 and this harness compares stdout.

fn helper(n: int): int {
  return n + 1
}

// The reported shape: a function-typed parameter named after a top-level fn.
fn takesParam(helper: () => string): string {
  return helper()
}

type MyInt = i64

fn convert(): MyInt {
  return MyInt(5)
}

// The same collision against a type name, reached through the conversion path
// rather than the call path.
fn takesAlias(MyInt: () => string): string {
  return MyInt()
}

// Control: the ticket measured that a NON-function-typed parameter of the same
// name never reproduced. It must still resolve to the parameter in its own body.
fn control(helper: string): string {
  return helper
}

fn main() {
  println("${helper(1)}")
  println(takesParam(() => "x"))
  // A bare reference to the top-level function, not a call: the same env leak
  // typed `f` as `() => string` and rejected `f(1)` with E0050.
  let f = helper
  println("${f(1)}")
  println("${convert()}")
  println(takesAlias(() => "y"))
  println(control("z"))
}
