// run
// #6365: a static method with its OWN type parameter, `static own<U>(u: U): U`,
// called through a class, bare or generic, bare or instantiated (SPEC 10.4.1,
// 15.3). Each call is one monomorphized instance recorded in the instantiation
// ledger like a generic method's; before, a static call recorded none, so the
// symbol it named (`_own$t<class>`) was never emitted and the program failed to
// link.
//
// `Box.wrap` depends on the class parameter `T` AND its own `U`: the class half
// is bound from the first argument, the method's own from the second.
//
//  1. a plain class, positional and named;
//  2. a generic class's bare name, `own` mentioning no class parameter;
//  3. the written instantiation;
//  4. a method mentioning both the class parameter and its own;
//  5. named arguments, reordered.
class Plain {
  static own<U>(u: U): U {
    return u
  }
}

class Box<T> {
  v: T

  static own<U>(u: U): U {
    return u
  }

  static wrap<U>(t: T, u: U): string {
    return "${t}|${u}"
  }
}

fn main() {
  print("${Plain.own(1)} ${Plain.own(u = "a")}\n")
  print("${Box.own("b")} ${Box.own(u = 2)}\n")
  print("${Box<bool>.own(3)}\n")
  print("${Box.wrap(1, "c")}\n")
  print("${Box.wrap(u = "d", t = 4)}\n")
  print("${Box<i64>.wrap(5, u = "e")}\n")
}
