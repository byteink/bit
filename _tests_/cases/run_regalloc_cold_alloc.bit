// run
// #7778: an allocation, a closure or a value call crosses a value only where
// the value is still needed once it returns. `digits` keeps `c - '0'` across
// a cold `fail newError(...)` whose inline allocation reaches no later read,
// so it may sit in a caller-saved register. `boxed` reads `k` after an
// allocation in the allocation's own block, `captured` reads `k` both AT a
// closure's creation and after it, `viaValue` reads `k` after a value call,
// and `rejoin` reaches a read of `k` through the block the allocation's block
// jumps to: in each `k` must survive in a callee-saved register or a slot, or
// the sums below come out wrong (BIT_GC=stress collects at every allocation).

class Box {
  v: int,
}

fn digits(s: string): int! {
  if (len(s) == 0) {
    fail newError("empty")
  }
  let v = 0
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      fail newError("non-digit")
    }
    v = v * 10 + int(c - '0')
    i = i + 1
  }
  return v
}

fn boxed(a: int): int {
  let k = a * 7 + 3
  let b = Box{ v = a }
  return k + b.v
}

fn captured(a: int): int {
  let k = a * 13 + 1
  let f = (x: int) => x + k
  return f(a) + k
}

fn viaValue(a: int, f: (int) => int): int {
  let k = a * 17 + 2
  let r = f(a)
  return k + r
}

fn rejoin(a: int, flag: bool): int {
  let k = a * 11 + 5
  let extra = 0
  if (flag) {
    let b = Box{ v = a }
    extra = b.v
  }
  return k + extra
}

fn main() {
  for s of ["12345", "907", "12x4", ""] {
    let v = digits(s) catch e {
      println("digits ${s}: ${e.message()}")
      continue
    }
    println("digits ${s}: ${v}")
  }
  println("boxed: ${boxed(20)}")
  println("captured: ${captured(20)}")
  println("viaValue: ${viaValue(20, (x: int) => x * 3)}")
  println("rejoin: ${rejoin(20, true)} ${rejoin(20, false)}")
}
