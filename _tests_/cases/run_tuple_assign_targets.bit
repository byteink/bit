// run
// #6681: multiple assignment takes index and field targets, in Go's order
// (SPEC §13.1): the operands of every target and every right-hand side are
// evaluated first, left to right, then the stores happen left to right.
// `a[i], a[j] = a[j], a[i]` is two loads and two stores, with no tuple built.
// Covered: slices (word, packed narrow, string, class-ref and two-word decimal
// elements), a fixed array, a map, class fields, locals, a blank target, and
// the aliasing and operand-order cases that tell the two phases apart.
class Box {
  a: int,
  b: int,
  d: decimal,
  e: decimal,
  s: string,
}

class Node {
  n: int,
}

let calls: string = ""

fn at(tag: string, v: int): int {
  calls = "${calls}${tag}"
  return v
}

fn swaps() {
  let xs = []int{ 10, 20, 30 }
  xs[0], xs[2] = xs[2], xs[0]
  println("int ${xs[0]} ${xs[1]} ${xs[2]}")

  let ss = []string{ "a", "b", "c" }
  ss[0], ss[1] = ss[1], ss[0]
  println("string ${ss[0]} ${ss[1]} ${ss[2]}")

  let ds = []decimal{ 1.5, 2.25, 3.125 }
  ds[0], ds[2] = ds[2], ds[0]
  println("decimal ${ds[0]} ${ds[1]} ${ds[2]}")

  let ns = []Node{ Node{ n = 1 }, Node{ n = 2 } }
  let first = ns[0]
  ns[0], ns[1] = ns[1], ns[0]
  println("class ${ns[0].n} ${ns[1].n} ${first.n}")

  let hs = []i16{ -7, 300, -32768 }
  hs[0], hs[2] = hs[2], hs[0]
  println("i16 ${hs[0]} ${hs[1]} ${hs[2]}")

  let bs = []u8{ 1, 2, 3 }
  bs[0], bs[1], bs[2] = bs[2], bs[0], bs[1]
  println("u8 rotate ${bs[0]} ${bs[1]} ${bs[2]}")

  let arr: [3]int = [3]int{ 1, 2, 3 }
  arr[0], arr[2] = arr[2], arr[0]
  println("array ${arr[0]} ${arr[1]} ${arr[2]}")

  let da: [2]decimal = [2]decimal{ 0.5, 9.75 }
  da[0], da[1] = da[1], da[0]
  println("decimal array ${da[0]} ${da[1]}")

  let m = map<string, int>{ "x": 1, "y": 2 }
  m["x"], m["y"] = m["y"], m["x"]
  println("map ${m["x"]} ${m["y"]}")

  let md = map<string, decimal>{ "p": 1.5, "q": 2.5 }
  md["p"], md["q"] = md["q"], md["p"]
  println("map decimal ${md["p"]} ${md["q"]}")

  let bx = Box{ a = 1, b = 2, d = 3.5, e = 4.5, s = "s" }
  bx.a, bx.b = bx.b, bx.a
  bx.d, bx.e = bx.e, bx.d
  println("fields ${bx.a} ${bx.b} ${bx.d} ${bx.e}")
  xs[1], bx.s = 99, "t"
  println("mixed ${xs[1]} ${bx.s}")
}

fn order() {
  let xs = []int{ 0, 0, 0, 0 }
  let i = 1
  // The index operand is read before any store: `i` changes after the first
  // store, `xs[i]` still names the old slot.
  i, xs[i] = 3, 7
  println("old index ${i} ${xs[0]} ${xs[1]} ${xs[3]}")

  // Aliasing: both targets name xs[2]; stores run left to right, last wins.
  xs[2], xs[2] = 1, 2
  println("alias ${xs[2]}")

  // Targets' operands first, then right-hand sides, each left to right.
  calls = ""
  xs[at("a", 0)], xs[at("b", 1)] = at("c", 5), at("d", 6)
  println("order ${calls} ${xs[0]} ${xs[1]}")

  // Every right side is read before the first store.
  xs[0], xs[1] = xs[1], xs[0] + 100
  println("rhs first ${xs[0]} ${xs[1]}")

  // A blank target evaluates its right side and stores nothing.
  calls = ""
  _, xs[3] = at("z", 1), 42
  println("blank ${calls} ${xs[3]}")

  let p = 1
  let q = 2
  p, q = q, p
  println("locals ${p} ${q}")
}

fn main() {
  swaps()
  order()
}
