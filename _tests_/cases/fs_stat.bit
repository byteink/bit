// run
// #3440 (pass 2 of #2153): `fs.stat`/`fs.lstat` wired into `std/fs`.
//
// Four cases, matching this ticket's own acceptance:
//   1. A file of known length: `stat(path).size` matches without reading
//      the contents.
//   2. A directory reports `isDir == true`; a missing path fails.
//   3. A symlink is the case that actually tells `stat` and `lstat` apart:
//      `stat` follows it (sees the target), `lstat` does not (sees the link
//      itself). Getting the two swapped inside the runtime would pass every
//      other case here and only fail this one.
//   4. `mtime` is non-zero and does not decrease after a rewrite.
import { envOr } from "std/os"
import { stat, lstat, mkdir, remove, writeFile, FileInfo } from "std/fs"
import { hasPrefix } from "std/strings"

// `std/fs` has no `symlink` — creating one is not expressible in Bit — so the
// link comes from a shell script run with `osRun`, the same technique
// fs_walk_symlink.bit uses for the identical reason.
fn makeLink(dir: string, target: string, link: string): bool {
  let script = "${dir}/setup.sh"
  let body = "#!/bin/sh\nln -s '${target}' '${link}' || exit 1\n"
  writeFile(script, body) catch _ {
    return false
  }
  return osRun("/bin/sh", [script]) == 0
}

fn main() {
  let dir = "${envOr("TMPDIR", "/tmp")}/bit_fs_stat_${timeUnixNs()}"
  mkdir(dir) catch _ {
    println("setup failed: cannot create ${dir}")
    return
  }

  // (1) a file of known length.
  let filePath = "${dir}/file.txt"
  writeFile(filePath, "0123456789") catch _ { // exactly 10 bytes
    println("setup failed: cannot write file.txt")
    return
  }
  let fileInfo = stat(filePath) catch e {
    println("stat file failed: ${e.message()}")
    return
  }
  println("file: size=${fileInfo.size} isDir=${fileInfo.isDir} isSymlink=${fileInfo.isSymlink}")

  // (2) a directory, and a missing path.
  let subDir = "${dir}/sub"
  mkdir(subDir) catch _ {
    println("setup failed: cannot create ${subDir}")
    return
  }
  let dirInfo = stat(subDir) catch e {
    println("stat dir failed: ${e.message()}")
    return
  }
  println("dir: isDir=${dirInfo.isDir}")

  let missingFailed = false
  let missingMsg = ""
  let missingInfo = stat("${dir}/does-not-exist") catch e {
    missingFailed = true
    missingMsg = e.message()
    FileInfo{ size: 0, mtime: 0, mode: 0, isDir: false, isSymlink: false }
  }
  println(
    "missing: fails=${missingFailed} isEnoent=${hasPrefix(missingMsg, "no such file or directory:")} size=${missingInfo.size}",
  )

  // (3) a symlink to the file — the case that distinguishes stat from lstat.
  let linkPath = "${dir}/link.txt"
  if (!makeLink(dir, filePath, linkPath)) {
    println("setup failed: cannot create the symlink")
    return
  }
  let linkViaStat = stat(linkPath) catch e {
    println("stat link failed: ${e.message()}")
    return
  }
  let linkViaLstat = lstat(linkPath) catch e {
    println("lstat link failed: ${e.message()}")
    return
  }
  println("link: stat.size=${linkViaStat.size} stat.isSymlink=${linkViaStat.isSymlink} lstat.isSymlink=${linkViaLstat.isSymlink}")

  // (4) mtime: non-zero, does not decrease after a rewrite.
  let before = stat(filePath) catch e {
    println("stat before rewrite failed: ${e.message()}")
    return
  }
  writeFile(filePath, "0123456789012345678901234567890123456789") catch _ { // 40 bytes
    println("setup failed: cannot rewrite file.txt")
    return
  }
  let after = stat(filePath) catch e {
    println("stat after rewrite failed: ${e.message()}")
    return
  }
  println("mtime: nonzero=${before.mtime > 0} nonDecreasing=${after.mtime >= before.mtime} sizeChanged=${after.size != before.size}")

  remove(linkPath) catch _ {
    return
  }
  remove(filePath) catch _ {
    return
  }
  remove(subDir) catch _ {
    return
  }
  remove("${dir}/setup.sh") catch _ {
    return
  }
  remove(dir) catch _ {
    return
  }
}
