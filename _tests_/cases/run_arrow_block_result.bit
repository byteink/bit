// run
// #1488: a BLOCK-bodied arrow fn lost its result type in both compilers.
//
//     let g = (x: f32) => { return 4.5 }
//     g(1.0) == 4.5            // did not compile: '()' has no '=='
//
// Sibling of #1472, which fixed the EXPRESSION-bodied form. That fix defaulted
// the body expression's untyped constant type before it became the function's
// result; the block form never derived a result from its `return`s at all. The
// seed fell through to `()`, so every use of the value failed E0053 against
// void — loud, but a whole shape of the language unusable.
//
// Fixed in BOTH compilers, so the seed is NOT the oracle here: `arrowBlockResult`
// walks the body for its first `return <expr>` and defaults that type, and the
// two implementations mirror each other line for line.
//
// Every check COMPARES rather than prints, for the reason #1457 taught and
// #1472 repeated: this family's signature is a value that renders plausibly and
// still compares wrong. The `==` results are what get printed.
//
// A golden case is a single file, so it has no prelude.

fn isF32Four(x: f32): bool {
  return x == 4.5
}

fn main() {
  // The defect itself: a block body whose only statement returns an untyped
  // float, with no expected function type anywhere to supply a result.
  let g = (x: f32) => { return 4.5 }
  print("block=${g(1.0) == 4.5}\n")

  // Untyped INT bodies travel the same path and default to i64.
  let n = (x: i32) => { return 5 }
  print("int=${n(1) == 5}\n")

  // A CONCRETE (already-typed) return needs no defaulting, and must keep its
  // own narrow type rather than being widened on the way out.
  let k = (x: f32) => { return f32(4.5) }
  print("conv=${isF32Four(k(1.0))}\n")

  // The `return` is not the first statement, and not at the top level of the
  // body — the walk has to find it wherever it is.
  let d = (x: i32) => {
    let doubled = x * 2
    if (doubled > 100) {
      return 0
    }
    return doubled
  }
  print("nested=${d(21) == 42}\n")

  // A block that returns nothing still yields `()`, unchanged. Called for its
  // effect, which is what proves the void case was not disturbed.
  let side = (x: i32) => { print("void=true\n") }
  side(1)

  // Arithmetic on the returned value, not just equality: a value arriving in
  // the wrong ABI slot fails this even if an equality happened to fall through.
  let h = (x: f64) => { return 4.5 }
  print("arith=${g(1.0) + h(1.0) == 9.0}\n")
}
