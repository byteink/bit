// run
// #4439: a variadic parameter on a class METHOD, called from sites at
// different arities (SPEC S10.3). Every method-call lowering site used to
// skip the free-function-only variadic-tail collection, so raw positional
// lowering fed the callee the wrong argument count at 0 and 2 args (an IR
// verification failure) and silently the WRONG value at 1 arg, where the
// call-site count happens to match the callee's single collected-slice slot.
class Foo {
  x: int
  bar(...args: string): string { return "n=${len(args)}" }
}
fn main() {
  let f = Foo{ x: 1 }
  print(f.bar())
  print("\n")
  print(f.bar("a"))
  print("\n")
  print(f.bar("a", "b"))
  print("\n")
}
