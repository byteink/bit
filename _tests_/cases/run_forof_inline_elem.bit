// run
// #4347: `for x of xs` fetches each element through the SAME inline load
// `xs[i]` uses (#3107), not `rt_call slice_get`. Split across three functions
// only to keep each under E0204's complexity limit; the printed order is the
// whole assertion.
fn strides() {
  // []u8 is stride 1 — a byte-packed buffer (ABI.md §2), so the element load
  // must scale by 1. Reading it as a word yields garbage, which is what makes
  // 200 and 255 worth having here: any wrong scale shows up in the sum.
  let bs = []u8(0)
  bs = append(bs, 1)
  bs = append(bs, 200)
  bs = append(bs, 255)
  let bsum = 0
  for b of bs {
    bsum = bsum + int(b)
  }
  print("u8 sum=${bsum}\n")

  // []string is stride 8 and a REFERENCE element: the loaded word must stay a
  // traceable string reference through the loop's block params.
  let ss = ["a", "bb", "ccc"]
  let joined = ""
  for s of ss {
    joined = joined + s + "|"
  }
  print("string ${joined}\n")

  // []f64 is stride 8 into a FLOAT register — a different arm of the load than
  // the two above, and the one an integer-only inline path would silently
  // mistype.
  let fs = [0.5, 1.25, 2.0]
  let ftotal = 0.0
  for f of fs {
    ftotal = ftotal + f
  }
  print("f64 total=${ftotal}\n")

  // []i32 is a narrow prim stored WORD-per-element: stride 8, own width 4, so
  // the load takes the shift-by-3 + field_get arm rather than a scaled
  // index_get. The negative value is deliberate — a wrong width here is a
  // sign-extension bug, not a garbage one.
  let ns = []i32(0)
  ns = append(ns, 7)
  ns = append(ns, -9)
  let nsum = 0
  for n of ns {
    nsum = nsum + int(n)
  }
  print("i32 sum=${nsum}\n")
}

// Empty slices at each stride: zero iterations, so the loop header must reject
// index 0 before the element load's own bounds check is ever reached, and
// nothing may read element 0 of a zero-length buffer.
fn empties() {
  let eb = []u8(0)
  let es = []string(0)
  let ef = []f64(0)
  let hits = 0
  for x of eb {
    hits = hits + int(x)
  }
  for x of es {
    hits = hits + len(x)
  }
  for x of ef {
    hits = hits + int(x)
  }
  print("empty hits=${hits}\n")
}

fn mutating() {
  // The body APPENDS to the slice it is iterating. Before #6092, `rtSliceAppend`
  // mutated `gs`'s header in place and returned it, so `$iter` (the loop's
  // hidden snapshot, bound once at loop entry from `gs`'s ORIGINAL header) and
  // `gs` were the SAME object — the loop's own `slice_len` test saw each new
  // element and ran over the grown slice. #6092 fixed `append` on a non-null
  // receiver to always return an INDEPENDENT header, so reassigning `gs`
  // inside the body no longer reaches `$iter`'s own header at all: the loop
  // still visits exactly the 2 elements `gs` held at entry, while `gs` itself
  // (read after the loop) has grown to 4 — matching Go's `range` over a slice
  // that is reassigned inside the loop body, and matching SPEC §12.6's "only
  // the returned value is guaranteed to observe the growth".
  let gs = [1, 2]
  let seen = 0
  for g of gs {
    seen = seen + g
    if (len(gs) < 5) {
      gs = append(gs, g + 10)
    }
  }
  print("grown seen=${seen} len=${len(gs)}\n")

  // Reassigning the binder inside the body must not disturb the next element:
  // the binder is a fresh local per iteration, not a window onto the buffer.
  let ks = [3, 4, 5]
  let ktotal = 0
  for k of ks {
    ktotal = ktotal + k
    k = 100
  }
  print("rebind total=${ktotal}\n")
}

fn main() {
  strides()
  empties()
  mutating()
}
