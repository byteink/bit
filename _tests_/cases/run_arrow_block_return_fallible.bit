// run
// #5287: the positive control for check_arrow_block_return_fallible.bit
// (_tests_/bit/checkercases) — the SAME `Handler = (Ctx) => Res!` shape, with
// a block-bodied arrow whose `return` actually produces a `Res`, must still
// build and run once `vArrow` (compiler/validatecall.bit) starts judging the
// arrow's `return`s against the target's ok type: `checkArrowFnAt`
// (compiler/checkexpr.bit) still wraps the block's own type as the
// expectation, so nothing about a CORRECT body's typing changes here — this
// pins that a real fix does not also reject the case it must keep accepting.
class Ctx {
  id: int,
}
class Res {
  code: int,
}
type Handler = (Ctx) => Res!

fn register(h: Handler) {
  let c = Ctx{ id = 1 }
  let r = h(c) catch _ {
    print("unexpected error\n")
    Res{ code = -1 }
  }
  print("code=${r.code}\n")
}

fn main() {
  register((c) => {
    return Res{ code = c.id + 6 }
  })
}
