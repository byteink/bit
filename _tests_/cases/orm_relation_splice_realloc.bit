// run
// #6404: the auto-loader splices `.with("posts")` into `repo.find(k)`'s own
// receiver chain, and a `let a = repo.find(k)?` whose `a.posts` is read must
// have it. `relationAutoSpliceCall` (compiler/relationautosplice.bit) used to
// write the new receiver through a `kidsOf` view taken BEFORE the splice's own
// appends to `tree.extra`; when an append reallocated the pool the write hit
// the abandoned array and the query kept its old receiver (the relation then
// panicked "read before it was loaded" at run, hasMany and manyToMany alike).
// Whether a given splice lands on a reallocation depends on how many extras the
// module has, so this end-to-end pin is NOT the regression guard (it holds 20
// reads and relies on luck at one tree size): the size-independent test is
// `checkRelationSpliceRealloc` (compiler/frontcheck.bit, run by test-selfcheck),
// which fills the pool first, and #6419 makes the write impossible through
// `setKid` (compiler/ast.bit). `Repo<T>` here is a stand-in with the shape the
// analysis matches (a class named `Repo` over a `@table` class, with `find` and
// `with`), so no database is needed; the reads are guarded so none runs. Every
// one of the 20 `find` calls must have received its `with`.
class Sink {
  withs: int,
  finds: int,
}

@table class Author {
  id: i64
  name: string
  @hasMany("authorId")
  posts: []Post
}

@table class Post {
  id: i64,
  authorId: i64,
}

class Repo<T> {
  sink: Sink
  names: []string
  export with(name: string): Repo<T> {
    return Repo<T>{ sink = this.sink, names = append(this.names, name) }
  }
  export find(id: i64): T! {
    this.sink.finds = this.sink.finds + 1
    this.sink.withs = this.sink.withs + len(this.names)
    return T{}
  }
}

fn read0(repo: Repo<Author>): ()! {
  let a = repo.find(0)?
  if (a.id < 0) {
    println("${len(a.posts)}")
  }
}

