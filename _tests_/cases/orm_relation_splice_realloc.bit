fn main(): ()! {
  let sink = Sink{ withs = 0, finds = 0 }
  let repo = Repo<Author>{ sink = sink, names = []string(0) }
  read0(repo)?
  read1(repo)?
  read2(repo)?
  read3(repo)?
  read4(repo)?
  read5(repo)?
  read6(repo)?
  read7(repo)?
  read8(repo)?
  read9(repo)?
  read10(repo)?
  read11(repo)?
  read12(repo)?
  read13(repo)?
  read14(repo)?
  read15(repo)?
  read16(repo)?
  read17(repo)?
  read18(repo)?
  read19(repo)?
  println("finds ${sink.finds}, withs ${sink.withs}")
}
