// error
// #7005: the literal after a class argument is checked against the class that
// argument names: a key that is not a field of `Article` is E0301 naming it.
import { Class, Where } from "std/where"

class Article {
  id: i64,
  authorId: i64,
}

class Comment {
  id: i64,
  body: string,
}

class Policy {
  can<T>(action: string, res: Class<T>, where: Where<T>): bool {
    return true
  }
}

fn main() {
  let p = Policy{}
  let ok = p.can("read", Comment, { body: "hi" })
  let bad = p.can("read", Article, { body: "hi" })
}
