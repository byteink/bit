// error
// A local value shadowing a free function is NOT a way to call that function
// (SPEC §17.5): the nearer binding wins outright, so calling it when it is not
// func-typed is E0049, exactly as if no such declaration existed.
//
// Both the `let` and the parameter once passed silently. `vNotCallable` asked
// the NAME-keyed `funcSigLookup`, which found the shadowed declaration's
// signature and excused the call (#1555); lowering then emitted a direct call
// to that declaration, so the program printed `pick`'s answer (#1552).
fn pick(n: int): int {
  return n + 100
}

fn viaParam(pick: int): int {
  return pick(21)
}

fn main() {
  let pick = 5
  print("${pick(21)}\n")
  print("${viaParam(5)}\n")
}
