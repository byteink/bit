// run
// SPEC 12.9 / 11.6 (#4363): a widening `T(x)` must canonicalize its SOURCE
// unless the source register is already width-canonical.
//
// `emitConvert`/`xEmitConvert` drop the source-width extend when the value came
// from a narrow load, which already writes the full 64-bit register. Every
// other producer keeps it — and `asm` is the one this case can reach from
// source: the block leaves 0x000000000000FFFF in the result register and
// declares the result `u8`, so bits 8..15 are exactly the garbage the extend
// exists to clear.
//
// WITHOUT the extend this prints 65535 AND EXITS 0. That is why this case is
// here rather than a comment: the whole rest of the corpus passes with the
// elision made unconditional, because every other u8 in it comes from a load
// or from arithmetic that `canonNarrow` already re-narrowed.
@nosplit fn garbageByte(): u8 {
  return asm {
    arm64 { 0xD29FFFE0 }                 // movz x0, #0xFFFF
    x64 { 0xB8, 0xFF, 0xFF, 0x00, 0x00 } // mov  eax, 0xFFFF
    result arm64 x0 x64 rax : u8
  }
}

fn main() {
  let v = garbageByte()
  print("${int(v)}\n")
}
