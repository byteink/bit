// run
// #1625: a @nosplit body may READ a top-level `const [N]T` rodata table (#1231).
// Indexing a fixed array lowers to `index_get` — a scaled register-offset load
// with no bounds-check branch, call, allocation or safepoint — so the @nosplit
// allowlist admits it (a slice/map index, an rt_call, stays E0075). Without this
// the transcendental ports (#1609) could not hold their constant tables. Reads
// must return the authored bytes and the @nosplit function must be accepted.
// #4270 narrowed this to PROVABLY-in-range indices only — `i & 3` is masked
// into `[0,3]`, which is what still earns the no-branch admission here; a
// bare `TAB[i]` no longer would (check_nosplit_array_index_unmasked.bit).
// Single-file golden: no prelude.
const TAB: [4]u64 = [4]u64{ 11, 22, 33, 44 }

@nosplit fn pick(i: int): u64 {
  return TAB[i & 3]
}

fn main() {
  if (pick(0) == 11 && pick(1) == 22 && pick(3) == 44) {
    print("nosplit-read-ok\n")
  }
}
