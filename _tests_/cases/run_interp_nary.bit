// run
// #4037: interpolation lowers through `string_concat8`, seven parts per
// allocation, instead of the seed's binary left fold. This case pins the
// OBSERVABLE result at every boundary that lowering now branches on, since the
// fold shape is invisible from the outside and a mis-copied part is not.
//
//   k = 1        the sole operand, returned with no call at all
//   k = 2        the binary `string_concat`
//   k = 3, 7     one `string_concat8` with 5 / 1 padding operands
//   k = 8        one `string_concat8`, exactly full, no padding
//   k = 9        `string_concat8` then the binary call (take == 1)
//   k = 15       two full `string_concat8`
//   k = 17       two full, then a third with 5 pads
//
// Empty literal segments are dropped, so a leading or trailing `${` moves the
// count. Adjacent operands with NO separator are deliberate: a piece copied one
// byte short or one byte long shows up as a shifted boundary rather than as a
// missing tail, which a trailing-newline-only case would hide.
class Tag {
  name: string
  show(): string {
    return "<${this.name}>"
  }
}
fn main() {
  let a = 1
  let b = 22
  let c = 333
  let d = 4444
  let e = 55555
  let f = 666666
  let g = 7777777
  let h = 88888888
  let u: u64 = 18446744073709551615
  let x: f64 = 2.5
  let t = true
  let s = "s"
  let n = ""

  // k = 1: nothing but the operand.
  print("${c}\n")
  // k = 2: one binary concat, each way round.
  print("${c}!\n")
  print("!${c}\n")
  // k = 3 and k = 7: padded `string_concat8`.
  print("[${a}]\n")
  print("[${a}|${b}|${c}]\n")
  // k = 8: exactly full, no padding operand at all.
  print("${a}-${b}-${c}-${d}\n")
  // k = 9: a full `string_concat8` then the binary tail.
  print("<${a}-${b}-${c}-${d}>\n")
  // k = 15: two full calls, no padding.
  print("<${a}.${b}.${c}.${d}.${e}.${f}.${g}>\n")
  // k = 17: two full then a padded third.
  print("<${a}.${b}.${c}.${d}.${e}.${f}.${g}.${h}>\n")

  // Adjacent operands, no separators: a boundary shift is visible.
  print("${a}${b}${c}${d}${e}${f}${g}${h}${a}${b}${c}${d}\n")
  // Empty operands between real ones must contribute nothing.
  print("[${n}${a}${n}${n}${b}${n}]\n")
  // Every operand kind through one wide literal.
  print("i=${a} u=${u} f=${x} b=${t} s=${s} o=${Tag{ name: s }}\n")
  // Non-ASCII on both sides of an operand, and inside one.
  print("ünï${a}cödé — naïve ${s}✓${b}\n")
  // Escapes decode before the empty-segment test: `\t` is not an empty piece.
  print("${a}\t${b}\n")
}
