// run
// #3862: passing an indexed element straight into a call (`consume(xs[0])`,
// no intervening binding) is the same escape as the handle-binding case —
// the call needs a real reference, and an inline element has none — so
// `Node` stays boxed (stride 8) for the whole module. Named separately from
// `run_slice_inline_bail_handle.bit` because the ticket's predicate lists it
// as its own trigger ("passing xs[i] to a call"), reached through a
// different AST shape (no `Tag.Member`/`Tag.Ident` handle at all, `xs[i]`
// straight into `Tag.Arg`).
class Node { x: i64, y: i64 }

fn consume(n: Node): i64 {
  return n.x + n.y
}

fn main() {
  let batch = [Node{ x: 1, y: 2 }, Node{ x: 3, y: 4 }]
  print("${consume(batch[0])} ${consume(batch[1])}\n")
}
