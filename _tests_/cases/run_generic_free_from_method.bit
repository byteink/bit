// run
// #4523. The fourth row of that ticket's table: a generic METHOD whose body
// calls a generic FREE fn that does a `.` on its own bounded type parameter.
// The method reached the free fn only through the ledger entry the check pass
// recorded from inside the method's (template) body, which bound the method's
// own `T` — degenerate. Pass A2 emitted `freeList<T>` and lowering refused the
// program with E0092 at `x.label()`, inside a function that is correct.
//
// Same root as #4499 (the free-function half); this pins the METHOD entry
// point, which #4495 routed through the same ledger.

interface Named {
  label(): string,
}

class Tag {
  export label(): string {
    return "tag"
  }
}

fn freeList<T: Named>(xs: []T): string {
  let out = ""
  for x of xs {
    out = out + x.label()
  }
  return out
}

fn freeOne<T: Named>(v: T): string {
  return v.label()
}

class Box {
  export viaFree<T: Named>(xs: []T): string {
    return freeList(xs)
  }

  export viaOne<T: Named>(v: T): string {
    return freeOne(v)
  }
}

fn main() {
  // Direct, concrete: fine on its own, and the control for the two below.
  print(freeList([]Tag{ Tag{} }) + "\n")
  print(Box{}.viaFree([]Tag{ Tag{}, Tag{} }) + "\n")
  print(Box{}.viaOne(Tag{}) + "\n")
}
