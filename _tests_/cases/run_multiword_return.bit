// run
// A result handed back in more than one ABI return register (#4405), and the
// shapes that must keep the one-handle convention beside it.
//
// Every function here is deliberately UNINLINABLE — each carries a `while`, and
// `calleeShapeOk` (optinline.bit) refuses a looping callee — because an inlined
// callee's `ret` is replaced by a join-block edge and the return convention is
// never exercised at all. A version of this case without the loops passes with
// the whole feature reverted.
//
// The `.expected` beside it was generated by the PRE-#4405 compiler, so it is
// an oracle for the change rather than a restatement of it: the observable
// answer is required to be exactly what the boxed convention produced.

// Two words, both integer: x0, x1.
fn divmod(n: int, d: int): (int, int) {
  let q = 0
  let r = n
  while (r >= d) {
    q = q + 1
    r = r - d
  }
  return q, r
}

// Three words.
fn scale(n: int): (int, int, int) {
  let a = 0
  let i = 0
  while (i < n) {
    a = a + i
    i = i + 1
  }
  return a, a * 2, a * 3
}

// A GC REFERENCE beside an integer. Each word carries its own type, so the
// traced one gets its own stack-map entry exactly as a boxed handle did.
fn label(n: int): (string, int) {
  let s = ""
  let i = 0
  while (i < n) {
    s = s + "x"
    i = i + 1
  }
  return s, len(s)
}

// Mixed register classes. AAPCS64 counts int and float return registers
// INDEPENDENTLY, so this comes back in {x0, d0} and not {x0, x1} — assigning a
// flat x0/x1 would hand the caller garbage for the second word.
fn measure(n: int): (int, f64) {
  let a = 0
  let i = 0
  while (i < n) {
    a = a + 1
    i = i + 1
  }
  return a, 0.5
}

// Eight words: exactly the return-register budget, the widest shape that is
// handed back in registers.
fn eight(n: int): (int, int, int, int, int, int, int, int) {
  let a = 0
  let i = 0
  while (i < n) {
    a = a + 1
    i = i + 1
  }
  return a, a + 1, a + 2, a + 3, a + 4, a + 5, a + 6, a + 7
}

// NINE words: one past the budget. There is no spill path for a return word
// and none is to be built (#4238), so the front end refuses the shape and this
// keeps the boxed convention — which is why no source program can reach
// `retRegsFor`'s assert.
fn nine(n: int): (int, int, int, int, int, int, int, int, int) {
  let a = 0
  let i = 0
  while (i < n) {
    a = a + 1
    i = i + 1
  }
  return a, a, a, a, a, a, a, a, a
}

// Members narrower than a word: a word is the unit both the argument marshaller
// and the stack map deal in, so a sub-word member has no packing rule and this
// keeps the boxed convention too.
fn narrow(n: int): (i32, bool) {
  let a = 0
  let i = 0
  while (i < n) {
    a = a + 1
    i = i + 1
  }
  return i32(a), a > 2
}

// A FALLIBLE function is excluded whole: its body returns through several
// producers that each also owe the error slot, and the ABI needs all of them to
// agree on the width.
fn checked(n: int): (int, int)! {
  if (n < 0) {
    fail newError("negative")
  }
  let a = 0
  let i = 0
  while (i < n) {
    a = a + 1
    i = i + 1
  }
  return a, a * 2
}

// `return f()` hands one exploded result straight into another.
fn forward(n: int): (int, int) {
  let a = 0
  let i = 0
  while (i < n) {
    a = a + 1
    i = i + 1
  }
  return divmod(a * 7, 3)
}

// A whole tuple VALUE returned, rather than a `return a, b` list: the words are
// read back out of it, so both spellings agree on the width.
fn whole(n: int): (int, int) {
  let a = 0
  let i = 0
  while (i < n) {
    a = a + 1
    i = i + 1
  }
  let t = (a, a * 11)
  return t
}

// A `defer` runs between the value and the `ret`.
fn deferred(n: int): (int, int) {
  defer print("defer ran\n")
  let a = 0
  let i = 0
  while (i < n) {
    a = a + 1
    i = i + 1
  }
  return a, a + 100
}

fn main() {
  let (q, r) = divmod(47, 10)
  print("divmod ${q} ${r}\n")

  let (a, b, c) = scale(5)
  print("scale ${a} ${b} ${c}\n")

  let (s, k) = label(4)
  print("label ${s} ${k}\n")

  let (m, f) = measure(3)
  print("measure ${m} ${f}\n")

  let (e0, e1, e2, e3, e4, e5, e6, e7) = eight(1)
  print("eight ${e0} ${e1} ${e2} ${e3} ${e4} ${e5} ${e6} ${e7}\n")

  let (n0, n1, n2, n3, n4, n5, n6, n7, n8) = nine(2)
  print("nine ${n0} ${n1} ${n2} ${n3} ${n4} ${n5} ${n6} ${n7} ${n8}\n")

  let (w, t) = narrow(9)
  print("narrow ${w} ${t}\n")

  let (ck, cv) = checked(3) catch e { print("checked failed ${e.message()}\n"); return }
  print("checked ${ck} ${cv}\n")

  let (fq, fr) = forward(6)
  print("forward ${fq} ${fr}\n")

  let (wa, wb) = whole(3)
  print("whole ${wa} ${wb}\n")

  let (da, db) = deferred(2)
  print("deferred ${da} ${db}\n")

  // `t.N` reads an element out of the aggregate the call site rebuilds.
  let tup = divmod(99, 8)
  print("index ${tup.0} ${tup.1}\n")

  // Through a function VALUE. The trampoline is reached by `call_value`, which
  // knows only the func type, so it keeps the one-word convention and re-boxes
  // the words its direct call gets back.
  let g = divmod
  let (gq, gr) = g(31, 4)
  print("value ${gq} ${gr}\n")

  // A discarded result: the callee still writes every return register, the
  // caller reads none of them.
  spawn scale(3)
  print("done\n")
}
