// run
// Traits (SPEC §10.7, #5188): `trait_method = IDENT [ generic_params ]
// signature [ block ]` admits an OPTIONAL `<...>` the same way an ordinary
// method does. `identity` is REQUIRED (no body) and is satisfied by the
// class's own generic method (#3367's ordinary in-body path, unaffected by
// this ticket); `wrap` is PROVIDED and is injected into `Box` with its own
// type param merged with the class's (checktraitinject.bit's cloneTraitMethod),
// so it monomorphises once per instantiated call site (SPEC §13.6) exactly
// like any other generic method.
trait Identifiable {
  identity<U>(v: U): U
  wrap<U>(v: U): (U, U) { return (this.identity<U>(v), v) }
}

class Box {
  use Identifiable
  identity<U>(v: U): U { return v }
}

fn main() {
  let b = Box{}
  print("${b.identity<i64>(7)}\n")
  let (a, c) = b.wrap<string>("hi")
  print("${a} ${c}\n")
}
