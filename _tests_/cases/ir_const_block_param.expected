func oneEdge(%0: bool) i64 {
bb0(%0: bool):
  %1 = const_bool true
  br %0, bb1(), bb2(%0, %1)
bb1():
  %3 = const_int i64 1
  ret %3
bb2(%5: bool, %6: bool):
  jump bb3()
bb3():
  %8 = const_int i64 2
  ret %8
}

func twoEdges(%0: bool) i64 {
bb0(%0: bool):
  %1 = const_bool false
  br %0, bb1(), bb2(%0, %1)
bb1():
  %3 = const_bool true
  jump bb2(%0, %3)
bb2(%5: bool, %6: bool):
  br %6, bb3(), bb4(%5, %6)
bb3():
  %8 = const_int i64 1
  ret %8
bb4(%10: bool, %11: bool):
  %12 = const_int i64 2
  ret %12
}
