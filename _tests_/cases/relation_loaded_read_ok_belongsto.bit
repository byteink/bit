// run
//
// #6290: the singular half of relation_loaded_read_ok.bit -- the same
// `@belongsTo` field, LOADED (a real `Author` assigned before the read),
// prints its name with no panic. An ordinary field assignment
// (compiler/loweraccess.bit's `lowerFieldStore`) writes a real class
// reference, which is never classrelationattr.bit's `relationUnloadedSentinel`,
// so the read-side check (`emitRelationUnloadedCheck`) passes it straight
// through -- the same sentinel-comparison mechanism
// relation_loaded_read_ok.bit already pins for a `[]T` (`@hasMany`) field,
// now proven for a bare class-typed one too.
import { FieldDesc, AttrDesc } from "std/sql"

@table class Author {
  @id
  id: i64
  name: string
}

@table class Post {
  @id
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn main() {
  let p = Post{ id = 1, authorId = 7 }
  p.author = Author{ id = 7, name = "Ada" }
  print("${p.author.name}\n")
}
