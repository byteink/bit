// run
// #4375: `while (i < len(xs)) { ... xs[i] ... }` no longer bounds-tests the
// element load. The header's SIGNED test already decided it, once `i` is proven
// non-negative — but "proven" is a claim about the LOWERING, and the shapes
// that could falsify it are the ones that move a slice's length or its buffer
// while the loop is running, or that hand the loop a base with no buffer at
// all. Those are what this case pins, from the outside, as program behaviour.
//
// Every arm produced this exact output before the check was removed; the case
// is worthless unless it is compared against that, which is why each element is
// printed in sequence with its count rather than only a sum. A removal that
// reached one element too far would read adjacent heap and print a plausible
// number, not crash (#4346 measured that shape on the string byte load: four of
// five fixtures exited 0 with `byte=116`).
import { args } from "std/os"

class Z { xs: []int, s: string }

// Non-foldable 0/1, so nothing below collapses into a constant the optimizer
// could answer without running the loop.
fn zero(): int { return len(args()) - 1 }

// APPEND TO THE SLICE BEING INDEXED. `bit_rt_slice_append` mutates the header
// IN PLACE, so `len(xs)` — which the header re-reads every iteration — GROWS
// under the loop, and the first append also passes `cap`, reallocating the
// buffer and resetting `off`. The load must address the post-grow buffer.
fn appendDuring(): string {
  let xs = [1, 2, 3]
  let seen = ""
  let i = 0
  while (i < len(xs)) {
    seen = seen + "${xs[i]} "
    if (i < 3) {
      xs = append(xs, xs[i] * 10)
    }
    i = i + 1
  }
  return "${seen}| i=${i} len=${len(xs)}"
}

// REBIND TO A LONGER SLICE MID-LOOP. `xs[lo:hi]` allocates a FRESH header, so
// the length the header tests and the buffer the load addresses both change
// identity between iterations.
fn resliceDuring(): string {
  let ys = [4, 5, 6, 7, 8]
  let xs = ys[zero():zero() + 2]
  let seen = ""
  let i = 0
  while (i < len(xs)) {
    seen = seen + "${xs[i]} "
    xs = ys[zero():zero() + 4]
    i = i + 1
  }
  return "${seen}| i=${i} len=${len(xs)}"
}

// THE ZERO-LENGTH BASES. A zeroed class's slice field is the NULL WORD, not an
// empty header (SPEC §13.4, #1564): `slice_len` reads a null header as 0, so
// the header test fails on the first iteration and the unchecked load is never
// reached. An empty-but-real header is the same story by a different route, and
// both must iterate zero times rather than fault.
fn emptyBases(): string {
  let z = Z{}
  let n = 0
  let i = 0
  while (i < len(z.xs)) {
    n = n + 1000
    i = i + 1
  }
  let e = []int(zero())
  let j = 0
  while (j < len(e)) {
    n = n + 100
    j = j + 1
  }
  return "n=${n} nulllen=${len(z.xs)} emptylen=${len(e)} i=${i} j=${j}"
}

// A PACKED `[]u8` (stride 1) and a REFERENCE element type take different arms
// of the element load, so both are walked rather than only the i64 one. The
// `[]u8` loop also WRITES through the same index, which is the `index_set` half
// of the same check.
fn packedAndRef(): string {
  let bs = []u8(zero())
  bs = append(bs, u8(65))
  bs = append(bs, u8(66))
  bs = append(bs, u8(67))
  let i = 0
  while (i < len(bs)) {
    bs[i] = u8(int(bs[i]) + 1)
    i = i + 1
  }
  let out = ""
  let k = 0
  while (k < len(bs)) {
    out = out + "${bs[k]} "
    k = k + 1
  }
  let zs = []Z(zero())
  zs = append(zs, Z{ xs: [9], s: "a" })
  zs = append(zs, Z{ xs: [8, 7], s: "b" })
  let m = 0
  while (m < len(zs)) {
    out = out + "${zs[m].s}${len(zs[m].xs)} "
    m = m + 1
  }
  return out
}

// A NESTED loop over the same base, and a `continue` — the back edge into the
// header then comes from a block the body's own branch reaches, not from the
// body's fall-through, which is a different predecessor shape for the induction
// proof to read.
fn nestedAndContinue(): string {
  let xs = [1, 2, 3, 4]
  let total = 0
  let i = 0
  while (i < len(xs)) {
    if (xs[i] == 2) {
      i = i + 1
      continue
    }
    let j = 0
    while (j < len(xs)) {
      total = total + xs[i] * xs[j]
      j = j + 1
    }
    i = i + 1
  }
  return "total=${total}"
}

fn main() {
  print("append: ${appendDuring()}\n")
  print("reslice: ${resliceDuring()}\n")
  print("empty: ${emptyBases()}\n")
  print("mixed: ${packedAndRef()}\n")
  print("nested: ${nestedAndContinue()}\n")
}
