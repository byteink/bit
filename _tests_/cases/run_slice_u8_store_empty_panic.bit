// panic
// #4381: index 0 of an EMPTY `[]u8`. Distinct from the null-header sibling —
// this header is real and its buffer is a live zero-length allocation, so
// `slice_len` returns 0 from a word it actually read rather than from the
// null-safe fallback. It is the shape where `0 < 0` is the whole bounds test
// and an off-by-one in either direction admits a store into a buffer with no
// elements at all.
import { args } from "std/os"

fn none(): int { return len(args()) - 1 }

fn main() {
  let bs = []u8(none())
  let neighbour = []u8(2)
  neighbour[0] = 9
  print("start len=${len(bs)}\n")
  bs[none()] = 200
  print("survived neighbour=${int(neighbour[0])}\n")
}
