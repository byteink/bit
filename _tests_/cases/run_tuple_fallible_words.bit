// run
// #5874: a fallible tuple result `(A, B)!` returns its OK value in words, one
// return register per member, instead of a heap box. The error still rides the
// per-task slot. One function per path that produces or consumes the words:
//
//   1. `f()?` ok      the words cross the `err_get` branch into `cont`
//   2. `f()?` fail    the propagate edge returns W zero words
//   3. `catch (d, e)` the join takes one parameter per word from both edges
//   4. `catch e {}`   the handler block's value is taken apart the same way
//   5. `defer`        a deferred call runs between the words and the `ret`
//   6. a fn value     the trampoline rebuilds one box from the words
//
// Every tuple carries a `string` built at run time, so it is a traced word
// that only a return register holds. `churn` allocates while that word is
// live, so under `BIT_GC=stress` a word the stack map missed reads freed
// memory. `(f64, bool, string)` puts a word in each register class and a
// sub-word member at offset 8.

class Neg {
  n: int
  message(): string { return "neg ${this.n}" }
}

fn two(a: int): (int, string)! {
  if (a < 0) {
    fail Neg{ n = a }
  }
  return a * 2, "s${a}"
}

fn three(a: int): (f64, bool, string)! {
  if (a < 0) {
    fail Neg{ n = a }
  }
  return f64(a) / 4.0, a > 2, "t${a}"
}

// Allocates `n` short-lived strings, so a collection can land while a
// returned word is live.
fn churn(n: int): int {
  let total = 0
  let i = 0
  while (i < n) {
    let s = "c${i}"
    total = total + len(s)
    i = i + 1
  }
  return total
}

// Paths 1 and 2.
fn viaTry(a: int): (int, string)! {
  let (n, s) = two(a)?
  let c = churn(50)
  return n + c, "${s}+"
}

// Path 5: the defer runs on the ok path and on the propagate path.
fn withDefer(a: int): (f64, bool, string)! {
  defer print("defer ${a}\n")
  let (x, b, s) = three(a)?
  return x * 2.0, !b, "${s}!"
}

// Path 6.
fn callThrough(f: (int) => (int, string)!, a: int): string {
  let (n, s) = f(a) catch (-9, "fv")
  return "${n} ${s}"
}

fn shapeTry() {
  let (n, s) = viaTry(5) catch (-1, "d")
  let c = churn(50)
  print("try ok ${n} ${s} ${c}\n")
  let (m, t) = viaTry(-5) catch (-1, "d")
  print("try fail ${m} ${t}\n")
}

fn shapeCatch() {
  let (n, s) = two(7) catch (-1, "d")
  let c = churn(50)
  print("catch ok ${n} ${s} ${c}\n")
  let (m, t) = two(-7) catch (-1, "d")
  print("catch fail ${m} ${t}\n")
}

fn shapeBlock() {
  let (n, s) = two(3) catch e {
    print("unreached ${e.message()}\n")
    (-2, "blk")
  }
  print("block ok ${n} ${s}\n")
  let (m, t) = two(-3) catch e {
    print("caught ${e.message()}\n")
    (-2, "blk")
  }
  print("block fail ${m} ${t}\n")
}

fn shapeDefer() {
  let (x, b, s) = withDefer(6) catch (-1.0, false, "d")
  print("defer ok ${x} ${b} ${s}\n")
  let (y, c, t) = withDefer(-6) catch (-1.0, false, "d")
  print("defer fail ${y} ${c} ${t}\n")
}

// Many crossings, each word live across `churn`'s allocations.
fn shapeLoop() {
  let sum = 0
  let i = -3
  while (i < 40) {
    let (n, s) = two(i) catch (0, "z")
    sum = sum + churn(3) + n + len(s)
    i = i + 1
  }
  print("loop ${sum}\n")
}

fn main() {
  shapeTry()
  shapeCatch()
  shapeBlock()
  shapeDefer()
  shapeLoop()
  print("fnval ${callThrough(two, 4)} | ${callThrough(two, -4)}\n")
}
