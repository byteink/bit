// run
// #4351: `Builder.write(s)` copies `s` in ONE `append(this.buf, s)` (the
// bytes shape, #4371 / SPEC §12.6) instead of one `append` per byte. The
// bytes that come out must not move, so this pins the boundaries the
// rewrite could have shifted:
//
//   - length 0 (the runtime's `n == 0` early return),
//   - 1 and 15 (inside `initialCap`),
//   - 16 (exactly `initialCap`, the last size that never grows),
//   - 17 (the first that does, and the first where the growth policy
//     `max(2 * cap, len + n)` differs from doubling-per-byte),
//   - 4096 (one allocation now, twelve doublings before),
//
// each into a FRESH builder and into a PRE-FILLED one, since the pre-filled
// case is the only one where a partially used buffer is extended in place.
//
// The last block asserts the aliasing contract directly rather than by
// reference: the element form and the bytes form of `append` are run over
// identical byte slices and must observe the same header, the same buffer
// and the same overwrite through a reslice. Only the CAPACITY may differ —
// the bytes form grows once to `max(2 * cap, len + n)` where the element
// form doubles — and `Builder` exposes neither `cap` nor the buffer, so no
// Builder observation above can see it.
import { newBuilder, repeat } from "std/strings"

fn probe(label: string, prefill: string, s: string) {
  let b = newBuilder()
  if (len(prefill) > 0) {
    b.write(prefill)
  }
  b.write(s)
  let out = b.toString()
  let head = ""
  let tail = ""
  if (len(out) > 0) {
    head = out[0:1]
    tail = out[len(out) - 1:len(out)]
  }
  let sum = 0
  let i = 0
  while (i < len(out)) {
    sum = (sum * 31 + int(out[i])) % 1000003
    i = i + 1
  }
  println("${label}: len=${b.length()} head=[${head}] tail=[${tail}] sum=${sum}")
}

fn main() {
  let lens = [0, 1, 15, 16, 17, 4096]
  let k = 0
  while (k < len(lens)) {
    let n = lens[k]
    let s = repeat("ab", n / 2)
    if (n % 2 == 1) {
      s = s + "c"
    }
    probe("fresh-${n}", "", s)
    probe("prefill10-${n}", "0123456789", s)
    k = k + 1
  }

  // Many small writes across the growth boundary, then a large one.
  let b = newBuilder()
  let j = 0
  while (j < 40) {
    b.write("xy")
    j = j + 1
  }
  b.write(repeat("Z", 1000))
  println("mixed: len=${b.length()} at79=[${b.toString()[79:80]}] at80=[${b.toString()[80:81]}]")

  // Empty writes must be no-ops, interleaved with real ones.
  let e = newBuilder()
  e.write("").write("a").write("").writeByte('b').write("")
  println("empty-noop=[${e.toString()}] len=${e.length()}")

  // Aliasing, element form vs bytes form over identical inputs.
  let ce = []byte(0, 8)
  ce = append(ce, 'A')
  ce = append(ce, 'B')
  ce = append(ce, 'C')
  ce = append(ce, 'D')
  let cb = []byte(0, 8)
  cb = append(cb, "ABCD")
  println("alias-init: elem=[${string(ce)}] bytes=[${string(cb)}] lene=${len(ce)} lenb=${len(cb)}")

  let ve = ce[0:2]
  let ve2 = append(append(ve, 'x'), 'y')
  let vb = cb[0:2]
  let vb2 = append(vb, "xy")
  println(
    "alias-view: elem c2=${int(ce[2])} c3=${int(ce[3])} v2len=${len(ve2)} | bytes c2=${int(
      cb[2],
    )} c3=${int(cb[3])} v2len=${len(vb2)}",
  )

  // A null header takes the runtime's allocate-then-fill path in both forms.
  let ne: []byte = []
  let nb: []byte = []
  ne = append(ne, 'q')
  nb = append(nb, "q")
  println("alias-null: elem=[${string(ne)}] bytes=[${string(nb)}] lene=${len(ne)} lenb=${len(nb)}")
}
