// run
// #2020: `for v of c` over a channel — SPEC §16.2's range form, "receives until
// the channel is closed and drained". `bit check` accepted it and no compiler
// ever lowered it, so `bit build` refused with a spanless "cannot lower"; and
// `grep -rn 'of c {' _tests_/cases examples` found no channel-range loop anywhere,
// which is why a form named in the spec stayed unimplemented.
//
// It is the idiomatic consumer side of a worker pool: without it every consumer
// must know in advance how many values will arrive, or invent a sentinel — the
// bookkeeping the `(zero, false)` close protocol exists to remove.
//
// A golden case is a single file, so it has no prelude.
class Box {
  n: i64,
}

fn producer(c: chan<i64>, n: i64) {
  for (let i = 0; i < n; i++) {
    c <- i
  }
  close(c)
}

fn boxer(c: chan<Box>) {
  c <- Box{ n: 4 }
  c <- Box{ n: 5 }
  close(c)
}

fn main() {
  // A spawned producer, consumed to a closed-form total: 0+..+9 = 45.
  let c = chan<i64>(4)
  spawn producer(c, 10)
  let sum = 0
  for v of c {
    sum = sum + v
  }
  print("sum=${sum}\n")

  // Closed before the loop starts, with nothing buffered: zero iterations.
  let empty = chan<i64>(1)
  close(empty)
  let runs = 0
  for v of empty {
    runs = runs + v + 1
  }
  print("empty=${runs}\n")

  // Values already buffered when the close lands still drain, in order.
  let buffered = chan<i64>(4)
  buffered <- 3
  buffered <- 4
  close(buffered)
  let order = ""
  for v of buffered {
    order = order + "${v},"
  }
  print("buffered=${order}\n")

  // `break` leaves the loop with the channel still open and undrained.
  let more = chan<i64>(4)
  more <- 1
  more <- 2
  more <- 3
  let seen = 0
  for v of more {
    seen = seen + 1
    if (v == 2) {
      break
    }
  }
  print("broke after ${seen}\n")
  // The channel survives the break: what was left is still receivable.
  let rest = <- more
  print("left ${rest}\n")

  // `continue` targets the receive, so a filtered drain still terminates.
  let odd = chan<i64>(8)
  spawn producer(odd, 6)
  let odds = 0
  for v of odd {
    if (v % 2 == 0) {
      continue
    }
    odds = odds + v
  }
  print("odds=${odds}\n")

  // A REFERENCE element: the binder holds a live object, so the loop must bind
  // the received word as the element type and not as a raw i64. The zero word a
  // closed channel yields is a null pointer, which is why the loop has to leave
  // on `ok` rather than hand the body one last "value".
  let boxes = chan<Box>(2)
  spawn boxer(boxes)
  let boxSum = 0
  for b of boxes {
    boxSum = boxSum + b.n
  }
  print("boxes=${boxSum}\n")
}
