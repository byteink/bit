// run
// #4182: a payload-carrying enum's zero value used to be a bare `ConstNil` —
// a null REFERENCE, not the live `{tag:0,nil}` object its declared zero-tag
// variant actually is. `Option<T>` (`stdlib/core/core.bit`) is declared
// `{ None, Some(T) }` specifically so its zero tag (`None`) carries no
// payload and so HAS a real zero value; reading it (a `match`, `isNone`,
// `isSome`) used to dereference the null and segfault the instant anything
// touched it, on all three surfaces below.
//
// Surface (1): a bare binding with no initializer.
// Surface (2): a composite-literal field the literal omits — the whole point
// of ordering `None` first is that a self-referential `class Node { next:
// Option<Node> }` stays constructible without naming `next` explicitly (see
// run_struct_cycle_option.bit for the ANNOTATED form of the same escape
// hatch, and error_struct_cycle.bit for why a bare `next: Node` cannot).
// Surface (3): `[]Option<T>(n)`, "n zero values" (SPEC §12.9).
//
// `Result<T, E>` has no such variant — BOTH `Ok` and `Err` carry a payload —
// and correctly has no zero value at all; that is covered as the E0083
// rejection case in error_enum_no_zero_value.bit, not here.
class Node { name: string, next: Option<Node> }

fn main() {
  let a: Option<int>
  println("bare_isNone=${isNone(a)}")

  let n = Node{ name: "leaf" }
  println("field_isNone=${isNone(n.next)}")

  let xs = []Option<int>(2)
  println("slice_len=${len(xs)}")
  println("slice_isNone_0=${isNone(xs[0])}")
  println("slice_isNone_1=${isNone(xs[1])}")
}
