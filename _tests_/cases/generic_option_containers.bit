// run
// #6679 audit: every generic body below reads a `T` payload through a path other
// than the `unwrapOr` of generic_option_string_field.bit — an `Option<T>` in a
// slice, in a map value, in a tuple, a match binding used in a block, a `let`
// bound match, a tuple `for` binder, a map `for` binder and a generic class
// field — and each is instantiated at `int` before `string`, the order that left
// the previous instance's binder types behind. Each result must be its own
// instance's: a `string` payload in a join typed `int` was refused by IR
// verification, a class or slice there passed it as a non-reference.
class Node {
  id: int,
}

class Stack<T> {
  items: []T,
  top: Option<T>,
}

fn first<T>(xs: []Option<T>, d: T): T {
  let out = d
  for x of xs {
    out = match (x) {
      Some(v) => v
      None => out
    }
  }
  return out
}

fn lookup<T>(m: map<string, Option<T>>, k: string, d: T): T {
  let o = m[k]
  match (o) {
    Some(v) => return v
    None => return d
  }
}

fn tup<T>(p: (T, Option<T>), d: T): T {
  let (a, b) = p
  let r = match (b) {
    Some(v) => v
    None => a
  }
  return r
}

fn bind<T>(o: Option<T>, d: T): T {
  match (o) {
    Some(v) => {
      let w = v
      return w
    }
    None => { return d }
  }
}

fn forTup<T>(ps: [](T, T), d: T): T {
  let out = d
  for (_, b) of ps {
    out = b
  }
  return out
}

fn letMatch<T>(o: Option<T>, d: T): T {
  let t = match (o) {
    Some(v) => v
    None => d
  }
  return t
}

fn mapIter<T>(m: map<string, T>, d: T): T {
  let out = d
  for (_, v) of m {
    out = v
  }
  return out
}

fn stackTop<T>(s: Stack<T>, d: T): T {
  return unwrapOr(s.top, d)
}

fn main() {
  println("${first([Option.Some(1)], 0)}")
  println(first([Option.Some("a")], "d"))
  println("${first([Option.Some(Node{ id = 3 })], Node{ id = 0 }).id}")
  let m1 = map<string, Option<int>>{}
  m1["k"] = Option.Some(5)
  println("${lookup(m1, "k", 0)}")
  let m2 = map<string, Option<string>>{}
  m2["k"] = Option.Some("five")
  println(lookup(m2, "k", "d"))
  println("${tup((1, Option.Some(2)), 0)}")
  println(tup(("x", Option.Some("y")), "d"))
  println("${bind(Option.Some(7), 0)}")
  println(bind(Option.Some("seven"), "d"))
  println("${forTup([(1, 2)], 0)}")
  println(forTup([("a", "b")], "d"))
  println("${letMatch(Option.Some(8), 0)}")
  println(letMatch(Option.Some("eight"), "d"))
  let mi = map<string, int>{}
  mi["z"] = 9
  println("${mapIter(mi, 0)}")
  let ms = map<string, string>{}
  ms["z"] = "nine"
  println(mapIter(ms, "d"))
  println("${stackTop(Stack<int>{ items = []int(0), top = Option.Some(4) }, 0)}")
  println(stackTop(Stack<string>{ items = []string(0), top = Option.Some("four") }, "d"))
}
