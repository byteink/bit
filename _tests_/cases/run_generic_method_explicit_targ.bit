// run
// #4579. A generic METHOD whose type parameter appears only in the RESULT, with
// the type argument written out at the call: `b.mk2<P>(1)`.
//
// `methodTypeArgsRaw` bound a method's own type params by structural inference
// from the value arguments alone and never read `explicitCallTypeArgs`, so `T`
// here was bound by nothing, the ledger recorded void, `methodCallResult` fell
// back to the bare `T` — and `bit check` exited 0 while lowering refused the USE
// of the result with E0092 "a `.` field access on a receiver that is not a class
// or interface". The free-function twin below is the CONTROL: `genericTypeArgs`
// has always read the explicit list, so `mk<P>(1)` worked throughout, and that
// asymmetry is what this pins closed.

class E {
  m: string

  export message(): string {
    return this.m
  }
}

class P {
  a: i64,
}

fn mk<T>(n: i64): T! {
  fail E{ m: "free" }
}

fn ok<T>(v: T): T {
  return v
}

class Box {
  n: int

  mk2<T>(n: i64): T! {
    fail E{ m: "method" }
  }

  // Bound by a value argument, not by the explicit list: the path that already
  // worked, kept beside the one that did not.
  echo<T>(v: T): T {
    return v
  }
}

fn main() {
  let b = Box{ n: 1 }
  let f = mk<P>(1) catch e {
    print("free ${e.message()}\n")
    let m = b.mk2<P>(1) catch e2 {
      print("method ${e2.message()}\n")
      print("inferred ${b.echo<i64>(7)}\n")
      print("free-inferred ${ok(9)}\n")
      return
    }
    print("unreachable ${m.a}\n")
    return
  }
  print("unreachable ${f.a}\n")
}
