// run
// #4413: N aggregates built in one block and exploded back into words at a
// call site. Before the store table held several bases, `max(0, N - 2)` of
// them survived as live `gc_alloc`s in the caller's loop — the table held one
// base, so each aggregate's construction cleared the previous one's stored
// slots, and `optimizeModule`'s two fold rounds peeled one aggregate each.
//
// This case is a BEHAVIOUR oracle, not an IR assertion: its `.expected` was
// generated by the compiler as it stood BEFORE that change, so it says what
// these programs must print, not what the optimizer happens to do. The IR
// counts are pinned separately by compiler/optcheck.bit's selfcheck arms.
//
// Three shapes, because the change draws a line and both sides of it matter.

// 1. FIVE scalar aggregates at one call site — the shape that allocated.
fn scalars(a: (i64, i64), b: (i64, i64), c: (i64, i64), d: (i64, i64), e: (i64, i64)): i64 {
  return a.0 * 1 +
    a.1 * 2 +
    b.0 * 3 +
    b.1 * 4 +
    c.0 * 5 +
    c.1 * 6 +
    d.0 * 7 +
    d.1 * 8 +
    e.0 * 9 +
    e.1 * 10
}

// 2. Three aggregates whose fields are POINTERS, so the value forwarded across
// the intervening allocation's safepoint is a live GC reference and has to be
// described by the stack map at that point.
fn refs(a: (string, string), b: (string, string), c: (string, string)): string {
  return a.0 + a.1 + b.0 + b.1 + c.0 + c.1
}

class Cell {
  n: i64,
}

// 3. THE REFUSAL. `p` and `q` are parameters, so this compiler cannot know they
// are different objects, and `main` deliberately passes the same one twice.
// Reading `p.n` after writing `q.n` must observe 2. A store table that held
// several bases without a distinctness fact answers 1 here — that is not a
// slower program, it is a wrong one.
fn aliased(p: Cell, q: Cell): i64 {
  p.n = 1
  q.n = 2
  return p.n
}

// 4. The second refusal: an allocation between the store and the load, through
// a base reached from outside. `keep` is recursive so the allocation cannot be
// inlined away and really does escape, which is what makes the barrier real.
fn keep(c: Cell, k: i64): i64 {
  if (k <= 0) {
    return 0
  }
  return keep(c, k - 1) + 1
}

fn foreign(p: Cell): i64 {
  p.n = 5
  let fresh = Cell{ n: 9 }
  let a = p.n
  return a + keep(fresh, 2) + fresh.n
}

fn main() {
  let total = 0
  let i = 0
  while (i < 4) {
    total = total +
      scalars((i, i + 1), (i + 2, i + 3), (i + 4, i + 5), (i + 6, i + 7), (i + 8, i + 9))
    i = i + 1
  }
  print("scalars ${total}\n")

  let j = 0
  while (j < 3) {
    let p = "p${j}"
    let q = "q${j}"
    print("refs ${refs((p, q), (q, p), (p, p))}\n")
    j = j + 1
  }

  let one = Cell{ n: 0 }
  print("aliased ${aliased(one, one)}\n")

  let two = Cell{ n: 0 }
  let three = Cell{ n: 0 }
  print("distinct ${aliased(two, three)}\n")
  print("foreign ${foreign(two)}\n")
  print("cells ${two.n} ${three.n}\n")
}
