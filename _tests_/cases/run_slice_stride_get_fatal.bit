// panic
// #3861: `bit_rt_slice_get` is word-valued (`(h, index, elemSize) -> u64`) and
// cannot represent a packed, non-ref element wider than one machine word
// without silently returning a truncated fragment of it. The compiler side
// (#3862) guarantees this call is never emitted for such a `T` — a field read
// lowers to a direct load at its own offset instead — so this proves the
// runtime's OWN defense: a stride the compiler should never pass must FATAL,
// not return a wrong-but-plausible value. See
// `run_slice_stride_roundtrip.bit` for the strides that DO work.
extern fn bit_rt_slice_new(want: int, capWant: int, isRef: int, elemSize: int): int
extern fn bit_rt_slice_append(h: int, word: int, isRef: int, elemSize: int): int
extern fn bit_rt_slice_get(h: int, index: int, elemSize: int): int

fn main() {
  let h = bit_rt_slice_new(0, 0, 0, 16)
  h = bit_rt_slice_append(h, 42, 0, 16)
  print("start\n")
  print("get=${bit_rt_slice_get(h, 0, 16)}\n")
  print("unreachable\n")
}
