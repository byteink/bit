// run
// std/math's `min`/`max` were `if (a < b) { return a } return b` and its
// mirror — correct for every ordinary pair, but IEEE 754 comparison is not
// a total order on NaN or on the two zeros, so both fell through to `b`
// exactly when that matters: NaN compares false against everything, and
// `-0.0 < 0.0` / `+0.0 > -0.0` are both false. The result was ARGUMENT-ORDER
// DEPENDENT — `min(a,b) != min(b,a)` — which is why every case below is
// checked in both orders (#2420).
//
// EVERY ZERO ASSERTION HERE DIVIDES INTO THE RESULT, same reason as
// `math_abs_negzero.bit`: `-0.0 == 0.0` is true, so `min(-0.0,+0.0) == -0.0`
// passes no matter which zero came back. `1.0 / +0.0` is `inf`, `1.0 / -0.0`
// is `-inf` — that is the only way to read the sign here.
//
// NaN prints as the literal string `nan` (runtime/root/floatfmt.bit), which
// observes propagation directly: `nan == nan` is false, so printing the
// value is used instead of an equality check.
//
// Oracle: Go's `math.Min`/`math.Max`. `Min(-0,+0) = Min(+0,-0) = -0`,
// `Max(-0,+0) = Max(+0,-0) = +0`, `Min/Max(x, NaN) = NaN` in either position.
import { min, max } from "std/math"

fn recip(x: f64): f64 {
  return 1.0 / x
}

fn main() {
  let nz = -0.0
  let pz = 0.0
  let nan = 0.0 / 0.0

  println("min(-0,+0)=${min(nz, pz)} recip=${recip(min(nz, pz))}")
  println("min(+0,-0)=${min(pz, nz)} recip=${recip(min(pz, nz))}")
  println("max(-0,+0)=${max(nz, pz)} recip=${recip(max(nz, pz))}")
  println("max(+0,-0)=${max(pz, nz)} recip=${recip(max(pz, nz))}")

  println("min(nan,3.0)=${min(nan, 3.0)}")
  println("min(3.0,nan)=${min(3.0, nan)}")
  println("max(nan,3.0)=${max(nan, 3.0)}")
  println("max(3.0,nan)=${max(3.0, nan)}")

  println("min(1.0,2.0)=${min(1.0, 2.0)} min(2.0,1.0)=${min(2.0, 1.0)}")
  println("max(1.0,2.0)=${max(1.0, 2.0)} max(2.0,1.0)=${max(2.0, 1.0)}")
}
