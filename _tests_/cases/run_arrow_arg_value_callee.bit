// run
// #4544: an arrow argument to a call whose CALLEE IS A VALUE takes its
// unannotated parameter types from the callee expression's own function type.
//
// `seedArrowExpectedCall` (compiler/checkarrow.bit) resolved a callee by NAME
// only: a bare ident naming a free function, or `recv.method(...)`. A call
// through a function VALUE — a local of function type, a parameter, a slice
// element, the result of another call — matched neither, so the arrow's own
// parameters stayed at type 0 and `t.v()` inside it reached lowering with a
// callee that resolves to nothing: `bit check` exited 0 and `bit build`
// refused the file with `error[E0092]: cannot lower a call whose callee does
// not resolve to a function`. The sixth seeded position, and the same
// check/lower divergence #4520 closed in `return` position.
//
// Four callee spellings are pinned because each reaches the value path from a
// different node shape: a local `let` (Tag.Ident that `shadowedByValue`
// rejects), a PARAMETER of function type, a slice element `fs[0](...)`
// (Tag.Index), and the result of a call `mk()(...)` (Tag.Call). The controls
// are the shapes resolved by NAME, which must keep resolving by name: a free
// function callee, and a method callee.
class Thing {
  n: int
  export v(): int { return this.n }
}

type Inner = (Thing) => int
type Fn3 = (Thing, Inner) => int

fn mk(): Fn3 {
  return (t, next) => {
    return next(t)
  }
}

// Control: a free function called by NAME with the identical arrow argument.
fn take(t: Thing, next: Inner): int {
  return next(t)
}

// The callee is a PARAMETER of function type, not a local.
fn viaParam(f: Fn3, t: Thing): int {
  return f(t, (x) => x.v())
}

// Control: a METHOD callee, resolved through the receiver's type.
class Box {
  base: int

  apply(t: Thing, next: Inner): int {
    return next(t) + this.base
  }
}

fn main() {
  let g: Fn3 = (t, next) => {
    return next(t)
  }
  println("local ${g(Thing{ n: 1 }, (t) => t.v())}")
  println("named ${take(Thing{ n: 2 }, (t) => t.v())}")
  println("param ${viaParam(mk(), Thing{ n: 3 })}")
  let fs = []Fn3{ mk() }
  println("index ${fs[0](Thing{ n: 4 }, (t) => t.v())}")
  println("call ${mk()(Thing{ n: 5 }, (t) => t.v())}")
  let b = Box{ base: 100 }
  println("method ${b.apply(Thing{ n: 6 }, (t) => t.v())}")
}
