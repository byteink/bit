// run
// #7676: `ptrOf` on module-level state follows the same element rule as on a
// slice (#7644): any non-reference scalar - integers, `bool`, `f32`, `f64` - not
// just integers. A module-level SLICE holds its header in the cell, so the
// pointer is the buffer's element 0 (header walk), where a module-level array
// or scalar cell IS the buffer and `ptrOf` is the cell's static address. Each
// form reads element 1 (or the value) back through the pointer.
let fs: []f32 = []f32{ 1.5, -2.25, 4.0 }
let bs: []bool = []bool{ false, true, false }
let ws: []i64 = []i64{ 10, 20, 30 }
let fa: [3]f32
let ba: [3]bool
let sc: f64 = 6.5

fn main() {
  let p = ptrOf(fs)
  println("slice f32 ${*p} ${*(p + 1)} ${*(p + 2)}")
  let q = ptrOf(bs)
  println("slice bool ${*q} ${*(q + 1)} ${*(q + 2)}")
  let r = ptrOf(ws)
  println("slice i64 ${*r} ${*(r + 1)} ${*(r + 2)}")
  fa[1] = 0.75
  ba[1] = true
  let a = ptrOf(fa)
  let b = ptrOf(ba)
  println("array f32 ${*a} ${*(a + 1)} bool ${*b} ${*(b + 1)}")
  let s = ptrOf(sc)
  println("scalar f64 ${*s}")
}
