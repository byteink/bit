// run
// stdlib/json/edit.bit's cstDeleteKey (#1725), removing a key from an
// object. A golden case is single-file with no prelude but CAN import
// std/json (see json_cst_roundtrip_one_edit.bit, #3063): _tests_/bit/golden.bit's
// checkRun runs `bit build <case>` with BIT_STDLIB exported, so the import
// below resolves exactly as it would for any other caller — this file no
// longer redeclares the lexer, the CST types, the CST parser, or the edit
// function under test.
//
// This used to assert survival via per-field CstEntry.trivia.leading[0]
// pokes against the pre-#1726 Trivia shape, which the current CstEntry
// doesn't have (see #3062). Deleting a key REMOVES a line, so the positional
// line-diff json_edit_set_existing.bit uses (#3063) doesn't transfer here
// either — same problem as json_edit_set_append.bit's insertion, mirrored:
// every line after the deletion point shifts, so comparing by index would
// falsely flag them as changed (#3062's decision). Instead this asserts
// full byte-equality of cstPrint(root2) against a derived expected
// document — json_cst_roundtrip_untouched.bit's shape — which validates
// every byte in one assertion: that "count" and its own leading comment are
// gone, AND that both surviving siblings ("name" and "flag", including
// their own leading comments) are byte-for-byte what they always were.
// Strictly stronger than the original: the old test never checked the
// comments' surrounding whitespace, and byte equality can't be fooled by
// how the model groups the trivia internally.
import { cstParse, cstDeleteKey, cstPrint } from "std/json"

// --- test -------------------------------------------------------------

fn main() {
  // Every key has its own leading comment. Deleting "count" must drop only
  // its own comment; "name"'s and "flag"'s must survive untouched.
  let source = "{\n  // comment before name\n  \"name\": \"old\",\n  // comment before count\n  \"count\": 1,\n  // comment before flag\n  \"flag\": true\n}"

  let root = cstParse(source) catch e {
    print("parse-error: ${e.message()}\n")
    return
  }

  let root2 = cstDeleteKey(root, []string{ "count" }) catch e {
    print("delete-error: ${e.message()}\n")
    return
  }

  // Derived by running cstPrint(root2) and capturing its actual output.
  let expected = "{\n  // comment before name\n  \"name\": \"old\",\n  // comment before flag\n  \"flag\": true\n}"
  let printed = cstPrint(root2)
  if (printed == expected) {
    print("roundtrip=match\n")
  } else {
    print("roundtrip=mismatch\n")
    print("---got---\n${printed}\n---want---\n${expected}\n")
  }
}
