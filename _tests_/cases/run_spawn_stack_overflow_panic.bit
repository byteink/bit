// panic
// #2246: a green thread's stack is fixed at `schedStackBytes` (262144 bytes,
// runtime/sched/sched.bit, raised from 65536 by #2613) and does not grow.
// Recursing past it inside `spawn` used to exit 139 with nothing on either
// stream. The bisected cliff on this frame shape was depth 1362 ok / 1363
// crash at the pre-#2613 64 KiB granule (1363 * 48 = 65424 = 64 KiB - 112);
// not re-bisected at 256 KiB since, so this case recurses to 16000 --
// 4x the old depth, preserving the same comfortable margin past the (4x
// larger) cliff -- rather than to a freshly measured frame count, so it
// pins the diagnostic itself rather than the exact frame where it fires. A
// depth pinned one frame past the boundary would flip on any unrelated
// codegen change that shifts the frame size by even a few bytes; this case
// must not need re-tuning for that.
fn down(n: int): int {
  if (n == 0) {
    return 0
  }
  return 1 + down(n - 1)
}

fn worker(depth: int, done: chan<int>) {
  done <- down(depth)
}

fn main() {
  let c = chan<int>(1)
  spawn worker(16000, c)
  print("start\n")
  print("unreachable: ${<- c}\n")
}
