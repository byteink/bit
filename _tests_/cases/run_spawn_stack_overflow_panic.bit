// panic
// #2246: a green thread's stack is fixed at `schedStackBytes` (262144 bytes,
// runtime/sched/identity.bit, raised from 65536 by #2613) and does not grow.
// Recursing past it inside `spawn` used to exit 139 with nothing on either
// stream. The bisected cliff on this frame shape was depth 1362 ok / 1363
// crash at the pre-#2613 64 KiB granule (1363 * 48 = 65424 = 64 KiB - 112);
// not re-bisected at 256 KiB since. 16000 frames stopped overflowing when
// #6561 let `down`'s call argument leave the callee-saved file: the frame
// fell to the bare 16-byte record (fp/lr on arm64, return address/rbp on
// x86-64), and 16000 * 16 = 256000 fits in the granule. 16 bytes is the
// smallest frame a function that calls can have on either target, so this
// case recurses to 100000 -- 1.6 MB, six times the granule at that floor --
// and pins the diagnostic itself rather than the exact frame where it
// fires. A depth derived from the current frame size would flip on any
// unrelated codegen change; this one cannot.
fn down(n: int): int {
  if (n == 0) {
    return 0
  }
  return 1 + down(n - 1)
}

fn worker(depth: int, done: chan<int>) {
  done <- down(depth)
}

fn main() {
  let c = chan<int>(1)
  spawn worker(100000, c)
  print("start\n")
  print("unreachable: ${<- c}\n")
}
