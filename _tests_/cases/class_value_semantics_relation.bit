// run
// SPEC §14.3, #7563: `__sameValue`, `__valueHash` and `__snapshot` skip a
// relation field. A `@table` class with a `@belongsTo` gets the three members
// like any class, and none of them reads the relation: the program compiles
// (a read of a field nothing loaded is E0300, SPEC §10.5) and two rows that
// differ only in the related row are the same value.

@table class Folder {
  @id
  id: i64
  name: string
}

@table class Article {
  @id
  id: i64
  title: string
  folderId: i64
  @belongsTo("folderId")
  folder: Folder
}

fn main() {
  let a = Article{ id = 1, title = "t", folderId = 7 }
  let b = Article{ id = 1, title = "t", folderId = 7 }
  b.folder = Folder{ id = 7, name = "Docs" }
  print("same: ${a.__sameValue(b)}\n")
  print("hash: ${a.__valueHash() == b.__valueHash()}\n")
  let c = Article{ id = 1, title = "t", folderId = 8 }
  print("other column: ${a.__sameValue(c)}\n")
  let s = b.__snapshot()
  print("snapshot: ${s.id} ${s.title} ${s.folderId}\n")
}
