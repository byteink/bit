// run
// #4384: a FUSED compare against literal 0 branches with CBZ/CBNZ on the
// compare's own operand, where it used to emit `cmp Xn, #0` and then a B.EQ /
// B.NE reading the same answer back out of NZCV.
//
// Two things can go silently wrong and neither crashes, so both are asked in
// BOTH directions on values that really are zero and really are not:
//
//   * the polarity. CBZ branches when the register is zero and CBNZ when it is
//     not, so `== 0` and `!= 0` want opposite instructions for the same edge.
//     An inverted one takes the other arm of every `if` in the program.
//   * WHICH register is read. The branch now reads the compare's operand at the
//     branch's own index, not the boolean the compare would have produced, so a
//     fetch of the wrong value (the literal-zero slot, say, which is folded and
//     never materialized) reads whatever else lives there and answers on
//     garbage.
//
// Unsigned rows are here because CBZ tests all 64 bits of the register exactly
// as `cmp Xn, #0` (SUBS XZR, Xn, #0) subtracts from all 64 — whatever a u8 or a
// u32 leaves in the upper half must not change the answer, in either form.
//
// `keep` is the standard opaque-value idiom (run_u32_ucmp_dirty.bit): multi-
// block, so the optimizer never folds the compare away and it really reaches
// codegen.

fn keep(x: i64): i64 {
  if (x == 987654321987) {
    return 0
  }
  return x
}

fn keepU(x: u64): u64 {
  if (x == 12345678901) {
    return 0
  }
  return x
}

fn keepU8(x: u8): u8 {
  if (x == 199) {
    return 0
  }
  return x
}

fn keepU32(x: u32): u32 {
  if (x == 4000000001) {
    return 0
  }
  return x
}

// `== 0` and `!= 0` on a signed value, each in both edge directions.
fn sEq(x: i64): string {
  if (x == 0) {
    return "z"
  }
  return "nz"
}

fn sNe(x: i64): string {
  if (x != 0) {
    return "nz"
  }
  return "z"
}

// The same two on unsigned, where "negative" is a large magnitude instead.
fn uEq(x: u64): string {
  if (x == 0) {
    return "z"
  }
  return "nz"
}

fn uNe(x: u64): string {
  if (x != 0) {
    return "nz"
  }
  return "z"
}

fn u8Eq(x: u8): string {
  if (x == 0) {
    return "z"
  }
  return "nz"
}

fn u32Ne(x: u32): string {
  if (x != 0) {
    return "nz"
  }
  return "z"
}

// A NON-zero literal must keep the compare: `cmp Xn, #5` fits the immediate
// encoding just as `#0` does, but only zero is the question CBZ answers.
fn eqFive(x: i64): string {
  if (x == 5) {
    return "five"
  }
  return "other"
}

// The literal on the LEFT is not folded into the compare's rhs, so this still
// goes through `cmp` — the answer must match `sEq` regardless.
fn zeroEqLeft(x: i64): string {
  if (0 == x) {
    return "z"
  }
  return "nz"
}

// A zero-trip loop: the guard is false on the very first test, so the CBZ must
// take the exit edge before the body has ever run.
fn countDown(n: i64): i64 {
  let i = keep(n)
  let steps = 0
  while (i != 0) {
    steps = steps + 1
    i = i - 1
  }
  return steps
}

// Both edges carry block arguments, so `emitBr` takes its both-edges-inline
// shape and the test becomes a LOCAL forward branch rather than one naming a
// block — a different emitter, same polarity question.
fn bothEdges(n: i64, gate: i64): i64 {
  let acc = 0
  let i = 0
  while (i < n) {
    if (keep(gate) == 0) {
      acc = acc * 2 + 1
    } else {
      acc = acc * 3 + 2
    }
    i = i + 1
  }
  return acc
}

// One compare against zero with TWO consumers: unfusable, so it keeps its
// `cset` and is tested as a boolean (#4349's path). The answer must not move.
fn twoUse(x: i64): int {
  let c = keep(x) == 0
  let n = 0
  if (c) {
    n = n + 1
  }
  if (!c) {
    n = n + 10
  }
  return n
}

fn signedRows() {
  print("sEq ${sEq(keep(0))} ${sEq(keep(1))} ${sEq(keep(-1))}\n")
  print("sNe ${sNe(keep(0))} ${sNe(keep(1))} ${sNe(keep(-1))}\n")
  print("sMin ${sEq(keep(-9223372036854775807 - 1))}")
  print(" ${sNe(keep(-9223372036854775807 - 1))}\n")
}

fn unsignedRows() {
  print("uEq ${uEq(keepU(0))} ${uEq(keepU(1))} ${uEq(keepU(18446744073709551615))}\n")
  print("uNe ${uNe(keepU(0))} ${uNe(keepU(1))} ${uNe(keepU(18446744073709551615))}\n")
  print("u8 ${u8Eq(keepU8(0))} ${u8Eq(keepU8(255))} ${u8Eq(keepU8(1))}\n")
  print("u32 ${u32Ne(keepU32(0))} ${u32Ne(keepU32(4294967295))} ${u32Ne(keepU32(1))}\n")
}

fn otherRows() {
  print("five ${eqFive(keep(5))} ${eqFive(keep(0))} ${eqFive(keep(4))}\n")
  print("left ${zeroEqLeft(keep(0))} ${zeroEqLeft(keep(3))}\n")
  print("loop ${countDown(0)} ${countDown(1)} ${countDown(4)}\n")
  print("both ${bothEdges(5, 0)} ${bothEdges(5, 7)} ${bothEdges(0, 0)}\n")
  print("twoUse ${twoUse(0)} ${twoUse(9)}\n")
}

fn main() {
  signedRows()
  unsignedRows()
  otherRows()
}
