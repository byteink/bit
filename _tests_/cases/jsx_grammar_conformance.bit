// run
// #5169 epic acceptance: the six grammar gaps closed by this epic's
// children, rendered together through the REAL pkg/web library in one
// program, not a local stand-in - a reserved-word attribute (`class`,
// #5155), a hyphenated attribute (`data-id`, #5155), a namespaced attribute
// and tag name (`xlink:href`/`svg:circle`, #5170), a member-expression tag
// (`Lib.Bar`, #5171), a spread attribute (`{...extra}`, #5172) and an empty
// expression child (`{}`, #5173). Each gap already has its own fixture
// proving its shape alone (jsx_attr_reserved_hyphen.bit,
// jsx_namespaced_name.bit, jsx_member_tag.bit, jsx_spread_attr.bit,
// jsx_empty_expr_child.bit); this is the epic's own acceptance, one program
// exercising all six at once.
import { render, attr, elem, el, kidFrom, kid, kids } from "../../pkg/web"
import Lib from "./jsxmembertaglib"

fn main() {
  let extra = [attr("data-id", "42")]
  let page = <div {...extra} class="card">
    <svg:circle xlink:href="#a" />
    <Lib.Bar label="x" />
    {}
  </div>
  println(render(page))
}
