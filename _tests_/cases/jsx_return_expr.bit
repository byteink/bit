// run
// #5160: `return <expr>` — canStartExpression (parserstmt.bit) must admit
// `Kind.Lt` so parseReturn reaches parseExpr, matching `let v = <div>...`
// which already worked; `returnJsx` is the positive case. `returnCompare`
// pins the negative case this widening must not touch: `return a < b` is an
// ordinary comparison, not JSX, because the token right after `return` is
// `Ident` (`a`), not `Lt` — canStartExpression's new arm is never reached
// for it, and parsePrimary's own `atJsxStart` lookahead (SPEC §12.12) still
// settles `Lt` itself case by case exactly as it does everywhere.

fn elem(tag: string, ...kids: string): string {
  let s = "<" + tag + ">"
  for k of kids {
    s = s + k
  }
  return s + "</" + tag + ">"
}

fn attr(name: string, value: string): string {
  return " ${name}=\"${value}\""
}

fn frag(...kids: string): string {
  let s = ""
  for k of kids {
    s = s + k
  }
  return s
}

fn text(s: string): string {
  return s
}

fn returnJsx(): string {
  return <div>hi</div>
}

fn returnCompare(a: int, b: int): bool {
  return a < b
}

fn main() {
  print(returnJsx())
  print("\n")
  print("${returnCompare(1, 2)}\n")
  print("${returnCompare(2, 1)}\n")
}
