// run
// SPEC 11.6 / #7251: values live ACROSS an `asm` block survive its `input` and
// `result` pins. On x86_64 a caller-saved pin no longer leaves the allocatable
// file for the whole function; it is excluded only from the intervals that span
// the block (AsmPin, compiler/regallocpoints.bit), so rax and rcx stay free for
// everything else. `x`, `y`, `z` and `w` are defined before the block and read
// after it, and `a` and `b` die early enough that rax and rcx are free when
// they are allocated, so dropping that exclusion puts one of them in a pinned
// register and the block overwrites it.
// `len(args())` keeps the values out of the constant folder.
import { args } from "std/os"

fn bump(a: int, b: int): int {
  let x = a * 7
  let y = b * 3
  let z = x + y
  let w = z * 5 - x
  let r = asm {
    arm64 { 0x91000420 }                             // add x0, x1, #1
    x64 { 0x48, 0x89, 0xC8, 0x48, 0x83, 0xC0, 0x01 } // mov rax, rcx; add rax, 1
    result arm64 x0 x64 rax : int
    input arm64 x1 x64 rcx = y + 40
  }
  return r * 100000000 + x * 1000000 + y * 10000 + z * 100 + w
}

fn main() {
  let n = len(args())
  print("${bump(n, n + 1)}\n")
}
