// run
// #5320. A generic class method calling another generic function with the
// class's own `T`, where the class itself was built by a GENERIC
// CONSTRUCTOR FUNCTION rather than a literal composite. `bit check` exited 0
// and lowering refused the program with `error[E0092]: cannot lower a call
// whose target could not be resolved`, pointing at the callee inside the
// method body. #4569's fix
// (run_generic_call_in_generic_receiver_method.bit) covers a literal
// `Pair<int>{...}` receiver; this is the same shape one layer further out.
//
// `checkinst.bit`'s `isOwnTypeParams`/`foreignFuncTypeParam` deliberately
// mints a SEPARATE `typeInsts` entry for `Wrap<T>{...}` written inside
// `wrap<T>`'s own template body — `T` still `wrap`'s unbound parameter, never
// a value any running program holds. `lowerMethodInstances`/
// `recordMethodInstanceCalls` (lowerdriver.bit) used to walk that entry
// exactly like a real receiver instantiation and ask `idOf<T>` to resolve
// against a TypeParam nothing ever instantiates. `typeInstArgsConcrete`
// (lowerprim.bit) now skips a `typeInsts` entry whose own args are not fully
// concrete.

fn idOf<T>(v: T): T {
  return v
}

class Wrap<T> {
  v: T
  export get(): T {
    return idOf<T>(this.v)
  }
}

// The new shape: `Wrap<T>` built by a GENERIC FUNCTION, not a literal
// composite at the call site.
fn wrap<T>(v: T): Wrap<T> {
  return Wrap<T>{ v = v }
}

fn main() {
  // Two different instantiations reached only through the generic
  // constructor — the path #5320 fixes.
  print("${wrap<int>(5).get()}\n")
  print(wrap<string>("hi").get() + "\n")
  // The literal-construction control (#4569): must keep working.
  print("${Wrap<int>{ v = 9 }.get()}\n")
}
