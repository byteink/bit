// error
// #6997: an ordering operator on a field with no order is refused, naming the
// operator and the field's type: bool, an enum, Option<bool> and []byte.
import { Where } from "std/where"

enum Status { Draft, Published }

class Article {
  id: i64
  active: bool
  state: Status
  flag: Option<bool>
  blob: []byte
}

fn main() {
  let a: Where<Article> = { active: { gt: true } }
  let b: Where<Article> = { state: { lte: Status.Draft } }
  let c: Where<Article> = { flag: { lt: true } }
  let d: Where<Article> = { blob: { gte: [1] } }
}
