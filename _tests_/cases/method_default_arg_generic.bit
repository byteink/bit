// run
// #6263: SPEC §10.3 grants a defaulted trailing parameter no exemption for a
// method of a GENERIC class either. `parseMethodMember` (parsertype.bit)
// duplicates the enclosing class's own generic params onto every method's
// generics kid, so `declParamListNode` (check.bit) answered -1 for `tag`
// below even though it declares no type params of its own -- `methodMinWant`
// (namedargs.bit) then skipped the SPEC §10.3 relaxation and rejected
// `b.tag(5)` with E0050, though the identical method on a non-generic class
// (method_default_arg.bit) already compiled clean.

class Box<T> {
  x: int
  export tag(n: int, word: string = "asc"): Box<T> {
    print("${word}\n")
    return this
  }
}

fn main() {
  let b = Box<int>{ x = 5 }
  let c = b.tag(1)
  print("${c.x}\n")
  let d = b.tag(1, "desc")
  print("${d.x}\n")
}
