// run
// stdlib/json/parse.bit's parse-error paths (#1479's json epic, #1721),
// exercised behaviourally.
//
// Used to redeclare the local lexer, value type, and parser on the stated
// belief that "a golden case is single-file with no prelude and cannot
// import std/json". That belief is false (#2421): `_tests_/bit/golden.bit`'s
// `checkRun` runs `bit build <case>` with `BIT_STDLIB` exported, so the
// import below resolves exactly as it would for any other caller. The local
// copy had also drifted from the module in two places (#3057): its escape
// error text was missing the "json: " prefix every other message in
// parse.bit carries, and its `jsonMaxDepth = 64` no longer matched the
// module's cap (128, raised in #2256, capped in #2345) — so the depth
// sub-test's 65 opens fell through to an unrelated "expected a value" error
// instead of the depth cap it exists to cover, and had been passing for the
// wrong reason. The depth input is now derived from the imported
// jsonMaxDepth instead of a literal, as #3041 did for the sibling case.
//
// Covers: malformed input (trailing garbage after the top-level value), an
// invalid `\` escape inside a string, and the lexer's depth cap — each
// caught locally via `catch`, proving jsonParse surfaces them as ordinary
// fallible-return errors, never a panic or crash. If any of these panicked
// instead, the process would exit non-zero and this golden case (`// run`,
// which requires a clean exit) would fail.
import { Json, jsonParse, jsonMaxDepth } from "std/json"

fn main() {
  // Malformed: trailing garbage after the top-level value.
  let r1 = jsonParse("1 2") catch e {
    print("malformed=${e.message()}\n")
    Json.JsonNull
  }

  // Invalid escape: `\x` is not one of RFC 8259 §7's escapes.
  let r2 = jsonParse("\"bad\\xescape\"") catch e {
    print("escape=${e.message()}\n")
    Json.JsonNull
  }

  // Depth-limit: jsonMaxDepth + 1 consecutive `[` — the last is `Invalid`
  // (lex.bit's jsonMaxDepth cap), not a Bit-level stack overflow.
  let opens = jsonMaxDepth + 1
  let deepSrc = ""
  let i = 0
  while (i < opens) {
    deepSrc = deepSrc + "["
    i = i + 1
  }
  let r3 = jsonParse(deepSrc) catch e {
    print("depth=${e.message()}\n")
    Json.JsonNull
  }

  print("done\n")
}
