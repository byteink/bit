// run
// #4082: the Umm al-Qura Hijri rendering (docs/stdlib/time.md, "Hijri
// dates"), reached through the public `std/time` import surface rather
// than from inside the module -- stdlib/time/hijri.test.bit already covers
// it from within, where the private table helpers are in scope, so this
// fixture is the check that hijri.bit's trait injection actually lands on
// the exported `Date` a caller gets, and that `HijriDate` and `hijriDate`
// are importable at all.
//
// Every Gregorian/Hijri pair below is an independently published date, not
// this module's own output: 1 Muharram 1443 AH = 2021-08-09 and 1 Ramadan
// 1445 AH = 2024-03-11 are both in github.com/dralshehri/hijridate's
// `MONTH_STARTS`, an unrelated transcription of the official Umm al-Qura
// tables which agrees with the shipped table month-for-month over
// 1420-1450 AH; 1882-11-12 and 2077-11-16 are the tabulated span's two
// ends. The three dates round-tripped below fall in three different Hijri
// years.
import { date, hijriDate, Date, HijriDate } from "std/time"

fn caseDate(y: int, m: int, d: int): Date {
  return date(y, m, d) catch e {
    panic("date failed: ${e.message()}")
  }
}

// `d` rendered in Hijri, then converted back, printed as
// `<hijri>|<gregorian>`. The second half must be the date that went in.
fn roundTrip(d: Date): string {
  let h = d.hijri() catch e {
    panic("hijri failed: ${e.message()}")
  }
  return h.toString() + "|" + h.gregorian().toString()
}

fn rejectsDate(y: int, m: int, d: int): bool {
  let h = caseDate(y, m, d).hijri() catch e {
    return len(e.message()) > 0
  }
  return h.year() < 0
}

fn rejectsHijri(y: int, m: int, d: int): bool {
  let h = hijriDate(y, m, d) catch e {
    return len(e.message()) > 0
  }
  return h.year() < 0
}

fn buildHijri(y: int, m: int, d: int): HijriDate {
  return hijriDate(y, m, d) catch e {
    panic("hijriDate failed: ${e.message()}")
  }
}

fn render(h: HijriDate, pattern: string): string {
  return h.format(pattern) catch e {
    panic("format failed: ${e.message()}")
  }
}

fn main() {
  // 2021-08-09 is 1 Muharram 1443, independently published (header).
  println("verified=${roundTrip(caseDate(2021, 8, 9))}")
  println("ramadan=${roundTrip(caseDate(2024, 3, 11))}")
  println("spanStart=${roundTrip(caseDate(1882, 11, 12))}")
  println("spanEnd=${roundTrip(caseDate(2077, 11, 16))}")

  println("beforeSpanFails=${rejectsDate(1882, 11, 11)}")
  println("afterSpanFails=${rejectsDate(2077, 11, 17)}")
  println("before1300Fails=${rejectsHijri(1299, 12, 30)}")
  println("after1500Fails=${rejectsHijri(1501, 1, 1)}")

  let built = buildHijri(1445, 9, 1)
  println("builtGregorian=${built.gregorian().toString()}")
  println("monthName=${render(built, "d MMMM yyyy")}")
  println("abbrev=${render(built, "dd MMM yy")}")
}
