// run
// #3567: `\a` (bell, 0x07) as a std/regex pattern escape. RE2/Go's regexp
// syntax (https://github.com/google/re2/wiki/Syntax, "Escape sequences")
// documents `\a` alongside `\f \n \r \t \v`, all of which std/regex already
// supported; `classControlByte` (stdlib/regex/parsecursor.bit) had no case
// for `a`. Both call sites of that shared table are exercised here: the
// atom-position parser (parseescape.bit, a bare `\a`) and the class-body
// parser (parseclass.bit, `\a` inside `[...]`) — the hypothesis was that
// both share one table, so both must accept `\a` and match 0x07, and both
// must still reject an unrelated control letter to prove the fix is not a
// blanket allow. Single-file golden: no prelude.
import { compile, mustCompile } from "std/regex"

fn main() {
  let atom = mustCompile("\\a")
  print("atomMatches=${atom.matches("\x07")}\n")

  let cls = mustCompile("[\\a]")
  print("classMatches=${cls.matches("\x07")}\n")

  let stillRejects = compile("\\q") catch e {
    print("stillRejects=true\n")
    return
  }
  print("stillRejects=false\n")
}
