// run
// #7574: a `[]i8`/`[]bool` buffer is packed at 1 byte per element and a
// `[]i32`/`[]u32`/`[]f32` one at 4, as C and Go lay them out, where each used
// to spend one 8-byte word per element. Every path that addresses an element
// must agree on the stride: `ptrOf` (integer elements only, E0053), whose
// `*(p + 1)` is the SECOND element only at the packed stride; the inline read and write (an `f32` one in a
// float register); the runtime's get (the `op=` read) and append (one value,
// growth, a spread); a slice literal; a reslice's offset; `for of`; and the
// runtime's `[]rune(s)`/`string(rs)`, which build and read a `[]i32` buffer
// by hand. Negative values come from runtime arithmetic so the sign-extending
// load is exercised on a computed register, not a folded constant.
fn neg(n: int): int {
  return 0 - n
}

fn layout() {
  let a = []i32{ 7, -2, 2147483647, -2147483648 }
  let p = ptrOf(a)
  println("i32 ${*p} ${*(p + 1)} ${*(p + 2)} ${*(p + 3)}")
  let u = []u32{ 0xffffffff, 1, 0x80000000 }
  let q = ptrOf(u)
  println("u32 ${*q} ${*(q + 1)} ${*(q + 2)}")
  let b = []i8{ -128, 127, -1 }
  let r = ptrOf(b)
  println("i8 ${*r} ${*(r + 1)} ${*(r + 2)}")
  let f = []bool{ false, true, false, true }
  println("bool ${f[0]} ${f[1]} ${f[2]} ${f[3]}")
  let g = []f32{ 1.5, -2.25, 1e30 }
  println("f32 ${g[0]} ${g[1]} ${g[2]}")
}

fn elems() {
  let a = []i32(3)
  a[0] = i32(neg(1))
  a[1] = 2147483647
  a[2] = i32(neg(300))
  a[0] /= 2
  a[1] -= 1
  a[2] >>= 1
  println("i32 ${a[0]} ${a[1]} ${a[2]}")
  let b = []i8(2)
  b[0] = i8(neg(128))
  b[1] = 1
  b[0] += 1
  b[1] *= 100
  println("i8 ${b[0]} ${b[1]}")
  let g = []f32(3)
  g[0] = 0.5
  g[1] = f32(neg(3))
  g[2] = g[0] + g[1]
  g[1] *= 2.0
  println("f32 ${g[0]} ${g[1]} ${g[2]}")
}

fn grow() {
  let a: []i32 = []
  let i = 0
  while (i < 100) {
    a = append(a, i32(neg(i)))
    i = i + 1
  }
  let sum = 0
  for x of a {
    sum += int(x)
  }
  println("append ${len(a)} ${a[0]} ${a[1]} ${a[99]} ${sum}")
  let c = append(a[98:100], ...a[0:3])
  println("spread ${len(c)} ${c[0]} ${c[1]} ${c[2]} ${c[3]} ${c[4]}")
  let v = a[50:53]
  v[0] = 9
  println("reslice ${v[0]} ${v[1]} ${v[2]} ${a[50]} ${a[51]}")
  let f: []bool = []
  let g: []f32 = []
  i = 0
  while (i < 20) {
    f = append(f, i % 3 == 0)
    g = append(g, f32(i) * 0.5)
    i = i + 1
  }
  let n = 0
  for x of f {
    if (x) {
      n += 1
    }
  }
  println("bools ${len(f)} ${n} ${f[18]} ${f[19]} f32s ${g[1]} ${g[19]}")
}

fn runes() {
  let rs = []rune("aé€😀")
  let p = ptrOf(rs)
  println("runes ${len(rs)} ${*p} ${*(p + 1)} ${*(p + 2)} ${*(p + 3)}")
  rs[0] = 0x42
  println("back ${string(rs)}")
}

fn main() {
  layout()
  elems()
  grow()
  runes()
}
