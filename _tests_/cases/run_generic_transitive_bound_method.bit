// run
// #4656: the RUNS side of the transitive-bound rule for a generic METHOD,
// whose error side is
// _tests_/cases/check_generic_transitive_bound_method.bit.
//
// #4646 judged a generic body's call to a bounded FREE generic. The method
// spelling of the same call has a `Tag.Member` callee, which that arm returned
// on, so it was judged by nothing and stayed the lowerer's E0092 inside the
// class body -- exactly the gap #4634 closed for the direct case, one level
// down and per instantiation.
//
// Every way of NOT reaching the new diagnostic is here, and if the arm widened
// by one clause none of this would compile:
//
//   - a method whose own type argument satisfies its bound,
//   - explicit type arguments at the call, which bind the method's own params
//     rather than the enclosing template's,
//   - an argument already CONCRETE in the template, which E0051 on the body
//     sweep judged and a second report would duplicate,
//   - a method with NO type params of its own, whose receiver's parameters are
//     not this call's business,
//   - an EMPTY interface bound, which every type satisfies,
//   - a method call on the enclosing generic's own bounded parameter, which
//     dispatches through the constraint interface and has no FuncDecl.
interface Named {
  label(): string,
}

// An empty method set: satisfied by anything, including a type the enclosing
// generic supplies.
interface Any {}

class Tag {
  export label(): string { return "tag" }
}

class Box {
  export mk<T: Named>(v: T): string { return v.label() }
  export any<T: Any>(v: T): int { return 1 }
  export plain(): int { return 2 }
}

// The satisfying case: `T` is bounded here too, so every instantiation of
// `viaBox` supplies a type `mk` accepts.
fn viaBox<T: Named>(v: T): string {
  let b = Box{}
  return b.mk(v)
}

// The call writes its own type argument, so the enclosing `T` never reaches
// `mk`'s parameter and `T = i64` is not `mk`'s business.
fn explicitArg<T>(v: T): string {
  let b = Box{}
  return b.mk<Tag>(Tag{})
}

// The argument is concrete in the template, so the body sweep's own E0051
// already judged it; judging it again here would double-report.
fn concreteArg<T>(v: T): string {
  let b = Box{}
  return b.mk(Tag{})
}

// No type params of its own: `methodOwnGenericCount` is 0 and nothing is
// judged.
fn noOwnParams<T>(v: T): int {
  let b = Box{}
  return b.plain()
}

// `Any` has no methods, so `i64` satisfies it.
fn emptyBound<T>(v: T): int {
  let b = Box{}
  return b.any(v)
}

// The receiver is the enclosing generic's own type param: it dispatches
// through the constraint interface, whose method has no FuncDecl.
fn onOwnParam<T: Named>(v: T): string {
  return v.label()
}

fn main() {
  print("${viaBox(Tag{})}\n")
  print("${explicitArg(7)}\n")
  print("${concreteArg(7)}\n")
  print("${noOwnParams(7)}\n")
  print("${emptyBound(7)}\n")
  print("${onOwnParam(Tag{})}\n")
}
