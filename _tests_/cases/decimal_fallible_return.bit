// run
// #5410: a `decimal` OK value crossing a fallible `T!` return used to refuse
// with E0092 at every `?`/`catch` site — the whole `TryExpr`/`Catch*` node's
// own type is `decimal` (the fallible call's OK type), so the top-level
// decimal dispatcher (`lowerDecimalExpr`, lowerdecimal.bit) intercepted it
// before `lowerExprByTag`'s existing `Tag.TryExpr`/`Tag.CatchDefault`/
// `Tag.CatchBind` arms (lowerexpr.bit) ever ran, and its fallback refused
// with a span rather than falling through to them. `lowerTryExpr`/
// `lowerCatch` (lowerfail.bit) already lower their operand through a plain
// `lowerExpr`, which reaches a decimal-typed call through this same
// dispatcher's `Tag.Call` arm — so passing the three new tags through
// unchanged is the whole fix, same shape as `Tag.Call`.
//
// Covers BOTH sites: `?` on the ok arm, and `catch` on both its ok and
// failing arms.
fn priced(x: int): decimal! {
  if (x < 0) {
    fail newError("negative price")
  }
  let d: decimal = 19.99
  return d
}

fn viaTry(x: int): decimal! {
  let d = priced(x)?
  return d
}

fn main() {
  // `?` on the ok arm.
  let ok1 = viaTry(1) catch e {
    return
  }
  println("${ok1}")
  // `catch` on the ok arm directly.
  let ok2 = priced(2) catch e {
    return
  }
  println("${ok2}")
  // `catch` on the FAILING arm: the handler's own decimal value is what
  // merges at the join, not the (never-produced) ok value.
  let fallback: decimal = 0.01
  let handled = priced(-1) catch e {
    fallback
  }
  println("${handled}")
}
