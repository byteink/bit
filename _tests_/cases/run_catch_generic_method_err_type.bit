// run
// #6113: `catch e { ... }` on a call reached through `this.field.method(...)`
// mistyped `e` as the predeclared `error` interface instead of the callee's
// own declared error type (a `match (e) { ... }` on the real variants then
// failed E0069, "'match' requires an enum subject"). Root cause was
// `compiler/parsertype.bit`'s `parseMethodMember`: it minted the desugared
// method's `Tag.Receiver` node AFTER parsing the body, so
// `checkmodule.bit`'s ascending arena-order pre-pass (`bindCatchType`) asked
// for `this`'s type before `bindParamOrReceiver` had bound it and silently
// defaulted the catch binder to `error`. Reproduced without any class-level
// generic (`Runner` is not generic) — only the method itself is, matching
// `pkg/redis`'s `ZsetScan.fill`/`Client.runCmd<T>` shape this fixture is
// modeled on.
export enum MyErr {
  Bad(string)
  Sad

  message(): string {
    match (this) {
      Bad(msg) => return "bad: ${msg}"
      _ => return "sad"
    }
  }
}

class Runner {
  get<T>(v: T, ok: bool): T!MyErr {
    if (ok) {
      return v
    }
    fail MyErr.Bad("nope")
  }
}

class Holder {
  runner: Runner

  fetch(v: i64, ok: bool): string {
    let x = this.runner.get(v, ok) catch e {
      match (e) {
        Bad(msg) => return "caught bad: ${msg}"
        Sad => return "caught sad"
      }
    }
    return "ok=${x}"
  }
}

fn main() {
  let h = Holder{ runner = Runner{} }
  print(h.fetch(7, true) + "\n")
  print(h.fetch(7, false) + "\n")
}
