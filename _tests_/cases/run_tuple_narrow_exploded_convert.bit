// run
// #5876: the same narrow-producer-into-a-wider-field round trip as
// `run_tuple_narrow_boxed_convert.bit`, but through a 2-member tuple the
// optimizer removes the box from entirely (`f`/`pairR` are this ticket's own
// repro shape, #4405/#5871's word-explosion): `forwardOneLoad`
// (optstore.bit) must forward both field reads for the allocation to become
// dead, and the VALUE read back afterward must still be correct -- a wrong
// extension direction is invisible to `ir_tuple_layout.bit`'s allocation
// count but not to the printed values here.
fn explodedPair(s: string, i: int): (int, bool) {
  return int(s[i]), s[i] > 0x7f
}

fn main() {
  let lo = "A"      // 0x41 = 65, <= 0x7f
  let hi = "\u{E9}" // UTF-8 0xC3 0xA9: byte 0 is 0xC3 = 195, > 0x7f

  let (n1, big1) = explodedPair(lo, 0)
  print("exploded lo ${n1} ${big1}\n")
  let (n2, big2) = explodedPair(hi, 0)
  print("exploded hi ${n2} ${big2}\n")
}
