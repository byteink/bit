// ir
// #6472: a comma-ok map read whose value binder is `_` lowers to the probe
// and `ok` alone (`lowerMapTwoResult` in compiler/lowertuple.bit):
// no `map_val_at`, and no miss edge testing the value word. The key is still
// evaluated, and still once: `byCall`'s `bump` stays. `Outer` has no zero
// value (SPEC §13.4) and needs no different treatment. Both the `let` and the
// assignment form take it.
class Obj {
  x: int,
}

class Outer {
  o: Obj,
}

fn blankLet(m: map<int, Obj>, k: int): bool {
  let (_, ok) = m[k]
  return ok
}

fn blankStrKey(m: map<string, int>, k: string): bool {
  let (_, ok) = m[k]
  return ok
}

fn noZero(m: map<int, Outer>, k: int): bool {
  let (_, ok) = m[k]
  return ok
}

fn blankAssign(m: map<int, Obj>, k: int): bool {
  let ok = false
  _, ok = m[k]
  return ok
}

fn bump(c: Obj): int {
  c.x = c.x + 1
  return c.x
}

fn byCall(m: map<int, Obj>, c: Obj): bool {
  let (_, ok) = m[bump(c)]
  return ok
}
