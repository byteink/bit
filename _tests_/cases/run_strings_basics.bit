// run
// #2139: std/strings was missing replace, lastIndexOf, trimLeft/trimRight/trim,
// a real trimSpace (it stripped only space and tab, leaving \n \r \v \f
// attached), splitN, padStart/padEnd, and an indexOfFrom start offset. Every
// assertion below pins an edge case the ticket called out by name, not just
// the happy path: an empty needle, an offset past the end of the string, an
// n larger than the match count, n == 0, overlapping candidates, and a
// pad/target already at or past the requested width. Semantics follow Go's
// strings package where Go has the function (LastIndex, TrimLeft/Right/Trim,
// SplitN) and JS's String.prototype where it does not (padStart/padEnd),
// except that an empty `old` in `replace` is a no-op here rather than Go's
// insert-at-every-position — see strings.bit's own comment on `replace`.
import {
  replace, lastIndexOf, trimLeft, trimRight, trim, trimSpace,
  splitN, padStart, padEnd, indexOfFrom, join,
} from "std/strings"

fn showAll(parts: []string): string {
  return "[" + join(parts, "|") + "]"
}

fn main() {
  // replace
  assert(replace("aaaa", "aa", "b") == "bb", "non-overlapping left-to-right replace")
  assert(replace("abc", "", "Z") == "abc", "empty needle is a no-op, not insert-everywhere")
  assert(replace("abc", "x", "Z") == "abc", "no match leaves s unchanged")
  assert(
    replace("aaa", "aa", "-") == "-a",
    "a match consumes its bytes, so the next scan starts after it",
  )
  assert(replace("", "a", "b") == "", "empty s with a non-empty needle is a no-op")

  // lastIndexOf
  assert(lastIndexOf("a/b/c", "/") == 3, "rightmost single-byte match")
  assert(lastIndexOf("abc", "z") == -1, "no match")
  assert(lastIndexOf("abc", "") == 3, "empty needle matches at len(s), matching Go's LastIndex")
  assert(
    lastIndexOf("aaa", "aa") == 1,
    "overlapping candidates report the rightmost start, not the leftmost",
  )

  // trim family (byte-level cutset)
  assert(trim("__k__", "_") == "k", "both ends trimmed against the cutset")
  assert(trimLeft("xxyh", "xy") == "h", "leading run trimmed against a multi-byte cutset")
  assert(trimRight("hxxyy", "xy") == "h", "trailing run trimmed against a multi-byte cutset")
  assert(trim("abc", "xyz") == "abc", "cutset that matches nothing leaves s unchanged")
  assert(trim("abc", "") == "abc", "empty cutset matches nothing")

  // trimSpace: all six ASCII whitespace bytes, not just space and tab
  assert(
    trimSpace("\n hi \n") == "hi",
    "leading/trailing newlines are stripped, the ticket's headline bug",
  )
  assert(
    trimSpace(" \t\n\r\x0B\x0Chi\x0C\x0B\r\n\t ") == "hi",
    "all six ASCII whitespace bytes on both ends",
  )
  assert(trimSpace("hi") == "hi", "nothing to trim leaves s unchanged")

  // splitN
  assert(
    showAll(splitN("k=v=w", "=", 2)) == "[k|v=w]",
    "limit 2: last part keeps the unsplit remainder",
  )
  assert(showAll(splitN("k=v", "=", 0)) == "[]", "n == 0 yields no parts at all")
  assert(showAll(splitN("a,b,c", ",", 1)) == "[a,b,c]", "n == 1 yields s whole, unsplit")
  assert(
    showAll(splitN("a,b,c", ",", 10)) == "[a|b|c]",
    "limit larger than the match count behaves like split",
  )
  assert(showAll(splitN("a,b,c", ",", -1)) == "[a|b|c]", "negative n is unlimited, same as split")
  assert(showAll(splitN("abc", "", 5)) == "[abc]", "empty sep yields the whole string as one part")

  // padStart / padEnd, measured in code points via runeCount
  assert(padStart("7", 3, "0") == "007", "single-byte pad to a wider width")
  assert(padEnd("héllo", 7, ".") == "héllo..", "code-point width: héllo is 5 runes, not 6 bytes")
  assert(
    padStart("hello", 3, "0") == "hello",
    "already longer than width: unchanged, never truncated",
  )
  assert(padEnd("ab", 5, "") == "ab", "empty pad has nothing to repeat: unchanged")
  assert(
    padStart("x", 5, "ab") == "ababx",
    "multi-rune pad repeats cyclically and cuts short if it overshoots",
  )
  assert(padEnd("x", 0, "0") == "x", "width <= 0 is always a no-op")

  // indexOfFrom
  assert(indexOfFrom("abab", "ab", 1) == 2, "the fix for #2132's quadratic split/replace")
  assert(indexOfFrom("abc", "a", 10) == -1, "start offset past the end of the string finds nothing")
  assert(indexOfFrom("abc", "", 10) == -1, "even an empty needle finds nothing past the end")
  assert(indexOfFrom("abc", "", 3) == 3, "an empty needle at exactly len(s) matches there")
  assert(
    indexOfFrom("abc", "a", -5) == 0,
    "a negative offset clamps to 0 rather than reading out of bounds",
  )

  println("ok")
}
