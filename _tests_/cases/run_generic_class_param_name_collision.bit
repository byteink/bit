// run
// #4589. Two generic CLASSES in one module that both call their type parameter
// `A`. A method on one of them could not lower a member access on a field typed
// at its own parameter:
//
//   error[E0092]: cannot lower a `.` field access on a receiver that is not a
//   class or interface
//
// while `bit check` exited 0 and renaming either class's parameter made the
// identical program run. No generic FUNCTION is involved.
//
// `checkModule`'s #1540 pre-mint sweep resolved every `Name<...>` mention in
// the module with no generic scope in force, and `userTypes` is flat and keyed
// by the BARE parameter name — so after the collect loop every `A` named
// whichever generic declared one LAST. The method receiver `Named1<A>` the
// parser writes for an in-body method therefore read a SIBLING class's `A`,
// `isOwnTypeParams` correctly answered "not `Named1`'s own parameters", and a
// bogus `Named1<A_sibling>` nominal instantiation was minted. Being a nominal
// instantiation of a generic receiver, `lowerMethodInstances` emitted a body
// for it, and in that body `this.a` is typed at a type parameter no
// instantiation env binds. The fix binds each declaration's own `<...>` on the
// way past, exactly as pre-pass 3 and the main sweep already do (#1551).
//
// BOTH DECLARATION ORDERS ARE HERE ON PURPOSE. Whichever generic class declared
// `A` LAST won the flat table, so the shape that miscompiles moves with source
// order and so does the message. `Named1` before `Pair` is E0092 "a `.` field
// access on a receiver that is not a class or interface" in `Named1.lbl`;
// `Slot2` before `Named2` is E0092 "interpolating a value whose type has no
// `show()` method" in `Slot2.shown`. Both were measured red on main at
// 2759fcc5. All four classes spell their parameter `A`, which is the whole
// trigger — renaming any one of them made its pair compile.
interface Named {
  label(): string,
}

class Dog {
  n: string
  export label(): string {
    return this.n
  }
}

// Order 1: the constrained generic is declared BEFORE the plain one.
class Named1<A: Named> {
  a: A
  export lbl(): string {
    return this.a.label()
  }
}

class Pair<A> {
  a: A
  export first(): A {
    return this.a
  }
}

// Order 2: the plain generic first, the constrained one second. `Slot2.shown`
// interpolates its own field rather than returning it: a body that only RETURNS
// a value typed at a bare type parameter lowers fine, so it would not have
// caught the bogus instantiation minted for this half.
class Slot2<A> {
  a: A
  export shown(): string {
    return "${this.a}"
  }
}

class Named2<A: Named> {
  a: A
  export lbl(): string {
    return this.a.label()
  }
}

fn main() {
  print("${Pair<int>{ a: 7 }.first()}\n")
  print(Named1<Dog>{ a: Dog{ n: "rex" } }.lbl() + "\n")
  print(Slot2<int>{ a: 7 }.shown() + "\n")
  print(Named2<Dog>{ a: Dog{ n: "rex" } }.lbl() + "\n")
}
