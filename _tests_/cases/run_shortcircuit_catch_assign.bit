// run
//
// #6415: a `catch _ { x = ... }` inside the rhs of `&&`/`||`, an arm of `?:`,
// or the condition of an `if`/`while`/`for` reassigns an outer local, and the
// join after it has to carry that local. It took only the bool/value, so the
// local read afterwards named a block param defined inside the rhs and printed
// a pointer (exit 0). Every shape is inside a loop, so a stale value from the
// previous trip shows as well as a wrong one. `f(n)` is `2n` for n <= 2 and
// fails above, so the catch runs from n = 3 and each reassignment is visible.
// With `BIT_IF_BRANCHCHAIN=1` (test-golden-ifchain) the `if` forms take the
// branch-chain path instead, against the same `.expected`.
class myErr {
  code: i64
  message(): string { return "code=${this.code}" }
}
enum Color { Red, Green }

fn f(n: i64): i64! {
  if (n > 2) {
    fail myErr{ code = n }
  }
  return n * 2
}

// 1: && value
fn andVal() {
  let x = 1
  let i = 0
  while (i < 5) {
    let ok = i > 0 &&
        (f(i) catch _ {
          x = x + 10
          0
        }) ==
        0
    print("and i=${i} ok=${ok} x=${x}\n")
    i = i + 1
  }
}

// 2: || value
fn orVal() {
  let x = 1
  let i = 0
  while (i < 5) {
    let ok = i < 1 ||
        (f(i) catch _ {
          x = x + 10
          0
        }) ==
        0
    print("or i=${i} ok=${ok} x=${x}\n")
    i = i + 1
  }
}

// 3: ?: then arm
fn condThen() {
  let x = 1
  let i = 0
  while (i < 5) {
    let v = i > 2 ? f(i) catch _ {
      x = x + 10
      0
    } : 7
    print("then i=${i} v=${v} x=${x}\n")
    i = i + 1
  }
}

// 4: ?: else arm
fn condElse() {
  let x = 1
  let i = 0
  while (i < 5) {
    let v = i < 3 ? 7 : f(i) catch _ {
      x = x + 10
      5
    }
    print("else i=${i} v=${v} x=${x}\n")
    i = i + 1
  }
}

// 5: if (a && catch)
fn ifAnd() {
  let x = 1
  let i = 0
  while (i < 5) {
    if (i > 1 &&
        (f(i) catch _ {
          x = x + 100
          0
        }) ==
        0) {
      x = x + 1000
    }
    print("ifand i=${i} x=${x}\n")
    i = i + 1
  }
}

// 6: if (a || catch)
fn ifOr() {
  let x = 1
  let i = 0
  while (i < 5) {
    if (i < 1 ||
        (f(i) catch _ {
          x = x + 100
          1
        }) ==
        0) {
      x = x + 1000
    }
    print("ifor i=${i} x=${x}\n")
    i = i + 1
  }
}

// 7: while cond
fn whileCond() {
  let x = 1
  let i = 0
  let n = 0
  while (i < 6 &&
      (f(i) catch _ {
        x = x + 10
        0
      }) <
      100) {
    i = i + 1
    n = n + 1
    if (n > 5) {
      break
    }
  }
  print("while i=${i} n=${n} x=${x}\n")
}

// 8: match expr arm
fn matchArm() {
  let x = 1
  let i = 0
  while (i < 5) {
    let c = Color.Green
    if (i < 2) {
      c = Color.Red
    }
    let v = match (c) {
      Red => 7
      Green => f(i) catch _ {
        x = x + 10
        0
      }
    }
    print("match i=${i} v=${v} x=${x}\n")
    i = i + 1
  }
}

// 9: && rhs contains match expr containing catch
fn andMatch() {
  let x = 1
  let i = 0
  while (i < 5) {
    let c = Color.Green
    if (i < 2) {
      c = Color.Red
    }
    let ok = i > 0 &&
      match (c) {
        Red => true
        Green => (f(i) catch _ {
            x = x + 10
            0
          }) ==
          0
      }
    print("andmatch i=${i} ok=${ok} x=${x}\n")
    i = i + 1
  }
}

// 10: catch in catch handler
fn nested() {
  let x = 1
  let i = 0
  while (i < 5) {
    let v = f(i + 1) catch _ {
      f(i + 2) catch _ {
        x = x + 10
        3
      }
    }
    print("nested i=${i} v=${v} x=${x}\n")
    i = i + 1
  }
}

// 11: catch default value containing catch block
fn dflt() {
  let x = 1
  let i = 0
  while (i < 5) {
    let v = f(i + 1) catch f(i + 2) catch _ {
      x = x + 10
      3
    }
    print("dflt i=${i} v=${v} x=${x}\n")
    i = i + 1
  }
}

// 12: nested short circuits and `?:` combined, one shape per function
fn comboA() {
  let x = 1
  let i = 0
  while (i < 5) {
    let a = i > 0 &&
      (i < 9 ||
          (f(i) catch _ {
            x = x + 1
            0
          }) ==
          0)
    print("comboA i=${i} a=${a} x=${x}\n")
    i = i + 1
  }
}

fn comboB() {
  let x = 1
  let i = 0
  while (i < 5) {
    let b = i > 2 ? i > 3 &&
        (f(i) catch _ {
          x = x + 10
          0
        }) ==
        0 : false
    print("comboB i=${i} b=${b} x=${x}\n")
    i = i + 1
  }
}

fn comboC() {
  let x = 1
  let i = 0
  while (i < 5) {
    let c = i > 2 &&
      i > 3 &&
        (f(i) catch _ {
          x = x + 100
          0
        }) ==
        0
    print("comboC i=${i} c=${c} x=${x}\n")
    i = i + 1
  }
}

// 13: string local (exploded) reassigned
fn strLocal() {
  let s = "a"
  let i = 0
  while (i < 5) {
    let ok = i > 0 &&
        (f(i) catch _ {
          s = s + "!"
          0
        }) ==
        0
    print("str i=${i} ok=${ok} s=${s}\n")
    i = i + 1
  }
}

// 14: for loop condition
fn forCond() {
  let x = 1
  let n = 0
  for (let j = 0; j < 6 &&
      (f(j) catch _ {
        x = x + 10
        0
      }) <
      100; j = j + 1) {
    n = n + 1
    if (n > 5) {
      break
    }
  }
  print("for n=${n} x=${x}\n")
}

// 15: while whose lhs is false at once: the rhs never runs, yet the loop's exit
// edge must carry `x` as the lhs left it
fn whileSkip() {
  let x = 1
  let i = 0
  while (i > 5 &&
      (f(i) catch _ {
        x = x + 10
        0
      }) <
      100) {
    i = i + 1
  }
  print("whileskip i=${i} x=${x}\n")
}

// 16: else arm reads the local the condition's catch reassigned
fn ifElse() {
  let x = 1
  let y = 0
  let i = 0
  while (i < 5) {
    if (i > 1 &&
        (f(i) catch _ {
          x = x + 100
          0
        }) ==
        0) {
      y = x + 1
    } else {
      y = x + 2
    }
    print("ifelse i=${i} x=${x} y=${y}\n")
    i = i + 1
  }
}

// 17: a `||` nested in the lhs of `&&`, then an `||` nested in its rhs
fn ifNest() {
  let x = 1
  let i = 0
  while (i < 5) {
    if ((i < 2 ||
          (f(i) catch _ {
            x = x + 100
            0
          }) ==
          0) &&
      i != 3) {
      x = x + 1000
    } else {
      x = x + 1
    }
    if (i > 0 &&
      (i == 4 ||
          (f(i) catch _ {
            x = x + 10000
            1
          }) ==
          0)) {
      x = x + 100000
    }
    print("ifnest i=${i} x=${x}\n")
    i = i + 1
  }
}

// 18: else-if chain, a string local, and an `||` that reassigns it
fn ifChain() {
  let s = "a"
  let i = 0
  while (i < 5) {
    if (i > 1 &&
        (f(i) catch _ {
          s = s + "1"
          0
        }) ==
        0) {
      s = s + "T"
    } else if (i > 3 ||
        (f(i) catch _ {
          s = s + "2"
          1
        }) ==
        0) {
      s = s + "E"
    } else {
      s = s + "-"
    }
    print("ifchain i=${i} s=${s}\n")
    i = i + 1
  }
}

// 19: a `?:` inside one catch block, a `&&` inside another
fn inCatch() {
  let x = 1
  let i = 0
  while (i < 5) {
    let v = f(i + 1) catch _ {
      i > 1 ? f(i + 2) catch _ {
        x = x + 10
        3
      } : 9
    }
    let w = f(i + 3) catch _ {
      if (i > 0 &&
          (f(i + 2) catch _ {
            x = x + 100
            0
          }) ==
          0) {
        x = x + 1
      }
      0
    }
    print("incatch i=${i} v=${v} w=${w} x=${x}\n")
    i = i + 1
  }
}

fn main() {
  andVal()
  orVal()
  condThen()
  condElse()
  ifAnd()
  ifOr()
  whileCond()
  matchArm()
  andMatch()
  nested()
  dflt()
  comboA()
  comboB()
  comboC()
  strLocal()
  forCond()
  whileSkip()
  ifElse()
  ifNest()
  ifChain()
  inCatch()
}
