// run
// A C-like enum is an integer tag, so `int(tag)` yields it (§12.9) — used to
// store an operator/tag in an integer field and recover it. Payload enums have
// no integer value and are still rejected.
enum Op { Add, Sub, Mul, Div }

fn code(o: Op): i64 {
  return int(o)
}

fn main() {
  print("${code(Op.Add)} ${code(Op.Sub)} ${code(Op.Mul)} ${code(Op.Div)}\n")
  let stored = int(Op.Mul)
  if (stored == int(Op.Mul)) {
    print("recovered\n")
  }
}
