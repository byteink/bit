// run
// The x86-64 twin of arm64_cmp_immediate_boundary.bit: a compare against a
// literal folds into the flag-setting instruction instead of materializing the
// literal into a scratch register first. Two forms, two different hazards.
//
// `cmp reg, imm32` (group-1 `81 /7 id`) takes a SIGNED 32-bit immediate and
// sign-extends it to 64 bits, so the window is -2147483648..2147483647 and
// every edge of it is here. A fold that used the wrong opcode digit, the wrong
// sign extension, or accepted a value outside the window would change one of
// these answers. Digit 7 is the only one in that table whose instruction writes
// no register; digit 5 is SUB, one byte away, and would set the same flags
// while clobbering the operand, which the repeated reads of `x` per row catch.
//
// `test reg, reg` replaces `cmp reg, 0` for equality alone. It computes an AND,
// so it sets ZF and SF and CLEARS CF and OF, where a real compare against zero
// derives all four from a subtraction. The unsigned rows and the signed
// relational rows are both here so that a fold widened past equality, to a
// consumer reading CF or OF, has somewhere to show up.
//
// Every value arrives as a parameter, so none of these compares is folded away
// before codegen.

// Against zero: equality is the `test` case, the other four are relational
// codes that must keep a real compare.
fn zero(x: i64) {
  print("zero ${x} ${x == 0} ${x != 0} ${x < 0} ${x <= 0} ${x > 0} ${x >= 0}\n")
}

// Both edges of the signed imm32 window, from inside and outside.
fn window(x: i64) {
  print("win ${x}")
  print(" hi ${x == 2147483647} ${x < 2147483647} ${x >= 2147483647}")
  print(" over ${x == 2147483648} ${x < 2147483648} ${x >= 2147483648}")
  print(" lo ${x == -2147483648} ${x < -2147483648} ${x >= -2147483648}")
  print(" under ${x == -2147483649} ${x < -2147483649} ${x >= -2147483649}\n")
}

// The unsigned relations, which read CF. u64 MAX is -1's bit pattern: read
// unsigned it is the largest value there is, so every `<` below is false --
// the answer a signed misread inverts.
fn unsignedWide(x: u64) {
  print("u64 ${x} ${x == 0} ${x != 0} ${x > 0} ${x >= 1}")
  print(" ${x < 2147483647} ${x <= 2147483647} ${x > 2147483647}")
  print(" ${x < 2147483648} ${x >= 2147483648}\n")
}

// A literal on the LEFT. `cmp` is not commutative, so this must NOT fold the
// same way `x < k` does -- and a fold that reversed the relation to get there
// would invert exactly these answers.
fn leftLiteral(x: i64) {
  print("left ${x} ${0 == x} ${0 != x} ${0 < x} ${0 >= x}")
  print(" ${2147483647 < x} ${-2147483648 > x}\n")
}

// Narrow widths, where the register holds the value width-canonical: the
// unsigned rows must zero-extend and the signed rows sign-extend before the
// folded compare reads them.
fn narrow(a: u32, b: i32) {
  print("narrow ${a} ${a == 4294967295} ${a < 2147483648} ${a >= 2147483647}")
  print(" ${b} ${b == -1} ${b < 0} ${b >= -2147483648}\n")
}

fn runSigned() {
  zero(-2147483649)
  zero(-1)
  zero(0)
  zero(1)
  zero(2147483648)
  window(-2147483649)
  window(-2147483648)
  window(-1)
  window(0)
  window(2147483647)
  window(2147483648)
}

fn runUnsigned() {
  unsignedWide(u64(0))
  unsignedWide(u64(1))
  unsignedWide(u64(2147483647))
  unsignedWide(u64(2147483648))
  unsignedWide(u64(18446744073709551615))
  leftLiteral(-1)
  leftLiteral(0)
  leftLiteral(1)
  narrow(u32(4294967295), i32(-1))
  narrow(u32(0), i32(2147483647))
}

fn main() {
  runSigned()
  runUnsigned()
}
