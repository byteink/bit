// run
// map<K,V>(n): the capacity hint (§11.2, §12.9, #4064). ADVISORY — every one
// of these must behave exactly like the bare map<K,V>() form (run_map.bit),
// because a hint may only change allocation, never observable behavior. Also
// covers what an illegal-looking hint resolves to: negative and absurdly
// large are both a runtime CLAMP (fall back to the ordinary unhinted table),
// not a checker error — `bit check` accepts any integer value here.
fn main() {
  let a = map<string, int>(8)
  a["a"] = 1
  a["b"] = 2
  a["a"] = 100 // overwrite keeps len
  delete(a, "b")
  print("a=${a["a"]} miss=${a["z"]} len=${len(a)}\n")

  let b = map<int, int>(1500000) // a hint larger than the entries actually inserted
  let i = 0
  while (i < 5) {
    b[i] = i * i
    i = i + 1
  }
  let ksum = 0
  let vsum = 0
  for (k, v) of b {
    ksum = ksum + k
    vsum = vsum + v
  }
  print("ksum=${ksum} vsum=${vsum} len=${len(b)}\n")

  let c = map<int, int>(-5) // negative: clamped to no hint, not an error
  c[1] = 7
  print("neg=${c[1]} len=${len(c)}\n")

  let d = map<int, int>(0) // zero: also no hint
  d[1] = 9
  print("zero=${d[1]} len=${len(d)}\n")
}
