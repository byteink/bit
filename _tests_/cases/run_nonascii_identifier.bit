// run
// #3465, the ACCEPT half: an ordinary non-ASCII identifier is legitimate
// per spec/SPEC.md §1 ("Identifiers ... may contain any Unicode scalar
// value") and must keep compiling and running once E0097 starts scanning
// identifiers (tests/bit/checkercases/check_invisible_identifier_binding.bit).
// Greek and CJK code points fall outside `classifyInvisible`'s matched set
// entirely — it only recognizes the U+2000 block and U+FEFF — so "reject
// everything unusual" is not what this rule does. Single-file golden: no
// prelude.
fn main() {
  let π = 3
  let 名前 = "value"
  print("${π} ${名前}\n")
}
