// run
//
// #5926: with `BIT_IF_BRANCHCHAIN=1` an `if` condition lowers `&&`/`||` as a
// chain of branches, one per operand (`lowerCondBr`, lowercond.bit), not as a
// bool join value that a second branch tests. The flag is off by default until
// the stage0 repin; test-golden runs this at the default and
// test-golden-ifchain with the flag on, against the same `.expected`, which
// the pre-#5926 compiler produced. What this pins: the rhs runs only when the lhs does not
// decide the result (every `t` call prints its label, so a skipped or doubled
// operand changes the output), operands run left to right, and every false
// edge carries the live locals to the join (`n` is reassigned in the then-arm
// and read after the `if`, so a false edge with the wrong arguments prints a
// wrong count).

fn t(label: string, v: bool): bool {
  print("  ${label}\n")
  return v
}

fn andNoElse(a: bool, b: bool): int {
  let n = 10
  if (t("a", a) && t("b", b)) {
    n = n + 1
  }
  return n
}

fn andElse(a: bool, b: bool): int {
  let n = 20
  if (t("a", a) && t("b", b)) {
    n = n + 1
  } else {
    n = n - 1
  }
  return n
}

fn orNoElse(a: bool, b: bool): int {
  let n = 30
  if (t("a", a) || t("b", b)) {
    n = n + 1
  }
  return n
}

fn orElse(a: bool, b: bool): int {
  let n = 40
  if (t("a", a) || t("b", b)) {
    n = n + 1
  } else {
    n = n - 1
  }
  return n
}

fn notNoElse(a: bool, b: bool): int {
  let n = 50
  if (!(t("a", a) && t("b", b))) {
    n = n + 1
  }
  return n
}

fn notElse(a: bool, b: bool): int {
  let n = 60
  if (!(t("a", a) || t("b", b))) {
    n = n + 1
  } else {
    n = n - 1
  }
  return n
}

fn nestedNoElse(a: bool, b: bool, c: bool): int {
  let n = 70
  if (t("a", a) && (t("b", b) || t("c", c))) {
    n = n + 1
  }
  return n
}

fn nestedElse(a: bool, b: bool, c: bool): int {
  let n = 80
  if (t("a", a) || (t("b", b) && t("c", c))) {
    n = n + 1
  } else {
    n = n - 1
  }
  return n
}

// A then-arm that returns: the join is reached only through the false edges.
fn earlyReturn(a: bool, b: bool): int {
  let n = 90
  if (t("a", a) && t("b", b)) {
    return 0
  }
  n = n + 1
  return n
}

// `else if` lowers through the same path.
fn chain(a: bool, b: bool): string {
  if (t("a", a) && t("b", b)) {
    return "both"
  } else if (t("a", a) || t("b", b)) {
    return "one"
  }
  return "none"
}

// The rhs holds a bounds-checked index that is out of range whenever the lhs
// is false, so evaluating it on that edge would panic.
fn crlfAt(s: string, i: int): bool {
  if (s[i] == '\r' && s[i + 1] == '\n') {
    return true
  }
  return false
}

fn two(a: bool, b: bool) {
  print("a=${a} b=${b}\n")
  print(" andNoElse=${andNoElse(a, b)}\n")
  print(" andElse=${andElse(a, b)}\n")
  print(" orNoElse=${orNoElse(a, b)}\n")
  print(" orElse=${orElse(a, b)}\n")
  print(" notNoElse=${notNoElse(a, b)}\n")
  print(" notElse=${notElse(a, b)}\n")
  print(" earlyReturn=${earlyReturn(a, b)}\n")
  print(" chain=${chain(a, b)}\n")
}

fn three(a: bool, b: bool, c: bool) {
  print("a=${a} b=${b} c=${c}\n")
  print(" nestedNoElse=${nestedNoElse(a, b, c)}\n")
  print(" nestedElse=${nestedElse(a, b, c)}\n")
}

fn main() {
  two(false, false)
  two(false, true)
  two(true, false)
  two(true, true)
  let bits = 0
  while (bits < 8) {
    three((bits & 4) != 0, (bits & 2) != 0, (bits & 1) != 0)
    bits = bits + 1
  }
  print("crlfAt(ab,1)=${crlfAt("ab", 1)}\n")
  print("crlfAt(a\\r\\n,1)=${crlfAt("a\r\n", 1)}\n")
  print("crlfAt(a\\rx,1)=${crlfAt("a\rx", 1)}\n")
}
