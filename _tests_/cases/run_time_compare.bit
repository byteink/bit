// run
// #4078: ordering, equality and whole-unit differences through the PUBLIC
// `std/time` import (docs/stdlib/time.md, "Comparison", "Differences").
// stdlib/time/compare.test.bit covers the same family from inside the
// module, where the unexported fields are reachable; this file proves the
// worked examples the docs state hold for an ordinary caller who has only
// `date`, `zone` and the exported `Zone`.
//
// Four documented rules, one function each below.
//
// TWO `DateTime` VALUES COMPARE BY INSTANT, NOT BY WALL CLOCK. 09:00 in
// Asia/Dubai is BEFORE 09:00 in Europe/London on the same date, because the
// two instants are four hours apart in December, when London is on GMT.
// The two `.naive()` wall clocks are `isSame` at that moment, which is the
// distinction the doc says callers get wrong.
//
// DIFFERENCES TRUNCATE TOWARD ZERO. Someone born 2000-06-15 is 25 on
// 2026-06-14 and 26 on 2026-06-15 -- the doc's own age example -- and
// `a.differenceInDays(b)` is exactly `-b.differenceInDays(a)`.
//
// A MONTH IS COMPLETE WHEN `addMonths` HAS REACHED IT, so 2026-01-31 to
// 2026-02-28 is ONE complete month rather than zero: `addMonths` clamps
// 2026-01-31 plus one month to 2026-02-28, and `differenceInMonths`
// inherits that clamp instead of adding a second end-of-month rule.
//
// DATE UNITS READ THE WALL CLOCK, TIME UNITS READ THE INSTANT. Across
// Europe/London's 2026 fall-back, the calendar day 2026-10-25 is 25 real
// hours long: `differenceInDays` is 1, `differenceInHours` is 25, and
// subtracting the two `Timestamp` values gives the same 25 hours in
// nanoseconds. Both answers are correct and they legitimately disagree.
import { date, zone, Zone } from "std/time"

// 09:00 read in two zones is two different instants but one wall clock.
fn instantVsWallClock(dubai: Zone, london: Zone) {
  let dec15 = date(2026, 12, 15) catch e {
    println("date build failed: ${e.message()}")
    return
  }
  let nineAm = dec15.atTime(9, 0, 0) catch e {
    println("atTime failed: ${e.message()}")
    return
  }
  let dubaiNine = nineAm.inZone(dubai)
  let londonNine = nineAm.inZone(london)
  println("dubaiBeforeLondon=${dubaiNine.isBefore(londonNine)}")
  println("londonAfterDubai=${londonNine.isAfter(dubaiNine)}")
  println("sameInstant=${dubaiNine.isSame(londonNine)}")
  println("sameWallClock=${dubaiNine.naive().isSame(londonNine.naive())}")
  println("zoneGapHours=${dubaiNine.differenceInHours(londonNine)}")
}

// The doc's age example, and the symmetry truncation toward zero buys.
fn ageTruncation() {
  let born = date(2000, 6, 15) catch e {
    println("date build failed: ${e.message()}")
    return
  }
  let dayBefore = date(2026, 6, 14) catch e {
    println("date build failed: ${e.message()}")
    return
  }
  let birthday = date(2026, 6, 15) catch e {
    println("date build failed: ${e.message()}")
    return
  }
  println("ageDayBefore=${born.differenceInYears(dayBefore)}")
  println("ageOnBirthday=${born.differenceInYears(birthday)}")
  println("ageForwardDays=${born.differenceInDays(birthday)}")
  println("ageBackwardDays=${birthday.differenceInDays(born)}")
}

// One complete month from 2026-01-31 to 2026-02-28, because that is where
// `addMonths` lands.
fn monthClamp() {
  let jan31 = date(2026, 1, 31) catch e {
    println("date build failed: ${e.message()}")
    return
  }
  let feb28 = date(2026, 2, 28) catch e {
    println("date build failed: ${e.message()}")
    return
  }
  println("clampedAddMonths=${jan31.addMonths(1).toString()}")
  println("clampedMonths=${jan31.differenceInMonths(feb28)}")
  println("clampedYears=${jan31.differenceInYears(feb28)}")
  println("clampedWeeks=${jan31.differenceInWeeks(feb28)}")
  println("clampedDays=${jan31.differenceInDays(feb28)}")
}

// The 25-hour calendar day: one day on the wall clock, 25 hours of real
// elapsed time on the instant, from the same pair of values.
fn fallBackDay(london: Zone) {
  let oct25 = date(2026, 10, 25) catch e {
    println("date build failed: ${e.message()}")
    return
  }
  let oct26 = date(2026, 10, 26) catch e {
    println("date build failed: ${e.message()}")
    return
  }
  let start = oct25.atStartOfDay(london)
  let end = oct26.atStartOfDay(london)
  println("dstDays=${start.differenceInDays(end)}")
  println("dstHours=${start.differenceInHours(end)}")
  let startTs = start.toTimestamp() catch e {
    println("toTimestamp failed: ${e.message()}")
    return
  }
  let endTs = end.toTimestamp() catch e {
    println("toTimestamp failed: ${e.message()}")
    return
  }
  println("dstNanoseconds=${startTs.differenceInNanoseconds(endTs)}")
  println("dstTimestampHours=${startTs.differenceInHours(endTs)}")
}

// `isBetween` is inclusive on both ends and false for an empty range;
// `compare` returns each of -1, 0 and 1.
fn betweenAndCompare() {
  let jan31 = date(2026, 1, 31) catch e {
    println("date build failed: ${e.message()}")
    return
  }
  let feb10 = date(2026, 2, 10) catch e {
    println("date build failed: ${e.message()}")
    return
  }
  let feb28 = date(2026, 2, 28) catch e {
    println("date build failed: ${e.message()}")
    return
  }
  println("betweenLow=${jan31.isBetween(jan31, feb28)}")
  println("betweenHigh=${feb28.isBetween(jan31, feb28)}")
  println("betweenInside=${feb10.isBetween(jan31, feb28)}")
  println("betweenOutside=${jan31.isBetween(feb10, feb28)}")
  println("emptyRange=${feb10.isBetween(feb28, jan31)}")
  println("compareLess=${jan31.compare(feb28)}")
  println("compareEqual=${jan31.compare(jan31)}")
  println("compareGreater=${feb28.compare(jan31)}")
}

fn main() {
  let dubai = zone("Asia/Dubai") catch e {
    println("zone(Asia/Dubai) failed: ${e.message()}")
    return
  }
  let london = zone("Europe/London") catch e {
    println("zone(Europe/London) failed: ${e.message()}")
    return
  }
  instantVsWallClock(dubai, london)
  ageTruncation()
  monthClamp()
  fallBackDay(london)
  betweenAndCompare()
}
