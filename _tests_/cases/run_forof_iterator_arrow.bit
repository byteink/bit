// run
// #7765: `for x of it? { }` over a `next(): Option<T>!` iterable inside an arrow
// whose parameter type is inferred from the function type it is written
// against. The parameter has no type until the arrow is seeded from `with`'s
// signature, so a `?` judged before that was called a non-fallible operand
// (E0116). `viaArrow` counts the 4 items (3,2,1,0); `drain` is the plain-fn
// form of the same loop and sums them (6).
class Pages {
  n: i64
  next(): Option<i64>! {
    if (this.n < 0) {
      return Option.None
    }
    this.n = this.n - 1
    return Option.Some(this.n + 1)
  }
}

class Src {
  n: i64
  pages(): Pages {
    return Pages{ n = this.n }
  }
}

fn with(s: Src, f: (Src) => i64!): i64! {
  return f(s)?
}

fn drain(s: Src): i64! {
  let sum: i64 = 0
  for x of s.pages()? {
    sum = sum + x
  }
  return sum
}

fn viaArrow(s: Src): i64! {
  return with(s, (t) => {
    let sum: i64 = 0
    for _ of t.pages()? {
      sum = sum + 1
    }
    return sum
  })?
}

fn main() {
  let s = Src{ n = 3 }
  let a = viaArrow(s) catch _ {
    -1
  }
  let b = drain(s) catch _ {
    -1
  }
  print("arrow=${a} fn=${b}\n")
}
