// run
// #4512: a type assertion whose TARGET is an interface. `ok` is "the dynamic
// type SATISFIES the target" (SPEC §14.3/§14.4) — a structural method-set test,
// not the descriptor-identity compare a CLASS target lowers to
// (run_type_assert.bit pins that one, and it is unchanged). Before this fixture
// the shape passed the checker and then refused to lower at all: E0092 "cannot
// lower a type assertion to a target that is not a class".
//
// Lowering emits one `bit_rt_iface_has` per method of the target and threads
// the value through the calls (ABI.md §2.2), so a single missing method must
// null the whole result. `Plain` below is exactly that case: it has
// `message()`, so it satisfies the RECEIVER `error`, and it is missing only
// `status()` — the second conjunct. A chain that dropped its second link, or an
// `ok` read that reported only the last method looked up, still prints
// `web 404` for `WebError` and only goes wrong on this one line.
interface HttpError {
  message(): string,
  status(): int,
}

// No methods at all: satisfied by every value that HAS a dynamic type, so `ok`
// is a nil test and no call is emitted.
interface Any {}

class WebError {
  code: int
  msg: string
  export message(): string { return this.msg }
  export status(): int { return this.code }
}

class Plain {
  msg: string
  export message(): string { return this.msg }
}

// Has `status()` and no `message()` — the mirror image of `Plain`.
interface Status {
  status(): int,
}

class Coded {
  export status(): int { return 418 }
}

// The pkg/web mapping this ticket exists for: any error carrying `status()`
// maps to that HTTP status, with no registration anywhere.
fn classify(e: error): int {
  let (he, ok) = e.(HttpError)
  if (ok) {
    return he.status()
  }
  return 500
}

fn main() {
  let web: error = WebError{ code: 404, msg: "not found" }
  let plain: error = Plain{ msg: "plain" }
  let none: error = nil
  print("web ${classify(web)}\n")
  print("plain ${classify(plain)}\n")
  print("nil ${classify(none)}\n")

  // The mismatch value is nil, not the un-narrowed receiver — the same rule
  // §14.4 states for a class target, and for the same reason: a caller that
  // ignores `ok` must not be handed something it can dispatch `status()` on.
  let (miss, missok) = plain.(HttpError)
  print("miss ${missok} ${miss == nil}\n")

  // The one-result form narrows directly on a hit (it panics on a miss —
  // panic_iface_assert_iface.bit).
  let hit = web.(HttpError)
  print("one ${hit.status()} ${hit.message()}\n")

  // Methods still dispatch through the narrowed interface value, which is the
  // whole point of narrowing to an interface rather than to a class.
  let (both, bothok) = web.(HttpError)
  print("both ${bothok} ${both.message()} ${both.status()}\n")

  // The predeclared `error` (§10.6) as a target: it has no declaration to walk,
  // so its one `message` method is named by hand in the lowerer.
  let (asErr, errok) = web.(error)
  print("error ${errok} ${asErr.message()}\n")

  // An empty target: true for anything non-nil, false for nil.
  let any: Any = WebError{ code: 1, msg: "x" }
  let anyNil: Any = nil
  let (a1, ok1) = any.(Any)
  let (a2, ok2) = anyNil.(Any)
  print("any ${ok1} ${a1 == nil}\n")
  print("anynil ${ok2} ${a2 == nil}\n")

  // ...and a non-empty target reached FROM an empty one.
  let (a3, ok3) = any.(HttpError)
  print("anyhttp ${ok3} ${a3.status()}\n")

  // The other half of the conjunction: `Coded` is missing the target's FIRST
  // method, not its last. `Plain` above cannot catch a chain that keeps only
  // the last link — `status()` is the last link and `Plain` fails it anyway —
  // so without this line a lowering that answered with one conjunct instead of
  // all of them would print every expected byte above.
  let coded: Status = Coded{}
  let (c1, cok) = coded.(HttpError)
  print("firstmiss ${cok} ${c1 == nil}\n")
}
