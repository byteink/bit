// panic
// #4381: the `index == len` BOUNDARY on the inlined `[]u8` store. Pinned
// separately from its two siblings — run_slice_u8_store_neg_panic.bit probes a
// negative index and run_slice_u8_store_nullhdr_panic.bit a null header —
// because this is the ONE index a `<=` written where `<` belongs would admit,
// and neither of those two would notice.
//
// IT IS THE SILENT ARM, which is what makes it the fixture that matters here.
// Delete the bounds check and this does not fault: the store writes one byte
// into live heap immediately past the buffer, `survived` prints, and the
// program EXITS 0 with a plausible answer. That is strictly worse than the read
// side's equivalent (#4346), where an out-of-range load merely returns a wrong
// byte — a stray write corrupts an unrelated object and surfaces arbitrarily
// far from here. The neighbouring slice is allocated and printed for exactly
// that reason.
//
// The index and the length are both derived from `args()`, so nothing here is
// decidable at compile time.
import { args } from "std/os"

fn extra(): int { return len(args()) - 1 }

fn main() {
  let bs = []u8(3 + extra())
  let neighbour = []u8(3)
  neighbour[0] = 7
  print("start len=${len(bs)}\n")
  bs[len(bs)] = 200
  print("survived neighbour=${int(neighbour[0])},${int(neighbour[1])}\n")
}
