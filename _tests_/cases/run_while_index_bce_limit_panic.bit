// panic
// #5895: the semantic half of `limitMoves` in ir_while_index_bce_hoisted.bit.
// The limit starts at `len(w)` and GROWS on the back edge, so `i < n` stops
// implying `i < len(w)` after the third byte. The bounds check on `w[i]` must
// survive and fire at `i == 3`. A pass that resolved the limit param through
// its non-self edge would drop it: the loop would read two bytes past the end
// of `w`, print them, and exit 0, which is what this expected output rejects.
fn main() {
  let w = "abc"
  let n = len(w)
  let i = 0
  while (i < n) {
    eprint("i=${i} b=${w[i]}\n")
    if (n < 5) {
      n = n + 1
    }
    i = i + 1
  }
  eprint("unreachable: i=${i}\n")
}
