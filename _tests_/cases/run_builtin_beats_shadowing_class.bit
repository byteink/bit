// run
// #4692, the other face of the same precedence rule: with no `init`,
// `vConversionArity` judged a shadowed builtin as the one-argument §12.9
// conversion its user type would be, so the CORRECT call `fsCwd()` was
// refused on main at 7c6a13f0 with a false "E0050: 'fsCwd' takes exactly 1
// argument, found 0" — against a program `lowerCall` emits as the 0-argument
// builtin. Both classes below shadow a runtime primitive, one with an `init`
// and one without, and both calls resolve to the builtin: `timeMonoNs()` is
// the monotonic clock rather than a constructor call (`init` takes one
// argument and is never reached), `fsCwd()` is the working directory rather
// than a conversion.
class timeMonoNs {
  n: i64
  init(a: i64) { this.n = a + 1 }
}

class fsCwd {
  n: i64,
}

fn main() {
  let a = timeMonoNs()
  let b = timeMonoNs()
  print("mono ${a > 0 && b >= a}\n")
  print("cwd ${len(fsCwd()) > 0}\n")
}
