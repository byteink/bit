// lint exit=0
// #5247 E0218 `relation-unloaded-read`: same body as
// lint_relation_unloaded_read.bit, differing only in the chain itself --
// `.with("orders")` is chained onto `find<User>(...)` before `.oneOrFail()`,
// so `orders` is among the fields this binding's own chain already loaded.
// Zero findings.
import { Data, find } from "orm"
import { FieldDesc, Rows } from "std/sql"

class Order {
  id: i64,
}

@table class User {
  @id
  id: i64
  @hasMany("userId")
  orders: []Order
}

fn userMapper(rows: Rows): User! {
  return User{ id: 1 } // `orders` left unset on purpose, pkg/orm/docs/relation.md
}

fn report(db: Data, id: i64): ()! {
  let u = find<User>(db, "users", []FieldDesc(0), userMapper).with("orders").oneOrFail()?
  print("${len(u.orders)}\n")
}
