// lint exit=0
// #5247 E0218 `relation-unloaded-read`: same body as
// lint_relation_unloaded_read.bit, differing only in the chain itself --
// `.with("orders")` is chained onto the `findOneOrFail<User>(...)` call
// before the trailing `?`, so `orders` is among the fields this binding's
// own chain already loaded. Zero findings.
import { Executor, findOneOrFail } from "std/sql"

class Order {
  id: i64,
}

@table class User {
  @id
  id: i64
  @hasMany("userId")
  orders: []Order
}

fn report(db: Executor, id: i64): ()! {
  let u = findOneOrFail<User>(db, "select * from users where id = $1", id).with("orders")?
  print("${len(u.orders)}\n")
}
