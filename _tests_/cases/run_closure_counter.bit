// run
// #2128: the counter closure. A captured variable is SHARED with the enclosing
// function (SPEC §12.8), so the write survives the call — this printed `1 1 1`
// while a capture was a by-value snapshot re-read from the env on every entry.
fn counter(): () => int {
  let n = 0
  return () => {
    n = n + 1
    return n
  }
}
fn main() {
  let c = counter()
  print("${c()} ${c()} ${c()}\n")
}
