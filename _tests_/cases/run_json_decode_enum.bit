// run
// #6177: `jsonDecode<T>` for a payload-free `enum` field (#6163's read half).
//
// THE ROUND TRIP IS THE ASSERTION, same as `run_json_decode.bit`: the class is
// encoded, decoded back and encoded again, and the two renderings compared
// EXACTLY. One field of each shape an enum can reach: bare, inside `[]T`,
// inside `map<string, T>` and inside `Option<T>`.
//
// AN UNKNOWN VARIANT NAME FAILS, NAMING THE FIELD'S DOTTED PATH AND EVERY
// VARIANT THE CLASS DECLARES — the same `TypeMismatch` shape every other
// decode failure takes, asserted at all three positions (bare, `[]T` element,
// `Option<T>`) since #6177's compiler-side chain shares no code path between
// them beyond `jdEnumValueOf`.
import { Json, JsonEntry, jsonParse, jsonEncode, jsonDecode } from "std/json"

enum Status {
  Draft,
  Published,
  Archived,
}

@json class Item {
  status: Status,
  history: []Status,
  tags: map<string, Status>,
  reviewed: Option<Status>,
}

// `Status` has no `Show` implementation, so a value is never interpolated
// directly (SPEC §5.7, E0073) — this is the same comparison chain the
// compiler itself synthesizes for encoding one (classjsonbuild.bit's
// `jbEnumStringExpr`), written by hand here to print what was decoded.
fn statusName(s: Status): string {
  if (s == Status.Draft) {
    return "Draft"
  }
  if (s == Status.Published) {
    return "Published"
  }
  return "Archived"
}

fn describe(it: Item): string {
  let rev = "none"
  if (isSome(it.reviewed)) {
    rev = statusName(unwrap(it.reviewed))
  }
  let (t, ok) = it.tags["a"]
  return "status=${statusName(it.status)} " +
    "history=${len(it.history)}:${statusName(it.history[0])},${statusName(it.history[1])} " +
    "tags[a]=${statusName(t)}/${ok} reviewed=${rev}"
}

fn roundTrip(it: Item) {
  let encoded = jsonEncode(it.toJson())
  let j = jsonParse(encoded) catch e {
    print("parse: ${e.message()}\n")
    return
  }
  let back = jsonDecode<Item>(j) catch e {
    print("decode: ${e.message()}\n")
    return
  }
  print("exact=${jsonEncode(back.toJson()) == encoded}\n")
  print("${describe(back)}\n")
}

fn decodeText(label: string, src: string) {
  let j = jsonParse(src) catch e {
    print("${label}: parse: ${e.message()}\n")
    return
  }
  let it = jsonDecode<Item>(j) catch e {
    print("${label}: ${e.message()}\n")
    return
  }
  print("${label}: ok ${describe(it)}\n")
}

fn main() {
  let it = Item{
    status = Status.Published,
    history = [Status.Draft, Status.Archived],
    tags = map<string, Status>{ "a": Status.Draft },
    reviewed = Option<Status>.Some(Status.Archived),
  }
  roundTrip(it)

  let ok = "{\"status\":\"Draft\",\"history\":[\"Draft\",\"Published\"]," +
    "\"tags\":{\"a\":\"Archived\"},\"reviewed\":null}"
  decodeText("ok-absent-reviewed", ok)

  decodeText(
    "bad-bare",
    "{\"status\":\"Cancelled\",\"history\":[],\"tags\":{},\"reviewed\":null}",
  )
  decodeText(
    "bad-in-array",
    "{\"status\":\"Draft\",\"history\":[\"Nope\"],\"tags\":{},\"reviewed\":null}",
  )
  decodeText(
    "bad-in-option",
    "{\"status\":\"Draft\",\"history\":[],\"tags\":{},\"reviewed\":\"Nope\"}",
  )
}
