// run
// #4312 (pass 2 of #4017): `syncDir` wired into `std/fs` over the
// `bit_rt_fs_sync_dir_w` runtime primitive.
//
// Three cases, matching the ticket's acceptance:
//   1. A directory holding a freshly written file syncs without error — the
//      durability step that makes the new NAME survive a power failure, as
//      distinct from `File.sync()`, which persists only the contents.
//   2. A path that does not exist fails.
//   3. A REGULAR FILE fails, and the message names the path. The runtime
//      primitive itself opens and fsyncs a regular file path perfectly
//      happily, so this case is the one that proves the `isDir` guard in
//      `std/fs` is present; without it the call would succeed here.
//
// The temp directory's name carries a timestamp, so no case prints a path:
// the message is checked by prefix and by the basename it must end with,
// the same technique fs_stat.bit uses for `no such file or directory:`.
import { envOr } from "std/os"
import { syncDir, mkdir, writeFile } from "std/fs"
import { hasPrefix, hasSuffix } from "std/strings"

// Runs `syncDir` and renders the outcome as one line, so a failure's message
// is part of the golden output rather than an early return.
fn syncLine(label: string, path: string, name: string) {
  syncDir(path) catch e {
    let m = e.message()
    println(
      "${label}: ok=false notDir=${hasPrefix(m, "not a directory:")} names=${hasSuffix(m, name)}",
    )
    return
  }
  println("${label}: ok=true")
}

fn main() {
  let dir = "${envOr("TMPDIR", "/tmp")}/bit_fs_syncdir_${timeUnixNs()}"
  mkdir(dir) catch _ {
    println("setup failed: cannot create ${dir}")
    return
  }

  // (1) a directory whose entries have just changed.
  let filePath = "${dir}/file.txt"
  writeFile(filePath, "0123456789") catch _ {
    println("setup failed: cannot write file.txt")
    return
  }
  syncLine("dir", dir, "")

  // (2) a path that does not exist.
  syncLine("missing", "${dir}/does-not-exist", "/does-not-exist")

  // (3) a regular file — refused by the `isDir` guard, not by the runtime.
  syncLine("file", filePath, "/file.txt")
}
