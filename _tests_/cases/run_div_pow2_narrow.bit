// run
// sdiv by a compile-time power-of-two constant at narrow int widths
// (i8/i16/i32) with a negative dividend (#1707): emitPow2DivInt's
// sign-bias isolation shift used `bits - k` (the operand's type width)
// instead of the fixed `64 - k`. Every integer SSA value lives in a full
// 64-bit GPR held width-canonical (`compiler/x64select.bit`'s module doc), so
// the sign-mask
// shift right after `sar bits-1` must isolate exactly k bits out of the
// FULL 64-bit register, not out of `bits`. For bits < 64 the old code
// produced an oversized bias and corrupted the quotient by a full unit —
// e.g. i32 -7 / 8 computed 4294967295 instead of 0.
//
// Each dividend is a genuine runtime value (an array load indexed by a
// loop counter) rather than a literal, so it survives to the real codegen
// path instead of being folded away before codegen ever sees it — the
// constant folder only folds a `/` whose operands are already ConstInt
// nodes, and an array load is not one. Array loads (not a loop-carried
// i32/i16/i8 phi) sidestep #1708, a separate filed bug about narrow-signed
// loop phis, unrelated to div/rem.
fn main() {
  let a8: [9]i8 = [9]i8{ -20, -10, -5, -1, 0, 1, 5, 10, 20 }
  let i8idx = 0
  while (i8idx < 9) {
    print("${a8[i8idx] / 4} ")
    i8idx = i8idx + 1
  }
  print("\n")

  let a16: [13]i16 = [13]i16{ -100, -50, -9, -8, -7, -1, 0, 1, 7, 8, 9, 50, 100 }
  let i16idx = 0
  while (i16idx < 13) {
    print("${a16[i16idx] / 8} ")
    i16idx = i16idx + 1
  }
  print("\n")

  let a32: [11]i32 = [11]i32{ -20, -10, -8, -7, -1, 0, 1, 7, 8, 10, 20 }
  let i32idx = 0
  while (i32idx < 11) {
    print("${a32[i32idx] / 8} ")
    i32idx = i32idx + 1
  }
  print("\n")
}
