// run
// #2277: an arrow parameter written WITHOUT a type annotation, whose body reads
// a FIELD of it, checked clean and then refused to lower — the spanless
// "cannot lower 1 function(s); refusing to emit a binary" of epic #2185.
//
// Same root cause as #2275 and fixed by the same change: the expected function
// type was not pushed onto the parameter, so member access had no class type
// to resolve against. Where indexing silently emitted wrong code, member
// access, builtin calls and method calls bailed out. Fix one without the other
// and this file passes while `arrow_bare_param_index.bit` still lies, so the
// two are deliberately separate cases.
//
// A bare arrow that never touches its parameter's contents (`k => 1`) always
// worked; it is here so a fix that types parameters cannot regress it.
class Cat {
  n: int
  get(): int {
    return this.n
  }
}

fn pick(xs: []Cat, key: (Cat) => int): int {
  return key(xs[0])
}

fn main() {
  let f: (Cat) => int = (c) => c.n
  let g: (Cat) => int = (c) => c.get()
  let h: ([]int) => int = (xs) => len(xs)
  let i: (Cat) => int = (c) => 1
  print("f=${f(Cat{ n: 7 })} g=${g(Cat{ n: 9 })}\n")
  print("h=${h([1, 2, 3])} i=${i(Cat{ n: 3 })}\n")
  print("arg=${pick([Cat{ n: 5 }], (c) => c.n)}\n")
}
