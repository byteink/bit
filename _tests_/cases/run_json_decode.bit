// run
// SPEC §10.5, #3977: `jsonDecode<T>` decodes a `Json` into a `@json` class,
// field by field, with the key naming rules #3976 encodes by -- the field name
// exactly as written unless `@key("...")` overrides it.
//
// THE ROUND TRIP IS THE ASSERTION. `toJson` and `jsonDecode` are two halves of
// one mapping, and a decoder that silently dropped a field would still print
// something plausible -- so the class is encoded, decoded back and encoded
// again, and the two renderings are compared EXACTLY. Every field of the
// original is also read off the decoded value, because an encode-decode-encode
// that lost and re-defaulted a field in the same place would still match.
//
// One field of every shape: an i64, a string, a bool, an f64, a `[]string`, a
// `map<string, bool>` used as a set, an `Option<string>` that is set, an
// `Option<string>` that is ABSENT, a `@key`-renamed field, and a nested `@json`
// class.
//
// AN ABSENT `Option` ENCODES AS `null` AND DECODES BACK TO `None`. A producer
// that omits the key entirely is just as well-formed, so both decode to `None`
// -- asserted below with the key present-as-null and with it removed.
import { Json, JsonEntry, jsonParse, jsonEncode, jsonDecode } from "std/json"

@json class Addr {
  city: string,
  zip: i32,
}

@json class User {
  id: i64
  name: string
  active: bool
  ratio: f64
  tags: []string
  seen: map<string, bool>
  nick: Option<string>
  absent: Option<string>
  @key("created_at")
  createdAt: string
  addr: Addr
}

fn describe(u: User): string {
  let nick = "none"
  if (isSome(u.nick)) {
    nick = unwrap(u.nick)
  }
  let absent = "none"
  if (isSome(u.absent)) {
    absent = unwrap(u.absent)
  }
  let (seen, ok) = u.seen["a"]
  return "id=${u.id} name=${u.name} active=${u.active} ratio=${u.ratio} " +
    "tags=${len(u.tags)}:${u.tags[0]},${u.tags[1]} seen[a]=${seen}/${ok} " +
    "nick=${nick} absent=${absent} created=${u.createdAt} " +
    "city=${u.addr.city} zip=${u.addr.zip}"
}

fn roundTrip(u: User) {
  let encoded = jsonEncode(u.toJson())
  let j = jsonParse(encoded) catch e {
    print("parse: ${e.message()}\n")
    return
  }
  let back = jsonDecode<User>(j) catch e {
    print("decode: ${e.message()}\n")
    return
  }
  print("exact=${jsonEncode(back.toJson()) == encoded}\n")
  print("${describe(back)}\n")
}

fn decodeValue(j: Json) {
  let u = jsonDecode<User>(j) catch e {
    print("err: ${e.message()}\n")
    return
  }
  print("built ${describe(u)}\n")
}

fn decodeText(src: string) {
  let j = jsonParse(src) catch e {
    print("parse: ${e.message()}\n")
    return
  }
  let u = jsonDecode<User>(j) catch e {
    print("err: ${e.message()}\n")
    return
  }
  print("ok ${describe(u)}\n")
}

fn main() {
  let u = User{
    id: 7,
    name: "ada",
    active: true,
    ratio: 0.5,
    tags: ["a", "b"],
    seen: map<string, bool>{ "a": true },
    nick: Option<string>.Some("mango"),
    absent: Option<string>.None,
    createdAt: "2026-01-01",
    addr: Addr{ city: "cairo", zip: 11511 },
  }
  print("${describe(u)}\n")
  roundTrip(u)
  // A `Json` built BY HAND, not parsed: `jsonDecode` takes a value, and one
  // assembled programmatically is exactly as decodable as one off the wire.
  decodeValue(
    Json.JsonObject(
      [
        JsonEntry{ key: "id", value: Json.JsonInt(9) },
        JsonEntry{ key: "name", value: Json.JsonString("bee") },
        JsonEntry{ key: "active", value: Json.JsonBool(false) },
        JsonEntry{ key: "ratio", value: Json.JsonInt(2) },
        JsonEntry{
          key: "tags",
          value: Json.JsonArray([Json.JsonString("p"), Json.JsonString("q")]),
        },
        JsonEntry{
          key: "seen",
          value: Json.JsonObject([JsonEntry{ key: "a", value: Json.JsonBool(false) }]),
        },
        JsonEntry{ key: "nick", value: Json.JsonNull },
        JsonEntry{ key: "absent", value: Json.JsonNull },
        JsonEntry{ key: "created_at", value: Json.JsonString("2026-02-02") },
        JsonEntry{
          key: "addr",
          value: Json.JsonObject(
            [
              JsonEntry{ key: "city", value: Json.JsonString("giza") },
              JsonEntry{ key: "zip", value: Json.JsonInt(1) },
            ],
          ),
        },
      ],
    ),
  )
  // The same document with the absent Option's key REMOVED rather than null.
  decodeText(
      "{\"id\":7,\"name\":\"ada\",\"active\":true,\"ratio\":0.5,\"tags\":[\"a\",\"b\"]," +
      "\"seen\":{\"a\":true},\"nick\":\"mango\",\"created_at\":\"2026-01-01\"," +
      "\"addr\":{\"city\":\"cairo\",\"zip\":11511}}",
  )
}
