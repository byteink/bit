// types
// #6997: the ordering operators are allowed on numbers, decimals, strings and
// std/time types, and on an Option of one; `eq`, `ne` and `in` work on any type.
import { Where } from "std/where"
import { Timestamp, now } from "std/time"

enum Status { Draft, Published }

class Event {
  id: i64
  count: i32
  price: decimal
  name: string
  at: Timestamp
  seen: Option<i64>
  open: bool
  state: Status
}

fn main() {
  let cutoff = now()
  let a: Where<Event> = { count: { gt: 1 }, price: { lte: 9.99 }, name: { lt: "z" } }
  let b: Where<Event> = { at: { gte: cutoff }, seen: { gt: 3 } }
  let c: Where<Event> = { open: { eq: true }, state: { in: [Status.Draft, Status.Published] } }
}
