// run
// #6284: `@table class` needs no import from "std/sql" at all. The loader
// (compiler/project.bit's injectImplicitTableImport) adds std/sql as this
// module's implicit dependency the moment it sees `@table` anywhere in the
// tree, so `tableDescriptor()`/`tableAttrs()`'s synthesized bodies resolve
// `FieldDesc`/`AttrDesc` the same way #6244's `injectImplicitJsonImport`
// already does for `@json`'s `Json`/`JsonEntry` — this file writes zero
// `import` at all.
//
// Diverges from the pinned 0.33.0 oracle on `types` alone (the oracle
// predates this feature and types `p.tableDescriptor()`/`tableAttrs()` as
// `<error>` rather than synthesizing either member at all) — declared as
// scripts/selfhost-ir-signatures.sh's `6284-table-attr-implicit-insert`,
// same shape #6244's `6244-json-attr-implicit-insert` already established.
// `ir`/`iropt` never compare this file at all: the oracle's own `--dump-ir`/
// `--dump-ir-pre` decline outright (an unresolved `<error>`-typed call
// cannot lower), which selfhost-diffdump.sh's run_ir() treats as SKIP, not
// a divergence to explain.
@table @softDelete class Point {
  id: i64,
  x: i64,
  y: i64,
}

fn main() {
  let p = Point{ id = 0, x = 1, y = 2 }
  print("fields=${len(p.tableDescriptor())} attrs=${len(p.tableAttrs())}\n")
}
