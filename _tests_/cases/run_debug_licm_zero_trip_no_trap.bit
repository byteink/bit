// run-debug
// #4052: loop-invariant code motion must not lift a signed multiply out of a
// loop in a `--debug` build. `n` is 0 at run time, so the body never executes
// and `b * b` — which overflows i64 — is never computed. SPEC §13.5's trap
// exists to make a REAL overflow deterministic and testable; firing it for an
// operation the program did not perform turns a correct program into a panic
// under `--debug` alone.
//
// `b * b` is the shape the hoist accepts: both operands are the same
// loop-invariant header parameter, and the loop body reads nothing else that
// varies with the iteration except `sink` and `i`. Hoisting it into the
// preheader — which runs before the loop guard is ever tested — is what this
// case forbids. Mutation-checked: with the arithmetic hoist made unconditional
// this case panics instead of printing `done 0`.
//
// `zero()` and `big()` are routed through `len(args())`, exactly as the four
// `overflow_trap_*` cases are, so `compiler/optfold.bit`'s `foldAddSubMul`
// cannot resolve either at compile time. `args()` has length 1 for the
// argument-free run the harness performs.
import { args } from "std/os"

fn zero(): i64 {
  return i64(len(args())) - 1
}

fn big(): i64 {
  return i64(len(args())) * 4000000000
}

fn main() {
  let n = zero()
  let b = big()
  let sink: i64 = 0
  let i: i64 = 0
  while (i < n) {
    sink = sink + b * b
    i = i + 1
  }
  print("done ${sink}\n")
}
