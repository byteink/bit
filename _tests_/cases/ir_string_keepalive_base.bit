// ir
// #5922: `keepAlive(w)` and `ptrOf(w)` on an exploded string parameter name its
// base word (+16, runtime/ABI.md §2.3), not the whole string, so the aggregate
// is never rebuilt: no `gc_alloc size=24` in either body.
fn hold(w: string): i64 {
  keepAlive(w)
  return len(w)
}

fn first(w: string): u8 {
  let p = ptrOf(w)
  let b = *p
  keepAlive(w)
  return b
}
