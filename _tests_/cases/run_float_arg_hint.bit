// run
// #1467: an untyped float literal lowered with NO type hint materializes at its
// default type `f64`; a narrower consumer then reads the wrong half of it — the
// low 4 bytes, which are zero. `float32Bits(4.5)` returned the f64 bit pattern.
//
// Third defect in the same family as #1456 (float elements crossing the runtime
// word ABI) and #1457 (class-literal field initializers). The rule the three
// share: ANY lowering site that can receive a literal must supply the declared
// type as the hint, or the literal is silently the wrong width.
//
// The four sites this golden pins, each of which was live:
//
//   1. Primitive-builtin arguments. `float32Bits` declares `f32`, but the
//      builtin path lowered its argument list unhinted. Both compilers.
//   2. `defer f(4.5)` against a narrow parameter. `defer` evaluates arguments at
//      the defer site and stashes the VALUES, so a literal materialized at the
//      wrong type there is never corrected at the exit. Seed only.
//   3. Interface-method arguments, `i.m(4.5)`. Self-hosted compiler only — the
//      seed already hinted from the resolved signature. The concrete-receiver
//      form was correct in both, and is kept here as the control for it.
//   4. `return 4.5` from a FALLIBLE `f32!`. Both compilers. The plain `f32`
//      return happened to come out right, which is exactly why this one went
//      unnoticed; the return path never hinted at all, and only the fallible
//      shape exposed it. The declared result type (with `T!` unwrapped) is now
//      the hint, so both shapes are right for the same reason.
//
// The arrow-function expression body — site (5) — has no case here, and this
// note used to claim that was because no shape reaching it type-checked. That
// was WRONG, and the correlation is the lesson: site (5) was the one site of the
// five without a golden, and it was the one still broken. See #1472.
//
// What was actually true: `(x: T): f32 => 4.5` raises a PARSER error (E0021),
// not E0040, because §12's `arrow_p` has no return-type slot — that shape is not
// grammatical in the first place. And the shape without the annotation checks
// perfectly cleanly; it simply returned the wrong value. The real defect was in
// the CHECKER, not this lowering hint: the arrow's result type was left as the
// untyped constant type instead of being defaulted. Covered now, by comparison
// rather than by printing, in `run_float_arrow_body.bit`.
//
// Every check COMPARES rather than prints. #1457 was two stacked bugs precisely
// because print and compare disagreed: a value can render plausibly and still be
// wrong, so a golden that only diffs rendered text proves nothing here. The
// `==` results are what get printed.
//
// `float32Bits(4.5)` is compared against `float32Bits(f32(4.5))` — the explicit
// conversion is the path that always worked — rather than against a pinned
// constant, so the case states the invariant ("the literal and the conversion
// agree") instead of a magic number. No NaN or -0.0 anywhere: their bit patterns
// differ between x86-64 and AArch64.
//
// A golden case is a single file, so it has no prelude.

class C {
  n: i64

  take(x: f32): bool {
    return x == 4.5
  }
}

interface I {
  itake(x: f32): bool,
}

class D {
  n: i64

  itake(x: f32): bool {
    return x == 4.5
  }
}

fn takeF32(x: f32): bool {
  return x == 4.5
}

// The plain and fallible return shapes of the same narrow result. Only the
// fallible one was observably wrong, but both were unhinted.
fn retPlain(): f32 {
  return 4.5
}

fn retFallible(): f32! {
  return 4.5
}

fn deferred(tag: string, x: f32) {
  print("${tag}=${x == 4.5}\n")
}

fn main() {
  // (1) Primitive builtin. The bare literal must agree with the explicit
  // conversion; before the fix it carried the f64 pattern and disagreed.
  print("prim=${float32Bits(4.5) == float32Bits(f32(4.5))}\n")

  // An f64-parameter primitive is the control: its declared type IS the untyped
  // default, so this path was never wrong and must stay right.
  print("primf64=${floatBits(4.5) == floatBits(f64(4.5))}\n")
  print("fsqrt=${fsqrt(4.0) == 2.0}\n")

  // (3) Method arguments, concrete receiver and through an interface.
  let c = C{ n: 1 }
  let i: I = D{ n: 1 }
  print("method=${c.take(4.5)}\n")
  print("iface=${i.itake(4.5)}\n")

  // A plain call: the path that already hinted correctly, kept as a control.
  print("call=${takeF32(4.5)}\n")

  // (4) Returns. The plain shape is the control that always worked; the
  // fallible one is the shape that exposed the missing hint.
  print("retplain=${retPlain() == 4.5}\n")
  let rf = retFallible() catch 0.0
  print("retfallible=${rf == 4.5}\n")

  // (2) The deferred call runs at function exit, so its line prints last.
  defer deferred("defer", 4.5)
}
