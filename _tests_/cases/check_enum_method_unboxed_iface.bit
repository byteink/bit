// error
// #5216: an enum with a method satisfies a structural interface (SPEC
// §14.3/§14.7) the same way a class does — but only when the enum is
// BOXED (some variant carries a payload, SPEC §14.7's representation
// note). A bare-tag enum (no variant carries one) is a raw i64, not the
// GC object pointer an interface value must hold, so it stays rejected
// even though its method set structurally satisfies the interface.
interface Sized {
  size(): int,
}

enum Color {
  Red
  Green
  Blue

  export size(): int {
    match (this) {
      Red => return 1
      Green => return 2
      Blue => return 3
    }
    return 0
  }
}

fn describe(s: Sized): int {
  return s.size()
}

fn main() {
  let c = Color.Green
  print("${describe(c)}\n")
}
