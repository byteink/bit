// run
// SPEC §10.7, #3370: field ORDER is "the using class's declared fields, then
// each used trait's fields in use order" — deterministic, not map-iteration
// order. `Person` declares `id` itself, then `use Named, Aged` in that
// order, so the layout is `id, name, age` regardless of which trait's own
// source happens to sort first or last on disk.
trait Named {
  name: string
}
trait Aged {
  age: i64
}

class Person {
  id: i64
  use Named, Aged
}

fn main() {
  let p = Person{ id: 1, name: "Ann", age: 30 }
  print("${p.id} ${p.name} ${p.age}\n")
}
