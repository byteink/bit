// run
// #6181: a `@json` class field carrying a validation attribute gets an
// "x-bit-attrs" entry on its OWN jsonSchema<T> fragment, naming the
// attribute and its constant arguments (SPEC "jsonSchema<T>" — std/json
// stays independent of pkg/web, which maps its own attributes out of this
// later). `name` carries two attributes, one with one argument and one
// with none, proving multiple recorded attributes and a recorded argument
// both render in declaration order. `id` carries none at all and must have
// no "x-bit-attrs" key whatsoever, not an empty array.
import { Json, JsonEntry, jsonSchema, jsonEncode } from "std/json"

fn pattern(s: string, re: string): ()! {
  if (len(s) == 0) {
    panic("empty")
  }
}

fn nonEmpty(s: string): ()! {
  if (len(s) == 0) {
    panic("empty")
  }
}

@json class Widget {
  @pattern("^[a-z]+$")
  @nonEmpty
  name: string
  id: i64
}

fn main() {
  print("${jsonEncode(jsonSchema<Widget>())}\n")
}
