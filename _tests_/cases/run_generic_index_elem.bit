// run
// #4697: indexing a value whose type is the enclosing generic's own type
// parameter, judged and lowered at the ELEMENT type the instantiation binds.
//
// `checkIndex` (checkmatch.bit) answers 0 for a receiver typed by a rigid `T` —
// the element of an unbound type parameter is undecidable where the template is
// checked — and nothing revisited it, so `v[0]` reached codegen with no type at
// all. `substType(0)` is 0 however concrete the instance is, which is why
// substituting the RESULT could not recover it. Three faces, all here:
//
//   - `"${v[0]}"` was refused by the lowerer as E0092 after `bit check` exited
//     0, at a span inside the template (#1430's check/build divergence);
//   - `let e = v[0]` typed its local 0, which is classified as a GC reference
//     and interpolated no better than the index itself;
//   - `byteAt` is the one that was SILENT: `[]u8`'s element size came out of
//     the missing type, so the read was scaled by a word and
//     `byteAt(bs)` returned 0 where `bs[1]` is 9 — exit 0, wrong answer.
//
// The receiver is substituted first now (`rebindParamDeclTypes`, lowerfunc.bit,
// gives a parameter's decl entry this instance's type; `vInstIndexElem`,
// validateinst.bit, does the same for the check pass), so every rule and the
// lowerer read the element type `indexElemType` gives that receiver.
//
// The rejecting side is _tests_/cases/check_generic_index_elem.bit: an element
// type with no `show()` is E0073 at check time, naming the user's own call.
fn interp<T>(v: T): string {
  return "${v[0]}"
}

fn viaLet<T>(v: T): string {
  let e = v[0]
  return "${e}"
}

fn byteAt<T>(v: T): int {
  return int(v[1])
}

fn main() {
  print("${interp([9, 8])}\n")
  print("${interp(["a", "b"])}\n")
  print("${viaLet([7, 6])}\n")
  let bs = append(append([]u8(0), u8(7)), u8(9))
  print("${byteAt(bs)}\n")
  print("${bs[1]}\n")
  let m = map<i64, string>{}
  m[0] = "val"
  print("${interp(m)}\n")
}
