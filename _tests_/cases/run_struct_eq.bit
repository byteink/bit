// run
// #2105: `==` on two structs compared the HANDLES, so every separately built
// value was unequal to every other whatever its contents. SPEC §14.6 makes a
// class comparable FIELD-WISE. `a == c` was the only true answer before the
// fix, and it was true for the wrong reason — same allocation — so it has to
// stay true here for the right one.
//
// The nested case is the one that pins the recursion: `Q` holds a `P`, which is
// itself a handle, so a field-wise rule that stopped at the first level would
// answer `false` for two equal `Q`s. The string field pins the OTHER kind of
// reference — a `string` field must compare by its bytes, which is why `s4`
// builds "ab" by concatenation rather than reusing the literal.
//
// Single-file golden: no prelude.
class P { x: int, y: int }

class Q { p: P, n: int }

class S { id: int, name: string }

class Packed { a: i8, b: i8, c: i32 }

fn main() {
  let a = P{ x: 1, y: 2 }
  let b = P{ x: 1, y: 2 }
  let c = a
  print("a==b ${a == b} a==c ${a == c} a!=b ${a != b}\n")
  let d = P{ x: 1, y: 3 }
  print("differ ${a == d} ${a != d}\n")
  let q1 = Q{ p: P{ x: 1, y: 2 }, n: 3 }
  let q2 = Q{ p: P{ x: 1, y: 2 }, n: 3 }
  let q3 = Q{ p: P{ x: 1, y: 9 }, n: 3 }
  print("nested ${q1 == q2} ${q1 == q3}\n")
  let s1 = S{ id: 1, name: "ab" }
  let s2 = S{ id: 1, name: "ab" }
  let s3 = S{ id: 1, name: "ac" }
  let s4 = S{ id: 1, name: "a" + "b" }
  print("string ${s1 == s2} ${s1 == s3} ${s1 == s4}\n")
  let p1 = Packed{ a: -1, b: 2, c: -3 }
  let p2 = Packed{ a: -1, b: 2, c: -3 }
  let p3 = Packed{ a: -1, b: 2, c: -4 }
  print("packed ${p1 == p2} ${p1 == p3}\n")
}
