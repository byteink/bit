// panic
// #4346, the empty string: `""[0]` must panic (SPEC §12.6, §18.4). Every index
// is out of range when the length is zero, so this is the case where the bounds
// test is the ONLY thing standing between the read and the header's own bytes —
// `ptr` points at a real, allocated address, so dropping the check reads a live
// byte and returns it rather than faulting.
import { args } from "std/os"

fn zero(): int { return len(args()) - 1 }

fn main() {
  let s = ""
  print("start len=${len(s)}\n")
  print("byte=${s[zero()]}\n")
  print("unreachable\n")
}
