// error
// #5315: E0158 (SPEC §10.3) is unchanged by the method arity fix -- a
// method's defaulted parameter followed by one with no default is still
// rejected on the declaration itself, exactly as fn_default_arg_order.bit
// pins for a free function.

class C {
  export m(a: int = 1, b: int): int {
    return a + b
  }
}

fn main() {
  let c = C{}
  print("${c.m(1, 2)}\n")
}
