// panic
// #3861: `bit_rt_slice_set` is word-valued (`(h, index, word, elemSize)`) and
// cannot represent a packed, non-ref element wider than one machine word
// without silently writing only its first word and leaving the rest of the
// slot unmodified. The compiler side (#3862) guarantees this call is never
// emitted for such a `T` — a field write lowers to a direct store at its own
// offset instead — so this proves the runtime's OWN defense, the write-side
// twin of `run_slice_stride_get_fatal.bit`.
extern fn bit_rt_slice_new(want: int, capWant: int, isRef: int, elemSize: int): int
extern fn bit_rt_slice_append(h: int, word: int, isRef: int, elemSize: int): int
extern fn bit_rt_slice_set(h: int, index: int, word: int, elemSize: int)

fn main() {
  let h = bit_rt_slice_new(0, 0, 0, 24)
  h = bit_rt_slice_append(h, 7, 0, 24)
  print("start\n")
  bit_rt_slice_set(h, 0, 99, 24)
  print("unreachable\n")
}
