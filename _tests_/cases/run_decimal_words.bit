// run
// #3982: a `decimal` (§11.1) is TWO i64 words, and this is the first program
// that can hold one. A decimal local is two i64 locals, a decimal parameter is
// two i64 parameters (#4404's explosion, `explodedWordTypes`), and `${d}`
// renders the exact value from both words — the text of the literal decides
// the scale, so `19.99` is mantissa 1999 at scale 2 and never a float's
// 19.989999999999998.
//
// Unary `-`/`+` (#3982) IS here: `lowerDecimalUnary`/`lowerDecimalNegate`
// flip the sign bit of the hi word, guarding zero so `-0` stays `0` rather
// than a second, printable-negative bit pattern for the same value. Binary
// `+`/`-` and the six comparisons ARE here too (`lowerDecimalBinary`/
// `lowerDecimalCompare`, lowerdecimalarith.bit): scale alignment first
// (`1.05 + 2.1` and `2.1 + 1.05` exercise both directions of the "which side
// is smaller" branch), then a signed 96-bit add. `*`/`/` are NOT — a
// schoolbook multiply and a half-even long division are their own design
// pass, so they still refuse with a span.
//
// `Wallet` covers the class-field side: `balance` is 16 inline bytes
// (`fieldLayoutFor`, lowerlayout.bit), read and written as two 8-byte
// `field_get`/`field_set`s at its offset (`lowerDecimalFieldGet`,
// `lowerFieldStore`). Omitted from the literal below, it is UNDECLARED —
// zero bytes in the zeroed object, which is `0` at scale 0 with no init code
// (§13.4) — before a store ever reaches it. A second `Wallet` sets `balance`
// IN the composite literal, which is `lowerClassLit`'s own `field_set` and
// not `lowerFieldStore`'s: the two paths were built separately and each
// needed its own decimal arm, or `Wallet{ balance: 5.5 }` would have stored
// the two-word tuple's POINTER as the field's raw bytes.

class Wallet {
  id: i64,
  balance: decimal,
}

// #5030: `fee` declares a §10.5 DEFAULT rather than being merely undeclared.
// `Ledger{}` omits it, so `fillOmittedFields` (lowerslicefill.bit) is the one
// that must materialize `2.5` — a single `field_set` there would store the
// two-word tuple's POINTER as the field's raw bytes, same as the other two
// sites this fixture already covers.
class Ledger {
  fee: decimal = 2.5,
}

fn render(d: decimal): string {
  return "${d}"
}

// A decimal parameter passed through and a decimal field read straight out
// of a RETURN, both by way of `emitResolvedCall`'s generic exploded-return
// rebuild (`explodedRetWords`/`materializeExplodedIn`) rather than anything
// decimal-specific at the call site.
fn passthrough(d: decimal): decimal {
  return d
}

fn balanceOf(w: Wallet): decimal {
  return w.balance
}

fn main() {
  // A local, threaded through a join so both words cross a block parameter.
  let price: decimal = 19.99
  let n = 0
  while (n < 2) {
    n = n + 1
  }
  println("${price}")
  // A parameter: two i64 arguments at the call, rebound as words in the callee.
  println(render(19.99))
  println(render(3))
  println(render(0.05))
  println(render(0.001))
  // Scale 0 and a mantissa that needs all 18 digits of word 0.
  println(render(123456789012345678))
  // The local again, after the join: both words survived the block parameters.
  println("${price}")
  // A class field: undeclared reads zero, then a store and a re-read of the
  // same offset.
  let w = Wallet{ id: 7 }
  println("${w.balance}")
  w.balance = 42.75
  println("${w.balance}")
  println("${w.id}")
  // Set in the composite literal, and returned straight out of a call.
  let w2 = Wallet{ id: 9, balance: 5.5 }
  println("${passthrough(w2.balance)}")
  println("${balanceOf(w2)}")
  // A declared default (§10.5), filled by `fillOmittedFields` rather than
  // the composite literal's own field_set.
  let l = Ledger{}
  println("${l.fee}")
  // Unary minus: the computed result, not just a refusal going away.
  println("${-price}")
  println("${-(-price)}")
  // Zero has no sign: negating it must not mint a printable "-0.00".
  let zero: decimal = 0
  println("${-zero}")

  // Binary `+`: scale alignment, both directions of the "which side is
  // smaller" branch (`emitDecimalAlign`, lowerdecimalarith.bit). `1.05` is
  // scale 2, `2.1` is scale 1; swapping operand order swaps which side the
  // alignment loop actually runs on, so both orders must agree.
  let a105: decimal = 1.05
  let b21: decimal = 2.1
  println("${a105 + b21}")
  println("${b21 + a105}")
  // The money case SPEC §11.1 exists for: exact in `decimal`, not in `f64` —
  // both operands untyped-float literals here, carried to `decimal` by the
  // `let`'s own hint rather than by either side already being decimal.
  let c1: decimal = 0.1
  let c2: decimal = 0.2
  println("${c1 + c2}")
  println("${c1 + c2 == 0.3}")
  let fsum: f64 = 0.1 + 0.2
  println("${fsum == 0.3}")
  // Equal scales, subtraction — and a result scale that survives a leading
  // zero the printed text must carry (`0.01`, not `.01` or `1`).
  let e10000: decimal = 100.00
  let e9999: decimal = 99.99
  println("${e10000 - e9999}")
  // A negative result, and a value plus its own negation canonicalizing to
  // POSITIVE zero (`lowerDecimalNegate`'s invariant, preserved through add).
  let g15: decimal = 1.5
  let h35: decimal = 3.5
  println("${g15 - h35}")
  println("${g15 + (-g15)}")

  // The six comparisons. Equality ignores scale (§11.1, this ticket's SPEC
  // addition): `1.0` and `1.00` disagree in their bit pattern and must still
  // compare equal.
  let one0: decimal = 1.0
  let one00: decimal = 1.00
  println("${one0 == one00}")
  println("${one0 != one00}")
  // Ordering across differing scales, required to agree with subtraction's
  // sign — the same values as the `1.05 + 2.1` pair above.
  println("${a105 < b21}")
  println("${(a105 - b21) < 0}")
  let j110: decimal = 1.1
  let j1_10: decimal = 1.10
  println("${j110 <= j1_10}")
  println("${j110 >= j1_10}")
  let k25: decimal = 2.5
  let k205: decimal = 2.05
  println("${k25 > k205}")
  // Negative-vs-positive and negative-vs-negative ordering: a sign mismatch
  // decides it outright, and two negatives order by magnitude REVERSED.
  let negOnePointFive: decimal = -1.5
  let posOnePointFive: decimal = 1.5
  let negOnePointOhFive: decimal = -1.05
  println("${negOnePointFive < posOnePointFive}")
  println("${negOnePointFive < negOnePointOhFive}")
}
