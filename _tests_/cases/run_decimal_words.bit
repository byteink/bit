// run
// #3982: a `decimal` (§11.1) is TWO i64 words, and this is the first program
// that can hold one. A decimal local is two i64 locals, a decimal parameter is
// two i64 parameters (#4404's explosion, `explodedWordTypes`), and `${d}`
// renders the exact value from both words — the text of the literal decides
// the scale, so `19.99` is mantissa 1999 at scale 2 and never a float's
// 19.989999999999998.
//
// Unary `-`/`+` (#3982) IS here: `lowerDecimalUnary`/`lowerDecimalNegate`
// flip the sign bit of the hi word, guarding zero so `-0` stays `0` rather
// than a second, printable-negative bit pattern for the same value. Binary
// `+`/`-` and the six comparisons ARE here too (`lowerDecimalBinary`/
// `lowerDecimalCompare`, lowerdecimalarith.bit): scale alignment first
// (`1.05 + 2.1` and `2.1 + 1.05` exercise both directions of the "which side
// is smaller" branch), then a signed 96-bit add. `*` IS here too
// (`lowerDecimalMultiply`): scale SUMS rather than aligns, and the 96x96
// magnitude product (`emitDecMulPair`) is schoolbook, base `2^64`, two limbs
// a side. `/` is NOT — a half-even long division is its own design pass, so
// it still refuses with a span.
//
// `Wallet` covers the class-field side: `balance` is 16 inline bytes
// (`fieldLayoutFor`, lowerlayout.bit), read and written as two 8-byte
// `field_get`/`field_set`s at its offset (`lowerDecimalFieldGet`,
// `lowerFieldStore`). Omitted from the literal below, it is UNDECLARED —
// zero bytes in the zeroed object, which is `0` at scale 0 with no init code
// (§13.4) — before a store ever reaches it. A second `Wallet` sets `balance`
// IN the composite literal, which is `lowerClassLit`'s own `field_set` and
// not `lowerFieldStore`'s: the two paths were built separately and each
// needed its own decimal arm, or `Wallet{ balance = 5.5 }` would have stored
// the two-word tuple's POINTER as the field's raw bytes.

class Wallet {
  id: i64,
  balance: decimal,
}

// #5030: `fee` declares a §10.5 DEFAULT rather than being merely undeclared.
// `Ledger{}` omits it, so `fillOmittedFields` (lowerslicefill.bit) is the one
// that must materialize `2.5` — a single `field_set` there would store the
// two-word tuple's POINTER as the field's raw bytes, same as the other two
// sites this fixture already covers.
class Ledger {
  fee: decimal = 2.5,
}

fn render(d: decimal): string {
  return "${d}"
}

// A decimal parameter passed through and a decimal field read straight out
// of a RETURN, both by way of `emitResolvedCall`'s generic exploded-return
// rebuild (`explodedRetWords`/`materializeExplodedIn`) rather than anything
// decimal-specific at the call site.
fn passthrough(d: decimal): decimal {
  return d
}

fn balanceOf(w: Wallet): decimal {
  return w.balance
}

fn main() {
  // A local, threaded through a join so both words cross a block parameter.
  let price: decimal = 19.99
  let n = 0
  while (n < 2) {
    n = n + 1
  }
  println("${price}")
  // A parameter: two i64 arguments at the call, rebound as words in the callee.
  println(render(19.99))
  println(render(3))
  println(render(0.05))
  println(render(0.001))
  // Scale 0 and a mantissa that needs all 18 digits of word 0.
  println(render(123456789012345678))
  // The local again, after the join: both words survived the block parameters.
  println("${price}")
  // A class field: undeclared reads zero, then a store and a re-read of the
  // same offset.
  let w = Wallet{ id = 7 }
  println("${w.balance}")
  w.balance = 42.75
  println("${w.balance}")
  println("${w.id}")
  // Set in the composite literal, and returned straight out of a call.
  let w2 = Wallet{ id = 9, balance = 5.5 }
  println("${passthrough(w2.balance)}")
  println("${balanceOf(w2)}")
  // A declared default (§10.5), filled by `fillOmittedFields` rather than
  // the composite literal's own field_set.
  let l = Ledger{}
  println("${l.fee}")
  // Unary minus: the computed result, not just a refusal going away.
  println("${-price}")
  println("${- -price}")
  // Zero has no sign: negating it must not mint a printable "-0.00".
  let zero: decimal = 0
  println("${-zero}")

  // Binary `+`: scale alignment, both directions of the "which side is
  // smaller" branch (`emitDecimalAlign`, lowerdecimalarith.bit). `1.05` is
  // scale 2, `2.1` is scale 1; swapping operand order swaps which side the
  // alignment loop actually runs on, so both orders must agree.
  let a105: decimal = 1.05
  let b21: decimal = 2.1
  println("${a105 + b21}")
  println("${b21 + a105}")
  // The money case SPEC §11.1 exists for: exact in `decimal`, not in `f64` —
  // both operands untyped-float literals here, carried to `decimal` by the
  // `let`'s own hint rather than by either side already being decimal.
  let c1: decimal = 0.1
  let c2: decimal = 0.2
  println("${c1 + c2}")
  println("${c1 + c2 == 0.3}")
  let fsum: f64 = 0.1 + 0.2
  println("${fsum == 0.3}")
  // Equal scales, subtraction — and a result scale that survives a leading
  // zero the printed text must carry (`0.01`, not `.01` or `1`).
  let e10000: decimal = 100.00
  let e9999: decimal = 99.99
  println("${e10000 - e9999}")
  // A negative result, and a value plus its own negation canonicalizing to
  // POSITIVE zero (`lowerDecimalNegate`'s invariant, preserved through add).
  let g15: decimal = 1.5
  let h35: decimal = 3.5
  println("${g15 - h35}")
  println("${g15 + -g15}")

  // The six comparisons. Equality ignores scale (§11.1, this ticket's SPEC
  // addition): `1.0` and `1.00` disagree in their bit pattern and must still
  // compare equal.
  let one0: decimal = 1.0
  let one00: decimal = 1.00
  println("${one0 == one00}")
  println("${one0 != one00}")
  // Ordering across differing scales, required to agree with subtraction's
  // sign — the same values as the `1.05 + 2.1` pair above.
  println("${a105 < b21}")
  println("${a105 - b21 < 0}")
  let j110: decimal = 1.1
  let j1_10: decimal = 1.10
  println("${j110 <= j1_10}")
  println("${j110 >= j1_10}")
  let k25: decimal = 2.5
  let k205: decimal = 2.05
  println("${k25 > k205}")
  // Negative-vs-positive and negative-vs-negative ordering: a sign mismatch
  // decides it outright, and two negatives order by magnitude REVERSED.
  let negOnePointFive: decimal = -1.5
  let posOnePointFive: decimal = 1.5
  let negOnePointOhFive: decimal = -1.05
  println("${negOnePointFive < posOnePointFive}")
  println("${negOnePointFive < negOnePointOhFive}")

  // Binary `*`: scale SUMS rather than aligns (`1.5 * 2.5` is `3.75`, scale
  // `1 + 1`). Both operand orders, since multiplication is commutative and
  // the schoolbook product is not derived from add's alignment path at all.
  println("${g15 * k25}")
  println("${k25 * g15}")
  // Sign rules: negative * positive is negative, negative * negative is
  // positive -- reusing the sign-mismatch/both-negative values already
  // declared above for comparison.
  println("${negOnePointFive * posOnePointFive}")
  println("${negOnePointFive * negOnePointOhFive}")
  // Zero canonicalizes positive even when the other operand is negative --
  // the same invariant `lowerDecimalNegate` and `lowerDecimalAdd` already
  // preserve, now through multiply.
  println("${negOnePointFive * zero}")
  // The 64-bit carry boundary (SPEC's own corpus requirement): each
  // operand's mantissa fits in ONE i64 limb alone, but their product
  // (`1e11 * 1e11 = 1e22`) does not, so `emitDecMulPair`'s `p00hi` must
  // carry into column 1 correctly rather than silently truncating.
  let carryA: decimal = 100000000000
  let carryB: decimal = 100000000000
  println("${carryA * carryB}")
  // Scale sums past what any earlier `render()` call exercised: a run of
  // leading zeros five digits deep, not one or two.
  let thou: decimal = 0.001
  println("${thou * thou}")

  // Binary `/`, half-even (owner ruling, ticket #3982 comment 14): a
  // division that TERMINATES trims to the fewest digits that represent it
  // exactly; one that does not fills the type's precision and rounds the
  // last digit half-even.
  let one: decimal = 1
  let two: decimal = 2
  let three: decimal = 3
  let eight: decimal = 8
  let ten: decimal = 10
  let two50: decimal = 2.50
  let halfDec: decimal = 0.5
  println("${ten / two}")
  println("${one / eight}")
  println("${two50 / halfDec}")

  // Non-terminating: `1/3` and `0.1/0.3` both fill all 28 available digits
  // and round the 29th (a `3`, below halfway) down — no visible rounding,
  // but exercised through the full guard-shift/round machinery either way,
  // unlike the terminating cases above which exit through the trim path.
  println("${one / three}")
  let pOne: decimal = 0.1
  let pThree: decimal = 0.3
  println("${pOne / pThree}")

  // Half-even ties, in both directions and negated, proven directly through
  // division rather than a `round()` API this ticket does not implement
  // (§11.1's constraint). A tie needs the scaled dividend's own scale-up to
  // be IMPOSSIBLE (guard shift 0), or the tie in the small remainder would
  // be diluted by extra digits before rounding ever sees it — so both
  // operands here are built, via `+`/`*` on ≤18-digit literals (a literal
  // itself cannot spell a 28-digit number, §11.1), to sit just under the
  // type's 96-bit maximum, where scaling up by even one more power of 10
  // would overflow. `eightP27 - 1` and `eightP27 - 3` are both odd, so
  // dividing either by 2 leaves a remainder of exactly 1 — half of the
  // divisor, an exact tie — and they were picked so one quotient's last
  // digit is odd (rounds up to even) and the other's is even (stays).
  let p9: decimal = 1000000000
  let p18 = p9 * p9
  let p27 = p18 * p9
  let eightP27 = eight * p27
  let tieUp = eightP27 - one
  let tieDown = eightP27 - three
  println("${tieUp / two}")
  println("${tieDown / two}")
  println("${-tieDown / two}")

  // A near-maximum value (built via multiply alone — #5288, filed
  // separately, is `+` misreading a magnitude past 2^95 as negative and
  // panicking, so this deliberately does not exercise that path), divided
  // by `1`: exercises `emitDecimalScaleMax` taking its OTHER exit (the
  // overflow-fits check stopping the loop at zero rounds, since this
  // magnitude cannot be scaled up by even one more power of 10) on an
  // EXACT division.
  let maxHi: decimal = 79228162514
  let bigVal = maxHi * p18
  println("${bigVal / one}")

  // A tiny operand (scale 17 — the leading `0` before the point is itself
  // one of `decimalConstOf`'s 18 counted digits, so 17 is the largest scale
  // this shape of literal can reach) divided by `2`: the guard-shift cap
  // (`28 - scaleA + scaleB`) binds here, not the overflow check, since the
  // magnitude itself (`1`) is nowhere near 2^96.
  let tiny: decimal = 0.00000000000000001
  println("${tiny / two}")
}
