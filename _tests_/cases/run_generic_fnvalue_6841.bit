// run
fn identity<T>(x: T): T { return x }

class Callbacks {
  number: (int) => int,
  title: (string) => string,
}

fn applyNumber(f: (int) => int, n: int): int { return f(n) }
fn applyTitle(f: (string) => string, s: string): string { return f(s) }
fn numberCallback(): (int) => int { return identity }
fn titleCallback(): (string) => string { return identity }

fn bodyOnly<T>(x: T): T { return x }

fn forwarded<T>(x: T): T {
  let f: (T) => T = bodyOnly
  return f(x)
}

fn duplicate<T>(x: T): (T, T) { return x, x }
fn checked<T>(x: T): T! { return x }

fn shadowed(n: int): int {
  let identity = (v: int) => v + 1
  let shadow: (int) => int = identity
  return shadow(n)
}

fn main() {
  let n: (int) => int = identity
  let s: (string) => string = identity
  println("${n(3)}")
  println(s("draft"))
  println("${applyNumber(identity, 4)}")
  println(applyTitle(identity, "tag"))
  let c = Callbacks{ number = identity, title = identity }
  println("${c.number(5)}")
  println(c.title("field"))
  println("${numberCallback()(6)}")
  println(titleCallback()("return"))
  println("${forwarded(7)}")
  println(forwarded("body"))
  let pair: (string) => (string, string) = duplicate
  let (a, b) = pair("pair")
  println(a + b)
  let safe: (string) => string! = checked
  println(safe("safe") catch "failed")
  println("${shadowed(8)}")
}
