// run
// #6396: a generic interface bounds a type parameter, `S: Store<i64>`, and a
// bound may name a sibling type parameter, `fn load<T, S: Store<T>>`, so `T` is
// inferred from the store: one function prints an i64 store and a string store.
// Also: the same bound on a method, a forwarding generic, a static requirement
// through the bound (`F.make()`), the bound in either parameter order, a bound
// mixed into an `&` list, and the interface VALUE form beside them.
interface Store<T> {
  get(key: string): T,
}

interface Factory<T> {
  static make(): T,
}

interface Named {
  label(): string,
}

class IntStore {
  base: i64
  get(key: string): i64 {
    return this.base + len(key)
  }
  static make(): i64 {
    return 7
  }
  label(): string {
    return "ints"
  }
}

class StrStore {
  pre: string
  get(key: string): string {
    return this.pre + key
  }
  static make(): string {
    return "made"
  }
  label(): string {
    return "strs"
  }
}

class Holder {
  tag: string
  pick<T, S: Store<T>>(s: S, k: string): T {
    return s.get(k)
  }
}

fn load<T, S: Store<T>>(s: S, k: string): T {
  return s.get(k)
}

fn twice<S: Store<i64>>(s: S): i64 {
  return s.get("a") + s.get("bb")
}

fn forward<T, S: Store<T>>(s: S): T {
  return load(s, "fwd")
}

fn build<T, F: Factory<T>>(): T {
  return F.make()
}

fn label<T, S: Store<T> & Named>(s: S): string {
  return s.label()
}

fn viaValue(s: Store<i64>): i64 {
  return s.get("value")
}

fn main() {
  let ints = IntStore{ base = 40 }
  let strs = StrStore{ pre = "hi " }
  println("${load(ints, "ab")}")
  println(load(strs, "there"))
  println("${twice(ints)}")
  println("${Holder{ tag = "h" }.pick(ints, "xyz")} ${Holder{ tag = "h" }.pick(strs, "xyz")}")
  println("${forward(ints)} ${forward(strs)}")
  println("${build<i64, IntStore>()} ${build<string, StrStore>()}")
  println("${label(ints)} ${label(strs)}")
  println("${viaValue(ints)}")
}
