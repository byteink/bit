// run
// #1428: `spawn` of a generic must name the monomorphized instance (`idg$0`),
// not the bare identifier its source span spells. Emitting the template name
// built a binary containing a call to a symbol that was never defined — a clean
// exit 0 from the compiler, then a dyld failure at load.
fn idg<T>(x: T, out: chan<T>) {
  out <- x
}
fn main() {
  let c = chan<i64>(1)
  spawn idg(7, c)
  print("spawned = ${<- c}\n")
}
