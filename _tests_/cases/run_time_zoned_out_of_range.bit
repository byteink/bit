// run
// #4075: `DateTime.toTimestamp` is the one fallible conversion
// (docs/stdlib/time.md, "toTimestamp is the one fallible conversion").
// `Timestamp` spans only 1677-09-21..2262-04-11 (signed 64-bit
// nanoseconds); `Date`/`NaiveDateTime` span years 1..9999. Year 1 is a
// valid `DateTime` and must FAIL to convert, never wrap or silently
// overflow into some other representable instant.
//
// docs/stdlib/time.md's own prose example ("A date of birth in 1890 ... "
// twice, "Ranges" and the superseded-API table) is wrong: 1890 is only 80
// years from the 1970 epoch, comfortably inside the +-292-year range that
// signed 64-bit nanoseconds actually cover (1677-2262) --
// `date(1890, 6, 15)?.atStartOfDay(utc()).toTimestamp()` succeeds. Filed
// as its own ticket rather than silently narrowing the real range to fit
// a wrong example. Year 1 is used here instead, genuinely outside
// 1677-2262 on either boundary.
//
// Also exercises `Date.atStartOfDay`, the third total constructor.
import { date, zone } from "std/time"

fn main() {
  let utc = zone("UTC") catch e {
    println("zone(UTC) failed: ${e.message()}")
    return
  }
  let d = date(1, 1, 1) catch e {
    println("date failed: ${e.message()}")
    return
  }

  let dt = d.atStartOfDay(utc)
  println("toString=${dt.toString()}")
  println("offset=${dt.offset()}")

  dt.toTimestamp() catch e {
    println("toTimestampFails=true message=${e.message()}")
    return
  }
  println("toTimestampFails=false")
}
