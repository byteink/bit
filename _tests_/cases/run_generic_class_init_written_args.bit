// run
// #6363: `Pair<i64, string>(7, "s")` constructs the INSTANTIATION. The call
// resolved the class by its bare name and ignored the written type arguments,
// so it built the template, whose `init$t<template>` symbol nothing defines
// (an undefined-symbol link error, or E0092 on a read of a slot). Named
// arguments (SPEC §12.11) bind to `init`'s own parameter names and fill the
// slots their names say, positional or reordered, for every shape below: a
// plain generic `init`, a defaulted parameter, a fallible `init`, a nested
// instantiation, a construction inside another generic function and inside a
// method of the class itself, and a class with no `init` (a conversion).
class Bad {
  requested: i64

  message(): string {
    return "bad ${this.requested}"
  }
}

class Pair<A, B> {
  a: A
  b: B

  init(first: A, second: B) {
    this.a = first
    this.b = second
  }

  swap(): Pair<B, A> {
    return Pair<B, A>(this.b, this.a)
  }
}

class Checked<T> {
  v: T

  init(v: T, ok: bool)!Bad {
    if (!ok) {
      fail Bad{ requested = 1 }
    }
    this.v = v
  }
}

class Dflt<T> {
  v: T
  n: i64

  init(v: T, n: i64 = 5) {
    this.v = v
    this.n = n
  }
}

class Bare<T> {
  v: T,
}

fn build<X, Y>(x: X, y: Y): Pair<X, Y> {
  return Pair<X, Y>(second = y, first = x)
}

fn main(): ()! {
  let p = Pair<i64, string>(7, "s")
  print("${p.a} ${p.b}\n")
  let q = Pair<i64, string>(second = "t", first = 8)
  print("${q.a} ${q.b}\n")
  let s = q.swap()
  print("${s.a} ${s.b}\n")
  let n = Pair<Pair<i64, i64>, string>(Pair<i64, i64>(1, 2), "n")
  print("${n.a.a} ${n.a.b} ${n.b}\n")
  let ck = Checked<string>("ok", true)?
  print("${ck.v}\n")
  let d = Dflt<string>("x")
  print("${d.v} ${d.n}\n")
  let d2 = Dflt<string>(n = 9, v = "y")
  print("${d2.v} ${d2.n}\n")
  let g = build<i64, bool>(3, true)
  print("${g.a} ${g.b}\n")
  let g2 = build("z", 4.5)
  print("${g2.a} ${g2.b}\n")
  let bb = Bare<i64>(Bare<i64>{ v = 3 })
  print("${bb.v}\n")
  Checked<string>(ok = false, v = "no") catch e {
    print("rejected: ${e.message()}\n")
    return
  }
}
