// run
// #6175: saved headers retain their lengths across every append form.
import { Builder } from "std/strings"
class Holder { items: []int }

fn stash(h: Holder, s: []int) {
  h.items = s
}

fn pushField(h: Holder, v: int) {
  h.items = append(h.items, v)
}

fn report(tag: string, s: []int) {
  print("${tag}: len=${len(s)}\n")
}

fn pushDeep(xs: []int, d: int): []int {
  if (d == 0) {
    xs = append(xs, 7)
    return xs
  }
  return pushDeep(xs, d - 1)
}

fn build(n: int): []int {
  let out = []int(0, 16)
  let k = 0
  while (k < n) {
    out = append(out, k)
    k = k + 1
  }
  return out
}

class Log { items: []int }
class Snap { items: []int }
class Shared { items: []int }

fn logPush(l: Log, v: int, d: int) {
  if (d == 0) {
    l.items = append(l.items, v)
    return
  }
  logPush(l, v, d - 1)
}

fn snapPush(s: Snap, v: int, d: int) {
  if (d == 0) {
    s.items = append(s.items, v)
    return
  }
  snapPush(s, v, d - 1)
}

fn sharedPush(s: Shared, v: int, d: int) {
  if (d == 0) {
    s.items = append(s.items, v)
    return
  }
  sharedPush(s, v, d - 1)
}

class Stack { items: []int }
class Multi { items: []int, kept: []int }

fn stackPush(s: Stack, v: int, d: int) {
  if (d == 0) {
    s.items = append(s.items, v)
    return
  }
  stackPush(s, v, d - 1)
}

fn multiPush(m: Multi, v: int, d: int) {
  if (d == 0) {
    let h = m.items
    m.kept = h
    m.items = append(h, v)
    return
  }
  multiPush(m, v, d - 1)
}

fn stashDeep(h: Holder, s: []int, d: int) {
  if (d > 0) {
    stashDeep(h, s, d - 1)
    return
  }
  let k = 0
  while (k < len(s)) {
    k = k + 1
  }
  h.items = s
}

fn probe(s: []int, h: Holder, j: int, d: int): int {
  if (d > 0) {
    return probe(s, h, j, d - 1)
  }
  let n = 0
  let i = 0
  while (i < len(s)) {
    n = n + s[i]
    i = i + 1
  }
  if (j == 1) {
    stashDeep(h, s, 2)
  }
  return n
}

class Esc { items: []int }
class Wrap { held: []int }

fn escPush(e: Esc, v: int, d: int) {
  if (d == 0) {
    e.items = append(e.items, v)
    return
  }
  escPush(e, v, d - 1)
}

fn escBox(e: Esc, d: int): Wrap {
  if (d > 0) {
    return escBox(e, d - 1)
  }
  let k = 0
  while (k < len(e.items)) {
    k = k + 1
  }
  return Wrap{ held = e.items }
}

class Pair { items: []int }

fn pairPush(p: Pair, v: int, d: int) {
  if (d == 0) {
    p.items = append(p.items, v)
    return
  }
  pairPush(p, v, d - 1)
}

fn pairNote(p: Pair, v: int, d: int): int {
  if (d > 0) {
    return pairNote(p, v, d - 1)
  }
  let k = 0
  while (k < v) {
    k = k + 1
  }
  pairPush(p, k, 2)
  return k + 1
}

fn pairTwice(p: Pair, v: int, d: int) {
  if (d == 0) {
    p.items = append(p.items, pairNote(p, v, 2))
    return
  }
  pairTwice(p, v, d - 1)
}

fn deferShape() {
  let d = []int(0, 10)
  d = append(d, 1)
  defer report("defer", d)
  let k = 0
  while (k < 3) {
    d = append(d, k)
    k = k + 1
  }
}

interface Noter { note(p: IPair, v: int): int }
class IPair { items: []int }

class QuietNote {
  bias: int
  note(p: IPair, v: int): int {
    let k = this.bias
    while (k < v) {
      k = k + 1
    }
    return k + len(p.items)
  }
}

class PushNote {
  bias: int
  note(p: IPair, v: int): int {
    let k = this.bias
    while (k < v) {
      k = k + 1
    }
    ipairPush(p, k, 2)
    return k + 1
  }
}

fn ipairPush(p: IPair, v: int, d: int) {
  if (d == 0) {
    p.items = append(p.items, v)
    return
  }
  ipairPush(p, v, d - 1)
}

fn ipairTwice(p: IPair, n: Noter, v: int, d: int) {
  if (d == 0) {
    p.items = append(p.items, n.note(p, v))
    return
  }
  ipairTwice(p, n, v, d - 1)
}

class Chain { items: []int }

fn chainPair(c: Chain, v: int, d: int) {
  if (d > 0) {
    chainPair(c, v, d - 1)
    return
  }
  c.items = append(c.items, v)
  c.items = append(c.items, v + 1)
}

fn chainTwo(c: Chain, v: int, d: int): int {
  if (d > 0) {
    return chainTwo(c, v, d - 1)
  }
  c.items = append(c.items, v)
  let t = append(c.items, v + 1)
  return len(t)
}

fn headersBasic() {
  let base = []int(0)
  base = append(base, 1)
  let x = append(base, 100)
  let y = append(base, 100)
  let z = append(y, 200)
  print("shared: xlen=${len(x)} ylen=${len(y)} zlen=${len(z)} z2=${z[2]}\n")

  let a = []int(0, 4)
  a = append(a, 1)
  a = append(a, 2)
  print("safe: alen=${len(a)} a0=${a[0]} a1=${a[1]}\n")

  let xs = []int(0, 4)
  xs = append(xs, 1)
  let alias = xs
  xs = append(xs, 2)
  print("alias: xslen=${len(xs)} aliaslen=${len(alias)} alias0=${alias[0]}\n")

  let acc = []int(0, 10)
  let snap: []int = []
  let k = 0
  while (k < 10) {
    acc = append(acc, k)
    if (k == 4) {
      snap = acc
    }
    k = k + 1
  }
  print("loop: acclen=${len(acc)} snaplen=${len(snap)} snaplast=${snap[len(snap) - 1]}\n")
}

fn headersHeaderForms() {
  let bs = []u8(0, 8)
  let bsOld = bs
  let bsNew = append(bs, "xy")
  print("strfit: old=${len(bsOld)} new=${len(bsNew)} value=${string(bsNew)}\n")
  let bg = [u8(65)]
  let bgOld = bg
  let bgNew = append(bg, "BC")
  print("strgrow: old=${len(bgOld)} new=${len(bgNew)} value=${string(bgNew)}\n")
  let sp = []int(0, 8)
  let spOld = sp
  let spNew = append(sp, ...[2, 3])
  print("spreadfit: old=${len(spOld)} new=${len(spNew)} last=${spNew[1]}\n")
  let sg = [1]
  let sgOld = sg
  let sgNew = append(sg, ...[2, 3])
  print("spreadgrow: old=${len(sgOld)} new=${len(sgNew)} last=${sgNew[2]}\n")
}

fn headersLoopBounds() {
  let ranged = [1, 2, 3]
  let grown = ranged
  let seen = 0
  for value of ranged {
    grown = append(grown, value)
    seen = seen + 1
    if (seen > 100) {
      break
    }
  }
  print("bound: count=${seen} input=${len(ranged)} grown=${len(grown)}\n")
  let indices = [7, 8]
  let indicesGrow = indices
  let indexCount = 0
  for position in indices {
    indicesGrow = append(indicesGrow, position)
    indexCount = indexCount + 1
    if (indexCount > 100) {
      break
    }
  }
  print("bound-in: count=${indexCount} input=${len(indices)} grown=${len(indicesGrow)}\n")
  let pairs = [5, 6, 7]
  let pairGrow = pairs
  let pairCount = 0
  for (position, value) in pairs {
    pairGrow = append(pairGrow, value + position)
    pairCount = pairCount + 1
    if (pairCount > 100) {
      break
    }
  }
  print("bound-pair: count=${pairCount} input=${len(pairs)} grown=${len(pairGrow)}\n")
  let licm: []int = []
  licm = append(licm, 1)
  licm = append(licm, 2)
  licm = append(licm, 3)
  let other = licm
  let licmBefore = len(licm)
  other = append(other, 4)
  let total = 0
  let index = 0
  while (index < len(licm)) {
    total = total + licm[index]
    index = index + 1
  }
  print("licm: sum=${total} before=${licmBefore} input=${len(licm)} grown=${len(other)}\n")
}

fn headersEscapes() {
  let cacc = []int(0, 10)
  let lenAt: () => int = () => 0
  let facc = []int(0, 10)
  let hc = Holder{ items = []int(0) }
  let sacc = []int(0, 10)
  let hs = Holder{ items = []int(0) }
  let macc = []int(0, 10)
  let m = map<int, []int>()
  let lacc = []int(0, 10)
  let store = [][]int(0)
  let bacc = []int(0, 10)
  let sub: []int = []
  let j = 0
  while (j < 5) {
    cacc = append(cacc, j)
    facc = append(facc, j)
    sacc = append(sacc, j)
    macc = append(macc, j)
    lacc = append(lacc, j)
    bacc = append(bacc, j)
    if (j == 1) {
      let held = cacc
      lenAt = () => len(held)
      stash(hc, facc)
      hs.items = sacc
      m[1] = macc
      store = append(store, lacc)
      sub = bacc[0:len(bacc)]
    }
    j = j + 1
  }
  print("closure: acclen=${len(cacc)} held=${lenAt()}\n")
  print("call: acclen=${len(facc)} stashed=${len(hc.items)}\n")
  print("field: acclen=${len(sacc)} stored=${len(hs.items)}\n")
  print("map: acclen=${len(macc)} value=${len(m[1])}\n")
  print("slice: acclen=${len(lacc)} elem=${len(store[0])}\n")
  print("subslice: acclen=${len(bacc)} sub=${len(sub)}\n")
  let r = build(3)
  let r2 = append(r, 9)
  let r3 = append(r, 8)
  print("return: r=${len(r)} r2=${len(r2)} r3=${len(r3)}\n")
  let p = []int(0, 4)
  p = append(p, 1)
  let q1 = pushDeep(p, 2)
  let q2 = pushDeep(p, 2)
  print("param: p=${len(p)} q1=${len(q1)} q2=${len(q2)}\n")
  let fh = Holder{ items = []int(0, 4) }
  pushField(fh, 1)
  let before = fh.items
  pushField(fh, 2)
  print("fieldrmw: items=${len(fh.items)} before=${len(before)}\n")
  deferShape()
}

fn headersFields() {
  let lg = Log{ items = []int(0, 8) }
  let li = 0
  while (li < 5) {
    logPush(lg, li, 2)
    li = li + 1
  }
  print("owned: len=${len(lg.items)} last=${lg.items[4]}\n")
  let builder = Builder().write("old")
  let saved = builder.tail(1)
  builder.truncate(0).write("new")
  let whole = builder.toString()
  builder.write("!")
  print("ownedbytes: tail=${saved} whole=${whole} now=${builder.toString()}\n")
  let sn = Snap{ items = []int(0, 8) }
  snapPush(sn, 1, 2)
  let old = sn.items
  snapPush(sn, 2, 2)
  print("snapshot: items=${len(sn.items)} old=${len(old)}\n")
  let sh = Shared{ items = []int(0) }
  let mine = []int(0, 8)
  sh.items = mine
  sharedPush(sh, 1, 2)
  print("sharedstore: items=${len(sh.items)} mine=${len(mine)}\n")
  lg.items = lg.items[0:2]
  logPush(lg, 7, 2)
  print("ownedpop: len=${len(lg.items)} last=${lg.items[2]}\n")
  let st = Stack{ items = []int(0, 8) }
  stackPush(st, 1, 2)
  stackPush(st, 2, 2)
  let popped = st.items[0:1]
  st.items = popped
  stackPush(st, 9, 2)
  print("pop: items=${len(st.items)} popped=${len(popped)}\n")
  let mu = Multi{ items = []int(0, 8), kept = []int(0) }
  multiPush(mu, 1, 2)
  print("multiuse: items=${len(mu.items)} kept=${len(mu.kept)}\n")
}

fn headersBorrow() {
  let bor = []int(0, 10)
  let hb = Holder{ items = []int(0) }
  let bj = 0
  let bsum = 0
  while (bj < 5) {
    bsum = bsum + probe(bor, hb, bj, 2)
    bor = append(bor, bj)
    bj = bj + 1
  }
  print("borrowchain: acclen=${len(bor)} stashed=${len(hb.items)} sum=${bsum}\n")
}

fn headersCopies() {
  let es = Esc{ items = []int(0, 8) }
  escPush(es, 1, 2)
  let w = escBox(es, 2)
  escPush(es, 2, 2)
  print("escape: items=${len(es.items)} held=${len(w.held)}\n")
  let pr = Pair{ items = []int(0, 8) }
  pairTwice(pr, 5, 2)
  print("calleeappend: len=${len(pr.items)} last=${pr.items[len(pr.items) - 1]}\n")
}

fn headersIface() {
  let ip = IPair{ items = []int(0, 8) }
  ipairTwice(ip, QuietNote{ bias = 0 }, 3, 2)
  ipairTwice(ip, PushNote{ bias = 0 }, 5, 2)
  print("ifacecallee: len=${len(ip.items)} last=${ip.items[len(ip.items) - 1]}\n")
}

fn headersChain() {
  let ch = Chain{ items = []int(0, 8) }
  chainPair(ch, 1, 2)
  let ct = chainTwo(ch, 5, 2)
  print("chainstore: items=${len(ch.items)} t=${ct} last=${ch.items[len(ch.items) - 1]}\n")
}

class BulkOwned { items: []int }
class BulkSaved { items: []int }

fn bulkPush(h: BulkOwned, src: []int, depth: int) {
  if (depth == 0) {
    h.items = append(h.items, ...src)
    return
  }
  bulkPush(h, src, depth - 1)
}

fn bulkSavedPush(h: BulkSaved, src: []int, depth: int) {
  if (depth == 0) {
    h.items = append(h.items, ...src)
    return
  }
  bulkSavedPush(h, src, depth - 1)
}

fn bulkLocal(src: []int) {
  let dst = []int(0, 8)
  dst = append(dst, ...src)
  print("bulk-local: len=${len(dst)} last=${dst[len(dst) - 1]}\n")
}

fn bulkLive(src: []int) {
  let dst = [1]
  let saved = dst
  dst = append(dst, ...src)
  print("bulk-live: old=${len(saved)} new=${len(dst)} last=${dst[len(dst) - 1]}\n")
}

fn bulkSelf() {
  let dst = [1, 2]
  dst = append(dst, ...dst)
  print("bulk-self: len=${len(dst)} last=${dst[len(dst) - 1]}\n")
}

fn bulkAncestor() {
  let dst = [1]
  let saved = dst
  dst = append(dst, ...[2, 3])
  let middle = len(dst)
  dst = append(dst, ...saved)
  print("bulk-ancestor: old=${len(saved)} middle=${middle} final=${len(dst)} last=${dst[len(dst) - 1]}\n")
}

fn bulkFields() {
  let owned = BulkOwned{ items = []int(0, 8) }
  bulkPush(owned, [3, 4], 2)
  bulkPush(owned, [3, 4], 2)
  print("bulk-field: len=${len(owned.items)} last=${owned.items[len(owned.items) - 1]}\n")
  let held = BulkSaved{ items = []int(0, 8) }
  bulkSavedPush(held, [3, 4], 2)
  let saved = held.items
  bulkSavedPush(held, [5], 2)
  print("bulk-field-alias: old=${len(saved)} new=${len(held.items)}\n")
}

enum MovedNode { Items([]int), Other(int) }
class MovedOpen { node: MovedNode }

fn movedInstall(h: MovedOpen, node: MovedNode, depth: int) {
  if (depth > 0) {
    movedInstall(h, node, depth - 1)
    return
  }
  h.node = node
}

fn movedPush(h: MovedOpen, v: int, depth: int) {
  if (depth > 0) {
    movedPush(h, v, depth - 1)
    return
  }
  match (h.node) {
    Items(xs) => { h.node = MovedNode.Items(append(xs, v)) }
    Other(_) => {}
  }
}

fn movedItems(node: MovedNode, depth: int): []int {
  if (depth > 0) {
    return movedItems(node, depth - 1)
  }
  match (node) {
    Items(xs) => { return xs }
    Other(_) => { return []int(0) }
  }
}

enum SharedNode { Items([]int), Other(int) }
class SharedOpen { node: SharedNode }

fn enumInstall(h: SharedOpen, node: SharedNode, depth: int) {
  if (depth > 0) {
    enumInstall(h, node, depth - 1)
    return
  }
  h.node = node
}

fn enumPush(h: SharedOpen, v: int, depth: int) {
  if (depth > 0) {
    enumPush(h, v, depth - 1)
    return
  }
  match (h.node) {
    Items(xs) => { h.node = SharedNode.Items(append(xs, v)) }
    Other(_) => {}
  }
}

fn enumItems(node: SharedNode): []int {
  match (node) {
    Items(xs) => { return xs }
    Other(_) => { return []int(0) }
  }
}

fn headersEnum() {
  let h = MovedOpen{ node = MovedNode.Other(0) }
  movedInstall(h, MovedNode.Items([1]), 2)
  movedPush(h, 2, 2)
  print("enum-moved: len=${len(movedItems(h.node, 2))}\n")
  let saved = movedItems(h.node, 2)
  movedPush(h, 3, 2)
  print("enum-payload-alias: old=${len(saved)} new=${len(movedItems(h.node, 2))}\n")
  let a = SharedOpen{ node = SharedNode.Other(0) }
  let b = SharedOpen{ node = SharedNode.Other(0) }
  let node = SharedNode.Items([1])
  enumInstall(a, node, 2)
  enumInstall(b, node, 2)
  enumPush(a, 2, 2)
  print("enum-shared: a=${len(enumItems(a.node))} b=${len(enumItems(b.node))}\n")
}

fn main() {
  headersBasic()
  headersHeaderForms()
  headersLoopBounds()
  headersEscapes()
  headersFields()
  headersBorrow()
  headersCopies()
  headersIface()
  headersChain()
  bulkLocal([3, 4])
  bulkLive([3, 4])
  bulkSelf()
  bulkAncestor()
  bulkFields()
  headersEnum()
}
