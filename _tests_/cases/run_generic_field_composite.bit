// run
// Field-type substitution must descend EVERY composite shape, not just a bare
// type param (#1556). Each field below mentions `T` one level down; a read off a
// `Shapes<i64>` must yield the i64 form. The slice and chan fields are the ones
// that matter beyond a type-printing nit: `[]<T>` classifies as holding GC
// references, so a wrong answer here hands slice_new is_ref=1 and the collector
// walks plain integers as pointers.
class Box<T> { v: T }

class Shapes<T> {
  bare: T,
  slice: []T,
  nested: Box<T>,
  deep: Box<Box<T>>,
  m: map<string, T>,
  arr: [2]T,
  apply: (T) => T,
  ch: chan<T>,
}

fn idI(a: i64): i64 { return a }

fn use(s: Shapes<i64>): i64 {
  s.ch <- 9
  let got = <- s.ch
  return s.bare +
    s.slice[0] +
    s.nested.v +
    s.deep.v.v +
    s.m["k"] +
    s.arr[0] +
    s.apply(6) +
    got +
    len(s.slice)
}

fn main() {
  let mm = map<string, i64>{}
  mm["k"] = 5
  let s = Shapes<i64>{
    bare: 1,
    slice: []i64(1),
    nested: Box<i64>{ v: 2 },
    deep: Box<Box<i64>>{ v: Box<i64>{ v: 3 } },
    m: mm,
    arr: [2]i64{ 7, 8 },
    apply: idI,
    ch: chan<i64>(1),
  }
  print("${use(s)}\n")
}
