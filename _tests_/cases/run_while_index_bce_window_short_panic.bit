// panic
// #6840: `i + 1 < len(s)` proves `s[i]` and `s[i + 1]`, not `s[i + 2]`. The
// window is the header's own offset; compiler/optbce.bit must keep the check
// on the wider read, which fires once `i + 2` reaches the end.
fn main() {
  let s = "abcd"
  let i = 0
  while (i + 1 < len(s)) {
    eprint("i=${i} b=${s[i + 2]}\n")
    i = i + 1
  }
  eprint("unreachable\n")
}
