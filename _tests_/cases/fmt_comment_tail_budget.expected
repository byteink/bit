// fmt
// #2899: no construct budgets for a trailing same-line comment, so `fmtGap`
// can push a line past `fmtMaxWidth` (100). `assert(...)`'s single argument
// is a `Binary` chain that stays flat regardless of width (#2894's settled
// single-item-list exemption, `spec/FMT.md` §5) -- its own fits check never
// sees the comment that follows. Fixing this would require the nested
// chain's wrap decision to measure the real column instead of
// `Printer.speculativeFlat`'s indent baseline, i.e. touching #2894's
// mechanism, which is out of scope here (decided wontfix, see the ticket).
// This case pins the CURRENT, accepted shape -- input and `.expected` are
// byte-identical, so `bit fmt` is idempotent on it -- as a regression
// guard: if this ever starts wrapping (or stops), it should be a deliberate
// change, not silent drift.
class Ops {
  bytes: []u8,
}

fn probeCommentBudget(ops: Ops): bool {
  assert(ops.bytes[4] == u8(0x22) && ops.bytes[5] == u8(0x80) && ops.bytes[6] == u8(0x02)) // uleb(0x100)
  return true
}
