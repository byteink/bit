// error
// #6519: a strict cell (`@threadlocal`, or in a runtime/ module) ships as a
// static byte image, and a `decimal` image is built from the literal's text, so
// `-2.5` (which `vConstEval` folds as a float) is refused at the declaration
// rather than failing later in lowering.
@threadlocal let d: decimal = -2.5

fn main() {
  print("${d}\n")
}
