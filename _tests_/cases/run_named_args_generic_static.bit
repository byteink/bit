// run
// #6347: named arguments on a STATIC method of a generic class, called through
// a written instantiation (SPEC §10.4.1, §12.11). A name binds to a parameter
// of the method's own declaration and the arguments are then placed and
// checked as for the positional call. `tag` declares `(n, p)`; every call
// writes `p` first, so a value that lands in the wrong slot prints the wrong
// text.
//
// `Pair<i64, bool>.tag(..)` used to fail with E0128: the instantiation's
// method table (`copyInstMethod`, checkinstmethods.bit) did not carry the
// method's staticness, so the call read as an instance-method call on a type
// name and its names bound nothing. The lowering named the TEMPLATE's symbol
// (`tag$t<Pair>`), which no one emits: a generic class's methods exist once
// per instantiation, so the call now names the instantiation's.
//
//  1. all-named, reordered;
//  2. a positional prefix with a named suffix;
//  3. a different instantiation of the same class;
//  4. through a type parameter of the enclosing generic function.

class Pair<A, B> {
  a: A
  b: B
  static tag(n: i64, p: string): string {
    return "${n}/${p}"
  }
}

fn via<T>(v: T): string {
  return Pair<T, bool>.tag(p = "t", n = 5)
}

fn main() {
  print("${Pair<i64, bool>.tag(p = "y", n = 2)}\n")
  print("${Pair<i64, bool>.tag(3, p = "x")}\n")
  print("${Pair<string, i64>.tag(p = "w", n = 4)}\n")
  print("${via(1)}\n")
}
