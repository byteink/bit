// run
// #3933 control: append(xs, n) where `n` names an EXISTING variable — not a
// fresh composite literal — already disqualified elemTy from the inline
// representation before this ticket (#3862's scanAppendArgs). This fixture
// exists to prove the slice-literal fix alongside it left this path
// unchanged: `n` aliases `batch[1]` afterward, so writing through `n` must
// be observed through `batch[1]` too, which is impossible under the packed
// representation and would silently print a stale value if the bail-out did
// not fire.
class Node { x: i64, y: i64 }

fn main() {
  let batch = [Node{ x: 1, y: 2 }]
  let n = Node{ x: 3, y: 4 }
  batch = append(batch, n)
  n.x = 999
  print("${batch[0].x} ${batch[0].y} ${batch[1].x} ${batch[1].y}\n")
}
