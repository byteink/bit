func flip(%0: bool, %1: bool) bool {
bb0(%0: bool, %1: bool):
  %2 = const_bool false
  %3 = icmp_eq bool %0, %2
  br %3, bb1(), bb2(%3)
bb1():
  %5 = icmp_eq bool %1, %2
  jump bb2(%5)
bb2(%7: bool):
  ret %7
}

