func twice(%0: i64) i64 {
bb0(%0: i64):
  %1 = const_int i64 2
  %2 = mul i64 %0, %1
  %3 = add i64 %2, %2
  ret %3
}

func signs(%0: f64) f64 {
bb0(%0: f64):
  %1 = const_float f64 0
  %2 = fmul f64 %0, %1
  %3 = const_float f64 -0
  %4 = fmul f64 %0, %3
  %5 = fadd f64 %2, %4
  ret %5
}

func half(%0: f64) f64 {
bb0(%0: f64):
  %1 = const_float f64 1.5
  %2 = fmul f64 %0, %1
  %3 = fadd f64 %2, %2
  ret %3
}

func flip(%0: bool, %1: bool) bool {
bb0(%0: bool, %1: bool):
  %2 = const_bool false
  %3 = icmp_eq bool %0, %2
  br %3, bb1(), bb2(%3)
bb1():
  %5 = icmp_eq bool %1, %2
  jump bb2(%5)
bb2(%7: bool):
  ret %7
}

func main() void {
bb0():
  ret
}
