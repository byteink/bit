// run
// #5313: wires #5312's eligibility predicate and ref-union into the live
// `explodedWordTypes` dispatcher (compiler/lowerexplode.bit), so an eligible
// N=2 boxed enum (one tag word, one payload word, #4238) explodes across a
// function boundary exactly like a two-word tuple (#4404) — and proves the
// two things #5312 deliberately left undone:
//
//   roundtrip   `Opt` (a non-ref payload) crosses a function boundary BOTH
//               directions — `makeOpt`'s return and `sumOpt`'s parameter —
//               and is `match`ed on the callee side. `bit --dump-ir` on this
//               shape shows ZERO `gc_alloc` surviving optimization: the fix
//               is not just that `match` no longer panics
//               `index out of range` in `matchTag`/`bindArmPayload`
//               (compiler/lowerbranch.bit) on an exploded subject — it is
//               that the two functions read the subject's WORDS directly
//               (`matchSubjectWords`/`lowerMatchSubject`) instead of
//               unconditionally materializing a box at the match's own entry
//               block, which is what made the box survive optimization even
//               after the crash was fixed: a payload binder's `field_get`
//               runs in the ARM's own block, a different one than the match
//               entry, so block-local store-to-load forwarding
//               (`ir_tuple_layout.bit`) could never answer it.
//
//   escaping    `stashOpt` constructs an `Opt` and stores it in a `[]Opt`
//               slice — a genuine escape — so `Opt` must still box exactly
//               once, unchanged from what an unmodified compiler already
//               does: dead-allocation elimination's existing escape rule
//               doing its job, not new code.
//
//   callsubj    #5340: `match (makeOpt(9))` — the subject is the CALL ITSELF,
//               not an identifier bound to an exploded local. `emitResolvedCall`
//               (compiler/lowerprim.bit) rebuilds the callee's two return
//               registers into a box in the CALLER's current block, and before
//               #5340 `lowerMatchSubject` took that box as its handle, so the
//               payload binder's `field_get` again ran in the arm's block and
//               the rebuild survived optimization. `matchSubjectWords`'s
//               identifier test could not see this shape at all. This is the
//               shape `bench/cases/json` is built from — 10 of them in its
//               `main` alone — and it cost json 3,900,003 objects.
//
//   mixedRef    `Res` (`Ok(i64)` non-ref, `Err(string)` ref) is #5312's own
//               conservative-union case: the shared payload word must trace
//               as a reference because ONE variant's payload there is a
//               pointer, even though this call only ever constructs the
//               non-ref `Ok` arm.
fn makeOpt(x: i64): Opt {
  if (x > 0) {
    return Opt.Some(x)
  }
  return Opt.None
}

enum Opt {
  Some(i64),
  None,
}

fn sumOpt(o: Opt): i64 {
  match (o) {
    Some(v) => return v * 2,
    None => return -1,
  }
}

fn stashOpt(x: i64): []Opt {
  let o = makeOpt(x)
  let xs = [o]
  return xs
}

enum Res {
  Ok(i64),
  Err(string),
}

fn mkRes(x: i64): Res {
  return Res.Ok(x)
}

fn describeRes(r: Res): string {
  match (r) {
    Ok(v) => return "ok:${v}",
    Err(s) => return "err:${s}",
  }
}

fn main() {
  let o = makeOpt(21)
  print("roundtrip ${sumOpt(o)}\n")

  let xs = stashOpt(7)
  match (xs[0]) {
    Some(v) => print("escaping ${v}\n"),
    None => print("escaping none\n"),
  }

  print("mixedRef ${describeRes(mkRes(5))}\n")

  // #5340: the match subject is the call result itself, with no intervening
  // `let`. Both arms are exercised, and the argument is derived from `xs`'s
  // length rather than written as a literal so nothing here can be folded
  // into a constant subject — a probe the folder deleted would read as a
  // clean negative.
  let n: i64 = len(xs)
  match (makeOpt(n * 9)) {
    Some(v) => print("callsubj ${v}\n"),
    None => print("callsubj none\n"),
  }
  match (makeOpt(0 - n)) {
    Some(v) => print("callsubj ${v}\n"),
    None => print("callsubj none\n"),
  }
}
