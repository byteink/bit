// run
// #6056: a value-context `||`/`&&` whose right operand is pure compares is
// computed without a branch (compiler/optselect.bit); one whose right operand
// loads, divides or calls keeps its short circuit. Every result is printed,
// so a wrong `bor`/`band`, a swapped arm or a skipped operand prints a wrong
// line, and an operand evaluated when the left one decided either panics
// (index, divide) or prints a line it must not.
//
//   1. character classes built from `||` of `&&` range tests, chained and
//      spliced from helpers, over every byte that sits on a range edge
//   2. bool parameters and mixed `!` operands
//   3. guarded index, guarded divide and a call on the right: skipped when
//      the left operand decides, at an index far past the end

fn isDigit(c: u8): bool {
  return c >= '0' && c <= '9'
}

fn isAlpha(c: u8): bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

fn isNumberChar(c: u8): bool {
  return isAlpha(c) || isDigit(c) || c == '.' || c == '_' || c == '+' || c == '-'
}

fn inBoth(c: u8): bool {
  return c >= '0' && c <= 'z' && c != '@' && !(c > '9' && c < 'A')
}

fn either(a: bool, b: bool): bool {
  return a || b
}

fn both(a: bool, b: bool): bool {
  return a && b
}

fn mixed(a: bool, x: int, y: int): bool {
  return !a && (x < y || x == 7)
}

fn byteAt(s: []u8, i: int, c: u8): bool {
  return i < len(s) && s[i] == c
}

fn ratioOver(n: int, d: int): bool {
  return d != 0 && n / d > 2
}

fn loud(tag: string, v: bool): bool {
  println("eval ${tag}")
  return v
}

fn classify(cs: string) {
  let b = []u8(cs)
  let out = ""
  for c of b {
    let n = "-"
    if (isNumberChar(c)) {
      n = "N"
    }
    let m = "-"
    if (inBoth(c)) {
      m = "B"
    }
    out = out + n + m + " "
  }
  println(out)
}

fn main() {
  classify("/09:@AZ[`az{.-_+, ")
  let (f, t) = (false, true)
  println("either ${either(f, f)} ${either(f, t)} ${either(t, f)} ${either(t, t)}")
  println("both ${both(f, f)} ${both(f, t)} ${both(t, f)} ${both(t, t)}")
  println("mixed ${mixed(f, 1, 2)} ${mixed(f, 7, 2)} ${mixed(f, 3, 2)} ${mixed(t, 1, 2)}")
  let s = []u8("ab")
  let far = 1 << 40
  println(
    "byteAt ${byteAt(s, 0, 'a')} ${byteAt(s, 1, 'a')} ${byteAt(s, 2, 'a')} ${byteAt(s, far, 'a')}",
  )
  println("ratio ${ratioOver(9, 0)} ${ratioOver(9, 3)} ${ratioOver(9, 4)}")
  let x = loud("left-true", true) || loud("right-of-or", true)
  let y = loud("left-false", false) && loud("right-of-and", true)
  println("calls ${x} ${y}")
}
