// run
// #4520/#4513: an arrow written in RETURN position takes its unannotated
// parameter types from the ENCLOSING function's declared result type.
//
// Before checkarrow.bit's `seedArrowExpectedReturn`, the four seeded positions
// (annotated `let`, call argument, composite-literal field/element/value,
// assignment target) did not include a `return`, so `t` and `next` below
// stayed at type 0. `bit check` exited 0 on this file and `bit build` then
// refused it with two `error[E0092]: cannot lower a call whose callee does not
// resolve to a function` — one at `t.v()`, one at `next(t)`. The divergence is
// what made it s1: a scoped `bit check` gate is green on a program that cannot
// be emitted.
//
// Both callee spellings are pinned because they fail through different
// lowering arms: `t.v()` is a METHOD on a parameter (lowercall.bit's class
// receiver arm, which needs the receiver's type), `next(t)` is a parameter
// that is ITSELF a function value (the `call_value` arm). The controls below
// are the shapes that already worked and must keep working:
//   - the same arrow as a call ARGUMENT (`call(...)`), seeded by
//     `seedArrowExpectedCall`;
//   - a CAPTURED callee inside a returned closure (`inner` in `makeCap`), which
//     resolves through the closure environment and never needed a parameter
//     type at all;
//   - a returned arrow inside an `if`, to pin that the seeding descends
//     through nested statements rather than reading only a body's tail.
class Thing {
  n: int
  export v(): int { return this.n }
}

type Inner = (Thing) => int
type Fn2 = (Thing, int) => int
type Fn3 = (Thing, Inner) => int

fn make(k: int): Fn2 {
  return (t, m) => {
    let x = t.v()
    return x + m + k
  }
}

fn make2(k: int): Fn3 {
  return (t, next) => {
    return next(t) + k
  }
}

// The seeding must reach a `return` nested inside a statement, not just a
// body's last statement.
fn makeIf(k: int): Fn2 {
  if (k > 0) {
    return (t, m) => {
      return t.v() * m + k
    }
  }
  return (t, m) => {
    return t.v() - m
  }
}

// Control: a captured callee, which worked before this fix and still must.
fn makeCap(inner: Inner): Fn2 {
  return (t, m) => {
    return inner(t) + m
  }
}

// Control: the identical arrow in ARGUMENT position.
fn call(f: Fn2, t: Thing, m: int): int {
  return f(t, m)
}

fn getV(t: Thing): int {
  return t.v()
}

fn main(): ()! {
  let f = make(1)
  println("make ${f(Thing{ n: 7 }, 2)}")
  let g = make2(100)
  println("make2 ${g(Thing{ n: 1 }, getV)}")
  let h = makeIf(3)
  println("makeIf ${h(Thing{ n: 5 }, 2)}")
  let h0 = makeIf(0)
  println("makeIf0 ${h0(Thing{ n: 5 }, 2)}")
  let c = makeCap(getV)
  println("makeCap ${c(Thing{ n: 9 }, 4)}")
  let a = call(
    (t, m) => {
      return t.v() + m
    },
    Thing{ n: 7 },
    2,
  )
  println("arg ${a}")
  return
}
