// ir
// #7058: `case B, C, D, E:` over a tag-only enum, its labels four tags in
// declaration order, lowers to ONE unsigned range test: `sub u64` of the run's
// first tag, then `icmp_ule` against the run's width (3), feeding the `br`.
// Before, it was four `icmp_eq` OR-folded by three `bor` (pkg/toml's
// `readScalar`). The arithmetic is `u64`, not the subject's own type, so the
// `sub` wraps by spec and has no signed-overflow trap to take in `--debug`.
// `mixed` is the control: a set with a gap keeps its `icmp_eq`/`bor` chain.
// `negs` (#7069): negative labels fold to `const_int` at lowering time, so
// `case -5, -4, -3:` takes the same range test rather than the chain.
// The runtime half (values just below, inside and just above a run) is
// run_switch_range.bit.

enum K { A, B, C, D, E, F }

fn mid(k: K): i64 {
  switch (k) {
    case K.B, K.C, K.D, K.E:
      return 1
    default:
      return 0
  }
}

fn mixed(x: i64): i64 {
  switch (x) {
    case 1, 2, 4:
      return 1
    default:
      return 0
  }
}

fn negs(x: i32): i64 {
  switch (x) {
    case -5, -4, -3:
      return 1
    default:
      return 0
  }
}

fn main() {
  println("${mid(K.A)} ${mixed(3)} ${negs(-4)}")
}
