// run
// #5977: a spliced call's merged return that the caller only compares with a
// constant is skipped on every edge whose argument already decides the compare
// (compiler/optthread.bit). Each helper is small enough to splice; each caller
// tests its result once. Every path of every test is taken and printed, so a
// join threaded to the wrong successor prints a wrong line.
//
//   1. `!= 0` on an int return, one edge constant, one not (partial threading)
//   2. `== 0`, the same join with the arms swapped
//   3. a fallible callee's error word: `nil` on the ok edge, a fresh error
//      object on the fail edge, and the ok value read after `?` (both edges
//      thread and the read is re-pointed)
//   4. a bool return compared with `true`, both edges constant

class Odd {
  message(): string {
    return "odd"
  }
}

fn tagged(base: int, tag: int): int {
  if (tag != (base ^ 77)) {
    return 0
  }
  return base * 3
}

fn pickNe(base: int, tag: int): int {
  if (tagged(base, tag) != 0) {
    return base + 1
  }
  return base - 1
}

fn pickEq(base: int, tag: int): int {
  if (tagged(base, tag) == 0) {
    return base - 10
  }
  return base + 10
}

fn half(x: int): int! {
  if (x % 2 == 1) {
    fail Odd{}
  }
  return x / 2
}

fn sumHalves(n: int, step: int): int! {
  let s = 0
  let i = 0
  while (i < n) {
    s = s + half(i)?
    i = i + step
  }
  return s
}

fn small(x: int): bool {
  if (x < 10) {
    return true
  }
  return false
}

fn classify(x: int): string {
  if (small(x) == true) {
    return "small"
  }
  return "large"
}

fn halves(n: int, step: int) {
  let r = sumHalves(n, step) catch e {
    print("halves ${n} ${step} fail ${e.message()}\n")
    return
  }
  print("halves ${n} ${step} ok ${r}\n")
}

fn main() {
  print("ne match ${pickNe(5, 5 ^ 77)}\n")
  print("ne miss ${pickNe(5, 1)}\n")
  print("ne zero ${pickNe(0, 77)}\n")
  print("eq match ${pickEq(5, 5 ^ 77)}\n")
  print("eq miss ${pickEq(5, 1)}\n")
  print("eq zero ${pickEq(0, 77)}\n")
  halves(10, 2)
  halves(10, 1)
  halves(0, 1)
  print("${classify(3)} ${classify(30)}\n")
}
