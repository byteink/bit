// run
fn main() {
  // `// run` compares stdout only, which is exactly the point: if `eprint` ever
  // regressed onto fd 1, the two stderr lines below would appear here and this
  // case would fail. Nothing else in the suite can observe the stream split.
  eprint("diagnostic one\n")
  print("stdout line\n")
  eprint("diagnostic two\n")
  print("stdout again\n")
  // Deferred `eprint` goes through lowerDeferBuiltin's separate rt-call path.
  defer eprint("deferred to stderr\n")
  print("last\n")
}
