// run
// A u64-typed module `const` must keep u64 in the IR (#1239). If its literal
// were kept as i64, `BIG` would be -1: the comparison would go signed (`> 5`
// false) and the logical shift would sign-fill. Each line below flips its
// output under signed semantics, so this is a real miscompile guard, not a
// tautology. Was worked around in stdlib/quic/tls.bit with explicit `u64(X)`.
//
// THE CONSTANTS ARE ALSO PRINTED DIRECTLY, and that is not decoration. This
// case held `BIG` and never interpolated it, so it read as coverage of u64 and
// was not: #2011 rendered `${BIG}` as `-1` while every line above stayed green,
// and the bug was independently rediscovered three times by readers who saw
// this file and assumed the ground was covered. The output path is exercised in
// depth by `run_uint_format.bit`; the two lines here exist so this file cannot
// mislead the next reader again.
const BIG: u64 = 0xFFFFFFFFFFFFFFFF
const HALF: u64 = 0x8000000000000000

fn main() {
  if (BIG > 5) {
    print("gt ")
  } else {
    print("le ")
  }
  if (HALF > 100) {
    print("hi ")
  } else {
    print("lo ")
  }
  print("${BIG >> 60}\n")
  print("${BIG}\n")
  print("${HALF}\n")
}
