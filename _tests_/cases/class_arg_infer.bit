// types
// #7005: a bare class name passed to a `Class<T>` parameter infers `T`, so the
// `Where<T>` literal that follows is checked against that class, left to right.
// The literal is accepted for the class named in the second argument, for a free
// function and for a method alike.
import { Class, Where } from "std/where"

class Article {
  id: i64,
  authorId: i64,
  status: string,
}

class Policy {
  can<T>(action: string, res: Class<T>, where: Where<T>): bool {
    return true
  }
}

fn allowed<T>(res: Class<T>, where: Where<T>): bool {
  return true
}

fn main() {
  let p = Policy{}
  let a = p.can("read", Article, { authorId: 7, status: "published" })
  let b = allowed(Article, { id: 1 })
  let c = allowed(Article, {})
}
