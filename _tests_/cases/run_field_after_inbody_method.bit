// run
// #3810: audits #3762's structFieldNodes fix (16b0299b) for a field declared
// AFTER an in-body method, not just before one. Pre-fix, structFieldNodes
// returned the in-body method as a phantom extra "field" occupying real
// layout space, shifting every field declared later in source order by 8
// bytes — so `b` below would have been computed at the wrong offset and its
// writes/reads would have landed on the wrong storage.
class Box {
  a: i64

  greet(): i64 {
    return this.a
  }

  b: i64
}

fn main() {
  let x = Box{ a: 11, b: 22 }
  print("${x.a} ${x.b} ${x.greet()}\n")
  x.b = 99
  print("${x.a} ${x.b}\n")
}
