// panic
// #2502: `m[k] = v` on a nil map must panic (SPEC §12.6, §18.4: "write to a
// nil map") rather than silently dropping the write. The map comes from
// `len(args())` so it cannot fold to a known-nil value at compile time --
// neither the optimizer nor a future compile-time-nil diagnostic can retire
// this case, only a real runtime check can.
import { args } from "std/os"

fn nilMap(): map<string,int> {
  if (len(args()) - 1 == 0) {
    return nil
  }
  return map<string,int>{}
}

fn main() {
  let m = nilMap()
  print("start\n")
  m["k"] = 1
  print("unreachable\n")
}
