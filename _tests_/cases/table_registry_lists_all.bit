// run
// #6301 (S1, epic #6298): std/sql's `__tables()` registry lists every
// `@table` class in the project, across modules, in declaration order.
// `compiler/lowertableregistry.bit` replaces its stub body at the IR level
// only because THIS FILE calls it — a program that never references
// `__tables` gets no new IR at all.
import { __tables } from "std/sql"
import { Account } from "./table_registry_lib"

@table class Person {
  id: i64,
  name: string,
}

fn main() {
  let a = Account{ id = 1, balance = 100 }
  println("${a.balance}")
  for t of __tables() {
    println(t.name)
  }
}
