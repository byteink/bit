// run
// #3445: `contains` for a relative root of `"."` or `""` — both mean "the
// current directory", so every non-escaping relative child must be inside,
// not just the ones under a named subdirectory. `clean` already strips a
// leading `./`, so the naive fix of testing a `"./"` prefix can never match;
// `..` and any path starting `../` must still read as escaping.
import { contains } from "std/path"

fn main() {
  println("dot=${contains(".", "a")}")
  println("dotNested=${contains(".", "a/b")}")
  println("dotDotSlash=${contains(".", "./a")}")
  println("empty=${contains("", "a")}")
  println("dotSelf=${contains(".", ".")}")
  println("dotEscape=${contains(".", "..")}")
  println("dotEscapeNested=${contains(".", "../a")}")
  println("dotAbsEscape=${contains(".", "/etc/passwd")}")
  println("dotLookalike=${contains(".", "..foo")}")
  println("namedRoot=${contains("sub", "sub/a")}")
}
