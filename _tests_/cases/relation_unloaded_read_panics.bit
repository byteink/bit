// panic
//
// #5271 step 3: reading a relation field that was never loaded panics,
// naming the field and the class -- the runtime half of E0218
// (compiler/lintrelation.bit, #5247, parked). `User{ id = 1, email =
// "a@b.com" }` omits `orders`, so `fillOmittedFields`
// (compiler/lowerslicefill.bit) leaves it at classrelationattr.bit's
// `relationUnloadedSentinel` instead of the ordinary null/empty zero value,
// and `u.orders` (compiler/loweraccess.bit's `lowerFieldAccess`) panics
// before the sentinel word could reach `len`. Sibling fixtures
// relation_loaded_read_ok.bit and relation_loaded_empty_distinguishes.bit
// are the two required negatives: a real slice, and an explicitly empty
// one, neither of which panics.
import { FieldDesc, AttrDesc } from "std/sql"

class Order {
  id: i64,
}

@table class User {
  @id
  id: i64
  email: string
  @hasMany("userId")
  orders: []Order
}

fn main() {
  let u = User{ id = 1, email = "a@b.com" }
  print("${len(u.orders)}\n")
}
