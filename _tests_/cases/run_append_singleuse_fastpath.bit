// run
// #6092 follow-up: `compiler/optappend.bit`'s inline fast path is back, gated
// on a PROOF that the header fed into `append` has exactly one use in the
// whole function (`useCounts`, compiler/optcommaok.bit) — this pins both
// sides of that proof.
//
// PROVEN SAFE: `a` is reassigned to its own append result every time and
// nothing else ever reads the pre-call header, so the compiler mutates it in
// place — same observable result as the general (cloning) path, cheaper.
//
// PROVEN UNSAFE: `let y = xs` makes `y` a second live reference to the exact
// header `xs` holds (SPEC §13.3: assigning a slice copies the reference).
// `xs = append(xs, 2)` then has TWO uses of that header — this call and `y`'s
// later read — so the single-use proof fails and the general (cloning) path
// runs instead: `y` must keep reading its own, unchanged length.
fn main() {
  let a = []int(0, 4)
  a = append(a, 1)
  a = append(a, 2)
  print("safe:  len=${len(a)} a0=${a[0]} a1=${a[1]}\n")

  let xs = []int(0, 4)
  xs = append(xs, 1)
  let y = xs
  xs = append(xs, 2)
  print("alias: xslen=${len(xs)} ylen=${len(y)} y0=${y[0]}\n")
}
