// run
// #4439: a `defer` on a variadic method call resolved its argument slots
// WITHOUT collecting the variadic tail, so the deferred call read the
// string "ab"'s own byte length (2) as the element count instead of the
// true argument count (1).
class Foo {
  x: int
  bar(...args: string): string { return "n=${len(args)}" }
}
fn callIt(f: Foo) {
  defer print("${f.bar("ab")}\n")
  print("before\n")
}
fn main() {
  callIt(Foo{ x: 1 })
}
