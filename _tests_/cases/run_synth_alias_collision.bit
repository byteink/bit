// run
// #7564: every name synthesized code reaches is bound under a reserved `__`
// alias, so a module that declares the same names itself still compiles. This
// module has an `@json` class and a `@table` class, which synthesize against
// std/json, std/sql and (for relations) pkg/orm, and declares at top level every
// helper, type and function those syntheses use: `Json`, `JsonEntry`,
// `JsonReader`, the `jsonDec*`/`jsonText*`/`jsonAppend*` helpers, `Value`,
// `Rows`, `FieldDesc`, `AttrDesc`, `JoinDesc`, the `sqlReq*`/`sqlOpt*`
// accessors and pkg/orm's `Data`, `RelationLoader`, `LinkOp`, `ManyToManyDesc`
// and relation functions. Before the aliases every one of these was E0042
// against the synthesized import. `dispatchLoadRelation` is left out on purpose:
// declaring it is how the compiler recognizes pkg/orm's own module
// (`moduleIsOrmPackage`), which would switch relation synthesis on here.
import { jsonDecodeText } from "std/json"

class JsonReader {
  tag: int = 0,
}

class Json {
  tag: int = 0,
}

class JsonEntry {
  tag: int = 0,
}

class Value {
  tag: int = 0,
}

