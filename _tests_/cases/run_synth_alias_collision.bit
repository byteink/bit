@json class Point {
  x: i64,
  y: i64,
}

@table class Account {
  id: i64,
  balance: i64,
}

fn main() {
  let p = jsonDecodeText<Point>("{\"x\": 3, \"y\": 4}") catch e {
    panic("decode: ${e.message()}")
  }
  print("point=${p.x},${p.y}\n")
  print("table=${Account.__tableName()} columns=${len(Account.__columns())}\n")
}
