// run
// #7243: optselect.bit's rangeTest turns a value-context `x >= lo && x <= hi`
// on an unsigned `x` into `(x - lo) <= hi - lo`, which is right only because
// `x - lo` wraps below `lo`. Every u8 is tested against the plain compares, so
// an off-by-one bound, a missed wrap or a signed operand admitted by mistake
// prints a mismatch. `empty` has `lo > hi` and must stay false everywhere;
// `signed` must keep the two compares.

fn digit(c: u8): bool {
  return c >= '0' && c <= '9'
}

fn alpha(c: u8): bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

fn edges(c: u8): bool {
  return c >= 0 && c <= 255
}

fn empty(c: u8): bool {
  return c >= 200 && c <= 100
}

fn signed(x: i8): bool {
  return x >= -3 && x <= 4
}

// Whether every helper agrees with the plain compares at `k`.
fn agrees(k: int): bool {
  let c = u8(k)
  let ok = digit(c) == (k >= 48 && k <= 57)
  ok = ok && alpha(c) == ((k >= 97 && k <= 122) || (k >= 65 && k <= 90))
  ok = ok && edges(c) && !empty(c)
  return ok && signed(i8(k - 128)) == (k - 128 >= -3 && k - 128 <= 4)
}

fn main() {
  let bad = 0
  let hits = 0
  let k = 0
  while (k < 256) {
    if (!agrees(k)) {
      println("mismatch at ${k}")
      bad = bad + 1
    }
    if (digit(u8(k)) || alpha(u8(k))) {
      hits = hits + 1
    }
    k = k + 1
  }
  println("bad=${bad} hits=${hits}")
}
