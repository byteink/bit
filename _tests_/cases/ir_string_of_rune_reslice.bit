// ir
// #7637: `string(rs[lo:hi])` on a `[]rune` is ONE
// `rt_call string_from_rune_range(rs, lo, hi)`; a `[]byte` receiver keeps
// `string_from_byte_range` (ir_string_of_byte_reslice.bit). The value and the
// bounds are pinned by run_string_of_rune_reslice*.bit.

fn f(rs: []rune, lo: int, hi: int): string {
  return string(rs[lo:hi])
}
