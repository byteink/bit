// run
// #6112 (SPEC §10.3): a parameter default is a call-site-evaluated
// expression, not a bare literal — `1 + 1` type-checks against `int` exactly
// like any other assigned expression and is evaluated fresh on the one call
// below that omits it. Was `fn_default_arg_not_const.bit`'s pinned E0159
// error before #6112 widened the rule; kept under the same name.

fn f(x: int = 1 + 1): int {
  return x
}

fn main() {
  print("${f()}\n")
}
