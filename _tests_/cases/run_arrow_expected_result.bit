// run
// #1487: an arrow fn passed where a function type is expected failed E0041.
//
//     function apply(f: (f32) => f32): f32 { return f(1.0) }
//     apply((x: f32) => 4.5)
//     // error[E0041]: expected '(f32) => f32', found '(f32) => f64'
//
// Two independent defects, one per compiler, with the same symptom.
//
// The SEED already threads an expected type down every `checkExpr`, so its
// `checkArrowFn` knew the expectation was `(f32) => f32` and checked the body
// against f32 successfully — then interned the arrow with the body's own
// `untyped float` as its result, and the very expectation that had just been
// satisfied rejected the type built from it.
//
// The SELF-HOSTED checker infers bottom-up and had no expected-type context at
// all, so the untyped body simply defaulted to f64 and mismatched. It now
// records the expected function type per ArrowFn node (`Checker.arrowExpected`)
// at the two positions that can supply one — an annotated binding's initializer
// and a resolved free call's argument — and reads it in `checkArrowFn`.
//
// Adoption is deliberately narrow in BOTH: only an UNTYPED constant body takes
// the expected result, and only when it is assignable to it. A body with a type
// of its own keeps that type, so a genuine mismatch stays the loud E0041 it has
// always been rather than being silently adapted away. That is what keeps this
// from trading a false positive for a false negative.
//
// Every check COMPARES rather than prints, for the reason #1457 taught and
// #1472 repeated: this family's signature is a value that renders plausibly and
// still compares wrong.
//
// A golden case is a single file, so it has no prelude.

fn applyF32(f: (f32) => f32): f32 {
  return f(1.0)
}

fn applyI32(f: (i32) => i32): i32 {
  return f(1)
}

class Ops {
  scale: (f32) => f32,
}

fn main() {
  // The defect itself: an untyped float body, expected f32 by the parameter it
  // is passed to. Both compilers rejected this before the fix.
  print("arg=${applyF32((x: f32) => 4.5) == 4.5}\n")

  // The same expectation reaching a BLOCK body, which takes the other branch of
  // checkArrowFn — the expected result wins over the inferred one there too.
  print("argblock=${applyF32((x: f32) => { return 4.5 }) == 4.5}\n")

  // The other position that supplies an expectation: an annotated binding.
  let g: (f32) => f32 = (x: f32) => 4.5
  print("annotated=${g(1.0) == 4.5}\n")

  // The result must actually be the NARROW type, not merely accepted. An f32
  // cannot hold 0.1 exactly, so a result that silently stayed f64 compares
  // unequal to the f32 round-trip and this flips.
  let narrow: (f32) => f32 = (x: f32) => 0.1
  print("narrow=${narrow(1.0) == f32(0.1)}\n")

  // A class field of function type is NOT one of the two recorded positions,
  // so this arrow is inferred exactly as before. It is here as the control that
  // the untouched paths still work.
  let ops = Ops{scale: (x: f32) => f32(4.5)}
  print("field=${ops.scale(1.0) == 4.5}\n")

  // An untyped INT body against an i32 parameter: representable, so it adopts.
  // Its old default of i64 is a different width, so this is a real narrowing.
  print("sliceint=${applyI32((x: i32) => 7) == 7}\n")
}
