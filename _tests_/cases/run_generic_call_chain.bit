// run
// #2102, the shapes the minimal case does not reach. The report was written
// against a merge sort, and the reason it could not be worked around is that
// every practical spelling of "a generic algorithm factored into generic
// helpers" is this same shape:
//
//   - a slice type parameter (`[]T`) rather than a scalar;
//   - the SAME generic called twice, its result carried between the calls;
//   - loop-carried, `dst = acc(dst, xs[i])` inside a `while`, which is what an
//     iterative bottom-up merge sort reduces to;
//   - a chain three deep, so the monomorphization worklist has to close
//     transitively rather than one level down.
fn idf<T>(x: T): T { return x }

fn cp<T>(xs: []T): []T {
  let out = []T(0)
  let i = 0
  while (i < len(xs)) {
    out = append(out, xs[i])
    i = i + 1
  }
  return out
}

// Two calls to the SAME generic, the first's result feeding the second.
fn twice<T>(xs: []T): []T {
  let a = cp(xs)
  return cp(a)
}

// Loop-carried: the accumulator is re-bound from a generic call every turn.
fn accumulate<T>(xs: []T): []T {
  let dst = []T(0)
  let i = 0
  while (i < len(xs)) {
    dst = append(dst, idf(xs[i]))
    i = i + 1
  }
  return cp(dst)
}

// Three deep: chain -> mid -> idf, each generic, each carrying through a local.
fn mid<T>(x: T): T {
  let m = idf(x)
  return idf(m)
}

fn chain<T>(x: T): T {
  let a = mid(x)
  return mid(a)
}

fn main() {
  let ints = twice([1, 2, 3])
  print("${ints[0]}${ints[1]}${ints[2]}\n")

  // A reference element type as well as a scalar one: the two monomorphizations
  // classify their slots differently in the GC descriptor.
  let strs = twice(["a", "b"])
  print("${strs[0]}${strs[1]}\n")

  let acc = accumulate([4, 5, 6])
  print("${acc[0]}${acc[1]}${acc[2]}\n")

  print("${chain(7)} ${chain("z")}\n")
}
