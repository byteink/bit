// run
// NEGATIVE case for E0058 (#1541). E0058 fires when a generic type is named with
// the wrong number of type arguments, so its false-positive shapes are (a) a
// CORRECT arity this checker miscounts and (b) a name that is not a generic-type
// reference at all being judged as one. A single well-formed `Box<T>` would test
// only the happy path; what matters is that the check is entered from every
// declared-type POSITION, because it is driven off the declaring construct
// rather than off the type node itself.
//
// The runtime half is deliberately thin. E0058 is a check-time diagnostic, so
// the annotations below are the payload; `main` only exercises what the
// self-hosted lowerer currently handles. Two shapes are annotated but not
// evaluated, each for a filed pre-existing reason: field access through a slice
// ELEMENT of a generic class (#1544, a checker false positive; #1545's sibling
// in lowering), and a generic ENUM with a payload (#1545, cannot lower).
class Box<T> { v: T }

class Pair<A, B> { a: A, b: B 
  // A generic type's own parameters on the receiver.
  left(): i64 {
    return this.a
  }
}

class Plain { n: i64 }

// Generic types in class FIELD position, including behind a slice, behind a
// map value, and nested one generic inside another.
class Nest {
  one: Box<i64>,
  two: Pair<i64, string>,
  many: []Box<i64>,
  keyed: map<string, Box<i64>>,
  deep: Box<Pair<i64, string>>,
}

// A type PARAMETER is a bare ident in type position but is NOT a generic-type
// reference. Judging `T` as one would refuse every generic in the codebase.
// Also covers generic-type-in-parameter and generic-type-in-RESULT position.
fn unwrap<T>(b: Box<T>): T {
  return b.v
}

// Declared but never called: a generic type in RESULT position is an E0058 site,
// and an uninstantiated generic template is not lowered, which keeps this clear
// of the nested-generic-call lowering gap that `unwrap(rewrap(b))` hits.
fn rewrap<T>(b: Box<T>): Box<T> {
  return b
}

// Generic types as parameter annotations, including behind a slice.
fn countBoxes(xs: []Box<i64>, m: Pair<i64, string>): i64 {
  return len(xs) + m.a
}

fn main() {
  let b = Box<i64>{v: 7}
  print("${unwrap(b)}\n")
  let p = Pair<i64, string>{a: 3, b: "x"}
  print("${p.left()}\n")
  // A local `let` annotation naming a generic type with correct arity.
  let q: Box<i64> = Box<i64>{v: 11}
  print("${q.v}\n")
  // A non-generic type named bare must stay legal — arity 0 is not a violation.
  let plain: Plain = Plain{n: 5}
  print("${plain.n}\n")
  print("${countBoxes([Box<i64>{v: 4}], p)}\n")
}
