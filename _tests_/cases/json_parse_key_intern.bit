// run
// stdlib/json/parse.bit's `internKey` (#4358): the parser hands back one
// string per distinct object key instead of slicing a fresh 24-byte header
// per entry. Interning changes a key's IDENTITY, never its bytes, so the way
// it can go wrong is a key coming back as some OTHER key — every case here
// reads a value through the key it was stored under, or prints the keys the
// parser actually produced.
//
// Covers: one key set repeated across sibling objects and across nesting
// depths (the hit path the cache exists for); keys differing only in their
// last byte and only in their length, which the slot index alone cannot
// separate; more distinct keys in one object than the 16-slot table holds,
// then a re-lookup of an evicted key; the empty key, whose length matches an
// empty slot's zero-value string; non-ASCII keys; and escaped keys, which
// bypass the table — `"a\"b"`, `"a\\b"` and `"ab"` must stay three keys while
// `"ab"` and `"ab"` must stay one.
import { newBuilder } from "std/strings"
import { Json, jsonParse, jsonGet, jsonAsArray, jsonAsObject, jsonAsInt } from "std/json"

fn get(label: string, doc: string, key: string) {
  let parsed = jsonParse(doc) catch e {
    print("${label}=parse failed: ${e.message()}\n")
    return
  }
  match (jsonGet(parsed, key)) {
    Some(v) => {
      match (jsonAsInt(v)) {
        Some(n) => print("${label}=${n}\n")
        None => print("${label}=non-int\n")
      }
    }
    None => print("${label}=None\n")
  }
}

// The keys the parser produced, in source order, each with its byte length.
// A mixed-up slot shows here as a wrong name, not merely a wrong value.
fn keys(label: string, doc: string) {
  let parsed = jsonParse(doc) catch e {
    print("${label}=parse failed: ${e.message()}\n")
    return
  }
  match (jsonAsObject(parsed)) {
    Some(entries) => {
      print("${label}:")
      for e of entries {
        print(" [${e.key}]/${len(e.key)}")
      }
      print("\n")
    }
    None => print("${label}=not an object\n")
  }
}

// `n` sibling records sharing one key set, each holding its own index — the
// shape the cache exists for. Every record must read back its own value, so a
// slot that leaked one record's key into the next shows up in the sums.
fn siblings(n: int) {
  let b = newBuilder()
  b.writeByte('[')
  let i = 0
  while (i < n) {
    if (i > 0) {
      b.writeByte(',')
    }
    b.write("{\"id\":${i},\"idx\":${i * 2},\"nested\":{\"id\":${i * 3}}}")
    i = i + 1
  }
  b.writeByte(']')
  sumSiblings(
    jsonParse(b.toString()) catch e {
      print("siblings=parse failed: ${e.message()}\n")
      return
    },
  )
}

fn sumSiblings(doc: Json) {
  let id = 0
  let idx = 0
  let nestedId = 0
  match (jsonAsArray(doc)) {
    Some(items) => {
      for it of items {
        id = id + intAt(it, "id")
        idx = idx + intAt(it, "idx")
        match (jsonGet(it, "nested")) {
          Some(inner) => nestedId = nestedId + intAt(inner, "id")
          None => print("siblings=missing nested\n")
        }
      }
    }
    None => print("siblings=not an array\n")
  }
  print("siblings id=${id} idx=${idx} nested.id=${nestedId}\n")
}

fn intAt(o: Json, key: string): int {
  match (jsonGet(o, key)) {
    Some(v) => {
      match (jsonAsInt(v)) {
        Some(n) => return int(n)
        None => return -1000000
      }
    }
    None => return -1000000
  }
}

// One object holding `n` distinct keys `k0..k(n-1)`, each mapped to its own
// index. With n past the table's 16 slots every key has been evicted at least
// once by the time it is read back.
fn manyKeys(n: int) {
  let b = newBuilder()
  b.writeByte('{')
  let i = 0
  while (i < n) {
    if (i > 0) {
      b.writeByte(',')
    }
    b.write("\"k${i}\":${i}")
    i = i + 1
  }
  b.writeByte('}')
  let parsed = jsonParse(b.toString()) catch e {
    print("manyKeys=parse failed: ${e.message()}\n")
    return
  }
  let bad = 0
  i = 0
  while (i < n) {
    if (intAt(parsed, "k${i}") != i) {
      bad = bad + 1
    }
    i = i + 1
  }
  print("manyKeys n=${n} mismatches=${bad}\n")
}

// Descends through `v` until it reaches a non-object, printing what it found.
fn deep(doc: string) {
  let cur = jsonParse(doc) catch e {
    print("deep=parse failed: ${e.message()}\n")
    return
  }
  let level = 0
  while (level < 8) {
    match (jsonGet(cur, "v")) {
      Some(v) => {
        cur = v
        level = level + 1
      }
      None => level = 8
    }
  }
  match (jsonAsInt(cur)) {
    Some(n) => print("deep leaf=${n}\n")
    None => print("deep leaf=non-int\n")
  }
}

fn main() {
  siblings(40)
  manyKeys(40)

  // Same length, differing only in the final byte.
  keys("tailbyte", "{\"key1\":1,\"key2\":2,\"key3\":3}")
  get("tailbyte-1", "{\"key1\":1,\"key2\":2,\"key3\":3}", "key1")
  get("tailbyte-3", "{\"key1\":1,\"key2\":2,\"key3\":3}", "key3")

  // Same first and last byte, differing only in length.
  keys("prefix", "{\"aa\":1,\"aba\":2,\"abba\":3,\"abbba\":4}")
  get("prefix-aa", "{\"aa\":1,\"aba\":2,\"abba\":3,\"abbba\":4}", "aa")
  get("prefix-abbba", "{\"aa\":1,\"aba\":2,\"abba\":3,\"abbba\":4}", "abbba")

  // The empty key, beside a real key, and repeated.
  keys("empty", "{\"\":1,\"a\":2,\"\":3}")
  get("empty-key", "{\"\":1,\"a\":2}", "")
  get("empty-then-a", "{\"\":1,\"a\":2}", "a")

  // Non-ASCII, including two keys whose UTF-8 shares its first and last byte.
  keys("utf8", "{\"日本\":1,\"日ソ本\":2,\"é\":3,\"ß\":4}")
  get("utf8-jp", "{\"日本\":1,\"日ソ本\":2}", "日本")
  get("utf8-jp-long", "{\"日本\":1,\"日ソ本\":2}", "日ソ本")

  // Escaped keys never enter the table. Three distinct keys here...
  keys("escaped", "{\"a\\\"b\":1,\"a\\\\b\":2,\"ab\":3}")
  get("escaped-quote", "{\"a\\\"b\":1,\"a\\\\b\":2,\"ab\":3}", "a\"b")
  get("escaped-backslash", "{\"a\\\"b\":1,\"a\\\\b\":2,\"ab\":3}", "a\\b")
  get("escaped-plain", "{\"a\\\"b\":1,\"a\\\\b\":2,\"ab\":3}", "ab")

  // ...and one key spelled two ways: `b` is `b`, so this is a duplicate
  // key and last-key-wins applies.
  keys("uescape", "{\"a\\u0062\":1,\"ab\":2}")
  get("uescape-dup", "{\"a\\u0062\":1,\"ab\":2}", "ab")

  // One key repeated at four nesting depths: the table is parser-wide, so the
  // same slot serves every depth and each level must still answer for itself.
  deep("{\"v\":{\"v\":{\"v\":{\"v\":9}}}}")
}
