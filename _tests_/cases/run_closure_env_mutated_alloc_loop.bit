// run
// #4355: the closure cell {code, env} that `emitCallValue` loads at every call
// is the shape a future LICM hoist would lift out of this loop. Two properties
// it must not break, and both are only observable with a loop that mutates a
// capture AND allocates:
//
//   - `count` is a MUTATED capture, so lowerclosure.bit boxes it and
//     `localWrite` stores through the box IN PLACE. The cell's env WORD never
//     changes, but what it points at does, so caching the env pointer is sound
//     and caching anything read through it is not. `count` reaching 200 is
//     what says the store was seen on the next iteration.
//   - the loop allocates, so under `BIT_GC=stress` it collects while the
//     closure is live. `closureCellPtrOffsets()` (arm64call.bit) is `[8]`: the
//     env is the cell's ONE traced word, and the cell is func-typed, which
//     `isRefType` (codegen.bit) reports as a GC reference — so the collector
//     finds the env THROUGH the cell. A hoisted env kept in a caller-saved
//     register across the call, with the cell itself dead, would be an
//     untracked pointer to a sweepable object.
//
// Routed through `len(args())` so the trip count is not a compile-time
// constant; `args()` has length 1 for the argument-free run the harness does.
import { args } from "std/os"
import { newBuilder } from "std/strings"

fn trips(): i64 {
  return i64(len(args())) * 200
}

fn main() {
  let count: i64 = 0
  let bump = (d: i64) => {
    count = count + d
    return count
  }
  let n = trips()
  let total: i64 = 0
  let i: i64 = 0
  while (i < n) {
    let b = newBuilder()
    b.writeByte(u8(97 + i % 26))
    let s = b.toString()
    total = total + i64(len(s)) + bump(1)
    i = i + 1
  }
  print("count ${count} total ${total}\n")
}
