// error
// Unary `+`, `-` and `~` need a numeric operand — `~` an integer one — and
// anything else is E0053 (§12.4, #1850).
//
// `+x` was checked by nothing at all, so `a + + b` over two strings (which is
// `a + (+b)`) passed `bit check` with exit 0 and NO OUTPUT, while `bit build`
// on the same file refused with "cannot lower 1 function(s)". A `check` that
// reports success on a program `build` will not compile is a broken contract
// whatever the program does.
//
// The pinned 0.1.4 oracle accepts it too, so no differential can catch this —
// it is a concrete instance of the blind spot #1908 exists to decide, not a
// hypothetical one.
//
// The legal forms at the bottom must stay silent, including `+x` itself: it is
// in the §12 precedence table and is the identity. Fixing only the diagnostic
// would have left `+5` a spec-legal program the compiler still refused.
fn main() {
  let s = "x"
  let t = "y"
  let cat = s + +t
  let neg = -s
  let flip = ~s
  let notInt = ~1.5

  let n = 5
  let f = 1.5
  print(itoa(+n))
  print(" ")
  print(itoa(-n))
  print(" ")
  print(itoa(~n))
  print(" ")
  print(itoa(int(+f)))
  print("\n")
}

fn itoa(n: int): string {
  if (n == 0) {
    return "0"
  }
  if (n < 0) {
    return "-" + itoa(0 - n)
  }
  let d = "0123456789"
  let s = ""
  let v = n
  while (v > 0) {
    s = d[v % 10:v % 10 + 1] + s
    v = v / 10
  }
  return s
}
