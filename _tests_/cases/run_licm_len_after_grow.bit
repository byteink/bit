// run
// #7737 (licmParamAlias, compiler/optloopcand.bit): a `slice_len` the loop hoists takes an invariant
// header parameter that already holds the same load, but only when nothing between that load and the
// jump into the loop can change a header word. Here the length is read BEFORE an in-place append through
// an alias, so the carried value `n` is the old length while the call-free loop below must hoist the NEW
// one: `len(xs)` is 4 when the loop starts. Aliasing the hoist to `n` would stop the loop at 3, or index
// past the bound it checks, and print something other than 1003.
fn main() {
  let xs: []int = []
  xs = append(xs, 1)
  xs = append(xs, 2)
  xs = append(xs, 3)
  let ys = xs
  let n = len(xs)
  ys = append(ys, 4)
  let s = 0
  let i = 0
  while (i < len(xs)) {
    s = s + xs[i]
    i = i + 1
  }
  print("sum=${s} n=${n} len=${len(xs)}\n")
}
