// run
// #7737 (licmParamAlias, compiler/optloopcand.bit): a `slice_len` the loop hoists takes an invariant
// header parameter that already holds the same load. Fresh append returns a separate header, so xs
// retains its length. run_append_headers.bit also pins the saved length when another binding
// grows from the same header, so the loop must keep its original bound.
fn main() {
  let xs: []int = []
  xs = append(xs, 1)
  xs = append(xs, 2)
  xs = append(xs, 3)
  let ys = xs
  let n = len(xs)
  ys = append(ys, 4)
  let s = 0
  let i = 0
  while (i < len(xs)) {
    s = s + xs[i]
    i = i + 1
  }
  print("sum=${s} n=${n} len=${len(xs)}\n")
}
