// run
// #4571: an EXPRESSION-bodied arrow whose ok type is UNIT panicked the
// compiler with a bare `panic: assertion failed` and rc=2, no file, no line.
// `closureExprReturn` (compiler/lowerfuncval.bit) put the body expression's
// own instruction id into `Op.Ret.args`; a void value has no register class,
// so when it was defined in an earlier block than the `ret` — which is what
// `boom()?` produces, the value arriving in the branch's ok successor —
// emission resolved it to x19 against a frame that had saved nothing and
// #3101's `assertSavedCoversWrites` (compiler/arm64ctx.bit) fired.
//
// Rows 1-4 are #4571's own table: only row 1 panicked, and the other three
// are here because they compiled and ran before the fix and must keep doing
// so. Row 5 is the same defect reached WITHOUT `?` and without a fallible
// arrow at all — a void `catch` as the expression body — which is why the
// fix is at the return, not on the fallible wrap path. Rows 6-8 pin the
// shapes the new bare-`ret` branch also carries: a plain void call, the
// unit arrow's OK path, and a non-unit result that must still return a value.

fn boom(tag: string): ()! {
  fail newError("boom ${tag}")
}

fn quiet(): ()! {
  return
}

fn mayFail(n: int): int! {
  if (n < 0) {
    fail newError("neg ${n}")
  }
  return n
}

fn call(rule: () => ()!): string {
  rule() catch e {
    return e.message()
  }
  return "ok"
}

fn callInt(rule: () => int!): string {
  let v = rule() catch e {
    return e.message()
  }
  return "${v}"
}

fn main() {
  // 1: expression body, `?`, unit fallible result — the shape that panicked.
  let a: () => ()! = () => boom("a")?
  println("exprTry: ${call(a)}")
  println("inline: ${call(() => boom("inline")?)}")
  // 2: block body — worked before, must keep working.
  let b: () => ()! = () => { boom("b")? }
  println("blockTry: ${call(b)}")
  // 3: no `?`; the callee's own fallible result forwards.
  let c: () => ()! = () => boom("c")
  println("fwd: ${call(c)}")
  // 4: non-unit result — still returns its value through the register.
  let d: () => int! = () => mayFail(-1)?
  println("intErr: ${callInt(d)}")
  let dOk: () => int! = () => mayFail(7)?
  println("intOk: ${callInt(dOk)}")
  // 5: a NON-fallible `() => ()` arrow whose expression body is a void
  //    `catch`. Same panic before the fix, no `?` and no fallible arrow.
  let f: () => () = () => boom("f") catch er { println("caught: ${er.message()}") }
  f()
  // 6: a plain void call as an expression body.
  let g: () => () = () => println("voidCall")
  g()
  // 7: the unit fallible arrow's OK path — the catch must not be taken and
  //    the error slot must be clear when the caller reads it.
  let h: () => ()! = () => quiet()?
  println("okPath: ${call(h)}")
}
