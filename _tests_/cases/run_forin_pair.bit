// run
// #4333: `for (i, x) in xs` — a pair binder over `for_in`, additive to
// #2012's `for (i, x) of xs` (which binds the SAME two values under the
// other keyword). `in` always yields the POSITION; a pair binder over `in`
// yields (position, value), for a slice or array only — a map's pair binder
// stays under `of` (`for (k, v) of m`) and a pair binder over `in` for a map
// is a checker error (E0129, pinned separately by a checkercase).
//
// The value half may itself be a nested tuple pattern, destructured
// positionally via the same mechanism `let (a, b) = f()` uses — this is what
// makes `for (i, (name, n)) in xs` mean "index, plus the tuple destructured"
// rather than needing a second binder shape.
//
// A golden case is a single file, so it has no prelude.
fn main() {
  // Plain slice, flat pair binder.
  let xs = [10, 20, 30]
  for (i, x) in xs {
    print("slice ${i}:${x}\n")
  }

  // Fixed array, same binder shape.
  let arr = [3]int{ 7, 8, 9 }
  for (i, x) in arr {
    print("array ${i}:${x}\n")
  }

  // Tuple-typed element, nested destructure of the value half.
  let pairs = [("a", 1), ("b", 2), ("c", 3)]
  for (i, (name, n)) in pairs {
    print("nested ${i}:${name}=${n}\n")
  }
}
