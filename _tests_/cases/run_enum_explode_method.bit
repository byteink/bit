// run
// #4335: a METHOD returning a payload-carrying enum, both directions of
// dispatch. This case exists to be the NAMED guard for the one relaxation
// #4107 (for-of over any user type via an iterator trait) will want, because
// that relaxation silently miscompiles and nothing here says so by name.
//
// WHAT IS PINNED. `explodedRetWords` (compiler/lowerexplode.bit) gates the
// return-word convention on `explodesParams`, whose second exclusion is that
// a METHOD reaches its callers through vtable dispatch (`Op.CallIface`) as
// well as by name. So a method returning an eligible enum keeps the
// one-handle convention and boxes, while a free function with the same
// signature explodes into `{tag, payload}` and does not (#5313/#5340).
//
// WHY A FIXTURE AND NOT A COMMENT. Dropping only the method exclusion from
// the RETURN side's gate self-hosts clean and compiles this shape with
// `bit build` rc=0 and no diagnostic — the callee's `ret` grows its second
// word while the direct call site stays a single-result `call` with no
// `call_word` run after it, so the caller reads the tag register as a boxed
// handle and dereferences an integer. Measured 2026-09-17 on this branch:
// `bit build` rc=0, the program rc=2 (a Bit segfault exits 2, not 139).
// The golden suite DID catch that, but as one segfault in
// `regex_star_nullable_body.bit` — a case whose name tells the next reader
// nothing about enums, methods or return words. This fixture fails in the
// same breath and says which seam moved.
//
// WHAT #5445 AND #5446 CHANGED, and why every count here is still the same.
// The return side no longer inherits the method exclusion wholesale. #5445
// admitted a method reachable ONLY by a direct `call`, with its call site
// emitting the matching `call_word` run (`methodRetExplodes` and
// `emitStaticMethodCall`, compiler/lowerexplodemethod.bit). #5446 admitted the
// vtable, on the NAME and unanimously: `Source.step` and `Countdown.step` are
// the only declarations of `step` here and they agree, so the name returns
// words and the `call_iface` at the `iface` driver carries its own `call_word`
// run (`ifaceWordRetMethods` and `emitIfaceMethodCall`,
// compiler/lowerexplodeiface.bit). The OUTPUT is what this file pins and it is
// unchanged — a convention change that moves a printed number is a miscompile,
// which is the whole reason this fixture is named after the shape and not
// after the counts. The direct half is `run_enum_explode_method_direct.bit`.
//
// BOTH DISPATCH FORMS, because they fail for different reasons: `direct` is
// lowered by name and needs the call site to grow a `call_word` run, while
// `iface` goes through the vtable, where the call site names only the
// interface and the callee is whichever class the receiver carries.
//
// Every count is derived from `len` of a slice built at run time rather than
// written as a literal, so the folder cannot turn a driver into a constant
// and leave a probe that passes by not existing.

enum Step {
  Yield(i64),
  Done,
}

interface Source {
  step(): Step,
}

class Countdown {
  n: i64
  step(): Step {
    if (this.n > 0) {
      this.n = this.n - 1
      return Step.Yield(this.n)
    }
    return Step.Done
  }
}

// The free-function twin of `Countdown.step`, receiver passed as an ordinary
// parameter. Identical body; the only difference is method-ness, which is
// what makes the pair a control rather than two unrelated probes.
fn stepOf(c: Countdown): Step {
  if (c.n > 0) {
    c.n = c.n - 1
    return Step.Yield(c.n)
  }
  return Step.Done
}

fn drainDirect(c: Countdown, k: i64): i64 {
  let total = 0
  let i = 0
  while (i <= k) {
    match (c.step()) {
      Yield(v) => total = total + v
      Done => total = total - 1
    }
    i = i + 1
  }
  return total
}

fn drainIface(s: Source, k: i64): i64 {
  let total = 0
  let i = 0
  while (i <= k) {
    match (s.step()) {
      Yield(v) => total = total + v
      Done => total = total - 1
    }
    i = i + 1
  }
  return total
}

fn drainFree(c: Countdown, k: i64): i64 {
  let total = 0
  let i = 0
  while (i <= k) {
    match (stepOf(c)) {
      Yield(v) => total = total + v
      Done => total = total - 1
    }
    i = i + 1
  }
  return total
}

fn main() {
  // `k` is 4, derived rather than written, so every driver runs 5 rounds:
  // four `Yield` arms (3 + 2 + 1 + 0) and one `Done`, i.e. 6 - 1 = 5.
  let sizer = [1, 1, 1, 1]
  let k: i64 = len(sizer)

  print("direct ${drainDirect(Countdown{ n = k }, k)}\n")
  print("iface ${drainIface(Countdown{ n = k }, k)}\n")
  print("free ${drainFree(Countdown{ n = k }, k)}\n")
}
