// fmt
// #4367: a chain that does not fit breaks inside a nested bracketed comma
// list (FMT.md §5) rather than tearing an operator off its right operand,
// but ONLY when the operator wrap would strand a bare fragment, only when
// one list break is enough, and never for a boolean-connective chain.

// The reported case (runtime/root/mapenumeq.bit before 73acf3dc): the `<`
// wrap stranded `0) {` on a line of its own; the call's own argument list
// was the right break point all along.
fn condProbe(wa: int, wb: int, desc: int, blockPos: int, depth: int): int {
  if (descEqAgg(
    wa + descEnumPayloadBase,
    wb + descEnumPayloadBase,
    desc,
    blockPos,
    depth + 1,
  ) < 0) {
    return -1
  }
  // Exactly 100 columns including `) {`: at the budget nothing wraps at all,
  // so the preference above never runs.
  if (descEqAggregate(wa + descEnumPayloadBase, wb + descEnumPayloadBase, descrip, blockPos) != 0) {
    return -2
  }
  return 0
}

// Every operand after the first is a call, so no continuation line would be
// a fragment: the operator wrap stands.
fn allCallOperands(oc: int, k: []int): int {
  return len(kidsOf(oc.tree, k[2])) -
    len(declTypeParamIdsOf(oc, typeNodeName(oc, kidsOf(oc, k[0]))))
}

// A boolean-connective chain keeps the trailing-connective spelling (§10)
// even though `grouped` and `sameStart` are bare names.
fn boolConnChain(p: Printer, grouped: bool, j: int, prevEnd: int, sameStart: int): bool {
  return grouped &&
    j > 0 &&
    newlinesBetween(p.source, prevEnd, sameStart) == 0 &&
    !seenIt(p, prevEnd)
}

// A chain of string pieces: each piece reads on a line of its own, so a
// string literal is not a fragment and the operator wrap stands.
fn stringPieces(nearN: int): string {
  return "fn main() {\n  let x = " +
    repeatStr("(", nearN) +
    "41" +
    repeatStr(")", nearN) +
    "\n};;\n"
}

// One list break is not enough here, so the operator wrap stands rather than
// two calls exploding mid-line.
fn tooLongForOneBreak(name: string, data: []u8): string {
  return padField("${name}/", 16) +
    padField("0", 12) +
    padField("0", 6) +
    padField("0", 6) +
    padField("0", 8) +
    padField("${len(data)}", 10) +
    "`\n"
}
