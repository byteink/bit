// error
// #6536: `%=` and the bitwise/shift compound forms have no decimal lowering, so
// they are refused for the same reason `d % x` is (E0053), instead of reaching
// the lowerer as one raw op over the two-word tuple. `+= -= *= /=` are accepted.
fn main() {
  let d: decimal = 7.0
  d += 1.0
  d %= 2.0
  d &= 1
  d <<= 1
  d++
  print("${d}\n")
}
