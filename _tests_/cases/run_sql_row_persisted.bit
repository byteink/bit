// run
// #5052: the generated row mapper marks a `@table` class persisted at
// hydration — the flag `save` (pkg/orm) reads to choose UPDATE over INSERT.
// A composite literal leaves it false; `find<T>` (checksqlrowbuild.bit's
// `__sql_row_C`) must call `markPersisted(true)` after building the row, or
// a row read straight back out of the database would still look new.
import { Rows, Stmt, Tx, Value, find, FieldDesc, AttrDesc } from "std/sql"

@table class User {
  @id
  id: i64
  email: string
}

// Same fake `Conn`/`Rows` shape `run_sql_row_find.bit` uses to prove the
// rewrite fires outside `std/sql`.
class fakeRows {
  cols: []string
  data: [][]Value
  i: int = -1
  next(): bool! {
    this.i = this.i + 1
    return this.i < len(this.data)
  }

  columns(): []string {
    return this.cols
  }

  value(col: int): Value {
    return this.data[this.i][col]
  }

  close() {}
}

class fakeConn {
  rows: fakeRows
  query(sqlText: string, params: []Value): Rows! {
    return fakeRows{ cols: this.rows.cols, data: this.rows.data }
  }

  exec(sqlText: string, params: []Value): int! {
    return 0
  }

  prepare(sqlText: string): Stmt! {
    fail newError("sql: fakeConn: prepare unused")
  }

  begin(): Tx! {
    fail newError("sql: fakeConn: begin unused")
  }

  close() {}
}

fn oneUserConn(): fakeConn {
  return fakeConn{
    rows: fakeRows{
      cols: ["id", "email"],
      data: [[Value.Int(7), Value.Text("a@b.com")]],
    },
  }
}

fn main(): ()! {
  let fresh = User{ id: 0, email: "new@b.com" }
  print("composite isPersisted=${fresh.isPersisted()}\n")

  let users = find<User>(oneUserConn(), "SELECT * FROM users")?
  let hydrated = users[0]
  print("hydrated isPersisted=${hydrated.isPersisted()}\n")
}
