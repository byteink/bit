// run
// The merged enum-object layout (#4018): a payload-carrying construction is ONE
// gc_alloc'd object `{tag@0, payload words @16..}`, not a discriminant object
// plus a separate payload box. Covers a payload-free variant, a single-scalar
// payload, a multi-word payload, a payload with a traced (GC-ref) field, and a
// generic instantiation whose payload is itself a class.
class Node {
  x: i64,
}

enum Scalar {
  One(i64),
  Zero,
}

enum Wide {
  Triple(i64, i64, i64),
  Flat,
}

enum Boxed {
  Holds(Node),
  Nothing,
}

enum Opt<T> {
  Some(T),
  None,
}

fn main() {
  match (Scalar.One(7)) {
    One(v) => { print("one ${v}\n") }
    Zero => { print("zero\n") }
  }
  match (Scalar.Zero) {
    One(v) => { print("one ${v}\n") }
    Zero => { print("zero\n") }
  }
  match (Wide.Triple(1, 2, 3)) {
    Triple(a, b, c) => { print("triple ${a} ${b} ${c}\n") }
    Flat => { print("flat\n") }
  }
  match (Wide.Flat) {
    Triple(a, b, c) => { print("triple ${a} ${b} ${c}\n") }
    Flat => { print("flat\n") }
  }
  let n = Node{ x: 42 }
  match (Boxed.Holds(n)) {
    Holds(m) => { print("holds ${m.x}\n") }
    Nothing => { print("nothing\n") }
  }
  match (Boxed.Nothing) {
    Holds(m) => { print("holds ${m.x}\n") }
    Nothing => { print("nothing\n") }
  }
  match (Opt<i64>.Some(9)) {
    Some(v) => { print("opt-i64 ${v}\n") }
    None => { print("opt-i64 none\n") }
  }
  match (Opt<Node>.Some(Node{ x: 100 })) {
    Some(v) => { print("opt-node ${v.x}\n") }
    None => { print("opt-node none\n") }
  }
}
