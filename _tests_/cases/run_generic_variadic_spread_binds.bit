// run
// #4645: a `...spread` into a GENERIC variadic slot bound no type parameter.
// `checkArgType` (compiler/checkexprcall.bit) unwrapped an `Arg` node and
// nothing else, so an `ArgSpread` argument was typed by `checkExprType` on the
// spread node itself and came back 0; `bindTypeParamAtCall` then bound nothing,
// `genericTypeArgs` fell back to void, and `joinAll<()>` was emitted and refused
// with `error[E0092]` INSIDE the template body — `bit check` exiting 0 all the
// while. `joinAll<Tag>("+", ...ts)` was the only spelling that ran.
//
// The rest parameter declares the ELEMENT type, so a spread argument is typed
// at its element: `[]Tag` into `...xs: T` binds `T = Tag`, exactly as the
// individual-argument form `joinAll("+", Tag{})` already did. Every shape a
// spread can bind through is here — a bounded parameter reached through the
// interface method, a `[]T` rest parameter (one level deeper), a type parameter
// that only the spread can bind because it is also the RESULT type, and a fixed
// prefix that binds a second parameter of its own.
//
// `run_generic_variadic_empty_slot.bit` is the other half: a spread whose
// element type binds nothing must still run, and still prints the same numbers.

interface Named {
  label(): string,
}

class Tag {
  name: string
  export label(): string {
    return this.name
  }
}

fn joinAll<T: Named>(sep: string, ...xs: T): string {
  let s = ""
  for x of xs {
    s = s + x.label() + sep
  }
  return s
}

fn countAll<T>(...xs: []T): int {
  let n = 0
  for x of xs {
    n = n + len(x)
  }
  return n
}

fn firstOf<T>(...xs: T): T {
  return xs[0]
}

fn tagged<K, V>(k: K, ...vs: V): int {
  return len(k) + len(vs)
}

fn main() {
  let ts = [Tag{ name: "a" }, Tag{ name: "b" }]
  print("[${joinAll("+", ...ts)}]\n")
  print("[${joinAll("+", Tag{ name: "a" }, Tag{ name: "b" })}]\n")
  print("[${joinAll<Tag>("+", ...ts)}]\n")

  let rows = [[1, 2], [3]]
  print("${countAll(...rows)}\n")

  let words = ["x", "yz"]
  print("${firstOf(...words)}\n")

  let nums = [7, 8, 9]
  print("${firstOf(...nums)}\n")
  print("${tagged("ab", ...nums)}\n")
}
