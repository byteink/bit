// run
// #6365: a static method that mentions none of its generic class's type
// parameters is callable through the BARE class name with no type arguments
// (`Pair.tag(1, "x")`, SPEC 10.4.1). Its one body is the same for every
// instantiation, so it is emitted once on the template; before, the call named
// that template symbol and failed to link (`undefined symbol '_tag$t<template>'`).
//
// `tag` declares `(n, p)`; every named call writes `p` first, so a value that
// lands in the wrong slot prints the wrong text.
//
//  1. positional;
//  2. all-named, reordered;
//  3. a positional prefix with a named suffix;
//  4. a body holding a closure and another bare-name static call;
//  5. inside a generic function;
//  6. the written instantiation still names its own per-instantiation copy.
class Pair<A, B> {
  a: A
  b: B

  static tag(n: i64, p: string): string {
    return "${n}/${p}"
  }

  static both(n: i64): string {
    let inc = (k: i64) => k + 1
    return Pair.tag(p = "both", n = inc(n))
  }
}

fn via<T>(v: T): string {
  return Pair.tag(p = "via", n = 5)
}

fn main() {
  print("${Pair.tag(1, "x")}\n")
  print("${Pair.tag(p = "y", n = 2)}\n")
  print("${Pair.tag(3, p = "z")}\n")
  print("${Pair.both(4)}\n")
  print("${via(true)}\n")
  print("${Pair<i64, bool>.tag(p = "w", n = 6)}\n")
}
