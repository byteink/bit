// run
// #2149: `fs.readFile`/`fs.open` on a directory must fail, not fabricate a
// NUL-padded string sized by the directory's on-disk size and report success.
import { envOr } from "std/os"
import { readFile, mkdir, writeFile, remove, open } from "std/fs"

fn openDenied(path: string): bool {
  open(path) catch _ {
    return true
  }
  return false
}

fn main() {
  let dir = "${envOr("TMPDIR", "/tmp")}/bit_fs_readfile_dir_${timeUnixNs()}"
  mkdir(dir) catch _ {
    println("setup failed: cannot create ${dir}")
    return
  }
  writeFile("${dir}/entry_1.txt", "one") catch _ {
    return
  }
  writeFile("${dir}/entry_2.txt", "two") catch _ {
    return
  }
  writeFile("${dir}/entry_3.txt", "three") catch _ {
    return
  }

  let body = readFile(dir) catch "<denied>"
  println("readFile(dir) denied = ${body == "<denied>"}")
  println("open(dir) denied = ${openDenied(dir)}")

  remove("${dir}/entry_1.txt") catch _ {
    return
  }
  remove("${dir}/entry_2.txt") catch _ {
    return
  }
  remove("${dir}/entry_3.txt") catch _ {
    return
  }
  remove(dir) catch _ {
    return
  }
}
