// ir
// #7243: optselect.bit turns a value-context `||`/`&&` into `bor`/`band` AFTER
// the fold that used to resolve a constant operand's `br`, so a constant right
// operand reached codegen as `band %c, false`. optfoldbool.bit folds it: each
// function below must return a constant or the compare itself, with no
// `band`/`bor` left.

fn never(x: i64): bool {
  return x > 0 && false
}

fn always(x: i64): bool {
  return x > 0 || true
}

fn same(x: i64): bool {
  return (x > 0 && true) || false
}

fn main() {
  println("${never(1)} ${always(-1)} ${same(2)} ${same(-2)}")
}
