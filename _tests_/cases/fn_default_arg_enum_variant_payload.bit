// run
// #6271/#6112: a payload-free enum variant (`Dir.Asc`) has always been a
// legal parameter default (SPEC §10.3). A variant WITH a payload is a
// constructor CALL, not a bare variant reference (`Opt.Some(1)` is a
// `Tag.Call`, never a `Tag.Member`) — before #6112 that stayed rejected
// alongside every other non-literal default; #6112 widened the rule to any
// expression that type-checks against the parameter, and a constructor call
// is exactly that.

enum Opt { Some(i64), None }

fn f(x: Opt = Opt.Some(1)): Opt {
  return x
}

fn main() {
  let o = f()
  match (o) {
    Some(n) => { print("${n}\n") }
    None => { print("none\n") }
  }
}
