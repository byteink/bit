// error
// #6271: a payload-free enum variant (`Dir.Asc`) is a legal parameter
// default (SPEC §10.3), but a variant WITH a payload is a constructor CALL,
// not a bare variant reference, so it stays rejected exactly as any other
// non-literal default does.

enum Opt { Some(i64), None }

fn f(x: Opt = Opt.Some(1)): Opt {
  return x
}

fn main() {
  let _ = f()
}
