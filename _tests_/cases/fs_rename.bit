// run
// #2715: `fs.rename` — POSIX semantics. Renaming over an existing
// destination replaces it and SUCCEEDS (not a failure); renaming a missing
// source fails.
import { envOr } from "std/os"
import { readFile, writeFile, exists, mkdir, remove, rename } from "std/fs"

fn renameFailed(oldPath: string, newPath: string): bool {
  rename(oldPath, newPath) catch _ {
    return true
  }
  return false
}

fn main() {
  let dir = "${envOr("TMPDIR", "/tmp")}/bit_fs_rename_${timeUnixNs()}"
  let src = "${dir}/src.txt"
  let dst = "${dir}/dst.txt"

  mkdir(dir) catch _ {
    println("setup failed: cannot create ${dir}")
    return
  }
  writeFile(src, "payload") catch _ {
    println("setup failed: cannot write ${src}")
    return
  }
  rename(src, dst) catch _ {
    println("rename failed unexpectedly")
    return
  }
  println("moved content = ${readFile(dst) catch "<missing>"}")
  println("source gone = ${!exists(src)}")

  writeFile(src, "second") catch _ {
    println("setup failed: cannot write ${src}")
    return
  }
  rename(src, dst) catch _ {
    println("rename over existing failed unexpectedly")
    return
  }
  println("replaced content = ${readFile(dst) catch "<missing>"}")

  println("missing source fails = ${renameFailed("${dir}/does-not-exist.txt", dst)}")

  remove(dst) catch _ {
    return
  }
  remove(dir) catch _ {
    return
  }
}
