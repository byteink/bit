// run
// The escape hatch that makes #1923's rejection acceptable: a recursive data
// structure IS expressible, and idiomatically, through `Option<T>`.
//
// error_struct_cycle.bit pins that a bare class-to-class cycle is rejected.
// That is only defensible if there is a good way to write a linked list, and
// there is. `Option<T>` is an enum (stdlib/core/core.bit), and an enum HAS an
// empty state, so `Option.None` is the terminator that a bare `next: Node`
// can never have. E0047 does not fire on the declaration below.
//
// This case exists so the escape hatch cannot regress silently. If a change
// ever makes E0047 reject this, the hint it prints becomes a lie and Bit loses
// linked lists, trees and tries in one go.
class Node { v: int, next: Option<Node> }

fn main() {
  let third = Node{ v: 3, next: Option.None }
  let second = Node{ v: 2, next: Option.Some(third) }
  let head = Node{ v: 1, next: Option.Some(second) }

  let cur = head
  let n = 0
  while (n < 8) {
    print(itoa(cur.v))
    print(" ")
    let nxt = cur.next
    if (isNone(nxt)) {
      n = 8
    } else {
      cur = unwrap(nxt)
      n = n + 1
    }
  }
  print("\n")

  // A slice and a map break a cycle the same way, for the same reason: each has
  // an empty state. Both are still accepted.
  let t = Tree{ v: 1, kids: []Tree(0) }
  print("kids=")
  print(itoa(len(t.kids)))
  print(" tries=")
  print(itoa(len(Trie{ next: map<int, Trie>() }.next)))
  print("\n")
}

class Tree { v: int, kids: []Tree }
class Trie { next: map<int, Trie> }

fn itoa(n: int): string {
  if (n == 0) {
    return "0"
  }
  let d = "0123456789"
  let s = ""
  let v = n
  while (v > 0) {
    s = d[v % 10:v % 10 + 1] + s
    v = v / 10
  }
  return s
}
