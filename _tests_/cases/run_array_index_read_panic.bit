// panic
// #4270: `a[i]` on a fixed-size array `[N]T` performed NO runtime bounds
// check in either backend — `lowerIndex`'s Array arm (loweraccess.bit)
// emitted a bare `index_get`, raw `base + i*width` addressing, with nothing
// stopping an out-of-range `i`. `a[4]` on this 4-element array used to read
// zero (just past the block) and `a[9]` read live memory further out, both
// with exit 0 and no diagnostic. The message and exit code match the SLICE
// out-of-range case (run_slice_range_panic.bit) exactly: to a caller, an
// array and a slice must be indistinguishable failure modes (SPEC §12.6,
// §18.4).
fn main() {
  let a: [4]int = [4]int{ 1, 2, 3, 4 }
  let i = 4
  print("start\n")
  print("${a[i]}\n")
}
