// run
// #7387: a value of type parameter `S: Named` is assignable to its own bound
// interface (Go, C#, Kotlin and TypeScript all allow it). `S` is only ever
// instantiated with a class or boxed enum satisfying `Named`, whose interface
// form is the object pointer itself, so the conversion is the same one an
// ordinary class value gets. Covered: a class field, a binding, a return, a
// call argument and a slice element, from a generic function and a generic
// class method.
interface Named { name(): string }

class Cat {
  id: string,
  name(): string { return this.id }
}

class Dog {
  id: string,
  name(): string { return "dog " + this.id }
}

class Slot {
  held: Named,
}

class Keeper<S: Named> {
  last: S,
  share(): Named { return this.last }
}

fn put<S: Named>(s: S): Slot {
  return Slot{ held = s }
}

fn bind<S: Named>(s: S): string {
  let n: Named = s
  return n.name()
}

fn both<S: Named>(a: S, b: S): []Named {
  return [a, b]
}

fn show(n: Named): string { return n.name() }

fn viaArg<S: Named>(s: S): string { return show(s) }

fn main() {
  println(put(Cat{ id = "tom" }).held.name())
  println(put(Dog{ id = "rex" }).held.name())
  println(bind(Cat{ id = "a" }))
  println(viaArg(Dog{ id = "b" }))
  let xs = both(Cat{ id = "c" }, Cat{ id = "d" })
  println("${len(xs)} ${xs[1].name()}")
  let k = Keeper<Dog>{ last = Dog{ id = "e" } }
  println(k.share().name())
}
