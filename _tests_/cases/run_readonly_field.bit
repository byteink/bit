// run
// #4066: `readonly` class fields (SPEC §10.5) — assignable in a composite
// literal and inside the declaring class's own 'init'; nowhere else. The two
// REJECTED directions (own module, foreign module) are
// check_readonly_field_assign_own_module.bit and
// check_readonly_field_assign_foreign.bit (_tests_/bit/checkercases/); this
// positive case is everything `readonly` still allows.
class Timestamp {
  export readonly ns: int,
}

class Counter {
  export readonly n: int

  init(start: int) {
    this.n = start // allowed: readonly is assignable inside its own 'init'
  }
}

class Box {
  export x: int,
}

class Wrapper {
  export readonly inner: Box, // readonly is SHALLOW (SPEC §10.5)
}

fn main() {
  let t = Timestamp{ ns: 5 }
  print("${t.ns}\n")

  let c = Counter(9)
  print("${c.n}\n")

  let w = Wrapper{ inner: Box{ x: 1 } }
  w.inner.x = 99 // mutates the referenced Box, not the 'inner' field itself
  print("${w.inner.x}\n")
}
