// run
// #5427: a single-payload-TYPE enum (every payload-carrying variant shares
// `decimal`) exploded its return/match-subject payload word as the bare
// `decimal` type (16 bytes) rather than the `decimalTupleType` box
// `enumPayloadSlotIsPtr` (lowerdecimal.bit) already stores there — the ISA
// has no 16-byte GP load, so `gpSizeOpc` (arm64encode.bit) panicked reading
// it back. `explodedEnumWordTypes` (lowerlayout.bit) now retypes the word to
// match what it physically is. Covers both variants: the payload-carrying
// one, and the payload-less one (whose word never held anything real but
// must still round-trip through the same exploded [tag, payload] shape).
enum Maybe { Just(decimal), Nothing }

fn f(x: bool): Maybe {
  if (x) {
    let d: decimal = 3.5
    return Maybe.Just(d)
  }
  return Maybe.Nothing
}

fn main() {
  match (f(true)) {
    Just(v) => println("${v}")
    Nothing => println("no")
  }
  match (f(false)) {
    Just(v) => println("${v}")
    Nothing => println("no")
  }
}
