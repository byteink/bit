// run
// #4569. A method with NO type params of its own, on a GENERIC receiver class,
// calling a generic free function with an argument typed at the receiver's type
// parameter. `bit check` exited 0 and lowering refused the program with
// `E0092: cannot lower a call whose target could not be resolved`, pointing at
// the callee inside the method body.
//
// Nothing recorded the concrete entry: Pass A1's step 1 skips such a method
// (the parser merges the receiver's `<A>` into the method's own generic params,
// so `isGenericFuncDecl` is true) and its step 2 iterates the FUNCTION ledger,
// which a method on a generic receiver is not in — `lowerMethodInstances` emits
// one body per nominal receiver instantiation instead. Step 1b now walks those
// bodies under the same bindings that emit them.
//
// The two classes deliberately name their type parameters differently: two
// generic classes in one module that share a type-parameter NAME miscompile for
// a reason that has nothing to do with this ticket (#4589).

interface Named {
  label(): string,
}

class Dog {
  n: string

  export label(): string {
    return this.n
  }
}

fn idOf<T>(v: T): T {
  return v
}

// A second level, to pin that step 1b feeds step 2's worklist: `relay<i64>` is
// recorded off the method body, and `idOf<i64>` exists only because the ledger
// closure then walked `relay<i64>`.
fn relay<T>(v: T): T {
  return idOf(v)
}

fn nameOf<T: Named>(v: T): string {
  return v.label()
}

class Pair<A> {
  a: A
  export first(): A {
    return idOf(this.a)
  }
  export firstRelayed(): A {
    return relay(this.a)
  }
}

// The bounded shape: the callee reaches a member of the type argument, and the
// method's own result does not mention the receiver's parameter at all.
class Holder<N: Named> {
  it: N
  export label(): string {
    return nameOf(this.it)
  }
}

fn main() {
  // Two DIFFERENT instantiations of the same class: one body is emitted per
  // nominal instantiation, so each needs its own ledger entry.
  print("${Pair<int>{ a: 7 }.first()}\n")
  print(Pair<string>{ a: "two" }.first() + "\n")
  print("${Pair<int>{ a: 9 }.firstRelayed()}\n")
  print(Holder<Dog>{ it: Dog{ n: "rex" } }.label() + "\n")
  // The direct concrete call as the control: this always worked.
  print(nameOf(Dog{ n: "direct" }) + "\n")
}
