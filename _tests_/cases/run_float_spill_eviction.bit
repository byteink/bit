// run
// Regression: three or more branchy float-returning calls inlined in one
// string interpolation. On SysV x86-64 a function with calls has zero
// allocatable float registers, so every float value spills; the string
// results (pointers) also spill once the register file fills. This mix used
// to make the linear-scan allocator hand one stack slot to two simultaneously
// live values — a spilled string pointer and, via the eviction path, a float
// — corrupting the pointer and crashing in string_concat. Guards the
// eviction-path spill-slot fix in `compiler/regalloc.bit` (fresh slot, never
// recycled).
fn myabs(x: f64): f64 {
  if (x < 0.0) {
    return -x
  }
  return x
}
fn mymin(a: f64, b: f64): f64 {
  if (a < b) {
    return a
  }
  return b
}
fn mymax(a: f64, b: f64): f64 {
  if (a > b) {
    return a
  }
  return b
}
fn main() {
  print("a=${myabs(-3.5)} b=${mymin(2.0, 5.0)} c=${mymax(2.0, 5.0)}\n")
}
