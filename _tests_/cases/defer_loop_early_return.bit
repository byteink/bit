// run
// A `defer` registered before a loop, replayed at a `return` INSIDE the loop
// (#2078): the deferred call's argument is lowered once at the `defer` site,
// so replaying it at an exit the loop's own back edge closes over used to
// read a value the register allocator does not extend across a loop, and
// `bit build` refused with "IR verification failed" even though `bit check`
// passed. The loop kind and argument type do not matter (#2078's own table
// was wrong on both counts) — a loop and an early exit from it are enough.
class P { n: int }

fn pop(p: P) { p.n = p.n - 1 }

fn f(p: P): int {
  defer pop(p)
  while (true) {
    if (p.n > 2) {
      return p.n
    }
    p.n = p.n + 1
  }
  return 0
}

fn main() {
  let p = P{ n: 5 }
  print("${f(p)}\n")
}
