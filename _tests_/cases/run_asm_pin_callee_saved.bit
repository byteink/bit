// run
// SPEC 11.6 / #6197: an `asm` block's `input`/`result` pin WRITES the physical
// register it names, even though `xCollectReserved` (compiler/x64dispatch.bit)
// correctly keeps the allocator from ever addressing it. On x86_64 the backend
// dropped the save for a PINNED register that also happened to be callee-saved
// under SysV (r13 here): `xBuildSavedGpr` (compiler/x64call.bit) only walked
// the narrowed allocatable file, so a pinned callee-saved register was neither
// allocatable nor saved. `pin`'s caller (`run`) still has a live value of its
// own in r13 by the time it calls `pin`, and the miscompile clobbers it: this
// printed 1734 instead of 1234 on x86_64-linux before the fix. arm64 never hit
// this — x6 is caller-saved there, so nothing needed saving.
//
// The `while` loop keeps `pin` too big to inline into `run`, which is what
// makes the corruption visible in the caller's own frame across the call,
// exactly like `cloneChild` (runtime/thread/linux/spawn.bit) pinning r13
// across the call into `threadStart` (the production case this reduces).
fn pin(v: int): int {
  let t = v
  let k = 0
  while (k < v % 3) {
    t = t + 1
    k = k + 1
  }
  return asm {
    arm64 { 0xAA0603E0 }
    x64 { 0x4C, 0x89, 0xE8 } // mov rax, r13
    result arm64 x0 x64 rax : int
    input arm64 x6 x64 r13 = t - k
  }
}

fn run(a: int, b: int, c: int, d: int): int {
  let r = pin(7)
  return a * 1000 + b * 100 + c * 10 + d + r * 0
}

fn main() {
  print("${run(1, 2, 3, 4)}\n")
}
