// run
// SPEC §10.5, #3879: the synthesized `validateFields()` and a hand-written
// `validate()` COEXIST and both run. That is why the synthesized member is not
// called `validate` -- a per-field attribute cannot express a cross-field rule
// ("confirm must equal password"), so the two are complementary and a caller
// runs one then the other.
//
// The fixture proves both halves fire and that neither hides the other: case 1
// fails only the field rule, case 2 only the cross-field rule, case 3 fails
// both and must report the FIELD one, because `validateFields()` runs first
// and `check`'s `?` propagates before `validate()` is reached.
//
// A field failure carries its field's name (#4572), so case 1 and case 3 read
// "name: name too short" -- the prefix is the synthesis naming the field, the
// rest is the rule's own message.

class validationError {
  text: string

  message(): string {
    return this.text
  }
}

fn min(s: string, n: int): ()! {
  if (len(s) < n) {
    fail validationError{ text: "name too short" }
  }
}

class Signup {
  @min(3)
  name: string

  password: string
  confirm: string

  validate(): ()! {
    if (this.password != this.confirm) {
      fail validationError{ text: "passwords differ" }
    }
  }
}

fn check(s: Signup): ()! {
  s.validateFields()?
  s.validate()?
}

fn report(s: Signup) {
  check(s) catch e {
    print("${e.message()}\n")
    return
  }
  print("ok\n")
}

fn main() {
  report(Signup{ name: "ab", password: "p", confirm: "p" })
  report(Signup{ name: "ada", password: "p", confirm: "q" })
  report(Signup{ name: "ab", password: "p", confirm: "q" })
  report(Signup{ name: "ada", password: "p", confirm: "p" })
}
