// run
// #7740: an interface-method call keeps its target in a register while the arguments
// are marshaled, and an argument spilled past byte 32760 of the frame (the
// scaled imm12 reach of an 8-byte ldr) loads through `mov x11, #disp` +
// a register-offset ldr, so a target held in x11 became the displacement and
// the blr jumped to it (arm64; the target now sits in x16, which no marshaled
// argument writes). 4200 values live across the call put its argument, and
// the interface receiver's reload, in slots past that reach. Generated by a
// 12-wide tuple group per line to stay under the file-length ceiling; every
// value is derived from `b`, which `zero()` hides from the optimizer, so none
// is a constant the allocator could rematerialize instead of spill.
import { args } from "std/os"
interface Adder {
  add(x: i64): i64,
}

class Plus {
  k: i64

  add(x: i64): i64 {
    return x + this.k
  }
}

fn pick(b: i64): Adder {
  return Plus{ k = b + 3 }
}
fn zero(): i64 {
  return i64(len(args())) - 1
}
fn group(b: i64, k: i64): (i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64) {
  return (
    b + k + 0,
    b + k + 1,
    b + k + 2,
    b + k + 3,
    b + k + 4,
    b + k + 5,
    b + k + 6,
    b + k + 7,
    b + k + 8,
    b + k + 9,
    b + k + 10,
    b + k + 11,
  )
}
