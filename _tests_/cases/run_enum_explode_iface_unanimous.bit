// run
// #5446: the UNANIMITY rule for a vtable-dispatched method's return
// convention, as a program that runs. Sibling of
// `run_enum_explode_method.bit` (the positive case, where every declaration
// agrees) and `run_enum_explode_method_direct.bit` (the direct half).
//
// WHAT IS PINNED. `Op.CallIface` names only the INTERFACE; `methodId`
// (compiler/lower.bit) turns the method name into a dispatch id and
// `bit_rt_iface_lookup` resolves it against whichever receiver arrives, so the
// call site cannot name its callee. `ifaceWordRetMethods`
// (compiler/lowerexplodeiface.bit) therefore decides the convention on the
// NAME, project-wide, and only when EVERY declaration of that name agrees on
// one word list — every interface signature and every concrete method.
//
// `Boxed<T>.step` is the disagreement. A generic class's method is
// monomorphized under another symbol and `methodDeclRetEligible`
// (compiler/lowerexplodemethod.bit) refuses it exactly as `explodesParams`
// refuses a generic free function, so the name `step` is poisoned and BOTH
// implementations — the generic one AND `Plain.step`, whose own result type is
// perfectly eligible — keep the one-handle convention, as does the `call_iface`
// in `drain`. `bit --dump-ir` on this shape shows `call_iface %N.1() Step` with
// NO `call_word` after it, where `run_enum_explode_method.bit` shows
// `call_iface %N.1() i64` + `call_word`.
//
// WHY A FIXTURE AND NOT A COMMENT. Deciding eligibility per implementing class,
// or from the interface's declared result type alone, compiles this program
// with rc=0 and no diagnostic: `Plain.step` and the `call_iface` would return
// two words while `Boxed<i64>.step` — the same dispatch id, reached through the
// same interface value — still returns one handle, so `drain` reads the payload
// register the generic callee never wrote. That is a wrong answer at exit 0 on
// the arm the generic receiver takes, and the only thing that says which seam
// moved is a case that drives both receivers through one interface.
//
// Every count is derived from `len` of a slice built at run time rather than
// written as a literal, so the folder cannot turn a driver into a constant and
// leave a probe that passes by not existing.

enum Step {
  Yield(i64),
  Done,
}

interface Source {
  step(): Step,
}

class Boxed<T> {
  item: T
  n: i64
  step(): Step {
    if (this.n > 0) {
      this.n = this.n - 1
      return Step.Yield(this.n)
    }
    return Step.Done
  }
}

class Plain {
  n: i64
  step(): Step {
    if (this.n > 0) {
      this.n = this.n - 1
      return Step.Yield(this.n)
    }
    return Step.Done
  }
}

fn drain(s: Source, k: i64): i64 {
  let total = 0
  let i = 0
  while (i <= k) {
    match (s.step()) {
      Yield(v) => total = total + v
      Done => total = total - 1
    }
    i = i + 1
  }
  return total
}

fn main() {
  // `k` is 4, derived rather than written, so each driver runs 5 rounds: four
  // `Yield` arms (3 + 2 + 1 + 0) and one `Done`, i.e. 6 - 1 = 5.
  let sizer = [1, 1, 1, 1]
  let k: i64 = len(sizer)

  print("generic ${drain(Boxed<i64>{ item = 7, n = k }, k)}\n")
  print("plain ${drain(Plain{ n = k }, k)}\n")
}
