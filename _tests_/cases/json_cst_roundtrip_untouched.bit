// run
// stdlib/json/cst_print.bit's cstPrint (#1726), the byte-identical-for-an-
// untouched-document half of #1479's gate. A golden case is a single file
// with no prelude but CAN import std/json: `_tests_/bit/golden.bit`'s
// `checkRun` runs `bit build <case>` with `BIT_STDLIB` exported (#2457,
// following #2456's json_cst_roundtrip_one_edit.bit). This test only calls
// cstParse and cstPrint, so it imports both instead of redeclaring the
// lexer, the #1720 CST types, the #1723 CST parser, and the printer.
//
// Parses a hand-formatted JSONC fixture mixing `//` and `/* */` comments,
// nesting, and an array, with NO edit at all, and asserts
// cstPrint(cstParse(source)) == source byte-for-byte.
import { cstParse, cstPrint } from "std/json"

// --- test -------------------------------------------------------------

fn main() {
  let source = "{\n  // header comment\n  \"name\": \"widget\",\n  /* count of widgets */\n  \"count\": 3,\n  \"tags\": [\"a\", \"b\"],\n  \"nested\": {\n    \"flag\": true // trailing note\n  }\n}"

  let root = cstParse(source) catch e {
    print("parse-error: ${e.message()}\n")
    return
  }

  let printed = cstPrint(root)
  if (printed == source) {
    print("roundtrip=match\n")
  } else {
    print("roundtrip=mismatch\n")
    print("---got---\n${printed}\n---want---\n${source}\n")
  }
}
