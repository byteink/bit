// error
// #1231: a top-level `const` array lives in read-only `.rodata` (§11.11), so a
// write THROUGH it — `K[i] = v` — would fault the loaded image. The checker
// rejects it by walking the index chain to its `const` root (E0062), the same
// place it already rejects assigning to a bare `const` ident. Without this the
// program would compile and SIGSEGV on the store. Single-file golden: no prelude.
const K: [3]u8 = [3]u8{ 1, 2, 3 }

fn main() {
  K[0] = 9
  print("x\n")
}
