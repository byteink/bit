// panic
// #4355: the companion to `run_nil_call_zero_trip.bit`. The same loop with a
// trip count of one DOES call `f`, so the nil check must still fire and the
// message must be the same one `run_nil_call_panic.bit` pins for the
// straight-line call. A loop-carried nil callee is the shape any future hoist
// of the check or of the closure cell's {code, env} loads has to keep working.
import { args } from "std/os"

fn one(): i64 {
  return i64(len(args()))
}

fn main() {
  let f: (i64) => i64
  let n = one()
  let sink: i64 = 0
  let i: i64 = 0
  print("start\n")
  while (i < n) {
    sink = sink + f(i)
    i = i + 1
  }
  print("unreachable ${sink}\n")
}
