// run
// SPEC §14.3, #7327, epic #6984: `__sameValue`, `__valueHash` and `__snapshot`,
// the deep value semantics synthesized for a class whose fields are strings,
// numbers, bools, floats, payload-free enums, slices of those (to any depth) and
// nested classes. A slice compares elementwise, equal values hash equal, and a
// snapshot is unaffected by mutating the original.
enum Level { Junior, Senior }

class Org {
  id: string,
  tags: []string,
}

class Subject {
  id: string,
  age: int,
  score: f64,
  active: bool,
  level: Level,
  roles: []string,
  grid: [][]int,
  orgs: []Org,
  org: Org,
}

fn make(): Subject {
  return Subject{
    id = "u1", age = 41, score = 2.5, active = true, level = Level.Senior,
    roles = ["admin", "dev"], grid = [[1, 2], [3]],
    orgs = [Org{ id = "o1", tags = ["x"] }], org = Org{ id = "o2", tags = ["a", "b"] },
  }
}

fn main() {
  let a = make()
  let b = make()
  println("same: ${a.__sameValue(b)}")
  println("hash equal: ${a.__valueHash() == b.__valueHash()}")
  println("hash stable: ${a.__valueHash() == a.__valueHash()}")

  b.roles[1] = "ops"
  println("after role change: ${a.__sameValue(b)}")
  println("hash differs: ${a.__valueHash() != b.__valueHash()}")
  b.roles[1] = "dev"
  b.grid[0][1] = 9
  println("after deep slice change: ${a.__sameValue(b)}")
  b.grid[0][1] = 2
  b.orgs[0].tags[0] = "y"
  println("after nested class slice change: ${a.__sameValue(b)}")
  b.orgs[0].tags[0] = "x"
  b.org.tags = ["a"]
  println("after shorter slice: ${a.__sameValue(b)}")
  b.org.tags = ["ab"]
  println("a,b vs ab: ${a.__sameValue(b)}")
  println("a,b vs ab hash: ${a.__valueHash() != b.__valueHash()}")
  println("back to equal: ${make().__sameValue(make())}")

  let snap = a.__snapshot()
  println("snapshot same: ${snap.__sameValue(a)}")
  a.roles[0] = "root"
  a.grid[1][0] = 7
  a.org.tags[0] = "z"
  a.orgs[0].id = "o9"
  a.age = 42
  println("snapshot unaffected: ${snap.__sameValue(make())}")
  println("original changed: ${!snap.__sameValue(a)}")
  println("snapshot roles: ${snap.roles[0]} ${snap.grid[1][0]} ${snap.org.tags[0]} ${snap.orgs[0].id}")
}
