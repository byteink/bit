// run
// #4566: `[]T(n)` for a tuple of scalars builds ONE zero record and stores it
// into every slot, instead of `n` identical ones. SPEC §12.5:2187 makes tuple
// elements read-only — `t.0` may be read but never assigned — and §14.6 makes
// `==` element-wise, so nothing in the language can tell the shared record
// from `n` separate ones. `[](i64, i64)(100000)` allocated 100000 identical
// 16-byte records before this; it now allocates one.
//
// `run_tuple_zero_field.bit` (#4500) covers the fill itself, at all four sites
// that must materialize a tuple's §13.4 zero value. THIS file covers only what
// the sharing can break, which is aliasing: a member that is read-only as a
// BINDING but names a MUTABLE object — a class — must keep the
// per-element allocation, or a write through element 0 is visible through
// element 1. Both are exercised as writes, not as an inspection of the IR.
//
// The all-scalar cases below are the ones that DO share; the mixed ones are
// the control, and they are the reason the predicate is `zeroIsShareable`
// beside `zeroIsLiveRecord` rather than a widening of it.

class P {
  a: i64,
  b: string,
}

enum E {
  A,
  B(i64),
}

// Shared: every member is a scalar, so every slot may name one record.
fn scalarForms() {
  let xs = [](i64, i64)(4)
  print("scalar ${len(xs)} ${xs[0].0} ${xs[0].1} ${xs[3].0} ${xs[3].1}\n")

  // Assigning a WHOLE element replaces the slot's reference; it must not
  // reach the other slots, which still name the shared record.
  xs[1] = (5, 6)
  print("scalar-set ${xs[0].0} ${xs[1].0} ${xs[1].1} ${xs[2].0} ${xs[3].1}\n")

  // Transitively all-scalar: a nested tuple and a bool member still share.
  let ns = [](i64, (i64, bool))(3)
  print("nested ${ns[0].0} ${ns[0].1.0} ${ns[0].1.1} ${ns[2].1.0} ${ns[2].1.1}\n")

  // A string member is NOT shared (it is excluded from the predicate), and
  // still reads as the empty string.
  let ss = [](i64, string)(2)
  print("string ${ss[0].0} [${ss[0].1}] [${ss[1].1}]\n")
}

// Not shared: `ds[i].1` is read-only as a binding, but the `P` it names has
// mutable fields. One record for both slots would make this write visible
// through `ds[1]`.
fn classAliasing() {
  let ds = []((i64, i64), P, E)(2)
  ds[0].1.a = 5
  ds[0].1.b = "written"
  print("class-alias ${ds[0].1.a} [${ds[0].1.b}] ${ds[1].1.a} [${ds[1].1.b}]\n")
  print("class-rest ${ds[1].0.0} ${ds[1].0.1}\n")
}

// A map member is excluded from the predicate too, but it CANNOT be exercised
// as an aliasing write the way the class above is: a map's §13.4 zero value is
// the nil map (zero bits — `zeroIsLiveRecord` does not name Map), and
// `ms[0].1[7] = 3` panics "nil map write" before any sharing could be
// observed. So this pins the read only: the zero map is empty in every slot,
// and the exclusion is the conservative direction for the day that changes.
fn mapForms() {
  let ms = [](i64, map<i64, i64>)(2)
  print("map ${len(ms[0].1)} ${len(ms[1].1)} ${ms[1].0}\n")
}

// A collection between the fill and the read. The shared record is reachable
// from `n` slots at once, which is a shape the per-element fill never produced
// — the mark phase must keep it alive and the sweep must not free it twice.
fn sharedAcrossGc() {
  let n = 1000
  let ys = [](i64, i64)(n)
  let junk = []i64(0)
  let k = 0
  while (k < 4000) {
    junk = append(junk, k)
    k = k + 1
  }
  print("gc ${len(ys)} ${ys[0].0} ${ys[999].1} ${len(junk)}\n")
}

fn main() {
  scalarForms()
  classAliasing()
  mapForms()
  sharedAcrossGc()
}
