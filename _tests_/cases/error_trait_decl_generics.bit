// error
// SPEC §10.7, #5188: fixing "a generic METHOD does not parse" must not widen
// into accepting generics on the TRAIT DECLARATION itself -- parseTraitDecl
// (parsertrait.bit) still calls only `expectIdent`, never `maybeGenericParams`,
// for the trait's own name; `trait_decl = "trait" IDENT "{" ...` (unchanged)
// carries no `[ generic_params ]` the way `class_decl`/`interface_decl` do.
// This is #4412's precedent: a widened predicate must reach exactly the ONE
// consumer it was meant for (a trait method's own `<...>`) and not the other
// (the trait's).
trait T<U> {
  identity(): U
}

fn main() {
  print("no\n")
}
