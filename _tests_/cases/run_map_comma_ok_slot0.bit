// run
// #4031: the comma-ok predicate (`let (v, ok) = m[k]`) lowers to one probe
// (`map_slot`) plus `ok = slot >= 0` (#4019/#4020, compiler/loweraccess.bit
// `emitMapCommaOk`). An off-by-one there (`>=` mutated to `>`) reports a key
// living in slot 0 as absent -- every other slot is unaffected, and every
// absent key is unaffected too, because a miss always encodes as a strictly
// negative slot (`mapProbe`, runtime/root/maps.bit). So the only way to catch
// this class of bug is to land a live entry in slot 0 ON PURPOSE.
//
// Before this fixture, exactly one golden case (`run_map_struct_key.bit`)
// caught it, purely because one of its composite keys happened to hash into
// slot 0 -- a coincidence of the descriptor hash, not a deliberate check.
// Change that key, the hash seed, or the slot count and the coverage
// vanishes with no test going red.
//
// Every key below is picked by computing `scalarHash` (runtime/root/maps.bit,
// splitmix64's finalizer) against the fresh-map capacity of 8 (mask 7):
// scalarHash(3) & 7 == 0, scalarHash(9) & 7 == scalarHash(19) & 7 == 7,
// scalarHash(24) & 7 == 0. Three different code paths all park a live key in
// physical slot 0:
fn main() {
  // 1. Direct home-slot hit: a fresh map, one insert, zero probe steps --
  // slot 0 is the key's own home bucket.
  let m1 = map<int, int>()
  m1[3] = 100
  let (v1, ok1) = m1[3]
  print("direct ${v1} ${ok1}\n")

  // 2. Probe-wrap hit: 9 and 19 both home to slot 7. 9 lands there directly;
  // 19 collides at 7 and walks forward, wrapping (7+1)&7 = 0, landing in
  // slot 0 despite a home bucket of 7. `wrap_home` is the control -- slot 7
  // is untouched by the mutation and must stay true either way.
  let m2 = map<int, int>()
  m2[9] = 200
  m2[19] = 201
  let (v2a, ok2a) = m2[9]
  print("wrap_home ${v2a} ${ok2a}\n")
  let (v2b, ok2b) = m2[19]
  print("wrap_hit ${v2b} ${ok2b}\n")

  // 3. Tombstone-reuse hit: 3 and 24 both home to slot 0. Insert 3 (slot 0),
  // delete it (slot 0 becomes a tombstone), then insert 24 -- its home probe
  // finds the tombstone first and reuses it, so the live entry occupies
  // slot 0 again, this time via the reuse path rather than a fresh insert.
  // `tomb_gone` is the control -- a genuine miss never encodes as slot 0 and
  // must stay false either way.
  let m3 = map<int, int>()
  m3[3] = 300
  delete(m3, 3)
  m3[24] = 301
  let (v3, ok3) = m3[24]
  print("tomb_reuse ${v3} ${ok3}\n")
  let (v3b, ok3b) = m3[3]
  print("tomb_gone ${v3b} ${ok3b}\n")
}
