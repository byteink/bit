// run
// #5873: a tuple the ABI returns boxed, from an inlined callee with two
// `return` sites, reaches the caller's join as one block parameter per edge.
// optalloc.bit's `splitJoinBoxes` splits that parameter into its fields and
// passes each edge the values its own box stored, so the boxes die. `(bool,
// bool, int)` and `(i32, i32, string)` stay boxed on every target (their
// members are packed off the 8-byte word grid). The string member is the
// only reference to a freshly built string across the join. That pins the
// values, not the split parameter's traced type: the stack scan is
// conservative (runtime/ABI.md), so a split field stripped of its reference
// type still passes under BIT_GC=stress (checked by mutation on #5873).

fn sel(a: int): (bool, bool, int) {
  if (a > 3) {
    return true, false, a
  }
  return false, true, 0
}

class Label {
  text: string,
}

fn tag(a: bool, l: Label): (i32, i32, Label) {
  if (a) {
    return 1, 2, l
  }
  return 3, 4, l
}

fn main() {
  let sum = 0
  let hits = 0
  let i = 0
  while (i < 1000) {
    let (ok, no, v) = sel(i)
    if (ok && !no) {
      sum = sum + v
      hits = hits + 1
    }
    i = i + 1
  }
  print("sum ${sum} hits ${hits}\n")
  let j = 0
  while (j < 6) {
    let (x, y, l) = tag(j % 2 == 0, Label{ text = "label ${j * 7}" })
    print("${x} ${y} ${l.text}\n")
    j = j + 1
  }
}
