// run
// #5921: `ptrOf(s: string): *u8` — the address of `s`'s first byte
// (runtime/ABI.md §2.3's `ptr` word, offset +0), unblocking #5901's 8-byte
// word scan in std/strings. Unlike the slice form, there is no separate
// offset word to scale by an element stride: `ptr` is already an absolute
// address for a literal, a heap string, and an `s[lo:]` view alike.
//
// Every byte is read two ways — `s[i]` (the traced, bounds-checked read) and
// `*(ptrOf(s) + i)` (the raw one) — and compared. A wrong lowering (the
// slice path's offset arithmetic, or reading a header word other than +0)
// reads garbage on every case here, not just one, so a single mismatch is
// enough to fail. `keepAlive(s)` after the last raw read matches §11.5's
// liveness rule for a pointer derived from traced memory.
fn checkBytes(s: string, label: string) {
  let i = 0
  while (i < len(s)) {
    let want = s[i]
    let p = ptrOf(s) + i
    let got = *p
    if (got != want) {
      panic("${label}[${i}]: ptrOf mismatch, want ${want} got ${got}")
    }
    i = i + 1
  }
  keepAlive(s)
}

fn main() {
  let literal = "ptrOf on a string, sixteen"
  checkBytes(literal, "literal")

  // `string([]u8)` always allocates a fresh, self-owning heap string
  // (`strInitOwned`, runtime/ABI.md §2.3) — never a literal, unlike a
  // compile-time-foldable concatenation would be.
  let raw: []u8 = [112, 116, 114, 79, 102, 32, 104, 101, 97, 112, 33]
  let heap = string(raw)
  checkBytes(heap, "heap")

  let k = 0
  while (k < 8) {
    checkBytes(heap[k:], "view${k}")
    k = k + 1
  }

  print("ok\n")
}
