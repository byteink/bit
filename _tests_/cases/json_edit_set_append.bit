// run
// stdlib/json/edit.bit's cstSetString (#1725), APPENDING a key that doesn't
// exist yet. A golden case is single-file with no prelude but CAN import
// std/json (see json_cst_roundtrip_one_edit.bit, #3063): _tests_/bit/golden.bit's
// checkRun runs `bit build <case>` with BIT_STDLIB exported, so the import
// below resolves exactly as it would for any other caller — this file no
// longer redeclares the lexer, the CST types, the CST parser, or the edit
// function under test.
//
// This used to assert survival via per-field CstEntry.trivia.leading[0]
// pokes against the pre-#1726 Trivia shape, which the current CstEntry
// doesn't have (see #3062). Appending a key INSERTS a line, so the
// positional line-diff json_edit_set_existing.bit uses (#3063) doesn't
// transfer here: every line after the insertion point shifts, and comparing
// by index would falsely flag them as changed (#3062's decision). Instead
// this asserts full byte-equality of cstPrint(root2) against a derived
// expected document — json_cst_roundtrip_untouched.bit's shape — which
// validates every byte (the new entry's keyText/value/indentation AND every
// untouched byte around it, including "name"'s own leading comment) in one
// assertion. Strictly stronger than the original: the old test never
// checked the comment's surrounding whitespace, and byte equality can't be
// fooled by how the model groups the trivia internally.
import { cstParse, cstSetString, cstPrint } from "std/json"

// --- test -------------------------------------------------------------

fn main() {
  // No "version" key yet; cstSetString must append it rather than error,
  // and must not disturb "name"'s own leading comment or "count".
  let source = "{\n  // comment before name\n  \"name\": \"old\",\n  \"count\": 1\n}"

  let root = cstParse(source) catch e {
    print("parse-error: ${e.message()}\n")
    return
  }

  let root2 = cstSetString(root, []string{ "version" }, "1.0.0") catch e {
    print("set-error: ${e.message()}\n")
    return
  }

  // Derived by running cstPrint(root2) and capturing its actual output.
  let expected = "{\n  // comment before name\n  \"name\": \"old\",\n  \"count\": 1,\n  \"version\": \"1.0.0\"\n}"
  let printed = cstPrint(root2)
  if (printed == expected) {
    print("roundtrip=match\n")
  } else {
    print("roundtrip=mismatch\n")
    print("---got---\n${printed}\n---want---\n${expected}\n")
  }
}
