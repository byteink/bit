// panic
// #7637: `string(rs[lo:hi])` on a `[]rune` with `hi` past the receiver's
// capacity panics with the text `rs[lo:hi]` itself panics with
// (run_slice_range_panic.bit): `string_from_rune_range` applies
// `rtSliceSlice`'s bounds.
import { args } from "std/os"

fn hi(): int { return len(args()) + 8 }

fn main() {
  let rs = []rune("héllo")
  print("start\n")
  let s = string(rs[0:hi()])
  print("survived ${s}\n")
}
