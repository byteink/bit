// error
// #4695: the three per-monomorphization BODY rules that report a span inside the
// generic's own body must name the user's call, at depth 0 as well as below it.
//
// E0073 has named it since #3827 and #4685 added the note from depth 1 down, but
// `vInstNoteTrail` (validateinstchain.bit) returned before the site note when
// the chain was empty. At depth 0 that left E0052, E0054 and E0057 with a
// primary span and nothing else — and the primary span stands in the generic's
// BODY, which for a stdlib generic is a file the reader cannot edit, so the
// diagnostic named no line they own at all. The early return is gone and the
// hop loop, which runs zero times at depth 0, is the only depth-conditional part
// left.
//
// Depth 0 is the whole variable here: every generic below is called DIRECTLY
// from `main`, so `step.notes` is empty and the note under each error is the
// user's own call. `_tests_/cases/check_generic_body_rules_depth.bit` is the
// same three codes one level deeper, where the hops appear under this note.
//
// The primary spans are `vInstMapKey`'s, `vInstIndex`'s and `vInstMember`'s
// unchanged — this case fails if one of them moves as much as it fails if the
// note goes missing.
class Opaque {}

fn badKey<T>(v: T): int {
  let m = map<T, bool>{}
  m[v] = true
  return len(m)
}

fn badIndex<T>(v: T): bool {
  return v[0] == 9
}

fn badMember<T>(v: T): int {
  return v.n
}

fn main() {
  print("${badKey([1])}\n")
  print("${badIndex(Opaque{})}\n")
  print("${badMember(Opaque{})}\n")
}
