// run
// #4664. A method on a GENERIC receiver that declares its own type param under
// a name ANOTHER declaration in the module also uses. `parseMethodMember`
// (parsertype.bit) built the merged receiver+own `generic_params` node AFTER
// the params, the result and the body, so it sat later in the arena than what
// it scopes — and checkmodule.bit's param pre-pass, which walks the arena in
// source order and re-scopes at each `generic_params` node, typed `(v: T)`
// while the flat module-wide `userTypes["T"]` still held `Box.any`'s `T`. The
// parameter was therefore bound to a foreign type-param id that no
// instantiation env binds, and `v.label()` in the emitted `both<Tag, Tag>` had
// a receiver that is neither class nor interface: `bit check` exited 0 and
// `bit build` refused the whole valid program with E0092.
//
// Declaration ORDER and the NAME are both load-bearing, so both directions are
// here: with `Box.any<T>` first the stale id is the one nothing binds, and with
// it second the instance env happened to bind the stale id anyway and the same
// program compiled. Renaming either param apart also hid it.
interface Named {
  label(): string,
}

class Tag {
  export label(): string {
    return "tag"
  }
}

// Declared BEFORE the generic-receiver method below, and reusing the name `T`.
class Box {
  export any<T>(v: T): int {
    return 1
  }
}

class Holder<U> {
  slot: U,
  export both<T: Named>(v: T): string {
    return v.label()
  }
}

// The same shape with the plain-receiver generic method declared AFTER, and
// with a field declared after the method so the class's own `U` must still be
// in scope for it.
class Later<U> {
  export pick<T: Named>(v: T): string {
    return v.label()
  }
  slot: U,
  export get(): U {
    return this.slot
  }
}

class After {
  export any<T>(v: T): int {
    return 2
  }
}

fn main() {
  let b = Box{}
  let h = Holder<Tag>{ slot: Tag{} }
  print("${b.any(7)} ${h.both(Tag{})}\n")
  let a = After{}
  let l = Later<Tag>{ slot: Tag{} }
  print("${a.any(7)} ${l.pick(Tag{})} ${l.get().label()}\n")
}
