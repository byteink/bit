// run
// stdlib/json/cst_parse.bit's trivia-carrying CST parser (#1479's json epic,
// #1723), exercised through std/json's real cstParse -- not a local copy. A
// golden case IS able to import std/json (_tests_/bit/golden.bit's checkRun
// runs `bit build <case>` with BIT_STDLIB exported); the header this file
// used to carry, claiming otherwise, was false (#2455).
//
// The pre-#1726 shape this file originally tested -- Trivia{leading:
// []string, trailing: Opt<string>} attached per-node, so each leading
// comment was its own list entry and a value's same-line trailing comment
// was a separate per-value field -- no longer exists. stdlib/json/cst.bit
// has carried a different shape since 75a78330 (#1726, the CST printer):
// Trivia{leading: string, trailing: string} populated ONLY on the root node;
// every CstObject/CstArray instead owns one opaque `gaps[i]` raw-text string
// per child boundary (comments, whitespace AND a boundary comma all merged
// together, undecoded); CstEntry lost `.trivia` entirely, replaced by
// `midGap` (the raw text between a key and its value). #3062 confirmed this
// mechanically (E0057 `no field or method 'trivia'` building the straight
// import swap) and decided the strategy this file follows.
//
// So this is NOT a byte-identical rewrite: the original per-node assertions
// (nameEntry.trivia.leading[0], countEntry.value's trivia.trailing) have no
// equivalent read under the new API -- a value's trailing comment and the
// comma after it are no longer distinguishable fields, both landing in the
// same gaps[] slot. What is asserted below is honestly weaker in one place
// (gaps[2] now proves "this boundary's raw bytes are exactly ..." rather
// than "this value's own trailing comment is exactly ...") and STRONGER in
// another: a cstPrint roundtrip is added at the end, proving the whole
// document reassembles byte-for-byte, which the original never checked at
// all. Same source fixture as before: a leading `/* */` block comment on the
// whole document (root trivia -- unreadable at all before #1726), a `//`
// line comment before one key (`name`, now gaps[0]), and a same-line `/* */`
// comment trailing a value immediately before the object's trailing comma
// (`count`'s 42.500, now merged into the tail gaps[2] with that comma).
import { CstNode, cstParse, cstPrint } from "std/json"

// `s` with newlines as a visible two-character escape, so a gaps[i] value
// (which spans multiple source lines) prints as one line of `.expected` --
// matching json_cst_create_intermediate.bit's `esc`. Bounded by `len(s)`.
fn esc(s: string): string {
  let out = ""
  let i = 0
  while (i < len(s)) {
    if (s[i] == '\n') {
      out = out + "\\n"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out
}

// --- test -------------------------------------------------------------

fn main() {
  // /* file header */ before `{`: root's own leading trivia.
  // `// comment before key` before "name": that child's leading gap.
  // `42.500 /* inline note */,`: a same-line comment trailing the number,
  // merged with the object's trailing comma into the tail gap.
  let src = "/* file header */\n{\n  // comment before key\n  \"name\": \"bit\",\n  \"count\": 42.500 /* inline note */,\n}"

  let root = cstParse(src) catch e {
    print("parse failed: ${e.message()}\n")
    return
  }

  match (root) {
    CstObject(entries, gaps, trivia) => {
      print("root.leading=${esc(trivia.leading)}\n")
      print("root.trailing=${esc(trivia.trailing)}\n")
      if (len(entries) != 2) {
        print("entries.len=${len(entries)}\n")
        print("done\n")
        return
      }
      if (len(gaps) != 3) {
        print("gaps.len=${len(gaps)}\n")
        print("done\n")
        return
      }

      let nameEntry = entries[0]
      print("name.keyText=${nameEntry.keyText}\n")
      print("name.key=${nameEntry.key}\n")
      match (gaps[0]) {
        Some(g) => print("gaps[0]=${esc(g)}\n")
        None => print("gaps[0]=missing\n")
      }
      match (nameEntry.value) {
        CstString(raw, vt) => print("name.value.rawText=${raw}\n")
        CstNull(vt) => print("name.value=wrong-null\n")
        CstBool(b, vt) => print("name.value=wrong-bool\n")
        CstNumber(raw, vt) => print("name.value=wrong-number\n")
        CstArray(items, ig, vt) => print("name.value=wrong-array\n")
        CstObject(es, og, vt) => print("name.value=wrong-object\n")
      }

      let countEntry = entries[1]
      print("count.keyText=${countEntry.keyText}\n")
      match (countEntry.value) {
        CstNumber(raw, vt) => print("count.value.rawText=${raw}\n")
        CstNull(vt) => print("count.value=wrong-null\n")
        CstBool(b, vt) => print("count.value=wrong-bool\n")
        CstString(s, vt) => print("count.value=wrong-string\n")
        CstArray(items, ig, vt) => print("count.value=wrong-array\n")
        CstObject(es, og, vt) => print("count.value=wrong-object\n")
      }
      match (gaps[2]) {
        Some(g) => print("gaps[2]=${esc(g)}\n")
        None => print("gaps[2]=missing\n")
      }
    }
    CstNull(t) => print("root=wrong-null\n")
    CstBool(b, t) => print("root=wrong-bool\n")
    CstNumber(r, t) => print("root=wrong-number\n")
    CstString(s, t) => print("root=wrong-string\n")
    CstArray(a, ag, t) => print("root=wrong-array\n")
  }

  let printed = cstPrint(root)
  if (printed == src) {
    print("roundtrip=match\n")
  } else {
    print("roundtrip=mismatch\n")
    print("---got---\n${printed}\n---want---\n${src}\n")
  }

  print("done\n")
}
