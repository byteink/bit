// run
// #6536: `d op= x` on a `decimal` is the two-word decimal arithmetic, not one
// raw `add` over the exploded tuple (which printed 7898233175800511836941870695.7
// for `1.0 + 2.5` at exit 0). Every operator (`+= -= *= /=`) on a local, a class
// field and a module cell, plus a captured (boxed) local. `-=` crossing zero and `*=` by a negative cover the
// sign word. A slice/array/map element is not a decimal lvalue yet: `xs[i]`
// itself is refused (E0092), so it has no case here.
class Box {
  amount: decimal,
}

let cell: decimal = 1.0

fn main() {
  let k: decimal = 1.0
  k += 2.5
  println("local += ${k}")
  k -= 5.0
  println("local -= ${k}")
  k *= -4.0
  println("local *= ${k}")
  k /= 8.0
  println("local /= ${k}")

  let b = Box{ amount = 1.0 }
  b.amount += 2.5
  println("field += ${b.amount}")
  b.amount -= 5.0
  println("field -= ${b.amount}")
  b.amount *= -4.0
  println("field *= ${b.amount}")
  b.amount /= 8.0
  println("field /= ${b.amount}")

  cell += 2.5
  println("cell += ${cell}")
  cell -= 5.0
  println("cell -= ${cell}")
  cell *= -4.0
  println("cell *= ${cell}")
  cell /= 8.0
  println("cell /= ${cell}")

  let acc: decimal = 1.0
  let inc = () => {
    acc += 1.5
  }
  inc()
  inc()
  println("captured += ${acc}")

  let n: decimal = 10.5
  n += k
  println("operand += ${n}")
}
