// run
// Regression: a reference-typed value (string, class) carried through a
// two-arm if/else join must survive register allocation. The unused sibling
// block-param (`c`) must not be coalesced onto the live param's register.
class Box {
  v: i64,
}

fn pickStr(c: bool): string {
  let t = "x"
  if (c) {
    t = "yes"
  } else {
    t = "no"
  }
  return t
}

fn pickBox(c: bool): Box {
  let t = Box{ v: 0 }
  if (c) {
    t = Box{ v: 7 }
  } else {
    t = Box{ v: 9 }
  }
  return t
}

fn main() {
  print(pickStr(true))
  print(" ")
  print(pickStr(false))
  print(" ")
  let a = pickBox(true)
  let b = pickBox(false)
  print("${a.v} ${b.v}\n")
}
