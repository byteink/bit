// run
// SPEC §14.7, #6987: every payload-free enum carries a synthesized
// `__variantName(): string` (the variant identifier as written) and a
// `static __variants(): []string` (every variant name, declaration order),
// so a package can bind enum names without reflection. #7092 adds
// `static __variantAt(i: int): E`, the way back from an index to a value
// through a generic bound. `Action` below declares six variants and no member
// of any of the three names.

enum Action { Manage, Read, Update, Create, Delete, Publish }

export enum Level { Low, High }

enum Solo { Only }

// What pkg/authz binds: the members through a generic bound, with no value of
// the enum in hand for the static ones.
interface Named {
  static __variants(): []string,
  static __variantAt(i: int): Self,
  __variantName(): string,
}

fn at<T: Named>(i: int): T {
  return T.__variantAt(i)
}

// Every index of `T` round-trips: the name of `__variantAt(i)` is `__variants()[i]`.
fn roundTrip<T: Named>(): int {
  let names = T.__variants()
  let ok = 0
  let i = 0
  while (i < len(names)) {
    if (at<T>(i).__variantName() == names[i]) {
      ok = ok + 1
    }
    i = i + 1
  }
  return ok
}

fn namesOf<T: Named>(): []string {
  return T.__variants()
}

fn nameOf<T: Named>(v: T): string {
  return v.__variantName()
}

fn main() {
  let all = [
    Action.Manage,
    Action.Read,
    Action.Update,
    Action.Create,
    Action.Delete,
    Action.Publish,
  ]
  for a of all {
    print("${a.__variantName()}\n")
  }
  let names = Action.__variants()
  print("${len(names)}\n")
  for n of names {
    print("${n} ")
  }
  print("\n")
  print("${Level.High.__variantName()} ${Level.__variants()[0]}\n")
  print("${Solo.Only.__variantName()} ${len(Solo.__variants())}\n")
  print("${len(namesOf<Action>())} ${nameOf(Action.Update)} ${namesOf<Level>()[1]}\n")
  print("${roundTrip<Action>()} of ${len(Action.__variants())}\n")
  print("${roundTrip<Level>()} ${roundTrip<Solo>()}\n")
  print("${Action.__variantAt(0) == Action.Manage} ${Level.__variantAt(1) == Level.High}\n")
  print("${at<Action>(5).__variantName()} ${Solo.__variantAt(0).__variantName()}\n")
}
