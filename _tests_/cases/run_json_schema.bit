// run
// #6165/#6166/#6168/#6169: `jsonSchema<T>()` for a `@json` class, specialised
// per instantiation exactly as `jsonDecode<T>` is (SPEC "jsonSchema<T> - a
// JSON Schema for a `@json` class").
//
// ONE FIELD OF EVERY SHAPE #6165 BUILDS: an integer, a float, `bool`,
// `string`, `[]T`, `map<string, T>`, `Option<T>` (present and admitting
// `null`), a payload-free `enum` and a nested `@json` class (as a `$ref`,
// resolved by #6169's `$defs` object below it). `Small` proves TWO CALLS TO
// `jsonSchema<Same>` IN ONE PROJECT emit exactly one specialised function,
// not two -- both print byte-identical schemas.
//
// #6169's OWN THREE SHAPES: `Item` has exactly one nested field (`addr`), so
// its document carries exactly two `$defs` entries (`Item`, `Addr`). `Node`
// is self-referential (`next: Option<Node>`) and terminates with exactly
// one `$defs` entry, its own `next` field `$ref`-pointing at itself.
// `Diamond` reaches `Leaf` through TWO fields and still contributes exactly
// one `$defs` entry for it, not two.
import { Json, JsonEntry, jsonSchema, jsonEncode } from "std/json"

enum Status {
  Draft,
  Published,
  Archived,
}

@json class Addr {
  city: string,
  zip: i32,
}

@json class Item {
  id: i64,
  price: f64,
  active: bool,
  name: string,
  tags: []string,
  meta: map<string, string>,
  nick: Option<string>,
  status: Status,
  addr: Addr,
}

@json class Small {
  id: i64,
}

@json class Node {
  tag: string,
  next: Option<Node>,
}

@json class Leaf {
  v: i64,
}

@json class Diamond {
  a: Leaf,
  b: Leaf,
}

fn main() {
  print("${jsonEncode(jsonSchema<Item>())}\n")
  print("dedup=${jsonEncode(jsonSchema<Small>()) == jsonEncode(jsonSchema<Small>())}\n")
  print("${jsonEncode(jsonSchema<Node>())}\n")
  print("${jsonEncode(jsonSchema<Diamond>())}\n")
}
