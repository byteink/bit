// run
// #6165/#6166/#6168: `jsonSchema<T>()` for a `@json` class, specialised per
// instantiation exactly as `jsonDecode<T>` is (SPEC "jsonSchema<T> - a JSON
// Schema for a `@json` class").
//
// ONE FIELD OF EVERY SHAPE #6165 BUILDS: an integer, a float, `bool`,
// `string`, `[]T`, `map<string, T>`, `Option<T>` (present and admitting
// `null`), a payload-free `enum` and a nested `@json` class (as a `$ref`,
// #6169's `$defs` wrapper not landed yet, so the reference is dangling by
// design at this point in the epic). `Small` proves TWO CALLS TO
// `jsonSchema<Same>` IN ONE PROJECT emit exactly one specialised function,
// not two -- both print byte-identical schemas.
import { Json, JsonEntry, jsonSchema, jsonEncode } from "std/json"

enum Status {
  Draft,
  Published,
  Archived,
}

@json class Addr {
  city: string,
  zip: i32,
}

@json class Item {
  id: i64,
  price: f64,
  active: bool,
  name: string,
  tags: []string,
  meta: map<string, string>,
  nick: Option<string>,
  status: Status,
  addr: Addr,
}

@json class Small {
  id: i64,
}

fn main() {
  print("${jsonEncode(jsonSchema<Item>())}\n")
  print("dedup=${jsonEncode(jsonSchema<Small>()) == jsonEncode(jsonSchema<Small>())}\n")
}
