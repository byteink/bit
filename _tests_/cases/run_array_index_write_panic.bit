// panic
// #4270: the write-side twin of run_array_index_read_panic.bit, and the
// more severe half of the bug — an unchecked WRITE at a runtime-computed,
// arbitrary offset is a memory-safety hole, not merely a wrong-value read.
// `100000` is 800 KB past the end of this 32-byte stack array; before this
// fix `a[i] = 1` silently corrupted whatever lived there and exited 0.
// `lowerIndexStore`'s Array arm (lowerflow.bit) now runs the same
// `emitArrayBoundsCheckIfNeeded` the read side does before emitting
// `index_set`.
fn main() {
  let a: [4]int = [4]int{ 1, 2, 3, 4 }
  let i = 100000
  print("start\n")
  a[i] = 1
  print("survived\n")
}
