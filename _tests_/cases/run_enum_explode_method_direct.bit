// run
// #5445: the three ways a METHOD returning an eligible payload enum reaches a
// caller, in one program, because they do not share a calling convention and
// only one of them may hand the result back in words.
//
// `pull` is reachable ONLY by a direct `call` — no interface declares that
// name and nothing takes it as a value — so `methodRetExplodes`
// (compiler/lowerexplodemethod.bit) admits it, its `ret` carries two words and
// `emitStaticMethodCall` emits the matching `call_word` run at the call site.
// `bit --dump-ir` on this shape shows ZERO `gc_alloc` for `Step` surviving
// optimization, where before #5445 `drainDirect`'s loop held one per element.
//
// The other two are the guards, and they fail in different ways if the gate
// ever widens to them:
//
//   peel   is taken as a method VALUE (`let f = t.peel`), which
//          `lowerStructMethodValue` (compiler/lowerfuncval.bit) lowers to a
//          closure whose CODE IS the method's own symbol, called back through
//          `Op.CallValue`'s one-handle convention. Nothing at that call site
//          can know the callee returned words, so a method taken as a value
//          must keep the one-handle convention — the closure would otherwise
//          read the tag register as a boxed handle and dereference an integer.
//
//   step   is declared by an interface and dispatched through it, where the
//          INTERFACE's signature is the contract and the implementing class is
//          not the only party to it. #5446 admits it, and the guard it is now
//          holding is a different one: the convention is decided on the NAME,
//          project-wide and unanimously (`ifaceWordRetMethods`,
//          compiler/lowerexplodeiface.bit), so `Source.step` and `Feed.step`
//          agreeing is what lets EITHER of them return words. `peel` above is
//          the arm that still refuses, and nothing about #5446 may change it.
//
// Every count is derived from `len` of a slice built at run time rather than
// written as a literal, so the folder cannot turn a driver into a constant and
// leave a probe that passes by not existing.

enum Step {
  Yield(i64),
  Done,
}

interface Source {
  step(): Step,
}

class Ticker {
  n: i64
  pull(): Step {
    if (this.n > 0) {
      this.n = this.n - 1
      return Step.Yield(this.n)
    }
    return Step.Done
  }
  peel(): Step {
    if (this.n > 0) {
      this.n = this.n - 1
      return Step.Yield(this.n)
    }
    return Step.Done
  }
}

class Feed {
  n: i64
  step(): Step {
    if (this.n > 0) {
      this.n = this.n - 1
      return Step.Yield(this.n)
    }
    return Step.Done
  }
}

fn drainDirect(t: Ticker, k: i64): i64 {
  let total = 0
  let i = 0
  while (i <= k) {
    match (t.pull()) {
      Yield(v) => total = total + v
      Done => total = total - 1
    }
    i = i + 1
  }
  return total
}

fn drainValue(t: Ticker, k: i64): i64 {
  let f = t.peel
  let total = 0
  let i = 0
  while (i <= k) {
    match (f()) {
      Yield(v) => total = total + v
      Done => total = total - 1
    }
    i = i + 1
  }
  return total
}

fn drainIface(s: Source, k: i64): i64 {
  let total = 0
  let i = 0
  while (i <= k) {
    match (s.step()) {
      Yield(v) => total = total + v
      Done => total = total - 1
    }
    i = i + 1
  }
  return total
}

fn main() {
  // `k` is 4, derived rather than written, so every driver runs 5 rounds:
  // four `Yield` arms (3 + 2 + 1 + 0) and one `Done`, i.e. 6 - 1 = 5.
  let sizer = [1, 1, 1, 1]
  let k: i64 = len(sizer)

  print("direct ${drainDirect(Ticker{ n = k }, k)}\n")
  print("value ${drainValue(Ticker{ n = k }, k)}\n")
  print("iface ${drainIface(Feed{ n = k }, k)}\n")
}
