// run
// #3941: `cond ? a : b`, right-associative, between `=>` and `||` (SPEC §12).
// Each print pins a shape the acceptance criteria name directly, with a value
// that would differ under the wrong associativity, the wrong precedence, or a
// dropped span:
//
//   grade      a call argument
//   {n: ...}   a composite-literal field
//   chain      nested right-associatively: `a?b:c?d:e` reads `a?b:(c?d:e)`,
//              never `(a?b:c)?d:e` — the two parse to different VALUES here,
//              not just different trees, so a wrong associativity changes the
//              printed number.
//   afterTry   immediately after a postfix `?` propagation: `f()? ? a : b`
//              — the first `?` unwraps the fallible call, the second opens
//              the conditional (the one real parsing hazard, #3941).
//   mixed      the form mixed with `=>`, `||`, and a plain `let` — `||`
//              binds tighter than `?:`, so `a || b ? c : d` is `(a||b)?c:d`.

class Box {
  n: int,
}

fn label(cond: bool): string {
  return cond ? "pass" : "fail"
}

fn maybeScore(): int! {
  return 91
}

// The postfix `?` propagation is only legal inside a fallible function
// (SPEC §18.3), so the `f()? ? a : b` shape lives here rather than in `main`.
fn afterTryLabel(): string! {
  return maybeScore()? > 90 ? "top" : "rest"
}

fn grade(score: int): string {
  return score >= 90 ? "A" : score >= 80 ? "B" : score >= 70 ? "C" : "F"
}

fn main() {
  // Call argument.
  print("${label(true)} ${label(false)}\n")

  // Composite-literal field.
  let b = Box{ n: true ? 10 : 20 }
  print("n=${b.n}\n")

  // Nested right-associatively, four deep. Under (wrong) left-associativity
  // this would group as `((a?b:c)?d:e)`, whose condition is itself `1`
  // (truthy-if-nonzero would matter in a language with truthiness; here it
  // is a straight type error) — so the two readings are not just different
  // trees, the correct one is the only one that even type-checks.
  print("${grade(95)} ${grade(85)} ${grade(72)} ${grade(50)}\n")

  // Immediately after a postfix `?` propagation.
  let afterTry = afterTryLabel() catch "err"
  print("afterTry=${afterTry}\n")

  // Mixed with `||`, `=>`, and a plain `let`. `||` binds tighter than `?:`.
  let pick: () => int = () => 7
  let x = 3
  let y = 4
  let mixed = x > 10 || y > 3 ? pick() : 0
  print("mixed=${mixed}\n")
}
