// run
// #3839: named arguments at call sites (SPEC §12.11). `serve` takes 3
// parameters; calling it positionally, fully named, and with a positional
// prefix followed by named arguments must all produce identical output --
// the whole point of naming an argument is that it changes nothing about
// what the call DOES, only how the call site reads.
fn serve(app: string, port: int, tls: bool) {
  print("app=${app} port=${port} tls=${tls}\n")
}

fn main() {
  serve("web", 3000, true)
  serve(app = "web", port = 3000, tls = true)
  serve("web", port = 3000, tls = true)
  // Named arguments may be written in any order relative to each other.
  serve(port = 3000, tls = true, app = "web")
}
