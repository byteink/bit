// error
// #4655: a `...` spread's OPERAND was never type-checked, and neither was the
// fixed prefix in front of it. `vCallArgsAreTyped` (compiler/validatecall.bit)
// answered "undecidable" for any call carrying a spread, so `vCallArgTypes`
// never ran: `takesInts(...s)` with `s: string` into `...xs: i64` read the
// string header as a slice header and summed its bytes, `bit check` and
// `bit run` both exiting 0 on a wrong answer.
//
// A spread supplies the WHOLE rest slice, so it is judged against `[]P` for the
// rest parameter's declared element type P (SPEC §12.4: `...` spreads a `[]T`)
// — the same `[]T` `lowerVariadicTail` forwards it as, and the same element
// type `spreadElemType` binds a type parameter from (#4645).
//
// THE DECISION on the generic half, which the ticket left open: `each(...s)`
// for `fn each<T>(...xs: T)` is REJECTED too, as E0068 at the call. A string
// binds no element type, so `T` is genuinely uninferable; it used to be
// instantiated at `()` with the string header forwarded as its `[]()`, printing
// `3` at rc=0. `each<i64>(...s)` is then E0041 like the concrete case.
//
// `run_generic_variadic_spread_binds.bit`, `run_generic_variadic_empty_slot.bit`
// and `run_method_variadic_spread.bit` are the no-false-positive half: every
// legal spread there still runs unchanged.
fn takesInts(...xs: i64): int {
  let n = 0
  for x of xs {
    n = n + x
  }
  return n
}

fn tag(label: string, ...xs: i64): int {
  return len(label) + len(xs)
}

fn each<T>(...xs: T): int {
  return len(xs)
}

fn main() {
  let s = "abc"
  let words = ["a", "b"]
  let nums = [1, 2]
  print("${takesInts(...s)}\n")
  print("${takesInts(...words)}\n")
  print("${tag(7, ...nums)}\n")
  print("${each(...s)}\n")
  print("${each<i64>(...s)}\n")
}
