// run
// #4424: a `string` returned through a FUNCTION VALUE.
//
// A direct call reads the callee's declaration and knows how many registers
// the result arrives in. `Op.CallValue` does not: it holds a func TYPE, which
// records the result as one `string` and nothing about the ABI the target
// actually uses. So a named function reached as a value goes through the
// fn-value trampoline (`lowerglobal.bit`), which calls the real symbol, takes
// the return registers and puts the aggregate back together — the first of the
// three positions that bind a call result somewhere other than a direct call
// site, and the one where a wrong constructor gives a `string` the layout of a
// generic tuple instead of ABI.md §2.3's 24-byte box.
//
// Every arm here is a way of reaching that trampoline:
//
//   direct      the plain call, for the answer the others must match
//   bound       the same function bound to a name and called through it
//   passed      the same function passed as an argument and applied there
//   passedVar   the bound NAME passed on, so the value crosses two frames
//   stored      the value kept in a slice element, so it survives a container
//   twice       applied to its own result, so the rebuilt box is re-consumed
//
// This case runs with `BIT_STRING_EXPLODE_TEST` unset, so its `.expected` is
// what today's one-handle convention prints; it is the oracle for the day the
// flip becomes the default, not a restatement of it.
fn tag(s: string): string {
  return s[1:4] + "!"
}

fn apply(f: (string) => string, s: string): string {
  return f(s)
}

fn main() {
  let g = tag
  let fs = [tag, g]
  print("direct ${tag("abcdef")}\n")
  print("bound ${g("abcdef")}\n")
  print("passed ${apply(tag, "mnopqr")}\n")
  print("passedVar ${apply(g, "stuvwx")}\n")
  print("stored ${fs[0]("ghijkl")} ${fs[1]("ghijkl")}\n")
  print("twice ${apply(g, apply(g, "abcdef"))}\n")
}
