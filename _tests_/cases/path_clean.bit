// run
// #2702: golden coverage for std/path's `clean` and `contains` — normalizing
// a POSIX path lexically, and testing whether one path is inside another on
// whole component boundaries rather than by raw character prefix. The last
// two `contains` checks are the trap this API exists to prevent: a `..`
// smuggled in through `join`, and a candidate that is a string prefix of the
// root (`/a/bc` starts with `/a/b`) but is not actually inside it.
import { clean, contains, join } from "std/path"

fn main() {
  println("clean1=${clean("/srv/root/../../etc/passwd")}")
  println("clean2=${clean("a/./b//c")}")
  println("clean3=${clean("")}")
  println("clean4=${clean("..")}")
  println("clean5=${clean("/..")}")
  println("cleanTrailingSlash=${clean("/srv/root/")}")
  println("containsOk=${contains("/srv/root", join("/srv/root", "public/ok.txt"))}")
  println("containsDotDot=${contains("/srv/root", join("/srv/root", "../private.conf"))}")
  println("containsAbsEscape=${contains("/srv/root", join("/srv/root", "/etc/passwd"))}")
  println("containsSiblingName=${contains("/srv/root", "/srv/rootless")}")
  println("containsPrefixTrap=${contains("/a/b", "/a/bc")}")
}
