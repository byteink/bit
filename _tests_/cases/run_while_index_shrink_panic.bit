// panic
// #4375, the identity of the LIMIT. The header proves `i < L` where `L` is one
// specific SSA value; the element load's unsigned test is only that same test
// when its right operand is that same value id. Rebinding the name to a shorter
// slice between the header and the access gives the load a DIFFERENT limit, and
// the header's proof says nothing about it.
//
// `xs[lo:hi]` allocates a fresh header (runtime/root/slices.bit), so the
// rebinding here really does hand the access a length of 0 while the header
// tested 4. Matching on the expression `slice_len(xs)` rather than on the value
// id would mark this load and read element 0 of a buffer the program no longer
// refers to — live heap, a plausible number, exit 0. The read is printed on
// stderr, which is the stream a `// panic` case compares.
import { args } from "std/os"

fn zero(): int { return len(args()) - 1 }

fn main() {
  let xs = [10, 20, 30, 40]
  let i = 0
  while (i < len(xs)) {
    eprint("i=${i} len=${len(xs)}\n")
    xs = xs[zero():zero()]
    eprint("read=${xs[i]}\n")
    i = i + 1
  }
  eprint("unreachable\n")
}
