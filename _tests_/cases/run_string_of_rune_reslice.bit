// run
// #7637: `string(rs[lo:hi])` on a `[]rune` lowers to ONE
// `rt_call string_from_rune_range`, which UTF-8 encodes the elements
// `lo..hi`. It used to take the `[]byte` path (`string_from_byte_range`) and
// copied the rune buffer's raw 4-byte words, printing NULs for ASCII. The slice
// holds a 2-byte (é), a 3-byte (☺) and a 4-byte (😀) rune so a byte-for-byte
// copy and a per-element encode cannot agree. The panics are
// run_string_of_rune_reslice_{lo_gt_hi,hi_gt_cap}_panic.bit.

fn conv(rs: []rune, lo: int, hi: int): string {
  return string(rs[lo:hi])
}

fn tick(tag: string, v: int): int {
  print("${tag} ")
  return v
}

fn recv(rs: []rune): []rune {
  print("recv ")
  return rs
}

fn fresh(i: int): []rune {
  return []rune("k${i}-é☺😀")
}

fn show(s: string) {
  print("${len(s)} [${s}]\n")
}

fn main() {
  let rs = []rune("aBcd")
  show(string(rs[1:3]))
  show(string(rs[:2]))
  show(string(rs[2:]))
  let m = []rune("aé☺😀z")
  show(string(m[1:3]))
  show(string(m[:2]))
  show(string(m[2:]))
  show(string(m[3:4]))
  show(conv(m, 0, 5))
  show(string(m[2:2]))
  show(string(m[1:4]) + string(m[0:1]))
  let u = []rune("héllo")
  show(string(u[1:]))
  let e: []rune = []
  show(string(e[0:0]))
  let i32s: []i32 = [97, 0x263A, 0xD800, 0x110000, 100]
  show(string(i32s[1:4]))
  let s = string(recv(m)[tick("lo", 1):tick("hi", 3)])
  show(s)
  let grown = append([]rune("ab"), 0x263A)
  show(string(grown[1:3]))
  let total = 0
  let i = 0
  while (i < 20000) {
    total = total + len(string(fresh(i)[1:5]))
    i = i + 1
  }
  print("${total}\n")
}
