// run
// #6201/#6202/#6203/#6204: `jsonSchema<T>()` standing in a generic FREE
// FUNCTION, resolved once per instantiation -- the same forwarding
// `jsonDecode<T>` already has (#4563), now for `jsonSchema<T>` (#6161).
// Before this epic, `wrap<T>()` could not exist: `collectModuleSchemaSites`
// resolved every `jsonSchema<...>()` call's type argument by NAME
// (`jsonSchemaTarget`), and a type parameter is not a name.
//
// CROSS-MODULE: `wrap<T>()` (jsonschemagenericlib/lib.bit) never imports
// `Widget` -- it is instantiated here, in a DIFFERENT module, against a
// @json class the library never sees. The retarget synthesizes
// `wrap<T>`'s specialisation in `Widget`'s OWN module (Instantiation.declModule),
// not the library's, so this fixture is the only thing that can catch a
// retarget landing in the wrong module.
//
// The direct `jsonSchema<Widget>()` call is the control: both paths must
// describe the same class the same way.
import { Json, JsonEntry, jsonSchema, jsonEncode } from "std/json"
import { wrap } from "./jsonschemagenericlib"

@json class Widget {
  id: i64,
  name: string,
}

fn main() {
  let viaWrapper = jsonEncode(wrap<Widget>())
  let direct = jsonEncode(jsonSchema<Widget>())
  print("equal=${viaWrapper == direct}\n")
  print("${viaWrapper}\n")
}
