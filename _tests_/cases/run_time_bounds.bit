// run
// #4077: the period boundaries (docs/stdlib/time.md, "Boundaries"), reached
// through the public `std/time` import surface rather than from inside the
// module -- stdlib/time/bounds.test.bit already covers them from within,
// where the unexported fields and composite literals are in scope, so this
// fixture is the check that the trait injection in `bounds.bit` actually
// lands on the exported `Date`, `NaiveDateTime` and `DateTime` a caller
// gets.
//
// All ten methods on 2026-09-17, a Thursday: every value below is the one
// the "Boundaries" table pins for that date. The week starts on Monday
// (ISO 8601), so the explicit-first-day forms `startOfWeekOn(7)` /
// `endOfWeekOn(7)` -- separate names because Bit has no function
// overloading -- move the same week to 2026-09-13..2026-09-19.
//
// `endOfMonth` is checked on February 2026 (28) and February 2024 (29) as
// well, because the month length is derived from `daysInMonth()` and never
// written down. `endOfDay` is the last representable nanosecond, not the
// next midnight, so the `NaiveDateTime` nanosecond field reads 999999999.
//
// The `DateTime` pair uses Asia/Dubai, permanently +04:00
// (docs/stdlib/time.md, "Zones"; pinned by run_time_zoned_construct), so
// both boundaries of the day carry the same offset and this case stays a
// check of the boundary methods rather than of transition resolution --
// stdlib/time/bounds.test.bit owns the Europe/London day that starts and
// ends at different offsets.
import { date, zone } from "std/time"

fn main() {
  let d = date(2026, 9, 17) catch e {
    println("date failed: ${e.message()}")
    return
  }

  println("startOfDay=${d.startOfDay().toString()}")
  println("endOfDay=${d.endOfDay().toString()}")
  println("startOfWeek=${d.startOfWeek().toString()}")
  println("endOfWeek=${d.endOfWeek().toString()}")
  println("startOfMonth=${d.startOfMonth().toString()}")
  println("endOfMonth=${d.endOfMonth().toString()}")
  println("startOfQuarter=${d.startOfQuarter().toString()}")
  println("endOfQuarter=${d.endOfQuarter().toString()}")
  println("startOfYear=${d.startOfYear().toString()}")
  println("endOfYear=${d.endOfYear().toString()}")

  println("startOfWeekOn7=${d.startOfWeekOn(7).toString()}")
  println("endOfWeekOn7=${d.endOfWeekOn(7).toString()}")

  let feb2026 = date(2026, 2, 10) catch e {
    println("date failed: ${e.message()}")
    return
  }
  println("endOfFeb2026=${feb2026.endOfMonth().toString()}")

  let feb2024 = date(2024, 2, 10) catch e {
    println("date failed: ${e.message()}")
    return
  }
  println("endOfFeb2024=${feb2024.endOfMonth().toString()}")

  let naive = d.atTime(9, 30, 0) catch e {
    println("atTime failed: ${e.message()}")
    return
  }
  println("naiveStartOfDay=${naive.startOfDay().toString()}")
  println("naiveEndOfDay=${naive.endOfDay().toString()}")
  println("naiveEndOfDayNanosecond=${naive.endOfDay().nanosecond()}")
  println("naiveStartOfMonth=${naive.startOfMonth().toString()}")
  println("naiveEndOfYear=${naive.endOfYear().toString()}")

  let dubai = zone("Asia/Dubai") catch e {
    println("zone(Asia/Dubai) failed: ${e.message()}")
    return
  }
  let zoned = naive.inZone(dubai)
  println("zonedStartOfDay=${zoned.startOfDay().toString()}")
  println("zonedEndOfDay=${zoned.endOfDay().toString()}")
  println("zonedStartOfQuarter=${zoned.startOfQuarter().toString()}")
}
