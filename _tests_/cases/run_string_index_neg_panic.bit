// panic
// #4346, the negative string index: `s[-1]` must panic (SPEC §12.6, §18.4).
// Pinned separately from the past-the-end case (`run_string_index_panic.bit`)
// because it is the OTHER arm of `rtStringByte`'s `index < 0 || index >= n`,
// and the inline lowering expresses BOTH with a single UNSIGNED compare: a
// negative index reads as a huge unsigned and fails `(u64)i < (u64)n`. Weaken
// that one compare to a signed one and this read goes behind the string's
// bytes with no upper bound to save it, while the sibling case still passes.
import { args } from "std/os"

fn neg(): int { return 0 - len(args()) }

fn main() {
  let s = "ab"
  print("start\n")
  print("byte=${s[neg()]}\n")
  print("unreachable\n")
}
