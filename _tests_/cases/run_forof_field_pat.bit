// run
// `for { a, b } of xs` (#4106): a for-of field-name pattern over a slice of
// class values — binds each name to the correspondingly NAMED field, not by
// position, so the pattern's own order is irrelevant (unlike the positional
// pair binder, `for (i, x) of xs`, #2012).
class Point {
  x: int,
  y: int,
}

fn main() {
  let pts = [Point{ x: 1, y: 2 }, Point{ x: 3, y: 4 }, Point{ x: 5, y: 6 }]
  let sumX = 0
  let sumY = 0
  for { x, y } of pts {
    sumX = sumX + x
    sumY = sumY + y
  }
  print("sumX=${sumX} sumY=${sumY}\n")

  // Field order in the pattern need not match declaration order, and a
  // pattern may name a strict subset of the class's fields.
  for { y } of pts {
    print("y=${y} ")
  }
  print("\n")
}
