// run
// #1545: a USER-DECLARED generic enum with a payload lowers. The prelude's
// Option/Result are generic enums with payloads too, but they are reached
// through a path that already worked, which is why this gap survived.
//
// The self-hosted type table stores an enum's name but not its variants' payload
// types, so unlike the seed it cannot intern `Wrap<i64>` as its own type with an
// already-substituted payload. It re-derives the type args at the match site from
// the scrutinee's declared type NODE instead. A binding initialized by a variant
// construction recorded no such node, so the arm payload bound at the raw type
// param `T` and lowering had nothing to emit for `${v}`.
//
// Both variant forms are covered because they are the same shape one level
// apart: a payload variant is a call whose callee is a member, a payload-less
// one is the bare member. Only the first was reported; the second failed the
// same way.
enum Wrap<T> { Only(T) }

enum Two<T> { Val(T), Empty }

fn main() {
  // The reported repro: no annotation, so the type args live only on the
  // constructor's `Wrap<i64>` receiver.
  let a = Wrap<i64>.Only(5)
  match (a) {
    Only(v) => { print("a=${v}\n") }
  }
  // A reference payload, which the tag word and the boxed payload record must
  // keep apart for the GC.
  let s = Wrap<string>.Only("hi")
  match (s) {
    Only(v) => { print("s=${v}\n") }
  }
  let t = Two<i64>.Val(9)
  match (t) {
    Val(v) => { print("t=${v}\n") }
    Empty => { print("t=empty\n") }
  }
  // No payload, so no call — the receiver is the member itself.
  let e = Two<i64>.Empty
  match (e) {
    Val(v) => { print("e=${v}\n") }
    Empty => { print("e=empty\n") }
  }
  // The annotated form always worked; keep it so a regression that breaks the
  // annotation path instead of the inferred one is still caught.
  let q: Wrap<i64> = Wrap<i64>.Only(3)
  match (q) {
    Only(v) => { print("q=${v}\n") }
  }
}
