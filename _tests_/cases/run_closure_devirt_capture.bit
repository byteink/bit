// run
// #4356: closure devirtualisation rewrites `call_value %less(a, b)` into a
// direct `call @closure$N(env, a, b)` once the analysis proves every value
// reaching that callee slot is one `make_closure @closure$N`. What it proves is
// the CODE pointer, never the environment — so the env has to keep being read
// out of the {code, env} cell, per instance, at the call site.
//
// This fixture is the guard on that. `sortByMod` builds ONE lambda that
// captures `k` and reads it, and is called twice with different `k`. Both calls
// hand `std/sort` closures with the same code pointer and DIFFERENT
// environments, and both reach the same `sortInPlace`/`mergeRuns`
// instantiation. A rewrite that assumed the env away (passing the null word, or
// reusing one call's env for the other) sorts the second slice by the first
// modulus and prints a different order here, while still compiling, still
// running and still exiting 0.
//
// `isSorted` under the same comparator is printed too: it takes the closure
// through a second, independent instantiation.
//
// Single-file golden: no prelude.
import { sortInPlace, isSorted } from "std/sort"

fn showInts(xs: []int): string {
  let s = "["
  let i = 0
  while (i < len(xs)) {
    if (i > 0) {
      s = s + " "
    }
    s = s + "${xs[i]}"
    i = i + 1
  }
  return s + "]"
}

fn copyOf(xs: []int): []int {
  let out: []int = []int(len(xs))
  let i = 0
  while (i < len(xs)) {
    out[i] = xs[i]
    i = i + 1
  }
  return out
}

// One lambda, one code pointer, a fresh environment per call.
fn sortByMod(xs: []int, k: int): []int {
  let out = copyOf(xs)
  sortInPlace(out, (a, b) => a % k < b % k)
  return out
}

fn sortedByMod(xs: []int, k: int): bool {
  return isSorted(xs, (a, b) => a % k < b % k)
}

fn main() {
  let src: []int = []int{ 17, 4, 9, 22, 3, 15, 8, 30, 11 }
  let by5 = sortByMod(src, 5)
  let by7 = sortByMod(src, 7)
  println("k=5 ${showInts(by5)}")
  println("k=7 ${showInts(by7)}")
  println("by5 sortedUnder5=${sortedByMod(by5, 5)} sortedUnder7=${sortedByMod(by5, 7)}")
  println("by7 sortedUnder7=${sortedByMod(by7, 7)} sortedUnder5=${sortedByMod(by7, 5)}")
  println("src unchanged ${showInts(src)}")
}
