// run
// #7737: `for x of xs` and `for i in xs` over a slice read the bound ONCE, at
// loop start (SPEC §13.1 "Iteration"). Fresh append keeps the ranged header
// unchanged. run_append_headers.bit also pins the saved-header lengths
// across all three loop forms. Elements are read live at each index.
// A `// run` case, so a relapse hangs the suite loudly.
fn main() {
  // of: ys begins with xs's header; each append returns an independent header.
  let xs: []int = []
  xs = append(xs, 1)
  xs = append(xs, 2)
  xs = append(xs, 3)
  let ys = xs
  let n = 0
  for x of xs {
    ys = append(ys, x)
    n = n + 1
    if (n > 100) {
      break
    }
  }
  print("of n=${n} len=${len(xs)}\n")

  // in: the index loop, same alias shape.
  let ws: []int = []
  ws = append(ws, 7)
  ws = append(ws, 8)
  let bs = ws
  let m = 0
  for i in ws {
    bs = append(bs, i)
    m = m + 1
    if (m > 100) {
      break
    }
  }
  print("in m=${m} len=${len(ws)}\n")

  // (i, x) pair binder: the third for-in shape.
  let cs: []int = []
  cs = append(cs, 5)
  cs = append(cs, 6)
  cs = append(cs, 7)
  let ds = cs
  let p = 0
  for (i, c) in cs {
    ds = append(ds, c + i)
    p = p + 1
    if (p > 100) {
      break
    }
  }
  print("pair p=${p}\n")

  // Elements stay live: a store through the alias to a LATER index is seen.
  let es: []int = [1, 2, 3]
  let fs = es
  let sum = 0
  for e of es {
    if (sum == 0) {
      fs[2] = 40
    }
    sum = sum + e
  }
  print("live sum=${sum}\n")
}
