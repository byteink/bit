// error
// #7005: only a class name binds `T` of a `Class<T>` parameter; a variable, even
// one holding an `Article`, is an ordinary value of the wrong type.
import { Class, Where } from "std/where"

class Article {
  id: i64,
}

fn allowed<T>(res: Class<T>, where: Where<T>): bool {
  return true
}

fn main() {
  let a = Article{ id = 1 }
  let n = 5
  let x = allowed(a, {})
  let y = allowed(n, {})
}
