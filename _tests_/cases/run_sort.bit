// run
// #2705: golden case for std/sort — sorted, sortInPlace, isSorted. #2706, #2707
// and #2709 are about to replace hand-written insertion sorts with this API, so
// this fixture is what stands behind those replacements.
//
// Covers what a sort actually gets wrong: an empty slice, a one-element slice,
// an already-sorted run, a reverse-sorted run, all-equal elements, duplicates,
// stability across equal keys, every length from 0 to 40 (#4357 — the merge
// alternates between `xs` and the scratch buffer, and a level whose last run
// has no partner still has to reach the destination buffer; the round lengths
// below happen not to expose that, so the sweep walks a contiguous range),
// `sorted()` leaving its input unmodified (the
// append-aliasing trap — see stdlib/sort/sort.bit's own comment on why it never
// uses `append`), and a multi-key comparator. Every slice here is built with a
// slice literal or a sized `[]T(n)` allocation filled by index, never with
// `append`, so nothing in this test itself can accidentally alias.
//
// The two 1000-element cases print only first, last and a checksum (sum of all
// elements), not the whole slice, so `.expected` stays small. One check is
// split per numbered item so no function crosses the 80-line lint limit.
//
// Single-file golden: no prelude.
import { sorted, sortInPlace, isSorted } from "std/sort"

fn lessInt(a: int, b: int): bool {
  return a < b
}

fn showInts(xs: []int): string {
  let s = "["
  let i = 0
  while (i < len(xs)) {
    if (i > 0) {
      s = s + " "
    }
    s = s + "${xs[i]}"
    i = i + 1
  }
  return s + "]"
}

fn sumInts(xs: []int): int {
  let total = 0
  let i = 0
  while (i < len(xs)) {
    total = total + xs[i]
    i = i + 1
  }
  return total
}

// Ascending 0..n-1, used by both the already-sorted and the isSorted checks.
fn ascending(n: int): []int {
  let xs: []int = []int(n)
  let i = 0
  while (i < n) {
    xs[i] = i
    i = i + 1
  }
  return xs
}

class Item { key: int, id: int }

fn showIds(xs: []Item): string {
  let s = "["
  let i = 0
  while (i < len(xs)) {
    if (i > 0) {
      s = s + " "
    }
    s = s + "${xs[i].id}"
    i = i + 1
  }
  return s + "]"
}

// Named comparator for the bulk checks (11, 12). Check 5 keeps its own lambda
// on purpose: a lambda comparator and a named-function comparator are two
// separate call shapes and both are worth exercising.
fn lessKey(a: Item, b: Item): bool {
  return a.key < b.key
}

// True when `xs` holds each id in 0..n-1 exactly once AND ids ascend inside
// every group of equal keys. Element loss and instability are the two ways a
// buffer-alternating merge goes wrong, and neither is visible from `isSorted`
// alone: a slice where one element was overwritten by a stale slot from the
// other buffer can still be perfectly ordered.
fn stableAndComplete(xs: []Item, n: int): bool {
  let seen: []int = []int(n)
  let i = 0
  while (i < n) {
    let id = xs[i].id
    if (id < 0 || id >= n) {
      return false
    }
    seen[id] = seen[id] + 1
    i = i + 1
  }
  i = 0
  while (i < n) {
    if (seen[i] != 1) {
      return false
    }
    i = i + 1
  }
  i = 1
  while (i < n) {
    if (xs[i - 1].key == xs[i].key && xs[i - 1].id >= xs[i].id) {
      return false
    }
    i = i + 1
  }
  return true
}

// One length of the sweep: keys repeat every 3 elements so most runs contain
// ties, ids are the input order.
fn sweepOne(n: int): bool {
  let xs: []Item = []Item(n)
  let i = 0
  while (i < n) {
    xs[i] = Item{ key: (n - i) % 3, id: i }
    i = i + 1
  }
  sortInPlace(xs, lessKey)
  return isSorted(xs, lessKey) && stableAndComplete(xs, n)
}

// 1. sorted on an empty slice. 2. sorted on a one-element slice.
fn checkEmptyAndOne() {
  let empty: []int = []int(0)
  let s1 = sorted(empty, lessInt)
  println("1 empty: sorted=${showInts(s1)} len=${len(s1)} isSorted=${isSorted(s1, lessInt)}")

  let one: []int = []int(1)
  one[0] = 42
  let s2 = sorted(one, lessInt)
  println("2 one: sorted=${showInts(s2)}")
}

// 3. sortInPlace on an already-sorted 1000-element int slice.
fn checkAlreadySorted() {
  let asc = ascending(1000)
  sortInPlace(asc, lessInt)
  let last = len(asc) - 1
  println(
    "3 already-sorted: first=${asc[0]} last=${asc[last]} sum=${sumInts(asc)} isSorted=${isSorted(
      asc,
      lessInt,
    )}",
  )
}

// 4. sortInPlace on a reverse-sorted 1000-element int slice.
fn checkReverseSorted() {
  let n = 1000
  let desc: []int = []int(n)
  let i = 0
  while (i < n) {
    desc[i] = n - 1 - i
    i = i + 1
  }
  sortInPlace(desc, lessInt)
  println(
    "4 reverse-sorted: first=${desc[0]} last=${desc[n - 1]} sum=${sumInts(desc)} isSorted=${isSorted(
      desc,
      lessInt,
    )}",
  )
}

// 5. Stability: a class slice with duplicate `key` values, sorted by `key`
// only. The `id` sequence must stay in input order inside each group of equal
// keys — ids 1,4,7 (key 1), 3,6 (key 2), 0,2,5 (key 3), in that order.
fn checkStability() {
  let items: []Item = []Item{
    Item{ key: 3, id: 0 },
    Item{ key: 1, id: 1 },
    Item{ key: 3, id: 2 },
    Item{ key: 2, id: 3 },
    Item{ key: 1, id: 4 },
    Item{ key: 3, id: 5 },
    Item{ key: 2, id: 6 },
    Item{ key: 1, id: 7 },
  }
  let byKey = (a: Item, b: Item) => {
    return a.key < b.key
  }
  sortInPlace(items, byKey)
  println("5 stability: ids=${showIds(items)}")
}

// 6. sorted leaves its input unmodified: print the input slice after the call,
// not just the result.
fn checkAliasing() {
  let src: []int = []int{ 5, 1, 4, 2, 3 }
  let out = sorted(src, lessInt)
  println("6 sorted-copy: result=${showInts(out)} inputAfter=${showInts(src)}")
}

// 7. Multi-key comparator: key ascending, then id descending on ties.
// Expected: key=1 group (ids 10,30,50) descending -> 50,30,10, then key=2
// group (ids 20,40) descending -> 40,20.
fn checkMultiKey() {
  let multi: []Item = []Item{
    Item{ key: 1, id: 10 },
    Item{ key: 2, id: 20 },
    Item{ key: 1, id: 30 },
    Item{ key: 2, id: 40 },
    Item{ key: 1, id: 50 },
  }
  let byKeyThenIdDesc = (a: Item, b: Item) => {
    if (a.key != b.key) {
      return a.key < b.key
    }
    return a.id > b.id
  }
  sortInPlace(multi, byKeyThenIdDesc)
  println("7 multi-key: ids=${showIds(multi)}")
}

// 8. isSorted is true after a real sort (from reverse order, so the sort does
// actual work) and false on a shuffled copy of the result.
fn checkIsSorted() {
  let n = 1000
  let desc: []int = []int(n)
  let i = 0
  while (i < n) {
    desc[i] = n - 1 - i
    i = i + 1
  }
  sortInPlace(desc, lessInt)

  let shuffled: []int = []int(n)
  i = 0
  while (i < n) {
    shuffled[i] = desc[i]
    i = i + 1
  }
  let tmp = shuffled[0]
  shuffled[0] = shuffled[n - 1]
  shuffled[n - 1] = tmp

  println("8 isSorted: sorted=${isSorted(desc, lessInt)} shuffled=${isSorted(shuffled, lessInt)}")
}

// 9. All-equal elements: a no-op sort, still reported sorted.
fn checkAllEqual() {
  let equal: []int = []int(6)
  let i = 0
  while (i < 6) {
    equal[i] = 7
    i = i + 1
  }
  sortInPlace(equal, lessInt)
  println("9 all-equal: sorted=${showInts(equal)} isSorted=${isSorted(equal, lessInt)}")
}

// 10. Duplicates that are not all equal.
fn checkDuplicates() {
  let dupSrc: []int = []int{ 4, 2, 4, 1, 2, 4 }
  let dupOut = sorted(dupSrc, lessInt)
  println("10 duplicates: sorted=${showInts(dupOut)} isSorted=${isSorted(dupOut, lessInt)}")
}

// 11. Every length from 0 to 40, each checked for order, stability and no
// lost or duplicated element.
fn checkSizeSweep() {
  let bad = 0
  let n = 0
  while (n <= 40) {
    if (!sweepOne(n)) {
      bad = bad + 1
    }
    n = n + 1
  }
  println("11 size-sweep: lengths=0..40 failures=${bad}")
}

// 12. Stability at scale: 10,000 items over 100 distinct keys, so every key
// carries about 100 equal elements that must keep their input order across
// all 14 merge levels.
fn checkLargeStability() {
  let n = 10000
  let xs: []Item = []Item(n)
  let i = 0
  while (i < n) {
    xs[i] = Item{ key: i * 7919 % 100, id: i }
    i = i + 1
  }
  sortInPlace(xs, lessKey)
  println("12 stability-10000: sorted=${isSorted(xs, lessKey)} stable=${stableAndComplete(xs, n)}")
}

fn main() {
  checkEmptyAndOne()
  checkAlreadySorted()
  checkReverseSorted()
  checkStability()
  checkAliasing()
  checkMultiKey()
  checkIsSorted()
  checkAllEqual()
  checkDuplicates()
  checkSizeSweep()
  checkLargeStability()
}
