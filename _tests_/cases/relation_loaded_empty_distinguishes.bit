// run
//
// #5271: a relation explicitly loaded as EMPTY reads as 0 with no panic --
// distinguishing "no orders" from "never loaded" is the entire reason
// #5053 exists (its owner decision: "an empty list and 'not loaded' are
// then indistinguishable"). `[]Order{}` goes through the same
// `lowerSliceElems` path the ordinary zero value does (SPEC 13.4: an empty
// slice is the null header) -- 0, never
// classrelationattr.bit's non-8-aligned `relationUnloadedSentinel` (1) --
// so this must NOT panic where sibling fixture
// relation_unloaded_read_panics.bit (same class, same field, left
// untouched instead of assigned) does.
import { FieldDesc, AttrDesc } from "std/sql"

class Order {
  id: i64,
}

@table class User {
  @id
  id: i64
  @hasMany("userId")
  orders: []Order
}

fn main() {
  let u = User{ id = 1 }
  u.orders = []Order{}
  print("${len(u.orders)}\n")
}
