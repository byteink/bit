// run
// SPEC §10.5, #5189: `@table("...")` takes at most one argument, a
// non-empty string-literal table-name override. The compiler records it in
// a second synthesized member, `tableAttrs(): []AttrDesc`, in the same
// shape a field's own recorded attribute already uses -- `pkg/orm`'s
// `tableName` reads it with the identical `attrArg` helper `columnName`
// already reads a field's `@column` override with, so this pins the
// compiler side of that: the argument reaches `tableAttrs()`, and it does
// so WITHOUT changing `tableDescriptor()`'s one-entry-per-field shape.
//
// `Order` carries no override, proving `tableAttrs()` is empty. `Person`
// carries one, proving it reaches `tableAttrs()` verbatim and that
// `tableDescriptor()` still lists only real fields, none of them the
// override.
import { FieldDesc, AttrDesc } from "std/sql"

@table class Order {
  id: i64,
}

@table("people") class Person {
  id: i64,
}

fn tableOverride(attrs: []AttrDesc): string {
  for a of attrs {
    if (a.name == "table" && len(a.args) > 0) {
      return a.args[0]
    }
  }
  return ""
}

fn main() {
  let o = Order{ id = 1 }
  print("Order.tableAttrs len=${len(o.tableAttrs())}\n")

  let p = Person{ id = 1 }
  let attrs = p.tableAttrs()
  print("Person.tableAttrs len=${len(attrs)}\n")
  print("override=${tableOverride(attrs)}\n")
  print("Person.tableDescriptor len=${len(p.tableDescriptor())}\n")
}
