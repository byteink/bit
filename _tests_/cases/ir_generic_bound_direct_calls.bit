// ir
// #6396: a call through a type parameter bounded by a generic interface,
// `S: Store<i64>`, is monomorphized: `twice$0` calls the receiver's own `get`
// with `call`, where the same body written against the interface VALUE
// (`viaValue(s: Store<i64>)`) dispatches with `call_iface`. `Depth.get` is
// recursive so the optimizer cannot inline it away and hide the call.
interface Store<T> {
  get(): T,
}

class Depth {
  n: i64
  get(): i64 {
    if (this.n <= 0) {
      return 0
    }
    return Depth{ n = this.n - 1 }.get() + 1
  }
}

fn twice<S: Store<i64>>(s: S): i64 {
  return s.get() + s.get()
}

fn viaValue(s: Store<i64>): i64 {
  return s.get() + s.get()
}

fn both(): i64 {
  return twice(Depth{ n = 3 }) + viaValue(Depth{ n = 3 })
}
