// run
// #7058: a multi-label `case` whose labels are a contiguous run of constants
// lowers to one unsigned range test `(subject - lo) <=u width`
// (compiler/lowerswitchrange.bit) instead of one compare per label. Every
// probe below sits just below a run, inside it (both ends) or just above it,
// so an off-by-one in `lo` or `width` flips a printed bit.
//
// `isString` is pkg/toml's `readScalar` shape: four enum tags in declaration
// order, probed with all six tags around them (6 of 6). The integer runs sit
// at the edges of their types, where `subject - lo` wraps: `i8` at the top
// (-128 - 125 wraps to 3, just past the width), `u8` at zero (255 - 0 stays
// 255) and `i64` at the top, probed from the bottom of the range. A negative
// label lowers as `neg` of a constant, not a `const_int`, so the `i32` run
// (out of order, one duplicate) and the `i64` bottom run keep their compare
// chains, as does `gappy`, a set with a hole; all three must still answer the
// same way.
//
// Every probe comes out of a slice at run time, so no subject reaches
// compiler/optfold.bit as a constant and the range test itself runs.

enum Tok { Key, Basic, Literal, MlBasic, MlLiteral, Number }

fn isString(t: Tok): bool {
  switch (t) {
    case Tok.Basic, Tok.Literal, Tok.MlBasic, Tok.MlLiteral:
      return true
    default:
      return false
  }
}

fn topI8(x: i8): bool {
  switch (x) {
    case 125, 126, 127:
      return true
    default:
      return false
  }
}

fn lowU8(x: u8): bool {
  switch (x) {
    case 0, 1, 2:
      return true
    default:
      return false
  }
}

fn edgesI64(x: i64): string {
  switch (x) {
    case -9223372036854775807, -9223372036854775806:
      return "min"
    case 9223372036854775806, 9223372036854775807:
      return "max"
    default:
      return "mid"
  }
}

fn negI32(x: i32): bool {
  switch (x) {
    case -3, -5, -4, -3:
      return true
    default:
      return false
  }
}

fn gappy(x: i64): bool {
  switch (x) {
    case 1, 2, 4:
      return true
    default:
      return false
  }
}

fn bits(hits: []bool): string {
  let s = ""
  for h of hits {
    if (h) {
      s = s + "1"
    } else {
      s = s + "0"
    }
  }
  return s
}

fn main() {
  let toks = [Tok.Key, Tok.Basic, Tok.Literal, Tok.MlBasic, Tok.MlLiteral, Tok.Number]
  let hits = []bool(0)
  let right = 0
  let want = [false, true, true, true, true, false]
  let i = 0
  while (i < len(toks)) {
    let h = isString(toks[i])
    hits = append(hits, h)
    if (h == want[i]) {
      right = right + 1
    }
    i = i + 1
  }
  println("tok ${bits(hits)} ${right} of ${len(toks)}")

  let i8s: []i8 = [-128, 124, 125, 127]
  let a = []bool(0)
  for v of i8s {
    a = append(a, topI8(v))
  }
  let u8s: []u8 = [255, 0, 2, 3]
  let b = []bool(0)
  for v of u8s {
    b = append(b, lowU8(v))
  }
  let i32s: []i32 = [-6, -5, -3, -2, 2147483647]
  let c = []bool(0)
  for v of i32s {
    c = append(c, negI32(v))
  }
  let gs = [0, 1, 2, 3, 4, 5]
  let g = []bool(0)
  for v of gs {
    g = append(g, gappy(v))
  }
  println("i8 ${bits(a)} u8 ${bits(b)} i32 ${bits(c)} gap ${bits(g)}")

  let es = [
    -9223372036854775807 - 1,
    -9223372036854775807,
    -9223372036854775805,
    9223372036854775805,
    9223372036854775806,
  ]
  let e = ""
  for v of es {
    e = e + edgesI64(v) + " "
  }
  println("i64 ${e}")
}
