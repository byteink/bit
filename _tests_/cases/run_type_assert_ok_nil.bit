// run
// #7408: the `ok` of `let (v, ok) = x.(T)` (SPEC §14.4) is the null test of
// the runtime call's own result, not a second call. `bit_rt_iface_as`,
// `bit_rt_iface_as_enum` and `bit_rt_iface_has` return the receiver on a hit
// and null on a miss, and a nil `x` has no dynamic type, so it always misses.
// This pins hit, miss and nil `x` for all three target kinds: a class, a boxed
// enum and an interface with methods.
//
// The class and enum miss rows are the ones a misplaced test breaks: the miss
// value is replaced by the target's live zero object (#5910), so an `ok` taken
// AFTER that replacement reads `true` on every miss and on a nil `x`.
interface Named {
  name(): string,
}

interface Any {}

class Cat {
  lives: int
  export name(): string { return "cat" }
}

class Rock {
  kg: int,
}

enum Fault {
  Quiet
  Loud(int)
  export message(): string {
    match (this) {
      Quiet => return "quiet"
      Loud(n) => return "loud:${n}"
    }
  }
}

class Other {
  export message(): string { return "other" }
}

fn asCat(x: Any): string {
  let (c, ok) = x.(Cat)
  return "${ok} ${c.lives}"
}

fn asFault(e: error): string {
  let (f, ok) = e.(Fault)
  return "${ok} ${f.message()}"
}

fn asNamed(x: Any): string {
  let (n, ok) = x.(Named)
  if (ok) {
    return "true ${n.name()}"
  }
  return "false ${n == nil}"
}

fn main() {
  let cat: Any = Cat{ lives = 9 }
  let rock: Any = Rock{ kg = 3 }
  let none: Any = nil
  print("class hit ${asCat(cat)}\n")
  print("class miss ${asCat(rock)}\n")
  print("class nil ${asCat(none)}\n")

  let loud: error = Fault.Loud(7)
  let other: error = Other{}
  let noerr: error = nil
  print("enum hit ${asFault(loud)}\n")
  print("enum miss ${asFault(other)}\n")
  print("enum nil ${asFault(noerr)}\n")

  print("iface hit ${asNamed(cat)}\n")
  print("iface miss ${asNamed(rock)}\n")
  print("iface nil ${asNamed(none)}\n")

  // The one-result forms on a hit; their mismatch panics are pinned by
  // panic_type_assert, panic_enum_type_assert_boxed and
  // panic_iface_assert_iface.
  print("one ${cat.(Cat).lives} ${loud.(Fault).message()} ${cat.(Named).name()}\n")
}
