// run
// NEGATIVE case for #1551: two generics that declare the SAME `T` under
// DIFFERENT interface bounds must each be checked against their own bound. The
// checker's type-param table was keyed by NAME and module-wide, so the LAST
// `<T: I>` in the file decided every other decl's `T` — `first`'s `x.get()`
// resolved on `Wordy` and the valid `+ 1` was refused with E0053. No
// differential over the corpus can see this: both compilers were name-keyed
// here, and the shape (same param name, different bounds, same method name,
// different result types) does not otherwise appear.
//
// The two interfaces deliberately declare the SAME method name with DIFFERENT
// result types. That is what makes a wrong bound observable: with distinct
// method names the collision only ever produced a missing method, which the
// permissive path swallows.
//
// Single-file golden, so there is NO prelude: `print` takes a string.

interface Boxy {
  get(): int,
}

interface Wordy {
  get(): string,
}

class Num {
  n: int

  get(): int {
    return this.n
  }
}

class Word {
  w: string

  get(): string {
    return this.w
  }
}

// Bound Boxy: `get()` is int here, so the arithmetic is legal.
fn first<T: Boxy>(x: T): int {
  return x.get() + 1
}

// Bound Wordy, same param NAME: `get()` is string here.
fn second<T: Wordy>(x: T): string {
  return x.get()
}

// A third `T`, unbound, between two bounded ones — an unbound param must not
// inherit either neighbour's constraint.
fn third<T>(x: T): T {
  return x
}

fn main() {
  print("${first(Num{ n: 41 })}\n")
  print(second(Word{ w: "ok" }))
  print("\n")
  print("${third(7)}\n")
}
