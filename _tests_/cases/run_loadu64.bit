// run
// loadU64(p: *u8): u64 (SPEC §11.5) reads the 8 bytes at p..p+7 as an unaligned
// little-endian u64, at every offset 0..16 over a 24-byte buffer, and each read
// equals the same 8 bytes assembled by hand. keepAlive(b) follows the last raw
// read (§11.5's liveness rule).
fn wantU64(b: []byte, off: i64): u64 {
  let v: u64 = 0
  let k: i64 = 7
  while (k >= 0) {
    v = (v << 8) | u64(b[off + k])
    k = k - 1
  }
  return v
}

fn main() {
  let b = []byte(24)
  let i = 0
  while (i < 24) {
    b[i] = byte(i + 1)
    i = i + 1
  }
  let base = ptrOf(b)
  let off = 0
  while (off <= 16) {
    let got = loadU64(base + off)
    let want = wantU64(b, off)
    if (got != want) {
      panic("offset ${off}: want ${want}, got ${got}")
    }
    print("${off}: ${got}\n")
    off = off + 1
  }
  keepAlive(b)
}
