// run
// #7383: an untyped arrow passed to a method that declares its own type
// parameter, on a receiver that is itself generic, takes its parameter type from
// the method's `(T) => bool`. `T` is written on the call, or inferred from
// another argument; the receiver's own arguments fill the merged type
// parameter list ahead of it. Lowering used to fail E0092 on `r.views`.
class Row {
  views: i64,
}

class Item {
  name: string,
}

class Box<W> {
  n: W
  hits: i64

  check<T>(f: (T) => bool): bool {
    return true
  }

  pick<T>(row: T, f: (T) => bool): bool {
    this.hits = this.hits + 1
    return f(row)
  }
}

class Plain {
  ok(f: (Row) => bool): bool {
    return f(Row{ views = 5 })
  }
}

fn within(f: (Plain) => bool): bool {
  return f(Plain{})
}

fn run<W>(f: (Box<W>) => bool, w: W): bool {
  return f(Box<W>{ n = w, hits = 0 })
}

fn main() {
  let b = Box<i64>{ n = 1, hits = 0 }
  println("${b.check<Row>((r) => r.views < 100)}")
  println("${b.pick(Row{ views = 5 }, (r) => r.views < 100)}")
  println("${b.pick(Item{ name = "ab" }, (i) => len(i.name) == 3)}")
  println("${b.hits}")
  println("${within((p) => p.ok((r) => r.views == 5))}")
  println("${run((x) => x.check<Row>((r) => r.views > 0), "w")}")
}
