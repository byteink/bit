// run
// #6112 (SPEC §10.3): a negative literal default. Before #6112 this was
// E0159 twice over -- `vDefaultIsLiteral` never admitted `Tag.Unary`, so a
// signed default failed even though the rule was meant to gate CONSTANTNESS,
// not this particular spelling of one. Widened to any expression that
// type-checks against the parameter, `-1` is unremarkable.

fn f(offset: i64 = -1): i64 {
  return offset
}

fn main() {
  print("${f()}\n")
}
