// run
// #4379: the nil-interface check (#2240) belongs at the DISPATCH, not at loop
// entry. A loop that runs zero times never dispatches through `pm`, so the
// program is correct and must print `done 0` — a compiler that hoists the
// check (or the `*(recv - 16)` TypeInfo load, which faults on a nil receiver)
// into the preheader turns this into a panic for a call the program never
// performed. Same shape and the same argument as
// `run_nil_call_zero_trip.bit`, which forbids the closure-call version.
//
// `zero()` is routed through `len(args())` so `compiler/optfold.bit` cannot
// resolve the trip count at compile time and prune the loop; `args()` has
// length 1 for the argument-free run the harness performs.
import { args } from "std/os"

interface PaymentMethod {
  charge(amount: i64): i64,
}

fn zero(): i64 {
  return i64(len(args())) - 1
}

fn main() {
  let pm: PaymentMethod = nil
  let n = zero()
  let sink: i64 = 0
  let i: i64 = 0
  while (i < n) {
    sink = sink + pm.charge(i)
    i = i + 1
  }
  print("done ${sink}\n")
}
