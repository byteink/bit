// fmt
// #5186: a comment written inside an empty JSX expression child
// (`{/* c */}`) must stay between the same `{` `}` it was written in, not
// relocate after the element -- an empty child's kid is `none`
// (parserjsx.bit's `parseJsxChildBraced`), so nothing advances `p.ci` past
// it for `fmtPrintNode`'s usual srcPos-driven comment flush to catch
// (fmtJsxFlushInlineComments, compiler/fmtjsx.bit). A bare `{}` with no
// comment (between `a` and `b` below) is unaffected either way -- the pair
// itself already round-tripped correctly before this fix.
fn commentChild(): string {
  let page = <div>a{}b{ /* a trailing note, not a child */}c</div>
  return page
}
