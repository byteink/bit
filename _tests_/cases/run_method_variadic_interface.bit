// run
// #4439: a variadic method reached through INTERFACE dispatch (call_iface)
// used the same non-variadic-aware pairing as a direct method call, so
// `b.bar("a","b")` silently returned n=1 (the call's raw argument count
// read positionally, not the collected slice's length).
interface Barer {
  bar(...args: string): string,
}
class Foo {
  x: int
  bar(...args: string): string { return "n=${len(args)}" }
}
fn callIt(b: Barer): string {
  return b.bar("a", "b")
}
fn main() {
  let f = Foo{ x: 1 }
  print(callIt(f))
  print("\n")
}
