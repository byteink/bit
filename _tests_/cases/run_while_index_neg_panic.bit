// panic
// #4375, the base case of the non-negativity induction. `proveInductionBounds`
// drops the element load's unsigned test only when the header param is proven
// `>= 0`, and the ONLY thing standing between a wrong proof and a read behind
// the buffer is `bceIsNonNegConst` refusing a negative literal.
//
// `i` starts at a COMPILE-TIME CONSTANT -1 on purpose: a runtime-computed
// negative start is refused for a second, unrelated reason (it is not a
// constant at all), so it cannot see whether the sign test itself works. Here
// the constant is present, non-negativity is false, and the pass must refuse.
//
// The failure this catches is silent, not a crash: an unsigned `-1` addresses
// one word BEHIND the element buffer, which is live heap. #4346 measured that
// exact shape on the string byte load — four of five fixtures exited 0 with a
// plausible value. So the read is printed, on stderr, which is the stream the
// golden harness compares for a `// panic` case.
import { args } from "std/os"

fn main() {
  let xs = [11, 22, 33]
  xs = append(xs, 44 - len(args()))
  let i = -1
  let seen = 0
  while (i < len(xs)) {
    eprint("i=${i}\n")
    eprint("read=${xs[i]}\n")
    seen = seen + 1
    i = i + 1
  }
  eprint("unreachable seen=${seen}\n")
}
