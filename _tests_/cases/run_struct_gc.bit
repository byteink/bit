// run
// A class holding a *reference* field, established before a loop that
// allocates enough garbage to force real collections; after the loop the
// nested value must still read correctly. The precise stack walk (#1106) keeps
// `keep` a root and the type's pointer map traces `keep.inner`. Before the
// stack maps were wired, a collection swept `keep` and this printed garbage or
// crashed — the loop dwarfs the 4 MiB default trigger, so it really collects.
class Inner { v: i64 }
class Outer { inner: Inner }

fn main() {
  let keep = Outer{ inner: Inner{ v: 4242 } }
  let i = 0
  while (i < 300000) {
    let junk = Inner{ v: i }
    i = i + 1
  }
  print("${keep.inner.v}\n")
}
