// error
// #4657: a bound violation MORE THAN ONE generic deep, judged at the user's own
// call.
//
// #4646 judges the generic calls an instantiated body makes; it reached exactly
// one level, because `validateInstantiations` (checkproject.bit) runs before
// Pass A1's `closeInstantiations` (lowerglobal.bit) and the ledger it reads
// therefore holds only the check pass's own recordings. `outer<i64>` was there,
// `mid<i64>` was not, and the violation inside `mid`'s body was left to the
// lowerer:
//
//   error[E0092]: cannot lower a `.` field access on a receiver that is not a
//   class or interface --> at `v.label()`, inside `inner`
//   note: while emitting 'inner<i64>', instantiated here --> at `inner(v)`,
//   inside `mid`
//
// — two spans, neither of them a line the user wrote, after `bit check` exited
// 0. `vInstDescend` (validateinst.bit) now follows the chain instead, so the
// primary span is the call in `main` and the notes name every hop.
//
// Five routes, because the depth is the cause and the spelling is not:
// `chain(7)` is two deep through ordinary `i64`s; `deep(7)` is three;
// `slotOuter()` binds `T = ()` through an EMPTY variadic slot (#4597/#4633) and
// carries the degenerate type two deep; `viaMethod(7)` ends the chain in a
// generic METHOD (#4656) rather than a free function.
//
// `viaSlot(7)` is the fifth and is here for the opposite reason: `slotMid()`
// binds `()` from its own empty slot no matter what `viaSlot` was instantiated
// with, so the check pass records it as a ledger entry of its own and
// `validateInstantiations` judges it directly rather than by descent.
// Descending into it as well reported the identical E0051 twice, which is what
// `vInstSubstArgs`' "some argument must have mentioned a type param" rule
// exists to prevent — so the one diagnostic it does get is still raised from
// that ledger entry, and only its ATTRIBUTION changed with #4684: `vInstOrigin`
// (validateinstchain.bit) walks the ledger up from that entry to the entry
// whose instantiated body it was recorded inside, so the primary span is
// `viaSlot(7)` in `main` and `slotMid()` becomes the chain's first note. Before
// #4684 both of its spans were lines inside templates.
//
// The satisfying side of every one of these is pinned as running, in
// _tests_/cases/run_generic_transitive_bound_depth.bit.
interface Named {
  label(): string,
}

class Tag {
  export label(): string {
    return "tag"
  }
}

class Box {
  export mk<T: Named>(v: T): string {
    return v.label()
  }
}

fn inner<T: Named>(v: T): string {
  return v.label()
}

fn mid<T>(v: T): string {
  return inner(v)
}

fn chain<T>(v: T): string {
  return mid(v)
}

fn deepA<T>(v: T): string {
  return mid(v)
}

fn deep<T>(v: T): string {
  return deepA(v)
}

fn slotMid<T>(...xs: T): string {
  for x of xs {
    return inner(x)
  }
  return "none"
}

fn viaSlot<T>(v: T): string {
  return slotMid()
}

fn slotOuter<T>(...xs: T): string {
  for x of xs {
    return mid(x)
  }
  return "none"
}

fn viaMethodMid<T>(v: T): string {
  let b = Box{}
  return b.mk(v)
}

fn viaMethod<T>(v: T): string {
  return viaMethodMid(v)
}

fn main() {
  print("${chain(7)}\n")
  print("${deep(7)}\n")
  print("${viaSlot(7)}\n")
  print("${slotOuter()}\n")
  print("${viaMethod(7)}\n")
}
