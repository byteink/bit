// run
// umulHi(a: u64, b: u64): u64 (SPEC §5.3) is the high word of the 128-bit
// product; with the wrapping a * b it is the whole product. Vectors cover the
// all-ones square (whose high word is 2^64 - 2 and low word 1), a zero operand,
// a product that is exactly 2^64, one below 2^64, and a field25519-sized pair.
//
// Each vector prints three ways that must agree: the two words apart, through
// std/math's mul64 (high word first), and low word first with umulHi's
// operands swapped. The last two put the multiplies side by side, which x86-64
// selects as ONE `mul`, rdx the high word and rax the low (#7181): binding them
// the wrong way round prints the words swapped. The vectors come out of a
// slice so that no inlined call folds them into constants.
import { mul64 } from "std/math"

fn show(a: u64, b: u64) {
  print("${umulHi(a, b)} ${a * b}\n")
}

fn viaMul64(a: u64, b: u64) {
  let (hi, lo) = mul64(a, b)
  print("${hi} ${lo}\n")
}

fn lowFirst(a: u64, b: u64) {
  let lo = a * b
  let hi = umulHi(b, a)
  print("${hi} ${lo}\n")
}

fn main() {
  let v: []u64 = [
    0xffffffffffffffff, 0xffffffffffffffff, 0x123456789abcdef0, 0xfedcba9876543210,
    0, 0xffffffffffffffff, 0x8000000000000000, 2, 3, 5, 0xfffffffffffda,
    19 * 0xffffffffffffe,
  ]
  let i = 0
  while (i < len(v)) {
    show(v[i], v[i + 1])
    viaMul64(v[i], v[i + 1])
    lowFirst(v[i], v[i + 1])
    i = i + 2
  }
}
