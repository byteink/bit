// run
// #6677: the handled spellings of every position the checker now refuses an
// unhandled `T!` in (_tests_/bit/checkercases/check_fallible_conditions.bit,
// check_fallible_value_positions.bit). `?` propagates, `catch` recovers, and
// the failing call takes the error path in each, where the unhandled form used
// to read the error half as the value and carry on. `defer` and `spawn` are
// refused too (#6699): `statements` defers a wrapper that handles its error.
class boom {
  message(): string { return "boom" }
}

class box { v: i64 }

fn yes(): bool! { return true }
fn no(): bool! { return false }
fn bad(): bool! { fail boom{} }
fn num(n: i64): i64! {
  if (n < 0) {
    fail boom{}
  }
  return n
}
fn nums(n: i64): []i64! {
  if (n < 0) {
    fail boom{}
  }
  return [n, n + 1]
}
fn mk(n: i64): box! {
  if (n < 0) {
    fail boom{}
  }
  return box{ v = n }
}
fn noop(n: i64): ()! {
  if (n < 0) {
    fail boom{}
  }
}

fn branches(): ()! {
  if (yes()?) {
    print("if yes\n")
  }
  if (bad() catch false) {
    print("if bad: taken\n")
  } else {
    print("if bad: recovered\n")
  }
  switch {
    case bad() catch false:
      print("switch bad\n")
    case yes()?:
      print("switch yes\n")
  }
}

fn loops(): ()! {
  let n = 0
  while (n < 2 && yes()?) {
    n += 1
  }
  print("while ${n}\n")
  for (let i = 0; no() catch true; i += 1) {
    break
  }
}

fn logic(): ()! {
  print("or ${(bad() catch false) || yes()?} not ${!no()?}\n")
}

fn conditions(): ()! {
  branches()?
  loops()?
  logic()?
}

fn lookups(): ()! {
  let xs = [10, 20, 30]
  for x of nums(1)? {
    print("of ${x}\n")
  }
  print("recv ${mk(4)?.v} ${(mk(-1) catch box{ v = 9 }).v}\n")
  print("index ${xs[num(1)?]} slice ${len(xs[num(1)?:3])}\n")
}

fn bindings(): ()! {
  let t = 1
  t += num(2)?
  let u = num(5)?
  let l = [num(1)?, num(-1) catch 0]
  print("t ${t} u ${u} l ${l[0]},${l[1]}\n")
}

fn statements(): ()! {
  noop(1)?
  noop(-1) catch _ {
    print("noop recovered\n")
  }
  let _ = noop(-2)
  // A deferred call has no caller for its error (#6699), so it is handled in a
  // `defer` block.
  defer {
    noop(-3) catch _ {
      print("deferred noop recovered\n")
    }
  }
}

fn values(): ()! {
  lookups()?
  bindings()?
  statements()?
}

fn main() {
  conditions() catch e {
    print("conditions failed ${e.message()}\n")
  }
  values() catch e {
    print("values failed ${e.message()}\n")
  }
  print("done\n")
}
