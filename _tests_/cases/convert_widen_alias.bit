// run
// #4397: a value-preserving widening `convert` whose source is already
// width-canonical (a `field_get` or an `index_get`, per `srcIsWidthCanonical`)
// is aliased to that source in `foldIdentities`, so `int(u8v)` disappears from
// the IR entirely and every consumer reads the u8-typed load directly.
//
// THAT IS A RETYPE OF A LIVE VALUE, and this fixture is the program that makes
// the retype observable. Each store below writes a WIDENED narrow load into a
// destination that already holds a large value, so a store whose width came
// from the value's DEFINING INSTRUCTION (u8 -> 1 byte, u16 -> 2 bytes) would
// leave the destination's upper bytes intact and print a wrong answer at exit
// 0 rather than crashing. #4396 pinned all four store shapes -- field_set,
// index_set, atomic_store, atomic_cmpxchg -- to their own recorded `ival2`;
// before that fix, this fold would miscompile every line here.
//
// The reads are here too: `int(u8v) * 1000000` and the unsigned/signed
// destinations exercise `convertIsPureRetype`'s three arms, including the two
// it REFUSES (`u32(i8v)` must keep its convert, `i8(u8v)` must keep its own).

import { AtomicI64, newAtomicI64 } from "std/sync"

class Rec {
  b: u8,
  h: u16,
  w: u32,
  s8: i8,
  s16: i16,
  s32: i32,
  wide: int,
  wide2: int,
}

fn readWidened(r: Rec, bs: []u8, hs: []u16, ws: []u32) {
  // field_get producers, every width, both signednesses.
  print("f ${int(r.b) * 1000000} ${int(r.h) * 100000} ${int(r.w) + 1}\n")
  print("s ${int(r.s8) * 1000000} ${int(r.s16) * 1000000} ${int(r.s32) * 100000}\n")
  // index_get producers.
  print("i ${int(bs[1]) * 1000000} ${int(hs[1]) * 100000} ${int(ws[1]) + 1}\n")
  // Unsigned destinations: u64(u8) folds, u32(u8) folds, u32(i8) must NOT.
  print("u ${u64(r.b) + 18446744073709551000} ${u32(r.b) * 3} ${u32(r.s8)}\n")
  // Narrowing and same-width-different-signedness must NOT fold.
  print("n ${i8(r.b)} ${u8(r.h)} ${i16(r.w)}\n")
}

// field_set of a widened load into an i64 field that already holds a value
// whose upper bytes are non-zero.
fn storeFields(r: Rec, bs: []u8, hs: []u16) {
  r.wide = 1085102592571150095 // 0x0F0F0F0F0F0F0F0F
  r.wide = int(r.b)
  r.wide2 = 1085102592571150095
  r.wide2 = int(hs[1])
  print("fs ${r.wide} ${r.wide2}\n")
  r.wide = 1085102592571150095
  r.wide = int(bs[1])
  print("fs2 ${r.wide}\n")
}

// index_set of a widened load into a []int element holding a large value.
fn storeElems(r: Rec, bs: []u8, hs: []u16): []int {
  let xs: []int = [1085102592571150095, 1085102592571150095, 1085102592571150095]
  xs[0] = int(r.b)
  xs[1] = int(hs[1])
  xs[2] = int(bs[2])
  return xs
}

// atomic_store and atomic_cmpxchg of a widened load.
fn storeAtomics(r: Rec, hs: []u16) {
  let a = newAtomicI64(1085102592571150095)
  a.store(int(r.b))
  print("as ${a.load()}\n")
  let c = newAtomicI64(1085102592571150095)
  let ok = c.compareAndSwap(1085102592571150095, int(hs[1]))
  print("cas ${ok} ${c.load()}\n")
}

fn main() {
  let r = Rec{
    b: 200, h: 60000, w: 4000000000, s8: -3, s16: -300, s32: -70000,
    wide: 0, wide2: 0,
  }
  let bs: []u8 = [1, 200, 255]
  let hs: []u16 = [7, 60000]
  let ws: []u32 = [9, 4000000000]
  readWidened(r, bs, hs, ws)
  storeFields(r, bs, hs)
  let xs = storeElems(r, bs, hs)
  print("is ${xs[0]} ${xs[1]} ${xs[2]}\n")
  storeAtomics(r, hs)
}
