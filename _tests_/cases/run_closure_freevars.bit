// run
// #4380: lowerArrowFn used to pack EVERY enclosing binding into a closure's
// env instead of only the lambda's free variables. This exercises the cases a
// correct free-variable walk has to get right, each one asserting a VALUE a
// wrong capture set would get wrong (not merely a crash):
//
//   - onlyQClosure captures exactly one of several enclosing locals (p, r are
//     not named in its body and must not leak in).
//   - makeAdder's OWN body never names `z` — only the lambda it RETURNS does —
//     so the outer function must still relay `z` through to the inner one.
//   - shadow's own `let x` hides the outer `x` of the same name: a capture set
//     built from names alone (not scope) would wrongly treat the outer `x` as
//     free here.
//   - describeClosure reaches `name` only through a string interpolation, not
//     a bare identifier reference.
fn makeAdder(z: int): (int) => int {
  return (n: int) => n + z
}

fn main() {
  let p = 1
  let q = 2
  let r = 3
  let onlyQClosure = (v: int) => v + q
  print("onlyQ(10)=${onlyQClosure(10)}\n")

  let z = 100
  let addZ = makeAdder(z)
  print("addZ(5)=${addZ(5)}\n")

  let x = 9000
  let shadow = () => {
    let x = 1
    return x + 1
  }
  print("shadow()=${shadow()}\n")
  print("outer x still ${x}\n")

  let name = "cap"
  let describeClosure = () => "hello ${name}"
  print("${describeClosure()}\n")
  print("unused p=${p} r=${r}\n")
}
