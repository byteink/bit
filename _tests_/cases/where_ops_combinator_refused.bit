// error
// #6997: the operands of `and`, `or` and `not` are conditions on the same `T`:
// a nested unknown field, a wrong value type, a scalar for `or` and a list for
// `not` are each reported.
import { Where } from "std/where"

class Article {
  id: i64,
  status: string,
}

fn main() {
  let a: Where<Article> = { or: [{ statuss: "x" }, { id: "1" }] }
  let b: Where<Article> = { or: 1 }
  let c: Where<Article> = { not: [{ id: 1 }] }
}
