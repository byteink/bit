// run
fn report(sum: int, last: int, scale: int, tag: int): bool {
  println("sum=${sum} last=${last} scale=${scale} tag=${tag}")
  return sum > last * scale
}

fn total(y: []int): bool {
  let sum = 0
  let i = 0
  while (i < 3 * 256) {
    sum = sum + y[i]
    i = i + 1
  }
  return report(sum, i, 7, 3 * 256)
}

fn main() {
  let y = []int(768)
  let k = 0
  while (k < 768) {
    y[k] = k
    k = k + 1
  }
  println("big=${total(y)}")
}
