// run
// #4467: `ptrOf(s)` yields a RAW address into `s`'s buffer, and `isRefType`
// (compiler/codegen.bit) reports `*T` as a word the GC must never follow — so
// `s` is the only thing that roots the bytes the pointer names. The lowering
// now records that as a keepalive edge (`builderKeepAlive`, lowerprim.bit) and
// `extendKeepAlive` (codegenlive.bit) holds `s`'s live interval open to the end
// of everything transitively derived from the pointer.
//
// WHY THE CHAIN MATTERS AND NOT JUST THE EDGE. `ptrOf(s) + 1` lowers to
// `field_get` -> `convert` -> `add` (SPEC §11.4 pointer arithmetic). The edge
// names the `convert`; the value live across the call below is the `add`, and
// the value threaded through the loop headers is a `*i64` block PARAMETER two
// more steps away. Extending `s` only to the `convert` leaves it dead at the
// safepoint, which is the whole of #4467.
//
// WHY IT IS A WRONG ANSWER AND NOT A CRASH. The backing is swept and its slot
// handed to the next allocation of the same size class, which zeroes it, so the
// read returns 0 at exit 0. Measured on `8dd3ad4e` before the fix: 555 expected,
// **0** printed, 3/3 deterministic, identical under `BIT_GC=stress`.
//
// WHY THE PRESSURE IS LOAD-BEARING. Without it this arm passes for the wrong
// reason: `s` stays in a callee-saved register nothing overwrites, the callee's
// own prologue pushes it, and root class 8's conservative scan of the live stack
// finds the bytes. Twelve values live across `churn` give the allocator a reason
// to reuse that register — measured, `x24` is reloaded with `ab` in the
// instruction before the `bl`. `run_exploded_pair_keepalive.bit` is the sibling
// case for the EXPLODED-aggregate half of the same hazard.
//
// THE CONTROL IS `off`, and it is why this file cannot pass by accident. Both
// arms are the SAME code with the same register allocation; only the address
// differs. `off = 0` is the buffer's BASE address, which `gcOwns`
// (runtime/gc/gcalloc.bit) accepts by exact equality, so it printed 555 before
// the fix as well. `off = 1` is interior and rooted nothing. If this file ever
// starts passing with the edge removed, that is where to look first.
extern fn bit_rt_port_stw_collections(): i64

// Enough allocation to drive the DEFAULT collector, so this case needs no
// `BIT_GC=stress` to fire.
fn churn(n: i64) {
  let i = 0
  while (i < n) {
    let junk = []i64(8)
    atomicStore(ptrOf(junk), 7)
    i = i + 1
  }
}

// The loops keep `s` and `t` out of the inliner's single-block budget and put
// the interior pointer through two block-parameter hops before it is read.
fn probe(n: i64, off: i64): i64 {
  let s = []i64(8)
  let t = []i64(16)
  let i = 0
  while (i < 1) {
    atomicStore(ptrOf(s) + off, 555)
    i = i + 1
  }
  let j = 0
  while (j < 16) {
    atomicStore(ptrOf(t) + j, j)
    j = j + 1
  }
  // `s`'s last SSA use is this `ptrOf`. Everything below reads `t` and `p`.
  let p = ptrOf(s) + off
  let a0 = int(atomicLoad(ptrOf(t) + 0))
  let a1 = int(atomicLoad(ptrOf(t) + 1))
  let a2 = int(atomicLoad(ptrOf(t) + 2))
  let a3 = int(atomicLoad(ptrOf(t) + 3))
  let a4 = int(atomicLoad(ptrOf(t) + 4))
  let a5 = int(atomicLoad(ptrOf(t) + 5))
  let a6 = int(atomicLoad(ptrOf(t) + 6))
  let a7 = int(atomicLoad(ptrOf(t) + 7))
  let a8 = int(atomicLoad(ptrOf(t) + 8))
  let a9 = int(atomicLoad(ptrOf(t) + 9))
  let aa = int(atomicLoad(ptrOf(t) + 10))
  let ab = int(atomicLoad(ptrOf(t) + 11))
  churn(n)
  // 0+1+...+11 = 66, so a correct run contributes nothing here and the printed
  // number is the dereference alone — a load that silently stopped happening
  // would show up as a huge value rather than as a passing 555.
  let sum = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + aa + ab
  return *p + (sum - 66) * 1000
}

fn main() {
  let n = 200000
  let before = int(bit_rt_port_stw_collections())
  let interior = probe(n, 1)
  let base = probe(n, 0)
  // Without this the case would pass vacuously the day the collector's growth
  // policy stops firing at this volume, and nothing would say so.
  if (int(bit_rt_port_stw_collections()) <= before) {
    panic("no collection ran: this case cannot fail as written")
  }
  print("interior=${interior} base=${base}\n")
}
