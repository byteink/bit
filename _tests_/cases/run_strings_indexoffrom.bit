// run
// #5892: `indexOfFrom` scans for the needle's first byte in a leaf loop with
// no per-byte bounds check and compares the rest only where that byte
// matches. This pins it against a naive reference over every needle length
// 0..9, haystack length 0..40 and start `at` in -2..len+2, with the needle
// planted at every offset (so across every 8-byte boundary) and absent. Two
// fillers and two needle shapes make the first byte match everywhere or
// almost nowhere, so both the tail compare and the plain scan are exercised.
// Then "\r\n" and "\r\n\r\n" in a 100-byte HTTP header block, std/http's use.
import { indexOfFrom, repeat } from "std/strings"

// The obvious definition, kept independent of `indexOfFrom`'s own clamps.
fn naive(s: string, sub: string, at: i64): i64 {
  let off = at
  if (off < 0) {
    off = 0
  }
  if (off > len(s)) {
    return -1
  }
  let i = off
  while (i + len(sub) <= len(s)) {
    if (s[i:i + len(sub)] == sub) {
      return i
    }
    i = i + 1
  }
  return -1
}

// `n` bytes of all 'a' (kind 0) or of "ab" repeated (kind 1).
fn filler(n: i64, kind: i64): string {
  if (kind == 0) {
    return repeat("a", n)
  }
  return repeat("ab", n / 2 + 1)[0:n]
}

// 'a' * (m - 1) then 'b' (shape 0), or 'b' then 'a' * (m - 1) (shape 1).
fn needle(m: i64, shape: i64): string {
  if (m == 0) {
    return ""
  }
  if (shape == 0) {
    return repeat("a", m - 1) + "b"
  }
  return "b" + repeat("a", m - 1)
}

// Every `at` in -2..len(hay)+2; returns how many disagreed with `naive`.
fn checkAll(hay: string, sub: string): i64 {
  let bad = 0
  let at = -2
  while (at <= len(hay) + 2) {
    let got = indexOfFrom(hay, sub, at)
    let want = naive(hay, sub, at)
    if (got != want) {
      println("MISMATCH hay=\"${hay}\" sub=\"${sub}\" at=${at} got=${got} want=${want}")
      bad = bad + 1
    }
    at = at + 1
  }
  return bad
}

// Every haystack length and plant offset for one needle; returns [checked
// haystacks, mismatches].
fn sweep(sub: string, kind: i64): []i64 {
  let hays = 0
  let bad = 0
  let n = 0
  while (n <= 40) {
    let base = filler(n, kind)
    bad = bad + checkAll(base, sub)
    hays = hays + 1
    let p = 0
    while (p + len(sub) <= n) {
      bad = bad + checkAll(base[0:p] + sub + base[p + len(sub):n], sub)
      hays = hays + 1
      p = p + 1
    }
    n = n + 1
  }
  return [hays, bad]
}

fn main() {
  let m = 0
  while (m <= 9) {
    let shape = 0
    while (shape <= 1) {
      let kind = 0
      while (kind <= 1) {
        let r = sweep(needle(m, shape), kind)
        println("m=${m} shape=${shape} filler=${kind} haystacks=${r[0]} mismatches=${r[1]}")
        kind = kind + 1
      }
      shape = shape + 1
    }
    m = m + 1
  }

  let block = "GET /plaintext HTTP/1.1\r\nHost: localhost:8080\r\n" +
    "User-Agent: oha/1.4.5\r\nAccept: */*\r\nX-Pad: 012345\r\n\r\n"
  println("block=${len(block)}")
  let crlf = [0, 23, 24, 25, 44, 45, 67, 96, 97, 98, 99, 100, 101]
  let i = 0
  while (i < len(crlf)) {
    let at = crlf[i]
    let a = indexOfFrom(block, "\r\n", at)
    let b = indexOfFrom(block, "\r\n\r\n", at)
    assert(a == naive(block, "\r\n", at), "crlf matches the reference")
    assert(b == naive(block, "\r\n\r\n", at), "crlf crlf matches the reference")
    println("at=${at} crlf=${a} end=${b}")
    i = i + 1
  }
}
