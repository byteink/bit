// panic
// #3982: multiply overflows far more easily than add/sub -- two 15-digit
// operands' EXACT product needs about 30 digits, well past the 96-bit
// magnitude range (~7.9x10^28, ~29 digits) that `emitDecMulPair`
// (lowerdecimalarith.bit) checks column-by-column. Scale is 0 on both sides,
// so this exercises the MAGNITUDE overflow check, not the separate
// scale-sum-past-28 one `lowerDecimalMultiply` also panics on.
fn main() {
  let a: decimal = 999999999999999
  let b: decimal = 999999999999999
  print("start\n")
  print("product=${a * b}\n")
  print("unreachable\n")
}
