// run
// The #348 map volume gate: 100k inserts / lookups / deletes on an int-keyed
// map, then iterate the survivors. Runs once under the default collector; the
// mapchurn stress program is the precise-rooting oracle under BIT_GC=stress.
fn main() {
  let m = map<int, int>()
  let i = 0
  while (i < 100000) {
    m[i] = i * 2
    i = i + 1
  }

  let sum = 0
  i = 0
  while (i < 100000) {
    sum = sum + m[i]
    i = i + 1
  }

  // Delete every odd key, halving the map.
  i = 1
  while (i < 100000) {
    delete(m, i)
    i = i + 2
  }

  // Sum the even survivors by iteration (order-independent).
  let itersum = 0
  for (k, v) of m {
    itersum = itersum + v
  }

  print("sum=${sum} after=${len(m)} itersum=${itersum}\n")
}
