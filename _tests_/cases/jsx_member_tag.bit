// run
// #5171: JSXMemberExpression against the REAL pkg/web library - `<Lib.Bar
// />` reaches a component through a module path (`jsxmembertaglib/bar.bit`),
// the shape a Bit user hits as soon as components live in a module.
// `parseJsxTagName` (parserjsx.bit) builds an ordinary `Tag.Member` node for
// the dotted tag, reused UNCHANGED as the desugared call's callee
// (desugarjsx.bit) - `<Lib.Bar label="x" />` desugars to `Lib.Bar(label =
// "x")`, an ordinary namespace-alias call (SPEC §12.11's `vNsNamedArgs`
// path, compiler/namedargs.bit), with no new desugaring of its own.
import { render } from "../../pkg/web"
import Lib from "./jsxmembertaglib"

fn main() {
  println(render(<Lib.Bar label="x" />))
}
