// run
// SPEC §10.5, #5052: `@table`'s hidden persisted-flag accessors —
// `isPersisted()`/`markPersisted(v)` — read and write one word appended
// after the class's own declared fields, never a real field: a composite
// literal leaves it false, `markPersisted` toggles it, and it never appears
// in `tableDescriptor()` or in `@json`'s `toJson()` output. Setting it and
// reading it back at hydration is #5052's own follow-on (the row mapper
// calling `markPersisted(true)`), not tested here.
import { FieldDesc, AttrDesc } from "std/sql"
import { Json, JsonEntry, jsonEncode } from "std/json"

@table
@json
class User {
  @id
  id: i64
  email: string
}

fn describe(u: User) {
  for f of u.tableDescriptor() {
    print("field:${f.name}\n")
  }
}

fn main() {
  let u = User{ id: 1, email: "a@b.com" }
  print("${u.isPersisted()}\n")
  u.markPersisted(true)
  print("${u.isPersisted()}\n")
  u.markPersisted(false)
  print("${u.isPersisted()}\n")
  describe(u)
  print("${jsonEncode(u.toJson())}\n")
}
