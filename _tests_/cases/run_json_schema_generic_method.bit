// run
// #6201/#6202/#6203/#6204: `jsonSchema<T>()` standing in a generic METHOD,
// matching pkg/web's intended `Route.requestBody<T>()` shape (#6200):
// `Box.describe<T>()` (jsonschemagenericlib/lib.bit) is a method on a class
// declared in one module, instantiated here against a @json class this
// module declares -- the library never imports it. A method call reads its
// type argument through `methodTypeArgsRaw`, a different path from the free
// function's `resolveCallTarget` ledger lookup in run_json_schema_generic.bit,
// so one shape working proves nothing about the other.
//
// The direct `jsonSchema<Gadget>()` call is the control: both paths must
// describe the same class the same way.
import { Json, JsonEntry, jsonSchema, jsonEncode } from "std/json"
import { Box } from "./jsonschemagenericlib"

@json class Gadget {
  sku: string,
  price: f64,
}

fn main() {
  let b = Box{ tag = "catalog" }
  let viaMethod = jsonEncode(b.describe<Gadget>())
  let direct = jsonEncode(jsonSchema<Gadget>())
  print("equal=${viaMethod == direct}\n")
  print("${viaMethod}\n")
}
