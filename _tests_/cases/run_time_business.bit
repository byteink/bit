// run
// #4079: business days (docs/stdlib/time.md, "Business days"), reached
// through the public `std/time` import surface rather than from inside the
// module -- stdlib/time/business.test.bit already covers them from within,
// where the unexported fields and composite literals are in scope, so this
// fixture is the check that `business.bit`'s trait injection actually lands
// on the exported `Date` a caller gets, and that `Weekend`, `Calendar` and
// the three constructors are importable at all.
//
// The week is Mon 2026-09-14 .. Mon 2026-09-21: 2026-09-17 is a Thursday,
// the day run_time_bounds.bit already pins, so the 18th is a Friday, the
// 19th a Saturday and the 21st a Monday.
//
// Saturday is a day off under BOTH constructors -- weekendFriSat is Friday
// and Saturday -- so the day the two disagree on is Sunday the 20th, which
// is the pair printed below.
import { date, calendar, weekendSatSun, weekendFriSat, weekendOn, Date } from "std/time"

fn caseDate(y: int, m: int, d: int): Date {
  return date(y, m, d) catch e {
    panic("date failed: ${e.message()}")
  }
}

fn main() {
  let satSun = weekendSatSun()
  let friSat = weekendFriSat()
  let sat = caseDate(2026, 9, 19)
  let sun = caseDate(2026, 9, 20)
  println("satIsWeekendSatSun=${sat.isWeekend(satSun)}")
  println("satIsWeekendFriSat=${sat.isWeekend(friSat)}")
  println("sunIsWeekendSatSun=${sun.isWeekend(satSun)}")
  println("sunIsWeekdayFriSat=${sun.isWeekday(friSat)}")

  let plain = calendar(satSun, []Date(0))
  let holiday = calendar(satSun, append([]Date(0), caseDate(2026, 9, 21)))
  let fri = caseDate(2026, 9, 18)
  println("friPlusOne=${fri.addBusinessDays(plain, 1).toString()}")
  println("friPlusOneWithHoliday=${fri.addBusinessDays(holiday, 1).toString()}")
  println("friMinusOne=${fri.addBusinessDays(plain, -1).toString()}")
  println("satPlusZero=${sat.addBusinessDays(plain, 0).toString()}")
  println("friNext=${fri.nextBusinessDay(plain).toString()}")
  println("friPrevious=${fri.previousBusinessDay(plain).toString()}")

  let mon = caseDate(2026, 9, 14)
  let nextMon = caseDate(2026, 9, 21)
  println("weekDifference=${mon.differenceInBusinessDays(plain, nextMon)}")
  println("weekDifferenceBack=${nextMon.differenceInBusinessDays(plain, mon)}")
  println("weekDifferenceWithHoliday=${mon.differenceInBusinessDays(holiday, nextMon)}")

  let all = weekendOn([]int{ 1, 2, 3, 4, 5, 6, 7 }) catch _ {
    println("allSevenRejected=true")
    let zero = weekendOn([]int{ 0 }) catch _ {
      println("dayZeroRejected=true")
      return
    }
    println("dayZeroRejected=false ${sat.isWeekend(zero)}")
    return
  }
  println("allSevenRejected=false ${sat.isWeekend(all)}")
}
