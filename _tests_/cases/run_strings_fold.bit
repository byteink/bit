// run
// #2341: toLower/toUpper folded only ASCII, and #2278's ASCII-only
// equalFold could not tell "Bob@ÉCOLE.FR" apart from "bob@école.fr" —
// bitlab/programs/formcheck created two accounts for one email spelled two
// ways because the mismatch LOOKED normalised. This is the Unicode simple
// case-folding fix: stdlib/strings/unicodefold.bit, covering Latin-1
// Supplement, Latin Extended-A/B, Greek and Coptic, and Cyrillic. Every
// assertion below failed before this ticket's fix.
import { equalFold, toLower, toUpper } from "std/strings"

fn main() {
  // Latin-1 Supplement: É (U+00C9) <-> é (U+00E9).
  assert(toLower("\u{C9}COLE") == "\u{E9}cole", "toLower must fold Latin-1 \u{C9}")
  assert(toUpper("\u{E9}cole") == "\u{C9}COLE", "toUpper must fold Latin-1 \u{E9}")

  // Greek and Coptic: ΣΊΣΥΦΟΣ, ending in Σ (U+03A3). Simple folding has no
  // notion of word-final position, so the trailing Σ lowers to plain sigma
  // (U+03C3), never the context-sensitive final form ς (U+03C2) that full
  // Unicode casing would produce — observed, not assumed; see #2341's report.
  let sisyphus = "\u{3A3}\u{38A}\u{3A3}\u{3A5}\u{3A6}\u{39F}\u{3A3}"
  let loweredSisyphus = toLower(sisyphus)
  assert(
    loweredSisyphus == "\u{3C3}\u{3AF}\u{3C3}\u{3C5}\u{3C6}\u{3BF}\u{3C3}",
    "toLower must fully fold Greek, ending in plain sigma not final sigma",
  )

  // Cyrillic: ИВАН -> иван.
  assert(
    toLower("\u{418}\u{412}\u{410}\u{41D}") == "\u{438}\u{432}\u{430}\u{43D}",
    "toLower must fold Cyrillic",
  )

  // equalFold across a Latin-1 fold, mixed with ASCII and non-letter bytes.
  assert(
    equalFold("Bob@\u{C9}COLE.FR", "bob@\u{E9}cole.fr"),
    "equalFold must fold Latin-1 across '@'/'.' boundaries",
  )

  // The regression pin from #2278/#2341: simple folding must never expand
  // ß to "ss" (that is FULL case folding, not simple).
  assert(!equalFold("stra\u{DF}e", "STRASSE"), "simple folding must not expand \u{DF} to ss")

  // Plain ASCII must still work.
  assert(equalFold("abc", "ABC"), "plain ASCII equalFold must still match")

  println("ok")
}
