// run
// #2103: a `catch` block on a `()!` call could not fall through — E0067's
// "must produce a value or divert control" demanded an expression of type
// `()`, but SPEC §11 (line 750) makes a bare `()` a valid type only in
// RESULT position, so no expression can ever produce it. The block already
// yields `()` by falling off the end, exactly as an arrow-fn block body with
// no value-returning `return` does (§12.8, line 1684); only the validator
// was refusing it. See the sibling REJECTION case
// check_catch_value_falls_through.bit: the narrowing is void-fallible only,
// a non-void `T!E` catch that falls through still needs a value and still
// fails E0067.
//
// A single-file golden gets NO prelude, so the error value is a local type
// satisfying the predeclared `error` interface structurally rather than
// `newError`, and output goes through `print`.
class myErr { code: i64 
  message(): string { return "code=${this.code}" }
}
fn f(ok: bool): ()! {
  if (ok) { return }
  fail myErr{ code: 7 }
}

fn main() {
  let msg = "none"
  f(false) catch e { msg = e.message() }
  print("after=${msg}\n")
  let msg2 = "none"
  f(true) catch e { msg2 = e.message() }
  print("after2=${msg2}\n")
}
