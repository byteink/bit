// run
// #4373 made a probe hand off to a GROUP scanner (`mapProbeSwar`) once it has
// taken `probeInlineSteps` byte steps, so every entry point now has a byte
// prefix and a group tail and the two must agree exactly. This drives chains on
// BOTH sides of that threshold, through all four scalar entry points and the
// shared `string`/composite path.
//
// WHAT IT PINS, and why the digest is here rather than a set of counts. A
// scanner that skipped a group it should not have loses entries, which the
// counts below catch. A scanner that stops the walk one slot early or late
// picks a DIFFERENT slot for a reinsert -- every count still balances and every
// key still reads back, while the table's collision distribution has silently
// changed. Iteration walks the ctrl array in ascending slot order, so the
// sequence of keys it yields IS the layout: `orderDigest` folds it, and the
// `.expected` beside this file was generated from the compiler BEFORE #4373, so
// it is an oracle for slot choice and not a restatement of the new behaviour.
//
// A deliberate consequence: a future change to `mapHash`, `mapCtrlTag`, the
// load factor or the probe order reddens this fixture. That is the point --
// those are the four things mapcaps.bit says must not drift quietly.
//
// CAPACITY MOD 8 IS ALWAYS 0 AND CANNOT BE VARIED. `mapInitCap` is 8 and both
// `mapCapForHint` and `mapGrow` double, so a table's slot count is a power of
// two of at least 8 and the ctrl array always tiles into whole groups. There is
// no partial final group to test. What IS tested is the array's END: a probe
// that wraps must not read the eight bytes at `cap - 3`, so the small-table
// sweep below runs every capacity from 8 to 512 at a load that wraps.

// Sparse and negative, so the splitmix64 finalizer is doing real work rather
// than mapping i -> slot i.
fn keyAt(i: int): int {
  return i * 2654435761 - 1000
}

fn orderDigest(h: int, x: int): int {
  let a = (h ^ x) * 1099511628211
  return a ^ (a >> 29)
}

// The iteration-order digest of a scalar map: slot order, keys and values.
fn scalarOrder(m: map<int, int>): int {
  let h = 17
  let pos = 0
  for (k, v) of m {
    h = orderDigest(h, pos * 31 + k)
    h = orderDigest(h, v)
    pos = pos + 1
  }
  return orderDigest(h, len(m) * 7919 + pos)
}

fn stringOrder(m: map<string, int>): int {
  let h = 91
  let pos = 0
  for (k, v) of m {
    h = orderDigest(h, pos * 31 + len(k))
    h = orderDigest(h, v)
    pos = pos + 1
  }
  return orderDigest(h, len(m) * 7919 + pos)
}

// 1791 keys in a 2048-slot table -- load 0.874, one insert short of the grow
// the 7/8 ceiling fires at. Miss chains here run tens of slots, so every entry
// point crosses `probeInlineSteps` on most probes.
const denseCount: int = 1791

fn fillDense(m: map<int, int>) {
  let i = 0
  while (i < denseCount) {
    m[keyAt(i)] = i
    i = i + 1
  }
}

// Every present key must read back through BOTH `map_get` and the comma-ok
// `map_slot` read, and every absent key must report absent through both.
fn scanDense(m: map<int, int>): int {
  let bad = 0
  let i = 0
  while (i < denseCount) {
    let k = keyAt(i)
    if (m[k] != i) {
      bad = bad + 1
    }
    let (v, ok) = m[k]
    if (!ok || v != i) {
      bad = bad + 1
    }
    // An absent key: the longest chains in the table, since a miss walks to the
    // first EMPTY slot.
    let (av, aok) = m[k + 1]
    if (aok || av != 0) {
      bad = bad + 1
    }
    if (m[k + 1] != 0) {
      bad = bad + 1
    }
    i = i + 1
  }
  return bad
}

// Delete three quarters, read every key back (present and absent both walk
// tombstone chains), then reinsert them with new values.
// One comma-ok read against the survival rule "i % 4 == 0 survives a delete".
fn checkPresence(m: map<int, int>, i: int, val: int): int {
  let (v, ok) = m[keyAt(i)]
  let want = i % 4 == 0
  if (ok != want) {
    return 1
  }
  if (ok && v != val) {
    return 1
  }
  return 0
}

fn deleteThreeQuarters(m: map<int, int>, n: int) {
  let i = 0
  while (i < n) {
    if (i % 4 != 0) {
      delete(m, keyAt(i))
    }
    i = i + 1
  }
}

fn churnDense(m: map<int, int>): int {
  let bad = 0
  deleteThreeQuarters(m, denseCount)
  let i = 0
  while (i < denseCount) {
    bad = bad + checkPresence(m, i, i)
    i = i + 1
  }
  i = 0
  while (i < denseCount) {
    if (i % 4 != 0) {
      m[keyAt(i)] = i + 7
    }
    i = i + 1
  }
  i = 0
  while (i < denseCount) {
    let want = i
    if (i % 4 != 0) {
      want = i + 7
    }
    if (m[keyAt(i)] != want) {
      bad = bad + 1
    }
    i = i + 1
  }
  return bad
}

// Every capacity from 8 to 512, each filled to just under its own grow point so
// probes wrap past the end of the ctrl array, with a full read-back and an
// absent-key probe at each size.
fn sweepCapacities(): int {
  let bad = 0
  let n = 0
  while (n <= 450) {
    let m = map<int, int>()
    let i = 0
    while (i < n) {
      m[keyAt(i)] = i
      i = i + 1
    }
    if (len(m) != n) {
      bad = bad + 1
    }
    i = 0
    while (i < n) {
      if (m[keyAt(i)] != i) {
        bad = bad + 1
      }
      let (v, ok) = m[keyAt(i) + 3]
      if (ok || v != 0) {
        bad = bad + 1
      }
      i = i + 1
    }
    n = n + 1
  }
  return bad
}

// Insert straight past several resizes with tombstones live, re-reading the
// whole key set after each one: `mapGrow` rehashes through `mapHash`, and a
// scanner that disagreed with it by one slot loses entries here and nowhere
// else.
// `growAcrossResizes`' final layout as well as its counts: an insert that
// picks the WRONG slot on a long chain balances every count and still reads
// back, and only the slot order shows it. Every one of the 9000 inserts below
// happens somewhere on the load curve, a seventh of them within one insert of
// the 7/8 ceiling, so a defect that needs a rare tag (one key in 128 carries
// tag 0x80) and a chain past `probeInlineSteps` still gets many chances.
fn growAcrossResizes(): int {
  let bad = 0
  let m = map<int, int>()
  let n = 0
  while (n < 9000) {
    m[keyAt(n)] = n
    if (n % 3 == 2) {
      delete(m, keyAt(n - 1))
    }
    n = n + 1
    if (n % 1500 == 0) {
      let i = 0
      while (i < n) {
        let (v, ok) = m[keyAt(i)]
        let want = i % 3 != 1
        if (ok != want) {
          bad = bad + 1
        }
        if (ok && v != i) {
          bad = bad + 1
        }
        i = i + 1
      }
    }
  }
  return bad * 1000000000 + (scalarOrder(m) & 268435455)
}

// TOMBSTONE REUSE AT A LONG CHAIN, which nothing above can see. `rtMapSet`
// grows on `used` (FULL+TOMB), so at 1790/2048 exactly one insert fits before
// the 7/8 ceiling fires. Deleting a key and reinserting it must claim the
// TOMBSTONE the delete left -- that keeps `used` at 1790 and no grow ever
// happens, so this loop runs 400 delete/reinsert pairs in one table with
// chains long enough to reach the group scanner every time.
//
// A probe that forgot the tombstone its byte prefix found would claim the
// EMPTY slot that ended the chain instead, take `used` to 1791, and grow on
// the very next reinsert -- rehashing the table and changing the layout
// wholesale. So `order` below is the assertion, not `bad`.
fn tombReuse(): int {
  let m = map<int, int>(1790)
  let i = 0
  while (i < 1790) {
    m[keyAt(i)] = i
    i = i + 1
  }
  let bad = 0
  let r = 0
  while (r < 400) {
    let k = keyAt(r * 3 + 1)
    delete(m, k)
    m[k] = r * 3 + 1 + 100000
    if (m[k] != r * 3 + 1 + 100000) {
      bad = bad + 1
    }
    r = r + 1
  }
  i = 0
  while (i < 1790) {
    let (_, ok) = m[keyAt(i)]
    if (!ok) {
      bad = bad + 1
    }
    i = i + 1
  }
  return bad * 1000000000 + (scalarOrder(m) & 268435455)
}

// The `string` path: `mapProbe` -> `mapProbeSwar`, whose byte body dispatches
// through `mapKeyEq` rather than comparing words.
fn strKey(i: int): string {
  return "k${i * 2654435761 - 1000}"
}

// One comma-ok read plus one absent-key read, against the same survival rule.
fn checkStr(m: map<string, int>, i: int): int {
  let (v, ok) = m[strKey(i)]
  let want = i % 4 == 0
  let bad = 0
  if (ok != want) {
    bad = bad + 1
  }
  if (ok && v != i) {
    bad = bad + 1
  }
  if (m["z${i}"] != 0) {
    bad = bad + 1
  }
  return bad
}

fn stringChains(): int {
  let m = map<string, int>()
  let bad = 0
  let i = 0
  while (i < denseCount) {
    m[strKey(i)] = i
    i = i + 1
  }
  i = 0
  while (i < denseCount) {
    if (i % 4 != 0) {
      delete(m, strKey(i))
    }
    i = i + 1
  }
  i = 0
  while (i < denseCount) {
    bad = bad + checkStr(m, i)
    i = i + 1
  }
  i = 0
  while (i < denseCount) {
    if (i % 4 != 0) {
      m[strKey(i)] = i + 5
    }
    i = i + 1
  }
  return bad * 1000000 + stringOrder(m)
}

// splitmix64's finalizer -- the exact `scalarHash` the runtime applies to a
// scalar key. It is replicated here ONLY TO SELECT KEYS, never to check one:
// nothing below compares it against the runtime's answer, so the two cannot
// disagree in a way that hides anything. If the runtime's hash ever changes,
// this picks a different key set and the pinned digests move, which is the
// contract this whole fixture already has.
fn hashOf(key: int): u64 {
  let x = u64(key)
  x = (x ^ (x >> u64(30))) * 0xbf58476d1ce4e5b9
  x = (x ^ (x >> u64(27))) * 0x94d049bb133111eb
  return x ^ (x >> u64(31))
}

// Keys whose hash has zero top seven bits, so `mapCtrlTag` gives them tag 0x80
// exactly. THAT TAG IS THE BOUNDARY CASE OF THE GROUP TEST: an EMPTY slot's
// lane becomes `0x80 ^ 0x00` = 0x80, and 0x80 minus one is 0x7f, whose top bit
// is CLEAR. A group test that only looked for a matching tag and forgot to
// check that every slot is FULL would therefore skip straight over an EMPTY
// slot for these keys and no others -- one key in 128, which volume alone finds
// only by luck.
fn lowTagKeys(want: int): []int {
  let out: []int = []
  let k = 1
  while (len(out) < want && k < 4000000) {
    if ((hashOf(k) >> u64(57)) == u64(0)) {
      out = append(out, k)
    }
    k = k + 1
  }
  return out
}

// 190 tag-0x80 keys inserted into a 2048-slot table already at load 0.78, so
// every one of them probes a long chain and ends on an EMPTY slot. Skipping
// past that EMPTY still finds the key afterwards -- the walk is wrong the same
// way on both sides -- so the count below cannot see it and the LAYOUT can.
fn lowTagChains(): int {
  let m = map<int, int>(1790)
  let i = 0
  while (i < 1600) {
    m[keyAt(i)] = i
    i = i + 1
  }
  let ks = lowTagKeys(190)
  let bad = 0
  let j = 0
  while (j < len(ks)) {
    m[ks[j]] = j + 500000
    j = j + 1
  }
  j = 0
  while (j < len(ks)) {
    if (m[ks[j]] != j + 500000) {
      bad = bad + 1
    }
    j = j + 1
  }
  if (len(ks) != 190 || len(m) != 1790) {
    bad = bad + 1000
  }
  return bad * 1000000000 + (scalarOrder(m) & 268435455)
}

fn main() {
  let m = map<int, int>(denseCount)
  fillDense(m)
  let dense = len(m)
  let denseBad = scanDense(m)
  let order1 = scalarOrder(m)
  let churnBad = churnDense(m)
  let order2 = scalarOrder(m)
  let sweepBad = sweepCapacities()
  let growBad = growAcrossResizes()
  let tomb = tombReuse()
  let lowTag = lowTagChains()
  let str = stringChains()

  print("dense=${dense} denseBad=${denseBad} churnBad=${churnBad}\n")
  print("sweepBad=${sweepBad} grow=${growBad} tomb=${tomb} lowTag=${lowTag}\n")
  print("order1=${order1} order2=${order2}\n")
  print("string=${str}\n")
}
