// run
// #4439: a variadic `init` lowered its constructor call with the same
// non-variadic-aware pairing every other method call site used to. The
// checker's own arity check only ever admits a call whose argument count
// equals the declared parameter count (1, for a single rest parameter), so
// this is the "uniform arity" case that compiles and runs but read a raw
// string's BYTE length instead of the collected slice's ELEMENT count.
class Foo {
  n: int
  init(...args: string) {
    this.n = len(args)
  }
}
fn main() {
  let a = Foo("ab")
  print("n=${a.n}\n")
}
