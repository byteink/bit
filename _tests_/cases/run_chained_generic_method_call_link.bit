// run
// #5330. A fallible generic method reached through ANOTHER method's return
// value on the same generic receiver: `this.scoped().all()`, `scoped()`
// returning `Query2<T>`. `scoped()`'s own return-type annotation minted a
// FRESH TypeId for the receiver-merged `T` (a method's receiver `<T>` used to
// always register its own copy, #checkbinddecl.bit's `registerGenerics`), so
// `all()`'s body — a SIBLING method on a DIFFERENT class — had no binding for
// it and could not substitute `Query2<T>` into the concrete `Query2<Widget>`
// lowering had already emitted. `bit check` exited 0 and `bit run` failed at
// LINK time with `undefined symbol '_all$t<N>'`, referenced from bit.o — no
// checker diagnostic at all, because nothing about the program is ill-typed;
// the emitted call simply named an instantiation nothing emitted.
fn stdlikeFetch<T>(mapper: (i64) => T!): T! {
  return mapper(1)?
}

class Query2<T> {
  mapper: (i64) => T!
  export all(): T! {
    return stdlikeFetch(this.mapper)?
  }
}

fn find2<T>(mapper: (i64) => T!): Query2<T> {
  return Query2<T>{ mapper = mapper }
}

class SoftQuery2<T> {
  inner: Query2<T>
  export all(): T! {
    return this.scoped().all()?
  }
  scoped(): Query2<T> {
    return this.inner
  }
}

fn findScoped2<T>(mapper: (i64) => T!): SoftQuery2<T> {
  return SoftQuery2<T>{ inner = find2<T>(mapper) }
}

class Widget { id: i64 }
fn widgetMapper(x: i64): Widget! { return Widget{ id = x } }

fn main() {
  let sq = findScoped2<Widget>(widgetMapper)
  let r = sq.all() catch _ {
    print("err\n")
    return
  }
  print("${r.id}\n")
}
