// run
// #2177: std/http query-string parsing and percent-encoding —
// splitTarget/parseQuery/percentDecode/percentEncode. Pins the ticket's
// acceptance examples, the rule-1 case (an encoded separator inside a query
// value must not be mistaken for a real one, because decoding runs only
// after splitting), and a full percentEncode/percentDecode round-trip over
// every byte 0-255.
import { splitTarget, parseQuery, percentDecode, percentEncode } from "std/http"

fn main() {
  let (p1, q1) = splitTarget("/todos?done=true&limit=10")
  println("splitPath=${p1}")
  println("splitQuery=${q1}")

  let (p2, q2) = splitTarget("/todos")
  println("splitNoQueryPath=${p2}")
  println("splitNoQueryQuery=${q2}")

  // Duplicate key: last-wins.
  let m = parseQuery("done=true&limit=10&limit=99")
  println("done=${m["done"]}")
  println("limit=${m["limit"]}")

  println("decode1=${percentDecode("a%20b+c%2Fd")}")
  println("decodeMalformed=${percentDecode("%zz")}")

  // Rule 1: an encoded '&' inside a value must not be treated as a separator.
  let (p3, q3) = splitTarget("/search?q=a%26b")
  let m3 = parseQuery(q3)
  println("encodedSepPath=${p3}")
  println("encodedSepKeys=${len(m3)}")
  println("encodedSepQ=${m3["q"]}")

  // percentEncode/percentDecode round-trip every byte 0-255.
  let roundtripOk = true
  let v = 0
  while (v < 256) {
    let b = byte(v)
    let s = string([]byte{ b })
    let enc = percentEncode(s)
    let dec = percentDecode(enc)
    if (len(dec) != 1 || dec[0] != b) {
      roundtripOk = false
    }
    v = v + 1
  }
  println("roundtripAll=${roundtripOk}")
}
