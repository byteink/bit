// run
// #4428: the compiler folds a slice header's `off` word to the constant 0 when
// the header is provably one `bit_rt_slice_new` created (`markZeroOffLoads`,
// compiler/optzerooff.bit), which deletes the `off` load and the `off + index`
// add from every element access on it. This case pins the four shapes where
// that fold must NOT fire, each against an oracle that a wrongly-fired fold
// would fail — a dropped `off` term leaves every access through a WHOLE slice
// correct and only a view disagrees, so `run_reslice.bit` and the rest of the
// corpus would still pass with the analysis broken.
//
// `run_slice_view_offset_read.bit`/`_write.bit` already cover a straight-line
// view. What is new here is that the fact travels along CFG edges: the fold is
// established at a `slice_new` and cleared at a block-param meet, so the cases
// that can break it are a header carried around a LOOP, a header merged at a
// JOIN, and a header handed to `append` — none of which any existing case
// exercises with an independent oracle.
//
// Every index goes through `zero()` so no index is a compile-time constant and
// the accesses cannot be folded away wholesale.
import { args } from "std/os"

fn zero(): int { return len(args()) - 1 }

fn main() {
  // 1. THE POSITIVE CASE, so the fixture is not merely a set of refusals: a
  // slice that is never resliced, indexed in a loop. This is the shape the fold
  // fires on, and it must still read the right elements.
  let plain = []i64(3)
  plain[zero()] = 1
  plain[zero() + 1] = 2
  plain[zero() + 2] = 4
  let s: i64 = 0
  let k = 0
  while (k < 3) {
    s = s + plain[k]
    k = k + 1
  }
  print("plain=${s}\n")

  // 2. LOOP-CARRIED RESLICE. `v` reaches its index site as a loop-header block
  // param whose back edge passes a `slice_slice` result, so the meet over the
  // header's incoming edges is what has to clear the fact — the preheader edge
  // alone carries a value with `off == 0`. Digits are accumulated rather than
  // summed so that reading the wrong element cannot coincidentally agree.
  let xs = [10, 20, 30, 40, 50, 60]
  let v = xs[0:6]
  let i = 0
  let acc: i64 = 0
  while (i < 4) {
    acc = acc * 100 + v[zero()]
    v = v[1:]
    i = i + 1
  }
  print("carried=${acc} vlen=${len(v)}\n")

  // 3. JOIN OF A FRESH SLICE AND A VIEW. Only one incoming edge is zero-off, so
  // an "any predecessor agrees" meet — or an optimistic fixpoint that forgot to
  // clear on a non-back edge — would fold here and read `fresh[0]` instead of
  // `fresh[2]`. The condition is opaque to the optimizer (`args()` is a runtime
  // call), so neither arm can be pruned.
  let fresh = []i64(4)
  fresh[zero()] = 7
  fresh[zero() + 1] = 8
  fresh[zero() + 2] = 9
  fresh[zero() + 3] = 11
  let pick = fresh
  if (len(args()) > 0) {
    pick = fresh[2:]
  }
  print("merged=${pick[zero()]}\n")

  // 4. `append` ONTO A VIEW, WITH SPARE CAPACITY. `bit_rt_slice_append` returns
  // its own argument's header when it does not grow, so the fact forwards from
  // `args[0]` — and here `args[0]` is a view whose `off` is 2. #4039's expanded
  // fast path writes the element at `buf[off + len]` inline, so a wrongly-folded
  // `off` puts it at `buf[2]` and clobbers the element `tail[0]` reads back.
  let cap8 = []i64(4, 8)
  cap8[zero()] = 1
  cap8[zero() + 1] = 2
  cap8[zero() + 2] = 3
  cap8[zero() + 3] = 4
  let tail = cap8[2:]
  tail = append(tail, 5)
  print("tail=${tail[zero()]},${tail[zero() + 1]},${tail[zero() + 2]} taillen=${len(tail)}\n")

  // 5. `append` ONTO A FRESH SLICE, the forwarding rule's positive direction:
  // the result is still zero-off, both across the grows this triggers and
  // through the loop-header param that carries it.
  let grown = []i64(0)
  let g = 0
  while (g < 5) {
    grown = append(grown, i64(g) * 3)
    g = g + 1
  }
  print("grown=${grown[zero()]},${grown[zero() + 4]} grownlen=${len(grown)}\n")
}
