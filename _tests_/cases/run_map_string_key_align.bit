// run
// #4353 made `wyhash` read its input as whole 64- and 32-bit little-endian
// words instead of one byte at a time, so a `map<string, V>` key's HASH now
// depends on machinery that a byte loop was immune to. This drives that from
// ordinary language syntax:
//
//   * the SAME BYTES AT EIGHT SUCCESSIVE ADDRESSES must be one entry. `s[k:]`
//     is a view -- it shares the source's buffer at `ptr + k` (`strInitView`)
//     -- so slicing a padded copy back down puts identical bytes at every
//     alignment. A word load that masked its address to an 8-byte boundary
//     would hash those to different slots, and the map would hold up to eight
//     entries for one key instead of one;
//   * every LENGTH CLASS wyhash branches on: 0/1/7 (the sub-4 and smallKey
//     arms), 8/9/15/16 (smallKey's four 4-byte reads), 17 and 47 (final1 with
//     no round loop), 100 (the 48-byte round loop and its tail);
//   * INSERT PAST A RESIZE with full read-back. `mapGrow` rehashes every live
//     entry through `mapHash`, so an insert-time hash and a grow-time hash that
//     disagreed would lose entries silently -- and only across a resize.
//
// Counts, not digests: a fixture that pinned hash values would have to change
// whenever wyhash's constants did, and the seven official test vectors in
// _tests_/stress/rootbit already pin those against an oracle outside this repo.

const growCount: int = 3000

// `n` bytes, distinct per length so no two subjects collide.
fn body(n: int): string {
  let alphabet = "abcdefghijklmnopqrstuvwxyz0123456789"
  let out = ""
  let i = 0
  while (i < n) {
    let d = (i * 7 + n) % 36
    out = out + alphabet[d:d + 1]
    i = i + 1
  }
  return out
}

// The same bytes as `s`, sitting `off` bytes into a fresh allocation.
fn shifted(s: string, off: int): string {
  let pad = ""
  let i = 0
  while (i < off) {
    pad = pad + "#"
    i = i + 1
  }
  let joined = pad + s
  return joined[off:off + len(s)]
}

fn lengths(): []int {
  return [0, 1, 7, 8, 9, 15, 16, 17, 47, 48, 100]
}

// Insert each length's key under its 8-aligned form, then write it again
// through all eight shifted forms. Every write must hit the SAME entry, so the
// map ends with one entry per length and each holds the last value written.
fn alignEntries(): int {
  let m = map<string, int>()
  let lens = lengths()
  let i = 0
  while (i < len(lens)) {
    m[body(lens[i])] = -1
    i = i + 1
  }
  i = 0
  while (i < len(lens)) {
    let off = 0
    while (off < 8) {
      m[shifted(body(lens[i]), off)] = lens[i] * 8 + off
      off = off + 1
    }
    i = i + 1
  }
  return len(m)
}

// Read every subject back through both `m[k]` and the comma-ok form, at every
// alignment, and count the ones that do not find the value written under the
// aligned form.
fn alignMisses(): int {
  let m = map<string, int>()
  let lens = lengths()
  let i = 0
  while (i < len(lens)) {
    m[body(lens[i])] = lens[i] + 1
    i = i + 1
  }
  let missed = 0
  i = 0
  while (i < len(lens)) {
    let off = 0
    while (off < 8) {
      let k = shifted(body(lens[i]), off)
      if (m[k] != lens[i] + 1) {
        missed = missed + 1
      }
      let (v, ok) = m[k]
      if (!ok || v != lens[i] + 1) {
        missed = missed + 1
      }
      off = off + 1
    }
    i = i + 1
  }
  return missed
}

// A key whose length walks 1..64, so the grow below rehashes through every
// wyhash branch rather than just the 16-byte one.
fn growKey(i: int): string {
  return body(1 + i % 64) + "/" + "${i}"
}

// Insert `growCount` string keys into a map with NO capacity hint, so the table
// resizes repeatedly and every live entry is rehashed each time; then read them
// all back. Deletes two thirds first so the last grows also carry tombstones.
fn growLost(): int {
  let m = map<string, int>()
  let i = 0
  while (i < growCount) {
    m[growKey(i)] = i
    i = i + 1
  }
  i = 0
  while (i < growCount) {
    if (i % 3 != 0) {
      delete(m, growKey(i))
    }
    i = i + 1
  }
  i = 0
  while (i < growCount) {
    m[growKey(i)] = i + 1
    i = i + 1
  }
  let lost = 0
  i = 0
  while (i < growCount) {
    let (v, ok) = m[growKey(i)]
    if (!ok || v != i + 1) {
      lost = lost + 1
    }
    i = i + 1
  }
  return lost
}

fn main() {
  print("alignEntries=${alignEntries()} alignMisses=${alignMisses()}\n")
  print("growLost=${growLost()}\n")
}
