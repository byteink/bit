// run
// SPEC §10.5, #3977: every `jsonDecode<T>` failure names the FIELD, by its full
// dotted path from the decoded root, and says which of four things went wrong.
//
// An application turns these into HTTP responses, so one "invalid JSON" is
// useless -- the caller cannot act on it. The four causes are asserted here one
// per line, each with the path it must carry:
//
//   * a missing key for a non-Option field
//   * a type mismatch, naming the field, the expected type and what was found
//   * an unknown key present in the input
//   * nesting past the decode depth bound
//
// A NESTED FAILURE REPORTS THE FULL PATH, NOT THE LEAF. `addr.postcode` and
// `crumbs[1].postcode` are the assertions that matter here: a decoder that
// reported `postcode` would be useless in a document with three addresses in
// it, and it would still pass a test that only checked the leaf name.
//
// THE DEPTH BOUND IS TESTED AT 10000 LEVELS, and the value is built here rather
// than parsed: `jsonParse` refuses past `jsonMaxDepth` in its LEXER, so a
// parsed document can never reach this walk's own bound. The bound has to hold
// for a `Json` built any other way, which is what this asserts -- and it fails
// with an error rather than exhausting the stack.
import { Json, JsonEntry, jsonParse, jsonDecode } from "std/json"
import { JsonDecodeError, JsonDecodeCause } from "std/json"

@json class Addr {
  city: string
  @key("post_code")
  postcode: string
}

@json class User {
  id: i64,
  addr: Addr,
  crumbs: []Addr,
}

// A self-referential `@json` class: the depth this decoder recurses to is
// INPUT-controlled, not bounded by the class, which is the whole reason a
// decode-side bound has to exist.
@json class Node {
  tag: string,
  next: Option<Node>,
}

fn decode(label: string, src: string) {
  let j = jsonParse(src) catch e {
    print("${label}: parse: ${e.message()}\n")
    return
  }
  let u = jsonDecode<User>(j) catch e {
    print("${label}: ${e.message()}\n")
    return
  }
  print("${label}: ok id=${u.id}\n")
}

fn deep(levels: i64) {
  let j = Json.JsonObject(
    [
      JsonEntry{ key: "tag", value: Json.JsonString("leaf") },
      JsonEntry{ key: "next", value: Json.JsonNull },
    ],
  )
  let i = 0
  while (i < levels) {
    j = Json.JsonObject(
      [
        JsonEntry{ key: "tag", value: Json.JsonString("n") },
        JsonEntry{ key: "next", value: j },
      ],
    )
    i = i + 1
  }
  let n = jsonDecode<Node>(j) catch e {
    let d = e.(JsonDecodeError)
    print("deep(${levels}): maxdepth=${isMaxDepth(d.cause)} segments=${pathSegments(d.path)}\n")
    return
  }
  print("deep(${levels}): ok tag=${n.tag}\n")
}

// The cause is a real enum a caller can branch on, not a string it has to
// scrape out of the message.
fn isMaxDepth(c: JsonDecodeCause): bool {
  match (c) {
    MaxDepth => return true
    MissingKey => return false
    TypeMismatch => return false
    UnknownKey => return false
  }
}

fn pathSegments(p: string): i64 {
  let n = 1
  let i = 0
  while (i < len(p)) {
    if (p[i:i + 1] == ".") {
      n = n + 1
    }
    i = i + 1
  }
  return n
}

fn main() {
  let ok = "{\"id\":1,\"addr\":{\"city\":\"c\",\"post_code\":\"p\"},\"crumbs\":[]}"
  decode("ok", ok)
  decode("missing-top", "{\"addr\":{\"city\":\"c\",\"post_code\":\"p\"},\"crumbs\":[]}")
  decode("missing-nested", "{\"id\":1,\"addr\":{\"city\":\"c\"},\"crumbs\":[]}")
  decode(
    "mismatch-top",
    "{\"id\":\"x\",\"addr\":{\"city\":\"c\",\"post_code\":\"p\"},\"crumbs\":[]}",
  )
  decode("mismatch-nested", "{\"id\":1,\"addr\":{\"city\":\"c\",\"post_code\":3},\"crumbs\":[]}")
  decode(
    "mismatch-in-array",
    "{\"id\":1,\"addr\":{\"city\":\"c\",\"post_code\":\"p\"},\"crumbs\":[{\"city\":\"a\",\"post_code\":\"b\"},{\"city\":\"a\",\"post_code\":7}]}",
  )
  decode(
    "unknown-top",
    "{\"id\":1,\"addr\":{\"city\":\"c\",\"post_code\":\"p\"},\"crumbs\":[],\"nope\":1}",
  )
  decode(
    "unknown-nested",
    "{\"id\":1,\"addr\":{\"city\":\"c\",\"post_code\":\"p\",\"zip\":1},\"crumbs\":[]}",
  )
  // The `@key` rename is what is on the wire: the FIELD name is not accepted.
  decode(
    "field-name-not-key",
    "{\"id\":1,\"addr\":{\"city\":\"c\",\"postcode\":\"p\"},\"crumbs\":[]}",
  )
  decode("not-an-object", "[1,2]")
  decode("field-not-an-object", "{\"id\":1,\"addr\":3,\"crumbs\":[]}")
  deep(3)
  deep(10000)
}
