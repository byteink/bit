// panic-debug
// #3087 (epic #3076): arm64/x64 `--debug` builds emit an overflow-checked
// signed negation (#3081/#3083) that must TRAP when negating a runtime i64
// MIN, the one value that overflows on negation (SPEC §13.5). `minRuntime()`
// routes the value through a non-foldable subtraction (`one()`, from
// `len(args())`) so `compiler/optfold.bit`'s `foldAddSubMul` cannot resolve
// either the subtraction that builds it or the negation below as
// compile-time constants. Sibling of overflow_trap_neg_release.bit: the
// identical expression, built WITHOUT `--debug`, where the same overflow
// must silently wrap instead.
import { args } from "std/os"

fn one(): int { return len(args()) }

// i64 MIN. Built as MAX-negated-minus-`one()` rather than the bare literal
// -9223372036854775808 -- routing through `one()` (a non-constant call)
// keeps this whole expression, and the negation below, out of the constant
// folder's reach.
fn minRuntime(): int { return -9223372036854775807 - one() }

fn main() {
  print("start\n")
  print("neg=${-minRuntime()}\n")
  print("unreachable\n")
}
