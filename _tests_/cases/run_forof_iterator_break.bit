// run
// `break` inside `for x of it`, where `it`'s type declares `next(): Option<T>`,
// stops the loop. `Counter.calls` counts only the `next()` calls that returned
// `Some`, so printing it after `break` tells "stopped early" (3) from "drained
// the iterator and ignored the tail" (6). `total` and `breakAt` come from `len`
// of a slice built at run time so the constant folder cannot leave a probe that
// passes by never running the loop.
class Counter {
  n: i64
  calls: i64
  next(): Option<i64> {
    if (this.n <= 0) {
      return Option.None
    }
    this.calls = this.calls + 1
    this.n = this.n - 1
    return Option.Some(this.n)
  }
}

fn main() {
  let sizer = [1, 1, 1, 1, 1, 1]
  let total: i64 = len(sizer)
  let breakAt = total / 2
  let it = Counter{ n = total, calls = 0 }
  for x of it {
    if (x == breakAt) {
      break
    }
  }
  print("calls=${it.calls} total=${total}\n")
}
