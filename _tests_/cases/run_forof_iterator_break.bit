// run
// #5563 (epic #4107): `break` inside `for x of it` where `it`'s type
// declares `next(): Option<T>` (docs/reference/iterator-trait.md,
// "Open questions for the children" — the doc only asserted this needs no
// lowering change beyond the four built-ins; this fixture is the proof).
//
// `Counter.calls` counts only the `next()` calls that returned `Some`, so
// printing it after `break` proves the loop stopped early and the
// iterator's remaining elements were never consumed. Printing only the sum
// of `x` values seen would not distinguish "stopped early" from "consumed
// everything and ignored the tail", which is the trap this ticket calls out
// by name.
//
// `total`/`breakAt` come from `len` of a slice built at run time, not a
// literal, so the constant folder cannot turn this into a driver that
// passes by never running the loop.
class Counter {
  n: i64,
  calls: i64,
  next(): Option<i64> {
    if (this.n <= 0) {
      return Option.None
    }
    this.calls = this.calls + 1
    this.n = this.n - 1
    return Option.Some(this.n)
  }
}

fn main() {
  let sizer = [1, 1, 1, 1, 1, 1]
  let total: i64 = len(sizer)
  let breakAt = total / 2
  let it = Counter{ n: total, calls: 0 }
  for x of it {
    if (x == breakAt) {
      break
    }
  }
  print("calls=${it.calls} total=${total}\n")
}
