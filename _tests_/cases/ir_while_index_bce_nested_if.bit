// ir
// #5971: a nested `if` whose then-arm falls through gives the loop's outer
// join two edges that pass the same value under two ids: the continuation's
// own param and the enclosing block's param. compiler/optbce.bit's
// `bceSameSource` compared raw ids, so the header's `len` param stopped
// resolving and the bounds check on `s[i]` stayed.
//
// `bceSameSource` resolves each edge argument through single-source params
// before comparing, and bb2 becomes `jump bb3()` with no `icmp_ult` and no
// panic block. Unconditional since the 0.31.0 repin (#6000) deleted the
// escape hatch this used to sit behind; the golden harness pins this IR
// shape.

fn f(s: string): int {
  let breaks = 0
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c > '\r') {
      i = i + 1
      continue
    }
    if (c == '\n') {
      if (i == 0 || s[i - 1] != '\r') {
        return -1
      }
      breaks = breaks + 1
    }
    i = i + 1
  }
  return breaks
}
