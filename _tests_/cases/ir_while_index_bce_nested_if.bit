// ir
// #5971: a nested `if` whose then-arm falls through gives the loop's outer
// join two edges that pass the same value under two ids: the continuation's
// own param and the enclosing block's param. compiler/optbce.bit's
// `bceSameSource` compared raw ids, so the header's `len` param stopped
// resolving and the bounds check on `s[i]` stayed.
//
// With BIT_BCE_JOIN=1, `bceSameSource` resolves each edge argument through
// single-source params before comparing, and bb2 becomes `jump bb3()` with
// no `icmp_ult` and no panic block. The flag is OFF by default until the
// stage0 repin, and the golden harness runs every case at the default, so
// this pins the flag-off IR, where the check is still there. #5971 records
// the flag-on text this file changes to at the flip.

fn f(s: string): int {
  let breaks = 0
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c > '\r') {
      i = i + 1
      continue
    }
    if (c == '\n') {
      if (i == 0 || s[i - 1] != '\r') {
        return -1
      }
      breaks = breaks + 1
    }
    i = i + 1
  }
  return breaks
}
