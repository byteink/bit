// run
// #6567: the fallible `for x of it? { }` over an interface-typed iterable, which
// reaches `next()` through a vtable (`Op.CallIface`) rather than a direct call.
// `next()` fails on its 4th call; the loop stops there and the caller sees it.
import { args } from "std/os"

class Pages {
  n: i64
  calls: i64
  failAt: i64
  ran: i64
  next(): Option<i64>! {
    this.calls = this.calls + 1
    if (this.calls == this.failAt) {
      fail newError("page ${this.calls} failed")
    }
    if (this.n <= 0) {
      return Option.None
    }
    this.n = this.n - 1
    return Option.Some(this.n)
  }
}

interface Source {
  next(): Option<i64>!,
}

fn drain(it: Source): i64! {
  let sum: i64 = 0
  for x of it? {
    sum = sum + x
  }
  return sum
}

fn main() {
  let sizer = [1, 1, 1, 1, 1, 1]
  let it = Pages{ n = len(sizer), calls = 0, failAt = 4, ran = 0 }
  let msg = ""
  drain(it) catch e {
    msg = e.message()
  }
  print("calls=${it.calls} err=${msg}\n")
  let done = Pages{ n = len(sizer), calls = 0, failAt = -1, ran = 0 }
  let sum = drain(done) catch -1
  let repeat = drain(done) catch -1
  print("done=${sum} calls=${done.calls} repeat=${repeat}\n")
  let refs = Items{ n = len(sizer) }
  print("ref=${readItem(refs) catch -2}\n")
  refs.n = 0
  print("none=${readItem(refs) catch -2} again=${readItem(refs) catch -2}\n")
  refs.n = -1
  readItem(refs) catch e {
    print("ref error=${e.message()}\n")
    -2
  }
}

// #6791: a reference payload remains rooted across an allocating call, while
// None and failure keep their distinct paths through the same interface.
class Item { n: i64 }

interface ItemSource {
  item(): Option<Item>!,
}

class Items {
  n: i64
  item(): Option<Item>! {
    if (this.n < 0) {
      fail newError("item failed")
    }
    if (this.n == 0) {
      return Option.None
    }
    return Option.Some(Item{ n = this.n })
  }
}

fn readItem(s: ItemSource): i64! {
  match (s.item()?) {
    Some(v) => {
      // args builds a runtime-sized slice; consume it before first reading v.
      let argv = args()
      if (len(argv) == 0 || len(argv[0]) == 0) {
        panic("missing process arguments")
      }
      print("probe ")
      return v.n
    }
    None => return -1
  }
}
