// run
// #5334: SPEC §12.12 promises `<input disabled />` and
// `<input disabled={true} />` mean the same thing - neither compiled before
// this ticket, since `attr` takes a `string` and the desugaring emitted a
// bare `true`. Both now desugar to the repeated-name form `attr(name,
// name)` (valid HTML for every boolean attribute), so the two renders below
// are IDENTICAL. A literal `={false}` renders NO attribute at all - in HTML
// the attribute's presence is the truth value, so `open="false"` would open
// a `<details>` same as `open` does. A string value and a `{expr}` string
// value (STRING_LIT and non-literal-bool `{expr}` forms) still render
// unchanged. `disabled={flag}` for a runtime bool is NOT covered - the
// desugarer can see a literal, not a runtime value's type (#5324).
import { render, elem, attr, text } from "../../pkg/web"

fn main() {
  println(render(<input disabled />))
  println(render(<input disabled={true} />))
  println(render(<input disabled={false} />))
  println(render(<details open><summary>ok</summary></details>))
  println(render(<input class="x" />))
  println(render(<input title={"y"} />))
}
