// run
// #6686: a plain free fallible function returns its error as the LAST return
// word (BIT_ERR_REG), and a direct caller tests the `Op.CallWord` that binds
// it instead of reading the per-task slot. The program prints the same lines
// with the flag off and on; `BIT_ERR_REG=1 ./make test-golden` is what runs
// the word path. One function per shape that produces or consumes the word:
//
//   1. `?` ok / `?` fail     the word crosses the branch, propagates on error
//   2. `catch d`, `catch e`  the join reads the word, the handler sees the error
//   3. `fail`                the boxed value is the last `ret` operand
//   4. `()!`, `f64!`, `(int, int)!`  the word follows no ok word, an Int ok
//                            word in d0/x0, and two ok words
//   5. a discarded call, `defer`, `spawn`  the word is bound or dropped, and
//                            never read
//   6. a fn value            the trampoline calls the free function
//   7. `f(g()?)?`            two words in one expression
//   8. a method, an interface method, an arrow  keep the slot (later tickets)
//
// A single-file golden gets no prelude, so the error type is declared locally.
class Neg {
  n: int
  message(): string { return "neg ${this.n}" }
}

enum Kind {
  Low,
  High,
}

fn digit(c: int): int! {
  if (c < 48 || c > 57) {
    fail Neg{ n = c }
  }
  return c - 48
}

fn unit(n: int): ()! {
  if (n < 0) {
    fail Neg{ n = n }
  }
}

fn half(n: int): f64! {
  if (n < 0) {
    fail Neg{ n = n }
  }
  return f64(n) / 2.0
}

fn pair(n: int): (int, int)! {
  if (n < 0) {
    fail Neg{ n = n }
  }
  return n, n * 3
}

// A C-like enum error is boxed (`errNeedsBox`), so the word is the box cell.
fn kind(n: int): int!Kind {
  if (n == 0) {
    fail Kind.Low
  }
  return n
}

fn sum(xs: []int): int! {
  let s = 0
  for x of xs {
    s = s + digit(x)?
  }
  return s
}

fn inc(n: int): int! {
  return n + 1
}

fn nested(c: int): int! {
  return inc(digit(c)?)?
}

fn viaUnit(n: int): ()! {
  unit(n)?
  unit(n - 1)?
}

fn viaPair(n: int): int! {
  let (a, b) = pair(n)?
  return a + b
}

fn shapeTry() {
  let r = sum([49, 50, 51]) catch -1
  print("try ok ${r}\n")
  let f = sum([49, 120, 51]) catch -1
  print("try fail ${f}\n")
  print("nested ${nested(53) catch -1} ${nested(10) catch -1}\n")
}

fn shapeCatch() {
  let d = digit(55) catch 0
  let e = digit(7) catch 0
  print("catch d ${d} ${e}\n")
  let m = digit(55) catch e {
    print("unreached ${e.message()}\n")
    -2
  }
  let n = digit(7) catch e {
    print("caught ${e.message()}\n")
    -2
  }
  print("catch e ${m} ${n}\n")
  let k = kind(0) catch e {
    print("kind low\n")
    -3
  }
  print("kind ${k} ${kind(4) catch -1}\n")
}

fn shapeWords() {
  viaUnit(2) catch e {
    print("unreached ${e.message()}\n")
  }
  viaUnit(0) catch e {
    print("unit fail ${e.message()}\n")
  }
  let h = half(7) catch -1.0
  let g = half(-7) catch -1.0
  print("f64 ${h} ${g}\n")
  let (a, b) = pair(4) catch (-1, -1)
  let (c, d) = pair(-4) catch (-1, -1)
  print("pair ${a} ${b} ${c} ${d} ${viaPair(5) catch -1} ${viaPair(-5) catch -1}\n")
}

// A discarded call: the word is bound and never read.
fn shapeDiscard() {
  digit(5) catch e {
  }
  unit(-1) catch e {
  }
  print("discarded\n")
}

fn deferred(n: int): int! {
  defer print("defer ${n}\n")
  let d = digit(n)?
  return d + 1
}

fn worker(n: int, out: chan<int>): ()! {
  out <- digit(n)?
}

// A deferred fallible call: its error word is dropped, and the function's own
// ok path is untouched by it.
fn deferredCall(n: int): int {
  defer {
    unit(n) catch e {
      print("deferred ${e.message()}\n")
    }
  }
  return n + 1
}

fn shapeDeferSpawn() {
  print("defer ok ${deferred(52) catch -1}\n")
  print("defer fail ${deferred(10) catch -1}\n")
  let out = chan<int>(1)
  spawn {
    worker(54, out) catch e {
      out <- -7
    }
  }
  print("spawned ${<- out}\n")
  print("deferred call ${deferredCall(2)} ${deferredCall(-2)}\n")
}

type F = (int) => int!

fn callThrough(f: F, n: int): int {
  return f(n) catch -9
}

// Slot-convention callees: a method, an interface method and an arrow.
interface Source {
  pull(n: int): int!,
}

class Impl {
  k: int
  pull(n: int): int! {
    if (n < 0) {
      fail Neg{ n = n }
    }
    return n + this.k
  }
}

fn viaIface(s: Source, n: int): int! {
  return s.pull(n)?
}

fn shapeOthers() {
  print("fnval ${callThrough(digit, 56)} ${callThrough(digit, 1)}\n")
  let i = Impl{ k = 10 }
  print("method ${i.pull(2) catch -1} ${i.pull(-2) catch -1}\n")
  print("iface ${viaIface(i, 3) catch -1} ${viaIface(i, -3) catch -1}\n")
  let arrow: F = (n) => digit(n + 48)
  let arrowFail: F = (n) => {
    return digit(n)?
  }
  print("arrow ${callThrough(arrow, 4)} ${callThrough(arrowFail, 4)}\n")
}

fn main() {
  shapeTry()
  shapeCatch()
  shapeWords()
  shapeDiscard()
  shapeDeferSpawn()
  shapeOthers()
}
