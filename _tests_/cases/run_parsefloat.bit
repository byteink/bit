// run
// #2130: std/strings had no float parser — only the predeclared,
// non-fallible `parseFloat` builtin (SPEC §5.3), fixed by #2138 to yield a
// quiet NaN on bad input instead of silently returning 0. This exercises the
// fallible `std/strings.parseFloat` wrapper, which delegates to that builtin
// and fails whenever it returns NaN.
import { parseFloat } from "std/strings"

fn isNan(v: f64): bool {
  return v != v
}

fn mustOk(label: string, s: string, want: f64): f64 {
  let v = parseFloat(s) catch e {
    panic("parseFloat(\"${s}\") should have succeeded, got error: ${e.message()}")
  }
  assert(v == want, "${label}: parseFloat(\"${s}\") = ${v}, want ${want}")
  println("${label} ok: ${v}")
  return v
}

fn mustFail(label: string, s: string) {
  let v = parseFloat(s) catch e {
    println("${label} rejected: ${e.message()}")
    return
  }
  panic("parseFloat(\"${s}\") should have failed, got ${v}")
}

fn main() {
  // The ticket's own acceptance list.
  mustOk("basic", "1234.56", 1234.56)
  mustOk("zero", "0", 0.0)
  mustFail("empty", "")
  mustFail("garbage", "not a number")
  mustFail("trailing_junk", "12abc")

  // Folded in from #2142: negative + fractional (the case a naive
  // multiply-accumulate parser gets wrong — it returned -0.25000000000000006
  // for this input instead of round-tripping exactly), integer-shaped input,
  // exponent form, and a malformed-but-numeric-looking input distinct from
  // "12abc"'s trailing junk.
  mustOk("negative_fraction", "-0.25", -0.25)
  mustOk("positive_fraction", "3.5", 3.5)
  mustOk("integer_shaped", "42", 42.0)
  mustOk("exponent", "1e3", 1000.0)
  mustFail("two_dots", "1.2.3")

  // Boundaries.
  mustFail("bare_minus", "-")
  mustFail("bare_plus", "+")
  mustFail("nan_spelling", "NaN")
  mustFail("inf_spelling", "Inf")
  mustFail("inf_spelling_lower", "inf")
  mustFail("neg_inf_spelling", "-inf")
  mustFail("leading_space", " 1.5")
  mustFail("trailing_space", "1.5 ")

  // Overflow/underflow round to +-Inf / 0 under IEEE 754 (a correctly-rounded
  // conversion result), not a parse failure — same as the builtin's contract.
  let posInf = 1.0 / 0.0
  mustOk("overflow_to_inf", "1e400", posInf)
  mustOk("underflow_to_zero", "1e-400", 0.0)

  // A value whose shortest decimal form round-trips through parse + format.
  let pi = "3.14159265358979"
  let v = parseFloat(pi) catch e {
    panic("parseFloat(\"${pi}\") should have succeeded, got error: ${e.message()}")
  }
  assert("${v}" == pi, "roundtrip: ${v} formatted back to \"${v}\", want \"${pi}\"")
  println("roundtrip ok: ${v}")
}
