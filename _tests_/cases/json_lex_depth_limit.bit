// run
// stdlib/json/lex.bit's combined `{`/`[` depth cap (#1479, #1718): one open
// past `jsonMaxDepth` must yield an `Invalid` token, not a stack overflow or
// hang.
//
// Used to redeclare the lexer and a stale `jsonMaxDepth = 64` locally on the
// stated belief that "a golden case is single-file with no prelude and
// cannot import std/json". That belief is false (#2421): `_tests_/bit/golden.bit`'s
// `checkRun` runs `bit build <case>` with `BIT_STDLIB` exported, so the
// import below resolves exactly as it would for any other caller. The local
// copy's cap had also drifted from the module's (#3041) — the real
// `jsonMaxDepth` is 128, raised from 64 in #2256 and capped in #2345 — so the
// input is now derived from the imported constant instead of a literal, and
// stays correct across any future change to the cap.
//
// Builds `[` * (jsonMaxDepth + 1) + `]` * (jsonMaxDepth + 1) (one nesting
// level past the cap) and asserts: the scan completes (proves no recursion /
// no unbounded stack growth), the token count is exactly opens + closes + 1
// Eof, and exactly one token in the stream is `Invalid` — the open past the
// cap. Every closer still decrements cleanly, none of them going negative or
// crashing.
import { TokenKind, Token, lex, jsonMaxDepth } from "std/json"

fn itoa(n: int): string {
  if (n == 0) {
    return "0"
  }
  let digits = "0123456789"
  let s = ""
  let v = n
  while (v > 0) {
    let d = v % 10
    s = digits[d:d + 1] + s
    v = v / 10
  }
  return s
}

fn main() {
  let opens = jsonMaxDepth + 1
  let src = ""
  let i = 0
  while (i < opens) {
    src = src + "["
    i = i + 1
  }
  i = 0
  while (i < opens) {
    src = src + "]"
    i = i + 1
  }

  let toks = lex(src)

  let invalidCount = 0
  for t of toks {
    if (t.kind == TokenKind.Invalid) {
      invalidCount = invalidCount + 1
    }
  }

  print("tokens=" + itoa(len(toks)) + "\n")
  print("invalid=" + itoa(invalidCount) + "\n")
}
