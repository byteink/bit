// run
// SPEC §10.5, #7094/#6979: a class field default may be a slice or map
// literal, or `[]T(n)`, whose elements, keys and values are themselves
// constants. It is rebuilt at EVERY construction site, so two values never
// share a backing store; and an empty map default is a live map, not nil, so
// the first write does not panic.
class Config {
  export scopes: []string = ["openid", "email", "profile"],
  export tags: []string = [],
  export sized: []int = []int(0),
  export headers: map<string, string> = {},
  export limits: map<string, int> = { "rps": 10, "burst": 20 },
  export grid: [][]int = [[1, 2], []],
}

class Box<T> {
  export items: []T = [],
}

fn main() {
  let a = Config{}
  let b = Config{}

  // The sharing case: mutate every default of `a`, then read `b`.
  a.scopes[0] = "changed"
  a.scopes = append(a.scopes, "extra")
  a.tags = append(a.tags, "t")
  a.headers["k"] = "v"
  a.limits["rps"] = 99
  a.grid[0][0] = 7
  a.grid[1] = append(a.grid[1], 5)

  print("a: ${len(a.scopes)} ${a.scopes[0]} ${len(a.tags)} ${len(a.headers)} ${a.limits["rps"]} ${a.grid[0][0]} ${len(a.grid[1])}\n")
  print("b: ${len(b.scopes)} ${b.scopes[0]} ${b.scopes[1]} ${b.scopes[2]} ${len(b.tags)} ${len(b.sized)}\n")
  print("b: ${len(b.headers)} ${b.limits["rps"]} ${b.limits["burst"]} ${b.grid[0][0]} ${len(b.grid[1])}\n")

  // The map default is live: the first write on a fresh value must not panic.
  let c = Config{}
  c.headers["X-Run"] = "7"
  print("c: ${c.headers["X-Run"]}\n")

  // An explicit value still wins, and `[]T(n)` zero-fills.
  let d = Config{ scopes = ["only"] }
  print("d: ${len(d.scopes)} ${d.scopes[0]}\n")
  let zs = []Config(2)
  zs[0].tags = append(zs[0].tags, "z")
  print("zs: ${len(zs[0].scopes)} ${len(zs[0].tags)} ${len(zs[1].tags)}\n")

  let x = Box<int>{}
  let y = Box<int>{}
  x.items = append(x.items, 1)
  print("box: ${len(x.items)} ${len(y.items)}\n")
}
