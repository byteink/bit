// fmt
// SPEC §10.5, #3838: a class field default round-trips as `name: type = expr`,
// one space either side of `=` -- the same spelling a `let` initializer gets.
// The `readonly` modifier and the default compose in declaration order, and a
// field with no default keeps its exact previous rendering.
class Opts {
  port: int = 8080,
  host: string = "127.0.0.1",
  maxBody: int = 1000 * 1024,
  readonly tag: int = 1 + 2,
  tls: bool,
}

fn main() {
  print("${Opts{}.port}\n")
}
