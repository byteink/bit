// panic
// #5971: the limit grows through the loop's join, not on the back edge
// itself. `n` reaches the join as `n` from the false arm and `n + 1` from
// the true arm, so `i < n` stops implying `i < len(w)` after the third byte
// and the bounds check on `w[i]` must survive and fire at `i == 3`.
// compiler/optbce.bit's `bceSameSource` must refuse the join because its two
// edges disagree. A version that accepts any two ids resolves `n` to
// `len(w)`, drops the check, reads past the end of `w` and exits 0, which is
// what this expected output rejects. `w` is a parameter so that the header's
// limit and the check's length both come from its `len` word.
fn sum(w: string): int {
  let n = len(w)
  let i = 0
  let t = 0
  while (i < n) {
    t = t + int(w[i])
    if (i > 0) {
      n = n + 1
    }
    i = i + 1
    if (i > 6) {
      return t
    }
  }
  return t
}

fn main() {
  println("${sum("abc")}")
}
