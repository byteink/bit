// run
// SPEC 11.9: a CALL to an `@symbol`-pinned function must spell the pinned name,
// the same one its definition is emitted under (#1410).
//
// The pin bypasses module qualification, so the definition below is emitted as
// `bit_pinned_case` rather than `pinnedCase`. Lowering applied the pin to the
// definition but not to call sites, so the object defined `bit_pinned_case` and
// referenced `pinnedCase` — a name nothing defines. It fails far from its
// cause: dead-stripped when unreferenced, and on Darwin it falls through to a
// libSystem import and aborts at dyld load rather than failing the link. Hence
// a `// run` case: only executing the linked binary proves the two agree.
//
// RECURSIVE on purpose, twice over. A small leaf body is spliced into the
// caller by the inliner and a spliced call emits no symbol at all, so a
// non-recursive callee would let a mis-spelled call site slide. Recursion also
// puts a SELF-call inside the pinned body, which has to resolve to the pinned
// name as well.
@symbol("bit_pinned_case") fn pinnedCase(n: i64): i64 {
  if (n <= 0) {
    return 0
  }
  return n + pinnedCase(n - 1)
}

// The CONTROL: same shape, no pin, so it keeps its ordinary name. It fails if
// the pin ever starts leaking onto unpinned declarations.
fn plainCase(n: i64): i64 {
  if (n <= 0) {
    return 0
  }
  return n + plainCase(n - 1)
}

fn main() {
  print("${pinnedCase(8)} ${plainCase(8)}\n")
}
