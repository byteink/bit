// run
// #6320: classinit.bit's parseInitMember has the same recv-after-body
// arena-order bug #6113 fixed in parsertype.bit's parseMethodMember —
// `catch e { ... }` on a call reached through `this.field.method(...)`
// INSIDE an `init(...)` body mistyped `e` as the predeclared `error`
// interface instead of the callee's own declared error type (a
// `match (e) { ... }` on the real variants then failed E0069, "'match'
// requires an enum subject"). Root cause: classinit.bit's parseInitMember
// minted the desugared constructor's `Tag.Receiver` node AFTER parsing the
// body, so checkmodule.bit's ascending arena-order pre-pass (bindCatchType)
// asked for `this`'s type before bindParamOrReceiver had bound it.
export enum MyErr {
  Bad(string)
  Sad

  message(): string {
    match (this) {
      Bad(msg) => return "bad: ${msg}"
      _ => return "sad"
    }
  }
}

class Runner {
  get(v: i64, ok: bool): i64!MyErr {
    if (ok) {
      return v
    }
    fail MyErr.Bad("nope")
  }
}

class Holder {
  runner: Runner
  value: i64

  init(v: i64, ok: bool) {
    let x = this.runner.get(v, ok) catch e {
      match (e) {
        Bad(msg) => {
          print("caught bad: ${msg}\n")
          this.value = -1
          return
        }
        Sad => {
          print("caught sad\n")
          this.value = -2
          return
        }
      }
    }
    this.value = x
  }
}

fn main() {
  let a = Holder(7, true)
  print("ok=${a.value}\n")
  let b = Holder(7, false)
  print("ok=${b.value}\n")
}
