// lint exit=1
// #5247 E0218 covers ALL THREE relation kinds, not just `@hasMany`:
// `fieldRelationAttr` (compiler/classrelationattr.bit) answers "is this
// field a relation?" identically for `@hasMany`/`@hasOne`/`@belongsTo` --
// this rule never inspects the field's own []T/class-typed SHAPE. That
// matters here more than for `@hasMany`: #5271's runtime sentinel
// (compiler/classrelationattr.bit's `fieldNeedsUnloadedSentinel`) is scoped
// to `[]T` fields only, so reading an unrequested `@hasOne`/`@belongsTo`
// field does NOT panic at run time (pkg/orm/relation.bit's own header) --
// this compile-time finding is the ONLY protection these two kinds have.
import { Data, find } from "orm"
import { FieldDesc, Rows } from "std/sql"

@table class Profile {
  @id
  id: i64
}

@table class User {
  @id
  id: i64
  @hasOne("userId")
  profile: Profile
}

fn userMapper(rows: Rows): User! {
  // A class-typed relation field has no zero value in Bit, so the mapper
  // must supply a placeholder even when not loading it (pkg/orm/docs/relation.md).
  return User{ id: 1, profile: Profile{ id: 0 } }
}

fn report(db: Data, id: i64): ()! {
  let u = find<User>(db, "users", []FieldDesc(0), userMapper).oneOrFail()?
  print("${u.profile.id}\n")
}
