// lint exit=1
// #5247 E0218 covers ALL THREE relation kinds, not just `@hasMany`:
// `fieldRelationAttr` (compiler/classrelationattr.bit) answers "is this
// field a relation?" identically for `@hasMany`/`@hasOne`/`@belongsTo` --
// this rule never inspects the field's own []T/class-typed SHAPE. Since
// #6290, #5271's runtime sentinel (compiler/classrelationattr.bit's
// `fieldNeedsUnloadedSentinel`) covers a bare-class `@hasOne`/`@belongsTo`
// target too, so this compile-time finding is an early warning of the same
// panic, not the only protection these two kinds have.
import { Data, find } from "orm"
import { FieldDesc, Rows } from "std/sql"

@table class Profile {
  @id
  id: i64
}

@table class User {
  @id
  id: i64
  @hasOne("userId")
  profile: Profile
}

fn userMapper(rows: Rows): User! {
  // Omitting `profile` here would compile too (#6290: it gets the "unloaded"
  // sentinel, not a null reference) -- a placeholder is given anyway to
  // match this fixture's loaded-with sibling (lint_relation_loaded_with_hasone.bit).
  return User{ id = 1, profile = Profile{ id = 0 } }
}

fn report(db: Data, id: i64): ()! {
  let u = find<User>(db, "users", []FieldDesc(0), userMapper).oneOrFail()?
  print("${u.profile.id}\n")
}
