// lint exit=0
// bit:lint max-nesting=6 -- reason
fn f(a: int): int {
  let t = 0
  while (a > 0) { while (a > 0) { while (a > 0) { while (a > 0) { while (a > 0) { t = t + 1; a = a - 1 } } } } }
  // bit:fmt something else entirely -- another tool's directive, skipped here
  return t
}
fn main() { print("${f(0)}\n") }
