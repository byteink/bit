// ir
// #3517: constant propagation across BLOCK PARAMS (compiler/optparams.bit).
//
// `sweepConsts` is one forward walk and is correct in a single pass only
// because an operand's def index is always below its use's. A block param has
// no such guarantee — its incoming arguments come from predecessor terminators
// — so a value that is the same constant on every incoming edge used to reach
// codegen as a live `br` on a statically-known condition. #2378's flag-guarded
// `defer` lowering is what made it expensive (the "already ran" flag is a
// `const_bool` in the entry block that arrives at its guard through a param),
// but nothing here uses `defer`: the mechanism is the ordinary local-threading
// every branch does, and pinning it on `defer` would tie this fixture to defer
// LOWERING, which is a separate moving part.
//
// THE FIXTURE FAILS IN BOTH DIRECTIONS, which is the point of pairing the two
// functions below:
//
//   `oneEdge`  — `flag` reaches its guard through a param with ONE predecessor
//                edge, carrying `const_bool true`. The `br` must be a `jump`
//                and `return 3` must be gone. If the pass goes dark this
//                regrows a `br` and a block.
//   `twoEdges` — the same shape with TWO predecessor edges carrying DIFFERENT
//                constants (`false` from the entry, `true` from the guarded
//                branch). The `br` must SURVIVE. A pass that promotes a param
//                on partial agreement — or on no predecessor at all — folds
//                this one and returns the wrong answer for `c == false`.
//
// tests/cases/run_defer_sibling_branches.bit is the semantic half: it runs the
// program and counts the deferred calls.

fn oneEdge(c: bool): i64 {
  let flag = true
  if (c) {
    return 1
  }
  if (flag) {
    return 2
  }
  return 3
}

fn twoEdges(c: bool): i64 {
  let flag = false
  if (c) {
    flag = true
  }
  if (flag) {
    return 1
  }
  return 2
}
