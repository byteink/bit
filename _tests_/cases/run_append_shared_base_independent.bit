// run
// #6092: two independent `append()` calls on the SAME base slice must not
// corrupt each other's `len()`. `x` and `y` below are two independent
// results of `append(base, 100)` on the same `base` — an entirely ordinary
// "build several derived slices off one shared prefix" pattern — and `base`
// is never reassigned between them. Before #6092, `rtSliceAppend` mutated
// `base`'s own header in place on every call, so `x`, `y`, `z` and `base`
// all ended up aliasing the exact one header object: `len(x)` read 3 (not 2)
// the moment `y` was built, and reading `z[2]` after `append(y, 200)` read
// 100 (the stale value `y`'s own append had written into the shared buffer)
// instead of 200.
fn main() {
  let base = []int(0)
  base = append(base, 1)

  let x = append(base, 100)
  print("after x: len(x)=${len(x)}\n")

  let y = append(base, 100)
  print("after y: len(x)=${len(x)}\n")

  let z = append(y, 200)
  print("after z: len(z)=${len(z)} z2=${z[2]}\n")
  print("after z: len(y)=${len(y)}\n")
  print("after z: len(x)=${len(x)}\n")
}
