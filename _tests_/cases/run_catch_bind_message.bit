// run
// #4475: `catch e { ... e.message() }` segfaulted at run time whenever the
// error path was actually taken and the failed value was a bare `string` —
// `bit check` rc=0, released 0.12.0 and main both `bit: fatal signal:
// segmentation fault`, exit 2. The cause was not the binder: `vStmt`'s
// `Tag.FailStmt` arm only asked whether the enclosing function was fallible,
// so the `fail` OPERAND was never judged against the function's error type E,
// and `lowerFail` wrote a raw string word into the one-machine-word error
// slot that `e.message()` then dispatched an interface call through.
// error_fail_operand_not_assignable.bit pins the rejection; this case pins
// that every legitimate shape still runs.
//
// A single-file golden gets NO prelude, so `newError` (stdlib/core) is
// unavailable here and the error type is declared locally — the same reason
// check_catch_binds_error_type.bit declares its own.
//
// Four rows, each one from the ticket's matrix:
//   caught/interp   the reported repro, read through a `${}` interpolation
//   caught/let      the same read split onto its own `let` statement
//   value catch     a non-void `i64!`, where the block must produce a value
//   never fires     the ok path, which was always correct — the control
class TooShort {
  n: i64
  message(): string { return "too short (${this.n})" }
}

fn short(s: string): ()! {
  if (len(s) < 3) {
    fail TooShort{ n: len(s) }
  }
}

fn width(s: string): i64! {
  if (len(s) < 3) {
    fail TooShort{ n: len(s) }
  }
  return len(s)
}

fn main() {
  short("ab") catch e {
    print("interp: ${e.message()}\n")
  }
  short("ab") catch e {
    let m = e.message()
    print("let: ${m}\n")
  }
  let v = width("ab") catch e {
    print("value: ${e.message()}\n")
    -1
  }
  print("v=${v}\n")
  short("abcd") catch e {
    print("unreached: ${e.message()}\n")
  }
  let w = width("abcd") catch e {
    print("unreached: ${e.message()}\n")
    -1
  }
  print("w=${w}\n")
  print("done\n")
}
