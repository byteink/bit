// run
// #2733: the checker used to type an arrow parameter from an unrelated
// generic helper's parameter of the same name, printing `error[E0053]:
// operator not defined for 'i64' and 'T'`. An arrow parameter is now a new
// binding, so this must compile and run.
//
// `leaf`'s type parameter `T` and its own parameter `v` are deliberately
// unused and deliberately declared AFTER `main`, so the checker cannot have
// seeded the arrow parameter's type from a declaration it has not seen yet
// were it not for a fix that makes the arrow parameter a genuinely new
// binding regardless of source order.
fn apply(a: int, f: (int, int) => int): int {
  return f(a, 1)
}

fn main() {
  print("r=${apply(1, (a, v) => a + v)}\n")
}

fn leaf<T>(v: T): T {
  return v
}
