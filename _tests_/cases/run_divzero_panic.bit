// panic
// #2016: `n / 0` must panic (SPEC §13.5, §18.4) rather than silently
// returning 0. The divisor comes from `len(args())` so it cannot fold at
// compile time -- neither the optimizer nor a future compile-time-zero
// diagnostic can retire this case, only a real runtime check can.
import { args } from "std/os"

fn zero(): int { return len(args()) - 1 }

fn main() {
  print("start\n")
  print("div=${7 / zero()}\n")
  print("unreachable\n")
}
