// run
// SPEC §10.5, #6081/#6091/#6099: `@job("name")` synthesizes a `static
// __jobName(): string`, read with NO instance in hand -- the zero-instance
// dispatch shape epic #4023's 2026-09-27 owner decision settled, and the
// gap #6081's engineer report left open until static methods (#6091/#6099,
// default ON since #6189) closed it. `nameOf<T: Job>()` below is exactly
// the ticket's own acceptance: a generic function reads each of two
// distinct `@job` classes' stable dispatch names off a type parameter
// alone, through `T.__jobName()`, never through a value of type `T`.

interface Job {
  static __jobName(): string,
}

import { Json } from "std/json"

@job("send-welcome") @json class SendWelcome {
  userId: i64,
}

@job("generate-invoice") @json class GenerateInvoice {
  orderId: i64,
}

fn nameOf<T: Job>(): string {
  return T.__jobName()
}

fn main() {
  print("${nameOf<SendWelcome>()}\n")
  print("${nameOf<GenerateInvoice>()}\n")
}
