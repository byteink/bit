// panic
// #6840: the guard bounds `a`, the read is from the shorter `b`. A window
// proves an index only against the very length its header tested, so the
// check on `b[i + 1]` must stay and fire at `i == 2`.
fn main() {
  let a = "abcdef"
  let b = "xyz"
  let i = 0
  while (i + 1 < len(a)) {
    eprint("i=${i} b=${b[i + 1]}\n")
    i = i + 1
  }
  eprint("unreachable\n")
}
