// run
// #4406: a keepalive edge keeps an exploded aggregate's TRACED word live for as
// long as any word derived from it, so the collector still names the backing
// object at a safepoint the derived word crosses.
//
// WHY THIS SHAPE IS EXPRESSIBLE TODAY, before `string` is exploded (#4411).
// `explodedWordTypes` (compiler/lowerexplode.bit) admits a tuple whose members
// are each one 8-byte field, and `*T` (SPEC §11.4) is one word `isRefType`
// reports as NOT a GC reference. `ptrOf(s)` is a raw pointer to element 0 of
// `s`'s buffer, so `(ptrOf(s) + 1, s)` is exactly the `{ptr, base}` shape
// `runtime/ABI.md` §2.3 gives a string: word 0 an INTERIOR address, word 1 the
// only thing that roots it.
//
// WHY IT IS A WRONG ANSWER AND NOT A CRASH. The backing is swept and its slot
// handed to the next allocation of the same size class, which zeroes it. So the
// read through the stale interior pointer returns 0 at exit 0 — the failure
// this file exists to catch prints a plausible number, and a fixture that only
// checked for a crash could not see it.
//
// WHY CONSERVATIVE SCANNING DOES NOT COVER IT. `gcOwns`
// (runtime/gc/gcalloc.bit) is exact base equality, so an interior word found on
// the stack roots nothing. The control for that claim is `basePointerControl`
// below: the identical program with `+ 0` instead of `+ 1` prints the right
// answer even with the keepalive removed, because THAT word is a base pointer.
// If this file ever starts passing for the wrong reason, that arm is where to
// look first.
//
// The two arms above `localCtor` each produce a WRONG ANSWER against a compiler
// with `extendKeepAlive` (compiler/codegenlive.bit) removed. `localCtor` does
// not: a pair built in the caller leaves the base in that frame, which root
// class 8's conservative scan of the live stack finds. It is regression
// coverage, not a mutant killer, and saying so here is the point.
//
// #4467 CHALLENGED `localCtor`'s "covered by the same edges" as an unproven
// claim, and the claim turned out to be TRUE — recorded here as a measurement
// so nobody has to take it on trust again. On `8dd3ad4e` the optimized IR for
// `localCtor` carries the edge `%28 <- %23`: store-to-load forwarding folds the
// tuple box away and `remapKeepAlive` (compiler/optrebuild.bit) re-points the
// pair at the surviving `add` and at `s`, so the base's interval already
// reached the dereference and no chain had to be followed. `ptrOf` ITSELF was
// the producer with no edge at all, which is a different hole in the same wall:
// `_tests_/cases/run_ptrof_interior_keepalive.bit` is that case, and it does
// kill its mutant.
extern fn bit_rt_port_stw_collections(): i64

// Enough allocation to drive the DEFAULT collector, so this case needs no
// `BIT_GC=stress` to fire. `main` asserts a collection really ran.
fn churn(n: i64) {
  let i = 0
  while (i < n) {
    let junk = []i64(8)
    atomicStore(ptrOf(junk), 7)
    i = i + 1
  }
}

// The loop keeps this out of the inliner's single-block budget, so the frame is
// genuinely popped and nothing conservative can see `s` afterwards.
fn mkPair(v: i64, off: i64): (*i64, []i64) {
  let s = []i64(8)
  let i = 0
  while (i < 1) {
    atomicStore(ptrOf(s) + off, v)
    i = i + 1
  }
  return (ptrOf(s) + off, s)
}

// Multi-word RETURN (#4405) read into an exploded LOCAL (#4410): the words
// arrive as `call` + `call_word`, and only word 0 is ever read again.
fn viaReturn(n: i64): i64 {
  let w = mkPair(1234, 1)
  churn(n)
  return *w.0
}

// Exploded PARAMETER (#4404): the callee reads word 0 only.
fn readOnlyPtr(w: (*i64, []i64), n: i64): i64 {
  churn(n)
  return *w.0
}

fn viaParam(n: i64): i64 {
  return readOnlyPtr(mkPair(4321, 1), n)
}

// The control: word 0 is the buffer's BASE address, which `gcOwns` accepts, so
// this arm is right with or without the keepalive.
fn basePointerControl(n: i64): i64 {
  let w = mkPair(777, 0)
  churn(n)
  return *w.0
}

// A pair built in THIS frame. Covered by the same edges — verified off
// `--dump-ir`, not argued; see the #4467 paragraph in the header. Masked today
// by the conservative scan on top of that, so it proves no mutant.
fn localCtor(n: i64): i64 {
  let s = []i64(8)
  let i = 0
  while (i < 1) {
    atomicStore(ptrOf(s) + 1, 555)
    i = i + 1
  }
  let w = (ptrOf(s) + 1, s)
  churn(n)
  return *w.0
}

fn main() {
  let n = 200000
  let before = int(bit_rt_port_stw_collections())
  let r = viaReturn(n)
  let p = viaParam(n)
  let b = basePointerControl(n)
  let l = localCtor(n)
  // Without this the case would pass vacuously the day the collector's growth
  // policy stops firing at this volume, and nothing would say so.
  if (int(bit_rt_port_stw_collections()) <= before) {
    panic("no collection ran: this case cannot fail as written")
  }
  print("viaReturn=${r} viaParam=${p} base=${b} localCtor=${l}\n")
}
