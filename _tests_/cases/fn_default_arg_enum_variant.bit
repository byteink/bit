// run
// #6271: a payload-free enum variant reference (`Dir.Asc`) as a parameter
// default (SPEC §10.3). Omitting the argument uses the variant default;
// supplying one overrides it.

enum Dir { Asc, Desc }

fn order(name: string, dir: Dir = Dir.Asc): string {
  if (dir == Dir.Asc) {
    return "${name} asc"
  }
  return "${name} desc"
}

fn main() {
  print("${order("name")}\n")
  print("${order("name", Dir.Desc)}\n")
}
