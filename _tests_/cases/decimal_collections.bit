// run
// #6570: a two-word `decimal` as a slice, array and map element. Before this
// `xs[i]` was refused (E0092) while `xs[0] = 3.5` compiled and stored through
// the one-word element path: a slice whose buffer was laid out at 8 bytes per
// element took the first word of the value, and a map recorded a pointer to a
// box the collector was never told to trace.
//
// A `[]decimal` and a `[N]decimal` element is 16 inline bytes and a map value
// is a boxed pair; every operation below checks the exact printed value, and
// the buffers are grown and reallocated so a copy that moves 8 bytes per
// element prints a wrong sum instead of passing.

class Ledger {
  items: []decimal,
}

fn total(xs: []decimal): decimal {
  let t: decimal = 0.0
  for x of xs {
    t += x
  }
  return t
}

fn scaled(xs: []decimal, by: decimal): []decimal {
  let out = []decimal(0)
  for x of xs {
    out = append(out, x * by)
  }
  return out
}

fn arrayTotal(a: [3]decimal): decimal {
  let t: decimal = 0.0
  for x of a {
    t += x
  }
  return t
}

fn arrayWithMiddle(a: [3]decimal, mid: decimal): [3]decimal {
  a[1] = mid
  return a
}

fn lookup(m: map<string, decimal>, key: string): decimal {
  return m[key]
}

fn sliceOps() {
  let xs = []decimal{ 1.5, 2.5, 4.5 }
  println("read ${xs[0]} ${xs[1]} ${xs[2]} len ${len(xs)}")
  xs[0] = 3.25
  xs[2] = -0.5
  println("write ${xs[0]} ${xs[1]} ${xs[2]}")
  xs[0] += 1.0
  xs[1] -= 4.0
  xs[2] *= 3.0
  println("compound ${xs[0]} ${xs[1]} ${xs[2]}")
  xs[0] /= 2.0
  println("divide ${xs[0]}")

  let i = 1
  xs[i] = 10.01
  xs[i + 1] += xs[i]
  println("computed index ${xs[i]} ${xs[i + 1]}")

  xs = append(xs, 7.75, 8.5)
  println("append len ${len(xs)} ${xs[3]} ${xs[4]} total ${total(xs)}")
  let zs = append([]decimal(0), ...xs)
  zs = append(zs, ...xs)
  println("spread len ${len(zs)} ${zs[5]} ${zs[9]} total ${total(zs)}")

  let part = zs[2:5]
  println("reslice len ${len(part)} ${part[0]} ${part[1]} ${part[2]}")
  part[1] = 99.5
  println("shared ${zs[3]}")

  let made = []decimal(4)
  println("zero ${made[0]} ${made[3]} total ${total(made)}")
  made[3] = 0.001
  println("made ${made[3]} ${total(made)}")

  let grown = []decimal(0)
  let n = 0
  while (n < 200) {
    let d: decimal = 0.5
    grown = append(grown, d * 3.0)
    n = n + 1
  }
  println("grown len ${len(grown)} first ${grown[0]} last ${grown[199]} total ${total(grown)}")
  println("returned ${total(scaled(xs, 2.0))}")

  for x of xs {
    println("of ${x}")
  }
  for (j, x) in xs {
    println("in ${j} ${x}")
  }
}

fn arrayOps() {
  let a = [3]decimal{ 1.5, 2.5, 4.5 }
  println("array read ${a[0]} ${a[1]} ${a[2]}")
  a[0] = 3.25
  a[2] += 0.5
  a[1] *= 2.0
  println("array write ${a[0]} ${a[1]} ${a[2]}")
  let b = a
  b[0] = 100.0
  println("copy ${a[0]} ${b[0]}")
  println("array total ${arrayTotal(a)} ${arrayTotal(b)}")
  let c = arrayWithMiddle(a, 8.75)
  println("passed ${a[1]} ${c[1]}")
  for x of a {
    println("array of ${x}")
  }
  let z: [3]decimal
  println("array zero ${z[0]} ${z[2]}")
}

fn mapOps() {
  let m = map<string, decimal>{ "a": 1.5, "b": 2.25 }
  println("map read ${m["a"]} ${m["b"]} len ${len(m)}")
  m["a"] = 7.5
  m["c"] = 0.125
  println("map write ${m["a"]} ${m["c"]} len ${len(m)}")
  m["a"] += 1.0
  m["b"] *= 2.0
  m["c"] -= 0.5
  println("map compound ${m["a"]} ${m["b"]} ${m["c"]}")
  println("map miss ${m["zz"]} len ${len(m)}")
  let (v, ok) = m["b"]
  let (w, ok2) = m["nope"]
  println("comma ok ${v} ${ok} ${w} ${ok2}")
  println("map passed ${lookup(m, "a")}")
  let sum: decimal = 0.0
  for (_, x) of m {
    sum += x
  }
  println("map total ${sum}")
  let big = map<int, decimal>()
  let i = 0
  while (i < 300) {
    let d: decimal = 1.5
    big[i] = d * 2.0
    i = i + 1
  }
  let bt: decimal = 0.0
  for (_, x) of big {
    bt += x
  }
  println("big map len ${len(big)} total ${bt}")
}

fn fieldOps() {
  let l = Ledger{ items = []decimal{ 1.5, 2.5 } }
  l.items[0] += 1.0
  l.items = append(l.items, 0.75)
  println("field ${l.items[0]} ${l.items[1]} ${l.items[2]} total ${total(l.items)}")
}

fn main() {
  sliceOps()
  arrayOps()
  mapOps()
  fieldOps()
}
