// run
// #4660, the second of two. Its sibling run_namespace_alias_shadowed.bit pins
// the symptom the CHECKER produced (a false E0057 on a chained call through a
// shadowed alias); this one pins the symptom the checker let through and only
// the IR verifier caught, so neither can mask the other in one file.
//
// `Wrap.trim` takes one parameter; `std/strings.trim(s, cutset)` takes two. With
// `nsQualifiedName` (compiler/checkproject.bit) answering from the scopeless,
// module-wide `c.namespaces` map, the checker typed this call off the imported
// module and accepted it — `bit check` exited 0 on 053046f2 — while the lowerer
// resolved the shadowing local's method, so `bit run` died with:
//
//   IR verification failed (1 violation(s)); refusing to emit a binary
//     main: %1 calls @m2$trim with 1 argument(s), but @m2$trim declares 2
//
// A checker and a lowerer disagreeing about the same call is the whole defect:
// the IR verifier was the only thing between that mismatch and a binary. Per
// SPEC §17.5 the nearer binding wins, so both must read `Wrap.trim`.

import strings from "std/strings"

class Wrap {
  n: int
  export trim(s: string): string {
    return "WRAP:${s}:${this.n}"
  }
}

fn main() {
  let strings = Wrap{ n: 3 }
  println(strings.trim("x"))
}
