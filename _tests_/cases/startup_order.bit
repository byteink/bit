// run
// #6480: module startup initializers run before `main`, imported modules first
// (a module's dependencies, then its importers in import order), then top to
// bottom within a module. `tick()` numbers each initializer as it runs, so the
// output below is the execution order: b (1, 2*10, 1+20), a (3, reads b's 1),
// c (4), this module (5), and `main` last (6).
import { tick } from "./startuporder_log"
import { aFirst, aSeenB } from "./startuporder_a"
import { bSum } from "./startuporder_b"
import { cFirst } from "./startuporder_c"

let rootFirst: int = tick()

fn main() {
  println("b sum=${bSum()}")
  println("a first=${aFirst} sawB=${aSeenB()}")
  println("c first=${cFirst}")
  println("root first=${rootFirst}")
  println("main tick=${tick()}")
}
