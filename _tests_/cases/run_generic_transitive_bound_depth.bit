// run
// #4657's no-false-positive side: every chain shape the transitive walk follows,
// with arguments that DO satisfy the bound at the end of it.
//
// `vInstDescend` (validateinst.bit) walks generic bodies the check pass never
// recorded an entry for, so anything it judges wrongly rejects a program the
// previous release accepts. That is the risk this file pins:
//
//   - `chain`/`deep` — the two- and three-deep chains the error case rejects,
//     with a `Tag` that satisfies `Named`.
//   - `viaSlot` — the empty-variadic-slot spelling, carrying a real element.
//   - `rec` — a generic that calls ITSELF before forwarding. The chain guard
//     (`vInstOnChain`) stops re-entry; stopping must not lose the judgement of
//     the forwarding call it already made.
//   - `ping`/`pong` — the same thing round a two-function cycle.
//   - `concrete` — a call inside a generic body whose argument is ALREADY
//     concrete. The check pass recorded it as its own entry, so the walk must
//     not descend into it (`vInstSubstArgs`) or the one violation would be
//     reported twice.
//   - `explicitArg` — type arguments written out at a call inside a generic body.
//   - `viaMethod` — a generic METHOD at the end of the chain (#4656).
//   - `anySlot` — an EMPTY interface bound, which `()` does satisfy.
//   - `d0` — a chain TEN deep, past `vInstMaxChain()`'s eight. Running out of
//     chain must stop the walk silently, exactly as Pass A1's `closureBudget`
//     does, and never reject.
//
// This file exits 0 on the binary built from the commit before the fix as well;
// it is a guard, not a behaviour change.
interface Named {
  label(): string,
}

interface Any {}

class Tag {
  export label(): string {
    return "tag"
  }
}

class Box {
  export mk<T: Named>(v: T): string {
    return v.label()
  }
}

fn inner<T: Named>(v: T): string {
  return v.label()
}

fn any<T: Any>(v: T): string {
  return "any"
}

fn mid<T>(v: T): string {
  return inner(v)
}

fn chain<T>(v: T): string {
  return mid(v)
}

fn deepA<T>(v: T): string {
  return mid(v)
}

fn deep<T>(v: T): string {
  return deepA(v)
}

fn slotMid<T>(...xs: T): string {
  for x of xs {
    return inner(x)
  }
  return "none"
}

fn viaSlot<T>(v: T): string {
  return slotMid(v)
}

fn rec<T>(v: T, n: i64): string {
  if (n <= 0) {
    return mid(v)
  }
  return rec(v, n - 1)
}

fn ping<T>(v: T, n: i64): string {
  if (n <= 0) {
    return mid(v)
  }
  return pong(v, n - 1)
}

fn pong<T>(v: T, n: i64): string {
  return ping(v, n - 1)
}

fn concrete<T>(v: T): string {
  return mid(Tag{})
}

fn explicitArg<T>(v: T): string {
  return mid<Tag>(Tag{})
}

fn viaMethodMid<T>(v: T): string {
  let b = Box{}
  return b.mk(v)
}

fn viaMethod<T>(v: T): string {
  return viaMethodMid(v)
}

fn anyMid<T>(v: T): string {
  return any(v)
}

fn anySlot<T>(...xs: T): string {
  return anyMid(xs)
}

fn d9<T>(v: T): string {
  return inner(v)
}

fn d8<T>(v: T): string {
  return d9(v)
}

fn d7<T>(v: T): string {
  return d8(v)
}

fn d6<T>(v: T): string {
  return d7(v)
}

fn d5<T>(v: T): string {
  return d6(v)
}

fn d4<T>(v: T): string {
  return d5(v)
}

fn d3<T>(v: T): string {
  return d4(v)
}

fn d2<T>(v: T): string {
  return d3(v)
}

fn d1<T>(v: T): string {
  return d2(v)
}

fn d0<T>(v: T): string {
  return d1(v)
}

fn main() {
  let t = Tag{}
  print("${chain(t)}\n")
  print("${deep(t)}\n")
  print("${viaSlot(t)}\n")
  print("${rec(t, 2)}\n")
  print("${ping(t, 3)}\n")
  print("${concrete(7)}\n")
  print("${explicitArg(7)}\n")
  print("${viaMethod(t)}\n")
  print("${anySlot()}\n")
  print("${d0(t)}\n")
}
