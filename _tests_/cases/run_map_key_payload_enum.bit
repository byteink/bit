// run
// #4341's owner ruling: hashing must agree with the new structural equality
// (run_enum_payload_eq.bit), or a map silently loses entries instead of
// overwriting. Two structurally-equal `Config` keys, each holding an equal
// payload enum, must collapse to ONE entry — before this change `len(seen)`
// answered 2.
enum Port { Default, Explicit(int) }
class Config { host: string, port: Port }

fn main() {
  let seen = map<Config, int>{}
  seen[Config{ host: "localhost", port: Port.Default }] = 1
  seen[Config{ host: "localhost", port: Port.Default }] = 2
  print("${len(seen)} ${seen[Config{ host: "localhost", port: Port.Default }]}\n")
}
