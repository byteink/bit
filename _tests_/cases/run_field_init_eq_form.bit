// run
// #3840 step 1: field_init accepts `=` alongside `:` (target spelling is `=`;
// both are accepted for one release so the pinned stage0, which knows only
// `:`, can still build this tree). Renames nothing -- every existing site in
// the tree keeps `:`. `X{ f: 1 }` and `X{ f = 1 }` must produce identical
// values, the two spellings may be freely mixed in one literal, and neither
// the shorthand form nor map literals (which keep `:` forever) are affected.
class Point { x: int, y: int }

fn main() {
  let colon = Point{ x: 1, y: 2 }
  let eq = Point{ x = 1, y = 2 }
  print("colon=${colon.x},${colon.y} eq=${eq.x},${eq.y}\n")

  let mixed = Point{ x: 3, y = 4 }
  print("mixed=${mixed.x},${mixed.y}\n")

  let x = 5
  let y = 6
  let shorthand = Point{ x, y }
  print("shorthand=${shorthand.x},${shorthand.y}\n")

  let m = map<string, int>{ "a": 1, "b": 2 }
  print("map=${m["a"]},${m["b"]}\n")
}
