// run
// #4685: the satisfying side of every shape the descended body rules judge.
//
// `vInstDescend` now runs the whole `vInstWalk` over a callee's body, so E0073,
// E0052, E0054 and E0057 are decided two and three generics deep
// (_tests_/cases/check_generic_body_rules_depth.bit is the rejecting side). A
// per-monomorphization rule that reaches further reaches further in BOTH
// directions, and a spurious diagnostic on code the previous release accepts is
// worse than the silence it removes (validate.bit's safety rule) — so every way
// of not tripping the four rules is pinned here as RUNNING.
//
// What each group is for:
//
//   - `okInterp`/`okKey`/`okIndex`/`okMember`: the four rules, two deep, with
//     arguments that satisfy them. `Holder` reaches E0057's rule with a member
//     that exists, which is the case a rule widened by absence would reject.
//   - `threeInterp`: three generics deep, so the descent is exercised past the
//     one hop the two-deep cases need.
//   - `selfRec` and `mutA`/`mutB`: a generic that re-enters itself, directly and
//     round a cycle. `vInstOnChain` stops the WALK; the recursion here still
//     runs, so a guard that stopped the program instead of the walk would fail
//     this case rather than merely slowing it.
//   - `viaConcrete`: a call binding CONCRETE arguments inside a generic body.
//     `vInstSubstArgs` refuses to descend into it on purpose — the check pass
//     records it as a ledger entry of its own and `validateInstantiations`
//     judges its body separately — and it must still compile and run.
//   - `twiceOk`: two sibling calls to one generic with one set of arguments.
//     `vInstClaimBody` judges that body once; both calls must still EXECUTE.
class Holder {
  n: int,
}

fn deepInterp<T>(v: T): string {
  return "${v}"
}

fn okInterp<T>(v: T): string {
  return deepInterp(v)
}

fn threeInterp<T>(v: T): string {
  return okInterp(v)
}

fn deepKey<T>(v: T): int {
  let m = map<T, bool>{}
  m[v] = true
  return len(m)
}

fn okKey<T>(v: T): int {
  return deepKey(v)
}

fn deepIndex<T>(v: T): bool {
  return v[0] == 9
}

fn okIndex<T>(v: T): bool {
  return deepIndex(v)
}

fn deepMember<T>(v: T): int {
  return v.n
}

fn okMember<T>(v: T): int {
  return deepMember(v)
}

fn selfRec<T>(v: T, n: int): string {
  if (n <= 0) {
    return "${v}"
  }
  return selfRec(v, n - 1)
}

fn viaSelf<T>(v: T): string {
  return selfRec(v, 2)
}

fn mutA<T>(v: T, n: int): string {
  if (n <= 0) {
    return "${v}"
  }
  return mutB(v, n - 1)
}

fn mutB<T>(v: T, n: int): string {
  return mutA(v, n - 1)
}

fn viaMut<T>(v: T): string {
  return mutA(v, 3)
}

fn concreteInner<T>(v: T): string {
  return "${v}"
}

fn viaConcrete<T>(v: T): string {
  return concreteInner(41) + "/" + "${v}"
}

fn twiceOk<T>(v: T): string {
  return deepInterp(v) + deepInterp(v)
}

fn main() {
  print("${okInterp(7)}\n")
  print("${threeInterp("s")}\n")
  print("${okKey(3)}\n")
  print("${okIndex([9, 8])}\n")
  print("${okMember(Holder{ n: 5 })}\n")
  print("${viaSelf(1)}\n")
  print("${viaMut(2)}\n")
  print("${viaConcrete(4)}\n")
  print("${twiceOk(6)}\n")
}
