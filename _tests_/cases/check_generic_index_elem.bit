// error
// #4697: the rejecting half of _tests_/cases/run_generic_index_elem.bit.
//
// An index of a receiver typed by the enclosing generic's own type parameter is
// decidable once that parameter is bound, and deciding it is what E0073 needs:
// under `T = []Opaque`, `v[0]` is an `Opaque`, which has no `show(): string`.
//
// Before this the operand had no type at all, so the per-monomorphization pass
// stayed silent, `bit check` exited 0, and the LOWERER refused the program as
//
//   error[E0092]: cannot lower interpolating a value whose type has no
//   `show()` method
//
// — the same construct, reported one layer too late and, with `--emit-obj` or
// any path that does not build, not reported at all.
//
// The span is the operand inside the template, where every other
// per-monomorphization rule puts it, and `vInstNoteTrail` names the user's own
// call underneath: `one([Opaque{}])` is the line they can change.
class Opaque {}

fn one<T>(v: T): string {
  return "${v[0]}"
}

fn main() {
  print("${one([Opaque{}])}\n")
}
