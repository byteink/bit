// Fixture for scripts/selfhost-difftests.sh (its `PROJ` default): a directory
// module whose tests import std/testing. Two pass, two fail — one with a
// rendered value diff, one explicitly — so `bit test` here exercises discovery,
// dispatch, both failure renderings AND a non-zero runner exit.
//
// RESTORED BY #2427, and the header names its consumer for a reason. This file
// was written for the deleted harness `testcmd` and was deleted with it on 2026-07-29
// (18232fbc) — but the differential above is a SECOND consumer and was missed.
// Both compilers then answered the missing path identically, `cmp` succeeded,
// and the test-runner differential reported MATCH in 0 seconds for a week
// having compared nothing. `exit=1` in its output line is the tell that a real
// project was compared; `exit=0` means the path is gone again.
//
// RENAMED main.bit -> main.test.bit BY #3779: #3786 dropped `test_`-prefix
// discovery in favor of a filename marker (SPEC section 19) — a test is now
// any top-level, no-parameter, no-return `fn` in a `.test.bit` file, and
// `main.bit` is a plain `.bit` file the new compiler no longer scans at all.
// Left as a plain `.bit` file, this fixture's four functions had silently
// stopped being discovered by THIS compiler (`bit test _tests_/testproj`
// printed `no tests in _tests_/testproj`, exit 0) while the pinned stage0
// oracle — still on the old name-based rule — kept finding all four
// regardless of filename. The rename fixes discovery on both sides at once:
// a directory module's files are concatenated regardless of name (the
// oracle never cared what this file was called), and the new suffix rule
// now finds the same four functions this compiler builds.
//
// MIGRATED off the legacy `test_`-prefixed bare-fn form onto `test "..." {}`
// declarations BY #4131 (epic #4126). This is
// EXPECTED to newly diverge selfhost-difftests.sh against the pinned stage0
// oracle: that oracle predates `test` declaration parsing (#4127-#4129, all
// unreleased), so it cannot parse this file at all where it previously
// could. This is the documented fix-ahead-of-oracle shape and clears at the
// next stage0 repin — it is not a regression in this compiler.
import { ok, notOk, eq, neq, near, eqSlice, failNow } from "std/testing"
import { gcd, ipow } from "std/math"

test "scalar assertions pass" {
  eq<i64>(1 + 1, 2, "sum")
  eq<string>("ab" + "c", "abc", "concat")
  eq<bool>(1 < 2, true, "less")
  neq<i64>(gcd(48, 18), 5, "gcd is not 5")
  ok(ipow(3, 5) == 243, "ipow")
  notOk(ipow(2, 3) == 9, "ipow not 9")
}

test "float and slice assertions pass" {
  near(0.1 + 0.2, 0.3, 0.000001, "float add")
  eqSlice<i64>([1, 2, 3], [1, 2, 3], "slice")
}

test "fails with a rendered value diff" {
  eq<i64>(6, 7, "sum")
}

test "fails explicitly with failNow" {
  failNow("nope")
}
