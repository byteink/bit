// `bit lint` never ran over `runtime/` (#2515), and it would have caught #2017
// and #2506 before either shipped: both discarded a channel op's result —
// `let sent = chanSend(...)` / the `close()` equivalent — never read it, and
// silently dropped a value on a send/close to a closed channel. That exact
// shape is `E0211` (unused-local, spec/LINT.md §4).
//
// This gate enforces ZERO `E0211` findings in `runtime/` — the one rule class
// here with a proven miscompile-shaped consequence. Measured today (after
// #2515's fix) `bit lint runtime` also reports 63 findings across six other
// rule codes (E0204/E0202/E0201/E0203/E0200/E0212/E0210); those are
// readability findings, not correctness, and are DELIBERATELY left ungated
// here — #2515's own constraint is not to bundle their triage with E0211's,
// and the fix-or-override policy for them (mirroring #2354/#2453's shape for
// compiler/ and stdlib/) is a follow-up ticket, not this one.
//
// None of that is observable from inside the linting process: an exit code
// and stderr are only distinguishable from outside. So, exactly like
// `_tests_/bit/lintcmd/lintcmd.bit`, this shells the real `bit lint` out through
// `/bin/sh` and reads its exit code and stderr back off disk.
//
// Run it from the repository root:
//     ./bit-out/bin/bit run _tests_/bit/lintruntime.bit
// BIT_SELF_EXE names the compiler under test; BIT_REPO names the repo root
// `runtime/` hangs off. Both are required — a missing one is a hard stop, not
// a silently different (and silently green) directory.
import { env, envOr, exit } from "std/os"
import { exists, mkdir, readFile, writeFile } from "std/fs"
import { contains, hasPrefix, parseInt, split } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "300")) catch _ {
    300
  }
  if (s <= 0) {
    return 300000
  }
  return s * 1000
}

// Runs `script` through /bin/sh and returns its exit code. Negative returns
// are `osRunBounded`'s mechanism channel, never a program exit status, so
// each one is a named panic rather than a value any assertion could consume.
fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    fail newError("lintruntime: cannot make script executable: ${scriptPath}")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == -2) {
    panic("lintruntime: TIMED OUT after ${ms}ms running ${scriptPath}")
  }
  if (code == -1) {
    panic("lintruntime: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("lintruntime: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}

fn requiredEnv(name: string): string! {
  let v = env(name)
  if (len(v) == 0) {
    fail newError("lintruntime: ${name} is required and was not set")
  }
  return v
}

// One `bit lint runtime` invocation, as seen from outside it.
class Run { code: int, err: string }

fn runLint(bit: string, runtimeDir: string, capDir: string, ms: int): Run! {
  let outPath = "${capDir}/out.txt"
  let errPath = "${capDir}/err.txt"
  let codePath = "${capDir}/code.txt"
  let script = "#!/bin/sh\n" +
    "'${bit}' lint '${runtimeDir}' > '${outPath}' 2> '${errPath}'\n" +
    "echo $? > '${codePath}'\n" +
    "exit 0\n"
  let sh = shell("${capDir}/lint.sh", script, ms)?
  if (sh != 0) {
    fail newError("lintruntime: wrapper script exited ${sh}, which it never should")
  }
  if (!exists(codePath)) {
    fail newError("lintruntime: no exit code was recorded — the run never happened")
  }
  let code = parseInt(trimWs(readFile(codePath)?))?
  return Run{ code: code, err: readFile(errPath)? }
}

// The header line of one finding, e.g. `warning[E0211]: 'sent' is declared...`.
fn isFindingHeader(line: string): bool {
  return hasPrefix(line, "warning[E") || hasPrefix(line, "error[E")
}

// `r` is a usable observation of a real run, not silence mistaken for a clean
// sheet. Anti-vacuity: `bit lint` always prints a summary to stderr, clean or
// not (compiler/lint.bit:1354), so an empty capture means the run produced
// nothing trustworthy. Exit 2 is SPEC's own "could not be trusted" verdict
// (usage error, unreadable path, malformed directive) — reading it as a clean
// run is exactly the hole `docs/development.md`'s four ways-to-report-green
// warns about.
fn assertTrustworthy(r: Run, runtimeDir: string) {
  if (len(r.err) == 0) {
    panic("lintruntime: stderr is empty — `bit lint ${runtimeDir}` produced no summary")
  }
  if (r.code == 2) {
    panic("lintruntime: `bit lint ${runtimeDir}` exited 2 (untrusted run):\n${r.err}")
  }
  if (r.code != 0 && r.code != 1) {
    panic("lintruntime: `bit lint ${runtimeDir}` exited ${r.code}, want 0 or 1")
  }
}

// Total finding-header lines, and how many of those are E0211.
fn countFindings(err: string): (int, int) {
  let e0211 = 0
  let total = 0
  for line of split(err, "\n") {
    if (!isFindingHeader(line)) {
      continue
    }
    total = total + 1
    if (contains(line, "[E0211]")) {
      e0211 = e0211 + 1
    }
  }
  return total, e0211
}

// Prints every finding-header line reporting E0211, one per line.
fn printE0211Findings(err: string) {
  for line of split(err, "\n") {
    if (contains(line, "[E0211]")) {
      eprint("  ${line}\n")
    }
  }
}

fn main() {
  let ms = timeoutMs()
  let bit = requiredEnv("BIT_SELF_EXE") catch e {
    panic("lintruntime: ${e.message()}")
  }
  let repo = requiredEnv("BIT_REPO") catch e {
    panic("lintruntime: ${e.message()}")
  }
  let runtimeDir = "${repo}/runtime"
  if (!exists(runtimeDir)) {
    panic("lintruntime: no such directory: ${runtimeDir}")
  }

  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  let capDir = "${tmp}/bit-lintruntime-${uuidFormat(uuidV4())}"
  mkdir(capDir) catch e {
    panic("lintruntime: cannot create ${capDir}: ${e.message()}")
  }

  let r = runLint(bit, runtimeDir, capDir, ms) catch e {
    panic("lintruntime: ${e.message()}")
  }
  assertTrustworthy(r, runtimeDir)

  let (total, e0211) = countFindings(r.err)
  println("lint-runtime: ${total} findings in runtime/ (${e0211} of them E0211)")
  if (e0211 > 0) {
    // `exit()` does not run pending defers (#3694, same shape as #3677) —
    // call teardown explicitly on both the PASS and FAIL paths.
    teardown(capDir, ms)
    eprint("FAIL: ${e0211} warning[E0211] findings survive in runtime/ — each one is\n")
    eprint("a discarded result exactly like #2017/#2506; bind it to '_' or use it.\n")
    printE0211Findings(r.err)
    exit(1)
  }
  teardown(capDir, ms)
  println("lint-runtime: PASS — 0 E0211 findings in runtime/")
}

fn teardown(dir: string, ms: int) {
  shell("${dir}/rm.sh", "#!/bin/sh\nrm -rf '${dir}'\n", ms) catch _ {
    return
  }
}

fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}
