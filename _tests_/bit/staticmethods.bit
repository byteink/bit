// _tests_/bit/staticmethods.bit — #6091/#6099: proves `static` class
// methods (spelled `static name(...)` since #6156 dropped the original
// `static fn name(...)`), `ClassName.m()`/`T.m()` call resolution and
// lowering, `this` rejection, interface static requirements, and the
// value-type restriction (SPEC §10.4.1/§10.6) all work together, end to
// end. Also #6121: a named argument on a static method call, skipping a
// trailing defaulted one.
//
// NOT placed in _tests_/cases/: the `assertDiag`/`assertBuildDiag` cases are
// check-must-fail fixtures asserting a specific diagnostic substring, a
// shape the ast/types/ir differential corpus has no room for — same "route
// it to _tests_/bit/ behind a registered gate" treatment
// _tests_/bit/baremaplit.bit (#6016) documents for its own surface.
//
// WIRED INTO `./make test` as `test-staticmethods`
// (tools/build/gatestable2.bit, tools/build/defs.bit).

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"
import { contains, parseInt, trimSpace } from "std/strings"

const defaultTimeoutS: int = 60
const maxTimeoutMs: int = 6000000

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("staticmethods: ${name} is not set — refusing to guess.\n")
    exit(2)
  }
  return v
}

fn timeoutMs(): int {
  let raw = trimSpace(envOr("BIT_TEST_TIMEOUT_S", ""))
  if (raw == "") {
    return defaultTimeoutS * 1000
  }
  let s = parseInt(raw) catch _ {
    return defaultTimeoutS * 1000
  }
  if (s <= 0) {
    return maxTimeoutMs
  }
  if (s * 1000 > maxTimeoutMs) {
    return maxTimeoutMs
  }
  return s * 1000
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

// The fixture: `Box.zero()` (a direct static call), `T.label()` through a
// generic bound `T: Named` (SPEC §10.4.1's `describe<T: Named>()` example)
// — monomorphized dispatch, no vtable, no RTTI — and `Box.make(a = 2)`
// (#6121, SPEC §12.11): a named argument on a static method call that skips
// `b`'s own `= const_expr` default, proving the named-argument default-fill
// path (`vStaticNamedArgs`/`vCallNamedArgs`, namedargs.bit,
// `fillDefaultRange`, lowernamedarg.bit) reaches a static receiver the same
// way it already reaches a free function or an instance method.
fn fixtureSrc(): string {
  return "interface Named {\n" +
    "  static label(): string\n" +
    "}\n\n" +
    "class Box {\n" +
    "  static zero(): int {\n" +
    "    return 0\n" +
    "  }\n" +
    "  static label(): string {\n" +
    "    return \"box\"\n" +
    "  }\n" +
    "  static make(a: int, b: int = 5): int {\n" +
    "    return a + b\n" +
    "  }\n" +
    "}\n\n" +
    "fn describe<T: Named>(): string {\n" +
    "  return T.label()\n" +
    "}\n\n" +
    "fn main() {\n" +
    "  print(\"\${Box.zero()}\\n\")\n" +
    "  print(describe<Box>())\n" +
    "  print(\"\\n\")\n" +
    "  print(\"\${Box.make(a = 2)}\\n\")\n" +
    "}\n"
}

const wantOut: string = "0\nbox\n7\n"

class CompilerEnv {
  bin: string,
  stdlib: string,
  libbitrt: string,
}

fn buildOne(cc: CompilerEnv, dir: string, srcPath: string, outPath: string): (int, string) {
  let shPath = dir + "/build.sh"
  let errPath = dir + "/build.err"
  let script = "#!/bin/sh\n" +
    "BIT_STDLIB=" +
    shQuote(cc.stdlib) +
    "\nexport BIT_STDLIB\n" +
    "BIT_LIBBITRT=" +
    shQuote(cc.libbitrt) +
    "\nexport BIT_LIBBITRT\n" +
    "exec " +
    shQuote(cc.bin) +
    " build " +
    shQuote(srcPath) +
    " -o " +
    shQuote(outPath) +
    " > /dev/null 2> " +
    shQuote(errPath) +
    "\n"
  writeFile(shPath, script) catch e {
    eprint("staticmethods: cannot write build wrapper: ${e.message()}\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("staticmethods: cannot chmod build wrapper\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let err = readFile(errPath) catch _ {
    ""
  }
  return code, err
}

fn checkOne(cc: CompilerEnv, dir: string, srcPath: string): (int, string) {
  let shPath = dir + "/check.sh"
  let errPath = dir + "/check.err"
  let script = "#!/bin/sh\n" +
    "BIT_STDLIB=" +
    shQuote(cc.stdlib) +
    "\nexport BIT_STDLIB\n" +
    "BIT_LIBBITRT=" +
    shQuote(cc.libbitrt) +
    "\nexport BIT_LIBBITRT\n" +
    "exec " +
    shQuote(cc.bin) +
    " check " +
    shQuote(srcPath) +
    " > /dev/null 2> " +
    shQuote(errPath) +
    "\n"
  writeFile(shPath, script) catch e {
    eprint("staticmethods: cannot write check wrapper: ${e.message()}\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("staticmethods: cannot chmod check wrapper\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let err = readFile(errPath) catch _ {
    ""
  }
  return code, err
}

// One `bit check`-must-fail-with-this-diagnostic case: `label` names it in a
// failure message, `src` is the whole fixture source, `want` a substring the
// rendered stderr must contain.
fn assertDiag(cc: CompilerEnv, scratch: string, label: string, src: string, want: string) {
  let srcPath = scratch + "/" + label + ".bit"
  writeFile(srcPath, src) catch e {
    eprint("staticmethods: cannot write ${srcPath}: ${e.message()}\n")
    teardown(scratch, timeoutMs())
    exit(2)
  }
  let (code, err) = checkOne(cc, scratch, srcPath)
  if (code == 0 || !contains(err, want)) {
    eprint("staticmethods: FAIL — ${label}: exit=${code}\n  want stderr to contain: ${want}\n  got:\n${err}\n")
    teardown(scratch, timeoutMs())
    exit(1)
  }
}

// Like assertDiag, but for a defect `bit check` accepts and only `bit
// build` refuses — calling a static method through a VALUE receiver types
// clean (it is keyed under the same "<typeId>.<name>" an instance method's
// call would find) and is caught at lowering instead, the same "unresolved
// callee" every other undispatchable call in this compiler gets.
fn assertBuildDiag(cc: CompilerEnv, scratch: string, label: string, src: string, want: string) {
  let srcPath = scratch + "/" + label + ".bit"
  writeFile(srcPath, src) catch e {
    eprint("staticmethods: cannot write ${srcPath}: ${e.message()}\n")
    teardown(scratch, timeoutMs())
    exit(2)
  }
  let outPath = scratch + "/" + label + "_out"
  let (code, err) = buildOne(cc, scratch, srcPath, outPath)
  if (code == 0 || !contains(err, want)) {
    eprint("staticmethods: FAIL — ${label}: exit=${code}\n  want stderr to contain: ${want}\n  got:\n${err}\n")
    teardown(scratch, timeoutMs())
    exit(1)
  }
}

// The inverse of assertDiag: `bit check` must SUCCEED. Used to prove a
// legal generic-bound usage (`T: Named`) is unaffected by the value-type
// restriction, which must reject the value-type positions and nothing else.
fn assertOk(cc: CompilerEnv, scratch: string, label: string, src: string) {
  let srcPath = scratch + "/" + label + ".bit"
  writeFile(srcPath, src) catch e {
    eprint("staticmethods: cannot write ${srcPath}: ${e.message()}\n")
    teardown(scratch, timeoutMs())
    exit(2)
  }
  let (code, err) = checkOne(cc, scratch, srcPath)
  if (code != 0) {
    eprint("staticmethods: FAIL — ${label}: want exit 0, got ${code}\n${err}\n")
    teardown(scratch, timeoutMs())
    exit(1)
  }
}

fn runOne(dir: string, binPath: string): (int, string) {
  let shPath = dir + "/run.sh"
  let outPath = dir + "/run.out"
  let script = "#!/bin/sh\nexec " + shQuote(binPath) + " > " + shQuote(outPath) + " 2>&1\n"
  writeFile(shPath, script) catch e {
    eprint("staticmethods: cannot write run wrapper: ${e.message()}\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("staticmethods: cannot chmod run wrapper\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let out = readFile(outPath) catch _ {
    ""
  }
  return code, out
}

fn teardown(scratch: string, ms: int) {
  let shPath = scratch + "/rm.sh"
  writeFile(shPath, "#!/bin/sh\nrm -rf '${scratch}'\n") catch _ {
    return
  }
  if (fsChmod(shPath, 448) != 0) {
    return
  }
  osRunBounded(shPath, ms)
}

fn main() {
  let cc = CompilerEnv{
    bin = requiredEnv("BIT_BIN"),
    stdlib = requiredEnv("BIT_STDLIB"),
    libbitrt = requiredEnv("BIT_LIBBITRT"),
  }

  let scratch = envOr("TMPDIR", "/tmp") + "/bit-staticmethods-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("staticmethods: cannot create scratch directory ${scratch}: ${e.message()}\n")
    exit(2)
  }

  let srcPath = scratch + "/fixture.bit"
  writeFile(srcPath, fixtureSrc()) catch e {
    eprint("staticmethods: cannot write ${srcPath}: ${e.message()}\n")
    teardown(scratch, timeoutMs())
    exit(2)
  }
  let outPath = scratch + "/fixture_out"
  let (buildCode, buildErr) = buildOne(cc, scratch, srcPath, outPath)
  if (buildCode != 0) {
    eprint("staticmethods: FAIL — fixture failed to build (exit ${buildCode}):\n${buildErr}\n")
    teardown(scratch, timeoutMs())
    exit(1)
  }
  let (runCode, out) = runOne(scratch, outPath)
  if (runCode != 0 || out != wantOut) {
    eprint("staticmethods: FAIL — fixture ran wrong: exit=${runCode}\n  want: ${wantOut}\n  got:  ${out}\n")
    teardown(scratch, timeoutMs())
    exit(1)
  }

  assertStaticDiagnostics(cc, scratch)

  teardown(scratch, timeoutMs())
  print("PASS staticmethods: static class methods, ClassName.m()/T.m() dispatch, this-rejection, and the interface value-type restriction all work\n")
}

// Every `assertDiag`/`assertBuildDiag`/`assertOk` scenario, run after the
// main fixture — split out of `main` purely to keep that function's own
// line count under spec/LINT.md's 80-line ceiling (E0201) once #6121 added
// the bound-generic named-argument case.
fn assertStaticDiagnostics(cc: CompilerEnv, scratch: string) {
  // #6156: `static fn label()`, #6091's original spelling, is rejected with
  // E0172 and a hint to drop `fn` — every other method form in a class body
  // (an instance method, and this same class's `static zero()` above) omits
  // it, so this is the one place a stale `fn` still has to be caught.
  assertDiag(
    cc, scratch, "static_fn_rejected",
      "class Box {\n  static fn label(): string {\n    return \"box\"\n  }\n}\n" +
      "fn main() {\n  print(Box.label())\n}\n",
    "write 'static label()', without 'fn'",
  )

  // `this` has no binding inside a static method's body (SPEC §10.4.1):
  // the same "undefined name" a top-level function's body already gets.
  assertDiag(
    cc, scratch, "this_in_static",
      "class Box {\n  n: int,\n  static bad(): int {\n    return this.n\n  }\n}\n" +
      "fn main() {\n  print(\"\${Box.bad()}\")\n}\n",
    "undefined name 'this'",
  )

  // A static method has no `this` slot to receive a VALUE call
  // (SPEC §10.4.1): `b.zero()` resolves through the SAME "<typeId>.<name>"
  // key an instance method's call would (both a static and an instance
  // method register there, #6091/#6099), so this is caught by the IR
  // verifier's arity check instead of an unresolved-member diagnostic —
  // `zero`'s own signature declares 0 parameters, and a value receiver call
  // still pushes one. Refused before a binary is emitted either way.
  assertBuildDiag(
    cc, scratch, "static_through_value",
      "class Box {\n  static zero(): int {\n    return 0\n  }\n}\n" +
      "fn main() {\n  let b = Box{}\n  print(\"\${b.zero()}\")\n}\n",
    "declares 0 parameter(s)",
  )

  // SPEC §10.6: an interface declaring a static requirement cannot be used
  // as a value type — E0170 (compiler/validatestaticiface.bit).
  assertDiag(
    cc, scratch, "static_iface_as_value_type",
    "interface Named {\n  static label(): string\n}\n" + "fn main() {\n  let x: Named = nil\n}\n",
    "'Named' declares a static requirement and cannot be used as a value type",
  )

  // The same interface IS legal as a generic bound — the restriction above
  // must reject only the value-type positions, never `T: Named`.
  assertOk(
    cc, scratch, "static_iface_as_bound",
      "interface Named {\n  static label(): string\n}\n" +
      "class Box {\n  static label(): string {\n    return \"box\"\n  }\n}\n" +
      "fn describe<T: Named>(): string {\n  return T.label()\n}\n" +
      "fn main() {\n  print(describe<Box>())\n}\n",
  )

  // #6121, SPEC §12.11: a named argument on a static call through a BOUND
  // GENERIC is refused (E0128), unlike one through the class's own name
  // (`Box.make(a = 2)` above) — `vStaticNamedArgs` (namedargs.bit) resolves
  // `T` to its constraint interface's OWN declared names, while the
  // implementing class's may legally differ, so this stays positional only
  // exactly as an instance call through a bound `T` already is.
  assertDiag(
    cc, scratch, "static_bound_generic_named_arg_rejected",
      "interface Named {\n  static tag(x: int): string\n}\n" +
      "class Box {\n  static tag(x: int): string {\n    return \"box\${x}\"\n  }\n}\n" +
      "fn describe<T: Named>(): string {\n  return T.tag(x = 1)\n}\n" +
      "fn main() {\n  print(describe<Box>())\n}\n",
    "named arguments require a direct call to a named function",
  )
}
