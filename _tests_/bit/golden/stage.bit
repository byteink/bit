// Stage phase for _tests_/bit/golden (#1901): for every valid case, builds the
// shell job(s) its directive needs and hands them to
// _tests_/bit/gatefanout.stageJob. Nothing here executes anything — see that
// module's header for why exactly one `osRunBounded` call covers the whole
// corpus. Every job key is unique per case (its own index plus a short
// suffix), and every scratch path this file writes (case binary, fmt copy,
// doc staging dir) is derived from the case's own file name or index, never
// a name shared across cases — the #3530 hazard this ticket exists to avoid.
//
// Sibling file in _tests_/bit/golden/, same module as golden.bit: `dRun`..
// `dPanicDebug`, `Ctx`, `failCase` and `isRunLike` are declared there and
// resolved here with no import, the same as directive.bit already relies on
// (SPEC §14.8 covers only diagnostic ORDER, which this pure split of an
// existing file does not touch).

import { writeFile } from "std/fs"
import { FanCfg, Job, commitWave, stageJob, wave1, wave2 } from "../gatefanout"

// What `golden.bit`'s corpus scan reads straight off disk, before any
// scratch path is derived — grouped so `newGCase` stays under the 5-param
// lint ceiling (E0202).
class RawCase {
  name: string,
  src: string,
  expected: string,
  directive: int,
  line: string,
}

class GCase {
  idx: int,
  name: string,
  src: string,
  expected: string,
  directive: int,
  line: string,
  binPath: string,
  fmtTmp: string,
  docDir: string,
}

fn primaryKey(idx: int): string { return "p${idx}" }
fn runKey(idx: int): string { return "r${idx}" }
fn dumpIrKey(idx: int): string { return "di${idx}" }
fn dumpIrPreKey(idx: int): string { return "dp${idx}" }

fn newGCase(idx: int, raw: RawCase, scratch: string): GCase {
  let stem = raw.name[0:len(raw.name) - 4]
  return GCase{
    idx: idx, name: raw.name, src: raw.src, expected: raw.expected,
    directive: raw.directive, line: raw.line,
    binPath: "${scratch}/case_${stem}.bin",
    fmtTmp: "${scratch}/fmt_${raw.name}",
    docDir: "${scratch}/doc_${raw.name}",
  }
}

// Builds the primary check's argv for every directive except the // run
// family, whose primary job is the COMPILE step (see stageRunFamily).
fn primaryArgv(bin: string, c: GCase): []string {
  if (c.directive == dErr) {
    return [bin, "check", c.name]
  }
  if (c.directive == dFmt) {
    return [bin, "fmt", c.fmtTmp]
  }
  if (c.directive == dLint) {
    return [bin, "lint", c.name]
  }
  if (c.directive == dDoc) {
    return [bin, "doc", c.docDir]
  }
  if (c.directive == dTypes) {
    return [bin, "--dump-types", c.name]
  }
  if (c.directive == dTokens) {
    return [bin, "--dump-tokens", c.name]
  }
  if (c.directive == dAst) {
    return [bin, "--dump-ast", c.name]
  }
  return [bin, "--dump-ir", c.name]
}

// fmt/doc each need a side file staged BEFORE their job can run: a copy of
// the source at a case-unique path (fmt) or a throwaway one-file module
// directory (doc). Returns false (having already marked the case failed) if
// staging itself cannot write, matching the pre-#1901 behaviour of failing
// the case rather than silently skipping it.
fn stageSideFiles(ctx: Ctx, c: GCase): bool {
  if (c.directive == dFmt) {
    writeFile(c.fmtTmp, c.src) catch _ {
      failCase(ctx, c.name, "fmt", "cannot stage a copy at ${c.fmtTmp}")
      return false
    }
    return true
  }
  if (c.directive == dDoc) {
    mkdir(c.docDir) catch _ {
      failCase(ctx, c.name, "doc", "cannot create scratch module directory ${c.docDir}")
      return false
    }
    writeFile("${c.docDir}/main.bit", c.src) catch _ {
      failCase(ctx, c.name, "doc", "cannot stage a copy at ${c.docDir}/main.bit")
      return false
    }
    return true
  }
  return true
}

// Every non-run-family directive runs from the case's own cwd except
// fmt/doc, whose primary argv already names an absolute scratch path.
fn primaryCwd(casesDir: string, c: GCase): string {
  if (c.directive == dFmt || c.directive == dDoc) {
    return ""
  }
  return casesDir
}

// Every case gets the two dump-survives jobs regardless of directive
// (#2084: the dump commands must not die by signal on ANY case, valid or
// not), plus its own directive-specific primary (and, for the // run
// family, a paired wave-2 run job).
fn stageOne(cfg: FanCfg, ctx: Ctx, casesDir: string, bin: string, c: GCase) {
  stageJob(
    cfg,
    Job{
      key: dumpIrKey(c.idx), wave: wave1, cwd: casesDir,
      argv: [bin, "--dump-ir", c.name], withEnv: true,
    },
  )
  commitWave(cfg.scratch, dumpIrKey(c.idx), wave1)
  stageJob(
    cfg,
    Job{
      key: dumpIrPreKey(c.idx), wave: wave1, cwd: casesDir,
      argv: [bin, "--dump-ir-pre", c.name], withEnv: true,
    },
  )
  commitWave(cfg.scratch, dumpIrPreKey(c.idx), wave1)

  if (isRunLike(c.directive)) {
    stageRunFamily(cfg, casesDir, bin, c)
    return
  }
  if (!stageSideFiles(ctx, c)) {
    return
  }
  stageJob(
    cfg,
    Job{
      key: primaryKey(c.idx), wave: wave1, cwd: primaryCwd(casesDir, c),
      argv: primaryArgv(bin, c), withEnv: true,
    },
  )
  commitWave(cfg.scratch, primaryKey(c.idx), wave1)
}

// `// run` / `// run-debug` / `// panic` / `// panic-debug`: compile (wave 1)
// with `bit` (`--debug` added for the two debug variants, #3077), execute the
// produced binary (wave 2). `binPath` is unique per case — never the single
// shared "case.bin" the pre-#1901 serial harness used, which would have raced
// the moment two such cases compiled concurrently.
fn stageRunFamily(cfg: FanCfg, casesDir: string, bin: string, c: GCase) {
  let argv = [bin, "build", c.name, "-o", c.binPath]
  if (c.directive == dPanicDebug || c.directive == dRunDebug) {
    argv = append(argv, "--debug")
  }
  stageJob(
    cfg,
    Job{
      key: primaryKey(c.idx), wave: wave1, cwd: casesDir,
      argv: argv, withEnv: true,
    },
  )
  commitWave(cfg.scratch, primaryKey(c.idx), wave1)
  stageJob(
    cfg,
    Job{
      key: runKey(c.idx), wave: wave2, cwd: "",
      argv: [c.binPath], withEnv: false,
    },
  )
  commitWave(cfg.scratch, runKey(c.idx), wave2)
}
