// Directive vocabulary for _tests_/bit/golden/golden.bit: converts between
// the directive ids declared there (dRun..dDoc), their canonical names,
// and the line-1 comment prefixes that select them. Split out by #3573 to
// keep golden.bit under the 800-line E0200 ceiling after `bit fmt`.
//
// Sibling file in _tests_/bit/golden/, same module as golden.bit (a module
// is a directory of .bit files, SPEC § 17.1): no import is added here
// for the dRun..dDoc consts or for `hasPrefix`, both already
// declared/imported in golden.bit, and name resolution across sibling
// files is order-independent (SPEC.md § 14.8 covers only diagnostic
// order, which this pure move does not change).

// Split from directiveName to keep both halves under E0204's complexity
// ceiling, mirroring directiveOfEarly/directiveOf below. "" is the sentinel.
fn directiveNameEarly(d: int): string {
  if (d == dRun) {
    return "run"
  }
  if (d == dPanic) {
    return "panic"
  }
  if (d == dPanicDebug) {
    return "panic-debug"
  }
  if (d == dErr) {
    return "error"
  }
  if (d == dFmt) {
    return "fmt"
  }
  return ""
}

fn directiveName(d: int): string {
  let early = directiveNameEarly(d)
  if (early != "") {
    return early
  }
  if (d == dTypes) {
    return "types"
  }
  if (d == dTokens) {
    return "tokens"
  }
  if (d == dAst) {
    return "ast"
  }
  if (d == dIr) {
    return "ir"
  }
  if (d == dLint) {
    return "lint"
  }
  return "doc"
}

// Split from directiveOf to keep both halves under the complexity ceiling
// (E0204): a flat dispatch naming every directive in one function grows past
// 10 as directives are added. -1 means "not one of these six", never "no
// recognised directive" — the caller is directiveOf, which tries the rest.
fn directiveOfEarly(line: string): int {
  if (hasPrefix(line, "// error")) {
    return dErr
  }
  // Before `// panic`: "// panic-debug" also starts with "// panic", so it
  // must be matched first or it silently downgrades to a plain panic case.
  if (hasPrefix(line, "// panic-debug")) {
    return dPanicDebug
  }
  // Before `// run`: an ordering bug here would silently downgrade a panic
  // case to a stdout comparison against a stderr-shaped `.expected`.
  if (hasPrefix(line, "// panic")) {
    return dPanic
  }
  if (hasPrefix(line, "// run")) {
    return dRun
  }
  if (hasPrefix(line, "// fmt")) {
    return dFmt
  }
  if (hasPrefix(line, "// types")) {
    return dTypes
  }
  return 0 - 1
}

// -1 means "no recognised directive", which is a hard failure at the call site.
fn directiveOf(line: string): int {
  let early = directiveOfEarly(line)
  if (early >= 0) {
    return early
  }
  if (hasPrefix(line, "// tokens")) {
    return dTokens
  }
  if (hasPrefix(line, "// ast")) {
    return dAst
  }
  if (hasPrefix(line, "// ir")) {
    return dIr
  }
  if (hasPrefix(line, "// lint")) {
    return dLint
  }
  if (hasPrefix(line, "// doc")) {
    return dDoc
  }
  return 0 - 1
}
