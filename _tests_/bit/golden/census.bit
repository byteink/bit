fn expectedCounts(): []int {
  let c = []int(dCount)
  c[dRun] = 455
  c[dPanic] = 50
  c[dErr] = 150
  c[dFmt] = 13
  c[dTypes] = 6
  c[dTokens] = 1
  c[dAst] = 1
  c[dIr] = 5
  c[dLint] = 43
  c[dDoc] = 1
  c[dPanicDebug] = 8
  c[dRunDebug] = 1
  return c
}
