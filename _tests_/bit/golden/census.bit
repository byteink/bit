// The per-directive census for _tests_/cases, split out of golden.bit at 816
// lines (#4441's ceiling, the same one that moved checkerdiag). Pure move:
// the derivation history and expectedCounts() only. The dRun/dPanic/... ids
// stay in golden.bit -- name resolution is per MODULE, so they resolve here
// unchanged and re-importing anything would be E0042.

// DERIVATION HISTORY for expectedCounts() below, kept out of the function body
// so its own physical-line count (E0201) tracks the number of assignments,
// not the size of the log. Derived via
// `for f in _tests_/cases/*.bit; do head -1 "$f"; done | sort | uniq -c`.
// Earliest history (task-3762 x main, #3371, #3370: dRun 323 -> 327,
// dErr -> 137, each a pinned-count merge collision resolved the same way
// every entry below is) is in git blame, not repeated here (#2862's
// precedent: a per-ticket entry may be pruned once it is pure history).
// 2026-09-10: the per-ticket entries that used to follow (#3810 .. #4334,
// 775 lines) were pruned under that precedent once this file crossed the
// 800-line ceiling itself (test-filesize, 806 lines at 24c754ca). Each was a
// dated "ticket N adds M cases, re-derived off disk" note; `git log -p --
// _tests_/bit/golden/census.bit` keeps every one.
//
// #5291: the hazard those entries recorded -- two branches that each add a
// fixture write the SAME number and merge clean at the WRONG (understated)
// value, silent because nothing conflicted -- used to require a human to
// notice a FAIL and hand-transcribe the correct number back in. It no longer
// does: golden.bit's checkCensus rewrites the literals below itself from the
// live corpus tally whenever they drift (still failing that run — a rewrite
// never makes a stale commit read green), so the fix is always `git diff`
// this file and commit it, never mental arithmetic or a re-run of the shell
// command above by hand.

fn expectedCounts(): []int {
  let c = []int(dCount)
  c[dRun] = 524
  c[dPanic] = 56
  c[dErr] = 175
  c[dFmt] = 16
  c[dTypes] = 6
  c[dTokens] = 1
  c[dAst] = 1
  c[dIr] = 6
  c[dLint] = 53
  c[dDoc] = 1
  c[dPanicDebug] = 8
  c[dRunDebug] = 1
  return c
}

// The `c[dX] = N` identifiers above, used only by golden.bit's rewriteCensus
// to find each assignment's line by exact text ("c[dRun] = ", etc.) and
// replace its number; order here does not need to match assignment order
// above since the match is by identifier text, not position.
fn censusIdentifiers(): []string {
  return [
    "dRun", "dPanic", "dErr", "dFmt", "dTypes", "dTokens", "dAst", "dIr",
    "dLint", "dDoc", "dPanicDebug", "dRunDebug",
  ]
}
