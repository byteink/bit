import { selfExe } from "std/os"
import { replace } from "std/strings"

// A fixed clock makes the peer collision certain without racing two processes.
const isolationChild = "BIT_GOLDEN_ISOLATION_CHILD"
const isolationOuter = "BIT_GOLDEN_ISOLATION_OUTER"
const isolationNonce = "8398"
const isolationJobMs: int = 60000
const isolationDriverMs: int = 90000

fn isolationMkdir(path: string) {
  mkdir(path) catch e {
    panic(e.message())
  }
}

fn isolationCase(name: string, idx: int, cases: string, scratch: string): GCase {
  let source = readFile("${requiredEnv("BIT_CASES_DIR")}/${name}") catch e {
    panic(e.message())
  }
  let clock = "timeUnixNs()"
  let at = indexOf(source, clock)
  assert(at >= 0, "fixture must name its directory with the clock")
  assert(indexOf(source[at + len(clock):], clock) < 0, "only the filename clock may change")
  let fixed = replace(source, clock, isolationNonce)
  let stem = name[0:len(name) - 4]
  let expected = readFile("${requiredEnv("BIT_CASES_DIR")}/${stem}.expected") catch e {
    panic(e.message())
  }
  writeFile("${cases}/${name}", fixed) catch e {
    panic(e.message())
  }
  writeFile("${cases}/${stem}.expected", expected) catch e {
    panic(e.message())
  }
  return newGCase(
    idx, RawCase{
      name = name,
      src = fixed,
      expected = expected,
      directive = dRun,
      line = "// run",
    },
    scratch,
  )
}

fn isolationPeer(outer: string, name: string): string {
  let stem = name[0:len(name) - 4]
  let path = "${outer}/bit_${stem}_${isolationNonce}"
  isolationMkdir(path)
  writeFile("${path}/sentinel", "peer-owned") catch e {
    panic(e.message())
  }
  return path
}

fn isolationCheckPeers(peers: []string) {
  for peer of peers {
    let sentinel = readFile("${peer}/sentinel") catch e {
      panic(e.message())
    }
    assert(sentinel == "peer-owned", "a fixture changed its peer's directory")
  }
}

fn isolationRun(outer: string) {
  assert(env("TMPDIR") == outer, "child must inherit its controlled outer TMPDIR")
  let cases = "${outer}/cases"
  let scratch = "${outer}/bit-golden-${uuidFormat(uuidV4())}"
  isolationMkdir(cases)
  isolationMkdir(scratch)
  let ctx = Ctx{
    casesDir = cases, bin = requiredEnv("BIT_BIN"), scratch = scratch,
    timeoutMs = isolationJobMs, failures = 0, quiet = false, lastWhy = "",
    boxedRet = false, ifChain = envOr("BIT_IF_BRANCHCHAIN", "1") != "0",
  }
  let cfg = newFanCfg(scratch, isolationJobMs, env("BIT_STDLIB"), env("BIT_LIBBITRT"))
  let staged = []GCase(0)
  let peers = []string(0)
  for name of ["fs_exists_unreadable.bit", "fs_readdir_large.bit"] {
    peers = append(peers, isolationPeer(outer, name))
    let cs = isolationCase(name, len(staged), cases, scratch)
    staged = append(staged, cs)
    stageOne(cfg, ctx, cases, ctx.bin, cs)
  }
  let driver = runDriver(scratch, isolationDriverMs)
  for cs of staged {
    gradeCase(ctx, scratch, cs)
  }
  isolationCheckPeers(peers)
  assert(
    driver == 0 && ctx.failures == 0,
    "golden runtime TMPDIR escaped its harness scratch: ${ctx.lastWhy}",
  )
  println("golden isolation: both original filesystem outputs and peer sentinels preserved")
}

test "golden runtime children isolate temporary files from peer harnesses" {
  if (env(isolationChild) == "1") {
    isolationRun(requiredEnv(isolationOuter))
    return
  }
  let root = "${envOr("TMPDIR", "/tmp")}/bit-golden-isolation-${uuidFormat(uuidV4())}"
  isolationMkdir(root)
  defer teardown(root, isolationJobMs)
  let outer = "${root}/outer"
  isolationMkdir(outer)
  let cfg = newFanCfg(root, isolationDriverMs, "", "")
  stageJob(
    cfg,
    Job{
      key = "isolation", wave = wave1, cwd = "", withEnv = false,
      argv = [
        "env",
        "TMPDIR=${outer}",
        "${isolationChild}=1",
        "${isolationOuter}=${outer}",
        selfExe(),
      ],
    },
  )
  commitWave(root, "isolation", wave1)
  let driver = runDriver(root, 120000)
  let result = gradeJob(root, "isolation")
  assert(
    driver == 0 && result.ran && result.code == 0,
    "isolation regression failed:\n${result.out}\n${result.err}",
  )
  print(result.out)
}
