// _tests_/bit/forofarrow.bit — #7765: `for x of it? { }` over a
// `next(): Option<T>!` iterable inside an arrow whose parameter type is
// inferred from the function type it is written against builds and runs, and
// agrees with the same loop in a plain fn. The fixture needs a compiler that
// judges the loop's `?` once the arrow's parameter is typed; the pinned stage0
// reports E0116 on it. NOT placed in _tests_/cases/ for that reason: every
// scripts/selfhost-diff*.sh differential walks that corpus against the pinned
// stage0 (#5585), so a file stage0 cannot compile would score MISMATCH by
// construction — the "route it to _tests_/bit/ behind a registered gate"
// treatment _tests_/bit/baremaplit.bit documents for its own surface. So this
// drives the CLI directly instead.
//
// WIRED INTO `./make test` as `test-forofarrow` (tools/build/gatestable2.bit).

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"
import { parseInt, trimSpace } from "std/strings"

const defaultTimeoutS: int = 60
const maxTimeoutMs: int = 6000000

// `viaArrow` counts the 4 items (3,2,1,0); `drain` is the plain-fn form of the
// same loop and sums them (6).
const wantOut: string = "arrow=4 fn=6\n"

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("forofarrow: ${name} is not set — refusing to guess.\n")
    exit(2)
  }
  return v
}

fn timeoutMs(): int {
  let raw = trimSpace(envOr("BIT_TEST_TIMEOUT_S", ""))
  if (raw == "") {
    return defaultTimeoutS * 1000
  }
  let s = parseInt(raw) catch _ {
    return defaultTimeoutS * 1000
  }
  if (s <= 0 || s * 1000 > maxTimeoutMs) {
    return maxTimeoutMs
  }
  return s * 1000
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

// `exit()` does not run pending defers — call this explicitly at every exit
// site instead (same reasoning as baremaplit.bit's teardown).
fn teardown(scratch: string) {
  let shPath = scratch + "/rm.sh"
  writeFile(shPath, "#!/bin/sh\nrm -rf '${scratch}'\n") catch _ {
    return
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    return
  }
  osRunBounded(shPath, timeoutMs())
}

fn die(scratch: string, msg: string, code: int) {
  eprint("forofarrow: ${msg}\n")
  teardown(scratch)
  exit(code)
}

// The program under test, in the shape of the ticket: `with` hands the arrow a
// `Src`, the arrow's `t` has no annotation, and `t.pages()?` is the iterable.
fn fixtureSrc(): string {
  return "class Pages {\n" +
    "  n: i64\n" +
    "  next(): Option<i64>! {\n" +
    "    if (this.n < 0) {\n" +
    "      return Option.None\n" +
    "    }\n" +
    "    this.n = this.n - 1\n" +
    "    return Option.Some(this.n + 1)\n" +
    "  }\n" +
    "}\n\n" +
    "class Src {\n" +
    "  n: i64\n" +
    "  pages(): Pages {\n" +
    "    return Pages{ n = this.n }\n" +
    "  }\n" +
    "}\n\n" +
    "fn with(s: Src, f: (Src) => i64!): i64! {\n" +
    "  return f(s)?\n" +
    "}\n\n" +
    "fn drain(s: Src): i64! {\n" +
    "  let sum: i64 = 0\n" +
    "  for x of s.pages()? {\n" +
    "    sum = sum + x\n" +
    "  }\n" +
    "  return sum\n" +
    "}\n\n" +
    "fn viaArrow(s: Src): i64! {\n" +
    "  return with(s, (t) => {\n" +
    "    let sum: i64 = 0\n" +
    "    for _ of t.pages()? {\n" +
    "      sum = sum + 1\n" +
    "    }\n" +
    "    return sum\n" +
    "  })?\n" +
    "}\n\n" +
    "fn main() {\n" +
    "  let s = Src{ n = 3 }\n" +
    "  let a = viaArrow(s) catch _ {\n" +
    "    -1\n" +
    "  }\n" +
    "  let b = drain(s) catch _ {\n" +
    "    -1\n" +
    "  }\n" +
    "  print(\"arrow=\${a} fn=\${b}\\n\")\n" +
    "}\n"
}

// Writes `script` to `dir/<name>.sh`, runs it, and returns its exit code.
fn runScript(dir: string, name: string, script: string): int {
  let shPath = dir + "/" + name + ".sh"
  writeFile(shPath, script) catch e {
    die(dir, "cannot write ${shPath}: ${e.message()}", 2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    die(dir, "cannot chmod ${shPath}", 2)
  }
  return osRunBounded(shPath, timeoutMs())
}

fn main() {
  let bin = requiredEnv("BIT_BIN")
  let stdlib = requiredEnv("BIT_STDLIB")
  let libbitrt = requiredEnv("BIT_LIBBITRT")
  let scratch = envOr("TMPDIR", "/tmp") + "/bit-forofarrow-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("forofarrow: cannot create scratch directory ${scratch}: ${e.message()}\n")
    exit(2)
  }
  let srcPath = scratch + "/fixture.bit"
  writeFile(srcPath, fixtureSrc()) catch e {
    die(scratch, "cannot write ${srcPath}: ${e.message()}", 2)
  }
  let outPath = scratch + "/fixture_out"
  let errPath = scratch + "/build.err"
  let buildCode = runScript(
    scratch, "build",
      "#!/bin/sh\nBIT_STDLIB=" +
      shQuote(stdlib) +
      "\nexport BIT_STDLIB\nBIT_LIBBITRT=" +
      shQuote(libbitrt) +
      "\nexport BIT_LIBBITRT\nexec " +
      shQuote(bin) +
      " build " +
      shQuote(srcPath) +
      " -o " +
      shQuote(outPath) +
      " > /dev/null 2> " +
      shQuote(errPath) +
      "\n",
  )
  if (buildCode != 0) {
    let err = readFile(errPath) catch _ {
      ""
    }
    die(scratch, "FAIL — fixture failed to build (exit ${buildCode}):\n${err}", 1)
  }
  let runOut = scratch + "/run.out"
  let runCode = runScript(
    scratch,
    "run",
    "#!/bin/sh\nexec " + shQuote(outPath) + " > " + shQuote(runOut) + " 2>&1\n",
  )
  let out = readFile(runOut) catch _ {
    ""
  }
  if (runCode != 0 || out != wantOut) {
    die(
      scratch,
      "FAIL — fixture ran wrong: exit=${runCode}\n  want: ${wantOut}\n  got:  ${out}",
      1,
    )
  }
  teardown(scratch)
  print("PASS forofarrow: a for-of over `it?` inside an arrow with an inferred parameter builds and runs\n")
}
