// _tests_/bit/spawndeferblock.bit — #6717: `spawn { ... }`, `defer { ... }` and
// `spawn`/`defer` of an immediately-called arrow (SPEC §16.1, §18.5).
//
// NOT placed in _tests_/cases/: that corpus is swept by every
// scripts/selfhost-diff*.sh differential (CORPUS="stdlib examples
// _tests_/cases _tests_/imports" in scripts/selfhost-diffdump.sh) against the
// PINNED STAGE0 oracle, and stage0 refuses this surface (E0092 for the arrow
// call, a parse error for the block), so the file would score MISMATCH by
// construction. Same rule as _tests_/bit/forofiterator.bit (#5585). The fixture
// is a program that asserts its own results and exits non-zero on the first
// mismatch, so `bit run` is the whole harness.
//
// What it pins:
//   - a `defer` block captures like a closure (it reads the variable as it
//     stands when the function exits), two blocks replay LIFO, and a block
//     deferred after an early `return` never registered so never runs;
//   - a `defer` block inside a bare `{ }` still runs at the function's exit,
//     not at the end of the inner block (§18.5);
//   - the arguments of a deferred arrow call are evaluated at the `defer`
//     statement, not at the exit (§18.5);
//   - a `spawn` block runs on its own thread with its captured locals, handles
//     a fallible call's error in place with `catch`, and may `defer` inside;
//   - `spawn (() => ...)()` and `spawn ((a, b) => ...)(x, y)` evaluate the
//     arguments on the spawning thread.
//
// WIRED INTO `./make test` as `test-spawndeferblock` (tools/build/gatestable2.bit,
// tools/build/defs.bit).

import { exit } from "std/os"

class boom {
  message(): string { return "boom" }
}

class Log {
  items: []string,
}

fn risky(n: int): int! {
  if (n > 1) {
    fail boom{}
  }
  return n
}

fn expect(name: string, got: string, want: string) {
  if (got == want) {
    return
  }
  eprint("spawndeferblock: ${name}: got '${got}', want '${want}'\n")
  exit(1)
}

fn joined(xs: []string): string {
  let out = ""
  for x of xs {
    out = out + x + ","
  }
  return out
}

fn lifo(log: Log) {
  let tag = "a"
  defer {
    log.items = append(log.items, "first ${tag}")
  }
  defer {
    log.items = append(log.items, "second ${tag}")
  }
  tag = "b"
  log.items = append(log.items, "body")
}

fn earlyReturn(log: Log, stop: bool) {
  defer {
    log.items = append(log.items, "outer")
  }
  if (stop) {
    return
  }
  defer {
    log.items = append(log.items, "inner")
  }
  log.items = append(log.items, "tail")
}

fn arrowArgs(log: Log) {
  let n = 1
  defer ((v: int) => {
    log.items = append(log.items, "arg ${v} now ${n}")
  })(n)
  n = 2
}

fn deferInBlock(log: Log) {
  {
    defer {
      log.items = append(log.items, "scoped")
    }
  }
  log.items = append(log.items, "after")
}

fn spawnForms(): int {
  let ch = chan<int>(8)
  let base = 10
  spawn {
    let v = risky(base) catch _ {
      -1
    }
    ch <- v
  }
  spawn {
    let v = risky(1) catch _ {
      -1
    }
    ch <- v
  }
  spawn (() => {
    ch <- base * 2
  })()
  spawn ((a: int, b: int) => {
    ch <- a * 100 + b
  })(base + 1, 3)
  spawn {
    defer {
      ch <- 1000
    }
    ch <- 0
  }
  let sum = 0
  let i = 0
  while (i < 6) {
    sum = sum + <- ch
    i = i + 1
  }
  return sum
}

fn main() {
  let log = Log{ items = []string(0) }
  lifo(log)
  expect("lifo", joined(log.items), "body,second b,first b,")

  log = Log{ items = []string(0) }
  earlyReturn(log, true)
  expect("early return", joined(log.items), "outer,")

  log = Log{ items = []string(0) }
  earlyReturn(log, false)
  expect("fall through", joined(log.items), "tail,inner,outer,")

  log = Log{ items = []string(0) }
  arrowArgs(log)
  expect("arrow args", joined(log.items), "arg 1 now 2,")

  log = Log{ items = []string(0) }
  deferInBlock(log)
  expect("bare block", joined(log.items), "after,scoped,")

  // -1 (risky(10) caught) + 1 (risky(1)) + 20 + 1103 + 0 + 1000
  expect("spawn", "${spawnForms()}", "2123")
  print("ok\n")
}
