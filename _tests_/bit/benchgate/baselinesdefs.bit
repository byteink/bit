// _tests_/bit/benchgate/baselinesdefs.bit — the shared scaffolding for the
// benchmark regression gate's per-platform baseline tables: the `Baseline`
// record every table is built from, `platformName` and the `baselinesFor`
// selector.
//
// #4067 split these out of `baselines.bit`, which sat at 799 of the 800-line
// E0200 limit with this ticket still owing per-case notes on six more cases.
// Sibling in the same directory module as `baselines.bit`,
// `baselineslinux.bit`, `benchgate.bit` and `benchrun.bit`: no `import`, one
// shared scope, so `baselinesFor` still sees `baselinesMacosArm64` (in
// `baselines.bit`) and `baselinesLinuxX64`/`baselinesLinuxArm64` (in
// `baselineslinux.bit`) exactly as before. Pure move — every declaration and
// every calibration comment came across verbatim; the only new text is the
// #4067 policy note below, which belongs with the record it describes.
// Name resolution here is order-independent (see CLAUDE.md), so this file's
// name is chosen for readability, not for load order.

class Baseline {
  name: string,
  expected: string,
  cpuCentis: int,
  rssBytes: int,
  // 0 means "do not set BIT_GC_MIN_KB; inherit the runtime's own default".
  // Non-zero pins the GC trigger floor explicitly for this case's run so its
  // RSS does not silently drift if a future ticket changes the default
  // (#2920 already moved it once). See the "churn" case below (#2978).
  gcMinKb: int,
  // CPU ceiling as a percentage of cpuCentis (150 = 1.5x, the file's blanket
  // default -- see ceiling() above). RSS always uses the blanket 1.5x
  // regardless of this field; only CPU reads it, via cpuCeiling(). fib
  // overrides this to 190 (#2982) -- see its baseline-table comment.
  cpuCeilingPct: int,
  // Allocated object count baseline: `swept+live` from one `BIT_GC_STATS=1`
  // run (#3130). Unlike cpuCentis/rssBytes this is EXACTLY deterministic --
  // the same binary reports the identical count on every run, verified 5x on
  // every macOS/arm64 case below (readings pasted in #3130's ticket comment)
  // -- so its guard is TWO-SIDED via objCeiling()/objFloor() in
  // benchgate.bit, at a blanket [0.5x, 1.05x] band (objFloorPct/objCeilPct):
  // it fails on a regression (more objects than recorded) AND on an
  // unrecorded improvement (fewer objects than recorded), forcing a
  // re-baseline rather than letting a win silently protect nothing. -1 means
  // "not measured on this platform" -- the band check is skipped for that
  // case (see runCase), but the BIT_GC_STATS line itself is still required
  // unconditionally on every platform; a missing or malformed line is always
  // a hard fail regardless of this field's value.
  objects: int,
}

// #4067 re-recorded every rssBytes and objects entry in the macOS/arm64 table
// below, under ONE policy:
//   rssBytes := min(value already on file, MEDIAN of 30 readings)
//   objects  := the measured value exactly -- it is deterministic, no ratchet
// 30 = two independent 15-round round-major sessions (all 12 cases per round,
// so a transient hits every case, not one case's block), boxlock solo,
// make-driver 0 across 67 continuous samples, the gate's own instrument. Both
// sessions' medians were byte-identical. Readings are on #4067.
// HEADROOM stays ceiling()'s blanket 1.5x: the worst single reading above its
// own median over 30 reps was +0.601% (sort), 10 of 12 cases had max ==
// median, and each case's whole range spans one or two 16 KB pages -- so 1.5x
// is ~80x the worst excursion, and the gate compares the MIN of 3, which is
// <= the median. DOWNWARD-ONLY because seven cases measured 0.3-8.4% ABOVE
// the value on file; raising a guard that is not flapping only loosens it, so
// those keep their number and carry their measured median as a comment.

// #4318 did the CPU half, which #4067 deliberately left alone, and it needs
// its OWN policy: user CPU is load-sensitive where peak RSS is not (see
// benchgate.bit's "WHY USER CPU IS NOT IMMUNE TO CONTENTION" header, #3017),
// so a quiet-box median cannot simply be dropped in as a baseline the way an
// RSS median can. The two fields move TOGETHER:
//   cpuCentis     := min(median of 30, the gate's own min-of-3 on the same
//                        tree). Downward-only, never raised. caseStrmap's
//                        block set that precedent -- a baseline the gate has
//                        already beaten guards nothing.
//   cpuCeilingPct := the percentage that makes cpuCeiling() equal
//                        min(the ceiling already on file,
//                            max(1.5 x cpuCentis, cpuCentis + 18cs))
// NEITHER FIELD ALONE WORKS, which is why this is a policy and not a
// re-record. Re-recording cpuCentis alone keeps each case's old percentage
// and so over-tightens the small cases into flapping (trustcache at 2cs and
// 250% is a 5cs ceiling against a 2cs cost). Lowering cpuCeilingPct alone
// leaves baselines 1.3-13.7x above the real cost, which makes the per-case
// line the gate prints unreadable as drift -- #2931 prints it precisely so a
// slow approach to the ceiling is visible before it trips -- and freezes
// yesterday's cost as tomorrow's licence.
// THE +18cs CLAUSE IS THE LOAD TERM, AND IT IS ABSOLUTE, NOT PROPORTIONAL,
// because this host's scheduling noise is: #2982 measured fib at 43cs
// against a 29cs baseline (+14cs) on a box carrying 1-3 sibling make-driver
// builds, and #3129 measured map at 96cs against 49cs (+47cs) at load 17.7.
// 18 covers the first with 4cs to spare. The second is out of this gate's
// scope by its own deployment: #2982's note above rules load 17.7+
// unrepresentative, and #3869 marked test-benchgate `exclusive: true`, so
// nothing else in `./make test` runs beside it. Measured spread over 30
// readings per case on a solo box (two independent 15-round round-major
// sessions, #4318): the worst excursion above any case's own median was
// +2cs, and the two sessions' medians agreed within 1cs on all 13 cases.
// THE `min(ceiling already on file, ...)` CLAUSE IS A PURE RATCHET: a
// re-recorded baseline must never LOOSEN an arm in absolute centiseconds. It
// binds on exactly one case, allocflat, whose 4cs baseline would have taken
// its ceiling 17 -> 22cs; it keeps 17.
// WHAT IT BUYS, and the honest half of it: at the costs measured on
// `2ca569e0`, ZERO of the 13 macOS/arm64 cases could fail on an exact
// doubling of their own cost; 8 of 13 now can. The other five (allocflat 4cs,
// map 6cs, sort 6cs, churn 7cs, trustcache 2cs) each cost LESS than the 18cs
// noise term, so no CPU ceiling on this host can see them double -- that is
// caseMap's own long-standing argument, restated with today's numbers rather
// than overwritten, and for all five the two-sided `objects` band is the
// tight guard while CPU stays a coarse backstop.

// Baselines are per-platform (#2933): a Skylake-class x86_64-linux box is
// nowhere near an Apple Silicon Mac's per-instruction throughput, and using
// one table for both turned every real-Linux run of this gate into a false
// positive. Keyed on `hostTarget()`'s ordinal — BOTH platform and
// architecture, never `uname -s` alone — because scripts/arm64gate.sh runs
// this gate on aarch64-linux, whose numbers are nothing like x86_64-linux's;
// a table keyed on "linux" would compare aarch64 against an x86_64 baseline
// and produce a confidently wrong verdict. See hostTriple() in
// _tests_/bit/pathresolve.bit for the same ordinal spelled as a triple.
fn platformName(target: int): string {
  if (target == 0) {
    return "linux/x86_64"
  }
  if (target == 1) {
    return "linux/aarch64"
  }
  if (target == 2) {
    return "macos/aarch64"
  }
  return "unknown hostTarget() ordinal ${target}"
}

// Selects the baseline table for the host this gate is actually running on.
fn baselinesFor(target: int): []Baseline {
  if (target == 0) {
    return baselinesLinuxX64()
  }
  if (target == 1) {
    return baselinesLinuxArm64()
  }
  if (target == 2) {
    return baselinesMacosArm64()
  }
  return []
}

// --- the string-flip debt list (#4508) ---------------------------------

// The cases whose flip-on object count is WORSE than their recorded flip-off
// `Baseline.objects`, i.e. #3901's remaining debt on macOS/arm64. Measured on
// main `e552d150`; the readings are in `baselinesflip.bit`'s header.
//
// This is the list #3901 exists to empty. An empty list means every case
// under the flip arm allocates no more with the flip on than without it,
// which is the shippability question stated as a value the gate can read.
fn flipDebt(): []string {
  return ["json"]
}

fn inFlipDebt(name: string): bool {
  for s of flipDebt() {
    if (s == name) {
      return true
    }
  }
  return false
}

// Checks `flipDebt()` in BOTH directions for one case, returning "" when the
// list is honest about it and a failure message when it is not. Called from
// `checkFlipObjects` in `benchgate.bit` with the case's MEASURED flip-on
// count, never the table value, so the list is checked against what the
// compiler under test actually does.
//
// Both directions matter and neither is redundant. A child of #3901 that
// fixes `json` turns this RED until "json" is deleted from the list above --
// so the debt cannot shrink silently, and it cannot be over-claimed either: a
// case removed from the list while it is still allocating more than its
// flip-off baseline fails just as loudly. A one-directional check would let
// one of those two through.
//
// `baseObjects < 0` is `Baseline.objects`'s "not measured on this platform"
// sentinel (see its field comment above). There is nothing to compare against
// then, and `flipObjects > -1` would be true for every reading, wrongly
// demanding that every case be listed as debt. Not reachable today --
// `flipObjectsFor` returns -1 off macOS/arm64, where every case has a
// recorded count -- and guarded rather than asserted because a future
// platform's table is the likely way it becomes reachable.
fn flipDebtViolation(name: string, flipObjects: int, baseObjects: int): string {
  if (baseObjects < 0) {
    return ""
  }
  let listed = inFlipDebt(name)
  let worse = flipObjects > baseObjects
  if (listed && !worse) {
    return "${name}: flip-on object count ${flipObjects} is no worse than its flip-off " +
      "baseline ${baseObjects}, but ${name} is still in flipDebt() — delete it from the " +
      "list in _tests_/bit/benchgate/baselinesdefs.bit"
  }
  if (!listed && worse) {
    return "${name}: flip-on object count ${flipObjects} exceeds its flip-off baseline " +
      "${baseObjects}, but ${name} is not in flipDebt() — either fix the regression or " +
      "add it to the list in _tests_/bit/benchgate/baselinesdefs.bit"
  }
  return ""
}
