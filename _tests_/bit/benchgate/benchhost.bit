// _tests_/bit/benchgate/benchhost.bit -- the CPU-axis verdict of the benchmark
// regression gate: the descheduled-time check (#5196) and, since #6413, the
// host-speed reference workload. Sibling of `benchgate.bit` in the same
// directory module: no `import`, one shared scope. `wasDescheduled`,
// `checkCpu` and `cpuReport` moved here VERBATIM from `benchgate.bit`, which
// was at 787 of its 800 lines; see that file's header for the design
// rationale.

// #5196: `gap` is the wall-clock time this rep's process spent off a core
// (real minus total CPU, from the SAME `/usr/bin/time -l` reading or Linux
// timestamp pair — see benchrun.bit's DESCHEDULE DETECTION note), `-1` when
// unavailable. Reuses `ceiling()` — the SAME 1.5x margin this file already
// trusts for the CPU/RSS regression bar above, not a second, independently
// guessed constant — against `cpu` instead of a baseline: `cpu + gap` is
// this rep's wall-clock time (real), so the check is real > 1.5x cpu, i.e.
// this rep spent at least as much wall time waiting for a core as it did
// running on one, beyond the modest headroom `ceiling()` already treats as
// noise everywhere else in this file. Self-relative and dimensionless (no
// load average, no core count) and it scales with the case's own reading
// rather than an absolute noise floor sized for one case — verified live on
// 2026-09-16 under real, unforced contention from a peer agent's #5322
// reproduction: mandelbrot and json breached ceiling with gap 0-1cs (their
// min-cpu rep ran uninterrupted) and correctly stayed FAIL; matrix and
// strmap breached ceiling with gap 44-45cs against cpu 53cs (real ~98/97cs,
// cpu*1.5 ~79/79cs) and correctly opened INCONCLUSIVE.
//
// IT CANNOT OPEN AT ALL FOR A MULTI-THREADED CASE, AND THAT IS STRUCTURAL
// (#5732). `gap` is computed as `real - user - sys` and clamped at 0
// (benchrun.bit's darwinMeasureBranch/linuxMeasureBranch). The premise above
// — "`real` cannot be LESS than total CPU" — holds only while the process
// occupies at most one core. With N mutator threads total CPU runs up to N x
// real, so the subtraction is negative on every rep and the clamp reports 0:
// measured on bench/cases/allocpar (8 workers), gap was 0 on 45 of 45
// readings, quiet and loaded alike, while single-threaded `alloc` on the same
// box and the same instrument reported 0-46cs. So for a multi-mutator case
// this valve is welded shut and every over-ceiling CPU reading is a hard
// FAIL, contention or not — which is why allocpar's CPU is not gated at all
// rather than gated behind a valve that cannot open; see the MULTI-MUTATOR
// CPU note on `Baseline.cpuCentis` in baselinesdefs.bit.
fn wasDescheduled(gap: int, cpu: int): bool {
  return gap >= 0 && cpu + gap > ceiling(cpu)
}

// One case's CPU arm. Split out of reportAndCheck() (#5732) so the opt-out
// below is one guard in one place rather than a third condition on a
// function that already carries the deschedule branch.
//
// `Baseline.cpuCentis < 0` means this case's user CPU is NOT GATED — see
// that field's MULTI-MUTATOR CPU note in baselinesdefs.bit for the policy
// and the readings behind it. The reading is still taken and still printed
// by reportAndCheck() below; only the comparison is skipped, so the suite
// log still carries a real number for whoever re-baselines it.
fn checkCpu(b: Baseline, m: CaseMetrics, t: Tally) {
  if (b.cpuCentis < 0) {
    return
  }
  // CPU reads its own per-case ceiling (#2982); RSS always uses the blanket
  // 1.5x — see cpuCeiling()'s and Baseline.cpuCeilingPct's comments above.
  let cpuCeil = cpuCeiling(b)
  if (m.minCpu <= cpuCeil) {
    return
  }
  // #5196: contention can only ever inflate user CPU (see WHY USER CPU IS
  // NOT IMMUNE TO CONTENTION above), so an over-ceiling reading taken on a
  // rep the SAME measurement shows was descheduled for longer than it ran
  // cannot be told apart from a real regression — report INCONCLUSIVE,
  // naming the gap, and do not fail the gate for it. A reading whose own
  // rep ran without interruption is unchanged: FAIL.
  if (wasDescheduled(m.gapAtMin, m.minCpu)) {
    markInconclusive(
      t,
        "${b.name} user CPU regressed: ${m.minCpu}cs (min of ${reps}), " +
        "baseline ${b.cpuCentis}cs, ceiling ${cpuCeil}cs (${b.cpuCeilingPct}%), " +
        "descheduled ${m.gapAtMin}cs of wall time on that rep — " +
        "host contention or a genuine regression; re-run on a quiet host to tell them apart",
    )
    return
  }
  markFail(
    t,
      "${b.name} user CPU regressed: ${m.minCpu}cs (min of ${reps}), " +
      "baseline ${b.cpuCentis}cs, ceiling ${cpuCeil}cs (${b.cpuCeilingPct}%)",
  )
}

// The `cpu=` field of the per-case line below, which prints for every case
// whether or not checkCpu() above judges it (#5732): an ungated axis must
// say so in the log rather than print a ceiling nothing is compared to.
fn cpuReport(b: Baseline, minCpu: int): string {
  if (b.cpuCentis < 0) {
    return "cpu=${minCpu}cs (NOT GATED — see cpuCentis in baselinesdefs.bit)"
  }
  return "cpu=${minCpu}cs (baseline ${b.cpuCentis}cs, ceiling ${cpuCeiling(b)}cs)"
}
