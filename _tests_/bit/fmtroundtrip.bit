// #3724: no gate checked that `bit fmt` PRESERVES program meaning across the
// corpus. #3718 and #3719 (both fixed) were formatter printers that silently
// dropped or corrupted parser-meaningful content — one deleted `@threadlocal`
// entirely, turning per-thread storage into shared storage with no
// diagnostic. Neither was caught by any existing gate: `test-differentials`
// (scripts/selfhost-diffall.sh) compares this compiler against ITSELF on the
// same already-mangled file, so a shared printer bug is invisible to it, and
// `--dump-ir`/`--dump-ir-pre` only walk function BODIES — a top-level
// declaration's storage class is never represented there at all.
//
// The check, per file, independent of every other file (gofmt's contract,
// same as `fmtOneFile`):
//   1. `--dump-ast` the ORIGINAL file, untouched, straight out of the repo.
//   2. Copy its bytes into a scratch file; run `bit fmt` (write mode, NOT
//      `--check`) on the COPY — never on the real path, which this gate must
//      never mutate.
//   3. `--dump-ast` the formatted copy.
//   4. Compare. Any difference means `bit fmt` changed program meaning: FAIL,
//      naming the file.
//
// `--dump-ast` (compiler/ast.bit's `dumpNode`) is the only dump surface fit
// for this: it emits tag names, operator symbols, the `@threadlocal` marker
// and literal leaf text sliced from source — NO line/col/byte-offset, and
// (verified against compiler/ast.bit) no file path either. A real reformat
// legitimately shifts token positions and moves the file to a different
// tmpdir path; `--dump-tokens` (raw byte offsets) and `--dump-types`/
// `--dump-diags` (line:col + quoted source line) would both score a false
// divergence on every single reformatted file. `--dump-ast` cannot.
//
// NO MANIFEST for the corpus's deliberately-malformed fixtures
// (_tests_/cases/lex_invalid_*.bit, _tests_/bit/checkercases/*, and siblings) —
// this gate does not need one. `bit fmt`'s own exit code IS the classifier:
// `formatSource` (compiler/fmt.bit) explicitly checks `hasErrors(d)` on a
// diagnostics collector and refuses (nonzero exit) on any lex/parse error,
// so a file `bit fmt` cannot format is skipped, not failed. `--dump-ast`
// itself CANNOT be used for this classification — verified against
// compiler/main.bit's `dumpAstCmd`, which calls the bare `parseSource` with
// no diagnostics collector at all and never checks for errors, so it
// "succeeds" (exit 0, some error-recovery tree) even on a file `bit fmt`
// correctly refuses. Classifying on `bit fmt`'s exit code side-steps that
// entirely: a manifest can drift (too narrow, too wide — #3703's own design
// note); an exit code cannot.
//
// SCOPE: the nine top-level trees that hold `.bit` sources — compiler,
// runtime, stdlib, tools, _tests_, examples, pkg, bench, editors (verified via
// `git ls-files '*.bit' | cut -d/ -f1 | sort -u`, 2026-08-26) — deliberately
// NOT a walk from the repo root, which would also descend into
// `bit-out/stage0` (a pinned oracle snapshot, not this repo's source, ~300
// unrelated `.bit` files) and into `.claude/worktrees/*` (OTHER agents'
// in-progress checkouts, nondeterministic and none of this gate's business).
//
// BIT_REPO IS REQUIRED, same reason as every sibling in this directory: the
// harness points at `${BIT_REPO}/<tree>` for each of the nine trees above and
// must not silently default to ".".
//
// SECOND PROPERTY, #4752: `bit fmt` reaches its FIXPOINT IN ONE PASS. The
// corpus loop above cannot check that, and neither can a `// fmt` golden in
// _tests_/cases: `test-fmt-cases` requires every `.bit` file in that tree to
// be `bit fmt --check` canonical, and a canonical file is a fixpoint by
// definition, so the input a two-pass bug needs (a comma list the source did
// NOT break, which the formatter then breaks) can never be checked in there.
// `checkFixpoint` below therefore carries each source inline, formats it
// twice in the scratch dir and demands byte-identical output -- with an
// anti-vacuity check that the fixture is genuinely reformatted by the first
// pass, so it cannot quietly decay into a no-op the way a canonicalised
// fixture would.
//
// Run it from the repository root:
//     ./bit-out/bin/bit run _tests_/bit/fmtroundtrip.bit
import { env, envOr, exit } from "std/os"
import { exists, isDir, mkdir, readFile, writeFile, walk } from "std/fs"
import { hasSuffix, parseInt } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// Power of 10 rule 2: `walk` (std/fs) already bounds its own recursion depth;
// this is a second, independent ceiling on the TOTAL file count this gate
// will ever process, so a misconfigured root cannot turn into an unbounded
// scan.
const maxTotalFiles: int = 8192

fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "300")) catch _ {
    300
  }
  if (s <= 0) {
    return 300000
  }
  return s * 1000
}

// Runs `script` through /bin/sh and returns its exit code. Negative returns
// are `osRunBounded`'s mechanism channel, never a program exit status, so
// each one is a named panic rather than a value any assertion could consume.
fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    fail newError("fmtroundtrip: cannot make script executable: ${scriptPath}")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == -2) {
    panic("fmtroundtrip: TIMED OUT after ${ms}ms running ${scriptPath}")
  }
  if (code == -1) {
    panic("fmtroundtrip: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("fmtroundtrip: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}

fn requiredEnv(name: string): string! {
  let v = env(name)
  if (len(v) == 0) {
    fail newError("fmtroundtrip: ${name} is required and was not set")
  }
  return v
}

fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

// `bit fmt <path>` (write mode, no `--check`) on a scratch copy. Returns its
// exit code only: 0 means the copy is now canonical and safe to `--dump-ast`;
// nonzero means `path` does not parse and this file is out of scope for a
// round-trip (there is nothing to compare against).
fn runFmtWrite(bit: string, path: string, capDir: string, ms: int): int! {
  let codePath = "${capDir}/fmtcode.txt"
  let script = "#!/bin/sh\n" +
    "'${bit}' fmt '${path}' > /dev/null 2>/dev/null\n" +
    "echo $? > '${codePath}'\n" +
    "exit 0\n"
  let sh = shell("${capDir}/fmtrun.sh", script, ms)?
  if (sh != 0) {
    fail newError("fmtroundtrip: wrapper script exited ${sh}, which it never should")
  }
  if (!exists(codePath)) {
    fail newError("fmtroundtrip: no exit code was recorded — the run never happened")
  }
  return parseInt(trimWs(readFile(codePath)?))?
}

// `bit fmt --check <path>` on a scratch file already on disk. Returns its
// exit code only, the same contract as `runFmtWrite` — 0 means canonical.
fn runFmtCheck(bit: string, path: string, capDir: string, ms: int): int! {
  let codePath = "${capDir}/fmtcheckcode.txt"
  let script = "#!/bin/sh\n" +
    "'${bit}' fmt --check '${path}' > /dev/null 2>/dev/null\n" +
    "echo $? > '${codePath}'\n" +
    "exit 0\n"
  let sh = shell("${capDir}/fmtcheckrun.sh", script, ms)?
  if (sh != 0) {
    fail newError("fmtroundtrip: wrapper script exited ${sh}, which it never should")
  }
  if (!exists(codePath)) {
    fail newError("fmtroundtrip: no exit code was recorded — the run never happened")
  }
  return parseInt(trimWs(readFile(codePath)?))?
}

// One `--dump-ast <path>` invocation, as seen from outside it.
class DumpRun { code: int, text: string }

fn runDumpAst(bit: string, path: string, capDir: string, ms: int): DumpRun! {
  let outPath = "${capDir}/dumpout.txt"
  let codePath = "${capDir}/dumpcode.txt"
  let script = "#!/bin/sh\n" +
    "'${bit}' --dump-ast '${path}' > '${outPath}' 2>/dev/null\n" +
    "echo $? > '${codePath}'\n" +
    "exit 0\n"
  let sh = shell("${capDir}/dumprun.sh", script, ms)?
  if (sh != 0) {
    fail newError("fmtroundtrip: wrapper script exited ${sh}, which it never should")
  }
  if (!exists(codePath)) {
    fail newError("fmtroundtrip: no exit code was recorded — the run never happened")
  }
  let code = parseInt(trimWs(readFile(codePath)?))?
  let text = readFile(outPath) catch _ {
    ""
  }
  return DumpRun{ code: code, text: text }
}

// One file's verdict. `status` is "match", "mismatch" or "skip" (does not
// parse, out of scope for a round-trip).
class Verdict { status: string, path: string }

// The nine top-level trees holding `.bit` sources (see header for how this
// list was derived and why it is not a root-wide walk).
fn corpusRoots(): []string {
  return [
    "compiler",
    "runtime",
    "stdlib",
    "tools",
    "_tests_",
    "examples",
    "pkg",
    "bench",
    "editors",
  ]
}

class FileRef { full: string, rel: string }

fn collectBitFiles(repo: string): []FileRef! {
  let out = []FileRef(0)
  for root of corpusRoots() {
    let full = "${repo}/${root}"
    if (!exists(full) || !isDir(full)) {
      panic("fmtroundtrip: no such directory: ${full}")
    }
    let before = len(out)
    for p of walk(full)? {
      if (hasSuffix(p, ".bit")) {
        out = append(out, FileRef{ full: p, rel: p[len(repo) + 1:] })
      }
    }
    if (len(out) == before) {
      panic("fmtroundtrip: ${full} contains zero .bit files — refusing a vacuous scan")
    }
    if (len(out) > maxTotalFiles) {
      panic("fmtroundtrip: ${len(out)} .bit file(s) found, over the ${maxTotalFiles} bound")
    }
  }
  return out
}

// One file's round-trip check. See the header for the full contract: a file
// `bit fmt` refuses is "skip", not a failure; a genuine dump-ast failure on
// either side after a successful format is a contradiction, not a skip.
fn checkFile(bit: string, f: FileRef, capDir: string, ms: int): Verdict {
  let src = readFile(f.full) catch e {
    panic("fmtroundtrip: cannot read ${f.full}: ${e.message()}")
  }
  let scratch = "${capDir}/work.bit"
  writeFile(scratch, src) catch e {
    panic("fmtroundtrip: cannot write scratch copy for ${f.rel}: ${e.message()}")
  }
  let rc = runFmtWrite(bit, scratch, capDir, ms) catch e {
    panic("fmtroundtrip: ${e.message()}")
  }
  if (rc != 0) {
    return Verdict{ status: "skip", path: f.rel }
  }
  let dOrig = runDumpAst(bit, f.full, capDir, ms) catch e {
    panic("fmtroundtrip: ${e.message()}")
  }
  if (dOrig.code != 0) {
    panic("fmtroundtrip: --dump-ast exited ${dOrig.code} on ${f.rel} after `bit fmt` succeeded on identical content — contradiction")
  }
  let dFmt = runDumpAst(bit, scratch, capDir, ms) catch e {
    panic("fmtroundtrip: ${e.message()}")
  }
  if (dFmt.code != 0) {
    panic("fmtroundtrip: --dump-ast exited ${dFmt.code} on the FORMATTED copy of ${f.rel} — `bit fmt` produced unparseable output")
  }
  if (dOrig.text != dFmt.text) {
    return Verdict{ status: "mismatch", path: f.rel }
  }
  return Verdict{ status: "match", path: f.rel }
}

fn newCapDir(): string {
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  return "${tmp}/bit-fmtroundtrip-${uuidFormat(uuidV4())}"
}

fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}

fn teardown(dir: string, ms: int) {
  shell("${dir}/rm.sh", "#!/bin/sh\nrm -rf '${dir}'\n", ms) catch _ {
    return
  }
}

fn printMismatches(paths: []string) {
  eprint("  file(s) where `bit fmt` changed program meaning:\n")
  for p of paths {
    eprint("    ${p}\n")
  }
}

// The #4752 fixture, reduced from the reported case
// (`git show b96932ff:stdlib/time/business.test.bit`): a call argument list
// the source left unbroken, holding a nested call, as the left operand of a
// comparison inside another call's argument list. The first pass has to
// break the outer argument list; the count of that break used to be polluted
// by a WIDTH TRIAL the formatter then threw away, so `fmtTryChainNestedWrap`
// (compiler/fmtwrap.bit) saw two breaks where one landed and took the
// operator wrap instead, which a second pass then undid.
fn fixpointSource(): string {
  return "fn chainTrialBreak(mon: Day, nextMon: Day) {\n" +
    "  assert(\n" +
    "    mon.differenceInBusinessDays(businessTestOneHoliday(weekendSatSun(), " +
    "businessTestDate(2026, 9, 16)), nextMon) == 4,\n" +
    "    \"one holiday inside the week takes it to 4\",\n" +
    "  )\n" +
    "}\n"
}

// Writes `src` to `path`, formats it in place, and returns what `bit fmt`
// left there. A non-zero exit is a hard failure here, unlike the corpus loop
// above: this source is known-parseable, so `fmt` refusing it is a defect,
// never a skip.
fn fmtOnce(bit: string, path: string, src: string, capDir: string, ms: int): string! {
  writeFile(path, src)?
  let rc = runFmtWrite(bit, path, capDir, ms)?
  if (rc != 0) {
    fail newError("fmtroundtrip: `bit fmt` exited ${rc} on an inline fixture")
  }
  return readFile(path)?
}

// The #4956 fixture: a call whose LAST argument is an arrow function with a
// comment-only body, written compact, with an earlier argument long enough
// that the head cannot fit the width budget — so the argument list breaks
// whatever the trailing-arrow rule does. The first pass used to leave `srcPos`
// at the end of that earlier argument (an arrow head contributes no node that
// advances it), so the blank-line test inside the now-exploded block measured
// two newlines where the source has one and the SECOND pass inserted a blank
// line after `() => {`.
fn commentBodySource(): string {
  return "fn commentBodyArrow(run: (string, () => ()) => ()) {\n" +
    "  run(\"a label long enough that this call head cannot possibly fit inside the " +
    "hundred column budget\", () => {\n" +
    "    // quiet\n" +
    "  })\n" +
    "}\n"
}

// `fmt(fmt(x))` must equal `fmt(x)` on the FIRST output, for each fixture.
fn checkFixpoint(bit: string, capDir: string, ms: int, ticket: string, src: string) {
  let path = "${capDir}/fixpoint.bit"
  let once = fmtOnce(bit, path, src, capDir, ms) catch e {
    panic("fmtroundtrip: ${e.message()}")
  }
  if (once == src) {
    eprint("fmt-roundtrip: FAIL -- the ${ticket} fixture is already canonical, so it can no longer\n")
    eprint("  catch a two-pass formatter. Give it a source the first pass actually rewrites.\n")
    exit(1)
  }
  let twice = fmtOnce(bit, path, once, capDir, ms) catch e {
    panic("fmtroundtrip: ${e.message()}")
  }
  if (once != twice) {
    eprint("fmt-roundtrip: FAIL -- `bit fmt` needed two passes to reach its fixpoint (${ticket})\n")
    eprint("  after one pass:\n${once}\n  after two:\n${twice}\n")
    exit(1)
  }
}

// The #4968 fixture: a call whose LAST argument is an arrow function with a
// block body keeps that head on one line — callee, earlier arguments and
// `(x) => {` — with the body indented once under it and `})` closing,
// whenever the head fits the width budget. Before #4968 this was split into
// one argument per line.
fn trailingArrowSource(): string {
  return "fn trailingArrow(f: (int, (int) => ()) => (), g: (int) => ()) {\n" +
    "  f(1, (x) => {\n" +
    "    g(x)\n" +
    "  })\n" +
    "}\n"
}

// A fixture `bit fmt` must leave byte-identical: the canonical spelling of a
// shape the formatter is required to PRODUCE, not merely to survive. The
// corpus loop above cannot state this — it only compares `--dump-ast` — and
// neither can the fixpoint check, whose anti-vacuity rule demands a source
// the first pass rewrites.
fn checkCanonical(bit: string, capDir: string, ms: int, ticket: string, src: string) {
  let path = "${capDir}/canonical.bit"
  let once = fmtOnce(bit, path, src, capDir, ms) catch e {
    panic("fmtroundtrip: ${e.message()}")
  }
  if (once != src) {
    eprint("fmt-roundtrip: FAIL -- ${ticket}: `bit fmt` rewrote a fixture it must leave byte-identical\n")
    eprint("  wanted:\n${src}\n  got:\n${once}\n")
    exit(1)
  }
}

// #3945: one fixture holding every printed JSX shape the ticket names — a
// self-closing element, a multi-attribute element that must break, a
// fragment, nested elements and an expression child, all written jammed
// together so the first pass genuinely rewrites it (`checkFixpoint`'s own
// anti-vacuity rule).
fn jsxAllShapesSource(): string {
  return "fn jsxAllShapes(handleClick: () => ()): () {\n" +
    "  let icon = <Icon name=\"close\"/>\n" +
    "  let panel = <Button onClick={handleClick} disabled tone=\"danger\" wide>\n" +
    "    <Icon name=\"close\"/>\n" +
    "  </Button>\n" +
    "  let frag = <>{icon}{panel}</>\n" +
    "}\n"
}

// Proves the #3945 fixture reaches its fixpoint in one pass (like #4752 and
// #4956 above), then that `bit fmt --check` accepts the fixed point as
// already canonical — the ticket's own acceptance line, checked directly
// rather than inferred from the fixpoint proof alone.
fn checkJsxAllShapes(bit: string, capDir: string, ms: int) {
  checkFixpoint(bit, capDir, ms, "#3945", jsxAllShapesSource())
  let path = "${capDir}/jsxshapes.bit"
  fmtOnce(bit, path, jsxAllShapesSource(), capDir, ms) catch e {
    panic("fmtroundtrip: ${e.message()}")
  }
  let rc = runFmtCheck(bit, path, capDir, ms) catch e {
    panic("fmtroundtrip: ${e.message()}")
  }
  if (rc != 0) {
    eprint("fmt-roundtrip: FAIL -- #3945: `bit fmt --check` exited ${rc} on the fixed-point JSX fixture\n")
    exit(1)
  }
}

// SPEC §12.12's own example of a significant single-space gap between two
// non-text children (`<a/> <b/>`), inside a fragment so it stands alone as
// one expression. `bit fmt` reflows the fragment across several lines
// (three children never stay flat, fmtjsx.bit), which must not touch that
// space: proven the same way the corpus loop above proves every other file
// preserves meaning, since JSX cannot yet be compiled to a program that
// prints anything at runtime (#3944, its desugaring, has not landed) —
// `--dump-ast` before and after must match byte for byte, in particular the
// middle child's `jsx_text` leaf, which must still read exactly `" "`.
fn jsxSignificantSpaceSource(): string {
  return "fn jsxSignificantSpace(): () {\n" + "  let pair = <><a/> <b/></>\n" + "}\n"
}

fn checkJsxSignificantSpace(bit: string, capDir: string, ms: int) {
  let path = "${capDir}/jsxspace.bit"
  writeFile(path, jsxSignificantSpaceSource()) catch e {
    panic("fmtroundtrip: ${e.message()}")
  }
  let dBefore = runDumpAst(bit, path, capDir, ms) catch e {
    panic("fmtroundtrip: ${e.message()}")
  }
  if (dBefore.code != 0) {
    panic("fmtroundtrip: --dump-ast exited ${dBefore.code} on the #3945 significant-space fixture")
  }
  let rc = runFmtWrite(bit, path, capDir, ms) catch e {
    panic("fmtroundtrip: ${e.message()}")
  }
  if (rc != 0) {
    panic("fmtroundtrip: `bit fmt` exited ${rc} on the #3945 significant-space fixture")
  }
  let dAfter = runDumpAst(bit, path, capDir, ms) catch e {
    panic("fmtroundtrip: ${e.message()}")
  }
  if (dAfter.code != 0) {
    panic("fmtroundtrip: --dump-ast exited ${dAfter.code} on the FORMATTED #3945 significant-space fixture")
  }
  if (dBefore.text != dAfter.text) {
    eprint("fmt-roundtrip: FAIL -- #3945: bit fmt changed the significant single space between <a/> and <b/>\n")
    eprint("  before:\n${dBefore.text}\n  after:\n${dAfter.text}\n")
    exit(1)
  }
}

fn main() {
  let ms = timeoutMs()
  let bit = requiredEnv("BIT_SELF_EXE") catch e {
    panic("fmtroundtrip: ${e.message()}")
  }
  let repo = requiredEnv("BIT_REPO") catch e {
    panic("fmtroundtrip: ${e.message()}")
  }

  let files = collectBitFiles(repo) catch e {
    panic("fmtroundtrip: ${e.message()}")
  }

  let capDir = newCapDir()
  mkdir(capDir) catch e {
    panic("fmtroundtrip: cannot create ${capDir}: ${e.message()}")
  }
  checkFixpoint(bit, capDir, ms, "#4752", fixpointSource())
  checkFixpoint(bit, capDir, ms, "#4956", commentBodySource())
  checkCanonical(bit, capDir, ms, "#4968", trailingArrowSource())
  checkJsxAllShapes(bit, capDir, ms)
  checkJsxSignificantSpace(bit, capDir, ms)

  let matched = 0
  let mismatch = 0
  let skip = 0
  let mismatched = []string(0)

  for f of files {
    let v = checkFile(bit, f, capDir, ms)
    if (v.status == "match") {
      matched = matched + 1
    } else if (v.status == "skip") {
      skip = skip + 1
    } else {
      mismatch = mismatch + 1
      mismatched = append(mismatched, v.path)
    }
  }

  teardown(capDir, ms)

  let total = matched + mismatch + skip
  if (mismatch > 0) {
    eprint("fmt-roundtrip: FAIL -- MISMATCH=${mismatch} of ${total} .bit file(s) scanned (MATCH=${matched} SKIP=${skip})\n")
    printMismatches(mismatched)
    exit(1)
  }
  println("fmt-roundtrip: MATCH=${matched} MISMATCH=${mismatch} SKIP=${skip} of ${total} .bit file(s) scanned")
  println("fmt-roundtrip: one-pass fixpoint (#4752, #4956): PASS")
  println("fmt-roundtrip: canonical trailing-arrow argument (#4968): PASS")
  println("fmt-roundtrip: JSX element/fragment printing, --check on the fixed point (#3945): PASS")
  println("fmt-roundtrip: JSX significant single space unchanged (#3945): PASS")
  println("fmt-roundtrip: PASS")
}
