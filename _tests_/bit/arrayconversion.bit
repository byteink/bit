// #7970: unreleased conversion syntax stays outside the pinned-oracle corpus.
import { env, envOr, exit } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"
import { removeAll } from "std/fs/secure"
import { contains, replace } from "std/strings"

fn required(name: string): string {
  let value = env(name)
  assert(value != "", name + " must be set")
  return value
}

fn quote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) {
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

fn fixtureSrc(): string {
  return "class Count { n: int }\n" +
    "class Box { pair: [2]int }\n" +
    "fn newError(s: string): error { panic(\"shadow called\") }\n" +
    "fn once(c: Count, n: int): []int { c.n = c.n + 1; return []int(n) }\n" +
    "fn propagate(s: []int): [2]int! { return [2]int(s)? }\n" +
    "fn byValue(a: [2]int): [2]int { a[0] = 99; return a }\n" +
    "fn zeros(): ()! {\n" +
    "  let nils: []int\n" +
    "  let a = [0]int(nils)?\n" +
    "  let e = [0]int([]int(0))?\n" +
    "  let parent: []int = [1,2,3]\n" +
    "  let off = [0]int(parent[2:2])?\n" +
    "  assert(len(a) == 0 && len(e) == 0 && len(off) == 0)\n" +
    "  let wrong = [0]int(parent) catch err { assert(err.message() == \"array conversion length mismatch: expected 0, found 3\"); [0]int{} }\n" +
    "  assert(len(wrong) == 0)\n" +
    "}\n" +
    "fn copies(): ()! {\n" +
    "  let s: []int = [7,8,9,10]\n" +
    "  let pair = [2]int(s[1:4][0:2])?\n" +
    "  assert(pair[0] == 8 && pair[1] == 9)\n" +
    "  pair[0] = 40\n" +
    "  assert(s[1] == 8)\n" +
    "  s[2] = 50\n" +
    "  assert(pair[1] == 9)\n" +
    "  let assigned = pair\n" +
    "  assigned[0] = 60\n" +
    "  assert(pair[0] == 40)\n" +
    "  let returned = byValue(pair)\n" +
    "  assert(returned[0] == 99 && pair[0] == 40)\n" +
    "  let box = Box{pair = pair}\n" +
    "  pair[0] = 70\n" +
    "  assert(box.pair[0] == 40)\n" +
    "  let source: []int = [4,5]\n" +
    "  let propagated = propagate(source)?\n" +
    "  assert(propagated[0] == 4 && propagated[1] == 5)\n" +
    "}\n" +
    "fn boundaries(): ()! {\n" +
    "  let c = Count{n = 0}\n" +
    "  let a = [1]int(once(c,1))?\n" +
    "  assert(c.n == 1 && a[0] == 0)\n" +
    "  let b = [1]int(once(c,0)) catch err { assert(err.message() == \"array conversion length mismatch: expected 1, found 0\"); [1]int{12} }\n" +
    "  assert(c.n == 2 && b[0] == 12)\n" +
    "  let d = [1]int([]int(2)) catch err { assert(err.message() == \"array conversion length mismatch: expected 1, found 2\"); [1]int{13} }\n" +
    "  assert(d[0] == 13)\n" +
    "  let good = [1]int([]int(1))?\n" +
    "  assert(good[0] == 0)\n" +
    "  let s = []byte(32)\n" +
    "  let i = 0\n" +
    "  while(i < 32) { s[i] = byte(i + 1); i = i + 1 }\n" +
    "  let all = [32]byte(s)?\n" +
    "  i = 0\n" +
    "  while(i < 32) { assert(all[i] == byte(i + 1)); i = i + 1 }\n" +
    "  let short = [32]byte([]byte(31)) catch err { assert(err.message() == \"array conversion length mismatch: expected 32, found 31\"); zero32() }\n" +
    "  let long = [32]byte([]byte(33)) catch err { assert(err.message() == \"array conversion length mismatch: expected 32, found 33\"); zero32() }\n" +
    "  assert(len(short) == 32 && len(long) == 32)\n" +
    "}\n" +
    widthSrc()
}

fn widthSrc(): string {
  return "fn widths(): ()! {\n" +
    "  let ints: []i8 = [-7]\n" +
    "  let ai = [1]i8(ints)?\n" +
    "  assert(ai[0] == -7)\n" +
    "  let signed16: []i16 = [-32000]; let a16 = [1]i16(signed16)?; assert(a16[0] == -32000)\n" +
    "  let signed32: []i32 = [-2000000000]; let a32 = [1]i32(signed32)?; assert(a32[0] == -2000000000)\n" +
    "  let signed64: []i64 = [-9000000000000000000]; let a64 = [1]i64(signed64)?; assert(a64[0] == -9000000000000000000)\n" +
    "  let unsigned16: []u16 = [65000]; let u16a = [1]u16(unsigned16)?; assert(u16a[0] == 65000)\n" +
    "  let unsigned32: []u32 = [4000000000]; let u32a = [1]u32(unsigned32)?; assert(u32a[0] == 4000000000)\n" +
    "  let unsigned64: []u64 = [u64(-1)]; let u64a = [1]u64(unsigned64)?; assert(u64a[0] == u64(-1))\n" +
    "  let bools: []bool = [true]\n" +
    "  let ab = [1]bool(bools)?\n" +
    "  assert(ab[0])\n" +
    "  let singles: []f32 = [1.25]\n" +
    "  let singleArray = [1]f32(singles)?\n" +
    "  assert(singleArray[0] == f32(1.25))\n" +
    "  let doubles: []f64 = [2.5]\n" +
    "  let ad = [1]f64(doubles)?\n" +
    "  assert(ad[0] == 2.5)\n" +
    "  let decs: []decimal = [123456789012345.125, -42.375]\n" +
    "  let ac = [2]decimal(decs)?\n" +
    "  assert(ac[0] == decs[0] && ac[1] == decs[1])\n" +
    "  decs[0] = 1.0\n" +
    "  assert(ac[0] == 123456789012345.125)\n" +
    "  ac[1] = 2.0\n" +
    "  assert(decs[1] == -42.375)\n" +
    "}\n" +
    "fn zero32(): [32]byte { let a: [32]byte; return a }\nfn main(): ()! { zeros()?; copies()?; boundaries()?; widths()?; println(\"array conversion native pass\") }\n" +
    ""
}

fn runMode(dir: string, mode: string): ()! {
  let script = dir + "/run.sh"
  let output = dir + "/output"
  let program = dir + "/program"
  let body = "#!/bin/sh\nset -eu\n" +
    "export BIT_STDLIB=" +
    quote(required("BIT_STDLIB")) +
    "\n" +
    "export BIT_LIBBITRT=" +
    quote(required("BIT_LIBBITRT")) +
    "\n" +
    "export BIT_ERR_REG=" +
    mode +
    "\n" +
    quote(required("BIT_BIN")) +
    " build " +
    quote(dir + "/fixture.bit") +
    " -o " +
    quote(program) +
    "\n" +
    "exec " +
    quote(program) +
    " > " +
    quote(output) +
    " 2>&1\n"
  writeFile(script, body)?
  assert(fsChmod(script, 448) == 0)
  let code = osRunBounded(script, 60000)
  let out = readFile(output) catch _ {
    ""
  }
  assert(code == 0, "native exit ${code}: ${out}")
  if (out != "array conversion native pass\n") {
    eprint("array conversion output mismatch: ${out}\n")
    exit(1)
  }
}

fn noPrelude(dir: string): ()! {
  let source = dir + "/freestanding.bit"
  writeFile(source, "fn copy(xs: []int): [1]int { return [1]int(xs) }\n")?
  let script = dir + "/freestanding.sh"
  let output = dir + "/freestanding.out"
  let body = "#!/bin/sh\nexec " +
    quote(required("BIT_BIN")) +
    " build " +
    quote(source) +
    " --freestanding --emit-obj -o " +
    quote(dir + "/free.o") +
    " > " +
    quote(output) +
    " 2>&1\n"
  writeFile(script, body)?
  assert(fsChmod(script, 448) == 0)
  let code = osRunBounded(script, 60000)
  let out = readFile(output)?
  assert(code == 1, "freestanding exit ${code}: ${out}")
  assert(contains(out, "checked array conversion requires the core prelude"), out)
  assert(contains(out, "freestanding.bit:1:"), out)
}

fn importedShadow(dir: string): ()! {
  mkdir(dir + "/shadow")?
  writeFile(
    dir + "/shadow/shadow.bit",
    "export fn newError(s: string): error { panic(\"import shadow called\") }\n",
  )?
  let src = replace(
    fixtureSrc(),
    "fn newError(s: string): error { panic(\"shadow called\") }\n",
    "",
  )
  writeFile(dir + "/fixture.bit", "import { newError } from \"./shadow\"\n" + src)?
  runMode(dir, "1")?
}

fn namedArgument(dir: string): ()! {
  let src = dir + "/named.bit"
  writeFile(src, "fn named(xs: []int) { let _ = [1]int(value = xs) }\n")?
  let script = dir + "/named.sh"
  let out = dir + "/named.out"
  writeFile(
    script,
      "#!/bin/sh\nexec " +
      quote(required("BIT_BIN")) +
      " check " +
      quote(src) +
      " > " +
      quote(out) +
      " 2>&1\n",
  )?
  assert(fsChmod(script, 448) == 0)
  assert(osRunBounded(script, 60000) == 1)
  assert(contains(readFile(out)?, "error[E0021]"))
}

fn main(): ()! {
  let dir = envOr("TMPDIR", "/tmp") + "/t7970-array-${timeUnixNs()}"
  mkdir(dir)?
  writeFile(dir + "/fixture.bit", fixtureSrc())?
  runMode(dir, "1")?
  runMode(dir, "0")?
  importedShadow(dir)?
  noPrelude(dir)?
  namedArgument(dir)?
  removeAll(dir)?
  println("PASS array conversion: native values, copies and both error conventions")
}

