// The classes, the seed and the four relation reads every relshapes cell uses
// (#6397). `worldDecls` is one text in two spellings: pasted into main.bit with
// `export ` stripped, or written as the exported module world/world.bit that a
// cross-module cell imports. `t` is the cell's own table prefix, so every cell
// owns its tables inside the run's one database.
import { replace } from "std/strings"

// A relation under test: the row class its query returns, the read the program
// does on a row (`@v` is the row), the name `.with` takes to load it, the value
// that read yields once loaded, and the composite literal for a row built by
// hand without the relation (`hand`) and with it set (`handSet`).
class Rel {
  id: string,
  cls: string,
  read: string,
  with: string,
  want: string,
  hand: string,
  handSet: string,
}

const authorHand: string = "Author{ id = 1, name = \"Ada\" }"
const postHand: string = "Post{ id = 1, authorId = 1, title = \"p1\" }"
const postHand2: string = "Post{ id = 2, authorId = 1, title = \"p2\" }"
const tagList: string = "[Tag{ id = 1, name = \"t1\" }, Tag{ id = 2, name = \"t2\" }]"

fn postsOfAda(inner: string): string {
  return "[${inner}, ${postHand2}]"
}

// A post of Ada's with its author set: the proof of `posts.author` (#6408)
// needs every post in the list to set it, as the read cannot say which one it takes.
fn postWithAuthor(id: int): string {
  return "Post{ id = ${id}, authorId = 1, title = \"p${id}\", author = ${authorHand} }"
}

fn relations(): []Rel {
  return [
    Rel{
      id = "bt", cls = "Post", read = "len(@v.author.name)", with = "author", want = "3",
      hand = postHand,
      handSet = "Post{ id = 1, authorId = 1, title = \"p1\", author = ${authorHand} }",
    },
    Rel{
      id = "hm", cls = "Author", read = "len(@v.posts)", with = "posts", want = "2",
      hand = authorHand,
      handSet = "Author{ id = 1, name = \"Ada\", posts = ${postsOfAda(postHand)} }",
    },
    Rel{
      id = "mm", cls = "Post", read = "len(@v.tags)", with = "tags", want = "2",
      hand = postHand,
      handSet = "Post{ id = 1, authorId = 1, title = \"p1\", tags = ${tagList} }",
    },
    Rel{
      id = "nest", cls = "Post", read = "len(@v.author.posts)", with = "author.posts", want = "2",
      hand = postHand,
      handSet = "Post{ id = 1, authorId = 1, title = \"p1\", author = Author{ id = 1, name = \"Ada\", posts = ${postsOfAda(postHand)} } }",
    },
    Rel{
      id = "nest2", cls = "Author", read = "len(@v.posts[0].author.name)", with = "posts.author",
      want = "3", hand = authorHand,
      handSet = "Author{ id = 1, name = \"Ada\", posts = [${postWithAuthor(1)}, ${postWithAuthor(2)}] }",
    },
  ]
}

// The read of a row expression: `@v` in the relation's template becomes `v`.
fn readOf(r: Rel, v: string): string {
  return replace(r.read, "@v", v)
}

// The program's classes for table prefix `t`. A hasMany foreign key names the
// owning side's column (`authorId` is `author_id` in SQL).
fn worldDecls(t: string): string {
  let s = "export @table(\"${t}_author\") class Author {\n  export id: i64\n  export name: string\n"
  s = s + "  @hasMany(\"authorId\")\n  export posts: []Post\n}\n\n"
  s = s +
    "export @table(\"${t}_post\") class Post {\n  export id: i64\n  export authorId: i64\n  export title: string\n"
  s = s + "  @belongsTo(\"authorId\")\n  export author: Author\n"
  s = s + "  @manyToMany(\"${t}_post_tag\")\n  export tags: []Tag\n}\n\n"
  s = s + "export @table(\"${t}_tag\") class Tag {\n  export id: i64\n  export name: string\n"
  s = s + "  @manyToMany(\"${t}_post_tag\")\n  export posts: []Post\n}\n"
  return s
}

// Idempotent, so the program and its test block can both run it: two tables
// per relation side, one author "Ada" with two posts, the first tagged twice.
fn seedText(t: string): string {
  let s = "fn seed(db: Db): ()! {\n"
  s = s +
    "  db.exec(\"create table if not exists ${t}_author (id bigint primary key, name text not null)\")?\n"
  s = s +
    "  db.exec(\"create table if not exists ${t}_post (id bigint primary key, author_id bigint not null, title text not null)\")?\n"
  s = s +
    "  db.exec(\"create table if not exists ${t}_tag (id bigint primary key, name text not null)\")?\n"
  s = s +
    "  db.exec(\"create table if not exists ${t}_post_tag (post_id bigint not null, tag_id bigint not null, primary key (post_id, tag_id))\")?\n"
  s = s + "  db.exec(\"insert into ${t}_author values (1, 'Ada') on conflict do nothing\")?\n"
  s = s +
    "  db.exec(\"insert into ${t}_post values (1, 1, 'p1'), (2, 1, 'p2') on conflict do nothing\")?\n"
  s = s +
    "  db.exec(\"insert into ${t}_tag values (1, 't1'), (2, 't2') on conflict do nothing\")?\n"
  s = s + "  db.exec(\"insert into ${t}_post_tag values (1, 1), (1, 2) on conflict do nothing\")?\n"
  return s + "}\n"
}

// Where a package-resolving module finds `orm`: a path dependency on this
// checkout's pkg/ (the shape ormlive.bit's migrate fixture uses).
fn projectJson(repo: string): string {
  return "{\"dependencies\": {\"orm\": \"${repo}/pkg/orm\"}}\n"
}

fn projectLock(repo: string): string {
  return "{" +
    "\"orm\":{\"path\":\"${repo}/pkg/orm\",\"requires\":{}}," +
    "\"postgres\":{\"path\":\"${repo}/pkg/postgres\",\"requires\":{}}," +
    "\"mysql\":{\"path\":\"${repo}/pkg/mysql\",\"requires\":{}}" +
    "}\n"
}
