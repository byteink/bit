// The cell table (#6397): sources x flows x relations. A cell is one small
// program that reads a relation off a row; `cells()` renders every program from
// the tables below, so a new row in a table adds its whole row or column.
//
// Templates spell `${` as `#{` (a backtick string has no interpolation and the
// compiler warns on a literal `${`); `finish` turns it back.
import { contains, indexOf, join, replace, toLower } from "std/strings"

// One program: its main.bit plus, for a cross-module cell, the two modules.
class Prog {
  main: string,
  tests: string,
  world: string,
  reader: string,
}

class Cell {
  id: string,
  rel: string,
  want: string,
  test: bool,
  xmod: bool,
  asIs: Prog,
  hinted: Prog,
}

// Where a row comes from. `one` is a row, `many` a slice of rows, `opt` an
// Option of a row; each has a `...Fix` twin that is the same source rewritten
// the way E0300's hint says (`.with("rel")` on the query, or the relation set
// on a literal). `@C` is the row class, `@W` the `.with` name, `@T` the table.
class Source {
  id: string,
  one: string,
  oneFix: string,
  many: string,
  manyFix: string,
  opt: string,
  optFix: string,
}

const q: string = "db.table<@C>()"
const qw: string = "db.table<@C>().with(\"@W\")"
const ord: string = ".orderBy(\"id\")"

fn tableSource(id: string, base: string, fixBase: string): Source {
  return Source{
    id = id,
    one = "${base}.find(1)?",
    oneFix = "${fixBase}.find(1)?",
    many = "${base}${ord}.all()?",
    manyFix = "${fixBase}${ord}.all()?",
    opt = "${base}${ord}.first()?",
    optFix = "${fixBase}${ord}.first()?",
  }
}

fn sources(): []Source {
  let rawOne = "db.query<@C>(\"select * from @T order by id\")?"
  let withMany = "${qw}${ord}.all()?"
  let withOne = "${qw}.find(1)?"
  let withOpt = "${qw}${ord}.first()?"
  return [
    tableSource("findplain", q, qw),
    tableSource("with", qw, qw),
    Source{
      id = "raw", one = "${rawOne}[0]", oneFix = "${withMany}[0]", many = rawOne, manyFix = withMany,
      opt = "Option.Some(${rawOne}[0])", optFix = "Option.Some(${withMany}[0])",
    },
    Source{
      id = "hand", one = "@H", oneFix = withOne, many = "[@H]", manyFix = withMany,
      opt = "Option.Some(@H)", optFix = withOpt,
    },
    Source{
      id = "handset", one = "@HS", oneFix = withOne, many = "[@HS]", manyFix = withMany,
      opt = "Option.Some(@HS)", optFix = withOpt,
    },
    Source{
      id = "none",
      one = "",
      oneFix = "",
      many = "",
      manyFix = "",
      opt = "Option.None",
      optFix = "Option.None",
    },
  ]
}

// A flow is how the row travels to the read. `decls` go at the top level, `body`
// inside `main`. `S` is the source's row, `M` its slice, `O` its Option, `X` the
// raw-SQL row a disagreeing return mixes in. `only` limits a flow to one source,
// `skip` excludes one; `bodyFix` replaces `body` in the hinted program when the
// hint is to add a call. `test` makes the cell run `bit test` too.
class Flow {
  id: string,
  decls: string,
  body: string,
  only: string,
  skip: string,
  xmod: bool,
  test: bool,
  bodyFix: string,
  tests: string,
}

const showDecl: string = "fn show(x: @C): string {\n  return \"#{@RD:x:}\"\n}\n"
// A store into the parameter's own rows (#6366): the callers pass loaded rows,
// so the read is proven only when the stored value's source loads it too.
const storeDecl: string = "fn show(rows: []@C, v: @C): string {\n  rows[0] = v\n  return \"#{@RD:rows[0]:}\"\n}\n"
const holderDecl: string = "class Holder {\n  row: @C,\n}\n"
const wantLine: string = "  println(\"@WANT\")\n"

fn flow(id: string, decls: string, body: string): Flow {
  return Flow{
    id = id, decls = decls, body = body, only = "", skip = "none", xmod = false, test = false, bodyFix = "", tests = "",
  }
}

fn pr(v: string): string {
  return "  println(\"#{@RD:${v}:}\")\n"
}

// The flows that need a helper function or a class around the row.
fn helperFlows(): []Flow {
  let mk = "fn mk(db: Db): @C! {\n  return @S\n}\n"
  let mkDis = "fn mk(db: Db, b: bool): @C! {\n  if (b) {\n    return @S\n  }\n  return @X\n}\n"
  let varShow = "fn show(...xs: @C): string {\n  return \"#{@RD:xs[0]:}\"\n}\n"
  return [
    flow("pos", showDecl, "  println(show(@S))\n"),
    flow("named", showDecl, "  println(show(x = @S))\n"),
    flow("variadic", varShow, "  println(show(@S))\n"),
    flow("spread", varShow, "  let rows = @M\n  println(show(...rows))\n"),
    flow("retsingle", mk, "  let r = mk(db)?\n${pr("r")}"),
    flow("retdis", mkDis, "  let r = mk(db, true)?\n${pr("r")}"),
    flow("paramstore", storeDecl, "  println(show(@L, @S))\n"),
    flow("fieldlit", holderDecl, "  let h = Holder{ row = @S }\n${pr("h.row")}"),
    flow("fieldset", holderDecl, "  let h = Holder{ row = @S }\n  h.row = @S\n${pr("h.row")}"),
  ]
}

fn inlineFlows(): []Flow {
  return [
    flow("direct", "", "  let r = @S\n${pr("r")}"),
    flow(
      "closure",
      "",
      "  let r = @S\n  let g = () => {\n    return \"#{@RD:r:}\"\n  }\n  println(g())\n",
    ),
    flow("elemwrite", "", "  let rows = @M\n  rows[0] = @S\n${pr("rows[0]")}"),
    flow(
      "forloop",
      "",
      "  let rows = @M\n  for r of rows {\n    if (r.id == 1) {\n    ${pr("r")}    }\n  }\n",
    ),
    flow("alias", "", "  let a = @S\n  let b = a\n${pr("b")}"),
    flow("aliasrows", "", "  let rows = @M\n  let al = rows\n${pr("al[0]")}"),
    Flow{
      id = "matchopt", decls = "", only = "", skip = "", xmod = false, test = false, bodyFix = "", tests = "",
      body = "  let o: Option<@C> = @O\n  match (o) {\n    Some(v) => println(\"#{@RD:v:}\"),\n    None => println(\"none\"),\n  }\n",
    },
  ]
}

fn specialFlows(): []Flow {
  let tdb = "test \"t\" {\n  let db = open(env(\"RS_URL\")) catch e {\n    assert(false, e.message())\n    return\n  }\n  seed(db) catch e {\n    assert(false, e.message())\n    return\n  }\n"
  let tcaller = "  let r = tq(db) catch e {\n    assert(false, e.message())\n    return\n  }\n  assert(show(r) == \"@WANT\", \"relation not loaded\")\n}\n"
  let tcall = "  let r = tq(db) catch e {\n    assert(false, e.message())\n    return\n  }\n  assert(\"#{@RD:r:}\" == \"@WANT\", \"relation not loaded\")\n}\n"
  return [
    Flow{
      id = "default", decls = "fn show(x: @C = @HD): string {\n  return \"#{@RD:x:}\"\n}\n",
      body = "  println(show())\n", only = "hand", skip = "", xmod = false, test = false, bodyFix = "", tests = "",
    },
    Flow{
      id = "xmod", decls = "", body = "  println(show(@S))\n", only = "", skip = "none", xmod = true,
      test = false, bodyFix = "", tests = "",
    },
    Flow{
      id = "testcaller", decls = "${showDecl}fn tq(db: Db): @C! {\n  return @S\n}\n", body = wantLine,
      only = "", skip = "none", xmod = false, test = true, bodyFix = "  println(show(@S))\n",
      tests = "${tdb}${tcaller}",
    },
    Flow{
      id = "testdirect", decls = "fn tq(db: Db): @C! {\n  return @S\n}\n", body = wantLine,
      only = "", skip = "none", xmod = false, test = true, bodyFix = "", tests = "${tdb}${tcall}",
    },
  ]
}

fn flows(): []Flow {
  let out = helperFlows()
  out = append(out, ...inlineFlows())
  return append(out, ...specialFlows())
}

// `@RD:v:` -> the relation's read on the expression `v`, wherever it appears.
fn expandReads(text: string, r: Rel): string {
  let out = text
  let i = 0
  while (i < 64) {
    let at = indexOf(out, "@RD:")
    if (at < 0) {
      return out
    }
    let end = indexOf(out[at + 4:], ":")
    if (end < 0) {
      panic("relshapes: unclosed @RD: in a template")
    }
    let v = out[at + 4:at + 4 + end]
    out = out[0:at] + readOf(r, v) + out[at + 5 + end:]
    i = i + 1
  }
  panic("relshapes: more than 64 @RD: reads in one template")
}

fn rawOf(s: Source, fix: bool): string {
  if (fix) {
    return "${qw}${ord}.all()?[0]"
  }
  return "db.query<@C>(\"select * from @T order by id\")?[0]"
}

class Pick {
  lit: string,
  one: string,
  many: string,
  opt: string,
  x: string,
}

fn pick(s: Source, fix: bool): Pick {
  if (fix) {
    return Pick{ lit = "@HS", one = s.oneFix, many = s.manyFix, opt = s.optFix, x = rawOf(s, true) }
  }
  return Pick{ lit = "@H", one = s.one, many = s.many, opt = s.opt, x = rawOf(s, false) }
}

// What a template is filled with: the source's expressions, the relation, the
// cell's table prefix and the value the read must print.
class Env {
  p: Pick,
  r: Rel,
  t: string,
  want: string,
}

fn fill(text: string, e: Env): string {
  let p = e.p
  let r = e.r
  let t = e.t
  let want = e.want
  let o = replace(text, "@WANT", want)
  o = replace(o, "@L", "${qw}${ord}.all()?")
  o = replace(o, "@HD", p.lit)
  o = replace(o, "@S", p.one)
  o = replace(o, "@M", p.many)
  o = replace(o, "@O", p.opt)
  o = replace(o, "@X", p.x)
  o = replace(o, "@HS", r.handSet)
  o = replace(o, "@H", r.hand)
  o = replace(o, "@W", r.with)
  o = replace(o, "@T", "${t}_${toLower(r.cls)}")
  o = replace(o, "@C", r.cls)
  return replace(expandReads(o, r), "#{", "\${")
}

const header: string = "import { Db, open } from \"orm\"\nimport { env } from \"std/os\"\n"
fn classNames(): []string {
  return ["Author", "Post", "Tag"]
}

fn stripExport(text: string): string {
  return replace(text, "export ", "")
}

// The imports a module that gets its classes from ../world needs: only the
// classes its own text names, so no import is unused.
fn worldImport(text: string, path: string): string {
  let names = []string(0)
  for n of classNames() {
    if (contains(text, n)) {
      names = append(names, n)
    }
  }
  if (len(names) == 0) {
    return ""
  }
  return "import { ${join(names, ", ")} } from \"${path}\"\n"
}

fn programFor(f: Flow, e: Env, fix: bool): Prog {
  let t = e.t
  let body = f.body
  if (fix && f.bodyFix != "") {
    body = f.bodyFix
  }
  let code = "${seedText(t)}${f.decls}fn main(): ()! {\n  let db = open(env(\"RS_URL\"))?\n  seed(db)?\n${body}}\n"
  code = fill(code, e)
  let tests = fill(f.tests, e)
  if (!f.xmod) {
    return Prog{
      main = "${header}${stripExport(worldDecls(t))}${code}", tests = tests, world = "", reader = "",
    }
  }
  let reader = fill("export ${showDecl}", e)
  let world = "import { Db } from \"orm\"\n\nexport fn keepDb(d: Db): Db {\n  return d\n}\n\n${worldDecls(t)}"
  let imports = "${worldImport(code, "./world")}import { show } from \"./reader\"\n"
  return Prog{
    main = "${header}${imports}${code}",
    tests = tests,
    world = world,
    reader = "${worldImport(reader, "../world")}${reader}",
  }
}

fn wanted(s: Source, r: Rel): string {
  if (s.id == "none") {
    return "none"
  }
  return r.want
}

fn applies(f: Flow, s: Source): bool {
  if (f.only != "" && f.only != s.id) {
    return false
  }
  return f.skip != s.id
}

fn cells(): []Cell {
  let out = []Cell(0)
  for r of relations() {
    for s of sources() {
      for f of flows() {
        if (!applies(f, s)) {
          continue
        }
        let t = "c${len(out)}"
        let want = wanted(s, r)
        out = append(
          out,
          Cell{
            id = "${r.id}-${s.id}-${f.id}",
            rel = r.id,
            want = want,
            test = f.test,
            xmod = f.xmod,
            asIs = programFor(f, Env{ p = pick(s, false), r = r, t = t, want = want }, false),
            hinted = programFor(f, Env{ p = pick(s, true), r = r, t = t, want = want }, true),
          },
        )
      }
    }
  }
  return out
}
