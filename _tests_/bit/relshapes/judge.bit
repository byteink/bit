// How relshapes.bit judges a cell (#6397): reads the exit codes the generated
// scripts left in each variant's rc.txt and the logs beside them.
import { output } from "std/process"
import { mkdir } from "std/fs"
import { contains, parseInt, split } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

const logLines: int = 6
const rmTimeoutMs: int = 60000

// One variant's four exit codes; -1 is "that step did not run".
class Codes {
  check: int,
  build: int,
  run: int,
  test: int,
}

fn intOr(s: string): int {
  return parseInt(s) catch _ {
    -2
  }
}

fn readCodes(dir: string): Codes {
  let p = split(trimLine(slurp("${dir}/rc.txt")), " ")
  if (len(p) != 4) {
    return Codes{ check = -3, build = -3, run = -3, test = -3 }
  }
  return Codes{ check = intOr(p[0]), build = intOr(p[1]), run = intOr(p[2]), test = intOr(p[3]) }
}

fn trimLine(s: string): string {
  if (len(s) > 0 && s[len(s) - 1:] == "\n") {
    return s[0:len(s) - 1]
  }
  return s
}

fn firstLines(text: string, n: int): string {
  let out = ""
  let k = 0
  for line of split(text, "\n") {
    if (k >= n) {
      break
    }
    out = out + "      ${line}\n"
    k = k + 1
  }
  return out
}

// "" when the variant checks, builds, runs, and printed the loaded relation
// (and passed its test block); else why not.
fn runsLoaded(dir: string, k: Codes, want: string, test: bool): string {
  if (k.check != 0) {
    return "bit check exited ${k.check}\n${firstLines(slurp("${dir}/check.log"), logLines)}"
  }
  if (k.build != 0) {
    return "bit check accepted it and bit build failed (exit ${k.build})\n${firstLines(
      slurp("${dir}/build.log"),
      logLines,
    )}"
  }
  if (k.run != 0) {
    return "built, and the program exited ${k.run}\n${firstLines(slurp("${dir}/run.err"), logLines)}"
  }
  let got = slurp("${dir}/run.out")
  if (got != "${want}\n") {
    return "built, and printed '${trimLine(got)}', wanted '${want}'"
  }
  if (test && k.test != 0) {
    return "the test block failed (exit ${k.test})\n${firstLines(slurp("${dir}/test.log"), logLines)}"
  }
  return ""
}

// What a cell did: "loaded" (agrees as written), "hint" (E0300, and the hint
// fixes it), or "" plus the reason it fails.
class Verdict {
  kind: string,
  why: string,
}

fn judgeCell(work: string, c: Cell): Verdict {
  let dir = "${work}/cells/${c.id}"
  let k = readCodes(dir)
  if (k.check == -3) {
    return Verdict{ kind = "", why = "no result line: the cell never ran" }
  }
  if (k.check == 0) {
    let why = runsLoaded(dir, k, c.want, c.test)
    if (why == "") {
      return Verdict{ kind = "loaded", why = "" }
    }
    return Verdict{ kind = "", why = why }
  }
  let log = slurp("${dir}/check.log")
  if (!contains(log, "error[E0300]")) {
    return Verdict{
      kind = "",
      why = "bit check rejected it with something other than E0300\n${firstLines(log, logLines)}",
    }
  }
  let fixDir = "${dir}.fix"
  let why = runsLoaded(fixDir, readCodes(fixDir), c.want, c.test)
  if (why != "") {
    return Verdict{
      kind = "",
      why = "E0300, and the program rewritten the way its hint says does not work: ${why}\n    the hint:\n${firstLines(
        log,
        logLines,
      )}",
    }
  }
  return Verdict{ kind = "hint", why = "" }
}

fn knownTicket(id: string): string {
  for k of knownFailures() {
    if (k.id == id) {
      return k.ticket
    }
  }
  return ""
}

fn assertKnownListed(all: []Cell) {
  for k of knownFailures() {
    let found = false
    for c of all {
      if (c.id == k.id) {
        found = true
      }
    }
    if (!found) {
      panic("relshapes: ${k.id} (${k.ticket}) is on the known-failure list but is no cell of the table; delete it from the list")
    }
  }
}

class Tally {
  loaded: int,
  hint: int,
  known: int,
  fresh: int,
}

fn tallyOne(t: Tally, c: Cell, v: Verdict): Tally {
  let ticket = knownTicket(c.id)
  if (v.kind != "" && ticket != "") {
    eprint("relshapes: FAIL ${c.id}: agrees now, but is on the known-failure list as ${ticket}; delete it from the list\n")
    return Tally{ loaded = t.loaded, hint = t.hint, known = t.known, fresh = t.fresh + 1 }
  }
  if (v.kind == "") {
    if (ticket == "") {
      eprint("relshapes: FAIL ${c.id}\n    ${v.why}\n")
      return Tally{ loaded = t.loaded, hint = t.hint, known = t.known, fresh = t.fresh + 1 }
    }
    return Tally{ loaded = t.loaded, hint = t.hint, known = t.known + 1, fresh = t.fresh }
  }
  if (v.kind == "loaded") {
    return Tally{ loaded = t.loaded + 1, hint = t.hint, known = t.known, fresh = t.fresh }
  }
  return Tally{ loaded = t.loaded, hint = t.hint + 1, known = t.known, fresh = t.fresh }
}

// Generates, runs and judges every cell against the database at `url`; returns
// the process exit code.
fn judgeRun(bit: string, url: string, repo: string, all: []Cell): int {
  let work = "${tmpRoot()}/relshapes-${uuidFormat(uuidV4())}"
  mkdir(work) catch e {
    eprint("relshapes: cannot create ${work}: ${e.message()}\n")
    return 1
  }
  writeCells(work, repo, all)
  let code = runCells(bit, url, work, all, timeoutMs())
  if (code != 0) {
    eprint("relshapes: the cell fan-out ended with ${code} (-2 is a timeout), logs in ${work}\n")
    return 1
  }
  let t = Tally{ loaded = 0, hint = 0, known = 0, fresh = 0 }
  for c of all {
    t = tallyOne(t, c, judgeCell(work, c))
  }
  let ok = t.loaded + t.hint
  if (t.fresh > 0) {
    eprint("relshapes: FAIL -- ${t.fresh} of ${len(all)} cells disagree off the list; ${ok} ok; logs in ${work}\n")
    return 1
  }
  output("/bin/rm", ["-rf", work], rmTimeoutMs)
  println("relshapes: PASS -- ${ok} of ${len(all)} cells (${t.loaded} loaded as written, ${t.hint} E0300 fixed by its hint), ${t.known} on the known-failure list")
  return 0
}
