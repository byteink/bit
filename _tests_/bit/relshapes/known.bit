// Cells that still fail, each with the ticket that fixes it (#6397). The list is
// asserted both ways by relshapes.bit: a failing cell missing from it fails the
// gate, and a cell on it that now agrees fails it too, naming the line to
// delete. A cell id is `<relation>-<source>-<flow>`, as `cells()` (cells.bit)
// builds it.
class Known {
  id: string,
  ticket: string,
}

fn listed(ticket: string, ids: []string): []Known {
  let out = []Known(0)
  for id of ids {
    out = append(out, Known{ id = id, ticket = ticket })
  }
  return out
}

// #6407
fn cells6407(): []string {
  return [
    "bt-none-matchopt",
    "bt-raw-matchopt",
    "hm-none-matchopt",
    "hm-raw-matchopt",
    "mm-none-matchopt",
    "mm-raw-matchopt",
    "nest-none-matchopt",
    "nest-raw-matchopt",
    "nest2-none-matchopt",
    "nest2-raw-matchopt",
  ]
}

// #6408
fn cells6408(): []string {
  return ["nest-hand-default", "nest2-hand-default"]
}

fn knownFailures(): []Known {
  let out = []Known(0)
  out = append(out, ...listed("#6407", cells6407()))
  out = append(out, ...listed("#6408", cells6408()))
  return out
}
