// Transitive branch/SHA requirements retain their locked commit across add,
// while up re-resolves the branch and changed requirements replace it (#7566).
fn checkTransitiveGitPicks(bitExe: string, stdRoot: string) {
  let root = scratchRoot("gitpick")
  let base = newFixtureCtx(root, "gitbase")
  gitInitRepo(base)
  writeGitPickFile(base, "A")
  let shaA = commitAndTag(base, "A", "v1.0.0")
  let holder = newFixtureCtx(root, "githolder")
  gitInitRepo(holder)
  writeRequiringManifest(holder, "gitbase", "main")
  let _ = commitAndTag(holder, "branch holder", "v1.0.0")
  let other = newFixtureCtx(root, "gitother")
  gitInitRepo(other)
  writeGitPickFile(other, "other")
  let _ = commitAndTag(other, "other", "v1.0.0")
  let rewrite = writeStaleRewrite(root, [base, holder, other])
  let cli = newProjectCli("git-pick", bitExe, stdRoot, root, "branch")
  runStale(cli, rewrite, ["add", staleSpec("githolder", "v1.0.0")], "holder")
  assertGitPick(cli, shaA)

  writeGitPickFile(base, "B")
  let shaB = commitAndTag(base, "B", "v1.1.0")
  if (shaA == shaB) {
    fatal(cli.name, "branch A/B fixture did not advance")
  }
  runStale(cli, rewrite, ["add", staleSpec("gitother", "v1.0.0")], "other")
  assertGitPick(cli, shaA)
  let entry = readLockEntry(cli.name, cli.projDir, "gitbase")
  assertJsonString(cli.name, "bit.lock .gitbase", entry, "spec", staleSpec("gitbase", "main"))
  runStale(cli, rewrite, ["up"], "up")
  assertGitPick(cli, shaB)
  stripGitPickSpec(cli)
  runStale(cli, rewrite, ["add", staleSpec("gitother", "v1.0.0")], "old-lock")
  assertGitPick(cli, shaB)
  let upgraded = readLockEntry(cli.name, cli.projDir, "gitbase")
  assertJsonString(cli.name, "upgraded old lock", upgraded, "spec", staleSpec("gitbase", "main"))
  print("PASS: pmrangegate — transitive branch add keeps A; up resolves B (#7566)\n")

  // The same name/repository with a different requirement must not reuse B.
  writeRequiringManifest(holder, "gitbase", shaA)
  let _ = commitAndTag(holder, "SHA holder", "v1.1.0")
  runStale(cli, rewrite, ["add", staleSpec("githolder", "v1.1.0")], "changed-ref")
  assertGitPick(cli, shaA)
  runStale(cli, rewrite, ["add", staleSpec("gitother", "v1.0.0")], "sha-add")
  assertGitPick(cli, shaA)
  runStale(cli, rewrite, ["up"], "sha-up")
  assertGitPick(cli, shaA)
  let pinned = readLockEntry(cli.name, cli.projDir, "gitbase")
  assertJsonString(cli.name, "bit.lock .gitbase", pinned, "spec", staleSpec("gitbase", shaA))
  print("PASS: pmrangegate — changed transitive ref replaces B; unchanged SHA survives add/up (#7566)\n")
}

fn writeGitPickFile(ctx: FixtureCtx, text: string) {
  writeFile(ctx.srcDir + "/a.txt", text) catch e {
    fatal("git-pick", "cannot write fixture: " + e.message())
  }
}

fn assertGitPick(cli: CliCtx, commit: string) {
  let entry = readLockEntry(cli.name, cli.projDir, "gitbase")
  assertJsonString(cli.name, "bit.lock .gitbase", entry, "commit", commit)
  assertNoKey(cli.name, "bit.lock .gitbase", entry, "version")
  assertNoKey(cli.name, "bit.lock .gitbase", entry, "tag")
}

// Locks written before #7566 have no spec key and still resolve normally.
fn stripGitPickSpec(cli: CliCtx) {
  let lock = shQuote(cli.projDir + "/bit.lock")
  let tmp = shQuote(cli.projDir + "/old.lock")
  mustSucceed(
    cli.name, "remove new field from old-lock fixture",
      "set -e\nsed 's/,\"spec\":\"[^\"]*\"//g' " +
      lock +
      " > " +
      tmp +
      "\nmv " +
      tmp +
      " " +
      lock +
      "\n",
  )
  assertNoKey(cli.name, "old lock", readLockEntry(cli.name, cli.projDir, "gitbase"), "spec")
}
