// _tests_/bit/pmrangegate/staletransitive.bit — a transitive bit.lock entry
// follows the graph (#7546). Sibling of scenarios.bit/harness.bit in the same
// module (see harness.bit's header: a directory under _tests_/bit/ is one
// module), so every name harness.bit owns is used here unqualified and
// nothing it declares is declared again.
//
// The bug this pins: bit.lock holds the DIRECT dependency "staleneeds" and,
// beside it, the transitive entry "stalebase". Moving "staleneeds" to a tag
// whose own bit.json requires a different "stalebase" version left the old
// "stalebase" entry in place (`resolveTransitiveDeps` skipped every name that
// already had a top-level entry), so the project then compiled the new
// "staleneeds" against the old "stalebase". `bit remove` left the orphan too.
//
// The target is Go's MVS / Cargo's resolver: `add` and `up` re-resolve the
// whole graph, `remove` prunes entries nothing requires. Three checks, each a
// real `bit` subprocess against local `file://` fixtures reached through one
// `insteadOf` config, none of it touching the network:
//
//  1. `bit add staleneeds@v1.1.0` over a lock holding staleneeds v1.0.0 and
//     stalebase 1.0.0 locks stalebase 2.0.0.
//  2. `bit remove staleneeds` leaves neither a staleneeds nor a stalebase entry.
//  3. `bit up` moves a `^1.0.0` staleneeds to a newly published v1.1.0 and
//     raises the stale stalebase entry with it.

const staleBaseName: string = "stalebase"
const staleNeedsName: string = "staleneeds"

fn checkStaleTransitive(bitExe: string, stdRoot: string) {
  let root = scratchRoot("stale")
  let (base, sha1, sha2) = buildStaleBase(root)
  let needs = newFixtureCtx(root, staleNeedsName)
  gitInitRepo(needs)
  writeStaleNeedsManifest(needs, "1.0.0")
  let _ = commitAndTag(needs, "staleneeds v1.0.0", "v1.0.0")
  let rewrite = writeStaleRewrite(root, base, needs)

  // Locked while only v1.0.0 exists, so `bit up` below has something to move.
  let upCli = newProjectCli("stale-up", bitExe, stdRoot, root, "up")
  runStale(upCli, rewrite, ["add", staleSpec(staleNeedsName, "^1.0.0")], "add-caret")
  assertStaleLock(upCli, "1.0.0", sha1)

  writeStaleNeedsManifest(needs, "2.0.0")
  let _ = commitAndTag(needs, "staleneeds v1.1.0", "v1.1.0")

  let addCli = newProjectCli("stale-add", bitExe, stdRoot, root, "add")
  runStale(addCli, rewrite, ["add", staleSpec(staleNeedsName, "v1.0.0")], "add-v100")
  assertStaleLock(addCli, "1.0.0", sha1)
  runStale(addCli, rewrite, ["add", staleSpec(staleNeedsName, "v1.1.0")], "add-v110")
  assertStaleLock(addCli, "2.0.0", sha2)
  print("PASS: pmrangegate — bit add of a newer direct dependency re-resolves its transitive entry (#7546)\n")

  runStale(addCli, rewrite, ["remove", staleNeedsName], "remove")
  assertNoLockKey(addCli, staleNeedsName)
  assertNoLockKey(addCli, staleBaseName)
  print("PASS: pmrangegate — bit remove prunes the transitive entries nothing requires any more (#7546)\n")

  runStale(upCli, rewrite, ["up"], "up")
  assertStaleLock(upCli, "2.0.0", sha2)
  let moved = readLockEntry(upCli.name, upCli.projDir, staleNeedsName)
  assertJsonString(upCli.name, "bit.lock .staleneeds", moved, "version", "1.1.0")
  print("PASS: pmrangegate — bit up raises a stale transitive entry to the version its requirer now names (#7546)\n")
}

// "stalebase": two ANNOTATED tags over two distinct commits.
fn buildStaleBase(root: string): (FixtureCtx, string, string) {
  let base = newFixtureCtx(root, staleBaseName)
  gitInitRepo(base)
  writeFile(base.srcDir + "/a.txt", "1.0.0\n") catch e {
    fatal("stale", "cannot write stalebase fixture: " + e.message())
  }
  let sha1 = commitAndTag(base, "stalebase v1.0.0", "v1.0.0")
  writeFile(base.srcDir + "/a.txt", "2.0.0\n") catch e {
    fatal("stale", "cannot write stalebase fixture: " + e.message())
  }
  let sha2 = commitAndTag(base, "stalebase v2.0.0", "v2.0.0")
  assertAnnotatedTag("stale", base, "v2.0.0")
  if (sha1 == sha2) {
    fatal("stale", "internal: the two stalebase tags do not name two distinct commits")
  }
  return base, sha1, sha2
}

fn staleSpec(repo: string, ref: string): string {
  return "${gitHost}/${owner}/${repo}@${ref}"
}

fn writeStaleNeedsManifest(ctx: FixtureCtx, baseVersion: string) {
  writeFile(
    ctx.srcDir + "/bit.json",
    "{\"dependencies\":{\"${staleBaseName}\":\"${staleSpec(staleBaseName, baseVersion)}\"}}",
  ) catch e {
    fatal("stale", "cannot write ${ctx.srcDir}/bit.json: " + e.message())
  }
}

// One git config redirecting BOTH repositories: `bit add`/`bit up` derive
// `https://` urls for the direct dependency and for every transitive one.
fn writeStaleRewrite(root: string, base: FixtureCtx, needs: FixtureCtx): string {
  let path = root + "/stale-rewrite.gitconfig"
  let text = "[url \"file://${base.srcDir}\"]\n\tinsteadOf = https://${gitHost}/${owner}/${staleBaseName}.git\n" +
    "[url \"file://${needs.srcDir}\"]\n\tinsteadOf = https://${gitHost}/${owner}/${staleNeedsName}.git\n"
  writeFile(path, text) catch e {
    fatal("stale", "cannot write git insteadOf config: " + e.message())
  }
  return path
}

fn runStale(cli: CliCtx, rewrite: string, args: []string, tag: string) {
  let env = ["HOME=" + cli.home, "GIT_CONFIG_GLOBAL=" + rewrite, "GIT_CONFIG_SYSTEM=/dev/null"]
  let run = runBitCli(cli, env, args, cli.projDir + "/${tag}.out", cli.projDir + "/${tag}.err")
  if (run.code != 0) {
    fatal(cli.name, "`bit ${args[0]}` (${tag}) exited ${run.code}, want 0\n  stderr: ${run.stderr}")
  }
}

fn assertStaleLock(cli: CliCtx, version: string, commit: string) {
  let entry = readLockEntry(cli.name, cli.projDir, staleBaseName)
  assertJsonString(cli.name, "bit.lock .stalebase", entry, "version", version)
  assertJsonString(cli.name, "bit.lock .stalebase", entry, "commit", commit)
}

// Through the real JSON parser, never a substring search: an empty or
// truncated bit.lock also lacks the key, so the file must parse as an object.
fn assertNoLockKey(cli: CliCtx, key: string) {
  let doc = jsonParse(readFileMust(cli.name, cli.projDir + "/bit.lock")) catch e {
    fatal(cli.name, "cannot parse bit.lock: " + e.message())
    Json.JsonNull
  }
  if (isSome(jsonGet(doc, key))) {
    fatal(cli.name, "bit.lock still has a '${key}' entry nothing requires")
  }
}
