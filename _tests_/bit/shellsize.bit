// _tests_/bit/shellsize.bit — hard-zero 800-line ceiling over every shell
// script under scripts/ and dist/ (#4232).
//
// No gate has ever covered a shell file's size. `test-lint-filelines` and
// `test-lint-sweep` both scan `.bit` files via `bit lint` (E0200) — shell is
// invisible to both. `dist/release.sh` sat at exactly 800 lines and later
// grew to 884 with nothing failing; #4132 split it back down to 608, but the
// mechanism gap stayed open — the next few-line edit to any shell script
// could silently cross 800 with nothing to catch it.
//
// THIS IS A HARD ZERO, NOT A RATCHET, AND THAT IS THE DESIGN. `_tests_/bit/
// filesize.bit`'s grandfather-list shape exists because introducing an
// 800-line limit into a tree that already had seven files over it needed a
// shrink-only allowlist. There is no equivalent debt here — every shell file
// in the tree is under 800 today (`gate.sh` itself is closest, at 797-799)
// — so a per-file ceiling with no debt list has no "silently absorbs a new
// debt file" failure mode a COUNTED ratchet has: every file is checked
// independently, on its own line count, and there is nothing to seed. This
// repo retired five counted fmt ceilings for exactly that reason (#3713);
// do not reintroduce the shape here by adding an allowlist nobody asked for.
//
// SCOPE: every `*.sh` file anywhere under `scripts/` or `dist/`, recursively
// — `dist/brew/publish.sh` and anything under `scripts/regex-oracle/` (a
// fixture directory, not the topic of this gate, but still shell if it ever
// grows one) must not silently sit outside the walk the way non-recursive
// scans have escaped gates before in this repo (#2793, #2868).
//
// THE RULE IS `> 800` FAILS, NOT `>= 800` — the same threshold E0200 and
// _tests_/bit/filesize.bit use, so a file sitting exactly at 800 is not a
// false positive.
//
// LINE COUNTING MATCHES `wc -l`, DELIBERATELY NOT E0200's convention. The
// proposed shape in #4232 is a `wc -l` walk, and this harness exists to be
// that check running through `./make` rather than a shell one-liner nobody
// remembers to run — so it must count lines the same way: newline characters
// only, with no +1 for an unterminated final line. `_tests_/bit/filesize.bit`'s
// `lineCount` adds that +1 because it mirrors `compiler/lint.bit`'s E0200
// counter; a shell script with no trailing newline is unusual but not an
// error, and `wc -l` reports one line lower than #2793's file-size gate would
// for the exact same bytes. Both counters are correct for what they measure;
// conflating them would make this gate's failures NOT reproduce with the
// `wc -l` command line #4232's ticket documents as the reference check.
//
// THE DENOMINATOR PRINTS EVERY RUN, PASS OR FAIL — a `find` that matched zero
// shell files would report the same clean verdict as a healthy tree, and
// this repo has hit that exact failure shape three times in one week
// (a `compiler/**/*.bit` glob that matched nothing, `bit fmt --check`'s
// stderr-only output read from stdout, and the `ARM64_RELOC_BRANCH26`
// relocation count that is always zero on this toolchain). Printing the
// scanned count is how a silently-empty walk is told apart from a genuinely
// clean tree.
//
// `BIT_REPO` overrides the directory searched for `scripts/`/`dist/`
// subdirectories (default: search . / .. / ../.. / ../../..), the same
// override every sibling _tests_/bit/*.bit harness reads — used by this
// gate's own mutation self-test to point the scan at a scratch tree instead
// of the real one.
//
// Run from the repository root: bit-out/bin/bit run _tests_/bit/shellsize.bit

import { readDir, readFile, isDir } from "std/fs"
import { env } from "std/os"
import { hasSuffix } from "std/strings"

// Bounds — Power of 10 rule 2: every walk below is over a small, fixed pair
// of directories, but each is still capped explicitly.
const maxFiles: int = 256
const maxFileBytes: int = 4194304
const maxScanDepth: int = 8

// The hard limit itself — E0200's default in compiler/lint.bit, restated
// here rather than imported: this gate is deliberately independent of the
// checker front end, so a bug in `bit lint` cannot silently disable it.
const maxFileLines: int = 800

class ScanResult { failures: int, filesScanned: int }

fn die(msg: string) {
  eprint("shellsize: SETUP FAILED: ${msg}\n")
  osExit(1)
}

fn report(sc: ScanResult, msg: string) {
  eprint("shellsize: FAIL: ${msg}\n")
  sc.failures = sc.failures + 1
}

// The repo root: the nearest ancestor holding both a `scripts` and a `dist`
// directory. `BIT_REPO` wins outright, including for a scratch tree this
// gate's own mutation test points it at — never falls back silently.
fn repoRoot(): string {
  let override = env("BIT_REPO")
  if (len(override) > 0) {
    return override
  }
  let candidates = [".", "..", "../..", "../../.."]
  for c of candidates {
    if (isDir("${c}/scripts") && isDir("${c}/dist")) {
      return c
    }
  }
  die("cannot locate scripts/ and dist/ from this cwd; set BIT_REPO")
  return ""
}

// Counts newline characters only — `wc -l`'s own convention, and
// deliberately NOT _tests_/bit/filesize.bit's E0200-mirroring `lineCount`
// (which adds one more for an unterminated final line). See the header for
// why the two harnesses count differently on purpose.
fn lineCount(src: string): int {
  let n = 0
  let i = 0
  while (i < len(src)) {
    if (src[i] == '\n') {
      n = n + 1
    }
    i = i + 1
  }
  return n
}

fn exceedsLimit(count: int): bool {
  return count > maxFileLines
}

fn checkFile(sc: ScanResult, path: string, count: int) {
  sc.filesScanned = sc.filesScanned + 1
  if (exceedsLimit(count)) {
    report(sc, "${path} is ${count} lines, over the ${maxFileLines}-line limit")
  }
}

// Recurses through `dir`, checking every `*.sh` file's line count against
// `maxFileLines` and descending into every subdirectory — no fixture-corpus
// exclusion (unlike _tests_/bit/filesize.bit): scripts/ and dist/ hold no
// deliberately-oversized fixture inputs, only real, maintained scripts.
// `depth` is `maxScanDepth` at the top call and falls to 0 at the deepest
// permitted level — Power of 10 rule 2's bound on the recursion.
fn scanDir(sc: ScanResult, dir: string, depth: int) {
  if (depth <= 0) {
    die("scan nesting exceeds ${maxScanDepth} levels at ${dir}")
  }
  let names = readDir(dir) catch e {
    die("cannot list ${dir}: ${e.message()}")
    []string(0)
  }
  if (len(names) > maxFiles) {
    die("${dir} has ${len(names)} entries, over the ${maxFiles} bound")
  }
  for name of names {
    let path = "${dir}/${name}"
    if (isDir(path)) {
      scanDir(sc, path, depth - 1)
      continue
    }
    if (!hasSuffix(name, ".sh")) {
      continue
    }
    let src = readFile(path) catch e {
      die("cannot read ${path}: ${e.message()}")
      ""
    }
    if (len(src) > maxFileBytes) {
      die("${path} is ${len(src)} bytes, over the ${maxFileBytes} bound")
    }
    checkFile(sc, path, lineCount(src))
  }
}

fn reportResult(sc: ScanResult) {
  if (sc.failures > 0) {
    eprint("shellsize: FAILED — ${sc.failures} finding(s) over ${sc.filesScanned} shell file(s) scanned\n")
    osExit(1)
  }
  print("shellsize: ok — ${sc.filesScanned} shell file(s) scanned, 0 over the ${maxFileLines}-line limit\n")
}

fn selfCheck(cond: bool, label: string): int {
  if (cond) {
    return 0
  }
  eprint("shellsize: SELFTEST FAIL: ${label}\n")
  return 1
}

fn selfTestLineCount(): int {
  let failed = 0
  failed = failed + selfCheck(lineCount("") == 0, "lineCount misjudged an empty file")
  failed = failed +
    selfCheck(
      lineCount("abc") == 0,
      "lineCount counted an unterminated line — must match wc -l, not E0200",
    )
  failed = failed +
    selfCheck(lineCount("abc\n") == 1, "lineCount misjudged a single terminated line")
  failed = failed + selfCheck(lineCount("a\nb\n") == 2, "lineCount misjudged two terminated lines")
  failed = failed +
    selfCheck(
      lineCount("a\nb") == 1,
      "lineCount counted a trailing unterminated line — must match wc -l",
    )
  return failed
}

fn selfTestExceedsLimit(): int {
  let failed = 0
  failed = failed +
    selfCheck(!exceedsLimit(800), "exceedsLimit flagged a file sitting exactly at the limit")
  failed = failed +
    selfCheck(exceedsLimit(801), "exceedsLimit missed a file one line over the limit")
  failed = failed + selfCheck(!exceedsLimit(0), "exceedsLimit flagged an empty file")
  return failed
}

fn selfTest(): int {
  return selfTestLineCount() + selfTestExceedsLimit()
}

fn main() {
  let selfFailed = selfTest()
  if (selfFailed != 0) {
    eprint("shellsize: SELFTEST FAILED — ${selfFailed} case(s); aborting before the real scan\n")
    osExit(1)
  }

  let root = repoRoot()
  let sc = ScanResult{ failures: 0, filesScanned: 0 }
  scanDir(sc, "${root}/scripts", maxScanDepth)
  scanDir(sc, "${root}/dist", maxScanDepth)
  reportResult(sc)
}
