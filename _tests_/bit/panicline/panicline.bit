// _tests_/bit/panicline — #6458: a compiler panic is never a diagnostic. The
// checkerdiag and golden harnesses compare `bit check`'s stderr byte for byte
// against a pinned `.expected`, so regenerating an `.expected` from a binary
// that crashed freezes `panic: ...` into a green fixture (#6440: an arm64
// decoder's "index out of range" was pinned and only test-golden noticed).
// Both harnesses call `panicLine` on the expected text AND the actual text of
// every `// error` case and fail the case when it returns a non-empty line.

import { hasPrefix, indexOf } from "std/strings"

// The first line of `text` that starts with `panic:`, without its line
// terminator, or "" when there is none. Column 0 only: the runtime renders a
// panic as `panic: <msg>\n` (SPEC.md §18.4), so an indented or mid-line
// `panic:` is source being quoted by a diagnostic, not a crash.
export fn panicLine(text: string): string {
  let rest = text
  while (len(rest) > 0) {
    let nl = indexOf(rest, "\n")
    let line = rest
    if (nl >= 0) {
      line = rest[0:nl]
      rest = rest[nl + 1:len(rest)]
    } else {
      rest = ""
    }
    if (hasPrefix(line, "panic:")) {
      return trimCr(line)
    }
  }
  return ""
}

fn trimCr(line: string): string {
  if (len(line) > 0 && line[len(line) - 1] == 13) { // \r
    return line[0:len(line) - 1]
  }
  return line
}
