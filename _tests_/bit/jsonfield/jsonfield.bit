// _tests_/bit/jsonfield — two fixtures, each needing a compiler newer than the
// pinned stage0:
//
//   cases/json_field.bit (#7766): a `@json` field of type `Json` (std/json)
//   passes through `toJson`, `__jsonAppend`, `jsonDecode` and `jsonDecodeText`,
//   and an absent key decodes to `JsonNull`. The pinned stage0 rejects it
//   (E0040 undefined name '__json_dec_Json').
//
//   cases/json_enum.bit (#7773): `jsonDecodeText<T>` decodes a payload-free
//   enum field, bare and inside `[]T`, `map<string, T>` and `Option<T>`,
//   exactly as `jsonDecode<T>` does, error for error. The pinned stage0 sends
//   the field through the integer helper (E0053 cannot convert 'i64' to
//   'Status').
//
// NOT placed in _tests_/cases/ for that reason: every
// scripts/selfhost-diff*.sh differential walks that corpus against the pinned
// stage0 (#5585), so a file stage0 cannot compile would score MISMATCH by
// construction. This drives the CLI directly instead, the treatment
// _tests_/bit/forofarrow.bit documents.
//
// The fixtures sit in the `cases/` subdirectory so this directory module never
// loads them as source. The harness builds each with `$BIT_BIN build`, runs the
// binary and requires exit 0 with stdout byte-equal to cases/<name>.expected.
//
// Retirement: a fixture moves back to _tests_/cases/ (as a `// run` case,
// census.bit's `c[dRun]` + 1) at the first stage0 repin to a release that
// handles it; delete this directory with the last one.
//
// WIRED INTO `./make test` as `test-jsonfield`
// (tools/build/gatestable3.bit, tools/build/defs.bit).
//
// Usage:
//   BIT_CASES_DIR=$PWD/_tests_/bit/jsonfield/cases BIT_BIN=$PWD/bit-out/bin/bit \
//   BIT_STDLIB=$PWD/stdlib BIT_LIBBITRT=<libbitrt.a> bit run _tests_/bit/jsonfield

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"
import { parseInt, trimSpace } from "std/strings"

const fixtures: []string = ["json_field", "json_enum"]

const defaultTimeoutS: int = 60
const maxTimeoutMs: int = 6000000

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("jsonfield: ${name} is not set — refusing to guess.\n")
    exit(2)
  }
  return v
}

fn timeoutMs(): int {
  let raw = trimSpace(envOr("BIT_TEST_TIMEOUT_S", ""))
  if (raw == "") {
    return defaultTimeoutS * 1000
  }
  let s = parseInt(raw) catch _ {
    return defaultTimeoutS * 1000
  }
  if (s <= 0 || s * 1000 > maxTimeoutMs) {
    return maxTimeoutMs
  }
  return s * 1000
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

// `exit()` does not run pending defers — call this explicitly at every exit
// site instead (same reasoning as forofarrow.bit's teardown).
fn teardown(scratch: string) {
  let shPath = scratch + "/rm.sh"
  writeFile(shPath, "#!/bin/sh\nrm -rf ${shQuote(scratch)}\n") catch _ {
    return
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    return
  }
  osRunBounded(shPath, timeoutMs())
}

fn die(scratch: string, msg: string, code: int) {
  eprint("jsonfield: ${msg}\n")
  teardown(scratch)
  exit(code)
}

// Writes `script` to `dir/<name>.sh`, runs it, and returns its exit code.
fn runScript(dir: string, name: string, script: string): int {
  let shPath = dir + "/" + name + ".sh"
  writeFile(shPath, script) catch e {
    die(dir, "cannot write ${shPath}: ${e.message()}", 2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    die(dir, "cannot chmod ${shPath}", 2)
  }
  return osRunBounded(shPath, timeoutMs())
}

// What every fixture run shares, bundled to keep the functions under LINT.md's
// max-params=5.
class Rig {
  bin: string,
  stdlib: string,
  libbitrt: string,
  casesDir: string,
  scratch: string,
}

// `$BIT_BIN build <fixture>.bit -o out` from the cases directory, with the
// compiler's environment exported; stderr lands in `build.err`.
fn buildScript(rig: Rig, fixture: string): string {
  return "#!/bin/sh\ncd " +
    shQuote(rig.casesDir) +
    " || exit 126\n" +
    "BIT_STDLIB=" +
    shQuote(rig.stdlib) +
    "\nexport BIT_STDLIB\n" +
    "BIT_LIBBITRT=" +
    shQuote(rig.libbitrt) +
    "\nexport BIT_LIBBITRT\n" +
    "exec " +
    shQuote(rig.bin) +
    " build " +
    fixture +
    ".bit -o " +
    shQuote(rig.scratch + "/fixture_out") +
    " > /dev/null 2> " +
    shQuote(rig.scratch + "/build.err") +
    "\n"
}

// Builds and runs one fixture; dies on the first deviation.
fn runFixture(rig: Rig, fixture: string) {
  let scratch = rig.scratch
  let casesDir = rig.casesDir
  let want = readFile(casesDir + "/" + fixture + ".expected") catch e {
    die(scratch, "cannot read ${fixture}.expected: ${e.message()}", 2)
    return
  }
  let outPath = scratch + "/fixture_out"
  let errPath = scratch + "/build.err"
  let buildCode = runScript(
    scratch, "build", buildScript(rig, fixture),
  )
  if (buildCode != 0) {
    let err = readFile(errPath) catch _ {
      ""
    }
    die(scratch, "FAIL — ${fixture} failed to build (exit ${buildCode}):\n${err}", 1)
  }
  let runOut = scratch + "/run.out"
  let runCode = runScript(
    scratch, "run", "#!/bin/sh\nexec " + shQuote(outPath) + " > " + shQuote(runOut) + " 2>&1\n",
  )
  let out = readFile(runOut) catch _ {
    ""
  }
  if (runCode != 0 || out != want) {
    die(
      scratch,
      "FAIL — ${fixture} ran wrong: exit=${runCode}\n  want: ${want}\n  got:  ${out}",
      1,
    )
  }
}

fn main() {
  let bin = requiredEnv("BIT_BIN")
  let stdlib = requiredEnv("BIT_STDLIB")
  let libbitrt = requiredEnv("BIT_LIBBITRT")
  let casesDir = requiredEnv("BIT_CASES_DIR")
  let scratch = envOr("TMPDIR", "/tmp") + "/bit-jsonfield-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("jsonfield: cannot create scratch directory ${scratch}: ${e.message()}\n")
    exit(2)
  }
  let rig = Rig{
    bin = bin, stdlib = stdlib, libbitrt = libbitrt, casesDir = casesDir, scratch = scratch,
  }
  for fixture of fixtures {
    runFixture(rig, fixture)
  }
  teardown(scratch)
  print("PASS jsonfield: a Json field and a payload-free enum field encode and decode (DOM and text) alike\n")
}
