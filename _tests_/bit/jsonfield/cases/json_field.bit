// #7766: a `@json` field of type `Json` (std/json). The value goes in and comes
// out UNTOUCHED, whatever kind it is: `toJson`, the direct byte encoder
// `__jsonAppend`, `jsonDecode<T>` and `jsonDecodeText<T>` all agree, and an
// ABSENT key decodes to `JsonNull` instead of failing (`Json` has a null of its
// own, so there is no missing-key cause for it).
//
// `St` is pkg/authz's `Statement` shape: `when` is an object, a string of
// source text or null depending on the document. `Bag` puts `Json` in every
// container position: bare, `[]Json`, `map<string, Json>` and `Option<Json>`,
// the last of which reads `null` as `None` like every other `Option`.
//
// A `map` field holds ONE entry in the documents below: a map iterates in its
// own order, so a second entry would make the encoded text vary between runs.
//
// THE ROUND TRIP IS THE ASSERTION for each document: decode, then encode with
// `jsonEncode(toJson())` AND with `__jsonAppend`, and print both. The two
// encoders must agree byte for byte, and (for a document with every key
// present) match the input.
import { Json, jsonParse, jsonEncode, jsonDecode, jsonDecodeText, jsonSchema, jsonIsNull } from "std/json"

@json class St {
  effect: string,
  when: Json,
}

@json class Bag {
  one: Json,
  list: []Json,
  named: map<string, Json>,
  maybe: Option<Json>,
}

fn direct(s: St): string {
  return string(s.__jsonAppend([]byte(0, 16)))
}

// Both decode entry points, the DOM one and the text one, on the same source.
fn viaDom(label: string, src: string) {
  let j = jsonParse(src) catch e {
    print("${label}: parse: ${e.message()}\n")
    return
  }
  let s = jsonDecode<St>(j) catch e {
    print("${label}: dom: ${e.message()}\n")
    return
  }
  print("${label}: dom toJson=${jsonEncode(s.toJson())} append=${direct(s)} null=${jsonIsNull(s.when)}\n")
}

fn viaText(label: string, src: string) {
  let s = jsonDecodeText<St>(src) catch e {
    print("${label}: text: ${e.message()}\n")
    return
  }
  print("${label}: text toJson=${jsonEncode(s.toJson())} append=${direct(s)} null=${jsonIsNull(s.when)}\n")
}

fn both(label: string, src: string) {
  viaDom(label, src)
  viaText(label, src)
}

fn bag(label: string, src: string) {
  let j = jsonParse(src) catch e {
    print("${label}: parse: ${e.message()}\n")
    return
  }
  let b = jsonDecode<Bag>(j) catch e {
    print("${label}: dom: ${e.message()}\n")
    return
  }
  let t = jsonDecodeText<Bag>(src) catch e {
    print("${label}: text: ${e.message()}\n")
    return
  }
  let some = isSome(b.maybe)
  print("${label}: named=${len(b.named)}/${len(t.named)} some=${some} dom=${jsonEncode(b.toJson())} same=${jsonEncode(t.toJson()) == jsonEncode(b.toJson())}\n")
  print("${label}: append=${string(b.__jsonAppend([]byte(0, 16)))}\n")
}

fn main() {
  // An object, a string, null, a number: every kind passes through.
  both(
    "object",
    "{\"effect\":\"allow\",\"when\":{\"team\":\"$user.team\",\"n\":[1,2.5,{\"deep\":[true,null]}]}}",
  )
  both("string", "{\"effect\":\"deny\",\"when\":\"user.team == 'a'\"}")
  both("null", "{\"effect\":\"allow\",\"when\":null}")
  both("number", "{\"effect\":\"allow\",\"when\":42}")
  both("array", "{\"effect\":\"allow\",\"when\":[[],{}]}")
  // Absent key: JsonNull, never a missing-key failure; the encoder writes it back as null.
  both("absent", "{\"effect\":\"allow\"}")
  // A key order the class does not use, and a repeated key (last wins).
  both("reordered", "{\"when\":{\"a\":1},\"effect\":\"allow\"}")
  both("dup", "{\"effect\":\"allow\",\"when\":1,\"when\":2}")
  // The neighbouring fields keep their own rules.
  both("missing-effect", "{\"when\":null}")
  both("unknown-key", "{\"effect\":\"allow\",\"when\":1,\"extra\":2}")
  // A malformed value inside the Json field is a parse error, positioned.
  viaText("bad-inside", "{\"effect\":\"allow\",\"when\":{\"a\":}}")

  bag(
    "full",
    "{\"one\":{\"k\":[1]},\"list\":[1,\"x\",null,{\"a\":2}],\"named\":{\"p\":[true,null,{\"r\":[]}]},\"maybe\":{\"m\":0}}",
  )
  bag("empty", "{\"one\":null,\"list\":[],\"named\":{},\"maybe\":null}")
  bag("absent", "{\"list\":[],\"named\":{}}")
  bag("maybe-string", "{\"one\":1,\"list\":[],\"named\":{},\"maybe\":\"s\"}")

  print("schema: ${jsonEncode(jsonSchema<St>())}\n")
  print("schema-bag: ${jsonEncode(jsonSchema<Bag>())}\n")
}
