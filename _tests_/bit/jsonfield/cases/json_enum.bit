// #7773: `jsonDecodeText<T>` for a payload-free `enum` field decodes exactly
// what `jsonDecode<T>` does, or fails with exactly the same error. Before the
// fix the text decoder sent an enum field through the integer helper, so the
// wire name `"Published"` failed as `expected a number`.
//
// One field of each shape an enum can reach: bare, inside `[]T`, inside
// `map<string, T>` and inside `Option<T>`. A map holds ONE entry in every
// document below: a map iterates in its own order, so a second entry would
// make the encoded text vary between runs.
//
// THE ASSERTION is the pair of lines per document. The first is the DOM result
// (`jsonParse` + `jsonDecode`), re-encoded with `toJson` and with the direct
// byte encoder `__jsonAppend`, or the error's message; the second is `same=`,
// whether the text decoder produced the identical string. A decode error's
// message carries its cause, path, expected and found, so equal messages are
// equal errors. A document that is not well-formed JSON is left out: the two
// entry points word that error differently by design.
import { jsonParse, jsonEncode, jsonDecode, jsonDecodeText } from "std/json"

enum Status {
  Draft,
  Published,
  Archived,
}

@json class Item {
  status: Status,
  history: []Status,
  tags: map<string, Status>,
  reviewed: Option<Status>,
}

fn render(it: Item): string {
  return "toJson=${jsonEncode(it.toJson())} append=${string(it.__jsonAppend([]byte(0, 16)))}"
}

fn viaDom(src: string): string {
  let j = jsonParse(src) catch e {
    return "parse: ${e.message()}"
  }
  let it = jsonDecode<Item>(j) catch e {
    return "error: ${e.message()}"
  }
  return render(it)
}

fn viaText(src: string): string {
  let it = jsonDecodeText<Item>(src) catch e {
    return "error: ${e.message()}"
  }
  return render(it)
}

fn both(label: string, src: string) {
  let dom = viaDom(src)
  print("${label}: ${dom}\n")
  print("${label}: same=${viaText(src) == dom}\n")
}

fn main() {
  // Every variant, at every position; Draft is tag 0, the value an untouched
  // local would hold, so it is the one a missing assignment could hide behind.
  both(
    "full",
    "{\"status\":\"Archived\",\"history\":[\"Draft\",\"Published\",\"Archived\"],\"tags\":{\"a\":\"Published\"},\"reviewed\":\"Archived\"}",
  )
  both(
    "draft",
    "{\"status\":\"Draft\",\"history\":[\"Draft\"],\"tags\":{\"a\":\"Draft\"},\"reviewed\":\"Draft\"}",
  )
  both("published", "{\"status\":\"Published\",\"history\":[],\"tags\":{},\"reviewed\":null}")
  both("absent-option", "{\"status\":\"Published\",\"history\":[],\"tags\":{}}")
  both(
    "reordered",
    "{\"reviewed\":\"Published\",\"tags\":{\"k\":\"Archived\"},\"history\":[\"Archived\"],\"status\":\"Published\"}",
  )
  both("dup", "{\"status\":\"Draft\",\"status\":\"Archived\",\"history\":[],\"tags\":{}}")
  both(
    "dup-history",
    "{\"status\":\"Draft\",\"history\":[\"Published\"],\"history\":[\"Archived\"],\"tags\":{}}",
  )

  // An unknown variant name: the field's dotted path and every declared variant.
  both("unknown-bare", "{\"status\":\"Nope\",\"history\":[],\"tags\":{}}")
  both("unknown-slice", "{\"status\":\"Draft\",\"history\":[\"Draft\",\"Nope\"],\"tags\":{}}")
  both("unknown-map", "{\"status\":\"Draft\",\"history\":[],\"tags\":{\"k\":\"Nope\"}}")
  both("unknown-option", "{\"status\":\"Draft\",\"history\":[],\"tags\":{},\"reviewed\":\"Nope\"}")
  both("unknown-case", "{\"status\":\"draft\",\"history\":[],\"tags\":{}}")

  // Not a string at all, and the neighbouring fields' own rules.
  both("number-bare", "{\"status\":1,\"history\":[],\"tags\":{}}")
  both("number-slice", "{\"status\":\"Draft\",\"history\":[0],\"tags\":{}}")
  both("null-bare", "{\"status\":null,\"history\":[],\"tags\":{}}")
  both("missing-status", "{\"history\":[],\"tags\":{}}")
  both("unknown-key", "{\"status\":\"Draft\",\"history\":[],\"tags\":{},\"extra\":1}")
}
