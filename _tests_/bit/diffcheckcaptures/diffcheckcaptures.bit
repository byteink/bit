import { runScript } from "../trampoline"

// Fake checkers test capture failures without another real corpus sweep.
export fn captureControls(root: string, scratch: string) {
  let script = "#!/bin/sh\nexec bash '" +
    root +
    "/_tests_/bit/diffcheckcaptures/controls.sh' '" +
    root +
    "' '" +
    scratch +
    "'\n"
  let code = runScript("${scratch}/capture-controls.sh", script, 60000) catch e {
    panic("diffcheckcaptures: ${e.message()}")
  }
  if (code != 0) {
    panic("diffcheckcaptures: controls exited ${code}")
  }
}
