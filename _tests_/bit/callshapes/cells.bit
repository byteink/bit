// The cell table (#6394): receivers x callees x argument shapes. A cell is one
// small program; `cells()` renders all of them from the three tables below, so
// adding a row to a table adds its whole row or column of programs.
import { replace } from "std/strings"

class Cell {
  id: string,
  call: string,
  main: string,
}

// How the call reaches its callee. `text` is the receiver as written in the
// call; `setup` runs first in `main`; `tparam` puts the call inside
// `fn viaT<T: Api>()`, with `T` bound at the call site to the mode's `K`.
class Recv {
  id: string,
  text: string,
  setup: string,
  tparam: bool,
}

// `@R` is the receiver, `@A` the written arguments, `@C` the arguments in
// parentheses, or nothing when `bare` and the shape is the right one. `val` and
// `mkK` take the mode's namespace prefix as `@P`.
class Callee {
  id: string,
  tmpl: string,
  bare: bool,
}

class Shape {
  id: string,
  args: string,
}

fn callees(): []Callee {
  return [
    Callee{ id = "static", tmpl = "@R.st(@A)", bare = false },
    Callee{ id = "inst", tmpl = "@R.inst(@A)", bare = false },
    Callee{ id = "gen", tmpl = "@R.gen(@A)", bare = false },
    Callee{ id = "ginst", tmpl = "@R.ginst(@A)", bare = false },
    Callee{ id = "hid", tmpl = "@R.hid(@A)", bare = false },
    Callee{ id = "missing", tmpl = "@R.nope(@A)", bare = false },
    Callee{ id = "ctor", tmpl = "@R(@A).n", bare = false },
    Callee{ id = "call", tmpl = "@R(@A)", bare = false },
    Callee{ id = "variant", tmpl = "@Pval(@R.V(@A))", bare = false },
    Callee{ id = "tag", tmpl = "@Pval(@R.W@C)", bare = true },
  ]
}

// The parameters are `(a: i64, b: string)`: the right call is `(2, "x")`.
fn shapes(): []Shape {
  return [
    Shape{ id = "right", args = "2, \"x\"" },
    Shape{ id = "arity", args = "2" },
    Shape{ id = "type", args = "\"x\", 2" },
    Shape{ id = "named", args = "a = 2, b = \"x\"" },
    Shape{ id = "reordered", args = "b = \"x\", a = 2" },
  ]
}

// The three ways a cell reaches the world: pasted into main.bit (L), named
// imports (I), a namespace import (N). `q` is the qualifier those spellings put
// before a name; a bound `T: m.Api` does not parse (E0021), so N imports `Api`
// by name for its type-parameter receiver. Only N can name what the module does
// not export (`m.H`, `m.hf`) and the namespace itself (`m`).
class Mode {
  id: string,
  head: string,
  q: string,
}

fn modes(): []Mode {
  return [
    Mode{ id = "L", head = "", q = "" },
    Mode{
      id = "I",
      head = "import { Api, E, G, K, f, mkG, mkK, val } from \"../../lib\"\n",
      q = "",
    },
    Mode{
      id = "N",
      head = "import * as m from \"../../lib\"\nimport { Api } from \"../../lib\"\n",
      q = "m.",
    },
  ]
}

fn receivers(m: Mode): []Recv {
  let q = m.q
  let out = [
    Recv{ id = "class", text = "${q}K", setup = "", tparam = false },
    Recv{ id = "gbare", text = "${q}G", setup = "", tparam = false },
    Recv{ id = "ginst", text = "${q}G<i64>", setup = "", tparam = false },
    Recv{ id = "enum", text = "${q}E", setup = "", tparam = false },
    Recv{ id = "func", text = "${q}f", setup = "", tparam = false },
    Recv{ id = "tparam", text = "T", setup = "", tparam = true },
    Recv{ id = "value", text = "k", setup = "  let k = ${q}mkK()\n", tparam = false },
    Recv{ id = "gvalue", text = "k", setup = "  let k = ${q}mkG()\n", tparam = false },
  ]
  if (m.id == "N") {
    out = append(out, Recv{ id = "hcls", text = "m.H", setup = "", tparam = false })
    out = append(out, Recv{ id = "hfunc", text = "m.hf", setup = "", tparam = false })
    out = append(out, Recv{ id = "ns", text = "m", setup = "", tparam = false })
  }
  return out
}

fn callText(c: Callee, r: Recv, s: Shape, q: string): string {
  let parens = "(${s.args})"
  if (c.bare && s.id == "right") {
    parens = ""
  }
  let t = replace(c.tmpl, "@P", q)
  t = replace(t, "@R", r.text)
  t = replace(t, "@C", parens)
  return replace(t, "@A", s.args)
}

// `num` takes only an i64, so a call that yields anything else (a class, an
// enum) is an error, never a program that prints something other than 2.
fn mainText(m: Mode, r: Recv, call: string): string {
  let src = m.head
  if (m.id == "L") {
    src = src + replace(worldDecls(), "export ", "")
  }
  src = src + "fn num(x: i64): string {\n  return \"\${x}\"\n}\n"
  if (r.tparam) {
    src = src + "fn viaT<T: Api>(): i64 {\n  return ${call}\n}\n"
    return src + "fn main() {\n  println(num(viaT<${m.q}K>()))\n}\n"
  }
  return src + "fn main() {\n${r.setup}  println(num(${call}))\n}\n"
}

fn cells(): []Cell {
  let out = []Cell(0)
  for m of modes() {
    for r of receivers(m) {
      for c of callees() {
        for s of shapes() {
          let call = callText(c, r, s, m.q)
          out = append(
            out,
            Cell{
              id = "${m.id}-${r.id}-${c.id}-${s.id}",
              call = call,
              main = mainText(m, r, call),
            },
          )
        }
      }
    }
  }
  return out
}
