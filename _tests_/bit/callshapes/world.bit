// The declarations every cell calls into (#6394). One text, three spellings:
// a cell in mode L pastes it into main.bit with `export ` stripped; modes I and
// N write it as the exported module lib/lib.bit, which `import { K, .. }` and
// `import * as m` then reach. Every callable returns 2 for the arguments
// `(2, "x")`, so a cell that is accepted and built must print exactly 2.
//
//   K       a class with init, an instance method, a static, a generic
//           static, a generic instance method and an unexported static
//   G<T>    a generic class: init and a static
//   E       an enum: a payload variant V, a bare variant W, an instance method
//           and a static (#6403)
//   Api     what `T` is bound by in a type-parameter receiver
//   f       a free function
//   H hf    a class and a function the module does not export
//   val     reads an E back to the same 2
//   mkK mkG a value of K / G<i64>, built where the cell can name it
fn worldDecls(): string {
  return worldTypes() + worldFns()
}

fn worldTypes(): string {
  return `export interface Api {
  static st(a: i64, b: string): i64,
  inst(a: i64, b: string): i64,
}

export class K {
  export n: i64,

  init(a: i64, b: string) {
    this.n = a * len(b)
  }

  export static st(a: i64, b: string): i64 {
    return a * len(b)
  }

  export inst(a: i64, b: string): i64 {
    return a * len(b)
  }

  static hid(a: i64, b: string): i64 {
    return a * len(b)
  }

  export static gen<U>(a: i64, b: U): i64 {
    return a
  }

  export ginst<U>(a: i64, b: U): i64 {
    return a
  }
}

export class G<T> {
  export n: i64,
  export t: T,

  init(a: i64, b: string) {
    this.n = a * len(b)
  }

  export static st(a: i64, b: string): i64 {
    return a * len(b)
  }
}

export enum E {
  V(i64, string),
  W,

  inst(a: i64, b: string): i64 {
    return a * len(b)
  }

  export static st(a: i64, b: string): i64 {
    return a * len(b)
  }
}

`
}

fn worldFns(): string {
  return `export fn val(e: E): i64 {
  match (e) {
    V(a, b) => return a * len(b),
    W => return 2,
  }
}

export fn f(a: i64, b: string): i64 {
  return a * len(b)
}

class H {
  static st(a: i64, b: string): i64 {
    return a * len(b)
  }
}

fn hf(a: i64, b: string): i64 {
  return a * len(b)
}

export fn mkK(): K {
  return K(2, "x")
}

export fn mkG(): G<i64> {
  return G<i64>(2, "x")
}
`
}
