// Cells whose check and build still disagree, each under the ticket that fixes
// it (#6394). The list is asserted both ways by callshapes.bit: a cell missing
// from it that disagrees fails the gate, and a cell on it that now agrees fails
// it too, naming the cell and its ticket. A cell id is `<mode>-<receiver>-
// <callee>-<shape>`, as `cells()` (cells.bit) builds it: mode L (declared in
// main.bit), I (`import { K }`), N (`import * as m`).
//
// A rule is `<modes> <receiver> <callee> <shapes>`: every mode letter times
// every shape word, e.g. `LI class inst arity right` is the four cells
// I-class-inst-arity, I-class-inst-right, L-class-inst-arity and
// L-class-inst-right. To fix a cell, delete its shape word (or its mode letter,
// or the rule) once the gate says it agrees.
//
// #6392: a member of a type name, namespace or namespaced type that is not a
// static of it (`K.inst(1)`, `K.nope(1)`, `m.E.A`, `m.K(1)`, `m.mk(1)`).
// #6398: a member call on a function name. #6399: a wrong call to a function
// through a namespace. #6400: a static called through a value. #6401: a member
// call on a type parameter that its bound does not declare. #6402: the same
// through `T.hid(..)` and `T(..)`, where the compiler panics or the program
// builds and crashes.
import { split } from "std/strings"

class Known {
  id: string,
  ticket: string,
}

// Expands every rule of every ticket into the cell ids it names.
fn knownFailures(): []Known {
  let out = []Known(0)
  for t of tickets() {
    for rule of t.rules {
      for id of expandRule(rule) {
        out = append(out, Known{ id = id, ticket = t.ticket })
      }
    }
  }
  return out
}

class Ticket {
  ticket: string,
  rules: []string,
}

fn tickets(): []Ticket {
  return [
    Ticket{ ticket = "#6392", rules = rules6392() },
    Ticket{ ticket = "#6398", rules = rules6398() },
    Ticket{ ticket = "#6399", rules = rules6399() },
    Ticket{ ticket = "#6400", rules = rules6400() },
    Ticket{ ticket = "#6401", rules = rules6401() },
    Ticket{ ticket = "#6402", rules = rules6402() },
  ]
}

// "LI class inst arity right" -> the cells L-class-inst-arity, L-class-inst-right,
// I-class-inst-arity and I-class-inst-right.
fn expandRule(rule: string): []string {
  let out = []string(0)
  let w = split(rule, " ")
  if (len(w) < 4) {
    panic("callshapes: known-failure rule needs modes, receiver, callee and a shape: ${rule}")
  }
  let i = 0
  while (i < len(w[0])) {
    for shape of w[3:len(w)] {
      out = append(out, "${w[0][i:i + 1]}-${w[1]}-${w[2]}-${shape}")
    }
    i = i + 1
  }
  return out
}

// #6392: a type name, a namespace or a namespaced type that is not a static of it.
fn rules6392(): []string {
  return [
    "N class call arity right type",
    "N class ctor arity right type",
    "LIN class ginst arity right type",
    "LIN class inst arity right type",
    "LIN class missing arity right type",
    "LIN class tag arity right type",
    "LIN class variant arity right type",
    "N enum call arity right type",
    "N enum ctor arity right type",
    "N enum gen arity right type",
    "N enum ginst arity right type",
    "N enum hid arity right type",
    "N enum inst arity right type",
    "N enum missing arity right type",
    "N enum static arity right type",
    "N enum tag arity right type",
    "N enum variant arity right type",
    "N gbare call arity right type",
    "N gbare ctor arity right type",
    "LIN gbare gen arity right type",
    "LIN gbare ginst arity right type",
    "LIN gbare hid arity right type",
    "LIN gbare inst arity right type",
    "LIN gbare missing arity right type",
    "LIN gbare tag arity right type",
    "LIN gbare variant arity right type",
    "N ginst call arity right type",
    "N ginst ctor arity right type",
    "LIN ginst gen arity right type",
    "LIN ginst ginst arity right type",
    "LIN ginst hid arity right type",
    "LIN ginst inst arity right type",
    "LIN ginst missing arity right type",
    "N ginst static arity right type",
    "LIN ginst tag arity right type",
    "LIN ginst variant arity right type",
    "N ns call arity right type",
    "N ns ctor arity right type",
    "N ns gen arity right type",
    "N ns ginst arity right type",
    "N ns inst arity right type",
    "N ns static arity right type",
  ]
}

// #6398: a member call on a function name.
fn rules6398(): []string {
  return [
    "LIN func gen arity right type",
    "LIN func ginst arity right type",
    "LIN func hid arity right type",
    "LIN func inst arity right type",
    "LIN func missing arity right type",
    "LIN func static arity right type",
    "LIN func tag arity right type",
    "LIN func variant arity right type",
  ]
}

// #6399: a wrong call to a function through a namespace.
fn rules6399(): []string {
  return [
    "N func call arity type",
  ]
}

// #6400: a static called through a value.
fn rules6400(): []string {
  return [
    "LIN gvalue static right named reordered",
    "L value hid right",
    "LIN value hid named reordered",
    "LIN value static right named reordered",
  ]
}

// #6401: a member call on a type parameter that its bound does not declare.
fn rules6401(): []string {
  return [
    "LIN tparam gen arity right type",
    "LIN tparam ginst arity right type",
    "LIN tparam inst arity right type",
    "LIN tparam missing arity right type",
    "LIN tparam tag arity right type",
    "LIN tparam variant arity right type",
  ]
}

// #6402: T.hid(..) and T(..) through a type parameter: a compiler panic, or a program that builds and crashes.
fn rules6402(): []string {
  return [
    "LIN tparam ctor arity",
    "LIN tparam hid arity type",
  ]
}
