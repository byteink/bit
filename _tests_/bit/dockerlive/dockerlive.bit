// _tests_/bit/dockerlive/dockerlive.bit — the Docker plumbing every live
// harness shares (redislive, s3live, ormlive, webguidesapp, jobslive; #6353).
//
// THE DEFECT THIS CLOSES. Each harness used to probe `docker info` once with a
// 10 s budget and, when that failed or was slow, print "skipped: docker
// unavailable" and exit 0. A live gate exists only to run against a real
// server, so a gate that skips is green having run nothing: it happened twice
// on 2026-09-30, once hiding a mutated package, both times with Docker Desktop
// up but loaded by another session.
//
// THE RULE NOW. `requireDocker` is the only way a harness gets a docker
// binary. It probes up to `probeAttempts` times (a slow-but-alive daemon is
// waited for, budget `probeAttempts * dockerQuickTimeoutMs` plus the gaps)
// and, if every attempt fails, exits 1 naming the last probe error and how
// long the whole probe took. The one remaining skip is an explicit opt-out,
// `BIT_LIVE_OPTIONAL=1`, which nothing in this repo sets.
//
// REMOTE MODE (#7428). The dev Mac's Docker can be down while an ssh host with
// Docker is up. With `BIT_LIVE_DOCKER_HOST=<ssh host>` set, `requireDocker`
// returns a generated `docker` shim that runs every docker call as
// `ssh -n <host> docker ...` (stdin closed: an ssh child that inherits stdin
// eats a payload), so the harnesses' own `output(bin, ...)` calls need no
// edit. On top of that this file adds what a remote daemon needs:
//   - the host's `/tmp/benchlock` DIRECTORY lock (the lock the host's other
//     users take) is held from the first `docker run` until `releaseDocker`,
//     by ONE ssh session (#7604): a remote holder takes the lock, the harness
//     feeds it a heartbeat line over the session's stdin, and the holder's
//     trap removes the run's containers and the lock when that session ends
//     for ANY reason, SIGKILL of this process included. The acquire, heartbeat
//     and stale-reclaim rules are scripts/x64gate.sh's `lock-lib`, the text
//     x64gate ships in its own session, so both acquirers agree;
//   - `hostPort` opens one `ssh -N -L` tunnel per published port, checks it
//     accepts on 127.0.0.1, and returns the LOCAL port, so every URI a
//     harness builds from it points at the tunnel unchanged;
//   - a `-v <dir>:<target>` bind mount is copied to the host first (the
//     local path does not exist there).
// Every harness calls `releaseDocker(bin)` from its one cleanup function,
// AFTER its containers are removed: it kills the tunnels, removes the staged
// directories and ends the holder session, on success and on failure alike. Unset,
// nothing here runs and the local behaviour is unchanged.
//
// `failureText` is the one place a failed child's message is built, so a
// timed-out docker call says "timed out after Nms" instead of printing an
// empty stderr (s3live's `docker run: ` on 2026-09-30).

import { output, RunResult } from "std/process"
import { envOr, exit } from "std/os"
import { exists, mkdir, readFile, remove, writeFile } from "std/fs"
import { dialDeadline } from "std/net"
import { contains, hasPrefix, hasSuffix, join, lastIndexOf, parseInt, split, trim, trimSpace } from "std/strings"
import { sleep, monotonic, since, Millisecond } from "std/time"

// A `docker` call that returns at once (info, port, ps, exec): 10 s.
export const dockerQuickTimeoutMs: int = 10000
// A `docker` call that may pull an image or boot a container: 30 s.
export const dockerRunTimeoutMs: int = 30000

const probeAttempts: int = 3
const probeGapMs: int = 2000
const optionalEnv: string = "BIT_LIVE_OPTIONAL"
// `std/process`'s `output` reports a child killed at its deadline as -2.
const timedOutCode: int = -2

// `std/process` execs directly with no PATH search (its own doc comment), so
// `docker`/`openssl` have to be found by hand — a fixed, bounded list of the
// paths Docker Desktop and this repo's package managers actually install to,
// not a filesystem search.
export fn findBin(candidates: []string): string {
  let i = 0
  while (i < len(candidates)) {
    if (exists(candidates[i])) {
      return candidates[i]
    }
    i = i + 1
  }
  return ""
}

fn dockerCandidates(): []string {
  return ["/usr/local/bin/docker", "/opt/homebrew/bin/docker", "/usr/bin/docker"]
}

// Why a finished child failed, for an error message: "timed out after Nms"
// when it was killed at its deadline (its stderr is empty then), else its
// trimmed stderr, else its exit code when it said nothing.
export fn failureText(r: RunResult, timeoutMs: int): string {
  if (r.exitCode == timedOutCode) {
    return "timed out after ${timeoutMs}ms"
  }
  let msg = trimSpace(r.stderr)
  if (msg == "") {
    return "exited ${r.exitCode} with no stderr"
  }
  return msg
}

// One `docker info`; "" when the daemon answered, else why it did not.
fn probeOnce(bin: string): string {
  let r = output(bin, ["info"], dockerQuickTimeoutMs)
  if (r.exitCode == 0) {
    return ""
  }
  return failureText(r, dockerQuickTimeoutMs)
}

// Up to `probeAttempts` probes with a short gap; "" on the first success,
// else the last attempt's failure.
fn probe(bin: string): string {
  let why = ""
  let i = 0
  while (i < probeAttempts) {
    why = probeOnce(bin)
    if (why == "") {
      return ""
    }
    i = i + 1
    if (i < probeAttempts) {
      sleep(probeGapMs * Millisecond)
    }
  }
  return "`docker info` failed ${probeAttempts} times, last: ${why}"
}

// Why no docker is usable: "" when it is.
fn unavailableReason(bin: string): string {
  if (bin == "") {
    return "no docker binary at ${join(dockerCandidates(), ", ")}"
  }
  return probe(bin)
}

// The docker binary, or the process exits: 1 naming the probe error and how
// long probing took, or 0 with "skipped: ..." only under BIT_LIVE_OPTIONAL=1.
// `who` prefixes the message (the harness's own name).
export fn requireDocker(who: string): string {
  let bin = findBin(dockerCandidates())
  if (remoteHost() != "") {
    bin = installShim() catch e {
      eprint("${who}: ${remoteHostEnv} is set but the remote docker shim could not be made: ${e.message()}\n")
      exit(1)
      return ""
    }
  }
  let start = monotonic()
  let why = unavailableReason(bin)
  if (why == "") {
    return bin
  }
  giveUp(who, why, since(start) / Millisecond)
  return ""
}

// Ends the process because no usable docker (or docker host) exists: exit 0
// with "skipped: ..." only under BIT_LIVE_OPTIONAL=1, else exit 1 naming `why`.
// `who` prefixes the message; `tookMs` is how long finding out took.
export fn giveUp(who: string, why: string, tookMs: int) {
  if (envOr(optionalEnv, "") == "1") {
    print("skipped: docker unavailable (${optionalEnv}=1): ${why} (${tookMs}ms)\n")
    exit(0)
    return
  }
  eprint("${who}: docker unavailable after ${tookMs}ms: ${why}\n")
  eprint("${who}: a live gate that skips is green having run nothing; set ${optionalEnv}=1 to skip on purpose\n")
  exit(1)
}

// `docker <args>` with remote mode applied (lock, label, staged mounts), its
// stdout, stderr and exit code returned to the caller. A non-zero exit is the
// caller's to judge: it is what a program run in a container reports.
export fn dockerOutput(bin: string, args: []string, timeoutMs: int): RunResult! {
  let argv = remoteRunArgs(bin, args)?
  return output(bin, argv, timeoutMs)
}

export fn dockerRun(bin: string, args: []string): ()! {
  let r = dockerOutput(bin, args, dockerRunTimeoutMs)?
  if (r.exitCode != 0) {
    fail newError("docker ${args[0]}: ${failureText(r, dockerRunTimeoutMs)}")
  }
}

// The host port docker published for `name`'s `containerPort` ("5432/tcp").
export fn hostPort(bin: string, name: string, containerPort: string): int! {
  let r = output(bin, ["port", name, containerPort], dockerQuickTimeoutMs)
  if (r.exitCode != 0) {
    fail newError("docker port ${name}: ${failureText(r, dockerQuickTimeoutMs)}")
  }
  let lines = split(trimSpace(r.stdout), "\n")
  if (len(lines) == 0 || lines[0] == "") {
    fail newError("docker port ${name}: no mapping printed")
  }
  let colon = lastIndexOf(lines[0], ":")
  if (colon < 0) {
    fail newError("docker port ${name}: unexpected output '${lines[0]}'")
  }
  let port = parseInt(lines[0][colon + 1:])?
  if (isRemote(bin)) {
    return openTunnel(bin, port)?
  }
  return port
}

// Relays a `bit test` child's streams and returns its exit code, saying so
// when the deadline killed it: `who` names the harness.
export fn relay(r: RunResult, who: string, timeoutMs: int): int {
  print(r.stdout)
  eprint(r.stderr)
  if (r.exitCode == timedOutCode) {
    eprint("${who}: timed out after ${timeoutMs}ms\n")
  }
  return r.exitCode
}

// Pairs with a harness's own run label on every container it starts: the
// owning process's pid, so `sweepOrphans` spares a live peer's container
// (#6327).
export const ownerLabelKey: string = "bit.live.owner"

// This process's own pid, read off `/bin/sh -c 'echo $PPID'`: `std/process`
// execs every child directly with no shell (its own doc comment), so a
// freshly spawned `/bin/sh`'s parent is always this process itself.
export fn selfPid(): int! {
  let r = output("/bin/sh", ["-c", "echo $PPID"], dockerQuickTimeoutMs)
  if (r.exitCode != 0) {
    fail newError("selfPid: /bin/sh exited ${r.exitCode}: ${trimSpace(r.stderr)}")
  }
  return parseInt(trimSpace(r.stdout))?
}

// Whether `pid` still names a live process: `kill -0` sends no signal, it
// only checks existence.
fn pidAlive(pid: int): bool {
  let r = output("/bin/sh", ["-c", "kill -0 ${pid} 2>/dev/null"], dockerQuickTimeoutMs)
  return r.exitCode == 0
}

// The pid `id` recorded in its `${ownerLabelKey}` label, or 0 when the label
// is missing or unparseable: such a container has no owner to protect.
fn containerOwnerPid(bin: string, id: string): int {
  let r = output(
    bin,
    ["inspect", "-f", "{{index .Config.Labels \"${ownerLabelKey}\"}}", id],
    dockerQuickTimeoutMs,
  )
  if (r.exitCode != 0) {
    return 0
  }
  let pid = parseInt(trimSpace(r.stdout)) catch _ {
    return 0
  }
  return pid
}

// Force-removes every container labelled `runLabel` ("key=value") whose
// owner process is gone, so an interrupted earlier run cannot leak one. A
// concurrent peer's still-running container carries a live owner pid and is
// left alone.
export fn sweepOrphans(bin: string, runLabel: string) {
  let r = output(bin, ["ps", "-aq", "--filter", "label=${runLabel}"], dockerQuickTimeoutMs)
  if (r.exitCode != 0) {
    return
  }
  for id of split(trimSpace(r.stdout), "\n") {
    if (id == "") {
      continue
    }
    let ownerPid = containerOwnerPid(bin, id)
    if (ownerPid > 0 && pidAlive(ownerPid)) {
      continue
    }
    output(bin, ["rm", "-f", id], dockerRunTimeoutMs)
  }
}

// ---- remote mode (#7428), see the header ----

export const remoteHostEnv: string = "BIT_LIVE_DOCKER_HOST"
const sshBin: string = "/usr/bin/ssh"
// How the harness proves it is alive to the holder, and how long a release
// waits for the holder's trap: 120 * 250 ms = 30 s.
const heldMarker: string = "BENCHLOCK_HELD"
const heldPollGapMs: int = 500
const releaseAttempts: int = 120
const releaseGapMs: int = 250
const sessionLabelKey: string = "bit.live.session"
const stagePrefix: string = "/tmp/bit-live-stage-"
const shimName: string = "docker-remote"
// Waiting for the lock costs nothing: 3600 * 500 ms = 30 min.
const lockAttempts: int = 3600
const tunnelTries: int = 5
const tunnelReadyAttempts: int = 40
const tunnelReadyGapMs: int = 250
const dialBudgetMs: int = 1000

// Every arg single-quoted, because ssh joins argv with spaces and the remote
// shell parses the result (`inspect -f {{index .Config.Labels "k"}}` needs it).
// The quoted line goes to ssh as ONE argument: left unquoted, the local shell
// word-splits it and turns every newline inside an arg into a space, which
// broke redislive's multi-line `sh -c` cert script on the remote host.
// The host is read from the `host` file beside the shim, never spliced into the script.
const shimSource: string = `#!/bin/sh
H=$(cat "$(dirname "$0")/host")
q=
for a in "$@"; do
  e=$(printf '%s' "$a" | sed "s/'/'\\\\''/g")
  q="$q '$e'"
done
exec /usr/bin/ssh -n -o BatchMode=yes -o ConnectTimeout=10 "$H" "docker$q"
`
// Exit 0 when pid $1 is an `ssh -N` tunnel; a recycled pid is never matched.
const tunnelAliveScript: string = `case "$(ps -p "$1" -o command= 2>/dev/null)" in *"ssh -N"*) exit 0;; esac; exit 1`
// Starts a detached tunnel, local port $1 to the host's 127.0.0.1:$2 through ssh host $3.
const tunnelSpawnScript: string = `/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ConnectTimeout=10 -L "$1:127.0.0.1:$2" "$3" </dev/null >/dev/null 2>&1 & echo $!`
// Copies directory $1 to $2 on ssh host $3.
const stageScript: string = `tar -C "$1" -cf - . | /usr/bin/ssh -o BatchMode=yes -o ConnectTimeout=10 "$3" "mkdir -p '$2' && tar -C '$2' -xf -"`
// Starts the lock holder, detached, and prints its pid. $1 ssh host, $2 the
// harness pid, $3 the state dir, $4 the session token. The ssh session's stdin
// is a pipe fed by a loop that ends when the harness pid is gone or $3/release
// exists, so the remote holder reads EOF within a second of either and its
// trap cleans up; one `hb` line every 30 s tells it the harness is alive. The
// ssh exit code lands in $3/closed.
const holderSpawnScript: string = `host=$1 pid=$2 dir=$3 tok=$4
b64=$(base64 < "$dir/lib.sh" | tr -d '\n')
who="$(hostname):$pid:$(date +%s)"
(
  ( n=0
    while kill -0 "$pid" 2>/dev/null && [ ! -e "$dir/release" ]; do
      n=$((n + 1))
      [ $((n % 30)) -ne 0 ] || echo hb
      sleep 1
    done ) |
    /usr/bin/ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 "$host" "sh -c \"\$(echo $b64 | base64 -d); bl_hold $tok $who\"" >"$dir/holder.out" 2>"$dir/holder.err"
  echo $? >"$dir/closed"
) </dev/null >/dev/null 2>&1 &
echo $!`

// The host chosen in code by `useRemoteHost`, for a harness that resolves its
// own (scripts/x64host.sh); the environment variable is the other way in.
let chosenHost: string = ""
const aliasChars: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-@"

// Runs this process's docker calls on ssh host `host` as if BIT_LIVE_DOCKER_HOST
// named it. Call it before `requireDocker`. The environment variable, when set,
// is the caller's explicit choice and wins. The alias goes into a generated
// shell script, so only an alias's own characters are accepted.
export fn useRemoteHost(host: string): ()! {
  if (host == "" || trim(host, aliasChars) != "") {
    fail newError("docker host alias \"${host}\" is empty or has a character that is not part of an ssh alias")
  }
  chosenHost = host
}

fn remoteHost(): string {
  let fromEnv = envOr(remoteHostEnv, "")
  if (fromEnv != "") {
    return fromEnv
  }
  return chosenHost
}

fn isRemote(bin: string): bool {
  return hasSuffix(bin, "/${shimName}")
}

// The shim's directory: it holds this run's `lock`, `tunnels` and `staged`.
fn stateDir(bin: string): string {
  return bin[0:len(bin) - len(shimName) - 1]
}

fn ssh(host: string, cmd: string, timeoutMs: int): RunResult {
  return output(
    sshBin,
    ["-n", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", host, cmd],
    timeoutMs,
  )
}

fn trimSlash(s: string): string {
  if (hasSuffix(s, "/")) {
    return s[0:len(s) - 1]
  }
  return s
}

// Writes the docker shim into a fresh directory under $TMPDIR and returns its path.
fn installShim(): string! {
  let pid = selfPid()?
  let dir = "${trimSlash(envOr("TMPDIR", "/tmp"))}/bit-live-remote-${pid}-${monotonic().ns}"
  mkdir(dir)?
  let shim = "${dir}/${shimName}"
  writeFile("${dir}/host", remoteHost())?
  writeFile(shim, shimSource)?
  let r = output("/bin/chmod", ["755", shim], dockerQuickTimeoutMs)
  if (r.exitCode != 0) {
    fail newError("chmod ${shim}: ${failureText(r, dockerQuickTimeoutMs)}")
  }
  return shim
}

fn readLines(path: string): []string {
  let out = []string(0)
  if (!exists(path)) {
    return out
  }
  let text = readFile(path) catch _ {
    return out
  }
  for line of split(text, "\n") {
    if (line != "") {
      out = append(out, line)
    }
  }
  return out
}

fn appendLine(path: string, line: string): ()! {
  let text = ""
  if (exists(path)) {
    text = readFile(path)?
  }
  writeFile(path, "${text}${line}\n")?
}

// This run's session token: the state dir's own name, unique per run and
// carrying the harness pid. It labels every container the run starts.
fn sessionToken(bin: string): string {
  let dir = stateDir(bin)
  return dir[lastIndexOf(dir, "/") + 1:]
}

// scripts/x64gate.sh's `lock-lib`: the remote shell functions both acquirers share.
fn lockLib(): string! {
  let script = "${envOr("BIT_REPO", ".")}/scripts/x64gate.sh"
  let r = output("/bin/sh", [script, "lock-lib"], dockerQuickTimeoutMs)
  if (r.exitCode != 0) {
    fail newError("${script} lock-lib: ${failureText(r, dockerQuickTimeoutMs)}")
  }
  return r.stdout
}

// Starts the holder session; its stdin and lifetime belong to this process (see holderSpawnScript).
fn spawnHolder(bin: string, host: string): ()! {
  let dir = stateDir(bin)
  writeFile("${dir}/lib.sh", lockLib()?)?
  let pid = selfPid()?
  let r = output(
    "/bin/sh",
    ["-c", holderSpawnScript, "sh", host, "${pid}", dir, sessionToken(bin)],
    dockerQuickTimeoutMs,
  )
  if (r.exitCode != 0 || trimSpace(r.stdout) == "") {
    fail newError(
      "remote lock: cannot start the holder session: ${failureText(r, dockerQuickTimeoutMs)}",
    )
  }
  writeFile("${dir}/holder", r.stdout)?
}

// Why the holder session ended before holding the lock.
fn holderFailure(dir: string): string {
  let text = trimSpace("${readText("${dir}/holder.err")}${readText("${dir}/holder.out")}")
  return "exit ${trimSpace(readText("${dir}/closed"))}: ${text}"
}

fn readText(path: string): string {
  if (!exists(path)) {
    return ""
  }
  return readFile(path) catch _ {
    ""
  }
}

// Takes the host's directory lock once per run, waiting for its other holders.
fn acquireLock(bin: string, host: string): ()! {
  let dir = stateDir(bin)
  if (exists("${dir}/holder")) {
    return
  }
  spawnHolder(bin, host)?
  let i = 0
  while (i < lockAttempts) {
    if (contains(readText("${dir}/holder.out"), heldMarker)) {
      return
    }
    if (exists("${dir}/closed")) {
      fail newError("remote lock: the holder session ended: ${holderFailure(dir)}")
    }
    i = i + 1
    sleep(heldPollGapMs * Millisecond)
  }
  fail newError("remote lock /tmp/benchlock still held after ${lockAttempts * heldPollGapMs / 1000}s")
}

// Copies the host side of one `-v src:dst[:opt]` to the host and returns the spec naming the copy.
fn stageMount(bin: string, host: string, spec: string): string! {
  let parts = split(spec, ":")
  let dir = stateDir(bin)
  let stage = "${stagePrefix}${len(readLines("${dir}/staged"))}-${dir[lastIndexOf(dir, "/") + 1:]}"
  appendLine("${dir}/staged", stage)?
  let r = output("/bin/sh", ["-c", stageScript, "sh", parts[0], stage, host], dockerRunTimeoutMs)
  if (r.exitCode != 0) {
    fail newError("staging ${parts[0]} on the docker host: ${failureText(r, dockerRunTimeoutMs)}")
  }
  parts[0] = stage
  return join(parts, ":")
}

// `args` for a remote `docker run`: lock taken, the session label added, bind mounts staged. Anything else, and every local call, unchanged.
fn remoteRunArgs(bin: string, args: []string): []string! {
  if (!isRemote(bin) || args[0] != "run") {
    return args
  }
  let host = remoteHost()
  acquireLock(bin, host)?
  let out = ["run", "--label", "${sessionLabelKey}=${sessionToken(bin)}"]
  let i = 1
  while (i < len(args)) {
    if (args[i] == "-v" && i + 1 < len(args)) {
      out = append(out, "-v")
      out = append(out, stageMount(bin, host, args[i + 1])?)
      i = i + 2
      continue
    }
    out = append(out, args[i])
    i = i + 1
  }
  return out
}

fn tunnelAlive(pid: string): bool {
  return output("/bin/sh", ["-c", tunnelAliveScript, "sh", pid], dockerQuickTimeoutMs).exitCode == 0
}

fn killTunnel(pid: string) {
  if (tunnelAlive(pid)) {
    output("/bin/kill", [pid], dockerQuickTimeoutMs)
  }
}

// Whether something already accepts on 127.0.0.1:`port`.
fn accepts(port: int): bool {
  let c = dialDeadline("127.0.0.1", port, monotonic().ns + dialBudgetMs * Millisecond) catch _ {
    return false
  }
  c.close()
  return true
}

// True once the tunnel process `pid` is alive and 127.0.0.1:`port` accepts.
fn tunnelReady(pid: string, port: int): bool {
  let i = 0
  while (i < tunnelReadyAttempts && tunnelAlive(pid)) {
    if (accepts(port)) {
      return true
    }
    sleep(tunnelReadyGapMs * Millisecond)
    i = i + 1
  }
  return false
}

// Candidate k for the local end: the host's own port first, then spread across 20000-59999.
fn localCandidate(remotePort: int, k: int): int {
  if (k == 0) {
    return remotePort
  }
  return 20000 + (remotePort * 31 + k * 977) % 40000
}

// One `ssh -N -L` tunnel to the host's 127.0.0.1:`remotePort`; the LOCAL port it answers on.
// The pid is recorded before the readiness check so `releaseDocker` kills a tunnel that never became ready.
fn openTunnel(bin: string, remotePort: int): int! {
  let k = 0
  while (k < tunnelTries) {
    let local = localCandidate(remotePort, k)
    k = k + 1
    if (accepts(local)) {
      continue
    }
    let r = output(
      "/bin/sh",
      ["-c", tunnelSpawnScript, "sh", "${local}", "${remotePort}", remoteHost()],
      dockerQuickTimeoutMs,
    )
    let pid = trimSpace(r.stdout)
    if (r.exitCode != 0 || pid == "") {
      fail newError("ssh tunnel: ${failureText(r, dockerQuickTimeoutMs)}")
    }
    appendLine("${stateDir(bin)}/tunnels", pid)?
    if (tunnelReady(pid, local)) {
      return local
    }
    killTunnel(pid)
  }
  fail newError("ssh tunnel to the docker host's port ${remotePort}: no local port became ready in ${tunnelTries} tries")
}

// Ends the holder session: `release` stops the stdin feeder, the holder reads EOF
// and its trap removes the run's labelled containers and the lock; `closed` appears when ssh exits.
fn endHolder(dir: string) {
  if (!exists("${dir}/holder")) {
    return
  }
  writeFile("${dir}/release", "1\n") catch _ {}
  let i = 0
  while (i < releaseAttempts && !exists("${dir}/closed")) {
    sleep(releaseGapMs * Millisecond)
    i = i + 1
  }
  if (!exists("${dir}/closed")) {
    eprint("dockerlive: the lock holder session did not end within ${releaseAttempts * releaseGapMs / 1000}s\n")
  }
}

// Ends a remote run: kills its tunnels, removes the staged copies and ends the holder session (lock and containers). A harness calls it
// from its cleanup AFTER its containers are removed, on every path. No-op for a local docker.
export fn releaseDocker(bin: string) {
  if (!isRemote(bin)) {
    return
  }
  let dir = stateDir(bin)
  let host = remoteHost()
  for pid of readLines("${dir}/tunnels") {
    killTunnel(pid)
  }
  for stage of readLines("${dir}/staged") {
    if (hasPrefix(stage, stagePrefix)) {
      let _ = ssh(host, "rm -rf '${stage}'", dockerRunTimeoutMs)
    }
  }
  endHolder(dir)
  for f of [
    "holder",
    "release",
    "closed",
    "holder.out",
    "holder.err",
    "lib.sh",
    "tunnels",
    "staged",
    "host",
    shimName,
  ] {
    remove("${dir}/${f}") catch _ {}
  }
  remove(dir) catch _ {}
}
