// `bit lsp` resolution gate (#2327, #2329, #2330): drives the REAL
// self-hosted `bit lsp` binary as a subprocess and asserts on its raw
// JSON-RPC output for hover and textDocument/definition on a member-access
// expression (`recv.field`, `recv.method(...)`) and on an imported/stdlib
// name. All three previously resolved the name through the flat,
// project-wide `nodeSymbols` scope instead of against the receiver's type
// (member access) or the imported module's own symbol table (#2330), so
// hover reported an unrelated same-named variable's type and definition
// always returned null.
//
// #2858 folded in textDocument/completion, textDocument/documentSymbol and
// textDocument/didClose — the three methods that used to be asserted only by
// scripts/lsp-transcript.sh, a shell/Python harness no gate ever ran.
//
// SUBPROCESS MECHANICS as _tests_/bit/lsplifecycle.bit: a generated `/bin/sh`
// wrapper redirects a pre-built batch JSON-RPC transcript to stdin and both
// output streams to files, via `osRunBounded` (ABI.md §19).
//
// WIRED INTO `./make test` as `test-lsp-resolve` (tools/build/gates.bit,
// tools/build/defs.bit).

import { env, envOr } from "std/os"
import { readFile, writeFile, exists } from "std/fs"
import {
  assertRenameEditPositions, assertRenameRepliesPresent, assertShorthandExpanded,
  contains, countOccurrences, failCase, frame, jsonEscape, mkdirQuiet, renameResultTail,
  runLsp, runRenameFieldSession, runRenameShorthandSession,
} from "./lspresolvehelpers"

fn checkHoverField(bin: string, scratchRoot: string) {
  let dir = scratchRoot + "/hover"
  mkdirQuiet(dir)
  let modelPath = dir + "/model.bit"
  let otherPath = dir + "/other.bit"
  let model = "class Task {\n  done: bool,\n}\n\n" +
    "fn show(t: Task) {\n  let flag = t.done\n}\n"
  // The unrelated file that shares the field's name with a DIFFERENT type —
  // exactly the shape that read a same-named variable instead of the field.
  let other = "fn helper() {\n  let done = 0\n}\n"
  writeFile(modelPath, model) catch e {
    failCase("cannot write ${modelPath}: " + e.message())
    return
  }
  writeFile(otherPath, other) catch e {
    failCase("cannot write ${otherPath}: " + e.message())
    return
  }
  let mUri = "file://" + modelPath
  let oUri = "file://" + otherPath
  let initReq = frame("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"," +
    "\"params\":{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}}")
  let initNotif = frame("{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}")
  let openModel = frame("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{" +
    "\"textDocument\":{\"uri\":\"${mUri}\",\"languageId\":\"bit\",\"version\":1," +
    "\"text\":\"" + jsonEscape(model) + "\"}}}")
  let openOther = frame("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{" +
    "\"textDocument\":{\"uri\":\"${oUri}\",\"languageId\":\"bit\",\"version\":1," +
    "\"text\":\"" + jsonEscape(other) + "\"}}}")
  // line 5 (0-based) "  let flag = t.done": 'done' starts at character 15.
  let hoverReq = frame("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/hover\"," +
    "\"params\":{\"textDocument\":{\"uri\":\"${mUri}\"},\"position\":{\"line\":5,\"character\":15}}}")
  let payload = initReq + initNotif + openModel + openOther + hoverReq
  let (code, out, ok) = runLsp(bin, dir, payload)
  if (!ok) { return }
  if (!contains(out, "\"id\":2")) {
    failCase("hover field: no reply for id 2\n" + out)
    return
  }
  if (!contains(out, "done: bool")) {
    failCase("hover field: expected 'done: bool' in the reply, got:\n" + out)
    return
  }
  if (contains(out, "done: i64")) {
    failCase("hover field: reply carries the UNRELATED variable's type (done: i64)\n" + out)
    return
  }
  print("PASS lspresolve: hover on a class field resolves against the receiver's type\n")
}

// #2329: definition on a method call and a field access, cross-file.
fn checkDefinitionMember(bin: string, scratchRoot: string) {
  let dir = scratchRoot + "/def"
  mkdirQuiet(dir)
  let taskPath = dir + "/task.bit"
  let boardPath = dir + "/board.bit"
  let task = "class Task {\n  done: bool,\n\n  complete() {\n    this.done = true\n  }\n}\n"
  let board = "fn main() {\n  let t = Task{ done: false }\n  t.complete()\n}\n"
  writeFile(taskPath, task) catch e {
    failCase("cannot write ${taskPath}: " + e.message())
    return
  }
  writeFile(boardPath, board) catch e {
    failCase("cannot write ${boardPath}: " + e.message())
    return
  }
  let tUri = "file://" + taskPath
  let bUri = "file://" + boardPath
  let initReq = frame("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"," +
    "\"params\":{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}}")
  let initNotif = frame("{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}")
  let openTask = frame("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{" +
    "\"textDocument\":{\"uri\":\"${tUri}\",\"languageId\":\"bit\",\"version\":1," +
    "\"text\":\"" + jsonEscape(task) + "\"}}}")
  let openBoard = frame("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{" +
    "\"textDocument\":{\"uri\":\"${bUri}\",\"languageId\":\"bit\",\"version\":1," +
    "\"text\":\"" + jsonEscape(board) + "\"}}}")
  // board.bit line 2 (0-based) "  t.complete()": 'complete' starts at character 4.
  let defReq = frame("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/definition\"," +
    "\"params\":{\"textDocument\":{\"uri\":\"${bUri}\"},\"position\":{\"line\":2,\"character\":4}}}")
  let payload = initReq + initNotif + openTask + openBoard + defReq
  let (code, out, ok) = runLsp(bin, dir, payload)
  if (!ok) { return }
  if (!contains(out, "\"id\":2")) {
    failCase("definition on method call: no reply for id 2\n" + out)
    return
  }
  if (contains(out, "\"id\":2,\"result\":null")) {
    failCase("definition on method call: returned null instead of task.bit's declaration\n" + out)
    return
  }
  if (!contains(out, "task.bit")) {
    failCase("definition on method call: reply does not point at task.bit\n" + out)
    return
  }
  print("PASS lspresolve: definition on a cross-file method call resolves\n")
}

// #2330: definition on an imported stdlib name jumps to its real declaration
// in the stdlib source, at both the import site and the call site — not the
// import statement's own binding name. Needs BIT_STDLIB (see `runLsp`); a
// caller running this file directly without it gets a clear failure rather
// than a silent skip.
fn checkDefinitionImport(bin: string, scratchRoot: string) {
  if (env("BIT_STDLIB") == "") {
    failCase("BIT_STDLIB is unset — this scenario needs the real std/strings source")
    return
  }
  let dir = scratchRoot + "/import"
  mkdirQuiet(dir)
  let reportPath = dir + "/report.bit"
  let report = "import { toUpper } from \"std/strings\"\n\n" +
    "fn shout(s: string): string {\n  return toUpper(s)\n}\n"
  writeFile(reportPath, report) catch e {
    failCase("cannot write ${reportPath}: " + e.message())
    return
  }
  let rUri = "file://" + reportPath
  let initReq = frame("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"," +
    "\"params\":{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}}")
  let initNotif = frame("{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}")
  let openReport = frame("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{" +
    "\"textDocument\":{\"uri\":\"${rUri}\",\"languageId\":\"bit\",\"version\":1," +
    "\"text\":\"" + jsonEscape(report) + "\"}}}")
  // line 0 "import { toUpper } from \"std/strings\"": 'toUpper' starts at character 9.
  let importDefReq = frame("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/definition\"," +
    "\"params\":{\"textDocument\":{\"uri\":\"${rUri}\"},\"position\":{\"line\":0,\"character\":9}}}")
  // line 3 "  return toUpper(s)": 'toUpper' starts at character 9.
  let callDefReq = frame("{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/definition\"," +
    "\"params\":{\"textDocument\":{\"uri\":\"${rUri}\"},\"position\":{\"line\":3,\"character\":9}}}")
  let payload = initReq + initNotif + openReport + importDefReq + callDefReq
  let (code, out, ok) = runLsp(bin, dir, payload)
  if (!ok) { return }
  if (!contains(out, "\"id\":2") || !contains(out, "\"id\":3")) {
    failCase("definition on import: missing a reply for id 2 or id 3\n" + out)
    return
  }
  if (contains(out, "\"id\":2,\"result\":null")) {
    failCase("definition on import: import-site toUpper returned null\n" + out)
    return
  }
  if (contains(out, "\"id\":3,\"result\":null")) {
    failCase("definition on import: call-site toUpper returned null\n" + out)
    return
  }
  if (!contains(out, "strings.bit")) {
    failCase("definition on import: reply does not point at std/strings' source\n" + out)
    return
  }
  print("PASS lspresolve: definition on an imported stdlib name resolves to its real declaration\n")
}

// #2410: `server.overlays` is keyed on `pathResolve(lspUriToPath(uri))`, not
// the raw decoded path, matching the loader's own lookup key
// (`compiler/project.bit`'s `canon + "/" + name` where `canon = pathResolve(dir)`).
// A client is free to spell a document URI with a doubled path separator and
// still mean the same file. The disk fixture below is CLEAN; only the
// didOpen buffer carries an undefined-name error the disk text lacks, so a
// server that mis-keys the overlay and silently falls back to disk would
// publish zero diagnostics here, while one that finds the overlay under its
// canonical key would publish the buffer's error. Neither of this file's
// other scenarios can catch that: their buffer and disk text always agree,
// so a silently-ignored overlay reads the same either way.
fn checkOverlayUriDoubledSeparator(bin: string, scratchRoot: string) {
  let dir = scratchRoot + "/overlayuri"
  mkdirQuiet(dir)
  let filePath = dir + "/main.bit"
  let clean = "fn main() {\n  let x = 1\n}\n"
  writeFile(filePath, clean) catch e {
    failCase("cannot write ${filePath}: " + e.message())
    return
  }
  // Doubled separator right before the filename — written explicitly rather
  // than relying on $TMPDIR's trailing slash (macOS-only), so the scenario
  // means the same thing on every platform this gate runs on.
  let uri = "file://" + dir + "//main.bit"
  let buggy = "fn main() {\n  let x = undefinedThing\n}\n"
  let initReq = frame("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"," +
    "\"params\":{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}}")
  let initNotif = frame("{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}")
  let openDoc = frame("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{" +
    "\"textDocument\":{\"uri\":\"${uri}\",\"languageId\":\"bit\",\"version\":1," +
    "\"text\":\"" + jsonEscape(buggy) + "\"}}}")
  let payload = initReq + initNotif + openDoc
  let (code, out, ok) = runLsp(bin, dir, payload)
  if (!ok) { return }
  if (!contains(out, "publishDiagnostics")) {
    failCase("overlay URI canonicalization: no diagnostics published at all\n" + out)
    return
  }
  if (!contains(out, "undefined name 'undefinedThing'")) {
    failCase("overlay URI canonicalization: buffer's error is missing — the server " +
      "read the clean file from disk instead of the doubled-separator overlay\n" + out)
    return
  }
  print("PASS lspresolve: overlay lookup canonicalizes a doubled-separator document URI\n")
}

// #2858: documentSymbol lists a file's top-level declarations — a free
// function and a class — nested per compiler/lspsymbols.bit's `DocumentSymbol`
// tree. Formerly asserted only by scripts/lsp-transcript.sh's scenario 6.
fn checkDocumentSymbol(bin: string, scratchRoot: string) {
  let dir = scratchRoot + "/docsym"
  mkdirQuiet(dir)
  let filePath = dir + "/main.bit"
  let text = "fn greet(): string {\n  return \"hi\"\n}\nclass Bot { name: string }\n"
  writeFile(filePath, text) catch e {
    failCase("cannot write ${filePath}: " + e.message())
    return
  }
  let uri = "file://" + filePath
  let initReq = frame("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"," +
    "\"params\":{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}}")
  let initNotif = frame("{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}")
  let openDoc = frame("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{" +
    "\"textDocument\":{\"uri\":\"${uri}\",\"languageId\":\"bit\",\"version\":1," +
    "\"text\":\"" + jsonEscape(text) + "\"}}}")
  let docSymReq = frame("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/documentSymbol\"," +
    "\"params\":{\"textDocument\":{\"uri\":\"${uri}\"}}}")
  let payload = initReq + initNotif + openDoc + docSymReq
  let (code, out, ok) = runLsp(bin, dir, payload)
  if (!ok) { return }
  if (!contains(out, "\"id\":2")) {
    failCase("documentSymbol: no reply for id 2\n" + out)
    return
  }
  if (!contains(out, "\"name\":\"greet\"")) {
    failCase("documentSymbol: reply does not list 'greet'\n" + out)
    return
  }
  if (!contains(out, "\"name\":\"Bot\"")) {
    failCase("documentSymbol: reply does not list 'Bot'\n" + out)
    return
  }
  print("PASS lspresolve: documentSymbol lists a file's top-level declarations\n")
}

// #2858: completion after a bare `.` on an interface-typed receiver lists the
// interface's methods (compiler/lspquery.bit's `lspDotCompletion`). Formerly
// asserted only by scripts/lsp-transcript.sh's scenario 5.
fn checkCompletion(bin: string, scratchRoot: string) {
  let dir = scratchRoot + "/completion"
  mkdirQuiet(dir)
  let filePath = dir + "/main.bit"
  let text = "interface Greeter {\n" +
    "  greet(): string\n" +
    "  wave(): string\n" +
    "}\n" +
    "class Bot { name: string, greet(): string { return this.name } wave(): string { return this.name } }\n" +
    "let g: Greeter = Bot{name: \"Ada\"}\n" +
    "let y = g.\n"
  writeFile(filePath, text) catch e {
    failCase("cannot write ${filePath}: " + e.message())
    return
  }
  let uri = "file://" + filePath
  let initReq = frame("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"," +
    "\"params\":{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}}")
  let initNotif = frame("{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}")
  let openDoc = frame("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{" +
    "\"textDocument\":{\"uri\":\"${uri}\",\"languageId\":\"bit\",\"version\":1," +
    "\"text\":\"" + jsonEscape(text) + "\"}}}")
  // line 6 (0-based) "let y = g.": character 10 is right after the '.'.
  let completionReq = frame("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/completion\"," +
    "\"params\":{\"textDocument\":{\"uri\":\"${uri}\"},\"position\":{\"line\":6,\"character\":10}}}")
  let payload = initReq + initNotif + openDoc + completionReq
  let (code, out, ok) = runLsp(bin, dir, payload)
  if (!ok) { return }
  if (!contains(out, "\"id\":2")) {
    failCase("completion: no reply for id 2\n" + out)
    return
  }
  if (!contains(out, "\"label\":\"greet\"")) {
    failCase("completion: reply does not list 'greet'\n" + out)
    return
  }
  if (!contains(out, "\"label\":\"wave\"")) {
    failCase("completion: reply does not list 'wave'\n" + out)
    return
  }
  print("PASS lspresolve: completion after '.' lists the interface's methods\n")
}

// #3999: `.` on a bare enum TYPE name lists its variants instead of an empty
// list (lspquery.bit's `lspDotCompletion`); `d.` is the control. Two dirs, so
// each is its own module and both may declare `enum SslMode`; each dangling
// `.` sits at its file's LAST byte, or the parser would hunt the next line.
fn checkEnumCompletion(bin: string, scratchRoot: string) {
  let dir = scratchRoot + "/enumcompletion"
  let enumDir = dir + "/enum"
  let valueDir = dir + "/value"
  mkdirQuiet(dir)
  mkdirQuiet(enumDir)
  mkdirQuiet(valueDir)
  let enumPath = enumDir + "/main.bit"
  let enumText = "enum SslMode { Negotiate, VerifyFull, VerifyCa, Require, Disable }\n" +
    "let m = SslMode.\n"
  let valuePath = valueDir + "/main.bit"
  let valueText = "class Datasource { uri: string, port: i64, sslmode: SslMode }\n" +
    "enum SslMode { Negotiate, VerifyFull, VerifyCa, Require, Disable }\n" +
    "let d = Datasource{}\n" +
    "let n = d.\n"
  writeFile(enumPath, enumText) catch e {
    failCase("cannot write ${enumPath}: " + e.message())
    return
  }
  writeFile(valuePath, valueText) catch e {
    failCase("cannot write ${valuePath}: " + e.message())
    return
  }
  let enumUri = "file://" + enumPath
  let valueUri = "file://" + valuePath
  let initReq = frame("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"," +
    "\"params\":{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}}")
  let initNotif = frame("{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}")
  let openEnum = frame("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{" +
    "\"textDocument\":{\"uri\":\"${enumUri}\",\"languageId\":\"bit\",\"version\":1," +
    "\"text\":\"" + jsonEscape(enumText) + "\"}}}")
  let openValue = frame("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{" +
    "\"textDocument\":{\"uri\":\"${valueUri}\",\"languageId\":\"bit\",\"version\":1," +
    "\"text\":\"" + jsonEscape(valueText) + "\"}}}")
  // enum/main.bit line 1 (0-based) "let m = SslMode.": character 16 is right after the '.'.
  let enumReq = frame("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/completion\"," +
    "\"params\":{\"textDocument\":{\"uri\":\"${enumUri}\"},\"position\":{\"line\":1,\"character\":16}}}")
  // value/main.bit line 3 (0-based) "let n = d.": character 10 is right after the '.' — the control.
  let valueReq = frame("{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/completion\"," +
    "\"params\":{\"textDocument\":{\"uri\":\"${valueUri}\"},\"position\":{\"line\":3,\"character\":10}}}")
  let payload = initReq + initNotif + openEnum + openValue + enumReq + valueReq
  let (code, out, ok) = runLsp(bin, dir, payload)
  if (!ok) { return }
  if (!contains(out, "\"id\":2")) {
    failCase("enum completion: no reply for id 2\n" + out)
    return
  }
  for v of ["Negotiate", "VerifyFull", "VerifyCa", "Require", "Disable"] {
    if (!contains(out, "\"label\":\"${v}\",\"kind\":20")) {
      failCase("enum completion: reply does not list variant '${v}' with kind 20\n" + out)
      return
    }
  }
  if (!contains(out, "\"id\":3") || !contains(out, "\"label\":\"uri\"") ||
    !contains(out, "\"label\":\"port\"") || !contains(out, "\"label\":\"sslmode\"")) {
    failCase("enum completion: control ('d.') regressed — no id 3 or missing a field\n" + out)
    return
  }
  print("PASS lspresolve: completion after '.' on a bare enum type name lists its variants\n")
}

// #2858: didClose removes the document's overlay, so a request that touches
// the file afterwards reads DISK content again, not the last edited buffer.
// Disk holds `done: bool`; the open buffer overrides it to `done: i64`, so the
// two hover replies below can only both be right if the overlay stopped
// applying between them. Formerly asserted only weakly (a diagnostics count,
// never the overlay's actual removal) by scripts/lsp-transcript.sh's scenario 7.
fn checkDidClose(bin: string, scratchRoot: string) {
  let dir = scratchRoot + "/close"
  mkdirQuiet(dir)
  let modelPath = dir + "/model.bit"
  let disk = "class Task {\n  done: bool,\n}\n\n" +
    "fn show(t: Task) {\n  let flag = t.done\n}\n"
  let overlay = "class Task {\n  done: i64,\n}\n\n" +
    "fn show(t: Task) {\n  let flag = t.done\n}\n"
  writeFile(modelPath, disk) catch e {
    failCase("cannot write ${modelPath}: " + e.message())
    return
  }
  let uri = "file://" + modelPath
  let initReq = frame("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"," +
    "\"params\":{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}}")
  let initNotif = frame("{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}")
  let openDoc = frame("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{" +
    "\"textDocument\":{\"uri\":\"${uri}\",\"languageId\":\"bit\",\"version\":1," +
    "\"text\":\"" + jsonEscape(overlay) + "\"}}}")
  // line 5 (0-based) "  let flag = t.done": 'done' starts at character 15.
  let hoverOpen = frame("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/hover\"," +
    "\"params\":{\"textDocument\":{\"uri\":\"${uri}\"},\"position\":{\"line\":5,\"character\":15}}}")
  let closeDoc = frame("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\"," +
    "\"params\":{\"textDocument\":{\"uri\":\"${uri}\"}}}")
  let hoverAfterClose = frame("{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/hover\"," +
    "\"params\":{\"textDocument\":{\"uri\":\"${uri}\"},\"position\":{\"line\":5,\"character\":15}}}")
  let payload = initReq + initNotif + openDoc + hoverOpen + closeDoc + hoverAfterClose
  let (code, out, ok) = runLsp(bin, dir, payload)
  if (!ok) { return }
  if (!contains(out, "\"id\":2")) {
    failCase("didClose: no reply for id 2 (hover while open)\n" + out)
    return
  }
  if (!contains(out, "\"id\":3")) {
    failCase("didClose: no reply for id 3 (hover after close)\n" + out)
    return
  }
  if (!contains(out, "done: i64")) {
    failCase("didClose: hover before close did not see the open buffer's " +
      "'done: i64'\n" + out)
    return
  }
  if (!contains(out, "done: bool")) {
    failCase("didClose: hover after close did not fall back to disk's " +
      "'done: bool' — the overlay was not removed\n" + out)
    return
  }
  print("PASS lspresolve: didClose removes the overlay so hover reads disk again\n")
}


// #2334: textDocument/rename on a class field renames its declaration, every
// `recv.field` use (including one folded inside a string interpolation, and
// cross-file), and its own KEY in a composite literal — but never the VALUE
// half of `title: title`, which happens to share the field's spelling only
// because it is initialized from a same-named parameter. That parameter's own
// declaration and its use are the negative half: a handler that renamed every
// occurrence of the spelling "title" project-wide would pass every check that
// only looks for the 4 wanted edits, so this asserts their absence too.
fn checkRenameField(bin: string, scratchRoot: string) {
  let (out, ok) = runRenameFieldSession(bin, scratchRoot)
  if (!ok) { return }
  if (!assertRenameRepliesPresent(out)) { return }
  let edit3 = renameResultTail(out)
  let wanted = countOccurrences(edit3, "\"newText\":\"heading\"")
  if (wanted != 4) {
    failCase("rename field: expected exactly 4 edits, got ${wanted}\n" + out)
    return
  }
  if (!assertRenameEditPositions(edit3, out)) { return }
  print("PASS lspresolve: rename on a class field edits its declaration, its member " +
    "accesses and its composite-literal key, and leaves a same-spelling parameter alone\n")
}


// Renaming the FIELD: cursor on `db`'s own declaration (line 1, "  db: int,").
// `P{ db }` must become `P{ handle: db }`, not the corrupting `P{ handle }`.
fn checkRenameShorthandField(bin: string, scratchRoot: string) {
  let (out, ok) = runRenameShorthandSession(bin, scratchRoot + "/shfield", 1, 2, "handle")
  if (!ok) { return }
  if (!assertShorthandExpanded(out, "rename shorthand field", "handle: db", "handle", 1)) { return }
  print("PASS lspresolve: renaming a field expands its shorthand use site instead of corrupting it\n")
}

// Renaming the LOCAL: cursor on `db`'s own declaration (line 5, "  let db = 1").
// `P{ db }` must become `P{ db: connection }`, not the corrupting `P{ connection }`.
fn checkRenameShorthandLocal(bin: string, scratchRoot: string) {
  let (out, ok) = runRenameShorthandSession(bin, scratchRoot + "/shlocal", 5, 6, "connection")
  if (!ok) { return }
  if (!assertShorthandExpanded(out, "rename shorthand local", "db: connection", "connection", 1)) { return }
  print("PASS lspresolve: renaming a shorthand's local variable keeps the field key text unchanged\n")
}

fn main() {
  let bin = envOr("BIT", "bit-out/bin/bit")
  if (!exists(bin)) {
    failCase("BIT='${bin}' does not exist — refusing to guess")
    return
  }
  let scratchRoot = envOr("TMPDIR", "/tmp") + "/bit-lspresolve-${timeUnixNs()}"
  mkdirQuiet(scratchRoot)
  checkHoverField(bin, scratchRoot)
  checkDefinitionMember(bin, scratchRoot)
  checkDefinitionImport(bin, scratchRoot)
  checkOverlayUriDoubledSeparator(bin, scratchRoot)
  checkDocumentSymbol(bin, scratchRoot)
  checkCompletion(bin, scratchRoot)
  checkEnumCompletion(bin, scratchRoot)
  checkDidClose(bin, scratchRoot)
  checkRenameField(bin, scratchRoot)
  checkRenameShorthandField(bin, scratchRoot)
  checkRenameShorthandLocal(bin, scratchRoot)
  print("lspresolve: all scenarios passed\n")
}
