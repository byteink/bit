// _tests_/bit/waitforsignal/waitforsignal.bit — proof that a Bit process
// can catch a REAL, externally-delivered SIGTERM and SIGINT and run its own
// code before exiting (#6087), not just that `std/signal` links.
//
// WHAT IS UNDER TEST: `std/signal`'s `waitForSignal`, and the runtime side
// that delivers into it from an actual POSIX signal — the self-pipe
// (`runtime/root/{linux,darwin}/signal.bit`) or the poll-based flag
// (`runtime/root/windows/signal.bit`), not a synthetic in-process call.
//
// A Bit program cannot send ITSELF a signal (there is no `std/process`
// primitive for it — deliberately: #6087's own hypothesis names sending a
// signal as a gap this test exercises, not works around), so this test
// spawns ITSELF as a child through `/bin/sh`, sends the real signal from
// the shell, and reads back what the child printed before it exited.
//
// TWO MODES, ONE BINARY. Run with no extra argument, this is the
// ORCHESTRATOR: it shells out to its own `selfExe()` twice, once for
// SIGTERM and once for SIGINT, each time backgrounding the child, sending
// the signal after a short delay, and capturing what the child printed.
// Run with "child" as `args()[1]`, it IS the child: block in
// `waitForSignal` and print which signal arrived, then exit normally - the
// exact shape `docs/stdlib/signal.md`'s own example uses.
import { args, selfExe, exit } from "std/os"
import { waitForSignal, Signal } from "std/signal"
import { output } from "std/process"
import { contains } from "std/strings"

fn runChild() {
  let sig = waitForSignal([Signal.Term, Signal.Int])
  if (sig == Signal.Term) {
    print("CAUGHT TERM\n")
  } else {
    print("CAUGHT INT\n")
  }
}

// Checks that ran, for the summary line — a gate that reports "PASS" with
// no count cannot be told apart from one whose cases all fell through
// (the same argument `_tests_/bit/auxv.bit`'s own `ran` makes).
let ran: int = 0

fn die(msg: string) {
  eprint("FAIL waitforsignal: " + msg + "\n")
  exit(1)
}

// Background `selfExe() child`, give it time to boot and reach
// `waitForSignal`, send POSIX signal `sig` (a name: "TERM" or "INT"), wait
// for the child to exit, and return everything it printed.
//
// THE 300ms DELAY IS A REAL RACE, NAMED RATHER THAN HIDDEN: if the signal
// arrived before the child's first `waitForSignal` call has finished
// arming the self-pipe/handler, `termHandler`'s original #3507/#4172
// fallback would still be live and the child would exit 143/130 instead of
// printing anything - `die` below catches that as a nonzero `exitCode`,
// it does not read as a silent pass. 300ms is two orders of magnitude past
// this runtime's own boot time on every platform this test has run on.
fn sendAndCapture(sig: string): string {
  let exe = selfExe()
  let script = "\"${exe}\" child & CPID=$!; sleep 0.3; kill -${sig} \"$CPID\"; wait \"$CPID\""
  let r = output("/bin/sh", ["-c", script], 10000)
  if (r.exitCode != 0) {
    die("SIG${sig}: child exited ${r.exitCode} (expected 0 - a caught signal returns normally), stdout: ${r.stdout} stderr: ${r.stderr}")
  }
  return r.stdout
}

fn checkSignal(sig: string, wantLine: string) {
  let out = sendAndCapture(sig)
  if (!contains(out, wantLine)) {
    die("SIG${sig}: expected output to contain \"${wantLine}\", got \"${out}\"")
  }
  ran = ran + 1
}

fn main() {
  let a = args()
  if (len(a) > 1 && a[1] == "child") {
    runChild()
    return
  }

  checkSignal("TERM", "CAUGHT TERM")
  checkSignal("INT", "CAUGHT INT")

  println("PASS waitforsignal: ${ran} check(s) - SIGTERM and SIGINT both delivered to a running child process and caught before exit")
}
