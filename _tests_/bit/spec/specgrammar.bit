// _tests_/bit/spec/specgrammar.bit — the EBNF line/token plumbing extracted from
// `spec.bit` (#2973's split of `_tests_/bit/spec.bit`, which sat at exactly
// 800 lines with `test-filesize`'s grandfather list empty).
//
// Sibling of `spec.bit` in the same directory module: no `import`, one shared
// scope (`std/strings`'s `indexOf`/`join`/`split`/`trimSpace` are imported once,
// in `spec.bit`, and used from here — re-importing here would be `E0042`).
// This file is the line- and token-level parsing `spec.bit`'s scan and its
// CHECK 1/CHECK 2 build on: reading one EBNF line into a `Production`,
// splitting one RHS into its top-level alternatives, and reducing an RHS to
// its sorted leading-discriminator set. `selfTest*` below proves this
// plumbing against synthetic input before `spec.bit`'s `main` trusts it
// against the real corpus — the split moved the tests with the code they
// test, verbatim.

class LineMatch { ok: bool, name: string, rest: string }
class BlockStat { isGrammar: bool, matched: int, nonBlank: int }

fn isIdentStart(c: u8): bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

fn isIdentCont(c: u8): bool {
  return isIdentStart(c) || (c >= '0' && c <= '9')
}

fn containsStr(xs: []string, s: string): bool {
  for x of xs {
    if (x == s) {
      return true
    }
  }
  return false
}

// Bounded insertion sort (n is at most maxAltsPerProduction) — mutates `xs`
// in place through the shared backing slice, like every other in-place sort
// in this codebase.
fn sortStrings(xs: []string) {
  let n = len(xs)
  let i = 1
  while (i < n) {
    let key = xs[i]
    let j = i - 1
    while (j >= 0 && xs[j] > key) {
      xs[j + 1] = xs[j]
      j = j - 1
    }
    xs[j + 1] = key
    i = i + 1
  }
}

// Removes every `(* ... *)` span. Bounded: this grammar never leaves one
// unterminated, but an unterminated one still terminates the scan rather than
// looping — everything from the open marker onward is dropped.
fn stripComment(s: string): string {
  let out = s
  let guard = 0
  while (guard < maxCommentSpans) {
    let startRel = indexOf(out, "(*")
    if (startRel < 0) {
      return out
    }
    let st = int(startRel)
    let endRel = indexOf(out[st:len(out)], "*)")
    if (endRel < 0) {
      return out[0:st]
    }
    let en = st + int(endRel)
    out = out[0:st] + out[en + 2:len(out)]
    guard = guard + 1
  }
  return out
}

// A production's LHS, at column 0: `name<spaces>= <rest>`. Indentation, or no
// `=` after the identifier, disqualifies it (that is what tells a defining
// line apart from prose inside the same fenced block).
fn matchProdLine(line: string): LineMatch {
  let n = len(line)
  if (n == 0 || !isIdentStart(line[0])) {
    return LineMatch{ ok: false, name: "", rest: "" }
  }
  let i = 0
  while (i < n && isIdentCont(line[i])) {
    i = i + 1
  }
  let name = line[0:i]
  let j = i
  while (j < n && line[j] == ' ') {
    j = j + 1
  }
  if (j >= n || line[j] != '=') {
    return LineMatch{ ok: false, name: "", rest: "" }
  }
  return LineMatch{ ok: true, name: name, rest: line[j + 1:n] }
}

// A continuation alternative: optional leading whitespace, then `|`.
fn matchContLine(line: string): LineMatch {
  let n = len(line)
  let i = 0
  while (i < n && (line[i] == ' ' || line[i] == '\t')) {
    i = i + 1
  }
  if (i >= n || line[i] != '|') {
    return LineMatch{ ok: false, name: "", rest: "" }
  }
  return LineMatch{ ok: true, name: "", rest: line[i + 1:n] }
}

// A bare-fenced block is a grammar block when at least half its non-blank
// lines are a production line or a continuation line — the same shape every
// EBNF block in this spec has, and different enough from a Bit-code example
// (whose lines are statements, braces and calls) that the two never blur in
// practice; verified against the live corpus below.
fn classifyBlock(lines: []string): BlockStat {
  let nonBlank = 0
  let matched = 0
  for l of lines {
    if (len(trimSpace(l)) == 0) {
      continue
    }
    nonBlank = nonBlank + 1
    let pm = matchProdLine(l)
    if (pm.ok) {
      matched = matched + 1
      continue
    }
    let cm = matchContLine(l)
    if (cm.ok) {
      matched = matched + 1
    }
  }
  return BlockStat{ isGrammar: nonBlank > 0 && matched * 2 >= nonBlank,
    matched: matched, nonBlank: nonBlank }
}

// Every production in one already-classified grammar block, appended to
// `out`. `startFileLine` is the 1-based file line of `lines[0]`.
fn extractProductions(out: []Production, lines: []string, startFileLine: int,
    appendix: bool): []Production {
  let curName = ""
  let curRhs = ""
  let curLine = 0
  let has = false
  let i = 0
  let n = len(lines)
  while (i < n) {
    let pm = matchProdLine(lines[i])
    if (pm.ok) {
      if (has) {
        if (len(out) >= maxTotalProductions) {
          die("more than ${maxTotalProductions} productions found; the corpus outgrew this harness's bound")
        }
        out = append(out, Production{ name: curName, rhs: curRhs, fileLine: curLine, appendix: appendix })
      }
      curName = pm.name
      curRhs = stripComment(pm.rest)
      curLine = startFileLine + i
      has = true
    } else {
      let cm = matchContLine(lines[i])
      if (cm.ok && has) {
        curRhs = curRhs + " | " + stripComment(cm.rest)
      }
    }
    i = i + 1
  }
  if (has) {
    if (len(out) >= maxTotalProductions) {
      die("more than ${maxTotalProductions} productions found; the corpus outgrew this harness's bound")
    }
    out = append(out, Production{ name: curName, rhs: curRhs, fileLine: curLine, appendix: appendix })
  }
  return out
}

// Every bare identifier token in `rhs` that is not inside a quoted terminal.
fn identTokens(rhs: string): []string {
  let out = []string(0)
  let n = len(rhs)
  let i = 0
  let inQuote = false
  while (i < n && len(out) < maxTokensPerRhs) {
    let c = rhs[i]
    if (inQuote) {
      if (c == '"') {
        inQuote = false
      }
      i = i + 1
      continue
    }
    if (c == '"') {
      inQuote = true
      i = i + 1
      continue
    }
    if (isIdentStart(c)) {
      let j = i
      while (j < n && isIdentCont(rhs[j])) {
        j = j + 1
      }
      out = append(out, rhs[i:j])
      i = j
      continue
    }
    i = i + 1
  }
  return out
}

// +1 for `([{`, -1 for `)]}`, 0 otherwise — factored out of splitTopAlts and
// findClosingBracket so neither carries three-way `||` branching on top of
// its own quote/loop logic.
fn bracketDelta(c: u8): int {
  if (c == '(' || c == '[' || c == '{') {
    return 1
  }
  if (c == ')' || c == ']' || c == '}') {
    return -1
  }
  return 0
}

// Quote-toggle state, boxed in a class (a reference type, §14.2) so
// `consumeQuote` can mutate it through a call rather than the caller
// threading the updated bool back out itself.
class Cursor { inQuote: bool }

// If `c` is quote punctuation, updates `cur.inQuote` and returns true (the
// caller should treat `c` as consumed and move on); otherwise leaves `cur`
// alone and returns false.
fn consumeQuote(cur: Cursor, c: u8): bool {
  if (cur.inQuote) {
    if (c == '"') {
      cur.inQuote = false
    }
    return true
  }
  if (c == '"') {
    cur.inQuote = true
    return true
  }
  return false
}

// Splits `rhs` on its TOP-LEVEL `|` only — one inside `(...)`/`[...]`/`{...}`
// (e.g. `unary = ( "!" | "-" | ... ) unary | postfix .`) or inside a quoted
// terminal (`binop`'s `"|"` alternative, the bitwise-or operator token) is
// left alone.
fn splitTopAlts(rhs: string): []string {
  let alts = []string(0)
  let depth = 0
  let cur = Cursor{ inQuote: false }
  let n = len(rhs)
  let start = 0
  let i = 0
  while (i < n && len(alts) < maxAltsPerProduction) {
    let c = rhs[i]
    if (consumeQuote(cur, c)) {
      i = i + 1
      continue
    }
    let bd = bracketDelta(c)
    if (bd != 0) {
      depth = depth + bd
      i = i + 1
      continue
    }
    if (c == '|' && depth == 0) {
      let piece = trimSpace(rhs[start:i])
      if (len(piece) > 0) {
        alts = append(alts, piece)
      }
      start = i + 1
      i = i + 1
      continue
    }
    i = i + 1
  }
  let last = trimSpace(rhs[start:n])
  if (len(last) > 0) {
    alts = append(alts, last)
  }
  return alts
}

// The index of the `]` that closes the `[` at `s[0]` (quote- and
// depth-aware), or -1 if `s` never balances.
fn findClosingBracket(s: string): int {
  let depth = 0
  let inQuote = false
  let n = len(s)
  let j = 0
  while (j < n) {
    let c = s[j]
    if (inQuote) {
      if (c == '"') {
        inQuote = false
      }
      j = j + 1
      continue
    }
    if (c == '"') {
      inQuote = true
      j = j + 1
      continue
    }
    if (c == '[') {
      depth = depth + 1
      j = j + 1
      continue
    }
    if (c == ']') {
      depth = depth - 1
      if (depth == 0) {
        return j
      }
      j = j + 1
      continue
    }
    j = j + 1
  }
  return -1
}

// Strips a leading `[ ... ]` optional group, so `[ "export" ] value_decl` and
// `value_decl` alone yield the same discriminator. Loops in case of more
// than one leading optional group.
fn skipLeadingOptional(alt: string): string {
  let s = trimSpace(alt)
  let guard = 0
  while (len(s) > 0 && s[0] == '[' && guard < maxOptionalSkips) {
    let closeAt = findClosingBracket(s)
    if (closeAt < 0) {
      return s
    }
    s = trimSpace(s[closeAt + 1:len(s)])
    guard = guard + 1
  }
  return s
}

// The token that identifies one alternative: its leading quoted terminal
// (`"class"`) or bare name (`value_decl`), after skipping a leading optional
// group. This is deliberately coarse — only the FIRST token, so anything
// abbreviated or reordered later in the alternative does not affect it.
fn leadingDiscriminator(alt: string): string {
  let s = skipLeadingOptional(alt)
  if (len(s) == 0) {
    return "<empty>"
  }
  if (s[0] == '"') {
    let restRel = indexOf(s[1:len(s)], "\"")
    if (restRel < 0) {
      return s
    }
    let end = 1 + int(restRel)
    return s[0:end + 1]
  }
  let i = 0
  let n = len(s)
  while (i < n && isIdentCont(s[i])) {
    i = i + 1
  }
  if (i == 0) {
    return s[0:1]
  }
  return s[0:i]
}

// The sorted, de-duplicated, newline-joined set of `rhs`'s alternatives'
// leading discriminators — order-insensitive, so a reordered RHS compares equal.
fn canonicalDiscriminators(rhs: string): string {
  let toks = []string(0)
  for a of splitTopAlts(rhs) {
    let d = leadingDiscriminator(a)
    if (!containsStr(toks, d)) {
      toks = append(toks, d)
    }
  }
  sortStrings(toks)
  return join(toks, "\n")
}

fn humanize(canon: string): string {
  return join(split(canon, "\n"), ", ")
}

// Every maximal, balanced bracketed span — `(...)`, `[...]`, or `{...}` —
// found anywhere in `rhs`, at any nesting depth, quote-aware so a quoted
// bracket character is never mistaken for a real one. A grouped alternation
// in this grammar lives inside one of these (`( "class" | "class" )`,
// `{ ( ";" | "," ) field }`), so a self-duplicate hiding in a nested group is
// invisible to splitTopAlts run once over the production's own top level —
// this is what lets CHECK 3 look inside as well as at the outer RHS.
fn findGroups(rhs: string): []string {
  let out = []string(0)
  let starts = []int(0)
  let cur = Cursor{ inQuote: false }
  let n = len(rhs)
  let i = 0
  while (i < n && len(out) < maxAltsPerProduction) {
    let c = rhs[i]
    if (consumeQuote(cur, c)) {
      i = i + 1
      continue
    }
    if (bracketDelta(c) > 0 && len(starts) < maxGroupNesting) {
      starts = append(starts, i)
    } else if (bracketDelta(c) < 0 && len(starts) > 0) {
      let start = starts[len(starts) - 1]
      starts = starts[0:len(starts) - 1]
      out = append(out, rhs[start + 1:i])
    }
    i = i + 1
  }
  return out
}

// Every scope in which this production's own `|` introduces alternatives:
// its top-level RHS, plus every group nested inside it.
fn selfDuplicateScopes(rhs: string): []string {
  let scopes = [rhs]
  for g of findGroups(rhs) {
    scopes = append(scopes, g)
  }
  return scopes
}

// The first leading-discriminator token shared by two of `scope`'s own
// top-level alternatives, or "" if every alternative starts differently.
fn firstDuplicateLeadingToken(scope: string): string {
  let seen = []string(0)
  for a of splitTopAlts(scope) {
    let d = leadingDiscriminator(a)
    if (containsStr(seen, d)) {
      return d
    }
    seen = append(seen, d)
  }
  return ""
}

fn selfCheck(cond: bool, label: string): int {
  if (cond) {
    return 0
  }
  eprint("spec: SELFTEST FAIL: ${label}\n")
  return 1
}

fn selfTestLineMatchers(): int {
  let failed = 0
  let pm1 = matchProdLine("top_decl      = import_decl")
  failed = failed + selfCheck(pm1.ok && pm1.name == "top_decl",
    "matchProdLine did not read an unindented production line")
  let pm2 = matchProdLine("  top_decl    = import_decl")
  failed = failed + selfCheck(!pm2.ok,
    "matchProdLine accepted an INDENTED line as a production")
  let pm3 = matchProdLine("let x = 1")
  failed = failed + selfCheck(!pm3.ok,
    "matchProdLine accepted `let x = 1` (there is a name between the identifier and `=`)")
  let cm1 = matchContLine("              | [ \"export\" ] value_decl")
  failed = failed + selfCheck(cm1.ok,
    "matchContLine did not read an indented continuation line")
  return failed
}

fn selfTestAltSplitting(): int {
  let failed = 0
  failed = failed + selfCheck(len(splitTopAlts("\"*\" | \"/\" | \"%\"")) == 3,
    "splitTopAlts did not find 3 top-level alternatives in a flat list")
  failed = failed + selfCheck(len(splitTopAlts("( \"!\" | \"-\" | \"+\" ) unary | postfix")) == 2,
    "splitTopAlts split on a `|` NESTED inside parens")
  failed = failed + selfCheck(len(splitTopAlts("\"*\" | \"|\" | \"%\"")) == 3,
    "splitTopAlts split on a `|` INSIDE a quoted terminal")
  failed = failed + selfCheck(leadingDiscriminator("[ \"export\" ] value_decl") == "value_decl",
    "leadingDiscriminator did not skip a leading optional group")
  failed = failed + selfCheck(leadingDiscriminator("\"class\" IDENT") == "\"class\"",
    "leadingDiscriminator did not capture a leading quoted terminal")
  return failed
}

fn selfTestDiscriminators(): int {
  let a = canonicalDiscriminators("assign_stmt | inc_dec_stmt | expr_stmt")
  let b = canonicalDiscriminators("expr_stmt | assign_stmt | inc_dec_stmt")
  let c = canonicalDiscriminators("assign_stmt | inc_dec_stmt")
  let failed = 0
  failed = failed + selfCheck(a == b,
    "canonicalDiscriminators is order-SENSITIVE; it must not be")
  failed = failed + selfCheck(a != c,
    "canonicalDiscriminators did not notice a dropped alternative")
  return failed
}

fn selfTestSelfDuplicates(): int {
  let failed = 0
  let groups = findGroups("( \"class\" | \"class\" ) IDENT")
  failed = failed + selfCheck(len(groups) == 1,
    "findGroups did not extract exactly one parenthesized group")
  failed = failed + selfCheck(firstDuplicateLeadingToken("\"class\" | \"class\"") == "\"class\"",
    "firstDuplicateLeadingToken missed a flat duplicate leading terminal")
  failed = failed + selfCheck(firstDuplicateLeadingToken("\"class\" | IDENT") == "",
    "firstDuplicateLeadingToken flagged two alternatives with DIFFERENT leading tokens")
  let scopes = selfDuplicateScopes("( \"class\" | \"class\" ) IDENT")
  failed = failed + selfCheck(len(scopes) == 2,
    "selfDuplicateScopes did not return both the outer RHS and its one nested group")
  let scopeHit = false
  for s of scopes {
    if (len(firstDuplicateLeadingToken(s)) > 0) {
      scopeHit = true
    }
  }
  failed = failed + selfCheck(scopeHit,
    "selfDuplicateScopes did not surface the nested group's own duplicate leading token")
  failed = failed + selfCheck(len(firstDuplicateLeadingToken("field { fsep field } [ fsep ]")) == 0,
    "firstDuplicateLeadingToken false-flagged a legitimate single-alternative scope")
  return failed
}

fn selfTestClassifier(): int {
  let grammarLines = ["top_decl      = import_decl", "              | value_decl ."]
  let codeLines = ["fn main() {", "  let total = sum(a, b)", "  println(total)", "}"]
  let failed = 0
  failed = failed + selfCheck(classifyBlock(grammarLines).isGrammar,
    "classifyBlock rejected a genuine EBNF block")
  failed = failed + selfCheck(!classifyBlock(codeLines).isGrammar,
    "classifyBlock accepted a Bit-code example as an EBNF block")
  return failed
}

// Runs BEFORE the corpus walk, on synthetic text, so a scanner bug is caught
// before it silently mis-scores the real file. Mirrors docs.bit's
// `plumbingSelfTest`/`runExtractTests` in spirit: a reader this file trusts
// gets proven against known-good and known-bad input first.
fn selfTest(): int {
  return selfTestLineMatchers() + selfTestAltSplitting() +
    selfTestDiscriminators() + selfTestSelfDuplicates() + selfTestClassifier()
}
