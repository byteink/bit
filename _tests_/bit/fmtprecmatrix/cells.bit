// The cell tables (#6417): every expression SLOT times every expression FORM
// that can be written into it, parenthesized and not. The tree keeps no
// parenthesis node, so `bit fmt` decides every paren from the child's tag and
// operator alone; each cell asks whether that decision keeps the tree.
//
// An outer is a slot: a statement with `@` where an expression goes. An inner
// is a form: source text over the operands `$x`, `$y`, `$z`. `(` and `)` around
// an inner make the weak forms (comparison, `&&`, `?:`, an arrow) reach a slot
// that binds tighter, which is the only way the tree can hold them there.
import { contains, hasSuffix, replace } from "std/strings"

// `id` names the slot or the form; `text` is the template or the source.
class Part {
  id: string,
  text: string,
}

fn part(id: string, text: string): Part {
  return Part{ id = id, text = text }
}

// One cell: its id (`<outer>/<inner>/<p|u>/<n|w>`) and the function it becomes.
class Cell {
  id: string,
  group: string,
  func: string,
  src: string,
}

// The binary operators, in the order of the language's precedence tiers.
fn binOps(): []Part {
  return [
    part("mul", "*"), part("div", "/"), part("rem", "%"), part("shl", "<<"),
    part("shr", ">>"), part("band", "&"), part("add", "+"), part("sub", "-"),
    part("bor", "|"), part("bxor", "^"), part("eq", "=="), part("ne", "!="),
    part("lt", "<"), part("le", "<="), part("gt", ">"), part("ge", ">="),
    part("land", "&&"), part("lor", "||"),
  ]
}

// Slots that are one operand of a binary operator: left and right of each.
fn binarySlots(): []Part {
  let out = []Part(0)
  for op of binOps() {
    out = append(out, part("bin-${op.id}-l", "let v = @ ${op.text} b"))
    out = append(out, part("bin-${op.id}-r", "let v = a ${op.text} @"))
  }
  return out
}

fn catchSlots(): []Part {
  return [
    part("catch-lhs", "let v = @ catch d"),
    part("catch-default", "let v = a catch @"),
    part("catch-default-chain", "let v = a catch b catch @"),
    part("catchbind-lhs", "let v = @ catch e {\n    0\n  }"),
    part("catchbind-body", "let v = a catch e {\n    @\n  }"),
    part("catch-default-then", "let v = a catch @ ? b : c"),
  ]
}

fn unaryAndCondSlots(): []Part {
  return [
    part("neg", "let v = -@"), part("not", "let v = !@"), part("plus", "let v = +@"),
    part("bnot", "let v = ~@"), part("deref", "let v = *@"), part("recv", "let v = <-@"),
    part("cond-test", "let v = @ ? b : c"), part("cond-then", "let v = a ? @ : c"),
    part("cond-else", "let v = a ? b : @"), part("cond-else-nest", "let v = a ? b : c ? d : @"),
  ]
}

fn postfixSlots(): []Part {
  return [
    part("call-callee", "let v = @(1)"), part("call-arg", "let v = f(@)"),
    part("call-arg-first", "let v = f(@, 1)"), part("call-arg-last", "let v = f(1, @)"),
    part("call-named", "let v = f(n = @)"), part("call-spread", "let v = f(...@)"),
    part("member", "let v = @.m"), part("tupleindex", "let v = @.0"),
    part("index-recv", "let v = @[0]"), part("index", "let v = a[@]"),
    part("slice-recv", "let v = @[1:2]"), part("slice-lo", "let v = a[@:2]"),
    part("slice-hi", "let v = a[1:@]"), part("slice-lo-open", "let v = a[@:]"),
    part("slice-hi-open", "let v = a[:@]"), part("assert", "let v = @.(T)"),
    part("try", "let v = @?"), part("convert", "let v = i64(@)"),
  ]
}

fn literalSlots(): []Part {
  return [
    part("composite", "let v = T{ f = @ }"), part("composite-gen", "let v = G<i64>{ f = @ }"),
    part("array-elem", "let v = [2]i64{ @, 1 }"), part("maplit-val", "let v = {k: @}"),
    part("maplit-key", "let v = {@: v}"), part(
      "maptype-val",
      "let v = map<string, i64>{ \"a\": @ }",
    ),
    part("slicelit", "let v = [@, 1]"), part("tuplelit-first", "let v = (@, 1)"),
    part("tuplelit-last", "let v = (1, @)"), part("interp", "let v = \"s\${@}\""),
    part("arrow-body", "let v = p => @"), part("arrow-body-paren", "let v = (p, q) => @"),
    part("arrow-block", "let v = p => {\n    return @\n  }"),
    part("jsx-expr", "let v = <a>{@}</a>"), part("jsx-attr", "let v = <a b={@} />"),
  ]
}

// Statements whose own first token is the expression, and the statement forms
// that carry an expression of their own.
fn statementSlots(): []Part {
  return [
    part("stmt-expr", "@"), part("stmt-return", "return @"), part("stmt-return-2", "return @, 1"),
    part("stmt-assign", "v = @"), part("stmt-assign-lhs", "@ = v"), part("stmt-inc", "@++"),
    part("stmt-if", "if (@) {\n  }"), part("stmt-while", "while (@) {\n  }"),
    part("stmt-forof", "for x of @ {\n  }"), part("stmt-send", "ch <- @"),
    part("stmt-send-lhs", "@ <- v"), part("stmt-fail", "fail @"), part("stmt-defer", "defer @"),
    part("stmt-spawn", "spawn @"), part("stmt-match", "match (@) {\n    _ => 1\n  }"),
    part("stmt-let-typed", "let v: i64 = @"), part("stmt-const", "const v = @"),
  ]
}

fn outers(): []Part {
  let out = binarySlots()
  out = append(out, ...catchSlots())
  out = append(out, ...unaryAndCondSlots())
  out = append(out, ...postfixSlots())
  out = append(out, ...literalSlots())
  return append(out, ...statementSlots())
}

fn binaryForms(): []Part {
  let out = []Part(0)
  for op of binOps() {
    out = append(out, part("${op.id}", "$x ${op.text} $y"))
  }
  return out
}

fn compoundForms(): []Part {
  return [
    part("add-mul", "$x + $y * $z"), part("mul-add", "($x + $y) * $z"),
    part("shl-add", "$x << $y + $z"), part("land-lor", "$x && $y || $z"),
    part("lor-land", "$x || $y && $z"), part("eq-land", "$x == $y && $z"),
    part("lt-bor", "$x < $y | $z"), part("sub-sub", "$x - $y - $z"),
    part("sub-paren", "$x - ($y - $z)"), part("div-div", "$x / ($y / $z)"),
  ]
}

fn catchCondForms(): []Part {
  return [
    part("catch", "$x catch $y"), part("catch-chain", "$x catch $y catch $z"),
    part("catch-add", "$x catch $y + $z"), part("catch-bind", "$x catch e {\n    0\n  }"),
    part("cond", "$x ? $y : $z"), part("cond-nest", "$x ? $y : $z ? 1 : 2"),
    part("cond-then-cond", "$x ? ($y ? 1 : 2) : $z"),
    part("arrow", "p => $x"), part("arrow-2", "(p, q) => $x + $y"),
    part("arrow-block", "p => {\n    return $x\n  }"),
  ]
}

fn unaryForms(): []Part {
  return [
    part("u-neg", "-$x"), part("u-not", "!$x"), part("u-plus", "+$x"), part("u-bnot", "~$x"),
    part("u-deref", "*$x"), part("u-recv", "<-$x"), part("u-neg-neg", "- -$x"),
    part("u-not-eq", "!($x == $y)"),
  ]
}

fn atomForms(): []Part {
  return [
    part("ident", "$x"), part("int", "1"), part("float", "1.5"), part("string", "\"s\""),
    part("interp", "\"a\${$x}\""), part("true", "true"), part("nil", "nil"),
    part("call", "g($x)"), part("member", "$x.m"), part("tupleindex", "$x.0"),
    part("index", "$x[0]"), part("slice", "$x[0:1]"), part("try", "$x?"),
    part("assert", "$x.(T)"), part("slicelit", "[$x, $y]"), part("maplit", "{k: $x}"),
    part("tuplelit", "($x, $y)"), part("composite", "T{ f = $x }"),
  ]
}

fn inners(): []Part {
  let out = binaryForms()
  out = append(out, ...compoundForms())
  out = append(out, ...catchCondForms())
  out = append(out, ...unaryForms())
  return append(out, ...atomForms())
}

// Operand names: short, or long enough that every cell overflows the print
// width, so the wrapping printer decides the parens too.
fn operands(wide: bool, text: string): string {
  let n = "x"
  let m = "y"
  let o = "z"
  if (wide) {
    n = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    m = "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
    o = "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"
  }
  return replace(replace(replace(text, "$x", n), "$y", m), "$z", o)
}

// A form that ends in `}`, or that is an arrow, cannot take a trailing operand
// unparenthesized, so those cells share groups of their own: the rest of a
// slot's group parses.
fn riskyGroup(form: string): string {
  if (hasSuffix(form, "}")) {
    return "-b"
  }
  if (contains(form, "=>")) {
    return "-a"
  }
  return ""
}

fn cellOf(o: Part, i: Part, paren: bool, wide: bool, k: int): Cell {
  let form = operands(wide, i.text)
  let tag = "u"
  if (paren) {
    form = "(${form})"
    tag = "p"
  }
  let width = "n"
  if (wide) {
    width = "w"
  }
  let name = "f${k}"
  let stmt = replace(o.text, "@", form)
  return Cell{
    id = "${o.id}/${i.id}/${tag}/${width}",
    group = "${o.id}-${width}${riskyGroup(form)}",
    func = name,
    src = "fn ${name}() {\n  ${stmt}\n}\n",
  }
}

// Every cell; `fn` is `f<index>` so a name is never a keyword.
fn cells(): []Cell {
  let out = []Cell(0)
  let k = 0
  for wide of [false, true] {
    for o of outers() {
      for i of inners() {
        for paren of [false, true] {
          out = append(out, cellOf(o, i, paren, wide, k))
          k = k + 1
        }
      }
    }
  }
  return out
}
