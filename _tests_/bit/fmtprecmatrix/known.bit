// Cells whose formatted tree or second pass still disagrees, each under the
// ticket that fixes it (#6417). Asserted both ways by fmtprecmatrix.bit: a
// disagreeing cell missing from the list fails the gate, and a listed cell that
// now agrees fails it too. A cell id is `<slot>/<form>/<p|u>/<n|w>`, as
// `cells()` (cells.bit) builds it.
class Known {
  id: string,
  ticket: string,
}

fn knownFailures(): []Known {
  return []Known(0)
}
