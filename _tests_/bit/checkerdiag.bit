// #3839 (named arguments at call sites) adds 5 more —
// check_named_arg_unknown (E0124), check_named_arg_duplicate (E0125),
// check_named_arg_positional_after (E0126), check_named_arg_variadic
// (E0127), check_named_arg_not_direct (E0128) — giving 106. Derived with
// `ls _tests_/bit/checkercases/*.bit | wc -l`.
const expectedCases: int = 106

// `osRunBounded`'s own ceiling (runtime/root/*/os.bit `osBoundedMaxMs`).
// `BIT_TEST_TIMEOUT_S=0` means "do not bound", which here is this maximum.
const maxTimeoutMs: int = 6000000
const defaultTimeoutS: int = 300

class Ctx {
  casesDir: string,
  bin: string,
  stdlib: string,
  libbitrt: string,
  scratch: string,
  timeoutMs: int,
  checks: int,
  failures: int,
}

class RunOut {
  code: int,
  out: string,
  err: string,
}

// --- reporting -------------------------------------------------------------

// Every failure names the case and what was being asserted; nothing is counted
// without being printed, so a red run says which case and why.
fn failCase(c: Ctx, name: string, what: string, why: string) {
  c.failures = c.failures + 1
  eprint("checkerdiag: FAIL ${name} [${what}]: ${why}\n")
}

fn clip(s: string): string {
  if (len(s) <= 600) {
    return s
  }
  return s[0:600] + "\n  ...[truncated]"
}

fn reportDiff(expected: string, actual: string) {
  eprint("  expected (${len(expected)} bytes):\n${clip(expected)}\n")
  eprint("  actual   (${len(actual)} bytes):\n${clip(actual)}\n")
}

// --- shell wrapper ---------------------------------------------------------

// Wraps `s` as exactly one POSIX `/bin/sh` word.
fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

fn outPath(c: Ctx): string { return c.scratch + "/out" }
fn errPath(c: Ctx): string { return c.scratch + "/err" }
fn shPath(c: Ctx): string { return c.scratch + "/w.sh" }

fn removeQuiet(path: string) {
  remove(path) catch e {
    return
  }
}

// Builds and runs one `/bin/sh` wrapper: cd into the corpus, export the
// compiler's environment, then `exec` `argv` with stdout/stderr redirected to
// files this process reads back. `exec` matters: it makes the child REPLACE the
// shell, so a compiler that dies of SIGSEGV kills the process `osRunBounded`
// waits on and the crash stays distinguishable from a nonzero exit (ABI.md §19).
//
// Builds the `#!/bin/sh` wrapper text: cd into the corpus, export the
// compiler's environment, then `exec` argv with stdout/stderr redirected to
// files runWrapped reads back.
fn buildWrapperScript(c: Ctx, argv: []string): string {
  let script = "#!/bin/sh\n"
  script = script + "cd " + shQuote(c.casesDir) + " || exit 125\n"
  if (c.stdlib != "") {
    script = script + "BIT_STDLIB=" + shQuote(c.stdlib) + "\nexport BIT_STDLIB\n"
  }
  if (c.libbitrt != "") {
    script = script + "BIT_LIBBITRT=" + shQuote(c.libbitrt) + "\nexport BIT_LIBBITRT\n"
  }
  script = script + "exec"
  let i = 0
  while (i < len(argv)) {
    script = script + " " + shQuote(argv[i])
    i = i + 1
  }
  script = script + " > " + shQuote(outPath(c)) + " 2> " + shQuote(errPath(c)) + "\n"
  return script
}

// Interprets the reserved/negative exit codes osRunBounded uses to signal a
// launch failure rather than a real process exit, reporting the matching
// failure. Returns true when `code` was one of those sentinels (the caller
// must stop); false means `code` is an ordinary exit status.
fn reportSentinelFailure(c: Ctx, name: string, what: string, code: int): bool {
  if (code == 0 - 2) {
    failCase(c, name, what, "TIMED OUT after ${c.timeoutMs}ms (raise BIT_TEST_TIMEOUT_S)")
    return true
  }
  if (code == 0 - 1) {
    failCase(c, name, what, "cannot launch wrapper script (spawn/wait failure)")
    return true
  }
  if (code <= 0 - 100) {
    failCase(c, name, what, "CRASHED: killed by signal ${0 - code - 100}")
    return true
  }
  if (code == 125) {
    failCase(c, name, what, "wrapper could not cd to ${c.casesDir}")
    return true
  }
  return false
}

// The redirections are established before `exec`, so both files exist the
// moment the command starts. A missing one means the wrapper never got that
// far — the exact silent hole a `readFile ... catch { "" }` fallback hides.
fn readCapturedOutput(c: Ctx, name: string, what: string): (string, string, bool) {
  if (!exists(outPath(c)) || !exists(errPath(c))) {
    failCase(c, name, what, "wrapper produced no redirect files — it never ran the command")
    return "", "", false
  }
  let so = readFile(outPath(c)) catch e {
    failCase(c, name, what, "cannot read captured stdout")
    return "", "", false
  }
  let se = readFile(errPath(c)) catch e {
    failCase(c, name, what, "cannot read captured stderr")
    return "", "", false
  }
  return so, se, true
}

// Returns ok=false and reports the failure itself when the wrapper could not be
// launched, timed out, crashed, or never reached its `exec` — so the caller can
// never read an absent redirect file as "empty output".
fn runWrapped(c: Ctx, name: string, what: string, argv: []string): (RunOut, bool) {
  removeQuiet(outPath(c))
  removeQuiet(errPath(c))

  let script = buildWrapperScript(c, argv)
  let empty = RunOut{ code: 0, out: "", err: "" }
  writeFile(shPath(c), script) catch e {
    failCase(c, name, what, "cannot write wrapper script ${shPath(c)}")
    return empty, false
  }
  if (fsChmod(shPath(c), 448) != 0) { // 0o700
    failCase(c, name, what, "cannot chmod wrapper script ${shPath(c)}")
    return empty, false
  }

  let code = osRunBounded(shPath(c), c.timeoutMs)
  if (reportSentinelFailure(c, name, what, code)) {
    return empty, false
  }
  let (so, se, ok) = readCapturedOutput(c, name, what)
  if (!ok) {
    return empty, false
  }
  return RunOut{ code: code, out: so, err: se }, true
}

// --- normalization ---------------------------------------------------------

fn firstLine(src: string): string {
  let nl = indexOf(src, "\n")
  let line = src
  if (nl >= 0) {
    line = src[0:nl]
  }
  if (len(line) > 0 && line[len(line) - 1] == 13) { // \r
    line = line[0:len(line) - 1]
  }
  return trimSpace(line)
}

// `bit check` renders a single-file module's path as `./<name>` because the
// loader joins the canonicalised root dir onto the file name; the `.expected`
// corpus was written against the bare name. Character-for-character golden.bit's
// `stripDotSlash`, including its bound: only the `-->` location header is
// rewritten, and only that exact prefix, so no diagnostic BODY text can be
// caught by it. The two must not drift — a looser normalization here would make
// this gate weaker than the one these cases came from, which is the whole reason
// they were not turned into `contains` assertions.
fn stripDotSlash(s: string): string {
  let needle = " --> ./"
  let repl = " --> "
  let out = ""
  let rest = s
  while (true) {
    let at = indexOf(rest, needle)
    if (at < 0) {
      return out + rest
    }
    out = out + rest[0:at] + repl
    rest = rest[at + len(needle):len(rest)]
  }
  return out
}

// --- the check ------------------------------------------------------------

// One `// error` case: `bit check` must fail AND the rendered diagnostics must
// match `.expected` byte for byte. The text is the oracle; the exit code alone
// is not, because a missing input file also exits nonzero.
fn checkError(c: Ctx, name: string, expected: string) {
  let (r, ok) = runWrapped(c, name, "error", [c.bin, "check", name])
  if (!ok) {
    return
  }
  c.checks = c.checks + 1
  if (r.code == 0) {
    failCase(c, name, "error", "expected compilation to fail, but `bit check` exited 0")
    return
  }
  c.checks = c.checks + 1
  let actual = stripDotSlash(r.err)
  if (expected == actual) {
    return
  }
  failCase(c, name, "error", "stderr does not match .expected")
  reportDiff(expected, actual)
}

// #2084's sweep, inherited from golden.bit. `--dump-ir`/`--dump-ir-pre` bypass
// `checkFile` deliberately, so they are the one path that lowers a program the
// checker would have rejected — and these four cases are exactly such programs.
// The output is deliberately ignored (an invalid program has no correct dump to
// compare against); the assertion is the weakest one that holds for every case
// and the only one worth having here: do not die by signal. `runWrapped` already
// reports a signal death as CRASHED and counts it, so the sweep is the check.
// Both flags run because they are different code paths — `--dump-ir-pre` stops
// before the optimizer, and #2084 crashed only the post-opt one.
fn checkDumpSurvives(c: Ctx, name: string) {
  let (_, aok) = runWrapped(c, name, "dump-ir survives", [c.bin, "--dump-ir", name])
  if (aok) {
    c.checks = c.checks + 1
  }
  let (_, bok) = runWrapped(c, name, "dump-ir-pre survives", [c.bin, "--dump-ir-pre", name])
  if (bok) {
    c.checks = c.checks + 1
  }
}

// #4133: `checkDumpSurvives` above only asserts a `--dump-ir-pre` dump does
// not crash — a miscompile that never crashes, only silently reads a slice's
// own SSA result as a length/capacity (#4104), passes that sweep every time.
// `lowerSliceAlloc` (compiler/lowerlit.bit) now checks the length/cap
// argument's type independently of the checker, precisely because
// `--dump-ir`/`--dump-ir-pre` lower unchecked input and are the one path
// #4091's E0111 checker fix (compiler/validatezero.bit) does not reach. This
// is the dedicated assertion for that guard: dumped IR for a
// checker-rejected `[]T(n)` allocation must never contain `slice_new` at all
// — a checker-rejected function lowers to a signature-only stub — and must
// never reach the chained `slice_new(%N, %N, ...)` shape that reads the first
// slice's own SSA result as the second's length and capacity.
fn checkSliceAllocLowerGuard(c: Ctx, name: string) {
  let (r, ok) = runWrapped(c, name, "dump-ir-pre slice_new guard", [c.bin, "--dump-ir-pre", name])
  if (!ok) {
    return
  }
  c.checks = c.checks + 1
  if (indexOf(r.out, "slice_new") < 0) {
    return
  }
  failCase(
    c, name, "dump-ir-pre slice_new guard",
    "dumped IR still emits slice_new for a checker-rejected slice length/capacity argument (#4104's miscompile survives lowering)",
  )
  reportDiff("(no slice_new — a signature-only stub)", r.out)
}

// #4137: `isBytesConversion` (compiler/lowerlit.bit) admitted the §12.9
// `[]byte(s)` bytes-conversion early return on a single `string` argument
// alone, with no check that the slice's element is byte-sized — a gap
// `checkSliceAllocLowerGuard` above cannot see, since `isBytesConversion`
// returns before `lowerSliceAllocLenArg` (#4133's guard) is ever called.
// `bit check`/`build`/`run` never reached it (this fixture's own E0111 is
// what stops them), but `--dump-ir`/`--dump-ir-pre` lower unchecked input and
// took the bytes-conversion path regardless of element type, typing a
// short-buffer `rt_call bytes_from_string` as a wider-element slice. This is
// the dedicated assertion for the fix: dumped IR for a checker-rejected
// `[]T(s)` bytes conversion must never contain `bytes_from_string` at all —
// a checker-rejected function lowers to a signature-only stub.
fn checkBytesConversionElemGuard(c: Ctx, name: string) {
  let (r, ok) = runWrapped(
    c,
    name,
    "dump-ir-pre bytes_from_string elem guard",
    [c.bin, "--dump-ir-pre", name],
  )
  if (!ok) {
    return
  }
  c.checks = c.checks + 1
  if (indexOf(r.out, "bytes_from_string") < 0) {
    return
  }
  failCase(
    c, name, "dump-ir-pre bytes_from_string elem guard",
    "dumped IR still emits bytes_from_string for a checker-rejected non-byte-sized slice element (#4137's miscompile survives lowering)",
  )
  reportDiff("(no bytes_from_string — a signature-only stub)", r.out)
}

// --- corpus walk -----------------------------------------------------------

// Every `.expected` must have a `.bit`, so a renamed case cannot leave dead
// weight behind that nothing reads and nobody notices.
fn checkOrphanExpected(c: Ctx, names: []string) {
  let stems = map<string, bool>{}
  for n of names {
    if (hasSuffix(n, ".bit")) {
      stems[n[0:len(n) - 4]] = true
    }
  }
  for n of names {
    if (!hasSuffix(n, ".expected")) {
      continue
    }
    let stem = n[0:len(n) - 9]
    let (_, has) = stems[stem]
    if (!has) {
      c.failures = c.failures + 1
      eprint("checkerdiag: FAIL ${n}: orphaned .expected — no sibling ${stem}.bit\n")
    }
  }
}

// Returns how many cases were actually walked, which the census then pins.
fn walk(c: Ctx, names: []string): int {
  let total = 0
  for n of names {
    if (!hasSuffix(n, ".bit")) {
      continue
    }
    total = total + 1
    let src = readFile(c.casesDir + "/" + n) catch e {
      c.failures = c.failures + 1
      eprint("checkerdiag: FAIL ${n}: cannot read case source\n")
      continue
    }
    // Only `// error` belongs here. Anything else would be judged by the wrong
    // oracle — silently, since a `// run` case's `.expected` is stdout.
    let line = firstLine(src)
    if (!hasPrefix(line, "// error")) {
      c.failures = c.failures + 1
      eprint("checkerdiag: FAIL ${n}: line 1 is '${line}', want a `// error` directive\n")
      eprint("  this gate drives `bit check` only; other directives belong in _tests_/cases/\n")
      continue
    }
    let expectedPath = c.casesDir + "/" + n[0:len(n) - 4] + ".expected"
    let expected = readFile(expectedPath) catch e {
      c.failures = c.failures + 1
      eprint("checkerdiag: FAIL ${n}: cannot read ${expectedPath}\n")
      continue
    }
    // An empty `.expected` would be satisfied by a compiler that says nothing.
    if (len(expected) == 0) {
      c.failures = c.failures + 1
      eprint("checkerdiag: FAIL ${n}: ${expectedPath} is empty — nothing would be pinned\n")
      continue
    }
    checkError(c, n, expected)
    checkDumpSurvives(c, n)
    // #4133: one dedicated assertion beyond the crash-only sweep above, for
    // the one fixture that reproduces the address-as-length miscompile.
    if (n == "check_slice_alloc_slice_arg.bit") {
      checkSliceAllocLowerGuard(c, n)
    }
    if (n == "check_slice_alloc_bytes_elem.bit") {
      checkBytesConversionElemGuard(c, n)
    }
  }
  return total
}

fn checkCensus(c: Ctx, total: int) {
  if (total == expectedCases) {
    return
  }
  c.failures = c.failures + 1
  eprint("checkerdiag: FAIL census: walked ${total} case(s), manifest says ${expectedCases}\n")
  eprint("  adding or removing a case must edit expectedCases in the same commit\n")
}

// --- configuration ---------------------------------------------------------

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("checkerdiag: ${name} is not set — refusing to guess. This gate has no\n")
    eprint("checkerdiag: defaults; an unset corpus or compiler path must fail, never\n")
    eprint("checkerdiag: silently walk '.'.\n")
    exit(2)
  }
  return v
}

// `BIT_TEST_TIMEOUT_S`, the contract every harness here shares: default 300s,
// `0` disables the bound (here: the runtime's own one-hour ceiling).
fn timeoutMs(): int {
  let raw = trimSpace(envOr("BIT_TEST_TIMEOUT_S", ""))
  if (raw == "") {
    return defaultTimeoutS * 1000
  }
  let s = parseInt(raw) catch e {
    eprint("checkerdiag: BIT_TEST_TIMEOUT_S='${raw}' is not a number; using ${defaultTimeoutS}s\n")
    return defaultTimeoutS * 1000
  }
  if (s <= 0) {
    return maxTimeoutMs
  }
  if (s * 1000 > maxTimeoutMs) {
    return maxTimeoutMs
  }
  return s * 1000
}

fn main() {
  let casesDir = requiredEnv("BIT_CHECKER_CASES_DIR")
  let bin = requiredEnv("BIT_BIN")
  if (!fsIsDir(casesDir)) {
    eprint("checkerdiag: BIT_CHECKER_CASES_DIR='${casesDir}' is not a directory\n")
    exit(2)
  }
  if (!exists(bin)) {
    eprint("checkerdiag: BIT_BIN='${bin}' does not exist\n")
    exit(2)
  }

  let scratch = envOr("TMPDIR", "/tmp") + "/bit-checkerdiag-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("checkerdiag: cannot create scratch directory ${scratch}\n")
    exit(2)
  }

  let c = Ctx{
    casesDir: casesDir,
    bin: bin,
    stdlib: env("BIT_STDLIB"),
    libbitrt: env("BIT_LIBBITRT"),
    scratch: scratch,
    timeoutMs: timeoutMs(),
    checks: 0,
    failures: 0,
  }

  let names = readDir(casesDir) catch e {
    eprint("checkerdiag: cannot list ${casesDir}\n")
    exit(2)
    return
  }
  checkOrphanExpected(c, names)
  let total = walk(c, names)
  checkCensus(c, total)

  removeQuiet(outPath(c))
  removeQuiet(errPath(c))
  removeQuiet(shPath(c))
  removeQuiet(scratch)

  // The run marker: 4 assertions per case (failed exit, matching text, and the
  // two dump sweeps), plus 1 more for #4133's dedicated slice_new guard on
  // check_slice_alloc_slice_arg.bit alone, plus 1 more for #4137's dedicated
  // bytes_from_string elem guard on check_slice_alloc_bytes_elem.bit alone. A
  // gate that stopped checking is visible here, not green.
  let wantChecks = expectedCases * 4 + 2
  if (c.checks < wantChecks) {
    c.failures = c.failures + 1
    eprint("checkerdiag: FAIL: only ${c.checks} checks ran, want ${wantChecks}\n")
  }
  if (c.failures > 0) {
    eprint("checkerdiag: FAIL — ${c.failures} failure(s) over ${total} case(s), ${c.checks} checks\n")
    exit(1)
    return
  }
  print("checkerdiag: PASS — ${total} cases, ${c.checks} checks, 0 failures\n")
}
