// The private-name scan `_tests_/bit/docs.bit` (`test-docs`) runs beside its
// snippet typecheck (#6528).
//
// The property: no public text names a private repository, host or tool. The
// pages under `docs/`, `spec/`, `examples/`, `README.md`, `pkg/README.md`,
// `dist/README.md`, `runtime/ABI.md` and each `pkg/<name>/README.md` are
// published on bitlang.org and on GitHub, and a private repository name there
// is a leak the owner forbade. Those files are the public text this gate owns; the forbidden tokens are `forbiddenNames`
// below.
//
// There is no allowlist: no legitimate use of any token exists in these trees.
// This file and its caller are the only places the tokens are written down, and
// they live under `_tests_/`, which no scanned root contains.
//
// A scan that finds nothing is only worth something if it can find something,
// so `privateNamesSelfTest` runs first and aborts on a scanner that misses a
// planted token or flags a clean line; `scanPrivateNames` also returns how many
// files it read, so a walk that silently covers nothing fails the caller's
// floor instead of passing.

import { exists, isDir, readDir, readFile, walk } from "std/fs"
import { contains, hasSuffix, split, toLower } from "std/strings"

// Bounds on the walk, so the traversal is provably finite (Power of 10).
const maxFilesPerTree: int = 1024

const maxPkgDirs: int = 256

export class PrivateScan {
  export files: int,
  export hits: []string,
}

fn forbiddenNames(): []string {
  return ["bit-website", "bitlab", "hl-master", "smash", ".claude/"]
}

// The extensions of the text files the public trees carry. A built binary left
// under `examples/` is not text and is not public prose.
fn textSuffixes(): []string {
  return [".md", ".bit", ".json", ".lock", ".toml", ".txt", ".sh", ".html"]
}

// The first forbidden token `line` names, or "" when it is clean. Case is
// folded: `Smash` and `BitLab` leak the same name.
export fn forbiddenIn(line: string): string {
  let low = toLower(line)
  for name of forbiddenNames() {
    if (contains(low, name)) {
      return name
    }
  }
  return ""
}

// One `path:line: token` entry per offending line of `text`.
fn textHits(path: string, text: string): []string {
  let out = []string(0)
  let lines = split(text, "\n")
  let i = 0
  while (i < len(lines)) {
    let name = forbiddenIn(lines[i])
    if (len(name) > 0) {
      out = append(out, "${path}:${i + 1}: ${name}")
    }
    i = i + 1
  }
  return out
}

fn isTextFile(path: string): bool {
  for s of textSuffixes() {
    if (hasSuffix(path, s)) {
      return true
    }
  }
  return false
}

// Fold `path` into `acc`: one file counted, its offending lines appended.
fn scanFile(acc: PrivateScan, path: string): PrivateScan {
  let text = readFile(path) catch e {
    return PrivateScan{
      files = acc.files,
      hits = append(acc.hits, "${path}: unreadable: ${e.message()}"),
    }
  }
  let found = acc.hits
  for h of textHits(path, text) {
    found = append(found, h)
  }
  return PrivateScan{ files = acc.files + 1, hits = found }
}

// Every text file under `root`, which must exist: a missing public tree is a
// finding, never an empty pass.
fn scanTree(acc: PrivateScan, root: string): PrivateScan {
  let all = walk(root) catch e {
    return PrivateScan{
      files = acc.files,
      hits = append(acc.hits, "${root}: cannot walk: ${e.message()}"),
    }
  }
  if (len(all) > maxFilesPerTree) {
    return PrivateScan{
      files = acc.files,
      hits = append(acc.hits, "${root}: ${len(all)} entries, over the bound of ${maxFilesPerTree}"),
    }
  }
  let out = acc
  for p of all {
    if (isTextFile(p)) {
      out = scanFile(out, p)
    }
  }
  return out
}

// `pkg/<name>/README.md` for every package directory: the READMEs only, the
// packages' sources are not public prose.
fn scanPkgReadmes(acc: PrivateScan, pkgDir: string): PrivateScan {
  let names = readDir(pkgDir) catch e {
    return PrivateScan{
      files = acc.files,
      hits = append(acc.hits, "${pkgDir}: cannot list: ${e.message()}"),
    }
  }
  if (len(names) > maxPkgDirs) {
    return PrivateScan{
      files = acc.files,
      hits = append(acc.hits, "${pkgDir}: ${len(names)} entries, over the bound of ${maxPkgDirs}"),
    }
  }
  let out = acc
  for n of names {
    let readme = "${pkgDir}/${n}/README.md"
    if (isDir("${pkgDir}/${n}") && exists(readme)) {
      out = scanFile(out, readme)
    }
  }
  return out
}

// The scan over the public trees under repo root `root`.
export fn scanPrivateNames(root: string): PrivateScan {
  let acc = PrivateScan{ files = 0, hits = []string(0) }
  acc = scanTree(acc, "${root}/docs")
  acc = scanTree(acc, "${root}/spec")
  acc = scanTree(acc, "${root}/examples")
  acc = scanFile(acc, "${root}/README.md")
  acc = scanFile(acc, "${root}/pkg/README.md")
  acc = scanFile(acc, "${root}/dist/README.md")
  acc = scanFile(acc, "${root}/runtime/ABI.md")
  return scanPkgReadmes(acc, "${root}/pkg")
}

// The scanner against known-good and known-bad lines, one per forbidden token
// plus a case-folded one and a clean one. Returns the failures, 0 when sound.
export fn privateNamesSelfTest(): int {
  let failed = 0
  for name of forbiddenNames() {
    if (forbiddenIn("see the ${name} repository") != name) {
      failed = failed + 1
    }
  }
  if (forbiddenIn("Built from BitLab output") != "bitlab") {
    failed = failed + 1
  }
  if (len(forbiddenIn("the website repository and bitlang.org")) != 0) {
    failed = failed + 1
  }
  if (len(textHits("p.md", "clean\nx hl-master y\nclean")) != 1) {
    failed = failed + 1
  }
  return failed
}

// The files the scan must read: today's corpus is 199 text files, and a
// walk that stopped descending would land far below this.
const minScannedFiles: int = 190

// Run the self-test and the scan over `root`, print every finding, and return
// how many there were: 0 means the public trees name nothing private.
export fn reportPrivateNames(root: string): int {
  let broken = privateNamesSelfTest()
  if (broken != 0) {
    eprint("docs: FAILED — the private-name scanner failed ${broken} self-test case(s)\n")
    return broken
  }
  let scan = scanPrivateNames(root)
  for h of scan.hits {
    eprint("docs: FAIL ${h} names a private repository, host or tool\n")
  }
  let low = 0
  if (scan.files < minScannedFiles) {
    eprint("docs: FAILED — private-name scan read ${scan.files} file(s), under the floor of ${minScannedFiles}\n")
    low = 1
  }
  if (len(scan.hits) == 0 && low == 0) {
    print("docs: private-name scan ok — ${scan.files} file(s) read\n")
  }
  return len(scan.hits) + low
}
