// The private-name scan `_tests_/bit/docs.bit` (`test-docs`) runs beside its
// snippet typecheck (#6528, widened to every tracked text file by #6530).
//
// The property: no tracked text file names a private repository, host or tool.
// The repository is public, and a private name in a code comment or a script is
// the same leak as one in a doc page. One token set, `forbiddenNames`
// (`bit-website`, `bitlab`, `hl-master`, `smash`, `.claude/`, `mustafa-desktop`),
// applies to EVERY tracked text file: a comment cites a ticket as `#NNNN`, never
// by tracker name, and a script that really connects to a machine resolves its
// alias at run time (`scripts/x64host.sh`), never from a literal. The public
// prose (`docs/`, `spec/`, `examples/`, `README.md`, `pkg/README.md`,
// `dist/README.md`, `runtime/ABI.md` and each `pkg/<name>/README.md`, which
// bitlang.org and GitHub publish verbatim) is only COUNTED apart, so a listing
// that lost it fails a floor.
//
// A name is matched as a whole token: `smashing` in a public password list is
// an ordinary word, `smash.json` and `smash_next` are the tool. A name that
// starts or ends with a letter must not touch a letter there; `.claude/` is a
// path fragment and matches wherever it appears.
//
// The file set is `git grep -I -l -e ''` over the repo: tracked files only,
// binaries dropped by git's own test, never a filesystem walk (a walk reads
// gitignored build output).
//
// `allowedSites` is the whole allowlist: a file that may name a token, with its
// one-line reason. The scanner's own source is on it because it writes the
// tokens down. Every entry is asserted BOTH ways: a listed file that no longer
// names a token is itself a finding, so the list cannot go stale.
//
// A scan that finds nothing is only worth something if it can find something,
// so `privateNamesSelfTest` runs first and aborts on a scanner that misses a
// planted token or flags a clean line; `scanPrivateNames` also returns how many
// files it read, so a listing that silently covers nothing fails the caller's
// floors instead of passing.

import { readFile, remove, writeFile } from "std/fs"
import { hasPrefix, hasSuffix, indexOfFrom, split, toLower } from "std/strings"

// Bound on the one `git grep` child (Power of 10).
const listTimeoutMs: i64 = 60000

// A tracked file allowed to name a private token, and why.
class AllowedSite {
  path: string,
  reason: string,
}

fn allowedSites(): []AllowedSite {
  return [
    AllowedSite{
      path = "_tests_/bit/docsprivate/private.bit",
      reason = "the scanner's own source writes the tokens it forbids",
    },
    AllowedSite{
      path = ".gitignore",
      reason = "ignores the maintainer's per-checkout tracker pointer file, which can only be named by its file name",
    },
    AllowedSite{
      path = "_tests_/bit/noemdash.bit",
      reason = "its private-path check writes the fragments it forbids in other files",
    },
    AllowedSite{
      path = "dist/release-verify.sh",
      reason = "reads the website checkout beside bit/; its directory name is the one default of WEBSITE (BIT_WEBSITE_DIR overrides)",
    },
    AllowedSite{
      path = "dist/stage0/SHA256SUMS",
      reason = "historical release-pin comment lines, owned by the stage0 repin (#6527); delete this entry when it rewrites them",
    },
  ]
}

export class PrivateScan {
  export files: int,
  export prose: int,
  export hits: []string,
}

fn forbiddenNames(): []string {
  return ["bit-website", "bitlab", "hl-master", "smash", ".claude/", "mustafa-desktop"]
}

fn isAsciiLetter(c: u8): bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

// Whether the `n` bytes of `low` at `at` stand as a whole token: a name that
// starts (ends) with a letter must not continue a longer word, so `smashing`
// is a word and `smash.json` and `smash_next` name the tool. A name that
// starts or ends with a non-letter (`.claude/`) needs no boundary there.
fn wholeTokenAt(low: string, at: int, n: int, name: string): bool {
  if (isAsciiLetter(name[0]) && at > 0 && isAsciiLetter(low[at - 1])) {
    return false
  }
  let end = at + n
  if (isAsciiLetter(name[n - 1]) && end < len(low) && isAsciiLetter(low[end])) {
    return false
  }
  return true
}

// Whether the lowercased `low` names `name` as a whole token anywhere. Bounded:
// `from` grows by at least one every iteration and stays within `len(low)`.
fn namesToken(low: string, name: string): bool {
  let from = 0
  while (from <= len(low) - len(name)) {
    let at = indexOfFrom(low, name, from)
    if (at < 0) {
      return false
    }
    if (wholeTokenAt(low, at, len(name), name)) {
      return true
    }
    from = at + 1
  }
  return false
}

// The first of `names` that `line` names as a whole token, or "" when it is
// clean. Case is folded: `Smash` and `BitLab` leak the same name.
fn firstNameIn(line: string, names: []string): string {
  let low = toLower(line)
  for name of names {
    if (namesToken(low, name)) {
      return name
    }
  }
  return ""
}

export fn forbiddenIn(line: string): string {
  return firstNameIn(line, forbiddenNames())
}

// One `path:line: token` entry per offending line of `text`. The whole text is
// tested once first: nearly every file is clean, and this is the hot path over
// ~40 MB of tracked text.
fn textHits(path: string, text: string, names: []string): []string {
  let out = []string(0)
  if (len(firstNameIn(text, names)) == 0) {
    return out
  }
  let lines = split(text, "\n")
  let i = 0
  while (i < len(lines)) {
    let name = firstNameIn(lines[i], names)
    if (len(name) > 0) {
      out = append(out, "${path}:${i + 1}: ${name}")
    }
    i = i + 1
  }
  return out
}

// `pkg/<name>/README.md`: three segments exactly, not a nested README.
fn isPkgReadme(path: string): bool {
  if (!hasPrefix(path, "pkg/") || !hasSuffix(path, "/README.md")) {
    return false
  }
  return len(split(path, "/")) == 3
}

// The published prose: the files bitlang.org and GitHub render verbatim.
fn isPublicProse(path: string): bool {
  for dir of ["docs/", "spec/", "examples/"] {
    if (hasPrefix(path, dir)) {
      return true
    }
  }
  for file of ["README.md", "pkg/README.md", "dist/README.md", "runtime/ABI.md"] {
    if (path == file) {
      return true
    }
  }
  return isPkgReadme(path)
}

fn allowedIndex(path: string): int {
  let sites = allowedSites()
  let i = 0
  while (i < len(sites)) {
    if (sites[i].path == path) {
      return i
    }
    i = i + 1
  }
  return -1
}

// The tracked text files under `root`, one path per entry.
fn trackedTextFiles(root: string, scratch: string): []string! {
  let list = "${scratch}/private-files.txt"
  let script = "${scratch}/private-files.sh"
  writeFile(script, "#!/bin/sh\ncd '${root}' || exit 97\nexec git grep -I -l -e '' > '${list}'\n")?
  if (fsChmod(script, 448) != 0) {
    fail newError("cannot make ${script} executable")
  }
  let rc = osRunBounded(script, listTimeoutMs)
  if (rc != 0) {
    fail newError("`git grep -I -l` exited ${rc}")
  }
  let text = readFile(list)?
  // The caller's `teardown` removes the scratch directory non-recursively, so
  // these two files must not outlive the listing.
  remove(list)?
  remove(script)?
  let out = []string(0)
  for line of split(text, "\n") {
    if (len(line) > 0) {
      out = append(out, line)
    }
  }
  return out
}

// Fold one tracked file into `acc`. An allowlisted file is not a finding, but
// its index in `used` is marked when it really names a token.
fn scanFile(acc: PrivateScan, root: string, path: string, used: []bool): PrivateScan {
  let text = readFile("${root}/${path}") catch e {
    return PrivateScan{
      files = acc.files,
      prose = acc.prose,
      hits = append(acc.hits, "${path}: unreadable: ${e.message()}"),
    }
  }
  let found = textHits(path, text, forbiddenNames())
  let site = allowedIndex(path)
  if (site >= 0) {
    used[site] = len(found) > 0
    found = []string(0)
  }
  let n = acc.prose
  if (isPublicProse(path)) {
    n = n + 1
  }
  let hits = acc.hits
  for h of found {
    hits = append(hits, h)
  }
  return PrivateScan{ files = acc.files + 1, prose = n, hits = hits }
}

// One finding per allowlist entry whose file names nothing: a stale entry
// would keep a hole open for the next mention.
fn staleSites(acc: PrivateScan, used: []bool): PrivateScan {
  let sites = allowedSites()
  let out = acc.hits
  let i = 0
  while (i < len(sites)) {
    if (!used[i]) {
      out = append(
        out,
        "${sites[i].path}: allowlisted (${sites[i].reason}) but names no private token; delete the entry",
      )
    }
    i = i + 1
  }
  return PrivateScan{ files = acc.files, prose = acc.prose, hits = out }
}

// The scan over every tracked text file of the repo at `root`; `scratch` is a
// writable directory the caller removes.
export fn scanPrivateNames(root: string, scratch: string): PrivateScan {
  let acc = PrivateScan{ files = 0, prose = 0, hits = []string(0) }
  let paths = trackedTextFiles(root, scratch) catch e {
    acc.hits = append(acc.hits, "${root}: cannot list tracked files: ${e.message()}")
    return acc
  }
  let used = []bool(len(allowedSites()))
  for p of paths {
    acc = scanFile(acc, root, p, used)
  }
  return staleSites(acc, used)
}

// The token matcher against known-good and known-bad lines, one per forbidden
// token plus a case-folded one and a clean one, and a multi-line text that must
// yield one entry per offending line. Returns the failures.
fn tokenSelfTest(): int {
  let failed = 0
  for name of forbiddenNames() {
    if (forbiddenIn("see the ${name} repository") != name) {
      failed = failed + 1
    }
  }
  if (forbiddenIn("Built from BitLab output") != "bitlab") {
    failed = failed + 1
  }
  if (len(forbiddenIn("the website repository and bitlang.org")) != 0) {
    failed = failed + 1
  }
  if (len(textHits("p.md", "clean\nx hl-master y\nclean", forbiddenNames())) != 1) {
    failed = failed + 1
  }
  if (len(textHits("p.bit", "// smash #1 and .claude/x", forbiddenNames())) != 1) {
    failed = failed + 1
  }
  if (forbiddenIn("on MUSTAFA-DESKTOP-win over ssh") != "mustafa-desktop") {
    failed = failed + 1
  }
  return failed + wordBoundarySelfTest()
}

// A private name inside an ordinary word is not a leak; the name as its own
// token, at either end of a line, before punctuation, or in a path, is.
fn wordBoundarySelfTest(): int {
  let failed = 0
  for clean of ["smashing teddybea", "a smashed plate", "unsmash", "bitlabs"] {
    if (len(forbiddenIn(clean)) != 0) {
      failed = failed + 1
    }
  }
  for leak of [
    "use smash now",
    "smash.json",
    "smash",
    "(smash)",
    "smash_next",
    "Smash-tool",
    "x smashing smash",
  ] {
    if (forbiddenIn(leak) != "smash") {
      failed = failed + 1
    }
  }
  if (forbiddenIn("see x.claude/y") != ".claude/" || forbiddenIn("see .claude/y") != ".claude/") {
    failed = failed + 1
  }
  return failed
}

// The prose and allowlist classifiers. Returns the failures.
fn classifierSelfTest(): int {
  let failed = 0
  if (!isPublicProse("pkg/web/README.md") ||
    isPublicProse("pkg/web/docs/README.md") ||
    isPublicProse("pkg/web/static.bit")) {
    failed = failed + 1
  }
  if (allowedIndex("_tests_/bit/docsprivate/private.bit") < 0 ||
    allowedIndex("stdlib/path/path.bit") >= 0) {
    failed = failed + 1
  }
  return failed
}

// Both self-tests: 0 when the scanner is sound.
export fn privateNamesSelfTest(): int {
  return tokenSelfTest() + classifierSelfTest()
}

// The files the scan must read. Today's corpus is 7835 tracked text files, 199
// of them public prose; a listing that came back short would land far below.
const minScannedFiles: int = 7000

const minProseFiles: int = 190

// Run the self-test and the scan over `root`, print every finding, and return
// how many there were: 0 means no tracked text file names anything private.
export fn reportPrivateNames(root: string, scratch: string): int {
  let broken = privateNamesSelfTest()
  if (broken != 0) {
    eprint("docs: FAILED — the private-name scanner failed ${broken} self-test case(s)\n")
    return broken
  }
  let scan = scanPrivateNames(root, scratch)
  for h of scan.hits {
    eprint("docs: FAIL ${h} names a private repository, host or tool\n")
  }
  let low = 0
  if (scan.files < minScannedFiles || scan.prose < minProseFiles) {
    eprint("docs: FAILED — private-name scan read ${scan.files} file(s) (${scan.prose} prose), under the floors of ${minScannedFiles} (${minProseFiles})\n")
    low = 1
  }
  if (len(scan.hits) == 0 && low == 0) {
    print("docs: private-name scan ok — ${scan.files} file(s) read, ${scan.prose} of them public prose\n")
  }
  return len(scan.hits) + low
}
