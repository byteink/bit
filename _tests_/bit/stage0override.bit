// `./make test-stage0override` (#3118): regression coverage for the
// BIT_STAGE0_BIN bootstrap escape hatch (#1857) and fingerprint()'s
// override-hashing (#1863) — neither had any automated coverage.
// `grep -rln STAGE0_BIN _tests_/` found exactly one file,
// _tests_/bit/coldboot.bit, whose own header says it deliberately does NOT use
// the override ("using it here would defeat the point").
//
// The failure mode a build-succeeded check cannot see is the hatch being
// IGNORED — read but not honoured, or honoured but silently reusing a stale
// cache — because a green build looks identical in both worlds. So both
// checks below distinguish WHICH compiler actually ran/was hashed, never
// just whether a command exited 0.
//
// TWO ASSERTIONS, matching the two places #1857/#1863 touch:
//
//  1. THE HATCH IS HONOURED (scripts/stage0.sh's override branch). A wrapper
//     built under BIT_STAGE0_BIN=<X> must actually invoke X when run, not
//     silently fall back to the pinned stage0. Checked by comparing `bit
//     version` output three ways — the override wrapper's, X's own, and the
//     pinned stage0's own (all resolved live, never hardcoded, since the pin
//     moves) — rather than trusting the emitted script's text.
//
//  2. THE HATCH INVALIDATES THE CACHE ON CONTENT CHANGE
//     (tools/build/artifacts.bit's fingerprint(), #1863). The real #1857
//     recovery recipe reuses the SAME BIT_STAGE0_BIN path across two passes
//     while the FILE AT THAT PATH changes (pass 1 builds a fixed compiler;
//     pass 2 uses it) — so the test that matters is same path, changed
//     content, not merely a different path. Six `./make libbitrt` runs at
//     ONE FIXED override path, alternating its CONTENT (never its path)
//     between two real, byte-different, independently-built compiler
//     binaries (the tree's own bit-out/bin/bit, and the pinned stage0's own
//     wrapper), assert each content swap forces a rebuild and each repeat
//     settles back to "up to date".
//
// Deliberately NOT in gateSteps(): forces several real `./make libbitrt`
// relinks (three-target cross-compiles), same shape and same reason as
// _tests_/bit/stdlibrebuild.bit — not part of `test`, run explicitly.
import { env, envOr, exit } from "std/os"
import { readFile, writeFile } from "std/fs"
import { contains, parseInt } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// A `./make libbitrt` cross-compile of three targets is far cheaper than a
// full selfhost relink, but this gate forces three of them (plus three cheap
// "up to date" checks) in a row, so the same override applies. See
// _tests_/bit/coldboot.bit's `timeoutMs` for why `s <= 0` does not mean "block
// forever" here.
fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "600")) catch _ {
    600
  }
  if (s <= 0) {
    return 600000
  }
  return s * 1000
}

// Set unconditionally by this gate's own `Gate{}` entry
// (tools/build/gates.bit) — see _tests_/bit/coldboot.bit's `repoRoot` for why a
// "." fallback would be the wrong kind of quiet default here.
fn repoRoot(): string {
  let r = env("BIT_REPO")
  if (len(r) == 0) {
    panic("stage0override: BIT_REPO is not set — run this through `./make test-stage0override`")
  }
  return r
}

// Runs `script` through /bin/sh and returns its exit code. Negative returns
// are `osRunBounded`'s own mechanism channel (ABI.md §19), never a program's
// exit status, so each is a named panic — same convention as
// _tests_/bit/stdlibrebuild.bit's `shell`.
fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700: owner rwx only
    fail newError("stage0override: cannot make script executable: ${scriptPath}")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == -2) {
    panic("stage0override: TIMED OUT after ${ms}ms — a hang is a failure, not a stall")
  }
  if (code == -1) {
    panic("stage0override: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("stage0override: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}

// Runs `body` (one or more `sh` statements, the last of which is the command
// under test) with cwd=`root`, capturing stdout, stderr and the exit code to
// three separate files — never interleaved, because part 1 below parses an
// exact one-line value off stdout and scripts/stage0.sh's own header
// documents that everything BUT that line goes to stderr. The `{ ... }`
// group (not a subshell) keeps `$?` meaning the group's own last command.
fn runCapture(
  scratch: string,
  root: string,
  ms: int,
  tag: string,
  body: string,
): (int, string, string) {
  let outPath = "${scratch}/${tag}.out"
  let errPath = "${scratch}/${tag}.err"
  let codePath = "${scratch}/${tag}.code"
  let script = "#!/bin/sh\n" +
    "cd '${root}' || exit 90\n" +
    "{\n" +
    body +
    "\n} > '${outPath}' 2> '${errPath}'\n" +
    "echo $? > '${codePath}'\n" +
    "exit 0\n"
  let wrapperRc = shell("${scratch}/${tag}.sh", script, ms) catch e {
    panic("stage0override: ${e.message()}")
  }
  if (wrapperRc == 90) {
    panic("stage0override: cannot cd into ${root}")
  }
  if (wrapperRc != 0) {
    panic("stage0override: wrapper script '${tag}' exited ${wrapperRc}, which it never should")
  }
  let codeText = trimWs(
    readFile(codePath) catch e {
      panic("stage0override: cannot read ${codePath}: ${e.message()}")
      ""
    },
  )
  let code = parseInt(codeText) catch _ {
    panic("stage0override: ${codePath} did not contain a number: '${codeText}'")
    0 - 1
  }
  let out = readFile(outPath) catch ""
  let err = readFile(errPath) catch ""
  return code, out, err
}

fn runMake(
  scratch: string,
  root: string,
  ms: int,
  tag: string,
  envLines: string,
): (int, string, string) {
  return runCapture(scratch, root, ms, tag, envLines + "./make libbitrt")
}

// One copy's source and destination.
class CopySpec {
  src: string,
  dst: string,
}

fn copyTo(scratch: string, root: string, ms: int, tag: string, spec: CopySpec): bool {
  let (code, out, err) = runCapture(
    scratch,
    root,
    ms,
    tag,
    "cp '${spec.src}' '${spec.dst}' && chmod 755 '${spec.dst}'",
  )
  if (code != 0) {
    eprint(out)
    eprint(err)
    println("stage0override: FAIL — cp '${spec.src}' '${spec.dst}' exited ${code}, want 0")
    return false
  }
  return true
}

// `make: libbitrt` followed immediately by `make:   up to date`, printed by
// `stepLibbitrt`, and `make: libbitrt — up to date` printed by
// `printStepDone` once the step returns without doing real work — the exact
// (name, ran) pairing tools/build/main.bit uses to distinguish a
// fingerprint-matched skip from an actual rebuild.
fn containsUpToDate(out: string): bool {
  return contains(out, "make: libbitrt — up to date\n")
}

// Resolves the PINNED stage0 (no override) once and snapshots its wrapper's
// bytes into a scratch-owned file. This must happen before anything below
// calls scripts/stage0.sh again — default and override resolutions both
// write to the SAME cache path (bit-out/stage0/bit-oracle, scripts/stage0.sh
// itself), so a later call would silently overwrite what this one produced.
fn setupPinnedWrapper(scratch: string, root: string, ms: int): (string, string, bool) {
  let (code, out, err) = runCapture(scratch, root, ms, "resolve-pinned", "sh scripts/stage0.sh")
  if (code != 0) {
    eprint(err)
    println("stage0override: FAIL — `sh scripts/stage0.sh` (no override) exited ${code}, want 0")
    return "", "", false
  }
  let wrapperPath = trimWs(out)
  if (len(wrapperPath) == 0) {
    println("stage0override: FAIL — `sh scripts/stage0.sh` printed nothing on stdout")
    return "", "", false
  }
  let copyPath = "${scratch}/pinned-wrapper"
  if (!copyTo(scratch, root, ms, "snapshot-pinned", CopySpec{ src: wrapperPath, dst: copyPath })) {
    return "", "", false
  }
  let (vCode, vOut, vErr) = runCapture(scratch, root, ms, "pinned-version", "'${copyPath}' version")
  if (vCode != 0) {
    eprint(vErr)
    println("stage0override: FAIL — `${copyPath} version` (the pinned stage0) exited ${vCode}, want 0")
    return "", "", false
  }
  return copyPath, trimWs(vOut), true
}

// Assertion 1: BIT_STAGE0_BIN is honoured, not silently ignored.
fn checkOverrideHonoured(
  scratch: string,
  root: string,
  ms: int,
  devBin: string,
  pinnedVersion: string,
): bool {
  let (devVCode, devVOut, devVErr) = runCapture(
    scratch,
    root,
    ms,
    "dev-version",
    "'${devBin}' version",
  )
  if (devVCode != 0) {
    eprint(devVErr)
    println("stage0override: FAIL — `${devBin} version` exited ${devVCode}, want 0")
    return false
  }
  let devVersion = trimWs(devVOut)
  if (devVersion == pinnedVersion) {
    println("stage0override: FAIL — the tree's own compiler (${devBin}) reports the same version as the pinned stage0 ('${devVersion}'); this gate needs two observably different binaries")
    return false
  }

  let (rCode, rOut, rErr) = runCapture(
    scratch, root, ms, "resolve-override",
    "BIT_STAGE0_BIN='${devBin}'\nexport BIT_STAGE0_BIN\nsh scripts/stage0.sh",
  )
  if (rCode != 0) {
    eprint(rErr)
    println("stage0override: FAIL — `BIT_STAGE0_BIN=${devBin} sh scripts/stage0.sh` exited ${rCode}, want 0")
    return false
  }
  let overrideWrapper = trimWs(rOut)
  if (len(overrideWrapper) == 0) {
    println("stage0override: FAIL — the override resolution printed nothing on stdout")
    return false
  }

  let (ovCode, ovOut, ovErr) = runCapture(
    scratch,
    root,
    ms,
    "override-version",
    "'${overrideWrapper}' version",
  )
  if (ovCode != 0) {
    eprint(ovErr)
    println("stage0override: FAIL — `${overrideWrapper} version` exited ${ovCode}, want 0")
    return false
  }
  let overrideVersion = trimWs(ovOut)

  if (overrideVersion != devVersion) {
    println("stage0override: FAIL — BIT_STAGE0_BIN=${devBin}'s wrapper reports '${overrideVersion}', want '${devVersion}' (the override binary's own version) — the hatch is not invoking the override")
    return false
  }
  if (overrideVersion == pinnedVersion) {
    println("stage0override: FAIL — BIT_STAGE0_BIN's wrapper reports the PINNED stage0's version ('${pinnedVersion}'); the override is being silently ignored")
    return false
  }
  println("stage0override: PASS (1/2) — BIT_STAGE0_BIN=${devBin} is honoured: its wrapper reports '${overrideVersion}', the pinned stage0 reports '${pinnedVersion}'")
  return true
}

// scratch/root/ms, bundled for the two halves of checkFingerprintHashing
// below (they otherwise stay under the 5-param limit without it).
class Env {
  scratch: string,
  root: string,
  ms: int,
}

// The override path and its BIT_STAGE0_BIN env line, constant across every
// `./make libbitrt` run in checkFingerprintHashing.
class OverrideCtx {
  path: string,
  env: string,
}

// The first half of Assertion 2: baseline, then two `./make libbitrt` runs
// with the override's file CONTENT changed at the SAME path — proves
// fingerprint() hashes bytes, not merely presence/path (#1863).
fn checkFingerprintChanges(
  env: Env,
  devBin: string,
  pinnedWrapperCopy: string,
  oc: OverrideCtx,
): bool {
  let (c0, o0, e0) = runMake(env.scratch, env.root, env.ms, "libbitrt-baseline", "")
  if (c0 != 0) {
    eprint(e0)
    println("stage0override: FAIL — baseline `./make libbitrt` exited ${c0}, want 0")
    return false
  }
  if (!containsUpToDate(o0)) {
    eprint(o0)
    println("stage0override: FAIL — baseline `./make libbitrt` did not report \"up to date\"; run `./make libbitrt` once before this gate")
    return false
  }

  if (!copyTo(env.scratch, env.root, env.ms, "cp-content-a", CopySpec{ src: devBin, dst: oc.path })) {
    return false
  }
  let (c1, o1, e1) = runMake(env.scratch, env.root, env.ms, "libbitrt-override-a", oc.env)
  if (c1 != 0) {
    eprint(e1)
    println("stage0override: FAIL — `BIT_STAGE0_BIN=${oc.path} ./make libbitrt` (content A) exited ${c1}, want 0")
    return false
  }
  if (containsUpToDate(o1)) {
    eprint(o1)
    println("stage0override: FAIL — `./make libbitrt` reported \"up to date\" the first time BIT_STAGE0_BIN was set; the override is not part of the rebuild fingerprint")
    return false
  }

  if (!copyTo(
    env.scratch,
    env.root,
    env.ms,
    "cp-content-b",
    CopySpec{ src: pinnedWrapperCopy, dst: oc.path },
  )) {
    return false
  }
  let (c2, o2, e2) = runMake(env.scratch, env.root, env.ms, "libbitrt-override-b", oc.env)
  if (c2 != 0) {
    eprint(e2)
    println("stage0override: FAIL — `BIT_STAGE0_BIN=${oc.path} ./make libbitrt` (content B, same path) exited ${c2}, want 0")
    return false
  }
  if (containsUpToDate(o2)) {
    eprint(o2)
    println("stage0override: FAIL — `./make libbitrt` reported \"up to date\" after BIT_STAGE0_BIN's file CONTENT changed at the SAME path — fingerprint() is not hashing the override's bytes (#1863)")
    return false
  }
  return true
}

// The second half: settle on content B, revert (unset BIT_STAGE0_BIN), and
// settle again — proves the fingerprint invalidates and recovers correctly
// in both directions.
fn checkFingerprintSettles(env: Env, overrideEnv: string): bool {
  let (c3, o3, e3) = runMake(
    env.scratch,
    env.root,
    env.ms,
    "libbitrt-override-b-settled",
    overrideEnv,
  )
  if (c3 != 0) {
    eprint(e3)
    println("stage0override: FAIL — the settle `./make libbitrt` under content B exited ${c3}, want 0")
    return false
  }
  if (!containsUpToDate(o3)) {
    eprint(o3)
    println("stage0override: FAIL — `./make libbitrt` did not settle back to \"up to date\" with BIT_STAGE0_BIN's content unchanged — the fingerprint is non-deterministic")
    return false
  }

  let (c4, o4, e4) = runMake(env.scratch, env.root, env.ms, "libbitrt-reverted", "")
  if (c4 != 0) {
    eprint(e4)
    println("stage0override: FAIL — `./make libbitrt` exited ${c4} after unsetting BIT_STAGE0_BIN, want 0")
    return false
  }
  if (containsUpToDate(o4)) {
    eprint(o4)
    println("stage0override: FAIL — `./make libbitrt` reported \"up to date\" right after unsetting BIT_STAGE0_BIN; reverting away from the override did not invalidate the cache")
    return false
  }

  let (c5, o5, e5) = runMake(env.scratch, env.root, env.ms, "libbitrt-settled", "")
  if (c5 != 0) {
    eprint(e5)
    println("stage0override: FAIL — the final settle `./make libbitrt` exited ${c5}, want 0")
    return false
  }
  if (!containsUpToDate(o5)) {
    eprint(o5)
    println("stage0override: FAIL — `./make libbitrt` did not settle back to \"up to date\" after reverting BIT_STAGE0_BIN")
    return false
  }
  return true
}

// Assertion 2: fingerprint() hashes the override's CONTENT, not just its
// presence or its path (#1863) — six `./make libbitrt` runs, one fixed
// override path throughout.
fn checkFingerprintHashing(
  scratch: string,
  root: string,
  ms: int,
  devBin: string,
  pinnedWrapperCopy: string,
): bool {
  let env = Env{ scratch: scratch, root: root, ms: ms }
  let overridePath = "${scratch}/oracle-override"
  let overrideEnv = "BIT_STAGE0_BIN='${overridePath}'\nexport BIT_STAGE0_BIN\n"

  if (!checkFingerprintChanges(
    env,
    devBin,
    pinnedWrapperCopy,
    OverrideCtx{ path: overridePath, env: overrideEnv },
  )) {
    return false
  }
  if (!checkFingerprintSettles(env, overrideEnv)) {
    return false
  }

  println("stage0override: PASS (2/2) — fingerprint() invalidates the libbitrt cache when BIT_STAGE0_BIN's content changes at a fixed path, and settles correctly in both directions")
  return true
}

fn main() {
  let ms = timeoutMs()
  let root = repoRoot()
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  let scratch = "${tmp}/bit-stage0override-${uuidFormat(uuidV4())}"
  mkdirScratch(scratch)

  let devBin = "${root}/bit-out/bin/bit"

  let (pinnedWrapperCopy, pinnedVersion, setupOk) = setupPinnedWrapper(scratch, root, ms)
  if (!setupOk) {
    // `exit()` does not run pending defers (#3694, same shape as #3677) —
    // call teardown explicitly on every exit path and on PASS.
    teardown(scratch, ms)
    exit(1)
  }

  let phase1Ok = checkOverrideHonoured(scratch, root, ms, devBin, pinnedVersion)
  let phase2Ok = checkFingerprintHashing(scratch, root, ms, devBin, pinnedWrapperCopy)

  // Best-effort convergence back to the default (no-override) fingerprint
  // regardless of the verdict above — the cache is self-correcting, so this
  // is cleanliness, not a correctness requirement: any later step that
  // depends on `libbitrt` rebuilds correctly on its own even if this is
  // skipped.
  let (finalCode, finalOut, finalErr) = runCapture(
    scratch,
    root,
    ms,
    "final-restore",
    "./make libbitrt",
  )
  if (finalCode != 0) {
    eprint(finalOut)
    eprint(finalErr)
    eprint("stage0override: WARNING — best-effort final `./make libbitrt` (no override) exited ${finalCode}\n")
  }

  if (!phase1Ok || !phase2Ok) {
    teardown(scratch, ms)
    exit(1)
  }
  teardown(scratch, ms)
  println("stage0override: PASS — BIT_STAGE0_BIN is honoured, and fingerprint() invalidates the libbitrt cache when the override's content changes at a fixed path (#1863)")
}

fn mkdirScratch(scratch: string) {
  let script = "#!/bin/sh\nmkdir -p '${scratch}'\n"
  let rc = shell("${scratch}.sh", script, 5000) catch e {
    panic("stage0override: cannot create ${scratch}: ${e.message()}")
    0 - 1
  }
  if (rc != 0) {
    panic("stage0override: mkdir -p ${scratch} exited ${rc}")
  }
}

// std/fs has no recursive remove, so the scratch tree goes the way it came —
// same reason _tests_/bit/coldboot.bit's teardown does.
fn teardown(scratch: string, ms: int) {
  shell("${scratch}/rm.sh", "#!/bin/sh\nrm -rf '${scratch}'\n", ms) catch _ {
    return
  }
}

fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}
