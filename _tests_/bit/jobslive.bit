// _tests_/bit/jobslive.bit — `./make test-package-jobs-live` (#6082, epic
// #4023, #7320, #7436). Provisions its OWN throwaway PostgreSQL, MySQL 8 AND
// MariaDB 11 containers (the same pattern as `redislive.bit`, #6021, and `ormlive.bit`):
// `docker run --rm -d`, readiness polled with `pg_isready` / `mysqladmin
// ping` / `mariadb-admin ping`, each URL handed in turn as argv to `_tests_/bit/jobslive/main.bit`
// (run from a generated scratch project, see `writeScratchProject` below),
// then always removed. `main.bit` runs the same `Store`/`Locker` conformance
// suite (`_tests_/bit/jobslive/conformance.bit`) and the same scheduler proofs
// against every engine; the gate fails if any fails. `pkg/jobs`'s
// `interface Job` declares a `static` requirement (#6091).
//
// IMAGE: `postgres:18.6` (the newest 18.x patch as of 2026-09-28 per Docker
// Hub), pinned BY DIGEST so a retag upstream cannot silently change what
// this gate runs against:
//
//   postgres@sha256:5a5a84b19854a9ffaa54082c166ff4ec27473a361e496e5ea167f298f2da9722
//
// Re-verify before bumping:
//   curl -s https://hub.docker.com/v2/repositories/library/postgres/tags/18.6 | jq .digest
//
// MYSQL IS `mysql:8.4`, the tag pkg/mysql/docs/servers.md and `ormlive.bit`
// already pin (the current 8.4 LTS). The MySQL 5.7 refusal is not run live: the
// image has no arm64 build, and `pkg/jobs/sql.test.bit` proves the refusal
// against a server that reports `5.7.44`.
//
// MARIADB IS `mariadb:11.8`, the newest 11.x long-term-support series (11.4 is
// the previous one); MariaDB has had `SKIP LOCKED` since 10.6, the floor
// `pkg/jobs/sql.test.bit` proves against a server that reports `10.5.27`.
//
// THE IMAGE ITSELF IS KEPT, never deleted (redislive.bit's own header: not
// a one-off throwaway install, this gate depends on it every run). Only the
// CONTAINER is throwaway — see CLEANUP.
//
// WITHOUT DOCKER: no `docker` binary, or `docker info` failing three times —
// FAILS, naming the probe error and its duration (_tests_/bit/dockerlive/
// dockerlive.bit, #6353); only `BIT_LIVE_OPTIONAL=1` skips and exits 0.
//
// CLEANUP: the container is named with a run-local UUID and labelled
// `bit.jobs.live=1`; `cleanup()` removes it by name on every path this
// process controls. `sweepOrphans()` runs FIRST, force-removing any
// `bit.jobs.live=1` container an interrupted previous run left behind.
//
// ENV this harness reads (`./make test-package-jobs-live` sets the first
// two, tools/build/gatestable3.bit):
//   BIT_REPO   repo root, so pkg/jobs resolves regardless of cwd (required)
//   BIT_BIN    compiler under test    (default bit-out/bin/bit)
//   BIT_JOBS_LIVE_PG_URI, BIT_JOBS_LIVE_MYSQL_URI
//              optional, both or neither: run against these servers and start
//              no container (Docker is not needed). The databases must be empty
//              or hold only this suite's own tables; the URIs are the same
//              shape `main.bit` takes as argv.
//   BIT_JOBS_LIVE_MARIADB_URI
//              optional, only with the two above: a `mysql://` URI of a MariaDB
//              server, run as a third engine. Unset, the run says it skipped
//              MariaDB.

import { output } from "std/process"
import { env, envOr, exit } from "std/os"
import { mkdir, readFile, writeFile } from "std/fs"
import { contains, parseInt, split, trimSpace } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"
import { sleep, Millisecond } from "std/time"
import {
  dockerQuickTimeoutMs, dockerRunTimeoutMs, dockerRun, hostPort, relay, requireDocker,
  releaseDocker,
} from "./dockerlive"

const image: string = "postgres@sha256:5a5a84b19854a9ffaa54082c166ff4ec27473a361e496e5ea167f298f2da9722"
const myImage: string = "mysql:8.4"
const mariaImage: string = "mariadb:11.8"
const myRootPassword: string = "bit-jobs-live-pw"
const myDatabase: string = "jobs_live"
const pgUriVar: string = "BIT_JOBS_LIVE_PG_URI"
const myUriVar: string = "BIT_JOBS_LIVE_MYSQL_URI"
const mariaUriVar: string = "BIT_JOBS_LIVE_MARIADB_URI"
const runLabel: string = "bit.jobs.live=1"
// Pairs with `runLabel` on the container this run starts (see
// `startPostgres` below): the owning process's own pid, learned via
// `selfPid`'s `$PPID` trick. `sweepOrphans` removes a labelled container
// only when that pid is no longer alive, so a concurrent peer's still-running
// container is left alone (#6327).
const ownerLabelKey: string = "bit.live.owner"
const readyAttempts: int = 60
const readyDelayMs: int = 1000
const testRunTimeoutMs: int = 180000

fn repoRoot(): string {
  let r = env("BIT_REPO")
  if (len(r) == 0) {
    panic("jobslive: BIT_REPO is not set — run this through `./make test-package-jobs-live`")
  }
  return r
}

// This process's own pid, read off `/bin/sh -c 'echo $PPID'`: `std/process`
// execs every child directly with no shell (its own doc comment), so a
// freshly spawned `/bin/sh`'s parent is always this process itself.
fn selfPid(): int! {
  let r = output("/bin/sh", ["-c", "echo $PPID"], dockerQuickTimeoutMs)
  if (r.exitCode != 0) {
    fail newError("selfPid: /bin/sh exited ${r.exitCode}: ${trimSpace(r.stderr)}")
  }
  return parseInt(trimSpace(r.stdout))?
}

// Whether `pid` still names a live process — `kill -0` sends no signal, only
// checks existence (the same idiom tools/build/gatesexec.bit's watchdogs use).
fn pidAlive(pid: int): bool {
  let r = output("/bin/sh", ["-c", "kill -0 ${pid} 2>/dev/null"], dockerQuickTimeoutMs)
  return r.exitCode == 0
}

// The pid `id` recorded in its own `${ownerLabelKey}` label, or 0 if the
// label is missing or unparseable (a container from before this label
// existed, or a `docker inspect` hiccup) — `sweepOrphans` treats 0 as "no
// owner to protect", so such a container is always removed.
fn containerOwnerPid(bin: string, id: string): int {
  let r = output(
    bin,
    ["inspect", "-f", "{{index .Config.Labels \"${ownerLabelKey}\"}}", id],
    dockerQuickTimeoutMs,
  )
  if (r.exitCode != 0) {
    return 0
  }
  let pid = parseInt(trimSpace(r.stdout)) catch _ {
    return 0
  }
  return pid
}

// Force-removes every container this harness has ever labelled whose owner
// process is no longer alive, before this run starts its own. A concurrent
// peer's own still-running container carries a live owner pid and is left
// alone (#6327).
fn sweepOrphans(bin: string) {
  let r = output(bin, ["ps", "-aq", "--filter", "label=${runLabel}"], dockerQuickTimeoutMs)
  if (r.exitCode != 0) {
    return
  }
  for id of split(trimSpace(r.stdout), "\n") {
    if (id == "") {
      continue
    }
    let ownerPid = containerOwnerPid(bin, id)
    if (ownerPid > 0 && pidAlive(ownerPid)) {
      continue
    }
    output(bin, ["rm", "-f", id], dockerRunTimeoutMs)
  }
}

fn readyPoll(bin: string, name: string): bool {
  let i = 0
  while (i < readyAttempts) {
    let r = output(bin, ["exec", name, "pg_isready", "-U", "postgres"], dockerQuickTimeoutMs)
    if (r.exitCode == 0 && contains(r.stdout, "accepting connections")) {
      return true
    }
    sleep(readyDelayMs * Millisecond)
    i = i + 1
  }
  return false
}

fn startPostgres(bin: string, name: string, ownerLabel: string): int! {
  dockerRun(
    bin,
    [
      "run", "--rm", "-d", "--name", name, "--label", runLabel, "--label", ownerLabel,
      "-p", "127.0.0.1:0:5432", "-e", "POSTGRES_HOST_AUTH_METHOD=trust", image,
    ],
  )?
  let port = hostPort(bin, name, "5432/tcp")?
  if (!readyPoll(bin, name)) {
    fail newError("${name}: pg_isready never reported ready within ${readyAttempts * readyDelayMs}ms")
  }
  return port
}

// `-h127.0.0.1`: the image's first-boot server listens on its socket only, so a
// socket ping succeeds minutes before the TCP port the tests use does.
fn mysqlReady(bin: string, name: string): bool {
  let i = 0
  while (i < readyAttempts) {
    let r = output(
      bin,
      [
        "exec",
        name,
        "mysqladmin",
        "ping",
        "-h127.0.0.1",
        "-uroot",
        "-p${myRootPassword}",
        "--silent",
      ],
      dockerQuickTimeoutMs,
    )
    if (r.exitCode == 0) {
      return true
    }
    sleep(readyDelayMs * Millisecond)
    i = i + 1
  }
  return false
}

fn startMysql(bin: string, name: string, ownerLabel: string): int! {
  dockerRun(
    bin,
    [
      "run", "--rm", "-d", "--name", name, "--label", runLabel, "--label", ownerLabel,
      "-p", "127.0.0.1:0:3306", "-e", "MYSQL_ROOT_PASSWORD=${myRootPassword}",
      "-e", "MYSQL_DATABASE=${myDatabase}", myImage,
    ],
  )?
  let port = hostPort(bin, name, "3306/tcp")?
  if (!mysqlReady(bin, name)) {
    fail newError("${name}: mysqladmin ping never succeeded within ${readyAttempts * readyDelayMs}ms")
  }
  return port
}

// The MariaDB image ships `mariadb-admin`, not `mysqladmin`, and takes
// `MARIADB_*` environment variables; it listens on 3306 like MySQL.
fn mariadbReady(bin: string, name: string): bool {
  let i = 0
  while (i < readyAttempts) {
    let r = output(
      bin,
      [
        "exec",
        name,
        "mariadb-admin",
        "ping",
        "-h127.0.0.1",
        "-uroot",
        "-p${myRootPassword}",
        "--silent",
      ],
      dockerQuickTimeoutMs,
    )
    if (r.exitCode == 0) {
      return true
    }
    sleep(readyDelayMs * Millisecond)
    i = i + 1
  }
  return false
}

fn startMariadb(bin: string, name: string, ownerLabel: string): int! {
  dockerRun(
    bin,
    [
      "run", "--rm", "-d", "--name", name, "--label", runLabel, "--label", ownerLabel,
      "-p", "127.0.0.1:0:3306", "-e", "MARIADB_ROOT_PASSWORD=${myRootPassword}",
      "-e", "MARIADB_DATABASE=${myDatabase}", mariaImage,
    ],
  )?
  let port = hostPort(bin, name, "3306/tcp")?
  if (!mariadbReady(bin, name)) {
    fail newError("${name}: mariadb-admin ping never succeeded within ${readyAttempts * readyDelayMs}ms")
  }
  return port
}

fn cleanup(bin: string, names: []string) {
  for name of names {
    output(bin, ["rm", "-f", name], dockerRunTimeoutMs)
  }
  releaseDocker(bin)
}

// `_tests_/bit/jobslive/main.bit` imports "postgres" and "mysql" (real,
// first-party packages it needs to build a live connection), which `bit run`
// can only resolve through a `bit.lock` — pkg/jobs itself deliberately
// declares no such dependency (sql.bit takes a generic `std/sql.Pool`; only
// this LIVE proof needs concrete drivers). Rather than committing an absolute
// path into a checked-in `bit.lock` (wrong the moment the checkout moves),
// this builds a scratch project under `$TMPDIR` at run time with a
// path-based `bit.lock` pointing at THIS checkout's `pkg/jobs`,
// `pkg/postgres` and `pkg/mysql` — the identical mechanism `pkg/orm/bulk.test.bit`'s own
// live proof uses, generated here instead of escaped into a string literal
// so `main.bit` stays a normal, lintable, `bit check`-able file.
fn writeScratchProject(repo: string, dir: string): ()! {
  mkdir(dir)?
  let jobsAbs = "${repo}/pkg/jobs"
  let postgresAbs = "${repo}/pkg/postgres"
  let mysqlAbs = "${repo}/pkg/mysql"
  writeFile(
    "${dir}/bit.json",
    "{\"name\": \"jobslive\", \"dependencies\": {\"jobs\": \"${jobsAbs}\", \"postgres\": \"${postgresAbs}\", \"mysql\": \"${mysqlAbs}\"}}\n",
  )?
  writeFile(
    "${dir}/bit.lock",
    "{\"jobs\": {\"path\": \"${jobsAbs}\", \"requires\": {}}, \"postgres\": {\"path\": \"${postgresAbs}\", \"requires\": {}}, \"mysql\": {\"path\": \"${mysqlAbs}\", \"requires\": {}}}\n",
  )?
  let source = readFile("${repo}/_tests_/bit/jobslive/main.bit")?
  writeFile("${dir}/main.bit", source)?
  let conformance = readFile("${repo}/_tests_/bit/jobslive/conformance.bit")?
  writeFile("${dir}/conformance.bit", conformance)?
}

// Runs the live proof with the database URL as argv — `bit run` forwards
// argv (unlike `bit test`), so `main.bit` reads it via `args()[1]`.
fn runLiveTests(bitPath: string, repo: string, url: string, scratchDir: string): int {
  writeScratchProject(repo, scratchDir) catch e {
    eprint("jobslive: writeScratchProject: ${e.message()}\n")
    return 1
  }
  let r = output(
    "/usr/bin/env",
    [bitPath, "run", scratchDir, url],
    testRunTimeoutMs,
  )
  return relay(r, "jobslive", testRunTimeoutMs)
}

// One engine through `main.bit`, named in the output.
fn runEngine(bitPath: string, repo: string, label: string, url: string): int {
  print("jobslive: ${label}\n")
  let tmp = envOr("TMPDIR", "/tmp")
  return runLiveTests(bitPath, repo, url, "${tmp}/bit-jobs-live-${uuidFormat(uuidV4())}")
}

// Every engine in turn; a failure on one still runs the rest so one run
// reports all. `mariaUrl` is empty when no MariaDB server was given.
fn runAll(bitPath: string, repo: string, pgUrl: string, myUrl: string, mariaUrl: string): int {
  let rc = runEngine(bitPath, repo, "PostgreSQL", pgUrl)
  let myRc = runEngine(bitPath, repo, "MySQL", myUrl)
  if (rc == 0) {
    rc = myRc
  }
  if (len(mariaUrl) == 0) {
    print("jobslive: MariaDB skipped (${mariaUriVar} is not set)\n")
    return rc
  }
  let mariaRc = runEngine(bitPath, repo, "MariaDB", mariaUrl)
  if (rc == 0) {
    rc = mariaRc
  }
  return rc
}

fn main() {
  let repo = repoRoot()
  let bitPath = envOr("BIT_BIN", "${repo}/bit-out/bin/bit")

  // Both URIs set: run against those servers and provision nothing, so the
  // same harness serves a machine whose Docker is unusable (the servers are
  // started elsewhere and tunnelled in).
  let givenPg = env(pgUriVar)
  let givenMy = env(myUriVar)
  if (len(givenPg) > 0 && len(givenMy) > 0) {
    exit(runAll(bitPath, repo, givenPg, givenMy, env(mariaUriVar)))
    return
  }
  if (len(givenPg) > 0 || len(givenMy) > 0) {
    eprint("jobslive: set both ${pgUriVar} and ${myUriVar}, or neither\n")
    exit(1)
    return
  }

  let bin = requireDocker("jobslive")
  sweepOrphans(bin)
  let runId = uuidFormat(uuidV4())
  let pgName = "bit-jobs-live-pg-${runId}"
  let myName = "bit-jobs-live-mysql-${runId}"
  let mariaName = "bit-jobs-live-mariadb-${runId}"
  let names = [pgName, myName, mariaName]

  let pid = selfPid() catch e {
    eprint("jobslive: ${e.message()}\n")
    exit(1)
    return
  }
  let ownerLabel = "${ownerLabelKey}=${pid}"

  let pgPort = startPostgres(bin, pgName, ownerLabel) catch e {
    eprint("jobslive: ${e.message()}\n")
    cleanup(bin, names)
    exit(1)
    return
  }
  let myPort = startMysql(bin, myName, ownerLabel) catch e {
    eprint("jobslive: ${e.message()}\n")
    cleanup(bin, names)
    exit(1)
    return
  }

  let mariaPort = startMariadb(bin, mariaName, ownerLabel) catch e {
    eprint("jobslive: ${e.message()}\n")
    cleanup(bin, names)
    exit(1)
    return
  }

  let pgUrl = "postgres://postgres@127.0.0.1:${pgPort}/postgres"
  let myUrl = "mysql://root:${myRootPassword}@127.0.0.1:${myPort}/${myDatabase}"
  let mariaUrl = "mysql://root:${myRootPassword}@127.0.0.1:${mariaPort}/${myDatabase}"
  let rc = runAll(bitPath, repo, pgUrl, myUrl, mariaUrl)
  cleanup(bin, names)
  exit(rc)
}
