// _tests_/bit/releasesurface/shellrun.bit — this harness's policy for a child
// process that fails. The exec shape itself lives in `_tests_/bit/trampoline/`
// and is shared; see that file for why a generated script is never exec'd.
//
// #4691 put the trampoline here, because `releasesurface.bit` had no room left
// under the 800-line ceiling. #4702 censused the other harnesses, found three
// more above ten fresh execs per run, and moved the trampoline out to its own
// module rather than let a fourth copy exist. What stays here is the part that
// is genuinely this harness's: every mechanism value from `osRunBounded` is a
// bug in the harness, not a verdict about the stdlib surface, so each one
// panics with the step that produced it instead of being folded into an exit
// code the caller would have to disambiguate from a real breaking change.

import { runScript } from "../trampoline"

// Runs `script` and returns its exit code. `scriptPath` names the file the
// script is recorded under — never exec'd, see `../trampoline`.
fn shell(scriptPath: string, script: string, ms: int): int! {
  let code = runScript(scriptPath, script, ms)?
  if (code == -2) {
    panic("releasesurface: TIMED OUT after ${ms}ms running ${scriptPath}")
  }
  if (code == -1) {
    panic("releasesurface: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("releasesurface: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}
