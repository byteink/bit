// _tests_/bit/releasesurface/shellrun.bit — the one place this harness starts
// a child process, split out of releasesurface.bit (#4691), which had no room
// left under the 800-line hard ceiling for the trampoline this needs.
//
// THE DEFECT THIS CLOSES. `shell()` used to `writeFile` a script, `chmod 0700`
// it, and hand THAT PATH to `osRunBounded` — so every child was the FIRST
// `execve()` of a brand-new file. macOS tags every newly-created file with a
// `com.apple.provenance` xattr and the first exec of such a file pays a
// code-signature validation that is serialized SYSTEM-WIDE, not per process:
// exactly the tax #3778 found under `test-golden` (18m25s -> 2m29s, "the cause
// is macOS, not Bit"), whose fix was to stop exec'ing the generated file and
// hand it to an already-validated interpreter instead.
//
// This harness generates 291 single-use scripts per run (229 `--dump-tokens`,
// one per baseline stdlib file, plus 31x2 `bit doc --fields`), so it paid that
// tax 291 times and its wall clock tracked the box's exec queue rather than
// its own work. That is why one gate had three honest, irreconcilable
// readings: 2m3s idle, 4m5s inside a loaded full suite, 25m42s standalone
// beside five agents. Its actual compute, timed directly on the same box, is
// about 15s (229 `--dump-tokens` at ~6ms, 62 `bit doc --fields` at ~55ms).
//
// MEASURED, WITH NO BIT INVOLVED, on this box under fleet load 2026-09-09
// (`#!/bin/sh` + `exit 0` scripts, run from zsh):
//
//     30 execs of 30 FRESH scripts            did not finish in 600s
//     30 re-execs of ONE validated script     0.084s for all 30
//
// So the only file this harness ever execs is `trampoline.sh`, written once
// per scratch directory and re-exec'd unmodified for every child. Rewriting it
// would change its size and mtime, invalidate the kernel's cached validation
// for that inode and bring the whole tax straight back — hence the `exists`
// check rather than an unconditional write.
//
// WHY THE SCRIPT IS WRITTEN TWICE. `osRunBounded` takes a path and nothing
// else — no argv, no environment, no stdout capture — so the trampoline cannot
// be told which script to run; it always runs `cmd.sh`. The per-step named
// copy is kept because reading that scratch directory is how this gate's cost
// was diagnosed twice, and it is now the only record of what each child ran.
// Both are DATA: written, never chmod'd, never an exec target.

const shellMode: int = 448 // 0o700

// Directory holding `scriptPath` — every caller passes `${scratch}/<tag>.sh`,
// so this is the scratch directory itself. Byte scan rather than a std/strings
// helper: `split` would allocate a slice per call, on the hot path.
fn scriptDir(scriptPath: string): string {
  for (let i = len(scriptPath) - 1; i >= 0; i = i - 1) {
    if (scriptPath[i] == '/') {
      return scriptPath[:i]
    }
  }
  panic("releasesurface: script path has no directory: ${scriptPath}")
}

// Writes the trampoline once per scratch directory and returns its path.
fn trampolineFor(dir: string): string! {
  let path = "${dir}/trampoline.sh"
  if (exists(path)) {
    return path
  }
  writeFile(path, "#!/bin/sh\nexec /bin/sh \"${dir}/cmd.sh\"\n")?
  if (fsChmod(path, shellMode) != 0) {
    fail newError("cannot make the trampoline executable: ${path}")
  }
  return path
}

// Runs `script` and returns its exit code. `scriptPath` names the file the
// script is recorded under — never exec'd, see this file's header.
fn shell(scriptPath: string, script: string, ms: int): int! {
  let dir = scriptDir(scriptPath)
  let tramp = trampolineFor(dir)?
  writeFile(scriptPath, script)?
  writeFile("${dir}/cmd.sh", script)?
  let code = osRunBounded(tramp, ms)
  if (code == -2) {
    panic("releasesurface: TIMED OUT after ${ms}ms running ${scriptPath}")
  }
  if (code == -1) {
    panic("releasesurface: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("releasesurface: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}
