// _tests_/bit/releasesurface/fieldfixture.bit — the negative control for
// #7507, run by `main` before the real comparison.
//
// `bit doc --fields` reports every field, and `parseSymbols` keeps only the
// `export` ones, because a module-private field cannot be read from outside
// its module (E0046) and so its removal breaks no consumer. A gate that
// silently dropped ALL field lines would pass the same stdlib and be wrong,
// so this documents two tiny modules through the real `bit doc --fields` and
// checks both directions: the removed `export` field IS reported, the removed
// and the retyped private fields are NOT.

import { jsonParse, jsonDecArray, jsonDecObject, jsonDecMember, jsonDecString } from "std/json"
import { compare as fixtureCompare } from "std/strings"

const fixtureOld: string = "export class Box {\n" +
  "  export kept: int,\n" +
  "  export gone: int,\n" +
  "  hidden: int,\n" +
  "  retyped: int,\n" +
  "}\n"

const fixtureCur: string = "export class Box {\n" +
  "  export kept: int,\n" +
  "  retyped: string,\n" +
  "}\n"

// Writes `src` as the only file of a fresh module directory under `scratch`
// and documents it. Panics when it does not document: the fixture is ours.
fn fixtureSymbols(s: Setup, tag: string, src: string): []Symbol {
  let dir = "${s.scratch}/${tag}"
  mkdir(dir) catch e {
    panic("releasesurface fixture: cannot create ${dir}: ${e.message()}")
  }
  writeFile("${dir}/box.bit", src) catch e {
    panic("releasesurface fixture: cannot write ${dir}/box.bit: ${e.message()}")
  }
  let (text, ok) = docModule(
    s.bin,
    s.curStdlib,
    dir,
    DocRun{ scratch = s.scratch, tag = tag, ms = s.ms },
  )
  if (!ok) {
    panic("releasesurface fixture: ${dir} does not document under ${s.bin}")
  }
  return parseSymbols(text)
}

// Exits non-zero unless the fixture pair yields exactly one finding, the
// removal of the `export` field `Box.gone`.
fn checkFieldFixture(s: Setup) {
  let old = fixtureSymbols(s, "fx-old", fixtureOld)
  let cur = fixtureSymbols(s, "fx-cur", fixtureCur)
  let diffs = compareModule("fixture", old, cur)
  if (len(diffs) == 1 && diffs[0].name == "Box.gone" && diffs[0].change == "removed") {
    checkInventoryFixtures(s)
    return
  }
  eprint("FAIL releasesurface: field fixture expected exactly [Box.gone removed], got ${len(diffs)} finding(s):\n")
  for f of diffs {
    eprint("  ${f.name} ${f.change}: ${f.before} -> ${f.after}\n")
  }
  teardown(s.scratch, s.ms)
  exit(1)
}

// Four bounded files cross the former collector limit independently for
// root exports, registered methods, and own fields (#7917).
fn inventorySource(kind: string, file: int): string {
  let src = ""
  if (kind != "top") {
    src = "export class ${kind}${file} {\n"
  }
  for (let i = 0; i < 275; i = i + 1) {
    let n = 10000 + file * 275 + i
    src = src + inventoryDeclaration(kind, n)
  }
  if (kind != "top") {
    src = src + "}\n"
  }
  return src
}

fn inventoryDeclaration(kind: string, n: int): string {
  if (kind == "top") {
    return "export fn top${n}(): int { return 0 }\n"
  }
  if (kind == "Methods") {
    return "  export m${n}(): int { return 0 }\n"
  }
  if (n % 2 == 0) {
    return "  export f${n}: int,\n"
  }
  return "  hidden${n}: int,\n"
}

fn inventoryDirectory(s: Setup, kind: string): string {
  let dir = "${s.scratch}/inventory-${kind}"
  mkdir(dir) catch e {
    panic(e.message())
  }
  for (let i = 0; i < 4; i = i + 1) {
    writeFile("${dir}/part${i}.bit", inventorySource(kind, i)) catch e {
      panic(e.message())
    }
  }
  return dir
}

fn inventoryDoc(s: Setup, dir: string, tag: string, asJson: bool): string {
  let (text, ok) = docModule(
    s.bin,
    s.curStdlib,
    dir,
    DocRun{ scratch = s.scratch, tag = tag, ms = s.ms, asJson = asJson },
  )
  assert(ok, "inventory fixture ${tag} must typecheck and document")
  return text
}

// Include private lines only for the renderer-order comparison; the real
// release parser below must continue to exclude them from public surface.
fn inventoryAllPlain(text: string): []Symbol {
  let all = ""
  for line of split(text, "\n") {
    if (hasPrefix(line, "private ")) {
      line = line[8:]
    }
    all = all + line + "\n"
  }
  return parseSymbols(all)
}

fn inventoryJsonNames(text: string): []string {
  let value = jsonParse(text) catch e {
    panic(e.message())
  }
  let items = jsonDecArray(value, "", 0) catch e {
    panic(e.message())
  }
  let names = []string(0, len(items))
  for item of items {
    let entries = jsonDecObject(item, "", 1) catch e {
      panic(e.message())
    }
    let member = jsonDecMember(entries, "", "name") catch e {
      panic(e.message())
    }
    let name = jsonDecString(member, "name") catch e {
      panic(e.message())
    }
    names = append(names, name)
  }
  return names
}

fn checkInventoryOutput(s: Setup, kind: string, total: int, public: int, last: string) {
  let dir = inventoryDirectory(s, kind)
  let plain = inventoryDoc(s, dir, "inventory-${kind}-plain", false)
  let json = inventoryDoc(s, dir, "inventory-${kind}-json", true)
  let symbols = inventoryAllPlain(plain)
  let names = inventoryJsonNames(json)
  assert(
    len(symbols) == total,
    "${kind}: complete plain inventory expected ${total}, got ${len(symbols)}",
  )
  assert(
    len(names) == total,
    "${kind}: complete JSON inventory expected ${total}, got ${len(names)}",
  )
  assert(len(parseSymbols(plain)) == public, "${kind}: public inventory/private exclusion")
  assert(symbols[total - 1].name == last, "${kind}: terminal symbol ${last}")
  for (let i = 0; i < total; i = i + 1) {
    assert(symbols[i].name == names[i], "${kind}: plain/JSON order at ${i}")
    if (i > 0) {
      assert(fixtureCompare(names[i - 1], names[i]) < 0, "${kind}: strict name order at ${i}")
    }
  }
  print("PASS inventory ${kind}: ${total} total/${public} public, plain/JSON sorted\n")
}

fn checkInventoryFixtures(s: Setup) {
  checkInventoryOutput(s, "top", 1100, 1100, "top11099")
  checkInventoryOutput(s, "Methods", 1104, 1104, "Methods3.m11099")
  checkInventoryOutput(s, "Fields", 1104, 554, "Fields3.hidden11099")
}
