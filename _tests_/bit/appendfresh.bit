// _tests_/bit/appendfresh.bit — #6092 / epic #6160: with `BIT_APPEND_FRESH=1`,
// `append()` on a non-null slice returns an INDEPENDENT header instead of
// mutating the caller's own header in place
// (runtime/root/slicesappendfresh.bit's
// `rtSliceAppendFresh`/`rtSliceAppendStrFresh`, compiler/lowerappend.bit's
// `appendFreshEnabled`). Default OFF until the stage0 repin: the pinned
// 0.31.0 oracle emits the OLD in-place-mutate IR shape, so flipping the
// default would diverge every corpus file with a spare-capacity append from
// it (`scripts/selfhost-diffall.sh`).
//
// NOT PLACED IN _tests_/cases/: that corpus is compiled by the pinned stage0
// with a fixed environment, so a golden there could neither set the flag nor
// be compared against an oracle that predates the fix (same reason
// _tests_/bit/dcemethods.bit gives for BIT_DCE_METHODS).
//
// FOUR SHAPES, built and run with the flag OFF and ON:
//
//   shared: two independent `append()` results off one shared base, never
//           reassigned in between (#6092's own repro) — `x`/`y`/`z`'s
//           lengths must stay 2/2/3, never alias into 4/4/4.
//   safe:   `a = append(a, v)` self-assigned, nothing else ever reads `a`'s
//           pre-call state — correct under BOTH flag states (the fast path
//           this shape takes is sound either way), included as the control
//           that proves the harness is not just comparing "flag on wins".
//   alias:  `let alias = xs; xs = append(xs, v)` — `alias` must keep its own
//           length, never see `xs`'s later growth.
//   loop:   `while (...) { acc = append(acc, k); if (k == 4) { snap = acc } }`
//           — `snap` must freeze at iteration 4's length (5), never see
//           the loop's later growth to 10. This is the shape a REJECTED
//           stronger single-use check (compiler/optappend.bit's own history)
//           miscompiled; pinned here as a permanent regression guard too.
//
// Then #6164's escape shapes (`fixtureEscapes`): every way a header can
// reach a second holder while compiler/optappendown.bit's analysis lets its
// accumulator append in place — each must still read its own length.
// `fieldrmw` is the one the retired `useCounts == 1` rule miscompiled.
//
// Then #6179's field rows (`fixtureFields`), one class each because the
// field-ownership fact (compiler/optappendfield.bit) is per field: `owned`
// is a field whose every access obeys it, so its appends run in place;
// `snapshot` copies a header out of the field and reads it after a call
// that appends; `sharedstore` stores a header its local still reads. Each
// read-modify-write sits in a recursive helper, so no object is scalar
// replaced and the field is real memory. #6207 widened the fact: `ownedpop`
// pops `Log.items` and pushes again, still owned; `pop` keeps the popped
// header in a local that a later push would grow; `multiuse` stores the
// header it is about to append to into a second field.
//
// Then #6209's rows (`fixtureBorrow`), one per way its rules could hand an
// in-place append a header someone else still holds: `borrowchain` passes a
// loop accumulator to a callee that only reads it but hands it on to one
// that stores it (compiler/optappendborrow.bit's fixpoint must knock both
// out). `stashDeep`'s loop keeps it past the inliner's budget, so its store
// stays out of `probe`'s own body.
//
// Then #6210's rows (`fixtureCopies`): `escape` boxes `Esc.items`, a field
// whose appends run in place, into a `Wrap` and pushes again; the box must
// keep its own length, which it has only because the escape is handed a
// copy of the header (compiler/optappend.bit's `emitEscapeCopy`).
// `calleeappend` reads `Pair.items`, calls `pairNote`, which appends to the
// same field through `pairPush`, then appends to what it read: the callee's
// push is overwritten, never kept (compiler/optappendfield.bit's calm
// summary must see through `pairNote` to `pairPush`'s store).
//
// The flag-OFF output is asserted to be `wantOff` — the SAME wrong numbers
// #6092's own bug report gives — not just "whatever it happens to print":
// that is what proves the flag genuinely gates the fix rather than the
// fixture failing to exercise it at all.
//
// WIRED INTO `./make test` as `test-appendfresh` (tools/build/gates.bit,
// tools/build/defs.bit).

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"

const gateTimeoutMs: int = 120000

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("appendfresh: ${name} is not set — refusing to guess.\n")
    exit(2)
  }
  return v
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

// Helpers the escape shapes below call. `pushDeep` recurses so it is never
// spliced into `main`: its `append` stays on a PARAMETER, a header the
// caller still holds.
fn fixtureHelpers(): string {
  return "class Holder { items: []int }\n" +
    "\n" +
    "fn stash(h: Holder, s: []int) {\n" +
    "  h.items = s\n" +
    "}\n" +
    "\n" +
    "fn pushField(h: Holder, v: int) {\n" +
    "  h.items = append(h.items, v)\n" +
    "}\n" +
    "\n" +
    "fn report(tag: string, s: []int) {\n" +
    "  print(\"\${tag}: len=\${len(s)}\\n\")\n" +
    "}\n" +
    "\n" +
    "fn pushDeep(xs: []int, d: int): []int {\n" +
    "  if (d == 0) {\n" +
    "    return append(xs, 7)\n" +
    "  }\n" +
    "  return pushDeep(xs, d - 1)\n" +
    "}\n" +
    "\n" +
    "fn build(n: int): []int {\n" +
    "  let out = []int(0, 16)\n" +
    "  let k = 0\n" +
    "  while (k < n) {\n" +
    "    out = append(out, k)\n" +
    "    k = k + 1\n" +
    "  }\n" +
    "  return out\n" +
    "}\n" +
    "\n" +
    "class Log { items: []int }\n" +
    "class Snap { items: []int }\n" +
    "class Shared { items: []int }\n" +
    "\n" +
    "fn logPush(l: Log, v: int, d: int) {\n" +
    "  if (d == 0) {\n" +
    "    l.items = append(l.items, v)\n" +
    "    return\n" +
    "  }\n" +
    "  logPush(l, v, d - 1)\n" +
    "}\n" +
    "\n" +
    "fn snapPush(s: Snap, v: int, d: int) {\n" +
    "  if (d == 0) {\n" +
    "    s.items = append(s.items, v)\n" +
    "    return\n" +
    "  }\n" +
    "  snapPush(s, v, d - 1)\n" +
    "}\n" +
    "\n" +
    "fn sharedPush(s: Shared, v: int, d: int) {\n" +
    "  if (d == 0) {\n" +
    "    s.items = append(s.items, v)\n" +
    "    return\n" +
    "  }\n" +
    "  sharedPush(s, v, d - 1)\n" +
    "}\n" +
    "\n" +
    "class Stack { items: []int }\n" +
    "class Multi { items: []int, kept: []int }\n" +
    "\n" +
    "fn stackPush(s: Stack, v: int, d: int) {\n" +
    "  if (d == 0) {\n" +
    "    s.items = append(s.items, v)\n" +
    "    return\n" +
    "  }\n" +
    "  stackPush(s, v, d - 1)\n" +
    "}\n" +
    "\n" +
    "fn multiPush(m: Multi, v: int, d: int) {\n" +
    "  if (d == 0) {\n" +
    "    let h = m.items\n" +
    "    m.kept = h\n" +
    "    m.items = append(h, v)\n" +
    "    return\n" +
    "  }\n" +
    "  multiPush(m, v, d - 1)\n" +
    "}\n" +
    "\n" +
    "fn stashDeep(h: Holder, s: []int, d: int) {\n" +
    "  if (d > 0) {\n" +
    "    stashDeep(h, s, d - 1)\n" +
    "    return\n" +
    "  }\n" +
    "  let k = 0\n" +
    "  while (k < len(s)) {\n" +
    "    k = k + 1\n" +
    "  }\n" +
    "  h.items = s\n" +
    "}\n" +
    "\n" +
    "fn probe(s: []int, h: Holder, j: int, d: int): int {\n" +
    "  if (d > 0) {\n" +
    "    return probe(s, h, j, d - 1)\n" +
    "  }\n" +
    "  let n = 0\n" +
    "  let i = 0\n" +
    "  while (i < len(s)) {\n" +
    "    n = n + s[i]\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  if (j == 1) {\n" +
    "    stashDeep(h, s, 2)\n" +
    "  }\n" +
    "  return n\n" +
    "}\n" +
    "\n" +
    "class Esc { items: []int }\n" +
    "class Wrap { held: []int }\n" +
    "\n" +
    "fn escPush(e: Esc, v: int, d: int) {\n" +
    "  if (d == 0) {\n" +
    "    e.items = append(e.items, v)\n" +
    "    return\n" +
    "  }\n" +
    "  escPush(e, v, d - 1)\n" +
    "}\n" +
    "\n" +
    "fn escBox(e: Esc, d: int): Wrap {\n" +
    "  if (d > 0) {\n" +
    "    return escBox(e, d - 1)\n" +
    "  }\n" +
    "  let k = 0\n" +
    "  while (k < len(e.items)) {\n" +
    "    k = k + 1\n" +
    "  }\n" +
    "  return Wrap{ held = e.items }\n" +
    "}\n" +
    "\n" +
    "class Pair { items: []int }\n" +
    "\n" +
    "fn pairPush(p: Pair, v: int, d: int) {\n" +
    "  if (d == 0) {\n" +
    "    p.items = append(p.items, v)\n" +
    "    return\n" +
    "  }\n" +
    "  pairPush(p, v, d - 1)\n" +
    "}\n" +
    "\n" +
    "fn pairNote(p: Pair, v: int, d: int): int {\n" +
    "  if (d > 0) {\n" +
    "    return pairNote(p, v, d - 1)\n" +
    "  }\n" +
    "  let k = 0\n" +
    "  while (k < v) {\n" +
    "    k = k + 1\n" +
    "  }\n" +
    "  pairPush(p, k, 2)\n" +
    "  return k + 1\n" +
    "}\n" +
    "\n" +
    "fn pairTwice(p: Pair, v: int, d: int) {\n" +
    "  if (d == 0) {\n" +
    "    p.items = append(p.items, pairNote(p, v, 2))\n" +
    "    return\n" +
    "  }\n" +
    "  pairTwice(p, v, d - 1)\n" +
    "}\n" +
    "\n" +
    "fn deferShape() {\n" +
    "  let d = []int(0, 10)\n" +
    "  d = append(d, 1)\n" +
    "  defer report(\"defer\", d)\n" +
    "  let k = 0\n" +
    "  while (k < 3) {\n" +
    "    d = append(d, k)\n" +
    "    k = k + 1\n" +
    "  }\n" +
    "}\n" +
    "\n"
}

// #6164: each loop accumulator below hands its header to one more holder on
// iteration 1 (length 2) and keeps appending to 5. The holder must still read
// 2: a closure, a call argument, a field, a map value, a slice element, a
// sub-slice. Then the shapes that start from a header someone else holds: a
// returned slice appended twice, a parameter, a field read-modify-write, and
// a `defer` argument evaluated before the loop.
fn fixtureEscapes(): string {
  return "  let cacc = []int(0, 10)\n" +
    "  let lenAt: () => int = () => 0\n" +
    "  let facc = []int(0, 10)\n" +
    "  let hc = Holder{ items = []int(0) }\n" +
    "  let sacc = []int(0, 10)\n" +
    "  let hs = Holder{ items = []int(0) }\n" +
    "  let macc = []int(0, 10)\n" +
    "  let m = map<int, []int>()\n" +
    "  let lacc = []int(0, 10)\n" +
    "  let store = [][]int(0)\n" +
    "  let bacc = []int(0, 10)\n" +
    "  let sub: []int = []\n" +
    "  let j = 0\n" +
    "  while (j < 5) {\n" +
    "    cacc = append(cacc, j)\n" +
    "    facc = append(facc, j)\n" +
    "    sacc = append(sacc, j)\n" +
    "    macc = append(macc, j)\n" +
    "    lacc = append(lacc, j)\n" +
    "    bacc = append(bacc, j)\n" +
    "    if (j == 1) {\n" +
    "      let held = cacc\n" +
    "      lenAt = () => len(held)\n" +
    "      stash(hc, facc)\n" +
    "      hs.items = sacc\n" +
    "      m[1] = macc\n" +
    "      store = append(store, lacc)\n" +
    "      sub = bacc[0:len(bacc)]\n" +
    "    }\n" +
    "    j = j + 1\n" +
    "  }\n" +
    "  print(\"closure: acclen=\${len(cacc)} held=\${lenAt()}\\n\")\n" +
    "  print(\"call: acclen=\${len(facc)} stashed=\${len(hc.items)}\\n\")\n" +
    "  print(\"field: acclen=\${len(sacc)} stored=\${len(hs.items)}\\n\")\n" +
    "  print(\"map: acclen=\${len(macc)} value=\${len(m[1])}\\n\")\n" +
    "  print(\"slice: acclen=\${len(lacc)} elem=\${len(store[0])}\\n\")\n" +
    "  print(\"subslice: acclen=\${len(bacc)} sub=\${len(sub)}\\n\")\n" +
    "  let r = build(3)\n" +
    "  let r2 = append(r, 9)\n" +
    "  let r3 = append(r, 8)\n" +
    "  print(\"return: r=\${len(r)} r2=\${len(r2)} r3=\${len(r3)}\\n\")\n" +
    "  let p = []int(0, 4)\n" +
    "  p = append(p, 1)\n" +
    "  let q1 = pushDeep(p, 2)\n" +
    "  let q2 = pushDeep(p, 2)\n" +
    "  print(\"param: p=\${len(p)} q1=\${len(q1)} q2=\${len(q2)}\\n\")\n" +
    "  let fh = Holder{ items = []int(0, 4) }\n" +
    "  pushField(fh, 1)\n" +
    "  let before = fh.items\n" +
    "  pushField(fh, 2)\n" +
    "  print(\"fieldrmw: items=\${len(fh.items)} before=\${len(before)}\\n\")\n" +
    "  deferShape()\n"
}

// #6179's field rows; see this file's header.
fn fixtureFields(): string {
  return "  let lg = Log{ items = []int(0, 8) }\n" +
    "  let li = 0\n" +
    "  while (li < 5) {\n" +
    "    logPush(lg, li, 2)\n" +
    "    li = li + 1\n" +
    "  }\n" +
    "  print(\"owned: len=\${len(lg.items)} last=\${lg.items[4]}\\n\")\n" +
    "  let sn = Snap{ items = []int(0, 8) }\n" +
    "  snapPush(sn, 1, 2)\n" +
    "  let old = sn.items\n" +
    "  snapPush(sn, 2, 2)\n" +
    "  print(\"snapshot: items=\${len(sn.items)} old=\${len(old)}\\n\")\n" +
    "  let sh = Shared{ items = []int(0) }\n" +
    "  let mine = []int(0, 8)\n" +
    "  sh.items = mine\n" +
    "  sharedPush(sh, 1, 2)\n" +
    "  print(\"sharedstore: items=\${len(sh.items)} mine=\${len(mine)}\\n\")\n" +
    "  lg.items = lg.items[0:2]\n" +
    "  logPush(lg, 7, 2)\n" +
    "  print(\"ownedpop: len=\${len(lg.items)} last=\${lg.items[2]}\\n\")\n" +
    "  let st = Stack{ items = []int(0, 8) }\n" +
    "  stackPush(st, 1, 2)\n" +
    "  stackPush(st, 2, 2)\n" +
    "  let popped = st.items[0:1]\n" +
    "  st.items = popped\n" +
    "  stackPush(st, 9, 2)\n" +
    "  print(\"pop: items=\${len(st.items)} popped=\${len(popped)}\\n\")\n" +
    "  let mu = Multi{ items = []int(0, 8), kept = []int(0) }\n" +
    "  multiPush(mu, 1, 2)\n" +
    "  print(\"multiuse: items=\${len(mu.items)} kept=\${len(mu.kept)}\\n\")\n"
}

// #6209's rows; see this file's header.
fn fixtureBorrow(): string {
  return "  let bor = []int(0, 10)\n" +
    "  let hb = Holder{ items = []int(0) }\n" +
    "  let bj = 0\n" +
    "  let bsum = 0\n" +
    "  while (bj < 5) {\n" +
    "    bsum = bsum + probe(bor, hb, bj, 2)\n" +
    "    bor = append(bor, bj)\n" +
    "    bj = bj + 1\n" +
    "  }\n" +
    "  print(\"borrowchain: acclen=\${len(bor)} stashed=\${len(hb.items)} sum=\${bsum}\\n\")\n"
}

// #6210's rows; see this file's header.
fn fixtureCopies(): string {
  return "  let es = Esc{ items = []int(0, 8) }\n" +
    "  escPush(es, 1, 2)\n" +
    "  let w = escBox(es, 2)\n" +
    "  escPush(es, 2, 2)\n" +
    "  print(\"escape: items=\${len(es.items)} held=\${len(w.held)}\\n\")\n" +
    "  let pr = Pair{ items = []int(0, 8) }\n" +
    "  pairTwice(pr, 5, 2)\n" +
    "  print(\"calleeappend: len=\${len(pr.items)} last=\${pr.items[len(pr.items) - 1]}\\n\")\n"
}

fn fixtureSrc(): string {
  return fixtureHelpers() +
    "fn main() {\n" +
    "  let base = []int(0)\n" +
    "  base = append(base, 1)\n" +
    "  let x = append(base, 100)\n" +
    "  let y = append(base, 100)\n" +
    "  let z = append(y, 200)\n" +
    "  print(\"shared: xlen=\${len(x)} ylen=\${len(y)} zlen=\${len(z)} z2=\${z[2]}\\n\")\n" +
    "\n" +
    "  let a = []int(0, 4)\n" +
    "  a = append(a, 1)\n" +
    "  a = append(a, 2)\n" +
    "  print(\"safe: alen=\${len(a)} a0=\${a[0]} a1=\${a[1]}\\n\")\n" +
    "\n" +
    "  let xs = []int(0, 4)\n" +
    "  xs = append(xs, 1)\n" +
    "  let alias = xs\n" +
    "  xs = append(xs, 2)\n" +
    "  print(\"alias: xslen=\${len(xs)} aliaslen=\${len(alias)} alias0=\${alias[0]}\\n\")\n" +
    "\n" +
    "  let acc = []int(0, 10)\n" +
    "  let snap: []int = []\n" +
    "  let k = 0\n" +
    "  while (k < 10) {\n" +
    "    acc = append(acc, k)\n" +
    "    if (k == 4) {\n" +
    "      snap = acc\n" +
    "    }\n" +
    "    k = k + 1\n" +
    "  }\n" +
    "  print(\"loop: acclen=\${len(acc)} snaplen=\${len(snap)} snaplast=\${snap[len(snap) - 1]}\\n\")\n" +
    fixtureEscapes() +
    fixtureFields() +
    fixtureBorrow() +
    fixtureCopies() +
    "}\n"
}

// The correct answer, `BIT_APPEND_FRESH=1`: every header independent.
const wantFresh: string = "shared: xlen=2 ylen=2 zlen=3 z2=200\n" +
  "safe: alen=2 a0=1 a1=2\n" +
  "alias: xslen=2 aliaslen=1 alias0=1\n" +
  "loop: acclen=10 snaplen=5 snaplast=4\n" +
  "closure: acclen=5 held=2\n" +
  "call: acclen=5 stashed=2\n" +
  "field: acclen=5 stored=2\n" +
  "map: acclen=5 value=2\n" +
  "slice: acclen=5 elem=2\n" +
  "subslice: acclen=5 sub=2\n" +
  "return: r=3 r2=4 r3=4\n" +
  "param: p=1 q1=2 q2=2\n" +
  "fieldrmw: items=2 before=1\n" +
  "defer: len=1\n" +
  "owned: len=5 last=4\n" +
  "snapshot: items=2 old=1\n" +
  "sharedstore: items=1 mine=0\n" +
  "ownedpop: len=3 last=7\n" +
  "pop: items=2 popped=1\n" +
  "multiuse: items=1 kept=0\n" +
  "borrowchain: acclen=5 stashed=1 sum=10\n" +
  "escape: items=2 held=1\n" +
  "calleeappend: len=1 last=6\n"

// The bug, flag unset (byte-identical to main, task-6092's own report):
// shared aliases into 4/4/4, alias sees xs's later growth, snap sees the
// loop's later growth. `safe` is unaffected either way — see this file's
// header comment for why.
const wantOff: string = "shared: xlen=4 ylen=4 zlen=4 z2=100\n" +
  "safe: alen=2 a0=1 a1=2\n" +
  "alias: xslen=2 aliaslen=2 alias0=1\n" +
  "loop: acclen=10 snaplen=10 snaplast=9\n" +
  "closure: acclen=5 held=5\n" +
  "call: acclen=5 stashed=5\n" +
  "field: acclen=5 stored=5\n" +
  "map: acclen=5 value=5\n" +
  "slice: acclen=5 elem=5\n" +
  "subslice: acclen=5 sub=2\n" +
  "return: r=5 r2=5 r3=5\n" +
  "param: p=3 q1=3 q2=3\n" +
  "fieldrmw: items=2 before=2\n" +
  "defer: len=4\n" +
  "owned: len=5 last=4\n" +
  "snapshot: items=2 old=2\n" +
  "sharedstore: items=1 mine=1\n" +
  "ownedpop: len=3 last=7\n" +
  "pop: items=2 popped=2\n" +
  "multiuse: items=1 kept=1\n" +
  "borrowchain: acclen=5 stashed=5 sum=10\n" +
  "escape: items=2 held=2\n" +
  "calleeappend: len=2 last=6\n"

class CompilerEnv {
  bin: string,
  stdlib: string,
  libbitrt: string,
}

// Writes `body` as an executable `/bin/sh` script at `path` and runs it,
// bounded. Returns the script's exit code, or 2 when it cannot be written.
fn runScript(path: string, body: string): int {
  writeFile(path, "#!/bin/sh\n" + body) catch e {
    eprint("appendfresh: cannot write ${path}: ${e.message()}\n")
    return 2
  }
  if (fsChmod(path, 448) != 0) { // 0o700
    eprint("appendfresh: cannot chmod ${path}\n")
    return 2
  }
  return osRunBounded(path, gateTimeoutMs)
}

fn teardown(scratch: string) {
  let _ = runScript(scratch + "/rm.sh", "rm -rf " + shQuote(scratch) + "\n")
}

fn die(scratch: string, msg: string) {
  eprint("appendfresh: FAIL — ${msg}\n")
  teardown(scratch)
  exit(1)
}

// Builds `src` to `out` with `BIT_APPEND_FRESH` set to `flag` ("" is unset).
fn build(cc: CompilerEnv, scratch: string, src: string, out: string, flag: string) {
  let script = "BIT_STDLIB=" +
    shQuote(cc.stdlib) +
    "\nexport BIT_STDLIB\n" +
    "BIT_LIBBITRT=" +
    shQuote(cc.libbitrt) +
    "\nexport BIT_LIBBITRT\n" +
    "BIT_APPEND_FRESH=" +
    flag +
    "\nexport BIT_APPEND_FRESH\n" +
    "exec " +
    shQuote(cc.bin) +
    " build " +
    shQuote(src) +
    " -o " +
    shQuote(out) +
    " > /dev/null 2> " +
    shQuote(scratch + "/build.err") +
    "\n"
  if (runScript(scratch + "/build.sh", script) != 0) {
    let err = readFile(scratch + "/build.err") catch _ {
      ""
    }
    die(scratch, "fixture failed to build with BIT_APPEND_FRESH='${flag}':\n${err}")
  }
}

// Runs `bin` and dies unless it exits 0 having printed exactly `want`.
fn check(scratch: string, bin: string, label: string, want: string) {
  let outPath = scratch + "/run.out"
  let code = runScript(
    scratch + "/run.sh",
    "exec " + shQuote(bin) + " > " + shQuote(outPath) + " 2>&1\n",
  )
  let out = readFile(outPath) catch _ {
    ""
  }
  if (code != 0 || out != want) {
    die(scratch, "${label} ran wrong: exit=${code} (want 0)\n  want: ${want}\n  got:  ${out}")
  }
}

fn main() {
  let cc = CompilerEnv{
    bin = requiredEnv("BIT_BIN"),
    stdlib = requiredEnv("BIT_STDLIB"),
    libbitrt = requiredEnv("BIT_LIBBITRT"),
  }
  let scratch = envOr("TMPDIR", "/tmp") + "/bit-appendfresh-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("appendfresh: cannot create scratch directory ${scratch}: ${e.message()}\n")
    exit(2)
  }
  let src = scratch + "/fixture.bit"
  writeFile(src, fixtureSrc()) catch e {
    die(scratch, "cannot write ${src}: ${e.message()}")
  }
  let off = scratch + "/fixture_off"
  let on = scratch + "/fixture_on"
  build(cc, scratch, src, off, "")
  build(cc, scratch, src, on, "1")
  check(scratch, off, "flag off", wantOff)
  check(scratch, on, "BIT_APPEND_FRESH=1", wantFresh)
  teardown(scratch)
  print("PASS appendfresh: BIT_APPEND_FRESH=1 gives every header its own length; unset reproduces #6092's own bug exactly, proving the flag is what changed it\n")
}
