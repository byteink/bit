// _tests_/bit/appendfresh.bit — #6092 / epic #6160: with `BIT_APPEND_FRESH=1`,
// `append()` on a non-null slice returns an INDEPENDENT header instead of
// mutating the caller's own header in place (runtime/root/slicesappendfresh.bit's
// `rtSliceAppendFresh`/`rtSliceAppendStrFresh`, compiler/lowerappend.bit's
// `appendFreshEnabled`). Default OFF until the stage0 repin: the pinned
// 0.31.0 oracle emits the OLD in-place-mutate IR shape, so flipping the
// default would diverge every corpus file with a spare-capacity append from
// it (`scripts/selfhost-diffall.sh`).
//
// NOT PLACED IN _tests_/cases/: that corpus is compiled by the pinned stage0
// with a fixed environment, so a golden there could neither set the flag nor
// be compared against an oracle that predates the fix (same reason
// _tests_/bit/dcemethods.bit gives against the still-gated BIT_DCE_METHODS
// on the pinned stage0 oracle, #6191).
//
// FOUR SHAPES, built and run with the flag OFF and ON:
//
//   shared: two independent `append()` results off one shared base, never
//           reassigned in between (#6092's own repro) — `x`/`y`/`z`'s
//           lengths must stay 2/2/3, never alias into 4/4/4.
//   safe:   `a = append(a, v)` self-assigned, nothing else ever reads `a`'s
//           pre-call state — correct under BOTH flag states (the fast path
//           this shape takes is sound either way), included as the control
//           that proves the harness is not just comparing "flag on wins".
//   alias:  `let alias = xs; xs = append(xs, v)` — `alias` must keep its own
//           length, never see `xs`'s later growth.
//   loop:   `while (...) { acc = append(acc, k); if (k == 4) { snap = acc } }`
//           — `snap` must freeze at iteration 4's length (5), never see
//           the loop's later growth to 10. This is the shape a REJECTED
//           stronger single-use check (compiler/optappend.bit's own history)
//           miscompiled; pinned here as a permanent regression guard too.
//
// The flag-OFF output is asserted to be `wantOff` — the SAME wrong numbers
// #6092's own bug report gives — not just "whatever it happens to print":
// that is what proves the flag genuinely gates the fix rather than the
// fixture failing to exercise it at all.
//
// WIRED INTO `./make test` as `test-appendfresh` (tools/build/gates.bit,
// tools/build/defs.bit).

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"

const gateTimeoutMs: int = 120000

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("appendfresh: ${name} is not set — refusing to guess.\n")
    exit(2)
  }
  return v
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

fn fixtureSrc(): string {
  return "fn main() {\n" +
    "  let base = []int(0)\n" +
    "  base = append(base, 1)\n" +
    "  let x = append(base, 100)\n" +
    "  let y = append(base, 100)\n" +
    "  let z = append(y, 200)\n" +
    "  print(\"shared: xlen=\${len(x)} ylen=\${len(y)} zlen=\${len(z)} z2=\${z[2]}\\n\")\n" +
    "\n" +
    "  let a = []int(0, 4)\n" +
    "  a = append(a, 1)\n" +
    "  a = append(a, 2)\n" +
    "  print(\"safe: alen=\${len(a)} a0=\${a[0]} a1=\${a[1]}\\n\")\n" +
    "\n" +
    "  let xs = []int(0, 4)\n" +
    "  xs = append(xs, 1)\n" +
    "  let alias = xs\n" +
    "  xs = append(xs, 2)\n" +
    "  print(\"alias: xslen=\${len(xs)} aliaslen=\${len(alias)} alias0=\${alias[0]}\\n\")\n" +
    "\n" +
    "  let acc = []int(0, 10)\n" +
    "  let snap: []int = []\n" +
    "  let k = 0\n" +
    "  while (k < 10) {\n" +
    "    acc = append(acc, k)\n" +
    "    if (k == 4) {\n" +
    "      snap = acc\n" +
    "    }\n" +
    "    k = k + 1\n" +
    "  }\n" +
    "  print(\"loop: acclen=\${len(acc)} snaplen=\${len(snap)} snaplast=\${snap[len(snap) - 1]}\\n\")\n" +
    "}\n"
}

// The correct answer, `BIT_APPEND_FRESH=1`: every header independent.
const wantFresh: string = "shared: xlen=2 ylen=2 zlen=3 z2=200\n" +
  "safe: alen=2 a0=1 a1=2\n" +
  "alias: xslen=2 aliaslen=1 alias0=1\n" +
  "loop: acclen=10 snaplen=5 snaplast=4\n"

// The bug, flag unset (byte-identical to main, task-6092's own report):
// shared aliases into 4/4/4, alias sees xs's later growth, snap sees the
// loop's later growth. `safe` is unaffected either way — see this file's
// header comment for why.
const wantOff: string = "shared: xlen=4 ylen=4 zlen=4 z2=100\n" +
  "safe: alen=2 a0=1 a1=2\n" +
  "alias: xslen=2 aliaslen=2 alias0=1\n" +
  "loop: acclen=10 snaplen=10 snaplast=9\n"

class CompilerEnv {
  bin: string,
  stdlib: string,
  libbitrt: string,
}

// Writes `body` as an executable `/bin/sh` script at `path` and runs it,
// bounded. Returns the script's exit code, or 2 when it cannot be written.
fn runScript(path: string, body: string): int {
  writeFile(path, "#!/bin/sh\n" + body) catch e {
    eprint("appendfresh: cannot write ${path}: ${e.message()}\n")
    return 2
  }
  if (fsChmod(path, 448) != 0) { // 0o700
    eprint("appendfresh: cannot chmod ${path}\n")
    return 2
  }
  return osRunBounded(path, gateTimeoutMs)
}

fn teardown(scratch: string) {
  let _ = runScript(scratch + "/rm.sh", "rm -rf " + shQuote(scratch) + "\n")
}

fn die(scratch: string, msg: string) {
  eprint("appendfresh: FAIL — ${msg}\n")
  teardown(scratch)
  exit(1)
}

// Builds `src` to `out` with `BIT_APPEND_FRESH` set to `flag` ("" is unset).
fn build(cc: CompilerEnv, scratch: string, src: string, out: string, flag: string) {
  let script = "BIT_STDLIB=" +
    shQuote(cc.stdlib) +
    "\nexport BIT_STDLIB\n" +
    "BIT_LIBBITRT=" +
    shQuote(cc.libbitrt) +
    "\nexport BIT_LIBBITRT\n" +
    "BIT_APPEND_FRESH=" +
    flag +
    "\nexport BIT_APPEND_FRESH\n" +
    "exec " +
    shQuote(cc.bin) +
    " build " +
    shQuote(src) +
    " -o " +
    shQuote(out) +
    " > /dev/null 2> " +
    shQuote(scratch + "/build.err") +
    "\n"
  if (runScript(scratch + "/build.sh", script) != 0) {
    let err = readFile(scratch + "/build.err") catch _ {
      ""
    }
    die(scratch, "fixture failed to build with BIT_APPEND_FRESH='${flag}':\n${err}")
  }
}

// Runs `bin` and dies unless it exits 0 having printed exactly `want`.
fn check(scratch: string, bin: string, label: string, want: string) {
  let outPath = scratch + "/run.out"
  let code = runScript(
    scratch + "/run.sh",
    "exec " + shQuote(bin) + " > " + shQuote(outPath) + " 2>&1\n",
  )
  let out = readFile(outPath) catch _ {
    ""
  }
  if (code != 0 || out != want) {
    die(scratch, "${label} ran wrong: exit=${code} (want 0)\n  want: ${want}\n  got:  ${out}")
  }
}

fn main() {
  let cc = CompilerEnv{
    bin = requiredEnv("BIT_BIN"),
    stdlib = requiredEnv("BIT_STDLIB"),
    libbitrt = requiredEnv("BIT_LIBBITRT"),
  }
  let scratch = envOr("TMPDIR", "/tmp") + "/bit-appendfresh-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("appendfresh: cannot create scratch directory ${scratch}: ${e.message()}\n")
    exit(2)
  }
  let src = scratch + "/fixture.bit"
  writeFile(src, fixtureSrc()) catch e {
    die(scratch, "cannot write ${src}: ${e.message()}")
  }
  let off = scratch + "/fixture_off"
  let on = scratch + "/fixture_on"
  build(cc, scratch, src, off, "")
  build(cc, scratch, src, on, "1")
  check(scratch, off, "flag off", wantOff)
  check(scratch, on, "BIT_APPEND_FRESH=1", wantFresh)
  teardown(scratch)
  print("PASS appendfresh: BIT_APPEND_FRESH=1 gives every header its own length; unset reproduces #6092's own bug exactly, proving the flag is what changed it\n")
}
