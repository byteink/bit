// _tests_/bit/staticconst.bit — #5990: a bare top-level function used as a
// value lowers to one read-only closure cell per trampoline instead of a
// `gc_alloc` per evaluation (compiler/lowerstaticconst.bit's
// `staticConstEnabled`, unconditional since #6192, was gated behind a flag
// default ON since the 0.31.0 repin, #6000).
//
// Drives the CLI directly; BIT_BIN/BIT_STDLIB/BIT_LIBBITRT, no oracle
// involved.
//
// The fixture takes `twice` as a value twice and calls through both, passes
// `square` as an argument, and stores 2000 cells into heap objects while the
// loop allocates, so a collection runs with static cells reachable from
// traced fields. It runs twice, under the default collector and under
// `BIT_GC=stress` (set on the program only, never on the compiler), and both
// must print `wantOut`. The IR dump must name a static cell, so the flag-on
// path is proven taken rather than assumed.
//
// WIRED INTO `./make test` as `test-staticconst` (tools/build/gatestable2.bit,
// tools/build/defs.bit).

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"
import { contains } from "std/strings"

const gateTimeoutMs: int = 120000

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("staticconst: ${name} is not set — refusing to guess.\n")
    exit(2)
  }
  return v
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

fn fixtureSrc(): string {
  return "fn twice(x: i64): i64 {\n  return x * 2\n}\n\n" +
    "fn square(x: i64): i64 {\n  return x * x\n}\n\n" +
    "fn apply(f: (i64) => i64, x: i64): i64 {\n  return f(x)\n}\n\n" +
    "class Box {\n  f: (i64) => i64,\n  n: i64,\n}\n\n" +
    "fn pick(n: i64): (i64) => i64 {\n  if (n > 0) {\n    return twice\n  }\n  return square\n}\n\n" +
    "fn main() {\n" +
    "  let a = twice\n" +
    "  let b = twice\n" +
    "  let boxes = []Box(0)\n" +
    "  let i = 0\n" +
    "  while (i < 2000) {\n" +
    "    boxes = append(boxes, Box{ f = pick(i % 2), n = i })\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  let sum = 0\n" +
    "  for bx of boxes {\n    sum = sum + bx.f(3)\n  }\n" +
    "  print(\"a=\${a(21)} b=\${b(21)} same=\${a(21) == b(21)} apply=\${apply(square, 7)} sum=\${sum}\\n\")\n" +
    "}\n"
}

const wantOut: string = "a=42 b=42 same=true apply=49 sum=15000\n"

class CompilerEnv {
  bin: string,
  stdlib: string,
  libbitrt: string,
}

// Writes `body` as an executable `/bin/sh` script at `path` and runs it,
// bounded. Returns the script's exit code, or 2 when it cannot be written.
fn runScript(path: string, body: string): int {
  writeFile(path, "#!/bin/sh\n" + body) catch e {
    eprint("staticconst: cannot write ${path}: ${e.message()}\n")
    return 2
  }
  if (fsChmod(path, 448) != 0) { // 0o700
    eprint("staticconst: cannot chmod ${path}\n")
    return 2
  }
  return osRunBounded(path, gateTimeoutMs)
}

// The compiler's environment.
fn compilerEnv(cc: CompilerEnv): string {
  return "BIT_STDLIB=" +
    shQuote(cc.stdlib) +
    "\nexport BIT_STDLIB\n" +
    "BIT_LIBBITRT=" +
    shQuote(cc.libbitrt) +
    "\nexport BIT_LIBBITRT\n"
}

// Runs the built fixture with `gcEnv` prefixed to the program alone and
// returns its exit code and combined output.
fn runFixture(dir: string, gcEnv: string): (int, string) {
  let outPath = dir + "/run.out"
  let code = runScript(
    dir + "/run.sh",
    gcEnv + " exec " + shQuote(dir + "/fixture_out") + " > " + shQuote(outPath) + " 2>&1\n",
  )
  let out = readFile(outPath) catch _ {
    ""
  }
  return code, out
}

fn teardown(scratch: string) {
  let _ = runScript(scratch + "/rm.sh", "rm -rf " + shQuote(scratch) + "\n")
}

fn die(scratch: string, msg: string) {
  eprint("staticconst: FAIL — ${msg}\n")
  teardown(scratch)
  exit(1)
}

// Builds the fixture flag-on and dies unless the IR dump names a static
// closure cell, so a silently skipped flag cannot pass as a clean run.
fn buildFixture(cc: CompilerEnv, scratch: string, src: string) {
  let build = compilerEnv(cc) +
    "exec " +
    shQuote(cc.bin) +
    " build " +
    shQuote(src) +
    " -o " +
    shQuote(scratch + "/fixture_out") +
    " > /dev/null 2> " +
    shQuote(scratch + "/build.err") +
    "\n"
  if (runScript(scratch + "/build.sh", build) != 0) {
    let err = readFile(scratch + "/build.err") catch _ {
      ""
    }
    die(scratch, "fixture failed to build:\n${err}")
  }
  let dump = compilerEnv(cc) +
    "exec " +
    shQuote(cc.bin) +
    " --dump-ir " +
    shQuote(src) +
    " > " +
    shQuote(scratch + "/ir.txt") +
    " 2>&1\n"
  let ir = ""
  if (runScript(scratch + "/dump.sh", dump) == 0) {
    ir = readFile(scratch + "/ir.txt") catch _ {
      ""
    }
  }
  if (!contains(ir, "__bitfnv_")) {
    die(
      scratch,
      "the IR dump names no static closure cell (__bitfnv_), so the flag-on path was not taken",
    )
  }
}

fn main() {
  let cc = CompilerEnv{
    bin = requiredEnv("BIT_BIN"),
    stdlib = requiredEnv("BIT_STDLIB"),
    libbitrt = requiredEnv("BIT_LIBBITRT"),
  }
  let scratch = envOr("TMPDIR", "/tmp") + "/bit-staticconst-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("staticconst: cannot create scratch directory ${scratch}: ${e.message()}\n")
    exit(2)
  }
  let src = scratch + "/fixture.bit"
  writeFile(src, fixtureSrc()) catch e {
    die(scratch, "cannot write ${src}: ${e.message()}")
  }
  buildFixture(cc, scratch, src)
  for gcEnv of ["", "BIT_GC=stress"] {
    let (code, out) = runFixture(scratch, gcEnv)
    if (code != 0 || out != wantOut) {
      die(scratch, "ran wrong under '${gcEnv}': exit=${code}\n  want: ${wantOut}\n  got:  ${out}")
    }
  }
  teardown(scratch)
  print("PASS staticconst: a bare function value taken twice, passed as an argument and stored in 2000 heap objects runs through static closure cells, identically under the default collector and BIT_GC=stress\n")
}
