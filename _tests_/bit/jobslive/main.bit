// _tests_/bit/jobslive/main.bit — the live proof `_tests_/bit/jobslive.bit`
// runs against a throwaway PostgreSQL container (#6082, epic #4023). Not a
// `*.test.bit` file: it needs a real "postgres" dependency resolvable by
// `bit run`, which `jobslive.bit` supplies by copying this file into a
// scratch project with a path-based `bit.lock` (pkg/orm/bulk.test.bit's own
// `liveBulkProofSource` pattern, generated instead of a giant escaped
// string so this stays a normal, lintable, `bit check`-able file). The
// database URL arrives as `args()[1]` (`bit run` forwards argv; a plain
// import from pkg/jobs cannot read an env var meant for a different
// process's config).
//
// The same file runs against PostgreSQL, MySQL 8 and MariaDB 10.6+ (the scheme of the
// URL picks the driver; `mysql://` serves both MySQL and MariaDB, `requirePool`);
// a `redis://` URL runs redis.bit's proof of `RedisStore` and `RedisLocker`
// instead (#7321). `conformance.bit`'s `Store`/`Locker`
// suite runs first, then everything below. Proves, against a REAL server: N workers process every job exactly once
// (no double-processing), a crashed worker's claim is reclaimed once its
// visibility timeout elapses, `stop()` drains an in-flight job before
// returning, and three schedulers (three Queues, three pools, one
// SqlLocker each) enqueue every tick of one schedule exactly once
// while a stall they all suffer is caught up once between them. The
// schedulers read a hand-moved clock, so the proof takes seconds. It also proves that
// a whole fleet down across five ticks is caught up by each `Missed` policy
// when a NEW queue starts on the same database, and that the lease rows per
// schedule stay bounded. Prints `LIVE_PROOF_OK` and exits 0 only if every
// check passed.

import { args } from "std/os"
import { pool, Pool, Datasource, Value, asInt, asText } from "std/sql"
import { adapter as postgresAdapter } from "postgres"
import { adapter as mysqlAdapter } from "mysql"
import { hasPrefix } from "std/strings"
import { sleep, Millisecond } from "std/time"
import { AtomicI64 } from "std/sync"
import { now, Minute, Second } from "std/time"
import {
  SqlStore,
  SqlLocker,
  migrate,
  open,
  Options,
  ClaimedJob,
  Queue,
  Missed,
} from "jobs"

@job("live-echo") @json class LiveEchoJob {
  tag: string,
}

fn storeOn(db: Pool): SqlStore {
  return SqlStore(db) catch e {
    panic("SqlStore: ${e.message()}")
  }
}

fn lockerOn(db: Pool, keep: int): SqlLocker {
  return SqlLocker(db, keep = keep) catch e {
    panic("SqlLocker: ${e.message()}")
  }
}

fn requireStore(uri: string): SqlStore {
  let db = requirePool(uri)
  migrate(db) catch e {
    panic("migrate: ${e.message()}")
  }
  return storeOn(db)
}

fn proveConcurrency(store: SqlStore) {
  let q = open(store, Options{ workers = 4, pollInterval = 20 * Millisecond }) catch e {
    panic("open: ${e.message()}")
  }
  let processed = AtomicI64(0)
  q.register<LiveEchoJob>((job: LiveEchoJob) => {
    processed.add(1)
  }) catch e {
    panic("register: ${e.message()}")
  }
  let n = 8
  let i = 0
  while (i < n) {
    q.enqueue(LiveEchoJob{ tag = "concurrency" }) catch e {
      panic("enqueue: ${e.message()}")
    }
    i = i + 1
  }
  q.start()
  let waited = 0
  while (processed.load() < n && waited < 15000) {
    sleep(50 * Millisecond)
    waited = waited + 50
  }
  q.stop()
  if (processed.load() != n) {
    panic("LIVE PROOF FAILED: expected exactly ${n} completions, got ${processed.load()}")
  }
}

fn claimOrPanic(store: SqlStore, label: string): Option<ClaimedJob> {
  return store.claim(200 * Millisecond) catch e {
    panic("${label}: ${e.message()}")
  }
}

fn expectAttempts(claimed: Option<ClaimedJob>, want: int, label: string) {
  match (claimed) {
    None => panic("LIVE PROOF FAILED: ${label}: expected a claimable row")
    Some(cj) => {
      if (cj.attempts != want) {
        panic("LIVE PROOF FAILED: ${label}: attempts = ${cj.attempts}, expected ${want}")
      }
    }
  }
}

fn expectNotClaimable(claimed: Option<ClaimedJob>, label: string) {
  match (claimed) {
    None => {}
    Some(_) => panic("LIVE PROOF FAILED: ${label}: reclaimed before its visibility timeout elapsed")
  }
}

fn proveCrashReclaim(store: SqlStore) {
  store.enqueue("live-echo", "{\"tag\":\"reclaim\"}", 0, 5) catch e {
    panic("enqueue: ${e.message()}")
  }
  expectAttempts(claimOrPanic(store, "claim 1"), 1, "first claim")
  expectNotClaimable(claimOrPanic(store, "claim 2"), "immediate re-claim")
  sleep(300 * Millisecond)
  expectAttempts(claimOrPanic(store, "claim 3"), 2, "reclaim after timeout")
}

fn proveGracefulDrain(store: SqlStore) {
  let q = open(store, Options{ workers = 1, pollInterval = 20 * Millisecond }) catch e {
    panic("open: ${e.message()}")
  }
  let started = AtomicI64(0)
  let finished = AtomicI64(0)
  q.register<LiveEchoJob>((job: LiveEchoJob) => {
    started.store(1)
    sleep(300 * Millisecond)
    finished.store(1)
  }) catch e {
    panic("register: ${e.message()}")
  }
  q.enqueue(LiveEchoJob{ tag = "drain" }) catch e {
    panic("enqueue: ${e.message()}")
  }
  q.start()
  let waited = 0
  while (started.load() == 0 && waited < 10000) {
    sleep(20 * Millisecond)
    waited = waited + 20
  }
  if (started.load() != 1) {
    panic("LIVE PROOF FAILED: handler never started")
  }
  q.stop()
  if (finished.load() != 1) {
    panic("LIVE PROOF FAILED: stop() returned before the in-flight job finished")
  }
}

@job("live-tick") @json class LiveTickJob {
  tag: string,
}

// The clock every scheduler reads: real time at the start, then only what
// `advance` adds. `pause` yields for a moment so the three loops interleave.
class handClock {
  ns: AtomicI64

  nowNs(): int {
    return int(this.ns.load())
  }

  pause(d: int) {
    sleep(2 * Millisecond)
  }

  advance(d: int) {
    this.ns.add(i64(d))
  }
}

// A `SqlLocker` whose `serverNowNs` answers with the hand clock: these
// proofs move the clock hours past the real one, which the skew guard
// (#6368) would rightly refuse against the real database clock. The leases
// still go through the real PostgreSQL; `proveServerClock` and
// `proveSkewedClockFiresNothing` use the real `serverNowNs`.
class handLocker {
  inner: SqlLocker
  clock: handClock

  tryAcquire(key: string, holder: string, nowNs: int, expiresAt: int): bool! {
    let won = this.inner.tryAcquire(key, holder, nowNs, expiresAt)?
    return won
  }

  lastTick(key: string): int! {
    let last = this.inner.lastTick(key)?
    return last
  }

  window(): int {
    return this.inner.window()
  }

  serverNowNs(): int! {
    return this.clock.nowNs()
  }
}

fn scheduledQueue(uri: string, clock: handClock, id: string, missed: Missed): Queue {
  let db = requirePool(uri)
  let q = open(
    storeOn(db),
    Options{
      workers = 1, pollInterval = 10 * Millisecond, locker = handLocker{
        inner = lockerOn(db, 1024),
        clock = clock,
      },
      clock = clock, instanceId = id,
    },
  ) catch e {
    panic("open: ${e.message()}")
  }
  q.every(Minute, LiveTickJob{ tag = "tick" }, missed = missed) catch e {
    panic("every: ${e.message()}")
  }
  return q
}

fn tickRows(db: Pool): int {
  let rows = db.query("SELECT count(*) FROM bit_jobs WHERE name = 'live-tick'", []Value(0)) catch e {
    panic("count: ${e.message()}")
  }
  let has = rows.next() catch e {
    panic("count next: ${e.message()}")
  }
  if (!has) {
    panic("count: no row")
  }
  let n = asInt(rows.value(0)) catch e {
    panic("count value: ${e.message()}")
  }
  rows.close()
  return n
}

// Waits until the table holds `want` tick rows, then keeps watching a while
// longer: a duplicate enqueue from a slower scheduler would show up here.
fn expectTickRows(db: Pool, want: int, label: string) {
  let waited = 0
  while (tickRows(db) < want && waited < 15000) {
    sleep(20 * Millisecond)
    waited = waited + 20
  }
  sleep(300 * Millisecond)
  let got = tickRows(db)
  if (got != want) {
    panic("LIVE PROOF FAILED: ${label}: expected exactly ${want} tick rows, got ${got}")
  }
}

fn proveScheduledOnce(uri: string) {
  let clock = handClock{ ns = AtomicI64(i64(now().ns)) }
  let qs = [
    scheduledQueue(uri, clock, "sched-a", Missed.RunAll(10)),
    scheduledQueue(uri, clock, "sched-b", Missed.RunAll(10)),
    scheduledQueue(uri, clock, "sched-c", Missed.RunAll(10)),
  ]
  for q of qs {
    q.start()
  }
  let db = requirePool(uri)
  let tick = 1
  while (tick <= 3) {
    clock.advance(Minute)
    expectTickRows(db, tick, "tick ${tick}")
    tick = tick + 1
  }
  // A stall all three loops suffer at once: 4 ticks come due together and
  // RunAll must enqueue each once between the three instances.
  clock.advance(4 * Minute)
  expectTickRows(db, 7, "catch-up")
  for q of qs {
    q.stop()
  }
}

const downtimeKeep: int = 3

const downtimePeriod: int = 10 * Minute

// A queue on its own pool with a cron schedule every ten minutes (a period
// well over the one-minute missed threshold, #6358), over a locker that
// keeps only `downtimeKeep` lease rows per schedule.
fn cronQueue(uri: string, clock: handClock, id: string, missed: Missed): Queue {
  let db = requirePool(uri)
  let q = open(
    storeOn(db),
    Options{
      workers = 1, pollInterval = 10 * Millisecond,
      locker = handLocker{ inner = lockerOn(db, downtimeKeep), clock = clock },
      clock = clock, instanceId = id,
    },
  ) catch e {
    panic("open: ${e.message()}")
  }
  q.schedule("*/10 * * * *", LiveTickJob{ tag = "cron" }, missed = missed) catch e {
    panic("schedule: ${e.message()}")
  }
  return q
}

fn leaseRows(db: Pool): int {
  let rows = db.query("SELECT count(*) FROM bit_schedule_leases", []Value(0)) catch e {
    panic("lease count: ${e.message()}")
  }
  let has = rows.next() catch e {
    panic("lease count next: ${e.message()}")
  }
  if (!has) {
    panic("lease count: no row")
  }
  let n = asInt(rows.value(0)) catch e {
    panic("lease count value: ${e.message()}")
  }
  rows.close()
  return n
}

fn resetTicks(db: Pool) {
  db.exec("DELETE FROM bit_jobs WHERE name = 'live-tick'", []Value(0)) catch e {
    panic("reset jobs: ${e.message()}")
  }
  db.exec("DELETE FROM bit_schedule_leases", []Value(0)) catch e {
    panic("reset leases: ${e.message()}")
  }
}

// One tick fires, the queue stops, the clock moves `downNs`, and a NEW
// queue starts on the same database: it must enqueue `want` catch-up jobs.
fn proveDowntime(uri: string, missed: Missed, downNs: int, want: int, label: string) {
  let db = requirePool(uri)
  resetTicks(db)
  // Period-aligned, so advancing one period reaches the tick exactly (on
  // time) and `downNs` is measured from a tick.
  let clock = handClock{ ns = AtomicI64(i64(now().ns / downtimePeriod * downtimePeriod)) }
  let first = cronQueue(uri, clock, "down-a", missed)
  first.start()
  clock.advance(downtimePeriod)
  expectTickRows(db, 1, "${label}: the on-time tick")
  first.stop()
  clock.advance(downNs)
  let second = cronQueue(uri, clock, "down-b", missed)
  second.start()
  expectTickRows(db, 1 + want, "${label}: catch-up after downtime")
  second.stop()
  let rows = leaseRows(db)
  if (rows > downtimeKeep) {
    panic("LIVE PROOF FAILED: ${label}: ${rows} lease rows, expected at most ${downtimeKeep}")
  }
}

fn proveDowntimeCatchUp(uri: string) {
  // Five ticks missed, the newest 90 s late: over a minute, so missed.
  let long = 5 * downtimePeriod + 90 * Second
  proveDowntime(uri, Missed.RunOnce, long, 1, "RunOnce")
  proveDowntime(uri, Missed.Skip, long, 0, "Skip")
  // A restart 30 s after a tick is on time: Skip still enqueues it.
  proveDowntime(uri, Missed.Skip, downtimePeriod + 30 * Second, 1, "Skip, 30 s restart")
  proveDowntime(uri, Missed.RunAll(3), long, 3, "RunAll(3)")
  let rows = leaseRows(requirePool(uri))
  if (rows != downtimeKeep) {
    panic("LIVE PROOF FAILED: RunAll(3): expected exactly ${downtimeKeep} lease rows kept, got ${rows}")
  }
}

fn acquireOrPanic(
  locker: SqlLocker,
  key: string,
  holder: string,
  nowNs: int,
  label: string,
): bool {
  return locker.tryAcquire(key, holder, nowNs, nowNs + 1000) catch e {
    panic("${label}: ${e.message()}")
  }
}

fn leaseKeys(db: Pool): string {
  let rows = db.query("SELECT lease_key FROM bit_schedule_leases ORDER BY lease_key", []Value(0)) catch e {
    panic("lease keys: ${e.message()}")
  }
  let out = ""
  while (true) {
    let has = rows.next() catch e {
      panic("lease keys next: ${e.message()}")
    }
    if (!has) {
      break
    }
    let key = asText(rows.value(0)) catch e {
      panic("lease keys value: ${e.message()}")
    }
    out = out + key + " "
  }
  rows.close()
  return out
}

// One instance whose clock ran years ahead wins more ticks than the locker
// keeps. A correct clock's tick, won after them, is older by value but newer
// by arrival: it must keep its lease (a second holder must lose) and the
// table must stay bounded. `lastTick` keeps returning the newest tick.
fn proveFutureTicksDoNotEvictCurrent(uri: string) {
  let db = requirePool(uri)
  resetTicks(db)
  let locker = lockerOn(db, 2)
  let future = 4 * 365 * 24 * 3600 * 1000000000
  for i of [0, 1, 2] {
    if (!acquireOrPanic(locker, "probe@${future + i}", "a", 1, "future tick ${i}")) {
      panic("PROBE: the future tick ${i} was not won")
    }
  }
  let first = acquireOrPanic(locker, "probe@10", "a", 1000, "tick 10, first")
  let second = acquireOrPanic(locker, "probe@10", "b", 1500, "tick 10, second")
  if (!first || second) {
    panic("PROBE: tick 10 was won by a and then again by b (first=${first}, second=${second})")
  }
  let last = locker.lastTick("probe") catch e {
    panic("lastTick: ${e.message()}")
  }
  if (last != future + 2) {
    panic("PROBE: lastTick is ${last}, want the newest tick ${future + 2}")
  }
  let rows = leaseRows(db)
  if (rows > 3) {
    panic("PROBE: ${rows} lease rows for keep = 2, want at most 3 (${leaseKeys(db)})")
  }
  resetTicks(db)
}

// A slow instance catches up more old ticks than the locker keeps, after
// the newest tick was won. The newest tick must outlive them: `lastTick` is
// how a restarted fleet learns where it stopped.
fn proveNewestTickSurvivesLateCatchUp(uri: string) {
  let db = requirePool(uri)
  resetTicks(db)
  let locker = lockerOn(db, 2)
  for t of [100, 1, 2, 3, 4] {
    if (!acquireOrPanic(locker, "late@${t}", "a", 1, "tick ${t}")) {
      panic("PROBE: tick ${t} was not won")
    }
  }
  let last = locker.lastTick("late") catch e {
    panic("lastTick: ${e.message()}")
  }
  let rows = leaseRows(db)
  if (last != 100 || rows != 3) {
    panic("PROBE: lastTick is ${last} (want 100), ${rows} lease rows (want 3: ${leaseKeys(db)})")
  }
  resetTicks(db)
}

// `SqlLocker.serverNowNs` reads the real database clock: within 5 s of
// this host's (the harness and the server share one machine's clock).
fn proveServerClock(uri: string) {
  let locker = lockerOn(requirePool(uri), 1024)
  let server = locker.serverNowNs() catch e {
    panic("serverNowNs: ${e.message()}")
  }
  let skew = now().ns - server
  if (skew < 0) {
    skew = 0 - skew
  }
  if (skew > 5 * Second) {
    panic("PROBE: serverNowNs is ${skew} ns from the host clock, want within 5 s")
  }
}

// One instance whose clock is four years ahead of the real database clock
// fires nothing: no job row, no lease row (#6368).
fn proveSkewedClockFiresNothing(uri: string) {
  let db = requirePool(uri)
  resetTicks(db)
  let fourYears = 4 * 365 * 24 * 60 * Minute
  let clock = handClock{ ns = AtomicI64(i64(now().ns + fourYears)) }
  let q = open(
    storeOn(db),
    Options{
      workers = 1, pollInterval = 10 * Millisecond, locker = lockerOn(db, 1024),
      clock = clock, instanceId = "skewed",
    },
  ) catch e {
    panic("open: ${e.message()}")
  }
  q.every(Minute, LiveTickJob{ tag = "skew" }, missed = Missed.RunAll(10)) catch e {
    panic("every: ${e.message()}")
  }
  q.start()
  clock.advance(3 * Minute)
  expectTickRows(db, 0, "a clock 4 years ahead of the database")
  q.stop()
  let rows = leaseRows(db)
  if (rows != 0) {
    panic("LIVE PROOF FAILED: a skewed instance took ${rows} lease rows, want 0")
  }
}

// The driver the URL's scheme names: `mysql://` is MySQL, anything else
// PostgreSQL.
fn requirePool(uri: string): Pool {
  if (hasPrefix(uri, "mysql://")) {
    return pool(mysqlAdapter(), Datasource{ uri = uri }) catch e {
      panic("pool(mysql): ${e.message()}")
    }
  }
  return pool(postgresAdapter(), Datasource{ uri = uri }) catch e {
    panic("pool(postgres): ${e.message()}")
  }
}

// The shared suite, over two instances' stores and lockers on one database.
fn proveConformance(uri: string) {
  let db = requireStore(uri)
  runStoreConformance(db)
  resetTicks(requirePool(uri))
  runLockerConformance(lockerOn(requirePool(uri), 1024), lockerOn(requirePool(uri), 1024))
  resetTicks(requirePool(uri))
}

fn main() {
  let uri = args()[1]
  if (hasPrefix(uri, "redis://") || hasPrefix(uri, "rediss://")) {
    proveRedis(uri)
    print("LIVE_PROOF_OK")
    return
  }
  proveConformance(uri)
  proveConcurrency(requireStore(uri))
  proveCrashReclaim(requireStore(uri))
  proveGracefulDrain(requireStore(uri))
  proveScheduledOnce(uri)
  proveDowntimeCatchUp(uri)
  proveFutureTicksDoNotEvictCurrent(uri)
  proveNewestTickSurvivesLateCatchUp(uri)
  proveServerClock(uri)
  proveSkewedClockFiresNothing(uri)
  print("LIVE_PROOF_OK")
}
