// _tests_/bit/pollfree/exceptions.bit — the reviewed exception list for the
// poll-free gate (#3001's split of `_tests_/bit/pollfree.bit`, which crossed
// the 800-line limit once #3000 added group (f5)'s three deadline-bounded
// ABI wrappers).
//
// Sibling of `pollfree.bit` in the same directory module: no `import`, one
// shared scope. This file is pure data — no consts, no structs — and calls
// nothing beyond the builtin `append`, so the import-per-module trap
// (#2867's `rootabi` split hit it first: re-importing a name the module
// already imports elsewhere is `E0042 already declared in this scope`) does
// not apply here. `pollFreeExceptions()` below is what `pollfree.bit`'s
// `main` calls; the four `exceptions*()` tables it assembles, and every
// per-entry justification comment, moved here VERBATIM from the original
// file.

// ---------------------------------------------------------------------------
// The reviewed exception list — carried across VERBATIM from the deleted
// harness `rootabi_pollfree`, per-entry justifications intact. It was
// hand-audited and cannot be cheaply reconstructed.
// ---------------------------------------------------------------------------

// Functions under the covered subtrees that are deliberately NOT poll-free.
//
// EVERY ENTRY IS A CLAIM THAT THE FUNCTION HOLDS NO GC OBJECT AS A RAW
// ADDRESS, not merely that annotating it was inconvenient. Adding a line here
// is a review decision; the groups and their reasons:
//
// (a) `float{big,fmt,parse}.bit` and the two `floats.bit` wrappers — genuinely
//     MANAGED Bit code, allocating bignum limb arrays, digit buffers and
//     `string`s, so `@nosplit` (which forbids allocation) is not available to
//     them. #1658 gave them the property instead of the annotation: every raw
//     address now lives inside `packLowBytes`/`unpackToWords`, which ARE
//     `@nosplit`, and the outer bodies hold only managed values.
// (b) `rootconfig.bit`/`testindex.bit` — they read the kernel-supplied `envp`
//     block, so every address they carry is outside the heap. They could not be
//     annotated anyway: `len(<literal>)` is not `@nosplit`-callable.
// (c) `{darwin,linux}/boot.bit`'s boot machinery — must reach the scheduler,
//     thread and park layers and run user `main`, which E0075 would forbid. It
//     carries only raw kernel addresses (argv/envp/auxv, `mapPages` stacks).
// (d) `{darwin,linux}/time.bit`'s three ABI pins — every parameter and result
//     is a scalar `int`; no object crosses them in either direction.
// (g) `runtime/net/windows/**` (#3340, #3595) — the IOCP/overlapped-I/O
//     twin of (f). Same claim (b) as `runtime/net`'s park layer, plus a
//     second, INDEPENDENT reason several of these entries need: this
//     provider's engine (`../../sched/windows/poll.bit`) carries no
//     `@nosplit` function at all, so any caller that reaches
//     `pollClaimOp`/`pollAssociate`/`pollRegister`/`pollOp*` cannot be
//     `@nosplit` regardless of whether it allocates. See
//     `exceptionsNetWindows`'s own header for the four sub-groups.
//
// The one list is spelled across four functions ONLY because a single one
// exceeds `max-fn-lines`. The split follows the group boundaries above, so no
// entry is separated from the reasoning that admitted it; `pollFreeExceptions`
// is the whole list and is the only thing the gate reads.
// Appends every element of `more` to `out`, in order. Pulled out of
// pollFreeExceptions so each group there costs one call instead of one
// `for` loop — ten inlined loops pushed that function's own complexity
// over the limit with no branching logic of its own.
fn extendStrings(out: []string, more: []string): []string {
  for e of more {
    out = append(out, e)
  }
  return out
}

fn pollFreeExceptions(): []string {
  let out = []string(0)
  out = extendStrings(out, exceptionsFloatText())
  out = extendStrings(out, exceptionsEnvReaders())
  out = extendStrings(out, exceptionsBootMachinery())
  out = extendStrings(out, exceptionsClocks())
  out = extendStrings(out, exceptionsBootWait())
  out = extendStrings(out, exceptionsRandNetEngine())
  out = extendStrings(out, exceptionsNetAbi())
  out = extendStrings(out, exceptionsNetWindows())
  out = extendStrings(out, exceptionsNetTcpEngine())
  out = extendStrings(out, exceptionsNetUdpEngine())
  out = extendStrings(out, exceptionsAuxv())
  out = extendStrings(out, exceptionsSchedPollLinux())
  out = extendStrings(out, exceptionsSchedPollWindows())
  out = extendStrings(out, exceptionsSchedMachinery())
  out = extendStrings(out, exceptionsSchedSpawnThunk())
  return out
}

// (h) `runtime/auxv` (#5455 widened the scan here). Both entries touch only
// the kernel-supplied auxv table `auxv()` hands back at process entry (see
// `runtime/auxv/auxv.bit`'s own header) — plain `int` words at a raw kernel
// address, never a GC object, exactly the claim already made for group (b)'s
// envp readers above. `wordAt` has no loop at all; `getauxval`'s `while` is
// bounded by `MAX_ENTRIES` and holds only `table`/`i`/`entry`/`key`, all
// `int`, across it.
fn exceptionsAuxv(): []string {
  return [
    "auxv:wordAt",
    "auxv:getauxval",
  ]
}

// (i) `runtime/sched/linux/poll.bit` (#5467, epic #5458's linux sched
// sub-ticket). The darwin twin (#5466) needed no exceptions at all: every one
// of its six flagged declarations (`bufBytes`, `tsBytes`, `readU64`,
// `pollCreate`, `pollClose`, `pollDrain`) is `@nosplit` now, confirmed by
// `bit check runtime/sched/darwin` (exit 0) with a negative control (stripping
// `@nosplit` from `readU64` reproduces E0075 naming `pollDrain`). Linux's
// `bytesOf` and `pollClose` are the identical shape and are `@nosplit` too,
// same proof. The six entries below are blocked from `@nosplit` for a single,
// mechanically-confirmed reason this file's own header already documents at
// `eventDataOff`: `hostTarget()` is a real `bit_rt_host_target` runtime call,
// not on the compiler's `@nosplit` allowlist (unlike `syscall`, an inline
// trap), so any caller reaching it is refused E0075 regardless of whether it
// allocates. Forcing `@nosplit` onto `eventStride`/`eventDataOff` and
// re-running `bit check` reproduces exactly that: "nosplit function
// 'eventStride' calls 'hostTarget', which is not marked nosplit".
//
// THE PROPERTY HOLDS ANYWAY, which is what each entry claims:
//   - `eventStride`/`eventDataOff`: straight-line `if hostTarget()==0`
//     branches returning one of two int literals (12/16 or 4/8). No loop, no
//     allocation, no pointer ever formed — the only "state" is the return
//     value.
//   - `cacheEventDataOff`: writes `eventDataOff()`'s scalar answer into the
//     module-static `eventDataOffCache` (a `[1]i64`, not a GC object) through
//     the already-`@nosplit` `layoutBytes`/`writeU64`. Blocked only by its one
//     call to `eventDataOff`.
//   - `pollCreate`: `rc` is the scalar epoll fd `syscall` (an inline trap)
//     returns; the only other call is `cacheEventDataOff()`, priming the
//     cache before the descriptor is handed to any caller. No GC object at
//     any point.
//   - `pollDrainOne`: this file's own header at `eventDataOffNosplit`
//     documents the design already — `eventDataOff` stays the source of truth
//     here specifically because this is "the one caller that needs it
//     nosplit-safe" was never this function. `pollFd`/`timeoutMs` are raw
//     ints, `evBuf` is the module-static drain buffer, and `task` is a raw
//     scheduler address read out of the kernel's answer and handed straight
//     to the already-`@nosplit` `schedPollUnpark` — the same "raw scheduler
//     address, never a GC reference" shape `net/*:netAwaitReady` and its
//     siblings rest on. Blocked only by its calls to `eventStride`/
//     `eventDataOff`.
//   - `pollDrain`: calls `pollDrainOne` twice (read then write descriptor);
//     everything else it touches (`taskAt`, `schedPollTryEnter`,
//     `schedPollLeave`) is already `@nosplit`. `scPollFd`/`scPollFdWrite` are
//     raw ints and `s` is the raw scheduler address `taskAt` returns — no GC
//     object. Blocked transitively through `pollDrainOne`.
//
// None of these six ever suspends the calling task (unlike a genuine park):
// `pollDrain`'s own doc comment states the run loop always calls it with
// `timeoutMs` 0, non-blocking, specifically so a worker is never sitting in a
// syscall mid-collection. The hazard this gate polices — a raw GC address
// surviving a back-edge poll — does not arise here at all; only the
// annotation is unavailable, for the one documented, mechanically-confirmed
// reason above.
fn exceptionsSchedPollLinux(): []string {
  return [
    "sched/linux:eventStride",
    "sched/linux:eventDataOff",
    "sched/linux:cacheEventDataOff",
    "sched/linux:pollCreate",
    "sched/linux:pollDrain",
    "sched/linux:pollDrainOne",
  ]
}

// (j) `runtime/sched/windows/poll.bit` (#5468, epic #5458's windows sched
// sub-ticket — the IOCP poll engine, the largest single file in the epic).
// 22 of its 28 declarations are `@nosplit` above. These six share ONE
// mechanical blocker, distinct from linux's `hostTarget()` case: each reads
// or writes a fixed `[]i64` array (`ovWords`/`wsabufWords`/`taskOf`/
// `flagsScratch`/`bytesXfer`/`opKind`/`slotStatus`/`evBuf`) through a
// RUNTIME index — `slot`, from `scratchClaim()` or recovered from a
// completion packet's `lpOverlapped` address, or `i`, a bounded loop
// counter — never a literal or a masked literal, so
// `vNosplitArrayIndexInBounds` (compiler/validateattr.bit) cannot prove the
// access in range and E0075 refuses it, the same rule a slice base is
// refused by (#3107/#4270). Confirmed by a negative control: forcing
// `@nosplit` onto all six and re-running `bit check runtime/sched/windows`
// reproduces E0075 at all 31 indexing sites across these six functions, each
// pointing straight at the array element, e.g. "nosplit function
// 'pollRegister' may not allocate or reach a safepoint here" at
// `ovWords[slot * 4 + 0] = i64(0)`. The file's own pointer-arithmetic
// helpers (`ovPtr`/`wsabufPtr`/`flagsPtr`/`bytesXferPtr`/`ovBase`, all
// `@nosplit` above) exist for exactly this reason; this group is only the
// call sites that index the backing arrays directly instead.
//
// THE PROPERTY HOLDS ANYWAY, which is what each entry claims: every word
// these arrays hold is a plain `int`/`i64` — a slot index, a task's raw
// scheduler address (`taskOf`), a byte count, an NTSTATUS-shaped status
// word, or a zeroed OVERLAPPED/WSABUF field — never a GC object or a
// pointer into the GC heap. `taskOf[slot]` is the identical "raw scheduler
// address, never a GC reference" shape `net/*:netAwaitReady` (g1) and
// linux's `pollDrainOne` (i) already rest on; `pollRegister`/`pollClaimOp`/
// `pollFinishSlot`/`pollDrain` hold nothing else across the
// WSARecv/WSASend/GetQueuedCompletionStatusEx calls that could poll.
// `pollOpBytes`/`pollOpStatus` are pure scalar reads out of the same pool,
// called by `../../net/windows` (#3340) only AFTER the task is woken, never
// across a poll themselves.
fn exceptionsSchedPollWindows(): []string {
  return [
    "sched/windows:pollRegister",
    "sched/windows:pollClaimOp",
    "sched/windows:pollOpBytes",
    "sched/windows:pollOpStatus",
    "sched/windows:pollFinishSlot",
    "sched/windows:pollDrain",
  ]
}

// (k) `runtime/sched/` worker/grow/task machinery, platform-independent
// (#5469, epic #5458's completion ticket — the one that also adds the
// `sched` `Root{}` entry below). Four declarations, each blocked from
// `@nosplit` for the SAME reason, confirmed by reading the transitive callee
// each one reaches and, for `schedStartWorker`, by this file's own header
// comment at `./grow.bit`'s `schedMaybeGrow` naming it explicitly: a call
// THROUGH A VALUE. `schedStartWorker` (`./worker.bit`) invokes
// `launch.startFn(...)`, the caller-supplied platform `threadStart` function
// value; `schedMaybeGrow` (`./grow.bit`) calls `schedStartWorker` itself;
// `schedWorkerRun` (`./workerrun.bit`) calls `schedFindWorkIdle`, which takes
// `nowFn`/`pollFn` as function values and calls them directly; and
// `schedFindWorkIdle` (`./workerfind.bit`) is that callee. SPEC §10.3.1 rules
// out a call through a value unconditionally (`vNosplitCall`,
// compiler/validateattr.bit: "callee must be a bare Ident") — restructuring
// cannot change this, since accepting a platform thread-start recipe or a
// clock/poller seam AS a function value is the whole point of each (see
// `./grow.bit`'s own header: "starting a thread is irreducibly not
// `@nosplit`", and `./workerfind.bit`'s: "a call through a value is E0075 in
// a `@nosplit` body").
//
// THE PROPERTY HOLDS ANYWAY. `schedStartWorker` holds only `s`/`launch`'s
// fields (`entry`/`argArea`/`doneArea`/`handleArea`, four raw pointers into
// caller-owned arrays) and `i`/`block`/`done`/`h`, all plain `int`s derived
// from them — `launch: WorkerLaunch` is a plain field bundle crossing a
// module edge (`./grow.bit`'s own header), never constructed with a managed
// payload. `schedMaybeGrow` adds nothing beyond forwarding the same `launch`
// unchanged. `schedFindWorkIdle` holds `w`/`s`, the worker/scheduler raw
// block addresses every already-`@nosplit` sibling in this module holds the
// same way (`schedFindWork`, `schedWorkPending`), plus `now`/`addr`/
// `chanWoken`/`t`, all `int`. `schedWorkerRun` holds `w`/`s`/`backoff`/`n`,
// identically raw, across its call into `schedWorkerStep` (`@nosplit` above)
// and `schedFindWorkIdle`. None of the four ever allocates or holds a GC
// object — the only thing E0075 refuses is the shape of the call, not
// anything about what crosses it.
fn exceptionsSchedMachinery(): []string {
  return [
    "sched:schedStartWorker",
    "sched:schedMaybeGrow",
    "sched:schedFindWorkIdle",
    "sched:schedWorkerRun",
  ]
}

// (a) managed float text — see `runtime/root/floats.bit`'s SEAM 5a block.
//
// #3067 added `decUnderscoreOk`/`hexUnderscoreOk` to this group: each takes
// the same MANAGED `[]byte` its caller (`parseBits`/`parseHexBits`, already
// listed below) already holds and reads two neighboring bytes from it. No
// raw GC address is ever formed — the slice reference itself is what stays
// live. They cannot be `@nosplit` for a purely mechanical reason: indexing a
// slice lowers to `rt_call slice_get`, and E0075's Index case admits only a
// fixed-array base, never a slice — so the annotation is refused regardless
// of whether the body is actually poll-free. `isDecDigit`, their sibling
// helper, takes a `byte` by value with no indexing and IS `@nosplit`
// (mechanically proven, not reviewed).
fn exceptionsFloatText(): []string {
  return [
    "root:decUnderscoreOk",
    "root:hexUnderscoreOk",
    "root:bigLimbs",
    "root:bigNew",
    "root:bigSetU64",
    "root:bigNorm",
    "root:bigCopy",
    "root:bigCmp",
    "root:bigAdd",
    "root:bigSub",
    "root:bigMulSmall",
    "root:bigMulAddSmall",
    "root:bigShl",
    "root:bigShr1",
    "root:bigBitLen",
    "root:bigIsZero",
    "root:bigMulPow10",
    "root:fmtMaxDigits",
    "root:fmtBits",
    "root:dragon4",
    "root:highTest",
    "root:render",
    "root:zeros",
    "root:u64BitLen",
    "root:floorDiv",
    "root:parseMaxDigits",
    "root:parseBits",
    "root:assembleBits",
    "root:hexDigitVal",
    "root:parseHexBits",
    "root:roundShiftRight",
    "root:infBits",
    "root:rtStringFromFloat",
    "root:rtParseFloat",
  ]
}

// (b) envp readers, (c) boot machinery, (d) clocks and sleep.
// (b) envp readers — no heap object in play.
fn exceptionsEnvReaders(): []string {
  return [
    "root:gcEnvValuePtr",
    // rootWidthsOk (#3874) — compares `gcState`/`heapBlock`'s declared array
    // lengths against the `gcWords`/`heapWords` consts they claim to be sized
    // by. Mechanically cannot be `@nosplit`: `len()` on a fixed-size array is
    // barred from a `@nosplit` body by SPEC §10.3.1 even though it lowers to
    // a compile-time `ConstInt` with no call at all (#3974 tracks lifting
    // that restriction). THE CLAIM: it holds no GC object at all, as a raw
    // address or otherwise — its only inputs are two array lengths and two
    // integer consts, all resolved at compile time, and its only operation
    // is two `==` comparisons. Every caller of `rootInit` (all three
    // platforms' `boot`, already listed in group (c) below) calls this
    // first and refuses to boot on a mismatch.
    "root:rootWidthsOk",
    "root:gcEnvKeyMatch",
    "root:gcCstrEq",
    "root:gcCstrUsize",
    "root:gcEnvEnabled",
    "root:gcEnvStress",
    "root:gcEnvMinTrigger",
    "root:gcEnvGrowthPct",
    "root:gcEnvMarkStack",
    "root:gcEnvWorkers",
    // #4313's explicit-`BIT_WORKERS` detector — same claim as `gcEnvWorkers`
    // right above it: only `gcEnvValuePtr`'s `envp`-block pointer and
    // `gcCstrUsize`'s parsed `int` are in play, no heap object either way.
    "root:gcEnvWorkersExplicit",
    "root:gcEnvVerbose",
    // #5441's `BIT_GC_ALLOCCACHE` reader — same claim as every
    // `gcEnv*` entry above it: only `gcEnvValuePtr`'s `envp`-block
    // pointer and two `gcCstrEq` comparisons are in play, no heap
    // object at all, and it runs once from `rootConfigureFromEnv`
    // before any Bit allocation exists.
    "root:gcEnvAllocCache",
    "root:rootConfigureFromEnv",
    "root:rootEnvVerbose",
    "root:rootEnvMarkStack",
    "root:rootEnvWorkers",
    // #4313's pinned wrapper for `gcEnvWorkersExplicit`, same reason as
    // `rootEnvWorkers` immediately above.
    "root:rootEnvWorkersExplicit",
    "root:testIndexParse",
    "root:rtTestIndex",
  ]
}

