// §11.5 atomics must access exactly the pointee's width, never the value
// operand's own lowered width (#2742).
//
// Shipped 0.1.10 violated this on one path: a module-level `const` fed to
// `atomicStore`/`atomicCmpxchg` is INLINED at the use site (compiler/
// lowerdriver.bit), and that path once dropped the const's declared type, so
// an untyped literal defaulted to i64 and the backend (which reads the
// emitted access width off the VALUE operand, never the pointee — compiler/
// lowerprim.bit's `lowerAtomic`) emitted a 64-bit `stlr x`/CAS through a
// 32-bit pointer. The stray 4 bytes landed on whatever sits next in memory.
//
// `compiler/lowerprim.bit:assertAtomicOperandWidth` now asserts this at
// COMPILE time — the assert IS the primary defense, and it panics (`bit
// build` exits non-zero) the moment the widths disagree, regardless of
// target or optimization level. This gate is the independent, EXECUTION-level
// check: it does not trust the assert, and does not care why a width
// mismatch would happen — it runs the exact historical shape (a typed i32
// module const, not a local, since a local is never inlined) and reads back
// the NEIGHBOURING memory a too-wide store/CAS would have clobbered. A gate
// that shells out to `objdump` would be architecture- and toolchain-specific
// (GNU vs LLVM objdump, three targets); a gate that reads the array back
// after running the compiled program is not, and runs correctly under
// `scripts/x64gate.sh`/`scripts/arm64gate.sh` on the OTHER two backends this
// bug hit identically (#2742's own machine-code proof: 38 sites, same count
// on aarch64-macos, aarch64-linux, x86_64-linux).
//
// Run it from the repository root:
//     ./bit-out/bin/bit run _tests_/bit/atomicwidth.bit
// `BIT_SELF_EXE` overrides which `bit` is exercised.
import { env, envOr, exit } from "std/os"
import { exists, mkdir, readFile, remove, writeFile } from "std/fs"
import { parseInt } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

class Run { code: int, out: string, err: string }

class Tally { checks: int, failures: int }

fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "300")) catch _ {
    300
  }
  if (s <= 0) {
    return 300000
  }
  return s * 1000
}

// Runs `script` through /bin/sh and returns its exit code. Negative returns are
// `osRunBounded`'s mechanism channel, never a program exit status, so each one is
// a named panic rather than a value any assertion could consume.
fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    fail newError("atomicwidth: cannot make script executable: ${scriptPath}")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == -2) {
    panic("atomicwidth: TIMED OUT after ${ms}ms running ${scriptPath}")
  }
  if (code == -1) {
    panic("atomicwidth: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("atomicwidth: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}

// The `bit` under test. `BIT_SELF_EXE` wins; otherwise the dev-tree artifact
// relative to the directory this program was started in. Never returns "".
fn bitBinary(scratch: string, ms: int): string! {
  let explicit = env("BIT_SELF_EXE")
  if (len(explicit) > 0) {
    if (!exists(explicit)) {
      fail newError("atomicwidth: BIT_SELF_EXE=${explicit} does not exist")
    }
    return explicit
  }
  let cwdFile = "${scratch}/cwd.txt"
  let code = shell("${scratch}/pwd.sh", "#!/bin/sh\npwd > '${cwdFile}'\n", ms)?
  if (code != 0) {
    fail newError("atomicwidth: could not read the working directory (exit ${code})")
  }
  let cwd = trimWs(readFile(cwdFile)?)
  let candidate = "${cwd}/bit-out/bin/bit"
  if (!exists(candidate)) {
    fail newError("atomicwidth: no compiler at ${candidate}; run this from the repository root or set BIT_SELF_EXE")
  }
  return candidate
}

// Runs `bit run <file>` from `dir`. The wrapper always exits 0 and records
// the real status, so a missing code file is unmistakably "the compiler
// never ran" rather than a verdict a crash could be mistaken for.
fn runFixture(bit: string, dir: string, file: string, capDir: string, ms: int): Run! {
  let outPath = "${capDir}/out.txt"
  let errPath = "${capDir}/err.txt"
  let codePath = "${capDir}/code.txt"
  clear(outPath)
  clear(errPath)
  clear(codePath)
  let script = "#!/bin/sh\n" +
    "cd '${dir}' || exit 0\n" +
    "'${bit}' run '${file}' > '${outPath}' 2> '${errPath}'\n" +
    "echo $? > '${codePath}'\n" +
    "exit 0\n"
  let sh = shell("${capDir}/run.sh", script, ms)?
  if (sh != 0) {
    fail newError("atomicwidth: wrapper script exited ${sh}, which it never should")
  }
  if (!exists(codePath)) {
    fail newError("atomicwidth: no exit code was recorded for `bit run ${file}` — the run never happened")
  }
  let code = parseInt(trimWs(readFile(codePath)?))?
  return Run{ code: code, out: readFile(outPath)?, err: readFile(errPath)? }
}

fn clear(path: string) {
  if (exists(path)) {
    remove(path) catch _ {
      return
    }
  }
}

fn check(t: Tally, cond: bool, label: string) {
  t.checks = t.checks + 1
  if (!cond) {
    t.failures = t.failures + 1
    eprint("FAIL: ${label}\n")
  }
}

// The `atomicStore` shape (#2742's own repro): a typed module const inlined
// at the call site. Element 0 is written; a too-wide (64-bit) store would
// also zero element 1's live sentinel — the exact clobber the shipped bug
// produced. The verdict is computed and printed AS A LITERAL by the
// generated fixture itself, not interpolated by this harness: `${` cannot be
// written literally inside a Bit string (this file's own lexer would open an
// interpolation on it against THIS file's scope, where `cells` does not
// exist) — see _tests_/bit/dupdeclnote.bit's header for the same trap.
fn atomicStoreSrc(): string {
  return "const UNLOCKED: i32 = 0\n" +
    "let cells: [4]i32\n" +
    "fn main() {\n" +
    "  cells[0] = 0x11111111\n" +
    "  cells[1] = 0x22222222\n" +
    "  cells[2] = 0x33333333\n" +
    "  cells[3] = 0x44444444\n" +
    "  atomicStore(ptrOf(cells), UNLOCKED)\n" +
    "  if (cells[0] == 0 && cells[1] == 572662306 && cells[2] == 858993459 && cells[3] == 1145324612) {\n" +
    "    print(\"ok\\n\")\n" +
    "  } else {\n" +
    "    print(\"bad\\n\")\n" +
    "  }\n" +
    "}\n"
}

// The `atomicCmpxchg` shape, matching runtime/spinlock.bit's real
// `spinTryAcquire` exactly: two typed module consts as the CAS operands. A
// too-wide (64-bit) CAS reads element 0 AND element 1 as its 64-bit
// "current" value; since element 1 holds a live nonzero sentinel, the 64-bit
// current value can never equal the (zero-extended) 64-bit expected value,
// so the CAS spuriously reports failure even though element 0 genuinely
// holds UNLOCKED. A correct 32-bit CAS reads only element 0 and succeeds.
fn atomicCmpxchgSrc(): string {
  return "const UNLOCKED: i32 = 0\n" +
    "const LOCKED: i32 = 1\n" +
    "let lockCells: [4]i32\n" +
    "fn main() {\n" +
    "  lockCells[0] = UNLOCKED\n" +
    "  lockCells[1] = 0x22222222\n" +
    "  let acquired = atomicCmpxchg(ptrOf(lockCells), UNLOCKED, LOCKED)\n" +
    "  if (acquired && lockCells[0] == 1 && lockCells[1] == 572662306) {\n" +
    "    print(\"ok\\n\")\n" +
    "  } else {\n" +
    "    print(\"bad\\n\")\n" +
    "  }\n" +
    "}\n"
}

fn checkAtomicStore(t: Tally, bit: string, dir: string, capDir: string, ms: int): ()! {
  let file = "store.bit"
  writeFile("${dir}/${file}", atomicStoreSrc())?
  let r = runFixture(bit, dir, file, capDir, ms)?
  check(t, r.code == 0, "atomicStore: exit ${r.code}, want 0 — stderr: ${r.err}")
  // Correct 32-bit store: element 0 becomes UNLOCKED (0), elements 1-3
  // untouched. A wrong 64-bit store also zeroes element 1.
  check(
    t, r.out == "ok\n",
    "atomicStore: printed '${r.out}', want 'ok' — a 64-bit store clobbered a neighbour",
  )
}

fn checkAtomicCmpxchg(t: Tally, bit: string, dir: string, capDir: string, ms: int): ()! {
  let file = "cmpxchg.bit"
  writeFile("${dir}/${file}", atomicCmpxchgSrc())?
  let r = runFixture(bit, dir, file, capDir, ms)?
  check(t, r.code == 0, "atomicCmpxchg: exit ${r.code}, want 0 — stderr: ${r.err}")
  // Correct 32-bit CAS: succeeds (element 0 really was UNLOCKED), element 0
  // becomes LOCKED (1), element 1 untouched. A wrong 64-bit CAS spuriously
  // fails because element 1's live sentinel poisons the 64-bit comparison.
  check(
    t, r.out == "ok\n",
    "atomicCmpxchg: printed '${r.out}', want 'ok' — a 64-bit CAS read a neighbour's bytes",
  )
}

fn runAll(t: Tally, scratch: string, ms: int) {
  let dir = "${scratch}/src"
  let capDir = "${scratch}/cap"
  mkdir(dir) catch e {
    panic("atomicwidth: cannot create ${dir}: ${e.message()}")
  }
  mkdir(capDir) catch e {
    panic("atomicwidth: cannot create ${capDir}: ${e.message()}")
  }
  let bit = bitBinary(scratch, ms) catch e {
    panic("atomicwidth: ${e.message()}")
  }
  checkAtomicStore(t, bit, dir, capDir, ms) catch e {
    panic("atomicwidth: ${e.message()}")
  }
  checkAtomicCmpxchg(t, bit, dir, capDir, ms) catch e {
    panic("atomicwidth: ${e.message()}")
  }
}

fn main() {
  let ms = timeoutMs()
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  let scratch = "${tmp}/bit-atomicwidth-${uuidFormat(uuidV4())}"
  let t = Tally{ checks: 0, failures: 0 }

  mkdir(scratch) catch e {
    panic("atomicwidth: cannot create ${scratch}: ${e.message()}")
  }
  runAll(t, scratch, ms)

  // 2 exit-code + 2 output checks.
  if (t.checks < 4) {
    eprint("FAIL: only ${t.checks} checks ran, want at least 4\n")
    t.failures = t.failures + 1
  }
  if (t.failures > 0) {
    // `exit()` does not run pending defers (#3694, same shape as #3677) —
    // call teardown explicitly on both the PASS and FAIL paths.
    teardown(scratch, ms)
    println("atomicwidth: FAIL — ${t.failures} of ${t.checks} checks failed")
    exit(1)
  }
  teardown(scratch, ms)
  println("atomicwidth: PASS — ${t.checks} checks")
}

// std/fs has no recursive remove, so the scratch tree goes the way it came.
fn teardown(scratch: string, ms: int) {
  shell("${scratch}/rm.sh", "#!/bin/sh\nrm -rf '${scratch}'\n", ms) catch _ {
    return
  }
}

fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}
