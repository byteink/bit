// _tests_/bit/genericparamscope.bit — #5701 (#4602 child 2): pins the case
// the old flat, name-keyed `Checker.userTypes` got wrong for a type
// parameter's name: two generics in one module that both spell a parameter
// `T`, exercising the declaration that is NOT declared last.
//
// `userTypeLookup` used to answer a bare `T` from `userTypes["T"]` alone,
// which every generic's own registration overwrites — so after the collect
// pass, `T` named whichever declaration the module happened to spell LAST.
// The declaration spelled last always read its OWN `T` back correctly (the
// table's last write IS its own), which is why a fixture using only the
// last-declared generic can never tell the fix from the bug: it "passes by
// accident" either way (see NOT `lastDeclaredAccident` below, kept only as a
// comment, not a case — it cannot fail before or after #5701). Only the
// NOT-last declaration's own type-parameter mentions expose the defect:
// before #5701, `buildSignatures` (compiler/checkbindfunc.bit) — the sixth,
// previously unguarded `userTypes` reader (#5276) — interned the NOT-last
// declaration's method signature against the LAST declaration's `T`,
// corrupting the substitution `ArrayStore<i64>.get`'s result needs to become
// concrete. `ArrayStore<T>` is declared FIRST and `Store<T>` SECOND below for
// exactly that reason: swap the order and this fixture stops discriminating.
//
// NOT placed in _tests_/cases/: that corpus is swept by
// scripts/selfhost-diff*.sh against the pinned stage0 oracle, which predates
// this fix, so a case pinning the corrected behaviour would misreport a
// FALSEPOS/DIFF there rather than a real regression — the same reasoning
// _tests_/bit/classkeyword.bit's own header gives for driving the CLI
// directly instead.
//
// ANTI-VACUITY: `verify` below is called once with the correct expectation
// (must PASS) and once with a deliberately wrong one (must FAIL) so this
// file cannot report green by never actually comparing the built program's
// output — see `main`'s "mutation" call.

import { env, envOr, exit } from "std/os"
import { exists, readFile, writeFile, mkdir } from "std/fs"
import { parseInt, trimSpace } from "std/strings"

const defaultTimeoutS: int = 60
const maxTimeoutMs: int = 6000000

fn timeoutMs(): int {
  let raw = trimSpace(envOr("BIT_TEST_TIMEOUT_S", ""))
  if (raw == "") {
    return defaultTimeoutS * 1000
  }
  let s = parseInt(raw) catch _ {
    return defaultTimeoutS * 1000
  }
  if (s <= 0) {
    return maxTimeoutMs
  }
  if (s * 1000 > maxTimeoutMs) {
    return maxTimeoutMs
  }
  return s * 1000
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

// The `bit` under test. `BIT_SELF_EXE` wins; otherwise the dev-tree artifact
// relative to the repository root this program is run from.
fn bitBinary(): string! {
  let explicit = env("BIT_SELF_EXE")
  if (len(explicit) > 0) {
    return explicit
  }
  let candidate = "bit-out/bin/bit"
  if (!exists(candidate)) {
    fail newError("genericparamscope: no compiler at ./${candidate}; run this from the repository root or set BIT_SELF_EXE")
  }
  return candidate
}

// Builds `srcPath` under `dir` (a subdirectory of `scratch`) to `outPath`,
// returning the wrapper's exit code and captured stderr.
fn buildOne(
  bit: string,
  scratch: string,
  dir: string,
  srcPath: string,
  outPath: string,
): (int, string) {
  let shPath = dir + "/build.sh"
  let errPath = dir + "/build.err"
  let script = "#!/bin/sh\nexec " +
    shQuote(bit) +
    " build " +
    shQuote(srcPath) +
    " -o " +
    shQuote(outPath) +
    " > /dev/null 2> " +
    shQuote(errPath) +
    "\n"
  writeFile(shPath, script) catch e {
    eprint("genericparamscope: cannot write build wrapper: ${e.message()}\n")
    teardown(scratch, timeoutMs())
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("genericparamscope: cannot chmod build wrapper\n")
    teardown(scratch, timeoutMs())
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let err = readFile(errPath) catch _ {
    ""
  }
  return code, err
}

// Runs `binPath`, returning its exit code and captured stdout+stderr.
// `scratch` is the top-level dir this harness tears down; `dir` is `binPath`'s
// own subdirectory of it.
fn runOne(scratch: string, dir: string, binPath: string): (int, string) {
  let shPath = dir + "/run.sh"
  let outPath = dir + "/run.out"
  let script = "#!/bin/sh\nexec " + shQuote(binPath) + " > " + shQuote(outPath) + " 2>&1\n"
  writeFile(shPath, script) catch e {
    eprint("genericparamscope: cannot write run wrapper: ${e.message()}\n")
    teardown(scratch, timeoutMs())
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("genericparamscope: cannot chmod run wrapper\n")
    teardown(scratch, timeoutMs())
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let out = readFile(outPath) catch _ {
    ""
  }
  return code, out
}

// `ArrayStore<T>` declared BEFORE `Store<T>` — the NOT-last case. Its own
// `get` method resolves `T` in its params/result; before #5701 `T` there
// resolved to whichever generic the module spelled LAST (`Store`'s), and
// the id that `ArrayStore<i64>`'s instantiation substitutes never matched
// what `get`'s interned signature actually mentioned.
const notLastSrc: string = "class ArrayStore<T> {\n  v: T\n  get(key: string): T {\n    return this.v\n  }\n}\n" +
  "interface Store<T> {\n  get(key: string): T,\n}\n" +
  "fn main() {\n  let s: Store<i64> = ArrayStore<i64>{ v = 42 }\n" +
  "  let r = s.get(\"k\")\n  print(\"\${r}\\n\")\n}\n"

// The binding-path regression (#5701, found in pkg/orm/manytomany.bit):
// `inner<TChild>` is declared BEFORE `outer<TChild>`, both returning
// `[]Pair<TChild>` from a LOCAL `let out = []Pair<TChild>(0)` binding rather
// than an inline expression. The local binding's type (resolved on the
// check-phase binding path, correctly scoped to `inner`'s own `TChild`) used
// to disagree with the declared result type re-derived by
// `vFuncDecl` (compiler/validatefuncdecl.bit) at validate time, which ran
// unscoped and read `outer`'s `TChild` back out of the flat table instead —
// E0041 with both sides printing the identical name for two different
// TypeIds. An inline `return []Pair<TChild>(0)` does not discriminate this;
// the LOCAL BINDING is load-bearing.
const notLastBindingSrc: string = "class Pair<T> {\n  ownerId: i64,\n  child: T,\n}\n" +
  "fn inner<TChild>(n: i64): []Pair<TChild> {\n  let out = []Pair<TChild>(0)\n  return out\n}\n" +
  "fn outer<TChild>(n: i64): []Pair<TChild> {\n  let out = []Pair<TChild>(0)\n  return out\n}\n" +
  "fn main() {\n  let xs = outer<i64>(1)\n  let ys = inner<i64>(1)\n  print(\"\${len(xs)} \${len(ys)}\\n\")\n}\n"

// One `verify` call: `label` distinguishes it in a failure message, `src` is
// the program to build and run, `want` the expected stdout+stderr, and
// `expectFail` selects the anti-vacuity mutation shape, which wants a
// MISMATCH. Bundled into a class so `verify` itself stays under E0202's
// 5-parameter ceiling (`bit`/`scratch` are the two genuinely separate
// per-run inputs; everything about ONE case belongs together).
class VerifyCase {
  label: string,
  src: string,
  want: string,
  expectFail: bool,
}

// `exit()` does not run pending defers (documented on `std/os.exit` itself,
// #3677); call it explicitly at every exit site instead (same reasoning as
// _tests_/bit/deferblock.bit:179's teardown).
fn teardown(scratch: string, ms: int) {
  let shPath = scratch + "/rm.sh"
  writeFile(shPath, "#!/bin/sh\nrm -rf '${scratch}'\n") catch _ {
    return
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    return
  }
  osRunBounded(shPath, ms)
}

// Builds and runs `vc.src`, comparing captured stdout+stderr against
// `vc.want`.
fn verify(bit: string, scratch: string, vc: VerifyCase): bool {
  let label = vc.label
  let src = vc.src
  let want = vc.want
  let expectFail = vc.expectFail
  let dir = scratch + "/" + label
  mkdir(dir) catch e {
    eprint("genericparamscope: cannot create ${dir}: ${e.message()}\n")
    teardown(scratch, timeoutMs())
    exit(2)
  }
  let srcPath = dir + "/main.bit"
  writeFile(srcPath, src) catch e {
    eprint("genericparamscope: cannot write ${srcPath}: ${e.message()}\n")
    teardown(scratch, timeoutMs())
    exit(2)
  }
  let outPath = dir + "/out"
  let (buildCode, buildErr) = buildOne(bit, scratch, dir, srcPath, outPath)
  if (buildCode != 0) {
    eprint("genericparamscope: ${label}: build failed (exit ${buildCode}):\n${buildErr}\n")
    return false
  }
  let (runCode, out) = runOne(scratch, dir, outPath)
  let matched = runCode == 0 && out == want
  if (expectFail) {
    if (matched) {
      eprint("genericparamscope: ${label}: MUTATION DID NOT FAIL — wanted a mismatch against '${want}', got exit=${runCode} out='${out}'\n")
      return false
    }
    return true
  }
  if (!matched) {
    eprint("genericparamscope: ${label}: exit=${runCode} out='${out}', want exit=0 out='${want}'\n")
    return false
  }
  return true
}

fn main() {
  let bit = bitBinary() catch e {
    eprint("genericparamscope: ${e.message()}\n")
    exit(2)
  }
  let scratch = envOr("TMPDIR", "/tmp") + "/bit-genericparamscope-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("genericparamscope: cannot create scratch directory ${scratch}: ${e.message()}\n")
    exit(2)
  }

  let ok = true
  // The real case: the NOT-last generic's own `T` must substitute to i64.
  if (!verify(
    bit,
    scratch,
    VerifyCase{ label = "notlast", src = notLastSrc, want = "42\n", expectFail = false },
  )) {
    ok = false
  }
  // ANTI-VACUITY mutation: the SAME program against a wrong expectation must
  // be reported as a mismatch, proving `verify`'s comparison is load-bearing
  // rather than a check that is satisfied by any output at all.
  if (!verify(
    bit,
    scratch,
    VerifyCase{ label = "mutation", src = notLastSrc, want = "43\n", expectFail = true },
  )) {
    ok = false
  }
  // The binding-path regression: the NOT-last generic's local binding must
  // resolve to its own `TChild`, not the last-declared sibling's.
  if (!verify(
    bit,
    scratch,
    VerifyCase{
      label = "notlastbinding",
      src = notLastBindingSrc,
      want = "0 0\n",
      expectFail = false,
    },
  )) {
    ok = false
  }
  // ANTI-VACUITY mutation for the binding-path case.
  if (!verify(
    bit,
    scratch,
    VerifyCase{
      label = "bindingmutation",
      src = notLastBindingSrc,
      want = "1 1\n",
      expectFail = true,
    },
  )) {
    ok = false
  }

  teardown(scratch, timeoutMs())
  if (!ok) {
    exit(1)
  }
  print("PASS genericparamscope: a NOT-last generic's own type parameter resolves to its own id, not the last-declared sibling's\n")
}
