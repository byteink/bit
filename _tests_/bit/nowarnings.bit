// #6372. Every compiler warning in a `.bit` file this repository compiles
// itself is a build break. `warning[E0098]` ('${' in a raw string) sat in
// three files on main and `warning[E0048]` (a name that shadows a predeclared
// one: `len`, `cap`, `keepAlive`, `parseFloat`, `osEnv`) in thirteen more,
// because no gate read warnings: `bit check` exits 0 on a warning, so every
// harness that asked only for the exit code passed over them. The lint gates
// do not see them either; E0098 and E0048 are compiler diagnostics, not
// spec/LINT.md rules.
//
// THE CHECK: `bit check <unit>` for every module unit below, and a failure on
// any output line that starts `warning[`, or on a non-zero exit. A unit is what
// the compiler loads as ONE module:
//   - a directory, when it holds at most one non-test file with a top-level
//     `fn main` (compiler/, every stdlib/ and runtime/ module, pkg/<name>/,
//     examples/<name>/, a _tests_/stress/ program). `bit check <dir>` covers
//     its `.test.bit` files too;
//   - otherwise each file on its own: a directory with two or more programs
//     (_tests_/bit/, _tests_/imports/ trees of single-file harnesses) cannot be
//     one module, and `bit check <file>` refuses a file whose siblings it needs.
//
// THE FILE SET is `git ls-files '*.bit'`, never a filesystem walk (a walk reads
// gitignored output: dist/out/, bit-out/stage0 and other agents' worktrees),
// minus three named exclusions, each printed with its count:
//   - _tests_/cases/: the golden corpus. `test-golden` compiles it and several
//     cases are warning fixtures on purpose (run_raw_string_dollar_brace_literal
//     exists to draw E0098), so a warning there is the expected answer.
//   - _tests_/fuzz/: crash inputs, malformed by construction.
//   - a directory under _tests_/bit/ holding an `.expected` file: the
//     checker/parser fixture corpora, each file an asserted diagnostic
//     (_tests_/bit/linttests.bit's isFixtureCorpus draws the same line; only
//     under _tests_/bit/, because an `.expected` beside a _tests_/stress/
//     program is that program's stdout oracle, not a fixture corpus).
// Everything else that is tracked is checked: compiler/, runtime/, stdlib/,
// tools/, pkg/, examples/, bench/, editors/, docs/ and the rest of _tests_/.
//
// ONE NAMED EXEMPTION (`exemptUnits()`): _tests_/bit/fieldattrcollision/fixture
// is an error fixture by design (test-fieldattrcollision asserts the compiler
// rejects it). It is asserted BOTH WAYS: it must still fail `bit check`, and a
// listed unit that is no longer a unit of the tracked tree, or now checks
// clean, is a hard failure, so the list cannot rot into a permanent excuse. An
// exempt unit that draws a warning still fails.
//
// FIVE GENERATED PROJECTS (`generatedUnits()`): units that import a package
// only a project provides (E0045 'not declared in bit.lock'): the three
// pkg/*/bench/apps/bit benchmark apps, the inkwell guide's migrations/, and the
// probe program _tests_/bit/jobslive. Each is checked, not exempted, in a
// scratch project under $TMPDIR built the way the bench scripts and the live
// harnesses build theirs: the unit's TRACKED files (`git ls-files`, never a
// copy of the directory), the tracked files of every package it needs, then
// `bit init` and one `bit add <scratch copy of the package>` per dependency.
// Nothing gitignored reaches the scratch project, so the verdict is the same in
// a tree where pkg/{toml,yaml,web}/bench/run.sh has left its apps/bit/bit.json
// and bit.lock behind (#6383); `plantedRegression` proves it on every run.
//
// FOUR COVERED UNITS (`coveredUnits()`): _tests_/bit/ormrelauto/relautod and
// relautox are not modules that stand alone. relautox's `post.author.name` is
// judged (E0300) only against a call site, and both are compiled by
// relautoc.test.bit next to them, a tracked unit with its own tracked bit.json
// and bit.lock, whose `bit check` loads and diagnoses both (a warning planted
// in relautox surfaces there). They are checked through relautoc, not on their
// own; `coverageHolds` asserts relautoc is a unit and still imports each.
// _tests_/bit/pkgdiamond/fixture/pkgs/left and right are the same shape for a
// different reason: they import `shared`, which only the fixture's bit.work
// resolves, so a bare `bit check` of either is E0045. They are checked through
// fixture/ws, whose main.bit imports `left` and `right` by package name.
//
// ANTI-VACUITY: a probe module with a raw string holding `${x}` is checked
// through the very same script; it must report a warning or this gate panics.
// The denominator (units, tracked files, skips) is printed.
//
// BIT_SELF_EXE and BIT_REPO are required, like every sibling in this
// directory. Run it from the repository root:
//     ./bit-out/bin/bit run _tests_/bit/nowarnings.bit
import { env, envOr, exit } from "std/os"
import { mkdir, readDir, readFile, writeFile } from "std/fs"
import { contains, hasPrefix, hasSuffix, lastIndexOf, parseInt, replace, split } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

const defaultTimeoutS: int = 1500
const minTracked: int = 1000
const parallelism: int = 6
const logLines: int = 12
const maxDepth: int = 16

// Units that must keep failing `bit check`; see the header.
fn exemptUnits(): []string {
  return ["_tests_/bit/fieldattrcollision/fixture"]
}

// A unit checked in a generated scratch project. `deps` are repo-relative
// package directories that get `bit add`ed.
class Gen {
  unit: string,
  deps: []string,
}

// A unit judged by the `bit check` of `by`, which imports it as `via` (the
// import path exactly as written); see the header.
class Covered {
  unit: string,
  by: string,
  via: string,
}

fn coveredUnits(): []Covered {
  let by = "_tests_/bit/ormrelauto/relautoc"
  let ws = "_tests_/bit/pkgdiamond/fixture/ws"
  return [
    Covered{ unit = "_tests_/bit/ormrelauto/relautod", by = by, via = "../relautod" },
    Covered{ unit = "_tests_/bit/ormrelauto/relautox", by = by, via = "../relautox" },
    Covered{ unit = "_tests_/bit/pkgdiamond/fixture/pkgs/left", by = ws, via = "left" },
    Covered{ unit = "_tests_/bit/pkgdiamond/fixture/pkgs/right", by = ws, via = "right" },
  ]
}

fn generatedUnits(): []Gen {
  return [
    Gen{ unit = "pkg/toml/bench/apps/bit", deps = ["pkg/toml"] },
    Gen{ unit = "pkg/web/bench/apps/bit", deps = ["pkg/web"] },
    Gen{ unit = "pkg/yaml/bench/apps/bit", deps = ["pkg/yaml"] },
    Gen{
      unit = "pkg/web/guides/inkwell/migrations",
      deps = ["pkg/postgres", "pkg/mysql", "pkg/orm"],
    },
    Gen{
      unit = "_tests_/bit/jobslive",
      deps = ["pkg/jobs", "pkg/postgres", "pkg/mysql", "pkg/redis"],
    },
  ]
}

class Plan {
  units: []string,
  tracked: int,
  skipCases: int,
  skipFuzz: int,
  skipFixture: int,
}

class Result {
  unit: string,
  rc: int,
  warnings: int,
}

fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "${defaultTimeoutS}")) catch _ {
    defaultTimeoutS
  }
  if (s <= 0) {
    return defaultTimeoutS * 1000
  }
  return s * 1000
}

fn requiredEnv(name: string): string {
  let v = env(name)
  if (len(v) == 0) {
    panic("nowarnings: ${name} is required and was not set")
  }
  if (contains(v, "'")) {
    panic("nowarnings: ${name} holds a single quote, which the generated shell cannot carry")
  }
  return v
}

// Runs `script` through /bin/sh and returns its exit code. Negative returns are
// `osRunBounded`'s mechanism channel, never a program exit status.
fn shell(scriptPath: string, script: string, ms: int): int {
  writeFile(scriptPath, script) catch e {
    panic("nowarnings: cannot write ${scriptPath}: ${e.message()}")
  }
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    panic("nowarnings: cannot make ${scriptPath} executable")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == -2) {
    panic("nowarnings: TIMED OUT after ${ms}ms running ${scriptPath}")
  }
  if (code == -1) {
    panic("nowarnings: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("nowarnings: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}

fn dirOf(path: string): string {
  let i = lastIndexOf(path, "/")
  if (i < 0) {
    return ""
  }
  return path[0:int(i)]
}

fn containsStr(xs: []string, s: string): bool {
  for x of xs {
    if (x == s) {
      return true
    }
  }
  return false
}

fn dirHasExpected(repo: string, dir: string): bool {
  let names = readDir("${repo}/${dir}") catch e {
    panic("nowarnings: cannot list ${repo}/${dir}: ${e.message()}")
  }
  for n of names {
    if (hasSuffix(n, ".expected")) {
      return true
    }
  }
  return false
}

// Whether `dir` or an ancestor below _tests_/bit/ is a fixture corpus.
fn underFixtureCorpus(repo: string, dir: string): bool {
  let d = dir
  let depth = 0
  while (depth < maxDepth) {
    if (!hasPrefix(d, "_tests_/bit/")) {
      return false
    }
    if (dirHasExpected(repo, d)) {
      return true
    }
    d = dirOf(d)
    depth = depth + 1
  }
  panic("nowarnings: ${dir} nests deeper than ${maxDepth} levels")
}

fn isProgram(repo: string, file: string): bool {
  if (hasSuffix(file, ".test.bit")) {
    return false
  }
  let src = readFile("${repo}/${file}") catch e {
    panic("nowarnings: cannot read ${file}: ${e.message()}")
  }
  return hasPrefix(src, "fn main") || contains(src, "\nfn main")
}

// The modules of one directory's files: the directory itself unless two or more
// non-test files each hold a top-level `fn main`, else each file alone.
fn unitsOfDir(repo: string, dir: string, files: []string): []string {
  let programs = 0
  for f of files {
    if (isProgram(repo, f)) {
      programs = programs + 1
    }
  }
  if (programs < 2) {
    return [dir]
  }
  return files
}

fn listTracked(repo: string, work: string, ms: int): []string {
  let out = "${work}/tracked.txt"
  let rc = shell(
    "${work}/ls.sh",
    "#!/bin/sh\ncd '${repo}' || exit 97\nexec git ls-files -- '*.bit' > '${out}'\n",
    ms,
  )
  if (rc != 0) {
    panic("nowarnings: `git ls-files` exited ${rc}")
  }
  let text = readFile(out) catch e {
    panic("nowarnings: cannot read ${out}: ${e.message()}")
  }
  let files = []string(0)
  for line of split(text, "\n") {
    if (len(line) == 0) {
      continue
    }
    if (contains(line, " ")) {
      panic("nowarnings: tracked path with a space, which the unit list cannot carry: ${line}")
    }
    files = append(files, line)
  }
  if (len(files) < minTracked) {
    panic("nowarnings: only ${len(files)} tracked .bit files, under the ${minTracked} floor; the listing is broken, not the tree")
  }
  return files
}

fn buildPlan(repo: string, tracked: []string): Plan {
  let p = Plan{
    units = []string(0),
    tracked = len(tracked),
    skipCases = 0,
    skipFuzz = 0,
    skipFixture = 0,
  }
  let dirs = []string(0)
  let kept = []string(0)
  for f of tracked {
    if (hasPrefix(f, "_tests_/cases/")) {
      p.skipCases = p.skipCases + 1
    } else if (hasPrefix(f, "_tests_/fuzz/")) {
      p.skipFuzz = p.skipFuzz + 1
    } else if (underFixtureCorpus(repo, dirOf(f))) {
      p.skipFixture = p.skipFixture + 1
    } else {
      kept = append(kept, f)
      if (!containsStr(dirs, dirOf(f))) {
        dirs = append(dirs, dirOf(f))
      }
    }
  }
  for d of dirs {
    let inDir = []string(0)
    for f of kept {
      if (dirOf(f) == d) {
        inDir = append(inDir, f)
      }
    }
    p.units = concat(p.units, unitsOfDir(repo, d, inDir))
  }
  return p
}

fn keyOf(unit: string): string {
  return replace(unit, "/", "_")
}

// Script that builds the scratch project of `g` under `base`/gen/<key>/: its
// tracked files, then `bit init` and `bit add` of each scratch package copy.
// `set -e`: any step that fails fails the script, and the list/tar/untar steps
// are separate commands because /bin/sh has no pipefail.
fn genScript(bit: string, repo: string, base: string, g: Gen): string {
  let root = "${base}/gen/${keyOf(g.unit)}"
  let paths = "'${g.unit}'"
  for d of g.deps {
    paths = paths + " '${d}'"
  }
  let s = "#!/bin/sh\nset -e\nmkdir -p '${root}'\ncd '${repo}'\n"
  s = s + "git ls-files -z -- ${paths} > '${root}.list'\n"
  s = s + "tar -c --null -T '${root}.list' -f '${root}.tar'\n"
  s = s + "tar -x -C '${root}' -f '${root}.tar'\n"
  s = s + "cd '${root}/${g.unit}'\n'${bit}' init > /dev/null\n"
  for d of g.deps {
    s = s + "'${bit}' add '${root}/${d}' > /dev/null\n"
  }
  return s
}

fn makeDir(dir: string) {
  mkdir(dir) catch e {
    panic("nowarnings: cannot create ${dir}: ${e.message()}")
  }
}

fn generate(bit: string, repo: string, base: string, g: Gen, ms: int) {
  let rc = shell("${base}/gen-${keyOf(g.unit)}.sh", genScript(bit, repo, base, g), ms)
  if (rc != 0) {
    panic("nowarnings: building the scratch project of ${g.unit} exited ${rc}")
  }
}

fn generateAll(bit: string, repo: string, work: string, ms: int) {
  for g of generatedUnits() {
    generate(bit, repo, work, g, ms)
  }
}

// `bit check <dir>` through a script of its own; returns the exit code.
fn checkRc(bit: string, dir: string, script: string, ms: int): int {
  return shell(script, "#!/bin/sh\nexec '${bit}' check '${dir}' > '${script}.log' 2>&1\n", ms)
}

// A synthetic repository: unit apps/bit imports package "dep" (tracked at
// pkg/dep), and the unit has no bit.json, so it cannot check in place.
fn plantRepoScript(repo: string): string {
  let prog = "import { depValue } from \"dep\"\nfn main() {\n  println(depValue())\n}\n"
  let dep = "export fn depValue(): string {\n  return \"7\"\n}\n"
  return "#!/bin/sh\nset -e\nmkdir -p '${repo}/pkg/dep' '${repo}/apps/bit'\ncd '${repo}'\ngit init -q\nprintf '%s' '${dep}' > pkg/dep/dep.bit\nprintf '%s' '${prog}' > apps/bit/main.bit\ngit add pkg apps\n"
}

// What a bench run leaves behind, `bit init` + `bit add`, exactly as
// pkg/yaml/bench/run.sh's build_bit does it. `target` is what "dep" resolves to.
fn plantScript(bit: string, repo: string, target: string): string {
  return "#!/bin/sh\nset -e\ncd '${repo}/apps/bit'\nrm -f bit.json bit.lock\n'${bit}' init > /dev/null\n'${bit}' add '${target}' > /dev/null\n"
}

fn expectRc(what: string, got: int, wantZero: bool) {
  let isZero = got == 0
  if (isZero == wantZero) {
    return
  }
  let want = "non-zero"
  if (wantZero) {
    want = "0"
  }
  panic("nowarnings: planted-file regression: ${what}: exit ${got}, wanted ${want}")
}

// A bit.json/bit.lock whose "dep" points at a directory that is gone.
fn plantStale(repo: string, gone: string) {
  let dir = "${repo}/apps/bit"
  writeFile("${dir}/bit.json", "{\"dependencies\": {\"dep\": \"${gone}\"}}\n") catch e {
    panic("nowarnings: cannot plant ${dir}/bit.json: ${e.message()}")
  }
  writeFile("${dir}/bit.lock", "{\"dep\": {\"path\": \"${gone}\", \"requires\": {}}}\n") catch e {
    panic("nowarnings: cannot plant ${dir}/bit.lock: ${e.message()}")
  }
}

// #6383: pkg/{toml,yaml,web}/bench/run.sh write a gitignored apps/bit/bit.json
// and bit.lock on every run, so a unit that `bit check`s only inside a project
// used to flip verdict with the tree's history. The same unit is checked in a
// synthetic repository, three times, and the verdict of the generated scratch
// project must be "clean" each time:
//   1. nothing planted: the unit fails in place (control: E0045), clean generated;
//   2. a bench-style bit.json/bit.lock planted: in place it now checks clean
//      (control: the plant changes the in-place verdict, the original landmine);
//   3. a STALE bit.lock planted (the dependency moved, as a deleted worktree's
//      absolute path does): in place it fails, and a generated project that read
//      any untracked file would fail with it.
fn plantedRegression(bit: string, work: string, ms: int) {
  let base = "${work}/plant"
  let repo = "${base}/repo"
  let g = Gen{ unit = "apps/bit", deps = ["pkg/dep"] }
  makeDir(base)
  for phase of ["g1", "g2", "g3"] {
    makeDir("${base}/${phase}")
  }
  expectRc(
    "build the synthetic repository",
    shell("${base}/repo.sh", plantRepoScript(repo), ms),
    true,
  )
  expectRc("unplanted, in place", checkRc(bit, "${repo}/apps/bit", "${base}/c1.sh", ms), false)
  generate(bit, repo, "${base}/g1", g, ms)
  expectRc(
    "unplanted, generated",
    checkRc(bit, "${base}/g1/gen/apps_bit/apps/bit", "${base}/c2.sh", ms),
    true,
  )
  expectRc(
    "plant a bench-style project",
    shell("${base}/p1.sh", plantScript(bit, repo, "${repo}/pkg/dep"), ms),
    true,
  )
  expectRc(
    "bench-style plant, in place",
    checkRc(bit, "${repo}/apps/bit", "${base}/c3.sh", ms),
    true,
  )
  generate(bit, repo, "${base}/g2", g, ms)
  expectRc(
    "bench-style plant, generated",
    checkRc(bit, "${base}/g2/gen/apps_bit/apps/bit", "${base}/c4.sh", ms),
    true,
  )
  plantStale(repo, "${base}/gone/dep")
  expectRc("stale plant, in place", checkRc(bit, "${repo}/apps/bit", "${base}/c5.sh", ms), false)
  generate(bit, repo, "${base}/g3", g, ms)
  expectRc(
    "stale plant, generated",
    checkRc(bit, "${base}/g3/gen/apps_bit/apps/bit", "${base}/c6.sh", ms),
    true,
  )
}

fn concat(a: []string, b: []string): []string {
  let out = []string(0)
  for x of a {
    out = append(out, x)
  }
  for x of b {
    out = append(out, x)
  }
  return out
}

// `probe/main.bit`: a raw string holding `${x}`, spelled here with `\$` because
// this very file must not carry the pattern it hunts.
fn writeProbe(work: string): string {
  let dir = "${work}/probe"
  mkdir(dir) catch e {
    panic("nowarnings: cannot create ${dir}: ${e.message()}")
  }
  writeFile("${dir}/main.bit", "fn main() {\n  let s = `a \${x} b`\n  println(s)\n}\n") catch e {
    panic("nowarnings: cannot write the probe: ${e.message()}")
  }
  return dir
}

// One script checks one unit and appends `<rc> <warnings> <unit>` to results;
// xargs fans it out. Output goes to a per-unit log named by the unit path.
fn runChecks(bit: string, repo: string, work: string, units: []string, ms: int) {
  let body = ""
  for u of units {
    body = body + u + "\n"
  }
  writeFile("${work}/units.txt", body) catch e {
    panic("nowarnings: cannot write the unit list: ${e.message()}")
  }
  let one = "#!/bin/sh\nu=\"$1\"\nkey=$(printf '%s' \"$u\" | tr '/' '_')\nlog='${work}/logs/'\"$key\"\nt=\"$u\"\ng='${work}/gen/'\"$key/$u\"\nif [ -d \"$g\" ]; then t=\"$g\"; fi\n'${bit}' check \"$t\" > \"$log\" 2>&1\nrc=$?\nw=$(grep -c '^warning\\[' \"$log\")\nprintf '%s %s %s\\n' \"$rc\" \"$w\" \"$u\" >> '${work}/results.txt'\n"
  mkdir("${work}/logs") catch e {
    panic("nowarnings: cannot create the log dir: ${e.message()}")
  }
  writeFile("${work}/one.sh", one) catch e {
    panic("nowarnings: cannot write one.sh: ${e.message()}")
  }
  let all = "#!/bin/sh\ncd '${repo}' || exit 97\nxargs -n1 -P${parallelism} sh '${work}/one.sh' < '${work}/units.txt'\n"
  let rc = shell("${work}/run.sh", all, ms)
  if (rc != 0) {
    panic("nowarnings: the check fan-out exited ${rc}")
  }
}

fn readResults(work: string): []Result {
  let text = readFile("${work}/results.txt") catch e {
    panic("nowarnings: no results were written: ${e.message()}")
  }
  let out = []Result(0)
  for line of split(text, "\n") {
    let parts = split(line, " ")
    if (len(parts) != 3) {
      continue
    }
    let rc = parseInt(parts[0]) catch _ {
      -1
    }
    let w = parseInt(parts[1]) catch _ {
      -1
    }
    out = append(out, Result{ unit = parts[2], rc = rc, warnings = w })
  }
  return out
}

fn findResult(rs: []Result, unit: string): Result {
  for r of rs {
    if (r.unit == unit) {
      return r
    }
  }
  panic("nowarnings: unit ${unit} produced no result line")
}

fn showLog(work: string, unit: string) {
  let text = readFile("${work}/logs/${replace(unit, "/", "_")}") catch _ {
    ""
  }
  let lines = split(text, "\n")
  let n = len(lines)
  if (n > logLines) {
    n = logLines
  }
  let i = 0
  while (i < n) {
    eprint("    ${lines[i]}\n")
    i = i + 1
  }
}

// A unit is clean when it exits 0 with no warning line. An exempt unit must
// instead still fail (its reason to be exempt), with no warning line.
fn judge(work: string, r: Result, exempt: bool): bool {
  let ok = r.warnings == 0 && ((exempt && r.rc != 0) || (!exempt && r.rc == 0))
  if (ok) {
    return true
  }
  let why = "rc=${r.rc} warnings=${r.warnings}"
  if (exempt && r.rc == 0 && r.warnings == 0) {
    why = "exempt but now checks clean: delete it from exemptUnits()"
  }
  eprint("nowarnings: FAIL ${r.unit}: ${why}\n")
  showLog(work, r.unit)
  return false
}

// Whether some tracked file directly in `c.by` imports `c.unit` as `c.via`.
fn coverageHolds(repo: string, tracked: []string, c: Covered): bool {
  for f of tracked {
    if (dirOf(f) == c.by && contains(readSource(repo, f), "\"${c.via}\"")) {
      return true
    }
  }
  return false
}

fn readSource(repo: string, file: string): string {
  return readFile("${repo}/${file}") catch e {
    panic("nowarnings: cannot read ${file}: ${e.message()}")
  }
}

// The units that get their own `bit check`: every unit but the covered ones.
fn checkedUnits(units: []string): []string {
  let out = []string(0)
  for u of units {
    if (!isCovered(u)) {
      out = append(out, u)
    }
  }
  return out
}

fn isCovered(unit: string): bool {
  for c of coveredUnits() {
    if (c.unit == unit) {
      return true
    }
  }
  return false
}

fn exemptsAreUnits(repo: string, tracked: []string, units: []string) {
  for e of exemptUnits() {
    if (!containsStr(units, e)) {
      panic("nowarnings: exempt unit ${e} is not a unit of the tracked tree; delete it from exemptUnits()")
    }
  }
  for g of generatedUnits() {
    if (!containsStr(units, g.unit)) {
      panic("nowarnings: generated unit ${g.unit} is not a unit of the tracked tree; delete it from generatedUnits()")
    }
  }
  for c of coveredUnits() {
    if (!containsStr(units, c.unit) || !containsStr(units, c.by)) {
      panic("nowarnings: covered unit ${c.unit} or its checker ${c.by} is not a unit of the tracked tree; fix coveredUnits()")
    }
    if (!coverageHolds(repo, tracked, c)) {
      panic("nowarnings: ${c.by} no longer imports ${c.unit}, so its check no longer covers it; fix coveredUnits()")
    }
  }
}

// Checks every unit that has its own `bit check`, plus the probe, and returns
// how many units failed.
fn checkAll(bit: string, repo: string, work: string, units: []string, ms: int): int {
  let probe = writeProbe(work)
  runChecks(bit, repo, work, concat(units, [probe]), ms)
  let results = readResults(work)
  if (len(results) != len(units) + 1) {
    panic("nowarnings: ${len(results)} result lines for ${len(units) + 1} units")
  }
  if (findResult(results, probe).warnings < 1) {
    panic("nowarnings: the probe raw string drew no warning; this gate cannot see warnings")
  }
  let failed = 0
  for u of units {
    if (!judge(work, findResult(results, u), containsStr(exemptUnits(), u))) {
      failed = failed + 1
    }
  }
  return failed
}

fn scopeLine(plan: Plan): string {
  let skipped = plan.skipCases + plan.skipFuzz + plan.skipFixture
  let own = len(plan.units) - len(coveredUnits())
  return "${len(plan.units)} module units over ${plan.tracked - skipped} of ${plan.tracked} tracked .bit files (skipped ${skipped}: ${plan.skipCases} golden corpus, ${plan.skipFuzz} fuzz crashes, ${plan.skipFixture} checker/parser fixtures; ${len(generatedUnits())} of the ${own} checked units run in generated scratch projects, ${len(coveredUnits())} are checked through the unit that imports them, ${len(exemptUnits())} exempt, asserted to still fail)"
}

fn main() {
  let ms = timeoutMs()
  let bit = requiredEnv("BIT_SELF_EXE")
  let repo = requiredEnv("BIT_REPO")
  let work = "${requiredTmp()}/nowarnings-${uuidFormat(uuidV4())}"
  makeDir(work)
  let tracked = listTracked(repo, work, ms)
  let plan = buildPlan(repo, tracked)
  exemptsAreUnits(repo, tracked, plan.units)
  plantedRegression(bit, work, ms)
  generateAll(bit, repo, work, ms)
  let units = checkedUnits(plan.units)
  let failed = checkAll(bit, repo, work, units, ms)
  if (failed > 0) {
    eprint("nowarnings: FAIL -- ${failed} of ${len(units)} units warn or fail to check; fix the source, there is no suppression. Scope: ${scopeLine(plan)}\n")
    exit(1)
  }
  println("nowarnings: PASS -- 0 warnings in ${scopeLine(plan)}")
  removeWork(work, ms)
}

// Only on a pass: a failing run keeps its logs and scratch projects to read.
fn removeWork(work: string, ms: int) {
  if (!contains(work, "/nowarnings-")) {
    panic("nowarnings: refusing to remove ${work}")
  }
  if (shell("${work}.rm.sh", "#!/bin/sh\nrm -rf '${work}' '${work}.rm.sh'\n", ms) != 0) {
    eprint("nowarnings: could not remove ${work}\n")
  }
}

fn requiredTmp(): string {
  let t = envOr("TMPDIR", "/tmp")
  if (hasSuffix(t, "/")) {
    return t[0:len(t) - 1]
  }
  return t
}
