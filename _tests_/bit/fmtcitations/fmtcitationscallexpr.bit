// _tests_/bit/fmtcitations/fmtcitationscallexpr.bit — the call-expression
// rescue (#5651), split out of fmtcitationsassoc.bit to keep that file
// under the repo's 800-line limit (E0200). Sibling in the same directory
// module, so everything here calls straight into fmtcitations.bit's and
// fmtcitationsassoc.bit's isBareIdentifier/backtickSpanBefore/
// isEntryConnector/citationChainIndex/symbolEntryScanBound/
// findAssociatedSymbol/possessiveSymbolsAfter/backtickSpanAt/
// skipCommentWrapWs with no import, matching docs/development.md's
// "Splitting a file" convention.
//
// #5649 measured 338 source-comment-tier tokens where a backtick span sits
// immediately adjacent to a citation (an author clearly WAS making a
// symbol claim) but gets rejected because its content is not a bare
// identifier: 159 of those are a call-expression shape like
// `` `funcSigLookup(c, qn)` ``, where only the identifier before the '('
// is the symbol being cited — the trailing argument list isn't part of
// the claim. calleeOfCallExpr strips it; sourceBackwardSymbol and
// possessiveEntrySymbols apply the rescue at each arm's ENTRY position
// only, source-comment tier only (see each function's own comment for why).

// The callee name of a call-expression citation shape like
// `` `funcSigLookup(c, qn)` `` — only the identifier before the FIRST '('
// matters, since the argument list is not part of what is being cited. `ok`
// is false unless `s` ends in ')' and the stripped prefix is itself a bare
// identifier, so ordinary non-call prose (spaces, punctuation) is never
// misread as a call.
fn calleeOfCallExpr(s: string): (string, bool) {
  let n = len(s)
  if (n == 0 || s[n - 1] != ')') {
    return "", false
  }
  let openAt = int(indexOfFrom(s, "(", 0))
  if (openAt < 0) {
    return "", false
  }
  let callee = s[0:openAt]
  if (!isBareIdentifier(callee)) {
    return "", false
  }
  return callee, true
}

// The backward arm's ENTRY association with the call-expression rescue,
// source-comment tier ONLY — kept out of
// findAssociatedSymbol/symbolListBefore (fmtcitationsassoc.bit), shared
// with the DocRow tier's checkExactCitationBody (fmtcitations.bit). DocRow
// prose routinely narrates a CALL SITE with this identical shape
// ("(`fmtGap(p, n.span.end, true)`, compiler/fmtprint.bit:217-229)" cites
// where `fmtPrintBlock` CALLS `fmtGap`, not where `fmtGap` is declared),
// and #5649 measured #5651's population as source-comment only; rescuing
// DocRow too would misread that call-site idiom as a declaration claim.
// Restricted to the chain's FIRST member (idx == 0) — a later chain
// position sees the same entry span every earlier member already saw, so
// rescuing it there would double-report one call for every citation in
// the run.
fn sourceBackwardSymbol(text: string, citStartOffset: int): (string, bool, bool) {
  let bare = findAssociatedSymbol(text, citStartOffset)
  if (len(bare) > 0) {
    return bare, false, false
  }
  let (idx, chainStart) = citationChainIndex(text, citStartOffset)
  if (idx != 0) {
    return "", false, false
  }
  let (start, end, connector, ok) = backtickSpanBefore(
    text,
    symbolEntryScanBound(text, chainStart),
    maxIdentLen,
  )
  if (!ok || !isEntryConnector(connector)) {
    return "", false, false
  }
  let (callee, calleeOk) = calleeOfCallExpr(text[start:end])
  if (calleeOk) {
    return callee, true, false
  }
  return "", false, true
}

// The possessive twin of sourceBackwardSymbol: possessiveSymbolsAfter's own
// list when it found one (bare identifiers, unchanged), or a single-element
// list carrying the call-expression rescue's callee when the first symbol
// after "'s" was rejected only for that shape. Stays out of
// chainedSymbolsFrom's further list members, same reason as
// sourceBackwardSymbol's chain-position-0 restriction.
fn possessiveEntrySymbols(text: string, end: int): ([]string, bool, bool) {
  let bare = possessiveSymbolsAfter(text, end)
  if (len(bare) > 0) {
    return bare, false, false
  }
  let p = end
  if (p < len(text) && text[p] == '`') {
    p = p + 1
  }
  let (start, stop, ok) = backtickSpanAt(text, skipCommentWrapWs(text, p + len("'s")))
  if (!ok) {
    return []string(0), false, false
  }
  let (callee, calleeOk) = calleeOfCallExpr(text[start:stop])
  if (calleeOk) {
    return [callee], true, false
  }
  return []string(0), false, true
}

// A call expression still does not associate through the SHARED path
// (findAssociatedSymbol, fmtcitationsassoc.bit) — DocRow narrates a call
// SITE with this shape, not a declaration (#5651) — but sourceBackwardSymbol
// above strips its argument list and associates the callee, for the
// source-comment tier only. Split out of selfTestAssociation
// (fmtcitationsselftest.bit) to keep that file under E0200's 800-line limit.
fn selfTestCallExprAssociation(): int {
  let t4 = "the `fmtGap(p, true)`, `compiler/fmt.bit:5-9` call"
  let c4 = extractPathTokens(t4, "")
  let failed = selfCheck(
    len(c4) == 1 && findAssociatedSymbol(t4, c4[0].startOffset) == "",
    "wrongly associated a call expression through the DocRow-shared path",
  )
  if (len(c4) != 1) {
    return failed
  }
  let (name4, isCall4, _) = sourceBackwardSymbol(t4, c4[0].startOffset)
  return failed +
    selfCheck(
      name4 == "fmtGap" && isCall4,
      "did not strip a call expression's argument list and associate its callee",
    )
}

// The possessive arm's own call-expression rescue, the same
// argument-stripping the backward arm does. Split out of
// selfTestPossessiveForward for the same reason as
// selfTestCallExprAssociation above.
fn selfTestPossessiveCallExprAssociation(): int {
  let callText = "`checklookup.bit`'s `funcSigLookup(c, qn)` reads the signature"
  let callToks = extractPathTokens(callText, "")
  let failed = selfCheck(len(callToks) == 1, "did not find the possessive call-expr token")
  if (len(callToks) != 1) {
    return failed
  }
  let (callNames, callIsCall, _) = possessiveEntrySymbols(
    callText,
    tokenRawEnd(callText, callToks[0]),
  )
  return failed +
    selfCheck(
      len(callNames) == 1 && callNames[0] == "funcSigLookup" && callIsCall,
      "did not strip a possessive call expression's argument list and associate its callee",
    )
}

// checkCallExprCitation (fmtcitationsassoc.bit) end to end: a call-expr
// citation of a symbol that genuinely does not appear in the cited file's
// text at all is caught (returns false, the caller's signal to count the
// citation rather than silently pass it); one whose text IS present is
// accepted (returns true). Proves the acceptance case for #5651's own
// worked example, `` `someFn(a, b)` (file.bit) `` naming a file that does
// not declare `someFn`: this assertion is red without checkCallExprCitation
// existing (identifierAppearsIn alone, with no call-expression rescue,
// never even reaches this symbol) and green with it.
fn selfTestCallExprCitation(): int {
  let sc = newScan()
  sc.quiet = true // this self-test asserts report() fires; see Scan.quiet
  let ctx = CheckCtx{
    sc = sc, root = ".", row = DocRow{
      docPath = "x.bit", searchRoots = []string(0), requiredPrefix = "",
      checkBareMentions = false, verifySymbols = true, minCitations = 0,
    },
    index = []string(0), declIndex = []string(0), seen = SeenSymbols{ names = []string(0) },
  }
  let missingTok = PathToken{
    file = "file.bit", lineSpecRaw = "", hasSpec = false, docLine = 1, startOffset = 0,
  }
  checkCallExprCitation(
    ctx,
    CitedSymbol{ resolved = "file.bit", tok = missingTok, symbolName = "someFn" },
    ["fn otherFn() {}"],
  )
  let failed = selfCheck(
    sc.failures == 1 && sc.verified == 0,
    "did not fail (report()) a call-expression citation whose symbol is absent entirely",
  )
  let presentTok = PathToken{
    file = "file.bit", lineSpecRaw = "", hasSpec = false, docLine = 2, startOffset = 0,
  }
  checkCallExprCitation(
    ctx,
    CitedSymbol{ resolved = "file.bit", tok = presentTok, symbolName = "otherFn" },
    ["fn otherFn() {}"],
  )
  return failed +
    selfCheck(
      sc.failures == 1 && sc.verified == 1,
      "reported a NEW failure for a call-expression citation whose symbol is present as text",
    )
}
