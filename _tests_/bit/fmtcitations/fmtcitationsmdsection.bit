// _tests_/bit/fmtcitations/fmtcitationsmdsection.bit — the `<path>.md
// §N[.M[.K]]` section-anchor citation kind (#5265), split into its own
// sibling from the moment it was added rather than folded into
// fmtcitationsmd.bit (which was already near E0200's 800-line limit after
// #5265's earlier pure-move split): extraction (extractMdSectionCitations),
// the exact-match heading predicate (headingSectionMatches/
// findHeadingForSection), and the checker (checkSourceMdSection, called
// from scanSourceFile in fmtcitationssrc.bit exactly the way
// checkSourceMdCitation is). Sibling in the same directory module as
// fmtcitationsmd.bit, so everything here calls straight into its
// scanMdPathStart/mdSuffix/maxMdCitations/maxTokenLen and
// fmtcitations.bit's isDigitCh/isWs/isIdentStartCh/trimWs/hasPrefix/
// docLineFor/exists/readFile/split/report/die/maxCitedFileBytes/
// maxCitedFileLines/SourceFileCtx with no import, per docs/development.md's
// "Splitting a file" convention.
//
// A section anchor does not drift when prose is inserted above it, unlike
// the `.md:NNN` line-citation arm (fmtcitationsmd.bit) — spec/SPEC.md:3450
// moved 2246 -> 3193 -> 3243 -> 3420 -> 3425 -> 3450 in one day's landings
// and one more since — so it
// is the durable spelling. It has no line to bounds- or content-check: the
// only thing to verify is that some line in the cited file is a markdown
// heading beginning with that exact number.

// SECTION ANCHORS (#5265): a second citation kind, `<path>.md §N[.M[.K]]`,
// distinct from the `.md:NNN` line kind above. A line number drifts when
// prose is inserted above it — spec/SPEC.md:3450 moved
// 2246 -> 3193 -> 3243 -> 3420 -> 3425 -> 3450 in one day's landings and one
// more since — a section
// number does not, so this is the durable spelling. No line to bounds- or
// content-check: the only thing to verify is that some line in the cited
// file is a markdown heading beginning with that exact number
// (checkSourceMdSection below, beside checkSourceMdQuote — not a variant of
// checkSourceMdCitation's Tier 1, which has a `lineSpecRaw` this kind never
// carries).
//
// `§` is U+00A7, TWO bytes in UTF-8 (0xC2 0xA7) — sectionMarker embeds the
// byte pair and indexOf matches it byte-for-byte, never assuming one byte
// the way `text[i] == '§'` (a rune, not a byte) would.
//
// A real instance: `spec/SPEC.md §14.8` names the Diagnostic Order section
// ("the order in which diagnostics are reported is normative") — the same
// rule this file's split into fmtcitationsmdselftest.bit had to respect.
const sectionMarker: string = ".md §"

// Where a BARE `<basename>.md §N` citation (#5273) may resolve against: the
// directories that actually hold section-anchor targets today
// (runtime/ABI.md, spec/{SPEC,LINT,FMT}.md, docs/**, pkg/**'s own docs).
// `resolveToken` (fmtcitationsextract.bit) already does unique-suffix
// resolution for `.bit` citations against `sourceRoots()`; a bare section
// mention is the same resolution problem one directory component wide
// (`pathComponents("ABI.md") == ["ABI.md"]`), so this reuses it rather than
// re-deriving a second uniqueness check.
fn mdSearchRoots(): []string {
  return ["spec", "runtime", "docs", "pkg"]
}

class MdSectionCitation {
  file: string, section: string, docLine: int, startOffset: int, endOffset: int, qualified: bool,
}

fn isSectionChar(c: u8): bool {
  return isDigitCh(c) || c == '.'
}

// The next ".md §" occurrence in `text` at or after `i`, or -1. Same shape
// as findMdMarker above, over the two-byte marker instead of the one-byte
// ':'.
fn findSectionMarker(text: string, i: int): int {
  let relRaw = indexOf(text[i:len(text)], sectionMarker)
  if (relRaw < 0) {
    return -1
  }
  return i + int(relRaw)
}

// The end of a `N[.M[.K]]` section spec starting at `startAt`, bounded by
// maxTokenLen and always landing one past the last digit — mirrors
// scanMdLineSpecEnd's trailing-separator backoff, since "§14.8," and
// "§14.8)" are both live prose shapes and a spec never ends in '.'.
fn scanSectionEnd(text: string, startAt: int): int {
  let n = len(text)
  let q = startAt
  while (q < n && q - startAt < maxTokenLen && isSectionChar(text[q])) {
    q = q + 1
  }
  while (q > startAt && !isDigitCh(text[q - 1])) {
    q = q - 1
  }
  return q
}

// Every `<dir>/<path>.md §N[.M[.K]]` OR bare `<basename>.md §N[.M[.K]]`
// citation in `text`, via findSectionMarker/scanMdPathStart (reused
// unmodified: both marker shapes start their match at the '.' of ".md", so
// the same backward path scan applies) / scanSectionEnd above.
// `MdSectionCitation.qualified` records which shape matched
// (`indexOf(..., "/") >= 0`) — checkSourceMdSection resolves a bare `file`
// by basename (resolveToken against mdSearchRoots()) before reading it,
// never rewrites `file` itself, so a bare citation's own text is untouched.
//
// #5273: on b5779133 this repo's `.bit` source comments wrote the bare
// spelling ("ABI.md §19", no directory) 677 times and the
// directory-qualified spelling ("runtime/ABI.md §4") 134 times — both
// counts are `./make test-fmt-citations`'s own `bare-section-verified` and
// `section-verified` totals (never hardcoded here, so neither number can go
// stale the way the population comment it replaces did). All 4 basenames
// the bare form named (ABI.md, FMT.md, LINT.md, SPEC.md) were unique across
// every `mdSearchRoots()` directory and every one of the 677 already named
// a real heading, so both spellings are checked as soon as this landed
// (#5265 held the bare spelling back only until that was true).
fn extractMdSectionCitations(text: string): []MdSectionCitation {
  let out = []MdSectionCitation(0)
  let n = len(text)
  let i = 0
  while (i < n && len(out) < maxMdCitations) {
    let markerAt = findSectionMarker(text, i)
    if (markerAt < 0) {
      break
    }
    let afterMarker = markerAt + len(sectionMarker)
    let start = scanMdPathStart(text, markerAt)
    if (start == markerAt || !isIdentStartCh(text[start])) {
      i = afterMarker
      continue
    }
    if (afterMarker >= n || !isDigitCh(text[afterMarker])) {
      i = afterMarker
      continue
    }
    let q = scanSectionEnd(text, afterMarker)
    let pathText = text[start:markerAt]
    out = append(
      out,
      MdSectionCitation{
        file = pathText + mdSuffix, section = text[afterMarker:q],
        docLine = docLineFor(text, start), startOffset = start, endOffset = q,
        qualified = indexOf(pathText, "/") >= 0,
      },
    )
    i = q
  }
  return out
}

// Whether the byte at `rest[end]` (the end of a matched section number)
// is a valid boundary: end of string, or a byte that is neither a digit
// (rejects `§14.8` matching a heading numbered `§14.80`) nor a '.' that
// itself precedes a digit (rejects `§4` matching `### 4.1 ...`). A lone
// trailing '.' with no digit after it — "## 4. Root scanning" — is the
// heading's own punctuation, not a continuation, and passes.
fn headingNumberBoundaryOk(rest: string, end: int): bool {
  if (end >= len(rest)) {
    return true
  }
  if (isDigitCh(rest[end])) {
    return false
  }
  if (rest[end] != '.') {
    return true
  }
  return end + 1 >= len(rest) || !isDigitCh(rest[end + 1])
}

// Whether `line`, trimmed and with its leading "#"s and whitespace
// stripped, begins with EXACTLY `section` — not a prefix match, so `§14.8`
// must not verify against a heading numbered `§14.80`, per
// headingNumberBoundaryOk above.
fn headingSectionMatches(line: string, section: string): bool {
  let trimmed = trimWs(line)
  if (len(trimmed) == 0 || trimmed[0] != '#') {
    return false
  }
  let j = 0
  while (j < len(trimmed) && trimmed[j] == '#') {
    j = j + 1
  }
  while (j < len(trimmed) && isWs(trimmed[j])) {
    j = j + 1
  }
  let rest = trimmed[j:len(trimmed)]
  if (!hasPrefix(rest, section)) {
    return false
  }
  return headingNumberBoundaryOk(rest, len(section))
}

// Whether any line in `lines` is a heading matching `section` exactly.
fn findHeadingForSection(lines: []string, section: string): bool {
  for line of lines {
    if (headingSectionMatches(line, section)) {
      return true
    }
  }
  return false
}

// The QUOTE check's sibling for a section citation: no line number, so no
// bounds/content tier — the anchor either exists as a heading or it does
// not. Reads the cited file directly (the same exists/readFile/split shape
// checkBoundsShared uses, minus the line-spec parse it has no spec for) and
// counts into `fc.sc.sectionVerified` (directory-qualified) or
// `fc.sc.bareSectionVerified` (#5273, bare — resolved by basename first),
// never `verified` or `quoteVerified` — a section anchor is a different
// population, not a stronger or weaker reading of the line-citation one.
fn checkSourceMdSection(fc: SourceFileCtx, c: MdSectionCitation, actualLine: int) {
  fc.sc.citations = fc.sc.citations + 1
  let resolved = c.file
  if (!c.qualified) {
    let (target, ok) = resolveToken(fc.root, c.file, fc.mdIndex, "")
    if (!ok) {
      report(
        fc.sc,
        "${fc.path}:${actualLine}: cites ${c.file} §${c.section}, but ${c.file} is not a unique basename under ${join(
          mdSearchRoots(),
          ", ",
        )}",
      )
      return
    }
    resolved = target
  }
  let full = "${fc.root}/${resolved}"
  if (!exists(full)) {
    report(
      fc.sc,
      "${fc.path}:${actualLine}: cites ${c.file} §${c.section}, but ${resolved} does not exist under the repo root",
    )
    return
  }
  let text = readFile(full) catch e {
    report(
      fc.sc,
      "${fc.path}:${actualLine}: cites ${c.file} §${c.section}, but it could not be read: ${e.message()}",
    )
    return
  }
  if (len(text) > maxCitedFileBytes) {
    die("${resolved} is ${len(text)} bytes, over the ${maxCitedFileBytes} bound")
  }
  let lines = split(text, "\n")
  if (len(lines) > maxCitedFileLines) {
    die("${resolved} has ${len(lines)} lines, over the ${maxCitedFileLines} bound")
  }
  if (!findHeadingForSection(lines, c.section)) {
    report(
      fc.sc,
      "${fc.path}:${actualLine}: cites ${c.file} §${c.section}, but no heading in ${resolved} begins with that section number",
    )
    return
  }
  if (c.qualified) {
    fc.sc.sectionVerified = fc.sc.sectionVerified + 1
  } else {
    fc.sc.bareSectionVerified = fc.sc.bareSectionVerified + 1
  }
}
