// _tests_/bit/fmtcitations/fmtcitationsselftest.bit — synthetic-text self-checks
// for the scanner in fmtcitations.bit, split out to keep that file under the
// repo's 800-line limit (E0200). Sibling in the same directory module, so
// every function it calls (extractPathTokens, findAssociatedSymbol,
// extractDecls, parseSegments, resolveToken, extractHedges) resolves with no
// import — same module, no namespace change, per docs/development.md's
// "Splitting a file" convention.
//
// Runs BEFORE the real scan (`main`, fmtcitations.bit), on synthetic text, so
// a scanner bug is caught before it silently mis-scores a real document.

fn selfCheck(cond: bool, label: string): int {
  if (cond) {
    return 0
  }
  eprint("fmtcitations: SELFTEST FAIL: ${label}\n")
  return 1
}

fn selfTestPathTokens(): int {
  let failed = 0
  let text = "See `myFn`, `compiler/fmt.bit:5-9` and bare `compiler/fmtwrap.bit` mention, then `other`, `compiler/fmtdispatch.bit:20, 30-31`."
  let toks = extractPathTokens(text, "compiler/fmt")
  failed = failed + selfCheck(len(toks) == 3, "did not find exactly 3 citations")
  if (len(toks) == 3) {
    failed = failed +
      selfCheck(
        toks[0].file == "compiler/fmt.bit" && toks[0].hasSpec && toks[0].lineSpecRaw == "5-9",
        "misparsed the ranged citation",
      )
    failed = failed +
      selfCheck(
        toks[1].file == "compiler/fmtwrap.bit" && !toks[1].hasSpec,
        "misparsed the bare mention",
      )
    failed = failed +
      selfCheck(
        toks[2].file == "compiler/fmtdispatch.bit" && toks[2].lineSpecRaw == "20, 30-31",
        "misparsed the multi-segment citation",
      )
  }
  // Unfiltered: full, partial (dir+basename), and bare-basename tokens all extract.
  let toks2 = extractPathTokens(
    "`runtime/root/floats.bit:172` then `linux/boot.bit:189,254` then bare `scratch.bit:77`.",
    "",
  )
  failed = failed + selfCheck(len(toks2) == 3, "unfiltered scan did not find exactly 3 tokens")
  if (len(toks2) == 3) {
    failed = failed +
      selfCheck(toks2[0].file == "runtime/root/floats.bit", "misparsed the full-path token")
    failed = failed +
      selfCheck(toks2[1].file == "linux/boot.bit", "misparsed the partial-path token")
    failed = failed + selfCheck(toks2[2].file == "scratch.bit", "misparsed the bare-basename token")
  }
  // A glob has no path char before ".bit" and must never be extracted.
  failed = failed +
    selfCheck(
      len(extractPathTokens("matches under `runtime/**/*.bit` and nothing else", "")) == 0,
      "wrongly extracted a token from a glob pattern",
    )
  return failed
}

fn selfTestAssociation(): int {
  let failed = 0
  let t1 = "rule (`fmtFoo`, `compiler/fmt.bit:5-9`) applies"
  let c1 = extractPathTokens(t1, "")
  failed = failed +
    selfCheck(
      len(c1) == 1 && findAssociatedSymbol(t1, c1[0].startOffset) == "fmtFoo",
      "did not associate a comma-connected name",
    )
  let t2 = "call `fmtFoo` (`compiler/fmt.bit:5-9`) applies"
  let c2 = extractPathTokens(t2, "")
  failed = failed +
    selfCheck(
      len(c2) == 1 && findAssociatedSymbol(t2, c2[0].startOffset) == "fmtFoo",
      "did not associate a paren-connected name",
    )
  let t3 = "`fmtFoo`'s own branch, `compiler/fmt.bit:5-9` applies"
  let c3 = extractPathTokens(t3, "")
  failed = failed +
    selfCheck(
      len(c3) == 1 && findAssociatedSymbol(t3, c3[0].startOffset) == "",
      "wrongly associated across a possessive connector",
    )
  let t4 = "the `fmtGap(p, true)`, `compiler/fmt.bit:5-9` call"
  let c4 = extractPathTokens(t4, "")
  failed = failed +
    selfCheck(
      len(c4) == 1 && findAssociatedSymbol(t4, c4[0].startOffset) == "",
      "wrongly associated a call expression",
    )
  return failed
}

// #4288: a backtick-quoted symbol closing one comment line and the
// `(file.bit)` opening the next must associate — the connector was "// (",
// never "(", and every citation written that way was never checked. Driven
// THROUGH `extractCommentBlocks` (fmtcitationssrc.bit), not a hand-built
// string, so this asserts the text the real scan sees.
fn selfTestAssociationAcrossWrap(): int {
  let blocks = extractCommentBlocks(
    [
      "  // takes the fast path in `lowerAppend`",
      "  // (lowerappend.bit) and never the general one",
    ],
  )
  let failed = selfCheck(len(blocks) == 1, "did not join the two comment lines into one block")
  if (len(blocks) != 1) {
    return failed
  }
  let text = blocks[0].text
  let toks = extractPathTokens(text, "")
  failed = failed + selfCheck(len(toks) == 1, "did not find the wrapped citation")
  if (len(toks) != 1) {
    return failed
  }
  return failed +
    selfCheck(
      findAssociatedSymbol(text, toks[0].startOffset) == "lowerAppend",
      "did not associate a symbol with a citation on the NEXT comment line",
    )
}

// #3611: a comma-chained run of citations sharing one preceding "/"-joined
// symbol list must pair by LEFT-TO-RIGHT POSITION (nth symbol -> nth
// citation), not by nearest-name proximity — the shape docs/development.md
// uses for `` `lowerSourceModule`/`checkSourceDump` (`a.bit:1`, `b.bit:2`) ``.
fn selfTestAssociationMultiSymbol(): int {
  let failed = 0
  let t1 = "through `lowerSourceModule`/`checkSourceDump` (`compiler/lowerdriver.bit:312`, `compiler/checkmodule.bit:490`) and never"
  let c1 = extractPathTokens(t1, "")
  failed = failed + selfCheck(len(c1) == 2, "did not find both citations in the multi-symbol pair")
  if (len(c1) == 2) {
    failed = failed +
      selfCheck(
        findAssociatedSymbol(t1, c1[0].startOffset) == "lowerSourceModule",
        "did not pair the FIRST symbol with the FIRST citation",
      )
    failed = failed +
      selfCheck(
        findAssociatedSymbol(t1, c1[1].startOffset) == "checkSourceDump",
        "did not pair the SECOND symbol with the SECOND citation",
      )
  }
  // A three-way "/" list against two citations: the extra (rightmost,
  // nearest-to-"(") symbol has no citation of its own and must be dropped,
  // not guessed at — "a"/"b" pair left-to-right with the two citations.
  let t2 = "via `a`/`b`/`c` (`compiler/fmt.bit:1`, `compiler/fmtwrap.bit:2`) here"
  let c2 = extractPathTokens(t2, "")
  failed = failed + selfCheck(len(c2) == 2, "did not find both citations in the three-symbol list")
  if (len(c2) == 2) {
    failed = failed +
      selfCheck(
        findAssociatedSymbol(t2, c2[0].startOffset) == "a",
        "did not pair the first symbol with the first citation",
      )
    failed = failed +
      selfCheck(
        findAssociatedSymbol(t2, c2[1].startOffset) == "b",
        "did not pair the second symbol with the second citation, dropping the unmatched third",
      )
  }
  // A single symbol followed by two "and"-joined citations: only the first
  // is comma-connected, so only it may associate; "and" must stay a no-op.
  let t3 = "the (`fmtFoo`, `compiler/fmt.bit:1` and `compiler/fmtwrap.bit:2`) pair"
  let c3 = extractPathTokens(t3, "")
  failed = failed + selfCheck(len(c3) == 2, "did not find both citations in the and-joined pair")
  if (len(c3) == 2) {
    failed = failed +
      selfCheck(
        findAssociatedSymbol(t3, c3[0].startOffset) == "fmtFoo",
        "did not associate the comma-connected first citation",
      )
    failed = failed +
      selfCheck(
        findAssociatedSymbol(t3, c3[1].startOffset) == "",
        "wrongly associated across an \"and\" connector",
      )
  }
  return failed
}

fn selfTestDecls(): int {
  let failed = 0
  let decls = extractDecls(
    ["// header", "const fmtMaxWidth = 100", "", "fn fmtFoo(p: Printer) {", "  return 1", "}"],
  )
  failed = failed + selfCheck(len(decls) == 2, "did not find both declarations")
  if (len(decls) == 2) {
    failed = failed +
      selfCheck(
        decls[0].name == "fmtMaxWidth" && decls[0].line == 2,
        "misparsed the const declaration",
      )
    failed = failed +
      selfCheck(decls[1].name == "fmtFoo" && decls[1].line == 4, "misparsed the fn declaration")
  }
  // #4257: `export`/`@annotation`-prefixed declarations, previously invisible
  // (851 of ~8046 real top-level declarations in this repo carry one).
  let decls2 = extractDecls(
    [
      "export fn addLocalDependency(p: Project): bool {", "export @nosplit fn mapCapForHint(n: int): int {",
      "@inline fn helper() {",
    ],
  )
  failed = failed + selfCheck(len(decls2) == 3, "did not find all 3 modifier-prefixed declarations")
  if (len(decls2) == 3) {
    failed = failed +
      selfCheck(decls2[0].name == "addLocalDependency", "misparsed an `export fn` declaration")
    failed = failed +
      selfCheck(
        decls2[1].name == "mapCapForHint",
        "misparsed an `export @nosplit fn` declaration (stacked modifiers)",
      )
    failed = failed +
      selfCheck(decls2[2].name == "helper", "misparsed an `@annotation fn` declaration")
  }
  return failed
}

fn selfTestSegments(): int {
  let failed = 0
  let segs1 = parseSegments("5-9")
  failed = failed +
    selfCheck(
      len(segs1) == 1 && segs1[0].ok && segs1[0].start == 5 && segs1[0].end == 9,
      "misparsed a single range",
    )
  let segs2 = parseSegments("267, 294")
  failed = failed +
    selfCheck(
      len(segs2) == 2 && segs2[0].start == 267 && segs2[1].start == 294,
      "misparsed a two-value list",
    )
  let segs3 = parseSegments("12-x")
  failed = failed + selfCheck(len(segs3) == 1 && !segs3[0].ok, "accepted a non-numeric range end")
  return failed
}

// index/context fixtures shared by every resolveToken case below.
fn selfTestResolve(): int {
  let failed = 0
  let index = [
    "runtime/root/floats.bit", "runtime/root/os.bit", "runtime/root/linux/os.bit",
    "runtime/root/darwin/os.bit", "runtime/net/linux/netabi.bit", "runtime/net/darwin/netabi.bit",
  ]
  let (r1, ok1) = resolveToken(".", "floats.bit", index, "")
  failed = failed +
    selfCheck(
      ok1 && r1 == "runtime/root/floats.bit",
      "did not resolve a uniquely-suffixed bare basename",
    )
  let (r2, ok2) = resolveToken(".", "linux/netabi.bit", index, "")
  failed = failed +
    selfCheck(
      ok2 && r2 == "runtime/net/linux/netabi.bit",
      "did not resolve a directory-qualified partial path",
    )
  let (r3, ok3) = resolveToken(".", "os.bit", index, "runtime/root/os.bit")
  failed = failed +
    selfCheck(
      ok3 && r3 == "runtime/root/os.bit",
      "did not fall back to context for an ambiguous basename",
    )
  let (_, ok4) = resolveToken(".", "os.bit", index, "")
  failed = failed + selfCheck(!ok4, "guessed at an ambiguous basename with no context")
  let (_, ok5) = resolveToken(".", "os.bit", index, "runtime/root/floats.bit")
  failed = failed + selfCheck(!ok5, "used a context inconsistent with the token's own basename")
  return failed
}

fn selfTestHedges(): int {
  let failed = 0
  let text = "Rewrite it (the two functions, ~line 591/599) for the new arithmetic. `allocString` (~line 510) additionally. Six funnels (~444/452), (~392/400)."
  let hs = extractHedges(text)
  failed = failed + selfCheck(len(hs) == 4, "did not find exactly 4 hedge markers")
  if (len(hs) == 4) {
    failed = failed + selfCheck(hs[0].lineSpecRaw == "591/599", "misparsed a two-value ~line hedge")
    failed = failed + selfCheck(hs[1].lineSpecRaw == "510", "misparsed a single-value ~line hedge")
    failed = failed +
      selfCheck(hs[2].lineSpecRaw == "444/452", "misparsed a bare parenthesized hedge")
    failed = failed +
      selfCheck(hs[3].lineSpecRaw == "392/400", "misparsed the second bare parenthesized hedge")
  }
  failed = failed +
    selfCheck(
        len(extractHedges("the kernel rounded a 1us sleep to ~75us and the shim reserves ~300 bytes")) ==
        0,
      "wrongly treated a duration/count as a line hedge",
    )
  return failed
}

// #4257: extractCommentBlocks (fmtcitationssrc.bit) must join only
// CONSECUTIVE `//` lines, and stop at code/blank lines, so a citation in one
// block can never associate across an unrelated block.
fn selfTestCommentBlocks(): int {
  let failed = 0
  let blocks = extractCommentBlocks(
    ["// block one line A", "// block one line B", "code()", "", "// block two"],
  )
  failed = failed + selfCheck(len(blocks) == 2, "did not find exactly 2 comment blocks")
  if (len(blocks) == 2) {
    failed = failed +
      selfCheck(
        blocks[0].startLine == 1 && blocks[0].text == "   block one line A\n   block one line B",
        "misjoined the first block, or did not blank each line\'s own \"//\" marker",
      )
    failed = failed +
      selfCheck(blocks[1].startLine == 5, "misnumbered the second block's start line")
  }
  return failed
}

// #4257's named trap: "same module as X.bit: `a`, `b` are declared there"
// cites the file BEFORE its symbol list, so findAssociatedSymbol (which
// only looks backward) must find nothing — verified against the exact real
// shape (_tests_/bit/golden/stage.bit:10), not a paraphrase of it.
fn selfTestSourceSameModuleForward(): int {
  let text = "// same module as golden.bit: `dRun`..\n" +
    "// `dPanicDebug`, `Ctx`, `failCase` and `isRunLike` are declared there"
  let toks = extractPathTokens(text, "")
  return selfCheck(len(toks) == 1, "did not find exactly one .bit token") +
    selfCheck(
      len(toks) != 1 || findAssociatedSymbol(text, toks[0].startOffset) == "",
      "wrongly associated a symbol that follows its citation, not precedes it",
    )
}

// #4257: "fileA.bit's `sym1`, fileB.bit's `sym2`" — each symbol belongs to
// the file whose name IMMEDIATELY precedes it via "'s", not the NEXT file
// token in sequence. The real shape is compiler/pmz.bit:148: "(`pmcliaddref.bit`'s
// `addLocalDependency`, `pmcliup.bit`'s `upDependencies`)" — a naive
// backward chain wrongly pairs `addLocalDependency` with `pmcliup.bit`.
fn selfTestSourcePossessive(): int {
  let failed = 0
  let text = "(`pmcliaddref.bit`'s `addLocalDependency`, `pmcliup.bit`'s `upDependencies`)"
  let toks = extractPathTokens(text, "")
  failed = failed + selfCheck(len(toks) == 2, "did not find exactly 2 .bit tokens")
  if (len(toks) == 2) {
    // The SECOND file token (pmcliup.bit) is itself the possessive SUBJECT
    // of `upDependencies` — resolveSourceToken's caller must refuse it, not
    // reuse addLocalDependency for it.
    failed = failed +
      selfCheck(
        followedByPossessive(text, tokenRawEnd(text, toks[1])),
        "did not detect pmcliup.bit as a possessive subject",
      )
    // And the window guard must see pmcliaddref.bit's OWN possessive sitting
    // just before pmcliup.bit, so a caller checking pmcliup.bit's citation
    // refuses to trust whatever symbol a backward scan would find.
    failed = failed +
      selfCheck(
        hasPossessiveFileBefore(text, toks[1].startOffset),
        "did not detect the preceding possessive file citation",
      )
  }
  // A citation with a leading "./" stripped by normalization must still be
  // detected as possessive — tokenRawEnd must not undercount by the
  // stripped character (found via "./root.bit's own", runtime/root/backtrace.bit:64).
  let text2 = "(./root.bit's own import)"
  let toks2 = extractPathTokens(text2, "")
  failed = failed + selfCheck(len(toks2) == 1, "did not find the leading-./ token")
  if (len(toks2) == 1) {
    failed = failed +
      selfCheck(
        followedByPossessive(text2, tokenRawEnd(text2, toks2[0])),
        "undercounted a token's raw end after a stripped leading \"/\"",
      )
  }
  return failed
}

// #4257: a citation example wrapped in a pair of TWO-backtick markers
// (markdown's escape for "this span itself contains a backtick") is a
// GENERIC ILLUSTRATION, never a real citation — the real shape is this
// module's own header comments; see fmtcitationssrc.bit's header for one.
fn selfTestDoubleBacktickSpan(): int {
  let text = "shape (`` `sym` (`a.bit:1`) ``) illustrated"
  let positions = doubleBacktickPositions(text)
  let toks = extractPathTokens(text, "")
  return selfCheck(len(positions) == 2, "did not find exactly one `` `` `` pair") +
    selfCheck(len(toks) == 1, "did not find the example's .bit token") +
    selfCheck(
      len(toks) != 1 || isInsideDoubleBacktickSpan(positions, toks[0].startOffset),
      "did not treat the escaped example as inert",
    )
}

// #4653: the exact composition checkSourceMdCitation performs on a source
// comment -- extract the comment block, find the document citation in it,
// and bounds-check its number against the cited file's line count. The
// out-of-range half is the case that stayed green for the whole life of the
// source-comment scan: an injected 99999 moved no counter and failed
// nothing. 793 is spec/LINT.md's line count on 2026-09-09; the check only
// has to reject a number past the end, so nothing here re-reads the file.
fn selfTestSourceMdBounds(): int {
  let failed = 0
  let blocks = extractCommentBlocks(["// the complexity ceiling (spec/LINT.md:186)", "code()"])
  failed = failed + selfCheck(len(blocks) == 1, "did not find the comment block")
  if (len(blocks) == 1) {
    let cites = extractMdCitations(blocks[0].text)
    failed = failed +
      selfCheck(len(cites) == 1, "did not find the .md citation inside a comment block")
    failed = failed +
      selfCheck(
        len(cites) != 1 || segsInBounds(parseSegments(cites[0].lineSpecRaw), 793),
        "rejected an in-range .md citation from a source comment",
      )
  }
  let bad = extractMdCitations("// the complexity ceiling (spec/LINT.md:99999)")
  failed = failed + selfCheck(len(bad) == 1, "did not find the out-of-range .md citation")
  failed = failed +
    selfCheck(
      len(bad) != 1 || !segsInBounds(parseSegments(bad[0].lineSpecRaw), 793),
      "accepted a .md citation past the cited file's last line",
    )
  return failed
}

// #4677: the source arm's quoted annotation, checked against the cited line
// with CONTAINS instead of the docs arm's heading predicate. The measured
// instance is the byte order mark sentence, which lives at line 70 of
// spec/SPEC.md while five comments named line 68 — an in-range bullet about
// modules, which bounds and content both pass. `bomLine` below is that
// sentence verbatim; `moduleLine` is the line those comments actually named,
// and the check is worth nothing unless it separates the two.
fn selfTestSourceQuoteAnnotation(): int {
  let bomLine = "- The byte order mark `U+FEFF`, if present as the first character, is ignored."
  let moduleLine = "- A **module** is a directory. Every `.bit` file directly inside that directory"
  let lines = [moduleLine, bomLine]
  let needle = "if present as the first character"
  let failed = 0
  failed = failed + selfCheck(lineContainsQuoted(lines, 2, needle), "rejected the quoted sentence")
  failed = failed +
    selfCheck(!lineContainsQuoted(lines, 1, needle), "accepted the line the drift landed on")
  failed = failed + selfCheck(!lineContainsQuoted(lines, 0, needle), "accepted line 0")
  failed = failed + selfCheck(!lineContainsQuoted(lines, 3, needle), "accepted a line past the end")
  failed = failed + selfCheck(!lineContainsQuoted(lines, 2, ""), "accepted an empty quote")
  return failed + selfTestCommentQuoteUnwrap(needle, bomLine)
}

// A `("...")` annotation that crossed a comment line wrap carries the next
// line's "//" and indentation inside the quote; unwrapCommentQuote is what
// makes it comparable against the single markdown line it names. Split out
// of selfTestSourceQuoteAnnotation to keep both under the complexity ceiling
// (spec/LINT.md:186, E0204).
fn selfTestCommentQuoteUnwrap(needle: string, bomLine: string): int {
  let failed = 0
  failed = failed + selfCheck(unwrapCommentQuote(needle) == needle, "rewrote an unwrapped quote")
  failed = failed +
    selfCheck(
      unwrapCommentQuote("if present as\n//  the first character") == needle,
      "did not rejoin a quote wrapped across two comment lines",
    )
  failed = failed +
    selfCheck(
      unwrapCommentQuote("if present\n//   as the\n// first character") == needle,
      "did not rejoin a quote wrapped across three comment lines",
    )
  // The wrapped form must still reach the same verdict the flat one does —
  // rejoining that produced text the cited line does not carry would be a
  // false PASS, which is the failure mode worth testing for.
  let block = "// per spec/SPEC.md:70 (\"if present as\n//  the first character\") and so on"
  let cites = extractMdCitations(block)
  failed = failed + selfCheck(len(cites) == 1, "did not find the annotated source citation")
  if (len(cites) == 1) {
    let (raw, ok) = headingAnnotationAfter(block, cites[0].endOffset)
    failed = failed + selfCheck(ok, "did not read the annotation off a comment block")
    failed = failed +
      selfCheck(
        lineContainsQuoted([bomLine], 1, unwrapCommentQuote(raw)),
        "a wrapped annotation did not verify against the line it quotes",
      )
  }
  return failed
}

// #4682: the FORWARD association rule. "fileA.bit's `sym1`/`sym2`,
// fileB.bit's `sym3`" — the shape both possessive guards exist for — must
// now pair sym1 and sym2 with fileA.bit and sym3 with fileB.bit, and must
// stop at the comma that carries the next citation rather than swallowing
// its symbol into the first file's list.
fn selfTestPossessiveForward(): int {
  let text = "(`fileA.bit`'s `sym1`/`sym2`, `fileB.bit`'s `sym3`)"
  let toks = extractPathTokens(text, "")
  let failed = selfCheck(len(toks) == 2, "did not find exactly 2 possessive tokens")
  if (len(toks) != 2) {
    return failed
  }
  let first = possessiveSymbolsAfter(text, tokenRawEnd(text, toks[0]))
  failed = failed + selfCheck(len(first) == 2, "did not pair both of fileA.bit's symbols")
  failed = failed +
    selfCheck(
      len(first) != 2 || (first[0] == "sym1" && first[1] == "sym2"),
      "misread fileA.bit's symbol list",
    )
  let second = possessiveSymbolsAfter(text, tokenRawEnd(text, toks[1]))
  failed = failed +
    selfCheck(
      len(second) == 1 && second[0] == "sym3",
      "did not pair fileB.bit with its own symbol alone",
    )
  return failed + selfTestPossessiveShapes()
}

// The real #4280 shape, verbatim from _tests_/bit/lowerrefuse.bit:106 — three
// possessives in one sentence, joined by "," and "and", each owning exactly
// one symbol. A rule that read the connector as a list separator would give
// the first file all three symbols and then report two files it never named.
fn selfTestPossessiveShapes(): int {
  let blocks = extractCommentBlocks(
    [
      "// compiler/loweraccess.bit's `lowerIndex`, compiler/lowerassign.bit's",
      "// `resolveLvalue` and compiler/lowerflow.bit's `lowerIndexStore` are the units",
    ],
  )
  if (len(blocks) != 1) {
    return selfCheck(false, "did not join the wrapped possessive lines into one block")
  }
  let text = blocks[0].text
  let toks = extractPathTokens(text, "")
  let failed = selfCheck(len(toks) == 3, "did not find the three chained possessives")
  if (len(toks) == 3) {
    failed = failed +
      selfCheck(
        len(possessiveSymbolsAfter(text, tokenRawEnd(text, toks[0]))) == 1,
        "gave the first file more than its own symbol",
      )
    // The second file's symbol sits on the NEXT comment line: a rule that
    // stopped at the wrap would silently check nothing here.
    let wrapped = possessiveSymbolsAfter(text, tokenRawEnd(text, toks[1]))
    failed = failed +
      selfCheck(
        len(wrapped) == 1 && wrapped[0] == "resolveLvalue",
        "did not follow a possessive across a comment line wrap",
      )
  }
  // "'s own header" names no symbol this gate can look up: associate nothing
  // rather than reaching past the prose for the next backtick in the file.
  let prose = "see `abiarity.bit`'s own header, then `directEmissionSymbols`"
  let proseToks = extractPathTokens(prose, "")
  failed = failed + selfCheck(len(proseToks) == 1, "did not find the prose possessive token")
  failed = failed +
    selfCheck(
        len(proseToks) != 1 ||
        len(possessiveSymbolsAfter(prose, tokenRawEnd(prose, proseToks[0]))) == 0,
      "associated a symbol that prose separates from its possessive",
    )
  return failed + selfTestPossessivePaths()
}

// #4682: the two path shapes the token scanner cannot carry, both measured
// wrong before this ticket. A "../" run is placed against the citing file's
// directory (runtime/root/windows/fs.bit:43 cites `../os.bit`, which is
// runtime/root/os.bit, NOT the windows/os.bit sitting beside it), and a
// brace/glob/`<os>` family path names no single file at all.
fn selfTestPossessivePaths(): int {
  let text = "as `../../stw/stw.bit`'s `stwReadSp` and `<os>/io.bit`'s `ioConstBuf` do"
  let toks = extractPathTokens(text, "")
  let failed = selfCheck(len(toks) == 2, "did not find both relative-path tokens")
  if (len(toks) == 2) {
    failed = failed +
      selfCheck(
        relativePrefixBefore(text, toks[0].startOffset) == "../..",
        "misread the \"../../\" prefix the token scanner dropped",
      )
    failed = failed +
      selfCheck(!namesProviderFamily(text, toks[0].startOffset), "called a real path a family")
    failed = failed +
      selfCheck(
        namesProviderFamily(text, toks[1].startOffset),
        "did not recognize a `<os>/` provider-family path",
      )
  }
  failed = failed + selfCheck(countDotDot("../../") == 2, "miscounted \"../../\"")
  failed = failed + selfCheck(countDotDot("./") == 0, "read \"./\" as a level up")
  failed = failed +
    selfCheck(relativePrefixBefore("x.bit", 0) == "", "invented a prefix at offset 0")
  return failed
}

// Runs BEFORE the real scan, on synthetic text, so a scanner bug is caught
// before it silently mis-scores a real document.
fn selfTest(): int {
  return selfTestPathTokens() +
    selfTestAssociation() +
    selfTestAssociationAcrossWrap() +
    selfTestAssociationMultiSymbol() +
    selfTestDecls() +
    selfTestSegments() +
    selfTestResolve() +
    selfTestHedges() +
    selfTestMdCitations() +
    selfTestMdHeadingAnnotation() +
    selfTestCommentBlocks() +
    selfTestSourceSameModuleForward() +
    selfTestSourcePossessive() +
    selfTestDoubleBacktickSpan() +
    selfTestSourceMdBounds() +
    selfTestMdRangeCitations() +
    selfTestCitableContent() +
    selfTestSourceQuoteAnnotation() +
    selfTestPossessiveForward() +
    selfTestFixtureCorpusDirs()
}
