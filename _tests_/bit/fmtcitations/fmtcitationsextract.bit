// _tests_/bit/fmtcitations/fmtcitationsextract.bit — the two raw-text scans
// every check in this module runs over: extractPathTokens (path-token
// citations, e.g. "compiler/fmt.bit:78") and extractHedges (a hedged
// "~line N" or bare "(~N)" citation). Split out of fmtcitations.bit to keep
// that file under the repo's 800-line limit (E0200). Sibling in the same
// directory module, so both functions call straight into fmtcitations.bit's
// PathToken/Hedge/docLineFor/isIdentContCh/isIdentStartCh/trimWs consts and
// helpers with no import, matching the convention documented in
// docs/development.md's "Splitting a file" section and already used by
// fmtcitationsassoc.bit (#3611). Called from checkDocument in fmtcitations.bit.
//
// Each scan's per-position decision logic is further split into small
// primitive-returning helpers (int/bool/string, never a tuple or a result
// class) purely to bring the two loop functions themselves under E0204's
// complexity-10 limit — see #3664/#3686. A sentinel value (-1, or the
// unchanged input offset) stands in for "nothing found" instead of a second
// return value, so no extraction here adds an allocation.

// The start of the run of identifier/slash characters immediately before
// `bitStart` (a literal ".bit"'s offset), scanned backward and capped at
// maxTokenLen. Returns `bitStart` itself if nothing path-like precedes it.
fn scanPathTokenStart(text: string, bitStart: int): int {
  let start = bitStart
  let floor = bitStart - maxTokenLen
  if (floor < 0) {
    floor = 0
  }
  while (start > floor && (isIdentContCh(text[start - 1]) || text[start - 1] == '/')) {
    start = start - 1
  }
  return start
}

// Whether the character right after a literal ".bit" continues an
// identifier (e.g. ".bits", "*.bitfoo") — such a match is not a citation.
fn pathTokenIsGlobLike(text: string, n: int, afterBit: int): bool {
  return afterBit < n && isIdentContCh(text[afterBit])
}

// Strips a leading "/" left over from brace-expansion (e.g. "/boot.bit"),
// treating it as its bare basename.
fn normalizePathTokenName(fileName: string): string {
  if (len(fileName) > 0 && fileName[0] == '/') {
    return fileName[1:len(fileName)]
  }
  return fileName
}

// Whether `fileName` is a real identifier-led filename (not empty, not
// punctuation-led) and, if `requiredPrefix` is set, contains it.
fn isPathTokenAcceptable(fileName: string, requiredPrefix: string): bool {
  if (len(fileName) == 0 || !isIdentStartCh(fileName[0])) {
    return false
  }
  return len(requiredPrefix) == 0 || contains(fileName, requiredPrefix)
}

// The end of a `:N[-M][, N[-M]...]` line spec starting right after
// `afterBit`, or -1 if `text[afterBit]` is not ':'. May return
// `afterBit + 1` (an empty spec, e.g. a bare trailing colon) — the caller
// decides whether that counts as "found".
fn scanPathTokenSpecEnd(text: string, n: int, afterBit: int): int {
  if (afterBit >= n || text[afterBit] != ':') {
    return -1
  }
  let specStart = afterBit + 1
  let q = specStart
  while (q < n && q - specStart < maxLineSpecLen && isLineSpecChar(text[q])) {
    q = q + 1
  }
  return q
}

// Every `<path>.bit` occurrence: find each literal ".bit", scan BACKWARD
// over identifier/slash chars for the token's start, then optionally
// forward over a `:N[-M][, N[-M]...]` spec. `requiredPrefix` (if set)
// discards a token not containing that substring. `i` only ever advances.
fn extractPathTokens(text: string, requiredPrefix: string): []PathToken {
  let out = []PathToken(0)
  let n = len(text)
  let i = 0
  while (i < n && len(out) < maxPathTokens) {
    let relRaw = indexOf(text[i:n], bitSuffix)
    if (relRaw < 0) {
      break
    }
    let bitStart = i + int(relRaw)
    let afterBit = bitStart + len(bitSuffix)
    if (pathTokenIsGlobLike(text, n, afterBit)) {
      i = bitStart + 1
      continue
    }
    let start = scanPathTokenStart(text, bitStart)
    if (start == bitStart) {
      i = afterBit // nothing path-like precedes ".bit" (e.g. a glob) -- not a citation
      continue
    }
    let fileName = normalizePathTokenName(text[start:bitStart] + bitSuffix)
    if (!isPathTokenAcceptable(fileName, requiredPrefix)) {
      i = afterBit
      continue
    }
    let specEnd = scanPathTokenSpecEnd(text, n, afterBit)
    let lineSpecRaw = ""
    let endOffset = afterBit
    if (specEnd >= 0) {
      let raw = trimWs(text[afterBit + 1:specEnd])
      if (len(raw) > 0) {
        lineSpecRaw = raw
        endOffset = specEnd
      }
    }
    out = append(
      out,
      PathToken{
        file: fileName, lineSpecRaw: lineSpecRaw, hasSpec: len(lineSpecRaw) > 0,
        docLine: docLineFor(text, start), startOffset: start,
      },
    )
    i = endOffset
  }
  return out
}

// The start of a hedge's line spec: right after "line " if `text[tildeAt:]`
// begins with that word, or right after "~" itself if `text[tildeAt-1]` is
// "(" (a bare "(~N)"). -1 if neither hedge form matches at `tildeAt`.
fn hedgeSpecStart(text: string, n: int, tildeAt: int): int {
  let specStart = tildeAt + 1
  let viaLineWord = specStart + len(hedgeLineWord) <= n &&
    text[specStart:specStart + len(hedgeLineWord)] == hedgeLineWord
  if (viaLineWord) {
    return specStart + len(hedgeLineWord)
  }
  let viaParen = tildeAt > 0 && text[tildeAt - 1] == '('
  if (viaParen) {
    return specStart
  }
  return -1
}

// A digit or one of the separators a hedge spec allows ("-", "/", ",", " ").
fn isHedgeSpecChar(c: u8): bool {
  return (c >= '0' && c <= '9') || c == '-' || c == '/' || c == ',' || c == ' '
}

// The end of the run of `isHedgeSpecChar` bytes starting at `specStart`,
// capped at maxLineSpecLen.
fn scanHedgeSpecEnd(text: string, n: int, specStart: int): int {
  let q = specStart
  while (q < n && q - specStart < maxLineSpecLen && isHedgeSpecChar(text[q])) {
    q = q + 1
  }
  return q
}

// Whether a trimmed hedge spec is non-empty and digit-led (never a
// duration/count like "~75us", which is why a bare hedge always requires
// its first non-space character to be a digit).
fn isValidHedgeSpec(raw: string): bool {
  return len(raw) > 0 && raw[0] >= '0' && raw[0] <= '9'
}

// Every hedge: `~line N[/M][-M]` or a bare `(~N[/M][-M])` right after "(" —
// never a duration/count (`~75us`), which is why both require direct adjacency.
fn extractHedges(text: string): []Hedge {
  let out = []Hedge(0)
  let n = len(text)
  let i = 0
  while (i < n && len(out) < maxHedges) {
    let relRaw = indexOf(text[i:n], "~")
    if (relRaw < 0) {
      break
    }
    let tildeAt = i + int(relRaw)
    let specStart = hedgeSpecStart(text, n, tildeAt)
    if (specStart < 0) {
      i = tildeAt + 1
      continue
    }
    let q = scanHedgeSpecEnd(text, n, specStart)
    let raw = trimWs(text[specStart:q])
    if (!isValidHedgeSpec(raw)) {
      i = tildeAt + 1
      continue
    }
    out = append(
      out,
      Hedge{ lineSpecRaw: raw, docLine: docLineFor(text, tildeAt), startOffset: tildeAt },
    )
    i = q
  }
  return out
}

// `p` split on "/" with empty components dropped.
fn pathComponents(p: string): []string {
  let parts = split(p, "/")
  let out = []string(0)
  for part of parts {
    if (len(part) > 0) {
      out = append(out, part)
    }
  }
  return out
}

// Whether `candidateComps`'s LAST `len(tokenComps)` components equal
// `tokenComps` in order — e.g. candidate [runtime,root,linux,boot.bit]
// matches token [linux,boot.bit] but not [darwin,boot.bit].
fn suffixMatches(candidateComps: []string, tokenComps: []string): bool {
  let n = len(tokenComps)
  let m = len(candidateComps)
  if (n == 0 || n > m) {
    return false
  }
  let offset = m - n
  let i = 0
  while (i < n) {
    if (candidateComps[offset + i] != tokenComps[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// Every file under `<root>/<searchRoot>` whose name ends in `suffix`, as
// repo-relative paths. `suffix` rather than a hardcoded ".bit" because
// `fixtureCorpusDirs` (fmtcitationsassoc.bit) needs the `.expected` files out
// of this same walk, and a second copy of the walk/strip arithmetic is a
// second place for the "${root}/" prefix to be got wrong.
fn buildIndexOf(root: string, searchRoot: string, suffix: string): []string {
  let walkArg = searchRoot
  let strip = ""
  if (root != ".") {
    walkArg = "${root}/${searchRoot}"
    strip = "${root}/"
  }
  let all = walk(walkArg) catch e {
    die("cannot walk ${walkArg}: ${e.message()}")
    []string(0)
  }
  if (len(all) > maxIndexFiles) {
    die("${walkArg} holds ${len(all)} entries, over the maxIndexFiles bound of ${maxIndexFiles}")
  }
  let out = []string(0)
  for p of all {
    if (!hasSuffix(p, suffix)) {
      continue
    }
    let canon = p
    if (len(strip) > 0 && hasPrefix(p, strip)) {
      canon = p[len(strip):len(p)]
    }
    out = append(out, canon)
  }
  return out
}

// Every `.bit` file under `<root>/<searchRoot>`, as repo-relative paths.
fn buildIndex(root: string, searchRoot: string): []string {
  return buildIndexOf(root, searchRoot, bitSuffix)
}

// Unions `buildIndex` over every root in `searchRoots`. Each directory is
// walked and bounds-checked independently (`buildIndex`'s own
// `maxIndexFiles` check), so a row spanning several large trees never sums
// them into one oversized walk.
fn buildIndexMulti(root: string, searchRoots: []string): []string {
  let out = []string(0)
  for searchRoot of searchRoots {
    for p of buildIndex(root, searchRoot) {
      out = append(out, p)
    }
  }
  return out
}

// Resolves `token`: a direct hit, else a unique suffix match against
// `index`, else a suffix-consistent fallback to `contextPath`, else unresolved.
fn resolveToken(root: string, token: string, index: []string, contextPath: string): (string, bool) {
  if (exists("${root}/${token}")) {
    return token, true
  }
  let tokenComps = pathComponents(token)
  if (len(tokenComps) == 0) {
    return "", false
  }
  let matches = []string(0)
  for cand of index {
    if (suffixMatches(pathComponents(cand), tokenComps)) {
      matches = append(matches, cand)
    }
  }
  if (len(matches) == 1) {
    return matches[0], true
  }
  if (len(contextPath) > 0 && suffixMatches(pathComponents(contextPath), tokenComps)) {
    return contextPath, true
  }
  return "", false
}

// Bound on how many fixture corpora ONE search root may contribute (Power of
// 10 rule 2) — a bound on the list's allocation, not a policy on how many the
// repo may have. Today's answer across all of sourceRoots() is 2, both under
// `_tests_/bit`: checkercases/ and parsercases/.
const maxFixtureCorpusDirs: int = 64

const expectedSuffix: string = ".expected"

// Whether `items` already holds `want`.
fn listHas(items: []string, want: string): bool {
  for it of items {
    if (it == want) {
      return true
    }
  }
  return false
}

// Every directory under `searchRoots` holding at least one `.expected` file
// — a FIXTURE CORPUS, decided by that PROPERTY and never by a name list,
// exactly as `_tests_/bit/filesize.bit` and `_tests_/bit/lintfilelines.bit`
// already decide it. Its `.bit` files are deliberately synthetic inputs
// consumed by test-checker-diag/test-parser, so a declaration inside one is
// never somewhere a real citation could have MOVED to.
//
// A SEARCH ROOT ITSELF IS NEVER ASKED, and that is not a detail: `_tests_/bit/`
// carries testloc.expected and testpanic.expected directly at top level — a
// harness-output convention, not a corpus. Testing the root the way a
// subdirectory is tested would drop every `.bit` file under `_tests_/bit/` from
// the declarer population in one step, and a "moved" check that searches
// nothing reports exactly what a correct one reports when nothing moved. That
// is #4100, already found and fixed once in filesize.bit's `scanRoot`; same
// trap, same answer.
fn fixtureCorpusDirs(root: string, searchRoots: []string): []string {
  let out = []string(0)
  for searchRoot of searchRoots {
    for dir of corpusDirsIn(searchRoot, buildIndexOf(root, searchRoot, expectedSuffix)) {
      out = append(out, dir)
    }
  }
  return out
}

// The directory of every path in `expectedPaths` that is a PROPER DESCENDANT
// of `searchRoot`, deduplicated. Split from `fixtureCorpusDirs` so the rule —
// including the root exclusion — is drivable from synthetic input by
// `selfTestFixtureCorpusDirs` below, not only against whatever the tree holds
// today. Returns a fresh list rather than appending into a caller's: growth
// through a parameter does not reach the caller (E0214), and two roots can
// never name the same directory anyway, so nothing is lost by merging above.
fn corpusDirsIn(searchRoot: string, expectedPaths: []string): []string {
  let out = []string(0)
  for p of expectedPaths {
    let dir = dirOf(p)
    if (dir == searchRoot || len(dir) == 0 || listHas(out, dir)) {
      continue
    }
    if (len(out) >= maxFixtureCorpusDirs) {
      die("more than ${maxFixtureCorpusDirs} fixture corpora under ${searchRoot}")
    }
    out = append(out, dir)
  }
  return out
}

// `index` minus every file inside a fixture corpus (or anything beneath one)
// — the population `soleOtherDeclarer` searches.
//
// #4289: the search used to run over the whole index, so ONE checkercase
// fixture declaring an arbitrary identifier read as an unambiguous "the
// citation moved here". `fn use(p: json.Parser) {}` in
// _tests_/bit/checkercases/check_qualified_type_unexported.bit — an unrelated
// type-export case — turned compiler/parserdecl.bit's ordinary prose about the
// contextual keyword `use` into a stale-citation failure. Fixed by narrowing
// the population, never by suppressing particular words: the next collision
// would be a different word.
fn declarerIndex(root: string, searchRoots: []string, index: []string): []string {
  let corpora = fixtureCorpusDirs(root, searchRoots)
  let out = []string(0)
  for p of index {
    if (!insideAnyDir(corpora, p)) {
      out = append(out, p)
    }
  }
  return out
}

// Whether `path` sits inside one of `dirs`, at any depth.
fn insideAnyDir(dirs: []string, path: string): bool {
  for d of dirs {
    if (hasPrefix(path, "${d}/")) {
      return true
    }
  }
  return false
}

// A floor on the DECLARER population (#4289), same reasoning: 652 of the 808
// indexed files survived the fixture-corpus exclusion on 65deaa83, and
// ordinary fixture-adding moves that number every week. Set well under it so
// an exclusion that starts swallowing real source fails loudly.
const minDeclarerFloor: int = 500

// Both directions, because both failures are SILENT. An exclusion that
// matches nothing puts every checkercase declaration back in the "moved to"
// population and #4289's false positive returns; one that matches everything
// empties the population, and a "moved" search over an empty population
// reports exactly what a correct one reports when nothing moved.
fn checkDeclarerPopulation(sc: Scan, indexed: int, declarers: int) {
  if (indexed - declarers < 1) {
    report(
      sc,
      "the fixture-corpus exclusion matched no file of ${indexed} — a fixture declaration can be read as a citation's move target again",
    )
  }
  if (declarers < minDeclarerFloor) {
    report(
      sc,
      "the declarer population is ${declarers} file(s) of ${indexed}, want >= ${minDeclarerFloor} — the fixture-corpus exclusion is dropping real source",
    )
  }
}

// #4289: the fixture-corpus rule deciding which files may be a citation's
// "moved to" target. A `.expected` directly under a SEARCH ROOT
// (`_tests_/bit/testloc.expected`, a harness-output convention) must NOT make
// that root a corpus; one a level down (`checkercases/`) must. Get the first
// wrong and every file under the root leaves the declarer population — after
// which a "moved" search over nothing reports what a correct one reports when
// nothing moved.
fn selfTestFixtureCorpusDirs(): int {
  let dirs = corpusDirsIn(
    "_tests_/bit",
    [
      "_tests_/bit/testloc.expected",
      "_tests_/bit/checkercases/a.expected",
      "_tests_/bit/checkercases/b.expected",
      "_tests_/bit/parsercases/c.expected",
    ],
  )
  return selfCheck(len(dirs) == 2, "did not find exactly the 2 fixture corpora") +
    selfCheck(!listHas(dirs, "_tests_/bit"), "treated the search ROOT as a corpus") +
    selfCheck(listHas(dirs, "_tests_/bit/checkercases"), "missed the checkercases corpus") +
    selfCheck(
      insideAnyDir(dirs, "_tests_/bit/checkercases/nested/x.bit"),
      "did not exclude a file nested below a corpus",
    ) +
    selfCheck(
      !insideAnyDir(dirs, "_tests_/bit/filesize.bit"),
      "excluded a real harness sitting beside a corpus",
    )
}
