// _tests_/bit/fmtcitations/fmtcitationsassoc.bit — Tier 2's symbol/citation
// association scan and both #3611 checks that consume it, split out of
// fmtcitations.bit to keep that file under the repo's 800-line limit
// (E0200). Sibling in the same directory module, so everything here calls
// straight into fmtcitations.bit's Scan/DocRow/PathToken/report/lookupDecl/
// extractDecls with no import, matching the convention documented in
// docs/development.md's "Splitting a file" section.
//
// #3611 widens the association step from "one citation, one
// immediately-preceding symbol" to two real shapes seen in
// docs/development.md:
//   - a comma-chained run of citations sharing one preceding symbol LIST:
//     `` `lowerSourceModule`/`checkSourceDump` (`a.bit:1`, `b.bit:2`) ``
//     (citationChainIndex, symbolListBefore, findAssociatedSymbol) —
//     association by LEFT-TO-RIGHT POSITION (nth symbol -> nth citation),
//     not proximity — the naive "nearest backtick-quoted name" reading
//     mis-attributes the whole list to whichever citation sits closest.
//   - cross-file symbol lookup (checkSymbolMoved): a citation whose named
//     file no longer declares the symbol because a split moved it gets
//     searched across the row's own file index for exactly one OTHER file
//     declaring it, rather than silently no-opping.
//
// #3773 makes the symbol, not the stored line range, the source of truth for
// a Tier-2 citation (checkSymbolCitation): the symbol only has to resolve
// SOMEWHERE reachable, so inserting or removing lines above a cited symbol
// within its own file cannot redden this gate. What still fails: the symbol
// not resolving in its cited file (checkSymbolMoved's "moved" report when
// exactly one other file has it, and its "renamed or deleted" report when no
// file does AND the name no longer appears there as plain text either —
// `identifierAppearsIn` — so a citation pointing at a local variable or an
// enum-tag reference, never a top-level fn/const, keeps its pre-existing
// "cannot understand it, skip" treatment instead of becoming a false
// failure).

// Bounds a top-level declaration's leading modifier run (`export`, one or
// more `@annotation`s) — this codebase never stacks more than a couple.
const maxDeclModifierSteps: int = 4

// The index right after the '"' that closes the string literal opened at
// `quoteIdx` (itself a '"'), honoring a backslash escape so a literal `\"`
// can't end the scan early. Returns `n` if the literal is never closed.
fn skipAnnotationStringLit(rest: string, quoteIdx: int, n: int): int {
  let k = quoteIdx + 1
  while (k < n) {
    if (rest[k] == '\\' && k + 1 < n) {
      k = k + 2
      continue
    }
    if (rest[k] == '"') {
      return k + 1
    }
    k = k + 1
  }
  return n
}

// The index right after the ')' matching the '(' at `rest[openIdx]`,
// treating any `"..."` span inside the arguments as opaque (so a ')' or '('
// quoted inside an argument string can't unbalance the scan). Returns `n` if
// no matching ')' is found — this codebase's own annotation arguments are
// always a single flat string literal (`@symbol("bit_rt_...")`), so nesting
// beyond that is untested but handled defensively rather than assumed away.
fn skipAnnotationArgs(rest: string, openIdx: int, n: int): int {
  let depth = 0
  let k = openIdx
  while (k < n) {
    if (rest[k] == '"') {
      k = skipAnnotationStringLit(rest, k, n)
      continue
    }
    if (rest[k] == '(') {
      depth = depth + 1
    }
    if (rest[k] == ')') {
      depth = depth - 1
      if (depth == 0) {
        return k + 1
      }
    }
    k = k + 1
  }
  return n
}

// Strips ONE leading `@annotation ` or `@annotation(...) ` token from `rest`
// (split out of stripDeclModifiers to keep it under E0204's complexity-10
// limit — #4285's argument-skipping addition pushed the merged version to
// 11). `ok` is false, and `rest` is returned unchanged, when `rest` does not
// start with a bare `@ident` immediately followed by a space or an argument
// list ending in a space — the same "not a modifier, stop" signal
// stripDeclModifiers' loop already used inline.
fn stripOneAnnotation(rest: string): (string, bool) {
  if (len(rest) == 0 || rest[0] != '@') {
    return rest, false
  }
  let n = len(rest)
  let j = 1
  while (j < n && isIdentContCh(rest[j])) {
    j = j + 1
  }
  if (j < n && rest[j] == '(') {
    j = skipAnnotationArgs(rest, j, n)
  }
  if (j < n && rest[j] == ' ') {
    return rest[j + 1:n], true
  }
  return rest, false
}

// `line` with every leading `export ` and `@annotation` / `@annotation(...)`
// token stripped, so `declName` (fmtcitations.bit) can see a `fn`/`const`
// keyword that isn't the very first word. Found necessary by #4257: 851 of
// ~8046 top-level declarations in compiler/runtime/tools/build/_tests_/bit
// are `export fn`, `@nosplit fn`, `export @nosplit fn` or similar
// (2026-09-04) — every one of those was previously INVISIBLE to
// extractDecls, which only matched a bare "fn "/"const " at column 0. That
// silently broke Tier 2 for any citation naming an exported or annotated
// symbol: checkSymbolCitation would report the symbol "not declared" in a
// file that plainly declares it, and checkSymbolMoved would then guess at
// another file or report a false "renamed or deleted" — this repo's own
// runtime/root/mapcaps.bit:112 (`export @nosplit fn mapCapForHint`) is the
// case that surfaced it.
//
// #4285 widened this to an ARGUMENT-BEARING annotation (`@symbol("...")`):
// the ident-run scan alone stops at the '(' and never reaches the trailing
// space, leaving the whole "@symbol(...)..." prefix in place — declName then
// sees no "fn "/"const " at column 0 and the declaration is invisible, the
// same failure mode as the unstripped `export`/`@nosplit` case above.
// 802 of 8875 top-level declarations under this arm's own source roots carry
// exactly this shape (2026-09-04) — `export @nosplit @symbol("...") fn`, the
// convention every ABI-exported runtime primitive uses.
fn stripDeclModifiers(line: string): string {
  let rest = line
  let steps = 0
  while (steps < maxDeclModifierSteps) {
    steps = steps + 1
    if (hasPrefix(rest, "export ")) {
      rest = rest[len("export "):len(rest)]
      continue
    }
    let (stripped, ok) = stripOneAnnotation(rest)
    if (!ok) {
      break
    }
    rest = stripped
  }
  return rest
}

// `x` clamped to a non-negative floor — every backward scan below needs
// this at least twice, so it is its own function rather than a repeated
// `if (x < 0) { x = 0 }` (each repetition is its own complexity point).
fn clampFloor(x: int): int {
  if (x < 0) {
    return 0
  }
  return x
}

// The nearest backtick-quoted span whose CLOSING backtick sits before
// `beforePos` (bounded by maxBackScan), together with the trimmed text
// between that closing backtick and `beforePos` (the "connector"). Returns
// (contentStart, contentEnd, connector, ok); content is
// text[contentStart:contentEnd]. ok is false if no matching backtick pair
// is found within maxBackScan/`maxLen`.
fn backtickSpanBefore(text: string, beforePos: int, maxLen: int): (int, int, string, bool) {
  let floor = clampFloor(beforePos - maxBackScan)
  let k = beforePos - 1
  while (k >= floor && text[k] != '`') {
    k = k - 1
  }
  if (k < floor || text[k] != '`') {
    return 0, 0, "", false
  }
  let connector = trimWs(text[k + 1:beforePos])
  let contentFloor = clampFloor(k - 1 - maxLen)
  let m = k - 1
  while (m >= contentFloor && text[m] != '`') {
    m = m - 1
  }
  if (m < contentFloor || text[m] != '`') {
    return 0, 0, "", false
  }
  return m + 1, k, connector, true
}

// A symbol list ends and a citation (or citation chain) begins across "," or "(".
fn isEntryConnector(s: string): bool {
  return s == "," || s == "("
}

// Two symbols within the same list are joined by "," or "/" (docs/development.md
// writes `` `a`/`b` `` with no surrounding whitespace; "," is accepted too since
// nothing rules a comma-separated list out).
fn isContinuationConnector(s: string): bool {
  return s == "," || s == "/"
}

// The 0-based position of the citation at `citStartOffset` within its
// comma-connected run of sibling "*.bit:spec" citations (bounded by
// maxSegmentsPerCitation), and the start offset of the FIRST (leftmost)
// citation in that run. A citation with no comma-connected sibling has
// index 0 and its own offset as the run's start. Distinguishes a sibling
// citation from a comma-connected SYMBOL name (`` `fmtFoo`, `a.bit:1` ``)
// by requiring the preceding backtick-quoted span to itself contain ".bit".
fn citationChainIndex(text: string, citStartOffset: int): (int, int) {
  let index = 0
  let cur = citStartOffset
  let steps = 0
  while (steps < maxSegmentsPerCitation) {
    steps = steps + 1
    if (cur < 1 || text[cur - 1] != '`') {
      return index, cur
    }
    let (contentStart, contentEnd, connector, ok) = backtickSpanBefore(text, cur - 1, maxTokenLen)
    if (!ok || connector != "," || !contains(text[contentStart:contentEnd], bitSuffix)) {
      return index, cur
    }
    index = index + 1
    cur = contentStart
  }
  return index, cur
}

// The backtick-quoted bare identifiers connected, right-to-left, to what
// precedes `firstCitStart` — entry via "," or "(", further names via
// isContinuationConnector. Returned NEAREST-TO-THE-CITATION FIRST (the
// caller indexes from the end to read left-to-right); empty if the entry
// connector or the nearest quoted span isn't a bare identifier.
//
// #4285: the search bound passed to backtickSpanBefore must exclude the
// citation's OWN leading backtick when it has one (`` `sym` (`file.bit`) ``)
// but must NOT exclude the entry connector itself when it doesn't
// (`` `sym` (file.bit) `` — the source-comment corpus's dominant shape,
// where the filename is bare text, not backtick-quoted). Subtracting 1
// unconditionally — the old behavior — swallowed the "(" or "," connector
// character whenever the filename was bare, so `isEntryConnector` never saw
// it and the citation silently never associated: `checkSymbolCitation` was
// never reached, no verification ran, and the gate's own `citations` count
// undercounted the corpus (329 of 6296 comment tokens affected, 2026-09-04).
// `text[firstCitStart - 1] == '\`'` is the exact and only case the old -1
// was correct for.
fn symbolEntryScanBound(text: string, firstCitStart: int): int {
  if (firstCitStart > 0 && text[firstCitStart - 1] == '`') {
    return firstCitStart - 1
  }
  return firstCitStart
}

fn symbolListBefore(text: string, firstCitStart: int): []string {
  let out = []string(0)
  let (start, end, connector, ok) = backtickSpanBefore(
    text,
    symbolEntryScanBound(text, firstCitStart),
    maxIdentLen,
  )
  if (!ok || !isEntryConnector(connector)) {
    return out
  }
  let candidate = text[start:end]
  if (!isBareIdentifier(candidate)) {
    return out
  }
  out = append(out, candidate)
  let pos = start - 1
  let steps = 0
  while (steps < maxSymbolsPerCitation) {
    steps = steps + 1
    let (nStart, nEnd, nConn, nOk) = backtickSpanBefore(text, pos, maxIdentLen)
    if (!nOk || !isContinuationConnector(nConn)) {
      return out
    }
    let nCandidate = text[nStart:nEnd]
    if (!isBareIdentifier(nCandidate)) {
      return out
    }
    out = append(out, nCandidate)
    pos = nStart - 1
  }
  return out
}

// The symbol associated with the citation at `citStartOffset`, or "" if
// none. Handles a comma-connected chain of citations sharing one preceding
// symbol LIST (`` `sym1`/`sym2` (`file1:line`, `file2:line`) ``) by pairing
// the citation's position in its chain with the symbol at the same
// left-to-right position, via citationChainIndex/symbolListBefore above.
fn findAssociatedSymbol(text: string, citStartOffset: int): string {
  let (idx, chainStart) = citationChainIndex(text, citStartOffset)
  let names = symbolListBefore(text, chainStart)
  if (idx >= len(names)) {
    return ""
  }
  return names[len(names) - 1 - idx]
}

// `symbolName` is the source of truth (#3773): whether it is declared
// ANYWHERE in `resLines` (the cited file's own current text) is the whole
// check. The doc's stored line range is never compared against `declLine`
// here — that comparison is exactly what reddened this gate on every past
// insertion above a cited symbol, for a citation whose prose was correct the
// whole time. Falls through to checkSymbolMoved only when the cited file
// itself no longer declares the symbol at all.
fn checkSymbolCitation(ctx: CheckCtx, cited: CitedSymbol, resLines: []string) {
  let declLine = lookupDecl(extractDecls(resLines), cited.symbolName)
  if (declLine >= 1) {
    ctx.sc.verified = ctx.sc.verified + 1
    markVerified(ctx.seen, cited.symbolName)
    return
  }
  checkSymbolMoved(ctx, cited, resLines)
}

// `symbolName` is not declared in `resolved`, the file the citation itself
// names. Search every OTHER file in this row's index: exactly one other file
// declaring it is an unambiguous "moved" signal; more than one is genuinely
// ambiguous and stays silent, the same discipline `resolveToken`'s own
// suffix-match fallback already uses. Zero elsewhere is NOT automatically a
// failure: `findAssociatedSymbol`'s heuristic also pairs a citation with a
// bare identifier that was never a top-level fn/const at all — a local
// variable (`grouped`) or an enum-tag reference (`` `FuncDecl` `` naming
// `Tag.FuncDecl`) — and those still appear as plain text in `resLines`, so
// `identifierAppearsIn` tells that case apart from a genuine rename/deletion
// (#3773 — where the old name has vanished from the cited file's text
// entirely) and only the latter fails loudly. Before this, EITHER shape
// returned silently here, so a citation to a symbol deleted outright passed
// unchecked; that gap is what the "renamed or deleted" acceptance case closes.
fn checkSymbolMoved(ctx: CheckCtx, cited: CitedSymbol, resLines: []string) {
  if (wasVerified(ctx.seen, cited.symbolName)) {
    return
  }
  let (moved, others) = soleOtherDeclarer(ctx, cited.resolved, cited.symbolName)
  if (others > 1) {
    return
  }
  if (others == 1) {
    report(
      ctx.sc,
      "${ctx.row.docPath}:${cited.tok.docLine}: `${cited.symbolName}` is not declared in the cited ${cited.resolved}, but is declared in ${moved} — the citation is likely stale after a file move",
    )
    return
  }
  if (identifierAppearsIn(resLines, cited.symbolName)) {
    return
  }
  report(
    ctx.sc,
    "${ctx.row.docPath}:${cited.tok.docLine}: `${cited.symbolName}` is not declared in ${cited.resolved} or in any other file under ${join(
      ctx.row.searchRoots,
      ", ",
    )}, and no longer appears there as text either — the citation is likely stale after a rename or a deletion",
  )
}

// The one OTHER file under this row's index declaring `name`, and how many
// were found (capped at 2 — the search stops once it can no longer be
// "exactly one"). Both consumers need the same three-way answer: 1 is an
// unambiguous file-move signal, more than 1 is genuinely ambiguous and stays
// silent (resolveToken's own suffix-match discipline), 0 means the name is
// not a top-level declaration anywhere. Split out of checkSymbolMoved so the
// possessive arm (checkPossessiveSymbol) runs the identical search rather
// than a second copy of it.
fn soleOtherDeclarer(ctx: CheckCtx, resolved: string, name: string): (string, int) {
  let found = []string(0)
  for cand of ctx.index {
    if (cand == resolved || len(found) > 1) {
      continue
    }
    if (declaresSymbol(ctx.root, cand, name)) {
      found = append(found, cand)
    }
  }
  if (len(found) == 1) {
    return found[0], 1
  }
  return "", len(found)
}

// Whether `name` appears anywhere in `lines` as a WHOLE identifier, not as a
// substring of a longer one (a rename to `nameSuffixed` must not read as
// `name` still being present). Distinguishes a bare identifier that was
// never a top-level declaration (still real text: a local variable, an enum
// tag) from one that has genuinely vanished from its cited file.
fn identifierAppearsIn(lines: []string, name: string): bool {
  for line of lines {
    if (lineHasWholeIdentifier(line, name)) {
      return true
    }
  }
  return false
}

// One line of `lineHasWholeIdentifier`'s search: every occurrence of `name`
// in `line`, checking the characters immediately before and after each hit
// are not themselves identifier characters — bounded by `len(line)` since
// `pos` strictly increases every iteration.
fn lineHasWholeIdentifier(line: string, name: string): bool {
  let n = len(line)
  let nameLen = len(name)
  let pos = 0
  while (pos <= n - nameLen) {
    let hit = int(indexOfFrom(line, name, pos))
    if (hit < 0) {
      return false
    }
    let before = hit == 0 || !isIdentContCh(line[hit - 1])
    let afterPos = hit + nameLen
    let after = afterPos >= n || !isIdentContCh(line[afterPos])
    if (before && after) {
      return true
    }
    pos = hit + 1
  }
  return false
}

// Whether `path` (under `root`) declares a top-level fn/const named `symbolName`.
fn declaresSymbol(root: string, path: string, symbolName: string): bool {
  let full = "${root}/${path}"
  if (!exists(full)) {
    return false
  }
  let text = readFile(full) catch ""
  if (len(text) == 0 || len(text) > maxCitedFileBytes) {
    return false
  }
  let lines = split(text, "\n")
  if (len(lines) > maxCitedFileLines) {
    return false
  }
  return lookupDecl(extractDecls(lines), symbolName) >= 1
}

// Names already confirmed as a real declaration somewhere in the CURRENT
// document's scan, so a later same-named citation to a different file is
// read as a deliberate cross-reference (a call site, e.g. spec/FMT.md:91
// citing `fmtPrintSeq`'s USE in compiler/fmtdispatch.bit right after its
// declaration was correctly verified at compiler/fmt.bit:78) rather than a
// stale "moved" declaration — checkSymbolMoved consults this before
// reporting, per the "cannot understand it, must skip" discipline (#3611).
class SeenSymbols { names: []string }

fn wasVerified(seen: SeenSymbols, name: string): bool {
  for n of seen.names {
    if (n == name) {
      return true
    }
  }
  return false
}

fn markVerified(seen: SeenSymbols, name: string) {
  if (!wasVerified(seen, name)) {
    seen.names = append(seen.names, name)
  }
}

// ---------------------------------------------------------------------------
// #4682: the FORWARD association rule, for the possessive idiom only.
//
// Everything above associates a symbol that PRECEDES its citation — the
// DocRow convention (`` `sym` (file.bit:N) ``). The possessive idiom writes
// the file FIRST (compiler/loweraccess.bit's `lowerIndex`, written the way
// it should have been written — the example is live on purpose, so this
// paragraph is checked by the rule it describes), and it is this
// repo's commonest way of citing a sibling's declarations: 2365 possessive
// `.bit` tokens across 522 files in `//` comments under compiler/, runtime/,
// tools/build/ and _tests_/bit/ (2026-09-09, re-derived on 7c6a13f0; the raw
// `\.bit's` line grep sees 1478 of them across 413 files and misses every
// backtick-quoted `` `x.bit`'s `` spelling). Every one was refused Tier 2 by
// checkSourceToken's two possessive guards, which exist because
// findAssociatedSymbol pairs each symbol group with the NEXT file in
// sequence and produced a false "moved" report. Those guards stay; this is a
// second, disjoint rule reading the other direction, never a widening of the
// first.
//
// The measured shape it exists for: _tests_/bit/lowerrefuse.bit:106 named
// the wrong owner for `lowerIndex` — it cited compiler/lowerlit.bit, while
// the declaration is at compiler/loweraccess.bit:487 (#4280). With that
// spelling restored, `./make test-fmt-citations` exited 0 and never named
// the file. (Spelled out rather than quoted: this rule scans its own module
// too, and a quoted stale citation is still a citation.)

// The offset after any run of spaces, tabs and CRs starting at `p`, stepping
// over a comment line WRAP (a newline, the next line's indentation and its
// own "//") — a possessive and its symbol routinely straddle one, and a rule
// that stopped at the newline would silently check only the unwrapped half.
fn skipCommentWrapWs(text: string, p: int): int {
  let n = len(text)
  let i = p
  while (i < n) {
    if (text[i] == ' ' || text[i] == '\t' || text[i] == '\r') {
      i = i + 1
      continue
    }
    if (text[i] != '\n') {
      return i
    }
    let j = skipCommentMarker(text, i + 1)
    if (j < 0) {
      return i
    }
    i = j
  }
  return i
}

// The offset after the next line's own "//" marker, skipping its leading
// indentation, or -1 if the line does not start one — split out of
// skipCommentWrapWs to keep it under E0204's complexity-10 limit.
fn skipCommentMarker(text: string, at: int): int {
  let n = len(text)
  let j = at
  while (j < n && (text[j] == ' ' || text[j] == '\t')) {
    j = j + 1
  }
  if (j + 2 <= n && text[j:j + 2] == "//") {
    return j + 2
  }
  return -1
}

// The backtick-quoted span opening at `text[p]` (which must be a backtick):
// (contentStart, contentEnd, ok), content being text[contentStart:contentEnd].
// The forward twin of backtickSpanBefore, bounded by maxIdentLen for the same
// reason — a "span" longer than an identifier is prose, not a symbol.
fn backtickSpanAt(text: string, p: int): (int, int, bool) {
  if (p < 0 || p >= len(text) || text[p] != '`') {
    return 0, 0, false
  }
  let closeAt = int(indexOfFrom(text, "`", p + 1))
  if (closeAt < 0 || closeAt - p - 1 > maxIdentLen) {
    return 0, 0, false
  }
  return p + 1, closeAt, true
}

// The four connectors that join two symbols of ONE possessive's list, as
// written in this corpus: `` `a`/`b` `` (92 occurrences), `` `a`, `b` `` (16),
// `` `a` and `b` `` (17) and `` `a`, and `b` `` (3), 2026-09-09. Anything else
// — a verb, a closing paren, another citation — ends the list; ", or" and
// "or" are deliberately absent because no site uses them and an unused branch
// is an untested one.
fn isPossessiveConnector(s: string): bool {
  return s == "/" || s == "," || s == "and" || s == ", and"
}

// The backtick-quoted bare identifiers that FOLLOW a possessive `.bit`
// token, `end` being the offset right after its ".bit" text (tokenRawEnd).
// Empty unless a backtick-quoted bare identifier follows the "'s"
// IMMEDIATELY (modulo whitespace and one comment wrap): "x.bit's own header"
// and "x.bit's `getauxval(kind)`" both associate nothing, because neither
// names a symbol this gate can look up.
fn possessiveSymbolsAfter(text: string, end: int): []string {
  let out = []string(0)
  let p = end
  if (p < len(text) && text[p] == '`') {
    p = p + 1
  }
  let (start, stop, ok) = backtickSpanAt(text, skipCommentWrapWs(text, p + len("'s")))
  if (!ok || !isBareIdentifier(text[start:stop])) {
    return out
  }
  return appendChainedSymbols(text, stop + 1, append(out, text[start:stop]))
}

// The rest of one possessive's symbol list, read left to right from `pos`
// (just past the first symbol's closing backtick) — split out of
// possessiveSymbolsAfter to keep both under E0204's complexity-10 limit.
// Stops at the first connector that is not one of isPossessiveConnector's,
// which is what keeps "fileA.bit's `sym1`, fileB.bit's `sym2`" from reading
// as one list: the connector there carries the next citation.
fn appendChainedSymbols(text: string, pos: int, out: []string): []string {
  let names = out
  let cur = pos
  let steps = 0
  while (steps < maxSymbolsPerCitation) {
    steps = steps + 1
    let tick = int(indexOfFrom(text, "`", cur))
    if (tick < 0 || !isPossessiveConnector(trimWs(unwrapCommentQuote(text[cur:tick])))) {
      return names
    }
    let (start, stop, ok) = backtickSpanAt(text, tick)
    if (!ok || !isBareIdentifier(text[start:stop])) {
      return names
    }
    names = append(names, text[start:stop])
    cur = stop + 1
  }
  return names
}

// Tier 2 for ONE (file, symbol) pair the possessive rule associated. The
// idiom asserts OWNERSHIP — "x.bit's `foo`" claims `foo` is declared in
// x.bit — so a declaration in the cited file is the whole check, exactly as
// checkSymbolCitation reads a DocRow citation.
//
// It reports ONE verdict and stays silent on every other, which is what
// holds its false-positive count at 0 over the whole corpus (#4682's census
// comment): `foo` is declared in exactly one OTHER file and does not appear
// in the cited file's text at all — the file-split drift #4280 was. The two
// deliberate silences:
//  - `foo` still appears in the cited file as text (176 pairs): the file is
//    at least involved, and the possessive may be naming a call site loosely.
//    checkSymbolMoved consults identifierAppearsIn only in its zero-elsewhere
//    branch; here it is consulted FIRST, which is the difference between this
//    arm and that one.
//  - `foo` is declared nowhere (16 pairs): the possessive's object is
//    routinely not a top-level fn/const at all but an `extern fn`
//    (`sched.bit`'s `bit_rt_time_mono_ns`), a syscall number (`os.bit`'s
//    `wait4`), an annotation name (`checktype.bit`'s `tuple_type`) or a
//    symbol the comment says was DELETED (`checkbind.bit`'s
//    `vMethodReceiverKind`, removed by #3811 and named as history). 10 of
//    those 16 are that shape, so the class is noise, not signal.
fn checkPossessiveSymbol(ctx: CheckCtx, cited: CitedSymbol, resLines: []string) {
  if (lookupDecl(extractDecls(resLines), cited.symbolName) >= 1) {
    ctx.sc.possessivePaired = ctx.sc.possessivePaired + 1
    return
  }
  if (identifierAppearsIn(resLines, cited.symbolName)) {
    return
  }
  let (moved, others) = soleOtherDeclarer(ctx, cited.resolved, cited.symbolName)
  if (others != 1) {
    return
  }
  report(
    ctx.sc,
    "${ctx.row.docPath}:${cited.tok.docLine}: names ${cited.resolved}'s `${cited.symbolName}`, but ${cited.resolved} neither declares it nor mentions it — it is declared in ${moved} — the citation is likely stale after a file move",
  )
}
