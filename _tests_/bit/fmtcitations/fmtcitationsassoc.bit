// _tests_/bit/fmtcitations/fmtcitationsassoc.bit — Tier 2's symbol/citation
// association scan and both #3611 checks that consume it, split out of
// fmtcitations.bit to keep that file under the repo's 800-line limit
// (E0200). Sibling in the same directory module, so everything here calls
// straight into fmtcitations.bit's Scan/DocRow/PathToken/report/lookupDecl/
// extractDecls with no import, matching the convention documented in
// docs/development.md's "Splitting a file" section.
//
// #3611 widens the association step from "one citation, one
// immediately-preceding symbol" to two real shapes seen in
// docs/development.md:
//   - a comma-chained run of citations sharing one preceding symbol LIST:
//     `` `lowerSourceModule`/`checkSourceDump` (`a.bit:1`, `b.bit:2`) ``
//     (citationChainIndex, symbolListBefore, findAssociatedSymbol) —
//     association by LEFT-TO-RIGHT POSITION (nth symbol -> nth citation),
//     not proximity — the naive "nearest backtick-quoted name" reading
//     mis-attributes the whole list to whichever citation sits closest.
//   - cross-file symbol lookup (checkSymbolMoved): a citation whose named
//     file no longer declares the symbol because a split moved it gets
//     searched across the row's own file index for exactly one OTHER file
//     declaring it, rather than silently no-opping.
//
// #3773 makes the symbol, not the stored line range, the source of truth for
// a Tier-2 citation (checkSymbolCitation): the symbol only has to resolve
// SOMEWHERE reachable, so inserting or removing lines above a cited symbol
// within its own file cannot redden this gate. What still fails: the symbol
// not resolving in its cited file (checkSymbolMoved's "moved" report when
// exactly one other file has it, and its "renamed or deleted" report when no
// file does AND the name no longer appears there as plain text either —
// `identifierAppearsIn` — so a citation pointing at a local variable or an
// enum-tag reference, never a top-level fn/const, keeps its pre-existing
// "cannot understand it, skip" treatment instead of becoming a false
// failure).

// `x` clamped to a non-negative floor — every backward scan below needs
// this at least twice, so it is its own function rather than a repeated
// `if (x < 0) { x = 0 }` (each repetition is its own complexity point).
fn clampFloor(x: int): int {
  if (x < 0) {
    return 0
  }
  return x
}

// The nearest backtick-quoted span whose CLOSING backtick sits before
// `beforePos` (bounded by maxBackScan), together with the trimmed text
// between that closing backtick and `beforePos` (the "connector"). Returns
// (contentStart, contentEnd, connector, ok); content is
// text[contentStart:contentEnd]. ok is false if no matching backtick pair
// is found within maxBackScan/`maxLen`.
fn backtickSpanBefore(text: string, beforePos: int, maxLen: int): (int, int, string, bool) {
  let floor = clampFloor(beforePos - maxBackScan)
  let k = beforePos - 1
  while (k >= floor && text[k] != '`') {
    k = k - 1
  }
  if (k < floor || text[k] != '`') {
    return 0, 0, "", false
  }
  let connector = trimWs(text[k + 1:beforePos])
  let contentFloor = clampFloor(k - 1 - maxLen)
  let m = k - 1
  while (m >= contentFloor && text[m] != '`') {
    m = m - 1
  }
  if (m < contentFloor || text[m] != '`') {
    return 0, 0, "", false
  }
  return m + 1, k, connector, true
}

// A symbol list ends and a citation (or citation chain) begins across "," or "(".
fn isEntryConnector(s: string): bool {
  return s == "," || s == "("
}

// Two symbols within the same list are joined by "," or "/" (docs/development.md
// writes `` `a`/`b` `` with no surrounding whitespace; "," is accepted too since
// nothing rules a comma-separated list out).
fn isContinuationConnector(s: string): bool {
  return s == "," || s == "/"
}

// The 0-based position of the citation at `citStartOffset` within its
// comma-connected run of sibling "*.bit:spec" citations (bounded by
// maxSegmentsPerCitation), and the start offset of the FIRST (leftmost)
// citation in that run. A citation with no comma-connected sibling has
// index 0 and its own offset as the run's start. Distinguishes a sibling
// citation from a comma-connected SYMBOL name (`` `fmtFoo`, `a.bit:1` ``)
// by requiring the preceding backtick-quoted span to itself contain ".bit".
fn citationChainIndex(text: string, citStartOffset: int): (int, int) {
  let index = 0
  let cur = citStartOffset
  let steps = 0
  while (steps < maxSegmentsPerCitation) {
    steps = steps + 1
    if (cur < 1 || text[cur - 1] != '`') {
      return index, cur
    }
    let (contentStart, contentEnd, connector, ok) = backtickSpanBefore(text, cur - 1, maxTokenLen)
    if (!ok || connector != "," || !contains(text[contentStart:contentEnd], bitSuffix)) {
      return index, cur
    }
    index = index + 1
    cur = contentStart
  }
  return index, cur
}

// The backtick-quoted bare identifiers connected, right-to-left, to what
// precedes `firstCitStart` — entry via "," or "(", further names via
// isContinuationConnector. Returned NEAREST-TO-THE-CITATION FIRST (the
// caller indexes from the end to read left-to-right); empty if the entry
// connector or the nearest quoted span isn't a bare identifier.
fn symbolListBefore(text: string, firstCitStart: int): []string {
  let out = []string(0)
  let (start, end, connector, ok) = backtickSpanBefore(text, firstCitStart - 1, maxIdentLen)
  if (!ok || !isEntryConnector(connector)) {
    return out
  }
  let candidate = text[start:end]
  if (!isBareIdentifier(candidate)) {
    return out
  }
  out = append(out, candidate)
  let pos = start - 1
  let steps = 0
  while (steps < maxSymbolsPerCitation) {
    steps = steps + 1
    let (nStart, nEnd, nConn, nOk) = backtickSpanBefore(text, pos, maxIdentLen)
    if (!nOk || !isContinuationConnector(nConn)) {
      return out
    }
    let nCandidate = text[nStart:nEnd]
    if (!isBareIdentifier(nCandidate)) {
      return out
    }
    out = append(out, nCandidate)
    pos = nStart - 1
  }
  return out
}

// The symbol associated with the citation at `citStartOffset`, or "" if
// none. Handles a comma-connected chain of citations sharing one preceding
// symbol LIST (`` `sym1`/`sym2` (`file1:line`, `file2:line`) ``) by pairing
// the citation's position in its chain with the symbol at the same
// left-to-right position, via citationChainIndex/symbolListBefore above.
fn findAssociatedSymbol(text: string, citStartOffset: int): string {
  let (idx, chainStart) = citationChainIndex(text, citStartOffset)
  let names = symbolListBefore(text, chainStart)
  if (idx >= len(names)) {
    return ""
  }
  return names[len(names) - 1 - idx]
}

// `symbolName` is the source of truth (#3773): whether it is declared
// ANYWHERE in `resLines` (the cited file's own current text) is the whole
// check. The doc's stored line range is never compared against `declLine`
// here — that comparison is exactly what reddened this gate on every past
// insertion above a cited symbol, for a citation whose prose was correct the
// whole time. Falls through to checkSymbolMoved only when the cited file
// itself no longer declares the symbol at all.
fn checkSymbolCitation(ctx: CheckCtx, cited: CitedSymbol, resLines: []string) {
  let declLine = lookupDecl(extractDecls(resLines), cited.symbolName)
  if (declLine >= 1) {
    ctx.sc.verified = ctx.sc.verified + 1
    markVerified(ctx.seen, cited.symbolName)
    return
  }
  checkSymbolMoved(ctx, cited, resLines)
}

// `symbolName` is not declared in `resolved`, the file the citation itself
// names. Search every OTHER file in this row's index: exactly one other file
// declaring it is an unambiguous "moved" signal; more than one is genuinely
// ambiguous and stays silent, the same discipline `resolveToken`'s own
// suffix-match fallback already uses. Zero elsewhere is NOT automatically a
// failure: `findAssociatedSymbol`'s heuristic also pairs a citation with a
// bare identifier that was never a top-level fn/const at all — a local
// variable (`grouped`) or an enum-tag reference (`` `FuncDecl` `` naming
// `Tag.FuncDecl`) — and those still appear as plain text in `resLines`, so
// `identifierAppearsIn` tells that case apart from a genuine rename/deletion
// (#3773 — where the old name has vanished from the cited file's text
// entirely) and only the latter fails loudly. Before this, EITHER shape
// returned silently here, so a citation to a symbol deleted outright passed
// unchecked; that gap is what the "renamed or deleted" acceptance case closes.
fn checkSymbolMoved(ctx: CheckCtx, cited: CitedSymbol, resLines: []string) {
  if (wasVerified(ctx.seen, cited.symbolName)) {
    return
  }
  let moved = []string(0)
  for cand of ctx.index {
    if (cand == cited.resolved || len(moved) > 1) {
      continue
    }
    if (declaresSymbol(ctx.root, cand, cited.symbolName)) {
      moved = append(moved, cand)
    }
  }
  if (len(moved) > 1) {
    return
  }
  if (len(moved) == 1) {
    report(
      ctx.sc,
      "${ctx.row.docPath}:${cited.tok.docLine}: `${cited.symbolName}` is not declared in the cited ${cited.resolved}, but is declared in ${moved[0]} — the citation is likely stale after a file move",
    )
    return
  }
  if (identifierAppearsIn(resLines, cited.symbolName)) {
    return
  }
  report(
    ctx.sc,
    "${ctx.row.docPath}:${cited.tok.docLine}: `${cited.symbolName}` is not declared in ${cited.resolved} or in any other file under ${join(
      ctx.row.searchRoots,
      ", ",
    )}, and no longer appears there as text either — the citation is likely stale after a rename or a deletion",
  )
}

// Whether `name` appears anywhere in `lines` as a WHOLE identifier, not as a
// substring of a longer one (a rename to `nameSuffixed` must not read as
// `name` still being present). Distinguishes a bare identifier that was
// never a top-level declaration (still real text: a local variable, an enum
// tag) from one that has genuinely vanished from its cited file.
fn identifierAppearsIn(lines: []string, name: string): bool {
  for line of lines {
    if (lineHasWholeIdentifier(line, name)) {
      return true
    }
  }
  return false
}

// One line of `lineHasWholeIdentifier`'s search: every occurrence of `name`
// in `line`, checking the characters immediately before and after each hit
// are not themselves identifier characters — bounded by `len(line)` since
// `pos` strictly increases every iteration.
fn lineHasWholeIdentifier(line: string, name: string): bool {
  let n = len(line)
  let nameLen = len(name)
  let pos = 0
  while (pos <= n - nameLen) {
    let hit = int(indexOfFrom(line, name, pos))
    if (hit < 0) {
      return false
    }
    let before = hit == 0 || !isIdentContCh(line[hit - 1])
    let afterPos = hit + nameLen
    let after = afterPos >= n || !isIdentContCh(line[afterPos])
    if (before && after) {
      return true
    }
    pos = hit + 1
  }
  return false
}

// Whether `path` (under `root`) declares a top-level fn/const named `symbolName`.
fn declaresSymbol(root: string, path: string, symbolName: string): bool {
  let full = "${root}/${path}"
  if (!exists(full)) {
    return false
  }
  let text = readFile(full) catch ""
  if (len(text) == 0 || len(text) > maxCitedFileBytes) {
    return false
  }
  let lines = split(text, "\n")
  if (len(lines) > maxCitedFileLines) {
    return false
  }
  return lookupDecl(extractDecls(lines), symbolName) >= 1
}

// Names already confirmed as a real declaration somewhere in the CURRENT
// document's scan, so a later same-named citation to a different file is
// read as a deliberate cross-reference (a call site, e.g. spec/FMT.md:91
// citing `fmtPrintSeq`'s USE in compiler/fmtdispatch.bit right after its
// declaration was correctly verified at compiler/fmt.bit:78) rather than a
// stale "moved" declaration — checkSymbolMoved consults this before
// reporting, per the "cannot understand it, must skip" discipline (#3611).
class SeenSymbols { names: []string }

fn wasVerified(seen: SeenSymbols, name: string): bool {
  for n of seen.names {
    if (n == name) {
      return true
    }
  }
  return false
}

fn markVerified(seen: SeenSymbols, name: string) {
  if (!wasVerified(seen, name)) {
    seen.names = append(seen.names, name)
  }
}
