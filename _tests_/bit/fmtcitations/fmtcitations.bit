// _tests_/bit/fmtcitations/fmtcitations.bit — file:line citation-drift gate
// (#3072, #3381, #3458). Its self-tests live in the sibling
// fmtcitationsselftest.bit, its Tier-2 association scan in
// fmtcitationsassoc.bit (#3611), its `<doc>.md:NNN` citation check (a
// doc citing another doc, e.g. provider-duplication.md -> development.md)
// in fmtcitationsmd.bit (#3675), and its two raw-text scans
// (extractPathTokens, extractHedges) in fmtcitationsextract.bit (#3690) —
// this directory is one module (#3458 moved it out of _tests_/bit/ directly,
// over the 800-line limit).
//
// Table-driven (`docRows()`): spec/FMT.md cites `compiler/fmt*.bit:NNN`,
// runtime/ABI.md cites `runtime/**/*.bit:NNN`, docs/development.md cites
// `.bit:NNN` across compiler/runtime/_tests_/tools — a fourth document is a
// table row, never a new script or Gate{}. #3350's sweep of ABI.md found 23
// of 55 citations wrong (44 exact `path:line`, 11 hedged `~line`); nothing
// had ever checked either, and until #3458 nothing checked development.md
// at all.
//
// TIER 1 (every row): the cited file exists and every line number in the
// spec is within [1, its current line count]. A HEDGED citation (`~line N`
// or a bare `(~N)`/`(~N/M)` right after "(", ABI.md's "approximately" idiom)
// gets the same check against a file resolved from CONTEXT, not a token of
// its own — no numeric tolerance added, just a different way of finding the
// file, tallied separately (hedges/hedgesChecked).
//
// TIER 2, opt-in per row (`verifySymbols`, spec/FMT.md and docs/development.md):
// a citation preceded by a backtick bare identifier naming a declared
// top-level fn/const gets that declaration looked up in the cited file. The
// SYMBOL is the source of truth (#3773), not the stored line range — the
// range is a rendering for human readers and is never compared against the
// symbol's current line, so inserting or removing lines anywhere else in the
// cited file cannot redden this gate. What still fails loudly: the symbol
// not resolving in the cited file at all. ABI.md's prose does not follow
// this shape and its content is out of scope (#3381), so its row leaves
// this off.
//
// Tier 2's association step (fmtcitationsassoc.bit: citationChainIndex,
// symbolListBefore, findAssociatedSymbol) widened by #3611 to close two
// blind spots #3606 measured empirically: a MULTI-SYMBOL list (nth symbol
// paired with the nth citation in its comma-chain, left-to-right, not
// nearest-name proximity) and a symbol moved to a DIFFERENT file by a
// directory-module split (checkSymbolMoved below: search the row's own
// index for exactly one OTHER file declaring it — reported as "moved". Zero
// other files declaring it either is a genuine rename/deletion and is now
// ALSO reported (#3773; previously silent, which meant a deleted symbol's
// citation passed unchecked). Multiple other files declaring it stays
// silent — genuinely ambiguous, matching resolveToken's own suffix-match
// discipline). Both mutation-tested — see selfTestAssociationMultiSymbol
// (fmtcitationsselftest.bit) for the text-scan half and #3773's dispatch
// report for the real-file rename/delete case (no synthetic fixture exists
// for it; declaresSymbol reads real files under the repo root).
//
// RESOLUTION (see `resolveToken`): ABI.md shortens a citation to a bare
// basename or dir+basename once the full path was named earlier in the
// paragraph, and a hedge names no file at all — both fall back to the most
// recently resolved full path (`contextAt`) when the token alone is
// ambiguous or absent. `requiredPrefix` (FMT.md: "compiler/fmt") keeps that
// row scoped exactly as #3072 left it.
//
// The summary prints every denominator every run, per document and in
// aggregate, so this cannot regress into scanning zero documents while
// printing PASS.
//
// Run from the repository root: bit-out/bin/bit run _tests_/bit/fmtcitations
// `BIT_REPO` overrides the repository root, matching _tests_/bit/spec/spec.bit.

import { exists, readFile, walk } from "std/fs"
import { env } from "std/os"
import { contains, hasPrefix, hasSuffix, indexOf, indexOfFrom, join, replace, split } from "std/strings"

// Bounds — every walk below is over a handful of documents and a few
// hundred source files, each still capped explicitly (Power of 10 rule 2).
const maxDocBytes: int = 1048576
const maxPathTokens: int = 512
const maxHedges: int = 64
const maxTokenLen: int = 128
const maxLineSpecLen: int = 64
const maxSegmentsPerCitation: int = 8
const maxSymbolsPerCitation: int = 8
const maxIdentLen: int = 64
const maxBackScan: int = 200
const maxCitedFileBytes: int = 1048576
const maxCitedFileLines: int = 8192
const maxDeclsPerFile: int = 512
const maxIndexFiles: int = 1024

// Floors, not exact counts (a pinned count merges cleanly across two
// branches touching the same document and lands on a wrong total). Set well
// under each document's real count so a regression toward zero fails loudly.
const minVerifiedFloor: int = 10
const minTotalCitationsFloor: int = 51

const bitSuffix: string = ".bit"
const hedgeLineWord: string = "line "

// One row per document this gate covers. `searchRoots` is a list, not a
// single directory, because a document whose citations span multiple
// top-level trees (docs/development.md: compiler/, runtime/, _tests_/,
// tools/) needs its index built from all of them — each directory is
// still walked separately (buildIndex), so the existing per-call
// maxIndexFiles bound applies per root, not to their sum.
class DocRow {
  docPath: string, searchRoots: []string, requiredPrefix: string,
  checkBareMentions: bool, verifySymbols: bool, minCitations: int,
}

fn docRows(): []DocRow {
  return [
    DocRow{
      docPath: "spec/FMT.md", searchRoots: ["compiler"], requiredPrefix: "compiler/fmt",
      checkBareMentions: true, verifySymbols: true, minCitations: 20,
    },
    DocRow{
      docPath: "runtime/ABI.md", searchRoots: ["runtime"], requiredPrefix: "",
      checkBareMentions: false, verifySymbols: false, minCitations: 30,
    },
    // TIER 2 enabled (#3606) and widened (#3611) — see the TIER 2 comment
    // above for what the association step catches now (same-file drift,
    // multi-symbol lists, cross-file moves) and its remaining discipline
    // (ambiguous cases stay silent rather than guessing).
    //
    // Every FULLY-QUALIFIED citation (e.g. "_tests_/stress/quicwire/quicwire.bit")
    // resolves via `resolveToken`'s direct `exists()` check without touching
    // this index at all. The index only matters for a BARE basename this doc
    // cites in passing (e.g. "stress.bit", "artifacts.bit") — so the roots
    // here are the trees that actually hold those bare-cited files, kept
    // individually well under maxIndexFiles (_tests_/cases alone is 1038, over
    // the bound, and is never needed: nothing in this doc bare-cites into it).
    DocRow{
      docPath: "docs/development.md", searchRoots: [
        "compiler",
        "runtime",
        "stdlib",
        "tools",
        "_tests_/bit",
      ],
      requiredPrefix: "", checkBareMentions: true, verifySymbols: true, minCitations: 14,
    },
  ]
}

class PathToken {
  file: string,
  lineSpecRaw: string,
  hasSpec: bool,
  docLine: int,
  startOffset: int,
}

// "/" separates independent line numbers (unlike "-", not a range).
class Hedge { lineSpecRaw: string, docLine: int, startOffset: int }

// A file resolved at a given offset, so a filename-less hedge can ask "what was established here".
class ContextEvent { offset: int, path: string }

class Segment { start: int, end: int, ok: bool }
class Decl { name: string, line: int }
class BoundsResult { ok: bool, lines: []string }

class Scan {
  citations: int, boundsChecked: int, verified: int, bareMentions: int,
  hedges: int, hedgesChecked: int, failures: int,
}

fn die(msg: string) {
  eprint("fmtcitations: SETUP FAILED: ${msg}\n")
  osExit(1)
}

fn report(sc: Scan, msg: string) {
  eprint("fmtcitations: FAIL: ${msg}\n")
  sc.failures = sc.failures + 1
}

// The repo root: the nearest ancestor holding `spec/FMT.md`. BIT_REPO wins.
fn repoRoot(): string {
  let override = env("BIT_REPO")
  if (len(override) > 0) {
    return override
  }
  let candidates = [".", "..", "../..", "../../.."]
  for c of candidates {
    if (exists("${c}/spec/FMT.md")) {
      return c
    }
  }
  die("cannot locate spec/FMT.md from this cwd; set BIT_REPO")
  return ""
}

fn isIdentStartCh(c: u8): bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

fn isIdentContCh(c: u8): bool {
  return isIdentStartCh(c) || (c >= '0' && c <= '9')
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn isLineSpecChar(c: u8): bool {
  return (c >= '0' && c <= '9') || c == '-' || c == ',' || c == ' '
}

// `s` trimmed of leading/trailing space/tab/newline/CR — std/strings'
// trimSpace strips only space/tab, and a citation's connector routinely
// crosses a markdown line-wrap.
fn trimWs(s: string): string {
  let lo = 0
  let hi = len(s)
  while (lo < hi && isWs(s[lo])) {
    lo = lo + 1
  }
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isBareIdentifier(s: string): bool {
  let n = len(s)
  if (n == 0 || n > maxIdentLen) {
    return false
  }
  if (!isIdentStartCh(s[0])) {
    return false
  }
  let i = 1
  while (i < n) {
    if (!isIdentContCh(s[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

fn docLineFor(text: string, offset: int): int {
  return len(split(text[0:offset], "\n"))
}

// The bare name after `kw` (e.g. "fn " or "const ") at the very start of
// `line`, or "" if `line` does not begin with `kw` followed by an identifier.
fn declName(line: string, kw: string): string {
  if (!hasPrefix(line, kw)) {
    return ""
  }
  let rest = line[len(kw):len(line)]
  if (len(rest) == 0 || !isIdentStartCh(rest[0])) {
    return ""
  }
  let n = len(rest)
  let j = 1
  while (j < n && isIdentContCh(rest[j])) {
    j = j + 1
  }
  return rest[0:j]
}

// Every top-level `fn NAME` / `const NAME` declared in `lines`, in order.
fn extractDecls(lines: []string): []Decl {
  let out = []Decl(0)
  let n = len(lines)
  let i = 0
  while (i < n && len(out) < maxDeclsPerFile) {
    let name = declName(lines[i], "fn ")
    if (len(name) == 0) {
      name = declName(lines[i], "const ")
    }
    if (len(name) > 0) {
      out = append(out, Decl{ name: name, line: i + 1 })
    }
    i = i + 1
  }
  return out
}

fn lookupDecl(decls: []Decl, name: string): int {
  for d of decls {
    if (d.name == name) {
      return d.line
    }
  }
  return 0
}

fn parseIntSimple(s: string): (int, bool) {
  let n = len(s)
  if (n == 0 || n > 6) {
    return 0, false
  }
  let v = 0
  let i = 0
  while (i < n) {
    let c = s[i]
    if (c < '0' || c > '9') {
      return 0, false
    }
    v = v * 10 + (int(c) - 48)
    i = i + 1
  }
  return v, true
}

fn parseOneSegment(raw: string): Segment {
  let t = trimWs(raw)
  if (len(t) == 0) {
    return Segment{ start: 0, end: 0, ok: false }
  }
  let dashRaw = indexOf(t, "-")
  if (dashRaw < 0) {
    let (v, ok) = parseIntSimple(t)
    return Segment{ start: v, end: v, ok: ok }
  }
  let dash = int(dashRaw)
  let a = trimWs(t[0:dash])
  let b = trimWs(t[dash + 1:len(t)])
  let (va, oka) = parseIntSimple(a)
  let (vb, okb) = parseIntSimple(b)
  return Segment{ start: va, end: vb, ok: oka && okb && vb >= va }
}

// `spec` split on "," into segments, each "N" (start==end) or "N-M". A
// hedge's "/"-separated form is normalized to "," by its caller first.
fn parseSegments(spec: string): []Segment {
  let out = []Segment(0)
  let parts = split(spec, ",")
  if (len(parts) == 0 || len(parts) > maxSegmentsPerCitation) {
    return []Segment(0)
  }
  for part of parts {
    out = append(out, parseOneSegment(part))
  }
  return out
}

// `p` split on "/" with empty components dropped.
fn pathComponents(p: string): []string {
  let parts = split(p, "/")
  let out = []string(0)
  for part of parts {
    if (len(part) > 0) {
      out = append(out, part)
    }
  }
  return out
}

// Whether `candidateComps`'s LAST `len(tokenComps)` components equal
// `tokenComps` in order — e.g. candidate [runtime,root,linux,boot.bit]
// matches token [linux,boot.bit] but not [darwin,boot.bit].
fn suffixMatches(candidateComps: []string, tokenComps: []string): bool {
  let n = len(tokenComps)
  let m = len(candidateComps)
  if (n == 0 || n > m) {
    return false
  }
  let offset = m - n
  let i = 0
  while (i < n) {
    if (candidateComps[offset + i] != tokenComps[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// Every `.bit` file under `<root>/<searchRoot>`, as repo-relative paths.
fn buildIndex(root: string, searchRoot: string): []string {
  let walkArg = searchRoot
  let strip = ""
  if (root != ".") {
    walkArg = "${root}/${searchRoot}"
    strip = "${root}/"
  }
  let all = walk(walkArg) catch e {
    die("cannot walk ${walkArg}: ${e.message()}")
    []string(0)
  }
  if (len(all) > maxIndexFiles) {
    die("${walkArg} holds ${len(all)} entries, over the maxIndexFiles bound of ${maxIndexFiles}")
  }
  let out = []string(0)
  for p of all {
    if (!hasSuffix(p, bitSuffix)) {
      continue
    }
    let canon = p
    if (len(strip) > 0 && hasPrefix(p, strip)) {
      canon = p[len(strip):len(p)]
    }
    out = append(out, canon)
  }
  return out
}

// Unions `buildIndex` over every root in `searchRoots`. Each directory is
// walked and bounds-checked independently (`buildIndex`'s own
// `maxIndexFiles` check), so a row spanning several large trees never sums
// them into one oversized walk.
fn buildIndexMulti(root: string, searchRoots: []string): []string {
  let out = []string(0)
  for searchRoot of searchRoots {
    for p of buildIndex(root, searchRoot) {
      out = append(out, p)
    }
  }
  return out
}

// Resolves `token`: a direct hit, else a unique suffix match against
// `index`, else a suffix-consistent fallback to `contextPath`, else unresolved.
fn resolveToken(root: string, token: string, index: []string, contextPath: string): (string, bool) {
  if (exists("${root}/${token}")) {
    return token, true
  }
  let tokenComps = pathComponents(token)
  if (len(tokenComps) == 0) {
    return "", false
  }
  let matches = []string(0)
  for cand of index {
    if (suffixMatches(pathComponents(cand), tokenComps)) {
      matches = append(matches, cand)
    }
  }
  if (len(matches) == 1) {
    return matches[0], true
  }
  if (len(contextPath) > 0 && suffixMatches(pathComponents(contextPath), tokenComps)) {
    return contextPath, true
  }
  return "", false
}

// The most recently resolved file at or before `offset` (events is in order).
fn contextAt(events: []ContextEvent, offset: int): string {
  let result = ""
  for e of events {
    if (e.offset < offset) {
      result = e.path
    }
  }
  return result
}

// The (docPath, docLine, resolved, parseSpec, displaySpec, verb) cluster
// checkBoundsShared needs from either caller (an exact citation or a
// hedge) — bundled so the function stays under E0202's 5-param limit,
// same reasoning as CheckCtx below.
class BoundsQuery {
  docPath: string, docLine: int, resolved: string,
  parseSpec: string, displaySpec: string, verb: string,
}

// Tier-1 bounds check shared by an exact citation and a hedge: `resolved`
// must exist and `parseSpec`'s segments must fall in [1, its line count].
fn checkBoundsShared(sc: Scan, root: string, q: BoundsQuery): BoundsResult {
  let failResult = BoundsResult{ ok: false, lines: []string(0) }
  let full = "${root}/${q.resolved}"
  if (!exists(full)) {
    report(
      sc,
      "${q.docPath}:${q.docLine}: ${q.verb} ${q.resolved}:${q.displaySpec}, but ${q.resolved} does not exist under the repo root",
    )
    return failResult
  }
  let text = readFile(full) catch e {
    report(
      sc,
      "${q.docPath}:${q.docLine}: ${q.verb} ${q.resolved}:${q.displaySpec}, but it could not be read: ${e.message()}",
    )
    return failResult
  }
  if (len(text) > maxCitedFileBytes) {
    die("${q.resolved} is ${len(text)} bytes, over the ${maxCitedFileBytes} bound")
  }
  let lines = split(text, "\n")
  if (len(lines) > maxCitedFileLines) {
    die("${q.resolved} has ${len(lines)} lines, over the ${maxCitedFileLines} bound")
  }
  let lineCount = len(lines)
  let segs = parseSegments(q.parseSpec)
  if (len(segs) == 0) {
    report(
      sc,
      "${q.docPath}:${q.docLine}: ${q.verb} ${q.resolved}:${q.displaySpec}, which has an unparseable line spec",
    )
    return failResult
  }
  if (!segsInBounds(segs, lineCount)) {
    report(
      sc,
      "${q.docPath}:${q.docLine}: ${q.verb} ${q.resolved}:${q.displaySpec}, out of bounds (${q.resolved} has ${lineCount} line(s))",
    )
    return failResult
  }
  return BoundsResult{ ok: true, lines: lines }
}

// Whether every segment is `ok` and within [1, lineCount] — split out of
// checkBoundsShared to keep it under E0204's complexity-10 limit.
fn segsInBounds(segs: []Segment, lineCount: int): bool {
  for seg of segs {
    if (!seg.ok || seg.start < 1 || seg.end > lineCount) {
      return false
    }
  }
  return true
}

// Tier-1 (+ Tier-2 when `row.verifySymbols`) for one already-resolved citation.
// The (sc, root, row, index, seen) bundle every Tier-2 check below needs,
// threaded through as one value instead of five separate params — #3611
// added `index`/`seen` on top of the pre-existing (sc, root, row), which
// would have pushed every callee straight past E0202's param-count limit.
class CheckCtx { sc: Scan, root: string, row: DocRow, index: []string, seen: SeenSymbols }

// One citation and the symbol name findAssociatedSymbol paired it with —
// the unit both Tier-2 checks (checkSymbolCitation, checkSymbolMoved) report
// against, bundled so neither needs resolved/tok/symbolName as three
// separate params on top of CheckCtx.
class CitedSymbol { resolved: string, tok: PathToken, symbolName: string }

fn checkExactCitationBody(ctx: CheckCtx, docText: string, tok: PathToken, resolved: string) {
  let res = checkBoundsShared(
    ctx.sc,
    ctx.root,
    BoundsQuery{
      docPath: ctx.row.docPath, docLine: tok.docLine, resolved: resolved,
      parseSpec: tok.lineSpecRaw, displaySpec: tok.lineSpecRaw, verb: "cites",
    },
  )
  if (!res.ok) {
    return
  }
  ctx.sc.boundsChecked = ctx.sc.boundsChecked + 1
  if (!ctx.row.verifySymbols) {
    return
  }
  let symbolName = findAssociatedSymbol(docText, tok.startOffset)
  if (len(symbolName) == 0) {
    return
  }
  let cited = CitedSymbol{ resolved: resolved, tok: tok, symbolName: symbolName }
  checkSymbolCitation(ctx, cited, res.lines)
}

// Tier-1 for one hedge, resolved against `resolvedContext`.
fn checkHedge(sc: Scan, root: string, row: DocRow, resolvedContext: string, h: Hedge) {
  sc.hedges = sc.hedges + 1
  if (len(resolvedContext) == 0) {
    report(
      sc,
      "${row.docPath}:${h.docLine}: hedges toward ~${h.lineSpecRaw}, but no preceding full-path file mention resolves it",
    )
    return
  }
  let normalized = replace(h.lineSpecRaw, "/", ",")
  let res = checkBoundsShared(
    sc,
    root,
    BoundsQuery{
      docPath: row.docPath, docLine: h.docLine, resolved: resolvedContext,
      parseSpec: normalized, displaySpec: "~${h.lineSpecRaw}", verb: "hedges toward",
    },
  )
  if (!res.ok) {
    return
  }
  sc.hedgesChecked = sc.hedgesChecked + 1
}

// Loop-carried state across checkDocument's token pass: the most recently
// resolved full-path context (see `contextAt`) and its event log, both
// mutated per token — bundled into one out-param (a class, mutated in
// place like `sc` already is) so `processPathToken` doesn't need them as
// two separate params.
class ResolveTrail { contextPath: string, events: []ContextEvent }

// One path-token citation: resolves it, updates `trail`'s context, and
// dispatches to the exact-citation or bare-mention path. Split out of
// checkDocument to keep it under E0204's complexity-10 limit.
fn processPathToken(ctx: CheckCtx, docText: string, tok: PathToken, trail: ResolveTrail) {
  let (resolved, ok) = resolveToken(ctx.root, tok.file, ctx.index, trail.contextPath)
  // Only a token that was ITSELF written as a path (contains "/") becomes
  // the new context. A bare basename cited in passing (e.g. "floats.bit"
  // inside a list of other funnels' call sites) resolves fine on its own
  // merits but must not overwrite the paragraph's real subject file, or a
  // LATER hedge in the same paragraph would resolve against the wrong file.
  if (ok && contains(tok.file, "/")) {
    trail.contextPath = resolved
    trail.events = append(trail.events, ContextEvent{ offset: tok.startOffset, path: resolved })
  }
  if (tok.hasSpec) {
    processExactToken(ctx, docText, tok, resolved, ok)
    return
  }
  if (ctx.row.checkBareMentions) {
    processBareMention(ctx, tok, resolved, ok)
  }
}

// The `tok.hasSpec` arm of `processPathToken`: an exact `path:line` citation.
fn processExactToken(ctx: CheckCtx, docText: string, tok: PathToken, resolved: string, ok: bool) {
  ctx.sc.citations = ctx.sc.citations + 1
  if (!ok) {
    report(
      ctx.sc,
      "${ctx.row.docPath}:${tok.docLine}: cites ${tok.file}:${tok.lineSpecRaw}, but ${tok.file} could not be resolved to a file under any of: ${join(
        ctx.row.searchRoots,
        ", ",
      )}",
    )
    return
  }
  checkExactCitationBody(ctx, docText, tok, resolved)
}

// The bare-mention arm of `processPathToken` (`row.checkBareMentions`, no
// line spec): the token names a file with no `:NNN`, checked only for existence.
fn processBareMention(ctx: CheckCtx, tok: PathToken, resolved: string, ok: bool) {
  ctx.sc.bareMentions = ctx.sc.bareMentions + 1
  if (!ok) {
    report(
      ctx.sc,
      "${ctx.row.docPath}:${tok.docLine}: names ${tok.file}, which does not exist under the repo root",
    )
    return
  }
  if (!exists("${ctx.root}/${resolved}")) {
    report(
      ctx.sc,
      "${ctx.row.docPath}:${tok.docLine}: names ${resolved}, which does not exist under the repo root",
    )
  }
}

// Scans one document row end to end into `sc`; returns this row's own
// (citations, hedges, failures) delta so a zero-scan row can't hide in the aggregate.
fn checkDocument(sc: Scan, root: string, row: DocRow): (int, int, int) {
  let beforeCitations = sc.citations
  let beforeHedges = sc.hedges
  let beforeFailures = sc.failures
  let docFullPath = "${root}/${row.docPath}"
  let docText = readFile(docFullPath) catch e {
    die("cannot read ${docFullPath}: ${e.message()}")
    ""
  }
  if (len(docText) > maxDocBytes) {
    die("${docFullPath} is ${len(docText)} bytes, over the ${maxDocBytes} bound")
  }
  let index = buildIndexMulti(root, row.searchRoots)
  let tokens = extractPathTokens(docText, row.requiredPrefix)
  let trail = ResolveTrail{ contextPath: "", events: []ContextEvent(0) }
  let seen = SeenSymbols{ names: []string(0) }
  let ctx = CheckCtx{ sc: sc, root: root, row: row, index: index, seen: seen }
  for tok of tokens {
    processPathToken(ctx, docText, tok, trail)
  }
  for h of extractHedges(docText) {
    checkHedge(sc, root, row, contextAt(trail.events, h.startOffset), h)
  }
  return sc.citations - beforeCitations, sc.hedges - beforeHedges, sc.failures - beforeFailures
}

fn main() {
  let selfFailed = selfTest()
  if (selfFailed != 0) {
    eprint("fmtcitations: SELFTEST FAILED — ${selfFailed} case(s); aborting before the real scan\n")
    osExit(1)
  }
  let root = repoRoot()
  let rows = docRows()
  let sc = Scan{
    citations: 0,
    boundsChecked: 0,
    verified: 0,
    bareMentions: 0,
    hedges: 0,
    hedgesChecked: 0,
    failures: 0,
  }
  let perDocSummaries = []string(0)
  for row of rows {
    let (rowCitations, rowHedges, rowFailures) = checkDocument(sc, root, row)
    if (rowCitations + rowHedges < row.minCitations) {
      report(
        sc,
        "${row.docPath}: only ${rowCitations} citation(s) and ${rowHedges} hedge(s) found, want >= ${row.minCitations} — the scanner regressed or the doc lost its citations",
      )
    }
    perDocSummaries = append(
      perDocSummaries,
      "${row.docPath}: ${rowCitations} citation(s), ${rowHedges} hedge(s), ${rowFailures} failure(s)",
    )
  }
  let totalCitations = sc.citations + sc.hedges
  if (totalCitations < minTotalCitationsFloor) {
    report(
      sc,
      "only ${totalCitations} total citation(s) (exact + hedged) found across ${len(rows)} document(s), want >= ${minTotalCitationsFloor}",
    )
  }
  if (sc.verified < minVerifiedFloor) {
    report(
      sc,
      "only ${sc.verified} citation(s) symbol-verified, want >= ${minVerifiedFloor} — the association heuristic regressed",
    )
  }
  let mdSc = newScan()
  let mdFiles = checkMdCitations(mdSc, root)
  sc.failures = sc.failures + mdSc.failures
  let summary = join(perDocSummaries, "; ") + "; " + mdSummaryLine(mdSc, mdFiles)
  if (sc.failures > 0) {
    eprint("fmtcitations: FAILED — ${sc.failures} finding(s) over ${len(rows)} document(s) scanned, ${totalCitations} citation(s) total (${sc.citations} exact, ${sc.hedges} hedged, ${sc.boundsChecked} bounds-checked, ${sc.hedgesChecked} hedges-checked, ${sc.verified} symbol-verified, ${sc.bareMentions} bare mention(s)) — ${summary}\n")
    osExit(1)
  }
  print("fmtcitations: ok — ${len(rows)} document(s) scanned, ${totalCitations} citation(s) total (${sc.citations} exact, ${sc.hedges} hedged, ${sc.boundsChecked} bounds-checked, ${sc.hedgesChecked} hedges-checked, ${sc.verified} symbol-verified, ${sc.bareMentions} bare mention(s)), 0 failure(s) — ${summary}\n")
}
