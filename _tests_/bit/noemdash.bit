// _tests_/bit/noemdash.bit — no U+2014 (em dash) in reader-facing prose
// (#5101), and no private-workspace path (#6325) anywhere in the repo.
//
// Owner, 2026-09-12, on bitlang.org/packages/web.html: "why fucking its full
// of em dashes" — pkg/web/README.md is rendered verbatim onto that page. The
// house style (bit-website gen/page.bit's footer copy) is a spaced hyphen
// (" - "), never an em dash, so this gate makes the source of truth match it
// and stops the next agent writing a new one.
//
// EM-DASH SCOPE, STATED EXPLICITLY, same shape as _tests_/bit/spec/spec.bit's
// own scope comment: `docs/**/*.md`, `spec/*.md` (top-level only — `spec/`
// has no subdirectories today, and `spec/*.md` never asked for one),
// `pkg/README.md` and `pkg/<name>/README.md` for every package directory,
// the repo-root `README.md` and `BOOTSTRAP.md`, and every file under `dist/`
// (its release and changelog scripts print straight to a release's stdout,
// so a comment in one of them is exactly as reader-facing as its own
// output). Never `compiler/`, `runtime/`, `stdlib/` or `_tests_/` — those
// are ~25k separate occurrences in code comments, out of scope by owner
// ruling (#5101).
//
// PRIVATE-PATH SCOPE (owner rule, #6325: public text never names a private
// repo or private workspace file): the whole repository, since a comment
// citing `.claude/kb/*.md`, `.claude/skills/*` or `.claude/boxlock.sh` can
// land in any tree, not just reader-facing prose — #6325 found 54 such
// citations across compiler/, pkg/orm/, _tests_/, bench/ and dist/. Skips
// only gitignored build output and VCS/vendor internals (bit-out/,
// dist/out/, editors/vscode/{node_modules,dist,out}/, .git, .fixpoint-work/,
// .ssd/ — see .gitignore), never a source tree.
//
// Run from the repository root: ./bit-out/bin/bit run _tests_/bit/noemdash.bit
// BIT_REPO overrides the repository root the same way _tests_/bit/spec/spec.bit's does.

import { env, exit } from "std/os"
import { exists, isDir, readDir, readFile, walk } from "std/fs"
import { contains, hasPrefix, hasSuffix, split } from "std/strings"
import { join } from "std/path"

const emDash = "—"

fn die(msg: string) {
  eprint("noemdash: SETUP FAILED: ${msg}\n")
  exit(1)
}

// The repo root: the nearest ancestor holding `spec/SPEC.md`. BIT_REPO wins.
// Never falls back silently — a wrong cwd must abort, not scan an empty tree.
fn repoRoot(): string {
  let override = env("BIT_REPO")
  if (len(override) > 0) {
    return override
  }
  let candidates = [".", "..", "../..", "../../.."]
  for c of candidates {
    if (exists("${c}/spec/SPEC.md")) {
      return c
    }
  }
  die("cannot locate spec/SPEC.md from this cwd; set BIT_REPO")
  return ""
}

fn appendAll(dst: []string, src: []string): []string {
  let out = dst
  for s of src {
    // bit:lint allow E0214 -- growth reaches the caller via `return out` below
    out = append(out, s)
  }
  return out
}

fn mdFilesRecursive(dir: string): []string {
  if (!exists(dir)) {
    die("expected directory ${dir} does not exist")
  }
  let all = walk(dir) catch e {
    die("cannot walk ${dir}: ${e.message()}")
    []string(0)
  }
  let out = []string(0)
  for p of all {
    if (hasSuffix(p, ".md")) {
      out = append(out, p)
    }
  }
  return out
}

fn mdFilesFlat(dir: string): []string {
  if (!exists(dir)) {
    die("expected directory ${dir} does not exist")
  }
  let names = readDir(dir) catch e {
    die("cannot list ${dir}: ${e.message()}")
    []string(0)
  }
  let out = []string(0)
  for name of names {
    if (hasSuffix(name, ".md")) {
      out = append(out, join(dir, name))
    }
  }
  return out
}

// Bound on package-tree recursion (Power of 10 rule 2). A package nests a
// handful of levels at most (docs/, bench/, bench/apps/<lang>/) - nothing
// close to this.
const maxPkgWalkDepth: int = 16

// Every `.md` file under `dir`, recursively, except anything inside a
// directory literally named `out` - this repo's standing name for
// gitignored build output (`bit-out/`, `dist/out/`, `editors/vscode/out/`,
// and now `pkg/<name>/bench/out/`, which `bench/run.sh` fills with a
// generated `block.md`, #5101). Matching the directory NAME rather than a
// per-package path is the same shape as compiler/testrun.bit's
// `testWalkSkipsDir` and _tests_/bit/shellsize.bit's `scanDirSkipsChild`; a
// future gitignored subdirectory anywhere under a package stays excluded
// without adding a case here. Deriving this from `git check-ignore` instead
// was rejected for the same reason those two reject it: `std/process`'s
// `run` has no way to capture a child process's stdout
// (stdlib/process/process.bit), so the population could not be built from
// its output even if the process were spawned.
fn mdFilesUnderPkg(dir: string, depth: int): []string {
  if (depth <= 0) {
    die("pkg directory nesting exceeds ${maxPkgWalkDepth} at ${dir}")
  }
  let names = readDir(dir) catch e {
    die("cannot list ${dir}: ${e.message()}")
    []string(0)
  }
  let out = []string(0)
  for name of names {
    if (name == "out") {
      continue
    }
    let p = join(dir, name)
    if (isDir(p)) {
      out = appendAll(out, mdFilesUnderPkg(p, depth - 1))
      continue
    }
    if (hasSuffix(p, ".md")) {
      out = append(out, p)
    }
  }
  return out
}

// pkg/README.md, and for every package directory every `.md` file anywhere
// under it - never hardcoded to today's packages, and never hardcoded to a
// named subdirectory either, so a sixth package or a third kind of
// subdirectory needs no change here.
//
// This used to collect README.md plus a hardcoded `docs/` subtree, which was
// the whole of a package's prose when it was written and stopped being so
// twice: #5106 moved documentation into `docs/` and left a real em dash in
// pkg/postgres/docs/queries.md unscanned ("PASS - 0 of 100", the population
// unmoved); #5501 and #5488 then added a `bench/` to two packages and the
// same hole reopened, because adding `docs/` as a second hardcoded name only
// bought time until a third kind of subdirectory appeared. Walking the whole
// package tree (`mdFilesUnderPkg`) closes it for every subdirectory, named or
// not, that exists today or gets added later.
fn pkgReadmes(root: string): []string {
  let pkgDir = "${root}/pkg"
  let out = []string(0)
  let top = join(pkgDir, "README.md")
  if (exists(top)) {
    out = append(out, top)
  }
  let names = readDir(pkgDir) catch e {
    die("cannot list ${pkgDir}: ${e.message()}")
    []string(0)
  }
  for name of names {
    let sub = join(pkgDir, name)
    if (!isDir(sub)) {
      continue
    }
    out = appendAll(out, mdFilesUnderPkg(sub, maxPkgWalkDepth))
  }
  return out
}

fn targetFiles(root: string): []string {
  let out = []string(0)
  out = appendAll(out, mdFilesRecursive("${root}/docs"))
  out = appendAll(out, mdFilesFlat("${root}/spec"))
  out = appendAll(out, pkgReadmes(root))
  let readme = "${root}/README.md"
  if (exists(readme)) {
    out = append(out, readme)
  }
  let bootstrap = "${root}/BOOTSTRAP.md"
  if (exists(bootstrap)) {
    out = append(out, bootstrap)
  }
  out = appendAll(out, distFiles(root))
  return out
}

// Every file under dist/ except the gitignored build output dist/out/, which
// holds release tarballs and a staged copy of the whole compiler source. The
// walk is of the filesystem, not of the index, so on a checkout that has cut a
// release it would otherwise fail on files the sweep never owned: the gate
// passed in a fresh worktree and failed on the shared checkout for exactly
// that reason.
fn distFiles(root: string): []string {
  let all = walk("${root}/dist") catch e {
    die("cannot walk ${root}/dist: ${e.message()}")
    []string(0)
  }
  let out = []string(0)
  let skip = "${root}/dist/out/"
  for p of all {
    if (hasPrefix(p, skip)) {
      continue
    }
    out = append(out, p)
  }
  return out
}

// The 1-based line numbers of every line containing `emDash`. A file with two
// em dashes must report both — naming only the first left the gate red on the
// next run at the second one, reading as a new regression rather than the
// same file (docs/stdlib/sql.md, lines 708 and 718, only 708 was reported).
fn offendingLines(content: string): []int {
  let lines = split(content, "\n")
  let out = []int(0)
  let n = 0
  for line of lines {
    n = n + 1
    if (contains(line, emDash)) {
      out = append(out, n)
    }
  }
  return out
}

// The three private-workspace path fragments a public comment or doc must
// never contain (#6325): `.claude/kb/*.md` and `.claude/skills/*` cite files
// that exist only in the maintainer's local workspace, and `.claude/boxlock.sh`
// names the workspace's build-slot lock script — none exist in a clone of
// this repository. `.claude/worktrees/` is deliberately NOT here: naming that
// one directory to describe a real skip-while-walking behavior (lintbatch.bit,
// projectcli.bit, this file's own em-dash scope above) is not a citation to a
// private file, and #6325 reworded every such spot to drop the literal path
// anyway.
fn privateMarkers(): []string {
  return [".claude/kb", ".claude/skills", ".claude/boxlock"]
}

// PERMANENT: this gate's own implementation, which necessarily holds the
// literal marker strings above as data and documents them by name in its
// own header comment — neither is a citation to a private file, both are
// the gate's own definition of what one looks like.
//
// TEMPORARY (#6325): stdlib/sql/desc.bit still cites `.claude/kb/...` because
// the epic owning that file (#6298) was mid-edit when this gate was written.
// Delete this second case the moment that citation is reworded — a paydown
// queue, not a standing exemption.
fn privateScanAllowlisted(path: string): bool {
  return hasSuffix(path, "/_tests_/bit/noemdash.bit") ||
    hasSuffix(path, "/stdlib/sql/desc.bit")
}

// Gitignored build output and VCS/vendor internals (see .gitignore) — never
// a source tree, and `bit-out/` alone holds thousands of unrelated files
// (a pinned oracle snapshot plus build artifacts). `walk` has no
// per-directory skip, so this filters its full recursive result by prefix,
// the same shape distFiles above uses for `dist/out/`.
fn privateScanSkipsPath(root: string, path: string): bool {
  let skips = [
    "${root}/bit-out/", "${root}/dist/out/",
    "${root}/editors/vscode/node_modules/", "${root}/editors/vscode/dist/",
    "${root}/editors/vscode/out/", "${root}/.git", "${root}/.fixpoint-work/",
    "${root}/.ssd/",
  ]
  for skip of skips {
    if (hasPrefix(path, skip)) {
      return true
    }
  }
  return false
}

fn privateScanFiles(root: string): []string {
  let all = walk(root) catch e {
    die("cannot walk ${root}: ${e.message()}")
    []string(0)
  }
  let out = []string(0)
  for p of all {
    if (!privateScanSkipsPath(root, p)) {
      out = append(out, p)
    }
  }
  return out
}

class PrivatePathScan {
  filesScanned: int,
  failedFiles: int,
  findings: int,
}

fn scanFileForPrivatePaths(scan: PrivatePathScan, path: string) {
  let content = readFile(path) catch e {
    die("cannot read ${path}: ${e.message()}")
    ""
  }
  let lines = split(content, "\n")
  let markers = privateMarkers()
  let n = 0
  let fileHit = false
  for line of lines {
    n = n + 1
    let hit = false
    for marker of markers {
      if (contains(line, marker)) {
        hit = true
      }
    }
    if (hit) {
      eprint("noemdash: FAIL: private workspace path in ${path}:${n}\n")
      scan.findings = scan.findings + 1
      fileHit = true
    }
  }
  if (fileHit) {
    scan.failedFiles = scan.failedFiles + 1
  }
}

fn runPrivatePathCheck(root: string): PrivatePathScan {
  let files = privateScanFiles(root)
  if (len(files) == 0) {
    die("private-path scan found 0 files - the repo walk is broken")
  }
  let scan = PrivatePathScan{ filesScanned = len(files), failedFiles = 0, findings = 0 }
  for path of files {
    if (!privateScanAllowlisted(path)) {
      scanFileForPrivatePaths(scan, path)
    }
  }
  return scan
}

fn main() {
  let root = repoRoot()
  let files = targetFiles(root)
  if (len(files) == 0) {
    die("scanned 0 files - every target directory is empty or missing")
  }

  let failures = []string(0)
  let failedFiles = 0
  for path of files {
    let content = readFile(path) catch e {
      die("cannot read ${path}: ${e.message()}")
      ""
    }
    if (contains(content, emDash)) {
      failedFiles = failedFiles + 1
      for line of offendingLines(content) {
        failures = append(failures, "${path}:${line}")
      }
    }
  }
  for f of failures {
    eprint("noemdash: FAIL: em dash (U+2014) in ${f}\n")
  }

  let privateScan = runPrivatePathCheck(root)

  if (len(failures) > 0 || privateScan.findings > 0) {
    println("noemdash: FAIL - ${failedFiles} of ${len(files)} file(s) contain an em dash, ${privateScan.failedFiles} of ${privateScan.filesScanned} file(s) cite a private workspace path")
    exit(1)
  }
  println("noemdash: PASS - 0 of ${len(files)} file(s) contain an em dash, 0 of ${privateScan.filesScanned} file(s) cite a private workspace path")
}
