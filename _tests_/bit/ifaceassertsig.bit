// _tests_/bit/ifaceassertsig.bit — #5979: `v.(I)` (SPEC §14.4) narrowing must
// check every method of `I` by NAME AND SIGNATURE, not name alone. Unqualified,
// a class whose method only shares a NAME with `I`'s passes the assertion and
// then segfaults the first call through it (`Wrong.step(s: string): string` vs
// `Stepper.step(x: int): int`, both named "step").
//
// NOT placed in _tests_/cases/: the fix is gated behind `BIT_IFACE_SIG` (default
// off — it changes every method-table dispatch id against the pinned stage0,
// see compiler/lower.bit's `ifaceSigEnabled`), and that corpus's golden/stage0
// harnesses run with a fixed environment, no per-fixture env var. Same
// "drive the CLI directly, outside the oracle-swept corpus" treatment
// _tests_/bit/forofiterator.bit documents (moved there at cdd347bcd for an
// unrelated reason — post-pin surface — but the isolation mechanism is
// identical: BIT_BIN/BIT_STDLIB/BIT_LIBBITRT, no oracle involved).
//
// One program, four probes, one printed line:
//   step    — Stepper.step(x: int): int vs Wrong.step(s: string): string:
//             same name, disjoint param types -> miss.
//   right   — Right.step(x: int): int matches exactly -> hit, "2".
//   result  — ResultMismatch.step(x: int): string: same params, different
//             RESULT type only -> miss (the one case a params-only compare
//             would let through).
//   generic — Box<T>.get(): T, a plain method on a GENERIC class: T=int
//             satisfies Getter{ get(): int }, T=string does not — proves the
//             signature compare reads the INSTANCE's own resolved type
//             (`methodSigLookup(c, "${inst.result}.${mname}")`,
//             compiler/lowermethodtable.bit), not the generic template's.
//
// WIRED INTO `./make test` as `test-ifaceassertsig`
// (tools/build/gatestable2.bit, tools/build/defs.bit).

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"
import { parseInt, trimSpace } from "std/strings"

const defaultTimeoutS: int = 60
const maxTimeoutMs: int = 6000000

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("ifaceassertsig: ${name} is not set — refusing to guess.\n")
    exit(2)
  }
  return v
}

fn timeoutMs(): int {
  let raw = trimSpace(envOr("BIT_TEST_TIMEOUT_S", ""))
  if (raw == "") {
    return defaultTimeoutS * 1000
  }
  let s = parseInt(raw) catch _ {
    return defaultTimeoutS * 1000
  }
  if (s <= 0) {
    return maxTimeoutMs
  }
  if (s * 1000 > maxTimeoutMs) {
    return maxTimeoutMs
  }
  return s * 1000
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

fn fixtureSrc(): string {
  return "interface Named { name(): string, }\n" +
    "interface Stepper { name(): string, step(x: int): int, }\n" +
    "interface Getter { name(): string, get(): int, }\n" +
    "class Wrong {\n  tag: string\n  name(): string { return \"wrong\" }\n" +
    "  step(s: string): string { return s + this.tag }\n}\n" +
    "class Right {\n  tag: string\n  name(): string { return \"right\" }\n" +
    "  step(x: int): int { return x + 1 }\n}\n" +
    "class ResultMismatch {\n  tag: string\n  name(): string { return \"rm\" }\n" +
    "  step(x: int): string { return \"\${x}\" }\n}\n" +
    "class Box<T> {\n  v: T\n  get(): T { return this.v }\n" +
    "  name(): string { return \"box\" }\n}\n" +
    "fn probeStep(v: Named): string {\n" +
    "  let (s, ok) = v.(Stepper)\n" +
    "  if (ok) { return \"\${s.step(1)}\" }\n  return \"miss\"\n}\n" +
    "fn probeGet(v: Named): string {\n" +
    "  let (g, ok) = v.(Getter)\n" +
    "  if (ok) { return \"\${g.get()}\" }\n  return \"miss\"\n}\n" +
    "fn main() {\n" +
    "  let w = Wrong{tag = \"!\"}\n" +
    "  let r = Right{tag = \"!\"}\n" +
    "  let rm = ResultMismatch{tag = \"!\"}\n" +
    "  let bi = Box<int>{v = 7}\n" +
    "  let bs = Box<string>{v = \"x\"}\n" +
    "  println(\"\${probeStep(w)} \${probeStep(r)} \${probeStep(rm)} \${probeGet(bi)} \${probeGet(bs)}\")\n" +
    "}\n"
}

const wantOut: string = "miss 2 miss 7 miss\n"

class CompilerEnv {
  bin: string,
  stdlib: string,
  libbitrt: string,
}

// Builds `srcPath` to `outPath` with `BIT_IFACE_SIG=1` set — the flag this
// fixture exists to pin, off by default everywhere else (compiler/lower.bit).
fn buildOne(cc: CompilerEnv, dir: string, srcPath: string, outPath: string): (int, string) {
  let shPath = dir + "/build.sh"
  let errPath = dir + "/build.err"
  let script = "#!/bin/sh\n" +
    "BIT_STDLIB=" +
    shQuote(cc.stdlib) +
    "\nexport BIT_STDLIB\n" +
    "BIT_LIBBITRT=" +
    shQuote(cc.libbitrt) +
    "\nexport BIT_LIBBITRT\n" +
    "BIT_IFACE_SIG=1\nexport BIT_IFACE_SIG\n" +
    "exec " +
    shQuote(cc.bin) +
    " build " +
    shQuote(srcPath) +
    " -o " +
    shQuote(outPath) +
    " > /dev/null 2> " +
    shQuote(errPath) +
    "\n"
  writeFile(shPath, script) catch e {
    eprint("ifaceassertsig: cannot write build wrapper: ${e.message()}\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("ifaceassertsig: cannot chmod build wrapper\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let err = readFile(errPath) catch _ {
    ""
  }
  return code, err
}

fn runOne(dir: string, binPath: string): (int, string) {
  let shPath = dir + "/run.sh"
  let outPath = dir + "/run.out"
  let script = "#!/bin/sh\nexec " + shQuote(binPath) + " > " + shQuote(outPath) + " 2>&1\n"
  writeFile(shPath, script) catch e {
    eprint("ifaceassertsig: cannot write run wrapper: ${e.message()}\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("ifaceassertsig: cannot chmod run wrapper\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let out = readFile(outPath) catch _ {
    ""
  }
  return code, out
}

fn teardown(scratch: string, ms: int) {
  let shPath = scratch + "/rm.sh"
  writeFile(shPath, "#!/bin/sh\nrm -rf '${scratch}'\n") catch _ {
    return
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    return
  }
  osRunBounded(shPath, ms)
}

fn main() {
  let cc = CompilerEnv{
    bin = requiredEnv("BIT_BIN"),
    stdlib = requiredEnv("BIT_STDLIB"),
    libbitrt = requiredEnv("BIT_LIBBITRT"),
  }

  let scratch = envOr("TMPDIR", "/tmp") + "/bit-ifaceassertsig-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("ifaceassertsig: cannot create scratch directory ${scratch}: ${e.message()}\n")
    exit(2)
  }

  let srcPath = scratch + "/fixture.bit"
  writeFile(srcPath, fixtureSrc()) catch e {
    eprint("ifaceassertsig: cannot write ${srcPath}: ${e.message()}\n")
    teardown(scratch, timeoutMs())
    exit(2)
  }
  let outPath = scratch + "/fixture_out"
  let (buildCode, buildErr) = buildOne(cc, scratch, srcPath, outPath)
  if (buildCode != 0) {
    eprint("ifaceassertsig: FAIL — fixture failed to build (exit ${buildCode}):\n${buildErr}\n")
    teardown(scratch, timeoutMs())
    exit(1)
  }
  let (runCode, out) = runOne(scratch, outPath)
  if (runCode != 0 || out != wantOut) {
    eprint("ifaceassertsig: FAIL — ran wrong: exit=${runCode}\n  want: ${wantOut}\n  got:  ${out}\n")
    teardown(scratch, timeoutMs())
    exit(1)
  }

  teardown(scratch, timeoutMs())
  print("PASS ifaceassertsig: v.(I) narrowing checks name AND signature — mismatch, exact, result-only mismatch, and a generic-class instance all resolve correctly under BIT_IFACE_SIG=1\n")
}
