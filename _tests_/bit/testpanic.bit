// _tests_/bit/testpanic.bit — regression gate for #2839/#2840: `bit test`
// discovers `testpanic_` functions and inverts their verdict. A `testpanic_`
// function PASSES only when its child process dies by the runtime's own
// panic exit status, and FAILS when it returns normally.
//
// NOT placed in _tests_/cases/ (the golden.bit-swept corpus, `./make
// test-golden`): every case there is compiled STANDALONE with `bit build
// <file> -o <bin>` (_tests_/bit/golden.bit's checkRun) and the resulting
// binary is then executed directly — proven empirically against exactly
// this fixture, no `main`: `bit: <path>: no `main` in this module (an entry
// point is a top-level `fn main()`)`, exit 1. The property under test is
// `bit test` itself (compiler/testgen.bit's discovery, compiler/testrun.bit's
// verdict), which golden.bit's corpus never invokes at all — the same
// "route it to _tests_/bit/ behind a registered gate" treatment
// _tests_/bit/classkeyword.bit and _tests_/bit/deferblock.bit both use for a
// fixture their corpus is structurally unsuited to run.
//
// Pins BOTH directions in one fixture, matching #2839's own acceptance shape
// exactly: `testpanic_boom` (calls a function that panics) must PASS,
// `testpanic_safe` (calls a function that returns normally) must FAIL. One
// direction alone cannot distinguish a working feature from one that always
// reports the same verdict.
//
// `_tests_/bit/testpanic.expected` is the real captured stdout of `bit test`
// against the fixture below, written byte-for-byte from an actual run —
// never composed by hand.
//
// WIRED INTO `./make test` as `test-testpanic` (tools/build/gates.bit,
// tools/build/defs.bit).

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"
import { parseInt, trimSpace, contains } from "std/strings"

const defaultTimeoutS: int = 60
const maxTimeoutMs: int = 6000000

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("testpanic: ${name} is not set — refusing to guess.\n")
    exit(2)
  }
  return v
}

// Same contract every harness here shares: default 60s (one tiny fixture,
// two discovered tests), `0` disables the bound.
fn timeoutMs(): int {
  let raw = trimSpace(envOr("BIT_TEST_TIMEOUT_S", ""))
  if (raw == "") {
    return defaultTimeoutS * 1000
  }
  let s = parseInt(raw) catch _ {
    return defaultTimeoutS * 1000
  }
  if (s <= 0) {
    return maxTimeoutMs
  }
  if (s * 1000 > maxTimeoutMs) {
    return maxTimeoutMs
  }
  return s * 1000
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

// The fixture: `boom`/`safe` are #2839's own acceptance criteria's two
// helpers, and `testpanic_boom`/`testpanic_safe` are `test "..." { }`
// declarations (#4148: the legacy bare-`fn` discovery form these two used to
// be is removed) whose DISPLAY STRINGS carry the `testpanic_` prefix — the
// verdict-inversion rule (testgen.bit's `isTestPanicName`) reads a test's
// display name, never a symbol, so the string is what has to carry it now.
// No `main` — `bit test` builds its OWN synthetic entry point (testgen.bit's
// injectTestMain) and never needs one.
const fixtureSrc: string = "fn boom(): int { panic(\"deliberate\") }\n" +
  "fn safe(): int { return 1 }\n" +
  "test \"testpanic_boom\" { boom() }\n" +
  "test \"testpanic_safe\" { safe() }\n"

// Runs `bit test srcPath`, with the compiler's own environment
// (BIT_STDLIB/BIT_LIBBITRT) exported. Returns the exit code, captured
// stdout and captured stderr.
fn runTest(
  bin: string,
  stdlib: string,
  libbitrt: string,
  dir: string,
  srcPath: string,
): (int, string, string) {
  let shPath = dir + "/run.sh"
  let outPath = dir + "/run.out"
  let errPath = dir + "/run.err"
  let script = "#!/bin/sh\n" +
    "BIT_STDLIB=" +
    shQuote(stdlib) +
    "\nexport BIT_STDLIB\n" +
    "BIT_LIBBITRT=" +
    shQuote(libbitrt) +
    "\nexport BIT_LIBBITRT\n" +
    "exec " +
    shQuote(bin) +
    " test " +
    shQuote(srcPath) +
    " > " +
    shQuote(outPath) +
    " 2> " +
    shQuote(errPath) +
    "\n"
  writeFile(shPath, script) catch e {
    eprint("testpanic: cannot write run wrapper: ${e.message()}\n")
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("testpanic: cannot chmod run wrapper\n")
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let out = readFile(outPath) catch _ {
    ""
  }
  let err = readFile(errPath) catch _ {
    ""
  }
  return code, out, err
}

fn main() {
  let bin = requiredEnv("BIT_BIN")
  let stdlib = requiredEnv("BIT_STDLIB")
  let libbitrt = requiredEnv("BIT_LIBBITRT")
  let repo = requiredEnv("BIT_REPO")

  let expectedPath = "${repo}/_tests_/bit/testpanic.expected"
  // `panic`, not `eprint`+`exit(2)`: the catch tail is bound to `string`
  // (readFile's ok type), and only a literal `panic(...)` call is recognized
  // as diverging (compiler/validatestmt.bit's vDiverges/vIsPanicCall) — a
  // call to `exit` is an ordinary function returning `()`, which fails E0041
  // against the expected `string`.
  let wantOut = readFile(expectedPath) catch e {
    panic("testpanic: cannot read ${expectedPath}: ${e.message()}")
  }

  let scratch = envOr("TMPDIR", "/tmp") + "/bit-testpanic-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("testpanic: cannot create scratch directory ${scratch}: ${e.message()}\n")
    exit(2)
  }

  // SPEC section 19: a test is a `test "name" { }` declaration in a
  // `.test.bit` file. This scratch fixture must carry that suffix or `bit
  // test` finds nothing in it and the "must fail" assertion below never
  // fires — exactly the failure #3779 found on merged `main`.
  let srcPath = scratch + "/testpanic_directions.test.bit"
  writeFile(srcPath, fixtureSrc) catch e {
    eprint("testpanic: cannot write ${srcPath}: ${e.message()}\n")
    exit(2)
  }

  let (code, out, err) = runTest(bin, stdlib, libbitrt, scratch, srcPath)
  if (code == 0) {
    eprint("testpanic: FAIL — exit 0, want non-zero (testpanic_safe must fail the run):\n  stdout: ${out}\n  stderr: ${err}\n")
    exit(1)
  }
  if (out != wantOut) {
    eprint("testpanic: FAIL — stdout did not match ${expectedPath}:\n  want: ${wantOut}\n  got:  ${out}\n")
    exit(1)
  }
  if (!contains(err, "panic: deliberate")) {
    eprint("testpanic: FAIL — stderr did not show the boom() panic: ${err}\n")
    exit(1)
  }

  print("PASS testpanic: testpanic_boom passes on a real panic, testpanic_safe fails on a normal return\n")
}
