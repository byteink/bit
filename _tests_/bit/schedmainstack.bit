// #2613: `main` gets its own 8 MiB stack (`schedMainStackBytes`,
// runtime/sched/sched.bit), registered with `schedRegisterBigStack` rather
// than found by masking `sp` to the (much smaller) `schedStackBytes` granule
// every other task uses. This proves the whole path end to end, on the
// thread it actually matters on: recurse `main` far past what the granule
// could ever hold, then do a channel op at the deepest frame.
//
// A channel send/receive is the discriminator, not incidental plumbing: it
// is the operation that reaches `schedCurrentTask()` (to find the task's own
// select/error scratch words), so it is what actually exercises identity
// resolution at depth. A BROKEN identity does not panic cleanly here — it
// resolves to task 0, which the runtime treats as fatal (rootExit(70)), so
// this case's exit code IS the assertion: 0 only if `schedCurrentTask()`
// named `main` correctly from 100000 frames down its own 8 MiB stack.
//
// 100000 frames comfortably clears the granule this task does NOT use (100000
// frames would overflow every ordinary 256 KiB task by roughly 30x, per
// ../stress/greenstackdepth's measured ~48-byte frame) while staying well
// inside `main`'s 8 MiB budget for a frame this small (two int-sized
// parameters, no locals, no array).
const DEPTH: int = 100000

fn down(n: int, c: chan<int>): int {
  if (n <= 0) {
    c <- 1
    return <- c
  }
  return down(n - 1, c)
}

fn main() {
  let c = chan<int>(1)
  let v = down(DEPTH, c)
  if (v != 1) {
    print("wrong: ${v}\n")
    return
  }
  print("ok\n")
}
