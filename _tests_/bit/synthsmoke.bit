// _tests_/bit/synthsmoke.bit — `./make test-synth-smoke` (#2853).
//
// dist/release.sh, dist/release-smoke.sh (sourced by release.sh, split out by
// #4132 as a pure move) and docker/toolchain.Dockerfile each write a
// throwaway Bit program as a `printf '...'` string and hand it straight to
// the compiler as their OWN smoke test. Nothing else ever compiled that text:
// #2773 removed the `function` keyword, `main` was pushed, `./make test` was
// green across 43 gates, and `main` was unreleasable for a full day — found
// only when a human ran `dist/release.sh 0.1.13` and it died
// `error[E0089]: 'function' is not a keyword` at its own smoke test.
//
// SHAPE 1 (extract the emitted text and `bit check` it), not shape 2 (one
// committed .bit file both scripts read): shape 2 would change how
// release.sh transports the program to the two remote hosts it verifies
// against (a real docker container and a real x86-64 box over ssh) — exactly
// the release-time behaviour #2853 says not to touch ("do not weaken or
// remove dist/release.sh's own smoke test"). Shape 1 pays for that instead
// with escaping complexity: the five sites cross THREE different amounts of
// shell quoting before their `printf` ever runs, verified empirically
// against a real /bin/sh (with `od -c`, not derived from memory):
//
//   1. dist/release-smoke.sh's `smoke()` (the native aarch64-macos host,
//      relocated here from release.sh by #4132): the printf line runs
//      exactly as written — "direct".
//   2. dist/release.sh's aarch64-linux docker path: the same printf line, but
//      with its backslashes doubled (`\\\\n`), because it is the BODY of an
//      UNQUOTED `<<-SH` heredoc. Writing that heredoc collapses `\\` pairs to
//      one literal backslash before the generated go.sh's own printf ever
//      runs — the doubling is what makes the two converge on the same text —
//      "heredoc".
//   3. dist/release.sh's x86_64-linux remote path: doubled again, plus
//      escaped double quotes (`\"`), because the whole go.sh-writing block is
//      itself the payload of release.sh's OWN double-quoted `ssh "${host}"
//      "..."` argument. release.sh's own shell resolves that escaping
//      locally, before ssh ever sees the bytes — what actually crosses the
//      wire already matches "direct" — and the heredoc it then lands in on
//      the remote/container side is `<<'SH'` (quoted), so nothing changes it
//      again — "dquote".
//   4. dist/release.sh's x86_64-windows path (#3342): a single-quoted,
//      top-level printf — not inside a heredoc or a double-quoted ssh
//      argument, so the same shape as #1 — "direct".
//   5. docker/toolchain.Dockerfile's RUN line: Dockerfile shell-form simply
//      forwards the joined line to `/bin/sh -c`, one layer, same as #1 —
//      "direct".
//
// Never a hand-copied duplicate of the program text, and never a hardcoded
// filename beside dist/release.sh either — that is exactly how #4277
// happened: #4132 moved site #1 out of release.sh into a new sibling file,
// and this gate kept reading only release.sh, so the moved site went
// silently unverified while the gate still reported PASS. Every run instead
// lists dist/'s OWN `.sh` files (`readDir`, not a name written here) and
// scans each one, plus reads docker/toolchain.Dockerfile from disk. Each site
// is located by an anchor that survives the exact mutation this gate exists
// to catch (no anchor ever contains "fn"/"function"), and each site's OWN
// escaping is reproduced by running the same shell construct (a real
// unquoted heredoc / a real double-quoted assignment) through a real
// /bin/sh rather than a hand-rolled unescaper. A future site moving to yet
// another sibling under dist/ is covered by construction, not by remembering
// to add its name here.
//
// Run from the repository root: bit-out/bin/bit run _tests_/bit/synthsmoke.bit
// `BIT_REPO` is required (see repoRoot below); `BIT_SELF_EXE` overrides which
// `bit` checks the extracted programs.

import { exists, mkdir, readDir, readFile, writeFile } from "std/fs"
import { env, envOr } from "std/os"
import { contains, hasSuffix, indexOf, parseInt } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// scripts/sites are the denominators this gate prints on every run (PASS or
// FAIL): how many dist/*.sh files were scanned and how many 'smoke ok' +
// 'toolchain ok' sites were found across all of them. #4277 was a scan that
// silently stopped covering a real site while still printing "PASS — N
// checks"; a denominator that shrinks is what makes that visible.
class Tally { checks: int, failures: int, scripts: int, sites: int }

// Set unconditionally by this gate's own `Gate{}` entry (tools/build/
// gates.bit) — same reason as _tests_/bit/shebangmode.bit's repoRoot: falling
// back to "." would silently point the file reads below at whatever
// directory `bit` happened to be invoked from instead of refusing.
fn repoRoot(): string {
  let r = env("BIT_REPO")
  if (len(r) == 0) {
    panic("synthsmoke: BIT_REPO is not set — run this through `./make test-synth-smoke`")
  }
  return r
}

fn bitBinary(): string {
  let explicit = env("BIT_SELF_EXE")
  if (len(explicit) > 0) {
    if (!exists(explicit)) {
      panic("synthsmoke: BIT_SELF_EXE=${explicit} does not exist")
    }
    return explicit
  }
  let candidate = "${repoRoot()}/bit-out/bin/bit"
  if (!exists(candidate)) {
    panic("synthsmoke: no compiler at ${candidate}; run this from the repository root or set BIT_SELF_EXE")
  }
  return candidate
}

fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "60")) catch _ {
    60
  }
  if (s <= 0) {
    return 60000
  }
  return s * 1000
}

// Runs `script` (its own first line must be a shebang) through the OS,
// bounded — same convention as _tests_/bit/rootnamecollision.bit's `shell`.
fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700: owner rwx only
    fail newError("synthsmoke: cannot make script executable: ${scriptPath}")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == 0 - 2) {
    panic("synthsmoke: TIMED OUT after ${ms}ms running ${scriptPath}")
  }
  if (code == 0 - 1) {
    panic("synthsmoke: could not spawn ${scriptPath}")
  }
  if (code <= 0 - 100) {
    panic("synthsmoke: ${scriptPath} died on signal ${0 - 100 - code}")
  }
  return code
}

fn check(t: Tally, cond: bool, label: string) {
  t.checks = t.checks + 1
  if (!cond) {
    t.failures = t.failures + 1
    eprint("FAIL: ${label}\n")
  }
}

fn containsStr(list: []string, s: string): bool {
  for x of list {
    if (x == s) {
      return true
    }
  }
  return false
}

// std/strings' trimSpace only strips ' '/'\t' — every use here is on the
// captured output of a shell command, which always ends in '\n', so this
// also strips '\n'/'\r'.
fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isWs(c: byte): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}

// Every byte offset in `text` where `sub` occurs, non-overlapping, in order.
fn findAllIndices(text: string, sub: string): []int {
  let out = []int(0)
  let pos = 0
  while (pos <= len(text)) {
    let at = indexOf(text[pos:], sub)
    if (at < 0) {
      break
    }
    out = append(out, pos + at)
    pos = pos + at + len(sub)
  }
  return out
}

// The single physical line of `text` containing byte offset `at`, and `at`'s
// own offset within that line.
class Line { text: string, at: int }

fn lineAt(text: string, at: int): Line {
  let lo = at
  while (lo > 0 && text[lo - 1] != '\n') {
    lo = lo - 1
  }
  let hi = at
  while (hi < len(text) && text[hi] != '\n') {
    hi = hi + 1
  }
  return Line{ text: text[lo:hi], at: at - lo }
}

// Counts the run of literal `\` bytes starting at `at`, and the byte
// immediately after that run (0 if the run reaches end of line).
class BackslashRun { count: int, after: byte }

fn backslashRunAt(line: string, at: int): BackslashRun {
  let i = at
  while (i < len(line) && line[i] == '\\') {
    i = i + 1
  }
  let after: byte = 0
  if (i < len(line)) {
    after = line[i]
  }
  return BackslashRun{ count: i - at, after: after }
}

fn describeByte(b: byte): string {
  if (b == 0) {
    return "<end-of-line>"
  }
  if (b == '"') {
    return "\""
  }
  if (b == '\\') {
    return "\\"
  }
  return "?"
}

// Which of the three known `smoke ok` escaping shapes `line` is (see the
// header), decided from the line's OWN escaping rather than which file or
// site it came from. Panics on anything unrecognised: a shape this gate
// cannot classify must fail loudly, never silently fall through to whichever
// case happens to be checked first.
fn classifySmokeSite(line: string, atInLine: int): string {
  let afterOk = atInLine + len("smoke ok")
  let run = backslashRunAt(line, afterOk)
  if (run.after != 'n') {
    panic("synthsmoke: 'smoke ok' is not followed by \\...n in: ${line}")
  }
  // Two bytes further out (past the backslash run and the 'n' itself) is
  // what actually distinguishes the three shapes:
  //   direct  — `\\n")`     2 backslashes, then '"' right after 'n'
  //   heredoc — `\\\\n")`   4 backslashes, then '"' right after 'n'
  //   dquote  — `\\\\n\")`  4 backslashes, then an escaped `\"` after 'n'
  // "direct"'s printf argument is single-quoted shell text: nothing strips a
  // backslash before printf itself does, so its OWN `\\n` (2 source
  // backslashes -> printf emits one literal backslash + 'n') is what
  // survives to the final .bit file — verified with `od -c` against a real
  // printf, not derived from the file's structure.
  let postN = afterOk + run.count + 1
  let afterN: byte = 0
  if (postN < len(line)) {
    afterN = line[postN]
  }
  if (run.count == 2 && afterN == '"') {
    return "direct"
  }
  if (run.count == 4 && afterN == '"') {
    return "heredoc"
  }
  if (run.count == 4 && afterN == '\\') {
    return "dquote"
  }
  panic("synthsmoke: unrecognised escaping shape at 'smoke ok' (backslashes=${run.count}, after-n=${describeByte(afterN)}) in: ${line}")
}

// Extracts the BODY of the line's `printf '<body>'` argument — the text
// strictly between the first `'` after `printf ` and the very next `'`.
// Valid because none of the four sites' format strings ever contain an
// embedded single quote (POSIX sh has no way to escape one inside '...' at
// all — if one ever appeared this would already be a different, broken shell
// statement) — verified against all four sites when this gate was written.
fn extractPrintfBody(line: string, path: string, site: string): string {
  let marker = "printf '"
  let pAt = indexOf(line, marker)
  if (pAt < 0) {
    panic("synthsmoke: ${site} line in ${path} has no `printf '...'` invocation: ${line}")
  }
  let rest = line[pAt + len(marker):]
  let closeAt = indexOf(rest, "'")
  if (closeAt < 0) {
    panic("synthsmoke: ${site} printf argument in ${path} has no closing quote: ${line}")
  }
  return rest[0:closeAt]
}

fn hasUnescapedDoubleQuote(s: string): bool {
  let i = 0
  while (i < len(s)) {
    if (s[i] == '"') {
      let j = i - 1
      let backslashes = 0
      while (j >= 0 && s[j] == '\\') {
        backslashes = backslashes + 1
        j = j - 1
      }
      if (backslashes % 2 == 0) {
        return true
      }
    }
    i = i + 1
  }
  return false
}

fn rawPrintfCommand(fmtBody: string, outFile: string): string {
  return "printf '" + fmtBody + "' > '" + outFile + "'"
}

// Layer A: `raw` is the literal BODY of an UNQUOTED `<<-` heredoc — writing
// it through a real heredoc collapses `\\` pairs the same way dist/
// release.sh's own `cat > "${work}/go.sh" <<-SH` does, without reimplementing
// that collapsing by hand.
fn resolveHeredoc(scratch: string, tag: string, raw: string, ms: int): string! {
  let outPath = "${scratch}/${tag}-resolved.txt"
  let script = "#!/bin/sh\ncat > '${outPath}' <<-DISTSMOKE_HD\n" + raw + "\nDISTSMOKE_HD\n"
  let code = shell("${scratch}/${tag}-heredoc.sh", script, ms)?
  if (code != 0) {
    fail newError("synthsmoke: heredoc-resolve for ${tag} exited ${code}")
  }
  return readFile(outPath)?
}

// Layer 0: `raw` is the literal payload of dist/release.sh's OWN
// double-quoted `ssh "${host}" "..."` argument — resolving it through a real
// double-quoted shell assignment reproduces `\"`->`"` and `\\`->`\` the same
// way, without reimplementing double-quote parsing by hand.
fn resolveDquote(scratch: string, tag: string, raw: string, ms: int): string! {
  if (hasUnescapedDoubleQuote(raw)) {
    fail newError("synthsmoke: ${tag} payload has a bare, un-escaped '\"' — refusing to wrap it in a synthetic double-quoted assignment: ${raw}")
  }
  let outPath = "${scratch}/${tag}-resolved.txt"
  let script = "#!/bin/sh\nX=\"" + raw + "\"\nprintf '%s' \"$X\" > '${outPath}'\n"
  let code = shell("${scratch}/${tag}-dquote.sh", script, ms)?
  if (code != 0) {
    fail newError("synthsmoke: dquote-resolve for ${tag} exited ${code}")
  }
  return readFile(outPath)?
}

// Layer B: executes the fully-resolved `printf '...' > 'outFile'` command,
// producing the extracted .bit file.
fn executeResolved(scratch: string, tag: string, command: string, ms: int): int! {
  let script = "#!/bin/sh\n" + trimWs(command) + "\n"
  return shell("${scratch}/${tag}-run.sh", script, ms)?
}

fn runBitCheck(bit: string, srcFile: string, scratch: string, tag: string, ms: int): int! {
  let outPath = "${scratch}/${tag}-checkout.txt"
  let codePath = "${scratch}/${tag}-checkcode.txt"
  let script = "#!/bin/sh\n'${bit}' check '${srcFile}' > '${outPath}' 2>&1\necho $? > '${codePath}'\n"
  let sh = shell("${scratch}/${tag}-check.sh", script, ms)?
  if (sh != 0) {
    fail newError("synthsmoke: check wrapper for ${tag} exited ${sh}")
  }
  if (!exists(codePath)) {
    fail newError("synthsmoke: no exit code recorded for `bit check` on ${tag}")
  }
  return parseInt(trimWs(readFile(codePath)?))?
}

// Extracts one site's program, materialises it, and `bit check`s it — the
// one property every site must have: the ACTUAL emitted text compiles.
// One 'smoke ok\' or 'toolchain ok\' site: the script it was found in, the
// tag its extracted program is materialised under, the raw line it was
// found on, and which escaping layer (direct/dquote/heredoc) it sits behind.
class SiteInfo {
  path: string,
  tag: string,
  line: string,
  layer: string,
}

fn checkSite(t: Tally, ctx: SmokeCtx, site: SiteInfo): ()! {
  let fmtBody = extractPrintfBody(site.line, site.path, site.tag)
  let outFile = "${ctx.scratch}/${site.tag}.bit"
  let raw = rawPrintfCommand(fmtBody, outFile)
  let resolved = raw
  if (site.layer == "heredoc") {
    resolved = trimWs(resolveHeredoc(ctx.scratch, site.tag, raw, ctx.ms)?)
  } else if (site.layer == "dquote") {
    resolved = trimWs(resolveDquote(ctx.scratch, site.tag, raw, ctx.ms)?)
  } else if (site.layer != "direct") {
    panic("synthsmoke: unknown layer '${site.layer}' for ${site.tag}")
  }
  let execCode = executeResolved(ctx.scratch, site.tag, resolved, ctx.ms)?
  check(
    t,
    execCode == 0,
    "${site.tag}: could not materialise the .bit file (exit ${execCode}): ${resolved}",
  )
  if (!exists(outFile)) {
    check(t, false, "${site.tag}: printf never produced ${outFile} from ${site.path}")
    return
  }
  let src = readFile(outFile)?
  check(t, contains(src, "main"), "${site.tag}: extracted program from ${site.path} has no 'main': ${src}")
  let checkCode = runBitCheck(ctx.bit, outFile, ctx.scratch, site.tag, ctx.ms)?
  check(
    t, checkCode == 0,
    "${site.tag}: `bit check` failed (exit ${checkCode}) on the program extracted from ${site.path} — see ${outFile}",
  )
}

// Every '.sh' file directly inside `dir`, sorted — DERIVED via a directory
// listing, never a hardcoded name. This is the fix for #4277: the previous
// version of this gate hardcoded "dist/release.sh" as the only file it
// scanned, so when #4132 moved a site into a new sibling, the sibling was
// simply never read. Listing the directory means dist/release-smoke.sh is
// covered the same way dist/release.sh always was, and any FUTURE sibling
// under dist/ is covered the same way without anyone remembering to name it
// here.
fn shellScriptNames(dir: string): []string {
  let names = readDir(dir) catch e {
    panic("synthsmoke: cannot list ${dir}: ${e.message()}")
  }
  let out = []string(0)
  for name of names {
    if (hasSuffix(name, ".sh")) {
      out = append(out, name)
    }
  }
  return out
}

// The pieces every checkSite call needs that stay constant across every
// site in a run — bundled so scanScriptSites stays at or under E0202's
// 5-parameter limit rather than adding a 6th scalar the way checkSite
// already does (pre-existing, not touched here).
class SmokeCtx { scratch: string, bit: string, ms: int }

// Finds every 'smoke ok\' site in `text` (the script named `name` at
// `path`), classifies each by its own escaping shape, checks that no two
// sites in the SAME script classify identically (that would mean the
// classifier cannot tell them apart), materialises and `bit check`s each
// one, and returns how many sites it found. The caller sums this across
// every scanned script and checks the TOTAL against the known site count —
// only the total can catch a site moving from one script to another, since
// a per-file count alone stays unchanged... on the file it moved TO.
//
// The anchor includes the literal backslash that starts every printf site's
// escape sequence — bare "smoke ok" also matches assertion/echo lines
// elsewhere in these scripts (`[ "${got}" = "smoke ok" ]` and friends),
// which are not printf sites at all.
fn scanScriptSites(t: Tally, ctx: SmokeCtx, path: string, name: string, text: string): int {
  let sites = findAllIndices(text, "smoke ok\\")
  let baseTag = trimSuffix(name, ".sh")
  let seen = []string(0)
  let j = 0
  while (j < len(sites)) {
    let ln = lineAt(text, sites[j])
    let layer = classifySmokeSite(ln.text, ln.at)
    check(
      t,
      !containsStr(seen, layer),
      "${name}: two sites classified as '${layer}' — classification is not distinguishing them",
    )
    seen = append(seen, layer)
    checkSite(t, ctx, SiteInfo{ path: path, tag: "${baseTag}-${layer}", line: ln.text, layer: layer }) catch e {
      panic("synthsmoke: ${e.message()}")
    }
    j = j + 1
  }
  return len(sites)
}

fn runAll(t: Tally, scratch: string, ms: int) {
  let ctx = SmokeCtx{ scratch: scratch, bit: bitBinary(), ms: ms }
  let distDir = "${repoRoot()}/dist"
  let scriptNames = shellScriptNames(distDir)
  let totalSmokeSites = 0
  let si = 0
  while (si < len(scriptNames)) {
    let name = scriptNames[si]
    let path = "${distDir}/${name}"
    let text = readFile(path) catch e {
      panic("synthsmoke: cannot read ${path}: ${e.message()}")
    }
    totalSmokeSites = totalSmokeSites + scanScriptSites(t, ctx, path, name, text)
    si = si + 1
  }
  if (totalSmokeSites != 4) {
    panic("synthsmoke: expected exactly 4 'smoke ok' sites across ${len(scriptNames)} dist/*.sh script(s), found ${totalSmokeSites} — a site was added, removed, or moved; update this gate")
  }
  t.scripts = len(scriptNames)

  let dockerPath = "${repoRoot()}/docker/toolchain.Dockerfile"
  let dockerText = readFile(dockerPath) catch e {
    panic("synthsmoke: cannot read ${dockerPath}: ${e.message()}")
  }
  let dockerSites = findAllIndices(dockerText, "toolchain ok\\")
  if (len(dockerSites) != 1) {
    panic("synthsmoke: expected exactly 1 'toolchain ok' site in ${dockerPath}, found ${len(dockerSites)} — update this gate")
  }
  let dockerLine = lineAt(dockerText, dockerSites[0])
  checkSite(t, ctx, SiteInfo{ path: dockerPath, tag: "docker-direct", line: dockerLine.text, layer: "direct" }) catch e {
    panic("synthsmoke: ${e.message()}")
  }
  t.sites = totalSmokeSites + len(dockerSites)
}

fn main() {
  let ms = timeoutMs()
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  let scratch = "${tmp}/bit-synthsmoke-${uuidFormat(uuidV4())}"
  let t = Tally{ checks: 0, failures: 0, scripts: 0, sites: 0 }

  mkdir(scratch) catch e {
    panic("synthsmoke: cannot create ${scratch}: ${e.message()}")
  }
  runAll(t, scratch, ms)

  // Anti-vacuity floor: 4 dist/*.sh sites x 4 checks each (distinctness,
  // materialise, 'main' present, `bit check`) plus the docker site's 3
  // (no distinctness check — it is the only "toolchain ok" site) = 19 today.
  // Floor is 17: losing the smallest-contributing site (docker, 3 checks)
  // drops the total to 16, below the floor; so does losing any dist/*.sh
  // site (4 checks, dropping to 15). The floor only has to be tight enough
  // that a whole site going unchecked trips it.
  if (t.checks < 17) {
    eprint("FAIL: only ${t.checks} checks ran, want at least 17\n")
    t.failures = t.failures + 1
  }
  if (t.failures > 0) {
    // `exit()` does not run pending defers (#3694, same shape as #3677) —
    // call teardown explicitly on both the PASS and FAIL paths.
    teardown(scratch, ms)
    println("synthsmoke: FAIL — ${t.failures} of ${t.checks} checks failed (${t.scripts} dist/*.sh script(s), ${t.sites} site(s) scanned)")
    osExit(1)
  }
  teardown(scratch, ms)
  println("synthsmoke: PASS — ${t.checks} checks (${t.scripts} dist/*.sh script(s), ${t.sites} site(s) scanned)")
}

// std/fs has no recursive remove, so the scratch tree goes the way it came.
fn teardown(scratch: string, ms: int) {
  shell("${scratch}/rm.sh", "#!/bin/sh\nrm -rf '${scratch}'\n", ms) catch _ {
    return
  }
}
