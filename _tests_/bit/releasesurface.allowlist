// _tests_/bit/releasesurface.bit's allowlist (#3039).
//
// One line per INTENTIONAL stdlib API break, so it survives as a reviewable
// record instead of a silently-typed conventional-commit `!`:
//
//     <module> <symbol> <removed|changed> <#ticket>
//
// <module>  the import path ("std/http"), not the filesystem path
// <symbol>  the bare name as _tests_/bit/releasesurface.bit's parser reports
//           it: "Exchange.request" for a field/method, "newSha256" for a
//           free function
// <ticket>  REQUIRED, must look like "#1234" — the change this file exists
//           to make reviewable, not merely permitted
//
// Comments start a line with "//"; blank lines are ignored.
//
// The four changes that shipped unannounced in 0.1.16 — the ones this gate
// exists to have caught — are documented in the harness's own header
// comment rather than listed here, so this file only ever names a break
// still pending the NEXT release.

// #4069 renamed std/time's Instant to Timestamp and made its ns field
// readonly, as the first child of the calendar epic #4062 — every later child
// touches this type, so it went first deliberately. Three breaks fall out of
// the one rename; they are declared here rather than allowlisted silently
// because this file is the record a release reads to decide its version bump.
std/time Instant removed #4069
std/time Instant.ns removed #4069
std/time now changed #4069
std/http2 Conn.serve changed #4616

// #4084 deleted std/time's superseded, UTC-only Civil calendar API — the
// last child of the calendar epic #4062 — now that Date/NaiveDateTime/
// DateTime/Timestamp/Zone cover it. No deprecation shim or alias survives.
std/time Civil removed #4084
std/time Civil.year removed #4084
std/time Civil.month removed #4084
std/time Civil.day removed #4084
std/time Civil.hour removed #4084
std/time Civil.minute removed #4084
std/time Civil.second removed #4084
std/time Civil.nanosecond removed #4084
std/time Civil.weekday removed #4084
std/time Civil.yearDay removed #4084
std/time civilFromUnix removed #4084
std/time unixFromCivil removed #4084
std/time formatUnix removed #4084
std/time formatRfc3339 removed #4084
std/time parseRfc3339 removed #4084
std/time utcOffset removed #4084
std/time addDays removed #4084
std/time addMonths removed #4084
std/time startOfDay removed #4084
std/sql Pool.begin removed #3979

// #5588 flattened std/time's ZoneData into Zone (zoneFromData is the single
// place a TZif parse's ZoneData is flattened into one) to cut a per-call
// Zone from 496 to 448 bytes and 11 to 9 heap objects, measured on 100,000
// parses of 2024-01-01T00:00:00Z (BIT_GC_STATS=1). No exported signature
// changed except this one field's removal.
std/time Zone.data removed #5588

// #5806 moved run() into std/process beside output(), the industry shape
// (Rust std::process, Node child_process, Python subprocess), now that the
// 0.25.0 stage0 repin carries the capture symbols that used to force output()
// into its own module apart from run(). No alias survives.
std/os run removed #5806

// #5913 retyped Server's module-private `listener` field from std/net's
// Listener to the module-private `acceptor` interface Listener satisfies, so a
// test can fake a failing accept. The field is unexported, so no caller
// outside std/http can read or set it (E0046); `bit doc --fields` reports it
// regardless (compiler/doc.bit).
std/http Server.listener changed #5913

// #7381 retyped RecordKeys's module-private `aead` field from `Aead` to the
// module-private `tlsRecordAead` interface, which adds sealInto/openInto. The
// field is unexported, so no caller outside std/tls can read or set it (E0046);
// `bit doc --fields` reports it regardless (compiler/doc.bit).
std/tls RecordKeys.aead changed #7381

// 0.32.0 intentional breaks. std/sql's Value gained Bool(bool) (#6154): a new
// variant changes the enum's signature, and every exhaustive match over Value
// now owes a Bool arm, so it is a real (MINOR) break.
std/sql Value changed #6154
// std/tls's TrustStore is gone: std/tls now takes std/crypto's TrustStore, the
// one class systemRoots() returns (#6155). Bit has no re-export, so a caller
// that imported TrustStore from "std/tls" imports it from "std/crypto" now.
std/tls TrustStore removed #6155
std/tls TrustStore.roots removed #6155
// std/websocket's Conn carries any transport (#6172). Both fields are
// unexported, so no caller outside std/websocket can read or set them;
// `bit doc --fields` reports them regardless.
std/websocket Conn.nc changed #6172
std/websocket Conn.useDeadline removed #6172
// std/http2 Conn.roundTrip and roundTripStream take an optional per-request
// deadline (`deadlineNs: int = 0`) so one shared h2 connection can carry many
// requests with different deadlines (#6465). Every existing call compiles
// unchanged; only a function value typed `(Request) => ...` would not.
std/http2 Conn.roundTrip changed #6465
std/http2 Conn.roundTripStream changed #6465
// Every exported newX in std/http, std/http2, std/http3 and std/smtp became a
// constructor called by the class name, with no alias kept (#6487): one
// `Client(tls = ...)` replaces newClient/newClientTls, one `ByteStream(conn = ...,
// tls = ...)` replaces newByteStream/newTlsByteStream, one `Encoder(...)` and
// one `Decoder(...)` replace each Config pair.
std/http newClient removed #6487
std/http newClientTls removed #6487
std/http newByteStream removed #6487
std/http newTlsByteStream removed #6487
std/http2 newDecoder removed #6487
std/http2 newDecoderConfig removed #6487
std/http2 newEncoder removed #6487
std/http2 newEncoderConfig removed #6487
std/http2 newRequest removed #6487
std/http2 newResponse removed #6487
std/http2 newTransport removed #6487
std/http3 newDecoder removed #6487
std/http3 newDecoderConfig removed #6487
std/http3 newEncoder removed #6487
std/http3 newEncoderConfig removed #6487
std/smtp newAttachment removed #6487
std/smtp newMessage removed #6487
std/smtp newOptions removed #6487

// #6484 replaced every std/crypto `newX` factory with a constructor called by the
// class name (`Sha256()`, `Aes(key)`, `Blake3(Blake3Mode.Keyed(key))`), and renamed
// `AesCipher` to `Aes` so the constructor is `Aes(key)`. No alias survives; the
// `changed` lines are the functions and fields whose parameter type is that class.
std/crypto AesCipher removed #6484
std/crypto AesCipher.decryptBlock removed #6484
std/crypto AesCipher.encryptBlock removed #6484
std/crypto AesCipher.encryptBlockInto removed #6484
std/crypto AesCipher.hw removed #6484
std/crypto AesCipher.nr removed #6484
std/crypto AesCipher.roundKeys removed #6484
std/crypto AesGcm.cipher changed #6484
std/crypto AesGcmSiv.master changed #6484
std/crypto cbcDecrypt changed #6484
std/crypto cbcEncrypt changed #6484
std/crypto ctr changed #6484
std/crypto ecbEncryptBlock changed #6484
std/crypto newAes removed #6484
std/crypto newAesGcmSiv removed #6484
std/crypto newBlake2b removed #6484
std/crypto newBlake2s removed #6484
std/crypto newBlake3 removed #6484
std/crypto newBlake3DeriveKey removed #6484
std/crypto newBlake3Keyed removed #6484
std/crypto newChaChaPoly removed #6484
std/crypto newGcm removed #6484
std/crypto newMd5 removed #6484
std/crypto newSha1 removed #6484
std/crypto newSha224 removed #6484
std/crypto newSha256 removed #6484
std/crypto newSha384 removed #6484
std/crypto newSha3_224 removed #6484
std/crypto newSha3_256 removed #6484
std/crypto newSha3_384 removed #6484
std/crypto newSha3_512 removed #6484
std/crypto newSha512 removed #6484
std/crypto newSha512_256 removed #6484
std/crypto newShake128 removed #6484
std/crypto newShake256 removed #6484
std/crypto newXChaChaPoly removed #6484

// Every exported newX in std/tls and std/quic became a constructor called by the
// class name, with no alias kept (#6485): `TlsConfig(roots, ...)`,
// `TlsServerConfig(certChainPem, keyPem, alpn)`, `RecordKeys(suite, secret)`,
// `TranscriptHash(newHash)`, `TlsTicketStore()`, `SessionTicket(nst, conn)` and
// `CryptoAssembler(maxLen)`. newTrustStore is gone because std/crypto's
// `fromPem(pem)` already builds the same TrustStore (the class lives in std/crypto
// since #6155).
std/quic newCryptoAssembler removed #6485
std/tls newRecordKeys removed #6485
std/tls newSessionTicket removed #6485
std/tls newTicketStore removed #6485
std/tls newTlsConfig removed #6485
std/tls newTlsServerConfig removed #6485
std/tls newTranscript removed #6485
std/tls newTrustStore removed #6485

// Every exported newX in std/sync, std/time, std/strings, std/rand, std/metrics
// and std/sql became a constructor called by the class name, with no alias kept
// (#6486): `Mutex()`, `RWMutex()`, `Once()`, `WaitGroup()`, `AtomicI64(v)`,
// `AtomicU64(v)`, `Pool<T>(open, closeFn, healthy, opts)`, `Timer(d)`,
// `Ticker(d)`, `Builder()`, `Rand(seed)`, `Registry(capMax)` in std/metrics and
// `Registry()` in std/sql.
std/metrics newRegistry removed #6486
std/rand newRand removed #6486
std/sql newRegistry removed #6486
std/strings newBuilder removed #6486
std/sync newAtomicI64 removed #6486
std/sync newAtomicU64 removed #6486
std/sync newMutex removed #6486
std/sync newOnce removed #6486
std/sync newPool removed #6486
std/sync newRWMutex removed #6486
std/sync newWaitGroup removed #6486
std/time newTicker removed #6486
std/time newTimer removed #6486

// A hash is named by a `HashAlg` value, never a hasher-factory lambda (#6493):
// `hmac(HashAlg.Sha256, key, msg)`, and std/tls and std/quic take the suite's
// `HashAlg` through the key schedule. `tlsSuiteNewHash(suite)` became
// `tlsSuiteHash(suite): HashAlg`. No alias keeps the old signatures.
std/crypto ecdsaSign changed #6493
std/crypto hkdf changed #6493
std/crypto hkdfExpand changed #6493
std/crypto hkdfExtract changed #6493
std/crypto hmac changed #6493
std/crypto pbkdf2 changed #6493
std/crypto rsaDecryptOaep changed #6493
std/crypto rsaEncryptOaep changed #6493
std/crypto rsaSignPkcs1v15 changed #6493
std/crypto rsaSignPss changed #6493
std/crypto rsaVerifyPkcs1v15 changed #6493
std/crypto rsaVerifyPss changed #6493
std/quic levelKeyPair changed #6493
std/quic levelKeys changed #6493
std/quic updateSecret changed #6493
std/tls binderKey changed #6493
std/tls clientApplicationTrafficSecret changed #6493
std/tls clientEarlyTrafficSecret changed #6493
std/tls clientHandshakeTrafficSecret changed #6493
std/tls deriveSecret changed #6493
std/tls earlyExporterMasterSecret changed #6493
std/tls earlySecret changed #6493
std/tls exporterMasterSecret changed #6493
std/tls finishedKey changed #6493
std/tls finishedMac changed #6493
std/tls handshakeSecret changed #6493
std/tls hkdfExpandLabel changed #6493
std/tls masterSecret changed #6493
std/tls resumptionMasterSecret changed #6493
std/tls resumptionPsk changed #6493
std/tls serverApplicationTrafficSecret changed #6493
std/tls serverHandshakeTrafficSecret changed #6493
std/tls tlsSuiteNewHash removed #6493
std/tls trafficIV changed #6493
std/tls trafficKey changed #6493

// TlsConfig is the client side only (#6534): a server is configured with
// `TlsServerConfig(certChainPem, keyPem, alpn)`, which `listen` now takes in
// place of a TlsConfig carrying certPem/keyPem. minVersion went with them: TLS 1.3
// is the only version implemented, so the floor had nothing to select.
std/tls TlsConfig.certPem removed #6534
std/tls TlsConfig.keyPem removed #6534
std/tls TlsConfig.minVersion removed #6534
std/tls listen changed #6534

// #6488 replaced std/trace's `newX` factories with constructors and static
// methods: `Sampler(ratio)`, `Tracer(endpoint, scopeName, ratio)`,
// `TraceId.random()` and `SpanId.random()`. No alias survives.
std/trace newSampler removed #6488
std/trace newSpanId removed #6488
std/trace newTraceId removed #6488
std/trace newTracer removed #6488

// #6594 adds NameTooLong and BadEncoding to XmlErrorKind: names past the
// limit and bytes that are not well-formed UTF-8 or not Char now fail with
// their own kind. An exhaustive match over XmlErrorKind needs the two arms.
std/xml XmlErrorKind changed #6594

// #6857 made every fallible std/smtp call fail with the typed SmtpError
// instead of the untyped error, so a retrying caller can read the reply code
// and transient(). The nine signatures below changed from `!` to `!SmtpError`.
std/smtp Client.authLogin changed #6857
std/smtp Client.authPlain changed #6857
std/smtp Client.ehlo changed #6857
std/smtp Client.quit changed #6857
std/smtp Client.send changed #6857
std/smtp Client.startTls changed #6857
std/smtp Message.render changed #6857
std/smtp dial changed #6857
std/smtp dialTls changed #6857
std/jwt sign changed #6947
std/http requestWithStreamingBody changed #6575
std/smtp Client.authPlain removed #6874
std/smtp Client.authLogin removed #6874

// #6866 made Client.send return the Delivery that says which recipients were
// accepted and which were refused, instead of (): a partly refused recipient
// list now still delivers to the accepted ones.
std/smtp Client.send changed #6866

// #7427 made exec return an ExecResult (rowsAffected, lastInsertId) instead of
// the bare affected-row count, so a MySQL INSERT hands back the id its OK
// packet carried without a second statement.
std/sql Pool.exec changed #7427
std/sql Session.exec changed #7427

// #7441 made the At pair take a TxOptions (isolation level and readOnly)
// instead of a bare Isolation, so a read-only transaction is one typed option
// on the existing entry points, not a second method.
std/sql Pool.txAt changed #7441
std/sql Pool.txValueAt changed #7441
std/sql txAt changed #7441
std/sql txValueAt changed #7441

// #7378 made Client.request take its body as a typed Body (Text or Bytes) with
// an optional timeoutMs, so a []byte upload is sent without a copy through the
// one method.
std/http Client.request changed #7378
std/sql Pool.adapter removed #6024
std/sql Pool.closed removed #6024
std/sql Pool.dead removed #6024
std/sql Pool.idle removed #6024
std/sql Pool.mu removed #6024
std/sql Pool.numOpen removed #6024
std/sql Pool.seq removed #6024
std/sql Pool.waiters removed #6024
std/sync Pool.checkedOut removed #6024
