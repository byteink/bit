// _tests_/bit/abimembers/directemission.bit — #3984: `tools/build/abiarity.bit`'s
// hand-written `directEmissionSymbols()` list, checked against the compiler
// scan `abimembers.bit`/`scanners.bit` already run.
//
// Sibling of `abimembers.bit` and `scanners.bit` in the same directory module:
// no `import` between them, one shared scope — split out because adding this
// section in place took `scanners.bit` from 600 to 870 lines, over the
// 800-line ceiling (spec/LINT.md:186, E0200).
//
// `directEmissionSymbols()` is a HAND-WRITTEN list of the names each backend
// passes as a literal argument to `emitCallReloc`/`xCallReloc`/`emitCall`/
// `xEmitCallLike` rather than through `Op.RtCall`'s generic `rtSymbol(tag)`
// path. Nothing checked it before this — a 13th hardcoded call symbol added
// to a backend would silently go unlisted, and #3936 narrowed the runtime-ABI-
// arity guard to exactly this set, so an unlisted symbol makes THAT guard
// blind too (#3152's failure shape).
//
// DERIVATION. `comp.names` (`abimembers.bit`'s `main`, from `collectCompiler`)
// is every whole `"bit_rt_*"` string literal `scanCompilerFile` finds anywhere
// in compiler/*.bit (minus *check.bit fixtures) — a SUPERSET of the direct
// emission set, because it also catches: (a) every name reachable through the
// RtFn table's generic path (`rtSymbol`'s two literal special cases,
// `bit_rt_set_err`/`bit_rt_get_err`, plus any RtFn tag whose name happens to
// also appear literally in a fixture assertion outside a `*check.bit`-suffixed
// file, e.g. `bit_rt_string_from_int` in `arm64selcheckgen.bit`), and (b)
// `bit_rt_port_gc_thread_token`, which has a `*Symbol()` helper in
// `compiler/codegen.bit` but is never actually passed to `emitCallReloc` —
// both backends INLINE its body instead (`tools/build/abiarity.bit`'s own
// header). Subtracting every RtFn-table-derived name removes (a) in full,
// including the coincidental fixture hit; subtracting the documented
// non-call-site helpers below removes (b). What is left is exactly the direct
// emission set — verified equal to the 12-name hand list before this check was
// written (re-derive with the file's own header comment rather than trusting
// this one).
//
// `directEmissionSymbols()` also packs several entries per line (unlike
// `rtFnTags`'s one-per-line style, verified live: `bit fmt --check` on
// `tools/build/abiarity.bit` is a clean rc=0 with the packed layout) — hence
// `parseFlatTableLine`, generalising `scanners.bit`'s `scanFlatStringTable`
// (moved here alongside it) to one-or-more comma-separated entries per line.

// `hasPrefix` comes from `scanners.bit`'s own `import { hasPrefix, ... } from
// "std/strings"` — an import is per MODULE, not per file, in a directory
// module with no `import` between siblings, and re-importing the same name
// here is `E0042 already declared in this scope`.

// Parses ONE `"<ident>",` token starting at `body[i]` — `i` is always `< n`
// (the only caller, `parseFlatTableLine`'s loop, holds that as its while
// condition), so this does not re-check it. `next` is the index just past the
// token's comma (and one optional trailing space); `ok` false on any
// malformed shape — an interpolation, a name with a suffix, or a missing
// comma. Split out of `parseFlatTableLine` to keep both under the
// complexity-10 ceiling (spec/LINT.md:186, E0204).
fn parseOneTableItem(body: string, i: int): (string, int, bool) {
  let n = len(body)
  if (body[i] != '"') {
    return "", i, false
  }
  let start = i + 1
  let end = identEnd(body, start)
  if (end == start || end >= n || body[end] != '"') {
    return "", i, false
  }
  let after = end + 1
  if (after >= n || body[after] != ',') {
    return "", i, false
  }
  let next = after + 1
  if (next < n && body[next] == ' ') {
    next = next + 1
  }
  return body[start:end], next, true
}

// Parses `body` (already trimmed, non-empty, not `[`/`]`/a whole-line comment)
// as one or more `"<ident>", ` tokens covering the WHOLE line, back to back.
// `ok` is false on ANY malformed content — one bad item among otherwise-good
// ones spoils the line too — mirroring the file's existing whole-line-bad
// granularity (`malformedTableFixture`'s entries in `scanners.bit`), so a
// partially-bad line keeps nothing rather than silently keeping the good half.
fn parseFlatTableLine(body: string): ([]string, bool) {
  let names = []string(0)
  let n = len(body)
  let i = 0
  while (i < n) {
    let (name, next, ok) = parseOneTableItem(body, i)
    if (!ok) {
      return []string(0), false
    }
    names = append(names, name)
    i = next
  }
  if (len(names) == 0) {
    return []string(0), false
  }
  return names, true
}

// Whether `body` (the trimmed content of a line already known to be `inside`
// the table block) is nothing to act on — blank, a whole-line comment, or the
// `return [` opener.
fn flatTableLineIsSkippable(body: string): bool {
  return len(body) == 0 || hasPrefix(body, "//") || body == rtFnOpen
}

// Parses `t`/`body` (a line already known not to be skippable or the closing
// `]`) as one flat-table entry and records it into `out`. Split out of
// `scanFlatStringTable` to keep both under the complexity-10 ceiling
// (spec/LINT.md:186, E0204).
fn scanFlatTableEntryLine(out: TagScan, t: string, body: string) {
  if (!hasPrefix(t, "    ")) {
    out.bad = out.bad + 1
    return
  }
  let (names, ok) = parseFlatTableLine(body)
  if (!ok) {
    out.bad = out.bad + 1
    return
  }
  for name of names {
    out.tags = append(out.tags, name)
  }
}

// Every entry of a flat `fn <name>(): []string { return [ "a", "b", ... ] }`
// table whose signature matches `headerNew`/`headerOld` — generalised out of a
// single `rtFnTags`-only scanner (#3984) so `compiler/irrtfns.bit`'s
// `rtFnTags` (`scanners.bit`'s `scanRtFnTags`) and `directEmissionSymbols`
// here can reuse the same parsing rather than two hand-rolled ones. A line
// inside the block that `parseFlatTableLine` cannot parse in full is counted
// `bad`: the table's shape is the whole oracle here, and silently skipping a
// line it does not recognise is how a demand set shrinks without anyone
// noticing.
//
// Anchoring on the FUNCTION SIGNATURE and not on `return [` matters: the latter
// is a shape any list-returning helper added to that file later would also have,
// and the scanner would then read whichever came first as the roster.
fn scanFlatStringTable(source: string, headerNew: string, headerOld: string): TagScan {
  let out = TagScan{ tags: []string(0), bad: 0 }
  let inside = false
  for line of lineCount(source) {
    let t = trimRight(line)
    if (!inside) {
      inside = hasPrefix(t, headerNew) || hasPrefix(t, headerOld)
      continue
    }
    let body = trimLeft(t)
    if (flatTableLineIsSkippable(body)) {
      continue
    }
    if (body == rtFnClose) {
      return out
    }
    scanFlatTableEntryLine(out, t, body)
  }
  // Falling out of the loop means the closing `]` was never reached.
  out.bad = out.bad + 1
  return out
}

fn directEmissionKnownNonCallSite(): []string {
  // `bit_rt_port_gc_thread_token`: `compiler/codegen.bit`'s `gcThreadTokenSymbol`
  // helper exists, but `arm64call.bit`'s `emitCall` intercepts that name and
  // calls `emitInlinedThreadToken` instead of ever reaching `emitCallReloc`
  // (#3420/#3434). `bit_rt_safepoint_needed`: the helper that once returned it
  // is gone with its last caller (#2925 arm64, #3169 x64) and today the name
  // is not a literal anywhere this scan can see; kept here so a future
  // reintroduction of either helper's literal does not surface as a spurious
  // diff before someone re-reads why it was excluded.
  return ["bit_rt_port_gc_thread_token", "bit_rt_safepoint_needed"]
}

// `compNames` minus every name the RtFn table already demands (`rtSymbol(t)`
// for every tag `t`) minus the known non-call-site helpers above. Distinct.
fn deriveDirectEmissionSet(compNames: []string, tableTags: []string): []string {
  let covered = map<string, bool>{}
  for t of tableTags {
    covered[rtSymbol(t)] = true
  }
  for n of directEmissionKnownNonCallSite() {
    covered[n] = true
  }
  let seen = map<string, bool>{}
  let out = []string(0)
  for n of compNames {
    if (covered[n] || seen[n]) {
      continue
    }
    seen[n] = true
    out = append(out, n)
  }
  return out
}

// The names present in exactly one of `derived`/`hand`, bidirectionally.
// `extraDerived`: a real call site (found by the scan) with no matching hand
// entry — a hole in the ABI-arity guard's coverage (#3152's shape).
// `staleHand`: a hand entry with no matching call site the scan can see — the
// check is no longer anchored to anything the compiler still emits. A one-way
// check rots into a permanent excuse, so both are surfaced.
//
// Returns the names rather than reporting them, same reason `missingFromTable`
// (`scanners.bit`) does: its own unit test should not have to print a failure
// that is not one.
class DirectEmissionDiff {
  extraDerived: []string,
  staleHand: []string,
}

fn diffDirectEmission(derived: []string, hand: []string): DirectEmissionDiff {
  let inHand = map<string, bool>{}
  for h of hand {
    inHand[h] = true
  }
  let inDerived = map<string, bool>{}
  for d of derived {
    inDerived[d] = true
  }
  let extraDerived = []string(0)
  for d of derived {
    if (!inHand[d]) {
      extraDerived = append(extraDerived, d)
    }
  }
  let staleHand = []string(0)
  for h of hand {
    if (!inDerived[h]) {
      staleHand = append(staleHand, h)
    }
  }
  return DirectEmissionDiff{ extraDerived: extraDerived, staleHand: staleHand }
}

fn checkDirectEmissionList(derived: []string, hand: []string): int {
  let diff = diffDirectEmission(derived, hand)
  for d of diff.extraDerived {
    eprint(
        "abimembers: compiler/*.bit passes `${d}` as a direct emission literal " +
        "(not via the RtFn table), but tools/build/abiarity.bit's " +
        "directEmissionSymbols() does not list it. Add it there, or the runtime " +
        "ABI arity guard (#3936) cannot see this symbol (#3152's failure shape).\n",
    )
  }
  for h of diff.staleHand {
    eprint(
        "abimembers: tools/build/abiarity.bit's directEmissionSymbols() lists " +
        "`${h}`, but no compiler source this scan can see still emits it as a " +
        "direct call literal. Remove the stale entry, or teach this check about " +
        "the new shape.\n",
    )
  }
  return len(diff.extraDerived) + len(diff.staleHand)
}

// ==== This file's own unit tests ====

// Proves the header pair is a real parameter of `scanFlatStringTable`, not
// `rtFnTags` hardcoded under a new name — the SAME source parses differently
// depending on which pair is passed, and the WRONG pair must find nothing
// (never a short roster silently read as complete under the wrong anchor).
fn checkFlatStringTableGeneric(): int {
  let source = "fn otherTable(): []string {\n  return [\n    \"one\",\n    \"two\",\n  ]\n}\n"
  let hit = scanFlatStringTable(
    source, "fn otherTable(): []string {", "function otherTable(): []string {",
  )
  let bad = 0
  if (hit.bad != 0) {
    eprint("scanner: scanFlatStringTable(otherTable header) reported ${hit.bad} bad line(s)\n")
    bad = bad + 1
  }
  bad = bad + expectSet(hit.tags, ["one", "two"], "scanFlatStringTable with a non-rtFnTags header")
  let miss = scanFlatStringTable(source, rtFnHeaderNew, rtFnHeaderOld)
  if (len(miss.tags) != 0 || miss.bad == 0) {
    eprint("scanner: scanFlatStringTable must not match a table under the wrong header\n")
    bad = bad + 1
  }
  return bad
}

// `directEmissionSymbols()` packs several entries per line (unlike `rtFnTags`'s
// one-per-line style) — `parseFlatTableLine`'s reason for existing. Both the
// clean packed shape and a packed line with one bad item spoiling its
// otherwise-good neighbours.
fn checkFlatTableLinePacking(): int {
  let headerNew = "fn otherTable(): []string {"
  let headerOld = "function otherTable(): []string {"
  let clean = "fn otherTable(): []string {\n" +
    "  return [\n" +
    "    \"bit_rt_a\", \"bit_rt_b\", \"bit_rt_c\",\n" +
    "    \"bit_rt_d\",\n" +
    "  ]\n" +
    "}\n"
  let s = scanFlatStringTable(clean, headerNew, headerOld)
  let bad = 0
  if (s.bad != 0) {
    eprint("scanner: the packed table fixture reported ${s.bad} unrecognised line(s)\n")
    bad = bad + 1
  }
  bad = bad +
    expectSet(
      s.tags, ["bit_rt_a", "bit_rt_b", "bit_rt_c", "bit_rt_d"], "scanFlatStringTable on a packed line",
    )

  // One malformed item (an interior space, the same trap `"interp_${x}"`
  // guards against for the single-per-line case) must spoil the WHOLE packed
  // line -- `bit_rt_a`/`bit_rt_c` beside it must not be kept.
  let dirty = "fn otherTable(): []string {\n" +
    "  return [\n" +
    "    \"bit_rt_a\", \"bit_rt_b bad\", \"bit_rt_c\",\n" +
    "    \"bit_rt_d\",\n" +
    "  ]\n" +
    "}\n"
  let d = scanFlatStringTable(dirty, headerNew, headerOld)
  if (d.bad != 1) {
    eprint("scanner: the dirty packed line reported ${d.bad} bad line(s), wanted 1\n")
    bad = bad + 1
  }
  bad = bad +
    expectSet(d.tags, ["bit_rt_d"], "scanFlatStringTable on a packed line with one bad item")
  return bad
}

// deriveDirectEmissionSet drops RtFn-table-covered and known non-call-site
// names, collapses duplicates, and keeps everything else; diffDirectEmission
// reports a difference in EITHER direction. Exercises diffDirectEmission
// directly, not checkDirectEmissionList, so a deliberately mismatched fixture
// does not eprint a "finding" that is not one (same reason
// `scanners.bit`'s checkTableCoversUnit tests missingFromTable rather than
// checkTableCovers).
fn checkDirectEmissionUnit(): int {
  let bad = 0
  let compNames = [
    "bit_rt_gc_alloc", "bit_rt_gc_alloc", // real direct emission, duplicated across files
    "bit_rt_set_err",                     // RtFn-table-covered (err_set) -- must be dropped
    "bit_rt_port_gc_thread_token",        // known non-call-site helper -- must be dropped
    "bit_rt_new_hardcoded",               // an unlisted 13th direct emission
  ]
  let derived = deriveDirectEmissionSet(compNames, ["err_set"])
  bad = bad +
    expectSet(derived, ["bit_rt_gc_alloc", "bit_rt_new_hardcoded"], "deriveDirectEmissionSet")

  let same = diffDirectEmission(["bit_rt_gc_alloc"], ["bit_rt_gc_alloc"])
  if (len(same.extraDerived) != 0 || len(same.staleHand) != 0) {
    eprint("scanner: diffDirectEmission flagged an identical derived/hand pair\n")
    bad = bad + 1
  }
  // A derived-only name -- an unlisted real call site -- is a hard failure.
  let extra = diffDirectEmission(["bit_rt_gc_alloc", "bit_rt_new_hardcoded"], ["bit_rt_gc_alloc"])
  bad = bad +
    expectSet(extra.extraDerived, ["bit_rt_new_hardcoded"], "diffDirectEmission extraDerived")
  if (len(extra.staleHand) != 0) {
    eprint("scanner: diffDirectEmission found a stale hand entry that is not one\n")
    bad = bad + 1
  }
  // A hand-only name -- a stale entry -- is a hard failure too, the other
  // direction, proving the check is not one-way.
  let stale = diffDirectEmission(["bit_rt_gc_alloc"], ["bit_rt_gc_alloc", "bit_rt_stale"])
  bad = bad + expectSet(stale.staleHand, ["bit_rt_stale"], "diffDirectEmission staleHand")
  if (len(stale.extraDerived) != 0) {
    eprint("scanner: diffDirectEmission found an extra derived name that is not one\n")
    bad = bad + 1
  }
  return bad
}

// Aggregates this file's own unit tests, called from `scanners.bit`'s
// `checkScanners` alongside the other three scanners' own checks.
fn checkDirectEmissionScanners(): int {
  return checkFlatStringTableGeneric() + checkFlatTableLinePacking() + checkDirectEmissionUnit()
}
