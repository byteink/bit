// _tests_/bit/bookinklive.bit — `./make test-book-ink-live` (#6356). The live
// half of docs/book/ink's tests: `./make test-book-ink` (bookinkgate.bit)
// runs `bit test docs/book/ink` with no database, so dbstore.test.bit's
// SqlStore-against-PostgreSQL test skips there and the Book's database code
// was never exercised by any gate. This harness provisions its OWN throwaway
// PostgreSQL (the shape ormlive.bit and webguidesapp.bit established): `docker
// run --rm -d`, `pg_isready`-polled, the URL handed to a `bit test
// docs/book/ink` child as INK_TEST_LIVE_PG_URI, then the container always
// removed.
//
// A skip inside THIS gate is a failure: the child's stdout is scanned for
// "  skipped: " and the gate fails on one, on top of the child's exit code.
//
// IMAGE: postgres:18.6 pinned BY DIGEST, the same pin as ormlive.bit,
// webguidesapp.bit and jobslive.bit (re-verify before bumping: curl -s
// https://hub.docker.com/v2/repositories/library/postgres/tags/18.6 | jq
// .digest). The image is kept, never deleted; only the container is
// throwaway.
//
// WITHOUT DOCKER: no `docker` binary, or `docker info` failing three times —
// FAILS, naming the probe error and its duration (_tests_/bit/dockerlive/
// dockerlive.bit, #6353); only `BIT_LIVE_OPTIONAL=1` skips and exits 0.
//
// CLEANUP: the container is named with a run-local UUID and labelled
// `bit.bookink.live=1` plus its owner pid; `cleanup()` removes it on every
// path this process controls and `sweepOrphans` (dockerlive.bit) runs FIRST,
// removing a labelled container whose owner process is gone.
//
// ENV (`./make test-book-ink-live` sets both, tools/build/gatestable3.bit):
//   BIT_REPO  repo root, so docs/book/ink resolves regardless of cwd (required)
//   BIT_BIN   compiler under test (default BIT_REPO/bit-out/bin/bit)
//
// `bit test` inherits no argv, so the child gets INK_TEST_LIVE_PG_URI through
// `/usr/bin/env VAR=... <bit> test <dir>`, the vehicle ormlive.bit documents.

import { output } from "std/process"
import { env, envOr, exit } from "std/os"
import { contains } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"
import { sleep, Millisecond } from "std/time"
import {
  dockerQuickTimeoutMs, dockerRunTimeoutMs, dockerRun, hostPort, ownerLabelKey, relay,
  requireDocker, selfPid, sweepOrphans,
  releaseDocker,
} from "./dockerlive"

const pgImage: string = "postgres@sha256:5a5a84b19854a9ffaa54082c166ff4ec27473a361e496e5ea167f298f2da9722"
const runLabel: string = "bit.bookink.live=1"
const readyAttempts: int = 60
const readyDelayMs: int = 1000
const testRunTimeoutMs: int = 300000

// BIT_REPO IS REQUIRED, same reason as bookinkgate.bit: falling back to "."
// would silently test whatever directory `bit` happened to be invoked from.
fn repoRoot(): string {
  let r = env("BIT_REPO")
  if (len(r) == 0) {
    panic("bookinklive: BIT_REPO is not set — run this through `./make test-book-ink-live`")
  }
  return r
}

fn waitReady(bin: string, name: string): ()! {
  let i = 0
  while (i < readyAttempts) {
    let r = output(bin, ["exec", name, "pg_isready", "-U", "postgres"], dockerQuickTimeoutMs)
    if (r.exitCode == 0 && contains(r.stdout, "accepting connections")) {
      return
    }
    sleep(readyDelayMs * Millisecond)
    i = i + 1
  }
  fail newError("${name}: pg_isready never reported ready within ${readyAttempts * readyDelayMs}ms")
}

fn startPostgres(bin: string, name: string, ownerLabel: string): int! {
  dockerRun(
    bin,
    [
      "run", "--rm", "-d", "--name", name, "--label", runLabel, "--label", ownerLabel,
      "-p", "127.0.0.1:0:5432", "-e", "POSTGRES_HOST_AUTH_METHOD=trust", pgImage,
    ],
  )?
  let port = hostPort(bin, name, "5432/tcp")?
  waitReady(bin, name)?
  return port
}

// `rm -f` covers a still-running container as well as a stopped one; called
// from every path through `main()`.
fn cleanup(bin: string, name: string) {
  output(bin, ["rm", "-f", name], dockerRunTimeoutMs)
  releaseDocker(bin)
}

// Runs `bit test docs/book/ink` with INK_TEST_LIVE_PG_URI set for exactly the
// child this spawns. A skip line in its stdout fails the gate even at exit 0.
fn runLiveTests(bitPath: string, repo: string, pgUrl: string): int {
  let r = output(
    "/usr/bin/env",
    [
      "INK_TEST_LIVE_PG_URI=${pgUrl}", "BIT_REPO=${repo}", "BIT_BIN=${bitPath}",
      bitPath, "test", "${repo}/docs/book/ink",
    ],
    testRunTimeoutMs,
  )
  let rc = relay(r, "bookinklive", testRunTimeoutMs)
  if (rc == 0 && contains(r.stdout, "  skipped: ")) {
    eprint("bookinklive: a test skipped inside test-book-ink-live — INK_TEST_LIVE_PG_URI was set, so the live test is not reading it\n")
    return 1
  }
  return rc
}

fn main() {
  let bin = requireDocker("bookinklive")
  sweepOrphans(bin, runLabel)

  let repo = repoRoot()
  let bitPath = envOr("BIT_BIN", "${repo}/bit-out/bin/bit")
  let name = "bit-bookink-live-pg-${uuidFormat(uuidV4())}"

  let pid = selfPid() catch e {
    eprint("bookinklive: ${e.message()}\n")
    exit(1)
    return
  }
  let port = startPostgres(bin, name, "${ownerLabelKey}=${pid}") catch e {
    eprint("bookinklive: ${e.message()}\n")
    cleanup(bin, name)
    exit(1)
    return
  }

  let rc = runLiveTests(bitPath, repo, "postgres://postgres@127.0.0.1:${port}/postgres")
  cleanup(bin, name)
  exit(rc)
}
