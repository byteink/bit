// _tests_/bit/dcemethods.bit — #6114: with `BIT_DCE_METHODS` (default ON
// since the 0.32.0 repin, #6191) a class's method table keeps only the slots
// some lowered site dispatches to (compiler/lowermethodtable.bit's
// `dispatchedTables`), so the linker can drop a method nothing reaches.
// `BIT_DCE_METHODS=0` still reproduces the old, every-slot table.
//
// NOT placed in _tests_/cases/: that corpus is compiled by the pinned stage0
// with a fixed environment, and the stage0 oracle still defaults this off, so
// a golden there could neither set the flag nor be compared against an
// oracle that emits every slot. Drives the CLI directly;
// BIT_BIN/BIT_STDLIB/BIT_LIBBITRT, no oracle involved.
//
// The fixture reaches a method through every path a table can serve: an
// interface call, a generic bound call, a bound method value, an interface
// method value, `show()` in interpolation, `v.(I)` narrowing then a call,
// `defer` on an interface method, `e.message()` in a `catch`, the
// uncaught-error line (`error: ...`, exit 1), `@json`'s `toJson` and
// `__jsonAppend` and `jsonDecode<T>`, and `@job`'s static `__jobName` through
// a `T: Job` bound (`T.__jobName()`). It is built flag-off
// (`BIT_DCE_METHODS=0`) and
// flag-on (default); both must print `wantOut` and exit 1. The flag-on
// binary must lack `dcemethodsUnreached` and the flag-off one must carry it,
// so the pruning is proven taken, and proven to drop exactly the method
// nothing dispatches to.
//
// WIRED INTO `./make test` as `test-dcemethods` (tools/build/gates.bit,
// tools/build/defs.bit).

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"
import { contains } from "std/strings"

const gateTimeoutMs: int = 120000

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("dcemethods: ${name} is not set — refusing to guess.\n")
    exit(2)
  }
  return v
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

fn fixtureSrc(): string {
  return fixtureIfaces() + fixtureClasses() + fixtureFns() + fixtureMain()
}

// The interfaces every dispatch path goes through.
fn fixtureIfaces(): string {
  return "import { Json, JsonEntry, jsonParse, jsonEncode, jsonDecode } from \"std/json\"\n" +
    "\n" +
    "interface Shape {\n" +
    "  area(): i64,\n" +
    "  show(): string,\n" +
    "}\n" +
    "\n" +
    "interface Closer {\n" +
    "  close(),\n" +
    "}\n" +
    "\n" +
    "interface Job {\n" +
    "  static __jobName(): string,\n" +
    "}\n" +
    "\n" +
    "interface Jsonable {\n" +
    "  toJson(): Json,\n" +
    "}\n" +
    "\n" +
    "interface HasArea {\n" +
    "  area(): i64,\n" +
    "}\n" +
    "\n" +
    "interface Appender {\n" +
    "  toJson(): Json,\n" +
    "  __jsonAppend(out: []byte): []byte,\n" +
    "}\n" +
    "\n"
}

// The classes that implement them, plus the @job and @json classes.
fn fixtureClasses(): string {
  return "class Sq {\n" +
    "  side: i64\n" +
    "\n" +
    "  area(): i64 {\n" +
    "    return this.side * this.side\n" +
    "  }\n" +
    "  show(): string {\n" +
    "    return \"Sq(\${this.side})\"\n" +
    "  }\n" +
    "  // Reached by nothing: its slot is the one BIT_DCE_METHODS=1 drops.\n" +
    "  dcemethodsUnreached(): i64 {\n" +
    "    return 99\n" +
    "  }\n" +
    "}\n" +
    "\n" +
    "class Rect {\n" +
    "  w: i64\n" +
    "  h: i64\n" +
    "\n" +
    "  area(): i64 {\n" +
    "    return this.w * this.h\n" +
    "  }\n" +
    "  show(): string {\n" +
    "    return \"Rect(\${this.w}x\${this.h})\"\n" +
    "  }\n" +
    "}\n" +
    "\n" +
    "class Log {\n" +
    "  name: string\n" +
    "\n" +
    "  close() {\n" +
    "    print(\"closed \${this.name}\\n\")\n" +
    "  }\n" +
    "}\n" +
    "\n" +
    "class Only {\n" +
    "  n: i64\n" +
    "\n" +
    "  // Reached only as a method VALUE, never by a direct call or a dispatch.\n" +
    "  bump(k: i64): i64 {\n" +
    "    return this.n + k\n" +
    "  }\n" +
    "}\n" +
    "\n" +
    "class Oops {\n" +
    "  code: i64\n" +
    "\n" +
    "  // Reached only through `catch e { e.message() }` and the uncaught-error line.\n" +
    "  message(): string {\n" +
    "    return \"oops \${this.code}\"\n" +
    "  }\n" +
    "}\n" +
    "\n" +
    "@job(\"send-welcome\") @json class SendWelcome {\n" +
    "  userId: i64,\n" +
    "}\n" +
    "\n" +
    "@json class Point {\n" +
    "  x: i64,\n" +
    "  y: i64,\n" +
    "}\n" +
    "\n"
}

// The generic, value and error helpers that reach methods indirectly.
fn fixtureFns(): string {
  return "fn total<T: Shape>(xs: []T): i64 {\n" +
    "  let t = 0\n" +
    "  for x of xs {\n" +
    "    t = t + x.area()\n" +
    "  }\n" +
    "  return t\n" +
    "}\n" +
    "\n" +
    "fn jobName<T: Job>(): string {\n" +
    "  return T.__jobName()\n" +
    "}\n" +
    "\n" +
    "fn apply(f: (i64) => i64, k: i64): i64 {\n" +
    "  return f(k)\n" +
    "}\n" +
    "\n" +
    "fn call0(f: () => i64): i64 {\n" +
    "  return f()\n" +
    "}\n" +
    "\n" +
    "fn deferred(c: Closer) {\n" +
    "  defer c.close()\n" +
    "  print(\"deferred body\\n\")\n" +
    "}\n" +
    "\n" +
    "fn fails(code: i64): ()! {\n" +
    "  fail Oops{ code = code }\n" +
    "}\n" +
    "\n" +
    "fn encodeFast(v: Jsonable): string {\n" +
    "  let (w, ok) = v.(Appender)\n" +
    "  if (!ok) {\n" +
    "    return \"no appender \" + jsonEncode(v.toJson())\n" +
    "  }\n" +
    "  return string(w.__jsonAppend([]byte(0, 16)))\n" +
    "}\n" +
    "\n"
}

// `main`, which prints one line per dispatch path.
fn fixtureMain(): string {
  return "fn main(): ()! {\n" +
    "  let shapes = []Shape(0)\n" +
    "  shapes = append(shapes, Sq{ side = 3 })\n" +
    "  shapes = append(shapes, Rect{ w = 2, h = 5 })\n" +
    "  let sum = 0\n" +
    "  for s of shapes {\n" +
    "    sum = sum + s.area()\n" +
    "  }\n" +
    "  print(\"iface area sum=\${sum}\\n\")\n" +
    "  print(\"interp \${shapes[0]} \${shapes[1]}\\n\")\n" +
    "  print(\"generic bound total=\${total([Sq{ side = 2 }, Sq{ side = 4 }])}\\n\")\n" +
    "  let o = Only{ n = 40 }\n" +
    "  print(\"method value=\${apply(o.bump, 2)}\\n\")\n" +
    "  let areaOf = shapes[1].area\n" +
    "  print(\"iface method value=\${call0(areaOf)}\\n\")\n" +
    "  let a: HasArea = Sq{ side = 5 }\n" +
    "  let (sh, ok) = a.(Shape)\n" +
    "  print(\"narrowed ok=\${ok} area=\${sh.area()}\\n\")\n" +
    "  deferred(Log{ name = \"log1\" })\n" +
    "  fails(7) catch e {\n" +
    "    print(\"caught \${e.message()}\\n\")\n" +
    "  }\n" +
    "  let job = SendWelcome{ userId = 12 }\n" +
    "  print(\"job name=\${jobName<SendWelcome>()} json=\${jsonEncode(job.toJson())}\\n\")\n" +
    "  let p = Point{ x = 1, y = -2 }\n" +
    "  print(\"append=\${encodeFast(p)}\\n\")\n" +
    "  let back = jsonDecode<Point>(jsonParse(\"{\\\"x\\\":8,\\\"y\\\":9}\")?)?\n" +
    "  print(\"decoded x=\${back.x} y=\${back.y}\\n\")\n" +
    "  fails(42)?\n" +
    "}\n"
}

const wantOut: string = "iface area sum=19\n" +
  "interp Sq(3) Rect(2x5)\n" +
  "generic bound total=20\n" +
  "method value=42\n" +
  "iface method value=10\n" +
  "narrowed ok=true area=25\n" +
  "deferred body\n" +
  "closed log1\n" +
  "caught oops 7\n" +
  "job name=send-welcome json={\"userId\":12}\n" +
  "append={\"x\":1,\"y\":-2}\n" +
  "decoded x=8 y=9\n" +
  "error: oops 42\n"

class CompilerEnv {
  bin: string,
  stdlib: string,
  libbitrt: string,
}

// Writes `body` as an executable `/bin/sh` script at `path` and runs it,
// bounded. Returns the script's exit code, or 2 when it cannot be written.
fn runScript(path: string, body: string): int {
  writeFile(path, "#!/bin/sh\n" + body) catch e {
    eprint("dcemethods: cannot write ${path}: ${e.message()}\n")
    return 2
  }
  if (fsChmod(path, 448) != 0) { // 0o700
    eprint("dcemethods: cannot chmod ${path}\n")
    return 2
  }
  return osRunBounded(path, gateTimeoutMs)
}

fn teardown(scratch: string) {
  let _ = runScript(scratch + "/rm.sh", "rm -rf " + shQuote(scratch) + "\n")
}

fn die(scratch: string, msg: string) {
  eprint("dcemethods: FAIL — ${msg}\n")
  teardown(scratch)
  exit(1)
}

// Builds `src` to `out` with `BIT_DCE_METHODS` set to `flag` ("1" is the
// default; "0" is the escape hatch).
fn build(cc: CompilerEnv, scratch: string, src: string, out: string, flag: string) {
  let script = "BIT_STDLIB=" +
    shQuote(cc.stdlib) +
    "\nexport BIT_STDLIB\n" +
    "BIT_LIBBITRT=" +
    shQuote(cc.libbitrt) +
    "\nexport BIT_LIBBITRT\n" +
    "BIT_DCE_METHODS=" +
    flag +
    "\nexport BIT_DCE_METHODS\n" +
    "exec " +
    shQuote(cc.bin) +
    " build " +
    shQuote(src) +
    " -o " +
    shQuote(out) +
    " > /dev/null 2> " +
    shQuote(scratch + "/build.err") +
    "\n"
  if (runScript(scratch + "/build.sh", script) != 0) {
    let err = readFile(scratch + "/build.err") catch _ {
      ""
    }
    die(scratch, "fixture failed to build with BIT_DCE_METHODS='${flag}':\n${err}")
  }
}

// Runs `bin` and dies unless it exits 1 (the fixture's last, uncaught
// failure) having printed exactly `wantOut`.
fn check(scratch: string, bin: string, label: string) {
  let outPath = scratch + "/run.out"
  let code = runScript(
    scratch + "/run.sh",
    "exec " + shQuote(bin) + " > " + shQuote(outPath) + " 2>&1\n",
  )
  let out = readFile(outPath) catch _ {
    ""
  }
  if (code != 1 || out != wantOut) {
    die(scratch, "${label} ran wrong: exit=${code} (want 1)\n  want: ${wantOut}\n  got:  ${out}")
  }
}

// Whether the built binary's symbol table names `sym`.
fn names(scratch: string, bin: string, sym: string): bool {
  let bytes = readFile(bin) catch e {
    die(scratch, "cannot read ${bin}: ${e.message()}")
    return false
  }
  return contains(bytes, sym)
}

fn main() {
  let cc = CompilerEnv{
    bin = requiredEnv("BIT_BIN"),
    stdlib = requiredEnv("BIT_STDLIB"),
    libbitrt = requiredEnv("BIT_LIBBITRT"),
  }
  let scratch = envOr("TMPDIR", "/tmp") + "/bit-dcemethods-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("dcemethods: cannot create scratch directory ${scratch}: ${e.message()}\n")
    exit(2)
  }
  let src = scratch + "/fixture.bit"
  writeFile(src, fixtureSrc()) catch e {
    die(scratch, "cannot write ${src}: ${e.message()}")
  }
  let off = scratch + "/fixture_off"
  let on = scratch + "/fixture_on"
  build(cc, scratch, src, off, "0")
  build(cc, scratch, src, on, "1")
  check(scratch, off, "BIT_DCE_METHODS=0")
  check(scratch, on, "BIT_DCE_METHODS=1")
  if (!names(scratch, off, "dcemethodsUnreached")) {
    die(
      scratch,
      "the flag-off binary lacks dcemethodsUnreached, so it cannot show what the flag drops",
    )
  }
  if (names(scratch, on, "dcemethodsUnreached")) {
    die(
      scratch,
      "BIT_DCE_METHODS=1 kept dcemethodsUnreached, so the undispatched slot was not dropped",
    )
  }
  teardown(scratch)
  print("PASS dcemethods: every dispatch path prints the same result with BIT_DCE_METHODS=1 as without it, and only the method nothing dispatches to is dropped\n")
}
