// `./make test-coldboot` (#2416): no other gate builds from a clean tree.
//
// Every OTHER gate in this repo runs against an ALREADY-BUILT `bit-out/`, so a
// change that makes the FIRST build impossible — stage0 cannot compile
// `tools/build/`, or `tools/build/` cannot link against a symbol the pinned
// runtime archive does not have — passes every one of them. That is not
// hypothetical: #2152 added an extern to `stdlib/fs/fs.bit`, consumed by
// `tools/build/artifacts.bit`'s `import { walk } from "std/fs"`, built clean
// under the author's WARM `bit-out`, and died on
//
//     $ rm -rf bit-out && ./make
//     error[E0078]: 'extern fn' bit_rt_fs_is_symlink_w is defined
//       neither in the runtime archive nor by libSystem, ...
//
// once an integrator actually cleared `bit-out` first. Reverted at 49e74817.
//
// THIS is the one gate that does not get to assume a working compiler. It
// deletes `bit-out/` entirely and re-bootstraps exactly as a fresh clone or
// `dist/release.sh` would — through the pinned stage0, never
// `BIT_STAGE0_BIN` (#1857's two-pass escape hatch; using it here would defeat
// the point, since "stage0 cannot build this" is exactly the failure being
// caught) — then asserts `./make` (the default step, `install`) exits 0.
//
// NOT part of the default `./make test`: `tools/build/defs.bit` registers
// this Step in `coreSteps()`, not `gateSteps()`, so `gateNames()` — the list
// `test` depends on — never names it. A cold bootstrap is the most expensive
// operation in the repo; run it explicitly before a release, before merging
// to main, or after a stage0 repin, not on every working-tree edit.
import { env, envOr, exit } from "std/os"
import { exists, mkdir, readFile, writeFile } from "std/fs"
import { parseInt } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// Generous: this rebuilds the compiler AND the runtime archive from the
// pinned stage0 and may fetch it over the network first. `BIT_TEST_TIMEOUT_S`
// is the same override every other harness honours, so a slower host widens
// this alongside them. `s <= 0` does not mean "block forever" here — a hang
// during a rebuild-from-scratch is exactly the failure this gate exists to
// tell apart from a genuine build error (#1637).
fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "1800")) catch _ {
    1800
  }
  if (s <= 0) {
    return 1800000
  }
  return s * 1000
}

// BIT_REPO is set unconditionally by this gate's own `Gate{}` entry
// (tools/build/gates.bit) — falling back to "." on a miss would silently
// rebuild whatever directory `bit` happened to be invoked from instead of
// refusing, which is the same "quiet default" defect class the whole harness
// exists to avoid (see the header of _tests_/bit/version.bit for the sibling
// case).
fn repoRoot(): string {
  let r = env("BIT_REPO")
  if (len(r) == 0) {
    panic("coldboot: BIT_REPO is not set — run this through `./make test-coldboot`")
  }
  return r
}

// Runs `script` through /bin/sh and returns its exit code. Negative returns
// are `osRunBounded`'s own mechanism channel, never a program's exit status
// (ABI.md §19), so each is a named panic rather than a value any assertion
// could mistake for the thing under test.
fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700: owner rwx only
    fail newError("coldboot: cannot make script executable: ${scriptPath}")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == -2) {
    panic("coldboot: TIMED OUT after ${ms}ms rebuilding from a clean tree — a hang is a failure, not a stall")
  }
  if (code == -1) {
    panic("coldboot: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("coldboot: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}

// Builds and runs the wrapper: `cd` into `root`, `rm -rf bit-out`, then
// `./make`, with the wrapper's own exit code distinct from `./make`'s (which
// is recorded separately to `codePath`, read back by readMakeExitCode). The
// wrapper always exits 0 on its own account, except for the two setup
// failures named 90/91. `rm -rf bit-out` deletes the very binary this
// process is running from; that is safe on POSIX (the inode stays valid
// until this process exits) and is the whole point — the freshly rebuilt
// `bit-out` that `./make` produces afterward is what gets left behind.
fn runCleanBuildWrapper(root: string, scratch: string, outPath: string, codePath: string, ms: int) {
  let script = "#!/bin/sh\n" +
    "cd '${root}' || exit 90\n" +
    "rm -rf bit-out || exit 91\n" +
    "./make > '${outPath}' 2>&1\n" +
    "echo $? > '${codePath}'\n" +
    "exit 0\n"
  let wrapperRc = shell("${scratch}/coldboot.sh", script, ms) catch e {
    panic("coldboot: ${e.message()}")
  }
  if (wrapperRc == 90) {
    panic("coldboot: cannot cd into ${root}")
  }
  if (wrapperRc == 91) {
    panic("coldboot: cannot remove ${root}/bit-out")
  }
  if (wrapperRc != 0) {
    panic("coldboot: wrapper script exited ${wrapperRc}, which it never should")
  }
}

// Reads back `./make`'s own exit code, recorded by runCleanBuildWrapper.
fn readMakeExitCode(codePath: string): int {
  if (!exists(codePath)) {
    panic("coldboot: no exit code was recorded for the clean-tree `./make` — it never ran")
  }
  let codeText = trimWs(
    readFile(codePath) catch e {
      panic("coldboot: cannot read ${codePath}: ${e.message()}")
      ""
    },
  )
  return parseInt(codeText) catch _ {
    panic("coldboot: ${codePath} did not contain a number: '${codeText}'")
    0 - 1
  }
}

fn main() {
  let ms = timeoutMs()
  let root = repoRoot()
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  let scratch = "${tmp}/bit-coldboot-${uuidFormat(uuidV4())}"
  mkdir(scratch) catch e {
    panic("coldboot: cannot create ${scratch}: ${e.message()}")
  }

  let outPath = "${scratch}/out.txt"
  let codePath = "${scratch}/code.txt"

  runCleanBuildWrapper(root, scratch, outPath, codePath, ms)
  let code = readMakeExitCode(codePath)
  let out = readFile(outPath) catch ""

  if (code != 0) {
    eprint(out)
    // `exit()` does not run pending defers (#3694, same shape as #3677) —
    // call teardown explicitly on both the PASS and FAIL paths.
    teardown(scratch, ms)
    println("coldboot: FAIL — `rm -rf bit-out && ./make` exited ${code}, want 0")
    exit(1)
  }
  teardown(scratch, ms)
  println("coldboot: PASS — a clean tree bootstraps from the pinned stage0")
}

// std/fs has no recursive remove, so the scratch tree goes the way it came —
// same reason _tests_/bit/runcmd.bit's teardown does.
fn teardown(scratch: string, ms: int) {
  shell("${scratch}/rm.sh", "#!/bin/sh\nrm -rf '${scratch}'\n", ms) catch _ {
    return
  }
}

fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}
