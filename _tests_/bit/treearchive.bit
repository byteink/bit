// _tests_/bit/treearchive.bit — `./make test-tree-archive` (#7751). Runs a
// program linked against a libbitrt.a built by THE TREE's own compiler.
//
// WHY. Every gate's libbitrt.a is built by stage0 (stepLibbitrt,
// tools/build/artifactsteps.bit), so the tree's own code generation reaches
// runtime/** only in dist/release.sh's L1 step. #7750: an emitAsm scratch
// register clobber made every aarch64-linux program built by the tree die with
// SIGBUS at startup, and the full push gate was green because no gate ever ran
// a tree-built runtime.
//
// WHAT. Three steps, each of which fails the gate by name:
//   1. `scripts/g2archive.sh aarch64-linux <scratch>/l1.a` with BIT=BIT_BIN,
//      the tree compiler, so the archive is the tree's own output.
//   2. `bit build hello.bit --target aarch64-linux` with BIT_LIBBITRT pointing
//      at that archive.
//   3. The binary runs in `bit-linux-gate:latest` (a NATIVE aarch64 Linux image
//      on this Mac, no emulation). rc must be 0 and stdout must be `smoke ok`.
// The failure line names the archive, the program, the image and the rc, and the
// scratch directory is KEPT on failure so the binary can be re-run by hand.
//
// WITHOUT DOCKER the gate FAILS (dockerlive.bit, #6353), it never skips; the
// registry marks it darwinOnly so a Linux host (x64gate.sh, arm64gate.sh),
// which has no daemon and cannot run the program anyway, reads SKIP.
//
// CONTROL. Point BIT_BIN at the stage0 compiler (bit-out/stage0/<bit-x.y.z>/
// bin/bit) and the same gate passes: it then builds the archive with stage0,
// which is what every other gate links against.
//
// X86_64-LINUX (#7752). `./make test-tree-archive-x64` is the same three steps for
// x86_64-linux, run in bit-linux-gate-amd64:latest on the real x86 host that
// scripts/x64host.sh resolves (BIT_X64_HOST and friends; BIT_LIVE_DOCKER_HOST
// forces the ssh alias). The run is dockerlive.bit's remote mode: the host's
// /tmp/benchlock directory lock is held for the run, the program's directory
// is staged by tar, and the program's stdout and rc come back through
// `dockerOutput`. The lock, the staged copy and the container are removed on
// every exit path, so the host is left clean. NO HOST ANSWERING FAILS the gate,
// like no Docker does; BIT_LIVE_OPTIONAL=1 is the one explicit skip.
//
// ENV (`./make test-tree-archive[-x64]` sets all four, tools/build/gatestable3.bit):
//   BIT_REPO    repo root (required)
//   BIT_BIN     the compiler under test (default BIT_REPO/bit-out/bin/bit)
//   BIT_STDLIB  stdlib to link hello.bit against
//   BIT_TREEARCHIVE_TARGET  aarch64-linux | x86_64-linux
import { output } from "std/process"
import { env, envOr, exit } from "std/os"
import { mkdir, writeFile } from "std/fs"
import { contains, trimSpace } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"
import {
  dockerOutput,
  dockerRunTimeoutMs,
  failureText,
  giveUp,
  releaseDocker,
  remoteHostEnv,
  requireDocker,
  useRemoteHost,
} from "./dockerlive"

const x64Target: string = "x86_64-linux"
const hostTimeoutMs: int = 60000
const wantLine: string = "smoke ok"
const archiveTimeoutMs: int = 300000
const buildTimeoutMs: int = 120000
const hello: string = "fn main() {\n  print(\"smoke ok\\n\")\n}\n"

// One run: the compiler and stdlib under test, the target and its image, and
// the scratch directory holding l1.a, hello.bit and run/hello. `run/` holds only
// the program because a remote run stages the whole mount.
class Job { bin: string, stdlib: string, target: string, image: string, scratch: string }

fn archiveOf(j: Job): string {
  return "${j.scratch}/l1.a"
}

fn runDirOf(j: Job): string {
  return "${j.scratch}/run"
}

// The docker binary (or remote shim) in use, so every exit path can release a
// remote run's lock, staged copy and containers. "" before it exists.
let dockerBin: string = ""

fn requiredEnv(name: string): string {
  let v = env(name)
  if (len(v) == 0) {
    eprint("treearchive: ${name} is not set — run this through `./make test-tree-archive` or `test-tree-archive-x64`\n")
    exit(2)
  }
  return v
}

fn imageFor(target: string): string {
  if (target == x64Target) {
    return "bit-linux-gate-amd64:latest"
  }
  return "bit-linux-gate:latest"
}

// Prints the failure, keeps `scratch` for a hand re-run, releases a remote run
// and exits 1.
fn fail1(scratch: string, msg: string) {
  eprint("treearchive: FAIL: ${msg}\n  scratch kept for a hand re-run: ${scratch}\n")
  releaseDocker(dockerBin)
  exit(1)
}

fn removeScratch(scratch: string) {
  if (len(scratch) < 2 || !contains(scratch, "bit-treearchive-")) {
    eprint("treearchive: refusing to remove unexpected scratch path \"${scratch}\"\n")
    exit(2)
  }
  let r = output("/bin/rm", ["-rf", scratch], 30000)
  if (r.exitCode != 0) {
    eprint("treearchive: cannot remove ${scratch}: ${failureText(r, 30000)}\n")
    exit(2)
  }
}

fn buildArchive(repo: string, j: Job): string {
  let archive = archiveOf(j)
  let r = output(
    "/usr/bin/env",
    ["BIT=${j.bin}", "/bin/bash", "${repo}/scripts/g2archive.sh", j.target, archive],
    archiveTimeoutMs,
  )
  if (r.exitCode == 0) {
    return ""
  }
  return "scripts/g2archive.sh ${j.target} with ${j.bin} exited ${r.exitCode} building ${archive}: ${failureText(
    r,
    archiveTimeoutMs,
  )}"
}

fn linkProgram(j: Job): string {
  let archive = archiveOf(j)
  let src = "${j.scratch}/hello.bit"
  let r = output(
    "/usr/bin/env",
    [
      "BIT_STDLIB=${j.stdlib}",
      "BIT_LIBBITRT=${archive}",
      j.bin,
      "build",
      src,
      "--target",
      j.target,
      "-o",
      "${runDirOf(j)}/hello",
    ],
    buildTimeoutMs,
  )
  if (r.exitCode == 0) {
    return ""
  }
  return "${j.bin} build ${src} --target ${j.target} against ${archive} exited ${r.exitCode}: ${failureText(
    r,
    buildTimeoutMs,
  )}"
}

// "" when the program printed the line and exited 0 inside the image, else why not.
fn runInImage(docker: string, j: Job): string {
  let archive = archiveOf(j)
  let r = dockerOutput(
    docker,
    ["run", "--rm", "-v", "${runDirOf(j)}:/w", j.image, "/w/hello"],
    dockerRunTimeoutMs,
  ) catch e {
    return "docker run of hello (linked against ${archive}) in ${j.image} did not start: ${e.message()}"
  }
  if (r.exitCode == 0 && trimSpace(r.stdout) == wantLine) {
    return ""
  }
  return "program ${runDirOf(j)}/hello linked against the tree-built archive ${archive} exited rc=${r.exitCode} in ${j.image} (want rc=0 and \"${wantLine}\"); stdout=\"${trimSpace(r.stdout)}\" stderr=\"${failureText(
    r,
    dockerRunTimeoutMs,
  )}\""
}

// The docker to run on: the local daemon for aarch64-linux; for x86_64-linux
// the ssh host scripts/x64host.sh resolves (BIT_LIVE_DOCKER_HOST wins), run
// through dockerlive.bit's remote mode. Exits 1 (0 under BIT_LIVE_OPTIONAL=1)
// when no host answers.
fn dockerFor(repo: string, target: string): string {
  if (target == x64Target && env(remoteHostEnv) == "") {
    let r = output("/bin/bash", ["${repo}/scripts/x64host.sh"], hostTimeoutMs)
    let host = trimSpace(r.stdout)
    if (r.exitCode != 0 || host == "") {
      giveUp(
        "treearchive",
        "scripts/x64host.sh found no x86-64 host: ${failureText(r, hostTimeoutMs)}",
        0,
      )
    }
    useRemoteHost(host) catch e {
      giveUp("treearchive", "scripts/x64host.sh printed an unusable host: ${e.message()}", 0)
    }
  }
  return requireDocker("treearchive")
}

fn main() {
  let repo = requiredEnv("BIT_REPO")
  let target = requiredEnv("BIT_TREEARCHIVE_TARGET")
  if (target != x64Target && target != "aarch64-linux") {
    eprint("treearchive: BIT_TREEARCHIVE_TARGET=${target} is not aarch64-linux or ${x64Target}\n")
    exit(2)
  }
  let docker = dockerFor(repo, target)
  dockerBin = docker
  let scratch = envOr("TMPDIR", "/tmp") + "/bit-treearchive-${uuidFormat(uuidV4())}"
  let j = Job{
    bin = envOr("BIT_BIN", "${repo}/bit-out/bin/bit"),
    stdlib = requiredEnv("BIT_STDLIB"),
    target = target,
    image = imageFor(target),
    scratch = scratch,
  }
  mkdir(scratch) catch e {
    eprint("treearchive: cannot create scratch directory ${scratch}: ${e.message()}\n")
    releaseDocker(docker)
    exit(2)
  }
  mkdir(runDirOf(j)) catch e {
    fail1(scratch, "cannot create ${runDirOf(j)}: ${e.message()}")
  }
  writeFile("${scratch}/hello.bit", hello) catch e {
    fail1(scratch, "cannot write ${scratch}/hello.bit: ${e.message()}")
  }

  let why = buildArchive(repo, j)
  if (why == "") {
    why = linkProgram(j)
  }
  if (why == "") {
    why = runInImage(docker, j)
    releaseDocker(docker)
  }
  if (why != "") {
    fail1(scratch, why)
  }
  removeScratch(scratch)
  print("treearchive: ok — ${target} hello linked against the tree-built archive printed \"${wantLine}\", rc=0, in ${j.image}\n")
}
