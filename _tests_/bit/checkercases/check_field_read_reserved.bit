// error
// SPEC §14.3, #7110: `__field` is the by-name field read the compiler
// synthesizes for a program whose interface requires it; a hand-written method
// of that name is E0311, since it would satisfy the requirement by name alone.
import { Json } from "std/json"

interface Readable {
  __field(name: string): Option<Json>,
}

class User {
  export id: string
  __field(name: string): Option<Json> {
    return Option<Json>.None
  }
}

fn main() {
  let r: Readable = User{ id = "u1" }
  print(r.__field("id"))
}
