// error
// #5170: JSXNamespacedName (SPEC §12.12) allows exactly ONE ':' -
// `jsx_name = ... [ ":" ... ]`, not `{ ":" ... }`. `parseJsxName`
// (parserjsx.bit) merges only the first glued colon+name and leaves a
// second one unconsumed, so a doubled namespace like `a:b:c` is rejected the
// same way an unmerged trailing hyphen or colon already is: the stray `:`
// fails the attribute list's own `>` expectation rather than silently
// chaining a second namespace.
fn elem(tag: string, ...kids: string): string {
  return tag
}
fn attr(name: string, value: string): string {
  return name
}
fn text(s: string): string {
  return s
}
fn main() {
  let x = <div a:b:c />
}
