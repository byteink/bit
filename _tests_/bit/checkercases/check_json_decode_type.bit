// error
// SPEC §10.5, #3977: `jsonDecode<T>` where `T` is not a class carrying `@json`
// is a COMPILE error naming the type and the mark, never a runtime failure.
//
// It has to be refused here, by name: the `jsonDecode<T>` template's own body
// type-checks against an unbound `T`, so a call the compiler declined to
// specialise would COMPILE and then fail at run time -- the one outcome this
// feature must not have. Four ways to be wrong, one diagnostic each.
import { Json, jsonDecode } from "std/json"

class Plain {
  v: i64,
}

enum Colour {
  Red,
  Blue,
}

fn main() {
  let j = Json.JsonNull
  let a = jsonDecode<Plain>(j) catch _ {
    return
  }
  let b = jsonDecode<Colour>(j) catch _ {
    return
  }
  let c = jsonDecode<i64>(j) catch _ {
    return
  }
  let d = jsonDecode(j) catch _ {
    return
  }
  print("${a.v}${b == Colour.Red}${c}${d}\n")
}
