// error
// #2678: `since` takes a `Mono` (a monotonic reading, from `monotonic()`), not
// a `Timestamp` (a wall-clock reading, from `now()`) — the two are nominal
// records precisely so a wall-clock reading cannot be handed to `since` and
// silently produce a nonsense elapsed time against a clock that can jump.
import { now, since } from "std/time"

fn main() {
  since(now())
}
