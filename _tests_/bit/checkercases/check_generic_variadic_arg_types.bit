// #4597: a GENERIC variadic call's arguments are judged like any other call's —
// the variadic slot against the ELEMENT type this call inferred, the fixed
// prefix against its own declared type. #4548 checked the non-generic shape and
// bailed on the generic one to avoid a spurious E0068 for the EMPTY variadic
// slot, so on main `each("a", 1)` checked clean and `tally(7, 1, 2)` — an int
// in a `label: string` prefix — segfaulted at rc=0.
//
// The last rejection is the carve-out's own boundary: a type parameter a FIXED
// parameter also mentions is still E0068 when nothing binds it, because an
// argument DID reach a slot that binds it. Only a gap that solely the empty
// rest slot could have filled is silence.
//
// main()'s calls are the false-positive controls: an empty variadic slot both
// with and without a fixed prefix, explicit type arguments, a second type
// parameter left unbound by an empty slot, individual arguments, and a spread.
// The .expected match is exact, so a fifth diagnostic fails this case.
enum MyOpt<E> {
  Nothing,
  Just(E),
}

fn each<T>(...xs: T): int {
  return len(xs)
}

fn tally<T>(label: string, ...xs: T): int {
  return len(label) + len(xs)
}

fn pairs<T>(first: T, ...rest: T): int {
  return 1 + len(rest)
}

fn kv<K, V>(k: K, ...vs: V): int {
  return len(vs)
}

fn gapped<T>(q: MyOpt<T>, ...xs: int): int {
  return len(xs)
}

fn main() {
  print("${each("a", 1)}\n")
  print("${tally(7, 1, 2)}\n")
  print("${pairs(1, "a")}\n")
  print("${gapped(MyOpt.Nothing)}\n")
  let ys = [1, 2, 3]
  print("${each()}${tally("b")}${each<int>()}${kv("a")}\n")
  print("${each(1, 2, 3)}${tally("x", 1, 2)}${pairs(1, 2)}${each(...ys)}\n")
}
