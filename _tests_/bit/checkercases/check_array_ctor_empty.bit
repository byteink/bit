// error
// #4092: `[N]T(...)` is not a legal construction form at all (§12.3) — an
// array is built only by the literal `[N]T{...}` or left zero-valued by
// `let a: [N]T`. Nothing rejected the call form at the checker, so
// `[4]i64()` reached `lowerCall`, which has no `Tag.ArrayType` arm and fell
// through to the generic "cannot lower a call" backstop (E0092) instead of
// a diagnosis of what the user wrote wrong.
fn main() {
  let a = [4]i64()
  print("ok\n")
}
