// error
// #6479 (owner ruling on #6466): a module `let`/`const` outside `runtime/` may
// hold any type, a class included, with any initializer — so `shared`, `cfg`
// and `started` below are ACCEPTED (no E0082, no E0064). A module `const` is set
// once: every assignment to one is E0185, whether it is declared here, imported
// by name, reached as `ns.limit`, or written by `++` or a tuple assignment.
import { limit } from "./modconstsupport"
import * as consts from "./modconstsupport"

class Config {
  retries: int,
}

fn load(): Config {
  return Config{ retries = 3 }
}

let shared: Config = Config{ retries = 1 }
const cfg: Config = load()
let started: int = cfg.retries
const attempts = 5

fn main() {
  shared = load()
  started = 2
  cfg = load()
  attempts = 6
  attempts += 1
  attempts++
  (attempts, started) = (1, 2)
  limit = 9
  consts.limit = 10
}
