// error
// #6112 (SPEC §10.3): a method's default expression may not reference
// `this` -- it is not bound yet at the one moment a default ever runs, a
// call that omits the argument.
class C {
  n: int
  export m(x: int = this.n): int {
    return x
  }
}

fn main() {
  let c = C{ n = 1 }
  print("${c.m()}\n")
}
