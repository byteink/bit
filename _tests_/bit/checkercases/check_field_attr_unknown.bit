// error
// SPEC §10.5, #3879: an unknown attribute name is the ORDINARY undefined-name
// error, not a bespoke one. That is the design showing through rather than an
// omission -- a field attribute is resolved by normal name lookup, so a
// misspelling is exactly the same mistake as misspelling any other call, and a
// second "unknown attribute" diagnostic would contradict the mechanism it
// describes. E0076 (unknown FUNCTION attribute) is a different rule for a
// different position and is untouched.

fn email(s: string): ()! {}

class C {
  @emial
  addr: string
}

fn main() {
  let c = C{ addr: "a@b" }
  print("${c.addr}\n")
}
