// error
// #7299: a generic class construction whose arguments bind nothing (the arrow's
// parameters are the thing being typed) takes its type arguments from the type
// its context declares: an annotated `let`, a `return`, an argument of a
// non-generic function or method, and an element of a list in any of those.
// The declared type outranks inference from the arguments, as written type
// arguments do: `Pair(1, "s")` against `Pair<i8, string>` types `1` as an `i8`,
// and an argument that contradicts it is the ordinary E0041. The `let` that has
// no declared type is E0068.
class Pair<A, B> {
  a: A
  b: B

  init(first: A, second: B) {
    this.a = first
    this.b = second
  }
}

class Rules<A> {
  n: i64,
}

class Policy<S, A> {
  name: string

  init(name: string, build: (Rules<A>, S) => ()) {
    this.name = name
  }
}

class Writer {
  id: i64,
}

enum Action { Read, Write }

class Registry {
  add(p: Policy<Writer, Action>) {
    println(p.name)
  }

  addAll(ps: []Policy<Writer, Action>) {
    println("${len(ps)}")
  }
}

fn named(p: Policy<Writer, Action>) {
  println(p.name)
}

fn made(): Policy<Writer, Action> {
  return Policy("made", (p, user) => {
    println("${user.id}")
  })
}

fn main() {
  let a: Policy<Writer, Action> = Policy("a", (p, user) => {
    println("${user.id}")
  })
  let b: []Policy<Writer, Action> = [
    Policy("b", (p, user) => {
      println("${user.id}")
    }),
  ]
  named(
    Policy("c", (p, user) => {
      println("${user.id}")
    }),
  )
  let r = Registry{}
  r.add(
    Policy("d", (p, user) => {
      println("${user.id}")
    }),
  )
  r.addAll(
    [
      Policy("e", (p, user) => {
        println("${user.id}")
      }),
    ],
  )
  let fits: Pair<i8, string> = Pair(1, "s")
  let tooWide: Pair<i8, string> = Pair(300, "s")
  let wrong: Pair<i64, string> = Pair("x", "s")
  let none = Policy("none", (p, user) => {
    println("${user.id}")
  })
}
