// error
// #6403 (SPEC §14.7): `static` heads a static method in an enum body
// (`static name(...)`, §10.4.1), so a variant literally named `static` is
// E0191 -- bare or with a payload -- instead of being taken as a variant
// that the method below it silently turned into. The method still parses.
enum Kind {
  Plain,
  static,
  Boxed(i64),
  static count(): i64 {
    return 2
  }
}

enum Wide {
  static(i64),
  Other,
}

fn main() {
  print("${Kind.count()}")
}
