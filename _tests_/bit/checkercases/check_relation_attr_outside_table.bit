// error
// SPEC §10.5, #5053: a relation attribute on a field of a class that carries
// no `@table` is an error naming the attribute, the field and the class.
// `@hasMany`/`@hasOne`/`@belongsTo` are compiler-known marks (excluded from
// #3879's call path, classrelationattr.bit), so without this diagnostic the
// mark would silently vanish once excluded from that path -- no call, no
// recorded descriptor entry, no error.
class User {
  @hasMany("userId")
  orders: []Order
}

class Order {
  id: i64,
}

fn main() {
  let u = User{}
  print("${len(u.orders)}\n")
}
