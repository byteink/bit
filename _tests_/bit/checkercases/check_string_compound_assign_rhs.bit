// error
// #4438 checker half: `x += y` where `x` is a `string` requires `y` to also
// be stringish, exactly as ordinary `x + y` does -- the OPERATOR being legal
// for a string lvalue does not make every right-hand side legal.
// vCompoundAssign (compiler/validatecall.bit) checks both, not just the
// operator: before #4438 this passed silently and reached the lowerer.
fn main() {
  let s = "ab"
  s += 5
  print(s)
}
