// error
// SPEC §10.5, #6698: a payload-free enum variant is a constant field default;
// a call that returns an enum, and a variant that carries a payload, are not
// and stay E0064.
enum Color {
  Red,
  Green,
}

fn pick(): Color {
  return Color.Green
}

class Call {
  c: Color = pick(),
}

class Payload {
  o: Option<int> = Option.Some(1),
}

class Fine {
  c: Color = Color.Red,
  o: Option<int> = Option.None,
}

fn main() {
  print("${len("")} ${Call{}.c == Color.Green} ${Fine{}.c == Color.Red}\n")
}
