// error
// #6408: a default literal proves a nested read only when it sets EVERY hop of
// it. This one sets `author` but not the `posts` inside it, so `x.author.posts`
// is unloaded when `show()` omits the argument: E0300 names the missing hop
// (`author.posts`) and says to set it in the literal -- a default holds no
// query, so `.with` is not offered.

@table class Author {
  @id
  id: i64
  name: string
  @hasMany("authorId")
  posts: []Post
}

@table class Post {
  @id
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn show(x: Post = Post{ id = 1, authorId = 1, author = Author{ id = 1, name = "Ada" } }): string {
  return "${len(x.author.posts)}"
}

fn main() {
  print("${show()}\n")
}
