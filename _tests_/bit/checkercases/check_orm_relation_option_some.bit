// error
// #6407: a `match` over `Option.Some(<query row>)` traces its binder back to the
// query (compiler/relationautomatch.bit's `relationAutoResolveWrapped`), the way
// one over `first()?` already did, and a local `Option<Post>` that only ever
// holds `Option.None` holds no row to read (`RelationAutoHolders.empty`,
// compiler/relationautoholder.bit). `loaded` and `empty` therefore build; only
// `raw` is E0300, naming raw SQL -- not a `.with` the raw query cannot take.
import { Db } from "../../../pkg/orm"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn loaded(db: Db): ()! {
  let o: Option<Post> = Option.Some(db.table<Post>().with("author").orderBy("id").all()?[0])
  match (o) {
    Some(v) => print("${v.author.name}\n")
    None => print("none\n")
  }
}

fn empty(): () {
  let o: Option<Post> = Option.None
  match (o) {
    Some(v) => print("${v.author.name}\n")
    None => print("none\n")
  }
}

fn raw(db: Db): ()! {
  let o: Option<Post> = Option.Some(db.query<Post>("select * from post order by id")?[0])
  match (o) {
    Some(v) => print("${v.author.name}\n")
    None => print("none\n")
  }
}

fn main() {}
