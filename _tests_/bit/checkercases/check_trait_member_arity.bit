// error
// #6379: a trait's method signatures and fields are type positions (SPEC 10.7)
// and E0058 judges them. The declaration sweep (`checkModule`) covered struct,
// enum, alias and interface declarations and function signatures but not
// `trait`, so `name(p: Box): i64` for a generic `Box<T>` was accepted. A method's
// own type parameter still resolves in its signature.
class Box<T> {
  v: T,
}

trait Tr {
  v: i64
  name(p: Box): i64 {
    return 1
  }
  other<U>(p: Box<i64, i64>): Box {
    return p
  }
  slot: Box
  export shown: Box<i64>
  generic<U>(p: U, q: Box<U>): Box<U> {
    return q
  }
}

fn main() {}
