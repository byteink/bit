// error
// #7129: `Repo<T>.update` on a `T` with no primary key at all (no `@id`, no
// field named `id`) is still E0180, even though a composite key is now
// accepted there — `compiler/checkormrepokey.bit`'s `ormRepoRefusesKeyCount`.
import { FieldDesc, AttrDesc } from "std/sql"
import { open } from "../../../pkg/orm"

@table class NoKeyUpd {
  name: string,
}

fn run(v: NoKeyUpd): ()! {
  open("postgres://x")?.table<NoKeyUpd>().update(v)?
}

fn main() {}
