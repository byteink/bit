// error
// #6308 (R3, epic #6298): `touchAuthor`'s own parameter is trackable (a
// `@table` class), so `relationAutoResolve` answers `found = true` for a
// read on it exactly as it would for one a real caller feeds a query row --
// but nothing in this project ever calls `touchAuthor`, so there is no
// query anywhere to add `.with("author")` to. `relationAutoBuildCalledSet`
// (compiler/relationautoerr.bit) is what tells the two apart.
@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn touchAuthor(p: Post): string {
  return p.author.name
}

fn main() {}
