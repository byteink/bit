// error
// SPEC §10.5, #6254: a `@collection` class must also carry `@json` --
// `store.collection<T>()` reads the name off `T.__collectionName()`,
// synthesized only for a `@json` class (mirrors `@job`'s own E0167,
// check_job_requires_json.bit). `buildCollectionClass`
// (compiler/classcollectiondesc.bit) is never reached here: the check runs
// in `collectCollectionClasses`, before `@collection`'s own argument is
// looked at, so a class missing `@json` gets only E0175.
@collection("sessions") class Session {
  id: i64,
}

fn main() {
  print("${Session{ id = 1 }.id}\n")
}
