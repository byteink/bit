// error
// #3941 (SPEC §12/§15.4): a conditional's two arms must meet at a common type
// under the untyped-constant join a binary operator's operands already use —
// `int` and `string` do not meet, so E0118 names both (validatecall.bit's
// `vConditional`, the same shape `vBinary` already uses for E0053).
fn main() {
  let ok = true
  let x = ok ? 1 : "two"
  print("${x}")
}
