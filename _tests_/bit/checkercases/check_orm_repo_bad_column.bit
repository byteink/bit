// error
// #6271: pkg/orm's `Repo<T>` chain (`db.table<T>()`/`tx.table<T>()`) rejects
// a string-literal column that names no field of `T`, exactly as the older
// `find<T>(...)` chain does (`check_orm_bad_column.bit`) — `checkOrmColumnCall`
// (compiler/checkormquery.bit) now roots a chain at either shape. `email` is
// misspelled "emial" below; a computed (non-literal) column would compile
// instead, falling back to the runtime check `Repo.columnFor`
// (pkg/orm/repo.bit) always performs. Imports pkg/orm by RELATIVE PATH
// rather than the bare `"orm"` a released package uses, the same reason
// `check_orm_bad_column.bit` does.
import { Db } from "../../../pkg/orm"
import { AttrDesc, FieldDesc } from "std/sql"

@table class Person {
  id: i64,
  email: string,
}

fn run(db: Db): ()! {
  db.table<Person>().where("emial", "x")
  db.table<Person>().orderBy("nmae")
}

fn main() {}
