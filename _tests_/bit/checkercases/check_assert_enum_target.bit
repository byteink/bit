// error
// #2104, superseded by #5216: SPEC §14.3 used to make it impossible for an
// enum to ever sit behind an interface value at all — `vTypeAssert`
// (compiler/validateiface.bit) checked `vStorableInInterface` before
// `vSatisfies`, so `m.(K)` was rejected on K's non-class kind alone. #5216
// gave enums in-body methods and widened `vStorableInInterface` to match
// (compiler/validate.bit), so K is storable now; this fixture is kept to pin
// the OTHER half of the assertion — K has no `message()` at all, so it still
// fails, now on `vSatisfies` ("does not satisfy") rather than on kind.
interface M { message(): string }
class S {
  c: int
  message(): string { return "s" }
}
enum K { A(int), B }
fn main() {
  let m: M = S{ c: 1 }
  let (k, ok) = m.(K)
  println("ok=${ok}")
}
