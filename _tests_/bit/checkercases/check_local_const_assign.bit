// error
// #6492: a LOCAL `const` is immutable under every assignment form. `=` was
// already E0062; `++`, `--`, a compound op and a tuple-pattern target were
// silently accepted, a `const` that changed.
fn main() {
  const x = 1
  let y = 0
  x++
  x--
  x += 1
  (x, y) = (2, 3)
  (y, x) = (4, 5)
  x = 6
  y++
}
