// error
// #6570: a `decimal` map key is refused. Equal decimals can differ in scale
// (1.0 and 1.00), so a map hashing the words would hold them as two entries,
// and a map's key is one word with no content hash for a two-word value.
fn main() {
  let m = map<decimal, int>()
  m[1.5] = 1
  print("${len(m)}\n")
}

fn keyed<K, V>(k: K, v: V): int {
  let m = map<K, V>()
  m[k] = v
  return len(m)
}

fn use() {
  let d: decimal = 2.5
  print("${keyed(d, 1)}\n")
}
