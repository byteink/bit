// error
// #6352: `view(rows[0], ...rows)` passes `rows[0]` to the fixed parameter `a`
// ahead of a `...` spread into the variadic tail. The call used to be skipped
// whole (no argument was matched to any parameter), so `a.author` passed
// with a row from raw SQL that never loads it. The fixed parameters before
// the spread are matched like any call's: E0300 lands on `rows[0]`.
import { Db } from "../../../pkg/orm"
import { AttrDesc, FieldDesc } from "std/sql"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn view(a: Post, ...rest: Post): string {
  return "${a.author.name}${len(rest)}"
}

fn rawRows(db: Db): []Post! {
  let rows = db.query<Post>("select * from post")?
  return rows
}

fn show(db: Db): string! {
  let rows = rawRows(db)?
  return view(rows[0], ...rows)
}

fn main() {}
