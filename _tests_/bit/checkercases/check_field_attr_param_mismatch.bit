// error
// SPEC §10.5, #3879: the field's own value is passed as the first argument, so
// the field's type must be assignable to the first parameter. E0135 says that
// in the attribute's terms; the E0041 beside it is the desugaring's own
// account of the same mistake, at the field.

fn positive(n: i64): ()! {}

class C {
  @positive
  handle: string
}

fn main() {
  let c = C{ handle: "ok" }
  print("${c.handle}\n")
}
