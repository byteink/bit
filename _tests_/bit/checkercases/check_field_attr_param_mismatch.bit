// error
// SPEC §10.5, #3879: the field's own value is passed as the first argument, so
// the field's type must be assignable to the first parameter. E0135 says that
// in the attribute's terms, and says it alone: the E0041 the desugared call
// used to raise on the same mistake, at the field, is suppressed by #4583 --
// the argument node is the one classfieldattrbuild.bit synthesized, and
// `vCallArgExpect` skips a marked node. An attribute's own EXTRA arguments
// are cloned from source, never marked, and still report E0041.

fn positive(n: i64): ()! {}

class C {
  @positive
  handle: string
}

fn main() {
  let c = C{ handle: "ok" }
  print("${c.handle}\n")
}
