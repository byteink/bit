// Support module for check_module_const_assign.bit (#6479): an exported module
// `const`, assigned from a different module than the one declaring it. Not a
// case itself — checkerdiag.bit's manifest walk only reads names ending in
// '.bit' DIRECTLY inside checkercases/.
export const limit: int = 8

// Support for check_const_write_through_import.bit (#6497): an exported const
// array, written through from a different module than the one declaring it.
export const grid: [2]int = [2]int{ 1, 2 }
