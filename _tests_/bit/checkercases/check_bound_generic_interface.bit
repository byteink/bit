// error
// #6379, #6396: a bound that names a generic interface must write its type
// arguments, and exactly as many as the interface declares (SPEC 11.3). The bare
// `S: Store` for `interface Store<T>` and the over-long `Store<i64, i64>` are both
// E0058, on a function and on a class; a sibling type parameter is a legal
// argument (`Store<T>`), and so is a bound mixed into an `&` list. A non-generic
// bound is fine. The value form `s: Store<i64>` is a type like any other.
interface Store<T> {
  get(): T,
}

interface Named {
  label(): string,
}

class Box<T: Store> {
  v: T,
}

fn viaBound<S: Store>(s: S) {}

fn both<A: Store & Named>(a: A) {}

fn tooMany<S: Store<i64, i64>>(s: S) {}

fn tooManySibling<T, S: Store<T, T>>(s: S) {}

fn mixed<T, S: Named & Store<T, T>>(s: S) {}

fn fine<N: Named>(n: N) {}

fn fine2<N: Named & Named>(n: N) {}

fn fineGeneric<T, S: Store<T>>(s: S) {}

fn fineMixed<S: Named & Store<i64>>(s: S) {}

fn viaValue(s: Store<i64>) {}

fn main() {}
