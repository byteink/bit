// error
// #6379: a bound is a name (`parseConstraint`) and cannot carry type arguments
// yet, so a generic interface named bare as a bound, `S: Store` for
// `interface Store<T>`, has no legal spelling and is E0058 rather than accepted
// with `S`'s methods typed against an open `T`. A non-generic bound is fine, and
// so is each bound of an `&` list that is not generic.
interface Store<T> {
  get(): T,
}

interface Named {
  label(): string,
}

class Box<T: Store> {
  v: T,
}

fn viaBound<S: Store>(s: S) {}

fn both<A: Store & Named>(a: A) {}

fn fine<N: Named>(n: N) {}

fn fine2<N: Named & Named>(n: N) {}

fn main() {}
