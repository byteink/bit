// error
// #6278: `db.table<T>()` hands back `Repo<T>` (pkg/orm/repo.bit), which does
// not declare `lock()` — only `tx.table<T>()`'s own `TxRepo<T>`
// (pkg/orm/txrepo.bit) does. `db.table<Post>().lock()` is therefore a
// compile error naming the missing method, never the runtime `LockError`
// #6276 originally shipped (a row lock taken outside a transaction is
// meaningless — see txrepo.bit's own header for why two distinct declared
// types, not a flag, is what makes this a compile-time distinction). Imports
// pkg/orm by RELATIVE PATH rather than the bare `"orm"` a released package
// uses, the same reason `check_orm_repo_bad_column.bit` does. `@table`
// resolves `FieldDesc`/`AttrDesc` as an implicit `std/sql` dependency
// (`compiler/project.bit`'s `injectImplicitTableImport`, #6284) — no
// explicit import of either is needed here.
import { Db } from "../../../pkg/orm"

@table class Post {
  id: i64,
  title: string,
}

fn run(db: Db): ()! {
  db.table<Post>().lock()
}

fn main() {}
