// error
// SPEC §14.3, #6990: `__get_<field>` is the getter an interface field
// requirement is implemented with; a hand-written method of that prefix is
// E0310, since it would satisfy a requirement by name alone.
interface Subject {
  id: string,
}

class User {
  export id: string,
  __get_id(): string {
    return "forged"
  }
}

fn main() {
  let s: Subject = User{ id = "u1" }
  print(s.id)
}
