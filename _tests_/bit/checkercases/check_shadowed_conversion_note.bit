// error
// #3474: `f64(x)` looks like the builtin conversion, but this module's own
// `fn f64()` shadows it (E0048, a warning easy to miss once a module has
// other errors) and wins by SPEC 17.5's precedence, so the call's inferred
// type is the function's declared RESULT — `int` — not a conversion to
// `f64`. The E0041 below must carry a note naming the shadowing declaration
// so the reader is not left debugging `x`.
fn f64(): int { return 1 }

fn useCast(x: int): f64 {
  return f64(x)
}
