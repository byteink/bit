// error
// #4491, the destructive half of the same hole: assigning a slice of a BIGGER
// class into a variable holding a slice of a smaller one made every later read
// run past the end of the smaller object. This program exited 0 and printed
// `n=2 extra=[]` — `extra` is a field `B` does not have, read out of whatever
// follows the object.
class A {
  n: int,
  extra: string,
}

class B {
  n: int,
}

fn main() {
  let as1 = append([]A(0), A{ n: 1, extra: "x" })
  let bs = append([]B(0), B{ n: 2 })
  let pick = as1
  pick = bs
  print("n=${pick[0].n} extra=[${pick[0].extra}]\n")
}
