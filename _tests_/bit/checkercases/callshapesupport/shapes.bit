// Support module for check_call_shape_gaps.bit (#6398, #6399, #6400, #6409): a
// free function and a class with a static method, reached from another module
// through a namespace import. Not a case itself: checkerdiag.bit's manifest walk
// only reads names ending in '.bit' DIRECTLY inside checkercases/.
export fn f(a: i64, b: string): i64 {
  return a * len(b)
}

export class K {
  export n: i64

  export static st(a: i64, b: string): i64 {
    return a * len(b)
  }
}

export fn mkK(): K {
  return K{ n = 1 }
}
