// error
// SPEC §14.3, #7327: `__sameValue`, `__valueHash` and `__snapshot` exist only on a
// class whose every field has value semantics. A function-typed field has none,
// so calling one is E0313 at the call, naming the field, never a runtime panic.
class Handler {
  id: string,
  onDone: () => bool,
}

fn main() {
  let a = Handler{ id = "h", onDone = () => true }
  let b = Handler{ id = "h", onDone = () => true }
  print(a.__sameValue(b))
}
