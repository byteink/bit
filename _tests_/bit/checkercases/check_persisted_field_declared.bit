// error
// SPEC §10.5, #5052: a `@table` class cannot name the hidden persisted-flag
// slot directly. `isPersisted` and `markPersisted` are the two names `@table`
// reserves for its own hidden accessors — Bit source can never declare a
// FIELD under either spelling, distinct from declaring one as a METHOD
// (check_persisted_method_declared.bit).
import { FieldDesc } from "std/sql"

@table class User {
  id: i64,
  isPersisted: bool,
}

fn main() {
  let u = User{ id = 1, isPersisted = false }
  print("${u.id}\n")
}
