// error
// #3941 (SPEC §12): a conditional expression's condition must be `bool` —
// no truthiness. `n` is an `int`, so `n ? 1 : 2` is rejected the same way any
// other non-bool value would be assigned where `bool` is expected (E0041,
// `vExpectExpr`, validatecall.bit's `vConditional`).
fn main() {
  let n = 3
  let x = n ? 1 : 2
  print("${x}")
}
