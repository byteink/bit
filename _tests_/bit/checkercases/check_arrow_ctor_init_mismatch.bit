// error
// #6564: seeding an arrow argument from a class `init` parameter must not
// accept an arrow that truly mismatches it. `V((s: string) => 1)` writes a
// string-parameter arrow where `init` declares `() => i64!`, and
// `W<int>((s: string) => s)` writes one where the substituted `(i64) => i64!` is
// declared: both are still E0041. The first row is the control: its `?` is legal
// because the seeded expectation is fallible.
class V {
  f: () => int!
  init(f: () => int!) {
    this.f = f
  }
}

class W<T> {
  f: (T) => T!
  init(f: (T) => T!) {
    this.f = f
  }
}

fn g(): int! {
  return 1
}

fn main() {
  let ok = V(() => g()?)
  let a = V((s: string) => 1)
  let b = W<int>((s: string) => s)
  print("${ok.f() catch 0} ${a.f() catch 0} ${b.f(1) catch 0}\n")
}
