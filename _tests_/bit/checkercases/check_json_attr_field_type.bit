// error
// SPEC §10.5, #3976: `@json` serialises a scalar, `string`, `bool`, `[]T`,
// `map<string, T>`, `Option<T>` and a nested `@json` class. A container nests
// exactly ONE level: `[][]string` would need a second accumulator, and a
// `map` keyed by anything but `string` has no JSON object to become.
//
// A single bad field fails the WHOLE class rather than being dropped: a
// synthesised `toJson` that silently omits one field is worse than none,
// because the omission is invisible in the output.
import { Json, JsonEntry } from "std/json"

@json class A {
  p: *i64,
}

@json class B {
  xs: [][]string,
}

@json class C {
  m: map<i64, string>,
}

fn main() {
  print("${A{ p: nil }.p == nil}\n")
}
