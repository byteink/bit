// error
// #6259: `jsonDecode<T>` where `T` is a type parameter of the enclosing
// generic CLASS, not of the method itself, resolves per CLASS instantiation
// exactly as #4563 already resolves a function/method's own `T` — through
// `ctx.typeInsts` rather than `ctx.instantiations`
// (classjsondecodegenericretarget.bit's `validateJsonDecodeClassGenerics`).
// This file used to pin the shape as a hard refusal (E0145 "is a type
// parameter of the enclosing CLASS"); it now pins the ORDINARY refusal every
// `jsonDecode<T>` gets when the concrete type argument does not carry
// `@json` — `Plain` here deliberately does not, and `Holder<Plain>{ n = 0 }`
// below is what supplies it as the concrete argument.
//
// Reported at the CALL inside `grab`'s own body, not at the outer
// `Holder<Plain>{...}` site: `ctx.typeInsts` carries no call site of its own
// (nothing CALLS a class), so `JsonDecodeClassGeneric.site` — the
// `jsonDecode<T>` call `collectJsonDecodeClassGenerics` found it through — is
// the representative location every instantiation's diagnostic points back
// at.
import { Json, jsonDecode } from "std/json"

class Plain {
  v: i64,
}

class Holder<T> {
  n: i64
  grab(j: Json): T! {
    return jsonDecode<T>(j)?
  }
}

fn main() {
  let h = Holder<Plain>{ n = 0 }
  let c = h.grab(Json.JsonNull) catch _ {
    return
  }
  print("${c.v}\n")
}
