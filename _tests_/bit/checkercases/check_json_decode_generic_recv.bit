// error
// #4563: `jsonDecode<T>` where `T` is a type parameter of the enclosing generic
// CLASS, not of the method itself. This one stays a refusal, and the message
// says so in words.
//
// A method of a generic class is not an instantiation-ledger entry at all --
// `lowerMethodInstances` emits it once per nominal instantiation of the
// receiver, and nothing records the generic calls in the body it emits (#4569).
// The specialisation this feature resolves through is a retargeted LEDGER
// entry, so with no entry there is nothing to retarget.
//
// Reported at the DECLARATION rather than at a call: the shape is unsupported,
// not any particular use of it, and the reader's fix is to move the decode into
// a declaration that owns the type parameter.
import { Json, JsonEntry, jsonDecode } from "std/json"

@json class Marked {
  v: i64,
}

class Holder<T> {
  n: i64
  grab(j: Json): T! {
    return jsonDecode<T>(j)?
  }
}

fn main() {
  let h = Holder<Marked>{ n: 0 }
  let c = h.grab(Json.JsonNull) catch _ {
    return
  }
  print("${c.v}\n")
}
