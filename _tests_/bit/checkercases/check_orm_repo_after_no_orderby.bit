// error
// #6293: `Repo<T>.after(key)` needs an `.orderBy(...)` earlier in the same
// chain (`keysetPredicateForRepo`, pkg/orm/keyset.bit) — `checkOrmAfterCall`
// (compiler/checkormquery.bit) now catches the missing call at compile
// time, the same way `check_orm_repo_bad_column.bit` catches a misspelled
// column. `after` is called directly off `db.table<Person>()` below, with
// no `.orderBy(...)` anywhere in the chain.
import { Db } from "../../../pkg/orm"
import { Value } from "std/sql"

@table class Person {
  id: i64,
  email: string,
}

fn run(db: Db): ()! {
  db.table<Person>().after(Value.Int(1)).limit(20)
}

fn main() {}
