// error
// #6479 (owner ruling on #6466): module state outside `runtime/` may hold any
// type, but a `runtime/` module keeps SPEC §11.11's untraced-only rule, because
// the collector cannot trace its own bookkeeping. The module below sits under
// rtmodulesupport/runtime/ beside a stdlib/ directory, which is what makes it
// one: its class-typed `let` is still E0082, its array initializer and its
// non-constant initializer still refused, while this file's own cells are not.
import { slot } from "./rtmodulesupport/runtime/cell"

class Pool {
  size: int,
}

let pool: Pool = Pool{ size = 4 }

fn main() {
  print("${slot.n} ${pool.size}\n")
}
