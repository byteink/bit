// error
// SPEC §10.5, #5051: a class carrying `@table` that also declares
// `tableDescriptor` itself is an error naming both, exactly as `@json`
// refuses a class that declares `toJson` (E0138) and #3879 refuses one that
// declares `validateFields` (E0132) -- letting the hand-written one win
// silently would make `@table` appear to work while `pkg/orm` never sees a
// field it does not already know about.
import { FieldDesc } from "std/sql"

@table class User {
  id: i64

  tableDescriptor(): []FieldDesc {
    return []
  }
}

fn main() {
  let u = User{ id: 1 }
  print("${u.id}\n")
}
