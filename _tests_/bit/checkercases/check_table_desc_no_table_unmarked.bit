// error
// SPEC §10.5, #5051: `@table` is OPT-IN. A class without it has NO
// `tableDescriptor` member at all -- synthesising for every class would
// expose a field the moment someone adds one to a type nobody meant to
// model as a table.
//
// Proven the only way absence can be proven: by calling it and getting the
// ordinary undefined-member error.
class Internal {
  id: i64,
}

fn main() {
  let x = Internal{ id: 1 }
  for f of x.tableDescriptor() {
    print("${f.name}\n")
  }
}
