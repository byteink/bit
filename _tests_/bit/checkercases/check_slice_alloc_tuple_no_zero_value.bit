// error
// #4721: `[](i64, P)(2)` was accepted and filled every element with a zeroed
// `P` whose class-typed `q` stayed null, while `let w: (i64, P)` for the SAME
// tuple is E0083 (#4533). §12.9 makes `[]T(n)` mean "n zero values of T", so
// the two spellings ask the identical question and must give the identical
// verdict.
//
// A tuple element reached NEITHER half of §13.4's split: the static refusal
// (`vSliceAllocNoZeroValue`, validatezero.bit) admitted only Struct and Enum
// element kinds, and the runtime panic for a non-constant `n`
// (`typeHasNoZeroValue`, lowerslicefill.bit) returned false for anything that
// was not a Struct or an Enum. Both now recurse through
// `vTupleNoZeroMember`.
//
// `[](i64, Q)(2)` below is the control and reports NOTHING: `Q` has a zero
// value, and #4414/#4500 fill a tuple's class-typed member with a live zeroed
// instance, so that spelling stays legal. Only a member whose own type has no
// zero value refuses.
class Q {
  v: i64,
}

class P {
  q: Q,
}

fn main() {
  let ok = [](i64, Q)(2)
  print("${ok[0].1.v}\n")
  let xs = [](i64, P)(2)
  print("${xs[0].1.q.v}\n")
}
