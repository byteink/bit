// error
// #6392: `T.name` where `T` is a type name. The checker never judged it: an
// instance method, a field or a missing member called through the class
// (`K.inst(1)`, `K.nope(1)`) and an unknown enum variant (`E.Z`) all checked
// clean, and `bit run` then stopped in the lowerer at E0092, or, for `E.Z`,
// lowered it to variant 0 and ran. A class's member through its name is a static
// method that is CALLED (SPEC §12.5); a static method is no first-class value.
// A type parameter is judged the same way against its bound's static
// requirements (§10.4.1).
class K {
  a: i64

  static f(a: i64): i64 {
    return a
  }

  inst(a: i64): i64 {
    return a
  }
}

enum E {
  A,
  B,
  C(i64),
}

interface Named {
  static label(): string,
  nm(): string,
}

class Box {
  static label(): string {
    return "box"
  }

  nm(): string {
    return "n"
  }
}

fn describe<T: Named>(): string {
  let a = T.nope()
  let b = T.nm()
  return T.label()
}

fn main() {
  let a = K.inst(1)
  let b = K.nope(1)
  let c = K.a(1)
  let d = K.a
  let e = K.f
  K.a = 2
  let f = E.Z
  let g = E.Z(1)
  let ok1 = K.f(1)
  let ok2 = K.f(a = 1)
  let ok3 = E.A
  let ok4 = E.C(1)
  print(describe<Box>())
}
