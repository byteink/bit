// error
// SPEC §10.5, #6081: two `@job` classes anywhere in the program sharing a
// name is E0169, a whole-program check (`checkJobNameDuplicates`,
// compiler/classjobdesc.bit) since a job dispatch table is keyed by this
// string across every module the compiler sees. `GenerateInvoice` is the
// positive control: a THIRD `@job` class with its own distinct name,
// proving the check does not over-fire on every `@job` class in the
// program -- only the true duplicate, `SendWelcome2`, is named.

import { Json } from "std/json"

@job("send-welcome") @json class SendWelcome {
  userId: i64,
}

@job("generate-invoice") @json class GenerateInvoice {
  orderId: i64,
}

@job("send-welcome") @json class SendWelcome2 {
  userId: i64,
}

fn main() {
  print("${SendWelcome{ userId = 1 }.userId}\n")
  print("${GenerateInvoice{ orderId = 2 }.orderId}\n")
  print("${SendWelcome2{ userId = 3 }.userId}\n")
}
