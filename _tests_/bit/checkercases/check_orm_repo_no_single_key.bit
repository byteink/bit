// error
// #6269: `Repo<T>.find/update/delete` on a `T` that carries no single
// primary key (no `@id`, and no field named `id`) is a compile error
// naming the class — `compiler/checkormrepokey.bit`'s own key-count check,
// resolved through `db.table<NoKey>()`'s own return type rather than a
// syntactic type argument (that file's own header: the receiver is a
// generic instantiation, not a literal `find<T>(...)` call). Imports
// pkg/orm by RELATIVE PATH rather than the bare `"orm"` a released package
// uses (`compiler/checkormrepokey.bit`'s own header accepts both, mirroring
// `checkormquery.bit`'s `ormPathMatches`): pkg/orm carries no manifest this
// project's `bit.lock` can resolve by name.
import { FieldDesc, AttrDesc } from "std/sql"
import { open } from "../../../pkg/orm"

@table class NoKey {
  name: string,
}

fn run(): ()! {
  let db = open("postgres://x")?
  db.table<NoKey>().find(1)?
}

fn main() {}
