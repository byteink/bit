// error
// #4548: every argument that lands in a variadic `...xs: T` slot is judged
// against the ELEMENT type T, and the FIXED prefix of a variadic signature
// against its own declared type — the same E0041 a fixed-arity call gets.
// Before the fix `vCallArity` returned false for every variadic call, so the
// argument loop never ran: `sum("hello")` and `sum((x: int) => x + 1)` both
// checked clean and printed a pointer, and `tag(7, 1, 2)` segfaulted.
//
// The four legal calls in main() are the controls: a spread, individual
// arguments, no variadic arguments at all, and a correct fixed prefix. Any of
// them appearing below would be a false positive, and the .expected match is
// exact, so a fourth diagnostic fails this case.
fn sum(...xs: int): int {
  let t = 0
  for x of xs {
    t = t + x
  }
  return t
}

fn tag(label: string, ...xs: int): int {
  return len(label) + len(xs)
}

fn main() {
  let ys = [1, 2, 3]
  print("${sum(...ys)}\n")
  print("${sum(1, 2, 3)}\n")
  print("${sum()}\n")
  print("${tag("totals", 1, 2)}\n")
  print("${sum("hello")}\n")
  print("${sum(1, true)}\n")
  print("${sum((x: int) => x + 1)}\n")
  print("${tag(7, 1, 2)}\n")
}
