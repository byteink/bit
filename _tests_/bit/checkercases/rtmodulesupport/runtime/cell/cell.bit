// Support module for check_module_state_runtime_traced.bit (#6479): a module
// under `runtime/`, where SPEC §11.11's untraced-only module state still holds.
// Not a case itself.
export class Slot {
  n: int,
}

export let slot: Slot = Slot{ n = 1 }
export let heads: [4]int = [4]int{ 1, 2, 3, 4 }
export let count: int = compute()

fn compute(): int {
  return 3
}
