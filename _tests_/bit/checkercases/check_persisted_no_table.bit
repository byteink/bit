// error
// SPEC §10.5, #5052: `isPersisted`/`markPersisted` are reserved only on a
// class carrying `@table` — a class without it has no such member, the
// ordinary E0057 every other unknown member gets.
class User {
  id: i64
}

fn main() {
  let u = User{ id: 1 }
  print("${u.isPersisted()}\n")
}
