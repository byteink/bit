// error
// #4438 checker half, control: vCompoundAssign (compiler/validatecall.bit)
// must accept every LEGITIMATE compound assignment and never over-fire --
// it is scoped to `string` lvalues and to the `+` operator specifically.
// Every statement below through the four `string` lvalue shapes (local,
// class field, map entry, slice element) and the `int` compound-assigns is
// accepted silently. Only the final, unrelated, PRE-EXISTING `-` on two
// strings (ordinary binary, untouched by #4438) gives this harness the
// non-empty `.expected` it requires -- checkerdiag.bit refuses an empty
// `.expected`, since a compiler that says nothing would satisfy it too.
class Box { s: string }

fn main() {
  let local = "ab"
  local += "cd"

  let b = Box{ s: "ab" }
  b.s += "cd"

  let m = map<string, string>{ "k": "ab" }
  m["k"] += "cd"

  let xs = ["ab", "xy"]
  xs[0] += "cd"

  let n = 1
  n += 2
  n -= 1

  let bad = local - "z"
  print(bad)
}
