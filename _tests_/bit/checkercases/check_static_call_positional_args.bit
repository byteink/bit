// error
// #6381: a static method called through its class name is judged like any
// other call (SPEC 10.4.1): arity is E0050, each argument's type is E0041, a
// misplaced spread is E0063. The type name has no value type, so the validator
// used to return before judging a positional call and `K.f("x", 1)` checked
// clean and panicked at run time. This holds for a plain class, a generic class
// through its bare name and through a written instantiation, a variadic or
// defaulted static, a static with type parameters of its own, and a static
// required by a bound (`T.label(1, 2)`).
interface Named {
  static label(n: i64): string,
}

class K {
  static f(a: i64, b: string): i64 {
    return a
  }

  static v(a: i64, ...rest: i64): i64 {
    return a
  }

  static d(a: i64, b: i64 = 2): i64 {
    return a + b
  }

  static own<U>(u: U, n: i64): U {
    return u
  }

  static label(n: i64): string {
    return "k"
  }
}

class G<T> {
  static g(a: T, b: string): T {
    return a
  }
}

fn show<T: Named>(): string {
  return T.label("s") + T.label(1, 2)
}

fn main() {
  let a = K.f("x", 1)
  let b = K.f(1)
  let c = K.f(...[1, 2])
  let d = K.v()
  let e = K.v(1, "x")
  let f = K.d(1, 2, 3)
  let g = K.own("s")
  let h = G<i64>.g("x", 1)
  let i = G<i64>.g(1)
  let j = G.g(1)
  let k = show<K>()
  let ok1 = K.f(1, "x")
  let ok2 = K.v(1, 2, 3)
  let ok3 = K.d(1)
  let ok4 = K.own("s", 1)
  let ok5 = G<i64>.g(1, "x")
  let ok6 = G.g(1, "x")
}
