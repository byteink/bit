// error
// #2755: too FEW arguments into a method call did not even reach a
// diagnostic — `bit check` exited 0 and `bit build` crashed with the
// compiler's own `panic: index out of range` while lowering the call, since
// nothing upstream had rejected the mismatched arity first. A compiler crash
// on invalid input is not a rejection, so this pins a clean E0050 instead.
class P {
  v: int
  bar(x: int, y: int): bool {
    return x > 0
  }
}

fn main() {
  let q = P{ v: 1 }
  print("${q.bar()}\n")
}
