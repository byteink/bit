// error
// #7406: `x.(I)` with an INTERFACE target is judged at run time (SPEC §14.4):
// the held value's dynamic type may implement `Scheme` whatever `Transport`
// says, so the two `Scheme` assertions in `main` are accepted. A CLASS target
// is still judged at compile time: `Plain` has no `send()`, so it can never be
// what a `Transport` holds, and both spellings of the assertion are rejected.
interface Transport { send(): int }
interface Scheme { scheme(): string }
class Smtp {
  export send(): int { return 1 }
  export scheme(): string { return "smtp" }
}
class Plain {
  n: int,
}
fn main() {
  let t: Transport = Smtp{}
  let (s, ok) = t.(Scheme)
  let w = t.(Scheme)
  let (p, ok2) = t.(Plain)
  let q = t.(Plain)
  println("${ok} ${ok2} ${s.scheme()} ${w.scheme()} ${p.n} ${q.n}")
}
