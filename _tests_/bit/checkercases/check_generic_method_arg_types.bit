// error
// #6387: a method that declares type parameters of its OWN is judged like any
// other call (SPEC 10.4.1, 12.11): this call's inferred type arguments are
// substituted into its signature and each argument is checked against the
// result (E0041). `vCallAgainstFuncSig` used to return at the first type
// parameter in the signature, so `V.own(1, "x")` checked clean and read the
// string as the `i64` `n` at run time. This holds for a static and an instance
// method, positional and named, a variadic one, and a generic class's method.
interface Named {
  label(): string,
}

class Tag {
  label(): string {
    return "t"
  }
}

class V {
  static own<U>(u: U, n: i64): U {
    return u
  }

  static each<U>(n: i64, ...xs: U): i64 {
    return n
  }

  static lab<U: Named>(u: U, n: i64): string {
    return u.label()
  }

  static none<U>(n: i64): []U {
    return []U(0)
  }

  inst<U>(u: U, n: i64): U {
    return u
  }
}

class G<T> {
  static own<U>(u: U, n: i64): U {
    return u
  }

  static mk<U>(t: T, u: U): T {
    return t
  }

  both<U>(t: T, u: U): T {
    return t
  }
}

fn main() {
  let v = V{}
  let g = G<i64>{}
  let a = V.own(1, "x")
  let b = v.inst(1, "x")
  let c = V.own(n = "x", u = 1)
  let d = v.inst(n = "x", u = 1)
  let e = V.each(1, "a", 2)
  let f = V.lab(Tag{}, "x")
  let h = G.own(1, "bad")
  let i = G<i64>.mk(1, "u")
  let j = G<i64>.mk("x", "u")
  let k = g.both("x", "u")
  let ok1 = V.own("s", 1)
  let ok2 = v.inst("s", 1)
  let ok3 = V.own(u = "s", n = 1)
  let ok4 = V.each(1, "a", "b")
  let ok5 = V.lab(Tag{}, 3)
  let ok6 = V.own<string>("s", 1)
  let ok7 = V.none<string>(3)
  let ok8 = G.own("s", 1)
  let ok9 = G<i64>.mk(1, "u")
  let ok10 = g.both(1, "u")
}
