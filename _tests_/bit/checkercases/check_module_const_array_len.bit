// error
// #6479: a module `const` that is set at startup holds a value only the running
// program can build, so it cannot size an array — a compile-time constant is
// required there (§12). `fixed` folds from a literal and still can.
class Dims {
  w: int,
}

fn measure(): int {
  return 4
}

const fixed = 8
const size = measure()
const dims: Dims = Dims{ w = 3 }
const width = dims.w

fn main() {
  let a: [fixed]int
  let b: [size]int
  let c: [width]int
}
