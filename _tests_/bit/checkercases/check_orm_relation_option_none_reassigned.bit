// error
// #6407: a local `Option<Post>` initialised with `Option.None` holds no row only
// until something else is stored into it. The raw-SQL row assigned below is the
// one writer, so the read in the `Some` arm is E0300 and the hint names that
// store, not a query to add `.with` to.
import { Db } from "../../../pkg/orm"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn run(db: Db): ()! {
  let o: Option<Post> = Option.None
  o = Option.Some(db.query<Post>("select * from post order by id")?[0])
  match (o) {
    Some(v) => print("${v.author.name}\n")
    None => print("none\n")
  }
}

fn main() {}
