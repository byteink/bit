// error
// #3944: an UPPERCASE JSX tag desugars to an ordinary named-argument call
// (SPEC §12.12), so a wrong prop is the same diagnostic a hand-written
// mistyped, missing, or mistyped-type named argument gets, at the
// attribute's own span (the missing one has no attribute to point at, so
// it reports at the call, exactly as an ordinary short call does).
fn Layout(title: string, subtitle: string): string {
  return title + subtitle
}
fn main() {
  let a = <Layout titel="Users" subtitle="x" />
  let b = <Layout title="Users" />
  let c = <Layout title={5} subtitle="x" />
}
