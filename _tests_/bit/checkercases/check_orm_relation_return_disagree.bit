// error
// #6373: `pick`'s two `return`s disagree (raw SQL in one branch, a query in the
// other), so `run`'s read `p.author` is proven only when EVERY `return` loads
// 'author'. E0300 names the `return` that does not, the raw-SQL one (raw SQL has
// no `.with()`), and says to read the rows through a query instead.
import { Db } from "../../../pkg/orm"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn pick(db: Db, raw: bool): Post! {
  if (raw) {
    let rows = db.query<Post>("select * from post")?
    return rows[0]
  }
  return db.table<Post>().find(1)?
}

fn run(db: Db): string! {
  let p = pick(db, true)?
  return p.author.name
}

fn main() {}
