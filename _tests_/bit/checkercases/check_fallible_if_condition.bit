// error
// #6677 (§18.3): a fallible call is an `if` condition with no `?` or `catch`.
// The checker never judged an `if` condition at all, so the `bool!` was taken
// for the `bool`, the error half was dropped, and `g()` returned 0 with exit 0
// whenever `f()` failed. The same hole made std/xml's `if (this.cdataStep())`
// spin forever. The condition is now held to `bool` like a conditional
// expression's is, so it reads `expected 'bool', found 'bool!'` with the fix.
class Boom {
  message(): string { return "x" }
}

fn f(): bool! { fail Boom{} }

fn g(): i64 {
  if (f()) {
    return 1
  }
  return 0
}

fn main() {
  assert(g() == 0)
}
