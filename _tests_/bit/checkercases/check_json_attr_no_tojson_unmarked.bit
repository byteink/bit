// error
// SPEC §10.5, #3976: `@json` is OPT-IN. A class without it has NO `toJson`
// member at all -- synthesising for every class would cost binary size for
// types nobody serialises and would silently expose a field the moment someone
// adds one to an internal type.
//
// Proven the only way absence can be proven: by calling it and getting the
// ordinary undefined-member error.
import { jsonEncode } from "std/json"

class Internal {
  id: i64,
}

fn main() {
  let x = Internal{ id: 1 }
  print("${jsonEncode(x.toJson())}\n")
}
