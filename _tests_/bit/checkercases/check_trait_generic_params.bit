// error
// #5275: a trait declares no type parameters of its own (SPEC §10.7) -
// `trait Existence<T>` is E0021, naming the rule ("traits cannot be
// generic") instead of the generic "expected '{', found '<'" a plain
// `expect` would have produced.
trait Existence<T> {
  get(id: T): bool
}

fn main() {
  print("unreachable\n")
}
