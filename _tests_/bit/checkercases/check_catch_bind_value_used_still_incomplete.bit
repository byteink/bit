// error
// #6285: statement-position discard (`f() catch e { flag = true }`) no
// longer needs the block to produce a value — see the golden ACCEPT case
// run_catch_discard_no_value.bit. The identical block shape used to
// INITIALIZE a binding is a different construct: the catch's ok value IS
// used here, so a plain-assignment tail with no diversion is still E0067,
// exactly as before this ticket.
class myErr {
  code: i64
  message(): string { return "code=${this.code}" }
}
fn f(): i64! { fail myErr{ code = 1 } }
fn main() {
  let mismatched = false
  let x = f() catch e {
    mismatched = true
  }
  print("x=${x} mismatched=${mismatched}\n")
}
