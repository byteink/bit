// error
// #3370: a class declares a field with the same name as one its `use`d
// trait provides. Distinct from check_trait_field_conflict.bit (two traits
// colliding with each other): here the SECOND source is the class's own
// declaration, so the diagnostic names the class and the trait, not two
// traits — and it is still an error, never a silent override, unlike a
// method with the same shape (#3369's check_trait_method_conflict.bit,
// where the class's own method wins silently).
trait A {
  x: i64
}

class C {
  use A
  x: i64
}

fn main() {
  print("${C{ x: 1 }}\n")
}
