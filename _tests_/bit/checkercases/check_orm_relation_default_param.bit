// error
// #6366: `show()` omits `p`, so `p` is its default, which is a class literal
// that never sets `author` -- the read inside `show` was never proven for it.
// A default is an argument like any other: E0300 names the default's own line
// and says to set the field in the literal. A call that passes `p` itself is
// judged as before.
import { Db } from "../../../pkg/orm"
import { AttrDesc, FieldDesc } from "std/sql"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn show(p: Post = Post{ id = 0, authorId = 0 }): string {
  return p.author.name
}

fn run(): string {
  return show()
}

fn main() {}
