// error
// #6308 (R3, epic #6298): `Db.query<T>` (pkg/orm/rawsql.bit) hands back raw
// rows with no relation-loading path at all -- its callee is a `Tag.Member`
// named "query", never matched by `relationAutoSourceCall`'s own
// `all`/`find`/`first` check (compiler/relationauto.bit), so a relation
// read on one of its rows is unprovable from the very first hop.
import { Db } from "../../../pkg/orm"
import { AttrDesc, FieldDesc } from "std/sql"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn run(db: Db): ()! {
  let rows = db.query<Post>("select * from post")?
  print("${rows[0].author.name}\n")
}

fn main() {}
