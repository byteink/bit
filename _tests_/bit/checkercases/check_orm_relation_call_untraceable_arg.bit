// error
// #6344: `view` reads `a.author` off its PARAMETER and has a known caller,
// so the read inside `view` always passed -- even though the row `show`
// hands it came from raw SQL (`Db.query<T>` has no `.with()`), which never
// loads `author`. The proof belongs at the call: the argument `a` cannot be
// traced to a query that loads `author`, so E0300 lands on it.
import { Db } from "../../../pkg/orm"
import { AttrDesc, FieldDesc } from "std/sql"

@table class Author {
  id: i64,
  name: string,
}

@table class Article {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn rawOne(db: Db, id: i64): Article! {
  let rows = db.query<Article>("select * from article where id = $1", id)?
  return rows[0]
}

fn view(a: Article): string {
  return a.author.name
}

fn show(db: Db): string! {
  let a = rawOne(db, 1)?
  return view(a)
}

fn main() {}
