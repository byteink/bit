// error
// #5080: a namespace import used bare, where a VALUE is expected, typechecked
// clean and only `bit build`'s lowerer refused it (E0092, "cannot lower a
// name that does not resolve to..."). `checkExprType`'s Ident arm answers 0
// for a namespace the same way it does for a genuine inference gap
// (`identEnvType`, checklookup.bit), so `vAssignable`'s invalid-cascade
// escape (validate.bit) accepted it against ANY expected type — `take(io)`
// against a declared `i64` parameter passed `bit check` with `io` typed
// nothing at all. Fixed in validatemember.bit's `vNamespaceUsedAsValue`,
// called from `vExpect`: a bare namespace reaching a value-expected position
// is now diagnosed at check time, pointing at SPEC §17.2.
import io from "std/io"

fn take(x: i64): i64 {
  return x
}

fn main() {
  println("${take(io)}")
}
