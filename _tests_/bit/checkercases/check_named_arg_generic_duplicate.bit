// error
// #6343: a parameter of a GENERIC callee supplied twice - positionally then
// by name, or by the same name twice - is E0125, as on a concrete callee.
interface Shape {
  area(w: i64, h: i64): i64,
}

class GBox<T> {
  v: T
  set(x: T): T {
    return x
  }
}

fn pick<T>(a: T, b: T): T {
  return a
}

fn measure<T: Shape>(shape: T): i64 {
  return shape.area(1, w = 3, h = 2)
}

fn main() {
  print("${pick(1, a = 2)}\n")
  let box = GBox<i64>{ v = 0 }
  print("${box.set(x = 1, x = 2)}\n")
}
