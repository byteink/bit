// error
// #6365: a static method called through a generic class's BARE name infers the
// class's type parameters from its arguments (SPEC 10.4.1, 15.3). A method that
// depends on a parameter no argument binds has no instantiation to name, so the
// call is E0068 naming the parameter and the written form; it is never accepted
// to fail at link time. A method that mentions no class parameter needs none
// (`tag`), and a written instantiation binds them itself.
class Pair<A, B> {
  a: A
  b: B

  init(first: A, second: B) {
    this.a = first
    this.b = second
  }

  static blank(first: A): Pair<A, B> {
    return Pair<A, B>(first, first)
  }

  static zero(): A {
    let z = []A(0)
    return z[0]
  }

  static tag(n: i64): i64 {
    return n
  }

  static make(first: A, second: B): Pair<A, B> {
    return Pair<A, B>(first, second)
  }
}

fn main() {
  let a = Pair.blank(1)
  let b = Pair.blank(first = 1)
  let c = Pair.zero()
  let d = Pair.make(first = 1, third = 2)
  let ok1 = Pair.tag(n = 1)
  let ok2 = Pair<i64, bool>.blank(2)
}
