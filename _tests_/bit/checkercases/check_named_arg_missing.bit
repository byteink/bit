// error
// #6121: a named-argument call that leaves a parameter with NO default
// unfilled (SPEC §12.11/§10.3) — E0171. `k` has no default, so naming only
// `nx` leaves it unfilled; the message names `k` directly, not just a count.
fn f(k: string, ttl: int = 0, nx: bool = false) {
  print("${k} ${ttl} ${nx}")
}

fn main() {
  f(nx = true)
}
