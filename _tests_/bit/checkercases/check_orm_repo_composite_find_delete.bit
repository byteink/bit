// error
// #7129: `Repo<T>.find`/`delete` take one id, so a composite key (two
// `@id` fields) is still E0180 there — while `update` on the same class is
// accepted (it matches every `@id` column, #6991): the `.expected` carries
// exactly two diagnostics, none for the `update` line.
// `compiler/checkormrepokey.bit`'s own key-count check; pkg/orm is imported by
// relative path as in check_orm_repo_no_single_key.bit.
import { FieldDesc, AttrDesc } from "std/sql"
import { open } from "../../../pkg/orm"

@table class Membership {
  @id
  userId: i64
  @id
  teamId: i64
  role: string
}

fn run(m: Membership): ()! {
  let members = open("postgres://x")?.table<Membership>()
  members.find(1)?
  members.update(m)?
  members.delete(1)?
}

fn main() {}
