// error
// #4011: pkg/web's `Ctx.jsonList<T: Jsonable>(xs: []T)` refuses a list whose
// ELEMENT is a class that was never marked `@json`. The mark is the consent
// that a type may be exposed (#3976) and it is what synthesizes the
// `toJson()` the bound requires, so an unmarked class fails the bound.
//
// The fix here is the opposite of the one check_json_list_scalar_element.bit
// needs: mark `Plain` with `@json`, rather than stop returning a list of it.
//
// The shape is reproduced rather than imported: a checkercase is checked
// standalone with the stdlib on the path, and pkg/web is not on it.
//
// PINS THE DIAGNOSTIC TEXT. E0051 used to name neither the type argument nor
// the bound it missed, so this case and check_json_list_scalar_element.bit
// rendered IDENTICAL text. #4521 made it name both plus the missing method.
import { Json } from "std/json"

interface Jsonable {
  toJson(): Json,
}

fn jsonList<T: Jsonable>(xs: []T): int {
  return len(xs)
}

class Plain {
  export id: i64,
}

fn main() {
  let ps: []Plain = []
  let n = jsonList(ps)
  println("${n}")
}
