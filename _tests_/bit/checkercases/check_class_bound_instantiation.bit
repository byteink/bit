// error
// #6428: a class type-parameter bound is judged at every WRITTEN instantiation,
// as a function's is at the call (SPEC 11.3). `Box<Plain>` and
// `Cache<StrStore>` are E0051 at the type argument, wherever the instantiation
// sits: an annotation, a literal's own type, a signature. A bare literal of a
// generic class infers its arguments from its field values and the siblings'
// bounds; a parameter neither decides is E0068 at the literal.
interface Named {
  label(): string,
}

interface Store<V> {
  get(k: string): V,
}

class Plain {
  v: i64,
}

class Tagged {
  v: i64,

  label(): string {
    return "t"
  }
}

class StrStore {
  pre: string,

  get(k: string): string {
    return this.pre + k
  }
}

class IntStore {
  base: i64,

  get(k: string): i64 {
    return this.base + len(k)
  }
}

class Box<T: Named> {
  inner: T,
}

class Cache<S: Store<i64>> {
  s: S,
}

class Pair<K, S: Store<K>> {
  store: S,
}

class Lonely<K> {
  v: string,
}

fn viaSignature(b: Box<Plain>): i64 {
  return 0
}

fn main() {
  let bad = Box<Plain>{ inner = Plain{ v = 1 } }
  let ok = Box<Tagged>{ inner = Tagged{ v = 1 } }
  let cache = Cache<StrStore>{ s = StrStore{ pre = "x" } }
  let fine = Cache<IntStore>{ s = IntStore{ base = 1 } }
  let inferred = Pair{ store = StrStore{ pre = "x" } }
  let gap = Lonely{ v = "x" }
}
