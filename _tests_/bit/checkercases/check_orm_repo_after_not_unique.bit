// error
// #6293: `Repo<T>.after(key)`'s FIRST `.orderBy(...)` must name a column
// carrying `@id`/`@unique` (`keysetPredicateForRepo`, pkg/orm/keyset.bit) —
// `checkOrmAfterCall` (compiler/checkormquery.bit) now catches a literal,
// non-unique sort column at compile time, the same way
// `check_orm_repo_bad_column.bit` catches a misspelled column. `email`
// below carries neither attribute.
import { Db } from "../../../pkg/orm"
import { Value } from "std/sql"

@table class Person {
  id: i64,
  email: string,
}

fn run(db: Db): ()! {
  db.table<Person>().orderBy("email").after(Value.Int(1)).limit(20)
}

fn main() {}
