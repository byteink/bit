// error
// SPEC §10.5, #6081: `__jobName` is reserved on EVERY class, `@job` or not
// -- mirrors `check_json_append_reserved.bit`'s E0164 reservation of
// `__jsonAppend` for the identical reason: dispatch code constrained on
// `interface Job { static __jobName(): string }` matches by name alone,
// so a same-named member on a class that never asked for `@job` would
// still satisfy that assertion and misbehave at the call site rather than
// at the assertion. `Widget` below carries no `@job` attribute at all.
class Widget {
  id: i64

  __jobName(): string {
    return "widget"
  }
}

fn main() {
  let w = Widget{ id = 1 }
  print("${w.id}\n")
}
