// fixture pins are exactly `el`/`kidFrom`/`kid`/`kids`, none of which is
// defined; every one must render at the element itself, not at its
// synthesized (past-EOF) position.
fn attr(name: string, value: string): string {
  return name
}
fn main() {
  let props = ["1", "2"]
  let x = <div a="1" b="2" {...props} />
}
