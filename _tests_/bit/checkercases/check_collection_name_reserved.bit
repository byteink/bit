// error
// SPEC §10.5, #6254: `__collectionName` is reserved on EVERY class, `@json`
// or not -- mirrors `check_job_name_reserved.bit`'s E0168 reservation of
// `__jobName` for the identical reason: `store.collection<T: Stored>()`
// matches `interface Stored { static __collectionName(): string }` by name
// alone, so a same-named member on a class that never asked for `@json`
// would still satisfy that assertion and misbehave at the call site rather
// than at the assertion. `Widget` below carries no `@json` attribute at all.
class Widget {
  id: i64

  __collectionName(): string {
    return "widget"
  }
}

fn main() {
  let w = Widget{ id = 1 }
  print("${w.id}\n")
}
