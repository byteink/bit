// error
// #4069: `Timestamp.ns` is `readonly` (SPEC §10.5) — `now()` is the only
// producer, so a caller assigning through it from a foreign module (this one
// never declares `Timestamp`, only imports `now`) must be rejected the same
// way any other `readonly` field is (see check_readonly_field_assign_foreign.bit
// for the general case). The general `readonly` mechanism itself is not
// retested here; this pins the specific field on the specific stdlib type.
import { now } from "std/time"

fn main() {
  now().ns = 5
}
