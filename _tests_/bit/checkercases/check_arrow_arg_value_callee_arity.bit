// error
// #4544: the arity guard on the VALUE-callee arrow seeding. `g` below is a
// function value, so `seedArrowExpectedValueCall` (compiler/checkarrow.bit)
// reads its parameter types off the callee's own `TypeKind.Func` type — but
// only when the member count equals the argument count. Here it does not: the
// call passes one argument to a two-parameter value, so which parameter the
// arrow matches is undecided and NOTHING is seeded.
//
// That is what this case pins. Seeding `members[0]` regardless would type `x`
// as `int` (the first parameter is `(int) => int`, not `(Thing) => int`), and
// `x.v()` would then add `error[E0057]: no field or method 'v' on this type`
// to the output below — a diagnostic the program does not deserve and the
// oracle does not have. E0050, and only E0050, is the correct answer to a call
// with the wrong number of arguments.
class Thing {
  n: int
  export v(): int { return this.n }
}

type Scale = (int) => int
type Read = (Thing) => int
type Two = (Scale, Read) => int

fn mkTwo(): Two {
  return (s, r) => {
    return s(1) + r(Thing{ n: 2 })
  }
}

fn main() {
  let g = mkTwo()
  println("${g((x) => x.v())}")
}
