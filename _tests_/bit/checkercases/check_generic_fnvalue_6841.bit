// error
fn identity<T>(x: T): T { return x }
fn unused<T, U>(x: T): T { return x }
fn variadic<T>(...xs: T): T { return xs[0] }
fn repeated<T>(x: T, y: T): T { return x }
interface Named { name(): string }
fn bounded<T: Named>(x: T): T { return x }
fn forwarded<T>(x: T): T {
  let f: (T) => T = bounded
  return f(x)
}
fn main() {
  let free = identity
  let missing: (int) => int = unused
  let conflict: (int, string) => int = repeated
  let bad: (int) => int = bounded
  let wrongReturn: (int) => string = identity
  let wrongArity: (int, int) => int = identity
  let wrongVariadic: (int) => int = variadic
  let indirect = forwarded(3)
  let _ = (free, missing, conflict, bad, wrongReturn, wrongArity, wrongVariadic, indirect)
}
