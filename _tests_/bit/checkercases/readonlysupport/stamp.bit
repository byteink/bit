// Support module for check_readonly_field_assign_foreign.bit (#4066): a
// class with an exported `readonly` field, imported from a different module
// than the one assigning to it. Not a case itself — checkerdiag.bit's
// manifest walk only reads names ending in '.bit' DIRECTLY inside
// checkercases/, so this nested file is invisible to the '// error' census.
export class Stamp {
  export readonly n: int,
}
