// error
// #6428: a bare literal of a generic class (`Lonely{ v = "x" }`) writes no type
// arguments. A declared target types it (an annotation, a parameter, a result, a
// field, an element), and otherwise its field values and the siblings' bounds
// do. A parameter none of them decides is E0068 at the literal, in EVERY
// position, never an IR verification failure at build. The targeted positions
// below are clean; the untargeted ones are E0068. A pinned literal's field values
// are judged against the PINNED instantiation exactly as `W<i8>{ v = 300 }`'s
// are: an out-of-range constant or a value of the wrong type is E0041.
class Lonely<K> {
  v: string,
}

class W<T> {
  v: T,
}

fn take8(w: W<i8>): i8 {
  return w.v
}

fn result8(): W<i8> {
  return W{ v = 300 }
}

class Holder {
  l: Lonely<i64>,
}

fn id<T>(x: T): T {
  return x
}

fn take(l: Lonely<i64>): i64 {
  return 0
}

fn result(): Lonely<i64> {
  return Lonely{ v = "x" }
}

fn main() {
  let annotated: Lonely<i64> = Lonely{ v = "x" }
  let viaArg = take(Lonely{ v = "x" })
  let field = Holder{ l = Lonely{ v = "x" } }
  let elems: []Lonely<i64> = [Lonely{ v = "x" }]
  let member = Lonely{ v = "x" }.v
  let generic = id(Lonely{ v = "x" })
  let untyped = [Lonely{ v = "x" }]
  let bound = Lonely{ v = "x" }
  let viaArg8 = take8(W{ v = 300 })
  let annotated8: W<i8> = W{ v = 300 }
  let elems8: []W<i8> = [W{ v = 300 }]
  let wrongType: W<i64> = W{ v = "x" }
  let fits = take8(W{ v = 100 })
}
