// error
// SPEC §10.5, #3879: an attribute's value is discarded, so the function it
// names must yield unit. E0134 is deliberately distinct from E0133 above it:
// `fn slug(s: string): i64!` DOES fail, and telling its author it "cannot
// fail" would send them to the wrong half of the signature.
//
// The E0067 above it is the desugaring's own fallout, kept rather than
// suppressed for the reason #3879 gives for E0116 and E0041: the synthesized
// `slug(this.handle) catch __attr_e { ... }` (#4572) catches an `i64!`, whose
// block must therefore produce an `i64`, and a synthesized block cannot. It
// underlines the attribute, never synthetic text, and suppressing it needs a
// "this subtree is synthesized" flag threaded through the validator.

fn slug(s: string): i64! {
  return 1
}

class C {
  @slug
  handle: string
}

fn main() {
  let c = C{ handle: "ok" }
  print("${c.handle}\n")
}
