// error
// SPEC §10.5, #3879: an attribute's value is discarded, so the function it
// names must yield unit. E0134 is deliberately distinct from E0133 above it:
// `fn slug(s: string): i64!` DOES fail, and telling its author it "cannot
// fail" would send them to the wrong half of the signature.
//
// ONE MISTAKE, ONE DIAGNOSTIC (#4583). The synthesized `slug(this.handle)
// catch __attr_e { ... }` (#4572) catches an `i64!`, so its block would have
// to produce an `i64` and a synthesized block never does: E0067 used to be
// printed above E0134, at the same `@slug`, for code the reader never wrote.
// classfieldattrbuild.bit now marks the nodes it builds (`compiler/ast.bit`'s
// `synth`) and `vCatchIncomplete` skips a marked block. A hand-written
// incomplete `catch` still reports E0067 -- see _tests_/cases/check_catch_incomplete.bit.

fn slug(s: string): i64! {
  return 1
}

class C {
  @slug
  handle: string
}

fn main() {
  let c = C{ handle: "ok" }
  print("${c.handle}\n")
}
