// error
// #6274: `Repo<T>`'s new `set(...)` (`pkg/orm/repo.bit`'s "soft delete and
// bulk writes" block) is a chain method already listed in
// `compiler/checkormquery.bit`'s own `ormChainMethodNames`/
// `ormColumnMethodNames` (#5060, for the old `Patch<T>.set`) - a
// string-literal column misspelled there is E0163 exactly like `where`
// (`check_orm_repo_bad_column.bit`), with no change to that file needed.
// `nmae` is misspelled "name" below.
import { Db } from "../../../pkg/orm"
import { AttrDesc, FieldDesc } from "std/sql"

@table class Person {
  id: i64,
  name: string,
}

fn run(db: Db): ()! {
  db.table<Person>().where("id", 1).set("nmae", "x")
}

fn main() {}
