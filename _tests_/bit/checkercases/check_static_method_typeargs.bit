// error
// #6379: explicit type arguments on a STATIC method call are counted against
// the method's own type parameters (E0058, SPEC 12.7, 15.3), as an instance call's
// are. `vMethodTypeArgCount` was reached only from `vMethodCall`, so
// `Box<i64>.make<i64, i64>(1)` for `make<U>` checked clean. Positional and named.
class Box<T> {
  v: T

  static make<U>(u: U): i64 {
    return 1
  }

  static zero(): i64 {
    return 0
  }

  inst<U>(u: U): i64 {
    return 1
  }
}

fn main() {
  let a = Box<i64>.make<i64, i64>(1)
  let b = Box.make<i64, i64, i64>(1)
  let c = Box<i64>.zero<i64>()
  let d = Box<i64>.make<i64, i64>(u = 1)
  let e = Box<i64>{ v = 1 }.inst<i64, i64>(1)
  let f = Box<i64>{ v = 1 }.inst<i64, i64>(u = 1)
  let ok1 = Box<i64>.make<string>("s")
  let ok2 = Box.make<string>("s")
  let ok3 = Box<i64>.zero()
  let ok4 = Box<i64>.make<string>(u = "s")
  let ok5 = Box<i64>{ v = 1 }.inst<string>("s")
}
