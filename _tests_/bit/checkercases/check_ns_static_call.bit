// error
// #6388: a static method reached through a namespace import, `m.K.f(...)`, is
// the spelling SPEC §11 gives a namespaced class everywhere a type name goes
// (`qual_type_name`, §17.2) and is judged like `K.f(...)` after `import { K }`:
// arity (E0050), each argument's type (E0041, positional and named), and an
// unexported method or class (E0046). `checkExprType` answers 0 for the
// namespace-qualified class, so `staticReceiverType` used to answer 0 for it
// too: the call checked clean for any arguments and the lowerer then stopped at
// E0092. A generic class has no namespace spelling for its type arguments, so
// a static that needs them is E0068 naming the imported-by-name spelling; one
// that needs none (`m.G.tag(1)`) is the template's own and stays legal.
import * as m from "./nsstaticsupport"

fn main() {
  let a = m.K.f("x", 1)
  let b = m.K.f(1)
  let c = m.K.own(1, "x")
  let d = m.K.f(b = "s", a = "t")
  let e = m.K.hidden(1)
  let f = m.Priv.f(1)
  let g = m.G.g(1, "s")
  let ok1 = m.K.f(1, "s")
  let ok2 = m.K.own("s", 1)
  let ok3 = m.K.f(b = "s", a = 2)
  let ok4 = m.G.tag(1)
}
