// error
// #6201/#6203: a `jsonSchema<T>()` inside a generic wrapper, called with NO
// explicit type argument. `T` sits in the RESULT alone (SPEC 15.3's general
// rule, E0068, #4560), so nothing infers it from the call's arguments --
// and `classjsonschemagenericretarget.bit`'s own unbound-T refusal
// (E0173) hands that diagnostic its reason (`adoptCannotInferHint`) instead
// of raising a second one for the same cause, mirroring #4592's
// `jsonDecode<T>` fix. ONE diagnostic, not two.
import { Json, jsonSchema } from "std/json"

fn wrap<T>(): Json {
  return jsonSchema<T>()
}

fn main() {
  let _ = wrap()
  print("done\n")
}
