// error
// #4013 (§18.3): the control for check_try_operand_not_fallible.bit — the
// SAME `plain()?` expression, but now the ENCLOSING function is also not
// fallible. E0061 (the enclosing-function rule) must fire alone; the new
// operand-not-fallible diagnostic must NOT also fire on the same node, or the
// two rules would be conflated into a double report of one `?`.
fn plain(): string { return "x" }

fn main() {
  let a = plain()?
  print(a)
}
