// error
// #4718: a tuple pattern whose initializer is not a tuple. `checkTupleBinders`
// (checkbind.bit) returned SILENTLY here, binding nothing and reporting
// nothing, so `bit check` exited 0 and only lowering refused the program --
// E0092 "cannot lower a tuple destructure whose right side is not a tuple",
// with no span and no way back to this line. That is how #4488 lost a build:
// a return type changed from `(string, string)` to a class and nine
// destructuring call sites were left behind, all of them silent.
//
// A class is not a tuple. Widening the destructure to read `Pair` positionally
// would have accepted the very mistake the lowerer caught, so this stays an
// error and names the type it was handed.
class Pair {
  a: string,
  b: string,
}

fn mk(): Pair {
  return Pair{ a: "x", b: "y" }
}

fn main() {
  let (p, q) = mk()
  print("${p} ${q}\n")
}
