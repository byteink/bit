// error
// #6344: a row slice stored into a struct field is read back through the
// field, so `for a of cache.latest { a.articles }` is not traced to the
// query by the flow walk. The error names the query that filled the field
// (line 26) and says to add `.with("articles")` THERE; the sibling that
// does add it (pkg/orm/relationauto.test.bit's `relAutoFillCache`) builds.
import { Db } from "../../../pkg/orm"
import { AttrDesc, FieldDesc } from "std/sql"

@table class Article {
  id: i64,
  authorId: i64,
}

@table class Author {
  id: i64
  @hasMany("authorId")
  articles: []Article
}

class Cache {
  latest: []Author,
}

fn fill(db: Db, cache: Cache): ()! {
  cache.latest = db.table<Author>().all()?
}

fn count(cache: Cache): int {
  let n = 0
  for a of cache.latest {
    n = n + len(a.articles)
  }
  return n
}

fn main() {}
