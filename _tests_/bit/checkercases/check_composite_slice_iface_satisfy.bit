// error
// #3061: interface satisfaction was never checked for a slice/array-literal
// ELEMENT. `vCompositeSlot` (compiler/validatezero.bit) called
// `vExpectExprNonIface`, which returns on an Interface-kind target, then
// `vIfaceStore`, the narrow "cannot store" scalar case — so a slice element
// that does not implement the slice's interface-typed element type was never
// checked. `bit check` exited 0, `bit build` produced a binary, and reading
// the element back dispatched through a nonexistent method slot.
interface Payer {
  pay(): i64
}

class Cash {
  n: i64,
}

fn main() {
  let cash = Cash{ n: 1 }
  let sl = []Payer{cash}
  print("${sl[0].pay()}\n")
}
