// error
// #5057: pkg/orm's find chain rejects a string-literal column that names no
// field of the class `find<T>` mapped, naming both. `email` is misspelled
// "emial" below; a computed (non-literal) column would compile instead,
// falling back to the runtime check `Query.columnFor` (pkg/orm/query.bit)
// always performs. Imports pkg/orm by RELATIVE PATH rather than the bare
// `"orm"` a released package uses (compiler/checkormquery.bit's
// `ormPathMatches` accepts both): pkg/orm carries no manifest yet, so a
// bare-name import has nothing for `bit.lock` to resolve.
import { Data, find } from "../../../pkg/orm"
import { FieldDesc, Rows, Value } from "std/sql"

class Person {
  id: i64,
  email: string,
}

fn personMapper(rows: Rows): Person! {
  return Person{ id: 1, email: "x" }
}

fn run(db: Data, fields: []FieldDesc): ()! {
  find<Person>(db, "people", fields, personMapper).where("emial", Value.Text("x"))
}

fn main() {}
