// error
// SPEC §10.5, #3976: `@key` takes exactly one STRING CONSTANT. #3879's grammar
// makes an attribute's argument list optional and its arguments ordinary
// expressions, so all three spellings below parse -- and each is its own
// diagnostic naming the attribute and the field, never a silent fallback to the
// field name, which would make a typo'd rename look like it worked.
//
// A bare `@key` and `@key()` are ONE case, not two: parseAttrArgs elides an
// empty argument list, so the two shapes are indistinguishable in the tree by
// design and there is nothing left to tell apart.
import { Json, JsonEntry } from "std/json"

@json class User {
  @key(1 + 2)
  a: i64
  @key
  b: i64
  @key("x", "y")
  c: i64
}

fn main() {
  let u = User{ a: 1, b: 2, c: 3 }
  print("${u.a}\n")
}
