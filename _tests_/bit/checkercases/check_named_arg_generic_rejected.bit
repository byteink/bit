// error
// #4687: a GENERIC callee and a GENERIC receiver reject a named argument with
// E0128, and SPEC §12.11 now says so. The normative text used to state the
// restriction as "the callee is a named function or method whose declaration
// is in scope", which a generic function and a generic class both satisfy —
// so the spec was wider than the compiler and neither #3839 nor #4323 owned
// the sentence.
//
// Pinned here rather than left to the prose: a reader who has just seen
// `serve(port = 3000)` and `Acct(fee = 5)` compile would expect these to, and
// widening either of them silently is exactly what this file exists to catch.
//
//  1. `pick(b = 1, a = 2)` — a generic FREE function. Its declared parameter
//     types still mention the open `T`, which is what `vNamedArgTypeCheck`
//     would compare the argument against — `T` itself, not the `i64` this
//     call instantiates it with.
//  2. `box.set(x = 1)` — a generic RECEIVER, the same reason through a
//     method declaration.
//  3. `shape.area(w = 3, h = 2)` — a TYPE-PARAM receiver. Second reason of
//     its own: the checker would read the CONSTRAINT interface's parameter
//     names while the call dispatches, after the generic is instantiated, to
//     the concrete implementation's — and an implementation matches an
//     interface by TYPE, not by parameter name (§14.3), so the two lists may
//     legally disagree.
//
// The CONCRETE spellings of the same three shapes are the control, and they
// are pinned by `_tests_/cases/run_named_args_method.bit` (#4323) rather than
// repeated here.

interface Shape {
  area(w: i64, h: i64): i64,
}

class Rect {
  scale: i64
  area(w: i64, h: i64): i64 {
    return this.scale * w * h
  }
}

class GBox<T> {
  v: T
  set(x: T): T {
    return x
  }
}

fn pick<T>(a: T, b: T): T {
  return a
}

fn measure<T: Shape>(shape: T): i64 {
  return shape.area(w = 3, h = 2)
}

fn main() {
  print("${pick(b = 1, a = 2)}\n")
  let box = GBox<i64>{ v: 0 }
  print("${box.set(x = 1)}\n")
  print("${measure<Rect>(Rect{ scale: 2 })}\n")
}
