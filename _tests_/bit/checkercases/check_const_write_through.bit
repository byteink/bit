// error
// #6497 (SPEC §11.11 rule 4): a `const` fixes the binding, not the object it
// refers to, as JavaScript `const`, Java `final` and C# `readonly` do. Writing a
// field, a map entry or a slice element through a const that holds a class, a
// map or a slice is ACCEPTED, for a module const and a function-local one. A
// const that holds a value type directly (an array) keeps its elements in the
// binding, so a write through it is E0062. Reassigning a module const is E0185;
// reassigning a local one is E0062 from the resolver, which stops the checker,
// so that half is check_const_write_through_local.bit.
class Inner {
  n: int,
}

class Config {
  retries: int,
  inner: Inner,
}

fn load(): Config {
  return Config{ retries = 3, inner = Inner{ n = 1 } }
}

const cfg: Config = load()
const table: map<string, int> = map<string, int>()
const names: []string = []string{ "a", "b" }
const K: [3]u8 = [3]u8{ 1, 2, 3 }

fn main() {
  cfg.retries = 4
  cfg.retries += 1
  cfg.retries++
  cfg.inner.n = 2
  table["a"] = 1
  names[0] = "z"
  K[0] = 9
  K[1]++
  K[2] += 1
  K[0:2][0] = 7
  cfg = load()

  const local: Config = load()
  const lmap: map<string, int> = map<string, int>()
  const lslice: []int = []int{ 1, 2 }
  const lk: [2]int = [2]int{ 1, 2 }
  local.retries = 5
  local.inner.n = 6
  lmap["a"] = 1
  lslice[0] = 9
  lk[0] = 9
  lslice[0:1][0] = 8
}
