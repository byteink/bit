// error
// SPEC §10.5, #5189: `@table`'s own argument, when present, must be a
// string LITERAL -- the compiler synthesizes `tableAttrs()` before any
// Checker exists (classtabledesc.bit's own header comment explains why),
// so it has no evaluator for a non-literal expression, even one that would
// obviously be a string at runtime.
import { FieldDesc } from "std/sql"

const cityName = "people"

@table(cityName) class User {
  id: i64,
}

fn main() {
  let u = User{ id: 1 }
  print("${u.id}\n")
}
