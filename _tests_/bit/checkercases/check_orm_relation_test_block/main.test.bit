test "reads the author directly" {
  let db = connect() catch e {
    assert(false, e.message())
    return
  }
  let p = loadPost(db) catch _ {
    assert(false, e.message())
    return
  }
  assert(len(p.author.name) == 3, "author")
}

test "reads the author in a closure" {
  let db = connect() catch e {
    assert(false, e.message())
    return
  }
  let read = () => {
    let p = loadPost(db) catch _ {
      return 0
    }
    return len(p.author.name)
  }
  assert(read() == 3, "author")
}
