// #6406: a relation read written inside a `test` block is judged like one in a
// function body. `loadPost` hands back a raw-SQL row (`Db.query<T>` has no
// `.with()`), so the reads in main.test.bit are unprovable: E0300 at `bit
// check`, not a run-time "read before it was loaded" panic.
import { Db, open } from "orm"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

export fn connect(): Db! {
  return open("postgres://localhost/none")?
}

export fn loadPost(db: Db): Post! {
  let rows = db.query<Post>("select * from post")?
  return rows[0]
}

fn main() {}
