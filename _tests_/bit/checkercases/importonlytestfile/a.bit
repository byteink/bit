// #5818: `newSha256` is imported only by `a.test.bit`, this module's other
// file — imports bind per module (§17.1), but a name bound only by a
// `.test.bit` sibling's import must still be rejected for a non-test file
// (checkerdiag.bit's `importonlytestfile` case).
import { encodeHex } from "std/crypto"

export fn digestName(): string {
  let h = newSha256()
  return encodeHex(h.sum())
}
