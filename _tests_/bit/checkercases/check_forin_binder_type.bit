// error
// #2162: `for v in xs { let y: string = v }` — the ROOT bug this ticket
// exists for, not merely the lowering gap. Before `typeForInBinder`
// (compiler/checkmatch.bit), the `in` binder was UNTYPED: `bit check` exited
// 0 silently on this exact program, where the analogous `for v of xs` form
// already reported this same E0041 correctly. This fixture pins the fix as
// a diagnostic so a regression here fails a gate instead of going quiet —
// "a guard that never fires may be dead code" (this repo's own
// verification-trap list).
//
// The rendered type is 'i64', not 'int': `int` is a source-level alias for
// `i64` (SPEC §11.1, `int=i64`), and the type system has exactly one
// canonical name for it — no diagnostic anywhere in this compiler ever
// renders the alias spelling, so this pins what it actually says rather than
// what a reader would expect.
//
// What must STAY legal, in the same file: the index binder used at its real
// type (`i64`), and a map's `in` binder assigned to its own key type.
fn main() {
  let xs = [10, 20, 30]
  for v in xs {
    let y: string = v
  }

  let total: i64 = 0
  for i in xs {
    total = total + i
  }
  println("${total}")

  let m = map<string, int>{ "a": 1 }
  for k in m {
    let k2: string = k
    println(k2)
  }
}
