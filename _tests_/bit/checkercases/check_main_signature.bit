// error
// #2236: both halves of §17.4's entry-point rule on one declaration, so the two
// diagnostics are pinned together and in order — the parameter rule ahead of the
// result rule, which is the order `vEntrySignature` emits them and SPEC §14.8
// makes normative.
//
// Measured before the rule, on brew 0.1.8 and on this tree:
//
//   function main(a: int, b: string)   rc=139, SIGSEGV. The second argument
//                                     register is dereferenced as a string
//                                     header, and it holds whatever was there.
//   function main(): string            rc=152 AFTER printing its output. The
//                                     returned string pointer flows into the
//                                     exit status and is truncated to 8 bits —
//                                     returning "x" instead of "done" exited
//                                     120. A program that did its job reported
//                                     failure with a number that means nothing.
//
// `bit check` exited 0 and printed nothing for both.
fn main(a: int, b: string): string {
  print("a=${a} b=[${b}]\n")
  return "done"
}
