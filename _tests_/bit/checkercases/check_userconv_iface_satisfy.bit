// error
// #3064: interface satisfaction was never checked for the `E(x)` user-type
// conversion syntax (SPEC §12.9, #1898). `vUserConversion`
// (compiler/validateiface.bit) called only `vIfaceStore` for an interface
// target, which rejects a non-storable SCALAR (E0041's narrow "cannot store"
// case) but never judges a storable class against the interface's method
// set — and there was no `vExpect*` fallback at all for this site. `bit
// check` exited 0, `bit build` produced a binary, and `Payer(cash).pay()`
// dispatched through the missing method's empty table slot: a segfault with
// no compiler diagnostic pointing at the cause.
//
// Two structs, same shape as check_call_arg_iface_satisfy.bit, so the two
// `.expected` messages are checked to differ: one has no `pay` method at
// all, the other has one with the wrong signature.
interface Payer {
  pay(): i64
}

class Cash {
  n: i64,
}

class Voucher {
  n: i64,

  pay(amount: i64): i64 {
    return this.n
  }
}

fn main() {
  let cash = Cash{ n: 1 }
  let voucher = Voucher{ n: 2 }
  let p1 = Payer(cash)
  let p2 = Payer(voucher)
  print("${p1.pay()}${p2.pay()}\n")
}
