// error
// #6677: every position that takes a `bool` and used to take a `bool!`
// unchecked: `while`, a `for` condition, `&&` and `||` operands (both sides), the
// operand of `!`, and a label of a subject-less `switch`. Each is E0041 `expected
// 'bool', found 'bool!'`. The handled spellings below each of them stay clean
// (_tests_/cases/run_fallible_handled_positions.bit runs them).
class Boom {
  message(): string { return "x" }
}

fn f(): bool! { fail Boom{} }

fn conds(ok: bool): ()! {
  while (f()) {
    break
  }
  for (let i = 0; f(); i += 1) {
    break
  }
  let a = ok && f()
  let b = f() || ok
  let c = !f()
  assert(a || b || c)
  switch {
    case f():
      return
  }
}

fn handled(ok: bool): ()! {
  while (f()?) {
    break
  }
  for (let i = 0; f() catch false; i += 1) {
    break
  }
  let a = ok && f()?
  let b = (f() catch true) || ok
  let c = !f()?
  assert(a || b || c)
  switch {
    case f()?:
      return
  }
}
