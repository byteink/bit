// error
// #4341's owner ruling: a payload-carrying enum compares structurally (§14.6)
// when every variant's payload is comparable. `Handler` below has one variant
// whose payload is a function value — never comparable — so the WHOLE enum is
// not comparable and `==` on it is a compile error naming the offending
// variant and payload type, not a silent fallback to identity.
//
// What DOES become legal (a payload enum whose payloads are all comparable) is
// pinned by run_enum_payload_eq.bit, not here.
enum Handler { None, Fn(() => int) }

fn main() {
  print("${Handler.None == Handler.None}\n")
}
