// error
// #6279: empty variadics bind V=(), which is not a sqlValue source.
// Check the composed calls before lowering, including sibling deduplication.
import { Value, sqlValue } from "std/sql"

fn boundArgs<V>(values: []V): []Value {
  let out = []Value(0)
  for v of values {
    out = append(out, sqlValue(v))
  }
  return out
}

fn exec<V>(...values: V): []Value {
  let _ = boundArgs(values)
  return boundArgs(values)
}

fn relay<V>(values: []V): []Value { return boundArgs(values) }
fn deeper<V>(...values: V): []Value { return relay(values) }

fn main() {
  let _ = exec()
  let _ = deeper()
}
