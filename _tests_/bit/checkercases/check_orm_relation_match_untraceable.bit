// error
// #6336: a match arm's payload binder traces to its own SCRUTINEE
// (compiler/relationautomatch.bit's `relationAutoMatchArmBinding`), but the
// scrutinee itself must still resolve to a real query for `.with()` to have
// anywhere to land. `maybePost`'s own two returns DISAGREE -- one reaches
// `db.table<Post>().first()?`, the other is a bare `Option.None` -- so
// `relationAutoMergeReturn` (compiler/relationauto.bit) collapses its
// return summary to "not found", and the `Some(post)` arm's own binder
// inherits that unresolved flow, same as any other untraceable source: E0300
// still fires.
import { Db } from "../../../pkg/orm"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn maybePost(db: Db, found: bool): Option<Post>! {
  if (found) {
    return db.table<Post>().where("id", 1).first()?
  }
  return Option.None
}

fn run(db: Db): ()! {
  match (maybePost(db, true)?) {
    Some(post) => print("${post.author.name}\n")
    None => print("not found\n")
  }
}

fn main() {}
