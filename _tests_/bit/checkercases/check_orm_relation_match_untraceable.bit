// error
// #6336: a match arm's payload binder traces to its own SCRUTINEE
// (compiler/relationautomatch.bit's `relationAutoMatchArmBinding`), and the
// scrutinee must resolve to a source whose rows load the relation.
// `maybePost`'s own two returns DISAGREE -- one reaches
// `db.table<Post>().where("id", 1).first()?`, the other is a bare `Option.None`
// -- so (#6373) its return is a holder with one writer per `return`
// (compiler/relationautoreturn.bit); `Option.None` holds no row, so the query is
// the only writer, and E0300 names it: adding `.with("author")` there builds.
import { Db } from "../../../pkg/orm"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn maybePost(db: Db, found: bool): Option<Post>! {
  if (found) {
    return db.table<Post>().where("id", 1).first()?
  }
  return Option.None
}

fn run(db: Db): ()! {
  match (maybePost(db, true)?) {
    Some(post) => print("${post.author.name}\n")
    None => print("not found\n")
  }
}

fn main() {}
