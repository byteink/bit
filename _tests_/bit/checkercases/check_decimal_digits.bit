// error
// #3981: a `decimal` holds a signed 128-bit mantissa, ~28 significant digits.
// A constant needing more is not representable, and that is the same E0041
// that rejects `300` for `u8` — one representability rule, not two. The
// 28-digit constant beside it is accepted and reports nothing.
//
// The last two lines pin the other half of §15.4: with NO annotation the
// default type applies, so `19.99` is an f64 and stays one.
fn main() {
  let wide: decimal = 1.234567890123456789012345678901
  let edge: decimal = 1.234567890123456789012345678
  let x = 19.99
  let y: i64 = x
  print("done\n")
}
