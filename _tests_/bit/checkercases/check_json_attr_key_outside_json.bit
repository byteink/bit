// error
// SPEC §10.5, #3976: `@key` on a field of a class that carries no `@json` is an
// error naming both. The mark renames a key in output that is never produced,
// and nothing else in the pipeline would ever look at it -- so accepting it
// would leave a reader believing a rename is in force that does not exist.
class Config {
  @key("db_url")
  dbUrl: string
}

fn main() {
  let c = Config{ dbUrl: "x" }
  print("${c.dbUrl}\n")
}
