// error
// #6025: the same gap as check_slice_lit_mixed_second.bit, one element later
// — `checkSliceLit` (checkbindexpr.bit) reads only element 0, so a mismatch
// anywhere past element 1 was equally invisible. `vSliceLitJoin`
// (validateexpr.bit) walks every element, not just the second.
fn main() {
  let x = [1, 2, "a"]
  print("${x[2]}\n")
}
