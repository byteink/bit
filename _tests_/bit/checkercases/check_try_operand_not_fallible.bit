// error
// #4013 (§18.3): postfix `?` requires a FALLIBLE operand. Nothing enforced
// that half of the rule — only that the ENCLOSING function is fallible
// (E0061, the sibling check_try_operand_not_fallible_control.bit). `plain()`
// returns a plain `string` that never fails, so `?` here always "succeeds" and
// silently unwraps to itself: a token a reader scans for as error handling
// that handles nothing.
fn plain(): string { return "x" }

fn main(): ()! {
  let a = plain()?
  print(a)
}
