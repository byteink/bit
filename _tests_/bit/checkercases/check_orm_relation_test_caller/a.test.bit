test "lonely reads the author" {
  let p = Post{ id = 1, authorId = 1, author = Author{ id = 1, name = "x" } }
  assert(lonely(p) == "x")
}

test "lonelier reads the author in a closure" {
  let f = () => {
    let p = Post{ id = 1, authorId = 1, author = Author{ id = 1, name = "x" } }
    assert(lonelier(p) == "x")
  }
  f()
}
