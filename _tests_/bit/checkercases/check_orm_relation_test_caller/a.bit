// #6373: `lonely` reads `p.author` off its parameter and the only call to it is
// in a `test` block (a.test.bit). A `test` block is not a caller -- it is not
// part of the package once another project imports it -- so no query's rows
// reach the parameter, and the hint says to call it from a function body.
@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

export fn lonely(p: Post): string {
  return p.author.name
}
