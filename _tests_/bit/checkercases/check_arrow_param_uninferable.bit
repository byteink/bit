// error
// #7383: an arrow parameter nothing types, whose body reads a member of it, is
// a checker error naming the annotation that fixes it. Lowering used to refuse
// it at E0092 while `bit check` passed. The same closure handed to a callee
// that declares its parameter type is typed by it, and the annotated one is
// typed by itself.
class Row {
  views: i64,
}

fn each(f: (Row) => bool): bool {
  return f(Row{ views = 1 })
}

fn main() {
  let bare = (r) => r.views < 100
  let given = each((r) => r.views < 100)
  let written = (r: Row) => r.views < 100
}
