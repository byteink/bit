// error
// #4336: `of` yields THE VALUE and a tuple binder splits it, so
// `for (a, b) of xs` over a `[]int` asks an `int` for two parts it does not
// have. This shape used to mean (index, element); that meaning moved to
// `for (i, x) in xs` (#4333), so it must be a checker error here rather than
// a silently untyped binding that only surfaces once the body reads it, or a
// spanless "cannot lower" refusal after a clean `bit check`.
//
// The second loop pins the arity half of the same rule: the element IS a
// tuple, but of a different arity than the binder names.
fn main() {
  let xs = [1, 2, 3]
  for (a, b) of xs {
    println("${a}${b}")
  }
  let pairs = [("a", 1), ("b", 2)]
  for (p, q, r) of pairs {
    println("${p}${q}${r}")
  }
}
