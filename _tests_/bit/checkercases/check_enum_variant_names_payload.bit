// error
// SPEC §14.7, #6987: `__variantName`/`__variants` are synthesized only for
// an enum whose variants ALL carry no payload. `Shape` has one payload
// variant, so neither exists on it and a call is the ordinary "no such
// method" error.
enum Shape { Unit, Circle(f64) }

fn main() {
  let s = Shape.Unit
  print("${s.__variantName()}\n")
}
