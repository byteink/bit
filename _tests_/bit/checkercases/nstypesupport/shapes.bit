// Support module for check_ns_type_value.bit (#6392): a class with a static
// method, an enum and a free function, all reached from another module through
// a namespace import (`import * as m`). Not a case itself — checkerdiag.bit's
// manifest walk only reads names ending in '.bit' DIRECTLY inside
// checkercases/, so this nested file is invisible to the '// error' census.
export class K {
  export a: i64

  init(a: i64) {
    this.a = a
  }

  export static mk(a: i64): K {
    return K(a)
  }

  export inst(a: i64): i64 {
    return a
  }
}

export enum E {
  A,
  B,
  C(i64),
}

export fn free(a: i64): i64 {
  return a
}
