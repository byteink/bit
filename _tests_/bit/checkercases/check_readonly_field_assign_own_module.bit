// error
// #4066: a `readonly` field rejects assignment from its OWN declaring
// module too — the guarantee must not hold only against foreign callers
// (SPEC §10.5). `t.n = 6` here is written in the very module that declares
// `Stamp`, not through any import (that half is
// check_readonly_field_assign_foreign.bit).
class Stamp {
  readonly n: int,
}

fn main() {
  let t = Stamp{ n: 5 }
  t.n = 6
}
