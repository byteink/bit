// error
// #6363: a construction call through a written instantiation is judged against
// the instantiated `init`. A name that binds no parameter is E0124, a missing
// one E0171, a wrong count E0050, an argument of the wrong type E0041, and a
// type-argument list whose length is not the class's own is E0058 (also on a
// class that is not generic). The same call with no type arguments written is
// E0058 too: nothing infers them, and the template's `init` is never emitted.
class Pair<A, B> {
  a: A
  b: B

  init(first: A, second: B) {
    this.a = first
    this.b = second
  }
}

class Plain {
  n: i64

  init(n: i64) {
    this.n = n
  }
}

fn main() {
  let a = Pair<i64, string>(third = 1, first = 2)
  let b = Pair<i64, string>(first = 1)
  let c = Pair<i64, string>(1, "a", 3)
  let d = Pair<i64, string>("a", 7)
  let e = Pair<i64, string>(second = 7, first = 1)
  let f = Pair<i64, string, bool>(7, "s")
  let g = Plain<i64>(3)
  let h = Pair(7, "s")
}
