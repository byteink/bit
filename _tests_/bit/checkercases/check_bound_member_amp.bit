// error
// #6431: a member call on a type parameter resolves against EVERY bound of an
// `&` list, not only the first. `s.label()` is declared by the SECOND bound, so
// it is typed `string` and `return s.label()` in an `i64` function is a type
// mismatch; it was typed `<error>`, which is compatible with everything, and the
// program ran and printed a string pointer as an i64. A name no bound declares
// is E0057 in the generic's own body, and so is a method two bounds declare with
// different signatures.
interface Named {
  label(): string,
}

interface Sized {
  size(): i64,
}

interface Text {
  label(): i64,
}

class A {
  n: i64

  label(): string {
    return "a"
  }

  size(): i64 {
    return this.n
  }
}

fn mismatch<S: Sized & Named>(s: S): i64 {
  return s.label()
}

fn nobound<S: Sized & Named>(s: S): i64 {
  return s.nope()
}

fn clash<S: Named & Text>(s: S): string {
  return s.label()
}

fn main() {
  println("${mismatch(A{ n = 1 })}")
}
