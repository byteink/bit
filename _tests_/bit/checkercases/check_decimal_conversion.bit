// error
// #3981: §12.9 conversions for the `decimal` scalar. `decimal(i)` from an
// integer is exact and `i64(d)` truncates toward zero, so both are accepted
// here and report nothing. Every float pairing is rejected in BOTH directions:
// f64 cannot represent 19.99, so `decimal(f)` would carry the float's error
// into a type whose whole purpose is not having one, and `f64(d)` would throw
// the exactness away with nothing at the call site saying so.
fn main() {
  let n: i64 = 7
  let f: f64 = 19.99
  let g: f32 = 1.5
  let d: decimal = 0
  let ok1 = decimal(n)
  let ok2 = i64(d)
  let bad1 = decimal(f)
  let bad2 = decimal(g)
  let bad3 = f64(d)
  let bad4 = decimal(0.1 + 0.2)
  print("done\n")
}
