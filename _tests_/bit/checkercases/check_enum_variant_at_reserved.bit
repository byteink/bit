// error
// SPEC §14.7, #7092: `__variantAt` is reserved on every payload-free enum; a
// hand-written member of that name is E0189 naming the enum and the member.
enum Color {
  Red
  Green

  static __variantAt(i: int): Color {
    return Color.Red
  }
}

fn main() {
  print("${Color.__variantAt(1).__variantName()}\n")
}
