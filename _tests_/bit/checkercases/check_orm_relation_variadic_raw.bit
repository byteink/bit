// error
// #6405: a relation read through a variadic parameter is proven by every
// argument that fills it, a positional row and a `...` spread alike. Rows from
// a query load the relation themselves; rows from raw SQL cannot, so E0300 lands
// on each argument and its hint names what works (`.with("author")` on a
// `db.table<Post>()` query), never a `.with` the raw query cannot take.
import { Db } from "../../../pkg/orm"
import { AttrDesc, FieldDesc } from "std/sql"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn names(...xs: Post): string {
  return xs[0].author.name
}

fn rawRows(db: Db): []Post! {
  let rows = db.query<Post>("select * from post")?
  return rows
}

fn viaTable(db: Db): string! {
  let rows = db.table<Post>().all()?
  return names(...rows)
}

fn viaRaw(db: Db): string! {
  let rows = rawRows(db)?
  return names(rows[0]) + names(...rows)
}

fn main() {}
