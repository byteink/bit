// error
// #4504: `vArrow` (compiler/validatecall.bit) now passes the arrow's own
// fallible expected result through as its body's fallible context, so `fail`
// inside an arrow written against `(T) => R!E` is legal. This pins the other
// half of that change: an arrow with NO fallible expectation still reports
// E0060, exactly as before.
//
// Two rows, the two ways an arrow can lack one: an expected function type
// whose result is not fallible, and no expected type at all (an arrow with
// annotated params in an unannotated `let` — nothing seeds arrowExpected, so
// `arrowExpectedResult` is 0).
//
// A checkercase and NOT an `// error` golden under _tests_/cases: that
// directory is selfhost-diffcheck.sh's corpus, and pinning the text here
// keeps this ticket's fixtures out of the differential's ledger entirely.
class Neg {
  n: i64
  message(): string { return "negative (${this.n})" }
}

type G = (i64) => i64

fn main() {
  let a: G = (n) => {
    if (n < 0) {
      fail Neg{ n: n }
    }
    return n
  }
  let b = (n: i64) => {
    if (n < 0) {
      fail Neg{ n: n }
    }
    return n
  }
  print("${a(1)} ${b(2)}\n")
}
