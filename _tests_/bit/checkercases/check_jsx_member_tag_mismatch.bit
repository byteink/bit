// error
// #5171: a mismatched closing tag on a JSXMemberExpression element -
// `jsxCheckTags` (parserjsx.bit) already compares the OPENING and CLOSING
// name's source text byte for byte (E0023), and `parseJsxTagName`'s merged
// `Tag.Member` span covers the whole dotted run unchanged, so `<Foo.Bar>` /
// `</Foo.Baz>` is rejected the same way a mismatched plain tag already is -
// no new diagnostic needed for the dotted case.
fn elem(tag: string, ...kids: string): string {
  return tag
}
fn text(s: string): string {
  return s
}
fn main() {
  let x = <Foo.Bar>hi</Foo.Baz>
}
