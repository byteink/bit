// error
// #6440 (SPEC §11.6): an arm64 `asm` payload containing `bl`/`blr` must declare
// every caller-saved register (x0-x17) and x30, which the call overwrites with
// the return address. `callLow` is `blr x8` (0xD63F0100) declaring only
// `{ x19, memory }`. The blocks after it declare the full set (spelled out, and
// by `callerSaved`) and a payload with no call, and must stay clean.
fn callLow(f: int): int {
  return asm {
    arm64 { 0xD63F0100 } // blr x8
    result arm64 x0 x64 rax : int
    input arm64 x8 x64 rdi = f
    clobber arm64 { x19, memory }
  }
}

fn callFull(f: int): int {
  return asm {
    arm64 { 0xD63F0100 } // blr x8
    result arm64 x0 x64 rax : int
    input arm64 x8 x64 rdi = f
    clobber arm64 {
      x0,
      x1,
      x2,
      x3,
      x4,
      x5,
      x6,
      x7,
      x8,
      x9,
      x10,
      x11,
      x12,
      x13,
      x14,
      x15,
      x16,
      x17,
      x30,
      memory,
    }
  }
}

fn callShorthand(f: int): int {
  return asm {
    arm64 { 0x94000001 } // bl +4
    result arm64 x0 x64 rax : int
    input arm64 x8 x64 rdi = f
    clobber arm64 { callerSaved, memory }
  }
}

// A payload with no `bl`/`blr` needs no clobbers: `mov x0, x6`.
fn noCall(f: int): int {
  return asm {
    arm64 { 0xAA0603E0 } // mov x0, x6
    result arm64 x0 x64 rax : int
    input arm64 x6 x64 rdi = f
  }
}

fn main() {
  println("${callLow(0)}${callFull(0)}${callShorthand(0)}${noCall(0)}")
}
