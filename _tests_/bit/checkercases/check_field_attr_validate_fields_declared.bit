// error
// SPEC §10.5, #3879: a class whose fields carry attributes already has a
// synthesized `validateFields()`, so declaring one is E0132 naming both. One
// name, one definition -- the alternative is a silent choice between the
// author's body and the compiler's, and either way half the calls disappear.
//
// Note this is NOT a rule about the name in general: a class with no attributed
// field may declare `validateFields` freely, because nothing synthesizes one.

fn slug(s: string): ()! {}

class C {
  @slug
  handle: string

  validateFields(): ()! {}
}

fn main() {
  let c = C{ handle: "ok" }
  print("${c.handle}\n")
}
