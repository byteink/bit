// error
// #6531: a module cell with no initializer holds the §13.4 zero value of its
// type, which the startup pass builds (#6481). A type with NO zero value (`Outer`
// has a class-typed field, `Pair` a member of one, `Shape` a first variant that
// carries a payload) has nothing to build, so the cell used to hold null and
// every read of it faulted. It is E0083 at the declaration, the verdict a
// function-local `let` gets. A `const` is given its value where it is declared:
// `const k: Outer` with none is E0086 (§10.1), and it checked clean before.
//
// The controls stay legal: `Inner` has a zero value, so a cell of it with no
// initializer is built at startup, and a `const` with an initializer is unchanged.
class Inner {
  n: int,
}

class Outer {
  inner: Inner,
}

enum Shape {
  Circle(f64),
  Unit,
}

let c: Outer
let p: (int, Outer)
let s: Shape
const k: Outer
const n: int
let fine: Inner
const made: Outer = Outer{ inner = Inner{ n = 1 } }

fn main() {
  print("${fine.n} ${made.inner.n}\n")
}
