// error
// #5173: JSXChildExpression's Expression is optional, but JSXAttributeValue's
// own `{ AssignmentExpression }` is NOT - `parseJsxBraced` (parserjsx.bit,
// the attribute-value path) still calls `parseExpr` unconditionally and never
// gained the empty-brace guard `parseJsxChildBraced` did, so `value={}` stays
// a compile error. Proves the widening stayed confined to the JSX CHILD
// position and did not reach the sibling attribute-value consumer of the
// same `{...}` syntax (#4412's precedent: a predicate widened for one
// consumer must not reach another).
fn elem(tag: string, ...kids: string): string {
  return tag
}
fn attr(name: string, value: string): string {
  return name
}
fn main() {
  let x = <input value={} />
}
