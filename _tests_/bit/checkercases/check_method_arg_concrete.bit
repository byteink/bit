// error
// #2755: a method call's arguments were never validated against the
// method's declared parameters — for ANY receiver — so a wrong-typed
// argument through a concrete class receiver passed `bit check` and
// `bit build` with exit 0, then SIGSEGV'd or read a string pointer as an
// integer at runtime, depending on which side of the mismatch it landed on.
class P { v: int 
  bar(x: int): bool {
    return x > 0
  }
}

fn main() {
  let q = P{v: 1}
  print("${q.bar("hello")}\n")
}
