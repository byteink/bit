// error
// #6329: `bit fmt` stripped the disambiguating parens from a parenthesized
// return value whose leading token is `{`. `canStartExpression`
// (compiler/parserstmt.bit) excludes `Kind.LBrace`, so a bare `return {}`
// parses as a value-less `return` followed by a stray block, never reaching
// `parsePrimaryExtra`'s bare-map-literal arm — `return ({})` is the only
// spelling that reaches it. This pins two things at once: `bit check`
// reports the ordinary element-type mismatch (E0041, a map literal where
// `string` is wanted) rather than a parse error, and — because this file
// lives under `_tests_/bit` — `test-fmt-roundtrip`'s AST round-trip and
// `test-fmt-testsbit`'s canonical-form check both hold the parens in place
// across a reformat.
fn ret(): string {
  return ({})
}

fn main() {
  print(ret())
}
