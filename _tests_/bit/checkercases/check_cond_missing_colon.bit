// error
// #3941: a malformed conditional with no `:` must produce a real diagnostic
// with a sensible span, not a parser crash or a confusing cascade.
//
// The postfix-`?`/conditional-`?` disambiguation (parsercond.bit's
// `looksLikeTernaryQuestion`) speculatively tries `<then> :` before treating
// `?` as the conditional's opener; finding no `:`, it rolls the speculative
// attempt back and falls through to the ORIGINAL reading — `true ?` is
// genuine (if nonsensical) postfix propagation on `true` — so the diagnostic
// names the token that is unexpected under THAT reading, `1`, rather than a
// missing `:`. Still one clean diagnostic, still a sensible span, no crash.
fn main() {
  let x = true ? 1
  print("${x}")
}
