// error
// #6256: `sqlValue<V>` where `V` is outside the closed set
// string/int/i64/bool/f64/[]byte/Option<> of one of those is a COMPILE
// error naming the type, never a runtime failure — the same "refused before
// it can return a wrong answer" contract `jsonDecode<T>`'s own E0145 takes.
import { sqlValue } from "std/sql"

class Plain {
  v: i64,
}

fn main() {
  let p = Plain{ v = 1 }
  sqlValue(p)
}
