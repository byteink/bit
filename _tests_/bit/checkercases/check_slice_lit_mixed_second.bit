// error
// #6025: a bare `[e1, e2, ...]` slice literal with no expected type was typed
// `[]E`, E the FIRST element's (defaulted) type, and nothing ever judged the
// rest. `let x = [1, "a"]` type-checked as `[]i64` and stored the string's
// pointer word through the `i64` slot: `x[1]` read back a garbage int, at
// exit 0. SPEC §15.2: the elements must all be identical, or all be untyped
// constants sharing a default type — `1` (default `i64`) and `"a"` (default
// `string`) are neither.
fn main() {
  let x = [1, "a"]
  print("${x[1]}\n")
}
