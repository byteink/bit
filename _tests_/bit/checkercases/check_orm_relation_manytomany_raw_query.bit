// error
// #6344: `@manyToMany` is a relation the compiler loads (or refuses) exactly
// like `@hasMany`/`@hasOne`/`@belongsTo` (`fieldRelationAttr`,
// compiler/classrelationattr.bit). A read of `tags` on a row from raw SQL
// (`Db.query<T>` has no `.with()`) cannot be proven loaded, so it is E0300 --
// never a silent empty list.
import { Db } from "../../../pkg/orm"
import { AttrDesc, FieldDesc } from "std/sql"

@table class Tag {
  id: i64,
  label: string,
}

@table class Article {
  id: i64
  title: string
  @manyToMany("article_tags")
  tags: []Tag
}

fn run(db: Db): ()! {
  let rows = db.query<Article>("select * from article")?
  print("${len(rows[0].tags)}\n")
}

fn main() {}
