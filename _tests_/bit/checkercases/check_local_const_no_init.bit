// error
// #6672: a function-local `const x: T` with no initializer is E0086 (§10.1: a
// `const` is given its value where it is declared), the verdict a module `const`
// got in #6531. The parser takes the form, and it used to check clean: a scalar,
// string or slice read as its zero value, and a class with no zero value was
// reported as E0083, which asked for an initializer the `const` form cannot take.
// The controls stay legal: a local `const` with its value, and a local `let` of a
// type with a zero value, which is built from it (§10.1).
class Inner {
  n: int,
}

class Outer {
  inner: Inner,
}

fn main() {
  const a: int
  const s: string
  const o: Outer
  const made: Outer = Outer{ inner = Inner{ n = 1 } }
  let fine: Inner
  let zero: int
  print("${a}${s}${o.inner.n}${made.inner.n}${fine.n}${zero}\n")
}
