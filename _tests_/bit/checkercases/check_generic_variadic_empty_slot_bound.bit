// error
// #4633: an EMPTY variadic slot does not leave a type parameter unbound —
// `genericTypeArgs` binds it to `()`, and Pass A2 emits the template against
// that. #4597 made such a gap silence, measured on bodies that only MEASURE the
// slice; a body that touches an ELEMENT then failed at lowering instead:
//
//     error[E0092]: cannot lower a call whose callee does not resolve to a
//     function --> joinAll's own body
//     note: while emitting 'joinAll<()>', instantiated here
//
// with `bit check` exiting 0 first. The silence is now owed to the type
// parameter's BOUND: `()` has no methods, so it satisfies none that names one,
// and the call is E0068 at the call site — where the fix, `joinAll<Tag>("-")`,
// can be written.
//
// `countOnly()` is the boundary and a deliberate behaviour change: its body
// never touches an element, so it ran on main, but `<T: Named>` is a promise
// `()` breaks whatever the body does with it. The rule is the declared bound,
// not a guess at what the body needs.
//
// The controls are the whole of the carve-out that must survive: an unbound
// type parameter (`each`), an EMPTY interface bound that `()` does satisfy
// (`anyOf`), explicit type arguments, and arguments that bind the element type
// normally. The .expected match is exact, so a third diagnostic fails this case.
interface Named {
  label(): string
}

interface Anything {}

class Tag {
  export label(): string {
    return "tag"
  }
}

fn joinAll<T: Named>(sep: string, ...xs: T): string {
  let s = ""
  for x of xs {
    s = s + x.label() + sep
  }
  return s
}

fn countOnly<T: Named>(...xs: T): int {
  return len(xs)
}

fn anyOf<T: Anything>(...xs: T): int {
  return len(xs)
}

fn each<T>(...xs: T): int {
  return len(xs)
}

fn main() {
  print("${joinAll("-")}\n")
  print("${countOnly()}\n")
  print("${joinAll<Tag>("-")}${joinAll("-", Tag{}, Tag{})}\n")
  print("${countOnly<Tag>()}${countOnly(Tag{})}${anyOf()}${each()}\n")
}
