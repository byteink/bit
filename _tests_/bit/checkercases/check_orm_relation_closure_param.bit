// error
// #6352: a closure reads a CAPTURED PARAMETER, which the flow walk cannot
// follow into a closure. The parameter is proven by what its callers pass
// (compiler/relationautoholder.bit, `holder:P`), so the error names the
// caller's query (line 29) and `.with("author")` THERE is the whole fix: the
// sibling that adds it (pkg/orm/relationauto.test.bit's
// `relAutoClosureParamName`) builds.
import { Db } from "../../../pkg/orm"
import { AttrDesc, FieldDesc } from "std/sql"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn show(post: Post): string {
  let read = () => post.author.name
  return read()
}

fn run(db: Db): string! {
  let post = db.table<Post>().find(1)?
  return show(post)
}

fn main() {}
