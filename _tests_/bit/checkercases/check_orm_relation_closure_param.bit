// error
// #6352/#6425: captured parameters inherit their callers' relation demands.
// Named queries auto-load them, but raw SQL cannot load the relation; the
// caller must use a named query with `.with("author")` instead.
import { Db } from "../../../pkg/orm"
import { AttrDesc, FieldDesc } from "std/sql"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn show(post: Post): string {
  let read = () => post.author.name
  return read()
}

fn run(db: Db): string! {
  let post = db.query<Post>("select * from Post where id = 1")?[0]
  return show(post)
}

fn main() {}
