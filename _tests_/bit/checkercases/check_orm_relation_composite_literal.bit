// error
// #6308 (R3, epic #6298): a composite literal that never sets the relation
// is unprovable by construction -- `Tag.CompositeLit` is not one of
// `relationAutoResolve`'s own handled tags (compiler/relationauto.bit), so
// `u.orders` cannot be proven loaded. Converted from
// `_tests_/cases/relation_unloaded_read_panics.bit` (#5271's own runtime
// panic for this exact program), which R3 turns into this build error
// instead -- the sibling `.bit` files this ticket left alone
// (relation_loaded_read_ok.bit, relation_loaded_empty_distinguishes.bit)
// assign the field before reading it and still compile.
import { FieldDesc, AttrDesc } from "std/sql"

class Order {
  id: i64,
}

@table class User {
  @id
  id: i64
  email: string
  @hasMany("userId")
  orders: []Order
}

fn main() {
  let u = User{ id = 1, email = "a@b.com" }
  print("${len(u.orders)}\n")
}
