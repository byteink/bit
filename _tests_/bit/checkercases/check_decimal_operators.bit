// error
// #3982: `vBinary`/`vIncDec` (validateoperator.bit) share `numericBinaryOk`,
// and `vBinary` now admits `decimal` for `+`/`-` alone (narrowly, via
// `isDecimalPrim`, ahead of that shared predicate) because `lowerDecimalBinary`
// (lowerdecimalarith.bit) has a case for exactly those two operators.
// `++`/`--` (`vIncDec`) and `*`/`/` (still `numericBinaryOk`'s plain int/float
// test) must keep refusing decimal after that widening, or a program `bit
// check` accepts would fail to lower — #4412's exact failure shape, one
// consumer of a shared predicate widened and the other not. `+`/`-`
// themselves report nothing, which is what proves the widening reached them.
fn main() {
  let d: decimal = 5.5
  let e: decimal = 2.25
  d++
  d--
  let p = d * e
  let q = d / e
  let s = d + e
  let t = d - e
}
