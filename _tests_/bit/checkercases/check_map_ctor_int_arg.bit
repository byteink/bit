// error
// #4065: `map<K,V>(...)` accepted and silently discarded ANY argument list —
// `map<i64,i64>(1500000)` type-checked clean and the argument had no effect
// at all on the constructed map (identical RSS and lowering to the bare
// `map<i64,i64>()` form). SPEC.md §11.2/§12.9 name exactly one legal form,
// `map<K,V>()`, with a map literal as the only way to seed entries — so a
// non-empty argument list is E0050, the same code every other wrong-arity
// constructor call in this file uses.
fn main() {
  let m = map<i64, i64>(1500000)
  m[1] = 7
  print("${len(m)}\n")
}
