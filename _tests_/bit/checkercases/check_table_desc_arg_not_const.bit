// error
// SPEC §10.5, #5051: a recorded attribute's arguments are constant
// expressions, the same restriction #3879 places on a CALLED attribute's
// arguments (SPEC §15.4) -- `pkg/orm` reads the rendered text at compile
// time and has no expression evaluator of its own, so a non-constant
// argument is rejected here rather than silently dropped.
import { FieldDesc } from "std/sql"

const suffix = "_v2"

@table class User {
  @check(suffix)
  email: string
}

fn main() {
  let u = User{ email: "a@b.com" }
  print("${u.email}\n")
}
