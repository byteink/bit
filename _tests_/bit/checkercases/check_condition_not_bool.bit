// error
// #6677 (§12: "no truthiness"): `cond ? a : b` always demanded a `bool`, but
// an `if`/`while`/`for` condition, a `&&`/`||` operand and the operand of `!`
// were never judged, so `if (n)` over an integer compiled and ran as a test
// for non-zero. All are E0041 now, like the conditional expression's.
fn conds(n: i64, s: string, ok: bool) {
  if (n) {
    return
  }
  while (s) {
    break
  }
  let a = ok && n
  let b = s || ok
  let c = !n
  assert(a || b || c)
  if (n != 0 && !ok) {
    return
  }
}
