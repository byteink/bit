// error
// #6308 (R3, epic #6298): a row captured by a closure is unprovable by
// design -- R1's own walk never descends into a nested `FuncDecl`/`ArrowFn`
// (compiler/relationauto.bit's own header), and this pass's own walk
// mirrors that exactly (compiler/relationautoerr.bit): the closure gets its
// own fresh, empty binding state, so the captured `post` is simply not
// found there, and `.author` must be refused rather than silently trusted.
import { Db } from "../../../pkg/orm"
import { AttrDesc, FieldDesc } from "std/sql"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn run(db: Db): ()! {
  let post = db.table<Post>().find(1)?
  let show = () => {
    print("${post.author.name}\n")
  }
  show()
}

fn main() {}
