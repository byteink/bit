// error
// #6275/#6277: `Repo<T>.link`/`unlink` (pkg/orm/repo.bit's own "// relations"
// block) check their string-literal SECOND argument against the class's OWN
// `@manyToMany` field names, the same E0163 `check_orm_repo_bad_column_set.bit`
// already gives `set`'s own first argument — `compiler/checkormquery.bit`'s
// `checkOrmLinkCall`. `tagz` is misspelled "tags" below.
import { Db } from "../../../pkg/orm"
import { AttrDesc, FieldDesc } from "std/sql"

@table class Tag {
  id: i64,
}

@table class Post {
  id: i64,
  @manyToMany("post_tags")
  tags: []Tag,
}

fn run(db: Db): ()! {
  db.table<Post>().link(Post{ id = 1, tags = []Tag(0) }, "tagz", [1])
}

fn main() {}
