// error
// SPEC §14.3, #7564: a top-level name that starts with `__` belongs to the
// compiler's synthesized code. A function, a class, an interface, an enum, a
// type alias, a `let`, a `const` and an import alias are each refused; a name
// inside a function body and an ordinary name are not.
import { join as __join } from "std/strings"

fn __helper(): int {
  return 1
}

class __Box {
  n: int,
}

interface __Shape {
  area(): int,
}

enum __Kind { A, B }

type __Id = i64

const __limit = 3

let __count = 0

fn fine(): string {
  let __local = 2
  return __join(["a", "${__local}"], ",")
}
