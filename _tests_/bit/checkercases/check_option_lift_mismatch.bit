// error
// #6566: the implicit `Some` lift (SPEC §14.2) only fires when the value fits
// the payload type, so an `Option<int>` still rejects a `string` at each of the
// four sites that allow the lift, with the same E0041 it always gave.
class Rec { n: Option<int> }

fn take(o: Option<int>) {}

fn give(): Option<int> {
  return "s"
}

fn main() {
  take("s")
  let r = Rec{ n = "s" }
  let l: Option<int> = "s"
}
