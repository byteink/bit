// error
// #4596: an arrow literal whose OWN type could not be inferred is judged
// against a DECIDED non-`Func` target, in the argument, binding and return
// positions alike. An unannotated parameter is seeded only from a
// `TypeKind.Func` expectation, so against `int` the arrow interns as
// `(<error>) => i64` and `vAssignable`'s mentions-invalid escape used to accept
// it everywhere: all three sites below checked clean and printed the closure's
// address as an `i64`.
//
// There is no inferred type to name on the found side, hence "found a function
// literal". The last rejection is the ANNOTATED arrow at the same argument
// position: its type IS inferred, so it must keep reporting through `vMismatch`
// with both type names — if the new rule ran ahead of that one, this line's
// wording would change.
//
// The three calls at the top of main() are the false-positive controls: a `Func`
// target seeds the parameter and decides nothing here, and a rigid type
// parameter is a real inference gap that must stay permissive. The .expected
// match is exact, so any of them appearing below fails this case.

type IntFn = (int) => int

fn one(x: int): int {
  return x
}

fn apply(f: IntFn): int {
  return f(1)
}

fn take<T>(v: T): int {
  return 1
}

fn ret(): int {
  return (y) => y + 1
}

fn main() {
  print("${apply((x) => x + 1)}\n")
  print("${take((x) => x + 1)}\n")
  let f: IntFn = (y) => y + 1
  print("${f(1)}\n")
  print("${ret()}\n")
  print("${one((x) => x + 1)}\n")
  let a: int = (y) => y + 1
  print("${a}\n")
  print("${one((x: int) => x + 1)}\n")
}
