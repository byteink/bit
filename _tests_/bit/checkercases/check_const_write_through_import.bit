// error
// #6497: a write through a const array is E0062 whichever way the const is
// named: imported by name, or reached as `ns.grid`. Only a function-local or
// same-module const root reached it before.
import { grid } from "./modconstsupport"
import * as consts from "./modconstsupport"

fn main() {
  grid[0] = 9
  consts.grid[1] = 8
  consts.grid[0]++
}
