// error
// #2248: a reserved word (SPEC §5.2) used as a function parameter name.
// #6264 retired the original pick here, `from`: it is CONTEXTUAL now (an
// ordinary identifier everywhere except right after an import_decl's body,
// SPEC §5.2), so it can no longer stand in for a genuinely reserved word.
// `in` (the for-loop keyword) replaces it as a natural range/iteration
// parameter name that is still reserved outright.
fn move(in: i64, out: i64): i64 { return out }

fn main() {}
