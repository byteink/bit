// error
// #6566: there is NO lift through `Option<Option<T>>` (SPEC §14.2): an `int`
// is not an `Option<Option<int>>`, though it is an `Option<int>`. The `Option`
// operand is the ordinary assignability rule and is not the lift's business.
fn take(o: Option<Option<int>>) {}

fn give(): Option<Option<int>> {
  return 5
}

fn main() {
  take(5)
  let l: Option<Option<int>> = 5
}
