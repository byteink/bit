// error
// #5973: `loadU64(p: *u8): u64` takes a `*u8` EXACTLY, not merely an
// integer-elemented pointer like the atomics accept -- it has no type
// parameter, so a wider pointee would read past the 8 bytes it promises.
// Two ways to fail: a non-pointer argument, and a pointer over the wrong
// element type (`ptrOf` on a `[]i64` yields `*i64`, not `*u8`).
fn main() {
  let a = loadU64(5)
  let xs: []i64 = [1, 2, 3]
  let b = loadU64(ptrOf(xs))
  print("${a}${b}\n")
}
