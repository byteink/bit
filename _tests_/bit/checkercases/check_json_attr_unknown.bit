// error
// SPEC §10.3.1, #3976: a CLASS attribute is COMPILER-KNOWN, not a name resolved
// by lookup. `@json` is the only one the language defines, so an unknown one is
// rejected by name here -- the opposite of a FIELD attribute (#3879), where
// `@emial` is deliberately the ordinary E0040 because that position DOES resolve
// through name lookup. Routing a class attribute through lookup instead would
// report `@jsn` as an undefined function nobody meant to call.
//
// `@json` takes no arguments either: per-field key names are `@key("...")` on
// the field, so an argument list here has nowhere to go.
import { Json, JsonEntry } from "std/json"

@jsn
class A {
  id: i64
}

@json("x")
class B {
  id: i64
}

fn main() {
  print("${A{ id: 1 }.id}\n")
}
