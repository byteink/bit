// error
// #3061: interface satisfaction was never checked for a plain `x = e`
// assignment. `vAssignIface` (compiler/validateiface.bit) called only
// `vIfaceStore`, which rejects a non-storable SCALAR (E0041's narrow "cannot
// store" case) but never judges a storable class against the interface's
// method set — and there was no `vExpect*` fallback at all for this site, so
// a class that simply does not implement the target interface was never
// checked. `bit check` exited 0, `bit build` produced a binary, and the
// reassignment overwrote the interface slot with a value whose method table
// does not have the dispatched method.
interface Payer {
  pay(): i64,
}

class Cash {
  n: i64,
}

class Voucher {
  n: i64

  pay(): i64 {
    return this.n
  }
}

fn main() {
  let p: Payer = Voucher{ n: 1 }
  p = Cash{ n: 2 }
  print("${p.pay()}\n")
}
