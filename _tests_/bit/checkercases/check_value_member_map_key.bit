// error
// SPEC §14.3, #7327: a map field has the value members only when its key is a
// string, integer, bool or payload-free enum. A float key has none, so the call
// is E0313 naming the field.
class Scores {
  id: string,
  byWeight: map<f64, int>,
}

fn main() {
  let a = Scores{ id = "s", byWeight = map<f64, int>{} }
  print(a.__valueHash())
}
