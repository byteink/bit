// error
// #6352: the element write goes through an ALIAS of the query's rows and the
// store is raw SQL, which no `.with()` can load. The read through `rows` is
// refused anyway: a store into any alias is a store into the query's rows.
import { Db } from "../../../pkg/orm"
import { AttrDesc, FieldDesc } from "std/sql"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn rawPost(db: Db): Post! {
  let rows = db.query<Post>("select * from post")?
  return rows[0]
}

fn show(db: Db): string! {
  let rows = db.table<Post>().with("author").all()?
  let alias = rows
  alias[0] = rawPost(db)?
  return rows[0].author.name
}

fn main() {}
