// error
// #7676: module-level state obeys the slice rule for `ptrOf` (#7644): a
// module-level slice of references (here `[]string`) holds headers the GC
// traces, not a buffer C can read, so it is refused with E0053 naming the
// element, exactly as a local one is.
let names: []string = ["a", "b"]

fn main() {
  let p = ptrOf(names)
  print("${len(names)}\n")
}
