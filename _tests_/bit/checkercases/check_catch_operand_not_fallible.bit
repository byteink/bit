// error
// #6846 (§18.3): `catch` requires a FALLIBLE operand, the same rule E0116 holds
// `?` to. `plain()` returns a plain `string` that never fails, so a handler on
// it can never run, and lowering would read an error slot nothing wrote. One
// row per position the checker lets a `catch` stand in, and per form
// (`e catch d`, `e catch x { ... }`), plus a fallible control that stays legal.
fn plain(): string { return "x" }

fn boom(): string! { return "y" }

fn useLet(): string {
  let a = plain() catch _ {
    ""
  }
  let b = plain() catch ""
  return a + b
}

fn useReturn(): string {
  return plain() catch _ {
    ""
  }
}

fn useArg() {
  print(plain() catch "")
}

fn useStmt() {
  plain() catch _ {
    return
  }
}

fn useArrow() {
  let f = () => plain() catch ""
  print(f())
}

fn useControl(): string {
  return boom() catch _ {
    ""
  }
}

fn main() {
  print(useLet() + useReturn() + useControl())
  useArg()
  useStmt()
  useArrow()
}
