// error
// #6566: the lift goes one way only. An `Option<int>` is still not an `int`
// (the diagnostic every other `Option` misuse gets), and a site that is not one
// of the four lift sites, a plain assignment, still rejects a bare `int`.
fn take(n: int) {}

fn main() {
  let o: Option<int> = Option.Some(1)
  take(o)
  let n: int = o
  let t: Option<int> = Option.None
  t = 5
}
