// error
// SPEC §10.5, #6081: `@job`'s argument must match `[a-z0-9._-]{1,63}` --
// the same safe character set a slug is, since the name is looked up as a
// queue-store key. A space-and-uppercase name and an empty one are E0166
// for two different reasons (an illegal byte, and too short), both caught
// by the same `jobNameValid` (compiler/classjobdesc.bit).
import { Json, JsonEntry } from "std/json"

@job("Send Welcome") @json class JobA {
  id: i64,
}

@job("") @json class JobB {
  id: i64,
}

fn main() {
  print("${JobA{ id = 1 }.id}\n")
}
