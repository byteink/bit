// error
// #6724 (§18.3): the hint on an unhandled fallible call offers `?` only where
// `?` is legal. In a non-fallible function, an arrow nothing expects a fallible
// result from, a `spawn { }` block or a `defer { }` block, `?` is E0061, so the
// hint says `catch` and names what `?` needs. A fallible function (or an arrow
// whose expected result is fallible) keeps the `?`-or-`catch` wording. The same
// rule holds for the E0041 mismatch (`let n: i64 = count()`), which shares the
// hint. A block inside a fallible function is still its own non-fallible arrow.
class Boom {
  message(): string { return "x" }
}

fn count(): i64! { fail Boom{} }
fn plain() {}

fn inFunction() {
  count()
}

fn inArrow() {
  let f = () => {
    count()
  }
  f()
}

fn inSpawn() {
  spawn {
    count()
  }
}

fn inDefer() {
  defer {
    count()
  }
}

fn inFunctionMismatch() {
  let n: i64 = count()
  print("${n}")
}

fn fallibleFunction(): i64! {
  count()
  return 1
}

fn fallibleMismatch(): i64! {
  let n: i64 = count()
  return n
}

fn fallibleArrow() {
  let f: () => ()! = () => {
    count()
  }
  f() catch e {
    print(e.message())
  }
}

fn spawnInFallible(): ()! {
  spawn {
    count()
  }
  plain()
}
