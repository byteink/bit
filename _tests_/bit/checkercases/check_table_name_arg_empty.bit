// error
// SPEC §10.5, #5189: `@table`'s own argument, when present, must be a
// non-empty string literal -- an empty override is no override at all, so
// it is rejected the same way a non-literal one is, rather than silently
// falling back to the default naming.
import { FieldDesc } from "std/sql"

@table("") class User {
  id: i64
}

fn main() {
  let u = User{ id: 1 }
  print("${u.id}\n")
}
