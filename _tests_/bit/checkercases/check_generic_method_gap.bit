// error
// #6393: a method's OWN type parameter that no argument binds is E0068, the
// free function's rule (SPEC 15.3, `vGenericGap`) for a method call. `mk<T>(n:
// i64): []T` mentions T in its result alone, so `K{}.mk(1)` bound it to
// nothing, `methodTypeArgs` filled it with void, and the program checked and ran
// with T instantiated at `()`. Static and instance, positional and named. Explicit
// type arguments bind it, and so does an empty variadic slot (`V.each()`), which
// binds nothing at run time either and stays silent like `each()` for a free fn;
// a BOUNDED parameter does not (`V.named()`, `()` satisfies no bound).
interface Named {
  label(): string,
}

class K {
  mk<T>(n: i64): []T {
    return []T(0)
  }

  static mk2<T>(n: i64): []T {
    return []T(0)
  }
}

class V {
  static each<T>(...xs: T): i64 {
    return len(xs)
  }

  static named<T: Named>(...xs: T): i64 {
    return len(xs)
  }
}

class G<R> {
  conv<U>(r: R): U {
    return U{}
  }
}

fn main() {
  let a = K{}.mk(1)
  let b = K.mk2(1)
  let c = K{}.mk(n = 1)
  let d = K.mk2(n = 1)
  let e = V.named()
  let f = G<i64>{}.conv(1)
  let ok1 = K{}.mk<i64>(1)
  let ok2 = K.mk2<string>(1)
  let ok3 = V.each()
  let ok4 = V.each(1, 2)
}
