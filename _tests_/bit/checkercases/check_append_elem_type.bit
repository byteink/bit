// error
// #6229: `append(dst, src)` where `src` is a slice of `dst`'s own element
// type type-checked and appended ONE garbage element built from `src`'s
// slice header, truncated to the element width — `append([]u8, []u8)`
// reported no error, built rc=0, and printed `len(dst) == 3`. SPEC §5.3 gives
// `append` exactly two admissible operand shapes (the element shape and,
// for a `[]u8` destination, the string-bytes shape); a `[]u8` operand fits
// neither, so it is the SAME E0041 an ordinary assignment would give for
// `let x: u8 = src`, not silence.
fn main() {
  let dst: []u8 = [u8(1), u8(2)]
  let src: []u8 = [u8(3), u8(4)]
  dst = append(dst, src)
  println("${len(dst)}")
}
