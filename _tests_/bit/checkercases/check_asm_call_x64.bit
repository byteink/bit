// error
// #6440 (SPEC §11.6): an x64 `asm` payload that may call out must declare every
// caller-saved register, because the callee destroys them and the allocator
// would otherwise keep a live value in one across the block. `callLow` is the
// #6434 shape: `call rdi` (FF D7) declaring only `{ rbx, memory }`; the
// operands `rdi` and `rax` pin are already excluded from the allocator, so the
// error names the rest. `callAfterOperand` is the other error: a real call
// after an instruction whose immediate is an E8 byte. Everything else must stay
// clean: the full set spelled out, `callerSaved`, a payload with no call, a
// payload whose E8 and FF D0 bytes are all operands, and a `@naked` stub whose
// call is its whole body.
fn callLow(f: int): int {
  return asm {
    x64 { 0xFF, 0xD7 } // call rdi
    result arm64 x0 x64 rax : int
    input arm64 x0 x64 rdi = f
    clobber x64 { rbx, memory }
  }
}

fn callFull(f: int): int {
  return asm {
    x64 { 0xFF, 0xD7 } // call rdi
    result arm64 x0 x64 rax : int
    input arm64 x0 x64 rdi = f
    clobber x64 { rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11, memory }
  }
}

fn callShorthand(f: int): int {
  return asm {
    x64 { 0xE8, 0x00, 0x00, 0x00, 0x00 } // call +0
    result arm64 x0 x64 rax : int
    input arm64 x0 x64 rdi = f
    clobber x64 { callerSaved, memory }
  }
}

fn noCall(f: int): int {
  return asm {
    x64 { 0x48, 0x89, 0xF8 } // mov rax, rdi
    result arm64 x0 x64 rax : int
    input arm64 x0 x64 rdi = f
    clobber x64 { rbx }
  }
}

// Every E8 and FF D0 below is an operand byte (ModRM, immediate, displacement),
// not a call; the decoder walks past each instruction by length, so none of
// them is a call and the block needs no caller-saved clobbers.
fn operandBytes(): int {
  return asm {
    x64 {
      0x48, 0x89, 0xE8,                                           // mov rax, rbp
      0xB8, 0xE8, 0x00, 0x00, 0x00,                               // mov eax, 0xE8
      0x66, 0xB8, 0xE8, 0xFF,                                     // mov ax, 0xFFE8
      0x48, 0x05, 0xE8, 0x00, 0x00, 0x00,                         // add rax, 0xE8
      0x48, 0x8B, 0x80, 0xE8, 0x00, 0x00, 0x00,                   // mov rax, [rax+0xE8]
      0x0F, 0xB6, 0x80, 0xFF, 0xD0, 0x00, 0x00,                   // movzx eax, byte [rax+0xD0FF]
      0x48, 0xB8, 0xE8, 0xFF, 0xD0, 0x00, 0x00, 0x00, 0x00, 0x00, // mov rax, imm64
    }
    result arm64 x0 x64 rax : int
  }
}

// The same E8 as a real operand, then a real `call rdi`: the decoder must stay
// in step with the instruction boundaries and still find it.
fn callAfterOperand(f: int): int {
  return asm {
    x64 { 0xB8, 0xE8, 0x00, 0x00, 0x00, 0xFF, 0xD7 } // mov eax, 0xE8 ; call rdi
    result arm64 x0 x64 rax : int
    input arm64 x0 x64 rdi = f
    clobber x64 { memory }
  }
}

@naked fn nakedStub(): int {
  return asm {
    x64 { 0xFF, 0xD0 } // call rax
    result arm64 x0 x64 rax : int
    input arm64 x8 x64 rax = entryOf(callFull)
  }
}

fn main() {
  println("${callLow(0)}${callFull(0)}${callShorthand(0)}${noCall(0)}${nakedStub()}${operandBytes()}${callAfterOperand(0)}")
}
