// error
// SPEC §10.5, #3976: a field whose type is a class WITHOUT `@json` is an error
// naming both the field and its type. Recursing into an unmarked class would
// defeat the opt-in -- the mark is the consent, and `Secret` never gave it.
import { Json, JsonEntry } from "std/json"

class Secret {
  token: string,
}

@json class User {
  id: i64,
  secret: Secret,
}

fn main() {
  let u = User{ id: 1, secret: Secret{ token: "t" } }
  print("${u.id}\n")
}
