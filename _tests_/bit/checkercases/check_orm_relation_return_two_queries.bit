// error
// #6373: `pick`'s two `return`s are two DIFFERENT queries, so `run`'s read
// `p.author` is proven only when both load 'author'. The first does; E0300 names
// the query of the second (`find(2)`), which does not, and adding `.with` to it
// builds.
import { Db } from "../../../pkg/orm"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn pick(db: Db, first: bool): Post! {
  if (first) {
    return db.table<Post>().with("author").find(1)?
  }
  return db.table<Post>().find(2)?
}

fn run(db: Db): string! {
  let p = pick(db, false)?
  return p.author.name
}

fn main() {}
