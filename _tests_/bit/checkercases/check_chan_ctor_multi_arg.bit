// `Tag.ChanType` node, so the generic call-argument path bails before ever
// visiting the argument list. `chan<i64>(1, 2, 3)` type-checked clean and
// ran, using 1 as the capacity and silently discarding the other two.
fn main() {
  let c = chan<i64>(1, 2, 3)
  print("ok\n")
}
