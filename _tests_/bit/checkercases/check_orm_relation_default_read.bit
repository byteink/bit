// error
// #6406: a parameter's default value is code too -- it runs at every call that
// omits the argument -- so a relation read written in one is judged like a read
// in the body. `mk()` builds a `Post` that never sets `author`, so the read in
// `d`'s default was a run-time "read before it was loaded" panic.

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn mk(): Post {
  return Post{ id = 1, authorId = 1 }
}

fn d(n: i64 = len(mk().author.name)): i64 {
  return n
}

fn main() {}
