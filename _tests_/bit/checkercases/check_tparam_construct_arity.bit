// error
// #6402 (SPEC §10.4.1): `T(...)` through a type parameter has no meaning: a
// bound is an interface and declares no `init`. It built and the program
// crashed; it is E0184, whatever the arguments are.
interface Api {
  static st(a: int, b: string): int,
}

class K {
  n: int
  init(a: int, b: string) {
    this.n = a * len(b)
  }
  static st(a: int, b: string): int {
    return a
  }
}

fn viaT<T: Api>(): int {
  return T(2).n
}

fn main() {
  print("${viaT<K>()}\n")
}
