// error
// #7970: exact slice element types and handled fallible conversions.
class Ref { value: int }
type Pair = [2]int
fn generic<T>(xs: []T) { let _ = [1]T(xs) }
@nosplit fn noAlloc(xs: []int) { let _ = [1]int(xs) }
fn invalid(xs: []int, narrow: []i32, refs: []Ref, strings: []string) {
  let _ = [1]int(7)
  let _ = [1]int(narrow)
  let _ = [1]Ref(refs)
  let _ = [1]string(strings)
  let unhandled = [1]int(xs)
  let _ = unhandled
  let _: [2]int = xs
  let _ = Pair(xs)
}
