// error
// #6677: the positions that consume a fallible call's value without a declared
// target to compare it with, each taking the `T!` for the `T` and dropping the
// error half: a for-of iterable, a member receiver, an index, a slice bound, a
// compound assignment's right-hand side, an unannotated `let`, a bare slice or
// map literal's element, a tuple literal bound by `let`, and a bare call
// statement. E0190 names the type and the fix. `let _ = f()` is the written
// discard and stays accepted, as do the `?` and `catch` spellings in `handled`.
// (`defer` and `spawn` of a fallible call are refused too, #6699:
// check_fallible_defer_spawn.bit.)
class Boom {
  message(): string { return "x" }
}

class K { v: i64 }

class W {
  go(): ()! { return }
}

fn n(): i64! { return 1 }
fn xs(): []i64! { return [1] }
fn kk(): K! { return K{ v = 1 } }
fn sink(x: i64) {}
fn keep<T>(x: T) {}

fn bad(a: []i64) {
  for x of xs() {
    sink(x)
  }
  sink(kk().v)
  sink(a[n()])
  sink(len(a[n():2]))
  let t = 0
  t += n()
  let u = n()
  let l = [n(), n()]
  let d = { "a": n() }
  let p = (n(), 1)
  keep(n())
  keep(u)
  keep(l)
  keep(d)
  keep(p)
  W{}.go()
}

fn handled(a: []i64): ()! {
  for x of xs()? {
    sink(x)
  }
  sink(kk()?.v)
  sink(a[n()?])
  sink(len(a[n() catch 0:2]))
  let t = 0
  t += n()?
  let u = n()?
  let l = [n()?, n() catch 0]
  keep(u)
  keep(l)
  let _ = n()
  let w = W{}
  w.go()?
  w.go() catch _ {}
}
