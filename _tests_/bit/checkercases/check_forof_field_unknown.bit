// error
// #4106: `for { a, b } of xs` — a for-of field pattern — over a slice whose
// element class does not declare one of the named fields. Unlike the
// positional pair binder there is no arity to satisfy or fall back to: each
// name is looked up directly against the element class, so a name it does
// not declare is an ordinary unknown-field mistake and must be a checker
// error (E0123), not a parse error and not a silent invalid-typed binding
// that would only surface once the loop body read it.
class Row {
  name: string,
  n: int,
}

fn main() {
  let xs = [Row{ name: "a", n: 1 }]
  for { name, missing } of xs {
    println("${name}${missing}")
  }
}
