// error
// SPEC §10.5, #6081: `@job`'s own argument is REQUIRED, unlike `@table`'s
// optional override (E0149/E0156) -- a job has no default dispatch name to
// fall back to, so both "none at all" and "not a string constant" are
// E0165, mirroring `@key`'s own arity/type check (E0140) one namespace
// over. Both classes here also carry `@json`, since `buildJobClass`
// (compiler/classjobdesc.bit) checks that precondition FIRST -- an
// unmarked class would report E0167 instead and never reach this check at
// all, which is exactly what check_job_requires_json.bit pins on its own.
import { Json, JsonEntry } from "std/json"

@job @json class JobA {
  id: i64,
}

@job(42) @json class JobB {
  id: i64,
}

fn main() {
  print("${JobA{ id = 1 }.id}\n")
}
