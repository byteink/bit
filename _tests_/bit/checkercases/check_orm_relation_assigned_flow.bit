// error
// #7920: conditional writes and replacement never prove an unloaded read.
import { Db } from "../../../pkg/orm"

@table class Author {
  @id
  id: i64
  name: string
}

@table class Post {
  @id
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

@table class User {
  @id
  id: i64
  @hasMany("userId")
  posts: []Post
}

fn falseMany() {
  let u = User{ id = 1 }
  if (false) {
    u.posts = []Post{}
  }
  print("${len(u.posts)}")
}

fn falseOne() {
  let p = Post{ id = 1, authorId = 7 }
  if (false) {
    p.author = Author{ id = 7, name = "Ada" }
  }
  print(p.author.name)
}

fn replacedMissing() {
  let p = Post{ id = 1, authorId = 7, author = Author{ id = 7, name = "Ada" } }
  p = Post{ id = 2, authorId = 8 }
  print(p.author.name)
}

fn replacedRaw(db: Db): ()! {
  let p = Post{ id = 1, authorId = 7, author = Author{ id = 7, name = "Ada" } }
  p = db.query<Post>("select * from post")?[0]
  print(p.author.name)
}

fn zeroLoop() {
  let p = Post{ id = 1, authorId = 7 }
  while (false) {
    p.author = Author{ id = 7, name = "Ada" }
  }
  print(p.author.name)
}

fn oneArm(o: Option<int>) {
  let p = Post{ id = 1, authorId = 7 }
  match (o) {
    Some(_) => { p.author = Author{ id = 7, name = "Ada" } }
    None => {}
  }
  print(p.author.name)
}

fn shadow(db: Db): ()! {
  let p = db.table<Post>().all()?[0]
  {
    let p = Post{ id = 2, authorId = 8 }
    print(p.author.name)
  }
  print(p.author.name)
}

fn consume(p: Post): string {
  return p.author.name
}

fn conditionalArgument() {
  let p = Post{ id = 1, authorId = 7 }
  if (false) {
    p.author = Author{ id = 7, name = "Ada" }
  }
  print(consume(p))
}

fn conditionalSummary(p: Post, b: bool): string {
  if (b) {
    p.author = Author{ id = 7, name = "Ada" }
  }
  return p.author.name
}

fn rawSummary(db: Db): ()! {
  print(conditionalSummary(db.query<Post>("select * from post")?[0], false))
}

fn bothArms(b: bool) {
  let p = Post{ id = 1, authorId = 7 }
  if (b) {
    p.author = Author{ id = 7, name = "Ada" }
  } else {
    p.author = Author{ id = 8, name = "Grace" }
  }
  print(p.author.name)
}

fn bothMatch(o: Option<int>) {
  let p = Post{ id = 1, authorId = 7 }
  match (o) {
    Some(_) => { p.author = Author{ id = 7, name = "Ada" } }
    None => { p.author = Author{ id = 8, name = "Grace" } }
  }
  print(p.author.name)
}

fn straightBlock() {
  let p = Post{ id = 1, authorId = 7 }
  {
    p.author = Author{ id = 7, name = "Ada" }
  }
  print(p.author.name)
}

fn currentRow() {
  let p = Post{ id = 1, authorId = 7 }
  p.author = Author{ id = 7, name = "Ada" }
  p = Post{ id = 2, authorId = 8, author = Author{ id = 8, name = "Grace" } }
  print(p.author.name)
  let u = User{ id = 1 }
  u.posts = []Post{}
  print("${len(u.posts)}")
}

fn preservedLoop() {
  let p = Post{ id = 1, authorId = 7 }
  p.author = Author{ id = 7, name = "Ada" }
  let i = 0
  while (i < 2) {
    print(p.author.name)
    p.author = Author{ id = 8, name = "Grace" }
    i++
  }
  print(p.author.name)
}

fn preservedZeroLoop() {
  let p = Post{ id = 1, authorId = 7 }
  p.author = Author{ id = 7, name = "Ada" }
  while (false) {
    p.author = Author{ id = 8, name = "Grace" }
  }
  print(p.author.name)
}

fn loopRowReplacement() {
  let p = Post{ id = 1, authorId = 7, author = Author{ id = 7, name = "Ada" } }
  let i = 0
  while (i < 2) {
    print(p.author.name)
    p = Post{ id = 2, authorId = 8 }
    i++
  }
}

fn preservedRowLoop() {
  let p = Post{ id = 1, authorId = 7 }
  p.author = Author{ id = 7, name = "Ada" }
  let i = 0
  while (i < 2) {
    print(p.author.name)
    p = Post{ id = 2, authorId = 8, author = Author{ id = 8, name = "Grace" } }
    i++
  }
  print(p.author.name)
}

fn main() {}
