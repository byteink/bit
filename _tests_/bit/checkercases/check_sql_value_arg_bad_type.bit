// error
// #6280: a call argument at a parameter declared exactly `std/sql` `Value`
// (here `...values: Value`, never an explicit `sqlValue(...)` call — that
// shape is check_sql_value_bad_type.bit's) is coerced through the same
// closed set `sqlValue` accepts; a class outside it is E0177, naming the
// class, exactly as an explicit `sqlValue(p)` would report.
import { Value } from "std/sql"

class Plain {
  v: i64,
}

fn f(...values: Value) {}

fn main() {
  let p = Plain{ v = 1 }
  f(p)
}
