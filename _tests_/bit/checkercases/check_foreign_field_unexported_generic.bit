// error
// #4631, the instantiation half. A generic body is checked ONCE against its
// own rigid type params, so `vMember` returns at `vRecvTypeUnjudgeable` for
// `v.hi` here — correctly: no member table is keyed against a bare `T`, and
// judging one would reject every generic in the repo. Without a second look
// the visibility rule would simply not exist inside a generic, and
// `fn peek<T>(v: T)` would be a way to read any module's private fields.
//
// `vInstMember` (validateinst.bit, #4627) is that second look: once the
// instantiation `T = UUID` is recorded it re-runs the SAME
// `vForeignFieldAccess` on the substituted receiver, which is why the code,
// message, hint and span here are the ones a directly-typed receiver gets
// (check_foreign_field_unexported.bit) rather than a parallel wording.
//
// The span is inside the generic's own body, where the reader wrote it.
import { uuidV4 } from "std/uuid"

fn peek<T>(v: T): int {
  return int(v.hi)
}

fn main() {
  println("${peek(uuidV4())}")
}
