// error
// #4104: shipped 0.5.0 silently accepted `[]T(sliceLiteral)` — the slice
// VALUE (its own address) was read as the requested length/capacity, so
// `string([]byte([ch]))` allocated garbage rather than a 1-byte slice. The
// checker hole that let this through was #4091's; this fixture is the
// regression guard for the exact reported form so it can never silently
// return.
fn main() {
  let ch = byte(65)
  let s = string([]byte([ch]))
  print("${len(s)}\n")
}
