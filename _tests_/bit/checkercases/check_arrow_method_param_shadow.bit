// error
// #3029: an UNANNOTATED arrow parameter at a METHOD-call site — the one shape
// `seedArrowExpectedCall` could not seed an expected type for before this fix
// (a bare-ident free-function callee only) — was left completely untyped.
// The arrow's own inferred function type then carried an invalid parameter,
// which `vAssignable`'s "an invalid mention is undecidable, not an error"
// safety rule swallowed silently: `bit check` exited 0 with no diagnostics,
// and the program was only rejected later, by lowering, as
// `E0092: cannot lower a '.' field access`. #2947 had already stopped a
// resolved-but-untyped arrow parameter from picking up a WRONG type through
// the flat env; this is the residual case where nothing typed it AT ALL.
//
// `r` here shadows the outer `let r: Widget`, of a completely different type
// than `each`'s declared `(int) => int` parameter — so `r.x` inside the arrow
// is a field access on an `int`, which has no fields.
class Widget {
  x: int,
}

class Box {
  items: []int,

  each(f: (int) => int): int {
    let sum = 0
    for it of this.items {
      sum = sum + f(it)
    }
    return sum
  }
}

fn main() {
  let r: Widget = Widget{x: 1}
  let b = Box{items: [1, 2, 3]}
  let total = b.each((r) => r.x)
  println("${total}")
}
