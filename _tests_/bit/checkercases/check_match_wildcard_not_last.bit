// error
// #2294: a `_` wildcard arm written anywhere but last was accepted with no
// diagnostic before this landed, and would have reached `lowerMatch`'s
// per-arm `variantOrdinal` lookup with a name that is not a real variant — the
// spanless-lowering-crash shape this repo has hit before (#2106, #2238,
// #2571). `_` must be the LAST arm (§13.8).
enum Color { Red, Green, Blue }

fn label(c: Color): string {
  match (c) {
    Red => return "red"
    _ => return "?"
    Green => return "green"
  }
}

fn main() { println(label(Color.Red)) }
