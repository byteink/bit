// error
// SPEC §10.5, #3879: an attribute reports by FAILING, so the function it names
// must be fallible. E0133 names the attribute and the field, which the
// desugaring's own fallout does not, and it is now the ONLY line here: #4572
// turned the synthesized `slug(this.handle)?` into `slug(this.handle) catch
// __attr_e { ... }`, and a `catch` on a non-fallible operand is not a
// diagnostic of its own, so the E0116 cascade this case used to pin -- true of
// source nobody wrote -- is gone with it.

fn slug(s: string) {}

class C {
  @slug
  handle: string
}

fn main() {
  let c = C{ handle: "ok" }
  print("${c.handle}\n")
}
