// error
// SPEC §10.5, #3879: an attribute reports by FAILING, so the function it names
// must be fallible. E0133 names the attribute and the field, which the
// desugaring's own fallout does not -- the E0116 above it is that fallout,
// true of the synthesized `slug(this.handle)?` and pointing at source nobody
// wrote, which is the whole reason E0133 exists.

fn slug(s: string) {}

class C {
  @slug
  handle: string
}

fn main() {
  let c = C{ handle: "ok" }
  print("${c.handle}\n")
}
