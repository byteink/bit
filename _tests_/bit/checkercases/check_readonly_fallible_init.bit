// error
// #7065: imported init nodes belong to the declaring module's tree.
import { FallibleStamp, InfallibleStamp } from "./readonlysupport"

fn main() {
  let fallible = FallibleStamp(1) catch _ {
    return
  }
  fallible.n = 2
  let alias = fallible
  alias.n = 3
  let infallible = InfallibleStamp(4)
  infallible.n = 5
}
