// error
// #4634: a generic METHOD's type arguments were never checked against their
// declared bounds. `vGenericBound` returned unless the callee was a bare
// `Tag.Ident`, so only a free generic reached the rule; the byte-identical
// program with the generic moved into a class body exited `bit check` 0 and
// died at lowering with E0092 ("cannot lower a member access that is neither a
// field nor a method") — the check/build divergence class (#1430), reported at
// the wrong layer and at a span inside the class body rather than at the call
// that chose the argument.
//
// The free-function twin is `_tests_/cases/check_generic_bound_violation.bit`,
// whose `.expected` pins this same E0051 text. Both now come out of one
// judgement (`vArgViolatesBound`, compiler/validategeneric.bit), which is also
// what `vInstBoundsViolated` asks, so the three cannot drift.
interface Ord {
  less(other: Self): bool,
}

class Plain {
  export v: i32
}

// The permissiveness control: `Sharp` DOES satisfy `Ord`, and every call below
// that passes one must stay silent. Without it a rule that reported every
// bounded method call would pass this case just as well.
class Sharp {
  export w: i32
  export less(other: Sharp): bool {
    return this.w < other.w
  }
}

class Holder {
  k: int
  export mx<T: Ord>(a: T, b: T): T {
    if (a.less(b)) {
      return b
    }
    return a
  }
}

// A generic RECEIVER as well. The parser merges `U` in FRONT of the method's
// own `T` (parserdecl), so the reported index is load-bearing here: `T` is
// entry 1 of the declaration's merged list and argument 0 of what the caller
// wrote. Reporting entry 1 would name a type argument this call never spelled.
class Bag<U> {
  u: U
  export pick<T: Ord>(a: T, b: T): T {
    if (a.less(b)) {
      return b
    }
    return a
  }
}

fn f() {
  let h = Holder{ k: 0 }
  let bad = h.mx(Plain{ v: 1 }, Plain{ v: 2 })
  let good = h.mx(Sharp{ w: 1 }, Sharp{ w: 2 })
  let g = Bag<int>{ u: 0 }
  let badOnGeneric = g.pick(Plain{ v: 3 }, Plain{ v: 4 })
  let goodOnGeneric = g.pick(Sharp{ w: 3 }, Sharp{ w: 4 })
}
