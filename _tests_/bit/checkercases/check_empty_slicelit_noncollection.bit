// error
// #6026: an EMPTY `[]` slice literal against a KNOWN, non-slice expected
// type used to pass `bit check` clean and fail only at lowering (E0092,
// "cannot lower a slice literal whose target type is not a slice") — the
// literal's OWN inferred type is invalid (`checkSliceLit`, checkbindexpr.bit,
// answers `0` for zero elements), which used to trip `vExpectExpr`'s SAFETY
// RULE meant for a real inference gap. But the target here is fully known
// and not a slice, so no element type could ever make it one; that is
// decidable without inferring the literal at all. One E0041 per context
// `vExpectExpr` pushes an expectation into: a function argument, a `let`
// annotation, a `return`, and a struct field initializer.
class Box {
  v: string,
}

fn take(s: string) {}

fn ret(): string {
  return []
}

fn main() {
  take([])
  let x: string = []
  let b = Box{ v = [] }
  println(ret() + x + b.v)
}
