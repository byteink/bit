// error
// #7842: `@nonblocking` is the one attribute an `extern fn` takes (SPEC §11.7)
// and takes no arguments; any other attribute, or an argument, is E0077.
@nonblocking extern fn fine(x: f64): f64
export @nonblocking extern fn fineToo(x: f64): f64
@inline extern fn other(x: f64): f64
@nonblocking(1) extern fn withArg(x: f64): f64
