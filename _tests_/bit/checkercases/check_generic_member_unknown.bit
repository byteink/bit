// error
// #4627: a `.` member access whose receiver is a bare type parameter used to
// type-check at rc=0 and be refused only by the lowerer, once per
// instantiation, as E0092 ("cannot lower a `.` field access on a receiver that
// is not a class or interface") — the check/build divergence class (#1430),
// reported at the wrong layer and at a span inside a generic the reader may
// not own.
//
// `vMember` (compiler/validatemember.bit) must stay silent there: it judges by
// ABSENCE, and no member table is ever keyed against a rigid `T`, so judging an
// unsubstituted type parameter would reject every generic body in the repo.
// `vInstMember` (compiler/validateinst.bit) instead re-runs the identical
// judgement once an instantiation has substituted a concrete receiver — the
// member-access twin of `vInstIndex`, which #2391 added for indexing.
//
// The primary message is `vMember`'s, byte for byte. The HINT is what the
// instantiated case adds and needs: the span points inside the generic body,
// where "this type" names nothing the reader can act on, so the hint carries
// the substituted type — the same way E0052 and E0073 already name theirs from
// `validateinst.bit`.
fn get<T>(v: T): int {
  return v.n
}

class Dog {
  name: string
  export label(): string {
    return this.name
  }
}

// The edit-distance suggestion survives substitution: `Dog` really does have a
// `label`, and the hint says so after naming the type that was substituted in.
fn speak<T>(v: T): string {
  return v.labl()
}

fn main() {
  let a = get(7)
  let b = speak(Dog{ name: "rex" })
  print("${a}${b}\n")
}
