// error
// #7380: a lexer error after a JSX element with a text child is reported
// once. `jsxResync` (parserjsx.bit) re-lexes the file's tail from the end of
// the text run and used to report every lexer diagnostic in that tail a
// second time.
fn elem(tag: string, ...kids: string): string {
  return tag
}
fn text(s: string): string {
  return s
}
fn main() {
  let a = <a>x</a>
  let z = 'ab'
}
