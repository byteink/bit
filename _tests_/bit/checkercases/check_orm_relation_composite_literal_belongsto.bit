// error
// #6308 (R3, epic #6298): the `@belongsTo` (bare-class) half of
// check_orm_relation_composite_literal.bit. Converted from
// `_tests_/cases/relation_unloaded_read_panics_belongsto.bit` (#6290's own
// runtime panic for this exact program), which R3 turns into this build
// error instead -- the sibling relation_loaded_read_ok_belongsto.bit
// assigns `p.author` before reading it and still compiles.
import { FieldDesc, AttrDesc } from "std/sql"

@table class Author {
  @id
  id: i64
  name: string
}

@table class Post {
  @id
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn main() {
  let p = Post{ id = 1, authorId = 7 }
  print("${p.author.name}\n")
}
