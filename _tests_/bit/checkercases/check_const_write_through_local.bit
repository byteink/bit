// error
// #6497 (SPEC §11.11 rule 4): the write through a function-local `const` that
// holds a class is accepted, but reassigning the const itself is E0062. The
// resolver reports it and stops the checker, so only the reassignment shows.
class Config {
  retries: int,
}

fn load(): Config {
  return Config{ retries = 3 }
}

fn main() {
  const local: Config = load()
  local.retries = 5
  local = load()
}
