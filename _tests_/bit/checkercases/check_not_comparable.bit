// error
// #2123: §14.6's comparability rule was not applied to comparison operands at
// all, so every type the spec calls NOT comparable compiled and answered
// `false` — a slice, a map, a function value, and (at the time) EVERY
// payload-carrying enum — while `false < true` answered `true` though §14.6
// grants ordering to numerics and strings only.
//
// #4341 narrowed the enum case: a payload enum is comparable STRUCTURALLY when
// every variant's payload is, so `State` below carries a genuinely
// non-comparable payload (a function value) rather than the `string` this
// fixture used to use — `Cancelled(string)` is legal to compare now, and that
// case is pinned by run_comparable_ok.bit instead.
//
// What must STAY legal is pinned by run_comparable_ok.bit, not here.
// Single-file golden: no prelude, so this cannot name `Option`.
enum State { Draft, Cancelled(() => int) }

fn f(x: int): int { return x }

fn main() {
  let s1 = [1, 2]
  let s2 = [1, 2]
  print("${s1 == s2}\n")
  print("${s1 < s2}\n")
  print("${State.Draft == State.Draft}\n")
  let m1 = map<int, int>()
  let m2 = map<int, int>()
  print("${m1 == m2}\n")
  let g = f
  let h = f
  print("${g == h}\n")
  print("${false < true}\n")
  print("${s1 == nil}\n")
}
