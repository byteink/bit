// error
// #3839: a named argument on a call through a function VALUE (SPEC §12.11's
// DIRECT CALLS ONLY restriction) — E0128. `func_type` carries parameter
// TYPES only, never names, so there is nothing `port` could resolve against
// once `serve` is read out of a binding rather than called by its own name.
fn serve(port: int, tls: bool) {
  print("${port} ${tls}\n")
}

fn main() {
  let f = serve
  f(port = 3000, tls = true)
}
