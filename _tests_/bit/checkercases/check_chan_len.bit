// error
// #2021: `len(ch)`/`cap(ch)` typechecked and then refused to lower, with a
// message naming no span, no code and not even the builtin — the shape epic
// #2185 tracks (check exits 0, build refuses). SPEC §16.2 enumerates only
// send, receive, close and range as channel operations, and §11.2 annotates
// 'len'/'cap' on Slice alone — a channel was never in the domain. The gap was
// the checker: `checkCall` (checkexpr.bit) typed `len`/`cap` to i64 for ANY
// argument, while the lowerer (`lowerLen`, lowerprim.bit) already recognized
// only slice/array/string/map and refused everything else. What must STAY
// legal, in the same file: len/cap on a slice, len on a fixed array, a map
// and a string.
fn main() {
  let c = chan<int>(4)
  c <- 1
  println("${len(c)}")
  println("${cap(c)}")
  let s: []int = [1, 2, 3]
  let arr = [3]int{1, 2, 3}
  let m = map<string, int>()
  m["a"] = 1
  let str = "hello"
  println("${len(s)}=${cap(s)}=${len(arr)}=${len(m)}=${len(str)}")
}
