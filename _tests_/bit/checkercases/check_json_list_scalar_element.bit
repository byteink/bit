// error
// #4011: pkg/web's `Ctx.jsonList<T: Jsonable>(xs: []T)` refuses a list of
// SCALARS. `[]i64` is rejected not because i64 is unfinished but because a
// JSON response body is a marked class or a list of them — a handler
// returning a bare JSON number where a client expects an object is a silent
// contract break, so it is a compile error instead.
//
// The shape is reproduced here rather than imported: a checkercase is checked
// standalone with the stdlib on the path, and pkg/web is not on it.
//
// PINS THE DIAGNOSTIC TEXT. E0051 used to name neither the type argument nor
// the bound it missed, so this case and check_json_list_unmarked_element.bit —
// two different mistakes with two different fixes — rendered IDENTICAL text.
// #4521 made it name both plus the missing method; the difference between the
// two .expected files is what holds that fix in place.
import { Json } from "std/json"

interface Jsonable {
  toJson(): Json,
}

fn jsonList<T: Jsonable>(xs: []T): int {
  return len(xs)
}

fn main() {
  let ns: []i64 = []
  let n = jsonList(ns)
  println("${n}")
}
