// error
// SPEC §10.5, #3976: a class carrying `@json` that also declares `toJson` is an
// error naming both, exactly as #3879 refuses a class that declares
// `validateFields` itself. Letting the hand-written one win silently means
// adding `@json` appears to work while changing nothing -- and an app that
// wants different output writes a second class (`@json class UserView`), which
// is strictly better anyway: a generated `toJson` on `User` would ship a new
// field the day someone adds one.
import { Json, JsonEntry } from "std/json"

@json class User {
  id: i64

  toJson(): Json {
    return Json.JsonNull
  }
}

fn main() {
  let u = User{ id: 1 }
  print("${u.id}\n")
}
