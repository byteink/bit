// error
// #5287: a block-bodied arrow's `return` was never checked against a call
// argument's fallible target at all. `vArrow` (compiler/validatecall.bit)
// set the return-position target to 0 (permissive) for a fallible
// expectation and never judged it against anything; `checkArrowFnAt`
// (compiler/checkexpr.bit) built the arrow's OWN type identical to the
// expectation by construction, so the outer call-argument check was
// vacuously true too. `register((c) => { return "wrong" })` against
// `Handler = (Ctx) => Res!` built clean where the seed reports E0041 — the
// wrongly-accepted value later read as a `Res` behind an interface segfaults
// (proven by hand against the ticket's repro, not a checkercase: a
// checkercase cannot observe a runtime crash).
//
// `takeForwarder` below is the false-positive control: #4504's forwarding
// sugar (`return boom(n)` inside a fallible arrow forwards the failure
// without re-wrapping it as ok, the same shape `run_arrow_fallible.bit`'s
// `fwdBlk` pins) must not regress into a new false E0041. It must not appear
// in .expected.
class Ctx {}
class Res {
  code: int,
}
type Handler = (Ctx) => Res!

class Neg {
  n: i64
  message(): string { return "negative (${this.n})" }
}

fn boom(n: i64): i64! {
  if (n < 0) {
    fail Neg{ n = n }
  }
  return n
}

fn register(h: Handler) {
  print("registered")
}

type Forwarder = (i64) => i64!

fn takeForwarder(f: Forwarder) {
  print("taken")
}

fn main() {
  register((c) => {
    return "wrong"
  })
  takeForwarder((n) => {
    return boom(n)
  })
}
