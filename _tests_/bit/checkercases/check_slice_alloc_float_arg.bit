// error
// #4091: same gap as check_slice_alloc_string_arg.bit, with a float length
// argument instead — `isIntegerOperand` (checkexpr.bit) correctly excludes
// float types, so a length like `1.5` is rejected the same way a string or
// bool is.
fn main() {
  let x = []i64(1.5)
  print("${len(x)}\n")
}
