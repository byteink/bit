// error
// #4718: a TUPLE initializer whose arity is not the pattern's -- the second of
// `checkTupleBinders`'s two silent returns (checkbind.bit), and the one that
// survives a refactor that keeps the shape and changes the count. Both
// directions are the same rule: more names than parts leaves the extras bound
// to whatever the enclosing scope last gave them, fewer drops the tail.
//
// The diagnostic names both counts, because "arity mismatch" without them
// sends the reader to count elements in another file.
fn pair(): (i64, string) {
  return 7, "hi"
}

fn main() {
  let (a, b, c) = pair()
  print("${a} ${b} ${c}\n")
  let (d) = pair()
  print("${d}\n")
}
