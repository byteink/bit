// error
// SPEC "jsonSchema<T> - a JSON Schema for a `@json` class", #6166/#6168:
// `jsonSchema<T>` where `T` is not a class carrying `@json` is a COMPILE
// error naming the type and the mark, never a runtime failure — the same
// four ways to be wrong `jsonDecode<T>`'s own E0145 refuses
// (check_json_decode_type.bit), one diagnostic each.
import { jsonSchema } from "std/json"

class Plain {
  v: i64,
}

enum Colour {
  Red,
  Blue,
}

fn main() {
  let a = jsonSchema<Plain>()
  let b = jsonSchema<Colour>()
  let c = jsonSchema<i64>()
  let d = jsonSchema()
  print("${a}${b}${c}${d}\n")
}
