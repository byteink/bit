// error
// SPEC §10.3.1, §10.5, #5189: `@table` takes AT MOST ONE argument -- a
// table-name override. A second argument is rejected at the position that
// defines the legal set (parserdecl.bit's `checkClassAttrs`), the same way
// any argument at all on `@json` is.
import { FieldDesc, AttrDesc } from "std/sql"

@table("people", "extra") class User {
  id: i64
}

fn main() {
  let u = User{ id: 1 }
  print("${u.id}\n")
}
