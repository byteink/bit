// error
// #4562: `sameNominalDecl` (compiler/checkinst.bit) compared only kind, name
// and declaring module, so `Hold<i64>` satisfied a declared `Hold<f64>` and
// `bit check` exited 0 on every line below. The payload word was then written
// at i64 and read back at f64: the program ran to exit 0 and printed a
// denormal -- a silent wrong answer, reached through a binding, an argument, a
// return and a class field alike.
//
// SPEC 14.2: a value of type S is assignable to a location of type T only when
// S and T are identical, T is an interface S satisfies, S is an untyped
// constant representable in T, or S is `nil`. Two instantiations of one
// declaration at DIFFERENT type arguments are none of those.
//
// The `ok*` lines carry the accept half deliberately, in this same file: they
// must emit NOTHING, and the byte comparison of the whole rendered stderr is
// what proves it. An untyped constant takes its type from the context (SPEC
// 15.4), so `Hold.Only(7)` fits a declared `Hold<f64>` even though the checker
// mints `Hold<i64>` for it from the argument's DEFAULT type -- that is #4519's
// `annot-f64` pin held from the checker's side, and the reason narrowing this
// rule cannot be a bare type-argument comparison.
enum Hold<T> { Only(T), Empty }

class Cell<T> {
  export v: T,
}

fn take(h: Hold<f64>): bool {
  match (h) {
    Only(_) => return true
    Empty => return false
  }
}

fn make(n: i64): Hold<f64> {
  return Hold.Only(n)
}

fn main() {
  let n: i64 = 7
  let bind: Hold<f64> = Hold.Only(n)
  let arg = take(Hold.Only(n))
  let field: Cell<f64> = Cell<i64>{ v: n }
  let held = Cell<i64>{ v: n }
  let alias: Cell<f64> = held
  let okConst: Hold<f64> = Hold.Only(7)
  let okSame: Hold<i64> = Hold.Only(n)
  let okFloat: Hold<f64> = Hold.Only(7.5)
  println("${arg}${field.v}${alias.v}")
  show(bind)
  show(okConst)
  show(okFloat)
  match (okSame) {
    Only(v) => println("${v}")
    Empty => println("empty")
  }
}

fn show(h: Hold<f64>) {
  match (h) {
    Only(v) => println("${v}")
    Empty => println("empty")
  }
}
