// error
// #6263: a defaulted parameter's default-value type check (E0041, SPEC
// §10.3) on a method of a GENERIC class — `vParamDefaults` (validatefuncdecl.bit)
// reads the declaration's own param list directly, unaffected by the arity
// relaxation bug #6263 fixed, so this must already reject `word`'s
// mismatched default exactly as it does for a non-generic class's method.
class Box<T> {
  x: int
  export tag(n: int, word: string = 5): Box<T> {
    print(word)
    return this
  }
}

fn main(): ()! {
  let b = Box<int>{ x = 0 }
  b.tag(5)
}
