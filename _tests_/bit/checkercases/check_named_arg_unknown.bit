// error
// #3839: a named argument at a call site (SPEC §12.11) naming a parameter
// `serve` does not declare — E0124, distinct from every other named-argument
// rejection so the message always names the actual mistake.
fn serve(port: int, tls: bool) {
  print("${port} ${tls}\n")
}

fn main() {
  serve(port = 3000, host = "x")
}
