// Support module for check_ns_static_call.bit (#6388): a class with static
// methods, a class that is not exported, and a generic class, all reached from
// another module through a namespace import (`import * as m`). Not a case
// itself — checkerdiag.bit's manifest walk only reads names ending in '.bit'
// DIRECTLY inside checkercases/, so this nested file is invisible to the
// '// error' census.
export class K {
  export static f(a: i64, b: string): i64 {
    return a
  }

  export static own<U>(u: U, n: i64): U {
    return u
  }

  static hidden(a: i64): i64 {
    return a
  }
}

class Priv {
  static f(a: i64): i64 {
    return a
  }
}

export class G<T> {
  export static g(a: T, b: string): T {
    return a
  }

  export static tag(n: i64): string {
    return "tag"
  }
}
