// error
// #3842 step F: a class composite literal's `field_init` used to accept `:`
// alongside `=`; only `=` parses now, and the diagnostic must name it
// (parserlit.bit's `reportFieldInitColon`). `map_entry`'s `:` is a different
// production (SPEC §12.2) and is unaffected -- the map literal below must
// still compile clean in the very same file.
class Point { x: int, y: int }

fn main() {
  let p = Point{ x: 1, y = 2 }
  let m = map<string, int>{ "a": 1, "b": 2 }
  print("${p.x} ${m["a"]}\n")
}
