// error
// SPEC §10.5, #6254: `@collection`'s own argument, when present, must be a
// non-empty string literal -- an empty override is no override at all, so
// it is rejected the same way `@table`'s own E0156 (check_table_name_arg_
// empty.bit) rejects one, rather than silently falling back to the default
// naming.

@json @collection("") class User {
  id: i64,
}

fn main() {
  let u = User{ id = 1 }
  print("${u.id}\n")
}
