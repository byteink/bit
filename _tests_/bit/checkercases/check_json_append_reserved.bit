// error
// SPEC §10.5, #5991: `__jsonAppend` is reserved on EVERY class, not only a
// `@json` one -- pkg/web's planned `JsonAppender` interface assertion
// (#5979's design) matches the method by name alone, so a same-named method
// of the wrong shape on a class that never asked for `@json` would still
// satisfy that assertion and misbehave at the call site rather than at the
// assertion.
class Widget {
  id: i64

  __jsonAppend(out: []byte): []byte {
    return out
  }
}

fn main() {
  let w = Widget{ id = 1 }
  print("${w.id}\n")
}
