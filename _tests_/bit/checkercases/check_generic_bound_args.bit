// error
// #6396: a generic interface bounds a type parameter with its type arguments
// written, `S: Store<i64>`, and a bound may name a sibling type parameter,
// `S: Store<T>` (SPEC 11.3). A type argument whose methods disagree with the
// bound AT THOSE ARGUMENTS is E0051 at the call, naming the method whose type
// disagrees: against a fixed `Store<i64>`, against `Store<T>` once `T` is given
// or inferred from another argument, through a generic that forwards its own
// parameters (judged where it is instantiated), and in any position of an `&`
// list.
interface Store<T> {
  get(key: string): T,
}

interface Named {
  label(): string,
}

class IntStore {
  base: i64
  get(key: string): i64 {
    return this.base + len(key)
  }
}

class StrStore {
  pre: string
  get(key: string): string {
    return this.pre + key
  }
  label(): string {
    return "strs"
  }
}

fn twice<S: Store<i64>>(s: S): i64 {
  return s.get("a") + s.get("b")
}

fn load<T, S: Store<T>>(s: S, k: string): T {
  return s.get(k)
}

fn pick<T, S: Store<T>>(x: T, s: S): T {
  return s.get("k")
}

fn second<S: Named & Store<i64>>(s: S): string {
  return s.label()
}

fn forward<T, S: Store<T>>(s: S): i64 {
  let n: i64 = load<i64, S>(s, "k")
  return n
}

fn main() {
  let a = twice(StrStore{ pre = "p" })
  let b = load<string, IntStore>(IntStore{ base = 1 }, "k")
  let c = pick(5, StrStore{ pre = "p" })
  let d = forward<string, StrStore>(StrStore{ pre = "p" })
  let e = second(StrStore{ pre = "p" })
  println("${a} ${b} ${c} ${d} ${e}")
}
