// error
// #6567: the `?` of `for x of it? { }` promises that a failed `next()` leaves
// the loop. On an iterable whose `next()` cannot fail (a slice, or a
// `next(): Option<T>` class) that exit never happens, so the `?` is a compile
// error rather than a silent no-op.
class Counter {
  n: i64
  next(): Option<i64> {
    if (this.n <= 0) {
      return Option.None
    }
    this.n = this.n - 1
    return Option.Some(this.n)
  }
}

fn sum(xs: []i64): i64! {
  let total: i64 = 0
  for x of xs? {
    total = total + x
  }
  return total
}

fn count(c: Counter): i64! {
  let total: i64 = 0
  for x of c? {
    total = total + x
  }
  return total
}

fn main() {}
