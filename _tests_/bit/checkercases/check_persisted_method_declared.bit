// error
// SPEC §10.5, #5052: a `@table` class cannot declare `isPersisted` itself —
// `@table` already synthesizes it as a hidden-flag accessor, the same rule
// `tableDescriptor` (E0148) and `tableAttrs` (E0157) take, and a DIFFERENT
// diagnostic than naming the slot as a plain field
// (check_persisted_field_declared.bit): a hand-written method that silently
// won would make the real accessor invisible to `pkg/orm`.
import { FieldDesc } from "std/sql"

@table class User {
  id: i64

  isPersisted(): bool {
    return true
  }
}

fn main() {
  let u = User{ id = 1 }
  print("${u.id}\n")
}
