// error
// #5060: pkg/orm's update chain rejects a string-literal column that names
// no field of the class `update<T>` mapped — the same E0163
// `compiler/checkormquery.bit` already raises for `find<T>` (#5057), now
// also recognising `update<T>`/`deleteMany<T>` as chain roots. `phoen` is
// misspelled "phone" below.
import { Data, update } from "../../../pkg/orm"
import { FieldDesc, Value } from "std/sql"

class Person {
  id: i64,
  phone: string,
}

fn run(db: Data, fields: []FieldDesc): ()! {
  update<Person>(db, "people", fields).where("id", Value.Int(1)).set("phoen", Value.Text("x"))
}

fn main() {}
