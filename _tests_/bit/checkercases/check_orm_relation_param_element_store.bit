// error
// #6366: the element form of check_orm_relation_param_store.bit. `p[0] =
// other` replaces one row of the parameter's rows with a row from a query that
// does not load `author`, so the read below sees a row nothing loaded for:
// E0300 names that query's line, and `.with("author")` on it is the fix.
import { Db } from "../../../pkg/orm"
import { AttrDesc, FieldDesc } from "std/sql"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn show(db: Db, p: []Post): string! {
  p[0] = db.table<Post>().find(2)?
  return p[0].author.name
}

fn run(db: Db): string! {
  let posts = db.table<Post>().with("author").all()?
  return show(db, posts)?
}

fn main() {}
