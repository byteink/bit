// error
// #6308 (R3, epic #6298): a row held in a map is one of R2/R2b's own
// documented gaps (compiler/relationautocalls.bit's own header) --
// `byId[...]` is never one of `relationAutoResolve`'s handled shapes
// (compiler/relationauto.bit), so `.author` below cannot be proven loaded
// and the build refuses it, naming the field and the class, per
// SPEC §10.5's relation-loading rule (E0300).
import { Db } from "../../../pkg/orm"
import { AttrDesc, FieldDesc } from "std/sql"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn run(db: Db): ()! {
  let posts = db.table<Post>().all()?
  let byId = map<i64, Post>{}
  byId[posts[0].id] = posts[0]
  print("${byId[posts[0].id].author.name}\n")
}

fn main() {}
