// error
// #6379: an alias imported from another module has no declaration in this
// module's `typeDecls`, and resolves transparently to the instantiation it
// names, so its type-parameter count was never established (`vImportedArity`
// answered -1) and `X<i64>` for `type X = Pair<i64, string>` was accepted. The
// count is read where the alias is declared (`vOriginArity`).
import { Pair, PairIS, Both, Plain } from "./aliasaritysupport"

fn main() {
  let a: PairIS<i64> = Pair{ a = 1, b = "s" }
  let b: Both = Pair{ a = 1, b = "s" }
  let c: Plain<i64> = Plain{ n = 1 }
  let ok1: PairIS = Pair{ a = 1, b = "s" }
  let ok2: Both<i64> = Pair{ a = 1, b = "s" }
}
