// error
// SPEC §10.5, #5054: `find<T>` refuses a `T` that declares `init`, naming
// both -- the generated mapper assigns fields directly through a composite
// literal, bypassing whatever invariant `init` enforces (`balance >= 0`
// below), so a row could come back in a state the class refuses to
// construct through its own `init`.
import { find, Rows, Conn } from "std/sql"

class Account {
  balance: i64

  init(balance: i64)! {
    if (balance < 0) {
      fail newError("balance must be >= 0")
    }
    this.balance = balance
  }
}

fn run(conn: Conn): ()! {
  let accounts = find<Account>(conn, "SELECT * FROM accounts")?
  print("${len(accounts)}\n")
}

fn main() {}
