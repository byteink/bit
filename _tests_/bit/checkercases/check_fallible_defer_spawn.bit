// error
// #6699: `defer f()` and `spawn f()` run the call with no caller to hand its
// error to, and take no `?` and no `catch`, so a fallible call there would lose
// its error without a trace. E0190, like a bare call statement; the hint names
// the fix, a block that handles the error in place (#6717). The block has no
// caller either, so inside it a bare fallible call is E0190 and a `?` is E0061
// (the block is not a fallible function). `handled` is the valid
// control: the same calls through wrappers or blocks that `catch`, and an
// infallible callee, are accepted.
class Boom {
  message(): string { return "x" }
}

class Conn {
  close(): ()! { return }
}

fn run(): ()! { return }
fn count(): i64! { return 1 }
fn plain() {}

fn bad(c: Conn) {
  defer run()
  defer c.close()
  spawn run()
  spawn count()
  spawn {
    run()
  }
  defer {
    count()
  }
  spawn {
    run()?
  }
}

fn runQuiet() {
  run() catch e {
    print(e.message())
  }
}

fn handled() {
  defer runQuiet()
  spawn runQuiet()
  defer plain()
  spawn plain()
  defer {
    run() catch e {
      print(e.message())
    }
  }
  spawn {
    let n = count() catch e {
      0
    }
    print("${n}")
  }
  defer (() => {
    run() catch e {
      print(e.message())
    }
  })()
}
