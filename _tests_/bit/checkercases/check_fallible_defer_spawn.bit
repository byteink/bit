// error
// #6699: `defer f()` and `spawn f()` run the call with no caller to hand its
// error to, and take no `?`, no `catch` and no block, so a fallible call there
// would lose its error without a trace. E0190, like a bare call statement; the
// hint names the fix, an infallible wrapper that handles the error. `handled`
// is the valid control: the same calls through wrappers, and an infallible
// callee, are accepted.
class Boom {
  message(): string { return "x" }
}

class Conn {
  close(): ()! { return }
}

fn run(): ()! { return }
fn count(): i64! { return 1 }
fn plain() {}

fn bad(c: Conn) {
  defer run()
  defer c.close()
  spawn run()
  spawn count()
}

fn runQuiet() {
  run() catch e {
    print(e.message())
  }
}

fn handled() {
  defer runQuiet()
  spawn runQuiet()
  defer plain()
  spawn plain()
}
