// error
// #6364: `Pair(7, "s")` infers its type arguments from `init`'s arguments the
// way a generic function call does (SPEC 10.4, 15.3), so the ordinary call
// errors apply unchanged: a name that binds nothing is E0124, a missing argument
// E0171, a wrong count E0050, and an argument that contradicts the type already
// inferred for the same parameter is E0041. A type parameter no argument binds
// cannot be inferred and is E0068, naming the parameter and the written form;
// it is never accepted to fail at link time.
class Pair<A, B> {
  a: A
  b: B

  init(first: A, second: B) {
    this.a = first
    this.b = second
  }
}

class Same<T> {
  a: T
  b: T

  init(x: T, y: T) {
    this.a = x
    this.b = y
  }
}

class Box<T> {
  n: i64

  init(n: i64) {
    this.n = n
  }
}

class Two<A, B> {
  a: A

  init(a: A) {
    this.a = a
  }
}

fn main() {
  let a = Pair(third = 1, first = 2)
  let b = Pair(first = 1)
  let c = Pair(1, "a", 3)
  let d = Same(1, "x")
  let e = Box(3)
  let f = Two(1)
  let g = Box(n = 4)
}
