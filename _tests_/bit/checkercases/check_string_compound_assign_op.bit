// error
// #4438 checker half: `x op= y` where `x` is a `string` and `op` is anything
// other than `+` must be rejected the same way the equivalent ordinary
// binary `x op y` already is (E0053) -- vCompoundAssign
// (compiler/validatecall.bit). Before #4438 nothing validated a compound
// assignment's operator against its operand types at all, so this passed
// silently and reached the lowerer, which had no runtime call for a raw
// pointer subtract over two boxed string headers.
fn main() {
  let s = "ab"
  s -= "cd"
  print(s)
}
