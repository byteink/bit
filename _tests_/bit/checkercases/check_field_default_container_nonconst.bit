// error
// SPEC §10.5, #7094/#6979: a slice or map default is rebuilt at every
// construction site, so every element, key and value in it must itself be a
// compile-time constant or a nested literal -- a call stays E0064.
fn readEnv(): string {
  return "x"
}

class SliceElem {
  x: []string = ["a", readEnv()],
}

class MapValue {
  x: map<string, string> = { "k": readEnv() },
}

class Nested {
  x: [][]string = [[], [readEnv()]],
}

class Fine {
  x: []string = ["a", "b" + "c"],
}

fn main() {
  print("${len(SliceElem{}.x)} ${len(MapValue{}.x)} ${len(Nested{}.x)} ${len(Fine{}.x)}\n")
}
