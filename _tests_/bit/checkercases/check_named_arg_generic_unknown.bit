// error
// #6343: a name that binds no parameter of a GENERIC callee is E0124, exactly
// as on a concrete one - checked against the declaration's parameter list
// before any type is inferred. Free generic function, method of a generic
// class, and a type-parameter receiver (against its constraint interface).
interface Shape {
  area(w: i64, h: i64): i64,
}

class GBox<T> {
  v: T
  set(x: T): T {
    return x
  }
}

fn pick<T>(a: T, b: T): T {
  return a
}

fn measure<T: Shape>(shape: T): i64 {
  return shape.area(w = 3, depth = 2)
}

fn main() {
  print("${pick(a = 1, c = 2)}\n")
  let box = GBox<i64>{ v = 0 }
  print("${box.set(y = 1)}\n")
}
