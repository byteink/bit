// error
// SPEC §10.5, #6081: a `@job` class must also carry `@json` -- required,
// not implied -- since a queued job's payload needs `toJson`/
// `jsonDecode<T>` to cross the queue store. `buildJobClass`
// (compiler/classjobdesc.bit) checks this BEFORE validating `@job`'s own
// argument, so a class missing `@json` gets only E0167, never a second
// diagnostic about its (here, otherwise valid) `@job` argument.
@job("send-welcome") class JobA {
  id: i64,
}

fn main() {
  print("${JobA{ id = 1 }.id}\n")
}
