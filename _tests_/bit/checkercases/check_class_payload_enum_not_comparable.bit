// error
// #4341's owner ruling: `vComparable` (compiler/validateattr.bit) now recurses
// into a class's fields instead of stopping at the top level. `Config` below
// has one field whose enum type is itself not comparable (a variant payload is
// a function value), so `Config` is not comparable either, and the diagnostic
// names the offending FIELD — not just "carries a payload" — because a class
// holding a genuinely-comparable payload enum (Config holding Port, say) is
// legal now and the old wording would be misleading on both sides.
//
// What DOES become legal (a class holding a comparable payload enum) is pinned
// by run_enum_payload_eq.bit, not here.
enum Handler { None, Fn(() => int) }
class Config { handler: Handler }

fn main() {
  let a = Config{ handler: Handler.None }
  let b = Config{ handler: Handler.None }
  print("${a == b}\n")
}
