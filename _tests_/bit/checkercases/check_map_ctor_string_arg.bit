// error
// #4064 changed this from #4065's original: a single argument to `map<K,V>`
// is now legal SHAPE (the capacity hint `map<K,V>(n)`) but must still be an
// integer — `vMapCapArgType` (validatezero.bit) checks the TYPE now that
// `vMapCtorArity` accepts the count. A `string` here is the new E0118, not
// the old "takes no arguments" E0050 #4065 originally pinned.
fn main() {
  let m = map<i64, i64>("x")
  m[1] = 7
  print("${len(m)}\n")
}
