// error
// #6369: E0058 at every position a type is written. A type-argument list must
// have exactly the declared length (a class, enum, alias, interface, a
// predeclared name and a type parameter take none), a generic name written bare
// in a type position needs its arguments, and explicit type arguments on a call
// must match the function's or method's own parameters.
class Pair<A, B> {
  a: A
  b: B
}

class Plain {
  n: i64

  area(): i64 {
    return this.n
  }

  get<U>(u: U): i64 {
    return this.n
  }
}

enum Res<T, E> {
  Ok(T),
  Err(E),
}

interface Shape {
  area(): i64
}

type PairAlias = Pair<i64, string>
type OneArg = Pair<i64>
type BareAlias = Pair
type FnAlias = (Pair<i64>) => i64

enum Holds {
  H(Pair<i64>),
  B(Pair),
}

class Holder {
  f: Pair<i64>
  g: Plain<i64>
  h: []Pair
  m: map<string, Pair<i64>>
}

fn param(p: Plain<i64>, q: Res<i64>) {}
fn result(): Pair {
  return Pair<i64, string>{ a = 1, b = "s" }
}
fn alias(p: PairAlias<i64>) {}
fn primitive(p: i64<string>, q: string<i64>) {}
fn typeParam<T>(x: T<i64>) {}
fn id<T>(x: T): T {
  return x
}
fn two<A, B>(a: A, b: B): A {
  return a
}

fn main() {
  let x: Pair<i64> = Pair<i64, string>{ a = 1, b = "s" }
  let y = Pair<i64>{ a = 1 }
  let z: Plain<i64> = Plain{ n = 1 }
  let w = Plain<i64>{ n = 1 }
  let e: Res<i64> = Res.Ok(1)
  let f = (p: Pair<i64>) => 1
  let s: Shape
  let g = s.(Plain<i64>)
  let m = []Pair{}
  let b: Pair
  let ok: Pair<i64, string> = Pair<i64, string>{ a = 1, b = "s" }
  let inferred = Pair{ a = 1, b = "s" }
  let p = Plain{ n = 1 }
  let a1 = id<i64, i64>(1)
  let a2 = two<i64>(1, 2)
  let a3 = p.get<i64, i64>(1)
  let a4 = p.get<i64>(1)
  let a5 = id<i64>(1)
}
