// error
// #7414: `let (o, n) = (Option.Some(<row>), 1)` binds `o` to the rows `let o =
// Option.Some(<row>)` does (compiler/relationautomatch.bit's `relationAutoLetPairs`),
// so a `match` over it reaches the query behind it. `loaded` reads a relation its
// query loads and builds; only `raw` is E0300, naming raw SQL.
import { Db } from "../../../pkg/orm"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn raw(db: Db): ()! {
  let (o, n): (Option<Post>, i64) = (
    Option.Some(db.query<Post>("select * from post order by id")?[0]),
    1,
  )
  match (o) {
    Some(v) => print("${v.author.name}${n}\n")
    None => print("none\n")
  }
}

fn loaded(db: Db): ()! {
  let (o, n): (Option<Post>, i64) = (
    Option.Some(db.table<Post>().with("author").orderBy("id").all()?[0]),
    1,
  )
  match (o) {
    Some(v) => print("${v.author.name}${n}\n")
    None => print("none\n")
  }
}

fn main() {}
