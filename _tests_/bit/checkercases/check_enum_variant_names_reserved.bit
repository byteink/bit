// error
// SPEC §14.7, #6987: `__variantName` and `__variants` are reserved on every
// payload-free enum; a hand-written member of either name is E0189 naming
// the enum and the member.
enum Color {
  Red
  Green

  __variantName(): string {
    return "mine"
  }
}

fn main() {
  print("${Color.Red.__variantName()}\n")
}
