// error
// SPEC §14.7, #6987: `__variantName`, `__variants` and `__variantAt` are reserved on every
// payload-free enum; a hand-written member of any of the three is E0189
// naming the enum and the member.
enum Color {
  Red
  Green

  __variantName(): string {
    return "mine"
  }
}

fn main() {
  print("${Color.Red.__variantName()}\n")
}
