// error
// #3060: a match arm with FEWER binders than the variant's declared payload
// arity was accepted with no diagnostic at all — `bit check` exited 0 and the
// arm silently bound only a truncated prefix of the payload (`Three(a, b)`
// against a 3-field variant dropped the third field with nothing ever
// reading it). spec/SPEC.md:2246 is normative: "the binder count must match
// the variant's payload arity."
enum Shape {
  Three(int, int, int),
  Zero,
}

fn main() {
  let s = Shape.Three(1, 2, 3)
  match (s) {
    Three(a, b) => print("a=${a} b=${b}\n")
    Zero => print("zero\n")
  }
}
