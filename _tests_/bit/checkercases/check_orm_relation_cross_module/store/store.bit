import { Db } from "../../../../../pkg/orm"

export @table class Author {
  export id: i64,
  export name: string,
}

export @table class Post {
  export id: i64
  export authorId: i64
  @belongsTo("authorId")
  export author: Author
}

export class Cache {
  export post: Post,
}

// Two `return`s that disagree: the first is raw SQL, which cannot load a
// relation, the second a query the caller's read can be proven against.
export fn pick(db: Db, raw: bool): Post! {
  if (raw) {
    let rows = db.query<Post>("select * from post")?
    return rows[0]
  }
  return db.table<Post>().find(1)?
}

// A row stored into a field of another module's class.
export fn fill(c: Cache, db: Db): bool! {
  let rows = db.query<Post>("select * from post")?
  c.post = rows[0]
  return true
}
