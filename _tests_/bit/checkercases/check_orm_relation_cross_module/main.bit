// error
// #6373: both rows the reads below see were stored or returned in ANOTHER
// module (store/store.bit), so the hint names the file with the line: a bare
// "line N" would point into this file.
import { Db } from "../../../../pkg/orm"
import { Cache, pick, fill } from "./store"

fn viaReturn(db: Db): string! {
  let p = pick(db, true)?
  return p.author.name
}

fn viaField(db: Db, c: Cache): string! {
  let _ = fill(c, db)?
  return c.post.author.name
}

fn main() {}
