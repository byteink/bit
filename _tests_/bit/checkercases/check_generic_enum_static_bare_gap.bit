// error
// #6403: a static method of a generic enum called through the enum's BARE
// name infers the enum's type parameters from its arguments, exactly as a
// generic class's does (#6365, SPEC 10.4.1, 15.3). `empty` depends on `T` and
// no argument binds it, so the call is E0068 naming the parameter and the
// written form; `wrap` binds `T` from its argument and `arity` mentions none,
// so both are accepted.
enum Opt<T> {
  None
  Some(T)

  static wrap(v: T): Opt<T> {
    return Opt<T>.Some(v)
  }

  static empty(): Opt<T> {
    return Opt<T>.None
  }

  static arity(): i64 {
    return 1
  }
}

fn main() {
  let a = Opt.wrap(1)
  let b = Opt.arity()
  let c = Opt.empty()
}
