// error
// #6352: `rows` is a query's rows that load `author`, but `rows[0] = other`
// replaces an element with a row from a query that does not. The read below
// used to be spliced onto the first query and accepted; the store into the
// query's own rows is now a writer of it, unproven here, so E0300 names the
// query that stored it (line 24).
import { Db } from "../../../pkg/orm"
import { AttrDesc, FieldDesc } from "std/sql"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn show(db: Db): string! {
  let rows = db.table<Post>().with("author").all()?
  rows[0] = db.table<Post>().find(2)?
  return rows[0].author.name
}

fn main() {}
