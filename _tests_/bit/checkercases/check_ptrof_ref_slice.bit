// error
// #7644: `ptrOf` takes a slice of any non-reference scalar element (integers,
// bool, floats), like Go's `unsafe.SliceData`. A slice of references (here
// `[]string`) holds headers the GC traces, not a buffer C can read, so it is
// still refused with E0053 naming the element.
fn main() {
  let names: []string = ["a", "b"]
  let p = ptrOf(names)
  print("${len(names)}\n")
}
