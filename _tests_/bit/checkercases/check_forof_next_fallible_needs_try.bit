// error
// #6567: an iterable whose `next()` is `Option<T>!` is ranged over with a
// postfix `?` on the iterable, `for page of pages? { }`. Leaving the `?` off
// would drop the error `next()` can return, so it is a compile error that
// names the fix, in a fallible function and out of one alike.
class Pages {
  n: i64
  next(): Option<i64>! {
    if (this.n <= 0) {
      return Option.None
    }
    this.n = this.n - 1
    return Option.Some(this.n)
  }
}

fn drain(p: Pages): i64! {
  let sum: i64 = 0
  for x of p {
    sum = sum + x
  }
  return sum
}

fn main() {
  let p = Pages{ n = 3 }
  for x of p {
    println("${x}")
  }
}
