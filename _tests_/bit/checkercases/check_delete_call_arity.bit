// error
// #6084: a bare call to the predeclared `delete` builtin with the wrong
// number of arguments typechecked as void with zero diagnostics whenever the
// call site had not imported a same-named symbol -- `builtinReturnsVoid`
// (checktype.bit) types the call REGARDLESS OF ARGUMENTS and, unlike
// `print`/`eprint`/`len`/`cap`/`append`, nothing validated its arity at all.
fn main() {
  let m = map<string, int>{}
  delete(m, "a", "b")
}
