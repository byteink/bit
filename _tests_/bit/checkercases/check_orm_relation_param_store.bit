// error
// #6366: `show` reads `p[0].author` off its PARAMETER and its only caller
// passes rows that load `author`, but `p = rawRows(db)?` replaced the
// parameter's rows first, so the rows the read sees came from raw SQL (which
// has no `.with()`). A store into a parameter's rows is held to the same
// standard as one into a query's (check_orm_relation_element_write.bit): E0300
// names the store's line, and the hint says what does work instead.
import { Db } from "../../../pkg/orm"
import { AttrDesc, FieldDesc } from "std/sql"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn rawRows(db: Db): []Post! {
  return db.query<Post>("select * from post")?
}

fn show(db: Db, p: []Post): string! {
  p = rawRows(db)?
  return p[0].author.name
}

fn run(db: Db): string! {
  let posts = db.table<Post>().with("author").all()?
  return show(db, posts)?
}

fn main() {}
