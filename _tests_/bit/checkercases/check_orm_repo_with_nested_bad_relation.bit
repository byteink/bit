// error
// #6318: `.with("a.b")` checks EACH dotted segment against the class the
// PREVIOUS segment's own relation targets — `checkOrmWithPath`
// (compiler/checkormquery.bit). `author` names `Post`'s own `@belongsTo`
// relation correctly; `nope` names no field of `Author`, the class `author`
// targets — the same E0163 a single-segment `.with()` already gives
// (`check_orm_repo_bad_column.bit`), reused for a bad segment past the
// first.
import { Db } from "../../../pkg/orm"
import { AttrDesc, FieldDesc } from "std/sql"

@table class Author {
  id: i64
  @hasMany("authorId")
  posts: []Post
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn run(db: Db): ()! {
  db.table<Post>().with("author.nope")
}

fn main() {}
