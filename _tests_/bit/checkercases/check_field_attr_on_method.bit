// error
// SPEC §10.5, #3879: an attribute desugars to a call taking the MEMBER'S
// VALUE, and a method has none -- E0131, reported by the parser, because the
// method parses fine and its attributes would otherwise be dropped in silence.

fn slug(s: string): ()! {}

class C {
  handle: string

  @slug
  normalize(): string {
    return this.handle
  }
}

fn main() {
  let c = C{ handle: "ok" }
  print("${c.normalize()}\n")
}
