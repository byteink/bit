// error
// #3061: interface satisfaction was never checked for a map-literal VALUE
// (the key slot has the identical hole, same function). `vCompositeSlot`
// (compiler/validatezero.bit) called `vExpectExprNonIface`, which returns on
// an Interface-kind target, then `vIfaceStore`, the narrow "cannot store"
// scalar case — so a map value that does not implement the map's
// interface-typed value type was never checked. `bit check` exited 0,
// `bit build` produced a binary, and reading the entry back dispatched
// through a nonexistent method slot.
interface Payer {
  pay(): i64,
}

class Cash {
  n: i64,
}

fn main() {
  let cash = Cash{ n: 1 }
  let m = map<string, Payer>{ "k": cash }
  print("${m["k"].pay()}\n")
}
