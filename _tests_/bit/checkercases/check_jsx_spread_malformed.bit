// error
// #5172: a `{` in JSX attribute position means only one thing — a spread
// (`{...expr}`) — so `jsxAtAttr` (parserjsx.bit) claims the brace itself
// rather than leaving it to be reread as a child, and a `{` not followed by
// `...` is reported here BY NAME (E0024) instead of silently ending the
// attribute list and cascading into "expected '>', found '{'".
fn el(tag: string, ...kids: string): string {
  return tag
}
fn attr(name: string, value: string): string {
  return name
}
fn kidFrom(item: string): []string {
  return [item]
}
fn kid(acc: []string, item: string): []string {
  return acc
}
fn kids(acc: []string, items: []string): []string {
  return acc
}
fn main() {
  let props = []string(0)
  let x = <div {props} />
}
