// error
// #6347: a name that binds no parameter is E0124 on every generic call shape
// that accepts named arguments: an arrow literal passed to a generic function,
// a static method of a generic class called through a written instantiation,
// and a value of a generic interface type (against the interface's signature,
// not its implementation's).
interface Store<T> {
  put(key: i64, value: T): string,
}

class Mem {
  put(value: i64, key: i64): string {
    return "${key}:${value}"
  }
}

class Pair<A, B> {
  a: A
  b: B
  static tag(n: i64, p: string): string {
    return "${n}/${p}"
  }
}

fn apply<T>(f: (T) => i64, v: T): i64 {
  return f(v)
}

fn main() {
  print("${apply(g = (x) => x + 1, v = 4)}\n")
  print("${Pair<i64, bool>.tag(q = "z", n = 1)}\n")
  let s: Store<i64> = Mem{}
  print("${s.put(val = 5, key = 1)}\n")
}
