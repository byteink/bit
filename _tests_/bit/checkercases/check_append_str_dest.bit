// error
// #4371: `append(dst, s)` has TWO admissible operand shapes once a `string`
// source is legal — the bytes shape (`dst` is `[]u8`) and the element shape
// (`dst` is `[]string`). A `string` operand is the only one that can be read
// as either, so a destination that is neither must say WHICH shape the call
// failed and why, not fall back to a generic arity or type message.
//
// Before this ticket every line below checked rc=0, built rc=0 and appended
// one garbage word — the string header's own address truncated to the element.
// The precise diagnostic is the half of the feature that closes that.
fn main() {
  let a: []i64 = []
  a = append(a, "hi")
  let b: []f64 = []
  b = append(b, 1.0, "hi")
  let c: []bool = []
  let s = "hi"
  c = append(c, s)
  println("${len(a)}${len(b)}${len(c)}")
}
