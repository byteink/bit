// error
// #7765: the E0186/E0187 judgement of a `for x of it` reaches an iterable that
// is typed from an arrow's inferred parameter, not only one typed before the
// arrow is seeded. A fallible `next()` without `?`, and a `?` on an iterable
// whose `next()` cannot fail, are each reported inside the arrow.
class Pages {
  n: i64
  next(): Option<i64>! {
    if (this.n < 0) {
      return Option.None
    }
    this.n = this.n - 1
    return Option.Some(this.n + 1)
  }
}

class Plain {
  n: i64
  next(): Option<i64> {
    if (this.n < 0) {
      return Option.None
    }
    this.n = this.n - 1
    return Option.Some(this.n + 1)
  }
}

class Src {
  n: i64
  pages(): Pages {
    return Pages{ n = this.n }
  }
  plain(): Plain {
    return Plain{ n = this.n }
  }
}

fn with(s: Src, f: (Src) => i64!): i64! {
  return f(s)?
}

fn run(s: Src): i64! {
  return with(s, (t) => {
    let sum: i64 = 0
    for x of t.pages() {
      sum = sum + x
    }
    for y of t.plain()? {
      sum = sum + y
    }
    return sum
  })?
}

fn main() {
  let _ = run(Src{ n = 3 }) catch _ {
    0
  }
}
