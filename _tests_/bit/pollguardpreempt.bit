// #3564. In the same shape _tests_/bit/pollguardstopword.bit uses for the
// stop-the-world half: no encoding-level check can tell whether the COMPILED
// back-edge poll guard actually observes and acts on a pending preempt
// request, so this gate runs one.
//
// #4203 REPLACED THE MECHANISM AND THIS GATE IS UNCHANGED, which is the point
// of writing it behaviourally. The compiled fast path no longer inlines
// `schedCurrentWorker` + `preemptRequested` at all; `sysmonTick` publishes into
// runtime/sched/pollreq.bit's attention word, the back edge reads that word,
// and `stwSafepoint` -> `schedMaybeYieldForPreempt` -> `maybePreempt` does the
// clearing this gate observes. Same assertion, same PASS, different machinery
// underneath.
//
// #3560's own runtime-level fix, alone, could not be tested end to end:
// nothing compiled calls stwPollNeeded (compiler/codegen.bit:322 — dead
// since #2925/#3169), so #3560's ticket recorded a deterministic harness
// driving stwPollNeeded directly instead. THIS gate drives the same
// scenario through the REAL compiled path: a spinning, allocation-free
// mutator with a genuine loop back edge, so the compiler emits the inlined
// guard at it, and a real bl bit_rt_safepoint only fires if that guard's
// preempt clause actually returns true.
//
// WHY preemptStamp/sysmonTick DIRECTLY, not a real 10ms wait. Backdating the
// stamp (a sysmon-tick epoch older than `preemptBudgetTicks`) then calling
// `sysmonTick`
// once sets the flag deterministically, the same way sysmonTick's own OS
// thread would after a real preemptBudgetNs of continuous running — see
// runtime/sched/preempt.bit's own comments on both functions. This is
// exactly what the ticket's acceptance criterion asks for: "a second task
// setting the preempt flag via preemptStamp/sysmonTick".
//
// WHY THE MUTATOR PUBLISHES ITS OWN WORKER ID, rather than this file
// scanning every slot. `schedCurrentWorker()` returns a raw, word-aligned
// WORKER BLOCK ADDRESS (never a small index — see runtime/sched/task.bit's
// own note on schedMaybeYieldForPreempt), so the small id `preemptStamp`/
// `preemptRequested`/`sysmonTick` index by is `*(taskAt(w) + wkId)` — the
// exact conversion the guard's own new clause performs. The mutator is the
// only task that can legitimately ask "what worker am I running on right
// now", and it publishes once, before it starts spinning; since nothing
// makes it yield until the fix under test fires, that worker binding cannot
// change out from under this file's later preemptStamp/sysmonTick call.
//
// MUTATION-PROVEN TWICE. #3564: reverting compiler/arm64call.bit's
// emitInlinedPreemptCheck call site and rebuilding made this gate FAIL — the
// flag never cleared, exit 1. #4203: making runtime/sched/pollreq.bit's
// `pollRequest` store 0 instead of 1 makes it FAIL the same way, exit 1, which
// is what proves `sysmonTick`'s publish is load-bearing now that the compiled
// fast path reads nothing else.
//
// #4030: THE POLL LOOP MUST NOT `sleep` — see `waitForClear` below.
// `pollguardpreemptx64.bit` (#3565, x64-hardware-only sibling) carried this
// fix first and its own header recorded the false PASS it closed; this file
// (#3564, written first) never got it ported over, and sat PASSING against
// the exact mutant it exists to catch until #4030 copied the fix across by
// hand. Reproduced directly: with `compiler/arm64call.bit`'s
// `emitBackEdgeSafepointIfNeeded` neutered so NO back edge anywhere emits
// ANY poll (a strictly stronger break than clause 3 alone), this file's
// PRIOR `sleep(1ms)`-based poll loop still printed PASS.
// The mutator's own worker id is a small, reused index (0..BIT_WORKERS-1,
// runtime/sched/worker.bit's `wkId`), and `preemptStamp` — called on every
// ordinary task dispatch, runtime/sched/workerrun.bit — unconditionally
// clears whatever `requested` flag was left on that SAME index by whoever
// ran there before. The controller's own `sleep`-driven park/redispatch
// cycles through worker indices too (confirmed by instrumenting both sides:
// the flag flipped to clear on the exact check where the controller's own
// `schedCurrentWorker()` read the mutator's published `wid`), so with only a
// few workers it lands back on the mutator's index by chance within the
// 2-second window essentially every time — clearing the flag as ordinary
// scheduler bookkeeping, with clause 3 never called at all.
//
// REQUIRES BIT_WORKERS >= 2, same reason and same failure mode as
// pollguardstopword.bit's own header: with the scheduler's single-worker
// default the controller and the mutator can never run concurrently, so
// this hangs (bounded by the mutator's own iteration ceiling, not by this
// file) rather than failing fast. Set in this gate's own tools/build/gatestable2.bit
// entry, not left to the caller's environment.

import { args, exit } from "std/os"
import { WaitGroup } from "std/sync"
import {
  schedCurrentWorker, taskAt, wkId, schedMaxWorkers,
  preemptStamp, sysmonTick, preemptRequested, preemptTickNow, preemptBudgetTicks,
  preemptClear, preemptRequestTag, preemptDispatchMatches, preemptPublish,
  wkSched, scNWorkers, preemptRetract, preemptAdvanceEpoch,
} from "../../runtime/sched"

class Shared { wg: WaitGroup, started: []i64, testDone: []i64, workerId: []i64, armed: []i64 }

// Startup allocations finish while these ordinary compiled loops still poll.
fn awaitAdmission(phase: *i64, done: *i64): bool {
  let n = 0
  while (n < 2000000000 && atomicLoad(done) == 0) {
    if (atomicLoad(phase) != 0) {
      return true
    }
    n = n + 1
  }
  return false
}

fn admitControl(phase: *i64) {
  // This actual compiled back edge services pending GC before workers hold.
  let n = 0
  while (n < 2) {
    let _ = atomicLoad(phase)
    n = n + 1
  }
  atomicStore(phase, 1)
}

// The controller must witness the exact target flag before the compiled loop
// can consume it. Shutdown releases this bounded setup barrier on failure.
@nosplit fn waitForArm(armed: *i64, done: *i64): bool {
  let n = 0
  while (n < 2000000000 && atomicLoad(done) == 0) {
    if (atomicLoad(armed) == 2) {
      return true
    }
    n = n + 1
  }
  return false
}

// The mutator under test: allocation-free, with a real loop back edge so the
// compiler emits the back-edge poll guard at it — see pollguardstopword.bit's
// mutatorLoop for why this shape (spawn, bounded spin, shared testDone) beats
// a userspace lock for isolating one clause.
fn mutatorLoop(s: Shared) {
  if (!awaitAdmission(ptrOf(s.armed), ptrOf(s.testDone))) {
    atomicStore(ptrOf(s.started), 2)
    s.wg.done()
    return
  }
  let raw = schedCurrentWorker()
  // raw==0 means off-task (see runtime/sched/task.bit's own note on
  // schedCurrentWorker — a small-index worker id of 0 is a perfectly valid
  // first worker and must NOT be confused with this). A properly dispatched
  // task can never observe raw==0; -1 is a sentinel the controller checks.
  let wid = -1
  if (raw != 0) {
    wid = *(taskAt(raw) + wkId)
  }
  atomicStore(ptrOf(s.workerId), wid)
  atomicStore(ptrOf(s.started), 1)
  if (!waitForArm(ptrOf(s.armed), ptrOf(s.testDone))) {
    atomicStore(ptrOf(s.started), 2)
    s.wg.done()
    return
  }
  atomicStore(ptrOf(s.started), 3)
  let i = 0
  // Bounded per Power of 10 (rule 2); see pollguardstopword.bit's own note on
  // this exact ceiling and iteration rate. Never reached in a correctly
  // configured (BIT_WORKERS >= 2) run, win or lose.
  while (i < 2000000000 && atomicLoad(ptrOf(s.testDone)) == 0) {
    i = i + 1
  }
  s.wg.done()
}

@nosplit fn waitForReady(ready: *i64, want: i64): bool {
  let n = 0
  while (n < 2000000000) {
    if (atomicLoad(ready) >= want) {
      return true
    }
    n = n + 1
  }
  return false
}

// #4030: BUSY-SPIN on `preemptRequested` ONLY — no `sleep`, no `monotonic()`,
// ported verbatim (as a design, adapted to this file's naming) from
// `pollguardpreemptx64.bit`'s own `waitForClear`, which already carried the
// full rationale for both restrictions.
//
// #4123: `pollguardpreemptx64.bit` is DELETED. Two copies of this exact
// function — one busy-spin, one still `sleep`-based — sat undetected for
// months until #4030 found the divergence; keeping a second copy around
// would only reopen the same risk. This file is now the SINGLE harness for
// both `test-pollguardpreempt` (run natively, whatever backend the host
// compiles — arm64 on this Mac) and `test-pollguardpreemptx64`
// (tools/build/gatestable2.bit, same argv, meaningful only on real x86-64
// hardware via x64gate.sh/boxlock's --need x86_64-linux): `bit run` always
// compiles for the invoking host, so no source-level target branch is
// needed — the "two arms" are two hosts, not two files.
//
//   - `sleep`/any blocking call PARKS the controller, and `preemptStamp`
//     clears a worker's `requested` flag as a side effect of ANY fresh
//     dispatch onto that worker index. A parked controller gets
//     re-dispatched repeatedly and, with only a few workers, lands back on
//     the mutator's own index by chance — clearing the flag itself with the
//     guard under test never having run. See this file's own header for the
//     #4030 repro that hit exactly this.
//   - `monotonic()` allocates (`Mono`, #2678); called every iteration of a
//     tight loop it would exhaust the GC trigger, and `stwSafepoint` calls
//     `schedMaybeYieldForPreempt()` unconditionally whenever ANY clause polls
//     — so a GC-due poll (clause 2, pre-existing on this ladder) would clear
//     the mutator's flag as a side effect too, with clause 3 never firing.
//
// A plain iteration ceiling (Power of 10 rule 2) is the only bound left: no
// syscall, no allocation, so nothing here can itself cause a dispatch or a
// collection. pollguardstopword.bit measured ~485M iterations/s for a
// similar allocation-free loop, so 2 billion resolves in a few seconds if the
// clause never fires, and in far less than one if it does.
fn waitForClear(wid: i64): bool {
  let i = 0
  while (i < 2000000000) {
    if (!preemptRequested(wid)) {
      return true
    }
    i = i + 1
  }
  return false
}

// Reset other slots so aggregate publications cannot mask a missing victim.
// The mutator stays in its nosplit arm barrier until this controller observes
// the target request directly, then its actual compiled back edge must clear it.
@nosplit fn armPreemptFor(wid: i64): i64 {
  let now = preemptTickNow()
  let w = 0
  while (w < schedMaxWorkers) {
    if (w != wid) {
      preemptStamp(w, now)
    }
    w = w + 1
  }
  // A second task (this one) sets the preempt flag directly, the same way
  // sysmonTick's own OS thread would after preemptBudgetTicks of real ticks.
  //
  // THE BACKDATE IS A NEGATIVE EPOCH (#4736), not `now - preemptBudgetTicks`:
  // preempt.bit counts in sysmon ticks now, the epoch starts at 1 and only
  // advances every sysmonPeriodNs, so that subtraction can land exactly on 0
  // early in a program's life -- the one value startTick reserves for "no task
  // in flight", which sysmonTick SKIPS rather than flags, and this test would
  // then fail for a reason that has nothing to do with the guard under test.
  // Any stamp <= now - preemptBudgetTicks is over budget; a negative one is
  // that for every epoch and can never collide with the sentinel.
  preemptStamp(wid, 0 - preemptBudgetTicks - 1)
  return sysmonTick()
}

// No scheduler worker owns slot31 during these allocation-free controls.
@nosplit fn unusedSlotAvailable(): bool {
  let raw = schedCurrentWorker()
  if (raw == 0) {
    return false
  }
  let sched = taskAt(*(taskAt(raw) + wkSched))
  return atomicLoad(sched + scNWorkers) < 31
}

@nosplit fn clearPublicationState(): int {
  let raw = schedCurrentWorker()
  if (raw == 0) {
    return 2
  }
  let sched = taskAt(*(taskAt(raw) + wkSched))
  if (atomicLoad(sched + scNWorkers) >= 31) {
    return 2
  }
  let slot: i64 = 31
  let old = 0 - preemptBudgetTicks - 1
  preemptStamp(slot, old)
  let prior = preemptRequestTag(slot)
  let validated = preemptDispatchMatches(slot, old)
  preemptClear(slot)
  let cleared = preemptDispatchMatches(slot, 0)
  if (prior != 0 || !validated || !cleared) {
    preemptClear(slot)
    return 2
  }
  let published = preemptPublish(slot, old, prior)
  let idle = preemptDispatchMatches(slot, 0)
  let pending = preemptRequested(slot)
  preemptClear(slot)
  if (!idle) {
    return 2
  }
  if (!pending) {
    return 0
  }
  if (!published) {
    return 2
  }
  return 1
}

@nosplit fn ageDispatch(worker: i64, started: i64): bool {
  let n = 0
  while (n < preemptBudgetTicks) {
    let _ = preemptAdvanceEpoch()
    n = n + 1
  }
  return preemptTickNow() - started >= preemptBudgetTicks && preemptDispatchMatches(worker, started)
}

@nosplit fn ownedPublicationState(retract: bool): int {
  if (!unusedSlotAvailable()) {
    return 2
  }
  let slot: i64 = 31
  let old = 0 - preemptBudgetTicks - 2
  preemptStamp(slot, old)
  let prior = preemptRequestTag(slot)
  let validated = preemptDispatchMatches(slot, old)
  preemptClear(slot)
  if (prior != 0 || !validated) {
    return 2
  }
  let fresh = preemptTickNow()
  preemptStamp(slot, fresh)
  if (!ageDispatch(slot, fresh)) {
    preemptClear(slot)
    return 2
  }
  let published = preemptPublish(slot, fresh, 0)
  if (!published || preemptRequestTag(slot) != fresh) {
    preemptClear(slot)
    return 2
  }
  if (retract) {
    preemptRetract(slot, old)
  } else {
    let _ = preemptPublish(slot, old, prior)
  }
  let current = preemptDispatchMatches(slot, fresh)
  let kept = preemptRequestTag(slot) == fresh
  preemptClear(slot)
  if (!current) {
    return 2
  }
  if (!kept) {
    return 1
  }
  return 0
}

class EpochControl {
  wg: WaitGroup,
  ready: []i64,
  go: []i64,
  done: []i64,
  failed: []i64,
  workers: []i64,
}

@nosplit fn advanceEpochBatch(s: EpochControl, index: int) {
  atomicStore(ptrOf(s.workers) + index, schedCurrentWorker())
  atomicAdd(ptrOf(s.ready), 1)
  if (waitForArm(ptrOf(s.go), ptrOf(s.done))) {
    let previous = preemptTickNow()
    let n = 0
    while (n < 64) {
      let now = preemptAdvanceEpoch()
      if (now < previous) {
        let _ = atomicCmpxchg(ptrOf(s.failed), 0, 1)
      }
      previous = now
      n = n + 1
    }
  } else {
    atomicStore(ptrOf(s.failed), 2)
  }
}

fn advanceEpochs(s: EpochControl, index: int) {
  if (!awaitAdmission(ptrOf(s.go), ptrOf(s.done))) {
    atomicStore(ptrOf(s.failed), 2)
    s.wg.done()
    return
  }
  advanceEpochBatch(s, index)
  s.wg.done()
}

fn epochPublicationState(): int {
  let s = EpochControl{
    wg = WaitGroup(),
    ready = []i64(1),
    go = []i64(1),
    done = []i64(1),
    failed = []i64(1),
    workers = []i64(2),
  }
  s.wg.add(2)
  spawn advanceEpochs(s, 0)
  spawn advanceEpochs(s, 1)
  admitControl(ptrOf(s.go))
  if (!waitForReady(ptrOf(s.ready), 2)) {
    atomicStore(ptrOf(s.done), 1)
    s.wg.wait()
    return 2
  }
  let first = atomicLoad(ptrOf(s.workers))
  let second = atomicLoad(ptrOf(s.workers) + 1)
  if (first == 0 || second == 0 || first == second) {
    atomicStore(ptrOf(s.done), 1)
    s.wg.wait()
    return 2
  }
  let before = preemptTickNow()
  atomicStore(ptrOf(s.go), 2)
  s.wg.wait()
  if (atomicLoad(ptrOf(s.failed)) == 2) {
    return 2
  }
  if (atomicLoad(ptrOf(s.failed)) != 0 || preemptTickNow() - before < 128) {
    return 1
  }
  return 0
}

fn publicationMode(mode: string): int {
  let state = -1
  if (mode == "publication-clear") {
    state = clearPublicationState()
  } else if (mode == "publication-fresh") {
    state = ownedPublicationState(false)
  } else if (mode == "publication-retract") {
    state = ownedPublicationState(true)
  } else if (mode == "publication-epoch") {
    state = epochPublicationState()
  }
  if (state == 0) {
    println("pollguardpreempt: ${mode} PASS")
  } else if (state == 1) {
    println("pollguardpreempt: ${mode} FAIL — request invariant")
  } else if (state == 2) {
    println("pollguardpreempt: ${mode} UNKNOWN — setup or dispatch state changed")
  }
  return state
}

fn main() {
  let argv = args()
  if (len(argv) > 1) {
    let state = publicationMode(argv[1])
    if (state >= 0) {
      exit(state)
    }
  }
  let started = []i64(1)
  let testDone = []i64(1)
  let workerId = []i64(1)
  let armed = []i64(1)
  let wg = WaitGroup()
  wg.add(1)
  spawn mutatorLoop(
    Shared{ wg = wg, started = started, testDone = testDone, workerId = workerId, armed = armed },
  )

  admitControl(ptrOf(armed))
  if (!waitForReady(ptrOf(started), 1)) {
    atomicStore(ptrOf(testDone), 1)
    wg.wait()
    println("pollguardpreempt: UNKNOWN — mutator setup timed out")
    exit(2)
  }

  let wid = atomicLoad(ptrOf(workerId))
  if (wid < 0) {
    atomicStore(ptrOf(testDone), 1)
    wg.wait()
    println("pollguardpreempt: FAIL — mutator's schedCurrentWorker() returned 0 (off-task); a spawned, dispatched task should never observe this")
    exit(2)
  }

  // The nosplit barrier prevents consumption before this exact-target check.
  let flagged = armPreemptFor(wid)
  if (flagged == 0 || !preemptRequested(wid)) {
    atomicStore(ptrOf(testDone), 1)
    wg.wait()
    println("pollguardpreempt: FAIL — setup broken, not the guard under test: the target worker ${wid} had no pending request after its deliberate backdate")
    exit(2)
  }

  atomicStore(ptrOf(armed), 2)

  // Poll (bounded by a plain iteration ceiling, `waitForClear` above — #4030,
  // NOT a wall-clock deadline with `sleep` between checks, which reopened a
  // false-PASS path) for the COMPILED guard to observe and clear it. Only
  // the compiled back edge reaching bit_rt_safepoint
  // -> schedMaybeYieldForPreempt -> maybePreempt can make this clear — that
  // is the actual thing under test. It is legitimate for `cleared` to go
  // true on the very FIRST check inside `waitForClear`: the exact-target
  // read above already establishes the flag really was set for wid
  // specifically, and the only thing that clears requested[wid] while the
  // mutator's task is still alive is that same guard's maybePreempt call —
  // so an instant "already false" means the released mutator consumed it.
  let cleared = waitForClear(wid)

  atomicStore(ptrOf(testDone), 1)
  wg.wait()
  if (atomicLoad(ptrOf(started)) != 3) {
    println("pollguardpreempt: UNKNOWN — mutator arm barrier expired")
    exit(2)
  }

  if (!cleared) {
    println("pollguardpreempt: FAIL — preemptRequested(${wid}) never cleared; the compiled back-edge poll guard did not observe the pending preempt (sysmonTick is not calling pollRequest, or the compiled back edge is not reading runtime/sched/pollreq.bit's attention word)")
    exit(1)
  }
  println("pollguardpreempt: PASS — allocation-free mutator's own back-edge poll guard observed and cleared the pending preempt for worker ${wid}")
}
