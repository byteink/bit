// _tests_/bit/pmvanitychecks — the bit.json/bit.lock verification helpers
// `_tests_/bit/pmvanity.bit` needs, split out under #5604
// (spec/LINT.md:186's 800-line E0200 limit). #5593 already split
// pmvanity.bit once today (864 -> 644 raw, moving the #5586 multi-package
// scenario to `pmvanitymulti/`); that cleared the RAW ceiling
// (`test-filesize`, `test-lint-filelines`) but not the CANONICAL one — 644
// raw still formats to 814, 14 over. This is that second, smaller split: a
// pure move, every declaration below unchanged from what pmvanity.bit
// carried, except the checks' positional arguments bundled into
// `ManifestCheckArgs`/`ManifestCheckDirArgs` — pmvanity.bit's own
// per-scenario consts (`vanityName`/`depName`/`gitRemoteUrl` and their
// `...Dir` counterparts) don't move with the functions that read them
// (they're still needed by `checkVanityAdd`/`checkVanityAddSubdir`, which
// stay in pmvanity.bit), so the caller now passes them explicitly — which
// put `checkManifestAndLock`/`checkManifestAndLockDir` at six-plus
// parameters. Bundled into one argument per spec/LINT.md's five-parameter
// E0202 ceiling, the same reasoning `pmvanityhelpers.bit`'s
// `CliEnv`/`FixtureCtx` and `pmvanitymulti.bit`'s `MultiAddCtx` already
// follow: past five, the arguments want to be a class.
//
// A real directory module, imported via a relative path
// (`import { ... } from "./pmvanitychecks"`) from `_tests_/bit/pmvanity.bit`
// — the same shape `pmvanityhelpers/` and `pmvanitymulti/` already use.
// `_tests_/bit/pmvanity.bit` is invoked directly by `tools/build/gates.bit`'s
// `test-pmvanity` gate as a single file (`bit run _tests_/bit/pmvanity.bit`),
// which loads it as a module of exactly that one file (SPEC §17.1) — it
// cannot see a bare sibling `.bit` file in the same directory, only a real
// subdirectory reached through an explicit import. This file is that
// subdirectory; `pmvanity.bit` reaches it as `./pmvanitychecks`.
import { readFile } from "std/fs"
import { Json, jsonGet } from "std/json"
import {
  fatal, isFullSha, mustJsonGet, mustJsonString, mustParseJson, mustParseJsonc,
} from "../pmvanityhelpers"

// The dependency identity + expected values a manifest/lock check compares
// against — see the module header for why these are a bundled argument
// rather than positional parameters.
export class ManifestCheckArgs {
  export name: string,
  export projDir: string,
  export sha: string,
  export depName: string,
  export vanityName: string,
  export written: string,
  export gitRemoteUrl: string,
  export wantLockTag: string,
}

export class ManifestCheckDirArgs {
  export name: string,
  export projDir: string,
  export sha: string,
  export depName: string,
  export vanityName: string,
  export gitRemoteUrl: string,
  export pkgSubdir: string,
}

// Reads both files back through the real JSON/JSONC parsers and asserts the
// specific fields SPEC §17.7 promises for a vanity dependency — never a
// substring search, which an empty or truncated file could also satisfy.
// `expectedSpecRef` comparing EQUAL to the literal `@${written}` form
// (rather than a resolved sha) is exactly what proves `hasExplicitRef`
// (compiler/pmfetch.bit) correctly detected the ref as explicit (#3287):
// the pre-fix bug would have failed `bit add` outright before this is ever
// reached. `written` (#2367) differs from `tag` only when `tag` was a
// `v`-prefixed version (pmvanity.bit's own `checkVanityAdd` doc comment).
export fn checkManifestAndLock(a: ManifestCheckArgs) {
  let bitJsonText = readFile(a.projDir + "/bit.json") catch e {
    fatal(a.name, "cannot read the updated bit.json: " + e.message())
    ""
  }
  let bitJsonDoc = mustParseJsonc(a.name, "bit.json", bitJsonText)
  let deps = mustJsonGet(a.name, "bit.json", bitJsonDoc, "dependencies")
  let specRef = mustJsonString(a.name, "bit.json .dependencies", deps, a.depName)
  let expectedSpecRef = "${a.vanityName}@${a.written}"
  if (specRef != expectedSpecRef) {
    fatal(a.name, "bit.json's ${a.depName} dependency is '${specRef}', want '${expectedSpecRef}'")
  }

  let bitLockText = readFile(a.projDir + "/bit.lock") catch e {
    fatal(a.name, "cannot read bit.lock: " + e.message())
    ""
  }
  let bitLockDoc = mustParseJson(a.name, "bit.lock", bitLockText)
  let entry = mustJsonGet(a.name, "bit.lock", bitLockDoc, a.depName)

  let vanityField = mustJsonString(a.name, "bit.lock ${a.depName} entry", entry, "vanity")
  if (vanityField != a.vanityName) {
    fatal(a.name, "bit.lock's vanity field is '${vanityField}', want '${a.vanityName}'")
  }
  // #3270: this fixture's `bit-import:` document carries only the original
  // three tokens (no `dir` field) — proving that shape still resolves, and
  // that the resulting entry carries no stray `dir` key, is this file's own
  // half of #3270's "old-format document is a compatible extension"
  // acceptance criterion.
  let dirV = jsonGet(entry, "dir")
  if (isSome(dirV)) {
    fatal(
      a.name,
      "bit.lock's ${a.depName} entry unexpectedly has a 'dir' key — its bit-import: document named no dir field",
    )
  }
  let urlField = mustJsonString(a.name, "bit.lock ${a.depName} entry", entry, "url")
  if (urlField != a.gitRemoteUrl) {
    fatal(a.name, "bit.lock's url field is '${urlField}', want '${a.gitRemoteUrl}'")
  }
  let commitField = mustJsonString(a.name, "bit.lock ${a.depName} entry", entry, "commit")
  if (!isFullSha(commitField)) {
    fatal(a.name, "bit.lock's commit field is not a 40-hex sha: '${commitField}'")
  }
  if (commitField != a.sha) {
    fatal(
      a.name,
      "bit.lock's commit field is '${commitField}', want '${a.sha}' (the fixture's own tagged commit)",
    )
  }
  checkLockTag(a.name, entry, "bit.lock ${a.depName} entry", a.wantLockTag)
}

// #4472's tag assertion, in ONE implementation shared by both callers.
// `wantLockTag` carries the whole difference between them: the no-`dir`
// scenario expects the BARE spelling (a `<key>/` prefix there would mean
// the namespace rule leaked onto an ordinary dependency), the subdir
// scenario expects the `<key>/` prefix the namespace rule exists to add.
// An empty `wantLockTag` asserts no tag KEY at all rather than an empty
// one — a ref that is not a version constraint matched nothing to record,
// the same omit-rather-than-write-empty rule `vanity`/`dir`/`version`
// follow.
fn checkLockTag(name: string, entry: Json, what: string, wantLockTag: string) {
  if (len(wantLockTag) == 0) {
    let absent = jsonGet(entry, "tag")
    if (isSome(absent)) {
      fatal(
        name,
        "bit.lock's entry has a 'tag' key, but the ref resolved was not a version constraint — nothing was matched to record",
      )
    }
    return
  }
  let tagField = mustJsonString(name, what, entry, "tag")
  if (tagField != wantLockTag) {
    fatal(name, "bit.lock's tag field is '${tagField}', want '${wantLockTag}'")
  }
}

// #3270 acceptance: the `checkManifestAndLock` counterpart for
// `checkVanityAddSubdir` — same shape, plus the one field this ticket
// exists to add: `bit.lock`'s `dir` key, pasted verbatim into this
// ticket's own evidence.
export fn checkManifestAndLockDir(a: ManifestCheckDirArgs) {
  let bitJsonText = readFile(a.projDir + "/bit.json") catch e {
    fatal(a.name, "cannot read the updated bit.json: " + e.message())
    ""
  }
  let bitJsonDoc = mustParseJsonc(a.name, "bit.json", bitJsonText)
  let deps = mustJsonGet(a.name, "bit.json", bitJsonDoc, "dependencies")
  let specRef = mustJsonString(a.name, "bit.json .dependencies", deps, a.depName)
  // #2367: canonicalised — never the "v1.0.0" typed on the command line above.
  let expectedSpecRef = "${a.vanityName}@1.0.0"
  if (specRef != expectedSpecRef) {
    fatal(a.name, "bit.json's ${a.depName} dependency is '${specRef}', want '${expectedSpecRef}'")
  }

  let bitLockText = readFile(a.projDir + "/bit.lock") catch e {
    fatal(a.name, "cannot read bit.lock: " + e.message())
    ""
  }
  let bitLockDoc = mustParseJson(a.name, "bit.lock", bitLockText)
  let entry = mustJsonGet(a.name, "bit.lock", bitLockDoc, a.depName)

  let vanityField = mustJsonString(a.name, "bit.lock ${a.depName} entry", entry, "vanity")
  if (vanityField != a.vanityName) {
    fatal(a.name, "bit.lock's vanity field is '${vanityField}', want '${a.vanityName}'")
  }
  let dirField = mustJsonString(a.name, "bit.lock ${a.depName} entry", entry, "dir")
  if (dirField != a.pkgSubdir) {
    fatal(a.name, "bit.lock's dir field is '${dirField}', want '${a.pkgSubdir}'")
  }
  // #4472: bit.json keeps the consumer's plain `1.0.0` (asserted above);
  // bit.lock records the REPOSITORY tag that plain version actually mapped
  // to. The prefix is the whole point — a `tag` reading `v1.0.0` here would
  // name the host repository's own release namespace.
  let versionField = mustJsonString(a.name, "bit.lock ${a.depName} entry", entry, "version")
  if (versionField != "1.0.0") {
    fatal(a.name, "bit.lock's version field is '${versionField}', want '1.0.0'")
  }
  checkLockTag(a.name, entry, "bit.lock ${a.depName} entry", "${a.depName}/v1.0.0")
  let urlField = mustJsonString(a.name, "bit.lock ${a.depName} entry", entry, "url")
  if (urlField != a.gitRemoteUrl) {
    fatal(a.name, "bit.lock's url field is '${urlField}', want '${a.gitRemoteUrl}'")
  }
  let commitField = mustJsonString(a.name, "bit.lock ${a.depName} entry", entry, "commit")
  if (!isFullSha(commitField)) {
    fatal(a.name, "bit.lock's commit field is not a 40-hex sha: '${commitField}'")
  }
  if (commitField != a.sha) {
    fatal(
      a.name,
      "bit.lock's commit field is '${commitField}', want '${a.sha}' (the fixture's own tagged commit)",
    )
  }
}
