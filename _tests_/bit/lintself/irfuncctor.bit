// #7075: no `irFuncOf(` call and no `IrFunc{` literal in compiler/ outside
// compiler/ir.bit and the `*check*.bit` fixture files.
//
// A field left off an `IrFunc{` literal zero-fills, and `keepAlive` is the one
// whose silent omission is memory corruption: #7039's `lowerTestDeclNamed`
// forgot it and every `test` body freed bytes a live interior pointer still
// read. #7066 routed every producer through `irFuncFromBuilder` /
// `irFuncRebuilt` / `irFuncRenamed` (compiler/ir.bit), which set `keepAlive`
// themselves, and left `irFuncOf` (no edges) for hand-built check fixtures.
// `irFuncOf` is still callable from any file of the module, so this scan is
// what keeps a new lowering path from using it.
//
// WHY A TEXT SCAN, NOT A `bit lint` RULE: which file may spell a constructor
// is project knowledge, not syntax or types. Same call as kidsview.bit.
//
// The formatter writes a literal as `IrFunc{`, never `IrFunc {`, which is also
// what keeps a return type (`): IrFunc {`) from matching.
//
// LIMITS: statements are matched one per line, `//` ends the line (a `//`
// inside a string literal ends it early), and a token inside a string literal
// still counts. selfTestIrFuncGate pins what is caught on a fixture.
import { readFile } from "std/fs"
import { hasPrefix, hasSuffix, indexOf, join, lastIndexOf, split } from "std/strings"

const irFile: string = "compiler/ir.bit"

// Whether `code` spells `needle` with no identifier byte just before it, so
// `xirFuncOf(` and `MyIrFunc{` are not the constructor.
fn spellsToken(code: string, needle: string): bool {
  let from = 0
  while (from < len(code)) {
    let p = indexOf(code[from:], needle)
    if (p < 0) {
      return false
    }
    let at = from + p
    if (at == 0 || !isIdentByte(code[at - 1])) {
      return true
    }
    from = at + 1
  }
  return false
}

fn spellsIrFuncCtor(code: string): bool {
  return spellsToken(code, "irFuncOf(") || spellsToken(code, "IrFunc{")
}

// ir.bit defines the constructors; a `*check*.bit` file builds fixture IR by hand.
fn mayBuildIrFunc(file: string): bool {
  if (file == irFile) {
    return true
  }
  let slash = lastIndexOf(file, "/")
  let base = file[slash + 1:]
  return hasSuffix(base, ".bit") && indexOf(base, "check") >= 0
}

fn irFuncCtorMessage(file: string, line: int): string {
  return "${file}:${line}: irFuncOf( / IrFunc{ outside compiler/ir.bit and *check*.bit files; build the function with irFuncFromBuilder, irFuncRebuilt or irFuncRenamed (compiler/ir.bit), which carry keepAlive (#7039, #7066, #7075)"
}

fn scanIrFuncCtor(file: string, text: string): []string {
  let hits = []string(0)
  if (mayBuildIrFunc(file)) {
    return hits
  }
  let lineNo = 0
  for raw of split(text, "\n") {
    lineNo = lineNo + 1
    if (spellsIrFuncCtor(codeOf(raw))) {
      hits = append(hits, irFuncCtorMessage(file, lineNo))
    }
  }
  return hits
}

// The shapes the scan must catch and must leave alone, so a rule that stops
// seeing one fails the harness instead of passing it.
fn selfTestIrFuncGate() {
  let bad = join(
    [
      "fn a(): IrFunc {",
      "  return irFuncOf(\"\", []int(0), 0, bs, is)", // 2
      "}",
      "fn b(): IrFunc {",
      "  return IrFunc{ name = \"x\" }", // 5
      "}",
      "fn c(): IrFunc {",
      "  let f = IrFunc{", // 8
      "  }",
      "}",
    ],
    "\n",
  )
  let want = [2, 5, 8]
  let hits = scanIrFuncCtor("compiler/lowerexpr.bit", bad)
  if (len(hits) != len(want)) {
    panic(
      "lintself: irfuncctor fixture: want ${len(want)} findings, got ${len(hits)}: ${join(
        hits,
        " | ",
      )}",
    )
  }
  let i = 0
  while (i < len(want)) {
    if (!hasPrefix(hits[i], "compiler/lowerexpr.bit:${want[i]}: ")) {
      panic("lintself: irfuncctor fixture: finding ${i} should be line ${want[i]}, got: ${hits[i]}")
    }
    i = i + 1
  }
  let ok = join(
    [
      "// irFuncOf( and IrFunc{ in a comment",
      "fn d(b: IrBuilder): IrFunc {",
      "  let g = xirFuncOf(1)", // not the constructor
      "  let h: MyIrFunc{} = 0",
      "  return irFuncFromBuilder(b, \"d\", []int(0), 0) // not irFuncOf(",
      "}",
    ],
    "\n",
  )
  let none = scanIrFuncCtor("compiler/lowerexpr.bit", ok)
  if (len(none) != 0) {
    panic("lintself: irfuncctor fixture: a clean function was flagged: ${join(none, " | ")}")
  }
  for exempt of ["compiler/ir.bit", "compiler/ircheck.bit", "compiler/x64selcheckmem.bit"] {
    if (len(scanIrFuncCtor(exempt, bad)) != 0) {
      panic("lintself: irfuncctor fixture: ${exempt} must be exempt")
    }
  }
  if (len(scanIrFuncCtor("compiler/irfuncs.bit", bad)) != 3) {
    panic("lintself: irfuncctor fixture: only compiler/ir.bit and *check*.bit are exempt")
  }
}

// Prints each finding over compiler/*.bit; true when there is one.
fn irFuncCtorGate(repo: string): bool {
  selfTestIrFuncGate()
  let hits = []string(0)
  let sawIr = false
  for path of collectBitFiles("${repo}/compiler", maxScanDepth) {
    let file = stripRepoPrefix(path, repo) catch e {
      panic("lintself: ${e.message()}")
    }
    sawIr = sawIr || file == irFile
    let text = readFile(path) catch e {
      panic("lintself: cannot read ${path}: ${e.message()}")
    }
    for h of scanIrFuncCtor(file, text) {
      hits = append(hits, h)
    }
  }
  if (!sawIr) {
    panic("lintself: ${irFile} was not walked; the irFuncOf scan would be blind")
  }
  for h of hits {
    eprint("${h}\n")
  }
  return len(hits) > 0
}
