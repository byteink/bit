// _tests_/bit/stringexplode/fixturesfallible.bit — the FALLIBLE half of the
// string-flip differential (#4601), a sibling in the same directory module as
// stringexplode.bit: one shared scope, no `import`, and `fixtures()` there
// picks these up by calling `fixturesFallible()`.
//
// WHAT THESE COVER, AND WHY THEY EXIST AFTER A REVERT. #4601 built the
// three-word return for a `string!E` declaration, measured it, and reverted
// it: `declPlainResultType` (lowerexplode.bit) carries the numbers and the
// mechanism. These fixtures are what survives, and they are the guard, not a
// leftover — nothing else in this harness compiled a `?` or a `catch` over a
// `string!` under the flip at all, so the width could have been widened again
// with no arm to notice.
//
//   fixture        what it exercises
//   -------------  ---------------------------------------------------------
//   failretbasic   `?`, `catch d`, `catch e { … }` and a `fail` that actually
//                  fires, over one `string!` — i.e. the err path's own `ret`
//                  as well as both ok paths
//   failretslice   the ok value is `s[lo:hi]`, so what crosses the return is
//                  an INTERIOR `ptr`, a `len` and the `base` that roots them;
//                  read back through `[i]` (a `ptr` use) and `==` (a `base`
//                  use), 25 crossings per run
//   failretedges   the positions that bind a fallible call result somewhere
//                  other than a direct call site — a function value, a
//                  `defer` and a discarded call — plus a METHOD returning
//                  `string!`, which `explodesParams` excludes and which
//                  therefore keeps the one-handle form in the same program
//   failretvoid    a `()!` ok type: `lowerCatch` returns `okv` outright and
//                  adds no join parameter, so nothing here may change
//   failretfield   PARITY PROBE: `let k = f()?` stored into a class field
//
// WHY `failretfield` IS THE ONLY PROBE. A probe that cannot fail is worse than
// no probe. Under the reverted (one-handle) compiler a `?`/`catch` with a WORD
// consumer allocates nothing in either arm — 8 objects gate-off, 8 gate-on —
// and it reads 8/8 under the widening too, so a probe on that shape asserts
// nothing. The FIELD consumer is the shape that moves: measured against the
// spike (`5bc0518e`) it goes 1017 objects gate-off, 2017 gate-on, because the
// caller must rebuild the box the callee stopped building. It is the `?` twin
// of `fixtureshandle.bit`'s `handlefield`, which covers the `catch` side and
// reddens on the same mutation.
//
// `allocCheck`'s strictly-fewer arm is wrong for every shape here: none of
// them deletes an allocation, so `parityCheck`'s gate-on <= gate-off is the
// only honest assertion.
//
// THE ORACLE IS THE GATE-OFF RUN, as it is for every fixture in this harness.

// The three groups exist only to keep each function under E0201's 80-line
// limit — `fixturesFallible` is the whole set, in this order.
fn fixturesFallible(): []Fixture {
  let out = []Fixture(0)
  for group of [fixturesFallibleRet(), fixturesFallibleEdges(), fixturesFallibleLoops()] {
    for f of group {
      out = append(out, f)
    }
  }
  return out
}

// The shared head of every fixture below: a `string!` producer whose ok value
// is a live handle out of a slice, and one whose ok value is a fresh slice.
// `pick` is deliberately NOT inlinable into its callers — it is fallible, and
// `optinlinecost` refuses a fallible callee outright — so the three words
// really do cross an ABI boundary in every fixture here.
fn falliblePrelude(): string {
  return "fn table(): []string {\n" +
    "  let xs = []string(0, 4)\n" +
    "  xs = append(xs, \"id\")\n" +
    "  xs = append(xs, \"name\")\n" +
    "  xs = append(xs, \"active\")\n" +
    "  xs = append(xs, \"tags\")\n" +
    "  return xs\n" +
    "}\n" +
    "fn pick(xs: []string, i: int): string! {\n" +
    "  if (i < 0) {\n" +
    "    fail newError(\"negative\")\n" +
    "  }\n" +
    "  return xs[i & 3]\n" +
    "}\n"
}

// `failretbasic` and `failretslice`: the value shapes an ok return can carry —
// a handle that already exists, and a freshly sliced one whose `ptr` is
// interior.
fn fixturesFallibleRet(): []Fixture {
  return [
    Fixture{
      name: "failretbasic",
      src: falliblePrelude() +
        "fn viaTry(xs: []string, i: int): string! {\n" +
        "  let s = pick(xs, i)?\n" +
        "  return s\n" +
        "}\n" +
        "fn main() {\n" +
        "  let xs = table()\n" +
        "  let a = pick(xs, 1) catch e { \"?\" }\n" +
        "  let b = pick(xs, 0 - 1) catch e { e.message() }\n" +
        "  let c = viaTry(xs, 2) catch e { \"!\" }\n" +
        "  let d = viaTry(xs, 0 - 1) catch e { \"boom:\" + e.message() }\n" +
        "  let n = len(a) + len(b) + len(c) + len(d)\n" +
        "  print(\"" +
        IS +
        "a} " +
        IS +
        "b} " +
        IS +
        "c} " +
        IS +
        "d} " +
        IS +
        "n}\\n\")\n" +
        "}\n",
    },
    // The ok value is a FRESH slice, so the words crossing the return are an
    // interior `ptr`, a `len` and the `base` that roots the bytes. Read back
    // through `[i]` (a `ptr` use) and through `==` (a `base` use).
    Fixture{
      name: "failretslice",
      src: "fn build(n: int): string {\n" +
        "  let out = \"\"\n" +
        "  let i = 0\n" +
        "  while (i < n) {\n" +
        "    out = out + \"abcdefgh\"\n" +
        "    i = i + 1\n" +
        "  }\n" +
        "  return out\n" +
        "}\n" +
        "fn window(s: string, at: int): string! {\n" +
        "  if (at + 8 > len(s)) {\n" +
        "    fail newError(\"out of range\")\n" +
        "  }\n" +
        "  return s[at:at + 8]\n" +
        "}\n" +
        "fn scan(s: string): int! {\n" +
        "  let n = 0\n" +
        "  let at = 0\n" +
        "  while (at + 8 <= len(s)) {\n" +
        "    let w = window(s, at)?\n" +
        "    n = n + int(w[0]) + len(w)\n" +
        "    if (w == \"abcdefgh\") { n = n + 1 }\n" +
        "    at = at + 1\n" +
        "  }\n" +
        "  return n\n" +
        "}\n" +
        "fn main() {\n" +
        "  let s = build(4)\n" +
        "  let n = scan(s) catch e { 0 - 1 }\n" +
        "  let bad = window(s, 900) catch e { \"E:\" + e.message() }\n" +
        "  print(\"" +
        IS +
        "n} " +
        IS +
        "bad}\\n\")\n" +
        "}\n",
    },
  ]
}

// `failretedges` and `failretvoid`: the binding positions a direct call site
// does not cover, and the void ok type that must stay parameter-less.
fn fixturesFallibleEdges(): []Fixture {
  return [
    // The three non-direct-call binding paths, plus a METHOD in the same
    // program: `explodesParams` excludes a method, so `Box.get` returns one
    // handle while `pick` returns three words, in one compilation unit.
    Fixture{
      name: "failretedges",
      src: falliblePrelude() +
        "class Box {\n" +
        "  f: string\n" +
        "  get(i: int): string! {\n" +
        "    if (i < 0) {\n" +
        "      fail newError(\"neg\")\n" +
        "    }\n" +
        "    return this.f\n" +
        "  }\n" +
        "}\n" +
        "fn main() {\n" +
        "  let xs = table()\n" +
        "  let fv = pick\n" +
        "  let a = fv(xs, 3) catch e { \"?\" }\n" +
        "  let b = Box{ f: \"boxed\" }.get(1) catch e { \"?\" }\n" +
        "  let c = Box{ f: \"boxed\" }.get(0 - 1) catch e { e.message() }\n" +
        "  let _ = pick(xs, 2)\n" +
        "  defer print(\"" +
        IS +
        "pick(xs, 0) catch e { \"?\" }}\\n\")\n" +
        "  print(\"" +
        IS +
        "a} " +
        IS +
        "b} " +
        IS +
        "c} " +
        IS +
        "len(a) + len(b) + len(c)}\\n\")\n" +
        "}\n",
    },
    // A void ok type. `lowerCatch` returns `okv` outright and adds no join
    // parameter at all; `localWordTypes(void)` is empty, so nothing here may
    // change. It is the arm that fails if the join explosion is keyed on
    // anything but the ok value's own width.
    Fixture{
      name: "failretvoid",
      src: "fn touch(n: int): ()! {\n" +
        "  if (n < 0) {\n" +
        "    fail newError(\"neg\")\n" +
        "  }\n" +
        "}\n" +
        "fn drive(n: int): ()! {\n" +
        "  touch(n)?\n" +
        "}\n" +
        "fn main() {\n" +
        "  let seen = \"\"\n" +
        "  drive(1) catch e { seen = seen + \"a\" }\n" +
        "  drive(0 - 1) catch e { seen = seen + e.message() }\n" +
        "  print(\"" +
        IS +
        "seen} " +
        IS +
        "len(seen)}\\n\")\n" +
        "}\n",
    },
  ]
}

// The loop shapes. `failretfield` is also the parity probe; the two word-
// consumer loops are differential fixtures only, for the reason the header
// gives — they read 8 objects in every arm of every compiler tried, so an
// allocation assertion on them could not fail.
fn fixturesFallibleLoops(): []Fixture {
  return [
    Fixture{
      name: "failretword",
      src: falliblePrelude() +
        "fn run(xs: []string): int! {\n" +
        "  let n = 0\n" +
        "  let i = 0\n" +
        "  while (i < 1000) {\n" +
        "    let s = pick(xs, i)?\n" +
        "    n = n + len(s)\n" +
        "    i = i + 1\n" +
        "  }\n" +
        "  return n\n" +
        "}\n" +
        "fn main() {\n" +
        "  print(\"" +
        IS +
        "run(table()) catch e { 0 - 1 }}\\n\")\n" +
        "}\n",
    },
    Fixture{
      name: "failcatchword",
      src: falliblePrelude() +
        "fn run(xs: []string): int {\n" +
        "  let n = 0\n" +
        "  let i = 0\n" +
        "  while (i < 1000) {\n" +
        "    let s = pick(xs, i) catch e { \"\" }\n" +
        "    n = n + len(s)\n" +
        "    i = i + 1\n" +
        "  }\n" +
        "  return n\n" +
        "}\n" +
        "fn main() {\n" +
        "  print(\"" +
        IS +
        "run(table())}\\n\")\n" +
        "}\n",
    },
    Fixture{
      name: "failretfield",
      src: falliblePrelude() +
        "class Slot { key: string, n: int }\n" +
        "fn run(xs: []string): int! {\n" +
        "  let out = []Slot(0, 8)\n" +
        "  let i = 0\n" +
        "  while (i < 1000) {\n" +
        "    let k = pick(xs, i)?\n" +
        "    out = append(out, Slot{ key: k, n: i })\n" +
        "    i = i + 1\n" +
        "  }\n" +
        "  return len(out) + len(out[999].key)\n" +
        "}\n" +
        "fn main() {\n" +
        "  print(\"" +
        IS +
        "run(table()) catch e { 0 - 1 }}\\n\")\n" +
        "}\n",
    },
  ]
}

// The fixtures that are also parity probes — see the header for why there is
// exactly one, and why `allocCheck`'s strictly-fewer arm is wrong for all of
// them.
fn fallibleProbeNames(): []string {
  return ["failretfield"]
}

// Runs every #4601 probe; returns (ran, failed). Kept here rather than in
// stringexplode.bit, which is 15 lines from the 800-line E0200 limit.
fn fallibleProbes(e: Env): (int, int) {
  let bad = 0
  for name of fallibleProbeNames() {
    if (!parityCheck(e, name)) {
      bad = bad + 1
    }
  }
  return len(fallibleProbeNames()), bad
}
