// _tests_/bit/stringexplode/stringexplode.bit — the differential gate for #3901's string
// flip, on by default since the owner ruling 2026-09-23 (#5755, #4411), and
// the ONLY thing that runs the `BIT_STRING_EXPLODE=0` off path.
//
// WHY IT HAD TO EXIST. #4431 landed the box/unbox coercion boundary behind
// that variable, #4437 wired it into five more container positions, and
// #4422 turned the producer on — and `git grep BIT_STRING_EXPLODE --
// _tests_ tools scripts` returned NOTHING before this file. Every gate in
// the suite runs with the variable unset, so the whole mechanism was
// unexecuted by anything: a green suite said only that the OFF path was
// unchanged, which is the weaker half of what has to be true.
//
// THE ORACLE IS THE PROGRAM'S OWN OUTPUT WITH THE GATE OFF, not a captured
// `.expected`. Explosion is a representation change and must be invisible, so
// the same source compiled both ways must print the same bytes and exit the
// same way. That makes the gate self-maintaining: adding a fixture below
// costs no sidecar, and a fixture whose answer nobody hand-computed is still
// a real check.
//
// A DIFFERENTIAL ALONE WOULD PASS IF THE FLIP STOPPED HAPPENING, which is the
// direction that reads as an all-clear. So `allocCheck` below also asserts
// that the slice-in-a-loop fixture allocates STRICTLY FEWER objects with the
// gate on. That is the arm that fails if `localWordTypes`, `StringRecv` or
// optstore's `slice_len` forwarding is reverted.
//
// A DIRECTORY MODULE since #4426, not a single file: `fixturescontainer.bit`
// is a sibling in the same scope (no `import`), and `runArgs` in
// tools/build/gatestable2.bit names the DIRECTORY. A single-file gate target
// never loads a sibling (#4441), so a fixture file dropped beside a
// `.bit`-suffixed target is silently ignored and the gate keeps passing while
// covering nothing.
//
// NO WRAPPER SCRIPT HERE MAY BE EXEC'D. Every one goes through
// `../trampoline`'s `runScript`, because macOS validates a file on its first
// exec and serializes that box-wide: at 278 fresh execs per run this gate took
// 881 of `./make test`'s 978 seconds (#4706), and 14m05s standalone beside six
// processes doing nothing but fresh execs. Writing a script is free; exec'ing a
// new one is not, and the trampoline's own inode never changes.
//
// The 90 FIXTURE BINARIES are a different matter and are exec'd directly, at
// full price. #4712 routed them through one reused inode too and #4713 took it
// back out: a rewritten inode is SIGKILLed by the provenance sandbox often
// enough to redden this gate once per suite run. `runCmd` below and
// `../trampoline`'s header carry the measurements.
//
// WIRED INTO `./make test` as `test-string-explode`.

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"
import { runScript } from "../trampoline"
import { returnsInRegisters } from "../retabi"
import { parseInt, trimSpace, indexOf } from "std/strings"

const defaultTimeoutS: int = 120
const maxTimeoutMs: int = 6000000

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("stringexplode: ${name} is not set — refusing to guess.\n")
    exit(2)
  }
  return v
}

fn timeoutMs(): int {
  let raw = trimSpace(envOr("BIT_TEST_TIMEOUT_S", ""))
  if (raw == "") {
    return defaultTimeoutS * 1000
  }
  let s = parseInt(raw) catch _ {
    return defaultTimeoutS * 1000
  }
  if (s <= 0) {
    return maxTimeoutMs
  }
  if (s * 1000 > maxTimeoutMs) {
    return maxTimeoutMs
  }
  return s * 1000
}

// #5761: remove `dir` and everything under it so a run does not leak scratch
// under $TMPDIR. Copy of `_tests_/bit/deferblock.bit:181`'s `teardown` —
// `exit()` does not run pending defers (#3677), so this must be called
// explicitly at every exit site once `dir` exists.
fn teardown(dir: string, ms: int) {
  let shPath = dir + "/rm.sh"
  writeFile(shPath, "#!/bin/sh\nrm -rf '${dir}'\n") catch _ {
    return
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    return
  }
  osRunBounded(shPath, ms)
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

class Fixture {
  name: string,
  src: string,
}

// Each fixture is a whole program whose output is a pure function of its
// source, so the two compilations can be compared directly. They are chosen
// to cover one position each, because #4412's receipt is that a coercion
// missed at ONE position prints a wrong answer at exit 0 while every other
// position still passes.
// `${` cannot appear inside a fixture's source literal — the harness's own
// lexer would read it as an interpolation of the harness, and the `\"` inside
// it as a stray backslash. `IS` supplies the two characters at runtime, so a
// fixture can still print with interpolation, which is what real Bit source
// does.
const IS: string = "$" + "{"

// The producer, the receiver chain and the two inline readers.
fn fixturesCore(): []Fixture {
  return [
    // The producer itself, and `allocCheck`'s probe. BOTH the receiver and
    // the result are exploded LOCALS, and that is deliberate: with the
    // receiver a PARAMETER instead, `emitInlineStringSlice` takes the boxed
    // path and a mutation deleting `lowerStringRecv`'s word arm passes
    // unnoticed — measured against that mutant, not assumed. The slice
    // crosses an if-join and a loop back edge and is consumed only by `len`.
    Fixture{
      name = "loop_len",
      src = "fn main() {\n" +
        "  let s = \"abcdefghijklmnopqrst\"\n  let n = 0\n  let w = 0\n" +
        "  while (w < len(s) - 8) {\n    let a = s[w:w + 8]\n" +
        "    if (len(a) == 8) { n = n + 1 }\n    w = w + 1\n  }\n" +
        "  print(\"" +
        IS +
        "n}\\n\")\n}\n",
    },
    // A slice of a slice: the receiver arrives as words and the result's
    // `base` word must still root the bytes.
    Fixture{
      name = "chained",
      src = "fn main() {\n" +
        "  let s = \"abcdefghij\"\n  let a = s[2:9]\n  let b = a[1:5]\n" +
        "  print(\"" +
        IS +
        "a} " +
        IS +
        "b} " +
        IS +
        "len(b)} " +
        IS +
        "b[0]}\\n\")\n}\n",
    },
    // Omitted bounds, both directions, plus a byte index through a sliced
    // local — the `s[i]` twin of the slice.
    Fixture{
      name = "bounds",
      src = "fn main() {\n" +
        "  let s = \"0123456789\"\n  let a = s[3:]\n  let b = s[:4]\n" +
        "  print(\"" +
        IS +
        "a} " +
        IS +
        "b} " +
        IS +
        "a[0]} " +
        IS +
        "b[3]} " +
        IS +
        "len(a)} " +
        IS +
        "len(b)}\\n\")\n}\n",
    },
    // Equality: `rt_call string_eq`, which takes ONE boxed word, so an
    // exploded value has to be boxed back on the way in.
    Fixture{
      name = "equality",
      src = "fn main() {\n" +
        "  let s = \"abcabcabc\"\n  let a = s[0:3]\n  let b = s[3:6]\n  let c = s[1:4]\n" +
        "  print(\"" +
        IS +
        "a == b} " +
        IS +
        "a == c} " +
        IS +
        "a != c}\\n\")\n}\n",
    },
  ]
}

// #4423: the ARGUMENT position, which now passes three words to an eligible
// callee instead of one handle. The two fixtures here differ in ONE property
// and it is the one that matters — whether the words fit the eight
// integer argument registers.
fn fixturesArgs(): []Fixture {
  return [
    // Inside the budget: two 3-word strings plus an int is 7 int words, so
    // every word arrives in a register and no stack slot is touched.
    Fixture{
      name = "argregs",
      src = "fn pick(a: string, b: string, k: int): string {\n" +
        "  if (k == 0) { return a }\n  return b\n}\n" +
        "fn main() {\n  let s = \"abcdefghijklmnop\"\n" +
        "  let a = s[0:6]\n  let b = s[6:16]\n" +
        "  print(\"" +
        IS +
        "pick(a, b, 0)} " +
        IS +
        "pick(a, b, 1)} " +
        IS +
        "len(pick(b, a, 0))}\\n\")\n}\n",
    },
    // ACROSS the budget, which is the arm #4004 measured at +9.418% cycles
    // and the one the census says goes from 11 functions to 78 under a
    // 3-word string. `mix` takes 1 + 4*3 = 13 int words, so five of them
    // marshal through `emitOutgoingStackArg` into the caller's outgoing
    // area; `cat4` takes 12 and spills four.
    //
    // Every word of every argument is load-bearing in the printed answer:
    // `a[0]` reads the `ptr` word, `len(a)` the `len` word, and `cat4`
    // concatenates through `base`. A word dropped, truncated or read from
    // the wrong stack offset changes the output — which is the property
    // #4412 did not have when `take4((1,2,3,4))` printed 1200 for 1234 at
    // exit 0 past every gate in the suite.
    Fixture{
      name = "argoverflow",
      src = "fn mix(n: int, a: string, b: string, c: string, d: string): int {\n" +
        "  return (int(a[0]) + int(b[0]) + int(c[0]) + int(d[0])) * 100 +\n" +
        "    len(a) * 8 + len(b) * 4 + len(c) * 2 + len(d) + n\n}\n" +
        "fn cat4(a: string, b: string, c: string, d: string): string {\n" +
        "  return a + \"-\" + b + \"-\" + c + \"-\" + d\n}\n" +
        "fn main() {\n  let s = \"abcdefghijklmnopqrstuvwxyz\"\n" +
        "  let a = s[0:5]\n  let b = s[5:11]\n  let c = s[11:18]\n  let d = s[18:26]\n" +
        "  print(\"" +
        IS +
        "mix(7, a, b, c, d)} " +
        IS +
        "cat4(a, b, c, d)} " +
        IS +
        "mix(0, d, c, b, a)}\\n\")\n}\n",
    },
  ]
}

// The two argument-position hazards that are not about the register budget:
// a parameter's `base` word staying alive, and a declaration whose parameter
// list does not describe what arrives.
fn fixturesArgEdges(): []Fixture {
  return [
    // The keepalive edges `recordParamKeepAlive` records from the SIGNATURE
    // (#4406). `a` arrives as three words; the loop reads only `a[0]`, which
    // is the interior `ptr` word, and allocates on every iteration. Nothing
    // but the ptr->base edge keeps the bytes under that pointer from being
    // swept, and `gcOwns` is exact base equality, so an interior word roots
    // nothing by itself. The symptom of losing this is a wrong `acc`, not a
    // crash.
    Fixture{
      name = "argacrossgc",
      src = "fn scan(a: string, n: int): int {\n" +
        "  let acc = 0\n  let i = 0\n" +
        "  while (i < n) {\n    let junk = [i, i + 1, i + 2]\n" +
        "    acc = acc + junk[0] + a[0]\n    i = i + 1\n  }\n  return acc\n}\n" +
        "fn main() {\n" +
        "  let s = \"the quick brown fox jumps over the lazy dog\"\n" +
        "  print(\"" +
        IS +
        "scan(s[4:9], 20000)} " +
        IS +
        "scan(s[10:15], 5000)}\\n\")\n}\n",
    },
    // A VARIADIC tail is `...parts: string` in the declaration but a
    // `[]string` in the callee's frame, so `explodesParams` excludes the
    // whole declaration (#4423). Without that exclusion the callee takes
    // three block parameters for a one-word slice; `_tests_/cases/run_variadic.bit`
    // is the shape, and this is it under the gate.
    Fixture{
      name = "variadic",
      src = "fn joinAll(sep: string, ...parts: string): string {\n" +
        "  let out = \"\"\n  let i = 0\n" +
        "  while (i < len(parts)) {\n" +
        "    if (i != 0) { out = out + sep }\n    out = out + parts[i]\n    i = i + 1\n  }\n" +
        "  return out\n}\n" +
        "fn main() {\n  let s = \"alphabetagamma\"\n" +
        "  print(\"" +
        IS +
        "joinAll(\\\"-\\\", s[0:5], s[5:9], s[9:14])} " +
        IS +
        "joinAll(\\\",\\\")}\\n\")\n}\n",
    },
  ]
}

// #4432: a `string` ERROR value at the one-word `err_get`/`err_set` slot,
// covered once per SOURCE the value can arrive from — a PARAMETER, an
// exploded LOCAL, and a direct CALL result — because each has its own
// rebuild call site (`localRead`, `materializeExplodedLocal`,
// `emitResolvedCall`) and a mutation to one does not touch the others. Split
// out of fixturesArgEdges (E0201, 111 lines) rather than folded into it: this
// group answers one question — does the err slot ever see a truncated
// aggregate — and fixturesArgEdges answers a different one about the
// register/stack budget.
fn fixturesFailErr(): []Fixture {
  return [
    // The PARAMETER case: `errNeedsBox` answers `false` for `string` (it is
    // `isRefType`), so the one-word err slot takes whatever `boxErrForSlot`
    // hands it — and what it hands it is `coerceStringToBoxed`'s box,
    // because `fail s` reads `s` through `localRead`, which materializes the
    // aggregate for a use that wants the whole thing. This fixture is the
    // evidence for that claim rather than the argument for it.
    Fixture{
      name = "failstrerr",
      src = "fn firstWord(s: string): string!string {\n" +
        "  let i = 0\n  while (i < len(s)) {\n" +
        "    if (s[i] == 32) { return s[0:i] }\n    i = i + 1\n  }\n  fail s\n}\n" +
        "fn main() {\n  let src = \"hello world again\"\n" +
        "  let a = firstWord(src[0:11]) catch e { \"err:\" + e }\n" +
        "  let b = firstWord(src[12:17]) catch e { \"err:\" + e }\n" +
        "  print(\"" +
        IS +
        "a} " +
        IS +
        "b}\\n\")\n}\n",
    },
    // The exploded-LOCAL case (`let v = src[lo:hi]`, #4586's
    // `stringLetExplodes`) — `materializeExplodedLocal` (lowerexplodestr.bit)
    // is the rebuild `localRead` calls for THIS binding kind, a different
    // call site than `failstrerr`'s. Propagated both ways: `mkLocalErr` is
    // caught directly, `viaTryLocalErr` re-publishes it through `?` first.
    Fixture{
      name = "faillocalexplode",
      src = "fn mkLocalErr(src: string, lo: int, hi: int): string!string {\n" +
        "  let v = src[lo:hi]\n  fail v\n}\n" +
        "fn viaTryLocalErr(src: string, lo: int, hi: int): string!string {\n" +
        "  let v = mkLocalErr(src, lo, hi)?\n  return v\n}\n" +
        "fn main() {\n  let src = \"hello world again\"\n" +
        "  let a = mkLocalErr(src, 0, 5) catch e { \"caught:\" + e }\n" +
        "  let b = viaTryLocalErr(src, 6, 11) catch e { \"prop:\" + e }\n" +
        "  print(\"" +
        IS +
        "a} " +
        IS +
        "b}\\n\")\n}\n",
    },
    // The direct-CALL-result case: the error expression is the result of a
    // plain-`string`-returning call (#4424's 3-register return), never bound
    // to a name — `emitResolvedCall` (lowerprim.bit) rebuilds the box at the
    // call site itself, a third call site distinct from both `failstrerr`
    // and `faillocalexplode` above. `scanErr` has a loop so it is not folded
    // away before the ABI crossing this fixture targets. Propagated both
    // ways, same as the local case.
    Fixture{
      name = "failcallexplode",
      src = "fn scanErr(s: string, w: int): string {\n" +
        "  let e = w\n  while (e < len(s) && e - w < 6) { e = e + 1 }\n" +
        "  return s[w:e]\n}\n" +
        "fn mkCallErr(s: string, w: int): string!string {\n  fail scanErr(s, w)\n}\n" +
        "fn viaTryCallErr(s: string, w: int): string!string {\n" +
        "  let v = mkCallErr(s, w)?\n  return v\n}\n" +
        "fn main() {\n  let s = \"hello world again\"\n" +
        "  let a = mkCallErr(s, 0) catch e { \"caught:\" + e }\n" +
        "  let b = viaTryCallErr(s, 6) catch e { \"prop:\" + e }\n" +
        "  print(\"" +
        IS +
        "a} " +
        IS +
        "b}\\n\")\n}\n",
    },
  ]
}

// Every position that stays BOXED until #4424/#4426: a return, five
// container slots, a null header, and a value held live across collections.
fn fixturesBoundary(): []Fixture {
  return [
    // The RETURN position, which #4424 has not flipped and which must still
    // hand back one boxed word — while the ARGUMENTS of the same two
    // functions now arrive as three words each (#4423).
    Fixture{
      name = "callret",
      src = "fn mid(s: string): string { return s[1:len(s) - 1] }\n" +
        "fn wrap(a: string, b: string): string { return a + \"|\" + b }\n" +
        "fn main() {\n  let s = \"xhellox\"\n  let m = mid(s)\n" +
        "  print(\"" +
        IS +
        "wrap(m, m[1:3])} " +
        IS +
        "len(m)}\\n\")\n}\n",
    },
    // Container positions, all five #4437 wired: slice element, map key,
    // map value, class field, closure capture.
    Fixture{
      name = "containers",
      src = "class Box { f: string }\n" +
        "fn main() {\n  let s = \"alphabetsoup\"\n  let xs = [s[0:5], s[5:8]]\n" +
        "  let m = map<string, string>{}\n  m[s[0:5]] = s[5:8]\n" +
        "  let bx = Box{f = s[2:6]}\n  let cap = s[1:4]\n  let f = () => cap + \"!\"\n" +
        "  print(\"" +
        IS +
        "xs[0]} " +
        IS +
        "xs[1]} " +
        IS +
        "m[s[0:5]]} " +
        IS +
        "bx.f} " +
        IS +
        "f()}\\n\")\n}\n",
    },
    // A zero-valued class's string field is the NULL word, not an empty
    // header, and every word read goes through the same `isHeaderBase`
    // guard. Slicing it must stay a 0-length answer rather than a fault.
    Fixture{
      name = "nullfield",
      src = "class Z { f: string, n: int }\n" +
        "fn main() {\n  let z = Z{}\n  let a = z.f[0:0]\n  let empty = \"\"\n" +
        "  print(\"" +
        IS +
        "len(a)} " +
        IS +
        "len(z.f)} " +
        IS +
        "a == empty}\\n\")\n}\n",
    },
    // A slice kept live across an allocation-heavy loop: the interior `ptr`
    // word must not outlive the `base` word that roots it (#4406/#4425).
    Fixture{
      name = "acrossgc",
      src = "fn main() {\n" +
        "  let s = \"the quick brown fox jumps over the lazy dog\"\n" +
        "  let a = s[4:9]\n  let acc = 0\n  let i = 0\n" +
        "  while (i < 20000) {\n    let junk = [i, i + 1, i + 2]\n" +
        "    acc = acc + junk[0] + a[0]\n    i = i + 1\n  }\n" +
        "  print(\"" +
        IS +
        "a} " +
        IS +
        "acc}\\n\")\n}\n",
    },
  ]
}

fn fixtures(): []Fixture {
  let out = fixturesCore()
  for group of [
    fixturesArgs(), fixturesArgEdges(), fixturesFailErr(), fixturesBoundary(),
    fixturesRet(), fixturesRetBind(), fixturesRetDefer(), fixturesRetEdges(),
    fixturesContainer(), fixturesHandle(), fixturesFallible(),
  ] {
    for f of group {
      out = append(out, f)
    }
  }
  return out
}

// A `/bin/sh` command that runs `exe`. Each of the 90 binaries this harness
// builds per run is a first exec, and macOS charges ~440ms for one, serialized
// box-wide (#4712 — 2m37s alone, 14m05s beside six processes doing nothing but
// fresh execs). That charge is PAID here on purpose.
//
// #4712 avoided it by copying each build over one long-lived inode
// (`../trampoline`'s `binRunner`) and exec'ing that: 881s -> 17s inside
// `./make test`. #4713 measured what it cost: rewriting an inode's content
// races the kernel's per-vnode provenance record, and the exec is SIGKILLed
// before the program's first instruction —
//
//     AppleSystemPolicy: ASP: Unable to apply provenance sandbox: 268451845, …
//
// — which reads back as exit 137 with empty stdout. Across three `./make test`
// runs on 2026-09-10, ALL 43 `Killed: 9` lines named a rewritten `run.bin` and
// NOT ONE named a fresh inode; one of them landed on this gate's `retdefer`
// case ("gate off exit 137 / gate on exit 0"). Under load, one gate per suite
// run died this way. `../trampoline`'s header carries the four alternatives
// that were measured and rejected. A slow green beats a fast flake.
fn runCmd(exe: string): string {
  return shQuote(exe)
}

// Runs `bin build <src> -o <bin>` then the binary, with `extraEnv` lines
// exported first. Returns (exit code, stdout, stderr).
fn runOne(dir: string, tag: string, cmd: string, extraEnv: string): (int, string, string) {
  let shPath = "${dir}/${tag}.sh"
  let outPath = "${dir}/${tag}.out"
  let errPath = "${dir}/${tag}.err"
  let script = "#!/bin/sh\n" +
    extraEnv +
    cmd +
    " > " +
    shQuote(outPath) +
    " 2> " +
    shQuote(errPath) +
    "\n"
  let code = runScript(shPath, script, timeoutMs()) catch e {
    eprint("stringexplode: cannot run ${shPath}: ${e.message()}\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  let out = readFile(outPath) catch _ {
    ""
  }
  let err = readFile(errPath) catch _ {
    ""
  }
  return code, out, err
}

class Env {
  bin: string,
  stdlib: string,
  libbitrt: string,
  dir: string,
}

fn baseEnv(e: Env): string {
  return "BIT_STDLIB=" +
    shQuote(e.stdlib) +
    "\nexport BIT_STDLIB\n" +
    "BIT_LIBBITRT=" +
    shQuote(e.libbitrt) +
    "\nexport BIT_LIBBITRT\n"
}

// Owner ruling 2026-09-23 (#5755, #4411): the flip is ON by default, so
// unset means on and `BIT_STRING_EXPLODE=0` means off. The gate-off arm must
// export `=0`, not merely decline to set the variable — `runOne`'s script
// INHERITS this harness's own environment, so running the harness itself
// under an inherited `BIT_STRING_EXPLODE=0` — the #5727 shape, now on the
// other arm — would make every "off" child build gate-ON unless this arm
// actively overrides it. The gate-on arm actively unsets the variable for
// the same reason, in case the harness inherited `=0` from its own caller.
// Measured on 2613ed92e, arm64-macos (pre-flip default, #5727's fix): with
// the off arm genuinely off the probes read 18 objects off and 6 on, and the
// 12-object gap is exactly the loop's 12 slices (widening the fixture's
// literal to 112 iterations moves the off count to 118 and leaves the on
// count at 6).
fn gateEnv(on: bool): string {
  if (on) {
    return "unset BIT_STRING_EXPLODE\n"
  }
  return "BIT_STRING_EXPLODE=0\nexport BIT_STRING_EXPLODE\n"
}

// Compiles `srcPath` with the gate in state `on`, then runs the result.
fn buildAndRun(e: Env, srcPath: string, tag: string, on: bool): (int, string, string) {
  let exe = "${e.dir}/${tag}.bin"
  let gate = gateEnv(on)
  let (bc, bout, berr) = runOne(
    e.dir, "${tag}.build", shQuote(e.bin) + " build " + shQuote(srcPath) + " -o " + shQuote(exe),
    baseEnv(e) + gate,
  )
  if (bc != 0) {
    return bc, bout, "build failed: " + berr
  }
  return runOne(e.dir, "${tag}.run", runCmd(exe), "")
}

// swept+live out of a `[bit-gc] ...` stderr line: the object count for the
// whole run, which is deterministic and load-insensitive.
fn gcObjects(err: string): int {
  let sw = indexOf(err, "swept=")
  let lv = indexOf(err, "live=")
  if (sw < 0 || lv < 0) {
    return -1
  }
  let a = parseInt(fieldAt(err, sw + 6)) catch _ {
    return -1
  }
  let b = parseInt(fieldAt(err, lv + 5)) catch _ {
    return -1
  }
  return a + b
}

fn fieldAt(s: string, start: int): string {
  let i = start
  while (i < len(s) && s[i] != 32 && s[i] != 10) {
    i = i + 1
  }
  return s[start:i]
}

// One allocation probe: the fixture it runs, and what the flip must do to the
// object count.
class AllocProbe {
  name: string,
  wantFewer: bool,
}

// #4730: `retscan`'s saving is the multi-word RETURN, and that convention is
// off on both x86_64 targets (`targetReturnsInRegisters`, compiler/build.bit),
// where the words cannot come back in registers and the caller's box stays —
// so there the flip must remove nothing. Which convention this host owes is
// answered by _tests_/bit/retabi, independently of the compiler under test.
// `loop_len` is the PRODUCER side — a local bound to `s[lo:hi]` explodes on
// every target — so it wants strictly fewer either way.
fn allocProbes(e: Env): []AllocProbe {
  let inRegs = returnsInRegisters(e.dir, timeoutMs()) catch err {
    eprint("stringexplode: cannot determine this host's multi-word return ABI: ${err.message()}\n")
    teardown(e.dir, timeoutMs())
    exit(2)
  }
  return [
    AllocProbe{ name = "loop_len", wantFewer = true },
    AllocProbe{ name = "retscan", wantFewer = inRegs },
  ]
}

// The arm that fails when the flip stops flipping. A differential alone
// cannot tell "explodes correctly" from "no longer explodes at all".
//
// Run per PROBE rather than once: `loop_len` covers #4422's producer (a
// `s[lo:hi]` bound to a local) and `retscan` covers #4424's return ABI (a
// non-inlinable callee whose result crosses the boundary as three words).
// One probe cannot fail for the other's revert — `loop_len` allocates
// nothing either way once the local explodes, whatever the return side does.
fn allocCheck(e: Env, p: AllocProbe): bool {
  let srcPath = "${e.dir}/${p.name}.bit"
  let (c1, o1, e1) = runGcStats(e, srcPath, "${p.name}.alloc.off", false)
  let (c2, o2, e2) = runGcStats(e, srcPath, "${p.name}.alloc.on", true)
  if (c1 != 0 || c2 != 0) {
    eprint("stringexplode: FAIL — ${p.name} alloc probe exited ${c1}/${c2}\n${e1}\n${e2}\n")
    return false
  }
  if (o1 != o2) {
    eprint("stringexplode: FAIL — ${p.name} alloc probe printed ${o1} vs ${o2}\n")
    return false
  }
  let n1 = gcObjects(e1)
  let n2 = gcObjects(e2)
  if (n1 < 0 || n2 < 0) {
    eprint("stringexplode: FAIL — no [bit-gc] line; BIT_GC_STATS=1 did not take\n")
    return false
  }
  return allocVerdict(p, n1, n2)
}

// Split from allocCheck so each half stays inside E0204's complexity ceiling.
// The `wantFewer: false` arm is an EQUALITY, not a relaxation: on a target
// that boxes the result the flip must remove nothing and must not add
// anything either, so a regression in either direction still fails here.
fn allocVerdict(p: AllocProbe, n1: int, n2: int): bool {
  if (p.wantFewer && n2 >= n1) {
    eprint("stringexplode: FAIL — ${p.name} flip removed no allocation: ${n1} objects off, ${n2} on (want strictly fewer)\n")
    return false
  }
  if (!p.wantFewer && n1 != n2) {
    eprint("stringexplode: FAIL — ${p.name} flip changed the object count on a target that boxes multi-word returns: ${n1} objects off, ${n2} on (want equal)\n")
    return false
  }
  println("stringexplode: ${p.name} alloc probe — ${n1} objects gate-off, ${n2} gate-on")
  return true
}

fn runGcStats(e: Env, srcPath: string, tag: string, on: bool): (int, string, string) {
  let exe = "${e.dir}/${tag}.bin"
  let gate = gateEnv(on)
  let (bc, _, berr) = runOne(
    e.dir, "${tag}.build", shQuote(e.bin) + " build " + shQuote(srcPath) + " -o " + shQuote(exe),
    baseEnv(e) + gate,
  )
  if (bc != 0) {
    return bc, "", berr
  }
  return runOne(e.dir, "${tag}.run", runCmd(exe), "BIT_GC_STATS=1\nexport BIT_GC_STATS\n")
}

fn writeFixture(dir: string, fx: Fixture): string {
  let srcPath = "${dir}/${fx.name}.bit"
  writeFile(srcPath, fx.src) catch e {
    eprint("stringexplode: cannot write ${srcPath}: ${e.message()}\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  return srcPath
}

fn checkFixture(e: Env, fx: Fixture): bool {
  let srcPath = writeFixture(e.dir, fx)
  let (c1, o1, e1) = buildAndRun(e, srcPath, "${fx.name}.off", false)
  let (c2, o2, e2) = buildAndRun(e, srcPath, "${fx.name}.on", true)
  if (c1 != c2 || o1 != o2) {
    eprint("stringexplode: FAIL ${fx.name} — gate off exit ${c1} / gate on exit ${c2}\n")
    eprint("  off stdout: ${o1}\n  on  stdout: ${o2}\n")
    eprint("  off stderr: ${e1}\n  on  stderr: ${e2}\n")
    return false
  }
  return true
}

// #4432: the two err-explode fixtures also run under `BIT_GC=stress`,
// because the interior-pointer hazard in this area is live, not
// hypothetical — a probe has printed correctly by default and garbage under
// stress, exit 0 both times (#4406). Reruns the SAME gate-on binary
// `checkFixture` already built for `name`, once plain and once stressed, so
// no extra `bit build` is paid.
fn errExplodeStressCheck(e: Env, name: string): bool {
  let exe = "${e.dir}/${name}.on.bin"
  let (c1, o1, e1) = runOne(e.dir, "${name}.stress.plain", runCmd(exe), "")
  let (c2, o2, e2) = runOne(
    e.dir, "${name}.stress.run", runCmd(exe), "BIT_GC=stress\nexport BIT_GC\n",
  )
  if (c1 != 0 || c2 != 0 || o1 != o2) {
    eprint("stringexplode: FAIL ${name} under BIT_GC=stress — plain exit ${c1} '${o1}', stress exit ${c2} '${o2}'\n${e1}\n${e2}\n")
    return false
  }
  println("stringexplode: ${name} — BIT_GC=stress matched (${o1})")
  return true
}

fn main() {
  let e = Env{
    bin = requiredEnv("BIT_BIN"),
    stdlib = requiredEnv("BIT_STDLIB"),
    libbitrt = requiredEnv("BIT_LIBBITRT"),
    dir = envOr("TMPDIR", "/tmp") + "/bit-stringexplode-${timeUnixNs()}",
  }
  mkdir(e.dir) catch err {
    eprint("stringexplode: cannot create ${e.dir}: ${err.message()}\n")
    exit(2)
  }
  let fxs = fixtures()
  let ok = 0
  let bad = 0
  for fx of fxs {
    if (checkFixture(e, fx)) {
      ok = ok + 1
    } else {
      bad = bad + 1
    }
  }
  let probes = allocProbes(e)
  for probe of probes {
    if (!allocCheck(e, probe)) {
      bad = bad + 1
    }
  }
  // #4432's BIT_GC=stress arm, over the .on.bin the fxs loop above already
  // built for these two names.
  let stressNames = ["faillocalexplode", "failcallexplode"]
  for name of stressNames {
    if (!errExplodeStressCheck(e, name)) {
      bad = bad + 1
    }
  }
  // #4586's parity probes, driven from fixtureshandle.bit.
  let (pran, pbad) = handleProbes(e)
  bad = bad + pbad
  // #4601's fallible-return parity probe, driven from fixturesfallible.bit.
  let (fran, fbad) = fallibleProbes(e)
  bad = bad + fbad
  if (bad != 0) {
    eprint("stringexplode: FAIL — ${bad} of ${len(fxs) + len(probes) + len(stressNames) + pran + fran} check(s) failed\n")
    teardown(e.dir, timeoutMs())
    exit(1)
  }
  teardown(e.dir, timeoutMs())
  println("stringexplode: PASS — ${ok}/${len(fxs)} fixtures byte-identical with the explode gate on and off, plus ${len(probes) + fran} allocation/parity probe(s) and ${pran} handle parity probe(s)")
}
