// _tests_/bit/stringexplode/fixturescontainer.bit — the CONTAINER half of the
// string-flip differential (#4426), a sibling in the same directory module as
// stringexplode.bit: one shared scope, no `import`, and `fixtures()` there
// picks these up by calling `fixturesContainer()`.
//
// WHY A SIBLING AND NOT MORE LINES IN stringexplode.bit. That file was 771 of
// the 800-line E0200 limit, and it was registered as a SINGLE-FILE gate target
// (`runArgs("_tests_/bit/stringexplode.bit")`). A single-file target's
// `loadModuleAt` never looks at directory siblings (#4441), so a second file
// dropped beside it would have been silently ignored — the gate would have
// gone on passing while covering nothing new. #4426 therefore moved the
// harness into `_tests_/bit/stringexplode/`, pointed `runArgs` at the
// DIRECTORY, and added the matching `gates_for_file` arm in
// scripts/gate-filemap.sh (without it, `assert_dirgates_current` fails and
// every file in here would force bucket `full`).
//
// WHAT THESE COVER: the positions #4005 enumerated as needing a coercion, and
// which #4426 measured as needing none, because the value at each of them is
// already the boxed handle the container slot holds.
//
//   fixture       positions / runtime entry points
//   ----------    -----------------------------------------------------------
//   slicelem      `[]string` literal, `append` (bit_rt_slice_append), element
//                 store (bit_rt_slice_set or the inline store), element read
//                 (bit_rt_slice_get or the inline read), and an element read
//                 that is then RESLICED
//   mapstr        `map<string,string>` literal, index store (bit_rt_map_set),
//                 index read (bit_rt_map_get), comma-ok hit AND miss
//                 (bit_rt_map_slot + bit_rt_map_val_at), `delete`
//                 (bit_rt_map_delete), `for (k, v) of m` and `for k in m`
//                 (bit_rt_map_key_at, bit_rt_map_val_at)
//   chanstr       `chan<string>` send, unary `<- ch`, two-result `(v, ok)`,
//                 and `for v of ch` over a spawned producer with `close`
//   classfield    a string-typed class field: literal init, store, read,
//                 read-modify-write, a read passed to a function, a read that
//                 is then sliced, and the NULL field of a zero-valued class
//   mapkeyslice   the #4446 shape — `m[keys[j]]`, an element that is ALREADY a
//                 boxed handle used directly as a map key, 1000 times. This is
//                 where the container regression lived: before #4426 each of
//                 those crossings unboxed the handle and allocated a second
//                 identical box, 12,450,003 of them in `bench/cases/strmap`
//   fieldslice    the `bench/cases/json` lexer shape — `p.source[i]` and
//                 `p.source[a:b]` off a class field, 10,000 byte reads
//
// THE ORACLE IS THE GATE-OFF RUN, as it is for every fixture in this harness:
// explosion is a representation change and must be invisible, so the same
// source compiled both ways must print the same bytes and exit the same way.
// `_tests_/bit/stringkeepalive.bit` carries the same four containers in ONE
// program under BIT_GC=stress, which is the arm this file deliberately does
// not duplicate.

// The three groups exist only to keep each function under E0201's 80-line
// limit — `fixturesContainer` below is the whole set, in this order.
fn fixturesContainer(): []Fixture {
  let out = []Fixture(0)
  for group of [
    fixturesContainerSlices(), fixturesContainerChanField(), fixturesContainerReuse(), fixturesContainerField(),
  ] {
    for f of group {
      out = append(out, f)
    }
  }
  return out
}

fn fixturesContainerSlices(): []Fixture {
  return [
    // `[]string`: a literal built from two slices of a heap string, two
    // appends, an element store, element reads in a loop, and an element read
    // that is itself resliced (`xs[2][2:5]`). Every element that goes in is a
    // VIEW of a heap string, not a literal, so `base` is a real object.
    Fixture{
      name: "slicelem",
      src: "fn main() {\n" +
        "  let s = \"alpha-bravo-charlie-delta\"\n" +
        "  let xs = [s[0:5], s[6:11]]\n" +
        "  xs = append(xs, s[12:19])\n" +
        "  xs = append(xs, s[20:25])\n" +
        "  xs[1] = xs[1] + \"!\"\n" +
        "  let out = \"\"\n" +
        "  let i = 0\n" +
        "  while (i < len(xs)) {\n" +
        "    out = out + xs[i] + \";\"\n" +
        "    i = i + 1\n" +
        "  }\n" +
        "  let first = xs[0]\n" +
        "  let mid = xs[2][2:5]\n" +
        "  print(out + first + \" \" + mid + \" " +
        IS +
        "len(xs)}\\n\")\n" +
        "}\n",
    },
    // `map<string,string>`: literal, store, read, comma-ok on a hit and on a
    // MISS (the miss binds a null handle to a local, which is why `len(c)` is
    // printed rather than `c`), `delete`, and both iteration forms. The two
    // sums are order-independent because slot order is unspecified.
    Fixture{
      name: "mapstr",
      src: "fn main() {\n" +
        "  let s = \"red:green:blue:cyan:magenta\"\n" +
        "  let m = map<string, string>{ s[0:3]: s[4:9] }\n" +
        "  m[s[10:14]] = s[15:19]\n" +
        "  m[s[20:27]] = s[0:3]\n" +
        "  let a = m[s[0:3]]\n" +
        "  let (b, okb) = m[s[10:14]]\n" +
        "  let (c, okc) = m[s[4:9]]\n" +
        "  let klen = 0\n" +
        "  let vlen = 0\n" +
        "  for (k, v) of m {\n" +
        "    klen = klen + len(k)\n" +
        "    vlen = vlen + len(v)\n" +
        "  }\n" +
        "  let ksum = 0\n" +
        "  for k in m {\n" +
        "    ksum = ksum + len(m[k])\n" +
        "  }\n" +
        "  delete(m, s[20:27])\n" +
        "  let (d, okd) = m[s[20:27]]\n" +
        "  print(a + \";\" + b + \" " +
        IS +
        "okb} " +
        IS +
        "okc} " +
        IS +
        "okd} " +
        IS +
        "len(c)} " +
        IS +
        "len(d)} " +
        IS +
        "klen} " +
        IS +
        "vlen} " +
        IS +
        "ksum} " +
        IS +
        "len(m)}\\n\")\n" +
        "}\n",
    },
  ]
}

fn fixturesContainerChanField(): []Fixture {
  return [
    // `chan<string>`: buffered send, unary receive, two-result receive, and
    // `for v of ch` draining a spawned producer to `close`. Every value sent
    // is a slice of a heap string.
    Fixture{
      name: "chanstr",
      src: "fn produce(ch: chan<string>, s: string) {\n" +
        "  let i = 0\n" +
        "  while (i < 4) {\n" +
        "    ch <- s[i * 3:i * 3 + 3]\n" +
        "    i = i + 1\n" +
        "  }\n" +
        "  close(ch)\n" +
        "}\n" +
        "fn main() {\n" +
        "  let s = \"abcdefghijklmno\"\n" +
        "  let one = chan<string>(2)\n" +
        "  one <- s[0:4]\n" +
        "  one <- s[4:8]\n" +
        "  let a = <- one\n" +
        "  let (b, okb) = <- one\n" +
        "  let many = chan<string>(2)\n" +
        "  spawn produce(many, s)\n" +
        "  let out = \"\"\n" +
        "  for v of many {\n" +
        "    out = out + v + \",\"\n" +
        "  }\n" +
        "  print(a + \";\" + b + \";\" + out + \" " +
        IS +
        "okb}\\n\")\n" +
        "}\n",
    },
    // A string-typed class field, both directions, plus the field of a
    // ZERO-VALUED class - a null word, not an empty header, which every read
    // of it must survive.
    Fixture{
      name: "classfield",
      src: "class Doc {\n" +
        "  name: string,\n" +
        "  body: string,\n" +
        "  n: int,\n" +
        "}\n" +
        "fn title(d: Doc): string {\n" +
        "  return d.name\n" +
        "}\n" +
        "fn main() {\n" +
        "  let s = \"header-payload-trailer\"\n" +
        "  let d = Doc{ name: s[0:6], body: s[7:14], n: 2 }\n" +
        "  d.body = d.body + \"!\"\n" +
        "  d.name = s[15:22]\n" +
        "  let t = title(d)\n" +
        "  let head = d.body[0:3]\n" +
        "  let z = Doc{}\n" +
        "  print(t + \";\" + d.body + \";\" + head + \" " +
        IS +
        "len(z.name)} " +
        IS +
        "d.n}\\n\")\n" +
        "}\n",
    },
  ]
}

fn fixturesContainerReuse(): []Fixture {
  return [
    // THE HANDLE-REUSE SHAPE (#4446): `m[keys[j]]` reads a `[]string` element
    // that is already a boxed handle and hands it straight to `map_get`. 1000
    // such crossings, so a per-crossing allocation is visible in the object
    // count rather than lost in the noise.
    Fixture{
      name: "mapkeyslice",
      src: "fn main() {\n" +
        "  let blob = \"k00v00k01v01k02v02k03v03k04v04\"\n" +
        "  let keys = []string(0)\n" +
        "  let m = map<string, string>{}\n" +
        "  let i = 0\n" +
        "  while (i < 5) {\n" +
        "    let k = blob[i * 6:i * 6 + 3]\n" +
        "    keys = append(keys, k)\n" +
        "    m[k] = blob[i * 6 + 3:i * 6 + 6]\n" +
        "    i = i + 1\n" +
        "  }\n" +
        "  let hits = 0\n" +
        "  let acc = \"\"\n" +
        "  let r = 0\n" +
        "  while (r < 200) {\n" +
        "    let j = 0\n" +
        "    while (j < len(keys)) {\n" +
        "      let v = m[keys[j]]\n" +
        "      hits = hits + len(v)\n" +
        "      j = j + 1\n" +
        "    }\n" +
        "    r = r + 1\n" +
        "  }\n" +
        "  let q = 0\n" +
        "  while (q < len(keys)) {\n" +
        "    acc = acc + m[keys[q]] + \".\"\n" +
        "    q = q + 1\n" +
        "  }\n" +
        "  print(acc + \" " +
        IS +
        "hits} " +
        IS +
        "len(m)}\\n\")\n" +
        "}\n",
    },
  ]
}

fn fixturesContainerField(): []Fixture {
  return [
    // THE json LEXER SHAPE: a class field read, then indexed and sliced.
    // `bench/cases/json` does this once per source byte; ~95% of its flip-on
    // regression was this one position.
    Fixture{
      name: "fieldslice",
      src: "class Lexer {\n" +
        "  source: string,\n" +
        "  pos: int,\n" +
        "}\n" +
        "fn scan(p: Lexer): int {\n" +
        "  let n = 0\n" +
        "  while (p.pos < len(p.source)) {\n" +
        "    if (p.source[p.pos] == 44) {\n" +
        "      n = n + 1\n" +
        "    }\n" +
        "    p.pos = p.pos + 1\n" +
        "  }\n" +
        "  return n\n" +
        "}\n" +
        "fn word(p: Lexer, a: int, b: int): string {\n" +
        "  return p.source[a:b]\n" +
        "}\n" +
        "fn main() {\n" +
        "  let p = Lexer{ source: \"alpha,bravo,charlie,delta\", pos: 0 }\n" +
        "  let commas = scan(p)\n" +
        "  let w = word(p, 6, 11)\n" +
        "  let acc = 0\n" +
        "  let i = 0\n" +
        "  while (i < 400) {\n" +
        "    let k = 0\n" +
        "    while (k < len(p.source)) {\n" +
        "      if (p.source[k] == 97) {\n" +
        "        acc = acc + 1\n" +
        "      }\n" +
        "      k = k + 1\n" +
        "    }\n" +
        "    i = i + 1\n" +
        "  }\n" +
        "  print(w + \" " +
        IS +
        "commas} " +
        IS +
        "acc} " +
        IS +
        "len(p.source)}\\n\")\n" +
        "}\n",
    },
  ]
}
