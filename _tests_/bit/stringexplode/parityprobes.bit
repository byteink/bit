// _tests_/bit/stringexplode/parityprobes.bit — the allocation-count probes for
// the string flip's HANDLE fixtures (fixtureshandle.bit), a sibling in the same
// directory module as stringexplode.bit: one shared scope, no `import`.
//
// Split out of fixtureshandle.bit (#6476), which reached the 800-line E0200
// limit; stringexplode.bit is 23 lines from it (#5954).

// The fixtures that are also allocation-PARITY probes, in the order they run.
fn handleProbeNames(): []string {
  return [
    "handlefield", "handlertcall", "plainretfield", "plainretfielddirect", "paramfield",
    "paramhandle", "canonret", "litbox", "litarg", "fwdunwrap", "fwdchain",
    "fwdrebox",
    "genfree",
  ]
}

// The fixtures that are also allocation-REFUSAL probes: the flip must build a
// box here, so it allocates MORE than the boxed build, which hands the chosen
// handle on. See `litargmix` in fixtureshandle.bit.
fn handleRefusalNames(): []string {
  return ["litargmix"]
}

// Runs every parity and refusal probe; returns (ran, failed).
fn handleProbes(e: Env): (int, int) {
  let bad = 0
  for name of handleProbeNames() {
    if (!parityCheck(e, name)) {
      bad = bad + 1
    }
  }
  for name of handleRefusalNames() {
    if (!refusalCheck(e, name)) {
      bad = bad + 1
    }
  }
  return len(handleProbeNames()) + len(handleRefusalNames()), bad
}

// `name` run with the gate off and on: the two object counts, or (-1, -1) after
// printing why the probe cannot be read. The two runs must exit 0 and print the
// same bytes, so every probe here is also a differential.
fn probeCounts(e: Env, name: string): (int, int) {
  let srcPath = "${e.dir}/${name}.bit"
  let (c1, o1, e1) = runGcStats(e, srcPath, "${name}.parity.off", false)
  let (c2, o2, e2) = runGcStats(e, srcPath, "${name}.parity.on", true)
  if (c1 != 0 || c2 != 0) {
    eprint("stringexplode: FAIL — ${name} parity probe exited ${c1}/${c2}\n${e1}\n${e2}\n")
    return -1, -1
  }
  if (o1 != o2) {
    eprint("stringexplode: FAIL — ${name} parity probe printed ${o1} vs ${o2}\n")
    return -1, -1
  }
  let n1 = gcObjects(e1)
  let n2 = gcObjects(e2)
  if (n1 < 0 || n2 < 0) {
    eprint("stringexplode: FAIL — no [bit-gc] line; BIT_GC_STATS=1 did not take\n")
    return -1, -1
  }
  return n1, n2
}

// `name` must allocate NO MORE objects with the gate on than with it off.
//
// The direction matters: a differential alone passes when the flip stops
// flipping, and `allocCheck`'s strictly-fewer arm cannot be used on a shape
// whose boxed build already allocates nothing extra. This is the arm that
// fails if `stringLetExplodes` (lowerexplodestr.bit) is reverted to the
// blanket "every string local explodes" rule.
fn parityCheck(e: Env, name: string): bool {
  let (n1, n2) = probeCounts(e, name)
  if (n1 < 0) {
    return false
  }
  if (n2 > n1) {
    eprint("stringexplode: FAIL — ${name} flip ADDED allocations: ${n1} objects off, ${n2} on (want no more)\n")
    return false
  }
  println("stringexplode: ${name} parity probe — ${n1} objects gate-off, ${n2} gate-on")
  return true
}

// `name` must allocate MORE objects with the gate on than with it off.
//
// #6476: `boxWordsAreOwnHandle` (compiler/optstrbox.bit) admits a box whose
// words come out of a join only when every edge into the join carries one
// handle's words. A join of two different literals is not that, and the pass
// must leave its box alone. Reuse there is not a wrong answer — the reuse
// diamond compares the real words — so the output comparison cannot see it;
// the object count does. Reverse this probe when a pass learns to reuse a
// handle chosen between two literals.
fn refusalCheck(e: Env, name: string): bool {
  let (n1, n2) = probeCounts(e, name)
  if (n1 < 0) {
    return false
  }
  if (n2 <= n1) {
    eprint("stringexplode: FAIL — ${name} was REUSED across two handles: ${n1} objects off, ${n2} on (want more)\n")
    return false
  }
  println("stringexplode: ${name} refusal probe — ${n1} objects gate-off, ${n2} gate-on")
  return true
}
