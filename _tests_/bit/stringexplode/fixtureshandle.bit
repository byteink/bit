// _tests_/bit/stringexplode/fixtureshandle.bit — the HANDLE half of the
// string-flip differential (#4586), a sibling in the same directory module as
// stringexplode.bit: one shared scope, no `import`, and `fixtures()` there
// picks these up by calling `fixturesHandle()`.
//
// WHAT THESE COVER. #4586 narrowed `declareLetLocal` (lowerexplode.bit): a
// `string` let-binding explodes into words only when its initializer just
// ALLOCATED the box, because a box the lowerer emitted is the only thing the
// explosion can kill. Every other initializer — a `const_string`, a class
// field, a slice or map element, a one-handle (fallible) call result, a
// runtime call's result — hands over a handle that already exists, and
// exploding it made every later ONE-WORD use build a second object with the
// same contents.
//
//   fixture       what it binds a `string` local FROM, and where it uses it
//   ------------  ---------------------------------------------------------
//   handleconst   a `const_string`: len, index, reslice, `==`, `+`, an
//                 argument, a class-field init, `append`, a map key
//   handlecall    a one-handle FALLIBLE call result, in a loop: a class-field
//                 store, `+`, a reslice and an accumulator
//   handlemixed   the width is decided at the DECLARATION — a local bound
//                 from a handle and then REASSIGNED from `s[lo:hi]` inside a
//                 loop, plus an initializer-less `let z: string` whose zero
//                 value is the null handle
//   handlefield   PARITY PROBE: the `bench/cases/json` `parseObject` shape,
//                 1000 `Slot{ key: k }` stores of a fallible call's result
//   handlertcall  PARITY PROBE: 1000 `a + "x"` where `a` is a const-string
//                 local, i.e. an exploded operand reaching a one-handle
//                 `rt_call string_concat`
//   plainretfield PARITY PROBE (#4628): the same 1000 `Slot{ key: k }` stores
//                 through a PLAIN `fn pick(...): string` — the shape neither
//                 `handlefield` (a `catch`) nor `failretfield` (a `?`) can
//                 see, because both are fallible and a fallible result keeps
//                 the one-handle convention (`declPlainResultType`)
//
// WHY A PARITY PROBE AND NOT `allocCheck`. `allocCheck` asserts the gate-on
// count is STRICTLY FEWER, which is right for #4422's producer and #4424's
// return — both DELETE an allocation. These two shapes never allocated in the
// boxed build at all, so the only honest assertion is that the flip does not
// ADD one: gate-on <= gate-off. Reverting #4586's predicate makes each of
// these 1000 objects worse and turns the probe red; measured, not assumed —
// see the ticket.
//
// THE ORACLE IS THE GATE-OFF RUN, as it is for every fixture in this harness.

// The two groups exist only to keep each function under E0201's 80-line limit
// — `fixturesHandle` is the whole set, in this order.
fn fixturesHandle(): []Fixture {
  let out = []Fixture(0)
  for group of [fixturesHandleReads(), fixturesHandleStores(), fixturesHandlePlain()] {
    for f of group {
      out = append(out, f)
    }
  }
  return out
}

// `handleconst` and `handlemixed`: a local bound from a `const_string`, and a
// local whose EXPLOSION WIDTH is fixed at the declaration and then reassigned
// from `s[lo:hi]` inside a loop.
fn fixturesHandleReads(): []Fixture {
  return [
    Fixture{
      name: "handleconst",
      src: "class Box { f: string }\n" +
        "fn take(s: string, k: int): int {\n" +
        "  return len(s) + k\n" +
        "}\n" +
        "fn main() {\n" +
        "  let s = \"abcdefghij\"\n" +
        "  let t = s[2:6]\n" +
        "  let b = Box{ f: s }\n" +
        "  let xs = []string(0, 2)\n" +
        "  xs = append(xs, s)\n" +
        "  let m = map<string, int>{}\n" +
        "  m[s] = 7\n" +
        "  let n = len(s) + int(s[3]) + take(s, 1) + m[s] + len(t)\n" +
        "  if (s == \"abcdefghij\") { n = n + 100 }\n" +
        "  let acc = t + \"|\" + b.f + \"|\" + xs[0] + \"|\" + s + \"!\"\n" +
        "  print(\"" +
        IS +
        "n} " +
        IS +
        "acc}\\n\")\n" +
        "}\n",
    },
    Fixture{
      name: "handlecall",
      src: "class Box { f: string }\n" +
        "fn pick(xs: []string, i: int): string! {\n" +
        "  return xs[i & 1]\n" +
        "}\n" +
        "fn main() {\n" +
        "  let xs = []string(0, 2)\n" +
        "  xs = append(xs, \"alpha\")\n" +
        "  xs = append(xs, \"beta\")\n" +
        "  let n = 0\n" +
        "  let out = \"\"\n" +
        "  let i = 0\n" +
        "  while (i < 4) {\n" +
        "    let k = pick(xs, i) catch e { \"?\" }\n" +
        "    let b = Box{ f: k }\n" +
        "    let j = \"x\" + k\n" +
        "    n = n + len(k) + len(b.f) + len(j) + len(k[0:2])\n" +
        "    out = out + b.f\n" +
        "    i = i + 1\n" +
        "  }\n" +
        "  print(\"" +
        IS +
        "n} " +
        IS +
        "out}\\n\")\n" +
        "}\n",
    },
  ]
}

// `handlecall`, `handlefield` and `handlertcall`: a local bound from a
// one-handle FALLIBLE call result and used at the two positions that used to
// re-box it — a class-field store and a one-handle `rt_call`. The last two are
// also the parity probes.
fn fixturesHandleStores(): []Fixture {
  return [
    Fixture{
      name: "handlemixed",
      src: "fn main() {\n" +
        "  let s = \"abcdefghijklmnop\"\n" +
        "  let a = \"zz\"\n" +
        "  let n = 0\n" +
        "  let w = 0\n" +
        "  while (w < 8) {\n" +
        "    a = s[w:w + 4]\n" +
        "    n = n + len(a) + int(a[0])\n" +
        "    w = w + 1\n" +
        "  }\n" +
        "  let z: string\n" +
        "  print(\"" +
        IS +
        "n} " +
        IS +
        "a} " +
        IS +
        "len(z)} " +
        IS +
        "z == \"\"}\\n\")\n" +
        "}\n",
    },
    Fixture{
      name: "handlefield",
      src: "class Slot { key: string, n: int }\n" +
        "fn pick(xs: []string, i: int): string! {\n" +
        "  return xs[i & 3]\n" +
        "}\n" +
        "fn main() {\n" +
        "  let xs = []string(0, 4)\n" +
        "  xs = append(xs, \"id\")\n" +
        "  xs = append(xs, \"name\")\n" +
        "  xs = append(xs, \"active\")\n" +
        "  xs = append(xs, \"tags\")\n" +
        "  let out = []Slot(0, 8)\n" +
        "  let i = 0\n" +
        "  while (i < 1000) {\n" +
        "    let k = pick(xs, i) catch e { \"?\" }\n" +
        "    out = append(out, Slot{ key: k, n: i })\n" +
        "    i = i + 1\n" +
        "  }\n" +
        "  print(\"" +
        IS +
        "len(out)} " +
        IS +
        "out[999].key}\\n\")\n" +
        "}\n",
    },
    Fixture{
      name: "handlertcall",
      src: "fn main() {\n" +
        "  let n = 0\n" +
        "  let i = 0\n" +
        "  while (i < 1000) {\n" +
        "    let a = \"false\"\n" +
        "    let s = a + \"x\"\n" +
        "    n = n + len(s)\n" +
        "    i = i + 1\n" +
        "  }\n" +
        "  print(\"" +
        IS +
        "n}\\n\")\n" +
        "}\n",
    },
  ]
}

// `plainretfield`: #4628's shape — a `[]string` cache element handed back
// through a PLAIN `string` return and stored into a class field.
//
// A THIRD group rather than a sixth entry in `fixturesHandleStores`, which is
// 68 lines against E0201's 80.
//
// This is `bench/cases/json`'s `decodeObjectKey` chain with the fallible link
// removed. Under #4424 a plain `string` return travels as three registers, so
// the caller rebuilds a box at every crossing that wants a whole handle —
// 1000 fresh 24-byte headers where the boxed build passes one of the four
// cache elements straight into `Slot.key`. `handlefield` and `failretfield`
// both go through a FALLIBLE callee, which `declPlainResultType` excludes from
// the multi-word return whole, so neither of them can reach this.
fn fixturesHandlePlain(): []Fixture {
  return [
    Fixture{
      name: "plainretfield",
      src: "class Slot { key: string, n: int }\n" +
        "fn pick(xs: []string, i: int): string {\n" +
        "  return xs[i & 3]\n" +
        "}\n" +
        "fn main() {\n" +
        "  let xs = []string(0, 4)\n" +
        "  xs = append(xs, \"id\")\n" +
        "  xs = append(xs, \"name\")\n" +
        "  xs = append(xs, \"active\")\n" +
        "  xs = append(xs, \"tags\")\n" +
        "  let out = []Slot(0, 8)\n" +
        "  let i = 0\n" +
        "  while (i < 1000) {\n" +
        "    let k = pick(xs, i)\n" +
        "    out = append(out, Slot{ key: k, n: i })\n" +
        "    i = i + 1\n" +
        "  }\n" +
        "  print(\"" +
        IS +
        "len(out)} " +
        IS +
        "out[999].key}\\n\")\n" +
        "}\n",
    },
  ]
}

// The fixtures that are also allocation-PARITY probes, in the order they run.
fn handleProbeNames(): []string {
  return ["handlefield", "handlertcall", "plainretfield"]
}

// Runs every parity probe; returns (ran, failed). Kept here rather than in
// stringexplode.bit, which is 21 lines from the 800-line E0200 limit.
fn handleProbes(e: Env): (int, int) {
  let bad = 0
  for name of handleProbeNames() {
    if (!parityCheck(e, name)) {
      bad = bad + 1
    }
  }
  return len(handleProbeNames()), bad
}

// `name` must allocate NO MORE objects with the gate on than with it off.
//
// The direction matters: a differential alone passes when the flip stops
// flipping, and `allocCheck`'s strictly-fewer arm cannot be used on a shape
// whose boxed build already allocates nothing extra. This is the arm that
// fails if `stringLetExplodes` (lowerexplodestr.bit) is reverted to the
// blanket "every string local explodes" rule.
fn parityCheck(e: Env, name: string): bool {
  let srcPath = "${e.dir}/${name}.bit"
  let (c1, o1, e1) = runGcStats(e, srcPath, "${name}.parity.off", false)
  let (c2, o2, e2) = runGcStats(e, srcPath, "${name}.parity.on", true)
  if (c1 != 0 || c2 != 0) {
    eprint("stringexplode: FAIL — ${name} parity probe exited ${c1}/${c2}\n${e1}\n${e2}\n")
    return false
  }
  if (o1 != o2) {
    eprint("stringexplode: FAIL — ${name} parity probe printed ${o1} vs ${o2}\n")
    return false
  }
  let n1 = gcObjects(e1)
  let n2 = gcObjects(e2)
  if (n1 < 0 || n2 < 0) {
    eprint("stringexplode: FAIL — no [bit-gc] line; BIT_GC_STATS=1 did not take\n")
    return false
  }
  if (n2 > n1) {
    eprint("stringexplode: FAIL — ${name} flip ADDED allocations: ${n1} objects off, ${n2} on (want no more)\n")
    return false
  }
  println("stringexplode: ${name} parity probe — ${n1} objects gate-off, ${n2} gate-on")
  return true
}
