// docs/examples/ compile-and-run guard (#5268).
//
// The link-shortener spine (docs/examples/shortener/) is a chain of RUNNING
// programs, not doc-snippets: `_tests_/bit/docs.bit` typechecks fenced
// ```bit blocks as modules with no `main` (see its own header -- "a snippet
// is CHECKED, not built"), which is the wrong shape for a stage that must
// actually execute. This is a sibling gate instead of a new branch inside
// docs.bit (already at the file's 800-line lint ceiling, and organized
// entirely around markdown extraction) -- the same reason docsrunner/runner.bit
// was split out of docs.bit at #2969.
//
// Modeled on _tests_/bit/examplesgate.bit, which already solves "build then
// run every showcase program and assert exit 0" for `examples/`: same
// _tests_/bit/gatefanout two-wave driver, same pinned discovered-count guard
// against a silently empty corpus. The one difference `examplesgate.bit`
// does not need: a stage is a bare `.bit` file for every single-file stage
// and a directory for a stage split across modules (09_modules onward), so
// discovery here takes BOTH `isDir` and `hasSuffix(name, ".bit")` entries,
// not directories only.
//
// Run it: `bit run _tests_/bit/docsexamplesgate.bit` from the repository root.
// Configure it by environment, since `bit run` forwards no argv to the program:
//   BIT                 compiler under test    (default bit-out/bin/bit)
//   BIT_DOCS_EXAMPLES   the shortener directory (default docs/examples/shortener)
//   BIT_TEST_TIMEOUT_S  per-child deadline      (default 300, clamped to 3600)

import { exists, isDir, readDir } from "std/fs"
import { envOr, exit } from "std/os"
import { join } from "std/path"
import { hasSuffix, parseInt } from "std/strings"
import { now } from "std/time"
import {
  FanCfg, Job, JobResult, cleanupJob, commitWave, gradeJob,
  newFanCfg, runDriver, stageJob, wave1, wave2,
} from "./gatefanout"

// Re-derived off disk (`ls docs/examples/shortener | wc -l`) after every
// stage this ticket adds -- a pin, not a bound, exactly like examplesgate's
// `expectedExamples`.
const expectedStages: int = 9

const defaultTimeoutS: int = 300
const maxTimeoutS: int = 3600
const timeoutEnvVar: string = "BIT_TEST_TIMEOUT_S"

const rcTimedOut: int = -2
const rcSignalBase: int = -100

const outcomeOk: int = 0
const outcomeFailed: int = 1
const outcomeTimedOut: int = 2

fn main() {
  let bin = envOr("BIT", "bit-out/bin/bit")
  let dir = envOr("BIT_DOCS_EXAMPLES", "docs/examples/shortener")

  if (!exists(bin)) {
    eprint("docsexamplesgate: compiler not found: ${bin} (set BIT)\n")
    exit(1)
    return
  }
  if (!isDir(dir)) {
    eprint("docsexamplesgate: not a directory: ${dir} (set BIT_DOCS_EXAMPLES)\n")
    exit(1)
    return
  }

  let cases = discover(dir)
  if (len(cases) != expectedStages) {
    eprint("docsexamplesgate: ${dir} holds ${len(cases)} stage(s), want ${expectedStages}\n")
    eprint("docsexamplesgate: adding a stage means updating 'expectedStages' here\n")
    exit(1)
    return
  }
  exit(runAll(bin, dir, cases, timeoutSeconds() * 1000))
}

// Every stage under `dir`, in `readDir`'s already-sorted order: a `.bit` file
// (single-file stage) or a directory (a stage split into its own module).
// Never `walk` -- `examplesgate.bit`'s header is the record of why that
// silently returns files nested arbitrarily deep instead of one entry per
// stage. Anything else (a stray non-`.bit` file) is ignored rather than
// queued, so an editor swap file cannot become a phantom failing case.
fn discover(dir: string): []string {
  let names = readDir(dir) catch _ {
    eprint("docsexamplesgate: cannot read ${dir}\n")
    exit(1)
    return []string(0)
  }
  let cases = []string(0)
  for name of names {
    let full = join(dir, name)
    if (isDir(full) || hasSuffix(name, ".bit")) {
      cases = append(cases, name)
    }
  }
  return cases
}

fn buildKey(idx: int): string { return "b${idx}" }
fn runKey(idx: int): string { return "r${idx}" }
fn binOutPath(scratch: string, idx: int): string { return "${scratch}/de-${idx}.bin" }

// Compile (wave 1) then, unconditionally, execute the binary compile would
// produce (wave 2) -- same shape as `examplesgate.bit`'s `stageExample`: a
// case whose compile fails produces no binary, and `gradeStage` grades the
// build outcome first and returns before the run outcome is ever read.
fn stageStage(cfg: FanCfg, dir: string, bin: string, name: string, idx: int) {
  let src = join(dir, name)
  let out = binOutPath(cfg.scratch, idx)
  stageJob(
    cfg,
    Job{
      key = buildKey(idx), wave = wave1, cwd = "",
      argv = [bin, "build", src, "-o", out], withEnv = true,
    },
  )
  commitWave(cfg.scratch, buildKey(idx), wave1)
  stageJob(
    cfg,
    Job{ key = runKey(idx), wave = wave2, cwd = "", argv = [out], withEnv = false },
  )
  commitWave(cfg.scratch, runKey(idx), wave2)
}

fn gradeStageJob(scratch: string, key: string): int {
  let jr = gradeJob(scratch, key)
  if (jr.ran && jr.code == 0) {
    return outcomeOk
  }
  return outcomeFailed
}

fn gradeStage(scratch: string, name: string, idx: int): int {
  let br = gradeStageJob(scratch, buildKey(idx))
  if (br != outcomeOk) {
    let r = reportJob(name, "build", scratch, buildKey(idx))
    cleanupJob(scratch, buildKey(idx))
    cleanupJob(scratch, runKey(idx))
    fsRemove(binOutPath(scratch, idx))
    return r
  }
  cleanupJob(scratch, buildKey(idx))
  let rr = gradeStageJob(scratch, runKey(idx))
  fsRemove(binOutPath(scratch, idx))
  if (rr != outcomeOk) {
    let r = reportJob(name, "run", scratch, runKey(idx))
    cleanupJob(scratch, runKey(idx))
    return r
  }
  cleanupJob(scratch, runKey(idx))
  print("ok ${name}\n")
  return outcomeOk
}

fn runAll(bin: string, dir: string, cases: []string, timeoutMs: int): int {
  let scratch = scratchRoot()
  if (fsMkdir(scratch) < 0) {
    eprint("docsexamplesgate: cannot create scratch directory ${scratch}\n")
    exit(1)
  }
  let cfg = newFanCfg(scratch, timeoutMs, "", "")
  let i = 0
  while (i < len(cases)) {
    stageStage(cfg, dir, bin, cases[i], i)
    i = i + 1
  }

  let outerMs = 2 * len(cases) * timeoutMs + 60000
  runDriver(scratch, outerMs)

  let failed = 0
  let timedOut = 0
  i = 0
  while (i < len(cases)) {
    let r = gradeStage(scratch, cases[i], i)
    if (r == outcomeTimedOut) {
      timedOut = timedOut + 1
    } else if (r == outcomeFailed) {
      failed = failed + 1
    }
    i = i + 1
  }
  fsRemove(scratch)

  if (timedOut > 0) {
    eprint("docsexamplesgate: FAILED -- ${timedOut} timed out, ${failed} failed\n")
    return 2
  }
  if (failed > 0) {
    eprint("docsexamplesgate: FAILED -- ${failed} of ${len(cases)} stage(s)\n")
    return 1
  }
  print("${len(cases)}/${expectedStages} shortener stages built and exited 0\n")
  return 0
}

fn reportJob(name: string, phase: string, scratch: string, key: string): int {
  let jr = gradeJob(scratch, key)
  if (!jr.ran) {
    eprint("stage '${name}': could not spawn ${phase}\n")
    return outcomeFailed
  }
  let r = jr.code
  if (r == rcTimedOut) {
    eprint("stage '${name}': TIMED OUT in ${phase}\n")
    eprint("  killed at the ${timeoutEnvVar} deadline; raise it on a slower host\n")
    return outcomeTimedOut
  }
  if (r <= rcSignalBase) {
    eprint("stage '${name}': CRASHED in ${phase} -- signal ${0 - r + rcSignalBase}\n")
  } else {
    eprint("stage '${name}': ${phase} exited with ${r}\n")
  }
  printJobOutput(name, phase, jr)
  return outcomeFailed
}

fn printJobOutput(name: string, phase: string, jr: JobResult) {
  let text = jr.err
  if (len(jr.out) > 0) {
    text = text + jr.out
  }
  if (len(text) > 0) {
    eprint("--- ${name} ${phase} output ---\n${text}\n")
  }
}

fn timeoutSeconds(): int {
  let raw = envOr(timeoutEnvVar, "")
  if (len(raw) == 0) {
    return defaultTimeoutS
  }
  let n = parseInt(raw) catch _ {
    eprint("docsexamplesgate: ${timeoutEnvVar}='${raw}' is not a number\n")
    return defaultTimeoutS
  }
  if (n < 1) {
    return 1
  }
  if (n > maxTimeoutS) {
    return maxTimeoutS
  }
  return n
}

fn scratchRoot(): string {
  let base = envOr("TMPDIR", "/tmp")
  if (base[len(base) - 1] == 47) {
    base = base[0:len(base) - 1]
  }
  return "${base}/bit-docsexamplesgate-${now().ns}"
}
