// #3189: drift gate for the stack-map wire-format version stamp.
//
// THE COUPLING THIS GATE MAKES LOUD. `runtime/gc/stackmap.bit` exports
// `smFormatVersion`, the format version its reader (`scanFrame`) checks
// before trusting any count-driven field in a stack-map entry (runtime/ABI.md
// §4). The compiler-side writer (`compiler/codegen.bit`'s `writeStackMaps`)
// must stamp the SAME number into every entry it emits — a pinned symbol
// crosses the compiler/runtime object boundary only for a FUNCTION, never
// for a shared constant (§17.6/§11.9), so the writer cannot import this
// value, only mirror it as a hardcoded literal, the same pattern
// `_tests_/bit/pollguardoffsets.bit` already pins for the six inlined
// poll-guard word offsets.
//
// `compiler/codegen.bit` now carries its own `smFormatVersion = 2` literal
// (stamped by `writeStackMaps`, checked by `scanFrame`). This gate pins the
// runtime's copy — the pattern `_tests_/bit/pollguardoffsets.bit` already uses
// for compiler-mirrored constants: the compiler side cannot be imported
// across the object-boundary seam, so drift on that side is caught by
// reading the two literals side by side in review, same as every other
// mirror in that family.
//
// Run from the repository root: ./bit-out/bin/bit run _tests_/bit/stackmapformatversion.bit
import { exit } from "std/os"
import { smFormatVersion, smFormatVersionV1, smLiveUnknown } from "../../runtime/gc"
import { smEntryEnd, smLiveRegsIn } from "../../runtime/gc"

class Tally { checks: int, failures: int }

fn check(t: Tally, cond: bool, label: string) {
  t.checks = t.checks + 1
  if (!cond) {
    t.failures = t.failures + 1
    eprint("FAIL: ${label}\n")
  }
}

// The table under construction; a class so every writer grows the same one.
class Blob { bytes: []u8 }

fn putU16(b: Blob, v: int) {
  b.bytes = append(b.bytes, u8(v & 255))
  b.bytes = append(b.bytes, u8((v >> 8) & 255))
}

fn putU32(b: Blob, v: int) {
  putU16(b, v & 65535)
  putU16(b, (v >> 16) & 65535)
}

// One safepoint record: `sp` is {retOff, slot count, reg count, isPoll,
// liveRegs}; the last two feed only `putTrailer`.
fn putSafepoint(b: Blob, sp: []int) {
  putU32(b, sp[0])
  putU16(b, sp[1])
  let k = 0
  while (k < sp[1]) {
    putU32(b, 0 - 16 - k * 8)
    k = k + 1
  }
  putU16(b, sp[2])
  k = 0
  while (k < sp[2]) {
    putU16(b, 19 + k)
    k = k + 1
  }
}

// #7303: version 2's live-register trailer, one {sp_index, live_regs} per poll.
fn putTrailer(b: Blob, sps: [][]int) {
  let numLive = 0
  for sp of sps {
    numLive = numLive + sp[3]
  }
  putU16(b, numLive)
  let i = 0
  while (i < len(sps)) {
    if (sps[i][3] == 1) {
      putU16(b, i)
      putU32(b, sps[i][4])
    }
    i = i + 1
  }
}

// One entry with no saved registers, padded to 8 as the writer pads it.
fn putEntry(b: Blob, codeAddr: int, version: int, sps: [][]int) {
  putU32(b, codeAddr)
  putU32(b, 0)
  putU16(b, version)
  putU32(b, 64)
  putU16(b, 0)
  putU16(b, len(sps))
  for sp of sps {
    putSafepoint(b, sp)
  }
  if (version != smFormatVersionV1) {
    putTrailer(b, sps)
  }
  while (len(b.bytes) % 8 != 0) {
    b.bytes = append(b.bytes, u8(0))
  }
}

// #7303: one table holding a version-1 entry (what the pinned stage0 stamps
// into libbitrt.a) and a version-2 one (what this tree's writer stamps), the
// mix a default build links. Both parse to their true ends; only the second
// answers a mask, and only at its polls (records 0 and 2, not call record 1).
fn checkBothVersions(t: Tally) {
  let b = Blob{ bytes = []u8(0) }
  putEntry(b, 4096, smFormatVersionV1, [[8, 1, 1, 0, 0]])
  let e1 = len(b.bytes)
  putEntry(b, 8192, smFormatVersion, [[4, 0, 0, 1, 136], [12, 1, 2, 0, 0], [20, 0, 1, 1, 8]])
  let e2 = len(b.bytes)
  putEntry(b, 12288, smFormatVersion + 1, [[4, 0, 0, 1, 1]])
  let base = int(ptrOf(b.bytes))
  let n = len(b.bytes)
  check(t, smEntryEnd(base, n, 0) == e1, "a version-1 entry ends at byte ${e1}")
  check(t, smEntryEnd(base, n, e1) == e2, "a version-2 entry ends at byte ${e2}")
  check(t, smEntryEnd(base, n, e2) < 0, "an unknown version is refused")
  // Entry 2 unpadded: 16 header + 2 count + 34 records = 52, then the trailer's
  // 2 count + 2 x 6 = 66 bytes. An extent one byte short cuts the last mask;
  // one ending at the records leaves no room for num_live.
  check(
    t,
    smEntryEnd(base, e1 + 66, e1) == e2,
    "a version-2 entry fits an extent ending at its trailer",
  )
  check(t, smEntryEnd(base, e1 + 65, e1) < 0, "a trailer past the extent is refused")
  check(t, smEntryEnd(base, e1 + 52, e1) < 0, "a missing num_live is refused")
  check(t, smLiveRegsIn(base, n, 0, 4104) == smLiveUnknown, "a version-1 safepoint has no mask")
  check(t, smLiveRegsIn(base, n, e1, 8196) == 136, "version-2 poll 0 reads mask 136")
  check(t, smLiveRegsIn(base, n, e1, 8204) == smLiveUnknown, "a version-2 call record has no mask")
  check(t, smLiveRegsIn(base, n, e1, 8212) == 8, "version-2 poll 2 reads mask 8 by sp_index")
  check(t, smLiveRegsIn(base, n, e1, 8200) == smLiveUnknown, "a pc with no safepoint has no mask")
}

fn main() {
  let t = Tally{ checks = 0, failures = 0 }

  // The literal `compiler/codegen.bit`'s writer must mirror once it exists
  // (#3189). A change to either copy without the other is exactly the
  // desync this ticket exists to make loud.
  check(
    t, smFormatVersion == 2,
      "runtime/gc smFormatVersion is ${smFormatVersion}, want 2 " +
      "(the compiler-side writer mirror, once #3189's writer half lands, " +
      "must carry the same literal)",
  )

  checkBothVersions(t)

  if (t.checks < 10) {
    eprint("FAIL: only ${t.checks} checks ran, want at least 10\n")
    t.failures = t.failures + 1
  }
  if (t.failures > 0) {
    println("stackmapformatversion: FAIL — ${t.failures} of ${t.checks} checks failed")
    exit(1)
  }
  println("stackmapformatversion: PASS — ${t.checks} checks")
}
