// _tests_/bit/maillive.bit — `./make test-package-mail-live` (#6929, epic
// #6855). Provisions its OWN Mailpit servers, the same pattern as
// redislive.bit (#6021): three `docker run --rm -d` containers, published to
// 127.0.0.1 on random host ports, readiness polled on Mailpit's API, the
// URLs handed to pkg/mail/smoke.live.test.bit, then always removed.
//
//   plain     no TLS configured: `smtp://...?tls=off`
//   starttls  `--smtp-require-starttls`: the server that proves pkg/mail's
//             successful STARTTLS upgrade, which no in-test fake can reach
//             (std/tls has no server-side upgrade of an accepted connection)
//   tls       `--smtp-require-tls`: implicit TLS, `smtps://`
//
// All three run with `--enable-chaos`; the two TLS ones use a throwaway CA and
// a leaf for localhost and 127.0.0.1 generated at gate time under $TMPDIR with
// openssl, and accept any login (`--smtp-auth-accept-any`).
//
// IMAGE: Mailpit v1.31.4 (released 2026-10-03), pinned BY DIGEST so a retag
// upstream cannot change what this gate runs against:
//
//   axllent/mailpit@sha256:b68349e3a014b90c5610bfb26b2ae36f3892d7b8cf25ee140c6c71c98d2fcf48
//
// Re-verify before bumping:
//   curl -s https://hub.docker.com/v2/repositories/axllent/mailpit/tags/<tag> | jq -r .digest
//
// THE IMAGE ITSELF IS KEPT, never deleted by this gate (redislive.bit's header
// has the reasoning); only the containers are throwaway.
//
// WITHOUT DOCKER: no `docker` binary, or `docker info` failing three times,
// FAILS naming the probe error (_tests_/bit/dockerlive/dockerlive.bit, #6353);
// only `BIT_LIVE_OPTIONAL=1` skips and exits 0.
//
// CLEANUP: every container is named with a run-local UUID and labelled
// `bit.mail.live=1` plus its owner pid; `cleanup()` removes them and the cert
// directory on every path this process controls. `sweepOrphans()` runs FIRST
// and removes the containers of a run that was killed. A skipped live test
// inside this gate is a failure: `runLiveTests` scans the child's stdout for
// "  skipped: " exactly as ormlive.bit does.
//
// ENV (`./make test-package-mail-live` sets both, tools/build/gatestable3.bit):
//   BIT_REPO   repo root, so pkg/mail resolves regardless of cwd (required)
//   BIT_BIN    compiler under test    (default bit-out/bin/bit)
//
// The live tests read MAIL_TEST_* off their environment; `runLiveTests` sets
// them through `/usr/bin/env VAR=... <bit> test ...` for the reason
// redislive.bit's header gives.

import { output } from "std/process"
import { env, envOr, exit } from "std/os"
import { mkdir, remove, writeFile } from "std/fs"
import { contains, hasSuffix, trimSpace } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"
import { sleep, Millisecond } from "std/time"
import { get } from "std/http"
import {
  dockerQuickTimeoutMs, dockerRunTimeoutMs, dockerRun, findBin, hostPort, relay, requireDocker,
  selfPid, sweepOrphans, ownerLabelKey,
} from "./dockerlive"

const image: string = "axllent/mailpit@sha256:b68349e3a014b90c5610bfb26b2ae36f3892d7b8cf25ee140c6c71c98d2fcf48"
const runLabel: string = "bit.mail.live=1"
const smtpUser: string = "bit"
const smtpPass: string = "live"
// Bounded poll: 40 * 500ms = 20s per container.
const readyAttempts: int = 40
const readyDelayMs: int = 500
const testRunTimeoutMs: int = 120000
const certFiles: []string = [
  "openssl.cnf", "ca.key", "ca.crt", "ca.srl", "server.key", "server.csr", "server.crt",
]

// What `openssl req`/`x509` read: a CA, and a leaf that names localhost and
// 127.0.0.1 so the URL host and `serverName=localhost` both verify.
const opensslConf: string = "[req]\ndistinguished_name = dn\nprompt = no\nx509_extensions = v3_ca\n" +
  "[dn]\nCN = Bit Mail Live CA\n" +
  "[v3_ca]\nbasicConstraints = critical,CA:TRUE\nkeyUsage = critical,keyCertSign,cRLSign\n" +
  "subjectKeyIdentifier = hash\n" +
  "[leaf]\nbasicConstraints = CA:FALSE\nkeyUsage = digitalSignature,keyEncipherment\n" +
  "extendedKeyUsage = serverAuth\nsubjectAltName = DNS:localhost,IP:127.0.0.1\n"

// BIT_REPO IS REQUIRED, same reason as redislive.bit: a "." fallback would
// silently test whatever directory `bit` was invoked from.
fn repoRoot(): string {
  let r = env("BIT_REPO")
  if (len(r) == 0) {
    panic("maillive: BIT_REPO is not set — run this through `./make test-package-mail-live`")
  }
  return r
}

fn opensslBin(): string {
  return findBin(
    [
      "/usr/bin/openssl", "/opt/homebrew/bin/openssl", "/usr/local/bin/openssl",
      "/usr/local/opt/openssl/bin/openssl",
    ],
  )
}

fn trimSuffix(s: string, suffix: string): string {
  if (hasSuffix(s, suffix)) {
    return s[0:len(s) - len(suffix)]
  }
  return s
}

fn runOpenssl(bin: string, args: []string) {
  let r = output(bin, args, dockerRunTimeoutMs)
  if (r.exitCode != 0) {
    panic("openssl ${args[0]}: ${trimSpace(r.stderr)}")
  }
}

// A throwaway CA and a leaf signed by it, under `dir`. The leaf key is made
// world-readable: the container's user is not the host user and reads it
// through a read-only bind mount.
fn generateCerts(bin: string, dir: string): ()! {
  mkdir(dir)?
  writeFile("${dir}/openssl.cnf", opensslConf)?
  runOpenssl(
    bin,
    [
      "req", "-x509", "-newkey", "rsa:2048", "-days", "2", "-nodes", "-config", "${dir}/openssl.cnf",
      "-keyout", "${dir}/ca.key", "-out", "${dir}/ca.crt",
    ],
  )
  runOpenssl(
    bin,
    [
      "req", "-new", "-newkey", "rsa:2048", "-nodes", "-subj", "/CN=localhost",
      "-keyout", "${dir}/server.key", "-out", "${dir}/server.csr",
    ],
  )
  runOpenssl(
    bin,
    [
      "x509", "-req", "-in", "${dir}/server.csr", "-CA", "${dir}/ca.crt", "-CAkey", "${dir}/ca.key",
      "-CAcreateserial", "-days", "2", "-out", "${dir}/server.crt", "-extfile", "${dir}/openssl.cnf",
      "-extensions", "leaf",
    ],
  )
  let r = output("/bin/chmod", ["644", "${dir}/server.key"], dockerQuickTimeoutMs)
  if (r.exitCode != 0) {
    fail newError("chmod server.key: ${trimSpace(r.stderr)}")
  }
}

fn cleanupCertDir(dir: string) {
  for f of certFiles {
    remove("${dir}/${f}") catch _ {}
  }
  remove(dir) catch _ {}
}

// Always removes every container (by name; `--rm` makes a stopped one vanish,
// `rm -f` handles a running one) and the cert directory, from every path
// through `main` below.
fn cleanup(bin: string, names: []string, certDir: string) {
  for name of names {
    output(bin, ["rm", "-f", name], dockerRunTimeoutMs)
  }
  cleanupCertDir(certDir)
}

class liveContainer {
  smtp: int,
  api: int,
}

// True once Mailpit's API answers 200 on `GET /api/v1/info`.
fn apiReady(port: int): bool {
  let i = 0
  while (i < readyAttempts) {
    let r = get("http://127.0.0.1:${port}/api/v1/info") catch _ {
      sleep(readyDelayMs * Millisecond)
      i = i + 1
      continue
    }
    if (r.status == 200) {
      return true
    }
    sleep(readyDelayMs * Millisecond)
    i = i + 1
  }
  return false
}

// One Mailpit container: SMTP on 1025 and the API on 8025 published to random
// 127.0.0.1 ports. `flags` is what makes it the plain, STARTTLS or TLS server;
// `certDir` is mounted at /tls read-only.
fn startMailpit(
  bin: string, name: string, flags: []string, certDir: string, ownerLabel: string,
): liveContainer! {
  let args = [
    "run", "--rm", "-d", "--name", name, "--label", runLabel, "--label", ownerLabel,
    "-p", "127.0.0.1:0:1025", "-p", "127.0.0.1:0:8025", "-v", "${certDir}:/tls:ro", image,
    "--enable-chaos",
  ]
  for f of flags {
    args = append(args, f)
  }
  dockerRun(bin, args)?
  let smtp = hostPort(bin, name, "1025/tcp")?
  let api = hostPort(bin, name, "8025/tcp")?
  if (!apiReady(api)) {
    fail newError("${name}: GET /api/v1/info never answered 200 within ${readyAttempts * readyDelayMs}ms")
  }
  return liveContainer{ smtp = smtp, api = api }
}

fn tlsFlags(): []string {
  return [
    "--smtp-tls-cert",
    "/tls/server.crt",
    "--smtp-tls-key",
    "/tls/server.key",
    "--smtp-auth-accept-any",
  ]
}

fn starttlsFlags(): []string {
  return append(tlsFlags(), "--smtp-require-starttls")
}

fn implicitTlsFlags(): []string {
  return append(tlsFlags(), "--smtp-require-tls")
}

// Runs `bit test pkg/mail` narrowed to the live tests, with the MAIL_TEST_*
// variables set for exactly that child. A skip line in its stdout is a
// failure: no live proof may fall back to skipping.
fn runLiveTests(bitPath: string, repo: string, ca: string, c: []liveContainer): int {
  let host = "127.0.0.1"
  let r = output(
    "/usr/bin/env",
    [
      "MAIL_TEST_PLAIN_URL=smtp://${host}:${c[0].smtp}?tls=off",
      "MAIL_TEST_STARTTLS_URL=smtp://${smtpUser}:${smtpPass}@${host}:${c[1].smtp}?serverName=localhost",
      "MAIL_TEST_TLS_URL=smtps://${smtpUser}:${smtpPass}@${host}:${c[2].smtp}?serverName=localhost",
      "MAIL_TEST_CA=${ca}", "MAIL_TEST_API_PLAIN=http://${host}:${c[0].api}",
      "MAIL_TEST_API_STARTTLS=http://${host}:${c[1].api}",
      "MAIL_TEST_API_TLS=http://${host}:${c[2].api}", "BIT_REPO=${repo}", "BIT_BIN=${bitPath}",
      bitPath, "test", "${repo}/pkg/mail", "--run", "live: ",
    ],
    testRunTimeoutMs,
  )
  let rc = relay(r, "maillive", testRunTimeoutMs)
  if (contains(r.stdout, "  skipped: ")) {
    eprint("maillive: a live test skipped inside test-package-mail-live — every MAIL_TEST_* var was set, so a skip means the harness or a live test is not reading it\n")
    if (rc == 0) {
      return 1
    }
  }
  if (rc == 0 && !contains(r.stdout, "8 passed")) {
    eprint("maillive: expected the eight live tests to pass; the child printed no '8 passed' line\n")
    return 1
  }
  return rc
}

fn die(bin: string, names: []string, certDir: string, msg: string) {
  eprint("maillive: ${msg}\n")
  cleanup(bin, names, certDir)
  exit(1)
}

fn main() {
  let bin = requireDocker("maillive")
  sweepOrphans(bin, runLabel)

  let ssl = opensslBin()
  if (ssl == "") {
    eprint("maillive: docker is available but no openssl binary was found — cannot generate the TLS certificates\n")
    exit(1)
    return
  }

  let repo = repoRoot()
  let bitPath = envOr("BIT_BIN", "${repo}/bit-out/bin/bit")
  let runId = uuidFormat(uuidV4())
  let names = [
    "bit-mail-live-${runId}",
    "bit-mail-live-starttls-${runId}",
    "bit-mail-live-tls-${runId}",
  ]
  let certDir = "${trimSuffix(envOr("TMPDIR", "/tmp"), "/")}/bit-mail-live-${runId}"

  generateCerts(ssl, certDir) catch e {
    die(bin, names, certDir, e.message())
    return
  }
  let pid = selfPid() catch e {
    die(bin, names, certDir, e.message())
    return
  }
  let ownerLabel = "${ownerLabelKey}=${pid}"
  let flagSets = [[]string(0), starttlsFlags(), implicitTlsFlags()]
  let started = []liveContainer(0)
  let i = 0
  while (i < len(names)) {
    let c = startMailpit(bin, names[i], flagSets[i], certDir, ownerLabel) catch e {
      die(bin, names, certDir, e.message())
      return
    }
    started = append(started, c)
    i = i + 1
  }

  let rc = runLiveTests(bitPath, repo, "${certDir}/ca.crt", started)
  cleanup(bin, names, certDir)
  exit(rc)
}
