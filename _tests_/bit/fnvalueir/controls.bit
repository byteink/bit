import { replace } from "std/strings"

fn selfcheck(oldIR: string, newIR: string, oldObj: []u8, newObj: []u8): bool {
  if (!explain(oldIR, newIR, oldObj, newObj)) {
    return false
  }
  let changes = []string{
    replace(newIR, "const_int i64 1", "const_int i64 2"),
    replace(newIR, "  ret\n", "  ret %0\n"),
    replace(newIR, "call_value", "call"),
    replace(newIR, "global_addr", "func_addr"),
    replace(newIR, "bb0():\n", "bb0():\n\n"),
    "",
  }
  for changed of changes {
    if (changed == newIR || explain(oldIR, changed, oldObj, newObj)) {
      return false
    }
  }
  let literalOld = replace(oldIR, "const_string \" \"", "const_string \"@__bitfnv_9\"")
  let literalNew = replace(newIR, "const_string \" \"", "const_string \"@__bitfnv_8\"")
  if (explain(literalOld, literalNew, oldObj, newObj)) {
    return false
  }
  let wrongReturn = replace(oldIR, "  ret %2\n", "  ret %1\n")
  if (wrongReturn == oldIR || explain(wrongReturn, newIR, oldObj, newObj)) {
    return false
  }
  if (explain(oldIR, newIR, []u8(0), newObj)) {
    return false
  }
  return objectControls(oldIR, newIR, oldObj, newObj) && unknownExtra(oldIR, newIR, oldObj, newObj)
}

// Mutate actual ELF relocation entries, keeping both IR inputs unchanged.
fn objectControls(oldIR: string, newIR: string, oldObj: []u8, newObj: []u8): bool {
  let a = Witness{ obj = readElf("fnvalueir", oldObj, true), bytes = oldObj }
  let b = Witness{ obj = readElf("fnvalueir", newObj, true), bytes = newObj }
  let pairs = pairRefs(a, b, oldIR, newIR)
  if (len(pairs) < 2) {
    return false
  }
  let first = symbol(b, pairs[0].newName)
  let wrapper = symbol(b, descriptor(b, pairs[0].newName))
  let dr = atomRelocs(b, first)[0]
  let wr = atomRelocs(b, wrapper)[0]
  if (!corruptReloc(
    oldIR,
    newIR,
    oldObj,
    newObj,
    ObjReloc{ sect = first.sect, off = first.value + dr.off, toSym = "" },
  )) {
    return false
  }
  if (!corruptReloc(
    oldIR,
    newIR,
    oldObj,
    newObj,
    ObjReloc{ sect = wrapper.sect, off = wrapper.value + wr.off, toSym = "" },
  )) {
    return false
  }
  let env = cloneBytes(newObj)
  env[b.obj.secs[first.sect].off + first.value + 8] = u8(1)
  if (explain(oldIR, newIR, oldObj, env)) {
    return false
  }
  let abi = cloneBytes(newObj)
  let start = b.obj.secs[wrapper.sect].off + wrapper.value
  abi[start] = abi[start] ^ u8(1)
  return !explain(oldIR, newIR, oldObj, abi) && explain(oldIR, newIR, oldObj, newObj)
}

fn cloneBytes(bytes: []u8): []u8 {
  let out = []u8(len(bytes))
  let i = 0
  while (i < len(bytes)) {
    out[i] = bytes[i]
    i = i + 1
  }
  return out
}

fn corruptReloc(
  oldIR: string,
  newIR: string,
  oldObj: []u8,
  newObj: []u8,
  anchor: ObjReloc,
): bool {
  let secs = readElf("fnvalueir", newObj, true).secs
  for sec of secs {
    if (sec.kind != 4 || sec.info != anchor.sect) {
      continue
    }
    let at = sec.off
    while (at < sec.off + sec.size) {
      if (relocationOffset(newObj, at, anchor.off)) {
        return corruptEntry(oldIR, newIR, oldObj, newObj, at)
      }
      at = at + 24
    }
  }
  return false
}

fn relocationOffset(bytes: []u8, at: int, offset: int): bool {
  let i = 0
  while (i < 8) {
    if (bytes[at + i] != u8((offset >> (i * 8)) & 255)) {
      return false
    }
    i = i + 1
  }
  return true
}

fn corruptEntry(oldIR: string, newIR: string, oldObj: []u8, newObj: []u8, at: int): bool {
  for field of []int{ 0, 8, 12, 16 } {
    let changed = cloneBytes(newObj)
    changed[at + field] = changed[at + field] ^ u8(1)
    if (explain(oldIR, newIR, oldObj, changed)) {
      return false
    }
  }
  return true
}

// A second unknown relocation at +8 must not disappear from the witness.
fn unknownExtra(oldIR: string, newIR: string, oldObj: []u8, newObj: []u8): bool {
  let b = Witness{ obj = readElf("fnvalueir", newObj, true), bytes = newObj }
  let refs = references(newIR)
  if (len(refs) < 2) {
    return false
  }
  let first = symbol(b, refs[0])
  let other = symbol(b, refs[1])
  for sec of b.obj.secs {
    if (sec.kind != 4 || sec.info != other.sect) {
      continue
    }
    let at = sec.off
    while (at < sec.off + sec.size) {
      if (relocationOffset(newObj, at, other.value)) {
        let changed = cloneBytes(newObj)
        writeUnknown(changed, at, first.value + 8)
        return !explain(oldIR, newIR, oldObj, changed)
      }
      at = at + 24
    }
  }
  return false
}

fn writeUnknown(bytes: []u8, at: int, offset: int) {
  let i = 0
  while (i < 8) {
    bytes[at + i] = u8((offset >> (i * 8)) & 255)
    i = i + 1
  }
  i = 12
  while (i < 16) {
    bytes[at + i] = u8(255)
    i = i + 1
  }
}
