// #7925: root-only IR loses imported wrappers. ELF proves the closure's owner
// and executable ABI before any root symbol can change in this comparison.
import { Obj, ObjSym, ObjReloc, readElf } from "../objread"
import { indexOf, split, lastIndexOf, hasPrefix } from "std/strings"

class Witness { obj: Obj, bytes: []u8 }
class Pair { oldName: string, newName: string }

fn symbol(w: Witness, name: string): ObjSym {
  let found = ObjSym{ name = "", sect = -1, value = 0, isGlobal = false }
  for s of w.obj.syms {
    if (s.name != name) {
      continue
    }
    if (found.sect >= 0) {
      return ObjSym{ name = "", sect = -1, value = 0, isGlobal = false }
    }
    found = s
  }
  return found
}

fn atomBytes(w: Witness, s: ObjSym): []u8 {
  if (s.sect < 0 || s.sect >= len(w.obj.secs) || s.size <= 0) {
    return []u8(0)
  }
  let sec = w.obj.secs[s.sect]
  if (s.value < 0 || s.value > sec.size || s.size > sec.size - s.value) {
    return []u8(0)
  }
  let start = sec.off + s.value
  if (start < 0 || start > len(w.bytes) || s.size > len(w.bytes) - start) {
    return []u8(0)
  }
  return w.bytes[start:start + s.size]
}

fn atomRelocs(w: Witness, s: ObjSym): []ObjReloc {
  let out = []ObjReloc(0)
  for r of w.obj.relocs {
    if (r.sect == s.sect && r.off >= s.value && r.off - s.value < s.size) {
      out = append(
        out,
        ObjReloc{
          sect = r.sect,
          off = r.off - s.value,
          toSym = r.toSym,
          kind = r.kind,
          addend = r.addend,
        },
      )
    }
  }
  return out
}

fn zeroBytes(b: []u8): bool {
  if (len(b) == 0) {
    return false
  }
  for v of b {
    if (v != u8(0)) {
      return false
    }
  }
  return true
}

fn descriptor(w: Witness, name: string): string {
  let s = symbol(w, name)
  if (s.size != 16 || !zeroBytes(atomBytes(w, s))) {
    return ""
  }
  let rs = atomRelocs(w, s)
  if (len(rs) != 1) {
    return ""
  }
  let r = rs[0]
  if (r.off != 0 || r.kind != 1 || r.addend != 0 || !hasPrefix(r.toSym, "fnvalue$trampoline$")) {
    return ""
  }
  return r.toSym
}

fn wrapperTarget(w: Witness, name: string): string {
  let s = symbol(w, name)
  let bytes = atomBytes(w, s)
  let rs = atomRelocs(w, s)
  if (len(bytes) == 0 || len(rs) != 1) {
    return ""
  }
  let r = rs[0]
  if (r.kind != 2 || r.addend != -4 || r.off < 1 || r.off + 4 > len(bytes)) {
    return ""
  }
  if (bytes[r.off - 1] != u8(0xe8) || symbol(w, r.toSym).sect < 0) {
    return ""
  }
  return r.toSym
}

fn sameWrapper(a: Witness, an: string, b: Witness, bn: string): bool {
  let target = wrapperTarget(a, an)
  if (target == "" || target != wrapperTarget(b, bn)) {
    return false
  }
  let ab = atomBytes(a, symbol(a, an))
  let bb = atomBytes(b, symbol(b, bn))
  if (len(ab) != len(bb)) {
    return false
  }
  let i = 0
  while (i < len(ab)) {
    if (ab[i] != bb[i]) {
      return false
    }
    i = i + 1
  }
  let ar = atomRelocs(a, symbol(a, an))[0]
  let br = atomRelocs(b, symbol(b, bn))[0]
  return ar.off == br.off && ar.kind == br.kind && ar.addend == br.addend
}

// A symbol ends at the IR token boundary. Prefix replacement would merge 9/90.
fn tokenEnd(s: string, at: int): int {
  let end = at
  while (end < len(s)) {
    let c = s[end]
    if (!((c >= u8('a') && c <= u8('z')) ||
      (c >= u8('A') && c <= u8('Z')) ||
      (c >= u8('0') && c <= u8('9')) ||
      c == u8('_') ||
      c == u8('$'))) {
      break
    }
    end = end + 1
  }
  return end
}

fn globalName(line: string): string {
  if (!hasPrefix(line, "  %")) {
    return ""
  }
  let at = 3
  while (at < len(line) && line[at] >= u8('0') && line[at] <= u8('9')) {
    at = at + 1
  }
  if (at == 3 || !hasPrefix(line[at:], " = global_addr @")) {
    return ""
  }
  let start = at + len(" = global_addr @")
  let end = tokenEnd(line, start)
  if (end != len(line)) {
    return ""
  }
  return line[start:end]
}

fn references(s: string): []string {
  let out = []string(0)
  for line of split(s, "\n") {
    let name = globalName(line)
    if (!hasPrefix(name, "__bitfnv_")) {
      continue
    }
    let seen = false
    for old of out {
      if (old == name) {
        seen = true
      }
    }
    if (!seen) {
      out = append(out, name)
    }
  }
  return out
}

fn pairRefs(a: Witness, b: Witness, oldIR: string, newIR: string): []Pair {
  let oldRefs = references(oldIR)
  let newRefs = references(newIR)
  if (len(oldRefs) == 0 || len(oldRefs) != len(newRefs)) {
    return []Pair(0)
  }
  let out = []Pair(0)
  for old of oldRefs {
    let ow = descriptor(a, old)
    let matchName = ""
    for fresh of newRefs {
      if (!sameWrapper(a, ow, b, descriptor(b, fresh))) {
        continue
      }
      if (matchName != "") {
        return []Pair(0)
      }
      matchName = fresh
    }
    if (matchName == "") {
      return []Pair(0)
    }
    for p of out {
      if (p.newName == matchName) {
        return []Pair(0)
      }
    }
    out = append(out, Pair{ oldName = old, newName = matchName })
  }
  return out
}

fn mappedIR(s: string, pairs: []Pair): string {
  let out = ""
  let lines = split(s, "\n")
  let i = 0
  while (i < len(lines)) {
    let line = lines[i]
    let name = globalName(line)
    for p of pairs {
      if (p.oldName == name) {
        line = line[:len(line) - len(name)] + p.newName
      }
    }
    if (i > 0) {
      out = out + "\n"
    }
    out = out + line
    i = i + 1
  }
  return out
}

// Accept only a single direct-call wrapper, with every argument forwarded and
// its result returned. Unrecognized wrappers remain unexplained.
fn forwardedArgs(ps: []string): string {
  let args = ""
  let i = 1
  while (i < len(ps)) {
    let colon = int(indexOf(ps[i], ": "))
    if (colon < 1) {
      return ""
    }
    if (i > 1) {
      args = args + ", "
    }
    args = args + ps[i][:colon]
    i = i + 1
  }
  return args
}

fn wrapperHeader(lines: []string, name: string): bool {
  if ((len(lines) != 5 && len(lines) != 6) || !hasPrefix(lines[0], "func ${name}(")) {
    return false
  }
  if (len(lines) == 6 && lines[5] != "") {
    return false
  }
  let paramsAt = len("func ${name}")
  let resultAt = int(lastIndexOf(lines[0], ") "))
  if (resultAt < paramsAt || !hasPrefix(lines[1], "bb0(")) {
    return false
  }
  let params = lines[0][paramsAt + 1:resultAt]
  return lines[1] == "bb0(${params}):" && lines[4] == "}"
}

fn directWrapper(body: string, name: string, target: string): bool {
  let lines = split(body, "\n")
  if (!wrapperHeader(lines, name)) {
    return false
  }
  let resultAt = int(lastIndexOf(lines[0], ") "))
  let params = lines[0][len("func ${name}("):resultAt]
  let result = lines[0][resultAt + 2:len(lines[0]) - 2]
  let ps = split(params, ", ")
  if (len(ps) < 2 || !hasPrefix(ps[0], "%0: fn(")) {
    return false
  }
  let args = forwardedArgs(ps)
  if (args == "") {
    return false
  }
  let call = "%${len(ps)}"
  return lines[2] == "  ${call} = call @${target}(${args}) ${result}" && lines[3] == "  ret ${call}"
}

fn stripWrappers(oldIR: string, newIR: string, a: Witness, b: Witness, pairs: []Pair): string {
  let chunks = split(oldIR, "\n\n")
  let out = ""
  let removed = 0
  for chunk of chunks {
    if (chunk == "") {
      return ""
    }
    if (!hasPrefix(chunk, "func fnvalue$trampoline$")) {
      out = out + chunk + "\n\n"
      continue
    }
    let end = int(indexOf(chunk, "("))
    if (end < 5) {
      return ""
    }
    let name = chunk[5:end]
    let accepted = false
    for p of pairs {
      if (descriptor(a, p.oldName) != name) {
        continue
      }
      let counterpart = descriptor(b, p.newName)
      if (indexOf(newIR, "func ${counterpart}(") >= 0) {
        return ""
      }
      accepted = directWrapper(chunk, name, wrapperTarget(a, name))
    }
    if (!accepted) {
      return ""
    }
    removed = removed + 1
  }
  if (removed == 0) {
    return ""
  }
  return out[:len(out) - 1]
}

fn explain(oldIR: string, newIR: string, oldBytes: []u8, newBytes: []u8): bool {
  if (!witnessHeader(oldBytes) || !witnessHeader(newBytes)) {
    return false
  }
  let a = Witness{ obj = readElf("fnvalueir", oldBytes, true), bytes = oldBytes }
  let b = Witness{ obj = readElf("fnvalueir", newBytes, true), bytes = newBytes }
  if (!witnessValid(a) || !witnessValid(b)) {
    return false
  }
  let pairs = pairRefs(a, b, oldIR, newIR)
  if (len(pairs) == 0) {
    return false
  }
  let stripped = stripWrappers(oldIR, newIR, a, b, pairs)
  // dumpIr's separator after the last function is part of the contract.
  return stripped != "" && mappedIR(stripped, pairs) == newIR
}

fn witnessHeader(bytes: []u8): bool {
  if (len(bytes) < 64) {
    return false
  }
  return bytes[16] == u8(1) &&
    bytes[17] == u8(0) &&
    bytes[18] == u8(62) &&
    bytes[19] == u8(0) &&
    bytes[20] == u8(1) &&
    bytes[21] == u8(0) &&
    bytes[22] == u8(0) &&
    bytes[23] == u8(0)
}

fn witnessValid(w: Witness): bool {
  if (!w.obj.ok) {
    return false
  }
  for r of w.obj.relocs {
    if (!witnessRelocValid(w, r)) {
      return false
    }
  }
  for sec of w.obj.secs {
    if (sec.kind == 4 && (sec.info <= 0 || sec.info >= len(w.obj.secs))) {
      return false
    }
  }
  return true
}

fn witnessRelocValid(w: Witness, r: ObjReloc): bool {
  if (r.toSym == "" || r.sect < 0 || r.sect >= len(w.obj.secs)) {
    return false
  }
  return r.off >= 0 && r.off < w.obj.secs[r.sect].size
}
