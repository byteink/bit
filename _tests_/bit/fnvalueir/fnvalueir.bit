import { readFile } from "std/fs"
import { args, exit } from "std/os"

fn main() {
  let argv = args()
  let testing = len(argv) == 6 && argv[1] == "--selfcheck"
  if (len(argv) != 5 && !testing) {
    exit(2)
  }
  let offset = 0
  if (testing) {
    offset = 1
  }
  runCheck(argv, offset, testing)
}

fn load(path: string): string {
  return readFile(path) catch _ {
    exit(2)
  }
}

fn runCheck(argv: []string, offset: int, testing: bool) {
  let oldIR = load(argv[1 + offset])
  let newIR = load(argv[2 + offset])
  let oldObj = load(argv[3 + offset])
  let newObj = load(argv[4 + offset])
  if (testing) {
    if (!selfcheck(oldIR, newIR, []u8(oldObj), []u8(newObj))) {
      exit(1)
    }
    print("fnvalueir: self-check passed\n")
    return
  }
  if (!explain(oldIR, newIR, []u8(oldObj), []u8(newObj))) {
    exit(1)
  }
}
