// _tests_/bit/enumtypeassert.bit — #6017 (epic #6013): `e.(EnumType)` and
// `let (v, ok) = e.(EnumType)` for a BOXED enum target, end to end.
//
// NOT placed in _tests_/cases/: the pinned STAGE0 oracle (0.31.0) predates
// this ticket's lowering — `compiler/lowertypeassert.bit`'s enum branch and
// the new `bit_rt_iface_as_enum` runtime primitive — and does not know the
// "iface_as_enum" rt_call name at all. Run stage0 on any fixture below and it
// either refuses to emit a binary (E0092, the bug this ticket fixes) or, for
// the reject cases, may report a DIFFERENT diagnostic than the current
// compiler's new checks do, so SKIPLABEL="lower/check-err" cannot line the
// two compilers up. Same "route it to _tests_/bit/ behind a registered gate"
// treatment _tests_/bit/forofiterator.bit's own header documents.
//
// Four fixtures:
//
//   positive — a WELL-FORMED boxed enum (its declaration-order FIRST variant
//     carries no payload, so it has a zero value, SPEC §13.4/§14.4): proves
//     the two-result match, the two-result MISMATCH (the zero value read back
//     through a method call, not just printed), and the one-result panicking
//     form, across a 0-arg, a 1-arg and a 2-arg variant — the shapes that
//     make a boxed enum's object size vary PER CONSTRUCTION (SPEC §14.7's
//     `8 + 8*argc`), which is exactly why `bit_rt_iface_as_enum` compares
//     descriptors by their `type_id` word rather than by address (ABI.md
//     §2.2a).
//   nonBoxedTarget — a C-like (bare-tag) enum target: rejected at check time,
//     E0041, naming "boxed enum" (`vStorableInInterface`,
//     validateassignable.bit; the check, validateiface.bit's `vTypeAssert`).
//   noZeroValueTarget — a boxed enum whose FIRST variant carries a payload
//     (the ticket's OWN repro shape, and pkg/redis's real `RedisError`,
//     landed by #6019, whose first variant `WrongType(string)` has one too):
//     rejected at check time, E0083, since a mismatch has no zero value to
//     yield (SPEC §14.4/§13.4) — never silently accepted and never a runtime
//     crash. See the ticket comment for the pkg/redis follow-up this implies.
//   twoModule — two SIBLING directory modules each declaring their own
//     `enum Err`, different payloads, same bare name: proves the identity
//     test survives a declared-name COLLISION across modules. `TypeInfo.name`
//     is documented "debug/stats only" (ABI.md §2) precisely because it is
//     not qualified and cannot serve as identity — an earlier version of
//     `bit_rt_iface_as_enum` compared it anyway and this fixture is what
//     review caught it with (#6017): `ok` must read false, and the zero
//     value must print `Err`'s real `Unit` message, never a payload word
//     read back under the OTHER module's `Err`'s layout.
//
// WIRED INTO `./make test` as `test-enumtypeassert` (tools/build/gatestable2.bit,
// tools/build/defs.bit).

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"
import { parseInt, trimSpace, contains } from "std/strings"

const defaultTimeoutS: int = 60
const maxTimeoutMs: int = 6000000

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("enumtypeassert: ${name} is not set — refusing to guess.\n")
    exit(2)
  }
  return v
}

fn timeoutMs(): int {
  let raw = trimSpace(envOr("BIT_TEST_TIMEOUT_S", ""))
  if (raw == "") {
    return defaultTimeoutS * 1000
  }
  let s = parseInt(raw) catch _ {
    return defaultTimeoutS * 1000
  }
  if (s <= 0) {
    return maxTimeoutMs
  }
  if (s * 1000 > maxTimeoutMs) {
    return maxTimeoutMs
  }
  return s * 1000
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

class CompilerEnv {
  bin: string,
  stdlib: string,
  libbitrt: string,
}

fn buildOne(cc: CompilerEnv, dir: string, srcPath: string, outPath: string): (int, string) {
  let shPath = dir + "/build.sh"
  let errPath = dir + "/build.err"
  let script = "#!/bin/sh\n" +
    "BIT_STDLIB=" +
    shQuote(cc.stdlib) +
    "\nexport BIT_STDLIB\n" +
    "BIT_LIBBITRT=" +
    shQuote(cc.libbitrt) +
    "\nexport BIT_LIBBITRT\n" +
    "exec " +
    shQuote(cc.bin) +
    " build " +
    shQuote(srcPath) +
    " -o " +
    shQuote(outPath) +
    " > /dev/null 2> " +
    shQuote(errPath) +
    "\n"
  writeFile(shPath, script) catch e {
    eprint("enumtypeassert: cannot write build wrapper: ${e.message()}\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("enumtypeassert: cannot chmod build wrapper\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let err = readFile(errPath) catch _ {
    ""
  }
  return code, err
}

fn runOne(dir: string, binPath: string): (int, string) {
  let shPath = dir + "/run.sh"
  let outPath = dir + "/run.out"
  let script = "#!/bin/sh\nexec " + shQuote(binPath) + " > " + shQuote(outPath) + " 2>&1\n"
  writeFile(shPath, script) catch e {
    eprint("enumtypeassert: cannot write run wrapper: ${e.message()}\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("enumtypeassert: cannot chmod run wrapper\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let out = readFile(outPath) catch _ {
    ""
  }
  return code, out
}

fn teardown(scratch: string, ms: int) {
  let shPath = scratch + "/rm.sh"
  writeFile(shPath, "#!/bin/sh\nrm -rf '${scratch}'\n") catch _ {
    return
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    return
  }
  osRunBounded(shPath, ms)
}

fn failGate(scratch: string, msg: string) {
  eprint("enumtypeassert: FAIL — ${msg}\n")
  teardown(scratch, timeoutMs())
  exit(1)
}

// A boxed enum whose tag-0 variant (`Timeout`) carries no payload, so it has
// a zero value — the well-formed shape the checker now requires (#6017). The
// other two variants are 1-arg and 2-arg, so their constructions allocate
// 16 and 24 bytes respectively (SPEC §14.7): the SAME nominal type, TWO
// object sizes, which is exactly the case a descriptor-pointer identity test
// cannot decide and `bit_rt_iface_as_enum`'s name comparison does (ABI.md
// §2.2a).
const positiveSrc: string = "enum RedisError {\n" +
  "  Timeout\n" +
  "  WrongType(string)\n" +
  "  Moved(int, string)\n" +
  "  export message(): string {\n" +
  "    match (this) {\n" +
  "      Timeout => return \"timeout\"\n" +
  "      WrongType(m) => return \"wrongtype:\${m}\"\n" +
  "      Moved(slot, addr) => return \"moved:\${slot}:\${addr}\"\n" +
  "    }\n" +
  "  }\n" +
  "}\n\n" +
  "enum OtherErr {\n" +
  "  Nope\n" +
  "  Oops(string)\n" +
  "  export message(): string {\n" +
  "    match (this) {\n" +
  "      Nope => return \"nope\"\n" +
  "      Oops(m) => return \"oops:\${m}\"\n" +
  "    }\n" +
  "  }\n" +
  "}\n\n" +
  "fn doOp(which: int): int! {\n" +
  "  if (which == 0) { fail RedisError.Timeout }\n" +
  "  if (which == 1) { fail RedisError.WrongType(\"bad\") }\n" +
  "  fail RedisError.Moved(3, \"host:1\")\n" +
  "}\n\n" +
  "fn tryOne(which: int) {\n" +
  "  let unused = doOp(which) catch e {\n" +
  "    let (re, ok) = e.(RedisError)\n" +
  "    print(\"ok=\${ok} \")\n" +
  "    if (ok) { print(\"matched=\${re.message()} \") }\n" +
  "    let (o, ok2) = e.(OtherErr)\n" +
  "    print(\"ok2=\${ok2} zero=\${o.message()}\\n\")\n" +
  "    0\n" +
  "  }\n" +
  "}\n\n" +
  "fn panicsOnMismatch() {\n" +
  "  let unused = doOp(0) catch e {\n" +
  "    let v = e.(OtherErr)\n" +
  "    print(\"unreachable \${v.message()}\\n\")\n" +
  "    0\n" +
  "  }\n" +
  "}\n\n" +
  "fn main() {\n" +
  "  tryOne(0)\n" +
  "  tryOne(1)\n" +
  "  tryOne(2)\n" +
  "  panicsOnMismatch()\n" +
  "}\n"

const wantPositiveOut: string = "ok=true matched=timeout ok2=false zero=nope\n" +
  "ok=true matched=wrongtype:bad ok2=false zero=nope\n" +
  "ok=true matched=moved:3:host:1 ok2=false zero=nope\n" +
  "panic: type assertion failed: the dynamic type does not satisfy OtherErr\n"

// A C-like (bare-tag) enum target: SPEC §14.3/§14.7 — it is a raw `i64`, not
// an object, so it can never be the dynamic type behind an interface value.
const nonBoxedTargetSrc: string = "enum Color { Red, Green, Blue }\n\n" +
  "fn asColor(e: error) {\n" +
  "  let (c, ok) = e.(Color)\n" +
  "  print(\"\${ok}\\n\")\n" +
  "}\n\n" +
  "fn main() {}\n"

// The ticket's OWN repro shape (and pkg/redis's real RedisError, #6019):
// tag-0 carries a payload, so the type has no zero value at all.
const noZeroValueTargetSrc: string = "enum RedisError {\n" +
  "  WrongType(string)\n" +
  "  Timeout\n" +
  "  export message(): string {\n" +
  "    match (this) {\n" +
  "      WrongType(m) => return m\n" +
  "      Timeout => return \"timeout\"\n" +
  "    }\n" +
  "  }\n" +
  "}\n\n" +
  "fn doOp(): int! { fail RedisError.Timeout }\n\n" +
  "fn main() {\n" +
  "  let unused = doOp() catch e {\n" +
  "    let (re, ok) = e.(RedisError)\n" +
  "    if (ok) { print(\"\${re.message()}\\n\") }\n" +
  "    0\n" +
  "  }\n" +
  "}\n"

// Two SIBLING directory modules (SPEC §17.1) each declaring their OWN `Err`
// with the SAME name and DIFFERENT payloads — the shape #6017's review
// found unsound under a NAME-based identity test: `TypeInfo.name` is the
// bare declared name with no module qualification (ABI.md §2), so a
// name-only compare would have called these the same type and then read a
// `string` pointer back as an `i64` (or crashed). `bit_rt_iface_as_enum`
// compares the `type_id` word instead (ABI.md §2.2a), which is unique per
// declaration regardless of name, so this must report `ok=false`, never a
// wrong-type read and never a crash — proven by reading `twoModuleA.A`'s
// zero value (`Unit`, a real, harmless string) through `.message()`, not
// just printing `ok`.
const twoModuleASrc: string = "export enum Err {\n" +
  "  Unit\n" +
  "  A(string)\n" +
  "  export message(): string {\n" +
  "    match (this) {\n" +
  "      Unit => return \"unit\"\n" +
  "      A(s) => return \"a:\${s}\"\n" +
  "    }\n" +
  "  }\n" +
  "}\n"

const twoModuleBSrc: string = "export enum Err {\n" +
  "  Unit\n" +
  "  A(i64)\n" +
  "  export message(): string {\n" +
  "    match (this) {\n" +
  "      Unit => return \"unit\"\n" +
  "      A(n) => return \"a:\${n}\"\n" +
  "    }\n" +
  "  }\n" +
  "}\n"

const twoModuleMainSrc: string = "import { Err as AErr } from \"./a\"\n" +
  "import { Err as BErr } from \"./b\"\n\n" +
  "fn make(): int! { fail AErr.A(\"hello\") }\n\n" +
  "fn main() {\n" +
  "  let unused = make() catch e {\n" +
  "    let (b, ok) = e.(BErr)\n" +
  "    print(\"ok=\${ok} zero=\${b.message()}\\n\")\n" +
  "    0\n" +
  "  }\n" +
  "}\n"

const wantTwoModuleOut: string = "ok=false zero=unit\n"

fn runTwoModule(cc: CompilerEnv, scratch: string) {
  let dir = scratch + "/twomodule"
  mkdir(dir) catch e {
    failGate(scratch, "cannot create ${dir}: ${e.message()}")
  }
  mkdir(dir + "/a") catch e {
    failGate(scratch, "cannot create ${dir}/a: ${e.message()}")
  }
  mkdir(dir + "/b") catch e {
    failGate(scratch, "cannot create ${dir}/b: ${e.message()}")
  }
  writeFile(dir + "/a/err.bit", twoModuleASrc) catch e {
    failGate(scratch, "cannot write ${dir}/a/err.bit: ${e.message()}")
  }
  writeFile(dir + "/b/err.bit", twoModuleBSrc) catch e {
    failGate(scratch, "cannot write ${dir}/b/err.bit: ${e.message()}")
  }
  let srcPath = dir + "/main.bit"
  writeFile(srcPath, twoModuleMainSrc) catch e {
    failGate(scratch, "cannot write ${srcPath}: ${e.message()}")
  }
  let outPath = dir + "/fixture_out"
  let (buildCode, buildErr) = buildOne(cc, dir, srcPath, outPath)
  if (buildCode != 0) {
    failGate(scratch, "two-module fixture failed to build (exit ${buildCode}):\n${buildErr}")
  }
  let (runCode, out) = runOne(dir, outPath)
  if (runCode != 0 || out != wantTwoModuleOut) {
    failGate(scratch, "two-module fixture ran wrong (type confusion?): exit=${runCode}\n  want: ${wantTwoModuleOut}\n  got:  ${out}")
  }
}

fn runPositive(cc: CompilerEnv, scratch: string) {
  let dir = scratch + "/positive"
  mkdir(dir) catch e {
    failGate(scratch, "cannot create ${dir}: ${e.message()}")
  }
  let srcPath = dir + "/fixture.bit"
  writeFile(srcPath, positiveSrc) catch e {
    failGate(scratch, "cannot write ${srcPath}: ${e.message()}")
  }
  let outPath = dir + "/fixture_out"
  let (buildCode, buildErr) = buildOne(cc, dir, srcPath, outPath)
  if (buildCode != 0) {
    failGate(scratch, "positive fixture failed to build (exit ${buildCode}):\n${buildErr}")
  }
  let (runCode, out) = runOne(dir, outPath)
  if (runCode != 2 || out != wantPositiveOut) {
    failGate(scratch, "positive fixture ran wrong: exit=${runCode}\n  want: ${wantPositiveOut}\n  got:  ${out}")
  }
}

fn runRejected(cc: CompilerEnv, scratch: string, label: string, src: string, wantCode: string, wantText: string) {
  let dir = scratch + "/${label}"
  mkdir(dir) catch e {
    failGate(scratch, "cannot create ${dir}: ${e.message()}")
  }
  let srcPath = dir + "/fixture.bit"
  writeFile(srcPath, src) catch e {
    failGate(scratch, "cannot write ${srcPath}: ${e.message()}")
  }
  let outPath = dir + "/fixture_out"
  let (buildCode, buildErr) = buildOne(cc, dir, srcPath, outPath)
  if (buildCode == 0) {
    failGate(scratch, "${label}: built successfully; it must be rejected by bit check")
  }
  if (!contains(buildErr, wantCode) || !contains(buildErr, wantText)) {
    failGate(scratch, "${label}: rejected (exit ${buildCode}) but did not report ${wantCode} naming '${wantText}':\n${buildErr}")
  }
}

fn main() {
  let cc = CompilerEnv{
    bin = requiredEnv("BIT_BIN"),
    stdlib = requiredEnv("BIT_STDLIB"),
    libbitrt = requiredEnv("BIT_LIBBITRT"),
  }

  let scratch = envOr("TMPDIR", "/tmp") + "/bit-enumtypeassert-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("enumtypeassert: cannot create scratch directory ${scratch}: ${e.message()}\n")
    exit(2)
  }

  runPositive(cc, scratch)
  runRejected(cc, scratch, "nonboxed", nonBoxedTargetSrc, "E0041", "boxed enum")
  runRejected(cc, scratch, "nozerovalue", noZeroValueTargetSrc, "E0083", "WrongType")
  runTwoModule(cc, scratch)

  teardown(scratch, timeoutMs())
  print("PASS enumtypeassert: e.(EnumType) and let (v, ok) = e.(EnumType) lower and run correctly for a boxed enum with a zero value, are rejected by bit check otherwise, and two same-named enums in different modules are never confused\n")
}
