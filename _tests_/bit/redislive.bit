// _tests_/bit/redislive.bit — `./make test-package-redis-live` (#6021, epic
// #6013). Provisions its OWN Redis server rather than depending on one
// someone else started: a throwaway `docker run --rm -d` container per
// scheme (plain, TLS, and a RESP2-only legacy server), PING-polled ready,
// handed to pkg/redis/client.live.test.bit and conn.live.test.bit as REDIS_TEST_URL /
// REDIS_TEST_TLS_URL / REDIS_TEST_V5_URL (plus the TLS test CAs), then always
// removed — see `cleanup()` for exactly what "always" covers.
//
// IMAGE: `redis:8.10.2` (Redis Open Source, stable 2026-09-17 per its GitHub
// release, `prerelease: false`), pinned BY DIGEST so a retag upstream cannot
// silently change what this gate runs against:
//
//   redis@sha256:d5ac52db24d4e70566fe9944f22cf5bdc2bc739b05c0f426335161ea6c23f3b3
//
// That is 8.10's newest patch and 8.10 is the newest stable minor (8.2, 8.4,
// 8.6, 8.8, 8.10 all published; no 9.x yet) as of 2026-09-27 — re-verify
// before bumping:
//   curl -s https://hub.docker.com/v2/repositories/library/redis/tags/8.10.2 | jq .digest
//   curl -s https://api.github.com/repos/redis/redis/releases/tags/<version> | jq .prerelease
//
// LEGACY IMAGE: `redis:5.0.14` (the last 5.x release; Redis 5 is the newest
// line without `HELLO`, which arrived in 6.0), pinned by the multi-arch index
// digest the Docker Hub tag API reports for `5.0.14` (amd64 and arm64 among
// its platforms):
//
//   redis@sha256:fc5ecd863862f89f04334b7cbb57e93c9790478ea8188a49f6e57b0967d38c75
//
// A real old server, not a fake and not a renamed command: it answers `HELLO`
// with the one message a RESP2 fallback keys on (`-ERR unknown command
// 'HELLO'`), and speaks only RESP2 afterwards. Redis 5 has no TLS and no
// `--enable-debug-command`, so it serves only the plain-text fallback tests.
//
// OPENSSL IMAGE: `alpine/openssl:3.5.9` by digest. The TLS fixtures (a CA, a
// server certificate it signed for localhost/127.0.0.1, and a second,
// unrelated CA) are generated inside this throwaway container and read back
// off its stdout (so remote-docker mode, which cannot return a mounted
// directory, works too); no openssl runs on the host, and none is needed.
//
//   alpine/openssl@sha256:e8a2319d15637db5296c0ff540bb028cfabc480b22fcdd4a020582393d32673f
//
// THE IMAGES THEMSELVES ARE KEPT, never deleted by this gate: `docker run`
// auto-pulls them on first use (no explicit `docker pull` step below), and
// deleting pinned images after every green run only to re-pull them next
// time makes a gate meant to run often slow for no safety benefit —
// the local-machine-hygiene rule (bitlang-ws's top-level CLAUDE.md) is about
// not leaving ONE-OFF, throwaway installs behind, and a pinned image this
// gate itself depends on every run is neither. Only the CONTAINERS are
// throwaway and torn down every run — see CLEANUP below.
//
// WITHOUT DOCKER: no `docker` binary, or `docker info` failing three times
// (daemon down, or `DOCKER_HOST` pointed at a dead socket) — FAILS, naming the
// probe error and its duration (_tests_/bit/dockerlive/dockerlive.bit). A live
// gate that skips is green having run nothing (#6353); only the explicit
// opt-out `BIT_LIVE_OPTIONAL=1` prints "skipped: docker unavailable" and
// exits 0.
//
// CLEANUP: every container this run starts is named with a run-local UUID
// AND labelled `bit.redis.live=1`; `cleanup()` removes both by name on every
// path this PROCESS controls — success, a failing live test, a docker/openssl
// step failing partway through setup. It cannot clean up after a `kill -9`:
// no Bit program can run code after that, in any language. The label is the
// mitigation instead of a promise this process cannot keep: `sweepOrphans()`
// runs FIRST, before this run starts anything, and force-removes every
// `bit.redis.live=1` container left over from a run that was interrupted —
// so an orphan outlives at most one invocation of this gate, never
// accumulates.
//
// ENV vars this harness reads (`./make test-package-redis-live` sets the
// first two, tools/build/gatestable2.bit):
//   BIT_REPO   repo root, so pkg/redis resolves regardless of cwd (required)
//   BIT_BIN    compiler under test    (default bit-out/bin/bit)
//
// ENV vars this harness hands the test process (client.live.test.bit, conn.live.test.bit):
//   REDIS_TEST_URL            plain redis 8.10.2
//   REDIS_TEST_TLS_URL        the same server over TLS (tls-port), signed by the CA below
//   REDIS_TEST_V5_URL         redis 5.0.14, no HELLO: the RESP2 fallback's real server
//   REDIS_TEST_TLS_CA         PEM of the CA that signed the TLS server's certificate
//   REDIS_TEST_TLS_OTHER_CA   PEM of an unrelated CA (must be refused)
//
// `bit test` inherits no argv (`bit run` forwards none either) and this
// package's live tests read their target off `REDIS_TEST_*`
// variables, not a CLI flag — `runLiveTests()` below sets them by
// exec'ing `/usr/bin/env VAR=... <bit> test <file>` rather than the plain
// `<bit> test <file>` every other gate uses: `std/process`'s `run`/`output`
// exec directly with no shell and inherit only THIS process's own
// environment (their own doc comments), so a child-only variable has no
// route in except through a wrapper that sets it before exec'ing the real
// target — the same `env(1)` trick any shell script uses for the same
// reason, proved in isolation on #6021 (`bit run` a probe `.test.bit` that
// asserts on an env var, launched through this exact `/usr/bin/env VAR=...
// <bit> test <probe>` shape).

import { output } from "std/process"
import { env, envOr, exit } from "std/os"
import { mkdir, remove, writeFile } from "std/fs"
import { contains, hasSuffix, indexOf, parseInt, split, trimSpace } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"
import { sleep, Millisecond } from "std/time"
import {
  dockerOutput, dockerQuickTimeoutMs, dockerRunTimeoutMs, dockerRun, failureText, hostPort,
  relay, requireDocker, releaseDocker,
} from "./dockerlive"

const image: string = "redis@sha256:d5ac52db24d4e70566fe9944f22cf5bdc2bc739b05c0f426335161ea6c23f3b3"
const legacyImage: string = "redis@sha256:fc5ecd863862f89f04334b7cbb57e93c9790478ea8188a49f6e57b0967d38c75"
const opensslImage: string = "alpine/openssl@sha256:e8a2319d15637db5296c0ff540bb028cfabc480b22fcdd4a020582393d32673f"
const runLabel: string = "bit.redis.live=1"
// Pairs with `runLabel` on every container this run starts (see
// `startPlain`/`startTls` below): the owning process's own pid, learned via
// `selfPid`'s `$PPID` trick. `sweepOrphans` removes a labelled container
// only when that pid is no longer alive, so a concurrent peer's still-running
// containers are left alone (#6327).
const ownerLabelKey: string = "bit.live.owner"
// Bounded poll: 40 * 500ms = 20s per container, generous for a local
// daemon-managed pull-and-boot that already completed before PING is tried.
const readyAttempts: int = 40
const readyDelayMs: int = 500
const testRunTimeoutMs: int = 120000

// BIT_REPO IS REQUIRED, same reason as _tests_/bit/packagesgate.bit and
// _tests_/bit/coldboot.bit: falling back to "." would silently test whatever
// directory `bit` happened to be invoked from instead of refusing.
fn repoRoot(): string {
  let r = env("BIT_REPO")
  if (len(r) == 0) {
    panic("redislive: BIT_REPO is not set — run this through `./make test-package-redis-live`")
  }
  return r
}

// This process's own pid, read off `/bin/sh -c 'echo $PPID'`: `std/process`
// execs every child directly with no shell (its own doc comment), so a
// freshly spawned `/bin/sh`'s parent is always this process itself.
fn selfPid(): int! {
  let r = output("/bin/sh", ["-c", "echo $PPID"], dockerQuickTimeoutMs)
  if (r.exitCode != 0) {
    fail newError("selfPid: /bin/sh exited ${r.exitCode}: ${trimSpace(r.stderr)}")
  }
  return parseInt(trimSpace(r.stdout))?
}

// Whether `pid` still names a live process — `kill -0` sends no signal, only
// checks existence (the same idiom tools/build/gatesexec.bit's watchdogs use).
fn pidAlive(pid: int): bool {
  let r = output("/bin/sh", ["-c", "kill -0 ${pid} 2>/dev/null"], dockerQuickTimeoutMs)
  return r.exitCode == 0
}

// The pid `id` recorded in its own `${ownerLabelKey}` label, or 0 if the
// label is missing or unparseable (a container from before this label
// existed, or a `docker inspect` hiccup) — `sweepOrphans` treats 0 as "no
// owner to protect", so such a container is always removed.
fn containerOwnerPid(bin: string, id: string): int {
  let r = output(
    bin,
    ["inspect", "-f", "{{index .Config.Labels \"${ownerLabelKey}\"}}", id],
    dockerQuickTimeoutMs,
  )
  if (r.exitCode != 0) {
    return 0
  }
  let pid = parseInt(trimSpace(r.stdout)) catch _ {
    return 0
  }
  return pid
}

// Force-removes every container this harness has ever labelled whose owner
// process is no longer alive, before this run starts its own — see the
// header's CLEANUP section for why this exists. A concurrent peer's own
// still-running containers carry a live owner pid and are left alone (#6327).
fn sweepOrphans(bin: string) {
  let r = output(bin, ["ps", "-aq", "--filter", "label=${runLabel}"], dockerQuickTimeoutMs)
  if (r.exitCode != 0) {
    return
  }
  for id of split(trimSpace(r.stdout), "\n") {
    if (id == "") {
      continue
    }
    let ownerPid = containerOwnerPid(bin, id)
    if (ownerPid > 0 && pidAlive(ownerPid)) {
      continue
    }
    output(bin, ["rm", "-f", id], dockerRunTimeoutMs)
  }
}

fn trimSuffix(s: string, suffix: string): string {
  if (hasSuffix(s, suffix)) {
    return s[0:len(s) - len(suffix)]
  }
  return s
}

fn pingReady(bin: string, args: []string): bool {
  let i = 0
  while (i < readyAttempts) {
    let r = output(bin, args, dockerQuickTimeoutMs)
    if (r.exitCode == 0 && contains(r.stdout, "PONG")) {
      return true
    }
    sleep(readyDelayMs * Millisecond)
    i = i + 1
  }
  return false
}

class liveContainer {
  name: string,
  port: int,
}

fn concat(a: []string, b: []string): []string {
  let out = []string(0)
  for x of a {
    out = append(out, x)
  }
  for x of b {
    out = append(out, x)
  }
  return out
}

// What differs between the servers: the image, the `-v` arguments if any, the
// `redis-server` arguments, and the `redis-cli` arguments that reach it from
// inside the container.
class serverSpec {
  image: string,
  mounts: []string,
  serverArgs: []string,
  cliArgs: []string,
}

// One throwaway server: `spec.image` running `redis-server <serverArgs>`, its
// port 6379 published on a random loopback port, polled with `redis-cli
// <cliArgs> ping` run INSIDE the container until it answers PONG.
fn startServer(bin: string, name: string, ownerLabel: string, spec: serverSpec): liveContainer! {
  let runArgs = [
    "run", "--rm", "-d", "--name", name, "--label", runLabel, "--label", ownerLabel,
    "-p", "127.0.0.1:0:6379",
  ]
  let serverCmd = [spec.image, "redis-server"]
  dockerRun(bin, concat(concat(concat(runArgs, spec.mounts), serverCmd), spec.serverArgs))?
  let port = hostPort(bin, name, "6379/tcp")?
  let cli = concat(["exec", name, "redis-cli"], spec.cliArgs)
  let ready = pingReady(bin, concat(cli, ["ping"]))
  if (!ready) {
    fail newError("${name}: PING never answered PONG within ${readyAttempts * readyDelayMs}ms")
  }
  return liveContainer{ name = name, port = port }
}

fn startPlain(bin: string, name: string, password: string, ownerLabel: string): liveContainer! {
  // "local" checks the PEER'S address as Redis sees it inside the
  // container, which is the Docker bridge gateway for a port-published
  // connection, not 127.0.0.1 — "local" refused every live test's
  // DEBUG SLEEP. "yes" is safe here: this container is throwaway,
  // password-protected, and reachable only from 127.0.0.1 on the host
  // (the `-p 127.0.0.1:0:6379` publish in `startServer`).
  return startServer(
    bin,
    name,
    ownerLabel,
    serverSpec{
      image = image,
      mounts = []string(0),
      serverArgs = ["--requirepass", password, "--enable-debug-command", "yes"],
      cliArgs = ["-a", password, "--no-auth-warning"],
    },
  )?
}

// A real Redis 5: no `HELLO`, so `pkg/redis`'s RESP2 fallback is the only way
// in. No `--enable-debug-command` (the flag does not exist before 7.0).
fn startLegacy(bin: string, name: string, password: string, ownerLabel: string): liveContainer! {
  return startServer(
    bin,
    name,
    ownerLabel,
    serverSpec{
      image = legacyImage,
      mounts = []string(0),
      serverArgs = ["--requirepass", password],
      cliArgs = ["-a", password, "--no-auth-warning"],
    },
  )?
}

fn startTls(
  bin: string, name: string, password: string, tlsCertDir: string, ownerLabel: string,
): liveContainer! {
  return startServer(
    bin,
    name,
    ownerLabel,
    serverSpec{
      image = image,
      mounts = ["-v", "${tlsCertDir}:/tls:ro"],
      serverArgs = [
        "--requirepass", password, "--port", "0", "--tls-port", "6379",
        "--tls-cert-file", "/tls/server.crt", "--tls-key-file", "/tls/server.key",
        "--tls-ca-cert-file", "/tls/ca.crt", "--tls-auth-clients", "no",
      ],
      cliArgs = [
        "--tls",
        "--cacert",
        "/tls/ca.crt",
        "-a",
        password,
        "--no-auth-warning",
        "-p",
        "6379",
      ],
    },
  )?
}

// Runs inside `opensslImage` (`sh -c`), prints every file below as
// `@@@ <name>` followed by its PEM. `ca` is a real CA (basicConstraints CA:TRUE,
// keyCertSign) that signed `server.crt` for DNS:localhost and IP:127.0.0.1;
// `other-ca.crt` is a second CA that signed nothing, the "wrong root" fixture.
const certScript: string = `set -e
cd /tmp
for n in ca other-ca; do
  openssl req -x509 -newkey rsa:2048 -nodes -days 2 -keyout $n.key -out $n.crt -subj /CN=bit-redis-live-$n -addext basicConstraints=critical,CA:TRUE -addext keyUsage=critical,keyCertSign,cRLSign 2>/dev/null
done
openssl req -newkey rsa:2048 -nodes -keyout server.key -out server.csr -subj /CN=localhost 2>/dev/null
echo subjectAltName=DNS:localhost,IP:127.0.0.1 > server.ext
echo extendedKeyUsage=serverAuth >> server.ext
echo basicConstraints=CA:FALSE >> server.ext
openssl x509 -req -in server.csr -CA ca.crt -CAkey ca.key -CAcreateserial -days 2 -out server.crt -extfile server.ext 2>/dev/null
for f in ca.crt other-ca.crt server.crt server.key; do echo "@@@ $f"; cat $f; done`

// The text after the line "@@@ <name>" up to the next marker (or the end).
fn section(out: string, name: string): string! {
  let mark = "@@@ ${name}\n"
  let at = indexOf(out, mark)
  if (at < 0) {
    fail newError("openssl container printed no ${name}")
  }
  let rest = out[at + len(mark):]
  let end = indexOf(rest, "@@@ ")
  if (end < 0) {
    return rest
  }
  return rest[0:end]
}

class certs {
  ca: string,
  otherCa: string,
}

// A throwaway PKI generated at gate time INSIDE `opensslImage`: server.key,
// server.crt and ca.crt are written to `dir` (the TLS server's mount); the CA
// PEMs are returned for the test process.
fn generateCerts(bin: string, dir: string, ownerLabel: string): certs! {
  mkdir(dir)?
  let r = dockerOutput(
    bin,
    [
      "run", "--rm", "--label", runLabel, "--label", ownerLabel, "--entrypoint", "sh",
      opensslImage, "-c", certScript,
    ],
    dockerRunTimeoutMs,
  )?
  if (r.exitCode != 0) {
    fail newError("openssl container: ${failureText(r, dockerRunTimeoutMs)}")
  }
  for f of ["server.key", "server.crt", "ca.crt"] {
    writeFile("${dir}/${f}", section(r.stdout, f)?)?
  }
  return certs{ ca = section(r.stdout, "ca.crt")?, otherCa = section(r.stdout, "other-ca.crt")? }
}

fn cleanupCertDir(dir: string) {
  if (dir == "") {
    return
  }
  remove("${dir}/server.key") catch _ {}
  remove("${dir}/server.crt") catch _ {}
  remove("${dir}/ca.crt") catch _ {}
  remove(dir) catch _ {}
}

// Always removes every container (by name, `--rm` already means a stopped
// one vanishes, `rm -f` handles a still-running one too) and the generated
// cert directory — called from every path through `main()` below, success
// or failure alike, never only on the happy path.
fn cleanup(bin: string, names: []string, certDir: string) {
  for name of names {
    output(bin, ["rm", "-f", name], dockerRunTimeoutMs)
  }
  cleanupCertDir(certDir)
  releaseDocker(bin)
}

// The environment one live run hands the test process; see the header.
class liveEnv {
  url: string,
  tlsUrl: string,
  v5Url: string,
  tlsCa: string,
  tlsOtherCa: string,
}

// Targets the pkg/redis DIRECTORY, not client.live.test.bit alone: SPEC
// §17.1, "a single .bit file named directly on the command line is a module
// of exactly that one file — its siblings are not part of it", and
// client.live.test.bit uses `Client`/`connect` from the sibling client.bit.
// `--run "live: "` narrows to exactly the tests this file's `test` blocks
// declare (every name starts with that prefix) without also re-running
// client.test.bit/resp.test.bit/errors.test.bit's fakes — harmless either
// way, but pointless work under a Docker container's own wall clock.
//
// Sets the REDIS_TEST_* variables for exactly the child this spawns — see
// the file header's ENV section for why `/usr/bin/env` is the vehicle.
fn runLiveTests(bitPath: string, repo: string, e: liveEnv): int {
  let r = output(
    "/usr/bin/env",
    [
      "REDIS_TEST_URL=${e.url}", "REDIS_TEST_TLS_URL=${e.tlsUrl}",
      "REDIS_TEST_V5_URL=${e.v5Url}", "REDIS_TEST_TLS_CA=${e.tlsCa}",
      "REDIS_TEST_TLS_OTHER_CA=${e.tlsOtherCa}", bitPath, "test", "${repo}/pkg/redis", "--run",
      "live: ",
    ],
    testRunTimeoutMs,
  )
  return relay(r, "redislive", testRunTimeoutMs)
}

// Prints `msg`, removes everything this run started, exits 1.
fn abort(bin: string, names: []string, certDir: string, msg: string) {
  eprint("redislive: ${msg}\n")
  cleanup(bin, names, certDir)
  exit(1)
}

fn main() {
  let bin = requireDocker("redislive")
  sweepOrphans(bin)

  let repo = repoRoot()
  let bitPath = envOr("BIT_BIN", "${repo}/bit-out/bin/bit")
  let runId = uuidFormat(uuidV4())
  let names = [
    "bit-redis-live-${runId}", "bit-redis-live-tls-${runId}", "bit-redis-live-v5-${runId}",
  ]
  let password = uuidFormat(uuidV4())
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  let certDir = "${tmp}/bit-redis-live-tls-${runId}"

  let pid = selfPid() catch e {
    abort(bin, names, certDir, e.message())
    return
  }
  let ownerLabel = "${ownerLabelKey}=${pid}"
  let pki = generateCerts(bin, certDir, ownerLabel) catch e {
    abort(bin, names, certDir, e.message())
    return
  }
  let plain = startPlain(bin, names[0], password, ownerLabel) catch e {
    abort(bin, names, certDir, e.message())
    return
  }
  let tls = startTls(bin, names[1], password, certDir, ownerLabel) catch e {
    abort(bin, names, certDir, e.message())
    return
  }
  let v5 = startLegacy(bin, names[2], password, ownerLabel) catch e {
    abort(bin, names, certDir, e.message())
    return
  }

  let rc = runLiveTests(
    bitPath,
    repo,
    liveEnv{
      url = "redis://:${password}@127.0.0.1:${plain.port}",
      tlsUrl = "rediss://:${password}@127.0.0.1:${tls.port}",
      v5Url = "redis://:${password}@127.0.0.1:${v5.port}",
      tlsCa = pki.ca,
      tlsOtherCa = pki.otherCa,
    },
  )

  cleanup(bin, names, certDir)
  exit(rc)
}
