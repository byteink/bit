// _tests_/bit/s3live.bit — `./make test-package-s3-live` (#6078/#6104,
// epic #4027). Provisions its OWN S3-compatible server rather than
// depending on one someone else started: a throwaway `docker run --rm -d`
// container, health-polled ready, handed to pkg/s3/client.live.test.bit as
// S3_TEST_ENDPOINT/S3_TEST_BUCKET/S3_TEST_ACCESS_KEY/S3_TEST_SECRET_KEY,
// then always removed — see `cleanup()` for exactly what "always" covers.
// Same shape as _tests_/bit/redislive.bit (#6021).
//
// SERVER: SeaweedFS (github.com/seaweedfs/seaweedfs)'s `weed mini -s3`, via
// its own documented single-container invocation. Chosen over MinIO
// (#6104's own finding: no maintained image is freely pullable as of
// 2026-09-27, gated behind a paid/authenticated channel both on Docker Hub
// and quay.io) after checking each candidate's OWN current source:
//   - SeaweedFS: `chrislusf/seaweedfs` is still the image SeaweedFS's own
//     README documents today (github.com/seaweedfs/seaweedfs/README.md,
//     "## Docker" section, checked 2026-09-27) and pulls anonymously.
//   - Garage (dxflrs/garage): its README documents `dxflrs/garage` on
//     Docker Hub, also anonymous-pullable, but SeaweedFS's single-container
//     `weed mini -s3` (one process, one port, a bucket created from env
//     vars) is a smaller harness than Garage's multi-step bootstrap
//     (`garage bucket create` + `garage key create` + `garage bucket
//     allow` all run as separate `docker exec` calls after start).
//   - Zenko CloudServer (zenko/cloudserver) and LocalStack were not tried
//     once SeaweedFS's own quick-start matched this harness's needs
//     exactly; not a claim either is unavailable.
//
// IMAGE: `chrislusf/seaweedfs`, pinned BY DIGEST so a retag upstream cannot
// silently change what this gate runs against:
//
//   chrislusf/seaweedfs@sha256:ce9e796f1fe6f06968f4c04bdaf8f678dad9c8acdfef3d244133d71bfa6bf882
//
// That digest is also the image the `4.47` tag resolves to (verified with
// `docker pull chrislusf/seaweedfs:4.47`, same digest as `:latest` on
// 2026-09-27), and `4.47` is SeaweedFS's newest non-prerelease GitHub
// release (`api.github.com/repos/seaweedfs/seaweedfs/releases/latest`,
// published 2026-09-14) — re-verify both before bumping.
//
// WITHOUT DOCKER: no `docker` binary at any of `dockerCandidates()`, or
// `docker info` failing — prints "skipped: docker unavailable" and exits 0,
// same as redislive.bit.
//
// CLEANUP: the one container this run starts is named with a run-local UUID
// AND labelled `bit.s3.live=1`; `cleanup()` removes it by name on every path
// this PROCESS controls. `sweepOrphans()` runs FIRST, force-removing every
// `bit.s3.live=1` container left over from an interrupted run, so an orphan
// outlives at most one invocation of this gate.
//
// ENV vars this harness reads (`./make test-package-s3-live` sets both,
// tools/build/defs.bit):
//   BIT_REPO   repo root, so pkg/s3 resolves regardless of cwd (required)
//   BIT_BIN    compiler under test    (default bit-out/bin/bit)
//
// This harness runs the live tests in TWO separate `bit test` invocations:
// `--run "live: "` (put/get/head/delete, pagination, multipart, presigned
// URLs) and a SEPARATE `--run "live streaming: "` for the 220 MiB
// putStream/getStream case, wrapped in `/usr/bin/time -l` so its own peak
// RSS can be checked — mixing it into the first run would make the RSS
// figure include every other live test's own allocations too.

import { output } from "std/process"
import { env, envOr, exit } from "std/os"
import { exists, mkdir, writeFile } from "std/fs"
import { contains, hasSuffix, indexOf, lastIndexOf, parseInt, split, trimSpace } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"
import { sleep, Millisecond } from "std/time"
import { get as httpGet } from "std/http"

const image: string = "chrislusf/seaweedfs@sha256:ce9e796f1fe6f06968f4c04bdaf8f678dad9c8acdfef3d244133d71bfa6bf882"
const runLabel: string = "bit.s3.live=1"
// Bounded poll: 40 * 500ms = 20s, generous for a local pull-and-boot that
// already completed before the first HTTP probe is tried.
const readyAttempts: int = 40
const readyDelayMs: int = 500
const dockerQuickTimeoutMs: int = 10000
const dockerRunTimeoutMs: int = 30000
// The correctness run (put/get/head/delete/list/multipart/presign) is
// small; the streaming run moves 220 MiB over loopback and needs more room.
const testRunTimeoutMs: int = 120000
const streamingRunTimeoutMs: int = 180000
// "well under" 220 MiB (230686720 bytes): measured 2026-09-27 on this exact
// probe program, standalone (not through `bit test`, see `probeSource`'s
// own comment) — 11.8 MB peak RSS for the full 220 MiB put+get round trip.
// 60 MiB is 5x that measurement, real headroom for a slower machine or a
// slightly larger Bit runtime baseline, while still an order of magnitude
// under the object size — a regression to "hold the whole object" would
// blow well past it, not brush against it.
const maxStreamingRssBytes: int = 60 * 1024 * 1024

// BIT_REPO IS REQUIRED, same reason as _tests_/bit/redislive.bit.
fn repoRoot(): string {
  let r = env("BIT_REPO")
  if (len(r) == 0) {
    panic("s3live: BIT_REPO is not set — run this through `./make test-package-s3-live`")
  }
  return r
}

fn findBin(candidates: []string): string {
  let i = 0
  while (i < len(candidates)) {
    if (exists(candidates[i])) {
      return candidates[i]
    }
    i = i + 1
  }
  return ""
}

fn dockerCandidates(): []string {
  return ["/usr/local/bin/docker", "/opt/homebrew/bin/docker", "/usr/bin/docker"]
}

fn dockerBin(): string {
  return findBin(dockerCandidates())
}

fn dockerAvailable(bin: string): bool {
  if (bin == "") {
    return false
  }
  let r = output(bin, ["info"], dockerQuickTimeoutMs)
  return r.exitCode == 0
}

fn sweepOrphans(bin: string) {
  let r = output(bin, ["ps", "-aq", "--filter", "label=${runLabel}"], dockerQuickTimeoutMs)
  if (r.exitCode != 0) {
    return
  }
  for id of split(trimSpace(r.stdout), "\n") {
    if (id == "") {
      continue
    }
    output(bin, ["rm", "-f", id], dockerRunTimeoutMs)
  }
}

fn dockerRun(bin: string, args: []string): ()! {
  let r = output(bin, args, dockerRunTimeoutMs)
  if (r.exitCode != 0) {
    fail newError("docker ${args[0]}: ${trimSpace(r.stderr)}")
  }
}

fn hostPort(bin: string, name: string, containerPort: string): int! {
  let r = output(bin, ["port", name, containerPort], dockerQuickTimeoutMs)
  if (r.exitCode != 0) {
    fail newError("docker port ${name}: ${trimSpace(r.stderr)}")
  }
  let lines = split(trimSpace(r.stdout), "\n")
  if (len(lines) == 0 || lines[0] == "") {
    fail newError("docker port ${name}: no mapping printed")
  }
  let colon = lastIndexOf(lines[0], ":")
  if (colon < 0) {
    fail newError("docker port ${name}: unexpected output '${lines[0]}'")
  }
  return parseInt(lines[0][colon + 1:])?
}

// Ready once the S3 gateway answers ANY HTTP response (an unauthenticated
// GET against the bucket-less root is expected to fail with a 403/404 from
// a running server) rather than a connection refusal.
fn s3Ready(endpoint: string): bool {
  let i = 0
  while (i < readyAttempts) {
    httpGet(endpoint) catch _ {
      sleep(readyDelayMs * Millisecond)
      i = i + 1
      continue
    }
    return true
  }
  return false
}

fn cleanup(bin: string, name: string) {
  output(bin, ["rm", "-f", name], dockerRunTimeoutMs)
}

// Targets the pkg/s3 DIRECTORY (SPEC §17.1), same reasoning as
// redislive.bit's own `runLiveTests`. `/usr/bin/env VAR=... <bit> test`
// is how a variable reaches only THIS spawned child (`std/process`'s
// `output` execs directly with no shell, and inherits only the calling
// process's own environment).
fn runTestsMatching(
  bitPath: string,
  repo: string,
  envArgs: []string,
  runFilter: string,
  timeoutMs: int,
): int {
  let args = []string(0)
  let i = 0
  while (i < len(envArgs)) {
    args = append(args, envArgs[i])
    i = i + 1
  }
  args = append(args, bitPath)
  args = append(args, "test")
  args = append(args, "${repo}/pkg/s3")
  args = append(args, "--run")
  args = append(args, runFilter)
  let r = output("/usr/bin/env", args, timeoutMs)
  print(r.stdout)
  eprint(r.stderr)
  return r.exitCode
}

fn runCorrectnessTests(bitPath: string, repo: string, envArgs: []string): int {
  return runTestsMatching(bitPath, repo, envArgs, "live: ", testRunTimeoutMs)
}

// Content-integrity only (byte-for-byte, client.live.test.bit's own
// `patternChunk` check) — the peak-RSS proof is `runRssProbe`'s job, a
// separate standalone binary, not this `bit test` run (see `probeSource`'s
// own comment for why the two must not be the same process).
fn runStreamingCorrectnessTest(bitPath: string, repo: string, envArgs: []string): int {
  return runTestsMatching(bitPath, repo, envArgs, "live streaming: ", streamingRunTimeoutMs)
}

// The RSS proof runs as a STANDALONE `bit build` binary, not through `bit
// test`: measured first through `bit test pkg/s3 --run "live streaming: "`
// (which proves content-integrity, still run separately by
// `runCorrectnessTests` above under the "live: " tests' own umbrella —
// actually a sibling run, see `main()`), peak RSS for the SAME 220 MiB
// round trip read 442 MB under `bit test` but 11.8 MB built standalone and
// run directly — `bit test`'s own harness overhead (compiling a synthetic
// test binary, discovery/assertion bookkeeping) swamped the number the
// streaming code path itself is responsible for. Measuring the wrong
// process answered a different question than the one asked (this
// repository's own "negative result under the wrong instrument" trap) —
// building a real binary and measuring THAT is the correct instrument.
const probeSource: string = `import { Config, newClient } from "s3"
import { env } from "std/os"
import { BodySink, BodySource } from "std/http"

fn patternByte(index: int): byte {
  return byte((index * 31 + 7) % 251)
}

fn patternChunk(startIndex: int, n: int): string {
  let b = []byte(n)
  let i = 0
  while (i < n) {
    b[i] = patternByte(startIndex + i)
    i = i + 1
  }
  return string(b)
}

fn main(): ()! {
  let cfg = Config{
    endpoint = env("S3_TEST_ENDPOINT"),
    region = "us-east-1",
    bucket = env("S3_TEST_BUCKET"),
    accessKeyId = env("S3_TEST_ACCESS_KEY"),
    secretKey = env("S3_TEST_SECRET_KEY"),
  }
  let client = newClient(cfg)
  let totalLen = 220 * 1024 * 1024
  let sent = 0
  let source: BodySource = (n) => {
    if (sent >= totalLen) {
      return ""
    }
    let want = n
    if (sent + want > totalLen) {
      want = totalLen - sent
    }
    let chunk = patternChunk(sent, want)
    sent = sent + want
    return chunk
  }
  client.putStream("rssprobe.bin", totalLen, "application/octet-stream", source)?

  let received = 0
  let sink: BodySink = (chunk) => {
    received = received + len(chunk)
  }
  client.getStream("rssprobe.bin", sink)?
  if (received != totalLen) {
    panic("rssprobe: received ${received} of ${totalLen} bytes")
  }
  client.delete("rssprobe.bin")?
  print("rssprobe: ok, ${received} bytes round-tripped\n")
}
`

fn probeBitJson(s3Path: string): string {
  return "{\"name\": \"s3rssprobe\", \"dependencies\": {\"s3\": \"${s3Path}\"}}"
}

fn probeBitLock(s3Path: string): string {
  return "{\"s3\":{\"path\":\"${s3Path}\",\"requires\":{}}}"
}

// Builds a standalone binary running exactly `probeSource`'s put/getStream
// round trip against the live server, under `/usr/bin/time -l`, and checks
// peak RSS against `maxStreamingRssBytes` — see the const above for why
// this is a real binary rather than a `bit test` run.
fn runRssProbe(bitPath: string, repo: string, envArgs: []string): int! {
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  let dir = "${tmp}/bit-s3-rssprobe-${uuidFormat(uuidV4())}"
  mkdir(dir)?
  writeFile("${dir}/bit.json", probeBitJson("${repo}/pkg/s3"))?
  writeFile("${dir}/bit.lock", probeBitLock("${repo}/pkg/s3"))?
  writeFile("${dir}/main.bit", probeSource)?

  let stdlib = envOr("BIT_STDLIB", "${repo}/stdlib")
  let buildEnv = ["BIT_STDLIB=${stdlib}", bitPath, "build", dir, "-o", "${dir}/probe"]
  let buildRes = output("/usr/bin/env", buildEnv, dockerRunTimeoutMs)
  if (buildRes.exitCode != 0) {
    print(buildRes.stdout)
    eprint(buildRes.stderr)
    removeTree(dir)
    fail newError("s3live: building the RSS probe failed")
  }

  let runArgs = ["-l", "/usr/bin/env"]
  let i = 0
  while (i < len(envArgs)) {
    runArgs = append(runArgs, envArgs[i])
    i = i + 1
  }
  runArgs = append(runArgs, "${dir}/probe")
  let r = output("/usr/bin/time", runArgs, streamingRunTimeoutMs)
  print(r.stdout)
  eprint(r.stderr)
  let exitCode = r.exitCode
  let stderrText = r.stderr
  removeTree(dir)
  if (exitCode != 0) {
    return exitCode
  }
  let rssLine = findLineContaining(stderrText, "maximum resident set size")
  if (rssLine == "") {
    fail newError("s3live: '/usr/bin/time -l' printed no 'maximum resident set size' line")
  }
  let rssBytes = parseLeadingInt(trimSpace(rssLine))?
  eprint("s3live: peak RSS for the 220 MiB putStream/getStream round trip was ${rssBytes} bytes (budget ${maxStreamingRssBytes})\n")
  if (rssBytes > maxStreamingRssBytes) {
    fail newError("s3live: peak RSS ${rssBytes} exceeds the ${maxStreamingRssBytes}-byte budget — streaming held the object in memory")
  }
  return 0
}

fn removeTree(dir: string) {
  output("/bin/rm", ["-rf", dir], dockerRunTimeoutMs)
}

fn trimSuffix(s: string, suffix: string): string {
  if (hasSuffix(s, suffix)) {
    return s[0:len(s) - len(suffix)]
  }
  return s
}

fn findLineContaining(text: string, needle: string): string {
  for line of split(text, "\n") {
    if (contains(line, needle)) {
      return line
    }
  }
  return ""
}

// "  157286400  maximum resident set size" — the number is the first
// whitespace-delimited token.
fn parseLeadingInt(line: string): int! {
  let sp = indexOf(trimSpace(line), " ")
  if (sp < 0) {
    fail newError("s3live: could not parse a leading integer from '${line}'")
  }
  return parseInt(trimSpace(line)[0:sp])?
}

fn main() {
  let bin = dockerBin()
  if (!dockerAvailable(bin)) {
    print("skipped: docker unavailable\n")
    exit(0)
    return
  }
  sweepOrphans(bin)

  let repo = repoRoot()
  let bitPath = envOr("BIT_BIN", "${repo}/bit-out/bin/bit")
  let runId = uuidFormat(uuidV4())
  let name = "bit-s3-live-${runId}"
  let accessKey = "s3live-${runId}"
  let secretKey = uuidFormat(uuidV4())
  let bucket = "bit-s3-live"

  dockerRun(
    bin,
    [
      "run", "--rm", "-d", "--name", name, "--label", runLabel,
      "-p", "127.0.0.1:0:8333", "-e", "AWS_ACCESS_KEY_ID=${accessKey}",
      "-e", "AWS_SECRET_ACCESS_KEY=${secretKey}", "-e", "S3_BUCKET=${bucket}", image,
    ],
  ) catch e {
    eprint("s3live: ${e.message()}\n")
    cleanup(bin, name)
    exit(1)
    return
  }

  let port = hostPort(bin, name, "8333/tcp") catch e {
    eprint("s3live: ${e.message()}\n")
    cleanup(bin, name)
    exit(1)
    return
  }
  let endpoint = "http://127.0.0.1:${port}"

  if (!s3Ready(endpoint)) {
    eprint("s3live: S3 gateway never answered within ${readyAttempts * readyDelayMs}ms\n")
    cleanup(bin, name)
    exit(1)
    return
  }

  let envArgs = [
    "S3_TEST_ENDPOINT=${endpoint}", "S3_TEST_BUCKET=${bucket}",
    "S3_TEST_ACCESS_KEY=${accessKey}", "S3_TEST_SECRET_KEY=${secretKey}",
  ]

  let rc = runCorrectnessTests(bitPath, repo, envArgs)
  if (rc != 0) {
    cleanup(bin, name)
    exit(rc)
    return
  }

  let streamingCorrectnessRc = runStreamingCorrectnessTest(bitPath, repo, envArgs)
  if (streamingCorrectnessRc != 0) {
    cleanup(bin, name)
    exit(streamingCorrectnessRc)
    return
  }

  let streamingRc = runRssProbe(bitPath, repo, envArgs) catch e {
    eprint("s3live: ${e.message()}\n")
    cleanup(bin, name)
    exit(1)
    return
  }

  cleanup(bin, name)
  exit(streamingRc)
}
