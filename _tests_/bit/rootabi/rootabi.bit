// The register-class gate (#1655) — the Bit port of the first half of
// the deleted harness `rootabi`, re-pointed at an oracle that survives the
// deleted native runtime's source.
//
// THE DEFECT IT EXISTS TO CATCH. `runtime/root/floats.bit` provides
// `bit_rt_parse_float`. It once read
//
//     export @symbol("bit_rt_parse_float") function rtParseFloat(s: int): u64
//
// while every backend reads that call's result out of the FLOAT return register,
// because the compiler types the `parse_float` primitive `f64`. A `u64` return is
// written to the INTEGER one (x0/rax). Against a Bit-sourced `libbitrt.a` the
// caller therefore read a register the callee never wrote, and EVERY FLOAT
// LITERAL IN EVERY PROGRAM FOLDED TO 0.0 — `sqrt(2) = 0` — while integers stayed
// correct and every other gate stayed green.
//
// Nothing else in the tree can see it. An object file records symbol names and
// relocations, not C types, so `rootpins`-shaped gates are blind. The
// differential family compares dumps from ONE compiler against ONE runtime, so a
// runtime-side ABI defect cancels out. And the golden corpus used to link the
// deleted native runtime's archive, where no mismatch existed — which is why
// deleting that runtime's source made this property MORE load-bearing, not
// less: a mismatch now detonates directly in the shipped archive, with no
// green oracle left to mask it.
//
// WHY THE ORACLE CHANGED, AND TO WHAT. The deleted gate read
// `export fn bit_rt_*(...) callconv(.c) R` out of the deleted native runtime's
// `root` module and compared it with the pin. Both sides were declarations,
// and one was being deleted. The surviving statement of the same invariant has
// neither side sourced from that deleted runtime:
//
//   - THE COMPILER decides which register a result is READ from: it types every
//     runtime primitive (`compiler/checktype.bit`'s builtin signatures, and the
//     types lowering gives a container primitive), names the symbol
//     (`compiler/codegen.bit`'s `rtSymbol`), and forces container element
//     positions into the integer class with an explicit `bitcast`
//     (`compiler/ir.bit`'s `rtWordArgs`/`rtReturnsWord`, via `lowerprim.bit`).
//   - THE PIN decides which register it is WRITTEN to: its `@symbol(...)`
//     declaration in `runtime/**/*.bit`.
//
// HOW THE COMPILER SIDE IS READ — IT ANSWERS, IT IS NOT SCRAPED. `compiler/` is
// one module and exports nothing a harness can import, so the obvious port —
// restating `builtinResultType`'s table here — would make the gate a COPY of what
// it checks, and a copy agrees with itself forever. Instead the shipped `bit` is
// asked directly: the probe below is written to scratch and compiled with
// `bit --dump-ir`, and every
//
//     %N = rt_call <primitive>(%a, %b) <type>
//
// in the resulting SSA text is the compiler stating, in its own voice, the
// symbol it will call and the type it will read the result back as. That is the
// caller's half of the ABI with no restatement and no second source of truth.
//
// TWO THINGS MAKE THAT SAFE. On a module with parse errors `bit --dump-ir` still
// EXITS 0, silently dropping what it could not parse — sometimes a whole body —
// so a probe that stopped compiling would hand this gate a dump missing the very
// `rt_call`s it reads; the probe is therefore run through `bit check` FIRST, and
// the floors are a second, independent guard on that hole. Second, an instruction
// whose opcode this reader does not know is a HARD FAILURE, never a skip: its
// result type cannot be resolved, and guessing it integer is how a float slips
// through unnoticed.
//
// WHY CLASS, NOT TYPE EQUALITY. The two sides are deliberately not identical and
// never will be: a pinned Bit function may not name a GC-managed type (E0079),
// so the `string` the compiler hands `bit_rt_string_concat` is a raw `int` in
// the pin. That difference is sound — a pointer and an `int` are both integer
// class, one register, same slot. Only the float/integer split changes which
// physical register is used, so only that split is asserted. Arity is asserted
// too: a parameter count that disagrees shifts every later argument by a slot.
//
// THE FLOORS — A VACUOUS PASS IS THIS FAMILY'S FAILURE MODE. `rootpins` shipped
// a Darwin half that matched zero symbols for months. Four floors, each
// independently fatal: pins scanned; DISTINCT symbols the compiler was seen to
// call; `rt_call` sites compared; and pin DECLARATIONS examined. The last bites
// hardest — every pin that exists for a called symbol is checked, not one per
// symbol, because most ABI symbols are pinned twice, darwin and linux, and a gate
// that stopped at the first would pass a linux-only mismatch on a macOS host. A
// called symbol with no pin at all is a hard failure on its own.
//
// Usage, with cwd the repository root: `bit run _tests_/bit/rootabi`. `BIT`
// overrides the compiler (default `bit-out/bin/bit`), `REPO` the repository
// root, `BIT_TEST_TIMEOUT_S` the per-child deadline.
//
// #2867 phase 2 split this file into `_tests_/bit/rootabi/{rootabi,irsites}.bit`:
// the probe program, running it under `bit --dump-ir`, and the SSA reader
// that turns its dump into `[]Site` now live in the sibling `irsites.bit`,
// no `import`, one shared scope. This file dropped from 821 to 499 lines and
// kept the pin side, the comparison, the floors, and `main`.

import { readFile, walk, exists, mkdir } from "std/fs"
import { envOr, exit } from "std/os"
import { hasPrefix, hasSuffix, indexOf, split, trimSpace, parseInt } from "std/strings"

// --- bounds: every loop is statically bounded (Power of 10 rule 2) ----------
const maxBitFiles: int = 1024
const maxLinesPerFile: int = 200000
const maxDumpLines: int = 400000
const maxJoinLines: int = 8
const maxParams: int = 16
const symbolAttr: string = "@symbol(\""
// Both spellings, while the lexer still accepts `function` as an alias for
// `fn` (#2773 narrows this once `function` is gone). `runtime/**/*.bit` is all
// `fn` today; `function` stays recognised so this scanner does not go blind
// again the next time a spelling changes underneath it.
const funcKwNew: string = "fn "
const funcKwOld: string = "function "
// `osRunBounded`'s own ceiling (runtime/root/*/os.bit `osBoundedMaxMs`).
const maxTimeoutMs: int = 6000000
const defaultTimeoutS: int = 300

// The floors. Measured 2026-07-29 on a clean tree: 392 pin sites, 88 distinct
// called symbols, 273 call sites, 321 covered pins. Each sits BELOW today's
// population — a floor, not a target — so growth never trips it, but a scanner,
// probe or attribute that stops working does.
//
// #4037 RE-DERIVED THE TWO PER-CALL-SITE FLOORS, and the reason is the one this
// file already states 300 lines down: "`string_concat` alone has 131 probe
// sites, and 131 copies of one fact buries every other failure." Interpolation
// no longer folds its parts one binary `string_concat` at a time — it joins four
// per `string_concat5` — so the probe emits 114 fewer call sites for the same
// primitives. Measured on `6f6a730e` (before) and on this tree (after), with
// `./make test-rootabi` on a worktree of each:
//
//   before   774 pins scanned, 85 symbols called, 276 call sites, 371 pins covered
//   after    775 pins scanned, 86 symbols called, 162 call sites, 257 pins covered
//
// EVERY LOST SITE WAS A DUPLICATE OF ONE ALREADY-COVERED SYMBOL, which is why
// this is a re-derivation and not a weakened check: the floor that measures real
// coverage is `minRtSymbols`, and it went UP (85 -> 86, `string_concat5` being
// the new one). `minPinSites` also rose, 774 -> 775. Only the two floors counted
// per call site fell, and they fell by exactly the same 114 because each removed
// site named a symbol with one pin. The new pair sits ~10% under today's
// population, the same margin the 2026-07-29 pair had.
const minPinSites: int = 360
const minRtSymbols: int = 84
const minCallSites: int = 145
const minPinsCovered: int = 230

// The probe program, running it through `bit --dump-ir`, and reading the
// resulting SSA text into `[]Site` now live in the sibling `irsites.bit`
// (#2867 phase 2) — this file's `main` calls `dumpProbe`/`readSites` there.

// --- shared model ----------------------------------------------------------
// One declared or observed signature. `params`/`ret` hold TYPE TEXT; only
// `isFloat` is ever asked of them.
class Sig {
  symbol: string,
  params: []string,
  ret: string,
  where: string,
}

class Ctx {
  repo: string,
  bin: string,
  scratch: string,
  timeoutMs: int,
  failures: int,
}

fn say(c: Ctx, msg: string) {
  c.failures = c.failures + 1
  eprint("rootabi: FAIL ${msg}\n")
}

// Bit's floating-point types (SPEC §8.1). These and only these travel in a float
// register at the C ABI; everything else this tree uses — integers, pointers,
// `bool`, `string`, slices, maps, chans — travels in an integer register.
fn isFloat(t: string): bool {
  return t == "f64" || t == "f32"
}

fn className(t: string): string {
  if (isFloat(t)) {
    return "float"
  } else {
    return "integer"
  }
}

fn isMember(s: string, set: []string): bool {
  for e of set {
    if (s == e) {
      return true
    }
  }
  return false
}

// --- small text helpers ----------------------------------------------------
fn isSpaceByte(ch: u8): bool {
  return ch == ' ' || ch == '\t' || ch == '\r'
}

fn isIdentByte(ch: u8): bool {
  return (ch >= '0' && ch <= '9') ||
    (ch >= 'A' && ch <= 'Z') ||
    (ch >= 'a' && ch <= 'z') ||
    ch == '_' ||
    ch == '$'
}

fn identEnd(s: string, at: int): int {
  let i = at
  while (i < len(s) && isIdentByte(s[i])) {
    i = i + 1
  }
  return i
}

fn lastToken(s: string): string {
  let t = trimSpace(s)
  let i = len(t)
  while (i > 0 && !isSpaceByte(t[i - 1])) {
    i = i - 1
  }
  return t[i:]
}

fn firstToken(s: string): string {
  let t = trimSpace(s)
  let i = 0
  while (i < len(t) && !isSpaceByte(t[i])) {
    i = i + 1
  }
  return t[:i]
}

fn nestDelta(ch: u8): int {
  if (ch == '<' || ch == '(' || ch == '[') {
    return 1
  }
  if (ch == '>' || ch == ')' || ch == ']') {
    return 0 - 1
  }
  return 0
}

// Splits a comma-separated list, ignoring commas nested inside `<...>`, `(...)`
// or `[...]` — `map<string, f64>` is ONE element, and reading it as two shifts
// every following parameter's position.
fn splitTop(s: string): []string {
  let out = []string(0)
  let depth = 0
  let start = 0
  for (let i = 0; i < len(s); i = i + 1) {
    depth = depth + nestDelta(s[i])
    if (s[i] == ',' && depth == 0) {
      out = append(out, trimSpace(s[start:i]))
      start = i + 1
    }
  }
  let tail = trimSpace(s[start:])
  if (len(tail) > 0) {
    out = append(out, tail)
  }
  return out
}

// The index of the `)` closing the `(` at `open`, or -1.
fn matchParen(s: string, open: int): int {
  let depth = 0
  for (let i = open; i < len(s); i = i + 1) {
    if (s[i] == '(') {
      depth = depth + 1
    }
    if (s[i] == ')') {
      depth = depth - 1
      if (depth == 0) {
        return i
      }
    }
  }
  return 0 - 1
}

// `@symbol("bit_rt_x")`'s own parens are balanced and no string literal in a
// runtime declaration contains a paren, so counting the whole line is exact.
fn parenDepth(s: string): int {
  let depth = 0
  for (let i = 0; i < len(s); i = i + 1) {
    if (s[i] == '(') {
      depth = depth + 1
    }
    if (s[i] == ')') {
      depth = depth - 1
    }
  }
  return depth
}

// --- the pin side: `@symbol("bit_rt_...")` declarations under runtime/ ------

// The declaration text from `at`, joined across continuation lines until its
// parameter list closes. Three `bit_rt_port_*` pins wrap today; no ABI symbol
// does, but a scanner stopping at the newline reads a truncated parameter list
// as a complete one — a silent wrong answer, not a loud one.
fn joinDecl(lines: []string, at: int): string {
  let text = lines[at]
  let i = at
  let joined = 0
  while (joined < maxJoinLines && parenDepth(text) > 0 && i + 1 < len(lines)) {
    i = i + 1
    joined = joined + 1
    text = text + " " + trimSpace(lines[i])
  }
  return text
}

// The parameter types of `function name(a: T, b: U)`; ok=false on any odd shape.
fn parseParams(inner: string): ([]string, bool) {
  let params = []string(0)
  for p of splitTop(inner) {
    let colon = indexOf(p, ":")
    if (colon < 0) {
      return params, false
    }
    params = append(params, trimSpace(p[colon + 1:]))
  }
  return params, len(params) <= maxParams
}

// The index and length of whichever function-keyword spelling appears first in
// `text` — `-1, 0` when neither does. A caller must slice by the LENGTH
// RETURNED HERE, never by a fixed constant: `fn` is six characters shorter
// than `function`, and an offset derived from the wrong spelling's length
// reads into the middle of the declared name.
fn indexFuncKw(text: string): (int, int) {
  let fnAt = indexOf(text, funcKwNew)
  let functionAt = indexOf(text, funcKwOld)
  if (fnAt < 0) {
    return functionAt, len(funcKwOld)
  }
  if (functionAt < 0 || fnAt < functionAt) {
    return fnAt, len(funcKwNew)
  }
  return functionAt, len(funcKwOld)
}

// Parses `fn name(a: T, b: U): R {` (or `function name(...)`) out of `text`.
// ok=false when the shape is not understood — a hard failure at the call
// site, never a skip.
fn parseSig(text: string, symbol: string, where: string): (Sig, bool) {
  let none = Sig{ symbol: symbol, params: []string(0), ret: "", where: where }
  let (fi, kwLen) = indexFuncKw(text)
  if (fi < 0) {
    return none, false
  }
  let rest = text[fi + kwLen:]
  let open = indexOf(rest, "(")
  if (identEnd(rest, 0) == 0 || open < 0) {
    return none, false
  }
  let close = matchParen(rest, open)
  if (close < 0) {
    return none, false
  }
  let (params, okParams) = parseParams(rest[open + 1:close])
  if (!okParams) {
    return none, false
  }
  let after = trimSpace(rest[close + 1:])
  let ret = "void"
  if (hasPrefix(after, ":")) {
    let brace = indexOf(after, "{")
    if (brace < 0) {
      return none, false
    }
    ret = trimSpace(after[1:brace])
  }
  return Sig{ symbol: symbol, params: params, ret: ret, where: where }, true
}

// One pin declaration starting at `lines[i]`, appended to `out`. A top-level
// declaration starts in column 0, so an indented `@symbol` cannot exist and a
// comment naming the attribute is skipped by the same rule.
// RETURNS the accumulator rather than growing the caller's header through the
// parameter (#3648). `append` on a slice PARAMETER used to reach the caller by
// aliasing — spec/LINT.md E0214 names that a hazard, and this scanner depended
// on it. A statically-empty `[]Sig(0)` is the null header now, so the first
// `append` allocates a fresh one and the caller kept an empty slice: every
// `@symbol` pin went missing and this gate reported all four of its floors at
// ZERO. The sibling `rootpins` harness already threads its accumulator back
// (`out = pinsInSrc(src, out)`), so this is the tree's existing idiom.
//
// THE FLOORS ARE WHY THIS WAS A LOUD FAILURE INSTEAD OF A SILENT PASS. With no
// pins scanned, every comparison below has nothing to disagree about and the
// gate would have reported success while checking nothing. `floorAt` is the
// only reason it did not.
fn scanPinAt(c: Ctx, out: []Sig, lines: []string, i: int, path: string): []Sig {
  let line = lines[i]
  if (len(line) == 0 || isSpaceByte(line[0]) || hasPrefix(trimSpace(line), "//")) {
    return out
  }
  let si = indexOf(line, symbolAttr)
  if (si < 0) {
    return out
  }
  let after = line[si + len(symbolAttr):]
  let q = indexOf(after, "\"")
  if (q < 0) {
    say(c, "${path}:${i + 1}: unterminated @symbol(\"...\")")
    return out
  }
  let text = joinDecl(lines, i)
  let (fkAt, _) = indexFuncKw(text)
  if (fkAt < 0) {
    // The attribute sits on its own line; the declaration is below it.
    if (i + 1 >= len(lines)) {
      say(c, "${path}:${i + 1}: @symbol with no declaration under it")
      return out
    }
    text = text + " " + trimSpace(joinDecl(lines, i + 1))
  }
  let (sig, ok) = parseSig(text, after[:q], "${path}:${i + 1}")
  if (!ok) {
    say(c, "${path}:${i + 1}: cannot read the signature of `${after[:q]}`")
    return out
  }
  return append(out, sig)
}

fn scanPins(c: Ctx, out: []Sig, src: string, path: string): []Sig {
  let lines = split(src, "\n")
  if (len(lines) > maxLinesPerFile) {
    say(c, "${path} has ${len(lines)} lines, above the ${maxLinesPerFile} bound")
    return out
  }
  for (let i = 0; i < len(lines); i = i + 1) {
    out = scanPinAt(c, out, lines, i, path)
  }
  return out
}

// Every `@symbol("...")` pin under `runtime/`, one entry per DECLARATION SITE:
// a symbol pinned once per platform yields two, and both are checked.
fn collectPins(c: Ctx): []Sig {
  let out = []Sig(0)
  let root = c.repo + "/runtime"
  let paths = walk(root) catch _ {
    say(c, "cannot walk ${root}")
    return out
  }
  if (len(paths) > maxBitFiles) {
    say(c, "runtime/ holds ${len(paths)} entries, above the ${maxBitFiles} bound")
    return out
  }
  for p of paths {
    if (!hasSuffix(p, ".bit")) {
      continue
    }
    let src = readFile(p) catch _ {
      say(c, "cannot read ${p}")
      continue
    }
    out = scanPins(c, out, src, p)
  }
  return out
}

// The compiler side (the probe, `bit --dump-ir`, and the SSA reader that
// turns its dump into `[]Site`) now lives in the sibling `irsites.bit`
// (#2867 phase 2).

// --- the comparison --------------------------------------------------------
// One call site against one pin. Arity is reported alone: once the counts
// differ there is no meaningful positional comparison left to make.
fn compareOne(c: Ctx, s: Site, pin: Sig) {
  if (len(s.args) != len(pin.params)) {
    say(
      c,
        "${s.symbol}: ARITY differs — the compiler emits ${len(s.args)} argument(s) " +
        "(IR line ${s.line}), the pin declares ${len(pin.params)} (${pin.where}). " +
        "Every argument after the first difference lands in the wrong register.",
    )
    return
  }
  for (let i = 0; i < len(s.args); i = i + 1) {
    if (isFloat(s.args[i]) == isFloat(pin.params[i])) {
      continue
    }
    say(
      c,
        "${s.symbol}: parameter ${i} CROSSES THE REGISTER CLASS — the compiler passes " +
        "`${s.args[i]}` (${className(s.args[i])} register, IR line ${s.line}), the pin " +
        "declares `${pin.params[i]}` (${className(pin.params[i])} register, ${pin.where}). " +
        "The value is written to one register and read from the other.",
    )
  }
  if (isFloat(s.ret) != isFloat(pin.ret)) {
    say(
      c,
        "${s.symbol}: RESULT CROSSES THE REGISTER CLASS — the compiler reads " +
        "`${s.ret}` (${className(s.ret)} register, IR line ${s.line}), the pin returns " +
        "`${pin.ret}` (${className(pin.ret)} register, ${pin.where}). Against a Bit-built " +
        "libbitrt.a the caller reads a register the callee never wrote and the call " +
        "silently yields 0 — this is #1655, `bit_rt_parse_float`, exactly.",
    )
  }
}

class Tally {
  callSites: int,
  pinsCovered: int,
  symbols: int,
}
// Once per SYMBOL, not per call site: `string_concat` alone has 131 probe sites,
// and 131 copies of one fact buries every other failure.
fn reportMissing(c: Ctx, missing: map<string, bool>, s: Site) {
  if (missing[s.symbol]) {
    return
  }
  missing[s.symbol] = true
  say(
    c,
      "${s.symbol}: the compiler emits this call (first at IR line ${s.line}, " +
      "primitive `${s.primitive}`) but NO `@symbol(\"${s.symbol}\")` pin provides it " +
      "under runtime/. The link fails, or worse, binds to something else.",
  )
}

// Every call site against EVERY pin of its symbol. Not one pin per symbol: most
// ABI symbols are pinned twice, once per platform, and a gate that stopped at
// the first would pass a linux-only mismatch on a macOS host.
fn compareAll(c: Ctx, sites: []Site, pins: []Sig): Tally {
  let t = Tally{ callSites: 0, pinsCovered: 0, symbols: 0 }
  let seen = map<string, bool>{}
  let missing = map<string, bool>{}
  for s of sites {
    let matched = 0
    for pin of pins {
      if (pin.symbol != s.symbol) {
        continue
      }
      matched = matched + 1
      compareOne(c, s, pin)
    }
    if (matched == 0) {
      reportMissing(c, missing, s)
      continue
    }
    t.callSites = t.callSites + 1
    t.pinsCovered = t.pinsCovered + matched
    if (!seen[s.symbol]) {
      seen[s.symbol] = true
      t.symbols = t.symbols + 1
    }
  }
  return t
}

// --- floors ----------------------------------------------------------------
fn floorAt(c: Ctx, got: int, want: int, what: string, why: string) {
  if (got >= want) {
    return
  }
  say(c, "VACUOUS — ${what}: ${got}, floor ${want}. ${why}")
}

fn checkFloors(c: Ctx, pinCount: int, t: Tally) {
  floorAt(
    c, pinCount, minPinSites, "pins scanned out of runtime/**/*.bit",
    "A moved directory, a changed declaration shape, or a renamed @symbol.",
  )
  floorAt(
    c, t.symbols, minRtSymbols, "distinct runtime symbols seen to be called",
      "The probe stopped exercising primitives, or lowering stopped emitting " +
      "rt_calls. A dump with no rt_call in it passes every comparison above.",
  )
  floorAt(
    c, t.callSites, minCallSites, "rt_call sites compared",
    "Same cause as above, measured per call site rather than per symbol.",
  )
  floorAt(
    c, t.pinsCovered, minPinsCovered, "pin declarations examined",
      "Fewer pins examined than exist for the symbols in play — a platform's pins " +
      "stopped being found, so a mismatch there is invisible here.",
  )
}

// --- entry point -----------------------------------------------------------
// `BIT_TEST_TIMEOUT_S`, the contract every harness here shares: default 300s,
// `0` disables the bound (here: the runtime's own one-hour ceiling).
fn timeoutMs(): int {
  let raw = trimSpace(envOr("BIT_TEST_TIMEOUT_S", ""))
  if (raw == "") {
    return defaultTimeoutS * 1000
  }
  let s = parseInt(raw) catch _ {
    eprint("rootabi: BIT_TEST_TIMEOUT_S='${raw}' is not a number; using ${defaultTimeoutS}s\n")
    return defaultTimeoutS * 1000
  }
  if (s <= 0 || s * 1000 > maxTimeoutMs) {
    return maxTimeoutMs
  }
  return s * 1000
}

fn main() {
  let bin = envOr("BIT", "bit-out/bin/bit")
  if (!exists(bin)) {
    eprint("rootabi: BIT='${bin}' does not exist — refusing to guess\n")
    exit(2)
  }
  let scratch = envOr("TMPDIR", "/tmp") + "/bit-rootabi-${timeUnixNs()}"
  mkdir(scratch) catch _ {
    eprint("rootabi: cannot create the scratch directory ${scratch}\n")
    exit(2)
  }
  let c = Ctx{
    repo: envOr("REPO", "."), bin: bin, scratch: scratch,
    timeoutMs: timeoutMs(), failures: 0,
  }

  let pins = collectPins(c)
  let (dump, ok) = dumpProbe(c)
  if (!ok) {
    eprint("rootabi: the compiler side produced nothing; not reporting a clean sheet.\n")
    exit(1)
  }
  let t = compareAll(c, readSites(c, dump), pins)
  checkFloors(c, len(pins), t)
  print(
      "rootabi: ${len(pins)} pins scanned, ${t.symbols} runtime symbols called, " +
      "${t.callSites} call sites compared against ${t.pinsCovered} pin declarations\n",
  )
  if (c.failures != 0) {
    eprint("rootabi: ${c.failures} failure(s).\n")
    exit(1)
  }
  print("rootabi: OK\n")
}
