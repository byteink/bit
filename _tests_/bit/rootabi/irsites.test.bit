fn rootabiReaderCtx(): Ctx {
  return Ctx{ repo = "", bin = "", scratch = "", timeoutMs = 1, failures = 0 }
}

fn rootabiSliceBaseDump(): string {
  return "func reader_probe\nbb0(%0: []f64):\n" +
    "  %1 = slice_base %0\n" +
    "  %2 = rt_call reader_probe(%0, %1) f64\n"
}

test "rootabi slice_base has a fixed i64 result" {
  assert(resultType("slice_base", "%0") == "i64", "slice_base result is i64")
  assert(resultType("slice_base", "%0 f64") == "i64", "slice_base has no trailing type")
  assert(resultType("slice_len", "%0") == "i64", "slice_len keeps its existing type")
}

test "rootabi slice_base preserves the managed input type" {
  let c = rootabiReaderCtx()
  let v = Vregs{ types = ["[]f64"] }
  let sites = readInstr(c, v, []Site(0), "%1 = slice_base %0", 1)
  assert(c.failures == 0 && len(sites) == 0, "slice_base is a known non-call instruction")
  assert(vregGet(v, 0) == "[]f64", "the slice header keeps its managed type")
  assert(vregGet(v, 1) == "i64", "the derived address keeps its integer type")
}

test "rootabi slice_base call arguments retain distinct types" {
  let c = rootabiReaderCtx()
  let sites = readSites(c, rootabiSliceBaseDump())
  assert(c.failures == 0 && len(sites) == 1, "the reader keeps the following runtime call")
  let s = sites[0]
  assert(
    len(s.args) == 2 && s.args[0] == "[]f64" && s.args[1] == "i64",
    "header and base argument types",
  )
  assert(s.ret == "f64", "runtime result keeps its float type")
  let pin = Sig{ symbol = s.symbol, params = ["int", "int"], ret = "f64", where = "reader fixture" }
  compareOne(c, s, pin)
  assert(c.failures == 0, "the correct integer-class pin matches")
  pin.params[1] = "f64"
  compareOne(c, s, pin)
  assert(c.failures == 1, "a wrong base argument register class is rejected")
}

test "rootabi unknown opcodes remain fatal" {
  let c = rootabiReaderCtx()
  let v = Vregs{ types = ["[]f64"] }
  let sites = readInstr(c, v, []Site(0), "%1 = slice_base_unknown %0", 1)
  assert(c.failures == 1 && len(sites) == 0, "an unknown opcode is a reader failure")
  assert(vregGet(v, 1) == "", "an unknown result is never guessed")
  sites = readCallSite(c, v, sites, "reader_probe(%1) i64", 2)
  assert(c.failures == 2 && len(sites) == 0, "an untyped value cannot reach an ABI comparison")
}
