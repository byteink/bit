// compiler/doc.bit's collectDoc must not list an imported free function as
// this module's OWN exported symbol when the imported bare name collides
// with a LOCAL export of a different kind (#3734).
//
// Found via stdlib/regex: `unicodetables.bit` imports `split` from
// `std/strings` for internal use, while `regex.bit` separately exports
// `Regex.split` (a METHOD, unrelated to std/strings' free function). `bit
// doc stdlib/regex` printed a phantom `function split (string, string) =>
// []string` line — std/strings' own signature and doc comment, attributed to
// stdlib/regex, which declares no free function named `split` at all.
//
// ROOT CAUSE (compiler/doc.bit, collectDoc's `for (n, _) of c.exports`
// loop). `collectExports` (compiler/check.bit) records a bare EXPORTED
// METHOD name into `c.exports` too, by design (its own comment: "a bare
// exported method name... matches no category and is skipped, exactly as
// the seed's else {}") — safe on its own, because `funcSigLookup(c, n)`
// normally misses a method name (methods live in a separate table, keyed
// "TypeId.name"). But `importName` (compiler/checklookup.bit) copies an
// IMPORTED function's signature into the IMPORTER's own `funcSigs` under its
// bare name too, for the importer's own call sites to type against. When the
// imported name and the exported method's bare name collide, `funcSigLookup`
// no longer misses, and collectDoc treated the import as if this module had
// declared it as a free function.
//
// This fixture reproduces the minimal shape without any real stdlib module:
// sibling module `b` declares a free function `foo`; module `a` exports a
// class `Foo` with a method `foo`, and separately imports `b`'s `foo` for
// internal use only — never re-exporting it (Bit has no re-export syntax).
// `bit doc a` must list `method Foo.foo` and no `function foo` line.
//
// Run it from the repository root:
//     ./bit-out/bin/bit run tests/bit/docimportcollision.bit
// `BIT_SELF_EXE` overrides which `bit` is exercised; unset, the compiler
// under test is `<cwd>/bit-out/bin/bit`, resolved from a child's own `pwd`
// (mirrors tests/bit/rootnamecollision.bit, which this file's harness
// shape is copied from).
import { env, envOr, exit } from "std/os"
import { exists, mkdir, readFile, writeFile } from "std/fs"
import { contains, parseInt } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// One `bit doc` invocation, as seen from outside it.
class Run { code: int, out: string, err: string }

// Assertion accounting. A class because Bit has no mutable module-level
// state, and the count is the anti-vacuity marker: an empty run must not
// read as pass.
class Tally { checks: int, failures: int }

// A build of two two-line modules and one `bit doc` call is well under a
// second; this only ever fires on a hang, and a hang is a failure.
fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "300")) catch _ {
    300
  }
  if (s <= 0) {
    return 300000
  }
  return s * 1000
}

// Runs `script` through /bin/sh and returns its exit code. Negative returns
// are `osRunBounded`'s mechanism channel, never a program exit status, so
// each one is a named panic rather than a value any assertion could consume.
fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    fail newError("docimportcollision: cannot make script executable: ${scriptPath}")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == -2) {
    panic("docimportcollision: TIMED OUT after ${ms}ms running ${scriptPath}")
  }
  if (code == -1) {
    panic("docimportcollision: could not spawn ${scriptPath}")
  }
  if (code <= 0 - 100) {
    panic("docimportcollision: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}

// This repository's own root, discovered the same way
// tests/bit/rootnamecollision.bit does: Bit has no getcwd primitive, so a
// child's own `pwd` is the only way to recover the directory this program
// was launched from.
fn resolveCwd(scratch: string, ms: int): string! {
  let cwdFile = "${scratch}/cwd.txt"
  let code = shell("${scratch}/pwd.sh", "#!/bin/sh\npwd > '${cwdFile}'\n", ms)?
  if (code != 0) {
    fail newError("docimportcollision: could not read the working directory (exit ${code})")
  }
  return trimWs(readFile(cwdFile)?)
}

// The `bit` under test. `BIT_SELF_EXE` wins; otherwise `${cwd}/bit-out/bin/bit`
// — never returns "": a compiler this cannot find is a hard stop, not a
// skipped test.
fn bitBinary(cwd: string): string! {
  let explicit = env("BIT_SELF_EXE")
  if (len(explicit) > 0) {
    if (!exists(explicit)) {
      fail newError("docimportcollision: BIT_SELF_EXE=${explicit} does not exist")
    }
    return explicit
  }
  let candidate = "${cwd}/bit-out/bin/bit"
  if (!exists(candidate)) {
    fail newError("docimportcollision: no compiler at ${candidate}; run this from the repository root or set BIT_SELF_EXE")
  }
  return candidate
}

// Runs `bit doc a` with `root` as the working directory, so module `a`'s
// sibling import `../b` resolves. The script always exits 0 and writes the
// real status to `code.txt`, so a missing `code.txt` is unmistakably "the
// run never happened" rather than a status some assertion could mistake for
// success — mirrors tests/bit/rootnamecollision.bit's `runBit`.
fn runDoc(bit: string, root: string, capDir: string, ms: int): Run! {
  let outPath = "${capDir}/out.txt"
  let errPath = "${capDir}/err.txt"
  let codePath = "${capDir}/code.txt"
  let script = "#!/bin/sh\n" +
    "cd '${root}' || exit 0\n" +
    "'${bit}' doc 'a' > '${outPath}' 2> '${errPath}'\n" +
    "echo $? > '${codePath}'\n" +
    "exit 0\n"
  let sh = shell("${capDir}/run.sh", script, ms)?
  if (sh != 0) {
    fail newError("docimportcollision: wrapper script exited ${sh}, which it never should")
  }
  if (!exists(codePath)) {
    fail newError("docimportcollision: no exit code was recorded for `bit doc a` — the run never happened")
  }
  let code = parseInt(trimWs(readFile(codePath)?))?
  return Run{ code: code, out: readFile(outPath)?, err: readFile(errPath)? }
}

// Records one assertion. Failures are named and the run continues, so a
// single invocation reports every broken expectation instead of only the
// first.
fn check(t: Tally, cond: bool, label: string) {
  t.checks = t.checks + 1
  if (!cond) {
    t.failures = t.failures + 1
    eprint("FAIL: ${label}\n")
  }
}

// `b` declares the free function; `a` exports a same-named METHOD and
// imports `b`'s free function for internal use only.
fn writeFixtures(root: string): ()! {
  mkdir("${root}/a")?
  mkdir("${root}/b")?
  writeFile("${root}/b/b.bit", "export fn foo(x: int): int {\n  return x\n}\n")?
  writeFile(
    "${root}/a/a.bit",
      "import { foo } from \"../b\"\n\n" +
      "export class Foo {\n  export foo(): int {\n    return foo(1)\n  }\n}\n",
  )?
}

fn runAll(t: Tally, scratch: string, ms: int) {
  let root = "${scratch}/tree"
  let capDir = "${scratch}/cap"
  mkdir(root) catch e {
    panic("docimportcollision: cannot create ${root}: ${e.message()}")
  }
  mkdir(capDir) catch e {
    panic("docimportcollision: cannot create ${capDir}: ${e.message()}")
  }
  writeFixtures(root) catch e {
    panic("docimportcollision: ${e.message()}")
  }
  let cwd = resolveCwd(scratch, ms) catch e {
    panic("docimportcollision: ${e.message()}")
  }
  let bit = bitBinary(cwd) catch e {
    panic("docimportcollision: ${e.message()}")
  }
  let r = runDoc(bit, root, capDir, ms) catch e {
    panic("docimportcollision: ${e.message()}")
  }
  check(t, r.code == 0, "bit doc a: exit ${r.code}, want 0: ${r.err}")
  check(t, contains(r.out, "method Foo.foo"), "expected `method Foo.foo` missing from: ${r.out}")
  check(
    t, !contains(r.out, "function foo"),
    "phantom `function foo` (imported-function/exported-method name collision, #3734) present in: ${r.out}",
  )
}

fn main() {
  let ms = timeoutMs()
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  let scratch = "${tmp}/bit-docimportcollision-${uuidFormat(uuidV4())}"
  let t = Tally{ checks: 0, failures: 0 }

  mkdir(scratch) catch e {
    panic("docimportcollision: cannot create ${scratch}: ${e.message()}")
  }
  runAll(t, scratch, ms)

  // The run marker: 3 is what the one case above asserts today; the floor
  // only has to be tight enough that the whole case going missing trips it.
  if (t.checks < 3) {
    eprint("FAIL: only ${t.checks} checks ran, want at least 3\n")
    t.failures = t.failures + 1
  }
  if (t.failures > 0) {
    // `exit()` does not run pending defers (#3694, same shape as #3677) —
    // call teardown explicitly on both the PASS and FAIL paths.
    teardown(scratch, ms)
    println("docimportcollision: FAIL — ${t.failures} of ${t.checks} checks failed")
    exit(1)
  }
  teardown(scratch, ms)
  println("docimportcollision: PASS — ${t.checks} checks")
}

// std/fs has no recursive remove, so the scratch tree goes the way it came.
fn teardown(scratch: string, ms: int) {
  shell("${scratch}/rm.sh", "#!/bin/sh\nrm -rf '${scratch}'\n", ms) catch _ {
    return
  }
}

fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}
