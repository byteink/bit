// `./make test-editor-engines-floor` (smash #5582) — checks that
// editors/vscode's declared `engines.vscode` floor is >= every runtime
// dependency's own `engines.vscode` requirement. #5574 raised the floor by
// hand, derived from installed runtime deps, after it drifted silently
// across the vscode-languageclient 9->10 bump: the dependency started
// requiring ^1.91.0 while the extension still declared ^1.75.0, so a user
// on 1.75-1.90 could install the extension and it threw on activation.
// Nothing before this gate caught that a runtime dependency's own floor had
// moved past the extension's declared one.
//
// The actual walk (editors/vscode/package.json's prod `dependencies`,
// through `node_modules`, collecting every `engines.vscode` found) is
// editors/vscode/scripts/check-engines-floor.js, a plain Node script — `bit
// run` has no way to launch it directly (every `Gate{}` execs the `bit`
// binary itself, tools/build/gatesexec.bit's `gateEnvExecScript`), so this
// harness launches `node` on it through `/bin/sh`, the same
// `osRun("/bin/sh", [scriptPath])` shape `_tests_/imports/pmadd_e2e/main.bit`
// uses to run a throwaway shell script and forwards its exit code.
//
// A SEPARATE gate from `test-editor-sample`, not a second step folded into
// it: that gate's own Step desc (tools/build/defs.bit) says "run
// editors/vscode/sample.bit end to end (bit run) only", and every `Gate{}`
// here execs exactly one thing — folding an unrelated package.json check in
// would make that gate's name stop matching its scope, the exact failure
// shape bitlang-ws/CLAUDE.md's threshold-gates history warns about
// (test-fmt-strict declaring its scope in `env` instead of `argv` and
// landing in no bucket at all).
//
// editors/vscode/node_modules is gitignored and no build step here runs
// `npm install` — a checkout that never has is a VALID state, not a defect,
// so the underlying script treats an absent node_modules as a loud SKIP
// (exit 0, one printed line) rather than a crash or a failure. This harness
// only forwards whatever exit code the script produces.

import { env, envOr, exit } from "std/os"
import { writeFile, remove } from "std/fs"
import { uuidV4, format as uuidFormat } from "std/uuid"

fn vscodeDir(): string {
  let d = env("BIT_EDITOR_VSCODE_DIR")
  if (len(d) == 0) {
    panic("editorenginesfloor: BIT_EDITOR_VSCODE_DIR is not set — run this through `./make test-editor-engines-floor`")
  }
  return d
}

fn removeQuiet(path: string) {
  remove(path) catch _ {
    return
  }
}

fn main() {
  let dir = vscodeDir()
  let scriptPath = envOr("TMPDIR", "/tmp") +
    "/bit-editorenginesfloor-" +
    uuidFormat(uuidV4()) +
    ".sh"
  let script = "#!/bin/sh\nset -e\nexec node ${dir}/scripts/check-engines-floor.js ${dir}\n"
  writeFile(scriptPath, script) catch e {
    eprint("editorenginesfloor: could not write scratch script: ${e.message()}\n")
    exit(1)
    return
  }
  defer removeQuiet(scriptPath)
  let code = osRun("/bin/sh", [scriptPath])
  if (code != 0) {
    exit(1)
  }
}
