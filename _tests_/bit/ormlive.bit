// _tests_/bit/ormlive.bit — `./make test-package-orm-live` (#6281). Provisions
// its OWN throwaway PostgreSQL and MySQL containers (the same pattern as
// `redislive.bit`, #6021): `docker run --rm -d` for each, readiness polled
// (`pg_isready` / `mysqladmin ping`), the two URLs exported as
// ORM_TEST_LIVE_PG_URI / ORM_TEST_LIVE_MYSQL_URI for a `bit test pkg/orm`
// child process, then both containers always removed.
//
// pkg/orm's live proofs (repo.test.bit, bulk.test.bit, rawsql.test.bit,
// schema.test.bit, sync.test.bit, write.test.bit, check.test.bit —
// `grep -l 'ORM_TEST_LIVE' pkg/orm/*.test.bit`) are
// skipped, one `print("  skipped: ...")` line each, whenever their env var is
// unset — which is every gate today (the ticket this harness closes). A
// skipped live test inside THIS gate is a failure, not a pass: `runLiveTests`
// below scans the child's stdout for "  skipped: " and fails the gate if it
// finds one, on top of the child's own exit code.
//
// IMAGES, pinned BY DIGEST so a retag upstream cannot silently change what
// this gate runs against:
//
//   postgres:18.6  postgres@sha256:5a5a84b19854a9ffaa54082c166ff4ec27473a361e496e5ea167f298f2da9722
//     (same pin as _tests_/bit/jobslive.bit/webguidesapp.bit; re-verify
//     before bumping: curl -s
//     https://hub.docker.com/v2/repositories/library/postgres/tags/18.6 |
//     jq .digest)
//   mysql:8.4      the image pkg/mysql/docs/servers.md already pins for its
//     own live acceptance ("Which stock images verify"): re-verify before
//     bumping: curl -s
//     https://hub.docker.com/v2/repositories/library/mysql/tags/8.4 | jq .digest
//
// THE IMAGES THEMSELVES ARE KEPT, never deleted by this gate — same reasoning
// as redislive.bit's header: a pinned image this gate depends on every run is
// not a one-off throwaway install. Only the two CONTAINERS are throwaway.
//
// WITHOUT DOCKER: no `docker` binary, or `docker info` failing three times —
// FAILS, naming the probe error and its duration (_tests_/bit/dockerlive/
// dockerlive.bit, #6353); only `BIT_LIVE_OPTIONAL=1` skips and exits 0.
//
// CLEANUP: both containers are named with a run-local UUID and labelled
// `bit.orm.live=1`; `cleanup()` removes them by name on every path this
// process controls. `sweepOrphans()` runs FIRST, force-removing any
// `bit.orm.live=1` container an interrupted previous run left behind.
//
// ENV this harness reads (`./make test-package-orm-live` sets both,
// tools/build/gatestable2.bit):
//   BIT_REPO   repo root, so pkg/orm resolves regardless of cwd (required)
//   BIT_BIN    compiler under test    (default bit-out/bin/bit)
//
// `bit test` inherits no argv and pkg/orm's live tests read their targets
// off ORM_TEST_LIVE_PG_URI / ORM_TEST_LIVE_MYSQL_URI, not a CLI flag —
// `runLiveTests()` below sets both (plus BIT_REPO/BIT_BIN, so
// `findRepoRoot()`/`envOr("BIT_BIN", ...)` in pkg/orm's own test helpers
// resolve deterministically) by exec'ing `/usr/bin/env VAR=... <bit> test
// pkg/orm` rather than the plain `<bit> test pkg/orm` every other gate
// uses — the same trick redislive.bit's own header documents and proved
// on #6021.

import { output, RunResult } from "std/process"
import { env, envOr, exit } from "std/os"
import { exists, mkdir, readDir, remove, writeFile } from "std/fs"
import {
  contains, hasSuffix, indexOf, join, parseInt, split, trimSpace,
} from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"
import { sleep, Millisecond } from "std/time"
import {
  dockerQuickTimeoutMs, dockerRunTimeoutMs, dockerRun, failureText, hostPort, relay, requireDocker,
  releaseDocker,
} from "./dockerlive"

const pgImage: string = "postgres@sha256:5a5a84b19854a9ffaa54082c166ff4ec27473a361e496e5ea167f298f2da9722"
const myImage: string = "mysql:8.4"
const runLabel: string = "bit.orm.live=1"
// Pairs with `runLabel` on every container this run starts (see
// `startPostgres`/`startMysql` below): the owning process's own pid, learned
// via `selfPid`'s `$PPID` trick. `sweepOrphans` removes a labelled container
// only when that pid is no longer alive, so a concurrent peer's still-running
// containers are left alone (#6327).
const ownerLabelKey: string = "bit.live.owner"
const readyAttempts: int = 60
const readyDelayMs: int = 1000
const testRunTimeoutMs: int = 300000
const myRootPassword: string = "bit-orm-live-pw"
const myDatabase: string = "orm_live"

// BIT_REPO IS REQUIRED, same reason as _tests_/bit/redislive.bit and
// _tests_/bit/jobslive.bit: falling back to "." would silently test whatever
// directory `bit` happened to be invoked from instead of refusing.
fn repoRoot(): string {
  let r = env("BIT_REPO")
  if (len(r) == 0) {
    panic("ormlive: BIT_REPO is not set — run this through `./make test-package-orm-live`")
  }
  return r
}

// This process's own pid, read off `/bin/sh -c 'echo $PPID'`: `std/process`
// execs every child directly with no shell (its own doc comment), so a
// freshly spawned `/bin/sh`'s parent is always this process itself.
fn selfPid(): int! {
  let r = output("/bin/sh", ["-c", "echo $PPID"], dockerQuickTimeoutMs)
  if (r.exitCode != 0) {
    fail newError("selfPid: /bin/sh exited ${r.exitCode}: ${trimSpace(r.stderr)}")
  }
  return parseInt(trimSpace(r.stdout))?
}

// Whether `pid` still names a live process — `kill -0` sends no signal, only
// checks existence (the same idiom tools/build/gatesexec.bit's watchdogs use).
fn pidAlive(pid: int): bool {
  let r = output("/bin/sh", ["-c", "kill -0 ${pid} 2>/dev/null"], dockerQuickTimeoutMs)
  return r.exitCode == 0
}

// The pid `id` recorded in its own `${ownerLabelKey}` label, or 0 if the
// label is missing or unparseable (a container from before this label
// existed, or a `docker inspect` hiccup) — `sweepOrphans` treats 0 as "no
// owner to protect", so such a container is always removed.
fn containerOwnerPid(bin: string, id: string): int {
  let r = output(
    bin,
    ["inspect", "-f", "{{index .Config.Labels \"${ownerLabelKey}\"}}", id],
    dockerQuickTimeoutMs,
  )
  if (r.exitCode != 0) {
    return 0
  }
  let pid = parseInt(trimSpace(r.stdout)) catch _ {
    return 0
  }
  return pid
}

// Force-removes every container this harness has ever labelled whose owner
// process is no longer alive, before this run starts its own — see the
// header's CLEANUP section for why this exists. A concurrent peer's own
// still-running containers carry a live owner pid and are left alone (#6327).
fn sweepOrphans(bin: string) {
  let r = output(bin, ["ps", "-aq", "--filter", "label=${runLabel}"], dockerQuickTimeoutMs)
  if (r.exitCode != 0) {
    return
  }
  for id of split(trimSpace(r.stdout), "\n") {
    if (id == "") {
      continue
    }
    let ownerPid = containerOwnerPid(bin, id)
    if (ownerPid > 0 && pidAlive(ownerPid)) {
      continue
    }
    output(bin, ["rm", "-f", id], dockerRunTimeoutMs)
  }
}

fn startPostgres(bin: string, name: string, ownerLabel: string): int! {
  dockerRun(
    bin,
    [
      "run", "--rm", "-d", "--name", name, "--label", runLabel, "--label", ownerLabel,
      "-p", "127.0.0.1:0:5432", "-e", "POSTGRES_HOST_AUTH_METHOD=trust", pgImage,
    ],
  )?
  let port = hostPort(bin, name, "5432/tcp")?
  let i = 0
  let ready = false
  while (i < readyAttempts) {
    let r = output(bin, ["exec", name, "pg_isready", "-U", "postgres"], dockerQuickTimeoutMs)
    if (r.exitCode == 0 && contains(r.stdout, "accepting connections")) {
      ready = true
      break
    }
    sleep(readyDelayMs * Millisecond)
    i = i + 1
  }
  if (!ready) {
    fail newError("${name}: pg_isready never reported ready within ${readyAttempts * readyDelayMs}ms")
  }
  return port
}

fn startMysql(bin: string, name: string, ownerLabel: string): int! {
  dockerRun(
    bin,
    [
      "run", "--rm", "-d", "--name", name, "--label", runLabel, "--label", ownerLabel,
      "-p", "127.0.0.1:0:3306", "-e", "MYSQL_ROOT_PASSWORD=${myRootPassword}",
      "-e", "MYSQL_DATABASE=${myDatabase}", myImage,
    ],
  )?
  let port = hostPort(bin, name, "3306/tcp")?
  let i = 0
  let ready = false
  while (i < readyAttempts) {
    let r = output(
      bin,
      ["exec", name, "mysqladmin", "ping", "-uroot", "-p${myRootPassword}", "--silent"],
      dockerQuickTimeoutMs,
    )
    if (r.exitCode == 0) {
      ready = true
      break
    }
    sleep(readyDelayMs * Millisecond)
    i = i + 1
  }
  if (!ready) {
    fail newError("${name}: mysqladmin ping never succeeded within ${readyAttempts * readyDelayMs}ms")
  }
  return port
}

// Always removes both containers (by name, `--rm` already means a stopped
// one vanishes, `rm -f` handles a still-running one too) — called from every
// path through `main()` below, success or failure alike, never only on the
// happy path.
fn cleanup(bin: string, names: []string) {
  for name of names {
    output(bin, ["rm", "-f", name], dockerRunTimeoutMs)
  }
  releaseDocker(bin)
}

// Runs `bit test <target>` with ORM_TEST_LIVE_PG_URI/ORM_TEST_LIVE_MYSQL_URI
// (plus BIT_REPO/BIT_BIN, so pkg/orm's own `findRepoRoot()`/`envOr("BIT_BIN",
// ...)` resolve deterministically regardless of this process's cwd) set for
// exactly the child this spawns — see the file header's ENV section for why
// `/usr/bin/env` is the vehicle. A skip line anywhere in the child's stdout
// is a failure: the whole point of this gate is that no live proof may fall
// back to skipping.
fn runLiveTests(bitPath: string, repo: string, pgUrl: string, myUrl: string, target: string): int {
  let r = output(
    "/usr/bin/env",
    [
      "ORM_TEST_LIVE_PG_URI=${pgUrl}", "ORM_TEST_LIVE_MYSQL_URI=${myUrl}",
      "BIT_REPO=${repo}", "BIT_BIN=${bitPath}",
      bitPath, "test", target,
    ],
    testRunTimeoutMs,
  )
  let rc = relay(r, "ormlive", testRunTimeoutMs)
  if (contains(r.stdout, "  skipped: ")) {
    eprint("ormlive: a live test skipped inside test-package-orm-live — every ORM_TEST_LIVE_* var was set, so a skip means the harness or a live test is not reading it\n")
    if (rc == 0) {
      return 1
    }
  }
  return rc
}

// `_tests_/bit/ormrelauto/relautoc` (#6322, R2b) is a SEPARATE `bit test`
// target, not a second operand of the call above: `bit test` takes at most
// one operand (`cliBuildSpecs`'s own `maxOperands = 1`, compiler/cli.bit).
// It stays OUT of `pkg/orm` itself — a package release is `git archive
// <tag>` of `pkg/orm` alone, so a fixture module living inside it would
// ship to every `bit add orm` user — and carries its own `bit.json`
// (local-path deps on `pkg/orm`/`pkg/postgres`/`pkg/mysql`, mirroring
// `pkg/web/guides/inkwell/bit.json`) since a module cannot yet inherit an
// ancestor's `bit.lock`. `main` below runs both `bit test` targets and
// fails the whole gate if either one does.
fn runRelautocLiveTests(bitPath: string, repo: string, pgUrl: string, myUrl: string): int {
  return runLiveTests(bitPath, repo, pgUrl, myUrl, "${repo}/_tests_/bit/ormrelauto/relautoc")
}

// ---- O4 (#6313): `bit migrate` end-to-end, through the real `bit`
// binary and package-command dispatch (compiler/pkgcmd.bit), against the
// same throwaway Postgres this gate already started. A fixture PROJECT is
// built fresh under `$TMPDIR` for every run — NEVER under `pkg/orm/`,
// which ships to users via `git archive <tag>` (this file's own header,
// and `_tests_/bit/ormrelauto/relautoc/bit.json`'s identical reasoning) —
// with its own `bit.json`/`bit.lock` declaring "orm" (plus its own
// "postgres"/"mysql") as LOCAL PATH dependencies pointing straight at this
// checkout, exactly what a real user's `bit add <path-to-orm>` would leave
// behind, and two migration files. Table names are prefixed
// `migrate_e2e_` so this can never collide with a table name `bit test
// pkg/orm`'s own live fixtures use (`grep -l '"widgets"' pkg/orm/*.bit`
// finds several).
//
// `bit migrate`/`status`/`rollback` are each run through a throwaway
// `/bin/sh -c 'cd <projDir> && exec <bit> migrate ...'` wrapper — the same
// "no chdir primitive" pattern `compiler/pkgcmd.bit`'s own `gen.bit`
// invocation uses, since `std/process.output` has no cwd parameter and a
// package command is dispatched off the caller's OWN working directory
// (`findProjectRoot`, pkgcmd.bit).

const migrateE2eTimeoutMs: int = 60000

const migrateE2eWidgetsFile: string = "2024_01_01_000001_create_migrate_e2e_widgets.bit"
const migrateE2eGadgetsFile: string = "2024_01_01_000002_create_migrate_e2e_gadgets.bit"
const migrateE2eWidgetsName: string = "2024_01_01_000001_create_migrate_e2e_widgets"
const migrateE2eGadgetsName: string = "2024_01_01_000002_create_migrate_e2e_gadgets"
const migrateE2eWidgetsTable: string = "migrate_e2e_widgets"
const migrateE2eGadgetsTable: string = "migrate_e2e_gadgets"

// `migrateE2eWidgetsTable`/`migrateE2eGadgetsTable` spelled out literally
// (not `${...}`-interpolated) — a top-level `const` initializer must be a
// compile-time constant expression, and string interpolation is not one.
const migrateE2eWidgetsSrc: string = "import { Schema } from \"orm\"\n\n" +
  "export class CreateMigrateE2eWidgets {\n" +
  "  up(s: Schema): ()! {\n" +
  "    s.create(\"migrate_e2e_widgets\", (t) => {\n" +
  "      t.id()\n" +
  "      t.string(\"name\")\n" +
  "    })?\n" +
  "  }\n" +
  "  down(s: Schema): ()! { s.drop(\"migrate_e2e_widgets\")? }\n" +
  "}\n"

// NO `import { Schema }` HERE, ON PURPOSE: `migrations/` is one directory
// module (SPEC §17.1, "sharing one declaration namespace") and two sibling
// files importing the identical name is E0042 (`import { trimSpace } from
// "std/strings"` in two files of the same directory reproduces it
// standalone) — the widgets file's own import already puts `Schema` in
// the shared namespace every file in `migrations/` sees. A REAL project
// with more than one migration file needs to know this too; flagged on
// #6313, not fixed here (compiler import semantics, or at minimum
// pkg/orm/docs/migrate.md's multi-file guidance — both out of this
// ticket's scope).
const migrateE2eGadgetsSrc: string = "export class CreateMigrateE2eGadgets {\n" +
  "  up(s: Schema): ()! {\n" +
  "    s.create(\"migrate_e2e_gadgets\", (t) => {\n" +
  "      t.id()\n" +
  "      t.string(\"name\")\n" +
  "    })?\n" +
  "  }\n" +
  "  down(s: Schema): ()! { s.drop(\"migrate_e2e_gadgets\")? }\n" +
  "}\n"

fn stripTrailingSlash(p: string): string {
  if (hasSuffix(p, "/")) {
    return p[0:len(p) - 1]
  }
  return p
}

// `orm`, `postgres` and `mysql` as LOCAL PATH lock entries pointing at this
// checkout's own `pkg/`, exactly `_tests_/bit/ormrelauto/relautoc/bit.lock`'s
// own shape, one level up (that fixture imports `pkg/orm` by relative path
// instead — see this section's own header for why THIS fixture needs the
// real package-name resolution `bit migrate` itself goes through).
fn migrateE2eFixtureBitLock(repo: string): string {
  return "{" +
    "\"orm\":{\"path\":\"${repo}/pkg/orm\",\"requires\":{}}," +
    "\"postgres\":{\"path\":\"${repo}/pkg/postgres\",\"requires\":{}}," +
    "\"mysql\":{\"path\":\"${repo}/pkg/mysql\",\"requires\":{}}" +
    "}\n"
}

fn writeMigrateE2eFixture(repo: string, projDir: string): ()! {
  mkdir(projDir)?
  mkdir("${projDir}/migrations")?
  writeFile("${projDir}/bit.json", "{\"dependencies\": {\"orm\": \"${repo}/pkg/orm\"}}\n")?
  writeFile("${projDir}/bit.lock", migrateE2eFixtureBitLock(repo))?
  writeFile("${projDir}/migrations/${migrateE2eWidgetsFile}", migrateE2eWidgetsSrc)?
  writeFile("${projDir}/migrations/${migrateE2eGadgetsFile}", migrateE2eGadgetsSrc)?
}

// Runs `bit migrate [sub] --url pgUrl` with `projDir` as the child
// process's own cwd (this section's own header).
fn runMigrateE2eCmd(projDir: string, bitPath: string, sub: string, pgUrl: string): RunResult! {
  let subArg = sub
  if (subArg != "") {
    subArg = "${subArg} "
  }
  let scriptPath = "${projDir}.cmd.sh"
  let script = "#!/bin/sh\n" +
    "cd '${projDir}' || exit 1\n" +
    "exec '${bitPath}' migrate ${subArg}--url '${pgUrl}'\n"
  writeFile(scriptPath, script)?
  return output("/bin/sh", [scriptPath], migrateE2eTimeoutMs)
}

fn requireMigrateE2eExitZero(where: string, r: RunResult): ()! {
  if (r.exitCode != 0) {
    fail newError("ormlive: migrate e2e: ${where} exited ${r.exitCode}: ${r.stderr}")
  }
}

fn requireMigrateE2eContains(where: string, out: string, want: string): ()! {
  if (!contains(out, want)) {
    fail newError("ormlive: migrate e2e: ${where}: stdout missing '${want}': ${out}")
  }
}

fn assertMigrateE2eMigrateOutput(r: RunResult): ()! {
  requireMigrateE2eExitZero("bit migrate", r)?
  requireMigrateE2eContains("bit migrate", r.stdout, "applied ${migrateE2eWidgetsName}\n")?
  requireMigrateE2eContains("bit migrate", r.stdout, "applied ${migrateE2eGadgetsName}\n")?
}

fn assertMigrateE2eStatusOutput(r: RunResult): ()! {
  requireMigrateE2eExitZero("bit migrate status", r)?
  requireMigrateE2eContains(
    "bit migrate status", r.stdout, "applied  ${migrateE2eWidgetsName}  batch 1\n",
  )?
  requireMigrateE2eContains(
    "bit migrate status", r.stdout, "applied  ${migrateE2eGadgetsName}  batch 1\n",
  )?
}

// `rollback` reverts newest file first (`runner.bit`'s own header, piece
// 3): the gadgets migration (the later file) must be reported before the
// widgets one.
fn assertMigrateE2eRollbackOutput(r: RunResult): ()! {
  requireMigrateE2eExitZero("bit migrate rollback", r)?
  let widgetsAt = indexOf(r.stdout, "rolled back ${migrateE2eWidgetsName}")
  let gadgetsAt = indexOf(r.stdout, "rolled back ${migrateE2eGadgetsName}")
  if (widgetsAt < 0 || gadgetsAt < 0 || gadgetsAt > widgetsAt) {
    fail newError(
        "ormlive: migrate e2e: bit migrate rollback: want ${migrateE2eGadgetsName} (newest) " +
        "before ${migrateE2eWidgetsName}, got: ${r.stdout}",
    )
  }
}

fn pgTableExists(bin: string, name: string, table: string): bool! {
  let r = output(
    bin, [
      "exec",
      name,
      "psql",
      "-U",
      "postgres",
      "-tAc",
      "select to_regclass('${table}') is not null",
    ],
    dockerQuickTimeoutMs,
  )
  if (r.exitCode != 0) {
    fail newError("ormlive: migrate e2e: docker exec psql: ${failureText(r, dockerQuickTimeoutMs)}")
  }
  return trimSpace(r.stdout) == "t"
}

// The real table state after `rollback`: both tables `down()` drops must
// actually be gone from the live database, not just absent from the
// `migrations` ledger.
fn assertMigrateE2eTablesDropped(bin: string, pgName: string): ()! {
  let widgetsGone = !pgTableExists(bin, pgName, migrateE2eWidgetsTable)?
  let gadgetsGone = !pgTableExists(bin, pgName, migrateE2eGadgetsTable)?
  if (!widgetsGone || !gadgetsGone) {
    fail newError(
        "ormlive: migrate e2e: rollback did not drop ${migrateE2eWidgetsTable}/" +
        "${migrateE2eGadgetsTable} (widgetsGone=${widgetsGone}, gadgetsGone=${gadgetsGone})",
    )
  }
}

fn removeMigrateE2eFixtureBestEffort(projDir: string) {
  remove(projDir) catch _ {
    return
  }
}

// `bit migrate`, `bit migrate status`, `bit migrate rollback`, in order,
// against a fresh fixture project — see this section's own header.
fn runMigrateE2E(bin: string, pgName: string, bitPath: string, repo: string, pgUrl: string): ()! {
  let projDir = "${stripTrailingSlash(envOr("TMPDIR", "/tmp"))}/bit-orm-migrate-e2e-${uuidFormat(uuidV4())}"
  writeMigrateE2eFixture(repo, projDir)?
  defer removeMigrateE2eFixtureBestEffort(projDir)

  assertMigrateE2eMigrateOutput(runMigrateE2eCmd(projDir, bitPath, "", pgUrl)?)?
  assertMigrateE2eStatusOutput(runMigrateE2eCmd(projDir, bitPath, "status", pgUrl)?)?
  assertMigrateE2eRollbackOutput(runMigrateE2eCmd(projDir, bitPath, "rollback", pgUrl)?)?
  assertMigrateE2eTablesDropped(bin, pgName)?
}

// ---- O5 (#6314): `bit make migration <name>` end-to-end, through the
// real `bit` binary and package-command dispatch, against a SECOND fresh
// fixture project (never the one `runMigrateE2E` already applied/rolled
// back — a project's migration history is per-project, but sharing one
// project would still couple the two sections' file counts together).
// Proves the full chain `bit make migration` -> real `bit migrate`: the
// generated file's `up`/`down` are empty (this ticket's own contract), so
// no table is asserted here — `runMigrateE2E`, above, already proves
// `bit migrate` executes real `Schema` ops; this proves `bit make
// migration`'s OWN output is what gets discovered and applied.

// Runs `bit make migration <name>` with `projDir` as the child process's
// own cwd (this section's own header) — no `--url`, `bit make migration`
// never touches a database.
fn runMakeMigrationE2eCmd(projDir: string, bitPath: string, name: string): RunResult! {
  let scriptPath = "${projDir}.make.cmd.sh"
  let script = "#!/bin/sh\n" +
    "cd '${projDir}' || exit 1\n" +
    "exec '${bitPath}' make migration ${name}\n"
  writeFile(scriptPath, script)?
  return output("/bin/sh", [scriptPath], migrateE2eTimeoutMs)
}

fn writeMakeMigrationE2eFixture(repo: string, projDir: string): ()! {
  mkdir(projDir)?
  writeFile("${projDir}/bit.json", "{\"dependencies\": {\"orm\": \"${repo}/pkg/orm\"}}\n")?
  writeFile("${projDir}/bit.lock", migrateE2eFixtureBitLock(repo))?
}

fn assertMakeMigrationCreated(r: RunResult, where: string): ()! {
  requireMigrateE2eExitZero("bit make migration ${where}", r)?
  requireMigrateE2eContains("bit make migration ${where}", r.stdout, "created migrations/")?
}

fn assertMakeMigrationRefused(r: RunResult, where: string, want: string): ()! {
  if (r.exitCode == 0) {
    fail newError("ormlive: make migration e2e: ${where}: exited 0, want nonzero (out=${r.stdout})")
  }
  if (!contains(r.stderr, want)) {
    fail newError("ormlive: make migration e2e: ${where}: stderr missing '${want}': ${r.stderr}")
  }
}

// `migrations/`'s own file names, sorted (`std/fs`'s own `readDir`
// contract) — empty when the directory was never created (no successful
// `bit make migration` call yet).
fn listMakeMigrationFiles(projDir: string): []string! {
  let migDir = "${projDir}/migrations"
  if (!exists(migDir)) {
    return []string(0)
  }
  return readDir(migDir)?
}

// Both files created above, minus the trailing `bit make migration`
// itself never writes — the ledger name `bit migrate` reports for each.
fn requireMakeMigrationTwoFilesOrdered(projDir: string): (string, string)! {
  let sep = ", "
  let names = listMakeMigrationFiles(projDir)?
  if (len(names) != 2) {
    fail newError(
      "ormlive: make migration e2e: want 2 migration files, got ${len(names)}: ${join(names, sep)}",
    )
  }
  if (!(names[0] < names[1])) {
    fail newError("ormlive: make migration e2e: files not correctly ordered: ${join(names, sep)}")
  }
  return (names[0][0:len(names[0]) - 4], names[1][0:len(names[1]) - 4])
}

// `bit make migration create_make_e2e_widgets`, a duplicate of the same
// name (refused), an invalid name (refused), then a second distinct
// migration — each through the real package-command dispatch — followed
// by `bit migrate` proving BOTH generated files were discovered and
// applied, in the correct (creation) order.
fn runMakeMigrationE2E(bitPath: string, repo: string, pgUrl: string): ()! {
  let projDir = "${stripTrailingSlash(envOr("TMPDIR", "/tmp"))}/bit-orm-make-migration-e2e-${uuidFormat(uuidV4())}"
  writeMakeMigrationE2eFixture(repo, projDir)?
  defer removeMigrateE2eFixtureBestEffort(projDir)

  assertMakeMigrationCreated(
    runMakeMigrationE2eCmd(projDir, bitPath, "create_make_e2e_widgets")?, "create_make_e2e_widgets",
  )?
  assertMakeMigrationRefused(
    runMakeMigrationE2eCmd(projDir, bitPath, "create_make_e2e_widgets")?,
    "duplicate name", "already exists",
  )?
  assertMakeMigrationRefused(
    runMakeMigrationE2eCmd(projDir, bitPath, "Bad-Name")?, "invalid name", "must match",
  )?
  assertMakeMigrationCreated(
    runMakeMigrationE2eCmd(projDir, bitPath, "create_make_e2e_gadgets")?, "create_make_e2e_gadgets",
  )?

  let (name1, name2) = requireMakeMigrationTwoFilesOrdered(projDir)?
  let applied = runMigrateE2eCmd(projDir, bitPath, "", pgUrl)?
  requireMigrateE2eExitZero("bit migrate (make-migration e2e)", applied)?
  requireMigrateE2eContains(
    "bit migrate (make-migration e2e)",
    applied.stdout,
    "applied ${name1}\n",
  )?
  requireMigrateE2eContains(
    "bit migrate (make-migration e2e)",
    applied.stdout,
    "applied ${name2}\n",
  )?
}

fn main() {
  let bin = requireDocker("ormlive")
  sweepOrphans(bin)

  let repo = repoRoot()
  let bitPath = envOr("BIT_BIN", "${repo}/bit-out/bin/bit")
  let runId = uuidFormat(uuidV4())
  let pgName = "bit-orm-live-pg-${runId}"
  let myName = "bit-orm-live-mysql-${runId}"
  let names = [pgName, myName]

  let pid = selfPid() catch e {
    eprint("ormlive: ${e.message()}\n")
    exit(1)
    return
  }
  let ownerLabel = "${ownerLabelKey}=${pid}"

  let pgPort = startPostgres(bin, pgName, ownerLabel) catch e {
    eprint("ormlive: ${e.message()}\n")
    cleanup(bin, names)
    exit(1)
    return
  }
  let myPort = startMysql(bin, myName, ownerLabel) catch e {
    eprint("ormlive: ${e.message()}\n")
    cleanup(bin, names)
    exit(1)
    return
  }

  let pgUrl = "postgres://postgres@127.0.0.1:${pgPort}/postgres"
  let myUrl = "mysql://root:${myRootPassword}@127.0.0.1:${myPort}/${myDatabase}"
  let rc = runLiveTests(bitPath, repo, pgUrl, myUrl, "${repo}/pkg/orm")
  if (rc == 0) {
    rc = runRelautocLiveTests(bitPath, repo, pgUrl, myUrl)
  }
  if (rc == 0) {
    runMigrateE2E(bin, pgName, bitPath, repo, pgUrl) catch e {
      eprint("${e.message()}\n")
      rc = 1
    }
  }
  if (rc == 0) {
    runMakeMigrationE2E(bitPath, repo, pgUrl) catch e {
      eprint("${e.message()}\n")
      rc = 1
    }
  }

  cleanup(bin, names)
  exit(rc)
}
