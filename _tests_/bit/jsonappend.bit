// _tests_/bit/jsonappend.bit — #5991 (#5961 item 1): `@json`'s direct
// `__jsonAppend(out: []byte): []byte` (compiler/classjsonappend.bit).
//
// NOT placed in _tests_/cases/: that corpus's golden/stage0 harnesses run
// with a fixed environment and no per-fixture env var (the same reason
// _tests_/bit/ifaceassertsig.bit gives), and the golden corpus's own
// `@json` fixtures are compared against the pinned stage0 oracle, which
// carries `__jsonAppend` too since the 0.31.0 repin but the corpus itself
// never calls it directly. Same "drive the CLI directly, outside the
// oracle-swept corpus" treatment; BIT_BIN/BIT_STDLIB/BIT_LIBBITRT, no
// oracle involved.
//
// One fixture, two classes:
//   Message  — the running example from the ticket (`@json class Message {
//               message: string }`): proves `__jsonAppend` on the smallest
//               possible class matches `jsonEncode(toJson())` byte for byte.
//   User     — every field shape `@json` accepts in one class (i64, string,
//               bool, f64, `[]string`, a present `Option<string>`, an ABSENT
//               one, a `@key` override whose text itself needs a JSON escape
//               (`weird\"key`, proving `jsonAppendKey`'s escaping matches
//               `jsonEncode`'s own), a nested `@json` class, a `[]T` of
//               nested `@json` classes, a `map<string, i64>`, a payload-free
//               enum field and a `[]T` of one (#6163, the FIRST, a middle
//               and the LAST declared variant, proving the ternary chain's
//               every branch), plus one map field called twice to prove it
//               encodes identically across calls (no read-once state left
//               over in the runtime helpers).
//
// WIRED INTO `./make test` as `test-jsonappend` (tools/build/gatestable2.bit,
// tools/build/defs.bit).

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"
import { parseInt, trimSpace } from "std/strings"

const defaultTimeoutS: int = 60
const maxTimeoutMs: int = 6000000

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("jsonappend: ${name} is not set — refusing to guess.\n")
    exit(2)
  }
  return v
}

fn timeoutMs(): int {
  let raw = trimSpace(envOr("BIT_TEST_TIMEOUT_S", ""))
  if (raw == "") {
    return defaultTimeoutS * 1000
  }
  let s = parseInt(raw) catch _ {
    return defaultTimeoutS * 1000
  }
  if (s <= 0) {
    return maxTimeoutMs
  }
  if (s * 1000 > maxTimeoutMs) {
    return maxTimeoutMs
  }
  return s * 1000
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

// One class of every shape `@json` accepts, plus the ticket's own `Message`
// example — see the header for what each proves.
fn fixtureSrc(): string {
  return "import { Json, JsonEntry, jsonEncode } from \"std/json\"\n\n" +
    "enum Status {\n  Draft,\n  Published,\n  Archived,\n}\n\n" +
    "@json class Addr {\n  city: string,\n  zip: i32,\n}\n\n" +
    "@json class Message {\n  message: string,\n}\n\n" +
    "@json class User {\n" +
    "  id: i64\n  name: string\n  active: bool\n  ratio: f64\n" +
    "  tags: []string\n  nick: Option<string>\n  absent: Option<string>\n" +
    "  @key(\"weird\\\"key\")\n  createdAt: string\n" +
    "  addr: Addr\n  places: []Addr\n  meta: map<string, i64>\n" +
    "  status: Status\n  history: []Status\n}\n\n" +
    "fn main() {\n" +
    "  let m = Message{ message = \"hi\" }\n" +
    "  let msgWant = jsonEncode(m.toJson())\n" +
    "  let msgGot = string(m.__jsonAppend([]byte(0, 8)))\n\n" +
    "  let u = User{\n" +
    "    id = 7,\n    name = \"ada\",\n    active = true,\n    ratio = 0.5,\n" +
    "    tags = [\"a\", \"b\"],\n" +
    "    nick = Option<string>.Some(\"mango\"),\n" +
    "    absent = Option<string>.None,\n" +
    "    createdAt = \"2026-01-01\",\n" +
    "    addr = Addr{ city = \"cairo\", zip = 11511 },\n" +
    "    places = [Addr{ city = \"giza\", zip = 1 }, Addr{ city = \"luxor\", zip = 2 }],\n" +
    "    meta = map<string, i64>{ \"hits\": 3 },\n" +
    "    status = Status.Draft,\n" +
    "    history = [Status.Published, Status.Archived],\n" +
    "  }\n" +
    "  let want = jsonEncode(u.toJson())\n" +
    "  let got1 = string(u.__jsonAppend([]byte(0, 8)))\n" +
    "  let got2 = string(u.__jsonAppend([]byte(0, 8)))\n\n" +
    "  print(\"msg=\${msgGot}\\n\")\n" +
    "  print(\"msg_match=\${msgGot == msgWant} user_match=\${got1 == want} stable=\${got1 == got2}\\n\")\n" +
    "}\n"
}

const wantOut: string = "msg={\"message\":\"hi\"}\n" +
  "msg_match=true user_match=true stable=true\n"

class CompilerEnv {
  bin: string,
  stdlib: string,
  libbitrt: string,
}

fn buildOne(cc: CompilerEnv, dir: string, srcPath: string, outPath: string): (int, string) {
  let shPath = dir + "/build.sh"
  let errPath = dir + "/build.err"
  let script = "#!/bin/sh\n" +
    "BIT_STDLIB=" +
    shQuote(cc.stdlib) +
    "\nexport BIT_STDLIB\n" +
    "BIT_LIBBITRT=" +
    shQuote(cc.libbitrt) +
    "\nexport BIT_LIBBITRT\n" +
    "exec " +
    shQuote(cc.bin) +
    " build " +
    shQuote(srcPath) +
    " -o " +
    shQuote(outPath) +
    " > /dev/null 2> " +
    shQuote(errPath) +
    "\n"
  writeFile(shPath, script) catch e {
    eprint("jsonappend: cannot write build wrapper: ${e.message()}\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("jsonappend: cannot chmod build wrapper\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let err = readFile(errPath) catch _ {
    ""
  }
  return code, err
}

fn runOne(dir: string, binPath: string): (int, string) {
  let shPath = dir + "/run.sh"
  let outPath = dir + "/run.out"
  let script = "#!/bin/sh\nexec " + shQuote(binPath) + " > " + shQuote(outPath) + " 2>&1\n"
  writeFile(shPath, script) catch e {
    eprint("jsonappend: cannot write run wrapper: ${e.message()}\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("jsonappend: cannot chmod run wrapper\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let out = readFile(outPath) catch _ {
    ""
  }
  return code, out
}

fn teardown(scratch: string, ms: int) {
  let shPath = scratch + "/rm.sh"
  writeFile(shPath, "#!/bin/sh\nrm -rf '${scratch}'\n") catch _ {
    return
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    return
  }
  osRunBounded(shPath, ms)
}

fn main() {
  let cc = CompilerEnv{
    bin = requiredEnv("BIT_BIN"),
    stdlib = requiredEnv("BIT_STDLIB"),
    libbitrt = requiredEnv("BIT_LIBBITRT"),
  }

  let scratch = envOr("TMPDIR", "/tmp") + "/bit-jsonappend-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("jsonappend: cannot create scratch directory ${scratch}: ${e.message()}\n")
    exit(2)
  }

  let srcPath = scratch + "/fixture.bit"
  writeFile(srcPath, fixtureSrc()) catch e {
    eprint("jsonappend: cannot write ${srcPath}: ${e.message()}\n")
    teardown(scratch, timeoutMs())
    exit(2)
  }
  let outPath = scratch + "/fixture_out"
  let (buildCode, buildErr) = buildOne(cc, scratch, srcPath, outPath)
  if (buildCode != 0) {
    eprint("jsonappend: FAIL — fixture failed to build (exit ${buildCode}):\n${buildErr}\n")
    teardown(scratch, timeoutMs())
    exit(1)
  }
  let (runCode, out) = runOne(scratch, outPath)
  if (runCode != 0 || out != wantOut) {
    eprint("jsonappend: FAIL — ran wrong: exit=${runCode}\n  want: ${wantOut}\n  got:  ${out}\n")
    teardown(scratch, timeoutMs())
    exit(1)
  }

  teardown(scratch, timeoutMs())
  print("PASS jsonappend: __jsonAppend matches jsonEncode(toJson()) for the Message example and for every @json field shape (scalar, bool, float, []T, Option present/absent, an escaped @key, nested, []nested, map), and a map field encodes identically across two calls\n")
}
