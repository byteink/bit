// `./make test-package-docs` (#5127).
//
// THE HOLE THIS CLOSES. `_tests_/bit/docs.bit` (`test-docs`) only ever scans
// `BIT_DOCS`/`BIT_SPEC`, which default to `${repoRoot()}/docs` and
// `${repoRoot()}/spec` (`docsrunner/runner.bit`'s `setup()`), and
// `scripts/gate-buildsteps.sh`'s `pkg)` bucket never named it either — a
// `pkg/**`-only diff runs `test-packages`/`test-lint-sweep`/`test-fmt`/
// `test-lint-complexity`/`test-package-release-drift` and nothing else. So no
// gate anywhere has ever compiled or format-checked a single fenced ```` ```bit
// ```` block under `pkg/<name>/docs/` or `pkg/<name>/README.md`.
//
// CONCRETE, NOT HYPOTHETICAL. `pkg/web/docs/getting-started.md`'s three
// blocks are a continuation series (block 2 uses `Ctx`/`Res` from block 1's
// import, block 3 reuses `App`/`Ctx`/`Res` again) but re-declared `App` and
// `Config` on every block's own `import { ... } from "web"` line — joined the
// way a reader reads the chapter, that is `error[E0042]: 'App' is already
// declared in this scope`, reproduced with the real compiler before this gate
// existed. Separately, #5115's first draft of `pkg/web/docs/envelope.md`
// shipped a block using `@json class User` with no `import { Json, JsonEntry }
// from "std/json"` (E0142) and reached a committed branch tip with
// `scripts/gate.sh` green, because this gate scope did not exist. Both
// findings are on #5127.
//
// WHY A NEW FILE AND NOT A `BIT_DOCS` OVERRIDE ON `test-docs`. A page under
// `pkg/<name>/docs/` writes `import { App, Config } from "web"` — a real
// package import, exactly as a consumer of `pkg/<name>` would write it, not a
// `std/*` import `docs.bit`'s harness already resolves for free. Checking
// that against `BIT_STDLIB` alone reproduces exactly the E0045 "cannot find
// module" this file's own probe hit first; checking it by copying the block
// INTO a scratch copy of `pkg/<name>` (this ticket's first, wrong attempt, and
// exactly how #5115's `@json` bug survived its author's own first
// verification pass — a sibling file in the same module silently supplied the
// missing import) reproduces the "reader pastes into their OWN project" case
// backwards: a block must compile against only the imports it declares, in a
// project that has `pkg/<name>` as its ONLY declared dependency, nothing else
// borrowed. `compiler/pmfetch.bit`'s `scheme == "local"` dependency form
// (#2244: a bare path or `file://` URL, no ref, no network, no git) is
// exactly this: each job's scratch project's `bit.json`/`bit.lock` name
// `<name>` as a local-path dependency pointing at this repo's own
// `pkg/<name>/`, verified directly against a real `bit add <abs-path>` run
// (never hand-guessed) to write:
//   bit.json: {"name": "...", "dependencies": {"web": "/abs/path/to/pkg/web"}}
//   bit.lock: {"web": {"path": "/abs/path/to/pkg/web", "requires": {}}}
// A local dependency has no ref to resolve and nothing to fetch (per
// `pmfetch.bit`'s own comment), so writing this pair directly is exactly what
// `bit add` would produce, with no subprocess spent doing it.
//
// JOINING, NOT PER-BLOCK, BY DEFAULT — same precedent `docs.bit` already set
// for `docs/`: a chapter's blocks are one module in document order unless the
// page carries `<!-- doctest: per-block -->`, because that is how a reference
// chapter is read (and how #5115's own `envelope.md` chapter is written).
// `pkg/web/docs/getting-started.md` carries no such marker, so its fix is to
// import each symbol once across the whole page, never to add the marker to
// dodge the check.
//
// WHAT THIS GATE DOES NOT DO YET, ON PURPOSE (scope named, not hidden). It has
// no `<!-- doctest: test-file -->` support (`docs.bit`'s #4615) — no current
// `pkg/*/docs/` page declares a `test "..." { }` block, and a page that tried
// would fail loudly with E0117 rather than pass silently, the same fail-safe
// direction `docs.bit`'s own marker exists to guarantee. It does not audit
// every `pkg/*/docs/` page for the E0042 pattern beyond `pkg/web` — #5127's
// own acceptance is proving this gate catches `getting-started.md`'s E0042
// red-before/green-after; a wider audit is separate follow-up work, filed as
// its own ticket rather than silently exempting any file from this gate.
//
// PROSE LINKS (#5401). Compiling ```bit blocks says nothing about the prose
// around them: `docs/dialect.md` linked `../README.md#dialect-vs-
// upsertdialect` and that anchor stopped existing the moment #5384 renamed
// the heading it pointed at — a person caught it, no gate did. So every page
// this file already reads is also scanned (fenced blocks stripped first, so
// an example's own brackets/parens are never mistaken for prose) for
// `[text](target)` markdown links: a relative `target` must resolve to a
// real file (checked against the page's own directory), and a `#anchor` on
// either a same-page or cross-page link must match a real heading's GitHub-
// style slug in the resolved file. No allowlist — a broken link or a broken
// anchor genuinely broke; this cannot cry wolf on a legitimate prose word
// the way a symbol-name check would (a backticked-identifier check was
// considered and rejected here for exactly that reason; see the ticket).
//
// Registered in `coreSteps()` (tools/build/defs.bit) beside `test-packages`,
// deliberately NOT `gateSteps()` — same reason as every other package gate:
// this must never grow the mandatory `./make test` suite. Added to the `pkg`
// bucket's `BUILD_STEPS` in `scripts/gate-buildsteps.sh`, the same "examines
// this bucket's content directly" exception `test-lint-sweep`/`test-fmt`/
// `test-lint-complexity`/`test-package-release-drift` already are.
//
// #6063 (epic #6061, the pkg/web guides course) extends the scan and the
// scratch project: `pkg/<name>/guides/*.md` is scanned the same way as
// `docs/*.md` (`guides/inkwell/` is a directory, not a `.md` file, so the
// same non-recursive filter skips it — no special case needed), and a page
// may declare `<!-- doctest: deps a b c -->` naming extra first-party
// packages its own scratch project depends on (`./pkgdocs`'s `deps.bit`).
// `./pkgdocs`'s `links.bit` also moved out here, a pure split for
// spec/LINT.md's 800-line ceiling: the run-wide `Stats` accumulator and the
// prose markdown-link checker (#5401), unchanged bodies.
//
// Configure by environment, since `bit run` forwards no argv:
//   BIT_REPO             repo root                          (required)
//   BIT_BIN              compiler under test (default bit-out/bin/bit)
//   BIT_STDLIB            stdlib root         (default ${BIT_REPO}/stdlib)
//   BIT_TEST_TIMEOUT_S    per-job deadline, seconds (default 60, max 3600)

import { exists, isDir, mkdir, readDir, readFile, remove, writeFile } from "std/fs"
import { JsonEntry, jsonAsObject, jsonAsString, jsonGet, jsonParse } from "std/json"
import { envOr, exit } from "std/os"
import { join } from "std/path"
import { contains, hasPrefix, hasSuffix, indexOf, parseInt } from "std/strings"
import { now } from "std/time"
import { repoRoot, trimInfo } from "./docsrunner"
import {
  DepEntry, Stats, checkPageLinks, parseDepsDirective, resolveDeclaredDeps, zeroStats,
} from "./pkgdocs"

const defaultTimeoutS: int = 60
const maxTimeoutS: int = 3600
const timeoutEnvVar: string = "BIT_TEST_TIMEOUT_S"

const fenceTag: string = "```bit"
const fenceClose: string = "\n```"
const perBlockMarker: string = "<!-- doctest: per-block -->"
// A bound on the walk (Power of 10): no page in this corpus is remotely
// close to it, and a page that somehow hit it would rather be truncated
// loudly here than let the extractor run unbounded.
const maxBlocksPerPage: int = 64

// `pkg/*/bit.json`'s only first-party dependency form today (`pkg/auth`'s
// own): `bitlang.org/pkg/<name>[@<ref>]`, resolved onto this repo's own
// `pkg/<name>` — no fetch, same as `main()` resolves the package under test.
const vanityPkgPrefix: string = "bitlang.org/pkg/"

// Bound on a first-party dependency chain (Power of 10 rule 2).
const maxDepDepth: int = 8

// `osRunBounded`'s result encoding (ABI.md §19), same constants
// `_tests_/bit/packagesgate.bit` already names.
const rcSpawnFailed: int = -1
const rcTimedOut: int = -2
const rcSignalBase: int = -100

// The compiler under test, the per-job deadline and the repo's `pkg/` root:
// bundled so `processPage`, `pageDeps` and `runJob` each stay within
// spec/LINT.md's 5-param ceiling.
class Cfg { bin: string, deadlineMs: int, pkgDir: string }

class Block { src: string }

// The package under test plus its own transitive first-party deps
// (`firstPartyDeps`) — bundled like `Cfg` for the 5-param ceiling.
class PkgInfo { name: string, absPath: string, deps: []DepEntry }

// One check: a page (joined) or one page+block (per-block), its source,
// its package (scratch-project deps), and where it came from for reporting.
class Job {
  page: string,
  block: int, // 0 for a joined job, 1-based for a per-block job
  src: string,
  pkg: PkgInfo,
}

// The `pkg/<name>/` directory names that exist right now, same
// filesystem-driven discovery `tools/build/gates.bit`'s `packageNames()`
// already uses, reproduced here rather than imported since that file is a
// `tools/build/` module and this is a `_tests_/bit/` one.
fn packageNames(pkgDir: string): []string {
  let names = readDir(pkgDir) catch e {
    fatal("cannot read ${pkgDir}: ${e.message()}")
    return []string(0)
  }
  let out = []string(0)
  for name of names {
    if (len(name) > 0 && name[0] == '.') {
      continue
    }
    if (isDir(join(pkgDir, name))) {
      out = append(out, name)
    }
  }
  return out
}

// `dir`'s own `*.md` files, non-recursive — a subdirectory (for example
// `guides/inkwell/`, the guides course's own runnable app, gated separately,
// #6061/#6062) is never itself a `.md` file, so `hasSuffix` already skips
// it; no separate exclusion check is needed.
fn mdFilesIn(dir: string): []string {
  let out = []string(0)
  if (!isDir(dir)) {
    return out
  }
  let entries = readDir(dir) catch e {
    fatal("cannot read ${dir}: ${e.message()}")
    return out
  }
  for f of entries {
    if (hasSuffix(f, ".md")) {
      out = append(out, join(dir, f))
    }
  }
  return out
}

// A package's own doc pages: every `docs/*.md`, every `guides/*.md` (#6063),
// then `README.md` if it exists — sorted within each group by `readDir`'s
// own contract, so a run's output order is reproducible.
fn packagePages(pkgDir: string, name: string): []string {
  let base = join(pkgDir, name)
  let out = mdFilesIn(join(base, "docs"))
  for f of mdFilesIn(join(base, "guides")) {
    out = append(out, f)
  }
  let readme = join(base, "README.md")
  if (exists(readme)) {
    out = append(out, readme)
  }
  return out
}

// `manifestPath`'s "dependencies" entries, or none; a non-object one fatals.
fn readDepsObject(manifestPath: string): []JsonEntry {
  let text = readFile(manifestPath) catch e {
    fatal("cannot read ${manifestPath}: ${e.message()}")
    ""
  }
  let root = jsonParse(text) catch e {
    fatal("cannot parse ${manifestPath}: ${e.message()}")
    return []JsonEntry(0)
  }
  let depsField = jsonGet(root, "dependencies")
  if (isNone(depsField)) {
    return []JsonEntry(0)
  }
  let entries = jsonAsObject(unwrap(depsField))
  if (isNone(entries)) {
    fatal("${manifestPath}'s \"dependencies\" is not an object")
  }
  return unwrap(entries)
}

// `entry`'s first-party dep name (`bitlang.org/pkg/<name>[@<ref>]` ->
// `<name>`), or "" when it is not that vanity form, or already in `deps`.
fn resolveFirstPartyDep(entry: JsonEntry, deps: []DepEntry): string {
  let value = jsonAsString(entry.value)
  if (isNone(value)) {
    return ""
  }
  let dep = unwrap(value)
  if (!hasPrefix(dep, vanityPkgPrefix)) {
    return ""
  }
  let rest = dep[len(vanityPkgPrefix):]
  let at = indexOf(rest, "@")
  let name = rest
  if (at >= 0) {
    name = rest[0:int(at)]
  }
  for d of deps {
    if (d.name == name) {
      return ""
    }
  }
  return name
}

// `pkgPath`'s own deps, recursed into each dep's own `bit.json` in turn, so
// a whole chain lands in the scratch project, not just the direct ones. A dep
// already in `out` is skipped, which also stops any cycle among the deps; a
// dep naming `root` itself is the one cycle that skip cannot see.
fn firstPartyDeps(
  pkgDir: string,
  pkgPath: string,
  root: string,
  depth: int,
  out: []DepEntry,
): []DepEntry {
  if (depth > maxDepDepth) {
    fatal("first-party dependency chain under ${pkgPath} exceeds the ${maxDepDepth}-deep bound")
  }
  let manifestPath = join(pkgPath, "bit.json")
  if (!exists(manifestPath)) {
    return out
  }
  for entry of readDepsObject(manifestPath) {
    let name = resolveFirstPartyDep(entry, out)
    if (len(name) == 0) {
      continue
    }
    if (name == root) {
      fatal("first-party dependency cycle: ${pkgPath} depends on '${root}'")
    }
    let depPath = join(pkgDir, name)
    out = append(out, DepEntry{ name = name, path = depPath })
    out = firstPartyDeps(pkgDir, depPath, root, depth + 1, out)
  }
  return out
}

// Every fenced ```` ```bit ```` block on the page whose info string is empty
// (so ```` ```bit ignore ```` and a bare ```` ``` ```` are excluded, and
// ```` ```bitrot ```` never matches the tag at all) — `docs.bit`'s own
// `extractBlocks` contract, reproduced here since this file's corpus and
// consumer (a per-package job, not a per-page one) differ enough that
// sharing the function across a module boundary would need exporting the
// whole extraction shape from `docsrunner`, which `docs.bit`'s own header
// already assigns to itself, not to the batch runner.
fn extractBlocks(md: string): []Block {
  let blocks = []Block(0)
  let rest = md
  while (len(blocks) < maxBlocksPerPage) {
    let tagRel = indexOf(rest, fenceTag)
    if (tagRel < 0) {
      break
    }
    let t = int(tagRel)
    let atLineStart = t == 0 || rest[t - 1] == '\n'
    let afterTag = rest[t + len(fenceTag):]
    let nlRel = indexOf(afterTag, "\n")
    if (nlRel < 0) {
      break
    }
    let n = int(nlRel)
    let info = trimInfo(afterTag[:n])
    let body = afterTag[n + 1:]
    let closeRel = indexOf(body, fenceClose)
    if (closeRel < 0) {
      break
    }
    let c = int(closeRel)
    if (atLineStart && len(info) == 0) {
      blocks = append(blocks, Block{ src = body[:c] })
    }
    rest = body[c:]
  }
  return blocks
}

fn joinBlocks(blocks: []Block): string {
  let out = ""
  for b of blocks {
    out = out + b.src + "\n\n"
  }
  return normalizeTrailingNewline(out)
}

// A checkable module must end in exactly one newline, or `bit fmt --check`
// reports drift that has nothing to do with the author's style — same reason
// `docs.bit`'s own `normalizeTrailingNewline` exists.
fn normalizeTrailingNewline(src: string): string {
  let trimmed = src
  while (len(trimmed) > 0 && trimmed[len(trimmed) - 1] == '\n') {
    trimmed = trimmed[:len(trimmed) - 1]
  }
  return trimmed + "\n"
}

fn jobsForPage(page: string, md: string, blocks: []Block, pkg: PkgInfo): []Job {
  if (contains(md, perBlockMarker)) {
    let out = []Job(0)
    let i = 0
    while (i < len(blocks)) {
      out = append(
        out,
        Job{
          page = page, block = i + 1, src = normalizeTrailingNewline(blocks[i].src),
          pkg = pkg,
        },
      )
      i = i + 1
    }
    return out
  }
  return [
    Job{
      page = page,
      block = 0,
      src = joinBlocks(blocks),
      pkg = pkg,
    },
  ]
}

fn fatal(msg: string) {
  eprint("pkgdocsgate: ${msg}\n")
  exit(1)
}

fn timeoutMs(): int {
  let raw = envOr(timeoutEnvVar, "")
  if (len(raw) == 0) {
    return defaultTimeoutS * 1000
  }
  let n = parseInt(raw) catch _ {
    eprint("pkgdocsgate: ${timeoutEnvVar}='${raw}' is not a number\n")
    return defaultTimeoutS * 1000
  }
  if (n < 1) {
    return 1000
  }
  if (n > maxTimeoutS) {
    return maxTimeoutS * 1000
  }
  return n * 1000
}

// One job's scratch project: `bit.json`/`bit.lock` declaring `pkg.name` (see
// this file's header) plus one entry per `pkg.deps` (`firstPartyDeps`), and
// the job's own source as `main.bit`. Nothing else — no sibling file lends
// it an import its own source did not declare.
fn writeJobProject(dir: string, pkg: PkgInfo, src: string) {
  mkdir(dir) catch e {
    fatal("cannot create ${dir}: ${e.message()}")
  }
  let deps = "\"${pkg.name}\": \"${pkg.absPath}\""
  let locks = "\"${pkg.name}\": {\"path\": \"${pkg.absPath}\", \"requires\": {}}"
  for d of pkg.deps {
    deps = "${deps}, \"${d.name}\": \"${d.path}\""
    locks = "${locks}, \"${d.name}\": {\"path\": \"${d.path}\", \"requires\": {}}"
  }
  let bitJson = "{\"name\": \"pkgdocsgate-check\", \"dependencies\": {${deps}}}\n"
  let bitLock = "{${locks}}\n"
  writeFile(join(dir, "bit.json"), bitJson) catch e {
    fatal("cannot write ${dir}/bit.json: ${e.message()}")
  }
  writeFile(join(dir, "bit.lock"), bitLock) catch e {
    fatal("cannot write ${dir}/bit.lock: ${e.message()}")
  }
  writeFile(join(dir, "main.bit"), src) catch e {
    fatal("cannot write ${dir}/main.bit: ${e.message()}")
  }
}

fn dropProject(dir: string) {
  for f of ["bit.json", "bit.lock", "main.bit"] {
    let p = join(dir, f)
    if (exists(p)) {
      remove(p) catch e {
        eprint("pkgdocsgate: warning: cannot remove ${p}: ${e.message()}\n")
      }
    }
  }
  if (exists(dir)) {
    remove(dir) catch e {
      eprint("pkgdocsgate: warning: cannot remove ${dir}: ${e.message()}\n")
    }
  }
}

// Runs `cmd` (already a full shell command line) as one bounded `/bin/sh`
// child with its output captured to `log` — same shape as
// `_tests_/bit/packagesgate.bit`'s own `runBounded`, since `osRunBounded`
// takes a script path and no argv (ABI.md §19).
fn runBounded(script: string, log: string, cmd: string, deadlineMs: int): int {
  writeFile(script, "#!/bin/sh\nexec >\"${log}\" 2>&1\n${cmd}\n") catch e {
    eprint("pkgdocsgate: cannot write ${script}: ${e.message()}\n")
    return rcSpawnFailed
  }
  if (fsChmod(script, 493) != 0) {
    eprint("pkgdocsgate: cannot make ${script} executable\n")
    fsRemove(script)
    return rcSpawnFailed
  }
  let r = osRunBounded(script, deadlineMs)
  fsRemove(script)
  return r
}

fn readLog(log: string): string {
  let text = readFile(log) catch _ {
    ""
  }
  fsRemove(log)
  return text
}

fn describeFailure(r: int): string {
  if (r == rcTimedOut) {
    return "TIMED OUT"
  }
  if (r <= rcSignalBase) {
    return "CRASHED — signal ${0 - r + rcSignalBase}"
  }
  if (r == rcSpawnFailed) {
    return "could not spawn"
  }
  return "exited ${r}"
}

fn jobLabel(j: Job): string {
  if (j.block == 0) {
    return j.page
  }
  return "${j.page} block #${j.block}"
}

// Checks one job in its own scratch project, `bit check` then (only if that
// passed) `bit fmt --check` — same two-verdict shape `docs.bit` runs against
// `docs/`.
fn runJob(cfg: Cfg, j: Job, idx: int, st: Stats): Stats {
  let out = st
  let dir = "/tmp/bit-pkgdocsgate-${j.pkg.name}-${now().ns}-${idx}"
  writeJobProject(dir, j.pkg, j.src)

  let checkLog = "${dir}.check.log"
  let checkCmd = "exec \"${cfg.bin}\" check \"${dir}\""
  let checkR = runBounded("${dir}.check.sh", checkLog, checkCmd, cfg.deadlineMs)
  if (checkR != 0) {
    out.failures = out.failures + 1
    let text = readLog(checkLog)
    eprint("\npkgdocsgate: FAIL ${jobLabel(j)} does not typecheck (${describeFailure(checkR)}):\n${text}\n--- module ---\n${j.src}\n")
    dropProject(dir)
    return out
  }
  fsRemove(checkLog)

  let fmtLog = "${dir}.fmt.log"
  let fmtCmd = "exec \"${cfg.bin}\" fmt --check \"${dir}\""
  let fmtR = runBounded("${dir}.fmt.sh", fmtLog, fmtCmd, cfg.deadlineMs)
  if (fmtR != 0) {
    out.fmtFailures = out.fmtFailures + 1
    let text = readLog(fmtLog)
    eprint("\npkgdocsgate: FAIL ${jobLabel(j)} is not canonically formatted (${describeFailure(fmtR)}):\n${text}\n--- module ---\n${j.src}\n")
    dropProject(dir)
    return out
  }
  fsRemove(fmtLog)

  dropProject(dir)
  return out
}

// `pkg` widened by `page`'s own `<!-- doctest: deps a b c -->` line, or
// `pkg` unchanged when the page carries no such line — an unknown name is a
// gate failure here (#6063's own acceptance), named against `page`.
fn pageDeps(cfg: Cfg, pkg: PkgInfo, page: string, md: string): PkgInfo {
  let names = parseDepsDirective(page, md)
  if (len(names) == 0) {
    return pkg
  }
  let resolved = resolveDeclaredDeps(cfg.pkgDir, pkg.name, names, pkg.deps)
  if (!resolved.ok) {
    fatal("${page}: ${resolved.message}")
  }
  return PkgInfo{ name = pkg.name, absPath = pkg.absPath, deps = resolved.deps }
}

// One page's contribution: read it, extract its blocks, queue and run its
// job(s). Split out of `main` to keep both functions under the complexity
// ceiling (spec/LINT.md) — the walk itself (which packages, which pages) and
// one page's own extract-and-check work are two different concerns.
fn processPage(cfg: Cfg, pkg: PkgInfo, page: string, st: Stats): Stats {
  let out = st
  out.pages = out.pages + 1
  let md = readFile(page) catch e {
    fatal("cannot read ${page}: ${e.message()}")
    ""
  }
  out = checkPageLinks(page, md, out)
  let blocks = extractBlocks(md)
  if (len(blocks) == 0) {
    return out
  }
  if (len(blocks) >= maxBlocksPerPage) {
    fatal("${page} hit the maxBlocksPerPage bound of ${maxBlocksPerPage}; blocks past it are silently unchecked")
  }
  out.pagesWithBlocks = out.pagesWithBlocks + 1
  out.totalBlocks = out.totalBlocks + len(blocks)
  let pagePkg = pageDeps(cfg, pkg, page, md)
  for j of jobsForPage(page, md, blocks, pagePkg) {
    out.jobs = out.jobs + 1
    out = runJob(cfg, j, out.nextIdx, out)
    out.nextIdx = out.nextIdx + 1
  }
  return out
}

// The floor and the final verdict, split out of `main` for the same
// complexity reason `processPage` above is.
fn reportResult(st: Stats, names: []string, pkgDir: string) {
  // A corpus that produced zero checkable blocks across every package is the
  // extractor silently finding nothing, not a legitimately empty corpus —
  // every package under `pkg/` today ships at least one real ```bit block in
  // its README or docs/.
  if (st.jobs == 0) {
    fatal("0 checkable block(s) across ${len(names)} package(s) under ${pkgDir} — the fence match broke, or every page lost its blocks")
  }
  if (st.failures != 0 || st.fmtFailures != 0 || st.linkFailures != 0) {
    eprint("pkgdocsgate: FAILED — ${st.failures} typecheck failure(s), ${st.fmtFailures} fmt failure(s), ${st.linkFailures} broken link(s) of ${st.jobs} job(s) and ${st.linksChecked} link(s) over ${st.pagesWithBlocks} page(s) in ${len(names)} package(s)\n")
    exit(1)
  }
  print("pkgdocsgate: ok — ${st.totalBlocks} block(s) over ${st.pagesWithBlocks} page(s), ${st.jobs} job(s) and ${st.linksChecked} link(s) checked across ${len(names)} package(s) under ${pkgDir}\n")
}

// A real, already-gated block (`pkg/toml/README.md`'s own "Usage" example,
// copied verbatim) that imports "toml" — nothing else in it matters to the
// three cases below beyond "it typechecks when 'toml' is a declared
// dependency, and fails E0045-class when it is not". A raw string: `${...}`
// inside must stay literal Bit source for the NESTED compiler to read, not
// be interpolated by this file's own.
const depsFixtureSrc: string = `import { readFile } from "std/fs"
import { tomlAsString, tomlAsTable, tomlParse } from "toml"

fn main(): ()! {
  let src = readFile("deploy.toml")?
  let root = unwrap(tomlAsTable(tomlParse(src)?))
  for e of root {
    match (tomlAsString(e.value)) {
      Some(s) => println("${e.key} = ${s}")
      None => {}
    }
  }
  return
}
`

// Same shape as `runJob`'s own `bit check` half, but never folded into a
// `Stats` — a self-test case's own pass/fail is asserted by its caller, not
// counted as a real corpus job.
fn runSelfCheckSrc(cfg: Cfg, pkg: PkgInfo, src: string, idx: int): int {
  let dir = "/tmp/bit-pkgdocsgate-selftest-${now().ns}-${idx}"
  writeJobProject(dir, pkg, src)
  let log = "${dir}.check.log"
  let cmd = "exec \"${cfg.bin}\" check \"${dir}\""
  let r = runBounded("${dir}.check.sh", log, cmd, cfg.deadlineMs)
  fsRemove(log)
  dropProject(dir)
  return r
}

// Proves the three behaviors #6063 lists, isolated from the real corpus
// scan: (1) a page whose scratch project declares an extra first-party dep
// (as `pageDeps` would build it from a `deps` directive) can import it, (2)
// the identical page WITHOUT that declared dep fails to typecheck, and (3) a
// directive naming a package that does not exist under `pkgDir` is rejected
// by `resolveDeclaredDeps` itself, with a message naming it. Returns false,
// having already reported which case misbehaved, rather than fataling
// mid-check — `main` decides what a self-test failure means for the gate.
fn runFixtureSelfTest(cfg: Cfg): bool {
  let webPath = join(cfg.pkgDir, "web")
  let tomlPath = join(cfg.pkgDir, "toml")
  let bare = PkgInfo{ name = "web", absPath = webPath, deps = []DepEntry(0) }
  let withToml = PkgInfo{
    name = bare.name, absPath = bare.absPath, deps = [DepEntry{ name = "toml", path = tomlPath }],
  }
  let ok = true

  let passR = runSelfCheckSrc(cfg, withToml, depsFixtureSrc, 0)
  if (passR != 0) {
    ok = false
    eprint("pkgdocsgate: SELFTEST FAIL 'guides page with a deps line imports its declared package' — expected pass, ${describeFailure(passR)}\n")
  } else {
    print("pkgdocsgate: SELFTEST ok — 'guides page with a deps line imports its declared package' passes\n")
  }

  let failR = runSelfCheckSrc(cfg, bare, depsFixtureSrc, 1)
  if (failR == 0) {
    ok = false
    eprint("pkgdocsgate: SELFTEST FAIL 'page importing an undeclared package' — expected a typecheck failure, got exit 0\n")
  } else {
    print("pkgdocsgate: SELFTEST ok — 'page importing an undeclared package' fails (${describeFailure(failR)})\n")
  }

  let unknown = resolveDeclaredDeps(
    cfg.pkgDir,
    "web",
    ["bit-pkgdocsgate-nonexistent"],
    []DepEntry(0),
  )
  if (unknown.ok) {
    ok = false
    eprint("pkgdocsgate: SELFTEST FAIL 'unknown dep name' — expected a gate failure, got a resolved dependency\n")
  } else {
    print("pkgdocsgate: SELFTEST ok — 'unknown dep name' fails: ${unknown.message}\n")
  }

  return ok
}

fn main() {
  let root = repoRoot()
  let bin = envOr("BIT_BIN", "${root}/bit-out/bin/bit")
  if (!exists(bin)) {
    fatal("compiler not found: ${bin} (set BIT_BIN)")
  }
  let pkgDir = "${root}/pkg"
  if (!isDir(pkgDir)) {
    fatal("not a directory: ${pkgDir}")
  }

  let names = packageNames(pkgDir)
  if (len(names) == 0) {
    print("pkgdocsgate: 0 package(s) under ${pkgDir} — nothing to check\n")
    return
  }

  let cfg = Cfg{ bin = bin, deadlineMs = timeoutMs(), pkgDir = pkgDir }

  if (!runFixtureSelfTest(cfg)) {
    fatal("fixture self-test failed — see SELFTEST FAIL line(s) above")
  }

  let st = zeroStats()
  for name of names {
    let pkgAbsPath = join(pkgDir, name)
    let deps = firstPartyDeps(pkgDir, pkgAbsPath, name, 1, []DepEntry(0))
    let pkg = PkgInfo{ name = name, absPath = pkgAbsPath, deps = deps }
    for page of packagePages(pkgDir, name) {
      st = processPage(cfg, pkg, page, st)
    }
  }

  reportResult(st, names, pkgDir)
}
