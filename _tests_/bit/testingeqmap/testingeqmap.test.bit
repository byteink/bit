// _tests_/bit/testingeqmap/testingeqmap.test.bit — demonstrates std/testing's
// eqMap/checkEqMap field-level diff (#4113): a map assertion names the
// differing key and shows only its got/want, rather than rendering both
// whole maps on one line.
//
// Lives in its own directory rather than _tests_/testproj/ (scripts/
// selfhost-difftests.sh's fixture) — see _tests_/bit/testrunfilter/'s header
// for why: that directory is read as a WHOLE PROJECT and its header pins a
// specific "two pass, two fail" count that adding tests here would silently
// change. This directory holds nothing else.
//
// NOT wired into any pass/fail sweep. "reports the differing value for a
// shared key", "reports a key missing from the got map" and "checkEqMap
// reports a value diff without stopping the run" are deliberately failing,
// to demonstrate the new rendering — run directly to see it:
//
//   bit test _tests_/bit/testingeqmap
import { checkDone, checkEqMap, eqMap } from "std/testing"

test "equal maps report no diff" {
  let got = map<string, int>{ "a": 1, "b": 2 }
  let want = map<string, int>{ "a": 1, "b": 2 }
  eqMap<string, int>(got, want, "scores")
}

test "reports the differing value for a shared key" {
  let got = map<string, int>{ "a": 1, "b": 99 }
  let want = map<string, int>{ "a": 1, "b": 2 }
  eqMap<string, int>(got, want, "scores")
}

test "reports a key missing from the got map" {
  let got = map<string, int>{ "a": 1, "c": 3 }
  let want = map<string, int>{ "a": 1, "b": 2 }
  eqMap<string, int>(got, want, "scores")
}

test "checkEqMap reports a value diff without stopping the run" {
  defer checkDone()
  let got = map<string, int>{ "a": 1, "b": 99 }
  let want = map<string, int>{ "a": 1, "b": 2 }
  checkEqMap<string, int>(got, want, "scores")
}
