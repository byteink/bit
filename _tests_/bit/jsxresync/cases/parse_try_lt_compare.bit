// run
// #6421: after a postfix `?`, a `<` is a comparison unless it opens a JSX
// `then` branch that parses completely and is followed by `:`. The ternary
// check used to parse `< b ...` as an element whose text children made the
// JSX resync replace the tokens after it, so `let v = g()? < b` failed with
// an E0021 at the next function, nowhere near the `?`. A bare identifier on
// the right is what triggered it (`<b` is an element start); `g()? < 3` never
// did. Each form below must print the comparison's value.
fn g(): i64! {
  return 1
}

fn lt(b: i64): bool! {
  let v = g()? < b
  return v
}

fn le(b: i64): bool! {
  let v = g()? <= b
  return v
}

fn ltLit(): bool! {
  let v = g()? < 3
  return v
}

fn gt(b: i64): bool! {
  let v = g()? > b
  return v
}

fn parenthesised(b: i64): bool! {
  let v = g()? < b
  return v
}

fn inCondition(b: i64): string! {
  if (g()? < b) {
    return "lt"
  }
  return "ge"
}

fn main() {
  println("${lt(3) catch false}")
  println("${lt(1) catch true}")
  println("${le(1) catch false}")
  println("${le(0) catch true}")
  println("${ltLit() catch false}")
  println("${gt(0) catch false}")
  println("${parenthesised(3) catch false}")
  println(inCondition(2) catch "err")
  println(inCondition(1) catch "err")
}
