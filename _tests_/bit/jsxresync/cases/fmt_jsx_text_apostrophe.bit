// #7380: an apostrophe in JSX text is prose, not a rune start. `bit fmt` must
// leave a statement ending in such an element exactly as written, with no
// semicolon appended after the closing tag.
import { render, elem, attr, text } from "../../../../pkg/web"

fn contraction(): string {
  return render(<a>don't</a>)
}

fn binding(): string {
  let x = <p>it's {text(contraction())} ok</p>
  return render(x)
}

fn nested(): string {
  return render(
    <ul>
      <li>can't</li>
      <li>won't</li>
    </ul>,
  )
}
