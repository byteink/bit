// _tests_/bit/stress/verdict.bit — the stress suite's corpus-integrity checks
// and final reporting, split out of `stress.bit` by #4623 to clear
// spec/LINT.md:186's 800-line E0200 ceiling (797 of 800, one edit from red).
//
// Sibling of `stress.bit` in the same directory module: no `import`, one
// shared scope, exactly like `fanout.bit`, `setup.bit` and `verify.bit`.
// A pure move — declaration order and every line below are unchanged.
//
// Everything here runs AFTER the corpus loop: `checkPartitionIntegrity` and
// `checkPolicyProofs` assert the run covered what it claimed to, `reportJudged`
// prints the inconclusive split, and `reportFinalVerdict` prints the one line
// the gate's exit status is read from.

// A SPLIT THAT SILENTLY DROPS A PROGRAM IS WORSE THAN NO SPLIT: `batch` is
// defined as "not exclusive", so between the two partitions every eligible
// name runs exactly once by construction, with no third bucket a typo could
// fall into - but a typo in `exclusiveNames()` that matches no real directory
// would move a program from `exclusive` to `batch` without failing anything,
// which is a real classification bug even though it drops no coverage. This
// is what catches THAT: an exact count, like `minRunnable`'s own reasoning,
// and skipped only when a debugging knob has already made `ran` mean
// something else.
fn checkPartitionIntegrity(partition: string, partial: bool, ran: int, eligibleCount: int) {
  if (partial) {
    return
  }
  if (partition == "exclusive" && ran != minExclusiveRunnable) {
    die(
        "stress: partition 'exclusive' ran " +
        num(ran) +
        " programs, expected exactly " +
        num(minExclusiveRunnable) +
        " - exclusiveNames() and the corpus have drifted apart",
    )
  }
  if (partition == "batch" && ran != eligibleCount - minExclusiveRunnable) {
    die(
        "stress: partition 'batch' ran " +
        num(ran) +
        " programs, expected exactly " +
        num(eligibleCount - minExclusiveRunnable) +
        " - exclusiveNames() and the corpus have drifted apart",
    )
  }
}

// THE PLUMBING ASSERTION, and it is the one guard the deleted harness could not
// have. `collections != 0` cannot tell `BIT_GC=stress` from the default run
// repeated, so if the second wrapper's environment silently stopped arriving
// every program would still pass its own oracle while precise rooting was
// never exercised. Collecting at every safepoint costs two to five orders of
// magnitude, so a majority of the oracled programs must show it. Asserted over
// the corpus rather than per program because a clock-paced program legitimately
// cannot clear the margin (see `checkProgram`), and asserted as a SHARE rather
// than a count so a filtered run enforces it too. Returns whether it held.
fn checkPolicyProofs(proofs: int, oracled: int): bool {
  say(
      "stress: policy proofs " +
      num(proofs) +
      "/" +
      num(oracled) +
      " (stress count above " +
      num(stressRatio) +
      "x the default count)",
  )
  if (oracled >= minProofSample && proofs * minProofShare < oracled) {
    say("stress: FAIL - only " + num(proofs) + " of " + num(oracled) + " oracled programs collected")
    say("  meaningfully more under BIT_GC=stress than under the default policy. That is not a")
    say("  stress pass, it is the default run performed twice: the environment in the second")
    say("  wrapper is not reaching the child.")
    return false
  }
  return true
}

// #2401's denominator, printed on EVERY run, success or failure: a run that
// judged nothing must look different from one that judged everything. `ran`
// is programs that reached `checkProgram`; the returned `judged` is the ones
// a verdict was actually reached for - the two are equal unless the
// load-scaled deadline still elapsed somewhere.
fn reportJudged(ran: int, inconclusive: int): int {
  let judged = ran - inconclusive
  say(
      "stress: " +
      num(judged) +
      "/" +
      num(ran) +
      " program(s) judged (" +
      num(inconclusive) +
      " inconclusive)",
  )

  if (inconclusive != 0) {
    // An unjudged program is never a silent pass - the corpus-wide plumbing
    // proof above and the per-program oracle both need every program to have
    // actually run. But it is also not the same CLAIM as `failures`: this is
    // "the deadline elapsed even after scaling for observed load", not "the
    // program produced a wrong answer or would not build" - see runScript's own
    // TIMED OUT line, above, for the load average and scale at each occurrence.
    say(
        "stress: INCONCLUSIVE - " +
        num(inconclusive) +
        " of " +
        num(ran) +
        " program(s) did not finish within the load-scaled deadline. Host contention or a",
    )
    say("  genuine hang - re-run the named program(s) standalone on a quiet host to tell them apart.")
  }
  return judged
}

// The final tallies reportFinalVerdict prints, bundled because it is
// entirely a reporting function with nothing left to compute.
class Summary {
  ran: int,
  skipped: int,
  failures: int,
  inconclusive: int,
  judged: int,
}

fn reportFinalVerdict(s: Summary, partial: bool) {
  if (s.failures != 0 || s.inconclusive != 0) {
    say(
        "stress: FAIL - " +
        num(s.ran) +
        " programs run, " +
        num(s.skipped) +
        " skipped, " +
        num(s.failures) +
        " failed, " +
        num(s.inconclusive) +
        " inconclusive",
    )
    osExit(1)
  }
  let tag = "PASS"
  if (partial) {
    tag = "PASS (PARTIAL RUN - NOT A GATE)"
  }
  say(
      "stress: " +
      tag +
      " - " +
      num(s.ran) +
      " programs run, " +
      num(s.skipped) +
      " skipped, " +
      num(s.judged) +
      "/" +
      num(s.ran) +
      " judged",
  )
}
