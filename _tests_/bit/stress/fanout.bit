// _tests_/bit/stress/fanout.bit — the fanned-out `batch`-partition path (#3776).
//
// `checkProgram` (verify.bit) makes THREE `osRunBounded` calls per program
// (build, default-policy run, stress-policy run), and `bit_rt_os_run_bounded`
// is NOT re-entrant (`../gatefanout`'s header), so `stress.bit`'s `main` loop
// used to make all of them one program at a time — 21m19s serially for the
// ~70 non-exclusive programs at #3776's baseline (4be40962). This file reuses
// the shared `_tests_/bit/gatefanout` module the exact way `_tests_/bit/golden`
// and `_tests_/bit/examplesgate.bit` already do (#1901): stage every program's
// jobs (no execution yet), make the outer `osRunBounded` call(s), then grade
// every program in the SAME order every run — so the report is deterministic
// no matter which program's job happened to finish first inside `xargs -P`.
//
// Each program gets THREE jobs: compile in wave 1; both GC-policy runs in
// wave 2, since they only need the wave-1 binary and are independent of each
// other (two processes reading — never writing — the same file concurrently
// is safe; the wave barrier is what keeps a wave-2 exec from racing wave 1's
// still-open write fd on that same inode, the ETXTBSY hazard `gatefanout`'s
// header explains).
//
// The `test-stress-exclusive` partition (the 4 timing-sensitive names in
// `stress.bit`'s `exclusiveNames`) is NOT routed through here: it keeps
// running through `checkProgram` directly, one program at a time, because
// those programs' own pass/fail reads a real elapsed-time margin and cannot
// tolerate a neighbour on the same cores (`stress.bit`'s header on the
// exclusive/batch split). This file only ever sees the `batch` partition's
// correctness-only programs, selected by `stress.bit`'s `main`.
//
// PER-PROGRAM TIMEOUT OVERRIDES SURVIVE THE FAN-OUT, AT COARSER GRANULARITY.
// `gatefanout.FanCfg` carries exactly ONE `timeoutMs`, shared by every job's
// watchdog in the batch — there is no per-job override in that module, and
// this file does not add one (a shared module used by three harnesses is not
// the place to bolt on a fourth's special case). So the shared bound is the
// MAX of every program's own resolved timeout (`resolveTimeoutMs`,
// setup.bit) rather than the corpus default: `_tests_/stress/quicwire`'s
// `timeout-s` (1200s) becomes every OTHER program's ceiling too. That can
// only make a hung SHORT program's failure slower to report — it can never
// fail a program that would otherwise have passed, since the per-job
// watchdog (`gatefanout.bit`'s `watchdogText`) still kills any ONE job
// independently once the shared ceiling elapses.
//
// The load probe (`verify.bit`'s `loadProbe`, #2401) runs ONCE PER WAVE, not
// once for the whole batch (#5124 fixed the earlier one-probe design: a
// sample taken before ANY of the batch's own subprocesses exist is always
// idle-relative, no matter how loaded the box gets once they start — #5124
// measured host load 5.96 at a launch-time-only probe, then a sustained
// 100-113 for the run the single sample never saw). `runBatch` below stages
// and runs wave 1 (compile) first, in its own `osRunBounded` call, against a
// deadline scaled from a probe taken before wave 1 exists — there is no
// earlier point to sample from for the FIRST wave. It then re-probes before
// staging wave 2 (both GC-policy runs): by then wave 1's own compiles have
// been the batch's own load for the whole build phase, so that second
// sample is taken after the batch's own subprocesses were running, exactly
// the contract verify.bit:169 already promises for the non-batch path.
// Splitting the single driver call into one per wave costs nothing wave 1
// and wave 2 were not already paying: the ETXTBSY barrier between them
// (`gatefanout`'s header) already required wave 1 to fully finish before any
// wave-2 exec, so two sequential `osRunBounded` calls enforce that same
// barrier, just across a process boundary instead of inside one script.

import {
  FanCfg,
  Job,
  JobResult,
  ResampleCfg,
  cleanupJob,
  commitWave,
  gradeJob,
  newFanCfg,
  newFanCfgResampled,
  readRescale,
  runDriver,
  stageJob,
  wave1,
  wave2,
} from "../gatefanout"

// Everything known about one program before any job runs: `ok: false` means
// an immediate per-program failure found while planning (missing
// `.expected`, or an invalid `timeout-s`/`workers` file) — the caller counts
// that as a failure and stages no jobs for this program at all, the same
// shape `checkProgram`'s own early returns already use.
class StressJob {
  ok: bool,
  name: string,
  dir: string,
  expected: string,
  noCollect: bool,
  noAbandon: bool,
  waived: bool,
  waivedReason: string,
  statsRequired: bool,
  workers: int,
  timeoutMs: int,
}

class BatchResult { ran: int, failures: int, inconclusive: int, oracled: int, proofs: int }

// How far into its OWN run each wave-2 job's watchdog waits before taking its
// one mid-run load reading (#5124). Long enough that `xargs -P` has started
// every job in the wave and the kernel's runnable-queue sampling (what
// `uptime`'s load average is built from) has caught up; short against a
// 1200s-class base deadline either way.
const wave2ResampleAfterMs: int = 15000

// The `batch` partition's program list: `eligible` (already host-gated) minus
// the four `exclusiveNames()`, further narrowed by `BIT_STRESSGATE_ONLY` when
// set — the exact same two filters `stress.bit`'s old single loop applied
// inline, kept here so `main` can hand this file one plain list.
fn batchNames(eligible: []string, only: string): []string {
  let names = []string(0)
  let i = 0
  while (i < len(eligible)) {
    let name = eligible[i]
    i = i + 1
    if (len(only) > 0 && indexOfAt("," + only + ",", "," + name + ",", 0) < 0) {
      continue
    }
    if (isExclusiveProgram(name)) {
      continue
    }
    names = append(names, name)
  }
  return names
}

fn buildKey(idx: int): string { return "b${idx}" }
fn defaultKey(idx: int): string { return "d${idx}" }
fn stressKey(idx: int): string { return "s${idx}" }
fn binPath(scratch: string, idx: int): string { return "${scratch}/batch-bin-${idx}" }

// Presetup for one program: every check `checkProgram` performs before its
// first `osRunBounded` call, in the same order, with no execution yet.
fn planProgram(cx: Ctx, name: string, dir: string): StressJob {
  let bad = StressJob{
    ok: false, name: name, dir: dir, expected: "", noCollect: false, noAbandon: false,
    waived: false, waivedReason: "", statsRequired: false, workers: workersAbsent, timeoutMs: 0,
  }
  let effTimeoutMs = resolveTimeoutMs(cx, dir)
  if (effTimeoutMs == timeoutSInvalid) {
    say("stress '" + name + "': bad timeout-s file")
    return bad
  }
  let expected = readText(dir + "/" + name + ".expected")
  if (!expected.ok) {
    say("stress '" + name + "': cannot read " + dir + "/" + name + ".expected")
    return bad
  }
  let noCollect = readMarker(name, dir, "no-collect")
  let noAbandon = readMarker(name, dir, "no-abandon")
  let waived = readMarker(name, dir, "stress-waived")
  let noStats = readMarker(name, dir, "no-stats")
  let workers = workersOverride(dir)
  if (workers == workersInvalid) {
    say("stress '" + name + "': bad workers file")
    return bad
  }
  return StressJob{
    ok: true, name: name, dir: dir, expected: expected.body,
    noCollect: noCollect.present, noAbandon: noAbandon.present,
    waived: waived.present, waivedReason: waived.reason,
    statsRequired: !noStats.present, workers: workers, timeoutMs: effTimeoutMs,
  }
}

// `env -u BIT_GC -u BIT_GC_STATS <overrides> <bin>` — the one per-program
// environment knob `stageJob`'s fixed BIT_STDLIB/BIT_LIBBITRT export cannot
// express, since GC policy and BIT_WORKERS are set only for the RUN jobs
// (never the compile) and must reach an already-built binary directly, the
// same clean-slate contract `runOnce`'s own `unset BIT_GC BIT_GC_STATS`
// wrapper line gives the live path. `gcMode == ""` means the default policy:
// no `BIT_GC` assignment at all, exactly like `checkProgram`'s own `base`
// run.
fn runArgv(bin: string, gcMode: string, workers: int): []string {
  let argv = ["/usr/bin/env", "-u", "BIT_GC", "-u", "BIT_GC_STATS"]
  if (workers != workersAbsent) {
    argv = append(argv, "BIT_WORKERS=" + num(workers))
  }
  if (gcMode != "") {
    argv = append(argv, "BIT_GC=" + gcMode)
  }
  argv = append(argv, "BIT_GC_STATS=1")
  argv = append(argv, bin)
  return argv
}

// Stages one program's compile job (wave 1, its own `osRunBounded` call —
// see this file's header on why the batch is now two calls, not one).
// Exports BIT_STDLIB/BIT_LIBBITRT exactly like `buildProgram` does.
fn stageBuild(cfg: FanCfg, cx: Ctx, plan: StressJob, idx: int, bin: string) {
  stageJob(
    cfg,
    Job{
      key: buildKey(idx),
      wave: wave1,
      cwd: "",
      argv: [cx.compiler, "build", plan.dir, "-o", bin],
      withEnv: true,
    },
  )
  commitWave(cfg.scratch, buildKey(idx), wave1)
}

// Stages one program's two GC-policy runs (wave 2, its own `osRunBounded`
// call, staged only after wave 1 has fully finished). Neither exports the
// compiler's env (`withEnv: false`), matching `runOnce`'s own wrapper.
fn stageRuns(cfg: FanCfg, cx: Ctx, plan: StressJob, idx: int, bin: string) {
  stageJob(
    cfg,
    Job{
      key: defaultKey(idx),
      wave: wave2,
      cwd: "",
      argv: runArgv(bin, "", plan.workers),
      withEnv: false,
    },
  )
  commitWave(cfg.scratch, defaultKey(idx), wave2)

  let gcMode = "stress"
  if (plan.waived) {
    gcMode = "off"
  }
  stageJob(
    cfg,
    Job{
      key: stressKey(idx),
      wave: wave2,
      cwd: "",
      argv: runArgv(bin, gcMode, plan.workers),
      withEnv: false,
    },
  )
  commitWave(cfg.scratch, stressKey(idx), wave2)
}

// The graded equivalent of `runOnce`: turns a pre-run `JobResult` into an
// `Outcome` via the SAME `judgeRun` oracle (verify.bit) the live path uses,
// rather than a second copy of it.
fn gradeOutcome(
  name: string,
  label: string,
  jr: JobResult,
  expected: string,
  statsRequired: bool,
): Outcome {
  if (!jr.ran) {
    say(
        "stress '" +
        name +
        "' [" +
        label +
        "]: job never completed - nothing about this program was verified",
    )
    return Outcome{ ok: false, statsOk: false, collections: -1, abandoned: -1, timedOut: false }
  }
  let res = RunCapture{ code: jr.code, timedOut: jr.code == -2, outBody: jr.out, errBody: jr.err }
  return judgeRun(name, label, res, expected, statsRequired)
}

// Grades one already-run program: build, then both policy runs, then the
// Parses a `readRescale` line ("<scale> <load>", gatefanout.bit's
// `watchdogText`). `ok: false` covers both "never resampled" (empty string:
// the job finished before its warmup window, or its cfg had resampling
// disabled) and a malformed line — neither is worth reporting.
fn parseRescale(raw: string): (bool, int, string) {
  if (len(raw) == 0) {
    return false, 1, ""
  }
  let sp = indexOfAt(raw, " ", 0)
  if (sp < 0) {
    return false, 1, ""
  }
  let scale = parseIntStrict(raw[0:sp])
  if (scale < 1) {
    return false, 1, ""
  }
  return true, scale, trim(raw[sp + 1:])
}

// Prints the mid-run reading a job's own watchdog took (#5124), but only
// when it actually widened the deadline (`scale > 1`) — a quiet box stays
// quiet, exactly like `runScript`'s own "TIMED OUT" line only fires when it
// matters.
fn reportRescale(scratch: string, name: string, label: string, key: string) {
  let (ok, scale, loadText) = parseRescale(readRescale(scratch, key))
  if (ok && scale > 1) {
    say(
        "stress '" +
        name +
        "' [" +
        label +
        "]: deadline rescaled to x" +
        num(scale) +
        " (host load " +
        loadText +
        ", sampled mid-run)",
    )
  }
}

// Grades one already-run program: build, then both policy runs, then the
// shared `judgeVerdict` oracle — the batch counterpart of `checkProgram`.
// `buildScratch`/`runScratch` are separate because wave 1 and wave 2 now run
// as two separate `osRunBounded` calls, each staged into its own scratch
// subdir (this file's header).
fn gradeOne(buildScratch: string, runScratch: string, plan: StressJob, idx: int): Verdict {
  let br = gradeJob(buildScratch, buildKey(idx))
  if (!br.ran || br.code != 0) {
    if (!br.ran) {
      say("stress '" + plan.name + "' [compile]: job never completed")
    } else {
      say("stress '" + plan.name + "' [compile]: " + runMsg(br.code))
      say(trim(br.err))
    }
    return badVerdict(br.ran && br.code == -2)
  }

  reportRescale(runScratch, plan.name, "default", defaultKey(idx))
  let first = gradeOutcome(
    plan.name,
    "default",
    gradeJob(runScratch, defaultKey(idx)),
    plan.expected,
    plan.statsRequired,
  )
  if (!first.ok) {
    return badVerdict(first.timedOut)
  }

  let label = "BIT_GC=stress"
  if (plan.waived) {
    say("stress '" + plan.name + "': STRESS-WAIVED, running BIT_GC=off instead:")
    say("  " + plan.waivedReason)
    label = "BIT_GC=off (waived)"
  }
  reportRescale(runScratch, plan.name, label, stressKey(idx))
  let second = gradeOutcome(
    plan.name,
    label,
    gradeJob(runScratch, stressKey(idx)),
    plan.expected,
    plan.statsRequired,
  )
  if (!second.ok) {
    return badVerdict(second.timedOut)
  }

  let m = JudgeMarkers{ noCollect: plan.noCollect, noAbandon: plan.noAbandon, waived: plan.waived }
  return judgeVerdict(plan.name, label, m, first, second)
}

// Grades every planned program in order and folds their Verdicts into the
// same corpus-wide counts `stress.bit`'s `main` already tracks for the
// serial path. An immediate-fail plan (`ok: false`) counts as `ran` and
// `failed` with no jobs to grade, matching `main`'s own pre-#3776 accounting.
fn gradeBatch(
  buildScratch: string,
  runScratch: string,
  plans: []StressJob,
  bins: []string,
): BatchResult {
  let ran = 0
  let failures = 0
  let inconclusive = 0
  let oracled = 0
  let proofs = 0
  let i = 0
  while (i < len(plans)) {
    ran = ran + 1
    if (!plans[i].ok) {
      failures = failures + 1
      i = i + 1
      continue
    }
    let v = gradeOne(buildScratch, runScratch, plans[i], i)
    failures = failures + v.failed
    inconclusive = inconclusive + v.inconclusive
    if (v.oracled) {
      oracled = oracled + 1
    }
    if (v.proved) {
      proofs = proofs + 1
    }
    fsRemove(bins[i])
    cleanupJob(buildScratch, buildKey(i))
    cleanupJob(runScratch, defaultKey(i))
    cleanupJob(runScratch, stressKey(i))
    i = i + 1
  }
  return BatchResult{
    ran: ran,
    failures: failures,
    inconclusive: inconclusive,
    oracled: oracled,
    proofs: proofs,
  }
}

// Plans every `names[i]`, and returns the shared batch timeout: the MAX of
// every valid plan's own resolved timeout and `cx.timeoutMs` (see this
// file's header on why one shared ceiling is correct, just coarser).
fn planAll(cx: Ctx, corpus: string, names: []string): []StressJob {
  let plans = []StressJob(0)
  let i = 0
  while (i < len(names)) {
    let dir = corpus + "/" + names[i]
    plans = append(plans, planProgram(cx, names[i], dir))
    i = i + 1
  }
  return plans
}

fn maxTimeoutMs(cx: Ctx, plans: []StressJob): int {
  let maxMs = cx.timeoutMs
  let i = 0
  while (i < len(plans)) {
    if (plans[i].ok && plans[i].timeoutMs > maxMs) {
      maxMs = plans[i].timeoutMs
    }
    i = i + 1
  }
  return maxMs
}

// Stages every plan's wave-1 compile job (scripts on disk, nothing run
// yet), each binary path built from `binScratch` rather than `cfg.scratch`
// so the artifact survives into wave 2 regardless of which scratch subdir
// wave 1's own job scripts lived in. Returns each program's own
// compiled-binary path (or "" for a plan that failed before staging).
fn stageAllBuilds(cfg: FanCfg, cx: Ctx, plans: []StressJob, binScratch: string): []string {
  let bins = []string(0)
  let i = 0
  while (i < len(plans)) {
    if (plans[i].ok) {
      let bin = binPath(binScratch, i)
      bins = append(bins, bin)
      stageBuild(cfg, cx, plans[i], i, bin)
    } else {
      bins = append(bins, "")
    }
    i = i + 1
  }
  return bins
}

// Stages every plan's wave-2 run jobs against the binaries `stageAllBuilds`
// already produced.
fn stageAllRuns(cfg: FanCfg, cx: Ctx, plans: []StressJob, bins: []string) {
  let i = 0
  while (i < len(plans)) {
    if (plans[i].ok) {
      stageRuns(cfg, cx, plans[i], i, bins[i])
    }
    i = i + 1
  }
}

fn scaledDeadlineMs(baseMs: int, scale: int): int {
  let ms = baseMs * scale
  if (ms > clampTimeoutMs) {
    ms = clampTimeoutMs
  }
  return ms
}

fn sayWaveDeadline(label: string, effMs: int, baseMs: int, probe: LoadProbe) {
  say(
      "stress: " +
      label +
      " timeout " +
      num(effMs / 1000) +
      "s (base " +
      num(baseMs / 1000) +
      "s x" +
      num(probe.scale) +
      " load scale; host load average " +
      probe.text +
      " at " +
      label +
      " launch)",
  )
}

// Runs the `batch` partition's whole corpus through TWO `gatefanout`
// batches, one per wave (this file's header explains why one shared,
// launch-time probe cannot see the batch's own load, and why the fix is a
// second probe rather than a bigger constant, #5124). Plan every program,
// stage and run wave 1 (compile) against a deadline scaled from load
// sampled before wave 1, then stage and run wave 2 (both GC-policy runs)
// against a deadline scaled from load re-sampled after wave 1's own
// compiles have been driving the box — then grade everything back in
// order. Mirrors `_tests_/bit/examplesgate.bit`'s `runAll` in shape, just
// two waves instead of one call.
fn runBatch(cx: Ctx, corpus: string, names: []string): BatchResult {
  let plans = planAll(cx, corpus, names)
  let baseMs = maxTimeoutMs(cx, plans)

  let scratch = cx.scratch + "/batch"
  if (fsMkdir(scratch) != 0) {
    die("cannot create batch scratch dir " + scratch)
  }
  let buildScratch = scratch + "/w1"
  if (fsMkdir(buildScratch) != 0) {
    die("cannot create batch scratch dir " + buildScratch)
  }
  let runScratch = scratch + "/w2"
  if (fsMkdir(runScratch) != 0) {
    die("cannot create batch scratch dir " + runScratch)
  }

  let probe1 = loadProbe(cx)
  let buildMs = scaledDeadlineMs(baseMs, probe1.scale)
  sayWaveDeadline("wave 1 (build)", buildMs, baseMs, probe1)
  let cfg1 = newFanCfg(buildScratch, buildMs, cx.stdlib, cx.libbitrt)
  let bins = stageAllBuilds(cfg1, cx, plans, scratch)
  runDriver(buildScratch, 3 * len(plans) * buildMs + 60000)

  let probe2 = loadProbe(cx)
  let runMs = scaledDeadlineMs(baseMs, probe2.scale)
  sayWaveDeadline("wave 2 (run)", runMs, baseMs, probe2)
  // Wave 2's own jobs are the ones #5124 measured being killed (the batch's
  // heaviest load, from 166 concurrent GC=stress runs, does not exist until
  // THIS wave starts, so even this fresh `probe2` cannot see it). Each job's
  // OWN watchdog re-samples `wave2ResampleAfterMs` into its own run and may
  // widen its remaining budget up to `loadScaleCap`x — see
  // `newFanCfgResampled` (gatefanout.bit). The outer driver bound must cover
  // that worst case, not just `runMs`.
  let cfg2 = newFanCfgResampled(
    runScratch, runMs, cx.stdlib, cx.libbitrt,
    ResampleCfg{ afterMs: wave2ResampleAfterMs, scaleCap: loadScaleCap },
  )
  stageAllRuns(cfg2, cx, plans, bins)
  let worstJobMs = scaledDeadlineMs(baseMs, loadScaleCap)
  runDriver(runScratch, 3 * len(plans) * worstJobMs + 60000)

  let result = gradeBatch(buildScratch, runScratch, plans, bins)
  fsRemove(buildScratch)
  fsRemove(runScratch)
  fsRemove(scratch)
  return result
}
