// String helpers and per-run setup for the stress harness (#2867 directory
// module: sibling of stress.bit and verify.bit, one scope, no import between
// them). stress.bit keeps the corpus census, the exclusive/batch partition,
// Ctx, and main; verify.bit keeps the per-program build/run/verdict
// machinery main calls into. This file holds what neither of those needs to
// see directly: string primitives single-file mode has no prelude for, and
// the target/timeout/private-compiler setup main performs once before the
// corpus loop.

// --- small string helpers (single-file mode has no prelude, no std/*) -------

fn indexOfAt(hay: string, needle: string, at: int): int {
  let n = len(needle)
  if (n == 0) {
    return at
  }
  let i = at
  while (i + n <= len(hay)) {
    let j = 0
    while (j < n && hay[i + j] == needle[j]) {
      j = j + 1
    }
    if (j == n) {
      return i
    }
    i = i + 1
  }
  return -1
}

fn isWsByte(c: u8): bool {
  return c == 32 || c == 9 || c == 13 || c == 10
}

fn trim(s: string): string {
  let a = 0
  let b = len(s)
  while (a < b && isWsByte(s[a])) {
    a = a + 1
  }
  while (b > a && isWsByte(s[b - 1])) {
    b = b - 1
  }
  return s[a:b]
}

fn lessStr(a: string, b: string): bool {
  let n = len(a)
  if (len(b) < n) {
    n = len(b)
  }
  let i = 0
  while (i < n) {
    if (a[i] != b[i]) {
      return a[i] < b[i]
    }
    i = i + 1
  }
  return len(a) < len(b)
}

// `fsListDir` returns entries NUL-separated: NUL is the one byte a POSIX
// filename cannot contain, so unlike a newline it can never appear inside a name.
fn splitNul(raw: string): []string {
  let out = []string(0)
  let start = 0
  let i = 0
  while (i < len(raw)) {
    if (raw[i] == 0) {
      out = append(out, raw[start:i])
      start = i + 1
    }
    i = i + 1
  }
  return out
}

fn sortNames(names: []string): []string {
  let i = 1
  while (i < len(names)) {
    let j = i
    while (j > 0 && lessStr(names[j], names[j - 1])) {
      let tmp = names[j - 1]
      names[j - 1] = names[j]
      names[j] = tmp
      j = j - 1
    }
    i = i + 1
  }
  return names
}

// POSIX single-quoting: everything is literal inside '...', and an embedded
// quote closes, escapes and reopens. The one correct way to put a path this
// harness did not choose into a shell command.
fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) {
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

// --- setup ------------------------------------------------------------------

fn targetTriple(t: int): string {
  if (t == targetX64Linux) {
    return "x86_64-linux"
  }
  if (t == targetArm64Linux) {
    return "aarch64-linux"
  }
  if (t == targetArm64Macos) {
    return "aarch64-macos"
  }
  die("unknown host target ordinal " + num(t))
  return ""
}

fn timeoutMs(): int {
  let raw = trim(osEnv("BIT_TEST_TIMEOUT_S"))
  if (len(raw) == 0) {
    return defaultTimeoutS * 1000
  }
  let v = 0
  let i = 0
  while (i < len(raw)) {
    if (raw[i] < 48 || raw[i] > 57) {
      die("BIT_TEST_TIMEOUT_S is not a number: " + raw)
    }
    v = v * 10 + int(raw[i]) - 48
    i = i + 1
  }
  if (v == 0) {
    // docs/development.md documents 0 as "disable and block forever". `osRunBounded` has no
    // unbounded mode, so say what actually happens instead of pretending.
    say("stress: BIT_TEST_TIMEOUT_S=0 cannot disable the bound - osRunBounded clamps to 100")
    say("  minutes (ABI.md §19). Using 100 minutes.")
    return clampTimeoutMs
  }
  return v * 1000
}

// The general per-program override (#2695), read straight off disk rather
// than named in code: an optional `timeout-s` file beside the existing
// `no-collect`/`stress-waived` markers (`readMarker`, verify.bit), holding
// one decimal integer - the whole-program budget in seconds, trailing
// whitespace or a trailing newline allowed. Precedence, exactly per the
// header: a valid file wins over `BIT_TEST_TIMEOUT_S`, which wins over
// `defaultTimeoutS` - so the caller applies this ONLY when it returns a
// non-negative value, in place of (not layered onto) whatever `cx.timeoutMs`
// already resolved. A present-but-unparsable file is never silently
// ignored: it returns `timeoutSInvalid` so the caller can fail the one
// program rather than fall back to a bound nobody chose - a typo must not
// silently disable the deadline. Returns milliseconds, `timeoutSAbsent` when
// no file exists, or `timeoutSInvalid` when it exists but does not parse as
// a positive integer.
fn timeoutSOverrideMs(dir: string): int {
  let t = readText(dir + "/timeout-s")
  if (!t.ok) {
    return timeoutSAbsent
  }
  let v = parseIntStrict(trim(t.body))
  if (v <= 0) {
    return timeoutSInvalid
  }
  return v * 1000
}

// Folds `timeoutSOverrideMs` into the one effective bound `main`'s loop
// applies, so the caller carries only a single check (`timeoutSInvalid`)
// rather than the full precedence chain. Absent file: `cx.timeoutMs`
// (`defaultTimeoutS`, scaled by `BIT_TEST_TIMEOUT_S`/host load), unchanged.
// Present and valid: the file wins outright. Present and invalid: propagated
// as `timeoutSInvalid` so the caller fails the one program instead of
// guessing a bound.
fn resolveTimeoutMs(cx: Ctx, dir: string): int {
  let fileMs = timeoutSOverrideMs(dir)
  if (fileMs == timeoutSInvalid) {
    return timeoutSInvalid
  }
  if (fileMs == timeoutSAbsent) {
    return cx.timeoutMs
  }
  return fileMs
}

// The per-program worker-count override (#2583): a `workers` file beside
// `timeout-s`, holding one decimal integer - the exact value `checkProgram`
// (verify.bit) must force as `BIT_WORKERS` for BOTH of this program's runs.
// A program like `schedpreempt` measures whether the scheduler can force a
// single worker to hand itself back to another ready task; that claim is
// only isolated at exactly one worker - at two or more, the peer task can
// make real progress on its own OS thread with no preemption involved at
// all, and the oracle would pass for the wrong reason on any host (or any
// ambient shell) where `BIT_WORKERS` already happens to be >1. Same
// precedent as `timeoutSOverrideMs`: absent leaves the ambient environment
// untouched, and a present-but-unparsable file is never silently ignored.
fn workersOverride(dir: string): int {
  let t = readText(dir + "/workers")
  if (!t.ok) {
    return workersAbsent
  }
  let v = parseIntStrict(trim(t.body))
  if (v <= 0) {
    return workersInvalid
  }
  return v
}

// A PRIVATE COPY of the compiler, never `bit-out/bin/bit` itself: a concurrent
// `./make` rewrites that artifact in place and macOS SIGKILLs the exec,
// failing every case with no output at all (#1644).
fn privateCompiler(cx: Ctx, src: string): string {
  let dst = cx.scratch + "/bit"
  let r = runScript(
    cx,
    cx.scratch + "/copy.sh",
    "#!/bin/sh\nexec cp " + shQuote(src) + " " + shQuote(dst) + "\n",
  )
  if (r != 0) {
    die("cannot copy the compiler: " + runMsg(r))
  }
  if (fsChmod(dst, 493) != 0) {
    die("cannot chmod the compiler copy")
  }
  return dst
}
