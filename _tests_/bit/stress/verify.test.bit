import { output, RunResult } from "std/process"

fn diagnosticChild(mode: string): RunResult {
  return output(
    "/usr/bin/env",
    [
      "BIT_TEST_INDEX=" + osEnv("BIT_TEST_INDEX"),
      "BIT_STRESS_REPORT_CHILD=" + mode,
      osSelfExe(),
    ],
    60000,
  )
}

fn assertFailedReport(result: Outcome) {
  assert(!result.ok)
  assert(!result.statsOk)
  assert(result.collections == -1)
  assert(result.abandoned == -1)
  assert(!result.timedOut)
}

fn assertCapturedMarkers(result: RunResult) {
  assert(result.exitCode == 0)
  assert(!result.truncated)
  assert(indexOfAt(result.stdout, "stdout: STDOUT_FAILURE_MARKER", 0) >= 0)
  assert(indexOfAt(result.stdout, "stderr: STDERR_FAILURE_MARKER", 0) >= 0)
  assert(indexOfAt(result.stdout, "exited 1", 0) >= 0)
}

test "nonzero judge preserves both diagnostic streams" {
  if (osEnv("BIT_STRESS_REPORT_CHILD") == "judge") {
    let captured = RunCapture{
      code = 1,
      timedOut = false,
      outBody = "STDOUT_FAILURE_MARKER\n",
      errBody = "STDERR_FAILURE_MARKER\n",
    }
    assertFailedReport(judgeRun("synthetic", "default", captured, "", true))
    return
  }
  assertCapturedMarkers(diagnosticChild("judge"))
}

fn serialFailure(mode: string): Outcome {
  let scratch = osEnv("TMPDIR")
  if (scratch == "") {
    scratch = "/tmp/"
  }
  scratch = scratch + "t8081-report-" + num(timeUnixNs())
  assert(fsMkdir(scratch) == 0)
  let bin = scratch + "/child.sh"
  let body = "#!/bin/sh\nprintf 'STDOUT_FAILURE_MARKER\n'\nprintf 'STDERR_FAILURE_MARKER\n' >&2\n"
  if (mode == "missing-stdout") {
    body = body + "rm " + shQuote(scratch + "/synthetic.a.out") + "\n"
  }
  if (mode == "missing-stderr") {
    body = body + "rm " + shQuote(scratch + "/synthetic.a.err") + "\n"
  }
  assert(writeText(bin, body + "exit 1\n"))
  assert(fsChmod(bin, 493) == 0)
  let cx = Ctx{
    root = "", compiler = "", stdlib = "", libbitrt = "",
    scratch = scratch, timeoutMs = 10000, target = 0,
  }
  let pr = ProgramRun{ name = "synthetic", bin = bin, expected = "", statsRequired = true }
  let (result, _) = runOnce(cx, pr, "a", "default", "BIT_GC_STATS=1")
  let paths = [
    bin,
    scratch + "/synthetic.a.run.sh",
    scratch + "/synthetic.a.out",
    scratch + "/synthetic.a.err",
  ]
  for (let i = 0; i < len(paths); i = i + 1) {
    if (fsExists(paths[i])) {
      assert(fsRemove(paths[i]) == 0)
    }
  }
  assert(fsRemove(scratch) == 0)
  return result
}

test "nonzero serial child preserves both diagnostic streams" {
  if (osEnv("BIT_STRESS_REPORT_CHILD") == "serial") {
    assertFailedReport(serialFailure("serial"))
    return
  }
  assertCapturedMarkers(diagnosticChild("serial"))
}

test "nonzero serial missing captures preserve failure classification" {
  let mode = osEnv("BIT_STRESS_REPORT_CHILD")
  if (mode != "") {
    assertFailedReport(serialFailure(mode))
    return
  }
  let outMissing = diagnosticChild("missing-stdout")
  assert(outMissing.exitCode == 0)
  assert(indexOfAt(outMissing.stdout, "exited 1", 0) >= 0)
  let errMissing = diagnosticChild("missing-stderr")
  if (errMissing.exitCode != 0) {
    print(errMissing.stdout)
    print(errMissing.stderr)
  }
  assert(errMissing.exitCode == 0)
  assert(indexOfAt(errMissing.stdout, "could not read captured stderr", 0) >= 0)
}

test "timeout signal and spawn failure encodings stay distinct" {
  let codes = [-2, -109, -1]
  let messages = ["TIMED OUT", "KILLED BY SIGNAL 9", "SPAWN FAILED (fork/exec/wait error)"]
  for (let i = 0; i < len(codes); i = i + 1) {
    let captured = RunCapture{
      code = codes[i],
      timedOut = codes[i] == -2,
      outBody = "",
      errBody = "",
    }
    let result = judgeRun("synthetic", "default", captured, "", true)
    assert(!result.ok)
    assert(!result.statsOk)
    assert(result.collections == -1)
    assert(result.abandoned == -1)
    assert(result.timedOut == (codes[i] == -2))
    assert(runMsg(codes[i]) == messages[i])
  }
}
