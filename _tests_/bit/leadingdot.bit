// _tests_/bit/leadingdot.bit — #7873: a line break before a member dot does not
// end the statement (SPEC §7.1). The fixtures use the new spelling, which the
// pinned stage0 cannot parse, so they are NOT placed in _tests_/cases/: every
// scripts/selfhost-diff*.sh differential walks that corpus against the pinned
// stage0 (#5585) and a file the oracle rejects would score MISMATCH by
// construction. They are also built from strings rather than checked in as
// files: `bit fmt` joins a chain onto one line, so a checked-in leading-dot
// file could never satisfy test-fmt-testsbit. This drives the CLI directly.
//
// Checks, each a separate failure line:
//   ast      a leading-dot chain with comments, a blank line and a `?` dumps
//            the same `--dump-ast` as its one-line spelling
//   run      that chain runs and prints the sum
//   reject   `..`, `...`, `.5` at the start of a line still end the statement
//            (the error is the one the previous lexer gave), and a lone `.` line
//            continues and reports the missing member name
//   fmt      `bit fmt` turns the leading-dot spelling into the canonical text of
//            the one-line spelling and that output is `fmt --check` clean
//
// WIRED INTO `./make test` as `test-leadingdot` (tools/build/gatestable3.bit,
// tools/build/defs.bit).

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"
import { contains, parseInt, trimSpace } from "std/strings"

const defaultTimeoutS: int = 60
const maxTimeoutMs: int = 6000000

class Cc {
  bin: string,
  stdlib: string,
  libbitrt: string,
  scratch: string,
  failures: int,
}

class Ran {
  code: int,
  out: string,
  err: string,
}

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("leadingdot: ${name} is not set — refusing to guess.\n")
    exit(2)
  }
  return v
}

fn timeoutMs(): int {
  let raw = trimSpace(envOr("BIT_TEST_TIMEOUT_S", ""))
  if (raw == "") {
    return defaultTimeoutS * 1000
  }
  let s = parseInt(raw) catch _ {
    return defaultTimeoutS * 1000
  }
  if (s <= 0 || s * 1000 > maxTimeoutMs) {
    return maxTimeoutMs
  }
  return s * 1000
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

// `exit()` does not run pending defers — call this at every exit site.
fn teardown(scratch: string) {
  let shPath = scratch + "/rm.sh"
  writeFile(shPath, "#!/bin/sh\nrm -rf ${shQuote(scratch)}\n") catch _ {
    return
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    return
  }
  osRunBounded(shPath, timeoutMs())
}

fn fatal(cc: Cc, msg: string) {
  eprint("leadingdot: ${msg}\n")
  teardown(cc.scratch)
  exit(2)
}

fn bad(cc: Cc, name: string, detail: string) {
  eprint("leadingdot: FAIL ${name}: ${detail}\n")
  cc.failures = cc.failures + 1
}

fn writeSrc(cc: Cc, file: string, src: string): string {
  let path = "${cc.scratch}/${file}"
  writeFile(path, src) catch e {
    fatal(cc, "cannot write ${path}: ${e.message()}")
  }
  return path
}

// Runs `bit <args>` with the compiler's environment exported, stdout and stderr
// captured separately under `key`.
fn bit(cc: Cc, key: string, args: string): Ran {
  let shPath = "${cc.scratch}/${key}.sh"
  let outPath = "${cc.scratch}/${key}.out"
  let errPath = "${cc.scratch}/${key}.err"
  let script = "#!/bin/sh\nBIT_STDLIB=${shQuote(cc.stdlib)}\nexport BIT_STDLIB\n" +
    "BIT_LIBBITRT=${shQuote(cc.libbitrt)}\nexport BIT_LIBBITRT\n" +
    "exec ${shQuote(cc.bin)} ${args} > ${shQuote(outPath)} 2> ${shQuote(errPath)}\n"
  writeFile(shPath, script) catch e {
    fatal(cc, "cannot write ${shPath}: ${e.message()}")
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    fatal(cc, "cannot chmod ${shPath}")
  }
  let code = osRunBounded(shPath, timeoutMs())
  let out = readFile(outPath) catch _ {
    ""
  }
  let err = readFile(errPath) catch _ {
    ""
  }
  return Ran{ code = code, out = out, err = err }
}

// The chain under test: comments of every kind, a blank line, and a `?` link.
fn chainSrc(): string {
  return "class Box {\n" +
    "  n: int\n" +
    "  add(k: int): Box {\n" +
    "    return Box{ n = this.n + k }\n" +
    "  }\n" +
    "  get(): int! {\n" +
    "    return this.n\n" +
    "  }\n" +
    "}\n\n" +
    "fn total(b: Box): int! {\n" +
    "  let r = b\n" +
    "    .add(1) // a trailing comment\n" +
    "    // a full-line comment between two links\n" +
    "    .add(2) /* a block comment */ .add(3)\n\n" +
    "    .get()?\n" +
    "  return r\n" +
    "}\n\n" +
    "fn main(): ()! {\n" +
    "  println(\"\${total(Box{ n = 10 })?}\")\n" +
    "  return\n" +
    "}\n"
}

fn flatSrc(): string {
  return "class Box {\n" +
    "  n: int\n" +
    "  add(k: int): Box {\n" +
    "    return Box{ n = this.n + k }\n" +
    "  }\n" +
    "  get(): int! {\n" +
    "    return this.n\n" +
    "  }\n" +
    "}\n\n" +
    "fn total(b: Box): int! {\n" +
    "  let r = b.add(1).add(2).add(3).get()?\n" +
    "  return r\n" +
    "}\n\n" +
    "fn main(): ()! {\n" +
    "  println(\"\${total(Box{ n = 10 })?}\")\n" +
    "  return\n" +
    "}\n"
}

fn checkAst(cc: Cc) {
  let a = bit(cc, "ast-lead", "--dump-ast ${shQuote(writeSrc(cc, "lead.bit", chainSrc()))}")
  let b = bit(cc, "ast-flat", "--dump-ast ${shQuote(writeSrc(cc, "flat.bit", flatSrc()))}")
  if (a.code != 0 || b.code != 0) {
    bad(cc, "ast", "--dump-ast exited ${a.code} / ${b.code}\n  ${a.err}\n  ${b.err}")
    return
  }
  if (!contains(a.out, "(member ")) {
    bad(cc, "ast", "the dump holds no member node, so the equality below proves nothing")
  }
  if (a.out != b.out) {
    bad(cc, "ast", "leading-dot dump differs from the one-line dump\n  ${a.out}\n  ${b.out}")
  }
}

fn checkRun(cc: Cc) {
  let r = bit(cc, "run", "run ${shQuote(cc.scratch + "/lead.bit")}")
  if (r.code != 0 || r.out != "16\n") {
    bad(cc, "run", "exit ${r.code}, want 16\n  stdout: ${r.out}  stderr: ${r.err}")
  }
}

// `src` must fail `bit check` with `want` in the diagnostics.
fn checkReject(cc: Cc, name: string, src: string, want: string) {
  let path = writeSrc(cc, "${name}.bit", src)
  let r = bit(cc, name, "check ${shQuote(path)}")
  if (r.code == 0 || !contains(r.err, want)) {
    bad(cc, name, "want a rejection naming \"${want}\", got exit ${r.code}\n  ${r.err}")
  }
}

fn checkRejects(cc: Cc) {
  let head = "fn f(...xs: []int): int {\n  return 0\n}\nfn main() {\n  let a = f(1)\n"
  checkReject(
    cc,
    "dotdot",
    "fn main() {\n  let a = 1\n  ..\n}\n",
    "expected an expression, found '.'",
  )
  checkReject(cc, "ellipsis", head + "  ...a\n}\n", "expected an expression, found '...'")
  checkReject(cc, "float", "fn main() {\n  let a = 1\n  .5\n}\n", "E0065")
  checkReject(
    cc,
    "lone",
    "fn main() {\n  let a = 1\n  a\n  .\n}\n",
    "expected an identifier, found '}'",
  )
  checkReject(cc, "opencomment", "fn main() {\n  let a = 1\n  a /* open\n  .x\n}\n", "E0003")
}

// Formats `src` in place and returns the result.
fn formatted(cc: Cc, file: string, src: string): string {
  let path = writeSrc(cc, file, src)
  let r = bit(cc, "fmt-${file}", "fmt ${shQuote(path)}")
  if (r.code != 0) {
    bad(cc, "fmt", "bit fmt ${file} exited ${r.code}\n  ${r.err}")
  }
  return readFile(path) catch _ {
    ""
  }
}

fn checkFmt(cc: Cc) {
  let src = "fn main() {\n  let s = \"a b\"\n    .split(\" \")\n    .len()\n}\n"
  let flat = "fn main() {\n  let s = \"a b\".split(\" \").len()\n}\n"
  let got = formatted(cc, "fmt-lead.bit", src)
  let want = formatted(cc, "fmt-flat.bit", flat)
  if (got != want || got == "") {
    bad(
      cc,
      "fmt",
      "leading-dot input did not format to the one-line spelling\n  got:  ${got}\n  want: ${want}",
    )
  }
  let r = bit(cc, "fmt-check", "fmt --check ${shQuote(cc.scratch + "/fmt-lead.bit")}")
  if (r.code != 0) {
    bad(cc, "fmt", "the formatted output is not canonical: --check exited ${r.code}")
  }
}

fn main() {
  let scratch = envOr("TMPDIR", "/tmp") + "/bit-leadingdot-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("leadingdot: cannot create scratch directory ${scratch}: ${e.message()}\n")
    exit(2)
  }
  let cc = Cc{
    bin = requiredEnv("BIT_BIN"), stdlib = requiredEnv("BIT_STDLIB"),
    libbitrt = requiredEnv("BIT_LIBBITRT"), scratch = scratch, failures = 0,
  }
  checkAst(cc)
  checkRun(cc)
  checkRejects(cc)
  checkFmt(cc)
  teardown(scratch)
  if (cc.failures > 0) {
    eprint("leadingdot: FAIL — ${cc.failures} failure(s)\n")
    exit(1)
    return
  }
  print("PASS leadingdot: a leading-dot chain parses, runs and formats like its one-line spelling; `..`, `...`, `.5` and a lone `.` are unchanged\n")
}
