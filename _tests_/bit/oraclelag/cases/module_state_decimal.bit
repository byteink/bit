// run
// #6519: a module-level `decimal` cell is 16 inline bytes (two i64 words), not
// the 8 `moduleGlobalScalarSize` (compiler/lowerglobal.bit) used to give every
// prim it did not name. Each decimal sits next to `i64` cells on both sides, so
// a store that ran past the cell, or a cell sized short, would change a
// neighbour. `lit` ships as a static image (a literal initializer), `built` and
// `neg` are filled by a startup initializer before `main` (§11.11), and `late`
// is only ever assigned at run time.
fn build(): decimal {
  return 19.99
}

let before: i64 = 7
let lit: decimal = 1.25
let mid: i64 = 8
let built: decimal = build()
let after: i64 = 9
let neg: decimal = -2.5
let late: decimal
let tail: i64 = 10

fn show(tag: string) {
  println("${tag} lit=${lit} built=${built} neg=${neg} late=${late}")
  println("${tag} before=${before} mid=${mid} after=${after} tail=${tail}")
}

fn main() {
  show("start")
  lit = 123456789.123456
  built = 0.5
  neg = 0.25
  late = 4.75
  show("assigned")
  late += 1.0
  built += lit
  show("arith")
}
