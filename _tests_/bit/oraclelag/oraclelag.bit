// _tests_/bit/oraclelag — the `// run` fixtures the PINNED STAGE0 cannot
// compile, moved out of _tests_/cases/ by #6715 under the #5585 rule
// (_tests_/bit/golden/census.bit): a fixture exercising surface no released
// compiler has cannot live in the corpus every scripts/selfhost-diff*.sh
// differential sweeps against the pinned oracle (release 0.35.0).
//
// Why each of the first six scores MISMATCH there by construction: the oracle
// accepts the file at `check`, so the #5175 oracle-check probe in run_ir never
// fires, but it cannot BUILD it, and its `--dump-ir`/`--dump-ir-pre` exit 0
// with a partial dump. The tree prints every `.expected` exactly.
//
// The two run_strip_exit_header_* fixtures are the other shape: the oracle
// builds and runs them, but its optimized IR differs from the tree's. They
// exercise the #6719 strip-mining fix (stripRebindOuter in compiler/optstrip.bit),
// which the pinned 0.35.0 lacks: after the strip's exit the oracle reads the
// inner header's copy of a header-defined constant, defined in a block that does
// not dominate the exit, where the tree reads the outer header's. `--dump-ir`
// differs in exactly that one call operand; `--dump-ir-pre` is identical.
//
//   decimal_collections.bit            #6570  E0092 cannot lower this 'decimal' operation
//   decimal_compound_assign.bit        #6536  panic: gpSizeOpc: width 16 has no ARM64 GP load/store encoding
//   module_state_decimal.bit           #6519  the same gpSizeOpc panic
//   startup_array_cell.bit             #6516  E0092 a module cell holding a fixed array cannot take a startup initializer (#6480)
//   startup_array_cell_large.bit       #6672  the same E0092
//   startup_class_cell.bit             #6481  E0092 the collector does not scan module cells yet
//   run_strip_exit_header_const.bit    #6719  post-opt IR: the exit reads the inner header's const copy
//   run_strip_exit_header_param.bit    #6719  the same, the const passed as a call argument after the loop
//
// The fixtures sit in the `cases/` subdirectory so this directory module never
// loads them as source. For each one the harness does what golden.bit does for
// `// run`: `$BIT_BIN build <name> -o <scratch>` from `cases/`, then runs the
// binary and requires exit 0 and stdout byte-equal to `<stem>.expected`. It
// also runs `--dump-ir` and `--dump-ir-pre` and fails if either dies by
// signal (golden.bit's #2084 sweep, which these files leave behind).
//
// Retirement: a fixture moves back to _tests_/cases/ at the first stage0
// repin to a release that builds it (the two #6719 fixtures: the 0.36 repin,
// the first release carrying the fix); delete this directory with the last one
// and update `expectedCases`, census.bit's `c[dRun]` accordingly.
//
// WIRED INTO `./make test` as `test-oraclelag`
// (tools/build/gatestable2.bit, tools/build/defs.bit).
//
// Usage:
//   BIT_CASES_DIR=$PWD/_tests_/bit/oraclelag/cases BIT_BIN=$PWD/bit-out/bin/bit \
//   BIT_STDLIB=$PWD/stdlib BIT_LIBBITRT=<libbitrt.a> bit run _tests_/bit/oraclelag

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, readDir, mkdir } from "std/fs"
import { hasSuffix, parseInt, trimSpace } from "std/strings"

const expectedCases: int = 8
const defaultTimeoutS: int = 60
const maxTimeoutMs: int = 6000000

// `osRunBounded`'s sentinel encoding (ABI.md §19): a child killed by signal S
// returns -(100 + S).
const rcTimedOut: int = 0 - 2
const rcSpawnFailed: int = 0 - 1
const rcSignalBase: int = 0 - 100

class Cc {
  bin: string,
  stdlib: string,
  libbitrt: string,
  casesDir: string,
  scratch: string,
  failures: int,
}

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("oraclelag: ${name} is not set — refusing to guess.\n")
    exit(2)
  }
  return v
}

fn timeoutMs(): int {
  let raw = trimSpace(envOr("BIT_TEST_TIMEOUT_S", ""))
  if (raw == "") {
    return defaultTimeoutS * 1000
  }
  let s = parseInt(raw) catch _ {
    return defaultTimeoutS * 1000
  }
  if (s <= 0 || s * 1000 > maxTimeoutMs) {
    return maxTimeoutMs
  }
  return s * 1000
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

// `exit()` does not run pending defers — call this at every exit site.
fn teardown(scratch: string) {
  let shPath = scratch + "/rm.sh"
  writeFile(shPath, "#!/bin/sh\nrm -rf ${shQuote(scratch)}\n") catch _ {
    return
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    return
  }
  osRunBounded(shPath, timeoutMs())
}

fn fatal(cc: Cc, msg: string) {
  eprint("oraclelag: ${msg}\n")
  teardown(cc.scratch)
  exit(2)
}

fn failCase(cc: Cc, name: string, what: string, detail: string) {
  eprint("oraclelag: FAIL ${name} (${what}): ${detail}\n")
  cc.failures = cc.failures + 1
}

class Ran {
  code: int,
  out: string,
  err: string,
}

// Runs `argv` from `cwd` with the compiler's environment exported, stdout and
// stderr captured separately under `key`.
fn runCmd(cc: Cc, cwd: string, key: string, argv: string): Ran {
  let shPath = "${cc.scratch}/${key}.sh"
  let outPath = "${cc.scratch}/${key}.out"
  let errPath = "${cc.scratch}/${key}.err"
  let script = "#!/bin/sh\ncd ${shQuote(cwd)} || exit 126\n" +
    "BIT_STDLIB=${shQuote(cc.stdlib)}\nexport BIT_STDLIB\n" +
    "BIT_LIBBITRT=${shQuote(cc.libbitrt)}\nexport BIT_LIBBITRT\n" +
    "exec ${argv} > ${shQuote(outPath)} 2> ${shQuote(errPath)}\n"
  writeFile(shPath, script) catch e {
    fatal(cc, "cannot write ${shPath}: ${e.message()}")
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    fatal(cc, "cannot chmod ${shPath}")
  }
  let code = osRunBounded(shPath, timeoutMs())
  let out = readFile(outPath) catch _ {
    ""
  }
  let err = readFile(errPath) catch _ {
    ""
  }
  return Ran{ code = code, out = out, err = err }
}

// A bounded child that never ran to a normal exit is a failure of its own.
fn survived(cc: Cc, name: string, what: string, r: Ran): bool {
  if (r.code == rcTimedOut) {
    failCase(cc, name, what, "TIMED OUT (raise BIT_TEST_TIMEOUT_S)")
    return false
  }
  if (r.code == rcSpawnFailed) {
    failCase(cc, name, what, "cannot launch the wrapper script")
    return false
  }
  if (r.code <= rcSignalBase) {
    failCase(cc, name, what, "CRASHED: killed by signal ${0 - r.code - 100}")
    return false
  }
  return true
}

fn checkDumps(cc: Cc, name: string, stem: string) {
  let flags = ["--dump-ir", "--dump-ir-pre"]
  for flag of flags {
    let r = runCmd(cc, cc.casesDir, "${stem}${flag}", "${shQuote(cc.bin)} ${flag} ${shQuote(name)}")
    let _ = survived(cc, name, "${flag} survives", r)
  }
}

fn checkRun(cc: Cc, name: string, stem: string) {
  let binPath = "${cc.scratch}/${stem}.bin"
  let b = runCmd(
    cc,
    cc.casesDir,
    "${stem}.build",
    "${shQuote(cc.bin)} build ${shQuote(name)} -o ${shQuote(binPath)}",
  )
  if (!survived(cc, name, "build", b)) {
    return
  }
  if (b.code != 0) {
    failCase(cc, name, "build", "compile failed with exit ${b.code}\n  stderr: ${b.err}")
    return
  }
  let r = runCmd(cc, cc.scratch, "${stem}.run", shQuote(binPath))
  if (!survived(cc, name, "run", r)) {
    return
  }
  if (r.code != 0) {
    failCase(cc, name, "run", "binary exited with ${r.code}\n  stderr: ${r.err}")
    return
  }
  let want = readFile("${cc.casesDir}/${stem}.expected") catch _ {
    ""
  }
  if (r.out != want) {
    failCase(
      cc,
      name,
      "run",
      "stdout differs from ${stem}.expected\n  want: ${want}\n  got:  ${r.out}",
    )
  }
}

fn has(xs: []string, x: string): bool {
  for v of xs {
    if (v == x) {
      return true
    }
  }
  return false
}

fn stemOf(name: string, suffix: string): string {
  return name[0:len(name) - len(suffix)]
}

// Every `.bit` needs its `.expected` and the reverse; returns the stems.
fn discover(cc: Cc): []string {
  let names = readDir(cc.casesDir) catch _ {
    fatal(cc, "cannot list ${cc.casesDir}")
    return []
  }
  let stems: []string = []
  for n of names {
    if (hasSuffix(n, ".bit")) {
      stems = append(stems, stemOf(n, ".bit"))
    }
    if (hasSuffix(n, ".expected") && !has(names, "${stemOf(n, ".expected")}.bit")) {
      failCase(cc, n, "orphan", "${n} has no ${stemOf(n, ".expected")}.bit")
    }
  }
  for s of stems {
    if (!has(names, "${s}.expected")) {
      failCase(cc, "${s}.bit", "orphan", "no ${s}.expected")
    }
  }
  return stems
}

fn main() {
  let bin = requiredEnv("BIT_BIN")
  let libbitrt = requiredEnv("BIT_LIBBITRT")
  let stdlib = requiredEnv("BIT_STDLIB")
  let casesDir = requiredEnv("BIT_CASES_DIR")

  let scratch = envOr("TMPDIR", "/tmp") + "/bit-oraclelag-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("oraclelag: cannot create scratch directory ${scratch}: ${e.message()}\n")
    exit(2)
  }
  let cc = Cc{
    bin = bin, stdlib = stdlib, libbitrt = libbitrt, casesDir = casesDir,
    scratch = scratch, failures = 0,
  }

  let stems = discover(cc)
  if (len(stems) != expectedCases) {
    failCase(
      cc,
      casesDir,
      "census",
      "${len(stems)} cases on disk, expectedCases is ${expectedCases}",
    )
  }
  for stem of stems {
    let name = "${stem}.bit"
    checkRun(cc, name, stem)
    checkDumps(cc, name, stem)
  }

  teardown(scratch)
  if (cc.failures > 0) {
    eprint("oraclelag: FAIL — ${cc.failures} failure(s) over ${len(stems)} cases\n")
    exit(1)
    return
  }
  print("PASS oraclelag: ${len(stems)} cases build, run to their .expected and survive --dump-ir/--dump-ir-pre\n")
}
