// `bit lint`'s process-exit-code contract (#1380), ported off the deleted harness `lintcmd`.
//
// The property under test: `bit lint`'s EXIT CODE is a faithful trichotomy over
// a real directory walk — 0 only when every walked `.bit` file is clean or
// covered by an override, 1 when a finding survived the overrides, 2 when the
// run could not be trusted (unknown flag, unreadable path, malformed or unknown
// directive). "Could not lint" must never degrade into "looks clean".
//
// None of that is reachable from inside the linting process: an exit code is
// observable only to a parent, and stdout and stderr are only distinguishable
// from outside. So this program builds a throwaway tree, execs the real
// `bit lint` against it through `/bin/sh`, and reads back the code and both
// streams. `compiler/lintcheck.bit` covers everything below that line (the
// directive reader, the rule, the renderers).
//
// Run it from the repository root:
//     ./bit-out/bin/bit run _tests_/bit/lintcmd.bit
// `BIT_SELF_EXE` overrides which `bit` is exercised; unset, the compiler
// under test is `<cwd>/bit-out/bin/bit`, resolved from a child's own `pwd`,
// not `std/fs`'s `cwd()` (#3502 — same independence reason as
// `_tests_/bit/rootnamecollision.bit`'s `resolveCwd`). `selfExe()` here is
// the throwaway binary `bit run` built, not the compiler that built it.
//
// Anti-vacuity, all of it load-bearing: every capture is asserted non-empty and
// matched against its POSITIVE needle before any absence check; the fixture is
// read back off disk before the first lint run; the directive table's length is
// asserted before the loop and its iteration count after it; and the final line
// prints how many checks actually ran, so a gate that stops checking is visible
// rather than green.
import { env, envOr, exit } from "std/os"
import { exists, mkdir, readFile, remove, walk, writeFile } from "std/fs"
import { contains, parseInt, repeat, split } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"
import { Json, jsonParse, jsonAsArray, jsonAsInt, jsonAsString, jsonGet } from "std/json"

// One `bit lint` invocation, as seen from outside it.
class Run { code: int, out: string, err: string }

// Assertion accounting. A class because Bit has no mutable module-level state,
// and the count is the anti-vacuity marker: an empty run must not read as pass.
class Tally { checks: int, failures: int }

// One row of the LINT.md §5.2 directive-error table.
class Directive { src: string, code: string, needle: string }

// How long any one child gets. The whole compiler corpus lints in ~70ms, so
// this only ever fires on a hang — and a hang is a failure, not a stall (#1637).
fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "300")) catch _ { 300 }
  if (s <= 0) {
    return 300000
  }
  return s * 1000
}

// Runs `script` through /bin/sh and returns its exit code. Negative returns are
// `osRunBounded`'s mechanism channel, never a program exit status, so each one
// is a named panic rather than a value any assertion could consume.
fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    fail newError("lintcmd: cannot make script executable: ${scriptPath}")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == -2) {
    panic("lintcmd: TIMED OUT after ${ms}ms running ${scriptPath}")
  }
  if (code == -1) {
    panic("lintcmd: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("lintcmd: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}

// The `bit` under test. `BIT_SELF_EXE` wins; otherwise the dev-tree build
// artifact relative to the working directory this program was started in,
// obtained by asking a child for its `pwd`. Never returns "" — a compiler this
// cannot find is a hard stop, not a skipped test.
fn bitBinary(scratch: string, ms: int): string! {
  let explicit = env("BIT_SELF_EXE")
  if (len(explicit) > 0) {
    if (!exists(explicit)) {
      fail newError("lintcmd: BIT_SELF_EXE=${explicit} does not exist")
    }
    return explicit
  }
  let cwdFile = "${scratch}/cwd.txt"
  let code = shell("${scratch}/pwd.sh", "#!/bin/sh\npwd > '${cwdFile}'\n", ms)?
  if (code != 0) {
    fail newError("lintcmd: could not read the working directory (exit ${code})")
  }
  let cwd = trimWs(readFile(cwdFile)?)
  let candidate = "${cwd}/bit-out/bin/bit"
  if (!exists(candidate)) {
    fail newError("lintcmd: no compiler at ${candidate}; run this from the repository root or set BIT_SELF_EXE")
  }
  return candidate
}

// The tree every case below lints. Write errors propagate: an unwritten fixture
// makes `bit lint .` exit 0 over an empty directory, which would silently
// satisfy most of this file's assertions.
fn makeFixture(root: string): ()! {
  mkdir(root)?
  mkdir("${root}/sub")?
  // 900 lines, no directive: one E0200 against the 800 default.
  writeFile("${root}/big.bit", "// a file over the default limit\n" + repeat("let x = 1\n", 899))?
  // The same size, with the override that freezes it there: no finding, and one
  // override in the accounting.
  writeFile("${root}/raised.bit",
    "// bit:lint max-file-lines=900 -- pre-dates lint\n" + repeat("let y = 2\n", 899))?
  writeFile("${root}/sub/small.bit", "let z = 3\n")?
  // Not a `.bit` file: the walk must not pick it up. It is 900 lines, so if the
  // extension filter ever breaks, this fixture fires rather than passing.
  writeFile("${root}/readme.txt", repeat("not bit\n", 900))?
}

// Reads the fixture back off disk. The deleted harness could take `writeFile`'s
// success for granted; here the write path is the same GC'd runtime under test,
// so the input set is confirmed to exist before anything is asserted about it.
fn verifyFixture(t: Tally, root: string): ()! {
  let want = ["${root}/big.bit", "${root}/raised.bit", "${root}/readme.txt", "${root}/sub/small.bit"]
  let got = walk(root)?
  check(t, len(got) == len(want), "fixture: walk found ${len(got)} files, want ${len(want)}")
  let i = 0
  while (i < len(want) && i < len(got)) {
    check(t, got[i] == want[i], "fixture: entry ${i} is ${got[i]}, want ${want[i]}")
    i = i + 1
  }
  let big = readFile("${root}/big.bit")?
  check(t, len(split(big, "\n")) == 901, "fixture: big.bit is not 900 lines")
}

// Runs `bit lint <args...>` with `root` as the working directory.
//
// The script always exits 0 and writes the real status to `code.txt`, so a
// missing `code.txt` is unmistakably "the lint never ran" rather than a status
// some assertion could mistake for a clean sheet. Stale captures are deleted
// first for the same reason: no case may read a previous case's output.
fn runLint(bit: string, root: string, capDir: string, args: []string, ms: int): Run! {
  let outPath = "${capDir}/out.txt"
  let errPath = "${capDir}/err.txt"
  let codePath = "${capDir}/code.txt"
  clear(outPath)
  clear(errPath)
  clear(codePath)

  let quoted = ""
  for a of args {
    quoted = quoted + " '" + a + "'"
  }
  let script = "#!/bin/sh\n" +
    "cd '${root}' || exit 0\n" +
    "'${bit}' lint${quoted} > '${outPath}' 2> '${errPath}'\n" +
    "echo $? > '${codePath}'\n" +
    "exit 0\n"
  let sh = shell("${capDir}/lint.sh", script, ms)?
  if (sh != 0) {
    fail newError("lintcmd: wrapper script exited ${sh}, which it never should")
  }
  if (!exists(codePath)) {
    fail newError("lintcmd: no exit code was recorded for `bit lint${quoted}` — the run never happened")
  }
  let code = parseInt(trimWs(readFile(codePath)?))?
  return Run{ code: code, out: readFile(outPath)?, err: readFile(errPath)? }
}

fn clear(path: string) {
  if (exists(path)) {
    remove(path) catch _ { return }
  }
}

// Records one assertion. Failures are named and the run continues, so a single
// invocation reports every broken expectation instead of only the first.
fn check(t: Tally, cond: bool, label: string) {
  t.checks = t.checks + 1
  if (!cond) {
    t.failures = t.failures + 1
    eprint("FAIL: ${label}\n")
  }
}

// `r` is a usable observation of a real run: a recorded status, and streams that
// are not silently empty. Every absence check in this file runs only after its
// case has passed this, because the empty string satisfies all of them.
fn checkRan(t: Tally, r: Run, label: string) {
  check(t, len(r.err) > 0, "${label}: stderr is empty — `bit lint` always prints a summary")
}

fn jsonField(o: Json, key: string): string {
  let f = jsonGet(o, key)
  if (isNone(f)) {
    return "<missing>"
  }
  return unwrapOr(jsonAsString(unwrap(f)), "<not-a-string>")
}

fn jsonInt(o: Json, key: string): int {
  let f = jsonGet(o, key)
  if (isNone(f)) {
    return -1
  }
  return unwrapOr(jsonAsInt(unwrap(f)), -1)
}

fn jsonHas(o: Json, key: string): bool {
  return isSome(jsonGet(o, key))
}

// exit 1 on a finding, exit 0 once an override covers it.
fn checkTrichotomy(t: Tally, bit: string, root: string, capDir: string, ms: int): ()! {
  // The whole tree: big.bit is over, raised.bit is covered by its override.
  let all = runLint(bit, root, capDir, ["."], ms)?
  checkRan(t, all, "whole tree")
  check(t, all.code == 1, "whole tree: exit ${all.code}, want 1")
  check(t, contains(all.err, "warning[E0200]"), "whole tree: no warning[E0200] on stderr")
  check(t, contains(all.err, "file is 900 lines, limit is 800"), "whole tree: finding message missing")
  // The hint must teach the form WITH the reason placeholder; without it, the
  // form it teaches would itself exit 2 on first use.
  check(t, contains(all.err, "max-file-lines=900 -- <reason>"), "whole tree: hint omits the reason placeholder")
  // Exactly one finding: raised.bit is the same size and must not fire.
  check(t, contains(all.err, "lint: 1 findings, 1 overrides active"), "whole tree: wrong summary line")
  // readme.txt is not a .bit file and must not be walked at all.
  check(t, !contains(all.err, "readme.txt"), "whole tree: readme.txt was walked")

  // A clean subtree still prints the summary, and exits 0.
  let sub = runLint(bit, root, capDir, ["sub"], ms)?
  checkRan(t, sub, "sub")
  check(t, sub.code == 0, "sub: exit ${sub.code}, want 0")
  check(t, contains(sub.err, "lint: 0 findings, 0 overrides active"), "sub: wrong summary line")

  // No path argument means `.`, so it must agree with the explicit form.
  let bare = runLint(bit, root, capDir, []string(0), ms)?
  checkRan(t, bare, "no path argument")
  check(t, bare.code == 1, "no path argument: exit ${bare.code}, want 1")
  check(t, contains(bare.err, "lint: 1 findings, 1 overrides active"), "no path argument: wrong summary line")

  // A single file names exactly that file.
  let one = runLint(bit, root, capDir, ["raised.bit"], ms)?
  checkRan(t, one, "single file")
  check(t, one.code == 0, "single file: exit ${one.code}, want 0")
  check(t, contains(one.err, "lint: 0 findings, 1 overrides active"), "single file: wrong summary line")
}

// --json goes to stdout in the `bit check --json` shape.
fn checkJson(t: Tally, bit: string, root: string, capDir: string, ms: int): ()! {
  let r = runLint(bit, root, capDir, ["--json", "."], ms)?
  checkRan(t, r, "--json")
  check(t, r.code == 1, "--json: exit ${r.code}, want 1")
  check(t, len(r.out) > 0, "--json: stdout is empty")
  // Parsing it is the assertion that matters: a consumer that cannot parse it is
  // the whole failure mode.
  let parsed = jsonParse(trimWs(r.out)) catch e {
    check(t, false, "--json: stdout does not parse: ${e.message()}")
    return
  }
  let arr = unwrapOr(jsonAsArray(parsed), []Json(0))
  check(t, len(arr) == 1, "--json: ${len(arr)} diagnostics, want 1")
  if (len(arr) == 1) {
    let d = arr[0]
    check(t, jsonField(d, "code") == "E0200", "--json: code is ${jsonField(d, "code")}")
    check(t, jsonField(d, "severity") == "warning", "--json: severity is ${jsonField(d, "severity")}")
    check(t, jsonField(d, "file") == "./big.bit", "--json: file is ${jsonField(d, "file")}")
    check(t, jsonHas(d, "message"), "--json: no message key")
    check(t, jsonHas(d, "hint"), "--json: no hint key")
    let range = jsonGet(d, "range")
    check(t, isSome(range), "--json: no range key")
    if (isSome(range)) {
      let start = jsonGet(unwrap(range), "start")
      check(t, isSome(start), "--json: range has no start")
      if (isSome(start)) {
        check(t, jsonInt(unwrap(start), "line") == 0, "--json: start.line is ${jsonInt(unwrap(start), "line")}")
        check(t, jsonInt(unwrap(start), "character") == 0,
          "--json: start.character is ${jsonInt(unwrap(start), "character")}")
      }
    }
  }
  // The summary stays on stderr so the JSON can be piped unfiltered.
  check(t, contains(r.err, "lint: 1 findings"), "--json: summary not on stderr")
  check(t, !contains(r.out, "lint:"), "--json: summary leaked onto stdout")
}

// --stats lists the overrides in force and reports no findings.
fn checkStats(t: Tally, bit: string, root: string, capDir: string, ms: int): ()! {
  let r = runLint(bit, root, capDir, ["--stats", "."], ms)?
  checkRan(t, r, "--stats")
  // Findings are suppressed, so the run is clean even though big.bit is over.
  check(t, r.code == 0, "--stats: exit ${r.code}, want 0")
  check(t, contains(r.out, "./raised.bit: max-file-lines=900"), "--stats: override not listed on stdout")
  // The count still covers every file walked, not only files with findings.
  check(t, contains(r.err, "lint: 0 findings, 1 overrides active"), "--stats: wrong summary line")
  check(t, !contains(r.err, "E0200"), "--stats: a finding was reported anyway")
}

// exit 2 on a usage error, an unreadable path, and each bad-directive class.
fn checkUntrusted(t: Tally, bit: string, root: string, capDir: string, ms: int): ()! {
  // Usage error: an unknown flag is never taken for a path.
  let flag = runLint(bit, root, capDir, ["--quiet", "."], ms)?
  checkRan(t, flag, "unknown flag")
  check(t, flag.code == 2, "unknown flag: exit ${flag.code}, want 2")
  check(t, contains(flag.err, "unknown flag '--quiet'"), "unknown flag: not named on stderr")

  // Unreadable path: named by the user and not read is a hole in the run.
  let missing = runLint(bit, root, capDir, ["no/such/path"], ms)?
  checkRan(t, missing, "missing path")
  check(t, missing.code == 2, "missing path: exit ${missing.code}, want 2")
  check(t, contains(missing.err, "no such file or directory"), "missing path: not reported on stderr")

  // Each of the four directive error classes (LINT.md §5.2), one at a time, and
  // each must take down the whole run — a directive that quietly does nothing is
  // how a lint rule dies.
  let cases = [
    Directive{ src: "// bit:lint max-file-lines 900 -- nope\n", code: "E0299", needle: "malformed lint directive" },
    Directive{ src: "// bit:lint max-file-lines=900\n", code: "E0299", needle: "has no reason" },
    Directive{ src: "// bit:lint max-file-lines=900 --   \n", code: "E0299", needle: "reason is empty" },
    Directive{ src: "// bit:lint max-fyle-lines=900 -- typo\n", code: "E0298", needle: "unknown lint rule" },
  ]
  check(t, len(cases) == 4, "directive table holds ${len(cases)} rows, want 4")
  let seen = 0
  let bad = "${root}/bad.bit"
  for c of cases {
    writeFile(bad, c.src)?
    let r = runLint(bit, root, capDir, ["."], ms)?
    checkRan(t, r, "directive ${c.code}/${c.needle}")
    check(t, r.code == 2, "directive ${c.code}/${c.needle}: exit ${r.code}, want 2")
    check(t, contains(r.err, c.code), "directive ${c.code}/${c.needle}: code not on stderr")
    check(t, contains(r.err, c.needle), "directive ${c.code}/${c.needle}: message not on stderr")
    // #3543: a bad directive is isolated to the file that has it — every OTHER
    // file's independently-computed finding still stands and is reported
    // ALONGSIDE the directive error, never suppressed by it. big.bit carries
    // no directive of its own, so its E0200 is the proof that isolation held.
    check(t, contains(r.err, "E0200"),
      "directive ${c.code}/${c.needle}: big.bit's finding was wrongly suppressed by bad.bit's directive error")
    seen = seen + 1
  }
  check(t, seen == 4, "directive loop ran ${seen} times, want 4")

  // And with every directive fixed, the same tree is back to exit 1.
  remove(bad)?
  let back = runLint(bit, root, capDir, ["."], ms)?
  checkRan(t, back, "directives removed")
  check(t, back.code == 1, "directives removed: exit ${back.code}, want 1")
}

// #2137/#2145/#2158: a well-formed `// bit:lint` directive found outside the
// file's leading comment block is now diagnosed (E0299, exit 2) instead of
// silently doing nothing. This is the behavioural proof, not just the hint
// text: the SAME directive that is a silent no-op at the span E0203's own
// hint points to (immediately above the function) is honoured once moved to
// the file's leading comment block — exercised against a directory the
// shared fixture never touches, so it cannot perturb `root`'s own counts.
fn checkDirectivePlacement(t: Tally, bit: string, scratch: string, capDir: string, ms: int): ()! {
  let place = "${scratch}/place"
  mkdir(place)?

  let deepFn = "fn deep(a: int): int {\n" +
    "  if (a > 0) { if (a > 1) { if (a > 2) { if (a > 3) { if (a > 4) { return 5 } } } } }\n" +
    "  return 0\n" +
    "}\n"

  // Placed exactly where the E0203 hint's own caret points: immediately
  // above the offending function. `const k = 1` stands in for "some earlier
  // declaration", which is all it takes to end the leading comment block.
  writeFile("${place}/misplaced.bit",
    "const k = 1\n\n" +
    "// bit:lint max-nesting=5 -- placed where the diagnostic points\n" +
    deepFn)?
  let a = runLint(bit, place, capDir, ["misplaced.bit"], ms)?
  checkRan(t, a, "directive placement: misplaced")
  check(t, a.code == 2, "directive placement: misplaced exit ${a.code}, want 2")
  check(t, contains(a.err, "E0299"), "directive placement: misplaced missing E0299")
  check(t, contains(a.err, "leading comment block"),
    "directive placement: misplaced error omits the placement rule")
  // The error replaces the finding, exactly like every other directive-error
  // class (§2.1) — never alongside it.
  check(t, !contains(a.err, "E0203"),
    "directive placement: misplaced must report the placement error INSTEAD of the finding")

  // The IDENTICAL directive text, moved to the file's leading comment block,
  // is honoured: 0 findings, 1 override active.
  writeFile("${place}/leading.bit",
    "// bit:lint max-nesting=5 -- placed in the file's leading comment block\n" +
    deepFn)?
  let b = runLint(bit, place, capDir, ["leading.bit"], ms)?
  checkRan(t, b, "directive placement: leading block")
  check(t, b.code == 0, "directive placement: leading block exit ${b.code}, want 0")
  check(t, contains(b.err, "lint: 0 findings, 1 overrides active"),
    "directive placement: leading block wrong summary")
}

// #2284/#4228: E0210 `unused-import` is module-scoped — sibling `.bit` files
// in a directory share one import namespace (compiler/project.bit's
// `SrcModule` contract; it is why #2121's E0042 "already imported" fires
// across sibling files at all). An import used only by a sibling file must
// not be reported unused, REGARDLESS of whether `bit lint` named the
// directory or one file inside it (#4228: the earlier cut, applying the
// module view only to a directory walk, is what let `bit lint
// runtime/root/linux/boot.bit` report every import used only by sibling
// bootstats.bit as unused). Own directory, isolated from `root`.
fn checkModuleScopedUnusedImport(t: Tally, bit: string, scratch: string, capDir: string, ms: int): ()! {
  let mod = "${scratch}/mod2file"
  mkdir(mod)?
  // `toUpper` is used only by the sibling main.bit; `trimSpace` is used
  // nowhere in the module and must still be reported.
  writeFile("${mod}/a.bit",
    "import { toUpper, trimSpace } from \"std/strings\"\n\n" +
    "fn greet(name: string): string {\n  return \"hi \" + name\n}\n")?
  writeFile("${mod}/main.bit",
    "fn main() {\n  print(toUpper(greet(\"bit\")) + \"\\n\")\n}\n")?

  // Naming the DIRECTORY sweeps in main.bit's usage: toUpper is genuinely
  // used, trimSpace genuinely is not.
  let dir = runLint(bit, mod, capDir, ["."], ms)?
  checkRan(t, dir, "module-scoped: directory")
  check(t, dir.code == 1, "module-scoped: directory exit ${dir.code}, want 1")
  check(t, !contains(dir.err, "'toUpper' is imported but never used"),
    "module-scoped: toUpper wrongly reported unused (used by sibling main.bit)")
  check(t, contains(dir.err, "'trimSpace' is imported but never used"),
    "module-scoped: trimSpace should still be reported (unused anywhere in the module)")

  // Naming a.bit EXPLICITLY must ALSO sweep in main.bit's usage now (#4228):
  // mod2file/ is a real, coherent module, so the view applies either way.
  // trimSpace is still genuinely dead and must still be reported.
  let solo = runLint(bit, mod, capDir, ["a.bit"], ms)?
  checkRan(t, solo, "module-scoped: single file")
  check(t, solo.code == 1, "module-scoped: single file exit ${solo.code}, want 1")
  check(t, !contains(solo.err, "'toUpper' is imported but never used"),
    "module-scoped: naming a.bit alone must still see main.bit's usage")
  check(t, contains(solo.err, "'trimSpace' is imported but never used"),
    "module-scoped: single file still reports the genuinely-unused import")
}

// #4228: the module view above must NOT apply when the directory is not one
// coherent module — two unrelated single-file programs sharing a directory,
// each with its own `fn main`, do not become one module just because a
// same-named import is used in one and dead in the other. `_tests_/cases/`
// is exactly this shape: `lint_unused_import.bit`'s genuinely-dead `foo`
// sits beside `lint_unused_import_nested_use.bit`'s genuinely-used `foo`.
fn checkModuleScopedUnusedImportIncoherentDir(t: Tally, bit: string, scratch: string, capDir: string, ms: int): ()! {
  let dir = "${scratch}/incoherentdir"
  mkdir(dir)?
  writeFile("${dir}/x.bit", "import { toUpper } from \"std/strings\"\n\nfn main() {}\n")?
  writeFile("${dir}/y.bit",
    "import { toUpper } from \"std/strings\"\n\n" +
    "fn main() {\n  print(toUpper(\"hi\") + \"\\n\")\n}\n")?

  let solo = runLint(bit, dir, capDir, ["x.bit"], ms)?
  checkRan(t, solo, "incoherent dir: single file")
  check(t, solo.code == 1, "incoherent dir: single file exit ${solo.code}, want 1")
  check(t, contains(solo.err, "'toUpper' is imported but never used"),
    "incoherent dir: x.bit's dead import must not be masked by unrelated y.bit's usage")
}

// #2438: `// bit:lint allow <CODE> -- <reason>` (spec/LINT.md §5.5) silences
// exactly the ONE finding on the line directly below it — a narrower tool
// than the file-scoped `disable` form `checkUntrusted` above already covers.
// Own directory, isolated from the shared `root` fixture so it cannot
// perturb `checkTrichotomy`'s exact counts. Split across two functions
// (this one and checkLineAllowEligibility) to stay inside the repo's own
// max-fn-lines/max-complexity limits, the same discipline `runAll`'s own
// header comment already follows.
fn checkLineAllow(t: Tally, bit: string, scratch: string, capDir: string, ms: int): ()! {
  let dir = "${scratch}/allow"
  mkdir(dir)?

  // An adequate reason directly above the call: the finding is gone, and the
  // suppression counts toward the summary the same as a file-scoped override.
  let good = "fn catchEdgeArgs(buf: []byte): int {\n" +
    "  // bit:lint allow E0214 -- buf is freshly allocated here and never escapes\n" +
    "  append(buf, 1)\n" +
    "  return len(buf)\n" +
    "}\n"
  writeFile("${dir}/good.bit", good)?
  let ok = runLint(bit, dir, capDir, ["good.bit"], ms)?
  checkRan(t, ok, "line-scoped allow: adequate reason")
  check(t, ok.code == 0, "line-scoped allow: adequate reason exit ${ok.code}, want 0")
  check(t, !contains(ok.err, "E0214"), "line-scoped allow: E0214 was not suppressed")
  check(t, contains(ok.err, "lint: 0 findings, 1 overrides active"),
    "line-scoped allow: wrong summary (must count the suppression)")

  // The identical override with a 1-character reason: DEFECTIVE, reported as
  // an ordinary finding (E0297) rather than the hard-error/exit-2 path, and
  // the E0214 it targeted must still stand — a broken override must not
  // silently make its target vanish.
  let bad = "fn catchEdgeArgs(buf: []byte): int {\n" +
    "  // bit:lint allow E0214 -- x\n" +
    "  append(buf, 1)\n" +
    "  return len(buf)\n" +
    "}\n"
  writeFile("${dir}/bad.bit", bad)?
  let noReason = runLint(bit, dir, capDir, ["bad.bit"], ms)?
  checkRan(t, noReason, "line-scoped allow: reasonless")
  check(t, noReason.code == 1, "line-scoped allow: reasonless exit ${noReason.code}, want 1")
  check(t, contains(noReason.err, "E0297"), "line-scoped allow: E0297 not reported")
  check(t, contains(noReason.err, "need at least 10"),
    "line-scoped allow: E0297 message missing the threshold")
  check(t, contains(noReason.err, "E0214"),
    "line-scoped allow: the original E0214 must still be reported")
  check(t, contains(noReason.err, "lint: 2 findings, 0 overrides active"),
    "line-scoped allow: reasonless wrong summary")

  checkLineAllowEligibility(t, bit, dir, capDir, ms)?
}

// The three edge cases around WHICH code an `allow` may name: a mismatched
// but otherwise valid code, a threshold rule's (ineligible), and a bare
// directive with no code at all. Split out of checkLineAllow (see its own
// header) purely to stay under this repo's own lint limits.
fn checkLineAllowEligibility(t: Tally, bit: string, dir: string, capDir: string, ms: int): ()! {
  // A mismatched but otherwise valid code (names a real, eligible rule that
  // just is not this finding's) is silently inert: E0214 stands, no E0297.
  let mismatch = "fn catchEdgeArgs(buf: []byte): int {\n" +
    "  // bit:lint allow E0213 -- names a real rule that is not this finding\n" +
    "  append(buf, 1)\n" +
    "  return len(buf)\n" +
    "}\n"
  writeFile("${dir}/mismatch.bit", mismatch)?
  let mm = runLint(bit, dir, capDir, ["mismatch.bit"], ms)?
  checkRan(t, mm, "line-scoped allow: code mismatch")
  check(t, mm.code == 1, "line-scoped allow: code mismatch exit ${mm.code}, want 1")
  check(t, contains(mm.err, "E0214"), "line-scoped allow: mismatch must not suppress E0214")
  check(t, !contains(mm.err, "E0297"), "line-scoped allow: a mismatched-but-valid allow is not a defect")

  // A threshold rule's code is not eligible for a per-finding override at all
  // (spec/LINT.md §5.5, preserving §5.2's "coarse on purpose" design) — that
  // must be a defect in its own right, not a silent no-op.
  let threshold = "fn catchEdgeArgs(buf: []byte): int {\n" +
    "  // bit:lint allow E0200 -- trying to escape a whole-file rule per line\n" +
    "  append(buf, 1)\n" +
    "  return len(buf)\n" +
    "}\n"
  writeFile("${dir}/threshold.bit", threshold)?
  let th = runLint(bit, dir, capDir, ["threshold.bit"], ms)?
  checkRan(t, th, "line-scoped allow: threshold rule")
  check(t, th.code == 1, "line-scoped allow: threshold rule exit ${th.code}, want 1")
  check(t, contains(th.err, "E0297"), "line-scoped allow: threshold rule must report E0297")
  check(t, contains(th.err, "cannot be overridden per finding"),
    "line-scoped allow: threshold rule message missing")

  // A bare `allow` with no code suppresses nothing and is not a defect
  // either (spec/LINT.md §5.5) — a deliberate escape hatch for a template or
  // placeholder comment.
  let bare = "fn catchEdgeArgs(buf: []byte): int {\n" +
    "  // bit:lint allow\n" +
    "  append(buf, 1)\n" +
    "  return len(buf)\n" +
    "}\n"
  writeFile("${dir}/bare.bit", bare)?
  let br = runLint(bit, dir, capDir, ["bare.bit"], ms)?
  checkRan(t, br, "line-scoped allow: bare")
  check(t, br.code == 1, "line-scoped allow: bare exit ${br.code}, want 1")
  check(t, contains(br.err, "E0214"), "line-scoped allow: bare must not suppress E0214")
  check(t, !contains(br.err, "E0297"), "line-scoped allow: a bare allow is not a defect")
  check(t, contains(br.err, "lint: 1 findings, 0 overrides active"),
    "line-scoped allow: bare wrong summary")
}

// #3093: E0214 built its diagnostic Span from the append() Call node's OWN
// `n.span` verbatim. Every node's span carries a `.file` the parser always
// stamps 0 (compiler/parser.bit's `leaf`/`spanOfKids`/`mkSpanNode`) — only a
// single-file caller, where file 0 IS the whole source, never noticed. In
// directory mode every E0214 finding landed on file 0's path — the
// alphabetically-first file walked — with byte offsets that were real, just
// applied to the WRONG file's text. `lintMaxParams`/`lintDeferInLoop` above
// already rebuild their Span from the `file` parameter instead of trusting a
// node's own; this is the same fix, in the one rule that had not made it.
//
// Two shapes, both real discriminators from the original report: a flat
// 2-file directory (offsets land inside the first file's own text, so the
// old bug produced a WRONG but plausible-looking line) and a 2-subdirectory
// nested walk with a short first file (offsets exceed its length, so
// `locate`'s EOF clamp collapsed every finding onto one identical line).
// `aclean.bit` is deliberately one line, short enough to trigger the clamp.
// Own directory, isolated from the shared `root` fixture.
fn checkAppendAliasingAttribution(t: Tally, bit: string, scratch: string, capDir: string, ms: int): ()! {
  let hitFn = "fn catchEdgeArgs(buf: []byte): int {\n" +
    "  append(buf, 1)\n" +
    "  return len(buf)\n" +
    "}\n"

  let flat = "${scratch}/attrib"
  mkdir(flat)?
  writeFile("${flat}/aclean.bit", "const k = 1\n")? // sorts first, clean
  writeFile("${flat}/bhit.bit", hitFn)? // sorts second, the one real hit

  let f = runLint(bit, flat, capDir, ["."], ms)?
  checkRan(t, f, "attribution: flat directory")
  check(t, f.code == 1, "attribution: flat directory exit ${f.code}, want 1")
  check(t, contains(f.err, "--> ./bhit.bit:2:3"),
    "attribution: finding must point at ./bhit.bit:2:3, not aclean.bit — got: ${f.err}")
  check(t, contains(f.err, "on parameter 'buf'"),
    "attribution: parameter name must be 'buf', which only exists in bhit.bit")
  check(t, !contains(f.err, "aclean.bit"),
    "attribution: aclean.bit must not appear anywhere in the output")

  let nested = "${scratch}/attribnested"
  mkdir(nested)?
  mkdir("${nested}/suba")?
  mkdir("${nested}/subb")?
  writeFile("${nested}/suba/aclean.bit", "const k = 1\n")? // sorts first, clean, short
  writeFile("${nested}/subb/bhit.bit", hitFn)? // sorts second, the one real hit

  let n = runLint(bit, nested, capDir, ["."], ms)?
  checkRan(t, n, "attribution: nested directory")
  check(t, n.code == 1, "attribution: nested directory exit ${n.code}, want 1")
  check(t, contains(n.err, "--> ./subb/bhit.bit:2:3"),
    "attribution: nested finding must point at ./subb/bhit.bit:2:3 — got: ${n.err}")
  check(t, !contains(n.err, "suba/aclean.bit"),
    "attribution: nested finding must not point at suba/aclean.bit")
}

// #3205: `let out = dst` launders a slice PARAMETER past `lintFindAppendAliasing`
// — `out` becomes a local, so `append(out, ...)` was invisible to E0214 even
// though `out` and `dst` share a backing array. Three shapes, one fixture:
// a direct-param append (regression guard), the laundered alias (the fix),
// and the deliberate `p = append(p, x)` self-assignment exemption
// (spec/LINT.md), which must stay silent. Own directory, isolated from the
// shared `root` fixture.
fn checkAppendAliasingThroughLet(t: Tally, bit: string, scratch: string, capDir: string, ms: int): ()! {
  let dir = "${scratch}/letalias"
  mkdir(dir)?

  // Direct param append + the laundered alias: both must fire, both naming
  // the parameter 'dst' — the laundered one is the actual bug (#3205).
  let laundered = "fn directAppend(dst: []byte, v: int): []byte {\n" +
    "  return append(dst, byte(v))\n" +
    "}\n" +
    "fn launderedAppend(dst: []byte, v: int): []byte {\n" +
    "  let out = dst\n" +
    "  out = append(out, byte(v))\n" +
    "  return out\n" +
    "}\n"
  writeFile("${dir}/laundered.bit", laundered)?
  let l = runLint(bit, dir, capDir, ["laundered.bit"], ms)?
  checkRan(t, l, "let-alias: laundered append")
  check(t, l.code == 1, "let-alias: laundered append exit ${l.code}, want 1")
  check(t, contains(l.err, "lint: 2 findings, 0 overrides active"),
    "let-alias: want exactly 2 E0214 findings — got: ${l.err}")
  check(t, contains(l.err, "--> laundered.bit:2:10"),
    "let-alias: direct append must still be reported at 2:10")
  check(t, contains(l.err, "--> laundered.bit:6:9"),
    "let-alias: laundered append must be reported at 6:9")

  // Both findings must name the PARAMETER 'dst', never the local 'out' —
  // otherwise the message stops being actionable at the call site.
  check(t, !contains(l.err, "parameter 'out'"),
    "let-alias: must never name the local, only the parameter")

  // The deliberate `p = append(p, x)` self-assignment exemption
  // (compiler/lintappend.bit, spec/LINT.md) must stay silent when the
  // function returns `p` — this ticket is only about the let-alias hole, not
  // that settled policy. (#3688 narrowed the exemption to require exactly
  // this — `p` being returned — but changes nothing for this shape, since
  // `selfOwned` already does.)
  let exempt = "fn selfOwned(p: []byte, v: int): []byte {\n" +
    "  p = append(p, byte(v))\n" +
    "  return p\n" +
    "}\n"
  writeFile("${dir}/exempt.bit", exempt)?
  let e = runLint(bit, dir, capDir, ["exempt.bit"], ms)?
  checkRan(t, e, "let-alias: p = append(p, x) exemption")
  check(t, e.code == 0, "let-alias: exemption must stay silent, exit ${e.code}, want 0")
  check(t, contains(e.err, "lint: 0 findings, 0 overrides active"),
    "let-alias: exemption must report zero findings")

  // `// bit:lint allow E0214` above the laundered call still suppresses just
  // that one finding — the escape hatch must keep working unchanged.
  let allowed = "fn directAppend(dst: []byte, v: int): []byte {\n" +
    "  return append(dst, byte(v))\n" +
    "}\n" +
    "fn launderedAppend(dst: []byte, v: int): []byte {\n" +
    "  let out = dst\n" +
    "  // bit:lint allow E0214 -- out is a tracked alias of dst, exercised in a test\n" +
    "  out = append(out, byte(v))\n" +
    "  return out\n" +
    "}\n"
  writeFile("${dir}/allowed.bit", allowed)?
  let a = runLint(bit, dir, capDir, ["allowed.bit"], ms)?
  checkRan(t, a, "let-alias: allow directive on the laundered call")
  check(t, a.code == 1, "let-alias: one finding must still stand, exit ${a.code}, want 1")
  check(t, contains(a.err, "lint: 1 findings, 1 overrides active"),
    "let-alias: allow directive must suppress exactly the laundered finding")
  check(t, contains(a.err, "--> allowed.bit:2:10"),
    "let-alias: the surviving finding must be the direct append, not the suppressed one")
}

// Builds the fixture and binary every check below shares. Split out of
// `runAll` (#4228): 4 setup catches plus 10 check catches put the combined
// function's complexity (E0204) at 15 against a limit of 10 — `runAll` was
// already over at 14 before this ticket added an 11th check; splitting
// fixes both instead of adding a 15th branch to an already-over function.
fn runAllSetup(t: Tally, scratch: string, ms: int): (string, string, string) {
  let root = "${scratch}/tree"
  let capDir = "${scratch}/cap"
  mkdir(capDir) catch e {
    panic("lintcmd: cannot create ${capDir}: ${e.message()}")
  }
  let bit = bitBinary(scratch, ms) catch e {
    panic("lintcmd: ${e.message()}")
  }
  makeFixture(root) catch e {
    panic("lintcmd: cannot build the fixture: ${e.message()}")
  }
  verifyFixture(t, root) catch e {
    panic("lintcmd: cannot read the fixture back: ${e.message()}")
  }
  return bit, root, capDir
}

// The four checks that read the shared `root` fixture directly.
fn runAllChecksBasic(t: Tally, bit: string, root: string, capDir: string, ms: int) {
  checkTrichotomy(t, bit, root, capDir, ms) catch e { panic("lintcmd: ${e.message()}") }
  checkJson(t, bit, root, capDir, ms) catch e { panic("lintcmd: ${e.message()}") }
  checkStats(t, bit, root, capDir, ms) catch e { panic("lintcmd: ${e.message()}") }
  checkUntrusted(t, bit, root, capDir, ms) catch e { panic("lintcmd: ${e.message()}") }
}

// The remaining checks, each of which builds its own fixture directory under
// `scratch` rather than sharing `root`.
fn runAllChecksExtended(t: Tally, bit: string, scratch: string, capDir: string, ms: int) {
  checkDirectivePlacement(t, bit, scratch, capDir, ms) catch e { panic("lintcmd: ${e.message()}") }
  checkModuleScopedUnusedImport(t, bit, scratch, capDir, ms) catch e { panic("lintcmd: ${e.message()}") }
  checkModuleScopedUnusedImportIncoherentDir(t, bit, scratch, capDir, ms) catch e {
    panic("lintcmd: ${e.message()}")
  }
  checkLineAllow(t, bit, scratch, capDir, ms) catch e { panic("lintcmd: ${e.message()}") }
  checkAppendAliasingAttribution(t, bit, scratch, capDir, ms) catch e { panic("lintcmd: ${e.message()}") }
  checkAppendAliasingThroughLet(t, bit, scratch, capDir, ms) catch e { panic("lintcmd: ${e.message()}") }
}

// Every case, against a fixture built fresh under `scratch`.
fn runAll(t: Tally, scratch: string, ms: int) {
  let (bit, root, capDir) = runAllSetup(t, scratch, ms)
  runAllChecksBasic(t, bit, root, capDir, ms)
  runAllChecksExtended(t, bit, scratch, capDir, ms)
}

fn main() {
  let ms = timeoutMs()
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  let scratch = "${tmp}/bit-lintcmd-${uuidFormat(uuidV4())}"
  let t = Tally{ checks: 0, failures: 0 }

  mkdir(scratch) catch e {
    panic("lintcmd: cannot create ${scratch}: ${e.message()}")
  }
  runAll(t, scratch, ms)

  // The run marker: a gate that stopped checking is visible here rather than
  // green. 133 is what every case above (including #3205's
  // checkAppendAliasingThroughLet, 13 checks) asserts today; the floor only
  // has to be tight enough that a whole case going missing trips it.
  if (t.checks < 133) {
    eprint("FAIL: only ${t.checks} checks ran, want at least 133\n")
    t.failures = t.failures + 1
  }
  if (t.failures > 0) {
    // `exit()` does not run pending defers (#3694, same shape as #3677) —
    // call teardown explicitly on both the PASS and FAIL paths.
    teardown(scratch, ms)
    println("lintcmd: FAIL — ${t.failures} of ${t.checks} checks failed")
    exit(1)
  }
  teardown(scratch, ms)
  println("lintcmd: PASS — ${t.checks} checks")
}

// std/fs has no recursive remove, so the scratch tree goes the way it came.
fn teardown(scratch: string, ms: int) {
  shell("${scratch}/rm.sh", "#!/bin/sh\nrm -rf '${scratch}'\n", ms) catch _ { return }
}

// `std/strings`' `trimSpace` stops at spaces and tabs, and every capture here
// arrives newline-terminated from a shell redirect.
fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}
