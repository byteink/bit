// _tests_/bit/baremaplit.bit — #6016: proves a bare `{k: v, ...}` map literal
// (SPEC §12.3/§15.2) is accepted at a call site with no type prefix and
// constructs the map its expected `map<K,V>` parameter type names, plus the
// five diagnostic cases below it. NOT placed in _tests_/cases/: the
// `assertDiag` cases are check-must-fail fixtures asserting a specific
// diagnostic substring, a shape the ast/types/ir differential corpus has no
// room for — same "route it to _tests_/bit/ behind a registered gate"
// treatment _tests_/bit/loadu64.bit documents for its own surface. So this
// drives the CLI directly instead.
//
// WIRED INTO `./make test` as `test-baremaplit`
// (tools/build/gatestable2.bit, tools/build/defs.bit).

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"
import { contains, parseInt, trimSpace } from "std/strings"

const defaultTimeoutS: int = 60
const maxTimeoutMs: int = 6000000

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("baremaplit: ${name} is not set — refusing to guess.\n")
    exit(2)
  }
  return v
}

fn timeoutMs(): int {
  let raw = trimSpace(envOr("BIT_TEST_TIMEOUT_S", ""))
  if (raw == "") {
    return defaultTimeoutS * 1000
  }
  let s = parseInt(raw) catch _ {
    return defaultTimeoutS * 1000
  }
  if (s <= 0) {
    return maxTimeoutMs
  }
  if (s * 1000 > maxTimeoutMs) {
    return maxTimeoutMs
  }
  return s * 1000
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

// The fixture: a `set(fields: map<string,string>)` call site with a bare
// map literal argument (no `map<string,string>` prefix), an empty `{}`
// against the same parameter, and a bare `{"a": 1}` with no expected type at
// all — exercising the call-site push-down, the empty-map decision, and
// plain key/value inference in one program.
fn fixtureSrc(): string {
  return "fn set(fields: map<string,string>): int {\n" +
    "  return len(fields)\n" +
    "}\n\n" +
    "fn main() {\n" +
    "  let n = set({\"name\": \"Ada\", \"lang\": \"bit\"})\n" +
    "  print(\"\${n}\\n\")\n" +
    "  let empty = set({})\n" +
    "  print(\"\${empty}\\n\")\n" +
    "  let m = {\"a\": 1}\n" +
    "  let v = m[\"a\"]\n" +
    "  print(\"\${v}\\n\")\n" +
    "}\n"
}

const wantOut: string = "2\n0\n1\n"

// The compiler under test, bundled with the environment it needs to run
// (BIT_STDLIB/BIT_LIBBITRT) — same shape as loadu64.bit's CompilerEnv.
class CompilerEnv {
  bin: string,
  stdlib: string,
  libbitrt: string,
}

// Builds `srcPath` to `outPath`, with the compiler's own environment
// (BIT_STDLIB/BIT_LIBBITRT) exported. Returns the wrapper's exit code and
// captured stderr.
fn buildOne(cc: CompilerEnv, dir: string, srcPath: string, outPath: string): (int, string) {
  let shPath = dir + "/build.sh"
  let errPath = dir + "/build.err"
  let script = "#!/bin/sh\n" +
    "BIT_STDLIB=" +
    shQuote(cc.stdlib) +
    "\nexport BIT_STDLIB\n" +
    "BIT_LIBBITRT=" +
    shQuote(cc.libbitrt) +
    "\nexport BIT_LIBBITRT\n" +
    "exec " +
    shQuote(cc.bin) +
    " build " +
    shQuote(srcPath) +
    " -o " +
    shQuote(outPath) +
    " > /dev/null 2> " +
    shQuote(errPath) +
    "\n"
  writeFile(shPath, script) catch e {
    eprint("baremaplit: cannot write build wrapper: ${e.message()}\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("baremaplit: cannot chmod build wrapper\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let err = readFile(errPath) catch _ {
    ""
  }
  return code, err
}

// Runs `bit check` on `srcPath` (no build, no run — a diagnostic case).
// Returns the exit code and captured stderr.
fn checkOne(cc: CompilerEnv, dir: string, srcPath: string): (int, string) {
  let shPath = dir + "/check.sh"
  let errPath = dir + "/check.err"
  let script = "#!/bin/sh\n" +
    "BIT_STDLIB=" +
    shQuote(cc.stdlib) +
    "\nexport BIT_STDLIB\n" +
    "BIT_LIBBITRT=" +
    shQuote(cc.libbitrt) +
    "\nexport BIT_LIBBITRT\n" +
    "exec " +
    shQuote(cc.bin) +
    " check " +
    shQuote(srcPath) +
    " > /dev/null 2> " +
    shQuote(errPath) +
    "\n"
  writeFile(shPath, script) catch e {
    eprint("baremaplit: cannot write check wrapper: ${e.message()}\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("baremaplit: cannot chmod check wrapper\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let err = readFile(errPath) catch _ {
    ""
  }
  return code, err
}

// One `bit check`-must-fail-with-this-diagnostic case: `label` names it in a
// failure message, `src` is the whole fixture source, `want` a substring the
// rendered stderr must contain. Writes `src` fresh into `scratch/<label>.bit`
// each call so the three cases never share a source file.
fn assertDiag(cc: CompilerEnv, scratch: string, label: string, src: string, want: string) {
  let srcPath = scratch + "/" + label + ".bit"
  writeFile(srcPath, src) catch e {
    eprint("baremaplit: cannot write ${srcPath}: ${e.message()}\n")
    teardown(scratch, timeoutMs())
    exit(2)
  }
  let (code, err) = checkOne(cc, scratch, srcPath)
  if (code == 0 || !contains(err, want)) {
    eprint("baremaplit: FAIL — ${label}: exit=${code}\n  want stderr to contain: ${want}\n  got:\n${err}\n")
    teardown(scratch, timeoutMs())
    exit(1)
  }
}

// Runs the built binary at `binPath`. Returns its exit code and stdout.
fn runOne(dir: string, binPath: string): (int, string) {
  let shPath = dir + "/run.sh"
  let outPath = dir + "/run.out"
  let script = "#!/bin/sh\nexec " + shQuote(binPath) + " > " + shQuote(outPath) + " 2>&1\n"
  writeFile(shPath, script) catch e {
    eprint("baremaplit: cannot write run wrapper: ${e.message()}\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("baremaplit: cannot chmod run wrapper\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let out = readFile(outPath) catch _ {
    ""
  }
  return code, out
}

// `exit()` does not run pending defers — call this explicitly at every exit
// site instead (same reasoning as loadu64.bit's teardown).
fn teardown(scratch: string, ms: int) {
  let shPath = scratch + "/rm.sh"
  writeFile(shPath, "#!/bin/sh\nrm -rf '${scratch}'\n") catch _ {
    return
  }
  if (fsChmod(shPath, 448) != 0) {
    return
  }
  osRunBounded(shPath, ms)
}

fn main() {
  let cc = CompilerEnv{
    bin = requiredEnv("BIT_BIN"),
    stdlib = requiredEnv("BIT_STDLIB"),
    libbitrt = requiredEnv("BIT_LIBBITRT"),
  }

  let scratch = envOr("TMPDIR", "/tmp") + "/bit-baremaplit-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("baremaplit: cannot create scratch directory ${scratch}: ${e.message()}\n")
    exit(2)
  }

  let srcPath = scratch + "/fixture.bit"
  writeFile(srcPath, fixtureSrc()) catch e {
    eprint("baremaplit: cannot write ${srcPath}: ${e.message()}\n")
    teardown(scratch, timeoutMs())
    exit(2)
  }
  let outPath = scratch + "/fixture_out"
  let (buildCode, buildErr) = buildOne(cc, scratch, srcPath, outPath)
  if (buildCode != 0) {
    eprint("baremaplit: FAIL — fixture failed to build (exit ${buildCode}):\n${buildErr}\n")
    teardown(scratch, timeoutMs())
    exit(1)
  }
  let (runCode, out) = runOne(scratch, outPath)
  if (runCode != 0 || out != wantOut) {
    eprint("baremaplit: FAIL — fixture ran wrong: exit=${runCode}\n  want: ${wantOut}\n  got:  ${out}\n")
    teardown(scratch, timeoutMs())
    exit(1)
  }

  // Three diagnostic cases (#6016 review: "do not inherit the slice hole" —
  // checkSliceLit's own gap, #6025, deliberately left alone): every entry of
  // a bare map literal must be checked against the inferred (no expected
  // type reachable) or expected (a call argument) K/V, naming the entry and
  // both types, not just the first entry the way checkSliceLit does.
  assertDiag(
    cc, scratch, "wrong_type",
    "fn take(s: string) {}\nfn main() {\n  take({\"a\": \"b\"})\n}\n",
    "expected 'string', found 'map<string, string>'",
  )
  assertDiag(
    cc, scratch, "mixed_value",
    "fn main() {\n  let m = {\"a\": 1, \"b\": \"x\"}\n  print(\"\${len(m)}\\n\")\n}\n",
    "expected 'i64', found 'untyped string'",
  )
  assertDiag(
    cc, scratch, "key_mismatch",
    "fn main() {\n  let m = {\"a\": 1, 2: 3}\n  print(\"\${len(m)}\\n\")\n}\n",
    "expected 'string', found 'untyped int'",
  )
  // #6025 (integrator review, task-6025): the three cases above all reach
  // `vMapLitSelf` through the ONE consumer it used to be wired into (a `let`
  // binding's no-annotation branch). These two do not go through a binding
  // at all — the literal is typed inline, with no expectation of its own,
  // exactly where the original per-consumer wiring missed a bare slice
  // literal too.
  assertDiag(
    cc, scratch, "forof_entry",
    "fn main() {\n  for (k, v) of {\"a\": 1, \"b\": \"x\"} {\n    print(\"\${k}\${v}\\n\")\n  }\n}\n",
    "expected 'i64', found 'untyped string'",
  )
  assertDiag(
    cc, scratch, "len_arg",
    "fn main() {\n  print(\"\${len({\"a\": 1, \"b\": \"x\"})}\\n\")\n}\n",
    "expected 'i64', found 'untyped string'",
  )

  teardown(scratch, timeoutMs())
  print("PASS baremaplit: a bare map literal parses, checks, and lowers at a map<K,V> call site\n")
}
