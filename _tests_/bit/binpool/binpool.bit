// The shared shell text for running a freshly COMPILED binary through a small
// pool of already-validated inodes, for a harness whose children run
// concurrently under `xargs -P`.
//
// THE DEFECT THIS CLOSES is the one `../trampoline/trampoline.bit` documents
// and #4712 measured with no Bit involved: macOS charges a validation for
// every newly CREATED inode that reaches `execve`, serialized SYSTEM-WIDE at
// roughly two per second, and charges nothing for an inode that has already
// been exec'd once — even after its whole content is rewritten. Measured here
// on 2026-09-10, N=30, `cc`-built binaries:
//
//     30 fresh inodes, exec'd once each                      13.564s
//     one validated inode, 60 rewrite+exec cycles             0.205s
//     30 fresh SCRIPT inodes, exec'd once each (the warm)    12.786s
//     a Mach-O written over each of those 30 and exec'd       0.135s
//
// Row 4 is what lets `poolSetupScript` warm a slot with a two-line `/bin/sh`
// script rather than a binary: the kernel's cached verdict follows the INODE,
// not the content, so a slot warmed as a script is free for every Mach-O
// written over it afterwards.
//
// (Do not run that experiment with `/bin/echo` or any other Apple-signed
// system binary as the payload. A copy of a platform binary is validated on
// EVERY exec, not just the first — 30 fresh 28.2s against 30 rewrites of one
// validated inode 30.2s, i.e. the rewrite looks no cheaper and the mechanism
// reads as false. Build the payload with `cc`.)
//
// WHY THIS IS NOT `../trampoline`'s `binRunner`. That one hands out ONE inode
// per scratch directory and is sound only for a single-threaded harness, which
// is what `_tests_/bit/stringexplode/` is. `_tests_/bit/golden/` and
// `_tests_/bit/importsrun/` fan their cases out with `xargs -P N`, so N cases
// are between "copy the binary over the runner" and "exec the runner" at once,
// and one shared inode would make each of them run whichever binary was copied
// last. The pool below gives each concurrent job an inode nothing else can be
// holding, and the whole cost is the N first-execs the pool itself pays.
//
// THE KNOWN HAZARD, stated here because every consumer inherits it. Rewriting
// an inode's content and exec'ing it again is not free of consequence, only
// free of the tax: macOS stamps every created file with `com.apple.provenance`
// (an xattr `xattr -d` cannot remove — it returns 0 and the xattr is still
// there) and applies a provenance sandbox at exec, and that step can FAIL for
// a rewritten inode. When it does, the kernel SIGKILLs the process before its
// first instruction, so the caller reads exit 137 with empty stdout:
//
//     AppleSystemPolicy: ASP: Unable to apply provenance sandbox:
//         268451845, 59163, .../run.bin
//
// #4713 hit it in `_tests_/bit/mainexit.bit`, which reused ONE inode for 13
// consecutive execs: 7 of the 13 died that way inside `./make test`, and not
// once on an idle box — a loaded `syspolicyd` is part of the trigger, so a
// green standalone run says nothing. It has never been seen through the pool
// below: 528 pooled execs per `test-golden` run over 18 slots, plus
// `test-imports-bit`'s 160 and `test-examples`' 53, across a full suite and
// four standalone runs, all clean. The working theory is that rotation is
// what buys the slack, which makes SLOT COUNT a correctness input and not a
// tuning knob — a harness whose exec count is not far above its slot count
// should keep paying the tax instead (see `mainexit.bit`'s own comment).
//
// WHY THIS IS ITS OWN DIRECTORY, and not text inside either harness: a Bit
// import is per-MODULE, not per-file, and
// `_tests_/bit/importsrun/importsrun.bit`'s header refuses any transitive
// `std/*` dependency ("so it runs under a bare `bit run` with no BIT_STDLIB
// needed to compile the harness itself"). `../gatefanout` imports `std/fs`, so
// importing the text from there would poison it. This module imports nothing
// at all, exactly as `tools/killtree/` does for the kill-tree text and for the
// same reason (#3238) — and, both of its consumers being test harnesses, it
// lives beside them rather than under `tools/`.
//
// Both consumers keep their own EMISSION granularity, again as killtree does:
// `../gatefanout` writes `poolRunFnDef()` into every wave-2 job script and
// `poolSetupScript()` into its one driver; `../importsrun` writes the same two
// into its per-case run scripts and its per-wave driver.

// Upper bound on pooled inodes (Power of 10 rule 2). A box with more cores
// than this runs more `xargs` workers than there are slots; `runbin` then
// waits for one, which costs milliseconds against the ~440ms an extra fresh
// inode costs. It is also the bound `cleanupPool` sweeps.
export const maxSlots: int = 64

// The pool directory a harness should use, given its own scratch directory.
// One function so the driver text, the job text and the cleanup sweep cannot
// drift apart.
export fn poolDir(scratch: string): string {
  return "${scratch}/binpool"
}

// Paths inside the pool. `r<i>` is the runner inode for slot i; `l<i>` is the
// lock DIRECTORY whose creation claims it.
fn slotPath(scratch: string, i: int): string {
  return "${poolDir(scratch)}/r${i}"
}

fn lockPath(scratch: string, i: int): string {
  return "${poolDir(scratch)}/l${i}"
}

// Removes every file the pool can leave behind, then the directory itself.
// `fsRemove` on a directory is `rmdir` (ABI.md §14), so the slots and any lock
// a killed job left claimed have to go first or the harness's own
// `fsRemove(scratch)` starts failing silently and leaking one scratch
// directory per run. Bounded by `maxSlots` and indifferent to how many slots
// the driver actually created — every miss is one ENOENT.
export fn cleanupPool(scratch: string) {
  let i = 0
  while (i < maxSlots) {
    fsRemove(lockPath(scratch, i))
    fsRemove(slotPath(scratch, i))
    i = i + 1
  }
  fsRemove(poolDir(scratch))
}

// Driver-side text: create the pool, warm every slot, and publish it to every
// child through the environment. `slotsExpr` is a shell expression the caller
// has already computed for its own `xargs -P` width (`$N` in both consumers),
// so the pool is exactly as wide as the fan-out and no job ever waits.
//
// The warm execs are BACKGROUNDED on purpose. Each one pays the ~440ms
// validation and they are serialized by the kernel regardless, so running them
// beside wave 1's compiles hides the whole pool's cost behind work that is not
// competing for the same queue. `poolWaitScript()` below is the barrier the
// caller must place before anything calls `runbin`.
//
// Idempotent: a second wave's driver re-runs this text, finds every `r<i>`
// present and warms nothing (`_tests_/bit/importsrun/` runs one driver per
// wave, so it executes this twice per run).
export fn poolSetupScript(scratch: string, slotsExpr: string): string {
  return "BIT_BINPOOL=" +
    q(poolDir(scratch)) +
    "\nexport BIT_BINPOOL\n" +
    "BIT_BINPOOL_N=${slotsExpr}\n" +
    "if [ \"$BIT_BINPOOL_N\" -gt ${maxSlots} ] 2>/dev/null; then BIT_BINPOOL_N=${maxSlots}; fi\n" +
    "if [ \"$BIT_BINPOOL_N\" -lt 1 ] 2>/dev/null; then BIT_BINPOOL_N=1; fi\n" +
    "export BIT_BINPOOL_N\n" +
    "mkdir \"$BIT_BINPOOL\" 2>/dev/null\n" +
    "bpi=0\nwhile [ \"$bpi\" -lt \"$BIT_BINPOOL_N\" ]; do\n" +
    "  if [ ! -e \"$BIT_BINPOOL/r$bpi\" ]; then\n" +
    "    printf '#!/bin/sh\\nexit 0\\n' > \"$BIT_BINPOOL/r$bpi\"\n" +
    "    chmod 700 \"$BIT_BINPOOL/r$bpi\"\n" +
    "    \"$BIT_BINPOOL/r$bpi\" >/dev/null 2>&1 &\n" +
    "  fi\n  bpi=$((bpi + 1))\ndone\n"
}

// The barrier for the backgrounded warms above. A bare `wait` also reaps
// whatever else the driver has backgrounded, which in both consumers is
// nothing, and POSIX fixes its status at 0.
export fn poolWaitScript(): string {
  return "wait\n"
}

// The `runbin` shell function: run `$1` (a freshly built binary) through a
// pooled inode, forwarding `$2...` as its arguments, and return its exit
// status unchanged.
//
// RACE FREEDOM. `mkdir` is atomic and fails with EEXIST when the directory
// exists, so at most one process is ever between `mkdir l<i>` and `rmdir l<i>`
// for a given i. Every write to `r<i>` and every exec of `r<i>` happens inside
// that window, so no job can exec a slot another job is mid-copy into. Slots
// are separate inodes, so two different slots never interact at all.
//
// ETXTBSY cannot fire here either, and not by luck: the only write fd on
// `r<i>` belongs to the `cat` process, `cat` forks nothing, and the exec is
// sequenced after `cat` has exited. `fork` copies the fd table of the FORKING
// process only, so no other job's shell can inherit it (74811a3, the bug
// `../gatefanout`'s wave barrier exists for, needed a fd holder that forks).
//
// A slot whose holder is killed outright — the watchdog's `killtree` on a
// timed-out case — leaks its lock for the rest of the run. That is why the
// outer loop is BOUNDED and falls back to exec'ing the binary directly: a
// harness that has already started killing children must still finish and
// report, at the price of the tax it was avoiding.
//
// A copy that fails (no such binary, because the compile failed) also falls
// back to the original path, so the shell reports the same 127 and the same
// message it reported before this indirection existed.
export fn poolRunFnDef(): string {
  return "runbin() {\n" +
    "  bpb=$1\n  shift\n" +
    "  if [ -z \"$BIT_BINPOOL\" ]; then \"$bpb\" \"$@\"; return $?; fi\n" +
    "  bpn=0\n  while [ \"$bpn\" -lt 60 ]; do\n" +
    "    bpi=0\n    while [ \"$bpi\" -lt \"$BIT_BINPOOL_N\" ]; do\n" +
    "      if mkdir \"$BIT_BINPOOL/l$bpi\" 2>/dev/null; then\n" +
    "        bpr=\"$BIT_BINPOOL/r$bpi\"\n" +
    "        if cat \"$bpb\" > \"$bpr\" 2>/dev/null; then \"$bpr\" \"$@\"; else \"$bpb\" \"$@\"; fi\n" +
    "        bpc=$?\n" +
    "        rmdir \"$BIT_BINPOOL/l$bpi\" 2>/dev/null\n" +
    "        return $bpc\n" +
    "      fi\n      bpi=$((bpi + 1))\n    done\n" +
    "    bpn=$((bpn + 1))\n    sleep 1\n  done\n" +
    "  \"$bpb\" \"$@\"\n}\n"
}

// Single-quote `s` for /bin/sh. A local copy rather than an import: this
// module owes its consumers zero transitive dependencies, and both of them
// already carry their own identical helper for their own text.
fn q(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}
