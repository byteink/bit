// _tests_/bit/gateregistry.bit — #5256: `Gate{}` records excluded from
// `gateNames()` (tools/build/defs.bit) used to be documented only in a
// prose comment above the entry — easy to add, easy to forget, impossible
// to check. `test-package-docs` sat red on main through exactly that hole:
// registered as a `Gate{}`, excluded from `gateNames()`, and reachable
// through NO routine path (`./make test` runs `gateNames()`; `./make
// test-prepush` re-adds exactly one excluded name, `test-differentials`).
//
// This asserts the `excludeReason` field (class Gate, tools/build/gates.bit)
// two ways over the WHOLE registry (`gateTable()`, both table files plus the
// two per-package loops):
//   - every gate absent from `gateNames()` carries a non-empty reason
//   - every gate present in `gateNames()` carries an EMPTY reason — a gate
//     that is actually running with a stale "excluded" reason attached is
//     its own kind of lie
//
// Registered in `gateSteps()` (defs.bit), so `./make test` and `./make
// test-prepush` run this on every edit: a `Gate{}` added with neither
// `gateNames()` membership nor a reason now fails the build instead of
// silently rotting the way `test-package-docs` did. This IS the "one
// documented command" #5256 asks for — `./make test`/`test-prepush` already
// run every gate not deliberately excluded, and this gate, running beside
// them, names any gate it could not account for.
//
// Imports `tools/build` directly so both accounting and the SDK whitelist
// use the compiled registry. The phase fixture runs a copied actual driver
// against owned warm artifacts, and never executes a harness argument.
import { Gate, gateTable, gateNames, differentialJobsScript } from "../../tools/build"
import {
  budgetEnvScript,
  budgetJobs,
  budgetShare,
  fanoutJobs,
  hostJobsScript,
  nestedEnvScript,
  nestedJobs,
  pairJobs,
  parseCpuBudget,
} from "../../tools/joblimit"
import { args, envOr, exit } from "std/os"
import { exists, writeFile } from "std/fs"
import { indexOf, replace } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"
import { mustSucceed, rmrf, shQuote } from "./pmvanityhelpers"
import { hashseedPoolScript } from "./hashseedpool"

// Execute the real driver against warm, isolated artifacts. Every registered
// argv terminates at this SDK stub; no harness argument is ever executed.
fn prepushDispatch(g: Gate, source: string, root: string): string {
  let predicate = "[ \"$#\" -eq ${len(g.argv)} ]"
  let i = 0
  for a of g.argv {
    i = i + 1
    predicate = predicate +
      " && [ \"\${" +
      "${i}" +
      "}\" = " +
      shQuote(replace(a, source, root)) +
      " ]"
  }
  for kv of g.env {
    let eq = indexOf(kv, "=")
    assert(eq > 0)
    predicate = predicate +
      " && [ \"\${" +
      kv[:eq] +
      "-}\" = " +
      shQuote(replace(kv[eq + 1:], source, root)) +
      " ]"
  }
  return "if " +
    predicate +
    " && [ \"$score\" -lt ${len(g.env)} ]; then name=" +
    shQuote(g.name) +
    "; score=${len(g.env)}; fi\n"
}

fn prepushSdk(gates: []Gate, covered: map<string, bool>, source: string, root: string): string {
  let script = "#!/bin/sh\nset -eu\n[ \"$#\" -ne 1 ] || [ \"$1\" != --version ] || { echo fixture-sdk; exit 0; }\nname= score=-1\n"
  for g of gates {
    if (covered[g.name] || g.name == "test-differentials") {
      script = script + prepushDispatch(g, source, root)
    }
  }
  return script +
    "[ -n \"$name\" ] || { echo 'unexpected SDK argv' >&2; exit 125; }\n" +
    "root=" +
    shQuote(root) +
    "\n" +
    "[ ! -f \"$root/share-probe\" ] || exec sh \"$root/share-child.sh\" \"$root\" \"$name\"\n" +
    "if [ \"$name\" = test-differentials ]; then\n" +
    "  mkdir \"$root/differential\" || exit 125\n" +
    "  printf '%s\\n' \"\${DIFFALL_JOBS-}\" > \"$root/differential/jobs\"\n" +
    "  [ -z \"$(ls -A \"$root/active\")\" ] || exit 1\n" +
    "  [ -f \"$root/direct\" ] || {\n" +
    "  (cd \"$root/done\"; printf '%s\\n' *) | LC_ALL=C sort > \"$root/at-diff\"\n" +
    "  cmp \"$root/expected\" \"$root/at-diff\" || exit 1\n" +
    "  }\n" +
    "else\n" +
    "  printf '%s\\n' \"$name\" > \"$root/active/$$\"\n" +
    "  mkdir \"$root/done/$name\" || exit 125\n" +
    "  rm \"$root/active/$$\" || exit 125\n" +
    "fi\n" +
    "[ \"$name\" != \"$(cat \"$root/fail\")\" ]\n"
}

fn prepushBudgetCases(): string {
  let cases = ""
  for budget of ["", "1", "2"] {
    for caseName of ["", gateNames()[0], "test-osenv", "test-differentials"] {
      cases = cases + "run_case " + shQuote(caseName) + " " + shQuote(budget) + " ''\n"
    }
  }
  for bad of ["0", "-1", "two", "1.5", " 2", "2147483648", "99999999999999999999"] {
    cases = cases + "bad_budget " + shQuote(bad) + "\n"
  }
  cases = cases + "run_case '' 2 1\nrun_case '' 1 2\n"
  for budget of ["1", "2", "6"] {
    for requested of ["99", "1", "bad", "0"] {
      cases = cases + "direct_case " + budget + " " + requested + "\n"
    }
  }
  return cases
}

fn hashseedRoutingScript(): string {
  return "hashseed_batch_count() {\n" +
    "  n=0; for out in \"$f\"/bit-out/make/gatebatch/test-hashseed.*.out; do\n" +
    "    [ ! -f \"$out\" ] || n=$((n + 1))\n" +
    "  done; echo \"$n\"\n" +
    "}\n" +
    "check_hashseed_routing() {\n" +
    "  after=$(hashseed_batch_count); want=$(($2 + 1))\n" +
    "  [ -z \"$1\" ] || want=$2\n" +
    "  [ \"$after\" -eq \"$want\" ] || { echo 'unsafe hashseed pool routing' >&2; exit 1; }\n" +
    "}\n"
}

fn prepushRunScript(root: string, cases: string): string {
  return "set -eu\nf=" +
    shQuote(root) +
    "\n" +
    hashseedRoutingScript() +
    "\nchmod 700 \"$f/bit-out/bin/bit\" \"$f/scripts/stage0.sh\"\n" +
    "LC_ALL=C sort \"$f/expected.unsorted\" > \"$f/expected\"\n" +
    "run_case() {\n" +
    "  label=\${1:-clean}-\${2:-default}-\${3:-auto}; mkdir \"$f/$label\"; cd \"$f\"\n" +
    "  mkdir active done; printf '%s' \"$1\" > fail; hashseed_before=$(hashseed_batch_count)\n" +
    "  set +e\n" +
    "  env -i PATH=\"$PATH\" TMPDIR=\"$f/\" BIT_MAKE_ROOT=\"$f\" BIT_MAKE_CPU_BUDGET=\"$2\" BIT_MAKE_JOBS=\"$3\" BIT_LIBBITRT_TREE=" +
    shQuote(envOr("BIT_LIBBITRT_TREE", "")) +
    " \"$f/bit-out/make/make-driver\" test-prepush > \"$label/driver.log\" 2>&1\n" +
    "  rc=$?\n  set -e\n" +
    "  check_hashseed_routing \"$2\" \"$hashseed_before\"\n" +
    "  [ \"$(grep -c 'make:   up to date' \"$label/driver.log\")\" -eq 2 ] || { cat \"$label/driver.log\"; exit 125; }\n" +
    "  [ -z \"$(ls -A \"$f/active\")\" ]\n" +
    "  cores=$(cat \"$f/bit-out/make/ncpu\"); jobs=$((cores / 3))\n" +
    "  if [ \"$cores\" -le 2 ]; then jobs=1; elif [ \"$jobs\" -lt 2 ]; then jobs=2; fi\n" +
    "  [ -z \"$3\" ] || jobs=$3\n" +
    "  width=$((cores - jobs - 1)); [ \"$width\" -ge 1 ] || width=1\n" +
    "  if [ -n \"$2\" ]; then\n" +
    "    [ \"$jobs\" -le \"$2\" ] || jobs=$2\n" +
    "    pair=$(( $2 / 2 )); [ \"$pair\" -ge 1 ] || pair=1\n" +
    "    [ \"$width\" -le \"$pair\" ] || width=$pair\n" +
    "  fi\n" +
    "  grep -F \"suite gate(s) at $jobs at a time\" \"$label/driver.log\" >/dev/null\n" +
    "  (cd \"$f/done\"; printf '%s\\n' *) | LC_ALL=C sort > completed\n" +
    "  cmp expected completed\n" +
    "  case \"$1\" in ''|test-differentials)\n" +
    "    [ -d differential ]; cmp expected at-diff\n" +
    "    [ \"$(cat differential/jobs)\" -eq \"$width\" ]\n" +
    "    result='1 gate, 0 failed'; [ \"$1\" != test-differentials ] || result='FAILED — test-differentials'\n" +
    "    grep -F \"make: test-prepush differentials: $result\" \"$label/driver.log\" >/dev/null\n" +
    "    ! grep -F 'make: test-prepush differentials: SKIPPED' \"$label/driver.log\"\n" +
    "    mv differential at-diff \"$label/\"\n" +
    "    ;; *)\n" +
    "    [ ! -e differential ] && [ ! -e at-diff ]\n" +
    "    grep -F 'make: test-prepush differentials: SKIPPED — suite failed' \"$label/driver.log\" >/dev/null\n" +
    "    ! grep -F 'make: test-prepush differentials: 1 gate, 0 failed' \"$label/driver.log\"\n" +
    "    width=SKIPPED\n" +
    "    ;; esac\n" +
    "  want=1; [ -n \"$1\" ] || want=0\n" +
    "  echo \"gateregistry: phase case=$label census=${len(gateNames())} width=$width native=$rc expected=$want\"\n" +
    "  [ \"$rc\" -eq \"$want\" ] || { cat \"$label/driver.log\"; exit 1; }\n" +
    "  mv active done fail completed \"$label/\"\n" +
    "}\n" +
    "direct_case() {\n" +
    "  cd \"$f\"; mkdir active done; : > direct; : > fail\n" +
    "  set +e\n" +
    "  env -i PATH=\"$PATH\" BIT_MAKE_ROOT=\"$f\" BIT_MAKE_CPU_BUDGET=\"$1\" DIFFALL_JOBS=\"$2\" BIT_LIBBITRT_TREE=" +
    shQuote(envOr("BIT_LIBBITRT_TREE", "")) +
    " \"$f/bit-out/make/make-driver\" test-differentials > direct.log 2>&1\n" +
    "  rc=$?\n  set -e\n" +
    "  want=1; [ \"$1:$2\" != 6:99 ] || want=3\n" +
    "  [ \"$rc\" -eq 0 ] && [ \"$(cat differential/jobs)\" -eq \"$want\" ]\n" +
    "  [ -z \"$(ls -A active)\" ] && [ -z \"$(ls -A done)\" ]\n" +
    "  mv differential \"direct-$1-$2\"; rm direct fail; rmdir active done\n" +
    "}\n" +
    "bad_budget() {\n" +
    "  cd \"$f\"; mkdir active done\n" +
    "  set +e\n" +
    "  env -i PATH=\"$PATH\" BIT_MAKE_ROOT=\"$f\" BIT_MAKE_CPU_BUDGET=\"$1\" \"$f/bit-out/make/make-driver\" test-prepush > bad.log 2>&1\n" +
    "  rc=$?\n  set -e\n" +
    "  [ \"$rc\" -eq 2 ] && grep -F BIT_MAKE_CPU_BUDGET bad.log >/dev/null\n" +
    "  [ -z \"$(ls -A active)\" ] && [ -z \"$(ls -A done)\" ]\n" +
    "  ! grep -F 'make: libbitrt' bad.log\n" +
    "  rmdir active done\n" +
    "}\n" +
    cases
}

fn prepushFixture(gates: []Gate, covered: map<string, bool>) {
  let source = envOr("BIT_MAKE_ROOT", "")
  assert(len(source) > 0 && source[0] == '/')
  let root = envOr("TMPDIR", "/tmp") + "/t8274-" + uuidFormat(uuidV4())
  let a = args()
  let driver = source + "/bit-out/make/make-driver"
  if (len(a) > 1) {
    driver = a[1]
  }
  let script = "set -eu\numask 077\nf=" +
    shQuote(root) +
    "\ns=" +
    shQuote(source) +
    "\n" +
    "mkdir -p \"$f/bit-out/bin\" \"$f/bit-out/make\" \"$f/scripts\" \"$f/dist/stage0\"\n" +
    "for d in runtime compiler stdlib tools pkg; do ln -s \"$s/$d\" \"$f/$d\"; done\n" +
    "cp \"$s/dist/stage0/SHA256SUMS\" \"$f/dist/stage0/SHA256SUMS\"\n" +
    "cp \"$s/bit-out/make/fp-libbitrt.stamp\" \"$s/bit-out/make/fp-selfhost.stamp\" \"$f/bit-out/make/\"\n" +
    "cp " +
    shQuote(driver) +
    " \"$f/bit-out/make/make-driver\"\n" +
    "for t in x86_64-linux aarch64-linux aarch64-macos; do mkdir -p \"$f/bit-out/lib/$t\"; ln -s \"$s/bit-out/lib/$t/libbitrt.a\" \"$f/bit-out/lib/$t/libbitrt.a\"; done\n"
  mustSucceed("gateregistry", "owned warm fixture", script)
  budgetScriptFixture(root)
  budgetPoolFixture(root, 4, 1, 4)
  budgetPoolFixture(root, 4, 2, 4)
  budgetPoolFixture(root, 4, 4, 4)
  budgetPoolFixture(root, 1, 4, 4)
  hashseedScriptFixture(root)
  differentialEnvFixture(root)
  let sdk = prepushSdk(gates, covered, source, root)
  writeFile(root + "/bit-out/bin/bit", sdk) catch _ {
    exit(1)
  }
  writeFile(
    root + "/scripts/stage0.sh",
    "#!/bin/sh\nprintf '%s\\n' " + shQuote(root + "/bit-out/bin/bit") + "\n",
  ) catch _ {
    exit(1)
  }
  let expected = ""
  for name of gateNames() {
    expected = expected + name + "\n"
  }
  writeFile(root + "/expected.unsorted", expected) catch _ {
    exit(1)
  }
  let cases = prepushBudgetCases()
  let run = prepushRunScript(root, cases)
  mustSucceed("gateregistry", "actual prepush phase order and failure continuation", run)
  budgetDriverFixture(root)
  rmrf(root)
  assert(!exists(root))
}

fn budgetSelfTest() {
  assert(parseCpuBudget("") == 0)
  assert(parseCpuBudget("2147483647") == 2147483647)
  for bad of ["0", "-1", "two", "1.5", " 2", "2147483648", "99999999999999999999"] {
    assert(parseCpuBudget(bad) == -1)
  }
  for requested of [1, 2, 6, 8, 12, 18] {
    assert(budgetJobs(requested, 0) == requested)
    assert(pairJobs(requested, 0) == requested)
    assert(nestedJobs(requested, 0) == requested)
    assert(budgetJobs(requested, 1) == 1)
    assert(nestedJobs(requested, 1) == 1 && nestedJobs(requested, 2) == budgetJobs(requested, 2))
    assert(pairJobs(requested, 1) == 1 && pairJobs(requested, 2) == 1)
    let previous = 0
    let budget = 1
    while (budget <= 32) {
      let width = pairJobs(requested, budget)
      assert(width >= previous && width * 2 <= budget + 1)
      assert(budgetJobs(requested, budget) <= budget)
      assert(budgetJobs(requested, budget) <= budgetJobs(requested, budget + 1))
      previous = width
      budget = budget + 1
    }
  }
  assert(hostJobsScript(1) == "N=1\n" + budgetEnvScript(1))
  assert(hostJobsScript(2) == "N=2\n" + budgetEnvScript(1))
  assert(
      hostJobsScript(0) ==
      "N=$(getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)\n",
  )
}

fn budgetSharesSelfTest() {
  assert(budgetEnvScript(0) == "")
  assert(nestedEnvScript(18, 0) == "")
  for budget of [1, 2, 3, 4, 8, 17] {
    for count of [1, 2, 4, 7] {
      for slots of [1, 2, 4, 16] {
        let width = fanoutJobs(slots, count, budget)
        let share = budgetShare(budget, width)
        assert(width > 0)
        assert(width <= count)
        assert(width <= slots)
        assert(width <= budget)
        assert(share > 0)
        assert(width * share <= budget)
        assert(nestedJobs(18, share) == share)
      }
    }
  }
  assert(budgetShare(4, 1) == 4)
  assert(budgetShare(4, 2) == 2)
  assert(budgetShare(4, 4) == 1)
  assert(fanoutJobs(16, 1, 0) == 16)
  assert(budgetShare(0, 16) == 0)
}

fn differentialEnvFixture(root: string) {
  let run = "set -eu\n"
  let i = 0
  for overrides of [
    ["DIFFALL_JOBS=99"], ["DIFFALL_JOBS=1"],
    ["DIFFALL_JOBS=99", "DIFFALL_JOBS=1"],
    ["DIFFALL_JOBS=1", "DIFFALL_JOBS=99"],
    ["DIFFALL_JOBS=bad"], ["DIFFALL_JOBS=0"],
  ] {
    let g = Gate{ name = "test-differentials", argv = []string(0), env = overrides }
    let want = 1
    if (i == 0 || i == 3) {
      want = 3
    }
    let capped = differentialJobsScript(g, 6)
    assert(capped == "DIFFALL_JOBS=${want}\nexport DIFFALL_JOBS\n")
    assert(differentialJobsScript(g, 0) == "")
    assert(differentialJobsScript(g, 1) == "DIFFALL_JOBS=1\nexport DIFFALL_JOBS\n")
    assert(differentialJobsScript(g, 2) == "DIFFALL_JOBS=1\nexport DIFFALL_JOBS\n")
    let script = "DIFFALL_JOBS=99\nexport DIFFALL_JOBS\n"
    for kv of overrides {
      script = script + kv + "\n"
    }
    script = script + capped + "[ \"$DIFFALL_JOBS\" -eq ${want} ]\n"
    let path = root + "/env-${i}.sh"
    writeFile(path, script) catch _ {
      exit(1)
    }
    run = run + "sh " + shQuote(path) + "\n"
    i = i + 1
  }
  mustSucceed("gateregistry", "effective per-gate differential widths", run)
}

// The first wave meets at a barrier, so every admitted slot must run.
const budgetWorkerScript: string = `#!/bin/sh
set -eu
base=$1; group=$2
[ "$BIT_MAKE_CPU_BUDGET" -eq 1 ]
lock() {
  n=0
  until mkdir "$base/lock" 2>/dev/null; do
    n=$((n + 1)); [ "$n" -lt 5000 ] || exit 125
    sleep 0.001
  done
}
lock
: > "$base/live/$group.$$"
total=$(find "$base/live" -type f | wc -l)
own=$(find "$base/live" -name "$group.*" | wc -l)
[ "$total" -le "$(cat "$base/limit")" ]
[ "$own" -le "$(cat "$base/share")" ]
[ "$total" -le "$(cat "$base/peak")" ] || echo "$total" > "$base/peak"
[ "$own" -le "$(cat "$base/peak-$group")" ] || echo "$own" > "$base/peak-$group"
[ "$total" -lt "$(cat "$base/limit")" ] || : > "$base/open"
rmdir "$base/lock"
n=0
while [ ! -f "$base/open" ]; do
  n=$((n + 1)); [ "$n" -lt 5000 ] || exit 125
  sleep 0.001
done
sleep 0.01
lock
rm "$base/live/$group.$$"
rmdir "$base/lock"
`

fn budgetPoolFixture(root: string, budget: int, count: int, slots: int) {
  let width = fanoutJobs(slots, count, budget)
  let share = budgetShare(budget, width)
  let total = width * share
  let base = root + "/pool-${budget}-${count}-${slots}"
  mustSucceed("gateregistry", "owned nested pool", "mkdir -p " + shQuote(base + "/live"))
  writeFile(base + "/worker.sh", budgetWorkerScript) catch _ {
    exit(1)
  }
  let run = "set -eu\nbase=" +
    shQuote(base) +
    "\necho ${total} > \"$base/limit\"\necho ${share} > \"$base/share\"\necho 0 > \"$base/peak\"\n"
  let group = 0
  while (group < width) {
    let path = base + "/group-${group}.sh"
    let script = hostJobsScript(share) +
      "printf '1\\n2\\n3\\n4\\n5\\n6\\n7\\n8\\n' | xargs -n1 -P \"$N\" sh " +
      shQuote(base + "/worker.sh") +
      " " +
      shQuote(base) +
      " ${group}\n"
    writeFile(path, script) catch _ {
      exit(1)
    }
    run = run + "echo 0 > \"$base/peak-${group}\"\nsh " + shQuote(path) + " &\np${group}=$!\n"
    group = group + 1
  }
  group = 0
  while (group < width) {
    run = run + "wait \"$p${group}\"\n[ \"$(cat \"$base/peak-${group}\")\" -eq ${share} ]\n"
    group = group + 1
  }
  run = run + "[ \"$(cat \"$base/peak\")\" -eq ${total} ]\n[ -z \"$(ls -A \"$base/live\")\" ]\n"
  mustSucceed("gateregistry", "nested pool budget=${budget} count=${count} slots=${slots}", run)
}

const budgetDriverChildScript: string = `#!/bin/sh
set -eu
root=$1; name=$2; base=$(cat "$root/share-probe")
printf '%s\n' "$BIT_MAKE_CPU_BUDGET" > "$base/shares/$name"
mkdir "$base/active/$name"
if [ "$name" = test-differentials ]; then
  [ "$BIT_MAKE_CPU_BUDGET" -eq 4 ]
  [ "$(ls "$base/done" | wc -l)" -eq 2 ]
  [ "$(ls "$base/active" | wc -l)" -eq 1 ]
else
  N=$BIT_MAKE_CPU_BUDGET
  BIT_MAKE_CPU_BUDGET=1
  export BIT_MAKE_CPU_BUDGET
  printf '1\n2\n3\n4\n5\n6\n7\n8\n' | xargs -n1 -P "$N" sh "$root/share-worker.sh" "$base" "$name"
fi
: > "$base/done/$name"
rmdir "$base/active/$name"
[ "$name" != "$(cat "$base/fail")" ]
`

fn budgetDriverCase(root: string, budget: int, names: []string, failedGate: string, mixed: bool) {
  let pooled = len(names)
  if (mixed) {
    pooled = pooled - 1
  }
  let width = fanoutJobs(4, pooled, budget)
  let share = budgetShare(budget, width)
  let base = root + "/driver-${budget}-${len(names)}-${failedGate}"
  let run = "set -eu\nf=" + shQuote(root) + "\nbase=" + shQuote(base) + "\n"
  run = run + "mkdir -p \"$base/live\" \"$base/active\" \"$base/shares\" \"$base/done\"\n"
  run = run +
    "echo \"$base\" > \"$f/share-probe\"\necho ${width * share} > \"$base/limit\"\necho ${share} > \"$base/share\"\necho 0 > \"$base/peak\"\n"
  run = run + "printf '%s' " + shQuote(failedGate) + " > \"$base/fail\"\n"
  let argv = ""
  for name of names {
    run = run + "echo 0 > \"$base/peak-${name}\"\n"
    argv = argv + " " + shQuote(name)
  }
  run = run +
    "set +e\nenv -i PATH=\"$PATH\" TMPDIR=\"$f/\" BIT_MAKE_ROOT=\"$f\" BIT_MAKE_CPU_BUDGET=${budget} BIT_MAKE_JOBS=4 BIT_LIBBITRT_TREE=" +
    shQuote(envOr("BIT_LIBBITRT_TREE", "")) +
    " \"$f/bit-out/make/make-driver\"" +
    argv +
    " > \"$base/driver.log\" 2>&1\nrc=$?\nset -e\n"
  let want = 0
  if (failedGate != "") {
    want = 1
  }
  run = run +
    "[ \"$rc\" -eq ${want} ]\n[ -z \"$(ls -A \"$base/active\")\" ]\n[ -z \"$(ls -A \"$base/live\")\" ]\n[ \"$(ls \"$base/done\" | wc -l)\" -eq ${len(names)} ]\n[ \"$(cat \"$base/peak\")\" -eq ${width *
      share} ]\n"
  for name of names {
    let inherited = share
    if (mixed && name == "test-differentials") {
      inherited = budget
    }
    run = run + "[ \"$(cat \"$base/shares/${name}\")\" -eq ${inherited} ]\n"
    run = run +
      "printf 'gateregistry: inherited gate=${name} share=%s\\n' \"$(cat \"$base/shares/${name}\")\"\n"
  }
  run = run +
    "printf 'gateregistry: driver budget=${budget} gates=${len(names)} native=%s peak=%s drained\\n' \"$rc\" \"$(cat \"$base/peak\")\"\nrm \"$f/share-probe\"\n"
  mustSucceed("gateregistry", "actual driver inherited shares and drain", run)
}

fn budgetDriverFixture(root: string) {
  writeFile(root + "/share-worker.sh", budgetWorkerScript) catch _ {
    exit(1)
  }
  writeFile(root + "/share-child.sh", budgetDriverChildScript) catch _ {
    exit(1)
  }
  let two = ["test-golden", "test-checker-diag"]
  let four = ["test-golden", "test-checker-diag", "test-gate-registry", "test-fmt-strict"]
  budgetDriverCase(root, 4, ["test-golden"], "", false)
  budgetDriverCase(root, 4, two, "", false)
  budgetDriverCase(root, 4, four, "", false)
  budgetDriverCase(root, 1, two, "", false)
  budgetDriverCase(root, 4, two, "test-golden", false)
  budgetDriverCase(root, 4, ["test-golden", "test-checker-diag", "test-differentials"], "", true)
}

fn budgetScriptFixture(root: string) {
  let probe = root + "/probe"
  mustSucceed("gateregistry", "owned CPU probe", "mkdir " + shQuote(probe))
  writeFile(probe + "/getconf", "#!/bin/sh\necho 18\n") catch _ {
    exit(1)
  }
  let run = "chmod 700 " + shQuote(probe + "/getconf") + "\n"
  for budget of [0, 1, 2, 4] {
    let width = nestedJobs(18, budget)
    let path = probe + "/width-${budget}.sh"
    writeFile(path, hostJobsScript(budget) + "[ \"$N\" -eq ${width} ]\n") catch _ {
      exit(1)
    }
    run = run + "PATH=" + shQuote(probe) + ":\"$PATH\" sh " + shQuote(path) + "\n"
  }
  mustSucceed("gateregistry", "generated nested widths default/1/2/4", "set -e\n" + run)
}

fn hashseedScriptFixture(root: string) {
  let probe = root + "/probe"
  writeFile(probe + "/xargs", "#!/bin/sh\nprintf '%s\\n' \"$@\"\n") catch _ {
    exit(1)
  }
  writeFile(probe + "/list", "") catch _ {
    exit(1)
  }
  let run = "set -e\nchmod 700 " + shQuote(probe + "/xargs") + "\n"
  for budget of [0, 1, 2] {
    let want = 8
    if (budget > 0) {
      want = budget
    }
    let path = probe + "/hashseed-${budget}.sh"
    writeFile(path, hashseedPoolScript(probe, "/compiler path", "1 2 3", 8, budget)) catch _ {
      exit(1)
    }
    run = run + "PATH=" + shQuote(probe) + ":\"$PATH\" sh " + shQuote(path) + "\n"
    run = run + "[ \"$(sed -n '4p' " + shQuote(probe + "/out") + ")\" -eq ${want} ]\n"
    run = run +
      "[ \"$(sed -n '6p' " +
      shQuote(probe + "/out") +
      ")\" = " +
      shQuote(probe + "/worker.sh") +
      " ]\n"
    run = run + "[ \"$(sed -n '7p' " + shQuote(probe + "/out") + ")\" = '/compiler path' ]\n"
  }
  mustSucceed("gateregistry", "actual hashseed script widths default/1/2", run)
}

fn coveredNames(): map<string, bool> {
  let out = map<string, bool>{}
  for n of gateNames() {
    out[n] = true
  }
  return out
}

// One line per gate this registry could not account for, so a failure names
// exactly what to fix rather than a bare non-zero exit.
fn accountingFailures(gates: []Gate, covered: map<string, bool>): []string {
  let out = []string(0)
  for g of gates {
    let inTest = covered[g.name]
    if (!inTest && len(g.excludeReason) == 0) {
      out = append(out, "'${g.name}' is absent from gateNames() with no excludeReason")
    }
    if (inTest && len(g.excludeReason) > 0) {
      out = append(
        out,
        "'${g.name}' is in gateNames() but still carries excludeReason \"${g.excludeReason}\"",
      )
    }
  }
  return out
}

fn printExcluded(gates: []Gate, covered: map<string, bool>) {
  for g of gates {
    if (!covered[g.name]) {
      print("gateregistry: excluded ${g.name} — ${g.excludeReason}\n")
    }
  }
}

fn main() {
  budgetSelfTest()
  budgetSharesSelfTest()
  let gates = gateTable()
  let covered = coveredNames()
  printExcluded(gates, covered)
  let failures = accountingFailures(gates, covered)
  if (len(failures) > 0) {
    for f of failures {
      eprint("gateregistry: FAIL ${f}\n")
    }
    eprint("gateregistry: ${len(failures)} gate(s) not accounted for\n")
    exit(1)
  }
  print("gateregistry: ${len(gates)} gate(s), ${len(gates) - len(gateNames())} excluded, 0 unaccounted\n")
  prepushFixture(gates, covered)
}
