// _tests_/bit/ormrelauto/relautox/relautox.bit — R2b (#6322, epic #6298)
// live acceptance fixture: `relAutoXTouchAuthorName` lives in THIS module,
// a DIFFERENT module (SPEC §17.1: a directory is one module) than
// `pkg/orm` (which declares `RelAutoPost` and runs the query) or
// `../relautoc` (`relautoc.test.bit`, which calls this function ACROSS the
// module boundary with a NAMED argument, `post = post`). Under `_tests_/`,
// not `pkg/orm/`, so it never ships with a `bit add orm` release (a
// package release is `git archive <tag>` of `pkg/orm` alone).
//
// `RelAutoPost` stays declared in `pkg/orm` itself, imported here rather
// than redeclared: only the FUNCTION needs to cross the module boundary
// here. (A `@table` class declared outside pkg/orm works too, see
// `../relautod`, #6324.)
import { RelAutoPost } from "../../../../pkg/orm"

export fn relAutoXTouchAuthorName(post: RelAutoPost): string {
  return post.author.name
}
