// _tests_/bit/ormrelauto/relautod/relautod.bit — regression fixture for
// #6324: a `@table` class declared in a module that reaches pkg/orm through
// an import path whose TEXT does not end in `/orm` (the trailing slash below;
// the same holds for a module nested beneath pkg/orm importing `"../"`).
// Before the fix the compiler recognised pkg/orm by import spelling and by
// directory suffix, so it never synthesized `__fromRow`/`__loadRelation`/
// `__linkRelation` for `RelAutoDNote`, and `db.table<RelAutoDNote>()` failed
// E0051 (`Tabled` not satisfied). It now recognises pkg/orm by the module the
// import RESOLVES to, whatever the spelling.
//
// Under `_tests_/`, not `pkg/orm/`, so it never ships with a `bit add orm`
// release (a package release is `git archive <tag>` of `pkg/orm` alone).
// `../relautoc/relautoc.test.bit` calls it, which is what compiles it.
import { Repo, open } from "../../../../pkg/orm/"

export @table class RelAutoDNote {
  export id: i64,
  export title: string,
}

export fn relAutoDOpen(uri: string): Repo<RelAutoDNote>! {
  let db = open(uri)?
  return db.table<RelAutoDNote>()
}

export fn relAutoDLinkBogus(repo: Repo<RelAutoDNote>, note: RelAutoDNote): ()! {
  repo.link(note, "bogus", [1])?
}
