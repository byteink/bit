// #6389: permanent positive compiler case; both return queries load author
// automatically. The existing ORM module compiles it without a live database.
import { Db } from "../../../../pkg/orm"

@table class Author {
  id: i64,
  name: string,
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn pick(db: Db, first: bool): Post! {
  if (first) {
    return db.table<Post>().find(1)?
  }
  return db.table<Post>().find(2)?
}

fn run(db: Db): string! {
  let p = pick(db, false)?
  return p.author.name
}

fn main() {}
