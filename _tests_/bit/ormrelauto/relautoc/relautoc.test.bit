// _tests_/bit/ormrelauto/relautoc/relautoc.test.bit — R2b (#6322, epic
// #6298) own live acceptance: THIS module (SPEC §17.1) calls `pkg/orm`'s
// `relAutoQueryPostsForCrossModule` (the query, in module A) and, off its
// return value, `../relautox`'s `relAutoXTouchAuthorName` (the relation
// read, in module B) — with a NAMED argument, `post = post`. Both gaps R2
// (#6305) left unprovable by design at once (a call into another module,
// a call with a named argument).
//
// UNDER `_tests_/`, NOT `pkg/orm/`: a package release is `git archive
// <tag>` of `pkg/orm` alone, so a fixture module living inside it would
// ship to every `bit add orm` user.
//
// THIS SHAPE, NOT A/B CALLING EACH OTHER DIRECTLY: `../relautox` imports
// `pkg/orm` for `RelAutoPost`'s own TYPE (`relautox.bit`'s own header), so
// `pkg/orm` importing `../relautox` back — the more obvious shape — is an
// import cycle (E0044). A third module importing BOTH is the only DAG that
// lets one function call the other with the row still typed.
//
// NO "postgres"/"std/sql" IMPORT HERE: `relAutoSeedCrossModuleFixture`
// (`pkg/orm/relationauto.test.bit`) does the whole live-db setup and hands
// back an already-wrapped `Repo<RelAutoPost>` — pkg/orm's OWN `bit.lock`
// declares "postgres"/"mysql"; this module has its own `bit.json`/
// `bit.lock` instead (local-path deps, `./bit.json`'s own header) rather
// than inheriting pkg/orm's, since a nested module cannot yet do that.
import { env } from "std/os"
import { contains } from "std/strings"
import {
  RelAutoPost, Repo, relAutoQueryPostsForCrossModule, relAutoSeedCrossModuleFixture,
} from "../../../../pkg/orm"
import { relAutoXTouchAuthorName } from "../relautox"
import { RelAutoDNote, relAutoDOpen, relAutoDLinkBogus } from "../relautod"

// The splice must land on `relAutoQueryPostsForCrossModule`'s own
// `posts.all()?` (module A) even though the `.author.name` read is two
// calls away, in a DIFFERENT module (B) reached by a NAMED argument.
fn relAutoCReadAuthorNames(posts: Repo<RelAutoPost>): []string! {
  let names = []string(0)
  for post of relAutoQueryPostsForCrossModule(posts)? {
    names = append(names, relAutoXTouchAuthorName(post = post))
  }
  return names
}

test "live: R2b auto-with follows a row across MODULE boundaries through a NAMED argument (#6322)" {
  let uri = env("ORM_TEST_LIVE_PG_URI")
  if (uri == "") {
    print("  skipped: ORM_TEST_LIVE_PG_URI is unset, no live server to talk to")
    return
  }
  let (posts, logger) = relAutoSeedCrossModuleFixture(uri) catch e {
    assert(false, "relAutoSeedCrossModuleFixture failed: ${e.message()}")
    return
  }
  let names = relAutoCReadAuthorNames(posts) catch e {
    assert(false, "relAutoCReadAuthorNames failed: ${e.message()}")
    return
  }
  assert(len(names) == 2, "expected 2 posts, got ${len(names)}")
  assert(
    names[0] == "Ada" && names[1] == "Ada",
    "relAutoXTouchAuthorName's own post.author.name must read the loaded author",
  )
  assert(
    logger.statementCount == 2,
    "reading post.author.name across two MODULE boundaries through a NAMED argument must still issue exactly 2 statements (#6322), got ${logger.statementCount}",
  )
}

// #6324: `Repo<T>.link` on a `@table` class whose module imports pkg/orm
// through a path not ending in `/orm` (`../relautod`'s own header). Compiling
// this call is the regression proof; the live half pins that the synthesized
// `__linkRelation` really dispatches: an unknown relation name is an error.
test "live: a @table class imported through an unusual pkg/orm path links through Repo<T> (#6324)" {
  let uri = env("ORM_TEST_LIVE_PG_URI")
  if (uri == "") {
    print("  skipped: ORM_TEST_LIVE_PG_URI is unset, no live server to talk to")
    return
  }
  let repo = relAutoDOpen(uri) catch e {
    assert(false, "relAutoDOpen failed: ${e.message()}")
    return
  }
  relAutoDLinkBogus(repo, RelAutoDNote{ id = 1, title = "t" }) catch e {
    assert(
      contains(e.message(), "bogus"),
      "the error must name the unknown relation, got: ${e.message()}",
    )
    return
  }
  assert(false, "linking an unknown relation must fail")
}
