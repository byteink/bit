// #7726. The measured rows and their per-platform tables, split out of
// `gcretention.bit` so it stays under the 800-line ceiling. Module-level names
// are shared across the module's files, so the harness reads `Row`,
// `stressRows`, `pacedRowsFor` and `platformName` unqualified.

// One measured row. `source` empty means bench/cases/<name>/<name>.bit; a
// non-empty `source` is written to scratch and built from there.
//
// PACED row (`stress: false`): `minKb` is exported as BIT_GC_MIN_KB and `swept`
// / `live` are exact two-sided pins. -1 in either means "not measured on this
// platform" and skips the pin, exactly as benchgate's `objects: -1` does.
//
// STRESS row (`stress: true`): BIT_GC=stress, `live` must be 0 and `swept` must
// be at least `sweptFloor`. `minKb`, `swept` and `live` are unused.
class Row {
  name: string,
  source: string,
  stress: bool,
  minKb: int,
  swept: int,
  live: int,
  sweptFloor: int,
}

// The stress arm. Platform-independent by construction — no baseline, so these
// rows run and can FAIL on every host, including one with no paced table.
//
// The floors are ~83% and ~41% of the totals measured on `beab7b12` (builder
// 60025) and, after #5473 widened churn to 48 batches, here (churn 24150);
// they exist only to stop `live == 0` passing vacuously on a fixture that
// stopped allocating, so a loose floor is correct here and a tight one would
// be a second unpinned baseline.
fn stressRows(): []Row {
  return [
    Row{
      name = "builder", source = builderSource(), stress = true, minKb = 0,
      swept = 0 - 1, live = 0 - 1, sweptFloor = 50000,
    },
    Row{
      name = "churn", source = churnSource(), stress = true, minKb = 0,
      swept = 0 - 1, live = 0 - 1, sweptFloor = 10000,
    },
  ]
}

// The paced arm, macOS/aarch64. Every number below was read on `beab7b12` and
// was identical on every repetition (7 for each bench case, 5 for each owned
// fixture). RE-DERIVE ANY ROW WITH ONE COMMAND, from the repository root:
//
//   BIT_GC_MIN_KB=4096 BIT_GC_STATS=1 ./bit-out/bin/bit run bench/cases/alloc/alloc.bit
//
// (substitute the row's own minKb and path; the owned fixtures print their
// generated source path in this gate's own output). Read `swept=` and `live=`
// off the `[bit-gc]` line on stderr. Nothing else is needed and no script
// exists for it — that is the point of an exactly deterministic counter.
//
// The bench cases carry 4096 because that is the documented default
// (runtime/ABI.md), verified here to give byte-identical counters to an unset
// BIT_GC_MIN_KB; the owned fixtures carry 512 because at 4096 churn never
// collects at all (collections=0, swept=0) and a row that never sweeps cannot
// see a retention change.
fn pacedRowsMacosArm64(): []Row {
  return [
    Row{
      name = "builder", source = builderSource(), stress = false, minKb = 512,
      swept = 56887, live = 3134, sweptFloor = 0,
    },
    Row{
      name = "churn", source = churnSource(), stress = false, minKb = 512,
      swept = 22132, live = 2014, sweptFloor = 0,
    },
    Row{
      name = "alloc", source = "", stress = false, minKb = 4096,
      swept = 9980985, live = 25017, sweptFloor = 0,
    },
    Row{
      name = "json", source = "", stress = false, minKb = 4096,
      swept = 1200034, live = 2550026, sweptFloor = 0,
    },
    Row{
      name = "sort", source = "", stress = false, minKb = 4096,
      swept = 342591, live = 257427, sweptFloor = 0,
    },
  ]
}

// Keyed on `hostTarget()`'s ordinal — BOTH platform and architecture, never
// `uname -s` alone, for the reason benchgate's `baselinesFor` gives: an
// aarch64-linux run compared against an x86_64-linux table produces a
// confidently wrong verdict.
fn pacedRowsFor(target: int): []Row {
  if (target == 2) {
    return pacedRowsMacosArm64()
  }
  return []
}

fn platformName(target: int): string {
  if (target == 0) {
    return "linux/x86_64"
  }
  if (target == 1) {
    return "linux/aarch64"
  }
  if (target == 2) {
    return "macos/aarch64"
  }
  return "unknown hostTarget() ordinal ${target}"
}
