// #4408. The generated fixture programs `gcretention.bit` builds and measures,
// split out of it so neither file crosses the 800-line ceiling. Module-level
// names are shared across the module's files, so the harness reads
// `builderSource`, `churnSource`, `staleSource` and `staleBytes` unqualified.

// ---------------------------------------------------------------------------
// Fixtures this gate owns
// ---------------------------------------------------------------------------

// #4402's own smallest reproduction of the false-root retention, verbatim
// apart from N: a std/strings builder fed an INTERPOLATED string. Both halves
// are required — interpolation alone shows no difference, and a builder fed a
// constant string shows no difference; together they drive `copyBytes`, the
// runtime leaf whose frame held the raw heap addresses.
const builderN: int = 20000

fn builderSource(): string {
  return "import { newBuilder } from \"std/strings\"\n\n" +
    "fn main() {\n" +
    "  let b = newBuilder()\n" +
    "  let i = 0\n" +
    "  while (i < ${builderN}) {\n" +
    "    b.write(\"user\${i}-\${i}\")\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  print(\"\${len(b.toString())}\\n\")\n" +
    "}\n"
}

// bench/cases/alloc's shape, reduced so the stress arm stays under a second:
// batches of short-lived nodes, each an independent heap object, summed and
// dropped. `owner` is a REFERENCE field and is not decoration — a class whose
// fields are all scalars is packed inline into the slice's own buffer (#3862,
// runtime/ABI.md §2) and allocates no per-element objects at all, which would
// quietly turn this fixture into one that measures nothing.
//
// churnBatches was 40 until #5473. At 40 batches (BIT_GC_MIN_KB=512) the
// fixture collects exactly TWICE, and a stray conservative-scan root can
// delay the second collection by one whole batch of 503 objects — see the
// pacedAttempts comment below for why that made the row a lottery. 48
// batches collects three times instead and landed on the SAME pin over
// 200/200 direct runs of the built fixture (this gate prints the generated
// fixture's path on every run; BIT_GC_MIN_KB=512 BIT_GC_STATS=1 <that path>,
// looped) — moving off the exact straddle point removes the lottery rather
// than outrunning it with more attempts.
const churnBatches: int = 48
const churnPer: int = 500

fn churnSource(): string {
  return "class Batch { id: i64 }\n" +
    "class Node { x: i64, y: i64, owner: Batch }\n\n" +
    "fn main() {\n" +
    "  let total = 0\n" +
    "  let b = 0\n" +
    "  while (b < ${churnBatches}) {\n" +
    "    let owner = Batch{ id = b }\n" +
    "    let nodes = []Node(0, ${churnPer})\n" +
    "    let k = 0\n" +
    "    while (k < ${churnPer}) {\n" +
    "      nodes = append(nodes, Node{ x = b + k, y = k + 1, owner = owner })\n" +
    "      k = k + 1\n" +
    "    }\n" +
    "    for nd of nodes {\n" +
    "      total = total + nd.x + nd.y + nd.owner.id\n" +
    "    }\n" +
    "    b = b + 1\n" +
    "  }\n" +
    "  print(\"\${total}\\n\")\n" +
    "}\n"
}

// #6410: `fill` spills 24 holders of one buffer; `late` defines its 24 only on
// an untaken branch, so its collecting loop scans `fill`'s dead words (class 8)
// unless the prologue zeroed them: peakbytes=21110784 kept on 661afc8ff, 9314304 freed.
const staleBytes: int = 8388608

fn staleSource(): string {
  let hs = ""
  let sum = ""
  let i = 0
  while (i < 24) {
    hs = "${hs}  let h${i} = Holder{ data = big, k = ${i} }\n"
    sum = "${sum} + h${i}.k"
    i = i + 1
  }
  let body = "  let big = []u8(n)\n${hs}  let s = spin(n % 7)\n  return s${sum}\n"
  let loop = "  let i = 0\n  let acc = 0\n  while (i < 4000) {\n    let t = []u8(4096 + i % 7)\n    acc = acc + i * n + len(t)\n    i = i + 1\n  }\n"
  return "class Holder { data: []u8, k: int }\n\nfn spin(d: int): int {\n  if (d <= 0) {\n    return 0\n  }\n  return spin(d - 1) + d\n}\n\n" +
    "fn fill(n: int): int {\n${body}}\n\nfn late(n: int): int {\n${loop}  if (n > 100) {\n${body}  }\n  return acc\n}\n\n" +
    "fn main() {\n  let x = fill(${staleBytes})\n  let _ = late(x % 3 + 1)\n}\n"
}
