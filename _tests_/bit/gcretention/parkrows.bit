// #7788. The parked-roots arm of `gcretention.bit`: one program
// (`parkroots/parkroots.bit`, whose header says what it holds and why), built
// once and run eight ways: four, and the same four with the conservative scan
// off. `swept`/`live` are not pinned here; the verdict is the program's own
// canary count, which `parkroots` prints as `parkroots OK` only at zero
// mismatches, plus a floor on `collections` so a run that never collected
// cannot pass.
//
// BIT_WORKERS=8 is where a helper joins the gang and the stopped tasks' ranges
// become root jobs (`gcRtScanSeg`, runtime/gc/gcmark.bit); BIT_WORKERS=1 is the
// inline path (`gcRootRange` marks the range itself). The mutation that drops
// every range word in `gcRtScanSeg` reaches only the first, so the second is
// what catches the same mistake in `gcRootRange`. The stress runs size the work
// down (PARKROOTS_PARKERS, PARKROOTS_CHURN): BIT_GC=stress collects at every
// safepoint, so its cost is churn times the live set.
//
// The floors are under a third of the lowest `collections` in 10 runs of each
// configuration on aarch64-macos: paced W1 66, paced W8 104, stress W1 6073,
// stress W8 1237 (3004 to 3949 in the other nine; the minimum is a pause-heavy
// run). They only stop a run that never collected from passing.

class ParkRun {
  name: string,
  workers: int,
  stress: bool,
  noCons: bool,
  parkers: int,
  churn: int,
  runners: int,
  floor: int,
}

// The four configurations, with the conservative stack scan on or off.
fn parkRunsWith(noCons: bool): []ParkRun {
  let sfx = ""
  if (noCons) {
    sfx = "_nocons"
  }
  return [
    ParkRun{
      name = "parkroots_w1_paced${sfx}",
      workers = 1,
      stress = false,
      noCons = noCons,
      parkers = 256,
      churn = 1000000,
      runners = 0,
      floor = 20,
    },
    ParkRun{
      name = "parkroots_w8_paced${sfx}",
      workers = 8,
      stress = false,
      noCons = noCons,
      parkers = 256,
      churn = 1000000,
      runners = 7,
      floor = 30,
    },
    ParkRun{
      name = "parkroots_w1_stress${sfx}",
      workers = 1,
      stress = true,
      noCons = noCons,
      parkers = 64,
      churn = 4000,
      runners = 0,
      floor = 1500,
    },
    ParkRun{
      name = "parkroots_w8_stress${sfx}",
      workers = 8,
      stress = true,
      noCons = noCons,
      parkers = 64,
      churn = 4000,
      runners = 7,
      floor = 300,
    },
  ]
}

fn parkRunScript(run: ParkRun, prog: string, outPath: string, errPath: string): string {
  let gc = "BIT_GC_MIN_KB=64\nexport BIT_GC_MIN_KB\n"
  if (run.stress) {
    gc = "BIT_GC=stress\nexport BIT_GC\n"
  }
  let noCons = 0
  if (run.noCons) {
    noCons = 1
  }
  return "#!/bin/sh\n" +
    gc +
    "BIT_WORKERS=${run.workers}\nexport BIT_WORKERS\n" +
    "PARKROOTS_PARKERS=${run.parkers}\nexport PARKROOTS_PARKERS\n" +
    "PARKROOTS_CHURN=${run.churn}\nexport PARKROOTS_CHURN\n" +
    "PARKROOTS_RUNNERS=${run.runners}\nexport PARKROOTS_RUNNERS\n" +
    "PARKROOTS_NOCONS=${noCons}\nexport PARKROOTS_NOCONS\n" +
    "BIT_GC_STATS=1\nexport BIT_GC_STATS\n" +
    "exec '${prog}' > '${outPath}' 2> '${errPath}'\n"
}

fn evalParkRun(ctx: Ctx, run: ParkRun, prog: string) {
  let outPath = "${ctx.scratch}/out_${run.name}.txt"
  let errPath = "${ctx.scratch}/err_${run.name}.txt"
  let code = runScript(
    "${ctx.scratch}/run_${run.name}.sh",
    parkRunScript(run, prog, outPath, errPath),
    ctx.ms,
  ) catch e {
    check(ctx.t, false, "${run.name}: ${e.message()}")
    return
  }
  let out = readFile(outPath) catch _ {
    ""
  }
  let err = readFile(errPath) catch _ {
    ""
  }
  let collections = intAfter(err, "collections=")
  print("gcretention: ${run.name}: exit ${code}, collections=${collections} (want >= ${run.floor}), stdout: ${out}")
  check(
    ctx.t, code == 0 && out == "parkroots OK\n",
    "${run.name}: exit ${code}, stdout ${out}: a parked or stopped task's canary was freed or the run crashed (#7788)",
  )
  check(
    ctx.t, collections >= run.floor,
    "${run.name}: collections=${collections}, want at least ${run.floor} — too few collections for the canaries to mean anything",
  )
}

fn evalParkRoots(ctx: Ctx) {
  let src = "${ctx.benchDir}/../../_tests_/bit/gcretention/parkroots/parkroots.bit"
  let prog = "${ctx.scratch}/parkroots"
  let build = buildFixture(ctx, src, prog, "parkroots") catch e {
    check(ctx.t, false, "parkroots: ${e.message()}")
    return
  }
  check(
    ctx.t,
    build == 0 && exists(prog),
    "parkroots: ${src} must compile (bit build exited ${build})",
  )
  if (build != 0 || !exists(prog)) {
    return
  }
  for run of parkRunsWith(false) {
    evalParkRun(ctx, run, prog)
  }
  for run of parkRunsWith(true) {
    evalParkRun(ctx, run, prog)
  }
}
