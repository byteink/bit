// #7788. The roots of parked tasks are marked, checked by canaries instead of
// by luck.
//
// #7783 moved how the collector reaches them: a stopped task's stack, scratch
// and saved-register ranges became root JOBS (`gcRtRunJob`,
// runtime/gc/gcmark.bit). Mutating `gcRtScanSeg` so no range word is marked
// (`w >= lo` -> `w >= hi`) was caught by one parkroots segfault in one of three
// runs; `test-gc-retention` and `test-stress` stayed green, because nothing
// they run holds an object that ONLY a parked frame reaches.
//
// This program does. `parkers` tasks each build canaries, hand a token to main
// and block on `gate`. From then on every canary is reachable through that
// task's stack frame and saved registers and nothing else: no global, no
// channel, no other object, and the spawn thunk carries one int. Each canary
// is an `Obj` (with a `Box` behind it) whose three fields derive from one tag.
// Main churns a ring of objects of the SAME shape while the pool collects, so
// every slot the collector frees is handed out again with other contents; then
// it opens the gate and each parker re-checks its own canaries. The verdict is
// the number of mismatches, never a timing: `parkroots OK` is printed at zero.
//
// `runners` tasks never park. They keep canaries in locals across a loop that
// allocates and re-verifies every round, so main's collections stop their
// threads mid-frame, and a stopped mutator is a helper for the gang: it is
// what makes the stopped tasks' ranges root JOBS (BIT_WORKERS=8). With one
// worker there is no helper and `gcRootRange` marks the same ranges inline;
// `runners` is 0 there, since a runner would only be another parked task.
//
// What this does NOT pin is the frame-job half of #7783 (`gcRootSnapshot`): a
// stopped mutator on a task stack is also scanned conservatively (class 10 in
// runtime/stw/stw.bit), so dropping its precise walk changes nothing here.
//
// Env knobs, so the paced and BIT_GC=stress arms can size the work for what
// each costs (stress collects at every safepoint, so its cost is churn times
// the live set): PARKROOTS_PARKERS, PARKROOTS_CHURN, PARKROOTS_RUNNERS.
import { envOr, exit } from "std/os"
import { parseInt } from "std/strings"

const goToken: i64 = 7

class Box { v: i64 }
class Obj { tag: i64, a: i64, box: Box }

fn knob(name: string, dflt: i64): i64 {
  let n = parseInt(envOr(name, "")) catch _ {
    dflt
  }
  if (n < 0) {
    return dflt
  }
  return n
}

fn mk(tag: i64): Obj {
  return Obj{ tag = tag, a = tag * 31 + 7, box = Box{ v = tag * 17 + 3 } }
}

// 0 when `o` still carries what `mk(tag)` wrote, 1 otherwise. A freed object
// reads as zeroes or as whatever reused its slot; neither matches.
fn off(o: Obj, tag: i64): i64 {
  if (o.tag != tag || o.a != tag * 31 + 7 || o.box.v != tag * 17 + 3) {
    return 1
  }
  return 0
}

fn offAll(kept: []Obj, base: i64): i64 {
  let bad = 0
  for (let i = 0; i < len(kept); i++) {
    bad = bad + off(kept[i], base + i)
  }
  return bad
}

// Built before the park, read after it: `o0`..`o3` live across the receive in
// callee-saved registers and spill slots, `kept` is a slice whose buffer and
// elements only the frame's `kept` word reaches.
fn parker(id: i64, ready: chan<i64>, gate: chan<i64>, out: chan<i64>) {
  let base = id * 100 + 1
  let o0 = mk(base)
  let o1 = mk(base + 1)
  let o2 = mk(base + 2)
  let o3 = mk(base + 3)
  let kept = []Obj(0, 4)
  for (let i = 0; i < 4; i++) {
    kept = append(kept, mk(base + 4 + i))
  }
  ready <- id
  let go = <- gate
  let bad = off(o0, base) + off(o1, base + 1) + off(o2, base + 2) + off(o3, base + 3)
  bad = bad + offAll(kept, base + 4)
  if (go != goToken) {
    bad = bad + 1
  }
  out <- bad
}

fn makeRing(window: i64): []Obj {
  let ring = []Obj(0, window)
  for (let i = 0; i < window; i++) {
    ring = append(ring, mk(0 - 1 - i))
  }
  return ring
}

// Replaces the slots of `ring` `n` times, so every slot the collector freed
// meanwhile is handed out again with new contents.
fn spinRing(ring: []Obj, n: i64): i64 {
  let window = len(ring)
  let sink = 0
  for (let i = 0; i < n; i++) {
    ring[i % window] = mk(0 - 1 - i)
    sink = sink + ring[i * 7 % window].tag
  }
  return sink
}

// Never parks: the canaries are live in this frame for the whole loop, so a
// collection that stops this thread reaches them through its frame only. Its
// allocation also keeps the pool collecting while main churns.
fn runner(id: i64, rounds: i64, out: chan<i64>) {
  let base = 900000 + id * 100
  let o0 = mk(base)
  let o1 = mk(base + 1)
  let o2 = mk(base + 2)
  let bad = 0
  for (let r = 0; r < rounds; r++) {
    let junk = mk(r + 1)
    bad = bad + off(o0, base) + off(o1, base + 1) + off(o2, base + 2) + off(junk, r + 1)
  }
  out <- bad
}

fn main() {
  let parkers = knob("PARKROOTS_PARKERS", 256)
  let churn = knob("PARKROOTS_CHURN", 1000000)
  let runners = knob("PARKROOTS_RUNNERS", 7)
  let ready = chan<i64>(parkers)
  let gate = chan<i64>(parkers)
  let out = chan<i64>(parkers + runners)
  for (let i = 0; i < parkers; i++) {
    spawn parker(i, ready, gate, out)
  }
  for (let i = 0; i < runners; i++) {
    spawn runner(i, churn / 15 + 1, out)
  }
  for (let i = 0; i < parkers; i++) {
    let _ = <- ready
  }
  let sink = spinRing(makeRing(parkers * 16), churn)
  for (let i = 0; i < parkers; i++) {
    gate <- goToken
  }
  let bad = 0
  for (let i = 0; i < parkers + runners; i++) {
    bad = bad + <- out
  }
  if (sink > 0) {
    bad = bad + 1
  }
  if (bad != 0) {
    print("parkroots FAIL bad=${bad}\n")
    exit(1)
  }
  print("parkroots OK\n")
}
