// `bit.json`'s "lint" key (#4156, compiler/lintproject.bit) as seen from
// OUTSIDE the process: exit codes, the exclude/allow summary lines, and both
// precedence directions against a real file on disk. compiler/lintprojectcheck.bit
// covers the pure decode/merge logic in-process; this file covers what only a
// child process can observe, exactly the split `_tests_/bit/lintcmd/lintcmd.bit`'s own
// header already documents for `bit lint`'s directive reader vs. its CLI
// contract — and shares that file's `shell`/`bitBinary`/`Tally` shape rather
// than importing it, since every `_tests_/bit/*.bit` gate is a standalone
// single-file program (no `bit.json` of its own in `_tests_/bit/`).
//
// Run it from the repository root:
//     ./bit-out/bin/bit run _tests_/bit/lintprojectconfig.bit
// `BIT_SELF_EXE` overrides which `bit` is exercised; unset, the compiler
// under test is `<cwd>/bit-out/bin/bit`, resolved the same independent way
// `lintcmd.bit` does (#3502).
import { env, envOr, exit } from "std/os"
import { exists, mkdir, readFile, remove, writeFile } from "std/fs"
import { contains, repeat, parseInt } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

class Run { code: int, out: string, err: string }
class Tally { checks: int, failures: int }

fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "300")) catch _ {
    300
  }
  if (s <= 0) {
    return 300000
  }
  return s * 1000
}

fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    fail newError("lintprojectconfig: cannot make script executable: ${scriptPath}")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == -2) {
    panic("lintprojectconfig: TIMED OUT after ${ms}ms running ${scriptPath}")
  }
  if (code == -1) {
    panic("lintprojectconfig: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("lintprojectconfig: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}

fn bitBinary(scratch: string, ms: int): string! {
  let explicit = env("BIT_SELF_EXE")
  if (len(explicit) > 0) {
    if (!exists(explicit)) {
      fail newError("lintprojectconfig: BIT_SELF_EXE=${explicit} does not exist")
    }
    return explicit
  }
  let cwdFile = "${scratch}/cwd.txt"
  let code = shell("${scratch}/pwd.sh", "#!/bin/sh\npwd > '${cwdFile}'\n", ms)?
  if (code != 0) {
    fail newError("lintprojectconfig: could not read the working directory (exit ${code})")
  }
  let cwd = trimWs(readFile(cwdFile)?)
  let candidate = "${cwd}/bit-out/bin/bit"
  if (!exists(candidate)) {
    fail newError("lintprojectconfig: no compiler at ${candidate}; run from the repo root or set BIT_SELF_EXE")
  }
  return candidate
}

fn check(t: Tally, cond: bool, label: string) {
  t.checks = t.checks + 1
  if (!cond) {
    t.failures = t.failures + 1
    eprint("FAIL: ${label}\n")
  }
}

// The fixture tree every case shares: three files, `bit.json` REWRITTEN
// between cases by `writeBitJson` — one project underneath one changing
// config, never a fresh tree per case, so each case observes exactly one
// thing changing.
fn makeFixture(root: string): ()! {
  mkdir(root)?
  mkdir("${root}/sub")?
  mkdir("${root}/fixtures")?
  writeFile("${root}/top.bit", repeat("let x = 1\n", 6))?
  writeFile("${root}/sub/small.bit", repeat("let x = 1\n", 6))?
  // Deliberately malformed syntax — the "pure fixtures" corpus a "disable"
  // or "allow" override must be able to neutralize.
  writeFile("${root}/fixtures/broken.bit", "let x = ===broken===\n")?
}

fn writeBitJson(root: string, content: string): ()! {
  let path = "${root}/bit.json"
  if (exists(path)) {
    remove(path)?
  }
  if (len(content) > 0) {
    writeFile(path, content)?
  }
}

fn runLint(bit: string, root: string, capDir: string, args: []string, ms: int): Run! {
  let outPath = "${capDir}/out.txt"
  let errPath = "${capDir}/err.txt"
  let codePath = "${capDir}/code.txt"
  clear(outPath)
  clear(errPath)
  clear(codePath)
  let quoted = ""
  for a of args {
    quoted = quoted + " '" + a + "'"
  }
  let script = "#!/bin/sh\n" +
    "cd '${root}' || exit 0\n" +
    "'${bit}' lint${quoted} > '${outPath}' 2> '${errPath}'\n" +
    "echo $? > '${codePath}'\n" +
    "exit 0\n"
  let sh = shell("${capDir}/lint.sh", script, ms)?
  if (sh != 0) {
    fail newError("lintprojectconfig: wrapper script exited ${sh}, which it never should")
  }
  if (!exists(codePath)) {
    fail newError("lintprojectconfig: no exit code was recorded for `bit lint${quoted}`")
  }
  let code = parseInt(trimWs(readFile(codePath)?))?
  return Run{ code: code, out: readFile(outPath)?, err: readFile(errPath)? }
}

fn clear(path: string) {
  if (exists(path)) {
    remove(path) catch _ {
      return
    }
  }
}

// ---- cases ------------------------------------------------------------

// Every case's fixed environment (the compiler under test, the shared
// fixture tree, where captures go, the per-run timeout) bundled into one
// struct so each check function below takes 2 params instead of 5 (E0202) —
// the same reason compiler/lintbatch.bit's own `LintBatchCtx` exists.
class Env { t: Tally, bit: string, root: string, capDir: string, ms: int }

fn runLintIn(e: Env, args: []string): Run! {
  return runLint(e.bit, e.root, e.capDir, args, e.ms)?
}

// No `bit.json` at all vs. one present with no "lint" key: `pc.active` is
// false either way, so `bit lint`'s output must be BYTE IDENTICAL.
fn checkAbsentKeyNoOp(e: Env): ()! {
  writeBitJson(e.root, "")?
  let none = runLintIn(e, ["."])?
  writeBitJson(e.root, "{}\n")?
  let empty = runLintIn(e, ["."])?
  check(e.t, none.code == empty.code, "absent-key: exit ${none.code} vs ${empty.code}")
  check(e.t, none.err == empty.err, "absent-key: stderr differs with an empty bit.json present")
  check(e.t, none.out == empty.out, "absent-key: stdout differs with an empty bit.json present")
  writeBitJson(e.root, "{ \"dependencies\": {} }\n")?
  let deps = runLintIn(e, ["."])?
  check(e.t, deps.err == empty.err, "absent-key: stderr differs with a dependencies-only bit.json")
}

// Direction 1: the project rule applies where no in-file directive exists.
// Direction 2: an in-file directive beats it for that one file.
fn checkPrecedenceDirections(e: Env): ()! {
  writeBitJson(e.root, "{ \"lint\": { \"rules\": { \"max-file-lines\": 5 } } }\n")?
  let projectWins = runLintIn(e, ["top.bit"])?
  check(e.t, projectWins.code == 1, "project-wins: exit ${projectWins.code}, want 1")
  check(
    e.t,
    contains(projectWins.err, "file is 6 lines, limit is 5"),
    "project-wins: wrong limit applied",
  )

  let directive = "// bit:lint max-file-lines=999 -- directive beats the project\n" +
    repeat("let x = 1\n", 6)
  writeFile("${e.root}/top.bit", directive)?
  let directiveWins = runLintIn(e, ["top.bit"])?
  check(e.t, directiveWins.code == 0, "directive-wins: exit ${directiveWins.code}, want 0")
  check(
    e.t,
    contains(directiveWins.err, "lint: 0 findings, 1 overrides active"),
    "directive-wins: wrong summary",
  )

  writeFile("${e.root}/top.bit", repeat("let x = 1\n", 6))? // restore for later cases
}

// An override's own "rules" scopes a rule to one directory prefix, on top of
// the project-wide default that still applies everywhere else.
fn checkOverrideScoping(e: Env): ()! {
  writeBitJson(
    e.root,
      "{ \"lint\": { \"rules\": { \"max-file-lines\": 5 },\n" +
      "  \"overrides\": [ { \"paths\": [\"sub\"], \"rules\": { \"max-file-lines\": 999 } } ] } }\n",
  )?
  let r = runLintIn(e, ["."])?
  check(e.t, contains(r.err, "./top.bit"), "override-scoping: top.bit's own finding is missing")
  check(e.t, !contains(r.err, "sub/small.bit"), "override-scoping: sub/small.bit should be exempt")
}

// "disable": true drops a matching file from the walk BEFORE it is opened —
// a deliberately-malformed fixture can never force exit 2. Mutation control:
// removing the override brings the parse error straight back.
fn checkDisableOverride(e: Env): ()! {
  writeBitJson(
    e.root,
    "{ \"lint\": { \"overrides\": [ { \"paths\": [\"fixtures\"], \"disable\": true } ] } }\n",
  )?
  let disabled = runLintIn(e, ["."])?
  check(
    e.t,
    disabled.code != 2,
    "disable: exit ${disabled.code}, want != 2 (fixtures/broken.bit must not force exit 2)",
  )
  check(
    e.t,
    contains(disabled.err, "1 file(s) excluded by bit.json"),
    "disable: no exclusion count printed",
  )
  check(
    e.t,
    !contains(disabled.err, "E0021"),
    "disable: the excluded file's parse error still showed up",
  )

  writeBitJson(e.root, "{}\n")?
  let restored = runLintIn(e, ["."])?
  check(e.t, restored.code == 2, "disable-removed: exit ${restored.code}, want 2")
  check(e.t, contains(restored.err, "E0021"), "disable-removed: the parse error did not come back")
}

// "allow" suppresses only the named codes, as a diagnostic-level filter —
// the file is still opened and its OTHER problems (none, here) still apply.
// Mutation control mirrors checkDisableOverride's.
fn checkAllowOverride(e: Env): ()! {
  writeBitJson(
    e.root,
    "{ \"lint\": { \"overrides\": [ { \"paths\": [\"fixtures\"], \"allow\": [\"E0021\"] } ] } }\n",
  )?
  let allowed = runLintIn(e, ["."])?
  check(e.t, allowed.code != 2, "allow: exit ${allowed.code}, want != 2")
  check(e.t, !contains(allowed.err, "E0021"), "allow: E0021 was not suppressed")
  check(
    e.t, contains(allowed.err, "2 diagnostic(s) suppressed by bit.json"),
    "allow: wrong suppression count (fixtures/broken.bit has exactly 2 E0021s)",
  )

  writeBitJson(e.root, "{}\n")?
  let restored = runLintIn(e, ["."])?
  check(e.t, restored.code == 2, "allow-removed: exit ${restored.code}, want 2")
  check(e.t, contains(restored.err, "E0021"), "allow-removed: E0021 did not come back")
}

// Every malformed shape: a clean diagnostic naming `bit.json` and the exact
// problem, exit 2, and — critically — NO ordinary summary line at all,
// proving the run never silently fell back to linting with no config.
fn checkMalformedConfig(e: Env): ()! {
  checkOneMalformed(e, "{ \"lint\": 5 }\n", "\"lint\" must be an object")?
  checkOneMalformed(
    e,
    "{ \"lint\": { \"rules\": { \"nope\": 1 } } }\n",
    "unknown lint rule \"nope\"",
  )?
  checkOneMalformed(e, "{ \"lint\": { \"rulez\": {} } }\n", "unrecognized key \"rulez\"")?
  checkOneMalformed(
    e, "{ \"lint\": { \"overrides\": [ { \"paths\": [\"a/*\"] } ] } }\n", "looks like a glob pattern",
  )?
}

fn checkOneMalformed(e: Env, config: string, needle: string): ()! {
  writeBitJson(e.root, config)?
  let r = runLintIn(e, ["."])?
  check(e.t, r.code == 2, "malformed(${needle}): exit ${r.code}, want 2")
  check(e.t, contains(r.err, "bit.json"), "malformed(${needle}): error does not name bit.json")
  check(e.t, contains(r.err, needle), "malformed(${needle}): error missing '${needle}'")
  check(
    e.t, !contains(r.err, "overrides active"),
    "malformed(${needle}): the ordinary summary line printed — config error was not fatal",
  )
}

fn runAll(t: Tally, scratch: string, ms: int) {
  let root = "${scratch}/tree"
  let capDir = "${scratch}/cap"
  mkdir(capDir) catch err {
    panic("lintprojectconfig: cannot create ${capDir}: ${err.message()}")
  }
  let bit = bitBinary(scratch, ms) catch err {
    panic("lintprojectconfig: ${err.message()}")
  }
  makeFixture(root) catch err {
    panic("lintprojectconfig: cannot build the fixture: ${err.message()}")
  }
  let e = Env{ t: t, bit: bit, root: root, capDir: capDir, ms: ms }
  checkAbsentKeyNoOp(e) catch err {
    panic("lintprojectconfig: ${err.message()}")
  }
  checkPrecedenceDirections(e) catch err {
    panic("lintprojectconfig: ${err.message()}")
  }
  checkOverrideScoping(e) catch err {
    panic("lintprojectconfig: ${err.message()}")
  }
  checkDisableOverride(e) catch err {
    panic("lintprojectconfig: ${err.message()}")
  }
  checkAllowOverride(e) catch err {
    panic("lintprojectconfig: ${err.message()}")
  }
  checkMalformedConfig(e) catch err {
    panic("lintprojectconfig: ${err.message()}")
  }
}

fn main() {
  let ms = timeoutMs()
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  let scratch = "${tmp}/bit-lintprojectconfig-${uuidFormat(uuidV4())}"
  let t = Tally{ checks: 0, failures: 0 }

  mkdir(scratch) catch e {
    panic("lintprojectconfig: cannot create ${scratch}: ${e.message()}")
  }
  runAll(t, scratch, ms)

  // The run marker: a gate that stopped checking is visible here rather than
  // green.
  if (t.checks < 25) {
    eprint("FAIL: only ${t.checks} checks ran, want at least 25\n")
    t.failures = t.failures + 1
  }
  if (t.failures > 0) {
    teardown(scratch, ms)
    println("lintprojectconfig: FAIL — ${t.failures} of ${t.checks} checks failed")
    exit(1)
  }
  teardown(scratch, ms)
  println("lintprojectconfig: PASS — ${t.checks} checks")
}

fn teardown(scratch: string, ms: int) {
  shell("${scratch}/rm.sh", "#!/bin/sh\nrm -rf '${scratch}'\n", ms) catch _ {
    return
  }
}

fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}
