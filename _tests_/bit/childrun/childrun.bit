// _tests_/bit/childrun/childrun.bit — the bounded-child-process harness shared
// by the stop-the-world wiring gate (`_tests_/bit/stwwiring/`) and the
// runtime-pin cycle gate (`_tests_/bit/rootpins/`).
//
// #2867 phase 2 split both `stwwiring.bit` and `rootpins.bit` into directory
// modules. Each kept its own copy of the "compile a module as a bounded child
// process, read back a result code, and report a timeout/crash/exit clearly"
// scaffolding, because a `_tests_/bit/*/` harness cannot see a sibling in a
// different directory (a directory is its own Bit module, §17.1). #2902 found
// nine constants, a class and six functions identical or near-identical
// between the two copies — this file is where they now live, imported by
// relative path (`import { ... } from "../childrun"`) the same way both
// harnesses already import `../objread`.
//
// This file knows nothing about `Edge`, `Mod`, wiring, pins, or objects — only
// "run this shell command with a deadline and tell me what happened to it".
// Each caller's own `loadObject` calls `runBounded` here once per module and
// its own `main` reads `Cfg`/`timeoutSeconds` to build the config once.
//
// The one real behavioural difference between the two original copies was the
// eprint prefix on a failure ("stwwiring: " vs "rootpins: "), exactly as
// `../objread` found for its own split. `runBounded`, `reportChild` and
// `timeoutSeconds` now take a `tag` naming the caller, threaded through
// instead of hardcoded, on the same pattern as `objread`'s `objFail`.
// `signalName` and `trimLeadingSpace` print nothing and needed no such
// parameter — they were already byte-identical.

import { readFile, writeFile } from "std/fs"
import { envOr } from "std/os"
import { parseInt } from "std/strings"
import { now } from "std/time"

// Per-child wall-clock limit, shared with every harness here. A hang is a
// failure, not a stall (#1637/#1652); the compiler is a child here, so it is
// bounded. Not exported: only `timeoutSeconds` below reads these, and both
// callers reach the clamp through that function rather than the raw consts.
const defaultTimeoutS: int = 300
const maxTimeoutS: int = 3600
const timeoutEnvVar: string = "BIT_TEST_TIMEOUT_S"

// `osRunBounded`'s result encoding (ABI.md §19). Not exported: only
// `runBounded`/`reportChild` below compare against these.
const rcSpawnFailed: int = -1
const rcTimedOut: int = -2
const rcSignalBase: int = -100

// Upper bound on lines/symbols/relocations walked by either caller — every
// walk provably bounded (Power of 10 rule 2), two orders of magnitude above
// today's counts. `../objread` keeps its own copy of the same value for its
// own unrelated bounded loops, since a module cannot import this one back
// (`childrun` importing `objread` and `objread` importing `childrun` would be
// a circular import, rejected outright — §17.2).
export const maxScan: int = 1048576

// Target names as `bit build --target` spells them. Mach-O carries the C
// leading underscore verbatim and ELF does not, so the target also selects
// the symbol prefix each caller applies — normalising that is what keeps a
// Darwin entry from silently matching nothing, the vacuity the deleted harness
// `rootpins` documented at length.
export const tMacos: string = "aarch64-macos"
export const tLinux: string = "x86_64-linux"

// Where the compiler binary, the tree under test and the scratch script live,
// so no function has to thread them one parameter at a time.
export class Cfg {
  export bin: string,
  export repo: string,
  export timeoutMs: int,
  export script: string
}

// The scratch script `runBounded` runs its children through: one path for the
// whole harness process, unique between processes (`test-rootpins` and
// `test-stwwiring` run in the same gate batch, and two checkouts can run
// either at once).
//
// Stability here is a PERFORMANCE contract, not tidiness. macOS tags every
// newly created file with `com.apple.provenance`, and the first `execve` of
// such a file pays ~250-450ms of validation that is serialized SYSTEM-WIDE, so
// more concurrency makes it worse rather than better. A fresh script per child
// cost `test-rootpins` 24.1s of a 45s run across its 42 children; one reused
// inode pays the tax once. The charge is per INODE, so delete-then-recreate at
// a fixed path is no better than a fresh name (measured: 15.6-24.2s) — hence
// nothing below removes the script, and `writeFile` -> `create` (O_TRUNC)
// rewrites it in place. Same defect, same shape as #3778's `test-golden` fix.
export fn scriptPath(tag: string): string {
  return "/tmp/bit-${tag}-${now().ns}.sh"
}

// Writes `cmd` into `script` — an executable `/bin/sh` file the CALLER owns and
// reuses for every child — and runs it under a deadline. The script exists only
// because `osRunBounded` takes a path and NO argv (ABI.md §19), so a command
// WITH arguments cannot be expressed directly. The caller removes it once the
// last child has run; see `scriptPath` for why it must survive until then.
export fn runBounded(tag: string, script: string, log: string, cmd: string, timeoutMs: int): int {
  writeFile(script, "#!/bin/sh\nexec >\"${log}\" 2>&1\n${cmd}\n") catch e {
    eprint("${tag}: cannot write ${script}: ${e.message()}\n")
    return rcSpawnFailed
  }
  if (fsChmod(script, 493) != 0) {
    eprint("${tag}: cannot make ${script} executable\n")
    return rcSpawnFailed
  }
  return osRunBounded(script, timeoutMs)
}

// Names a failed child on stderr. A timeout and a crash are distinct
// outcomes: scoring a segfault as a timeout sends the reader hunting the
// wrong bug.
export fn reportChild(tag: string, what: string, r: int, log: string) {
  if (r == rcTimedOut) {
    eprint("${tag}: ${what}: TIMED OUT at the ${timeoutEnvVar} deadline\n")
  } else if (r <= rcSignalBase) {
    eprint("${tag}: ${what}: compiler CRASHED — ${signalName(0 - r + rcSignalBase)}\n")
  } else if (r == rcSpawnFailed) {
    eprint("${tag}: ${what}: could not spawn the compiler\n")
  } else {
    eprint("${tag}: ${what}: compiler exited with ${r}\n")
  }
  let text = readFile(log) catch _ {
    ""
  }
  if (len(text) > 0) { eprint("--- ${what} ---\n${text}\n") }
  fsRemove(log)
}

// The signal numbers worth naming; anything else reports its number. Not
// exported: only `reportChild` above calls it, on both platforms.
fn signalName(sig: int): string {
  if (sig == 4) { return "SIGILL (4)" }
  if (sig == 6) { return "SIGABRT (6)" }
  if (sig == 8) { return "SIGFPE (8)" }
  if (sig == 9) { return "SIGKILL (9)" }
  if (sig == 10) { return "SIGBUS (10)" }
  if (sig == 11) { return "SIGSEGV (11)" }
  return "signal ${sig}"
}

// The per-child limit in seconds, clamped into [1, maxTimeoutS] so a typo can
// neither disable the deadline nor make it useless.
export fn timeoutSeconds(tag: string): int {
  let raw = envOr(timeoutEnvVar, "")
  if (len(raw) == 0) { return defaultTimeoutS }
  let n = parseInt(raw) catch _ {
    eprint("${tag}: ${timeoutEnvVar}='${raw}' is not a number\n")
    return defaultTimeoutS
  }
  if (n < 1) { return 1 }
  if (n > maxTimeoutS) { return maxTimeoutS }
  return n
}

// Leading-space trim used by both callers' comment-line parsers (`stw.bit`'s
// numbered ROOT SET list, `runtime/**`'s `@symbol(...)` pin lines).
export fn trimLeadingSpace(s: string): string {
  let i = 0
  while (i < len(s) && s[i:i + 1] == " ") {
    i = i + 1
  }
  return s[i:len(s)]
}
