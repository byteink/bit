// _tests_/bit/lowerrefusecases/lowerrefusecases.bit — the rejection/acceptance
// case tables `_tests_/bit/lowerrefuse.bit` drives, split out under #5604
// (spec/LINT.md:186's 800-line E0200 limit; lowerrefuse.bit formatted to
// 858). A pure move: every declaration below is byte-identical to what
// lowerrefuse.bit carried — `Reject`/`Accept` (the row shape), the
// `verdict`/`bareParam`/`bareWrite`/`callWith` string builders the tables
// use, and the six table functions themselves
// (`rejects`/`storeRejects`/`accepts`/`readAccepts`/`writeAccepts`/
// `storeAccepts`). `timeoutMs`/`shell`/`bitBinary`/`runBit`/`clear`/`check`
// stay in lowerrefuse.bit: they drive the child `bit` process and read its
// result, which the tables never touch.
//
// A real directory module, imported via a relative path
// (`import { ... } from "./lowerrefusecases"`) from
// `_tests_/bit/lowerrefuse.bit` — the same shape `pmvanityhelpers/` and
// `pmvanitychecks/` already use. `_tests_/bit/lowerrefuse.bit` is invoked
// directly by `tools/build/gates.bit`'s `test-lower-refuse` gate as a single
// file (`bit run _tests_/bit/lowerrefuse.bit`), which loads it as a module
// of exactly that one file (SPEC §17.1) — it cannot see a bare sibling
// `.bit` file in the same directory, only a real subdirectory reached
// through an explicit import. This file is that subdirectory.

// One program whose index receiver is not a lowerable kind. `callee` is the name
// of the function that must be reported as unlowerable, used only when `wantErr`
// is empty (the lowering-only fallback `checkRejects` still supports, for
// whichever case, present or future, the checker does not yet catch). `wantErr`,
// when non-empty, is the checker fragment `bit check` must now print —
// `error[E0054]` naming the substituted type for #2391's ten type-param cases
// (each substitutes a different one, which already pins the case), `error[E0087]`
// for #2740's three string cases.
export class Reject {
  export name: string,
  export src: string,
  export callee: string,
  export wantErr: string,
}

// One program that must still be ACCEPTED, and the stdout it must produce. Each
// prints exactly "ok\n" when the value read back through `a[i]` is the expected
// one and "bad\n" when it is not, so a wrong VALUE is distinguishable from a
// crash, from silence, and from a build failure.
export class Accept { export name: string, export src: string }
// The `ok`/`bad` tail every acceptance program shares. Printing a distinct token
// for the wrong value is what separates "indexed correctly" from "indexed at all".
fn verdict(cond: string): string {
  return "  if (" +
    cond +
    ") {\n" +
    "    print(\"ok\\n\")\n" +
    "  } else {\n" +
    "    print(\"bad\\n\")\n" +
    "  }\n}\n"
}

// A generic function whose parameter is the bare type param `T`, indexed in its
// body. `T` is what makes the receiver undecidable at check time, and `ret` is the
// element type the caller's substitution implies.
fn bareParam(ret: string): string {
  return "fn first<T>(xs: T): ${ret} {\n  return xs[0]\n}\n\n"
}

// The same, WRITING the element instead of reading it. `stmt` is the statement
// under test, and WHICH LOWERING SITE it reaches depends on its spelling:
// `xs[0] += 1` reaches `resolveLvalue` from lowerAssign's compound-assign arm and
// `xs[0]++` reaches it from lowerIncDec, both reading AND writing through one
// resolved lvalue; a plain `xs[0] = 9` reaches neither and goes to
// `lowerIndexStore` instead. All three receivers are the same bare `T`, so the
// same substitution exercises a different guard per spelling.
fn bareWrite(name: string, stmt: string): string {
  return "fn ${name}<T>(xs: T) {\n  ${stmt}\n}\n\n"
}

// `main` for a rejection case whose only job is to instantiate the generic. The
// print is unreachable in a correct compiler and was reached by 0.1.8.
fn callWith(callee: string, decl: string): string {
  return "fn main() {\n  let v = ${decl}\n  ${callee}(v)\n  print(\"done\\n\")\n}\n"
}

// The rejection set: substitutions of `T` that are not indexable at all — now
// refused by the CHECKER (#2391) — plus the three string cases, refused by the
// CHECKER too (#2740): a string is immutable and has no write arm at either write
// site, so `s[0] += 1`, `s[0]++` and `s[0] = 'z'` must all be refused however the
// receiver was spelled, and none may leave a binary behind. `storeRejects()` is
// spliced in at the end rather than inlined only to keep this function inside the
// repo's max-fn-lines limit.
export fn rejects(): []Reject {
  let all = [
    // Built clean and died on SIGSEGV under 0.1.8: `xs[0]` dereferenced the
    // integer 5 as a base address. Now caught at check time: `T = i64`.
    Reject{
      name = "typeparam-int",
      src = bareParam("int") +
        "fn main() {\n  print(\"x\")\n  if (first(5) == 0) {\n    print(\"y\")\n  }\n}\n",
      callee = "first", wantErr = "error[E0054]: 'i64' cannot be indexed",
    },
    // Same, with a one-word non-pointer of a different width. `T = bool`.
    Reject{
      name = "typeparam-bool",
      src = bareParam("bool") + "fn main() {\n  if (first(true)) {\n    print(\"y\")\n  }\n}\n",
      callee = "first", wantErr = "error[E0054]: 'bool' cannot be indexed",
    },
    // The dangerous one: a class IS a heap block, so the raw read succeeds and
    // hands back field `a`. Under 0.1.8 this built, printed `y` and exited 0 — a
    // meaningless program agreeing with itself, with no signal anywhere. Now
    // caught at check time: `T = P`.
    Reject{
      name = "typeparam-class",
      src = "class P { a: int, b: int }\n\n" +
        bareParam("int") +
        "fn main() {\n  if (first(P{a: 7, b: 9}) == 7) {\n    print(\"y\")\n  }\n}\n",
      callee = "first", wantErr = "error[E0054]: 'P' cannot be indexed",
    },
    // #2390, the read-modify-write path. Same three substitutions of `T`, reaching
    // `resolveLvalue` instead of `lowerIndex` — but the checker's `vInstIndex`
    // walks every `Tag.Index` node in the instantiated body regardless of whether
    // it is read or written, so these are caught the same way. Under 0.1.8 the int
    // and the bool built clean and died on SIGSEGV: `xs[0] += 1` loaded and then
    // STORED through the value as a base address.
    Reject{
      name = "lv-compound-int",
      src = bareWrite("bump", "xs[0] += 1") + callWith("bump", "5"),
      callee = "bump", wantErr = "error[E0054]: 'i64' cannot be indexed",
    },
    Reject{
      name = "lv-compound-bool",
      src = bareWrite("bump", "xs[0] += 1") + callWith("bump", "true"),
      callee = "bump", wantErr = "error[E0054]: 'bool' cannot be indexed",
    },
    // The write side's dangerous one, and worse than its read twin: this does not
    // merely report a wrong value, it MUTATES the class. Under 0.1.8 it built,
    // incremented field `a` from 7 to 8, printed `y` and exited 0.
    Reject{
      name = "lv-compound-class",
      src = "class P { a: int, b: int }\n\n" +
        bareWrite("bump", "xs[0] += 1") +
        "fn main() {\n  let p = P{a: 7, b: 9}\n  bump(p)\n  if (p.a == 8) {\n    print(\"y\")\n  }\n}\n",
      callee = "bump", wantErr = "error[E0054]: 'P' cannot be indexed",
    },
    // No type parameter anywhere: a string receiver is refused on its own terms.
    // `lowerIndex` has a `string_byte` arm, so `s[0]` READS fine and is in
    // `accepts()` below; there is deliberately no write arm, because a string is
    // immutable. Under 0.1.8 this built and turned "abc" into "bc". `T` never
    // appears here, so `vInstIndex` has nothing to re-judge, but #2740's
    // `vAssignTargetString` (compiler/validateassign.bit) now catches it directly:
    // it asks the write-only question `vIndex` never does, and reports E0087.
    Reject{
      name = "lv-compound-string",
      src = "fn main() {\n  let s = \"abc\"\n  s[0] += 1\n  print(s)\n}\n",
      callee = "main", wantErr = "error[E0087]: cannot assign to a string index",
    },
  ]
  for c of incdecRejects() {
    all = append(all, c)
  }
  for c of storeRejects() {
    all = append(all, c)
  }
  return all
}

// `++` reaches the same lvalue through lowerIncDec rather than lowerAssign.
// Both of these built clean under 0.1.8: the int died on SIGSEGV, the string
// was corrupted exactly as above. Spliced into `rejects()` above rather than
// inlined, same reason `storeRejects()` is: keeps `rejects()` inside the
// repo's max-fn-lines limit.
fn incdecRejects(): []Reject {
  return [
    Reject{
      name = "lv-incdec-int",
      src = bareWrite("step", "xs[0]++") + callWith("step", "5"),
      callee = "step", wantErr = "error[E0054]: 'i64' cannot be indexed",
    },
    Reject{
      name = "lv-incdec-string",
      src = "fn main() {\n  let s = \"abc\"\n  s[0]++\n  print(s)\n}\n",
      callee = "main", wantErr = "error[E0087]: cannot assign to a string index",
    },
  ]
}

// #2403, the PLAIN-ASSIGNMENT path: `a[i] = v` reaches neither `lowerIndex` nor
// `resolveLvalue`. lowerAssign routes it straight to `lowerIndexStore` in
// compiler/lowerflow.bit, which held the third copy of the unguarded shape, so
// every case here built clean and misbehaved with both of the other two guards
// already in place. Measured on a tree carrying #2385 and #2390, and identically
// under the released 0.1.8.
fn storeRejects(): []Reject {
  return [
    // Built clean, then SIGSEGV: `xs[0] = 9` stored 9 through the integer 5 as a
    // base address. Now caught at check time: `T = i64`.
    Reject{
      name = "st-plain-int",
      src = bareWrite("put", "xs[0] = 9") + callWith("put", "5"),
      callee = "put", wantErr = "error[E0054]: 'i64' cannot be indexed",
    },
    // Same, with a one-word non-pointer of a different width. `T = bool`.
    Reject{
      name = "st-plain-bool",
      src = bareWrite("put", "xs[0] = 9") + callWith("put", "true"),
      callee = "put", wantErr = "error[E0054]: 'bool' cannot be indexed",
    },
    // The store side's dangerous one, and the worst of the three sites: no signal,
    // exit 0, and the caller's class is DIFFERENT afterwards. Under 0.1.8 and on
    // this tree before the guard it printed `done 42` — `xs[0] = 42` overwrote
    // field `a`, 7 to 42, and nothing at any stage said so.
    Reject{
      name = "st-plain-class",
      src = "class P { a: int, b: int }\n\n" +
        bareWrite("put", "xs[0] = 42") +
        "fn main() {\n  let p = P{a: 7, b: 9}\n  put(p)\n  if (p.a == 42) {\n    print(\"y\")\n  }\n}\n",
      callee = "put", wantErr = "error[E0054]: 'P' cannot be indexed",
    },
    // No type parameter anywhere: a plain store into a string is refused on its own
    // terms, for the same reason `s[0] += 1` is — `lowerIndexStore` has no string
    // arm because a string is immutable. `s[0]` still READS fine and is in
    // `accepts()`. Before the guard this built and exited 0 with the string
    // destroyed: 0.1.8 printed nothing for it and this tree printed garbage bytes,
    // which is the same corruption landing differently, not a difference in kind.
    // #2740's `vAssignTargetString` now catches this one too, with E0087.
    Reject{
      name = "st-plain-string",
      src = "fn main() {\n  let s = \"abc\"\n  s[0] = 'z'\n  print(s)\n}\n",
      callee = "main", wantErr = "error[E0087]: cannot assign to a string index",
    },
  ]
}

// The whole acceptance set: the read cases, then the read-modify-write cases, then
// the plain-store cases — one table per lowering site under test. Split into three
// tables only to keep each function inside the repo's max-fn-lines limit.
export fn accepts(): []Accept {
  let all = readAccepts()
  for c of writeAccepts() {
    all = append(all, c)
  }
  for c of storeAccepts() {
    all = append(all, c)
  }
  return all
}

// The read half, and the reason this gate cannot pass by refusing everything: all
// four arms of `lowerIndex`, each reached directly and — for the three that a type
// parameter can resolve to — through a generic call as well.
fn readAccepts(): []Accept {
  return [
    // slice_get, the arm #2275 was routed away from.
    Accept{
      name = "slice",
      src = "fn main() {\n  let xs = [4, 5, 6]\n" + verdict("xs[0] == 4 && xs[2] == 6"),
    },
    // index_get itself: the fixed-array arm the guard now tests for explicitly.
    // Reading an untouched element asserts it is still the zero value, not
    // whatever the guard's `return 0` path might have left behind.
    Accept{
      name = "array",
      src = "fn main() {\n  let a: [4]int\n  a[3] = 11\n" + verdict("a[3] == 11 && a[0] == 0"),
    },
    Accept{
      name = "map",
      src = "fn main() {\n  let m = map<int, string>{}\n  m[2] = \"yo\"\n" +
        verdict("m[2] == \"yo\""),
    },
    // string_byte.
    Accept{
      name = "string",
      src = "fn main() {\n  let s = \"abc\"\n" + verdict("s[1] == 'b'"),
    },
    // The same three arms reached with a type param in the way, at two element
    // types each where the width differs. A guard that ran before substitution
    // would refuse all of these.
    Accept{
      name = "generic-slice",
      src = "fn at<T>(xs: []T, i: int): T {\n  return xs[i]\n}\n\nfn main() {\n" +
        verdict("at([9, 10], 1) == 10 && at([\"y\", \"z\"], 0) == \"y\""),
    },
    Accept{
      name = "generic-array",
      src = "fn get<T>(a: [4]T, i: int): T {\n  return a[i]\n}\n\nfn main() {\n" +
        "  let a: [4]int\n  a[2] = 7\n" +
        verdict("get(a, 2) == 7"),
    },
    Accept{
      name = "generic-map",
      src = "fn look<K, V>(m: map<K, V>, k: K): V {\n  return m[k]\n}\n\nfn main() {\n" +
        "  let m = map<int, int>{}\n  m[3] = 8\n" +
        verdict("look(m, 3) == 8"),
    },
    // The exact shape of the rejection cases — a bare `T` parameter, indexed —
    // substituted with a type that IS indexable. This is the line between the
    // guard and an over-refusal: `first` must still compile here.
    Accept{
      name = "generic-bare-param-string",
      src = bareParam("u8") + "fn main() {\n" + verdict("first(\"abc\") == 'a'"),
    },
    // #2275's own shape: an arrow parameter with no annotation, indexed.
    Accept{
      name = "arrow-bare-param",
      src = "fn main() {\n  let f: ([]int) => int = xs => xs[1]\n" + verdict("f([7, 8]) == 8"),
    },
  ]
}

// The write half of the acceptance set (#2390).
//
// This half is what stops the `resolveLvalue` guard from being an over-refusal.
// Before #2390 every acceptance case above was an rvalue READ, so nothing here
// exercised `resolveLvalue` at all and a guard that rejected every compound assign
// in the language would still have passed. Each of the three lvalue arms it can
// reach — slice, fixed array, map — is driven by both spellings that resolve an
// lvalue, `op=` and `++`/`--`, and each program asserts the element's value AFTER
// the write, so a store that lands somewhere else reads as "bad" rather than as a
// pass.
fn writeAccepts(): []Accept {
  return [
    Accept{
      name = "lv-slice-compound",
      src = "fn main() {\n  let xs = [4, 5, 6]\n  xs[1] += 10\n" +
        verdict("xs[1] == 15 && xs[0] == 4"),
    },
    // `index_set` itself: the fixed-array arm the guard now tests for explicitly.
    Accept{
      name = "lv-array-compound",
      src = "fn main() {\n  let a: [4]int\n  a[2] = 5\n  a[2] += 3\n" +
        verdict("a[2] == 8 && a[0] == 0"),
    },
    Accept{
      name = "lv-map-compound",
      src = "fn main() {\n  let m = map<int, int>{}\n  m[3] = 8\n  m[3] += 2\n" +
        verdict("m[3] == 10"),
    },
    // `++`/`--` reach the same three arms through lowerIncDec.
    Accept{
      name = "lv-slice-incdec",
      src = "fn main() {\n  let xs = [4, 5, 6]\n  xs[0]++\n  xs[2]--\n" +
        verdict("xs[0] == 5 && xs[2] == 5 && xs[1] == 5"),
    },
    Accept{
      name = "lv-array-incdec",
      src = "fn main() {\n  let a: [3]int\n  a[1] = 7\n  a[1]++\n" +
        verdict("a[1] == 8 && a[0] == 0"),
    },
    Accept{
      name = "lv-map-incdec",
      src = "fn main() {\n  let m = map<string, int>{}\n  m[\"k\"] = 1\n  m[\"k\"]++\n" +
        verdict("m[\"k\"] == 2"),
    },
    // The line between the guard and an over-refusal on the write side: the
    // receiver is spelled with a type parameter, exactly like the `lv-*` rejection
    // cases, but substitution makes it a slice. A guard that ran before
    // substitution, or that read the declared type rather than the instantiated
    // one, would refuse both of these.
    Accept{
      name = "lv-generic-slice-compound",
      src = "fn bump<T>(xs: []T, i: int, d: T) {\n  xs[i] += d\n}\n\nfn main() {\n" +
        "  let xs = [1, 2, 3]\n  bump(xs, 1, 10)\n" +
        verdict("xs[1] == 12 && xs[0] == 1"),
    },
    Accept{
      name = "lv-generic-slice-incdec",
      src = "fn step<T>(xs: []T, i: int) {\n  xs[i]++\n}\n\nfn main() {\n" +
        "  let xs = [1, 2, 3]\n  step(xs, 2)\n" +
        verdict("xs[2] == 4 && xs[1] == 2"),
    },
  ]
}

// The plain-store half of the acceptance set (#2403), and what stops the
// `lowerIndexStore` guard from being an over-refusal.
//
// The read and read-modify-write halves above do not cover this site: the `lv-*`
// cases all reach `resolveLvalue`, and while a handful of cases here and there
// happen to contain a plain `a[i] = v` as SETUP (the `array` and `map` accepts, and
// the `a[2] = 5` line in `lv-array-compound`), nothing covered a plain store into a
// SLICE at all, and nothing covered any plain store whose receiver is spelled with
// a type parameter. Those are exactly the shapes a guard reading the declared type
// rather than the instantiated one would refuse, so each arm `lowerIndexStore` can
// dispatch to — slice, fixed array, map — is driven here through a generic call,
// and each program asserts the element's value AFTER the store.
fn storeAccepts(): []Accept {
  return [
    // `slice_set` reached directly, which no case above did.
    Accept{
      name = "st-slice-plain",
      src = "fn main() {\n  let xs = [4, 5, 6]\n  xs[1] = 9\n" +
        verdict("xs[1] == 9 && xs[0] == 4 && xs[2] == 6"),
    },
    // The same store with the receiver spelled `[]T` — the guard must read the
    // INSTANTIATED receiver kind. The write is asserted from the caller, so a store
    // that landed anywhere else reads as "bad".
    Accept{
      name = "st-generic-slice-plain",
      src = "fn put<T>(xs: []T, i: int, v: T) {\n  xs[i] = v\n}\n\nfn main() {\n" +
        "  let xs = [1, 2, 3]\n  put(xs, 1, 44)\n" +
        verdict("xs[1] == 44 && xs[0] == 1"),
    },
    // `index_set` itself — the arm the guard now tests for explicitly — reached
    // through a type parameter. A fixed array is a value, so the store is asserted
    // from inside the callee that made it.
    Accept{
      name = "st-generic-array-plain",
      src = "fn put<T>(a: [4]T, i: int, v: T): T {\n  a[i] = v\n  return a[i]\n}\n\nfn main() {\n" +
        "  let a: [4]int\n" +
        verdict("put(a, 2, 7) == 7 && a[2] == 0"),
    },
    // `map_set` through a generic receiver.
    Accept{
      name = "st-generic-map-plain",
      src = "fn put<K, V>(m: map<K, V>, k: K, v: V) {\n  m[k] = v\n}\n\nfn main() {\n" +
        "  let m = map<string, int>{}\n  put(m, \"k\", 5)\n" +
        verdict("m[\"k\"] == 5"),
    },
  ]
}
