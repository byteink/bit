import { budgetJobs } from "../../../tools/joblimit"

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

export fn hashseedPoolScript(
  scratch: string,
  bin: string,
  seeds: string,
  jobs: int,
  budget: int,
): string {
  let script = "#!/bin/sh\nBIT_SEEDS=" + shQuote(seeds) + "\nexport BIT_SEEDS\n"
  script = script +
    "exec xargs -n 2 -P ${budgetJobs(jobs, budget)} /bin/sh " +
    shQuote(scratch + "/worker.sh")
  script = script + " " + shQuote(bin) + " " + shQuote(scratch + "/tmp")
  return script + " < " + shQuote(scratch + "/list") + " > " + shQuote(scratch + "/out") + " 2>&1\n"
}
