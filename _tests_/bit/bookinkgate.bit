// _tests_/bit/bookinkgate.bit — `./make test-book-ink`: builds and tests
// docs/book/ink, the Bit project every code block in the Book's Part 1-3
// chapters (docs/book/*.md) is drawn from (#6220, epic #6213). No Docker
// and no live service, unlike _tests_/bit/webguidesapp.bit's app (the
// database test in docs/book/ink/dbstore.test.bit skips here and runs under
// `./make test-book-ink-live`, _tests_/bit/bookinklive.bit, #6356): `bit test
// docs/book/ink` builds the module and runs its `test "..." { }` blocks
// (SPEC §19), the same one-command shape _tests_/bit/packagesgate.bit uses
// for `pkg/<name>`. In `gateSteps()` (tools/build/defs.bit), not held out
// of it the way the Docker-backed gates are, so `./make test` and the docs
// gate family run it and the book app can never silently rot.
//
// ENV:
//   BIT_REPO  repo root, so docs/book/ink resolves regardless of cwd (required)
//   BIT_BIN   compiler under test (default BIT_REPO/bit-out/bin/bit)

import { output } from "std/process"
import { env, exit } from "std/os"
import { exists } from "std/fs"
import { join } from "std/path"
import { loadProbe, scaledBudgetMs } from "./loadscale"

// The BASE wall, picked against an idle host (green runs use 28-30 s);
// `main` widens it by observed host load through loadscale, so a busy box
// does not fail the gate with no code change.
const testTimeoutMs: int = 60000

// BIT_REPO IS REQUIRED, same reason as _tests_/bit/packagesgate.bit and
// _tests_/bit/webguidesapp.bit: falling back to "." would silently test
// whatever directory `bit` happened to be invoked from instead of refusing.
fn repoRoot(): string {
  let r = env("BIT_REPO")
  if (len(r) == 0) {
    panic("bookinkgate: BIT_REPO is not set — run this through `./make test-book-ink`")
  }
  return r
}

fn resolveBin(repo: string): string {
  let b = env("BIT_BIN")
  if (len(b) == 0) {
    return join(repo, "bit-out/bin/bit")
  }
  return b
}

fn main() {
  let repo = repoRoot()
  let bin = resolveBin(repo)
  if (!exists(bin)) {
    eprint("bookinkgate: compiler not found: ${bin} (set BIT_BIN)\n")
    exit(1)
    return
  }
  let dir = join(repo, "docs/book/ink")
  if (!exists(dir)) {
    eprint("bookinkgate: not found: ${dir}\n")
    exit(1)
    return
  }
  let probe = loadProbe()
  let budget = scaledBudgetMs(testTimeoutMs, probe)
  let result = output(bin, ["test", dir], budget)
  print(result.stdout)
  eprint(result.stderr)
  if (result.exitCode == -2) {
    eprint("bookinkgate: bit test ${dir} TIMED OUT after ${budget / 1000}s = base ${testTimeoutMs / 1000}s x${probe.scale} load scale (host load average ${probe.text} at launch)\n")
    exit(1)
    return
  }
  if (result.exitCode != 0) {
    eprint("bookinkgate: bit test ${dir} exited ${result.exitCode}\n")
    exit(1)
    return
  }
  exit(0)
}
