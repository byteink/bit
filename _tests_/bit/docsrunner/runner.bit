// The `docs.bit` (#351, #2422) doc-tests gate's child-process runner: the
// scratch tree, the copied compiler under test, the generated one-shot POSIX
// sh fan-out script, and everything that stages a batch of snippets, drives
// one `osRunBounded` call over it, and reads back each slot's verdict (split
// out of `docs.bit`, #2969).
//
// `docs.bit` owns the corpus: what a page is, what a block is, and what
// counts as a pass. This file owns none of that — it only knows how to get N
// source strings typechecked by N `bit check` invocations and hand back N
// `CheckResult`s in the same order, whether they came from a real exit status
// or the sentinel `timedOutCode` for a slot the batch deadline cut off before
// it wrote one. See `docs.bit`'s header for why the runner is a generated
// script rather than an in-process call, why it is written once and never
// rewritten, and why the compiler under test is copied before being run.

import { readFile, writeFile, exists, isDir, mkdir, remove } from "std/fs"
import { contains, parseInt } from "std/strings"
import { env, envOr } from "std/os"

// Everything a batch of checks needs. Resolved once, asserted once.
export class Cfg {
  bin: string, // the compiler under test, already copied into scratch
  stdlibDir: string,
  export docsDir: string,
  // #3269: spec/SPEC.md's ```bit blocks are a second, smaller corpus — the
  // normative spec, not reference docs — checked the same way and merged into
  // one page list by `docs.bit`'s `main`.
  export specDir: string,
  dir: string,       // scratch root, and the runner's cwd
  jobs: int,         // workers, i.e. how many `bit check` run at once
  script: string,    // the generated runner, written once
  countPath: string, // `n.txt`: how many slots this batch uses
  export timeoutMs: i64,
}

// One check: the child's exit status, and whatever it printed. #3809 adds the
// `bit fmt --check` half run against the same module — `fmtCode`/`fmtReport`
// mirror `code`/`report` exactly, one slot, two verdicts.
export class CheckResult {
  export code: i64,
  export report: string,
  export fmtCode: i64,
  export fmtReport: string,
}

// Ceilings on the queue and on the fan-out, so the run's resource use is
// decided before it starts rather than by whatever the corpus grew into.
export const maxJobs: int = 512

const maxFanout: int = 32

// The scratch root of the run currently in flight, so `die()` can reclaim it on
// ANY failure exit — a setup failure, a plumbing self-test timeout, a corrupt
// slot status — not just the three call sites in `docs.bit`'s `main` that
// already bracket their own `teardown(cfg.dir)`. A module-level `let` may only
// hold untraced state (§11.11: no `string`, which is GC-traced), so the path
// lives in a fixed byte buffer plus a length rather than a `string`. 64 bytes
// comfortably covers "/tmp/bit-docsgate-" (19 bytes) plus a `uint` nonce (<=20
// decimal digits). Length 0 means "no active scratch dir to reclaim" — true
// before `setup()` has `mkdir`ed one, and again once `teardown()` has swept it.
let activeScratchBuf: [64]byte
let activeScratchLen: int = 0

fn setActiveScratch(dir: string) {
  assert(len(dir) <= 64)
  let i = 0
  while (i < len(dir)) {
    activeScratchBuf[i] = dir[i]
    i = i + 1
  }
  activeScratchLen = len(dir)
}

fn activeScratch(): string {
  let out = []byte(activeScratchLen)
  let i = 0
  while (i < activeScratchLen) {
    out[i] = activeScratchBuf[i]
    i = i + 1
  }
  return string(out)
}

// Setup failures are never a pass. Every one of them ends the process nonzero
// rather than leaving work unrun — a skipped check is a green test, which is
// exactly the vacuity this file exists to avoid.
export fn die(msg: string) {
  eprint("docs: SETUP FAILED: ${msg}\n")
  reclaimScratch()
  osExit(1)
}

// `die()`'s half of `teardown()`: the same sweep, run against whatever scratch
// root `setup()` most recently created, reached from a bare `dir` string since
// most `die()` call sites have no `Cfg` in scope (they fire mid-`setup`, before
// one exists, or from deep inside a helper that was only ever handed a path).
fn reclaimScratch() {
  if (activeScratchLen == 0) {
    return
  }
  teardown(activeScratch())
}

export fn slurp(path: string, what: string): string {
  if (!exists(path)) {
    die("${what}: missing: ${path}")
  }
  return readFile(path) catch e {
    die("${what}: ${path}: ${e.message()}")
    ""
  }
}

fn spill(path: string, content: string, what: string) {
  writeFile(path, content) catch e {
    die("${what}: ${path}: ${e.message()}")
  }
}

// 8 bytes of OS entropy, the same scheme compiler/build.bit uses for scratch
// paths it writes and then execs. A timestamp is not enough: two processes CAN
// read the same nanosecond, they cannot draw the same 64-bit nonce.
fn nonce(): uint {
  let b = []byte(cryptoRandomBytes(8))
  let x: uint = 0
  let i = 0
  while (i < 8) {
    x = (x << 8) | uint(b[i])
    i = i + 1
  }
  return x
}

// The repo root: the nearest ancestor holding BOTH the built compiler and the
// docs tree. Overridable with BIT_REPO. Not finding one is a hard failure, never
// a skip — an empty corpus from a wrong cwd is the classic green no-op.
export fn repoRoot(): string {
  let override = env("BIT_REPO")
  if (len(override) > 0) {
    return override
  }
  let candidates = [".", "..", "../..", "../../.."]
  for c of candidates {
    if (exists("${c}/bit-out/bin/bit") && isDir("${c}/docs")) {
      return c
    }
  }
  die("cannot locate the repo root from this cwd; set BIT_REPO")
  return ""
}

// " \t\r" trimmed from both ends. NOT std/strings' trimSpace, which leaves `\r`
// — a CRLF page would then have info string "\r", every block would test as
// unchecked, and the whole page would silently contribute nothing.
export fn trimInfo(s: string): string {
  let lo = 0
  while (lo < len(s) && (s[lo] == ' ' || s[lo] == '\t' || s[lo] == '\r')) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && (s[hi - 1] == ' ' || s[hi - 1] == '\t' || s[hi - 1] == '\r')) {
    hi = hi - 1
  }
  return s[lo:hi]
}

// Slot `i`'s paths: its module directory, its captured output, its exit status,
// and the claim directory a worker `mkdir`s to take the job. Take the scratch
// root as a bare string, not a `Cfg`, so `teardown` can run from just a path —
// which is all `die()` has when it fires before a `Cfg` exists (#2951).
fn slotDir(dir: string, i: int): string { return "${dir}/w${i}" }
fn slotMain(dir: string, i: int): string { return "${dir}/w${i}/main.bit" }
fn slotOut(dir: string, i: int): string { return "${dir}/o${i}" }
fn slotStatus(dir: string, i: int): string { return "${dir}/s${i}" }
fn slotClaim(dir: string, i: int): string { return "${dir}/c${i}" }
// #3809: the `bit fmt --check` half of the same job, named `f`+the existing
// `o`/`s` letters so the four files for one slot sort together.
fn slotFmtOut(dir: string, i: int): string { return "${dir}/fo${i}" }
fn slotFmtStatus(dir: string, i: int): string { return "${dir}/fs${i}" }

// The scratch root's own top-level files, named the same way `setup` builds
// them into `Cfg` — kept as functions of `dir` alone so both `setup` and
// `teardown` share one spelling of the convention (#2951).
fn scriptFile(dir: string): string { return "${dir}/run.sh" }
fn countFile(dir: string): string { return "${dir}/n.txt" }
fn binFile(dir: string): string { return "${dir}/bit" }

// A leftover from an earlier batch is removed before the next one starts: a
// child that never ran must not hand back stale output or a stale zero status.
// A stale CLAIM is the nastier one — every worker would skip that job, which
// `slotResult` then reads as the harness being broken.
fn scrub(path: string) {
  if (exists(path)) {
    remove(path) catch e {
      die("cannot clear ${path}: ${e.message()}")
    }
  }
}

// Reads one slot's exit-status/output pair, aborting if either is missing or
// the status is not a plain integer. Shared by the `bit check` and #3809's
// `bit fmt --check` halves of the same slot, so "absent means unchecked" is
// written once rather than diverging between the two verdicts.
fn readSlotVerdict(statusPath: string, outPath: string, i: int, what: string): (i64, string) {
  if (!exists(statusPath)) {
    die("no exit status at ${statusPath}: the runner did not record slot ${i}'s ${what}, so it is unchecked")
  }
  // trimInfo strips " \t\r" but not the newline `echo` writes, which is the
  // last byte when present.
  let raw = slurp(statusPath, "${what} status")
  let cut = raw
  while (len(cut) > 0 && cut[len(cut) - 1] == '\n') {
    cut = cut[:len(cut) - 1]
  }
  let code = parseInt(trimInfo(cut)) catch _ {
    die("unreadable exit status in ${statusPath}: ${jsonish(raw)}")
    0
  }
  if (!exists(outPath)) {
    die("no output capture at ${outPath}: the runner script is not redirecting slot ${i}'s ${what}")
  }
  return i64(code), slurp(outPath, "${what} output")
}

// What slot `i` produced, once the runner has finished with it. Absent, empty
// or non-numeric status all abort the run: a check whose result is unknown is
// not a check, and there is no lenient reading of this file.
fn slotResult(cfg: Cfg, i: int): CheckResult {
  let (code, report) = readSlotVerdict(slotStatus(cfg.dir, i), slotOut(cfg.dir, i), i, "check")
  let (fmtCode, fmtReport) = readSlotVerdict(
    slotFmtStatus(cfg.dir, i),
    slotFmtOut(cfg.dir, i),
    i,
    "fmt check",
  )
  return CheckResult{ code: code, report: report, fmtCode: fmtCode, fmtReport: fmtReport }
}

// `collectBatch`'s sentinel for "the batch deadline elapsed before this slot
// wrote a status". Never a real result: the runner's `echo $?` only ever
// writes a POSIX exit code (0-255), so a caller can tell a genuine `bit check`
// failure from an unjudged block by this code alone.
export const timedOutCode: i64 = -2

// Typechecks `srcs` — one module per source — in ONE runner invocation, and
// returns one result per source in the same order. The workers claim jobs
// dynamically rather than being handed a fixed share, because the corpus is
// wildly uneven and any static split leaves most workers idle behind the one
// page that imports `std/http`. Measured here: 303s serially, 74s in fixed
// rounds of 8, 48s pulled from one queue by 12.
export fn runBatch(cfg: Cfg, srcs: []string): []CheckResult {
  let n = len(srcs)
  assert(n > 0 && n <= maxJobs)
  stageBatch(cfg, srcs)
  let r = osRunBounded(cfg.script, cfg.timeoutMs)
  assertRunnerRan(cfg, r, n)
  return collectBatch(cfg, n, r)
}

// One module per source, plus the count the runner reads, plus a clean slate.
fn stageBatch(cfg: Cfg, srcs: []string) {
  let i = 0
  while (i < len(srcs)) {
    if (!exists(slotDir(cfg.dir, i))) {
      mkdir(slotDir(cfg.dir, i)) catch e {
        die("mkdir ${slotDir(cfg.dir, i)}: ${e.message()}")
      }
    }
    spill(slotMain(cfg.dir, i), srcs[i], "scratch module")
    scrub(slotOut(cfg.dir, i))
    scrub(slotStatus(cfg.dir, i))
    scrub(slotFmtOut(cfg.dir, i))
    scrub(slotFmtStatus(cfg.dir, i))
    scrub(slotClaim(cfg.dir, i))
    i = i + 1
  }
  spill(cfg.countPath, "${len(srcs)}\n", "batch size")
}

// ABI.md §19 packs three outcomes into one i64, and here they are the RUNNER's,
// not a compiler's. Only the timeout is a verdict about the docs; the rest mean
// the harness is broken, and a broken harness must not be able to pass.
// The runner exits 0 after `wait`; 111-113 are its own setup failures, and any
// other positive status means it never reached the worker loop.
fn assertRunnerRan(cfg: Cfg, r: i64, n: int) {
  if (r == -1) {
    die("SPAWN FAILED (fork/exec/wait error) running ${cfg.script}")
  }
  if (r <= -100) {
    die("runner ${cfg.script} killed by signal ${-r - 100}")
  }
  if (r < 0 && r != timedOutCode) {
    die("unknown os_run_bounded result ${r} from ${cfg.script}")
  }
  if (r > 0) {
    die("runner ${cfg.script} exited ${r} — it never ran the ${n} check(s) in this batch")
  }
}

// A hang is a failure, not a stall — and it is attributable: the jobs that
// finished wrote a status, so a missing one names the snippet that hung instead
// of condemning the whole batch.
fn collectBatch(cfg: Cfg, n: int, r: i64): []CheckResult {
  let out = []CheckResult(0)
  let j = 0
  while (j < n) {
    if (r == timedOutCode && !exists(slotStatus(cfg.dir, j))) {
      let msg = "TIMED OUT: still running when the batch deadline of ${cfg.timeoutMs}ms elapsed"
      out = append(
        out,
        CheckResult{ code: timedOutCode, report: msg, fmtCode: timedOutCode, fmtReport: msg },
      )
    } else {
      out = append(out, slotResult(cfg, j))
    }
    j = j + 1
  }
  return out
}

// Runs BEFORE the corpus walk, and aborts it on any surprise.
//
// This is the countermeasure to the port's own failure mode: the harness reads
// numbers a generated script wrote, and a script that cannot report failure
// makes every page pass. So one snippet that must check clean and one that must
// not are run through the exact same path the corpus uses. The good one also
// imports `std/strings`, which proves BIT_STDLIB reached the child — without it
// every std-importing page would fail for a reason unrelated to the docs.
//
// Running them as ONE two-job batch is deliberate: it also pins the slot mapping
// the batch depends on. If every job were checking slot 0 the bad snippet would
// come back clean; if every job were checking the last slot the good one would
// fail. Either way this aborts, and no corpus page is ever judged by a runner
// that confuses one snippet with another.
export fn plumbingSelfTest(cfg: Cfg) {
  assert(cfg.jobs >= 2)
  let rs = runBatch(
    cfg,
    [
      "import { contains } from \"std/strings\"\n\nfn docsPlumbingOk(s: string): bool {\n  return contains(s, \"a\")\n}\n",
      "let docsPlumbingBad: int = \"not an int\"\n",
    ],
  )
  assert(len(rs) == 2)
  let good = rs[0]
  let bad = rs[1]

  if (good.code != 0) {
    die("plumbing: a known-good snippet did not check (status ${good.code}):\n${good.report}")
  }
  if (bad.code == 0) {
    die("plumbing: a DELIBERATELY BROKEN snippet checked clean — the runner is not recording the compiler's exit status, so this gate cannot fail. Captured output:\n${bad.report}")
  }
  if (!contains(bad.report, "error[")) {
    die("plumbing: the broken snippet failed (status ${bad.code}) but no diagnostics were captured — the output redirect is not wired. Captured:\n${bad.report}")
  }
}

// #3809's fmt-check half, same shape and same reason as `plumbingSelfTest`
// above: the fmt verdict is read from a generated script too, so it needs its
// own "the bad one must not come back clean" proof. Both snippets typecheck —
// only the second lacks the trailing comma `bit fmt` requires — so `check`'s
// own exit code cannot be what is actually distinguishing them.
export fn plumbingFmtSelfTest(cfg: Cfg) {
  assert(cfg.jobs >= 2)
  let rs = runBatch(
    cfg,
    [
      "class DocsPlumbingFmtGood {\n  x: int,\n}\n",
      "class DocsPlumbingFmtBad {\n  x: int\n}\n",
    ],
  )
  assert(len(rs) == 2)
  let good = rs[0]
  let bad = rs[1]

  if (good.code != 0) {
    die("fmt plumbing: a known-good snippet did not typecheck (status ${good.code}):\n${good.report}")
  }
  if (good.fmtCode != 0) {
    die("fmt plumbing: a canonically-formatted snippet failed bit fmt --check (status ${good.fmtCode}) — the fmt pass is miscomparing. Captured:\n${good.fmtReport}")
  }
  if (bad.code != 0) {
    die("fmt plumbing: the snippet missing its trailing comma failed to typecheck (status ${bad.code}) — it must typecheck cleanly so only fmt distinguishes it:\n${bad.report}")
  }
  if (bad.fmtCode == 0) {
    die("fmt plumbing: a snippet missing its required trailing comma passed bit fmt --check — the runner is not recording the fmt verdict, so this half of the gate cannot fail.")
  }
}

// A one-line, newline-escaped rendering, so a diff of captured text stays on one
// line and an empty value is visibly empty rather than invisible.
export fn jsonish(s: string): string {
  let out = "\""
  let i = 0
  while (i < len(s)) {
    let ch = s[i]
    if (ch == byte(10)) {
      out = out + "\\n"
    } else if (ch == byte(13)) {
      out = out + "\\r"
    } else if (ch == byte(34)) {
      out = out + "\\\""
    } else {
      out = out + string([ch])
    }
    i = i + 1
  }
  return out + "\""
}

// The scratch tree, the compiler copy and the runner script. Built once.
export fn setup(root: string): Cfg {
  let docsDir = envOr("BIT_DOCS", "${root}/docs")
  if (!isDir(docsDir)) {
    die("BIT_DOCS is not a directory: ${docsDir}")
  }

  let specDir = envOr("BIT_SPEC", "${root}/spec")
  if (!isDir(specDir)) {
    die("BIT_SPEC is not a directory: ${specDir}")
  }

  let stdlibDir = envOr("BIT_STDLIB", "${root}/stdlib")
  if (!isDir(stdlibDir)) {
    die("stdlib is not a directory: ${stdlibDir} (set BIT_STDLIB)")
  }

  // The compiler under test is the one built in this tree, never PATH's `bit`
  // — that is brew's release build, a different compiler entirely.
  let src = envOr("BIT", "${root}/bit-out/bin/bit")
  if (!exists(src)) {
    die("compiler under test is missing: ${src} (set BIT)")
  }

  let dir = "/tmp/bit-docsgate-${nonce()}"
  mkdir(dir) catch e {
    die("mkdir ${dir}: ${e.message()}")
  }
  // From here on, ANY `die()` — this function's own chmod/fanout/deadline
  // checks below, or one reached later from `docs.bit`'s corpus walk or batch
  // run — must reclaim this directory rather than leak it (#2951).
  setActiveScratch(dir)

  let bin = binFile(dir)
  spill(bin, slurp(src, "compiler under test"), "compiler copy")
  if (fsChmod(bin, 493) != 0) {
    die("chmod ${bin}")
  }

  let cfg = Cfg{
    bin: bin,
    stdlibDir: stdlibDir,
    docsDir: docsDir,
    specDir: specDir,
    dir: dir,
    jobs: fanout(),
    script: scriptFile(dir),
    countPath: countFile(dir),
    timeoutMs: deadlineMs(),
  }
  writeRunner(cfg)
  return cfg
}

// How many `bit check` run at once. 12 is where the measured curve flattens
// (303s serial, 56s at 8, 48s at 12, 50s at 16 — beyond that they contend); a
// fixed number rather than a core count because Bit cannot ask for one, with
// `BIT_DOCS_JOBS` as the knob for a smaller host. Below 2 the plumbing
// self-test's slot-mapping check has nothing to distinguish.
fn fanout(): int {
  let raw = envOr("BIT_DOCS_JOBS", "12")
  let jobs = parseInt(raw) catch _ {
    die("BIT_DOCS_JOBS is not an integer: ${jsonish(raw)}")
    12
  }
  if (jobs < 2 || jobs > maxFanout) {
    die("BIT_DOCS_JOBS must be between 2 and ${maxFanout}, got ${jobs}")
  }
  return jobs
}

// The bound on the one runner invocation. 0 disables the bound in the deleted
// harnesses; ABI.md §19 has no "forever", so it maps to the 100-minute clamp
// rather than being silently treated as 0ms.
fn deadlineMs(): i64 {
  let raw = envOr("BIT_TEST_TIMEOUT_S", "300")
  let timeoutS = parseInt(raw) catch _ {
    die("BIT_TEST_TIMEOUT_S is not an integer: ${jsonish(raw)}")
    300
  }
  if (timeoutS <= 0) {
    return i64(6000000)
  }
  return i64(timeoutS) * 1000
}

// Written ONCE, then never touched again: rewriting a script between execs is
// the ETXTBSY hazard. It reads its per-batch input (`n.txt`) rather than being
// regenerated, and `echo $?` on its own line after the compiler is the
// load-bearing token — that file IS the snippet's verdict, and `slotResult`
// aborts rather than assume anything when it is missing.
//
// `mkdir` is the claim, because it is the one atomic test-and-set POSIX sh has:
// exactly one worker can create `c$id`, so exactly one worker runs job `id` and
// a loser moves straight on. That is what makes workers PULL work. `</dev/null`
// stops the background workers sharing the shell's stdin, and `wait` with no
// operand waits for all of them, so the runner cannot return while a check is
// still writing its status.
//
// #3809: each claimed job also runs `bit fmt --check` on the same module file,
// writing its own `fo$id`/`fs$id` pair alongside `check`'s `o$id`/`s$id` —
// unconditionally, even when `check` failed, so the script has no branch that
// could skip recording a verdict. `docs.bit` decides whether the fmt verdict
// is worth reporting for a job whose typecheck already failed.
fn writeRunner(cfg: Cfg) {
  spill(
    cfg.script,
      "#!/bin/sh\n" +
      "BIT_STDLIB='${cfg.stdlibDir}'\n" +
      "export BIT_STDLIB\n" +
      "cd '${cfg.dir}' || exit 111\n" +
      "n=$(cat n.txt) || exit 112\n" +
      "[ \"$n\" -ge 1 ] || exit 113\n" +
      "w=0\n" +
      "while [ \"$w\" -lt ${cfg.jobs} ]; do\n" +
      "  (\n" +
      "    id=0\n" +
      "    while [ \"$id\" -lt \"$n\" ]; do\n" +
      "      if mkdir \"c$id\" 2>/dev/null; then\n" +
      "        '${cfg.bin}' check \"w$id\" >\"o$id\" 2>&1\n" +
      "        echo $? >\"s$id\"\n" +
      "        '${cfg.bin}' fmt --check \"w$id/main.bit\" >\"fo$id\" 2>&1\n" +
      "        echo $? >\"fs$id\"\n" +
      "      fi\n" +
      "      id=$((id+1))\n" +
      "    done\n" +
      "  ) </dev/null &\n" +
      "  w=$((w+1))\n" +
      "done\n" +
      "wait\n" +
      "exit 0\n",
    "runner script",
  )
  if (fsChmod(cfg.script, 493) != 0) {
    die("chmod ${cfg.script}")
  }
}

// std/fs has no recursive delete, so every leaf is named. Failures here are
// reported, not fatal: the run's verdict is already decided (or, when reached
// through `die()`'s `reclaimScratch`, IS the failure being reported).
//
// Takes the scratch root as a bare `dir`, not a `Cfg`: `die()` may fire before
// a `Cfg` exists (a `setup()` validation failure) with only the directory it
// already `mkdir`ed, so `teardown` must be callable from that alone (#2951).
export fn teardown(dir: string) {
  for p of [scriptFile(dir), countFile(dir), binFile(dir)] {
    drop(p)
  }
  // Every slot the batch COULD have used, not just the ones it did: a bounded
  // sweep is cheaper to trust than a second copy of the batch size.
  let i = 0
  while (i < maxJobs) {
    drop(slotMain(dir, i))
    drop(slotOut(dir, i))
    drop(slotStatus(dir, i))
    drop(slotFmtOut(dir, i))
    drop(slotFmtStatus(dir, i))
    drop(slotClaim(dir, i))
    drop(slotDir(dir, i))
    i = i + 1
  }
  drop(dir)
  // Only one scratch root is ever live per run (`setup()` is called once from
  // `main`), so an unconditional clear is correct: nothing left to reclaim.
  activeScratchLen = 0
}

fn drop(path: string) {
  if (exists(path)) {
    remove(path) catch e {
      eprint("docs: warning: cannot remove ${path}: ${e.message()}\n")
    }
  }
}
