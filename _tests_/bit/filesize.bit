// tests/bit/filesize.bit — a file-size ratchet over tests/bit/*.bit (#2793).
//
// docs/development.md and CONTRIBUTING.md set an 800-line hard limit per file,
// backed by compiler/lint.bit's E0200 `max-file-lines` rule — but no gate ever
// pointed `bit lint` (or anything else) at `tests/bit/` itself, so seven
// harness files drifted past the limit with nothing to catch it (#2793):
// stwwiring.bit (993), clicmd.bit (952), abimembers.bit (917), rootpins.bit
// (905), rootabi.bit (821), golden.bit (819), stress.bit (805). Two more sit
// at exactly 800 (docs.bit, spec.bit) — legal, with zero headroom.
//
// THAT INVENTORY IS NOW HISTORY, kept because it is what the gate was built
// against. #2862 dropped `golden.bit`'s entry at 711 (under 800 for good);
// #2867 phase 1 split `stress.bit` into `stress/{stress,verify}.bit`
// (540+298); #2867 phase 2 split the remaining five into their own
// directories (`stwwiring/`, `clicmd/`, `abimembers/`, `rootpins/`,
// `rootabi/` — every resulting file under 800). `grandfatherList` below is
// EMPTY as a result, not retired: the mechanism stays in place for the next
// harness that grows past 800 faster than it can be split, exactly as it
// covered these seven while #2867 was pending.
//
// THE RULE IS `> 800` FAILS, NOT `>= 800` — the same threshold E0200 uses
// (compiler/lint.bit's `lintMaxFileLines`: `n <= limit` passes), so a file
// sitting exactly at 800 is not a false positive.
//
// THE RATCHET, STILL LIVE WITH ZERO ENTRIES. Splitting seven test files —
// one of them 993 lines — was a real refactor per file (#2867's own job, not
// #2793's). `grandfatherList` existed so introducing the limit into a tree
// that already violated it seven times over meant grandfathering the
// existing offenders rather than either (a) blocking every future edit to
// `tests/bit/` on an unrelated refactor, or (b) silently exempting
// `tests/bit/` from the limit forever — and that is still the mechanism's
// job for WHATEVER FILE NEEDS IT NEXT: each entry carries the file's line
// count AS MEASURED when it was grandfathered, and a grandfathered file may
// only ever get SMALLER — growing even one line past its recorded count
// fails the gate, naming the file and both counts. A file with no entry
// (which today means every file in the tree, and always means any new file
// dropped into tests/bit/) must comply with the 800-line limit immediately;
// there is no default exemption.
//
// THE DEBT STAYS VISIBLE. `reportResult` prints how many grandfathered files
// are STILL over 800 right now and their combined overage every run — an
// allowlist nobody has to look at is exactly the kind of green-but-unverified
// result a hidden count produces. This gate's count is not hidden: both
// numbers print unconditionally, every run, rather than resting on a
// citation to somewhere else nobody re-checks. With the list empty, both
// numbers are unconditionally 0 — the honest answer, not a special case
// carved out for an empty list.
//
// SCOPE: `.bit` files anywhere under `tests/bit/`, RECURSIVELY (#2868) — a
// harness moved one directory down (exactly what splitting an over-limit
// harness into a directory project does, see #2867) must stay inside the
// gate, not fall out of it.
//
// The one exclusion is a FIXTURE CORPUS — `checkercases/`, `parsercases/`,
// and any future sibling — decided by a PROPERTY of the directory, never by
// a name list: a directory holding at least one `.expected` file is a
// fixture corpus (its `.bit` files are deliberately malformed or oversized
// inputs consumed by `test-checker-diag`/`test-parser`, not harnesses with
// their own `fn main()`), and every `.bit` file anywhere beneath it counts
// toward BOTH the scanned total and the skipped total — visited, but never
// checked against the line limit. A hardcoded two-name list would
// silently exempt a third fixture corpus the same way plain non-recursion
// exempted a harness one level down — that is the defect this gate exists to
// close, not to reintroduce under another name. `reportResult` prints how
// many `.bit` files were skipped this way, so "nothing to exclude" and
// "silently excluded everything" never look the same.
//
// `BIT_REPO` overrides the directory searched for a `tests/bit` subdirectory,
// the same override every other tests/bit/*.bit harness in this family reads
// (default: search . / .. / ../.. / ../../..) — used by this gate's own
// mutation tests to point the scan at a scratch tree instead of the real one.
//
// Run from the repository root: bit-out/bin/bit run tests/bit/filesize.bit

import { readDir, readFile, isDir } from "std/fs"
import { env } from "std/os"
import { hasSuffix } from "std/strings"

// Bounds — Power of 10 rule 2: every walk below is over a small, fixed
// directory, but each is still capped explicitly.
const maxFiles: int = 256
const maxFileBytes: int = 4194304

// How many `tests/bit/` subdirectory levels `scanDir` will descend — a bound
// on the recursion itself (Power of 10 rule 2), not a real limit `tests/bit/`
// is expected to approach; its deepest real nesting today is one level
// (`checkercases/`, `parsercases/`).
const maxScanDepth: int = 16

// The hard limit itself — E0200's default in compiler/lint.bit, restated here
// rather than imported: this gate is deliberately independent of the checker
// front end (it never invokes `bit lint`), so a bug in the checker cannot
// silently disable it.
const maxFileLines: int = 800

// One grandfathered file: `lines` is its line count AS MEASURED when it was
// grandfathered, and the ceiling it may never grow past again.
class Grandfathered { name: string, lines: int }

// EMPTY (#2867 phase 2). The five entries this list carried — stwwiring.bit,
// clicmd.bit, abimembers.bit, rootpins.bit, rootabi.bit — are gone because
// their FILES are gone: each was split into its own tests/bit/<name>/
// directory (a directory-target module, no `import` needed between the
// pieces), and neither resulting file is over 800 lines, so neither needs
// grandfathering. `golden.bit` left the same way at 711 for a different
// reason (#2862 shrank it under 800 rather than splitting it; #2867 phase 1
// then dropped its now-pointless entry) — but the rule is identical either
// way: a file under 800 is governed by `maxFileLines` like every other file
// and gets no entry here. EVERY ENTRY HERE IS OVER 800. That is the one
// thing this list means — a pin below the limit turns it into a second,
// stricter, per-file ratchet with no stated rule, which is how
// `reportResult` once printed "5 still over 800" while listing 6 files. Do
// not re-add an entry for a file that is already compliant.
//
// THE MECHANISM STAYS: the next tests/bit/*.bit harness that grows past 800
// faster than it can be split gets an entry here, `lines` set to its count
// AS MEASURED at that moment — shrunk or removed once the file is split or
// trimmed back under 800, never raised.
fn grandfatherList(): []Grandfathered {
  return []Grandfathered(0)
}

class ScanResult {
  failures: int
  filesScanned: int
  filesSkipped: int
  grandfatheredOver: int
  overageTotal: int
}

fn die(msg: string) {
  eprint("filesize: SETUP FAILED: ${msg}\n")
  osExit(1)
}

fn report(sc: ScanResult, msg: string) {
  eprint("filesize: FAIL: ${msg}\n")
  sc.failures = sc.failures + 1
}

// The repo root: the nearest ancestor holding a `tests/bit` directory.
// `BIT_REPO` wins outright, including for a scratch tree this gate's own
// mutation tests point it at — never falls back silently.
fn repoRoot(): string {
  let override = env("BIT_REPO")
  if (len(override) > 0) {
    return override
  }
  let candidates = [".", "..", "../..", "../../.."]
  for c of candidates {
    if (isDir("${c}/tests/bit")) {
      return c
    }
  }
  die("cannot locate a tests/bit directory from this cwd; set BIT_REPO")
  return ""
}

// Mirrors compiler/lint.bit's `lintCountLines` exactly, so this gate's counts
// agree with E0200's: every `\n`, plus one more if the file's last byte is
// not itself a `\n` (an unterminated final line still counts).
fn lineCount(src: string): int {
  if (len(src) == 0) {
    return 0
  }
  let n = 0
  let i = 0
  while (i < len(src)) {
    if (src[i] == '\n') {
      n = n + 1
    }
    i = i + 1
  }
  if (src[len(src) - 1] != '\n') {
    n = n + 1
  }
  return n
}

fn findGrandfathered(list: []Grandfathered, name: string): (Grandfathered, bool) {
  for g of list {
    if (g.name == name) {
      return g, true
    }
  }
  return Grandfathered{ name: "", lines: 0 }, false
}

// One file's verdict, computed with NO side effect — deliberately separate
// from `checkFile` below so `selfTestEvaluateFile` can drive this against
// synthetic names and counts without also triggering `report`'s stderr
// output, which would otherwise make a clean self-test print what looks like
// a real failure. `violates` decides pass/fail; `overLimit`/`overage` feed
// the visible debt tally regardless of `violates` — a grandfathered file
// still over `maxFileLines` but under its recorded ceiling is passing AND
// still counted as debt.
class Verdict { violates: bool, msg: string, overLimit: bool, overage: int }

fn evaluateFile(list: []Grandfathered, name: string, count: int): Verdict {
  let (g, found) = findGrandfathered(list, name)
  if (found) {
    let overLimit = count > maxFileLines
    let overage = 0
    if (overLimit) {
      overage = count - maxFileLines
    }
    return Verdict{
      violates: count > g.lines,
      msg: "tests/bit/${name} grew to ${count} lines, past its grandfathered ${g.lines} — a grandfathered file may only get smaller",
      overLimit: overLimit, overage: overage,
    }
  }
  return Verdict{
    violates: count > maxFileLines,
    msg: "tests/bit/${name} is ${count} lines, over the ${maxFileLines}-line limit with no grandfather entry",
    overLimit: false, overage: 0,
  }
}

// One file's real verdict, applied: reports a violation and/or tallies debt
// against `sc`. The only caller of `report` in this file — self-tests drive
// `evaluateFile` directly instead, so they never print.
fn checkFile(sc: ScanResult, list: []Grandfathered, name: string, count: int) {
  let v = evaluateFile(list, name, count)
  if (v.violates) {
    report(sc, v.msg)
  }
  if (v.overLimit) {
    sc.grandfatheredOver = sc.grandfatheredOver + 1
    sc.overageTotal = sc.overageTotal + v.overage
  }
}

// Whether `names` (one directory's listing) marks that directory as a
// FIXTURE CORPUS: a `.bit`/`.expected` pair corpus consumed by
// `test-checker-diag`/`test-parser`, not a harness with its own `fn main()`.
// This is the one property #2868 decides the exclusion by — never a name
// list, so a third fixture corpus added anywhere under `tests/bit/` is
// excluded automatically instead of silently escaping the gate the way
// plain non-recursion did.
fn isFixtureCorpus(names: []string): bool {
  for name of names {
    if (hasSuffix(name, ".expected")) {
      return true
    }
  }
  return false
}

// The number of `.bit` files anywhere beneath `dir` (whose listing is
// `names`), recursively — used to credit both `filesScanned` and
// `filesSkipped` for a fixture corpus's files, so a corpus with its own
// subdirectories (none exist today, but the exclusion is a property, not a
// name list, so one could) still contributes an honest count rather than a
// silent zero.
fn countBitFilesIn(dir: string, names: []string, depth: int): int {
  if (depth <= 0) {
    die("tests/bit nesting exceeds ${maxScanDepth} levels at ${dir}")
  }
  let count = 0
  for name of names {
    let path = "${dir}/${name}"
    if (isDir(path)) {
      let subNames = readDir(path) catch e {
        die("cannot list ${path}: ${e.message()}")
        []string(0)
      }
      if (len(subNames) > maxFiles) {
        die("${path} has ${len(subNames)} entries, over the ${maxFiles} bound")
      }
      count = count + countBitFilesIn(path, subNames, depth - 1)
    } else {
      if (hasSuffix(name, ".bit")) {
        count = count + 1
      }
    }
  }
  return count
}

// Joins a scan-relative path (empty at `tests/bit/` itself) with one more
// path segment, without a leading "/" when `rel` is still empty — so a
// root-level file's name is reported exactly as before (`tests/bit/${name}`)
// and a nested one carries its subdirectory (`tests/bit/harness/${name}`).
fn relJoin(rel: string, name: string): string {
  if (len(rel) == 0) {
    return name
  }
  return "${rel}/${name}"
}

// Recurses through `dir` (whose path relative to `tests/bit/` is `rel`,
// "" at the top), scanning every `.bit` file it finds against `list` and
// skipping every `.bit` file under a directory `isFixtureCorpus` marks as a
// fixture corpus. `depth` is `maxScanDepth` at the top call and falls to 0 at
// the deepest permitted level — Power of 10 rule 2's bound on the recursion.
fn scanDir(sc: ScanResult, dir: string, rel: string, list: []Grandfathered, depth: int) {
  if (depth <= 0) {
    die("tests/bit nesting exceeds ${maxScanDepth} levels at ${dir}")
  }
  let names = readDir(dir) catch e {
    die("cannot list ${dir}: ${e.message()}")
    []string(0)
  }
  if (len(names) > maxFiles) {
    die("${dir} has ${len(names)} entries, over the ${maxFiles} bound")
  }
  if (isFixtureCorpus(names)) {
    let skipped = countBitFilesIn(dir, names, depth)
    sc.filesScanned = sc.filesScanned + skipped
    sc.filesSkipped = sc.filesSkipped + skipped
    return
  }
  for name of names {
    let path = "${dir}/${name}"
    if (isDir(path)) {
      scanDir(sc, path, relJoin(rel, name), list, depth - 1)
      continue
    }
    if (!hasSuffix(name, ".bit")) {
      continue
    }
    let src = readFile(path) catch e {
      die("cannot read ${path}: ${e.message()}")
      ""
    }
    if (len(src) > maxFileBytes) {
      die("${path} is ${len(src)} bytes, over the ${maxFileBytes} bound")
    }
    sc.filesScanned = sc.filesScanned + 1
    checkFile(sc, list, relJoin(rel, name), lineCount(src))
  }
}

// `filesScanned` counts every `.bit` file the walk visited, INCLUDING the
// ones inside a fixture corpus; `filesSkipped` (always <= `filesScanned`) is
// the subset of those that were never checked against the line limit
// because `isFixtureCorpus` excluded their directory. Printing both, rather
// than just a shrunken "scanned" total with the exclusions folded in
// silently, is the fix for the asymmetry #2868 named: a scanned count alone
// cannot tell "nothing to exclude" apart from "silently excluded
// everything", but scanned-vs-skipped can.
fn reportResult(sc: ScanResult) {
  if (sc.failures > 0) {
    eprint("filesize: FAILED — ${sc.failures} finding(s) over ${sc.filesScanned} file(s) scanned, ${sc.filesSkipped} file(s) skipped as fixture corpora\n")
    osExit(1)
  }
  print("filesize: ok — ${sc.filesScanned} file(s) scanned, ${sc.filesSkipped} file(s) skipped as fixture corpora, ${sc.grandfatheredOver} grandfathered file(s) still over the ${maxFileLines}-line limit, ${sc.overageTotal} line(s) total overage\n")
}

fn selfCheck(cond: bool, label: string): int {
  if (cond) {
    return 0
  }
  eprint("filesize: SELFTEST FAIL: ${label}\n")
  return 1
}

fn selfTestLineCount(): int {
  let failed = 0
  failed = failed + selfCheck(lineCount("") == 0,
    "lineCount misjudged an empty file")
  failed = failed + selfCheck(lineCount("abc") == 1,
    "lineCount misjudged a file with no trailing newline")
  failed = failed + selfCheck(lineCount("abc\n") == 1,
    "lineCount misjudged a single terminated line")
  failed = failed + selfCheck(lineCount("a\nb\n") == 2,
    "lineCount misjudged two terminated lines")
  failed = failed + selfCheck(lineCount("a\nb") == 2,
    "lineCount misjudged a trailing unterminated line")
  return failed
}

fn freshScan(): ScanResult {
  return ScanResult{ failures: 0, filesScanned: 0, filesSkipped: 0, grandfatheredOver: 0, overageTotal: 0 }
}

// Exercises `evaluateFile` against synthetic names and counts BEFORE the real
// scan, on the same principle as spec.bit's selfTest: a bug in the verdict
// logic must be caught on known-good/known-bad input, not silently mis-score
// the real corpus. Drives `evaluateFile` (the pure decision), not `checkFile`
// (which calls `report` and would print a stderr line for every synthetic
// case here, indistinguishable from a real finding).
fn selfTestEvaluateFile(): int {
  let failed = 0
  let list = [Grandfathered{ name: "old.bit", lines: 900 }]

  let grow = evaluateFile(list, "old.bit", 901)
  failed = failed + selfCheck(grow.violates,
    "evaluateFile did not flag a grandfathered file that grew past its recorded count")

  let shrink = evaluateFile(list, "old.bit", 850)
  failed = failed + selfCheck(!shrink.violates,
    "evaluateFile flagged a grandfathered file that stayed under its recorded count")
  failed = failed + selfCheck(shrink.overLimit && shrink.overage == 50,
    "evaluateFile miscomputed overage for a grandfathered file still over the limit")

  let newOver = evaluateFile(list, "brandnew.bit", 801)
  failed = failed + selfCheck(newOver.violates,
    "evaluateFile did not flag a non-grandfathered file over the limit")

  let newUnder = evaluateFile(list, "brandnew.bit", 800)
  failed = failed + selfCheck(!newUnder.violates,
    "evaluateFile flagged a non-grandfathered file sitting exactly at the limit")

  // The EMPTY list `grandfatherList` now returns (#2867 phase 2) is not the
  // same code path as "a list with no matching entry" above — `list` there
  // still has one element, just not one named "brandnew.bit". This drives
  // `findGrandfathered`'s `for` loop over zero elements, the one shape no
  // test exercised until the list actually went empty in production.
  let empty = []Grandfathered(0)
  let emptyOver = evaluateFile(empty, "brandnew.bit", 801)
  failed = failed + selfCheck(emptyOver.violates,
    "evaluateFile did not flag an over-limit file against an EMPTY grandfather list")
  let emptyUnder = evaluateFile(empty, "brandnew.bit", 800)
  failed = failed + selfCheck(!emptyUnder.violates,
    "evaluateFile flagged an at-limit file against an EMPTY grandfather list")

  return failed
}

// Exercises the property decision directly: a directory listing with an
// `.expected` file anywhere in it is a fixture corpus regardless of how many
// `.bit` files sit beside it; one with none, however many `.bit` files, is a
// harness directory `scanDir` must recurse into and scan.
fn selfTestIsFixtureCorpus(): int {
  let failed = 0
  failed = failed + selfCheck(
    isFixtureCorpus(["run_x.bit", "run_x.expected"]),
    "isFixtureCorpus missed a directory holding a .bit/.expected pair")
  failed = failed + selfCheck(
    isFixtureCorpus(["a.bit", "b.bit", "only_one.expected"]),
    "isFixtureCorpus missed a directory with several .bit files and one .expected file")
  failed = failed + selfCheck(
    !isFixtureCorpus(["main.bit", "helper.bit"]),
    "isFixtureCorpus flagged a plain harness directory with no .expected file")
  failed = failed + selfCheck(
    !isFixtureCorpus([]string(0)),
    "isFixtureCorpus flagged an empty directory listing")
  return failed
}

fn selfTestRelJoin(): int {
  let failed = 0
  failed = failed + selfCheck(relJoin("", "toplevel.bit") == "toplevel.bit",
    "relJoin should not prefix a top-level tests/bit/ file with a separator")
  failed = failed + selfCheck(relJoin("harness", "hidden.bit") == "harness/hidden.bit",
    "relJoin did not join a one-level subdirectory correctly")
  failed = failed + selfCheck(relJoin("a/b", "c.bit") == "a/b/c.bit",
    "relJoin did not join a two-level subdirectory correctly")
  return failed
}

fn selfTest(): int {
  return selfTestLineCount() + selfTestEvaluateFile() + selfTestIsFixtureCorpus() + selfTestRelJoin()
}

fn main() {
  let selfFailed = selfTest()
  if (selfFailed != 0) {
    eprint("filesize: SELFTEST FAILED — ${selfFailed} case(s); aborting before the real scan\n")
    osExit(1)
  }

  let root = repoRoot()
  let dir = "${root}/tests/bit"
  let sc = freshScan()
  scanDir(sc, dir, "", grandfatherList(), maxScanDepth)
  reportResult(sc)
}
