// `bit lint` never ran over the project's OWN source (#2354): 1,273+ findings
// grew unseen in compiler/ and stdlib/. This gate is what stops that
// happening again -- and, since #4149's owner ruling on 2026-09-10, it does
// so by NAME rather than by count.
//
// WHAT THIS REPLACED, AND WHY. Until that ruling this harness was a COUNT
// ratchet against tools/build/lint-ceiling.txt: per-scope totals plus a
// per-rule ceiling for E0201 and E0202 (#2453). Two things a count cannot
// do, both of which happened here:
//   - it absorbs an unrelated new violation whenever someone else fixes one
//     (that is exactly why #2453 had to add per-rule lines: E0201 went
//     64 -> 96 and E0202 63 -> 92 in compiler/ behind a total that never
//     moved -- and a per-rule count has the same hole one level down);
//   - it is defeated by ADDING a file rather than editing one, as long as
//     the scope total still fits.
// The owner's ruling: no counted ceilings anywhere. Every debt list is a
// paydown queue that ratchets to zero and is then DELETED, never a permanent
// exemption. So the ceiling file is gone and tools/build/lint-debt.txt names
// every (rule code, file) pair that has a live finding today.
//
// THE CONTRACT IS TWO-WAY, the same one _tests_/bit/lintaux.bit (#4149) and
// _tests_/bit/fmtzerocheck.bit (#3713) enforce for their own lists (
// _tests_/bit/linttests.bit enforced it too, until epic #4249 paid its list
// off and it became a hard zero):
//   - a live finding whose (code, file) pair is NOT on the list is a hard
//     failure, whatever any total does;
//   - a listed pair with NO live finding is ALSO a hard failure -- the file
//     was fixed and nobody deleted the line, which is how a debt list rots
//     into the permanent exemption the ruling forbids.
// An absent tools/build/lint-debt.txt is not an error and not a skip: it is
// a hard zero, which is what "deleted at zero" has to mean for the deletion
// to be safe.
//
// IDENTITY IS (CODE, FILE), deliberately. Per-FILE alone would let a second
// rule appear in an already-listed file unseen. Per-FUNCTION is what
// test-lint-complexity does for E0204 and it cannot be done here: E0201 and
// E0202 land on anonymous arrow functions, which have no name a key could
// use -- linttests.bit and lintaux.bit made the same call for the same
// reason.
//
// E0214 (append-aliasing) GETS NO SPECIAL CASE ANY MORE, and loses nothing
// by it. The old harness checked it at an unconditional zero because it is a
// correctness class, not a readability one, while the ratchet covered
// everything else. Under a named list a new E0214 finding fails this gate on
// exactly the same terms: its pair is not listed. What changed is the scope
// -- tools/ is linted here now (#4149), and its two live E0214 findings in
// tools/build/main.bit, which NO gate could see before, are on the list as
// debt to pay down. compiler/, runtime/ and stdlib/ carry zero
// E0214 lines and adding one is a reviewed edit to a paydown-only file.
//
// Distinct from its neighbours: test-lint-runtime (E0211 at zero, runtime/
// only), test-lint-filelines (E0200 only, seven directories),
// test-lint-complexity (E0201/E0202/E0204 per FUNCTION, production),
// test-lint-aux (every code, examples/ + bench/ + editors/). This one is
// every code over compiler/ + runtime/ + stdlib/ + tools/.
//
// BIT_REPO IS REQUIRED, same reason as every sibling: the harness reads
// ${BIT_REPO}/tools/build/lint-debt.txt and points `bit lint` at
// ${BIT_REPO}/compiler and its three siblings, and must not silently
// default to ".".
//
// Run it from the repository root:
//     ./bit-out/bin/bit run _tests_/bit/lintself.bit
import { env, envOr, exit } from "std/os"
import { exists, isDir, mkdir, readDir, readFile, writeFile } from "std/fs"
import { compare, hasPrefix, hasSuffix, parseInt, split, trimSpace } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"
import { Json, jsonAsArray, jsonAsInt, jsonAsString, jsonGet, jsonParse } from "std/json"

// Power of 10 rule 2: every walk below has a statically bounded depth and a
// bounded per-directory fan-out, not merely a hope of termination.
const maxEntries: int = 4096
const maxScanDepth: int = 16
const defaultTimeoutS: int = 300
const debtPath: string = "tools/build/lint-debt.txt"

fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "${defaultTimeoutS}")) catch _ {
    defaultTimeoutS
  }
  if (s <= 0) {
    return defaultTimeoutS * 1000
  }
  return s * 1000
}

// The thirteen rule codes spec/LINT.md defines. An `E02` diagnostic outside
// this list means the spec grew a rule; see `assertKnownCode`.
fn lintCodes(): []string {
  return [
    "E0200", "E0201", "E0202", "E0203", "E0204", "E0205",
    "E0210", "E0211", "E0212", "E0213", "E0214", "E0215", "E0216",
  ]
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}

// Runs `script` through /bin/sh and returns its exit code. Negative returns
// are `osRunBounded`'s mechanism channel, never a program exit status, so
// each one is a named panic rather than a value any assertion could consume.
fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    fail newError("lintself: cannot make script executable: ${scriptPath}")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == -2) {
    panic("lintself: TIMED OUT after ${ms}ms running ${scriptPath}")
  }
  if (code == -1) {
    panic("lintself: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("lintself: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}

fn requiredEnv(name: string): string! {
  let v = env(name)
  if (len(v) == 0) {
    fail newError("lintself: ${name} is required and was not set")
  }
  return v
}

fn containsStr(xs: []string, s: string): bool {
  for x of xs {
    if (x == s) {
      return true
    }
  }
  return false
}

// ---- the named debt list -------------------------------------------------

// One `<CODE> <repo-relative-path>` line of tools/build/lint-debt.txt.
class Debt { code: string, file: string }

fn debtHas(debt: []Debt, code: string, file: string): bool {
  for d of debt {
    if (d.code == code && d.file == file) {
      return true
    }
  }
  return false
}

// A line is `<CODE> <path>`, `#`-comments and blanks skipped. An unknown code
// is refused rather than ignored: a typo'd code would otherwise sit here
// matching nothing, and its real findings would go unlisted and red with no
// hint why.
fn parseDebtLine(line: string, seen: []Debt): Debt! {
  let fields = split(line, " ")
  if (len(fields) != 2) {
    fail newError("lintself: malformed ${debtPath} line: '${line}' -- want '<CODE> <repo-relative-path>'")
  }
  if (!containsStr(lintCodes(), fields[0])) {
    fail newError("lintself: ${debtPath} names rule code '${fields[0]}', which spec/LINT.md's list in lintCodes() does not")
  }
  if (debtHas(seen, fields[0], fields[1])) {
    fail newError("lintself: ${debtPath} lists '${line}' twice")
  }
  return Debt{ code: fields[0], file: fields[1] }
}

fn parseDebtFile(text: string): []Debt! {
  let out = []Debt(0)
  for rawLine of split(text, "\n") {
    let line = trimSpace(rawLine)
    if (len(line) == 0 || hasPrefix(line, "#")) {
      continue
    }
    out = append(out, parseDebtLine(line, out)?)
  }
  return out
}

// An absent file is a hard zero, not a skip: that is what makes deleting the
// file at zero -- which the owner's ruling requires -- a safe thing to do.
fn loadDebt(repo: string): []Debt! {
  let path = "${repo}/${debtPath}"
  if (!exists(path)) {
    println("lint-self: no ${debtPath} -- every finding below is unlisted (hard zero).")
    return []Debt(0)
  }
  return parseDebtFile(readFile(path)?)?
}

class Config { bit: string, repo: string, debt: []Debt }

fn loadConfig(): Config! {
  let bit = requiredEnv("BIT_SELF_EXE")?
  let repo = requiredEnv("BIT_REPO")?
  return Config{ bit: bit, repo: repo, debt: loadDebt(repo)? }
}

// ---- the independent `.bit` walk ----------------------------------------

// `bit-out` is a build directory and a dot-directory is never source (#4154
// fixed `bit lint <dir>` walking into both); this walk skips exactly what the
// compiler's own directory expansion skips, so the denominator it prints
// describes the same population `bit lint` was handed.
fn skipDir(name: string): bool {
  return hasPrefix(name, ".") || name == "bit-out"
}

fn collectBitFiles(dir: string, depth: int): []string {
  if (depth <= 0) {
    panic("lintself: ${dir} nesting exceeds ${maxScanDepth} levels")
  }
  let names = readDir(dir) catch e {
    panic("lintself: cannot list ${dir}: ${e.message()}")
  }
  if (len(names) > maxEntries) {
    panic("lintself: ${dir} has ${len(names)} entries, over the ${maxEntries} bound")
  }
  let out = []string(0)
  for name of names {
    let path = "${dir}/${name}"
    if (isDir(path)) {
      if (!skipDir(name)) {
        for f of collectBitFiles(path, depth - 1) {
          out = append(out, f)
        }
      }
    } else if (hasSuffix(name, ".bit")) {
      out = append(out, path)
    }
  }
  return out
}

// ---- `bit lint --json <dirs...>` ----------------------------------------

class Run { code: int, out: string, err: string }

fn quotedPaths(paths: []string): string {
  let out = ""
  for p of paths {
    out = out + " '${p}'"
  }
  return out
}

fn runLintJson(bit: string, absDirs: []string, capDir: string, ms: int): Run! {
  let outPath = "${capDir}/out.json"
  let errPath = "${capDir}/err.txt"
  let codePath = "${capDir}/code.txt"
  let script = "#!/bin/sh\n" +
    "'${bit}' lint --json" +
    quotedPaths(absDirs) +
    " > '${outPath}' 2> '${errPath}'\n" +
    "echo $? > '${codePath}'\n" +
    "exit 0\n"
  let sh = shell("${capDir}/lint.sh", script, ms)?
  if (sh != 0) {
    fail newError("lintself: wrapper script exited ${sh}, which it never should")
  }
  if (!exists(codePath)) {
    fail newError("lintself: no exit code was recorded -- the run never happened")
  }
  return Run{
    code: parseInt(trimWs(readFile(codePath)?))?,
    out: readFile(outPath)?,
    err: readFile(errPath)?,
  }
}

// `r` is a usable observation of a real run, not silence mistaken for a clean
// sheet. `bit lint` always prints a summary to stderr, clean or not. Exit 2
// is SPEC's own "could not be trusted" verdict -- one malformed file blanks
// every finding for every OTHER file in the same invocation (#3543), so it is
// a panic, never a pass.
fn assertTrustworthy(r: Run, label: string) {
  if (len(r.err) == 0) {
    panic("lintself: stderr is empty -- `bit lint` produced no summary for ${label}")
  }
  if (r.code == 2) {
    panic("lintself: `bit lint` exited 2 (untrusted run) over ${label}:\n${r.err}")
  }
  if (r.code != 0 && r.code != 1) {
    panic("lintself: `bit lint` exited ${r.code} over ${label}, want 0 or 1")
  }
}

// `bit lint`'s own last word: `lint: N findings, M overrides active`.
class Summary { findings: int, overrides: int }

fn parseSummary(err: string): Summary! {
  for line of split(err, "\n") {
    let t = trimWs(line)
    if (!hasPrefix(t, "lint: ")) {
      continue
    }
    let fields = split(t, " ")
    if (len(fields) < 4) {
      fail newError("lintself: unparsable summary line: '${t}'")
    }
    return Summary{ findings: parseInt(fields[1])?, overrides: parseInt(fields[3])? }
  }
  fail newError("lintself: `bit lint` printed no `lint: N findings` summary line")
}

// ---- findings ------------------------------------------------------------

class Finding { file: string, code: string, line: int }

fn jsonField(o: Json, key: string): string {
  let f = jsonGet(o, key)
  if (isNone(f)) {
    return "<missing>"
  }
  return unwrapOr(jsonAsString(unwrap(f)), "<not-a-string>")
}

fn jsonInt(o: Json, key: string): int {
  let f = jsonGet(o, key)
  if (isNone(f)) {
    return -1
  }
  return unwrapOr(jsonAsInt(unwrap(f)), -1)
}

fn stripRepoPrefix(file: string, repo: string): string! {
  let prefix = "${repo}/"
  if (!hasPrefix(file, prefix)) {
    fail newError("lintself: finding path outside ${repo}: ${file}")
  }
  return file[len(prefix):]
}

// A diagnostic whose code is in the `E02` block but not one spec/LINT.md
// defines means a rule was added and this gate's list was not updated -- it
// would otherwise be dropped by the filter in `extractFindings` and never
// enforced anywhere.
fn assertKnownCode(code: string) {
  if (hasPrefix(code, "E02") && !containsStr(lintCodes(), code)) {
    panic("lintself: `bit lint` emitted ${code}, which spec/LINT.md's rule list in lintCodes() does not name -- add it here and seed its debt")
  }
}

fn findingFromJson(d: Json, repo: string): Finding! {
  let rawFile = jsonField(d, "file")
  let range = jsonGet(d, "range")
  if (isNone(range)) {
    fail newError("lintself: finding in ${rawFile} has no range")
  }
  let start = jsonGet(unwrap(range), "start")
  if (isNone(start)) {
    fail newError("lintself: finding in ${rawFile} has no range.start")
  }
  let line = jsonInt(unwrap(start), "line")
  if (line < 0) {
    fail newError("lintself: finding in ${rawFile} has an invalid range.start.line")
  }
  return Finding{
    file: stripRepoPrefix(rawFile, repo)?,
    code: jsonField(d, "code"),
    line: line + 1,
  }
}

// `bit lint --json` and `bit lint`'s own summary line disagree BY DESIGN: the
// JSON array also carries diagnostics that are not lint findings at all (an
// E0098 in a raw string, say), which the summary does not count. Filtering to
// spec/LINT.md's thirteen codes is what makes `assertCountsAgree` a real
// cross-check instead of a coincidence.
fn extractFindings(out: string, repo: string): []Finding! {
  let arr = unwrapOr(jsonAsArray(jsonParse(trimSpace(out))?), []Json(0))
  let result = []Finding(0)
  for d of arr {
    let code = jsonField(d, "code")
    assertKnownCode(code)
    if (!containsStr(lintCodes(), code)) {
      continue
    }
    result = append(result, findingFromJson(d, repo)?)
  }
  return result
}

fn countCode(findings: []Finding, code: string): int {
  let n = 0
  for f of findings {
    if (f.code == code) {
      n = n + 1
    }
  }
  return n
}

fn countDebtCode(debt: []Debt, code: string): int {
  let n = 0
  for d of debt {
    if (d.code == code) {
      n = n + 1
    }
  }
  return n
}

// "91 E0201, 86 E0202" -- only the codes actually present, so a clean tree
// says so instead of printing thirteen zeros.
fn codeSummary(findings: []Finding): string {
  let parts = ""
  for c of lintCodes() {
    let n = countCode(findings, c)
    if (n > 0) {
      if (len(parts) > 0) {
        parts = parts + ", "
      }
      parts = parts + "${n} ${c}"
    }
  }
  if (len(parts) == 0) {
    return "none"
  }
  return parts
}

fn findingsUnder(findings: []Finding, tree: string): []Finding {
  let out = []Finding(0)
  for f of findings {
    if (hasPrefix(f.file, "${tree}/")) {
      out = append(out, f)
    }
  }
  return out
}

fn debtUnder(debt: []Debt, tree: string): int {
  let n = 0
  for d of debt {
    if (hasPrefix(d.file, "${tree}/")) {
      n = n + 1
    }
  }
  return n
}

// ---- per-tree verdict ----------------------------------------------------

class TreeResult { dir: string, filesTotal: int, findings: []Finding }

fn unlistedIn(findings: []Finding, debt: []Debt): []Finding {
  let out = []Finding(0)
  for f of findings {
    if (!debtHas(debt, f.code, f.file)) {
      out = append(out, f)
    }
  }
  return out
}

// The verdict for one tree. Returns true when this tree FAILS the gate.
fn reportTree(tr: TreeResult, debt: []Debt): bool {
  let unlisted = unlistedIn(tr.findings, debt)
  let denom = "${tr.filesTotal} .bit file(s) walked"
  let counts = "${len(tr.findings)} finding(s) (${codeSummary(tr.findings)})"
  let listed = "${debtUnder(debt, tr.dir)} entry(ies) in ${debtPath}"
  if (len(unlisted) > 0) {
    eprint("lint-self: FAIL -- ${tr.dir}/: ${denom}, ${counts}, ${listed}; ${len(unlisted)} finding(s) with no (code, file) line:\n")
    for f of unlisted {
      eprint("    ${f.file}:${f.line} [${f.code}]\n")
    }
    return true
  }
  println("lint-self: ${tr.dir}/: ${denom}, ${counts}, ${listed} -- PASS.")
  return false
}

// Every listed pair must be violating somewhere in this run, or the list has
// gone stale (the finding was fixed and nobody deleted its line). This is the
// self-cleaning half of the contract: without it a debt list becomes the
// permanent exemption the owner's ruling forbids.
fn checkDebtFreshness(debt: []Debt, findings: []Finding): bool {
  let stale = false
  for d of debt {
    if (!hasFinding(findings, d)) {
      eprint("lint-self: FAIL -- '${d.code} ${d.file}' is in ${debtPath} but has no live finding; delete the line.\n")
      stale = true
    }
  }
  return stale
}

fn hasFinding(findings: []Finding, d: Debt): bool {
  for f of findings {
    if (f.code == d.code && f.file == d.file) {
      return true
    }
  }
  return false
}

// Every file `bit lint` reported must be one the walk above found. A subtree
// the walk missed is invisible in the denominator until something in it goes
// wrong -- this is what makes it visible then.
fn assertWalkCoversFindings(findings: []Finding, walked: []string, repo: string) {
  for f of findings {
    if (!containsStr(walked, "${repo}/${f.file}")) {
      panic("lintself: `bit lint` reported ${f.file}, which this gate's own walk never found -- the denominator is wrong")
    }
  }
}

fn newCapDir(): string {
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  return "${tmp}/bit-lintself-${uuidFormat(uuidV4())}"
}

fn teardown(dir: string, ms: int) {
  shell("${dir}/rm.sh", "#!/bin/sh\nrm -rf '${dir}'\n", ms) catch _ {
    return
  }
}

class Scan { dirs: []string, walked: []string, counts: []int }

// Absolute directory paths to hand `bit lint`, every `.bit` file beneath
// them, and the per-tree file counts, in `trees` order.
fn scanTrees(repo: string, trees: []string): Scan {
  let dirs = []string(0)
  let walked = []string(0)
  let counts = []int(0)
  for t of trees {
    let full = "${repo}/${t}"
    if (!exists(full)) {
      panic("lintself: no such directory: ${full}")
    }
    let files = collectBitFiles(full, maxScanDepth)
    if (len(files) == 0) {
      panic("lintself: ${full} contains zero .bit files -- refusing a vacuous scan")
    }
    for f of files {
      walked = append(walked, f)
    }
    dirs = append(dirs, full)
    counts = append(counts, len(files))
  }
  return Scan{ dirs: dirs, walked: walked, counts: counts }
}

fn assertCountsAgree(summary: Summary, findings: []Finding) {
  if (summary.findings != len(findings)) {
    panic("lintself: `bit lint` summarised ${summary.findings} finding(s) but --json carried ${len(findings)} lint-code diagnostic(s) -- refusing to trust either")
  }
}

// THE OVERRIDE COUNT IS PRINTED for the same reason the denominator is: these
// four trees carry `bit:lint allow` directives today, and a rising number is
// how this gate would be defeated without ever going red.
fn lintAll(cfg: Config, scan: Scan, capDir: string, ms: int): []Finding {
  let label = "compiler/ + runtime/ + stdlib/ + tools/"
  let r = runLintJson(cfg.bit, scan.dirs, capDir, ms) catch e {
    panic("lintself: ${e.message()}")
  }
  assertTrustworthy(r, label)
  let findings = extractFindings(r.out, cfg.repo) catch e {
    panic("lintself: ${e.message()}")
  }
  let summary = parseSummary(r.err) catch e {
    panic("lintself: ${e.message()}")
  }
  assertCountsAgree(summary, findings)
  println("lint-self: ${len(scan.walked)} .bit file(s) walked, ${summary.findings} finding(s), ${summary.overrides} `bit:lint` override(s) active")
  return findings
}

// The paydown queue, largest rule first: this is the number that has to reach
// zero, printed on every run so it is watched rather than discovered.
fn printDebtCensus(debt: []Debt) {
  let parts = ""
  for c of sortedCodes(debt) {
    let n = countDebtCode(debt, c)
    if (len(parts) > 0) {
      parts = parts + ", "
    }
    parts = parts + "${n} ${c}"
  }
  if (len(parts) == 0) {
    println("lint-self: ${debtPath} is empty -- delete the file.")
    return
  }
  println("lint-self: ${len(debt)} debt entry(ies) left to pay down: ${parts}")
}

fn sortedCodes(debt: []Debt): []string {
  let out = []string(0)
  for c of lintCodes() {
    if (countDebtCode(debt, c) > 0) {
      out = append(out, c)
    }
  }
  let i = 1
  while (i < len(out)) {
    let cur = out[i]
    let j = i - 1
    while (j >= 0 && lessByCount(debt, cur, out[j])) {
      out[j + 1] = out[j]
      j = j - 1
    }
    out[j + 1] = cur
    i = i + 1
  }
  return out
}

// Higher count first, ties broken by code, so the printed census is
// deterministic and the biggest queue leads.
fn lessByCount(debt: []Debt, cur: string, other: string): bool {
  let a = countDebtCode(debt, cur)
  let b = countDebtCode(debt, other)
  if (a != b) {
    return a > b
  }
  return compare(cur, other) < 0
}

fn reportTrees(trees: []string, scan: Scan, findings: []Finding, debt: []Debt): bool {
  let anyFail = false
  let i = 0
  while (i < len(trees)) {
    let tf = findingsUnder(findings, trees[i])
    if (reportTree(TreeResult{ dir: trees[i], filesTotal: scan.counts[i], findings: tf }, debt)) {
      anyFail = true
    }
    i = i + 1
  }
  return anyFail
}

fn main() {
  let ms = timeoutMs()
  let cfg = loadConfig() catch e {
    panic("lintself: ${e.message()}")
  }
  let trees = ["compiler", "runtime", "stdlib", "tools"]
  let scan = scanTrees(cfg.repo, trees)

  let capDir = newCapDir()
  mkdir(capDir) catch e {
    panic("lintself: cannot create ${capDir}: ${e.message()}")
  }
  let findings = lintAll(cfg, scan, capDir, ms)
  assertWalkCoversFindings(findings, scan.walked, cfg.repo)

  let anyFail = reportTrees(trees, scan, findings, cfg.debt)
  if (checkDebtFreshness(cfg.debt, findings)) {
    anyFail = true
  }
  printDebtCensus(cfg.debt)

  teardown(capDir, ms)
  if (anyFail) {
    eprint("lint-self: fix the finding and delete its line, or -- with a ticket -- add the '<CODE> <path>' line to ${debtPath}. The list only ever shrinks, and at zero the file is deleted.\n")
    exit(1)
  }
  println("lint-self: PASS -- every spec/LINT.md rule code, zero outside the named debt list, over compiler/ + runtime/ + stdlib/ + tools/")
}
