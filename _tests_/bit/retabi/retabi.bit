// _tests_/bit/retabi — one question, asked of the compiler under test: does it
// hand a multi-word result back in REGISTERS, or in a heap box?
//
// `targetReturnsInRegisters` (compiler/build.bit) is the only authority on
// that, and it is a per-TARGET build-time answer: true for the two aarch64
// targets, false for both x86_64 ones, so `explodedRetWords`
// (compiler/lowerexplode.bit) leaves the `gc_alloc` in place on x86_64 and the
// callee returns one handle. A harness that pins one of those two shapes
// unconditionally is red on the other host for a compiler that is behaving
// exactly as specified — #4730, which is why this module exists.
//
// It is a PROBE, not a copy of the predicate, and not `uname -m`. Both of
// those re-derive the answer beside the compiler and go stale the day the
// predicate moves (a new target, or x86_64 gaining the register convention);
// a probe compiles two functions with the binary the gate was handed and reads
// which shape came out, so the harness follows the compiler by construction.
// It is also the only correct source when `BIT_BIN` is not a host-native
// build.
import { readFile, writeFile } from "std/fs"
import { indexOf } from "std/strings"
import { runScript } from "../trampoline"

// A callee whose result is two words of DIFFERENT classes and whose body has a
// loop, so no inliner can dissolve the boundary the question is about. `f64`
// beside `int` on purpose: a mixed pair is the case the register convention
// splits across x0/d0, and it is the one a wrong word index shows up in as a
// TYPE rather than as a number.
fn probeSource(): string {
  return "fn split(n: int): (int, f64) {\n" +
    "  let a = 0\n" +
    "  while (a < n) {\n" +
    "    a = a + 1\n" +
    "  }\n" +
    "  return a, 0.5\n" +
    "}\n" +
    "fn use(n: int): f64 {\n" +
    "  let (q, f) = split(n)\n" +
    "  return f64(q) + f\n" +
    "}\n"
}

// True when the compiler at `bin` returns a multi-word result in registers.
// `dir` is a scratch directory the caller already owns; `ms` its usual job
// deadline.
//
// The OPTIMIZED dump (`--dump-ir`) is what gets read, not the raw one: the
// raw lowering builds the box in BOTH conventions and the register convention
// then reads it back word by word, so only the post-optimizer form separates
// them — the box survives to the `ret` when results are boxed and is gone
// entirely when they are not.
export fn returnsInRegisters(bin: string, dir: string, ms: int): bool! {
  let src = "${dir}/retabi-probe.bit"
  writeFile(src, probeSource())?
  let dump = "${dir}/retabi-probe.ir"
  let script = "#!/bin/sh\n" +
    shQuote(bin) +
    " --dump-ir " +
    shQuote(src) +
    " > " +
    shQuote(dump) +
    " 2>&1\n"
  let code = runScript("${dir}/retabi-probe.sh", script, ms)?
  if (code != 0) {
    fail newError("retabi: ${bin} --dump-ir exited ${code}: ${readFile(dump) catch _ { "" }}")
  }
  return classify(readFile(dump)?)?
}

// The two shapes are asserted to be mutually exclusive rather than one being
// tested and the other assumed. A dump that is neither (a compiler that failed
// to lower the probe, an IR text that has been re-rendered) must be a hard
// error here: answering `false` for it would silently move every caller onto
// the boxed expectation and read as a pass.
fn classify(ir: string): bool! {
  let boxed = indexOf(ir, "gc_alloc") >= 0
  let exploded = hasMultiValueRet(ir)
  if (boxed == exploded) {
    fail newError(
      "retabi: probe dump is neither a boxed nor an exploded return (boxed=${boxed}, exploded=${exploded}):\n${ir}",
    )
  }
  return exploded
}

// True when some `ret` in `ir` hands back more than one value — the rendered
// form of the register convention (`ret %11, %12`), whichever value numbers
// the optimizer happens to leave.
fn hasMultiValueRet(ir: string): bool {
  let rest = ir
  while (true) {
    let at = indexOf(rest, "\n  ret %")
    if (at < 0) {
      return false
    }
    rest = rest[at + 1:len(rest)]
    let eol = indexOf(rest, "\n")
    if (eol < 0) {
      return false
    }
    if (indexOf(rest[0:eol], ", %") >= 0) {
      return true
    }
  }
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}
