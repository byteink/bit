// _tests_/bit/retabi — which multi-word return convention a gate running on
// THIS host must expect, stated independently of the compiler under test.
//
// `targetReturnsInRegisters` (compiler/build.bit) is the compiler's own
// answer: true for the two aarch64 targets and, since #5868/#5869/#5870, for
// x86_64-linux; false for x86_64-windows alone. `explodedRetWords`
// (compiler/lowerexplode.bit) returns a mixed pair in {x0, d0} / {rax, xmm0}
// on the former and leaves the `gc_alloc` box in place on the latter. A
// harness that pins one of those two shapes unconditionally is red on the
// other host against a compiler doing exactly what it is specified to do —
// #4730.
//
// WHY THIS IS `uname -m`/`uname -s` AND NOT A PROBE OF `BIT_BIN`. The binary
// can be asked directly (`--dump-ir` shows which shape came out) and that was
// the first version of this file. It is wrong: an oracle that asks the thing
// it is testing follows a broken compiler into its own bug. Flip the lowering
// and the probe answers "boxed", every harness quietly moves onto the boxed
// expectation, and all three gates stay green through a total loss of the
// register convention. The mapping below is therefore DUPLICATED from
// build.bit on purpose. It fails in the safe direction: a target that gains
// the convention without editing this file turns the gate RED, never
// silently green.
//
// x86_64-windows is untestable by `uname` alone: this harness runs only on
// real hardware or in a Linux container (x64gate.sh), never on an actual
// Windows host, so `uname -s` reading anything other than "Linux" for an
// x86_64 arch is treated as unknown rather than guessed as Windows.
import { readFile } from "std/fs"
import { trimSpace } from "std/strings"
import { runScript } from "../trampoline"

// True when a multi-word result comes back in registers on the host this
// harness is running on. `dir` is a scratch directory the caller owns, `ms`
// its usual job deadline.
export fn returnsInRegisters(dir: string, ms: int): bool! {
  let arch = hostArch(dir, ms)?
  if (arch == "arm64" || arch == "aarch64") {
    return true
  }
  if (arch == "x86_64" || arch == "amd64") {
    let os = hostOs(dir, ms)?
    if (os == "Linux") {
      return true
    }
    fail newError("retabi: x86_64 host reports uname -s = '${os}', which targetReturnsInRegisters (compiler/build.bit) has no entry for (Linux is register-return, Windows is not); add it there and here in the same commit")
  }
  fail newError("retabi: `uname -m` says '${arch}', which targetReturnsInRegisters (compiler/build.bit) has no entry for; add it there and here in the same commit")
}

// `uname -m`, trimmed. A failure here is fatal to the caller rather than a
// default, for the same reason the mapping is exhaustive: guessing a
// convention picks which shape the whole gate asserts.
fn hostArch(dir: string, ms: int): string! {
  let out = "${dir}/retabi-arch.txt"
  let code = runScript("${dir}/retabi-arch.sh", "#!/bin/sh\nuname -m > '" + out + "'\n", ms)?
  if (code != 0) {
    fail newError("retabi: `uname -m` exited ${code}")
  }
  return trimSpace(readFile(out)?)
}

// `uname -s`, trimmed — the OS half of an x86_64 host's identity, since
// x86_64-linux and x86_64-windows now disagree on the convention.
fn hostOs(dir: string, ms: int): string! {
  let out = "${dir}/retabi-os.txt"
  let code = runScript("${dir}/retabi-os.sh", "#!/bin/sh\nuname -s > '" + out + "'\n", ms)?
  if (code != 0) {
    fail newError("retabi: `uname -s` exited ${code}")
  }
  return trimSpace(readFile(out)?)
}
