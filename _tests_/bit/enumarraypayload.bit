// #8045 and #8046: enum array handles and value copies, outside the pinned oracle.
import { env, envOr } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"
import { removeAll } from "std/fs/secure"

fn copyTypesSrc(): string {
  return "enum BoxByte { Value([2]byte), Other(string) }\n" +
    "enum DirectByte { Value([2]byte), Other([2]byte) }\n" +
    "enum ZeroBoxByte { Value([0]byte), Other(string) }\n" +
    "enum ZeroDirectByte { Value([0]byte), Other([0]byte) }\n" +
    "enum BoxInt { Value([2]int), Other(string) }\n" +
    "enum DirectInt { Value([2]int), Other([2]int) }\n" +
    "enum ZeroBoxInt { Value([0]int), Other(string) }\n" +
    "enum ZeroDirectInt { Value([0]int), Other([0]int) }\n" +
    "enum BoxDec { Value([2]decimal), Other(string) }\n" +
    "enum DirectDec { Value([2]decimal), Other([2]decimal) }\n" +
    "enum ZeroBoxDec { Value([0]decimal), Other(string) }\n" +
    "enum ZeroDirectDec { Value([0]decimal), Other([0]decimal) }\n"
}

fn copyChecksSrc(): string {
  return "fn checkByteCopies() {\n" +
    "  let key = [2]byte{7, 8}\n" +
    "  let boxed = BoxByte.Value(key)\n" +
    "  let direct = DirectByte.Value(key)\n" +
    "  key[0] = 99\n" +
    "  match(boxed) { Value(saved) => assert(saved[0] == 7 && saved[1] == 8); Other(_) => panic(\"wrong boxed tag\") }\n" +
    "  match(direct) { Value(saved) => assert(saved[0] == 7 && saved[1] == 8); Other(_) => panic(\"wrong direct tag\") }\n" +
    "}\n" +
    "fn checkByteZeros() {\n" +
    "  let key = [0]byte{}\n" +
    "  let boxed = ZeroBoxByte.Value(key)\n" +
    "  let direct = ZeroDirectByte.Value(key)\n" +
    "  match(boxed) { Value(saved) => assert(len(saved) == 0); Other(_) => panic(\"wrong zero boxed tag\") }\n" +
    "  match(direct) { Value(saved) => assert(len(saved) == 0); Other(_) => panic(\"wrong zero direct tag\") }\n" +
    "}\n" +
    "fn checkIntCopies() {\n" +
    "  let key = [2]int{-70000, 80000}\n" +
    "  let boxed = BoxInt.Value(key)\n" +
    "  let direct = DirectInt.Value(key)\n" +
    "  key[0] = 99\n" +
    "  match(boxed) { Value(saved) => assert(saved[0] == -70000 && saved[1] == 80000); Other(_) => panic(\"wrong boxed tag\") }\n" +
    "  match(direct) { Value(saved) => assert(saved[0] == -70000 && saved[1] == 80000); Other(_) => panic(\"wrong direct tag\") }\n" +
    "}\n" +
    "fn checkIntZeros() {\n" +
    "  let key = [0]int{}\n" +
    "  let boxed = ZeroBoxInt.Value(key)\n" +
    "  let direct = ZeroDirectInt.Value(key)\n" +
    "  match(boxed) { Value(saved) => assert(len(saved) == 0); Other(_) => panic(\"wrong zero boxed tag\") }\n" +
    "  match(direct) { Value(saved) => assert(len(saved) == 0); Other(_) => panic(\"wrong zero direct tag\") }\n" +
    "}\n" +
    "fn checkDecCopies() {\n" +
    "  let key = [2]decimal{123456789012345.125, -42.375}\n" +
    "  let boxed = BoxDec.Value(key)\n" +
    "  let direct = DirectDec.Value(key)\n" +
    "  key[0] = 99.5\n" +
    "  match(boxed) { Value(saved) => assert(saved[0] == 123456789012345.125 && saved[1] == -42.375); Other(_) => panic(\"wrong boxed tag\") }\n" +
    "  match(direct) { Value(saved) => assert(saved[0] == 123456789012345.125 && saved[1] == -42.375); Other(_) => panic(\"wrong direct tag\") }\n" +
    "}\n" +
    "fn checkDecZeros() {\n" +
    "  let key = [0]decimal{}\n" +
    "  let boxed = ZeroBoxDec.Value(key)\n" +
    "  let direct = ZeroDirectDec.Value(key)\n" +
    "  match(boxed) { Value(saved) => assert(len(saved) == 0); Other(_) => panic(\"wrong zero boxed tag\") }\n" +
    "  match(direct) { Value(saved) => assert(len(saved) == 0); Other(_) => panic(\"wrong zero direct tag\") }\n" +
    "}\n"
}

fn copyLocationsSrc(): string {
  return "enum Generic<T> { Value(T), Other(string) }\n" +
    "class Located { key: [1]byte }\n" +
    "class Counter { n: int }\n" +
    "class Ref { n: int }\n" +
    "enum Shared { Value([]int), Other(string) }\n" +
    "enum SharedClass { Value(Ref), Other(string) }\n" +
    "fn counted(c: Counter): [1]byte { c.n = c.n + 1; return [1]byte{11} }\n" +
    "fn indexed(c: Counter): int { c.n = c.n + 1; return 0 }\n" +
    "fn byValue(key: [1]byte): [1]byte { key[0] = 88; return key }\n" +
    "fn returnMember(holder: Located): [1]byte { return holder.key }\n" +
    "fn checkLocations() {\n" +
    "  let holder = Located{key = [1]byte{7}}\n" +
    "  let boxed = One.Keyed(holder.key)\n" +
    "  holder.key[0] = 99\n" +
    "  assert(firstByte(boxed) == 7)\n" +
    "  let keys = [ [1]byte{8} ]\n" +
    "  let counter = Counter{n = 0}\n" +
    "  let direct = Direct.Keyed(keys[indexed(counter)])\n" +
    "  keys[0][0] = 99\n" +
    "  assert(directByte(direct) == 8 && counter.n == 1)\n" +
    "  let key = [1]byte{9}\n" +
    "  let generic = Generic<[1]byte>.Value(key)\n" +
    "  key[0] = 99\n" +
    "  match(generic) { Value(saved) => assert(saved[0] == 9); Other(_) => panic(\"wrong generic tag\") }\n" +
    "}\n" +
    "fn checkFresh(): ()! {\n" +
    "  let source: []byte = [10]\n" +
    "  let boxed = One.Keyed([1]byte(source)?)\n" +
    "  source[0] = 99\n" +
    "  assert(firstByte(boxed) == 10)\n" +
    "  let counter = Counter{n = 0}\n" +
    "  assert(firstByte(One.Keyed(counted(counter))) == 11 && counter.n == 1)\n" +
    "  assert(directByte(Direct.Keyed(counted(counter))) == 11 && counter.n == 2)\n" +
    "  assert(firstByte(One.Keyed([1]byte{12})) == 12)\n" +
    "}\n" +
    "fn checkOrdinaryCopies() {\n" +
    "  let key = [1]byte{7}\n" +
    "  let assigned = key\n" +
    "  assigned[0] = 99\n" +
    "  assert(key[0] == 7)\n" +
    "  let returned = byValue(key)\n" +
    "  assert(returned[0] == 88 && key[0] == 7)\n" +
    "  returned[0] = 55\n" +
    "  assert(key[0] == 7)\n" +
    "  let holder = Located{key = [1]byte{13}}\n" +
    "  let member = returnMember(holder)\n" +
    "  member[0] = 99\n" +
    "  assert(holder.key[0] == 13)\n" +
    "}\n" +
    "fn checkReferenceSharing() {\n" +
    "  let source: []int = [7]\n" +
    "  let shared = Shared.Value(source)\n" +
    "  source[0] = 99\n" +
    "  match(shared) { Value(saved) => assert(saved[0] == 99); Other(_) => panic(\"wrong slice tag\") }\n" +
    "  let ref = Ref{n = 7}\n" +
    "  let object = SharedClass.Value(ref)\n" +
    "  ref.n = 99\n" +
    "  match(object) { Value(saved) => assert(saved.n == 99); Other(_) => panic(\"wrong class tag\") }\n" +
    "}\n"
}

fn fixtureSrc(): string {
  return copyTypesSrc() +
    copyChecksSrc() +
    copyLocationsSrc() +
    "enum One { Keyed([1]byte), Other(string) }\n" +
    "enum Mode { Keyed([32]byte), Other(string) }\n" +
    "enum Direct { Keyed([1]byte), Other([1]byte) }\n" +
    "class Inline { key: [32]byte }\n" +
    "class Retained {\n" +
    "  mode: Mode\n  saved: [32]byte\n" +
    "  init(mode: Mode) {\n" +
    "    this.mode = mode\n" +
    "    match(mode) {\n" +
    "      Keyed(key) => { let i = 0; while(i < 32) { this.saved[i] = key[i]; i = i + 1 } }\n" +
    "      Other(_) => panic(\"unexpected mode\")\n    }\n" +
    "  }\n" +
    "  check() { checkKey(this.saved) }\n" +
    "}\n" +
    "fn firstByte(mode: One): byte {\n" +
    "  match(mode) { Keyed(key) => return key[0]; Other(_) => return 0 }\n" +
    "}\n" +
    "fn directByte(mode: Direct): byte {\n" +
    "  match(mode) { Keyed(key) => return key[0]; Other(key) => return key[0] }\n" +
    "}\n" +
    "fn checkKey(key: [32]byte) {\n" +
    "  let i = 0\n" +
    "  while(i < 32) { assert(key[i] == byte(i + 1)); i = i + 1 }\n" +
    "}\n" +
    "fn checkMode(mode: Mode) {\n" +
    "  match(mode) { Keyed(key) => checkKey(key); Other(_) => panic(\"unexpected mode\") }\n" +
    "}\n" +
    "fn main(): ()! {\n" +
    "  checkByteCopies(); checkIntCopies(); checkDecCopies()\n" +
    "  checkByteZeros(); checkIntZeros(); checkDecZeros()\n" +
    "  checkLocations(); checkFresh()?; checkOrdinaryCopies(); checkReferenceSharing()\n" +
    "  assert(firstByte(One.Keyed([1]byte{7})) == 7)\n" +
    "  let key: [32]byte\n  let i = 0\n" +
    "  while(i < 32) { key[i] = byte(i + 1); i = i + 1 }\n" +
    "  checkMode(Mode.Keyed(key))\n" +
    "  let retained = Retained(Mode.Keyed(key))\n  checkMode(retained.mode)\n" +
    "  key[0] = 99\n  retained.check()\n  retained.check()\n" +
    "  let pair = (retained.saved, 42)\n  checkKey(pair.0)\n" +
    "  let inline = Inline{key = retained.saved}\n  checkKey(inline.key)\n" +
    "  assert(directByte(Direct.Keyed([1]byte{9})) == 9)\n" +
    "  println(\"enum array payload native pass\")\n}\n"
}

fn required(name: string): string {
  let value = env(name)
  assert(value != "", name + " must be set")
  return value
}

fn quote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) {
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

fn runMode(dir: string, options: string): ()! {
  let script = dir + "/run.sh"
  let output = dir + "/output"
  let program = dir + "/program"
  writeFile(
    script,
      "#!/bin/sh\nset -eu\nexport BIT_STDLIB=" +
      quote(required("BIT_STDLIB")) +
      "\nexport BIT_LIBBITRT=" +
      quote(required("BIT_LIBBITRT")) +
      "\n" +
      quote(required("BIT_BIN")) +
      " build " +
      quote(dir + "/fixture.bit") +
      " " +
      options +
      " -o " +
      quote(program) +
      "\nexec " +
      quote(program) +
      " > " +
      quote(output) +
      " 2>&1\n",
  )?
  assert(fsChmod(script, 448) == 0)
  let code = osRunBounded(script, 60000)
  let out = readFile(output) catch _ {
    ""
  }
  assert(code == 0, "native exit ${code}: ${out}")
  assert(out == "enum array payload native pass\n", out)
}

fn main(): ()! {
  let dir = envOr("TMPDIR", "/tmp") + "/t8045-enum-array-${timeUnixNs()}"
  mkdir(dir)?
  writeFile(dir + "/fixture.bit", fixtureSrc())?
  runMode(dir, "")?
  runMode(dir, "--no-optimize")?
  removeAll(dir)?
  println("PASS enum array payload: boxed handles, inline classes, tuples, direct enums and value copies")
}
