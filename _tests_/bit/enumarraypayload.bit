// #8045: boxed enum array handles, outside the pinned-oracle corpus.
import { env, envOr } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"
import { removeAll } from "std/fs/secure"

fn fixtureSrc(): string {
  return "enum One { Keyed([1]byte), Other(string) }\n" +
    "enum Mode { Keyed([32]byte), Other(string) }\n" +
    "enum Direct { Keyed([1]byte), Other([1]byte) }\n" +
    "class Inline { key: [32]byte }\n" +
    "class Retained {\n" +
    "  mode: Mode\n  saved: [32]byte\n" +
    "  init(mode: Mode) {\n" +
    "    this.mode = mode\n" +
    "    match(mode) {\n" +
    "      Keyed(key) => { let i = 0; while(i < 32) { this.saved[i] = key[i]; i = i + 1 } }\n" +
    "      Other(_) => panic(\"unexpected mode\")\n    }\n" +
    "  }\n" +
    "  check() { checkKey(this.saved) }\n" +
    "}\n" +
    "fn firstByte(mode: One): byte {\n" +
    "  match(mode) { Keyed(key) => return key[0]; Other(_) => return 0 }\n" +
    "}\n" +
    "fn directByte(mode: Direct): byte {\n" +
    "  match(mode) { Keyed(key) => return key[0]; Other(key) => return key[0] }\n" +
    "}\n" +
    "fn checkKey(key: [32]byte) {\n" +
    "  let i = 0\n" +
    "  while(i < 32) { assert(key[i] == byte(i + 1)); i = i + 1 }\n" +
    "}\n" +
    "fn checkMode(mode: Mode) {\n" +
    "  match(mode) { Keyed(key) => checkKey(key); Other(_) => panic(\"unexpected mode\") }\n" +
    "}\n" +
    "fn main() {\n" +
    "  assert(firstByte(One.Keyed([1]byte{7})) == 7)\n" +
    "  let key: [32]byte\n  let i = 0\n" +
    "  while(i < 32) { key[i] = byte(i + 1); i = i + 1 }\n" +
    "  checkMode(Mode.Keyed(key))\n" +
    "  let retained = Retained(Mode.Keyed(key))\n  checkMode(retained.mode)\n" +
    "  key[0] = 99\n  retained.check()\n  retained.check()\n" +
    "  let pair = (retained.saved, 42)\n  checkKey(pair.0)\n" +
    "  let inline = Inline{key = retained.saved}\n  checkKey(inline.key)\n" +
    "  assert(directByte(Direct.Keyed([1]byte{9})) == 9)\n" +
    "  println(\"enum array payload native pass\")\n}\n"
}

fn required(name: string): string {
  let value = env(name)
  assert(value != "", name + " must be set")
  return value
}

fn quote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) {
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

fn runMode(dir: string, options: string): ()! {
  let script = dir + "/run.sh"
  let output = dir + "/output"
  let program = dir + "/program"
  writeFile(
    script,
      "#!/bin/sh\nset -eu\nexport BIT_STDLIB=" +
      quote(required("BIT_STDLIB")) +
      "\nexport BIT_LIBBITRT=" +
      quote(required("BIT_LIBBITRT")) +
      "\n" +
      quote(required("BIT_BIN")) +
      " build " +
      quote(dir + "/fixture.bit") +
      " " +
      options +
      " -o " +
      quote(program) +
      "\nexec " +
      quote(program) +
      " > " +
      quote(output) +
      " 2>&1\n",
  )?
  assert(fsChmod(script, 448) == 0)
  let code = osRunBounded(script, 60000)
  let out = readFile(output) catch _ {
    ""
  }
  assert(code == 0, "native exit ${code}: ${out}")
  assert(out == "enum array payload native pass\n", out)
}

fn main(): ()! {
  let dir = envOr("TMPDIR", "/tmp") + "/t8045-enum-array-${timeUnixNs()}"
  mkdir(dir)?
  writeFile(dir + "/fixture.bit", fixtureSrc())?
  runMode(dir, "")?
  runMode(dir, "--no-optimize")?
  removeAll(dir)?
  println("PASS enum array payload: boxed handles, inline classes, tuples and direct enums")
}
