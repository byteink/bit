// #8736: stage real modules as rootnamecollision does. Only the disposable
// QUIC overlay exports fixture controls; the production H3 source is unchanged.
import { env, envOr, exit } from "std/os"
import { mkdir, readFile, writeFile } from "std/fs"
import { uuidV4, format as uuidFormat } from "std/uuid"
import { contains } from "std/strings"
import { runScript } from "./trampoline"

fn quote(s: string): string {
  if (contains(s, "'") || contains(s, "\n")) {
    panic("h3writequeue: unsupported quoted path")
  }
  return "'${s}'"
}

fn checkedScript(scratch: string, name: string, script: string): ()! {
  let rc = runScript("${scratch}/${name}.sh", script, 120000)?
  if (rc != 0) {
    fail newError("h3writequeue: ${name} exited ${rc}")
  }
}

fn fixture(root: string, scratch: string): ()! {
  let copied = "${scratch}/stdlib"
  checkedScript(
    scratch,
    "copy",
    "#!/bin/sh\ncp -R " + quote("${root}/stdlib") + " " + quote(copied) + "\n",
  )?
  let original = readFile("${root}/stdlib/http3/connect.bit")?
  assert(original == readFile("${copied}/http3/connect.bit")?, "production H3 bytes copied exactly")
  let dir = "${root}/_tests_/bit/h3writequeue"
  writeFile("${copied}/quic/h3queuefixture.bit", readFile("${dir}/quicfixture.bit.txt")?)?
  writeFile("${copied}/http3/h3queuefixture.test.bit", readFile("${dir}/http3fixture.bit.txt")?)?
  let bin = env("BIT_BIN")
  assert(bin != "", "BIT_BIN must name the compiler under test")
  checkedScript(
    scratch, "test",
      "#!/bin/sh\nBIT_STDLIB=" +
      quote(copied) +
      " " +
      quote(bin) +
      " test " +
      quote("${copied}/http3") +
      " --run 'actual H3 write' --timeout 3 > " +
      quote("${scratch}/cases.log") +
      " 2>&1\nrc=$?\nprintf '%s\\n' \"$rc\" > " +
      quote("${scratch}/cases.rc") +
      "\nexit 0\n",
  )?
  let report = readFile("${scratch}/cases.log")?
  print(report)
  assert(readFile("${scratch}/cases.rc")? == "0\n", "composed fixture compiler/tests failed")
  assert(contains(report, "ran 2: 2 passed, 0 failed"), "both composed cases must run")
  assert(
    original == readFile("${copied}/http3/connect.bit")?,
    "fixture never changes production H3 bytes",
  )
  assert(
    original == readFile("${root}/stdlib/http3/connect.bit")?,
    "production H3 input stayed fixed",
  )
  checkedScript(scratch, "cleanup", "#!/bin/sh\nrm -rf -- " + quote(scratch) + "\n")?
}

fn main() {
  let root = env("BIT_REPO")
  assert(root != "", "BIT_REPO must name the tested checkout")
  let scratch = "${envOr("TMPDIR", "/tmp")}/t8736-h3writequeue-${uuidFormat(uuidV4())}"
  mkdir(scratch) catch e {
    panic(e.message())
  }
  fixture(root, scratch) catch e {
    eprint("h3writequeue: ${e.message()}\n")
    exit(1)
  }
  println("h3writequeue: actual H3 write cancellation/deadline and live full64 cleanup passed")
}
