// Runtime GC/scheduler environment knobs: a set value outside its range is
// fatal at startup, never clamped, never ignored (#6060).
//
// THE DEFECT THIS PREVENTS FROM RETURNING. `BIT_GC_GROWTH_PCT=100` was accepted
// (`g >= 100`) and made the next collection trigger equal the live size, so every
// allocation collected: a 1.2 MB `pkg/yaml` parse ran 3.3T instructions against
// 2.2G at the default before it was killed. The sibling knobs had the same hole:
// `BIT_WORKERS=99` was silently clamped to 32, `BIT_GC_MARKSTACK=0` and an
// unparseable `BIT_GC_MIN_KB` silently kept the default.
//
// WHAT IT ASSERTS. One tiny allocating program is built once, then run once per
// case with ONLY that case's variable set (the variable is never exported to this
// harness or to `bit build`, so no compiler child inherits it). An INVALID case
// must exit 64 with stdout empty and stderr EXACTLY
//
//     bit: invalid NAME="value", valid: <range>
//
// A VALID case, the boundary values and the empty value, must exit 0 with stderr
// empty. All cases run from one generated script (one fresh exec, not one per
// case: `_tests_/bit/trampoline/trampoline.bit` records what a fresh exec costs),
// each writing `rc_N.txt` and `err_N.txt`.
//
// Run from the repository root: ./bit-out/bin/bit run _tests_/bit/gcenvrange.bit
// `BIT_SELF_EXE` overrides which `bit` builds the fixture.
import { env, envOr, exit } from "std/os"
import { exists, mkdir, readFile, writeFile } from "std/fs"
import { parseInt } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// 64 = EX_USAGE, `gcEnvExitCode` in runtime/root/rootconfig.bit.
const wantExit: int = 64

class Case { name: string, value: string, valid: bool }

class Tally { checks: int, failures: int }

fn check(t: Tally, cond: bool, label: string) {
  t.checks = t.checks + 1
  if (!cond) {
    t.failures = t.failures + 1
    eprint("FAIL: ${label}\n")
  }
}

// The range text the runtime prints for `name`, pinned here independently of
// the runtime's own table (ABI.md §7).
fn rangeOf(name: string): string {
  if (name == "BIT_GC_MIN_KB") {
    return "an integer from 0 to 1073741824"
  }
  if (name == "BIT_GC_GROWTH_PCT") {
    return "an integer from 101 to 1000000"
  }
  if (name == "BIT_GC_MARKSTACK") {
    return "an integer from 1 to 16777216"
  }
  if (name == "BIT_WORKERS") {
    return "an integer from 1 to 32"
  }
  if (name == "BIT_GC") {
    return "on, off, 1, 0 or stress"
  }
  if (name == "BIT_HASH_SEED") {
    return "an integer from 0 to 1099511627776"
  }
  return "1, on, 0 or off"
}

fn bad(name: string, value: string): Case {
  return Case{ name = name, value = value, valid = false }
}

fn good(name: string, value: string): Case {
  return Case{ name = name, value = value, valid = true }
}

fn invalidCases(): []Case {
  return [
    bad("BIT_GC_GROWTH_PCT", "100"), // the #6060 value
    bad("BIT_GC_GROWTH_PCT", "0"),
    bad("BIT_GC_GROWTH_PCT", "99"),
    bad("BIT_GC_GROWTH_PCT", "1000001"),
    bad("BIT_GC_GROWTH_PCT", "abc"),
    bad("BIT_GC_GROWTH_PCT", "-200"),
    bad("BIT_GC_GROWTH_PCT", "99999999999999999999999"), // would wrap an unchecked accumulator
    bad("BIT_GC_MIN_KB", "abc"),
    bad("BIT_GC_MIN_KB", "1073741825"),
    bad("BIT_GC_MARKSTACK", "0"),
    bad("BIT_GC_MARKSTACK", "16777217"),
    bad("BIT_WORKERS", "0"),
    bad("BIT_WORKERS", "33"),
    bad("BIT_WORKERS", "four"),
    bad("BIT_GC", "bogus"),
    bad("BIT_GC_STATS", "yes"),
    bad("BIT_GC_ALLOCCACHE", "2"),
    bad("BIT_VDSO", "maybe"),
    bad("BIT_HASH_SEED", "seed"),
    bad("BIT_HASH_SEED", "1099511627777"),
  ]
}

fn validCases(): []Case {
  return [
    good("BIT_GC_GROWTH_PCT", "101"),
    good("BIT_GC_GROWTH_PCT", "1000000"),
    good("BIT_GC_GROWTH_PCT", ""), // empty reads as unset
    good("BIT_GC_MIN_KB", "0"),
    good("BIT_GC_MIN_KB", "1073741824"),
    good("BIT_GC_MARKSTACK", "1"),
    good("BIT_WORKERS", "1"),
    good("BIT_WORKERS", "32"),
    good("BIT_GC", "off"),
    good("BIT_GC", "stress"),
    good("BIT_GC_STATS", "off"),
    good("BIT_GC_ALLOCCACHE", "on"),
    good("BIT_VDSO", "0"),
    good("BIT_HASH_SEED", "0"),
    good("BIT_HASH_SEED", "1099511627776"),
  ]
}

fn allCases(): []Case {
  let cases = invalidCases()
  let ok = validCases()
  for (let i = 0; i < len(ok); i = i + 1) {
    cases = append(cases, ok[i])
  }
  return cases
}

fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "120")) catch _ {
    120
  }
  if (s <= 0) {
    return 120000
  }
  return s * 1000
}

fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    fail newError("gcenvrange: cannot make script executable: ${scriptPath}")
  }
  return osRunBounded(scriptPath, ms)
}

fn bitBinary(scratch: string, ms: int): string! {
  let explicit = env("BIT_SELF_EXE")
  if (len(explicit) > 0) {
    if (!exists(explicit)) {
      fail newError("gcenvrange: BIT_SELF_EXE=${explicit} does not exist")
    }
    return explicit
  }
  let cwdFile = "${scratch}/cwd.txt"
  let code = shell("${scratch}/pwd.sh", "#!/bin/sh\npwd > '${cwdFile}'\n", ms)?
  if (code != 0) {
    fail newError("gcenvrange: could not read the working directory (exit ${code})")
  }
  let candidate = "${trimWs(readFile(cwdFile)?)}/bit-out/bin/bit"
  if (!exists(candidate)) {
    fail newError("gcenvrange: no compiler at ${candidate}; run this from the repository root or set BIT_SELF_EXE")
  }
  return candidate
}

// A bounded allocation loop with no imports, so it builds without BIT_STDLIB.
fn fixtureSource(): string {
  return "class Node { x: i64, y: i64 }\n\n" +
    "fn main() {\n" +
    "  let xs = []Node(0)\n" +
    "  let i = 0\n" +
    "  while (i < 2000) {\n" +
    "    xs = append(xs, Node{ x = i, y = i + 1 })\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "}\n"
}

// Compiles the fixture into `scratch`; returns its path, or "" when it did not build.
fn buildFixture(t: Tally, scratch: string, ms: int): string {
  let bit = bitBinary(scratch, ms) catch e {
    panic("gcenvrange: ${e.message()}")
  }
  let src = "${scratch}/alloc.bit"
  let prog = "${scratch}/alloc"
  writeFile(src, fixtureSource()) catch e {
    panic("gcenvrange: cannot write the fixture: ${e.message()}")
  }
  let build = shell(
    "${scratch}/build.sh",
    "#!/bin/sh\n'${bit}' build '${src}' -o '${prog}'\n", ms,
  ) catch e {
    panic("gcenvrange: ${e.message()}")
  }
  check(t, build == 0, "the fixture must compile (bit build exited ${build})")
  if (build != 0 || !exists(prog)) {
    return ""
  }
  return prog
}

// One subshell per case: the variable is set only inside it, `rc_N`/`err_N`
// record the program's exit code and stderr. A value is single-quoted, and none
// of the cases contains a quote.
fn runScript(prog: string, scratch: string, cases: []Case): string {
  let s = "#!/bin/sh\n"
  for (let i = 0; i < len(cases); i = i + 1) {
    let c = cases[i]
    s = s +
      "(\n${c.name}='${c.value}'\nexport ${c.name}\n" +
      "'${prog}' > '${scratch}/out_${i}.txt' 2> '${scratch}/err_${i}.txt'\n" +
      "echo $? > '${scratch}/rc_${i}.txt'\n)\n"
  }
  return s
}

fn readOr(path: string, fallback: string): string {
  return readFile(path) catch _ {
    fallback
  }
}

// The text a case must produce on stderr: nothing when valid, the exact line when not.
fn wantStderr(c: Case): string {
  if (c.valid) {
    return ""
  }
  return "bit: invalid ${c.name}=\"${c.value}\", valid: ${rangeOf(c.name)}\n"
}

fn checkCase(t: Tally, c: Case, scratch: string, i: int) {
  let rc = parseInt(trimWs(readOr("${scratch}/rc_${i}.txt", "missing"))) catch _ {
    0 - 999
  }
  let err = readOr("${scratch}/err_${i}.txt", "<no stderr file>")
  let out = readOr("${scratch}/out_${i}.txt", "<no stdout file>")
  let label = "${c.name}='${c.value}'"
  let wantRc = 0
  if (!c.valid) {
    wantRc = wantExit
  }
  check(t, rc == wantRc, "${label}: exit ${rc}, want ${wantRc}")
  check(t, err == wantStderr(c), "${label}: stderr was:\n${err}want:\n${wantStderr(c)}")
  check(t, out == "", "${label}: stdout must be empty, was:\n${out}")
}

// THE MAP HASH SEED (#7379). Slot order is a function of the seed, so a map's
// iteration order is the seed made visible. Unseeded, four processes must not
// all print one order (64 keys: the chance that four independent seeds agree
// is negligible); under `BIT_HASH_SEED=1` two processes must print the same
// one. A seed fixed per process fails the first; an override that does not
// reach the hash fails the second.
// `$` and `{` are split across two literals so neither is interpolated here.
fn orderSource(): string {
  return "fn main() {\n" +
    "  let m: map<string, int> = {}\n" +
    "  let i = 0\n" +
    "  while (i < 64) {\n" +
    "    m[\"k$" +
    "{i}\"] = i\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  for k in m {\n" +
    "    print(\"$" +
    "{k} \")\n" +
    "  }\n" +
    "}\n"
}

fn seedRuns(prog: string, scratch: string): string {
  let s = "#!/bin/sh\n"
  for (let i = 0; i < 4; i = i + 1) {
    s = s + "'${prog}' > '${scratch}/order_${i}.txt'\n"
  }
  for (let i = 4; i < 6; i = i + 1) {
    s = s + "BIT_HASH_SEED=1 '${prog}' > '${scratch}/order_${i}.txt'\n"
  }
  return s
}

fn checkSeed(t: Tally, scratch: string, ms: int) {
  let bit = bitBinary(scratch, ms) catch e {
    panic("gcenvrange: ${e.message()}")
  }
  let prog = "${scratch}/order"
  writeFile("${prog}.bit", orderSource()) catch e {
    panic("gcenvrange: cannot write the order fixture: ${e.message()}")
  }
  let script = "#!/bin/sh\n'${bit}' build '${prog}.bit' -o '${prog}' || exit 1\n" +
    seedRuns(prog, scratch)
  let code = shell("${scratch}/order.sh", script, ms) catch e {
    panic("gcenvrange: ${e.message()}")
  }
  check(t, code == 0, "the order fixture must build and run (exited ${code})")
  let o: []string = []
  for (let i = 0; i < 6; i = i + 1) {
    o = append(o, readOr("${scratch}/order_${i}.txt", ""))
  }
  check(t, len(o[0]) > 0, "the order fixture printed nothing")
  let varied = o[0] != o[1] || o[0] != o[2] || o[0] != o[3]
  check(t, varied, "four unseeded runs printed one map order: the seed is not per process\n${o[0]}")
  check(t, len(o[4]) > 0 && o[4] == o[5], "BIT_HASH_SEED=1 runs differ:\n${o[4]}\n${o[5]}")
}

fn runAll(t: Tally, scratch: string, ms: int) {
  checkSeed(t, scratch, ms)
  let prog = buildFixture(t, scratch, ms)
  if (prog == "") {
    return
  }
  let cases = allCases()
  let code = shell("${scratch}/run.sh", runScript(prog, scratch, cases), ms) catch e {
    panic("gcenvrange: ${e.message()}")
  }
  check(t, code == 0, "the case script must exit 0 (exited ${code})")
  for (let i = 0; i < len(cases); i = i + 1) {
    checkCase(t, cases[i], scratch, i)
  }
}

fn main() {
  let ms = timeoutMs()
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  let scratch = "${tmp}/bit-gcenvrange-${uuidFormat(uuidV4())}"
  let t = Tally{ checks = 0, failures = 0 }

  mkdir(scratch) catch e {
    panic("gcenvrange: cannot create ${scratch}: ${e.message()}")
  }
  runAll(t, scratch, ms)

  // Three checks per case plus the build, the script and the four seed checks: a harness that ran
  // none of the cases must not read as a pass.
  let floor = 3 * len(allCases()) + 2 + 4
  if (t.checks < floor) {
    eprint("FAIL: only ${t.checks} checks ran, want ${floor}\n")
    t.failures = t.failures + 1
  }
  // `exit()` runs no defers (std/os, #3677), so the teardown is explicit.
  teardown(scratch, ms)
  if (t.failures > 0) {
    println("gcenvrange: FAIL — ${t.failures} of ${t.checks} checks failed")
    exit(1)
  }
  println("gcenvrange: PASS — ${t.checks} checks")
}

fn teardown(scratch: string, ms: int) {
  shell("${scratch}/rm.sh", "#!/bin/sh\nrm -rf '${scratch}'\n", ms) catch _ {
    return
  }
}

fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}
