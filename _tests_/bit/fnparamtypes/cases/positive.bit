type Named = (input: i64) => i64
type Plain = (i64) => i64
type Renamed = (description: i64) => i64
type Nested = (callback: (item: i64) => i64, value: i64) => i64
type Fallible = (argument: i64) => i64!

fn increment(x: i64): i64 {
  return x + 1
}

fn infer<T, U>(f: (documented: T) => U, x: T): U {
  return f(x)
}

fn inferOnly<T>(f: (documented: T) => i64): (T) => i64 {
  return f
}

fn nested(f: (i64) => i64, value: i64): i64 {
  return f(value)
}

fn mayFail(x: i64): i64! {
  return x
}

fn main() {
  let input = "binding"
  let named: Named = increment
  let plain: Plain = named
  let reverse: Named = plain
  let renamed: Renamed = reverse
  let callback: Nested = nested
  let fallible: Fallible = mayFail
  assert(input == "binding")
  assert(named(41) == 42)
  assert(plain(41) == 42)
  assert(reverse(41) == 42)
  assert(renamed(41) == 42)
  assert(callback(increment, 41) == 42)
  assert(infer(increment, 41) == 42)
  assert(inferOnly(increment)(41) == 42)
  let result = fallible(42) catch _ {
    panic("unexpected failure")
  }
  assert(result == 42)
}
