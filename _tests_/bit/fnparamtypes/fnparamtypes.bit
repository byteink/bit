// #7958: native syntax controls outside the pinned-oracle corpus.
import { env, envOr, exit } from "std/os"
import { mkdir, readDir, readFile, remove, writeFile } from "std/fs"
import { contains } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

class Case {
  name: string,
  source: string,
  diagnostic: string,
}

class Harness {
  bin: string,
  scratch: string,
  failures: int,
}

fn quote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) {
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

fn command(h: Harness, args: string): int {
  let path = h.scratch + "/run.sh"
  writeFile(path, "#!/bin/sh\nexec ${quote(h.bin)} ${args} > ${quote(h.scratch + "/out")} 2>&1\n") catch e {
    panic(e.message())
  }
  assert(fsChmod(path, 448) == 0)
  let code = osRunBounded(path, 60000)
  assert(code >= 0)
  return code
}

fn expectCode(h: Harness, name: string, got: int, want: int) {
  if (got == want) {
    return
  }
  let detail = readFile(h.scratch + "/out") catch e {
    panic(e.message())
  }
  eprint("fnparamtypes: ${name}: exit ${got}, expected ${want}\n${detail}\n")
  h.failures = h.failures + 1
}

fn rejectedCases(): []Case {
  return [
    Case{
      name = "named-first",
      source = "type F = (x: i64, string) => ()\n",
      diagnostic = "E0021",
    },
    Case{
      name = "unnamed-first",
      source = "type F = (i64, x: string) => ()\n",
      diagnostic = "E0021",
    },
    Case{ name = "named-tuple", source = "type F = (x: i64, y: string)\n", diagnostic = "E0021" },
    Case{ name = "named-single", source = "type F = (x: i64)\n", diagnostic = "E0021" },
    Case{ name = "default", source = "type F = (x: i64 = 1) => ()\n", diagnostic = "E0021" },
    Case{ name = "rest", source = "type F = (...x: i64) => ()\n", diagnostic = "E0021" },
    Case{
      name = "unbound",
      source = "type F = (documentary: i64) => ()\nfn main() { println(documentary) }\n",
      diagnostic = "E0040",
    },
    Case{
      name = "unknown-type",
      source = "type F = (documentary: Missing) => ()\n",
      diagnostic = "E0040",
    },
    Case{
      name = "named-call",
      source = "fn id(x: i64): i64 { return x }\nfn main() { let f: (documentary: i64) => i64 = id; println(f(documentary = 1)) }\n",
      diagnostic = "E0128",
    },
    Case{
      name = "type-mismatch",
      source = "fn id(x: i64): i64 { return x }\nfn main() { let f: (documentary: string) => i64 = id; println(f(1)) }\n",
      diagnostic = "E0041",
    },
    Case{
      name = "arity",
      source = "fn id(x: i64): i64 { return x }\nfn main() { let f: (documentary: i64) => i64 = id; println(f()) }\n",
      diagnostic = "E0050",
    },
  ]
}

fn checkRejections(h: Harness) {
  for c of rejectedCases() {
    let path = h.scratch + "/" + c.name + ".bit"
    writeFile(path, c.source) catch e {
      panic(e.message())
    }
    expectCode(h, c.name, command(h, "check ${quote(path)}"), 1)
    let text = readFile(h.scratch + "/out") catch e {
      panic(e.message())
    }
    if (!contains(text, c.diagnostic)) {
      eprint("fnparamtypes: ${c.name}: missing ${c.diagnostic}\n${text}\n")
      h.failures = h.failures + 1
    }
  }
}

fn checkFormat(h: Harness, source: string) {
  let path = h.scratch + "/format.bit"
  writeFile(path, source) catch e {
    panic(e.message())
  }
  expectCode(h, "format", command(h, "fmt ${quote(path)}"), 0)
  let first = readFile(path) catch e {
    panic(e.message())
  }
  assert(contains(first, "input: i64"))
  assert(contains(first, "callback: (item: i64) => i64"))
  expectCode(h, "format-again", command(h, "fmt ${quote(path)}"), 0)
  let second = readFile(path) catch e {
    panic(e.message())
  }
  assert(first == second)
  expectCode(h, "formatted-check", command(h, "check ${quote(path)}"), 0)
}

fn cleanup(h: Harness) {
  let files = readDir(h.scratch) catch e {
    panic(e.message())
  }
  assert(len(files) < 64)
  for file of files {
    remove(h.scratch + "/" + file) catch e {
      panic(e.message())
    }
  }
  remove(h.scratch) catch e {
    panic(e.message())
  }
}

fn main() {
  let repo = env("BIT_REPO")
  let bin = env("BIT_BIN")
  assert(repo != "" && bin != "")
  let scratch = envOr("TMPDIR", "/tmp") + "/t7958-" + uuidFormat(uuidV4())
  mkdir(scratch) catch e {
    panic(e.message())
  }
  let h = Harness{ bin = bin, scratch = scratch }
  let fixture = repo + "/_tests_/bit/fnparamtypes/cases/positive.bit"
  expectCode(h, "positive", command(h, "run ${quote(fixture)}"), 0)
  checkRejections(h)
  let source = readFile(fixture) catch e {
    panic(e.message())
  }
  checkFormat(h, source)
  cleanup(h)
  if (h.failures != 0) {
    exit(1)
  }
  println("fnparamtypes: 1 runtime, 11 rejections, named format fixpoint: OK")
}
