// #6144 regression fixture, file B of this module. `Comment.author`
// carries `@belongsTo`, colliding with `belongsTo` declared in the sibling
// `loader.bit` — the exact shape #6144 reported: a module that also builds
// a relation loader off the same name as the field's own attribute.
// `Thread.pinned` carries `@hasOne`, which collides with nothing in this
// module — the control, proving the fix is surgical: recording must not
// regress for a relation mark that was never broken.
import { FieldDesc, AttrDesc } from "std/sql"

class Author {
  id: i64,
}

@table class Comment {
  @id
  id: i64
  @belongsTo("authorId")
  author: Author
}

@table class Thread {
  @id
  id: i64
  @hasOne("commentId")
  pinned: Comment
}

fn describe(name: string, fields: []FieldDesc) {
  for f of fields {
    print("${name}.${f.name}:${f.typeName} attrs=[")
    let i = 0
    while (i < len(f.attrs)) {
      if (i > 0) {
        print(",")
      }
      print("@${f.attrs[i].name}")
      i = i + 1
    }
    print("]\n")
  }
}

fn main() {
  describe("Comment", Comment{ id = 1, author = Author{ id = 0 } }.tableDescriptor())
  describe(
    "Thread",
    Thread{ id = 2, pinned = Comment{ id = 0, author = Author{ id = 0 } } }.tableDescriptor(),
  )
}
