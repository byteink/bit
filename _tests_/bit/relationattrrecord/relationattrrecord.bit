// _tests_/bit/relationattrrecord/relationattrrecord.bit — #6144 regression:
// `compiler/classtabledesc.bit`'s `collectRecordedAttrs` used
// `attrNameResolvesToFunc` as its ONLY discriminator for whether a field
// attribute is recorded into `tableDescriptor()`, never consulting
// `fieldAttrIsCompilerKnown` (`@key`/`@column`/a relation mark) the way
// `calledFieldAttrs` (compiler/classfieldattr.bit) already does on the CALL
// side. A `@belongsTo` field in a module that ALSO declares a free function
// named `belongsTo` — the normal way to build a `pkg/orm` relation loader —
// saw the attribute silently vanish: not recorded (its name resolves), and
// not called either (`fieldAttrIsCompilerKnown` already excludes every
// relation mark from the call path, unconditionally). `fixture/loader.bit`
// declares the colliding `belongsTo`; `fixture/model.bit`'s `Comment.author`
// carries `@belongsTo` and is the field this harness proves recovers its
// attribute; `Thread.pinned`'s `@hasOne`, which collides with nothing, is
// the control proving the fix does not touch the already-working path.
//
// The fix is gated behind `BIT_TABLEDESC_KNOWNATTR=1` (compiler/
// classtabledesc.bit's own header on `compilerKnownAttrAlwaysRecorded`):
// this harness runs the fixture BOTH ways, asserting the flag-off run keeps
// today's behaviour (the collision drops `author`'s attribute, `pinned`'s
// is unaffected) and the flag-on run records both.
//
// Usage: BIT_BIN=$PWD/bit-out/bin/bit BIT_STDLIB=$PWD/stdlib \
//   bit run _tests_/bit/relationattrrecord

import { readFile, writeFile } from "std/fs"
import { envOr, exit } from "std/os"
import { indexOf, trimSpace } from "std/strings"
import { now } from "std/time"

const timeoutMs: int = 60000
const fixtureDir: string = "_tests_/bit/relationattrrecord/fixture"

fn requiredEnv(name: string): string {
  let v = envOr(name, "")
  if (v == "") {
    eprint("relationattrrecord: ${name} is not set\n")
    exit(2)
  }
  return v
}

fn mustContain(haystack: string, needle: string, label: string) {
  if (indexOf(haystack, needle) >= 0) {
    return
  }
  eprint("relationattrrecord: FAIL: ${label} must contain:\n  ${needle}\ngot:\n${haystack}\n")
  exit(1)
}

fn mustNotContain(haystack: string, needle: string, label: string) {
  if (indexOf(haystack, needle) < 0) {
    return
  }
  eprint("relationattrrecord: FAIL: ${label} must NOT contain:\n  ${needle}\ngot:\n${haystack}\n")
  exit(1)
}

// Runs `fixtureDir` as a program with `flagValue` in `BIT_TABLEDESC_KNOWNATTR`
// (empty means unset) and returns its captured stdout. The script's own exit
// is always 0 (the run's exit code is recorded to `<script>.rc` rather than
// propagated) so a nonzero return here means the CHILD never ran to
// completion — asserted separately from stdout's content below.
fn runFixture(bin: string, flagValue: string): string {
  let script = "/tmp/bit-relationattrrecord-${now().ns}.sh"
  let outPath = "${script}.out"
  let rcPath = "${script}.rc"
  let envLine = ""
  if (flagValue != "") {
    envLine = "export BIT_TABLEDESC_KNOWNATTR=\"${flagValue}\"\n"
  }
  let cmd = "#!/bin/sh\n${envLine}\"${bin}\" run \"${fixtureDir}\" >\"${outPath}\" 2>&1\necho $? > \"${rcPath}\"\n"
  writeFile(script, cmd) catch e {
    eprint("relationattrrecord: cannot write ${script}: ${e.message()}\n")
    exit(2)
  }
  if (fsChmod(script, 493) != 0) {
    eprint("relationattrrecord: cannot chmod ${script}\n")
    exit(2)
  }
  let rc = osRunBounded(script, timeoutMs)
  let outText = readFile(outPath) catch _ {
    ""
  }
  let childRc = trimSpace(
    readFile(rcPath) catch _ {
      "?"
    },
  )
  fsRemove(script)
  fsRemove(outPath)
  fsRemove(rcPath)
  if (rc != 0) {
    eprint("relationattrrecord: FAIL: driver script did not run to completion (rc=${rc})\n${outText}\n")
    exit(1)
  }
  if (childRc != "0") {
    eprint("relationattrrecord: FAIL: `bit run ${fixtureDir}` exited ${childRc}\n${outText}\n")
    exit(1)
  }
  return outText
}

fn main() {
  let bin = requiredEnv("BIT_BIN")

  // Flag off (default): today's behaviour. The collision drops
  // `Comment.author`'s attribute; `Thread.pinned` (no collision) keeps its
  // recorded `@hasOne`.
  let off = runFixture(bin, "")
  mustContain(off, "Comment.author:Author attrs=[]", "flag-off output")
  mustContain(off, "Thread.pinned:Comment attrs=[@hasOne]", "flag-off output")

  // Flag on: #6144's fix. Both are recorded regardless of the collision.
  let on = runFixture(bin, "1")
  mustContain(on, "Comment.author:Author attrs=[@belongsTo]", "flag-on output")
  mustContain(on, "Thread.pinned:Comment attrs=[@hasOne]", "flag-on output")
  mustNotContain(on, "Comment.author:Author attrs=[]", "flag-on output")

  print("relationattrrecord: PASS\n")
}
