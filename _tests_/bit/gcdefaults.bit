// Boot-time GC config gate (#2920): with every BIT_GC_* variable unset, a
// freshly-booted process's EFFECTIVE collector config must equal the defaults
// `runtime/gc/gc.bit` exports, not some other copy elsewhere in `runtime/root`.
//
// THE DEFECT THIS PREVENTS FROM RETURNING. Both `runtime/root/{darwin,linux}/
// boot.bit` carried a private `const minTrigger: int = 65536`, 64x below
// `gcDefaultMinTrigger` (4194304). `gcInit` seeded the collector correctly;
// `boot`'s own call into `rootConfigureFromEnv` then overwrote it with the
// stale copy on every program, on both platforms, for two weeks across
// several releases — because nothing ever compared the applied value against
// the documented one. This gate is that comparison, run every time.
//
// WHY A DIRECT STATE READ, NOT A BEHAVIOURAL PROXY. An earlier draft of this
// gate ran `bench/cases/alloc/alloc.bit` under BIT_GC_STATS and diffed the
// printed collection count between "unset" and an explicit override — a
// real, working discriminator (95 vs 14 collections on a 750K-allocation
// probe against today's regression), but indirect: it infers the config from
// its EFFECT on a large, several-second allocation run, at the mercy of
// whatever else the allocator happens to be doing. `rootGcAddr()` (already
// exported for the runtime's own use) returns the address of the live
// process's collector state block, and `gcNextBytes`/`gcCfgGrowthPct`/
// `gcStackLen` (exported alongside this gate) are the exact word offsets
// `gcConfigure`/`gcInit` wrote through — so this reads the applied value
// directly, in microseconds, at the very top of `main`, before any
// allocation of this program's own has had a chance to run a collection and
// reschedule `gcNextBytes` away from the boot-time value. Stronger and
// cheaper than the alternative.
//
// WHY `gcNextBytes` FOR THE MIN TRIGGER, NOT A `gcCfgMinTrigger` READ. The
// latter is private to `runtime/gc` (word 11) and would need its own export;
// `gcNextBytes` (word 14, already exported for `stwPoll`, #1700) is written
// to the SAME value at both `gcInit` and `gcConfigure` (`runtime/gc/gc.bit`)
// and nothing between boot and this line can have changed it — no collection
// has run yet — so it is an exact, no-new-surface proxy.
//
// THE MARK-STACK ROW asserts against `gcDefaultMarkStack` directly (#2923):
// `boot.bit`'s local `markStack` const (4096, half of `gcDefaultMarkStack`'s
// 8192 — the same duplicate-default shape as the min trigger) is gone, and
// both `boot.bit` files now source `gcDefaultMarkStack` straight from
// `runtime/gc/gc.bit`, so this row can assert equality like the other two
// instead of pinning a known-divergent literal.
//
// Run from the repository root: ./bit-out/bin/bit run _tests_/bit/gcdefaults.bit
import { exit } from "std/os"
import { rootGcAddr } from "../../runtime/root"
import {
  gcNextBytes, gcCfgGrowthPct, gcStackLen,
  gcDefaultMinTrigger, gcDefaultGrowthPct, gcDefaultMarkStack,
} from "../../runtime/gc"

class Tally { checks: int, failures: int }

fn check(t: Tally, cond: bool, label: string) {
  t.checks = t.checks + 1
  if (!cond) {
    t.failures = t.failures + 1
    eprint("FAIL: ${label}\n")
  }
}

fn main() {
  let base: *i64 = nil
  let g = base + rootGcAddr() / 8

  let effMinTrigger = *(g + gcNextBytes)
  let effGrowthPct = *(g + gcCfgGrowthPct)
  let effMarkStack = *(g + gcStackLen)

  let t = Tally{ checks: 0, failures: 0 }

  check(
    t, effMinTrigger == gcDefaultMinTrigger,
      "effective GC min trigger is ${effMinTrigger}, want gcDefaultMinTrigger " +
      "(${gcDefaultMinTrigger}) — #2920 regressed if this fails",
  )

  check(
    t, effGrowthPct == gcDefaultGrowthPct,
      "effective GC growth pct is ${effGrowthPct}, want gcDefaultGrowthPct " +
      "(${gcDefaultGrowthPct})",
  )

  check(
    t, effMarkStack == gcDefaultMarkStack,
      "effective GC mark-stack length is ${effMarkStack}, want gcDefaultMarkStack " +
      "(${gcDefaultMarkStack}) — #2923 regressed if this fails",
  )

  if (t.checks < 3) {
    eprint("FAIL: only ${t.checks} checks ran, want at least 3\n")
    t.failures = t.failures + 1
  }
  if (t.failures > 0) {
    println("gcdefaults: FAIL — ${t.failures} of ${t.checks} checks failed")
    exit(1)
  }
  println("gcdefaults: PASS — ${t.checks} checks")
}
