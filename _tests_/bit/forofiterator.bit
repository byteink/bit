// _tests_/bit/forofiterator.bit — moved out of _tests_/cases/ by #5585
// (originally landed as #5563, epic #4107): proves `break` and an early
// `return` inside `for x of it` still work where `it`'s type declares
// `next(): Option<T>`.
//
// NOT placed in _tests_/cases/: that corpus is swept by every
// scripts/selfhost-diff*.sh differential (CORPUS="stdlib examples
// _tests_/cases _tests_/imports" in scripts/selfhost-diffdump.sh) against
// the PINNED STAGE0 oracle, and the `next(): Option<T>` for-of lowering
// (#5561 checker, #5562 lowering) landed AFTER that pin. Run stage0 by hand
// on either fixture and it emits a partial IR dump (the `next()` method
// only, no `main`) and exits 0 instead of erroring, so
// SKIPLABEL="lower/check-err" never fires and the file scores MISMATCH
// instead of SKIP — reddening every IR differential by construction. Same
// "route it to _tests_/bit/ behind a registered gate" treatment
// _tests_/bit/deferblock.bit and _tests_/bit/classkeyword.bit document for
// their own not-yet-released surface. So this drives the CLI directly
// instead, outside the oracle-swept corpus.
//
// The two assertions, carried over unchanged from the deleted
// _tests_/cases/run_forof_iterator_{break,return}.bit:
//   break:  `Counter.calls` counts only the `next()` calls that returned
//           `Some`, so printing it after `break` proves the loop stopped
//           early — a fixture that printed only the sum of `x` values could
//           not distinguish "stopped early" from "consumed everything and
//           ignored the tail".
//   return: three independent proofs in one printed line — `result` is the
//           value the early `return` carried out through the function
//           boundary, `calls` stays below `total` (the loop did not drain
//           the iterator), and `tailRan` stays 0 (the statement after the
//           `for … of` loop is reachable only if the early `return` did NOT
//           fire).
// `total`/`breakAt`/`threshold` all come from `len` of a slice built at run
// time, never a literal, so the constant folder cannot leave a probe that
// passes by never running the loop.
//
// WIRED INTO `./make test` as `test-forofiterator`
// (tools/build/gatestable2.bit, tools/build/defs.bit).

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"
import { parseInt, trimSpace } from "std/strings"

const defaultTimeoutS: int = 60
const maxTimeoutMs: int = 6000000

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("forofiterator: ${name} is not set — refusing to guess.\n")
    exit(2)
  }
  return v
}

fn timeoutMs(): int {
  let raw = trimSpace(envOr("BIT_TEST_TIMEOUT_S", ""))
  if (raw == "") {
    return defaultTimeoutS * 1000
  }
  let s = parseInt(raw) catch _ {
    return defaultTimeoutS * 1000
  }
  if (s <= 0) {
    return maxTimeoutMs
  }
  if (s * 1000 > maxTimeoutMs) {
    return maxTimeoutMs
  }
  return s * 1000
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

// The break fixture: `for x of it` breaks out of the loop early, and only
// `Counter.calls` (not the sum of `x`) can prove it stopped rather than
// draining the iterator — see the header.
fn breakFixtureSrc(): string {
  return "class Counter {\n  n: i64\n  calls: i64\n" +
    "  next(): Option<i64> {\n" +
    "    if (this.n <= 0) {\n      return Option.None\n    }\n" +
    "    this.calls = this.calls + 1\n    this.n = this.n - 1\n" +
    "    return Option.Some(this.n)\n  }\n}\n\n" +
    "fn main() {\n" +
    "  let sizer = [1, 1, 1, 1, 1, 1]\n" +
    "  let total: i64 = len(sizer)\n" +
    "  let breakAt = total / 2\n" +
    "  let it = Counter{ n = total, calls = 0 }\n" +
    "  for x of it {\n" +
    "    if (x == breakAt) {\n      break\n    }\n  }\n" +
    "  print(\"calls=\${it.calls} total=\${total}\\n\")\n}\n"
}

const wantBreakOut: string = "calls=3 total=6\n"

// The return fixture: an early `return` from inside `for x of it`, proven
// three ways at once — see the header.
fn returnFixtureSrc(): string {
  return "class Counter {\n  n: i64\n  calls: i64\n  tailRan: i64\n" +
    "  next(): Option<i64> {\n" +
    "    if (this.n <= 0) {\n      return Option.None\n    }\n" +
    "    this.calls = this.calls + 1\n    this.n = this.n - 1\n" +
    "    return Option.Some(this.n)\n  }\n}\n\n" +
    "fn findBelow(it: Counter, threshold: i64): i64 {\n" +
    "  for x of it {\n" +
    "    if (x < threshold) {\n      return x\n    }\n  }\n" +
    "  it.tailRan = 1\n  return -1\n}\n\n" +
    "fn main() {\n" +
    "  let sizer = [1, 1, 1, 1, 1, 1]\n" +
    "  let total: i64 = len(sizer)\n" +
    "  let threshold = total / 2\n" +
    "  let it = Counter{ n = total, calls = 0, tailRan = 0 }\n" +
    "  let result = findBelow(it, threshold)\n" +
    "  print(\"result=\${result} calls=\${it.calls} total=\${total} tailRan=\${it.tailRan}\\n\")\n}\n"
}

const wantReturnOut: string = "result=2 calls=4 total=6 tailRan=0\n"

// The compiler under test, bundled with the environment it needs to run
// (BIT_STDLIB/BIT_LIBBITRT) — same shape as deferblock.bit's CompilerEnv.
class CompilerEnv {
  bin: string,
  stdlib: string,
  libbitrt: string,
}

// Builds `srcPath` to `outPath`, with the compiler's own environment
// (BIT_STDLIB/BIT_LIBBITRT) exported. Returns the wrapper's exit code and
// captured stderr.
fn buildOne(cc: CompilerEnv, dir: string, srcPath: string, outPath: string): (int, string) {
  let shPath = dir + "/build.sh"
  let errPath = dir + "/build.err"
  let script = "#!/bin/sh\n" +
    "BIT_STDLIB=" +
    shQuote(cc.stdlib) +
    "\nexport BIT_STDLIB\n" +
    "BIT_LIBBITRT=" +
    shQuote(cc.libbitrt) +
    "\nexport BIT_LIBBITRT\n" +
    "exec " +
    shQuote(cc.bin) +
    " build " +
    shQuote(srcPath) +
    " -o " +
    shQuote(outPath) +
    " > /dev/null 2> " +
    shQuote(errPath) +
    "\n"
  writeFile(shPath, script) catch e {
    eprint("forofiterator: cannot write build wrapper: ${e.message()}\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("forofiterator: cannot chmod build wrapper\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let err = readFile(errPath) catch _ {
    ""
  }
  return code, err
}

// Runs the built binary at `binPath`. Returns its exit code and stdout.
fn runOne(dir: string, binPath: string): (int, string) {
  let shPath = dir + "/run.sh"
  let outPath = dir + "/run.out"
  let script = "#!/bin/sh\nexec " + shQuote(binPath) + " > " + shQuote(outPath) + " 2>&1\n"
  writeFile(shPath, script) catch e {
    eprint("forofiterator: cannot write run wrapper: ${e.message()}\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("forofiterator: cannot chmod run wrapper\n")
    teardown(dir, timeoutMs())
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let out = readFile(outPath) catch _ {
    ""
  }
  return code, out
}

// `exit()` does not run pending defers — call this explicitly at every exit
// site instead (same reasoning as deferblock.bit's teardown).
fn teardown(scratch: string, ms: int) {
  let shPath = scratch + "/rm.sh"
  writeFile(shPath, "#!/bin/sh\nrm -rf '${scratch}'\n") catch _ {
    return
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    return
  }
  osRunBounded(shPath, ms)
}

// Builds and runs one fixture in its own subdirectory of `scratch`,
// comparing its stdout to `want`. `label` names the fixture in every
// message so a FAIL identifies which behaviour (break or return) diverged.
fn checkFixture(cc: CompilerEnv, scratch: string, label: string, src: string, want: string) {
  let dir = scratch + "/${label}"
  mkdir(dir) catch e {
    eprint("forofiterator: cannot create ${dir}: ${e.message()}\n")
    teardown(scratch, timeoutMs())
    exit(2)
  }
  let srcPath = dir + "/fixture.bit"
  writeFile(srcPath, src) catch e {
    eprint("forofiterator: cannot write ${srcPath}: ${e.message()}\n")
    teardown(scratch, timeoutMs())
    exit(2)
  }
  let outPath = dir + "/fixture_out"
  let (buildCode, buildErr) = buildOne(cc, dir, srcPath, outPath)
  if (buildCode != 0) {
    eprint("forofiterator: FAIL — ${label} failed to build (exit ${buildCode}):\n${buildErr}\n")
    teardown(scratch, timeoutMs())
    exit(1)
  }
  let (runCode, out) = runOne(dir, outPath)
  if (runCode != 0 || out != want) {
    eprint("forofiterator: FAIL — ${label} ran wrong: exit=${runCode}\n  want: ${want}\n  got:  ${out}\n")
    teardown(scratch, timeoutMs())
    exit(1)
  }
}

fn main() {
  let cc = CompilerEnv{
    bin = requiredEnv("BIT_BIN"),
    stdlib = requiredEnv("BIT_STDLIB"),
    libbitrt = requiredEnv("BIT_LIBBITRT"),
  }

  let scratch = envOr("TMPDIR", "/tmp") + "/bit-forofiterator-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("forofiterator: cannot create scratch directory ${scratch}: ${e.message()}\n")
    exit(2)
  }

  checkFixture(cc, scratch, "break", breakFixtureSrc(), wantBreakOut)
  checkFixture(cc, scratch, "return", returnFixtureSrc(), wantReturnOut)

  teardown(scratch, timeoutMs())
  print("PASS forofiterator: break and early return inside for-of over a next(): Option<T> iterable lower and run correctly\n")
}
