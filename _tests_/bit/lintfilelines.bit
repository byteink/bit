// `bit lint` never ran over `compiler/` or `runtime/` (#2747, following #2515's
// same shape for E0211 over `runtime/` alone): the file that implements the
// 800-line `max-file-lines` rule (E0200, `compiler/lint.bit`) itself drifted to
// 1362 lines — 62 over its own 1300-line override — with nothing to catch it,
// because no gate ever pointed `bit lint` at the compiler's own source.
//
// This gate enforces ZERO `E0200` findings in `compiler/`, `runtime/` and
// `stdlib/` — one rule, not the whole set. #2567's 63 non-E0211 `runtime/`
// findings (including its own E0200-adjacent readability rules) are a
// separate, still-open decision; bundling them here guarantees a red gate on
// day one, which in this repo means the gate gets ignored. `E0200` alone
// needs no such policy call: the threshold is objective and #2470/#2471
// already brought every prior offender in `compiler/`/`runtime/` under 800
// with no override, and every `stdlib/*.bit` file is under 800 too (closest:
// `stdlib/tls/handshake.bit`), so this is green on day one (#2747's own
// measured baseline on `main` @ `c2a1eb27`, extended to `stdlib/` by #2895).
//
// SCOPE, STATED EXPLICITLY: `compiler/`, `runtime/`, `stdlib/`,
// `_tests_/stress/`, `examples/`, `_tests_/bit/`, `_tests_/imports/` and
// `_tests_/cases/` (#2480/#2481 widened it from the first three to include
// `_tests_/stress/` after both `_tests_/stress/chan/props/props.bit` and
// `_tests_/stress/stwcollect/stwcollect.bit` sat over 800 lines with nothing
// to catch it; #2974 widened it again to the remaining three trees — checked
// directly on 2026-08-13/14 as clean, so this did not move today's verdict,
// but nothing stopped a file in any of them growing past 800 undetected, the
// same gap this gate closes everywhere else; #5605 widened it once more to
// `_tests_/cases/`, the one tree this file's own earlier revision said "MUST
// STAY EXCLUDED FOREVER" — wrong: the boundary fixtures below needed a named
// exemption, not a blanket exclusion that would also miss a real accident).
//   - `_tests_/cases/` IS THE GOLDEN CORPUS ITSELF (CONTRIBUTING.md's mode
//     directives — `// run`, `// error`, `// panic`, `// lint exit=N`, ...).
//     Two things make it unlike every other tree in `dirs`:
//     (1) `lint_boundary_fail.bit` (801 lines) and `lint_finding.bit` (4
//     lines against its own `// bit:lint max-file-lines=3` override
//     directive) are E0200's own boundary/override-testing fixtures,
//     deliberately over their effective limit — see `caseExemptions()`
//     below, checked BOTH ways exactly like `tools/build/lint-debt.txt`: an
//     E0200 finding whose file is not listed fails the gate (a real drift),
//     and a listed entry with no live finding fails it too (stale, masking
//     the next real one). (2) `// error`- and `// lint exit=2`-mode files
//     (178 of 858 as measured on #5605) are deliberately malformed to
//     exercise the checker's own diagnostics, so `bit lint _tests_/cases`
//     always exits 2 — SPEC's "untrusted run" verdict for the RUN, not for
//     E0200 specifically: E0200 is a pure per-file line count with no
//     dependency on whether OTHER files in the batch parsed, and `bit lint`
//     still prints its findings for every file regardless (verified: `bit
//     lint _tests_/cases` on main @ 5b6a0067 prints exactly the 2 E0200
//     findings above plus 53 unrelated parse errors, all attributable to
//     `// error`/`// lint exit=2` fixtures, and exits 2). `assertTrustworthy`
//     below allows exit 2 for `_tests_/cases` alone, for exactly this reason
//     — see `allowExitTwo`.
//   - `_tests_/bit/checkercases/` and `_tests_/bit/parsercases/` are FIXTURE
//     CORPORA, not harnesses — the same distinction `_tests_/bit/filesize.bit`
//     already draws with its own `isFixtureCorpus`, decided the identical
//     way: a directory holding at least one `.expected` file. Several of
//     their `.bit` files are deliberately malformed on purpose (e.g.
//     `check_function_keyword_removed.bit` uses the removed `function`
//     keyword) and make `bit lint` exit 2 — an unparseable input, not a
//     lint finding — which this gate would otherwise mistake for an
//     untrustworthy run (`assertTrustworthy` below). So this gate still
//     visits every `.bit` file beneath `_tests_/bit/` for the denominator
//     (`files`), but never hands a fixture-corpus file to `bit lint`; those
//     files are counted as "skipped" and printed alongside the scan, the
//     same transparency `filesize.bit` gives its own skipped count, so
//     "nothing to exclude" and "silently excluded everything" never look
//     the same here either. The decision is a PROPERTY of the directory
//     within `_tests_/bit/`, never a name list — a third fixture corpus added
//     anywhere under `_tests_/bit/` is excluded automatically instead of
//     silently falling out of scope.
//   - THE SCAN ROOT ITSELF (`_tests_/bit/` as a whole) is NEVER asked whether
//     it is a fixture corpus, even though the `.expected`-anywhere-in-listing
//     property literally applies to it too (#4100): `testloc.bit` and
//     `testpanic.bit` each carry a same-named `.expected` oracle directly at
//     top level, an unrelated harness-output convention (mirroring
//     `_tests_/stress/`'s own per-test `.expected` files) rather than a
//     fixture corpus. Naively testing the root the same way a subdirectory is
//     tested made it look like a `.bit`/`.expected` pair corpus and
//     wholesale-excluded every one of the tree's 219 files — the whole tree
//     read "skipped as fixture corpora" with nothing scanned at all.
//     `testloc.bit`/`testpanic.bit` lint cleanly (0 findings), so they were
//     never fixtures to begin with. `collectRootTargets` walks the root's own
//     children directly; only a directory *reached through* that walk is ever
//     tested for `isFixtureCorpus` — see `collectRootTargets` and
//     `walkChildren` below.
//   - THIS EXCLUSION IS SCOPED TO `_tests_/bit/` ONLY, and that scoping is
//     load-bearing, not cosmetic: `_tests_/stress/` has an `.expected` file
//     beside nearly every one of its ~90 subdirectories — each stress test's
//     own expected-output oracle, an unrelated convention from a different
//     harness family, not a lint-hostile fixture corpus. Reusing
//     `isFixtureCorpus` as a repo-wide property (rather than scoping it to
//     `_tests_/bit/` by directory name) was tried while building this gate and
//     silently excluded the entire `_tests_/stress/` tree from E0200 linting —
//     a regression the mutation test below (the WRONG direction: a gate that
//     goes quieter, not louder) is what caught it. See `lintTargetsFor`.
//
// THE DENOMINATOR IS PRINTED ON PURPOSE. `_tests_/bit/filesize.bit` prints
// "N file(s) scanned" with no paired count, and that number alone reads as a
// whole-tree verdict while actually covering 77 of 1174 tracked `.bit` files —
// the third documented instance of a gate whose scope is invisible in its own
// output. This gate's pass line instead reports `N of N .bit file(s) scanned`
// per directory PLUS the combined total, and says outright which trees it
// does NOT cover, so nobody reading a green run mistakes it for whole-repo
// coverage.
//
// `N` is computed by a HAND-ROLLED recursive directory walk (`countBitFiles`
// below) rather than by importing `std/fs`'s `walk` — the same primitive
// `bit lint`'s own `collectLintFiles` (compiler/lintbatch.bit) calls to build
// its file list. Sharing that primitive would make the denominator blind to
// exactly the bug it exists to catch: if `walk` silently dropped a file, both
// the count AND the scan it is meant to police would shrink together and the
// gate would still show N == N. A zero count from either directory is a hard
// stop (`countBitFiles`'s caller), not a silent pass — the anti-vacuity
// guard: a gate that reports 0 E0200 while scanning 0 files is not passing,
// it is scanning nothing.
//
// `_tests_/bit/`'s fixture-corpus exclusion (above) needs its own walk to
// decide which paths are safe to hand `bit lint` (`collectLintTargets`
// below) — a SECOND hand-rolled walk, independent of `countBitFiles`. Rather
// than trust the two to agree, `scanOne` asserts it: `collectLintTargets`'s
// own file tally must equal `countBitFiles`'s, or the scan aborts instead of
// silently reporting whichever number happened to be smaller.
//
// Exactly like `_tests_/bit/lintruntime.bit`, none of a subprocess's exit code
// or stderr is observable from inside the linting process, so this shells the
// real `bit lint` out through `/bin/sh` and reads both back off disk.
//
// Run it from the repository root:
//     ./bit-out/bin/bit run _tests_/bit/lintfilelines.bit
// BIT_SELF_EXE names the compiler under test; BIT_REPO names the repo root
// `compiler/`, `runtime/` and `stdlib/` hang off. Both env vars are required
// — a missing one is a hard stop, not a silently different (and silently
// green) set of directories.
import { env, envOr, exit } from "std/os"
import { exists, isDir, mkdir, readDir, readFile, writeFile } from "std/fs"
import { contains, hasPrefix, hasSuffix, indexOf, lastIndexOf, parseInt, split } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// Bounds on the independent walk below — Power of 10 rule 2: `compiler/`,
// `runtime/` and `stdlib/` are small, fixed trees, but the recursion is still
// capped explicitly rather than trusted to terminate on its own.
const maxEntries: int = 4096
const maxScanDepth: int = 16

// #2919 dropped this back to 300, where #2747 originally set it (the whole
// run took 21s then). #2869 had added an undefined-name sibling-declaration
// hint that `bit lint`'s per-file resolves triggered on nearly every
// cross-file reference, and #2917's per-Resolver memoization still left it
// re-reading and re-parsing its whole directory once per FILE — 379 times —
// which #2917 compensated for by raising this to 1800s rather than fixing
// the root cause. #2919 fixed the root cause instead (that Resolver's
// diagnostics were always discarded by every lint caller, so the scan need
// not run there at all): the gate is back to ~20s, matching #2747's original
// number, so its original headroom applies again.
//
// This watchdog exists to catch a HANG, not to police performance, so 300s
// (~14x the ~20s run) leaves the same margin #2747 chose, and the enclosing
// gate batch has its own 5400s bound, so this can never be what wedges the
// suite. #2908 was wrongly blamed for an infinite loop for an hour on the
// strength of one TIMED OUT line — a flaky deadline is corrosive, so this
// stays generous rather than tight.
const defaultTimeoutS: int = 300

fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "${defaultTimeoutS}")) catch _ {
    defaultTimeoutS
  }
  if (s <= 0) {
    return defaultTimeoutS * 1000
  }
  return s * 1000
}

// Runs `script` through /bin/sh and returns its exit code. Negative returns
// are `osRunBounded`'s mechanism channel, never a program exit status, so
// each one is a named panic rather than a value any assertion could consume.
fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    fail newError("lintfilelines: cannot make script executable: ${scriptPath}")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == -2) {
    panic("lintfilelines: TIMED OUT after ${ms}ms running ${scriptPath}")
  }
  if (code == -1) {
    panic("lintfilelines: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("lintfilelines: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}

fn requiredEnv(name: string): string! {
  let v = env(name)
  if (len(v) == 0) {
    fail newError("lintfilelines: ${name} is required and was not set")
  }
  return v
}

// One `bit lint <paths...>` invocation, as seen from outside it. `paths` is
// usually a single directory (unchanged behavior for every tree with no
// nested fixture corpus), but `_tests_/bit/` hands several — see
// `collectLintTargets` for why a fixture-corpus subdirectory can never be
// among them, directly or via an ancestor directory that contains one.
class Run { code: int, err: string }

// Renders each of `paths` single-quoted and space-separated, e.g.
// " 'a' 'b'" — a leading space so it concatenates directly onto `lint` in
// the script below with no separate join step.
fn quotedPaths(paths: []string): string {
  let out = ""
  for p of paths {
    out = out + " '${p}'"
  }
  return out
}

fn runLint(bit: string, paths: []string, capDir: string, ms: int): Run! {
  let outPath = "${capDir}/out.txt"
  let errPath = "${capDir}/err.txt"
  let codePath = "${capDir}/code.txt"
  let script = "#!/bin/sh\n" +
    "'${bit}' lint" +
    quotedPaths(paths) +
    " > '${outPath}' 2> '${errPath}'\n" +
    "echo $? > '${codePath}'\n" +
    "exit 0\n"
  let sh = shell("${capDir}/lint.sh", script, ms)?
  if (sh != 0) {
    fail newError("lintfilelines: wrapper script exited ${sh}, which it never should")
  }
  if (!exists(codePath)) {
    fail newError("lintfilelines: no exit code was recorded — the run never happened")
  }
  let code = parseInt(trimWs(readFile(codePath)?))?
  return Run{ code = code, err = readFile(errPath)? }
}

// `std/strings`'s `trimSpace` strips only space/tab, not the trailing `\n`
// every captured `code.txt`/exit-code file carries — the same reason
// `_tests_/bit/lintruntime.bit` rolls this locally rather than relying on it.
fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

// The header line of one finding, e.g. `warning[E0200]: file is 825 lines...`.
fn isFindingHeader(line: string): bool {
  return hasPrefix(line, "warning[E") || hasPrefix(line, "error[E")
}

// `r` is a usable observation of a real run, not silence mistaken for a clean
// sheet. Anti-vacuity: `bit lint` always prints a summary to stderr, clean or
// not (compiler/lintbatch.bit's `lintCmd`), so an empty capture means the run
// produced nothing trustworthy. Exit 2 is SPEC's own "could not be trusted"
// verdict (usage error, unreadable path, malformed directive) — reading it as
// a clean run is exactly the hole `docs/development.md`'s four
// ways-to-report-green warns about.
// `dirName` decides `allowExitTwo`: `_tests_/cases` is the one tree in
// `dirs` where exit 2 is EXPECTED on every clean run (see the header's
// "`_tests_/cases/` IS THE GOLDEN CORPUS ITSELF" note) — its `// error`/
// `// lint exit=2`-mode fixtures are deliberately unparseable, which is
// SPEC's own "untrusted run" trigger for the batch as a whole even though
// the E0200 data this gate actually reads is unaffected by it. Every other
// directory keeps the strict 0/1-only check unchanged.
fn assertTrustworthy(r: Run, dir: string, dirName: string) {
  if (len(r.err) == 0) {
    panic("lintfilelines: stderr is empty — `bit lint ${dir}` produced no summary")
  }
  let allowExitTwo = dirName == "_tests_/cases"
  if (r.code == 2 && !allowExitTwo) {
    panic("lintfilelines: `bit lint ${dir}` exited 2 (untrusted run):\n${r.err}")
  }
  if (r.code == 2 && allowExitTwo) {
    return
  }
  if (r.code != 0 && r.code != 1) {
    panic("lintfilelines: `bit lint ${dir}` exited ${r.code}, want 0 or 1")
  }
}

// Total finding-header lines, and how many of those are E0200.
fn countFindings(err: string): (int, int) {
  let e0200 = 0
  let total = 0
  for line of split(err, "\n") {
    if (!isFindingHeader(line)) {
      continue
    }
    total = total + 1
    if (contains(line, "[E0200]")) {
      e0200 = e0200 + 1
    }
  }
  return total, e0200
}

// Prints every E0200 finding's header AND the file:line:col it names.
// `renderOne` (compiler/diagnostics.bit) always emits the location as the
// line immediately following the header (`<severity>[<code>]: <message>` then
// `--> <path>:<line>:<col>`), so an index-based loop — not the `for..of` above
// — is needed to look one line ahead. Printing the header alone (the bug this
// replaced) named the violation but never the file, which is useless for a
// gate whose whole job is telling the reader which file to split.
fn printE0200Findings(err: string) {
  let lines = split(err, "\n")
  let i = 0
  while (i < len(lines)) {
    if (contains(lines[i], "[E0200]")) {
      eprint("  ${lines[i]}\n")
      if (i + 1 < len(lines)) {
        eprint("  ${lines[i + 1]}\n")
      }
    }
    i = i + 1
  }
}

// One `_tests_/cases/` file this gate accepts as over its E0200 limit BY
// DESIGN, never as debt to pay down — see the header's "IS THE GOLDEN CORPUS
// ITSELF" note. `file` is the bare filename E0200's own `-->` location line
// names (no directory prefix: every finding this list is checked against
// comes from `_tests_/cases/` alone).
class CaseExemption { file: string, reason: string }

// EVERY ENTRY HERE MUST HAVE A LIVE E0200 FINDING, checked by
// `classifyCaseFindings` — an entry with none is stale (the file was fixed
// or deleted) and fails the gate rather than sitting as dead weight that
// would silently cover for the next file that drifts.
fn caseExemptions(): []CaseExemption {
  return [
    CaseExemption{
      file = "lint_boundary_fail.bit",
      reason = "801 raw lines, deliberately 1 over the 800-line limit to prove E0200 fails at the boundary",
    },
    CaseExemption{
      file = "lint_finding.bit",
      reason = "4 lines against its own `// bit:lint max-file-lines=3` override directive, testing E0200's override mechanism at a tiny scale, not a real over-800 file",
    },
  ]
}

// One E0200 finding, reduced to what `classifyCaseFindings` needs: the bare
// filename (matched against `caseExemptions()`) and the two raw lines
// (header + location) to print verbatim for an unexempt finding.
class E0200Finding { header: string, location: string, file: string }

// `line` is E0200's `-->` location line, e.g.
// " --> _tests_/cases/lint_boundary_fail.bit:1:1". Strips the arrow, the
// directory, and the trailing `:line:col`, leaving the bare filename
// `caseExemptions()` entries key on.
fn basenameFromLocation(line: string): string {
  let arrowAt = indexOf(line, "--> ")
  if (arrowAt < 0) {
    panic("lintfilelines: malformed E0200 location line, no '--> ': '${line}'")
  }
  let rest = line[int(arrowAt) + 4:]
  let slashAt = lastIndexOf(rest, "/")
  let name = rest
  if (slashAt >= 0) {
    name = rest[int(slashAt) + 1:]
  }
  let colonAt = indexOf(name, ":")
  if (colonAt < 0) {
    panic("lintfilelines: malformed E0200 location line, no ':line:col' suffix: '${line}'")
  }
  return name[:int(colonAt)]
}

// Every E0200 finding in `err`, in order — the same header+location pairing
// `printE0200Findings` walks, but collected rather than printed, and with
// the bare filename resolved eagerly so callers never re-parse the location
// line.
fn e0200Findings(err: string): []E0200Finding {
  let lines = split(err, "\n")
  let out = []E0200Finding(0)
  let i = 0
  while (i < len(lines)) {
    if (contains(lines[i], "[E0200]") && i + 1 < len(lines)) {
      out = append(
        out,
        E0200Finding{
          header = lines[i],
          location = lines[i + 1],
          file = basenameFromLocation(lines[i + 1]),
        },
      )
    }
    i = i + 1
  }
  return out
}

fn isExemptFile(file: string, exemptions: []CaseExemption): bool {
  for e of exemptions {
    if (e.file == file) {
      return true
    }
  }
  return false
}

fn hasFindingFor(file: string, findings: []E0200Finding): bool {
  for f of findings {
    if (f.file == file) {
      return true
    }
  }
  return false
}

// `_tests_/cases/`'s verdict, both directions of the named-exemption check:
// `unexempt` is every E0200 finding whose file is not on `caseExemptions()`
// (a real over-800 file, or a legitimate new boundary fixture missing its
// own entry) and `stale` is every exemption entry with no matching live
// finding (fixed or deleted, so the entry is dead weight now).
class CaseVerdict { unexempt: []string, stale: []string }

fn classifyCaseFindings(err: string): CaseVerdict {
  let findings = e0200Findings(err)
  let exemptions = caseExemptions()
  let unexempt = []string(0)
  for f of findings {
    if (!isExemptFile(f.file, exemptions)) {
      unexempt = append(unexempt, "${f.header}\n  ${f.location}")
    }
  }
  let stale = []string(0)
  for e of exemptions {
    if (!hasFindingFor(e.file, findings)) {
      stale = append(
        stale,
        "${e.file} (${e.reason}) -- no live E0200 finding, remove this exemption",
      )
    }
  }
  return CaseVerdict{ unexempt = unexempt, stale = stale }
}

// Prints `v`'s failures, if any, and reports whether `_tests_/cases/` fails
// the gate. Kept separate from `main`'s loop so the loop stays a flat
// dispatch rather than growing a second nested branch per failure kind.
fn reportCaseVerdict(v: CaseVerdict): bool {
  let failed = false
  if (len(v.unexempt) > 0) {
    failed = true
    eprint("FAIL: ${len(v.unexempt)} E0200 finding(s) in _tests_/cases/ not on the named exemption list (caseExemptions() below) — either a real over-800 file that needs splitting, or a legitimate new boundary fixture that needs its own exemption entry with a ticket:\n")
    for u of v.unexempt {
      eprint("  ${u}\n")
    }
  }
  if (len(v.stale) > 0) {
    failed = true
    eprint("FAIL: ${len(v.stale)} stale _tests_/cases/ exemption(s) — no matching live E0200 finding, remove from caseExemptions():\n")
    for s of v.stale {
      eprint("  ${s}\n")
    }
  }
  return failed
}

// The count of `.bit` files anywhere beneath `dir`, computed by a walk this
// file owns rather than by calling `std/fs`'s `walk` — see the header for why
// sharing that primitive with `bit lint`'s own file collector would make the
// denominator blind to a bug in it. Bounded by `maxScanDepth` (Power of 10
// rule 2), not merely documented as such.
fn countBitFiles(dir: string, depth: int): int {
  if (depth <= 0) {
    panic("lintfilelines: ${dir} nesting exceeds ${maxScanDepth} levels")
  }
  let names = readDir(dir) catch e {
    panic("lintfilelines: cannot list ${dir}: ${e.message()}")
  }
  if (len(names) > maxEntries) {
    panic("lintfilelines: ${dir} has ${len(names)} entries, over the ${maxEntries} bound")
  }
  let n = 0
  for name of names {
    let path = "${dir}/${name}"
    if (isDir(path)) {
      n = n + countBitFiles(path, depth - 1)
    } else if (hasSuffix(name, ".bit")) {
      n = n + 1
    }
  }
  return n
}

// Whether `names` (one directory's listing) marks that directory as a
// FIXTURE CORPUS, decided the identical way `_tests_/bit/filesize.bit`'s own
// `isFixtureCorpus` decides it: a directory holding at least one `.expected`
// file is a `.bit`/`.expected` pair corpus consumed by
// `test-checker-diag`/`test-parser`, not a harness `bit lint` can safely run
// over. A property, never a name list — see the header for why.
fn isFixtureCorpus(names: []string): bool {
  for name of names {
    if (hasSuffix(name, ".expected")) {
      return true
    }
  }
  return false
}

// Whether `dir` or anything beneath it (down to `depth` levels) is a fixture
// corpus. Used to decide, per subdirectory, whether it is safe to hand the
// WHOLE subdirectory to `bit lint` as one path — which matters beyond
// efficiency: a directory-wide `bit lint <path>` walk lets
// `lintDropModuleUsedImports` (compiler/lintmodule.bit) treat the whole
// directory as one module for E0210's cross-file "used by a sibling" check
// (#4228 — this used to be a per-file `swept` mark on compiler/lintbatch.bit's
// own LintFile, since removed). Passing files
// individually loses that, so this function exists to keep whole clean
// subdirectories intact and only decompose the ones that actually contain a
// fixture corpus.
fn hasFixtureCorpus(dir: string, depth: int): bool {
  if (depth <= 0) {
    panic("lintfilelines: ${dir} nesting exceeds ${maxScanDepth} levels")
  }
  let names = readDir(dir) catch e {
    panic("lintfilelines: cannot list ${dir}: ${e.message()}")
  }
  if (isFixtureCorpus(names)) {
    return true
  }
  for name of names {
    let path = "${dir}/${name}"
    if (isDir(path) && hasFixtureCorpus(path, depth - 1)) {
      return true
    }
  }
  return false
}

// What `collectLintTargets` (below) found: `paths` are the files/directories
// to hand `bit lint`, `files` is every `.bit` file visited (fixture-corpus
// ones included, matching `countBitFiles`'s definition of "visited"), and
// `skipped` is the subset that live inside a fixture corpus and were never
// linted.
class LintTargets { paths: []string, files: int, skipped: int }

// Walks `dir`'s own children (its listing `names` already read) and decides
// what to hand `bit lint`: a subdirectory that is itself a fixture corpus
// contributes nothing to `paths` (every `.bit` file beneath it is counted
// into both `files` and `skipped` via `collectLintTargets`); a clean
// subdirectory is kept as ONE path (see `hasFixtureCorpus`'s comment for
// why) and only decomposed by recursing when it itself contains a nested
// fixture corpus; a plain file is added individually. Shared by
// `collectLintTargets` (for a subdirectory, which IS tested for being a
// fixture corpus itself) and `collectRootTargets` (for the scan root, which
// is NEVER tested that way — see the header).
fn walkChildren(dir: string, names: []string, depth: int): LintTargets {
  let paths = []string(0)
  let files = 0
  let skipped = 0
  for name of names {
    let path = "${dir}/${name}"
    if (isDir(path)) {
      if (hasFixtureCorpus(path, depth - 1)) {
        let sub = collectLintTargets(path, depth - 1)
        for p of sub.paths {
          paths = append(paths, p)
        }
        files = files + sub.files
        skipped = skipped + sub.skipped
      } else {
        let n = countBitFiles(path, depth - 1)
        files = files + n
        if (n > 0) {
          paths = append(paths, path)
        }
      }
    } else if (hasSuffix(name, ".bit")) {
      paths = append(paths, path)
      files = files + 1
    }
  }
  return LintTargets{ paths = paths, files = files, skipped = skipped }
}

// Recursively decides what to hand `bit lint` for a SUBDIRECTORY `dir`: if
// `dir`'s own listing marks it a fixture corpus, every `.bit` file beneath it
// is skipped; otherwise its children are walked via `walkChildren`. Never
// called on the scan root itself — see `collectRootTargets`.
fn collectLintTargets(dir: string, depth: int): LintTargets {
  if (depth <= 0) {
    panic("lintfilelines: ${dir} nesting exceeds ${maxScanDepth} levels")
  }
  let names = readDir(dir) catch e {
    panic("lintfilelines: cannot list ${dir}: ${e.message()}")
  }
  if (len(names) > maxEntries) {
    panic("lintfilelines: ${dir} has ${len(names)} entries, over the ${maxEntries} bound")
  }
  if (isFixtureCorpus(names)) {
    let n = countBitFiles(dir, depth)
    return LintTargets{ paths = []string(0), files = n, skipped = n }
  }
  return walkChildren(dir, names, depth)
}

// The scan root's own entry point: reads `dir`'s listing and walks its
// children directly, WITHOUT ever asking whether `dir` itself is a fixture
// corpus (that is what #4100 fixed — see the header's "THE SCAN ROOT ITSELF"
// note). Only a subdirectory reached through `walkChildren` is ever tested
// that way, via `collectLintTargets`.
fn collectRootTargets(dir: string, depth: int): LintTargets {
  if (depth <= 0) {
    panic("lintfilelines: ${dir} nesting exceeds ${maxScanDepth} levels")
  }
  let names = readDir(dir) catch e {
    panic("lintfilelines: cannot list ${dir}: ${e.message()}")
  }
  if (len(names) > maxEntries) {
    panic("lintfilelines: ${dir} has ${len(names)} entries, over the ${maxEntries} bound")
  }
  return walkChildren(dir, names, depth)
}

// The entry point `scanOne` calls. The fixture-corpus exclusion is scoped to
// `_tests_/bit/` ONLY, by directory name, and deliberately so — NOT by asking
// generically "does this tree contain a `.expected` file anywhere", which
// was tried and is wrong: `_tests_/stress/` has an `.expected` file beside
// nearly every one of its ~90 subdirectories (each stress test's own
// expected-output oracle, a completely different convention from
// `_tests_/bit/checkercases/`'s deliberately-malformed lint fixtures), so that
// generic property would have silently excluded the entire tree this gate
// already covered before #2974 — the opposite of what it exists to prevent,
// caught by the mutation test below going the WRONG shade of green. Every
// other tree keeps the plain, unconditional single-path scan `bit lint
// <full>` has always used; `_tests_/bit/` is the one place the `.expected`
// property genuinely means "do not hand this to `bit lint`" — the same
// directory `filesize.bit`'s own `isFixtureCorpus` scans, and nowhere else.
// The root of `_tests_/bit/` itself is walked by `collectRootTargets`, never
// `collectLintTargets` — see the header's "THE SCAN ROOT ITSELF" note.
fn lintTargetsFor(dirName: string, full: string, depth: int): LintTargets {
  if (dirName != "_tests_/bit") {
    return LintTargets{ paths = [full], files = countBitFiles(full, depth), skipped = 0 }
  }
  return collectRootTargets(full, depth)
}

// One directory's full verdict: the independently walked file count plus
// `bit lint`'s own findings, folded together so `main` never handles the raw
// `Run` outside this file.
class DirScan { dir: string, files: int, skipped: int, findings: int, e0200: int, err: string }

fn teardown(dir: string, ms: int) {
  shell("${dir}/rm.sh", "#!/bin/sh\nrm -rf '${dir}'\n", ms) catch _ {
    return
  }
}

fn scanOne(bit: string, repo: string, dirName: string, ms: int): DirScan {
  let full = "${repo}/${dirName}"
  if (!exists(full)) {
    panic("lintfilelines: no such directory: ${full}")
  }
  let files = countBitFiles(full, maxScanDepth)
  if (files == 0) {
    panic("lintfilelines: ${full} contains zero .bit files — refusing a vacuous scan")
  }

  let targets = lintTargetsFor(dirName, full, maxScanDepth)
  if (targets.files != files) {
    panic("lintfilelines: ${full}: two independent walks disagree on the file count (${files} vs ${targets.files}) — refusing to trust either")
  }

  let tmp = envOr("TMPDIR", "/tmp")
  if (hasSuffix(tmp, "/")) {
    tmp = tmp[:len(tmp) - 1]
  }
  let capDir = "${tmp}/bit-lintfilelines-${uuidFormat(uuidV4())}"
  mkdir(capDir) catch e {
    panic("lintfilelines: cannot create ${capDir}: ${e.message()}")
  }
  // #3694: `exit()` does not run pending defers, but this `defer` is NOT an
  // instance of that bug. Its scope is THIS function's own frame, which
  // returns normally (both `return DirScan{...}` points below) on every
  // call, well before `main()`'s loop finishes and reaches its own
  // `exit(1)` -- so this defer always fires first, before `exit()` is ever
  // called. Verified empirically: forcing `main()`'s FAIL branch with this
  // file completely unmodified leaves no `bit-lintfilelines-<uuid>/`
  // directory behind (comm -13 on $TMPDIR listings, before/after, empty).
  // Left as `defer` deliberately -- converting to an explicit call here
  // would be a no-op with the same shape, not a fix.
  defer teardown(capDir, ms)

  if (len(targets.paths) == 0) {
    // Every `.bit` file under `full` lives inside a fixture corpus, so there
    // is nothing left to hand `bit lint` — not reachable today (every
    // scanned tree has at least one real harness alongside its fixtures),
    // but an empty path list must report zero findings explicitly rather
    // than let `bit lint` default to linting "." (its own no-args behavior)
    // and score the wrong tree entirely.
    return DirScan{
      dir = dirName,
      files = files,
      skipped = targets.skipped,
      findings = 0,
      e0200 = 0,
      err = "",
    }
  }

  let r = runLint(bit, targets.paths, capDir, ms) catch e {
    panic("lintfilelines: ${e.message()}")
  }
  assertTrustworthy(r, full, dirName)
  let (total, e0200) = countFindings(r.err)
  return DirScan{
    dir = dirName,
    files = files,
    skipped = targets.skipped,
    findings = total,
    e0200 = e0200,
    err = r.err,
  }
}

fn main() {
  let ms = timeoutMs()
  let bit = requiredEnv("BIT_SELF_EXE") catch e {
    panic("lintfilelines: ${e.message()}")
  }
  let repo = requiredEnv("BIT_REPO") catch e {
    panic("lintfilelines: ${e.message()}")
  }

  let dirs = [
    "compiler",
    "runtime",
    "stdlib",
    "_tests_/stress",
    "examples",
    "_tests_/bit",
    "_tests_/imports",
    "_tests_/cases",
  ]
  let totalFiles = 0
  let totalE0200 = 0
  let caseExempted = 0
  let anyFail = false
  for d of dirs {
    let sc = scanOne(bit, repo, d, ms)
    if (sc.skipped > 0) {
      println("lint-filelines: ${sc.dir}/: ${sc.files} of ${sc.files} .bit file(s) scanned, ${sc.skipped} skipped as fixture corpora, ${sc.findings} finding(s) (${sc.e0200} E0200)")
    } else {
      println("lint-filelines: ${sc.dir}/: ${sc.files} of ${sc.files} .bit file(s) scanned, ${sc.findings} finding(s) (${sc.e0200} E0200)")
    }
    totalFiles = totalFiles + sc.files
    if (d == "_tests_/cases") {
      // Named-exemption check instead of the plain "0 E0200" rule every
      // other directory gets — see caseExemptions() and the header.
      caseExempted = sc.e0200
      if (reportCaseVerdict(classifyCaseFindings(sc.err))) {
        anyFail = true
      }
      continue
    }
    totalE0200 = totalE0200 + sc.e0200
    if (sc.e0200 > 0) {
      anyFail = true
      eprint("FAIL: ${sc.e0200} warning[E0200] finding(s) in ${sc.dir}/ — each is a file over\n")
      eprint("the 800-line limit (spec/LINT.md §4). Split the file; do not raise the limit.\n")
      printE0200Findings(sc.err)
    }
  }
  if (anyFail) {
    eprint("FAIL: ${totalE0200} unnamed warning[E0200] finding(s) across ${totalFiles} .bit file(s)\n")
    eprint("scanned in compiler/ + runtime/ + stdlib/ + _tests_/stress/ + examples/ + _tests_/bit/ + _tests_/imports/ + _tests_/cases/.\n")
    exit(1)
  }
  println("lint-filelines: PASS — 0 unnamed E0200 findings across ${totalFiles} .bit file(s) scanned (${caseExempted} _tests_/cases/ finding(s) covered by a named exemption, see caseExemptions())")
  println("lint-filelines: scope is compiler/ + runtime/ + stdlib/ + _tests_/stress/ + examples/ + _tests_/bit/ + _tests_/imports/ + _tests_/cases/ — _tests_/bit/checkercases/ and _tests_/bit/parsercases/ are visited but not linted (fixture corpora, see header)")
}
