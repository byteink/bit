// _tests_/bit/clicmd/profcmd.bit — `bit prof <file.prof>` (#6241): the one
// property a `cases.bit` row cannot express, since every other case in this
// table checks a rejected/accepted flag shape against a hand-written
// fixture, never a profile `std/prof` itself wrote. `runProfChecks` below
// builds a real program that imports `std/prof`, samples it, and checks
// that `bit prof` renders the ring header and the sampled function's own
// name — proof `compiler/profrender.bit` (moved out of the standalone
// `tools/prof/render.bit` by this ticket) still reads what `stopCpu`
// actually writes, not a shape this file guesses.
//
// Needs `BIT_STDLIB` to build the fixture (`std/prof`'s own `import`), the
// one exception to this directory's "no fixture needs the stdlib"
// convention (`clicmd.bit`'s `makeFixtures` comment) — `gcretention.bit`
// (`_tests_/bit/gcretention.bit`) sets the identical precedent for the
// identical reason: export `BIT_STDLIB` inside the spawned build script
// rather than relying on whatever the parent process happened to inherit.
//
// `check`, `contains`, `env`, `exists`, `panic`, `runBit`, `shell`,
// `writeFile` are all bound module-wide by `clicmd.bit`; a second import or
// declaration here would be a redeclaration (E0042).

// The fixture program, byte-for-byte the `hotLoop`/`startCpu`/`stopCpu`
// example `docs/stdlib/prof.md` documents, with the output path taken as
// `argv[1]` (the predeclared `osArgAt`, no `std/os` import needed) so one
// build serves every scratch directory this gate runs under.
const profFixtureSrc: string = "import { startCpu, stopCpu } from \"std/prof\"\n" +
  "\n" +
  "fn hotLoop(n: int): int {\n" +
  "  let sum = 0\n" +
  "  let i = 0\n" +
  "  while (i < n) {\n" +
  "    sum = sum + i * i\n" +
  "    i = i + 1\n" +
  "  }\n" +
  "  return sum\n" +
  "}\n" +
  "\n" +
  "fn main(): ()! {\n" +
  "  startCpu(1000)\n" +
  "  let _ = hotLoop(2000000000)\n" +
  "  let _ = stopCpu(osArgAt(1))?\n" +
  "}\n"

// Writes and builds the fixture, `BIT_STDLIB` exported into the build
// script itself (never inherited from this process's own environment —
// see the file header). Returns the built binary's path.
fn profFixtureBuild(bit: string, stdlib: string, scratch: string, ms: int): string! {
  let src = "${scratch}/profcmd_fixture.bit"
  let prog = "${scratch}/profcmd_fixture"
  writeFile(src, profFixtureSrc)?
  let script = "#!/bin/sh\n" +
    "BIT_STDLIB='${stdlib}'\nexport BIT_STDLIB\n" +
    "'${bit}' build '${src}' -o '${prog}'\n"
  let code = shell("${scratch}/profcmd_build.sh", script, ms)?
  if (code != 0) {
    fail newError("bit prof fixture failed to build (exit ${code})")
  }
  return prog
}

// Runs the built fixture so it samples itself and writes a real profile;
// returns the profile's path.
fn profFixtureSample(prog: string, scratch: string, ms: int): string! {
  let profPath = "${scratch}/profcmd_fixture.prof"
  let script = "#!/bin/sh\n" + "'${prog}' '${profPath}'\n"
  let code = shell("${scratch}/profcmd_run.sh", script, ms)?
  if (code != 0) {
    fail newError("bit prof fixture failed to run (exit ${code})")
  }
  if (!exists(profPath)) {
    fail newError("bit prof fixture did not write ${profPath}")
  }
  return profPath
}

// `bit prof <file.prof>` end to end: build the fixture, sample it for
// real, render the profile it wrote with the compiler binary under test,
// and check the table header and the one function name the fixture is
// certain to have sampled (it does nothing else for two billion
// iterations).
fn runProfChecks(t: Tally, bit: string, scratch: string, capDir: string, ms: int) {
  let stdlib = env("BIT_STDLIB")
  if (len(stdlib) == 0) {
    panic("clicmd: BIT_STDLIB is unset — the `bit prof` fixture imports std/prof")
  }
  let prog = profFixtureBuild(bit, stdlib, scratch, ms) catch e {
    panic("clicmd: ${e.message()}")
  }
  let profPath = profFixtureSample(prog, scratch, ms) catch e {
    panic("clicmd: ${e.message()}")
  }
  let run = runBit(bit, scratch, capDir, "prof '${profPath}'", ms) catch e {
    panic("clicmd: ${e.message()}")
  }
  check(t, run.code == 0, "prof: bit prof <real profile> exits 0 (exited ${run.code}): ${run.err}")
  check(t, contains(run.out, "profile: "), "prof: table header present: ${run.out}")
  check(t, contains(run.out, "hotLoop"), "prof: known function name present: ${run.out}")
}
