// _tests_/bit/clicmd/projectlevel.bit — #3784: `bit check`, `bit fmt` and
// `bit test` with NO path operand at all, operating on the whole project.
//
// Sibling of `clicmd.bit`/`cases.bit` in the same directory module: no
// `import`, one shared scope. Reuses `Tally`/`check`/`runBit`/`mkdir`/
// `writeFile` from `clicmd.bit`'s own imports and helpers rather than
// re-deriving any of them; `clicmd.bit`'s `runAll` calls
// `runProjectLevelChecks` below.
//
// THE PROPERTY, in one sentence: with no operand, each verb anchors at the
// nearest `bit.json` (even from a subdirectory), walks the WHOLE project
// excluding `bit-out/` and `vendor/`, and prints its count — including the
// zero count — rather than a bare, unqualified success. AND an explicit path
// still walks a literal `vendor/` subdirectory exactly as it always has:
// #3784's skip list is opt-in, reached only through the no-operand path.

// One project fixture: a `bit.json`, a root module with no tests, two real
// test-bearing modules (`moda/` holds TWO `<name>.test.bit` siblings, proving
// several such files combine within one module; `_tests_/` is the other
// #3779-sanctioned location, still a plain `.test.bit` file inside it — a
// `_tests_/` directory is a module boundary, never a discovery marker on its
// own, #3786), and `bit-out/`/`vendor/` decoys that PANIC if ever built or
// run — the one thing a correct walk must never do. Every decoy is itself a
// `.test.bit` file: a plain `.bit` decoy would never be discovered as a test
// regardless of whether the walk reached it, which would make the "was it
// walked" assertions below pass vacuously rather than for the reason stated.
fn makeProjectLevelFixture(root: string): ()! {
  mkdir(root)?
  mkdir("${root}/moda")?
  mkdir("${root}/_tests_")?
  mkdir("${root}/sub")?
  mkdir("${root}/bit-out")?
  mkdir("${root}/bit-out/fakemod")?
  mkdir("${root}/vendor")?
  mkdir("${root}/vendor/fakemod")?
  writeFile("${root}/bit.json", "{\"name\":\"projectlevel\"}\n")?
  writeFile("${root}/main.bit", "fn main() { print(\"hi\\n\") }\n")?
  writeFile(
    "${root}/moda/moda.bit",
    "export fn double(x: int): int { return x * 2 }\n",
  )?
  writeFile(
    "${root}/moda/moda.test.bit",
      "fn test_double() {\n" +
      "  if (double(2) != 4) {\n" +
      "    panic(\"bad double\")\n" +
      "  }\n" +
      "}\n",
  )?
  writeFile(
    "${root}/moda/extra.bit",
    "export fn triple(x: int): int { return x * 3 }\n",
  )?
  writeFile(
    "${root}/moda/extra.test.bit",
      "fn test_triple() {\n" +
      "  if (triple(2) != 6) {\n" +
      "    panic(\"bad triple\")\n" +
      "  }\n" +
      "}\n",
  )?
  writeFile(
    "${root}/_tests_/checks.test.bit",
      "fn test_in_tests_dir() {\n" +
      "  if (1 + 1 != 2) {\n" +
      "    panic(\"math broke\")\n" +
      "  }\n" +
      "}\n",
  )?
  writeFile(
    "${root}/bit-out/fakemod/fake.test.bit",
    "fn test_should_never_run() { panic(\"bit-out was walked\") }\n",
  )?
  writeFile(
    "${root}/vendor/fakemod/fake.test.bit",
    "fn test_should_never_run_vendor() { panic(\"vendor was walked\") }\n",
  )?
}

// The count of real `.bit` FILES the fixture holds, `bit-out`/`vendor`
// excluded: main.bit, moda.bit, moda.test.bit, extra.bit, extra.test.bit,
// checks.test.bit. Named once so every assertion below reads it rather than a
// bare literal that could drift from `makeProjectLevelFixture` unnoticed.
const projectLevelFileCount = 6

// The count of `.test.bit`-suffixed files among the six above — the ONLY
// convention `countConventionTestFiles` (projectcli.bit) or `isTestFunc`
// (testgen.bit, #3786) honors: moda.test.bit, extra.test.bit,
// checks.test.bit. main.bit/moda.bit/extra.bit are plain source, not tests.
const projectLevelTestFileCount = 3

// The three real tests: test_double, test_triple, test_in_tests_dir.
const projectLevelTestRunCount = 3

// The count of MODULE directories: the root (main.bit), moda/, _tests_/.
const projectLevelModuleCount = 3

fn runProjectLevelChecks(t: Tally, bit: string, scratch: string, capDir: string, ms: int): ()! {
  let root = "${scratch}/projectlevel"
  makeProjectLevelFixture(root)?

  // `bit fmt` with no operand, from the project root: every real file,
  // never the decoys.
  let fmtRoot = runBit(bit, root, capDir, "fmt --check", ms)?
  check(
    t, fmtRoot.code == 0,
    "projectlevel-fmt-root: exit ${fmtRoot.code}, want 0 (out=${fmtRoot.out} err=${fmtRoot.err})",
  )
  check(
    t, contains(fmtRoot.out, "${projectLevelFileCount} file"),
    "projectlevel-fmt-root: stdout lacks the file count: ${fmtRoot.out}",
  )

  // The SAME command from a subdirectory: the walk must anchor at the
  // `bit.json` above it, not at `sub/` itself (which holds no `.bit` files
  // and would report 0 if the anchor were wrong).
  let fmtSub = runBit(bit, "${root}/sub", capDir, "fmt --check", ms)?
  check(
    t, fmtSub.code == 0,
    "projectlevel-fmt-sub: exit ${fmtSub.code}, want 0 (out=${fmtSub.out} err=${fmtSub.err})",
  )
  check(
    t, contains(fmtSub.out, "${projectLevelFileCount} file"),
    "projectlevel-fmt-sub: stdout lacks the file count: ${fmtSub.out}",
  )

  // `bit check` with no operand: one module per real directory, decoys
  // excluded — `bit-out/fakemod` and `vendor/fakemod` would each add a
  // module (and `bit-out/fakemod/fake.test.bit` does not even parse as
  // anything meaningful to check, but the point is it must never be OPENED
  // at all).
  let checkRoot = runBit(bit, root, capDir, "check", ms)?
  check(
    t, checkRoot.code == 0,
    "projectlevel-check-root: exit ${checkRoot.code}, want 0 (out=${checkRoot.out} err=${checkRoot.err})",
  )
  check(
    t, contains(checkRoot.out, "${projectLevelModuleCount} module"),
    "projectlevel-check-root: stdout lacks the module count: ${checkRoot.out}",
  )

  // `bit test` with no operand: both #3779 conventions found and run, the
  // decoys never executed (their panic text must appear on NEITHER stream).
  let testRoot = runBit(bit, root, capDir, "test", ms)?
  check(
    t, testRoot.code == 0,
    "projectlevel-test-root: exit ${testRoot.code}, want 0 (out=${testRoot.out} err=${testRoot.err})",
  )
  check(
    t, contains(
      testRoot.out,
      "${projectLevelTestFileCount} test file(s) found, ${projectLevelTestRunCount} test(s) run",
    ),
    "projectlevel-test-root: stdout lacks the found/run summary: ${testRoot.out}",
  )
  check(
    t, !contains(testRoot.out, "was walked") && !contains(testRoot.err, "was walked"),
    "projectlevel-test-root: a decoy under bit-out/ or vendor/ was executed (out=${testRoot.out} err=${testRoot.err})",
  )

  runProjectLevelExplicitPathCheck(t, bit, scratch, capDir, ms)?
  runProjectLevelZeroChecks(t, bit, scratch, capDir, ms)?
}

// THE CONSTRAINT #3784 MUST NOT VIOLATE: an EXPLICIT path still walks a
// literal `vendor/` subdirectory exactly as it always has — #3784's skip
// list is opt-in, reached only through the no-operand path
// (`runProjectLevelChecks` above). `bit test <root>` (the operand given
// explicitly) must still find and run the `vendor/fakemod` decoy's
// panicking test, proving the pre-#3784 walk is untouched.
fn runProjectLevelExplicitPathCheck(
  t: Tally,
  bit: string,
  scratch: string,
  capDir: string,
  ms: int,
): ()! {
  let explicitPath = runBit(bit, scratch, capDir, "test projectlevel", ms)?
  check(
    t, explicitPath.code != 0,
    "projectlevel-explicit-path-vendor: exit ${explicitPath.code}, want nonzero (a vendor/ decoy must still run)",
  )
  check(
    t, contains(explicitPath.out, "vendor was walked") ||
      contains(explicitPath.err, "vendor was walked"),
    "projectlevel-explicit-path-vendor: an EXPLICIT `bit test <dir>` stopped walking vendor/ — that is a behaviour change #3784 must not make (out=${explicitPath.out} err=${explicitPath.err})",
  )
}

// The zero-population half: a project with real modules but no tests must
// still name both zeros, never a bare "ok" — and a project with NO `.bit`
// source at all still names its own zero for `check`/`fmt`, which have no
// build to fail on the way there (`bit test`'s equivalent, a `buildIr`
// refusal, is exercised by `missingInputCases`/`entryPointCases`
// (cases.bit) already and is not this ticket's discovery rule to re-test).
fn runProjectLevelZeroChecks(t: Tally, bit: string, scratch: string, capDir: string, ms: int): ()! {
  let zero = "${scratch}/projectlevelzero"
  mkdir(zero)?
  writeFile("${zero}/bit.json", "{\"name\":\"zero\"}\n")?
  writeFile("${zero}/main.bit", "fn main() { print(\"hi\\n\") }\n")?

  let zt = runBit(bit, zero, capDir, "test", ms)?
  check(
    t, zt.code == 0,
    "projectlevel-zero-test: exit ${zt.code}, want 0 (out=${zt.out} err=${zt.err})",
  )
  check(
    t, contains(zt.out, "0 test file(s) found, 0 test(s) run"),
    "projectlevel-zero-test: stdout lacks the explicit zero: ${zt.out}",
  )

  let empty = "${scratch}/projectlevelempty"
  mkdir(empty)?
  writeFile("${empty}/bit.json", "{\"name\":\"empty\"}\n")?

  let ec = runBit(bit, empty, capDir, "check", ms)?
  check(
    t, ec.code == 0,
    "projectlevel-empty-check: exit ${ec.code}, want 0 (out=${ec.out} err=${ec.err})",
  )
  check(
    t, contains(ec.out, "0 module"),
    "projectlevel-empty-check: stdout lacks the explicit zero: ${ec.out}",
  )

  let ef = runBit(bit, empty, capDir, "fmt", ms)?
  check(
    t, ef.code == 0,
    "projectlevel-empty-fmt: exit ${ef.code}, want 0 (out=${ef.out} err=${ef.err})",
  )
  check(
    t, contains(ef.out, "0 file"),
    "projectlevel-empty-fmt: stdout lacks the explicit zero: ${ef.out}",
  )
}
