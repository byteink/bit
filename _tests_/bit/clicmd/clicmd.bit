// The CLI's argv contract (#2107), the sibling of `_tests_/bit/lintcmd/lintcmd.bit` and
// `_tests_/bit/runcmd.bit` for the layer above every subcommand.
//
// THE PROPERTY, in one sentence: a flag no subcommand declares is REFUSED with
// a diagnostic on stderr and exit 2, and a flag one does declare is still
// accepted — so "bit does not understand that" can never be mistaken for
// "bit looked and found nothing wrong".
//
// THE DEFECT THIS REMOVES, which shipped in every release up to 0.1.8:
//
//     $ bit check --version <module-with-a-type-error> ; echo $?
//     0
//
// No output, no warning, exit 0. `--version` was consumed as the module PATH,
// the loader found no source under it, no diagnostic was produced, and the exit
// code reported success. `--bogus` and `-x` did the same. `bit check` is the
// command a CI pipeline runs to decide whether a tree is sound, so a stray or
// future-dated flag turned the whole gate green over zero files — strictly
// worse than a crash, because the exit code actively lies.
//
// WHY THE ACCEPTANCE CASES ARE NOT DECORATION. A front end that refused
// EVERYTHING flag-shaped would satisfy every rejection case above and break the
// compiler. So each rejection is paired with a flag the same subcommand really
// takes, and `build -o -weird` specifically covers the value-skipping branch:
// an output path that itself begins with `-` is a value, not a flag.
//
// Run it from the repository root:
//     ./bit-out/bin/bit run _tests_/bit/clicmd
// `BIT_SELF_EXE` overrides which `bit` is exercised; unset, the compiler
// under test is `<cwd>/bit-out/bin/bit`, resolved from a child's own `pwd`,
// not `std/fs`'s `cwd()` (#3502 — same independence reason as
// `_tests_/bit/rootnamecollision.bit`'s `resolveCwd`). `selfExe()` here is
// the throwaway binary `bit run` built, not the compiler that built it.
//
// #2867 phase 2 split this file into `_tests_/bit/clicmd/{clicmd,cases}.bit`:
// every named `Case` table that runs through the generic `runCase` loop below
// now lives in the sibling `cases.bit`, no `import`, one shared scope. This
// file dropped from 952 to 566 lines and kept the fixtures, the `bit`-running
// machinery, the two tables that need a bespoke runner, and `main`.
import { env, envOr, exit } from "std/os"
import { exists, mkdir, readFile, remove, writeFile } from "std/fs"
import { contains, parseInt } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// One `bit` invocation, as seen from outside it.
class Run { code: int, out: string, err: string }

// Assertion accounting. A class because Bit has no mutable module-level
// state, and the count is the anti-vacuity marker.
class Tally { checks: int, failures: int }

// One row of the table below. `argv` is appended verbatim to the binary, so
// every operand it names is written relative to the fixture tree the child
// `cd`s into. An empty `wantErrSub`/`wantOutSub`/`absent` is "no requirement".
class Case {
  name: string,
  argv: string,
  wantExit: int,
  wantErrSub: string,
  wantOutSub: string,
  absent: string,
}

// How long any one child gets. Every case below compiles a two-line program at
// most, so this only fires on a hang — and a hang is a failure, not a stall.
fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "300")) catch _ {
    300
  }
  if (s <= 0) {
    return 300000
  }
  return s * 1000
}

// Runs `script` through /bin/sh and returns its exit code. Negative returns are
// `osRunBounded`'s mechanism channel, never a program exit status, so each one
// is a named panic rather than a value any assertion could consume.
fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    fail newError("clicmd: cannot make script executable: ${scriptPath}")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == -2) {
    panic("clicmd: TIMED OUT after ${ms}ms running ${scriptPath}")
  }
  if (code == -1) {
    panic("clicmd: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("clicmd: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}

// This repository's own root, discovered the same way
// _tests_/bit/rootnamecollision.bit and _tests_/bit/externunresolvable.bit do
// (see rootnamecollision.bit's own comment for why a child's own `pwd` is
// used instead of `std/fs`'s `cwd()`, #3502). Split out of `bitBinary`
// (#2836) because the `--run` filter fixture lives at a path relative to
// this root, not inside the scratch fixture tree `runBit` `cd`s into, and
// needs the root regardless of whether `BIT_SELF_EXE` is set.
fn resolveCwd(scratch: string, ms: int): string! {
  let cwdFile = "${scratch}/cwd.txt"
  let code = shell("${scratch}/pwd.sh", "#!/bin/sh\npwd > '${cwdFile}'\n", ms)?
  if (code != 0) {
    fail newError("clicmd: could not read the working directory (exit ${code})")
  }
  return trimWs(readFile(cwdFile)?)
}

// The `bit` under test. `BIT_SELF_EXE` wins; otherwise `${cwd}/bit-out/bin/bit`
// — never returns "" — a compiler this cannot find is a hard stop, not a
// skipped test.
fn bitBinary(cwd: string): string! {
  let explicit = env("BIT_SELF_EXE")
  if (len(explicit) > 0) {
    if (!exists(explicit)) {
      fail newError("clicmd: BIT_SELF_EXE=${explicit} does not exist")
    }
    return explicit
  }
  let candidate = "${cwd}/bit-out/bin/bit"
  if (!exists(candidate)) {
    fail newError("clicmd: no compiler at ${candidate}; run this from the repository root or set BIT_SELF_EXE")
  }
  return candidate
}

// The fixture tree every case runs inside. `bad/` is a module the checker
// rejects — the whole point of #2107 is that `bit check` must keep rejecting it
// no matter what precedes the path, and must never report success instead.
//
// The rest exist to separate the four situations #2394/#2234 used to conflate.
// Each one is a DIFFERENT answer, so a guard that collapses any two of them
// fails here rather than in a user's CI log:
//   empty/       a directory that exists and holds nothing
//   nosrc/       a directory that exists and holds no BIT source
//   nomain.bit   a file that exists and defines no entry point
//   nomaindir/   a module that loads and defines no entry point
//   docexports/  a module that loads and exports one declaration
//   parsebad.bit a file whose front end reports something (--dump-diags)
// `nosuchdir` and `nosuch.bit` are deliberately NEVER created.
//
// `rec/` is #2247's fixture: a root module importing `./mathx`, each with its
// own test. `mathx.test.bit` asserts something false ON PURPOSE, so `bit test
// rec` has exactly one way to be right — name it and exit non-zero — and one
// way to be the bug this ticket is about: report only "root", exit 0.
// No `std/testing` import (plain `panic`, like every other fixture here):
// the harness never sets `BIT_STDLIB`, so a fixture that needed the stdlib
// would fail for a reason unrelated to what it is testing.
fn makeFixtures(root: string): ()! {
  mkdir(root)?
  mkdir("${root}/bad")?
  mkdir("${root}/good")?
  mkdir("${root}/empty")?
  mkdir("${root}/nosrc")?
  mkdir("${root}/nomaindir")?
  mkdir("${root}/docexports")?
  mkdir("${root}/docbadmanifest")?
  writeFile("${root}/bad/main.bit", "fn main() { let x: int = \"oops\" }\n")?
  writeFile("${root}/good/main.bit", "fn main() { print(\"ok\\n\") }\n")?
  writeFile("${root}/ok.bit", "fn main() { print(\"ok\\n\") }\n")?
  // #2399's fixture: prints `argc=<n>` then one `[<i>]=<value>` line per
  // argument, via the PREDECLARED `osArgc`/`osArgAt` rather than `std/os`'s
  // `args()` — no import needed, matching every other fixture here (this
  // harness never sets `BIT_STDLIB`). `\$` escapes so `${n}`/`${i}`/
  // `${osArgAt(i)}` survive as literal interpolation in the GENERATED
  // program rather than being interpolated by THIS file's own compiler.
  writeFile(
    "${root}/echoargs.bit",
      "fn main() {\n" +
      "  let n = osArgc()\n" +
      "  print(\"argc=\${n}\\n\")\n" +
      "  let i = 0\n" +
      "  while (i < n) {\n" +
      "    print(\"[\${i}]=\${osArgAt(i)}\\n\")\n" +
      "    i = i + 1\n" +
      "  }\n" +
      "}\n",
  )?
  // #2491's fixture: shadows the predeclared `len`, and nothing else is wrong —
  // the only way to reach `reportCheckDiagnostics`'s warnings-only branch
  // instead of the render-on-error branch every other fixture here exercises.
  // NOT exported (#3417): #3383 exempts an EXPORTED module-scope declaration
  // whose name is one of SPEC §5.3's documented predeclared functions
  // (`specDocumentedFuncs()`, compiler/symbols.bit) — `len` is in that list, so
  // the original `export fn len` fixture stopped drawing E0048 by design,
  // silently un-exercising the warnings-only branch this case exists to cover.
  // A non-exported `fn len` is outside that exemption (rModuleShadowExempt only
  // reads it when `s.exported`) and still shadows the predeclared `len`.
  writeFile(
    "${root}/shadow.bit",
    "fn len(s: string): int { return 0 }\nfn main() { print(\"ok\\n\") }\n",
  )?
  makeRawInterpFixtures(root)?
  writeFile("${root}/nosrc/README.md", "not Bit source\n")?
  writeFile("${root}/nomain.bit", "fn greet(): string {\n  return \"hi\"\n}\n")?
  writeFile("${root}/nomaindir/lib.bit", "fn greet(): string {\n  return \"hi\"\n}\n")?
  // #2411's real-export fixture, distinct from `nomaindir` above by exactly
  // the one keyword the bug conflated: this module has real Bit source AND a
  // public surface, so `bit doc` must keep printing it rather than being
  // folded into the "no .bit source files" refusal.
  writeFile("${root}/docexports/lib.bit", "export fn greet(): string {\n  return \"hi\"\n}\n")?
  // #2828's fixture: a `bit.json` that is not even JSON, beside a module with
  // a real exported surface. `bit doc` must refuse this the same way
  // `checkCmd`/`buildIr` already do for `bit check`/`build`/`run` (#2254) —
  // naming `bit.json` and exiting non-zero — rather than documenting `greet`
  // as if the manifest were never there.
  writeFile("${root}/docbadmanifest/bit.json", "not json at all\n")?
  writeFile("${root}/docbadmanifest/lib.bit", "export fn greet(): string {\n  return \"hi\"\n}\n")?
  writeFile("${root}/parsebad.bit", "fn main() { let x = @ }\n")?
  makeRecursiveTestFixture(root)?
}

// #3009's raw-string interpolation fixtures, split out of `makeFixtures`
// (#3814, E0201: the combined function was 112 lines against an 80 limit).
// A raw string commonly holds the exact double-quoted interpolation syntax
// by mistake — `` `${1 + 2}` `` is literal text per spec/SPEC.md:245, not
// interpolation. `rawinterp_warn.bit` has a well-formed `${` ... `}` pair
// and must draw E0098; the other three hold exactly the content a raw
// string legitimately exists for — a bare `$`, a `$foo` shell variable, and
// an unmatched `${` — and must stay silent (`\$` here escapes THIS file's
// own interpolation so the generated program's `${`/`$` survive literally,
// same convention `echoargs.bit` above uses).
fn makeRawInterpFixtures(root: string): ()! {
  writeFile(
    "${root}/rawinterp_warn.bit",
    "fn main() {\n" + "  println(`The sum is \${1 + 2}`)\n" + "}\n",
  )?
  writeFile(
    "${root}/rawinterp_dollar.bit",
    "fn main() {\n" + "  println(`price is \$5`)\n" + "}\n",
  )?
  writeFile(
    "${root}/rawinterp_var.bit",
    "fn main() {\n" + "  println(`echo \$foo`)\n" + "}\n",
  )?
  writeFile(
    "${root}/rawinterp_unmatched.bit",
    "fn main() {\n" + "  println(`\${unterminated brace`)\n" + "}\n",
  )?
}

// The recursive-test-discovery fixture (`bit test`'s recursive walk into
// `rec/mathx/`), split out of `makeFixtures` (#3814, same E0201 as above).
fn makeRecursiveTestFixture(root: string): ()! {
  mkdir("${root}/rec")?
  mkdir("${root}/rec/mathx")?
  writeFile(
    "${root}/rec/root.bit",
      "import { clamp } from \"./mathx\"\n" +
      "export fn clampScore(n: int): int { return clamp(n, 0, 100) }\n",
  )?
  writeFile(
    "${root}/rec/root.test.bit",
      "test \"root\" {\n" +
      "  if (clampScore(150) != 100) { panic(\"clamped: wrong value\") }\n" +
      "}\n",
  )?
  writeFile(
    "${root}/rec/mathx/mathx.bit",
      "export fn clamp(v: int, lo: int, hi: int): int {\n" +
      "  if (v < lo) { return lo }\n" +
      "  if (v > hi) { return hi }\n" +
      "  return v\n" +
      "}\n",
  )?
  writeFile(
    "${root}/rec/mathx/mathx.test.bit",
      "test \"clamp is deliberately broken\" {\n" +
      "  if (clamp(5, 0, 10) != 999) { panic(\"deliberately broken: got 5, want 999\") }\n" +
      "}\n",
  )?
}

// #2489's fixture: `bit test`'s recursive walk (`compiler/testrun.bit`) must
// never descend through a symbolic link, the same contract #2152 settled for
// `std/fs.walk`. Creating a symbolic link is not something Bit can express —
// `std/fs` has no `symlink` — so both links here come from a shell script run
// through `shell()`/`osRunBounded`, the same shape `_tests_/cases/fs_walk_symlink.bit`
// uses.
//
// `symlinkwalk/` holds exactly one real module (`lib.bit`/`lib.test.bit`, a
// test that always passes) plus two links a correct walk never opens:
//   escape -> `${root}-outside`, a directory OUTSIDE the walk root holding a
//             test that panics unconditionally if it is ever run — proof the
//             walk left `root`'s own subtree;
//   self   -> `symlinkwalk` itself — a self-referential link, proof the walk
//             cannot loop, rather than merely being stopped by
//             `maxTestWalkDepth` after wastefully re-finding its own module.
// Either link being followed adds a SECOND module beyond `symlinkwalk`'s own
// top level, which only `testProject` (never `testModule`) reports, printing
// `== <module path> ==` per module — so `bit test symlinkwalk` prints no `==`
// at all once neither link is followed, and does print one (plus a non-zero
// exit, from the escaped module's panic) if either regresses.
fn makeSymlinkFixtures(root: string, ms: int): ()! {
  mkdir("${root}/symlinkwalk")?
  mkdir("${root}-outside")?
  writeFile(
    "${root}/symlinkwalk/lib.bit",
    "export fn real(): int { return 42 }\n",
  )?
  writeFile(
    "${root}/symlinkwalk/lib.test.bit",
      "test \"symlinkwalk real\" {\n" +
      "  if (real() != 42) { panic(\"real module broken\") }\n" +
      "}\n",
  )?
  // NOT converted to `test "..." { }` — deliberately left in the shape
  // #3786's now-removed legacy rule discovered. This file must never be
  // OPENED at all (it lives outside the walk root, reachable only via the
  // symlink this fixture proves is not followed); if it ever is, it now
  // fails LOUDLY at compile time (E0117) as well as via the runtime panic
  // below, which is a strictly louder regression signal, not a weaker one.
  writeFile(
    "${root}-outside/outside.test.bit",
      "fn test_should_never_run_via_symlink() {\n" +
      "  panic(\"escaped the walk root via a symlink\")\n" +
      "}\n",
  )?
  let script = "#!/bin/sh\n" +
    "ln -s '${root}-outside' '${root}/symlinkwalk/escape' || exit 1\n" +
    "ln -s '${root}/symlinkwalk' '${root}/symlinkwalk/self' || exit 1\n"
  let code = shell("${root}-outside/setup.sh", script, ms)?
  if (code != 0) {
    fail newError("clicmd: cannot create the symlink fixtures (exit ${code})")
  }
}

// Runs `bit <argv>` with `root` as the working directory.
//
// The script always exits 0 and writes the real status to `code.txt`, so a
// missing `code.txt` is unmistakably "the run never happened" rather than a
// status some assertion could mistake for success.
fn runBit(bit: string, root: string, capDir: string, argv: string, ms: int): Run! {
  let outPath = "${capDir}/out.txt"
  let errPath = "${capDir}/err.txt"
  let codePath = "${capDir}/code.txt"
  clear(outPath)
  clear(errPath)
  clear(codePath)

  let script = "#!/bin/sh\n" +
    "cd '${root}' || exit 0\n" +
    "'${bit}' ${argv} > '${outPath}' 2> '${errPath}'\n" +
    "echo $? > '${codePath}'\n" +
    "exit 0\n"
  let sh = shell("${capDir}/run.sh", script, ms)?
  if (sh != 0) {
    fail newError("clicmd: wrapper script exited ${sh}, which it never should")
  }
  if (!exists(codePath)) {
    fail newError("clicmd: no exit code was recorded for `bit ${argv}` — the run never happened")
  }
  let code = parseInt(trimWs(readFile(codePath)?))?
  return Run{ code: code, out: readFile(outPath)?, err: readFile(errPath)? }
}

fn clear(path: string) {
  if (exists(path)) {
    remove(path) catch _ {
      return
    }
  }
}

// Records one assertion. Failures are named and the run continues, so a single
// invocation reports every broken expectation instead of only the first.
fn check(t: Tally, cond: bool, label: string) {
  t.checks = t.checks + 1
  if (!cond) {
    t.failures = t.failures + 1
    eprint("FAIL: ${label}\n")
  }
}

// THE REJECTIONS through THE WALK ESCAPING ITS ROOT — every table `runAll`
// folds into `cases` by a plain generic `runCase` — now live in the sibling
// `cases.bit` (#2867 phase 2). This file keeps `runDumpChecks` (further down),
// the one bespoke runner left here whose property — stdout-emptiness — a
// `Case` cannot express; the other, the exact-file assertion in
// `runBuildOutputChecks`, moved to the sibling `buildoutput.bit` (#3791) to
// keep this file under the 800-line ceiling.

// warningCases (#2491) — one more plain `Case` table, run through the generic
// `runCase` loop below — now lives in the sibling `cases.bit` (#2867 phase 2).

// One `--dump-*` surface: the flag, and an operand whose dump must land on
// stdout NON-EMPTY. `--dump-diags` prints nothing for a clean file by design, so
// its success operand is the one fixture with a parse error.
class Dump { flag: string, good: string }

// All six. Asserted to be six below: a surface dropped from this list is a
// surface that stops being gated, which is how the defect below survived.
fn dumpSurfaces(): []Dump {
  return [
    Dump{ flag: "--dump-tokens", good: "ok.bit" },
    Dump{ flag: "--dump-ast", good: "ok.bit" },
    Dump{ flag: "--dump-diags", good: "parsebad.bit" },
    Dump{ flag: "--dump-types", good: "ok.bit" },
    Dump{ flag: "--dump-ir", good: "ok.bit" },
    Dump{ flag: "--dump-ir-pre", good: "ok.bit" },
  ]
}

// THE DUMP SURFACES (#2396). Not rows in the table above, because the property
// includes "stdout is EMPTY" and a `Case` can only require a substring to be
// present or absent from BOTH streams — and which stream this lands on is the
// whole defect.
//
// All six printed `bit: cannot read <path>` to **stdout** and returned normally,
// so the process exited **0**. These six ARE `scripts/selfhost-diff*.sh`'s entry
// points: both compilers are handed the same path, so a path that had moved made
// both sides print the identical line on stdout, the diff came out empty, and
// the differential reported a PASS having compared nothing. A false green inside
// the harness family built to catch false greens.
//
// The success half is asserted for the same reason the acceptance cases above
// exist, and it is the load-bearing half here: a dump that reported the failure
// correctly but stopped writing to stdout, or started writing to stderr, would
// silently empty every differential in the family. Exit 0, stdout non-empty,
// stderr empty — that is the contract fifteen scripts consume.
fn runDumpChecks(t: Tally, bit: string, root: string, capDir: string, ms: int): ()! {
  let surfaces = dumpSurfaces()
  if (len(surfaces) < 6) {
    panic("clicmd: only ${len(surfaces)} dump surfaces, want 6")
  }
  for d of surfaces {
    // `nosuch.bit` is never created by makeFixtures.
    let miss = runBit(bit, root, capDir, "${d.flag} nosuch.bit", ms)?
    check(
      t, miss.code == 1,
      "${d.flag} <missing>: exit ${miss.code}, want 1 (out=${miss.out} err=${miss.err})",
    )
    check(
      t, contains(miss.err, "cannot read"),
      "${d.flag} <missing>: stderr lacks \"cannot read\": ${miss.err}",
    )
    check(
      t, len(miss.out) == 0,
      "${d.flag} <missing>: stdout must be EMPTY or a differential compares two copies of it: ${miss.out}",
    )

    let ok = runBit(bit, root, capDir, "${d.flag} ${d.good}", ms)?
    check(
      t, ok.code == 0,
      "${d.flag} ${d.good}: exit ${ok.code}, want 0 (err=${ok.err})",
    )
    check(
      t, len(ok.out) > 0,
      "${d.flag} ${d.good}: stdout must carry the dump, got nothing",
    )
    check(
      t, len(ok.err) == 0,
      "${d.flag} ${d.good}: stderr must be empty, got: ${ok.err}",
    )
  }
}

// Runs one case and records every assertion it carries. `root`/`capDir` are
// re-derived from `scratch` rather than taken as two more params (#3814,
// E0202: this was 6 params against a limit of 5) — the same derivation
// `runCases` below already uses for its own fixture paths.
fn runCase(t: Tally, bit: string, scratch: string, c: Case, ms: int): ()! {
  let root = "${scratch}/tree"
  let capDir = "${scratch}/cap"
  let r = runBit(bit, root, capDir, c.argv, ms)?
  check(
    t, r.code == c.wantExit,
    "${c.name}: `bit ${c.argv}` exit ${r.code}, want ${c.wantExit} (out=${r.out} err=${r.err})",
  )
  if (len(c.wantErrSub) > 0) {
    check(
      t, contains(r.err, c.wantErrSub),
      "${c.name}: stderr lacks \"${c.wantErrSub}\": ${r.err}",
    )
  }
  if (len(c.wantOutSub) > 0) {
    check(
      t, contains(r.out, c.wantOutSub),
      "${c.name}: stdout lacks \"${c.wantOutSub}\": ${r.out}",
    )
  }
  if (len(c.absent) > 0) {
    check(
      t, !contains(r.out, c.absent) && !contains(r.err, c.absent),
      "${c.name}: \"${c.absent}\" must appear on neither stream (out=${r.out} err=${r.err})",
    )
  }
}

// Every group of cases `runAll` assembles, in the same order the old flat
// sequence of `for c of Xcases() { cases = append(cases, c) }` loops did —
// each element is already the fully-built `[]Case` (calling `Xcases()` has
// no side effect worth deferring), so flattening below is one nested loop
// instead of one loop per group (#3791: that flat sequence was most of
// `runAll`'s own complexity, split out here to get under this repo's E0204
// ceiling, spec/LINT.md).
fn caseGroups(cwd: string, ms: int): [][]Case {
  return [
    rejectCases(),
    acceptCases(),
    helpCases(),
    surplusCases(),
    runForwardCases(),
    buildFlagValidationCases(),
    missingInputCases(),
    missingDocWhyCases(),
    entryPointCases(),
    recursiveTestCases(ms),
    runFilterCases(cwd, ms),
    testDeclCases(cwd, ms),
    warningCases(),
    rawInterpWarningCases(),
    symlinkWalkCases(ms),
  ]
}

// The flattened case table `runAll` runs, plus the floor that makes an
// empty or shortened table a hard failure rather than a green run that
// proved nothing.
fn assembleCases(cwd: string, ms: int): []Case {
  let cases = []Case(0)
  for group of caseGroups(cwd, ms) {
    for c of group {
      cases = append(cases, c)
    }
  }
  if (len(cases) < 100) {
    panic("clicmd: only ${len(cases)} cases in the table, want at least 100")
  }
  return cases
}

// Every table-driven case, plus the bespoke runners whose property a plain
// `Case` cannot express. `root`/`capDir` are re-derived from `scratch`
// rather than threaded through as two more params — `runAll` computes the
// identical two strings for its own fixture setup, and passing all five
// would put this at 7 params (E0202's limit is 5).
fn runCases(t: Tally, bit: string, scratch: string, cases: []Case, ms: int) {
  let root = "${scratch}/tree"
  let capDir = "${scratch}/cap"
  for c of cases {
    runCase(t, bit, scratch, c, ms) catch e {
      panic("clicmd: ${e.message()}")
    }
  }
  // The six `--dump-*` surfaces, whose property the table cannot express.
  runDumpChecks(t, bit, root, capDir, ms) catch e {
    panic("clicmd: ${e.message()}")
  }
  // The build output location (#2260's directory rule, #2746's file and
  // explicit-`-o` rows), whose property — "and this exact file now exists" —
  // a plain `Case` cannot express either.
  runBuildOutputChecks(t, bit, scratch, capDir, ms) catch e {
    panic("clicmd: ${e.message()}")
  }
  // #3784's whole-project `bit check`/`bit fmt`/`bit test` (no operand):
  // its own fixture tree (bit.json anchor, bit-out/vendor decoys), so it
  // lives in the sibling `projectlevel.bit` rather than growing this table.
  runProjectLevelChecks(t, bit, scratch, capDir, ms) catch e {
    panic("clicmd: ${e.message()}")
  }
  // #3502's `bit init` default-name-from-directory-basename rule: several
  // rows need their OWN cwd (not the shared `root` above) and a two-step
  // init-then-add flow a plain `Case` can't express, so it lives in the
  // sibling `initcmd.bit`.
  runInitChecks(t, bit, scratch, capDir, ms) catch e {
    panic("clicmd: ${e.message()}")
  }
}

// Every case, against fixtures built fresh under `scratch`.
fn runAll(t: Tally, scratch: string, ms: int) {
  let root = "${scratch}/tree"
  let capDir = "${scratch}/cap"
  mkdir(capDir) catch e {
    panic("clicmd: cannot create ${capDir}: ${e.message()}")
  }
  let cwd = resolveCwd(scratch, ms) catch e {
    panic("clicmd: ${e.message()}")
  }
  let bit = bitBinary(cwd) catch e {
    panic("clicmd: ${e.message()}")
  }
  makeFixtures(root) catch e {
    panic("clicmd: cannot build the fixtures: ${e.message()}")
  }
  makeSymlinkFixtures(root, ms) catch e {
    panic("clicmd: cannot build the symlink fixtures: ${e.message()}")
  }
  let cases = assembleCases(cwd, ms)
  runCases(t, bit, scratch, cases, ms)
}

fn main() {
  let ms = timeoutMs()
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  let scratch = "${tmp}/bit-clicmd-${uuidFormat(uuidV4())}"
  let t = Tally{ checks: 0, failures: 0 }

  mkdir(scratch) catch e {
    panic("clicmd: cannot create ${scratch}: ${e.message()}")
  }
  // `exit()` does not run pending defers (documented on `std/os.exit`
  // itself, #3677) — a `defer teardown(scratch, ms)` registered above
  // this branch would never fire here, leaking `scratch` under $TMPDIR
  // on every failing run. Call it explicitly on both paths instead.
  runAll(t, scratch, ms)

  // The run marker: every case asserts at least its exit code, so the floor is
  // one per case. A case that stops running is visible rather than green.
  if (t.checks < 325) {
    eprint("FAIL: only ${t.checks} checks ran, want at least 325\n")
    t.failures = t.failures + 1
  }
  if (t.failures > 0) {
    teardown(scratch, ms)
    println("clicmd: FAIL — ${t.failures} of ${t.checks} checks failed")
    exit(1)
  }
  teardown(scratch, ms)
  println("clicmd: PASS — ${t.checks} checks")
}

// std/fs has no recursive remove, so the scratch tree goes the way it came.
fn teardown(scratch: string, ms: int) {
  shell("${scratch}/rm.sh", "#!/bin/sh\nrm -rf '${scratch}'\n", ms) catch _ {
    return
  }
}

// `std/strings`' `trimSpace` stops at spaces and tabs, and every capture here
// arrives newline-terminated from a shell redirect.
fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}
