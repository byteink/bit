// _tests_/bit/clicmd/casestest.bit — the `bit test` discovery/filter/decl/
// symlink-walk case tables, plus the check/run warning-rendering tables that
// trail them, split out of cases.bit under #5604 (spec/LINT.md:186's
// 800-line E0200 limit; cases.bit formatted to 910). A pure move: every
// declaration below is byte-identical to what cases.bit carried, chosen as
// the back half of its function list rather than by theme (`warningCases`/
// `rawInterpWarningCases` are `check`/`run`, not `test`) since the only
// property that matters is line count. A directory module (clicmd.bit's own
// `caseGroups` already calls every function below by name, unchanged), so
// no import is needed for either side — the same shape
// lintcmd/lintcmdchecks.bit already uses (#4308).

// RECURSIVE DISCOVERY (#2247). `bit test rec` used to build and run only
// `rec`'s own tests, never `./mathx`'s — so the DELIBERATELY BROKEN
// assertion in `rec/mathx/mathx.test.bit` sat in the tree while the parent
// run printed `1 test: 1 passed, 0 failed` and exited 0. Both of those
// exact symptoms are asserted directly: `wantExit: 1` (the bug reports 0)
// and `wantOutSub` naming the sub-module's failing test (the bug's stdout
// never mentions it — "clamp is deliberately broken" cannot appear on a
// run that never built `mathx`). Together they leave no passing reading
// under the old behaviour; `absent` is not needed on top of them, and the
// obvious candidate — the bug's exact combined line — is also the correct
// PER-MODULE summary `rec`'s own passing test still prints today, so
// asserting it absent would fail on the fix, not the bug.
//
// `test-recursive-child` is not new behaviour — `bit test rec/mathx` alone
// already found this failure before #2247 — but it is asserted here anyway,
// against the SAME fixture the parent row uses, as the control: if this one
// ever went green the fixture itself would be broken, not the feature.
//
// `--timeout ${ms / 1000}` (#3685): both rows actually dispatch a test
// process through `bit test`'s OWN per-test bound (compiler/testrun.bit's
// `defaultTestTimeoutMs`, 30000ms), which knows nothing about this harness's
// `BIT_TEST_TIMEOUT_S` — so under fleet load the compiler's small, load-blind
// default fired before this harness's own generous, configurable `ms` ever
// got a say. Passing the flag explicitly ties the inner bound to the same
// knob the outer wrapper already honors, rather than leaving it stuck at a
// constant sized for a quiet box.
fn recursiveTestCases(ms: int): []Case {
  return [
    Case{
      name = "test-recursive-parent", argv = "test rec --timeout ${ms / 1000}", wantExit = 1,
      wantErrSub = "", wantOutSub = "clamp is deliberately broken", absent = "",
    },
    Case{
      name = "test-recursive-child", argv = "test rec/mathx --timeout ${ms / 1000}", wantExit = 1,
      wantErrSub = "", wantOutSub = "clamp is deliberately broken", absent = "",
    },
  ]
}

// THE `--run <pattern>` FILTER (#2834, gated here by #2836). Drives the
// three-test fixture at `_tests_/bit/testrunfilter/f.test.bit` (its tests
// migrated by #4131 onto sentence names containing "alpha"/"beta"/"gamma" as
// substrings) through the built compiler, by absolute path — `cwd` is this
// repository's own root, not the scratch fixture tree `runCase` otherwise
// `cd`s into, since the fixture lives in the source tree and #2836's ticket
// says to use it rather than write another.
//
// A pattern that matches names the run; `absent: "beta"` is what a
// regression toward "the filter is ignored" would print (the fixture's other
// test running too) that a bare exit-code/summary check would miss. A
// pattern that matches nothing is the error path #2834 added: exit 1 and
// `bit test: no test matched --run <pattern>` on stderr, never a silent
// zero-test pass.
// `--timeout ${ms / 1000}` on the one row below that actually dispatches a
// test (#3685): same reason as `recursiveTestCases` above — a matched
// `--run` reaches `bit test`'s own per-test bound, which does not read this
// harness's `BIT_TEST_TIMEOUT_S`. The other two rows never get past argument
// parsing or the no-match error path, so neither spawns a test process and
// neither needs the flag.
fn runFilterCases(cwd: string, ms: int): []Case {
  let fixture = "${cwd}/_tests_/bit/testrunfilter/f.test.bit"
  return [
    Case{
      name = "test-run-filter-match", argv = "test ${fixture} --run alpha --timeout ${ms / 1000}",
      wantExit = 0, wantErrSub = "",
      wantOutSub = "discovered 3 tests, ran 1: 1 passed, 0 failed", absent = "beta",
    },
    Case{
      name = "test-run-filter-no-match", argv = "test ${fixture} --run zzz",
      wantExit = 1, wantErrSub = "bit test: no test matched --run zzz",
      wantOutSub = "", absent = "",
    },
    Case{
      name = "test-run-filter-no-value", argv = "test ${fixture} --run",
      wantExit = 2, wantErrSub = "bit test: --run needs a pattern",
      wantOutSub = "", absent = "",
    },
  ]
}

// `test "name" { }` DISCOVERY (#4128, SPEC §19, epic #4126). Drives the
// two-case fixture at `_tests_/bit/testdecl/isolation.test.bit` — the FIRST
// test panicking deliberately (isolation) and the SECOND named with an
// embedded space (only possible to match via the display STRING, never a
// call symbol). Every row spawns at least one test process, so every row
// needs `--timeout` for the same reason `runFilterCases` above does.
//
// Renamed from `mixed.test.bit`/`test-decl-mixed-*` by #4148: the fixture
// used to ALSO prove a legacy shape-discovered `fn` was discovered from the
// same file as a `test "..." { }` declaration. #4148 removed that form
// entirely — see `_tests_/bit/checkercases/check_bare_fn_test_shape.test.bit`
// for its replacement, E0117 — so that property and its two rows
// (`test-decl-mixed-count`'s "3 discovered", `test-decl-mixed-legacy-survives`)
// are gone rather than reworded.
//
// Four rows, each pinning one substring of the SAME `bit test <fixture>`
// (no-filter) transcript plus one filtered row, rather than one row with a
// single assertion — `Case` carries exactly one `wantOutSub` and one
// `absent`, so the properties this fixture's own header lists (isolation
// survives a panic, `--run` matches the string) each need their own row to
// be independently attributable on a failure.
fn testDeclCases(cwd: string, ms: int): []Case {
  let fixture = "${cwd}/_tests_/bit/testdecl/isolation.test.bit"
  let base = "test ${fixture} --timeout ${ms / 1000}"
  return [
    // Both `test "..." { }` declarations discovered.
    Case{
      name = "test-decl-isolation-count", argv = base, wantExit = 1,
      wantErrSub = "", wantOutSub = "discovered 2 tests, ran 2: 1 passed, 1 failed", absent = "",
    },
    // The FIRST-declared test panics and is reported as a failure, by its
    // STRING name — never a `test$0`-shaped internal symbol.
    Case{
      name = "test-decl-isolation-first-fails", argv = base, wantExit = 1,
      wantErrSub = "", wantOutSub = "FAIL first test panics", absent = "",
    },
    // ISOLATION: the test declared AFTER the panicking one still ran and
    // passed — one process per test, so the panic neither hid nor aborted it.
    Case{
      name = "test-decl-isolation-second-survives", argv = base, wantExit = 1,
      wantErrSub = "", wantOutSub = "ok   second test also passes", absent = "",
    },
    // `--run` matches the DISPLAY STRING: a pattern with an embedded space
    // can only match a `test` declaration's `testDisplayName`, never its
    // `test$<n>` call symbol (no Bit identifier can contain a space). Narrows
    // to exactly one of two, and `absent` proves it did not also match the
    // panicking sibling.
    Case{
      name = "test-decl-run-filter-string-name",
      argv = "test ${fixture} --run 'second test' --timeout ${ms / 1000}", wantExit = 0,
      wantErrSub = "", wantOutSub = "discovered 2 tests, ran 1: 1 passed, 0 failed",
      absent = "first test panics",
    },
  ]
}

// THE WALK ESCAPING ITS ROOT (#2489), same class as #2152's `std/fs.walk` bug
// and built on the `symlinkwalk/` fixture `makeSymlinkFixtures` sets up
// alongside a link to `${root}-outside` and a self-referential one. `wantExit:
// 0` and `wantOutSub` naming the real test are the fixed behaviour;
// `absent: "=="` is what the bug flips — `testProject`'s per-module `==` header
// can only appear if the walk found a second module, which it can only do by
// following one of the two links.
// `--timeout ${ms / 1000}` (#3685): same reason as `recursiveTestCases`
// above — this row actually runs "symlinkwalk real" through `bit
// test`'s own per-test bound.
fn symlinkWalkCases(ms: int): []Case {
  return [
    Case{
      name = "test-symlink-no-follow", argv = "test symlinkwalk --timeout ${ms / 1000}", wantExit = 0,
      wantErrSub = "", wantOutSub = "symlinkwalk real", absent = "==",
    },
  ]
}

// THE WARNING THAT NEVER RENDERED (#2491). `hasErrors` reflects only
// `errorCount`, and a warning (E0048, shadowing a predeclared identifier —
// still the only one) deliberately never bumps it, so `reportCheckErrors`'s
// `!hasErrors(d)` gate returned false — "nothing to report" — for a
// diagnostics list holding a warning and nothing else, and the caller never
// reached `renderDiags` at all. Confirmed on the pinned stage0 oracle too: no
// released `bit` has ever shown this warning through `check` or `build`.
//
// `shadow.bit` is built to have EXACTLY one diagnostic and it must be this
// one: `check_shadows_predeclared.bit` under _tests_/cases/ pairs the same
// warning with a real type error precisely because that combination already
// worked (the error's `hasErrors` gate rendered the whole list, warning
// included) — so it could not have caught this bug, and does not exercise the
// fix (`reportCheckDiagnostics`'s render-on-nonempty-list branch) at all.
// `absent: "error["` keeps this row from silently degrading into that one.
fn warningCases(): []Case {
  return [
    Case{
      name = "check-shadow-warning", argv = "check shadow.bit", wantExit = 0,
      wantErrSub = "warning[E0048]", wantOutSub = "", absent = "error[",
    },
  ]
}

// #3009: raw-string `${...}` warns (E0098) only on a well-formed pair.
// `run`, not `check`, on every row: the same case proves the diagnostic AND
// that the program still compiles, runs, and prints the raw text unchanged —
// the "warning, not error" constraint the ticket is about. The three silent
// rows are the false-positive guard: a bare `$`, a `$foo` shell variable, and
// an unmatched `${` are exactly what a raw string exists to hold, and this is
// the table that would go red if the check ever started firing on them.
fn rawInterpWarningCases(): []Case {
  return [
    Case{
      name = "run-rawinterp-warns", argv = "run rawinterp_warn.bit", wantExit = 0,
      wantErrSub = "warning[E0098]", wantOutSub = "The sum is \${1 + 2}", absent = "error[",
    },
    Case{
      name = "run-rawinterp-dollar-silent", argv = "run rawinterp_dollar.bit", wantExit = 0,
      wantErrSub = "", wantOutSub = "price is $5", absent = "E0098",
    },
    Case{
      name = "run-rawinterp-var-silent", argv = "run rawinterp_var.bit", wantExit = 0,
      wantErrSub = "", wantOutSub = "echo $foo", absent = "E0098",
    },
    Case{
      name = "run-rawinterp-unmatched-silent", argv = "run rawinterp_unmatched.bit", wantExit = 0,
      wantErrSub = "", wantOutSub = "\${unterminated brace", absent = "E0098",
    },
  ]
}
