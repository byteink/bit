// _tests_/bit/clicmd/initcmd.bit — #3502: `bit init`'s default project name.
//
// Sibling of `clicmd.bit`/`cases.bit`/`buildoutput.bit` in the same directory
// module: no `import`, one shared scope. Reuses `Tally`/`check`/`runBit`/
// `mkdir`/`writeFile`/`readFile`/`exists`/`contains` from `clicmd.bit`'s own
// imports and helpers; `clicmd.bit`'s `runCases` calls `runInitChecks` below.
//
// THE PROPERTY, in one sentence: `bit init` with no `[name]` argument now
// derives the manifest's "name" from the current directory's own basename
// (`std/fs`'s `cwd()`, unavailable when this command was first written —
// `compiler/pmcliinit.bit`'s own header used to explain why there was no
// default), an explicit `[name]` argument still wins outright, and a
// directory whose basename cannot be derived into a usable name (the
// filesystem root, whose basename is "") fails loudly with a named message
// and writes nothing — never a manifest with a missing or empty "name".
//
// `root: "/"` below is not a mistake: it is the one directory a real `cwd()`
// can return whose basename is "" (`pathBase` cuts at the LAST '/', and every
// other path a filesystem actually produces has a non-empty final
// component). It is provably safe to run here — `defaultInitName` (pmcliinit.bit)
// fails BEFORE `initCmd` ever probes or writes `bit.json`, so this case
// attempts no filesystem mutation at all, regardless of permissions.
class InitCase {
  name: string,
  root: string,
  argv: string,
  wantExit: int,
  wantErrSub: string,
  manifestPath: string, // absolute path checked for existence after the run
  wantManifest: bool,
  wantJsonSub: string, // substring manifestPath's content must hold; "" to skip
}

fn runInitChecks(t: Tally, bit: string, scratch: string, capDir: string, ms: int): ()! {
  let base = "${scratch}/initproj"
  initFixtures(base)?
  let cases = initCases(base)
  if (len(cases) < 4) {
    panic("clicmd: only ${len(cases)} init cases, want at least 4")
  }
  for c of cases {
    checkInitCase(t, bit, capDir, c, ms)?
  }
  checkInitThenAdd(t, bit, base, capDir, ms)?
}

fn initFixtures(base: string): ()! {
  mkdir(base)?
  mkdir("${base}/foo")?
  mkdir("${base}/bar")?
  mkdir("${base}/existing")?
  // Pre-seeded so the "already exists" refusal (#2751) is proven to still
  // fire ahead of any write, with the SAME behaviour the basename default
  // must not disturb: the file is read back byte-for-byte unchanged.
  writeFile("${base}/existing/bit.json", "{\"name\": \"sentinel\", \"dependencies\": {}}\n")?
  // A local/file:// dependency (#2244) never fetches at all -- no cache
  // root, no git, no network -- so this is the whole fixture `bit add` needs.
  mkdir("${base}/dep")?
  writeFile("${base}/dep/bit.json", "{\"dependencies\": {}}\n")?
  writeFile("${base}/dep/lib.bit", "export fn hello(): string {\n  return \"hi\"\n}\n")?
}

fn initCases(base: string): []InitCase {
  return [
    // No [name]: the directory's own basename ("foo") is used.
    InitCase{
      name: "default-name", root: "${base}/foo", argv: "init",
      wantExit: 0, wantErrSub: "",
      manifestPath: "${base}/foo/bit.json", wantManifest: true,
      wantJsonSub: "\"name\": \"foo\"",
    },
    // [name] given: it wins outright over the directory's own basename ("bar").
    InitCase{
      name: "explicit-name-wins", root: "${base}/bar", argv: "init explicitname",
      wantExit: 0, wantErrSub: "",
      manifestPath: "${base}/bar/bit.json", wantManifest: true,
      wantJsonSub: "\"name\": \"explicitname\"",
    },
    // The filesystem root: basename is "", so the default is refused rather
    // than writing a manifest with no usable name.
    InitCase{
      name: "unusable-root-basename", root: "/", argv: "init",
      wantExit: 1, wantErrSub: "cannot derive a project name",
      manifestPath: "/bit.json", wantManifest: false,
      wantJsonSub: "",
    },
    // An existing bit.json still refuses to be overwritten (#2751), and the
    // pre-existing content is untouched -- the basename default is computed
    // but never reaches a write once the existence check refuses.
    InitCase{
      name: "already-exists-still-refuses", root: "${base}/existing", argv: "init",
      wantExit: 1, wantErrSub: "already exists",
      manifestPath: "${base}/existing/bit.json", wantManifest: true,
      wantJsonSub: "\"name\": \"sentinel\"",
    },
  ]
}

fn checkInitCase(t: Tally, bit: string, capDir: string, c: InitCase, ms: int): ()! {
  let r = runBit(bit, c.root, capDir, c.argv, ms)?
  check(
    t, r.code == c.wantExit,
    "init-${c.name}: `bit ${c.argv}` (cwd ${c.root}) exit ${r.code}, want ${c.wantExit} (out=${r.out} err=${r.err})",
  )
  if (len(c.wantErrSub) > 0) {
    check(
      t,
      contains(r.err, c.wantErrSub),
      "init-${c.name}: stderr lacks \"${c.wantErrSub}\": ${r.err}",
    )
  }
  let got = exists(c.manifestPath)
  check(
    t, got == c.wantManifest,
    "init-${c.name}: ${c.manifestPath} exists=${got}, want ${c.wantManifest}",
  )
  if (len(c.wantJsonSub) > 0 && got) {
    let text = readFile(c.manifestPath)?
    check(
      t,
      contains(text, c.wantJsonSub),
      "init-${c.name}: ${c.manifestPath} lacks \"${c.wantJsonSub}\": ${text}",
    )
  }
}

// #3502 acceptance: `bit init` (default name) followed by `bit add` on the
// SAME project extends the manifest without error, and the derived name
// survives the extension. Reuses "foo", which `default-name` (initCases)
// above already wrote bit.json into -- a second `bit init` there would hit
// the already-exists refusal, so this runs only `add`.
fn checkInitThenAdd(t: Tally, bit: string, base: string, capDir: string, ms: int): ()! {
  let root = "${base}/foo"
  let r = runBit(bit, root, capDir, "add file://${base}/dep", ms)?
  check(
    t,
    r.code == 0,
    "init-then-add: `bit add` exit ${r.code}, want 0 (out=${r.out} err=${r.err})",
  )
  let manifest = readFile("${root}/bit.json")?
  check(
    t,
    contains(manifest, "\"name\": \"foo\""),
    "init-then-add: bit.json lost its name after add: ${manifest}",
  )
  check(
    t,
    contains(manifest, "\"dep\""),
    "init-then-add: bit.json missing the added dependency: ${manifest}",
  )
}
