// _tests_/bit/clicmd/buildoutput.bit — `bit build`'s output-location rules
// (#2260's directory default, #2746's file default and explicit `-o`),
// split out of clicmd.bit (#3791) to keep that file under this repo's
// 800-line ceiling (spec/LINT.md). Same module as clicmd.bit and cases.bit
// (sibling `.bit` files, no import needed): `Tally`/`runBit`/`clear`/`check`
// are declared there and visible here, order-independent.

// THE BUILD OUTPUT LOCATION — directory rows are #2260, file rows and the
// explicit `-o` rows are #2746, which decided the two may legitimately keep
// disagreeing (the reasoning lives at the derivation site,
// `compiler/buildout.bit`, not here).
//
// The directory half: `bit build`'s default `-o` for a project directory was
// `pathStem` on the raw argument text, and a directory has no `.bit` suffix
// for that to strip: for "." and "./" the text yields the EMPTY string
// ("bit: cannot write : cannot create file: "), and for a bare directory name
// like "p260" built from its parent, `pathStem` returns the directory's own
// name — which then collides with the directory itself ("bit: cannot write
// p260: cannot create file: p260"). The fix writes the binary INSIDE the
// resolved directory, named from bit.json's "name" (falling back to the
// directory's own basename when there is none), so every spelling below
// lands on the same file, `p260/p260`, and none can collide with the
// directory that holds it.
//
// The file half (#2746): a file target's default has never been asserted
// here at all — every existing `build` case checks only the exit code, never
// where the binary landed. `file-no-o` pins the rule stated in
// `compiler/cli.bit`'s usage text: the caller's cwd, named by the file's own
// stem, with the source file's OWN directory (`sub/`) asserted absent so a
// regression toward "beside the source" — the direction #2746 explicitly
// rejects — is caught.
//
// The explicit-`-o` half (#2746): passing `-o` was already untested for
// EITHER target type beyond its exit code. `file-with-o` and `dir-with-o`
// pin that an explicit `-o` is honoured verbatim, relative to the caller's
// cwd, for both — overriding the directory default's "inside itself" rule
// the same way it already overrides the file default's stem rule.
//
// A plain `Case` cannot express "and this exact file now exists", so this is
// a dedicated table rather than rows in `acceptCases`. `root` is the cwd the
// child is started in — the same mechanism `runBit` already uses — and
// `wantFile` is an absolute path, since several rows write somewhere other
// than under `root`.
class OutPathCase {
  name: string,
  root: string,
  argv: string,
  wantExit: int,
  wantErrSub: string,
  wantFile: string,   // absolute path expected to exist after the run; "" for none
  absentFile: string, // absolute path that must NOT exist after the run; "" for none
}

fn runBuildOutputChecks(t: Tally, bit: string, scratch: string, capDir: string, ms: int): ()! {
  let base = "${scratch}/dirname"
  buildOutPathFixtures(base)?
  let cases = buildOutPathCases(base)
  if (len(cases) < 10) {
    panic("clicmd: only ${len(cases)} build-output cases, want at least 10")
  }
  for c of cases {
    checkOutPathCase(t, bit, capDir, c, ms)?
  }
}

// The directory tree `buildOutPathCases` runs its rows against, split out of
// `runBuildOutputChecks` (#3814, E0201/E0204: the combined function was 129
// lines at complexity 12 against limits of 80/10).
fn buildOutPathFixtures(base: string): ()! {
  mkdir(base)?
  mkdir("${base}/T")?
  mkdir("${base}/T/p260")?
  writeFile("${base}/T/p260/bit.json", "{\"name\":\"p260\"}\n")?
  writeFile("${base}/T/p260/main.bit", "fn main() { print(\"hi\\n\") }\n")?
  mkdir("${base}/elsewhere")?
  // A project directory with NO manifest at all: `bit build <dir>` must
  // still resolve to a name (the directory's own basename) when the text
  // carries one, and must still refuse cleanly — never silently — when it
  // does not (the standalone "." row below).
  mkdir("${base}/T/nomanifest")?
  writeFile("${base}/T/nomanifest/main.bit", "fn main() { print(\"hi\\n\") }\n")?
  mkdir("${base}/nomanifestdot")?
  writeFile("${base}/nomanifestdot/main.bit", "fn main() { print(\"hi\\n\") }\n")?
  // #2746's file-target fixture: a source file one level below where the
  // default output must land, so the default and the "beside the source"
  // alternative name two different paths.
  mkdir("${base}/filetree")?
  mkdir("${base}/filetree/sub")?
  writeFile("${base}/filetree/sub/prog.bit", "fn main() { print(\"hi\\n\") }\n")?
}

// The build-output-location table itself, split out of `runBuildOutputChecks`
// the same as `buildOutPathFixtures` above.
fn buildOutPathCases(base: string): []OutPathCase {
  let p260Out = "${base}/T/p260/p260"
  return [
    // The ticket's five rows, in order.
    OutPathCase{
      name: "dot", root: "${base}/T/p260", argv: "build .",
      wantExit: 0, wantErrSub: "", wantFile: p260Out, absentFile: "",
    },
    OutPathCase{
      name: "dot-slash", root: "${base}/T/p260", argv: "build ./",
      wantExit: 0, wantErrSub: "", wantFile: p260Out, absentFile: "",
    },
    OutPathCase{
      name: "dir-slash", root: "${base}/T", argv: "build p260/",
      wantExit: 0, wantErrSub: "", wantFile: p260Out, absentFile: "",
    },
    OutPathCase{
      name: "dir-bare", root: "${base}/T", argv: "build p260",
      wantExit: 0, wantErrSub: "", wantFile: p260Out, absentFile: "",
    },
    // The absolute-path row already exited 0 before the fix, but wrote
    // `./p260` in the CALLER's cwd rather than inside the target directory —
    // `absentFile` is what catches that: the OLD behaviour still passes
    // `wantExit`/`wantFile` here by luck (it wrote SOME file named p260,
    // just in the wrong place) unless the caller's cwd is also checked.
    OutPathCase{
      name: "abs", root: "${base}/elsewhere", argv: "build ${base}/T/p260",
      wantExit: 0, wantErrSub: "", wantFile: p260Out, absentFile: "${base}/elsewhere/p260",
    },
    // No bit.json: the directory's own basename is still a valid fallback.
    OutPathCase{
      name: "no-manifest-fallback", root: "${base}/T", argv: "build nomanifest",
      wantExit: 0, wantErrSub: "", wantFile: "${base}/T/nomanifest/nomanifest", absentFile: "",
    },
    // No bit.json AND no textual name ("."): nothing CAN be derived, so this
    // must be a clean, named refusal — never the empty-name write the bug
    // produced, and never a silent guess.
    OutPathCase{
      name: "no-manifest-dot", root: "${base}/nomanifestdot", argv: "build .",
      wantExit: 2, wantErrSub: "cannot derive an output name", wantFile: "", absentFile: "",
    },
    // #2746: a file target's default writes to the CALLER's cwd, named by
    // the file's own stem — never inside `sub/`, the file's own directory.
    OutPathCase{
      name: "file-no-o", root: "${base}/filetree", argv: "build sub/prog.bit",
      wantExit: 0, wantErrSub: "", wantFile: "${base}/filetree/prog",
      absentFile: "${base}/filetree/sub/prog",
    },
    // #2746: an explicit `-o` on a FILE target is honoured verbatim,
    // relative to cwd — the stem default must not also be written.
    OutPathCase{
      name: "file-with-o", root: "${base}/filetree", argv: "build sub/prog.bit -o progout",
      wantExit: 0, wantErrSub: "", wantFile: "${base}/filetree/progout",
      absentFile: "${base}/filetree/prog",
    },
    // #2746: an explicit `-o` on a DIRECTORY target overrides the
    // "inside itself" default the same way it overrides the file default —
    // the output goes to the CALLER's cwd, not inside `p260/`.
    OutPathCase{
      name: "dir-with-o", root: "${base}/T", argv: "build p260 -o dirout",
      wantExit: 0, wantErrSub: "", wantFile: "${base}/T/dirout",
      absentFile: "${base}/T/p260/dirout",
    },
  ]
}

// One row's assertions, split out of `runBuildOutputChecks` the same as the
// two functions above.
fn checkOutPathCase(t: Tally, bit: string, capDir: string, c: OutPathCase, ms: int): ()! {
  // Each row must recreate its own output — never pass on a leftover a
  // PRIOR row wrote to the same path (rows dot/dot-slash/dir-slash/
  // dir-bare/abs all target the same `wantFile`). `absentFile` needs the
  // same clearing: `file-with-o`'s absentFile is `file-no-o`'s wantFile, one
  // row earlier in this same table, so without this a stale file from the
  // PRIOR row would fail this row's absence check for a reason that has
  // nothing to do with what this row itself wrote.
  if (len(c.wantFile) > 0 && exists(c.wantFile)) {
    remove(c.wantFile) catch _ {
      return
    }
  }
  if (len(c.absentFile) > 0 && exists(c.absentFile)) {
    remove(c.absentFile) catch _ {
      return
    }
  }
  let r = runBit(bit, c.root, capDir, c.argv, ms)?
  check(
    t, r.code == c.wantExit,
    "outpath-${c.name}: `bit ${c.argv}` (cwd ${c.root}) exit ${r.code}, want ${c.wantExit} (out=${r.out} err=${r.err})",
  )
  if (len(c.wantErrSub) > 0) {
    check(
      t, contains(r.err, c.wantErrSub),
      "outpath-${c.name}: stderr lacks \"${c.wantErrSub}\": ${r.err}",
    )
  }
  if (len(c.wantFile) > 0) {
    check(t, exists(c.wantFile), "outpath-${c.name}: ${c.wantFile} was not created")
  }
  if (len(c.absentFile) > 0) {
    check(
      t, !exists(c.absentFile),
      "outpath-${c.name}: ${c.absentFile} must not exist",
    )
  }
}
