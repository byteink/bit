// _tests_/bit/clicmd/pkgcmd.bit — #6306 (M1b) acceptance: a direct
// dependency's `cmd/<words>/main.bit` IS `bit <words>` (SPEC §17.7's
// "Package commands" — convention, no `bit.json` key), end-to-end through a
// real `bit` binary and real subprocesses. `compiler/pkgcmdcheck.bit`
// (selfcheck) covers the pure resolution logic in-process; this covers what
// that cannot: a real build, `gen.bit` running with the project root as its
// own working directory, argv/stdio/exit-code forwarding, and the
// two-dependency conflict as `bit` itself reports it.
//
// Sibling of `clicmd.bit`/`initcmd.bit` in the same directory module: no
// `import`, reuses `Tally`/`check`/`runBit`/`mkdir`/`writeFile`/`readFile`/
// `contains` from `clicmd.bit`'s own imports and helpers. `clicmd.bit`'s
// `runCases` calls `runPkgCmdChecks` below.
//
// Every fixture `.bit` source string below avoids any `import` (matching
// every other fixture in this directory, per `clicmd.bit`'s own note on
// `echoargs.bit`: this harness never sets `BIT_STDLIB`), using only
// PREDECLARED builtins: `osArgc`/`osArgAt` for argv, `fsOpen`/`fsWrite`/
// `fsClose`/`fsCwd` for `gen.bit`'s own output and cwd proof.

fn pkgCmdWriteDep(depDir: string, mainRelPath: string, mainSrc: string): ()! {
  mkdir(depDir)?
  writeFile("${depDir}/bit.json", "{\"dependencies\": {}}\n")?
  let dir = pathDirOf(mainRelPath)
  pkgCmdMkdirAll("${depDir}/${dir}")?
  writeFile("${depDir}/${mainRelPath}", mainSrc)?
}

// `std/path`'s `dir` is not imported here (see the module header); this
// mirrors it for the fixture paths this file itself builds, all of which
// are `cmd/<...>/(main|gen).bit`.
fn pathDirOf(p: string): string {
  let i = len(p) - 1
  while (i >= 0 && p[i] != '/') {
    i = i - 1
  }
  return p[0:i]
}

// `mkdir` (std/fs) fails if its parent does not exist; this file's fixture
// paths are at most `cmd/<w1>/<w2>`, so two levels covers every case here.
fn pkgCmdMkdirAll(dir: string): ()! {
  let parent = pathDirOf(dir)
  if (len(parent) > 0 && !exists(parent)) {
    pkgCmdMkdirAll(parent)?
  }
  if (!exists(dir)) {
    mkdir(dir)?
  }
}

fn pkgCmdFixtures(base: string): ()! {
  mkdir(base)?
  mkdir("${base}/deps")?

  pkgCmdWriteDep(
    "${base}/deps/greeter", "cmd/hello/main.bit",
      "fn main() {\n" +
      "  let n = osArgc()\n" +
      "  print(\"argc=\${n}\\n\")\n" +
      "  let i = 0\n" +
      "  while (i < n) {\n" +
      "    print(\"[\${i}]=\${osArgAt(i)}\\n\")\n" +
      "    i = i + 1\n" +
      "  }\n" +
      "}\n",
  )?

  pkgCmdWriteDep(
    "${base}/deps/migrator", "cmd/make/migration/main.bit",
    "fn main() {\n  print(\"migration-ok\\n\")\n}\n",
  )?

  // `gentool` ships ONLY `gen.bit` — no static `main.bit` — proving
  // `runPkgCmd` builds and runs the file `gen.bit` writes, never a
  // dependency-shipped fallback. `gen.bit` proves "cwd = project root"
  // itself, INSIDE the subprocess: `osArgAt(1)` (the argument it received)
  // and `fsCwd()` (its own process's working directory) must be the exact
  // same string — compared here, not by the test harness, since `$TMPDIR`
  // may be a symlink (macOS: `/tmp` -> `/private/tmp`) that a real `cwd()`
  // resolves and a plain string built by the OUTER test process does not,
  // so comparing the two paths across processes would fail on the
  // symlink alone, independent of whether the property actually holds.
  mkdir("${base}/deps/gentool")?
  writeFile("${base}/deps/gentool/bit.json", "{\"dependencies\": {}}\n")?
  pkgCmdMkdirAll("${base}/deps/gentool/cmd/gentest")?
  writeFile(
    "${base}/deps/gentool/cmd/gentest/gen.bit",
      "fn main() {\n" +
      "  let root = osArgAt(1)\n" +
      "  let genCwd = fsCwd()\n" +
      "  let matchedStr = \"false\"\n" +
      "  if (root == genCwd) {\n" +
      "    matchedStr = \"true\"\n" +
      "  }\n" +
      "  let fd = fsOpen(root + \"/.bit/cmd/gentest/main.bit\", true)\n" +
      "  fsWrite(\n" +
      "    fd,\n" +
      "    \"fn main() {\\n  print(\\\"gentest-ok cwd-matches-arg=\" + matchedStr + \"\\\\n\\\")\\n}\\n\",\n" +
      "  )\n" +
      "  fsClose(fd)\n" +
      "}\n",
  )?

  // `dupa`/`dupb` both ship `cmd/dupcmd/main.bit` — the conflict fixture.
  pkgCmdWriteDep(
    "${base}/deps/dupa",
    "cmd/dupcmd/main.bit",
    "fn main() {\n  print(\"dupa\\n\")\n}\n",
  )?
  pkgCmdWriteDep(
    "${base}/deps/dupb",
    "cmd/dupcmd/main.bit",
    "fn main() {\n  print(\"dupb\\n\")\n}\n",
  )?

  let proj = "${base}/proj"
  mkdir(proj)?
  writeFile(proj + "/bit.json", "{\"name\": \"pkgcmdproj\"}\n")?
}

fn runPkgCmdChecks(t: Tally, bit: string, scratch: string, capDir: string, ms: int): ()! {
  let base = "${scratch}/pkgcmdroot"
  pkgCmdFixtures(base)?
  let proj = "${base}/proj"
  let depsDir = "${base}/deps"

  for name of ["greeter", "migrator", "gentool", "dupa", "dupb"] {
    let r = runBit(bit, proj, capDir, "add file://${depsDir}/${name}", ms)?
    check(t, r.code == 0, "pkgcmd-add-${name}: exit ${r.code}, want 0 (out=${r.out} err=${r.err})")
  }

  // Single-word command; args reach it.
  let hello = runBit(bit, proj, capDir, "hello a b", ms)?
  check(t, hello.code == 0, "pkgcmd-hello: exit ${hello.code}, want 0 (err=${hello.err})")
  check(t, contains(hello.out, "]=a\n"), "pkgcmd-hello: stdout lacks arg 'a': ${hello.out}")
  check(t, contains(hello.out, "]=b\n"), "pkgcmd-hello: stdout lacks arg 'b': ${hello.out}")

  // Two-word command.
  let make = runBit(bit, proj, capDir, "make migration", ms)?
  check(t, make.code == 0, "pkgcmd-make-migration: exit ${make.code}, want 0 (err=${make.err})")
  check(
    t, contains(make.out, "migration-ok"),
    "pkgcmd-make-migration: stdout lacks 'migration-ok': ${make.out}",
  )

  // gen.bit-then-main: `gen.bit` itself compares its own argv (the project
  // root) against its own `fsCwd()` and bakes the result into `main.bit`,
  // which this asserts on — the exit code alone already proves `runPkgCmd`
  // built and ran the FILE GEN WROTE, since `gentool` ships no static
  // `main.bit` for a fallback build to have used instead.
  let gen = runBit(bit, proj, capDir, "gentest", ms)?
  check(t, gen.code == 0, "pkgcmd-gentest: exit ${gen.code}, want 0 (err=${gen.err})")
  check(
    t, contains(gen.out, "gentest-ok cwd-matches-arg=true"),
    "pkgcmd-gentest: gen.bit's own cwd did not match the project root it was given: ${gen.out}",
  )

  // Conflict: two direct dependencies both ship `cmd/dupcmd/main.bit`.
  let dup = runBit(bit, proj, capDir, "dupcmd", ms)?
  check(t, dup.code != 0, "pkgcmd-dupcmd: exit ${dup.code}, want nonzero")
  check(t, contains(dup.err, "dupa"), "pkgcmd-dupcmd: stderr lacks 'dupa': ${dup.err}")
  check(t, contains(dup.err, "dupb"), "pkgcmd-dupcmd: stderr lacks 'dupb': ${dup.err}")
}
