// #3653 (2448-fallout). Guards stdlib entry points that must allocate ZERO
// heap objects per call, the class of regression #3637 (stdlib/strings/
// parseInt) and #3617 (stdlib/json/parse) both shipped: #2448's E0204 split
// took a call from 0 to exactly 1.0000 objects/call by returning a class as
// the multiple-return vehicle, and nothing caught either for months.
//
// WHY A SLOPE, NOT A TOTAL. A single run's `swept+live` includes every fixed
// allocation the runtime makes before `main` (boot, arg parsing) and would
// drift with unrelated changes, making a total-based gate flaky and, in
// time, ignored. Instead this harness builds and runs the SAME fixture body
// at `callsN` and `2*callsN` calls and takes the marginal:
//
//     (objects(2N) - objects(N)) / N == the row's declared slope
//
// Fixed per-process cost cancels out of the subtraction; only the per-call
// cost of the row's own expression survives. A single total is explained by
// boot overhead — a two-point slope is not.
//
// WHY THE CALL'S ARGUMENT IS HOISTED OUT OF THE LOOP (`let arg = ...` once,
// then `row.callExpr` referencing `arg` on every iteration). A probe that
// re-builds its own argument inside the timed loop measures the argument
// construction alongside the call under test, not the call alone — found by
// a sibling gate the same day this one was written, as a constant offset
// between two measurements of what should have been the same number.
//
// WHY `swept+live`, NEVER `swept` OR `live` ALONE. The two vary against each
// other run to run depending on exactly when the trigger fires; their sum —
// every object the process ever allocated — does not (_tests_/bit/lspcache.bit
// and _tests_/bit/benchgate/benchgate.bit's headers, same reasoning).
//
// WHY `bit build` + exec, NOT `bit run`: `bit run` refuses `BIT_GC=stress`
// but this gate does not need stress mode at all — plain `BIT_GC_STATS=1` on
// a normally-triggered run already reports the exit summary
// (_tests_/bit/gcbootsafepoint.bit's header explains the `bit run` refusal for
// the sibling case; this gate compiles once per (row, N) and execs directly
// for the same reason: a fresh, uncomplicated child process).
//
// WHY `int()`/`i64()` need no bridging here: `int` is an alias for `i64`
// (spec/SPEC.md §5.3), so `parseInt`'s `int!` result and the fixture's `sum`
// accumulator are the same type with no conversion call to itself allocate
// or hide behind.
//
// THE SUM CHECK inside the fixture (`sum != row.perCallValue * n`) is not
// decoration: it forces the compiler to treat every `row.callExpr` result as
// used by a data-dependent branch, and it doubles as a correctness floor — a
// loop that silently ran zero or a different number of times fails loudly
// here rather than reporting a slope of 0 for the wrong reason.
//
// Run it from the repository root:
//     ./bit-out/bin/bit run _tests_/bit/allocslope.bit
// `BIT_SELF_EXE` overrides which `bit` is exercised; `BIT_STDLIB` must point
// at a real std/strings (required — this gate's fixtures import stdlib).
import { env, envOr, exit } from "std/os"
import { exists, mkdir, readFile, writeFile } from "std/fs"
import { parseInt } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// Calls per measured arm. Matches the measurement recorded on #3637
// (task-3637-parseint-alloc, d4433deb): swept+live is 7 at BOTH 100000 and
// 200000 calls (dead flat, slope 0); before that fix the same probe read
// 100007 and 200007 (slope 1).
const callsN: int = 100000

fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "120")) catch _ {
    120
  }
  if (s <= 0) {
    return 120000
  }
  return s * 1000
}

class Tally { checks: int, failures: int }

fn check(t: Tally, cond: bool, label: string) {
  t.checks = t.checks + 1
  if (!cond) {
    t.failures = t.failures + 1
    eprint("FAIL: ${label}\n")
  }
}

fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    fail newError("allocslope: cannot make script executable: ${scriptPath}")
  }
  return osRunBounded(scriptPath, ms)
}

fn bitBinary(scratch: string, ms: int): string! {
  let explicit = env("BIT_SELF_EXE")
  if (len(explicit) > 0) {
    if (!exists(explicit)) {
      fail newError("allocslope: BIT_SELF_EXE=${explicit} does not exist")
    }
    return explicit
  }
  let cwdFile = "${scratch}/cwd.txt"
  let code = shell("${scratch}/pwd.sh", "#!/bin/sh\npwd > '${cwdFile}'\n", ms)?
  if (code != 0) {
    fail newError("allocslope: could not read the working directory (exit ${code})")
  }
  let candidate = "${trimWs(readFile(cwdFile)?)}/bit-out/bin/bit"
  if (!exists(candidate)) {
    fail newError("allocslope: no compiler at ${candidate}; run this from the repository root or set BIT_SELF_EXE")
  }
  return candidate
}

// The decimal that follows the FIRST occurrence of `key`, or -1 when `key` is
// absent or not followed by a digit. -1 rather than 0 is load-bearing: a
// missing field must fail this gate, never read as "zero of it happened".
fn intAfter(s: string, key: string): int {
  let n = len(key)
  let i = 0
  while (i + n <= len(s)) {
    if (s[i:i + n] == key) {
      let j = i + n
      let v = 0
      let digits = 0
      while (j < len(s) && s[j] >= u8('0') && s[j] <= u8('9')) {
        v = v * 10 + (int(s[j]) - int(u8('0')))
        digits = digits + 1
        j = j + 1
      }
      if (digits == 0) {
        return 0 - 1
      }
      return v
    }
    i = i + 1
  }
  return 0 - 1
}

// One stdlib entry point plus a one-line call expression (#3653's own
// wording). `argLiteral` is Bit source for the argument, hoisted to a `let
// arg = ...` OUTSIDE the timed loop; `callExpr` is the one-line expression
// using `arg`, evaluated once per iteration. `perCallValue` is the exact
// `int!` this call returns on success, used only for the fixture's own
// correctness floor. `slope` is the declared objects-per-call this row must
// hold at.
class Row {
  name: string,
  importLine: string,
  argLiteral: string,
  callExpr: string,
  perCallValue: int,
  slope: int,
}

fn rows(): []Row {
  return [
    Row{
      name = "parseInt",
      importLine = "import { parseInt } from \"std/strings\"",
      argLiteral = "\"-12345\"",
      callExpr = "parseInt(arg)",
      perCallValue = 0 - 12345,
      slope = 0,
    },
  ]
}

fn fixtureSource(row: Row, n: int): string {
  return "${row.importLine}\n\n" +
    "fn main() {\n" +
    "  let arg = ${row.argLiteral}\n" +
    "  let sum = 0\n" +
    "  let i = 0\n" +
    "  while (i < ${n}) {\n" +
    "    let v = ${row.callExpr} catch _ { panic(\"allocslope: ${row.name} call failed\") }\n" +
    "    sum = sum + v\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  if (sum != ${row.perCallValue} * ${n}) {\n" +
    "    panic(\"allocslope: ${row.name} sum mismatch\")\n" +
    "  }\n" +
    "}\n"
}

// #3982 (decimal codegen). A decimal binary operator plus its declared
// zero-allocation slope. `callExpr` is a bare expression on loop-invariant
// locals `a`/`b` (`a - b`), never a fallible `T!` call, so it does not fit
// `Row` above (whose `fixtureSource` always wraps `callExpr` in
// `catch _ { panic(...) }` and checks a `perCallValue: int` sum, neither of
// which a plain decimal operator returns). `#5402` was the one non-zero
// case (binary `-` allocated one heap object per call, fixed by exploding
// its left operand before the negate it lowers through) — DecRow exists to
// keep it from regressing silently.
class DecRow {
  name: string,
  callExpr: string,
  slope: int,
}

fn decimalRows(): []DecRow {
  return [
    DecRow{ name = "decimal_add", callExpr = "a + b", slope = 0 },
    DecRow{ name = "decimal_sub", callExpr = "a - b", slope = 0 },
    DecRow{ name = "decimal_mul", callExpr = "a * b", slope = 0 },
    DecRow{ name = "decimal_div", callExpr = "a / b", slope = 0 },
  ]
}

// `want` is computed by the SAME expression, once, outside the loop: `a`
// and `b` are loop-invariant, decimal arithmetic is pure, so the two
// evaluations are byte-identical and no operator-specific literal is
// needed (division's exact result is a 28-digit half-even repeating
// decimal that would be unreadable to hand-write). Comparing `c` to `want`
// every iteration — rather than summing `c`, as `fixtureSource` above
// does — forces the compiler to treat every `callExpr` result as used by a
// data-dependent branch without accumulating a value that could overflow
// decimal's 96-bit mantissa (division's result is close to the type's full
// precision; `callsN` copies of it summed would panic).
fn decimalFixtureSource(row: DecRow, n: int): string {
  return "fn main() {\n" +
    "  let a: decimal = 1.5\n" +
    "  let b: decimal = 2.25\n" +
    "  let want: decimal = ${row.callExpr}\n" +
    "  let matches = 0\n" +
    "  let i = 0\n" +
    "  while (i < ${n}) {\n" +
    "    let c: decimal = ${row.callExpr}\n" +
    "    if (c == want) {\n" +
    "      matches = matches + 1\n" +
    "    }\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  if (matches != ${n}) {\n" +
    "    panic(\"allocslope: ${row.name} correctness check failed\")\n" +
    "  }\n" +
    "}\n"
}

// #7142. A fallible ENUM result (#6730 returns it in two words) propagated
// through three `return f()?` levels, by free functions and by methods, and
// consumed by `?` and by `catch`. Each level used to rebuild the box the call
// site made from the words and keep it past the error test: one object per
// level per call, which was +182,040 objects per parse of pkg/toml's
// config.toml. Slope 0: no level may allocate. The `ok` sum is the
// correctness floor, as in `fixtureSource`.
fn enumTryChainFixtureSource(n: int): string {
  return "enum E {\n  A,\n  B(i64),\n}\n\n" +
    "fn leaf(i: i64): E! {\n" +
    "  if (i < 0) {\n    fail newError(\"allocslope: negative\")\n  }\n" +
    "  if (i % 3 == 0) {\n    return E.A\n  }\n" +
    "  return E.B(i)\n}\n\n" +
    "fn mid(i: i64): E! {\n  return leaf(i)?\n}\n\n" +
    "fn top(i: i64): E! {\n  return mid(i)?\n}\n\n" +
    "class Walker {\n  k: i64\n" +
    "  leafM(i: i64): E! {\n    return top(i + this.k)?\n  }\n" +
    "  midM(i: i64): E! {\n    return this.leafM(i)?\n  }\n}\n\n" +
    "fn score(e: E): i64 {\n  match (e) {\n    A => return 1\n    B(v) => return v\n  }\n}\n\n" +
    "fn viaTry(w: Walker, i: i64): i64! {\n" +
    "  let e = w.midM(i)?\n  return score(e)\n}\n\n" +
    "fn main() {\n" +
    "  let w = Walker{ k = 0 }\n" +
    "  let sum: i64 = 0\n  let want: i64 = 0\n  let i: i64 = 0\n" +
    "  while (i < ${n}) {\n" +
    "    let a = top(i) catch _ { E.A }\n" +
    "    let t = viaTry(w, i) catch _ { 0 }\n" +
    "    sum = sum + score(a) + t\n" +
    "    want = want + 2 * (i % 3 == 0 ? 1 : i)\n" +
    "    i = i + 1\n  }\n" +
    "  if (sum != want) {\n    panic(\"allocslope: enum_try_chain sum mismatch\")\n  }\n" +
    "}\n"
}

// #7146. The same chain through GENERIC levels: a closed result (`E!`), and
// one read under the instance's bindings (`Option<T>!` at `T = i64`). An
// instance returned its result as one box while #7142's free functions and
// methods returned words: one object per generic level per call. Slope 0.
fn genericTryChainFixtureSource(n: int): string {
  return "enum E {\n  A,\n  B(i64),\n}\n\n" +
    "fn top(i: i64): E! {\n" +
    "  if (i < 0) {\n    fail newError(\"allocslope: negative\")\n  }\n" +
    "  if (i % 3 == 0) {\n    return E.A\n  }\n" +
    "  return E.B(i)\n}\n\n" +
    "fn gleaf<T>(x: T, i: i64): E! {\n  return top(i)?\n}\n\n" +
    "fn gmid<T>(x: T, i: i64): E! {\n  return gleaf(x, i)?\n}\n\n" +
    "fn score(e: E): i64 {\n  match (e) {\n    A => return 1\n    B(v) => return v\n  }\n}\n\n" +
    "fn gopt<T>(x: T, i: i64): Option<T>! {\n" +
    "  let e = gmid(x, i)?\n" +
    "  if (score(e) == 1) {\n    return Option.None\n  }\n" +
    "  return Option.Some(x)\n}\n\n" +
    "fn main() {\n" +
    "  let sum: i64 = 0\n  let want: i64 = 0\n  let i: i64 = 0\n" +
    "  while (i < ${n}) {\n" +
    "    let a = gmid(i, i) catch _ { E.A }\n" +
    "    let o = gopt(i, i) catch _ { Option.None }\n" +
    "    sum = sum + score(a)\n" +
    "    match (o) {\n      Some(v) => sum = sum + v\n      None => sum = sum + 1\n    }\n" +
    "    want = want + 2 * (i % 3 == 0 ? 1 : i)\n" +
    "    i = i + 1\n  }\n" +
    "  if (sum != want) {\n    panic(\"allocslope: generic_try_chain sum mismatch\")\n  }\n" +
    "}\n"
}

// #7429. std/log's disabled path, the property pkg/web's request logger
// (`logger()`, pkg/web/logger.bit) relies on to cost nothing when INFO is off.
// A Logger whose handler is set to ERROR is called at INFO, per iteration,
// with three typed attributes: `unguarded` adds them to the disabled record
// directly (#7438: the shared off record keeps nothing), `guarded` behind
// `enabled()`, which is how the request logger skips its clock read too.
// Slope 0 for both: a disabled level allocates nothing per call. The two `enabled` checks before the loop are the
// correctness floor: the INFO call really is disabled and ERROR really is on,
// so a slope of 0 cannot come from a handler that dropped everything.
fn logDisabledFixtureSource(guarded: bool, n: int): string {
  let call = "lg.info().str(\"method\", \"GET\").int(\"status\", i).duration(\"took\", i).log(\"request\")\n"
  let body = "    ${call}"
  if (guarded) {
    body = "    if (lg.enabled(LevelInfo)) {\n      ${call}    }\n"
  }
  return "import { Logger, TextHandler, LevelInfo, LevelError } from \"std/log\"\n" +
    "import { stderr } from \"std/io\"\n\n" +
    "fn main() {\n" +
    "  let lg = Logger(TextHandler(stderr(), LevelError))\n" +
    "  if (lg.enabled(LevelInfo) || !lg.enabled(LevelError)) {\n" +
    "    panic(\"allocslope: log_disabled fixture level wrong\")\n" +
    "  }\n" +
    "  let i = 0\n" +
    "  while (i < ${n}) {\n" +
    body +
    "    i = i + 1\n" +
    "  }\n" +
    "}\n"
}

// #7430. The two records pkg/orm's `QueryLog` writes per statement
// (`logStatement`, pkg/orm/log.bit) with the level off: the INFO `statement`
// record and the WARN `slow statement` record, each carrying the statement
// text, the row count and the duration. A Logger at ERROR is called with both
// per iteration, unguarded as `logStatement` calls them. Slope 0: with
// logging off a statement costs nothing for its record. The two level
// checks before the loop are the correctness floor, as in
// `logDisabledFixtureSource`.
fn ormStatementDisabledFixtureSource(n: int): string {
  let rec = "lg.info().str(\"sql\", sql).int(\"rows\", i).duration(\"took\", i).log(\"statement\")\n"
  let slow = "lg.warn().str(\"sql\", sql).int(\"rows\", i).duration(\"took\", i).log(\"slow statement\")\n"
  return "import { Logger, TextHandler, LevelWarn, LevelError } from \"std/log\"\n" +
    "import { stderr } from \"std/io\"\n\n" +
    "fn main() {\n" +
    "  let lg = Logger(TextHandler(stderr(), LevelError))\n" +
    "  if (lg.enabled(LevelWarn) || !lg.enabled(LevelError)) {\n" +
    "    panic(\"allocslope: orm_statement_disabled fixture level wrong\")\n" +
    "  }\n" +
    "  let sql = \"select id from drafts where author = $1\"\n" +
    "  let i = 0\n" +
    "  while (i < ${n}) {\n" +
    "    ${rec}" +
    "    ${slow}" +
    "    i = i + 1\n" +
    "  }\n" +
    "}\n"
}

// #7431. The records pkg/authz writes per check (`logDenied` and `logged`,
// pkg/authz/decide.bit) with the levels off: the INFO `denied` record a
// refused `check` leaves, unguarded and built in two statements as
// `logDenied` builds it, and the DEBUG `decision` record, six attributes and
// behind `enabled()` as `logged` guards it. A Logger at ERROR is called with
// both per iteration. Slope 0: with logging off a check costs nothing for its
// records. The level checks before the loop are the correctness floor, as in
// `logDisabledFixtureSource`.
fn authzDisabledFixtureSource(n: int): string {
  let denied = "let rec = lg.info().str(\"action\", act).str(\"resource\", res)\n" +
    "    rec.str(\"subject\", sub).str(\"policy\", pol).log(\"denied\")\n"
  let decision = "if (lg.enabled(LevelDebug)) {\n" +
    "      let rec = lg.debug().str(\"outcome\", \"deny\").str(\"action\", act).str(\"resource\", res)\n" +
    "      rec.str(\"subject\", sub).str(\"policy\", pol).str(\"reason\", \"denied by rule\").log(\"decision\")\n" +
    "    }\n"
  return "import { Logger, TextHandler, LevelDebug, LevelInfo, LevelError } from \"std/log\"\n" +
    "import { stderr } from \"std/io\"\n\n" +
    "fn main() {\n" +
    "  let lg = Logger(TextHandler(stderr(), LevelError))\n" +
    "  if (lg.enabled(LevelInfo) || lg.enabled(LevelDebug) || !lg.enabled(LevelError)) {\n" +
    "    panic(\"allocslope: authz_disabled fixture level wrong\")\n" +
    "  }\n" +
    "  let act = \"Update\"\n  let res = \"Article\"\n  let sub = \"sara\"\n  let pol = \"EditOwn\"\n" +
    "  let i = 0\n" +
    "  while (i < ${n}) {\n" +
    "    ${denied}" +
    "    ${decision}" +
    "    i = i + 1\n" +
    "  }\n" +
    "}\n"
}

// #7432. The `mail sent` record pkg/mail's `Observer` writes per delivery
// (`logSent`, pkg/mail/maillog.bit) and the `mail retry` record `logRetry`
// writes, with the level off: INFO and WARN against a Logger at ERROR, the
// first unguarded as `logSent` calls it, the second after the `enabled` check
// `logRetry` makes before it builds the error text. Slope 0: a mailer whose
// logger drops a level pays nothing for that level's record. The level
// checks before the loop are the correctness floor, as in
// `logDisabledFixtureSource`.
fn mailLogDisabledFixtureSource(n: int): string {
  let sent = "lg.info().str(\"transport\", \"smtps\").int(\"recipients\", i).duration(\"took\", i).log(\"mail sent\")\n"
  let retry = "if (lg.enabled(LevelWarn)) {\n      lg.warn().str(\"transport\", \"smtps\").int(\"attempt\", i).str(\"error\", \"x\").log(\"mail retry\")\n    }\n"
  return "import { Logger, TextHandler, LevelWarn, LevelError } from \"std/log\"\n" +
    "import { stderr } from \"std/io\"\n\n" +
    "fn main() {\n" +
    "  let lg = Logger(TextHandler(stderr(), LevelError))\n" +
    "  if (lg.enabled(LevelWarn) || !lg.enabled(LevelError)) {\n" +
    "    panic(\"allocslope: mail_log_disabled fixture level wrong\")\n" +
    "  }\n" +
    "  let i = 0\n" +
    "  while (i < ${n}) {\n" +
    "    ${sent}" +
    "    ${retry}" +
    "    i = i + 1\n" +
    "  }\n" +
    "}\n"
}

// #7433. The records pkg/jobs' worker writes per job (`logJobStarted`,
// `logJobDone` and `logJobRetry`, pkg/jobs/joblog.bit) with the level off:
// the INFO `job started` record unguarded and the INFO `job done` record
// behind the `enabled` check that skips its duration read, and the WARN
// `job retry` record behind the check `logJobRetry` makes before it builds the
// error. A Logger at ERROR is called with all three per iteration. Slope 0:
// a queue whose logger drops a level pays nothing per job for that level. The
// level checks before the loop are the correctness floor, as in
// `logDisabledFixtureSource`.
fn jobsLogDisabledFixtureSource(n: int): string {
  let started = "lg.info().str(\"job\", \"send-welcome\").int(\"attempt\", i).log(\"job started\")\n"
  let done = "if (lg.enabled(LevelInfo)) {\n      lg.info().str(\"job\", \"send-welcome\").int(\"attempt\", i).duration(\"took\", i).log(\"job done\")\n    }\n"
  let retry = "if (lg.enabled(LevelWarn)) {\n      lg.warn().str(\"job\", \"send-welcome\").int(\"attempt\", i).err(newError(\"x\")).log(\"job retry\")\n    }\n"
  return "import { Logger, TextHandler, LevelInfo, LevelWarn, LevelError } from \"std/log\"\n" +
    "import { stderr } from \"std/io\"\n\n" +
    "fn main() {\n" +
    "  let lg = Logger(TextHandler(stderr(), LevelError))\n" +
    "  if (lg.enabled(LevelWarn) || !lg.enabled(LevelError)) {\n" +
    "    panic(\"allocslope: jobs_log_disabled fixture level wrong\")\n" +
    "  }\n" +
    "  let i = 0\n" +
    "  while (i < ${n}) {\n" +
    "    ${started}" +
    "    ${done}" +
    "    ${retry}" +
    "    i = i + 1\n" +
    "  }\n" +
    "}\n"
}

// #7435, #7438. std/log's ENABLED path: one record per iteration through a
// Logger whose `handler` ("TextHandler" or "JsonHandler") writes into a sink
// that only counts bytes, with `attrs` (0, 4 or 8) typed attributes added in
// the call through `info()` as pkg/web's request logger adds them. The
// slope is every object the record costs end to end. The byte count
// check is the correctness floor: a handler that wrote nothing cannot pass
// for a cheap one.
fn logEnabledFixtureSource(handler: string, attrs: int, n: int): string {
  let args = ""
  if (attrs >= 4) {
    args = ".str(\"method\", \"GET\").str(\"path\", \"/users/:id\").int(\"status\", i).duration(\"took\", i * 1000)"
  }
  if (attrs >= 8) {
    args = args +
      ".bool(\"ok\", true).int(\"bytes\", 1234).str(\"user\", \"a b\").duration(\"db\", 1500)"
  }
  return "import { Logger, ${handler} } from \"std/log\"\n\n" +
    "class Count { n: int }\n" +
    "class CountSink {\n  c: Count\n" +
    "  export write(s: string): ()! {\n    this.c.n = this.c.n + len(s)\n  }\n}\n\n" +
    "fn main() {\n" +
    "  let c = Count{ n = 0 }\n" +
    "  let lg = Logger(${handler}(CountSink{ c = c }))\n" +
    "  let i = 0\n" +
    "  while (i < ${n}) {\n" +
    "    lg.info()${args}.log(\"request\")\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  if (c.n < ${n} * 20) {\n" +
    "    panic(\"allocslope: log_enabled fixture wrote too little\")\n" +
    "  }\n" +
    "}\n"
}

// The enabled-record rows: name, handler, attribute count, pinned slope. Up
// to five attributes the record holds them in its own fields, so the cost is
// the Record and the line; the 8-attribute rows add the three past five in a
// chained Record and the one-element slice that holds it.
class LogRow { name: string, handler: string, attrs: int, slope: int }

fn logEnabledRows(): []LogRow {
  return []LogRow{
    LogRow{ name = "log_enabled_text_0", handler = "TextHandler", attrs = 0, slope = 2 },
    LogRow{ name = "log_enabled_text_4", handler = "TextHandler", attrs = 4, slope = 2 },
    LogRow{ name = "log_enabled_text_8", handler = "TextHandler", attrs = 8, slope = 5 },
    LogRow{ name = "log_enabled_json_0", handler = "JsonHandler", attrs = 0, slope = 2 },
    LogRow{ name = "log_enabled_json_4", handler = "JsonHandler", attrs = 4, slope = 2 },
    LogRow{ name = "log_enabled_json_8", handler = "JsonHandler", attrs = 8, slope = 6 },
  }
}

class Measured { ok: bool, exitCode: int, objects: int }

// Everything a build/run/measure step needs that does NOT vary per (row, N)
// — grouped so no function below carries more than 5 parameters (E0202).
class Ctx { t: Tally, bit: string, stdlib: string, scratch: string, ms: int }

fn buildFixture(ctx: Ctx, src: string, prog: string, tag: string): int! {
  let script = "#!/bin/sh\n" +
    "BIT_STDLIB=${ctx.stdlib}\nexport BIT_STDLIB\n" +
    "'${ctx.bit}' build '${src}' -o '${prog}'\n"
  return shell("${ctx.scratch}/build_${tag}.sh", script, ctx.ms)?
}

fn runFixture(ctx: Ctx, prog: string, tag: string): Measured! {
  let errPath = "${ctx.scratch}/err_${tag}.txt"
  let script = "#!/bin/sh\n" +
    "BIT_GC_STATS=1\nexport BIT_GC_STATS\n" +
    "exec '${prog}' > '${ctx.scratch}/out_${tag}.txt' 2> '${errPath}'\n"
  let code = shell("${ctx.scratch}/run_${tag}.sh", script, ctx.ms)?
  let err = readFile(errPath) catch _ {
    ""
  }
  let swept = intAfter(err, "swept=")
  let live = intAfter(err, "live=")
  if (swept < 0 || live < 0) {
    return Measured{ ok = false, exitCode = code, objects = 0 - 1 }
  }
  return Measured{ ok = true, exitCode = code, objects = swept + live }
}

// Builds and runs `row`'s fixture at exactly `n` calls, returning the
// `swept+live` object count, or -1 (having already recorded the failing
// checks under `ctx.t`) when either step could not be measured.
// `name` and `source` are already the (row, n)-specific values — this
// function no longer knows about `Row` at all, so it measures a `Row`'s
// stdlib fixture and a `DecRow`'s bare-expression fixture identically
// (#3982 comment 21: the decimal rows below cannot fit `Row`'s
// catch-and-panic wrapper, so the shared plumbing takes plain strings
// instead of owning the fixture shape).
fn measureAt(ctx: Ctx, name: string, source: string, n: int): int {
  let tag = "${name}_${n}"
  let src = "${ctx.scratch}/${tag}.bit"
  writeFile(src, source) catch e {
    check(ctx.t, false, "${name}: cannot write fixture: ${e.message()}")
    return 0 - 1
  }
  let prog = "${ctx.scratch}/${tag}"
  let build = buildFixture(ctx, src, prog, tag) catch e {
    check(ctx.t, false, "${name}: ${e.message()}")
    return 0 - 1
  }
  check(
    ctx.t,
    build == 0 && exists(prog),
    "${name}: fixture at N=${n} must compile (bit build exited ${build})",
  )
  if (build != 0 || !exists(prog)) {
    return 0 - 1
  }
  let run = runFixture(ctx, prog, tag) catch e {
    check(ctx.t, false, "${name}: ${e.message()}")
    return 0 - 1
  }
  check(
    ctx.t,
    run.exitCode == 0,
    "${name}: fixture at N=${n} must exit 0 (exited ${run.exitCode})",
  )
  check(
    ctx.t,
    run.ok,
    "${name}: no `[bit-gc] ... swept=N live=N` summary at N=${n} — the run was not measured",
  )
  if (run.exitCode != 0 || !run.ok) {
    return 0 - 1
  }
  return run.objects
}

// Measures `name` at `callsN` and `2*callsN` from the two already-rendered
// fixture sources, derives the marginal slope, and checks it against
// `wantSlope`. Prints the two counts and the derived slope unconditionally,
// pass or fail, so a failure names the exact numbers it was computed from.
fn evalRow(ctx: Ctx, name: string, wantSlope: int, srcN: string, src2N: string) {
  let objN = measureAt(ctx, name, srcN, callsN)
  let obj2N = measureAt(ctx, name, src2N, callsN * 2)
  if (objN < 0 || obj2N < 0) {
    return
  }
  let slope = (obj2N - objN) / callsN
  print("allocslope: ${name}: N=${callsN} objects=${objN}, 2N=${callsN * 2} objects=${obj2N}, slope=${slope}\n")
  check(
    ctx.t, slope == wantSlope,
      "${name}: slope ${slope} objects/call, want ${wantSlope} " +
      "(N=${callsN} objects=${objN}, 2N=${callsN * 2} objects=${obj2N})",
  )
}

fn runAll(t: Tally, scratch: string, ms: int) {
  let bit = bitBinary(scratch, ms) catch e {
    panic("allocslope: ${e.message()}")
  }
  let stdlib = env("BIT_STDLIB")
  if (len(stdlib) == 0) {
    check(t, false, "BIT_STDLIB is unset — this gate needs a real stdlib to import")
    return
  }
  let ctx = Ctx{ t = t, bit = bit, stdlib = stdlib, scratch = scratch, ms = ms }
  for row of rows() {
    evalRow(ctx, row.name, row.slope, fixtureSource(row, callsN), fixtureSource(row, callsN * 2))
  }
  for row of decimalRows() {
    evalRow(
      ctx, row.name, row.slope,
      decimalFixtureSource(row, callsN), decimalFixtureSource(row, callsN * 2),
    )
  }
  evalRow(
    ctx, "enum_try_chain", 0,
    enumTryChainFixtureSource(callsN), enumTryChainFixtureSource(callsN * 2),
  )
  evalRow(
    ctx, "generic_try_chain", 0,
    genericTryChainFixtureSource(callsN), genericTryChainFixtureSource(callsN * 2),
  )
  evalRow(
    ctx, "log_disabled_unguarded", 0,
    logDisabledFixtureSource(false, callsN), logDisabledFixtureSource(false, callsN * 2),
  )
  evalRow(
    ctx, "log_disabled_guarded", 0,
    logDisabledFixtureSource(true, callsN), logDisabledFixtureSource(true, callsN * 2),
  )
  evalRow(
    ctx, "orm_statement_disabled", 0,
    ormStatementDisabledFixtureSource(callsN), ormStatementDisabledFixtureSource(callsN * 2),
  )
  evalRow(
    ctx, "authz_disabled", 0,
    authzDisabledFixtureSource(callsN), authzDisabledFixtureSource(callsN * 2),
  )
  evalRow(
    ctx, "mail_log_disabled", 0,
    mailLogDisabledFixtureSource(callsN), mailLogDisabledFixtureSource(callsN * 2),
  )
  evalRow(
    ctx, "jobs_log_disabled", 0,
    jobsLogDisabledFixtureSource(callsN), jobsLogDisabledFixtureSource(callsN * 2),
  )
  for row of logEnabledRows() {
    evalRow(
      ctx, row.name, row.slope,
      logEnabledFixtureSource(row.handler, row.attrs, callsN),
      logEnabledFixtureSource(row.handler, row.attrs, callsN * 2),
    )
  }
}

fn main() {
  let ms = timeoutMs()
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  let scratch = "${tmp}/bit-allocslope-${uuidFormat(uuidV4())}"
  let t = Tally{ checks = 0, failures = 0 }

  mkdir(scratch) catch e {
    panic("allocslope: cannot create ${scratch}: ${e.message()}")
  }
  runAll(t, scratch, ms)

  if (t.checks < 2) {
    eprint("FAIL: only ${t.checks} checks ran, want at least 2\n")
    t.failures = t.failures + 1
  }
  if (t.failures > 0) {
    // `exit()` does not run pending defers (#3694, same shape as #3677) —
    // call teardown explicitly on both the PASS and FAIL paths.
    teardown(scratch, ms)
    println("allocslope: FAIL — ${t.failures} of ${t.checks} checks failed")
    exit(1)
  }
  teardown(scratch, ms)
  println("allocslope: PASS — ${t.checks} checks")
}

fn teardown(scratch: string, ms: int) {
  shell("${scratch}/rm.sh", "#!/bin/sh\nrm -rf '${scratch}'\n", ms) catch _ {
    return
  }
}

fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}
