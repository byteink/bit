// _tests_/bit/benchregex/baselines.bit — the committed baseline table for the
// std/regex throughput benchmark (#2055, epic #2025).
//
// Sibling of `benchregex.bit` in the same directory module: no `import`,
// one shared scope — same shape as _tests_/bit/benchgate/baselines.bit, whose
// own header explains why a data-only sibling needs none.
//
// PROVISIONAL. Every row below is `provisional: true`. Measured
// 2026-08-28 on the development Mac (18 cores) while at least nine other
// agents were concurrently building and testing in sibling worktrees, and
// shortly before the box was held for a ~50-minute release gate — exactly
// the "measurement of the fleet, not of the code" condition
// bitlang-ws/CLAUDE.md's fast-dev-loop section warns about at length (every
// wall-clock figure in that file's own history was wrong in the same
// direction for months, for the same reason). `nsPerOp` is
// `benchregex.bit`'s own MEDIAN of 11 reps from one such run.
//
// BEFORE TRUSTING A DELTA THIS PRINTS: re-measure on a quiet box (`uptime`
// load comfortably under ~5 on this 18-core machine, `pgrep -fl
// make-driver` empty) and replace the affected rows with `provisional:
// false` and the freshly measured number. Do not hand-edit a "corrected"
// number without re-running the harness — these are the harness's own
// output, not an estimate.

class Baseline {
  name: string,
  nsPerOp: f64,
  machine: string,
  provisional: bool,
}

fn regexBaselines(): []Baseline {
  let m = "dev Mac, 18-core, fleet-contended (>=9 agents), 2026-08-28"
  let out = []Baseline(0)
  out = append(
    out,
    Baseline{ name: "literal_hit_1mib", nsPerOp: 585100000.0, machine: m, provisional: true },
  )
  out = append(
    out,
    Baseline{ name: "literal_miss_1mib", nsPerOp: 508920292.0, machine: m, provisional: true },
  )
  out = append(
    out,
    Baseline{ name: "date_scan", nsPerOp: 69093208.0, machine: m, provisional: true },
  )
  out = append(
    out,
    Baseline{ name: "alternation_ten", nsPerOp: 252835208.0, machine: m, provisional: true },
  )
  out = append(
    out,
    Baseline{ name: "capture_groups", nsPerOp: 69833.0, machine: m, provisional: true },
  )
  out = append(
    out,
    Baseline{ name: "thread_churn", nsPerOp: 4940466.0, machine: m, provisional: true },
  )
  out = append(
    out,
    Baseline{ name: "compile_large_pattern", nsPerOp: 3379670.0, machine: m, provisional: true },
  )
  return out
}
