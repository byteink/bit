// _tests_/bit/fieldattrcollision/fieldattrcollision.bit — #5393 regression:
// a free function elsewhere in the SAME module (SPEC §17.1: one directory,
// one flat namespace) whose name matches a field attribute must not leave
// the reader with only the attribute's own span to go on.
//
// `fixture/loader.bit` declares `grouping(key: string): string` — the wrong
// shape for a field-attribute call (not fallible), the same mistake #5081's
// `manyToMany` made. `fixture/model.bit` puts `@grouping("g")` on a `@table`
// class field meant as plain #5051-recorded metadata; the author there has
// never heard of `loader.bit`. `attrNameResolvesToFunc`
// (compiler/classtabledesc.bit) resolves `grouping` anyway — a directory is
// one flat namespace, so scope is not the defect — and the resulting E0133
// used to name only the attribute, with nothing to point a reader at
// `loader.bit`. `noteFieldAttrDecl` (compiler/classfieldattr.bit) is what
// closes that gap, and is what this harness proves: the note must follow
// E0133, naming `grouping`'s OWN declaration in the OTHER file.
//
// `@id` on the SAME class has no colliding free function anywhere in this
// module, so it must still compile clean through classtabledesc.bit's
// RECORD path — proof the fix is surgical: `tags` is the only field an
// error ever names below.
//
// Usage: BIT_BIN=$PWD/bit-out/bin/bit BIT_STDLIB=$PWD/stdlib \
//   bit run _tests_/bit/fieldattrcollision

import { readFile, writeFile } from "std/fs"
import { envOr, exit } from "std/os"
import { indexOf } from "std/strings"
import { now } from "std/time"

const timeoutMs: int = 60000
const fixtureDir: string = "_tests_/bit/fieldattrcollision/fixture"

fn requiredEnv(name: string): string {
  let v = envOr(name, "")
  if (v == "") {
    eprint("fieldattrcollision: ${name} is not set\n")
    exit(2)
  }
  return v
}

fn mustContain(haystack: string, needle: string, errText: string) {
  if (indexOf(haystack, needle) >= 0) {
    return
  }
  eprint("fieldattrcollision: FAIL: stderr must contain:\n  ${needle}\ngot:\n${errText}\n")
  exit(1)
}

// Runs `bit check <fixtureDir>` under a deadline and returns its captured
// stderr. The script's own exit is always 0 (it records `bit check`'s exit
// code to `<script>.rc` rather than propagating it) so a nonzero return here
// means the CHILD failed to run at all — the fixture is asserted to be a
// compile-time REJECTION, checked separately from stderr's content below.
fn runCheck(bin: string): string {
  let script = "/tmp/bit-fieldattrcollision-${now().ns}.sh"
  let errPath = "${script}.err"
  let rcPath = "${script}.rc"
  let cmd = "#!/bin/sh\n\"${bin}\" check \"${fixtureDir}\" >/dev/null 2>\"${errPath}\"\necho $? > \"${rcPath}\"\n"
  writeFile(script, cmd) catch e {
    eprint("fieldattrcollision: cannot write ${script}: ${e.message()}\n")
    exit(2)
  }
  if (fsChmod(script, 493) != 0) {
    eprint("fieldattrcollision: cannot chmod ${script}\n")
    exit(2)
  }
  let rc = osRunBounded(script, timeoutMs)
  let errText = readFile(errPath) catch _ {
    ""
  }
  let checkRc = readFile(rcPath) catch _ {
    "?"
  }
  fsRemove(script)
  fsRemove(errPath)
  fsRemove(rcPath)
  if (rc != 0) {
    eprint("fieldattrcollision: FAIL: bit check did not run to completion (rc=${rc})\n${errText}\n")
    exit(1)
  }
  if (checkRc == "0") {
    eprint("fieldattrcollision: FAIL: expected `bit check ${fixtureDir}` to fail, exited 0\n")
    exit(1)
  }
  return errText
}

fn main() {
  let bin = requiredEnv("BIT_BIN")
  let errText = runCheck(bin)
  mustContain(
    errText,
    "error[E0133]: attribute '@grouping' on field 'tags' names a function that cannot fail",
    errText,
  )
  mustContain(
    errText,
    "note: 'grouping' is declared here: this free function is what '@grouping' resolves to, not a plain attribute",
    errText,
  )
  mustContain(errText, "loader.bit", errText)
  if (indexOf(errText, "'id'") >= 0) {
    eprint("fieldattrcollision: FAIL: the non-colliding '@id' attribute produced a diagnostic of its own:\n${errText}\n")
    exit(1)
  }
  print("fieldattrcollision: PASS\n")
}
