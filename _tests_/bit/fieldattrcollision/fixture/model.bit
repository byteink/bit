// #5393 regression fixture, file B of this module. `@grouping` is meant as
// plain #5051-recorded metadata on `tags` — the author has never heard of
// `./loader.bit` — but `grouping` (declared there, same module) makes
// `attrNameResolvesToFunc` (compiler/classtabledesc.bit) treat it as a call
// instead, and that call is the wrong shape (`loader.bit`'s own comment).
// `@id` carries no colliding free function anywhere in this module, so it
// must still compile clean through the RECORD path: the fix is proven
// surgical when `tags` is the only field an error names.
import { FieldDesc, AttrDesc } from "std/sql"

@table class Widget {
  @id
  id: i64
  @grouping("g")
  tags: []string
}
