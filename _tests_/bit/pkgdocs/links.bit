// The run-wide `Stats` accumulator and the prose markdown-link checker,
// split out of `_tests_/bit/pkgdocsgate.bit` (#6063) to keep that file under
// spec/LINT.md's 800-line ceiling — a pure move, same bodies, only the
// import edge changed. `pkgdocsgate.bit` owns the corpus walk, the
// package/dependency resolution and the child-process jobs; this file owns
// none of that, only "does this page's prose hold together" (#5401).

import { exists, readFile } from "std/fs"
import { exit } from "std/os"
import { clean, dir as pageDir, join } from "std/path"
import { contains, hasPrefix, indexOf, split, toLower, trimSpace } from "std/strings"

// A bound on markdown links per page — the densest page in this corpus
// today (`pkg/orm/docs/README.md`) carries about two dozen.
const maxLinksPerPage: int = 256

// Same "print and exit 1" contract as `pkgdocsgate.bit`'s own `fatal` — not
// shared across the MODULE boundary (`file-splits.md`), but shared WITHIN
// this module: `deps.bit`'s `parseDepsDirective` calls this exact
// declaration with no import, since this module's `.bit` files share one
// scope.
fn fatal(msg: string) {
  eprint("pkgdocsgate: ${msg}\n")
  exit(1)
}

export class Stats {
  export pages: int,
  export pagesWithBlocks: int,
  export totalBlocks: int,
  export jobs: int,
  export failures: int,
  export fmtFailures: int,
  export linksChecked: int,
  export linkFailures: int,
  export nextIdx: int, // the next scratch-dir index to hand out, so it survives across pages
}

export fn zeroStats(): Stats {
  return Stats{
    pages = 0, pagesWithBlocks = 0, totalBlocks = 0, jobs = 0, failures = 0, fmtFailures = 0,
    linksChecked = 0, linkFailures = 0, nextIdx = 0,
  }
}

// `md` with every fenced block's body removed — a line-oriented toggle on a
// `` ``` `` line, same "any info string, whole block" scope `extractBlocks`
// uses for the tag itself, so an example's own `[`/`]`/`(`/`)` bytes can
// never be mistaken for a markdown link in the prose scan below.
fn stripFences(md: string): string {
  let out = ""
  let inFence = false
  for line of split(md, "\n") {
    if (hasPrefix(trimSpace(line), "```")) {
      inFence = !inFence
      continue
    }
    if (!inFence) {
      out = out + line + "\n"
    }
  }
  return out
}

// A GitHub-style heading anchor: lowercase, letters/digits/`_`/`-` kept
// as-is, a space becomes `-`, everything else (backticks, punctuation)
// dropped. Verified against this repo's own headings: "`Dialect` vs
// `ServerDialect`" -> `dialect-vs-serverdialect` (`pkg/orm/README.md`,
// linked from `pkg/orm/docs/dialect.md`), and "upsert - insert or update in
// one statement, with two real limits" -> `upsert---insert-or-update-in-
// one-statement-with-two-real-limits` (`pkg/orm/docs/write.md`, linked from
// `pkg/orm/docs/version.md`) — the run of hyphens there is a literal `-`
// beside two collapsed spaces, not a bug.
fn slugify(text: string): string {
  let lower = toLower(text)
  let out = ""
  let i = 0
  let n = len(lower)
  while (i < n) {
    let ch = lower[i]
    if ((ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch == '_' || ch == '-') {
      out = out + string([ch])
    } else if (ch == ' ') {
      out = out + "-"
    }
    i = i + 1
  }
  return out
}

// Every ATX heading's (`#` through `######`, a space, then text) slug, in
// document order — duplicates included, since a set membership check is all
// a link target needs. `prose` is expected already fence-stripped, so a
// fenced example that happens to show markdown syntax never contributes a
// fake heading.
fn headingSlugs(prose: string): []string {
  let out = []string(0)
  for line of split(prose, "\n") {
    let t = trimSpace(line)
    if (!hasPrefix(t, "#")) {
      continue
    }
    let i = 0
    while (i < len(t) && t[i] == '#') {
      i = i + 1
    }
    if (i == 0 || i > 6 || i >= len(t) || t[i] != ' ') {
      continue
    }
    out = append(out, slugify(trimSpace(t[i:])))
  }
  return out
}

fn containsStr(items: []string, target: string): bool {
  for it of items {
    if (it == target) {
      return true
    }
  }
  return false
}

// Every `[text](target)` link's raw `target` in `prose`, document order, an
// image (`![...]`) excluded since its target is an asset, not a doc page. A
// forward scan: this corpus has no link text containing its own `[`/`]`, so
// the first `]` after an unmatched `[` is always the real close.
fn extractLinkTargets(prose: string): []string {
  let out = []string(0)
  let rest = prose
  let bound = 0
  while (bound < maxLinksPerPage) {
    bound = bound + 1
    let openRel = indexOf(rest, "[")
    if (openRel < 0) {
      break
    }
    let o = int(openRel)
    let isImage = o > 0 && rest[o - 1] == '!'
    let afterOpen = rest[o + 1:]
    let closeRel = indexOf(afterOpen, "]")
    if (closeRel < 0) {
      break
    }
    let cb = int(closeRel)
    let afterClose = afterOpen[cb + 1:]
    if (len(afterClose) == 0 || afterClose[0] != '(') {
      rest = afterOpen
      continue
    }
    let afterParen = afterClose[1:]
    let closeParenRel = indexOf(afterParen, ")")
    if (closeParenRel < 0) {
      break
    }
    let cp = int(closeParenRel)
    if (!isImage) {
      out = append(out, afterParen[:cp])
    }
    rest = afterParen[cp + 1:]
  }
  return out
}

// Whether `target` is one this gate can resolve on disk at all — an external
// URL or a `mailto:` has nothing here to check against.
fn isCheckableLink(target: string): bool {
  if (len(target) == 0) {
    return false
  }
  if (contains(target, "://")) {
    return false
  }
  if (hasPrefix(target, "mailto:")) {
    return false
  }
  return true
}

// `target` split on its first `#`: the file part (possibly empty, for a
// same-page anchor) and the anchor part (possibly empty, for a plain link).
fn splitTarget(target: string): (string, string) {
  let hashRel = indexOf(target, "#")
  if (hashRel < 0) {
    return (target, "")
  }
  let h = int(hashRel)
  return (target[:h], target[h + 1:])
}

// One link: its file part (if any) must exist relative to `page`'s own
// directory, and its anchor part (if any) must match a real heading slug in
// whichever file the link actually points at — the resolved file when there
// is one, `page` itself (via `selfHeadings`) otherwise.
fn checkOneLink(page: string, target: string, selfHeadings: []string, st: Stats): Stats {
  let out = st
  let (filePart, anchorPart) = splitTarget(target)
  let targetPage = page
  if (len(filePart) > 0) {
    targetPage = clean(join(pageDir(page), filePart))
    if (!exists(targetPage)) {
      out.linkFailures = out.linkFailures + 1
      eprint("\npkgdocsgate: FAIL ${page} links '${target}' — no such file: ${targetPage}\n")
      return out
    }
  }
  if (len(anchorPart) == 0) {
    return out
  }
  let headings = selfHeadings
  if (len(filePart) > 0) {
    let targetMd = readFile(targetPage) catch e {
      fatal("cannot read ${targetPage}: ${e.message()}")
      ""
    }
    headings = headingSlugs(stripFences(targetMd))
  }
  if (!containsStr(headings, anchorPart)) {
    out.linkFailures = out.linkFailures + 1
    eprint("\npkgdocsgate: FAIL ${page} links '${target}' — no heading '#${anchorPart}' in ${targetPage}\n")
  }
  return out
}

// One page's prose: every checkable link target must resolve, anchor
// included. Runs on every page this file reads, regardless of whether it
// carries any ```bit block at all.
export fn checkPageLinks(page: string, md: string, st: Stats): Stats {
  let out = st
  let prose = stripFences(md)
  let selfHeadings = headingSlugs(prose)
  for target of extractLinkTargets(prose) {
    if (!isCheckableLink(target)) {
      continue
    }
    out.linksChecked = out.linksChecked + 1
    out = checkOneLink(page, target, selfHeadings, out)
  }
  return out
}
