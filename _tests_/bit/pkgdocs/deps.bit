// `<!-- doctest: deps a b c -->` — a page's own line declaring extra
// first-party packages its scratch project must depend on, beyond the
// package under test and its own transitive `bit.json` deps (#6063, on top
// of #5127's `pkgdocsgate.bit`). Documented in `docs/STYLE.md`'s "Code
// blocks" section, alongside `<!-- doctest: per-block -->`.
//
// Split into its own file in the `pkgdocs` module (`file-splits.md`) rather
// than folded into `links.bit`: parsing a directive and resolving it against
// real `pkg/<name>` directories is a different concern from prose-link
// checking, and `pkgdocsgate.bit` needs both from the same import.
//
// `resolveDeclaredDeps` never calls `exit` itself — an unknown name is
// reported as `DepsResolution.ok == false`, and it is `pkgdocsgate.bit`'s
// own `pageDeps` that turns that into a gate failure. Kept a pure function
// on purpose: `pkgdocsgate.bit`'s fixture self-test calls it directly to
// prove the "unknown dep name" case fires, and a function that can `exit`
// the whole process mid-call cannot be called from a test that must keep
// running afterward.

import { isDir } from "std/fs"

// `join`, `indexOf`, `split`, `trimSpace` and this module's private `fatal`
// helper all come from `links.bit`'s own imports/declarations — a module's
// files share one scope (`file-splits.md`), so importing or declaring them
// again here would be `E0042 already declared in this scope`.

const depsDirectivePrefix: string = "<!-- doctest: deps "
const directiveClose: string = "-->"

// Bound on a directive line's own length (Power of 10 rule 2) — every real
// directive in this corpus is a handful of package names, nowhere near this.
const maxDirectiveLen: int = 512

// One more first-party dependency the scratch project must declare.
export class DepEntry { export name: string, export path: string }

// `resolveDeclaredDeps`'s verdict: either `deps` (base plus every newly
// resolved entry) or `ok == false` naming the one unresolved name in
// `message`.
export class DepsResolution { export ok: bool, export deps: []DepEntry, export message: string }

fn containsDep(deps: []DepEntry, name: string): bool {
  for d of deps {
    if (d.name == name) {
      return true
    }
  }
  return false
}

// `s` split on runs of spaces, empty tokens dropped — `deps postgres  orm`
// yields the same two names as `deps postgres orm`.
fn splitNames(s: string): []string {
  let out = []string(0)
  for part of split(s, " ") {
    let t = trimSpace(part)
    if (len(t) > 0) {
      out = append(out, t)
    }
  }
  return out
}

// `page`'s own `<!-- doctest: deps a b c -->` line's package names, or none
// when the page carries no such line. A marker with no closing `-->` within
// `maxDirectiveLen` bytes is a malformed page, not a silently-ignored one.
export fn parseDepsDirective(page: string, md: string): []string {
  let at = indexOf(md, depsDirectivePrefix)
  if (at < 0) {
    return []string(0)
  }
  let rest = md[int(at) + len(depsDirectivePrefix):]
  let bound = rest
  if (len(bound) > maxDirectiveLen) {
    bound = bound[:maxDirectiveLen]
  }
  let closeAt = indexOf(bound, directiveClose)
  if (closeAt < 0) {
    fatal("${page}: '<!-- doctest: deps ...' has no closing '-->' within ${maxDirectiveLen} bytes")
  }
  return splitNames(rest[:int(closeAt)])
}

// `names`' own `DepEntry`s, resolved against real `pkg/<name>` directories
// under `pkgDir` and appended to `base` — an unknown name stops at the
// first one, `ok = false`, `message` naming it (#6063's own acceptance: "an
// unknown name is a gate failure with a clear message"). A name equal to
// `pkgName` itself, or already present in `base`, is skipped rather than
// duplicated — a directive re-stating an already-declared dep is harmless.
export fn resolveDeclaredDeps(
  pkgDir: string,
  pkgName: string,
  names: []string,
  base: []DepEntry,
): DepsResolution {
  // A fresh backing array, never `base` itself: `base` is `pkg.deps`, the
  // SAME slice every other page of this package shares (`main`'s per-package
  // loop builds it once) — appending onto it in place would risk one page's
  // directive mutating a sibling page's already-resolved dependency list
  // (E0214).
  let out = []DepEntry(0)
  for d of base {
    out = append(out, d)
  }
  for name of names {
    if (name == pkgName || containsDep(out, name)) {
      continue
    }
    let depPath = join(pkgDir, name)
    if (!isDir(depPath)) {
      return DepsResolution{
        ok = false, deps = base,
        message = "unknown first-party package '${name}' in doctest deps directive",
      }
    }
    out = append(out, DepEntry{ name = name, path = depPath })
  }
  return DepsResolution{ ok = true, deps = out, message = "" }
}
