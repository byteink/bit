// The fixture phases of `windowssmoke.bit` (split out at its 800-line ceiling,
// #7817): each cross-builds one program under `_tests_/` against Phase 1's
// archive, ships it and asserts its output. `Session`, `buildFixture`,
// `shipAndRunThreadReg`, `teardown` and the rest are that file's, same module.

// PHASE 6 (#6434): Win64 makes xmm6..xmm15 nonvolatile (runtime/ABI.md section
// 9.1); _tests_/stress/thread/winxmm loads 128-bit patterns into xmm6 and xmm15
// via an `asm` stub, calls float-heavy Bit code and prints `winxmm ok` only when
// both survive. PHASE 8 (#7480): dnsv6windows (an IPv6 nameserver; needs `env`
// workers). PHASE 10 (#5808): fsbeneathwindows, whose `env` builds its links.
// PHASE 11 (#7817): fsbeneathracewindows, the link-swap races (`fsrPrelude` below).
fn runFixturePhase(s: Session, archivePath: string, fixture: string, needle: string, env: string) {
  let exePath = buildFixture(s, archivePath, "_tests_/stress/thread/${fixture}", fixture)
  let outRun = shipAndRunThreadReg(s, exePath, fixture, env)
  if (!contains(outRun, needle)) {
    teardown(s.scratch, s.host, s.runId, s.ms)
    println("windowssmoke: FAIL — ${fixture} did not print '${needle}':")
    eprint(outRun)
    exit(1)
  }
  println("windowssmoke: ${fixture} — PASS, ${s.host}")
}

// PHASE 7 (#6469): Windows used to start no sysmon thread, so a compute-bound
// green task was never preempted. Each fixture below runs BIT_WORKERS=1 (their
// `workers` files) so the spinning task and its peer share one worker; on a
// build with no monitor thread the first prints "peer starved" and exits 1,
// which `shipAndRunThreadReg` reports as a failed run. `schedpreemptidle` also
// proves the monitor parks while idle (ticks <= 10 and >= 1 park in 200ms).
fn runPreemptPhase(s: Session, archivePath: string) {
  let names = ["schedpreempt", "schedpreemptidle"]
  for name of names {
    let exePath = buildFixture(s, archivePath, "_tests_/stress/${name}", name)
    let outRun = shipAndRunThreadReg(s, exePath, name, "\\$env:BIT_WORKERS='1'; ")
    if (!contains(outRun, "${name}: ok")) {
      teardown(s.scratch, s.host, s.runId, s.ms)
      println("windowssmoke: FAIL — ${name} did not print '${name}: ok':")
      eprint(outRun)
      exit(1)
    }
  }
  println("windowssmoke: sysmon preemption and idle park — PASS, ${s.host}")
}

// PHASE 9 (#5802): _tests_/windows/osruncaptured proves bit_rt_os_run_captured
// (pipe capture, 4 MiB cap, bounded wait) on Windows. Each child and
// mainwindows.bit is its own program, so each is built from its one file and
// all six ship into one remote directory that BIT_OSRUNCAP_DIR names. A
// primitive that regresses (e.g. no STARTF_USESTDHANDLES) bails with rc=1.
fn runOsRunCapturedPhase(s: Session, archivePath: string) {
  let dir = "${s.runId}-osrun"
  let names = [
    "childsmall_windows", "childbig_windows", "childtrunc_windows", "childslow_windows",
    "childmanyprints_windows", "mainwindows",
  ]
  let (rcMk, outMk) = remote(s, "osrun-mkdir", "'New-Item -ItemType Directory ${dir}'")
  if (rcMk != 0) {
    failStage(s, "create ${dir} on ${s.host}", rcMk, outMk)
  }
  for name of names {
    let exe = buildFixture(s, archivePath, "_tests_/windows/osruncaptured/${name}.bit", name)
    shipFile(s, exe, "${dir}/${name}.exe", name)
  }
  let prelude = "\\$env:BIT_OSRUNCAP_DIR = Join-Path \\$PWD.Path '${dir}'; "
  let (rcRun, outRun) = runChild(s, "osrun-run", prelude, "${dir}/mainwindows.exe", "")
  let _ = remote(s, "osrun-cleanup", "'Remove-Item -Recurse -Force ${dir}'")
  if (rcRun != 0) {
    failStage(s, "run osruncaptured on ${s.host}", rcRun, outRun)
  }
  requireOutput(s, outRun, "PASS", " (the osruncaptured fixture did not finish)")
  println("windowssmoke: osruncaptured — PASS, ${s.host}")
}

// PHASE 5 (#5801): a many-small-print() regression guard for the child's own
// `print()` -> `WriteFile` path (runtime/root/windows/io.bit's
// `rootWriteAll`/`rootPrint`) under a REAL redirect on real hardware.
//
// #5801's own triage found NO byte loss in that path — a 43,000-call/98-
// byte-line repro (4,214,000 bytes) round-tripped byte-for-byte through both
// a `cmd /c "... > file"` redirect and a raw, backpressured .NET pipe read,
// with a temporary GetLastError()/WriteFile-return-value probe recording
// ZERO short or failed writes. The reported "43,000 bytes short" instead
// exactly matches (to the byte) PowerShell's own line-splitting: `Get-Item`
// on a `cmd`-redirected file, vs. `Get-Content | Measure-Object -Character`
// on the SAME file, differ by exactly one byte per line (a 3-line/33-byte
// sanity file measures 30 characters) — `Measure-Object -Character` strips
// every line object's trailing `\n` before counting. That is why this gate
// asserts via `cmd /c "... > file"` + `(Get-Item ...).Length` — a raw HANDLE
// redirect with no text reprocessing — and NEVER a PowerShell `>` (which
// itself re-encodes native stdout as UTF-16, Windows PowerShell 5.1's
// `Out-File` default) or a text cmdlet pipe.
const manyPrintsLineLen: int = 98
const manyPrintsCount: int = 20000

// Cross-builds the many-prints program against `archivePath` and returns the
// built exe path — same shape as `buildProgram` above.
fn buildManyPrintsProgram(s: Session, archivePath: string): string {
  let progDir = "${s.scratch}/manyprints"
  mkdir(progDir) catch e {
    panic("windowssmoke: cannot create ${progDir}: ${e.message()}")
  }
  let line = repeat("a", 97)
  writeFile(
    "${progDir}/main.bit",
      "fn main() {\n" +
      "  let line = \"${line}\\n\"\n" +
      "  let i = 0\n" +
      "  while (i < ${manyPrintsCount}) {\n" +
      "    print(line)\n" +
      "    i = i + 1\n" +
      "  }\n" +
      "}\n",
  ) catch e {
    panic("windowssmoke: cannot write ${progDir}/main.bit: ${e.message()}")
  }
  return buildFixture(s, archivePath, progDir, "manyprints")
}

// Ships `exePath`, runs it on `s.host` with stdout redirected through
// `cmd /c "... > file"` (see the header above for why this and not a
// PowerShell `>`/pipe), and asserts the redirected file's exact byte length.
fn shipAndRunManyPrints(s: Session, exePath: string) {
  let remoteName = "${s.runId}-manyprints.exe"
  let outName = "${s.runId}-manyprints.out"
  shipFile(s, exePath, remoteName, "manyprints")
  let (rcRun, outRun) = runChild(s, "manyprints-run", "", remoteName, outName)
  if (rcRun != 0) {
    failStage(s, "run manyprints on ${s.host}", rcRun, outRun)
  }
  let (rcLen, outLen) = remote(s, "manyprints-len", "\"(Get-Item ${outName}).Length\"")
  let _ = remote(s, "manyprints-cleanup", "'Remove-Item -Force ${remoteName},${outName}'")
  if (rcLen != 0) {
    failStage(s, "read manyprints output length on ${s.host}", rcLen, outLen)
  }
  let want = manyPrintsCount * manyPrintsLineLen
  let got = parseInt(trimSpace(outLen)) catch _ {
    failStage(s, "parse manyprints output length '${trimSpace(outLen)}'", 1, outLen)
    0 - 1
  }
  if (got != want) {
    teardown(s.scratch, s.host, s.runId, s.ms)
    println("windowssmoke: FAIL — manyprints wrote ${got} bytes, want ${want} (redirected stdout, ${manyPrintsCount} print() calls of ${manyPrintsLineLen} bytes each)")
    exit(1)
  }
  println("windowssmoke: manyprints byte-exact — PASS (${got} bytes over ${manyPrintsCount} print() calls, ${s.host})")
}

// #5808: the junctions and symlinks around fsbeneathwindows's scratch root (std/fs makes no links).
const fsbPrelude = "\\$b = Join-Path \\$PWD.Path ('fsb-' + [guid]::NewGuid().ToString('N')); \\$r = Join-Path \\$b 'root'; \\$o = Join-Path \\$b 'outside'; New-Item -ItemType Directory -Force \\$r,\\$o | Out-Null; New-Item -ItemType Junction -Path (Join-Path \\$r 'jlink') -Target \\$o | Out-Null; New-Item -ItemType Junction -Path (Join-Path \\$b 'rootlink') -Target \\$r | Out-Null; Set-Content -Path (Join-Path \\$o 'secret.txt') -Value x; New-Item -ItemType SymbolicLink -Path (Join-Path \\$r 'dlink') -Target \\$o -ErrorAction SilentlyContinue | Out-Null; New-Item -ItemType SymbolicLink -Path (Join-Path \\$r 'flink') -Target (Join-Path \\$o 'secret.txt') -ErrorAction SilentlyContinue | Out-Null; \\$env:BIT_FSB_DIR = \\$b; "

// #7817: the junctions the fsbeneathracewindows races swap, each `P 'x/y'` a path
// under a fresh `fsr-<guid>` directory. `rp` -> `d1` (all real) and `L` -> `d2`
// (`root/a` is a junction to `outside`) are the pair swapped in the ROOT's own path;
// `q/root/L` -> `outside` is the partner of the real `q/root/a` in REL's path.
// BIT_WORKERS=4 so the swapper and the opener really run in parallel.
fn fsrPrelude(): string {
  let steps = [
    "\\$b = Join-Path \\$PWD.Path ('fsr-' + [guid]::NewGuid().ToString('N'))",
    "function P(\\$x) { Join-Path \\$b \\$x }",
    "\\$ch = 'b/c/d/e/f/g/h/i/j/k/l/m/n/o'",
    "New-Item -ItemType Directory -Force (P ('outside/' + \\$ch)),(P ('d1/root/a/' + \\$ch)),(P 'd2/root'),(P ('q/root/a/' + \\$ch)) | Out-Null",
    "Set-Content -NoNewline -Path (P ('outside/' + \\$ch + '/target.txt')) -Value 'OUTSIDE-LEAK'",
    "Set-Content -NoNewline -Path (P ('d1/root/a/' + \\$ch + '/target.txt')) -Value 'INSIDE'",
    "Set-Content -NoNewline -Path (P ('q/root/a/' + \\$ch + '/target.txt')) -Value 'INSIDE'",
    "New-Item -ItemType Junction -Path (P 'd2/root/a') -Target (P 'outside') | Out-Null",
    "New-Item -ItemType Junction -Path (P 'q/root/L') -Target (P 'outside') | Out-Null",
    "New-Item -ItemType Junction -Path (P 'rp') -Target (P 'd1') | Out-Null",
    "New-Item -ItemType Junction -Path (P 'L') -Target (P 'd2') | Out-Null",
    "\\$env:BIT_FSB_DIR = \\$b",
    "\\$env:BIT_WORKERS = 4",
  ]
  return join(steps, "; ") + "; "
}

// PHASE 12 (#7829): a returned `main` ends the process while threads sit in a raw
// `recvfrom` with no timeout. exitblockedwindows blocks a raw OS thread and, with
// EXITBLOCKED_TASK, a scheduler worker (BIT_WORKERS=4; at one worker `main` would
// never run again), prints a `unixms=` stamp and returns 7. `runchild.ps1` with
// WSMOKE_LAG reports how long after the stamp the process ended: each run must
// return 7 and end within `exitLagMaxMs`. The worker join used to wait 15 s for a
// blocked worker, so the BIT_WORKERS=4 run showed `lag-ms=15000`.
const exitBlockedRuns: int = 10
const exitLagMaxMs: int = 1000

fn runExitBlockedPhase(s: Session, archivePath: string) {
  let exePath = buildFixture(
    s,
    archivePath,
    "_tests_/stress/thread/exitblockedwindows",
    "exitblocked",
  )
  let remoteName = "${s.runId}-exitblocked.exe"
  shipFile(s, exePath, remoteName, "exitblocked")
  let lag = "\\$env:WSMOKE_LAG='1'; "
  assertExitLags(s, remoteName, "BIT_WORKERS=1, raw thread", lag + "\\$env:BIT_WORKERS=1; ")
  assertExitLags(
    s, remoteName, "BIT_WORKERS=4, raw thread and worker",
    lag + "\\$env:BIT_WORKERS=4; \\$env:EXITBLOCKED_TASK=1; ",
  )
  let _ = remote(s, "exitblocked-cleanup", "'Remove-Item -Force ${remoteName}'")
  println("windowssmoke: exit with blocked threads — PASS, ${s.host}")
}

// Runs `exe` `exitBlockedRuns` times under `prelude` and fails on a run that does
// not return 7, prints no lag line, or ends later than `exitLagMaxMs` after `main`.
fn assertExitLags(s: Session, exe: string, label: string, prelude: string) {
  let worst = 0
  let run = 0
  while (run < exitBlockedRuns) {
    let (rc, out) = runChild(s, "exitblocked-run", prelude, exe, "")
    let text = extractPrefixed(out, "wsmoke-run: lag-ms=")
    let ms = parseInt(text) catch _ {
      0 - 1
    }
    if (rc != 7 || ms < 0 || ms > exitLagMaxMs) {
      teardown(s.scratch, s.host, s.runId, s.ms)
      println("windowssmoke: FAIL — exitblocked (${label}) run ${run}: exit ${rc}, lag-ms '${text}' (want exit 7 and 0 to ${exitLagMaxMs}):")
      eprint(out)
      exit(1)
    }
    if (ms > worst) {
      worst = ms
    }
    run = run + 1
  }
  println("windowssmoke: exitblocked (${label}) — ${exitBlockedRuns} of ${exitBlockedRuns} runs exit 7, worst lag ${worst} ms")
}
