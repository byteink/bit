// #8210: exercise the real package-tag gate against an isolated tagged repo.
// Run with BIT_REPO=<source repo> BIT_BIN=<compiler> BIT_WORKERS=2 bit run this file.
import { writeFile } from "std/fs"
import { env, envOr } from "std/os"
import { contains } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"
import {
  Capture, CliEnv, Run, fatal, mkdirp, mustSucceed, rmrf, runBitCli, shQuote,
} from "./pmvanityhelpers"

const checkName: string = "packagetagsselection"

fn put(path: string, text: string) {
  writeFile(path, text) catch e {
    fatal(checkName, "cannot write ${path}: ${e.message()}")
  }
}

fn require(ok: bool, detail: string) {
  if (!ok) {
    fatal(checkName, detail)
  }
}

fn tagFixture(root: string, paths: string, tags: []string) {
  let git = "git -C " +
    shQuote(root) +
    " -c user.name='Mustafa Dwaikat' -c user.email='mudwekat@gmail.com'" +
    " -c commit.gpgsign=false -c tag.gpgsign=false"
  let script = "set -e\nexport GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null\n" +
    git +
    " add " +
    paths +
    "\n" +
    git +
    " commit --quiet -m fixture\n"
  for tag of tags {
    script = script + git + " tag -a " + shQuote(tag) + " -m fixture\n"
  }
  mustSucceed(checkName, "commit and tag fixture", script)
}

fn fixture(root: string) {
  for name of ["renamed", "added", "pending"] {
    mkdirp(checkName, "${root}/pkg/${name}")
  }
  put(root + "/pkg/renamed/api.bit", "export fn Published(): int { return 1 }\n")
  put(root + "/pkg/renamed/a.test.bit", "export fn TestOnly(): int { return 1 }\n")
  put(root + "/pkg/added/z.bit", "export fn Stable(): int { return 1 }\n")
  put(root + "/pkg/pending/api.bit", "export fn Pending(): int { return 1 }\n")
  mustSucceed(
    checkName, "initialize fixture",
      "set -e\nGIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null git init --quiet -b main " +
      shQuote(root) +
      "\n",
  )
  tagFixture(root, "pkg/renamed pkg/added pkg/pending", ["renamed/v0.1.0", "added/v0.1.0"])
  put(root + "/pkg/renamed/api.bit", "export fn HeadOnly(): int { return 1 }\n")
  put(root + "/pkg/added/a.bit", "export fn Added(): int { return 1 }\n")
}

fn runGate(cli: CliEnv, source: string, root: string, label: string): Run {
  let r = runBitCli(
    checkName, cli,
    ["BIT_REPO=" + root, "BIT_BIN=" + cli.bitExe, "BIT_WORKERS=2", "BIT_WORKSPACE=off"],
    ["run", source + "/_tests_/bit/packagetagsgate.bit"],
    Capture{ outPath = root + "/${label}.out", errPath = root + "/${label}.err" },
  )
  print("${checkName}: ${label} exit ${r.code}\nstdout:\n${r.stdout}\nstderr:\n${r.stderr}\n")
  return r
}

fn validSelection(r: Run) {
  require(r.code == 0, "valid tagged modules failed: exit ${r.code}\n${r.stdout}\n${r.stderr}")
  require(contains(r.stdout, "ok pkg/renamed@renamed/v0.1.0\n"), "renamed export was not judged")
  require(contains(r.stdout, "ok pkg/added@added/v0.1.0\n"), "added first export was not judged")
  require(contains(r.stdout, "2 of 2 published package(s) build\n"), "wrong published denominator")
  require(
    contains(r.stdout, "pkg/pending has no published <name>/v* tag yet — skipped\n"),
    "unpublished package skip was not explicit",
  )
}

fn brokenModule(cli: CliEnv, source: string, root: string) {
  mkdirp(checkName, root + "/pkg/broken")
  put(root + "/pkg/broken/api.bit", "export fn Broken(): int { return missingTaggedValue }\n")
  tagFixture(root, "pkg/broken", ["broken/v0.1.0"])
  let r = runGate(cli, source, root, "broken")
  require(r.code == 1, "broken tagged module returned ${r.code}, want 1\n${r.stdout}\n${r.stderr}")
  require(contains(r.stdout, "2 of 3 published package(s) build\n"), "broken module was not judged")
  require(contains(r.stderr, "pkg/broken@broken/v0.1.0"), "failure lost its tagged provider")
  require(
    contains(r.stderr, "error[E0040]"),
    "failure lost the compiler's undefined-name diagnostic",
  )
  require(contains(r.stderr, "missingTaggedValue"), "failure did not identify the broken module")
}

fn main() {
  let source = env("BIT_REPO")
  require(len(source) > 0, "BIT_REPO must name the source repo")
  let root = "/tmp/bit-packagetagsselection-" + uuidFormat(uuidV4())
  mkdirp(checkName, root)
  fixture(root)
  let cli = CliEnv{
    bitExe = envOr("BIT_BIN", source + "/bit-out/bin/bit"),
    stdRoot = envOr("BIT_STDLIB", source + "/stdlib"),
    pkgCache = root + "/outer-cache", projDir = root,
  }
  validSelection(runGate(cli, source, root, "valid"))
  brokenModule(cli, source, root)
  rmrf(root)
  print("packagetagsselection: renamed export, added export, unpublished skip, broken module — ok\n")
}
