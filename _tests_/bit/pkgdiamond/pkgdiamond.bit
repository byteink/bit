// _tests_/bit/pkgdiamond/pkgdiamond.bit -- #7558: an app that imports two
// packages sharing a third (a diamond) type-checks, in workspace mode and with
// BIT_WORKSPACE=off.
//
// The reported failure was `E0042 'Json' is already declared` in pkg/redis when
// an app imported pkg/authz beside pkg/jobs. The package was NOT loaded twice
// (the loader memoizes a module by its canonical directory): authz declares an
// interface with a `__field` method, so the compiler synthesizes `__field` on
// the exported-scalar classes of every module loaded after it, and the
// synthesis imports std/json's `Json` into the module. pkg/redis declares its
// own `Json`, so the import collided. `compiler/classfieldread.bit`
// (`collectFieldReadClasses`) now skips a module that declares `Json` itself.
//
// `fixture/pkgs/shared` is that shape: its own `Json` beside a class with
// exported scalar fields. `readable` holds the `__field` interface; `left` and
// `right` both import `shared`. Two app directories use the same packages:
//   fixture/ws   bit.lock entries that are released-looking (vanity, url,
//                commit) and resolve only through fixture/bit.work
//   fixture/off  bit.lock `path` entries, run with BIT_WORKSPACE=off
// ANTI-VACUITY: the workspace run uses BIT_WORKSPACE=verbose and must print a
// redirect line for all four packages, so "ws resolved" cannot mean "the lock
// was never consulted"; both runs must exit 0 with empty stderr beyond those
// lines; and the app class in main.bit still needs its synthesized `__field`
// to type-check, so skipping every module would fail the run too.
//
// Usage: BIT_BIN=$PWD/bit-out/bin/bit BIT_STDLIB=$PWD/stdlib \
//   bit run _tests_/bit/pkgdiamond
import { readFile, writeFile } from "std/fs"
import { envOr, exit } from "std/os"
import { indexOf } from "std/strings"
import { now } from "std/time"

const timeoutMs: int = 120000
const fixtureDir: string = "_tests_/bit/pkgdiamond/fixture"

class Run { code: string, err: string }

fn requiredEnv(name: string): string {
  let v = envOr(name, "")
  if (v == "") {
    eprint("pkgdiamond: ${name} is not set\n")
    exit(2)
  }
  return v
}

fn die(msg: string) {
  eprint("pkgdiamond: FAIL: ${msg}\n")
  exit(1)
}

// `bit check main.bit` from `<fixtureDir>/<app>` with BIT_WORKSPACE=`mode`
// ("" leaves it unset). The script records the exit code in a file, so a
// nonzero `osRunBounded` result means the wrapper itself failed.
fn runCheck(bin: string, app: string, mode: string): Run {
  let script = "/tmp/bit-pkgdiamond-${now().ns}.sh"
  let errPath = "${script}.err"
  let rcPath = "${script}.rc"
  let setMode = "unset BIT_WORKSPACE"
  if (mode != "") {
    setMode = "BIT_WORKSPACE=${mode}\nexport BIT_WORKSPACE"
  }
  let cmd = "#!/bin/sh\n${setMode}\ncd \"${fixtureDir}/${app}\" || exit 99\n\"${bin}\" check main.bit >/dev/null 2>\"${errPath}\"\necho $? > \"${rcPath}\"\n"
  writeFile(script, cmd) catch e {
    eprint("pkgdiamond: cannot write ${script}: ${e.message()}\n")
    exit(2)
  }
  if (fsChmod(script, 493) != 0) {
    eprint("pkgdiamond: cannot chmod ${script}\n")
    exit(2)
  }
  let rc = osRunBounded(script, timeoutMs)
  let errText = readFile(errPath) catch _ {
    ""
  }
  let checkRc = readFile(rcPath) catch _ {
    "?"
  }
  fsRemove(script)
  fsRemove(errPath)
  fsRemove(rcPath)
  if (rc != 0) {
    die("the wrapper for ${app} did not run to completion (rc=${rc})\n${errText}")
  }
  return Run{ code = checkRc, err = errText }
}

fn mustPass(r: Run, label: string) {
  if (r.code != "0\n" && r.code != "0") {
    die("${label}: bit check exited ${r.code}, want 0:\n${r.err}")
  }
  if (indexOf(r.err, "error") >= 0) {
    die("${label}: stderr carries a diagnostic:\n${r.err}")
  }
}

fn main() {
  let bin = requiredEnv("BIT_BIN")
  let off = runCheck(bin, "off", "off")
  mustPass(off, "BIT_WORKSPACE=off")
  let ws = runCheck(bin, "ws", "verbose")
  mustPass(ws, "workspace")
  for p of ["readable", "shared", "left", "right"] {
    if (indexOf(ws.err, "(example.org/pkg/${p}) ->") < 0) {
      die("workspace run never redirected ${p}:\n${ws.err}")
    }
  }
  print("pkgdiamond: PASS\n")
}
