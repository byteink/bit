import { Json } from "std/json"

// The interface that makes the compiler synthesize `__field` (SPEC §14.3) on
// every class of every module that loads after this one.
export interface Readable {
  __field(name: string): Option<Json>,
}

export fn describe(r: Readable, name: string): string {
  return match (r.__field(name)) {
    Some(j) => show(j)
    None => "none"
  }
}

fn show(j: Json): string {
  return match (j) {
    JsonString(s) => "str ${s}"
    JsonInt(i) => "int ${i}"
    _ => "other"
  }
}
