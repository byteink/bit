// The shared third package of the diamond. Like pkg/redis it declares its OWN
// `Json` (a handle class) beside a class with exported scalar fields, so a
// `__field` synthesized here would import std/json's `Json` over it.
export class Json {
  owner: string,
  key: string,
}

export class Info {
  export name: string,
  export size: int,
}

export fn handle(owner: string): Json {
  return Json{ owner = owner, key = "k" }
}

export fn info(name: string): Info {
  return Info{ name = name, size = len(name) }
}
