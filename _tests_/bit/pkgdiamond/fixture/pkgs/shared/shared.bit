import { jsonEncode } from "std/json"

// The shared third package of the diamond. Like pkg/redis it declares its OWN
// `Json` (a handle class) next to a class with exported scalar fields (`Info`,
// read through `__field`) and an `@json` class (`Wire`, written through
// `toJson`): both syntheses are written in terms of std/json's `Json`, which
// must not be confused with this one.
export class Json {
  owner: string,
  key: string,
}

export class Info {
  export name: string,
  export size: int,
}

@json class Wire {
  name: string,
  size: int,
}

export fn handle(owner: string): Json {
  return Json{ owner = owner, key = "k" }
}

export fn info(name: string): Info {
  return Info{ name = name, size = len(name) }
}

export fn wire(name: string): string {
  return jsonEncode(Wire{ name = name, size = len(name) }.toJson())
}
