import { describe } from "readable"
import { leftInfo } from "left"
import { rightInfo } from "right"

// An app class: `describe` reaches it through the `__field` the compiler
// synthesizes, so it must still get one when the shared package is skipped.
class User {
  export name: string,
  export age: int,
}

fn main() {
  println(describe(User{ name = "ada", age = 36 }, "name"))
  println(leftInfo().name + rightInfo().name)
}
