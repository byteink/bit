// tests/bit/classkeyword.bit — final phase of the class-keyword migration
// (#3427, epic #3424): `class` is the sole record-declaration keyword and
// the retired spelling is rejected with E0102, naming `class` as the
// replacement, rather than falling through to a generic parse error.
//
// NOT placed in tests/cases/: that corpus is swept by every
// scripts/selfhost-diff*.sh differential (CORPUS="stdlib examples
// tests/cases tests/imports" in scripts/selfhost-diffdump.sh) against the
// PINNED STAGE0 oracle, which still accepts the retired spelling (#3425's
// synonym window). A fixture in that corpus that is EXPECTED to fail on the
// CURRENT compiler but succeed on the oracle would redden every differential
// by construction — the same "route it to tests/bit/ behind a registered
// gate" treatment tests/bit/golden.bit's own header documents for a
// not-yet-released diagnostic. So this drives the CLI directly instead,
// outside the oracle-swept corpus.
//
// WIRED INTO `./make test` as `test-classkeyword` (tools/build/gates.bit,
// tools/build/defs.bit).

import { env, envOr, exit } from "std/os"
import { readFile, writeFile, mkdir } from "std/fs"
import { parseInt, trimSpace, contains } from "std/strings"

const defaultTimeoutS: int = 60
const maxTimeoutMs: int = 6000000

fn requiredEnv(name: string): string {
  let v = env(name)
  if (v == "") {
    eprint("classkeyword: ${name} is not set — refusing to guess.\n")
    exit(2)
  }
  return v
}

// Same contract every harness here shares: default 60s (this gate builds one
// tiny one-file program and attempts a second that must fail), `0` disables
// the bound.
fn timeoutMs(): int {
  let raw = trimSpace(envOr("BIT_TEST_TIMEOUT_S", ""))
  if (raw == "") {
    return defaultTimeoutS * 1000
  }
  let s = parseInt(raw) catch _ {
    return defaultTimeoutS * 1000
  }
  if (s <= 0) {
    return maxTimeoutMs
  }
  if (s * 1000 > maxTimeoutMs) {
    return maxTimeoutMs
  }
  return s * 1000
}

fn shQuote(s: string): string {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    if (s[i] == 39) { // '
      out = out + "'\\''"
    } else {
      out = out + s[i:i + 1]
    }
    i = i + 1
  }
  return out + "'"
}

// Builds `srcPath` to `outPath`, cd'd into `dir`, with the compiler's own
// environment (BIT_STDLIB/BIT_LIBBITRT) exported. Returns the wrapper's exit
// code and captured stderr.
fn buildOne(bin: string, stdlib: string, libbitrt: string, dir: string, srcPath: string, outPath: string): (int, string) {
  let shPath = dir + "/build.sh"
  let errPath = dir + "/build.err"
  let script = "#!/bin/sh\n" +
    "BIT_STDLIB=" + shQuote(stdlib) + "\nexport BIT_STDLIB\n" +
    "BIT_LIBBITRT=" + shQuote(libbitrt) + "\nexport BIT_LIBBITRT\n" +
    "exec " + shQuote(bin) + " build " + shQuote(srcPath) + " -o " + shQuote(outPath) +
    " > /dev/null 2> " + shQuote(errPath) + "\n"
  writeFile(shPath, script) catch e {
    eprint("classkeyword: cannot write build wrapper: ${e.message()}\n")
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("classkeyword: cannot chmod build wrapper\n")
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let err = readFile(errPath) catch _ { "" }
  return code, err
}

// Runs the built binary at `binPath` (no compiler environment forwarded —
// the program under test is not the compiler's business). Returns its exit
// code and captured stdout.
fn runOne(dir: string, binPath: string): (int, string) {
  let shPath = dir + "/run.sh"
  let outPath = dir + "/run.out"
  let script = "#!/bin/sh\nexec " + shQuote(binPath) + " > " + shQuote(outPath) + " 2>&1\n"
  writeFile(shPath, script) catch e {
    eprint("classkeyword: cannot write run wrapper: ${e.message()}\n")
    exit(2)
  }
  if (fsChmod(shPath, 448) != 0) { // 0o700
    eprint("classkeyword: cannot chmod run wrapper\n")
    exit(2)
  }
  let code = osRunBounded(shPath, timeoutMs())
  let out = readFile(outPath) catch _ { "" }
  return code, out
}

fn main() {
  let bin = requiredEnv("BIT_BIN")
  let stdlib = requiredEnv("BIT_STDLIB")
  let libbitrt = requiredEnv("BIT_LIBBITRT")

  let scratch = envOr("TMPDIR", "/tmp") + "/bit-classkeyword-${timeUnixNs()}"
  mkdir(scratch) catch e {
    eprint("classkeyword: cannot create scratch directory ${scratch}: ${e.message()}\n")
    exit(2)
  }

  // `class` must still compile and run correctly: the retired-keyword
  // rejection below must not have collateral damage on the live spelling.
  let classSrc = "class Point { a: int, b: int, sum(): int { return this.a + this.b } }\n\n" +
    "fn main() {\n  let p = Point{ a: 3, b: 4 }\n  print(\"\${p.sum()}\\n\")\n}\n"
  // The retired spelling, otherwise byte-identical, so the ONLY variable
  // under test is the keyword itself.
  let oldSrc = "struct Point { a: int, b: int, sum(): int { return this.a + this.b } }\n\n" +
    "fn main() {\n  let p = Point{ a: 3, b: 4 }\n  print(\"\${p.sum()}\\n\")\n}\n"

  let classPath = scratch + "/class_point.bit"
  let oldPath = scratch + "/old_point.bit"
  writeFile(classPath, classSrc) catch e {
    eprint("classkeyword: cannot write ${classPath}: ${e.message()}\n")
    exit(2)
  }
  writeFile(oldPath, oldSrc) catch e {
    eprint("classkeyword: cannot write ${oldPath}: ${e.message()}\n")
    exit(2)
  }

  let classOutPath = scratch + "/class_out"
  let (classCode, classErr) = buildOne(bin, stdlib, libbitrt, scratch, classPath, classOutPath)
  if (classCode != 0) {
    eprint("classkeyword: FAIL — 'class Point' failed to build (exit ${classCode}):\n${classErr}\n")
    exit(1)
  }
  let (classRunCode, classOut) = runOne(scratch, classOutPath)
  if (classRunCode != 0 || classOut != "7\n") {
    eprint("classkeyword: FAIL — 'class Point' binary ran wrong: exit=${classRunCode} out='${classOut}'\n")
    exit(1)
  }

  let oldOutPath = scratch + "/old_out"
  let (oldCode, oldErr) = buildOne(bin, stdlib, libbitrt, scratch, oldPath, oldOutPath)
  if (oldCode == 0) {
    eprint("classkeyword: FAIL — the retired-spelling program built successfully; it must be rejected\n")
    exit(1)
  }
  if (!contains(oldErr, "E0102") || !contains(oldErr, "class")) {
    eprint("classkeyword: FAIL — the retired-spelling program failed as expected (exit ${oldCode}) but did not report " +
      "E0102 naming 'class':\n${oldErr}\n")
    exit(1)
  }

  print("PASS classkeyword: 'class' compiles and runs correctly; the retired spelling is rejected with E0102 naming 'class'\n")
}
