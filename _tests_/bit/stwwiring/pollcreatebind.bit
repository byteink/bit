// Split out of stwwiring.bit (#4369): that file was over 800 lines with this
// check inline. Same module as stwwiring.bit — a directory is its own Bit
// module (§17.1) — so every name this file reads (Cfg, Obj, ObjSym, atomEnd,
// edgeAnchors, eprint, loadObject, tMacos, tLinux) is already imported or
// declared there. Re-importing any of them here would be E0042 already
// declared in this scope: an import is per-module, not per-file.

// ---------------------------------------------------------------------------
// POLL CREATE + BIND, REPAIRED FOR #4344 (#4369), RE-ANCHORED FOR #5438 (#5443)
// ---------------------------------------------------------------------------
//
// WHAT THIS PROTECTS. `boot` must create the netpoller descriptor and bind it
// into the scheduler block BEFORE the channel reserve is provisioned, or
// `scPollFd` stays 0 and every socket read that must wait returns an empty
// string — the documented "peer closed" answer (#1673). Silent in every
// direction: the program exits 0 and prints blank lines where its payload
// belongs.
//
// WHY THE ANCHOR IS A LIST AND NOT ONE SYMBOL. Whether a call to
// `bit_rt_port_sched_poll_create` survives into `boot`'s emitted body is an
// INLINER DECISION, and that decision has now flipped twice under this check.
//
//   #4344's multi-block inliner absorbed `pollCreate`/`schedSetPollFd`
//   wholesale into `boot` on both platforms, so the original edge — a
//   relocation naming `bit_rt_port_sched_poll_create` — matched nothing and
//   the check had to fall back to whatever the INLINED body still called.
//   On Darwin that is `extern fn kqueue()`, called from nowhere else in the
//   runtime. On Linux there is no such unique callee: `syscall(...)` is a
//   compiler builtin lowered straight to `svc`/`syscall` with no symbol, and
//   the syscall NUMBER inlines to a literal, so the only thing left was
//   `bit_rt_port_syscalls_on_x64` — the shared arm64/x64 dispatch helper,
//   NOT unique to poll-create (many syscalls use it). Hence ordering rather
//   than bare presence.
//
//   #5438 flipped it back on Linux. It added `cacheEventDataOff()` to
//   `pollCreate`, which no longer fits the inliner, so `boot` once again
//   CALLS the pinned symbol by name. The Linux proxy went red on a tree whose
//   ordering was intact, because the two leading `on_x64` relocations it was
//   measuring had simply moved inside the callee. Disassembled for #5443,
//   same compiler (`compiler/` and `std/` are byte-identical across the two
//   commits) and a byte-identical `runtime/root/linux/boot.bit`:
//
//     0dee3f5b, boot          10600280, boot
//     ------------------      ------------------------------
//     b3e on_x64      <-+     b87 bit_rt_port_sched_poll_create  <-+ read fd
//     be1 bootPollFd    |     bd3 bootPollFd                       |
//     c33 on_x64      <-+     c25 bit_rt_port_sched_poll_create  <-+ write fd
//     cc8 bootPollFdWrite     c63 bootPollFdWrite
//     d9e chan_boot_bind      d39 chan_boot_bind
//     12ff on_x64 (close)     129a on_x64 (close)
//
//   Same two creates, same two stores, same side of the bind. Only the call
//   form changed.
//
// SO THE ANCHOR IS AN ORDERED PREFERENCE LIST, and the FIRST entry `boot`
// references at all decides — it is not a minimum over the list. The pinned
// `bit_rt_port_sched_poll_create` is the genuinely unique anchor and is used
// whenever the call is out of line; the platform proxy (`kqueue` on Darwin,
// `on_x64` on Linux) is consulted ONLY when the pinned name is absent, i.e.
// when the inliner has absorbed the body. Taking the minimum instead would
// let an unrelated early syscall mask a missing out-of-line create; taking
// the proxy first would re-break on the next inliner flip.
//
// WHY THE SEARCH IS SCOPED TO `boot`. `edgeAnchors`/`atomEnd` bound every
// offset to `boot`'s own atom, the same way `checkEdge` bounds its edges. The
// earlier object-wide minimum read the same today only because nothing else
// in a freestanding `runtime/root/<os>` references either symbol; scoping is
// what makes the check mean what this comment says.
//
// WHY NOT `bootPollFd`. `objread.bit`'s reader only keeps relocations naming a
// GLOBAL or UNDEFINED symbol (see stwwiring.bit's header on `RawTarget.global`),
// and `bootPollFd` is a private, unexported module global — its relocations are
// LOCAL and never reach `o.relocs` on either platform. Measured, not assumed:
// a check written against it found zero matches on a healthy tree.
//
// THE MUTATION THAT MUST REDDEN IT, re-run for #5443 on both platforms:
// deleting `boot`'s poll-create block removes every `sched_poll_create`
// reference, so the check falls through to the platform proxy, whose first
// remaining reference in `boot` comes from the shutdown close path — AFTER
// `chan_boot_bind` — and the check goes red.
//
// NOT INDEPENDENTLY VERIFIED, and deliberately not widened here: whether
// `schedSetPollFd`'s inlined store into the scheduler block
// (`*(sched + scPollFd) = fd`) survives on its own, as opposed to only the
// syscall running. It is a private struct-field write with no symbol, so a
// mutation deleting ONLY that line is invisible to this check. The realistic
// regression this gate exists for (#1673: "nothing called EITHER end") removes
// both statements together and IS caught.
const whyPollCreateBind: string = "boot must create the netpoller descriptor and bind it before the channel reserve is provisioned, or scPollFd stays 0 and every socket read that must wait returns an empty string (#1673, #4369)"
const chanBootBindSym: string = "bit_rt_port_chan_boot_bind"
const bootSym: string = "boot"

// The first relocation offset naming exactly `sym` from inside one of `starts`
// — the definitions of `boot`. -1 when nothing matches. `sym` is a real,
// `@symbol`-pinned or `extern` name (never a mangled module global; see the
// header above for why that distinction matters here).
fn firstRelocOffsetIn(o: Obj, starts: []ObjSym, sym: string): int {
  let best = 0 - 1
  let i = 0
  while (i < len(o.relocs)) {
    let r = o.relocs[i]
    i = i + 1
    if (r.toSym != sym || (best >= 0 && r.off >= best)) {
      continue
    }
    for s of starts {
      if (r.sect == s.sect && r.off >= s.value && r.off < atomEnd(o, s.sect, s.value)) {
        best = r.off
      }
    }
  }
  return best
}

// Which poll-create anchor `boot` actually shows, and where. `off` is -1 and
// `sym` empty when none of them appears.
class AnchorHit {
  off: int,
  sym: string,
}

// The FIRST entry of `anchors` that `boot` references at all — preference
// order, not lowest offset. See the header: the pinned poll-create name wins
// whenever the call is out of line, and the platform proxy is consulted only
// when the inliner has absorbed the body.
fn firstAnchorHit(o: Obj, starts: []ObjSym, anchors: []string): AnchorHit {
  for a of anchors {
    let at = firstRelocOffsetIn(o, starts, a)
    if (at >= 0) {
      return AnchorHit{ off: at, sym: a }
    }
  }
  return AnchorHit{ off: 0 - 1, sym: "" }
}

// One platform's load parameters, bundled so `checkPollCreateBind` stays
// under the E0202 parameter-count limit rather than taking each field loose.
// `anchors` is the ordered preference list described in the header; `sp` is
// prefixed to every symbol name, including each anchor.
class PollAnchor {
  path: string,
  target: string,
  sp: string,
  anchors: []string,
  idx: int,
}

// `names` with the platform symbol prefix applied — the list actually
// searched for, built once so the search and the failure report cannot drift
// apart.
fn prefixed(sp: string, names: []string): []string {
  let out = []string(0)
  for n of names {
    out = append(out, "${sp}${n}")
  }
  return out
}

// `names` as one comma-separated line, for the report. `std/strings`'s join is
// not imported by this module and `std/path`'s `join` (which is) builds paths.
fn anchorText(names: []string): string {
  let out = ""
  for n of names {
    if (len(out) > 0) {
      out = out + ", "
    }
    out = out + n
  }
  return out
}

// The "this check examined nothing" and "the wiring is gone" reports. Kept
// apart from the decision below so neither function carries both the prose and
// the logic.
fn reportPollAnchorMissing(path: string, what: string, detail: string): bool {
  eprint("stwwiring: ${path}: ${what}\n  ${detail}\n")
  return false
}

// True when `o` shows a poll-create anchor referenced from `boot` BEFORE the
// channel-reserve bind call. See the header for why the anchor is an ordered
// list and why bare presence is not enough on Linux.
fn checkPollCreateBindOnObj(path: string, o: Obj, a: PollAnchor): bool {
  let names = prefixed(a.sp, a.anchors)
  let starts = edgeAnchors(o, "${a.sp}${bootSym}")
  if (len(starts) == 0) {
    return reportPollAnchorMissing(
      path, "no definition named '${a.sp}${bootSym}' — the function this " +
        "check reads was renamed or is no longer emitted.",
      "This check examined nothing (#4369, #5443).",
    )
  }
  let bindAt = firstRelocOffsetIn(o, starts, "${a.sp}${chanBootBindSym}")
  if (bindAt < 0) {
    return reportPollAnchorMissing(
      path, "'${a.sp}${bootSym}' does not reference " +
        "'${a.sp}${chanBootBindSym}' — the anchor this check orders against " +
        "is gone.", "This check examined nothing (#4369).",
    )
  }
  let hit = firstAnchorHit(o, starts, names)
  if (hit.off < 0) {
    return reportPollAnchorMissing(
      path, "'${a.sp}${bootSym}' references none of the poll-create " +
        "anchors (${anchorText(names)}).", "${whyPollCreateBind}.",
    )
  }
  if (hit.off > bindAt) {
    return reportPollAnchorMissing(
      path, "'${hit.sym}' is referenced only AFTER the channel bind — the " +
        "startup poll-create call is gone.", "${whyPollCreateBind}.",
    )
  }
  return true
}

// Loads `a.path`'s freestanding object and runs `checkPollCreateBindOnObj` on
// it. A separate load from `runEdges`' shared one in stwwiring.bit — this
// check's ordering logic does not fit the Edge{} shape, so it cannot share
// that table's grouping.
fn checkPollCreateBind(c: Cfg, a: PollAnchor): bool {
  let o = loadObject(c, a.path, a.target, a.idx)
  if (!o.ok) {
    eprint(
        "stwwiring: could not read the object for ${a.path} (${a.target}); " +
        "poll-create/bind is UNCHECKED\n",
    )
    return false
  }
  return checkPollCreateBindOnObj(a.path, o, a)
}

// Both platforms, folded into `failed` the same way main()'s other checks
// are. Pulled out of main() itself (#4369) to keep its own complexity under
// the E0204 limit — main() was still using `c.script` at the call site, so
// this must run before `fsRemove(c.script)` there, same as before the split.
fn checkPollWiring(c: Cfg, failed: int): int {
  let f = failed
  let pinned = "bit_rt_port_sched_poll_create"
  let darwinAnchor = PollAnchor{
    path: "runtime/root/darwin", target: tMacos, sp: "_",
    anchors: [pinned, "kqueue"], idx: 201,
  }
  let linuxAnchor = PollAnchor{
    path: "runtime/root/linux", target: tLinux, sp: "",
    anchors: [pinned, "bit_rt_port_syscalls_on_x64"], idx: 202,
  }
  if (!checkPollCreateBind(c, darwinAnchor)) {
    f = f + 1
  }
  if (!checkPollCreateBind(c, linuxAnchor)) {
    f = f + 1
  }
  return f
}
