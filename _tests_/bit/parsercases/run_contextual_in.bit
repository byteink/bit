// run
// #7279: contextual identifiers share the existing name grammar.
import { hasPrefix as prefix } from "std/strings"

fn in(a: int): int { return a }

fn echo(in: int): int { return in }

class Box {
  in: int
  from(): int { return this.in }
}

fn names() {
  let call = in
  assert(call(2) == 2)
  assert(echo(3) == 3)
  let box = Box{ in = 4 }
  assert(box.in == 4 && box.from() == 4)
}

fn loops() {
  let values = [5, 6]
  let indices = 0
  for i in values {
    indices += i
  }
  assert(indices == 1)
  let total = 0
  for (i, value) in values {
    total += i + value
  }
  assert(total == 12)
  for value of values {
    assert(value == 5 || value == 6)
  }
  for (let i = 0; i < 2; i++) {
    assert(i < 2)
  }
}

fn mapKeys(in: string) {
  let condition = { in: [1, 2] }
  assert(condition["in"][1] == 2)
}

fn main() {
  print("${in(1)}\n")
  names()
  loops()
  mapKeys("in")
  let from = 7
  assert(from == 7 && prefix("in", "i"))
}
