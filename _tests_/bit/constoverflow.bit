// §15.4's constant-expression representability rule, as seen from outside the
// compiler (#2261, #2358).
//
// The property under test: a constant expression is evaluated at compile time
// WITH NO OVERFLOW, and a value that does not fit is a diagnostic, not a wrapped
// number. `const NANOS_300Y: int = 300 * 365 * 24 * 60 * 60 * 1000000000` used to
// compile clean and print -8985944073709551616 — an expiry 300 years out landing
// 341 years in the PAST, with nothing said by check, build or lint. That shape is
// ordinary application code, which is why this is worth a gate of its own.
//
// #2358 is the same rule at a narrower site: a BARE literal with no operator at
// all, e.g. `const HUGE: int = 99999999999999999999` (67 bits). Nothing above
// caught it — `vAddOverflows`/`vSubOverflows`/`vMulOverflows` guard `+`/`-`/`*`
// on already-folded operands, and a single literal never reaches them; it wraps
// in `parseIntText` before the folder has a value to check. The fix is
// `intTextOverflows` (compiler/checktype.bit), consulted from `vConstEval`'s own
// `Tag.IntLit` arm, so it reuses this file's existing E0084 report path
// (`vTopLevelConst`/`vModuleState`) rather than adding one. The "bare-literal"
// and "bare-i64-max"/"bare-u64-max-*" cases below are that half; everything else
// here is #2261's.
//
// #2488 is the same bare-literal rule at the one place #2358 left uncovered: a
// function BODY. `vConstEval` folds a `const`/module-`let` initializer only, so
// `let a = 99999999999999999999` inside a function, a call argument, and a
// `return` operand never reached it and silently wrapped. The fix is a
// `Tag.IntLit` arm in `vStmt` (compiler/validatestmt.bit) calling
// `vIntLitRange` (compiler/validateunmanaged.bit), which checks the SAME
// `intTextOverflows` and reports through the SAME `vReportConstOverflow`/E0084
// path #2358 already uses — `vStmt` walks every node in a function body, so this
// one arm covers a `let`, a call argument and a `return` in one place. The
// "fn-let"/"fn-call-arg"/"fn-return" reject cases and the "fn-arg-i64-max"/
// "fn-return-u64-max" accept cases below are that half.
//
// #2487 is a DIFFERENT mechanism sharing this file for the same reason (below):
// a 64-bit literal is representable and always compiled; the bug is that one
// with no declared type — `println("${0xFFFFFFFFFFFFFFFF}")`, `let y =
// 18446744073709551615` — defaulted to i64 and printed -1, because nothing
// carried its magnitude into `defaultType`'s "untyped int -> i64" rule. The fix
// is `defaultLitType` (compiler/checkgeneric.bit), consulted from
// `checkBinding` for an unannotated `let` and from `lowerToString` for a literal
// interpolated with no binding at all. The "untyped-hex-interp"/
// "untyped-dec-interp"/"untyped-let-hex" accept cases are the fix; "neg-one-let"/
// "neg-one-direct" are the control that a signed literal must stay signed.
//
// WHY THIS LIVES IN _tests_/bit/ AND NOT _tests_/cases/.
//
// #2358/#2488 make this compiler REJECT a program the pinned 0.1.5 stage0 oracle
// accepts. scripts/selfhost-diffcheck.sh classifies exactly that as FALSEPOS and
// exits 1 on it — and its sweep is
//     find stdlib examples _tests_/cases _tests_/imports -name '*.bit'
// so a golden case would BE the file that turns the differential red, against a
// measured baseline of MATCH=662 MISSING=0 FALSEPOS=0 DIFF=0. The divergence is
// deliberate and correct (the oracle predates the fix), but that script refuses
// known-divergence lists on principle — "a filter on a differential's ORACLE side
// can only ever hide a difference, never reveal one" (#1883) — and adding one
// would be the wrong repair. _tests_/bit/ is not in the sweep, so the behaviour is
// gated for real without either hiding a difference or fabricating one. The
// corpus differential still compares all 662 files it always did. #2487's fix
// changes accepted-program OUTPUT rather than accept/reject, but a golden under
// _tests_/cases/ would still diverge from the oracle's stdout the moment the two
// compilers disagree on what `println("${0xFFFFFFFFFFFFFFFF}")` prints, so it
// stays out of the corpus for the identical reason.
//
// Everything here drives the shipped `bit` CLI as a subprocess: an exit code is
// observable only to a parent, and this gate is about an exit code and rendered
// text. compiler/validate.bit's `vAddOverflows`/`vSubOverflows`/`vMulOverflows`
// are the unit under it.
//
// Run it from the repository root:
//     ./bit-out/bin/bit run _tests_/bit/constoverflow.bit
// `BIT_SELF_EXE` overrides which `bit` is exercised; unset, the compiler under
// test is `<cwd>/bit-out/bin/bit`, resolved from a child's own `pwd` — Bit has no
// getcwd primitive, and `selfExe()` here is the throwaway binary `bit run` built,
// not the compiler that built it.
//
// ANTI-VACUITY, all of it load-bearing. This gate asserts that things are
// REJECTED, and a compiler that rejected everything — or a fixture that never
// reached disk — would satisfy that trivially. So: every capture is asserted
// non-empty before any content check; every rejection case also asserts the
// diagnostic CODE, not merely a non-zero exit; the accept half runs the program
// and compares its stdout, so a blanket refusal fails here even while the reject
// half passes; the case tables' lengths are asserted before their loops and their
// iteration counts after; and the final line prints how many checks actually ran.
import { env, envOr, exit } from "std/os"
import { exists, mkdir, readFile, remove, writeFile } from "std/fs"
import { contains, parseInt } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// One `bit` invocation, as seen from outside it.
class Run { code: int, out: string, err: string }

// Assertion accounting. A class because Bit has no mutable module-level state,
// and the count is the anti-vacuity marker: an empty run must not read as pass.
class Tally { checks: int, failures: int }

// One program that must be REJECTED: its source, and a fragment of the value or
// operator that must appear in the rendering so the diagnostic is pinned to this
// expression rather than to any refusal at all.
class Reject { name: string, src: string, needle: string }

// One program that must still be ACCEPTED, with the stdout it must produce. The
// half that keeps the fix from becoming "reject more".
class Accept { name: string, src: string, want: string }

// How long any one child gets. A `bit build` of a four-line program is well
// under a second; this only ever fires on a hang, and a hang is a failure.
fn timeoutMs(): int {
  let s = parseInt(envOr("BIT_TEST_TIMEOUT_S", "300")) catch _ { 300 }
  if (s <= 0) {
    return 300000
  }
  return s * 1000
}

// Runs `script` through /bin/sh and returns its exit code. Negative returns are
// `osRunBounded`'s mechanism channel, never a program exit status, so each one is
// a named panic rather than a value any assertion could consume.
fn shell(scriptPath: string, script: string, ms: int): int! {
  writeFile(scriptPath, script)?
  if (fsChmod(scriptPath, 448) != 0) { // 0o700
    fail newError("constoverflow: cannot make script executable: ${scriptPath}")
  }
  let code = osRunBounded(scriptPath, ms)
  if (code == -2) {
    panic("constoverflow: TIMED OUT after ${ms}ms running ${scriptPath}")
  }
  if (code == -1) {
    panic("constoverflow: could not spawn ${scriptPath}")
  }
  if (code <= -100) {
    panic("constoverflow: ${scriptPath} died on signal ${-100 - code}")
  }
  return code
}

// The `bit` under test. `BIT_SELF_EXE` wins; otherwise the dev-tree build
// artifact relative to the working directory this program was started in. Never
// returns "" — a compiler this cannot find is a hard stop, not a skipped test.
fn bitBinary(scratch: string, ms: int): string! {
  let explicit = env("BIT_SELF_EXE")
  if (len(explicit) > 0) {
    if (!exists(explicit)) {
      fail newError("constoverflow: BIT_SELF_EXE=${explicit} does not exist")
    }
    return explicit
  }
  let cwdFile = "${scratch}/cwd.txt"
  let code = shell("${scratch}/pwd.sh", "#!/bin/sh\npwd > '${cwdFile}'\n", ms)?
  if (code != 0) {
    fail newError("constoverflow: could not read the working directory (exit ${code})")
  }
  let cwd = trimWs(readFile(cwdFile)?)
  let candidate = "${cwd}/bit-out/bin/bit"
  if (!exists(candidate)) {
    fail newError("constoverflow: no compiler at ${candidate}; run this from the repository root or set BIT_SELF_EXE")
  }
  return candidate
}

// Runs `bit <verb> <file>` with `dir` as the working directory.
//
// The wrapper always exits 0 and writes the real status to `code.txt`, so a
// missing `code.txt` is unmistakably "the compiler never ran" rather than a
// status some assertion could mistake for a verdict. Stale captures are deleted
// first for the same reason: no case may read a previous case's output.
fn runBit(bit: string, verb: string, dir: string, file: string, capDir: string, ms: int): Run! {
  let outPath = "${capDir}/out.txt"
  let errPath = "${capDir}/err.txt"
  let codePath = "${capDir}/code.txt"
  clear(outPath)
  clear(errPath)
  clear(codePath)
  let script = "#!/bin/sh\n" +
    "cd '${dir}' || exit 0\n" +
    "'${bit}' ${verb} '${file}' > '${outPath}' 2> '${errPath}'\n" +
    "echo $? > '${codePath}'\n" +
    "exit 0\n"
  let sh = shell("${capDir}/run.sh", script, ms)?
  if (sh != 0) {
    fail newError("constoverflow: wrapper script exited ${sh}, which it never should")
  }
  if (!exists(codePath)) {
    fail newError("constoverflow: no exit code was recorded for `bit ${verb} ${file}` — the run never happened")
  }
  let code = parseInt(trimWs(readFile(codePath)?))?
  return Run{ code: code, out: readFile(outPath)?, err: readFile(errPath)? }
}

fn clear(path: string) {
  if (exists(path)) {
    remove(path) catch _ { return }
  }
}

// Records one assertion. Failures are named and the run continues, so a single
// invocation reports every broken expectation instead of only the first.
fn check(t: Tally, cond: bool, label: string) {
  t.checks = t.checks + 1
  if (!cond) {
    t.failures = t.failures + 1
    eprint("FAIL: ${label}\n")
  }
}

// `${` cannot be written literally inside a Bit string — the lexer opens an
// interpolation on it — so the GENERATED program's interpolation is assembled
// from a lone `$`, which lexes as an ordinary character.
fn interpOfV(): string {
  return "$" + "{V}"
}

// Same reason as `interpOfV`, for the one accept case whose fixture binds `a`
// (a function-local `let`) rather than a module-level `V`.
fn interpOfA(): string {
  return "$" + "{a}"
}

// Same reason as `interpOfV`/`interpOfA`, generalized to an arbitrary
// expression — the #2488 fixtures below interpolate a call (`f(...)`, `g()`),
// not a bare name.
fn interpOfExpr(expr: string): string {
  return "$" + "{" + expr + "}"
}

// Wraps a top-level declaration in a program that USES it. An unused const might
// one day be folded away without ever being judged, which would make every
// rejection below pass for the wrong reason.
fn program(decl: string): string {
  return decl + "\nfn main() {\n  print(\"" + interpOfV() + "\\n\")\n}\n"
}

// The rejection set. Each entry is a genuine constant expression whose value
// leaves i64, so each must draw E0084 and not E0064 — "not a compile-time
// constant expression" would be a false statement about all of them.
fn rejects(): []Reject {
  return [
    // The ticket's first repro: i64 MAX + 1.
    Reject{ name: "add", src: program("const V: int = 9223372036854775807 + 1"),
      needle: "9223372036854775807 + 1" },
    // The ticket's second, and the one that motivated the severity: 300 years in
    // nanoseconds. True value 9460800000000000000; used to run as
    // -8985944073709551616.
    Reject{ name: "mul-chain",
      src: program("const V: int = 300 * 365 * 24 * 60 * 60 * 1000000000"),
      needle: "300 * 365 * 24 * 60 * 60 * 1000000000" },
    // Subtraction below MIN. Checked separately from `add` because the guard
    // cannot be written as `add(x, -y)` — negating MIN is itself the overflow.
    Reject{ name: "sub", src: program("const V: int = -9223372036854775807 - 2"),
      needle: "- 2" },
    // Multiplication that wraps to a plausible-looking ZERO (2^62 * 4 = 2^64),
    // which no "is the answer suspiciously large" heuristic would ever catch.
    Reject{ name: "mul-to-zero", src: program("const V: int = 4611686018427387904 * 4"),
      needle: "4611686018427387904 * 4" },
    // Negating MIN.
    Reject{ name: "neg-min", src: program("const V: int = 0 - (-9223372036854775807 - 1)"),
      needle: "0 - (" },
    // MIN / -1: the one quotient outside i64, and on x86 a hardware trap rather
    // than a wrap, so it has to be caught before the division executes.
    Reject{ name: "div-min-by-neg1",
      src: program("const V: int = (-9223372036854775807 - 1) / (0 - 1)"),
      needle: "/ (0 - 1)" },
    // Nested inside a larger constant expression: the verdict has to PROPAGATE
    // out through the enclosing operator instead of being flattened into
    // "not constant".
    Reject{ name: "nested", src: program("const V: int = (9223372036854775807 + 1) * 2"),
      needle: "* 2" },
    // A module-level `let` reaches the same folder through the other emit site
    // (vModuleState), so both arms are covered.
    Reject{ name: "module-let",
      src: program("let V: int = 9223372036854775807 + 1"),
      needle: "9223372036854775807 + 1" },
    // #2358: a BARE literal, no operator at all. `parseIntText` wrapped this to
    // 7766279631452241919 (99999999999999999999 mod 2^64) and nothing downstream
    // noticed — the wrap happens before the folder ever sees a value to check, so
    // the overflow-checked arithmetic above never reached it. 67 bits: wider than
    // any integer type the language has, not merely wider than i64.
    Reject{ name: "bare-literal",
      src: program("const V: int = 99999999999999999999"),
      needle: "99999999999999999999" },
    // #2488: the same bare literal as a function-local `let`. Before the fix,
    // `vConstEval` never runs for a function body, so this wrapped to
    // 7766279631452241919 with exit 0.
    Reject{ name: "fn-let",
      src: "fn main() {\n  let a = 99999999999999999999\n  print(\"" +
        interpOfExpr("a") + "\\n\")\n}\n",
      needle: "99999999999999999999" },
    // #2488: the same literal as a call argument.
    Reject{ name: "fn-call-arg",
      src: "fn f(n: int): int { return n }\nfn main() {\n  print(\"" +
        interpOfExpr("f(99999999999999999999)") + "\\n\")\n}\n",
      needle: "99999999999999999999" },
    // #2488: the same literal as a `return` operand.
    Reject{ name: "fn-return",
      src: "fn f(): int { return 99999999999999999999 }\nfn main() {\n  print(\"" +
        interpOfExpr("f()") + "\\n\")\n}\n",
      needle: "99999999999999999999" },
  ]
}

// The acceptance set, and the reason this gate cannot pass by rejecting
// everything. Every entry is a value AT or NEAR the boundary that must still
// compile and produce exactly the number below.
fn accepts(): []Accept {
  return [
    // i64 MAX itself, reached by arithmetic rather than written out.
    Accept{ name: "max-exact", src: program("const V: int = 9223372036854775806 + 1"),
      want: "9223372036854775807\n" },
    // i64 MIN itself.
    Accept{ name: "min-exact", src: program("const V: int = -9223372036854775807 - 1"),
      want: "-9223372036854775808\n" },
    // Wrapping past MAX and back is NOT an escape hatch, but each step here is
    // in range, so it must compile.
    Accept{ name: "large-in-range", src: program("const V: int = 4611686018427387903 * 2"),
      want: "9223372036854775806\n" },
    // `1 << 63` is DELIBERATELY not an overflow: it is how a top-bit mask is
    // spelled, this compiler writes it itself (compiler/x64value.bit's
    // xF64SignMask), and #2265 exists to make `let m: u64 = 1 << 63` work.
    // Shifting is bit placement, not arithmetic. If that decision is ever
    // revisited, this line is what says so out loud.
    Accept{ name: "shift-sign-bit", src: program("const V: int = 1 << 63"),
      want: "-9223372036854775808\n" },
    // The everyday case the fix must not disturb.
    Accept{ name: "ordinary", src: program("const V: int = 2 + 3 * 4"),
      want: "14\n" },
    // #2358's boundary: i64 MAX written as a BARE literal (63 bits), not
    // reached by arithmetic — exercises `parseIntText`/`intTextOverflows`
    // directly rather than the +/-/* predicates above.
    Accept{ name: "bare-i64-max", src: program("const V: int = 9223372036854775807"),
      want: "9223372036854775807\n" },
    // u64 MAX as a bare hex literal (64 bits, high bit set). One of the 169
    // legitimate sites this fix must not touch — SHA-512/Keccak round
    // constants and uuid masks are shaped exactly like this.
    Accept{ name: "bare-u64-max-hex", src: program("const V: u64 = 0xFFFFFFFFFFFFFFFF"),
      want: "18446744073709551615\n" },
    // The same value spelled in decimal, as a function-local `let` rather than
    // a module-level `const` — a different report site (vAssignableNode, not
    // vTopLevelConst/vModuleState), so it is written out rather than reused
    // through `program()`.
    Accept{ name: "bare-u64-max-dec",
      src: "fn main() {\n  let a: u64 = 18446744073709551615\n  print(\"" + interpOfA() + "\\n\")\n}\n",
      want: "18446744073709551615\n" },
    // #2488: i64 MAX as a call argument — the new `vStmt` arm must not
    // over-report on an in-range literal at the site it now covers.
    Accept{ name: "fn-arg-i64-max",
      src: "fn f(n: int): int { return n }\nfn main() {\n  print(\"" +
        interpOfExpr("f(9223372036854775807)") + "\\n\")\n}\n",
      want: "9223372036854775807\n" },
    // #2488: u64 MAX as a `return` operand from a `u64`-returning function.
    Accept{ name: "fn-return-u64-max",
      src: "fn g(): u64 { return 0xFFFFFFFFFFFFFFFF }\nfn main() {\n  print(\"" +
        interpOfExpr("g()") + "\\n\")\n}\n",
      want: "18446744073709551615\n" },
    // #2487: a BARE hex literal with no declared type, interpolated directly —
    // no name to carry a `u64` annotation. Before the fix this printed -1: the
    // literal defaulted to i64 and `lowerToString` read bit 63 as the sign.
    Accept{ name: "untyped-hex-interp",
      src: "fn main() {\n  print(\"" +
        interpOfExpr("0xFFFFFFFFFFFFFFFF") + "\\n\")\n}\n",
      want: "18446744073709551615\n" },
    // #2487: the same value spelled in decimal — hex vs decimal must make no
    // difference, since both reach the checker through the same `parseIntText`.
    Accept{ name: "untyped-dec-interp",
      src: "fn main() {\n  print(\"" +
        interpOfExpr("18446744073709551615") + "\\n\")\n}\n",
      want: "18446744073709551615\n" },
    // #2487: a bare literal bound to an UNANNOTATED `let` — `y` itself must be
    // typed `u64` (not merely printed correctly by some special case at the
    // print site), so a later reference to `y` sees the same fix.
    Accept{ name: "untyped-let-hex",
      src: "fn main() {\n  let y = 0xFFFFFFFFFFFFFFFF\n  print(\"" +
        interpOfExpr("y") + "\\n\")\n}\n",
      want: "18446744073709551615\n" },
    // #2487 control: a signed literal must NOT become unsigned. `-1` is a
    // `Tag.Unary` over the small literal `1`, never a bare `Tag.IntLit`, so the
    // fix's node-shape guard must leave it on the ordinary i64 default.
    Accept{ name: "neg-one-let",
      src: "fn main() {\n  let z = -1\n  print(\"" + interpOfExpr("z") + "\\n\")\n}\n",
      want: "-1\n" },
    // #2487 control: the same, interpolated directly with no binding at all.
    Accept{ name: "neg-one-direct",
      src: "fn main() {\n  print(\"" + interpOfExpr("-1") + "\\n\")\n}\n",
      want: "-1\n" },
  ]
}

// Every rejection case: non-zero exit, E0084 rather than E0064, and the
// diagnostic pinned to this expression.
fn checkRejects(t: Tally, bit: string, dir: string, capDir: string, ms: int): ()! {
  let cases = rejects()
  check(t, len(cases) == 12, "reject table has ${len(cases)} entries, want 12")
  let ran = 0
  for c of cases {
    let file = "r_${c.name}.bit"
    writeFile("${dir}/${file}", c.src)?
    let r = runBit(bit, "check", dir, file, capDir, ms)?
    // Non-empty FIRST: every check below is satisfied by the empty string.
    check(t, len(r.err) > 0, "${c.name}: stderr is empty — the compiler said nothing")
    check(t, r.code != 0, "${c.name}: exit ${r.code}, want non-zero")
    check(t, contains(r.err, "error[E0084]"),
      "${c.name}: no E0084 in the diagnostic")
    check(t, !contains(r.err, "E0064"),
      "${c.name}: reported E0064 — the expression IS constant, it is unrepresentable")
    check(t, contains(r.err, "overflows 'i64'"),
      "${c.name}: diagnostic does not name the overflow")
    check(t, contains(r.err, c.needle),
      "${c.name}: diagnostic does not point at `${c.needle}`")
    ran = ran + 1
  }
  check(t, ran == 12, "only ${ran} of 12 rejection cases ran")
}

// Every acceptance case: builds AND runs, and the stdout is compared. Running
// matters — a compiler that accepted the program and then folded it wrongly
// would pass an exit-code-only check.
fn checkAccepts(t: Tally, bit: string, dir: string, capDir: string, ms: int): ()! {
  let cases = accepts()
  check(t, len(cases) == 15, "accept table has ${len(cases)} entries, want 15")
  let ran = 0
  for c of cases {
    let file = "a_${c.name}.bit"
    writeFile("${dir}/${file}", c.src)?
    let r = runBit(bit, "run", dir, file, capDir, ms)?
    check(t, r.code == 0, "${c.name}: exit ${r.code}, want 0 — stderr: ${r.err}")
    check(t, r.out == c.want,
      "${c.name}: printed ${r.out}want ${c.want}")
    ran = ran + 1
  }
  check(t, ran == 15, "only ${ran} of 15 acceptance cases ran")
}

// Both halves, against a scratch directory built fresh. Split out of `main` so
// each stays inside the repo's own max-complexity limit.
fn runAll(t: Tally, scratch: string, ms: int) {
  let dir = "${scratch}/src"
  let capDir = "${scratch}/cap"
  mkdir(dir) catch e { panic("constoverflow: cannot create ${dir}: ${e.message()}") }
  mkdir(capDir) catch e { panic("constoverflow: cannot create ${capDir}: ${e.message()}") }
  let bit = bitBinary(scratch, ms) catch e { panic("constoverflow: ${e.message()}") }
  checkRejects(t, bit, dir, capDir, ms) catch e { panic("constoverflow: ${e.message()}") }
  checkAccepts(t, bit, dir, capDir, ms) catch e { panic("constoverflow: ${e.message()}") }
}

fn main() {
  let ms = timeoutMs()
  let tmp = trimSuffix(envOr("TMPDIR", "/tmp"), "/")
  let scratch = "${tmp}/bit-constoverflow-${uuidFormat(uuidV4())}"
  let t = Tally{ checks: 0, failures: 0 }

  mkdir(scratch) catch e {
    panic("constoverflow: cannot create ${scratch}: ${e.message()}")
  }
  runAll(t, scratch, ms)

  // The run marker: a gate that stopped checking is visible here rather than
  // green. 12 rejections x 6 assertions + 15 acceptances x 2 + 4 table/loop
  // assertions = 106.
  if (t.checks < 106) {
    eprint("FAIL: only ${t.checks} checks ran, want at least 106\n")
    t.failures = t.failures + 1
  }
  if (t.failures > 0) {
    // `exit()` does not run pending defers (#3694, same shape as #3677) —
    // call teardown explicitly on both the PASS and FAIL paths.
    teardown(scratch, ms)
    println("constoverflow: FAIL — ${t.failures} of ${t.checks} checks failed")
    exit(1)
  }
  teardown(scratch, ms)
  println("constoverflow: PASS — ${t.checks} checks")
}

// std/fs has no recursive remove, so the scratch tree goes the way it came.
fn teardown(scratch: string, ms: int) {
  shell("${scratch}/rm.sh", "#!/bin/sh\nrm -rf '${scratch}'\n", ms) catch _ { return }
}

// `std/strings`' `trimSpace` stops at spaces and tabs, and every capture here
// arrives newline-terminated from a shell redirect.
fn trimWs(s: string): string {
  let lo = 0
  while (lo < len(s) && isWs(s[lo])) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && isWs(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

fn isWs(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn trimSuffix(s: string, suffix: string): string {
  if (len(suffix) > 0 && len(s) >= len(suffix) && s[len(s) - len(suffix):] == suffix) {
    return s[:len(s) - len(suffix)]
  }
  return s
}
