// Move the request read off the accept thread (#2170): the `listenAndServe`
// accept loop used to read each request's headers and body on the shared
// accept-loop thread — the same loop `listenAndServeOn` runs here, after a
// separate bind — before spawning the handler. One connection that declared a
// body and then stalled — or just sent it slowly — parked that thread forever,
// so no other client, already connected or arriving later, was ever answered.
//
// `readMessage` now runs inside the spawned per-connection thread (`serveOne`,
// the same helper `serveTls`'s HTTP/1.1 fallback already used), so a stalled
// or slow connection only ever blocks itself.
//
// Exact elapsed milliseconds are not printed — this repo's dev machines run
// several concurrent agents, so wall-clock numbers are not reproducible.
// What must be reproducible, and is asserted directly, is that both bounds
// the ticket names are met by a wide margin.
import { serve, listenAndServeOn, Server, get, Request, Response, ok } from "std/http"
import { dial } from "std/net"
import { sleep, Millisecond, now } from "std/time"

fn route(req: Request): Response {
  return ok("hi")
}

// The HTTP server, on a listener `run` has already bound.
fn server(s: Server) {
  listenAndServeOn(s, route) catch e {
    println("listenAndServeOn: ${e.message()}")
  }
}

// A connection that declares a 100-byte body, sends 5 bytes, then holds the
// socket open (never closes, never sends the rest) must not delay a normal
// GET on a fresh connection by more than 2 seconds.
fn stalledConnection(port: int): ()! {
  let a = get("http://127.0.0.1:${port}/")?
  println("case1 GET1 -> ${a.status}")
  let c = dial("127.0.0.1", port)?
  c.write("POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 100\r\n\r\nshort")?
  sleep(300 * Millisecond)
  let t0 = now().ns
  let b = get("http://127.0.0.1:${port}/")?
  let elapsedMs = (now().ns - t0) / 1000000
  println("case1 GET2 -> ${b.status} within-2s=${elapsedMs < 2000}")
}

fn runStalledConnection(port: int) {
  stalledConnection(port) catch e {
    println("case1 failed: ${e.message()}")
  }
}

// A client sending one byte at a time (200ms apart) toward a declared body
// must not delay a concurrent ordinary GET on a fresh connection by more than
// 1 second.
fn dribble(port: int): ()! {
  let c = dial("127.0.0.1", port)?
  c.write("POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 10\r\n\r\n")?
  let i = 0
  while (i < 10) {
    c.write("x")?
    sleep(200 * Millisecond)
    i = i + 1
  }
}

fn runDribble(port: int) {
  dribble(port) catch e {
    return
  }
}

fn slowClientConcurrency(port: int): ()! {
  spawn runDribble(port)
  sleep(300 * Millisecond)
  let t0 = now().ns
  let r = get("http://127.0.0.1:${port}/")?
  let elapsedMs = (now().ns - t0) / 1000000
  println("case2 GET -> ${r.status} within-1s=${elapsedMs < 1000}")
}

// Both listeners are bound HERE, before their server threads start, so each port
// is one the kernel picked as free and every URL is built from the number read
// back. A pinned number makes two concurrent runs of this fixture — two
// worktrees, one imports suite each — race for the same socket, and the loser's
// EADDRINUSE is compared as output (#4612).
fn run(): ()! {
  let s1 = serve("127.0.0.1", 0)?
  let port1 = s1.port()?
  spawn server(s1)
  sleep(500 * Millisecond)
  runStalledConnection(port1)

  let s2 = serve("127.0.0.1", 0)?
  let port2 = s2.port()?
  spawn server(s2)
  sleep(500 * Millisecond)
  slowClientConcurrency(port2) catch e {
    println("case2 failed: ${e.message()}")
  }
}

fn main() {
  run() catch e {
    println("failed: ${e.message()}")
  }
}
