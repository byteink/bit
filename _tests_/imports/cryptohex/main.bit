// std/crypto hex encode/decode (#1161): lowercase/uppercase encoding, an
// even-length round-trip, case-insensitive decoding, and the two failure modes
// decodeHex must reject — a non-hex digit and an odd length. All outputs are
// deterministic, so the golden `expected` is stable.
import { encodeHex, encodeHexUpper, decodeHex } from "std/crypto"

// True iff `s` decodes; the catch diverts, so a failure is observable as false
// without inspecting the (discarded) ok value.
fn decodes(s: string): bool {
  decodeHex(s) catch e {
    return false
  }
  return true
}

fn main() {
  let raw = []byte{ 0xde, 0xad, 0xbe, 0xef }

  // Lowercase and uppercase encoding of the same bytes.
  println("enc=${encodeHex(raw)}")
  println("encUp=${encodeHexUpper(raw)}")

  // Decode round-trips back to the original bytes.
  let back = decodeHex("deadbeef") catch e {
    println("decode failed: ${e.message()}")
    return
  }
  let same = len(back) == 4 &&
    back[0] == 0xde &&
    back[1] == 0xad &&
    back[2] == 0xbe &&
    back[3] == 0xef
  println("roundtrip=${same}")

  // Uppercase input decodes to the same bytes (case-insensitive).
  let up = decodeHex("DEADBEEF") catch e {
    println("decode failed: ${e.message()}")
    return
  }
  println("upperOk=${up[0] == 0xde && up[3] == 0xef}")

  // A non-hex digit and an odd length both fail.
  println("badDigit=${!decodes("xyz")}")
  println("oddLen=${!decodes("abc")}")
}
