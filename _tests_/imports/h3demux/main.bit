// std/quic server-side connection demultiplexing (#1254): one `serveH3` server on
// a single UDP port answers MANY client connections — first sequentially, then
// concurrently. Each `get("https+h3://…")` opens a fresh QUIC connection, so this
// exercises the listener's Destination-Connection-ID demux directly: before
// #1254 a server handled one connection per socket, and the second connection to
// it was silently dropped and hung until the 5s handshake timeout. Every printed
// line is a deterministic count, despite the random handshake keys and the
// nondeterministic completion order of the concurrent requests.
//
// The certificate chain + RSA key are the throwaway test PKI shared with the tls,
// http2, and http3 loopback tests (leaf SAN: localhost).
import { serveH3, get, ok, Request, Response } from "std/http"
import { decodeHex, pemEncode, randomUintBelow } from "std/crypto"
import { sleep, monotonic, since, millis, Millisecond, Second } from "std/time"

const caHex: string = ""
const leafHex: string = ""
const keyHex: string = ""

// A fixed loopback UDP port for the demo, distinct from the other h3 tests.
const port: int = 47171

fn hx(s: string): []byte { return decodeHex(s) catch e { return []byte(0) } }
fn pemOf(label: string, h: string): string { return pemEncode(label, hx(h)) }
fn chainPem(): string { return pemOf("CERTIFICATE", leafHex) + pemOf("CERTIFICATE", caHex) }
fn keyPem(): string { return pemOf("PRIVATE KEY", keyHex) }

// The handler echoes the request path, so a response proves which request it
// answered — one server, many connections, each getting its own answer.
fn route(req: Request): Response {
  return ok("ok:${req.path}")
}

fn server() {
  serveH3("127.0.0.1", port, chainPem(), keyPem(), route) catch e {
    println("server error: ${e.message()}")
  }
}

// Full-jitter exponential backoff (base 50ms, cap 2000ms): a uniformly random
// delay in `[0, min(cap, base*2^attempt)]` ms. Two callers retrying at a FIXED
// interval re-collide every round — a genuine hazard here, not a theoretical
// one (#1709): under this scheduler's single OS worker, two truly-concurrent
// handshakes that arrive together serialize their RSA signs back-to-back, and
// if both callers' redials land together every time too, the pairing can
// re-form every round forever (observed: a stable oscillation where neither
// concurrent dial ever completed, tree eec9610 + #1709's admission-control
// fix alone). Randomizing the redial breaks that resonance by letting the two
// callers' attempts drift apart over a few rounds, so eventually one arrives
// with the server otherwise idle and completes within its own deadline.
fn backoffMs(attempt: int): int {
  let capMs = 2000
  let shift = attempt
  if (shift > 6) {
    shift = 6
  }
  let raw = 50 * (1 << shift)
  if (raw > capMs) {
    raw = capMs
  }
  return int(randomUintBelow(uint(raw + 1)))
}

// How long one fetch may keep retrying. THE GIVE-UP TEST IS A CLOCK, NOT AN
// ATTEMPT COUNT (#1861), and the distinction is not cosmetic. `backoffMs`
// saturates at its 2000ms cap from attempt 6 on, so the old `attempt < 300`
// bound was ~295s of pure sleeping per failing fetch; two of the five SEQUENTIAL
// fetches reaching that was enough to blow the deleted `proc` module's 900s deadline and
// be reported as a hang, while the program was behaving exactly as written.
//
// A count bounds nothing in the dimension the harness measures. Under load the
// server's handshakes both slow down AND fail more often, so attempts multiply
// while each one costs more — measured at 66s idle against >600s under 16 CPU
// hogs. This is `polloneshotdarwin`'s bug (#1849) in a different unit: there the
// implementation detail being counted was scheduler passes, here it is retries.
//
// 90s is ~18x the ~5s a fetch actually takes on an idle box. Worst case is the
// five sequential fetches at 450s plus the concurrent phase overlapping at ~90s,
// so ~540s — inside 900s with room, and a program that needs more than that is
// genuinely broken rather than merely slow.
// A function, not a `const`: `Second` is imported, and a top-level `const`
// initializer must fold at compile time (E0064).
fn fetchBudgetNs(): int { return 90 * Second }

// One h3 GET of `path` (a fresh QUIC connection), retrying the dial with a
// jittered backoff while the spawned server is still binding or busy. Returns
// true iff the response is the expected path echo.
fn fetchOk(path: string): bool {
  let attempt = 0
  let start = monotonic()
  while (since(start) < fetchBudgetNs()) {
    let r = get("https+h3://127.0.0.1:${port}${path}") catch e {
      sleep(backoffMs(attempt) * Millisecond)
      // Still the attempt COUNT that picks the backoff exponent — only the
      // give-up test changed.
      attempt = attempt + 1
      continue
    }
    return r.status == 200 && r.body == "ok:${path}"
  }
  // Only ever reached on failure, so the success output stays deterministic.
  // Naming the path and the elapsed time makes this a reportable test failure
  // instead of a killed process with nothing said about which fetch stalled.
  println("fetch '${path}' gave up after ${attempt} attempt(s), ${millis(since(start))}ms")
  return false
}

// A concurrent fetch that reports its result on `out`.
fn concFetch(path: string, out: chan<bool>) {
  out <- fetchOk(path)
}

fn run() {
  spawn server()

  // Sequential: five distinct connections to the one server, one after another.
  // Each opens, handshakes, exchanges, and closes before the next — so this also
  // exercises the listener freeing a closed connection's demux slot.
  let seq = 0
  let i = 0
  while (i < 5) {
    if (fetchOk("/seq${i}")) {
      seq = seq + 1
    }
    i = i + 1
  }
  println("seq-pass ${seq}/5")

  // Concurrent: eight simultaneous connections, all live on the one bound
  // socket at once and demultiplexed by their connection ids. Every TLS
  // handshake does an RSA signature, and the runtime's single green-thread
  // worker still serializes that CPU work (#1246's barrier landed but the
  // scheduler pin-lift itself has not) — admission control
  // (quicListenerMaxHandshakes) and jittered client backoff (#1709) bound the
  // queue and avoid a retry cascade even though the handshakes are not truly
  // parallel yet.
  let results = chan<bool>(8)
  let j = 0
  while (j < 8) {
    spawn concFetch("/conc${j}", results)
    j = j + 1
  }
  let conc = 0
  let k = 0
  while (k < 8) {
    if (<- results) {
      conc = conc + 1
    }
    k = k + 1
  }
  println("conc-pass ${conc}/8")
}

fn main() {
  run()
}
