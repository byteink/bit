// std/crypto AES modes of operation (#1182): the NIST SP 800-38A §F known-answer
// vectors for CTR, CBC, and the bare ECB block, hex-compared via encodeHex, plus
// CTR/CBC decrypt round-trips and the cbcDecrypt bad-length rejection. Every mode
// rides the constant-time AES core (aes.bit); a counter-increment, chaining, or
// XOR miscompile — or a narrow-width u8 wrap bug — would corrupt these digests.
// Output is deterministic, so the golden `expected` is stable.
import { newAes, ctr, ecbEncryptBlock, cbcEncrypt, cbcDecrypt, encodeHex, decodeHex } from "std/crypto"

// The shared NIST AES-128 key and the standard four-block plaintext (§F).
const key128: string = "2b7e151628aed2a6abf7158809cf4f3c"
const plain: string = "6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e5130c81c46a35ce411e5fbc1191a0a52eff69f2445df4f9b17ad2b417be66c3710"

// CTR keystream engine (§F.5.1): encrypt `ptHex` under `keyHex` with initial
// counter `ivHex`, as lowercase hex. Panics only on a malformed literal here.
fn ctrHex(keyHex: string, ivHex: string, ptHex: string): string {
  let key = decodeHex(keyHex) catch e {
    return "badkey"
  }
  let iv = decodeHex(ivHex) catch e {
    return "badiv"
  }
  let pt = decodeHex(ptHex) catch e {
    return "badpt"
  }
  let c = newAes(key) catch e {
    return "badaes"
  }
  return encodeHex(ctr(c, iv, pt))
}

// CBC encrypt (§F.2.1): chain `ptHex` under `keyHex` with explicit IV `ivHex`.
fn cbcHex(keyHex: string, ivHex: string, ptHex: string): string {
  let key = decodeHex(keyHex) catch e {
    return "badkey"
  }
  let iv = decodeHex(ivHex) catch e {
    return "badiv"
  }
  let pt = decodeHex(ptHex) catch e {
    return "badpt"
  }
  let c = newAes(key) catch e {
    return "badaes"
  }
  return encodeHex(cbcEncrypt(c, iv, pt))
}

// The bare ECB block permutation (§F.1.1 block 1) of `blockHex` under `keyHex`.
fn ecbHex(keyHex: string, blockHex: string): string {
  let key = decodeHex(keyHex) catch e {
    return "badkey"
  }
  let block = decodeHex(blockHex) catch e {
    return "badblk"
  }
  let c = newAes(key) catch e {
    return "badaes"
  }
  return encodeHex(ecbEncryptBlock(c, block))
}

// CTR is its own inverse: re-applying it to the ciphertext must recover `ptHex`.
fn ctrRoundTrips(keyHex: string, ivHex: string, ptHex: string): bool {
  let key = decodeHex(keyHex) catch e {
    return false
  }
  let iv = decodeHex(ivHex) catch e {
    return false
  }
  let pt = decodeHex(ptHex) catch e {
    return false
  }
  let c = newAes(key) catch e {
    return false
  }
  let enc = ctr(c, iv, pt)
  return encodeHex(ctr(c, iv, enc)) == ptHex
}

// cbcDecrypt(cbcEncrypt(pt)) must recover `ptHex` under the same key and IV.
fn cbcRoundTrips(keyHex: string, ivHex: string, ptHex: string): bool {
  let key = decodeHex(keyHex) catch e {
    return false
  }
  let iv = decodeHex(ivHex) catch e {
    return false
  }
  let pt = decodeHex(ptHex) catch e {
    return false
  }
  let c = newAes(key) catch e {
    return false
  }
  let enc = cbcEncrypt(c, iv, pt)
  let dec = cbcDecrypt(c, iv, enc) catch e {
    return false
  }
  return encodeHex(dec) == ptHex
}

// cbcDecrypt must reject a ciphertext whose length is not a multiple of 16.
fn cbcRejectsBadLen(): bool {
  let key = decodeHex(key128) catch e {
    return false
  }
  let c = newAes(key) catch e {
    return false
  }
  let out = cbcDecrypt(c, []byte(16), []byte(20)) catch e {
    return true
  }
  return false
}

fn main() {
  let ctrIv = "f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff"
  let cbcIv = "000102030405060708090a0b0c0d0e0f"
  let block1 = "6bc1bee22e409f96e93d7e117393172a"

  // NIST SP 800-38A F.5.1 (CTR-AES-128), F.2.1 (CBC-AES-128), F.1.1 (ECB block 1).
  println("ctr=${ctrHex(key128, ctrIv, plain)}")
  println("cbc=${cbcHex(key128, cbcIv, plain)}")
  println("ecb=${ecbHex(key128, block1)}")

  // Decrypt round-trips and the bad-length guard on cbcDecrypt.
  println("ctrRt=${ctrRoundTrips(key128, ctrIv, plain)}")
  println("cbcRt=${cbcRoundTrips(key128, cbcIv, plain)}")
  println("cbcBadLen=${cbcRejectsBadLen()}")
}
