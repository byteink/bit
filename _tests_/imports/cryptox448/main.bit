// std/crypto X448 ECDH (#1189): RFC 7748 known-answer tests.
//
// The scalar-mult and DH vectors are RFC 7748 §5.2 (two direct x448 vectors)
// and §6.2 (the Alice/Bob key exchange), every value re-derived offline with an
// independent pure-integer ladder and cross-checked against the reference
// `cryptography` library before being locked into the sibling `expected` file —
// a miscompiled ladder cannot quietly agree with itself. `alice_pub`/`bob_pub`
// also pin `x448Base` (u = 5), and `shared_ab`/`shared_ba` pin the ECDH symmetry
// `s(a,B) == s(b,A)`.
//
// Coverage beyond the fixed vectors: the all-zero contributory check
// (`x448SharedSecret` against a zero peer point must be rejected); the DH
// symmetry over two freshly generated key pairs (exercising
// `x448GenerateKeypair` without depending on the non-deterministic RNG); and the
// shape of a generated key pair (56-byte private and public halves).
import {
  x448, x448Base, x448SharedSecret, x448GenerateKeypair, X448Keypair,
  encodeHex, decodeHex,
} from "std/crypto"

// The bytes of a hex literal; a malformed literal degrades to empty, which any
// downstream length check catches.
fn fromHex(s: string): []byte {
  return decodeHex(s) catch e {
    return []byte(0)
  }
}

// The hex of the shared secret for `scalar` against peer point `u`; "err" if the
// contributory check rejects it.
fn sharedHex(scalar: []byte, u: []byte): string {
  let s = x448SharedSecret(scalar, u) catch e {
    return "err"
  }
  return encodeHex(s)
}

// Whether two byte slices are identical.
fn sameBytes(a: []byte, b: []byte): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// Whether an all-zero peer point is rejected by the shared-secret check.
fn rejectsLowOrder(scalar: []byte): bool {
  let zero = []byte(56)
  x448SharedSecret(scalar, zero) catch e {
    return true
  }
  return false
}

// Whether two independent key pairs agree on the shared secret from both sides.
fn keypairsAgree(): bool {
  let a = x448GenerateKeypair()
  let b = x448GenerateKeypair()
  let sa = x448SharedSecret(a.priv, b.pub) catch e {
    return false
  }
  let sb = x448SharedSecret(b.priv, a.pub) catch e {
    return false
  }
  return sameBytes(sa, sb)
}

fn main() {
  // RFC 7748 §5.2: direct x448(scalar, u) vectors.
  println(
    "v1=${encodeHex(
      x448(
        fromHex("3d262fddf9ec8e88495266fea19a34d28882acef045104d0d1aae121700a779c984c24f8cdd78fbff44943eba368f54b29259a4f1c600ad3"),
        fromHex("06fce640fa3487bfda5f6cf2d5263f8aad88334cbd07437f020f08f9814dc031ddbdc38c19c6da2583fa5429db94ada18aa7a7fb4ef8a086"),
      ),
    )}",
  )
  println(
    "v2=${encodeHex(
      x448(
        fromHex("203d494428b8399352665ddca42f9de8fef600908e0d461cb021f8c538345dd77c3e4806e25f46d3315c44e0a5b4371282dd2c8d5be3095f"),
        fromHex("0fbcc2f993cd56d3305b0b7d9e55d4c1a8fb5dbb52f8e9a1e9b6201b165d015894e56c4d3570bee52fe205e28a78b91cdfbde71ce8d157db"),
      ),
    )}",
  )

  // RFC 7748 §6.2: Alice/Bob key exchange.
  let alicePriv = fromHex("9a8f4925d1519f5775cf46b04b5800d4ee9ee8bae8bc5565d498c28dd9c9baf574a9419744897391006382a6f127ab1d9ac2d8c0a598726b")
  let bobPriv = fromHex("1c306a7ac2a0e2e0990b294470cba339e6453772b075811d8fad0d1d6927c120bb5ee8972b0d3e21374c9c921b09d1b0366f10b65173992d")
  let alicePub = x448Base(alicePriv)
  let bobPub = x448Base(bobPriv)
  println("alice_pub=${encodeHex(alicePub)}")
  println("bob_pub=${encodeHex(bobPub)}")
  println("shared_ab=${sharedHex(alicePriv, bobPub)}")
  println("shared_ba=${sharedHex(bobPriv, alicePub)}")

  // Contributory / small-subgroup check and generated-key-pair properties.
  println("reject_lowzero=${rejectsLowOrder(alicePriv)}")
  println("kp_agree=${keypairsAgree()}")
  let kp = x448GenerateKeypair()
  println("priv_len=${len(kp.priv)}")
  println("pub_len=${len(kp.pub)}")
}
