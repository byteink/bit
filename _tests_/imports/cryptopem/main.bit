// std/crypto PEM (#1196): round-trip a CERTIFICATE and a PRIVATE KEY block
// byte-identically through pemEncode/pemDecode, parse a file of two concatenated
// blocks into two labelled PemBlocks, confirm pemEncode wraps its base64 body at
// 64 columns, and confirm the strict decoder rejects both a truncated block and
// a mismatched END label. The DER bodies are real-ish hex (an SPKI prefix and a
// 64-byte key blob); round-trip proves encode/decode stay mutually consistent.
import { pemEncode, pemDecode, decodeHex } from "std/crypto"

// Whether two byte slices hold the same bytes.
fn sameBytes(a: []byte, b: []byte): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// The length of the longest LF-delimited line in `s`.
fn maxLineLen(s: string): int {
  let max = 0
  let cur = 0
  let i = 0
  while (i < len(s)) {
    if (s[i] == 10) {
      if (cur > max) {
        max = cur
      }
      cur = 0
    } else {
      cur = cur + 1
    }
    i = i + 1
  }
  if (cur > max) {
    max = cur
  }
  return max
}

fn main() {
  // Real-ish DER: the front of an RSA SubjectPublicKeyInfo, and a 64-byte blob
  // whose base64 (88 chars) forces pemEncode to wrap onto a second line.
  let cert = decodeHex("30820122300d06092a864886f70d0101010500") catch e {
    println("setup FAILED")
    return
  }
  let key = decodeHex("308204a40201000282010100c0ffee00112233445566778899aabbccddeeff0102030405060708090a0b0c0d0e0f101112131415161718") catch e {
    println("setup FAILED")
    return
  }

  // Byte-identical round-trip of each block on its own.
  let certPem = pemEncode("CERTIFICATE", cert)
  let certBack = pemDecode(certPem) catch e {
    println("cert decode FAILED")
    return
  }
  println("certRoundTrip=${sameBytes(certBack[0].der, cert)} label=${certBack[0].label}")

  let keyPem = pemEncode("PRIVATE KEY", key)
  let keyBack = pemDecode(keyPem) catch e {
    println("key decode FAILED")
    return
  }
  println("keyRoundTrip=${sameBytes(keyBack[0].der, key)} label=${keyBack[0].label}")

  // pemEncode wraps the base64 body at 64 columns, so no line exceeds 64.
  println("keyWrapped=${maxLineLen(keyPem) <= 64}")

  // Two concatenated blocks parse into two PemBlocks in order.
  let both = pemDecode(certPem + keyPem) catch e {
    println("concat decode FAILED")
    return
  }
  println("count=${len(both)} labels=${both[0].label},${both[1].label}")

  // A block with no END line is a truncation error.
  let truncated = pemDecode("-----BEGIN CERTIFICATE-----\nMIIB\n") catch e {
    println("truncatedRejected=true")
    // A mismatched END label is rejected too.
    let mismatch = pemDecode("-----BEGIN CERTIFICATE-----\nMIIB\n-----END PRIVATE KEY-----\n") catch e2 {
      println("mismatchRejected=true")
      return
    }
    println("mismatchRejected=false count=${len(mismatch)}")
    return
  }
  println("truncatedRejected=false count=${len(truncated)}")
}
