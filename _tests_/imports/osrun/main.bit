// Exercises `std/process`'s `run` (#2303) — the discoverable entry point
// over the `osRun` builtin — through the real self-hosted `bit`, not the raw
// builtin directly. Runs `/bin/echo` with a real argument vector and checks
// the child's exit code; the child's own stdout, inherited from this
// process, lands in this project's `expected` file ahead of the line below.
import { run } from "std/process"

fn main() {
  let code = run("/bin/echo", ["hello from std/process run"])
  if (code != 0) {
    panic("std/process run: expected exit 0, got ${code}")
  }
  println("run exit=${code}")
}
