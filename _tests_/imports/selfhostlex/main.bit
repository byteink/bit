// Self-host readiness spike (#1331): a representative slice of the lexer, ported
// to Bit, to prove the language can express the compiler's real patterns — a
// large sum-type enum, a class with methods, byte-level scanning over `s[i]`,
// string slicing, a growable `[]Token` via `append`, and `match`. It tokenizes a
// sample and prints one token per line (`<kind> <start> <end>`), mirroring the
// seed's `--dump-tokens`. Not the final lexer (that is #1334, differential-
// tested); this is the confidence check that the port is tractable.

enum Kind {
  Ident,
  Int,
  Plus,
  Minus,
  Star,
  Slash,
  Eq,
  LParen,
  RParen,
  Semi,
  Unknown,
  Eof,
}

class Token {
  kind: Kind,
  start: int,
  end: int,
}

fn isDigit(c: u8): bool {
  return c >= '0' && c <= '9'
}

fn isAlpha(c: u8): bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

fn isAlnum(c: u8): bool {
  return isDigit(c) || isAlpha(c)
}

fn opKind(c: u8): Kind {
  if (c == '+') {
    return Kind.Plus
  }
  if (c == '-') {
    return Kind.Minus
  }
  if (c == '*') {
    return Kind.Star
  }
  if (c == '/') {
    return Kind.Slash
  }
  if (c == '=') {
    return Kind.Eq
  }
  if (c == '(') {
    return Kind.LParen
  }
  if (c == ')') {
    return Kind.RParen
  }
  if (c == ';') {
    return Kind.Semi
  }
  return Kind.Unknown
}

fn isSpace(c: u8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

// Advances i past a run of bytes satisfying pred -- the digit run and the
// identifier-tail run below both use this instead of their own while loop
// (E0204 -- see lex()'s own comment).
fn scanWhile(src: string, i: int, n: int, pred: (u8) => bool): int {
  let j = i
  while (j < n && pred(src[j])) {
    j = j + 1
  }
  return j
}

// Advances i past a `//` line comment body (the caller has already confirmed
// one starts at i); stops at the newline, which the outer loop then skips as
// ordinary whitespace.
fn scanLineComment(src: string, i: int, n: int): int {
  let j = i
  while (j < n && src[j] != '\n') {
    j = j + 1
  }
  return j
}

// Tokenize `src` into a growable slice. Skips whitespace and `//` line comments;
// scans identifiers, integers, and single-character operators. Every loop is
// bounded by `len(src)` and advances at least one byte per iteration.
// isSpace/scanWhile/scanLineComment above pulled the run-scanning out of the
// four inline while loops this used to have (E0204, was complexity 17, limit 10).
fn lex(src: string): []Token {
  let toks: []Token = []Token(0)
  let i = 0
  let n = len(src)
  while (i < n) {
    let c = src[i]
    if (isSpace(c)) {
      i = scanWhile(src, i, n, isSpace)
      continue
    }
    if (c == '/' && i + 1 < n && src[i + 1] == '/') {
      i = scanLineComment(src, i, n)
      continue
    }
    if (isDigit(c)) {
      let start = i
      i = scanWhile(src, i, n, isDigit)
      toks = append(toks, Token{ kind: Kind.Int, start: start, end: i })
      continue
    }
    if (isAlpha(c)) {
      let start = i
      i = scanWhile(src, i, n, isAlnum)
      toks = append(toks, Token{ kind: Kind.Ident, start: start, end: i })
      continue
    }
    toks = append(toks, Token{ kind: opKind(c), start: i, end: i + 1 })
    i = i + 1
  }
  toks = append(toks, Token{ kind: Kind.Eof, start: n, end: n })
  return toks
}

// Split into two exhaustive matches, each with a wildcard delegating to the
// other half (E0204, was complexity 13, limit 10 -- each match_arm, including
// a wildcard, counts as one branch).
fn kindName(k: Kind): string {
  match (k) {
    Ident => { return "Ident" }
    Int => { return "Int" }
    Plus => { return "Plus" }
    Minus => { return "Minus" }
    Star => { return "Star" }
    Slash => { return "Slash" }
    _ => { return kindNameRest(k) }
  }
}

// The other half of kindName's variants. The wildcard arm is unreachable in
// practice -- kindName above already handles every variant it would match --
// but `match` must still be exhaustive over the full Kind type.
fn kindNameRest(k: Kind): string {
  match (k) {
    Eq => { return "Eq" }
    LParen => { return "LParen" }
    RParen => { return "RParen" }
    Semi => { return "Semi" }
    Unknown => { return "Unknown" }
    Eof => { return "Eof" }
    _ => { return "Unknown" }
  }
}

fn main() {
  let src = "let x = 42 + y // c\n(x);"
  let toks = lex(src)
  for t of toks {
    print("${kindName(t.kind)} ${t.start} ${t.end}\n")
  }
}
