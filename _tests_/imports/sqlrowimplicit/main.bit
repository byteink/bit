// #6251: the row module loads before std/sql; imported class and function aliases work.
import { Row as Projection } from "./model"
import { ExplicitRow } from "./explicit"
import { TableRow } from "./table"
import { localFind } from "./lookalike"
import { ExecResult, Rows, Value, asInt, find as many, findOne, findOneOrFail } from "std/sql"

class ResultRows {
  i: int = -1
  next(): bool! {
    this.i = this.i + 1
    return this.i == 0
  }

  columns(): []string {
    return ["id", "caption", "nick", "rows_affected", "last_insert_id"]
  }

  value(col: int): Value {
    if (col == 0 || col == 3) {
      return Value.Int(7)
    }
    if (col == 1) {
      return Value.Text("mapped")
    }
    return Value.Null
  }

  close() {}
}

class Database {
  query(sqlText: string, params: []Value): Rows! {
    return ResultRows{}
  }

  exec(sqlText: string, params: []Value): ExecResult! {
    return ExecResult{ rowsAffected = 0 }
  }
}

fn main(): ()! {
  let db = Database{}
  let rows = many<Projection>(db, "SELECT id, caption, nick")?
  let one = findOne<Projection>(db, "SELECT id, caption, nick")?
  let required = findOneOrFail<Projection>(db, "SELECT id, caption, nick")?
  let provider = findOneOrFail<ExecResult>(db, "SELECT rows_affected")?
  assert(provider.rowsAffected == 7 && !isSome(provider.lastInsertId))
  let explicit = findOneOrFail<ExplicitRow>(db, "SELECT id")?
  assert(asInt(explicit.asValue())? == 7)
  let table = findOneOrFail<TableRow>(db, "SELECT id")?
  print("many=${len(rows)} id=${rows[0].id} title=${rows[0].title} nick=${isSome(rows[0].nick)}\n")
  print("one=${unwrap(one).id} required=${required.id} explicit=${explicit.id} persisted=${table.isPersisted()}\n")
  print("local=${localFind()} provider=${provider.rowsAffected}\n")
}
