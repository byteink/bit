// std/net close() idempotency regression (#2313): a second close() on an
// already-closed handle must not touch the fd number, because by then the
// kernel may have reassigned it to a different, live socket. All three
// closable types are exercised: `Conn` (the reported repro — a stray second
// close of an already-closed connection must not sever an unrelated live
// one), `Listener`, and `UdpSocket`.
import { listen, dial, udpBind, Listener, Conn, Datagram } from "std/net"

fn echoLoop(l: Listener, n: int) {
  let i = 0
  while (i < n) {
    let c = l.accept() catch _ {
      return
    }
    spawn echoOne(c)
    i = i + 1
  }
}

fn echoOne(c: Conn) {
  while (true) {
    let m = c.read(4096)
    if (len(m) == 0) {
      break
    }
    c.write(m) catch _ {
      break
    }
  }
  c.close()
}

fn rt(c: Conn, msg: string): string {
  c.write(msg) catch _ {
    return "<write err>"
  }
  return c.read(4096)
}

// A stray second close of an already-closed `a` (after its fd has been
// reassigned to `b`) must not sever `b`.
fn connDoubleClose(): ()! {
  let l = listen("127.0.0.1", 0)?
  let p = l.port()?
  spawn echoLoop(l, 4)
  let a = dial("127.0.0.1", p)?
  println("conn A first rt: ${rt(a, "hello-a")}")
  a.close()
  let b = dial("127.0.0.1", p)?
  println("conn B before:   ${rt(b, "hello-b")}")
  a.close()
  println("conn B after:    ${rt(b, "hello-b-again")}")
  b.close()
  l.close()
}

// A stray second close of an already-closed `l1` (after its fd has been
// reassigned to `l2`) must not sever `l2` — dialling `l2`'s port must still
// reach it.
fn listenerDoubleClose(): ()! {
  let l1 = listen("127.0.0.1", 0)?
  l1.close()
  let l2 = listen("127.0.0.1", 0)?
  l1.close()
  let p2 = l2.port()?
  spawn echoLoop(l2, 1)
  let c = dial("127.0.0.1", p2)?
  println("listener2 rt: ${rt(c, "hello-l2")}")
  c.close()
  l2.close()
}

// A stray second close of an already-closed `s1` (after its fd has been
// reassigned to `s2`) must not touch `s2`'s socket: `s2` must still be able to
// send and receive afterward.
//
// #3730: this used to assert that a THIRD `udpBind` on `s2`'s own port was
// rejected while `s2` was still open — a bind-collision probe rather than a
// direct check of `s2`. That is not portable: every `udpBind` here sets
// SO_REUSEADDR (runtime/net/linux/udp.bit, runtime/net/darwin/udp.bit), and
// Linux's kernel lets a new UDP socket rebind a port that is still held by
// another live SO_REUSEADDR socket, while Darwin's does not — confirmed with
// a bare socket(2)/bind(2) probe outside Bit entirely (no `Conn`/`Listener`
// involved), deterministic 10/10 on each side. So the probe's outcome is a
// genuine kernel difference with nothing to do with double-close
// correctness, and cannot be the assertion on both platforms. Round-tripping
// a datagram through `s2` itself is: if the stray close had touched a
// reassigned fd, this send/recv would fail.
fn udpDoubleClose(): ()! {
  let s1 = udpBind("127.0.0.1", 0)?
  s1.close()
  let s2 = udpBind("127.0.0.1", 0)?
  s1.close()
  let p2 = s2.port()?
  s2.send("127.0.0.1", p2, "hello-udp")?
  let dg = s2.recv(4096)?
  println("udp rt: ${dg.data}")
  s2.close()
}

fn main() {
  connDoubleClose() catch e {
    println("conn: error ${e.message()}")
  }
  listenerDoubleClose() catch e {
    println("listener: error ${e.message()}")
  }
  udpDoubleClose() catch e {
    println("udp: error ${e.message()}")
  }
}
