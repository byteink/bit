// #2133: a GENERIC function reached through a NAMESPACE import passed `bit
// check` and `bit lint` clean and then refused to emit — `cannot lower 1
// function(s): main`, with no span and naming the caller rather than the call.
//
// checkmodule.bit records a generic call's instantiation only when the callee
// is a bare `Ident`, so a dotted `util.idOf(7)` requested nothing and lowering
// had no instance to reference. The named-import spelling of the very same
// function worked, which is what made it look module-specific: `std/strings` is
// not generic, so `import strings from "std/strings"` was fine, while `std/seq`
// is generic throughout and unusable in the spelling SPEC §17.2 documents first.
//
// #1154 wired the non-generic namespace call and is closed; `util.plain` below
// is its regression guard.
import util from "./util"
import * as u2 from "./util"
import seq from "std/seq"

fn main() {
  // The report's own case: generic, namespace-qualified.
  println("${util.idOf(7)}")
  println("${util.idOf("seven")}")

  // A generic whose type argument comes from a slice element, through the
  // namespace: the substitution has to survive the dotted callee too.
  println("${util.firstOf([4, 5, 6], 0)}")

  // `import * as` binds the same kind of namespace.
  println("${u2.idOf(true)}")

  // Non-generic through the namespace — this always worked (#1154).
  println("${util.plain(1)}")

  // The stdlib instance, which is how it was found: every `std/seq` export is
  // generic, so the namespace form made the whole module unreachable.
  let xs = [1, 2, 3]
  println("${seq.contains(xs, 2)}")
  let evens = seq.filter(xs, (v: int) => v % 2 == 0)
  println("${len(evens)} ${evens[0]}")
}
