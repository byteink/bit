// Option<T> and Result<T,E> come from the prelude (std/core) with no import at
// all — generic enums instantiated here for i64 and string. Exercises: type
// arguments inferred from the expected return type (Some/None/Ok/Err below),
// inference from the argument alone (`Option.Some(100)`), a string (GC-traced)
// payload, and payload-binding `match` over a cross-module generic enum.
fn find(xs: []i64, target: i64): Option<i64> {
  for x of xs {
    if (x == target) {
      return Option.Some(x)
    }
  }
  return Option.None
}

fn checkedDiv(a: i64, b: i64): Result<i64, string> {
  if (b == 0) {
    return Result.Err("divide by zero")
  }
  return Result.Ok(a / b)
}

fn showOpt(o: Option<i64>) {
  match (o) {
    Some(v) => println("found ${v}")
    None => println("missing")
  }
}

fn showDiv(a: i64, b: i64) {
  match (checkedDiv(a, b)) {
    Ok(q) => println("${a}/${b} = ${q}")
    Err(m) => println("error: ${m}")
  }
}

fn main() {
  let xs = [3, 7, 42, 9]
  showOpt(find(xs, 42))
  showOpt(find(xs, 5))
  showOpt(Option.Some(100))
  showDiv(10, 2)
  showDiv(7, 0)
}
