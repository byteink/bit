import { runeCount, runeAt, runes } from "std/strings"

fn main() {
  println("ascii ${runeCount("hello")} ${len("hello")}")
  println("accent ${runeCount("héllo")} ${len("héllo")}")
  println("cjk ${runeCount("日本語")} ${len("日本語")}")
  println("emoji ${runeCount("😀")} ${len("😀")}")
  println("cp ${runeAt("héllo", 1)} ${runeAt("😀", 0)}")
  println("decoded ${len(runes("日本語"))}")
}
