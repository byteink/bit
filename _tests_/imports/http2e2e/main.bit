// std/http HTTP/2-over-TLS loopback (#1218): a `serveTls` server advertising ALPN
// ["h2","http/1.1"] on 127.0.0.1, exercised over both negotiated protocols.
//
// The proof that HTTP/2 is genuinely in use, not silently downgraded, is threefold
// and deterministic:
//   * a client that offers ONLY "h2" (`h2Cfg`) round-trips a GET and a POST. This is
//     only conclusive because the server ABORTS a disjoint ALPN offer (RFC 7301
//     §3.2) rather than downgrading it — proven directly by `disjoint-reject`
//     below. With the abort in place, a correct body over an h2-only client can
//     only mean the h2 engine served it;
//   * a raw `tls.dial` reports `alpnProtocol()=="h2"` and an independent, spec
//     `std/http2` client (`connect`+`roundTrip`) driven over that TLS socket gets
//     the same answer — proving `serveTls`'s server-side h2 branch;
//   * the SAME request over a client offering only "http/1.1" (`h1Cfg`) still works
//     through the HTTP/1.1 fallback path, and a raw dial confirms that negotiation.
//
// The handshake keys and nonces are random, but every printed line is a boolean, so
// the golden `expected` is deterministic. The certificate chain + RSA key are the
// same throwaway PKI as the std/tls and https-client loopback tests (leaf SAN:
// localhost, example.com), signed by the test root CA. The client retries the dial
// while the spawned server binds, so no wall-clock timing leaks into the output.
import { requestTls, serveTls, ok, respond, Request, Response } from "std/http"
import { connect, newTransport, defaultConfig, Transport, newRequest } from "std/http2"
import { dial as tlsDial, newTlsConfig, newTrustStore, TlsConfig, TlsConn } from "std/tls"
import { decodeHex, pemEncode } from "std/crypto"
import { sleep, Millisecond } from "std/time"

const caHex: string = ""
const leafHex: string = ""
const keyHex: string = ""

const testPort: int = 47032

fn hx(s: string): []byte {
  return decodeHex(s) catch e {
    return []byte(0)
  }
}
fn pemOf(label: string, h: string): string { return pemEncode(label, hx(h)) }

fn report(tag: string, ok: bool) {
  if (ok) {
    println(tag + " PASS")
    return
  }
  println(tag + " FAIL")
}

// The transport-agnostic handler, shared by the h2 and http/1.1 server paths.
fn route(req: Request): Response {
  if (req.method == "POST") {
    return ok("echo:${req.body}")
  }
  if (req.path == "/") {
    return ok("secure root")
  }
  return respond(404, "missing")
}

// The TLS server, run in its own green thread; it binds inside `serveTls` and
// advertises ALPN ["h2","http/1.1"].
fn server() {
  serveTls(
    "127.0.0.1",
    testPort,
    pemOf("CERTIFICATE", leafHex),
    pemOf("PRIVATE KEY", keyHex),
    route,
  ) catch e {
    println("server error: ${e.message()}")
  }
}

// A client config trusting the test CA and pinning the SNI/name to the leaf SAN
// and the clock into the certificate's validity window; `alpn` is set per call.
fn baseCfg(): TlsConfig! {
  let cfg = newTlsConfig(newTrustStore(pemOf("CERTIFICATE", caHex))?)
  cfg.serverName = "localhost"
  cfg.nowUnix = 1800000000
  return cfg
}

fn h2Cfg(): TlsConfig! {
  let cfg = baseCfg()?
  cfg.alpn = ["h2"]
  return cfg
}

fn h1Cfg(): TlsConfig! {
  let cfg = baseCfg()?
  cfg.alpn = ["http/1.1"]
  return cfg
}

// Issue `method path` once the server is up, retrying the dial while it binds.
fn fetchTls(method: string, path: string, body: string, cfg: TlsConfig): Response! {
  let url = "https://127.0.0.1:${testPort}${path}"
  let attempt = 0
  while (attempt < 200) {
    let r = requestTls(method, url, body, cfg) catch e {
      sleep(10 * Millisecond)
      attempt = attempt + 1
      continue
    }
    return r
  }
  fail newError("server did not come up")
}

// A one-request GET/POST via the http client; PASS iff status 200 and body match.
fn checkFetch(
  tag: string,
  method: string,
  path: string,
  body: string,
  cfg: TlsConfig,
  want: string,
) {
  let r = fetchTls(method, path, body, cfg) catch e {
    report(tag, false)
    return
  }
  report(tag, r.status == 200 && r.body == want)
}

// Adapt a raw `TlsConn` to the http2 engine's byte transport (mirrors the shim
// std/http installs internally), so a spec http2 client can drive the h2 socket.
fn h2transport(conn: TlsConn): Transport {
  return newTransport(
    (n) => {
      let b = conn.read(n) catch e {
        return []byte(0)
      }
      return b
    },
    (b) => {
      writeConn(conn, b)
    },
    () => {
      conn.close()
    },
  )
}

// Best-effort write for the transport shim (an arrow closure cannot be fallible).
fn writeConn(conn: TlsConn, b: []byte) {
  conn.write(b) catch e {
    return
  }
}

// Prove the server h2 branch independently: a raw dial negotiates "h2", and a
// spec `std/http2` client round-trips the same GET over it.
fn directH2() {
  let cfg = h2Cfg() catch e {
    report("h2-alpn", false)
    report("h2-direct", false)
    return
  }
  let conn = tlsDial("127.0.0.1", testPort, cfg) catch e {
    report("h2-alpn", false)
    report("h2-direct", false)
    return
  }
  report("h2-alpn", conn.alpnProtocol() == "h2")
  let hc = connect(h2transport(conn), defaultConfig(), 0) catch e {
    report("h2-direct", false)
    return
  }
  let res = hc.roundTrip(newRequest("GET", "127.0.0.1", "/")) catch e {
    report("h2-direct", false)
    return
  }
  report("h2-direct", res.status == 200 && string(res.body) == "secure root")
  conn.close()
}

// Prove ALPN negotiates `want` when the client offers exactly `alpn`.
fn dialAlpn(tag: string, want: string, alpn: []string) {
  let cfg = baseCfg() catch e {
    report(tag, false)
    return
  }
  cfg.alpn = alpn
  let conn = tlsDial("127.0.0.1", testPort, cfg) catch e {
    report(tag, false)
    return
  }
  report(tag, conn.alpnProtocol() == want)
  conn.close()
}

// A client offering ONLY protocols the server does not support must have its
// handshake ABORTED (RFC 7301 §3.2 no_application_protocol), not silently
// downgraded and served. PASS iff the dial fails. This is what makes the
// "offer only h2" proof above actually sound — without the abort, a disjoint
// offer would complete over the fallback and every check above would still pass.
fn dialReject(tag: string, alpn: []string) {
  let cfg = baseCfg() catch e {
    report(tag, false)
    return
  }
  cfg.alpn = alpn
  let conn = tlsDial("127.0.0.1", testPort, cfg) catch e {
    report(tag, true) // dial rejected — correct
    return
  }
  // Handshake completed despite a disjoint offer: the downgrade bug is back.
  report(tag, false)
  conn.close()
}

fn run(): ()! {
  spawn server()
  let h2 = h2Cfg()?
  let h1 = h1Cfg()?
  // 1. HTTP/2 through the http client: GET and POST (request + response bodies).
  checkFetch("h2-get", "GET", "/", "", h2, "secure root")
  checkFetch("h2-post", "POST", "/submit", "payload", h2, "echo:payload")
  // 2. Prove h2 on the wire + the server engine with a direct http2 client.
  directH2()
  // 3. HTTP/1.1 fallback through the same client and handler.
  checkFetch("h1-get", "GET", "/", "", h1, "secure root")
  // 4. Prove http/1.1 negotiation on the wire.
  dialAlpn("h1-alpn", "http/1.1", ["http/1.1"])
  // 5. A disjoint ALPN offer must be rejected, not downgraded (RFC 7301 §3.2).
  dialReject("disjoint-reject", ["bogus/9"])
}

fn main() {
  run() catch e {
    println("failed: ${e.message()}")
  }
}
