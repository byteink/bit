// #5388: `Wrapped<T>` and the free function that returns it. This file must
// sort BEFORE main.bit (`listBitFiles`, compiler/project.bit, is alphabetical)
// so `checkModule`'s per-generic method-copy sweep reaches Wrapped's own turn
// BEFORE Box's — the declaration order that reproduced #5388's checker
// defect. See main.bit for the mechanism.
class Wrapped<T> {
  inner: Box<T>
  unwrap(): T {
    return this.inner.v
  }
}

fn wrap<T>(b: Box<T>): Wrapped<T> {
  return Wrapped<T>{ inner = b }
}
