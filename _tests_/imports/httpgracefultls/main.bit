// std/http graceful shutdown for TLS/h2 servers (#4314): `TlsServer.shutdown`
// closes the gap `_tests_/imports/httpgracefulshutdown` (plain HTTP) and
// `httpgracefulh2` (the h2 GOAWAY mechanism, standalone, no TLS) left open —
// `serveTls`/`serveTlsOn` had no way to stop other than killing the process.
// `tlsServe`/`serveTlsServerOn` are the shutdown-capable mirror
// (stdlib/http/server.bit), and this is a REAL running program, not reasoning
// about the design: a live TLS server, clients holding requests open across the
// shutdown call, and a raw socket/h2 connection proving what actually happened
// on the wire — including GOAWAY, observed by a real h2 client refusing a
// further stream locally.
//
// The certificate chain + RSA key are the same throwaway test PKI as
// `httpsclient`/`http2e2e` (leaf SAN: localhost, example.com), signed by the
// test root CA.
//
// Exact elapsed milliseconds are not printed — this repo's dev machines run
// several concurrent agents — only that a fast path finishes in a small
// fraction of its timeout budget, the same style `httpgracefulshutdown`
// already uses.
import { tlsServe, serveTlsServerOn, ok, getTls, Request, Response, TlsServer } from "std/http"
import { connect, newTransport, defaultConfig, newRequest, Transport, Conn as H2Conn } from "std/http2"
import {
  dial as tlsDial, dialDeadline as tlsDialDeadline, newTlsConfig, newTrustStore, TlsConfig, TlsConn,
} from "std/tls"
import { dial } from "std/net"
import { decodeHex, pemEncode } from "std/crypto"
import { sleep, Millisecond, monotonic, since } from "std/time"
import { indexOf } from "std/strings"

const caHex: string = ""
const leafHex: string = ""
const keyHex: string = ""

fn hx(s: string): []byte {
  return decodeHex(s) catch _ {
    return []byte(0)
  }
}
fn pemOf(label: string, h: string): string { return pemEncode(label, hx(h)) }

fn report(tag: string, passed: bool) {
  if (passed) {
    println(tag + " PASS")
    return
  }
  println(tag + " FAIL")
}

fn certPem(): string { return pemOf("CERTIFICATE", leafHex) }
fn keyPem(): string { return pemOf("PRIVATE KEY", keyHex) }

fn baseCfg(): TlsConfig! {
  let cfg = newTlsConfig(newTrustStore(pemOf("CERTIFICATE", caHex))?)
  cfg.serverName = "localhost"
  cfg.nowUnix = 1800000000
  return cfg
}

fn h1Cfg(): TlsConfig! {
  let cfg = baseCfg()?
  cfg.alpn = ["http/1.1"]
  return cfg
}

fn h2Cfg(): TlsConfig! {
  let cfg = baseCfg()?
  cfg.alpn = ["h2"]
  return cfg
}

// A handler that signals `startedCh` the instant it is invoked (proof the
// request genuinely reached it, not a guessed delay), then sleeps `sleepMs`
// before answering — the in-flight work `shutdown` must protect.
fn slowHandler(startedCh: chan<bool>, sleepMs: int): (Request) => Response {
  return (req) => {
    startedCh <- true
    sleep(sleepMs * Millisecond)
    return ok("slow-done")
  }
}

fn quietHandler(req: Request): Response {
  return ok("quiet")
}

fn runServer(ts: TlsServer, handler: (Request) => Response) {
  serveTlsServerOn(ts, handler) catch _ {
    return
  }
}

// The result of a `shutdown` call: its error message ("" for none) and how
// long it took, mirroring `httpgracefulshutdown`'s own helper.
class shutdownResult { msg: string, elapsedMs: int }

fn doTlsShutdown(ts: TlsServer, timeoutMs: int): shutdownResult {
  let t0 = monotonic()
  let msg = ""
  ts.shutdown(timeoutMs) catch e {
    msg = e.message()
  }
  return shutdownResult{ msg: msg, elapsedMs: since(t0) / Millisecond }
}

// ---------------------------------------------------------------------------
// Scenario 1: HTTP/1.1-over-TLS, in-flight request completes before the
// timeout — the same drain `Server.shutdown()` proves, now reached through
// `TlsServer`.
// ---------------------------------------------------------------------------

class getResult { status: int, body: string }

fn doGetTls(port: int, cfg: TlsConfig, resultCh: chan<getResult>) {
  let r = getTls("https://127.0.0.1:${port}/", cfg) catch _ {
    resultCh <- getResult{ status: 0, body: "" }
    return
  }
  resultCh <- getResult{ status: r.status, body: r.body }
}

fn scenarioTlsCompletesInTime(): ()! {
  let cfg = h1Cfg()?
  let ts = tlsServe("127.0.0.1", 0, certPem(), keyPem())?
  let port = ts.port()?
  let startedCh = chan<bool>(1)
  spawn runServer(ts, slowHandler(startedCh, 150))
  let resultCh = chan<getResult>(1)
  spawn doGetTls(port, cfg, resultCh)
  <- startedCh

  let first = doTlsShutdown(ts, 5000)
  report("tls-intime-shutdown-no-error", len(first.msg) == 0)

  let res = <- resultCh
  report("tls-intime-client-got-full-response", res.status == 200 && res.body == "slow-done")

  let second = doTlsShutdown(ts, 5000)
  report("tls-intime-second-shutdown-no-error", len(second.msg) == 0)
  report("tls-intime-second-shutdown-fast", second.elapsedMs < 500)

  dial("127.0.0.1", port) catch _ {
    report("tls-intime-new-connection-refused", true)
    return
  }
  report("tls-intime-new-connection-refused", false)
}

// ---------------------------------------------------------------------------
// Scenario 2: an idle HTTP/1.1-over-TLS connection — handshake done, no
// request sent — is force-closed right away, not held for the timeout.
// ---------------------------------------------------------------------------

fn scenarioTlsIdleClosedImmediately(): ()! {
  let cfg = h1Cfg()?
  let ts = tlsServe("127.0.0.1", 0, certPem(), keyPem())?
  let port = ts.port()?
  spawn runServer(ts, quietHandler)

  let conn = tlsDialDeadline("127.0.0.1", port, cfg, monotonic().ns + 5000 * Millisecond)?
  // Give the accept loop a moment to register the connection before shutdown
  // runs, so this tests "idle and already registered", not a race with
  // accept() itself.
  sleep(50 * Millisecond)

  let out = doTlsShutdown(ts, 60000)
  report("tls-idle-shutdown-no-error", len(out.msg) == 0)
  report("tls-idle-shutdown-fast", out.elapsedMs < 5000)

  let readBack = conn.read(16) catch _ {
    report("tls-idle-conn-force-closed", true)
    return
  }
  // Empty AND not a deadline timeout — a genuine force-close, not this
  // connection's own 5s dial deadline expiring.
  report("tls-idle-conn-force-closed", len(readBack) == 0 && !conn.readTimedOut())
}

// ---------------------------------------------------------------------------
// Scenario 3: an in-flight h2 stream — `shutdown` sends GOAWAY (`H2Conn.close()`)
// while it is running, the client observes it (a further stream is refused
// LOCALLY, the same proof `httpgracefulh2` uses), the in-flight stream still
// gets its real response, and `shutdown` returns once the connection closes —
// well before its timeout budget.
// ---------------------------------------------------------------------------

fn h2transport(conn: TlsConn): Transport {
  return newTransport(
    (n) => {
      let b = conn.read(n) catch _ {
        return []byte(0)
      }
      return b
    },
    (b) => {
      h2writeConn(conn, b)
    },
    () => {
      conn.close()
    },
  )
}

fn h2writeConn(conn: TlsConn, b: []byte) {
  conn.write(b) catch _ {
    return
  }
}

class h2Result { status: int, body: string, goawayRefused: bool }

// Round-trip the in-flight stream, then attempt a SECOND stream on the same
// connection — refused locally, with no wire round trip, iff GOAWAY was
// genuinely received — and close the connection so the server's transport
// observes EOF and `shutdown` can return.
fn h2ClientFlow(conn: TlsConn, cc: H2Conn, resultCh: chan<h2Result>) {
  let res1 = cc.roundTrip(newRequest("GET", "127.0.0.1", "/")) catch _ {
    conn.close()
    resultCh <- h2Result{ status: 0, body: "", goawayRefused: false }
    return
  }
  let status = res1.status
  let body = string(res1.body)

  let refused = false
  let _ = cc.roundTrip(newRequest("GET", "127.0.0.1", "/again")) catch e {
    refused = indexOf(e.message(), "closing") >= 0
    conn.close()
    resultCh <- h2Result{ status: status, body: body, goawayRefused: refused }
    return
  }
  conn.close()
  resultCh <- h2Result{ status: status, body: body, goawayRefused: false }
}

fn scenarioH2GoawayThenDrain(): ()! {
  let cfg = h2Cfg()?
  let ts = tlsServe("127.0.0.1", 0, certPem(), keyPem())?
  let port = ts.port()?
  let startedCh = chan<bool>(1)
  spawn runServer(ts, slowHandler(startedCh, 150))

  let conn = tlsDial("127.0.0.1", port, cfg)?
  let cc = connect(h2transport(conn), defaultConfig(), 0)?
  let resultCh = chan<h2Result>(1)
  spawn h2ClientFlow(conn, cc, resultCh)
  <- startedCh

  let out = doTlsShutdown(ts, 5000)
  report("h2-shutdown-no-error", len(out.msg) == 0)
  report("h2-shutdown-fast", out.elapsedMs < 3000)

  let cres = <- resultCh
  report("h2-inflight-stream-completed", cres.status == 200 && cres.body == "slow-done")
  report("h2-goaway-observed-before-close", cres.goawayRefused)
}

fn run(): ()! {
  scenarioTlsCompletesInTime()?
  scenarioTlsIdleClosedImmediately()?
  scenarioH2GoawayThenDrain()?
}

fn main() {
  run() catch e {
    println("failed: ${e.message()}")
  }
}
