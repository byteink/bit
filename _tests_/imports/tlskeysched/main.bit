// std/tls TLS 1.3 key schedule (#1202): the RFC 8448 §3 "Simple 1-RTT Handshake"
// trace, reproduced end to end and hex-compared. From only the trace's ECDHE
// shared secret and its four transcript hashes, this walks the full RFC 8446 §7.1
// ladder — Early -> Handshake -> Master, the client/server handshake and
// application traffic secrets, the exporter and resumption secrets, and each
// secret's `key`/`iv`, `finished_key`, and the real client Finished `verify_data`
// MAC — and checks every output byte-identical to RFC 8448. The schedule is
// generic over the suite hash; SHA-256 here is `HashAlg.Sha256`. Every
// output is deterministic, so the golden `expected` is stable across targets.
import { HashAlg, encodeHex, decodeHex, ctEq } from "std/crypto"
import { TranscriptHash, deriveSecret, earlySecret, handshakeSecret, masterSecret } from "std/tls"
import {
  clientHandshakeTrafficSecret,
  serverHandshakeTrafficSecret,
  clientApplicationTrafficSecret,
  serverApplicationTrafficSecret,
} from "std/tls"
import {
  exporterMasterSecret,
  resumptionMasterSecret,
  trafficKey,
  trafficIV,
  finishedKey,
  finishedMac,
} from "std/tls"

// The bytes a hex string spells; the trace's inputs are all valid hex, so the
// `catch` is unreachable.
fn hx(s: string): []byte {
  return decodeHex(s) catch e {
    return []byte(0)
  }
}

fn main() {
  // Trace inputs: the ECDHE shared secret and the four transcript-hash
  // checkpoints RFC 8448 §3 prints — empty, ClientHello..ServerHello,
  // ClientHello..server Finished, and ClientHello..client Finished.
  let ecdhe = hx("8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d")
  let thSH = hx("860c06edc07858ee8e78f0e7428c58edd6b43f2ca3e6e95f02ed063cf0e1cad8")
  let thSF = hx("9608102a0f1ccc6db6250b7b7e417b1a000eaada3daae4777a7686c9ff83df13")
  let thCF = hx("209145a96ee8e2a122ff810047cc952684658d6049e86429426db87c54ad143d")

  // The accumulator's empty digest is the RFC's empty-transcript hash, the
  // context the inter-stage "derived" secrets use.
  let empty = TranscriptHash(HashAlg.Sha256)
  println("emptyhash=${encodeHex(empty.sum())}")

  // Accumulator self-consistency: a running hash of two chunks equals a one-shot
  // hash of their concatenation, proving `update` accumulates in order.
  let split = TranscriptHash(HashAlg.Sha256)
  split.update(hx("00010203"))
  split.update(hx("0405"))
  let whole = TranscriptHash(HashAlg.Sha256)
  whole.update(hx("000102030405"))
  if (ctEq(split.sum(), whole.sum())) {
    println("accum=ok")
  } else {
    println("accum=bad")
  }

  // Early Secret rung, and the "derived" transition fed the empty transcript.
  let early = earlySecret(HashAlg.Sha256, []byte(0))
  println("early=${encodeHex(early)}")
  println("derived=${encodeHex(deriveSecret(HashAlg.Sha256, early, "derived", empty.sum()))}")

  // Handshake Secret rung and its client/server traffic secrets over CH..SH.
  let hs = handshakeSecret(HashAlg.Sha256, early, ecdhe)
  println("hs=${encodeHex(hs)}")
  let chs = clientHandshakeTrafficSecret(HashAlg.Sha256, hs, thSH)
  let shs = serverHandshakeTrafficSecret(HashAlg.Sha256, hs, thSH)
  println("chs=${encodeHex(chs)}")
  println("shs=${encodeHex(shs)}")

  // Per-secret AEAD key/iv (16-byte AES-128 key, 12-byte nonce) for both peers.
  println("ckey=${encodeHex(trafficKey(HashAlg.Sha256, chs, 16))}")
  println("civ=${encodeHex(trafficIV(HashAlg.Sha256, chs, 12))}")
  println("skey=${encodeHex(trafficKey(HashAlg.Sha256, shs, 16))}")
  println("siv=${encodeHex(trafficIV(HashAlg.Sha256, shs, 12))}")

  // Finished MAC keys, and the real client Finished verify_data = HMAC(client
  // finished_key, Transcript-Hash(CH..server Finished)).
  println("cfinkey=${encodeHex(finishedKey(HashAlg.Sha256, chs))}")
  println("sfinkey=${encodeHex(finishedKey(HashAlg.Sha256, shs))}")
  println("cverify=${encodeHex(finishedMac(HashAlg.Sha256, chs, thSF))}")

  // Master Secret rung: application traffic secrets and exporter over CH..server
  // Finished, resumption over CH..client Finished.
  let master = masterSecret(HashAlg.Sha256, hs)
  println("master=${encodeHex(master)}")
  println("cap=${encodeHex(clientApplicationTrafficSecret(HashAlg.Sha256, master, thSF))}")
  println("sap=${encodeHex(serverApplicationTrafficSecret(HashAlg.Sha256, master, thSF))}")
  println("expm=${encodeHex(exporterMasterSecret(HashAlg.Sha256, master, thSF))}")
  println("resm=${encodeHex(resumptionMasterSecret(HashAlg.Sha256, master, thCF))}")
}
