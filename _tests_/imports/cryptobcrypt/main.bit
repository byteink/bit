// std/crypto bcrypt (#1175): published OpenBSD/jBCrypt known-answer vectors
// (verified against Python `bcrypt` before locking), covering an empty password,
// cost 06 and cost 08, and both `2a` and `2b` prefixes; a negative check on a
// wrong password; the 72-byte truncation rule (72 and 100 'A's collide, 71
// differs); a self round-trip through `bcryptHash` with a random salt; and
// rejection of malformed encodings. Costs are kept low — bcrypt is deliberately
// slow — so the suite stays fast. Every printed line is deterministic.
import { bcryptHash, bcryptVerify } from "std/crypto"

// `n` copies of byte `c`.
fn rep(c: byte, n: int): []byte {
  let b = []byte(n)
  let i = 0
  while (i < n) {
    b[i] = c
    i = i + 1
  }
  return b
}

fn main() {
  // Empty password, cost 06, `2a` (the canonical jBCrypt vector).
  let empty = `$2a$06$DCq7YPn5Rq63x1Lad4cll.TV4S6ytwfsfvkgY8jIucDrjc8deX1s.`
  println("v_empty=${bcryptVerify([]byte(""), empty)}")
  println("v_empty_wrong=${bcryptVerify([]byte("x"), empty)}")

  // "abc" at cost 06 (`2a`) and cost 08 (`2b`).
  let abc06 = `$2a$06$If6bvum7DFjUnE9p2uDeDu0YHzrHM6tf.iqN8.yx.jNN1ILEf7h0i`
  let abc08 = `$2b$08$Ro0CUfOqk6cXEKf3dyaM7OhSCvnwM9s4wIX9JeLapehKK5YdLxKcm`
  println("v_abc06=${bcryptVerify([]byte("abc"), abc06)}")
  println("v_abc08=${bcryptVerify([]byte("abc"), abc08)}")
  println("v_abc_wrong=${bcryptVerify([]byte("abd"), abc08)}")

  // `2b` vectors with punctuation and a longer password.
  let cryp = `$2b$06$DCq7YPn5Rq63x1Lad4cll.3ySqikngXu/cZcH048Np9aFsMfdEs4y`
  let pass = `$2b$05$CCCCCCCCCCCCCCCCCCCCC.aDV7CQarKHMuNfh2oJkFzsHZya4whFe`
  println("v_cryp=${bcryptVerify([]byte("Cryptonite!"), cryp)}")
  println("v_pass=${bcryptVerify([]byte("password"), pass)}")

  // 72-byte truncation: 72 and 100 'A's hash the same; 71 does not.
  let a72 = `$2b$05$CCCCCCCCCCCCCCCCCCCCC.iVBhllbQyagYexK5rMOMvXQF4XYnpX2`
  println("v_72A=${bcryptVerify(rep('A', 72), a72)}")
  println("v_100A=${bcryptVerify(rep('A', 100), a72)}")
  println("v_71A=${bcryptVerify(rep('A', 71), a72)}")

  // Self round-trip: hash with a fresh random salt, then verify.
  let h = bcryptHash([]byte("s3cr3t"), 5)
  println("rt_len=${len(h) == 60}")
  println("rt_prefix=${h[0:7] == `$2b$05$`}")
  println("rt_ok=${bcryptVerify([]byte("s3cr3t"), h)}")
  println("rt_bad=${bcryptVerify([]byte("S3cr3t"), h)}")

  // Malformed encodings return false instead of failing.
  println("m_short=${bcryptVerify([]byte("x"), "notahash")}")
  println(
    "m_ver=${bcryptVerify(
      []byte("x"),
      `$2c$06$DCq7YPn5Rq63x1Lad4cll.TV4S6ytwfsfvkgY8jIucDrjc8deX1s.`,
    )}",
  )
}
