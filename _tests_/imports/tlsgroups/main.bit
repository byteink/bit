// std/tls TLS 1.3 named groups + X25519MLKEM768 hybrid (#1203).
//
// The key-share generation is randomized (fresh ephemerals every run), so this
// is a property test, not a fixed-vector one: it asserts the exchange AGREES
// (both sides derive the identical secret), the wire layouts have the spec sizes,
// and — for the hybrid — that the concatenation ORDER is exactly the one
// draft-ietf-tls-ecdhe-mlkem-05 mandates (ML-KEM first). The classical groups
// are already KAT-verified inside std/crypto; here we only confirm agreement.
//
// The hybrid order is the #1 interop bug, so it is cross-checked against the raw
// std/crypto primitives: the client key_share's first 1184 bytes must be a valid
// ML-KEM ek (encapsulation succeeds there, would fail on the x25519 window), and
// the 64-byte secret must split as decaps(ct) ∥ x25519(sharedX) in that order.
import {
  TlsGroup,
  tlsGroupCodepoint,
  tlsGroupFromCodepoint,
  tlsGroupGenerate,
  tlsGroupComputeShared,
  tlsGroupResponder,
} from "std/tls"
import {
  mlkemEncaps,
  mlkemDecaps,
  x25519GenerateKeypair,
  x25519SharedSecret,
} from "std/crypto"

// Whether two byte slices are identical.
fn sameBytes(a: []byte, b: []byte): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// Fresh slice `a ∥ b`.
fn cat(a: []byte, b: []byte): []byte {
  let out = []byte(len(a) + len(b))
  let i = 0
  while (i < len(a)) {
    out[i] = a[i]
    i = i + 1
  }
  let j = 0
  while (j < len(b)) {
    out[len(a) + j] = b[j]
    j = j + 1
  }
  return out
}

// The agreement outcome for one group: did both sides land on the same secret,
// and how long is it.
class AgreeResult {
  agree: bool,
  length: int,
}

// Full three-call round trip for a classical group `g`: the client generates an
// ephemeral share, the server responds (generating its own share and deriving
// the secret), and the client finishes from the server's share. Both secrets
// must match.
fn classicalCheck(g: TlsGroup): AgreeResult {
  let client = tlsGroupGenerate(g)
  let resp = tlsGroupResponder(g, client.keyShare) catch e {
    return AgreeResult{ agree: false, length: 0 }
  }
  let clientShared = tlsGroupComputeShared(g, client.priv, resp.keyShare) catch e {
    return AgreeResult{ agree: false, length: 0 }
  }
  return AgreeResult{ agree: sameBytes(clientShared, resp.shared), length: len(clientShared) }
}

// Codepoint round trip: every supported codepoint maps to a group and back, and
// an unsupported codepoint is rejected.
fn roundtripOk(): bool {
  let a = tlsGroupFromCodepoint(u64(0x001d)) catch e {
    return false
  }
  if (tlsGroupCodepoint(a) != u64(0x001d)) {
    return false
  }
  let b = tlsGroupFromCodepoint(u64(0x0017)) catch e {
    return false
  }
  if (tlsGroupCodepoint(b) != u64(0x0017)) {
    return false
  }
  let c = tlsGroupFromCodepoint(u64(0x0018)) catch e {
    return false
  }
  if (tlsGroupCodepoint(c) != u64(0x0018)) {
    return false
  }
  let d = tlsGroupFromCodepoint(u64(0x11ec)) catch e {
    return false
  }
  if (tlsGroupCodepoint(d) != u64(0x11ec)) {
    return false
  }
  // An unknown codepoint must fail rather than resolve to some group.
  tlsGroupFromCodepoint(u64(0x9999)) catch e {
    return true
  }
  return false
}

// The module's own hybrid server path (tlsGroupResponder) must agree with the
// client, with the spec's response sizes.
fn hybridResponderAgrees(): bool {
  let g = TlsGroup.X25519MLKEM768
  let client = tlsGroupGenerate(g)
  if (len(client.keyShare) != 1216) {
    return false
  } // ek 1184 ∥ x25519 32
  if (len(client.priv) != 2432) {
    return false
  } // dk 2400 ∥ x25519 32
  let resp = tlsGroupResponder(g, client.keyShare) catch e {
    return false
  }
  if (len(resp.keyShare) != 1120) {
    return false
  } // ct 1088 ∥ x25519 32
  if (len(resp.shared) != 64) {
    return false
  } // mlkem 32 ∥ x25519 32
  let clientShared = tlsGroupComputeShared(g, client.priv, resp.keyShare) catch e {
    return false
  }
  return sameBytes(clientShared, resp.shared)
}

// The load-bearing test: prove the hybrid's concatenation ORDER against the raw
// crypto primitives, driving the server side manually so we control every byte.
fn hybridLayoutOk(): bool {
  let g = TlsGroup.X25519MLKEM768
  let client = tlsGroupGenerate(g)
  if (len(client.keyShare) != 1216) {
    return false
  }
  if (len(client.priv) != 2432) {
    return false
  }

  // Client key_share order: the FIRST 1184 bytes are the ML-KEM ek. Encapsulating
  // to that window must succeed (mlkemEncaps validates the ek); had x25519 sat
  // first, this 1184-byte window would fail the ek modulus check.
  let ek = client.keyShare[0:1184]
  let clientXPub = client.keyShare[1184:1216]
  let enc = mlkemEncaps(ek) catch e {
    return false
  }

  // Build the server side by hand in the spec order and confirm the module's
  // client finish lands on the exact same 64 bytes.
  let sx = x25519GenerateKeypair()
  let serverXSs = x25519SharedSecret(sx.priv, clientXPub) catch e {
    return false
  }
  let serverShare = cat(enc.ct, sx.pub)     // ct 1088 ∥ x25519 32
  let serverSecret = cat(enc.ss, serverXSs) // mlkem 32 ∥ x25519 32
  if (len(serverShare) != 1120) {
    return false
  }
  if (len(serverSecret) != 64) {
    return false
  }

  let clientSecret = tlsGroupComputeShared(g, client.priv, serverShare) catch e {
    return false
  }
  if (len(clientSecret) != 64) {
    return false
  }
  if (!sameBytes(clientSecret, serverSecret)) {
    return false
  }

  // Secret order: first 32 bytes are the ML-KEM shared secret (decapsulation),
  // last 32 are the X25519 shared secret.
  let dk = client.priv[0:2400]
  let clientXPriv = client.priv[2400:2432]
  let kemSs = mlkemDecaps(dk, enc.ct)
  let clientXSs = x25519SharedSecret(clientXPriv, sx.pub) catch e {
    return false
  }
  if (!sameBytes(clientSecret[0:32], kemSs)) {
    return false
  }
  if (!sameBytes(clientSecret[32:64], clientXSs)) {
    return false
  }
  return true
}

fn main() {
  // Registry codepoints (IANA NamedGroup values, decimal).
  println("cp_x25519=${int(tlsGroupCodepoint(TlsGroup.X25519))}")
  println("cp_secp256r1=${int(tlsGroupCodepoint(TlsGroup.Secp256r1))}")
  println("cp_secp384r1=${int(tlsGroupCodepoint(TlsGroup.Secp384r1))}")
  println("cp_hybrid=${int(tlsGroupCodepoint(TlsGroup.X25519MLKEM768))}")
  println("roundtrip_ok=${roundtripOk()}")

  // Classical groups: agreement + shared-secret width.
  let x = classicalCheck(TlsGroup.X25519)
  println("x25519_agree=${x.agree}")
  println("x25519_len=${x.length}")
  let p256 = classicalCheck(TlsGroup.Secp256r1)
  println("secp256r1_agree=${p256.agree}")
  println("secp256r1_len=${p256.length}")
  let p384 = classicalCheck(TlsGroup.Secp384r1)
  println("secp384r1_agree=${p384.agree}")
  println("secp384r1_len=${p384.length}")

  // Hybrid: module round trip and the spec concat-order proof.
  println("hybrid_responder_agree=${hybridResponderAgrees()}")
  println("hybrid_layout_ok=${hybridLayoutOk()}")
}
