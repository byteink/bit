// std/quic QUIC v1 transport core (#1220): a full connection over a local UDP
// pair, driven by two green-thread endpoints (spawn + channels). Eleven
// scenarios (was miscounted "nine" pre-#3557; ten predate it, #3557 adds one):
//
//   * direct — complete the QUIC-TLS handshake, open a client bidi stream,
//     transfer a 96 KiB payload, and assert byte-identical delivery (the
//     received SHA-256 equals the sent one). The payload is three times the
//     32 KiB flow-control window, so it exercises multiple packets, MAX_DATA /
//     MAX_STREAM_DATA window extension, and NewReno pacing.
//
//   * loss — the same transfer, but a shim relay between the endpoints drops a
//     deterministic fraction of the 1-RTT datagrams (never the handshake), so
//     retransmission (packet-threshold + PTO) must recover the whole stream.
//
//   * listener — accept two connections on one shared socket, close the first,
//     then require a round trip on the second and a brand-new third connection.
//     Closing one accepted connection used to close the listener's socket (#1473).
//
//   * idle — blackhole the peer after the handshake and require a thread parked
//     in `finish` to come back with an error in bounded time (#1449/#1474).
//
//   * idleslow — the same blackhole, but above the RFC 9002 PTO backoff
//     ceiling, where a broken timer re-arm is actually distinguishable from a
//     correct one on the wall clock (#3557; `idle` cannot see this at 500 ms).
//
//   * reset — the client resets a freshly-opened stream; the server's first
//     `read` on it must return a reset chunk promptly rather than hang on data
//     that will never arrive (#3229).
//
//   * resetnodata — the client resets a stream it never wrote to, so RESET_STREAM
//     is the very first frame the server ever sees for that stream id; the
//     server's `acceptStream` must still return it instead of hanging forever
//     (#3232).
//
//   * streamlimit — open the peer's advertised 16-stream limit, then require the
//     17th `openStream` to fail distinctly instead of the limit going
//     unenforced (#3229).
//
//   * streamlimitinbound — the missing inbound half of `streamlimit`: a peer
//     (the server here) referencing more than 16 distinct stream ids must be
//     refused with a connection close, not grow an unbounded entry per id
//     (#3247). The first 16 must still deliver normally, proving the check
//     counts distinct ids in bounds rather than misfiring on legitimate traffic.
//
//   * stopsendingnodata — the client opens a stream and immediately asks the
//     peer to stop sending on it, with zero prior writes, so STOP_SENDING is
//     the very first frame the server ever sees for that stream id; the
//     server's `acceptStream` must still return it instead of hanging until
//     the idle timeout (#3243, the StopSending half of #3232's fix).
//
//   * lowerstreamopen — a reference to the 6th client-bidi stream, with the
//     first 5 opened locally but never written to, must implicitly open all
//     6 (RFC 9000 §2.1's "every lower-numbered stream of the same type"), not
//     only the one actually referenced (#3243).
//
// Every printed line is a boolean, a byte count, a content hash, or a fixed
// error string — nothing timing-dependent — so the golden is stable across
// targets and schedules.
//
// This program is NOT run under `BIT_GC=stress`, and that hole is declared and
// argued in _tests_/bit/stress/stress.bit rather than left to be inferred (#1475): a QUIC-TLS
// handshake is millions of loop back-edges, stress collects at every one of them,
// and even a 1-byte payload does not finish in 300s. It is not a QUIC defect —
// `_tests_/imports/cryptorsa` behaves the same way — and it is not the #1462
// no-safepoint shape, which the measurements there rule out explicitly.
import { dialQuic, acceptQuic, listenQuic, Conn, Listener, Stream, StreamChunk } from "std/quic"
import { udpBind, UdpSocket } from "std/net"
import { monotonic, since } from "std/time"
import { newSha256, encodeHex, decodeHex, pemEncode } from "std/crypto"

const caHex: string = ""
const leafHex: string = ""
const keyHex: string = ""

const payloadBytes: int = 98304
const dropEvery: int = 10

fn hx(s: string): []byte {
  return decodeHex(s) catch e {
    return []byte(0)
  }
}
fn pemOf(label: string, h: string): string { return pemEncode(label, hx(h)) }

// The server certificate chain (leaf then CA) and its RSA key, as PEM.
fn chainPem(): string { return pemOf("CERTIFICATE", leafHex) + pemOf("CERTIFICATE", caHex) }
fn keyPem(): string { return pemOf("PRIVATE KEY", keyHex) }

// A deterministic pseudo-random payload (a linear congruential stream), so the
// content hash is fixed across runs.
fn makePayload(n: int): []byte {
  let out = []byte(n)
  let x = u32(0x12345678)
  let i = 0
  while (i < n) {
    x = x * u32(1664525) + u32(1013904223)
    out[i] = byte(x >> u32(24))
    i = i + 1
  }
  return out
}

fn sha256Hex(data: []byte): string {
  let h = newSha256()
  h.write(data)
  return encodeHex(h.sum())
}

fn boolStr(b: bool): string {
  if (b) {
    return "true"
  }
  return "false"
}

// A shared drop counter the loss shim increments and the driver reads once the
// transfer has settled.
class Counter { n: int }

// Forward one datagram, ignoring a send error (a closed socket at shutdown).
fn relay(sock: UdpSocket, host: string, port: int, data: string) {
  sock.send(host, port, data) catch e {
    return
  }
}

// The server endpoint: accept the connection, accept the client's bidi stream,
// read it to completion, and report "<sha256>:<len>" (or an error tag).
fn serverRole(sock: UdpSocket, chain: string, keyp: string, resultCh: chan<string>) {
  let conn = acceptQuic(sock, chain, keyp) catch e {
    resultCh <- "server-handshake-failed"
    return
  }
  let s = conn.acceptStream() catch e {
    resultCh <- "accept-failed"
    return
  }
  let got = []byte(0)
  let done = false
  let guard = 0
  while (!done && guard < 1000000) {
    guard = guard + 1
    let chunk = s.read() catch e {
      done = true
      continue
    }
    for b of chunk.data {
      got = append(got, b)
    }
    if (chunk.fin) {
      done = true
    }
  }
  resultCh <- "${sha256Hex(got)}:${len(got)}"
  conn.close()
}

// The loss shim: one UDP socket between the client and the server. Datagrams
// from the server go to the client and vice versa; a deterministic 1-in-N of the
// 1-RTT (short-header) datagrams is dropped. Handshake (long-header) datagrams
// are never dropped, so the handshake always completes.
fn lossShim(sock: UdpSocket, srvHost: string, srvPort: int, ctr: Counter) {
  let cliHost = ""
  let cliPort = 0
  let haveCli = false
  let seen = 0
  while (true) {
    let d = sock.recv(2048) catch e {
      return
    }
    let fromSrv = d.host == srvHost && d.port == srvPort
    if (!fromSrv) {
      cliHost = d.host
      cliPort = d.port
      haveCli = true
    }
    let bytes = []byte(d.data)
    let isLong = len(bytes) > 0 && (int(bytes[0]) & 0x80) != 0
    if (!isLong) {
      seen = seen + 1
      if (seen % dropEvery == 0) {
        ctr.n = ctr.n + 1
        continue
      }
    }
    if (fromSrv) {
      if (haveCli) {
        relay(sock, cliHost, cliPort, d.data)
      }
    } else {
      relay(sock, srvHost, srvPort, d.data)
    }
  }
}

// Client side of a transfer: dial `port`, open a stream, send `payload`, wait for
// full acknowledgement, close.
fn clientSend(port: int, payload: []byte): bool {
  let conn = dialQuic("127.0.0.1", port, "localhost") catch e {
    return false
  }
  let s = conn.openStream() catch e {
    return false
  }
  s.write(payload) catch e {
    return false
  }
  s.finish() catch e {
    return false
  }
  conn.close()
  return true
}

// Used by `idleScenario`/`idleSlowScenario` in idle.bit (same module) and, as
// a fast-vs-idle-timeout discriminator, by several scenarios below.
const idleTimeoutNs: int = 500000000
const idleBoundNs: int = 5000000000

const resetErrCode: int = 42

// #3229 / #3232: the server side of both the reset and resetnodata scenarios. A
// short idle timeout means an unfixed regression (the `ResetStream` arm back to
// a no-op, or `quicconnEnsureStream`'s implicit-open reverted) does not hang the
// whole suite: `acceptStream`/`read` would instead come back — slowly, via the
// pre-existing #1449 idle-timeout path, or not at all if `acceptStream` itself
// never sees the stream — with a generic connection-closed error (or a hang)
// once nothing more arrives from the peer, rather than the reset chunk directly
// and promptly. `fast` is the discriminator between "fixed" and "reverted"; the
// read loop is bounded so a still-broken build fails this scenario instead of
// wedging every scenario after it.
//
// Reads until a reset chunk arrives or the connection ends, accumulating any
// data delivered first. Shared verbatim by `resetScenario` (client writes a few
// bytes before resetting) and `resetnodataScenario` (client resets with zero
// prior writes, so RESET_STREAM is the first frame referencing the stream
// server-side — the case `quicconnEnsureStream` fixed, #3232).
fn resetServerRole(sock: UdpSocket, chain: string, keyp: string, resultCh: chan<string>) {
  let conn = acceptQuic(sock, chain, keyp) catch e {
    resultCh <- "handshake-failed"
    return
  }
  conn.setIdleTimeout(idleTimeoutNs)
  let s = conn.acceptStream() catch e {
    resultCh <- "accept-failed"
    return
  }
  let start = monotonic()
  let gotData = 0
  let sawReset = false
  let resetCode = -1
  let guard = 0
  while (!sawReset && guard < 1000) {
    guard = guard + 1
    let chunk = s.read() catch e {
      resultCh <- "read-failed"
      return
    }
    gotData = gotData + len(chunk.data)
    if (chunk.reset) {
      sawReset = true
      resetCode = chunk.resetCode
    }
  }
  let elapsed = since(start)
  resultCh <- "reset=${boolStr(sawReset)}:code=${resetCode}:predata=${gotData}:" +
    "fast=${boolStr(elapsed < idleTimeoutNs)}"
}

// A `read()` on a stream the peer RESET_STREAM'd must return a distinguishable
// reset chunk instead of waiting for data or a FIN that will now never arrive
// (#3229's core finding). The client writes a few bytes first, so the server
// learns the stream exists via a real STREAM frame before the reset — the
// zero-prior-writes case is `resetnodataScenario` below (#3232).
fn resetScenario(chain: string, keyp: string): ()! {
  let srv = udpBind("127.0.0.1", 0)?
  let srvPort = srv.port()?
  let res = chan<string>(1)
  spawn resetServerRole(srv, chain, keyp, res)
  let conn = dialQuic("127.0.0.1", srvPort, "localhost")?
  let s = conn.openStream()?
  s.write([]byte("hi"))?
  s.reset(resetErrCode)?
  let got = <- res
  println("reset_result=${got}")
  conn.close()
}

// #3232: RESET_STREAM sent as the very first frame for a stream id — no prior
// STREAM frame, so the server has never heard of this stream before —  must
// still create the stream server-side and surface it via `acceptStream`
// instead of the peer's abort being silently dropped (`st.present[id] == 0`
// used to return early with no stream ever created, so `acceptStream` blocked
// forever). `resetServerRole` is the identical server role `resetScenario`
// uses; only the client's behavior differs here — no `write` before `reset`.
fn resetnodataScenario(chain: string, keyp: string): ()! {
  let srv = udpBind("127.0.0.1", 0)?
  let srvPort = srv.port()?
  let res = chan<string>(1)
  spawn resetServerRole(srv, chain, keyp, res)
  let conn = dialQuic("127.0.0.1", srvPort, "localhost")?
  let s = conn.openStream()?
  s.reset(resetErrCode)?
  let got = <- res
  println("resetnodata_result=${got}")
  conn.close()
}

// "" if `conn.openStream` succeeds, else the error it failed with. A separate
// function because a `catch` block used as a statement must either produce a
// `Stream` or divert control (`return`), the same constraint `keyRejected` in
// _tests_/imports/cryptoaes/main.bit works around the same way.
fn tryOpenStream(conn: Conn): string {
  let s = conn.openStream() catch e {
    return e.message()
  }
  return ""
}

// The peer only ever advertises `initialMaxStreamsBidi = 16`
// (`quicconnLocalParams`); nothing gated `Conn.openStream` against it at all
// before #3229. Open exactly that many, then require the next one to fail
// distinctly (not hang, not fail with the generic "connection closed").
fn streamLimitScenario(chain: string, keyp: string): ()! {
  let srv = udpBind("127.0.0.1", 0)?
  let srvPort = srv.port()?
  spawn acceptOnly(srv, chain, keyp)
  let conn = dialQuic("127.0.0.1", srvPort, "localhost")?
  let opened = 0
  let i = 0
  while (i < 16) {
    let s = conn.openStream()?
    opened = opened + 1
    i = i + 1
  }
  let msg = tryOpenStream(conn)
  println("streamlimit_opened=${opened}")
  println("streamlimit_17th_blocked=${boolStr(msg != "")}")
  println("streamlimit_17th_message=${msg}")
  conn.close()
}

// Complete the handshake and hold the connection open; `streamLimitScenario`
// needs a live peer only to learn the peer's advertised transport parameters —
// none of the streams it opens ever carry data, so the server never even learns
// they exist (a STREAM frame is what creates a stream server-side, and no
// `write` is ever called).
fn acceptOnly(sock: UdpSocket, chain: string, keyp: string) {
  let conn = acceptQuic(sock, chain, keyp) catch e {
    return
  }
  conn.setIdleTimeout(listenerIdleNs)
}

// More than `quicconnLocalMaxStreamsBidi` (16): every one of these
// server-initiated opens succeeds from the server's own perspective, because
// `quicconnReadPeerParams` is client-only (handshake.bit) — a server-side
// connection's `peerMaxStreamsBidi` never learns the real value, so its own
// outbound gate (#3229) never fires here. That gap is exactly what makes this
// scenario able to exercise the CLIENT's *inbound* enforcement (#3247) at all:
// going through `Conn.openStream` on the client instead would hit the client's
// own outbound gate first and never reach the wire.
const streamLimitInboundTotal: int = 20

// Open `streamLimitInboundTotal` server-initiated streams and put one acked
// byte on each. `finish` (not a bare `write`) is required, not just tidier:
// this runtime defaults to one scheduler worker OS thread (ABI.md §9), and a
// tight loop of `openStream`+`write` calls that never blocks on the PEER
// never yields it — the peer's own dial/accept/read green threads starved
// completely in a from-scratch repro of this exact scenario, every single
// time, until either a real cross-connection round trip (`finish`, which
// cannot return until the client's own loop has processed and acked it) or a
// second worker (`BIT_WORKERS=2`) was added. `_tests_/bit/importsrun/importsrun.bit` runs
// every `_tests_/imports/**` project under the default one-worker config, so
// this scenario must yield for real rather than assume fairness.
fn streamLimitInboundServerRole(sock: UdpSocket, chain: string, keyp: string) {
  let conn = acceptQuic(sock, chain, keyp) catch e {
    return
  }
  let i = 0
  while (i < streamLimitInboundTotal) {
    let s = conn.openStream() catch e {
      return
    }
    s.write([]byte("x")) catch e {
      return
    }
    s.finish() catch e {
      return
    }
    i = i + 1
  }
}

// #3247: the missing inbound half of `streamLimitScenario`. The server (see
// `streamLimitInboundServerRole`) references 20 distinct stream ids; this
// endpoint advertised room for only 16 (`quicconnLocalParams`), so the last 4
// must be refused as a connection error (RFC 9000 §4.6 STREAM_LIMIT_ERROR)
// instead of growing `st.streams`/`st.present` without bound.
//
// `first16Ok` accepts and reads exactly the first 16 — all within the
// advertised limit — and requires every one to deliver its byte normally: the
// acceptance requirement that a peer referencing streams that stay within the
// limit is never wrongly refused, which a count of raw map entries (conflating
// this endpoint's own id space, or type) could get wrong even when the
// over-limit check itself is correct.
//
// `fast` is the same discriminator `resetServerRole` uses: a reverted fix
// still ends the connection eventually — nothing else answers the peer past
// this point, so the pre-existing idle timeout (`idleTimeoutNs`, set below)
// fires regardless — but only a real fix ends it near-instantly, on the
// violating reference itself, rather than after a 500ms timeout.
fn streamLimitInboundScenario(chain: string, keyp: string): ()! {
  let srv = udpBind("127.0.0.1", 0)?
  let srvPort = srv.port()?
  spawn streamLimitInboundServerRole(srv, chain, keyp)
  let conn = dialQuic("127.0.0.1", srvPort, "localhost")?
  conn.setIdleTimeout(idleTimeoutNs)

  let first16Ok = true
  let held = conn.acceptStream()?
  let firstChunk = held.read()?
  if (len(firstChunk.data) != 1) {
    first16Ok = false
  }
  let j = 1
  while (j < 16) {
    let s = conn.acceptStream() catch e {
      first16Ok = false
      j = 16
      continue
    }
    let chunk = s.read() catch e {
      first16Ok = false
      j = 16
      continue
    }
    if (len(chunk.data) != 1) {
      first16Ok = false
    }
    j = j + 1
  }
  println("streamlimitinbound_first16_ok=${boolStr(first16Ok)}")

  let start = monotonic()
  let closed = false
  let guard = 0
  while (!closed && guard < 100000) {
    guard = guard + 1
    let chunk2 = held.read() catch e {
      closed = true
      continue
    }
  }
  let elapsed = since(start)
  println("streamlimitinbound_closed=${boolStr(closed)}")
  println("streamlimitinbound_fast=${boolStr(elapsed < idleTimeoutNs)}")
}

// #3243: STOP_SENDING has the same `st.present[id] == 0` early-return
// `quicconnAbortSend` shares with RESET_STREAM/MAX_STREAM_DATA, but wasn't
// routed through `quicconnEnsureStream` when #3232 fixed those two — so a
// STOP_SENDING referencing a stream id the server has never seen before used
// to be silently dropped instead of implicitly opening the stream. Mirrors
// `resetnodataScenario`'s "zero prior writes" shape (#3232), but there is
// nothing for this accepted stream to `read` — `stopSending` only affects the
// receiver's own send side, not what it receives — so this checks that
// `acceptStream` itself returns fast rather than waiting out the idle
// timeout.
fn stopSendingNoDataServerRole(
  sock: UdpSocket,
  chain: string,
  keyp: string,
  resultCh: chan<string>,
) {
  let conn = acceptQuic(sock, chain, keyp) catch e {
    resultCh <- "handshake-failed"
    return
  }
  conn.setIdleTimeout(idleTimeoutNs)
  let start = monotonic()
  let s = conn.acceptStream() catch e {
    resultCh <- "accept-failed"
    return
  }
  let elapsed = since(start)
  resultCh <- "accepted=true:id=${s.id()}:fast=${boolStr(elapsed < idleTimeoutNs)}"
}

fn stopSendingNoDataScenario(chain: string, keyp: string): ()! {
  let srv = udpBind("127.0.0.1", 0)?
  let srvPort = srv.port()?
  let res = chan<string>(1)
  spawn stopSendingNoDataServerRole(srv, chain, keyp, res)
  let conn = dialQuic("127.0.0.1", srvPort, "localhost")?
  let s = conn.openStream()?
  s.stopSending(resetErrCode)?
  let got = <- res
  println("stopsendingnodata_result=${got}")
  conn.close()
}

// #3243: a reference to stream ordinal 5 (id 20, the 6th client-bidi stream)
// must implicitly open every lower-numbered stream of the same type (RFC 9000
// §2.1), not only the one referenced. The client opens 6 streams locally but
// only ever writes to the last one — ordinals 0-4 carry no traffic at all,
// exactly like `streamLimitScenario`'s streams that "never carry data, so the
// server never even learns they exist" — so before the fix the server only
// ever learns about the referenced id; after it, all 6 must be visible via
// `acceptStream`. Closing the connection right after the one real write
// drains makes a still-broken build fail fast (the 2nd `acceptStream` call
// errors out immediately once the close arrives) rather than waiting out the
// idle timeout.
const lowerStreamOpenCount: int = 6

fn lowerStreamOpenServerRole(sock: UdpSocket, chain: string, keyp: string, resultCh: chan<string>) {
  let conn = acceptQuic(sock, chain, keyp) catch e {
    resultCh <- "handshake-failed"
    return
  }
  conn.setIdleTimeout(idleTimeoutNs)
  let count = 0
  let idSum = 0
  let i = 0
  while (i < lowerStreamOpenCount) {
    let s = conn.acceptStream() catch e {
      i = lowerStreamOpenCount
      continue
    }
    count = count + 1
    idSum = idSum + s.id()
    i = i + 1
  }
  resultCh <- "count=${count}:idsum=${idSum}"
}

fn lowerStreamOpenScenario(chain: string, keyp: string): ()! {
  let srv = udpBind("127.0.0.1", 0)?
  let srvPort = srv.port()?
  let res = chan<string>(1)
  spawn lowerStreamOpenServerRole(srv, chain, keyp, res)
  let conn = dialQuic("127.0.0.1", srvPort, "localhost")?
  let i = 0
  while (i < lowerStreamOpenCount - 1) {
    let discarded = conn.openStream()?
    i = i + 1
  }
  let last = conn.openStream()?
  last.write([]byte("x"))?
  last.finish()?
  conn.close()
  let got = <- res
  println("lowerstreamopen_result=${got}")
}

// One listener client: dial, open a stream, then wait for `go` before sending, so
// the driver controls exactly when traffic has to cross the shared socket.
fn listenerClient(port: int, msg: string, go: chan<int>, out: chan<string>) {
  let conn = dialQuic("127.0.0.1", port, "localhost") catch e {
    out <- "dial-failed"
    return
  }
  let s = conn.openStream() catch e {
    out <- "open-failed"
    return
  }
  <- go
  s.write([]byte(msg)) catch e {
    out <- "write-failed"
    return
  }
  s.finish() catch e {
    out <- "finish-failed"
    return
  }
  out <- "sent"
}

// Drain one accepted connection's first stream to FIN.
fn readStream(c: Conn): string {
  let s = c.acceptStream() catch e {
    return "accept-failed"
  }
  let got = []byte(0)
  let done = false
  let guard = 0
  while (!done && guard < 1000000) {
    guard = guard + 1
    let chunk = s.read() catch e {
      done = true
      continue
    }
    for b of chunk.data {
      got = append(got, b)
    }
    if (chunk.fin) {
      done = true
    }
  }
  return string(got)
}

const listenerIdleNs: int = 5000000000

// #1473: closing ONE listener-created connection must not touch the socket it
// shares with the listener and every sibling connection. Accept two, close the
// first, then require a full round trip on the second and a brand-new third
// connection — every one of which needs that socket alive, and none of which can
// be satisfied from data already buffered, because the clients hold their
// payload until told to send. The surviving connection gets a short idle timeout
// so a regressed build answers wrongly within seconds instead of hanging.
fn listenerScenario(chain: string, keyp: string): ()! {
  let lsock = udpBind("127.0.0.1", 0)?
  let port = lsock.port()?
  let lst = listenQuic(lsock, chain, keyp)?

  let goA = chan<int>(1)
  let outA = chan<string>(1)
  spawn listenerClient(port, "alpha", goA, outA)
  let c1 = lst.accept()?

  let goB = chan<int>(1)
  let outB = chan<string>(1)
  spawn listenerClient(port, "beta", goB, outB)
  let c2 = lst.accept()?
  c2.setIdleTimeout(listenerIdleNs)

  // The destructive act: before #1473 this closed `lsock` itself, taking the
  // accept loop and every sibling connection with it.
  c1.close()

  goB <- 1
  let got2 = readStream(c2)
  println("listener_sibling_roundtrip=${boolStr(got2 == "beta")}")

  let goC = chan<int>(1)
  let outC = chan<string>(1)
  goC <- 1
  spawn listenerClient(port, "gamma", goC, outC)
  // Read the client's own verdict first: it is bounded by the 5s dial handshake
  // timeout, so a dead listener socket surfaces as a failure here rather than
  // parking the accept below forever.
  let rc = <- outC
  let got3 = ""
  if (rc == "sent") {
    let c3 = lst.accept()?
    got3 = readStream(c3)
  }
  println("listener_third_accept=${boolStr(got3 == "gamma")}")
}

fn run(): ()! {
  let payload = makePayload(payloadBytes)
  let want = sha256Hex(payload)
  println("payload_len=${payloadBytes}")
  println("payload_hash=${want}")

  // --- direct: no loss ---
  let srv = udpBind("127.0.0.1", 0)?
  let srvPort = srv.port()?
  let res = chan<string>(1)
  spawn serverRole(srv, chainPem(), keyPem(), res)
  let ok = clientSend(srvPort, payload)
  let got = <- res
  println("direct_handshake=${boolStr(ok)}")
  println("direct_match=${boolStr(got == "${want}:${payloadBytes}")}")

  // --- loss: shim drops ~10% of 1-RTT datagrams ---
  let srv2 = udpBind("127.0.0.1", 0)?
  let srvPort2 = srv2.port()?
  let shim = udpBind("127.0.0.1", 0)?
  let shimPort = shim.port()?
  let ctr = Counter{ n: 0 }
  spawn lossShim(shim, "127.0.0.1", srvPort2, ctr)
  let res2 = chan<string>(1)
  spawn serverRole(srv2, chainPem(), keyPem(), res2)
  let ok2 = clientSend(shimPort, payload)
  let got2 = <- res2
  println("loss_handshake=${boolStr(ok2)}")
  println("loss_match=${boolStr(got2 == "${want}:${payloadBytes}")}")
  println("loss_dropped_some=${boolStr(ctr.n > 0)}")

  // --- listener: one connection's close must not kill its siblings (#1473) ---
  listenerScenario(chainPem(), keyPem())?

  // --- idle: a vanished peer unparks `finish` in bounded time (#1449/#1474) ---
  idleScenario(chainPem(), keyPem())?

  // --- idleslow: idle above the PTO backoff ceiling, so a broken re-arm is
  // distinguishable (#3557) ---
  idleSlowScenario(chainPem(), keyPem())?

  // --- reset: RESET_STREAM wakes a blocked `read` instead of hanging (#3229) ---
  resetScenario(chainPem(), keyPem())?

  // --- resetnodata: RESET_STREAM as the first frame for a stream id implicitly
  // opens it instead of being silently dropped (#3232) ---
  resetnodataScenario(chainPem(), keyPem())?

  // --- streamlimit: MAX_STREAMS is enforced, not silently ignored (#3229) ---
  streamLimitScenario(chainPem(), keyPem())?

  // --- streamlimitinbound: a peer referencing more than 16 distinct stream
  // ids is refused with STREAM_LIMIT_ERROR instead of growing st.streams
  // without bound (#3247) ---
  streamLimitInboundScenario(chainPem(), keyPem())?

  // --- stopsendingnodata: STOP_SENDING as the first frame for a stream id
  // implicitly opens it instead of being silently dropped (#3243) ---
  stopSendingNoDataScenario(chainPem(), keyPem())?

  // --- lowerstreamopen: referencing stream ordinal 5 implicitly opens
  // ordinals 0-4 too, not only the one referenced (#3243) ---
  lowerStreamOpenScenario(chainPem(), keyPem())?
}

fn main() {
  run() catch e {
    println("failed: ${e.message()}")
  }
}
