export const KB = 1024

// The declaring module. Every default here is folded against THIS module's
// arena and THIS module's `const` table -- `1000 * KB` names a const the
// importer cannot see at all.
export class Opts {
  export port: int = 8080,
  export host: string = "127.0.0.1",
  export maxBody: int = 1000 * KB,
  export tls: bool,
}
