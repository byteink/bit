// #3838 (SPEC §10.5): a class field default declared in ONE module, applied at a
// composite literal in ANOTHER. This is the case the feature exists for --
// #3946's `pkg/web` Config, #3962's `std/sql` pool -- and it is the case an
// implementation can get wrong while every same-file fixture passes.
//
// A check-time AST splice (synthesizing the omitted `Tag.FieldInit` into the
// literal, checktraitfield.bit's technique) was rejected for exactly this: a
// `Checker`/`Tree` is per MODULE, so the spliced node's `Span` would index the
// DECLARING module's source while every downstream `c.source[...]` read slices
// the IMPORTING module's. The default is materialized at lowering instead,
// against the owner's checker (lowerslicefill.bit's `lowerFieldDefault`), the
// same swap lowerdriver.bit already uses to inline an imported const.
//
// `maxBody` is the load-bearing line: its initializer names `KB`, which is
// declared in `cfg` and is NOT imported here. Resolving it against this module
// would find nothing.
import { Opts } from "./cfg"

fn show(o: Opts) {
  println("${o.port} ${o.host} ${o.maxBody} ${o.tls}")
}

fn main() {
  show(Opts{})
  show(Opts{ port: 3000 })
  let xs = []Opts(1)
  show(xs[0])
  let p: Opts
  show(p)
}
