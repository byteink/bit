// std/quic frame codec (#1216): the RFC 9000 §16 variable-length integer and the
// §19 frames. The varint block reproduces the Appendix A.1 sample values — both the
// canonical shortest encodings and the decodes, including the non-minimal two-byte
// 37 (0x4025). The frame block pins each frame's hand-verifiable wire bytes, then
// round-trips a mixed payload through `parseFrames`/`encodeFrames` to prove the
// decoder is the exact inverse of the encoder. All output is deterministic, so the
// golden `expected` is stable across architectures.
import {
  encodeVarint,
  decodeVarint,
  varintSize,
  Frame,
  AckFrame,
  AckRange,
  StreamFrame,
  encodeFrame,
  encodeFrames,
  parseFrames,
} from "std/quic"
import { encodeHex, decodeHex } from "std/crypto"

fn run(): ()! {
  // RFC 9000 Appendix A.1 — canonical (shortest) varint encodings.
  println("v8=${encodeHex(encodeVarint(151288809941952652))}")
  println("v4=${encodeHex(encodeVarint(494878333))}")
  println("v2=${encodeHex(encodeVarint(15293))}")
  println("v1=${encodeHex(encodeVarint(37))}")

  // Decoding the same samples, plus the non-minimal two-byte encoding of 37.
  println("d8=${int(decodeVarint(decodeHex("c2197c5eff14e88c")?)?)}")
  println("d4=${int(decodeVarint(decodeHex("9d7f3e7d")?)?)}")
  println("d2=${int(decodeVarint(decodeHex("7bbd")?)?)}")
  println("d1=${int(decodeVarint(decodeHex("25")?)?)}")
  println("d1b=${int(decodeVarint(decodeHex("4025")?)?)}")
  println("sizes=${varintSize(37)}${varintSize(15293)}${varintSize(494878333)}${varintSize(151288809941952652)}")

  // Each frame's wire encoding, hand-verifiable against RFC 9000 §19.
  println("ping=${encodeHex(encodeFrame(Frame.Ping))}")
  println("hsdone=${encodeHex(encodeFrame(Frame.HandshakeDone))}")
  println("padding=${encodeHex(encodeFrame(Frame.Padding(3)))}")
  println("maxdata=${encodeHex(encodeFrame(Frame.MaxData(1048576)))}")
  println("crypto=${encodeHex(encodeFrame(Frame.Crypto(0, decodeHex("0102030405")?)))}")
  println("reset=${encodeHex(encodeFrame(Frame.ResetStream(4, 257, 100)))}")
  println("stopsending=${encodeHex(encodeFrame(Frame.StopSending(4, 257)))}")
  println("newtoken=${encodeHex(encodeFrame(Frame.NewToken(decodeHex("010203")?)))}")
  println("maxstreamdata=${encodeHex(encodeFrame(Frame.MaxStreamData(4, 1048576)))}")
  println("maxstreams_bidi=${encodeHex(encodeFrame(Frame.MaxStreams(true, 100)))}")
  println("maxstreams_uni=${encodeHex(encodeFrame(Frame.MaxStreams(false, 100)))}")
  println("datablocked=${encodeHex(encodeFrame(Frame.DataBlocked(1048576)))}")
  println("streamdatablocked=${encodeHex(encodeFrame(Frame.StreamDataBlocked(4, 100)))}")
  println("streamsblocked=${encodeHex(encodeFrame(Frame.StreamsBlocked(true, 5)))}")
  println("retirecid=${encodeHex(encodeFrame(Frame.RetireConnectionId(2)))}")
  println("pathchallenge=${encodeHex(encodeFrame(Frame.PathChallenge(decodeHex("0102030405060708")?)))}")
  println("pathresponse=${encodeHex(encodeFrame(Frame.PathResponse(decodeHex("0102030405060708")?)))}")
  println("connclose=${encodeHex(encodeFrame(Frame.ConnectionClose(10, 6, []byte(0))))}")
  println("appclose=${encodeHex(encodeFrame(Frame.ApplicationClose(257, decodeHex("4142")?)))}")
  println(
    "newcid=${encodeHex(
      encodeFrame(
        Frame.NewConnectionId(
          2,
          1,
          decodeHex("f067a5502a4262b5")?,
          decodeHex("00112233445566778899aabbccddeeff")?,
        ),
      ),
    )}",
  )

  // A STREAM frame with the OFF, LEN, and FIN bits all set (type 0x0f).
  let sf = StreamFrame{
    id: 4,
    offset: 8,
    data: decodeHex("deadbeef")?,
    hasOffset: true,
    hasLength: true,
    fin: true,
  }
  println("stream=${encodeHex(encodeFrame(Frame.Stream(sf)))}")

  // An ACK frame with one extra range, and an ECN ACK (type 0x03) with counts.
  let ack = AckFrame{
    largest: 10,
    delay: 3,
    firstRange: 2,
    ranges: [AckRange{ gap: 1, rangeLength: 4 }],
    ecn: false,
    ect0: 0,
    ect1: 0,
    ce: 0,
  }
  println("ack=${encodeHex(encodeFrame(Frame.Ack(ack)))}")
  let ackEcn = AckFrame{
    largest: 100,
    delay: 0,
    firstRange: 0,
    ranges: []AckRange(0),
    ecn: true,
    ect0: 1,
    ect1: 2,
    ce: 3,
  }
  println("ackecn=${encodeHex(encodeFrame(Frame.Ack(ackEcn)))}")

  // A STREAM frame with LEN clear: its data runs to the end of the buffer, so it
  // must be parsed alone. Round-trips through parse and re-encode.
  let noLen = StreamFrame{
    id: 4,
    offset: 0,
    data: decodeHex("aabb")?,
    hasOffset: false,
    hasLength: false,
    fin: false,
  }
  let noLenBytes = encodeFrame(Frame.Stream(noLen))
  println("stream_nolen=${encodeHex(noLenBytes)}")
  let reparsedNoLen = parseFrames(noLenBytes)?
  println("stream_nolen_rt=${encodeHex(encodeFrames(reparsedNoLen))}")

  // Round-trip a mixed payload: encode a list of frames, parse it back, re-encode,
  // and confirm the bytes are identical and the frame count is right.
  let frames = [
    Frame.Ping,
    Frame.Crypto(0, decodeHex("0102030405")?),
    Frame.Ack(ack),
    Frame.Stream(sf),
    Frame.MaxData(1048576),
    Frame.ResetStream(4, 257, 100),
    Frame.NewConnectionId(
      2,
      1,
      decodeHex("f067a5502a4262b5")?,
      decodeHex("00112233445566778899aabbccddeeff")?,
    ),
    Frame.ConnectionClose(10, 6, decodeHex("4142")?),
    Frame.HandshakeDone,
    Frame.Padding(4),
  ]
  let encoded = encodeFrames(frames)
  println("mix=${encodeHex(encoded)}")
  let parsed = parseFrames(encoded)?
  println("mix_count=${len(parsed)}")
  println("mix_rt=${encodeHex(encodeFrames(parsed))}")

  // Malformed input is rejected, not guessed at: a CRYPTO frame whose declared
  // length runs past the buffer, and an unknown frame type.
  let badLen = parseFrames(decodeHex("06001099")?) catch e {
    println("badlen=rejected")
    let unknown = parseFrames(decodeHex("3f")?) catch e2 {
      println("unknown=rejected")
      return
    }
    println("unknown=accepted")
    return
  }
  println("badlen=accepted")
}

fn main() {
  run() catch e {
    println("failed: ${e.message()}")
  }
}
