// std/http2 HPACK known-answer tests (RFC 7541 Appendix C).
//
// Every vector here is transcribed from the RFC's printed wire bytes and was
// independently cross-checked against the Python `hpack` reference library. The
// encoder outputs are asserted byte-exact, together with the dynamic-table size
// and entry count after each header block — so the table evolution (including the
// eviction the size-256 response examples force) can never silently drift. The
// decoder is then walked over the same C.6 byte sequence to confirm it recovers
// the headers and evolves an identical table. Each check prints one `PASS` line;
// the golden `expected` file is that list.
import {
  Encoder,
  Decoder,
  HeaderField,
  newEncoder,
  newEncoderConfig,
  newDecoderConfig,
  newDecoder,
  huffmanEncode,
  huffmanDecode,
} from "std/http2"

const hexDigits: string = "0123456789abcdef"

fn toHex(b: []byte): string {
  let out = []byte(len(b) * 2)
  let i = 0
  while (i < len(b)) {
    out[i * 2] = hexDigits[int(b[i] >> 4)]
    out[i * 2 + 1] = hexDigits[int(b[i] & 0x0f)]
    i = i + 1
  }
  return string(out)
}

fn nibble(c: byte): int {
  if (c >= 48 && c <= 57) {
    return int(c - 48)
  }
  return int(c - 97 + 10)
}

fn fromHex(s: string): []byte {
  let out = []byte(len(s) / 2)
  let i = 0
  while (i < len(out)) {
    out[i] = byte((nibble(s[i * 2]) << 4) | nibble(s[i * 2 + 1]))
    i = i + 1
  }
  return out
}

fn itoa(n: int): string {
  if (n == 0) {
    return "0"
  }
  let v = n
  let tmp = []byte(0)
  while (v > 0) {
    tmp = append(tmp, byte(48 + v % 10))
    v = v / 10
  }
  let out = []byte(0)
  let i = len(tmp) - 1
  while (i >= 0) {
    out = append(out, tmp[i])
    i = i - 1
  }
  return string(out)
}

fn hf(name: string, value: string): HeaderField {
  return HeaderField{ name: name, value: value, sensitive: false }
}

fn bytesEqual(a: []byte, b: []byte): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// Encode `fields`, asserting the wire hex and the resulting dynamic-table state.
fn encCheck(
  e: Encoder,
  fields: []HeaderField,
  tag: string,
  wantHex: string,
  wantSize: int,
  wantN: int,
) {
  let got = toHex(e.encode(fields))
  if (got == wantHex && e.tableSize() == wantSize && e.tableCount() == wantN) {
    println(tag + " PASS")
    return
  }
  println(tag + " FAIL got=" + got + " size=" + itoa(e.tableSize()) + " n=" + itoa(e.tableCount()))
}

// Decode one single-field block, asserting the field and the table state.
fn decCheck(
  d: Decoder,
  hexStr: string,
  tag: string,
  wantName: string,
  wantValue: string,
  wantSensitive: bool,
  wantSize: int,
  wantN: int,
) {
  let fs = d.decode(fromHex(hexStr)) catch e {
    println(tag + " FAIL decode-error " + e.message())
    return
  }
  let ok = len(fs) == 1 &&
    fs[0].name == wantName &&
    fs[0].value == wantValue &&
    fs[0].sensitive == wantSensitive &&
    d.tableSize() == wantSize &&
    d.tableCount() == wantN
  if (ok) {
    println(tag + " PASS")
    return
  }
  println(tag + " FAIL")
}

// Decode a block into a "name=value|..." string, asserting it plus table state.
fn decSeqCheck(d: Decoder, hexStr: string, tag: string, want: string, wantSize: int, wantN: int) {
  let fs = d.decode(fromHex(hexStr)) catch e {
    println(tag + " FAIL decode-error " + e.message())
    return
  }
  let got = ""
  let i = 0
  while (i < len(fs)) {
    if (i > 0) {
      got = got + "|"
    }
    got = got + fs[i].name + "=" + fs[i].value
    i = i + 1
  }
  if (got == want && d.tableSize() == wantSize && d.tableCount() == wantN) {
    println(tag + " PASS")
    return
  }
  println(tag + " FAIL got=" + got + " size=" + itoa(d.tableSize()) + " n=" + itoa(d.tableCount()))
}

fn req1(): []HeaderField {
  return []HeaderField{
    hf(":method", "GET"),
    hf(":scheme", "http"),
    hf(":path", "/"),
    hf(":authority", "www.example.com"),
  }
}

fn req2(): []HeaderField {
  return []HeaderField{
    hf(":method", "GET"),
    hf(":scheme", "http"),
    hf(":path", "/"),
    hf(":authority", "www.example.com"),
    hf("cache-control", "no-cache"),
  }
}

fn req3(): []HeaderField {
  return []HeaderField{
    hf(":method", "GET"),
    hf(":scheme", "https"),
    hf(":path", "/index.html"),
    hf(":authority", "www.example.com"),
    hf("custom-key", "custom-value"),
  }
}

fn resp1(): []HeaderField {
  return []HeaderField{
    hf(":status", "302"),
    hf("cache-control", "private"),
    hf("date", "Mon, 21 Oct 2013 20:13:21 GMT"),
    hf("location", "https://www.example.com"),
  }
}

fn resp2(): []HeaderField {
  return []HeaderField{
    hf(":status", "307"),
    hf("cache-control", "private"),
    hf("date", "Mon, 21 Oct 2013 20:13:21 GMT"),
    hf("location", "https://www.example.com"),
  }
}

fn resp3(): []HeaderField {
  return []HeaderField{
    hf(":status", "200"),
    hf("cache-control", "private"),
    hf("date", "Mon, 21 Oct 2013 20:13:22 GMT"),
    hf("location", "https://www.example.com"),
    hf("content-encoding", "gzip"),
    hf("set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1"),
  }
}

// C.2: the four literal representations, checked from the decode side against the
// RFC's exact input bytes (the sequence encoder never emits without-indexing).
fn appendixC2() {
  let d1 = newDecoder()
  decCheck(
    d1,
    "400a637573746f6d2d6b65790d637573746f6d2d686561646572",
    "C.2.1",
    "custom-key",
    "custom-header",
    false,
    55,
    1,
  )
  let d2 = newDecoder()
  decCheck(d2, "040c2f73616d706c652f70617468", "C.2.2", ":path", "/sample/path", false, 0, 0)
  let d3 = newDecoder()
  decCheck(d3, "100870617373776f726406736563726574", "C.2.3", "password", "secret", true, 0, 0)
  let d4 = newDecoder()
  decCheck(d4, "82", "C.2.4", ":method", "GET", false, 0, 0)
}

// C.3: request sequence without Huffman; C.4: the same with Huffman.
fn appendixC3C4() {
  let e3 = newEncoderConfig(4096, false)
  encCheck(e3, req1(), "C.3.1", "828684410f7777772e6578616d706c652e636f6d", 57, 1)
  encCheck(e3, req2(), "C.3.2", "828684be58086e6f2d6361636865", 110, 2)
  encCheck(
    e3,
    req3(),
    "C.3.3",
    "828785bf400a637573746f6d2d6b65790c637573746f6d2d76616c7565",
    164,
    3,
  )

  let e4 = newEncoderConfig(4096, true)
  encCheck(e4, req1(), "C.4.1", "828684418cf1e3c2e5f23a6ba0ab90f4ff", 57, 1)
  encCheck(e4, req2(), "C.4.2", "828684be5886a8eb10649cbf", 110, 2)
  encCheck(e4, req3(), "C.4.3", "828785bf408825a849e95ba97d7f8925a849e95bb8e8b4bf", 164, 3)
}

// C.5/C.6: response sequences with a 256-byte table, forcing eviction on the
// third response. C.6 is Huffman-coded.
fn appendixC5C6() {
  let e5 = newEncoderConfig(256, false)
  encCheck(
    e5,
    resp1(),
    "C.5.1",
    "4803333032580770726976617465611d4d6f6e2c203231204f637420323031332032303a31333a323120474d546e1768747470733a2f2f7777772e6578616d706c652e636f6d",
    222,
    4,
  )
  encCheck(e5, resp2(), "C.5.2", "4803333037c1c0bf", 222, 4)
  encCheck(
    e5,
    resp3(),
    "C.5.3",
    "88c1611d4d6f6e2c203231204f637420323031332032303a31333a323220474d54c05a04677a69707738666f6f3d4153444a4b48514b425a584f5157454f50495541585157454f49553b206d61782d6167653d333630303b2076657273696f6e3d31",
    215,
    3,
  )

  let e6 = newEncoderConfig(256, true)
  encCheck(
    e6,
    resp1(),
    "C.6.1",
    "488264025885aec3771a4b6196d07abe941054d444a8200595040b8166e082a62d1bff6e919d29ad171863c78f0b97c8e9ae82ae43d3",
    222,
    4,
  )
  encCheck(e6, resp2(), "C.6.2", "4883640effc1c0bf", 222, 4)
  encCheck(
    e6,
    resp3(),
    "C.6.3",
    "88c16196d07abe941054d444a8200595040b8166e084a62d1bffc05a839bd9ab77ad94e7821dd7f2e6c7b335dfdfcd5b3960d5af27087f3672c1ab270fb5291f9587316065c003ed4ee5b1063d5007",
    215,
    3,
  )
}

// Decode the whole C.6 sequence with a matching 256-byte decoder, asserting the
// recovered headers and the identical dynamic-table evolution.
fn decodeRoundTrip() {
  let d = newDecoderConfig(256)
  decSeqCheck(
    d,
    "488264025885aec3771a4b6196d07abe941054d444a8200595040b8166e082a62d1bff6e919d29ad171863c78f0b97c8e9ae82ae43d3",
    "dec.1",
    ":status=302|cache-control=private|date=Mon, 21 Oct 2013 20:13:21 GMT|location=https://www.example.com",
    222,
    4,
  )
  decSeqCheck(
    d,
    "4883640effc1c0bf",
    "dec.2",
    ":status=307|cache-control=private|date=Mon, 21 Oct 2013 20:13:21 GMT|location=https://www.example.com",
    222,
    4,
  )
  decSeqCheck(
    d,
    "88c16196d07abe941054d444a8200595040b8166e084a62d1bffc05a839bd9ab77ad94e7821dd7f2e6c7b335dfdfcd5b3960d5af27087f3672c1ab270fb5291f9587316065c003ed4ee5b1063d5007",
    "dec.3",
    ":status=200|cache-control=private|date=Mon, 21 Oct 2013 20:13:22 GMT|location=https://www.example.com|content-encoding=gzip|set-cookie=foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1",
    215,
    3,
  )
}

// Huffman: a known vector, a round-trip, and the two hard-error paths.
fn huffmanChecks() {
  if (toHex(huffmanEncode([]byte("www.example.com"))) == "f1e3c2e5f23a6ba0ab90f4ff") {
    println("huff.vec PASS")
  } else {
    println("huff.vec FAIL")
  }

  let sample = []byte("Bit HPACK round-trip: 0123456789!")
  let rt = huffmanDecode(huffmanEncode(sample)) catch e {
    println("huff.rt FAIL " + e.message())
    return
  }
  if (bytesEqual(rt, sample)) {
    println("huff.rt PASS")
  } else {
    println("huff.rt FAIL")
  }

  huffmanDecode([]byte{ 0x00 }) catch e {
    println("huff.badpad PASS")
    huffmanDecode([]byte{ 0xff, 0xff, 0xff, 0xff }) catch e2 {
      println("huff.eos PASS")
      return
    }
    println("huff.eos FAIL")
    return
  }
  println("huff.badpad FAIL")
}

// A dynamic-table size update (§6.3): the encoder emits it once, ahead of the
// header block, and the decoder applies it. The second block re-emits nothing.
fn sizeUpdateCheck() {
  let e = newEncoder()
  e.changeTableSize(100)
  let fields = []HeaderField{ hf(":method", "GET"), hf("custom", "xyz") }
  let block = e.encode(fields)
  let d = newDecoderConfig(4096)
  let fs = d.decode(block) catch err {
    println("size-update FAIL " + err.message())
    return
  }
  let leads = len(block) >= 2 && block[0] == 0x3f && block[1] == 0x45
  let rt = len(fs) == 2 &&
    fs[0].name == ":method" &&
    fs[0].value == "GET" &&
    fs[1].name == "custom" &&
    fs[1].value == "xyz"
  let sync = e.tableSize() == 41 && d.tableSize() == 41
  let block2 = e.encode([]HeaderField{ hf(":method", "GET") })
  let once = toHex(block2) == "82"
  if (leads && rt && sync && once) {
    println("size-update PASS")
    return
  }
  println("size-update FAIL")
}

fn main() {
  appendixC2()
  appendixC3C4()
  appendixC5C6()
  decodeRoundTrip()
  sizeUpdateCheck()
  huffmanChecks()
}
