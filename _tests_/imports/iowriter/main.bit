// Regression gate for the std/io writer fixes. The fixing commits (663fb8a
// #2323, 4e9076c #2338) were verified with scratch programs that were never
// committed, so nothing in the tree stopped either bug coming back.
//
// This lives under tests/imports/ and not tests/cases/ because a golden case is
// single-file with no prelude and cannot import std/io — a case-based version
// could only exercise a local copy of Writer and would stay green while the
// shipped module regressed (that trap is #2347).
//
// Every fallible call below is wrapped in its own bool-returning helper rather
// than handled inline. That is not style: #2103 makes a `catch` block on a `()!`
// call an E0067 unless it diverts, so `catch e { ok = false }` does not compile
// and a helper that `return`s is the only spelling available. When #2103 lands
// these can collapse back inline.
import { writer, stdout, Writer } from "std/io"

// #2323: stdout() used to hand back a FRESH buffered Writer on every call, so
// the buffer written by one call was dropped on the floor and the flush on the
// next call had nothing to flush. The program below printed NOTHING and exited
// 0. Since an imports test compares stdout byte for byte, the assertion is the
// output itself: if this regresses, these lines simply vanish and the fixture
// stops matching.
fn checkStdoutRoundTrip() {
  stdout().writeLine("stdout-writeLine-survives")
  stdout().flush()
}

// #2338: write/flush returned () and swallowed every error, so a closed or
// invalid fd lost output and still exited 0. They are fallible now, so a bad fd
// must surface a catchable error rather than reporting success.
// `catch _` and not `catch e`: the error value is deliberately unused here (the
// property under test is that one is raised at all), and binding it as `e` is an
// E0211 unused-variable warning, which this project treats as build-breaking.
fn tryWrite(w: Writer, s: string): bool {
  w.write(s) catch _ {
    return false
  }
  return true
}

fn tryFlush(w: Writer): bool {
  w.flush() catch _ {
    return false
  }
  return true
}

// fd 99 is not open in the test harness, so the write fails at the syscall. A
// buffered writer only touches the fd on flush, so drive both and assert the
// PAIR — asserting one specific call would break if buffering changed, and the
// property that matters is that the bad fd is reported at all.
fn checkBadFdIsReported() {
  let w = writer(99)
  let wrote = tryWrite(w, "into the void")
  let flushed = tryFlush(w)
  println("badFdReported=${!wrote || !flushed}")
}

// A write to a VALID fd must still succeed and must not report a false error —
// the cheap way to catch an over-eager fix that fails every write.
fn checkGoodFdSucceeds() {
  println("goodFdOk=${tryWrite(stdout(), "")}")
}

fn main() {
  checkStdoutRoundTrip()
  checkBadFdIsReported()
  checkGoodFdSucceeds()
}
