import { now, parseDateTime, utc } from "std/time"

// #2677: golden coverage for std/time's calendar surface (date.bit,
// naive.bit, zoned.bit, ldmlfmt.bit, ldmlparse.bit) — an LDML-pattern
// format, the full field breakdown including day-of-week, UTC midnight,
// month-crossing day arithmetic, a zone-offset parse checked against its
// Z-suffixed equivalent, a leap-day rejection, and a pre-epoch round trip.
// Migrated off the superseded `Civil`/strftime surface by #4084 (which
// also retired civil.bit/arith.bit/fmt.bit/parse.bit's public exports);
// see docs/stdlib/time.md, "Superseded API" for the mapping used below.
// This file writes no Gregorian conversion of its own (constraints,
// #2677): every expected value in the comments below is derived
// independently of `civil.bit` — by Zeller's congruence, or by counting
// days by hand — so this gate cannot compare buggy output to itself.
fn main(): ()! {
  // Case 1: format a parsed instant with an LDML layout.
  let a = parseDateTime("2026-08-02T14:03:11Z")?
  println(a.format("yyyy-MM-dd HH:mm:ss")?)

  // Case 2: the fields of that same instant.
  //
  // dayOfWeek: Zeller's congruence (h = 0..6 for Sat..Fri) on 2026-08-02
  //   gives q=2, m=8, K=26, J=20:
  //   h = (2 + floor(13*9/5) + 26 + floor(26/4) + floor(20/4) - 40) mod 7
  //     = (2 + 23 + 26 + 6 + 5 - 40) mod 7 = 22 mod 7 = 1  ->  Sunday.
  //   Cross-checked by counting forward from 2025-01-01 (a well-known
  //   Wednesday): 2025 is not a leap year, so 2026-01-01 is +365 days,
  //   365 mod 7 = 1 weekday later -> Thursday. 2026-08-02 is day-of-year
  //   214 (see dayOfYear below), 213 days after 2026-01-01; 213 mod 7 = 3,
  //   Thu + 3 = Sunday. Both methods agree: Sunday, which `dayOfWeek()`'s
  //   ISO 8601 numbering (1 = Monday .. 7 = Sunday) reports as 7 — the
  //   superseded `Civil.weekday` reported the same day as 0 (0 = Sunday).
  // dayOfYear: 31 (Jan) + 28 (Feb, 2026 not leap) + 31 (Mar) + 30 (Apr)
  //   + 31 (May) + 30 (Jun) + 31 (Jul) + 2 = 214.
  println("year=${a.year()} month=${a.month()} day=${a.day()} hour=${a.hour()} minute=${a.minute()} second=${a.second()} nanosecond=${a.nanosecond()} dayOfWeek=${a.dayOfWeek()} dayOfYear=${a.dayOfYear()}")

  // Case 3: the UTC midnight that starts the same day. `toTimestamp()` and
  // `Timestamp.toString()` render UTC as the `Z` shorthand
  // (docs/stdlib/time.md, "`toString()`"); `DateTime.toString()` on its
  // own would print the equivalent, but always-numeric, `+00:00`.
  println(a.startOfDay().toTimestamp()?.toString())

  // Case 4: 2026-01-20 + 30 days crosses into February. January has 31
  // days, so 31-20=11 days reach 2026-01-31; the remaining 30-11=19 days
  // land on 2026-02-19. Time-of-day is untouched by `addDays`' pure
  // nanosecond arithmetic in the UTC zone (no daylight saving to cross),
  // so the result is 2026-02-19T10:00:00Z.
  let b = parseDateTime("2026-01-20T10:00:00Z")?
  println(b.addDays(30).toTimestamp()?.toString())

  // Case 5: 18:03:11+04:00 is local time 4 hours ahead of UTC, so the UTC
  // instant is 18:03:11 - 04:00:00 = 14:03:11Z — the same instant as `a`.
  let zoned = parseDateTime("2026-08-02T18:03:11+04:00")?
  println("same_instant=${zoned.toTimestamp()?.ns == a.toTimestamp()?.ns}")

  // Case 6: 2026 is not a leap year (2026 % 4 != 0), so February has 28
  // days and day 29 does not exist. `parseDateTime` rejects it (via
  // `date()`, ./date.bit) with "date: day out of range"; catch diverts the
  // failure so it never propagates past this statement, and a fixed word
  // is printed instead of the (non-deterministic across implementations)
  // error message.
  parseDateTime("2026-02-29T00:00:00Z") catch _ {
    println("leap_day_rejected")
    now().inZone(utc())
  }

  // Case 7: a pre-epoch instant (the Apollo 11 landing) round-trips through
  // parse and format unchanged, exercising the negative-nanosecond path in
  // civilFloorDiv.
  let moon = parseDateTime("1969-07-20T20:17:40Z")?
  println(moon.toTimestamp()?.toString())
}
