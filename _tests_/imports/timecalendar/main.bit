import { civilFromUnix, formatUnix, formatRfc3339, parseRfc3339, startOfDay, addDays } from "std/time"

// #2677: golden coverage for std/time's calendar surface (civil.bit, fmt.bit,
// parse.bit, arith.bit) — a strftime-style format, the full civil field
// breakdown including weekday, UTC midnight, month-crossing day arithmetic,
// a zone-offset parse checked against its Z-suffixed equivalent, a leap-day
// rejection, and a pre-epoch round trip. This file writes no Gregorian
// conversion of its own (constraints, #2677): every expected value in the
// comments below is derived independently of `civil.bit` — by Zeller's
// congruence, or by counting days by hand — so this gate cannot compare
// buggy output to itself.
fn main(): ()! {
  // Case 1: format a parsed instant with a strftime layout.
  let a = parseRfc3339("2026-08-02T14:03:11Z")?
  println(formatUnix(a, "%Y-%m-%d %H:%M:%S"))

  // Case 2: the civil fields of that same instant.
  //
  // weekday: Zeller's congruence (h = 0..6 for Sat..Fri) on 2026-08-02 gives
  //   q=2, m=8, K=26, J=20:
  //   h = (2 + floor(13*9/5) + 26 + floor(26/4) + floor(20/4) - 40) mod 7
  //     = (2 + 23 + 26 + 6 + 5 - 40) mod 7 = 22 mod 7 = 1  ->  Sunday.
  //   Cross-checked by counting forward from 2025-01-01 (a well-known
  //   Wednesday): 2025 is not a leap year, so 2026-01-01 is +365 days,
  //   365 mod 7 = 1 weekday later -> Thursday. 2026-08-02 is day-of-year
  //   214 (see yearDay below), 213 days after 2026-01-01; 213 mod 7 = 3,
  //   Thu + 3 = Sunday. Both methods agree: weekday 0.
  // yearDay: 31 (Jan) + 28 (Feb, 2026 not leap) + 31 (Mar) + 30 (Apr)
  //   + 31 (May) + 30 (Jun) + 31 (Jul) + 2 = 214.
  let c = civilFromUnix(a)
  println("year=${c.year} month=${c.month} day=${c.day} hour=${c.hour} minute=${c.minute} second=${c.second} nanosecond=${c.nanosecond} weekday=${c.weekday} yearDay=${c.yearDay}")

  // Case 3: the UTC midnight that starts the same day.
  println(formatRfc3339(startOfDay(a)))

  // Case 4: 2026-01-20 + 30 days crosses into February. January has 31
  // days, so 31-20=11 days reach 2026-01-31; the remaining 30-11=19 days
  // land on 2026-02-19. Time-of-day is untouched by addDays' pure
  // nanosecond arithmetic, so the result is 2026-02-19T10:00:00Z.
  let b = parseRfc3339("2026-01-20T10:00:00Z")?
  println(formatRfc3339(addDays(b, 30)))

  // Case 5: 18:03:11+04:00 is local time 4 hours ahead of UTC, so the UTC
  // instant is 18:03:11 - 04:00:00 = 14:03:11Z — the same instant as `a`.
  let zoned = parseRfc3339("2026-08-02T18:03:11+04:00")?
  println("same_instant=${zoned == a}")

  // Case 6: 2026 is not a leap year (2026 % 4 != 0), so February has 28
  // days and day 29 does not exist. unixFromCivil rejects it with
  // "time: day out of range"; catch diverts the failure so it never
  // propagates past this statement, and a fixed word is printed instead of
  // the (non-deterministic across implementations) error message.
  parseRfc3339("2026-02-29T00:00:00Z") catch _ {
    println("leap_day_rejected")
    0
  }

  // Case 7: a pre-epoch instant (the Apollo 11 landing) round-trips through
  // parse and format unchanged, exercising the negative-nanosecond path in
  // civilFloorDiv.
  let moon = parseRfc3339("1969-07-20T20:17:40Z")?
  println(formatRfc3339(moon))
}
