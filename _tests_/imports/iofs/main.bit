import { writeFile, readFile, appendFile, mkdir, remove, exists, isDir, readDir, walk } from "std/fs"
import { join, base, dir, ext, stem, isAbs } from "std/path"
import { writer, reader, stdout } from "std/io"
import { join as sjoin } from "std/strings"
import { open, File } from "std/fs"

fn cleanup(root: string) {
  // depth-first: files before their directories
  if (!exists(root)) {
    return
  }
  let files = walk(root) catch []string(0)
  for f of files {
    remove(f) catch println("cleanup: ${f}")
  }
  remove(join(root, "sub")) catch println("cleanup dir sub")
  remove(root) catch println("cleanup dir root")
}

// A buffered read of a whole file: open, wrap in a Reader, drain, close.
fn readViaReader(p: string): string! {
  let f = open(p)?
  defer f.close()
  let r = reader(f.fd)
  return r.readAll()
}

// Each green thread reads the whole file and reports its length. A file read
// blocks its worker for the syscall's duration (POSIX has no non-blocking
// regular-file read), but nothing deadlocks or starves: every thread completes.
fn readerTask(p: string, out: chan<i64>) {
  let s = readFile(p) catch ""
  out <- len(s)
}

// Path ops -- no filesystem involved.
fn pathOps() {
  println("join=${join("/a", "b.txt")} join_abs=${join("/a", "/z")} join_sep=${join("/a/", "b")}")
  println("base=${base("/a/b.txt")} dir=${dir("/a/b.txt")} ext=${ext("/a/b.txt")} stem=${stem("/a/b.txt")}")
  println("dir_root=${dir("/x")} dir_none=${dir("x")} isAbs=${isAbs("/a")} ${isAbs("a")}")
}

fn writeReadRoundtrip(root: string) {
  mkdir(root) catch println("mkdir failed")
  writeFile(join(root, "a.txt"), "hello") catch println("write failed")
  appendFile(join(root, "a.txt"), " world") catch println("append failed")
  let content = readFile(join(root, "a.txt")) catch "<err>"
  println("roundtrip=[${content}]")
}

// dir walk over a known tree.
fn dirWalk(root: string) {
  mkdir(join(root, "sub")) catch println("mkdir sub failed")
  writeFile(join(root, "sub/b.txt"), "b") catch println("write b failed")
  writeFile(join(root, "c.txt"), "c") catch println("write c failed")

  let names = readDir(root) catch []string(0)
  println("readDir=${sjoin(names, ",")}")

  let found = walk(root) catch []string(0)
  println("walk=${sjoin(found, ",")}")
}

// 1000 green threads each reading the same file; returns the summed length.
fn concurrentReads(root: string): int {
  let ch = chan<i64>(1000)
  let target = join(root, "a.txt")
  let n = 0
  while (n < 1000) {
    spawn readerTask(target, ch)
    n = n + 1
  }
  let total = 0
  n = 0
  while (n < 1000) {
    total = total + <- ch
    n = n + 1
  }
  return total
}

// A buffered reader over a real file, then a buffered writer to stdout.
fn bufferedIO(root: string) {
  println(
    "isDir_root=${isDir(root)} isDir_file=${isDir(join(root, "a.txt"))} exists_missing=${exists(
      join(root, "nope"),
    )}",
  )
  println("readAll_via_reader=[${readViaReader(join(root, "sub/b.txt")) catch "<err>"}]")

  let w = stdout()
  w.write("buffered")
  w.write("-out")
  w.writeLine("!")
  w.flush()
}

// Split into pathOps/writeReadRoundtrip/dirWalk/concurrentReads/bufferedIO
// (E0204, was complexity 13, limit 10).
fn main() {
  pathOps()

  let root = "/tmp/bit-iofs"
  cleanup(root)

  writeReadRoundtrip(root)
  dirWalk(root)

  let total = concurrentReads(root)
  println("concurrent_reads_total=${total}")

  bufferedIO(root)

  cleanup(root)
  println("cleaned=${!exists(root)}")
}
