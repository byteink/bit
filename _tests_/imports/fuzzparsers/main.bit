// Robustness / fuzz harness for every attacker-facing crypto and protocol
// parser in the standard library (#1225). Each parser sees a large, statically
// bounded batch of adversarial inputs — random byte strings of varied length,
// truncations and bit-flips and lying length prefixes of a valid message,
// all-0xFF and all-0x00 fillers, deeply nested ASN.1 TLV, HPACK integers with
// runaway continuation bytes, Huffman padding violations, oversized HTTP/2 frame
// lengths, and QUIC varints with a wrong length prefix. A malformed input must
// only ever return cleanly (an `!` error OR a value); it must never panic, hang,
// or exhaust memory.
//
// Because a crash, hang, or OOM aborts the whole process, simply reaching the
// end and printing a deterministic summary line per parser IS the proof that the
// parser survived its whole batch. Every loop is statically bounded (Power of
// 10), and every input is generated by a seeded splitmix64 PRNG, so the run is
// fully deterministic and the golden `expected` is stable across architectures.

import { asn1Parse, x509Parse, pemDecode, decodeHex } from "std/crypto"
import {
  parseClientHello,
  parseServerHello,
  parseEncryptedExtensions,
  parseCertificate,
  parseCertificateVerify,
  parseFinished,
  parseNewSessionTicket,
  parseServerName,
  parseALPN,
  parseSupportedGroups,
  parseSignatureAlgorithms,
  parseSupportedVersionsClient,
  parseSupportedVersionsServer,
  parseKeyShareClient,
  parseKeyShareServer,
  Extension,
  RecordKeys,
  newRecordKeys,
  tlsSuiteById,
  TLS_AES_128_GCM_SHA256,
} from "std/tls"
import {
  Frame,
  readFrame,
  decodeData,
  decodeHeaders,
  decodePriority,
  decodeRstStream,
  decodeSettings,
  decodePushPromise,
  decodePing,
  decodeGoaway,
  decodeWindowUpdate,
  decodeContinuation,
  defaultMaxFrameSize,
  huffmanDecode,
  newDecoder as hpackNewDecoder,
} from "std/http2"
import { newDecoder as qpackNewDecoder } from "std/http3"
import { decodeVarint, parseFrames, parseLongHeader, parseShortHeader } from "std/quic"

// --- deterministic PRNG (splitmix64) ---------------------------------------

// A seeded splitmix64 generator. `state` is a reference field, so `next`
// advances it for the caller; threading one `Rng` through the whole run keeps
// every generated input reproducible.
class Rng {
  state: u64
  // The next 64-bit output, advancing the state (Steele et al. splitmix64). All
  // arithmetic is unsigned and therefore modular — no overflow trap on any state.
  next(): u64 {
    this.state = this.state + 0x9e3779b97f4a7c15
    let z: u64 = this.state
    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9
    z = (z ^ (z >> 27)) * 0x94d049bb133111eb
    return z ^ (z >> 31)
  }
}

// A value in `0..n-1`. `n` must be positive (every caller passes a positive
// bound, so the modulus is never zero).
fn rngInt(r: Rng, n: int): int {
  return int(r.next() % u64(n))
}

// --- input generators -------------------------------------------------------

// `n` fresh random bytes.
fn randomBytes(r: Rng, n: int): []byte {
  let out = []byte(n)
  let i = 0
  while (i < n) {
    out[i] = byte(r.next())
    i = i + 1
  }
  return out
}

// A fresh copy of `src`, so a mutation never scribbles on a shared seed.
fn copyOf(src: []byte): []byte {
  let out = []byte(len(src))
  let i = 0
  while (i < len(src)) {
    out[i] = src[i]
    i = i + 1
  }
  return out
}

// A random-length prefix of `seed` — the "truncated valid message" class.
fn truncate(r: Rng, seed: []byte): []byte {
  if (len(seed) == 0) {
    return seed
  }
  let k = rngInt(r, len(seed) + 1)
  let out = []byte(k)
  let i = 0
  while (i < k) {
    out[i] = seed[i]
    i = i + 1
  }
  return out
}

// `seed` with one to four random byte positions XOR-flipped.
fn flip(r: Rng, seed: []byte): []byte {
  let out = copyOf(seed)
  if (len(out) == 0) {
    return out
  }
  let flips = 1 + rngInt(r, 4)
  let j = 0
  while (j < flips) {
    let p = rngInt(r, len(out))
    out[p] = out[p] ^ byte(r.next())
    j = j + 1
  }
  return out
}

// `seed` with an early byte (biased to the first five, where length prefixes
// live) clobbered by a large value — the "lying / oversized length" class.
fn lyingLen(r: Rng, seed: []byte): []byte {
  let out = copyOf(seed)
  if (len(out) == 0) {
    return out
  }
  let span = 5
  if (len(out) < span) {
    span = len(out)
  }
  let p = rngInt(r, span)
  out[p] = byte(r.next()) | 0x80
  return out
}

// A random-length run of a single byte value — the all-0xFF / all-0x00 class.
fn fillByte(r: Rng, v: int): []byte {
  let n = rngInt(r, 128)
  let out = []byte(n)
  let i = 0
  while (i < n) {
    out[i] = byte(v)
    i = i + 1
  }
  return out
}

// One adversarial input drawn from the eight classes above. Choice 7 returns the
// pristine seed, so the accept (valid-parse) path is exercised too.
fn adversarial(r: Rng, seed: []byte): []byte {
  let choice = rngInt(r, 8)
  if (choice == 0) {
    return randomBytes(r, rngInt(r, 64))
  }
  if (choice == 1) {
    return randomBytes(r, rngInt(r, 1024))
  }
  if (choice == 2) {
    return truncate(r, seed)
  }
  if (choice == 3) {
    return flip(r, seed)
  }
  if (choice == 4) {
    return lyingLen(r, seed)
  }
  if (choice == 5) {
    return fillByte(r, 0xff)
  }
  if (choice == 6) {
    return fillByte(r, 0x00)
  }
  return copyOf(seed)
}

// Append the DER definite-length encoding of `n` (short form under 128, else the
// minimal long form). Used to build well-formed nested TLV.
fn derLen(dst: []byte, n: int): []byte {
  if (n < 0x80) {
    return append(dst, byte(n))
  }
  let tmp = []byte(0)
  let x = n
  let guard = 0
  while (x > 0 && guard < 8) {
    tmp = append(tmp, byte(x & 0xff))
    x = x >> 8
    guard = guard + 1
  }
  let out = append(dst, byte(0x80 | len(tmp)))
  let i = len(tmp) - 1
  while (i >= 0) {
    out = append(out, tmp[i])
    i = i - 1
  }
  return out
}

// A valid DER value nested `depth` SEQUENCEs deep around an inner NULL. At and
// below the parser's depth cap it parses; above it, it must be *rejected*, not
// crash the recursive descent off the fixed green-thread stack.
fn nestedTlv(depth: int): []byte {
  let cur = []byte{ 0x05, 0x00 }
  let i = 0
  while (i < depth) {
    let wrapped = []byte(0)
    wrapped = append(wrapped, 0x30)
    wrapped = derLen(wrapped, len(cur))
    let k = 0
    while (k < len(cur)) {
      wrapped = append(wrapped, cur[k])
      k = k + 1
    }
    cur = wrapped
    i = i + 1
  }
  return cur
}

// --- per-parser wrappers ----------------------------------------------------
//
// Each wrapper runs exactly one parser and swallows a clean `!` failure, so the
// caller can drive parsers back to back without a rejected input skipping its
// siblings. A crash, hang, or OOM would abort the process here instead of
// returning — which is precisely what the harness proves cannot happen.

fn tryAsn1(b: []byte) {
  asn1Parse(b) catch e {
    return
  }
}
fn tryX509(b: []byte) {
  x509Parse(b) catch e {
    return
  }
}
fn tryPem(s: string) {
  pemDecode(s) catch e {
    return
  }
}

fn tryClientHello(b: []byte) {
  parseClientHello(b) catch e {
    return
  }
}
fn tryServerHello(b: []byte) {
  parseServerHello(b) catch e {
    return
  }
}
fn tryEncExts(b: []byte) {
  parseEncryptedExtensions(b) catch e {
    return
  }
}
fn tryCertificate(b: []byte) {
  parseCertificate(b) catch e {
    return
  }
}
fn tryCertVerify(b: []byte) {
  parseCertificateVerify(b) catch e {
    return
  }
}
fn tryFinished(b: []byte) {
  parseFinished(b) catch e {
    return
  }
}
fn tryNewSessionTicket(b: []byte) {
  parseNewSessionTicket(b) catch e {
    return
  }
}

fn tryServerName(e: Extension) {
  parseServerName(e) catch x {
    return
  }
}
fn tryALPN(e: Extension) {
  parseALPN(e) catch x {
    return
  }
}
fn trySupportedGroups(e: Extension) {
  parseSupportedGroups(e) catch x {
    return
  }
}
fn trySignatureAlgorithms(e: Extension) {
  parseSignatureAlgorithms(e) catch x {
    return
  }
}
fn trySupportedVersionsClient(e: Extension) {
  parseSupportedVersionsClient(e) catch x {
    return
  }
}
fn trySupportedVersionsServer(e: Extension) {
  parseSupportedVersionsServer(e) catch x {
    return
  }
}
fn tryKeyShareClient(e: Extension) {
  parseKeyShareClient(e) catch x {
    return
  }
}
fn tryKeyShareServer(e: Extension) {
  parseKeyShareServer(e) catch x {
    return
  }
}

fn tryRecordOpen(k: RecordKeys, rec: []byte) {
  k.open(rec) catch e {
    return
  }
}

fn tryHpack(block: []byte) {
  let d = hpackNewDecoder()
  d.decode(block) catch e {
    return
  }
}
fn tryHuffman(b: []byte) {
  huffmanDecode(b) catch e {
    return
  }
}

fn tryQpackEncoderStream(data: []byte) {
  let d = qpackNewDecoder()
  d.applyEncoderStream(data) catch e {
    return
  }
}
fn tryQpackFieldSection(data: []byte) {
  let d = qpackNewDecoder()
  d.decodeFieldSection(data) catch e {
    return
  }
}

fn tryReadFrame(b: []byte) {
  readFrame(b, defaultMaxFrameSize) catch e {
    return
  }
}
fn tryVarint(b: []byte) {
  decodeVarint(b) catch e {
    return
  }
}
fn tryQuicFrames(b: []byte) {
  parseFrames(b) catch e {
    return
  }
}
fn tryLongHeader(b: []byte) {
  parseLongHeader(b) catch e {
    return
  }
}
fn tryShortHeader(b: []byte, dcidLen: int) {
  parseShortHeader(b, dcidLen) catch e {
    return
  }
}

// Called only with ty exactly in [0,3] (dispatchFrame's own routing guarantees
// it): DATA, HEADERS, PRIORITY, RST_STREAM.
fn dispatchFrameLow(f: Frame, ty: int) {
  if (ty == 0) {
    decodeData(f) catch e {
      return
    }
  } else if (ty == 1) {
    decodeHeaders(f) catch e {
      return
    }
  } else if (ty == 2) {
    decodePriority(f) catch e {
      return
    }
  } else {
    decodeRstStream(f) catch e {
      return
    }
  }
}

// Called only with ty exactly in [4,6]: SETTINGS, PUSH_PROMISE, PING.
fn dispatchFrameMid(f: Frame, ty: int) {
  if (ty == 4) {
    decodeSettings(f) catch e {
      return
    }
  } else if (ty == 5) {
    decodePushPromise(f) catch e {
      return
    }
  } else {
    decodePing(f) catch e {
      return
    }
  }
}

// Called only with ty exactly 7 or 8: GOAWAY, WINDOW_UPDATE.
fn dispatchFrameHigh(f: Frame, ty: int) {
  if (ty == 7) {
    decodeGoaway(f) catch e {
      return
    }
  } else {
    decodeWindowUpdate(f) catch e {
      return
    }
  }
}

// Run the type-specific HTTP/2 decoder for `ty` on `f`, swallowing rejections.
// Split three ways purely to keep each part's complexity under the limit
// (E0204, was complexity 20 -- one `if`/catch pair per branch, so a single
// 10-way chain cannot fit under 10 no matter how it is written). Each helper
// above is only ever called with ty already narrowed to its exact range, so
// this preserves the original's behavior for every int, not just [0,9].
fn dispatchFrame(f: Frame, ty: int) {
  if (ty >= 0 && ty <= 3) {
    dispatchFrameLow(f, ty)
  } else if (ty >= 4 && ty <= 6) {
    dispatchFrameMid(f, ty)
  } else if (ty == 7 || ty == 8) {
    dispatchFrameHigh(f, ty)
  } else {
    decodeContinuation(f) catch e {
      return
    }
  }
}

// --- per-parser batches -----------------------------------------------------

// Shared batch size for the general random/mutation sweeps.
const iters: int = 3000
// The nested-TLV sweep spans depths straddling the ASN.1 depth cap (32).
const nestMax: int = 96

// A small valid DER value (SEQUENCE { INTEGER 5, OCTET STRING 0xFF }) to mutate.
fn asn1Seed(): []byte { return []byte{ 0x30, 0x06, 0x02, 0x01, 0x05, 0x04, 0x01, 0xff } }

// ASN.1/DER: random + mutation sweep, then the deep-nesting stack-DoS sweep.
fn fuzzAsn1(r: Rng): int {
  let n = 0
  let i = 0
  while (i < iters) {
    tryAsn1(adversarial(r, asn1Seed()))
    n = n + 1
    i = i + 1
  }
  let d = 0
  while (d <= nestMax) {
    tryAsn1(nestedTlv(d))
    n = n + 1
    d = d + 1
  }
  return n
}

// X.509: random + mutation of a DER seed, plus deep-nesting fed straight through
// the certificate front end (which parses DER before inspecting the tree).
fn fuzzX509(r: Rng): int {
  let n = 0
  let i = 0
  while (i < iters) {
    tryX509(adversarial(r, asn1Seed()))
    n = n + 1
    i = i + 1
  }
  let d = 0
  while (d <= nestMax) {
    tryX509(nestedTlv(d))
    n = n + 1
    d = d + 1
  }
  return n
}

// A minimal well-formed PEM block, as bytes, to truncate and corrupt.
fn pemSeed(): []byte {
  return []byte("-----BEGIN CERTIFICATE-----\nMIIBAKADAgEF\n-----END CERTIFICATE-----\n")
}

// PEM: random + mutation of a valid block. Non-UTF-8 bytes are fine — the reader
// scans for ASCII markers and base64.
fn fuzzPem(r: Rng): int {
  let n = 0
  let i = 0
  while (i < iters) {
    tryPem(string(adversarial(r, pemSeed())))
    n = n + 1
    i = i + 1
  }
  return n
}

// The RFC 8448 ClientHello, a rich real handshake message to mutate.
const chHex: string = ""

// TLS handshake message parsers: every listed entry point over the same mutated
// ClientHello stream. Wrong-type messages are rejected at the framing check; the
// shared reader machinery (length-prefixed vectors, extension list) is what the
// mutations hammer.
fn fuzzTlsHandshake(r: Rng, seed: []byte): int {
  let n = 0
  let i = 0
  while (i < iters) {
    let m = adversarial(r, seed)
    tryClientHello(m)
    tryServerHello(m)
    tryEncExts(m)
    tryCertificate(m)
    tryCertVerify(m)
    tryFinished(m)
    tryNewSessionTicket(m)
    n = n + 1
    i = i + 1
  }
  return n
}

// TLS typed-extension parsers: each fed an Extension whose body is adversarial
// bytes, exercising the inner length-prefixed list/entry loops.
fn fuzzTlsExtensions(r: Rng): int {
  let n = 0
  let i = 0
  while (i < iters) {
    let e = Extension{ extType: rngInt(r, 0x10000), data: randomBytes(r, rngInt(r, 64)) }
    tryServerName(e)
    tryALPN(e)
    trySupportedGroups(e)
    trySignatureAlgorithms(e)
    trySupportedVersionsClient(e)
    trySupportedVersionsServer(e)
    tryKeyShareClient(e)
    tryKeyShareServer(e)
    n = n + 1
    i = i + 1
  }
  return n
}

// A plausible TLS 1.3 record: application_data type, version 0x0303, length 17,
// then 17 ciphertext bytes (enough to reach the AEAD open).
fn recordSeed(): []byte {
  let out = []byte{ 0x17, 0x03, 0x03, 0x00, 0x11 }
  let i = 0
  while (i < 17) {
    out = append(out, 0x00)
    i = i + 1
  }
  return out
}

// TLS record open: real derived keys, adversarial records. Random records fail
// the length check or authenticate as bad_record_mac; the sequence number only
// advances on a genuine open, so this stays deterministic.
fn fuzzTlsRecord(r: Rng): int {
  let suite = tlsSuiteById(TLS_AES_128_GCM_SHA256) catch e {
    return 0
  }
  let keys = newRecordKeys(suite, []byte(32)) catch e {
    return 0
  }
  let n = 0
  let i = 0
  while (i < iters) {
    tryRecordOpen(keys, adversarial(r, recordSeed()))
    n = n + 1
    i = i + 1
  }
  return n
}

// HPACK header-block decode: a fresh decoder per input (so table state cannot
// grow unbounded across the batch), over random blocks.
fn fuzzHpack(r: Rng): int {
  let n = 0
  let i = 0
  while (i < iters) {
    tryHpack(randomBytes(r, rngInt(r, 96)))
    n = n + 1
    i = i + 1
  }
  return n
}

// Huffman decode: plain random streams plus a run of 0xFF octets — the padding
// and never-resolving-code class.
fn fuzzHuffman(r: Rng): int {
  let n = 0
  let i = 0
  while (i < iters) {
    tryHuffman(randomBytes(r, rngInt(r, 96)))
    tryHuffman(fillByte(r, 0xff))
    n = n + 1
    i = i + 1
  }
  return n
}

// QPACK: a fresh decoder per input over both instruction streams — the encoder
// stream (table mutations) and an encoded field section.
fn fuzzQpack(r: Rng): int {
  let n = 0
  let i = 0
  while (i < iters) {
    tryQpackEncoderStream(randomBytes(r, rngInt(r, 96)))
    tryQpackFieldSection(randomBytes(r, rngInt(r, 96)))
    n = n + 1
    i = i + 1
  }
  return n
}

// A varint whose first byte lies about its length (top two bits force a 2/4/8
// byte form) but whose buffer is short — the "wrong length prefix" class.
fn shortVarint(r: Rng): []byte {
  let out = []byte(0)
  let tag = rngInt(r, 4)
  out = append(out, byte((tag << 6) | rngInt(r, 64)))
  let extra = rngInt(r, tag + 1)
  let i = 0
  while (i < extra) {
    out = append(out, byte(r.next()))
    i = i + 1
  }
  return out
}

// QUIC varint decode: random bytes plus deliberately-truncated multi-byte forms.
fn fuzzQuicVarint(r: Rng): int {
  let n = 0
  let i = 0
  while (i < iters) {
    tryVarint(randomBytes(r, rngInt(r, 12)))
    tryVarint(shortVarint(r))
    n = n + 1
    i = i + 1
  }
  return n
}

// QUIC frame stream decode: random payloads run through the full frame dispatch,
// including ACK range counts and CRYPTO/STREAM/NEW_CONNECTION_ID length fields.
fn fuzzQuicFrames(r: Rng): int {
  let n = 0
  let i = 0
  while (i < iters) {
    tryQuicFrames(randomBytes(r, rngInt(r, 128)))
    n = n + 1
    i = i + 1
  }
  return n
}

// QUIC packet header parse: long-header (version + two length-prefixed CIDs) and
// short-header (caller-supplied DCID length), both over random buffers.
fn fuzzQuicPacket(r: Rng): int {
  let n = 0
  let i = 0
  while (i < iters) {
    let p = randomBytes(r, rngInt(r, 64))
    tryLongHeader(p)
    tryShortHeader(p, rngInt(r, 25))
    n = n + 1
    i = i + 1
  }
  return n
}

// A well-formed 9-byte frame header of type `ty` with `plen` random payload
// bytes, so `readFrame` accepts it and hands a Frame to the typed decoders.
fn framedBuf(r: Rng, ty: int, plen: int): []byte {
  let out = []byte(0)
  out = append(out, byte((plen >> 16) & 0xff))
  out = append(out, byte((plen >> 8) & 0xff))
  out = append(out, byte(plen & 0xff))
  out = append(out, byte(ty))
  out = append(out, byte(r.next()))
  let k = 0
  while (k < 4) {
    out = append(out, byte(r.next()))
    k = k + 1
  }
  let p = 0
  while (p < plen) {
    out = append(out, byte(r.next()))
    p = p + 1
  }
  return out
}

// HTTP/2 frame decode: random buffers through `readFrame` (mostly rejected: an
// oversized length, or a payload past the buffer), then well-framed buffers so
// every typed `decode*` runs over adversarial flags/stream-id/payload.
fn fuzzHttp2Frames(r: Rng): int {
  let n = 0
  let i = 0
  while (i < iters) {
    tryReadFrame(randomBytes(r, rngInt(r, 64)))
    let ty = rngInt(r, 10)
    let f = readFrame(framedBuf(r, ty, rngInt(r, 48)), defaultMaxFrameSize) catch e {
      continue
    }
    dispatchFrame(f, ty)
    n = n + 1
    i = i + 1
  }
  return n
}

fn main() {
  let r = Rng{ state: 0x0123456789abcdef }
  println("asn1: ${fuzzAsn1(r)} inputs ok")
  println("x509: ${fuzzX509(r)} inputs ok")
  println("pem: ${fuzzPem(r)} inputs ok")
  println(
    "tls-handshake: ${fuzzTlsHandshake(
      r,
      decodeHex(chHex) catch e {
        []byte(0)
      },
    )} inputs ok",
  )
  println("tls-extensions: ${fuzzTlsExtensions(r)} inputs ok")
  println("tls-record: ${fuzzTlsRecord(r)} inputs ok")
  println("hpack: ${fuzzHpack(r)} inputs ok")
  println("huffman: ${fuzzHuffman(r)} inputs ok")
  println("qpack: ${fuzzQpack(r)} inputs ok")
  println("quic-varint: ${fuzzQuicVarint(r)} inputs ok")
  println("quic-frames: ${fuzzQuicFrames(r)} inputs ok")
  println("quic-packet: ${fuzzQuicPacket(r)} inputs ok")
  println("http2-frames: ${fuzzHttp2Frames(r)} inputs ok")
}
