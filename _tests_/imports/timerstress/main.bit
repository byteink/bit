import { newTimer, Timer } from "std/time"

fn main() {
  let timers: []Timer = []Timer(0)
  let i = 0
  while (i < 20000) {
    timers = append(timers, newTimer(30000000000))
    i = i + 1
  }
  let stopped = 0
  let j = 0
  while (j < len(timers)) {
    if (timers[j].stop()) {
      stopped = stopped + 1
    }
    j = j + 1
  }
  print("armed_stopped=${stopped}\n")
}
