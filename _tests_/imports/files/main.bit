// Exercises std/fs end to end: writeFile then readFile round-trips content
// through a real file, and a missing path takes the error branch. Uses a fixed
// temp path so the output is deterministic.
import { readFile, writeFile } from "std/fs"

fn main() {
  let path = "/tmp/bit_imports_fs_roundtrip.txt"

  writeFile(path, "abc\n123\n") catch e {
    println("write failed: ${e.message()}")
    return
  }

  let c = readFile(path) catch e {
    println("read failed: ${e.message()}")
    return
  }
  print(c)
  println("bytes=${len(c)}")

  let missing = readFile("/does/not/exist/here") catch e {
    "MISSING"
  }
  println("missing=${missing}")
}
