// Windows child #3 (companion to ../mainwindows.bit, #5782): writes strictly
// more than `osRunCaptureMaxBytes` (4 MiB) to stdout only, to exercise
// `_truncated`'s bit 0. Exit 42.
import { exit } from "std/os"

const chunk: string = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\n" // 100 bytes

fn main() {
  let i = 0
  while (i < 43000) {
    print(chunk)
    i = i + 1
  }
  exit(42)
}
