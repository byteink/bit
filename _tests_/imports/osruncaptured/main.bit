// End-to-end coverage for `std/process`'s `output` (ABI.md §19,
// #5780/#5781/#5782, epic #3459) on Darwin — the property under test is
// stdout/stderr capture through fork+pipe+dup2, which no `_tests_/cases/*.bit`
// single-file fixture can reach (spawning a real child process, timing a
// real bounded wait, and running two real captures concurrently are all
// outside that harness's build-then-run-the-binary convention).
//
// This used to be a raw `extern fn` shim reaching `bit_rt_os_run_captured`
// directly (#5780/#5781's placeholder, argv always empty since building a
// SliceHeader by hand was out of scope there). #5783 landed the real
// `std/process` wrapper, so this file now exercises the public API only —
// including a non-empty `args` case the shim never covered.
import { exit, envOr } from "std/os"
import { writeFile, mkdir, isDir } from "std/fs"
import { output, RunResult } from "std/process"

fn bail(msg: string) {
  eprint("FAIL: ${msg}\n")
  exit(1)
}

fn writeScript(path: string, body: string) {
  writeFile(path, body) catch e {
    bail("writeFile ${path}: ${e.message()}")
  }
  if (fsChmod(path, 448) != 0) { // 0o700
    bail("fsChmod ${path}")
  }
}

// `r`'s stdout equals `want` byte for byte — not just a length check.
fn assertStdout(label: string, r: RunResult, want: string) {
  if (r.stdout != want) {
    bail("${label}: stdout=${r.stdout} want=${want}")
  }
}

// One capture on its own goroutine (the "two captures running concurrently
// from two tasks" case, checking the per-task companion storage
// `runtime/sched/scratch.bit`'s `scrOsCapStdout` etc. — a shared per-worker
// slot would let one task's read see the other's content).
fn concurrentWorker(scriptPath: string, want: string, results: chan<bool>) {
  let r = output(scriptPath, []string(0), 5000)
  results <- r.exitCode == 0 && r.stdout == want
}

// 1. Exact byte content of a small capture, and an empty, non-truncated
// stderr alongside it. `timeoutMs` omitted: exercises the `= 0` default
// (the runtime's 100-minute ceiling, not a shorter one this module invents).
fn testSmall(scratch: string) {
  let p = scratch + "/small.sh"
  writeScript(p, "#!/bin/sh\nprintf 'hello-osruncap-42\\n'\nexit 0\n")
  let r = output(p, []string(0))
  if (r.exitCode != 0) {
    bail("small: exitCode=${r.exitCode}")
  }
  assertStdout("small", r, "hello-osruncap-42\n")
  if (r.stderr != "") {
    bail("small: stderr=${r.stderr}")
  }
  if (r.truncated) {
    bail("small: unexpected truncation")
  }
  print("small: OK\n")
}

// 2. `args` reaches the child as its own argv, not shell-reinterpreted: two
// arguments containing a character (`*`) a shell would glob-expand if `run`/
// `output` ever routed through one.
fn testArgs(scratch: string) {
  let p = scratch + "/args.sh"
  writeScript(p, "#!/bin/sh\nprintf '%s|%s\\n' \"$1\" \"$2\"\nexit 0\n")
  let r = output(p, ["arg-one", "a*b"], 5000)
  if (r.exitCode != 0) {
    bail("args: exitCode=${r.exitCode}")
  }
  assertStdout("args", r, "arg-one|a*b\n")
  print("args: OK\n")
}

// 3. > 64 KiB on BOTH stdout and stderr, neither truncated: the deadlock
// property ABI.md §19 documents (both pipes must drain to EOF regardless of
// the other's cap) — a wrong drain order hangs this call instead of
// returning.
fn testBig(scratch: string) {
  let p = scratch + "/big.sh"
  writeScript(
    p,
    "#!/bin/sh\nyes B | head -c 100000\nyes C | head -c 100000 1>&2\nexit 7\n",
  )
  let r = output(p, []string(0), 10000)
  if (r.exitCode != 7) {
    bail("big: exitCode=${r.exitCode}")
  }
  if (len(r.stdout) <= 65536) {
    bail("big: stdout too short ${len(r.stdout)}")
  }
  if (len(r.stderr) <= 65536) {
    bail("big: stderr too short ${len(r.stderr)}")
  }
  if (r.truncated) {
    bail("big: unexpected truncation")
  }
  print("big: OK\n")
}

// 4. A child writing more than the 4 MiB cap to stdout — `truncated` true,
// captured length == the cap exactly, exit code still correct.
fn testTrunc(scratch: string) {
  let p = scratch + "/trunc.sh"
  writeScript(p, "#!/bin/sh\nyes A | head -c 4200000\nexit 42\n")
  let r = output(p, []string(0), 20000)
  if (r.exitCode != 42) {
    bail("trunc: exitCode=${r.exitCode}")
  }
  if (len(r.stdout) != 4194304) {
    bail("trunc: stdout len=${len(r.stdout)} want=4194304")
  }
  if (!r.truncated) {
    bail("trunc: truncation not reported")
  }
  print("trunc: OK\n")
}

// 5. Bounded call against a slow child: `-2`, child reaped.
fn testTimeout(scratch: string) {
  let p = scratch + "/slow.sh"
  writeScript(p, "#!/bin/sh\nsleep 30\n")
  let r = output(p, []string(0), 300)
  if (r.exitCode != 0 - 2) {
    bail("timeout: exitCode=${r.exitCode}")
  }
  print("timeout: OK\n")
}

// 6. Two captures running concurrently from two tasks, each getting its own
// output — the per-task companion storage check.
fn testConcurrent(scratch: string) {
  let concAPath = scratch + "/conc_a.sh"
  let concBPath = scratch + "/conc_b.sh"
  writeScript(concAPath, "#!/bin/sh\nprintf 'concurrent-A-output\\n'\nexit 0\n")
  writeScript(concBPath, "#!/bin/sh\nprintf 'concurrent-B-output\\n'\nexit 0\n")
  let results = chan<bool>()
  spawn concurrentWorker(concAPath, "concurrent-A-output\n", results)
  spawn concurrentWorker(concBPath, "concurrent-B-output\n", results)
  let firstOk = <- results
  let secondOk = <- results
  if (!firstOk || !secondOk) {
    bail("concurrent: one or both captures got the wrong output")
  }
  print("concurrent: OK\n")
}

fn main() {
  let scratch = envOr("TMPDIR", "/tmp") + "/bit-osruncaptured-fixture"
  if (!isDir(scratch)) {
    mkdir(scratch) catch e {
      bail("mkdir ${scratch}: ${e.message()}")
    }
  }
  testSmall(scratch)
  testArgs(scratch)
  testBig(scratch)
  testTrunc(scratch)
  testTimeout(scratch)
  testConcurrent(scratch)
  print("PASS\n")
}
