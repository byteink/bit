// std/tls handshake round-trip (#1204). Parse the RFC 8448 "Simple 1-RTT
// Handshake" messages from their exact hex, re-encode, and assert every one is
// byte-identical — the strongest evidence the encoder and decoder agree with
// the wire format. Then build a ClientHello, ServerHello, and NewSessionTicket
// from scratch (exercising the typed extension helpers and HelloRetryRequest
// recognition) and re-parse them. All output is deterministic, so the golden
// `expected` is stable.
import { decodeHex } from "std/crypto"
import {
  ClientHello,
  ServerHello,
  EncryptedExtensions,
  Certificate,
  CertificateEntry,
  CertificateVerify,
  Finished,
  NewSessionTicket,
  Extension,
  KeyShareEntry,
  encodeClientHello,
  parseClientHello,
  encodeServerHello,
  parseServerHello,
  encodeEncryptedExtensions,
  parseEncryptedExtensions,
  encodeCertificate,
  parseCertificate,
  encodeCertificateVerify,
  parseCertificateVerify,
  encodeFinished,
  parseFinished,
  encodeNewSessionTicket,
  parseNewSessionTicket,
  handshakeType,
  isHelloRetryRequest,
  extServerName,
  parseServerName,
  extALPN,
  parseALPN,
  extSupportedGroups,
  parseSupportedGroups,
  extSignatureAlgorithms,
  parseSignatureAlgorithms,
  extSupportedVersionsClient,
  parseSupportedVersionsClient,
  extSupportedVersionsServer,
  parseSupportedVersionsServer,
  extKeyShareClient,
  parseKeyShareClient,
  extKeyShareServer,
  parseKeyShareServer,
  versionTls13,
  groupX25519,
  groupSecp256r1,
  sigEcdsaSecp256r1Sha256,
  sigRsaPssRsaeSha256,
  sigEd25519,
} from "std/tls"

// The six handshake messages from RFC 8448 §3, exactly as printed (type byte,
// three-byte length, body), with the whitespace removed.
const chHex: string = ""
const shHex: string = "020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304"
const eeHex: string = "080000240022000a00140012001d00170018001901000101010201030104001c0002400100000000"
const certHex: string = ""
const cvHex: string = "0f000084080400805a747c5d88fa9bd2e55ab085a61015b7211f824cd484145ab3ff52f1fda8477b0b7abc90db78e2d33a5c141a078653fa6bef780c5ea248eeaaa785c4f394cab6d30bbe8d4859ee511f602957b15411ac027671459e46445c9ea58c181e818e95b8c3fb0bf3278409d3be152a3da5043e063dda65cdf5aea20d53dfacd42f74f3"
const finHex: string = "140000209b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718"

// A 32-byte random for the from-scratch messages (arbitrary but fixed).
const rndHex: string = "0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20"

// Whole-slice byte equality.
fn eq(a: []byte, b: []byte): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// The first extension of `exts` with type `t`, failing if none.
fn findExt(exts: []Extension, t: int): Extension! {
  for e of exts {
    if (e.extType == t) {
      return e
    }
  }
  fail newError("extension ${t} not found")
}

fn run(): ()! {
  // --- RFC 8448 byte-identical round-trips ---
  let ch = decodeHex(chHex)?
  println("ClientHello=${eq(encodeClientHello(parseClientHello(ch)?), ch)}")

  let sh = decodeHex(shHex)?
  println("ServerHello=${eq(encodeServerHello(parseServerHello(sh)?), sh)}")

  let ee = decodeHex(eeHex)?
  println("EncryptedExtensions=${eq(encodeEncryptedExtensions(parseEncryptedExtensions(ee)?), ee)}")

  let cert = decodeHex(certHex)?
  println("Certificate=${eq(encodeCertificate(parseCertificate(cert)?), cert)}")

  let cv = decodeHex(cvHex)?
  println("CertificateVerify=${eq(encodeCertificateVerify(parseCertificateVerify(cv)?), cv)}")

  let fin = decodeHex(finHex)?
  println("Finished=${eq(encodeFinished(parseFinished(fin)?), fin)}")

  // --- parsed-field spot checks against RFC 8448 ---
  let pch = parseClientHello(ch)?
  println("hsType=${handshakeType(ch)?}")
  println("chSuites=${len(pch.cipherSuites)} first=${pch.cipherSuites[0]}")
  let psh = parseServerHello(sh)?
  println("shSuite=${psh.cipherSuite} isHRR=${isHelloRetryRequest(psh)}")
  let pcert = parseCertificate(cert)?
  println("certEntries=${len(pcert.entries)} ctxEmpty=${len(pcert.certRequestContext) == 0}")
  let pcv = parseCertificateVerify(cv)?
  println("cvAlg=${pcv.algorithm} sigLen=${len(pcv.signature)}")
  println("finLen=${len(parseFinished(fin)?.verifyData)}")

  // --- HelloRetryRequest recognition ---
  let hrr = ServerHello{
    legacyVersion: versionTls13,
    random: decodeHex("cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c")?,
    sessionId: []byte(0),
    cipherSuite: 0x1301,
    extensions: []Extension(0),
  }
  let hrrWire = encodeServerHello(hrr)
  println("hrrDetected=${isHelloRetryRequest(parseServerHello(hrrWire)?)}")

  // --- ClientHello built from scratch, with typed extensions ---
  let exts = []Extension(0)
  exts = append(exts, extServerName("example.com"))
  exts = append(exts, extSupportedVersionsClient([versionTls13]))
  exts = append(exts, extSupportedGroups([groupX25519, groupSecp256r1]))
  let ks = []KeyShareEntry(0)
  ks = append(ks, KeyShareEntry{ group: groupX25519, keyExchange: decodeHex(rndHex)? })
  exts = append(exts, extKeyShareClient(ks))
  exts = append(
    exts,
    extSignatureAlgorithms([sigEcdsaSecp256r1Sha256, sigRsaPssRsaeSha256, sigEd25519]),
  )
  exts = append(exts, extALPN(["h2", "http/1.1"]))

  let built = ClientHello{
    legacyVersion: 0x0303,
    random: decodeHex(rndHex)?,
    sessionId: []byte(0),
    cipherSuites: [0x1301, 0x1302, 0x1303],
    extensions: exts,
  }
  let wire = encodeClientHello(built)
  let reparsed = parseClientHello(wire)?
  println("chSelfRoundtrip=${eq(encodeClientHello(reparsed), wire)}")
  println("sni=${parseServerName(findExt(reparsed.extensions, 0)?)?}")
  let alpn = parseALPN(findExt(reparsed.extensions, 16)?)?
  println("alpn=${alpn[0]},${alpn[1]}")
  let sv = parseSupportedVersionsClient(findExt(reparsed.extensions, 43)?)?
  println("chVer=${sv[0]}")
  let gs = parseSupportedGroups(findExt(reparsed.extensions, 10)?)?
  println("groups=${len(gs)} first=${gs[0]}")
  let sa = parseSignatureAlgorithms(findExt(reparsed.extensions, 13)?)?
  println("sigAlgs=${len(sa)} ed25519=${sa[2]}")
  let pks = parseKeyShareClient(findExt(reparsed.extensions, 51)?)?
  println("keyShare=${len(pks)} group=${pks[0].group} keyLen=${len(pks[0].keyExchange)}")

  // --- ServerHello built from scratch, server-form extensions ---
  let shExts = []Extension(0)
  shExts = append(shExts, extSupportedVersionsServer(versionTls13))
  shExts = append(
    shExts,
    extKeyShareServer(KeyShareEntry{ group: groupX25519, keyExchange: decodeHex(rndHex)? }),
  )
  let builtSh = ServerHello{
    legacyVersion: 0x0303,
    random: decodeHex(rndHex)?,
    sessionId: []byte(0),
    cipherSuite: 0x1301,
    extensions: shExts,
  }
  let shWire = encodeServerHello(builtSh)
  let rsh = parseServerHello(shWire)?
  println("shSelfRoundtrip=${eq(encodeServerHello(rsh), shWire)}")
  println("shVer=${parseSupportedVersionsServer(findExt(rsh.extensions, 43)?)?}")
  println("shKeyGroup=${parseKeyShareServer(findExt(rsh.extensions, 51)?)?.group}")

  // --- NewSessionTicket built from scratch ---
  let nst = NewSessionTicket{
    lifetime: 7200,
    ageAdd: 0x11223344,
    nonce: decodeHex("0000")?,
    ticket: decodeHex("cafebabe")?,
    extensions: []Extension(0),
  }
  let nstWire = encodeNewSessionTicket(nst)
  let pnst = parseNewSessionTicket(nstWire)?
  println("nstRoundtrip=${eq(encodeNewSessionTicket(pnst), nstWire)}")
  println("nstLife=${pnst.lifetime} nstAge=${pnst.ageAdd} ticketLen=${len(pnst.ticket)}")
}

fn main() { run() catch e {
  println("error: ${e.message()}")
} }
