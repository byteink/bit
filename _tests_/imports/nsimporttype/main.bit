// #2118: a namespace import (#1154) can now name a TYPE from the imported
// module in TYPE position (`io.Writer`), the same `ns.member` spelling
// `nsimport` already exercises for a value (`io.stdout()`). Before this, only
// the expression-position spelling parsed — a namespaced type annotation was
// four cascading E0021s from the single '.' token.
import io from "std/io"

// A class field's type, qualified through the namespace.
class Sink {
  out: io.Writer
  label: string

  log(msg: string) {
    this.out.writeLine("${this.label}: ${msg}")
  }
}

// A function parameter's type, qualified through the namespace — the ticket's
// own minimized repro.
fn emit(w: io.Writer, msg: string) {
  w.writeLine(msg)
}

fn main() {
  emit(io.stdout(), "direct call")
  let s = Sink{ out: io.stdout(), label: "sink" }
  s.log("via class field")
}
