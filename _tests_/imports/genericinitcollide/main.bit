// #1536: two functions that each bind a local of the SAME NAME from a generic
// call of a DIFFERENT type argument.
//
// `unwrap(found)` has no written type to bind T from, so the checker re-derives
// the type args from the call that initialized `found` (#1498). That table used
// to be keyed by the binding's NAME and was module-wide, so both `found`s shared
// one slot and the last write won: `a` re-derived its Option's type argument
// from `b`'s `find<string>` and the binary segfaulted. Neither function alone,
// nor the same pair with distinct binding names, reproduces it.
import { find } from "std/seq"

fn a() {
  let found = find<i64>([1, 2, 3], (x: i64) => x > 1)
  println("a=${unwrap(found)}")
}

fn b() {
  let found = find<string>(["p", "q"], (s: string) => s == "q")
  println("b=${unwrap(found)}")
}

fn main() {
  a()
  b()
}
