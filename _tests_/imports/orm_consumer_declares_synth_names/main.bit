// #7661: a consumer of pkg/orm that declares, at top level, every name pkg/orm's
// relation synthesis reaches (`Data`, `RelationLoader`, `LinkOp`,
// `ManyToManyDesc`, `dispatchLoadRelation`, `belongsToRelation`,
// `hasOneRelation`, `hasManyRelation`, `dispatchLinkRelation`,
// `relationIdColumn`, `manyToManyLoader`) next to `@table` classes with
// relations. The synthesized `__loadRelation`/`__linkRelation` bodies bind
// pkg/orm under reserved `__` aliases (#7564), so none of these collides with
// them. pkg/orm is recognized by the directory the import resolved to
// (`ormPackageRoots`), not by this module declaring `dispatchLoadRelation`, so
// the declaration below neither exempts this module from E0314 nor changes how
// pkg/orm is found. Nothing here opens a database.
import { Db } from "orm"

class Data {
  tag: int = 0,
}

class RelationLoader {
  tag: int = 0,
}

class LinkOp {
  tag: int = 0,
}

class ManyToManyDesc {
  tag: int = 0,
}

fn dispatchLoadRelation(): int {
  return 0
}

fn belongsToRelation(): int {
  return 0
}

fn hasOneRelation(): int {
  return 0
}

fn hasManyRelation(): int {
  return 0
}

fn dispatchLinkRelation(): int {
  return 0
}

fn relationIdColumn(): int {
  return 0
}

fn manyToManyLoader(): int {
  return 0
}

@table class Author {
  id: i64
  name: string
  @hasMany("authorId")
  posts: []Post
}

@table class Post {
  id: i64
  authorId: i64
  @belongsTo("authorId")
  author: Author
}

fn unused(db: Db): int {
  return 0
}

fn main() {
  print("author=${Author.__tableName()} post=${Post.__tableName()}\n")
}
