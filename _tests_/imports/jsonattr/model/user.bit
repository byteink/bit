// #3976: the `@json` class lives HERE and is consumed from `../main.bit`.
// The synthesised `toJson` is exported iff the CLASS is, so `User`'s member
// crosses the module boundary and `Internal`'s does not exist at all.
//
// `Addr` is nested inside `User` and carries `@json` of its own: the mark is
// per class, and synthesis never recurses into a class that did not opt in.
import { Json, JsonEntry } from "std/json"

export @json class Addr {
  city: string,
}

export @json class User {
  id: i64
  name: string
  @key("created_at")
  createdAt: string
  addr: Addr
  tags: []string
  nick: Option<string>
}
