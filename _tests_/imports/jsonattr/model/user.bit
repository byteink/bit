// #3976: the `@json` class lives HERE and is consumed from `../main.bit`.
// The synthesised `toJson` is exported iff the CLASS is, so `User`'s member
// crosses the module boundary and `Internal`'s does not exist at all.
//
// `Addr` is nested inside `User` and carries `@json` of its own: the mark is
// per class, and synthesis never recurses into a class that did not opt in.
import { Json, JsonEntry } from "std/json"

// Every field carries `export`: `../main.bit` builds both classes with
// composite literals naming each field, and SPEC 10.5 makes a foreign literal
// slot for an unexported field an E0046 since #4631 — the same rule as a
// foreign read. The `@json` mark and the synthesised `toJson` are unaffected;
// synthesis reads the field LIST, not its visibility.
export @json class Addr {
  export city: string,
}

export @json class User {
  export id: i64
  export name: string
  @key("created_at")
  export createdAt: string
  export addr: Addr
  export tags: []string
  export nick: Option<string>
}
