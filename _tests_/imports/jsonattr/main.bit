// #3976: `@json` synthesises a real exported member, so a class marked in one
// module serialises from another with nothing imported but the class itself.
// The point of the fixture is the MODULE BOUNDARY: `toJson` is spliced in
// before resolve, so every later pass (export table, method table, mangling,
// linking) treats it as one the class wrote by hand -- and if any of them did
// not, this is where it would show.
import { User, Addr } from "./model"
import { jsonEncode } from "std/json"

fn main() {
  let u = User{
    id: 42,
    name: "ada",
    createdAt: "2026-01-01",
    addr: Addr{ city: "cairo" },
    tags: ["x"],
    nick: Option<string>.None,
  }
  println(jsonEncode(u.toJson()))
  println(jsonEncode(u.addr.toJson()))
}
