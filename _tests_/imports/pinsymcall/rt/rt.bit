// A NON-ROOT module whose exports are pinned with §11.9 `@symbol`. Every
// function here would ordinarily be emitted as `m<id>$name`, where `<id>` is an
// ordinal the IMPORTING build assigns — the pin replaces that with a fixed
// link-level name.
//
// `_tests_/stress/pinsym` already covers reaching a pin through an `extern`
// declaration (§11.7). This module is reached the OTHER way: imported and
// called by its Bit name, which is the path a Bit-sourced runtime module
// actually uses and the one that was broken (#1410).

// RECURSIVE on purpose. A small leaf body gets spliced into the caller by the
// inliner at -O1, and a spliced call emits no cross-module symbol at all — so a
// non-recursive callee would let a mis-spelled call site slide. Recursion also
// puts a SELF-call inside the pinned body, which must resolve to the pinned
// name too: the definition is emitted as `bit_pinned_sum` and the self-call has
// to agree with it.
export @symbol("bit_pinned_sum")
fn pinnedSum(n: i64): i64 {
  if (n <= 0) {
    return 0
  }
  return n + pinnedSum(n - 1)
}

// Order-sensitive, so this also pins down argument ORDER across the call: a
// commutative operation would return the right answer even if the two sides
// paired the argument registers up backwards.
export @symbol("bit_pinned_diff")
fn pinnedDiff(a: i64, b: i64): i64 {
  if (a <= b) {
    return pinnedDiff(b, a)
  }
  return a - b
}

// The CONTROL: same module, same shape, NO pin. This one keeps the ordinary
// `m<id>$` prefix, so it proves the prefix mechanism is still in force and that
// the two cases above are not passing because module qualification quietly
// stopped happening for everything.
export fn plainDiff(a: i64, b: i64): i64 {
  if (a <= b) {
    return plainDiff(b, a)
  }
  return a - b
}
