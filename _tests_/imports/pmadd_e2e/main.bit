// End-to-end coverage for `bit add` (#1734, #1736) through the real dispatched
// CLI, closing the gap #1767 was filed against: neither `_tests_/cases/*.bit`
// (single-file, cannot `import "std/json"`, so the CST edit layer `bit add`
// depends on is unreachable there) nor a plain `_tests_/imports/*` project
// (cannot exec the compiler that built it) could previously reach `bit add`
// at all. `BIT_SELF_EXE`, set by the deleted harness `imports`, is what makes
// the second half possible: this program execs the exact `bit` binary it was
// itself compiled by, argv and all — fetch, resolve, CST-rewrite, lock-write,
// the whole real path, not a unit call into compiler/pmcli.bit's internals
// (compiler/ is the compiler's own implementation and is not importable from
// a program the compiler builds).
//
// The git fixture's commit is made byte-for-byte reproducible (fixed author/
// committer identity and date — see `buildFixture` below) specifically so its
// resulting commit sha, which both `bit add`'s own confirmation line and the
// written `bit.lock` embed, is a fixed string this golden `expected` file can
// diff against instead of a different hash on every run.
//
// `--url file://<fixtureDir>` is the CLI-only escape hatch pmcli.bit's
// `addCmd` gained alongside this test: it points the fetch at the local
// fixture instead of the `https://` URL the spec derives from the dependency
// name, without that override ever reaching `bit.json` or `bit.lock` (both
// keep recording the plain `https://github.com/pmadd_e2e/fixture.git` spec
// would imply) — verified below by the printed `bit.lock` line.
//
// The host is `github.com` and must stay a KNOWN git host (pmfetch.bit's
// `isKnownGitHost`). It used to be a `local` pseudo-host, which #2068 turned
// into a vanity name — and `--url` is refused for those, because a vanity
// dependency's git URL has to come from its `bit-import:` document rather than
// the command line. That made this test exit 2 (#2304). Nothing here needs a
// vanity spec: this gate covers the DIRECT path end to end, and the vanity
// path's own CLI gate is #2069.
import { env, envOr } from "std/os"
import { exists, isDir, mkdir, readFile, remove, writeFile } from "std/fs"
import { split } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// mkdir -p, iteratively (Power of 10 rule 2: bounded by the path's own
// segment count, no recursion) — compiler/pmfetch.bit has the same helper,
// but compiler/ is the compiler's own implementation and is not importable
// from a program the compiler builds, so this is a deliberate small copy,
// not a missed reuse.
fn mkdirAll(path: string): ()! {
  if (len(path) == 0 || isDir(path)) {
    return
  }
  let parts = split(path, "/")
  let acc = ""
  let i = 0
  while (i < len(parts)) {
    if (len(parts[i]) > 0) {
      acc = acc + "/" + parts[i]
      if (!isDir(acc)) {
        mkdir(acc)?
      }
    }
    i = i + 1
  }
}

// A fresh directory under a scratch root unique to this run, so repeated
// suite runs never collide on a leftover from a prior one.
fn scratchRoot(): string {
  return envOr("TMPDIR", "/tmp") + "/bit-pmadd-e2e-" + uuidFormat(uuidV4())
}

// Runs a throwaway `/bin/sh` script and returns its exit code. A script
// rather than `osRun(gitBin, args)` directly (#2399 gave `osRun` a real
// argv) — same reason compiler/pmfetch.bit's `runGit` builds a script
// instead of calling `osRun` on a bare binary path: the multi-step
// `git -C <dir> <args...>` sequences below are easier expressed as shell text
// than assembled argv-by-argv. No deadline watcher here (unlike `runGit`'s,
// which guards an untrusted network fetch): every step below is a local git
// op or this program's own compiler on a fixed local fixture, and the whole
// process is already bounded by the deleted harness `imports`'s own
// per-subprocess deadline (the deleted `proc` module, #1652).
fn runShell(script: string): int! {
  let scriptPath = scratchRoot() + ".sh"
  defer removeQuiet(scriptPath)
  writeFile(scriptPath, script)?
  return osRun("/bin/sh", [scriptPath])
}

fn removeQuiet(path: string) {
  remove(path) catch e { return }
}

// A local `file://`-fetchable git repo at `dir`, one commit deep. Three
// things pin the resulting commit — and therefore its sha, which both
// `bit add`'s confirmation line and `bit.lock` embed — to the same value on
// every run and every host this golden `expected` file diffs against: a
// fixed author/committer identity, a fixed date WITH an explicit UTC offset
// (a bare "2020-01-01T00:00:00" resolves against the host's local timezone,
// which would make the sha depend on where the suite runs), and
// `--no-gpg-sign` (some hosts' ambient git config signs commits by default,
// and a signature is not reproducible byte-for-byte across runs).
fn buildFixture(dir: string): ()! {
  let script = "#!/bin/sh\n" +
    "set -e\n" +
    "git init -q -b main '${dir}'\n" +
    "git -C '${dir}' config user.email 'pmadd-e2e@bit-lang.invalid'\n" +
    "git -C '${dir}' config user.name 'pmadd_e2e fixture'\n" +
    "echo 'pmadd_e2e fixture' > '${dir}/hello.txt'\n" +
    "git -C '${dir}' add -A\n" +
    "GIT_AUTHOR_DATE='2020-01-01T00:00:00+0000' GIT_COMMITTER_DATE='2020-01-01T00:00:00+0000' " +
    "git -C '${dir}' commit -q --no-gpg-sign -m 'pmadd_e2e fixture'\n"
  let code = runShell(script)?
  if (code != 0) {
    fail newError("pmadd_e2e: fixture setup failed (exit ${code})")
  }
}

// The project `bit add` runs against: a `bit.json` with a user comment and
// one pre-existing dependency, matching the fixture pmclicheck.bit (#1734's
// own in-Bit self-check) uses to prove the CST edit layer leaves everything
// but the new entry untouched.
fn buildProject(dir: string): ()! {
  mkdirAll(dir)?
  let bitJson = "{\n" +
    "  // pmadd_e2e project comment -- must survive untouched\n" +
    "  \"name\": \"pmadd-e2e-project\",\n" +
    "  \"dependencies\": {\n" +
    "    // existing dependency comment -- must survive untouched\n" +
    "    \"existing\": \"github.com/byteink/existing@v1.0.0\"\n" +
    "  }\n" +
    "}\n"
  writeFile(dir + "/bit.json", bitJson)?
}

fn main() {
  let selfExe = env("BIT_SELF_EXE")
  if (len(selfExe) == 0) {
    panic("pmadd_e2e: BIT_SELF_EXE is not set — the _tests_/imports harness must set it (#1767)")
  }

  let root = scratchRoot()
  mkdirAll(root) catch e {
    panic("pmadd_e2e: cannot create scratch root: " + e.message())
  }
  let fixtureDir = root + "/fixture"
  let projectDir = root + "/project"
  let home = root + "/home" // isolates `bit add`'s ~/.bit/pkg cache to this run

  buildFixture(fixtureDir) catch e {
    panic("pmadd_e2e: " + e.message())
  }
  buildProject(projectDir) catch e {
    panic("pmadd_e2e: " + e.message())
  }
  mkdirAll(home) catch e {
    panic("pmadd_e2e: cannot create scratch HOME: " + e.message())
  }

  let addScript = "#!/bin/sh\n" +
    "set -e\n" +
    "export HOME='${home}'\n" +
    "'${selfExe}' add github.com/pmadd_e2e/fixture@main --url 'file://${fixtureDir}' --dir '${projectDir}' >/dev/null\n"
  let addCode = runShell(addScript) catch e {
    panic("pmadd_e2e: " + e.message())
    -1
  }
  println("bit add exit: ${addCode}")

  let bitJson = readFile(projectDir + "/bit.json") catch e {
    panic("pmadd_e2e: cannot read updated bit.json: " + e.message())
    ""
  }
  println("--- bit.json ---")
  print(bitJson)

  let bitLock = readFile(projectDir + "/bit.lock") catch e {
    panic("pmadd_e2e: cannot read bit.lock: " + e.message())
    ""
  }
  println("--- bit.lock ---")
  print(bitLock)
  println("")
}
