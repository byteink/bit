// std/crypto trust store (#1200): build a TrustStore from a PEM bundle and
// verify a real leaf+intermediate chain against it. The fixtures are an offline
// PKI (root -> intermediate -> leaf) generated with OpenSSL and independently
// checked with `openssl verify`. Asserts: `fromPem` parses a custom root; that
// store verifies its own chain; the same leaf chains to no bundled root and is
// rejected; a leaf offered without its intermediate cannot build a path and is
// rejected; and the built-in bundled Mozilla root set loads and parses (N > 0).
// Every printed line is a boolean or a count, so the golden output is fully
// deterministic.
//
// PROVENANCE: self-generated (#1256). It covers PEM bundle loading and the
// bundled Mozilla root set, neither of which a published vector suite supplies.
// The AUTHORITATIVE path-validation KAT is `_tests_/imports/cryptox509pkits`
// (NIST PKITS 1.0.1).
import { TrustStore, fromPem, bundled, x509Parse, pemDecode, Certificate } from "std/crypto"

// A time inside every fixture's validity window (2030-01-01T00:00:00Z),
// injected so verification never depends on the wall clock.
const tsNow: int = 1893456000
const host: string = "host"

// Parse the first CERTIFICATE block of `pem` into a Certificate.
fn certOf(pem: string): Certificate! {
  let blocks = pemDecode(pem)?
  return x509Parse(blocks[0].der)?
}

// Whether `store` accepts `leaf` (through `inters`) for `host` at `tsNow`.
fn trusts(store: TrustStore, leaf: Certificate, inters: []Certificate): bool {
  store.verifyChain(leaf, inters, host, tsNow) catch e {
    return false
  }
  return true
}

fn main() { run() catch e {
  println("setup=${e.message()}")
} }

fn run(): ()! {
  let roots = fromPem(rootPem())?
  let leaf = certOf(leafPem())?
  let inter = certOf(interPem())?
  let inters = append([]Certificate(0), inter)

  // fromPem parsed exactly one root out of the bundle.
  println("fromPemRoots=${len(roots.roots)}")

  // The custom store verifies its own leaf+intermediate chain.
  println("happy=${trusts(roots, leaf, inters)}")

  // The same leaf chains to none of the bundled public roots -> rejected.
  let b = bundled()
  println("rejectUnrelated=${trusts(b, leaf, inters)}")

  // A leaf offered without its intermediate cannot build a path -> rejected.
  let noInters = []Certificate(0)
  println("rejectNoInter=${trusts(roots, leaf, noInters)}")

  // The bundled Mozilla root set loads and parses without error (N > 0).
  println("bundledRoots=${len(b.roots)}")
}

fn rootPem(): string { return "-----BEGIN CERTIFICATE-----\\n-----END CERTIFICATE-----\n" }

fn interPem(): string { return "-----BEGIN CERTIFICATE-----\\n-----END CERTIFICATE-----\n" }

fn leafPem(): string { return "-----BEGIN CERTIFICATE-----\\n-----END CERTIFICATE-----\n" }
