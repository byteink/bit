// The colliding declarations. Every parameter name here is legal and is used
// only inside its own body; nothing here may reach `main.bit`, which declares a
// function `helper` and a type `MyInt` and imports `scale` and `limit`.

fn takesParam(helper: () => string): string {
  return helper()
}

fn takesAlias(MyInt: () => string): string {
  return MyInt()
}

fn takesScale(scale: () => string): string {
  return scale()
}

fn takesLimit(limit: () => string): string {
  return limit()
}
