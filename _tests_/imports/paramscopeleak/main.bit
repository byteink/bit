// #4570: a parameter in ONE FILE of a module must not decide what a name means
// in ANOTHER file of the same module.
//
// A module's files share one node arena, and `checkModule`'s pre-pass 3 sweeps
// that whole arena writing every parameter into `Checker.env`, which is keyed by
// NAME alone. `sibling.bit`'s `takesParam(helper: () => string)` therefore owned
// the name `helper` here too: `useHelper` below was rejected with
//
//   error[E0041]: expected 'i64', found 'string'
//    --> main.bit  |  return helper(1)
//
// — a diagnostic on a correct call, in a file that never mentions the parameter
// that caused it. Nothing in the message names `sibling.bit`, which is what made
// it cost a bisect to find.
//
// `identEnvType` (compiler/checklookup.bit) reads the env through the reference
// NODE and refuses it when the resolver bound that node to a symbol whose type
// does not live in the env, so a free function declared here is typed from
// `funcResults`/`funcSigs` no matter what any file's parameters are named.
//
// The ORIGINAL report was the imported half of this: `pkg/web/static.test.bit`
// imported `run` from `std/os` while a helper two files away declared
// `ruleFailure(run: () => ()!)`, and `importName` copies an imported name's type
// into the SAME flat `env` under a bare alias, where the parameter overwrote it.
// `identEnvType` answers an imported name from the exporting module's
// `moduleEnv` instead, which no local parameter can reach.

import { limit, scale } from "./exporter"

fn helper(n: int): int {
  return n + 1
}

// A call to this file's own `helper`, resolved across the file boundary.
fn useHelper(): int {
  return helper(1)
}

// The same name taken as a VALUE rather than called: the leak typed this
// `() => string` and then rejected `f(1)` with E0050.
fn helperAsValue(): int {
  let f = helper
  return f(41)
}

type MyInt = i64

// The collision against a TYPE name declared here, reached through the
// conversion path.
fn convert(): MyInt {
  return MyInt(5)
}

// A `for` header, typed in `checkModule`'s pre-pass 3a — which runs AFTER
// pre-pass 3 has written EVERY parameter in the module into the flat env, so
// even the main sweep's per-decl rebind cannot save it. A name-keyed lookup
// here answered with `sibling.bit`'s `cb: () => string` and rejected the header
// with E0090 (`'string' iteration is not available in v0.1`).
fn sumOf(cb: () => []int): int {
  let t = 0
  for v of cb() {
    t = t + v
  }
  return t
}

// An imported FUNCTION and an imported CONST, both named by a parameter in
// `sibling.bit`. The function's type comes from `funcResults`/`funcSigs`; the
// const's from the exporting module's `moduleEnv`.
fn useImports(): int {
  return scale(limit)
}

fn main() {
  println("${useHelper()}")
  println("${useImports()}")
  println("${helperAsValue()}")
  println("${convert()}")
  println("${sumOf(() => []int{ 3, 4 })}")
  println(takesParam(() => "x"))
  println(takesAlias(() => "y"))
  println(takesScale(() => "s"))
  println(takesLimit(() => "l"))
  println(takesCb(() => "c"))
}
