// #4570: a parameter in ONE FILE of a module must not decide what a name means
// in ANOTHER file of the same module.
//
// A module's files share one node arena, and `checkModule`'s pre-pass 3 sweeps
// that whole arena writing every parameter into `Checker.env`, which is keyed by
// NAME alone. `sibling.bit`'s `takesParam(helper: () => string)` therefore owned
// the name `helper` here too: `useHelper` below was rejected with
//
//   error[E0041]: expected 'i64', found 'string'
//    --> main.bit  |  return helper(1)
//
// — a diagnostic on a correct call, in a file that never mentions the parameter
// that caused it. Nothing in the message names `sibling.bit`, which is what made
// it cost a bisect to find.
//
// `identEnvType` (compiler/checklookup.bit) reads the env through the reference
// NODE and refuses it when the resolver bound that node to a symbol whose type
// does not live in the env, so a free function declared here is typed from
// `funcResults`/`funcSigs` no matter what any file's parameters are named.

fn helper(n: int): int {
  return n + 1
}

// A call to this file's own `helper`, resolved across the file boundary.
fn useHelper(): int {
  return helper(1)
}

// The same name taken as a VALUE rather than called: the leak typed this
// `() => string` and then rejected `f(1)` with E0050.
fn helperAsValue(): int {
  let f = helper
  return f(41)
}

type MyInt = i64

// The collision against a TYPE name declared here, reached through the
// conversion path.
fn convert(): MyInt {
  return MyInt(5)
}

fn main() {
  println("${useHelper()}")
  println("${helperAsValue()}")
  println("${convert()}")
  println(takesParam(() => "x"))
  println(takesAlias(() => "y"))
}
