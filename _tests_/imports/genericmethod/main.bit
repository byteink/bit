// #2306: a method declared on a GENERIC class was invisible to an importer.
// `g.get2()` reported `E0057: no field or method 'get2' on this type` while
// `b.get()` on a non-generic class exported from the same file resolved on the
// line above — so every container method had to be rewritten as a free function
// and `s.push(1)` became `push(s, 1)`.
//
// An instantiation is keyed on the module that DECLARES the generic but minted
// by whichever module first writes `Stack<int>`; the declaring module's
// method-copy pass had already run by then and never ran again.
//
// TWO instantiations of `Stack`, with different element types, because the
// method bodies are monomorphized per instance and one of them passing says
// nothing about the other.
import { Box, GBox, Stack } from "./container"

fn main() {
  let b = Box{ v: 1 }
  println("box=${b.get()}")

  let g = GBox<int>{ v: 2 }
  println("gbox=${g.get2()}")

  let gs = GBox<string>{ v: "hi" }
  println("gboxs=${gs.get2()}")

  let s = Stack<int>{ items: [] }
  s.push(10)
  s.push(20)
  println("stack=${s.size()} top=${s.top()}")

  let w = Stack<string>{ items: [] }
  w.push("a")
  w.push("b")
  w.push("c")
  println("wstack=${w.size()} top=${w.top()}")
}
