// A generic container library with a METHOD-based API — the shape #2306 made
// impossible to publish. Every method here is reached only from `../main.bit`,
// so nothing in this module instantiates its own generics: that is the whole
// point, since an instantiation minted by the IMPORTER is what the declaring
// module's method-copy pass used to miss.
//
// `Box` is the control: a method on a NON-generic exported class always
// resolved across the edge (#1261), so if it breaks the fault is elsewhere.
export class Box {
  v: int
  export get(): int {
    return this.v
  }
}

export class GBox<T> {
  export v: T
  export get2(): T {
    return this.v
  }
}

export class Stack<T> {
  export items: []T
  export push(v: T) {
    this.items = append(this.items, v)
  }
  export size(): i64 {
    return len(this.items)
  }
  export top(): T {
    return this.items[len(this.items) - 1]
  }
}

