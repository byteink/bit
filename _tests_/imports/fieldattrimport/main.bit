// #3879 (SPEC §10.5): a class carrying field attributes declared in ONE module,
// with `validateFields()` called from ANOTHER. This is the case the feature
// exists for -- a library exports a validated type and its consumer validates
// values of it -- and it is the case an implementation can get wrong while
// every same-file fixture passes.
//
// The failures name their field (#4572): the prefix comes from the synthesis
// in the DECLARING module, so it crosses the module boundary with the method.
//
// Three things are proven here and nowhere else. The synthesized member is
// EXPORTED, so it is reachable at all across a module boundary. Its body is
// resolved in the DECLARING module: `min` and `shortEnough` are not exported
// and are not imported here, so resolving the calls against this module would
// find nothing. And an attribute ARGUMENT is a constant of the declaring
// module too -- `@min(minName)` names a const this file cannot see.
import { NewUser } from "./user"

fn report(u: NewUser) {
  u.validateFields() catch e {
    println("${e.message()}")
    return
  }
  println("ok")
}

fn main() {
  report(NewUser{ name: "ab" })
  report(NewUser{ name: "abcdefghij" })
  report(NewUser{ name: "abcd" })
}
