export const minName = 3

class validationError {
  text: string

  message(): string {
    return this.text
  }
}

// The attribute functions live HERE, in the declaring module, and are not
// exported. That is the load-bearing part: `@min` and `@shortEnough` are
// resolved where the field is DECLARED, so an importer that has never heard of
// either name still gets a working `validateFields()`. `minName` is a const of
// this module too, and the importer cannot see it.
fn min(s: string, n: int): ()! {
  if (len(s) < n) {
    fail validationError{ text: "too short" }
  }
}

fn shortEnough(s: string): ()! {
  if (len(s) > 8) {
    fail validationError{ text: "too long" }
  }
}

export class NewUser {
  @min(minName)
  @shortEnough
  export name: string
}
