// Classes reached from main.bit only through `import * as m` (#6388).
export class Counter {
  export n: i64

  export static make(n: i64): Counter {
    return Counter{ n = n }
  }

  export static scaled(a: i64, b: string): i64 {
    return a * len(b)
  }

  export static echo<U>(u: U, n: i64): U {
    return u
  }
}

export class Box<T> {
  export v: T

  export static tag(n: i64): string {
    return "box${n}"
  }
}
