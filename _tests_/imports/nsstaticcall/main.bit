// #6388: a static method called through a namespace import, `m.K.f(...)`,
// resolves like `K.f(...)` after `import { K }`: bit check accepted it for any
// arguments and the lowerer then stopped at E0092, so it never ran. Positional
// and named arguments, a static with its own type parameter, a result used as
// a value, and a generic class's static that needs no class type argument.
import * as m from "./lib"

fn main() {
  print("scaled=${m.Counter.scaled(3, "abcd")}\n")
  print("named=${m.Counter.scaled(b = "xy", a = 5)}\n")
  print("echo=${m.Counter.echo("hi", 1)}\n")
  print("make=${m.Counter.make(7).n}\n")
  print("tag=${m.Box.tag(2)}\n")
}
