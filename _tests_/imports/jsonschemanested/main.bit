// #6182: `jsonSchema<T>()`'s `$defs` closure crosses a module boundary.
// `Outer` (module `a`) holds a field of type `Inner`, declared in a
// DIFFERENT module (`b`) that `a` itself imports — `Outer`'s own document
// must carry a `$defs` entry for BOTH classes, not just its own, or the
// `"inner"` field's `$ref` dangles.
import { Outer } from "./a"
import { jsonSchema, jsonEncode } from "std/json"

fn main() {
  print("${jsonEncode(jsonSchema<Outer>())}\n")
}
