// #6182: `Inner` never calls `jsonSchema<T>()` itself and `main.bit` never
// imports this module directly — it is reached only through `a`'s own
// `inner: Inner` field, one hop away. Its `$defs` entry in `Outer`'s
// document is built by calling `__json_schema_frag_Inner()`, which nothing
// in this file writes by hand.
import { Json, JsonEntry } from "std/json"

export @json class Inner {
  value: i64,
}
