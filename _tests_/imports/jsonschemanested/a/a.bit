// #6182: `Outer` names `Inner` (module `b`, one directory over) as a plain
// field type — an ordinary named import, exactly what `a`'s own field
// declaration below needs to typecheck. `main.bit` never mentions `b` at
// all: it only ever asks for `Outer`'s schema, and `Outer`'s own module is
// what must carry the import `jsonSchema<T>()`'s cross-module `$defs`
// closure reuses (this file's header, classjsonschemacall.bit).
import { Json, JsonEntry } from "std/json"
import { Inner } from "../b"

export @json class Outer {
  id: i64,
  name: string,
  inner: Inner,
}
