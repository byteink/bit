// #4531: a generic METHOD taking `Option<T>` must lower even when a function in
// ANOTHER FILE of the same module declares a parameter with the SAME NAME.
//
// A directory module, because one file cannot reproduce it. `Checker`'s
// `declTypeNodes` was keyed by parameter NAME and flat across the module, so
// `sibling.bit`'s `other(q: int)` overwrote this file's `go(q: Option<T>)`.
// `argTypeNode` then handed `int`'s type node to the type-param binder, the
// check pass recorded `isSome`/`unwrap` at the wrong type arguments, and
// lowering — which rebound the map per function and so resolved the SAME calls
// at the RIGHT arguments — found no ledger entry and refused the program with
// `error[E0092]: cannot lower a call whose target could not be resolved`,
// pointing INTO a function that had nothing wrong with it.
//
// `Option<T>` specifically, because a `Option<T>` parameter is the one shape
// `bindTypeParamFromNode` cannot bind structurally (its `GenericInst` arm
// deliberately refuses a TEMPLATE argument), so it is the only shape that falls
// through to the name lookup. `[]T` below is the control: it binds through the
// `SliceType` arm and never reproduced.

interface Named {
  label(): string,
}

class Tag {
  export label(): string {
    return "tag"
  }
}

class Box {
  // The reported shape: `isSome`/`unwrap` over the method's own `Option<T>`.
  export go<T: Named>(q: Option<T>): string {
    if (!isSome(q)) {
      return "none"
    }
    return unwrap(q).label()
  }
  // The ticket's second rewrite: a `match` on the same parameter still fails
  // before the fix, at `t.label()`, because `T` is not substituted at all.
  export via<T: Named>(q: Option<T>): string {
    match (q) {
      Some(t) => return t.label()
      None => return "none"
    }
  }
  // Control: `[]T` in the same position, same colliding parameter name.
  export each<T: Named>(q: []T): string {
    if (len(q) == 0) {
      return "empty"
    }
    return q[0].label()
  }
}

fn main() {
  let b = Box{}
  println(b.go(Option.Some(Tag{})))
  println(b.via(Option.Some(Tag{})))
  println(b.each([Tag{}]))
  println("${other(41)}")
}
