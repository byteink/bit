// #4531: a generic METHOD taking `Option<T>` must lower even when a function in
// ANOTHER FILE of the same module declares a parameter with the SAME NAME.
//
// A directory module, because the reported shape needs two files. `Checker`'s
// `declTypeNodes` was keyed by parameter NAME and flat across the module, and
// `checkModule`'s pre-pass 3 sweeps the whole arena in ascending order — a
// module's files are one arena — so `sibling.bit`'s `other(q: int)` overwrote
// this file's `go(q: Option<T>)`. `argTypeNode` then handed `int`'s type node to
// the type-param binder, the check pass recorded `isSome(q)`/`unwrap(q)` at
// void, and lowering — which rebound the map per body, and so resolved the SAME
// calls at the RIGHT arguments — found no ledger entry and refused the program
// with `error[E0092]: cannot lower a call whose target could not be resolved`,
// pointing INTO a function that had nothing wrong with it.
//
// `Option<T>` specifically, because it is the one parameter shape that reaches
// that name lookup: `bindTypeParamFromNode`'s `GenericInst` arm deliberately
// refuses a TEMPLATE argument, so `Option<T>` falls through to the node-vs-node
// fallback. `each`'s `[]T` below is the control the ticket measured — it binds
// through the `SliceType` arm and never reproduced.

interface Named {
  label(): string,
}

class Tag {
  export label(): string {
    return "tag"
  }
}

class Box {
  // The reported shape: `isSome`/`unwrap` over the method's own `Option<T>`,
  // with the parameter named `q` — the name `sibling.bit` also uses.
  export go<T: Named>(q: Option<T>): string {
    if (!isSome(q)) {
      return "none"
    }
    return unwrap(q).label()
  }
  // Control: `[]T` in the same position, same colliding parameter name.
  export each<T: Named>(q: []T): string {
    if (len(q) == 0) {
      return "empty"
    }
    return q[0].label()
  }
}

// The same defect one layer down, and the direct one: a generic FREE function
// whose `Option<T>` argument is written as an IDENTIFIER is what actually
// consults `argTypeNode`. `v` is the second name `sibling.bit` collides with.
fn pick<T: Named>(v: Option<T>): string {
  return unwrap(v).label()
}

fn main() {
  let b = Box{}
  println(b.go(Option.Some(Tag{})))
  println(b.go(Option<Tag>.None))
  println(b.each([Tag{}]))
  let v: Option<Tag> = Option.Some(Tag{})
  println(pick(v))
  println("${other(41)}")
  println("${twice(3)}")
}
