// #2280, the shape that found it: an HTTP-router handler that locks the store
// on the route it serves and releases it with `defer`. The deferred calls were
// replayed by textual position, so serving the SECOND route ran both routes'
// `unlock()`s — one `lock()`, two `unlock()`s — and the program hung forever
// with no output and no diagnostic.
//
// A hang is what this pins, so every line printed here has to arrive: the
// harness's own timeout is the failure signal if `h` ever stops returning.
import { Mutex, newMutex } from "std/sync"

fn h(mu: Mutex, path: string): int {
  if (path == "/a") {
    mu.lock()
    defer mu.unlock()
    return 200
  }
  if (path == "/b") {
    mu.lock()
    defer mu.unlock()
    return 201
  }
  return 404
}

fn main() {
  let mu = newMutex()
  // The second route first: that is the call that used to deadlock.
  print("r=${h(mu, "/b")}\n")
  print("r=${h(mu, "/a")}\n")
  print("r=${h(mu, "/zz")}\n")
  // Reachable only if every handler above released exactly what it took.
  print("done\n")
}
