// std/crypto NIST P-256 / P-384 curve arithmetic (#1192): known-answer tests.
// Every golden coordinate is computed offline with an independent affine
// double-and-add reference (itself cross-checked against Python's `cryptography`
// EC point math) and hardcoded in the sibling `expected` file, so a miscompiled
// ladder or a wrong domain constant cannot quietly agree with itself.
//
// Coverage per curve: 2*G and 7*G against published coordinates, a large
// scalar (0x1234567890abcdef1122334455667788), `nistecScalarMult(G, 7)` matching
// the base-point path, SEC 1 uncompressed/compressed encodings, a compressed
// round trip that recovers y via sqrt, an on-curve check, rejection of a
// tampered off-curve point, and the single-byte infinity encoding.
//
// PROVENANCE: self-generated (#1256). These coordinates prove internal
// consistency and encoding behaviour only. The AUTHORITATIVE point-math KAT is
// `_tests_/imports/cryptonistecavp`, which pins NIST CAVP vectors (FIPS 186-4
// KeyPair.rsp and the SP 800-56A ECC CDH primitive file) for both curves.
import {
  Curve, Point, Nat,
  nistecP256, nistecP384,
  nistecScalarBaseMult, nistecScalarMult,
  nistecPointEncode, nistecPointDecode, nistecIsOnCurve,
  bigintFromU64, bigintFromBytes, bigintToBytes, bigintCmp,
  encodeHex, decodeHex,
} from "std/crypto"

// The `Nat` whose big-endian hex is `s`; a malformed literal degrades to zero.
fn natFromHex(s: string): Nat {
  let b = decodeHex(s) catch e {
    return bigintFromU64(0)
  }
  return bigintFromBytes(b)
}

// A field element as `w` big-endian bytes, hex-encoded; "err" if it does not fit.
fn coordHex(n: Nat, w: int): string {
  let b = bigintToBytes(n, w) catch e {
    return "err"
  }
  return encodeHex(b)
}

// The SEC 1 encoding of `p` as hex; "err" on an encoding failure.
fn encHex(c: Curve, p: Point, compressed: bool): string {
  let b = nistecPointEncode(c, p, compressed) catch e {
    return "err"
  }
  return encodeHex(b)
}

// Whether two finite points share both coordinates.
fn sameCoords(a: Point, b: Point): bool {
  return bigintCmp(a.x, b.x) == 0 && bigintCmp(a.y, b.y) == 0
}

// Whether decoding `offHex` (a tampered, off-curve point) is rejected.
fn offcurveReject(c: Curve, offHex: string): bool {
  let bytes = decodeHex(offHex) catch e {
    return false
  }
  nistecPointDecode(c, bytes) catch e {
    return true
  }
  return false
}

// Print every known-answer line for one curve, in the order `expected` fixes.
fn report(name: string, c: Curve, w: int, offHex: string) {
  let g2 = nistecScalarBaseMult(c, bigintFromU64(2))
  println("${name}_2g_x=${coordHex(g2.x, w)}")
  println("${name}_2g_y=${coordHex(g2.y, w)}")

  let g7 = nistecScalarBaseMult(c, bigintFromU64(7))
  println("${name}_7g_x=${coordHex(g7.x, w)}")
  println("${name}_7g_y=${coordHex(g7.y, w)}")

  let gk = nistecScalarBaseMult(c, natFromHex("1234567890abcdef1122334455667788"))
  println("${name}_kbig_x=${coordHex(gk.x, w)}")
  println("${name}_kbig_y=${coordHex(gk.y, w)}")

  // nistecScalarMult(G, 7) must reproduce the base-point 7*G above.
  let g1 = nistecScalarBaseMult(c, bigintFromU64(1))
  let sm = nistecScalarMult(c, g1, bigintFromU64(7)) catch e {
    println("${name}_sm7_x=err")
    println("${name}_sm7_y=err")
    return
  }
  println("${name}_sm7_x=${coordHex(sm.x, w)}")
  println("${name}_sm7_y=${coordHex(sm.y, w)}")

  println("${name}_2g_uncompressed=${encHex(c, g2, false)}")
  println("${name}_2g_compressed=${encHex(c, g2, true)}")

  // Compressed round trip: decode recovers the full (x, y) of 2*G.
  let comp = nistecPointEncode(c, g2, true) catch e {
    return
  }
  let dec = nistecPointDecode(c, comp) catch e {
    return
  }
  println("${name}_decomp_x=${coordHex(dec.x, w)}")
  println("${name}_decomp_y=${coordHex(dec.y, w)}")
  println("${name}_roundtrip=${sameCoords(dec, g2)}")

  println("${name}_oncurve=${nistecIsOnCurve(c, g2)}")
  println("${name}_offcurve_reject=${offcurveReject(c, offHex)}")

  let inf = nistecScalarBaseMult(c, bigintFromU64(0))
  println("${name}_infinity_encode=${encHex(c, inf, false)}")
}

fn main() {
  report("p256", nistecP256(), 32,
    "047cf27b188d034f7e8a52380304b51ac3c08969e277f21b35a60b48fc4766997807775510db8ed040293d9ac69f7430dbba7dade63ce982299e04b79d227873d0")
  report("p384", nistecP384(), 48,
    "0408d999057ba3d2d969260045c55b97f089025959a6f434d651d207d19fb96e9e4fe0e86ebe0e64f85b96a9c75295df618e80f1fa5b1b3cedb7bfe8dffd6dba74b275d875bc6cc43e904e505f256ab4255ffd43e94d39e22d61501e700a940e81")
}
