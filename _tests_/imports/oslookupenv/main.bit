import { lookupEnv, env, envOr } from "std/os"

fn main() {
  let mode = env("TASK8397_CASE")
  assert(mode == "absent" || mode == "empty" || mode == "value", "controlled case")
  match (lookupEnv("TASK8397_VALUE")) {
    None => assert(mode == "absent", "defined-empty must be Some")
    Some(value) => {
      assert(mode != "absent", "missing must be None")
      assert(value == (mode == "value" ? "value" : ""), "exact public value")
    }
  }
  let value = mode == "value" ? "value" : ""
  assert(env("TASK8397_VALUE") == value, "env compatibility")
  assert(
    envOr("TASK8397_VALUE", "fallback") == (mode == "value" ? "value" : "fallback"),
    "envOr compatibility",
  )
  println("PUBLIC_LOOKUP_ENV_PASS ${mode}")
}
