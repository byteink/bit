// std/crypto SHA-3 + SHAKE (#1167): the FIPS 202 / NIST CAVP known-answer
// vectors, exercised through the whole public surface. Fixed-output SHA-3 runs
// through the `Hash` interface (`digest`) and through explicit streaming
// `write`/`sum`; SHAKE runs through `absorb`/`squeeze`, including a multi-block
// squeeze and a split squeeze that must equal a single wider draw. Every hex
// line is a NIST vector, so the golden `expected` is a real conformance check.
import {
  encodeHex, digest,
  newSha3_224, newSha3_256, newSha3_384, newSha3_512,
  newShake128, newShake256,
} from "std/crypto"

// `n` copies of byte `b`.
fn repeatByte(b: u8, n: int): []byte {
  let out = []byte(n)
  let i = 0
  while (i < n) {
    out[i] = b
    i = i + 1
  }
  return out
}

fn main() {
  // Fixed-output SHA-3, one-shot through the Hash interface.
  println("sha3_224_abc=${encodeHex(digest(newSha3_224(), []byte("abc")))}")
  println("sha3_256_empty=${encodeHex(digest(newSha3_256(), []byte("")))}")
  println("sha3_256_abc=${encodeHex(digest(newSha3_256(), []byte("abc")))}")
  println("sha3_384_abc=${encodeHex(digest(newSha3_384(), []byte("abc")))}")
  println("sha3_512_abc=${encodeHex(digest(newSha3_512(), []byte("abc")))}")

  // Multi-block absorb: 200 'a' bytes span more than one 136-byte rate block.
  println("sha3_256_200a=${encodeHex(digest(newSha3_256(), repeatByte(0x61, 200)))}")

  // Streaming across two chunks must equal the one-shot digest of "abc".
  let h = newSha3_256()
  h.write([]byte("ab"))
  h.write([]byte("c"))
  println("sha3_256_stream=${encodeHex(h.sum())}")

  // SHAKE128 XOF: 32 output bytes of the empty message.
  let x = newShake128()
  x.absorb([]byte(""))
  println("shake128_empty_32=${encodeHex(x.squeeze(32))}")

  // SHAKE256 XOF: 64 output bytes of "abc".
  let y = newShake256()
  y.absorb([]byte("abc"))
  println("shake256_abc_64=${encodeHex(y.squeeze(64))}")

  // Multi-block squeeze: 200 bytes span more than one 168-byte SHAKE128 block.
  let z = newShake128()
  z.absorb([]byte(""))
  println("shake128_empty_200=${encodeHex(z.squeeze(200))}")

  // Incremental squeeze: two 16-byte draws equal a single 32-byte draw.
  let w = newShake128()
  w.absorb([]byte(""))
  let a = w.squeeze(16)
  let b = w.squeeze(16)
  println("shake128_split=${encodeHex(a)}${encodeHex(b)}")
}
