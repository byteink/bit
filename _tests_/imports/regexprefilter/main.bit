// std/regex prefilter agreement gate (#2052, epic #2025).
//
// `std/regex` has no exported switch to force the required-literal / first-
// byte prefilter off (the ticket's own constraint: "do not add any public
// API for it, including a way to disable it") and this program cannot set
// its OWN environment variable (`std/os` has `env`/`envOr`, no `setEnv`).
// So it relaunches itself through `/usr/bin/env` with
// `BIT_REGEX_PREFILTER_SELFCHECK=1` set for the CHILD — `std/regex`'s
// `compile()` reads that internal, undocumented flag once per pattern and,
// when set, makes every `matches`/`find`/`findAll` call in the child ALSO
// run the reference (prefilter-off) path and panic on any disagreement
// between the two (`regex.bit`'s `searchRegex`/`assertPrefilterAgrees`).
//
// So this corpus needs no dual-run comparison logic of its own: agreement
// is enforced by the library itself, on every single search call the
// corpus below makes, not just the ones it happens to print. A prefilter
// bug shows up as the child panicking (nonzero exit), which the parent
// turns into its own panic; the corpus's own printed lines only need to be
// deterministic, for `expected` to diff cleanly.
//
// `run`'s child inherits this process's stdout (`std/os`'s own doc
// comment), so the child's `println` output lands directly in this
// program's own stdout, ahead of the parent's closing line — same
// convention as `_tests_/imports/osrun/main.bit`.
import { mustCompile, Regex, Match } from "std/regex"
import { run, env, selfExe } from "std/os"

fn main() {
  if (len(env("BIT_REGEX_PREFILTER_SELFCHECK")) > 0) {
    runCorpus()
    return
  }
  let code = run("/usr/bin/env", ["BIT_REGEX_PREFILTER_SELFCHECK=1", selfExe()])
  if (code != 0) {
    panic("regexprefilter: self-check child exited ${code} — a prefilter disagreement panicked inside it")
  }
  println("regexprefilter: self-check child exited 0")
}

// One case per pattern class the ticket names: a required prefix, a
// required substring with a known backoff, a required substring with an
// UNKNOWN backoff (falls back to a full scan per the ticket's own "fall
// back to scanning from the start" rule), a first-byte set with no usable
// literal, a fully unfiltered pattern, an anchored pattern, a
// case-insensitive pattern (folds to `Ast.Class`, never `Ast.Literal` —
// `parse.bit`'s `literalAst`), a multi-byte UTF-8 literal, a literal that
// occurs many times in the subject, and a literal that never occurs.
fn runCorpus() {
  check(mustCompile("foo.*bar"), "xxfooXXXbarYY") // required prefix
  check(mustCompile("foo.*bar"), "no match here")
  check(mustCompile("(cat|cow)food"), "the cowfood is here") // required substring, known backoff
  check(mustCompile("(cat|cow)food"), "the catfood is here")
  check(mustCompile("(cat|cow)food"), "no match")
  check(mustCompile("a.*bc"), "aXXXXbc") // required substring, unknown backoff
  check(mustCompile("a.*bc"), "no bc here, only a")
  check(mustCompile("[abc]\\d+"), "z9 a42 b7 c123") // first-byte set, no literal run
  check(mustCompile(".*"), "anything goes")         // no usable literal at all
  check(mustCompile("^abc$"), "abc")                // anchored
  check(mustCompile("^abc$"), "xabc")
  check(mustCompile("(?i)abc"), "XXABCyy") // case-insensitive: folds to a byte set
  check(mustCompile("(?i)abc"), "xxx")
  check(mustCompile("café"), "un café chaud") // multi-byte UTF-8 literal
  check(mustCompile("café"), "no match here")
  check(mustCompile("ab"), "ababab")              // literal occurs many times
  check(mustCompile("zzz"), "no such thing here") // literal never occurs
  println("regexprefilter: corpus complete")
}

fn check(re: Regex, subject: string) {
  let m = re.matches(subject)
  let f = re.find(subject)
  let allCount = len(re.findAll(subject, -1))
  println("pattern=${re.pattern()} subject=${subject} matches=${m} find=${describeMatch(f)} allCount=${allCount}")
}

fn describeMatch(m: Option<Match>): string {
  if (isNone(m)) {
    return "none"
  }
  let mm = unwrap(m)
  return "[${mm.start},${mm.end})"
}
