// std/crypto ChaCha20-Poly1305 + XChaCha20-Poly1305 AEAD (#1183): the RFC 8439
// §2.8 and draft-irtf-cfrg-xchacha known-answer vectors, hex-compared via
// encodeHex. Covers the §2.8.2 seal (ciphertext‖tag), the §A.5 decryption
// vector, and one XChaCha20-Poly1305 vector (verified against libsodium). For
// each construction it checks seal, open-success (plaintext round-trips), and
// open-of-a-tampered-tag (must reject, never return plaintext), plus a
// round-trip through the `Aead` interface. Every output is deterministic, so the
// golden `expected` is stable; a wrong Poly1305 carry, a wrong ChaCha20 counter,
// or a broken constant-time tag check would corrupt exactly these lines.
//
// The tampered-tag checks use a `catch` on the *concrete* cipher type, not an
// `Aead`-typed value, and the interface round-trip only passes the concrete
// value into an `Aead` parameter — both avoid the interface-widening-across-
// control-flow crash (#1233).
import { ChaChaPoly, XChaChaPoly, newChaChaPoly, newXChaChaPoly, Aead, encodeHex, decodeHex } from "std/crypto"

// A fresh copy of `b` with the byte at `idx` flipped — a one-bit-tampered blob.
fn flip1(b: []byte, idx: int): []byte {
  let out = []byte(len(b))
  let i = 0
  while (i < len(b)) {
    out[i] = b[i]
    i = i + 1
  }
  out[idx] = out[idx] ^ 1
  return out
}

// Whether ChaCha20-Poly1305 `open` accepts `ct` (true) or rejects it (false).
// The receiver is the concrete type, so this `catch` is safe.
fn openOk(c: ChaChaPoly, nonce: []byte, ct: []byte, aad: []byte): bool {
  let pt = c.open(nonce, ct, aad) catch e {
    return false
  }
  return true
}

// The XChaCha20-Poly1305 counterpart of `openOk`.
fn xopenOk(c: XChaChaPoly, nonce: []byte, ct: []byte, aad: []byte): bool {
  let pt = c.open(nonce, ct, aad) catch e {
    return false
  }
  return true
}

// Seal then open through an `Aead`-typed parameter, returning the recovered
// plaintext. Proves the concrete cipher satisfies the interface; passing a
// concrete value into an `Aead` parameter and dispatching is the safe form.
fn viaAead(a: Aead, nonce: []byte, pt: []byte, aad: []byte): []byte! {
  let sealed = a.seal(nonce, pt, aad)
  return a.open(nonce, sealed, aad)?
}

fn run(): ()! {
  let pt = []byte(
    "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.",
  )

  // RFC 8439 §2.8.2 — ChaCha20-Poly1305 seal known-answer.
  let key = decodeHex("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")?
  let nonce = decodeHex("070000004041424344454647")?
  let aad = decodeHex("50515253c0c1c2c3c4c5c6c7")?
  let c = newChaChaPoly(key)?
  let sealed = c.seal(nonce, pt, aad)
  println("rfc282seal=${encodeHex(sealed)}")

  // open recovers the plaintext exactly ...
  let opened = c.open(nonce, sealed, aad)?
  println("rfc282open=${encodeHex(opened) == encodeHex(pt)}")

  // ... and rejects a one-byte-tampered tag.
  println("rfc282tamper=${openOk(c, nonce, flip1(sealed, len(sealed) - 1), aad)}")

  // Round-trip through the `Aead` interface parameter.
  let rt = viaAead(c, nonce, pt, aad)?
  println("rfc282via=${encodeHex(rt) == encodeHex(pt)}")

  // RFC 8439 §A.5 — decryption vector: open a known ciphertext‖tag, then reject
  // a tampered tag.
  let a5key = decodeHex("1c9240a5eb55d38af333888604f6b5f0473917c1402b80099dca5cbc207075c0")?
  let a5nonce = decodeHex("000000000102030405060708")?
  let a5aad = decodeHex("f33388860000000000004e91")?
  let a5full = decodeHex(
    "",
  )?
  let c5 = newChaChaPoly(a5key)?
  let a5pt = c5.open(a5nonce, a5full, a5aad)?
  println("a5open=${encodeHex(a5pt)}")
  println("a5tamper=${openOk(c5, a5nonce, flip1(a5full, len(a5full) - 1), a5aad)}")

  // XChaCha20-Poly1305 — draft-irtf-cfrg-xchacha §A.3.1 (24-byte nonce). Verified
  // against libsodium's crypto_aead_xchacha20poly1305_ietf.
  let xkey = decodeHex("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")?
  let xnonce = decodeHex("404142434445464748494a4b4c4d4e4f5051525354555657")?
  let xaad = decodeHex("50515253c0c1c2c3c4c5c6c7")?
  let xc = newXChaChaPoly(xkey)?
  let xsealed = xc.seal(xnonce, pt, xaad)
  println("xseal=${encodeHex(xsealed)}")
  let xopened = xc.open(xnonce, xsealed, xaad)?
  println("xopen=${encodeHex(xopened) == encodeHex(pt)}")
  println("xtamper=${xopenOk(xc, xnonce, flip1(xsealed, len(xsealed) - 1), xaad)}")
  let xrt = viaAead(xc, xnonce, pt, xaad)?
  println("xvia=${encodeHex(xrt) == encodeHex(pt)}")
}

fn main() { run() catch e {
  println("failed: ${e.message()}")
} }
