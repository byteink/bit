// std/crypto NIST P-256 / P-384 point arithmetic: known-answer tests against
// AUTHORITATIVE, PUBLISHED NIST vectors (#1256). The sibling `cryptonistec`
// suite pins self-derived coordinates, which can only prove the implementation
// agrees with itself; every vector below is transcribed verbatim from a NIST
// Cryptographic Algorithm Validation Program (CAVP) response file, so a wrong
// ladder, a wrong domain constant or a wrong field reduction cannot pass.
//
// Sources, pinned into this file (never fetched at test time):
//
//  1. NIST CAVP, FIPS 186-4 ECDSA test vectors, `186-3ecdsatestvectors.zip`,
//     file `KeyPair.rsp` (CAVS 11.0, generated 2011-03-16), sections [P-256]
//     and [P-384], subsection "B.4.2 Key Pair Generation by Testing
//     Candidates". Each record gives a private scalar `d` and the public point
//     Q = d*G. Exercises `nistecScalarBaseMult` over full-width scalars.
//     https://csrc.nist.gov/Projects/cryptographic-algorithm-validation-program/digital-signatures
//
//  2. NIST CAVP, ECC CDH Primitive component test (SP 800-56A section 5.7.1.2),
//     `ecccdhtestvectors.zip`, file `KAS_ECC_CDH_PrimitiveTest.txt` (CAVS 14.1,
//     generated 2012-11-19), sections [P-256] and [P-384]. Each COUNT gives a
//     peer public point (QCAVSx, QCAVSy), an IUT scalar dIUT with its public
//     point QIUTx, and ZIUT = the x-coordinate of dIUT * QCAVS. Exercises
//     `nistecPointDecode` and `nistecScalarMult` on an ARBITRARY point (not the
//     base point), which is the path `nistecScalarBaseMult` alone never covers.
//     https://csrc.nist.gov/Projects/cryptographic-algorithm-validation-program/component-testing
//
// The ECDH layer above this already uses source 2 at COUNT=0; this extends the
// same provenance down onto the raw point math and widens it to 10 records per
// curve per source.
import {
  Curve, Point, Nat,
  nistecP256, nistecP384,
  nistecScalarBaseMult, nistecScalarMult, nistecPointDecode, nistecIsOnCurve,
  bigintFromBytes, bigintToBytes,
  encodeHex, decodeHex,
} from "std/crypto"

// The `Nat` whose big-endian hex is `s`; a malformed literal degrades to a zero
// scalar, which cannot accidentally match any vector.
fn natOf(s: string): Nat! {
  return bigintFromBytes(decodeHex(s)?)
}

// A field element as `w` big-endian bytes, hex-encoded, so it compares byte-for
// -byte against the fixed-width CAVP text.
fn coordHex(n: Nat, w: int): string! {
  return encodeHex(bigintToBytes(n, w)?)
}

// "ok" when the affine point `p` is exactly (xHex, yHex); otherwise the actual
// coordinates, so a failure names the wrong value instead of just a boolean.
fn matchPoint(p: Point, xHex: string, yHex: string, w: int): string! {
  let gx = coordHex(p.x, w)?
  let gy = coordHex(p.y, w)?
  if (gx == xHex && gy == yHex) {
    return "ok"
  }
  return "FAIL got=${gx},${gy} want=${xHex},${yHex}"
}

// KeyPair.rsp: assert Q == d*G for every record. `vs` is flattened as
// (d, Qx, Qy) triples.
fn keypairVectors(name: string, c: Curve, w: int, vs: []string): ()! {
  let i = 0
  while (i + 2 < len(vs)) {
    let q = nistecScalarBaseMult(c, natOf(vs[i])?)
    println("${name}_keypair_${i / 3}=${matchPoint(q, vs[i + 1], vs[i + 2], w)?}")
    i = i + 3
  }
}

// KAS_ECC_CDH_PrimitiveTest.txt: for every COUNT, decode the peer point from its
// SEC 1 uncompressed encoding, confirm it is on the curve, then assert both
// dIUT*G == QIUT (base-point path) and x(dIUT*QCAVS) == ZIUT (arbitrary-point
// path). `vs` is flattened as (QCAVSx, QCAVSy, dIUT, QIUTx, ZIUT) quintuples.
fn cdhVectors(name: string, c: Curve, w: int, vs: []string): ()! {
  let i = 0
  while (i + 4 < len(vs)) {
    let n = i / 5
    let peer = nistecPointDecode(c, decodeHex("04${vs[i]}${vs[i + 1]}")?)?
    if (!nistecIsOnCurve(c, peer)) {
      println("${name}_cdh_${n}=FAIL peer point rejected as off-curve")
      i = i + 5
      continue
    }
    let d = natOf(vs[i + 2])?
    let mine = nistecScalarBaseMult(c, d)
    let pub = coordHex(mine.x, w)?
    let shared = nistecScalarMult(c, peer, d)?
    let z = coordHex(shared.x, w)?
    if (pub == vs[i + 3] && z == vs[i + 4]) {
      println("${name}_cdh_${n}=ok")
    } else {
      println("${name}_cdh_${n}=FAIL qiutx=${pub} z=${z} want qiutx=${vs[i + 3]} z=${vs[i + 4]}")
    }
    i = i + 5
  }
}

fn main() {
  run() catch e {
    println("setup=${e.message()}")
  }
}

fn run(): ()! {
  keypairVectors("p256", nistecP256(), 32, p256Keypair())?
  cdhVectors("p256", nistecP256(), 32, p256Cdh())?
  keypairVectors("p384", nistecP384(), 48, p384Keypair())?
  cdhVectors("p384", nistecP384(), 48, p384Cdh())?
}

