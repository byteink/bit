// std/regex capture groups: `(?:...)`, both named-group spellings
// (`(?<name>...)`/`(?P<name>...)`), `Match.group`/`.named`, and
// `Regex.groupNames` (#2029).
//
// Every expected value below was checked against real Go 1.27's `regexp`
// package (`go run`, `regexp.MustCompile(...).FindStringSubmatchIndex`/
// `.SubexpNames`), not against this implementation — captures follow the
// same leftmost-first, "last iteration wins inside a repeat", and
// participated-vs-empty rules Go documents for `regexp/syntax`.
//
// `groups` prints `Regex.groupNames()` as `[name,name,...]` (an unnamed
// group renders as an empty field between commas, so the count is still
// visible). `group` prints `Match.group(i)` as `i:start,end,text` or
// `i:None`; `named` is the same shape for `Match.named(name)`. `checkErr`
// prints "ok <pattern>" for a pattern that compiles, or the compile error's
// message otherwise (same shape as _tests_/imports/regexsyntax's `check`).

import { compile, mustCompile, Match } from "std/regex"
import { join } from "std/strings"

fn groups(pattern: string): string {
  let re = mustCompile(pattern)
  return "[" + join(re.groupNames(), ",") + "]"
}

fn group(m: Match, i: int, s: string): string {
  return match (m.group(i)) {
    Some(g) => "${i}:${g.start},${g.end},${g.text(s)}"
    None => "${i}:None"
  }
}

// Prints `group(i)` for every `i` from 0 through `re`'s own `groupCount()`,
// space-separated — bounded by `re.groupCount()`, fixed per pattern at
// compile time.
fn allGroups(pattern: string, s: string): string {
  let re = mustCompile(pattern)
  let found = re.find(s)
  if (isNone(found)) {
    return "no match"
  }
  let m = unwrap(found)
  let out = ""
  let i = 0
  while (i <= re.groupCount()) {
    if (len(out) > 0) {
      out = out + " "
    }
    out = out + group(m, i, s)
    i = i + 1
  }
  return out
}

fn named(pattern: string, s: string, name: string): string {
  let re = mustCompile(pattern)
  return match (re.find(s)) {
    Some(m) => match (m.named(name)) {
      Some(g) => "${name}:${g.start},${g.end},${g.text(s)}"
      None => "${name}:None"
    }
    None => "no match"
  }
}

fn checkErr(pattern: string) {
  let re = compile(pattern) catch e {
    println(e.message())
    return
  }
  println("ok ${pattern}")
}

fn main() {
  numbering()
  nonCapturing()
  namedSpellings()
  duplicateNames()
  unknownAndOutOfRange()
  repeatedGroups()
  alternationParticipation()
  emptyMatchGroup()
  mixedGroupNames()
}

// Group numbering is by the position of the opening paren, left to right:
// `((a)(b))` is outer=1, `(a)`=2, `(b)`=3 (ticket's own worked example).
fn numbering() {
  println(allGroups("((a)(b))", "ab"))
  println(groups("((a)(b))"))
}

// `(?:...)` allocates no index and no slot: `groupCount()`/`groupNames()`
// see only the real capturing group, and its own index is 1, not 2.
fn nonCapturing() {
  println(allGroups("(?:a)(b)", "ab"))
  println(groups("(?:a)(b)"))
}

// `(?<name>...)` and `(?P<name>...)` on the same pattern shape produce
// identical `.named()` output — the two spellings mean exactly the same
// thing.
fn namedSpellings() {
  println(named("(?<year>[0-9]{4})-(?P<month>[0-9]{2})", "2026-08", "year"))
  println(named("(?<year>[0-9]{4})-(?P<month>[0-9]{2})", "2026-08", "month"))
  println(named("(?P<year>[0-9]{4})-(?<month>[0-9]{2})", "2026-08", "year"))
  println(named("(?P<year>[0-9]{4})-(?<month>[0-9]{2})", "2026-08", "month"))
}

// A duplicate name is rejected regardless of which spelling either
// occurrence uses — same spelling twice, or one of each, in either order.
// Two distinct names is fine.
fn duplicateNames() {
  checkErr("(?<n>a)(?<n>b)")
  checkErr("(?P<n>a)(?P<n>b)")
  checkErr("(?<n>a)(?P<n>b)")
  checkErr("(?P<n>a)(?<n>b)")
  checkErr("(?<a>x)(?P<b>y)")
}

// An unknown name and an out-of-range (including negative) index both
// return `None` rather than panicking.
fn unknownAndOutOfRange() {
  println(named("(?<n>a)", "a", "nope"))
  let re = mustCompile("(a)")
  let found = re.find("a")
  if (isNone(found)) {
    return
  }
  let m = unwrap(found)
  println(group(m, 5, "a"))
  println(group(m, -1, "a"))
}

// A group inside `*`/a counted repeat reports its LAST iteration's span,
// not its first or a union of all of them — Go's documented behavior, since
// a repeated capture has exactly one slot pair, overwritten on every pass.
// `(a)(b){3}` in particular must not let the repeat's three unrolled copies
// of `(b)` alias group 1's slot: group 1 stays "a" at [0,1) regardless.
fn repeatedGroups() {
  println(allGroups("(a){3}", "aaa"))
  println(allGroups("(a)(b){3}", "abbb"))
  println(allGroups("((a)(b)){2}", "abab"))
}

// `(a)|(b)` against "b": the first branch's group never ran (`None`), not a
// reported empty match at offset 0 — the distinction this ticket exists to
// get right.
fn alternationParticipation() {
  println(allGroups("(a)|(b)", "b"))
  println(allGroups("(a)|(b)", "a"))
}

// A group that DID participate but matched the empty string is
// `Option.Some` with `start == end` — never conflated with a group that did
// not participate at all.
fn emptyMatchGroup() {
  println(allGroups("(a*)", ""))
}

// `groupNames()` for a pattern mixing named and unnamed capturing groups,
// in index order.
fn mixedGroupNames() {
  println(groups("(a)(?<mid>b)(c)(?:d)(?P<tail>e)"))
}
