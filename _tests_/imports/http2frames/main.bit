// std/http2 frame-layer known-answer tests (RFC 7540 / 9113).
//
// Two halves. First, every frame type is encoded, parsed back out with
// `readFrame`, and the round-tripped value is asserted field-for-field — covering
// the 9-byte header, each frame's flags, DATA/HEADERS/PUSH_PROMISE padding, the
// HEADERS priority section, and the SETTINGS parameter list. Second, a battery of
// deliberately malformed inputs is fed to the decoders and each must be rejected:
// a length over `SETTINGS_MAX_FRAME_SIZE`, a truncated payload, a SETTINGS length
// that is not a multiple of 6, a connection-level frame on a non-zero stream, a
// stream-level frame on stream 0, padding at least the size of the payload, and a
// wrong fixed length. Each check prints one `PASS` line.
import {
  Frame,
  FrameHeader,
  readFrame,
  encodeFrameHeader,
  decodeFrameHeader,
  DataFrame,
  encodeData,
  decodeData,
  HeadersFrame,
  encodeHeaders,
  decodeHeaders,
  PriorityFrame,
  encodePriority,
  decodePriority,
  RstStreamFrame,
  encodeRstStream,
  decodeRstStream,
  Setting,
  SettingsFrame,
  encodeSettings,
  decodeSettings,
  PushPromiseFrame,
  encodePushPromise,
  decodePushPromise,
  PingFrame,
  encodePing,
  decodePing,
  GoawayFrame,
  encodeGoaway,
  decodeGoaway,
  WindowUpdateFrame,
  encodeWindowUpdate,
  decodeWindowUpdate,
  ContinuationFrame,
  encodeContinuation,
  decodeContinuation,
  defaultMaxFrameSize,
  frameData,
  frameSettings,
  framePriority,
  settingsMaxFrameSize,
  settingsInitialWindowSize,
  errorProtocolError,
  errorEnhanceYourCalm,
  flagEndStream,
} from "std/http2"

fn report(tag: string, ok: bool) {
  if (ok) {
    println(tag + " PASS")
    return
  }
  println(tag + " FAIL")
}

fn bytesEqual(a: []byte, b: []byte): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

fn checkData() {
  let enc = encodeData(
    DataFrame{ streamId: 3, data: []byte("hello"), endStream: true, padLength: 4 },
  ) catch e {
    report("data", false)
    return
  }
  let fr = readFrame(enc, defaultMaxFrameSize) catch e {
    report("data", false)
    return
  }
  let f = decodeData(fr) catch e {
    report("data", false)
    return
  }
  report(
    "data",
    f.streamId == 3 && bytesEqual(f.data, []byte("hello")) && f.endStream && f.padLength == 4,
  )
}

fn checkHeaders() {
  let enc = encodeHeaders(
    HeadersFrame{
      streamId: 1,
      blockFragment: []byte("BLOCK"),
      endStream: false,
      endHeaders: true,
      padLength: 2,
      hasPriority: true,
      exclusive: true,
      streamDependency: 7,
      weight: 200,
    },
  ) catch e {
    report("headers", false)
    return
  }
  let fr = readFrame(enc, defaultMaxFrameSize) catch e {
    report("headers", false)
    return
  }
  let f = decodeHeaders(fr) catch e {
    report("headers", false)
    return
  }
  report("headers", headersMatch(f))
}

// Every HEADERS field checkHeaders' fixture round-trips, as one boolean --
// pulled out of checkHeaders so its 8-way `&&` doesn't count against that
// function's complexity (E0204, checkHeaders was 12, limit 10).
fn headersMatch(f: HeadersFrame): bool {
  return f.streamId == 1 &&
    bytesEqual(f.blockFragment, []byte("BLOCK")) &&
    !f.endStream &&
    f.endHeaders &&
    f.padLength == 2 &&
    f.hasPriority &&
    f.exclusive &&
    f.streamDependency == 7 &&
    f.weight == 200
}

fn checkHeadersPlain() {
  let enc = encodeHeaders(
    HeadersFrame{
      streamId: 5,
      blockFragment: []byte("H"),
      endStream: true,
      endHeaders: true,
      padLength: -1,
      hasPriority: false,
      exclusive: false,
      streamDependency: 0,
      weight: 0,
    },
  ) catch e {
    report("headers-plain", false)
    return
  }
  let fr = readFrame(enc, defaultMaxFrameSize) catch e {
    report("headers-plain", false)
    return
  }
  let f = decodeHeaders(fr) catch e {
    report("headers-plain", false)
    return
  }
  report(
    "headers-plain",
      f.streamId == 5 &&
      bytesEqual(f.blockFragment, []byte("H")) &&
      f.endStream &&
      f.endHeaders &&
      f.padLength == -1 &&
      !f.hasPriority,
  )
}

fn checkPriority() {
  let enc = encodePriority(
    PriorityFrame{ streamId: 5, exclusive: false, streamDependency: 3, weight: 15 },
  ) catch e {
    report("priority", false)
    return
  }
  let fr = readFrame(enc, defaultMaxFrameSize) catch e {
    report("priority", false)
    return
  }
  let f = decodePriority(fr) catch e {
    report("priority", false)
    return
  }
  report("priority", f.streamId == 5 && !f.exclusive && f.streamDependency == 3 && f.weight == 15)
}

fn checkRstStream() {
  let enc = encodeRstStream(RstStreamFrame{ streamId: 9, errorCode: errorProtocolError }) catch e {
    report("rst_stream", false)
    return
  }
  let fr = readFrame(enc, defaultMaxFrameSize) catch e {
    report("rst_stream", false)
    return
  }
  let f = decodeRstStream(fr) catch e {
    report("rst_stream", false)
    return
  }
  report("rst_stream", f.streamId == 9 && f.errorCode == errorProtocolError)
}

fn checkSettings() {
  let list = []Setting{
    Setting{ id: settingsMaxFrameSize, value: 16384 },
    Setting{ id: settingsInitialWindowSize, value: 65535 },
  }
  let enc = encodeSettings(SettingsFrame{ ack: false, settings: list }) catch e {
    report("settings", false)
    return
  }
  let fr = readFrame(enc, defaultMaxFrameSize) catch e {
    report("settings", false)
    return
  }
  let f = decodeSettings(fr) catch e {
    report("settings", false)
    return
  }
  report(
    "settings",
      !f.ack &&
      len(f.settings) == 2 &&
      f.settings[0].id == settingsMaxFrameSize &&
      f.settings[0].value == 16384 &&
      f.settings[1].id == settingsInitialWindowSize &&
      f.settings[1].value == 65535,
  )
}

fn checkSettingsAck() {
  let enc = encodeSettings(SettingsFrame{ ack: true, settings: []Setting(0) }) catch e {
    report("settings-ack", false)
    return
  }
  let fr = readFrame(enc, defaultMaxFrameSize) catch e {
    report("settings-ack", false)
    return
  }
  let f = decodeSettings(fr) catch e {
    report("settings-ack", false)
    return
  }
  report("settings-ack", f.ack && len(f.settings) == 0)
}

fn checkPushPromise() {
  let enc = encodePushPromise(
    PushPromiseFrame{
      streamId: 1,
      promisedStreamId: 2,
      blockFragment: []byte("PP"),
      endHeaders: true,
      padLength: 3,
    },
  ) catch e {
    report("push_promise", false)
    return
  }
  let fr = readFrame(enc, defaultMaxFrameSize) catch e {
    report("push_promise", false)
    return
  }
  let f = decodePushPromise(fr) catch e {
    report("push_promise", false)
    return
  }
  report(
    "push_promise",
      f.streamId == 1 &&
      f.promisedStreamId == 2 &&
      bytesEqual(f.blockFragment, []byte("PP")) &&
      f.endHeaders &&
      f.padLength == 3,
  )
}

fn checkPing() {
  let enc = encodePing(PingFrame{ ack: false, data: []byte("12345678") }) catch e {
    report("ping", false)
    return
  }
  let fr = readFrame(enc, defaultMaxFrameSize) catch e {
    report("ping", false)
    return
  }
  let f = decodePing(fr) catch e {
    report("ping", false)
    return
  }
  report("ping", !f.ack && bytesEqual(f.data, []byte("12345678")))
}

fn checkGoaway() {
  let enc = encodeGoaway(
    GoawayFrame{
      lastStreamId: 42,
      errorCode: errorEnhanceYourCalm,
      debugData: []byte("slow down"),
    },
  ) catch e {
    report("goaway", false)
    return
  }
  let fr = readFrame(enc, defaultMaxFrameSize) catch e {
    report("goaway", false)
    return
  }
  let f = decodeGoaway(fr) catch e {
    report("goaway", false)
    return
  }
  report(
    "goaway",
      f.lastStreamId == 42 &&
      f.errorCode == errorEnhanceYourCalm &&
      bytesEqual(f.debugData, []byte("slow down")),
  )
}

fn checkWindowUpdate() {
  let enc = encodeWindowUpdate(WindowUpdateFrame{ streamId: 0, increment: 65535 }) catch e {
    report("window_update", false)
    return
  }
  let fr = readFrame(enc, defaultMaxFrameSize) catch e {
    report("window_update", false)
    return
  }
  let f = decodeWindowUpdate(fr) catch e {
    report("window_update", false)
    return
  }
  report("window_update", f.streamId == 0 && f.increment == 65535)
}

fn checkContinuation() {
  let enc = encodeContinuation(
    ContinuationFrame{ streamId: 1, blockFragment: []byte("CONT"), endHeaders: false },
  ) catch e {
    report("continuation", false)
    return
  }
  let fr = readFrame(enc, defaultMaxFrameSize) catch e {
    report("continuation", false)
    return
  }
  let f = decodeContinuation(fr) catch e {
    report("continuation", false)
    return
  }
  report(
    "continuation",
    f.streamId == 1 && bytesEqual(f.blockFragment, []byte("CONT")) && !f.endHeaders,
  )
}

// The 9-byte header alone round-trips through encode/decode.
fn checkHeader() {
  let enc = encodeFrameHeader(
    FrameHeader{ length: 300, ftype: frameData, flags: flagEndStream, streamId: 2147483647 },
  ) catch e {
    report("header", false)
    return
  }
  let back = decodeFrameHeader(enc) catch e {
    report("header", false)
    return
  }
  report(
    "header",
      back.length == 300 &&
      back.ftype == frameData &&
      back.flags == flagEndStream &&
      back.streamId == 2147483647,
  )
}

// A frame whose declared length exceeds the max frame size must be rejected.
fn rejectOversize() {
  let b = []byte(9)
  b[1] = 0x4e
  b[2] = 0x20
  readFrame(b, defaultMaxFrameSize) catch e {
    report("reject-oversize", true)
    return
  }
  report("reject-oversize", false)
}

// A frame header promising more payload than the buffer holds must be rejected.
fn rejectTruncated() {
  let b = []byte(9)
  b[2] = 0x10
  readFrame(b, defaultMaxFrameSize) catch e {
    report("reject-truncated", true)
    return
  }
  report("reject-truncated", false)
}

// A SETTINGS payload whose length is not a multiple of 6 must be rejected.
fn rejectSettingsLen() {
  let b = []byte(14)
  b[2] = 0x05
  b[3] = byte(frameSettings)
  let f = readFrame(b, defaultMaxFrameSize) catch e {
    report("reject-settings-len", false)
    return
  }
  decodeSettings(f) catch e2 {
    report("reject-settings-len", true)
    return
  }
  report("reject-settings-len", false)
}

// SETTINGS is a connection-level frame; on a non-zero stream it must be rejected.
fn rejectSettingsStream() {
  let b = []byte(9)
  b[3] = byte(frameSettings)
  b[8] = 0x01
  let f = readFrame(b, defaultMaxFrameSize) catch e {
    report("reject-settings-stream", false)
    return
  }
  decodeSettings(f) catch e2 {
    report("reject-settings-stream", true)
    return
  }
  report("reject-settings-stream", false)
}

// DATA is a stream-level frame; on stream 0 it must be rejected.
fn rejectDataStreamZero() {
  encodeData(DataFrame{ streamId: 0, data: []byte("x"), endStream: false, padLength: -1 }) catch e {
    report("reject-data-stream0", true)
    return
  }
  report("reject-data-stream0", false)
}

// A DATA frame whose pad length is at least the payload size must be rejected.
fn rejectPadding() {
  let b = []byte(12)
  b[2] = 0x03
  b[3] = byte(frameData)
  b[4] = 0x08
  b[8] = 0x03
  b[9] = 0x05
  let f = readFrame(b, defaultMaxFrameSize) catch e {
    report("reject-padding", false)
    return
  }
  decodeData(f) catch e2 {
    report("reject-padding", true)
    return
  }
  report("reject-padding", false)
}

// A PRIORITY frame whose payload is not exactly 5 bytes must be rejected.
fn rejectPriorityLen() {
  let b = []byte(13)
  b[2] = 0x04
  b[3] = byte(framePriority)
  b[8] = 0x01
  let f = readFrame(b, defaultMaxFrameSize) catch e {
    report("reject-priority-len", false)
    return
  }
  decodePriority(f) catch e2 {
    report("reject-priority-len", true)
    return
  }
  report("reject-priority-len", false)
}

fn main() {
  checkHeader()
  checkData()
  checkHeaders()
  checkHeadersPlain()
  checkPriority()
  checkRstStream()
  checkSettings()
  checkSettingsAck()
  checkPushPromise()
  checkPing()
  checkGoaway()
  checkWindowUpdate()
  checkContinuation()
  rejectOversize()
  rejectTruncated()
  rejectSettingsLen()
  rejectSettingsStream()
  rejectDataStreamZero()
  rejectPadding()
  rejectPriorityLen()
}
