// TCP over green threads (#353): a server accepting on a kernel-chosen port and
// clients dialling it. Every step that would block parks on the netpoller
// instead of blocking an OS thread.
import { listen, dial, Listener, Conn } from "std/net"
import { toUpper } from "std/strings"

// Read one request, shout it back, close. An empty read means the peer is gone.
fn handle(c: Conn, done: chan<int>) {
  let req = c.read(4096)
  if (len(req) == 0) {
    c.close()
    done <- 0
    return
  }
  c.write(toUpper(req)) catch e {
    println("write: ${e.message()}")
    c.close()
    done <- 0
    return
  }
  c.close()
  done <- len(req)
}

fn acceptOne(l: Listener, done: chan<int>): ()! {
  let c = l.accept()?
  // One green thread per connection: a slow client cannot delay the next accept.
  spawn handle(c, done)
}

fn serve(l: Listener, n: int, done: chan<int>) {
  let i = 0
  while (i < n) {
    acceptOne(l, done) catch e {
      println("accept: ${e.message()}")
      return
    }
    i = i + 1
  }
}

// One request, one response, over a fresh connection.
fn roundTrip(port: int, msg: string): string! {
  let c = dial("127.0.0.1", port)?
  c.write(msg)?
  let reply = c.readAll() // the server closes after replying, so this terminates
  c.close()
  return reply
}

fn dialAndClose(port: int): ()! {
  let c = dial("127.0.0.1", port)?
  c.close()
}

// A non-blocking connect reports refusal through SO_ERROR once the socket goes
// writable. If that check were missing, this would look like a success.
fn refused(port: int): bool {
  dialAndClose(port) catch e {
    return true
  }
  return false
}

fn run(): ()! {
  // Port 0: the kernel picks a free one, so nothing races us for a number.
  let l = listen("127.0.0.1", 0)?
  let port = l.port()?
  println("bound: ${port > 0}")

  let done = chan<int>(4)
  spawn serve(l, 3, done)

  println(roundTrip(port, "hello")?)
  println(roundTrip(port, "bit")?)

  // A client that sends nothing and closes: the server must see end of stream,
  // not hang on it.
  dialAndClose(port)?

  // Each handler reports exactly once, so three receives drain them all.
  let total = 0
  let i = 0
  while (i < 3) {
    total = total + <- done
    i = i + 1
  }
  println("bytes served: ${total}")
  l.close()

  println("refused on a closed port: ${refused(port)}")
}

fn main() {
  run() catch e {
    println("failed: ${e.message()}")
  }
}
