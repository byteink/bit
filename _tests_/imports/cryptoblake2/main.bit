// std/crypto BLAKE2b + BLAKE2s (#1170): the RFC 7693 known-answer vectors —
// unkeyed digests of "abc" and the empty message, the two blake2-kat.json keyed
// entries (empty message under the canonical 00..3f / 00..1f key), a keyed
// non-empty vector, and two parameterized short-output cases. Also the
// digest/blockSize each constructor reports through the `Hash` interface, and
// that a multi-block message fed in odd chunks — unkeyed and keyed — hashes
// byte-identically to its one-shot digest. Every value is deterministic.
import {
  Hash, digest, encodeHex,
  newBlake2b, newBlake2s, blake2b,
} from "std/crypto"

// The bytes 0x00, 0x01, ... 0x(n-1) — the reference KAT key material and inputs.
fn iota(n: int): []byte {
  let b = []byte(n)
  let i = 0
  while (i < n) {
    b[i] = byte(i)
    i = i + 1
  }
  return b
}

// A deterministic `n`-byte message with no block-boundary structure.
fn mkMsg(n: int): []byte {
  let b = []byte(n)
  let i = 0
  while (i < n) {
    b[i] = byte((i * 31 + 7) & 0xff)
    i = i + 1
  }
  return b
}

// Hex digest of `msg` fed to `h` in `step`-byte slices, exercising the partial
// block buffer across writes.
fn streamHex(h: Hash, msg: []byte, step: int): string {
  let lo = 0
  while (lo < len(msg)) {
    let hi = lo + step
    if (hi > len(msg)) {
      hi = len(msg)
    }
    h.write(msg[lo:hi])
    lo = hi
  }
  return encodeHex(h.sum())
}

fn main() {
  let noKey = []byte(0)

  println("b2b_abc=${encodeHex(digest(newBlake2b(64, noKey), []byte("abc")))}")
  println("b2s_abc=${encodeHex(digest(newBlake2s(32, noKey), []byte("abc")))}")
  println("b2b_empty=${encodeHex(digest(newBlake2b(64, noKey), []byte("")))}")
  println("b2s_empty=${encodeHex(digest(newBlake2s(32, noKey), []byte("")))}")

  // Keyed (MAC) mode: the blake2-kat.json entry-0 vectors, empty message under
  // the full-length canonical key.
  println("b2b_keyed=${encodeHex(digest(newBlake2b(64, iota(64)), []byte("")))}")
  println("b2s_keyed=${encodeHex(digest(newBlake2s(32, iota(32)), []byte("")))}")
  // Keyed with a non-empty input (in = 00 01 02, key = 00..3f).
  println("b2b_keyed_in3=${encodeHex(digest(newBlake2b(64, iota(64)), iota(3)))}")

  // Parameterized short output lengths.
  println("b2b_short20=${encodeHex(digest(newBlake2b(20, noKey), []byte("abc")))}")
  println("b2s_short16=${encodeHex(digest(newBlake2s(16, noKey), []byte("abc")))}")

  let b = newBlake2b(64, noKey)
  let s = newBlake2s(32, noKey)
  let short = newBlake2b(20, noKey)
  println("sizes=${b.size()},${s.size()},${short.size()} blocks=${b.blockSize()},${s.blockSize()}")

  // The convenience wrapper is the unkeyed 64-byte digest.
  println("b2b_conv=${encodeHex(blake2b([]byte("abc")))}")

  // Streaming across odd chunks must equal the one-shot digest — unkeyed…
  let msg = mkMsg(200)
  let once = encodeHex(digest(newBlake2b(64, noKey), msg))
  let streamed = streamHex(newBlake2b(64, noKey), msg, 7)
  println("stream_matches=${once == streamed}")

  // …and keyed, across multiple blocks.
  let kmsg = iota(150)
  let konce = encodeHex(digest(newBlake2b(64, iota(64)), kmsg))
  let kstreamed = streamHex(newBlake2b(64, iota(64)), kmsg, 13)
  println("keyed_stream_matches=${konce == kstreamed}")
}
