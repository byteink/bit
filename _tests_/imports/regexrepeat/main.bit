// std/regex counted repetition `{n}`/`{n,}`/`{n,m}`, lazy quantifiers, and
// the pattern/program size caps (#2031).
//
// Every expected value is justified against Go's `regexp`/`regexp/syntax`
// documented (and, for the malformed-brace boundary, directly verified with
// `go run` against Go 1.27) behavior — see `stdlib/regex/parserepeat.bit`'s
// header for the full transcript that boundary was checked against. One
// finding from that verification: the ticket that shipped this fixture
// asked for a distinct `invalid repeat count` ERROR on a non-numeric or
// empty count (e.g. `a{3,x}`); real Go treats every syntactically malformed
// `{...}` as a LITERAL `{`, never a parse error, and only rejects a count
// that is syntactically complete but semantically bad (too large, or
// `n > m`) — this fixture follows the verified oracle, not the ticket's
// prose, for that one boundary.
//
// `find` prints "start,end,text" or "no match" (same shape as
// _tests_/imports/regexflags); `check`/`checkLen` print "ok <pattern>" (or
// "ok len=<n>" for the two patterns too long to print in full) on success,
// or the caught compile error's message otherwise.

import { compile, mustCompile } from "std/regex"
import { repeat } from "std/strings"

fn find(pattern: string, s: string): string {
  let re = mustCompile(pattern)
  return match (re.find(s)) {
    Some(m) => "${m.start},${m.end},${m.text(s)}"
    None => "no match"
  }
}

fn check(pattern: string) {
  let re = compile(pattern) catch e {
    println(e.message())
    return
  }
  println("ok ${pattern}")
}

fn checkLen(pattern: string) {
  let re = compile(pattern) catch e {
    println(e.message())
    return
  }
  println("ok len=${len(pattern)}")
}

fn main() {
  matchingForms()
  malformedBraces()
  countErrors()
  sizeCaps()
  nestingDepthCap()
}

// `{n}`, `{n,}`, `{n,m}` (and its lazy form), `{0,m}`, `{0}` — matching at
// their boundaries and failing just outside them — plus the lazy forms of
// `*`/`+`/`?`, already wired by #2028/#2030's `Split` arm order but never
// exercised end to end until this ticket.
fn matchingForms() {
  // --- {n}: exactly n --------------------------------------------------------
  println(find("x{3}", "xx"))   // one short: no match
  println(find("x{3}", "xxx"))  // exact: matches
  println(find("x{3}", "xxxx")) // longer input: still only takes 3

  // --- {n,}: n or more ---------------------------------------------------------
  println(find("x{2,}", "x"))     // one short: no match
  println(find("x{2,}", "xx"))    // exact minimum: matches
  println(find("x{2,}", "xxxxx")) // greedy: takes every x

  // --- {n,m}: between n and m inclusive, greedy prefers more -------------------
  println(find("x{2,4}", "x"))       // below minimum: no match
  println(find("x{2,4}", "xx"))      // at minimum: matches
  println(find("x{2,4}", "xxxx"))    // at maximum: matches all 4
  println(find("x{2,4}", "xxxxxx"))  // more available: still caps at 4
  println(find("x{2,4}?", "xxxxxx")) // lazy: takes only the minimum, 2

  // --- {0,m}: zero is a valid lower bound ---------------------------------------
  println(find("x{0,3}", ""))       // matches empty
  println(find("x{0,3}", "xxxxx"))  // greedy: takes 3
  println(find("x{0,3}?", "xxxxx")) // lazy: takes 0

  // --- {0}: always matches empty, regardless of the atom ------------------------
  println(find("a{0}", "bbb"))
  println(find("x{0}", "xxxxx"))

  // --- n == m is valid (same as {n}) --------------------------------------------
  println(find("a{3,3}", "aaaa"))

  // --- lazy forms of *, +, ? -----------------------------------------------------
  println(find("a*?", "aaa"))      // prefers zero
  println(find("a+?", "aaa"))      // prefers one
  println(find("a??", "aaa"))      // prefers zero
  println(find("<.*?>", "<a><b>")) // stops at the first '>'
  println(find("<.*>", "<a><b>"))  // greedy: runs to the last '>'
}

// Every syntactically malformed `{...}` — missing/empty/non-numeric count,
// unterminated — is a literal `{`, never a parse error (verified against
// real Go; see this file's header).
fn malformedBraces() {
  check("{") // bare '{': literal
  println(find("a{", "a{"))
  check("a{,3}") // "{,m}" is NOT {0,m} -- a literal 5-byte run
  println(find("a{,3}", "a{,3}"))
  println(find("a{,3}", "aaa")) // proves it did NOT mean {0,3}
  check("a{}")
  check("a{3,x}") // non-numeric count: literal, NOT an error
  println(find("a{3,x}", "a{3,x}"))
  check("a{3,5x}")
  check("a{03}") // leading zero: literal, not {3} (matches Go)
  println(find("a{03}", "aaa"))
}

// The two genuine errors once a `{...}` is syntactically a complete count:
// too large (the per-count cap, 1000), and out of order (n > m).
fn countErrors() {
  check("a{1000}") // largest accepted single count
  check("a{1001}") // one past it: rejected
  check("a{5,5}")  // n == m: valid
  check("a{5,2}")  // n > m: rejected
}

// The pattern-length cap (4096 bytes) and the program-instruction cap
// (20000), including the ticket's own worked example of exponential
// nesting.
fn sizeCaps() {
  checkLen(repeat("a", 4096))   // largest accepted pattern
  checkLen(repeat("a", 4097))   // one byte past it: rejected
  check("((a{100}){100}){100}") // 100^3 would be 1,000,000 instructions
}

// The grammar-nesting cap: `compile` rejects a pattern nesting `(...)`
// groups 1000 deep or more (#3660), matching Go's `regexp/syntax`
// `ErrNestingDepth` boundary (measured against go1.27.0: a pattern nesting
// 999 groups deep compiles, 1000 does not). `find` at the accepted boundary
// proves the depth counter didn't disturb capture semantics on its way to
// the limit -- not just that compiling it succeeded; `checkDepth` (not
// `check`) for the rejected one so a regression here doesn't print a
// 2001-byte pattern into `expected`.
fn checkDepth(depth: int) {
  let re = compile(repeat("(", depth) + "a" + repeat(")", depth)) catch e {
    println(e.message())
    return
  }
  println("ok depth=${depth}")
}

fn nestingDepthCap() {
  println(find(repeat("(", 999) + "a" + repeat(")", 999), "a")) // deepest accepted
  checkDepth(1000)                                              // one level past it: rejected
}
