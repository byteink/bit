// The aliased module for `_tests_/imports/nsnamedargs` (#4686). Deliberately
// mixed parameter TYPES on `label`: a misplaced argument is then a type error
// rather than a wrong number silently printed.
export fn label(name: string, port: i64, tls: bool): string {
  return "${name}:${port} tls=${tls}"
}

export fn area(w: i64, h: i64): i64 {
  return w * h
}

export fn tally(tag: string, ...ns: i64): string {
  let sum = 0
  for n of ns {
    sum = sum + n
  }
  return "${tag}=${sum}"
}
