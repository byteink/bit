// #4686: named arguments on a NAMESPACE-QUALIFIED free call, `ns.f(port = 3000)`.
//
// SPEC §12.11 admits a named argument "where the callee is a named function or
// method whose declaration is in scope"; `g.label` is a named free function
// whose declaration is in scope through the alias, and the bare spelling of the
// very same declaration has accepted named arguments since #3839. Before this
// fix the callee's Member tag sent the call to the METHOD resolution, which
// types the base — a namespace alias is bound only under dotted "ns.name" keys
// and never as a value, so it typed to 0 and every named argument was E0128.
//
// Multi-file by construction: only a real namespace import binds an alias, so
// this belongs here rather than under `_tests_/cases`.
import * as g from "./geo"

fn one(): i64 {
  print("one\n")
  return 1
}

fn two(): i64 {
  print("two\n")
  return 2
}

fn main() {
  // Positional, unchanged: the control for everything below.
  print(g.label("web", 3000, true) + "\n")
  // Every argument named, written in reverse declared order.
  print(g.label(tls = true, port = 3000, name = "web") + "\n")
  // A positional prefix followed by named arguments, also out of order.
  print(g.label("web", tls = true, port = 3000) + "\n")
  // Out of declared order with values that are not interchangeable.
  print("${g.area(h = 3, w = 10)}\n")
  // A VARIADIC callee: named arguments fill the fixed prefix, and the rest
  // parameter binds the empty slice — never a named argument of its own.
  print(g.tally(tag = "empty") + "\n")
  print(g.tally("three", 1, 2) + "\n")
  // The evaluation-order proof, the one no arity or type check can make:
  // arguments evaluate in WRITTEN order (one then two) while landing in
  // DECLARED slots (w = two()'s value, h = one()'s). Placing them straight
  // into slots instead reorders the side effects and prints "two" first with
  // every value still correct — a silent wrong answer at exit 0.
  print("${g.area(h = one(), w = two())}\n")
}
