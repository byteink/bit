// std/http client request headers (#2290): `header(block, name)` only ever
// READ a raw header block — nothing let a caller ATTACH one to an outgoing
// request, so `Authorization`/`Content-Type`/`X-Api-Key`/... were all
// unsendable through this module. `Header`, `requestWith`, `Client.requestWith`
// and `Client.setHeader` are the write side.
//
// Case 1 proves the round trip through ONLY std/http (no std/net): a real
// server echoes back whatever it received in a named request header, and the
// client sends it through `requestWith`.
//
// Case 2 proves request-header injection is rejected at the WIRE-BUILDING
// layer, not merely that some higher call returns an error: it calls
// `serializeHeaders` directly — the exact function `requestWith` and
// `Client.setHeader` both funnel through — with a value containing a raw
// CR/LF. On success `serializeHeaders` returns the string that would have
// been spliced verbatim into the request text; failing here means that
// string is never produced at all, so nothing derived from the bad value can
// reach the wire through this function. Case 3 is the control: a clean value
// through the same function, compared byte-for-byte against the exact wire
// line `header()` would read back (as a boolean, never printed raw — see
// that case for why).
import {
  serve, listenAndServeOn, requestWith, Header, serializeHeaders, Response, Request, Server,
  header, respond,
} from "std/http"

fn echoAuthorization(req: Request): Response {
  return respond(200, header(req.headers, "Authorization"))
}

fn serveEcho(s: Server) {
  listenAndServeOn(s, echoAuthorization) catch e {
    println("server error: ${e.message()}")
  }
}

fn caseRoundTrip(): ()! {
  let s = serve("127.0.0.1", 0)?
  let port = s.port()?
  spawn serveEcho(s)
  let hdrs = [Header{ name: "Authorization", value: "Bearer t0ken" }]
  let res = requestWith("GET", "http://127.0.0.1:${port}/", hdrs, "")?
  println("case1 round-trip body=\"${res.body}\"")
}

fn caseRejectedInjection() {
  let bad = [Header{ name: "X-Trace", value: "legit\r\nX-Injected: evil" }]
  let block = serializeHeaders(bad) catch e {
    println("case2 bad value REJECTED: ${e.message()}")
    return
  }
  println("case2 bad value NOT REJECTED, wire bytes=\"${block}\"")
}

fn caseCleanControl() {
  let good = [Header{ name: "X-Trace", value: "legit" }]
  let block = serializeHeaders(good) catch e {
    println("case3 clean value unexpectedly rejected: ${e.message()}")
    return
  }
  // Compared as a boolean, never printed: the exact bytes are "X-Trace:
  // legit\r\n", and printing a raw wire CRLF risks this repo's
  // `core.autocrlf=input` silently rewriting the checked-in `expected` file.
  println("case3 clean value exact-wire-match=${block == "X-Trace: legit\r\n"}")
}

fn main() {
  caseRoundTrip() catch e {
    println("case1 failed: ${e.message()}")
  }
  caseRejectedInjection()
  caseCleanControl()
}
