// std/regex `\p{...}`/`\P{...}` Unicode property classes (#2032). Every
// match/find case's expected value was cross-checked against Go's
// `regexp` (go1.27.0) before being pinned. The two rejection cases use
// this module's own error text (specific and named, per the ticket),
// which is deliberately more precise than Go's own generic
// "invalid character class range" for the same inputs.

import { compile, mustCompile } from "std/regex"

fn find(pattern: string, s: string): string {
  let re = mustCompile(pattern)
  return match (re.find(s)) {
    Some(m) => "${m.start},${m.end},${m.text(s)}"
    None => "no match"
  }
}

fn matches(pattern: string, s: string): string {
  return "${mustCompile(pattern).matches(s)}"
}

// Prints the caught error's message ("regex: <reason> at offset <n>") for
// a pattern expected to be rejected.
fn checkErr(pattern: string) {
  compile(pattern) catch e {
    println(e.message())
    return
  }
  println("unexpectedly compiled: ${pattern}")
}

fn main() {
  // --- \p{L}: Latin, Greek and Han letters all match; a digit does not ----
  println(find("\\p{L}", "a"))    // 0,1,a
  println(find("\\p{L}", "α"))   // 0,2,α
  println(find("\\p{L}", "中"))  // 0,3,中
  println(matches("\\p{L}", "5")) // false

  // --- \P{L}: the exact complement of \p{L} -------------------------------
  println(matches("\\P{L}", "a")) // false
  println(matches("\\P{L}", "5")) // true

  // --- \pN shorthand: single-letter category, no braces ------------------
  println(find("\\pN", "5")) // 0,1,5

  // --- \p{Lu} vs \p{Ll}: case-specific general categories -----------------
  println(matches("\\p{Lu}", "A")) // true
  println(matches("\\p{Lu}", "a")) // false
  println(matches("\\p{Ll}", "a")) // true
  println(matches("\\p{Ll}", "A")) // false

  // --- \p{Han} and \p{Cyrillic}: script names ------------------------------
  println(matches("\\p{Han}", "中"))     // true
  println(matches("\\p{Han}", "a"))       // false
  println(matches("\\p{Cyrillic}", "д")) // true
  println(matches("\\p{Cyrillic}", "d"))  // false

  // --- \p{L} unioned into a bracket class, alongside ASCII ranges ---------
  println(find("[\\p{L}0-9_]+", "abc123_x!")) // 0,8,abc123_x

  // --- a negated bracket class built from \p{L} ---------------------------
  println(find("[^\\p{L}]+", "abc123")) // 3,6,123

  // --- \p{Any}: every valid Unicode scalar value --------------------------
  println(find("\\p{Any}", "中")) // 0,3,中

  // --- rejections: an unknown property name, and an unterminated \p{ -----
  checkErr("\\p{Bogus}")
  checkErr("\\p{L")

  // --- #3855: property names are canonicalized before lookup, matching
  // Go's regexp/syntax `canonicalName` exactly — uppercase the first
  // letter, lowercase the rest, drop `_`/`-`/` `. `\pp` (the one-letter
  // shorthand) canonicalizes to "P" (Punctuation), so `\ppL}+` is
  // `[Punctuation]` then literal `L` then one-or-more literal `}` — the
  // exact fuzzer-found divergence, seed=2 idx=167.
  println(find("\\ppL}+", ""))      // no match
  println(find("\\ppL}+", "!L}"))   // 0,3,!L}
  println(find("\\ppL}+", "!L}}}")) // 0,5,!L}}}
  println(find("\\ppL}+", "aL}"))   // no match (a is not Punctuation)
  println(find("\\ppL}+", "pL}"))   // no match (p itself is not Punctuation)

  // #3855's own sibling finding, seed=4 idx=47: the braced form
  // canonicalizes the same way — "n" -> "N" (Number).
  println(find("\\p{n}+", "123"))    // 0,3,123
  println(find("\\p{n}+", "abc123")) // 3,6,123
  println(matches("\\p{n}+", "abc")) // false

  // Case and separator variants of an already-supported name all resolve
  // to the identical property.
  println(matches("\\p{lu}", "A"))    // true
  println(matches("\\p{LU}", "A"))    // true
  println(matches("\\p{L_u}", "A"))   // true
  println(matches("\\p{L-u}", "A"))   // true
  println(matches("\\p{L u}", "A"))   // true
  println(matches("\\p{latin}", "a")) // true
  println(matches("\\p{ANY}", "中")) // true

  // The fallback must not widen: "AN" canonicalizes to "An", which is not
  // "Any" and not any supported category — still a hard reject, matching
  // Go (`regexp.Compile("\\p{AN}")` also errors).
  checkErr("\\p{AN}")
}
