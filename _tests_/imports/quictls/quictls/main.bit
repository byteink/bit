// std/quic QUIC-TLS integration (#1219): transport parameters (RFC 9000 §18.2),
// encryption-level key derivation and key update (RFC 9001 §5.1/§6.1), and
// CRYPTO-frame carriage (RFC 9000 §19.6). The transport-parameter encoding is
// pinned byte-exact; the Handshake/1-RTT key derivation is checked against the
// RFC 9001 Appendix A.1 sample secret and cross-checked against the Initial-key
// path; the CRYPTO carriage is round-tripped in order, out of order, with gaps,
// with overlapping retransmits, and over the real wire codec. All of that is
// deterministic, so the golden `expected` is stable across targets.
//
// The full end-to-end handshake now runs over the std/tls record-bypass mode: a
// real client↔server TLS 1.3 handshake carried in CRYPTO frames across the
// Initial (ClientHello/ServerHello) and Handshake (EE..Finished) levels, keying
// each level from the exposed traffic secrets and reaching 1-RTT on both sides,
// with quic_transport_parameters exchanged inside the ClientHello /
// EncryptedExtensions. Server-certificate, CertificateVerify, and Finished
// verification stay in force — three rejection paths prove the bypass did not
// drop them. Every printed line is a boolean/`ok`/`rejected` (never a random
// secret), so the golden is deterministic though the ephemeral keys are not.
import {
  TransportParameters,
  defaultTransportParameters,
  encodeTransportParameters,
  decodeTransportParameters,
  EncryptionLevel,
  levelPacketType,
  levelKeys,
  levelKeyPair,
  updateSecret,
  nextKeyPhase,
  cryptoFrames,
  reassembleCryptoFrames,
  newCryptoAssembler,
  clientInitialKeys,
  expandLabel,
  protectPayload,
  unprotectPayload,
  quicTransportParametersExtension,
  Frame,
  encodeFrame,
  parseFrames,
} from "std/quic"
import { Hash, newSha256, encodeHex, decodeHex, ctEq, pemEncode } from "std/crypto"
import {
  tlsClientStart, tlsClientStartExts, tlsServerStartExts,
  TlsClientConfig, TlsGroup, GroupKeypair, emptyTrustStore,
  TrustStore, newTrustStore, TlsServerConfig, newTlsServerConfig,
  Extension, parseClientHello, TLS_AES_128_GCM_SHA256,
} from "std/tls"

// The suite hash (SHA-256 for the AES-128 / ChaCha20 suites) as a `() => Hash`.
fn sha256(): Hash { return newSha256() }

// The bytes a hex string spells; every input here is valid hex, so the `catch`
// is unreachable.
fn hx(s: string): []byte {
  return decodeHex(s) catch e {
    return []byte(0)
  }
}

// "ok"/"bad" for an assertion, so a wrong result flips the golden line, not just
// the raw hex.
fn okbad(cond: bool): string {
  if (cond) {
    return "ok"
  }
  return "bad"
}

// A conflicting overlap (byte 1 is 0x01 in one fragment, 0xff in the other) must
// be rejected, not silently merged (RFC 9000 §19.6).
fn tryConflict(): string {
  let frames = [Frame.Crypto(0, hx("0001")), Frame.Crypto(1, hx("ff"))]
  let r = reassembleCryptoFrames(frames, 1024) catch e {
    return "rejected"
  }
  return "accepted"
}

// A fragment past the reassembly limit must be rejected (bounded allocation).
fn tryLimit(): string {
  let frames = [Frame.Crypto(0, hx("00010203"))]
  let r = reassembleCryptoFrames(frames, 2) catch e {
    return "rejected"
  }
  return "accepted"
}

// Carry a real ClientHello (from `tlsClientStart`) through CRYPTO frames and
// back. `hello` is a TLS record; its handshake message is the bytes after the
// 5-byte record header. The message content is random, so only the round-trip
// equality is asserted — a stable outcome.
fn clientHelloCarriage(): string! {
  let cfg = TlsClientConfig{
    serverName: "example.com",
    alpn: []string(0),
    trust: emptyTrustStore(),
    insecureSkipVerify: true,
    nowUnix: 0,
    groups: [TlsGroup.X25519],
    keyShareGroups: [TlsGroup.X25519],
    suites: []int(0),
    clientHelloOverride: []byte(0),
    ephemeralOverride: []GroupKeypair(0),
  }
  let h = tlsClientStart(cfg)?
  let rec = h.hello
  let chMsg = rec[5:len(rec)]
  let frames = cryptoFrames(chMsg, 0, 1000)
  let back = reassembleCryptoFrames(frames, 100000)?
  return okbad(len(chMsg) > 0 && ctEq(back, chMsg))
}

// ---------------------------------------------------------------------------
// End-to-end QUIC-TLS handshake over CRYPTO frames (RFC 9001 §4)
// ---------------------------------------------------------------------------
//
// A throwaway OpenSSL PKI: a localhost leaf under a test root, valid 2026-2036
// (the same chain the std/tls tests use). The client verifies the chain against
// the root, so the QUIC path exercises full server authentication.
const caHex: string = ""
const leafHex: string = ""
const keyHex: string = ""

// A pinned validity time inside the leaf's window, so verification is clock-free.
const pinnedNow: int = 1800000000

fn pemOf(label: string, h: string): string { return pemEncode(label, hx(h)) }

// The quic_transport_parameters extension (RFC 9001 §8.2) carrying `tp`.
fn tpExt(tp: TransportParameters): Extension {
  return Extension{ extType: quicTransportParametersExtension, data: encodeTransportParameters(tp) }
}

// Decode the quic_transport_parameters extension out of a message's extension list.
fn findTp(exts: []Extension): TransportParameters! {
  for e of exts {
    if (e.extType == quicTransportParametersExtension) {
      return decodeTransportParameters(e.data)?
    }
  }
  fail newError("no quic_transport_parameters extension present")
}

// Carry one handshake message through CRYPTO frames (small chunks, so a larger
// message such as Certificate fragments) and reassemble it — a per-level CRYPTO
// stream at offset 0, exactly how a QUIC endpoint moves handshake bytes.
fn carry(msg: []byte): []byte! {
  return reassembleCryptoFrames(cryptoFrames(msg, 0, 300), 100000)?
}

// A copy of `b` with its last byte flipped — corrupts a Finished verify_data at
// the tail of a flight so the MAC check must reject it.
fn flipLast(b: []byte): []byte {
  let out = []byte(len(b))
  let i = 0
  while (i < len(b)) {
    out[i] = b[i]
    i = i + 1
  }
  if (len(out) > 0) {
    out[len(out) - 1] = out[len(out) - 1] ^ 0xff
  }
  return out
}

// The client's transport parameters and the server's — distinct values, so each
// side can prove it decoded the peer's, not its own.
fn clientTransportParams(): TransportParameters {
  let tp = defaultTransportParameters()
  tp.initialMaxData = 1048576
  tp.initialMaxStreamsBidi = 16
  tp.initialSourceConnectionId = hx("c1c1c1c1")
  return tp
}

fn serverTransportParams(): TransportParameters {
  let tp = defaultTransportParameters()
  tp.initialMaxData = 2097152
  tp.maxIdleTimeout = 30000
  tp.initialSourceConnectionId = hx("5e5e5e5e")
  return tp
}

// A QUIC client config over the throwaway PKI: SNI localhost, AES-128 pinned so
// the suite hash is SHA-256 and the QUIC key length 16. `verify` maps (inverted)
// to insecureSkipVerify, so `verify=true` keeps full certificate verification on.
fn quicClientConfig(trust: TrustStore, verify: bool): TlsClientConfig {
  return TlsClientConfig{
    serverName: "localhost",
    alpn: ["h3"],
    trust: trust,
    insecureSkipVerify: !verify,
    nowUnix: pinnedNow,
    groups: [TlsGroup.X25519],
    keyShareGroups: [TlsGroup.X25519],
    suites: [TLS_AES_128_GCM_SHA256],
    clientHelloOverride: []byte(0),
    ephemeralOverride: []GroupKeypair(0),
  }
}

fn quicServerConfig(): TlsServerConfig! {
  return newTlsServerConfig(pemOf("CERTIFICATE", leafHex), pemOf("PRIVATE KEY", keyHex), ["h3"])?
}

// The full end-to-end QUIC-TLS handshake: a real client↔server TLS 1.3 handshake
// carried in CRYPTO frames across the Initial and Handshake levels, keying each
// level from the exposed traffic secrets, exchanging transport parameters, and
// reaching 1-RTT on both sides. Prints a boolean per checkpoint; certificate,
// CertificateVerify, and Finished verification are all in force on this path.
fn quicE2E(): ()! {
  let ct = clientTransportParams()
  let st = serverTransportParams()
  let trust = newTrustStore(pemOf("CERTIFICATE", caHex))?

  let h = tlsClientStartExts(quicClientConfig(trust, true), [tpExt(ct)])?
  let s = tlsServerStartExts(quicServerConfig()?, [tpExt(st)])?

  // Initial level: the ClientHello travels in CRYPTO frames.
  let chMsg = h.clientHelloMessage()
  let chAtServer = carry(chMsg)?
  println("e2e_ch_carriage=${okbad(ctEq(chAtServer, chMsg))}")

  // The server reads the client's transport parameters out of the ClientHello.
  let parsedCh = parseClientHello(chAtServer)?
  let ctAtServer = findTp(parsedCh.extensions)?
  println(
    "e2e_client_tp=${okbad(
        ctAtServer.initialMaxData == ct.initialMaxData &&
        ctEq(ctAtServer.initialSourceConnectionId, ct.initialSourceConnectionId),
    )}",
  )

  // The server answers: ServerHello (Initial) plus the auth flight (Handshake).
  let sflight = s.processClientHelloMessage(chAtServer)?
  println("e2e_no_retry=${okbad(!sflight.retry)}")

  // The client processes the ServerHello (Initial level).
  let retry = h.processServerHelloMessage(carry(sflight.serverHello)?)?
  println("e2e_sh_ok=${okbad(len(retry) == 0)}")

  // Handshake-level keys, derived from the handshake-traffic secrets on each side.
  let hsC = levelKeyPair(sha256, h.clientHandshakeSecret(), h.serverHandshakeSecret(), 16)
  let hsS = levelKeyPair(sha256, s.clientHandshakeSecret(), s.serverHandshakeSecret(), 16)
  println(
    "e2e_hs_keys_match=${okbad(
        ctEq(hsC.client.key, hsS.client.key) &&
        ctEq(hsC.server.key, hsS.server.key) &&
        ctEq(hsC.client.iv, hsS.client.iv),
    )}",
  )

  // The client consumes EE..Finished (Handshake level) — verifying the cert
  // chain + hostname, the CertificateVerify signature, and the server Finished
  // MAC — and produces its own Finished.
  let finMsg = h.clientReadHandshake(carry(sflight.handshake)?)?

  // The client reads the server's transport parameters out of EncryptedExtensions.
  let stAtClient = findTp(h.peerEncryptedExtensions())?
  println("e2e_server_tp=${okbad(stAtClient.initialMaxData == st.initialMaxData && stAtClient.maxIdleTimeout == st.maxIdleTimeout)}")

  // The server verifies the client Finished (Handshake level) and completes.
  let sconn = s.processClientFinishedMessage(carry(finMsg)?)?

  // 1-RTT keys from the application-traffic secrets on both sides.
  let appC = levelKeyPair(sha256, h.clientApplicationSecret(), h.serverApplicationSecret(), 16)
  let appS = levelKeyPair(sha256, s.clientApplicationSecret(), s.serverApplicationSecret(), 16)
  println(
    "e2e_1rtt_keys_match=${okbad(
        ctEq(appC.client.key, appS.client.key) &&
        ctEq(appC.server.key, appS.server.key) &&
        ctEq(appC.client.hp, appS.client.hp),
    )}",
  )

  // Both sides reached 1-RTT: each derived a full 32-byte application secret, and
  // the server settled on the AES-128 suite the client pinned.
  println("e2e_client_1rtt=${okbad(len(h.clientApplicationSecret()) == 32 && len(h.serverApplicationSecret()) == 32)}")
  println("e2e_server_1rtt=${okbad(len(s.serverApplicationSecret()) == 32 && s.cipherSuiteId() == TLS_AES_128_GCM_SHA256)}")

  // The exporter master secrets agree.
  println("e2e_exporter_match=${okbad(ctEq(h.exporterSecret(), s.exporterSecret()))}")

  // A live 1-RTT packet: seal under the client's 1-RTT key, open on the server.
  let hdr = hx("4243440001")
  let app = hx("48656c6c6f2051554943")
  let sealed = protectPayload(appC.client, 0, hdr, app)?
  let opened = unprotectPayload(appS.client, 0, hdr, sealed)?
  println("e2e_1rtt_roundtrip=${okbad(ctEq(opened, app))}")
}

// Run the client↔server handshake with an EMPTY trust store (verification on):
// the client must reject the server certificate chain when it reads the flight.
fn quicRejectsBadCert(): string {
  let r = quicRejectsBadCertRun() catch e {
    return "rejected"
  }
  return "accepted"
}

fn quicRejectsBadCertRun(): ()! {
  let h = tlsClientStartExts(
    quicClientConfig(emptyTrustStore(), true),
    [tpExt(clientTransportParams())],
  )?
  let s = tlsServerStartExts(quicServerConfig()?, [tpExt(serverTransportParams())])?
  let sflight = s.processClientHelloMessage(carry(h.clientHelloMessage())?)?
  h.processServerHelloMessage(carry(sflight.serverHello)?)?
  h.clientReadHandshake(carry(sflight.handshake)?)?
}

// Corrupt the server's Finished (tail of the Handshake flight): the client must
// reject it on the server Finished MAC check.
fn quicRejectsBadServerFinished(): string {
  let r = quicRejectsBadServerFinishedRun() catch e {
    return "rejected"
  }
  return "accepted"
}

fn quicRejectsBadServerFinishedRun(): ()! {
  let trust = newTrustStore(pemOf("CERTIFICATE", caHex))?
  let h = tlsClientStartExts(quicClientConfig(trust, true), [tpExt(clientTransportParams())])?
  let s = tlsServerStartExts(quicServerConfig()?, [tpExt(serverTransportParams())])?
  let sflight = s.processClientHelloMessage(carry(h.clientHelloMessage())?)?
  h.processServerHelloMessage(carry(sflight.serverHello)?)?
  h.clientReadHandshake(carry(flipLast(sflight.handshake))?)?
}

// Corrupt the client's Finished: the server must reject it on the client Finished
// MAC check.
fn quicRejectsBadClientFinished(): string {
  let r = quicRejectsBadClientFinishedRun() catch e {
    return "rejected"
  }
  return "accepted"
}

fn quicRejectsBadClientFinishedRun(): ()! {
  let trust = newTrustStore(pemOf("CERTIFICATE", caHex))?
  let h = tlsClientStartExts(quicClientConfig(trust, true), [tpExt(clientTransportParams())])?
  let s = tlsServerStartExts(quicServerConfig()?, [tpExt(serverTransportParams())])?
  let sflight = s.processClientHelloMessage(carry(h.clientHelloMessage())?)?
  h.processServerHelloMessage(carry(sflight.serverHello)?)?
  let finMsg = h.clientReadHandshake(carry(sflight.handshake)?)?
  s.processClientFinishedMessage(carry(flipLast(finMsg))?)?
}

// Transport parameters (RFC 9000 §18.2), byte-exact.
fn transportParamChecks(): ()! {
  let tp = defaultTransportParameters()
  tp.maxIdleTimeout = 5000
  tp.initialMaxData = 4660
  tp.initialMaxStreamsBidi = 3
  tp.initialSourceConnectionId = hx("cafe")
  let enc = encodeTransportParameters(tp)
  println("tp_enc=${encodeHex(enc)}")
  println("tp_kat=${okbad(ctEq(enc, hx("01025388040252340801030f02cafe")))}")

  let dec = decodeTransportParameters(enc)?
  println("tp_idle=${int(dec.maxIdleTimeout)}")
  println("tp_data=${int(dec.initialMaxData)}")
  println("tp_streams=${int(dec.initialMaxStreamsBidi)}")
  println("tp_scid=${encodeHex(dec.initialSourceConnectionId)}")
  println("tp_rt=${okbad(ctEq(encodeTransportParameters(dec), enc))}")

  // Defaults are omitted on the wire and refilled on decode.
  println("tp_defbytes=${len(encodeTransportParameters(defaultTransportParameters()))}")
  let d = decodeTransportParameters([]byte(0))?
  println("tp_defudp=${int(d.maxUdpPayloadSize)}")
  println("tp_defackexp=${int(d.ackDelayExponent)}")
  println("tp_defackdelay=${int(d.maxAckDelay)}")
  println("tp_defcidlimit=${int(d.activeConnectionIdLimit)}")

  // An unknown parameter (id 0x21) is skipped, and the rest still parses.
  let combined = hx("2102beef")
  for x of enc {
    combined = append(combined, x)
  }
  let du = decodeTransportParameters(combined)?
  println("tp_unknown=${okbad(du.maxIdleTimeout == 5000 && du.initialMaxData == 4660)}")
}

// Encryption-level keys (RFC 9001 §5.1) vs the A.1 sample secret, packet
// types (RFC 9000 §17.2), and key update (RFC 9001 §6.1).
fn keyChecks(): ()! {
  let csecret = hx("c00cf151ca5be075ed0ebfb5c80323c42d6b7db67881289af4008f1f6c357aea")
  let lk = levelKeys(sha256, csecret, 16)
  println("lvl_key=${encodeHex(lk.key)}")
  println("lvl_iv=${encodeHex(lk.iv)}")
  println("lvl_hp=${encodeHex(lk.hp)}")
  // The A.1 client Initial secret is exactly `csecret`, so the generic level
  // derivation must match the Initial-key path over the A.1 DCID.
  let ck = clientInitialKeys(hx("8394c8f03e515708"))
  println(
    "lvl_matches_initial=${okbad(ctEq(lk.key, ck.key) && ctEq(lk.iv, ck.iv) && ctEq(lk.hp, ck.hp))}",
  )

  println("pt_initial=${levelPacketType(EncryptionLevel.Initial)}")
  println("pt_handshake=${levelPacketType(EncryptionLevel.Handshake)}")
  println("pt_onertt=${levelPacketType(EncryptionLevel.OneRtt)}")

  let ku = updateSecret(sha256, csecret)
  println("ku=${encodeHex(ku)}")
  // Label wiring: `updateSecret` must agree with the independent SHA-256
  // HKDF-Expand-Label in packet.bit for the "quic ku" label.
  println("ku_label=${okbad(ctEq(ku, expandLabel(csecret, "quic ku", 32)))}")
  // The updated secret keys a working AEAD (seal then open round-trips).
  let kk = levelKeys(sha256, ku, 16)
  let header = hx("c0000000010800")
  let msg = hx("48656c6c6f")
  let sealed = protectPayload(kk, 0, header, msg)?
  let opened = unprotectPayload(kk, 0, header, sealed)?
  println("ku_aead=${okbad(ctEq(opened, msg))}")
  println("kp=${okbad(nextKeyPhase(false) && !nextKeyPhase(true))}")
}

// CRYPTO-frame carriage (RFC 9000 §19.6): in order, out of order, with gaps,
// over the real wire codec, and overlapping retransmits.
fn cryptoFrameCarriage(): ()! {
  let stream = hx("00010203040506070809")
  let frames = cryptoFrames(stream, 0, 4)
  println("crypto_chunks=${len(frames)}")
  println("crypto_inorder=${encodeHex(reassembleCryptoFrames(frames, 1024)?)}")

  let ooo = [
    Frame.Crypto(8, hx("0809")),
    Frame.Crypto(0, hx("00010203")),
    Frame.Crypto(4, hx("04050607")),
  ]
  println("crypto_ooo=${encodeHex(reassembleCryptoFrames(ooo, 1024)?)}")

  let gap = [Frame.Crypto(0, hx("00010203")), Frame.Crypto(8, hx("0809"))]
  let ga = reassembleCryptoFrames(gap, 1024)?
  println("crypto_gap_len=${len(ga)}")
  println("crypto_gap=${encodeHex(ga)}")

  // Round-trip over the real wire codec: chunk, encode a payload of frames,
  // parse it back, reassemble.
  let payload = []byte(0)
  for f of frames {
    for b of encodeFrame(f) {
      payload = append(payload, b)
    }
  }
  let parsed = parseFrames(payload)?
  println("crypto_wire=${encodeHex(reassembleCryptoFrames(parsed, 1024)?)}")

  // Overlapping retransmits carrying identical bytes reassemble cleanly.
  let ov = [
    Frame.Crypto(0, hx("0001020304")),
    Frame.Crypto(3, hx("0304050607")),
    Frame.Crypto(8, hx("0809")),
  ]
  println("crypto_overlap=${encodeHex(reassembleCryptoFrames(ov, 1024)?)}")

  println("crypto_conflict=${tryConflict()}")
  println("crypto_limit=${tryLimit()}")
}

// Direct assembler use: a fragment at offset 4 leaves nothing readable until
// the 0..4 gap is filled.
fn assemblerChecks(): ()! {
  let assembler = newCryptoAssembler(64)
  assembler.insert(4, hx("aabb"))?
  println("asm_gap=${assembler.contiguousLen()}")
  assembler.insert(0, hx("00010203"))?
  println("asm_full=${encodeHex(assembler.contiguous())}")
}

// Split into transportParamChecks/keyChecks/cryptoFrameCarriage/
// assemblerChecks (E0201, was 126 lines, limit 80).
fn run(): ()! {
  transportParamChecks()?
  keyChecks()?
  cryptoFrameCarriage()?
  assemblerChecks()?

  // --- Real ClientHello carriage (partial loopback) ---
  println("clienthello_carriage=${clientHelloCarriage()?}")

  // --- Full end-to-end QUIC-TLS handshake to 1-RTT over CRYPTO frames ---
  quicE2E()?

  // --- The record-bypass path still verifies cert chain + both Finished MACs ---
  println("quic_bad_cert=${quicRejectsBadCert()}")
  println("quic_bad_server_fin=${quicRejectsBadServerFinished()}")
  println("quic_bad_client_fin=${quicRejectsBadClientFinished()}")
}

fn main() {
  run() catch e {
    println("failed: ${e.message()}")
  }
}
