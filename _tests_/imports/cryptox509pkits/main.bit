// std/crypto X.509 path validation against AUTHORITATIVE, PUBLISHED vectors
// (#1256). The sibling `cryptox509` and `cryptotruststore` suites use a PKI we
// generated ourselves, which can only prove the verifier agrees with our own
// OpenSSL script; every certificate below is transcribed byte-for-byte from
// NIST's published X.509 path-validation test suite, so a verifier that is
// wrong in the same way our generator was wrong cannot pass.
//
// Source, pinned into this file (never fetched at test time):
//
//   NIST Public Key Interoperability Test Suite (PKITS), Certification Path
//   Validation, version 1.0.1 (posted 2011-04-14). Test data archive
//   `PKITS_data.zip`, directory `certs/`; test descriptions `PKITS.pdf`.
//   Developed by NIST with BAE Systems and NSA; covers the path validation
//   algorithm of RFC 5280 / X.509. Each certificate below names the PKITS
//   section it belongs to and the verdict that document requires.
//   https://csrc.nist.gov/projects/pki-testing
//
// All PKITS certificates are sha256WithRSAEncryption over RSA-2048 and are
// valid from 2010-01-01T08:30:00Z to 2030-12-31T08:30:00Z.
//
// SCOPE NOTE: `x509VerifyChain` is a TLS-oriented entry point -- it matches the
// hostname before anything else, so a PKITS end entity with no dNSName SAN can
// never reach the path logic through it. The two nameConstraints end entities
// are the PKITS certificates that do carry a dNSName, so they drive the full
// chain path; the remaining sections are asserted through `x509VerifySignature`
// and the parsed certificate fields, which are the same inputs the chain
// verifier consumes.
import {
  Certificate,
  x509Parse, x509VerifyChain, x509VerifySignature, x509MatchHostname,
  decodeHex,
} from "std/crypto"

// 2020-01-01T00:00:00Z: inside every PKITS validity window.
const tsValid: int = 1577836800
// 2009-01-01T00:00:00Z: before every PKITS notBefore (2010-01-01T08:30:00Z).
const tsTooEarly: int = 1230768000
// 2031-06-01T00:00:00Z: after every PKITS notAfter (2030-12-31T08:30:00Z).
const tsTooLate: int = 1938384000

// The PKITS DNS1 permitted subtree.
const hostGood: string = "testserver.testcertificates.gov"
// Outside the DNS1 permitted subtree (PKITS 4.13.31).
const hostBad: string = "testserver.invalidcertificates.gov"

fn certOf(hex: string): Certificate! {
  return x509Parse(decodeHex(hex)?)?
}

// The parse error for a certificate std/crypto must reject, or "ACCEPTED" if it
// parsed -- which for a PKITS negative fixture would be the failure.
fn parseError(hex: string): string! {
  x509Parse(decodeHex(hex)?) catch e {
    return e.message()
  }
  return "ACCEPTED"
}

fn one(c: Certificate): []Certificate {
  return append([]Certificate(0), c)
}

// Verify a chain and print one labelled line: "ok" on success, else the
// specific failure message, so each negative asserts a distinct error.
fn report(
  name: string,
  leaf: Certificate,
  inters: []Certificate,
  roots: []Certificate,
  host: string,
  now: int,
) {
  x509VerifyChain(leaf, inters, roots, host, now) catch e {
    println("${name}=${e.message()}")
    return
  }
  println("${name}=ok")
}

fn main() {
  run() catch e {
    println("setup=${e.message()}")
  }
}

fn run(): ()! {
  let anchor = certOf(hexTrustAnchor())?
  let goodCa = certOf(hexGoodCa())?
  let validEe1 = certOf(hexValidEe1())?
  let badEeSig3 = certOf(hexBadEeSig3())?
  let ncCa = certOf(hexNcDns1Ca())?
  let ncValid30 = certOf(hexNcValid30())?
  let ncInvalid31 = certOf(hexNcInvalid31())?
  let missingBc = certOf(hexMissingBc())?
  let caFalse = certOf(hexCaFalse())?
  let pathLen0 = certOf(hexPathLen0Ca())?

  // --- parsed fields: the DNs, validity window and CA flags NIST published ---
  println("anchorSubject=${anchor.subject}")
  println("anchorIsCa=${anchor.isCa} anchorSelfIssued=${anchor.subject == anchor.issuer}")
  println("goodCaSubject=${goodCa.subject}")
  println("goodCaIssuer=${goodCa.issuer}")
  println("validity=${goodCa.notBefore}..${goodCa.notAfter}")
  println("eeIssuer=${validEe1.issuer} eeIsCa=${validEe1.isCa}")
  println("ncSan=${ncValid30.dnsNames[0]}")
  println("ncBadSan=${ncInvalid31.dnsNames[0]}")

  // PKITS 4.6.1: no basicConstraints extension -> not a usable CA.
  println("missingBc_hasBasicConstraints=${missingBc.hasBasicConstraints} isCa=${missingBc.isCa}")
  // PKITS 4.6.2: basicConstraints critical, cA=FALSE -> not a usable CA.
  println("caFalse_hasBasicConstraints=${caFalse.hasBasicConstraints} isCa=${caFalse.isCa}")
  // PKITS 4.6.5: cA=TRUE with pathLenConstraint 0.
  println("pathLen0_isCa=${pathLen0.isCa} hasPathLen=${pathLen0.hasPathLen} maxPathLen=${pathLen0.maxPathLen}")

  // --- signature verification: PKITS positives and the two published forgeries ---
  // PKITS 4.1.1 Valid Certificate Path Test1: both links MUST verify.
  println("sig_goodCaUnderAnchor=${x509VerifySignature(goodCa, anchor)}")
  println("sig_validEe1UnderGoodCa=${x509VerifySignature(validEe1, goodCa)}")
  println("sig_ncCaUnderAnchor=${x509VerifySignature(ncCa, anchor)}")
  // PKITS 4.1.3 Invalid EE Signature Test3: modified EE signature MUST fail.
  println("sig_badEeSig3UnderGoodCa=${x509VerifySignature(badEeSig3, goodCa)}")
  // PKITS 4.1.6 Invalid Bad Signed CA Test6 MUST be rejected. NIST corrupted
  // this certificate by setting the unused-bits octet of the signatureValue
  // BIT STRING to 0x01 (a 2047-bit signature), so std/crypto rejects it during
  // parsing, before signature verification is ever reached. That still meets
  // the PKITS verdict; the rejection is asserted where it actually happens.
  println("parse_badSignedCa=${parseError(hexBadSignedCa())?}")
  // A correct signature checked under the wrong issuer key MUST fail.
  println("sig_validEe1UnderAnchor=${x509VerifySignature(validEe1, anchor)}")

  // --- hostname matching against the published SANs ---
  println("host_ncValidExact=${x509MatchHostname(ncValid30, hostGood)}")
  println("host_ncValidWrong=${x509MatchHostname(ncValid30, hostBad)}")
  println("host_anchorNoSan=${x509MatchHostname(anchor, hostGood)}")

  let roots = one(anchor)
  let inters = one(ncCa)
  let noInters = []Certificate(0)

  // --- full chain validation, PKITS 4.13.30: anchor -> DNS1 CA -> EE ---
  report("chain_valid30", ncValid30, inters, roots, hostGood, tsValid)
  // Same path outside the certificates' published validity window.
  report("chain_tooEarly", ncValid30, inters, roots, hostGood, tsTooEarly)
  report("chain_tooLate", ncValid30, inters, roots, hostGood, tsTooLate)
  // The intermediate withheld -> no path to a trusted root.
  report("chain_noInter", ncValid30, noInters, roots, hostGood, tsValid)
  // The Good CA offered as the only trust anchor -> no path (wrong issuer DN).
  report("chain_wrongRoot", ncValid30, inters, one(goodCa), hostGood, tsValid)
  // A PKITS end entity with no dNSName SAN cannot reach the path logic at all
  // (see the SCOPE NOTE above) -- it stops at the hostname check.
  report("chain_noSanEe", validEe1, noInters, roots, hostGood, tsValid)

  // PKITS 4.13.31 -- the DNS1 CA carries a CRITICAL nameConstraints extension
  // permitting only DNS:testcertificates.gov, and this end entity's SAN is
  // testserver.invalidcertificates.gov, so the path must be REJECTED.
  // This was a known gap (#1450): std/crypto implemented neither
  // nameConstraints nor the RFC 5280 rule that an unrecognized CRITICAL
  // extension must cause rejection, and the golden pinned the wrong
  // behaviour so the gap stayed visible. Both are implemented now.
  report("chain_invalid31_nameConstraintExcluded", ncInvalid31, inters, roots, hostBad, tsValid)
}

// PKITS trust anchor: "Trust Anchor" self-signed root (sha256WithRSAEncryption,
// RSA-2048), the trusted root for every test below.
fn hexTrustAnchor(): string {
  return ""
}

// PKITS "Good CA", a valid intermediate under the Trust Anchor.
fn hexGoodCa(): string {
  return ""
}

// PKITS 4.1.1 "Valid Certificate Path Test1" end entity, under Good CA.
fn hexValidEe1(): string {
  return ""
}

// PKITS 4.1.3 "Invalid EE Signature Test3": the end entity's signature has been
// modified, so it MUST NOT verify under Good CA.
fn hexBadEeSig3(): string {
  return ""
}

// PKITS 4.1.6 "Invalid Bad Signed CA Test6": this CA certificate's signature has
// been modified, so it MUST NOT verify under the Trust Anchor.
fn hexBadSignedCa(): string {
  return ""
}

// PKITS "nameConstraints DNS1 CA": a valid CA under the Trust Anchor carrying a
// CRITICAL nameConstraints extension permitting only DNS:testcertificates.gov.
fn hexNcDns1Ca(): string {
  return ""
}

// PKITS 4.13.30 "Valid DNS nameConstraints Test30" end entity, SAN
// DNS:testserver.testcertificates.gov -- inside the permitted subtree.
fn hexNcValid30(): string {
  return ""
}

// PKITS 4.13.31 "Invalid DNS nameConstraints Test31" end entity, SAN
// DNS:testserver.invalidcertificates.gov -- OUTSIDE the permitted subtree.
fn hexNcInvalid31(): string {
  return ""
}

// PKITS 4.6.1 "Invalid Missing basicConstraints Test1" CA: no basicConstraints
// extension at all, so it MUST NOT be usable as a CA.
fn hexMissingBc(): string {
  return ""
}

// PKITS 4.6.2 "Invalid cA False Test2" CA: basicConstraints present and critical
// with cA=FALSE, so it MUST NOT be usable as a CA.
fn hexCaFalse(): string {
  return ""
}

// PKITS 4.6.5 "pathLenConstraint0 CA": basicConstraints cA=TRUE, pathLen 0.
fn hexPathLen0Ca(): string {
  return ""
}

