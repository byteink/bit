import { udpBind, UdpSocket, Datagram } from "std/net"
import { toUpper } from "std/strings"

// Echo n datagrams back, uppercased, to whoever sent them.
fn echo(s: UdpSocket, n: int, ready: chan<int>): ()! {
  ready <- 0
  let i = 0
  while (i < n) {
    let d = s.recv(1024)?
    s.send(d.host, d.port, toUpper(d.data))?
    i = i + 1
  }
  s.close()
}

fn run(): ()! {
  let srv = udpBind("127.0.0.1", 0)?
  let port = srv.port()?

  let ready = chan<int>(1)
  spawn echo(srv, 2, ready)
  let started = <- ready

  let cli = udpBind("127.0.0.1", 0)?
  cli.send("127.0.0.1", port, "hello")?
  let r1 = cli.recv(1024)?
  println(r1.data)

  cli.send("127.0.0.1", port, "udp")?
  let r2 = cli.recv(1024)?
  println(r2.data)
  println("reply from 127.0.0.1: ${r2.host == "127.0.0.1"}")
  cli.close()
}

fn main() {
  run() catch e {
    println("failed: ${e.message()}")
  }
}
