import { Json } from "std/json"

export interface Readable {
  __field(name: string): Option<Json>,
}

export fn show(r: Readable, name: string): string {
  return match (r.__field(name)) {
    Some(j) => describe(j)
    None => "none"
  }
}

fn describe(j: Json): string {
  return match (j) {
    JsonString(s) => "str ${s}"
    JsonInt(i) => "int ${i}"
    _ => "other"
  }
}
