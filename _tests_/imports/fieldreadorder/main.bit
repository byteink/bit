// #7148: `__field` is synthesized on a class whose module loads BEFORE the module
// that declares the interface requiring it. `./models` is imported first, so it
// is parsed ahead of `./readable` and of std/json; the loader orders std/json
// ahead of it afterwards instead of loading the project twice. Run case: the
// pre-fix compiler reported E0041 here when the order was left alone.
import { User } from "./models"
import { show } from "./readable"

fn main() {
  let u = User{ id = "u1", team = "sport", age = 41 }
  println(show(u, "id"))
  println(show(u, "team"))
  println(show(u, "age"))
  println(show(u, "nope"))
}
