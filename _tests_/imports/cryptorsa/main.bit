// std/crypto RSA (#1195): RFC 8017 known-answer tests for PKCS#1 v1.5 and PSS
// signatures, RSAES-OAEP and RSAES-PKCS1-v1_5 encryption, and the four key
// parsers (PKCS#1 / SPKI public, PKCS#1 / PKCS#8 private). Every vector below was
// generated with Python `cryptography` (v49) and INDEPENDENTLY re-verified with
// raw integer math (`pow`) and hand-rolled EMSA/OAEP decoders before being locked
// here — so a miscompiled primitive cannot quietly agree with itself. PSS is
// additionally checked against an authoritative external vector set (Project
// Wycheproof `rsa_pss_2048_sha256_mgf1_32_test.json`) at the bottom of the file,
// proving interop with the standard rather than only self-consistency.
//
// The signature verify cases are deterministic (fixed signature -> fixed bool);
// PSS also round-trips a fresh signature to exercise the randomized signer; OAEP
// and v1.5 decrypt fixed ciphertexts to known plaintext; and the malformed-v1.5
// case asserts the constant-time decoder rejects bad padding with a uniform
// failure (Bleichenbacher). Each check is a small function with few live locals,
// matching the ASN.1/bigint tests' shape.
import {
  RsaPublicKey,
  RsaPrivateKey,
  rsaParsePublicKey,
  rsaParsePkcs1PublicKey,
  rsaParsePrivateKey,
  rsaParsePkcs1PrivateKey,
  rsaDigestInfoSha256,
  rsaSignPkcs1v15,
  rsaVerifyPkcs1v15,
  rsaSignPss,
  rsaVerifyPss,
  rsaEncryptOaep,
  rsaDecryptOaep,
  rsaEncryptPkcs1v15,
  rsaDecryptPkcs1v15,
  Hash,
  newSha256,
  bigintCmp,
  decodeHex,
} from "std/crypto"

// The concrete SHA-256 constructor exposed as a `() => Hash` value (newSha256
// returns the concrete `Sha256`, not the `Hash` interface).
fn sha256Hash(): Hash { return newSha256() }

// Decode a known-good hex literal; the impossible malformed case degrades to an
// empty slice so callers never have to thread a fallible result.
fn hx(s: string): []byte {
  return decodeHex(s) catch e {
    return []byte(0)
  }
}

// Byte-slice equality.
fn bytesEq(a: []byte, b: []byte): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// All four parsers agree: every modulus is the same, the exponents match, and
// the two private-key encodings recover the same private exponent.
fn checkKeys(): bool {
  let a = rsaParsePkcs1PublicKey(hx(pkcs1PubDer())) catch e {
    return false
  }
  let b = rsaParsePublicKey(hx(spkiPubDer())) catch e {
    return false
  }
  let c = rsaParsePkcs1PrivateKey(hx(pkcs1PrivDer())) catch e {
    return false
  }
  let d = rsaParsePrivateKey(hx(pkcs8PrivDer())) catch e {
    return false
  }
  if (bigintCmp(a.n, b.n) != 0 || bigintCmp(a.n, c.n) != 0 || bigintCmp(c.n, d.n) != 0) {
    return false
  }
  if (bigintCmp(a.e, c.e) != 0 || bigintCmp(c.d, d.d) != 0) {
    return false
  }
  return true
}

// EMSA-PKCS1-v1_5 verify: the genuine signature accepts, a one-bit-tampered one
// rejects.
fn checkV15Verify(valid: bool): bool {
  let pk = rsaParsePublicKey(hx(spkiPubDer())) catch e {
    return false
  }
  let sig = hx(v15SigHex())
  if (!valid) {
    sig = hx(v15SigBadHex())
  }
  return rsaVerifyPkcs1v15(pk, sha256Hash, rsaDigestInfoSha256(), hx(v15MsgHex()), sig)
}

// EMSA-PSS verify of the fixed Python KAT signature (salt length 32); the
// tampered variant rejects.
fn checkPssKat(tampered: bool): bool {
  let pk = rsaParsePublicKey(hx(spkiPubDer())) catch e {
    return false
  }
  let sig = hx(pssSigHex())
  if (tampered) {
    sig[len(sig) - 1] = sig[len(sig) - 1] ^ 0x01
  }
  return rsaVerifyPss(pk, sha256Hash, hx(pssMsgHex()), sig, 32)
}

// EMSA-PSS sign->verify round trip with a fresh random salt, proving the signer
// path and verifier path agree.
fn checkPssRoundTrip(): bool {
  let p = rsaParsePrivateKey(hx(pkcs8PrivDer())) catch e {
    return false
  }
  let pk = rsaParsePublicKey(hx(spkiPubDer())) catch e {
    return false
  }
  let msg = hx(pssMsgHex())
  let sig = rsaSignPss(p, sha256Hash, msg, 32) catch e {
    return false
  }
  return rsaVerifyPss(pk, sha256Hash, msg, sig, 32)
}

// RSAES-OAEP decrypt of a fixed ciphertext recovers the known plaintext.
fn checkOaepDecrypt(): bool {
  let p = rsaParsePrivateKey(hx(pkcs8PrivDer())) catch e {
    return false
  }
  let pt = rsaDecryptOaep(p, sha256Hash, hx(oaepCtHex()), []byte(0)) catch e {
    return false
  }
  return bytesEq(pt, hx(oaepPtHex()))
}

// RSAES-OAEP encrypt->decrypt round trip (encryption is randomized).
fn checkOaepRoundTrip(): bool {
  let pk = rsaParsePublicKey(hx(spkiPubDer())) catch e {
    return false
  }
  let p = rsaParsePrivateKey(hx(pkcs8PrivDer())) catch e {
    return false
  }
  let msg = hx(oaepPtHex())
  let ct = rsaEncryptOaep(pk, sha256Hash, msg, []byte(0)) catch e {
    return false
  }
  let pt = rsaDecryptOaep(p, sha256Hash, ct, []byte(0)) catch e {
    return false
  }
  return bytesEq(pt, msg)
}

// RSAES-PKCS1-v1_5 decrypt of a fixed valid ciphertext recovers the plaintext.
fn checkV15DecryptValid(): bool {
  let p = rsaParsePrivateKey(hx(pkcs8PrivDer())) catch e {
    return false
  }
  let pt = rsaDecryptPkcs1v15(p, hx(v15eCtHex())) catch e {
    return false
  }
  return bytesEq(pt, hx(v15ePtHex()))
}

// RSAES-PKCS1-v1_5 encrypt->decrypt round trip.
fn checkV15EncRoundTrip(): bool {
  let pk = rsaParsePublicKey(hx(spkiPubDer())) catch e {
    return false
  }
  let p = rsaParsePrivateKey(hx(pkcs8PrivDer())) catch e {
    return false
  }
  let msg = hx(v15ePtHex())
  let ct = rsaEncryptPkcs1v15(pk, msg) catch e {
    return false
  }
  let pt = rsaDecryptPkcs1v15(p, ct) catch e {
    return false
  }
  return bytesEq(pt, msg)
}

// The constant-time v1.5 decoder rejects a ciphertext whose plaintext has bad
// padding: the catch fires (uniform failure), so this returns true; a spurious
// success would fall through to false.
fn checkV15Malformed(): bool {
  let p = rsaParsePrivateKey(hx(pkcs8PrivDer())) catch e {
    return false
  }
  let pt = rsaDecryptPkcs1v15(p, hx(v15BadCtHex())) catch e {
    return true
  }
  return false
}

fn main() {
  println("keysOk=${checkKeys()}")
  println("v15VerifyValid=${checkV15Verify(true)}")
  println("v15VerifyTampered=${checkV15Verify(false)}")
  println("pssKatVerify=${checkPssKat(false)}")
  println("pssKatTampered=${checkPssKat(true)}")
  println("pssRoundTrip=${checkPssRoundTrip()}")
  println("oaepDecrypt=${checkOaepDecrypt()}")
  println("oaepRoundTrip=${checkOaepRoundTrip()}")
  println("v15DecryptValid=${checkV15DecryptValid()}")
  println("v15EncRoundTrip=${checkV15EncRoundTrip()}")
  println("v15MalformedRejected=${checkV15Malformed()}")
  println("wycheproofPss=${wycheproofPssKat()}")
}

// --- test vectors (generated + independently verified offline; see task #1195) ---
fn pkcs1PubDer(): string {
  return ""
}
fn spkiPubDer(): string {
  return ""
}
fn pkcs1PrivDer(): string {
  return ""
}
fn pkcs8PrivDer(): string {
  return ""
}
fn v15MsgHex(): string {
  return "4269742073797374656d73206c616e67756167652052534120504b4353312076312e35204b4154"
}
fn v15SigHex(): string {
  return ""
}
fn v15SigBadHex(): string {
  return ""
}
fn pssMsgHex(): string {
  return "42697420525341205053532064657465726d696e6973746963204b4154206d657373616765"
}
fn pssSigHex(): string {
  return ""
}
fn oaepPtHex(): string { return "4f41455020736563726574207061796c6f616420666f7220426974204b4154" }
fn oaepCtHex(): string {
  return ""
}
fn v15ePtHex(): string { return "706b6373312076312e352076616c6964207061796c6f6164" }
fn v15eCtHex(): string {
  return ""
}
fn v15BadCtHex(): string {
  return ""
}

// --- authoritative external KAT: Project Wycheproof (C2SP/wycheproof) ---
// rsa_pss_2048_sha256_mgf1_32_test.json, testvectors_v1. Fixed (message,
// signature) cases with a standard verdict — a true interop KAT for RSASSA-PSS,
// complementing the offline-generated vectors above with a named external source.
// Wycheproof RSASSA-PSS key (SPKI DER, 2048-bit, SHA-256/MGF1-SHA-256, sLen 32).
const wycheproofPssKeyDer: string = ""

class pssVector { msg: string, sig: string, valid: bool }

fn wycheproofPssVectors(): []pssVector {
  return [
    pssVector{
      msg: "",
      sig: "",
      valid: true,
    }, // tcId 1: valid signature
    pssVector{
      msg: "0000000000000000000000000000000000000000",
      sig: "",
      valid: true,
    }, // tcId 2: valid signature
    pssVector{
      msg: "54657374",
      sig: "",
      valid: true,
    }, // tcId 3: valid signature
    pssVector{
      msg: "313233343030",
      sig: "",
      valid: true,
    }, // tcId 4: valid signature
    pssVector{
      msg: "313233343030",
      sig: "",
      valid: false,
    }, // tcId 62: first byte of m_hash modified
    pssVector{
      msg: "313233343030",
      sig: "",
      valid: false,
    }, // tcId 63: first byte of m_hash modified
    pssVector{
      msg: "313233343030",
      sig: "",
      valid: false,
    }, // tcId 64: last byte of m_hash modified
    pssVector{
      msg: "313233343030",
      sig: "",
      valid: false,
    }, // tcId 65: last byte of m_hash modified
  ]
}

// picked 8 cases: 4 valid, 4 invalid

// Verify every Wycheproof RSASSA-PSS case against std/crypto and require the
// verdict to match the vector's expected valid/invalid (salt length 32).
fn wycheproofPssKat(): bool {
  let pub = rsaParsePublicKey(hx(wycheproofPssKeyDer)) catch e {
    return false
  }
  for v of wycheproofPssVectors() {
    let got = rsaVerifyPss(pub, sha256Hash, hx(v.msg), hx(v.sig), 32)
    if (got != v.valid) {
      return false
    }
  }
  return true
}
