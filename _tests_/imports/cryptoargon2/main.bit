// std/crypto Argon2 (#1174): the RFC 9106 §5 known-answer vectors for all three
// variants, plus a PHC-string round trip. Every vector uses the RFC's fixed
// inputs — password = 32x0x01, salt = 16x0x02, secret K = 8x0x03, associated
// data X = 12x0x04, with t=3, m=32 KiB, p=4, and a 32-byte tag — so the three
// tags (Argon2d/i/id) are the exact values printed in RFC 9106 and are stable
// across architectures. `argon2Hash`/`argon2Verify` then confirm the PHC crypt
// string round-trips: a freshly produced hash verifies, a wrong password does
// not, and a tampered field is rejected.
import {
  argon2d, argon2i, argon2id, argon2Hash, argon2Verify, encodeHex,
} from "std/crypto"

// The RFC 9106 §5 fixed test inputs.
fn fill(n: int, v: byte): []byte {
  let b = []byte(n)
  let i = 0
  while (i < n) {
    b[i] = v
    i = i + 1
  }
  return b
}

fn run() {
  let pwd = fill(32, 0x01)
  let salt = fill(16, 0x02)
  let secret = fill(8, 0x03)
  let ad = fill(12, 0x04)

  // RFC 9106 §5 test vectors (t=3, m=32, p=4, tag=32).
  println("d =${encodeHex(argon2d(pwd, salt, secret, ad, 3, 32, 4, 32))}")
  println("i =${encodeHex(argon2i(pwd, salt, secret, ad, 3, 32, 4, 32))}")
  println("id=${encodeHex(argon2id(pwd, salt, secret, ad, 3, 32, 4, 32))}")

  // PHC round trip: a produced Argon2id hash verifies for the right password and
  // rejects a wrong one; a tampered string is rejected too.
  let hash = argon2Hash([]byte("hunter2"), []byte("somesalt12345678"), 3, 32, 4, 32)
  println("phc=${hash}")
  println("ok=${argon2Verify([]byte("hunter2"), hash)}")
  println("bad=${argon2Verify([]byte("wrong"), hash)}")
  println("tamper=${argon2Verify([]byte("hunter2"), "$argon2id$v=19$m=32,t=3,p=4$c29tZXNhbHQxMjM0NTY3OA$AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")}")
}

fn main() {
  run()
}
