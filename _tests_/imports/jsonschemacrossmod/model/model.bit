// #6170: `Widget` never calls `jsonSchema<T>()` itself — it is demanded
// from main.bit, a DIFFERENT module. `Json`/`JsonEntry` are imported here
// for `@json`'s own sake (E0142), which is what every `@json` class already
// owes regardless of this feature; what this fixture actually exercises is
// main.bit's own import of the generated `__json_schema_Widget`, which
// nothing in THIS file ever writes by hand.
import { Json, JsonEntry } from "std/json"

export @json class Widget {
  id: i64,
  name: string,
}
