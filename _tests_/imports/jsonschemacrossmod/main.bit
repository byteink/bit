// #6170: import wiring for a `jsonSchema<T>()` call whose `T` is declared in
// a DIFFERENT module. `rewriteJsonSchemaCalls` (classjsonschemacall.bit)
// rewrites the call below to `__json_schema_Widget()`, and without this
// ticket's own `jsonSchemaImportDecls` synthesizing the import, that name
// would be undefined here (`model/model.bit` never exports it by hand —
// nothing in this project writes `__json_schema_Widget` anywhere).
import { Widget } from "./model"
import { jsonSchema, jsonEncode } from "std/json"

fn main() {
  print("${jsonEncode(jsonSchema<Widget>())}\n")
}
