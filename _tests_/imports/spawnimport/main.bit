// #1428: `spawn` across a module boundary. Cross-module `spawn` appeared
// nowhere in the corpus, which is why the self-hosted compiler shipped emitting
// an undefined symbol for it — every one of the existing spawn sites targets a
// same-module callee, where the module prefix is empty and the bug cancels out.
import { work, relay } from "./worker"
fn main() {
  let c = chan<int>(1)
  spawn work(5, c)
  println("imported = ${<- c}")
  spawn relay(11, c)
  println("imported generic = ${<- c}")
  defer println("deferred last")
}
