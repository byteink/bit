// std/regex full Unicode simple case folding for `(?i)` (#2033), replacing
// the ASCII-only fold. Every expected value was cross-checked against Go's
// `regexp` (go1.27.0) before being pinned.

import { mustCompile } from "std/regex"

fn matches(pattern: string, s: string): string {
  return "${mustCompile(pattern).matches(s)}"
}

fn main() {
  // --- ä/Ä: a non-ASCII letter pair, both directions ----------------------
  println(matches("(?i)ä", "Ä")) // true
  println(matches("(?i)Ä", "ä")) // true

  // --- σ/Σ/ς: a three-member orbit (capital, lowercase, Greek final form),
  // every direction --------------------------------------------------------
  println(matches("(?i)σ", "Σ")) // true
  println(matches("(?i)σ", "ς")) // true
  println(matches("(?i)Σ", "σ")) // true
  println(matches("(?i)Σ", "ς")) // true
  println(matches("(?i)ς", "σ")) // true
  println(matches("(?i)ς", "Σ")) // true

  // --- k matching U+212A KELVIN SIGN (visually identical to Latin "K" in
  // most fonts, but a distinct codepoint) -----------------------------------
  println(matches("(?i)k", "K")) // true
  println(matches("(?i)K", "k")) // true

  // --- s matching U+017F LATIN SMALL LETTER LONG S -------------------------
  println(matches("(?i)s", "ſ")) // true
  println(matches("(?i)ſ", "S")) // true

  // --- (?i)[a-z] only covers what it literally names: a Cyrillic capital
  // is NOT folded in, since it was never part of the base range -----------
  println(matches("(?i)[a-z]", "Д")) // false

  // --- (?i)[α-ω] correctly folds in the corresponding capitals ------------
  println(matches("(?i)[α-ω]", "Ω")) // true
  println(matches("(?i)[α-ω]", "Α")) // true

  // --- ß does NOT match "ss": full (multi-character) folding is out of
  // scope by design, pinned explicitly so the documented boundary holds ---
  println(matches("(?i)ß", "ss")) // false

  // --- ASCII folding still works exactly as before -------------------------
  println(matches("(?i)abc", "ABC"))       // true
  println(matches("(?i)[a-f]+", "ABCDEF")) // true
}
