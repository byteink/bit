// A module whose exported const and module state are each SHADOWED by a
// function-local of the same name. Shadowing a module-level name is legal
// (E0048 is a warning), and an importer must still see the module-level type.
export const q: f64 = 1.5
let counter: int = 7

// Module state is module-private (SPEC 11.11), so it is read through a function.
export fn readCounter(): int {
  return counter
}

export fn bump(n: int): int {
  // The shadowing locals. `q` here is an int; the exported `q` is an f64.
  let q = n + 1
  let counter = q * 2
  return counter
}
