// std/crypto ML-DSA-65 signatures (FIPS 204, #1199): NIST ACVP known-answer
// tests. keyGen derives (pk, sk) from a 32-byte seed; sigGen signs deterministically
// (rnd = 0) with a context and pins the byte-exact signature; sigVer covers a valid
// signature plus two tampered ones (a modified z and a modified hint). Every vector is
// verbatim from the NIST ACVP ML-DSA-65 test data (ML-DSA-{keyGen,sigGen,sigVer}-FIPS204,
// internalProjection.json) and was independently reproduced with the pure-Python
// `dilithium-py` reference before locking. A final self-derived round-trip exercises the
// keygen -> sign -> verify chain and the empty-context API, including a negative.
import {
  mldsaKeygenSeed, mldsaSign, mldsaSignCtx, mldsaVerify, mldsaVerifyCtx,
  encodeHex, decodeHex,
} from "std/crypto"

// Derive a key pair from `seedHex` and report whether the packed public and
// secret keys match the ACVP vectors.
fn keygenKat(tag: string, seedHex: string, pkHex: string, skHex: string): ()! {
  let kp = mldsaKeygenSeed(decodeHex(seedHex)?)
  println("${tag}_pk_ok=${encodeHex(kp.pk) == pkHex}")
  println("${tag}_sk_ok=${encodeHex(kp.sk) == skHex}")
}

// Sign `msgHex` under `skHex` with context `ctxHex`; report byte-exactness against
// the ACVP signature and that it self-verifies under the vector's public key.
fn siggenKat(tag: string, skHex: string, pkHex: string, msgHex: string, ctxHex: string, sigHex: string): ()! {
  let sk = decodeHex(skHex)?
  let msg = decodeHex(msgHex)?
  let ctx = decodeHex(ctxHex)?
  let sig = mldsaSignCtx(sk, msg, ctx)
  println("${tag}_ok=${encodeHex(sig) == sigHex}")
  println("${tag}_vf=${mldsaVerifyCtx(decodeHex(pkHex)?, msg, sig, ctx)}")
}

// Verify an ACVP sigVer vector and print the accept/reject result.
fn verKat(tag: string, pkHex: string, msgHex: string, ctxHex: string, sigHex: string): ()! {
  let ok = mldsaVerifyCtx(decodeHex(pkHex)?, decodeHex(msgHex)?, decodeHex(sigHex)?, decodeHex(ctxHex)?)
  println("${tag}=${ok}")
}

fn run(): ()! {
  keygenKat("kg1", "1bd67dc782b2958e189e315c040dd1f64c8ab232a6a170e1a7a52c33f10851b1", "", "")?
  keygenKat("kg2", "b850d898a3d3d11c4e64ade5a86ffed951b237c60d2a67a2def0a792b8f6990d", "", "")?
  siggenKat("sg1", "", "", "8f", "e9e7aa56c7975dc9b4ddba302b0045bb7a6dea96e798c6911143", "")?
  siggenKat("sg2", "", "", "a54cb4bf79ddce7d7c446f972a849dc3c75917e7ed52777590d49ba28a8171b107650cc74348c2fd5aa5327fed13bbdf514eccd477f4d5b213f8083cdb2923afc35dabe663ee12932e8fdcc3058b6d991176cbad", "0a8b9249c5794768ef495af6483c80047295783a33dbb8b1", "")?
  verKat("sv35", "", "", "", "")?
  verKat("sv42", "", "23", "f0a9948d8abab83e7d31a37028a4cabce644281008225a0be7112172acacd72f30eddcd7fcf5df6b10d03d3c6e50c6c6285728d15a7d55cd8090836925c90fbb6e11c1ef6bf3130f16838e5ef0db9c6b7a463bbb", "")?
  verKat("sv44", "", "", "", "")?

  // Round-trip on a self-derived key (empty-context API) plus a negative.
  let kp = mldsaKeygenSeed(decodeHex("1bd67dc782b2958e189e315c040dd1f64c8ab232a6a170e1a7a52c33f10851b1")?)
  let rmsg = []byte("bit ml-dsa round-trip")
  let rsig = mldsaSign(kp.sk, rmsg)
  println("rt_vf=${mldsaVerify(kp.pk, rmsg, rsig)}")
  rsig[100] = rsig[100] ^ 0x01
  println("rt_bad=${mldsaVerify(kp.pk, rmsg, rsig)}")
}

fn main() {
  run() catch e {
    println("failed: ${e.message()}")
  }
}
