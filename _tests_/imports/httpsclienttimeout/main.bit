// #2995: std/http's request timeout covered http:// only - an https://
// request against a server that accepted and never answered parked
// forever, because tlsDial carried no deadline. This is the https twin of
// _tests_/imports/httpclienttimeout (#2291), same three things checked:
//
//   1. a whole-request deadline against a silent TLS-port server (the peer
//      accepts the TCP connection and the ClientHello, then never sends a
//      byte back - no TLS handshake needed on the server side to prove
//      this, since the client parks waiting for the ServerHello) returns an
//      error, not a park, within a wide bound;
//   2. that error names the timeout, and is a DIFFERENT error than a peer
//      that closes the TCP connection outright before any TLS bytes come
//      back - the two must never be confusable;
//   3. the connection a timed-out request used is released, not leaked -
//      proven by repeating a timed-out request many times against the same
//      silent server, then confirming a real https request (full TLS
//      handshake, against a throwaway test CA loopback server, exactly as
//      _tests_/imports/httpsclient sets up) still succeeds immediately
//      afterward.
//
// Exact elapsed milliseconds are not printed, matching httpclienttimeout's
// own convention - this repo's dev machines run several concurrent agents.
import { listen, Listener, Conn } from "std/net"
import { getTimeout, getTls, serveTls, ok, Server } from "std/http"
import { decodeHex, pemEncode } from "std/crypto"
import { newTlsConfig, newTrustStore, TlsConfig } from "std/tls"
import { sleep, Millisecond, Second, monotonic, since, toMillis } from "std/time"
import { indexOf } from "std/strings"

// The same throwaway test CA + leaf + key _tests_/imports/httpsclient uses
// (leaf SAN: localhost, example.com), so a real handshake can complete
// without touching the network.
const caHex: string = ""
const leafHex: string = ""
const keyHex: string = ""

const testPort: int = 47064

fn hx(s: string): []byte {
  return decodeHex(s) catch e {
    return []byte(0)
  }
}
fn pemOf(label: string, h: string): string { return pemEncode(label, hx(h)) }

// Accepts, reads whatever the client sent (the ClientHello), then holds the
// connection open without ever answering - the peer never sends a
// ServerHello, so the client's TLS handshake parks waiting for one. No real
// TLS handshake needs to run on this side to reproduce the park.
fn silent(c: Conn) {
  let _req = c.read(4096)
  sleep(Second * 30)
  c.close()
}

fn acceptSilently(l: Listener) {
  while (true) {
    let c = l.accept() catch _ {
      return
    }
    spawn silent(c)
  }
}

// Case 1: a 500ms deadline against a silent TLS-port server returns an
// error within a wide bound, and the error names the timeout.
fn caseTimeoutFires(): ()! {
  let l = listen("127.0.0.1", 0)?
  let port = l.port()?
  spawn acceptSilently(l)
  let t0 = monotonic()
  let r = getTimeout("https://127.0.0.1:${port}/x", 500) catch e {
    let elapsedMs = toMillis(since(t0))
    let within = elapsedMs > 400 && elapsedMs < 5000
    let namesTimeout = indexOf(e.message(), "timed out") >= 0
    print("case1 timeout-fires -> within-bounds=${within} names-timeout=${namesTimeout}\n")
    l.close()
    return
  }
  print("case1 FAILED: request unexpectedly succeeded (status ${r.status})\n")
  l.close()
}

// Accepts, reads whatever the client sent, then closes the TCP connection
// outright - a CLEAN close before any TLS bytes come back, not a stall.
fn closer(c: Conn) {
  let _req = c.read(4096)
  c.close()
}

fn acceptAndClose(l: Listener) {
  while (true) {
    let c = l.accept() catch _ {
      return
    }
    spawn closer(c)
  }
}

// Case 2: a clean TCP close is a DIFFERENT error than a timeout.
fn caseCleanCloseDiffers(): ()! {
  let l = listen("127.0.0.1", 0)?
  let port = l.port()?
  spawn acceptAndClose(l)
  let r = getTimeout("https://127.0.0.1:${port}/x", 5000) catch e {
    let namesTimeout = indexOf(e.message(), "timed out") >= 0
    print("case2 clean-close-differs -> says-timed-out=${namesTimeout}\n")
    l.close()
    return
  }
  print("case2 FAILED: request unexpectedly succeeded (status ${r.status})\n")
  l.close()
}

// A client config trusting the test CA, pinning the SNI/name to the leaf's
// SAN and the clock to a value inside the certificate's validity window -
// the same shape _tests_/imports/httpsclient's clientCfg() uses.
fn clientCfg(): TlsConfig! {
  let cfg = newTlsConfig(newTrustStore(pemOf("CERTIFICATE", caHex))?)
  cfg.serverName = "localhost"
  cfg.alpn = ["http/1.1"]
  cfg.nowUnix = 1800000000
  return cfg
}

fn route(): string { return "hi" }

fn answerOnce(s: Server) {
  let ex = s.accept() catch _ {
    return
  }
  let req = ex.read() catch _ {
    return
  }
  ex.respond(ok(route())) catch _ {}
}

// One attempt against the silent server: true iff it failed with a
// "timed out" error, exactly as case 1 expects.
fn oneTimeoutAttempt(port: int): bool {
  let r = getTimeout("https://127.0.0.1:${port}/x", 150) catch e {
    return indexOf(e.message(), "timed out") >= 0
  }
  return false
}

// Case 3: repeating the timed-out request does not leak the connection -
// proven by a REAL https request (full TLS handshake against a throwaway
// test-CA loopback server) still succeeding immediately afterward.
fn caseNoLeak(): ()! {
  let l = listen("127.0.0.1", 0)?
  let port = l.port()?
  spawn acceptSilently(l)
  let n = 20
  let i = 0
  let allTimedOut = true
  while (i < n) {
    if (!oneTimeoutAttempt(port)) {
      allTimedOut = false
    }
    i = i + 1
  }
  l.close()
  print("case3 repeated-timeouts -> all-timed-out=${allTimedOut}\n")

  let cfg = clientCfg()?
  spawn server()
  let attempt = 0
  while (attempt < 200) {
    let r = getTls("https://127.0.0.1:${testPort}/", cfg) catch e {
      sleep(10 * Millisecond)
      attempt = attempt + 1
      continue
    }
    print("case3 followup-request -> status=${r.status} body=${r.body}\n")
    return
  }
  print("case3 followup-request FAILED: server did not come up\n")
}

fn server() {
  serveTls(
    "127.0.0.1",
    testPort,
    pemOf("CERTIFICATE", leafHex),
    pemOf("PRIVATE KEY", keyHex),
    (req) => ok(route()),
  ) catch e {
    println("server error: ${e.message()}")
  }
}

fn main() {
  caseTimeoutFires() catch e {
    print("case1 failed: ${e.message()}\n")
  }
  caseCleanCloseDiffers() catch e {
    print("case2 failed: ${e.message()}\n")
  }
  caseNoLeak() catch e {
    print("case3 failed: ${e.message()}\n")
  }
}
