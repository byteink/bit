// std/crypto X25519 ECDH (#1190): RFC 7748 known-answer tests.
//
// The scalar-mult and DH vectors are RFC 7748 §5.2 (two direct x25519 vectors)
// and §6.1 (the Alice/Bob key exchange), every value re-derived offline with an
// independent pure-integer ladder and the reference `cryptography` library
// before being locked into the sibling `expected` file — a miscompiled ladder
// cannot quietly agree with itself. `alice_pub`/`bob_pub` also pin `x25519Base`
// (u = 9), and `shared_ab`/`shared_ba` pin the ECDH symmetry `s(a,B) == s(b,A)`.
//
// Coverage beyond the fixed vectors: the all-zero contributory check
// (`x25519SharedSecret` against a zero peer point must be rejected); the DH
// symmetry over two freshly generated key pairs (exercising
// `x25519GenerateKeypair` without depending on the non-deterministic RNG); and
// the shape of a generated key pair (32-byte private and public halves).
import {
  x25519, x25519Base, x25519SharedSecret, x25519GenerateKeypair, X25519Keypair,
  encodeHex, decodeHex,
} from "std/crypto"

// The bytes of a hex literal; a malformed literal degrades to empty, which any
// downstream length check catches.
fn fromHex(s: string): []byte {
  return decodeHex(s) catch e {
    return []byte(0)
  }
}

// The hex of the shared secret for `scalar` against peer point `u`; "err" if the
// contributory check rejects it.
fn sharedHex(scalar: []byte, u: []byte): string {
  let s = x25519SharedSecret(scalar, u) catch e {
    return "err"
  }
  return encodeHex(s)
}

// Whether two byte slices are identical.
fn sameBytes(a: []byte, b: []byte): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// Whether an all-zero peer point is rejected by the shared-secret check.
fn rejectsLowOrder(scalar: []byte): bool {
  let zero = []byte(32)
  x25519SharedSecret(scalar, zero) catch e {
    return true
  }
  return false
}

// Whether two independent key pairs agree on the shared secret from both sides.
fn keypairsAgree(): bool {
  let a = x25519GenerateKeypair()
  let b = x25519GenerateKeypair()
  let sa = x25519SharedSecret(a.priv, b.pub) catch e {
    return false
  }
  let sb = x25519SharedSecret(b.priv, a.pub) catch e {
    return false
  }
  return sameBytes(sa, sb)
}

fn main() {
  // RFC 7748 §5.2: direct x25519(scalar, u) vectors.
  println(
    "v1=${encodeHex(
      x25519(
        fromHex("a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4"),
        fromHex("e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c"),
      ),
    )}",
  )
  println(
    "v2=${encodeHex(
      x25519(
        fromHex("4b66e9d4d1b4673c5ad22691957d6af5c11b6421e0ea01d42ca4169e7918ba0d"),
        fromHex("e5210f12786811d3f4b7959d0538ae2c31dbe7106fc03c3efc4cd549c715a493"),
      ),
    )}",
  )

  // RFC 7748 §6.1: Alice/Bob key exchange.
  let alicePriv = fromHex("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a")
  let bobPriv = fromHex("5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb")
  let alicePub = x25519Base(alicePriv)
  let bobPub = x25519Base(bobPriv)
  println("alice_pub=${encodeHex(alicePub)}")
  println("bob_pub=${encodeHex(bobPub)}")
  println("shared_ab=${sharedHex(alicePriv, bobPub)}")
  println("shared_ba=${sharedHex(bobPriv, alicePub)}")

  // Contributory / small-subgroup check and generated-key-pair properties.
  println("reject_lowzero=${rejectsLowOrder(alicePriv)}")
  println("kp_agree=${keypairsAgree()}")
  let kp = x25519GenerateKeypair()
  println("priv_len=${len(kp.priv)}")
  println("pub_len=${len(kp.pub)}")
}
