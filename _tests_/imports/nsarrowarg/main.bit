// #4576: an arrow argument to a NAMESPACE-QUALIFIED call `ns.fn((x) => …)`
// passed `bit check` clean and then refused to emit — `error[E0092]: cannot
// lower a call whose callee does not resolve to a function`, pointing inside
// the arrow body.
//
// The callee `h.take` is a `Tag.Member`, so `seedArrowExpectedCall`
// (compiler/checkarrow.bit) sent it to the METHOD path, which types the
// receiver and gets 0 — a namespace alias is not a value and has no type of
// its own. That answer is identical to the one a genuinely unresolved receiver
// gives, so the call returned having seeded nothing and `x` stayed at type 0.
// The two are told apart by `nsQualifiedName`, which is what `checkMember`
// itself consults before typing a receiver.
//
// Multi-file by construction: only a real namespace import binds an alias, so
// this belongs here rather than under `_tests_/cases`.
import * as h from "./helper"
import helper from "./helper"

fn main() {
  // The report's own case: `import * as` alias, free function of the imported
  // module, arrow in the second argument.
  println("ns ${h.take(h.mkThing(7), (x) => x.v())}")

  // The other spelling that binds a namespace — same dotted callee shape.
  println("ns2 ${helper.take(helper.mkThing(8), (x) => x.v())}")

  // Control: a REAL method with the identical arrow argument, on a receiver
  // that IS a value. The method path must keep owning this one.
  println("method ${helper.mkThing(9).apply((x) => x.v())}")
}
