// The module #4576's root reaches through a NAMESPACE binding. `take` is the
// report's own callee: a free function of another module whose second
// parameter is a function type, so an arrow written at the call site has an
// expected type only if the seeding pass resolves the dotted callee.
//
// `Thing.apply` is the control: a REAL method taking the identical arrow
// argument, on a receiver that is a value. It must keep resolving through
// `methodSigLookup` on the method path, never through the value path.
export class Thing {
  n: int

  export v(): int {
    return this.n
  }

  export apply(next: Inner): int {
    return next(this)
  }
}

export type Inner = (Thing) => int

export fn take(t: Thing, next: Inner): int {
  return next(t)
}

export fn mkThing(n: int): Thing {
  return Thing{ n: n }
}
