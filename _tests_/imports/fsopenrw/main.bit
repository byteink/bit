import { openReadWrite, exists, remove, File } from "std/fs"

// The pkg/kv-shaped use case #3533/#3536/#3545 exist for: one fd, opened
// once, that supports both readAt and writeAt -- unlike open()/create(),
// which are read-only xor create+truncate write-only.

fn page(n: byte): []byte {
  let b = []byte(512)
  let i = 0
  while (i < 512) {
    b[i] = n
    i = i + 1
  }
  return b
}

// Writes 3 known pages, then reads page 1 back on the SAME fd -- no
// close/reopen between directions.
fn writeThenReadBack(f: File) {
  f.writeAt(page(byte(1)), 0) catch println("write p0 failed")
  f.writeAt(page(byte(2)), 512) catch println("write p1 failed")
  f.writeAt(page(byte(3)), 1024) catch println("write p2 failed")

  let buf = []byte(512)
  let n = f.readAt(buf, 512) catch 0 - 1
  println("read_n=${n} first_byte=${buf[0]} last_byte=${buf[511]}")
}

// Reopens an EXISTING file: content must survive (no truncation).
fn reopenAndVerify(path: string) {
  let f2 = openReadWrite(path) catch e {
    println("reopen failed: ${e.message()}")
    return
  }
  let buf0 = []byte(512)
  let n0 = f2.readAt(buf0, 0) catch 0 - 1
  let buf2 = []byte(512)
  let n2 = f2.readAt(buf2, 1024) catch 0 - 1
  println("reopen_p0=${n0}/${buf0[0]} reopen_p2=${n2}/${buf2[0]}")
  f2.close()
}

fn main() {
  let path = "/tmp/bit-fsopenrw-store.bin"
  if (exists(path)) {
    remove(path) catch println("cleanup failed")
  }

  let f = openReadWrite(path) catch e {
    println("create failed: ${e.message()}")
    return
  }
  println("created=${exists(path)}")

  writeThenReadBack(f)
  f.close()

  reopenAndVerify(path)

  remove(path) catch println("final cleanup failed")
  println("cleaned=${!exists(path)}")
}
