// Sample Bit program — exercises every token class for the highlighter.
/* Block comment:
   keywords, types, strings, interpolation, numbers, operators. */

import * as fs from "std/fs"
import { parseInt } from "std/strings"

interface Shape { area(): f64 }

class Circle {
  export r: f64
  area(): f64 { return 3.14159265 * this.r * this.r }
}
class Rect {
  export w: f64
  export h: f64
  area(): f64 { return this.w * this.h }
}

// Numbers: decimal, hex, octal, binary, float, hex-float, separators.
const limit = 1_000_000
const mask = 0xFF_00
const perms = 0o755
const flags = 0b1010_0101
const ratio = 6.022e23
const tiny = 0x1.8p-4

fn totalArea<T: Shape>(shapes: []T): f64 {
  let sum = 0.0
  for s of shapes {
    sum += s.area()
  }
  return sum
}

fn loadCount(path: string): int! {
  let text = fs.readFile(path)?
  return parseInt(text)?
}

fn sumSquares(n: int): int {
  let results = chan<int>(n)
  for (let i = 1; i <= n; i++) {
    spawn worker(i, results)
  }
  let total = 0
  for (let k = 0; k < n && k != -1; k++) {
    total += <- results
  }
  return total
}

fn worker(x: int, out: chan<int>) {
  out <- x * x
}

fn main(): ()! {
  let ch = 'A'
  let esc = "tab\tnewline\n dollar \$ unicode \u{1F600}"
  // An unmatched `${` on purpose: a well-formed `${...}` pair in a raw string
  // draws warning E0098 (SPEC 5.7), and every warning in the tree fails
  // test-no-warnings. The grammar's raw-string rule still gets its case: `${`
  // and `\n` inside backticks must stay plain string, never interpolation or
  // an escape.
  let raw = `no ${escapes or \n here`
  let shapes: []Shape = [Circle{ r = 1.0 }, Rect{ w = 2.0, h = 3.0 }]
  let ok = (true && !false) || nil == nil
  println("area = ${totalArea(shapes)} at depth ${Rect{ w = 1.0, h = 2.0 }.area()}")
  let count = loadCount("count.txt") catch 0
  println("count = ${count}, char = ${ch}")
  return
}
