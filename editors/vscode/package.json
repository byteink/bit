{
  "name": "bit",
  "displayName": "Bit Language",
  "description": "Syntax highlighting for the Bit programming language.",
  "version": "0.1.0",
  "publisher": "byteink",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bit",
        "aliases": ["Bit", "bit"],
        "extensions": [".bit"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bit",
        "scopeName": "source.bit",
        "path": "./syntaxes/bit.tmLanguage.json"
      }
    ]
  }
}
