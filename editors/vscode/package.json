{
  "name": "bit",
  "displayName": "Bit Language",
  "description": "Language support for Bit: syntax highlighting, diagnostics, hover, goto-definition, completions, and format-on-save via bit.",
  "version": "0.1.0",
  "publisher": "byteink",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/byteink/bit.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:bit"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "bit",
        "aliases": ["Bit", "bit"],
        "extensions": [".bit"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bit",
        "scopeName": "source.bit",
        "path": "./syntaxes/bit.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Bit",
      "properties": {
        "bit.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the bit binary. Empty auto-discovers it on PATH."
        },
        "bit.formatOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run `bit fmt` on a .bit file after it is saved."
        },
        "bit.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace LSP communication between the extension and bit lsp."
        }
      }
    },
    "commands": [
      {
        "command": "bit.restartServer",
        "title": "Bit: Restart Language Server"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18",
    "compile": "npm run esbuild-base -- --sourcemap",
    "watch": "npm run esbuild-base -- --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "vscode-languageclient": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
