{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Bit",
  "scopeName": "source.bit",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#builtin-functions" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#function-calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.bit",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.bit" }
          }
        },
        {
          "name": "comment.block.bit",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.bit" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.bit" }
          }
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.bit",
          "match": "\\b(break|case|catch|continue|default|defer|else|fail|for|if|match|return|select|spawn|switch|while)\\b"
        },
        {
          "name": "keyword.control.import.bit",
          "match": "\\b(import|export|from)\\b"
        },
        {
          "name": "keyword.operator.word.bit",
          "match": "\\b(as|in|of)\\b"
        },
        {
          "name": "storage.type.function.bit",
          "match": "\\bfunction\\b"
        },
        {
          "name": "storage.type.bit",
          "match": "\\b(chan|const|interface|let|map|struct|type)\\b"
        }
      ]
    },

    "constants": {
      "name": "constant.language.bit",
      "match": "\\b(true|false|nil)\\b"
    },

    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.bit",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|int|uint|byte|rune|bool|string|error)\\b"
        },
        {
          "comment": "Heuristic: capitalized identifiers read as user-defined types. Refined by the LSP ticket, which has real name resolution.",
          "name": "entity.name.type.bit",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },

    "builtin-functions": {
      "name": "support.function.builtin.bit",
      "match": "\\b(len|cap|append|delete|close|panic|assert)\\b"
    },

    "function-calls": {
      "comment": "Any identifier immediately followed by '(' is styled as a call/definition name.",
      "name": "entity.name.function.bit",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.hex.bit",
          "match": "\\b0[xX][0-9a-fA-F](_?[0-9a-fA-F])*(\\.([0-9a-fA-F](_?[0-9a-fA-F])*)?)?[pP][+-]?[0-9](_?[0-9])*\\b"
        },
        {
          "name": "constant.numeric.integer.hex.bit",
          "match": "\\b0[xX][0-9a-fA-F](_?[0-9a-fA-F])*\\b"
        },
        {
          "name": "constant.numeric.integer.octal.bit",
          "match": "\\b0[oO][0-7](_?[0-7])*\\b"
        },
        {
          "name": "constant.numeric.integer.binary.bit",
          "match": "\\b0[bB][01](_?[01])*\\b"
        },
        {
          "name": "constant.numeric.float.decimal.bit",
          "match": "(\\b[0-9](_?[0-9])*\\.([0-9](_?[0-9])*)?([eE][+-]?[0-9](_?[0-9])*)?|\\.[0-9](_?[0-9])*([eE][+-]?[0-9](_?[0-9])*)?|\\b[0-9](_?[0-9])*[eE][+-]?[0-9](_?[0-9])*)"
        },
        {
          "name": "constant.numeric.integer.decimal.bit",
          "match": "\\b(0|[1-9](_?[0-9])*)\\b"
        }
      ]
    },

    "strings": {
      "patterns": [
        { "include": "#string-interpreted" },
        { "include": "#string-raw" },
        { "include": "#rune" }
      ]
    },

    "string-interpreted": {
      "name": "string.quoted.double.bit",
      "begin": "\"",
      "end": "\"|(?=$)",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.bit" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.bit" }
      },
      "patterns": [
        { "include": "#string-escape" },
        { "include": "#interpolation" }
      ]
    },

    "string-raw": {
      "name": "string.quoted.raw.bit",
      "begin": "`",
      "end": "`",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.bit" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.bit" }
      }
    },

    "rune": {
      "name": "constant.character.rune.bit",
      "begin": "'",
      "end": "'|(?=$)",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.character.begin.bit" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.character.end.bit" }
      },
      "patterns": [
        { "include": "#string-escape" }
      ]
    },

    "string-escape": {
      "name": "constant.character.escape.bit",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|[nrt\\\\'\"0$])"
    },

    "interpolation": {
      "name": "meta.interpolation.bit",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.interpolation.begin.bit" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.interpolation.end.bit" }
      },
      "patterns": [
        { "include": "#curly-braces" },
        { "include": "$self" }
      ]
    },

    "curly-braces": {
      "comment": "Balances nested braces inside interpolation so a composite literal '{...}' does not close the interpolation early.",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "#curly-braces" },
        { "include": "$self" }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.bit",
          "comment": "Bare '=' guarded so '==' (comparison) and '=>' (arrow) are not stolen as single-char assignment; vscode-textmate is first-match, not maximal-munch.",
          "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|=(?![=>])"
        },
        {
          "name": "keyword.operator.comparison.bit",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.logical.bit",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.channel.bit",
          "match": "<-"
        },
        {
          "name": "keyword.operator.arrow.bit",
          "match": "=>"
        },
        {
          "name": "keyword.operator.spread.bit",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.increment.bit",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.bitwise.bit",
          "match": "<<|>>|&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.arithmetic.bit",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.relational.bit",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.propagate.bit",
          "match": "\\?"
        }
      ]
    }
  }
}
