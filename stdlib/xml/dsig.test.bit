// stdlib/xml/dsig.test.bit: XML-DSig verification (`verifySignature`).
//
// Valid documents: 7, signed by libxmlsec (see dsig_vectors.test.bit): RSA-SHA256
// and ECDSA-SHA256, each over a Response and over an Assertion, each with and
// without InclusiveNamespaces, plus one SHA-1 digest accepted only by option.
//
// Attacks: the eight signature wrapping shapes of Somorovsky et al., "On
// Breaking SAML: Be Whoever You Want to Be" (USENIX Security 2012), built here
// as the paper describes them (the signed element or its Signature moved, an
// evil element put where the application reads), and 22 more: duplicate ID,
// second Reference, second Signature, SHA-1 digest, XPath transform, a swapped
// element, key kind mismatch both ways, a tampered digest and signature value,
// external and empty URIs, SHA-1 and unknown signature methods, inclusive
// and with-comments canonicalization, a 1024-bit key, a wrong key, a comment
// in DigestValue, text and an Object in Signature, and the limits. Each is
// refused with the message of the rule that should refuse it, so a rule that
// is removed turns its own test red and is not covered by another's.
//
// `tree` is in tree.test.bit. `Nat`, `bigintFromBytes" and the key types come
// in through dsig.bit's imports.

import { contains, indexOf, replace } from "std/strings"
import { decodeHex, bigintFromU64, ecdsaPublicKey } from "std/crypto"

const dsigPns: string = "urn:oasis:names:tc:SAML:2.0:protocol"
const dsigAns: string = "urn:oasis:names:tc:SAML:2.0:assertion"

fn hx(s: string): []byte {
  return decodeHex(s) catch err {
    panic("bad hex: ${err.message()}")
  }
}

fn rsaKey(nHex: string): DsigKey {
  return DsigKey.Rsa(RsaPublicKey{ n = bigintFromBytes(hx(nHex)), e = bigintFromU64(65537) })
}

fn ecKey(): DsigKey {
  let k = ecdsaPublicKey(nistecP256(), hx(dsigEcQ)) catch err {
    panic("ec key: ${err.message()}")
  }
  return DsigKey.Ecdsa(k)
}

fn expect(name: string): DsigOptions {
  return DsigOptions{ expectRoot = name }
}

// The message "verifySignature` fails with on `src"; "" when it accepts.
fn dsigErr(src: string, key: DsigKey, opts: DsigOptions): string {
  let out = ""
  verifySignature(tree(src), key, opts) catch err {
    out = err.message()
  }
  return out
}

fn wantReject(label: string, src: string, key: DsigKey, opts: DsigOptions, rule: string) {
  let msg = dsigErr(src, key, opts)
  assert(msg != "", "${label}: accepted, want a failure containing '${rule}'")
  assert(contains(msg, rule), "${label}: failed with '${msg}', want '${rule}'")
}

fn verified(src: string, key: DsigKey, opts: DsigOptions): SignedElement {
  return verifySignature(tree(src), key, opts) catch err {
    panic("refused a valid document: ${err.message()}")
  }
}

// From the first `open` through the next `shut`, both included.
fn between(s: string, open: string, shut: string): string {
  let i = int(indexOf(s, open))
  let j = int(indexOf(s, shut)) + len(shut)
  assert(i >= 0 && j > i, "no ${open} .. ${shut} in the fixture")
  return s[i:j]
}

// "s` with the first character after `marker" changed (A and B swap).
fn flipAfter(s: string, marker: string): string {
  let at = int(indexOf(s, marker)) + len(marker)
  assert(at >= len(marker), "no ${marker} in the fixture")
  let c = "A"
  if (s[at] == 'A') {
    c = "B"
  }
  return s[0:at] + c + s[at + 1:len(s)]
}

fn evilAssertion(id: string): string {
  return "<saml:Assertion ID=\"${id}\" Version=\"2.0\"><saml:Subject><saml:NameID>mallory@example.com</saml:NameID></saml:Subject></saml:Assertion>"
}

fn wrapper(inner: string): string {
  return "<samlp:Response xmlns:samlp=\"${dsigPns}\" xmlns:saml=\"${dsigAns}\" ID=\"_evil\" Version=\"2.0\">${inner}</samlp:Response>"
}

fn nameId(e: Element): string {
  return el(el(el(e, "Assertion"), "Subject"), "NameID").text()
}

// ---- 7 valid documents ------------------------------------------------------

test "valid 1: RSA-SHA256 over a Response" {
  let s = verified(dsigRsaResp, rsaKey(dsigRsaN), DsigOptions{})
  assert(s.id == "_resp1", "id ${s.id}")
  assert(at(s.element, "ID", "") == "_resp1", "element is the Response")
  assert(!isSome(s.element.child("Signature")), "the Signature is cut out of the element")
  assert(nameId(s.element) == "alice@example.com", "content")
}

test "valid 2: RSA-SHA256 with InclusiveNamespaces" {
  let s = verified(dsigRsaIncResp, rsaKey(dsigRsaN), DsigOptions{})
  assert(s.id == "_resp1", "id ${s.id}")
}

test "valid 3: ECDSA-SHA256 over a Response" {
  let s = verified(dsigEcResp, ecKey(), DsigOptions{})
  assert(s.id == "_resp1", "id ${s.id}")
  assert(nameId(s.element) == "alice@example.com", "content")
}

test "valid 4: ECDSA-SHA256 with InclusiveNamespaces" {
  let s = verified(dsigEcIncResp, ecKey(), DsigOptions{})
  assert(s.id == "_resp1", "id ${s.id}")
}

test "valid 5: RSA-SHA256 over an Assertion inside a Response, by expectRoot" {
  let s = verified(dsigRsaAssert, rsaKey(dsigRsaN), expect("{${dsigAns}}Assertion"))
  assert(s.id == "_assert1", "id ${s.id}")
  assert(s.element.local == "Assertion", "element ${s.element.name}")
  assert(!isSome(s.element.child("Signature")), "the Signature is cut out of the element")
  assert(el(el(s.element, "Subject"), "NameID").text() == "alice@example.com", "content")
}

test "valid 6: ECDSA-SHA256 over an Assertion, by expectRoot" {
  let s = verified(dsigEcAssert, ecKey(), expect("{${dsigAns}}Assertion"))
  assert(s.id == "_assert1", "id ${s.id}")
}

test "valid 7: a SHA-1 digest is accepted only with allowSha1" {
  wantReject("default", dsigRsaSha1Resp, rsaKey(dsigRsaN), DsigOptions{}, "digest method")
  let s = verified(dsigRsaSha1Resp, rsaKey(dsigRsaN), DsigOptions{ allowSha1 = true })
  assert(s.id == "_resp1", "id ${s.id}")
}

// ---- the eight wrapping shapes ----------------------------------------------

fn genuineAssertion(): string {
  return between(dsigRsaAssert, "<saml:Assertion ", "</saml:Assertion>")
}

fn genuineSignature(): string {
  return between(dsigRsaAssert, "<ds:Signature", "</ds:Signature>")
}

test "XSW 1: the signed Response is nested in an evil Response" {
  let doc = wrapper("<samlp:Extensions>" + dsigRsaResp + "</samlp:Extensions>" + evilAssertion("_evilA"))
  wantReject("XSW1", doc, rsaKey(dsigRsaN), DsigOptions{}, "not the root of the document")
}

test "XSW 2: the signed Response sits after the evil assertion; the caller gets the signed one" {
  let doc = "<x:Envelope xmlns:x=\"urn:x\" xmlns:saml=\"" +
    dsigAns +
    "\">" +
    evilAssertion("_evilA") +
    dsigRsaResp +
    "</x:Envelope>"
  wantReject("XSW2 root", doc, rsaKey(dsigRsaN), DsigOptions{}, "not the root of the document")
  let s = verified(doc, rsaKey(dsigRsaN), expect("{${dsigPns}}Response"))
  assert(nameId(s.element) == "alice@example.com", "the element is the signed one")
  assert(!contains(exc(s.element), "mallory"), "nothing evil in it")
  match (tree(doc).child("Assertion")) {
    Some(a) => assert(
      el(el(a, "Subject"), "NameID").text() == "mallory@example.com",
      "a lookup in doc finds the evil one",
    )
    None => assert(false, "no Assertion in the document")
  }
}

test "XSW 3: an evil assertion before the signed one" {
  let doc = replace(dsigRsaAssert, genuineAssertion(), evilAssertion("_evilA") + genuineAssertion())
  wantReject(
    "XSW3 expectRoot",
    doc,
    rsaKey(dsigRsaN),
    expect("{${dsigAns}}Assertion"),
    "elements are named <Assertion>",
  )
  wantReject("XSW3 root", doc, rsaKey(dsigRsaN), DsigOptions{}, "not the root of the document")
}

test "XSW 4: the signed assertion nested in an evil assertion" {
  let evil = "<saml:Assertion ID=\"_evilA\" Version=\"2.0\">" +
    genuineAssertion() +
    "</saml:Assertion>"
  let doc = replace(dsigRsaAssert, genuineAssertion(), evil)
  wantReject("XSW4", doc, rsaKey(dsigRsaN), DsigOptions{}, "not the root of the document")
}

test "XSW 5: an evil assertion that copies the signed ID" {
  let doc = replace(
    dsigRsaAssert,
    genuineAssertion(),
    evilAssertion("_assert1") + genuineAssertion(),
  )
  wantReject(
    "XSW5",
    doc,
    rsaKey(dsigRsaN),
    expect("{${dsigAns}}Assertion"),
    "duplicate ID '_assert1'",
  )
}

test "XSW 6: the signed assertion hidden in an Object of the Signature" {
  let bare = replace(genuineAssertion(), genuineSignature(), "")
  let sig = replace(
    genuineSignature(),
    "</ds:Signature>",
    "<ds:Object>${bare}</ds:Object></ds:Signature>",
  )
  let evil = "<saml:Assertion ID=\"_evilA\" Version=\"2.0\">" +
    sig +
    "<saml:Subject><saml:NameID>mallory@example.com</saml:NameID></saml:Subject></saml:Assertion>"
  let doc = replace(dsigRsaAssert, genuineAssertion(), evil)
  wantReject("XSW6", doc, rsaKey(dsigRsaN), expect("{${dsigAns}}Assertion"), "unexpected <Object>")
}

test "XSW 7: the signed assertion in Extensions, an evil one after it" {
  let doc = replace(
    dsigRsaAssert,
    genuineAssertion(),
    "<samlp:Extensions>" + genuineAssertion() + "</samlp:Extensions>" + evilAssertion("_evilA"),
  )
  wantReject(
    "XSW7",
    doc,
    rsaKey(dsigRsaN),
    expect("{${dsigAns}}Assertion"),
    "elements are named <Assertion>",
  )
}

test "XSW 8: the Signature moved into an Advice of an evil assertion" {
  let bare = replace(genuineAssertion(), genuineSignature(), "")
  let evil = "<saml:Assertion ID=\"_evilA\" Version=\"2.0\"><saml:Advice>" +
    bare +
    genuineSignature() +
    "</saml:Advice></saml:Assertion>"
  let doc = replace(dsigRsaAssert, genuineAssertion(), evil)
  wantReject(
    "XSW8",
    doc,
    rsaKey(dsigRsaN),
    DsigOptions{},
    "is not the ID of the element holding the signature",
  )
}

// ---- the other attacks and rules --------------------------------------------

test "attack 1: a duplicate ID elsewhere in the document" {
  let doc = replace(dsigRsaResp, "<samlp:Status>", "<samlp:Status ID=\"_resp1\">")
  wantReject("dup ID", doc, rsaKey(dsigRsaN), DsigOptions{}, "duplicate ID '_resp1'")
}

test "attack 2: a second Reference" {
  let ref = between(dsigRsaResp, "<ds:Reference ", "</ds:Reference>")
  wantReject(
    "two refs",
    replace(dsigRsaResp, ref, ref + ref),
    rsaKey(dsigRsaN),
    DsigOptions{},
    "unexpected <Reference>",
  )
}

test "attack 3: a second Signature" {
  let sig = between(dsigRsaAssert, "<ds:Signature", "</ds:Signature>")
  let doc = replace(dsigRsaAssert, "<samlp:Status>", sig + "<samlp:Status>")
  wantReject(
    "two sigs",
    doc,
    rsaKey(dsigRsaN),
    expect("{${dsigAns}}Assertion"),
    "2 ds:Signature elements",
  )
}

test "attack 4: a SHA-1 digest method" {
  let doc = replace(
    dsigRsaResp,
    "http://www.w3.org/2001/04/xmlenc#sha256",
    "http://www.w3.org/2000/09/xmldsig#sha1",
  )
  wantReject("sha1", doc, rsaKey(dsigRsaN), DsigOptions{}, "digest method")
}

test "attack 5: an XPath transform" {
  let doc = replace(
    dsigRsaResp,
    "http://www.w3.org/2000/09/xmldsig#enveloped-signature",
    "http://www.w3.org/TR/1999/REC-xpath-19991116",
  )
  wantReject(
    "xpath",
    doc,
    rsaKey(dsigRsaN),
    DsigOptions{},
    "transform 'http://www.w3.org/TR/1999/REC-xpath-19991116' is not allowed",
  )
}

test "attack 6: signed content swapped for another" {
  let doc = replace(dsigRsaResp, "alice@example.com", "mallory@example.com")
  wantReject(
    "swap",
    doc,
    rsaKey(dsigRsaN),
    DsigOptions{},
    "digest of the signed element does not match",
  )
}

test "attack 7: the key kind and the signature method disagree" {
  wantReject(
    "ecdsa doc, rsa key",
    dsigEcResp,
    rsaKey(dsigRsaN),
    DsigOptions{},
    "does not match an RSA key",
  )
  wantReject(
    "rsa doc, ecdsa key",
    dsigRsaResp,
    ecKey(),
    DsigOptions{},
    "does not match an ECDSA key",
  )
}

test "attack 8: a tampered DigestValue" {
  let doc = flipAfter(dsigRsaResp, "<ds:DigestValue>")
  wantReject(
    "digest",
    doc,
    rsaKey(dsigRsaN),
    DsigOptions{},
    "digest of the signed element does not match",
  )
}

test "attack 9: a tampered SignatureValue, RSA and ECDSA" {
  wantReject(
    "rsa",
    flipAfter(dsigRsaResp, "<ds:SignatureValue>"),
    rsaKey(dsigRsaN),
    DsigOptions{},
    "signature value does not verify",
  )
  wantReject(
    "ecdsa",
    flipAfter(dsigEcResp, "<ds:SignatureValue>"),
    ecKey(),
    DsigOptions{},
    "signature value does not verify",
  )
}

test "attack 10: a Reference outside the document" {
  let ext = replace(dsigRsaResp, "URI=\"#_resp1\"", "URI=\"http://evil.example/x.xml\"")
  wantReject("external", ext, rsaKey(dsigRsaN), DsigOptions{}, "not a same-document #ID reference")
  let empty = replace(dsigRsaResp, "URI=\"#_resp1\"", "URI=\"\"")
  wantReject("empty", empty, rsaKey(dsigRsaN), DsigOptions{}, "not a same-document #ID reference")
}

test "attack 11: a Reference to an ID that is not the signed element's" {
  let doc = replace(dsigRsaResp, "URI=\"#_resp1\"", "URI=\"#_assert1\"")
  wantReject(
    "other id",
    doc,
    rsaKey(dsigRsaN),
    DsigOptions{},
    "is not the ID of the element holding the signature",
  )
}

test "attack 12: a signature method that is SHA-1 or unknown" {
  let sha1 = replace(
    dsigRsaResp,
    "http://www.w3.org/2001/04/xmldsig-more#rsa-sha256",
    "http://www.w3.org/2000/09/xmldsig#rsa-sha1",
  )
  wantReject(
    "rsa-sha1",
    sha1,
    rsaKey(dsigRsaN),
    DsigOptions{},
    "signature method 'http://www.w3.org/2000/09/xmldsig#rsa-sha1' is not allowed",
  )
}

test "attack 13: a canonicalization method other than Exclusive C14N 1.0" {
  let cm = "<ds:CanonicalizationMethod Algorithm=\"http://www.w3.org/2001/10/xml-exc-c14n#\""
  let inclusive = replace(
    dsigRsaResp,
    cm,
    "<ds:CanonicalizationMethod Algorithm=\"http://www.w3.org/TR/2001/REC-xml-c14n-20010315\"",
  )
  wantReject("inclusive", inclusive, rsaKey(dsigRsaN), DsigOptions{}, "canonicalization method")
  let comments = replace(
    dsigRsaResp,
    cm,
    "<ds:CanonicalizationMethod Algorithm=\"http://www.w3.org/2001/10/xml-exc-c14n#WithComments\"",
  )
  wantReject("with comments", comments, rsaKey(dsigRsaN), DsigOptions{}, "canonicalization method")
}

test "attack 14: an RSA key under 2048 bits" {
  wantReject(
    "1024",
    dsigRsa1024Resp,
    rsaKey(dsigRsa1024N),
    DsigOptions{},
    "at least 2048 are required",
  )
}

test "attack 15: a key that did not sign it; KeyInfo is not consulted" {
  wantReject(
    "other key",
    dsigRsaResp,
    rsaKey(dsigRsa2N),
    DsigOptions{},
    "signature value does not verify",
  )
}

test "attack 16: a comment inside DigestValue" {
  let doc = replace(dsigRsaResp, "<ds:DigestValue>", "<ds:DigestValue><!--x-->")
  wantReject("comment", doc, rsaKey(dsigRsaN), DsigOptions{}, "comment or processing instruction")
}

test "attack 17: text between the elements of Signature" {
  let doc = replace(dsigRsaResp, "</ds:SignedInfo>", "</ds:SignedInfo>junk")
  wantReject("text", doc, rsaKey(dsigRsaN), DsigOptions{}, "text between its elements")
}

test "attack 18: no Signature at all" {
  let sig = between(dsigRsaResp, "<ds:Signature", "</ds:Signature>")
  wantReject(
    "none",
    replace(dsigRsaResp, sig, ""),
    rsaKey(dsigRsaN),
    DsigOptions{},
    "no ds:Signature element",
  )
}

test "attack 19: the signed element is not the one the caller expects" {
  wantReject(
    "name",
    dsigRsaResp,
    rsaKey(dsigRsaN),
    expect("{${dsigAns}}Assertion"),
    "not the expected root <Assertion>",
  )
  wantReject(
    "namespace",
    dsigRsaResp,
    rsaKey(dsigRsaN),
    expect("{urn:evil}Response"),
    "not the expected root <Response>",
  )
}

test "attack 20: the limits" {
  wantReject(
    "maxElements",
    dsigRsaResp,
    rsaKey(dsigRsaN),
    DsigOptions{ maxElements = 3 },
    "more than 3 elements",
  )
  wantReject(
    "maxDepth",
    dsigRsaResp,
    rsaKey(dsigRsaN),
    DsigOptions{ maxDepth = 2 },
    "nesting deeper than 2",
  )
  wantReject(
    "maxSignatureBytes",
    dsigRsaResp,
    rsaKey(dsigRsaN),
    DsigOptions{ maxSignatureBytes = 16 },
    "is longer than 16 bytes",
  )
}

test "attack 21: an ECDSA value that is not 64 bytes" {
  let doc = flipAfter(dsigEcResp, "<ds:SignatureValue>")
  let short = replace(doc, "<ds:SignatureValue>", "<ds:SignatureValue>AAAA")
  wantReject("length", short, ecKey(), DsigOptions{}, "want 64 (r || s)")
}

test "attack 22: an expectRoot that is not a name" {
  wantReject(
    "expectRoot",
    dsigRsaResp,
    rsaKey(dsigRsaN),
    expect("{urn:x"),
    "must be {namespace-uri}local or local",
  )
}
