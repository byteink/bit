// stdlib/xml/c14n.test.bit — Exclusive XML Canonicalization against the
// published vectors, then against the rules one at a time.
//
// Sources, all fetched 2026-10-04:
//
//   - Exclusive XML Canonicalization 1.0, REC 2002-07-18,
//     https://www.w3.org/TR/xml-exc-c14n/. It prints three exclusive forms
//     (§2.1 elem1, §2.2 elem2 in both enveloping documents): 3 of 3 below. (The
//     REC has no "section 4 examples"; §4 is the XML-DSig usage note.)
//   - Apache Santuario, the exclusive vectors in
//     https://github.com/apache/santuario-xml-security-java/tree/f2b32ed34878f1db96f5dfd438aed6ae279fe65d/src/test/resources/org/apache/xml/security/c14n/inExcl
//     (that commit pins them): example2_2_1, example2_2_2, example2_2_3 and
//     example2_4 with their `_c14nized_exclusive` / `_c14nized` outputs, and
//     `c14n/in/relative-ns-behaviour.xml`: 5 of 5 exclusive vectors there. The
//     directory also holds the inclusive outputs of the same inputs
//     (example2_2_1_c14nized, example2_2_2_c14nized, example2_4_c14nized is
//     already exclusive) and a 111 KB SOAP message, `plain-soap-1.1.xml`; those
//     are other algorithms or too large to inline, so not used. The files carry
//     CR LF line ends, kept here, so the line-ending rule is exercised.
//   - Canonical XML 1.0, REC 2001-03-15, https://www.w3.org/TR/xml-c14n/ §3,
//     eight examples. std/xml refuses a DOCTYPE, so 1 of 8 runs as printed
//     (§3.2); the other seven are skipped and each is shown to be refused:
//     §3.1, §3.3, §3.4, §3.5, §3.7, §3.8 by the DOCTYPE, §3.6 by its
//     `encoding="ISO-8859-1"`. §3.1 and §3.7/§3.8 also canonicalize document
//     subsets (comments and PIs outside the root, an element omitted), which
//     `canonicalizeExclusive(Element)` has no way to ask for. What can be
//     checked without the DTD is run with the DTD taken out and the attribute
//     defaults it supplied written in (marked "adapted"); the expected forms
//     there are the exclusive ones, which differ from the printed inclusive
//     ones only where an unused declaration is dropped.
//
// `tree`, `el` and `wantTreeFail` are in tree.test.bit, `wantKind` in
// token.test.bit.

import { hasPrefix } from "std/strings"

// The canonical form of `e` with `opts`; a failure fails the test.
fn exc(e: Element, opts: C14nOptions = C14nOptions{}): string {
  return string(
    canonicalizeExclusive(e, opts) catch err {
      panic("canonicalize failed: ${err.message()}")
    },
  )
}

// The canonical form of the root of `src`.
fn excRoot(src: string, opts: C14nOptions = C14nOptions{}): string {
  return exc(tree(src), opts)
}

fn withInc(prefixes: []string): C14nOptions {
  return C14nOptions{ inclusivePrefixes = prefixes, withComments = false }
}

fn withComments(): C14nOptions {
  return C14nOptions{ inclusivePrefixes = []string(0), withComments = true }
}

fn wantC14n(got: string, want: string, what: string) {
  assert(got == want, "${what}\n got ${got}\nwant ${want}")
}

// The message `canonicalizeExclusive(e, opts)` fails with, or "".
fn c14nFailure(e: Element, opts: C14nOptions = C14nOptions{}): string {
  let msg = ""
  canonicalizeExclusive(e, opts) catch err {
    msg = err.message()
  }
  return msg
}

// ---- the REC: 3 of 3 exclusive forms ---------------------------------------

test "xml-exc-c14n 2.1: elem1 keeps only its own namespace wherever it is enveloped" {
  let alone = `<n1:elem1 xmlns:n1="http://b.example">
          content
      </n1:elem1>`
  let enveloped = tree(
    `<n0:pdu xmlns:n0="http://a.example">
      <n1:elem1 xmlns:n1="http://b.example">
          content
      </n1:elem1>
   </n0:pdu>`,
  )
  wantC14n(excRoot(alone), alone, "standalone")
  wantC14n(exc(el(enveloped, "elem1")), alone, "enveloped, n0 not carried in")
}

const excElem2 = `<n1:elem2 xmlns:n1="http://example.net" xml:lang="en">
          <n3:stuff xmlns:n3="ftp://example.org"></n3:stuff>
      </n1:elem2>`

test "xml-exc-c14n 2.2: elem2 under n0:local" {
  let doc = tree(
    `<n0:local xmlns:n0="foo:bar"
             xmlns:n3="ftp://example.org">
      <n1:elem2 xmlns:n1="http://example.net"
                xml:lang="en">
          <n3:stuff xmlns:n3="ftp://example.org"/>
      </n1:elem2>
   </n0:local>`,
  )
  wantC14n(exc(el(doc, "elem2")), excElem2, "first enveloping")
}

test "xml-exc-c14n 2.2: elem2 under n2:pdu, xml:lang and xml:space not inherited" {
  let doc = tree(
    `<n2:pdu xmlns:n1="http://example.com"
           xmlns:n2="http://foo.example"
           xml:lang="fr"
           xml:space="retain">
      <n1:elem2 xmlns:n1="http://example.net"
                xml:lang="en">
          <n3:stuff xmlns:n3="ftp://example.org"/>
      </n1:elem2>
   </n2:pdu>`,
  )
  wantC14n(exc(el(doc, "elem2")), excElem2, "second enveloping")
}

// ---- Santuario: 5 of 5 exclusive vectors -----------------------------------

test "santuario example2_2_1 and example2_2_2: same elem2 in both, CR LF input" {
  let one = tree(
    "<n0:local xmlns:n0=\"foo:bar\" xmlns:n3=\"ftp://example.org\">\r\n<n1:elem2 xmlns:n1=\"http://example.net\" xml:lang=\"en\">\r\n<n3:stuff xmlns:n3=\"ftp://example.org\"/>\r\n</n1:elem2>\r\n</n0:local>",
  )
  let two = tree(
    "<n2:pdu xmlns:n1=\"http://example.com\" xmlns:n2=\"http://foo.example\" xml:lang=\"fr\" xml:space=\"retain\">\r\n<n1:elem2 xmlns:n1=\"http://example.net\" xml:lang=\"en\">\r\n<n3:stuff xmlns:n3=\"ftp://example.org\"/>\r\n</n1:elem2>\r\n</n2:pdu>\r\n",
  )
  let want = `<n1:elem2 xmlns:n1="http://example.net" xml:lang="en">
<n3:stuff xmlns:n3="ftp://example.org"></n3:stuff>
</n1:elem2>`
  wantC14n(exc(el(one, "elem2")), want, "example2_2_1")
  wantC14n(exc(el(two, "elem2")), want, "example2_2_2")
}

test "santuario example2_2_3: p picks up xmlns:x from the element that uses it" {
  let doc = tree(
    `<?xml version="1.0" encoding="UTF-8"?>
<x:sample xmlns:x="http://www.x.com/sample/">
  <?testpi 123?>
  <section xml:lang="en">
    <p style="indented" abc='xy"z'>
      <x:verbatim xml:space="preserve">
        <b xml:lang="fr">def
          <i xml:space="reset">jkl</i>
        </b>
      </x:verbatim>
    </p>
  </section>
</x:sample>
`,
  )
  let p = el(el(doc, "section"), "p")
  wantC14n(
    exc(p),
    `<p abc="xy&quot;z" style="indented">
      <x:verbatim xmlns:x="http://www.x.com/sample/" xml:space="preserve">
        <b xml:lang="fr">def
          <i xml:space="reset">jkl</i>
        </b>
      </x:verbatim>
    </p>`,
    "p",
  )
}

test "santuario example2_4: dsig is declared where it is used, not at the apex" {
  let doc = tree(`<?xml version="1.0" encoding="UTF-8"?><dsig:local xmlns:dsig="foo:bar"><etsi:test xmlns:etsi="http://example.net"><etsi:elem2><dsig:stuff/></etsi:elem2></etsi:test></dsig:local>`)
  let elem2 = el(el(doc, "test"), "elem2")
  wantC14n(
    exc(elem2),
    `<etsi:elem2 xmlns:etsi="http://example.net"><dsig:stuff xmlns:dsig="foo:bar"></dsig:stuff></etsi:elem2>`,
    "elem2",
  )
}

test "santuario relative-ns-behaviour: a relative namespace URI is a failure" {
  let doc = tree(`<absolute:correct      xmlns:absolute='http://www.absolute.org/#likeVodka'><relative:incorrect    xmlns:relative='../cheating#away'></relative:incorrect></absolute:correct>`)
  wantC14n(
    c14nFailure(doc),
    "xml: namespace '../cheating#away' is a relative URI, which canonicalization refuses",
    "whole document",
  )
  // Declared but unused is still in the document the spec says to refuse.
  assert(c14nFailure(el(doc, "incorrect")) != "", "the apex's own declaration")
  assert(c14nFailure(tree("<a xmlns:p=\"urn:x\"><p:b/></a>")) == "", "urn: is absolute")
  assert(c14nFailure(tree("<a xmlns=\"1http://x\"/>")) != "", "a scheme starts with a letter")
  assert(c14nFailure(tree("<a xmlns=\"//host/x\"/>")) != "", "a network-path reference")
}

// ---- Canonical XML 1.0 §3: 1 of 8 as printed, 7 skipped and shown refused ---

test "c14n 3.2 whitespace in document content: input and canonical form are identical" {
  let doc = `<doc>
   <clean>   </clean>
   <dirty>   A   B   </dirty>
   <mixed>
      A
      <clean>   </clean>
      B
      <dirty>   A   B   </dirty>
      C
   </mixed>
</doc>`
  wantC14n(excRoot(doc), doc, "3.2")
}

test "c14n 3.1, 3.3, 3.4, 3.5, 3.7, 3.8 are refused for their DOCTYPE and 3.6 for its encoding" {
  let docs = [
    "<?xml version=\"1.0\"?>\n<!DOCTYPE doc SYSTEM \"doc.dtd\">\n<doc>Hello, world!<!-- Comment 1 --></doc>",
    "<!DOCTYPE doc [<!ATTLIST e9 attr CDATA \"default\">]>\n<doc><e9/></doc>",
    "<!DOCTYPE doc [\n<!ATTLIST normId id ID #IMPLIED>\n]>\n<doc><normId id=\"x\"/></doc>",
    "<!DOCTYPE doc [\n<!ENTITY ent1 \"Hello\">\n]>\n<doc>&ent1;</doc>",
    "<!DOCTYPE doc [\n<!ATTLIST e2 xml:space (default|preserve) 'preserve'>\n]>\n<doc xmlns=\"http://www.ietf.org\"><e1/></doc>",
    "<!DOCTYPE doc [\n<!ATTLIST e2 xml:space (default|preserve) 'preserve'>\n]>\n<doc xml:base=\"something/else\"><e1/></doc>",
  ]
  let i = 0
  while (i < len(docs)) {
    wantTreeFail(docs[i], XmlErrorKind.Doctype)
    i = i + 1
  }
  wantTreeFail(
    "<?xml version=\"1.0\" encoding=\"ISO-8859-1\"?>\n<doc>&#169;</doc>",
    XmlErrorKind.Unsupported,
  )
}

test "c14n 3.1 adapted: the document element with and without its comment" {
  let doc = tree("<doc>Hello, world!<!-- Comment 1 --></doc>")
  wantC14n(exc(doc), "<doc>Hello, world!</doc>", "uncommented")
  wantC14n(exc(doc, withComments()), "<doc>Hello, world!<!-- Comment 1 --></doc>", "commented")
}

test "c14n 3.3 adapted: tags, ordering and the default namespace, no DTD, e9's default written in" {
  let doc = tree(
    "<doc>\r\n   <e1   />\r\n   <e2   ></e2>\r\n   <e3    name = \"elem3\"   id=\"elem3\"    />\r\n   <e4    name=\"elem4\"   id=\"elem4\"    ></e4>\r\n   <e5 a:attr=\"out\" b:attr=\"sorted\" attr2=\"all\" attr=\"I'm\"\r\n       xmlns:b=\"http://www.ietf.org\" \r\n       xmlns:a=\"http://www.w3.org\"\r\n       xmlns=\"http://example.org\"/>\r\n   <e6 xmlns=\"\" xmlns:a=\"http://www.w3.org\">\r\n       <e7 xmlns=\"http://www.ietf.org\">\r\n           <e8 xmlns=\"\" xmlns:a=\"http://www.w3.org\">\r\n               <e9 xmlns=\"\" xmlns:a=\"http://www.ietf.org\" attr=\"default\"/>\r\n           </e8>\r\n       </e7>\r\n   </e6>\r\n</doc>\r\n",
  )
  // e5 uses a and b through its attributes, so they stay; e6's and e9's `a`
  // are unused, so exclusive canonicalization drops them where the inclusive
  // form of the REC keeps them.
  wantC14n(
    exc(doc),
    "<doc>\n   <e1></e1>\n   <e2></e2>\n   <e3 id=\"elem3\" name=\"elem3\"></e3>\n   <e4 id=\"elem4\" name=\"elem4\"></e4>\n   <e5 xmlns=\"http://example.org\" xmlns:a=\"http://www.w3.org\" xmlns:b=\"http://www.ietf.org\" attr=\"I'm\" attr2=\"all\" b:attr=\"sorted\" a:attr=\"out\"></e5>\n   <e6>\n       <e7 xmlns=\"http://www.ietf.org\">\n           <e8 xmlns=\"\">\n               <e9 attr=\"default\"></e9>\n           </e8>\n       </e7>\n   </e6>\n</doc>",
    "3.3",
  )
}

test "c14n 3.4 adapted: character references, CDATA and attribute escapes, no DTD" {
  let doc = tree(
    "<doc>\r\n   <text>First line&#x0d;&#10;Second line</text>\r\n   <value>&#x32;</value>\r\n   <compute><![CDATA[value>\"0\" && value<\"10\" ?\"valid\":\"error\"]]></compute>\r\n   <compute expr='value>\"0\" &amp;&amp; value&lt;\"10\" ?\"valid\":\"error\"'>valid</compute>\r\n   <norm attr=' &apos;   &#x20;&#13;&#xa;&#9;   &apos; '/>\r\n</doc>\r\n",
  )
  // normNames and normId are left out: their value normalization needs the
  // NMTOKENS and ID types the DTD declares.
  wantC14n(
    exc(doc),
    "<doc>\n   <text>First line&#xD;\nSecond line</text>\n   <value>2</value>\n   <compute>value&gt;\"0\" &amp;&amp; value&lt;\"10\" ?\"valid\":\"error\"</compute>\n   <compute expr=\"value>&quot;0&quot; &amp;&amp; value&lt;&quot;10&quot; ?&quot;valid&quot;:&quot;error&quot;\">valid</compute>\n   <norm attr=\" '    &#xD;&#xA;&#x9;   ' \"></norm>\n</doc>",
    "3.4",
  )
}

test "c14n 3.6 adapted: a character reference comes out as UTF-8" {
  let got = canonicalizeExclusive(tree("<doc>&#169;</doc>")) catch err {
    panic(err.message())
  }
  assert(len(got) == 13 && got[5] == 0xC2 && got[6] == 0xA9, "got ${string(got)}")
  wantC14n(string(got), "<doc>\u{00A9}</doc>", "3.6")
}

// ---- 8 of 8 edge cases ------------------------------------------------------

test "edge 1: a default namespace undeclared with xmlns=\"\"" {
  let doc = tree(`<a xmlns="x:u"><b xmlns=""><c/></b><d/></a>`)
  wantC14n(
    exc(doc),
    `<a xmlns="x:u"><b xmlns=""><c></c></b><d></d></a>`,
    "d is in u: the default is bound again",
  )
  wantC14n(exc(el(doc, "b")), `<b><c></c></b>`, "b alone has nothing to undeclare")
  wantC14n(exc(el(doc, "d")), `<d xmlns="x:u"></d>`, "d alone declares u")
}

test "edge 2: a declared prefix nothing uses is dropped" {
  let doc = tree(`<a xmlns:p="x:u1" xmlns:q="x:u2" xmlns:r="x:u3"><q:b/></a>`)
  wantC14n(exc(doc), `<a><q:b xmlns:q="x:u2"></q:b></a>`, "only q is used, and where")
  let attr = tree(`<a xmlns:p="x:u1" xmlns:r="x:u3" r:x="1"/>`)
  wantC14n(exc(attr), `<a xmlns:r="x:u3" r:x="1"></a>`, "an attribute's prefix counts as use")
  let dflt = tree(`<a xmlns="x:u1" xmlns:p="x:u2" p:x="1" y="2"/>`)
  wantC14n(exc(dflt), `<a xmlns="x:u1" xmlns:p="x:u2" y="2" p:x="1"></a>`, "y is in no namespace")
}

test "edge 3: an inclusive prefix is kept, #default included, from the apex's ancestors too" {
  let doc = tree(`<r xmlns="x:d" xmlns:a="x:u1" xmlns:b="x:u2"><c><x/></c></r>`)
  let c = el(doc, "c")
  wantC14n(
    exc(c, withInc(["b"])),
    `<c xmlns="x:d" xmlns:b="x:u2"><x></x></c>`,
    "b inherited by the apex",
  )
  wantC14n(
    exc(c, withInc(["b", "a"])),
    `<c xmlns="x:d" xmlns:a="x:u1" xmlns:b="x:u2"><x></x></c>`,
    "sorted by prefix",
  )
  wantC14n(
    exc(c, withInc(["nope", "xml"])),
    `<c xmlns="x:d"><x></x></c>`,
    "a prefix not in scope, and xml, are skipped",
  )
  let both = tree(`<a xmlns:p="x:u" xmlns="x:d"><b/></a>`)
  wantC14n(
    exc(both, withInc(["p"])),
    `<a xmlns="x:d" xmlns:p="x:u"><b></b></a>`,
    "kept on a, and not repeated on b",
  )
  let undecl = tree(`<a xmlns="x:u"><b xmlns=""><c/></b></a>`)
  wantC14n(
    exc(undecl, withInc(["#default"])),
    `<a xmlns="x:u"><b xmlns=""><c></c></b></a>`,
    "#default with an undeclaration",
  )
  wantC14n(exc(tree(`<a><b/></a>`), withInc(["#default"])), `<a><b></b></a>`, "no default to keep")
}

test "edge 4: attributes sort by namespace URI, then local name, then not by prefix" {
  let doc = tree(
    `<e xmlns:z="http://a.example" xmlns:a="http://z.example" a:m="1" z:n="2" z:b="3" a:a="4" plain="5" aa="6" xml:lang="en"/>`,
  )
  wantC14n(
    exc(doc),
    `<e xmlns:a="http://z.example" xmlns:z="http://a.example" aa="6" plain="5" z:b="3" z:n="2" xml:lang="en" a:a="4" a:m="1"></e>`,
    "no namespace first, then a.example, the xml namespace (http://www.w3.org/...), z.example",
  )
}

test "edge 5: CR, LF, tab and the markup characters in an attribute value" {
  let doc = tree("<a v=\"1&#xD;2&#xA;3&#x9;4&amp;5&lt;6&gt;7&quot;8'9\" w=\"x\ty\r\nz\"/>")
  wantC14n(
    exc(doc),
    "<a v=\"1&#xD;2&#xA;3&#x9;4&amp;5&lt;6>7&quot;8'9\" w=\"x y z\"></a>",
    "a literal tab or line end in the source is a space by then; the references stay references",
  )
  let text = tree("<a>1&#xD;2\r\n3\r4&gt;5\"6'7&amp;8&lt;9</a>")
  wantC14n(
    exc(text),
    "<a>1&#xD;2\n3\n4&gt;5\"6'7&amp;8&lt;9</a>",
    "text: > escaped, quotes not, CR LF is LF",
  )
}

test "edge 6: CDATA sections are flattened to escaped text" {
  let doc = tree("<a>x<![CDATA[<b> & ]]> z<![CDATA[]]]]><![CDATA[>]]>y</a>")
  wantC14n(exc(doc), "<a>x&lt;b&gt; &amp;  z]]&gt;y</a>", "CDATA")
  wantC14n(exc(tree("<a><![CDATA[]]></a>")), "<a></a>", "an empty section leaves nothing")
}

test "edge 7: comments dropped, kept under withComments; PIs always kept" {
  let src = "<a>t1<!--c1--><?pi  data ?>t2<!----><b><!--in b--></b><!--tail--></a>"
  let doc = tree(src)
  wantC14n(exc(doc), "<a>t1<?pi data ?>t2<b></b></a>", "default")
  wantC14n(
    exc(doc, withComments()),
    "<a>t1<!--c1--><?pi data ?>t2<!----><b><!--in b--></b><!--tail--></a>",
    "with comments",
  )
  wantC14n(exc(tree("<a><?p?></a>")), "<a><?p?></a>", "a PI without data")
  wantC14n(
    exc(tree("<a><!--x\r\ny\rz--></a>"), withComments()),
    "<a><!--x\ny\nz--></a>",
    "comment line ends",
  )
  wantC14n(
    exc(tree("<a><!--before--><b/><!--between--><c/></a>"), withComments()),
    "<a><!--before--><b></b><!--between--><c></c></a>",
    "between elements",
  )
}

test "edge 8: a redeclaration of the same binding in a descendant is suppressed" {
  let doc = tree(`<p:a xmlns:p="x:u" xmlns:q="x:v"><p:b xmlns:p="x:u"><q:c xmlns:q="x:v" xmlns:p="x:w"><p:d xmlns:p="x:u"/></q:c></p:b></p:a>`)
  wantC14n(
    exc(doc),
    `<p:a xmlns:p="x:u"><p:b><q:c xmlns:q="x:v"><p:d></p:d></q:c></p:b></p:a>`,
    "b repeats p=u and writes nothing; c writes q (a had it unused); d's p=u is what the output already has",
  )
  let changed = tree(`<p:a xmlns:p="x:u"><p:b xmlns:p="x:w"><p:c xmlns:p="x:u"/></p:b></p:a>`)
  wantC14n(
    exc(changed),
    `<p:a xmlns:p="x:u"><p:b xmlns:p="x:w"><p:c xmlns:p="x:u"></p:c></p:b></p:a>`,
    "a different binding is written, and the restored one again",
  )
}

// The worked example in docs/stdlib/xml.md.
test "the docs example: an assertion is written standalone, unused namespaces gone" {
  let doc = tree(
    `<Response xmlns:saml="urn:a" xmlns:xs="urn:x"><saml:Assertion ID="_1" xmlns:saml="urn:a">  <saml:Subject/></saml:Assertion></Response>`,
  )
  wantC14n(
    exc(el(doc, "Assertion")),
    `<saml:Assertion xmlns:saml="urn:a" ID="_1">  <saml:Subject></saml:Subject></saml:Assertion>`,
    "assertion",
  )
}

// ---- the rest of the contract -----------------------------------------------

test "bad inclusive prefixes fail, naming the entry" {
  let e = tree("<a/>")
  let bad = ["", "xmlns", "a:b", "#Default"]
  let i = 0
  while (i < len(bad)) {
    let msg = c14nFailure(e, withInc([bad[i]]))
    assert(
      msg == "xml: '${bad[i]}' is not a prefix; write #default for the default namespace",
      "'${bad[i]}': ${msg}",
    )
    i = i + 1
  }
}

test "xml:* attributes are written where they are and xml is never declared" {
  let doc = tree(`<a xml:lang="en"><b xml:space="preserve" xml:lang="fr"><c/></b></a>`)
  wantC14n(
    exc(doc),
    `<a xml:lang="en"><b xml:lang="fr" xml:space="preserve"><c></c></b></a>`,
    "whole",
  )
  wantC14n(exc(el(doc, "b")), `<b xml:lang="fr" xml:space="preserve"><c></c></b>`, "b")
  wantC14n(exc(el(el(doc, "b"), "c")), `<c></c>`, "c does not inherit xml:lang or xml:space")
}

test "non-ASCII text and names go through as UTF-8" {
  let doc = tree("<\u{00E9}:r xmlns:\u{00E9}=\"urn:\u{00FC}\" \u{00E9}:\u{00E0}=\"\u{20AC}\">\u{00E9}\u{4E2D}\u{6587}\u{1F600}</\u{00E9}:r>")
  wantC14n(
    exc(doc),
    "<\u{00E9}:r xmlns:\u{00E9}=\"urn:\u{00FC}\" \u{00E9}:\u{00E0}=\"\u{20AC}\">\u{00E9}\u{4E2D}\u{6587}\u{1F600}</\u{00E9}:r>",
    "unchanged",
  )
}

test "attribute order compares bytes, so code point order" {
  let doc = tree("<e xmlns:p=\"urn:a\" \u{00E9}=\"1\" z=\"2\" B=\"3\" a=\"4\" p:\u{00E9}=\"5\" p:Z=\"6\"/>")
  wantC14n(
    exc(doc),
    "<e xmlns:p=\"urn:a\" B=\"3\" a=\"4\" z=\"2\" \u{00E9}=\"1\" p:Z=\"6\" p:\u{00E9}=\"5\"></e>",
    "B < a < z < e-acute; then the namespace",
  )
}

// A deep tree costs memory, never call stack, and the canonical form of what
// canonicalization wrote is itself.
test "a 5000-deep element chain canonicalizes without recursion" {
  let n = 5000
  let src = []byte(0)
  let i = 0
  while (i < n) {
    src = append(src, "<a>")
    i = i + 1
  }
  i = 0
  while (i < n) {
    src = append(src, "</a>")
    i = i + 1
  }
  let doc = parse(src, 10000) catch err {
    panic(err.message())
  }
  assert(len(exc(doc)) == n * 7, "length ${len(exc(doc))}")
}

test "what parses canonicalizes, and canonicalizing the output changes nothing" {
  let docs = [
    "<a xmlns:p=\"urn:u\" p:x='1' y=\"&lt;&#13;\">t<!--c--><?pi d?><p:b xmlns:q=\"urn:q\">&#13;x]]&gt;</p:b></a>",
    "<n0:l xmlns:n0=\"foo:bar\" xmlns=\"d:e\"><k xmlns=\"\"><n0:j/></k><i/></n0:l>",
    "<a><b><![CDATA[<&>]]></b>\r\n<c/>\r<d xml:lang='x' xmlns:z='urn:z' z:a='1'/></a>",
  ]
  let opts = [C14nOptions{}, withComments(), withInc(["z", "#default", "p"])]
  let d = 0
  while (d < len(docs)) {
    let o = 0
    while (o < len(opts)) {
      let once = excRoot(docs[d], opts[o])
      wantC14n(excRoot(once, opts[o]), once, "doc ${d} options ${o}")
      o = o + 1
    }
    d = d + 1
  }
}

// Every truncation and every one-byte deletion of the documents above, and
// every byte replaced by each of eight troublemakers: whatever parses
// canonicalizes without a panic, and what it writes is stable.
test "no mutated document panics" {
  let docs = [
    "<a xmlns:p=\"urn:u\" p:x='1'>t<!--c--><?pi d?><p:b/></a>",
    "<a xmlns=\"x:u\"><b xmlns=\"\">&#13;<![CDATA[x]]></b></a>",
  ]
  let swap = ["<", ">", "&", "\"", ":", "\r", "\x00", "\xC3"]
  let parsed = 0
  let d = 0
  while (d < len(docs)) {
    let src = docs[d]
    let k = 0
    while (k <= len(src)) {
      parsed = parsed + c14nTry(src[0:k])
      if (k < len(src)) {
        parsed = parsed + c14nTry(src[0:k] + src[k + 1:len(src)])
        let s = 0
        while (s < len(swap)) {
          parsed = parsed + c14nTry(src[0:k] + swap[s] + src[k + 1:len(src)])
          s = s + 1
        }
      }
      k = k + 1
    }
    d = d + 1
  }
  assert(
    parsed > 50,
    "only ${parsed} mutants parsed: the mutator is not reaching the canonicalizer",
  )
}

// 1 when `src` parsed and canonicalized, else 0. The output must itself parse
// and canonicalize to the same bytes; a relative namespace URI, which a mutation
// can make, is the one refusal.
fn c14nTry(src: string): int {
  match (treeFailure(src)) {
    Some(_) => return 0
    None => {}
  }
  let out = canonicalizeExclusive(tree(src), withComments()) catch err {
    assert(hasPrefix(err.message(), "xml: namespace"), "${src}: ${err.message()}")
    return 1
  }
  wantC14n(excRoot(string(out), withComments()), string(out), "again: ${src}")
  return 1
}
