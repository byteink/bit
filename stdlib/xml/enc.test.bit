fn encTestKey(der: string = encTestKeyDer): RsaPrivateKey {
  return rsaParsePrivateKey(
    decodeHex(der) catch e {
      panic(e.message())
    },
  ) catch e {
    panic(e.message())
  }
}

fn encTestValid(doc: string) {
  let e = decryptElement(
    parse([]byte(doc)) catch e {
      panic(e.message())
    },
    encTestKey(),
  ) catch e {
    panic(e.message())
  }
  assert(e.local == "Assertion" && e.space == "urn:test")
  assert(e.text() == "alice@example.com")
}

fn encTestFailure(doc: string, key: RsaPrivateKey): error {
  let e = parse([]byte(doc)) catch e {
    panic(e.message())
  }
  decryptElement(e, key) catch err {
    return err
  }
  panic("unexpected decryption success")
}

test "xml enc valid: aes128-cbc-sha1" {
  encTestValid(encFixture0)
}

test "xml enc valid: aes128-cbc-sha256" {
  encTestValid(encFixture1)
}

test "xml enc valid: aes128-gcm-sha1" {
  encTestValid(encFixture2)
}

test "xml enc valid: aes128-gcm-sha256" {
  encTestValid(encFixture3)
}

test "xml enc valid: aes256-cbc-sha1" {
  encTestValid(encFixture4)
}

test "xml enc valid: aes256-cbc-sha256" {
  encTestValid(encFixture5)
}

test "xml enc valid: aes256-gcm-sha1" {
  encTestValid(encFixture6)
}

test "xml enc valid: aes256-gcm-sha256" {
  encTestValid(encFixture7)
}

const encBadPadding: string = `<EncryptedData xmlns="http://www.w3.org/2001/04/xmlenc#" xmlns:ds="http://www.w3.org/2000/09/xmldsig#" xmlns:xenc11="http://www.w3.org/2009/xmlenc11#" Type="http://www.w3.org/2001/04/xmlenc#Element"><EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#aes128-cbc"/><ds:KeyInfo><EncryptedKey><EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#rsa-oaep-mgf1p"><ds:DigestMethod Algorithm="http://www.w3.org/2000/09/xmldsig#sha1"/></EncryptionMethod><ds:KeyInfo><ds:KeyName>recipient</ds:KeyName></ds:KeyInfo><CipherData><CipherValue>G2pw3Bq5ki5Ceivy5UjhCZ9CgSxAhh0FJ7MvxHYmo//OktfA9985VRrmb5NIwTIC
CuB/L35FRcUf5wXgYaJuez01AXCxCwzeUkVQ96Re5wReOtqPmcMIZen86dTZ+Qmz
ZEWdWZbHYmWrWxhHvElV4pFD0beA5UjG8jVSlX4WmO+VtiNHjanM3/PWJT+trFAI
5t/OPkSzCzbBNogOr2pmC0XOVKMBj0trwntCIgOkrtqxzhkfRmzxnmhIsWEa9Kqk
K47pg03nvsdEqtMjFuZvbpu9Xr6uVdv2N8Bsv9hljHBL6UTS2JfPqKoZak5IH95o
rLtIEvwT843Qw5DwrunVCg==</CipherValue></CipherData></EncryptedKey></ds:KeyInfo><CipherData><CipherValue>YaW323VQ9zn3DufyGc7IH6ylwXelW9H+Yp5G1GpEJJ32TSeBKUp7AlHVBphlPrbhBrpYCUhtYAjeCyIXN6mvvqqBIX6GNQQN4sGyqFdwOoQ=</CipherValue></CipherData></EncryptedData>`

test "xml enc refusal: RSA1.5 transport" {
  assert(
    encTestFailure(
      replace(encFixture0, encNs + "rsa-oaep-mgf1p", encNs + "rsa-1_5"),
      encTestKey(),
    ) == encFailure,
  )
}

test "xml enc refusal: wrong key and CBC padding give equal errors" {
  let wrong = encTestFailure(encFixture0, encTestKey(encWrongKeyDer))
  let padding = encTestFailure(encBadPadding, encTestKey())
  assert(wrong == padding)
  assert(wrong == encFailure)
}

fn encTestCipher(root: Element, raw: []byte): Element {
  let children = encKids(root) catch e {
    panic(e.message())
  }
  let values = encKids(children[2]) catch e {
    panic(e.message())
  }
  values[0].nodes = [Node.Text(encodeBase64(raw))]
  return root
}

fn encTestRefuse(root: Element) {
  decryptElement(root, encTestKey()) catch e {
    assert(e == encFailure)
    return
  }
  panic("malformed encrypted element accepted")
}

test "xml enc refusal: tampered GCM tag" {
  let root = parse([]byte(encFixture2)) catch e {
    panic(e.message())
  }
  let kids = encKids(root) catch e {
    panic(e.message())
  }
  let raw = encCipher(kids[2], encMaxBytes) catch e {
    panic(e.message())
  }
  raw[len(raw) - 1] = raw[len(raw) - 1] ^ 1
  encTestRefuse(encTestCipher(root, raw))
}

test "xml enc refusal: bad CBC padding" {
  assert(encTestFailure(encBadPadding, encTestKey()) == encFailure)
}

test "xml enc refusal: short IV and ciphertext" {
  let root = parse([]byte(encFixture2)) catch e {
    panic(e.message())
  }
  encTestRefuse(encTestCipher(root, []byte(27)))
}

test "xml enc refusal: DOCTYPE in plaintext" {
  let root = parse([]byte(encFixture2)) catch e {
    panic(e.message())
  }
  let kids = encKids(root) catch e {
    panic(e.message())
  }
  let key = encUnwrap(kids[1], encTestKey()) catch e {
    panic(e.message())
  }
  let cipher = AesGcm(key) catch e {
    panic(e.message())
  }
  let nonce = []byte(12)
  let plaintext = []byte("<!DOCTYPE a><a/>")
  let bytes = append(nonce, string(cipher.seal(nonce, plaintext, []byte(0))))
  encTestRefuse(encTestCipher(root, bytes))
}

test "xml enc refusal: non-Element Type" {
  assert(
    encTestFailure(
      replace(encFixture0, encNs + "Element", encNs + "Content"),
      encTestKey(),
    ) == encFailure,
  )
}

test "xml enc refusal: unknown algorithm" {
  assert(
    encTestFailure(
      replace(encFixture0, encNs + "aes128-cbc", "urn:unsupported"),
      encTestKey(),
    ) == encFailure,
  )
}

test "xml enc refusal: namespace and algorithm ambiguity" {
  let mgf = "<xenc11:MGF Algorithm=\"" + enc11Ns + "mgf1sha256\"/>"
  let method = "<EncryptionMethod Algorithm=\"" + encNs + "rsa-oaep-mgf1p\">"
  let bad = replace(encFixture0, method, method + mgf)
  assert(encTestFailure(bad, encTestKey()) == encFailure)
  let digest = "<ds:DigestMethod Algorithm=\"" + dsigSha1 + "\"/>"
  bad = replace(encFixture0, digest, digest + digest)
  assert(encTestFailure(bad, encTestKey()) == encFailure)
  bad = replace(encFixture0, "xmlns=\"" + encNs, "xmlns=\"urn:wrong")
  assert(encTestFailure(bad, encTestKey()) == encFailure)
}

test "xml enc refusal: bounded structural input" {
  let root = parse([]byte(encFixture0)) catch e {
    panic(e.message())
  }
  root.nodes = []Node(0)
  let i = 0
  while (i < 33) {
    root.nodes = append(root.nodes, Node.Text(""))
    i = i + 1
  }
  encTestRefuse(root)
}

// W3C WRAP.1 test key, decrypted with OpenSSL pkcs12 -legacy, password passwd.
// https://www.w3.org/2008/xmlsec/Drafts/xmlenc-core-11/test-cases/files/oracle/RSA-2048_SHA256WithRSA.p12
// Source SHA256 171635b6dc90259081f08f68f78736d3e29260c6876527c0a6e2ed9eff8f5e55.
const encWrongKeyDer: string = ""

// Official W3C WRAP.1, unmodified ciphertext (the table and file differ on DigestMethod).
// https://www.w3.org/2008/xmlsec/Drafts/xmlenc-core-11/test-cases/files/oracle/cipherText__RSA-2048__aes128-gcm__rsa-oaep-mgf1p.xml
// SHA256 ccb971dedf60670d38e1e81827a0422647062641f9dba9301667d0ed07b0306b.
const encW3cWrap1: string = `<xenc:EncryptedData xmlns:xenc="http://www.w3.org/2001/04/xmlenc#" Type="http://www.w3.org/2001/04/xmlenc#Element"><xenc:EncryptionMethod Algorithm="http://www.w3.org/2009/xmlenc11#aes128-gcm"/><dsig:KeyInfo xmlns:dsig="http://www.w3.org/2000/09/xmldsig#"><xenc:EncryptedKey xmlns:xenc="http://www.w3.org/2001/04/xmlenc#"><xenc:EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#rsa-oaep-mgf1p"><dsig:DigestMethod Algorithm="http://www.w3.org/2000/09/xmldsig#sha1" xmlns:dsig="http://www.w3.org/2000/09/xmldsig#"/></xenc:EncryptionMethod><dsig:KeyInfo xmlns:dsig="http://www.w3.org/2000/09/xmldsig#"><dsig:X509Data><dsig:X509Certificate></dsig:X509Certificate><dsig:X509IssuerSerial><dsig:X509IssuerName>CN=RSA-2048_SHA256WithRSA, OU=xmlencr11</dsig:X509IssuerName><dsig:X509SerialNumber>3945509604227456005</dsig:X509SerialNumber></dsig:X509IssuerSerial><dsig:X509SubjectName>CN=RSA-2048_SHA256WithRSA, OU=xmlencr11</dsig:X509SubjectName><dsig:X509SKI>OjRJOUAVBCeNhunAJnolLOhgI7o=</dsig:X509SKI></dsig:X509Data></dsig:KeyInfo><xenc:CipherData><xenc:CipherValue></xenc:CipherValue></xenc:CipherData></xenc:EncryptedKey></dsig:KeyInfo><xenc:CipherData><xenc:CipherValue></xenc:CipherValue></xenc:CipherData></xenc:EncryptedData>`

test "xml enc valid: official W3C WRAP.1" {
  let root = parse([]byte(encW3cWrap1)) catch e {
    panic(e.message())
  }
  let plain = decryptElement(root, encTestKey(encWrongKeyDer)) catch e {
    panic(e.message())
  }
  assert(plain.local == "PurchaseOrder" && plain.space == "urn:example:po")
}
