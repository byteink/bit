// Independent fixtures: xmlsec1 1.3.11 (OpenSSL 3.5.9), existing Alpine container.
// Generated with xmlsec1 --encrypt --pubkey-pem:recipient pub.pem
// --session-key aes-128|aes-256 --xml-data plain.xml template.xml.
// Every ciphertext was independently accepted by xmlsec1 --decrypt.
// CBC fixes MGF1 SHA-1; GCM uses explicit MGF1 SHA-256. Both label hashes
// occur with both MGF1 hashes. The embedded private key is test-only.
// Source algorithm profile: https://www.w3.org/TR/xmlenc-core1/#sec-Algorithms
import { rsaParsePrivateKey, encodeBase64 } from "std/crypto"

