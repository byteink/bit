// stdlib/xml/tree.test.bit — the element tree against the S3 response bodies
// the AWS API reference prints, and against the rules of Namespaces in XML 1.0
// (https://www.w3.org/TR/xml-names/: §6.1 default namespace and prefixes, §6.2
// scoping, §6.3 attribute uniqueness, §3 reserved prefixes).
//
// Sample bodies are pinned as the pages print them, minus the `<?xml ...?>`
// line, which the Writer never writes. Pages fetched 2026-10-04:
// API_ListObjectsV2.html (the `quotes` sample), API_CompleteMultipartUpload.html
// (the 200 and 403 samples; the page prints the literal text `<Region>` inside
// `Location`, which is not well-formed, so it is `&lt;Region&gt;` here) and
// API_PutBucketLifecycleConfiguration.html. Helpers (`attr1`, `wnew`, `s3ns`,
// `xsiNs`) are in write.test.bit; `wantKind` is in token.test.bit.

import { runRecovering } from "std/runtime"

fn tree(src: string): Element {
  return parse([]byte(src)) catch err {
    panic("parse refused '${src}': ${err.message()}")
  }
}

// The failure `parse(src)` raises, or None.
fn treeFailure(src: string): Option<XmlError> {
  let out = Option<XmlError>.None
  parse([]byte(src)) catch err {
    let (e, ok) = err.(XmlError)
    assert(ok, "not an XmlError: ${err.message()}")
    out = Option<XmlError>.Some(e)
  }
  return out
}

fn wantTreeFail(src: string, kind: XmlErrorKind) {
  wantKind(treeFailure(src), kind, "'${src}'")
}

// `e` and everything under it, written with the Writer exactly as read.
fn writeTree(w: Writer, e: Element) {
  w.start(e.name, e.attrs) catch err {
    panic(err.message())
  }
  let i = 0
  while (i < len(e.nodes)) {
    match (e.nodes[i]) {
      Elem(c) => writeTree(w, c)
      Text(s) => {
        w.text(s) catch err {
          panic(err.message())
        }
      }
    }
    i = i + 1
  }
  w.end() catch err {
    panic(err.message())
  }
}

fn roundTrip(src: string): string {
  let w = wnew()
  writeTree(w, tree(src))
  return string(
    w.finish() catch err {
      panic(err.message())
    },
  )
}

fn wantRoundTrip(src: string, what: string) {
  let got = roundTrip(src)
  assert(got == src, "${what}\n got ${got}\nwant ${src}")
}

// The child `name` of `e`; a missing one fails the test.
fn el(e: Element, name: string): Element {
  match (e.child(name)) {
    Some(c) => return c
    None => panic("no child ${name} in ${e.name}")
  }
}

// The attribute `name` in `space` of `e`; a missing one fails the test.
fn at(e: Element, name: string, space: string): string {
  match (e.attr(name, space)) {
    Some(v) => return v
    None => panic("no attribute ${name} in ${e.name}")
  }
}

fn textOf(e: Element, name: string): string {
  match (e.child(name)) {
    Some(c) => return c.text()
    None => return "<no ${name}>"
  }
}

// ---- the four S3 bodies: parse, then write, byte for byte ------------------

const sampleList = `<ListBucketResult xmlns="http://s3.amazonaws.com/doc/2006-03-01/">
  <Name>quotes</Name>
  <Prefix>E</Prefix>
  <StartAfter>ExampleGuide.pdf</StartAfter>
  <KeyCount>1</KeyCount>
  <MaxKeys>3</MaxKeys>
  <IsTruncated>false</IsTruncated>
  <Contents>
    <Key>ExampleObject.txt</Key>
    <LastModified>2013-09-17T18:07:53.000Z</LastModified>
    <ETag>"599bab3ed2c697f1d26842727561fd94"</ETag>
    <Size>857</Size>
    <StorageClass>REDUCED_REDUNDANCY</StorageClass>
  </Contents>
</ListBucketResult>`

const sampleError = `<Error>
  <Code>AccessDenied</Code>
 <Message>Access Denied</Message>
 <RequestId>656c76696e6727732072657175657374</RequestId>
 <HostId>Uuag1LuByRx9e6j5Onimru9pO4ZVKnJ2Qz7/C1NPcfTWAtRPfTaOFg==</HostId>
</Error>`

const sampleDone = `<CompleteMultipartUploadResult xmlns="http://s3.amazonaws.com/doc/2006-03-01/">
 <Location>http://amzn-s3-demo-bucket.s3.&lt;Region&gt;.amazonaws.com/Example-Object</Location>
 <Bucket>amzn-s3-demo-bucket</Bucket>
 <Key>Example-Object</Key>
 <ETag>"3858f62230ac3c915f300c664312c11f-9"</ETag>
</CompleteMultipartUploadResult>`

const sampleRules = `<LifecycleConfiguration xmlns="http://s3.amazonaws.com/doc/2006-03-01/">
  <Rule>
    <ID>id1</ID>
    <Filter>
       <Prefix>documents/</Prefix>
    </Filter>
    <Status>Enabled</Status>
    <Transition>
      <Days>30</Days>
      <StorageClass>GLACIER</StorageClass>
    </Transition>
  </Rule>
  <Rule>
    <ID>id2</ID>
    <Filter>
       <Prefix>logs/</Prefix>
    </Filter>
    <Status>Enabled</Status>
    <Expiration>
      <Days>365</Days>
    </Expiration>
  </Rule>
</LifecycleConfiguration>`

test "S3 1: ListBucketResult parses and writes back byte-stable" {
  wantRoundTrip(sampleList, "ListBucketResult")
}

test "S3 2: Error parses and writes back byte-stable" {
  wantRoundTrip(sampleError, "Error")
}

test "S3 3: CompleteMultipartUploadResult parses and writes back byte-stable" {
  wantRoundTrip(sampleDone, "CompleteMultipartUploadResult")
}

test "S3 4: LifecycleConfiguration parses and writes back byte-stable" {
  wantRoundTrip(sampleRules, "LifecycleConfiguration")
}

test "S3: the accessors read the values the pages print" {
  let list = tree(sampleList)
  assert(
    list.local == "ListBucketResult" && list.space == s3ns,
    "root ${list.local} in ${list.space}",
  )
  assert(textOf(list, "Name") == "quotes", "Name")
  assert(textOf(list, "KeyCount") == "1", "KeyCount")
  let contents = list.children("Contents")
  assert(len(contents) == 1, "Contents ${len(contents)}")
  assert(textOf(contents[0], "ETag") == "\"599bab3ed2c697f1d26842727561fd94\"", "ETag")
  assert(contents[0].space == s3ns, "a child inherits the default namespace")
  let err = tree(sampleError)
  assert(err.space == "" && textOf(err, "Code") == "AccessDenied", "Error ${err.space}")
  let done = tree(sampleDone)
  assert(
      textOf(done, "Location") ==
      "http://amzn-s3-demo-bucket.s3.<Region>.amazonaws.com/Example-Object",
    "Location",
  )
  let rules = tree(sampleRules).children("Rule")
  assert(len(rules) == 2, "Rule ${len(rules)}")
  let days = el(el(rules[1], "Expiration"), "Days").text()
  assert(days == "365", "Days ${days}")
}

// ---- entities, CDATA, white space ------------------------------------------

test "text: &#13; in a key decodes to CR, a literal CR LF reads as LF" {
  let e = tree("<Key>a&#13;b</Key>")
  assert(e.text() == "a\rb", "got ${e.text()}")
  let lit = tree("<Key>a\r\nb</Key>")
  assert(lit.text() == "a\nb", "got ${lit.text()}")
  assert(
    roundTrip("<Key>a&#13;b</Key>") == "<Key>a&#13;b</Key>",
    "the CR is written back as a reference",
  )
}

test "text: predefined entities decode once, CDATA is text, adjacent runs are one node" {
  let e = tree("<a>&lt;x&gt; &amp;amp;<![CDATA[<raw & ]]>tail<!-- c --><?pi x?>!</a>")
  assert(e.text() == "<x> &amp;<raw & tail!", "got ${e.text()}")
  assert(len(e.nodes) == 1, "nodes ${len(e.nodes)}")
}

test "text: an element's text leaves child elements out, order kept in nodes" {
  let e = tree("<a>x<b>y</b>z<c/></a>")
  assert(e.text() == "xz", "got ${e.text()}")
  assert(len(e.nodes) == 4, "nodes ${len(e.nodes)}")
  assert(tree("<a/>").text() == "", "empty element")
}

test "child: first match, children in order, None and empty when absent" {
  let e = tree("<a><b>1</b><c/><b>2</b></a>")
  assert(textOf(e, "b") == "1", "first b")
  assert(len(e.children("b")) == 2 && e.children("b")[1].text() == "2", "b children")
  assert(!isSome(e.child("zz")), "absent child")
  assert(len(e.children("zz")) == 0, "absent children")
  assert(!isSome(e.child("a")), "an element is not its own child")
}

// ---- namespaces: scoping (3 cases) -----------------------------------------

test "scope 1: the default namespace is inherited, xmlns=\"\" ends it, and it ends with its element" {
  let e = tree("<a xmlns=\"u:1\"><b/><c xmlns=\"\"><d/></c><e xmlns=\"u:2\"/><f/></a>")
  assert(e.space == "u:1", "a ${e.space}")
  assert(el(e, "b").space == "u:1", "b inherits")
  let c = el(e, "c")
  assert(c.space == "" && el(c, "d").space == "", "xmlns=\"\" undeclares")
  assert(el(e, "e").space == "u:2", "e rebinds on itself")
  assert(el(e, "f").space == "u:1", "the outer binding returns after e")
}

test "scope 2: a prefix covers its own element, shadows, and the outer binding returns" {
  let e = tree("<p:a xmlns:p=\"u:1\"><p:b xmlns:p=\"u:2\"><p:c/></p:b><p:d/><q:e xmlns:q=\"u:1\"/></p:a>")
  assert(e.space == "u:1" && e.local == "a" && e.name == "p:a", "a ${e.space} ${e.local}")
  let b = el(e, "b")
  assert(b.space == "u:2" && el(b, "c").space == "u:2", "b and c shadowed")
  assert(el(e, "d").space == "u:1", "d sees the outer p")
  assert(unwrap(e.child("e", Option<string>.Some("u:1"))).name == "q:e", "q:e is in u:1")
  assert(!isSome(e.child("b", Option<string>.Some("u:1"))), "b is not in u:1")
  assert(isSome(e.child("b", Option<string>.Some("u:2"))), "b is in u:2")
}

test "scope 3: attributes take a prefix's namespace, never the default one (the S3 ACL Grantee)" {
  let src = "<AccessControlPolicy xmlns=\"${s3ns}\"><Grantee xmlns:xsi=\"${xsiNs}\" xsi:type=\"Group\" id=\"7\"><URI xmlns=\"\">u</URI></Grantee></AccessControlPolicy>"
  let g = el(tree(src), "Grantee")
  assert(at(g, "type", xsiNs) == "Group", "xsi:type")
  assert(at(g, "id", "") == "7", "id is in no namespace")
  assert(!isSome(g.attr("id", s3ns)), "id is not in the default namespace")
  assert(!isSome(g.attr("type")), "type is not in no namespace")
  assert(at(g, "xsi", "http://www.w3.org/2000/xmlns/") == xsiNs, "a declaration is an attribute")
  assert(el(g, "URI").space == "", "URI undeclares the default")
  assert(roundTrip(src) == src, "the ACL body round-trips")
}

test "scope: xml:lang needs no declaration" {
  let e = tree("<a xml:lang=\"en\"/>")
  assert(at(e, "lang", "http://www.w3.org/XML/1998/namespace") == "en", "xml:lang")
}

// ---- what the tree refuses --------------------------------------------------

test "refuse: a prefix with no declaration, on an element or an attribute" {
  wantTreeFail("<p:a/>", XmlErrorKind.BadName)
  wantTreeFail("<a p:x=\"1\"/>", XmlErrorKind.BadName)
  wantTreeFail("<a><b xmlns:p=\"u\"/><p:c/></a>", XmlErrorKind.BadName)
}

test "refuse: a name with more than one colon or an empty side" {
  wantTreeFail("<a:b:c xmlns:a=\"u\"/>", XmlErrorKind.BadName)
  wantTreeFail("<a :x=\"1\"/>", XmlErrorKind.BadName)
  wantTreeFail("<a x:=\"1\"/>", XmlErrorKind.BadName)
  wantTreeFail("<a xmlns:b:c=\"u\"/>", XmlErrorKind.BadName)
}

test "refuse: two attributes with one expanded name (6.3)" {
  wantTreeFail(
    "<a xmlns:p=\"u\" xmlns:q=\"u\" p:x=\"1\" q:x=\"2\"/>",
    XmlErrorKind.DuplicateAttribute,
  )
  let ok = tree("<a xmlns:p=\"u\" xmlns:q=\"v\" p:x=\"1\" q:x=\"2\" x=\"3\"/>")
  assert(at(ok, "x", "u") == "1" && at(ok, "x", "v") == "2" && at(ok, "x", "") == "3", "three x")
}

test "refuse: reserved prefixes and namespaces bind only as section 3 allows" {
  wantTreeFail("<a xmlns:xmlns=\"u\"/>", XmlErrorKind.BadAttribute)
  wantTreeFail("<a xmlns:xml=\"u\"/>", XmlErrorKind.BadAttribute)
  wantTreeFail("<a xmlns:p=\"http://www.w3.org/XML/1998/namespace\"/>", XmlErrorKind.BadAttribute)
  wantTreeFail("<a xmlns=\"http://www.w3.org/2000/xmlns/\"/>", XmlErrorKind.BadAttribute)
  wantTreeFail("<a xmlns:p=\"\"/>", XmlErrorKind.BadAttribute)
  assert(
    tree("<a xmlns:xml=\"http://www.w3.org/XML/1998/namespace\"/>").local == "a",
    "xml to its own URI",
  )
}

test "refuse: everything the Tokenizer refuses, with its kind and position" {
  wantTreeFail("", XmlErrorKind.UnexpectedEof)
  wantTreeFail("<a>", XmlErrorKind.UnexpectedEof)
  wantTreeFail("<a></b>", XmlErrorKind.MismatchedTag)
  wantTreeFail("<a/><b/>", XmlErrorKind.Syntax)
  wantTreeFail(
    "<!DOCTYPE a [<!ENTITY x SYSTEM \"file:///etc/passwd\">]><a>&x;</a>",
    XmlErrorKind.Doctype,
  )
  wantTreeFail("<a>\x01</a>", XmlErrorKind.BadChar)
  let e = unwrap(treeFailure("<a>\n  <b p:x=\"1\"/></a>"))
  assert(
    e.kind == XmlErrorKind.BadName && e.offset == 6 && e.line == 2 && e.column == 3,
    "at ${e.offset} ${e.line}:${e.column}",
  )
}

// The failure `parse` raises under these limits, or None.
fn limitFailure(
  src: string,
  maxDepth: int,
  maxAttrs: int,
  maxInput: int,
  maxName: int,
): Option<XmlError> {
  let out = Option<XmlError>.None
  parse([]byte(src), maxDepth, maxAttrs, maxInput, maxName) catch err {
    let (e, ok) = err.(XmlError)
    assert(ok, "not an XmlError: ${err.message()}")
    out = Option<XmlError>.Some(e)
  }
  return out
}

test "limits: depth is the Tokenizer's and bounded" {
  let deep = "<a><a><a><a/></a></a></a>"
  assert(!isSome(limitFailure(deep, 4, 256, 1024, 1024)), "depth 4 holds")
  wantKind(limitFailure(deep, 3, 256, 1024, 1024), XmlErrorKind.TooDeep, "depth 3")
}

test "limits: attribute count, input size, name length and a bad limit" {
  let two = "<a x=\"1\" y=\"2\"/>"
  assert(!isSome(limitFailure(two, 256, 2, 1024, 1024)), "two attributes fit 2")
  wantKind(limitFailure(two, 256, 1, 1024, 1024), XmlErrorKind.TooManyAttributes, "attrs")
  assert(!isSome(limitFailure("<a/>", 256, 256, 4, 1024)), "4 bytes fit 4")
  wantKind(limitFailure("<a/>", 256, 256, 3, 1024), XmlErrorKind.TooLarge, "input")
  assert(!isSome(limitFailure("<ab/>", 256, 256, 1024, 2)), "2-byte name fits 2")
  wantKind(limitFailure("<abc/>", 256, 256, 1024, 2), XmlErrorKind.NameTooLong, "name")
  wantKind(limitFailure("<a/>", 0, 256, 1024, 1024), XmlErrorKind.BadLimit, "limit")
}

test "child, children and attr panic on a name that cannot be a local name" {
  let e = tree("<a xmlns:p=\"u\"><p:b/></a>")
  let (p1, m1) = runRecovering(() => {
    e.child("p:b")
  })
  assert(p1 && m1 != "", "child with a colon")
  let (p2, _) = runRecovering(() => {
    e.children("")
  })
  assert(p2, "children with an empty name")
  let (p3, _) = runRecovering(() => {
    e.attr("p:x")
  })
  assert(p3, "attr with a colon")
  let (p4, _) = runRecovering(() => {
    e.child("b")
  })
  assert(!p4, "a local name is fine")
}
