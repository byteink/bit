// Bit standard library — xml module, the error every tokenizer and writer failure raises.
//
// One error class with a cause enum, the shape `JsonDecodeError` and
// `SqlRowError` use: `T!` is `T ! error` (SPEC §18.2), so a caller receives the
// `error` interface and branches on `.kind`, not on a type assertion per cause.

// Why a document was refused. Every kind is a refusal: the tokenizer never
// repairs, skips or guesses, and after the first failure it keeps returning that
// same failure.
export enum XmlErrorKind {
  // `<!DOCTYPE` was seen. Refused outright: no DTD means no external entity
  // (XXE) and no entity expansion (billion laughs), by construction.
  Doctype,
  // The input ended inside a construct, before the root element closed, or
  // before any root element began.
  UnexpectedEof,
  // An end tag whose name differs from the open element's, or one with no
  // element open.
  MismatchedTag,
  // A name was required and the bytes there cannot start one.
  BadName,
  // An attribute that is not `name="value"`: a missing `=` or quote, a `<` in
  // the value, or no space between two attributes.
  BadAttribute,
  // The same attribute name twice on one element (XML 1.0 §3.1).
  DuplicateAttribute,
  // `&` that is not one of the five predefined entities or a character
  // reference to a legal XML character.
  BadReference,
  // A `--` inside a comment (XML 1.0 §2.5).
  BadComment,
  // A character the XML Char production forbids (XML 1.0 §2.2): a control
  // character other than tab, LF and CR, U+FFFE or U+FFFF.
  BadChar,
  // Any other grammar violation: text outside the root element, a second root,
  // `]]>` in text, a misplaced XML declaration, a stray `<`.
  Syntax,
  // Elements nest deeper than the tokenizer's `maxDepth`.
  TooDeep,
  // One element carries more attributes than the tokenizer's `maxAttrs`.
  TooManyAttributes,
  // The input is longer than the tokenizer's `maxInput`.
  TooLarge,
  // An XML version other than 1.0, an encoding other than UTF-8 or US-ASCII, or
  // a UTF-16 byte-order mark: bytes this tokenizer would misread, so it refuses
  // them.
  Unsupported,
  // A limit passed to `Tokenizer(...)` is below 1.
  BadLimit,
  // An element or attribute name is longer than the tokenizer's `maxName`.
  NameTooLong,
  // Bytes that are not well-formed UTF-8: a truncated or stray continuation
  // byte, an overlong form, a surrogate, or a value above U+10FFFF.
  BadEncoding,
}

// The error every `Tokenizer` and `Writer` failure produces. `offset` is the
// byte offset into the input of the construct that failed (for a `Writer`, the
// number of bytes written when the call failed); `line` and `column` are 1-based
// and the column counts bytes. `reason` is one phrase saying what was wrong.
export class XmlError {
  export kind: XmlErrorKind
  export offset: int
  export line: int
  export column: int
  export reason: string

  // Satisfies the predeclared `error` interface (SPEC §10.6, §18.3).
  export message(): string {
    return "xml: ${this.reason} at line ${this.line}, column ${this.column}"
  }
}

// The 1-based line and byte column of `offset` in `src`.
fn xmlLocate(src: []byte, offset: int): (int, int) {
  let line = 1
  let lineStart = 0
  let i = 0
  while (i < offset && i < len(src)) {
    if (src[i] == '\n') {
      line = line + 1
      lineStart = i + 1
    }
    i = i + 1
  }
  return line, offset - lineStart + 1
}
