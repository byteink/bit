// Bit standard library — xml module, the byte classes the tokenizer scans by.

// XML 1.0 §2.3 `S`: space, tab, CR, LF.
fn xmlIsWs(b: byte): bool {
  return b == ' ' || b == '\t' || b == '\n' || b == '\r'
}

// An ASCII byte that may begin a Name (XML 1.0 §2.3 `NameStartChar`). A
// non-ASCII character is judged whole, after decoding, by `xmlNameStartRune`.
fn xmlNameStart(b: byte): bool {
  if (b >= 'a' && b <= 'z') {
    return true
  }
  if (b >= 'A' && b <= 'Z') {
    return true
  }
  return b == '_' || b == ':'
}

// An ASCII byte that may continue a Name (`NameChar`).
fn xmlNameChar(b: byte): bool {
  if (xmlNameStart(b)) {
    return true
  }
  return (b >= '0' && b <= '9') || b == '-' || b == '.'
}

// Whether a byte may appear in a document at all: tab, LF, CR and everything
// from space up. The rest of the C0 range is outside the XML 1.0 Char
// production (§2.2) and no escape can bring it in.
fn xmlLegalByte(b: byte): bool {
  return b >= 0x20 || b == '\t' || b == '\n' || b == '\r'
}

// The code point of the UTF-8 sequence at `i` in `src`, or -1 when the bytes
// there are not well-formed UTF-8 (RFC 3629): a lead byte with a missing or
// non-continuation byte, an overlong form, a surrogate (ED A0..BF), a value
// above U+10FFFF, or a continuation byte on its own. Whether the code point is
// a legal XML character is `xmlLegalRune`'s question.
fn xmlDecode(src: []byte, i: int): int {
  let b0 = int(src[i])
  if (b0 < 0x80) {
    return b0
  }
  let n = xmlSeqLen(b0)
  if (n == 0 || i + n > len(src)) {
    return -1
  }
  let r = b0 & (0x7F >> n)
  let k = 1
  while (k < n) {
    let c = int(src[i + k])
    if ((c & 0xC0) != 0x80) {
      return -1
    }
    r = (r << 6) | (c & 0x3F)
    k = k + 1
  }
  // A code point that would have fit a shorter form is an overlong encoding.
  if (xmlRuneLen(r) != n || !xmlIsScalar(r)) {
    return -1
  }
  return r
}

// The length of the sequence a non-ASCII lead byte starts, or 0 for a byte that
// cannot lead one: a continuation byte, C0 and C1 (always overlong), F5 and up.
fn xmlSeqLen(b0: int): int {
  if (b0 >= 0xC2 && b0 <= 0xDF) {
    return 2
  }
  if (b0 >= 0xE0 && b0 <= 0xEF) {
    return 3
  }
  if (b0 >= 0xF0 && b0 <= 0xF4) {
    return 4
  }
  return 0
}

// Whether `r` is a Unicode scalar value: at most U+10FFFF and not a surrogate.
fn xmlIsScalar(r: int): bool {
  return r <= 0x10FFFF && (r < 0xD800 || r > 0xDFFF)
}

// The bytes the UTF-8 form of code point `r` takes.
fn xmlRuneLen(r: int): int {
  if (r < 0x80) {
    return 1
  }
  if (r < 0x800) {
    return 2
  }
  if (r < 0x10000) {
    return 3
  }
  return 4
}

// Whether code point `r` is in the XML 1.0 Char production (§2.2): the only
// code points a character reference may name (§4.1, "Legal Character").
fn xmlLegalRune(r: int): bool {
  if (r == 0x9 || r == 0xA || r == 0xD) {
    return true
  }
  if (r >= 0x20 && r <= 0xD7FF) {
    return true
  }
  if (r >= 0xE000 && r <= 0xFFFD) {
    return true
  }
  return r >= 0x10000 && r <= 0x10FFFF
}

// The value of one hex or decimal digit `b` in `base`, or -1.
fn xmlDigit(b: byte, base: int): int {
  let d = -1
  if (b >= '0' && b <= '9') {
    d = int(b) - int('0')
  } else if (b >= 'a' && b <= 'f') {
    d = int(b) - int('a') + 10
  } else if (b >= 'A' && b <= 'F') {
    d = int(b) - int('A') + 10
  }
  if (d >= base) {
    return -1
  }
  return d
}

// The code point a predefined entity name stands for (XML 1.0 §4.6), or -1: the
// five names are the whole entity table, and nothing can add to it.
fn xmlPredefined(name: string): int {
  if (name == "lt") {
    return int('<')
  }
  if (name == "gt") {
    return int('>')
  }
  if (name == "amp") {
    return int('&')
  }
  if (name == "quot") {
    return int('"')
  }
  if (name == "apos") {
    return int('\'')
  }
  return -1
}

// Whether `chars` may copy byte `b` straight through: not a delimiter, not
// markup, not white space needing normalisation, not a forbidden control byte,
// not the start of a multi-byte character (those are decoded and checked).
// In an attribute value every white-space byte is special (it becomes a space).
fn xmlPlain(b: byte, stop: byte, attr: bool): bool {
  if (b < 0x20) {
    return !attr && (b == '\t' || b == '\n')
  }
  return b < 0x80 && b != '<' && b != '&' && b != ']' && b != stop
}

// The same for the inside of a CDATA section, where only `]` (a possible `]]>`),
// CR (line-end normalisation) and a non-ASCII byte (UTF-8 validation) need a
// look.
fn xmlPlainCData(b: byte): bool {
  return b < 0x80 && xmlLegalByte(b) && b != ']' && b != '\r'
}
