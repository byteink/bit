const dsigEcQ: string = "04cb9005224a01c0c565ce28009f5f870126f89762cfb756cf5f3bfe2005c0fd1c6c78b3cc9e63cda76e90caa6a2727c918f668659d48025aaefe5e70cf35d33d3"

test "dsig vectors: every signed document parses and holds one Signature" {
  let docs = [
    dsigRsaResp,
    dsigRsaIncResp,
    dsigEcResp,
    dsigEcIncResp,
    dsigRsaAssert,
    dsigEcAssert,
    dsigRsaSha1Resp,
    dsigRsa1024Resp,
  ]
  assert(len(docs) == 8, "8 documents")
  let i = 0
  while (i < len(docs)) {
    let n = len(tree(docs[i]).children("Signature")) +
      len(el(tree(docs[i]), "Assertion").children("Signature"))
    assert(n == 1, "document ${i} holds ${n} Signature elements at the two places they are put")
    i = i + 1
  }
}
