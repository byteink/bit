// stdlib/xml/write.test.bit — the Writer against answers that come from outside
// this file, never from the Writer itself.
//
// Escaping vectors are the rules of the XML 1.0 Recommendation
// (https://www.w3.org/TR/xml/): §2.2 Char, §2.4 character data (`&`, `<` and
// `]]>`), §2.11 end-of-line handling (a literal CR is read as LF, so only a
// reference carries one), §3.3.3 attribute-value normalisation (a literal tab,
// CR or LF is read as a space, so only a reference carries one), §4.1 character
// references. Namespace vectors are Namespaces in XML 1.0 §3 (reserved
// prefixes), §6.3 (attribute uniqueness by expanded name).
//
// The S3 request bodies are in write_s3.test.bit.
//
// Every escaped output is also read back through the Tokenizer: what a parser
// reads must equal what was written.

const s3ns = "http://s3.amazonaws.com/doc/2006-03-01/"
const xsiNs = "http://www.w3.org/2001/XMLSchema-instance"

fn wnew(): Writer {
  return Writer() catch err {
    panic("Writer refused: ${err.message()}")
  }
}

fn attr1(name: string, value: string): []Attr {
  return append([]Attr(0), Attr{ name = name, value = value })
}

// `<a>s</a>`, or the failure.
fn textDoc(s: string): string! {
  let w = Writer()?
  w.start("a")?
  w.text(s)?
  w.end()?
  return string(w.finish()?)
}

// `<a x="v"/>`, or the failure.
fn attrDoc(v: string): string! {
  let w = Writer()?
  w.empty("a", attr1("x", v))?
  return string(w.finish()?)
}

// The error `err` is, as an XmlError.
fn asXml(err: error): XmlError {
  let (e, ok) = err.(XmlError)
  assert(ok, "not an XmlError: ${err.message()}")
  return e
}

fn kindIs(got: XmlErrorKind, want: XmlErrorKind, what: string) {
  assert(got == want, "${what}: wrong error kind")
}

// What `src` reads back as: all its text joined, then each attribute value of
// the root joined, through the Tokenizer.
fn readBack(src: string): string {
  let tz = Tokenizer([]byte(src)) catch err {
    panic("Tokenizer refused '${src}': ${err.message()}")
  }
  let out = ""
  let n = 0
  while (n < 1000) {
    let t = tz.next() catch err {
      panic("Tokenizer failed on '${src}': ${err.message()}")
    }
    match (t) {
      Start(tag) => out = "${out}${attrValues(tag.attrs)}"
      Empty(tag) => out = "${out}${attrValues(tag.attrs)}"
      Text(s) => out = "${out}${s}"
      Eof => return out
      _ => {}
    }
    n = n + 1
  }
  return out
}

fn attrValues(attrs: []Attr): string {
  let out = ""
  let i = 0
  while (i < len(attrs)) {
    out = "${out}${attrs[i].value}"
    i = i + 1
  }
  return out
}

fn wantText(s: string, want: string) {
  let got = textDoc(s) catch err {
    assert(false, "text '${s}' failed: ${err.message()}")
    return
  }
  assert(got == "<a>${want}</a>", "text '${s}'\n got ${got}\nwant <a>${want}</a>")
  assert(readBack(got) == s, "text '${s}' reads back as '${readBack(got)}'")
}

fn wantAttr(v: string, want: string) {
  let got = attrDoc(v) catch err {
    assert(false, "attribute '${v}' failed: ${err.message()}")
    return
  }
  assert(got == "<a x=\"${want}\"/>", "attribute '${v}'\n got ${got}\nwant <a x=\"${want}\"/>")
  assert(readBack(got) == v, "attribute '${v}' reads back as '${readBack(got)}'")
}

// ---- 12 escaping cases ------------------------------------------------------

test "escape 1: text & becomes &amp; (2.4)" {
  wantText("AT&T", "AT&amp;T")
}

test "escape 2: text < becomes &lt; (2.4)" {
  wantText("1 < 2", "1 &lt; 2")
}

test "escape 3: text > becomes &gt;, so ]]> cannot appear (2.4)" {
  wantText("a ]]> b", "a ]]&gt; b")
}

test "escape 4: text CR becomes &#13;, LF stays literal (2.11)" {
  wantText("a\r\nb", "a&#13;\nb")
}

test "escape 5: a lone CR in text becomes &#13; (2.11)" {
  wantText("a\rb", "a&#13;b")
}

test "escape 6: text quotes, apostrophes, tab and LF are literal (2.4)" {
  wantText("say \"hi\" it's\tok\n", "say \"hi\" it's\tok\n")
}

test "escape 7: attribute \" becomes &quot; (3.3.3, AttValue)" {
  wantAttr("say \"hi\"", "say &quot;hi&quot;")
}

test "escape 8: attribute & < > become references (2.4, 3.1)" {
  wantAttr("a&b<c>d", "a&amp;b&lt;c&gt;d")
}

test "escape 9: attribute tab becomes &#9; (3.3.3)" {
  wantAttr("a\tb", "a&#9;b")
}

test "escape 10: attribute LF becomes &#10; (3.3.3)" {
  wantAttr("a\nb", "a&#10;b")
}

test "escape 11: attribute CR becomes &#13; (3.3.3)" {
  wantAttr("a\rb", "a&#13;b")
}

test "escape 12: apostrophe and non-ASCII pass through unchanged (4.1)" {
  wantAttr("it's é€😀 \u{FFFD}", "it's é€😀 \u{FFFD}")
  wantText("é€😀 \x7F", "é€😀 \x7F")
}

test "escape: every ASCII byte allowed in XML round-trips in text and attribute" {
  let b = []byte(0)
  let c = 1
  while (c < 128) {
    if (c >= 0x20 || c == 9 || c == 10 || c == 13) {
      b = append(b, byte(c))
    }
    c = c + 1
  }
  let all = string(b)
  let t = textDoc(all) catch err {
    panic(err.message())
  }
  assert(readBack(t) == all, "text of every legal ASCII byte")
  let a = attrDoc(all) catch err {
    panic(err.message())
  }
  assert(readBack(a) == all, "attribute of every legal ASCII byte")
}

// ---- illegal characters are errors, not output --------------------------------

fn wantTextBad(s: string, what: string) {
  textDoc(s) catch err {
    kindIs(asXml(err).kind, XmlErrorKind.BadChar, what)
    return
  }
  assert(false, "${what}: written, want BadChar")
}

fn wantAttrBad(v: string, what: string) {
  attrDoc(v) catch err {
    kindIs(asXml(err).kind, XmlErrorKind.BadChar, what)
    return
  }
  assert(false, "${what}: written, want BadChar")
}

test "invalid 1: a NUL in text is refused (2.2)" {
  wantTextBad("a\x00b", "NUL in text")
}

test "invalid 2: a C0 control in an attribute value is refused (2.2)" {
  wantAttrBad("a\x1Fb", "0x1F in attribute")
}

test "invalid: every forbidden C0 byte is refused in text and attribute" {
  let c = 0
  while (c < 0x20) {
    if (c != 9 && c != 10 && c != 13) {
      let s = "x${string([]byte{ byte(c) })}y"
      wantTextBad(s, "C0 byte ${c} in text")
      wantAttrBad(s, "C0 byte ${c} in attribute")
    }
    c = c + 1
  }
}

test "invalid: U+FFFE and U+FFFF are outside Char (2.2)" {
  wantTextBad("a\xEF\xBF\xBEb", "U+FFFE")
  wantAttrBad("a\xEF\xBF\xBFb", "U+FFFF")
}

test "invalid: ill-formed UTF-8 is refused, never repaired" {
  wantTextBad("a\xC3", "truncated sequence")
  wantTextBad("a\xFF", "0xFF byte")
  wantTextBad("a\xC0\x80b", "overlong NUL")
  wantAttrBad("a\xED\xA0\x80b", "encoded surrogate")
  wantAttrBad("a\xF4\x90\x80\x80b", "above U+10FFFF")
}

test "invalid: a refused call writes nothing and the error says where" {
  let w = wnew()
  w.start("a") catch err {
    panic(err.message())
  }
  w.text("a\x00") catch err {
    let e = asXml(err)
    assert(e.offset == 3, "offset is the bytes written so far, got ${e.offset}")
    assert(e.line == 1 && e.column == 4, "position ${e.line}:${e.column}")
    return
  }
  assert(false, "text with NUL was accepted")
}

// ---- names ----------------------------------------------------------------------

fn wantNameBad(name: string) {
  let w = wnew()
  w.empty(name) catch err {
    kindIs(asXml(err).kind, XmlErrorKind.BadName, "name '${name}'")
    return
  }
  assert(false, "name '${name}' was accepted")
}

fn wantNameOk(name: string) {
  let w = wnew()
  w.empty(name) catch err {
    assert(false, "name '${name}' refused: ${err.message()}")
  }
}

test "names: what XML 1.0 2.3 forbids is refused" {
  wantNameBad("")
  wantNameBad("1a")
  wantNameBad("-a")
  wantNameBad(".a")
  wantNameBad("a b")
  wantNameBad("a<b")
  wantNameBad("a>b")
  wantNameBad("a/b")
  wantNameBad("a=b")
  wantNameBad("a\"b")
  wantNameBad("a&b")
  wantNameBad("a\nb")
  wantNameBad("a\x00")
  wantNameBad("\xC2\xA0a")
  wantNameBad("a\xC3")
  wantNameBad("\xC3\x97")
  wantNameBad("\xE2\x80\x93")
}

test "names: what 2.3 allows is accepted" {
  wantNameOk("a")
  wantNameOk("_a")
  wantNameOk("Abc-1.2_3")
  wantNameOk("\xC3\xA9")
  wantNameOk("a\xC2\xB7b")
  wantNameOk("\xE6\x97\xA5\xE6\x9C\xAC")
  wantNameOk("\xF0\x90\x80\x80")
}

test "names: every NameStartChar range edge of 2.3 (5th edition)" {
  wantNameOk("\u{C0}")
  wantNameBad("\u{D7}")
  wantNameOk("\u{D8}")
  wantNameOk("\u{F6}")
  wantNameBad("\u{F7}")
  wantNameOk("\u{F8}")
  wantNameOk("\u{2FF}")
  wantNameBad("\u{300}")
  wantNameBad("\u{36F}")
  wantNameBad("\u{36F}a")
  wantNameBad("\u{37E}")
  wantNameOk("\u{370}")
  wantNameOk("\u{37D}")
  wantNameOk("\u{37F}")
  wantNameOk("\u{1FFF}")
  wantNameBad("\u{2000}")
  wantNameBad("\u{200B}")
  wantNameOk("\u{200C}")
  wantNameOk("\u{200D}")
  wantNameBad("\u{200E}")
  wantNameBad("\u{206F}")
  wantNameOk("\u{2070}")
  wantNameOk("\u{218F}")
  wantNameBad("\u{2190}")
  wantNameBad("\u{2BFF}")
  wantNameOk("\u{2C00}")
  wantNameOk("\u{2FEF}")
  wantNameBad("\u{2FF0}")
  wantNameBad("\u{3000}")
  wantNameOk("\u{3001}")
  wantNameOk("\u{D7FF}")
  wantNameBad("\u{E000}")
  wantNameBad("\u{F8FF}")
  wantNameOk("\u{F900}")
  wantNameOk("\u{FDCF}")
  wantNameBad("\u{FDD0}")
  wantNameBad("\u{FDEF}")
  wantNameOk("\u{FDF0}")
  wantNameOk("\u{FFFD}")
  wantNameBad("\u{FFFE}")
  wantNameOk("\u{10000}")
  wantNameOk("\u{EFFFF}")
  wantNameBad("\u{F0000}")
}

test "names: NameChar additions are not name starts (2.3)" {
  wantNameOk("a\u{300}")
  wantNameOk("a\u{36F}")
  wantNameOk("a\u{203F}")
  wantNameOk("a\u{2040}")
  wantNameBad("\u{203F}")
  wantNameBad("a\u{2041}")
  wantNameOk("a0")
  wantNameBad("0a")
}

test "names: a middle dot may continue a name but not start one (2.3)" {
  wantNameBad("\xC2\xB7a")
  wantNameBad("a:\xC2\xB7")
}

test "names: a qualified name has at most one colon with a part on each side" {
  wantNameBad("a:b:c")
  wantNameBad(":a")
  wantNameBad("a:")
  wantNameBad(":")
  wantNameBad("ns:a")
}

test "names: an invalid attribute name is refused and writes nothing" {
  let w = wnew()
  w.start("a", attr1("b c", "v")) catch err {
    kindIs(asXml(err).kind, XmlErrorKind.BadName, "attribute name")
    return
  }
  assert(false, "attribute name with a space was accepted")
}

// ---- structure --------------------------------------------------------------------

fn failOf(w: Writer): XmlErrorKind {
  let k = XmlErrorKind.BadLimit
  w.finish() catch err {
    k = asXml(err).kind
    return k
  }
  assert(false, "finish succeeded")
  return k
}

test "structure: end with nothing open is MismatchedTag" {
  let w = wnew()
  w.end() catch err {
    kindIs(asXml(err).kind, XmlErrorKind.MismatchedTag, "end() on an empty writer")
    return
  }
  assert(false, "end() succeeded")
}

test "structure: one more end than start is MismatchedTag" {
  let w = wnew()
  w.start("a") catch err {
    panic(err.message())
  }
  w.end() catch err {
    panic(err.message())
  }
  w.end() catch err {
    kindIs(asXml(err).kind, XmlErrorKind.MismatchedTag, "second end()")
    return
  }
  assert(false, "second end() succeeded")
}

test "structure: text outside the root and a second root are Syntax" {
  let w = wnew()
  w.text("x") catch err {
    kindIs(asXml(err).kind, XmlErrorKind.Syntax, "text before the root")
  }
  let v = wnew()
  v.empty("a") catch err {
    panic(err.message())
  }
  v.empty("b") catch err {
    kindIs(asXml(err).kind, XmlErrorKind.Syntax, "second root")
    return
  }
  assert(false, "second root accepted")
}

test "structure: text and a second root after the root closed are refused" {
  let w = wnew()
  w.start("a") catch err {
    panic(err.message())
  }
  w.end() catch err {
    panic(err.message())
  }
  w.text("x") catch err {
    kindIs(asXml(err).kind, XmlErrorKind.Syntax, "text after the root")
    return
  }
  assert(false, "text after the root accepted")
}

test "structure: finish with an element open, or nothing written, is UnexpectedEof" {
  let w = wnew()
  w.start("a") catch err {
    panic(err.message())
  }
  kindIs(failOf(w), XmlErrorKind.UnexpectedEof, "open element")
  kindIs(failOf(wnew()), XmlErrorKind.UnexpectedEof, "empty writer")
}

test "structure: the first failure is final, finish included" {
  let w = wnew()
  w.start("a") catch err {
    panic(err.message())
  }
  w.text("\x00") catch err {
    kindIs(asXml(err).kind, XmlErrorKind.BadChar, "first failure")
  }
  w.text("fine") catch err {
    kindIs(asXml(err).kind, XmlErrorKind.BadChar, "a later call returns the first failure")
  }
  w.end() catch err {
    kindIs(asXml(err).kind, XmlErrorKind.BadChar, "end() after a failure")
  }
  kindIs(failOf(w), XmlErrorKind.BadChar, "finish after a failure")
}

test "structure: finish hands over the document and the Writer takes no more" {
  let w = wnew()
  w.empty("a") catch err {
    panic(err.message())
  }
  let doc = w.finish() catch err {
    panic(err.message())
  }
  assert(string(doc) == "<a/>", "document ${string(doc)}")
  w.start("b") catch err {
    kindIs(asXml(err).kind, XmlErrorKind.Syntax, "start after finish")
    return
  }
  assert(false, "start after finish accepted")
}

test "structure: nested elements, mixed content and attributes in order" {
  let w = wnew()
  let attrs = append(attr1("id", "7"), Attr{ name = "k", value = "v" })
  w.start("a", attrs) catch err {
    panic(err.message())
  }
  w.text("x") catch err {
    panic(err.message())
  }
  w.empty("b") catch err {
    panic(err.message())
  }
  w.start("c") catch err {
    panic(err.message())
  }
  w.text("y & z") catch err {
    panic(err.message())
  }
  w.end() catch err {
    panic(err.message())
  }
  w.text("") catch err {
    panic(err.message())
  }
  w.end() catch err {
    panic(err.message())
  }
  let doc = string(
    w.finish() catch err {
      panic(err.message())
    },
  )
  assert(doc == "<a id=\"7\" k=\"v\">x<b/><c>y &amp; z</c></a>", "document ${doc}")
}

// ---- limits -----------------------------------------------------------------------

// The kind `Writer(maxDepth, maxAttrs)` is refused with.
fn limitKind(maxDepth: int, maxAttrs: int): XmlErrorKind {
  Writer(maxDepth = maxDepth, maxAttrs = maxAttrs) catch err {
    return asXml(err).kind
  }
  panic("Writer(${maxDepth}, ${maxAttrs}) was accepted")
}

test "limits: depth and attribute count are bounded, a limit below 1 is refused" {
  let w = Writer(maxDepth = 2) catch err {
    panic(err.message())
  }
  w.start("a") catch err {
    panic(err.message())
  }
  w.start("b") catch err {
    panic(err.message())
  }
  w.start("c") catch err {
    kindIs(asXml(err).kind, XmlErrorKind.TooDeep, "third level under maxDepth = 2")
  }
  let v = Writer(maxAttrs = 1) catch err {
    panic(err.message())
  }
  let two = append(attr1("x", "1"), Attr{ name = "y", value = "2" })
  v.empty("a", two) catch err {
    kindIs(asXml(err).kind, XmlErrorKind.TooManyAttributes, "two under maxAttrs = 1")
  }
  kindIs(limitKind(0, 256), XmlErrorKind.BadLimit, "maxDepth 0")
  kindIs(limitKind(256, 0), XmlErrorKind.BadLimit, "maxAttrs 0")
  kindIs(limitKind(-1, 256), XmlErrorKind.BadLimit, "maxDepth -1")
}

// ---- namespaces -------------------------------------------------------------------

fn nsFail(w: Writer, name: string, attrs: []Attr, kind: XmlErrorKind, what: string) {
  w.empty(name, attrs) catch err {
    kindIs(asXml(err).kind, kind, what)
    return
  }
  assert(false, "${what}: accepted")
}

test "namespaces: duplicate attribute names are refused" {
  let attrs = append(attr1("x", "1"), Attr{ name = "x", value = "2" })
  nsFail(wnew(), "a", attrs, XmlErrorKind.DuplicateAttribute, "x twice")
}

test "namespaces: a prefix with no declaration in scope is refused" {
  nsFail(wnew(), "xsi:a", attr1("x", "1"), XmlErrorKind.BadName, "element prefix")
  nsFail(wnew(), "a", attr1("xsi:type", "T"), XmlErrorKind.BadName, "attribute prefix")
}

test "namespaces: a declaration on the element covers its own name and attributes" {
  let attrs = append(attr1("xmlns:xsi", xsiNs), Attr{ name = "xsi:type", value = "Group" })
  let w = wnew()
  w.empty("xsi:Grantee", attrs) catch err {
    panic(err.message())
  }
  let doc = string(
    w.finish() catch err {
      panic(err.message())
    },
  )
  assert(doc == "<xsi:Grantee xmlns:xsi=\"${xsiNs}\" xsi:type=\"Group\"/>", "document ${doc}")
}

test "namespaces: a declaration ends with its element" {
  let w = wnew()
  w.start("a") catch err {
    panic(err.message())
  }
  w.empty("b", attr1("xmlns:p", "urn:p")) catch err {
    panic(err.message())
  }
  nsFail(w, "p:c", []Attr(0), XmlErrorKind.BadName, "p after the declaring element closed")
}

test "namespaces: a declaration is inherited by descendants" {
  let w = wnew()
  w.start("a", attr1("xmlns:p", "urn:p")) catch err {
    panic(err.message())
  }
  w.start("b") catch err {
    panic(err.message())
  }
  w.empty("p:c", attr1("p:n", "1")) catch err {
    panic(err.message())
  }
  w.end() catch err {
    panic(err.message())
  }
  w.end() catch err {
    panic(err.message())
  }
  let doc = string(
    w.finish() catch err {
      panic(err.message())
    },
  )
  assert(doc == "<a xmlns:p=\"urn:p\"><b><p:c p:n=\"1\"/></b></a>", "document ${doc}")
}

test "namespaces: an inner declaration shadows, and the outer one returns after it" {
  let w = wnew()
  w.start("a", attr1("xmlns:p", "urn:x")) catch err {
    panic(err.message())
  }
  let inner = append(attr1("xmlns:p", "urn:y"), Attr{ name = "xmlns:q", value = "urn:x" })
  w.start("b", inner) catch err {
    panic(err.message())
  }
  w.end() catch err {
    panic(err.message())
  }
  // p is urn:x again, q is gone: p:n and q:n must not be both accepted here.
  nsFail(w, "q:c", []Attr(0), XmlErrorKind.BadName, "q after b closed")
}

test "namespaces: two prefixes for one namespace clash on one local name (6.3)" {
  let attrs = append(attr1("xmlns:p", "urn:x"), Attr{ name = "xmlns:q", value = "urn:x" })
  attrs = append(attrs, Attr{ name = "p:n", value = "1" })
  attrs = append(attrs, Attr{ name = "q:n", value = "2" })
  nsFail(wnew(), "a", attrs, XmlErrorKind.DuplicateAttribute, "p:n and q:n in urn:x")
}

test "namespaces: the same local name in two namespaces is fine (6.3)" {
  let attrs = append(attr1("xmlns:p", "urn:x"), Attr{ name = "xmlns:q", value = "urn:y" })
  attrs = append(attrs, Attr{ name = "p:n", value = "1" })
  attrs = append(attrs, Attr{ name = "q:n", value = "2" })
  let w = wnew()
  w.empty("a", attrs) catch err {
    panic(err.message())
  }
}

test "namespaces: reserved prefixes and namespaces bind only as 3 allows" {
  let xmlUri = "http://www.w3.org/XML/1998/namespace"
  let xmlnsUri = "http://www.w3.org/2000/xmlns/"
  nsFail(wnew(), "a", attr1("xmlns:xmlns", "urn:x"), XmlErrorKind.BadAttribute, "bind xmlns")
  nsFail(wnew(), "a", attr1("xmlns:xml", "urn:x"), XmlErrorKind.BadAttribute, "xml to another URI")
  nsFail(wnew(), "a", attr1("xmlns:p", xmlUri), XmlErrorKind.BadAttribute, "xml URI to p")
  nsFail(wnew(), "a", attr1("xmlns", xmlUri), XmlErrorKind.BadAttribute, "xml URI as default")
  nsFail(wnew(), "a", attr1("xmlns:p", xmlnsUri), XmlErrorKind.BadAttribute, "xmlns URI to p")
  nsFail(wnew(), "a", attr1("xmlns", xmlnsUri), XmlErrorKind.BadAttribute, "xmlns URI as default")
  nsFail(wnew(), "a", attr1("xmlns:p", ""), XmlErrorKind.BadAttribute, "p bound to nothing")
  nsFail(wnew(), "xmlns:a", []Attr(0), XmlErrorKind.BadName, "xmlns as an element prefix")
  let w = wnew()
  w.empty("a", append(attr1("xmlns:xml", xmlUri), Attr{ name = "xml:lang", value = "en" })) catch err {
    panic("the xml prefix bound to its own URI: ${err.message()}")
  }
}

test "namespaces: xml:lang needs no declaration, xmlns=\"\" undeclares the default" {
  let w = wnew()
  w.start("a", attr1("xmlns", "urn:d")) catch err {
    panic(err.message())
  }
  w.empty("b", append(attr1("xmlns", ""), Attr{ name = "xml:lang", value = "en" })) catch err {
    panic(err.message())
  }
  w.end() catch err {
    panic(err.message())
  }
  let doc = string(
    w.finish() catch err {
      panic(err.message())
    },
  )
  assert(doc == "<a xmlns=\"urn:d\"><b xmlns=\"\" xml:lang=\"en\"/></a>", "document ${doc}")
}
