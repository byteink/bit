// Bit standard library — xml module, what the Writer checks and escapes.
//
// A string handed to the Writer is validated before one byte of it is copied:
// it must be well-formed UTF-8 and every code point must be in the XML 1.0 Char
// production (§2.2). Escaping then only has to look at ASCII, because every
// byte of a multi-byte sequence is 0x80 or more and is copied through whole.

import { decodeRuneAt } from "std/strings"

// The byte offset in `s` of the first byte that cannot be written, or -1 when
// all of `s` can: an ill-formed UTF-8 sequence, or a code point outside the
// Char production (a C0 control other than tab, LF and CR, U+FFFE, U+FFFF).
fn xmlBadAt(s: string): int {
  let i = 0
  while (i < len(s)) {
    if (s[i] < 0x80) {
      if (!xmlLegalByte(s[i])) {
        return i
      }
      i = i + 1
      continue
    }
    let (r, n) = decodeRuneAt(s, i)
    // (U+FFFD, 1 byte) is how decodeRuneAt reports a rejected byte; a real
    // U+FFFD is the three bytes EF BF BD.
    if ((n == 1 && int(r) == 0xFFFD) || !xmlLegalRune(int(r))) {
      return i
    }
    i = i + n
  }
  return -1
}

// The replacement for byte `b`, or "" when `b` is written as it is. Text
// escapes `&`, `<`, `>` (always, so `]]>` can never appear) and CR, which a
// parser would otherwise read as LF (§2.11). An attribute value also escapes
// the delimiter `"` and writes tab and LF as references, because a parser turns
// a literal one into a space (§3.3.3).
fn xmlEscapeOf(b: byte, attr: bool): string {
  if (b == '&') {
    return "&amp;"
  }
  if (b == '<') {
    return "&lt;"
  }
  if (b == '>') {
    return "&gt;"
  }
  if (b == '\r') {
    return "&#13;"
  }
  if (!attr) {
    return ""
  }
  if (b == '"') {
    return "&quot;"
  }
  if (b == '\n') {
    return "&#10;"
  }
  if (b == '\t') {
    return "&#9;"
  }
  return ""
}

// `out` with `s` appended and escaped for text, or for an attribute value when
// `attr` is set. `s` must have passed `xmlBadAt`.
fn xmlEscape(out: []byte, s: string, attr: bool): []byte {
  let from = 0
  let i = 0
  while (i < len(s)) {
    let rep = xmlEscapeOf(s[i], attr)
    if (rep != "") {
      out = append(out, s[from:i])
      out = append(out, rep)
      from = i + 1
    }
    i = i + 1
  }
  out = append(out, s[from:len(s)])
  return out
}

// Whether `r` may begin a Name (XML 1.0 5th edition §2.3 `NameStartChar`).
fn xmlNameStartRune(r: int): bool {
  if (r < 0x80) {
    return xmlNameStartAscii(r)
  }
  if (r < 0xC0) {
    return false
  }
  if (r <= 0x2FF) {
    return r != 0xD7 && r != 0xF7
  }
  if (r < 0x370) {
    return false
  }
  if (r <= 0x1FFF) {
    return r != 0x37E
  }
  return xmlNameStartLow(r) || xmlNameStartHigh(r)
}

// The ASCII `NameStartChar`s: letters, `_` and `:`.
fn xmlNameStartAscii(r: int): bool {
  if (r >= 0x61 && r <= 0x7A) {
    return true
  }
  if (r >= 0x41 && r <= 0x5A) {
    return true
  }
  return r == 0x5F || r == 0x3A
}

// The `NameStartChar` ranges from U+2000 up to U+2FEF.
fn xmlNameStartLow(r: int): bool {
  if (r == 0x200C || r == 0x200D) {
    return true
  }
  if (r >= 0x2070 && r <= 0x218F) {
    return true
  }
  return r >= 0x2C00 && r <= 0x2FEF
}

// The `NameStartChar` ranges from U+3001 up.
fn xmlNameStartHigh(r: int): bool {
  if (r >= 0x3001 && r <= 0xD7FF) {
    return true
  }
  if (r >= 0xF900 && r <= 0xFDCF) {
    return true
  }
  if (r >= 0xFDF0 && r <= 0xFFFD) {
    return true
  }
  return r >= 0x10000 && r <= 0xEFFFF
}

// Whether `r` may continue a Name (`NameChar`).
fn xmlNameRune(r: int): bool {
  if (xmlNameStartRune(r)) {
    return true
  }
  if ((r >= 0x30 && r <= 0x39) || r == 0x2D || r == 0x2E || r == 0xB7) {
    return true
  }
  return (r >= 0x300 && r <= 0x36F) || r == 0x203F || r == 0x2040
}

// Why `name` is not a Name, or "" when it is. Checks the code points, not just
// the bytes: `é` is a name letter, a no-break space is not.
fn xmlNameProblem(name: string): string {
  if (len(name) == 0) {
    return "a name cannot be empty"
  }
  let i = 0
  while (i < len(name)) {
    let (r, n) = decodeRuneAt(name, i)
    if (n == 1 && int(r) == 0xFFFD) {
      return "a name must be well-formed UTF-8"
    }
    let ok = xmlNameRune(int(r))
    if (i == 0) {
      ok = xmlNameStartRune(int(r))
    }
    if (!ok) {
      return "'${name}' is not an XML name"
    }
    i = i + n
  }
  return ""
}

// Splits a name at its colon: the prefix ("" when there is none) and the local
// part. `ok` is false for a name Namespaces in XML 1.0 §3 does not allow: more
// than one colon, or a colon with nothing on one side.
fn xmlSplitName(name: string): (string, string, bool) {
  let colon = -1
  let i = 0
  while (i < len(name)) {
    if (name[i] == ':') {
      if (colon >= 0) {
        return "", name, false
      }
      colon = i
    }
    i = i + 1
  }
  if (colon < 0) {
    return "", name, true
  }
  if (colon == 0 || colon == len(name) - 1) {
    return "", name, false
  }
  return name[0:colon], name[colon + 1:len(name)], true
}
