// XML Encryption 1.1, sections 3, 5.2 and 5.5.2. Only inline RSA-OAEP keys
// and AES-128/256 GCM/CBC element ciphertexts are accepted (#6967).
import { RsaPrivateKey, rsaDecryptOaep, Aes, AesGcm, cbcDecrypt, secureZero } from "std/crypto"

const encNs: string = "http://www.w3.org/2001/04/xmlenc#"
const enc11Ns: string = "http://www.w3.org/2009/xmlenc11#"
const encMaxBytes: int = 1048576

const encFailure: error = newError("xml-enc: decryption failed")

// Returns a new, untrusted tree. Verify its signature and application policy
// before reading it. Every refusal returns the same error value.
export fn decryptElement(encrypted: Element, key: RsaPrivateKey): Element! {
  return encDecrypt(encrypted, key) catch _ {
    fail encFailure
  }
}

fn encDecrypt(encrypted: Element, key: RsaPrivateKey): Element! {
  if (!encrypted.matches("EncryptedData", Option.Some(encNs))) {
    fail encFailure
  }
  if (encAttr(encrypted, "Type")? != encNs + "Element") {
    fail encFailure
  }
  let bits = bigintBitLen(key.n)
  if (bits < 2048 || bits > 8192) {
    fail encFailure
  }
  let kids = encKids(encrypted)?
  if (len(kids) != 3) {
    fail encFailure
  }
  encRequire(kids[0], "EncryptionMethod", encNs)?
  encRequire(kids[1], "KeyInfo", dsigNs)?
  encRequire(kids[2], "CipherData", encNs)?
  let alg = encAttr(kids[0], "Algorithm")?
  if (len(encKids(kids[0])?) != 0) {
    fail encFailure
  }
  let size = encKeySize(alg)?
  let secret = encUnwrap(kids[1], key)?
  defer secureZero(secret)
  if (len(secret) != size) {
    fail encFailure
  }
  let bytes = encCipher(kids[2], encMaxBytes)?
  let plain = encContent(alg, secret, bytes)?
  defer secureZero(plain)
  return parse(plain, maxInput = encMaxBytes)?
}

fn encRequire(e: Element, name: string, space: string): ()! {
  if (!e.matches(name, Option.Some(space))) {
    fail encFailure
  }
}

fn encAttr(e: Element, name: string): string! {
  if (len(e.attrs) > 256) {
    fail encFailure
  }
  match (e.attr(name)) {
    Some(s) => {
      if (len(s) > 1024) {
        fail encFailure
      }
      return s
    }
    None => fail encFailure
  }
}

fn encBound(e: Element, max: int): ()! {
  if (len(e.nodes) > 32 || len(e.misc) > 0) {
    fail encFailure
  }
  let total = 0
  let i = 0
  while (i < len(e.nodes)) {
    match (e.nodes[i]) {
      Text(s) => {
        if (len(s) > max - total) {
          fail encFailure
        }
        total = total + len(s)
      }
      Elem(_) => {}
    }
    i = i + 1
  }
}

fn encKids(e: Element): []Element! {
  encBound(e, encMaxBytes * 2 + 4)?
  return dsigKids(e, "encrypted element")?
}

fn encKeySize(alg: string): int! {
  if (alg == encNs + "aes128-cbc" || alg == enc11Ns + "aes128-gcm") {
    return 16
  }
  if (alg == encNs + "aes256-cbc" || alg == enc11Ns + "aes256-gcm") {
    return 32
  }
  fail encFailure
}

fn encUnwrap(info: Element, key: RsaPrivateKey): []byte! {
  let entries = encKids(info)?
  if (len(entries) != 1) {
    fail encFailure
  }
  encRequire(entries[0], "EncryptedKey", encNs)?
  let kids = encKids(entries[0])?
  if (len(kids) < 2 || len(kids) > 3) {
    fail encFailure
  }
  encRequire(kids[0], "EncryptionMethod", encNs)?
  encRequire(kids[len(kids) - 1], "CipherData", encNs)?
  if (len(kids) == 3) {
    encRequire(kids[1], "KeyInfo", dsigNs)?
  }
  let method = kids[0]
  let alg = encAttr(method, "Algorithm")?
  if (alg != encNs + "rsa-oaep-mgf1p" && alg != enc11Ns + "rsa-oaep") {
    fail encFailure
  }
  let params = encOaep(method, alg)?
  let ciphertext = encCipher(kids[len(kids) - 1], 1024)?
  return rsaDecryptOaep(key, params.hash, ciphertext, params.label, Option.Some(params.mgf))?
}

class encParams {
  hash: HashAlg = HashAlg.Sha1,
  mgf: HashAlg = HashAlg.Sha1,
  label: []byte,
}

fn encOaep(method: Element, alg: string): encParams! {
  let params = encParams{ label = []byte(0) }
  let seen = map<string, bool>{}
  let kids = encKids(method)?
  let i = 0
  while (i < len(kids)) {
    let e = kids[i]
    let name = e.space + e.local
    if (seen[name]) {
      fail encFailure
    }
    seen[name] = true
    encParameter(params, e, alg)?
    i = i + 1
  }
  return params
}

fn encParameter(params: encParams, e: Element, alg: string): ()! {
  if (e.matches("OAEPparams", Option.Some(encNs))) {
    params.label = encDecode(e, 1024)?
    return
  }
  if (len(encKids(e)?) != 0) {
    fail encFailure
  }
  if (e.matches("DigestMethod", Option.Some(dsigNs))) {
    params.hash = encHash(encAttr(e, "Algorithm")?, dsigSha1, dsigSha256)?
    return
  }
  if (e.matches("MGF", Option.Some(enc11Ns)) && alg == enc11Ns + "rsa-oaep") {
    params.mgf = encHash(encAttr(e, "Algorithm")?, enc11Ns + "mgf1sha1", enc11Ns + "mgf1sha256")?
    return
  }
  fail encFailure
}

fn encHash(uri: string, sha1: string, sha256: string): HashAlg! {
  if (uri == sha1) {
    return HashAlg.Sha1
  }
  if (uri == sha256) {
    return HashAlg.Sha256
  }
  fail encFailure
}

fn encCipher(e: Element, max: int): []byte! {
  let kids = encKids(e)?
  if (len(kids) != 1) {
    fail encFailure
  }
  encRequire(kids[0], "CipherValue", encNs)?
  return encDecode(kids[0], max)?
}

fn encDecode(e: Element, max: int): []byte! {
  encBound(e, max * 2 + 4)?
  let text = dsigText(e, "encrypted bytes")?
  let bytes = dsigDecode(text, max, "encrypted bytes")?
  if (len(bytes) > max) {
    fail encFailure
  }
  return bytes
}

fn encContent(alg: string, key: []byte, bytes: []byte): []byte! {
  if (alg == enc11Ns + "aes128-gcm" || alg == enc11Ns + "aes256-gcm") {
    if (len(bytes) < 28) {
      fail encFailure
    }
    let cipher = AesGcm(key)?
    return cipher.open(bytes[0:12], bytes[12:len(bytes)], []byte(0))?
  }
  if (len(bytes) < 32 || len(bytes) % 16 != 0) {
    fail encFailure
  }
  let plain = cbcDecrypt(Aes(key)?, bytes[0:16], bytes[16:len(bytes)])?
  // XML Encryption padding allows arbitrary preceding bytes, unlike PKCS#7.
  // Unsigned subtraction checks the final count without secret-dependent work.
  let pad = u32(plain[len(plain) - 1])
  let bad = ((pad - u32(1)) | (u32(16) - pad)) >> 31
  if (bad != 0) {
    secureZero(plain)
    fail encFailure
  }
  return plain[0:len(plain) - int(pad)]
}
