// Bit standard library — json module, Json value sum type + JsonEntry.
//
// The one value primitive the json epic (#1479) is built on: no parser, no
// encoder, no I/O — just the type and pure accessors. `JsonObject` is
// `[]JsonEntry`, not `map<string, Json>`: insertion order and duplicate keys
// must be preservable up through the CST layer #1479's later tasks build.
//
// Accessors are free functions, mirroring stdlib/core/option.bit's style
// (methods on generic types don't parse yet, and every accessor here returns
// the generic `Option<T>`) rather than methods on `Json`.

// One key/value pair of a JSON object, in source order.
export struct JsonEntry { key: string, value: Json }

// A JSON value (RFC 8259 §3).
export enum Json {
  JsonNull,
  JsonBool(bool),
  JsonInt(i64),
  JsonFloat(f64),
  JsonString(string),
  JsonArray([]Json),
  JsonObject([]JsonEntry),
}

export fn jsonIsNull(j: Json): bool {
  return match (j) {
    JsonNull => true
    JsonBool(_) => false
    JsonInt(_) => false
    JsonFloat(_) => false
    JsonString(_) => false
    JsonArray(_) => false
    JsonObject(_) => false
  }
}

export fn jsonIsBool(j: Json): bool {
  return match (j) {
    JsonNull => false
    JsonBool(_) => true
    JsonInt(_) => false
    JsonFloat(_) => false
    JsonString(_) => false
    JsonArray(_) => false
    JsonObject(_) => false
  }
}

export fn jsonIsInt(j: Json): bool {
  return match (j) {
    JsonNull => false
    JsonBool(_) => false
    JsonInt(_) => true
    JsonFloat(_) => false
    JsonString(_) => false
    JsonArray(_) => false
    JsonObject(_) => false
  }
}

export fn jsonIsFloat(j: Json): bool {
  return match (j) {
    JsonNull => false
    JsonBool(_) => false
    JsonInt(_) => false
    JsonFloat(_) => true
    JsonString(_) => false
    JsonArray(_) => false
    JsonObject(_) => false
  }
}

export fn jsonIsString(j: Json): bool {
  return match (j) {
    JsonNull => false
    JsonBool(_) => false
    JsonInt(_) => false
    JsonFloat(_) => false
    JsonString(_) => true
    JsonArray(_) => false
    JsonObject(_) => false
  }
}

export fn jsonIsArray(j: Json): bool {
  return match (j) {
    JsonNull => false
    JsonBool(_) => false
    JsonInt(_) => false
    JsonFloat(_) => false
    JsonString(_) => false
    JsonArray(_) => true
    JsonObject(_) => false
  }
}

export fn jsonIsObject(j: Json): bool {
  return match (j) {
    JsonNull => false
    JsonBool(_) => false
    JsonInt(_) => false
    JsonFloat(_) => false
    JsonString(_) => false
    JsonArray(_) => false
    JsonObject(_) => true
  }
}

// The bool payload, or None when `j` is not a JsonBool — a shape mismatch
// while decoding untrusted JSON is data, not a crash.
export fn jsonAsBool(j: Json): Option<bool> {
  match (j) {
    JsonBool(b) => return Option<bool>.Some(b)
    JsonNull => return Option<bool>.None
    JsonInt(_) => return Option<bool>.None
    JsonFloat(_) => return Option<bool>.None
    JsonString(_) => return Option<bool>.None
    JsonArray(_) => return Option<bool>.None
    JsonObject(_) => return Option<bool>.None
  }
}

// The int payload, or None when `j` is not a JsonInt.
export fn jsonAsInt(j: Json): Option<i64> {
  match (j) {
    JsonInt(i) => return Option<i64>.Some(i)
    JsonNull => return Option<i64>.None
    JsonBool(_) => return Option<i64>.None
    JsonFloat(_) => return Option<i64>.None
    JsonString(_) => return Option<i64>.None
    JsonArray(_) => return Option<i64>.None
    JsonObject(_) => return Option<i64>.None
  }
}

// The float payload, or None when `j` is not a JsonFloat.
export fn jsonAsFloat(j: Json): Option<f64> {
  match (j) {
    JsonFloat(f) => return Option<f64>.Some(f)
    JsonNull => return Option<f64>.None
    JsonBool(_) => return Option<f64>.None
    JsonInt(_) => return Option<f64>.None
    JsonString(_) => return Option<f64>.None
    JsonArray(_) => return Option<f64>.None
    JsonObject(_) => return Option<f64>.None
  }
}

// The string payload, or None when `j` is not a JsonString.
export fn jsonAsString(j: Json): Option<string> {
  match (j) {
    JsonString(s) => return Option<string>.Some(s)
    JsonNull => return Option<string>.None
    JsonBool(_) => return Option<string>.None
    JsonInt(_) => return Option<string>.None
    JsonFloat(_) => return Option<string>.None
    JsonArray(_) => return Option<string>.None
    JsonObject(_) => return Option<string>.None
  }
}

// The array payload, or None when `j` is not a JsonArray.
export fn jsonAsArray(j: Json): Option<[]Json> {
  match (j) {
    JsonArray(a) => return Option<[]Json>.Some(a)
    JsonNull => return Option<[]Json>.None
    JsonBool(_) => return Option<[]Json>.None
    JsonInt(_) => return Option<[]Json>.None
    JsonFloat(_) => return Option<[]Json>.None
    JsonString(_) => return Option<[]Json>.None
    JsonObject(_) => return Option<[]Json>.None
  }
}

// Looks up `key` in a JsonObject. None when `o` is not a JsonObject or `key`
// is absent. Duplicate keys are legal (JsonObject preserves source order and
// does not dedupe) — this returns the LAST matching entry, i.e. last-key-wins,
// the same policy most JSON decoders apply to a duplicate key.
// Tracks the winning INDEX and builds the `Option` once at the end (#2293)
// rather than constructing one per matching entry. `Option<Json>.Some` is a
// heap record, and the old loop built one for the `None` seed plus one for
// every match, all but the last immediately garbage — a per-lookup cost on
// the hottest read path in the module. Last-key-wins is unchanged: the scan
// still visits every entry and keeps the last index that matched.
export fn jsonGet(o: Json, key: string): Option<Json> {
  match (o) {
    JsonObject(entries) => {
      let foundAt = -1
      let i = 0
      while (i < len(entries)) {
        if (entries[i].key == key) {
          foundAt = i
        }
        i = i + 1
      }
      if (foundAt < 0) {
        return Option<Json>.None
      }
      return Option<Json>.Some(entries[foundAt].value)
    }
    JsonNull => return Option<Json>.None
    JsonBool(_) => return Option<Json>.None
    JsonInt(_) => return Option<Json>.None
    JsonFloat(_) => return Option<Json>.None
    JsonString(_) => return Option<Json>.None
    JsonArray(_) => return Option<Json>.None
  }
}
