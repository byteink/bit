// Bit standard library — json module, Json value sum type + JsonEntry.
//
// The one value primitive the json epic (#1479) is built on: no parser, no
// encoder, no I/O — just the type and pure accessors. `JsonObject` is
// `[]JsonEntry`, not `map<string, Json>`: insertion order and duplicate keys
// must be preservable up through the CST layer #1479's later tasks build.
//
// Accessors are free functions, mirroring stdlib/core/option.bit's style
// (methods on generic types don't parse yet, and every accessor here returns
// the generic `Option<T>`) rather than methods on `Json`.

// One key/value pair of a JSON object, in source order.
export class JsonEntry { key: string, value: Json }

// A JSON value (RFC 8259 §3).
export enum Json {
  JsonNull,
  JsonBool(bool),
  JsonInt(i64),
  JsonFloat(f64),
  JsonString(string),
  JsonArray([]Json),
  JsonObject([]JsonEntry),
}

export fn jsonIsNull(j: Json): bool {
  return match (j) {
    JsonNull => true
    JsonBool(_) => false
    JsonInt(_) => false
    JsonFloat(_) => false
    JsonString(_) => false
    JsonArray(_) => false
    JsonObject(_) => false
  }
}

export fn jsonIsBool(j: Json): bool {
  return match (j) {
    JsonNull => false
    JsonBool(_) => true
    JsonInt(_) => false
    JsonFloat(_) => false
    JsonString(_) => false
    JsonArray(_) => false
    JsonObject(_) => false
  }
}

export fn jsonIsInt(j: Json): bool {
  return match (j) {
    JsonNull => false
    JsonBool(_) => false
    JsonInt(_) => true
    JsonFloat(_) => false
    JsonString(_) => false
    JsonArray(_) => false
    JsonObject(_) => false
  }
}

export fn jsonIsFloat(j: Json): bool {
  return match (j) {
    JsonNull => false
    JsonBool(_) => false
    JsonInt(_) => false
    JsonFloat(_) => true
    JsonString(_) => false
    JsonArray(_) => false
    JsonObject(_) => false
  }
}

// True for either numeric variant — JSON has one number type, so this is
// jsonIsInt(j) || jsonIsFloat(j), not a third representation to keep in sync.
export fn jsonIsNumber(j: Json): bool {
  return jsonIsInt(j) || jsonIsFloat(j)
}

export fn jsonIsString(j: Json): bool {
  return match (j) {
    JsonNull => false
    JsonBool(_) => false
    JsonInt(_) => false
    JsonFloat(_) => false
    JsonString(_) => true
    JsonArray(_) => false
    JsonObject(_) => false
  }
}

export fn jsonIsArray(j: Json): bool {
  return match (j) {
    JsonNull => false
    JsonBool(_) => false
    JsonInt(_) => false
    JsonFloat(_) => false
    JsonString(_) => false
    JsonArray(_) => true
    JsonObject(_) => false
  }
}

export fn jsonIsObject(j: Json): bool {
  return match (j) {
    JsonNull => false
    JsonBool(_) => false
    JsonInt(_) => false
    JsonFloat(_) => false
    JsonString(_) => false
    JsonArray(_) => false
    JsonObject(_) => true
  }
}

// The bool payload, or None when `j` is not a JsonBool — a shape mismatch
// while decoding untrusted JSON is data, not a crash.
export fn jsonAsBool(j: Json): Option<bool> {
  match (j) {
    JsonBool(b) => return Option<bool>.Some(b)
    JsonNull => return Option<bool>.None
    JsonInt(_) => return Option<bool>.None
    JsonFloat(_) => return Option<bool>.None
    JsonString(_) => return Option<bool>.None
    JsonArray(_) => return Option<bool>.None
    JsonObject(_) => return Option<bool>.None
  }
}

// The int payload, or None when `j` is not a JsonInt.
export fn jsonAsInt(j: Json): Option<i64> {
  match (j) {
    JsonInt(i) => return Option<i64>.Some(i)
    JsonNull => return Option<i64>.None
    JsonBool(_) => return Option<i64>.None
    JsonFloat(_) => return Option<i64>.None
    JsonString(_) => return Option<i64>.None
    JsonArray(_) => return Option<i64>.None
    JsonObject(_) => return Option<i64>.None
  }
}

// The float payload, or None when `j` is not a JsonFloat.
export fn jsonAsFloat(j: Json): Option<f64> {
  match (j) {
    JsonFloat(f) => return Option<f64>.Some(f)
    JsonNull => return Option<f64>.None
    JsonBool(_) => return Option<f64>.None
    JsonInt(_) => return Option<f64>.None
    JsonString(_) => return Option<f64>.None
    JsonArray(_) => return Option<f64>.None
    JsonObject(_) => return Option<f64>.None
  }
}

// The numeric payload widened to f64, or None when `j` is neither a JsonInt
// nor a JsonFloat. JSON has one number type — `3` and `3.0` are the same
// document to every producer on the wire — so a decoder reading an f64 field
// with jsonAsFloat alone rejects the integral spelling. This is the single
// accessor for "a JSON number, however it was written", matching serde_json's
// Value::as_f64().
export fn jsonAsNumber(j: Json): Option<f64> {
  match (j) {
    JsonInt(i) => return Option<f64>.Some(f64(i))
    JsonFloat(f) => return Option<f64>.Some(f)
    JsonNull => return Option<f64>.None
    JsonBool(_) => return Option<f64>.None
    JsonString(_) => return Option<f64>.None
    JsonArray(_) => return Option<f64>.None
    JsonObject(_) => return Option<f64>.None
  }
}

// The string payload, or None when `j` is not a JsonString.
export fn jsonAsString(j: Json): Option<string> {
  match (j) {
    JsonString(s) => return Option<string>.Some(s)
    JsonNull => return Option<string>.None
    JsonBool(_) => return Option<string>.None
    JsonInt(_) => return Option<string>.None
    JsonFloat(_) => return Option<string>.None
    JsonArray(_) => return Option<string>.None
    JsonObject(_) => return Option<string>.None
  }
}

// The array payload, or None when `j` is not a JsonArray.
export fn jsonAsArray(j: Json): Option<[]Json> {
  match (j) {
    JsonArray(a) => return Option<[]Json>.Some(a)
    JsonNull => return Option<[]Json>.None
    JsonBool(_) => return Option<[]Json>.None
    JsonInt(_) => return Option<[]Json>.None
    JsonFloat(_) => return Option<[]Json>.None
    JsonString(_) => return Option<[]Json>.None
    JsonObject(_) => return Option<[]Json>.None
  }
}

// The entries of a JsonObject, in source order, or None when `j` is not a
// JsonObject. Returns the same `[]JsonEntry` the value already stores — no
// copy — so duplicate keys and insertion order are both preserved exactly as
// parsed. Use this to enumerate an object's keys (reject unknown fields,
// detect duplicates, walk/redact/merge); `jsonGet` only answers one known key
// at a time and cannot distinguish "absent" from "present but not asked for".
export fn jsonAsObject(j: Json): Option<[]JsonEntry> {
  match (j) {
    JsonObject(entries) => return Option<[]JsonEntry>.Some(entries)
    JsonNull => return Option<[]JsonEntry>.None
    JsonBool(_) => return Option<[]JsonEntry>.None
    JsonInt(_) => return Option<[]JsonEntry>.None
    JsonFloat(_) => return Option<[]JsonEntry>.None
    JsonString(_) => return Option<[]JsonEntry>.None
    JsonArray(_) => return Option<[]JsonEntry>.None
  }
}

// Looks up `key` in a JsonObject. None when `o` is not a JsonObject or `key`
// is absent. Duplicate keys are legal (JsonObject preserves source order and
// does not dedupe) — this returns the LAST matching entry, i.e. last-key-wins,
// the same policy most JSON decoders apply to a duplicate key.
// The last `entries` entry whose key equals `key`, or `None`. Split out of
// `jsonGet` (#2448).
//
// SCANS FROM THE END (#4358). Last-key-wins means the winner is by definition
// the LAST match, so walking backwards and returning at the first hit gives
// the identical answer while stopping there; the forward loop had to visit
// every entry before it could know which match was the last one. A caller that
// reads an object's N keys therefore pays ~N^2/2 key comparisons instead of
// N^2. The direction is load-bearing for the policy, not an optimization
// detail: a forward scan that returned at its first hit would be FIRST-wins.
// It also keeps #2293's property that at most one `Option<Json>.Some` is
// built per lookup — the hit returns immediately, so a repeated key no longer
// constructs a heap record per match either.
fn jsonGetFromObject(entries: []JsonEntry, key: string): Option<Json> {
  let i = len(entries) - 1
  while (i >= 0) {
    if (entries[i].key == key) {
      return Option<Json>.Some(entries[i].value)
    }
    i = i - 1
  }
  return Option<Json>.None
}

export fn jsonGet(o: Json, key: string): Option<Json> {
  match (o) {
    JsonObject(entries) => return jsonGetFromObject(entries, key)
    JsonNull => return Option<Json>.None
    JsonBool(_) => return Option<Json>.None
    JsonInt(_) => return Option<Json>.None
    JsonFloat(_) => return Option<Json>.None
    JsonString(_) => return Option<Json>.None
    JsonArray(_) => return Option<Json>.None
  }
}
