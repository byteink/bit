// Bit standard library — json module, CST printer (#1726).
//
// Serializes a #1720 CstNode (produced by cstParse, stdlib/json/cst_parse.bit,
// and mutated by the edit layer, stdlib/json/edit.bit) back to JSONC source
// text. The gate this exists for (#1479's own restated guarantee, per node):
// any node an edit function did not touch prints back the EXACT bytes
// cstParse originally consumed for it — rawText verbatim for numbers and
// strings, every comment in its original `//` vs `/* */` form with its
// original internal spacing, and the surrounding structural whitespace,
// indentation, and comma placement.
//
// This holds with no special-casing because cst_parse.bit already captured
// every one of those gaps as opaque, verbatim raw text (cst.bit's `Trivia`,
// `CstEntry.midGap`, and each container's `gaps`) instead of decoding or
// re-deriving any of it — printing an untouched subtree is just
// concatenation, never re-encoding. A `CstNumber`/`CstString`'s `rawText` is
// emitted as-is for exactly the same reason #1725's `cstSetString` documents:
// re-encoding from a decoded value is the lossy path #1479 rules out, so
// this file never decodes one.
//
// The one case with no original text to echo is an entry `cstSetString`
// appended after the parse: its own gap (cst.bit's `gaps[i]`) is
// `Option<string>.None`. `gapForIndex` synthesizes `",\n" + indent` for it,
// where `indent` is read off the immediately preceding sibling's own gap
// (the trailing run of spaces/tabs after its last newline) — so the one new
// line this printer adds matches whatever indentation style the rest of the
// hand-formatted document already uses, rather than a hardcoded width. A
// `None` with no usable preceding sibling (appending into what was an empty
// object) falls back to no indentation — there is no style to infer yet.

// The run of spaces/tabs after the last `\n` in `gap` (`""` if `gap` has no
// newline) — the indentation `gap` puts in front of whatever token follows
// it. Bounded by `len(gap)`: each iteration inspects one byte.
function gapIndent(gap: string): string {
  let lastNl = -1
  let i = 0
  let n = len(gap)
  while (i < n) {
    if (gap[i] == '\n') {
      lastNl = i
    }
    i = i + 1
  }
  if (lastNl < 0) {
    return ""
  }
  return gap[lastNl + 1:n]
}

// The raw text for the gap before child `i` of `n` siblings (`gaps` has
// `n + 1` entries; index `len(children)` is the tail gap before the close).
// A `None` (only possible for an entry `cstSetString` appended after the
// original parse) is synthesized from whatever indentation the immediately
// preceding sibling's own gap uses, per this file's header.
function gapForIndex(gaps: []Option<string>, i: int): string {
  match (gaps[i]) {
    Some(g) => return g
    None => {
      if (i == 0) {
        return ""
      }
      match (gaps[i - 1]) {
        Some(prev) => return ",\n" + gapIndent(prev)
        None => return ",\n"
      }
    }
  }
}

// Concatenates every entry of a CstObject with its own gap (and the trailing
// gap after the last one), in source order. Bounded by `len(entries)`.
function printEntries(entries: []CstEntry, gaps: []Option<string>): string {
  let out = ""
  let i = 0
  let n = len(entries)
  while (i < n) {
    out = out + gapForIndex(gaps, i) + entries[i].keyText + entries[i].midGap + cstPrint(entries[i].value)
    i = i + 1
  }
  out = out + gapForIndex(gaps, n)
  return out
}

// Concatenates every item of a CstArray with its own gap (and the trailing
// gap after the last one), in source order. Bounded by `len(items)`.
function printItems(items: []CstNode, gaps: []Option<string>): string {
  let out = ""
  let i = 0
  let n = len(items)
  while (i < n) {
    out = out + gapForIndex(gaps, i) + cstPrint(items[i])
    i = i + 1
  }
  out = out + gapForIndex(gaps, n)
  return out
}

// Serializes `n` back to JSONC source text. For any node no edit function
// touched, this reproduces cstParse's original input byte-for-byte (see this
// file's header for why); for a node cstSetString replaced, the fresh
// `rawText` prints in place of the old one, with everything else around it
// untouched.
export function cstPrint(n: CstNode): string {
  match (n) {
    CstNull(t) => return t.leading + "null" + t.trailing
    CstBool(b, t) => {
      if (b) {
        return t.leading + "true" + t.trailing
      }
      return t.leading + "false" + t.trailing
    }
    CstNumber(r, t) => return t.leading + r + t.trailing
    CstString(s, t) => return t.leading + s + t.trailing
    CstArray(items, gaps, t) => return t.leading + "[" + printItems(items, gaps) + "]" + t.trailing
    CstObject(entries, gaps, t) => return t.leading + "{" + printEntries(entries, gaps) + "}" + t.trailing
  }
}
