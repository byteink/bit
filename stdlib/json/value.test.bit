// stdlib/json/value.test.bit - `Json.toJson()`: a tree is its own JSON, so a
// `Json` satisfies a `toJson(): Json` requirement the way a `@json` class does.

interface asJson {
  toJson(): Json,
}

fn encodedBy(v: asJson): string {
  return jsonEncode(v.toJson())
}

fn encodedGeneric<T: asJson>(v: T): string {
  return jsonEncode(v.toJson())
}

test "Json.toJson returns the tree itself" {
  let tree = Json.JsonArray([Json.JsonInt(1), Json.JsonString("a"), Json.JsonNull])
  assert(jsonEncode(tree.toJson()) == "[1,\"a\",null]", "tree = ${jsonEncode(tree.toJson())}")
}

test "a Json satisfies a toJson requirement, as an interface and as a bound" {
  assert(encodedBy(Json.JsonBool(true)) == "true", "interface param")
  assert(encodedGeneric(Json.JsonInt(7)) == "7", "generic bound")
  assert(encodedGeneric(Json.JsonString("x")) == "\"x\"", "string")
}
