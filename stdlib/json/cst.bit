// Bit standard library — json module, trivia-carrying CST node types (#1720).
//
// A concrete syntax tree shaped like Json (stdlib/json/value.bit, #1717) but
// every node also carries the comments/blank lines around it, so a later
// edit-layer task (#1479) can mutate one value and re-serialize the rest of
// the document byte-identical modulo the edit. This file is TYPES ONLY: no
// parser, no printer, no mutation — those are separate later tasks.
//
// Bit enum variants take POSITIONAL payloads only, not named fields (no
// `enum_variant` syntax for it per spec/SPEC.md §14.7) — the task's proposed
// `rawText: string` field-style payload doesn't parse, so every multi-field
// variant below is positional and documents its argument order in the enum's
// doc comment.
//
// A comment on its own line right before an array/object's closing `]`/`}`
// has no node of its own to attach to; it is folded into that container's own
// `trivia.trailing` (same field, same meaning as a scalar node's trailing
// comment — it just describes the close instead of a value) rather than a
// separate `closeTrivia` field.

// The comment/blank-line tokens immediately around one CST node, verbatim
// source text (including `//` / `/* */` delimiters).
//   leading:  zero or more tokens before this node, in source order.
//   trailing: an optional same-line comment after the node's own text, before
//             the next comma/newline (or, for a container, before its close).
export struct Trivia { leading: []string, trailing: Option<string> }

// One key/value pair of a CstObject, in source order.
//   keyText: raw source text of the key, INCLUDING quotes, exactly as written.
//   key:     the decoded key string, for lookups.
export struct CstEntry { keyText: string, key: string, trivia: Trivia, value: CstNode }

// A JSON value together with the trivia around it (RFC 8259 §3 shape, mirrors
// Json in value.bit). Payload order per variant:
//   CstNull    (Trivia)
//   CstBool    (bool, Trivia)
//   CstNumber  (rawText: string, Trivia)  -- exact source span, e.g. "1.50000"
//   CstString  (rawText: string, Trivia)  -- exact source span, INCLUDING quotes
//   CstArray   ([]CstNode, Trivia)        -- Trivia.trailing covers a comment before `]`
//   CstObject  ([]CstEntry, Trivia)       -- Trivia.trailing covers a comment before `}`
export enum CstNode {
  CstNull(Trivia),
  CstBool(bool, Trivia),
  CstNumber(string, Trivia),
  CstString(string, Trivia),
  CstArray([]CstNode, Trivia),
  CstObject([]CstEntry, Trivia),
}
