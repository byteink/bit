// Bit standard library — json module, trivia-carrying CST node types (#1720).
//
// A concrete syntax tree shaped like Json (stdlib/json/value.bit, #1717) but
// every node also carries the formatting around it, so a later edit-layer
// task (#1479) can mutate one value and re-serialize the rest of the
// document byte-identical modulo the edit.
//
// Bit enum variants take POSITIONAL payloads only, not named fields (no
// `enum_variant` syntax for it per spec/SPEC.md §14.7) — the task's proposed
// `rawText: string` field-style payload doesn't parse, so every multi-field
// variant below is positional and documents its argument order in the enum's
// doc comment.
//
// #1726 (the CST printer) found that the original landed shape here —
// `Trivia.leading` as a `[]string` of comment bodies only — could not
// reproduce a document's structural whitespace (indentation, blank lines,
// comma placement): it recorded which comments existed but not the plain
// whitespace runs between/around them, so two inputs differing only in
// indentation parsed to identical trees. This revision closes that gap by
// making every gap between structural tokens (a comma, a colon, a brace) a
// single verbatim raw-text field instead of a decoded comment list — nothing
// downstream (`cstGet`/`cstSetString`/`cstDeleteKey`) ever inspected
// individual comments, only forwarded trivia opaquely, so collapsing the list
// into one string loses no real capability and closes the printer's gap.
//
// Where the gaps live:
//   - `Trivia{leading, trailing}` is only ever populated on the ROOT node
//     (a comment/blank-line run before the document's first token, or after
//     its last) — every non-root node carries `Trivia{"", ""}` because its
//     surrounding whitespace is owned by its parent container's `gaps`, or by
//     its `CstEntry.midGap`, instead.
//   - `CstObject`/`CstArray` own one raw gap per boundary around their
//     children: `gaps[i]` is the verbatim text before child `i` (comments,
//     indentation, and — for `i > 0` — the comma that ended child `i-1`);
//     `gaps[len(children)]` is the verbatim text after the last child, before
//     the closing `}`/`]` (including an optional trailing comma). A container
//     with `n` children always has exactly `n + 1` gaps.
//   - `gaps[i]` is `Option<string>.None` only where the edit layer
//     (stdlib/json/edit.bit) had no original formatting to echo: an entry
//     appended by `cstSetString` after the original parse, and every gap of
//     an object `cstSetStringPath` built from scratch for a missing
//     intermediate segment. The printer fills those in from the preceding
//     sibling's own gap instead of guessing a hardcoded style — except at a
//     container's first and last boundary, which take no comma (a comma in
//     the tail position is a trailing comma, #2351). Every gap `cstParse`
//     produces is `Some`.
//   - `CstEntry.midGap` is the verbatim text between a key's closing quote
//     and its value's first token — the `:` plus any surrounding whitespace
//     or comments.
export class Trivia { leading: string, trailing: string }

// One key/value pair of a CstObject, in source order.
//   keyText: raw source text of the key, INCLUDING quotes, exactly as written.
//   key:     the decoded key string, for lookups.
//   midGap:  verbatim text from the key's end to the value's first token
//            (the ':' plus any surrounding whitespace/comments).
export class CstEntry { keyText: string, key: string, midGap: string, value: CstNode }

// A JSON value together with the trivia around it (RFC 8259 §3 shape, mirrors
// Json in value.bit). Payload order per variant:
//   CstNull    (Trivia)
//   CstBool    (bool, Trivia)
//   CstNumber  (rawText: string, Trivia)  -- exact source span, e.g. "1.50000"
//   CstString  (rawText: string, Trivia)  -- exact source span, INCLUDING quotes
//   CstArray   ([]CstNode, gaps: []Option<string>, Trivia)   -- len(gaps) == len(items) + 1
//   CstObject  ([]CstEntry, gaps: []Option<string>, Trivia)  -- len(gaps) == len(entries) + 1
export enum CstNode {
  CstNull(Trivia),
  CstBool(bool, Trivia),
  CstNumber(string, Trivia),
  CstString(string, Trivia),
  CstArray([]CstNode, []Option<string>, Trivia),
  CstObject([]CstEntry, []Option<string>, Trivia),
}
