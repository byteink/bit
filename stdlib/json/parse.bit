// Bit standard library — json module, strict-JSON recursive-descent parser.
//
// Consumes the flat token stream `lex` (stdlib/json/lex.bit) produces and
// builds a `Json` tree (stdlib/json/value.bit). Strict RFC 8259 only: no
// comments, no trailing commas — JSONC is a separate, later task layered on
// top of this file. Every malformed shape (bad token sequence, invalid
// escape, number that doesn't match the grammar, depth-limit token) is a
// parse error via the fallible return, never a panic: this parser only ever
// consumes untrusted input.
//
// Duplicate object keys: this parser keeps every entry, in source order,
// rather than deduping while building `JsonObject`. `jsonGet` (value.bit)
// already resolves duplicate keys last-wins, and it is the only sanctioned
// way callers read a key (#1479), so keeping all entries and letting that one
// place own the policy is simpler than enforcing it twice.
//
// JSONC (#1479's accepted grammar — narrow, explicit, NOT JSON5):
//
//   - `//` line comments: from `//` to end of line, anywhere whitespace is
//     currently allowed.
//   - `/* */` block comments: non-nesting, anywhere whitespace is currently
//     allowed. An unterminated `/*` is a parse error.
//   - Trailing commas: a single trailing `,` is allowed before `}` or `]`
//     (`[1, 2,]` and `{"a": 1,}` are valid). More than one trailing comma, or
//     a leading comma, is still a parse error.
//   - Explicitly OUT OF SCOPE: unquoted object keys, single-quoted strings,
//     hex numbers, `NaN`/`Infinity`, or any other JSON5 leniency.
//
// `jsoncParse` is this same grammar with comments (lex.bit's `lexJsonc`) and
// one trailing comma (`Parser.allowTrailingComma`) switched on; `jsonParse`
// stays strict RFC 8259 so a caller that wants to reject comments still can.

// `newBuilder` is already imported into this module by encode.bit — importing
// it again here would collide (same module, same declaration). Deliberately
// NOT importing `strings.parseInt`: it rejects i64 MIN by design (its own
// doc comment — "the parser accumulates a positive magnitude and would
// overflow representing it"), which would route -9223372036854775808 to
// `JsonFloat` and silently rewrite it (#2285). `parseJsonInt` below does its
// own digit accumulation so this module can accept the full i64 range.
import { contains, Builder } from "std/strings"

// A cursor over `lex`'s token stream, plus the original source (decoding a
// string or number needs to slice raw bytes back out of it).
// `allowTrailingComma` is JSONC-only (false for strict `jsonParse`): it lets
// `parseObject`/`parseArray` accept one trailing `,` before the closer.
struct Parser { src: string, toks: []Token, i: int, allowTrailingComma: bool }

// The token under the cursor. `lex` always terminates with `Eof`, so this is
// never out of bounds once `i` stops advancing past the last token.
fn peek(p: Parser): Token {
  return p.toks[p.i]
}

// Returns the token under the cursor and moves past it, except at `Eof`
// (the stream's fixed final token, which nothing should walk past).
fn advance(p: Parser): Token {
  let t = p.toks[p.i]
  if (p.i < len(p.toks) - 1) {
    p.i = p.i + 1
  }
  return t
}

// One value out of `p`'s token stream, optionally surrounded by whitespace
// (already stripped by the lexer) and nothing else. Shared by `jsonParse` and
// `jsoncParse` — they differ only in how `p` was built (which lexer, and
// whether a trailing comma is allowed), not in this top-level shape check.
fn parseTopLevel(p: Parser): Json! {
  let v = parseValue(p)?
  if (peek(p).kind != TokenKind.Eof) {
    fail newError("json: trailing garbage after value")
  }
  return v
}

// Parses `source` as strict JSON (RFC 8259): one value, optionally
// surrounded by whitespace, and nothing else. No comments, no trailing
// commas — see `jsoncParse` for the JSONC extension.
export fn jsonParse(source: string): Json! {
  let p = Parser{ src: source, toks: lex(source), i: 0, allowTrailingComma: false }
  return parseTopLevel(p)?
}

// Parses `source` as JSONC (this file's header comment documents the exact
// grammar): strict JSON plus `//`/`/* */` comments and a single trailing
// comma before `}`/`]`. Everything else — number/string decoding, depth
// limit, error-vs-panic behavior — is identical to `jsonParse`.
export fn jsoncParse(source: string): Json! {
  let p = Parser{ src: source, toks: lexJsonc(source), i: 0, allowTrailingComma: true }
  return parseTopLevel(p)?
}

// An `Invalid` token can come from four places in the lexer (scanOpen on a
// depth-cap hit, scanString on an unterminated string, an unterminated `/*`
// (JSONC only), everything else), and the token itself carries no reason —
// only a span. The source byte at that span disambiguates deterministically:
// `scanOpen` is the only path that marks a `{`/`[` byte `Invalid` (a plain
// unexpected `{`/`[` always lexes as `LBrace`/`LBracket`), `scanString` is
// the only path that marks a `"` byte `Invalid`, and an unterminated `/*`
// is the only `Invalid` starting on `/` whose span is more than one byte (a
// lone stray `/` is always a single-byte `Invalid`).
fn describeInvalid(src: string, t: Token): string {
  let c = src[t.start]
  if (c == '{' || c == '[') {
    return "json: max nesting depth exceeded"
  }
  if (c == '"') {
    return "json: unterminated string"
  }
  if (c == '/' && t.end - t.start > 1) {
    return "json: unterminated block comment"
  }
  return "json: unexpected character in input"
}

fn parseValue(p: Parser): Json! {
  let t = peek(p)
  if (t.kind == TokenKind.LBrace) {
    return parseObject(p)?
  }
  if (t.kind == TokenKind.LBracket) {
    return parseArray(p)?
  }
  if (t.kind == TokenKind.StringTok) {
    advance(p)
    return Json.JsonString(decodeStringLiteral(p.src, t)?)
  }
  if (t.kind == TokenKind.NumberTok) {
    advance(p)
    return decodeNumber(p.src, t)?
  }
  if (t.kind == TokenKind.TrueTok) {
    advance(p)
    return Json.JsonBool(true)
  }
  if (t.kind == TokenKind.FalseTok) {
    advance(p)
    return Json.JsonBool(false)
  }
  if (t.kind == TokenKind.NullTok) {
    advance(p)
    return Json.JsonNull
  }
  if (t.kind == TokenKind.Invalid) {
    fail newError(describeInvalid(p.src, t))
  }
  fail newError("json: unexpected token, expected a value")
}

// `{` was already peeked by the caller. Every entry is kept, including a
// repeated key — see this file's header comment for why.
fn parseObject(p: Parser): Json! {
  advance(p)
  let entries = []JsonEntry(0)
  if (peek(p).kind == TokenKind.RBrace) {
    advance(p)
    return Json.JsonObject(entries)
  }
  // Bounded by the token count: each iteration consumes at least a key, a
  // colon, a value, and a comma, so the loop cannot outrun a finite stream.
  let guard = 0
  let bound = len(p.toks) + 1
  while (guard <= bound) {
    let keyTok = peek(p)
    if (keyTok.kind != TokenKind.StringTok) {
      fail newError("json: expected string key")
    }
    advance(p)
    let key = decodeStringLiteral(p.src, keyTok)?
    if (peek(p).kind != TokenKind.Colon) {
      fail newError("json: expected ':' after object key")
    }
    advance(p)
    let val = parseValue(p)?
    entries = append(entries, JsonEntry{ key: key, value: val })
    let nxt = peek(p)
    if (nxt.kind == TokenKind.RBrace) {
      advance(p)
      return Json.JsonObject(entries)
    }
    if (nxt.kind != TokenKind.Comma) {
      fail newError("json: expected ',' or '}' in object")
    }
    advance(p)
    // JSONC: a single trailing comma closes the object right here. A second
    // one does not — `peek(p)` would be `Comma` again, so the loop falls
    // through to "expected string key" on the next iteration.
    if (p.allowTrailingComma && peek(p).kind == TokenKind.RBrace) {
      advance(p)
      return Json.JsonObject(entries)
    }
    guard = guard + 1
  }
  fail newError("json: object nesting exceeds token bound")
}

// `[` was already peeked by the caller.
fn parseArray(p: Parser): Json! {
  advance(p)
  let items = []Json(0)
  if (peek(p).kind == TokenKind.RBracket) {
    advance(p)
    return Json.JsonArray(items)
  }
  let guard = 0
  let bound = len(p.toks) + 1
  while (guard <= bound) {
    let v = parseValue(p)?
    items = append(items, v)
    let nxt = peek(p)
    if (nxt.kind == TokenKind.RBracket) {
      advance(p)
      return Json.JsonArray(items)
    }
    if (nxt.kind != TokenKind.Comma) {
      fail newError("json: expected ',' or ']' in array")
    }
    advance(p)
    // JSONC: a single trailing comma closes the array right here. A second
    // one does not — `peek(p)` would be `Comma` again, so `parseValue` on the
    // next iteration rejects it ("unexpected token, expected a value").
    if (p.allowTrailingComma && peek(p).kind == TokenKind.RBracket) {
      advance(p)
      return Json.JsonArray(items)
    }
    guard = guard + 1
  }
  fail newError("json: array nesting exceeds token bound")
}

// --- numbers -----------------------------------------------------------

// True when `s` matches RFC 8259 §6's number grammar exactly: optional `-`,
// an integer part with no non-`0` leading zero, an optional `.` fraction
// with at least one digit, an optional `e`/`E` exponent with at least one
// digit. `lex`'s own comment says it "does not reject a malformed literal —
// that check belongs to the parser task consuming this stream"; this is that
// check.
fn isValidJsonNumber(s: string): bool {
  let n = len(s)
  let i = 0
  if (i >= n) {
    return false
  }
  if (s[i] == '-') {
    i = i + 1
  }
  if (i >= n) {
    return false
  }
  if (s[i] == '0') {
    i = i + 1
  } else if (s[i] >= '1' && s[i] <= '9') {
    i = i + 1
    while (i < n && isDigit(s[i])) {
      i = i + 1
    }
  } else {
    return false
  }
  if (i < n && s[i] == '.') {
    i = i + 1
    if (i >= n || !isDigit(s[i])) {
      return false
    }
    while (i < n && isDigit(s[i])) {
      i = i + 1
    }
  }
  if (i < n && (s[i] == 'e' || s[i] == 'E')) {
    i = i + 1
    if (i < n && (s[i] == '+' || s[i] == '-')) {
      i = i + 1
    }
    if (i >= n || !isDigit(s[i])) {
      return false
    }
    while (i < n && isDigit(s[i])) {
      i = i + 1
    }
  }
  return i == n
}

// A literal with no `.`/`e`/`E` that fits `i64` decodes to `JsonInt`; anything
// wider, or with a fraction/exponent, decodes to `JsonFloat` via the
// runtime's own `parseFloat` primitive so it can never drift a ULP from the
// canonical parse (#1479's number-handling decision).
fn decodeNumber(src: string, t: Token): Json! {
  let text = src[t.start:t.end]
  if (!isValidJsonNumber(text)) {
    fail newError("json: invalid number literal")
  }
  if (contains(text, ".") || contains(text, "e") || contains(text, "E")) {
    return Json.JsonFloat(parseFloat(text))
  }
  let iv = parseJsonInt(text) catch e {
    return Json.JsonFloat(parseFloat(text))
  }
  return Json.JsonInt(iv)
}

// The i64 that the integral literal `text` (already validated by
// `isValidJsonNumber` — optional `-`, then only digits) denotes, over the
// FULL i64 range including MIN (-9223372036854775808). `text`'s magnitude
// alone has no positive i64 representation, so a positive accumulator (as
// `strings.parseInt` uses) always overflows one past `i64` MAX before the
// sign is applied; this accumulates negatively instead, which has exactly
// the headroom the positive side lacks. Fails (falling back to `JsonFloat`
// in `decodeNumber`) only when the magnitude exceeds even that.
fn parseJsonInt(text: string): i64! {
  let n = len(text)
  let i = 0
  let neg = false
  if (text[0] == '-') {
    neg = true
    i = 1
  }
  // i64 MIN = -9223372036854775808 = -922337203685477580 * 10 - 8.
  let minDiv10 = i64(-922337203685477580)
  let minMod10 = i64(8)
  let v = i64(0)
  while (i < n) {
    let d = i64(text[i] - '0')
    if (v < minDiv10 || v == minDiv10 && d > minMod10) {
      fail newError("json: number out of i64 range")
    }
    v = v * 10 - d
    i = i + 1
  }
  if (neg) {
    return v
  }
  // Positive side: v accumulated as if negative, so negate back, but reject
  // i64 MIN itself (v == i64 MIN has no positive negation).
  if (v == minDiv10 * 10 - minMod10) {
    fail newError("json: number out of i64 range")
  }
  return 0 - v
}

// --- strings -------------------------------------------------------------

fn hexDigitVal(c: u8): i64! {
  if (c >= '0' && c <= '9') {
    return i64(c - '0')
  }
  if (c >= 'a' && c <= 'f') {
    return i64(c - 'a') + 10
  }
  if (c >= 'A' && c <= 'F') {
    return i64(c - 'A') + 10
  }
  fail newError("json: invalid \\u escape")
}

// The 4-hex-digit codepoint starting at `src[i]`.
fn decodeHex4(src: string, i: int): i64! {
  let v = i64(0)
  let k = 0
  while (k < 4) {
    let d = hexDigitVal(src[i + k])?
    v = v * 16 + d
    k = k + 1
  }
  return v
}

// Encodes Unicode scalar value `cp` as UTF-8 into `b`. Hand-rolled because a
// `\uXXXX` escape (and a surrogate pair, for an astral codepoint) is the only
// place this parser needs to build UTF-8 from a codepoint, and `string(rune)`
// is not implemented yet (SPEC §12.9, deferred to rune iteration landing).
fn writeUtf8(b: Builder, cp: i64): Builder {
  if (cp < 0x80) {
    return b.writeByte(u8(cp))
  }
  if (cp < 0x800) {
    return b.writeByte(u8(0xC0 | (cp >> 6))).writeByte(u8(0x80 | (cp & 0x3F)))
  }
  if (cp < 0x10000) {
    return b.writeByte(u8(0xE0 | (cp >> 12))).writeByte(u8(0x80 | ((cp >> 6) & 0x3F))).writeByte(u8(0x80 | (cp & 0x3F)))
  }
  return b.writeByte(u8(0xF0 | (cp >> 18))).writeByte(u8(0x80 | ((cp >> 12) & 0x3F))).writeByte(u8(0x80 | ((cp >> 6) & 0x3F))).writeByte(u8(0x80 | (cp & 0x3F)))
}

// Decodes a `StringTok`'s raw span (quotes included, escapes raw — see
// lex.bit) into its string value: every RFC 8259 §7 escape, including a
// `\uXXXX` surrogate pair for an astral codepoint. An invalid escape is a
// parse error, never a panic. `lex` only ever emits `StringTok` for a span
// that found its closing quote, so `[start+1, end-1)` is always the content
// between the quotes.
//
// Fast path (#2293): most JSON strings — object keys, plain text values —
// carry no `\` escape at all. A single pre-scan for the first `\` (a raw
// control byte is invalid either way and fails immediately) lets an
// escape-free span return as a direct sub-slice of `src`, with no Builder
// call at all. Skipping this made the escape-decoding loop below run once
// per byte even for a string with zero escapes: `Builder.writeByte` copies
// the whole accumulated buffer on every call (#2112), so decoding an L-byte
// escape-free string cost O(L^2). A string that does contain an escape still
// goes through the byte-by-byte loop from that point on, batched from one
// Builder call per escape-free run instead of one per byte.
fn decodeStringLiteral(src: string, t: Token): string! {
  let start = t.start + 1
  let end = t.end - 1
  let firstEscape = -1
  let j = start
  while (j < end) {
    let cj = src[j]
    if (cj < 32) {
      fail newError("json: control character in string")
    }
    if (cj == '\\') {
      firstEscape = j
      j = end
    } else {
      j = j + 1
    }
  }
  if (firstEscape < 0) {
    return src[start:end]
  }
  let i = firstEscape
  let b = newBuilder().write(src[start:firstEscape])
  while (i < end) {
    let c = src[i]
    if (c < 32) {
      fail newError("json: control character in string")
    }
    if (c != '\\') {
      b = b.writeByte(c)
      i = i + 1
      continue
    }
    if (i + 1 >= end) {
      fail newError("json: unterminated escape")
    }
    let e = src[i + 1]
    if (e == '"') {
      b = b.writeByte('"')
      i = i + 2
    } else if (e == '\\') {
      b = b.writeByte('\\')
      i = i + 2
    } else if (e == '/') {
      b = b.writeByte('/')
      i = i + 2
    } else if (e == 'b') {
      b = b.writeByte(8)
      i = i + 2
    } else if (e == 'f') {
      b = b.writeByte(12)
      i = i + 2
    } else if (e == 'n') {
      b = b.writeByte('\n')
      i = i + 2
    } else if (e == 'r') {
      b = b.writeByte('\r')
      i = i + 2
    } else if (e == 't') {
      b = b.writeByte('\t')
      i = i + 2
    } else if (e == 'u') {
      if (i + 6 > end) {
        fail newError("json: invalid \\u escape")
      }
      let cp = decodeHex4(src, i + 2)?
      i = i + 6
      if (cp >= 0xD800 && cp <= 0xDBFF) {
        if (i + 6 > end || src[i] != '\\' || src[i + 1] != 'u') {
          fail newError("json: unpaired surrogate in \\u escape")
        }
        let lo = decodeHex4(src, i + 2)?
        if (lo < 0xDC00 || lo > 0xDFFF) {
          fail newError("json: invalid low surrogate in \\u escape")
        }
        i = i + 6
        let combined = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
        b = writeUtf8(b, combined)
      } else if (cp >= 0xDC00 && cp <= 0xDFFF) {
        fail newError("json: unpaired surrogate in \\u escape")
      } else {
        b = writeUtf8(b, cp)
      }
    } else {
      fail newError("json: invalid escape character")
    }
  }
  return b.toString()
}
