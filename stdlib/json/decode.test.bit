// The unknown-key rule, tested where it lives.
//
// `jsonDecUnknown` is what a strict decode fails through, and #4567 left it
// alone on purpose: the lenient entry point skips the CALL, inside the
// synthesized decoder, rather than teaching this function a second behaviour.
// These pin what it reports so that "the strict decode is unchanged" is a
// checked claim rather than a sentence in a commit message.
//
// A `@json` class cannot be declared here — `@json` requires an import from
// `"std/json"` (#6232) so the compiler can resolve `Json`/`JsonEntry` for the
// synthesized member, and this module cannot import itself (E0044) — so the
// specialised decoders are pinned from outside, in
// _tests_/cases/run_json_decode_lenient.bit and pkg/web's own tests.

fn entriesOf(src: string): []JsonEntry {
  let j = jsonParse(src) catch _ {
    return []JsonEntry(0)
  }
  let o = jsonAsObject(j)
  if (!isSome(o)) {
    return []JsonEntry(0)
  }
  return unwrap(o)
}

test "every key known is no failure" {
  let e = entriesOf("{\"a\":1,\"b\":2}")
  assert(len(e) == 2, "two entries, got ${len(e)}")
  jsonDecUnknown(e, "", ["a", "b"]) catch err {
    assert(false, "must accept a known key set: ${err.message()}")
  }
}

test "an unknown key fails, naming it under the path it was found at" {
  let e = entriesOf("{\"a\":1,\"nope\":2}")
  let failed = false
  jsonDecUnknown(e, "addr", ["a"]) catch err {
    failed = true
    let (de, ok) = err.(JsonDecodeError)
    assert(ok, "a JsonDecodeError, got '${err.message()}'")
    assert(de.path == "addr.nope", "the full dotted path, got '${de.path}'")
    match (de.cause) {
      UnknownKey => assert(true, "")
      MissingKey => assert(false, "cause must be UnknownKey")
      TypeMismatch => assert(false, "cause must be UnknownKey")
      MaxDepth => assert(false, "cause must be UnknownKey")
    }
  }
  assert(failed, "an unknown key must fail")
}

test "the FIRST unknown key in document order is the one reported" {
  let e = entriesOf("{\"x\":1,\"y\":2}")
  let path = ""
  jsonDecUnknown(e, "", ["a"]) catch err {
    let (de, ok) = err.(JsonDecodeError)
    if (ok) {
      path = de.path
    }
  }
  assert(path == "x", "the first key, got '${path}'")
}

test "jsonDecJson returns the member as it stands, last one wins, JsonNull when absent" {
  let e = entriesOf("{\"a\":{\"k\":[1]},\"b\":null,\"a2\":1,\"d\":1,\"d\":\"last\"}")
  assert(jsonEncode(jsonDecJson(e, "a")) == "{\"k\":[1]}", "an object, untouched")
  assert(jsonIsNull(jsonDecJson(e, "b")), "an explicit null")
  assert(jsonIsNull(jsonDecJson(e, "nope")), "an absent key is JsonNull, not a failure")
  assert(jsonEncode(jsonDecJson(e, "d")) == "\"last\"", "the last of a repeated key")
  assert(jsonIsNull(jsonDecJson([]JsonEntry(0), "x")), "an empty object")
}

test "jsonTextValue reads one value off the reader and leaves the cursor after it" {
  let r = jsonTextReader("[{\"a\":[true,null,2.5]},\"s\",7]")
  jsonTextArray(r, "", 0) catch _ {
    assert(false, "array")
    return
  }
  let first = jsonTextItem(r, 0) catch _ {
    assert(false, "item 0")
    return
  }
  assert(first, "an element follows")
  let v = jsonTextValue(r) catch _ {
    assert(false, "value")
    return
  }
  assert(jsonEncode(v) == "{\"a\":[true,null,2.5]}", "the whole nested value")
  let more = jsonTextItem(r, 1) catch _ {
    assert(false, "item 1")
    return
  }
  assert(more, "the cursor sits on the next element")
  let s = jsonTextStringIndex(r, "", 1) catch _ {
    assert(false, "string")
    return
  }
  assert(s == "s", "the next element reads normally, got '${s}'")
}

// The message `jsonTextValue` fails with on the value after `{"a":`, or "ok".
fn malformedValueMessage(): string {
  let r = jsonTextReader("{\"a\":}")
  jsonTextObject(r, "", 0) catch e {
    return e.message()
  }
  let _ = jsonTextKey(r, 0) catch e {
    return e.message()
  }
  let _ = jsonTextValue(r) catch e {
    return e.message()
  }
  return "ok"
}

test "jsonTextValue fails with a positioned error on a malformed value" {
  let got = malformedValueMessage()
  assert(
    got == "json: unexpected token, expected a value at byte 5 (line 1, column 6)",
    "got '${got}'",
  )
}
