// stdlib/json/encode.test.bit — appendEscaped's escape table (#5938).
//
// One input string carries every escape class RFC 8259 §7 needs: `"`, `\`,
// `\n`, `\t`, `\r`, backspace (0x08), form feed (0x0C), a control byte with
// no named escape (0x01), plain ASCII, and a multi-byte UTF-8 sequence
// (passed through unescaped). Each test pins the exact output text by hand
// (never round-tripped through `jsonEscapeString` itself), for a string
// value and for an object key, compact and pretty.

// `"`, `\`, newline, tab, CR, backspace, form feed, control byte 0x01, `A`,
// then U+00E9 (`é`, 2-byte UTF-8) — the raw bytes to escape.
fn rawInput(): string {
  return "\"\\\n\t\r\x08\x0c\x01A\u{e9}"
}

// `rawInput()`'s escaped form, quoted: the exact JSON string literal text.
fn escaped(): string {
  return "\"" +
    "\\\"" +
    "\\\\" +
    "\\n" +
    "\\t" +
    "\\r" +
    "\\b" +
    "\\f" +
    "\\u0001" +
    "A" +
    "\u{e9}" +
    "\""
}

test "jsonEncode escapes every class in a string value" {
  let got = jsonEncode(Json.JsonString(rawInput()))
  assert(got == escaped(), "got '${got}'")
}

test "jsonEncode escapes every class in an object key" {
  let j = Json.JsonObject(
    []JsonEntry{ JsonEntry{ key = rawInput(), value = Json.JsonInt(1) } },
  )
  let got = jsonEncode(j)
  assert(got == "{" + escaped() + ":1}", "got '${got}'")
}

test "jsonEncodePretty escapes every class in a string value" {
  let got = jsonEncodePretty(Json.JsonString(rawInput()), "  ")
  assert(got == escaped(), "got '${got}'")
}

test "jsonEncodePretty escapes every class in an object key" {
  let j = Json.JsonObject(
    []JsonEntry{ JsonEntry{ key = rawInput(), value = Json.JsonInt(1) } },
  )
  let got = jsonEncodePretty(j, "  ")
  assert(got == "{\n  " + escaped() + ": 1\n}", "got '${got}'")
}

// --- accumulator initial capacity (#5942) ----------------------------------
//
// Three sizes relative to `encodeInitialCap` (64): under it (27 bytes, the
// `#5940` hl-master benchmark's own request body), just over it (69 bytes,
// one regrowth), and well over it (205 bytes, several regrowths). Each
// expected string is hand-written, not produced by calling `jsonEncode`
// itself.

test "jsonEncode a 27-byte object, under the initial capacity" {
  let j = Json.JsonObject(
    []JsonEntry{ JsonEntry{ key = "message", value = Json.JsonString("Hello, World!") } },
  )
  let got = jsonEncode(j)
  assert(got == "{\"message\":\"Hello, World!\"}", "got '${got}'")
}

test "jsonEncode a 69-byte object, over the initial capacity" {
  let j = Json.JsonObject(
    []JsonEntry{
      JsonEntry{ key = "a", value = Json.JsonString("aaaaaaaaaa") },
      JsonEntry{ key = "b", value = Json.JsonString("bbbbbbbbbb") },
      JsonEntry{ key = "c", value = Json.JsonString("cccccccccc") },
      JsonEntry{ key = "d", value = Json.JsonString("dddddddddd") },
    },
  )
  let got = jsonEncode(j)
  assert(
      got ==
      "{\"a\":\"aaaaaaaaaa\",\"b\":\"bbbbbbbbbb\",\"c\":\"cccccccccc\"," + "\"d\":\"dddddddddd\"}",
    "got '${got}'",
  )
}

test "jsonEncode a 205-byte object, several regrowths past the initial capacity" {
  let j = Json.JsonObject(
    []JsonEntry{
      JsonEntry{ key = "a", value = Json.JsonString("aaaaaaaaaa") },
      JsonEntry{ key = "b", value = Json.JsonString("bbbbbbbbbb") },
      JsonEntry{ key = "c", value = Json.JsonString("cccccccccc") },
      JsonEntry{ key = "d", value = Json.JsonString("dddddddddd") },
      JsonEntry{ key = "e", value = Json.JsonString("eeeeeeeeee") },
      JsonEntry{ key = "f", value = Json.JsonString("ffffffffff") },
      JsonEntry{ key = "g", value = Json.JsonString("gggggggggg") },
      JsonEntry{ key = "h", value = Json.JsonString("hhhhhhhhhh") },
      JsonEntry{ key = "i", value = Json.JsonString("iiiiiiiiii") },
      JsonEntry{ key = "j", value = Json.JsonString("jjjjjjjjjj") },
      JsonEntry{ key = "k", value = Json.JsonString("kkkkkkkkkk") },
      JsonEntry{ key = "l", value = Json.JsonString("llllllllll") },
    },
  )
  let got = jsonEncode(j)
  assert(
      got ==
        "{\"a\":\"aaaaaaaaaa\",\"b\":\"bbbbbbbbbb\",\"c\":\"cccccccccc\"," +
        "\"d\":\"dddddddddd\",\"e\":\"eeeeeeeeee\",\"f\":\"ffffffffff\"," +
        "\"g\":\"gggggggggg\",\"h\":\"hhhhhhhhhh\",\"i\":\"iiiiiiiiii\"," +
        "\"j\":\"jjjjjjjjjj\",\"k\":\"kkkkkkkkkk\",\"l\":\"llllllllll\"}",
    "got '${got}'",
  )
}
