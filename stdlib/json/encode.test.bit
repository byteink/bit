// stdlib/json/encode.test.bit — appendEscaped's escape table (#5938).
//
// One input string carries every escape class RFC 8259 §7 needs: `"`, `\`,
// `\n`, `\t`, `\r`, backspace (0x08), form feed (0x0C), a control byte with
// no named escape (0x01), plain ASCII, and a multi-byte UTF-8 sequence
// (passed through unescaped). Each test pins the exact output text by hand
// (never round-tripped through `jsonEscapeString` itself), for a string
// value and for an object key, compact and pretty.

// `"`, `\`, newline, tab, CR, backspace, form feed, control byte 0x01, `A`,
// then U+00E9 (`é`, 2-byte UTF-8) — the raw bytes to escape.
fn rawInput(): string {
  return "\"\\\n\t\r\x08\x0c\x01A\u{e9}"
}

// `rawInput()`'s escaped form, quoted: the exact JSON string literal text.
fn escaped(): string {
  return "\"" +
    "\\\"" +
    "\\\\" +
    "\\n" +
    "\\t" +
    "\\r" +
    "\\b" +
    "\\f" +
    "\\u0001" +
    "A" +
    "\u{e9}" +
    "\""
}

test "jsonEncode escapes every class in a string value" {
  let got = jsonEncode(Json.JsonString(rawInput()))
  assert(got == escaped(), "got '${got}'")
}

test "jsonEncode escapes every class in an object key" {
  let j = Json.JsonObject(
    []JsonEntry{ JsonEntry{ key = rawInput(), value = Json.JsonInt(1) } },
  )
  let got = jsonEncode(j)
  assert(got == "{" + escaped() + ":1}", "got '${got}'")
}

test "jsonEncodePretty escapes every class in a string value" {
  let got = jsonEncodePretty(Json.JsonString(rawInput()), "  ")
  assert(got == escaped(), "got '${got}'")
}

test "jsonEncodePretty escapes every class in an object key" {
  let j = Json.JsonObject(
    []JsonEntry{ JsonEntry{ key = rawInput(), value = Json.JsonInt(1) } },
  )
  let got = jsonEncodePretty(j, "  ")
  assert(got == "{\n  " + escaped() + ": 1\n}", "got '${got}'")
}

// --- accumulator initial capacity (#5942) ----------------------------------
//
// Three sizes relative to `encodeInitialCap` (64): under it (27 bytes, the
// `#5940` x86_64 benchmark's own request body), just over it (69 bytes,
// one regrowth), and well over it (205 bytes, several regrowths). Each
// expected string is hand-written, not produced by calling `jsonEncode`
// itself.

test "jsonEncode a 27-byte object, under the initial capacity" {
  let j = Json.JsonObject(
    []JsonEntry{ JsonEntry{ key = "message", value = Json.JsonString("Hello, World!") } },
  )
  let got = jsonEncode(j)
  assert(got == "{\"message\":\"Hello, World!\"}", "got '${got}'")
}

test "jsonEncode a 69-byte object, over the initial capacity" {
  let j = Json.JsonObject(
    []JsonEntry{
      JsonEntry{ key = "a", value = Json.JsonString("aaaaaaaaaa") },
      JsonEntry{ key = "b", value = Json.JsonString("bbbbbbbbbb") },
      JsonEntry{ key = "c", value = Json.JsonString("cccccccccc") },
      JsonEntry{ key = "d", value = Json.JsonString("dddddddddd") },
    },
  )
  let got = jsonEncode(j)
  assert(
      got ==
      "{\"a\":\"aaaaaaaaaa\",\"b\":\"bbbbbbbbbb\",\"c\":\"cccccccccc\"," + "\"d\":\"dddddddddd\"}",
    "got '${got}'",
  )
}

test "jsonEncode a 205-byte object, several regrowths past the initial capacity" {
  let j = Json.JsonObject(
    []JsonEntry{
      JsonEntry{ key = "a", value = Json.JsonString("aaaaaaaaaa") },
      JsonEntry{ key = "b", value = Json.JsonString("bbbbbbbbbb") },
      JsonEntry{ key = "c", value = Json.JsonString("cccccccccc") },
      JsonEntry{ key = "d", value = Json.JsonString("dddddddddd") },
      JsonEntry{ key = "e", value = Json.JsonString("eeeeeeeeee") },
      JsonEntry{ key = "f", value = Json.JsonString("ffffffffff") },
      JsonEntry{ key = "g", value = Json.JsonString("gggggggggg") },
      JsonEntry{ key = "h", value = Json.JsonString("hhhhhhhhhh") },
      JsonEntry{ key = "i", value = Json.JsonString("iiiiiiiiii") },
      JsonEntry{ key = "j", value = Json.JsonString("jjjjjjjjjj") },
      JsonEntry{ key = "k", value = Json.JsonString("kkkkkkkkkk") },
      JsonEntry{ key = "l", value = Json.JsonString("llllllllll") },
    },
  )
  let got = jsonEncode(j)
  assert(
      got ==
        "{\"a\":\"aaaaaaaaaa\",\"b\":\"bbbbbbbbbb\",\"c\":\"cccccccccc\"," +
        "\"d\":\"dddddddddd\",\"e\":\"eeeeeeeeee\",\"f\":\"ffffffffff\"," +
        "\"g\":\"gggggggggg\",\"h\":\"hhhhhhhhhh\",\"i\":\"iiiiiiiiii\"," +
        "\"j\":\"jjjjjjjjjj\",\"k\":\"kkkkkkkkkk\",\"l\":\"llllllllll\"}",
    "got '${got}'",
  )
}

// --- appendEscaped run-copying (#5943) -------------------------------------
//
// Each case pins jsonEncode(JsonString(...))'s exact output by hand, never
// round-tripped through the encoder itself.

test "jsonEncode a string with no escapes" {
  let got = jsonEncode(Json.JsonString("hello world"))
  assert(got == "\"hello world\"", "got '${got}'")
}

test "jsonEncode the empty string" {
  let got = jsonEncode(Json.JsonString(""))
  assert(got == "\"\"", "got '${got}'")
}

test "jsonEncode a string with an escape at the start" {
  let got = jsonEncode(Json.JsonString("\nabc"))
  assert(got == "\"\\nabc\"", "got '${got}'")
}

test "jsonEncode a string with an escape in the middle" {
  let got = jsonEncode(Json.JsonString("ab\ncd"))
  assert(got == "\"ab\\ncd\"", "got '${got}'")
}

test "jsonEncode a string with an escape at the end" {
  let got = jsonEncode(Json.JsonString("abc\n"))
  assert(got == "\"abc\\n\"", "got '${got}'")
}

test "jsonEncode a string with two adjacent escapes" {
  let got = jsonEncode(Json.JsonString("ab\n\tcd"))
  assert(got == "\"ab\\n\\tcd\"", "got '${got}'")
}

test "jsonEncode every control byte 0x00 through 0x1f" {
  let got = jsonEncode(
    Json.JsonString(
        "\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f" +
        "\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f",
    ),
  )
  assert(
      got ==
        "\"\\u0000\\u0001\\u0002\\u0003\\u0004\\u0005\\u0006\\u0007\\b\\t\\n" +
        "\\u000b\\f\\r\\u000e\\u000f\\u0010\\u0011\\u0012\\u0013\\u0014" +
        "\\u0015\\u0016\\u0017\\u0018\\u0019\\u001a\\u001b\\u001c\\u001d" +
        "\\u001e\\u001f\"",
    "got '${got}'",
  )
}

test "jsonEncode a multi-byte UTF-8 string with an escape between two runes" {
  let got = jsonEncode(Json.JsonString("\u{e9}\n\u{e9}"))
  assert(got == "\"\u{e9}\\n\u{e9}\"", "got '${got}'")
}

// #5988: `start == 0` (no byte needed escaping) appends `s` itself instead of
// an `s[0:len(s)]` view; `start > 0` still slices. Both byte-identical to the
// pre-#5988 output.
test "jsonEncode a string with no escapes and one ending in an escape" {
  let noEscape = jsonEncode(Json.JsonString("hello world"))
  assert(noEscape == "\"hello world\"", "got '${noEscape}'")
  let endsInEscape = jsonEncode(Json.JsonString("abc\n"))
  assert(endsInEscape == "\"abc\\n\"", "got '${endsInEscape}'")
}

// --- jsonAppend* helpers (#5978) --------------------------------------------
//
// Each helper is asserted against `jsonEncode` of the matching `Json` value,
// never against a second hand-written expectation, so a helper that drifts
// from the encoder it wraps fails here rather than merely agreeing with
// itself.

// `"`, `\`, every control byte 0x00-0x1f, DEL (0x7f, no escape - not < 0x20),
// and a 2-byte UTF-8 rune (é) - the edge set #5978 names for strings and keys.
fn edgeString(): string {
  return "\"\\" +
    "\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f" +
    "\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f" +
    "\x7f\u{e9}"
}

test "jsonAppendString matches jsonEncode(JsonString) over the edge string" {
  let s = edgeString()
  let got = string(jsonAppendString([]byte(0, 8), s))
  let want = jsonEncode(Json.JsonString(s))
  assert(got == want, "got '${got}' want '${want}'")
}

test "jsonAppendKey, first entry, matches jsonEncode's key text" {
  let key = edgeString()
  let got = string(jsonAppendKey([]byte(0, 8), key, true))
  let want = jsonEscapeString(key) + ":"
  assert(got == want, "got '${got}' want '${want}'")
}

test "jsonAppendKey, non-first entry, adds the leading comma" {
  let key = edgeString()
  let got = string(jsonAppendKey([]byte(0, 8), key, false))
  let want = "," + jsonEscapeString(key) + ":"
  assert(got == want, "got '${got}' want '${want}'")
}

// NaN, -0.0, a magnitude past the exponent-form threshold in each direction,
// and one ordinary fraction - the edge set #5978 names for floats.
fn floatEdgeCases(): []f64 {
  return [0.0 / 0.0, -0.0, 1e300, 5e-324, 0.1]
}

test "jsonAppendFloat matches jsonEncode(JsonFloat) over the edge set" {
  let cases = floatEdgeCases()
  let i = 0
  while (i < len(cases)) {
    let v = cases[i]
    let got = string(jsonAppendFloat([]byte(0, 8), v))
    let want = jsonEncode(Json.JsonFloat(v))
    assert(got == want, "case ${i}: got '${got}' want '${want}'")
    i = i + 1
  }
}

// i64 MIN, MAX, and 0 - the edge set #5978 names for ints.
fn intEdgeCases(): []i64 {
  return [-9223372036854775808, 9223372036854775807, 0]
}

test "jsonAppendInt matches jsonEncode(JsonInt) over the edge set" {
  let cases = intEdgeCases()
  let i = 0
  while (i < len(cases)) {
    let v = cases[i]
    let got = string(jsonAppendInt([]byte(0, 8), v))
    let want = jsonEncode(Json.JsonInt(v))
    assert(got == want, "case ${i}: got '${got}' want '${want}'")
    i = i + 1
  }
}

test "jsonAppendBool matches jsonEncode(JsonBool) for both values" {
  let gotTrue = string(jsonAppendBool([]byte(0, 8), true))
  let gotFalse = string(jsonAppendBool([]byte(0, 8), false))
  assert(gotTrue == jsonEncode(Json.JsonBool(true)), "got '${gotTrue}'")
  assert(gotFalse == jsonEncode(Json.JsonBool(false)), "got '${gotFalse}'")
}

test "jsonAppendNull matches jsonEncode(JsonNull)" {
  let got = string(jsonAppendNull([]byte(0, 8)))
  assert(got == jsonEncode(Json.JsonNull), "got '${got}'")
}

test "jsonAppendValue matches jsonEncode for every kind of value, nested" {
  let src = "{\"a\":[1,2.5,\"x\\ny\",null,true,{\"b\":{}}],\"c\":[]}"
  let j = jsonParse(src) catch _ {
    assert(false, "parse")
    return
  }
  let got = string(jsonAppendValue([]byte(0, 8), j))
  assert(got == jsonEncode(j), "got '${got}'")
  let after = string(jsonAppendValue(jsonAppendRaw([]byte(0, 8), "["), Json.JsonNull))
  assert(after == "[null", "appends after what is there: '${after}'")
}

test "jsonAppendRaw appends its argument onto out with no escaping" {
  let out = []byte(0, 8)
  out = append(out, '[')
  out = jsonAppendRaw(out, "1,2,\"x\"")
  out = append(out, ']')
  assert(string(out) == "[1,2,\"x\"]", "got '${string(out)}'")
}
