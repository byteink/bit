// Bit standard library — json module, trivia-carrying CST parser (#1723).
//
// Parses JSONC source into the #1720 CST (Trivia/CstEntry/CstNode)
// losslessly: every comment and each number/string's exact raw span survive,
// unlike #1721/#1722's value-only jsonParse/jsoncParse, which discard both.
// This is the parser a later edit-layer task mutates the output of, so it
// must retain everything that value-only parser throws away.
//
// Reuses stdlib/json/lex.bit's scanner via `lexCst` (this task's one addition
// to that file): comments come back as `Comment` tokens instead of being
// skipped, so string/number/word scanning is never re-implemented here.
// Malformed input (bad token sequence, invalid escape, a number that doesn't
// match the grammar, or exceeding the lexer's 64-level depth cap) is a parse
// error via the fallible return, same as #1721/#1722 — never a panic.
//
// Trivia attachment rule (this file's own decision — neither #1720 nor #1722
// pins one down):
//   - leading:  every run of consecutive Comment tokens immediately before a
//     node's own first token, in source order — one `leading` entry per
//     comment, never concatenated.
//   - trailing: a Comment token immediately following a node's own last
//     token, on the same source line (no `\n` between them) — i.e.
//     `1 /* like this */,` counts, `1, /* not this */` does not (that
//     comment becomes the NEXT node's leading instead). Only one trailing
//     comment is ever captured per node (`Trivia.trailing` is `Option<string>`,
//     not a list).
//   - A run of comments sitting right before a container's closing `}`/`]`
//     (nothing follows them inside the container) folds into that
//     container's own `Trivia.trailing`, per cst.bit's own documented
//     decision. Trivia's shape allows only one string there, so if more than
//     one comment sits in that run, only the first is kept — a real, minor
//     ceiling of the landed type, not a bug in this parser.
//   - A comment that sits on its own line strictly BETWEEN a value and its
//     following comma (`1\n// odd\n,`) is not attached anywhere; the next
//     token expected there is `,`/`}`/`]`, so this produces a parse error.
//     This ordering is vanishingly rare in real JSONC (every realistic style
//     puts such a comment either same-line before the comma, or after it, on
//     its own line before the next entry) and is not exercised by the golden
//     tests.
//
// Trailing-comma re-serialization: this parser does NOT store a
// `hadTrailingComma` flag on CstArray/CstObject. #1722's grammar allows at
// most one trailing comma, so its presence is fully recoverable from
// `len(items)` alone — a printer walking the array/object by index already
// knows whether it is emitting the last element, and the trailing comma is
// purely a function of that plus whatever style the printer wants to
// reproduce; nothing about the parsed *content* depends on whether the comma
// was there. Confirmed sufficient: no flag added.

// A cursor over `lexCst`'s token stream (includes `Comment` tokens), plus the
// original source — decoding a key, or validating a number/string's grammar,
// still needs to slice raw bytes back out of it. Named distinctly from
// parse.bit's `Parser` (same module, so both names are in one scope).
struct CstParser { src: string, toks: []Token, i: int }

function ctPeek(p: CstParser): Token {
  return p.toks[p.i]
}

function ctAdvance(p: CstParser): Token {
  let t = p.toks[p.i]
  if (p.i < len(p.toks) - 1) {
    p.i = p.i + 1
  }
  return t
}

function ctSlice(p: CstParser, t: Token): string {
  return p.src[t.start:t.end]
}

// True when no '\n' appears in src[startAt:endAt) — decides whether a
// comment shares its source line with the token immediately before it.
function ctSameLine(src: string, startAt: int, endAt: int): bool {
  let i = startAt
  while (i < endAt) {
    if (src[i] == '\n') {
      return false
    }
    i = i + 1
  }
  return true
}

// Collects every Comment token at the cursor into `leading`, in source
// order. Bounded by the token stream's own length: each iteration consumes
// exactly one token, so this cannot outrun a finite stream.
function ctCollectLeading(p: CstParser): []string {
  let leading = []string(0)
  let guard = 0
  let bound = len(p.toks) + 1
  while (guard <= bound && ctPeek(p).kind == TokenKind.Comment) {
    let t = ctAdvance(p)
    leading = append(leading, ctSlice(p, t))
    guard = guard + 1
  }
  return leading
}

// Consumes the single same-line trailing comment right after `afterEnd` (a
// node's own last byte offset), if one is there. See this file's header for
// why only one is ever taken.
function ctTakeTrailing(p: CstParser, afterEnd: int): Option<string> {
  let t = ctPeek(p)
  if (t.kind == TokenKind.Comment && ctSameLine(p.src, afterEnd, t.start)) {
    ctAdvance(p)
    return Option<string>.Some(ctSlice(p, t))
  }
  return Option<string>.None
}

// The container-close case: at most one comment fits `Trivia.trailing`, so a
// run right before `}`/`]` keeps only its first entry (closest to the
// container's own last real entry); any further ones in that same run are
// dropped, per this file's header comment.
function ctFirstOrNone(comments: []string): Option<string> {
  if (len(comments) > 0) {
    return Option<string>.Some(comments[0])
  }
  return Option<string>.None
}

// Dispatches on the token at the cursor and builds one CstNode, using
// `leading` (already collected by the caller) as its leading trivia. Shared
// by `ctParseValue` (top level, and after a colon — positions where nothing
// but a value can follow, so collecting leading trivia can't be confused with
// detecting a container's close) and `ctParseArray` (which must tell "next
// item" apart from "the closing `]`" before committing to a value).
function ctBuildValue(p: CstParser, leading: []string): CstNode! {
  let t = ctPeek(p)
  if (t.kind == TokenKind.LBrace) {
    return ctParseObject(p, leading)?
  }
  if (t.kind == TokenKind.LBracket) {
    return ctParseArray(p, leading)?
  }
  if (t.kind == TokenKind.StringTok) {
    ctAdvance(p)
    // Validates escapes/control bytes per RFC 8259 §7 (same rule as
    // #1721/#1722's decodeStringLiteral); the decoded value itself is
    // discarded here — CstString keeps only the raw span, decoding is the
    // later CST-to-Json projection task's job.
    decodeStringLiteral(p.src, t)?
    let trailing = ctTakeTrailing(p, t.end)
    return CstNode.CstString(ctSlice(p, t), Trivia{ leading: leading, trailing: trailing })
  }
  if (t.kind == TokenKind.NumberTok) {
    ctAdvance(p)
    let raw = ctSlice(p, t)
    if (!isValidJsonNumber(raw)) {
      fail newError("json: invalid number literal")
    }
    let trailing = ctTakeTrailing(p, t.end)
    return CstNode.CstNumber(raw, Trivia{ leading: leading, trailing: trailing })
  }
  if (t.kind == TokenKind.TrueTok) {
    ctAdvance(p)
    return CstNode.CstBool(true, Trivia{ leading: leading, trailing: ctTakeTrailing(p, t.end) })
  }
  if (t.kind == TokenKind.FalseTok) {
    ctAdvance(p)
    return CstNode.CstBool(false, Trivia{ leading: leading, trailing: ctTakeTrailing(p, t.end) })
  }
  if (t.kind == TokenKind.NullTok) {
    ctAdvance(p)
    return CstNode.CstNull(Trivia{ leading: leading, trailing: ctTakeTrailing(p, t.end) })
  }
  if (t.kind == TokenKind.Invalid) {
    fail newError(describeInvalid(p.src, t))
  }
  fail newError("json: unexpected token, expected a value")
}

// One value at the cursor, collecting its own leading trivia first.
function ctParseValue(p: CstParser): CstNode! {
  let leading = ctCollectLeading(p)
  return ctBuildValue(p, leading)?
}

// `{` was already peeked by the caller (`ctBuildValue`). Every entry is kept,
// including a repeated key — same policy as #1721/#1722's parseObject.
function ctParseObject(p: CstParser, leading: []string): CstNode! {
  ctAdvance(p)
  let entries = []CstEntry(0)
  // Bounded by the token count: each iteration consumes at least a key, a
  // colon, a value, and a comma, so the loop cannot outrun a finite stream.
  let guard = 0
  let bound = len(p.toks) + 1
  while (guard <= bound) {
    // Collected once: this is EITHER the next key's leading trivia (if a key
    // follows) OR — folded via ctFirstOrNone — the container's own trailing,
    // if a close follows instead (covers both an empty `{}` and the run
    // right after a trailing comma).
    let pending = ctCollectLeading(p)
    if (ctPeek(p).kind == TokenKind.RBrace) {
      ctAdvance(p)
      return CstNode.CstObject(
        entries,
        Trivia{ leading: leading, trailing: ctFirstOrNone(pending) },
      )
    }
    let keyTok = ctPeek(p)
    if (keyTok.kind != TokenKind.StringTok) {
      fail newError("json: expected string key")
    }
    ctAdvance(p)
    let keyText = ctSlice(p, keyTok)
    let key = decodeStringLiteral(p.src, keyTok)?
    if (ctPeek(p).kind != TokenKind.Colon) {
      fail newError("json: expected ':' after object key")
    }
    ctAdvance(p)
    let val = ctParseValue(p)?
    entries = append(
      entries,
      CstEntry{
        keyText: keyText,
        key: key,
        trivia: Trivia{ leading: pending, trailing: Option<string>.None },
        value: val,
      },
    )
    let nxt = ctPeek(p)
    if (nxt.kind == TokenKind.RBrace) {
      ctAdvance(p)
      return CstNode.CstObject(entries, Trivia{ leading: leading, trailing: Option<string>.None })
    }
    if (nxt.kind != TokenKind.Comma) {
      fail newError("json: expected ',' or '}' in object")
    }
    ctAdvance(p)
    // JSONC: a single trailing comma is legal; a second one is not — the next
    // loop iteration's `pending` check falls through to "expected string key"
    // once it sees a second `,` instead of a key or `}`.
    guard = guard + 1
  }
  fail newError("json: object nesting exceeds token bound")
}

// `[` was already peeked by the caller (`ctBuildValue`).
function ctParseArray(p: CstParser, leading: []string): CstNode! {
  ctAdvance(p)
  let items = []CstNode(0)
  let guard = 0
  let bound = len(p.toks) + 1
  while (guard <= bound) {
    // Same "next item vs. close" ambiguity as ctParseObject's `pending`,
    // just without a key in between.
    let pending = ctCollectLeading(p)
    if (ctPeek(p).kind == TokenKind.RBracket) {
      ctAdvance(p)
      return CstNode.CstArray(items, Trivia{ leading: leading, trailing: ctFirstOrNone(pending) })
    }
    let v = ctBuildValue(p, pending)?
    items = append(items, v)
    let nxt = ctPeek(p)
    if (nxt.kind == TokenKind.RBracket) {
      ctAdvance(p)
      return CstNode.CstArray(items, Trivia{ leading: leading, trailing: Option<string>.None })
    }
    if (nxt.kind != TokenKind.Comma) {
      fail newError("json: expected ',' or ']' in array")
    }
    ctAdvance(p)
    guard = guard + 1
  }
  fail newError("json: array nesting exceeds token bound")
}

// Parses `source` as JSONC (stdlib/json/parse.bit's header documents the
// exact grammar this shares: comments, one trailing comma, explicitly not
// JSON5), into a trivia-carrying CST rather than a plain `Json` value.
export function cstParse(source: string): CstNode! {
  let p = CstParser{ src: source, toks: lexCst(source), i: 0 }
  let node = ctParseValue(p)?
  // A comment after the root value has no CST node left to attach to
  // (Trivia lives on nodes, not on the document as a whole); accept and
  // discard it rather than rejecting otherwise-valid JSONC — jsoncParse's own
  // lexer (#1722) already treats a file-trailing comment as plain whitespace.
  ctCollectLeading(p)
  if (ctPeek(p).kind != TokenKind.Eof) {
    fail newError("json: trailing garbage after value")
  }
  return node
}
