// Bit standard library — json module, CST-to-Json projection (#1724).
//
// A pure, total projection: strips every #1720 Trivia and decodes each
// CstNumber/CstString's raw source span into a plain #1717 Json tree, so a
// read-only consumer (e.g. `bit lsp` inspecting a JSONC config) can call
// cstParse (#1723) then cstToJson and use the same jsonGet/jsonAsX accessors
// (#1717) as a plain-JSON caller, without ever touching the CST shape.
//
// Number/string decoding is NOT re-implemented here: it calls
// stdlib/json/parse.bit's decodeNumber/decodeStringLiteral directly (sibling
// files in this directory are the same module, so those module-private
// helpers are already callable with no import/export needed — cst_parse.bit
// already relies on the same thing). Both expect a lexer Token pointing into
// a source string; `wholeSpan` stands in for the real lexer token by pointing
// both ends at the rawText string's own bounds.
//
// Both helpers are fallible because they validate arbitrary lexer input, but
// cstParse already validated this exact span once (with the same
// isValidJsonNumber / decodeStringLiteral) before building the CstNode, so a
// failure here means the CST itself is corrupt: an invariant violation, not a
// runtime condition — hence the panic instead of propagating `!` up through
// cstToJson's own signature, which must stay non-fallible per its contract.

// `decodeNumber`/`decodeStringLiteral` only ever read `src[start:end]` (a
// string additionally expects the surrounding quotes at the ends), so pointing
// both at `rawText`'s own bounds reproduces the real lexer token exactly,
// without needing the original source string or offsets at all.
fn decodeCstNumber(rawText: string): Json {
  return decodeNumber(rawText, 0, len(rawText)) catch e {
    panic("cstToJson: number invariant violated — cstParse should have rejected this: ${e.message()}")
  }
}

fn decodeCstString(rawText: string): string {
  return decodeStringLiteral(rawText, 0, len(rawText)) catch e {
    panic("cstToJson: string invariant violated — cstParse should have rejected this: ${e.message()}")
  }
}

// Strips every Trivia and decodes every raw span, turning a lossless CST
// (stdlib/json/cst.bit) into a plain Json tree (stdlib/json/value.bit).
// Duplicate object keys are kept in source order, same policy as jsonParse —
// jsonGet (value.bit) is the only sanctioned read path and already resolves
// them last-wins, so there is nothing extra to do here.
export fn cstToJson(n: CstNode): Json {
  match (n) {
    CstNull(_) => return Json.JsonNull
    CstBool(b, _) => return Json.JsonBool(b)
    CstNumber(rawText, _) => return decodeCstNumber(rawText)
    CstString(rawText, _) => return Json.JsonString(decodeCstString(rawText))
    CstArray(items, _, _) => {
      let out = []Json(0)
      for item of items {
        out = append(out, cstToJson(item))
      }
      return Json.JsonArray(out)
    }
    CstObject(entries, _, _) => {
      let out = []JsonEntry(0)
      for e of entries {
        out = append(out, JsonEntry{ key: e.key, value: cstToJson(e.value) })
      }
      return Json.JsonObject(out)
    }
  }
}
