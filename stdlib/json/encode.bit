// Bit standard library — json module, encoder.
//
// Serializes a `Json` value tree (stdlib/json/value.bit) to a `string`. This
// is the plain-value encoder: no trivia, no comments, nothing round-tripped
// from source text. The CST printer the edit layer needs is a separate, later
// task (#1479).

// `contains` is already imported into this module by parse.bit — importing
// it again here would collide (same module, same declaration; see
// parse.bit's own comment about `newBuilder` for why).
import { newBuilder, repeat } from "std/strings"

// `j` as compact JSON: no whitespace, `,`/`:` with no padding.
export function jsonEncode(j: Json): string {
  return encodeValue(j)
}

// `j` as pretty JSON: each object/array element on its own line, `indent`
// repeated once per nesting depth, `": "` after each key. No trailing
// newline — matches the shape of `JSON.stringify(v, null, 2)`.
export function jsonEncodePretty(j: Json, indent: string): string {
  return encodeValuePretty(j, indent, 0)
}

// --- compact ---------------------------------------------------------------

function encodeValue(j: Json): string {
  match (j) {
    JsonNull => return "null"
    JsonBool(b) => return encodeBool(b)
    JsonInt(i) => return "${i}"
    JsonFloat(f) => return formatJsonFloat(f)
    JsonString(s) => return jsonEscapeString(s)
    JsonArray(a) => return encodeArray(a)
    JsonObject(o) => return encodeObject(o)
  }
}

function encodeArray(a: []Json): string {
  let out = "["
  let i = 0
  while (i < len(a)) {
    if (i > 0) {
      out = out + ","
    }
    out = out + encodeValue(a[i])
    i = i + 1
  }
  return out + "]"
}

function encodeObject(o: []JsonEntry): string {
  let out = "{"
  let i = 0
  while (i < len(o)) {
    if (i > 0) {
      out = out + ","
    }
    out = out + jsonEscapeString(o[i].key) + ":" + encodeValue(o[i].value)
    i = i + 1
  }
  return out + "}"
}

// --- pretty ------------------------------------------------------------

function encodeValuePretty(j: Json, indent: string, depth: i64): string {
  match (j) {
    JsonNull => return "null"
    JsonBool(b) => return encodeBool(b)
    JsonInt(i) => return "${i}"
    JsonFloat(f) => return formatJsonFloat(f)
    JsonString(s) => return jsonEscapeString(s)
    JsonArray(a) => return encodeArrayPretty(a, indent, depth)
    JsonObject(o) => return encodeObjectPretty(o, indent, depth)
  }
}

function encodeArrayPretty(a: []Json, indent: string, depth: i64): string {
  if (len(a) == 0) {
    return "[]"
  }
  let inner = repeat(indent, depth + 1)
  let outer = repeat(indent, depth)
  let out = "[\n"
  let i = 0
  while (i < len(a)) {
    out = out + inner + encodeValuePretty(a[i], indent, depth + 1)
    if (i < len(a) - 1) {
      out = out + ","
    }
    out = out + "\n"
    i = i + 1
  }
  return out + outer + "]"
}

function encodeObjectPretty(o: []JsonEntry, indent: string, depth: i64): string {
  if (len(o) == 0) {
    return "{}"
  }
  let inner = repeat(indent, depth + 1)
  let outer = repeat(indent, depth)
  let out = "{\n"
  let i = 0
  while (i < len(o)) {
    out = out + inner + jsonEscapeString(o[i].key) + ": " + encodeValuePretty(
      o[i].value,
      indent,
      depth + 1,
    )
    if (i < len(o) - 1) {
      out = out + ","
    }
    out = out + "\n"
    i = i + 1
  }
  return out + outer + "}"
}

// --- shared ------------------------------------------------------------

function encodeBool(b: bool): string {
  if (b) {
    return "true"
  }
  return "false"
}

// --- floats --------------------------------------------------------------

// Formats `f` as a JSON number literal. Two defects fixed here:
//
//   - non-finite (#2281): JSON has no non-finite literal, and the runtime
//     formatter's own `inf`/`-inf`/`nan` spelling is not valid JSON —
//     jsonParse correctly refuses all three, so a document containing one
//     would be unreadable forever after. Encoded as `null`, matching JS
//     `JSON.stringify` and serde_json.
//   - integral (#2282): `"${100.0}"` is `"100"`, indistinguishable from a
//     JsonInt on the way back in (stdlib/json/parse.bit routes a literal
//     with no `.`/`e`/`E` to JsonInt). Appending `.0` when the formatted
//     text has no `.` restores the distinction — and, for `-0.0`
//     formatting as `"-0"`, the sign, since `"-0" + ".0"` is `"-0.0"`.
function formatJsonFloat(f: f64): string {
  let text = "${f}"
  if (text == "nan" || text == "inf" || text == "-inf") {
    return "null"
  }
  if (contains(text, ".")) {
    return text
  }
  return text + ".0"
}

const hexDigits: string = "0123456789abcdef"

// `\u00XX` escape for a control byte `c`. Only ever called on `c < 0x20`, so
// the high nibble is always 0 or 1.
function unicodeEscape(c: u8): string {
  let out = []byte(2)
  out[0] = hexDigits[int(c >> 4)]
  out[1] = hexDigits[int(c & 0x0f)]
  return "\\u00" + string(out)
}

// A JSON string literal for `s` (RFC 8259 §7): double-quoted, with `"`, `\`,
// and control bytes < 0x20 escaped. Bytes >= 0x20 pass through as-is — JSON
// strings are UTF-8, so a multi-byte UTF-8 sequence needs no `\u` escaping.
function jsonEscapeString(s: string): string {
  let b = newBuilder().write("\"")
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == '"') {
      b = b.write("\\\"")
    } else if (c == '\\') {
      b = b.write("\\\\")
    } else if (c == '\n') {
      b = b.write("\\n")
    } else if (c == '\t') {
      b = b.write("\\t")
    } else if (c == '\r') {
      b = b.write("\\r")
    } else if (c == 8) { // backspace; no rune-literal escape for it (spec §5.6)
      b = b.write("\\b")
    } else if (c == 12) { // form feed; no rune-literal escape for it (spec §5.6)
      b = b.write("\\f")
    } else if (c < 32) {
      b = b.write(unicodeEscape(c))
    } else {
      b = b.writeByte(c)
    }
    i = i + 1
  }
  b = b.write("\"")
  return b.toString()
}
