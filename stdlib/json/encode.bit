// Bit standard library — json module, encoder.
//
// Serializes a `Json` value tree (stdlib/json/value.bit) to a `string`. This
// is the plain-value encoder: no trivia, no comments, nothing round-tripped
// from source text. The CST printer the edit layer needs is a separate, later
// task (#1479).
//
// Both `jsonEncode` and `jsonEncodePretty` build into a single `[]byte`
// accumulator threaded through the recursion, appended to once per byte,
// rather than returning a fresh `string` from every recursive call — the
// original shape did `out = out + encodeValue(...)` per element, which
// copies the entire accumulated output on every append and made encoding
// quadratic in element count (#2173). `append` on a slice grows its backing
// buffer in place (amortized, not a copy-the-whole-thing-every-call cost the
// way `string + string` is), so threading one buffer through is linear.

// `contains` is already imported into this module by parse.bit — importing
// it again here would collide (same module, same declaration; see
// parse.bit's own comment about `newBuilder` for why).
import { newBuilder, repeat } from "std/strings"

// `j` as compact JSON: no whitespace, `,`/`:` with no padding.
export function jsonEncode(j: Json): string {
  let out = []byte(0)
  out = encodeValue(j, out)
  return string(out)
}

// `j` as pretty JSON: each object/array element on its own line, `indent`
// repeated once per nesting depth, `": "` after each key. No trailing
// newline — matches the shape of `JSON.stringify(v, null, 2)`.
export function jsonEncodePretty(j: Json, indent: string): string {
  let out = []byte(0)
  out = encodeValuePretty(j, indent, 0, out)
  return string(out)
}

// --- compact ---------------------------------------------------------------

// Appends `j`'s compact encoding onto `out` and returns the grown buffer.
function encodeValue(j: Json, out: []byte): []byte {
  match (j) {
    JsonNull => return appendStr(out, "null")
    JsonBool(b) => return appendStr(out, encodeBool(b))
    JsonInt(i) => return appendStr(out, "${i}")
    JsonFloat(f) => return appendStr(out, formatJsonFloat(f))
    JsonString(s) => return appendStr(out, jsonEscapeString(s))
    JsonArray(a) => return encodeArray(a, out)
    JsonObject(o) => return encodeObject(o, out)
  }
}

function encodeArray(a: []Json, out: []byte): []byte {
  out = append(out, '[')
  let i = 0
  while (i < len(a)) {
    if (i > 0) {
      out = append(out, ',')
    }
    out = encodeValue(a[i], out)
    i = i + 1
  }
  return append(out, ']')
}

function encodeObject(o: []JsonEntry, out: []byte): []byte {
  out = append(out, '{')
  let i = 0
  while (i < len(o)) {
    if (i > 0) {
      out = append(out, ',')
    }
    out = appendStr(out, jsonEscapeString(o[i].key))
    out = append(out, ':')
    out = encodeValue(o[i].value, out)
    i = i + 1
  }
  return append(out, '}')
}

// --- pretty ------------------------------------------------------------

function encodeValuePretty(j: Json, indent: string, depth: i64, out: []byte): []byte {
  match (j) {
    JsonNull => return appendStr(out, "null")
    JsonBool(b) => return appendStr(out, encodeBool(b))
    JsonInt(i) => return appendStr(out, "${i}")
    JsonFloat(f) => return appendStr(out, formatJsonFloat(f))
    JsonString(s) => return appendStr(out, jsonEscapeString(s))
    JsonArray(a) => return encodeArrayPretty(a, indent, depth, out)
    JsonObject(o) => return encodeObjectPretty(o, indent, depth, out)
  }
}

function encodeArrayPretty(a: []Json, indent: string, depth: i64, out: []byte): []byte {
  if (len(a) == 0) {
    return appendStr(out, "[]")
  }
  let inner = repeat(indent, depth + 1)
  let outer = repeat(indent, depth)
  out = appendStr(out, "[\n")
  let i = 0
  while (i < len(a)) {
    out = appendStr(out, inner)
    out = encodeValuePretty(a[i], indent, depth + 1, out)
    if (i < len(a) - 1) {
      out = append(out, ',')
    }
    out = append(out, '\n')
    i = i + 1
  }
  out = appendStr(out, outer)
  return append(out, ']')
}

function encodeObjectPretty(o: []JsonEntry, indent: string, depth: i64, out: []byte): []byte {
  if (len(o) == 0) {
    return appendStr(out, "{}")
  }
  let inner = repeat(indent, depth + 1)
  let outer = repeat(indent, depth)
  out = appendStr(out, "{\n")
  let i = 0
  while (i < len(o)) {
    out = appendStr(out, inner)
    out = appendStr(out, jsonEscapeString(o[i].key))
    out = appendStr(out, ": ")
    out = encodeValuePretty(o[i].value, indent, depth + 1, out)
    if (i < len(o) - 1) {
      out = append(out, ',')
    }
    out = append(out, '\n')
    i = i + 1
  }
  out = appendStr(out, outer)
  return append(out, '}')
}

// --- shared ------------------------------------------------------------

// Appends every byte of `s` onto `out`. `append` grows `out`'s backing
// buffer in place (amortized O(1) per call), so this is linear in `len(s)`
// regardless of how many times it is called — the primitive `encodeArray`/
// `encodeObject`/the pretty variants above build the whole document out of.
function appendStr(out: []byte, s: string): []byte {
  let i = 0
  let n = len(s)
  while (i < n) {
    out = append(out, s[i])
    i = i + 1
  }
  return out
}

function encodeBool(b: bool): string {
  if (b) {
    return "true"
  }
  return "false"
}

// --- floats --------------------------------------------------------------
//
// `"${f}"` (the runtime's shortest-round-trip float formatter) is the single
// source of truth for which decimal digits denote `f` — this section only
// ever reshapes that text, never recomputes a float-to-decimal conversion.
// Three defects fixed here, all in the reshaping:
//
//   - non-finite (#2281): the runtime spells these `inf`/`-inf`/`nan`, none
//     of which is JSON: `jsonParse` correctly refuses to read any of them
//     back. Encoded as `null`, matching JS `JSON.stringify` and serde_json.
//   - integral (#2282): `"${100.0}"` is `"100"`, indistinguishable from a
//     JsonInt on the way back in (stdlib/json/parse.bit routes a literal
//     with no `.`/`e`/`E` to JsonInt). A finite value with no `.`/`e`/`E` in
//     its formatted text gets `.0` appended, restoring the distinction (and,
//     for `-0.0` formatting as `"-0"`, the sign).
//   - extreme magnitudes (#2283): the runtime formatter only ever produces
//     positional notation, so a value like 5e-324 comes out as 325 zeros and
//     a `5`. Outside roughly 1e-6..1e21 (the same rough band JS's
//     `Number#toString` switches at) this reshapes the positional digits
//     into `d.ddde±NN` instead.

// Formats `f` as a JSON number literal.
function formatJsonFloat(f: f64): string {
  let text = "${f}"
  if (text == "nan" || text == "inf" || text == "-inf") {
    return "null"
  }
  let parts = splitFloatText(text)
  let n = len(parts.digits)
  let firstNZ = 0
  while (firstNZ < n && parts.digits[firstNZ] == '0') {
    firstNZ = firstNZ + 1
  }
  if (firstNZ == n) {
    // The value is exactly zero; only the sign is still meaningful (-0.0).
    if (parts.neg) {
      return "-0.0"
    }
    return "0.0"
  }
  let lastNZ = n - 1
  while (parts.digits[lastNZ] == '0') {
    lastNZ = lastNZ - 1
  }
  // Decimal exponent of the leading significant digit: value =
  // d.ddd... * 10^exp. `pointPos` counts digits before the decimal point.
  let exp = parts.pointPos - 1 - firstNZ
  if (exp < -6 || exp >= 21) {
    return formatScientific(parts.neg, parts.digits[firstNZ:lastNZ + 1], exp)
  }
  if (contains(text, ".")) {
    return text
  }
  return text + ".0"
}

// A finite float's formatted text, decomposed into its sign, its digit run
// with the decimal point removed, and the point's position (count of digits
// before it) within that run. The runtime formatter never emits an exponent
// for finite values (#2283's own measurement), so `text` is always `-`?
// digits (`.` digits)?.
struct FloatParts { neg: bool, digits: string, pointPos: int }

function splitFloatText(text: string): FloatParts {
  let i = 0
  let neg = false
  if (len(text) > 0 && text[0] == '-') {
    neg = true
    i = 1
  }
  let intStart = i
  while (i < len(text) && text[i] != '.') {
    i = i + 1
  }
  let intPart = text[intStart:i]
  let fracPart = ""
  if (i < len(text)) {
    fracPart = text[i + 1:len(text)]
  }
  return FloatParts{ neg: neg, digits: intPart + fracPart, pointPos: len(intPart) }
}

// `sig` (no leading or trailing zero digit) as `d.ddd` (or bare `d` for one
// digit) `e` `+`/`-` `exp`, e.g. `formatScientific(false, "17976931348623157",
// 308)` -> `"1.7976931348623157e+308"`.
function formatScientific(neg: bool, sig: string, exp: int): string {
  let b = newBuilder()
  if (neg) {
    b = b.write("-")
  }
  b = b.writeByte(sig[0])
  if (len(sig) > 1) {
    b = b.write(".").write(sig[1:len(sig)])
  }
  b = b.write("e")
  let mag = exp
  if (mag < 0) {
    b = b.write("-")
    mag = 0 - mag
  } else {
    b = b.write("+")
  }
  b = b.write("${mag}")
  return b.toString()
}

const hexDigits: string = "0123456789abcdef"

// `\u00XX` escape for a control byte `c`. Only ever called on `c < 0x20`, so
// the high nibble is always 0 or 1.
function unicodeEscape(c: u8): string {
  let out = []byte(2)
  out[0] = hexDigits[int(c >> 4)]
  out[1] = hexDigits[int(c & 0x0f)]
  return "\\u00" + string(out)
}

// A JSON string literal for `s` (RFC 8259 §7): double-quoted, with `"`, `\`,
// and control bytes < 0x20 escaped. Bytes >= 0x20 pass through as-is — JSON
// strings are UTF-8, so a multi-byte UTF-8 sequence needs no `\u` escaping.
function jsonEscapeString(s: string): string {
  let b = newBuilder().write("\"")
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == '"') {
      b = b.write("\\\"")
    } else if (c == '\\') {
      b = b.write("\\\\")
    } else if (c == '\n') {
      b = b.write("\\n")
    } else if (c == '\t') {
      b = b.write("\\t")
    } else if (c == '\r') {
      b = b.write("\\r")
    } else if (c == 8) { // backspace; no rune-literal escape for it (spec §5.6)
      b = b.write("\\b")
    } else if (c == 12) { // form feed; no rune-literal escape for it (spec §5.6)
      b = b.write("\\f")
    } else if (c < 32) {
      b = b.write(unicodeEscape(c))
    } else {
      b = b.writeByte(c)
    }
    i = i + 1
  }
  b = b.write("\"")
  return b.toString()
}
