// Bit standard library — json module, hand-written flat lexer over JSON text.
//
// Produces a flat token stream: no recursion, no regex, no generated tables
// (#1479's "own toolchain" rule — a lexer is a loop, not a tree). Tokens carry
// raw `start`/`end` byte offsets into the source and, for strings/numbers, an
// UNPROCESSED raw span: escapes are not decoded and numeric grammar is not
// enforced here. Decoding is the parser task's job (#1479's child); this
// layer only slices, it never normalizes, so the later CST layer can echo an
// untouched literal back byte-for-byte.
//
// `{`/`[` nesting is capped at `jsonMaxDepth` combined levels, tracked with a
// flat push/pop counter rather than recursion, so a maliciously deep input
// yields an `Invalid` token instead of a stack overflow.
//
// `lex` itself stays strict RFC 8259 (no comment handling). The JSONC
// extension (#1479, stdlib/json/parse.bit) reuses this same scanner with
// comment-skipping switched on via the `allowComments` flag, so the
// grammar lives in exactly one place instead of a forked copy. The CST layer
// (#1723, stdlib/json/cst_parse.bit) needs the comments themselves, not just
// a place that skips them, so `lexImpl` takes a second flag, `emitComments`:
// with it set, a `//`/`/* */` span comes back as a `Comment` token (verbatim
// span, delimiters included) instead of being consumed as whitespace —
// same scanner, same grammar, one more observable outcome.

// TWO ENTRY POINTS, ONE GRAMMAR (#2293). `lex`/`lexCst` materialize the whole
// stream as `[]Token`, which is what a caller wanting random access (the CST
// layer, the lexer tests) needs. `jsonParse`/`jsoncParse` never look backwards,
// so they drive `lexNext` directly and read the current token off `Lexer`'s own
// `kind`/`start`/`end` fields — a class is a heap object in Bit, so a
// materialized `Token` per token is a `gc_alloc` per token, and a 9 MB document
// is 3.6M of them held live for the entire parse. `scanToken` below is the only
// place a `Token` is built, so the two entry points cannot drift apart.
//
// The lexical categories a JSON token can be.
export enum TokenKind {
  LBrace,
  RBrace,
  LBracket,
  RBracket,
  Colon,
  Comma,
  StringTok,
  NumberTok,
  TrueTok,
  FalseTok,
  NullTok,
  Eof,
  Invalid,
  Comment,
}

// One lexical token: its kind and its `[start, end)` byte span in the source.
// For `StringTok` the span includes the surrounding quotes; for `NumberTok` it
// is the literal exactly as written. Neither is unescaped or normalized.
export class Token { kind: TokenKind, start: int, end: int }

// Combined `{`/`[` nesting limit (#1479's depth-limit decision): the open that
// would create the 129th level is rejected as `Invalid` instead of tracked, so
// the lexer's counter never grows past this fixed bound.
//
// THIS CONSTANT IS A RECURSION BOUND, not just a policy knob. `parseValue`
// (parse.bit) calls `parseObject`/`parseArray`, which call `parseValue` back,
// so the depth accepted here is the depth of the C stack the parser will use —
// and `encodeValue` (encode.bit) recurses the same way. Whatever this says, a
// green thread has to survive that many frames of it.
//
// Raised from 64, which was too low: an object nested inside an array counts as
// two levels, so 64 gave a practical ceiling of ~32 levels of an ordinary
// recursive structure, and `jsonEncode` has no matching cap — an everyday tree
// (a category tree, a comment thread) encoded fine and then failed to parse
// back. That was #2256.
//
// NOT raised to 1000, which was tried and reverted (#2345). A green thread's
// stack is fixed and much smaller than main's (#2246), so at 1000 a document of
// ~250 levels parsed on the main thread and SIGSEGVed inside `spawn` — which is
// where every HTTP handler runs. Measured on this tree: depth 220 survived a
// `spawn`, depth 250 did not. A clean "max nesting depth exceeded" had become a
// remote crash, which is strictly worse than the round-trip bug it fixed.
//
// 128 gives 64 levels of object-in-array — double what #2256 needed — while
// staying ~2x under the measured crash point. Do not raise it without
// re-measuring INSIDE a `spawn`; a main-thread measurement reports a ceiling
// roughly 3x too high and walks straight back into #2345.
export const jsonMaxDepth = 128

// The scanner's state, plus the token it most recently produced
// (`kind`/`start`/`end`). Carrying the current token in the state rather than
// returning it is what lets `jsonParse` tokenize without allocating: see this
// file's header.
class Lexer { src: string, i: int, depth: int, kind: TokenKind, start: int, end: int }

// A scanner positioned before `source`'s first token. `kind` is `Eof` until the
// first `lexNext`, which is the same thing an empty source would yield, so a
// caller that reads the cursor without scanning sees "no token", never garbage.
fn newLexer(source: string): Lexer {
  return Lexer{ src: source, i: 0, depth: 0, kind: TokenKind.Eof, start: 0, end: 0 }
}

fn isDigit(c: u8): bool {
  return c >= '0' && c <= '9'
}

fn isLower(c: u8): bool {
  return c >= 'a' && c <= 'z'
}

// Records `[start, end)` as the current token without touching the cursor.
fn setTok(lx: Lexer, k: TokenKind, start: int, end: int) {
  lx.kind = k
  lx.start = start
  lx.end = end
}

// Advances the cursor by `n` and records the token `[start, start+n)`.
fn emit(lx: Lexer, start: int, n: int, k: TokenKind) {
  lx.i = start + n
  setTok(lx, k, start, start + n)
}

// `{`/`[`: enforces `jsonMaxDepth`, recording `Invalid` (without opening a new
// level) once the counter already sits at the cap.
fn scanOpen(lx: Lexer, k: TokenKind) {
  let start = lx.i
  if (lx.depth >= jsonMaxDepth) {
    emit(lx, start, 1, TokenKind.Invalid)
    return
  }
  lx.depth = lx.depth + 1
  emit(lx, start, 1, k)
}

// `}`/`]`: pops one level; never goes negative on an unmatched closer.
fn scanClose(lx: Lexer, k: TokenKind) {
  let start = lx.i
  if (lx.depth > 0) {
    lx.depth = lx.depth - 1
  }
  emit(lx, start, 1, k)
}

// A `"`-delimited string span, quotes included, escapes left raw. A `\`
// always protects the byte after it from ending the string (so an escaped
// quote does not close it); an unterminated string consumes to EOF and
// reports `Invalid` rather than looping past the source.
fn scanString(lx: Lexer) {
  let start = lx.i
  lx.i = lx.i + 1
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == '"') {
      lx.i = lx.i + 1
      setTok(lx, TokenKind.StringTok, start, lx.i)
      return
    }
    if (c == '\\' && lx.i + 1 < len(lx.src)) {
      lx.i = lx.i + 2
    } else {
      lx.i = lx.i + 1
    }
  }
  setTok(lx, TokenKind.Invalid, start, lx.i)
}

// A JSON number span (RFC 8259 §6: optional `-`, integer part, optional `.`
// fraction, optional `e`/`E` exponent) captured verbatim. This layer scans
// the shape; it does not reject a malformed literal — that check belongs to
// the parser task consuming this stream.
fn scanNumber(lx: Lexer) {
  let start = lx.i
  if (lx.src[lx.i] == '-') {
    lx.i = lx.i + 1
  }
  while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
    lx.i = lx.i + 1
  }
  if (lx.i < len(lx.src) && lx.src[lx.i] == '.') {
    lx.i = lx.i + 1
    while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }
  if (lx.i < len(lx.src) && (lx.src[lx.i] == 'e' || lx.src[lx.i] == 'E')) {
    lx.i = lx.i + 1
    if (lx.i < len(lx.src) && (lx.src[lx.i] == '+' || lx.src[lx.i] == '-')) {
      lx.i = lx.i + 1
    }
    while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }
  setTok(lx, TokenKind.NumberTok, start, lx.i)
}

// `true`/`false`/`null`, or `Invalid` for any other lowercase run — JSON's
// only bare-word literals are these three.
// Span-compared (#2293) rather than materializing `lx.src[start:lx.i]`: a
// substring is a fresh heap copy, and `true`/`false`/`null` are three of the
// commonest tokens in real documents, so slicing here cost one allocation per
// bare-word token to learn something four byte compares already know.
fn spanIs(lx: Lexer, start: int, end: int, word: string): bool {
  if (end - start != len(word)) {
    return false
  }
  let k = 0
  while (k < len(word)) {
    if (lx.src[start + k] != word[k]) {
      return false
    }
    k = k + 1
  }
  return true
}

fn scanWord(lx: Lexer) {
  let start = lx.i
  while (lx.i < len(lx.src) && isLower(lx.src[lx.i])) {
    lx.i = lx.i + 1
  }
  if (spanIs(lx, start, lx.i, "true")) {
    setTok(lx, TokenKind.TrueTok, start, lx.i)
    return
  }
  if (spanIs(lx, start, lx.i, "false")) {
    setTok(lx, TokenKind.FalseTok, start, lx.i)
    return
  }
  if (spanIs(lx, start, lx.i, "null")) {
    setTok(lx, TokenKind.NullTok, start, lx.i)
    return
  }
  setTok(lx, TokenKind.Invalid, start, lx.i)
}

// Skips JSON whitespace (RFC 8259 §2: space, tab, CR, LF) and dispatches one
// token from what follows, or `Eof` once the source is exhausted. When
// `allowComments` is set (JSONC, #1479), a `//` line comment or a non-nesting
// `/* */` block comment is recognized anywhere whitespace is; `emitComments`
// (CST layer, #1723) picks what happens to it: `false` skips it like more
// whitespace (JSONC's strict-value behavior), `true` returns it as a
// `Comment` token (verbatim span, delimiters included) instead of consuming
// it silently. An unterminated `/*` always consumes to EOF and returns
// `Invalid` immediately (span longer than one byte, so `describeInvalid` in
// parse.bit can tell it apart from a lone stray `/`), regardless of
// `emitComments` — a truncated comment is malformed input either way.
fn lexNext(lx: Lexer, allowComments: bool, emitComments: bool) {
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
      lx.i = lx.i + 1
    } else if (allowComments && c == '/' && lx.i + 1 < len(lx.src) && lx.src[lx.i + 1] == '/') {
      let start = lx.i
      lx.i = lx.i + 2
      while (lx.i < len(lx.src) && lx.src[lx.i] != '\n') {
        lx.i = lx.i + 1
      }
      if (emitComments) {
        setTok(lx, TokenKind.Comment, start, lx.i)
        return
      }
    } else if (allowComments && c == '/' && lx.i + 1 < len(lx.src) && lx.src[lx.i + 1] == '*') {
      let start = lx.i
      lx.i = lx.i + 2
      let closed = false
      while (lx.i + 1 < len(lx.src)) {
        if (lx.src[lx.i] == '*' && lx.src[lx.i + 1] == '/') {
          lx.i = lx.i + 2
          closed = true
          break
        }
        lx.i = lx.i + 1
      }
      if (!closed) {
        lx.i = len(lx.src)
        setTok(lx, TokenKind.Invalid, start, lx.i)
        return
      }
      if (emitComments) {
        setTok(lx, TokenKind.Comment, start, lx.i)
        return
      }
    } else if (c == '{') {
      scanOpen(lx, TokenKind.LBrace)
      return
    } else if (c == '}') {
      scanClose(lx, TokenKind.RBrace)
      return
    } else if (c == '[') {
      scanOpen(lx, TokenKind.LBracket)
      return
    } else if (c == ']') {
      scanClose(lx, TokenKind.RBracket)
      return
    } else if (c == ':') {
      emit(lx, lx.i, 1, TokenKind.Colon)
      return
    } else if (c == ',') {
      emit(lx, lx.i, 1, TokenKind.Comma)
      return
    } else if (c == '"') {
      scanString(lx)
      return
    } else if (isDigit(c) || c == '-') {
      scanNumber(lx)
      return
    } else if (isLower(c)) {
      scanWord(lx)
      return
    } else {
      emit(lx, lx.i, 1, TokenKind.Invalid)
      return
    }
  }
  setTok(lx, TokenKind.Eof, lx.i, lx.i)
}

// The only place a `Token` is materialized. `lexImpl` (the `[]Token` API) needs
// one per token; `jsonParse` reads `lx.kind`/`lx.start`/`lx.end` instead and
// never calls this.
fn scanToken(lx: Lexer, allowComments: bool, emitComments: bool): Token {
  lexNext(lx, allowComments, emitComments)
  return Token{ kind: lx.kind, start: lx.start, end: lx.end }
}

// The full token stream for `source`, ending with one `Eof`. Bounded by twice
// the byte length plus one guard slot: every emitted token consumes at least
// one source byte (a skipped comment, if any, adds no token; an emitted one
// still only consumes the bytes it spans), so the loop cannot outrun the
// input — a statically provable bound, not open-ended recursion. An
// unterminated `/* */` (JSONC) pins `lx.i` at EOF, so the next call yields
// `Eof` and the loop ends the same way it always has.
fn lexImpl(source: string, allowComments: bool, emitComments: bool): []Token {
  let lx = newLexer(source)
  let toks = []Token(0)
  let guard = 0
  let bound = len(source) * 2 + 2
  while (guard <= bound) {
    let t = scanToken(lx, allowComments, emitComments)
    toks = append(toks, t)
    if (t.kind == TokenKind.Eof) {
      break
    }
    guard = guard + 1
  }
  return toks
}

// The full token stream for `source`, strict RFC 8259 (no comments).
export fn lex(source: string): []Token {
  return lexImpl(source, false, false)
}

// The full token stream for `source`, JSONC grammar, with every `//`/`/* */`
// comment returned as a `Comment` token instead of being skipped (#1723's
// cst_parse.bit collects these into `Trivia`). Everything else — dispatch,
// depth cap, raw string/number spans — is `lex`'s own scanner; this is not a
// second lexer, just this one's third observable mode.
export fn lexCst(source: string): []Token {
  return lexImpl(source, true, true)
}
