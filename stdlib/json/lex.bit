// Bit standard library — json module, hand-written flat lexer over JSON text.
//
// Produces a flat token stream: no recursion, no regex, no generated tables
// (#1479's "own toolchain" rule — a lexer is a loop, not a tree). Tokens carry
// raw `start`/`end` byte offsets into the source and, for strings/numbers, an
// UNPROCESSED raw span: escapes are not decoded and numeric grammar is not
// enforced here. Decoding is the parser task's job (#1479's child); this
// layer only slices, it never normalizes, so the later CST layer can echo an
// untouched literal back byte-for-byte.
//
// `{`/`[` nesting is capped at `jsonMaxDepth` combined levels, tracked with a
// flat push/pop counter rather than recursion, so a maliciously deep input
// yields an `Invalid` token instead of a stack overflow.
//
// No comment handling: this is strict JSON (RFC 8259). JSONC comments are a
// separate lexer layered on top, not this one.

// The lexical categories a JSON token can be.
export enum TokenKind {
  LBrace,
  RBrace,
  LBracket,
  RBracket,
  Colon,
  Comma,
  StringTok,
  NumberTok,
  TrueTok,
  FalseTok,
  NullTok,
  Eof,
  Invalid,
}

// One lexical token: its kind and its `[start, end)` byte span in the source.
// For `StringTok` the span includes the surrounding quotes; for `NumberTok` it
// is the literal exactly as written. Neither is unescaped or normalized.
export struct Token { kind: TokenKind, start: int, end: int }

// Combined `{`/`[` nesting limit (#1479's depth-limit decision): the open
// that would create the 65th level is rejected as `Invalid` instead of
// tracked, so the lexer's counter never grows past this fixed bound.
export const jsonMaxDepth = 64

struct Lexer { src: string, i: int, depth: int }

function isDigit(c: u8): bool {
  return c >= '0' && c <= '9'
}

function isLower(c: u8): bool {
  return c >= 'a' && c <= 'z'
}

// Advances the cursor by `n` and returns the token `[start, start+n)`.
function emit(lx: Lexer, start: int, n: int, k: TokenKind): Token {
  lx.i = start + n
  return Token{ kind: k, start: start, end: start + n }
}

// `{`/`[`: enforces `jsonMaxDepth`, returning `Invalid` (without opening a new
// level) once the counter already sits at the cap.
function scanOpen(lx: Lexer, k: TokenKind): Token {
  let start = lx.i
  if (lx.depth >= jsonMaxDepth) {
    return emit(lx, start, 1, TokenKind.Invalid)
  }
  lx.depth = lx.depth + 1
  return emit(lx, start, 1, k)
}

// `}`/`]`: pops one level; never goes negative on an unmatched closer.
function scanClose(lx: Lexer, k: TokenKind): Token {
  let start = lx.i
  if (lx.depth > 0) {
    lx.depth = lx.depth - 1
  }
  return emit(lx, start, 1, k)
}

// A `"`-delimited string span, quotes included, escapes left raw. A `\`
// always protects the byte after it from ending the string (so an escaped
// quote does not close it); an unterminated string consumes to EOF and
// reports `Invalid` rather than looping past the source.
function scanString(lx: Lexer): Token {
  let start = lx.i
  lx.i = lx.i + 1
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == '"') {
      lx.i = lx.i + 1
      return Token{ kind: TokenKind.StringTok, start: start, end: lx.i }
    }
    if (c == '\\' && lx.i + 1 < len(lx.src)) {
      lx.i = lx.i + 2
    } else {
      lx.i = lx.i + 1
    }
  }
  return Token{ kind: TokenKind.Invalid, start: start, end: lx.i }
}

// A JSON number span (RFC 8259 §6: optional `-`, integer part, optional `.`
// fraction, optional `e`/`E` exponent) captured verbatim. This layer scans
// the shape; it does not reject a malformed literal — that check belongs to
// the parser task consuming this stream.
function scanNumber(lx: Lexer): Token {
  let start = lx.i
  if (lx.src[lx.i] == '-') {
    lx.i = lx.i + 1
  }
  while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
    lx.i = lx.i + 1
  }
  if (lx.i < len(lx.src) && lx.src[lx.i] == '.') {
    lx.i = lx.i + 1
    while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }
  if (lx.i < len(lx.src) && (lx.src[lx.i] == 'e' || lx.src[lx.i] == 'E')) {
    lx.i = lx.i + 1
    if (lx.i < len(lx.src) && (lx.src[lx.i] == '+' || lx.src[lx.i] == '-')) {
      lx.i = lx.i + 1
    }
    while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }
  return Token{ kind: TokenKind.NumberTok, start: start, end: lx.i }
}

// `true`/`false`/`null`, or `Invalid` for any other lowercase run — JSON's
// only bare-word literals are these three.
function scanWord(lx: Lexer): Token {
  let start = lx.i
  while (lx.i < len(lx.src) && isLower(lx.src[lx.i])) {
    lx.i = lx.i + 1
  }
  let word = lx.src[start:lx.i]
  if (word == "true") {
    return Token{ kind: TokenKind.TrueTok, start: start, end: lx.i }
  }
  if (word == "false") {
    return Token{ kind: TokenKind.FalseTok, start: start, end: lx.i }
  }
  if (word == "null") {
    return Token{ kind: TokenKind.NullTok, start: start, end: lx.i }
  }
  return Token{ kind: TokenKind.Invalid, start: start, end: lx.i }
}

// Skips JSON whitespace (RFC 8259 §2: space, tab, CR, LF) and dispatches one
// token from what follows, or `Eof` once the source is exhausted.
function scanToken(lx: Lexer): Token {
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
      lx.i = lx.i + 1
    } else if (c == '{') {
      return scanOpen(lx, TokenKind.LBrace)
    } else if (c == '}') {
      return scanClose(lx, TokenKind.RBrace)
    } else if (c == '[') {
      return scanOpen(lx, TokenKind.LBracket)
    } else if (c == ']') {
      return scanClose(lx, TokenKind.RBracket)
    } else if (c == ':') {
      return emit(lx, lx.i, 1, TokenKind.Colon)
    } else if (c == ',') {
      return emit(lx, lx.i, 1, TokenKind.Comma)
    } else if (c == '"') {
      return scanString(lx)
    } else if (isDigit(c) || c == '-') {
      return scanNumber(lx)
    } else if (isLower(c)) {
      return scanWord(lx)
    } else {
      return emit(lx, lx.i, 1, TokenKind.Invalid)
    }
  }
  return Token{ kind: TokenKind.Eof, start: lx.i, end: lx.i }
}

// The full token stream for `source`, ending with one `Eof`. Bounded by twice
// the byte length plus one guard slot: every token consumes at least one
// source byte (or is the terminal `Eof`), so the loop cannot outrun the
// input — a statically provable bound, not open-ended recursion.
export function lex(source: string): []Token {
  let lx = Lexer{ src: source, i: 0, depth: 0 }
  let toks = []Token(0)
  let guard = 0
  let bound = len(source) * 2 + 2
  while (guard <= bound) {
    let t = scanToken(lx)
    toks = append(toks, t)
    if (t.kind == TokenKind.Eof) {
      break
    }
    guard = guard + 1
  }
  return toks
}
