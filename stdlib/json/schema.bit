// Bit standard library — json module, JSON Schema for a `@json` class
// (#6161, the schema half of #3976/#3977's toJson/jsonDecode<T>).
//
//     let s = jsonSchema<User>()
//
// Same shape as `jsonDecode<T>` (stdlib/json/decode.bit): `T` is a different
// class at every call, so the compiler SPECIALISES this template per
// instantiation (compiler/classjsonschema.bit builds the fragment,
// compiler/classjsonschemacall.bit rewrites the call) rather than this body
// ever running for a program that compiles. `T` must carry `@json`; anything
// else is a compile-time error AT THE CALL (E0172, classjsonschemacall.bit) —
// the same shape as `jsonDecode<T>`'s own E0145 — never a runtime failure.
//
// The dialect is JSON Schema 2020-12 (SPEC "jsonSchema<T> - a JSON Schema
// for a `@json` class"), the exact dialect OpenAPI 3.1's Schema Object uses.
export fn jsonSchema<T>(): Json {
  panic("jsonSchema<T>: unreachable — every valid call is specialised at compile time")
}
