// Bit standard library — os module.
//
// Process-level surface: command-line arguments, environment variables,
// exit, and running a child process. Thin wrappers over the primitives in
// ABI.md §19.

// The number of command-line arguments, including the program name.
export fn argc(): int {
  return osArgc()
}

// Argument `i`, where `arg(0)` is the program as invoked. Out-of-range indices
// yield the empty string rather than panicking, so a missing argument reads the
// same as an empty one.
export fn arg(i: int): string {
  return osArgAt(i)
}

// Every command-line argument, `args()[0]` being the program name.
export fn args(): []string {
  let n = osArgc()
  let out = []string(0)
  let i = 0
  while (i < n) {
    out = append(out, osArgAt(i))
    i = i + 1
  }
  return out
}

// The value of environment variable `name`, or "" when it is unset. Bit has no
// nil string, so a variable set to "" and an unset one read the same here.
export fn env(name: string): string {
  return osEnv(name)
}

// The value of `name`, or `fallback` when it is unset (or set to "").
export fn envOr(name: string, fallback: string): string {
  let v = osEnv(name)
  if (len(v) == 0) {
    return fallback
  }
  return v
}

// The running executable's own absolute path, with symlinks resolved, or "" if
// the platform cannot report it. Resolving symlinks is what makes this usable
// for finding an install prefix: `bit` is installed as a bare symlink into
// PATH, and the symlink's own directory is not the install root.
//
// Prefer this over `arg(0)`, which is only what the caller passed — a bare
// name, a path relative to a cwd that may since have changed, or a lie.
export fn selfExe(): string {
  return osSelfExe()
}

// Terminate the process immediately with `code`. Deferred calls do not run.
export fn exit(code: int) {
  osExit(code)
}

// Run `path` as a child process with `args` as its argument vector — the
// runtime supplies `argv[0]` itself, so `args` holds arguments only, never
// the program name. The child is always exec'd directly, never through a
// shell, so nothing in `args` is ever reinterpreted as shell syntax. It
// inherits this process's environment and this process's stdout/stderr
// (nothing here redirects them). Returns the child's exit code, or -1 if it
// could not be spawned — `path` does not exist, is not executable, or the OS
// refused to fork.
//
// There is no way to capture the child's output through this module today —
// only its exit status. Capturing stdout/stderr requires redirecting the
// child's output through a pipe before exec, which needs new runtime
// primitives this module does not have yet; route it through a temp file and
// `readFile` in the meantime.
export fn run(path: string, args: []string): int {
  return osRun(path, args)
}
