// Bit standard library — os module: the user's home directory.
//
// `homeDir` follows the AWS SDKs' lookup (`getHomeDir` in
// `@smithy/shared-ini-file-loader`) so `~/.aws` resolves where the SDK's own
// tools find it: `HOME`, then `USERPROFILE`, then `HOMEDRIVE` + `HOMEPATH`,
// then the OS user database. Every path ends in a path or a `HomeDirError`;
// there is no silent empty string.

// The error `homeDir` fails with when no source names a home directory.
export class HomeDirError {
  export message(): string {
    return "homeDir: HOME, USERPROFILE and HOMEDRIVE+HOMEPATH are unset and the user database has no home for this user"
  }
}

// The home directory the environment names, or "" when it names none. An unset
// and an empty variable read the same (`env`). `HOMEPATH` without `HOMEDRIVE`
// is on the system drive, which Windows does not export separately: "C:".
fn homeFromEnv(home: string, userProfile: string, drive: string, path: string): string {
  if (len(home) > 0) {
    return home
  }
  if (len(userProfile) > 0) {
    return userProfile
  }
  if (len(path) == 0) {
    return ""
  }
  if (len(drive) == 0) {
    return "C:" + path
  }
  return drive + path
}

// The decimal number `s` spells, or -1 when `s` is empty, has a non-digit or
// is longer than 9 digits (an id never is).
fn parseId(s: string): int {
  if (len(s) == 0 || len(s) > 9) {
    return 0 - 1
  }
  let v = 0
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      return 0 - 1
    }
    v = v * 10 + i64(c - '0')
    i = i + 1
  }
  return v
}

// The real uid in a Linux `/proc/self/status` text (the first number on its
// "Uid:" line), or -1 when there is none.
fn procUid(status: string): int {
  let lines = split(status, "\n")
  let i = 0
  while (i < len(lines)) {
    if (hasPrefix(lines[i], "Uid:")) {
      let rest = trimSpace(lines[i][4:len(lines[i])])
      let end = indexOf(rest, "\t")
      if (end < 0) {
        end = len(rest)
      }
      return parseId(rest[0:end])
    }
    i = i + 1
  }
  return 0 - 1
}

// The home field of the `/etc/passwd` entry for `uid`, or for `name` when `uid`
// is negative. "" when no entry matches, the entry is malformed (fewer than 7
// fields) or its home is empty.
fn passwdHome(passwd: string, uid: int, name: string): string {
  let lines = split(passwd, "\n")
  let i = 0
  while (i < len(lines)) {
    let f = split(lines[i], ":")
    i = i + 1
    if (len(f) < 7 || hasPrefix(f[0], "#")) {
      continue
    }
    let hit = f[0] == name && len(name) > 0
    if (uid >= 0) {
      hit = parseId(f[2]) == uid
    }
    if (hit) {
      return f[5]
    }
  }
  return ""
}

// The home the OS user database holds for the running user: the Linux real uid
// against `/etc/passwd`, else the `USER`/`LOGNAME` name against it. "" when the
// files are absent (Windows, an empty container) or hold no entry.
fn userDbHome(): string {
  let pw = readFile("/etc/passwd") catch ""
  let status = readFile("/proc/self/status") catch ""
  return passwdHome(pw, procUid(status), envOr("USER", env("LOGNAME")))
}

// The current user's home directory. Fails with `HomeDirError` when neither the
// environment nor the user database names one.
export fn homeDir(): string! {
  let h = homeFromEnv(env("HOME"), env("USERPROFILE"), env("HOMEDRIVE"), env("HOMEPATH"))
  if (len(h) > 0) {
    return h
  }
  let d = userDbHome()
  if (len(d) > 0) {
    return d
  }
  fail HomeDirError{}
}
