// Bit standard library — os module: the local host name.
//
// `hostname` is `gethostname(2)` on Darwin, `uname(2)`'s `nodename` on Linux and
// `GetComputerNameExW(ComputerNameDnsHostname)` on Windows, behind one runtime
// primitive, `bit_rt_os_hostname` (ABI.md §19, #7192). §11.7 admits no `string`
// across an `extern fn`, so the primitive fills a caller-owned buffer and this
// file builds the string from the bytes it reports.

// `bit_rt_os_hostname(buf, room)`: writes the name NUL-terminated into `buf`'s
// `room` bytes and returns its length (always < `room`), or -1 when the call
// failed or the name plus its NUL does not fit. `buf` is the packed,
// one-byte-per-element backing store of a `[]byte` (§2). Darwin cannot tell a
// name of `room - 1` bytes from one it truncated and refuses that length too,
// so the buffer below has one byte more than POSIX `HOST_NAME_MAX` needs.
extern fn bit_rt_os_hostname(buf: *byte, room: int): int

// POSIX `HOST_NAME_MAX` (255), the terminating NUL and the spare byte above.
// Linux's own limit is 64 and Windows' DNS host label 63, so no real name is
// refused.
const hostnameRoom: int = 257

// The error `hostname` fails with.
export class HostnameError {
  export why: string = ""
  export message(): string {
    return "hostname: " + this.why
  }
}

// The name this machine calls itself, without a domain: what `hostname` prints
// on a shell. Fails with `HostnameError` when the OS cannot report it, when it
// is longer than 255 bytes (it is never returned truncated), or when it is
// empty, so a caller never holds a silent "".
export fn hostname(): string! {
  let buf = []byte(hostnameRoom)
  let n = bit_rt_os_hostname(ptrOf(buf), hostnameRoom)
  if (n < 0) {
    fail HostnameError{ why = "the OS did not report a name, or it is longer than 255 bytes" }
  }
  if (n == 0) {
    fail HostnameError{ why = "the OS reported an empty name" }
  }
  return string(buf[0:n])
}
