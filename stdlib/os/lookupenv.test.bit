test "lookupEnv agrees with the startup environment primitives" {
  let names = ["PATH", "HOME", "USERPROFILE", "BIT_TASK8538_MISSING", ""]
  for (let i = 0; i < len(names); i = i + 1) {
    let name = names[i]
    match (lookupEnv(name)) {
      None => assert(!osEnvPresent(name), "absent variable")
      Some(value) => {
        assert(osEnvPresent(name), "present variable")
        assert(value == osEnv(name), "startup value")
      }
    }
    let value = osEnv(name)
    assert(env(name) == value, "env compatibility")
    let fallback = len(value) == 0 ? "fallback" : value
    assert(envOr(name, "fallback") == fallback, "envOr compatibility")
  }
}
