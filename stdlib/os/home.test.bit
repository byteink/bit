// stdlib/os/home.test.bit — `homeDir` (#6577, home.bit).
//
// `std/os` has no `setEnv`, so the lookup order is tested on `homeFromEnv`, the
// pure function `homeDir` feeds `HOME`, `USERPROFILE`, `HOMEDRIVE` and
// `HOMEPATH` to, and the user database on `passwdHome`/`procUid`, which take
// the file text. `homeDir` itself runs against the live environment.

test "HOME wins over everything else" {
  assert(homeFromEnv("/home/a", "C:\\Users\\a", "D:", "\\x") == "/home/a", "HOME")
}

test "USERPROFILE is next when HOME is unset or empty" {
  assert(homeFromEnv("", "C:\\Users\\a", "D:", "\\x") == "C:\\Users\\a", "USERPROFILE")
}

test "HOMEDRIVE and HOMEPATH join when both profile variables are unset" {
  assert(homeFromEnv("", "", "D:", "\\Users\\a") == "D:\\Users\\a", "drive+path")
}

test "HOMEPATH alone is on the C: drive" {
  assert(homeFromEnv("", "", "", "\\Users\\a") == "C:\\Users\\a", "path only")
}

test "no variable names a home" {
  assert(homeFromEnv("", "", "D:", "") == "", "drive alone is not a home")
  assert(homeFromEnv("", "", "", "") == "", "all unset")
}

test "procUid reads the real uid off the Uid line" {
  let st = "Name:\tbit\nUmask:\t0022\nUid:\t1000\t1001\t1002\t1003\nGid:\t5\t5\t5\t5\n"
  assert(procUid(st) == 1000, "real uid")
  assert(procUid("Uid:\t0\t0\t0\t0\n") == 0, "root")
  assert(procUid("Name:\tbit\n") == 0 - 1, "no Uid line")
  assert(procUid("Uid:\tabc\t1\n") == 0 - 1, "non-numeric")
  assert(procUid("") == 0 - 1, "empty")
}

const pw: string = "# comment\nroot:x:0:0:root:/root:/bin/sh\nbit:x:1000:1000:Bit:/home/bit:/bin/bash\nnohome:x:7:7:n:::\nshort:x:8:8\n"

test "passwdHome matches by uid, and by name when the uid is unknown" {
  assert(passwdHome(pw, 1000, "") == "/home/bit", "uid 1000")
  assert(passwdHome(pw, 0, "bit") == "/root", "uid wins over name")
  assert(passwdHome(pw, 0 - 1, "bit") == "/home/bit", "by name")
  assert(passwdHome(pw, 0 - 1, "") == "", "no uid and no name")
}

test "passwdHome yields nothing for a missing, empty or malformed entry" {
  assert(passwdHome(pw, 4242, "") == "", "unknown uid")
  assert(passwdHome(pw, 0 - 1, "ghost") == "", "unknown name")
  assert(passwdHome(pw, 7, "") == "", "empty home field")
  assert(passwdHome(pw, 8, "") == "", "short entry")
  assert(passwdHome("", 0, "root") == "", "empty file")
}

test "homeDir returns a non-empty path or a HomeDirError" {
  let h = homeDir() catch e {
    assert(e.message() != "", "error has a message")
    let he = e.(HomeDirError)
    assert(he.message() == e.message(), "typed")
    return
  }
  assert(len(h) > 0, "homeDir returned an empty string")
  if (len(env("HOME")) > 0) {
    assert(h == env("HOME"), "HOME is honoured")
  }
}
