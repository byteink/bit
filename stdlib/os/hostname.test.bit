// stdlib/os/hostname.test.bit — `hostname` (#7192, hostname.bit).
//
// The live call is the only source of truth for the name, so the tests pin what
// every OS shares: a non-empty answer with no NUL and no whitespace in it, and
// the error's text. The primitive's own contract (NUL-terminated, never
// truncated) is pinned by `hostname` returning the whole name or an error.

test "hostname is a non-empty name" {
  let h = hostname() catch e {
    assert(false, e.(HostnameError).message())
    return
  }
  assert(len(h) > 0, "empty")
  assert(len(h) <= 255, "longer than HOST_NAME_MAX")
}

test "hostname holds no NUL and no whitespace" {
  let h = hostname() catch _ {
    return
  }
  for c of []byte(h) {
    assert(c > 32 && c < 127, "control, space, NUL or non-ASCII byte in the name")
  }
}

test "hostname is the same on a second call" {
  let a = hostname() catch _ {
    return
  }
  let b = hostname() catch _ {
    return
  }
  assert(a == b, "differs")
}

test "HostnameError says what failed" {
  let e = HostnameError{ why = "the OS reported an empty name" }
  assert(e.message() == "hostname: the OS reported an empty name", e.message())
}
