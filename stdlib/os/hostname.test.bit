// stdlib/os/hostname.test.bit — `bit_rt_os_hostname` (ABI.md §19, #7192).
//
// The primitive is declared HERE, not in `stdlib/os`, until the stage0 pin
// carries it: `tools/build` imports `std/os`, and the pinned stage0 checks
// every `extern fn` a module declares against ITS OWN archive (E0078), so
// `hostname()` in `os.bit` cannot land first. This test links the symbol on
// every target the runtime ships, which is what makes a missing provider fail
// a gate instead of a user's program.

extern fn bit_rt_os_hostname(buf: *byte, room: int): int

// The name the primitive reports into a `room`-byte buffer, or "" on -1 / empty.
fn rawHost(room: int): string {
  let buf = []byte(room)
  let n = bit_rt_os_hostname(ptrOf(buf), room)
  if (n <= 0) {
    return ""
  }
  return string(buf[0:n])
}

test "the primitive reports a non-empty name" {
  let h = rawHost(256)
  assert(len(h) > 0, "empty or failed")
  assert(len(h) < 256, "longer than HOST_NAME_MAX")
}

test "the name holds no NUL, whitespace or control byte" {
  for c of []byte(rawHost(256)) {
    assert(c > 32 && c < 127, "control, space or non-ASCII byte in the name")
  }
}

test "the name is NUL-terminated inside the buffer" {
  let buf = []byte(256)
  let n = bit_rt_os_hostname(ptrOf(buf), 256)
  assert(n > 0 && n < 256, "length")
  assert(buf[n] == 0, "no NUL after the name")
}

test "a buffer too small for the name and its NUL is refused, never truncated" {
  let h = rawHost(256)
  assert(len(h) > 0, "no name")
  assert(rawHost(len(h)) == "", "room == len: no room for the NUL")
  assert(rawHost(len(h) + 2) == h, "room == len + 2 fits on every OS")
  assert(rawHost(1) == "", "room 1")
}

test "two calls agree" {
  assert(rawHost(256) == rawHost(256), "differs")
}
