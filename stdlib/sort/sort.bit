// Bit standard library — sort module.
//
// Comparator-based sorting over slices (`[]T`). There is no `Ord` bound in
// this language (#2136), so every function here takes an explicit `less`
// callback instead of relying on a built-in ordering — the same shape as
// `seq`'s `filter`/`reduce`. The sort itself is an ITERATIVE bottom-up merge
// sort (#2102: a recursive generic merge sort does not lower): it merges
// runs of width 1, 2, 4, 8... using one scratch buffer of length `len(xs)`,
// reused for every merge, until the width covers the whole slice. It is
// STABLE — two elements for which neither `less(a,b)` nor `less(b,a)` holds
// keep their original relative order — which the caller cannot tell from the
// signature, so it is recorded here rather than left implicit.

// One merge's bounds into `xs`/`scratch`: the left run is `[lo, mid)`, the
// right run is `[mid, hi)`. Grouped into a struct so `mergeRuns` stays under
// the five-parameter lint limit (E0202).
struct mergeSpan { lo: int, mid: int, hi: int }

// Sorts `xs` in place with `less` as the ordering. STABLE: equal elements
// keep their input order. O(n log n) time, O(n) extra space for the one
// scratch buffer.
export fn sortInPlace<T>(xs: []T, less: (T, T) => bool) {
  let n = len(xs)
  if (n < 2) {
    return
  }
  let scratch: []T = []T(n)
  let width = 1
  while (width < n) {
    let lo = 0
    while (lo < n) {
      let mid = lo + width
      if (mid > n) {
        mid = n
      }
      let hi = lo + 2 * width
      if (hi > n) {
        hi = n
      }
      mergeRuns(xs, scratch, mergeSpan{ lo: lo, mid: mid, hi: hi }, less)
      lo = lo + 2 * width
    }
    width = width * 2
  }
}

// Merges the two already-sorted runs `xs[span.lo:span.mid]` and
// `xs[span.mid:span.hi]` into `scratch[span.lo:span.hi]`, then copies the
// merged result back into `xs[span.lo:span.hi]`. Taking from the left run on
// a tie (`!less(xs[b], xs[a])`) is what makes the sort stable: an element
// already at or before `a` never moves past an equal element that started
// after it.
fn mergeRuns<T>(xs: []T, scratch: []T, span: mergeSpan, less: (T, T) => bool) {
  let a = span.lo
  let b = span.mid
  let k = span.lo
  while (a < span.mid && b < span.hi) {
    if (less(xs[b], xs[a])) {
      scratch[k] = xs[b]
      b = b + 1
    } else {
      scratch[k] = xs[a]
      a = a + 1
    }
    k = k + 1
  }
  while (a < span.mid) {
    scratch[k] = xs[a]
    a = a + 1
    k = k + 1
  }
  while (b < span.hi) {
    scratch[k] = xs[b]
    b = b + 1
    k = k + 1
  }
  let j = span.lo
  while (j < span.hi) {
    xs[j] = scratch[j]
    j = j + 1
  }
}

// A new slice holding a sorted copy of `xs`; `xs` itself is left unmodified.
// Copies element by element into a fresh, sized allocation — never via
// `append`, which can grow in place and alias its argument's backing store —
// before sorting the copy with `sortInPlace`.
export fn sorted<T>(xs: []T, less: (T, T) => bool): []T {
  let n = len(xs)
  let out: []T = []T(n)
  let i = 0
  while (i < n) {
    out[i] = xs[i]
    i = i + 1
  }
  sortInPlace(out, less)
  return out
}

// Whether `xs` is sorted under `less`: `false` as soon as
// `less(xs[i], xs[i-1])` holds for some `i` from 1 to `len(xs)-1`; `true`
// otherwise. An empty slice and a one-element slice are always sorted.
export fn isSorted<T>(xs: []T, less: (T, T) => bool): bool {
  let n = len(xs)
  let i = 1
  while (i < n) {
    if (less(xs[i], xs[i - 1])) {
      return false
    }
    i = i + 1
  }
  return true
}
