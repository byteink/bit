// Bit standard library — sort module.
//
// Comparator-based sorting over slices (`[]T`). There is no `Ord` bound in
// this language (#2136), so every function here takes an explicit `less`
// callback instead of relying on a built-in ordering — the same shape as
// `seq`'s `filter`/`reduce`. The sort itself is an ITERATIVE bottom-up merge
// sort (#2102: a recursive generic merge sort does not lower): it merges
// runs of width 1, 2, 4, 8... between `xs` and one scratch buffer of length
// `len(xs)`, swapping the two after every level, until the width covers the
// whole slice. It is
// STABLE — two elements for which neither `less(a,b)` nor `less(b,a)` holds
// keep their original relative order — which the caller cannot tell from the
// signature, so it is recorded here rather than left implicit.

// Sorts `xs` in place with `less` as the ordering. STABLE: equal elements
// keep their input order. O(n log n) time, O(n) extra space for the one
// scratch buffer.
export fn sortInPlace<T>(xs: []T, less: (T, T) => bool) {
  let n = len(xs)
  if (n < 2) {
    return
  }
  let scratch: []T = []T(n)
  // Level k merges `src` into `dst`, then the two swap, so a merged element
  // is written once per level instead of once into the scratch and again
  // back into `xs`. `flipped` tracks which of the two holds the merged
  // result: after an odd number of levels that is `scratch`, and the one
  // final copy below puts it back in `xs`.
  let src = xs
  let dst = scratch
  let flipped = false
  let width = 1
  while (width < n) {
    let lo = 0
    while (lo < n) {
      mergeRuns(src, dst, lo, width, less)
      lo = lo + 2 * width
    }
    let tmp = src
    src = dst
    dst = tmp
    flipped = !flipped
    width = width * 2
  }
  if (flipped) {
    let j = 0
    while (j < n) {
      xs[j] = src[j]
      j = j + 1
    }
  }
}

// Merges the two already-sorted runs `src[lo, lo+width)` and
// `src[lo+width, lo+2*width)` — clamped to `len(src)`, since the last pair
// of runs in a pass is usually short — into `dst` at the same positions.
// `dst` is never read here and `src` is never written, so the caller can
// swap the two after every level. A final lone run (`lo+width >= len(src)`)
// still falls through the drain loop below, which is what keeps `dst`
// complete over `[0, n)` for the next level. `mid`/`hi` are recomputed
// here rather than passed in: they are fully determined by `lo`, `width` and
// `len(src)`, and folding them in keeps this at 5 parameters (E0202's limit)
// without boxing them into a class — a class is a heap allocation (SPEC
// 13.3), and this function runs n-1 times per sort.
//
// Taking from the left run on a tie (`!less(src[b], src[a])`) is what makes
// the sort stable: an element already at or before `a` never moves past an
// equal element that started after it.
fn mergeRuns<T>(src: []T, dst: []T, lo: int, width: int, less: (T, T) => bool) {
  let n = len(src)
  let mid = lo + width
  if (mid > n) {
    mid = n
  }
  let hi = lo + 2 * width
  if (hi > n) {
    hi = n
  }
  let a = lo
  let b = mid
  let k = lo
  while (a < mid && b < hi) {
    if (less(src[b], src[a])) {
      dst[k] = src[b]
      b = b + 1
    } else {
      dst[k] = src[a]
      a = a + 1
    }
    k = k + 1
  }
  while (a < mid) {
    dst[k] = src[a]
    a = a + 1
    k = k + 1
  }
  while (b < hi) {
    dst[k] = src[b]
    b = b + 1
    k = k + 1
  }
}

// A new slice holding a sorted copy of `xs`; `xs` itself is left unmodified.
// Copies element by element into a fresh, sized allocation — never via
// `append`, which can grow in place and alias its argument's backing store —
// before sorting the copy with `sortInPlace`.
export fn sorted<T>(xs: []T, less: (T, T) => bool): []T {
  let n = len(xs)
  let out: []T = []T(n)
  let i = 0
  while (i < n) {
    out[i] = xs[i]
    i = i + 1
  }
  sortInPlace(out, less)
  return out
}

// Whether `xs` is sorted under `less`: `false` as soon as
// `less(xs[i], xs[i-1])` holds for some `i` from 1 to `len(xs)-1`; `true`
// otherwise. An empty slice and a one-element slice are always sorted.
export fn isSorted<T>(xs: []T, less: (T, T) => bool): bool {
  let n = len(xs)
  let i = 1
  while (i < n) {
    if (less(xs[i], xs[i - 1])) {
      return false
    }
    i = i + 1
  }
  return true
}
