// Bit standard library — smtp module: MIME body construction (#3967).
//
// One rule decides every text transfer encoding here: a part is sent as `7bit`
// only when its own bytes prove it can be. "Prove" means every byte is
// printable ASCII (tab, CR and LF excepted) AND no line reaches the 998-octet
// ceiling with room for the DATA dot-stuffing byte. Otherwise it is
// quoted-printable when that is no larger than base64, else base64 (#6862): an
// English mail with one curly quote stays readable, an all-Arabic one is
// smaller as base64. That is why a 1200-character body line is wrapped instead
// of being sent whole and refused by the server — and why it is a property of
// the data rather than a flag a caller can get wrong. Attachments are base64
// always.
//
// `checkLines` is the backstop: `Message.render` runs it over the finished
// message, so a line over the limit fails the render whatever produced it.

import { Builder } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

// The body shapes, chosen by `shapeOf` from what the message carries. No empty
// wrappers: a text-only mail is a bare `text/plain`, not a `multipart/mixed`
// holding one part.
const shapeText: int = 0
const shapeAlternative: int = 1
const shapeMixed: int = 2

// Base64 line width for a MIME part. RFC 2045 §6.8's ceiling is 76.
const base64Width: int = 76

// The three `Content-Transfer-Encoding` values a text part can take.
const enc7bit: string = "7bit"
const encQuotedPrintable: string = "quoted-printable"
const encBase64: string = "base64"

// The longest body line that may be sent as-is. One octet under
// `maxLineOctets`, because DATA dot-stuffing (wire.bit) prepends a `.` to a
// line that already starts with one; at exactly 998 that byte would push the
// transmitted line over.
const maxBodyLineOctets: int = 997

// Which of the three shapes `m` renders as.
fn shapeOf(m: Message): int {
  if (len(m.files) > 0) {
    return shapeMixed
  }
  if (hasAlternatives(m)) {
    return shapeAlternative
  }
  return shapeText
}

// Whether `m` carries anything beside its text part to put in a
// `multipart/alternative`: HTML or an `addAlternative` part.
fn hasAlternatives(m: Message): bool {
  return len(m.html) > 0 || len(m.altTypes) > 0
}

// Whether `c` is an RFC 2045 `token` character: printable ASCII other than
// space and the `tspecials` `()<>@,;:\"/[]?=`.
fn isTokenChar(c: u8): bool {
  if (c <= u8(32) || c >= u8(127)) {
    return false
  }
  let specials = "()<>@,;:\\\"/[]?="
  let i = 0
  while (i < len(specials)) {
    if (specials[i] == c) {
      return false
    }
    i = i + 1
  }
  return true
}

// The end of the token starting at `at`; `at` itself when there is none.
fn tokenEnd(s: string, at: int): int {
  let i = at
  while (i < len(s) && isTokenChar(s[i])) {
    i = i + 1
  }
  return i
}

// The end, past the closing quote, of the quoted-string starting at `at`, or
// -1 when it is not one: unterminated, or holding a control or non-ASCII byte.
fn quotedEnd(s: string, at: int): int {
  let i = at + 1
  while (i < len(s)) {
    let c = s[i]
    if (c == u8(34)) {
      return i + 1
    }
    if (c == u8(92)) {
      i = i + 1
    }
    if (i >= len(s) || s[i] >= u8(127) || (s[i] < u8(32) && s[i] != u8(9))) {
      return -1
    }
    i = i + 1
  }
  return -1
}

// The end of the `; name=value` parameter whose `;` is at `at`, or -1 when it
// is malformed: a token name, `=`, then a token or a quoted-string.
fn paramEnd(s: string, at: int): int {
  let i = at + 1
  while (i < len(s) && (s[i] == u8(32) || s[i] == u8(9))) {
    i = i + 1
  }
  let nameEnd = tokenEnd(s, i)
  if (nameEnd == i || nameEnd >= len(s) || s[nameEnd] != u8(61)) {
    return -1
  }
  let v = nameEnd + 1
  if (v < len(s) && s[v] == u8(34)) {
    return quotedEnd(s, v)
  }
  let end = tokenEnd(s, v)
  if (end == v) {
    return -1
  }
  return end
}

// Whether `s` from `at` on is zero or more `; name=value` parameters, each
// preceded by optional blanks, and nothing else.
fn paramsValid(s: string, at: int): bool {
  let i = at
  while (i < len(s)) {
    while (i < len(s) && (s[i] == u8(32) || s[i] == u8(9))) {
      i = i + 1
    }
    if (i == len(s)) {
      return true
    }
    if (s[i] != u8(59)) {
      return false
    }
    i = paramEnd(s, i)
    if (i < 0) {
      return false
    }
  }
  return true
}

// Whether `ct` is `type/subtype` followed by zero or more `; name=value`
// parameters, and names none of the types that have a setter of their own. The
// token and quoted-string checks also refuse a CR, LF or NUL, so nothing that
// passes can end the header line.
fn isAlternativeType(ct: string): bool {
  let slash = tokenEnd(ct, 0)
  if (slash == 0 || slash >= len(ct) || ct[slash] != u8(47)) {
    return false
  }
  let subEnd = tokenEnd(ct, slash + 1)
  if (subEnd == slash + 1) {
    return false
  }
  let kind = toLower(ct[0:subEnd])
  if (hasPrefix(kind, "multipart/") || kind == "text/plain" || kind == "text/html") {
    return false
  }
  return paramsValid(ct, subEnd)
}

// Refuse a message whose `addAlternative` content type is not allowed.
fn checkAlternatives(m: Message): ()!SmtpError {
  let i = 0
  while (i < len(m.altTypes)) {
    if (!isAlternativeType(m.altTypes[i])) {
      fail localError("'${m.altTypes[i]}' is not allowed as an alternative part")
    }
    i = i + 1
  }
}

// A fresh MIME boundary. Random (UUIDv4), not derived from the content: a
// boundary computed from the parts is one an attacker who controls a part can
// reproduce and embed, which splits the message where the sender did not.
fn defaultBoundary(): string {
  return "=_bit_${uuidFormat(uuidV4())}"
}

// Whether `b` is a legal boundary: 1..70 characters of the RFC 2046 §5.1.1
// `bchars` set, not ending in a space. Checked because `setBoundary` is public.
fn isBoundary(b: string): bool {
  if (len(b) == 0 || len(b) > 70 || b[len(b) - 1] == u8(32)) {
    return false
  }
  let i = 0
  while (i < len(b)) {
    if (!isBoundaryChar(b[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

// One `bchars` character: alphanumerics and `'()+_,-./:=? ` (RFC 2046 §5.1.1).
fn isBoundaryChar(c: u8): bool {
  if (c >= u8(48) && c <= u8(57)) {
    return true
  }
  if (c >= u8(65) && c <= u8(90)) {
    return true
  }
  if (c >= u8(97) && c <= u8(122)) {
    return true
  }
  let punct = "'()+_,-./:=? "
  let i = 0
  while (i < len(punct)) {
    if (punct[i] == c) {
      return true
    }
    i = i + 1
  }
  return false
}

// `s` with every line ending normalised to CRLF: a bare LF and a bare CR both
// become one CRLF, an existing CRLF is left alone. A body reaching DATA with a
// bare LF is not a message the server sees the same way the sender wrote it.
fn toCrlf(s: string): string {
  let b = Builder()
  let i = 0
  while (i < len(s)) {
    if (s[i] == u8(13)) {
      let _ = b.write("\r\n")
      if (i + 1 < len(s) && s[i + 1] == u8(10)) {
        i = i + 1
      }
    } else if (s[i] == u8(10)) {
      let _ = b.write("\r\n")
    } else {
      let _ = b.writeByte(s[i])
    }
    i = i + 1
  }
  return b.toString()
}

// Whether `s` can be transmitted as `7bit`: printable ASCII (tab/CR/LF
// allowed) with every line inside `maxBodyLineOctets`. Anything else is base64.
fn is7bit(s: string): bool {
  let run = 0
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == u8(10) || c == u8(13)) {
      run = 0
    } else {
      run = run + 1
    }
    if (run > maxBodyLineOctets) {
      return false
    }
    if (c >= u8(127) || (c < u8(32) && c != u8(9) && c != u8(10) && c != u8(13))) {
      return false
    }
    i = i + 1
  }
  return true
}

// `b` as base64 broken into `base64Width`-character CRLF-terminated lines, so
// no line of an encoded part can approach the 998-octet ceiling.
fn wrapBase64(b: []byte): string {
  let enc = encodeBase64(b)
  let out = ""
  let i = 0
  while (i < len(enc)) {
    let end = i + base64Width
    if (end > len(enc)) {
      end = len(enc)
    }
    out = out + enc[i:end] + "\r\n"
    i = end
  }
  return out
}

// The base64 text `wrapBase64` makes of `n` bytes, in octets: four characters
// per started group of three, plus a CRLF after every started 76.
fn base64Size(n: int): int {
  let chars = (n + 2) / 3 * 4
  return chars + (chars + base64Width - 1) / base64Width * 2
}

// A text part as it is sent: the `Content-Transfer-Encoding` value and the
// body in that encoding. One value because the header is a claim about the
// body, and computing the two apart encoded the text more than once.
class TextPart {
  enc: string,
  body: string,
}

// `s` as a text part: `7bit` when its bytes prove it safe, else quoted-printable
// if that is no larger than base64, else base64. Decided from the bytes alone,
// so the same text always renders the same way. The quoted-printable text is
// built to compare its size and is the body when it wins.
fn encodeText(s: string): TextPart {
  if (is7bit(s)) {
    return TextPart{ enc = enc7bit, body = toCrlf(s) }
  }
  let qp = qpEncode(s)
  if (len(qp) <= base64Size(len(s))) {
    return TextPart{ enc = encQuotedPrintable, body = qp }
  }
  return TextPart{ enc = encBase64, body = wrapBase64([]byte(s)) }
}

// The transfer encoding `encodeText` chooses for `s`.
fn textEncoding(s: string): string {
  return encodeText(s).enc
}

// One body part: its `Content-Type`/`Content-Transfer-Encoding` headers, a
// blank line, and the encoded content. `extra` carries a part's own extra
// header lines (an attachment's `Content-Disposition`), already CRLF-terminated.
fn renderPart(contentType: string, extra: string, content: string): string {
  let t = encodeText(content)
  return "Content-Type: ${contentType}\r\n" +
    "Content-Transfer-Encoding: ${t.enc}\r\n${extra}\r\n" +
    t.body
}

// An attachment part: base64 always — an attachment is opaque bytes, and
// choosing an encoding from a sample of them is how a binary file arrives
// corrupted.
fn renderAttachment(a: Attachment): string!SmtpError {
  checkHeaderValue("Content-Disposition filename", a.filename)?
  let ct = a.contentType
  if (len(ct) == 0) {
    ct = "application/octet-stream"
  }
  checkHeaderValue("Content-Type", ct)?
  let param = encodeParam("filename", a.filename)
  let nameParam = encodeParam("name", a.filename)
  return renderParamHeader("Content-Type", ct, nameParam) +
    "Content-Transfer-Encoding: base64\r\n" +
    renderParamHeader("Content-Disposition", "attachment", param) +
    "\r\n" +
    wrapBase64(a.data)
}

// The `text/plain` (+ `text/html`, + `addAlternative`) content of a message,
// without the outer `multipart/mixed` wrapper, the extra parts last and in call
// order. `inner` is the boundary the alternative uses, which is the mixed
// boundary with a suffix so the two never collide.
fn textualBody(m: Message, inner: string): string {
  if (!hasAlternatives(m)) {
    return encodeText(m.text).body
  }
  let out = "--${inner}\r\n" + renderPart("text/plain; charset=utf-8", "", m.text)
  if (len(m.html) > 0) {
    out = out + "\r\n--${inner}\r\n" + renderPart("text/html; charset=utf-8", "", m.html)
  }
  let i = 0
  while (i < len(m.altTypes)) {
    out = out + "\r\n--${inner}\r\n" + renderPart(m.altTypes[i], "", m.altBodies[i])
    i = i + 1
  }
  return out + "\r\n--${inner}--\r\n"
}

// A message's body block with the `Content-*` header lines that describe it,
// built together so a text-only message encodes its text once.
class Body {
  headers: string,
  block: string,
}

// The body of `m`: the `Content-Type` (and, for a bare text part,
// `Content-Transfer-Encoding`) lines for the message as a whole, and the part
// after the header block's blank line, matching `shapeOf`.
fn bodyOf(m: Message): Body!SmtpError {
  checkAlternatives(m)?
  let shape = shapeOf(m)
  if (shape == shapeText) {
    let t = encodeText(m.text)
    return Body{
      headers = "Content-Type: text/plain; charset=utf-8\r\n" +
        "Content-Transfer-Encoding: ${t.enc}\r\n",
      block = t.body,
    }
  }
  if (shape == shapeAlternative) {
    return Body{
      headers = "Content-Type: multipart/alternative; boundary=\"${m.boundary}\"\r\n",
      block = textualBody(m, m.boundary),
    }
  }
  return Body{
    headers = "Content-Type: multipart/mixed; boundary=\"${m.boundary}\"\r\n",
    block = mixedBody(m, m.boundary + "_alt")?,
  }
}

// The `multipart/mixed` body: the textual part (itself a `multipart/
// alternative` when there is HTML) followed by one part per attachment.
fn mixedBody(m: Message, inner: string): string!SmtpError {
  let out = "--${m.boundary}\r\n"
  if (!hasAlternatives(m)) {
    out = out + renderPart("text/plain; charset=utf-8", "", m.text)
  } else {
    out = out +
      "Content-Type: multipart/alternative; boundary=\"${inner}\"\r\n\r\n" +
      textualBody(m, inner)
  }
  let i = 0
  while (i < len(m.files)) {
    out = out + "\r\n--${m.boundary}\r\n" + renderAttachment(m.files[i])?
    i = i + 1
  }
  return out + "\r\n--${m.boundary}--\r\n"
}

// Refuse a message carrying a line at or over `maxLineOctets`. The backstop
// behind every encoding decision above: whatever produced the line — a header
// folder that did not fold, a caller-supplied boundary, a future part type —
// the message fails here rather than on the wire.
fn checkLines(msg: string): ()!SmtpError {
  let run = 0
  let i = 0
  while (i < len(msg)) {
    if (msg[i] == u8(10) || msg[i] == u8(13)) {
      run = 0
    } else {
      run = run + 1
    }
    if (run > maxBodyLineOctets) {
      fail localError("message has a line over ${maxBodyLineOctets} octets")
    }
    i = i + 1
  }
}
