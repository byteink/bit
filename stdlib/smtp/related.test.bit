// stdlib/smtp/related.test.bit — inline parts in multipart/related (#6863).
//
// The assertions are about BYTES: the rendered message. `plainMessage` is a
// module sibling in smtp.test.bit.

import { contains, indexOf as strIndexOf, repeat, split } from "std/strings"

const logoHtml: string = "<p>Thanks.</p><img src=\"cid:logo@inkwell\">\r\n"
const noHtmlError: string = "smtp: an inline part needs an HTML body"

// The `render()` text of `m`, failing the test when it does not render.
fn relRender(m: Message): string {
  return m.render() catch e {
    assert(false, "render: ${e.message()}")
    return ""
  }
}

// A message with text, HTML and one inline `logo@inkwell` image.
fn logoMessage(): Message {
  let m = plainMessage()
  m.setHtml(logoHtml)
  m.addInline(Attachment("logo.png", "image/png", []byte("PNGDATA")), "logo@inkwell")
  return m
}

// A message with text, HTML and one inline image under `id`.
fn idMessage(id: string): Message {
  let m = plainMessage()
  m.setHtml("<p>x</p>")
  m.addInline(Attachment("l.png", "image/png", []byte("x")), id)
  return m
}

// The error text `m.render()` fails with, failing the test when it renders.
fn relError(m: Message): string {
  let out = m.render() catch e {
    return e.message()
  }
  assert(false, "rendered ${len(out)} bytes instead of failing")
  return ""
}

test "text, html and an inline image nest related inside alternative" {
  let r = relRender(logoMessage())
  assert(
    contains(r, "Content-Type: multipart/alternative; boundary=\"bit-test-boundary\"\r\n"),
    "not a multipart/alternative: ${r}",
  )
  let plain = strIndexOf(r, "Content-Type: text/plain; charset=utf-8")
  let rel = strIndexOf(
    r,
    "Content-Type: multipart/related; type=\"text/html\"; boundary=\"bit-test-boundary_rel\"\r\n",
  )
  let html = strIndexOf(r, "Content-Type: text/html; charset=utf-8")
  let img = strIndexOf(r, "Content-Type: image/png; name=\"logo.png\"\r\n")
  assert(plain > 0 && rel > plain, "related does not follow the text part")
  assert(html > rel && img > html, "html is not the first related part, image second: ${r}")
  assert(contains(r, "Content-ID: <logo@inkwell>\r\n"), "no Content-ID")
  assert(contains(r, "Content-Disposition: inline; filename=\"logo.png\"\r\n"), "not inline")
  assert(contains(r, "Content-Transfer-Encoding: base64\r\n"), "not base64")
  assert(contains(r, "UE5HREFUQQ==\r\n"), "the image bytes are not base64")
  assert(
    contains(r, "\r\n--bit-test-boundary_rel--\r\n\r\n--bit-test-boundary--\r\n"),
    "related is not closed before the alternative",
  )
  assert(!contains(r, "attachment"), "an attachment appeared from nowhere")
}

test "an attachment wraps related and alternative in mixed" {
  let m = logoMessage()
  m.attach(Attachment("a.txt", "text/plain", []byte("x")))
  let r = relRender(m)
  let mixed = strIndexOf(r, "Content-Type: multipart/mixed; boundary=\"bit-test-boundary\"\r\n")
  let alt = strIndexOf(r, "Content-Type: multipart/alternative; boundary=\"bit-test-boundary_alt\"")
  let rel = strIndexOf(
    r,
    "multipart/related; type=\"text/html\"; boundary=\"bit-test-boundary_rel\"",
  )
  let cid = strIndexOf(r, "Content-ID: <logo@inkwell>")
  let file = strIndexOf(r, "Content-Disposition: attachment; filename=\"a.txt\"")
  assert(mixed >= 0 && alt > mixed && rel > alt && cid > rel && file > cid, "wrong nesting: ${r}")
}

test "extra alternatives follow the related part" {
  let m = logoMessage()
  m.addAlternative("text/calendar; method=REQUEST", "BEGIN:VCALENDAR\r\n")
  let r = relRender(m)
  let relEnd = strIndexOf(r, "--bit-test-boundary_rel--")
  let cal = strIndexOf(r, "Content-Type: text/calendar")
  assert(relEnd > 0 && cal > relEnd, "calendar part is not after the related part")
}

test "two inline parts keep call order and each has its Content-ID" {
  let m = logoMessage()
  m.addInline(Attachment("b.gif", "image/gif", []byte("G")), "banner.1@inkwell")
  let r = relRender(m)
  let a = strIndexOf(r, "Content-ID: <logo@inkwell>")
  let b = strIndexOf(r, "Content-ID: <banner.1@inkwell>")
  assert(a > 0 && b > a, "inline parts are not in call order")
}

test "a content id without an at sign is a valid dot-atom" {
  let m = plainMessage()
  m.setHtml("<img src=\"cid:logo\">")
  m.addInline(Attachment("l.png", "", []byte("x")), "logo")
  let r = relRender(m)
  assert(contains(r, "Content-ID: <logo>\r\n"), "no bare Content-ID")
  assert(contains(r, "Content-Type: application/octet-stream; name=\"l.png\""), "no default type")
}

test "an inline part with no HTML body fails render" {
  let m = plainMessage()
  m.addInline(Attachment("logo.png", "image/png", []byte("x")), "logo@inkwell")
  assert(relError(m) == noHtmlError, "wrong error: ${relError(m)}")
}

test "an inline part beside only an alternative part still needs HTML" {
  let m = plainMessage()
  m.addAlternative("text/calendar", "x\r\n")
  m.addInline(Attachment("logo.png", "image/png", []byte("x")), "logo@inkwell")
  assert(relError(m) == noHtmlError, "wrong error: ${relError(m)}")
}

test "a duplicate content id fails render" {
  let m = logoMessage()
  m.addInline(Attachment("two.png", "image/png", []byte("y")), "logo@inkwell")
  assert(relError(m) == "smtp: duplicate Content-ID 'logo@inkwell'", "wrong error: ${relError(m)}")
}

test "a malformed content id fails render" {
  let bad = [
    "a b", "", "@inkwell", "logo@", "a@b@c", ".a@b", "a.@b", "a..b@c", "a@b..c", "<a@b>",
    "a\r\nBcc: x@evil.example", "a\nb@c", "a\u{0}b@c", "café@inkwell", "a@b c",
    repeat("x", 243) + "@inkwell",
  ]
  let i = 0
  while (i < len(bad)) {
    let msg = relError(idMessage(bad[i]))
    assert(msg == "smtp: '${bad[i]}' is not a valid Content-ID", "wrong error, case ${i}: ${msg}")
    i = i + 1
  }
}

test "a content id of exactly 250 octets is accepted" {
  let id = repeat("x", 242) + "@inkwell"
  assert(len(id) == 250, "the fixture is ${len(id)} octets")
  assert(contains(relRender(idMessage(id)), "Content-ID: <${id}>\r\n"), "250 octets refused")
}

test "a large inline image is wrapped and no line reaches 998 octets" {
  let m = plainMessage()
  m.setHtml(logoHtml)
  m.addInline(Attachment("big.bin", "image/png", []byte(repeat("z", 5000))), "logo@inkwell")
  let longest = longestLine(split(relRender(m), "\r\n"))
  assert(longest < 998, "a rendered line has ${longest} octets")
}

test "a non-ASCII inline filename is encoded like an attachment's" {
  let m = plainMessage()
  m.setHtml(logoHtml)
  m.addInline(Attachment("logo é.png", "image/png", []byte("x")), "logo@inkwell")
  let r = relRender(m)
  assert(contains(r, "filename*=utf-8''logo%20%C3%A9.png"), "filename not RFC 2231 encoded: ${r}")
}
