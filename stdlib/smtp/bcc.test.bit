// stdlib/smtp/bcc.test.bit — blind and reply-to recipients (#6860).
//
// The assertions are about BYTES: the rendered message and the transcript the
// fake server in smtp.test.bit recorded. The fake server, `plainMessage` and
// `runPlainSession` are module siblings, so nothing here redefines them.

import { contains, indexOf as strIndexOf, split, toLower } from "std/strings"

// A message with one visible recipient and one blind one, the blind one with a
// display name so a leak through `formatAddress` would show too.
fn bccMessage(): Message {
  let m = plainMessage()
  m.addBcc(Address{ name = "Auditor", email = "auditor@hidden.example" })
  return m
}

test "a Bcc recipient gets RCPT TO and appears nowhere in the rendered bytes" {
  let rendered = bccMessage().render() catch e {
    assert(false, "render: ${e.message()}")
    return
  }
  let lower = toLower(rendered)
  assert(!contains(lower, "bcc"), "a Bcc header was rendered: ${rendered}")
  assert(!contains(rendered, "hidden.example"), "the Bcc address reached the bytes: ${rendered}")
  assert(!contains(rendered, "Auditor"), "the Bcc name reached the bytes: ${rendered}")
  assert(contains(rendered, "To: <customer@example.net>\r\n"), "the To header was lost")
  let (port, log) = startFake(
    [
      ehloPlain(), "250 OK\r\n", "250 OK\r\n", "250 OK\r\n", "354 Send it\r\n",
      "250 Queued\r\n", "221 Bye\r\n",
    ],
  ) catch e {
    assert(false, "startFake: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  runPlainSession(c, bccMessage()) catch e {
    assert(false, "session: ${e.message()}")
    return
  }
  let sent = <- log
  let lines = split(sent, "\r\n")
  assert(lines[2] == "RCPT TO:<customer@example.net>", "line 2 = '${lines[2]}'")
  assert(lines[3] == "RCPT TO:<auditor@hidden.example>", "line 3 = '${lines[3]}'")
  assert(lines[4] == "DATA", "line 4 = '${lines[4]}'")
  let payload = sent[strIndexOf(sent, "\r\nDATA\r\n"):]
  assert(!contains(payload, "hidden.example"), "the Bcc address was transmitted in DATA")
}

test "recipients lists To, then Cc, then Bcc" {
  let m = bccMessage()
  m.addCc(Address{ name = "", email = "cc@example.net" })
  let r = m.recipients()
  assert(len(r) == 3, "${len(r)} recipients")
  assert(r[0].email == "customer@example.net", "first = ${r[0].email}")
  assert(r[1].email == "cc@example.net", "second = ${r[1].email}")
  assert(r[2].email == "auditor@hidden.example", "third = ${r[2].email}")
}

test "Reply-To renders after Cc and is not an envelope recipient" {
  let m = plainMessage()
  m.addCc(Address{ name = "", email = "cc@example.net" })
  m.addReplyTo(Address{ name = "Support", email = "support@example.com" })
  let rendered = m.render() catch e {
    assert(false, "render: ${e.message()}")
    return
  }
  let at = strIndexOf(rendered, "Reply-To: \"Support\" <support@example.com>\r\n")
  assert(at > 0, "no Reply-To header: ${rendered}")
  assert(at > strIndexOf(rendered, "Cc: "), "Reply-To is not after Cc")
  assert(at < strIndexOf(rendered, "Subject: "), "Reply-To is not before Subject")
  assert(len(m.recipients()) == 2, "Reply-To became a recipient")
  let (port, log) = startFake(
    [
      ehloPlain(), "250 OK\r\n", "250 OK\r\n", "250 OK\r\n", "354 Send it\r\n",
      "250 Queued\r\n", "221 Bye\r\n",
    ],
  ) catch e {
    assert(false, "startFake: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  runPlainSession(c, m) catch e {
    assert(false, "session: ${e.message()}")
    return
  }
  let sent = <- log
  let head = sent[:strIndexOf(sent, "\r\nDATA\r\n")]
  assert(!contains(head, "support@example.com"), "Reply-To drew a RCPT: ${head}")
}

test "a malformed Reply-To or Bcc address is refused at render" {
  let bad = ["no-at-sign", "a\r\nb@example.com", "bracket<@example.com"]
  let i = 0
  while (i < len(bad)) {
    let r = plainMessage()
    r.addReplyTo(Address{ name = "", email = bad[i] })
    let b = plainMessage()
    b.addBcc(Address{ name = "", email = bad[i] })
    assert(!renderOk(r), "Reply-To '${bad[i]}' rendered")
    assert(!renderOk(b), "Bcc '${bad[i]}' rendered")
    i = i + 1
  }
}

// Whether `m.render()` succeeded.
fn renderOk(m: Message): bool {
  m.render() catch _ {
    return false
  }
  return true
}
