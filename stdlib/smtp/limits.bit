// Bit standard library — smtp module: the LIMITS extension (RFC 9422, #6873).
//
// A server that caps what one session may do says so in its EHLO reply:
// `250-LIMITS RCPTMAX=100 MAILMAX=1000`. A client that knows the caps can split
// a recipient list and retire a session before the server cuts it, instead of
// learning each cap from a 452 in the middle of a batch.
//
// The advertisement is advice and never a reason to fail: whatever the server
// sends, `limitsOf` returns a `Limits`, with 0 for every cap it could not read.
// RFC 9422 §3.7 gives the two rules:
//   - a parameter that breaks the basic syntax (§3: space-separated
//     `name[=value]` words, no empty word, no `;` in a value) is ignored in its
//     entirety, as if the server had not sent LIMITS;
//   - a value that breaks its own limit's syntax (§4.1, §4.2: one to six digits,
//     no leading zero, so 1..999999) drops that limit only.
// Names are matched case-insensitively and a name this module does not know
// (RCPTDOMAINMAX, a later registration) is skipped. When a name repeats, the
// first readable value wins.

// The caps a server advertised in its last EHLO. 0 means not advertised, or
// advertised in a form that could not be read.
//
//   rcptMax   RCPT TO commands the server accepts in one transaction (§4.2)
//   mailMax   MAIL FROM commands the server accepts in one session (§4.1)
export class Limits {
  export rcptMax: int,
  export mailMax: int,
}

// The longest value RFC 9422 §4 allows: six digits.
const limitDigits: int = 6

// The caps in the `LIMITS` line of `exts`, the capability lines of one EHLO
// reply; all zero when there is no such line.
fn limitsOf(exts: []string): Limits {
  let i = 0
  while (i < len(exts)) {
    let words = split(exts[i], " ")
    if (toUpper(words[0]) == "LIMITS") {
      return readLimits(words[1:])
    }
    i = i + 1
  }
  return Limits{ rcptMax = 0, mailMax = 0 }
}

// The caps in the `name[=value]` words after the `LIMITS` keyword.
fn readLimits(words: []string): Limits {
  let out = Limits{ rcptMax = 0, mailMax = 0 }
  let i = 0
  while (i < len(words)) {
    if (!limitWordOk(words[i])) {
      return Limits{ rcptMax = 0, mailMax = 0 }
    }
    i = i + 1
  }
  i = 0
  while (i < len(words)) {
    let kv = splitN(words[i], "=", 2)
    let name = toUpper(kv[0])
    let v = 0
    if (len(kv) == 2) {
      v = limitValue(kv[1])
    }
    if (name == "RCPTMAX" && out.rcptMax == 0) {
      out.rcptMax = v
    } else if (name == "MAILMAX" && out.mailMax == 0) {
      out.mailMax = v
    }
    i = i + 1
  }
  return out
}

// Whether `w` is one `limit-name-value` of RFC 9422 §3: a name of letters,
// digits, `-` and `_`, then optionally `=` and a non-empty value of printable
// ASCII other than `;`.
fn limitWordOk(w: string): bool {
  let eq = indexOf(w, "=")
  if (eq < 0) {
    return limitNameOk(w)
  }
  return limitNameOk(w[:int(eq)]) && limitTextOk(w[int(eq) + 1:])
}

// Whether `name` is `limit-name`: one or more of ALPHA / DIGIT / "-" / "_".
fn limitNameOk(name: string): bool {
  if (len(name) == 0) {
    return false
  }
  let i = 0
  while (i < len(name)) {
    if (!isLimitNameByte(name[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

// Whether `v` is `limit-value`: one or more VCHAR other than ";".
fn limitTextOk(v: string): bool {
  if (len(v) == 0) {
    return false
  }
  let i = 0
  while (i < len(v)) {
    if (v[i] < u8(33) || v[i] > u8(126) || v[i] == u8(59)) {
      return false
    }
    i = i + 1
  }
  return true
}

// ALPHA / DIGIT / "-" / "_".
fn isLimitNameByte(c: u8): bool {
  let alpha = (c >= u8(65) && c <= u8(90)) || (c >= u8(97) && c <= u8(122))
  let digit = c >= u8(48) && c <= u8(57)
  return alpha || digit || c == u8(45) || c == u8(95)
}

// `v` as a limit value: %x31-39 0*5DIGIT, so 1..999999. 0 when it is anything
// else, which is how a malformed value reads as "not advertised".
fn limitValue(v: string): int {
  if (len(v) == 0 || len(v) > limitDigits || v[0] == u8(48)) {
    return 0
  }
  let n = 0
  let i = 0
  while (i < len(v)) {
    if (v[i] < u8(48) || v[i] > u8(57)) {
      return 0
    }
    n = n * 10 + int(v[i]) - 48
    i = i + 1
  }
  return n
}
