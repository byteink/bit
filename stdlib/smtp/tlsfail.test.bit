// stdlib/smtp/tlsfail.test.bit — a failed TLS handshake is permanent when the
// server's certificate or negotiation is at fault and transient when the network
// is (#6983).
//
// Every case dials a real `std/tls` listener (or a raw socket that misbehaves on
// purpose) and reads `SmtpError.transient()` and `SmtpError.cause` off what
// `dialTls` / `startTls` fail with. The listener presents one of two throwaway
// self-signed certificates for `localhost` made with one RSA key
// (`openssl req -x509`, CA:TRUE, serverAuth): `selfValidHex` is valid from
// 2026-01-01 to 2036-01-01 and `selfExpiredHex` from 2020-01-01 to 2021-01-01.
// The control for each refusal is the same dial succeeding with the one thing
// changed, so a pass means the handshake was refused for that reason and not
// because the fixture is broken.
//
// `pemOf`, `caHex`, `leafHex`, `keyHex`, `pinnedOptions`, `tlsFake`, `serveTlsFake`,
// `ehloPlain`, `ehloStartTls`, `startFake` and the client surface are module
// siblings (SPEC §19); nothing is imported here.

const selfValidHex: string = ""
const selfExpiredHex: string = ""
const selfKeyHex: string = ""

// A server config presenting the self-signed certificate `certHex`.
fn selfConfig(certHex: string): TlsServerConfig! {
  return TlsServerConfig(
    pemOf("CERTIFICATE", certHex),
    pemOf("PRIVATE KEY", selfKeyHex),
    []string(0),
  )?
}

// A TLS fake server presenting `cfg` that serves one connection.
fn startTlsFakeWith(cfg: TlsServerConfig): int! {
  let ln = tlsListen("127.0.0.1", 0, cfg)?
  let port = ln.port()?
  spawn serveTlsFake(tlsFake{ ln = ln, replies = []string(0), log = chan<string>(1) })
  return port
}

// Options trusting exactly the certificate `certHex` (a self-signed anchor),
// naming `localhost`.
fn anchoredOptions(certHex: string): Options! {
  let o = Options()
  o.roots = fromPem(pemOf("CERTIFICATE", certHex))?
  o.serverName = "localhost"
  return o
}

// The error `dialTls` fails with against `port`; the test fails when it succeeds.
fn dialTlsFailure(port: int, o: Options): SmtpError {
  let c = dialTls("127.0.0.1", port, o) catch e {
    return e
  }
  c.close()
  assert(false, "dialTls succeeded where it had to fail")
  return localError("unreachable")
}

// `e` is a TLS handshake failure of kind `want`, and `transient()` agrees.
fn assertHandshake(e: SmtpError, want: HandshakeFailure, retry: bool) {
  let (h, ok) = e.cause.(HandshakeError)
  assert(ok, "the cause is not a HandshakeError: ${e.message()}")
  assert(h.kind == want, "wrong kind: ${e.message()}")
  assert(e.code == 0, "a handshake failure has no reply code: ${e.code}")
  assert(e.transient() == retry, "transient() is ${e.transient()} for: ${e.message()}")
}

test "a self-signed certificate nobody trusts is permanent" {
  let cfg = selfConfig(selfValidHex) catch e {
    assert(false, "selfConfig: ${e.message()}")
    return
  }
  let port = startTlsFakeWith(cfg) catch e {
    assert(false, "server: ${e.message()}")
    return
  }
  let o = pinnedOptions() catch e {
    assert(false, "options: ${e.message()}")
    return
  }
  let err = dialTlsFailure(port, o)
  assertHandshake(err, HandshakeFailure.Verification, false)
  assert(err.command == "connect", "command: ${err.command}")
}

test "the same self-signed certificate dials once it is the trusted anchor" {
  let cfg = selfConfig(selfValidHex) catch e {
    assert(false, "selfConfig: ${e.message()}")
    return
  }
  let port = startTlsFakeWith(cfg) catch e {
    assert(false, "server: ${e.message()}")
    return
  }
  let o = anchoredOptions(selfValidHex) catch e {
    assert(false, "options: ${e.message()}")
    return
  }
  let c = dialTls("127.0.0.1", port, o) catch e {
    assert(false, "the control dial failed: ${e.message()}")
    return
  }
  c.close()
}

test "a certificate for another name is permanent" {
  let cfg = serverConfig() catch e {
    assert(false, "serverConfig: ${e.message()}")
    return
  }
  let port = startTlsFakeWith(cfg) catch e {
    assert(false, "server: ${e.message()}")
    return
  }
  let o = pinnedOptions() catch e {
    assert(false, "options: ${e.message()}")
    return
  }
  o.serverName = "mail.other.example"
  assertHandshake(dialTlsFailure(port, o), HandshakeFailure.Verification, false)
}

test "an expired certificate is permanent" {
  let cfg = selfConfig(selfExpiredHex) catch e {
    assert(false, "selfConfig: ${e.message()}")
    return
  }
  let port = startTlsFakeWith(cfg) catch e {
    assert(false, "server: ${e.message()}")
    return
  }
  let o = anchoredOptions(selfExpiredHex) catch e {
    assert(false, "options: ${e.message()}")
    return
  }
  let err = dialTlsFailure(port, o)
  assertHandshake(err, HandshakeFailure.Verification, false)
  assert(contains(err.message(), "expired"), "the message lost the reason: ${err.message()}")
}

// A raw server: read the ClientHello, answer `reply` (nothing when empty), close.
fn serveRaw(ln: Listener, reply: string) {
  let c = ln.accept() catch _ {
    return
  }
  let hello = c.read(65536)
  if (len(hello) > 0 && len(reply) > 0) {
    c.write(reply) catch _ {
      c.close()
      return
    }
  }
  c.close()
}

// The port of a raw server that answers `reply`.
fn startRaw(reply: string): int! {
  let ln = listen("127.0.0.1", 0)?
  let port = ln.port()?
  spawn serveRaw(ln, reply)
  return port
}

test "a peer that closes mid-handshake is transient" {
  let port = startRaw("") catch e {
    assert(false, "raw server: ${e.message()}")
    return
  }
  assertHandshake(dialTlsFailure(port, Options()), HandshakeFailure.Io, true)
}

test "a handshake_failure alert from the peer is permanent" {
  let port = startRaw("\x15\x03\x03\x00\x02\x02\x28") catch e {
    assert(false, "raw server: ${e.message()}")
    return
  }
  let err = dialTlsFailure(port, Options())
  assertHandshake(err, HandshakeFailure.Negotiation, false)
  assert(
    contains(err.message(), "handshake_failure"),
    "the message lost the alert: ${err.message()}",
  )
}

test "a STARTTLS upgrade the peer drops is transient" {
  let (port, log) = startFake([ehloStartTls(), "220 Ready\r\n"]) catch e {
    assert(false, "startFake: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  c.ehlo("client.example.com") catch e {
    assert(false, "ehlo: ${e.message()}")
    return
  }
  c.startTls(Options()) catch e {
    assert(e.command == "STARTTLS", "command: ${e.command}")
    assertHandshake(e, HandshakeFailure.Io, true)
    let seen = <- log
    assert(contains(seen, "STARTTLS\r\n"), "no STARTTLS sent: ${seen}")
    return
  }
  assert(false, "startTls succeeded against a server that hung up")
}

test "an error with no cause and a reply-free refusal keep their old classes" {
  assert(ioError("connect", newError("refused")).transient(), "a plain network error is transient")
  assert(!localError("bad").transient(), "validation stays permanent")
}
