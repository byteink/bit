// Bit standard library — smtp module: header values, encoded words and
// envelope addresses (#3967).
//
// Header injection is the vulnerability this file exists to close. A CR or LF
// inside a caller-supplied subject, display name or recipient closes the
// header the caller was given and opens one of its own — a `Bcc` to an address
// the sender never approved is the classic payload. Every value that reaches a
// header goes through `checkHeaderValue` and is REJECTED, never stripped: a
// stripped value silently sends different mail than the caller asked for, and
// a rewritten input hides the attack from the log that would have shown it.
//
// The 998-octet line ceiling (RFC 5321 §4.5.3.1.6) is the other rule. A header
// is never emitted over it: a value that does not fit is encoded as RFC 2047
// base64 words, one per line, which bounds the line by construction instead of
// by hope. `checkLines` (wire.bit) is the backstop that refuses to transmit a
// longer line whatever produced it.

import { equalFold, hasPrefix, indexOf, lastIndexOf, toLower } from "std/strings"
import { encodeBase64 } from "std/crypto"
import { formatHttpDate, now } from "std/time"
import { uuidV7 } from "std/uuid"

// The longest line this module may put on the wire, CRLF excluded
// (RFC 5321 §4.5.3.1.6). A server may refuse anything longer.
const maxLineOctets: int = 998

// Where a folded header line wants to break, well under `maxLineOctets` so a
// reader (and a relay that re-folds) has room. RFC 5322 §2.1.1's "recommended"
// 78.
const foldTarget: int = 78

// Raw input bytes per RFC 2047 word. 45 bytes encode to 60 base64 characters;
// with the 10-byte `=?UTF-8?B?` prefix, the 2-byte suffix and a leading fold
// space that is 73 octets, inside `foldTarget`.
const encodedWordRaw: int = 45

// Whether `v` carries a byte no header value may: CR, LF or NUL. The first two
// are the injection vector; NUL truncates the field in a C-string relay.
fn hasControlByte(v: string): bool {
  let i = 0
  while (i < len(v)) {
    let c = v[i]
    if (c == u8(13) || c == u8(10) || c == u8(0)) {
      return true
    }
    i = i + 1
  }
  return false
}

// Reject `value` outright when it carries a CR, LF or NUL. `name` is the field
// it was destined for, so the message names the caller's own input rather than
// a position in a rendered blob. Called before a single byte of the message is
// built, which is what makes "rejected before anything was sent" true.
fn checkHeaderValue(name: string, value: string): ()!SmtpError {
  if (hasControlByte(value)) {
    fail localError("header ${name} contains a CR, LF or NUL byte")
  }
}

// Whether `s` is entirely printable US-ASCII (plus tab): the condition for
// putting it in a header, or a body line, as-is. Anything else is encoded.
fn isPrintableAscii(s: string): bool {
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c >= u8(127)) {
      return false
    }
    if (c < u8(32) && c != u8(9)) {
      return false
    }
    i = i + 1
  }
  return true
}

// The end of a chunk of at most `want` bytes starting at `at`, moved back off a
// UTF-8 continuation byte so a multi-byte rune is never split across two
// encoded words (RFC 2047 §5 forbids it, and a split rune decodes to mojibake).
fn chunkEnd(s: string, at: int, want: int): int {
  let end = at + want
  if (end >= len(s)) {
    return len(s)
  }
  let guard = 0
  while (guard < 4 && end > at + 1 && s[end] >= u8(128) && s[end] < u8(192)) {
    guard = guard + 1
    end = end - 1
  }
  return end
}

// `v` as one or more RFC 2047 base64 encoded words, folded one per line. Used
// for any value that is not printable ASCII, and for any value too long to
// fold at whitespace: both cases need a representation whose line length is a
// function of the encoder rather than of the input.
fn encodedWords(v: string): string {
  let out = Builder()
  let i = 0
  let guard = 0
  while (i < len(v) && guard <= len(v)) {
    guard = guard + 1
    let end = chunkEnd(v, i, encodedWordRaw)
    if (i > 0) {
      let _ = out.write("\r\n ")
    }
    let _ = out.write("=?UTF-8?B?").write(encodeBase64([]byte(v[i:end]))).write("?=")
    i = end
  }
  return out.toString()
}

// Fold `v` at spaces so no produced line exceeds `foldTarget`, `first` being
// the octets already on the opening line (the `Name: ` prefix). Returns the
// folded value, or `("", false)` when a single unbreakable run is itself too
// long — the caller then encodes instead, which always fits.
fn foldAtSpaces(v: string, first: int): (string, bool) {
  let out = Builder()
  let line = first
  let at = 0
  let guard = 0
  while (guard <= len(v)) {
    guard = guard + 1
    let sp = indexOf(v[at:], " ")
    let end = len(v)
    if (sp >= 0) {
      end = at + sp
    }
    let (nextLine, ok) = foldAppend(out, line, v[at:end], at == 0)
    if (!ok) {
      return ("", false)
    }
    line = nextLine
    if (sp < 0) {
      return (out.toString(), true)
    }
    at = end + 1
  }
  return ("", false)
}

// Place one whitespace-delimited `word` on the folded output `out`: continue
// the current line when it still fits inside `foldTarget`, else break and
// indent by one space (RFC 5322 §2.2.3 folding). Returns the octets now on the
// last line. Refuses a word that cannot fit on a line of its own, which is
// what sends the caller to `encodedWords`.
fn foldAppend(out: Builder, line: int, word: string, firstWord: bool): (int, bool) {
  if (len(word) + 1 > maxLineOctets) {
    return (0, false)
  }
  if (firstWord) {
    let _ = out.write(word)
    return (line + len(word), true)
  }
  if (line + 1 + len(word) <= foldTarget) {
    let _ = out.write(" ").write(word)
    return (line + 1 + len(word), true)
  }
  let _ = out.write("\r\n ").write(word)
  return (1 + len(word), true)
}

// One rendered header field, CRLF-terminated and never over `maxLineOctets` on
// any line. Rejects a CR/LF/NUL in `value` first — the check is here, on the
// single funnel every field goes through, rather than repeated at each caller.
fn renderHeader(name: string, value: string): string!SmtpError {
  checkHeaderValue(name, value)?
  if (!isPrintableAscii(value)) {
    return "${name}: ${encodedWords(value)}\r\n"
  }
  let (folded, ok) = foldAtSpaces(value, len(name) + 2)
  if (!ok) {
    return "${name}: ${encodedWords(value)}\r\n"
  }
  return "${name}: ${folded}\r\n"
}

// Whether `c` may appear in the addr-spec of an envelope address. Deliberately
// narrower than RFC 5321's quoted-string grammar: this is what goes inside
// `MAIL FROM:<...>`, so a space, an angle bracket, a comma, a semicolon, a
// quote or a backslash would let a caller close the envelope and append a
// command parameter. Rejecting them costs a handful of legal-but-exotic
// addresses and closes the whole class.
fn isAddressByte(c: u8): bool {
  if (c <= u8(32) || c >= u8(127)) {
    return false
  }
  if (c == u8(60) || c == u8(62) || c == u8(44) || c == u8(59)) {
    return false
  }
  return c != u8(34) && c != u8(92)
}

// `domain` is a dot-separated run of non-empty labels of legal address bytes.
// No empty label, no leading or trailing dot: `a@.com` and `a@b..c` are the
// shapes a naive `indexOf("@")` split lets through.
fn checkDomain(domain: string): ()!SmtpError {
  if (len(domain) == 0 || domain[0] == u8(46) || domain[len(domain) - 1] == u8(46)) {
    fail localError("address domain '${domain}' is malformed")
  }
  let i = 0
  while (i < len(domain)) {
    if (!isAddressByte(domain[i])) {
      fail localError("address domain '${domain}' has a forbidden byte")
    }
    if (i + 1 < len(domain) && domain[i] == u8(46) && domain[i + 1] == u8(46)) {
      fail localError("address domain '${domain}' has an empty label")
    }
    i = i + 1
  }
}

// Validate an envelope address before it is trusted: exactly one `@`, a
// non-empty local part of legal bytes, a well-formed domain, and inside RFC
// 5321 §4.5.3.1's 64/254 octet ceilings. `kind` names the field for the error.
// The envelope is validated here, not by the caller, because the caller is
// exactly who cannot be trusted with it.
fn checkAddress(kind: string, email: string): ()!SmtpError {
  if (len(email) == 0 || len(email) > 254) {
    fail localError("${kind} address must be 1..254 octets, got ${len(email)}")
  }
  let at = indexOf(email, "@")
  if (at <= 0 || at != lastIndexOf(email, "@")) {
    fail localError("${kind} address '${email}' needs exactly one @ with a local part")
  }
  if (at > 64) {
    fail localError("${kind} address local part exceeds 64 octets")
  }
  let i = 0
  while (i < at) {
    if (!isAddressByte(email[i])) {
      fail localError("${kind} address '${email}' has a forbidden byte")
    }
    i = i + 1
  }
  checkDomain(email[at + 1:])?
}

// Parameters on a MIME header (`Content-Disposition: attachment; filename=...`,
// `Content-Type: ...; name=...`). A parameter value is a quoted-string or an
// RFC 2231 extended value, never an RFC 2047 word (RFC 2047 §5): `renderHeader`
// would turn a non-ASCII value into encoded words and take the whole header
// down with it, and an unescaped `"` in a quoted-string closes it and lets the
// rest of the caller's filename set parameters of its own. `encodeParam` is the
// one place a parameter value becomes bytes.

// The longest `name="value"` that stays a plain quoted-string. Longer, or not
// plain printable ASCII, and the value goes out as an RFC 2231 extended value.
const paramPlainMax: int = 70

// The longest line of a folded parameter, leading space and trailing `;`
// included: one under `foldTarget`.
const paramLineMax: int = 77

const hexDigits: string = "0123456789ABCDEF"

// Whether every byte of `v` is printable US-ASCII (32..126), the only bytes a
// quoted-string carries. Narrower than `isPrintableAscii`: a tab is legal in a
// header value but not worth keeping in a file name.
fn isQuotable(v: string): bool {
  let i = 0
  while (i < len(v)) {
    if (v[i] < u8(32) || v[i] > u8(126)) {
      return false
    }
    i = i + 1
  }
  return true
}

// `v` with a backslash in front of every `"` and `\` (RFC 5322 quoted-pair).
// `v` must be `isQuotable`.
fn quoteEscape(v: string): string {
  let out = Builder()
  let i = 0
  while (i < len(v)) {
    if (v[i] == u8(34) || v[i] == u8(92)) {
      let _ = out.writeByte(u8(92))
    }
    let _ = out.writeByte(v[i])
    i = i + 1
  }
  return out.toString()
}

// The end of the UTF-8 sequence that starts at `at`: always past `at`, so a
// loop over it terminates.
fn runeEnd(v: string, at: int): int {
  let end = at + 1
  while (end < len(v) && v[end] >= u8(128) && v[end] < u8(192)) {
    end = end + 1
  }
  return end
}

// Whether `c` is an RFC 2231 attribute-char: it may stand in an extended value
// without a percent escape.
fn isAttrChar(c: u8): bool {
  let alnum = (c >= u8(48) && c <= u8(57)) ||
    (c >= u8(65) && c <= u8(90)) ||
    (c >= u8(97) && c <= u8(122))
  if (alnum) {
    return true
  }
  let marks = "!#$&+-.^_`|~"
  let i = 0
  while (i < len(marks)) {
    if (marks[i] == c) {
      return true
    }
    i = i + 1
  }
  return false
}

// `v` percent-encoded byte by byte, every byte that is not an attribute-char
// as `%XX` in upper case.
fn percentEncode(v: string): string {
  let out = Builder()
  let i = 0
  while (i < len(v)) {
    if (isAttrChar(v[i])) {
      let _ = out.writeByte(v[i])
    } else {
      let n = int(v[i])
      let _ = out.writeByte(u8(37)).writeByte(hexDigits[n / 16]).writeByte(hexDigits[n % 16])
    }
    i = i + 1
  }
  return out.toString()
}

// The fallback a client without RFC 2231 reads: printable ASCII kept, every
// other rune one `?`, cut to `max` bytes. A cut keeps a short extension, which
// is the part a mail client picks an icon and a handler from.
fn asciiFallback(v: string, max: int): string {
  let b = Builder()
  let i = 0
  while (i < len(v)) {
    let end = runeEnd(v, i)
    if (end == i + 1 && v[i] >= u8(32) && v[i] <= u8(126)) {
      let _ = b.writeByte(v[i])
    } else {
      let _ = b.writeByte(u8(63))
    }
    i = end
  }
  let out = b.toString()
  if (len(out) <= max) {
    return out
  }
  let dot = lastIndexOf(out, ".")
  let ext = ""
  if (dot > 0 && len(out) - dot <= 8) {
    ext = out[dot:]
  }
  return out[0:max - len(ext)] + ext
}

// The label of continuation `n` of parameter `name`: the first one names the
// charset (RFC 2231 §4.1), the rest only the index.
fn segmentLabel(name: string, n: int): string {
  if (n == 0) {
    return "${name}*0*=utf-8''"
  }
  return "${name}*${n}*="
}

// `name` as an RFC 2231 extended value of `value`: `name*=utf-8''<encoded>`
// when that fits one line, else `name*0*=`, `name*1*=`, ... one per line with
// no line over `paramLineMax`. A segment is cut between runes, never inside one.
fn extendedParam(name: string, value: string): string {
  let whole = percentEncode(value)
  let single = "${name}*=utf-8''"
  if (len(single) + len(whole) <= paramLineMax - 1) {
    return single + whole
  }
  let out = Builder()
  let cur = ""
  let n = 0
  let i = 0
  while (i < len(value)) {
    let end = runeEnd(value, i)
    let tok = percentEncode(value[i:end])
    let label = segmentLabel(name, n)
    if (len(label) + len(cur) + len(tok) > paramLineMax - 2) {
      let _ = out.write(label).write(cur).write(";\r\n ")
      n = n + 1
      cur = ""
    }
    cur = cur + tok
    i = end
  }
  let _ = out.write(segmentLabel(name, n)).write(cur)
  return out.toString()
}

// One header parameter: `name="value"` when `value` is plain printable ASCII
// and short, with `"` and `\` escaped; otherwise a quoted ASCII fallback
// followed by the RFC 2231 extended form, the two joined by `;` and a fold so
// every line is short. The text carries its own folds, so it is not a header
// value to hand `renderHeader`: place it with `renderParamHeader`. A CR, LF or
// NUL in `value` is the caller's to reject first (`checkHeaderValue`); here it
// would only be percent-encoded.
fn encodeParam(name: string, value: string): string {
  if (isQuotable(value)) {
    let plain = "${name}=\"${quoteEscape(value)}\""
    if (len(plain) <= paramPlainMax) {
      return plain
    }
  }
  let fallback = quoteEscape(asciiFallback(value, (foldTarget - len(name) - 6) / 2))
  return "${name}=\"${fallback}\";\r\n ${extendedParam(name, value)}"
}

// The header `name: lead; <params>` where `params` is `encodeParam` output
// (`lead` being `attachment`, or a media type). The parameters stay on the
// opening line when its first line fits, else start on a folded line of their
// own. CRLF-terminated.
fn renderParamHeader(name: string, lead: string, params: string): string {
  let first = len(params)
  let nl = indexOf(params, "\r\n")
  if (nl >= 0) {
    first = nl
  }
  if (len(name) + 2 + len(lead) + 2 + first < foldTarget) {
    return "${name}: ${lead}; ${params}\r\n"
  }
  return "${name}: ${lead};\r\n ${params}\r\n"
}

// The `Date` and `Message-ID` fields every message carries (RFC 5322 §3.6.1,
// §3.6.4). Both are written here because a relay that adds a missing one
// changes bytes the sender may already have signed (DKIM), and because a
// receiving provider treats a message without either as a spam signal.

// The longest Message-ID, without its angle brackets. RFC 5322 §2.1.1 leaves
// room for `Message-ID: <` and `>` inside the 998-octet line; 250 keeps it on
// one unfolded line with room to spare.
const maxMessageIdOctets: int = 250

// The current time as an RFC 5322 date-time, `Sun, 06 Nov 1994 08:49:37 +0000`.
// Built from `formatHttpDate`, whose text is the same but for the zone: that
// writes the obsolete `GMT`, and RFC 5322 §3.3 has a sender write a numeric one.
fn dateValue(): string {
  let http = formatHttpDate(now())
  return http[0:len(http) - 3] + "+0000"
}

// Whether `c` is an RFC 5322 `atext`: a letter, a digit or one of
// `!#$%&'*+-/=?^_`{|}~`.
fn isAtext(c: u8): bool {
  let alnum = (c >= u8(48) && c <= u8(57)) ||
    (c >= u8(65) && c <= u8(90)) ||
    (c >= u8(97) && c <= u8(122))
  if (alnum) {
    return true
  }
  let marks = "!#$%&'*+-/=?^_`{|}~"
  let i = 0
  while (i < len(marks)) {
    if (marks[i] == c) {
      return true
    }
    i = i + 1
  }
  return false
}

// Whether `s` is an RFC 5322 `dot-atom-text`: non-empty atext runs joined by
// single dots, no leading, trailing or doubled dot.
fn isDotAtom(s: string): bool {
  if (len(s) == 0 || s[0] == u8(46) || s[len(s) - 1] == u8(46)) {
    return false
  }
  let i = 0
  while (i < len(s)) {
    let dotted = s[i] == u8(46)
    if (!dotted && !isAtext(s[i])) {
      return false
    }
    if (dotted && s[i - 1] == u8(46)) {
      return false
    }
    i = i + 1
  }
  return true
}

// Reject `id` unless it is `id-left "@" id-right`, both dot-atom-text, in at
// most `maxMessageIdOctets`. The ASCII, CR, LF and NUL rules are inside
// `isAtext`: it admits none of them.
fn checkMessageId(id: string): ()!SmtpError {
  let at = indexOf(id, "@")
  let ok = len(id) <= maxMessageIdOctets && at > 0 && at == lastIndexOf(id, "@")
  if (!ok || !isDotAtom(id[0:at]) || !isDotAtom(id[at + 1:])) {
    fail localError("'${id}' is not a valid Message-ID")
  }
}

// The `Message-ID` field for a message sent from `email` (already validated by
// `checkAddress`): `explicit` when the caller set one, else a fresh UUIDv7 at
// the sender's own domain. The domain is the sender's, never the local
// hostname, so the id leaks no machine name and is unique across senders.
fn messageIdHeader(explicit: string, email: string): string!SmtpError {
  let id = explicit
  if (len(id) == 0) {
    id = uuidFormat(uuidV7()) + email[lastIndexOf(email, "@"):]
  }
  checkMessageId(id)?
  return "Message-ID: <${id}>\r\n"
}

// The longest custom header name `setHeader` accepts, in octets. Short enough
// that `name: ` leaves most of a folded line for the value.
const maxHeaderNameOctets: int = 76

// The names a typed setter owns, plus `Content-*` (checked by prefix). A
// custom header with one of these would be a second `From:` that a receiver
// may read instead of the first, so it is refused, never merged.
const ownedHeaders: []string = [
  "From", "To", "Cc", "Bcc", "Reply-To", "Subject", "Date", "Message-ID", "MIME-Version",
]

// Reject `name` unless it is 1..`maxHeaderNameOctets` octets of RFC 5322
// `ftext`: printable ASCII 33..126 except `:`. A space, a CR or LF, a NUL or a
// colon would end the name early or start another field.
fn checkHeaderName(name: string): ()!SmtpError {
  let ok = len(name) >= 1 && len(name) <= maxHeaderNameOctets
  let i = 0
  while (ok && i < len(name)) {
    let c = name[i]
    ok = c >= u8(33) && c <= u8(126) && c != u8(58)
    i = i + 1
  }
  if (!ok) {
    fail localError("'${name}' is not a valid header name")
  }
}

// Reject a custom header whose name a typed setter owns, case-insensitively.
fn checkNotOwned(name: string): ()!SmtpError {
  let owned = hasPrefix(toLower(name), "content-")
  let i = 0
  while (!owned && i < len(ownedHeaders)) {
    owned = equalFold(name, ownedHeaders[i])
    i = i + 1
  }
  if (owned) {
    fail localError("header ${name} is set by its own method, not setHeader")
  }
}

// The custom header fields into `out`, in the order first set, each through
// `renderHeader` so a value is folded or encoded and a CR, LF or NUL is
// refused exactly as for every other field.
fn writeCustomHeaders(out: Builder, names: []string, values: []string): ()!SmtpError {
  let i = 0
  while (i < len(names)) {
    checkHeaderName(names[i])?
    checkNotOwned(names[i])?
    let _ = out.write(renderHeader(names[i], values[i])?)
    i = i + 1
  }
}
