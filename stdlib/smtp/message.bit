// Bit standard library — smtp module: the message a client sends (#3967).
//
// A `Message` is built, then rendered once by `render()`. Nothing is validated
// at the setters and everything is validated at `render()`, on purpose: a
// caller that assembles a message from several places gets ONE failure point
// with the whole message in view, and `Client.send` calls `render()` before it
// opens the envelope, so a rejected value costs zero transmitted bytes.
//
// Body structure follows what the message actually carries, with no empty
// wrappers:
//
//   text only                      text/plain
//   text + html                    multipart/alternative
//   text + html + inline images    multipart/alternative [ text, related [ html, images ] ]
//   text + extra alternatives      multipart/alternative
//   text (+ html, extras) + files  multipart/mixed [ alternative | text ] ...
//
// Every part's transfer encoding is chosen by `partEncoding` (mime.bit) from
// its own bytes, so a 1200-octet line or a non-ASCII byte turns that part into
// base64 rather than putting an illegal line on the wire.

// A mailbox: an optional display name and the addr-spec the envelope uses.
// `email` is what `MAIL FROM`/`RCPT TO` carry and is validated by
// `checkAddress`; `name` is a header value and is rejected for CR/LF like any
// other.
export class Address {
  export name: string,
  export email: string,
}

// A file to attach. `data` is the raw bytes — never text that has already been
// encoded; this module owns the base64. `contentType` defaults to
// `application/octet-stream` when empty.
//
// `Attachment(filename, contentType, data)` attaches `data` named `filename`,
// typed `contentType` (empty means `application/octet-stream`).
export class Attachment {
  export filename: string
  export contentType: string
  export data: []byte

  init(filename: string, contentType: string, data: []byte) {
    this.filename = filename
    this.contentType = contentType
    this.data = data
  }
}

// One outgoing mail. Build it with `Message(sender)` and the setters below —
// no recipients, subject or body to start with; nothing here reaches the
// network until `Client.send`.
export class Message {
  sender: Address
  to: []Address
  cc: []Address
  bcc: []Address
  replyTo: []Address
  subject: string
  text: string
  html: string
  altTypes: []string
  altBodies: []string
  files: []Attachment
  inlines: []Attachment
  inlineIds: []string
  boundary: string
  messageId: string
  headerNames: []string
  headerValues: []string
  // The delivery status notifications to ask for (RFC 3461, #6870), carried
  // into `envelope()`. The default, `Dsn{}`, asks for none.
  export dsn: Dsn = Dsn{}

  init(sender: Address) {
    this.sender = sender
    this.to = []Address(0)
    this.cc = []Address(0)
    this.bcc = []Address(0)
    this.replyTo = []Address(0)
    this.subject = ""
    this.text = ""
    this.html = ""
    this.altTypes = []string(0)
    this.altBodies = []string(0)
    this.files = []Attachment(0)
    this.inlines = []Attachment(0)
    this.inlineIds = []string(0)
    this.boundary = ""
    this.messageId = ""
    this.headerNames = []string(0)
    this.headerValues = []string(0)
  }

  // Add a `To:` recipient. Also an envelope recipient: this module has no
  // concept of a header recipient that is not delivered to.
  export addTo(a: Address) {
    this.to = append(this.to, a)
  }

  // Add a `Cc:` recipient, delivered to like a `To:`.
  export addCc(a: Address) {
    this.cc = append(this.cc, a)
  }

  // Add a blind recipient: delivered to like a `To:`, and never written into
  // any header. RFC 5322 §3.6.3 allows a `Bcc:` header, but one that is kept
  // by a relay or a recipient's client leaks the whole list, so this module
  // never emits it. Validated at `render()` like every other address.
  export addBcc(a: Address) {
    this.bcc = append(this.bcc, a)
  }

  // Add a `Reply-To:` address, where a reply is sent instead of to the sender.
  // Rendered as one header after `Cc:`, validated like `To:` and `Cc:`, and
  // not an envelope recipient: nothing is delivered to it.
  export addReplyTo(a: Address) {
    this.replyTo = append(this.replyTo, a)
  }

  // Set the `Subject:` header. Rejected at `render()` if it carries a CR or LF.
  export setSubject(s: string) {
    this.subject = s
  }

  // Set the plain-text body. Always present in the rendered message: a mail
  // with only an HTML part is unreadable to a text-only client.
  export setText(s: string) {
    this.text = s
  }

  // Set the HTML alternative. Sent alongside the text part inside a
  // `multipart/alternative`, never instead of it.
  export setHtml(s: string) {
    this.html = s
  }

  // Add a further `multipart/alternative` part of `contentType` (a calendar
  // invite is `text/calendar; method=REQUEST; charset=utf-8`, RFC 6047), after
  // the text and HTML parts and in call order: RFC 2046 §5.1.4 makes the last
  // part the preferred one. Encoded like the text parts. Rejected at `render()`
  // unless `contentType` is `type/subtype` with optional `; name=value`
  // parameters and is not `multipart/*`, `text/plain` or `text/html`, which
  // have their own setters.
  export addAlternative(contentType: string, body: string) {
    this.altTypes = append(this.altTypes, contentType)
    this.altBodies = append(this.altBodies, body)
  }

  // Attach `a`. The message becomes `multipart/mixed` at render time.
  export attach(a: Attachment) {
    this.files = append(this.files, a)
  }

  // Add `a` as an inline part the HTML body refers to as `cid:<contentId>`
  // (`<img src="cid:logo@inkwell">`), sent in a `multipart/related` beside the
  // HTML (RFC 2387, RFC 2392). `contentId` is the bare id without angle
  // brackets (`logo@inkwell`). Rejected at `render()` unless it is a dot-atom
  // or `dot-atom "@" dot-atom` of at most 250 ASCII octets, unique among the
  // message's inline parts, and unless the message has an HTML body.
  export addInline(a: Attachment, contentId: string) {
    this.inlines = append(this.inlines, a)
    this.inlineIds = append(this.inlineIds, contentId)
  }

  // Override the MIME boundary. Exists so a test can assert an exact body; a
  // caller has no reason to set one, and an empty string restores the default.
  // Rejected at `render()` unless it is a legal boundary (`isBoundary`).
  export setBoundary(b: string) {
    this.boundary = b
  }

  // Set the `Message-ID:` to `id`, the bare id without angle brackets
  // (`abc@inkwell.dev`). Without it `render()` makes a fresh one at the
  // sender's domain. Rejected at `render()` unless it is a legal RFC 5322
  // `id-left "@" id-right` of at most 250 octets.
  export setMessageId(id: string) {
    this.messageId = id
  }

  // Set a custom header, for `In-Reply-To`, `References`, `List-Unsubscribe`,
  // `Auto-Submitted` and the like. A second call for the same name, compared
  // case-insensitively, replaces the first value in the first one's place;
  // the fields are written after the standard headers, in the order first set.
  // Rejected at `render()` unless `name` is 1..76 octets of printable ASCII
  // without `:`, and unless no typed setter owns it (`From`, `To`, `Cc`, `Bcc`,
  // `Reply-To`, `Subject`, `Date`, `Message-ID`, `MIME-Version`, `Content-*`):
  // two ways to set one field would let one silently win.
  export setHeader(name: string, value: string) {
    let i = 0
    while (i < len(this.headerNames)) {
      if (equalFold(this.headerNames[i], name)) {
        this.headerNames[i] = name
        this.headerValues[i] = value
        return
      }
      i = i + 1
    }
    this.headerNames = append(this.headerNames, name)
    this.headerValues = append(this.headerValues, value)
  }

  // Every address this message is delivered to, `To:`, then `Cc:`, then
  // `Bcc:`, in the order added — the envelope `RCPT TO` list.
  export recipients(): []Address {
    let out = []Address(0)
    let i = 0
    while (i < len(this.to)) {
      out = append(out, this.to[i])
      i = i + 1
    }
    let j = 0
    while (j < len(this.cc)) {
      out = append(out, this.cc[j])
      j = j + 1
    }
    let k = 0
    while (k < len(this.bcc)) {
      out = append(out, this.bcc[k])
      k = k + 1
    }
    return out
  }

  // The SMTP envelope this message goes out under: `MAIL FROM` is the sender,
  // `RCPT TO` is To, Cc and Bcc in that order, and `dsn` is the one set on the
  // message. `Client.send` validates it.
  export envelope(): Envelope {
    let to = []string(0)
    let rcpts = this.recipients()
    let i = 0
    while (i < len(rcpts)) {
      to = append(to, rcpts[i].email)
      i = i + 1
    }
    return Envelope{ from = this.sender.email, to = to, dsn = this.dsn }
  }

  // The complete RFC 5322 message: headers, a blank line, and the body, with
  // CRLF line endings throughout. Fails on a header value carrying a CR, LF or
  // NUL, on a malformed envelope address, on a bad explicit boundary, or if any
  // produced line would exceed 998 octets — before the caller has sent
  // anything.
  export render(): string!SmtpError {
    if (len(this.boundary) == 0) {
      this.boundary = defaultBoundary()
    }
    if (!isBoundary(this.boundary)) {
      fail localError("'${this.boundary}' is not a legal MIME boundary")
    }
    let out = Builder()
    this.writeHeaders(out)?
    writeBody(out, this)?
    let msg = out.toString()
    checkLines(msg)?
    return msg
  }

  // The header block into `out`, without the `Content-*` fields (`writeBody`,
  // mime.bit) and the terminating blank line: Date, From, To, Cc, Reply-To,
  // Subject, Message-ID, the custom headers, then MIME-Version. No `Bcc`, ever.
  writeHeaders(out: Builder): ()!SmtpError {
    checkAddress("from", this.sender.email)?
    let _ = out.write("Date: ${dateValue()}\r\n")
    let _ = out.write(renderHeader("From", formatAddress(this.sender)?)?)
    let _ = out.write(this.recipientHeader("To", this.to)?)
    let _ = out.write(this.recipientHeader("Cc", this.cc)?)
    let _ = out.write(this.recipientHeader("Reply-To", this.replyTo)?)
    this.checkBcc()?
    let _ = out.write(renderHeader("Subject", this.subject)?)
    let _ = out.write(messageIdHeader(this.messageId, this.sender.email)?)
    writeCustomHeaders(out, this.headerNames, this.headerValues)?
    let _ = out.write("MIME-Version: 1.0\r\n")
  }

  // Validate every blind recipient. They have no header to be checked by, and
  // an unchecked one would reach `RCPT TO:<...>` unvalidated.
  checkBcc(): ()!SmtpError {
    let i = 0
    while (i < len(this.bcc)) {
      checkAddress("bcc", this.bcc[i].email)?
      i = i + 1
    }
  }

  // One address-list header, or "" when the list is empty. Every address is
  // validated here, so a malformed `Cc` fails the render rather than being
  // discovered by the server mid-envelope.
  recipientHeader(name: string, list: []Address): string!SmtpError {
    if (len(list) == 0) {
      return ""
    }
    let joined = Builder()
    let i = 0
    while (i < len(list)) {
      checkAddress(name, list[i].email)?
      if (i > 0) {
        let _ = joined.write(", ")
      }
      let _ = joined.write(formatAddress(list[i])?)
      i = i + 1
    }
    return renderHeader(name, joined.toString())?
  }
}

// `name <email>`, or the bare addr-spec when there is no display name.
//
// The CR/LF/NUL check is HERE, on the caller's raw name, not on the composed
// value `renderHeader` later sees: a name that is not printable ASCII is turned
// into an encoded word first, and base64 hides a CRLF from any check that runs
// after it. Validating the derived string instead of the input is exactly how
// an injected `Bcc` gets through — this file's own test caught it doing so.
//
// A name is quoted only when it is printable ASCII with no `"` or `\` to
// escape; anything else becomes encoded words, which have no quote to
// unbalance. A long name is several words joined by single spaces, not by the
// CRLF fold: the composed value is checked and folded by `renderHeader`, and
// that check refuses a CRLF whoever wrote it. Nothing is ever rewritten to
// make it fit.
fn formatAddress(a: Address): string!SmtpError {
  checkHeaderValue("display name", a.name)?
  if (len(a.name) == 0) {
    return "<${a.email}>"
  }
  if (needsEncodedName(a.name)) {
    return "${encodedWords(a.name, " ")} <${a.email}>"
  }
  return "\"${a.name}\" <${a.email}>"
}

// Whether a display name must be sent as an encoded word rather than a quoted
// string: any non-ASCII byte, or a `"` or `\` that would otherwise have to be
// escaped inside the quotes.
fn needsEncodedName(name: string): bool {
  if (!isPrintableAscii(name)) {
    return true
  }
  let i = 0
  while (i < len(name)) {
    if (name[i] == u8(34) || name[i] == u8(92)) {
      return true
    }
    i = i + 1
  }
  return false
}
