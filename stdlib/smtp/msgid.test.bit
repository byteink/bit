// stdlib/smtp/msgid.test.bit — the `Date` and `Message-ID` fields every
// rendered message carries (#6858): shape, order, uniqueness, and the ids
// `setMessageId` refuses.
//
// `plainMessage` and the string helpers imported by smtp.test.bit are module
// siblings (SPEC §19); nothing below imports them.

// The header lines of `rendered` named `name`, every one, in order.
fn headerLines(rendered: string, name: string): []string {
  let out = []string(0)
  let lines = split(rendered[0:strIndexOf(rendered, "\r\n\r\n")], "\r\n")
  let i = 0
  while (i < len(lines)) {
    if (hasPrefix(lines[i], "${name}: ")) {
      out = append(out, lines[i])
    }
    i = i + 1
  }
  return out
}

// `m` rendered, or "ERR <message>".
fn renderOrErr(m: Message): string {
  return m.render() catch e {
    return "ERR ${e.message()}"
  }
}

// Whether `v` is one of `list`.
fn isOneOf(v: string, list: []string): bool {
  let i = 0
  while (i < len(list)) {
    if (v == list[i]) {
      return true
    }
    i = i + 1
  }
  return false
}

// Whether every byte of `s` is an ASCII digit.
fn allDigits(s: string): bool {
  let i = 0
  while (i < len(s)) {
    if (s[i] < u8(48) || s[i] > u8(57)) {
      return false
    }
    i = i + 1
  }
  return len(s) > 0
}

// Whether the day and month names of a `Date:` line `s` are real ones.
fn dateNamesOk(s: string): bool {
  let days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
  let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
  return isOneOf(s[6:9], days) && isOneOf(s[14:17], months)
}

// Whether the digit fields of a `Date:` line `s` are digits: day, year, hour,
// minute, second.
fn dateDigitsOk(s: string): bool {
  let spans = [[11, 13], [18, 22], [23, 25], [26, 28], [29, 31]]
  let i = 0
  while (i < len(spans)) {
    if (!allDigits(s[spans[i][0]:spans[i][1]])) {
      return false
    }
    i = i + 1
  }
  return true
}

// Whether the separators of a `Date:` line `s` and its zone are where they go.
fn dateGlueOk(s: string): bool {
  let seps = s[9:11] == ", " && s[13:14] == " " && s[17:18] == " " && s[22:23] == " "
  return seps && s[25:26] == ":" && s[28:29] == ":" && s[31:] == " +0000"
}

// Whether `s` is `Date: Sun, 06 Nov 1994 08:49:37 +0000` in shape: real day and
// month names, digits where digits go, and the numeric zone `+0000`.
fn isDateLine(s: string): bool {
  if (len(s) != 37 || !hasPrefix(s, "Date: ")) {
    return false
  }
  return dateNamesOk(s) && dateDigitsOk(s) && dateGlueOk(s)
}

test "a rendered message has exactly one numeric-zone Date and one Message-ID at the sender's domain" {
  let out = renderOrErr(plainMessage())
  let dates = headerLines(out, "Date")
  assert(len(dates) == 1, "Date lines: ${len(dates)}")
  assert(isDateLine(dates[0]), "not an RFC 5322 date: '${dates[0]}'")
  let ids = headerLines(out, "Message-ID")
  assert(len(ids) == 1, "Message-ID lines: ${len(ids)}")
  assert(hasPrefix(ids[0], "Message-ID: <") && ids[0][len(ids[0]) - 13:] == "@example.com>", ids[0])
  assert(!contains(ids[0], "localhost"), "the id carries a hostname: ${ids[0]}")
}

test "two renders of one message carry different Message-IDs" {
  let m = plainMessage()
  let a = headerLines(renderOrErr(m), "Message-ID")[0]
  let b = headerLines(renderOrErr(m), "Message-ID")[0]
  assert(a != b, "the same id twice: ${a}")
}

test "headers come out in the order Date, From, To, Subject, Message-ID, MIME-Version" {
  let out = renderOrErr(plainMessage())
  let order = ["\r\nFrom: ", "\r\nTo: ", "\r\nSubject: ", "\r\nMessage-ID: ", "\r\nMIME-Version: "]
  assert(hasPrefix(out, "Date: "), "Date is not first")
  let last = 0
  let i = 0
  while (i < len(order)) {
    let at = strIndexOf(out, order[i])
    assert(at > last, "${order[i]} out of order")
    last = at
    i = i + 1
  }
}

test "setMessageId is rendered as given, in angle brackets" {
  let m = plainMessage()
  m.setMessageId("x@inkwell.dev")
  let out = renderOrErr(m)
  let ids = headerLines(out, "Message-ID")
  assert(len(ids) == 1 && ids[0] == "Message-ID: <x@inkwell.dev>", out)
}

test "a bad Message-ID fails the render and nothing else is produced" {
  let cases = [
    "a b@x", "a\r\nBcc: x@y", "a\nb@x.com", "a@", "@x.com", "a@@x.com", "plain",
    "a..b@x.com", ".a@x.com", "a@x.com.", "a@x..com", "<a@x.com>", "a@b c.com",
    "a\0@x.com", "é@x.com", "a@x.com\r\n", "a,b@x.com", "a\"b@x.com",
    "${repeat("a", 247)}@b.c",
  ]
  let i = 0
  while (i < len(cases)) {
    let m = plainMessage()
    m.setMessageId(cases[i])
    let out = renderOrErr(m)
    assert(
      hasPrefix(out, "ERR smtp: '") && contains(out, "' is not a valid Message-ID"),
      "case ${i}: ${out}",
    )
    i = i + 1
  }
}

test "a Message-ID of exactly 250 octets is accepted and 251 is not" {
  let ok = "${repeat("a", 246)}@b.c"
  let m = plainMessage()
  m.setMessageId(ok)
  let ids = headerLines(renderOrErr(m), "Message-ID")
  assert(len(ids) == 1 && ids[0] == "Message-ID: <${ok}>", "250 octets refused")
  m.setMessageId("a${ok}")
  assert(hasPrefix(renderOrErr(m), "ERR "), "251 octets accepted")
}
