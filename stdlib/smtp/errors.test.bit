// stdlib/smtp/errors.test.bit — `SmtpError`: what a failed step reports and
// whether a retry can help (#6857).
//
// The failures that come from a server are produced by the fake server in
// smtp.test.bit, so the code, the enhanced status and the failing command are
// read off a real exchange. `fake`, `startFake`, `ehloPlain`, `ehloAuthNoTls`,
// `plainMessage` and the client surface are module siblings (SPEC §19); nothing
// below imports them.

// The error `c.send(m)` fails with after a successful EHLO. Panics when the
// send succeeds: every caller scripts a refusal, so success means the script
// and the client disagree.
fn sendError(c: Client, m: Message): SmtpError {
  c.ehlo("client.example.com") catch e {
    panic("ehlo: ${e.message()}")
  }
  c.send(m) catch e {
    return e
  }
  panic("send succeeded against a server scripted to refuse")
}

// A client sending `plainMessage()` to a fake whose replies after the EHLO are
// `replies`, and the error that send fails with.
fn refusedBy(replies: []string): SmtpError {
  let (port, log) = startFake(append([ehloPlain()], ...replies)) catch e {
    panic("startFake: ${e.message()}")
  }
  let c = dial("127.0.0.1", port) catch e {
    panic("dial: ${e.message()}")
  }
  let err = sendError(c, plainMessage())
  c.close()
  let _ = <- log
  return err
}

test "a 450 at RCPT TO carries code, enhanced status and command, and is transient" {
  let e = refusedBy(["250 OK\r\n", "450 4.2.1 Mailbox busy\r\n"])
  assert(e.code == 450, "code = ${e.code}")
  assert(e.enhanced == "4.2.1", "enhanced = '${e.enhanced}'")
  assert(e.text == "Mailbox busy (refused: customer@example.net)", "text = '${e.text}'")
  assert(e.command == "RCPT TO", "command = '${e.command}'")
  assert(e.transient(), "a 450 must be transient")
  assert(
    e.message() == "smtp: RCPT TO got 450: 4.2.1 Mailbox busy (refused: customer@example.net)",
    "message = '${e.message()}'",
  )
}

test "a 550 at RCPT TO is permanent" {
  let e = refusedBy(["250 OK\r\n", "550 5.1.1 No such user\r\n"])
  assert(e.code == 550, "code = ${e.code}")
  assert(e.enhanced == "5.1.1", "enhanced = '${e.enhanced}'")
  assert(e.command == "RCPT TO", "command = '${e.command}'")
  assert(!e.transient(), "a 550 must not be transient")
}

test "a server without enhanced status codes gives an empty enhanced field" {
  let e = refusedBy(["250 OK\r\n", "550 No such user\r\n"])
  assert(e.code == 550, "code = ${e.code}")
  assert(e.enhanced == "", "enhanced = '${e.enhanced}'")
  assert(e.text == "No such user (refused: customer@example.net)", "text = '${e.text}'")
  assert(
    e.message() == "smtp: RCPT TO got 550: No such user (refused: customer@example.net)",
    "message = '${e.message()}'",
  )
}

test "the failing step is named: MAIL FROM, DATA and end of DATA" {
  let mail = refusedBy(["451 4.3.0 Local error\r\n"])
  assert(mail.command == "MAIL FROM" && mail.code == 451, "MAIL FROM: ${mail.message()}")
  assert(mail.transient(), "a 451 must be transient")
  let data = refusedBy(["250 OK\r\n", "250 OK\r\n", "554 5.3.4 Not accepting mail\r\n"])
  assert(data.command == "DATA" && data.code == 554, "DATA: ${data.message()}")
  assert(!data.transient(), "a 554 must not be transient")
  let tail = refusedBy(
    ["250 OK\r\n", "250 OK\r\n", "354 Go\r\n", "452 4.3.1 Insufficient storage\r\n"],
  )
  assert(tail.command == "end of DATA" && tail.code == 452, "end of DATA: ${tail.message()}")
  assert(tail.transient(), "a 452 must be transient")
}

test "a multi-line reply joins its text and takes the status off the first line" {
  let e = refusedBy(["250 OK\r\n", "550-5.7.1 Relay denied\r\n550 see policy\r\n"])
  assert(e.enhanced == "5.7.1", "enhanced = '${e.enhanced}'")
  assert(e.text == "Relay denied see policy (refused: customer@example.net)", "text = '${e.text}'")
}

test "a subject with a CR is a permanent validation failure with no code" {
  let m = plainMessage()
  m.setSubject("Hi\rBcc: x@example.com")
  let (port, log) = startFake([ehloPlain()]) catch e {
    panic("startFake: ${e.message()}")
  }
  let c = dial("127.0.0.1", port) catch e {
    panic("dial: ${e.message()}")
  }
  let e = sendError(c, m)
  c.close()
  let _ = <- log
  assert(e.command == "validate", "command = '${e.command}'")
  assert(e.code == 0 && e.enhanced == "", "code ${e.code} enhanced '${e.enhanced}'")
  assert(!e.transient(), "a validation failure must not be transient")
}

test "AUTH on a cleartext connection is a permanent validation failure" {
  let (port, log) = startFake([ehloAuthNoTls()]) catch e {
    panic("startFake: ${e.message()}")
  }
  let c = dial("127.0.0.1", port) catch e {
    panic("dial: ${e.message()}")
  }
  c.ehlo("client.example.com") catch e {
    panic("ehlo: ${e.message()}")
  }
  c.auth(Auth.Plain("u", "p")) catch e {
    assert(e.command == "validate", "command = '${e.command}'")
    assert(!e.transient(), "refusing AUTH must not be transient")
    c.close()
    let _ = <- log
    return
  }
  panic("auth succeeded on a cleartext connection")
}

test "a refused connection is code 0, command connect, and transient" {
  let ln = listen("127.0.0.1", 0) catch e {
    panic("listen: ${e.message()}")
  }
  let port = ln.port() catch e {
    panic("port: ${e.message()}")
  }
  ln.close()
  dial("127.0.0.1", port) catch e {
    assert(e.code == 0, "code = ${e.code}")
    assert(e.command == "connect", "command = '${e.command}'")
    assert(e.transient(), "a refused connection must be transient")
    return
  }
  panic("dialed a closed port")
}

test "enhancedLen accepts [245].X.Y with one to three digits and a space, nothing else" {
  assert(enhancedLen("5.1.1 No such user") == 5, "5.1.1")
  assert(enhancedLen("2.0.0 OK") == 5, "2.0.0")
  assert(enhancedLen("4.12.123 x") == 8, "4.12.123")
  assert(enhancedLen("3.1.1 x") == 0, "class 3")
  assert(enhancedLen("5.1.1") == 0, "no space after the code")
  assert(enhancedLen("5.1 x") == 0, "two parts")
  assert(enhancedLen("5.1.1234 x") == 0, "four digits")
  assert(enhancedLen("5..1 x") == 0, "empty part")
  assert(enhancedLen("550 x") == 0, "a reply code is not a status")
  assert(enhancedLen("") == 0, "empty")
}

test "transient follows the code, and a code-less failure is transient unless local" {
  assert(SmtpError{ code = 421, enhanced = "", text = "", command = "greeting" }.transient(), "421")
  assert(
    !SmtpError{ code = 535, enhanced = "", text = "", command = "AUTH PLAIN" }.transient(),
    "535",
  )
  assert(!SmtpError{ code = 354, enhanced = "", text = "", command = "DATA" }.transient(), "354")
  assert(
    SmtpError{ code = 0, enhanced = "", text = "reset", command = "RCPT TO" }.transient(),
    "net",
  )
  assert(
    !SmtpError{ code = 0, enhanced = "", text = "bad", command = "validate" }.transient(),
    "validate",
  )
}
