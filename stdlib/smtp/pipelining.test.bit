// Command boundaries come from CRLF, never the kernel's read boundaries.
fn runScript(s: Stream, replies: []string, greet: bool = true): string! {
  if (greet) {
    s.send("220 fake.example.com ESMTP\r\n")?
  }
  let seen = ""
  let pending = ""
  let step = 0
  let inData = false
  let turns = 0
  while (turns < maxTurns + len(replies) && step < len(replies)) {
    turns = turns + 1
    let chunk = s.recv(65536)?
    if (len(chunk) == 0) {
      return seen
    }
    seen = seen + chunk
    pending = pending + chunk
    let lines = 0
    while (lines <= len(chunk) && step < len(replies)) {
      lines = lines + 1
      let at = strIndexOf(pending, "\r\n")
      if (at < 0) {
        break
      }
      let line = pending[0:at]
      pending = pending[at + 2:]
      if (inData && line != ".") {
        continue
      }
      s.send(replies[step])?
      inData = replyStartsData(replies[step])
      step = step + 1
    }
  }
  return seen
}

// A real transport with recorded call boundaries. The optional rendezvous
// holds the grouped writer until receive starts. Large groups instead wait
// for real reply bytes, because kernel buffering does not enforce that order.
class pipelineRecorder {
  inner: Stream
  writes: []string
  receive: chan<bool>
  duplex: bool
  opened: bool
  active: bool
  failWrite: bool
  groupDone: chan<bool>
  complete: bool
  pendingReplies: int
  replyFence: bool
  replyReleased: bool
  arms: int

  export send(s: string): ()! {
    this.active = true
    this.writes = append(this.writes, s)
    if (this.duplex && !this.replyFence && hasPrefix(s, "MAIL FROM:")) {
      let _ = <- this.receive
    }
    if (this.failWrite) {
      this.active = false
      fail newError("scripted grouped write failed")
    }
    this.sendRecorded(s) catch e {
      this.active = false
      fail e
    }
    this.active = false
    if (this.duplex && hasPrefix(s, "MAIL FROM:")) {
      this.groupDone <- true
    }
  }
  sendRecorded(s: string): ()! {
    if (!this.replyFence || !hasPrefix(s, "MAIL FROM:")) {
      this.inner.send(s)?
      return
    }
    let at = strIndexOf(s, "\r\n") + 2
    assert(at > 1 && at < len(s), "group has no MAIL boundary")
    this.inner.send(s[0:at])?
    // Keep RCPT/DATA unsent until a real MAIL reply proves concurrent receive.
    let _ = <- this.receive
    this.inner.send(s[at:])?
  }
  releaseReply() {
    if (this.replyFence && !this.replyReleased) {
      this.replyReleased = true
      this.receive <- true
    }
  }
  export recv(max: int): string! {
    if (this.duplex && !this.opened) {
      this.opened = true
      if (!this.replyFence) {
        this.receive <- true
      }
    }
    let reply = this.inner.recv(max) catch e {
      this.releaseReply()
      fail e
    }
    if (this.duplex && !this.complete && len(reply) > 0) {
      select {
        case _ = <- this.groupDone:
          this.complete = true
        default:
          this.pendingReplies = this.pendingReplies + 1
      }
    }
    // EOF must also release the writer so the error path can join it.
    this.releaseReply()
    return reply
  }
  export deadline(ns: int) {
    this.arms = this.arms + 1
    this.inner.deadline(ns)
  }
  export timedOut(): bool { return this.inner.timedOut() }
  export shut() {
    assert(!this.active, "stream closed before writer acknowledged")
    this.inner.shut()
  }
}

fn recordPipeline(c: Client, duplex: bool = false): pipelineRecorder {
  let r = pipelineRecorder{
    inner = c.w.s, writes = []string(0), receive = chan<bool>(1), duplex = duplex, opened = false,
    active = false, failWrite = false,
    groupDone = chan<bool>(1), complete = false, pendingReplies = 0, arms = 0,
    replyFence = false, replyReleased = false,
  }
  c.w.s = r
  return r
}

fn successfulReplies(n: int): []string {
  let replies = []string(0)
  let i = 0
  while (i <= n) {
    replies = append(replies, "250 OK\r\n")
    i = i + 1
  }
  return append(replies, "354 Go\r\n", "250 Queued\r\n", "221 Bye\r\n")
}

fn assertPipelineGroup(r: pipelineRecorder, raw: Raw) {
  assert(len(r.writes) == 3, "group, payload and QUIT: ${len(r.writes)} sends")
  let group = pipelineCommands(raw.env, "MAIL FROM:<${raw.env.from}> SIZE=${len(raw.data)}") catch e {
    panic(e.message())
  }
  assert(r.writes[0] == group, "MAIL/all RCPT/DATA were not one send")
  assert(unstuffed(r.writes[0] + r.writes[1]) == raw.data, "payload changed")
  assert(r.writes[2] == "QUIT\r\n", "QUIT raced the group")
  assert(r.arms == 3, "group, payload and QUIT must each arm one deadline")
}

test "PIPELINING records exactly one send for MAIL three RCPT and DATA" {
  let (c, log) = fakeClient(successfulReplies(3))
  let r = recordPipeline(c)
  let raw = threeRecipients()
  let d = c.send(raw) catch e {
    panic(e.message())
  }
  c.quit() catch e {
    panic(e.message())
  }
  let _ = <- log
  assert(len(d.accepted) == 3, "recipients lost")
  assertPipelineGroup(r, raw)
}

test "PIPELINING receives while its grouped writer waits and joins before DATA" {
  let (c, log) = fakeClient(successfulReplies(3))
  let r = recordPipeline(c, true)
  let raw = threeRecipients()
  let _ = c.send(raw) catch e {
    panic(e.message())
  }
  c.quit() catch e {
    panic(e.message())
  }
  let _ = <- log
  assert(r.opened, "receive never released the blocked writer")
  assertPipelineGroup(r, raw)
}

test "PIPELINING absent retains sequential command reply writes" {
  let (c, log) = fakeClientEhlo("250-fake\r\n250 SIZE 35882577\r\n", successfulReplies(3))
  let r = recordPipeline(c)
  let _ = c.send(threeRecipients()) catch e {
    panic(e.message())
  }
  c.quit() catch e {
    panic(e.message())
  }
  let _ = <- log
  assert(len(r.writes) == 7, "MAIL, three RCPT, DATA, payload, QUIT: ${len(r.writes)}")
  assert(r.writes[4] == "DATA\r\n", "sequential DATA boundary lost")
}

test "PIPELINING all recipients rejected with 354 sends only empty dot before RSET" {
  let (c, log) = fakeClient(
    [
      "250 OK\r\n", "550 No user\r\n", "354 Go\r\n", "554 Empty refused\r\n", "250 Reset\r\n", "221 Bye\r\n",
    ],
  )
  let r = recordPipeline(c)
  let raw = Raw(Envelope{ from = "me@x.com", to = ["a@x.com"] }, rawMessage())
  let e = refusal(c, raw)
  assert(e.code == 550 && e.command == "RCPT TO", e.message())
  assert(c.reusable(), "empty DATA and reset did not restore the session")
  c.quit() catch err {
    panic(err.message())
  }
  let sent = <- log
  assert(contains(sent, "DATA\r\n.\r\nRSET\r\n"), sent)
  assert(r.writes[1] == ".\r\n" && r.writes[2] == "RSET\r\n", "reset became message content")
}

test "PIPELINING MAIL 452 drains multiline replies then resets and reuses" {
  let (c, log) = fakeClient(
    append(
      [
        "452 4.3.1 Try later\r\n", "503-No sender\r\n503 No sender\r\n", "503 No sender\r\n", "250 Reset\r\n",
      ],
      ...successfulReplies(1),
    ),
  )
  let r = recordPipeline(c)
  let raw = Raw(Envelope{ from = "me@x.com", to = ["a@x.com"] }, rawMessage())
  let e = refusal(c, raw)
  assert(e.code == 452 && e.transient() && e.command == "MAIL FROM", e.message())
  assert(c.reusable(), "outstanding replies or reset lost session")
  let _ = c.send(raw) catch err {
    panic(err.message())
  }
  c.quit() catch err {
    panic(err.message())
  }
  let _ = <- log
  assert(r.writes[1] == "RSET\r\n", "reset raced grouped writer")
}

test "PIPELINING MAIL refusal with unexpected 354 sends empty dot and preserves MAIL" {
  let (c, log) = fakeClient(
    [
      "452 4.3.1 Try later\r\n", "250 OK\r\n", "354 Go\r\n", "554 Empty refused\r\n", "250 Reset\r\n", "221 Bye\r\n",
    ],
  )
  let r = recordPipeline(c)
  let e = refusal(c, Raw(Envelope{ from = "me@x.com", to = ["a@x.com"] }, rawMessage()))
  assert(e.code == 452 && e.command == "MAIL FROM", e.message())
  assert(c.reusable(), "MAIL refusal was not reset after empty dot")
  c.quit() catch err {
    panic(err.message())
  }
  let sent = <- log
  assert(contains(sent, "DATA\r\n.\r\nRSET\r\n"), sent)
  assert(r.writes[1] == ".\r\n", "MAIL refusal transmitted real message")
}

test "PIPELINING refused recipients with DATA 554 drain and reset without payload" {
  let (c, log) = fakeClient(
    [
      "250 OK\r\n", "550 No user\r\n", "554 No recipients\r\n", "250 Reset\r\n", "221 Bye\r\n",
    ],
  )
  let r = recordPipeline(c)
  let e = refusal(c, Raw(Envelope{ from = "me@x.com", to = ["a@x.com"] }, rawMessage()))
  assert(e.code == 550 && e.command == "RCPT TO", e.message())
  c.quit() catch err {
    panic(err.message())
  }
  let _ = <- log
  assert(r.writes[1] == "RSET\r\n", "payload sent after DATA refusal")
}

test "PIPELINING malformed empty DATA completion prevents reset and reuse" {
  let (c, log) = fakeClient(["250 OK\r\n", "550 No user\r\n", "354 Go\r\n", "354 More data\r\n"])
  let r = recordPipeline(c)
  let e = refusal(c, Raw(Envelope{ from = "me@x.com", to = ["a@x.com"] }, rawMessage()))
  assert(e.code == 550 && !c.reusable(), e.message())
  c.close()
  let _ = <- log
  assert(len(r.writes) == 2 && r.writes[1] == ".\r\n", "RSET became message content")
}

test "PIPELINING actual writer error wins synthetic EOF and joins before close" {
  let (c, log) = fakeClient(["250 Awaiting MAIL\r\n"])
  let r = recordPipeline(c)
  r.failWrite = true
  let e = refusal(c, threeRecipients())
  assert(e.command == "MAIL FROM", e.message())
  assert(e.cause.message() == "scripted grouped write failed", "writer cause replaced by EOF")
  assert(!r.active && !c.reusable(), "writer not joined or session retained")
  c.close()
  let _ = <- log
  assert(len(r.writes) == 1, "cleanup sent a second command after failed write")
}

test "PIPELINING original MAIL refusal survives truncated drain and closes after join" {
  let (c, log) = fakeClient(["452 4.3.1 Try later\r\n", "250 truncated"])
  let r = recordPipeline(c)
  let e = refusal(c, threeRecipients())
  assert(e.code == 452 && e.command == "MAIL FROM", e.message())
  assert(!c.reusable() && !r.active, "drain failure retained session or writer")
  c.close()
  let _ = <- log
  assert(len(r.writes) == 1, "RSET raced a failed drain")
}

test "PIPELINING 421 and malformed multiline replies join before closing" {
  let scripts = [
    ["250 OK\r\n", "421 Closing\r\n"],
    ["250 OK\r\n", "250-first\r\n550 wrong-code\r\n"],
  ]
  let i = 0
  while (i < len(scripts)) {
    let (c, log) = fakeClient(scripts[i])
    let r = recordPipeline(c, true)
    let e = refusal(c, threeRecipients())
    assert(e.command == "RCPT TO", e.message())
    assert(!c.reusable() && !r.active, "bad reply retained session or writer")
    c.close()
    let _ = <- log
    assert(len(r.writes) == 1, "RSET after terminal reply")
    i = i + 1
  }
}

// This is an explicit test bound, not a production recipient limit. The group
// exceeds four MiB, and the peer replies with over eight MiB while consuming it.
fn largePipelineRaw(): Raw {
  let address = repeat("a", 60) +
    "@" +
    repeat("b", 60) +
    "." +
    repeat("c", 60) +
    "." +
    repeat("d", 60)
  let to = []string(0)
  let i = 0
  while (i < 18000) {
    to = append(to, address)
    i = i + 1
  }
  return Raw(Envelope{ from = "me@x.com", to = to }, rawMessage())
}

fn largePipelineReplies(n: int): []string {
  let replies = []string(0)
  let reply = "250-" + repeat("r", 512) + "\r\n250 OK\r\n"
  let i = 0
  while (i <= n) {
    replies = append(replies, reply)
    i = i + 1
  }
  return append([ehloPlain()], ...append(replies, "354 Go\r\n", "250 Queued\r\n", "221 Bye\r\n"))
}

fn proveLargePipeline(c: Client, log: chan<string>, raw: Raw) {
  c.ehlo("client.example.com") catch e {
    panic(e.message())
  }
  let r = recordPipeline(c, true)
  r.replyFence = true
  let d = c.send(raw) catch e {
    panic(e.message())
  }
  c.quit() catch e {
    panic(e.message())
  }
  let sent = <- log
  assert(len(d.accepted) == len(raw.env.to), "large group lost replies")
  assert(len(r.writes[0]) > 4 * 1024 * 1024, "group too small: ${len(r.writes[0])}")
  assert(r.opened && !r.active, "no receive progress or writer not joined")
  assert(r.pendingReplies > 0, "no real reply arrived while the grouped write was pending")
  assert(sent == "EHLO client.example.com\r\n" + join(r.writes, ""), "large transcript truncated")
  assertPipelineGroup(r, raw)
  println("group bytes=${len(r.writes[0])}, replies=${len(raw.env.to) + 2}, accepted=${len(d.accepted)}, pending receives=${r.pendingReplies}")
}

test "PIPELINING large real TCP group receives while writing" {
  let raw = largePipelineRaw()
  let (port, log) = startFake(largePipelineReplies(len(raw.env.to))) catch e {
    panic(e.message())
  }
  let c = dial("127.0.0.1", port) catch e {
    panic(e.message())
  }
  proveLargePipeline(c, log, raw)
}

test "PIPELINING large verified TLS group receives while writing" {
  let raw = largePipelineRaw()
  let (port, log) = startTlsFake(largePipelineReplies(len(raw.env.to))) catch e {
    panic(e.message())
  }
  let o = pinnedOptions() catch e {
    panic(e.message())
  }
  let c = dialTls("127.0.0.1", port, o) catch e {
    panic(e.message())
  }
  assert(c.verifiedTls, "test TLS was not verified")
  proveLargePipeline(c, log, raw)
}

class pipelineStopPeer {
  ln: Listener,
  release: chan<bool>,
  done: chan<string>,
  reply: string,
}

fn servePipelineStop(p: pipelineStopPeer) {
  let c = p.ln.accept() catch e {
    panic(e.message())
  }
  c.setDeadline(monotonic().ns + 10 * Second)
  c.write("220 fake\r\n") catch e {
    panic(e.message())
  }
  let hello = c.read(65536)
  assert(hasPrefix(hello, "EHLO "), "missing EHLO")
  c.write(ehloPlain()) catch e {
    panic(e.message())
  }
  let prefix = c.read(65536)
  assert(hasPrefix(prefix, "MAIL FROM:"), "missing grouped MAIL")
  c.write(p.reply) catch e {
    panic(e.message())
  }
  // Keep the peer open and stop consuming a multi-MiB group: only the
  // client's cancellation can release its blocked writer before this signal.
  let _ = <- p.release
  c.close()
  p.ln.close()
  p.done <- prefix
}

test "PIPELINING reader 421 cancels blocked large writer without losing server code" {
  let ln = listen("127.0.0.1", 0) catch e {
    panic(e.message())
  }
  let port = ln.port() catch e {
    panic(e.message())
  }
  let peer = pipelineStopPeer{
    ln = ln, release = chan<bool>(1), done = chan<string>(1), reply = "250 OK\r\n421 Closing\r\n",
  }
  spawn servePipelineStop(peer)
  let c = dial("127.0.0.1", port) catch e {
    panic(e.message())
  }
  c.ehlo("client.example.com") catch e {
    panic(e.message())
  }
  let r = recordPipeline(c, true)
  let e = refusal(c, largePipelineRaw())
  c.close()
  peer.release <- true
  let prefix = <- peer.done
  assert(len(prefix) < len(r.writes[0]), "peer consumed the complete group")
  assert(r.pendingReplies > 0 && !r.active, "writer wasn't pending or wasn't joined")
  assert(e.code == 421 && e.command == "RCPT TO", "cancellation replaced refusal: ${e.message()}")
  assert(!c.reusable() && len(r.writes) == 1, "terminal refusal reset or retained session")
}

test "PIPELINING malformed reader reply survives cancellation of blocked large writer" {
  let ln = listen("127.0.0.1", 0) catch e {
    panic(e.message())
  }
  let port = ln.port() catch e {
    panic(e.message())
  }
  let peer = pipelineStopPeer{
    ln = ln, release = chan<bool>(1), done = chan<string>(1), reply = "250 OK\r\n250-first\r\n550 wrong\r\n",
  }
  spawn servePipelineStop(peer)
  let c = dial("127.0.0.1", port) catch e {
    panic(e.message())
  }
  c.ehlo("client.example.com") catch e {
    panic(e.message())
  }
  let r = recordPipeline(c, true)
  let e = refusal(c, largePipelineRaw())
  c.close()
  peer.release <- true
  let _ = <- peer.done
  assert(e.command == "RCPT TO" && contains(e.text, "reply changed code"), e.message())
  assert(r.pendingReplies > 0 && !r.active && !c.reusable(), "reader failed without joining writer")
}

test "PIPELINING deadline cancels and joins a blocked large writer and reader" {
  let ln = listen("127.0.0.1", 0) catch e {
    panic(e.message())
  }
  let port = ln.port() catch e {
    panic(e.message())
  }
  let peer = pipelineStopPeer{
    ln = ln, release = chan<bool>(1), done = chan<string>(1), reply = "250 OK\r\n",
  }
  spawn servePipelineStop(peer)
  let o = Options()
  o.timeout = 200 * Millisecond
  let c = dial("127.0.0.1", port, o) catch e {
    panic(e.message())
  }
  c.ehlo("client.example.com") catch e {
    panic(e.message())
  }
  let r = recordPipeline(c, true)
  let e = refusal(c, largePipelineRaw())
  c.close()
  peer.release <- true
  let _ = <- peer.done
  assert(e.code == 0 && contains(e.message(), "timed out after 200ms"), e.message())
  assert(r.arms == 1 && !r.active && !c.reusable(), "deadline changed or writer survived timeout")
}

test "PIPELINING capability and malformed DSN refusals transmit zero MAIL bytes" {
  let raws = [
    dsnRaw(Dsn{ notify = [Notify.Failure] }),
    requireTlsRaw(),
    Raw(Envelope{ from = "me@x.com", to = ["a@x.com"] }, rawMessage()),
    Raw(Envelope{ from = "me@x.com", to = ["élève@x.com"] }, rawMessage()),
    dsnRaw(Dsn{ notify = [Notify.Never, Notify.Failure] }),
  ]
  let i = 0
  while (i < len(raws)) {
    let caps = "250-fake\r\n250-PIPELINING\r\n250 SIZE 1\r\n"
    let (c, log) = fakeClientEhlo(caps, ["221 Bye\r\n"])
    let r = recordPipeline(c)
    let e = refusal(c, raws[i])
    assert(e.command == "validate" && len(r.writes) == 0 && r.arms == 0, e.message())
    assert(c.reusable(), "preflight refusal lost session")
    c.quit() catch err {
      panic(err.message())
    }
    let _ = <- log
    i = i + 1
  }
}

test "PIPELINING verified TLS retains DSN REQUIRETLS SIZE and exact Raw bytes" {
  let caps = "250-fake\r\n250-PIPELINING\r\n250-DSN\r\n250-REQUIRETLS\r\n250 SIZE 1000\r\n"
  let o = pinnedOptions() catch e {
    panic(e.message())
  }
  let (c, log) = requireTlsClient(o, caps, successfulReplies(1))
  let r = recordPipeline(c, true)
  let raw = requireTlsRaw()
  raw.data = "DKIM-Signature: v=1; a=ed25519-sha256; b=frozen\r\n" + raw.data
  raw.env.dsn = Dsn{ ret = Ret.Headers, envid = "msg 42", notify = [Notify.Failure] }
  let _ = c.send(raw) catch e {
    panic(e.message())
  }
  c.quit() catch e {
    panic(e.message())
  }
  let sent = <- log
  assert(
    contains(r.writes[0], "RET=HDRS ENVID=msg+2042 REQUIRETLS SIZE=${len(raw.data)}\r\n"),
    "MAIL guarantees lost",
  )
  assert(
    contains(r.writes[0], "NOTIFY=FAILURE ORCPT=rfc822;a@x.com\r\nDATA\r\n"),
    "RCPT guarantees lost",
  )
  assert(len(r.writes) == 3 && unstuffed(sent) == raw.data, "pre-rendered signature bytes changed")
}

test "PIPELINING partial 251 451 and 550 replies retain ordered recipient outcomes" {
  let (c, log) = fakeClient(
    [
      "250 OK\r\n", "251 Forwarded\r\n", "451 Busy\r\n", "550 No user\r\n", "354 Go\r\n", "250 Queued\r\n", "221 Bye\r\n",
    ],
  )
  let r = recordPipeline(c)
  let d = c.send(threeRecipients()) catch e {
    panic(e.message())
  }
  c.quit() catch e {
    panic(e.message())
  }
  let _ = <- log
  assert(len(d.accepted) == 1 && d.accepted[0] == "a@x.com", "251 forwarding was refused")
  assert(len(d.rejected) == 2 && d.rejected[0].address == "bad@x.com", "recipient order changed")
  assert(
    d.rejected[0].error.transient() && !d.rejected[1].error.transient(),
    "retry classifications changed",
  )
  assert(len(r.writes) == 3, "partial refusals reset or fragmented the group")
}
