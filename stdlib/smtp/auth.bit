// Bit standard library — smtp module: SMTP authentication (#3967).
//
// The one rule: a credential never leaves this process over a connection that
// is not TLS. `requireSecure` is called BEFORE the AUTH command is built, so a
// server that offers `AUTH PLAIN` on a cleartext port draws zero credential
// bytes — not a truncated exchange, not an AUTH command with an empty initial
// response, nothing. A silent downgrade that puts a password in the clear is
// strictly worse than not sending the mail, and a caller cannot opt out of this
// one: there is no argument that turns it off.
//
// PLAIN (RFC 4616) and LOGIN are both here because real servers offer one or
// the other and neither is a superset. XOAUTH2 and OAUTHBEARER (RFC 7628) are
// here because Google Workspace and Exchange Online turned password SMTP off and
// take only an OAuth2 access token (#6875). One method, `Client.auth`, takes an
// `Auth` value (#6874): a mechanism is a variant, never another method.
//
// The token is a credential like the password: it is checked before anything is
// sent, it goes on the wire exactly once, and no error text carries it.

import { decodeBase64 } from "std/crypto"
import { Json, jsonParse, jsonGet, jsonAsString } from "std/json"

// The credentials a `Client.auth` call authenticates with; the variant picks the
// SASL mechanism.
//
//   Plain(user, password)   SASL PLAIN (RFC 4616), one initial response
//   Login(user, password)   SASL LOGIN, the two values as two challenge responses
//   Xoauth2(user, token)    XOAUTH2, an OAuth2 access token (Gmail, Microsoft 365)
//   OauthBearer(user, token)  OAUTHBEARER (RFC 7628), an OAuth2 access token
export enum Auth {
  Plain(string, string),
  Login(string, string),
  Xoauth2(string, string),
  OauthBearer(string, string),
}

// The SASL mechanism name `a` selects, as it appears on the `AUTH` command line
// and in the server's `AUTH` capability.
fn mechanismOf(a: Auth): string {
  match (a) {
    Plain(_, _) => return "PLAIN"
    Login(_, _) => return "LOGIN"
    Xoauth2(_, _) => return "XOAUTH2"
    OauthBearer(_, _) => return "OAUTHBEARER"
  }
}

// Reject a credential in `a` that could end the AUTH line. Never repeats the
// credential: the error names the field only.
fn checkAuth(a: Auth): ()!SmtpError {
  match (a) {
    Plain(user, pass) => {
      checkCredential("username", user)?
      checkCredential("password", pass)?
    }
    Login(user, pass) => {
      checkCredential("username", user)?
      checkCredential("password", pass)?
    }
    Xoauth2(user, token) => checkOauth(user, token)?
    OauthBearer(user, token) => checkOauth(user, token)?
  }
}

// Reject an OAuth credential that could end the AUTH line or break the
// `\x01`-delimited response. Both fields sit between `\x01` separators, so a
// `\x01` in either would start a field of the caller's choosing. Names the
// field only; the token is never repeated.
fn checkOauth(user: string, token: string): ()!SmtpError {
  checkOauthField("username", user)?
  checkOauthField("token", token)?
}

fn checkOauthField(what: string, v: string): ()!SmtpError {
  checkCredential(what, v)?
  let i = 0
  while (i < len(v)) {
    if (v[i] == u8(1)) {
      fail localError("${what} contains a CR, LF, NUL or 0x01 byte")
    }
    i = i + 1
  }
}

// Whether the EHLO capability lines `exts` advertise SASL mechanism `mech`.
// Reads the `AUTH` line (RFC 4954 §3: `AUTH` followed by space-separated
// mechanism names, case-insensitive) and the legacy `AUTH=` spelling some
// servers still send alongside it.
fn authOffered(exts: []string, mech: string): bool {
  for m of authMechanisms(exts) {
    if (m == mech) {
      return true
    }
  }
  return false
}

// The SASL mechanisms the EHLO capability lines `exts` advertise, upper-cased,
// in the order the server listed them, from the `AUTH` line and its legacy
// `AUTH=` spelling. Empty when the server advertised no `AUTH`.
fn authMechanisms(exts: []string): []string {
  let out = []string(0)
  let i = 0
  while (i < len(exts)) {
    let line = toUpper(exts[i])
    if (hasPrefix(line, "AUTH ") || hasPrefix(line, "AUTH=")) {
      for w of split(replace(line[5:], "=", " "), " ") {
        if (len(w) > 0) {
          out = append(out, w)
        }
      }
    }
    i = i + 1
  }
  return out
}

// Refuse an authentication attempt on a connection that is neither implicit TLS
// nor post-STARTTLS. `secure` is `Client.secure`, which is set by the stream
// swap itself, so it cannot drift from what the socket actually is.
fn requireSecure(secure: bool, mechanism: string): ()!SmtpError {
  if (!secure) {
    fail localError("refusing AUTH ${mechanism} on a connection that is not TLS; " + "use dialTls or startTls first")
  }
}

// A credential may not carry a NUL (PLAIN's own field separator), a CR or an LF
// (which would end the AUTH line and start a command of the caller's choosing).
// Base64 would hide all three from the eye, not from the server.
fn checkCredential(what: string, v: string): ()!SmtpError {
  if (hasControlByte(v)) {
    fail localError("${what} contains a CR, LF or NUL byte")
  }
}

// The PLAIN initial response: `\0user\0pass`, base64 (RFC 4616 §2). The
// authorization identity is left empty, which asks the server to use the
// authentication identity — the only sensible default for a client that was
// given one username.
fn plainResponse(user: string, pass: string): string {
  return encodeBase64([]byte("\x00${user}\x00${pass}"))
}

// The XOAUTH2 initial response (Google's "XOAUTH2 Protocol" and Microsoft's
// Exchange Online SMTP OAuth guide): `user=<user>\x01auth=Bearer <token>\x01\x01`,
// base64.
fn xoauth2Response(user: string, token: string): string {
  return encodeBase64([]byte("user=${user}\x01auth=Bearer ${token}\x01\x01"))
}

// The OAUTHBEARER initial response (RFC 7628 §3.1): the GS2 header
// `n,a=<user>,` with `,` as `=2C` and `=` as `=3D` (RFC 5801 §4), then the
// `host`, `port` and `auth` fields of the dialed endpoint, each ended by `\x01`,
// and a final `\x01`. base64.
fn oauthBearerResponse(user: string, host: string, port: int, token: string): string {
  let gs2 = "n,a=${gs2Escape(user)},"
  return encodeBase64([]byte("${gs2}\x01host=${host}\x01port=${port}\x01auth=Bearer ${token}\x01\x01"))
}

// RFC 5801 §4: `=` is written `=3D` and `,` is written `=2C`; `=` goes first so
// the `=` it introduces is not escaped again.
fn gs2Escape(user: string): string {
  return replace(replace(user, "=", "=3D"), ",", "=2C")
}

// What an XOAUTH2 or OAUTHBEARER error challenge says (RFC 7628 §3.2.2): the
// `status` and `scope` members of the base64 JSON the server sent in its `334`
// reply, as `OAuth status=401 scope=...`. "" when the challenge is not base64
// JSON or carries neither member. Only those two members are read, so nothing
// else the server put in the challenge reaches an error.
fn oauthDetail(r: Reply): string {
  if (len(r.lines) == 0) {
    return ""
  }
  let raw = decodeBase64(r.lines[0]) catch _ {
    return ""
  }
  let j = jsonParse(string(raw)) catch _ {
    return ""
  }
  let parts = []string(0)
  let status = memberText(j, "status")
  if (len(status) > 0) {
    parts = append(parts, status)
  }
  let scope = memberText(j, "scope")
  if (len(scope) > 0) {
    parts = append(parts, scope)
  }
  if (len(parts) == 0) {
    return ""
  }
  return "OAuth " + join(parts, " ")
}

// `key=value` for the string member `key` of `j`, or "" when it has none.
fn memberText(j: Json, key: string): string {
  let v = jsonGet(j, key)
  if (!isSome(v)) {
    return ""
  }
  let s = jsonAsString(unwrap(v))
  if (!isSome(s)) {
    return ""
  }
  return "${key}=${unwrap(s)}"
}
