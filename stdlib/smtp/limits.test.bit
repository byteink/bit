// stdlib/smtp/limits.test.bit — `Client.limits`, the RFC 9422 LIMITS extension
// parsed from the last EHLO (#6873).
//
// `startFake` and the client surface are module siblings (SPEC §19). Every case
// drives a real EHLO against the fake and reads `limits()` back; the expected
// pair is (rcptMax, mailMax), 0 for a cap not advertised.

// A greeted client whose EHLO reply carries `lines` as capability lines.
fn limitsClient(lines: []string): Client {
  let reply = "250-fake.example.com\r\n"
  let i = 0
  while (i < len(lines)) {
    reply = reply + "250-${lines[i]}\r\n"
    i = i + 1
  }
  reply = reply + "250 SIZE 35882577\r\n"
  let (port, _) = startFake([reply, "221 Bye\r\n"]) catch e {
    panic("startFake: ${e.message()}")
  }
  let c = dial("127.0.0.1", port) catch e {
    panic("dial: ${e.message()}")
  }
  c.ehlo("client.example.com") catch e {
    panic("ehlo: ${e.message()}")
  }
  return c
}

// Assert the caps a server advertising `lines` yields.
fn expectLimits(lines: []string, rcpt: int, mail: int) {
  let c = limitsClient(lines)
  let l = c.limits()
  assert(l.rcptMax == rcpt, "${join(lines, " | ")}: rcptMax = ${l.rcptMax}, want ${rcpt}")
  assert(l.mailMax == mail, "${join(lines, " | ")}: mailMax = ${l.mailMax}, want ${mail}")
  c.close()
}

test "both caps are read from the LIMITS line" {
  expectLimits(["LIMITS RCPTMAX=50 MAILMAX=1000"], 50, 1000)
}

test "the RFC 9422 example line" {
  expectLimits(["SMTPUTF8", "LIMITS RCPTMAX=20 MAILMAX=5", "PIPELINING"], 20, 5)
}

test "names and the keyword are case-insensitive and an unknown name is skipped" {
  expectLimits(["limits mailmax=5 FOO=1"], 0, 5)
  expectLimits(["LIMITS RCPTDOMAINMAX=3 RcptMax=7"], 7, 0)
}

test "a malformed value drops that limit only" {
  expectLimits(["LIMITS RCPTMAX=abc"], 0, 0)
  expectLimits(["LIMITS RCPTMAX=abc MAILMAX=9"], 0, 9)
  expectLimits(["LIMITS RCPTMAX=0 MAILMAX=007"], 0, 0)
  expectLimits(["LIMITS RCPTMAX=-4 MAILMAX=1.5"], 0, 0)
  expectLimits(["LIMITS RCPTMAX= MAILMAX=9"], 0, 0)
}

test "a value is one to six digits: 1 and 999999 read, 1000000 does not" {
  expectLimits(["LIMITS RCPTMAX=1 MAILMAX=999999"], 1, 999999)
  expectLimits(["LIMITS RCPTMAX=1000000 MAILMAX=999999"], 0, 999999)
  expectLimits(["LIMITS RCPTMAX=99999999999999999999"], 0, 0)
}

test "a parameter that breaks the basic syntax is ignored whole" {
  expectLimits(["LIMITS RCPTMAX=5  MAILMAX=9"], 0, 0)
  expectLimits(["LIMITS RCPTMAX=5 MAILMAX=9 "], 0, 0)
  expectLimits(["LIMITS RCPTMAX=5 =9"], 0, 0)
  expectLimits(["LIMITS RCPTMAX=5 MAIL.MAX=9"], 0, 0)
  expectLimits(["LIMITS RCPTMAX=5;MAILMAX=9"], 0, 0)
}

test "a name with no value is legal syntax and reads as not advertised" {
  expectLimits(["LIMITS RCPTMAX MAILMAX=9"], 0, 9)
}

test "a repeated name keeps the first readable value" {
  expectLimits(["LIMITS RCPTMAX=5 RCPTMAX=9"], 5, 0)
  expectLimits(["LIMITS RCPTMAX=x RCPTMAX=9"], 9, 0)
}

test "no LIMITS line, a bare LIMITS and a look-alike keyword give no caps" {
  expectLimits([], 0, 0)
  expectLimits(["LIMITS"], 0, 0)
  expectLimits(["LIMITSX RCPTMAX=5", "XLIMITS RCPTMAX=5"], 0, 0)
}

test "limits are zero before ehlo" {
  let (port, _) = startFake(["221 Bye\r\n"]) catch e {
    assert(false, "startFake: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let l = c.limits()
  assert(l.rcptMax == 0 && l.mailMax == 0, "before ehlo: (${l.rcptMax}, ${l.mailMax})")
  c.close()
}

test "a second EHLO without LIMITS discards the first one's caps" {
  let (port, _) = startFake(
    [
      "250-fake.example.com\r\n250 LIMITS RCPTMAX=5 MAILMAX=6\r\n",
      "250-fake.example.com\r\n250 SIZE 35882577\r\n", "221 Bye\r\n",
    ],
  ) catch e {
    assert(false, "startFake: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  c.ehlo("client.example.com") catch e {
    assert(false, "ehlo 1: ${e.message()}")
    return
  }
  let a = c.limits()
  assert(a.rcptMax == 5 && a.mailMax == 6, "first: (${a.rcptMax}, ${a.mailMax})")
  c.ehlo("client.example.com") catch e {
    assert(false, "ehlo 2: ${e.message()}")
    return
  }
  let b = c.limits()
  assert(b.rcptMax == 0 && b.mailMax == 0, "second: (${b.rcptMax}, ${b.mailMax})")
  c.close()
}
