// Bit standard library — smtp module: the one error type every fallible call in
// the module fails with (#6857).
//
// A relay that retries has to tell "try again later" from "this will never
// work", and a string cannot say which. `SmtpError` carries what the server
// said (`code`, `enhanced`, `text`), which step it said it at (`command`), and
// `transient()`, the single answer a retry loop needs.
//
// The module builds an error through one of the five constructors below, never
// by a literal at the failure site, so what a field means is decided here once.

import { HandshakeError, HandshakeFailure } from "std/tls"

// Why an SMTP step failed.
//
//   code      the reply code (RFC 5321 §4.2) the server answered with; 0 when
//             no reply was involved: a network or TLS failure, an unparsable
//             reply, or a refusal made locally before anything was sent.
//   enhanced  the RFC 3463 status (`5.1.1`) the server put at the start of its
//             reply text (RFC 2034), or "" when it sent none.
//   text      the server's text joined by " " with the enhanced status taken
//             off, or the local reason when `code` is 0.
//   command   the step that failed: "connect", "greeting", "EHLO", "STARTTLS",
//             "AUTH PLAIN", "AUTH LOGIN", "MAIL FROM", "RCPT TO", "DATA",
//             "end of DATA", "RSET", "NOOP", "QUIT", or "validate" for a refusal made locally
//             because of what the caller supplied or the order it called in.
//   cause     the `std/net` or `std/tls` error under a transport failure, nil
//             when there is none. A failed TLS handshake is a `HandshakeError`
//             (#6983), so `e.cause.(HandshakeError)` says whether the
//             certificate, the negotiation or the network was at fault.
export class SmtpError {
  export code: int
  export enhanced: string
  export text: string
  export command: string
  export cause: error

  // Whether sending the same message again later can succeed: a 4xx reply
  // (RFC 5321 §4.2.1 "transient negative completion") and a failure with no
  // reply at all, which is the network's or the peer's. A 5xx reply, an
  // unexpected 2xx or 3xx, and a local validation failure are not: the same
  // input draws the same answer. Neither is a TLS handshake the server's
  // certificate or its negotiation failed (#6983): it will present the same
  // certificate and offer next time. A handshake cut off by the network is.
  export transient(): bool {
    if (this.code == 0) {
      return this.command != "validate" && !this.tlsRefused()
    }
    return this.code >= 400 && this.code < 500
  }

  // Whether the cause is a TLS handshake that failed on verification or
  // negotiation, rather than on the transport.
  tlsRefused(): bool {
    let (h, ok) = this.cause.(HandshakeError)
    return ok && h.kind != HandshakeFailure.Io
  }

  // The failure as one line, in the wording the module has always used:
  // `smtp: RCPT TO got 550: 5.1.1 No such user` for a reply, `smtp: <reason>`
  // for everything without one.
  export message(): string {
    if (this.code == 0) {
      return "smtp: ${this.text}"
    }
    if (len(this.enhanced) > 0) {
      return "smtp: ${this.command} got ${this.code}: ${this.enhanced} ${this.text}"
    }
    return "smtp: ${this.command} got ${this.code}: ${this.text}"
  }
}

// The error for `r`, a reply other than the one `command` expected. The
// enhanced status is read off the first line only: RFC 2034 puts it at the
// start of every line of a reply, and the first is the one a server cannot omit.
fn replyError(command: string, r: Reply): SmtpError {
  let first = ""
  if (len(r.lines) > 0) {
    first = r.lines[0]
  }
  let at = enhancedLen(first)
  if (at == 0) {
    return SmtpError{ code = r.code, enhanced = "", text = join(r.lines, " "), command = command }
  }
  let rest = r.lines[1:]
  let text = first[at + 1:]
  if (len(rest) > 0) {
    text = text + " " + join(rest, " ")
  }
  return SmtpError{ code = r.code, enhanced = first[0:at], text = text, command = command }
}

// The error for a refusal made before anything reached the wire, because of
// what the caller supplied or the order it called in. Permanent: the same call
// fails the same way.
fn localError(reason: string): SmtpError {
  return SmtpError{ code = 0, enhanced = "", text = reason, command = "validate" }
}

// The error for a transport failure at `command`: a refused connect, a reset,
// a timeout, a failed TLS handshake. `e` is the `std/net` or `std/tls` error.
fn ioError(command: string, e: error): SmtpError {
  return SmtpError{ code = 0, enhanced = "", text = e.message(), command = command, cause = e }
}

// The error for `command` running past its deadline (#6856): the peer accepted
// the connection or the previous step and then went quiet. There is no reply, so
// `code` is 0 and `transient()` is true: a later attempt may meet a peer that
// answers. `cause` is the `std/net` deadline error, or nil when the transport
// reported the timeout as an end of stream.
fn timeoutError(command: string, ms: int, cause: error): SmtpError {
  return SmtpError{
    code = 0, enhanced = "", text = "${command} timed out after ${ms}ms", command = command, cause = cause,
  }
}

// The error for a peer that broke the protocol at `command`: a reply that is
// not three digits and a separator, a changed code mid-reply, an unterminated
// stream. There is no reply to read a code from, and a retry may meet a
// healthier peer.
fn protoError(command: string, reason: string): SmtpError {
  return SmtpError{ code = 0, enhanced = "", text = reason, command = command }
}

// The length of the RFC 3463 status code at the start of `line`, or 0 when
// there is none: `[245].X.Y` with one to three digits each, followed by a space
// (RFC 2034 §4). The text starts one byte after the returned length.
fn enhancedLen(line: string): int {
  if (len(line) < 6 || !isEnhancedClass(line[0]) || line[1] != u8(46)) {
    return 0
  }
  let mid = numberEnd(line, 2)
  if (mid < 0 || !byteIs(line, mid, 46)) {
    return 0
  }
  let end = numberEnd(line, mid + 1)
  if (end < 0 || !byteIs(line, end, 32)) {
    return 0
  }
  return end
}

// RFC 3463 §2: the class is 2 (success), 4 (persistent transient) or 5
// (permanent).
fn isEnhancedClass(c: u8): bool {
  return c == u8(50) || c == u8(52) || c == u8(53)
}

// Whether `s[at]` exists and equals `want`.
fn byteIs(s: string, at: int, want: int): bool {
  return at < len(s) && s[at] == u8(want)
}

// The index just past the run of one to three ASCII digits starting at `at`,
// or -1 when the run is empty or longer than three. Looks at no more than four
// bytes, so a hostile reply cannot make this loop long.
fn numberEnd(s: string, at: int): int {
  let n = 0
  while (n < 4 && at + n < len(s) && s[at + n] >= u8(48) && s[at + n] <= u8(57)) {
    n = n + 1
  }
  if (n == 0 || n > 3) {
    return -1
  }
  return at + n
}
