// Bit standard library — smtp module: the envelope and pre-rendered mail
// (#6865).
//
// An SMTP envelope (`MAIL FROM`, `RCPT TO`) is not the message's headers. A
// bounce address (VERP) differs from `From`, a staging redirect delivers to an
// address no header names, and a DKIM signature covers the exact bytes that
// were rendered, so whoever signed them must send them untouched. `Client.send`
// takes a `Sendable` for that reason: a `Message` renders itself and derives its
// envelope, a `Raw` carries both from the caller. One method, one code path.

// Who the mail is from and for, on the wire.
//
//   from  the `MAIL FROM` addr-spec. "" is the null reverse-path `<>`, the
//         sender a bounce uses so that a bounce is never bounced.
//   to    every `RCPT TO` addr-spec, at least one. Bcc recipients belong here
//         and nowhere in the headers.
//
// Every address goes through `checkAddress`, so one carrying a CR, LF or space
// is refused before `MAIL FROM` is sent.
export class Envelope {
  export from: string,
  export to: []string,
}

// What `Client.send` did with the recipients of one message (#6866).
//
//   accepted  the recipients the server took, in envelope order. The message was
//             handed to the server for every one of them.
//   rejected  the recipients it refused, in envelope order, each with the reply
//             that said so. These did not get the message.
//   queueId   the server's reply to the end of DATA with its code taken off,
//             for example "2.0.0 Ok: queued as 4Bx1". The only handle a relay
//             gives to look the message up later.
//
// `send` returns one only when `accepted` is not empty: a message nobody took
// is a failure, not a Delivery with nothing in it.
export class Delivery {
  export accepted: []string,
  export rejected: []Rejection,
  export queueId: string,
}

// One recipient the server refused at `RCPT TO`, with the reply it gave:
// `error.code`, `error.enhanced` (`5.1.1`) and `error.text`, and
// `error.transient()` to tell a mailbox that is busy from one that does not
// exist.
export class Rejection {
  export address: string,
  export error: SmtpError,
}

// The error for a message whose every recipient was refused: the last refusal's
// reply, with the address of each refused recipient appended to its text so a
// caller that only logs the error still sees who was refused.
fn allRefused(rejected: []Rejection): SmtpError {
  let last = rejected[len(rejected) - 1].error
  let names = []string(0)
  let i = 0
  while (i < len(rejected)) {
    names = append(names, rejected[i].address)
    i = i + 1
  }
  return SmtpError{
    code = last.code,
    enhanced = last.enhanced,
    text = "${last.text} (refused: ${join(names, ", ")})",
    command = last.command,
  }
}

// Something `Client.send` can transmit: the complete RFC 5322 message and the
// envelope to deliver it under. Both are produced, and so validated, before the
// first `MAIL FROM`, so a refusal costs zero transmitted bytes.
export interface Sendable {
  render(): string!SmtpError,
  envelope(): Envelope,
}

// A message that is already rendered, with the envelope it goes out under.
// `data` is sent byte for byte, so a DKIM-signed message keeps its signature:
// only DATA dot-stuffing is applied on the wire, and the server removes it.
// `render` refuses, rather than rewrites, data that is not a well-formed
// message: a bare LF or CR, a NUL, a line of 998 octets or more, a missing
// blank line between header and body, or a last line without its CRLF.
export class Raw {
  export env: Envelope
  export data: string

  init(env: Envelope, data: string) {
    this.env = env
    this.data = data
  }

  export render(): string!SmtpError {
    checkRaw(this.data)?
    return this.data
  }

  export envelope(): Envelope {
    return this.env
  }
}

// Refuse an envelope with no recipient or with an address `checkAddress`
// rejects. An empty `from` is the null reverse-path and is the one empty
// address allowed.
fn checkEnvelope(e: Envelope): ()!SmtpError {
  if (len(e.from) > 0) {
    checkAddress("sender", e.from)?
  }
  if (len(e.to) == 0) {
    fail localError("the envelope has no recipients")
  }
  let i = 0
  while (i < len(e.to)) {
    checkAddress("recipient", e.to[i])?
    i = i + 1
  }
}

// Validate `data` as a complete message ready for DATA, reporting the 1-based
// line that breaks the rules. Nothing is rewritten: normalising a line ending
// would change the body a DKIM `bh=` hash was computed over.
fn checkRaw(data: string): ()!SmtpError {
  let line = 1
  let start = 0
  let blank = false
  let i = 0
  while (i < len(data)) {
    let c = data[i]
    if (c == u8(0)) {
      fail localError("raw message line ${line} contains a NUL byte")
    }
    if (c == u8(10)) {
      fail localError("raw message line ${line} ends in a bare LF, not CRLF")
    }
    if (c != u8(13)) {
      i = i + 1
      continue
    }
    checkRawLine(data, line, start, i)?
    blank = blank || i == start
    i = i + 2
    line = line + 1
    start = i
  }
  if (start != len(data)) {
    fail localError("raw message line ${line} does not end in CRLF")
  }
  if (!blank) {
    fail localError("raw message has no blank line between header and body")
  }
}

// The CR at `cr` ends line `line`, which began at `start`: it must be followed
// by an LF, and the line must stay under the octet ceiling with room for the
// dot-stuffing byte (`maxBodyLineOctets`, mime.bit).
fn checkRawLine(data: string, line: int, start: int, cr: int): ()!SmtpError {
  if (cr + 1 >= len(data) || data[cr + 1] != u8(10)) {
    fail localError("raw message line ${line} has a bare CR")
  }
  if (cr - start > maxBodyLineOctets) {
    fail localError("raw message line ${line} is ${cr - start} octets, over ${maxBodyLineOctets}")
  }
}
