// RFC 1870 counts rendered octets, not DATA quoting or its terminating dot.
// The scripted server and raw-message helpers are module siblings.

fn renderedSize(m: Sendable): int {
  let data = m.render() catch e {
    panic(e.message())
  }
  return len(data)
}

fn sizeEhlo(advertisement: string): string {
  if (len(advertisement) == 0) {
    return "250 fake.example.com\r\n"
  }
  return "250-fake.example.com\r\n250 ${advertisement}\r\n"
}

fn sizeTranscript(advertisement: string, m: Sendable): string {
  let (c, log) = fakeClientEhlo(
    sizeEhlo(advertisement),
    ["250 OK\r\n", "250 OK\r\n", "354 Go\r\n", "250 Queued\r\n"],
  )
  c.send(m) catch e {
    panic(e.message())
  }
  c.close()
  return <- log
}

// Count the server's unquoted payload independently of the renderer.
fn generatedSizePayload(m: Message): string {
  let sent = sizeTranscript("SIZE 10000", m)
  let data = unstuffed(sent)
  assert(contains(sent, " SIZE=${len(data)}\r\n"), "SIZE differs from DATA: ${sent}")
  return data
}

test "generated SIZE includes exactly the body line endings received after DATA" {
  let texts = ["", "Inkwell", "Inkwell\r\n", "Inkwell\r\n\r\n", ".", ".draft\nnext\rline"]
  let bodies = [
    "",
    "Inkwell\r\n",
    "Inkwell\r\n",
    "Inkwell\r\n\r\n",
    ".\r\n",
    ".draft\r\nnext\r\nline\r\n",
  ]
  let i = 0
  while (i < len(texts)) {
    let m = plainMessage()
    m.setText(texts[i])
    let data = generatedSizePayload(m)
    let at = strIndexOf(data, "\r\n\r\n") + 4
    assert(data[at:] == bodies[i], "body ${i}: '${data[at:]}'")
    i = i + 1
  }
}

test "generated SIZE agrees with quoted-printable base64 and multipart DATA" {
  let texts = ["Inkwell é", repeat("مرحبا بكم ", 8), "Inkwell"]
  let i = 0
  while (i < len(texts)) {
    let m = plainMessage()
    m.setText(texts[i])
    if (i == 2) {
      m.setHtml("<p>Inkwell</p>")
    }
    let data = generatedSizePayload(m)
    assert(hasSuffix(data, "\r\n"), "unterminated generated message")
    i = i + 1
  }
}

test "generated SIZE exact maximum includes the missing input line ending" {
  let m = plainMessage()
  m.setText("Inkwell")
  let size = renderedSize(m)
  let sent = sizeTranscript("SIZE ${size}", m)
  assert(len(unstuffed(sent)) == size, "accepted DATA exceeded SIZE")
  assert(contains(sent, " SIZE=${size}\r\n"), sent)
}

test "generated SIZE one byte over the maximum refuses before MAIL and permits reuse" {
  let m = plainMessage()
  m.setText("Inkwell")
  let size = renderedSize(m)
  let (c, log) = fakeClientEhlo(
    sizeEhlo("SIZE ${size - 1}"),
    ["250 OK\r\n", "250 OK\r\n", "354 Go\r\n", "250 Queued\r\n"],
  )
  c.send(m) catch e {
    assert(e.command == "validate" && !e.transient() && c.reusable(), e.message())
    assert(
      e.message() == "smtp: message is ${size} octets, the server accepts at most ${size - 1}",
      e.message(),
    )
    m.setText("")
    c.send(m) catch err {
      panic(err.message())
    }
    c.close()
    let sent = <- log
    assert(len(split(sent, "MAIL FROM:")) == 2, "oversize MAIL reached wire: ${sent}")
    assert(len(split(sent, "RCPT TO:")) == 2, "oversize RCPT reached wire: ${sent}")
    assert(len(split(sent, "\r\nDATA\r\n")) == 2, "oversize DATA reached wire: ${sent}")
    assert(len(unstuffed(sent)) == renderedSize(m), "retry SIZE differs from DATA")
    return
  }
  c.close()
  panic("oversize generated message was accepted")
}

test "SIZE exact boundary accepts the unquoted CRLF message octets" {
  let data = rawMessage()
  let raw = Raw(Envelope{ from = "me@x.com", to = ["a@x.com"] }, data)
  let sent = sizeTranscript("size ${len(data)}", raw)
  assert(contains(sent, "MAIL FROM:<me@x.com> SIZE=${len(data)}\r\n"), sent)
  assert(contains(sent, "\r\n..dotted\r\n..\r\n"), "dot quoting lost: ${sent}")
  assert(unstuffed(sent) == data, "the message changed")
}

test "SIZE oversize is a local permanent refusal before MAIL and DATA" {
  let data = "Subject: Size\r\n\r\n" + repeat("x", 989) + "\r\n" + repeat("y", 990) + "\r\n"
  assert(len(data) == 2000, "fixture is ${len(data)} octets")
  let raw = Raw(Envelope{ from = "me@x.com", to = ["a@x.com"] }, data)
  let (c, log) = fakeClientEhlo(sizeEhlo("SIZE 1000"), ["221 Bye\r\n"])
  let e = refusal(c, raw)
  let reusable = c.reusable()
  c.close()
  let sent = <- log
  assert(sent == "EHLO client.example.com\r\n", "MAIL or DATA reached the wire: ${sent}")
  assert(
    e.message() == "smtp: message is 2000 octets, the server accepts at most 1000",
    e.message(),
  )
  assert(e.code == 0 && e.command == "validate" && !e.transient(), "not a local permanent error")
  assert(reusable, "local refusal lost the session")
}

test "bare zero malformed and overflowing SIZE retain no fixed maximum" {
  let caps = [
    "SIZE",
    "SIZE 0",
    "SIZE 000",
    "SIZE x",
    "SIZE -1",
    "SIZE +1",
    "SIZE 1 2",
    "SIZE 9223372036854775808",
  ]
  let raw = Raw(Envelope{ from = "me@x.com", to = ["a@x.com"] }, rawMessage())
  let i = 0
  while (i < len(caps)) {
    let sent = sizeTranscript(caps[i], raw)
    assert(contains(sent, "MAIL FROM:<me@x.com> SIZE=${len(raw.data)}\r\n"), "${caps[i]}: ${sent}")
    i = i + 1
  }
}

test "absent and lookalike SIZE send no parameter" {
  let caps = ["", "SIZEX 1", "XSIZE 1"]
  let raw = Raw(Envelope{ from = "me@x.com", to = ["a@x.com"] }, rawMessage())
  let i = 0
  while (i < len(caps)) {
    let sent = sizeTranscript(caps[i], raw)
    assert(contains(sent, "MAIL FROM:<me@x.com>\r\n"), sent)
    i = i + 1
  }
}

test "SIZE parser reads digits and checks overflow without inventing a bound" {
  let caps = [
    "SIZE 00042",
    "size 9223372036854775807",
    "SIZE 9223372036854775808",
    "SIZE +1",
    "SIZE 1 2",
    "SIZE",
    "SIZE 0",
    "SIZEX 1",
  ]
  let wants = [42, 9223372036854775807, 0, 0, 0, 0, 0, 0]
  assert(len(caps) == len(wants), "unpaired cases")
  let i = 0
  while (i < len(caps)) {
    let (c, log) = fakeClientEhlo(sizeEhlo(caps[i]), ["221 Bye\r\n"])
    assert(c.maxSize() == wants[i], "${caps[i]}: ${c.maxSize()}")
    c.close()
    let _ = <- log
    i = i + 1
  }
}

test "SIZE uses only the latest EHLO and is absent before greeting" {
  let (port, log) = startFake(
    [sizeEhlo("SIZE 1"), sizeEhlo(""), "250 OK\r\n", "250 OK\r\n", "354 Go\r\n", "250 Queued\r\n"],
  ) catch e {
    panic(e.message())
  }
  let c = dial("127.0.0.1", port) catch e {
    panic(e.message())
  }
  assert(c.maxSize() == 0, "a limit existed before EHLO")
  c.ehlo("client.example.com") catch e {
    panic(e.message())
  }
  assert(c.maxSize() == 1, "first EHLO lost its bound")
  c.ehlo("client.example.com") catch e {
    panic(e.message())
  }
  assert(c.maxSize() == 0, "stale EHLO bound")
  c.send(Raw(Envelope{ from = "me@x.com", to = ["a@x.com"] }, rawMessage())) catch e {
    panic(e.message())
  }
  c.close()
  let sent = <- log
  assert(contains(sent, "MAIL FROM:<me@x.com>\r\n"), sent)
}

test "SIZE composes with DSN and verified onward REQUIRETLS" {
  let o = pinnedOptions() catch e {
    panic(e.message())
  }
  let (c, log) = requireTlsClient(
    o,
    "250-fake.example.com\r\n250-DSN\r\n250-REQUIRETLS\r\n250 SIZE 1000\r\n",
    ["250 OK\r\n", "250 OK\r\n", "354 Go\r\n", "250 Queued\r\n"],
  )
  let raw = requireTlsRaw()
  raw.env.dsn = Dsn{ ret = Ret.Headers, envid = "msg 42", notify = [Notify.Failure] }
  c.send(raw) catch e {
    panic(e.message())
  }
  c.close()
  let sent = <- log
  assert(
    contains(
      sent,
      "MAIL FROM:<me@x.com> RET=HDRS ENVID=msg+2042 REQUIRETLS SIZE=${len(raw.data)}\r\n",
    ),
    sent,
  )
  assert(contains(sent, "RCPT TO:<a@x.com> NOTIFY=FAILURE ORCPT=rfc822;a@x.com\r\n"), sent)
}
