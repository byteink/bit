// stdlib/smtp/mime.test.bit — base64 part wrapping and the cost of a render
// (#7155).
//
// `wrapBase64` used to append each 76-character line onto everything written
// before it, and every multipart level appended each part onto the parts
// before it, so a render was quadratic in the message size. These pin the
// bytes to the old wrapping's and the cost to a budget only a linear render
// meets. `plainMessage` is a module sibling in smtp.test.bit.

import { monotonic } from "std/time"

// The wrapping as it was before #7155: the reference the new one must match
// byte for byte. Quadratic, so it is only ever fed small inputs.
fn lineByLineWrap(b: []byte): string {
  let enc = encodeBase64(b)
  let out = ""
  let i = 0
  while (i < len(enc)) {
    let end = i + base64Width
    if (end > len(enc)) {
      end = len(enc)
    }
    out = out + enc[i:end] + "\r\n"
    i = end
  }
  return out
}

// `n` bytes of a pattern that reaches every byte value.
fn patternBytes(n: int, seed: int): []byte {
  let b = []byte(n)
  let i = 0
  while (i < n) {
    b[i] = u8((i * 131 + seed) % 256)
    i = i + 1
  }
  return b
}

// The milliseconds `m.render()` takes, failing the test when it does not
// render.
fn renderMs(m: Message): int {
  let t0 = monotonic().ns
  let _ = m.render() catch e {
    assert(false, "render: ${e.message()}")
    return 0
  }
  return (monotonic().ns - t0) / 1000000
}

test "wrapBase64 of nothing and of one byte" {
  assert(wrapBase64([]byte(0)) == "", "an empty part is not empty")
  assert(wrapBase64([]byte("M")) == "TQ==\r\n", "one byte = '${wrapBase64([]byte("M"))}'")
}

test "wrapBase64 matches the line-by-line wrapping at every line edge" {
  let sizes = [1, 2, 3, 56, 57, 58, 113, 114, 115, 4096]
  for n of sizes {
    let b = patternBytes(n, n)
    let got = wrapBase64(b)
    assert(
      got == lineByLineWrap(b),
      "wrapBase64 of ${n} bytes differs from the line-by-line wrapping",
    )
    assert(
      len(got) == base64Size(n),
      "${n} bytes wrap to ${len(got)} octets, base64Size says ${base64Size(n)}",
    )
  }
}

// Linear, the 2 MiB render takes 7 ms and the 6000 parts 31 ms; quadratic (one
// copy of the message so far per base64 line, then per part) they took 10.2 s
// and 6.2 s (#7155). A one-second budget is 30 times the slower linear render
// and a sixth of the faster quadratic one, so a loaded box cannot fail the
// first and no box passes the second.
test "rendering is linear in the attachment size and in the part count" {
  let big = plainMessage()
  big.attach(Attachment("big.bin", "application/octet-stream", patternBytes(2 * 1048576, 1)))
  let bigMs = renderMs(big)
  assert(bigMs < 1000, "a 2 MiB attachment took ${bigMs} ms to render")

  let many = plainMessage()
  let i = 0
  while (i < 6000) {
    many.attach(Attachment("f${i}.bin", "application/octet-stream", patternBytes(1024, i)))
    i = i + 1
  }
  let manyMs = renderMs(many)
  assert(manyMs < 1000, "6000 one-KiB attachments took ${manyMs} ms to render")
}
