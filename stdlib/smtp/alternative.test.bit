// stdlib/smtp/alternative.test.bit — extra multipart/alternative parts (#6864).
//
// The assertions are about BYTES: the rendered message. `plainMessage` is a
// module sibling in smtp.test.bit, so nothing here redefines it.

import { contains, indexOf as strIndexOf } from "std/strings"

const invite: string = "BEGIN:VCALENDAR\r\nMETHOD:REQUEST\r\nEND:VCALENDAR\r\n"
const inviteType: string = "text/calendar; method=REQUEST; charset=utf-8"

// The `render()` text of `m`, failing the test when it does not render.
fn altRender(m: Message): string {
  return m.render() catch e {
    assert(false, "render: ${e.message()}")
    return ""
  }
}

test "text, html and a calendar part render three parts in alternative, calendar last" {
  let m = plainMessage()
  m.setHtml("<p>Join us.</p>\r\n")
  m.addAlternative(inviteType, invite)
  let r = altRender(m)
  assert(
    contains(r, "Content-Type: multipart/alternative; boundary=\"bit-test-boundary\"\r\n"),
    "not a multipart/alternative",
  )
  let plain = strIndexOf(r, "Content-Type: text/plain; charset=utf-8")
  let html = strIndexOf(r, "Content-Type: text/html; charset=utf-8")
  let part = "Content-Type: ${inviteType}\r\nContent-Transfer-Encoding: 7bit\r\n\r\n${invite}"
  let cal = strIndexOf(r, part)
  assert(plain > 0 && html > plain, "text then html order is wrong")
  assert(cal > html, "the calendar part is not after the html part: ${r}")
  assert(contains(r, "method=REQUEST"), "the method parameter was lost")
  assert(contains(r, "\r\n--bit-test-boundary--\r\n"), "no close delimiter")
}

test "text and one alternative with no html is still a multipart/alternative" {
  let m = plainMessage()
  m.addAlternative(inviteType, invite)
  let r = altRender(m)
  assert(contains(r, "Content-Type: multipart/alternative;"), "not a multipart/alternative: ${r}")
  assert(!contains(r, "text/html"), "an html part appeared from nowhere")
  assert(contains(r, "Content-Type: ${inviteType}\r\n"), "the calendar part is missing")
}

test "alternatives keep call order" {
  let m = plainMessage()
  m.addAlternative("text/x-first", "one\r\n")
  m.addAlternative("text/x-second", "two\r\n")
  let r = altRender(m)
  let a = strIndexOf(r, "text/x-first")
  let b = strIndexOf(r, "text/x-second")
  assert(a > 0 && b > a, "alternatives are not in call order")
}

test "an alternative with an attachment sits inside the inner multipart/alternative" {
  let m = plainMessage()
  m.addAlternative(inviteType, invite)
  m.attach(Attachment("a.txt", "text/plain", []byte("x")))
  let r = altRender(m)
  assert(contains(r, "Content-Type: multipart/mixed;"), "not multipart/mixed")
  assert(
    contains(r, "Content-Type: multipart/alternative; boundary=\"bit-test-boundary_alt\""),
    "no inner alternative",
  )
  assert(
    strIndexOf(r, inviteType) < strIndexOf(r, "filename"),
    "calendar not before the attachment",
  )
}

test "a non-ASCII alternative body is encoded like a text part" {
  let m = plainMessage()
  m.addAlternative(inviteType, "SUMMARY:café\r\n")
  let r = altRender(m)
  assert(contains(r, "Content-Transfer-Encoding: quoted-printable\r\n"), "not quoted-printable")
  assert(contains(r, "SUMMARY:caf=C3=A9"), "the body was not encoded")
}

test "an alternative type that has its own setter or is malformed fails render" {
  let bad = [
    "text/html", "TEXT/HTML; charset=utf-8", "text/plain", "multipart/mixed",
    "Multipart/alternative", "", "text", "text/", "/calendar", "text/cal endar",
    "text/calendar;", "text/calendar; method", "text/calendar; method=",
    "text/calendar; m=\"unterminated", "text/calendar\r\nBcc: x@evil.example",
    "text/calendar; m=a\nb", "text/cal\u{0}endar", "text/calendar; m=a b",
  ]
  let i = 0
  while (i < len(bad)) {
    let m = plainMessage()
    m.addAlternative(bad[i], invite)
    let out = m.render() catch e {
      assert(
        e.message() == "smtp: '${bad[i]}' is not allowed as an alternative part",
        "wrong error for case ${i}: ${e.message()}",
      )
      i = i + 1
      continue
    }
    assert(false, "case ${i} '${bad[i]}' rendered ${len(out)} bytes instead of failing")
    return
  }
}

test "a quoted parameter value holding a semicolon is accepted" {
  let m = plainMessage()
  m.addAlternative("text/calendar; name=\"a;b\\\"c.ics\"; method=PUBLISH", invite)
  let r = altRender(m)
  assert(contains(r, "method=PUBLISH"), "the part was not rendered")
}
