fn utf8Ehlo(caps: string): string {
  return "250-fake.example.com\r\n" + caps + "250 SIZE 10000\r\n"
}

test "explicit international Message-ID keeps UTF8 atoms while Content-ID stays ASCII" {
  let m = plainMessage()
  m.setMessageId("é@例子.广告")
  let data = m.render() catch e {
    panic(e.message())
  }
  assert(contains(data, "Message-ID: <é@例子.广告>\r\n"), data)
  assert(!isDotAtom("é"), "ASCII Content-ID helper changed")
}

test "international address headers preserve mailbox bytes and encoded display names" {
  let m = Message(Address{ name = "作者", email = "作者@例子.广告" })
  m.addTo(Address{ name = "José", email = "josé@example.com" })
  m.addCc(Address{ email = "副本@example.com" })
  m.addBcc(Address{ email = "秘密@example.com" })
  m.addReplyTo(Address{ email = "回复@example.com" })
  m.setText("Inkwell")
  let data = m.render() catch e {
    panic(e.message())
  }
  assert(contains(data, "<作者@例子.广告>"), data)
  assert(contains(data, "<josé@example.com>"), data)
  assert(contains(data, "Cc: <副本@example.com>"), data)
  assert(contains(data, "Reply-To: <回复@example.com>"), data)
  assert(!contains(data, "秘密@example.com"), "Bcc leaked")
  assert(contains(data, "=?UTF-8?B?"), "display name was not encoded")
  assert(contains(data, "@例子.广告>\r\n"), "generated Message-ID rejected domain")
}

test "UTF8 local and total address limits count octets and malformed bytes fail" {
  checkAddress("recipient", repeat("é", 32) + "@example.com") catch e {
    panic(e.message())
  }
  checkAddress("recipient", "a@" + repeat("é", 126)) catch e {
    panic(e.message())
  }
  let malformed = Builder()
  let _ = malformed.write("a@").writeByte(u8(255)).write(".com")
  let bad = [repeat("é", 33) + "@example.com", "a@" + repeat("é", 127), malformed.toString()]
  let i = 0
  while (i < len(bad)) {
    let rejected = false
    checkAddress("recipient", bad[i]) catch _ {
      rejected = true
    }
    assert(rejected, "accepted malformed address")
    i = i + 1
  }
}

test "extensions inspect high bytes without treating long ASCII lines as eight bit" {
  let env = Envelope{ from = "a@example.com", to = ["b@example.com"] }
  let (utf8, eightBit) = messageExtensions(
    env,
    "Subject: " + repeat("x", 980) + "\r\n\r\n" + repeat("y", 980) + "\r\n",
  ) catch e {
    panic(e.message())
  }
  assert(!utf8 && !eightBit, "ASCII wrongly needs extensions")
  let (headerUtf8, headerEight) = messageExtensions(env, "Subject: Inkwell é\r\n\r\nASCII\r\n") catch e {
    panic(e.message())
  }
  assert(headerUtf8 && headerEight, "SMTPUTF8 must require 8BITMIME")
  let (bodyUtf8, bodyEight) = messageExtensions(env, "Subject: Inkwell\r\n\r\n\xff\r\n") catch e {
    panic(e.message())
  }
  assert(!bodyUtf8 && bodyEight, "arbitrary eight-bit body was treated as UTF8")
}

test "SMTPUTF8 emits paired MAIL parameters and exact recipient and Raw bytes" {
  let raw = Raw(
    Envelope{ from = "a@example.com", to = ["josé@example.com"] },
    "Subject: Inkwell\r\n\r\n.draft\r\n",
  )
  let (c, log) = fakeClientEhlo(
    utf8Ehlo("250-SMTPUTF8\r\n250-8BITMIME\r\n"),
    ["250 OK\r\n", "250 OK\r\n", "354 Go\r\n", "250 Queued\r\n"],
  )
  c.send(raw) catch e {
    panic(e.message())
  }
  c.close()
  let sent = <- log
  assert(contains(sent, " SIZE=${len(raw.data)} SMTPUTF8 BODY=8BITMIME\r\n"), sent)
  assert(contains(sent, "RCPT TO:<josé@example.com>\r\n"), sent)
  assert(unstuffed(sent) == raw.data, "signed bytes changed")
}

test "missing international capabilities refuse locally with no MAIL and reusable session" {
  let caps = ["250-8BITMIME\r\n", "250-SMTPUTF8\r\n", ""]
  let raw = Raw(
    Envelope{ from = "a@example.com", to = ["josé@example.com"] },
    "Subject: Inkwell\r\n\r\nDraft\r\n",
  )
  let i = 0
  while (i < len(caps)) {
    let (c, log) = fakeClientEhlo(utf8Ehlo(caps[i]), ["221 Bye\r\n"])
    let e = refusal(c, raw)
    assert(e.command == "validate" && !e.transient(), e.message())
    assert(c.reusable(), "local refusal lost session")
    c.close()
    assert(<- log == "EHLO client.example.com\r\n", "transaction leaked")
    i = i + 1
  }
}
