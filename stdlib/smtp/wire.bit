// Bit standard library — smtp module: the byte stream and the command/reply
// framing on top of it (#3967).
//
// `Stream` exists so the rest of the module never asks whether it is talking
// cleartext or TLS. STARTTLS swaps one implementation for another inside a live
// `Client`; every command path above is unchanged, and — the point — `Client`'s
// `secure` flag is set by that swap rather than tracked in parallel with it, so
// there is no state for an AUTH guard to disagree with.

import { hasSuffix, indexOfFrom, join } from "std/strings"
import { Conn as TcpConn } from "std/net"
import { TlsConn } from "std/tls"
import { monotonic, Millisecond, Second } from "std/time"

// The transport under an SMTP session: exactly the things the protocol needs
// from a byte stream. `deadline` arms the absolute monotonic nanosecond limit
// every later `send` and `recv` is bounded by (#6856), and `timedOut` says
// whether the `recv` just before it returned "" because that limit passed
// rather than because the peer closed: `recv` has no error to carry the
// difference when the transport reports a timeout as an end of stream.
export interface Stream {
  send(s: string): ()!,
  recv(max: int): string!,
  deadline(ns: int),
  timedOut(): bool,
  shut(),
}

// A cleartext TCP stream. Everything a server says over one is public, and
// `Client.secure` is false while it is in place.
class plainStream {
  c: TcpConn
  export send(s: string): ()! { this.c.write(s)? }
  export recv(max: int): string! { return this.c.read(max) }
  export deadline(ns: int) { this.c.setDeadline(ns) }
  export timedOut(): bool { return this.c.readTimedOut() }
  export shut() { this.c.close() }
}

// A TLS stream — an implicit-TLS dial or the result of STARTTLS. `TlsConn`
// speaks bytes, so the two conversions here are the whole difference.
class tlsStream {
  c: TlsConn
  export send(s: string): ()! { this.c.write([]byte(s))? }
  export recv(max: int): string! { return string(this.c.read(max)?) }
  export deadline(ns: int) { this.c.setDeadline(ns) }
  export timedOut(): bool { return this.c.readTimedOut() }
  export shut() { this.c.close() }
}

// The most bytes one reply may occupy. A server that has not terminated a
// reply by here is not one worth waiting on, and the bound is what keeps
// `readReply` provably finite against a peer that streams continuation lines
// forever.
const maxReplyBytes: int = 65536

// The longest single command this module will transmit: the 12288 octets RFC
// 4954 §4 allows an `AUTH` line, because an OAuth2 access token with its initial
// response outgrows the 998 of a message line (an Exchange Online token is
// over 1500 characters). Commands are built here, never by the caller; the
// check is a guard against a future path that forgets, not against the server.
const maxCommandBytes: int = 12288

// One SMTP reply: the three-digit code and every line's text, joined by "\n".
// `lines` is kept because the EHLO capability list is a reply body and nothing
// else would be able to read it.
class Reply {
  code: int,
  lines: []string,
}

// The longest a session waits for one exchange when the caller does not say:
// the greeting, one command and its reply, or one DATA payload and its reply.
// RFC 5321 §4.5.3.2 tells a client to wait 5 minutes for the greeting, MAIL and
// RCPT, 2 for DATA initiation, 3 per DATA block and 10 for the end-of-data
// reply — figures set for an unattended relay that may be draining a deep
// queue to a distant host. A sender that sits behind a request, a pool or a
// retry loop cannot park a worker that long on a silent peer, so the default is
// 30 seconds for every exchange and the RFC's figures are one `Options.timeout`
// away for a caller that does relay slowly.
const defaultTimeout: int = 30 * Second

// Whether `e` is a `std/net` deadline error: "read timed out", "write timed
// out" and "dial host:port timed out" are the only messages that end this way.
fn isTimeout(e: error): bool {
  return hasSuffix(e.message(), "timed out")
}

// A buffered line reader over a `Stream`. SMTP is line-framed and a `recv` cuts
// wherever the network did, so the leftover of one reply is the beginning of
// the next; a reader that dropped it would lose a pipelined server's greeting.
//
// `timeout` is the nanoseconds one exchange may take. `closed` names why the
// session was shut from here: "" while it is open, "a timeout" when an exchange
// ran out, "a 421 reply" when the server hung up (RFC 5321 §4.2.2). The stream
// is closed then and every later exchange is refused, since a late reply to an
// abandoned command would be read as the answer to the next one.
class Wire {
  s: Stream
  buf: string
  timeout: int
  closed: string

  // Start the clock for one exchange: a fresh absolute deadline `timeout` from
  // now on the live stream.
  arm() {
    this.s.deadline(monotonic().ns + this.timeout)
  }

  // `arm`, after refusing a stream that already timed out.
  begin(): ()!SmtpError {
    if (len(this.closed) > 0) {
      fail localError("the connection was closed after ${this.closed}; dial again")
    }
    this.arm()
  }

  // Shut the stream and refuse every later exchange, saying `why`.
  hangup(why: string) {
    this.closed = why
    this.s.shut()
  }

  // The error for `what` running past its deadline. Closes the stream, because
  // the peer may still answer and the next command would read that answer.
  expired(what: string, cause: error): SmtpError {
    this.hangup("a timeout")
    return timeoutError(what, this.timeout / Millisecond, cause)
  }

  // Transmit `data` under the current deadline; `what` names the step in the
  // error.
  put(what: string, data: string): ()!SmtpError {
    this.s.send(data) catch e {
      if (isTimeout(e)) {
        fail this.expired(what, e)
      }
      fail ioError(what, e)
    }
  }

  // The next CRLF-terminated line, without its terminator. Fails on a peer that
  // closes mid-line and on a line over `maxReplyBytes` — an unterminated stream
  // must not become an unbounded buffer.
  readLine(what: string): string!SmtpError {
    let guard = 0
    while (guard < maxReplyBytes) {
      guard = guard + 1
      let at = indexOf(this.buf, "\r\n")
      if (at >= 0) {
        let line = this.buf[0:at]
        this.buf = this.buf[at + 2:]
        return line
      }
      if (len(this.buf) > maxReplyBytes) {
        fail protoError(what, "reply line exceeded ${maxReplyBytes} bytes")
      }
      let chunk = this.s.recv(4096) catch e {
        if (isTimeout(e)) {
          fail this.expired(what, e)
        }
        fail ioError(what, e)
      }
      if (len(chunk) == 0) {
        if (this.s.timedOut()) {
          fail this.expired(what, nil)
        }
        fail protoError(what, "connection closed mid-reply")
      }
      this.buf = this.buf + chunk
    }
    fail protoError(what, "reply did not terminate")
  }

  // A full reply, continuation lines included. RFC 5321 §4.2: `250-text` is a
  // continuation, `250 text` is the last line, and every line of one reply
  // carries the same code — a server that changes it mid-reply is refused
  // rather than believed.
  readReply(what: string): Reply!SmtpError {
    let lines = []string(0)
    let code = 0
    let guard = 0
    while (guard < 256) {
      guard = guard + 1
      let line = this.readLine(what)?
      let (thisCode, more) = parseReplyLine(what, line)?
      if (code != 0 && thisCode != code) {
        fail protoError(what, "reply changed code from ${code} to ${thisCode}")
      }
      code = thisCode
      lines = append(lines, line[4:])
      if (!more) {
        return Reply{ code = code, lines = lines }
      }
    }
    fail protoError(what, "reply had more than 256 lines")
  }

  // Send `cmd` as one CRLF-terminated line and read the reply it draws.
  // `what` names the step in any error: it is what `SmtpError.command` reports.
  command(what: string, cmd: string): Reply!SmtpError {
    this.begin()?
    this.sendLine(what, cmd)?
    return this.readReply(what)?
  }

  // Send one command line. Refuses a CR or LF inside `cmd` and a line over the
  // octet ceiling: a command is assembled from validated pieces upstream, so
  // either would mean a bug here rather than hostile input, and a bug that puts
  // an attacker-shaped line on the wire is the one worth failing loudly.
  sendLine(what: string, cmd: string): ()!SmtpError {
    if (hasControlByte(cmd)) {
      fail localError("refusing to send a command containing CR, LF or NUL")
    }
    if (len(cmd) > maxCommandBytes) {
      fail localError("command of ${len(cmd)} octets exceeds ${maxCommandBytes}")
    }
    this.put(what, cmd + "\r\n")?
  }
}

// The code and the continuation flag of one reply line. RFC 5321 §4.2.1: three
// digits, then `-` (more lines) or a space (last line).
fn parseReplyLine(what: string, line: string): (int, bool)!SmtpError {
  if (len(line) < 4) {
    fail protoError(what, "reply line '${line}' is shorter than a status code")
  }
  let code = 0
  let i = 0
  while (i < 3) {
    let c = line[i]
    if (c < u8(48) || c > u8(57)) {
      fail protoError(what, "reply line '${line}' does not start with three digits")
    }
    code = code * 10 + int(c) - 48
    i = i + 1
  }
  if (line[3] == u8(45)) {
    return (code, true)
  }
  if (line[3] == u8(32)) {
    return (code, false)
  }
  fail protoError(what, "reply line '${line}' has no separator after the code")
}

// Fail unless `r` carries one of the two codes the caller expects. Every
// command site goes through this rather than testing `r.code` itself, so a
// server's own text reaches the error instead of being replaced by a generic
// one — an authentication refusal is only diagnosable from what the server
// said.
fn expect(what: string, r: Reply, want: int, alsoWant: int): ()!SmtpError {
  if (r.code == want || r.code == alsoWant) {
    return
  }
  fail replyError(what, r)
}

// Transmit `msg` as a DATA payload: dot-stuffed, CRLF-normalised, and closed by
// the `.` line (RFC 5321 §4.5.2). Dot-stuffing is here rather than in the
// message renderer because it is a property of the transmission, not of the
// message: the same rendered message is byte-identical in a file and stuffed on
// the wire. The deadline armed here is for the payload AND the reply to it, which
// the caller reads next without arming again.
fn writeData(w: Wire, msg: string): ()!SmtpError {
  w.begin()?
  let body = toCrlf(msg)
  let out = Builder()
  let at = 0
  let guard = 0
  while (at < len(body) && guard <= len(body)) {
    guard = guard + 1
    let nl = indexOfFrom(body, "\r\n", at)
    if (nl < 0) {
      nl = len(body)
    }
    let _ = out.write(stuff(body[at:nl])).write("\r\n")
    at = nl + 2
  }
  let _ = out.write(".\r\n")
  w.put("DATA", out.toString())?
}

// One body line, with the leading `.` doubled so it cannot be read as the
// end-of-data marker.
fn stuff(line: string): string {
  if (len(line) > 0 && line[0] == u8(46)) {
    return "." + line
  }
  return line
}
