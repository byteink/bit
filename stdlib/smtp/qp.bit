// Bit standard library — smtp module: quoted-printable (RFC 2045 §6.7, #6862).
//
// A text part that is not `7bit`-safe goes out quoted-printable when that is no
// larger than base64 (`textEncoding`, mime.bit): an English mail with one curly
// quote stays readable in its raw form instead of becoming a base64 blob.
//
// The rules, each of which `qp.test.bit` pins with a case of its own:
//   - a byte outside 33..126 becomes `=XX` (uppercase hex), except a space or
//     tab inside a line, which is sent as-is; `=` itself is `=3D`;
//   - a space or tab that would end a line is encoded, because a transport may
//     strip trailing whitespace;
//   - a CRLF is a hard line break, and every bare CR or LF is first normalised
//     to one (`toCrlf`, mime.bit);
//   - no encoded line exceeds 76 characters: a longer one is cut with a soft
//     break, `=` then CRLF, which a decoder removes;
//   - a UTF-8 sequence is one indivisible unit, so a soft break never lands
//     between the `=XX` escapes of one character, let alone inside one escape.
//
// A line that starts with `.` needs nothing here: DATA dot-stuffing (wire.bit)
// doubles it on the way out and the server removes the extra dot, whether the
// line is a hard line or the continuation after a soft break.

import { Builder } from "std/strings"

// The longest encoded line, soft-break `=` included (RFC 2045 §6.7 rule 5).
const qpWidth: int = 76

// `s` as quoted-printable, line breaks normalised to CRLF. A final line with no
// terminator gets none: the caller supplies the delimiter that follows.
fn qpEncode(s: string): string {
  let src = toCrlf(s)
  let b = Builder()
  let start = 0
  let i = 0
  while (i < len(src)) {
    if (src[i] == u8(13)) {
      qpLine(b, src[start:i])
      let _ = b.write("\r\n")
      i = i + 2
      start = i
    } else {
      i = i + 1
    }
  }
  qpLine(b, src[start:])
  return b.toString()
}

// One line (no terminator) into `b`, cut into encoded lines of at most
// `qpWidth` characters. A unit that is not the line's last needs one column
// reserved for the soft-break `=`.
fn qpLine(b: Builder, line: string) {
  let col = 0
  let i = 0
  while (i < len(line)) {
    let n = utf8Unit(line, i)
    let last = i + n >= len(line)
    let enc = qpUnit(line, i, n, last)
    let room = qpWidth - 1
    if (last) {
      room = qpWidth
    }
    if (col + len(enc) > room) {
      let _ = b.write("=\r\n")
      col = 0
    }
    let _ = b.write(enc)
    col = col + len(enc)
    i = i + n
  }
}

// The sequence length a UTF-8 lead byte announces: 2, 3 or 4, and 1 for a byte
// that leads nothing (ASCII, a continuation byte, 0xC0/0xC1, 0xF5 and up).
fn utf8Lead(c: u8): int {
  if (c >= u8(194) && c <= u8(223)) {
    return 2
  }
  if (c >= u8(224) && c <= u8(239)) {
    return 3
  }
  if (c >= u8(240) && c <= u8(244)) {
    return 4
  }
  return 1
}

// How many bytes starting at `i` form one unit: a whole well-formed UTF-8
// sequence (lead byte plus its continuation bytes), otherwise a single byte.
fn utf8Unit(s: string, i: int): int {
  let n = utf8Lead(s[i])
  if (i + n > len(s)) {
    return 1
  }
  let k = 1
  while (k < n) {
    if (s[i + k] < u8(128) || s[i + k] > u8(191)) {
      return 1
    }
    k = k + 1
  }
  return n
}

// The encoded text of the `n` bytes at `i`. `last` is true for the final unit
// of a line, where a space or tab must be escaped.
fn qpUnit(s: string, i: int, n: int, last: bool): string {
  if (n == 1 && qpLiteral(s[i], last)) {
    return s[i:i + 1]
  }
  let out = ""
  let k = 0
  while (k < n) {
    out = out +
      "=" +
      hexDigits[int(s[i + k]) / 16:int(s[i + k]) / 16 + 1] +
      hexDigits[int(s[i + k]) % 16:int(s[i + k]) % 16 + 1]
    k = k + 1
  }
  return out
}

// Whether byte `c` is sent as itself: printable ASCII except `=`, plus space
// and tab when something follows them on the line.
fn qpLiteral(c: u8, last: bool): bool {
  if (c == u8(32) || c == u8(9)) {
    return !last
  }
  return c >= u8(33) && c <= u8(126) && c != u8(61)
}
