// stdlib/smtp/address.test.bit — a display name too long for one RFC 2047
// encoded word (#7158).
//
// Every assertion is about the rendered BYTES: the render succeeds, no line
// passes the 998-octet ceiling, every encoded word is at most 75 characters
// (RFC 2047 §2), and the words decode back to the name the caller gave.
// `plainMessage` and the string helpers imported by smtp.test.bit are module
// siblings (SPEC §19); nothing below imports them.

// `unit` repeated until the result is at least `bytes` long.
fn nameOfBytes(unit: string, bytes: int): string {
  return repeat(unit, (bytes + len(unit) - 1) / len(unit))
}

// The header `name` of `rendered`, unfolded (RFC 5322 §2.2.3): the first line
// and every line after it that starts with whitespace, joined by the space
// each fold stands for. "" when there is no such header.
fn unfoldedHeader(rendered: string, name: string): string {
  let lines = split(rendered[0:strIndexOf(rendered, "\r\n\r\n")], "\r\n")
  let out = ""
  let i = 0
  while (i < len(lines) && !hasPrefix(lines[i], "${name}: ")) {
    i = i + 1
  }
  if (i == len(lines)) {
    return ""
  }
  out = lines[i][len(name) + 2:]
  i = i + 1
  while (i < len(lines) && hasPrefix(lines[i], " ")) {
    out = out + lines[i]
    i = i + 1
  }
  return out
}

// The display name that `value` (`<words> <addr-spec>`) decodes to: each
// encoded word is checked for shape and length, then base64-decoded, and the
// decoded bytes are joined in order (RFC 2047 §6.2 drops the whitespace
// between adjacent words).
fn decodeName(value: string): string {
  let words = split(value[0:strIndexOf(value, " <")], " ")
  let out = ""
  let i = 0
  while (i < len(words)) {
    let w = words[i]
    if (len(w) == 0) {
      i = i + 1
      continue
    }
    assert(len(w) <= 75, "encoded word is ${len(w)} characters: ${w}")
    assert(hasPrefix(w, "=?UTF-8?B?") && w[len(w) - 2:] == "?=", "not an encoded word: ${w}")
    let raw = decodeBase64(w[10:len(w) - 2]) catch e {
      assert(false, "decodeBase64(${w}): ${e.message()}")
      return ""
    }
    out = out + string(raw)
    i = i + 1
  }
  return out
}

// Render a message whose From, To, Cc and Reply-To all carry `name`, and
// assert the four headers decode back to it.
fn assertNameRoundTrips(name: string) {
  let m = Message(Address{ name = name, email = "sender@example.com" })
  m.addTo(Address{ name = name, email = "to@example.net" })
  m.addCc(Address{ name = name, email = "cc@example.net" })
  m.addReplyTo(Address{ name = name, email = "reply@example.net" })
  m.setSubject("Hello")
  m.setText("Hi.\r\n")
  m.setBoundary("bit-test-boundary")
  let rendered = m.render() catch e {
    assert(false, "render of a ${len(name)}-byte name: ${e.message()}")
    return
  }
  let worst = longestLine(split(rendered, "\r\n"))
  assert(worst < 998, "a line is ${worst} octets")
  let fields = ["From", "To", "Cc", "Reply-To"]
  let i = 0
  while (i < len(fields)) {
    let value = unfoldedHeader(rendered, fields[i])
    assert(len(value) > 0, "no ${fields[i]} header in ${rendered}")
    assert(
      decodeName(value) == name,
      "${fields[i]} decodes to a different name (${len(name)} bytes)",
    )
    i = i + 1
  }
}

test "a display name of 46, 200 and 1000 bytes renders and decodes back" {
  let units = ["\u{4e2d}", "\u{1F600}", "é", "Jörg Müller "]
  let sizes = [46, 200, 1000]
  let u = 0
  while (u < len(units)) {
    let s = 0
    while (s < len(sizes)) {
      assertNameRoundTrips(nameOfBytes(units[u], sizes[s]))
      s = s + 1
    }
    u = u + 1
  }
}

test "sixty CJK characters in From and a 100-byte Latin-1 name in Cc render" {
  let m = Message(Address{ name = repeat("\u{4e2d}", 60), email = "a@example.com" })
  m.addTo(Address{ name = "", email = "to@example.net" })
  let latin = nameOfBytes("é", 100)
  m.addCc(Address{ name = latin, email = "cc@example.net" })
  m.setText("Hi.\r\n")
  let rendered = m.render() catch e {
    assert(false, "render: ${e.message()}")
    return
  }
  assert(decodeName(unfoldedHeader(rendered, "From")) == repeat("\u{4e2d}", 60), "From name")
  assert(decodeName(unfoldedHeader(rendered, "Cc")) == latin, "Cc name")
}

test "a CR, LF or NUL in a long non-ASCII display name is still refused" {
  let seeds = ["\r", "\n", "\r\nBcc: attacker@example.com", "\u{0}"]
  let i = 0
  while (i < len(seeds)) {
    let m = plainMessage()
    m.addCc(Address{ name = repeat("\u{4e2d}", 60) + seeds[i], email = "ops@example.com" })
    let out = m.render() catch e {
      assert(contains(e.message(), "contains a CR, LF or NUL byte"), "seed ${i}: ${e.message()}")
      i = i + 1
      continue
    }
    assert(false, "seed ${i} rendered ${len(out)} bytes instead of failing")
    i = i + 1
  }
}
