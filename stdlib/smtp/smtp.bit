// Bit standard library — smtp module: an ESMTP submission client (#3967).
//
// Sending only. There is no IMAP, no POP3 and no server here: this is the
// layer a service needs to put a password reset, a verification link or an
// alert into a relay, and nothing else.
//
//     let m = Message(Address{ name = "Billing", email = "billing@example.com" })
//     m.addTo(Address{ name = "", email = "customer@example.net" })
//     m.setSubject("Your invoice")
//     m.setText("The invoice is attached.\n")
//     m.attach(Attachment("invoice.pdf", "application/pdf", pdfBytes))
//
//     let c = dial("mail.example.com", 587)?
//     defer c.close()
//     c.ehlo("client.example.com")?
//     c.startTls(Options())?             // certificate verified by default
//     c.ehlo("client.example.com")?      // RFC 3207: re-issue after the upgrade
//     c.auth(Auth.Plain(user, pass))?
//     c.send(m)?
//     c.quit()?
//
// Port 465 is implicit TLS: `dialTls` instead, and no `startTls`.
//
// Three rules are enforced here and are not configurable:
//
//   1. `AUTH` never runs on a connection that is not TLS (auth.bit). There is
//      no argument that turns this off.
//   2. A header value carrying a CR or LF is rejected, never stripped, and the
//      whole message is rendered and validated before `MAIL FROM` is sent, so a
//      rejected value costs zero transmitted bytes (header.bit, message.bit).
//   3. No message line reaches 998 octets (mime.bit's `checkLines`) and no
//      command line reaches 12288, the longest RFC 4954 §4 lets `AUTH` be
//      (wire.bit's `sendLine`).
//
// Certificate verification is on by default. `Options.insecureSkipVerify` turns
// it off and is the only way to; it is an explicit argument at the call site,
// never a default and never inferred.

import { dialDeadline as tcpDialDeadline } from "std/net"
import {
  TlsConfig, emptyTrustStore, client as tlsUpgrade,
} from "std/tls"
import { systemRoots, bundled, TrustStore } from "std/crypto"
import { hasPrefix, replace, split, toUpper } from "std/strings"

// How a TLS leg of a session is set up. `Options()` is secure by default:
// verification on, system trust anchors, SNI taken from the dialed host.
// "Verify" is `insecureSkipVerify`'s zero value rather than something the
// constructor has to remember to set, so each option is a named argument that
// loosens or pins one thing: `Options(serverName = "mail.example.com")`.
//
//   insecureSkipVerify  skip chain AND hostname verification. Setting it true
//                       means the connection proves nothing about who the peer
//                       is; a credential sent over one is a credential given to
//                       whoever answered. For tests and pinned lab servers.
//   serverName          SNI and the name the certificate must match; empty
//                       means the host that was dialed.
//   roots               trust anchors. Empty means the operating system store,
//                       with the bundled roots as the fallback.
//   timeout             nanoseconds each step may take, bounding the connect
//                       (TLS handshake included), the greeting, every command
//                       and its reply, and a DATA payload and its reply. Must be
//                       positive. A step that runs past it fails with an error
//                       naming it and closes the connection (#6856).
export class Options {
  export insecureSkipVerify: bool
  export serverName: string
  export roots: TrustStore
  export timeout: int

  init(
    insecureSkipVerify: bool = false,
    serverName: string = "",
    roots: TrustStore = emptyTrustStore(),
    timeout: int = defaultTimeout,
  ) {
    this.insecureSkipVerify = insecureSkipVerify
    this.serverName = serverName
    this.roots = roots
    this.timeout = timeout
  }
}

// Refuse a timeout that would make every step fail at once or never: a
// non-positive one is a caller's bug (a unit slip, a zero from an unset
// config), and a deadline in the past would surface as a "timed out" from a
// server that never had a chance.
fn checkTimeout(o: Options): ()!SmtpError {
  if (o.timeout <= 0) {
    fail localError("Options.timeout must be positive, got ${o.timeout}")
  }
}

// The operating system's trust anchors, falling back to the small bundled root
// set when the OS store cannot be read. `std/tls` takes this `TrustStore`
// straight across (#6155): both are `std/crypto`'s class, so there is no
// bridging.
fn defaultRoots(): TrustStore {
  return systemRoots() catch _ {
    bundled()
  }
}

// The `std/tls` config `o` describes for a session with `host`.
fn tlsConfigOf(o: Options, host: string): TlsConfig {
  let anchors = o.roots
  if (len(anchors.roots) == 0) {
    anchors = defaultRoots()
  }
  let cfg = TlsConfig(anchors)
  cfg.insecureSkipVerify = o.insecureSkipVerify
  cfg.serverName = host
  if (len(o.serverName) > 0) {
    cfg.serverName = o.serverName
  }
  return cfg
}

// One SMTP session. `secure` is true only while the stream underneath really is
// TLS — it is written by the same statement that swaps the stream, so no code
// path can set one without the other.
export class Client {
  w: Wire
  tcp: TcpConn
  host: string
  port: int
  secure: bool
  greeted: bool
  exts: []string

  // Whether the server advertised `ext` in its last EHLO reply. The name is
  // matched case-insensitively against the first word of each capability line,
  // so `supports("AUTH")` answers for `AUTH PLAIN LOGIN`.
  export supports(ext: string): bool {
    let want = toUpper(ext)
    let i = 0
    while (i < len(this.exts)) {
      let line = toUpper(this.exts[i])
      if (line == want || hasPrefix(line, want + " ")) {
        return true
      }
      i = i + 1
    }
    return false
  }

  // Whether this connection is TLS — an implicit-TLS dial, or a completed
  // `startTls`. `auth` refuses to run while it is false.
  export isSecure(): bool {
    return this.secure
  }

  // Send `EHLO name` and record the capabilities it returns. `name` is the
  // client's own domain; it must be printable ASCII with no spaces, since it
  // goes on the command line unquoted. Must be re-issued after `startTls`:
  // the capability list a server offers in cleartext is not authenticated and
  // is discarded by the upgrade (RFC 3207 §4.2).
  export ehlo(name: string): ()!SmtpError {
    checkEhloName(name)?
    let r = this.w.command("EHLO", "EHLO ${name}")?
    expect("EHLO", r, 250, 250)?
    this.exts = []string(0)
    let i = 1
    while (i < len(r.lines)) {
      this.exts = append(this.exts, r.lines[i])
      i = i + 1
    }
    this.greeted = true
  }

  // Upgrade this cleartext connection to TLS (RFC 3207). Fails when the server
  // did not advertise STARTTLS — a client that tries anyway on a downgraded
  // capability list learns nothing it can act on — and fails when the server
  // has sent bytes that would sit in the read buffer across the handshake,
  // which is the plaintext command-injection shape (CVE-2011-0411), not a
  // buffer to quietly discard. The caller must `ehlo` again afterwards.
  export startTls(o: Options): ()!SmtpError {
    checkTimeout(o)?
    if (this.secure) {
      fail localError("the connection is already TLS")
    }
    if (!this.supports("STARTTLS")) {
      fail localError("the server does not advertise STARTTLS")
    }
    let r = this.w.command("STARTTLS", "STARTTLS")?
    expect("STARTTLS", r, 220, 220)?
    if (len(this.w.buf) > 0) {
      fail protoError("STARTTLS", "the server sent data before the TLS handshake")
    }
    // The handshake gets its own budget, `o.timeout`, rather than what is left
    // of the STARTTLS command's. `std/tls` runs it under the deadline already
    // on the socket.
    this.w.timeout = o.timeout
    this.w.arm()
    let t = tlsUpgrade(this.tcp, this.host, tlsConfigOf(o, this.host)) catch e {
      fail this.upgradeError(e)
    }
    this.w.s = tlsStream{ c = t }
    this.secure = true
    this.exts = []string(0)
    this.greeted = false
  }

  // The error for a TLS handshake that failed: a typed timeout, with the
  // connection closed, when the deadline was the cause.
  upgradeError(e: error): SmtpError {
    if (isTimeout(e)) {
      let t = this.w.expired("STARTTLS", e)
      this.tcp.close()
      return t
    }
    return ioError("STARTTLS", e)
  }

  // Authenticate with `a`: `Auth.Plain(user, pass)` (SASL PLAIN, RFC 4616),
  // `Auth.Login(user, pass)`, or an OAuth2 access token with
  // `Auth.Xoauth2(user, token)` or `Auth.OauthBearer(user, token)` (RFC 7628).
  // Everything is checked before a credential byte
  // exists, in this order: the connection is TLS (refused outright otherwise,
  // with no opt-out), no credential carries a CR, LF or NUL (nor a 0x01, for a token), `ehlo` has
  // run, and the server's EHLO `AUTH` line offers the mechanism (RFC 4954 §3).
  // An error never repeats a credential.
  export auth(a: Auth): ()!SmtpError {
    let mech = mechanismOf(a)
    requireSecure(this.secure, mech)?
    checkAuth(a)?
    this.requireGreeting()?
    if (!authOffered(this.exts, mech)) {
      fail localError("the server does not offer AUTH ${mech}")
    }
    match (a) {
      Plain(user, pass) => this.plainExchange(user, pass)?
      Login(user, pass) => this.loginExchange(user, pass)?
      Xoauth2(user, token) => this.oauthExchange(mech, xoauth2Response(user, token), "")?
      OauthBearer(user, token) => {
        let first = oauthBearerResponse(user, this.host, this.port, token)
        this.oauthExchange(mech, first, "\x01")?
      }
    }
  }

  // An OAuth2 mechanism as one `AUTH <mech> <initial response>` command. A `334`
  // reply is the server's error challenge (RFC 7628 §3.2.3; Google and
  // Microsoft do the same for XOAUTH2): `cancel` is sent in answer, which
  // draws the real failure, and that failure is what the caller gets, carrying
  // the challenge's `status` and `scope`. The response, and so the token, is
  // sent once.
  oauthExchange(mech: string, initial: string, cancel: string): ()!SmtpError {
    let what = "AUTH ${mech}"
    let r = this.w.command(what, "AUTH ${mech} ${initial}")?
    if (r.code == 334) {
      this.oauthFailure(what, oauthDetail(r), cancel)?
    }
    expect(what, r, 235, 235)?
  }

  // Answer an error challenge with `cancel` and fail with the reply it draws,
  // `detail` first in its text.
  oauthFailure(what: string, detail: string, cancel: string): ()!SmtpError {
    let r = this.w.command(what, cancel)?
    if (r.code == 235) {
      fail protoError(what, "the server accepted the credential after reporting an error")
    }
    let e = replyError(what, r)
    if (len(detail) > 0) {
      e.text = "${detail}: ${e.text}"
    }
    fail e
  }

  // SASL PLAIN as one `AUTH PLAIN <initial response>` command.
  plainExchange(user: string, pass: string): ()!SmtpError {
    let r = this.w.command("AUTH PLAIN", "AUTH PLAIN ${plainResponse(user, pass)}")?
    expect("AUTH PLAIN", r, 235, 235)?
  }

  // SASL LOGIN: the username and the password as two base64 challenge responses.
  loginExchange(user: string, pass: string): ()!SmtpError {
    let start = this.w.command("AUTH LOGIN", "AUTH LOGIN")?
    expect("AUTH LOGIN", start, 334, 334)?
    let userStep = this.w.command("AUTH LOGIN username", encodeBase64([]byte(user)))?
    expect("AUTH LOGIN username", userStep, 334, 334)?
    let done = this.w.command("AUTH LOGIN password", encodeBase64([]byte(pass)))?
    expect("AUTH LOGIN password", done, 235, 235)?
  }

  // Send `m` and its envelope. `m` is a `Message` (rendered here, envelope
  // derived from its sender and recipients) or a `Raw` (pre-rendered bytes
  // under an explicit envelope). Everything is built and checked first: a CR in
  // a subject, a malformed address or an over-long line fails here, with
  // `MAIL FROM` never sent. The rendered bytes are transmitted unchanged apart
  // from DATA dot-stuffing.
  //
  // Every recipient is offered, and one the server refuses is recorded in
  // `Delivery.rejected` while the rest go on: RFC 5321 §3.3 has DATA proceed
  // when at least one `RCPT TO` was accepted. When none was, no DATA is sent and
  // the call fails with the last refusal (#6866).
  export send(m: Sendable): Delivery!SmtpError {
    let rendered = m.render()?
    let e = m.envelope()
    checkEnvelope(e)?
    this.requireGreeting()?
    this.openMail(e.from)?
    let d = this.offerRecipients(e.to)?
    this.transmit(d, rendered)?
    return d
  }

  // `MAIL FROM`; a refusal resets the session so it can be used again.
  openMail(from: string): ()!SmtpError {
    let r = this.w.command("MAIL FROM", "MAIL FROM:<${from}>")?
    expect("MAIL FROM", r, 250, 250) catch e {
      fail this.abort(e)
    }
  }

  // `RCPT TO` for every address in `to`. Fails, after a reset, when the server
  // refused all of them.
  offerRecipients(to: []string): Delivery!SmtpError {
    let d = Delivery{ accepted = []string(0), rejected = []Rejection(0), queueId = "" }
    let i = 0
    while (i < len(to)) {
      this.offer(d, to[i])?
      i = i + 1
    }
    if (len(d.accepted) == 0) {
      fail this.abort(allRefused(d.rejected))
    }
    return d
  }

  // One `RCPT TO`, recorded in `d` as accepted or rejected. A 421 is the server
  // closing the channel (RFC 5321 §4.2.2): nothing more can be offered to it.
  offer(d: Delivery, address: string): ()!SmtpError {
    let r = this.w.command("RCPT TO", "RCPT TO:<${address}>")?
    if (r.code == 421) {
      fail replyError("RCPT TO", r)
    }
    if (r.code == 250 || r.code == 251) {
      d.accepted = append(d.accepted, address)
      return
    }
    d.rejected = append(
      d.rejected,
      Rejection{ address = address, error = replyError("RCPT TO", r) },
    )
  }

  // `DATA`, the payload, and the reply that queues it, whose text becomes
  // `d.queueId`. The reply to the payload ends the transaction whatever it is,
  // so only a refused `DATA` needs a reset.
  transmit(d: Delivery, rendered: string): ()!SmtpError {
    let data = this.w.command("DATA", "DATA")?
    expect("DATA", data, 354, 354) catch e {
      fail this.abort(e)
    }
    writeData(this.w, rendered)?
    let done = this.w.readReply("end of DATA")?
    expect("end of DATA", done, 250, 250)?
    d.queueId = join(done.lines, " ")
  }

  // `e` for the caller, after `RSET` has made `MAIL FROM` legal again so a
  // pooled session survives a refused message. Nothing is reset when there is
  // no session left to reset: a failure with no reply is the connection
  // breaking, and a 421 is the server hanging up. A failed `RSET` is not
  // reported, since `e` is the answer the caller needs and the next command on
  // a session that is still broken fails by itself.
  abort(e: SmtpError): SmtpError {
    if (e.code == 0 || e.code == 421) {
      return e
    }
    let r = this.w.command("RSET", "RSET") catch _ {
      return e
    }
    expect("RSET", r, 250, 250) catch _ {}
    return e
  }

  // End the session politely: `QUIT`, then close the socket. The socket is
  // closed even when the server's reply is not a 221, because the alternative
  // is leaking the descriptor over a server's bad manners.
  export quit(): ()!SmtpError {
    let r = this.w.command("QUIT", "QUIT") catch e {
      this.close()
      fail e
    }
    this.close()
    expect("QUIT", r, 221, 221)?
  }

  // Close the connection without a `QUIT`. Idempotent, like the `std/net` and
  // `std/tls` closes underneath it.
  export close() {
    this.w.s.shut()
    this.tcp.close()
  }

  // Fail a command that requires a completed EHLO. Separate from the command
  // itself so `send` and the AUTH mechanisms give the same answer.
  requireGreeting(): ()!SmtpError {
    if (!this.greeted) {
      fail localError("call ehlo() before this command")
    }
  }
}

// The EHLO argument is the client's own domain and goes on the command line
// unquoted, so a space, a control byte or a non-ASCII byte in it would be a
// second command parameter rather than part of the name.
fn checkEhloName(name: string): ()!SmtpError {
  if (len(name) == 0 || len(name) > 255) {
    fail localError("the EHLO name must be 1..255 octets, got ${len(name)}")
  }
  let i = 0
  while (i < len(name)) {
    if (!isAddressByte(name[i])) {
      fail localError("the EHLO name '${name}' has a forbidden byte")
    }
    i = i + 1
  }
}

// The host and port a session dialed. OAUTHBEARER sends both (RFC 7628 §3.1).
class Endpoint {
  host: string,
  port: int,
}

// Read the server's opening greeting and build the session around `s`.
fn openSession(
  tcp: TcpConn,
  s: Stream,
  at: Endpoint,
  secure: bool,
  timeout: int,
): Client!SmtpError {
  let w = Wire{ s = s, buf = "", timeout = timeout, dead = false }
  w.arm()
  let greeting = w.readReply("greeting") catch e {
    s.shut()
    tcp.close()
    fail e
  }
  expect("greeting", greeting, 220, 220) catch e {
    s.shut()
    tcp.close()
    fail e
  }
  return Client{
    w = w, tcp = tcp, host = at.host, port = at.port, secure = secure, greeted = false, exts = []string(0),
  }
}

// Connect to `host:port` within `o.timeout`, failing with a typed timeout when
// the connect does not finish in time. The returned stream's deadline is the
// connect's own, so a TLS handshake that follows runs under the same budget;
// `openSession` re-arms it for the greeting.
fn connect(host: string, port: int, o: Options): TcpConn!SmtpError {
  checkTimeout(o)?
  return tcpDialDeadline(host, port, monotonic().ns + o.timeout) catch e {
    if (isTimeout(e)) {
      fail timeoutError("connect", o.timeout / Millisecond, e)
    }
    fail ioError("connect", e)
  }
}

// Connect to a cleartext submission port (587, or 25 for a relay) and read the
// greeting. The session is NOT secure yet: `startTls` makes it so, and until it
// does, `auth` refuses to run. The connect, the greeting and
// every later step each get `o.timeout`; only `timeout` of `o` is read, since
// no TLS happens here.
export fn dial(host: string, port: int, o: Options = Options()): Client!SmtpError {
  let tcp = connect(host, port, o)?
  return openSession(
    tcp,
    plainStream{ c = tcp },
    Endpoint{ host = host, port = port },
    false,
    o.timeout,
  )?
}

// Connect to an implicit-TLS submission port (465): the TLS handshake happens
// before the greeting, so there is no cleartext phase and no `startTls`. The
// server's certificate is verified against `o` — by default, against the system
// trust anchors, for the dialed host. The connect and the handshake share one
// `o.timeout`; the greeting and every later step get a fresh one each.
export fn dialTls(host: string, port: int, o: Options): Client!SmtpError {
  let tcp = connect(host, port, o)?
  let t = tlsUpgrade(tcp, host, tlsConfigOf(o, host)) catch e {
    tcp.close()
    if (isTimeout(e)) {
      fail timeoutError("connect", o.timeout / Millisecond, e)
    }
    fail ioError("connect", e)
  }
  return openSession(tcp, tlsStream{ c = t }, Endpoint{ host = host, port = port }, true, o.timeout)?
}
