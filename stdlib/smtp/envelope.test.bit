// stdlib/smtp/envelope.test.bit — Envelope and Raw (#6865).
//
// The assertions are about BYTES: the transcript the fake server in
// smtp.test.bit recorded. The fake server, `ehloPlain` and `startFake` are
// module siblings, so nothing here redefines them.

import { contains, indexOf as strIndexOf, repeat, replace, split } from "std/strings"

// A message already rendered and signed by someone else: header, blank line,
// body, with a dot line in the body to prove stuffing is undone by the server
// and not applied twice.
fn rawMessage(): string {
  return "From: Bounces <noreply@inkwell.dev>\r\n" +
    "To: <a@x.com>\r\n" +
    "Subject: Signed\r\n" +
    "DKIM-Signature: v=1; a=rsa-sha256; d=inkwell.dev; bh=abc=; b=def=\r\n" +
    "\r\n" +
    "Line one\r\n.dotted\r\n.\r\n\r\nlast\r\n"
}

// Run EHLO, `send(item)`, and return the transcript, or "" with a failed
// assertion when the session itself breaks. `replies` is the script after the
// EHLO reply, QUIT excluded.
fn transcriptOf(item: Sendable, replies: []string): string {
  let script = [ehloPlain()]
  let i = 0
  while (i < len(replies)) {
    script = append(script, replies[i])
    i = i + 1
  }
  script = append(script, "221 Bye\r\n")
  let (port, log) = startFake(script) catch e {
    assert(false, "startFake: ${e.message()}")
    return ""
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return ""
  }
  c.ehlo("client.example.com") catch e {
    assert(false, "ehlo: ${e.message()}")
    return ""
  }
  c.send(item) catch e {
    assert(false, "send: ${e.message()}")
    return ""
  }
  c.quit() catch e {
    assert(false, "quit: ${e.message()}")
    return ""
  }
  return <- log
}

// The payload of `sent` as the server reads it: everything after `DATA`, up to
// the lone dot, with the dot-stuffing removed.
fn unstuffed(sent: string): string {
  let at = strIndexOf(sent, "\r\nDATA\r\n") + 8
  let end = strIndexOf(sent[at:], "\r\n.\r\n") + at + 2
  let lines = split(sent[at:end], "\r\n")
  let out = ""
  let i = 0
  while (i < len(lines) - 1) {
    let l = lines[i]
    if (len(l) > 1 && l[0] == u8(46) && l[1] == u8(46)) {
      l = l[1:]
    }
    out = out + l + "\r\n"
    i = i + 1
  }
  return out
}

test "send of a Raw puts the explicit MAIL FROM on the wire and the payload byte for byte" {
  let raw = rawMessage()
  let r = Raw(Envelope{ from = "bounce+42@inkwell.dev", to = ["a@x.com", "b@y.org"] }, raw)
  let sent = transcriptOf(
    r,
    ["250 OK\r\n", "250 OK\r\n", "250 OK\r\n", "354 Go\r\n", "250 Queued\r\n"],
  )
  let lines = split(sent, "\r\n")
  assert(lines[1] == "MAIL FROM:<bounce+42@inkwell.dev>", "line 1 = '${lines[1]}'")
  assert(lines[2] == "RCPT TO:<a@x.com>", "line 2 = '${lines[2]}'")
  assert(lines[3] == "RCPT TO:<b@y.org>", "line 3 = '${lines[3]}'")
  assert(lines[4] == "DATA", "line 4 = '${lines[4]}'")
  assert(contains(sent, "\r\n..dotted\r\n"), "a leading dot was not stuffed")
  assert(unstuffed(sent) == raw, "the payload differs from the raw bytes: ${unstuffed(sent)}")
}

test "an empty from sends the null reverse-path" {
  let r = Raw(Envelope{ from = "", to = ["a@x.com"] }, rawMessage())
  let sent = transcriptOf(r, ["250 OK\r\n", "250 OK\r\n", "354 Go\r\n", "250 Queued\r\n"])
  let lines = split(sent, "\r\n")
  assert(lines[1] == "MAIL FROM:<>", "line 1 = '${lines[1]}'")
}

test "a Message sends under an envelope derived from its sender and recipients" {
  let m = plainMessage()
  m.addBcc(Address{ name = "", email = "audit@x.com" })
  let e = m.envelope()
  assert(e.from == "billing@example.com", "from = ${e.from}")
  assert(len(e.to) == 2, "${len(e.to)} recipients")
  assert(
    e.to[0] == "customer@example.net" && e.to[1] == "audit@x.com",
    "to = ${e.to[0]}, ${e.to[1]}",
  )
}

// Send `raw` under a valid envelope and assert it is refused with nothing but
// EHLO on the wire and `want` in the error.
fn assertRawRefused(raw: string, want: string) {
  let (port, log) = startFake([ehloPlain(), "221 Bye\r\n"]) catch e {
    assert(false, "startFake: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  c.ehlo("client.example.com") catch e {
    assert(false, "ehlo: ${e.message()}")
    return
  }
  let r = Raw(Envelope{ from = "me@x.com", to = ["a@x.com"] }, raw)
  let msg = ""
  c.send(r) catch e {
    msg = e.message()
  }
  c.quit() catch _ {}
  assert(contains(msg, want), "error '${msg}' does not contain '${want}'")
  let sent = <- log
  assert(sent == "EHLO client.example.com\r\nQUIT\r\n", "wire after refusal: '${sent}'")
}

test "raw data with a bare LF is refused and names the line" {
  assertRawRefused("A: b\r\n\r\nbody\nmore\r\n", "line 3")
}

test "raw data with a bare CR is refused and names the line" {
  assertRawRefused("A: b\r\n\r\nbo\rdy\r\n", "line 3")
}

test "raw data with no blank line is refused" {
  assertRawRefused("A: b\r\nC: d\r\n", "no blank line")
}

test "raw data with a 1000-octet line is refused and names the line" {
  assertRawRefused("A: b\r\n\r\n" + repeat("x", 1000) + "\r\n", "line 3")
}

test "raw data with a NUL is refused" {
  assertRawRefused("A: b\r\n\r\nbo" + string([u8(0)]) + "dy\r\n", "NUL")
}

test "raw data whose last line has no CRLF is refused" {
  assertRawRefused("A: b\r\n\r\nbody", "line 3")
}

test "a 997-octet line is accepted and a 998-octet one is not" {
  let ok = Raw(Envelope{ from = "", to = ["a@x.com"] }, "A: b\r\n\r\n" + repeat("x", 997) + "\r\n")
  let out = ok.render() catch e {
    assert(false, "997 octets refused: ${e.message()}")
    return
  }
  assert(len(out) == 8 + 997 + 2, "render changed the bytes")
  let bad = Raw(Envelope{ from = "", to = ["a@x.com"] }, "A: b\r\n\r\n" + repeat("x", 998) + "\r\n")
  let refused = false
  bad.render() catch _ {
    refused = true
  }
  assert(refused, "998 octets accepted")
}

// Send a Raw under `e` and assert it fails with only EHLO on the wire.
fn assertEnvelopeRefused(e: Envelope, want: string) {
  let (port, log) = startFake([ehloPlain(), "221 Bye\r\n"]) catch err {
    assert(false, "startFake: ${err.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch err {
    assert(false, "dial: ${err.message()}")
    return
  }
  c.ehlo("client.example.com") catch err {
    assert(false, "ehlo: ${err.message()}")
    return
  }
  let msg = ""
  c.send(Raw(e, rawMessage())) catch err {
    msg = err.message()
  }
  c.quit() catch _ {}
  assert(contains(msg, want), "error '${msg}' does not contain '${want}'")
  let sent = <- log
  assert(sent == "EHLO client.example.com\r\nQUIT\r\n", "wire after refusal: '${sent}'")
}

test "an envelope with no recipient is refused" {
  assertEnvelopeRefused(Envelope{ from = "me@x.com", to = []string(0) }, "no recipients")
}

test "an envelope address carrying CR or LF is refused, sender and recipient" {
  assertEnvelopeRefused(
    Envelope{ from = "me@x.com\r\nRCPT TO:<evil@x.com>", to = ["a@x.com"] },
    "sender address",
  )
  assertEnvelopeRefused(
    Envelope{ from = "me@x.com", to = ["a@x.com", "b@x.com\nDATA"] },
    "forbidden byte",
  )
}

test "a malformed envelope address is refused" {
  assertEnvelopeRefused(Envelope{ from = "no-at-sign", to = ["a@x.com"] }, "sender address")
  assertEnvelopeRefused(Envelope{ from = "", to = ["a b@x.com"] }, "recipient address")
}

test "a rendered Message sent as Raw under another envelope keeps its bytes" {
  let m = plainMessage()
  m.setMessageId("fixed@example.com")
  let rendered = m.render() catch e {
    assert(false, "render: ${e.message()}")
    return
  }
  let r = Raw(Envelope{ from = "bounce@example.com", to = ["staging@example.com"] }, rendered)
  let sent = transcriptOf(r, ["250 OK\r\n", "250 OK\r\n", "354 Go\r\n", "250 Queued\r\n"])
  assert(unstuffed(sent) == rendered, "the rendered bytes changed on the wire")
  assert(
    !contains(replace(sent, "RCPT TO:<staging@example.com>", ""), "staging@"),
    "recipient leaked",
  )
}

// A greeted client on a fake that answers `replies` after the EHLO reply, and
// the channel its transcript arrives on. Panics when the session cannot be set
// up: every caller is about what happens after.
fn fakeClient(replies: []string): (Client, chan<string>) {
  return fakeClientEhlo(ehloPlain(), replies)
}

// `fakeClient` against a server whose EHLO reply is `ehlo`.
fn fakeClientEhlo(ehlo: string, replies: []string): (Client, chan<string>) {
  let (port, log) = startFake(append([ehlo], ...replies)) catch e {
    panic("startFake: ${e.message()}")
  }
  let c = dial("127.0.0.1", port) catch e {
    panic("dial: ${e.message()}")
  }
  c.ehlo("client.example.com") catch e {
    panic("ehlo: ${e.message()}")
  }
  return (c, log)
}

// The error `c.send(r)` fails with. Panics when the send succeeds: every
// caller scripts a refusal.
fn refusal(c: Client, r: Raw): SmtpError {
  c.send(r) catch e {
    return e
  }
  panic("send succeeded against a server scripted to refuse")
}

// Three recipients for the partial-acceptance tests.
fn threeRecipients(): Raw {
  return Raw(
    Envelope{ from = "me@x.com", to = ["a@x.com", "bad@x.com", "c@x.com"] },
    rawMessage(),
  )
}

test "two of three recipients accepted: DATA goes out and the refusal is reported" {
  let (c, log) = fakeClient(
    [
      "250 OK\r\n", "250 OK\r\n", "550 5.1.1 No such user\r\n", "250 OK\r\n", "354 Go\r\n",
      "250 2.0.0 Ok: queued as 4Bx1\r\n", "221 Bye\r\n",
    ],
  )
  let d = c.send(threeRecipients()) catch e {
    assert(false, "send: ${e.message()}")
    return
  }
  c.quit() catch e {
    assert(false, "quit: ${e.message()}")
  }
  assert(len(d.accepted) == 2, "${len(d.accepted)} accepted")
  assert(
    d.accepted[0] == "a@x.com" && d.accepted[1] == "c@x.com",
    "accepted = ${d.accepted[0]}, ${d.accepted[1]}",
  )
  assert(len(d.rejected) == 1, "${len(d.rejected)} rejected")
  let r = d.rejected[0]
  assert(r.address == "bad@x.com", "rejected address = ${r.address}")
  assert(r.error.code == 550 && r.error.enhanced == "5.1.1", "rejection = ${r.error.message()}")
  assert(
    r.error.text == "No such user" && r.error.command == "RCPT TO",
    "rejection = ${r.error.message()}",
  )
  assert(!r.error.transient(), "a 550 must not be transient")
  assert(d.queueId == "2.0.0 Ok: queued as 4Bx1", "queueId = '${d.queueId}'")
  let sent = <- log
  assert(contains(sent, "RCPT TO:<bad@x.com>\r\nRCPT TO:<c@x.com>\r\nDATA\r\n"), "wire: '${sent}'")
  assert(!contains(sent, "RSET"), "a partly accepted message must not be reset")
}

test "a 4xx rejection is recorded as transient and the other recipients still get the message" {
  let (c, log) = fakeClient(
    [
      "250 OK\r\n",
      "451 4.2.1 Mailbox busy\r\n",
      "250 OK\r\n",
      "354 Go\r\n",
      "250 Queued\r\n",
      "221 Bye\r\n",
    ],
  )
  let d = c.send(Raw(Envelope{ from = "me@x.com", to = ["a@x.com", "b@x.com"] }, rawMessage())) catch e {
    assert(false, "send: ${e.message()}")
    return
  }
  c.quit() catch _ {}
  let _ = <- log
  assert(len(d.accepted) == 1 && d.accepted[0] == "b@x.com", "accepted = ${len(d.accepted)}")
  assert(
    len(d.rejected) == 1 && d.rejected[0].error.transient(),
    "a 451 must be a transient rejection",
  )
  assert(d.rejected[0].error.enhanced == "4.2.1", "enhanced = '${d.rejected[0].error.enhanced}'")
}

test "every recipient refused: RSET, no DATA, and the error names each address" {
  let (c, log) = fakeClient(
    [
      "250 OK\r\n", "550 5.1.1 No such user\r\n", "550 5.1.1 No such user\r\n",
      "550 5.7.1 Relay denied\r\n", "250 OK\r\n", "221 Bye\r\n",
    ],
  )
  let err = refusal(c, threeRecipients())
  assert(err.command == "RCPT TO" && err.code == 550, "error = ${err.message()}")
  assert(err.enhanced == "5.7.1", "the last refusal's status: '${err.enhanced}'")
  assert(
    err.text == "Relay denied (refused: a@x.com, bad@x.com, c@x.com)",
    "text = '${err.text}'",
  )
  assert(!err.transient(), "all permanent refusals must not be transient")
  c.quit() catch e {
    assert(false, "the session is not usable after RSET: ${e.message()}")
  }
  let sent = <- log
  assert(!contains(sent, "DATA"), "DATA was sent to a server that took no recipient: '${sent}'")
  assert(contains(sent, "RCPT TO:<c@x.com>\r\nRSET\r\nQUIT\r\n"), "wire: '${sent}'")
}

test "a refused MAIL FROM resets the session and the next send on it succeeds" {
  let (c, log) = fakeClient(
    [
      "550 5.7.1 Sender refused\r\n", "250 OK\r\n", "250 OK\r\n", "250 OK\r\n", "354 Go\r\n",
      "250 Queued\r\n", "221 Bye\r\n",
    ],
  )
  let raw = Raw(Envelope{ from = "me@x.com", to = ["a@x.com"] }, rawMessage())
  let err = refusal(c, raw)
  assert(err.command == "MAIL FROM" && err.code == 550, "error = ${err.message()}")
  let _ = c.send(raw) catch e {
    assert(false, "second send: ${e.message()}")
    return
  }
  c.quit() catch _ {}
  let sent = <- log
  assert(
    contains(sent, "MAIL FROM:<me@x.com>\r\nRSET\r\nMAIL FROM:<me@x.com>\r\n"),
    "wire: '${sent}'",
  )
}

test "a refused DATA resets the session" {
  let (c, log) = fakeClient(
    ["250 OK\r\n", "250 OK\r\n", "554 5.3.4 Not accepting mail\r\n", "250 OK\r\n", "221 Bye\r\n"],
  )
  let err = refusal(c, Raw(Envelope{ from = "me@x.com", to = ["a@x.com"] }, rawMessage()))
  assert(err.command == "DATA" && err.code == 554, "error = ${err.message()}")
  c.quit() catch _ {}
  let sent = <- log
  assert(contains(sent, "DATA\r\nRSET\r\nQUIT\r\n"), "wire: '${sent}'")
}

test "a 451 at the end of DATA is transient and the same client sends again" {
  let (c, log) = fakeClient(
    [
      "250 OK\r\n", "250 OK\r\n", "354 Go\r\n", "451 4.3.0 Try later\r\n", "250 OK\r\n", "250 OK\r\n",
      "354 Go\r\n", "250 2.0.0 Ok: queued as 9\r\n", "221 Bye\r\n",
    ],
  )
  let raw = Raw(Envelope{ from = "me@x.com", to = ["a@x.com"] }, rawMessage())
  let err = refusal(c, raw)
  assert(err.command == "end of DATA" && err.code == 451, "error = ${err.message()}")
  assert(err.transient(), "a 451 after DATA must be transient")
  let d = c.send(raw) catch e {
    assert(false, "second send: ${e.message()}")
    return
  }
  assert(d.queueId == "2.0.0 Ok: queued as 9", "queueId = '${d.queueId}'")
  c.quit() catch _ {}
  let sent = <- log
  assert(!contains(sent, "RSET"), "the reply to the payload ends the transaction: '${sent}'")
}

test "a 421 at RCPT TO fails at once, with its reply and no RSET" {
  let (c, log) = fakeClient(["250 OK\r\n", "421 4.3.2 Shutting down\r\n"])
  let err = refusal(c, threeRecipients())
  c.close()
  assert(err.code == 421 && err.command == "RCPT TO", "error = ${err.message()}")
  assert(err.transient(), "a 421 must be transient")
  let sent = <- log
  assert(!contains(sent, "RSET") && !contains(sent, "bad@x.com"), "wire: '${sent}'")
}

// The EHLO reply of a server that offers DSN (RFC 3461).
fn ehloDsn(): string {
  return "250-fake.example.com\r\n250-PIPELINING\r\n250-DSN\r\n250 SIZE 35882577\r\n"
}

// `Raw` for two recipients under `dsn`.
fn dsnRaw(dsn: Dsn): Raw {
  return Raw(
    Envelope{ from = "me@x.com", to = ["a@x.com", "b+tag@y.org"], dsn = dsn },
    rawMessage(),
  )
}

// Send `dsn` to a server whose EHLO reply is `ehlo` and accepts everything,
// and return the lines of the transcript.
fn dsnTranscript(ehlo: string, dsn: Dsn): []string {
  let (c, log) = fakeClientEhlo(
    ehlo,
    ["250 OK\r\n", "250 OK\r\n", "250 OK\r\n", "354 Go\r\n", "250 Queued\r\n", "221 Bye\r\n"],
  )
  let _ = c.send(dsnRaw(dsn)) catch e {
    assert(false, "send: ${e.message()}")
    return []string(0)
  }
  c.quit() catch _ {}
  return split(<- log, "\r\n")
}

test "DSN: RET and ENVID go on MAIL FROM, NOTIFY and ORCPT on every RCPT TO" {
  let lines = dsnTranscript(
    ehloDsn(),
    Dsn{ notify = [Notify.Delay, Notify.Failure], ret = Ret.Headers, envid = "msg 42" },
  )
  assert(lines[1] == "MAIL FROM:<me@x.com> RET=HDRS ENVID=msg+2042", "line 1 = '${lines[1]}'")
  assert(
    lines[2] == "RCPT TO:<a@x.com> NOTIFY=FAILURE,DELAY ORCPT=rfc822;a@x.com",
    "line 2 = '${lines[2]}'",
  )
  assert(
    lines[3] == "RCPT TO:<b+tag@y.org> NOTIFY=FAILURE,DELAY ORCPT=rfc822;b+2Btag@y.org",
    "line 3 = '${lines[3]}'",
  )
  assert(lines[4] == "DATA", "line 4 = '${lines[4]}'")
}

test "DSN: RET=FULL, and ENVID alone sends no RET" {
  let full = dsnTranscript(ehloDsn(), Dsn{ ret = Ret.Full })
  assert(full[1] == "MAIL FROM:<me@x.com> RET=FULL", "line 1 = '${full[1]}'")
  assert(full[2] == "RCPT TO:<a@x.com> ORCPT=rfc822;a@x.com", "line 2 = '${full[2]}'")
  let id = dsnTranscript(ehloDsn(), Dsn{ envid = "a=b" })
  assert(id[1] == "MAIL FROM:<me@x.com> ENVID=a+3Db", "line 1 = '${id[1]}'")
}

test "DSN: NOTIFY=NEVER alone" {
  let lines = dsnTranscript(ehloDsn(), Dsn{ notify = [Notify.Never] })
  assert(lines[1] == "MAIL FROM:<me@x.com>", "line 1 = '${lines[1]}'")
  assert(
    lines[2] == "RCPT TO:<a@x.com> NOTIFY=NEVER ORCPT=rfc822;a@x.com",
    "line 2 = '${lines[2]}'",
  )
}

test "DSN: NOTIFY goes out as SUCCESS, FAILURE, DELAY whatever the list order" {
  assert(notifyValue([]Notify(0)) == "", "empty")
  assert(notifyValue([Notify.Never]) == "NEVER", "Never")
  assert(notifyValue([Notify.Success]) == "SUCCESS", "Success")
  assert(notifyValue([Notify.Failure]) == "FAILURE", "Failure")
  assert(notifyValue([Notify.Delay]) == "DELAY", "Delay")
  assert(notifyValue([Notify.Failure, Notify.Success]) == "SUCCESS,FAILURE", "Failure, Success")
  assert(notifyValue([Notify.Delay, Notify.Success]) == "SUCCESS,DELAY", "Delay, Success")
  assert(
    notifyValue([Notify.Delay, Notify.Failure, Notify.Success]) == "SUCCESS,FAILURE,DELAY",
    "Delay, Failure, Success",
  )
}

test "DSN: NEVER with another value, or a value twice, is refused before MAIL FROM" {
  let bad = [
    Dsn{ notify = [Notify.Never, Notify.Failure] },
    Dsn{ notify = [Notify.Success, Notify.Never] },
    Dsn{ notify = [Notify.Delay, Notify.Delay] },
    Dsn{ notify = [Notify.Never, Notify.Never] },
  ]
  let want = ["combines NEVER", "combines NEVER", "DELAY twice", "NEVER twice"]
  let i = 0
  while (i < len(bad)) {
    let (c, log) = fakeClientEhlo(ehloDsn(), ["221 Bye\r\n"])
    let err = refusal(c, dsnRaw(bad[i]))
    c.quit() catch _ {}
    assert(contains(err.message(), "Dsn.notify"), "error = '${err.message()}'")
    assert(contains(err.message(), want[i]), "error = '${err.message()}', want '${want[i]}'")
    assert(!err.transient(), "a contradictory request must not be transient")
    let sent = <- log
    assert(sent == "EHLO client.example.com\r\nQUIT\r\n", "wire: '${sent}'")
    i = i + 1
  }
}

test "a Message carries its dsn into its envelope and onto the wire" {
  let m = plainMessage()
  m.dsn = Dsn{ notify = [Notify.Failure], ret = Ret.Full, envid = "m1" }
  let e = m.envelope()
  assert(e.dsn.ret == Ret.Full && e.dsn.envid == "m1", "envelope dsn = ${e.dsn.envid}")
  let (c, log) = fakeClientEhlo(
    ehloDsn(),
    ["250 OK\r\n", "250 OK\r\n", "354 Go\r\n", "250 Queued\r\n", "221 Bye\r\n"],
  )
  let _ = c.send(m) catch err {
    assert(false, "send: ${err.message()}")
    return
  }
  c.quit() catch _ {}
  let lines = split(<- log, "\r\n")
  assert(lines[1] == "MAIL FROM:<billing@example.com> RET=FULL ENVID=m1", "line 1 = '${lines[1]}'")
  assert(
    lines[2] == "RCPT TO:<customer@example.net> NOTIFY=FAILURE ORCPT=rfc822;customer@example.net",
    "line 2 = '${lines[2]}'",
  )
}

test "a Message with no dsn asks for nothing" {
  assert(!dsnRequested(plainMessage().envelope().dsn), "a new Message must not request DSN")
}

test "DSN: the default Dsn sends no parameter, whether or not the server offers DSN" {
  let ehlos = [ehloDsn(), ehloPlain()]
  let i = 0
  while (i < len(ehlos)) {
    let lines = dsnTranscript(ehlos[i], Dsn{})
    assert(lines[1] == "MAIL FROM:<me@x.com>", "line 1 = '${lines[1]}'")
    assert(lines[2] == "RCPT TO:<a@x.com>", "line 2 = '${lines[2]}'")
    assert(lines[3] == "RCPT TO:<b+tag@y.org>", "line 3 = '${lines[3]}'")
    i = i + 1
  }
}

test "DSN requested but not advertised: refused before MAIL FROM, permanent" {
  let asks = [Dsn{ notify = [Notify.Never] }, Dsn{ ret = Ret.Full }, Dsn{ envid = "x" }]
  let i = 0
  while (i < len(asks)) {
    let (c, log) = fakeClient(["221 Bye\r\n"])
    let err = refusal(c, dsnRaw(asks[i]))
    c.quit() catch _ {}
    assert(
        err.message() ==
        "smtp: delivery notifications were requested and the server does not offer DSN",
      "error = '${err.message()}'",
    )
    assert(!err.transient(), "a missing capability must not be transient")
    let sent = <- log
    assert(sent == "EHLO client.example.com\r\nQUIT\r\n", "wire: '${sent}'")
    i = i + 1
  }
}

test "xtext keeps 33..126 except plus and equals, and encodes the rest as +XX" {
  assert(xtext("abc-XYZ_09") == "abc-XYZ_09", "plain")
  assert(xtext("a+b=c") == "a+2Bb+3Dc", "plus and equals: ${xtext("a+b=c")}")
  assert(xtext("a b") == "a+20b", "space")
  assert(
    xtext("\x01\x7f\xc3\xa9") == "+01+7F+C3+A9",
    "controls and non-ASCII: ${xtext("\x01\x7f\xc3\xa9")}",
  )
  assert(xtext("") == "", "empty")
}

test "an envelope id with a control or non-ASCII byte is refused before MAIL FROM" {
  let ids = ["a\r\nRCPT TO:<evil@x.com>", "caf\xc3\xa9", "tab\there"]
  let i = 0
  while (i < len(ids)) {
    let (c, log) = fakeClientEhlo(ehloDsn(), ["221 Bye\r\n"])
    let err = refusal(c, dsnRaw(Dsn{ envid = ids[i] }))
    c.quit() catch _ {}
    assert(contains(err.message(), "printable ASCII"), "error = '${err.message()}'")
    let sent = <- log
    assert(sent == "EHLO client.example.com\r\nQUIT\r\n", "wire: '${sent}'")
    i = i + 1
  }
}

test "an envelope id is limited to 100 characters once encoded" {
  let ok = dsnTranscript(ehloDsn(), Dsn{ envid = repeat("x", 100) })
  assert(contains(ok[1], "ENVID=" + repeat("x", 100)), "100 characters refused: '${ok[1]}'")
  let (c, log) = fakeClientEhlo(ehloDsn(), ["221 Bye\r\n"])
  let err = refusal(c, dsnRaw(Dsn{ envid = repeat("x", 101) }))
  assert(contains(err.message(), "over 100"), "error = '${err.message()}'")
  let (c2, log2) = fakeClientEhlo(ehloDsn(), ["221 Bye\r\n"])
  let spaced = refusal(c2, dsnRaw(Dsn{ envid = repeat(" ", 34) }))
  assert(contains(spaced.message(), "over 100"), "34 spaces encode to 102: '${spaced.message()}'")
  c.close()
  c2.close()
  let _ = <- log
  let _ = <- log2
}
