// stdlib/smtp/envelope.test.bit — Envelope and Raw (#6865).
//
// The assertions are about BYTES: the transcript the fake server in
// smtp.test.bit recorded. The fake server, `ehloPlain` and `startFake` are
// module siblings, so nothing here redefines them.

import { contains, indexOf as strIndexOf, repeat, replace, split } from "std/strings"

// A message already rendered and signed by someone else: header, blank line,
// body, with a dot line in the body to prove stuffing is undone by the server
// and not applied twice.
fn rawMessage(): string {
  return "From: Bounces <noreply@inkwell.dev>\r\n" +
    "To: <a@x.com>\r\n" +
    "Subject: Signed\r\n" +
    "DKIM-Signature: v=1; a=rsa-sha256; d=inkwell.dev; bh=abc=; b=def=\r\n" +
    "\r\n" +
    "Line one\r\n.dotted\r\n.\r\n\r\nlast\r\n"
}

// Run EHLO, `send(item)`, and return the transcript, or "" with a failed
// assertion when the session itself breaks. `replies` is the script after the
// EHLO reply, QUIT excluded.
fn transcriptOf(item: Sendable, replies: []string): string {
  let script = [ehloPlain()]
  let i = 0
  while (i < len(replies)) {
    script = append(script, replies[i])
    i = i + 1
  }
  script = append(script, "221 Bye\r\n")
  let (port, log) = startFake(script) catch e {
    assert(false, "startFake: ${e.message()}")
    return ""
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return ""
  }
  c.ehlo("client.example.com") catch e {
    assert(false, "ehlo: ${e.message()}")
    return ""
  }
  c.send(item) catch e {
    assert(false, "send: ${e.message()}")
    return ""
  }
  c.quit() catch e {
    assert(false, "quit: ${e.message()}")
    return ""
  }
  return <- log
}

// The payload of `sent` as the server reads it: everything after `DATA`, up to
// the lone dot, with the dot-stuffing removed.
fn unstuffed(sent: string): string {
  let at = strIndexOf(sent, "\r\nDATA\r\n") + 8
  let end = strIndexOf(sent[at:], "\r\n.\r\n") + at + 2
  let lines = split(sent[at:end], "\r\n")
  let out = ""
  let i = 0
  while (i < len(lines) - 1) {
    let l = lines[i]
    if (len(l) > 1 && l[0] == u8(46) && l[1] == u8(46)) {
      l = l[1:]
    }
    out = out + l + "\r\n"
    i = i + 1
  }
  return out
}

test "send of a Raw puts the explicit MAIL FROM on the wire and the payload byte for byte" {
  let raw = rawMessage()
  let r = Raw(Envelope{ from = "bounce+42@inkwell.dev", to = ["a@x.com", "b@y.org"] }, raw)
  let sent = transcriptOf(
    r,
    ["250 OK\r\n", "250 OK\r\n", "250 OK\r\n", "354 Go\r\n", "250 Queued\r\n"],
  )
  let lines = split(sent, "\r\n")
  assert(lines[1] == "MAIL FROM:<bounce+42@inkwell.dev>", "line 1 = '${lines[1]}'")
  assert(lines[2] == "RCPT TO:<a@x.com>", "line 2 = '${lines[2]}'")
  assert(lines[3] == "RCPT TO:<b@y.org>", "line 3 = '${lines[3]}'")
  assert(lines[4] == "DATA", "line 4 = '${lines[4]}'")
  assert(contains(sent, "\r\n..dotted\r\n"), "a leading dot was not stuffed")
  assert(unstuffed(sent) == raw, "the payload differs from the raw bytes: ${unstuffed(sent)}")
}

test "an empty from sends the null reverse-path" {
  let r = Raw(Envelope{ from = "", to = ["a@x.com"] }, rawMessage())
  let sent = transcriptOf(r, ["250 OK\r\n", "250 OK\r\n", "354 Go\r\n", "250 Queued\r\n"])
  let lines = split(sent, "\r\n")
  assert(lines[1] == "MAIL FROM:<>", "line 1 = '${lines[1]}'")
}

test "a Message sends under an envelope derived from its sender and recipients" {
  let m = plainMessage()
  m.addBcc(Address{ name = "", email = "audit@x.com" })
  let e = m.envelope()
  assert(e.from == "billing@example.com", "from = ${e.from}")
  assert(len(e.to) == 2, "${len(e.to)} recipients")
  assert(
    e.to[0] == "customer@example.net" && e.to[1] == "audit@x.com",
    "to = ${e.to[0]}, ${e.to[1]}",
  )
}

// Send `raw` under a valid envelope and assert it is refused with nothing but
// EHLO on the wire and `want` in the error.
fn assertRawRefused(raw: string, want: string) {
  let (port, log) = startFake([ehloPlain(), "221 Bye\r\n"]) catch e {
    assert(false, "startFake: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  c.ehlo("client.example.com") catch e {
    assert(false, "ehlo: ${e.message()}")
    return
  }
  let r = Raw(Envelope{ from = "me@x.com", to = ["a@x.com"] }, raw)
  let msg = ""
  c.send(r) catch e {
    msg = e.message()
  }
  c.quit() catch _ {}
  assert(contains(msg, want), "error '${msg}' does not contain '${want}'")
  let sent = <- log
  assert(sent == "EHLO client.example.com\r\nQUIT\r\n", "wire after refusal: '${sent}'")
}

test "raw data with a bare LF is refused and names the line" {
  assertRawRefused("A: b\r\n\r\nbody\nmore\r\n", "line 3")
}

test "raw data with a bare CR is refused and names the line" {
  assertRawRefused("A: b\r\n\r\nbo\rdy\r\n", "line 3")
}

test "raw data with no blank line is refused" {
  assertRawRefused("A: b\r\nC: d\r\n", "no blank line")
}

test "raw data with a 1000-octet line is refused and names the line" {
  assertRawRefused("A: b\r\n\r\n" + repeat("x", 1000) + "\r\n", "line 3")
}

test "raw data with a NUL is refused" {
  assertRawRefused("A: b\r\n\r\nbo" + string([u8(0)]) + "dy\r\n", "NUL")
}

test "raw data whose last line has no CRLF is refused" {
  assertRawRefused("A: b\r\n\r\nbody", "line 3")
}

test "a 997-octet line is accepted and a 998-octet one is not" {
  let ok = Raw(Envelope{ from = "", to = ["a@x.com"] }, "A: b\r\n\r\n" + repeat("x", 997) + "\r\n")
  let out = ok.render() catch e {
    assert(false, "997 octets refused: ${e.message()}")
    return
  }
  assert(len(out) == 8 + 997 + 2, "render changed the bytes")
  let bad = Raw(Envelope{ from = "", to = ["a@x.com"] }, "A: b\r\n\r\n" + repeat("x", 998) + "\r\n")
  let refused = false
  bad.render() catch _ {
    refused = true
  }
  assert(refused, "998 octets accepted")
}

// Send a Raw under `e` and assert it fails with only EHLO on the wire.
fn assertEnvelopeRefused(e: Envelope, want: string) {
  let (port, log) = startFake([ehloPlain(), "221 Bye\r\n"]) catch err {
    assert(false, "startFake: ${err.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch err {
    assert(false, "dial: ${err.message()}")
    return
  }
  c.ehlo("client.example.com") catch err {
    assert(false, "ehlo: ${err.message()}")
    return
  }
  let msg = ""
  c.send(Raw(e, rawMessage())) catch err {
    msg = err.message()
  }
  c.quit() catch _ {}
  assert(contains(msg, want), "error '${msg}' does not contain '${want}'")
  let sent = <- log
  assert(sent == "EHLO client.example.com\r\nQUIT\r\n", "wire after refusal: '${sent}'")
}

test "an envelope with no recipient is refused" {
  assertEnvelopeRefused(Envelope{ from = "me@x.com", to = []string(0) }, "no recipients")
}

test "an envelope address carrying CR or LF is refused, sender and recipient" {
  assertEnvelopeRefused(
    Envelope{ from = "me@x.com\r\nRCPT TO:<evil@x.com>", to = ["a@x.com"] },
    "sender address",
  )
  assertEnvelopeRefused(
    Envelope{ from = "me@x.com", to = ["a@x.com", "b@x.com\nDATA"] },
    "forbidden byte",
  )
}

test "a malformed envelope address is refused" {
  assertEnvelopeRefused(Envelope{ from = "no-at-sign", to = ["a@x.com"] }, "sender address")
  assertEnvelopeRefused(Envelope{ from = "", to = ["a b@x.com"] }, "recipient address")
}

test "a rendered Message sent as Raw under another envelope keeps its bytes" {
  let m = plainMessage()
  m.setMessageId("fixed@example.com")
  let rendered = m.render() catch e {
    assert(false, "render: ${e.message()}")
    return
  }
  let r = Raw(Envelope{ from = "bounce@example.com", to = ["staging@example.com"] }, rendered)
  let sent = transcriptOf(r, ["250 OK\r\n", "250 OK\r\n", "354 Go\r\n", "250 Queued\r\n"])
  assert(unstuffed(sent) == rendered, "the rendered bytes changed on the wire")
  assert(
    !contains(replace(sent, "RCPT TO:<staging@example.com>", ""), "staging@"),
    "recipient leaked",
  )
}
