// Bit standard library — prof module (#1906): an in-process CPU sampling
// profiler.
//
// NOT a `pprof`-format (protobuf) profiler — the output is a small,
// self-describing text format (`BITPROF1`) that this package's own
// `tools/prof/render.bit` reads back and symbolizes against the profiled
// binary's own Mach-O local symbol table. See that file for the render half.
//
// `startCpu`/`stopCpu(path)` bracket the region to sample, the same shape as
// Go's `pprof.StartCPUProfile`/`StopCPUProfile`: nothing here runs unless a
// program calls `startCpu` — no env var, no boot-time hook, no background
// cost when unused. The "disabled costs nothing" requirement holds by
// construction, not by a runtime flag check: an unprofiled program never
// calls into `runtime/root/darwin/prof.bit` at all.
//
// aarch64-macos ONLY, today. The runtime half is Darwin-specific
// (`SIGPROF`/`setitimer`); calling `startCpu` on another platform fails at
// LINK time (`bit_rt_prof_start` etc. are undefined there) rather than
// silently doing nothing. Linux/Windows support is out of scope for #1906.
//
// Only a leaf PC is recorded per tick, not a call stack (see the runtime
// file's header for why), and only one OS thread is sampled (the one that
// happens to receive `SIGPROF` — validated with `BIT_WORKERS=1`). Both are
// stated scope cuts, not silent gaps.

import { writeFile } from "std/fs"
import { selfExe } from "std/os"

extern fn bit_rt_prof_start(intervalMicros: int): int
extern fn bit_rt_prof_stop(): int
extern fn bit_rt_prof_sample(i: int): int

// The ring capacity `runtime/root/darwin/prof.bit` stores samples up to.
// Duplicated here only to print an honest "profile may be truncated" note in
// the written file; it is not part of the runtime ABI value itself, and
// `stopCpu`'s returned count is always the authoritative sample total.
const profSampleCap: int = 8192

// Start sampling this process's own CPU use at approximately `hz` samples
// per second (clamped to [1, 100000]). Must be paired with a later
// `stopCpu(path)` — this call only arms the timer. Calling `startCpu` again
// before `stopCpu` re-arms the timer and resets the sample ring; it does not
// stack. (`path` is not remembered here rather than kept in module state:
// module-level `let` may hold only untraced scalars — §11.11 — never a
// GC-managed `string`, so `stopCpu` takes it directly instead.)
export fn startCpu(hz: int) {
  let rate = hz
  if (rate < 1) {
    rate = 1
  }
  if (rate > 100000) {
    rate = 100000
  }
  let _ = bit_rt_prof_start(1000000 / rate)
}

// Stop sampling and write the captured profile to `path`. Returns the number
// of samples actually stored (at most `profSampleCap`; a busier run reports
// more ticks than it could store, and the written file's `cap` line makes
// that visible rather than hiding it).
export fn stopCpu(path: string): int! {
  let n = bit_rt_prof_stop()
  let out = "BITPROF1\nbinary ${selfExe()}\nsamples ${n} cap ${profSampleCap}\n"
  let i = 0
  while (i < n) {
    out = out + "${bit_rt_prof_sample(i)}\n"
    i = i + 1
  }
  writeFile(path, out)?
  return n
}
