// Bit standard library — std/tls, the host name a client dials: the bracket form
// a URL writes an IPv6 authority in, and the IP-literal test that keeps an
// address out of the ClientHello's server_name (RFC 6066 section 3).

import { isIpv4Literal as tlsapiIsIpv4, isIpv6Literal as tlsapiIsIpv6 } from "std/net"

// `host` without the square brackets of a URL's IPv6 authority ("[::1]" is
// "::1"); any other text is returned unchanged.
fn tlsapiHostName(host: string): string {
  if (len(host) >= 2 && host[0] == 91 && host[len(host) - 1] == 93) {
    return host[1:len(host) - 1]
  }
  return host
}

// Whether `host` is an IPv4 or IPv6 literal. The name a certificate is verified
// against is still the literal (an iPAddress SAN), but RFC 6066 section 3 forbids
// it as a server_name: `clientBuildExts` (client.bit) sends no SNI for one.
fn tlsapiIsIpLiteral(host: string): bool {
  return tlsapiIsIpv4(host) || tlsapiIsIpv6(host)
}
