// Bit standard library — std/tls, the TLS 1.3 cipher-suite registry (RFC 8446
// §B.4, §9.1).
//
// A `CipherSuite` is a pure data descriptor: a code point (`id`), its registered
// name, and the four lengths a TLS 1.3 record layer needs to size its key
// schedule — `keyLen` (AEAD key), `ivLen` (the fixed 12-byte record nonce),
// `tagLen` (the AEAD tag / record overhead), and `hashLen` (the transcript-hash
// and HKDF digest length). It carries no cipher state itself; the two builders
// turn a descriptor into a live primitive — `tlsSuiteNewAead` an `Aead`, keyed
// from raw bytes, and `tlsSuiteNewHash` the matching `Hash` — so the rest of the
// handshake can drive HKDF-Expand-Label and record protection against the two
// std/crypto interfaces without naming a concrete algorithm.
//
// Only the three mandatory suites are registered. RFC 8446 §9.1 requires a
// TLS 1.3 implementation to support TLS_AES_128_GCM_SHA256 and SHOULD support
// TLS_AES_256_GCM_SHA384 and TLS_CHACHA20_POLY1305_SHA256; TLS 1.3 removed the
// CBC/RC4/static-RSA suites entirely, so this is the whole modern set. The
// crypto is KAT-verified in std/crypto — this module is only the binding: which
// AEAD, which hash, which lengths for each code point.

// `Hash` is imported module-wide by keyschedule.bit (std/tls is one flat module).
import { Aead, newGcm, newChaChaPoly, newSha256, newSha384 } from "std/crypto"

// The three mandatory TLS 1.3 cipher-suite code points, as the two-byte values
// registered by IANA and carried on the wire (RFC 8446 §B.4).
export const TLS_AES_128_GCM_SHA256: int = 0x1301
export const TLS_AES_256_GCM_SHA384: int = 0x1302
export const TLS_CHACHA20_POLY1305_SHA256: int = 0x1303

// A TLS 1.3 cipher-suite descriptor. `id` is the IANA code point; `name` its
// registered string; `keyLen`/`ivLen`/`tagLen` size the AEAD (key, fixed record
// nonce, tag), and `hashLen` is the suite's HKDF / transcript-hash digest
// length. Obtain one from `tlsSuiteById` or `tlsSuitePreference` rather than a
// struct literal, so every field is consistent with the code point.
export struct CipherSuite {
  id: int,
  name: string,
  keyLen: int,
  ivLen: int,
  tagLen: int,
  hashLen: int,
}

// TLS_AES_128_GCM_SHA256: AES-128-GCM (16-byte key) with SHA-256 (32-byte hash).
fn tlsSuiteAes128Gcm(): CipherSuite {
  return CipherSuite{
    id: TLS_AES_128_GCM_SHA256,
    name: "TLS_AES_128_GCM_SHA256",
    keyLen: 16,
    ivLen: 12,
    tagLen: 16,
    hashLen: 32,
  }
}

// TLS_AES_256_GCM_SHA384: AES-256-GCM (32-byte key) with SHA-384 (48-byte hash).
fn tlsSuiteAes256Gcm(): CipherSuite {
  return CipherSuite{
    id: TLS_AES_256_GCM_SHA384,
    name: "TLS_AES_256_GCM_SHA384",
    keyLen: 32,
    ivLen: 12,
    tagLen: 16,
    hashLen: 48,
  }
}

// TLS_CHACHA20_POLY1305_SHA256: ChaCha20-Poly1305 (32-byte key) with SHA-256.
fn tlsSuiteChaCha20Poly1305(): CipherSuite {
  return CipherSuite{
    id: TLS_CHACHA20_POLY1305_SHA256,
    name: "TLS_CHACHA20_POLY1305_SHA256",
    keyLen: 32,
    ivLen: 12,
    tagLen: 16,
    hashLen: 32,
  }
}

// The registry's preference order, ChaCha20-Poly1305 first, then AES-256-GCM, then
// AES-128-GCM. ChaCha20-Poly1305 leads deliberately (RFC 7905): this toolchain
// emits no AES-NI, and our AES S-box is computed (constant-time, no data-dependent
// table lookups) rather than tabled, so software AES-GCM runs ~80x slower than the
// ARX ChaCha20-Poly1305. On any platform without AES hardware, ChaCha is both the
// faster and the safe-by-construction choice — the same reason mobile TLS stacks
// prefer it. A fresh slice each call, so a caller may reorder or filter in place.
export fn tlsSuitePreference(): []CipherSuite {
  let suites = []CipherSuite(0)
  suites = append(suites, tlsSuiteChaCha20Poly1305())
  suites = append(suites, tlsSuiteAes256Gcm())
  suites = append(suites, tlsSuiteAes128Gcm())
  return suites
}

// The descriptor for code point `id`, or a failure if `id` is not one of the
// three mandatory TLS 1.3 suites (this registry holds no legacy suites).
export fn tlsSuiteById(id: int): CipherSuite! {
  if (id == TLS_AES_128_GCM_SHA256) {
    return tlsSuiteAes128Gcm()
  }
  if (id == TLS_AES_256_GCM_SHA384) {
    return tlsSuiteAes256Gcm()
  }
  if (id == TLS_CHACHA20_POLY1305_SHA256) {
    return tlsSuiteChaCha20Poly1305()
  }
  fail newError("tls: unknown cipher suite ${id}")
}

// Key the suite's AEAD from `key`, returning it as the `Aead` interface so the
// caller need not name AES-GCM vs ChaCha20-Poly1305. FAILS if `key` is not the
// suite's `keyLen` — the guard is here so a mis-sized key is a clean error, not
// a panic deeper in `newGcm`/`newChaChaPoly`. The AEAD is fresh; the caller owns
// the key material.
export fn tlsSuiteNewAead(suite: CipherSuite, key: []byte): Aead! {
  if (len(key) != suite.keyLen) {
    fail newError("tls: ${suite.name} needs a ${suite.keyLen}-byte key, got ${len(key)}")
  }
  if (suite.id == TLS_CHACHA20_POLY1305_SHA256) {
    let aead: Aead = newChaChaPoly(key)?
    return aead
  }
  // Both GCM suites; `newGcm` selects AES-128 vs AES-256 by the key length,
  // which the guard above has already pinned to the suite's `keyLen`.
  let aead: Aead = newGcm(key)?
  return aead
}

// A fresh `Hash` for the suite's transcript / HKDF digest — SHA-384 for
// TLS_AES_256_GCM_SHA384 (48-byte output), SHA-256 for the other two.
export fn tlsSuiteNewHash(suite: CipherSuite): Hash {
  if (suite.hashLen == 48) {
    return newSha384()
  }
  return newSha256()
}
