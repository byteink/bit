// Bit standard library — std/tls, why a client handshake failed (#6983).
//
// `dial`, `dialDeadline` and `client` fail with a `HandshakeError` whenever the
// handshake itself fails, and its `kind` says which of three things went wrong,
// because a caller's next move differs for each: retrying a network failure
// can succeed, retrying a certificate the peer will present again cannot.
//
//   Verification  the peer's identity was not proven: an untrusted or
//                 self-signed chain, a name the certificate does not cover, an
//                 expired or not-yet-valid certificate, a bad CertificateVerify
//                 signature.
//   Negotiation   the two sides could not agree or the peer broke the protocol:
//                 no shared version, cipher suite or group, an alert from the
//                 peer, a malformed or out-of-order handshake message.
//   Io            the transport failed under the handshake: a reset, a close
//                 mid-record, a timeout.
//
// `kind` is decided where the failure is raised, never by reading a message:
// `tlsapiIoFail` marks what the framer's socket calls raise, `tlsAlertFail`
// (alert.bit) marks a certificate rejection with the alert it sends, and every
// other failure the handshake state machine raises is a negotiation failure.
// A TCP connect or resolve failure in `dial` happens before any handshake and
// stays the plain `std/net` error, not a `HandshakeError`.

// What kind of failure ended a client handshake. See the file header.
export enum HandshakeFailure { Verification, Negotiation, Io }

// A client handshake that did not complete. `message()` is the text the
// underlying failure always had, so a caller that only prints it sees no
// change; `kind` is what a retry loop reads.
export class HandshakeError {
  export kind: HandshakeFailure
  msg: string

  export message(): string { return this.msg }
}

// A transport failure under the handshake or a record read: the framer's socket
// calls raise this instead of the bare `std/net` error so `tlsapiFailureKind`
// can tell it from a protocol failure without reading text. `message()` returns
// the `std/net` text unchanged.
class tlsapiIoFail {
  msg: string
  message(): string { return this.msg }
}

// Whether alert `desc` (RFC 8446 §6.2) is a certificate rejection: the client
// tags exactly these when the chain or the CertificateVerify signature fails.
fn tlsapiIsCertAlert(desc: int): bool {
  return desc == alertBadCertificate ||
    desc == alertCertificateExpired ||
    desc == alertUnknownCa ||
    desc == alertDecryptError
}

// The kind of failure `e`, which a client handshake raised.
fn tlsapiFailureKind(e: error): HandshakeFailure {
  let (_, io) = e.(tlsapiIoFail)
  if (io) {
    return HandshakeFailure.Io
  }
  let (tagged, ok) = e.(tlsAlertFail)
  if (ok && tlsapiIsCertAlert(tagged.desc)) {
    return HandshakeFailure.Verification
  }
  return HandshakeFailure.Negotiation
}

// `e`, a client handshake failure, as the typed error `dial` returns.
fn tlsapiHandshakeError(e: error): HandshakeError {
  return HandshakeError{ kind = tlsapiFailureKind(e), msg = e.message() }
}
