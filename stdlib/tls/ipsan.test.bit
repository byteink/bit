// stdlib/tls/ipsan.test.bit — a client that dials an IP literal (#7409).
//
// RFC 6066 section 3: "Literal IPv4 and IPv6 addresses are not permitted in
// HostName", so the ClientHello carries no server_name for an IP host. The
// certificate is then matched against its iPAddress SubjectAltName entries only
// (RFC 9110 section 4.3.4, RFC 5280 section 4.2.1.6): 4 octets for IPv4, 16 for
// IPv6, never a dNSName or the CN that happens to spell the address.
//
// The fixtures are a throwaway P-256 CA and one RSA leaf key under three
// certificates, all CN=127.0.0.1, valid 2026-10-06 .. 2036-10-03:
//   ipsIpHex     SAN iPAddress 127.0.0.1 and ::1
//   ipsDnsHex    SAN dNSName "127.0.0.1" and "::1" and no iPAddress
//   ipsMappedHex SAN iPAddress ::ffff:10.0.0.1 (16 octets, an IPv4-mapped form)
// `creqPem` is a sibling from certrequest.test.bit (std/tls is one flat module).

import { x509MatchHostname } from "std/crypto"

const ipsCaHex: string = ""
const ipsIpHex: string = ""
const ipsDnsHex: string = ""
const ipsMappedHex: string = ""
const ipsKeyHex: string = ""
const ipsNow: int = 1800000000

fn ipsCert(h: string): X509Certificate! {
  return x509Parse(decodeHex(h)?)?
}

fn ipsTrust(): TrustStore! {
  return TrustStore{ roots = [ipsCert(ipsCaHex)?] }
}

fn ipsServerConfig(certHex: string): TlsServerConfig! {
  return TlsServerConfig(
    creqPem("CERTIFICATE", certHex),
    creqPem("PRIVATE KEY", ipsKeyHex),
    []string(0),
  )?
}

// Whether `host` matches the certificate `certHex`; a parse failure fails the test.
fn ipsMatches(certHex: string, host: string): bool {
  let cert = ipsCert(certHex) catch e {
    assert(false, "fixture: ${e.message()}")
    return false
  }
  return x509MatchHostname(cert, host)
}

fn ipsExpect(certHex: string, host: string, want: bool) {
  assert(ipsMatches(certHex, host) == want, "match '${host}' want ${want}")
}

test "an IP host matches the iPAddress SANs, 4 octets for IPv4 and 16 for IPv6" {
  ipsExpect(ipsIpHex, "127.0.0.1", true)
  ipsExpect(ipsIpHex, "127.0.0.2", false)
  ipsExpect(ipsIpHex, "::1", true)
  ipsExpect(ipsIpHex, "0:0:0:0:0:0:0:1", true)
  ipsExpect(ipsIpHex, "0::0:1", true)
  ipsExpect(ipsIpHex, "0000:0000:0000:0000:0000:0000:0000:0001", true)
  ipsExpect(ipsIpHex, "::0.0.0.1", true)
  ipsExpect(ipsIpHex, "::2", false)
  ipsExpect(ipsIpHex, "::", false)
  ipsExpect(ipsIpHex, "1::", false)
  ipsExpect(ipsIpHex, "100::1", false)
}

test "text that is not an IP address is never an IPv6 match" {
  ipsExpect(ipsIpHex, ":::1", false)
  ipsExpect(ipsIpHex, "1:::1", false)
  ipsExpect(ipsIpHex, "::1::", false)
  ipsExpect(ipsIpHex, "0:0:0:0:0:0:0:0:1", false)
  ipsExpect(ipsIpHex, "0:0:0:0:0:0:1", false)
  ipsExpect(ipsIpHex, "0:0:0:0:0:0:0::1", false)
  ipsExpect(ipsIpHex, "::00001", false)
  ipsExpect(ipsIpHex, "::g", false)
  ipsExpect(ipsIpHex, "[::1]", false)
  ipsExpect(ipsIpHex, "::1%eth0", false)
  ipsExpect(ipsIpHex, "", false)
}

test "an IPv4-mapped IPv6 form and its IPv4 form are one address" {
  ipsExpect(ipsIpHex, "::ffff:127.0.0.1", true)
  ipsExpect(ipsIpHex, "::FFFF:7f00:1", true)
  ipsExpect(ipsIpHex, "::ffff:127.0.0.2", false)
  ipsExpect(ipsMappedHex, "10.0.0.1", true)
  ipsExpect(ipsMappedHex, "::ffff:10.0.0.1", true)
  ipsExpect(ipsMappedHex, "10.0.0.2", false)
  ipsExpect(ipsMappedHex, "::ffff:10.0.0.2", false)
}

test "a dNSName that spells an IP is never matched against an IP host" {
  ipsExpect(ipsDnsHex, "127.0.0.1", false)
  ipsExpect(ipsDnsHex, "::1", false)
  ipsExpect(ipsDnsHex, "[::1]", false)
}

// The ClientHello a client configured for `serverName` hands out.
fn ipsHello(serverName: string): ClientHello! {
  let cfg = creqClientConfig()
  cfg.serverName = serverName
  let c = tlsClientStart(cfg)?
  return parseClientHello(c.clientHelloMessage())?
}

fn ipsHasSni(ch: ClientHello): bool {
  for e of ch.extensions {
    if (e.extType == extTypeServerName) {
      return true
    }
  }
  return false
}

fn ipsSniOf(serverName: string): bool {
  let ch = ipsHello(serverName) catch e {
    assert(false, "hello for '${serverName}': ${e.message()}")
    return false
  }
  return ipsHasSni(ch)
}

test "a ClientHello for an IP host carries no server_name, one for a DNS name does" {
  assert(ipsSniOf("localhost"), "a DNS name must still be sent as SNI")
  assert(ipsSniOf("example.com"), "a DNS name must still be sent as SNI")
  assert(!ipsSniOf("127.0.0.1"), "an IPv4 literal was sent as SNI")
  assert(!ipsSniOf("::1"), "an IPv6 literal was sent as SNI")
  assert(!ipsSniOf("2001:db8::1"), "an IPv6 literal was sent as SNI")
  assert(!ipsSniOf("::ffff:127.0.0.1"), "an IPv4-mapped literal was sent as SNI")
}

test "tlsapiClientConfig strips URL brackets and keeps the literal as the verified name" {
  let cfg = tlsapiClientConfig("[::1]", TlsConfig(emptyTrustStore())) catch e {
    assert(false, "config: ${e.message()}")
    return
  }
  assert(cfg.serverName == "::1", "verified name '${cfg.serverName}'")
  let named = tlsapiClientConfig(
    "[::1]",
    TlsConfig(emptyTrustStore(), serverName = "[2001:db8::1]"),
  ) catch e {
    assert(false, "config: ${e.message()}")
    return
  }
  assert(named.serverName == "2001:db8::1", "verified name '${named.serverName}'")
}

// Read the first TLS record the client sends, then close, and hand the
// ClientHello it carried to `got`.
fn ipsCapture(ln: NetListener, got: chan<string>) {
  let c = ln.accept() catch _ {
    got <- ""
    return
  }
  let rec = c.read(65536)
  while (len(rec) >= 5 && len(rec) < 5 + int(rec[3]) * 256 + int(rec[4])) {
    let more = c.read(65536)
    if (len(more) == 0) {
      break
    }
    rec = rec + more
  }
  c.close()
  got <- rec
}

// Dial `host` with a raw listener behind it and return the ClientHello on the
// wire (empty when none arrived).
fn ipsWireHello(bind: string, host: string): string {
  let ln = tlsapiTcpListen(bind, 0) catch e {
    println("skip: cannot listen on ${bind} (${e.message()})")
    return "skip"
  }
  let port = ln.port() catch _ {
    ln.close()
    return ""
  }
  let got = chan<string>(1)
  spawn ipsCapture(ln, got)
  let c = dial(host, port, TlsConfig(emptyTrustStore(), nowUnix = ipsNow)) catch _ {
    let rec = <- got
    ln.close()
    return rec
  }
  c.close()
  ln.close()
  return ""
}

fn ipsWireNoSni(bind: string, host: string) {
  let rec = ipsWireHello(bind, host)
  if (rec == "skip") {
    return
  }
  assert(len(rec) > 9, "no ClientHello reached the server for ${host}")
  let ch = parseClientHello([]byte(rec[5:len(rec)])) catch e {
    assert(false, "ClientHello for ${host}: ${e.message()}")
    return
  }
  assert(!ipsHasSni(ch), "the ClientHello for ${host} carries a server_name")
}

test "the ClientHello on the wire for dial(127.0.0.1) and dial(::1) has no server_name" {
  ipsWireNoSni("127.0.0.1", "127.0.0.1")
  ipsWireNoSni("::1", "::1")
  ipsWireNoSni("::1", "[::1]")
}

// Serve one TLS connection: answer a request line with a fixed 200.
fn ipsServe(l: TlsListener) {
  let c = l.accept() catch _ {
    return
  }
  c.handshake() catch _ {
    c.close()
    return
  }
  c.read(4096) catch _ {
    c.close()
    return
  }
  c.write([]byte("HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok")) catch _ {
    c.close()
    return
  }
  c.close()
}

// A TLS GET to `host` (bind address `bind`) with a server certificate `certHex`
// and the test CA as the only root; the response, or the dial's error message.
fn ipsGet(bind: string, host: string, certHex: string): string {
  let sc = ipsServerConfig(certHex) catch e {
    return "server config: ${e.message()}"
  }
  let l = listen(bind, 0, sc) catch e {
    println("skip: cannot listen on ${bind} (${e.message()})")
    return "skip"
  }
  let port = l.port() catch e {
    l.close()
    return "port: ${e.message()}"
  }
  spawn ipsServe(l)
  let trust = ipsTrust() catch e {
    l.close()
    return "trust: ${e.message()}"
  }
  let c = dial(host, port, TlsConfig(trust, nowUnix = ipsNow)) catch e {
    l.close()
    return "dial: ${e.message()}"
  }
  c.write([]byte("GET / HTTP/1.1\r\nHost: ${host}\r\n\r\n")) catch e {
    c.close()
    l.close()
    return "write: ${e.message()}"
  }
  let body = c.read(4096) catch e {
    c.close()
    l.close()
    return "read: ${e.message()}"
  }
  c.close()
  l.close()
  return string(body)
}

fn ipsExpectGet(bind: string, host: string) {
  let r = ipsGet(bind, host, ipsIpHex)
  if (r == "skip") {
    return
  }
  assert(contains(r, "200 OK"), "GET https://${host}/: ${r}")
}

test "a TLS GET to an IPv4 literal verifies the iPAddress SAN" {
  ipsExpectGet("127.0.0.1", "127.0.0.1")
}

test "a TLS GET to an IPv6 literal verifies the iPAddress SAN, bare and bracketed" {
  ipsExpectGet("::1", "::1")
  ipsExpectGet("::1", "[::1]")
}

test "a certificate with only a dNSName spelling the IP is refused for that IP" {
  let r = ipsGet("127.0.0.1", "127.0.0.1", ipsDnsHex)
  assert(contains(r, "not valid for hostname 127.0.0.1"), "IPv4: ${r}")
  let r6 = ipsGet("::1", "::1", ipsDnsHex)
  if (r6 != "skip") {
    assert(contains(r6, "not valid for hostname ::1"), "IPv6: ${r6}")
  }
}
