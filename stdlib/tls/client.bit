// Bit standard library — std/tls, the TLS 1.3 client handshake (RFC 8446, #1206).
//
// A sans-I/O 1-RTT client handshake state machine. It owns no sockets: the
// caller drives it by shuttling flights of raw record bytes, which makes it
// equally at home over a TCP stream, an in-memory pipe, or a recorded trace.
//
//   let h = tlsClientStart(config)?      // build ClientHello, seed the transcript
//   send(h.hello)                        // flight 1: the ClientHello record
//   let step = h.processServerFlight(recv())?
//   while (step.retry) {                 // HelloRetryRequest -> resend
//     send(step.outbound)
//     step = h.processServerFlight(recv())?
//   }
//   send(step.outbound)                  // flight 3: the client Finished
//   let conn = h.connection()?           // application-data channel
//
// The handshake composes the rest of std/tls: `groups` for the (EC)DHE / hybrid
// key exchange, `ciphersuites` for the AEAD + hash, `keyschedule` for the HKDF
// ladder, `handshake` for the wire messages, and `record` for AEAD record
// protection. Server authentication is the security core and is never skipped
// beyond `insecureSkipVerify` (which drops only chain + hostname, never the
// CertificateVerify signature or the Finished MAC): the certificate chain is
// verified with std/crypto's X.509 verifier against a caller-supplied
// `TrustStore` and the SNI hostname, the server's CertificateVerify signature is
// checked over the RFC 8446 §4.4.3 signed content, and the server Finished MAC
// is checked in constant time. Any failure is a fatal handshake error.
//
// std/tls is one flat module, so this file calls its siblings (`tlsSuite*`,
// `tlsGroup*`, the key schedule, the `encode*`/`parse*` handshake codecs, and the
// `tlsHsPutBytes` / `tlsHsWrap` framing helpers) directly. It imports from
// std/crypto only the verification primitives no sibling already imports; the
// `Certificate` message struct from `handshake.bit` would collide with x509's
// `Certificate`, so the parsed-certificate type is imported under the alias
// `X509Certificate`. Every private free function is prefixed `client`; the record
// framing shared with the server is prefixed `tlsWire` and lives in `wire.bit`.
//
// Since #1503 the client is spread over siblings, all one flat module: this file
// holds the trust store, the configuration, the handshake/connection types, and
// `tlsClientStart*` — building flight 1. `clientflight.bit` holds
// `processServerFlight` and the server-authentication path it drives;
// `clientquic.bit` the QUIC-TLS entry points that bypass record framing.

import { Certificate as X509Certificate, x509Parse, x509VerifyChain } from "std/crypto"
import { x509KeyRSA, x509KeyECDSA, x509KeyEd25519 } from "std/crypto"
import { ecdsaPublicKey, ecdsaVerify, ecdsaSignatureFromDer } from "std/crypto"
import { ed25519Verify, rsaVerifyPss, rsaParsePkcs1PublicKey } from "std/crypto"
import { newSha512, randomBytes, ctEq } from "std/crypto"
import { pemDecode } from "std/crypto"

// ---------------------------------------------------------------------------
// Trust store and configuration
// ---------------------------------------------------------------------------

// A set of trusted root certificates the client verifies a server chain up to
// (RFC 8446 §4.4.2). Build one from PEM with `newTrustStore`, or from
// already-parsed roots via the struct literal.
export struct TrustStore { export roots: []X509Certificate }

// A `TrustStore` from a PEM bundle of one or more `CERTIFICATE` blocks (the usual
// system-roots format). Fails on malformed PEM or a certificate this X.509 parser
// rejects. Non-CERTIFICATE blocks are ignored.
export function newTrustStore(rootsPem: string): TrustStore! {
  let blocks = pemDecode(rootsPem)?
  let roots = []X509Certificate(0)
  for b of blocks {
    if (b.label == "CERTIFICATE") {
      roots = append(roots, x509Parse(b.der)?)
    }
  }
  if (len(roots) == 0) {
    fail newError("tls client: trust store has no CERTIFICATE blocks")
  }
  return TrustStore{ roots: roots }
}

// A client handshake configuration.
//
//   serverName          the SNI host and the name the certificate must match
//   alpn                ALPN protocols offered, most-preferred first (empty = none)
//   trust               the roots a server chain is verified against
//   insecureSkipVerify  skip chain + hostname verification (still verifies the
//                       CertificateVerify signature and the Finished MAC); for
//                       testing and trace replay only
//   nowUnix             the current time (Unix seconds) for certificate validity
//   groups              named groups offered in supported_groups, preferred first
//   keyShareGroups      the subset of `groups` to send an actual key_share for
//                       (empty = all of `groups`); a group offered here but not
//                       shared is what lets a server request it via HRR
//   suites              cipher suites offered (empty = all three mandatory suites)
//   clientHelloOverride advanced: exact ClientHello handshake bytes to send in
//                       place of the built one (empty = build). For deterministic
//                       replay and callers crafting their own ClientHello.
//   ephemeralOverride   advanced: ephemeral keypairs to use instead of freshly
//                       generated ones, parallel to `keyShareGroups`/`groups`.
export struct TlsClientConfig {
  export serverName: string,
  export alpn: []string,
  export trust: TrustStore,
  export insecureSkipVerify: bool,
  export nowUnix: int,
  export groups: []TlsGroup,
  export keyShareGroups: []TlsGroup,
  export suites: []int,
  export clientHelloOverride: []byte,
  export ephemeralOverride: []GroupKeypair,
}

// One key_share the client offered: the group, its wire codepoint, and the
// ephemeral keypair whose public half is on the wire and private half derives
// the shared secret when the server selects this group.
struct clientOffer { group: TlsGroup, cp: int, kp: GroupKeypair }

// One step of the client handshake produced by `processServerFlight`.
//
//   retry     the server sent a HelloRetryRequest; send `outbound` and feed the
//             next server flight back into `processServerFlight`
//   done      the handshake completed; `outbound` is the client Finished to send,
//             after which `connection()` yields the application channel
//   outbound  the record(s) to send now
export struct TlsClientStep { export retry: bool, export done: bool, export outbound: []byte }

// A completed client connection: the negotiated parameters and the two
// application-data record contexts. Obtain it from `TlsClientHandshake.connection`
// once the handshake is done.
export struct TlsClientConn {
  suite: CipherSuite,
  alpn: string,
  peerCerts: [][]byte,
  appWrite: RecordKeys,
  appRead: RecordKeys,
  exporter: []byte,
  resumption: []byte,
}

// The in-progress client handshake state. Its only public surface is `hello`
// (the ClientHello record to send first) and the methods below; everything else
// is derived as the handshake advances.
export struct TlsClientHandshake {
  config: TlsClientConfig,
  offers: []clientOffer,
  clientRandom: []byte,
  sessionId: []byte,
  ch1: []byte,
  transcript: []byte,
  suite: CipherSuite,
  shared: []byte,
  hsSec: []byte,
  chs: []byte,
  shs: []byte,
  serverHsKeys: RecordKeys,
  clientHsKeys: RecordKeys,
  usedHrr: bool,
  peerCerts: [][]byte,
  alpn: string,
  capSecret: []byte,
  sapSecret: []byte,
  exporterSec: []byte,
  resumptionSec: []byte,
  connected: bool,
  extraHelloExts: []Extension,
  serverEEExts: []Extension,
  export hello: []byte,
}

// ---------------------------------------------------------------------------
// Small hash-constructor wrappers (`() => Hash`)
// ---------------------------------------------------------------------------

// The concrete SHA constructors expose as `() => Hash` values — a `newShaN`
// returns its concrete type, which is not itself a `() => Hash`, so the signature
// verifiers that take a hash constructor are handed these wrappers.
function clientSha256(): Hash { return newSha256() }
function clientSha384(): Hash { return newSha384() }
function clientSha512(): Hash { return newSha512() }

// ---------------------------------------------------------------------------
// Start: build the ClientHello
// ---------------------------------------------------------------------------

// The mandatory TLS 1.3 cipher suites, offered when a config names none.
function clientDefaultSuites(): []int {
  return [TLS_AES_256_GCM_SHA384, TLS_CHACHA20_POLY1305_SHA256, TLS_AES_128_GCM_SHA256]
}

// The signature schemes the client advertises it will accept in the server's
// CertificateVerify (RFC 8446 §4.2.3) — the ECDSA, RSA-PSS, and Ed25519 schemes
// this client can verify.
function clientSigAlgs(): []int {
  return [
    sigEcdsaSecp256r1Sha256,
    sigRsaPssRsaeSha256,
    sigEcdsaSecp384r1Sha384,
    sigRsaPssRsaeSha384,
    sigRsaPssRsaeSha512,
    sigEd25519,
  ]
}

// Build the key_share offers for `shareGroups`, using `overrides[i]` as the
// ephemeral keypair when present (parallel index) and generating a fresh one
// otherwise. The private halves are retained in the offers to finish the exchange.
function clientMakeOffers(shareGroups: []TlsGroup, overrides: []GroupKeypair): []clientOffer {
  let out = []clientOffer(0)
  let i = 0
  while (i < len(shareGroups)) {
    let g = shareGroups[i]
    let kp = tlsGroupGenerate(g)
    if (i < len(overrides)) {
      kp = overrides[i]
    }
    out = append(out, clientOffer{ group: g, cp: int(tlsGroupCodepoint(g)), kp: kp })
    i = i + 1
  }
  return out
}

// Encode a ClientHello carrying `offers` as its key_share, this handshake's fixed
// random and legacy session id, the configured supported groups / suites / ALPN /
// SNI, and supported_versions = TLS 1.3.
function (h: TlsClientHandshake) clientBuildHello(offers: []clientOffer): []byte {
  let exts = []Extension(0)
  if (len(h.config.serverName) > 0) {
    exts = append(exts, extServerName(h.config.serverName))
  }
  exts = append(exts, extSupportedVersionsClient([versionTls13]))
  let gcps = []int(0)
  for g of h.config.groups {
    gcps = append(gcps, int(tlsGroupCodepoint(g)))
  }
  exts = append(exts, extSupportedGroups(gcps))
  exts = append(exts, extSignatureAlgorithms(clientSigAlgs()))
  let entries = []KeyShareEntry(0)
  for o of offers {
    entries = append(entries, KeyShareEntry{ group: o.cp, keyExchange: o.kp.keyShare })
  }
  exts = append(exts, extKeyShareClient(entries))
  if (len(h.config.alpn) > 0) {
    exts = append(exts, extALPN(h.config.alpn))
  }
  // Extra caller extensions (empty in record mode) — the QUIC record-bypass path
  // uses this to carry the quic_transport_parameters extension (RFC 9001 §8.2).
  for e of h.extraHelloExts {
    exts = append(exts, e)
  }
  let suites = h.config.suites
  if (len(suites) == 0) {
    suites = clientDefaultSuites()
  }
  return encodeClientHello(
    ClientHello{
      legacyVersion: versionTls12,
      random: h.clientRandom,
      sessionId: h.sessionId,
      cipherSuites: suites,
      extensions: exts,
    },
  )
}

// Start a client handshake: build the ClientHello (or adopt
// `config.clientHelloOverride`), seed the transcript with it, and expose it as
// the `hello` record to send. Fails only if the default record context cannot be
// built. The returned handshake is then driven by `processServerFlight`.
export function tlsClientStart(config: TlsClientConfig): TlsClientHandshake! {
  return tlsClientStartExts(config, []Extension(0))?
}

// Start a client handshake exactly like `tlsClientStart`, but add `extraExts` to
// the ClientHello's extension list. The QUIC record-bypass path (RFC 9001) uses
// this to carry the `quic_transport_parameters` extension; with an empty
// `extraExts` it is byte-for-byte `tlsClientStart`. The `clientHelloOverride`
// path ignores `extraExts` — the caller's exact ClientHello is used verbatim.
export function tlsClientStartExts(
  config: TlsClientConfig,
  extraExts: []Extension,
): TlsClientHandshake! {
  let aes128 = tlsSuiteById(TLS_AES_128_GCM_SHA256)?
  let dummy = newRecordKeys(aes128, []byte(32))?
  let h = TlsClientHandshake{
    config: config,
    offers: []clientOffer(0),
    clientRandom: []byte(0),
    sessionId: []byte(0),
    ch1: []byte(0),
    transcript: []byte(0),
    suite: aes128,
    shared: []byte(0),
    hsSec: []byte(0),
    chs: []byte(0),
    shs: []byte(0),
    serverHsKeys: dummy,
    clientHsKeys: dummy,
    usedHrr: false,
    peerCerts: [][]byte(0),
    alpn: "",
    capSecret: []byte(0),
    sapSecret: []byte(0),
    exporterSec: []byte(0),
    resumptionSec: []byte(0),
    connected: false,
    extraHelloExts: extraExts,
    serverEEExts: []Extension(0),
    hello: []byte(0),
  }

  let shareGroups = config.keyShareGroups
  if (len(shareGroups) == 0) {
    shareGroups = config.groups
  }

  if (len(config.clientHelloOverride) > 0) {
    // Adopt the caller's ClientHello verbatim; the ephemeral offers must be
    // supplied so the shared secret can be finished when the server replies.
    h.offers = clientMakeOffersForGroups(config.groups, config.ephemeralOverride)
    h.ch1 = config.clientHelloOverride
  } else {
    h.clientRandom = randomBytes(32)
    h.sessionId = randomBytes(32)
    h.offers = clientMakeOffers(shareGroups, config.ephemeralOverride)
    h.ch1 = h.clientBuildHello(h.offers)
  }
  h.transcript = h.ch1
  h.hello = tlsWirePlaintextRecord(recordHandshake, h.ch1)
  return h
}

// The override path's offers: each configured group paired with the parallel
// pinned ephemeral keypair (`overrides[i]`). A group with no pinned keypair is
// still generated so the offers stay total.
function clientMakeOffersForGroups(groups: []TlsGroup, overrides: []GroupKeypair): []clientOffer {
  return clientMakeOffers(groups, overrides)
}
