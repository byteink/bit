// Bit standard library — std/tls, the public TLS 1.3 API (#1208).
//
// This file ties the sans-I/O handshake state machines in `client.bit` and
// `server.bit` to real sockets from `std/net`, so a caller gets a blocking,
// stream-like `TlsConn` instead of shuttling raw record bytes by hand:
//
//   let cfg  = newTlsConfig(newTrustStore(roots)?)   // secure by default
//   let conn = dial("example.org", 443, cfg)?        // TCP + handshake
//   conn.write([]byte("GET / HTTP/1.1\r\n\r\n"))?
//   let reply = conn.read(4096)?                      // up to 4096 plaintext bytes
//   conn.close()
//
// and, for a server,
//
//   let l = listen("127.0.0.1", port, serverCfg)?
//   let conn = l.accept()?                            // TCP accept + handshake
//
// std/tls is one flat module, so this file calls the handshake drivers
// (`tlsClientStart`/`processServerFlight`, `tlsServerStart`/`processClientHello`/
// `processClientFinished`), the record-framing constants (`recordHandshake`,
// `recordApplicationData`, `recordAlert`, `recordMaxPlaintext`,
// `recordMaxCiphertext`, `tlsCcsType`), and the `tlsWire*`/`tlsHsPutBytes`
// helpers directly. The only new imports are `std/net` (the transport, aliased so
// its `dial`/`listen`/`Conn`/`Listener` do not shadow this module's public
// `dial`/`listen`/`TlsConn`/`TlsListener`) and `std/time` (a clock default for
// certificate validity). Every private free function is prefixed `tlsapi`.
//
// Driving the batched handshake over a byte stream. A `processServerFlight` /
// `processClientFinished` call consumes a whole flight and mutates the handshake
// on partial input, so the driver must hand it exactly one complete flight. TLS
// 1.3 record framing (a five-byte header whose last two bytes are the fragment
// length) lets `tlsapiFramer` cut whole records off the stream, buffering any
// partial or surplus bytes. A flight boundary is then read structurally: the
// server's post-ServerHello flight is the ServerHello record plus the encrypted
// records already arrived (the peer sends its whole flight, then waits for us, so
// reading one record past the flight would deadlock) — which is exact for a
// single-record auth flight (the common case, and always what this module's own
// server emits). A HelloRetryRequest is detected by parsing the ServerHello so
// its lone-record flight is not mistaken for an incomplete one.

import {
  dial as tlsapiTcpDial, dialDeadline as tlsapiTcpDialDeadline,
  listen as tlsapiTcpListen, resolve as tlsapiResolve,
} from "std/net"
import { Conn as NetConn, Listener as NetListener } from "std/net"
import { now as tlsapiNowNs } from "std/time"

// ---------------------------------------------------------------------------
// Configuration
// ---------------------------------------------------------------------------

// The TLS protocol version this module speaks, as its wire codepoint (RFC 8446).
// TLS 1.3 is the only version implemented; `TlsConfig.minVersion` is a floor and
// may not exceed it.
export const tlsVersion13: int = 0x0304

// A TLS configuration shared by `dial` and `listen`.
//
//   roots       trust anchors the client verifies the server chain against
//   insecureSkipVerify
//               client: skip server certificate chain AND hostname
//               verification. FALSE is the secure default — it is the zero
//               value, so an omitted field or a hand-built literal still
//               verifies. Setting it true DISABLES server authentication: the
//               connection then proves only that the peer holds the
//               CertificateVerify key and completes the Finished MAC, NOT that
//               it is who it claims to be. Never ship a client with
//               `insecureSkipVerify: true`; it exists for tests and pinned
//               replay only, and maps straight to the handshake's
//               `insecureSkipVerify`.
//   alpn        ALPN protocols, most-preferred first (client offers, server picks)
//   serverName  SNI host and the name the certificate must match; `dial` defaults
//               it to its `host` argument when empty
//   minVersion  minimum TLS version as a wire codepoint (default/floor 1.3); a
//               value above `tlsVersion13` is rejected. An omitted (0) floor is
//               clamped to `tlsVersion13` by `dial`/`listen`.
//   nowUnix     Unix seconds for certificate-validity checks; `dial` fills the
//               current time when this is 0
//   certPem     server certificate chain PEM (end-entity first) — required by
//               `listen`, ignored by `dial`
//   keyPem      server private-key PEM matching `certPem` — required by `listen`
export struct TlsConfig {
  export roots: TrustStore,
  export insecureSkipVerify: bool,
  export alpn: []string,
  export serverName: string,
  export minVersion: int,
  export nowUnix: int,
  export certPem: string,
  export keyPem: string,
}

// A `TlsConfig` for verifying servers against `roots`, secure by default:
// `insecureSkipVerify` is false, `minVersion` is TLS 1.3, and everything else is
// empty. A struct literal is just as safe now — every omitted field defaults to
// its zero value and the zero value of `insecureSkipVerify` is "verify" — but
// this remains the recommended constructor. Set `serverName`/`alpn` afterward as
// needed; set `certPem`/`keyPem` to reuse it for a `listen` server.
export fn newTlsConfig(roots: TrustStore): TlsConfig {
  return TlsConfig{
    roots: roots,
    insecureSkipVerify: false,
    alpn: []string(0),
    serverName: "",
    minVersion: tlsVersion13,
    nowUnix: 0,
    certPem: "",
    keyPem: "",
  }
}

// An empty `TrustStore` — no roots. For a server `TlsConfig` (which never
// verifies a peer) or a deliberately insecure client
// (`insecureSkipVerify: true`), where `newTrustStore` cannot help because it
// rejects an empty root set.
export fn emptyTrustStore(): TrustStore {
  return TrustStore{ roots: []X509Certificate(0) }
}

// Reject a configured minimum version above what this module implements. A 0
// (unset) floor means "TLS 1.3", the only version offered.
fn tlsapiCheckVersion(minVersion: int): ()! {
  if (minVersion != 0 && minVersion > tlsVersion13) {
    fail newError("tls: only TLS 1.3 is supported; minVersion ${minVersion} is too high")
  }
}

// ---------------------------------------------------------------------------
// Record framing over a byte stream
// ---------------------------------------------------------------------------

// A TLS record reader over one socket: `conn` is the transport and `buf` holds
// bytes read from it but not yet returned as a record. A reference type, so the
// buffer it carries survives being handed from the handshake driver to the
// `TlsConn` that reuses it for application records.
struct tlsapiFramer { conn: NetConn, buf: []byte }

// Read from the socket until `buf` holds at least `min` bytes. Fails if the peer
// closes first — a record was promised by its length prefix but never arrived.
// Bounded: each read yields at least one byte, so at most `min` iterations.
fn (f: tlsapiFramer) fillTo(min: int): ()! {
  let guard = 0
  while (len(f.buf) < min && guard <= min) {
    guard = guard + 1
    let chunk = f.connRead(recordMaxCiphertext)?
    if (len(chunk) == 0) {
      fail newError("tls: connection closed in the middle of a record")
    }
    f.buf = tlsHsPutBytes(f.buf, []byte(chunk))
  }
}

// Read up to `max` bytes off the underlying connection, bounded by its
// deadline when one is set (`conn.deadlineNs != 0`, from `dialDeadline`
// (#2995) — 0 is the "no deadline" sentinel every plain `dial`-made `Conn`
// gets) — the exact `s.conn.deadlineNs != 0` routing `netStream.readUp`
// (http.bit) already uses for cleartext, so an undeadlined connection takes
// the identical call it always took and only a deadlined one bounds.
fn (f: tlsapiFramer) connRead(max: int): string! {
  if (f.conn.deadlineNs != 0) {
    return f.conn.readDeadline(max)?
  }
  return f.conn.read(max)
}

// Write `data` to the underlying connection, bounded by its deadline when one
// is set. Same routing as `connRead`.
fn (f: tlsapiFramer) connWrite(data: string): ()! {
  if (f.conn.deadlineNs != 0) {
    f.conn.writeDeadline(data)?
    return
  }
  f.conn.write(data)?
}

// The next whole TLS record — its five-byte header and full fragment — consuming
// it from `buf` and leaving any surplus buffered. Fails on an illegal content
// type or a length that exceeds the RFC 8446 §5.2 ciphertext cap (a hostile
// prefix must not drive an unbounded read), or a peer that closes mid-record.
//
// The content type is checked the instant the five-byte header is in hand,
// BEFORE the declared-length fragment is read: type is byte 0, so a peer that
// sends an illegal type controls how long we would otherwise block waiting for
// a body that may never arrive (a plain-HTTP request against a TLS port is
// content type 0x47 'G' declaring a length that looks legal but is bytes of an
// HTTP request line — the fragment-size ceiling below never fires because the
// length itself is unremarkable). Ordering this check first, shared by both the
// client (`dial`) and server (`accept`) paths through this one framer, refuses
// such a peer in milliseconds instead of blocking until it closes.
fn (f: tlsapiFramer) nextRecord(): []byte! {
  f.fillTo(5)?
  let ct = int(f.buf[0])
  if (ct != tlsCcsType &&
    ct != recordAlert &&
    ct != recordHandshake &&
    ct != recordApplicationData) {
    fail newError("tls: illegal record content type ${ct}")
  }
  let n = (int(f.buf[3]) << 8) | int(f.buf[4])
  let total = 5 + n
  if (total > 5 + recordMaxCiphertext) {
    fail newError("tls: record fragment of ${n} bytes exceeds the maximum")
  }
  f.fillTo(total)?
  let rec = f.buf[0:total]
  f.buf = f.buf[total:len(f.buf)]
  return rec
}

// Whether any bytes are already buffered — the driver's signal that another
// record is (at least partly) in hand, so reading it on will not block.
fn (f: tlsapiFramer) hasBuffered(): bool {
  return len(f.buf) > 0
}

// ---------------------------------------------------------------------------
// TlsConn: the application-data connection
// ---------------------------------------------------------------------------

// The application-data surface shared by a completed client or server handshake:
// `TlsClientConn` and `TlsServerConn` both satisfy it structurally, letting one
// `TlsConn` wrap either endpoint.
interface tlsapiSealer {
  sealApp(plaintext: []byte): []byte!,
  openApp(record: []byte): RecordPlaintext!,
  alpnProtocol(): string,
  cipherSuiteId(): int,
}

// An established TLS connection: application `read`/`write` over the record layer
// of the underlying socket. `framer` frames inbound records (and carries any
// bytes buffered during the handshake); `sealer` is the completed client or
// server connection; `plain` buffers decrypted application bytes a `read` has
// not yet returned. Obtain one from `dial` or `TlsListener.accept`.
export struct TlsConn {
  framer: tlsapiFramer,
  sealer: tlsapiSealer,
  alpn: string,
  peerCerts: [][]byte,
  plain: []byte,
  closed: bool,
  timedOut: bool,
}

// The ALPN protocol negotiated during the handshake, or "" if none.
export fn (c: TlsConn) alpnProtocol(): string { return c.alpn }

// The negotiated cipher suite's IANA code point.
export fn (c: TlsConn) cipherSuiteId(): int { return c.sealer.cipherSuiteId() }

// The peer's certificate chain as raw DER, end-entity certificate first. A
// client sees the server's chain; a server sees an empty list (this module does
// not request client certificates).
export fn (c: TlsConn) peerCertificates(): [][]byte { return c.peerCerts }

// Write all of `b` as one or more application_data records, splitting at the
// RFC 8446 §5.2 plaintext limit so an arbitrarily large buffer is legal. Fails on
// a socket write error. Bounded: each record advances `pos` by up to the cap.
export fn (c: TlsConn) write(b: []byte): ()! {
  let pos = 0
  let guard = 0
  while (pos < len(b) && guard <= len(b)) {
    guard = guard + 1
    let end = pos + recordMaxPlaintext
    if (end > len(b)) {
      end = len(b)
    }
    let rec = c.sealer.sealApp(b[pos:end])?
    c.framer.connWrite(string(rec))?
    pos = end
  }
}

// Up to `n` decrypted application bytes. Serves buffered plaintext first, else
// reads and decrypts records until application data arrives, skipping
// post-handshake handshake records (e.g. NewSessionTicket). An empty result means
// end of stream — a clean socket close or a TLS alert (`close_notify`). Fails on
// a record that fails authentication (`bad_record_mac`).
export fn (c: TlsConn) read(n: int): []byte! {
  if (n <= 0) {
    return []byte(0)
  }
  if (len(c.plain) == 0) {
    c.fill()?
  }
  if (len(c.plain) == 0) {
    return []byte(0)
  }
  let take = n
  if (take > len(c.plain)) {
    take = len(c.plain)
  }
  let out = c.plain[0:take]
  c.plain = c.plain[take:len(c.plain)]
  return out
}

// Whether `e` is exactly the deadline-exceeded error `std/net`'s
// `readDeadline` raises on its `-2` timeout sentinel (`fail
// newError("read timed out")`, stdlib/net/net.bit:285) — the one read
// failure `fill()` (below) must not fold into its ordinary "any error is a
// clean close" handling without a trace (#3031). `net.bit` is this
// connection's only source of that exact wording, so an exact match is
// unambiguous.
fn tlsIsReadTimeout(e: error): bool {
  return e.message() == "read timed out"
}

// Read and decrypt records until `plain` gains application data or the stream
// ends. A `recordHandshake` inner type is a post-handshake message and is
// skipped; a `recordAlert` of close_notify ends the stream gracefully — any
// other alert, at either level, fails with its own error naming the
// description rather than being reported as a silent end of stream (#2319).
// KeyUpdate re-keying is not handled — a peer that issues one is not
// interoperable here. Bounded by a record budget so a peer that only ever
// sends non-application records cannot spin forever.
fn (c: TlsConn) fill(): ()! {
  let guard = 0
  while (guard < 4096) {
    guard = guard + 1
    if (c.closed) {
      return
    }
    let rec = c.framer.nextRecord() catch e {
      // Every read failure below this point (the peer closing cleanly,
      // closing mid-record, a hard socket error) stays a silent end of
      // stream — the many callers relying on "any read error is a graceful
      // EOF" keep exactly today's behavior. Only the exact deadline
      // sentinel is recorded, not swallowed outright, so a caller built on
      // top of this connection can tell the two apart afterward via
      // `readTimedOut()` (#3031) — the read result itself stays identical
      // (empty) either way.
      c.timedOut = tlsIsReadTimeout(e)
      return
    }
    let pt = c.sealer.openApp(rec)?
    if (pt.contentType == recordApplicationData) {
      c.plain = tlsHsPutBytes(c.plain, pt.content)
      return
    }
    if (pt.contentType == recordAlert) {
      if (tlsAlertIsCloseNotify(pt.content)) {
        return
      }
      tlsAlertError(pt.content)?
    }
    if (pt.contentType != recordHandshake) {
      fail newError("tls: unexpected inner content type ${pt.contentType}")
    }
  }
  fail newError("tls: too many non-application records before data")
}

// Close the underlying socket. Idempotent. No `close_notify` alert is sent, so
// the peer sees a transport close rather than a graceful TLS shutdown.
export fn (c: TlsConn) close() {
  if (!c.closed) {
    c.closed = true
    c.framer.conn.close()
  }
}

// Shut the underlying socket down WITHOUT releasing it (#3016) — see
// `std/net`'s `Conn.shutdown` for the full contract this forwards to and why
// it exists separately from `close`. Unlike `close`, this does not set
// `c.closed` or stop this `TlsConn` from being read/written/closed
// afterward — it exists purely to unblock a green thread another thread of
// this same process spawned to read this `TlsConn`, before that closing
// thread calls `close` for real. `std/http`'s `h2clientExchange`
// (stdlib/http/h2.bit) is the caller this exists for.
export fn (c: TlsConn) shutdown() {
  c.framer.conn.shutdown()
}

// The absolute monotonic nanosecond deadline (`std/time`'s `monotonic()`
// clock) this connection's reads and writes are bounded by, or 0 if none —
// see `dialDeadline`. Exposed so a caller building a higher-level connection
// on top of a `TlsConn` (`std/http2`'s `connect`/`accept`, #3019) can thread
// the SAME deadline through a wait that sits below any one socket read,
// instead of inventing a second one.
export fn (c: TlsConn) deadlineNs(): int {
  return c.framer.conn.deadlineNs
}

// Whether the most recent `read()` that returned no bytes (`read`'s "end of
// stream" result, above) ended because THIS side's own read deadline
// (`dialDeadline`/`setDeadline`) elapsed while waiting for a record, rather
// than the peer closing cleanly or a framing/protocol failure — `fill()`
// records this instead of discarding it along with every other read outcome
// it treats as an ordinary close. The empty `read()` result itself is
// unchanged either way; this is the side channel a caller layered on top of
// this connection uses to tell a self-inflicted timeout from a genuine peer
// close (`std/http`'s HTTP/2 glue, stdlib/http/h2.bit, #3031). Meaningless
// before any read; every subsequent read outcome overwrites it.
export fn (c: TlsConn) readTimedOut(): bool {
  return c.timedOut
}

// ---------------------------------------------------------------------------
// dial: connect + client handshake
// ---------------------------------------------------------------------------

// The client offer set: the post-quantum hybrid first, then the classical curves,
// matching what current browsers and curl advertise. A server preferring a group
// we did not send a key_share for asks for it via a HelloRetryRequest, which the
// driver completes.
fn tlsapiClientGroups(): []TlsGroup {
  return [TlsGroup.X25519MLKEM768, TlsGroup.X25519, TlsGroup.Secp256r1, TlsGroup.Secp384r1]
}

// Translate the public `TlsConfig` into the internal `TlsClientConfig`: SNI
// defaults to `host`, the clock defaults to now, and `insecureSkipVerify`
// passes straight through.
fn tlsapiClientConfig(host: string, config: TlsConfig): TlsClientConfig! {
  tlsapiCheckVersion(config.minVersion)?
  let sni = config.serverName
  if (len(sni) == 0) {
    sni = host
  }
  let ts = config.nowUnix
  if (ts == 0) {
    ts = tlsapiNowNs() / 1000000000
  }
  return TlsClientConfig{
    serverName: sni,
    alpn: config.alpn,
    trust: config.roots,
    insecureSkipVerify: config.insecureSkipVerify,
    nowUnix: ts,
    groups: tlsapiClientGroups(),
    keyShareGroups: [TlsGroup.X25519MLKEM768, TlsGroup.X25519],
    suites: []int(0),
    clientHelloOverride: []byte(0),
    ephemeralOverride: []GroupKeypair(0),
  }
}

// Run the TLS 1.3 client handshake to completion over an already-connected
// `conn`, returning the application connection. Shared by `dial` and
// `dialDeadline` (#2995) — they differ only in how `conn` was obtained (a
// plain `std/net.dial` vs `dialDeadline`); everything after that is
// identical, because `conn.deadlineNs` (#2291) — `0` from `dial`, an absolute
// monotonic nanosecond deadline from `dialDeadline` — is what `tlsapiFramer`'s
// `connRead`/`connWrite` and (through them) `TlsConn.read`/`write` consult to
// decide whether to bound. No separate deadline threading is needed here.
fn tlsapiHandshakeClient(conn: NetConn, clientCfg: TlsClientConfig): TlsConn! {
  let f = tlsapiFramer{ conn: conn, buf: []byte(0) }
  let cc = tlsapiDriveClient(f, clientCfg) catch e {
    conn.close()
    fail e
  }
  return TlsConn{
    framer: f,
    sealer: cc,
    alpn: cc.alpnProtocol(),
    peerCerts: cc.peerCertificates(),
    plain: []byte(0),
    closed: false,
  }
}

// Connect to `host:port` over TCP and run the TLS 1.3 client handshake to
// completion, returning an application connection. `host` is resolved via the
// system resolver (a dotted quad passes straight through) and is the default SNI.
// The handshake verifies the server's certificate chain and hostname against
// `config.roots` unless `config.insecureSkipVerify` is true. Fails on a
// connection, resolve, or handshake/verification error; the socket is closed on
// a handshake failure.
export fn dial(host: string, port: int, config: TlsConfig): TlsConn! {
  if (config.minVersion == 0) {
    config.minVersion = tlsVersion13
  }
  let clientCfg = tlsapiClientConfig(host, config)?
  let ip = tlsapiResolve(host)?
  let conn = tlsapiTcpDial(ip, port)?
  return tlsapiHandshakeClient(conn, clientCfg)?
}

// As `dial`, but the TCP connect AND the whole handshake AND every later
// application `read`/`write` on the returned `TlsConn` are bounded by ONE
// absolute monotonic `deadlineNs` (`std/time`'s `monotonic() + budget`, not a
// duration) — the same three places (connect, handshake round trips,
// record-layer read/write) #2291's `std/net` deadline already covers for
// cleartext (#2995). `std/net.dialDeadline` sets `deadlineNs` on the `Conn` it
// returns; `tlsapiHandshakeClient` and everything downstream reuse that SAME
// value automatically, so nothing else threads it through by hand. Fails on a
// connection, resolve, handshake/verification, or timeout error; the socket
// is closed on a handshake failure. A timeout while connecting fails with the
// same "dial ... timed out" `std/net` already uses; a timeout mid-handshake
// or mid-record fails with "read timed out"/"write timed out", the exact
// wording `readDeadline`/`writeDeadline` use, so a caller distinguishes a
// timeout from every other failure the same way it already does for
// cleartext.
export fn dialDeadline(host: string, port: int, config: TlsConfig, deadlineNs: int): TlsConn! {
  if (config.minVersion == 0) {
    config.minVersion = tlsVersion13
  }
  let clientCfg = tlsapiClientConfig(host, config)?
  let ip = tlsapiResolve(host)?
  let conn = tlsapiTcpDialDeadline(ip, port, deadlineNs)?
  return tlsapiHandshakeClient(conn, clientCfg)?
}

// Send the ClientHello, then drive the flight exchange to completion: read a
// server flight, process it, send the produced record(s) (a resent ClientHello
// on HelloRetryRequest, or the client Finished when done), and stop once done.
// Bounded to the ClientHello, one retry, and the final flight.
//
// A certificate-rejection failure inside `processServerFlight` (bad chain,
// hostname mismatch, bad CertificateVerify signature — #2320) is tagged
// `tlsAlertFail` by `clientflight.bit`; every one of those sites runs only after
// `clientProcessServerHello` has already derived `h.clientHsKeys` — Certificate,
// CertificateVerify and Finished are always the server's second, AEAD-sealed
// flight, never plaintext — so the alert this sends is always sealed under that
// same key, continuing its sequence rather than restarting one at an
// already-spent nonce. An untagged failure (a framing/negotiation error, which
// can happen before any handshake key exists) sends no alert, unchanged from
// before this fix: this ticket's scope is the certificate-rejection paths, not
// every conceivable client-detected error.
fn tlsapiDriveClient(f: tlsapiFramer, config: TlsClientConfig): TlsClientConn! {
  let h = tlsClientStart(config)?
  f.connWrite(string(h.hello))?
  let guard = 0
  while (guard < 4) {
    guard = guard + 1
    let flight = tlsapiReadServerFlight(f)?
    let step = h.processServerFlight(flight) catch e {
      tlsapiSendClientAlert(f, h, e)
      fail e
    }
    f.connWrite(string(step.outbound))?
    if (step.done) {
      return h.connection()?
    }
  }
  fail newError("tls: client handshake did not complete within the flight bound")
}

// Best-effort: if `e` is a `tlsAlertFail` (a certificate-rejection site in
// `clientflight.bit` tagged it), send the peer the fatal alert it names before
// the caller closes the socket (RFC 8446 §6.2: "both parties MUST immediately
// close the connection" after transmitting or receiving one). An untagged `e`
// sends nothing — see `tlsapiDriveClient`'s doc comment for why that is
// deliberate, not a gap. Sealing can itself fail only if `h.clientHsKeys` rejects
// the 2-byte alert body, which RFC 8446 §5.2's 2^14-byte cap never does; that
// case, like a failed write, is swallowed rather than surfacing, for the same
// reason `tlsapiSendAlert` swallows a write failure: this is a secondary,
// best-effort send and must never replace or block the caller's own handshake
// error.
fn tlsapiSendClientAlert(f: tlsapiFramer, h: TlsClientHandshake, e: error) {
  let (tagged, ok) = e.(tlsAlertFail)
  if (!ok) {
    return
  }
  let alert = tlsAlertSealedRecord(h.clientHsKeys, tagged.desc) catch e2 {
    return
  }
  tlsapiSendAlert(f.conn, alert)
}

// Gather one complete server flight off the stream. The ServerHello is the first
// non-CCS record; a HelloRetryRequest ends the flight there, and so does a
// plaintext alert in that same slot (#2319) — a server that rejects the
// ClientHello before any handshake key exists (no ALPN protocol in common, an
// unsupported version, ...) sends its alert instead of a ServerHello and then
// closes, so waiting for more bytes there would misreport the alert as a
// mid-record truncation instead of ever handing it to the caller to decode.
// Otherwise the encrypted authentication flight follows, and the flight is
// complete once at least one encrypted record has been read and nothing more is
// buffered — the server has sent its whole flight and is now waiting for the
// client, so reading on would block. Bounded by a record budget.
fn tlsapiReadServerFlight(f: tlsapiFramer): []byte! {
  let flight = []byte(0)
  let sawHello = false
  let encCount = 0
  let guard = 0
  while (guard < 64) {
    guard = guard + 1
    let rec = f.nextRecord()?
    flight = tlsHsPutBytes(flight, rec)
    let t = tlsWireRecordType(rec)
    if (t == tlsCcsType) {
      continue
    }
    if (!sawHello) {
      sawHello = true
      if (t == recordAlert) {
        return flight
      }
      if (tlsapiIsHelloRetry(rec)) {
        return flight
      }
      continue
    }
    if (t == recordApplicationData) {
      encCount = encCount + 1
    }
    if (encCount >= 1 && !f.hasBuffered()) {
      return flight
    }
  }
  fail newError("tls: server flight exceeded the record bound")
}

// Whether a plaintext handshake record carries a HelloRetryRequest. A record
// that does not parse as a ServerHello is treated as "not a retry" so the state
// machine, not the framer, produces the precise error.
fn tlsapiIsHelloRetry(rec: []byte): bool {
  let sh = parseServerHello(tlsWireRecordBody(rec)) catch e {
    return false
  }
  return isHelloRetryRequest(sh)
}

// ---------------------------------------------------------------------------
// listen / accept: server handshake
// ---------------------------------------------------------------------------

// A listening TLS socket: the TCP `ln` and the server handshake `config` applied
// to each accepted connection. Build it with `listen`.
export struct TlsListener { ln: NetListener, config: TlsServerConfig }

// Listen for TLS connections on `host:port`. `config.certPem` and `config.keyPem`
// (the server's certificate chain and matching private key, PEM) are required;
// `config.alpn` is the supported protocol list. `port` may be 0 to let the kernel
// choose one — read it back with `port()`. Fails on a bad certificate/key or a
// bind error.
export fn listen(host: string, port: int, config: TlsConfig): TlsListener! {
  if (config.minVersion == 0) {
    config.minVersion = tlsVersion13
  }
  tlsapiCheckVersion(config.minVersion)?
  if (len(config.certPem) == 0 || len(config.keyPem) == 0) {
    fail newError("tls listen: config.certPem and config.keyPem are required for a TLS server")
  }
  let serverCfg = newTlsServerConfig(config.certPem, config.keyPem, config.alpn)?
  let ln = tlsapiTcpListen(host, port)?
  return TlsListener{ ln: ln, config: serverCfg }
}

// The port this listener is bound to — meaningful even when 0 was requested.
export fn (l: TlsListener) port(): int! {
  return l.ln.port()?
}

// Accept the next connection and run the TLS 1.3 server handshake to completion,
// returning its application connection. Fails on an accept or handshake error;
// the socket is closed on a handshake failure.
export fn (l: TlsListener) accept(): TlsConn! {
  let conn = l.ln.accept()?
  let f = tlsapiFramer{ conn: conn, buf: []byte(0) }
  let sc = tlsapiDriveServer(f, l.config) catch e {
    conn.close()
    fail e
  }
  return TlsConn{
    framer: f,
    sealer: sc,
    alpn: sc.alpnProtocol(),
    peerCerts: [][]byte(0),
    plain: []byte(0),
    closed: false,
  }
}

export fn (l: TlsListener) close() {
  l.ln.close()
}

// The AlertDescription (RFC 8446 §6.2) a caught handshake error carries, if
// one of `server.bit`'s own fail-and-close sites tagged it (`tlsAlertFail`,
// `alert.bit`); otherwise `handshake_failure` — the generic "could not
// negotiate an acceptable set of parameters" alert (RFC 8446 §4.1.1), the
// safe default for a failure this driver did not itself originate (e.g. a
// parse or crypto error surfacing from a shared helper) and so has no
// business naming more precisely.
fn tlsapiAlertDescOf(e: error): int {
  let (tagged, ok) = e.(tlsAlertFail)
  if (ok) {
    return tagged.desc
  }
  return alertHandshakeFailure
}

// Best-effort: write one already-framed Alert record to `conn` and return,
// never failing the caller. One write, no retry, no loop — the same bound
// every other record this module writes to the same peer already has
// (`std/net` has no write deadline; a peer that could wedge this write could
// already wedge the ServerHello write on the handshake's success path). A
// failed write is swallowed here, not surfaced: the caller's own handshake
// error is what must reach `accept()`'s caller, and a secondary transport
// error from this best-effort send must never replace or block it.
fn tlsapiSendAlert(conn: NetConn, rec: []byte) {
  conn.write(string(rec)) catch e {
    return
  }
}

// Drive the server handshake: read the ClientHello flight, answer it (a
// HelloRetryRequest loops back for the next ClientHello), then read and verify
// the client Finished flight. Bounded to the ClientHello, one retry, and the
// Finished.
//
// A failure while processing the ClientHello (negotiation, ALPN, signing —
// #2955) happens before this endpoint's own flight has reached the wire, so
// the peer holds no handshake traffic key yet: the alert is sent plaintext.
// A failure while processing the client Finished happens after the sealed
// auth flight was already written below, so the peer already derived the
// handshake-traffic keys from it: the alert is sealed under the very same
// `RecordKeys` (`s.hsWriteKeys`) that sealed that flight, continuing its
// sequence rather than restarting one at an already-spent nonce.
fn tlsapiDriveServer(f: tlsapiFramer, config: TlsServerConfig): TlsServerConn! {
  let s = tlsServerStart(config)?
  let guard = 0
  while (guard < 4) {
    guard = guard + 1
    let chFlight = tlsapiReadMessageFlight(f)?
    let step = s.processClientHello(chFlight) catch e {
      tlsapiSendAlert(f.conn, tlsAlertPlaintextRecord(tlsapiAlertDescOf(e)))
      fail e
    }
    f.conn.write(string(step.outbound))?
    if (!step.retry) {
      let finFlight = tlsapiReadMessageFlight(f)?
      return s.processClientFinished(finFlight) catch e {
        let alert = tlsAlertSealedRecord(s.hsWriteKeys, tlsapiAlertDescOf(e)) catch e2 {
          fail e
        }
        tlsapiSendAlert(f.conn, alert)
        fail e
      }
    }
  }
  fail newError("tls: server handshake did not complete within the flight bound")
}

// Read a single-message flight: any change_cipher_spec records, then exactly one
// content record. Both flights the server reads — the ClientHello and the client
// Finished — are one record, so one non-CCS record completes the flight. Bounded
// by a small CCS budget.
fn tlsapiReadMessageFlight(f: tlsapiFramer): []byte! {
  let flight = []byte(0)
  let guard = 0
  while (guard < 8) {
    guard = guard + 1
    let rec = f.nextRecord()?
    flight = tlsHsPutBytes(flight, rec)
    if (tlsWireRecordType(rec) != tlsCcsType) {
      return flight
    }
  }
  fail newError("tls: too many change_cipher_spec records before the message")
}
