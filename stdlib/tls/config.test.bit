// stdlib/tls/config.test.bit — the two config types are each complete in one
// expression (#6534): `TlsConfig(roots, ...)` for a client and
// `TlsServerConfig(certPem, keyPem, alpn)` for a server, with no field set
// afterwards. A server config fails when it is built, not on the first
// connection, so an absent key or chain is an error here rather than a listener
// that cannot handshake.
//
// `creqPem`, `creqLeafHex` and `creqKeyHex` are siblings from
// certrequest.test.bit (std/tls is one flat module).

test "TlsConfig is complete from one constructor call" {
  let cfg = TlsConfig(emptyTrustStore(), serverName = "example.org", alpn = ["h2", "http/1.1"])
  assert(cfg.serverName == "example.org", "serverName")
  assert(len(cfg.alpn) == 2, "alpn")
  assert(!cfg.insecureSkipVerify, "verification stays on unless asked off")
  assert(cfg.nowUnix == 0, "nowUnix defaults to the clock")
}

test "TlsServerConfig is complete from one constructor call" {
  let cfg = TlsServerConfig(
    creqPem("CERTIFICATE", creqLeafHex), creqPem("PRIVATE KEY", creqKeyHex), ["h2"],
  ) catch e {
    assert(false, "valid PEM: ${e.message()}")
    return
  }
  assert(len(cfg.chain) == 1, "chain")
  assert(cfg.alpn[0] == "h2", "alpn")
}

test "TlsServerConfig rejects an empty private key" {
  let cfg = TlsServerConfig(creqPem("CERTIFICATE", creqLeafHex), "", []string(0)) catch _ {
    return
  }
  assert(false, "an empty key must not build a server config ${len(cfg.chain)}")
}

test "TlsServerConfig rejects a chain with no certificate in it" {
  let key = creqPem("PRIVATE KEY", creqKeyHex)
  let cfg = TlsServerConfig(key, key, []string(0)) catch e {
    assert(contains(e.message(), "no CERTIFICATE blocks"), "message: ${e.message()}")
    return
  }
  assert(false, "a key where the chain belongs must not build a server config ${len(cfg.chain)}")
}
