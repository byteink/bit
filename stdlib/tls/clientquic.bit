// Bit standard library — std/tls, the QUIC record-bypass handshake mode
// (RFC 9001 §4) of the client state machine (split out of `client.bit`, #1503).

// ---------------------------------------------------------------------------
// QUIC record-bypass handshake mode (RFC 9001 §4)
// ---------------------------------------------------------------------------
//
// QUIC does not run TLS over the TLS record layer: it carries the plaintext
// handshake *messages* inside CRYPTO frames and protects them with QUIC packet
// protection instead. These methods drive the very same client state machine at
// the handshake-message level — no `RecordKeys.seal`/`open`, no five-byte record
// framing — and expose the traffic secrets std/quic keys each encryption level
// from. Certificate-chain, CertificateVerify, and Finished verification are the
// identical, non-skippable checks of `clientConsumeAuthFlight`; there is no mode
// that drops them. Start with `tlsClientStartExts` to add the
// quic_transport_parameters extension, then:
//
//   let h = tlsClientStartExts(cfg, [tpExt])?
//   send Initial CRYPTO(h.clientHelloMessage())
//   let resent = h.processServerHelloMessage(serverHelloMsg)?   // Initial-level
//   // (resent non-empty => HelloRetryRequest: send it and read the next SH)
//   let finished = h.clientReadHandshake(handshakeFlightMsgs)?  // Handshake-level
//   send Handshake CRYPTO(finished)
//   // now h.clientApplicationSecret()/serverApplicationSecret() key 1-RTT

