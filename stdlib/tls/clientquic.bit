// Bit standard library — std/tls, the QUIC record-bypass handshake mode
// (RFC 9001 §4) of the client state machine (split out of `client.bit`, #1503).

// ---------------------------------------------------------------------------
// QUIC record-bypass handshake mode (RFC 9001 §4)
// ---------------------------------------------------------------------------
//
// QUIC does not run TLS over the TLS record layer: it carries the plaintext
// handshake *messages* inside CRYPTO frames and protects them with QUIC packet
// protection instead. These methods drive the very same client state machine at
// the handshake-message level — no `RecordKeys.seal`/`open`, no five-byte record
// framing — and expose the traffic secrets std/quic keys each encryption level
// from. Certificate-chain, CertificateVerify, and Finished verification are the
// identical, non-skippable checks of `clientConsumeAuthFlight`; there is no mode
// that drops them. Start with `tlsClientStartExts` to add the
// quic_transport_parameters extension, then:
//
//   let h = tlsClientStartExts(cfg, [tpExt])?
//   send Initial CRYPTO(h.clientHelloMessage())
//   let resent = h.processServerHelloMessage(serverHelloMsg)?   // Initial-level
//   // (resent non-empty => HelloRetryRequest: send it and read the next SH)
//   let finished = h.clientReadHandshake(handshakeFlightMsgs)?  // Handshake-level
//   send Handshake CRYPTO(finished)
//   // now h.clientApplicationSecret()/serverApplicationSecret() key 1-RTT

// The ClientHello handshake *message* (RFC 8446 §4.1.2) — the plaintext bytes to
// place in Initial-level CRYPTO frames. This is exactly what `hello` wraps in a
// record, without the five-byte record header.
export function (h: TlsClientHandshake) clientHelloMessage(): []byte {
  return h.ch1
}

// Feed the server's ServerHello handshake message (plaintext, recovered from
// Initial-level CRYPTO frames). On a HelloRetryRequest it returns the resent
// ClientHello message to carry in a new Initial flight (the caller then reads the
// next ServerHello and calls this again); otherwise it derives the handshake-
// traffic secrets and returns an empty slice. Fails on a parse error, an
// unoffered suite/group, or a second HelloRetryRequest.
export function (h: TlsClientHandshake) processServerHelloMessage(shMsg: []byte): []byte! {
  let sh = parseServerHello(shMsg)?
  if (isHelloRetryRequest(sh)) {
    return h.clientHandleHrrCore(sh, shMsg)?
  }
  h.clientProcessServerHello(sh, shMsg)?
  return []byte(0)
}

// Consume the server's Handshake-level messages — EncryptedExtensions,
// Certificate, CertificateVerify, Finished — as one plaintext `stream` (the
// concatenated messages std/quic reassembled from Handshake-level CRYPTO frames),
// and return the client Finished *message* to carry in a Handshake-level CRYPTO
// frame. Runs the full security core: it verifies the certificate chain +
// hostname (unless `insecureSkipVerify`), the CertificateVerify signature, and
// the server Finished MAC, then derives the application-traffic secrets. Fails
// fatally on any parse or authentication failure.
export function (h: TlsClientHandshake) clientReadHandshake(stream: []byte): []byte! {
  return h.clientConsumeAuthFlight(stream)?
}

// The server's EncryptedExtensions, as parsed during `clientReadHandshake` — the
// QUIC path reads the peer's quic_transport_parameters (codepoint 0x0039) from
// here. Empty until the auth flight has been consumed.
export function (h: TlsClientHandshake) peerEncryptedExtensions(): []Extension {
  return h.serverEEExts
}

// The negotiated cipher suite's IANA code point, valid once a (non-HRR)
// ServerHello has been processed. std/quic uses it to pick the suite hash and key
// length when deriving each encryption level's QUIC keys.
export function (h: TlsClientHandshake) cipherSuiteId(): int {
  return h.suite.id
}

// The client_handshake_traffic_secret (RFC 8446 §7.1), derived after the
// ServerHello. std/quic keys the client's Handshake-level packets from it.
export function (h: TlsClientHandshake) clientHandshakeSecret(): []byte {
  return h.chs
}

// The server_handshake_traffic_secret (RFC 8446 §7.1), derived after the
// ServerHello. std/quic keys the server's Handshake-level packets from it.
export function (h: TlsClientHandshake) serverHandshakeSecret(): []byte {
  return h.shs
}

// The client_application_traffic_secret_0 (RFC 8446 §7.1), derived after the
// server Finished by `clientReadHandshake`. std/quic keys the client's 1-RTT
// packets from it.
export function (h: TlsClientHandshake) clientApplicationSecret(): []byte {
  return h.capSecret
}

// The server_application_traffic_secret_0 (RFC 8446 §7.1), derived after the
// server Finished by `clientReadHandshake`. std/quic keys the server's 1-RTT
// packets from it.
export function (h: TlsClientHandshake) serverApplicationSecret(): []byte {
  return h.sapSecret
}

// The exporter_master_secret (RFC 8446 §7.5), derived by `clientReadHandshake` —
// the root of exported keying material bound to this handshake.
export function (h: TlsClientHandshake) exporterSecret(): []byte {
  return h.exporterSec
}
