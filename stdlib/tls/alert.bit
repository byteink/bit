// Bit standard library — std/tls, TLS 1.3 alert records (RFC 8446 §6).
//
// The Alert protocol is the peer's only channel for saying *why* it closed a
// connection: a two-byte plaintext body, `AlertLevel` then `AlertDescription`
// (RFC 8446 §6.2, values from the IANA TLS Alert registry, unchanged since TLS
// 1.0). Before this file, every place a `recordAlert`-typed record could
// arrive discarded the body and reported a generic error indistinguishable
// from a transport-level truncation (#2319) — the one piece of information
// the peer actually sent was destroyed.
//
// `tlsAlertError` decodes that body into its own error naming the level and
// the description, so a fatal alert reads as e.g. "tls: peer sent fatal alert
// no_application_protocol (120)" rather than "connection closed in the middle
// of a record". `close_notify` (0) is the one description this stack treats
// as a graceful end of stream rather than an error — but only where that is
// the peer's right to send one (application data, after the handshake has
// completed); `tlsAlertIsCloseNotify` lets a caller special-case it, and a
// caller mid-handshake is free not to, since no alert is a graceful outcome
// before the connection is even established.
//
// #2319 added only the decode direction above. #2955 adds the encode
// direction: `tlsAlertFail` lets a fail-and-close site name the exact
// AlertDescription its failure maps to, `tlsAlertEncode` builds the two-byte
// body, and `tlsAlertPlaintextRecord`/`tlsAlertSealedRecord` frame it for a
// peer that has not, or has already, derived handshake traffic keys — the
// two framings `server.bit`'s driver sends before closing a connection it is
// aborting. #2320 (the client's own send direction, on certificate
// rejection) reuses these same primitives rather than growing a second
// encoder.
//
// std/tls is one flat module; this file's private free functions are
// prefixed `tlsAlert`.

const alertLevelWarning: int = 1
const alertLevelFatal: int = 2

// close_notify (RFC 8446 §6.1): the AlertDescription a caller reading
// post-handshake application data treats as a graceful end of stream instead
// of building an error for it.
const alertCloseNotify: int = 0

// AlertDescriptions (RFC 8446 §6.2) this stack's own fail-and-close paths
// send — named so a failure site states its alert once, at the point that
// knows the reason, rather than a transport-layer catch guessing one from a
// caught error's message. Every one of these is already named by
// `tlsAlertName`'s decode switch below; these are the subset this stack also
// emits itself.
const alertUnexpectedMessage: int = 10
const alertBadRecordMac: int = 20
const alertHandshakeFailure: int = 40
const alertDecryptError: int = 51
const alertProtocolVersion: int = 70
const alertMissingExtension: int = 109
const alertNoApplicationProtocol: int = 120

// Whether a received alert record's plaintext body is close_notify, at any
// level. A body of the wrong length is never close_notify — it is malformed,
// and `tlsAlertError` reports that distinctly.
fn tlsAlertIsCloseNotify(body: []byte): bool {
  return len(body) == 2 && int(body[1]) == alertCloseNotify
}

// The human-readable name of an AlertDescription (RFC 8446 §6.2, the IANA TLS
// Alert registry — stable since TLS 1.0). A code this table does not name
// still reports as "alert(<n>)" rather than being dropped or misreported —
// covering the whole registry, not just the codes this stack currently emits.
fn tlsAlertName(desc: int): string {
  switch (desc) {
    case 0:
      return "close_notify"
    case 10:
      return "unexpected_message"
    case 20:
      return "bad_record_mac"
    case 22:
      return "record_overflow"
    case 40:
      return "handshake_failure"
    case 42:
      return "bad_certificate"
    case 43:
      return "unsupported_certificate"
    case 44:
      return "certificate_revoked"
    case 45:
      return "certificate_expired"
    case 46:
      return "certificate_unknown"
    case 47:
      return "illegal_parameter"
    case 48:
      return "unknown_ca"
    case 49:
      return "access_denied"
    case 50:
      return "decode_error"
    case 51:
      return "decrypt_error"
    case 70:
      return "protocol_version"
    case 71:
      return "insufficient_security"
    case 80:
      return "internal_error"
    case 86:
      return "inappropriate_fallback"
    case 90:
      return "user_canceled"
    case 109:
      return "missing_extension"
    case 110:
      return "unsupported_extension"
    case 112:
      return "unrecognized_name"
    case 113:
      return "bad_certificate_status_response"
    case 115:
      return "unknown_psk_identity"
    case 116:
      return "certificate_required"
    case 120:
      return "no_application_protocol"
    default:
      return "alert(${desc})"
  }
}

// Build and fail with the error for a received Alert record's plaintext body
// (RFC 8446 §6.2: exactly two bytes, level then description). Always fails —
// a caller that wants close_notify treated as a graceful close checks
// `tlsAlertIsCloseNotify` first and never reaches here for it. A body of the
// wrong length is a protocol violation, reported as such rather than
// mis-parsed; a level byte that is neither 1 (warning) nor 2 (fatal) is
// likewise reported rather than guessed at, since RFC 8446 §6.2 defines only
// those two.
fn tlsAlertError(body: []byte): ()! {
  if (len(body) != 2) {
    fail newError("tls: malformed alert record (want 2 bytes, got ${len(body)})")
  }
  let level = int(body[0])
  let desc = int(body[1])
  let name = tlsAlertName(desc)
  if (level == alertLevelFatal) {
    fail newError("tls: peer sent fatal alert ${name} (${desc})")
  }
  if (level == alertLevelWarning) {
    fail newError("tls: peer sent warning alert ${name} (${desc})")
  }
  fail newError("tls: peer sent alert ${name} (${desc}) at unknown level ${level}")
}

// ---------------------------------------------------------------------------
// Encode (#2955): build an outbound Alert record
// ---------------------------------------------------------------------------

// A handshake failure paired with the AlertDescription (RFC 8446 §6.2) its
// own fail-and-close site must send to the peer before the socket closes.
// Satisfies `error` exactly like `newError`'s own errorString — `message()`
// returns the same caller-facing text a plain `newError` would have, and
// nothing about this type changes what a caller who never inspects `desc`
// observes. A transport-level catch recovers `desc` with a type assertion
// (`e.(tlsAlertFail)`, SPEC §14.4) to build the wire alert; `msg` never goes
// on the wire, only `desc` does — a caught error a fail site did NOT tag this
// way carries no `desc` at all, so the transport falls back to a safe
// generic description (`tlsapiAlertDescOf` in `tls.bit`) rather than
// inventing one from the message text. Never exported: only this module's
// own fail-and-close sites construct one.
struct tlsAlertFail { desc: int, msg: string }

fn (e: tlsAlertFail) message(): string { return e.msg }

// The two-byte AlertLevel+AlertDescription body (RFC 8446 §6.2) that
// `tlsAlertError` above decodes. This stack only ever SENDS a fatal alert —
// every send site is a fail-and-close path — so the level is fixed rather
// than threaded through every call site; TLS 1.3 defines no warning-level
// alert this stack has a reason to send on purpose.
fn tlsAlertEncode(desc: int): []byte {
  let body = []byte(2)
  body[0] = byte(alertLevelFatal)
  body[1] = byte(desc)
  return body
}

// A fatal Alert as a plaintext record (RFC 8446 §5.1, §6): the framing for a
// peer that has not derived any handshake traffic key yet — before this
// endpoint's own first encrypted flight has actually reached the wire.
fn tlsAlertPlaintextRecord(desc: int): []byte {
  return tlsWirePlaintextRecord(recordAlert, tlsAlertEncode(desc))
}

// A fatal Alert as an AEAD-sealed record under `keys`, advancing `keys`' own
// sequence number exactly as any other outbound record under the same
// traffic secret would (RFC 8446 §5.3). The caller MUST pass the same
// `RecordKeys` object it has already been sealing this direction's earlier
// records with, never a fresh one re-derived from the same secret — a fresh
// `RecordKeys` restarts its sequence counter at 0 and would reuse a nonce a
// prior record under this secret already spent, an AEAD keystream-reuse
// break. FAILS only if `keys` rejects the 2-byte body, which RFC 8446 §5.2's
// 2^14-byte cap never does.
fn tlsAlertSealedRecord(keys: RecordKeys, desc: int): []byte! {
  return keys.seal(tlsAlertEncode(desc), recordAlert)?
}
