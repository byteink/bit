// stdlib/tls/readinto.test.bit — `RecordKeys.openInPlace` and
// `TlsConn.readInto` (#7395): a record decrypts inside its own bytes, a
// corrupted one is refused with its ciphertext left as it was, and a stream
// served through a small caller buffer arrives whole and in order.
//
// `creqPem`, `creqLeafHex` and `creqKeyHex` are siblings from
// certrequest.test.bit (std/tls is one flat module).

// A `RecordKeys` for suite `id` over a zero secret; two of them pair up.
fn rinKeys(id: int): RecordKeys! {
  let suite = tlsSuiteById(id)?
  return RecordKeys(suite, []byte(suite.hashLen))?
}

// `n` bytes of a repeating 0..250 pattern, so an offset error shows.
fn rinBody(n: int): []byte {
  let b = []byte(n)
  let i = 0
  while (i < n) {
    b[i] = byte(i % 251)
    i = i + 1
  }
  return b
}

fn rinSame(a: []byte, b: []byte): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

fn rinRoundTrip(): ()! {
  let ids = [TLS_AES_128_GCM_SHA256, TLS_AES_256_GCM_SHA384, TLS_CHACHA20_POLY1305_SHA256]
  for id of ids {
    let w = rinKeys(id)?
    let r = rinKeys(id)?
    let body = rinBody(3000)
    let rec = w.seal(body, recordApplicationData)?
    let pt = r.openInPlace(rec)?
    assert(rinSame(pt.content, body), "content is the sealed body")
    assert(rinSame(rec[5:5 + len(body)], body), "decrypted inside the record")
    assert(pt.contentType == recordApplicationData, "inner type")
    assert(r.sequence() == 1, "sequence advanced")
  }
}

// Two full 2^14 records sealed through one reused buffer (#7446, #7560): each
// opens to its own body, so the content reached the record both times, the
// second read from 7 bytes into its source.
fn rinSealReused(): ()! {
  let w = rinKeys(TLS_AES_256_GCM_SHA384)?
  let r = rinKeys(TLS_AES_256_GCM_SHA384)?
  let buf = []byte(5 + recordMaxCiphertext)
  let a = rinBody(recordMaxPlaintext)
  let b = rinBody(recordMaxPlaintext + 7)[7:recordMaxPlaintext + 7]
  for body of [a, b] {
    let n = w.sealInto(buf, body, 0, len(body), recordApplicationData)?
    let pt = r.openInPlace(buf[0:n])?
    assert(rinSame(pt.content, body), "record ${r.sequence()} is its own body")
  }
}

fn rinCorrupt(): ()! {
  let ids = [TLS_AES_128_GCM_SHA256, TLS_CHACHA20_POLY1305_SHA256]
  for id of ids {
    let w = rinKeys(id)?
    let r = rinKeys(id)?
    let rec = w.seal(rinBody(512), recordApplicationData)?
    rec[40] = rec[40] ^ 1
    let seen = append([]byte(0), ...rec)
    let msg = ""
    r.openInPlace(rec) catch e {
      msg = e.message()
    }
    assert(msg == "tls record: bad_record_mac", "refused: ${msg}")
    assert(rinSame(rec, seen), "no plaintext written into the record")
    assert(r.sequence() == 0, "a refused record does not advance the sequence")
  }
}

// Accept one connection, drain it through a 1000-byte `readInto` buffer and
// the occasional `read`, and hand everything received to `got`.
fn rinServe(l: TlsListener, got: chan<[]byte>) {
  let all = []byte(0)
  let buf = []byte(1000)
  let c = l.accept() catch _ {
    got <- all
    return
  }
  let guard = 0
  while (guard < 1000) {
    guard = guard + 1
    let k = 0
    if (guard % 7 == 0) {
      let b = c.read(333) catch _ {
        break
      }
      k = len(b)
      all = append(all, ...b)
    } else {
      k = c.readInto(buf, len(buf)) catch _ {
        break
      }
      all = append(all, ...buf[0:k])
    }
    if (k == 0) {
      break
    }
  }
  c.close()
  got <- all
}

fn rinStream(): ()! {
  let cfg = TlsServerConfig(
    creqPem("CERTIFICATE", creqLeafHex),
    creqPem("PRIVATE KEY", creqKeyHex),
    []string(0),
  )?
  let l = listen("127.0.0.1", 0, cfg)?
  let port = l.port()?
  let got = chan<[]byte>(1)
  spawn rinServe(l, got)
  let ccfg = TlsConfig(emptyTrustStore())
  ccfg.insecureSkipVerify = true
  ccfg.serverName = "localhost"
  ccfg.nowUnix = 1800000000
  let c = dial("127.0.0.1", port, ccfg)?
  let body = rinBody(40000)
  c.write(body)?
  c.close()
  let all = <- got
  l.close()
  assert(rinSame(all, body), "stream arrived whole: ${len(all)} of ${len(body)}")
}

test "openInPlace recovers each suite's record inside its own bytes (#7395)" {
  rinRoundTrip() catch e {
    assert(false, e.message())
  }
}

test "sealInto writes full records into a reused buffer (#7446)" {
  rinSealReused() catch e {
    assert(false, e.message())
  }
}

test "a corrupted record is refused before any plaintext is written (#7395)" {
  rinCorrupt() catch e {
    assert(false, e.message())
  }
}

test "TlsConn.readInto delivers a multi-record stream through a small buffer (#7395)" {
  rinStream() catch e {
    assert(false, e.message())
  }
}
