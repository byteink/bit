// Bit standard library — std/tls, the TLS 1.3 record layer (RFC 8446 §5).
//
// The record layer is the frame every other TLS message travels in. A cleartext
// `TLSPlaintext` is `content_type ‖ legacy_record_version(0x0303) ‖ length ‖
// fragment`; once traffic keys exist, each record is protected as a
// `TLSCiphertext` whose `opaque_type` is always `application_data(23)`, the true
// content type moving inside the AEAD-sealed body:
//
//   TLSInnerPlaintext = content ‖ real_content_type ‖ zero_padding
//   TLSCiphertext     = 23 ‖ 0x0303 ‖ length ‖ AEAD-Seal(inner)
//
// Protection is deterministic (RFC 8446 §5.2, §5.3): the per-record nonce is the
// fixed traffic IV XOR the 64-bit record sequence number, right-aligned into the
// low eight octets of an IV-length buffer; the AEAD's additional data is exactly
// the five-byte `TLSCiphertext` header. Sequence numbers are per direction and
// reset to zero on every key change, so `seal` and `open` each own one counter.
//
// `RecordKeys` binds one direction's key, IV, sequence counter, and cipher suite;
// `seal` protects an outbound fragment and `open` recovers an inbound one, both
// advancing the counter. `keyUpdate` re-derives the direction's traffic key and
// IV from the next application-traffic secret (RFC 8446 §7.2) and rewinds the
// counter to zero. A failed `open` is fatal (`bad_record_mac`) and is never
// retried — AEAD authentication has failed, so the record is discarded.
//
// std/tls is one flat module: `Aead`/`Hash` are already imported by sibling
// files, and `CipherSuite`, `tlsSuiteNewAead`, `tlsSuiteNewHash`, `trafficKey`,
// `trafficIV`, and `hkdfExpandLabel` are same-module — so this file needs no
// imports of its own. Its private free helpers are prefixed `record`.

// The inner content types this layer frames (RFC 8446 §5.1). The outer
// `opaque_type` of a protected record is always `application_data`; these name
// the real type that `seal` hides inside the ciphertext and `open` recovers.
export const recordAlert: int = 21
export const recordHandshake: int = 22
export const recordApplicationData: int = 23

// `legacy_record_version` is frozen at TLS 1.2 (0x0303) on every TLS 1.3 record
// for middlebox compatibility (RFC 8446 §5.1); the real version is negotiated in
// the `supported_versions` extension, never here.
const recordLegacyVersion: int = 0x0303

// Length caps (RFC 8446 §5.2). `TLSPlaintext.fragment` is at most 2^14 octets;
// `TLSCiphertext.encrypted_record` may add up to 256 octets of inner type and
// padding plus the AEAD tag, so 2^14 + 256 bounds the ciphertext length field.
const recordMaxPlaintext: int = 16384
const recordMaxCiphertext: int = 16640

// One direction's record-protection state: the negotiated `suite`, the current
// traffic `secret` (kept for `keyUpdate`), the keyed `aead`, the fixed `iv`, and
// the monotonic record `seq`. Fields are module-private — construct via
// `newRecordKeys` and mutate only through the methods, so the sequence number
// can never be desynchronised from the nonce it feeds.
export class RecordKeys {
  suite: CipherSuite
  secret: []byte
  aead: Aead
  iv: []byte
  seq: int
  // Protect `plaintext` as a `TLSCiphertext` record carrying inner `contentType`,
  // returning the full on-the-wire record (5-byte header ‖ AEAD output) and
  // advancing this direction's sequence number. FAILS if the fragment exceeds the
  // 2^14 plaintext cap (RFC 8446 §5.2). No padding is added — the inner plaintext
  // is `content ‖ contentType`.
  export seal(plaintext: []byte, contentType: int): []byte! {
    if (len(plaintext) > recordMaxPlaintext) {
      fail newError("tls record: fragment of ${len(plaintext)} bytes exceeds the 2^14 plaintext limit")
    }
    let inner = recordInner(plaintext, contentType)
    let cipherLen = len(inner) + this.aead.overhead()
    let header = recordHeader(cipherLen)
    let sealed = this.aead.seal(recordNonceBytes(this.iv, this.seq), inner, header)
    this.seq = this.seq + 1
    return recordConcat(header, sealed)
  }

  // Recover the inner content of a protected `record` (the full on-the-wire bytes,
  // header included) and advance this direction's sequence number. FAILS — fatally,
  // with no retry — on a truncated header, an over-long ciphertext (> 2^14 + 256),
  // a header/length mismatch, or an AEAD authentication failure (`bad_record_mac`).
  export open(record: []byte): RecordPlaintext! {
    if (len(record) < 5) {
      fail newError("tls record: truncated record header")
    }
    let cipherLen = (int(record[3]) << 8) | int(record[4])
    if (cipherLen > recordMaxCiphertext) {
      fail newError("tls record: ciphertext of ${cipherLen} bytes exceeds the 2^14+256 limit")
    }
    if (len(record) != 5 + cipherLen) {
      fail newError("tls record: record length ${len(record)} does not match its ${cipherLen}-byte header")
    }
    let header = record[0:5]
    let ciphertext = record[5:5 + cipherLen]
    let inner = this.aead.open(recordNonceBytes(this.iv, this.seq), ciphertext, header) catch _ {
      fail newError("tls record: bad_record_mac")
    }
    this.seq = this.seq + 1
    // De-pad the AUTHENTICATED inner plaintext (RFC 8446 §5.2, §5.4): the real
    // content type is the last non-zero octet; any trailing zeros are padding.
    // This scan runs only on bytes the AEAD has already verified, so it is not a
    // padding oracle.
    let end = len(inner) - 1
    while (end >= 0 && inner[end] == 0) {
      end = end - 1
    }
    if (end < 0) {
      fail newError("tls record: inner plaintext is all padding, no content type")
    }
    return RecordPlaintext{ content: inner[0:end], contentType: int(inner[end]) }
  }

  // Advance this direction to its next traffic key (RFC 8446 §7.2): derive
  // `application_traffic_secret_{N+1}` with HKDF-Expand-Label(secret, "traffic upd",
  // "", Hash.length), re-derive the AEAD key and IV from it, and reset the sequence
  // number to zero. FAILS only if the suite rejects the re-derived key length.
  export keyUpdate(): ()! {
    let next = recordUpdateSecret(this.suite, this.secret)
    let mk = () => tlsSuiteNewHash(this.suite)
    let key = trafficKey(mk, next, this.suite.keyLen)
    this.aead = tlsSuiteNewAead(this.suite, key)?
    this.iv = trafficIV(mk, next, this.suite.ivLen)
    this.secret = next
    this.seq = 0
  }

  // This direction's current record sequence number — the counter the next `seal`
  // or `open` will use, `0` on a fresh context or just after `keyUpdate`.
  export sequence(): int {
    return this.seq
  }

  // The AEAD nonce the next `seal`/`open` will use: the fixed IV XOR the current
  // sequence number (RFC 8446 §5.3). Exposed for diagnostics and to observe nonce
  // progression across records; the layer computes it internally per operation.
  export nonce(): []byte {
    return recordNonceBytes(this.iv, this.seq)
  }
}

// The result of `open`: the recovered application-visible `content` and the
// `contentType` that was hidden inside the protected record.
export class RecordPlaintext { export content: []byte, export contentType: int }

// A record-protection context for one direction, from its `traffic_secret` and
// the negotiated `suite`. Unrolls the secret into the AEAD key and fixed IV via
// HKDF-Expand-Label (RFC 8446 §7.3) and keys the suite's AEAD; the sequence
// number starts at zero. FAILS only if the suite rejects the derived key length.
export fn newRecordKeys(suite: CipherSuite, secret: []byte): RecordKeys! {
  let mk = () => tlsSuiteNewHash(suite)
  let key = trafficKey(mk, secret, suite.keyLen)
  let iv = trafficIV(mk, secret, suite.ivLen)
  let aead = tlsSuiteNewAead(suite, key)?
  return RecordKeys{ suite: suite, secret: secret, aead: aead, iv: iv, seq: 0 }
}

// The per-record nonce (RFC 8446 §5.3): the fixed `iv` XORed with `seq` encoded
// big-endian and right-aligned into the low eight octets of an `iv`-length
// buffer. The leading `len(iv) - 8` octets pass through unchanged. All TLS 1.3
// AEADs use a 12-octet IV, so the eight-octet sequence always fits.
fn recordNonceBytes(iv: []byte, seq: int): []byte {
  let nonce = []byte(len(iv))
  let i = 0
  while (i < len(iv)) {
    nonce[i] = iv[i]
    i = i + 1
  }
  let off = len(iv) - 8
  let j = 0
  while (j < 8) {
    nonce[off + j] = nonce[off + j] ^ byte(seq >> (8 * (7 - j)))
    j = j + 1
  }
  return nonce
}

// The five-octet `TLSCiphertext` record header — `application_data(23)`, the
// frozen legacy version, and the two-byte `cipherLen` — which is both the wire
// prefix and the AEAD additional data (RFC 8446 §5.2).
fn recordHeader(cipherLen: int): []byte {
  let h = []byte(5)
  h[0] = byte(recordApplicationData)
  h[1] = byte(recordLegacyVersion >> 8)
  h[2] = byte(recordLegacyVersion)
  h[3] = byte(cipherLen >> 8)
  h[4] = byte(cipherLen)
  return h
}

// `TLSInnerPlaintext` with no padding: `content ‖ contentType` (RFC 8446 §5.2).
fn recordInner(plaintext: []byte, contentType: int): []byte {
  let inner = []byte(len(plaintext) + 1)
  let i = 0
  while (i < len(plaintext)) {
    inner[i] = plaintext[i]
    i = i + 1
  }
  inner[len(plaintext)] = byte(contentType)
  return inner
}

// `a ‖ b` in a fresh buffer — used to prefix the record header onto the AEAD
// output without mutating either input.
fn recordConcat(a: []byte, b: []byte): []byte {
  let out = []byte(len(a) + len(b))
  let i = 0
  while (i < len(a)) {
    out[i] = a[i]
    i = i + 1
  }
  let j = 0
  while (j < len(b)) {
    out[len(a) + j] = b[j]
    j = j + 1
  }
  return out
}

// The next application-traffic secret (RFC 8446 §7.2): HKDF-Expand-Label of the
// current `secret` with the "traffic upd" label, an empty context, and the
// suite's digest length. Same length as its input, so it re-enters as the next
// secret.
fn recordUpdateSecret(suite: CipherSuite, secret: []byte): []byte {
  let mk = () => tlsSuiteNewHash(suite)
  return hkdfExpandLabel(mk, secret, "traffic upd", []byte(0), suite.hashLen)
}
