// Bit standard library — TLS module, TLS 1.3 handshake messages (RFC 8446 §4).
//
// The wire form of the TLS 1.3 handshake: the `Handshake` framing (a one-byte
// type, a three-byte length, then the body) and a typed encoder/decoder for
// each message a 1-RTT exchange carries — ClientHello, ServerHello,
// EncryptedExtensions, Certificate, CertificateVerify, Finished, and
// NewSessionTicket.
//
// An `Extension` is deliberately generic: a two-byte type and its raw body
// bytes. A handshake message never interprets an extension it carries, so any
// extension — including the ones this module has no typed helper for — round-
// trips byte-for-byte. On top of that flat model sit typed helpers that build
// and read the extensions a handshake actually negotiates over: supported
// versions, supported groups, key share, signature algorithms, server name
// (SNI), and ALPN. The client/server halves of the protocol are built from
// these pieces.
//
// Decoding is strict, because a handshake parser faces hostile input: every
// reader is fallible (`T!`), a declared length that runs past the buffer fails,
// and a message with bytes left over after its declared body — or an extension
// block, certificate list, or extension body not exactly consumed — is
// rejected rather than best-guessed.

// --- protocol versions ------------------------------------------------------

// TLS 1.2 (0x0303). TLS 1.3 keeps this as the ClientHello/ServerHello
// `legacy_version` for backward compatibility; the real version is negotiated
// by the `supported_versions` extension.
export const versionTls12: int = 0x0303
// TLS 1.3 (0x0304). The value carried in `supported_versions`.
export const versionTls13: int = 0x0304

// --- handshake message types (RFC 8446 §4, HandshakeType) -------------------

// client_hello (1).
export const hsClientHello: int = 1
// server_hello (2), also the framing of a HelloRetryRequest.
export const hsServerHello: int = 2
// new_session_ticket (4).
export const hsNewSessionTicket: int = 4
// encrypted_extensions (8).
export const hsEncryptedExtensions: int = 8
// certificate (11).
export const hsCertificate: int = 11
// certificate_verify (15).
export const hsCertificateVerify: int = 15
// finished (20).
export const hsFinished: int = 20

// --- extension types (RFC 8446 §4.2, ExtensionType) -------------------------

// server_name (0) — SNI.
export const extTypeServerName: int = 0
// supported_groups (10).
export const extTypeSupportedGroups: int = 10
// signature_algorithms (13).
export const extTypeSignatureAlgorithms: int = 13
// application_layer_protocol_negotiation (16) — ALPN.
export const extTypeALPN: int = 16
// supported_versions (43).
export const extTypeSupportedVersions: int = 43
// key_share (51).
export const extTypeKeyShare: int = 51

// --- signature schemes (RFC 8446 §4.2.3, SignatureScheme) -------------------

// ecdsa_secp256r1_sha256 (0x0403).
export const sigEcdsaSecp256r1Sha256: int = 0x0403
// ecdsa_secp384r1_sha384 (0x0503).
export const sigEcdsaSecp384r1Sha384: int = 0x0503
// rsa_pss_rsae_sha256 (0x0804).
export const sigRsaPssRsaeSha256: int = 0x0804
// rsa_pss_rsae_sha384 (0x0805).
export const sigRsaPssRsaeSha384: int = 0x0805
// rsa_pss_rsae_sha512 (0x0806).
export const sigRsaPssRsaeSha512: int = 0x0806
// ed25519 (0x0807).
export const sigEd25519: int = 0x0807

// --- named groups (RFC 8446 §4.2.7, NamedGroup) -----------------------------

// secp256r1 (0x0017).
export const groupSecp256r1: int = 0x0017
// secp384r1 (0x0018).
export const groupSecp384r1: int = 0x0018
// x25519 (0x001d).
export const groupX25519: int = 0x001d
// x448 (0x001e).
export const groupX448: int = 0x001e

// --- structs ----------------------------------------------------------------

// One TLS extension: a two-byte `extType` and its raw body `data`. Kept generic
// so a handshake message round-trips any extension byte-identically; the typed
// `ext*`/`parse*` helpers interpret `data` for the extensions that carry it.
export struct Extension { export extType: int, export data: []byte }

// One `KeyShareEntry`: a named group and the raw `key_exchange` bytes for it (a
// public key for that group). The value the `key_share` extension carries.
export struct KeyShareEntry { export group: int, export keyExchange: []byte }

// A ClientHello. `legacyVersion` is 0x0303, `random` is 32 bytes, `sessionId`
// is the (legacy) session id echoed back by the server, `cipherSuites` are the
// offered suites, and `extensions` carries the rest. The single null
// compression method TLS 1.3 mandates is implicit — added on encode, required
// on decode.
export struct ClientHello {
  export legacyVersion: int,
  export random: []byte,
  export sessionId: []byte,
  export cipherSuites: []int,
  export extensions: []Extension,
}

// A ServerHello. Like ClientHello but with a single selected `cipherSuite` and
// no compression list. When `random` equals the HelloRetryRequest sentinel this
// is an HRR — test with `isHelloRetryRequest`.
export struct ServerHello {
  export legacyVersion: int,
  export random: []byte,
  export sessionId: []byte,
  export cipherSuite: int,
  export extensions: []Extension,
}

// The EncryptedExtensions message: the server's responses to non-security
// ClientHello extensions, sent first under handshake encryption.
export struct EncryptedExtensions { export extensions: []Extension }

// One entry of a Certificate message's `certificate_list`: the raw `cert` (a
// DER-encoded X.509 certificate for the default X.509 certificate type) and its
// per-certificate `extensions`.
export struct CertificateEntry { export cert: []byte, export extensions: []Extension }

// A Certificate message: an opaque `certRequestContext` (empty in a server's
// initial handshake) and the chain of `entries`, end-entity certificate first.
export struct Certificate { export certRequestContext: []byte, export entries: []CertificateEntry }

// A CertificateVerify message: the `algorithm` used and the `signature` over the
// handshake transcript.
export struct CertificateVerify { export algorithm: int, export signature: []byte }

// A Finished message: the HMAC `verifyData` over the transcript, its length
// fixed by the negotiated hash.
export struct Finished { export verifyData: []byte }

// A NewSessionTicket message (RFC 8446 §4.6.1): a ticket the server issues for
// resumption, with its `lifetime` seconds, the `ageAdd` obfuscation value, a
// `nonce`, the opaque `ticket`, and `extensions`.
export struct NewSessionTicket {
  export lifetime: int,
  export ageAdd: int,
  export nonce: []byte,
  export ticket: []byte,
  export extensions: []Extension,
}

// A read cursor over a byte buffer. A struct is a reference type (§13.3), so a
// helper that advances `pos` advances it for its caller — that is what threads
// one position through the field-by-field decode without an out-parameter.
struct tlsHsReader { data: []byte, pos: int }

// --- low-level readers (big-endian, length-checked) -------------------------

// Read one octet, failing at end of input.
fn tlsHsGetU8(r: tlsHsReader): int! {
  if (r.pos >= len(r.data)) {
    fail newError("tls: unexpected end of input")
  }
  let b = r.data[r.pos]
  r.pos = r.pos + 1
  return int(b)
}

// Read a big-endian uint16.
fn tlsHsGetU16(r: tlsHsReader): int! {
  let hi = tlsHsGetU8(r)?
  let lo = tlsHsGetU8(r)?
  return (hi << 8) | lo
}

// Read a big-endian uint24.
fn tlsHsGetU24(r: tlsHsReader): int! {
  let a = tlsHsGetU8(r)?
  let b = tlsHsGetU8(r)?
  let c = tlsHsGetU8(r)?
  return (a << 16) | (b << 8) | c
}

// Read a big-endian uint32.
fn tlsHsGetU32(r: tlsHsReader): int! {
  let a = tlsHsGetU8(r)?
  let b = tlsHsGetU8(r)?
  let c = tlsHsGetU8(r)?
  let d = tlsHsGetU8(r)?
  return (a << 24) | (b << 16) | (c << 8) | d
}

// Take the next `n` octets as a view, failing if fewer remain.
fn tlsHsGetBytes(r: tlsHsReader, n: int): []byte! {
  if (n < 0 || r.pos + n > len(r.data)) {
    fail newError("tls: declared length runs past end of input")
  }
  let out = r.data[r.pos:r.pos + n]
  r.pos = r.pos + n
  return out
}

// Read a vector with a one-byte length prefix.
fn tlsHsGetVec8(r: tlsHsReader): []byte! {
  let n = tlsHsGetU8(r)?
  return tlsHsGetBytes(r, n)?
}

// Read a vector with a two-byte length prefix.
fn tlsHsGetVec16(r: tlsHsReader): []byte! {
  let n = tlsHsGetU16(r)?
  return tlsHsGetBytes(r, n)?
}

// Read a vector with a three-byte length prefix.
fn tlsHsGetVec24(r: tlsHsReader): []byte! {
  let n = tlsHsGetU24(r)?
  return tlsHsGetBytes(r, n)?
}

// Fail unless the cursor sits exactly at the end of its buffer — the check that
// rejects trailing garbage after a fully parsed structure.
fn tlsHsExpectEnd(r: tlsHsReader): ()! {
  if (r.pos != len(r.data)) {
    fail newError("tls: trailing bytes after handshake structure")
  }
}

// The uint16 list `b` spells, failing on an odd length. Cipher suites, groups,
// and signature schemes are all encoded this way.
fn tlsHsParseU16List(b: []byte): []int! {
  if (len(b) % 2 != 0) {
    fail newError("tls: uint16 list has an odd length")
  }
  let out = []int(0)
  let r = tlsHsReader{ data: b, pos: 0 }
  let n = len(b) / 2
  let i = 0
  while (i < n) {
    out = append(out, tlsHsGetU16(r)?)
    i = i + 1
  }
  return out
}

// --- low-level writers (append onto a caller-owned, freshly built slice) -----

// Append a uint8.
fn tlsHsPutU8(dst: []byte, v: int): []byte { return append(dst, byte(v & 0xff)) }

// Append a big-endian uint16.
fn tlsHsPutU16(dst: []byte, v: int): []byte {
  let out = append(dst, byte((v >> 8) & 0xff))
  return append(out, byte(v & 0xff))
}

// Append a big-endian uint24.
fn tlsHsPutU24(dst: []byte, v: int): []byte {
  let out = append(dst, byte((v >> 16) & 0xff))
  out = append(out, byte((v >> 8) & 0xff))
  return append(out, byte(v & 0xff))
}

// Append a big-endian uint32.
fn tlsHsPutU32(dst: []byte, v: int): []byte {
  let out = append(dst, byte((v >> 24) & 0xff))
  out = append(out, byte((v >> 16) & 0xff))
  out = append(out, byte((v >> 8) & 0xff))
  return append(out, byte(v & 0xff))
}

// Append every byte of `src`.
fn tlsHsPutBytes(dst: []byte, src: []byte): []byte {
  let out = dst
  for x of src {
    out = append(out, x)
  }
  return out
}

// Append `body` behind a one-byte length prefix.
fn tlsHsPutVec8(dst: []byte, body: []byte): []byte {
  let out = tlsHsPutU8(dst, len(body))
  return tlsHsPutBytes(out, body)
}

// Append `body` behind a two-byte length prefix.
fn tlsHsPutVec16(dst: []byte, body: []byte): []byte {
  let out = tlsHsPutU16(dst, len(body))
  return tlsHsPutBytes(out, body)
}

// Append `body` behind a three-byte length prefix.
fn tlsHsPutVec24(dst: []byte, body: []byte): []byte {
  let out = tlsHsPutU24(dst, len(body))
  return tlsHsPutBytes(out, body)
}

// --- Handshake framing ------------------------------------------------------

// Frame `body` as a Handshake record: the one-byte `msgType`, a three-byte
// length, then the body.
fn tlsHsWrap(msgType: int, body: []byte): []byte {
  let out = tlsHsPutU8([]byte(0), msgType)
  out = tlsHsPutU24(out, len(body))
  return tlsHsPutBytes(out, body)
}

// Strip the Handshake framing off `msg`, checking the type is `wantType` and
// that the declared length matches the buffer exactly. Returns a reader over the
// body positioned at its first byte.
fn tlsHsUnwrap(msg: []byte, wantType: int): tlsHsReader! {
  let r = tlsHsReader{ data: msg, pos: 0 }
  let t = tlsHsGetU8(r)?
  if (t != wantType) {
    fail newError("tls: expected handshake type ${wantType}, got ${t}")
  }
  let n = tlsHsGetU24(r)?
  let body = tlsHsGetBytes(r, n)?
  if (r.pos != len(msg)) {
    fail newError("tls: trailing bytes after handshake message")
  }
  return tlsHsReader{ data: body, pos: 0 }
}

// --- extension block codec --------------------------------------------------

// The extensions of `exts` concatenated, each a two-byte type and a two-byte-
// length body. This is the content of an extensions vector, without its own
// outer length prefix (the caller wraps it with `tlsHsPutVec16`).
fn tlsHsEncodeExtensions(exts: []Extension): []byte {
  let out = []byte(0)
  for e of exts {
    out = tlsHsPutU16(out, e.extType)
    out = tlsHsPutVec16(out, e.data)
  }
  return out
}

// The extensions packed into `block`, failing unless they exactly fill it.
fn tlsHsParseExtensions(block: []byte): []Extension! {
  let r = tlsHsReader{ data: block, pos: 0 }
  let out = []Extension(0)
  let guard = 0
  while (r.pos < len(block) && guard < len(block) + 1) {
    let et = tlsHsGetU16(r)?
    let d = tlsHsGetVec16(r)?
    out = append(out, Extension{ extType: et, data: d })
    guard = guard + 1
  }
  if (r.pos != len(block)) {
    fail newError("tls: extension block not fully consumed")
  }
  return out
}

// Fail unless `comp` is the single null compression method TLS 1.3 requires.
fn tlsHsCheckNullCompression(comp: []byte): ()! {
  if (len(comp) != 1 || comp[0] != 0x00) {
    fail newError("tls: TLS 1.3 requires exactly one (null) compression method")
  }
}

// --- ClientHello ------------------------------------------------------------

// The Handshake-framed encoding of `ch`. `ch.random` must be 32 bytes.
export fn encodeClientHello(ch: ClientHello): []byte {
  let b = []byte(0)
  b = tlsHsPutU16(b, ch.legacyVersion)
  b = tlsHsPutBytes(b, ch.random)
  b = tlsHsPutVec8(b, ch.sessionId)
  let cs = []byte(0)
  for c of ch.cipherSuites {
    cs = tlsHsPutU16(cs, c)
  }
  b = tlsHsPutVec16(b, cs)
  b = tlsHsPutVec8(b, []byte(1)) // legacy_compression_methods: one null method
  b = tlsHsPutVec16(b, tlsHsEncodeExtensions(ch.extensions))
  return tlsHsWrap(hsClientHello, b)
}

// Parse a Handshake-framed ClientHello, rejecting a wrong type, a bad
// compression list, or any trailing bytes.
export fn parseClientHello(msg: []byte): ClientHello! {
  let r = tlsHsUnwrap(msg, hsClientHello)?
  let lv = tlsHsGetU16(r)?
  let random = tlsHsGetBytes(r, 32)?
  let sid = tlsHsGetVec8(r)?
  let ciphers = tlsHsParseU16List(tlsHsGetVec16(r)?)?
  tlsHsCheckNullCompression(tlsHsGetVec8(r)?)?
  let exts = tlsHsParseExtensions(tlsHsGetVec16(r)?)?
  tlsHsExpectEnd(r)?
  return ClientHello{
    legacyVersion: lv,
    random: random,
    sessionId: sid,
    cipherSuites: ciphers,
    extensions: exts,
  }
}

// --- ServerHello ------------------------------------------------------------

// The Handshake-framed encoding of `sh`. `sh.random` must be 32 bytes.
export fn encodeServerHello(sh: ServerHello): []byte {
  let b = []byte(0)
  b = tlsHsPutU16(b, sh.legacyVersion)
  b = tlsHsPutBytes(b, sh.random)
  b = tlsHsPutVec8(b, sh.sessionId)
  b = tlsHsPutU16(b, sh.cipherSuite)
  b = tlsHsPutU8(b, 0) // legacy_compression_method
  b = tlsHsPutVec16(b, tlsHsEncodeExtensions(sh.extensions))
  return tlsHsWrap(hsServerHello, b)
}

// Parse a Handshake-framed ServerHello (or HelloRetryRequest — same framing),
// rejecting a non-zero compression method or trailing bytes.
export fn parseServerHello(msg: []byte): ServerHello! {
  let r = tlsHsUnwrap(msg, hsServerHello)?
  let lv = tlsHsGetU16(r)?
  let random = tlsHsGetBytes(r, 32)?
  let sid = tlsHsGetVec8(r)?
  let cs = tlsHsGetU16(r)?
  let comp = tlsHsGetU8(r)?
  if (comp != 0) {
    fail newError("tls: ServerHello legacy_compression_method must be 0")
  }
  let exts = tlsHsParseExtensions(tlsHsGetVec16(r)?)?
  tlsHsExpectEnd(r)?
  return ServerHello{
    legacyVersion: lv,
    random: random,
    sessionId: sid,
    cipherSuite: cs,
    extensions: exts,
  }
}

// The 32-byte random SHA-256("HelloRetryRequest") a server puts in a ServerHello
// to signal HelloRetryRequest (RFC 8446 §4.1.3).
fn tlsHsHelloRetryRandom(): []byte {
  return []byte{
    0xcf,
    0x21,
    0xad,
    0x74,
    0xe5,
    0x9a,
    0x61,
    0x11,
    0xbe,
    0x1d,
    0x8c,
    0x02,
    0x1e,
    0x65,
    0xb8,
    0x91,
    0xc2,
    0xa2,
    0x11,
    0x16,
    0x7a,
    0xbb,
    0x8c,
    0x5e,
    0x07,
    0x9e,
    0x09,
    0xe2,
    0xc8,
    0xa8,
    0x33,
    0x9c,
  }
}

// Whether `sh` is a HelloRetryRequest: its random equals the RFC 8446 sentinel.
export fn isHelloRetryRequest(sh: ServerHello): bool {
  let want = tlsHsHelloRetryRandom()
  if (len(sh.random) != len(want)) {
    return false
  }
  let i = 0
  while (i < len(want)) {
    if (sh.random[i] != want[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// --- EncryptedExtensions ----------------------------------------------------

// The Handshake-framed encoding of `ee`.
export fn encodeEncryptedExtensions(ee: EncryptedExtensions): []byte {
  let b = tlsHsPutVec16([]byte(0), tlsHsEncodeExtensions(ee.extensions))
  return tlsHsWrap(hsEncryptedExtensions, b)
}

// Parse a Handshake-framed EncryptedExtensions.
export fn parseEncryptedExtensions(msg: []byte): EncryptedExtensions! {
  let r = tlsHsUnwrap(msg, hsEncryptedExtensions)?
  let exts = tlsHsParseExtensions(tlsHsGetVec16(r)?)?
  tlsHsExpectEnd(r)?
  return EncryptedExtensions{ extensions: exts }
}

// --- Certificate ------------------------------------------------------------

// The Handshake-framed encoding of `c`.
export fn encodeCertificate(c: Certificate): []byte {
  let b = tlsHsPutVec8([]byte(0), c.certRequestContext)
  let list = []byte(0)
  for e of c.entries {
    list = tlsHsPutVec24(list, e.cert)
    list = tlsHsPutVec16(list, tlsHsEncodeExtensions(e.extensions))
  }
  b = tlsHsPutVec24(b, list)
  return tlsHsWrap(hsCertificate, b)
}

// The certificate entries packed into `block`, failing unless exactly consumed.
fn tlsHsParseCertEntries(block: []byte): []CertificateEntry! {
  let r = tlsHsReader{ data: block, pos: 0 }
  let out = []CertificateEntry(0)
  let guard = 0
  while (r.pos < len(block) && guard < len(block) + 1) {
    let cert = tlsHsGetVec24(r)?
    let exts = tlsHsParseExtensions(tlsHsGetVec16(r)?)?
    out = append(out, CertificateEntry{ cert: cert, extensions: exts })
    guard = guard + 1
  }
  if (r.pos != len(block)) {
    fail newError("tls: certificate_list not fully consumed")
  }
  return out
}

// Parse a Handshake-framed Certificate.
export fn parseCertificate(msg: []byte): Certificate! {
  let r = tlsHsUnwrap(msg, hsCertificate)?
  let ctx = tlsHsGetVec8(r)?
  let entries = tlsHsParseCertEntries(tlsHsGetVec24(r)?)?
  tlsHsExpectEnd(r)?
  return Certificate{ certRequestContext: ctx, entries: entries }
}

// --- CertificateVerify ------------------------------------------------------

// The Handshake-framed encoding of `cv`.
export fn encodeCertificateVerify(cv: CertificateVerify): []byte {
  let b = tlsHsPutU16([]byte(0), cv.algorithm)
  b = tlsHsPutVec16(b, cv.signature)
  return tlsHsWrap(hsCertificateVerify, b)
}

// Parse a Handshake-framed CertificateVerify.
export fn parseCertificateVerify(msg: []byte): CertificateVerify! {
  let r = tlsHsUnwrap(msg, hsCertificateVerify)?
  let alg = tlsHsGetU16(r)?
  let sig = tlsHsGetVec16(r)?
  tlsHsExpectEnd(r)?
  return CertificateVerify{ algorithm: alg, signature: sig }
}

// --- Finished ---------------------------------------------------------------

// The Handshake-framed encoding of `f`. The whole body is `verifyData`.
export fn encodeFinished(f: Finished): []byte { return tlsHsWrap(hsFinished, f.verifyData) }

// Parse a Handshake-framed Finished. The whole body is the verify data.
export fn parseFinished(msg: []byte): Finished! {
  let r = tlsHsUnwrap(msg, hsFinished)?
  let vd = tlsHsGetBytes(r, len(r.data))?
  return Finished{ verifyData: vd }
}

// --- NewSessionTicket -------------------------------------------------------

// The Handshake-framed encoding of `t`.
export fn encodeNewSessionTicket(t: NewSessionTicket): []byte {
  let b = tlsHsPutU32([]byte(0), t.lifetime)
  b = tlsHsPutU32(b, t.ageAdd)
  b = tlsHsPutVec8(b, t.nonce)
  b = tlsHsPutVec16(b, t.ticket)
  b = tlsHsPutVec16(b, tlsHsEncodeExtensions(t.extensions))
  return tlsHsWrap(hsNewSessionTicket, b)
}

// Parse a Handshake-framed NewSessionTicket.
export fn parseNewSessionTicket(msg: []byte): NewSessionTicket! {
  let r = tlsHsUnwrap(msg, hsNewSessionTicket)?
  let lifetime = tlsHsGetU32(r)?
  let ageAdd = tlsHsGetU32(r)?
  let nonce = tlsHsGetVec8(r)?
  let ticket = tlsHsGetVec16(r)?
  let exts = tlsHsParseExtensions(tlsHsGetVec16(r)?)?
  tlsHsExpectEnd(r)?
  return NewSessionTicket{
    lifetime: lifetime,
    ageAdd: ageAdd,
    nonce: nonce,
    ticket: ticket,
    extensions: exts,
  }
}

// --- generic framing helpers ------------------------------------------------

// The message type of a Handshake-framed message — its first byte — without
// decoding the body. Fails on an empty buffer. Use it to dispatch to the right
// `parse*` before you know which message you hold.
export fn handshakeType(msg: []byte): int! {
  if (len(msg) == 0) {
    fail newError("tls: empty handshake message")
  }
  return int(msg[0])
}

// --- typed extensions -------------------------------------------------------

// A `server_name` (SNI) extension naming a single `host_name` host.
export fn extServerName(host: string): Extension {
  let entry = tlsHsPutU8([]byte(0), 0) // NameType host_name(0)
  entry = tlsHsPutVec16(entry, []byte(host))
  return Extension{ extType: extTypeServerName, data: tlsHsPutVec16([]byte(0), entry) }
}

// The host of a `server_name` extension's first `host_name` entry. Fails on any
// other name type or on trailing bytes.
export fn parseServerName(e: Extension): string! {
  let r = tlsHsReader{ data: e.data, pos: 0 }
  let list = tlsHsGetVec16(r)?
  tlsHsExpectEnd(r)?
  let lr = tlsHsReader{ data: list, pos: 0 }
  let nameType = tlsHsGetU8(lr)?
  if (nameType != 0) {
    fail newError("tls: unsupported SNI name_type ${nameType}")
  }
  let host = tlsHsGetVec16(lr)?
  tlsHsExpectEnd(lr)?
  return string(host)
}

// An `application_layer_protocol_negotiation` (ALPN) extension offering
// `protocols` in order (e.g. `["h2", "http/1.1"]`).
export fn extALPN(protocols: []string): Extension {
  let list = []byte(0)
  for p of protocols {
    list = tlsHsPutVec8(list, []byte(p))
  }
  return Extension{ extType: extTypeALPN, data: tlsHsPutVec16([]byte(0), list) }
}

// The protocol names of an ALPN extension, in order. Fails on trailing bytes.
export fn parseALPN(e: Extension): []string! {
  let r = tlsHsReader{ data: e.data, pos: 0 }
  let list = tlsHsGetVec16(r)?
  tlsHsExpectEnd(r)?
  let lr = tlsHsReader{ data: list, pos: 0 }
  let out = []string(0)
  let guard = 0
  while (lr.pos < len(list) && guard < len(list) + 1) {
    out = append(out, string(tlsHsGetVec8(lr)?))
    guard = guard + 1
  }
  if (lr.pos != len(list)) {
    fail newError("tls: ALPN list not fully consumed")
  }
  return out
}

// A `supported_groups` extension listing the named `groups` offered.
export fn extSupportedGroups(groups: []int): Extension {
  let list = []byte(0)
  for g of groups {
    list = tlsHsPutU16(list, g)
  }
  return Extension{ extType: extTypeSupportedGroups, data: tlsHsPutVec16([]byte(0), list) }
}

// The named groups of a `supported_groups` extension. Fails on trailing bytes.
export fn parseSupportedGroups(e: Extension): []int! {
  let r = tlsHsReader{ data: e.data, pos: 0 }
  let list = tlsHsGetVec16(r)?
  tlsHsExpectEnd(r)?
  return tlsHsParseU16List(list)?
}

// A `signature_algorithms` extension listing the `schemes` offered.
export fn extSignatureAlgorithms(schemes: []int): Extension {
  let list = []byte(0)
  for s of schemes {
    list = tlsHsPutU16(list, s)
  }
  return Extension{ extType: extTypeSignatureAlgorithms, data: tlsHsPutVec16([]byte(0), list) }
}

// The schemes of a `signature_algorithms` extension. Fails on trailing bytes.
export fn parseSignatureAlgorithms(e: Extension): []int! {
  let r = tlsHsReader{ data: e.data, pos: 0 }
  let list = tlsHsGetVec16(r)?
  tlsHsExpectEnd(r)?
  return tlsHsParseU16List(list)?
}

// A ClientHello `supported_versions` extension offering `versions` (a one-byte-
// length list — the ClientHello form). Offer `[versionTls13]` for TLS 1.3.
export fn extSupportedVersionsClient(versions: []int): Extension {
  let list = []byte(0)
  for v of versions {
    list = tlsHsPutU16(list, v)
  }
  return Extension{ extType: extTypeSupportedVersions, data: tlsHsPutVec8([]byte(0), list) }
}

// The versions of a ClientHello `supported_versions` extension. Fails on
// trailing bytes.
export fn parseSupportedVersionsClient(e: Extension): []int! {
  let r = tlsHsReader{ data: e.data, pos: 0 }
  let list = tlsHsGetVec8(r)?
  tlsHsExpectEnd(r)?
  return tlsHsParseU16List(list)?
}

// A ServerHello `supported_versions` extension carrying the single selected
// `version` (the ServerHello/HRR form — two bare bytes, no list).
export fn extSupportedVersionsServer(version: int): Extension {
  return Extension{ extType: extTypeSupportedVersions, data: tlsHsPutU16([]byte(0), version) }
}

// The selected version of a ServerHello `supported_versions` extension. Fails
// unless it is exactly two bytes.
export fn parseSupportedVersionsServer(e: Extension): int! {
  let r = tlsHsReader{ data: e.data, pos: 0 }
  let v = tlsHsGetU16(r)?
  tlsHsExpectEnd(r)?
  return v
}

// A ClientHello `key_share` extension carrying the offered `entries` (a length-
// prefixed list — the ClientHello form).
export fn extKeyShareClient(entries: []KeyShareEntry): Extension {
  let list = []byte(0)
  for e of entries {
    list = tlsHsPutU16(list, e.group)
    list = tlsHsPutVec16(list, e.keyExchange)
  }
  return Extension{ extType: extTypeKeyShare, data: tlsHsPutVec16([]byte(0), list) }
}

// The entries of a ClientHello `key_share` extension. Fails on trailing bytes.
export fn parseKeyShareClient(e: Extension): []KeyShareEntry! {
  let r = tlsHsReader{ data: e.data, pos: 0 }
  let list = tlsHsGetVec16(r)?
  tlsHsExpectEnd(r)?
  let lr = tlsHsReader{ data: list, pos: 0 }
  let out = []KeyShareEntry(0)
  let guard = 0
  while (lr.pos < len(list) && guard < len(list) + 1) {
    let g = tlsHsGetU16(lr)?
    let k = tlsHsGetVec16(lr)?
    out = append(out, KeyShareEntry{ group: g, keyExchange: k })
    guard = guard + 1
  }
  if (lr.pos != len(list)) {
    fail newError("tls: key_share list not fully consumed")
  }
  return out
}

// A ServerHello `key_share` extension carrying the single selected `entry` (the
// ServerHello form — one entry, no list prefix).
export fn extKeyShareServer(entry: KeyShareEntry): Extension {
  let data = tlsHsPutU16([]byte(0), entry.group)
  data = tlsHsPutVec16(data, entry.keyExchange)
  return Extension{ extType: extTypeKeyShare, data: data }
}

// The selected entry of a ServerHello `key_share` extension. Fails on trailing
// bytes.
export fn parseKeyShareServer(e: Extension): KeyShareEntry! {
  let r = tlsHsReader{ data: e.data, pos: 0 }
  let g = tlsHsGetU16(r)?
  let k = tlsHsGetVec16(r)?
  tlsHsExpectEnd(r)?
  return KeyShareEntry{ group: g, keyExchange: k }
}
