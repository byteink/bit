// stdlib/tls/clienthello.test.bit — the ClientHello a client hands out is a
// snapshot, not its live transcript (#4959). `clientHelloMessage()` returns the
// handshake's own `ch1`; the transcript is grown in place by `tlsHsPutBytes` as
// each server message is absorbed, so a shared buffer would silently turn a held
// ClientHello into ClientHello || ServerHello — and an Initial-level QUIC
// retransmit would then send the ServerHello bytes back to the server.
//
// Starting a handshake builds no record keys, and the server's leaf is parsed
// once however many checks read it (#7561).
//
// The ServerHello is a real one from std/tls's own server, as in `creqDrive`;
// the leaf, its key and the client configuration are that file's fixtures, which
// are siblings here because std/tls is one flat module.

// A held ClientHello and an independent copy of what it was at hand-out time.
class chmRun {
  held: []byte,
  want: []byte,
}

// Hand out the ClientHello, keep the value, and drive one real ServerHello
// through the client.
fn chmDrive(): chmRun! {
  let scfg = TlsServerConfig(
    creqPem("CERTIFICATE", creqLeafHex),
    creqPem("PRIVATE KEY", creqKeyHex),
    []string(0),
  )?
  let s = tlsServerStart(scfg)?
  let c = tlsClientStart(creqClientConfig())?
  let held = c.clientHelloMessage()
  let want = tlsHsCopyBytes(held)
  // The server gets its own copy: it is the client's slice that is under test
  // here, and nothing outside the client may grow it.
  let fl = s.processClientHelloMessage(tlsHsCopyBytes(held))?
  let resent = c.processServerHelloMessage(fl.serverHello)?
  if (len(resent) > 0) {
    fail newError("the server sent a HelloRetryRequest")
  }
  return chmRun{ held = held, want = want }
}

test "clientHelloMessage is not the transcript the ServerHello grows" {
  let r = chmDrive() catch e {
    assert(false, "the handshake failed: ${e.message()}")
    return
  }
  assert(
    len(r.held) == len(r.want),
    "the held ClientHello grew from ${len(r.want)} to ${len(r.held)} bytes",
  )
  assert(ctEq(r.held, r.want), "the held ClientHello bytes changed")
}

test "tlsClientStart builds no record keys before a secret exists (#7561)" {
  let c = tlsClientStart(creqClientConfig()) catch e {
    assert(false, "start: ${e.message()}")
    return
  }
  assert(!isSome(c.serverHsKeys), "server handshake keys built at start")
  assert(!isSome(c.clientHsKeys), "client handshake keys built at start")
  assert(!isSome(c.earlyWriteKeys), "early-data keys built at start")
}

test "the server leaf is parsed once and reused until the chain changes (#7561)" {
  let c = tlsClientStart(creqClientConfig()) catch e {
    assert(false, "start: ${e.message()}")
    return
  }
  let der = decodeHex(creqLeafHex) catch e {
    assert(false, "fixture: ${e.message()}")
    return
  }
  c.peerCerts = [der]
  let first = clientLeaf(c) catch e {
    assert(false, "first parse: ${e.message()}")
    return
  }
  // Unparseable bytes in place of the leaf: only a cached certificate passes.
  c.peerCerts = [[]byte(3)]
  let again = clientLeaf(c) catch e {
    assert(false, "the second read parsed the chain again: ${e.message()}")
    return
  }
  assert(again.pubKeyAlg == first.pubKeyAlg, "the cached leaf is the first one")
  c.leaf = Option.None
  let _ = clientLeaf(c) catch _ {
    return
  }
  assert(false, "a reset leaf was not parsed from the new chain")
}
