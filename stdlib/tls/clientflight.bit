// Bit standard library — std/tls, driving the client handshake: process a
// server flight, authenticate the server, and the completed `TlsClientConn`
// application-data channel (split out of `client.bit`, #1503).

// ---------------------------------------------------------------------------
// Drive: process a server flight
// ---------------------------------------------------------------------------

// The suite hash as a `() => Hash` for the key schedule and transcript.
function (h: TlsClientHandshake) clientNewHash(): Hash { return tlsSuiteNewHash(h.suite) }

// The transcript hash of the messages absorbed so far, under the negotiated suite
// hash.
function (h: TlsClientHandshake) clientTh(): []byte {
  return digest(tlsSuiteNewHash(h.suite), h.transcript)
}

// Process one server flight of raw record bytes. Returns a `retry` step on a
// HelloRetryRequest (resend `outbound`, then feed the next flight) or a `done`
// step carrying the client Finished to send. Fails — fatally — on any parse
// error or authentication failure (bad certificate chain, CertificateVerify
// signature, or server Finished MAC).
export function (h: TlsClientHandshake) processServerFlight(flight: []byte): TlsClientStep! {
  let records = tlsWireSplitRecords(flight)?
  let idx = 0
  while (idx < len(records) && tlsWireRecordType(records[idx]) == tlsCcsType) {
    idx = idx + 1
  }
  if (idx >= len(records)) {
    fail newError("tls client: server flight has no ServerHello")
  }
  let shRec = records[idx]
  idx = idx + 1
  if (tlsWireRecordType(shRec) != recordHandshake) {
    fail newError("tls client: expected a plaintext handshake record for ServerHello")
  }
  let shMsg = tlsWireRecordBody(shRec)
  let sh = parseServerHello(shMsg)?
  if (isHelloRetryRequest(sh)) {
    return h.clientHandleHrr(sh, shMsg)?
  }

  h.clientProcessServerHello(sh, shMsg)?

  // The remaining records are AEAD-sealed handshake records; decrypt each and
  // concatenate the recovered handshake messages into one stream to parse.
  let stream = []byte(0)
  while (idx < len(records)) {
    let rec = records[idx]
    idx = idx + 1
    if (tlsWireRecordType(rec) == tlsCcsType) {
      continue
    }
    let pt = h.serverHsKeys.open(rec)?
    if (pt.contentType == recordAlert) {
      fail newError("tls client: server sent an alert during the handshake")
    }
    if (pt.contentType != recordHandshake) {
      fail newError("tls client: unexpected content type ${pt.contentType} in the handshake flight")
    }
    stream = tlsHsPutBytes(stream, pt.content)
  }
  return h.clientProcessAuthFlight(stream)?
}

// Handle a HelloRetryRequest and produce the resent ClientHello *message*: adopt
// the HRR's suite, rebuild the transcript around the synthetic message_hash (RFC
// 8446 §4.4.1), and build a ClientHello whose only change is a key_share for the
// group the server requested. Returns the ClientHello handshake-message bytes;
// record mode wraps it in a plaintext record, the QUIC path carries it directly.
function (h: TlsClientHandshake) clientHandleHrrCore(sh: ServerHello, shMsg: []byte): []byte! {
  if (h.usedHrr) {
    fail newError("tls client: server sent a second HelloRetryRequest")
  }
  h.usedHrr = true
  h.suite = tlsSuiteById(sh.cipherSuite)?
  if (!h.clientOfferedSuite(sh.cipherSuite)) {
    fail newError("tls client: HelloRetryRequest chose an unoffered cipher suite")
  }
  let ksExt = h.clientFindExt(sh.extensions, extTypeKeyShare)?
  if (len(ksExt.data) < 2) {
    fail newError("tls client: HelloRetryRequest key_share has no selected group")
  }
  let cp = (int(ksExt.data[0]) << 8) | int(ksExt.data[1])
  if (!h.clientSupportsGroup(cp)) {
    fail newError("tls client: HelloRetryRequest requested an unoffered group")
  }
  let g = tlsGroupFromCodepoint(u64(cp))?

  let synthetic = tlsWireSyntheticHash(h.clientNewHash, h.ch1)
  h.transcript = tlsHsPutBytes(synthetic, shMsg)
  h.offers = clientMakeOffers([g], []GroupKeypair(0))
  let ch2 = h.clientBuildHello(h.offers)
  h.transcript = tlsHsPutBytes(h.transcript, ch2)
  return ch2
}

// Handle a HelloRetryRequest in record mode: build the resent ClientHello message
// and frame it as the plaintext record to send.
function (h: TlsClientHandshake) clientHandleHrr(sh: ServerHello, shMsg: []byte): TlsClientStep! {
  let ch2 = h.clientHandleHrrCore(sh, shMsg)?
  h.hello = tlsWirePlaintextRecord(recordHandshake, ch2)
  return TlsClientStep{ retry: true, done: false, outbound: h.hello }
}

// Process the ServerHello: confirm TLS 1.3 and a suite we offered, finish the
// key exchange from the server's key_share, extend the transcript, and derive the
// handshake-traffic secrets and their record contexts.
function (h: TlsClientHandshake) clientProcessServerHello(sh: ServerHello, shMsg: []byte): ()! {
  let svExt = h.clientFindExt(sh.extensions, extTypeSupportedVersions)?
  if (parseSupportedVersionsServer(svExt)? != versionTls13) {
    fail newError("tls client: server did not select TLS 1.3")
  }
  if (!h.clientOfferedSuite(sh.cipherSuite)) {
    fail newError("tls client: server chose an unoffered cipher suite")
  }
  h.suite = tlsSuiteById(sh.cipherSuite)?

  let ksExt = h.clientFindExt(sh.extensions, extTypeKeyShare)?
  let entry = parseKeyShareServer(ksExt)?
  let offer = h.clientOfferForCp(entry.group)?
  h.shared = tlsGroupComputeShared(offer.group, offer.kp.priv, entry.keyExchange)?

  h.transcript = tlsHsPutBytes(h.transcript, shMsg)

  let mk = h.clientNewHash
  let early = earlySecret(mk, []byte(0))
  // Session resumption (#1209): the server echoes pre_shared_key in ServerHello
  // only when it accepted the PSK we offered; use the PSK-derived early secret
  // for the rest of the ladder in that case, exactly as a fresh handshake uses
  // the all-zero one otherwise (RFC 8446 §7.1's Early Secret rung is generic
  // over the PSK, so nothing downstream needs to know which branch this is).
  let pskLookup = findExtOptional(sh.extensions, extTypePreSharedKey)
  if (h.pskUsed && pskLookup.found) {
    if (sh.cipherSuite != h.pskSuite.id) {
      fail newError("tls client: server accepted resumption with a mismatched cipher suite")
    }
    h.pskAccepted = true
    early = h.pskEarly
  }
  h.hsSec = handshakeSecret(mk, early, h.shared)
  let thSH = h.clientTh()
  h.chs = clientHandshakeTrafficSecret(mk, h.hsSec, thSH)
  h.shs = serverHandshakeTrafficSecret(mk, h.hsSec, thSH)
  h.serverHsKeys = newRecordKeys(h.suite, h.shs)?
  h.clientHsKeys = newRecordKeys(h.suite, h.chs)?
}

// Parse and authenticate the server's Handshake-level messages —
// EncryptedExtensions, Certificate, CertificateVerify, Finished — in order,
// deriving the application-traffic material and returning the client Finished
// *message* bytes. The security core: it verifies the certificate chain +
// hostname (unless `insecureSkipVerify`), the CertificateVerify signature, and
// the server Finished MAC exactly as record mode. Shared by record mode
// (`clientProcessAuthFlight`, which seals the message into a record) and the QUIC
// record-bypass path (`clientReadHandshake`, which carries the message as-is).
function (h: TlsClientHandshake) clientConsumeAuthFlight(stream: []byte): []byte! {
  let msgs = tlsWireSplitHandshakes(stream)?
  for msg of msgs {
    let t = handshakeType(msg)?
    if (t == hsEncryptedExtensions) {
      let ee = parseEncryptedExtensions(msg)?
      h.serverEEExts = ee.extensions
      h.alpn = h.clientPickAlpn(ee.extensions)
      if (h.sentEarlyData && hasExt(ee.extensions, extTypeEarlyData)) {
        h.earlyDataAccepted = true
      }
      h.transcript = tlsHsPutBytes(h.transcript, msg)
    } else if (t == hsCertificate) {
      let cert = parseCertificate(msg)?
      h.peerCerts = clientCertDers(cert)
      if (len(h.peerCerts) == 0) {
        fail newError("tls client: server sent an empty certificate chain")
      }
      h.transcript = tlsHsPutBytes(h.transcript, msg)
      if (!h.config.insecureSkipVerify) {
        h.clientVerifyChain()?
      }
    } else if (t == hsCertificateVerify) {
      let cv = parseCertificateVerify(msg)?
      h.clientVerifyCertVerify(cv)?
      h.transcript = tlsHsPutBytes(h.transcript, msg)
    } else if (t == hsFinished) {
      let fin = parseFinished(msg)?
      h.clientVerifyServerFinished(fin)?
      h.transcript = tlsHsPutBytes(h.transcript, msg)
      return h.clientFinishMessage()
    } else {
      fail newError("tls client: unexpected handshake message type ${t}")
    }
  }
  fail newError("tls client: server flight ended before the Finished message")
}

// Record mode: consume the AEAD-decrypted auth flight, then seal the resulting
// client Finished message into a handshake record to send. When 0-RTT early
// data was accepted (#1209), an EndOfEarlyData record — sealed under the early
// traffic key, the RFC 8446 §4.5 signal that the record layer is switching back
// to handshake keys — precedes it; `clientFinishMessage` already folded its
// bytes into the transcript the Finished MAC covers.
function (h: TlsClientHandshake) clientProcessAuthFlight(stream: []byte): TlsClientStep! {
  let finMsg = h.clientConsumeAuthFlight(stream)?
  let out = []byte(0)
  if (h.earlyDataAccepted) {
    out = tlsHsPutBytes(out, h.earlyWriteKeys.seal(encodeEndOfEarlyData(), recordHandshake)?)
  }
  out = tlsHsPutBytes(out, h.clientHsKeys.seal(finMsg, recordHandshake)?)
  return TlsClientStep{ retry: false, done: true, outbound: out }
}

// Verify the peer certificate chain up to a trusted root and against the SNI
// hostname (RFC 8446 §4.4.2), delegating to the std/crypto X.509 verifier. Any
// failure aborts the handshake.
function (h: TlsClientHandshake) clientVerifyChain(): ()! {
  let leaf = x509Parse(h.peerCerts[0])?
  let inter = []X509Certificate(0)
  let i = 1
  while (i < len(h.peerCerts)) {
    inter = append(inter, x509Parse(h.peerCerts[i])?)
    i = i + 1
  }
  x509VerifyChain(leaf, inter, h.config.trust.roots, h.config.serverName, h.config.nowUnix)?
}

// Verify the server's CertificateVerify signature over the RFC 8446 §4.4.3 signed
// content with the leaf certificate's public key. Fails on a bad signature.
function (h: TlsClientHandshake) clientVerifyCertVerify(cv: CertificateVerify): ()! {
  let leaf = x509Parse(h.peerCerts[0])?
  let signed = tlsWireCertVerifyContent(tlsWireServerCertVerifyContext, h.clientTh())
  if (!clientCheckSignature(cv.algorithm, leaf, signed, cv.signature)) {
    fail newError("tls client: server CertificateVerify signature is invalid")
  }
}

// Whether `sig` is a valid signature of `signed` under `leaf`'s public key for
// SignatureScheme `alg`. Dispatches on the scheme, pins the expected public-key
// type, and treats any malformed key or signature as an invalid signature rather
// than raising — a verification predicate must not fail open.
function clientCheckSignature(alg: int, leaf: X509Certificate, signed: []byte, sig: []byte): bool {
  if (alg == sigEcdsaSecp256r1Sha256) {
    return clientVerifyEcdsa(leaf, nistecP256(), digest(newSha256(), signed), sig)
  }
  if (alg == sigEcdsaSecp384r1Sha384) {
    return clientVerifyEcdsa(leaf, nistecP384(), digest(newSha384(), signed), sig)
  }
  if (alg == sigRsaPssRsaeSha256) {
    return clientVerifyRsaPss(leaf, clientSha256, signed, sig, 32)
  }
  if (alg == sigRsaPssRsaeSha384) {
    return clientVerifyRsaPss(leaf, clientSha384, signed, sig, 48)
  }
  if (alg == sigRsaPssRsaeSha512) {
    return clientVerifyRsaPss(leaf, clientSha512, signed, sig, 64)
  }
  if (alg == sigEd25519) {
    if (leaf.pubKeyAlg != x509KeyEd25519) {
      return false
    }
    return ed25519Verify(leaf.pubKeyBytes, signed, sig)
  }
  return false
}

// ECDSA CertificateVerify: decode the leaf's SEC 1 point on `curve`, parse the
// DER signature, and verify over the pre-hashed message. False on any mismatch.
function clientVerifyEcdsa(leaf: X509Certificate, curve: Curve, hash: []byte, sig: []byte): bool {
  if (leaf.pubKeyAlg != x509KeyECDSA) {
    return false
  }
  let pub = ecdsaPublicKey(curve, leaf.pubKeyBytes) catch e {
    return false
  }
  let parsed = ecdsaSignatureFromDer(sig) catch e {
    return false
  }
  return ecdsaVerify(pub, hash, parsed)
}

// RSASSA-PSS CertificateVerify: parse the leaf's PKCS#1 public key and verify the
// signature over `signed` with `newHash`/`saltLen` (MGF1 over the same hash).
function clientVerifyRsaPss(
  leaf: X509Certificate,
  newHash: () => Hash,
  signed: []byte,
  sig: []byte,
  saltLen: int,
): bool {
  if (leaf.pubKeyAlg != x509KeyRSA) {
    return false
  }
  let pub = rsaParsePkcs1PublicKey(leaf.pubKeyBytes) catch e {
    return false
  }
  return rsaVerifyPss(pub, newHash, signed, sig, saltLen)
}

// Verify the server Finished MAC in constant time (RFC 8446 §4.4.4): recompute
// HMAC(server_finished_key, Transcript-Hash(.. up to CertificateVerify)) and
// compare it to the received verify_data.
function (h: TlsClientHandshake) clientVerifyServerFinished(fin: Finished): ()! {
  let expected = finishedMac(h.clientNewHash, h.shs, h.clientTh())
  if (!ctEq(fin.verifyData, expected)) {
    fail newError("tls client: server Finished MAC is invalid")
  }
}

// Produce the client Finished *message* and derive the application-traffic
// material. The transcript already includes the server Finished, so its hash
// `thSF` seeds both the client Finished MAC and the application secrets (RFC 8446
// §7.1). Marks the handshake connected. Record mode seals the returned message
// into a record; the QUIC path carries it verbatim in a CRYPTO frame.
function (h: TlsClientHandshake) clientFinishMessage(): []byte {
  let mk = h.clientNewHash
  // RFC 8446 §7.1 fixes the application-traffic/exporter secrets to
  // "ClientHello...server Finished", never extended by EndOfEarlyData — that
  // extension applies only to the client Finished MAC's own Handshake Context
  // (§4.4.4: "the later of server Finished/EndOfEarlyData"), computed below
  // over a transcript that (when 0-RTT was accepted) already includes it.
  let thSF = h.clientTh()
  let master = masterSecret(mk, h.hsSec)
  h.capSecret = clientApplicationTrafficSecret(mk, master, thSF)
  h.sapSecret = serverApplicationTrafficSecret(mk, master, thSF)
  h.exporterSec = exporterMasterSecret(mk, master, thSF)

  if (h.earlyDataAccepted) {
    h.transcript = tlsHsPutBytes(h.transcript, encodeEndOfEarlyData())
  }
  let verify = finishedMac(mk, h.chs, h.clientTh())
  let finMsg = encodeFinished(Finished{ verifyData: verify })

  h.transcript = tlsHsPutBytes(h.transcript, finMsg)
  h.resumptionSec = resumptionMasterSecret(mk, master, h.clientTh())
  h.connected = true
  return finMsg
}

// The completed connection, valid once `processServerFlight` returned a `done`
// step. Fails if called before the handshake has finished.
export function (h: TlsClientHandshake) connection(): TlsClientConn! {
  if (!h.connected) {
    fail newError("tls client: handshake is not complete")
  }
  return TlsClientConn{
    suite: h.suite,
    alpn: h.alpn,
    peerCerts: h.peerCerts,
    appWrite: newRecordKeys(h.suite, h.capSecret)?,
    appRead: newRecordKeys(h.suite, h.sapSecret)?,
    exporter: h.exporterSec,
    resumption: h.resumptionSec,
  }
}

// ---------------------------------------------------------------------------
// Small lookups over the handshake state
// ---------------------------------------------------------------------------

// The first extension of `exts` with type `t`, or a failure — the server omitting
// a required extension (supported_versions, key_share) is a fatal handshake error.
function (h: TlsClientHandshake) clientFindExt(exts: []Extension, t: int): Extension! {
  for e of exts {
    if (e.extType == t) {
      return e
    }
  }
  fail newError("tls client: server response is missing extension ${t}")
}

// Whether the client offered cipher suite `id`. `offeredSuites` (set by
// `tlsClientStartResume`, #1209) overrides the config-derived default when the
// resumption path offered a different set (the ticket's suite first).
function (h: TlsClientHandshake) clientOfferedSuite(id: int): bool {
  let suites = h.offeredSuites
  if (len(suites) == 0) {
    suites = h.config.suites
  }
  if (len(suites) == 0) {
    suites = clientDefaultSuites()
  }
  for s of suites {
    if (s == id) {
      return true
    }
  }
  return false
}

// Whether the client advertised group codepoint `cp` in supported_groups.
function (h: TlsClientHandshake) clientSupportsGroup(cp: int): bool {
  for g of h.config.groups {
    if (int(tlsGroupCodepoint(g)) == cp) {
      return true
    }
  }
  return false
}

// The offer whose group matches wire codepoint `cp`, or a failure if the server
// selected a group the client never shared.
function (h: TlsClientHandshake) clientOfferForCp(cp: int): clientOffer! {
  for o of h.offers {
    if (o.cp == cp) {
      return o
    }
  }
  fail newError("tls client: server selected a group the client did not offer")
}

// The server's chosen ALPN protocol from EncryptedExtensions, or "" if none.
function (h: TlsClientHandshake) clientPickAlpn(exts: []Extension): string {
  for e of exts {
    if (e.extType == extTypeALPN) {
      let names = parseALPN(e) catch err {
        return ""
      }
      if (len(names) > 0) {
        return names[0]
      }
    }
  }
  return ""
}

// The raw DER of each certificate in a Certificate message, end-entity first.
function clientCertDers(cert: Certificate): [][]byte {
  let out = [][]byte(0)
  for e of cert.entries {
    out = append(out, e.cert)
  }
  return out
}

// ---------------------------------------------------------------------------
// TlsClientConn: application data
// ---------------------------------------------------------------------------

// The negotiated cipher suite's IANA code point.
export function (c: TlsClientConn) cipherSuiteId(): int { return c.suite.id }

// The ALPN protocol the server selected, or "" if none was negotiated.
export function (c: TlsClientConn) alpnProtocol(): string { return c.alpn }

// The server's certificate chain as raw DER, end-entity certificate first.
export function (c: TlsClientConn) peerCertificates(): [][]byte { return c.peerCerts }

// The exporter_master_secret (RFC 8446 §7.5), the root for exported keying
// material bound to this handshake.
export function (c: TlsClientConn) exporterSecret(): []byte { return c.exporter }

// The resumption_master_secret (RFC 8446 §7.1), from which a server-issued
// ticket's PSK is computed.
export function (c: TlsClientConn) resumptionSecret(): []byte { return c.resumption }

// Seal `plaintext` as one outbound application_data record under the client's
// application-traffic key, advancing its sequence number. Fails if the fragment
// exceeds the 2^14 record limit.
export function (c: TlsClientConn) sealApp(plaintext: []byte): []byte! {
  return c.appWrite.seal(plaintext, recordApplicationData)?
}

// Open one inbound protected record under the server's application-traffic key,
// returning the recovered content and its inner type. A `recordHandshake` type is
// a post-handshake message (NewSessionTicket / KeyUpdate); `recordApplicationData`
// is caller data. Fails fatally on an authentication failure.
export function (c: TlsClientConn) openApp(record: []byte): RecordPlaintext! {
  return c.appRead.open(record)?
}
