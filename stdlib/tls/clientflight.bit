// Bit standard library — std/tls, driving the client handshake: process a
// server flight, authenticate the server, and the completed `TlsClientConn`
// application-data channel (split out of `client.bit`, #1503).

import { contains } from "std/strings"

// ---------------------------------------------------------------------------
// Drive: process a server flight
// ---------------------------------------------------------------------------

// Gather one complete server flight off the stream. The ServerHello is the first
// non-CCS record; a HelloRetryRequest ends the flight there, and so does a
// plaintext alert in that same slot (#2319) — a server that rejects the
// ClientHello before any handshake key exists (no ALPN protocol in common, an
// unsupported version, ...) sends its alert instead of a ServerHello and then
// closes, so waiting for more bytes there would misreport the alert as a
// mid-record truncation instead of ever handing it to the caller to decode.
// Otherwise the encrypted authentication flight follows, and the flight is
// complete once at least one encrypted record has been read and nothing more is
// buffered — the server has sent its whole flight and is now waiting for the
// client, so reading on would block. Bounded by a record budget.
fn tlsapiReadServerFlight(f: tlsapiFramer): []byte! {
  let flight = []byte(0)
  let sawHello = false
  let encCount = 0
  let guard = 0
  while (guard < 64) {
    guard = guard + 1
    let rec = f.nextRecord()?
    flight = tlsHsPutBytes(flight, rec)
    let t = tlsWireRecordType(rec)
    if (t == tlsCcsType) {
      continue
    }
    if (!sawHello) {
      sawHello = true
      if (t == recordAlert) {
        return flight
      }
      if (tlsapiIsHelloRetry(rec)) {
        return flight
      }
      continue
    }
    if (t == recordApplicationData) {
      encCount = encCount + 1
    }
    if (encCount >= 1 && !f.hasBuffered()) {
      return flight
    }
  }
  fail newError("tls: server flight exceeded the record bound")
}

// Whether a plaintext handshake record carries a HelloRetryRequest. A record
// that does not parse as a ServerHello is treated as "not a retry" so the state
// machine, not the framer, produces the precise error.
fn tlsapiIsHelloRetry(rec: []byte): bool {
  let sh = parseServerHello(tlsWireRecordBody(rec)) catch _ {
    return false
  }
  return isHelloRetryRequest(sh)
}

// Map an `x509VerifyChain` failure's message (`stdlib/crypto/x509chain.bit`) to
// the AlertDescription (RFC 8446 §6.2) this ticket's failure table specifies.
// Matched by the fixed substrings `x509chain.bit` itself uses, since std/crypto
// exports no structured reason code to switch on instead. Any x509 failure this
// table does not name (e.g. a path-length or critical-extension violation) still
// gets `bad_certificate`(42) — the general "a certificate was corrupt or did not
// verify" alert — rather than the client sending no alert at all.
fn clientAlertDescForX509(msg: string): int {
  if (contains(msg, "certificate has expired") || contains(msg, "is not yet valid")) {
    return alertCertificateExpired
  }
  if (contains(msg, "unable to build chain to a trusted root")) {
    return alertUnknownCa
  }
  return alertBadCertificate
}

// The server's leaf certificate, `h.peerCerts[0]` parsed on first use and kept
// in `h.leaf`: chain validation and the CertificateVerify check both need it,
// and one parse of a 2048-bit RSA leaf allocates about 57 KB (#7561).
fn clientLeaf(h: TlsClientHandshake): X509Certificate! {
  if (isSome(h.leaf)) {
    return unwrap(h.leaf)
  }
  let leaf = x509Parse(h.peerCerts[0])?
  h.leaf = Option.Some(leaf)
  return leaf
}

// One direction's handshake or early-data record keys, or a failure while
// they are unset: `TlsClientHandshake` builds none before its secret exists
// (#7561), so nothing is ever sealed or opened under placeholder keys.
fn clientKeys(keys: Option<RecordKeys>): RecordKeys! {
  if (isSome(keys)) {
    return unwrap(keys)
  }
  fail newError("tls client: record keys used before their secret was derived")
}

// Verify the peer certificate chain up to a trusted root and against the SNI
// hostname (RFC 8446 §4.4.2), delegating to the std/crypto X.509 verifier. Any
// failure aborts the handshake and is re-tagged with the AlertDescription
// (RFC 8446 §6.2, #2320) `tlsapiDriveClient` (`tls.bit`) sends the server before
// closing — std/crypto's `x509VerifyChain` is a different module and cannot tag
// its own errors with this module's `tlsAlertFail`, so the mapping is done here,
// on the caught error's message.
fn clientVerifyChain(h: TlsClientHandshake): ()! {
  let leaf = clientLeaf(h)?
  let inter = []X509Certificate(0)
  let i = 1
  while (i < len(h.peerCerts)) {
    inter = append(inter, x509Parse(h.peerCerts[i])?)
    i = i + 1
  }
  x509VerifyChain(
    leaf,
    inter,
    h.config.trust.roots,
    h.config.serverName,
    h.config.nowUnix,
  ) catch e {
    fail tlsAlertFail{ desc = clientAlertDescForX509(e.message()), msg = e.message() }
  }
}

// Verify the server's CertificateVerify signature over the RFC 8446 §4.4.3 signed
// content with the leaf certificate's public key. Fails on a bad signature,
// tagged `decrypt_error`(51) (RFC 8446 §6.2: a handshake cryptographic operation
// failed) — `tlsapiDriveClient` sends this AlertDescription to the server before
// closing (#2320).
fn clientVerifyCertVerify(h: TlsClientHandshake, cv: CertificateVerify): ()! {
  let leaf = clientLeaf(h)?
  let signed = tlsWireCertVerifyContent(tlsWireServerCertVerifyContext, h.clientTh())
  if (!clientCheckSignature(cv.algorithm, leaf, signed, cv.signature)) {
    fail tlsAlertFail{
      desc = alertDecryptError,
      msg = "tls client: server CertificateVerify signature is invalid",
    }
  }
}

// Whether `sig` is a valid signature of `signed` under `leaf`'s public key for
// SignatureScheme `alg`. Dispatches on the scheme, pins the expected public-key
// type, and treats any malformed key or signature as an invalid signature rather
// than raising — a verification predicate must not fail open.
fn clientCheckSignature(alg: int, leaf: X509Certificate, signed: []byte, sig: []byte): bool {
  if (alg == sigEcdsaSecp256r1Sha256) {
    return clientVerifyEcdsa(leaf, nistecP256(), digest(Sha256(), signed), sig)
  }
  if (alg == sigEcdsaSecp384r1Sha384) {
    return clientVerifyEcdsa(leaf, nistecP384(), digest(HashAlg.Sha384.make(), signed), sig)
  }
  if (alg == sigRsaPssRsaeSha256) {
    return clientVerifyRsaPss(leaf, HashAlg.Sha256, signed, sig, 32)
  }
  if (alg == sigRsaPssRsaeSha384) {
    return clientVerifyRsaPss(leaf, HashAlg.Sha384, signed, sig, 48)
  }
  if (alg == sigRsaPssRsaeSha512) {
    return clientVerifyRsaPss(leaf, HashAlg.Sha512, signed, sig, 64)
  }
  if (alg == sigEd25519) {
    if (leaf.pubKeyAlg != x509KeyEd25519) {
      return false
    }
    return ed25519Verify(leaf.pubKeyBytes, signed, sig)
  }
  return false
}

// ECDSA CertificateVerify: decode the leaf's SEC 1 point on `curve`, parse the
// DER signature, and verify over the pre-hashed message. False on any mismatch.
fn clientVerifyEcdsa(leaf: X509Certificate, curve: Curve, hash: []byte, sig: []byte): bool {
  if (leaf.pubKeyAlg != x509KeyECDSA) {
    return false
  }
  let pub = ecdsaPublicKey(curve, leaf.pubKeyBytes) catch _ {
    return false
  }
  let parsed = ecdsaSignatureFromDer(sig) catch _ {
    return false
  }
  return ecdsaVerify(pub, hash, parsed)
}

// RSASSA-PSS CertificateVerify: parse the leaf's PKCS#1 public key and verify the
// signature over `signed` with `alg`/`saltLen` (MGF1 over the same hash).
fn clientVerifyRsaPss(
  leaf: X509Certificate,
  alg: HashAlg,
  signed: []byte,
  sig: []byte,
  saltLen: int,
): bool {
  if (leaf.pubKeyAlg != x509KeyRSA) {
    return false
  }
  let pub = rsaParsePkcs1PublicKey(leaf.pubKeyBytes) catch _ {
    return false
  }
  return rsaVerifyPss(pub, alg, signed, sig, saltLen)
}

// ---------------------------------------------------------------------------
// Small lookups over the handshake state
// ---------------------------------------------------------------------------

// The client's answer to a CertificateRequest when no client certificate is
// configured (RFC 8446 §4.4.2): a Certificate message with an empty
// certificate_list, echoing the request's `certificate_request_context`. No
// CertificateVerify follows it — there is no key to sign the transcript with —
// and whether an unauthenticated client is acceptable is the server's call.
fn clientEmptyCertificate(ctx: []byte): []byte {
  return encodeCertificate(
    Certificate{ certRequestContext = ctx, entries = []CertificateEntry(0) },
  )
}

// The raw DER of each certificate in a Certificate message, end-entity first.
fn clientCertDers(cert: Certificate): [][]byte {
  let out = [][]byte(0)
  for e of cert.entries {
    out = append(out, e.cert)
  }
  return out
}

// ---------------------------------------------------------------------------
// TlsClientConn: application data
// ---------------------------------------------------------------------------

