// stdlib/tls/certrequest.test.bit — optional client authentication seen from the
// client (#4953). A TLS 1.3 server may send a CertificateRequest (handshake type
// 13, RFC 8446 §4.3.2) between EncryptedExtensions and Certificate whenever
// client authentication is optional; MySQL 8.4 and MariaDB 11.4 both do. The
// client must hash it like any other handshake message and answer with an empty
// Certificate — no CertificateVerify — when it has no certificate configured.
//
// The server flight is scripted, because std/tls's own server never asks for a
// client certificate, but nothing in it is faked: the ServerHello,
// EncryptedExtensions and Certificate come from a real `tlsServerStart` handshake
// via `processClientHelloMessage`, and CertificateVerify and Finished are
// recomputed with that same handshake's key schedule and private key over the
// transcript the CertificateRequest was spliced into. A client that dropped the
// CertificateRequest from its transcript would fail the server's signature here,
// and the client Finished MAC asserted below — the one a server computes over the
// transcript through the client's Certificate — would not match either.
//
// std/tls is one flat module, so the codecs, the key schedule, `clientSha256` and
// the handshake state are siblings; only what no sibling imports appears below.

import { decodeHex, pemEncode } from "std/crypto"

// The throwaway test leaf and its RSA key (SAN: localhost, example.com), the
// fixture `stdlib/smtp/tls.test.bit` and `_tests_/imports/tlsclient` also use.
const creqLeafHex: string = ""
const creqKeyHex: string = ""

// A PEM block from one of the hex fixtures above. A decode failure yields an
// empty string, which fails `newTlsServerConfig` loudly rather than quietly
// configuring half a server.
fn creqPem(label: string, h: string): string {
  let b = decodeHex(h) catch _ {
    return ""
  }
  return pemEncode(label, b)
}

// What one scripted handshake produced: the client's answering flight, the
// transcript through the server Finished, and the secret a server would key the
// client Finished MAC with.
class creqRun {
  flight: []byte,
  transcript: []byte,
  chs: []byte,
  appSecret: []byte,
}

// The client configuration: pinned to TLS_AES_128_GCM_SHA256 so the transcript
// hash is SHA-256, and with chain + hostname verification off — the fixture leaf
// chains to a CA no trust store here holds. The CertificateVerify signature and
// the Finished MAC are still verified, which is what this test rests on.
fn creqClientConfig(): TlsClientConfig {
  return TlsClientConfig{
    serverName: "localhost",
    alpn: []string(0),
    trust: TrustStore{ roots: []X509Certificate(0) },
    insecureSkipVerify: true,
    nowUnix: 1800000000,
    groups: [TlsGroup.X25519],
    keyShareGroups: []TlsGroup(0),
    suites: [TLS_AES_128_GCM_SHA256],
    clientHelloOverride: []byte(0),
    ephemeralOverride: []GroupKeypair(0),
  }
}

// Drive one handshake whose server flight carries a CertificateRequest, at the
// handshake-message level (the QUIC entry points, which skip record framing —
// record mode seals exactly these bytes).
fn creqDrive(): creqRun! {
  let scfg = newTlsServerConfig(
    creqPem("CERTIFICATE", creqLeafHex),
    creqPem("PRIVATE KEY", creqKeyHex),
    []string(0),
  )?
  let s = tlsServerStart(scfg)?
  let c = tlsClientStart(creqClientConfig())?
  // A copy: `clientHelloMessage` hands out the handshake's own ClientHello slice,
  // and `tlsHsPutBytes` grows its `dst` in place below (#4959 made the client's
  // own transcript a separate buffer; this side of the aliasing is on the caller).
  let chMsg = tlsHsCopyBytes(c.clientHelloMessage())
  let fl = s.processClientHelloMessage(chMsg)?
  let resent = c.processServerHelloMessage(fl.serverHello)?
  if (len(resent) > 0) {
    fail newError("the server sent a HelloRetryRequest")
  }
  let msgs = tlsWireSplitHandshakes(fl.handshake)?
  if (len(msgs) != 4) {
    fail newError("server flight has ${len(msgs)} messages, want 4")
  }

  // ClientHello .. EncryptedExtensions, CertificateRequest, Certificate.
  let creq = encodeCertificateRequest(
    CertificateRequest{
      certRequestContext: []byte(0),
      extensions: [extSignatureAlgorithms([sigRsaPssRsaeSha256])],
    },
  )
  let th = tlsHsPutBytes(chMsg, fl.serverHello)
  th = tlsHsPutBytes(th, msgs[0])
  th = tlsHsPutBytes(th, creq)
  th = tlsHsPutBytes(th, msgs[1])

  // CertificateVerify and Finished over the spliced transcript, with the server
  // handshake's own key and handshake-traffic secret.
  let signed = tlsWireCertVerifyContent(
    tlsWireServerCertVerifyContext,
    digest(clientSha256(), th),
  )
  let cv = encodeCertificateVerify(
    CertificateVerify{
      algorithm: sigRsaPssRsaeSha256,
      signature: rsaSignPss(scfg.key, clientSha256, signed, 32)?,
    },
  )
  th = tlsHsPutBytes(th, cv)
  let fin = encodeFinished(
    Finished{ verifyData: finishedMac(clientSha256, s.shs, digest(clientSha256(), th)) },
  )
  th = tlsHsPutBytes(th, fin)

  let stream = tlsHsPutBytes(tlsHsCopyBytes(msgs[0]), creq)
  stream = tlsHsPutBytes(stream, msgs[1])
  stream = tlsHsPutBytes(stream, cv)
  stream = tlsHsPutBytes(stream, fin)
  let flight = c.clientReadHandshake(stream)?
  return creqRun{
    flight: flight,
    transcript: th,
    chs: s.chs,
    appSecret: c.clientApplicationSecret(),
  }
}

test "a CertificateRequest is answered with an empty Certificate and hashed" {
  let r = creqDrive() catch e {
    assert(false, "the handshake failed: ${e.message()}")
    return
  }
  let msgs = tlsWireSplitHandshakes(r.flight) catch e {
    assert(false, "the client flight does not split into messages: ${e.message()}")
    return
  }
  if (len(msgs) != 2) {
    assert(false, "client flight has ${len(msgs)} messages, want Certificate + Finished")
    return
  }
  let cert = parseCertificate(msgs[0]) catch e {
    assert(false, "the first message is not a Certificate: ${e.message()}")
    return
  }
  assert(len(cert.entries) == 0, "the client presented ${len(cert.entries)} certificate(s)")
  assert(len(cert.certRequestContext) == 0, "certificate_request_context was not echoed")
  let fin = parseFinished(msgs[1]) catch e {
    assert(false, "the second message is not a Finished: ${e.message()}")
    return
  }
  // The MAC a server computes over ClientHello .. the client's Certificate: it
  // matches only if the client hashed the CertificateRequest too.
  let th = tlsHsPutBytes(tlsHsCopyBytes(r.transcript), msgs[0])
  let want = finishedMac(clientSha256, r.chs, digest(clientSha256(), th))
  assert(
    ctEq(fin.verifyData, want),
    "the client Finished MAC does not cover the CertificateRequest",
  )
  assert(len(r.appSecret) == 32, "no application-traffic secret: the handshake did not complete")
}
