// stdlib/tls/handshakeerror.test.bit — a failed client handshake says which
// kind of failure it was (#6983): the peer's identity was not proven
// (Verification), the two sides could not agree (Negotiation), or the transport
// failed under the handshake (Io).
//
// Each case drives a real `dial` against an in-process server. The Verification
// server is this module's own `listen` with the fixture leaf, which chains to a
// CA the client's (empty) trust store does not hold; the other two are raw
// `std/net` sockets that read the ClientHello and then misbehave on purpose.
// Nothing here waits on a clock.
//
// `creqPem`, `creqLeafHex`, `creqKeyHex`, `tlsapiTcpListen` and `NetListener`
// are siblings (std/tls is one flat module), so nothing is imported.

// Serve one raw connection: read what the client sent, answer with `reply`
// (empty means nothing), then close.
fn herrRawServer(ln: NetListener, reply: string) {
  let c = ln.accept() catch _ {
    return
  }
  let hello = c.read(65536)
  if (len(hello) > 0 && len(reply) > 0) {
    c.write(reply) catch _ {
      c.close()
      return
    }
  }
  c.close()
}

// Dial a raw server that answers `reply`; the handshake error it draws.
fn herrRawDial(reply: string): HandshakeError {
  let ln = tlsapiTcpListen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return HandshakeError{ kind = HandshakeFailure.Io, msg = "" }
  }
  let port = ln.port() catch _ {
    return HandshakeError{ kind = HandshakeFailure.Io, msg = "" }
  }
  spawn herrRawServer(ln, reply)
  let cfg = TlsConfig(emptyTrustStore(), nowUnix = 1800000000)
  let c = dial("127.0.0.1", port, cfg) catch e {
    ln.close()
    let (h, ok) = e.(HandshakeError)
    assert(ok, "the failure is not a HandshakeError: ${e.message()}")
    return h
  }
  c.close()
  ln.close()
  assert(false, "the handshake succeeded against a raw socket")
  return HandshakeError{ kind = HandshakeFailure.Io, msg = "" }
}

test "a peer that closes mid-handshake is an Io failure" {
  let h = herrRawDial("")
  assert(h.kind == HandshakeFailure.Io, "close mid-handshake: ${h.message()}")
}

test "a peer that closes half way through a record is an Io failure" {
  let h = herrRawDial("\x16\x03\x03\x00\x7a\x02\x00")
  assert(h.kind == HandshakeFailure.Io, "short record: ${h.message()}")
}

test "a fatal handshake_failure alert from the peer is a Negotiation failure" {
  let h = herrRawDial("\x15\x03\x03\x00\x02\x02\x28")
  assert(h.kind == HandshakeFailure.Negotiation, "alert: ${h.message()}")
  assert(contains(h.message(), "handshake_failure"), "the message lost the alert: ${h.message()}")
}

test "bytes that are not TLS are a Negotiation failure" {
  let h = herrRawDial("HTTP/1.1 400 Bad Request\r\n\r\n")
  assert(h.kind == HandshakeFailure.Negotiation, "plain HTTP reply: ${h.message()}")
}

test "a certificate that chains to no trusted root is a Verification failure" {
  let sc = TlsServerConfig(
    creqPem("CERTIFICATE", creqLeafHex),
    creqPem("PRIVATE KEY", creqKeyHex),
    []string(0),
  ) catch e {
    assert(false, "server config: ${e.message()}")
    return
  }
  let ln = listen("127.0.0.1", 0, sc) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = ln.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  spawn herrTlsServer(ln)
  let cfg = TlsConfig(emptyTrustStore(), serverName = "localhost", nowUnix = 1800000000)
  let c = dial("127.0.0.1", port, cfg) catch e {
    ln.close()
    let (h, ok) = e.(HandshakeError)
    assert(ok, "the failure is not a HandshakeError: ${e.message()}")
    assert(h.kind == HandshakeFailure.Verification, "untrusted chain: ${h.message()}")
    return
  }
  c.close()
  ln.close()
  assert(false, "dial accepted a certificate no trust anchor vouches for")
}

// Accept one TLS connection and run its handshake; the client is the one under
// test, so the server's own outcome is ignored.
fn herrTlsServer(ln: TlsListener) {
  let c = ln.accept() catch _ {
    return
  }
  c.handshake() catch _ {
    c.close()
    return
  }
  c.close()
}
