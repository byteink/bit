// Bit standard library — std/tls, the TLS 1.3 server handshake (RFC 8446, #1207).
//
// The mirror of `client.bit`: a sans-I/O 1-RTT server handshake state machine the
// caller drives by shuttling flights of raw record bytes.
//
//   let s = tlsServerStart(config)
//   let step = s.processClientHello(recv())?
//   while (step.retry) {                 // sent a HelloRetryRequest
//     send(step.outbound)
//     step = s.processClientHello(recv())?
//   }
//   send(step.outbound)                  // ServerHello + encrypted flight
//   let conn = s.processClientFinished(recv())?
//
// The server negotiates a cipher suite and a named group from the ClientHello,
// answering with a ServerHello key_share (or a HelloRetryRequest when the client
// shared no acceptable group). It then sends its authentication flight under the
// handshake-traffic key — EncryptedExtensions, its Certificate chain, a
// CertificateVerify signed over the RFC 8446 §4.4.3 signed content with the
// server's private key, and its Finished — and finally verifies the client
// Finished MAC in constant time before switching to application-traffic keys.
//
// The certificate chain and RSA private key are loaded from PEM by
// `newTlsServerConfig`. The server signs CertificateVerify with RSA-PSS
// (rsa_pss_rsae_sha256); the client half verifies ECDSA, Ed25519, and RSA-PSS, so
// the pair interoperates with any conformant peer for verification. std/tls is one
// flat module, so this file shares `client.bit`'s `tlsWire*` record framing and
// the `handshake.bit` framing helpers, and reuses the module-wide `randomBytes`
// and `ctEq` imported by `client.bit`. Its own std/crypto imports (the RSA signer
// and key parsers) are those no sibling already imports. Private free functions
// are prefixed `srv`.
//
// Since #2969 the server is spread over siblings, mirroring the client split: this
// file holds the configuration, the handshake/connection types, and
// `tlsServerStart*` — building the initial handshake state. `serverflight.bit`
// holds `processClientHello`/`processClientFinished` and the negotiation, flight
// building, and CertificateVerify signing they drive, plus the `TlsServerConn`
// application-data accessors. `serverquic.bit` holds the QUIC-TLS entry points
// that bypass record framing.

import { RsaPrivateKey, rsaParsePrivateKey, rsaParsePkcs1PrivateKey, rsaSignPss } from "std/crypto"
import { PemBlock } from "std/crypto"

// ---------------------------------------------------------------------------
// Configuration
// ---------------------------------------------------------------------------

// A server handshake configuration: the certificate `chain` (raw DER, end-entity
// certificate first), the RSA private `key` matching the leaf, the ALPN protocols
// the server supports (preference order), the acceptable key-exchange `groups`
// (preference order), and the acceptable cipher `suites` (preference order).
// Build one from PEM with `newTlsServerConfig`.
export class TlsServerConfig {
  export chain: [][]byte,
  export key: RsaPrivateKey,
  export alpn: []string,
  export groups: []TlsGroup,
  export suites: []int,
  // Session resumption (#1209): the server-lifetime ticket store
  // `TlsServerHandshake.processClientHello` looks tickets up in and
  // `TlsServerConn.issueTicket` writes into. Shared across every handshake run
  // from this config — `newTlsServerConfig` gives each config its own store.
  export tickets: TlsTicketStore,
  // Whether this server accepts 0-RTT early data on a resumed handshake
  // (RFC 8446 §2.3, §4.6.1). Off does not disable resumption itself — only
  // early data; a PSK-DHE handshake still skips Certificate/CertificateVerify.
  export allowEarlyData: bool,
}

// The server's default group preference: the post-quantum hybrid first, then the
// classical curves. A group is only used when the client actually shares it, so
// listing the hybrid first simply prefers it when present.
fn srvDefaultGroups(): []TlsGroup {
  return [TlsGroup.X25519MLKEM768, TlsGroup.X25519, TlsGroup.Secp256r1, TlsGroup.Secp384r1]
}

// The server's default cipher-suite preference, strongest first.
fn srvDefaultSuites(): []int {
  return [TLS_AES_256_GCM_SHA384, TLS_CHACHA20_POLY1305_SHA256, TLS_AES_128_GCM_SHA256]
}

// A `TlsServerConfig` from PEM: `certChainPem` is one or more concatenated
// `CERTIFICATE` blocks (end-entity certificate first), `keyPem` is the leaf's RSA
// private key as a `PRIVATE KEY` (PKCS#8) or `RSA PRIVATE KEY` (PKCS#1) block, and
// `alpn` is the supported protocol list. Fails on malformed PEM, an empty chain,
// or a private key this parser cannot read. Groups and suites default to the full
// supported sets.
export fn newTlsServerConfig(
  certChainPem: string,
  keyPem: string,
  alpn: []string,
): TlsServerConfig! {
  let certBlocks = pemDecode(certChainPem)?
  let chain = [][]byte(0)
  for b of certBlocks {
    if (b.label == "CERTIFICATE") {
      chain = append(chain, b.der)
    }
  }
  if (len(chain) == 0) {
    fail newError("tls server: certificate chain has no CERTIFICATE blocks")
  }
  let keyBlocks = pemDecode(keyPem)?
  let key = srvParsePrivateKey(keyBlocks[0])?
  return TlsServerConfig{
    chain: chain,
    key: key,
    alpn: alpn,
    groups: srvDefaultGroups(),
    suites: srvDefaultSuites(),
    tickets: newTicketStore(),
    allowEarlyData: true,
  }
}

// Parse an RSA private key from a PEM block, dispatching on its label: PKCS#8
// (`PRIVATE KEY`) or PKCS#1 (`RSA PRIVATE KEY`). Fails on any other label.
fn srvParsePrivateKey(block: PemBlock): RsaPrivateKey! {
  if (block.label == "PRIVATE KEY") {
    return rsaParsePrivateKey(block.der)?
  }
  if (block.label == "RSA PRIVATE KEY") {
    return rsaParsePkcs1PrivateKey(block.der)?
  }
  fail newError("tls server: unsupported private-key PEM label ${block.label}")
}

// ---------------------------------------------------------------------------
// Handshake state and results
// ---------------------------------------------------------------------------

// One step of the server handshake from `processClientHello`. `retry` means a
// HelloRetryRequest was produced; send `outbound` and feed the next ClientHello
// back in. Otherwise `outbound` is the ServerHello plus the encrypted
// authentication flight, after which `processClientFinished` completes the
// handshake.
export class TlsServerStep { export retry: bool, export outbound: []byte }

// A completed server connection: the negotiated parameters and the two
// application-data record contexts. Obtain it from `processClientFinished`.
export class TlsServerConn {
  suite: CipherSuite,
  alpn: string,
  appWrite: RecordKeys,
  appRead: RecordKeys,
  exporter: []byte,
  resumption: []byte,
  // Session resumption (#1209): carried from `TlsServerConfig` so `issueTicket`
  // needs no arguments — the store and the early-data policy travel with the
  // connection they came from.
  tickets: TlsTicketStore,
  allowEarlyData: bool,
}

// The in-progress server handshake state. Drive it with `processClientHello` then
// `processClientFinished`; all fields are internal.
export class TlsServerHandshake {
  config: TlsServerConfig,
  transcript: []byte,
  ch1: []byte,
  suite: CipherSuite,
  usedHrr: bool,
  shared: []byte,
  chs: []byte,
  shs: []byte,
  serverReadKeys: RecordKeys,
  // The record-write keys under `shs`, set for real by `srvSendServerFlight`
  // the moment it actually seals the auth flight with them — placeholder
  // `dummy` (same as `serverReadKeys`/`earlyReadKeys`) until then. A
  // post-flight fail-and-close alert (#2955) reuses this SAME object rather
  // than re-deriving one from `shs`, so its sequence number continues from
  // the auth flight's rather than restarting at an already-spent nonce.
  hsWriteKeys: RecordKeys,
  master: []byte,
  sapSecret: []byte,
  capSecret: []byte,
  exporterSec: []byte,
  alpn: string,
  connected: bool,
  extraEEExts: []Extension,
  // Session resumption / 0-RTT (#1209): set by `srvTryPsk` while processing the
  // ClientHello. `earlyReadKeys` is only valid when `earlyDataAccepted`.
  pskAccepted: bool,
  pskEarly: []byte,
  earlyDataAccepted: bool,
  earlyReadKeys: RecordKeys,
  earlyData: []byte,
}

// SHA-256 exposed as a `() => Hash` for the RSA-PSS signer.
fn srvSha256(): Hash { return newSha256() }

// The suite hash as a `() => Hash` for the key schedule.
fn (s: TlsServerHandshake) srvNewHash(): Hash { return tlsSuiteNewHash(s.suite) }

// The transcript hash of the messages absorbed so far, under the negotiated suite.
fn (s: TlsServerHandshake) srvTh(): []byte {
  return digest(tlsSuiteNewHash(s.suite), s.transcript)
}

// Start a server handshake. The returned state produces no output until the first
// ClientHello is fed to `processClientHello`.
export fn tlsServerStart(config: TlsServerConfig): TlsServerHandshake! {
  return tlsServerStartExts(config, []Extension(0))?
}

// Start a server handshake exactly like `tlsServerStart`, but add `extraExts` to
// the EncryptedExtensions the server sends. The QUIC record-bypass path (RFC
// 9001) uses this to carry the `quic_transport_parameters` extension; with an
// empty `extraExts` it is byte-for-byte `tlsServerStart`.
export fn tlsServerStartExts(config: TlsServerConfig, extraExts: []Extension): TlsServerHandshake! {
  let aes128 = tlsSuiteById(TLS_AES_128_GCM_SHA256)?
  let dummy = newRecordKeys(aes128, []byte(32))?
  return TlsServerHandshake{
    config: config,
    transcript: []byte(0),
    ch1: []byte(0),
    suite: aes128,
    usedHrr: false,
    shared: []byte(0),
    chs: []byte(0),
    shs: []byte(0),
    serverReadKeys: dummy,
    hsWriteKeys: dummy,
    master: []byte(0),
    sapSecret: []byte(0),
    capSecret: []byte(0),
    exporterSec: []byte(0),
    alpn: "",
    connected: false,
    extraEEExts: extraExts,
    pskAccepted: false,
    pskEarly: []byte(0),
    earlyDataAccepted: false,
    earlyReadKeys: dummy,
    earlyData: []byte(0),
  }
}

