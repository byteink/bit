// The byte-level primitives `./handshake.bit`'s message codecs are built from:
// a read cursor (`tlsHsReader`) and the big-endian, length-checked readers and
// writers every message and extension threads through. Sibling of
// `./handshake.bit`, same module (SPEC §17.1) — `Extension`/`ClientHello`/etc.
// and every other declaration `./handshake.bit` makes is visible here with no
// import, the same arrangement the rest of this module's files use. Split out
// to keep `./handshake.bit` under `tests/bit/lintfilelines.bit`'s 800-line gate
// (E0200); this seam is pure bit-manipulation with no dependency on anything
// declared later in the module, so there is no ordering question, only a
// diagnostic-order one the differentials would catch.
//
// Decoding is strict, because a handshake parser faces hostile input: every
// reader is fallible (`T!`), a declared length that runs past the buffer fails,
// and `tlsHsExpectEnd` rejects trailing bytes rather than best-guessing.

// A read cursor over a byte buffer. A class is a reference type (§13.3), so a
// helper that advances `pos` advances it for its caller — that is what threads
// one position through the field-by-field decode without an out-parameter.
class tlsHsReader { data: []byte, pos: int }

// --- low-level readers (big-endian, length-checked) -------------------------

// Read one octet, failing at end of input.
fn tlsHsGetU8(r: tlsHsReader): int! {
  if (r.pos >= len(r.data)) {
    fail newError("tls: unexpected end of input")
  }
  let b = r.data[r.pos]
  r.pos = r.pos + 1
  return int(b)
}

// Read a big-endian uint16.
fn tlsHsGetU16(r: tlsHsReader): int! {
  let hi = tlsHsGetU8(r)?
  let lo = tlsHsGetU8(r)?
  return (hi << 8) | lo
}

// Read a big-endian uint24.
fn tlsHsGetU24(r: tlsHsReader): int! {
  let a = tlsHsGetU8(r)?
  let b = tlsHsGetU8(r)?
  let c = tlsHsGetU8(r)?
  return (a << 16) | (b << 8) | c
}

// Read a big-endian uint32.
fn tlsHsGetU32(r: tlsHsReader): int! {
  let a = tlsHsGetU8(r)?
  let b = tlsHsGetU8(r)?
  let c = tlsHsGetU8(r)?
  let d = tlsHsGetU8(r)?
  return (a << 24) | (b << 16) | (c << 8) | d
}

// Take the next `n` octets as a view, failing if fewer remain.
fn tlsHsGetBytes(r: tlsHsReader, n: int): []byte! {
  if (n < 0 || r.pos + n > len(r.data)) {
    fail newError("tls: declared length runs past end of input")
  }
  let out = r.data[r.pos:r.pos + n]
  r.pos = r.pos + n
  return out
}

// Read a vector with a one-byte length prefix.
fn tlsHsGetVec8(r: tlsHsReader): []byte! {
  let n = tlsHsGetU8(r)?
  return tlsHsGetBytes(r, n)?
}

// Read a vector with a two-byte length prefix.
fn tlsHsGetVec16(r: tlsHsReader): []byte! {
  let n = tlsHsGetU16(r)?
  return tlsHsGetBytes(r, n)?
}

// Read a vector with a three-byte length prefix.
fn tlsHsGetVec24(r: tlsHsReader): []byte! {
  let n = tlsHsGetU24(r)?
  return tlsHsGetBytes(r, n)?
}

// Fail unless the cursor sits exactly at the end of its buffer — the check that
// rejects trailing garbage after a fully parsed structure.
fn tlsHsExpectEnd(r: tlsHsReader): ()! {
  if (r.pos != len(r.data)) {
    fail newError("tls: trailing bytes after handshake structure")
  }
}

// The uint16 list `b` spells, failing on an odd length. Cipher suites, groups,
// and signature schemes are all encoded this way.
fn tlsHsParseU16List(b: []byte): []int! {
  if (len(b) % 2 != 0) {
    fail newError("tls: uint16 list has an odd length")
  }
  let out = []int(0)
  let r = tlsHsReader{ data: b, pos: 0 }
  let n = len(b) / 2
  let i = 0
  while (i < n) {
    out = append(out, tlsHsGetU16(r)?)
    i = i + 1
  }
  return out
}

// --- low-level writers (append onto a caller-owned, freshly built slice) -----

// Append a uint8.
// bit:lint allow E0214 -- unexported, no caller retains the pre-call slice: call sites pass a fresh []byte(0), reassign to the same binding, or (tlsHsPutVec8) bind dst once and never reference it again
fn tlsHsPutU8(dst: []byte, v: int): []byte { return append(dst, byte(v & 0xff)) }

// Append a big-endian uint16.
fn tlsHsPutU16(dst: []byte, v: int): []byte {
  // bit:lint allow E0214 -- unexported, no caller retains the pre-call slice: call sites pass a fresh []byte(0), reassign to the same binding, or (tlsHsPutVec16) bind dst once and never reference it again
  let out = append(dst, byte((v >> 8) & 0xff))
  return append(out, byte(v & 0xff))
}

// Append a big-endian uint24.
fn tlsHsPutU24(dst: []byte, v: int): []byte {
  // bit:lint allow E0214 -- unexported, no caller retains the pre-call slice: one call site reassigns to the same binding, the other (tlsHsPutVec24) binds dst once and never references it again
  let out = append(dst, byte((v >> 16) & 0xff))
  out = append(out, byte((v >> 8) & 0xff))
  return append(out, byte(v & 0xff))
}

// Append a big-endian uint32.
fn tlsHsPutU32(dst: []byte, v: int): []byte {
  // bit:lint allow E0214 -- unexported, no caller retains the pre-call slice: call sites pass a fresh []byte(0) or reassign to the same binding
  let out = append(dst, byte((v >> 24) & 0xff))
  out = append(out, byte((v >> 16) & 0xff))
  out = append(out, byte((v >> 8) & 0xff))
  return append(out, byte(v & 0xff))
}

// Append every byte of `src`.
fn tlsHsPutBytes(dst: []byte, src: []byte): []byte {
  let out = dst
  for x of src {
    // bit:lint allow E0214 -- unexported; verified: all 39 call sites (40 occurrences, one line nests two) across handshakewire/handshake/wire/tls/serverflight/clientflight/resume.bit return the result directly, reassign the same field/variable, or pass a freshly computed single-use slice; s.transcript/s.ch1/h.ch1 are themselves copied (tlsHsCopyBytes) before a caller-owned view can ever reach dst here (#3208)
    out = append(out, x)
  }
  return out
}

// A fresh copy of `src`, so a handshake message stored into `ch1`/`transcript`
// (later grown by `tlsHsPutBytes`) never aliases memory the caller supplied and
// may still own — a QUIC `CryptoAssembler`'s own reassembly buffer
// (`std/quic`'s `CryptoAssembler.contiguous()`, which returns a view, not a
// copy) or a `TlsClientConfig.clientHelloOverride` the caller retains. Without
// this, growing the transcript in place can corrupt that caller-owned memory
// (#3208).
fn tlsHsCopyBytes(src: []byte): []byte {
  let out = []byte(len(src))
  let i = 0
  while (i < len(src)) {
    out[i] = src[i]
    i = i + 1
  }
  return out
}

// Append `body` behind a one-byte length prefix.
fn tlsHsPutVec8(dst: []byte, body: []byte): []byte {
  let out = tlsHsPutU8(dst, len(body))
  return tlsHsPutBytes(out, body)
}

// Append `body` behind a two-byte length prefix.
fn tlsHsPutVec16(dst: []byte, body: []byte): []byte {
  let out = tlsHsPutU16(dst, len(body))
  return tlsHsPutBytes(out, body)
}

// Append `body` behind a three-byte length prefix.
fn tlsHsPutVec24(dst: []byte, body: []byte): []byte {
  let out = tlsHsPutU24(dst, len(body))
  return tlsHsPutBytes(out, body)
}
