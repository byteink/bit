// stdlib/quic/streambuf.test.bit — STREAM reassembly (streambuf.bit, #7735): bytes
// arriving out of order become readable once the gap fills, a resent byte must
// not change, bytes below the delivered point are dropped, and what the buffer
// holds stays bounded by what is undelivered however long the stream runs.
// `quicconnNewStreamBuf`, `quicconnBufInsert`, `quicconnBufCopy` and
// `quicconnBufRelease` are module siblings.

// `n` bytes whose values follow their stream offset, starting at `offset`.
fn qsbBytes(offset: int, n: int): []byte {
  let out = []byte(n)
  let i = 0
  while (i < n) {
    out[i] = byte((offset + i) % 251)
    i = i + 1
  }
  return out
}

fn qsbInsert(b: quicconnStreamBuf, offset: int, n: int) {
  quicconnBufInsert(b, offset, qsbBytes(offset, n)) catch e {
    assert(false, "insert at ${offset}: ${e.message()}")
  }
}

// Whether inserting `frag` at `offset` fails.
fn qsbRefused(b: quicconnStreamBuf, offset: int, frag: []byte): bool {
  quicconnBufInsert(b, offset, frag) catch _ {
    return true
  }
  return false
}

test "a gap holds back the bytes after it until it fills" {
  let b = quicconnNewStreamBuf(1 << 16)
  qsbInsert(b, 100, 50)
  assert(b.readable == 0, "readable ${b.readable} before offset 0 arrived")
  qsbInsert(b, 0, 100)
  assert(b.readable == 150, "readable ${b.readable} after the gap filled")
  let got = quicconnBufCopy(b, 0, 150)
  let want = qsbBytes(0, 150)
  let i = 0
  while (i < 150) {
    assert(got[i] == want[i], "byte ${i}")
    i = i + 1
  }
}

test "a resent byte must carry the same value, and bytes already delivered are dropped" {
  let b = quicconnNewStreamBuf(1 << 16)
  qsbInsert(b, 0, 100)
  quicconnBufRelease(b, 100)
  let changed = qsbBytes(0, 100)
  changed[10] = changed[10] ^ 1
  assert(!qsbRefused(b, 0, changed), "a resend wholly below the delivered point was checked")
  qsbInsert(b, 90, 20)
  assert(b.readable == 110, "readable ${b.readable}")
  let bad = qsbBytes(105, 5)
  bad[0] = bad[0] ^ 1
  assert(qsbRefused(b, 105, bad), "a changed byte at offset 105 was accepted")
}

test "a long stream holds only what is undelivered, past the old 16 MiB ceiling" {
  let b = quicconnNewStreamBuf(1 << 16)
  let frame = 1 << 15
  let off = 0
  while (off < (1 << 24) + 4 * frame) {
    qsbInsert(b, off, frame)
    let got = quicconnBufCopy(b, off, off + frame)
    assert(got[frame - 1] == byte((off + frame - 1) % 251), "last byte of the frame at ${off}")
    quicconnBufRelease(b, off + frame)
    off = off + frame
    assert(len(b.data) <= 2 * frame, "holding ${len(b.data)} bytes at offset ${off}")
  }
  assert(b.base == off && b.readable == off, "base ${b.base}, readable ${b.readable}")
}

test "data past the window is refused" {
  let b = quicconnNewStreamBuf(1000)
  qsbInsert(b, 0, 1000)
  assert(qsbRefused(b, 1000, qsbBytes(1000, 1)), "byte 1000 accepted with nothing released")
  quicconnBufRelease(b, 500)
  qsbInsert(b, 1000, 500)
  assert(b.readable == 1500, "readable ${b.readable}")
}
