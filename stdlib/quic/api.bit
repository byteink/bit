// Bit standard library — quic module, the public QUIC API.
//
// Split out of `conn.bit` (#1503) to keep files readable; `stdlib/quic` is one
// flat module, so this file shares that file's imports and namespace.

// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------

// The client TLS config for a QUIC handshake: TLS 1.3 with AES-128-GCM +
// X25519, matching `packet.bit`'s AEAD and this module's key length. Trust
// and `insecureSkipVerify` come from the caller's `TlsConfig` (`dialQuic`
// supplies a secure default, `dialQuicTls` an explicit one); `nowUnix`
// defaults to the current time exactly as `std/tls`'s own `dial` does, since
// an unresolved 0 would fail every certificate's validity check outright.
fn quicconnClientTlsConfig(serverName: string, config: TlsConfig): TlsClientConfig {
  let ts = config.nowUnix
  if (ts == 0) {
    ts = quicconnNow().ns / 1000000000
  }
  return TlsClientConfig{
    serverName = serverName,
    alpn = []string(0),
    trust = config.roots,
    insecureSkipVerify = config.insecureSkipVerify,
    nowUnix = ts,
    groups = [TlsGroup.X25519],
    keyShareGroups = [TlsGroup.X25519],
    suites = [TLS_AES_128_GCM_SHA256],
    clientHelloOverride = []byte(0),
    ephemeralOverride = []GroupKeypair(0),
  }
}

// Open a QUIC connection to `host:port`, verifying the server's certificate
// against the system trust roots (or the small bundled set if those are
// unavailable) — secure by default, like `std/tls`'s own `dial`. For a
// pinned CA or `insecureSkipVerify` (tests and trace replay only, never a
// shipped client — see `TlsClientConfig.insecureSkipVerify`'s own doc), use
// `dialQuicTls`. Binds an ephemeral loopback UDP socket, spawns the
// reader/ticker/loop threads, and blocks until the connection is
// established. ponytail: binds 127.0.0.1 only; no name resolution or IPv6.
export fn dialQuic(host: string, port: int, serverName: string): Conn! {
  let trust = systemRoots() catch bundled()
  return dialQuicTls(host, port, serverName, newTlsConfig(trust))?
}

// As `dialQuic`, with an explicit TLS `config` — the std/quic mirror of
// `std/http`'s `getTls`/`requestTls`: pinned roots, a fixed
// `insecureSkipVerify` for tests, or another custom `std/tls.TlsConfig`.
// `serverName` (not `config.serverName`) is always the SNI and the name the
// certificate must match.
export fn dialQuicTls(host: string, port: int, serverName: string, config: TlsConfig): Conn! {
  let sock = udpBind("127.0.0.1", 0)?
  let scid = quicconnMakeCid()
  let dcid = quicconnMakeCid()
  let tp = quicconnLocalParams(scid)
  let ext = Extension{
    extType = quicTransportParametersExtension,
    data = encodeTransportParameters(tp),
  }
  let h = tlsClientStartExts(quicconnClientTlsConfig(serverName, config), [ext])?
  // Owns the socket: `dialQuic` bound it here, nothing else can reach it.
  let st = quicconnNewState(true, sock, true, host, port, scid, dcid)
  st.chOpt = Option.Some(h)
  st.iLevel.ksend = clientInitialKeys(dcid)
  st.iLevel.krecv = serverInitialKeys(dcid)
  st.iLevel.haveSend = true
  st.iLevel.haveRecv = true
  spawn quicconnReader(sock, st.inCh)
  spawn quicconnTicker(st)
  spawn quicconnLoop(st)
  let r = <- st.readyCh
  if (r < 0) {
    // The socket is already closed: `readyCh <- -1` comes only from
    // quicconnFail, which releases the owned socket (and so unblocks the reader
    // thread's recv) itself. Closing again here would double-close a descriptor
    // the kernel may have handed to someone else.
    fail newError("quic: handshake failed")
  }
  return Conn{ cmdCh = st.cmdCh, sock = sock, peerHost = st.handshakePeerHost }
}

// Accept a QUIC connection on the already-bound UDP socket `sock`, using the
// given PEM certificate chain and private key, and complete the handshake. Serves
// exactly one connection. ponytail: single connection per socket (no connection-
// id demultiplexing across peers).
export fn acceptQuic(sock: UdpSocket, certChainPem: string, keyPem: string): Conn! {
  let cfg = newTlsServerConfig(certChainPem, keyPem, []string(0))?
  cfg.suites = [TLS_AES_128_GCM_SHA256]
  cfg.groups = [TlsGroup.X25519]
  let scid = quicconnMakeCid()
  let tp = quicconnLocalParams(scid)
  let ext = Extension{
    extType = quicTransportParametersExtension,
    data = encodeTransportParameters(tp),
  }
  let s = tlsServerStartExts(cfg, [ext])?
  // Owns the socket: `acceptQuic` serves exactly one connection on `sock`, and
  // its caller hands the socket over for that connection's lifetime.
  let st = quicconnNewState(false, sock, true, "", 0, scid, []byte(0))
  st.shOpt = Option.Some(s)
  spawn quicconnReader(sock, st.inCh)
  spawn quicconnTicker(st)
  spawn quicconnLoop(st)
  let r = <- st.readyCh
  if (r < 0) {
    fail newError("quic: server handshake failed")
  }
  return Conn{ cmdCh = st.cmdCh, sock = sock, peerHost = st.handshakePeerHost }
}

