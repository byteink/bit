// Bit standard library — quic module, STREAM data reassembly (RFC 9000 §2.2).
//
// A peer may send a stream's bytes out of order, with gaps, and more than once.
// `quicconnStreamBuf` holds the received bytes not yet handed to the application,
// at their stream offsets, and gives up the contiguous run from the delivered
// point as one fresh copy. It starts at the delivered offset and ends at most at
// the stream credit granted (flow.bit), so what it holds is bounded by the
// flow-control window, never by the stream's length (#7735: streams used the
// whole-stream CRYPTO reassembler, which re-copied everything received so far on
// every STREAM frame, quadratic in the stream's length and capped at 16 MiB).
//
// Same flat `std/quic` module and namespace as `conn.bit`.

// `data[i]` is the byte at stream offset `base + i` and `have[i]` whether it has
// arrived. `readable` is the end of the contiguous run from `base`, and `maxLen`
// the most bytes past `base` the buffer accepts.
class quicconnStreamBuf {
  data: []byte,
  have: []byte,
  base: int,
  readable: int,
  maxLen: int,
}

fn quicconnNewStreamBuf(maxLen: int): quicconnStreamBuf {
  return quicconnStreamBuf{
    data = []byte(0),
    have = []byte(0),
    base = 0,
    readable = 0,
    maxLen = maxLen,
  }
}

// Make `span` bytes past `base` addressable. Growth at least doubles, and the
// bytes copied are only the ones still held, so a stream costs O(1) per byte.
fn quicconnBufGrow(b: quicconnStreamBuf, span: int) {
  if (span <= len(b.data)) {
    return
  }
  let size = quicconnMin(quicconnMax(span, 2 * len(b.data)), b.maxLen)
  let nd = []byte(size)
  let nh = []byte(size)
  let i = 0
  while (i < len(b.data)) {
    nd[i] = b.data[i]
    nh[i] = b.have[i]
    i = i + 1
  }
  b.data = nd
  b.have = nh
}

// Record `frag` at stream offset `offset` and extend the contiguous run. Bytes
// below `base` were already delivered and are dropped (§2.2 lets a receiver
// discard data it already has); a byte that arrives again must carry the same
// value. Fails past `maxLen` or on a changed byte.
fn quicconnBufInsert(b: quicconnStreamBuf, offset: int, frag: []byte): ()! {
  let end = offset + len(frag)
  if (offset < 0 || end < offset) {
    fail newError("quic: STREAM offset out of range")
  }
  if (end - b.base > b.maxLen) {
    fail newError("quic: STREAM data exceeds the reassembly limit")
  }
  quicconnBufGrow(b, end - b.base)
  let i = quicconnMax(b.base - offset, 0)
  while (i < len(frag)) {
    let idx = offset + i - b.base
    if (b.have[idx] != 0 && b.data[idx] != frag[i]) {
      fail newError("quic: retransmitted STREAM data does not match")
    }
    b.data[idx] = frag[i]
    b.have[idx] = 1
    i = i + 1
  }
  while (b.readable - b.base < len(b.have) && b.have[b.readable - b.base] != 0) {
    b.readable = b.readable + 1
  }
}

// A fresh copy of the bytes at stream offsets `[from, to)`, inside the
// contiguous run.
fn quicconnBufCopy(b: quicconnStreamBuf, from: int, to: int): []byte {
  if (from < b.base || to > b.readable || from > to) {
    panic("quicconnBufCopy: internal: [${from}, ${to}) is outside [${b.base}, ${b.readable})")
  }
  return quicconnCopyRange(b.data, from - b.base, to - b.base)
}

// Drop every byte below stream offset `to` (at most the contiguous end): it has
// been delivered and is never needed again. A view, not a copy; the next growth
// copies only what is still held.
fn quicconnBufRelease(b: quicconnStreamBuf, to: int) {
  if (to <= b.base) {
    return
  }
  if (to > b.readable) {
    panic("quicconnBufRelease: internal: ${to} is past the contiguous end ${b.readable}")
  }
  let n = to - b.base
  b.data = b.data[n:len(b.data)]
  b.have = b.have[n:len(b.have)]
  b.base = to
}
