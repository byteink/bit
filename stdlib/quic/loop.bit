// Bit standard library — quic module, the reader, ticker, loop, and application commands.
//
// Split out of `conn.bit` (#1503) to keep files readable; `stdlib/quic` is one
// flat module, so this file shares that file's imports and namespace.

// ---------------------------------------------------------------------------
// Reader, ticker, and the loop
// ---------------------------------------------------------------------------

// Reader thread: park on UDP recv and forward each datagram; on a socket error
// (close) emit one `eof` and stop.
function quicconnReader(sock: UdpSocket, inCh: chan<quicconnDgram>) {
  while (true) {
    let d = sock.recv(2048) catch e {
      inCh <- quicconnDgram{ data: []byte(0), host: "", port: 0, eof: true }
      return
    }
    inCh <- quicconnDgram{ data: []byte(d.data), host: d.host, port: d.port, eof: false }
  }
}

// Ticker thread: emit a tick every `quicconnTick` ns to drive the RFC 9002
// timers. A non-blocking send drops the tick if the loop is busy, so the ticker
// never parks; it exits when the loop clears `running`. ponytail: a fixed tick
// stands in for a cancellable per-deadline timer — a native timer channel would
// let the loop block precisely instead of polling on the tick.
//
// #1769: this tick is genuinely droppable and delayable — a fleet kept
// continuously busy by channel traffic can starve it, on two levels: (1)
// `runtime/sched.zig`'s `findWork` used to check for a due `sleepTask`
// deadline only once a worker had *no other* runnable work anywhere, and (2)
// `runtime/root.zig` pins the scheduler to one OS thread (ABI.md §9 —
// scheduler-maturity only, not a GC requirement), so a `quicconnLoop` whose
// `select` keeps finding `inCh`/`cmdCh` immediately ready never parks and
// never gives that one thread back to this ticker at all. Both are fixed
// ((1) in `findWork` directly; (2) by having `quicconnLoop` check
// `quicconnCheckDeadlines` itself, unconditionally, every trip through its
// own loop — see the call there — so the handshake/idle timeouts no longer
// depend on a tick arriving).
//
// Investigating this ticket's original repro (h3core hanging for 900s+ under
// `BIT_GC=stress`) with direct instrumentation found neither cause was what
// was actually happening: the connection never gets far enough for its own
// `select` to matter. Under `BIT_GC=stress`, `quicconnFlush`'s AEAD encryption
// of the very first Initial packet — inside the synchronous `quicconnKickoff`
// that runs before `quicconnLoop`'s while loop starts at all — had not
// returned even once after 30+ seconds. A plain RSA test with no QUIC, no
// channels, and no scheduler involvement (`tests/imports/cryptorsa`) shows the
// identical stall under the same flag. This is the same phenomenon
// `tests/imports/quicconn`'s own file comment already documents and excludes
// from stress testing for: a real handshake is millions of loop back-edges,
// `BIT_GC=stress` collects at every one of them, and the aggregate cost
// balloons far past what any tick-delivery fix can address. Real, but a
// separate, already-known issue — not this ticket's mechanism.
function quicconnTicker(st: quicconnState) {
  while (st.running) {
    quicconnSleepTick()
    select {
      case st.tickCh <- 0:
        {}
      default:
        {}
    }
  }
}

// Loop thread: the sole owner of `st`. Kick off the handshake, then fold in one
// datagram, command, or tick at a time until the connection ends.
function quicconnLoop(st: quicconnState) {
  quicconnKickoff(st) catch e {
    quicconnFail(st)
  }
  while (st.running) {
    select {
      case ev = <- st.inCh:
        quicconnOnDgram(st, ev) catch e {
          quicconnFail(st)
        }
      case cmd = <- st.cmdCh:
        quicconnOnCmd(st, cmd) catch e {
          quicconnFail(st)
        }
      case tk = <- st.tickCh:
        quicconnOnTick(st) catch e {
          quicconnFail(st)
        }
    }
    // #1769: checked here too, unconditionally, not only inside
    // `quicconnOnTick`. `runtime/root.zig` pins the scheduler to one OS
    // thread (ABI.md §9), so whenever this `select` keeps finding `inCh` (or
    // `cmdCh`) immediately ready — sustained traffic, retransmits, duplicate
    // datagrams — this loop's own green thread never parks and so never gives
    // the single worker thread back to `quicconnTicker`'s green thread at
    // all; the tick this loop is waiting on is then never even produced, no
    // matter how fair `select` or the scheduler's timer queue are. This trip
    // through the loop is proof enough that the loop itself is still
    // scheduled, so checking the deadlines right here — on every iteration,
    // tick or not — no longer depends on the ticker getting a turn.
    if (st.running) {
      quicconnCheckDeadlines(st)
    }
  }
  // RESOLVE THE HANDSHAKE PHASE ON EVERY EXIT PATH (#1912). `readyCh` had four
  // ways to be left unwritten, all of them setting `st.running = false` without
  // going through `quicconnFail`: an EOF datagram, the graceful close in
  // `quicconnDoClose`, and a received ConnectionClose or ApplicationClose frame
  // (recv.bit's two close arms). A connection that ends that way while still
  // un-established never answers `readyCh` at all.
  //
  // THE LISTENER'S REAPER BLOCKS ON THAT ANSWER, so the admission slot it holds
  // is never released: `quicListenerReap` does `<- st.readyCh` and only then
  // decrements `handshaking`. With `quicListenerMaxHandshakes` at 4, four such
  // connections leave the server shedding EVERY subsequent Initial for the rest
  // of its life — which does not look like a leak from outside, it looks like a
  // server that has stopped answering: every later client fails at exactly the
  // 5s handshake deadline, forever.
  //
  // Measured at BIT_WORKERS=4 before this: seven of eight concurrent fetches
  // completed in ~3s, the eighth gave up at 33s with "connection closed before
  // the stream drained" — the client closing mid-handshake is precisely the
  // ConnectionClose path above — and every retry after it failed at 5016ms.
  //
  // Single-worker scheduling hid it rather than avoiding it: the handshake
  // always finished before a client gave up, so the un-established close paths
  // were never taken. Nothing here is multi-worker-specific, and a slow or
  // lossy client can reach it on one worker too.
  //
  // Idempotent: `quicconnFail` sends only when `!st.established`, and the send
  // is a non-blocking `select` on a capacity-1 channel, so an established
  // connection and a double call are both no-ops.
  if (!st.established) {
    quicconnFail(st)
  }
  quicconnReleaseWaiters(st)
  // Signal loop exit so a server listener can reap this connection's demux
  // entries. Non-blocking: nothing reads `doneCh` on the dial path.
  select {
    case st.doneCh <- 1:
      {}
    default:
      {}
  }
}

// Fail one command whose reply nobody will ever produce, so its caller unparks.
// Both reply channels are buffered (capacity 1, created per call), so neither
// send can block. `Write`/`Close` carry no reply.
function quicconnFailCmd(c: quicconnCmd) {
  if (c.kind == quicconnCmdOpen || c.kind == quicconnCmdAccept) {
    c.replyOpen <- quicconnOpenReply{ id: -1, recvCh: chan<StreamChunk>(1) }
  }
  if (c.kind == quicconnCmdFinish) {
    c.replyInt <- -1
  }
}

// Release every application green thread parked on this connection, once the
// loop has stopped. The loop is the sole producer for all of these, so once it
// exits nothing else ever will: without this, a peer close (or any error) mid
// `read`/`finish`/`acceptStream` parks the caller forever. Runs exactly once,
// after the loop, so the `close` calls here cannot race a send or double-close.
function quicconnReleaseWaiters(st: quicconnState) {
  // Commands still queued in the buffered channel: their senders are parked on
  // a reply channel the loop will never read.
  let draining = true
  let guard = 0
  while (draining && guard < 100000) {
    guard = guard + 1
    select {
      case c = <- st.cmdCh:
        quicconnFailCmd(c)
      default:
        draining = false
    }
  }
  for (id, s) of st.streams {
    if (s.hasDrain) {
      s.hasDrain = false
      s.drainCh <- -1 // unblocks `finish`, which reports the failure
    }
    // A blocked `read` drains whatever is still buffered, then sees the close.
    close(s.recvCh)
  }
  if (st.hasAcceptWaiter) {
    st.hasAcceptWaiter = false
    st.acceptWaiter <- quicconnOpenReply{ id: -1, recvCh: chan<StreamChunk>(1) }
  }
}

// Abandon the connection on an unrecoverable error: unblock a waiting
// dial/accept with a failure sentinel, stop the loop, and release the socket if
// this connection owns it — which also errors out the reader thread's blocked
// `recv` so it exits instead of leaking alongside the socket. Before #1473 this
// path had to stay socket-neutral by hand, because a listener-created connection
// shares `lst.sock`; `quicconnCloseOwnedSock` now enforces that structurally.
function quicconnFail(st: quicconnState) {
  if (!st.established) {
    select {
      case st.readyCh <- -1:
        {}
      default:
        {}
    }
  }
  st.running = false
  quicconnCloseOwnedSock(st)
}

// Mark the connection established and release the waiting dial/accept once.
function quicconnBecomeEstablished(st: quicconnState) {
  if (st.established) {
    return
  }
  st.established = true
  st.establishedAt = monotonic()
  select {
    case st.readyCh <- 1:
      {}
    default:
      {}
  }
}

// Client-only: build the ClientHello and send the first Initial flight.
function quicconnKickoff(st: quicconnState): ()! {
  if (!st.isClient) {
    return
  }
  match (st.chOpt) {
    None => {}
    Some(h) => {
      quicconnQueueCrypto(st, quicconnLvlInitial, h.clientHelloMessage())
      quicconnFlush(st)?
    }
  }
}

function quicconnOnDgram(st: quicconnState, ev: quicconnDgram): ()! {
  if (ev.eof) {
    st.running = false
    return
  }
  st.peerHost = ev.host
  st.peerPort = ev.port
  st.havePeer = true
  st.lastRecv = monotonic()
  quicconnRecvDatagram(st, ev.data)?
  quicconnFlush(st)?
}

// Handshake, abandoned-handshake, and idle timeouts: wall-clock deadlines that
// must be enforced even if a periodic tick never arrives (#1769 — see the call
// in `quicconnLoop`). Returns true if the connection was just failed, so a
// caller mid-tick-processing knows to stop there.
function quicconnCheckDeadlines(st: quicconnState): bool {
  // A client whose handshake has stalled past the deadline gives up, so a dial
  // to an absent/silent server returns an error rather than hanging. A listener-
  // created server connection (`serverHsTimeout`) applies the same deadline: it
  // is born mid-handshake when an Initial arrives, so a peer that never finishes
  // is reaped instead of leaking a slot. The `acceptQuic` server, which binds
  // before any peer exists, keeps waiting indefinitely.
  if ((st.isClient || st.serverHsTimeout) && !st.established && monotonic() - st.handshakeStart > quicconnHandshakeTimeout) {
    quicconnFail(st)
    return true
  }
  // Abandoned-handshake reap (#1709): a listener-created connection whose OWN
  // handshake did not finish until AFTER `quicconnHandshakeTimeout` had already
  // elapsed since it started is treated as almost certainly abandoned, and torn
  // down on a short grace period rather than the general idle timeout.
  //
  // Counting streams was tried first and does not work: an HTTP/3 client sends
  // its control/QPACK-encoder/QPACK-decoder streams as 0.5-RTT data in the same
  // flight as its request, so a connection can carry several streams and still
  // be one its own client already gave up on — `len(st.streams) == 0` was never
  // true for the connections that actually leaked (measured: every reaped
  // "abandoned" connection during a real collapse showed `streams=3`, not 0).
  //
  // What the client's own giving-up actually correlates with, measured on the
  // same trace, is establishment lateness: this server-side connection and its
  // client started their handshakes at essentially the same wall-clock moment
  // (the client's Initial IS what starts the server-side clock), so if OUR
  // establishment already took longer than the client's own patience budget,
  // the client has with very high confidence already hit ITS identical
  // `quicconnHandshakeTimeout` deadline and moved on to a fresh dial — this is
  // exactly the single-worker-congestion symptom #1709 diagnosed (a slow RSA
  // sign delays establishment past the deadline without ever tripping the
  // pre-established check above, because the sign itself is one uninterruptible
  // CPU burst that can carry the tick straight past its own deadline). Gated on
  // `serverHsTimeout` so `acceptQuic`'s single, socket-owning connection (which
  // binds before any peer exists, so has no "client" to have given up) is
  // unaffected; a connection that established WITHIN the deadline keeps the
  // normal RFC 9000 idle timeout, since its client was still within its own
  // patience budget and the connection is not presumed abandoned.
  if (st.serverHsTimeout && st.established && st.establishedAt - st.handshakeStart > quicconnHandshakeTimeout && monotonic() - st.establishedAt > quicconnAbandonTimeout) {
    quicconnFail(st)
    return true
  }
  // Idle timeout (RFC 9000 §10.1): an established connection that has heard
  // nothing from its peer for `st.idleTimeout` is dead. Stopping the loop
  // runs `quicconnReleaseWaiters`, so `finish`/`read`/`acceptStream` fail
  // instead of parking forever behind a PTO that nobody will ever answer.
  if (st.established && monotonic() - st.lastRecv > st.idleTimeout) {
    quicconnFail(st)
    return true
  }
  return false
}

function quicconnOnTick(st: quicconnState): ()! {
  if (quicconnCheckDeadlines(st)) {
    return
  }
  quicconnDetectLoss(st, quicconnLvlInitial)
  quicconnDetectLoss(st, quicconnLvlHandshake)
  quicconnDetectLoss(st, quicconnLvlApp)
  quicconnMaybePto(st)
  quicconnCheckDelivered(st)
  quicconnFlush(st)?
}

// ---------------------------------------------------------------------------
// Application commands
// ---------------------------------------------------------------------------

function quicconnOnCmd(st: quicconnState, cmd: quicconnCmd): ()! {
  if (cmd.kind == quicconnCmdOpen) {
    quicconnDoOpen(st, cmd)
    return
  }
  if (cmd.kind == quicconnCmdAccept) {
    quicconnDoAccept(st, cmd)
    return
  }
  if (cmd.kind == quicconnCmdWrite) {
    quicconnDoWrite(st, cmd)?
    return
  }
  if (cmd.kind == quicconnCmdFinish) {
    quicconnDoFinish(st, cmd)?
    return
  }
  if (cmd.kind == quicconnCmdSetIdle) {
    quicconnDoSetIdle(st, cmd)
    return
  }
  if (cmd.kind == quicconnCmdClose) {
    quicconnDoClose(st, cmd)?
    return
  }
}

function quicconnDoOpen(st: quicconnState, cmd: quicconnCmd) {
  let id = st.nextBidiId
  st.nextBidiId = st.nextBidiId + 4
  let s = quicconnNewStream(st, id, false)
  st.streams[id] = s
  st.present[id] = 1
  cmd.replyOpen <- quicconnOpenReply{ id: id, recvCh: s.recvCh }
}

function quicconnDoAccept(st: quicconnState, cmd: quicconnCmd) {
  if (len(st.acceptQueue) > 0) {
    let id = st.acceptQueue[0]
    st.acceptQueue = st.acceptQueue[1:len(st.acceptQueue)]
    let s = st.streams[id]
    cmd.replyOpen <- quicconnOpenReply{ id: id, recvCh: s.recvCh }
    return
  }
  st.acceptWaiter = cmd.replyOpen
  st.hasAcceptWaiter = true
}

function quicconnDoWrite(st: quicconnState, cmd: quicconnCmd): ()! {
  if (st.present[cmd.id] == 0) {
    return
  }
  let s = st.streams[cmd.id]
  if (len(s.sendBuf) == 0) {
    s.sendBuf = cmd.data
  } else {
    for b of cmd.data {
      s.sendBuf = append(s.sendBuf, b)
    }
  }
  s.sendLen = len(s.sendBuf)
  quicconnFlush(st)?
}

function quicconnDoFinish(st: quicconnState, cmd: quicconnCmd): ()! {
  if (st.present[cmd.id] == 0) {
    cmd.replyInt <- -1
    return
  }
  let s = st.streams[cmd.id]
  s.finQueued = true
  s.drainCh = cmd.replyInt
  s.hasDrain = true
  quicconnFlush(st)?
  quicconnCheckDelivered(st)
}

// Apply a new idle timeout. `cmd.id` carries the nanosecond value; a value at or
// below zero is ignored, since a zero timeout would fail the connection on the
// very next tick and there is no sane caller for that.
function quicconnDoSetIdle(st: quicconnState, cmd: quicconnCmd) {
  if (cmd.id <= 0) {
    return
  }
  st.idleTimeout = cmd.id
}

function quicconnDoClose(st: quicconnState, cmd: quicconnCmd): ()! {
  if (st.established && !st.closeSent) {
    // Re-arm the ACK so the closing packet carries one (RFC 9000 §10.2 permits
    // other frames alongside CONNECTION_CLOSE, and `quicconnFlushApp` emits the
    // ACK ahead of the pending close). After this we stop responding entirely,
    // so a peer still waiting on an ACK whose earlier datagram was lost would
    // otherwise never learn its data arrived — and, blocked in `finish`, would
    // wait forever. Bundling makes delivery of the close also confirm delivery
    // of everything we received.
    st.aLevel.ackPending = true
    st.aLevel.pending = append(st.aLevel.pending, Frame.ApplicationClose(0, []byte(0)))
    st.closeSent = true
    quicconnFlush(st)?
  }
  quicconnCloseOwnedSock(st)
  st.running = false
}

// The single place a connection may close its socket. A connection that does not
// own `sock` shares it with a listener and its sibling connections, so closing it
// would kill the accept loop and every other connection on it — a use-after-close
// on a descriptor other code still believes it owns (#1473). Every teardown path
// (`quicconnDoClose`, `quicconnFail`, any future one) goes through here; no other
// code in this file calls `sock.close()` on a connection's socket.
function quicconnCloseOwnedSock(st: quicconnState) {
  if (!st.ownsSock || st.sockClosed) {
    return
  }
  st.sockClosed = true
  st.sock.close()
}

