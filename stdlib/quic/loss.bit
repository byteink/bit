// Bit standard library — quic module, loss recovery, RTT, and congestion control.
//
// Split out of `conn.bit` (#1503) to keep files readable; `stdlib/quic` is one
// flat module, so this file shares that file's imports and namespace.

// ---------------------------------------------------------------------------
// Loss recovery, RTT, and NewReno congestion control (RFC 9002)
// ---------------------------------------------------------------------------

// Process an ACK frame (RFC 9002 §5, §7): retire acknowledged packets, update
// RTT from the largest newly-acked ack-eliciting packet, feed NewReno, then run
// loss detection and delivery checks.
fn quicconnProcessAck(st: quicconnState, levelIdx: int, a: AckFrame) {
  let lvl = quicconnLvl(st, levelIdx)
  let largest = int(a.largest)
  let acked = []quicconnRange(0)
  let hi = largest
  let lo = largest - int(a.firstRange)
  acked = append(acked, quicconnRange{ lo = lo, hi = hi })
  let prevLo = lo
  for rg of a.ranges {
    let ghi = prevLo - int(rg.gap) - 2
    let glo = ghi - int(rg.rangeLength)
    acked = append(acked, quicconnRange{ lo = glo, hi = ghi })
    prevLo = glo
  }
  if (largest > lvl.largestAcked) {
    lvl.largestAcked = largest
  }
  let now = monotonic().ns
  let largestAckedTime = -1
  let kept = []quicconnSent(0)
  let ackedAny = false
  for sp of lvl.sent {
    if (quicconnPnInRanges(sp.pn, acked)) {
      if (sp.ackEliciting) {
        st.bytesInFlight = st.bytesInFlight - sp.size
      }
      quicconnNoteAckedFrames(st, sp)
      quicconnOnPacketAcked(st, sp)
      ackedAny = true
      if (sp.pn == largest && sp.ackEliciting) {
        largestAckedTime = sp.timeSent
      }
    } else {
      kept = append(kept, sp)
    }
  }
  lvl.sent = kept
  if (largestAckedTime >= 0) {
    quicconnUpdateRtt(st, now - largestAckedTime)
  }
  if (ackedAny) {
    quicconnResetPtoCount(st)
    quicconnDetectLoss(st, levelIdx)
    quicconnCheckDelivered(st)
  }
}

// NewReno increase on acknowledgement (RFC 9002 §7.3.1 / §7.3.2). No increase
// for a packet sent during the current recovery period.
fn quicconnOnPacketAcked(st: quicconnState, sp: quicconnSent) {
  if (!sp.ackEliciting) {
    return
  }
  if (sp.timeSent <= st.recoveryStart) {
    return
  }
  if (st.cwnd < st.ssthresh) {
    st.cwnd = st.cwnd + sp.size
  } else {
    st.cwnd = st.cwnd + quicconnMaxPacket * sp.size / st.cwnd
  }
}

// Enter congestion recovery once per event (RFC 9002 §7.3.3): halve the window,
// floored at the minimum.
fn quicconnOnCongestionEvent(st: quicconnState, lostSentTime: int) {
  if (lostSentTime <= st.recoveryStart) {
    return
  }
  st.recoveryStart = monotonic().ns
  st.ssthresh = st.cwnd / 2
  if (st.ssthresh < quicconnMinWindow) {
    st.ssthresh = quicconnMinWindow
  }
  st.cwnd = st.ssthresh
}

// Update smoothed RTT and RTT variance (RFC 9002 §5.3). ACK delay is 0 in this
// implementation, so it drops out.
fn quicconnUpdateRtt(st: quicconnState, latest: int) {
  st.latestRtt = latest
  if (!st.haveRtt) {
    st.minRtt = latest
    st.srtt = latest
    st.rttvar = latest / 2
    st.haveRtt = true
    return
  }
  if (latest < st.minRtt) {
    st.minRtt = latest
  }
  st.rttvar = (3 * st.rttvar + quicconnAbs(st.srtt - latest)) / 4
  st.srtt = (7 * st.srtt + latest) / 8
}

// The time threshold for declaring a packet lost (RFC 9002 §6.1.2): 9/8 of the
// larger of smoothed and latest RTT, floored at the timer granularity.
fn quicconnLossDelay(st: quicconnState): int {
  let base = quicconnMax(st.srtt, st.latestRtt)
  let delay = base * 9 / 8
  if (delay < quicconnGranularity) {
    delay = quicconnGranularity
  }
  return delay
}

// Whether sent packet `sp` is declared lost under level `lvl`: by the packet
// threshold (3 later packets acknowledged) or the time threshold (RFC 9002
// §6.1). Split out of `quicconnDetectLoss` (#2448).
fn quicconnPacketIsLost(sp: quicconnSent, lvl: quicconnLevel, lossDelay: int, now: int): bool {
  let byPacket = sp.pn <= lvl.largestAcked - quicconnPacketThreshold
  let byTime = sp.pn < lvl.largestAcked && now - sp.timeSent >= lossDelay
  return byPacket || byTime
}

// Folds one lost packet `sp` into the connection state: debits its bytes from
// `st.bytesInFlight` if it was ack-eliciting, and re-queues its retransmittable
// frames on `lvl.pending` directly. Returns the packet's frame count, which is
// what `quicconnDetectLoss` gates the congestion event on.
//
// Split out of `quicconnDetectLoss` (#2448). It folded through a `LostAccum`
// object and an intermediate `[]Frame` until #3640: both were allocated on
// every call, including the overwhelmingly common one that declares nothing
// lost, so the scan now carries its two outputs as plain locals instead.
fn quicconnAccumulateLost(sp: quicconnSent, st: quicconnState, lvl: quicconnLevel): int {
  if (sp.ackEliciting) {
    st.bytesInFlight = st.bytesInFlight - sp.size
  }
  let _ = quicconnRequeueFrames(sp, st, lvl)
  return len(sp.frames)
}

// Put the frames of sent packet `sp` that still need delivering back on
// `lvl.pending` (RFC 9000 §13.3: STREAM, RESET_STREAM, CRYPTO, the MAX_* and
// *_BLOCKED frames go out again in a new packet), and return how many went.
// Shared by loss detection and the PTO probes.
fn quicconnRequeueFrames(sp: quicconnSent, st: quicconnState, lvl: quicconnLevel): int {
  let n = 0
  for f of sp.frames {
    if (quicconnShouldRetransmit(st, f)) {
      lvl.pending = append(lvl.pending, f)
      n = n + 1
    }
  }
  return n
}

// Whether a lost or probed frame `f` goes back on the queue: retransmittable,
// and not STREAM data of a stream whose send side was abandoned with
// RESET_STREAM (RFC 9000 §3.3: after a reset the endpoint MUST NOT retransmit
// the stream's data; §19.4 the reset's final size already settles it).
fn quicconnShouldRetransmit(st: quicconnState, f: Frame): bool {
  if (!quicconnIsRetransmittable(f)) {
    return false
  }
  let id = quicconnFrameStreamId(f)
  if (id < 0 || st.present[id] == 0) {
    return true
  }
  return !st.streams[id].sendAborted
}

// Remove the queued STREAM frames of stream `id` from the application-level
// queue: data re-queued by an earlier loss that the reset now makes moot.
fn quicconnDropStreamFrames(st: quicconnState, id: int) {
  let keep = []Frame(0)
  for f of st.aLevel.pending {
    if (quicconnFrameStreamId(f) != id) {
      keep = append(keep, f)
    }
  }
  st.aLevel.pending = keep
}

// For a kept (not-yet-lost) packet `sp` still older than the largest
// acknowledged packet, arms `lvl.lossTime` for the earliest moment it would
// become lost by the time threshold, if that is sooner than what is already
// armed. Split out of `quicconnDetectLoss` (#2448).
fn quicconnArmLossTimer(sp: quicconnSent, lvl: quicconnLevel, lossDelay: int) {
  if (sp.pn < lvl.largestAcked) {
    let t = sp.timeSent + lossDelay
    if (lvl.lossTime == 0 || t < lvl.lossTime) {
      lvl.lossTime = t
    }
  }
}

// Declare packets in `levelIdx` lost by the packet threshold (3 later packets
// acknowledged) or the time threshold (RFC 9002 §6.1), re-queue their
// retransmittable frames, and signal a congestion event.
fn quicconnDetectLoss(st: quicconnState, levelIdx: int) {
  let lvl = quicconnLvl(st, levelIdx)
  if (lvl.largestAcked < 0) {
    return
  }
  let now = monotonic().ns
  let lossDelay = quicconnLossDelay(st)
  let kept = []quicconnSent(0)
  let lostFrameCount = 0
  let lostTime = -1
  lvl.lossTime = 0
  for sp of lvl.sent {
    if (quicconnPacketIsLost(sp, lvl, lossDelay, now)) {
      lostFrameCount = lostFrameCount + quicconnAccumulateLost(sp, st, lvl)
      if (sp.timeSent > lostTime) {
        lostTime = sp.timeSent
      }
    } else {
      kept = append(kept, sp)
      quicconnArmLossTimer(sp, lvl, lossDelay)
    }
  }
  lvl.sent = kept
  if (lostFrameCount > 0) {
    quicconnOnCongestionEvent(st, lostTime)
  }
}

// The base PTO duration (RFC 9002 §6.2.1) before backoff and before the
// application-space `max_ack_delay` term, floored so a coarse tick and green-
// thread jitter cannot make it fire before a genuine ACK would arrive.
fn quicconnPtoDuration(st: quicconnState): int {
  if (!st.haveRtt) {
    return quicconnInitialPto
  }
  let pto = st.srtt + quicconnMax(4 * st.rttvar, quicconnGranularity)
  if (pto < quicconnMinPto) {
    pto = quicconnMinPto
  }
  return pto
}

// Probe datagrams sent per PTO (RFC 9002 §6.2.4 allows one or two).
const quicconnProbeCount: int = 2

// RFC 9002 A.8 `PeerCompletedAddressValidation`: a server always has; a client
// has once it has had a Handshake packet acknowledged or the handshake is
// confirmed (`handshakeComplete` is the server's receipt of the client Finished
// and the client's receipt of HANDSHAKE_DONE, RFC 9001 §4.1.2).
fn quicconnPeerValidated(st: quicconnState): bool {
  return !st.isClient || st.hLevel.largestAcked >= 0 || st.handshakeComplete
}

// RFC 9002 A.7: an ACK resets the PTO backoff, except for a client not yet sure
// the server validated its address (§6.2.1).
fn quicconnResetPtoCount(st: quicconnState) {
  if (quicconnPeerValidated(st)) {
    st.ptoCount = 0
  }
}

// The PTO deadline of packet-number space `idx` (RFC 9002 A.8): the time of its
// last ack-eliciting packet plus the backed-off duration, or 0 when the space has
// nothing in flight. The application space adds `max_ack_delay` (also backed
// off) and is not armed at all until the handshake is confirmed.
fn quicconnSpacePto(st: quicconnState, idx: int): int {
  let lvl = quicconnLvl(st, idx)
  if (len(lvl.sent) == 0) {
    return 0
  }
  let backoff = 1 << st.ptoCount
  let duration = quicconnPtoDuration(st) * backoff
  if (idx == quicconnLvlApp) {
    if (!st.handshakeComplete) {
      return 0
    }
    duration = duration + st.maxAckDelay * backoff
  }
  return lvl.timeLastAckEliciting + duration
}

// Drop packet-number space `idx` (Initial or Handshake) when its keys are
// discarded (RFC 9001 §4.9, RFC 9002 §6.4): its in-flight packets leave
// `bytesInFlight` and are never declared lost or retransmitted, its loss and PTO
// timers go, it neither sends nor receives again, and the PTO backoff restarts.
// The PTO is derived from the spaces on every tick (`quicconnPtoSpace`), so
// clearing `lvl.sent` and `lvl.lossTime` is what re-arms the timer. Idempotent.
fn quicconnDiscardSpace(st: quicconnState, idx: int) {
  assert(
    idx == quicconnLvlInitial || idx == quicconnLvlHandshake,
    "quic: only Initial and Handshake keys are discarded",
  )
  let lvl = quicconnLvl(st, idx)
  if (lvl.discarded) {
    return
  }
  for sp of lvl.sent {
    if (sp.ackEliciting) {
      st.bytesInFlight = st.bytesInFlight - sp.size
    }
  }
  lvl.sent = []quicconnSent(0)
  lvl.pending = []Frame(0)
  lvl.recvRanges = []quicconnRange(0)
  lvl.ackPending = false
  lvl.lossTime = 0
  lvl.timeLastAckEliciting = 0
  lvl.haveSend = false
  lvl.haveRecv = false
  lvl.ksend = quicconnZeroKeys()
  lvl.krecv = quicconnZeroKeys()
  lvl.discarded = true
  st.ptoCount = 0
}

// Whether any packet-number space has an ack-eliciting packet in flight.
fn quicconnAnyInFlight(st: quicconnState): bool {
  return len(st.iLevel.sent) > 0 || len(st.hLevel.sent) > 0 || len(st.aLevel.sent) > 0
}

// RFC 9002 §6.2.2.1 / A.8: a client with nothing in flight that is not sure the
// server has validated its address keeps a PTO armed, in the Handshake space if
// it holds Handshake keys and the Initial space otherwise, so a lost server
// flight cannot deadlock the handshake. Returns that space once its deadline,
// measured from the last datagram received (the event that last re-armed the
// timer), has passed; -1 otherwise.
fn quicconnAntiDeadlockSpace(st: quicconnState, now: int): int {
  if (quicconnPeerValidated(st)) {
    return -1
  }
  if (now < st.lastRecv + quicconnPtoDuration(st) * (1 << st.ptoCount)) {
    return -1
  }
  if (st.hLevel.haveSend) {
    return quicconnLvlHandshake
  }
  return quicconnLvlInitial
}

// RFC 9002 A.8 `GetPtoTimeAndSpace`: the space with the earliest PTO deadline
// (ties go to the earlier space), or -1 when the earliest has not passed yet or
// no timer is armed.
fn quicconnPtoSpace(st: quicconnState, now: int): int {
  if (!quicconnAnyInFlight(st)) {
    return quicconnAntiDeadlockSpace(st, now)
  }
  let space = -1
  let earliest = 0
  let idx = quicconnLvlInitial
  while (idx <= quicconnLvlApp) {
    let t = quicconnSpacePto(st, idx)
    if (t != 0 && (space < 0 || t < earliest)) {
      space = idx
      earliest = t
    }
    idx = idx + 1
  }
  if (space < 0 || now < earliest) {
    return -1
  }
  return space
}

// Whether a time-threshold loss timer is armed in any space. RFC 9002 §6.2
// (`SetLossDetectionTimer`): it takes priority, and the PTO is not armed while
// it is; `quicconnDetectLoss` runs on every tick and settles it.
fn quicconnLossTimerArmed(st: quicconnState): bool {
  return st.iLevel.lossTime != 0 || st.hLevel.lossTime != 0 || st.aLevel.lossTime != 0
}

// Fire the probe timeout when the earliest per-space PTO has elapsed (RFC 9002
// §6.2): send two probe datagrams in that space. This is what recovers a lost
// tail, and what gets a control frame out when every packet after it was lost
// too.
fn quicconnMaybePto(st: quicconnState): ()! {
  if (quicconnLossTimerArmed(st)) {
    return
  }
  let space = quicconnPtoSpace(st, monotonic().ns)
  if (space < 0) {
    return
  }
  st.ptoCount = st.ptoCount + 1
  if (st.ptoCount > 8) {
    st.ptoCount = 8
  }
  quicconnSendProbes(st, space)?
}

// Send `quicconnProbeCount` probe datagrams in space `idx` (RFC 9002 §6.2.4:
// one or two, each ack-eliciting). Each is flushed on its own so the two are
// separate datagrams, and neither waits for congestion window: pending frames
// are not window-gated, and a probe may exceed the window (§7).
fn quicconnSendProbes(st: quicconnState, idx: int): ()! {
  let lvl = quicconnLvl(st, idx)
  let from = 0
  let k = 0
  while (k < quicconnProbeCount) {
    from = quicconnQueueProbe(st, lvl, from)
    quicconnFlush(st)?
    k = k + 1
  }
}

// Queue the content of one probe: the frames of the oldest unacknowledged packet
// at or after index `from` of `lvl.sent` that still has any worth delivering
// (a packet whose only frames are STREAM data of a reset stream has none, and
// must not stand in the way of the RESET_STREAM behind it). Returns the index
// after that packet. When nothing is left, queues a PING so the probe is still
// ack-eliciting and returns `len(lvl.sent)`.
fn quicconnQueueProbe(st: quicconnState, lvl: quicconnLevel, from: int): int {
  let i = from
  while (i < len(lvl.sent)) {
    let n = quicconnRequeueFrames(lvl.sent[i], st, lvl)
    i = i + 1
    if (n > 0) {
      return i
    }
  }
  lvl.pending = append(lvl.pending, Frame.Ping)
  return i
}

// Reply to any finished stream whose send buffer is fully acknowledged, so the
// application's `finish` returns (RFC 9000 §3.3: the send stream is drained).
fn quicconnCheckDelivered(st: quicconnState) {
  for (_, s) of st.streams {
    if (s.hasDrain && !s.delivered) {
      if (s.finSent && s.sendOff == s.sendLen && quicconnStreamFullyAcked(s)) {
        s.delivered = true
        s.hasDrain = false
        s.drainCh <- 1
      }
    }
  }
}

// Whether any STREAM data for `id` is still in flight or queued for (re)send.
// Record what a newly-acknowledged packet actually delivered: the send-side byte
// ranges of its STREAM frames, and the FIN if it carried one.
fn quicconnNoteAckedFrames(st: quicconnState, sp: quicconnSent) {
  for f of sp.frames {
    let id = quicconnFrameStreamId(f)
    if (id >= 0 && st.present[id] != 0) {
      let s = st.streams[id]
      let n = quicconnFrameStreamLen(f)
      if (n > 0) {
        let lo = quicconnFrameStreamLo(f)
        s.ackedRanges = quicconnMergeRanges(
          append(s.ackedRanges, quicconnRange{ lo = lo, hi = lo + n - 1 }),
        )
      }
      if (quicconnFrameStreamFin(f)) {
        s.finAcked = true
      }
      quicconnReturnCredit(st, s)
    }
  }
}

// Whether every byte the application queued on `s` has been acknowledged. Bytes,
// not packets: a lost packet's bytes are retransmitted in a new one, so an
// already-delivered byte must not keep the stream "undrained" just because the
// packet that first carried it was never acked.
fn quicconnStreamFullyAcked(s: quicconnStream): bool {
  if (!s.finAcked) {
    return false
  }
  if (s.sendLen == 0) {
    return true
  }
  for r of s.ackedRanges {
    if (r.lo <= 0 && r.hi >= s.sendLen - 1) {
      return true
    }
  }
  return false
}

