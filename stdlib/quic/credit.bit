// Bit standard library — quic module, stream-limit credit (RFC 9000 §4.6, #7707).
//
// The initial_max_streams_* this endpoint advertises is a CUMULATIVE count of the
// streams the peer may ever open, not a concurrency bound, so without a later
// MAX_STREAMS a connection serves exactly that many streams in its whole life
// (a pooled HTTP/3 connection, 16 minus its 3 control streams, 13 requests).
// Each time a peer-initiated stream is fully closed the limit is raised by one,
// keeping the streams the peer has open and not closed at the configured window;
// MAX_STREAMS (type 0x12 bidirectional, 0x13 unidirectional, §19.11) goes out once
// half a window of credit has built up, the batching quic-go and quiche use, so
// a burst of short streams costs one frame per half window and not one each.
//
// Same flat `std/quic` module and namespace as `conn.bit`.

// RFC 9000 §4.6: a stream limit above 2^60 cannot be expressed as a stream id.
const quicconnMaxStreamsCap: int = 1 << 60

// What this endpoint has told the peer about one stream type. `limit` is the
// cumulative count currently advertised, either in the transport parameter or in
// the latest MAX_STREAMS queued: it only ever grows.
class quicconnCredit {
  window: int,
  limit: int,
  closed: int,
}

fn quicconnNewCredit(window: int): quicconnCredit {
  return quicconnCredit{ window = window, limit = window, closed = 0 }
}

// Whether `id` names a unidirectional stream (RFC 9000 §2.1: bit 1 of the id).
fn quicconnIsUni(id: int): bool {
  return id % 4 >= 2
}

// The credit that governs ids of `id`'s direction.
fn quicconnCreditFor(st: quicconnState, id: int): quicconnCredit {
  if (quicconnIsUni(id)) {
    return st.creditUni
  }
  return st.creditBidi
}

// Whether both directions of `s` are finished (RFC 9000 §3): the receive side
// has delivered its FIN or a reset, and the send side was abandoned or its FIN
// and every byte were acknowledged. A unidirectional stream has no send side.
fn quicconnStreamClosed(s: quicconnStream): bool {
  if (!s.finDelivered) {
    return false
  }
  if (quicconnIsUni(s.id) || s.sendAborted) {
    return true
  }
  return s.finSent && s.sendOff == s.sendLen && quicconnStreamFullyAcked(s)
}

// Called wherever a stream may have just finished a direction. Returns the
// stream's credit once, and queues MAX_STREAMS when half a window is owed.
fn quicconnReturnCredit(st: quicconnState, s: quicconnStream) {
  if (!s.isPeer || s.creditReturned || !quicconnStreamClosed(s)) {
    return
  }
  s.creditReturned = true
  let c = quicconnCreditFor(st, s.id)
  c.closed = c.closed + 1
  let target = quicconnMin(c.window + c.closed, quicconnMaxStreamsCap)
  if (target - c.limit < c.window / 2) {
    return
  }
  c.limit = target
  st.aLevel.pending = append(st.aLevel.pending, Frame.MaxStreams(!quicconnIsUni(s.id), u64(target)))
}
