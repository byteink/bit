// Bit standard library — quic module, the server listener and connection demultiplexing.
//
// Split out of `conn.bit` (#1503) to keep files readable; `stdlib/quic` is one
// flat module, so this file shares that file's imports and namespace.

// ---------------------------------------------------------------------------
// Server listener — connection demultiplexing (RFC 9000 §5.1)
// ---------------------------------------------------------------------------
//
// A single bound UDP socket carries many client connections, told apart by the
// Destination Connection ID in each packet header. `acceptQuic` above drives one
// connection per socket; `listenQuic` owns the socket instead and routes every
// datagram to the matching connection, spawning a new one on an Initial whose
// DCID it has not seen. Each connection keeps its own reader-less loop fed by the
// listener rather than parking on the shared socket itself.
//
// THE DEMUX TABLE IS GUARDED BY `lst.mu` (#1912). It is written by the single
// listener loop AND by one reaper green thread per connection, and until #1900
// the runtime booted exactly one worker, so those could not overlap across a
// heap mutation and no lock was needed. This file said so, and said the M:N
// epic would have to guard it. It does now.
//
// The symptom when it was not guarded is worth recording, because it does not
// look like a data race from the outside. At `BIT_WORKERS=4`, seven of eight
// concurrent connections completed in ~3s and the eighth failed after 49.7s
// with "connection closed before the stream drained" — after which EVERY
// subsequent handshake failed at exactly the 5s deadline, forever. A corrupted
// hash table does not crash; it starts missing lookups, so the server silently
// stops recognising its own connections and looks hung rather than broken.
//
// THE LOCK IS NEVER HELD ACROSS A CHANNEL OPERATION. `acceptCh <-`, `<- readyCh`
// and `<- doneCh` all block, and blocking while holding this would wedge the
// listener loop behind a connection that nobody is draining — the same stall
// `quicListenerFeed`'s non-blocking send exists to avoid. Every critical
// section below is a handful of map and counter operations with no park in it.

// A hard ceiling on concurrently-tracked connections, bounding the demux table
// and the per-connection green threads. Half-open handshakes free their slot via
// the 5s server handshake timeout (`quicconnOnTick`), so the count recovers.
// ponytail: no aging-out of idle *established* connections yet.
const quicListenerMaxConns: int = 1024

// A much tighter ceiling on connections concurrently *mid-handshake* (admitted
// but not yet established) — admission control against a retry storm (#1709).
// The scheduler is single-worker (ABI.md §5, `nthreads` pinned to 1), and each
// handshake's server-side RSA sign fully occupies that one worker for its
// duration (cooperative, non-preemptive green threads: nothing else runs while
// a sign call is in progress). Bounding how many connections may be mid-sign at
// once bounds the round-robin population every tick has to service, so a client
// retry storm cannot inflate per-connection scheduling latency without limit —
// unbounded admission was exactly what let a slow-crypto runtime's arrivals
// outpace its reaps and collapse to total starvation. Sized generously over the
// modest genuine concurrency std/quic's own tests exercise (2), not against
// `quicListenerMaxConns`, which bounds the demux table as a whole and is far too
// loose to gate the CPU-bound handshake phase specifically.
const quicListenerMaxHandshakes: int = 4

// The listener's private state: the shared socket, the reusable TLS server
// config, the DCID→connection table (`present` shadows key existence, since the
// map has no comma-ok probe), the queue of established connections `accept`
// drains, and a live-connection count for the connection cap.
class quicListenerState {
  sock: UdpSocket,
  // Guards `conns`, `present`, `count` and `handshaking` — see the header.
  mu: Mutex,
  cfg: TlsServerConfig,
  // The demux table maps a connection id to just that connection's inbound
  // datagram channel — not the whole `quicconnState`. The listener only ever
  // needs to feed datagrams, and a channel is a small reference; storing the
  // ~50-field connection class by value here would copy it on every insert and
  // lookup (and stresses large-class-through-map codegen for no benefit).
  conns: map<string, chan<quicconnDgram>>,
  present: map<string, int>,
  acceptCh: chan<Conn>,
  count: int,
  // Connections currently mid-handshake (admitted, not yet resolved established
  // or failed) — the admission-control counter gated by `quicListenerMaxHandshakes`.
  handshaking: int,
  // Set by `Listener.stopAccepting` (#6149): once true, `quicListenerDispatch`
  // drops every datagram for a DCID not already in `conns`/`present` instead of
  // admitting it as a new connection, while continuing to route datagrams for
  // connections already there. Guarded by `mu`, same as every other field here.
  stopped: bool,
}

// A QUIC server listener owning one bound UDP socket and demultiplexing all
// incoming datagrams to per-client connections by Destination Connection ID.
export class Listener {
  acceptCh: chan<Conn>
  sock: UdpSocket
  // The same `quicListenerState` `quicListenerLoop` (below) reads and writes —
  // shared, not copied, so `stopAccepting` below is visible to it immediately.
  state: quicListenerState
  // Accept the next established connection, blocking until a client completes its
  // handshake. Each `Conn` is independent, multiplexed over the shared socket.
  export accept(): Conn! {
    return <- this.acceptCh
  }

  // Stop admitting brand-new connections: every later datagram whose
  // connection id is not already in the demux table is refused instead of
  // admitted. A well-formed client Initial gets the RFC 9000 §5.2.2 SHOULD —
  // a stateless Initial packet carrying CONNECTION_CLOSE(CONNECTION_REFUSED)
  // (`quicListenerSendRefusal`, below); anything too malformed to carry a
  // parseable DCID, or not an Initial at all, still falls back to a silent
  // drop (see this method's own doc in stdlib/quic.md). A connection already
  // accepted, or still mid-handshake, keeps being fed its datagrams exactly
  // as before: this stops ADMISSION, not the one shared demux loop every
  // open connection depends on. Idempotent and safe to call from any green
  // thread — the flag is guarded by the same `mu` every other field of the
  // listener's state is.
  export stopAccepting() {
    this.state.mu.lock()
    this.state.stopped = true
    this.state.mu.unlock()
  }
}

// Bind a listener to the already-bound UDP socket `sock`: build the shared TLS
// server config once and start the demultiplexing loop. Returns immediately;
// established connections arrive via `accept`.
export fn listenQuic(sock: UdpSocket, certChainPem: string, keyPem: string): Listener! {
  let cfg = TlsServerConfig(certChainPem, keyPem, []string(0))?
  cfg.suites = [TLS_AES_128_GCM_SHA256]
  cfg.groups = [TlsGroup.X25519]
  let lst = quicListenerState{
    sock = sock,
    cfg = cfg,
    mu = Mutex(),
    conns = map<string, chan<quicconnDgram>>(),
    present = map<string, int>(),
    acceptCh = chan<Conn>(64),
    count = 0,
    handshaking = 0,
    stopped = false,
  }
  spawn quicListenerLoop(lst)
  return Listener{ acceptCh = lst.acceptCh, sock = sock, state = lst }
}

// The listener loop: the sole owner of the socket's recv. Park on each datagram
// and dispatch it; a socket error (close) ends the loop. A malformed datagram or
// a failed connection setup is swallowed so one bad packet never kills the
// listener.
fn quicListenerLoop(lst: quicListenerState) {
  while (true) {
    let d = lst.sock.recv(2048) catch _ {
      return
    }
    quicListenerDispatch(lst, []byte(d.data), d.host, d.port) catch _ {
      continue
    }
  }
}

// Route one datagram: look its DCID up in the table and forward it; on an unknown
// DCID, create a new connection only for a client Initial (and only under the
// connection cap), otherwise drop it (RFC 9000 §5.2 — a stray short-header packet
// with no matching connection is discarded).
fn quicListenerDispatch(lst: quicListenerState, data: []byte, host: string, port: int): ()! {
  let dcid = quicDemuxDcid(data)
  if (len(dcid) == 0) {
    return
  }
  let key = string(dcid)
  // The lookup and the feed are split: the map read is under the lock, the send
  // is not. `quicListenerFeed` is non-blocking, but holding the table lock
  // across any send invites exactly the stall the non-blocking send avoids.
  lst.mu.lock()
  let known = lst.present[key] != 0
  let inCh = lst.conns[key]
  let stopped = lst.stopped
  lst.mu.unlock()
  if (known) {
    quicListenerFeed(inCh, data, host, port)
    return
  }
  // `stopAccepting` (#6149): a datagram for a DCID this listener has never
  // seen is a brand-new connection attempt — refuse it before it ever
  // reaches the Initial/admission checks below. A known DCID is unaffected
  // (handled above), so a connection already accepted keeps being fed
  // regardless. Only a client Initial gets the stateless CONNECTION_CLOSE
  // reply (RFC 9000 §5.2.2 only speaks to refusing a *new connection*
  // attempt, which is what a client Initial is); anything else addressed to
  // an unknown DCID is the ordinary stray-packet case §5.2 already covers
  // with a silent drop.
  if (stopped) {
    if (quicDemuxIsInitial(data)) {
      quicListenerSendRefusal(lst, data, host, port)
    }
    return
  }
  // ponytail: unknown dcid falls through to the Initial/new-connection path.
  if (!quicDemuxIsInitial(data)) {
    return
  }
  // Admission control (#1709): past the mid-handshake cap, shed the Initial
  // instead of admitting more CPU-bound handshake work than the single worker
  // can service. The client's own Initial retransmission (and, failing that,
  // its handshake-timeout-driven redial) will retry; dropping here is the same
  // "treat as loss" contract `quicListenerFeed` already uses for a backed-up
  // connection, just applied before a connection exists at all.
  // ADMISSION AND CREATION UNDER ONE LOCK, deliberately. Both caps are
  // check-then-act: reading `count`/`handshaking` and then inserting in a
  // separate critical section lets two datagrams for the same new DCID both
  // pass the check and both create a connection, which double-counts the caps
  // and leaves an orphaned connection nothing will ever route to.
  lst.mu.lock()
  if (lst.count >= quicListenerMaxConns || lst.handshaking >= quicListenerMaxHandshakes) {
    lst.mu.unlock()
    return
  }
  // Re-check under the lock: another datagram for this DCID may have created the
  // connection between the probe above and here.
  if (lst.present[key] != 0) {
    let existing = lst.conns[key]
    lst.mu.unlock()
    quicListenerFeed(existing, data, host, port)
    return
  }
  let st = quicListenerNewConn(lst, key) catch e {
    lst.mu.unlock()
    fail e
  }
  lst.mu.unlock()
  quicListenerFeed(st.inCh, data, host, port)
}

// Answer a refused connection attempt with a stateless Initial packet
// carrying CONNECTION_CLOSE(CONNECTION_REFUSED) (RFC 9000 §5.2.2, §20.1),
// instead of `quicListenerDispatch`'s plain drop. Built entirely outside any
// connection's state — no `quicconnState`, no packet-number history kept
// past this one call — using the same Initial-key derivation and packet
// protection every real connection uses (`serverInitialKeys`, `protectPayload`,
// `applyHeaderProtection`; packet.bit, RFC 9001 §5.1/§5.2), keyed by the
// client's own Destination Connection ID off its Initial (`hdr.dcid` below),
// exactly as `quicconnServerInitKeys` (recv.bit) would for a connection this
// listener was still admitting.
//
// Best-effort and fails closed to a silent drop at every step — a malformed
// header, a sealing failure, or a reply that would exceed the RFC 9000 §8.1
// anti-amplification limit (an address not yet validated by a completed
// handshake must never be sent more than 3x what it sent us) all just
// return without writing to the socket. The caller is the shared demux
// loop, so a write failure here must not propagate either.
fn quicListenerSendRefusal(lst: quicListenerState, data: []byte, host: string, port: int) {
  let hdr = parseLongHeader(data) catch _ {
    return
  }
  let keys = serverInitialKeys(hdr.dcid)
  let frames = [Frame.ConnectionClose(u64(quicconnErrConnectionRefused), u64(0), []byte(0))]
  let payload = encodeFrames(frames)
  let length = quicconnPnLen + len(payload) + 16
  // DCID echoes the client's own SCID (what it expects a reply to be
  // addressed to); SCID is freshly chosen, same as a real accepted
  // connection would (`quicListenerNewConn`) — there is no follow-up packet
  // for the client to match it against either way.
  let header = encodeInitialHeader(
    quicVersion1, hdr.scid, quicconnMakeCid(), []byte(0), u64(length), u64(0), quicconnPnLen,
  )
  let pnOffset = len(header) - quicconnPnLen
  let sealed = protectPayload(keys, u64(0), header, payload) catch _ {
    return
  }
  let packet = quicpktPutBytes(header, sealed)
  let sample = headerSample(sealed, quicconnPnLen) catch _ {
    return
  }
  let mask = aesHeaderMask(keys.hp, sample) catch _ {
    return
  }
  applyHeaderProtection(packet, pnOffset, mask) catch _ {
    return
  }
  if (len(packet) > 3 * len(data)) {
    return
  }
  lst.sock.send(host, port, string(packet)) catch _ {}
}

// Hand a datagram to a connection's inbound channel without blocking: if the
// connection is backed up, drop the datagram — QUIC treats it as loss and the
// peer retransmits, and a stalled connection must not stall the whole listener.
fn quicListenerFeed(inCh: chan<quicconnDgram>, data: []byte, host: string, port: int) {
  select {
    case inCh <- quicconnDgram{ data = data, host = host, port = port, eof = false }:
      {}
    default:
      {}
  }
}

// Create a server connection for a new client, keyed under both the client's
// original DCID (used until the client adopts our SCID) and our own SCID (used
// for 1-RTT). Spawns its ticker, loop, and a reaper that delivers it to `accept`
// and frees its table entries when it ends.
//
// CALLED WITH `lst.mu` HELD (#1912) and does not take it itself. The reaper it
// spawns blocks on `readyCh` before touching the table, so it cannot deadlock
// against the caller's critical section.
fn quicListenerNewConn(lst: quicListenerState, clientKey: string): quicconnState! {
  let scid = quicconnMakeCid()
  let tp = quicconnLocalParams(scid)
  let ext = Extension{
    extType = quicTransportParametersExtension,
    data = encodeTransportParameters(tp),
  }
  let s = tlsServerStartExts(lst.cfg, [ext])?
  // Does NOT own the socket: `lst.sock` is shared with the listener's recv loop
  // and every sibling connection, so closing it here would destroy all of them.
  let st = quicconnNewState(false, lst.sock, false, "", 0, scid, []byte(0))
  st.shOpt = Option.Some(s)
  st.serverHsTimeout = true
  let scidKey = string(scid)
  lst.conns[clientKey] = st.inCh
  lst.present[clientKey] = 1
  lst.conns[scidKey] = st.inCh
  lst.present[scidKey] = 1
  lst.count = lst.count + 1
  lst.handshaking = lst.handshaking + 1
  spawn quicconnTicker(st)
  spawn quicconnLoop(st)
  spawn quicListenerReap(lst, st, clientKey, scidKey)
  return st
}

// Per-connection reaper: publish the connection to `accept` once established,
// then wait for its loop to end and release its demux entries so the table and
// green-thread count stay bounded.
fn quicListenerReap(lst: quicListenerState, st: quicconnState, k1: string, k2: string) {
  let r = <- st.readyCh
  // The handshake phase is resolved the moment `readyCh` answers, one way or
  // the other (established, or `quicconnFail` gave up) — free the admission
  // slot here rather than waiting for the connection to fully close, so a
  // reaped or long-lived established connection cannot also hold open a
  // mid-handshake slot it no longer occupies.
  lst.mu.lock()
  lst.handshaking = lst.handshaking - 1
  lst.mu.unlock()
  if (r > 0) {
    lst.acceptCh <- Conn{
      cmdCh = st.cmdCh, sock = lst.sock, peerHost = st.handshakePeerHost, doneCh = st.doneCh,
      acceptedCh = st.acceptedCh, tx = st.flowTx,
    }
  }
  <- st.doneCh
  lst.mu.lock()
  quicListenerDrop(lst, k1)
  if (k2 != k1) {
    quicListenerDrop(lst, k2)
  }
  lst.count = lst.count - 1
  lst.mu.unlock()
}

// Remove one demux key if present. CALLED WITH `lst.mu` HELD (#1912).
fn quicListenerDrop(lst: quicListenerState, key: string) {
  if (lst.present[key] != 0) {
    lst.present[key] = 0
    delete(lst.conns, key)
  }
}

// Extract the Destination Connection ID from the first packet in a datagram. A
// long header carries an explicit DCID-length byte (RFC 9000 §17.2); a short
// header omits it (§17.3), so the DCID is our own fixed issued length. Returns an
// empty slice on a datagram too short to hold a header, which the caller drops.
fn quicDemuxDcid(data: []byte): []byte {
  if (len(data) < 1) {
    return []byte(0)
  }
  let first = data[0]
  if ((first & 0x80) != 0) {
    if (len(data) < 6) {
      return []byte(0)
    }
    let dcidLen = int(data[5])
    if (6 + dcidLen > len(data)) {
      return []byte(0)
    }
    return quicconnCopyRange(data, 6, 6 + dcidLen)
  }
  if ((first & 0x40) != 0) {
    if (1 + quicconnCidLen > len(data)) {
      return []byte(0)
    }
    return quicconnCopyRange(data, 1, 1 + quicconnCidLen)
  }
  return []byte(0)
}

// Whether a datagram's first packet is a long-header Initial — the only packet
// that may open a new connection at the listener (RFC 9000 §17.2.2).
fn quicDemuxIsInitial(data: []byte): bool {
  if (len(data) < 1) {
    return false
  }
  let first = data[0]
  if ((first & 0x80) == 0) {
    return false
  }
  return int((first >> 4) & 0x03) == longInitial
}

