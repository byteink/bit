// stdlib/quic/initialpad.test.bit — a client's ack-eliciting Initial datagram is
// at least 1200 bytes whatever the connection id lengths (#7730, RFC 9000
// §14.1). The payload used to be padded to a fixed 1160 bytes, which reached
// 1200 only with ids of about 8 bytes: a 0-length DCID and SCID left the
// datagram 1176 bytes, and 20-byte ids made it 1226 for no reason.
//
// Every test drives one client state through `quicconnFlushHandshake` and reads
// the datagram off a loopback socket. `quicconnNewState`, `quicconnQueueCrypto`,
// `clientInitialKeys` are module siblings.

const ipadFloor: int = 1200
const ipadHello: int = 90

fn ipadBind(): UdpSocket {
  return udpBind("127.0.0.1", 0) catch e {
    assert(false, "udpBind: ${e.message()}")
    return UdpSocket{}
  }
}

// A client with Initial and Handshake keys, one ClientHello-sized CRYPTO flight
// queued on Initial, ids of the given lengths, pointed at `peer`.
fn ipadClient(peer: UdpSocket, dcidLen: int, scidLen: int): quicconnState {
  let port = peer.port() catch _ {
    return quicconnNewState(true, peer, false, "127.0.0.1", 1, []byte(0), []byte(0))
  }
  let dcid = randomBytes(dcidLen)
  let st = quicconnNewState(true, peer, false, "127.0.0.1", port, randomBytes(scidLen), dcid)
  st.havePeer = true
  let keys = clientInitialKeys(dcid)
  st.iLevel.ksend = keys
  st.iLevel.haveSend = true
  st.hLevel.ksend = keys
  st.hLevel.haveSend = true
  quicconnQueueCrypto(st, quicconnLvlInitial, []byte(ipadHello))
  return st
}

fn ipadFlush(st: quicconnState) {
  quicconnFlushHandshake(st) catch e {
    assert(false, "quicconnFlushHandshake: ${e.message()}")
  }
}

fn ipadRecvLen(peer: UdpSocket): int {
  let d = peer.recv(4096) catch e {
    assert(false, "recv: ${e.message()}")
    return 0
  }
  return len(d.data)
}

test "a client Initial datagram reaches 1200 bytes for every connection id length" {
  let dcids = [0, 8, 20]
  let scids = [0, 20]
  for d of dcids {
    for s of scids {
      let peer = ipadBind()
      let st = ipadClient(peer, d, s)
      ipadFlush(st)
      let n = ipadRecvLen(peer)
      assert(n >= ipadFloor, "dcid ${d} scid ${s}: datagram ${n} bytes, want >= ${ipadFloor}")
      // The floor is a floor, not a ceiling: nothing pads past it by more than
      // the one byte the Length varint can grow by.
      assert(n <= ipadFloor + 1, "dcid ${d} scid ${s}: datagram ${n} bytes, padded past the floor")
    }
  }
}

test "a client Initial coalesced with a Handshake packet still reaches 1200 bytes in total" {
  let dcids = [0, 8, 20]
  let scids = [0, 20]
  for d of dcids {
    for s of scids {
      let peer = ipadBind()
      let st = ipadClient(peer, d, s)
      quicconnQueueCrypto(st, quicconnLvlHandshake, []byte(ipadHello))
      ipadFlush(st)
      let n = ipadRecvLen(peer)
      assert(
        n >= ipadFloor,
        "coalesced dcid ${d} scid ${s}: datagram ${n} bytes, want >= ${ipadFloor}",
      )
      assert(
        n <= ipadFloor + 1,
        "coalesced dcid ${d} scid ${s}: datagram ${n} bytes, padded past the floor",
      )
      assert(len(st.iLevel.sent) == 1 && len(st.hLevel.sent) == 1, "one packet per space")
    }
  }
}

test "a server Initial is not padded" {
  let peer = ipadBind()
  let st = ipadClient(peer, 8, 8)
  st.isClient = false
  ipadFlush(st)
  let n = ipadRecvLen(peer)
  assert(n < ipadFloor, "server Initial datagram ${n} bytes, want unpadded")
}
