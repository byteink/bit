// stdlib/quic/listener.test.bit — `Listener.stopAccepting`'s stateless
// refusal reply (#6158): a well-formed client Initial arriving after
// `stopAccepting()` gets an Initial packet back carrying
// CONNECTION_CLOSE(CONNECTION_REFUSED) (RFC 9000 §5.2.2, §20.1) instead of
// being dropped, so `dialQuic` fails immediately rather than running out its
// full `quicconnHandshakeTimeout`. A malformed datagram still falls back to
// a silent drop and must not disturb the listener loop's ability to answer
// the next, well-formed one.
//
// `dialQuic`, `listenQuic`, `Listener`, `Frame`, `parseLongHeader`,
// `quicconnParseLongHeader`, `serverInitialKeys`, `aesHeaderMask`,
// `removeHeaderProtection`, `unprotectPayload`, `parseFrames`,
// `encodeInitialHeader`, `quicpktPutBytes`, `quicconnCopyRange`,
// `quicconnDecodePn`, `quicVersion1`, `quicconnPnLen`, `quicconnCidLen` are
// all module siblings (api.bit, listener.bit, packet.bit, frames.bit,
// recv.bit, conn.bit — "stdlib/quic is one flat module"); `udpBind`,
// `UdpSocket`, `monotonic`, `sleep`, `randomBytes` too (conn.bit already
// imports them for the module). `Datagram` (std/net), `since`/`Millisecond`
// (std/time), and `decodeHex`/`pemEncode` (std/crypto) are new to this
// module.
import { Datagram } from "std/net"
import { since, Millisecond } from "std/time"
import { decodeHex, pemEncode } from "std/crypto"

// The same throwaway self-signed leaf/key every loopback TLS fixture in this
// repo uses (e.g. stdlib/http/tls.test.bit, _tests_/imports/quicconn) —
// `insecureSkipVerify` on the client side means no CA chain is needed.
const quicRefusalLeafHex: string = ""
const quicRefusalKeyHex: string = ""

fn quicRefusalHex(s: string): []byte {
  return decodeHex(s) catch _ {
    return []byte(0)
  }
}
fn quicRefusalCertPem(): string {
  return pemEncode("CERTIFICATE", quicRefusalHex(quicRefusalLeafHex))
}
fn quicRefusalKeyPem(): string {
  return pemEncode("PRIVATE KEY", quicRefusalHex(quicRefusalKeyHex))
}

// `dialQuic`'s own error message is all a caller ever sees on a refused
// handshake (the peer's CONNECTION_CLOSE code is not plumbed up through the
// public API) — empty means the dial unexpectedly succeeded.
fn quicRefusalDialFails(port: int): string {
  dialQuic("127.0.0.1", port, "localhost") catch e {
    return e.message()
  }
  return ""
}

fn quicRefusalRecv(sock: UdpSocket, ch: chan<Datagram>) {
  let d = sock.recv(2048) catch _ {
    return
  }
  ch <- d
}

fn quicRefusalTimeout(ms: int, ch: chan<bool>) {
  sleep(ms * Millisecond)
  ch <- true
}

test "a client dialing during a drain is refused promptly instead of timing out at 5s" {
  let sock = udpBind("127.0.0.1", 0) catch e {
    assert(false, "udpBind: ${e.message()}")
    return
  }
  let port = sock.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let lst = listenQuic(sock, quicRefusalCertPem(), quicRefusalKeyPem()) catch e {
    assert(false, "listenQuic: ${e.message()}")
    return
  }
  lst.stopAccepting()

  let t0 = monotonic()
  let errMsg = quicRefusalDialFails(port)
  let elapsedMs = since(t0) / Millisecond
  assert(len(errMsg) > 0, "dial against a draining listener unexpectedly succeeded")
  assert(
    elapsedMs < 2000,
    "dial took ${elapsedMs}ms, want well under the 5000ms handshake timeout — the refusal should be prompt",
  )
}

// RFC 9000 §5.2 (the ordinary stray-packet case) vs §5.2.2 (refusing an
// actual connection attempt): a datagram too short to carry a DCID must
// still be a silent drop, and must not stop the listener loop from
// answering the well-formed Initial sent right after it.
test "a malformed Initial during a drain is silently dropped, not a crash" {
  let sock = udpBind("127.0.0.1", 0) catch e {
    assert(false, "udpBind: ${e.message()}")
    return
  }
  let port = sock.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let lst = listenQuic(sock, quicRefusalCertPem(), quicRefusalKeyPem()) catch e {
    assert(false, "listenQuic: ${e.message()}")
    return
  }
  lst.stopAccepting()

  let raw = udpBind("127.0.0.1", 0) catch e {
    assert(false, "udpBind (raw): ${e.message()}")
    return
  }
  raw.send("127.0.0.1", port, string([]byte{ 0xc0 })) catch e {
    assert(false, "send (malformed): ${e.message()}")
    return
  }

  let t0 = monotonic()
  let errMsg = quicRefusalDialFails(port)
  let elapsedMs = since(t0) / Millisecond
  assert(len(errMsg) > 0, "dial after a malformed datagram unexpectedly succeeded")
  assert(
    elapsedMs < 2000,
    "listener did not recover promptly after a malformed datagram: ${elapsedMs}ms",
  )
}

test "a well-formed Initial during a drain gets a stateless CONNECTION_CLOSE(CONNECTION_REFUSED) reply" {
  let sock = udpBind("127.0.0.1", 0) catch e {
    assert(false, "udpBind: ${e.message()}")
    return
  }
  let port = sock.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let lst = listenQuic(sock, quicRefusalCertPem(), quicRefusalKeyPem()) catch e {
    assert(false, "listenQuic: ${e.message()}")
    return
  }
  lst.stopAccepting()

  let client = udpBind("127.0.0.1", 0) catch e {
    assert(false, "udpBind (client): ${e.message()}")
    return
  }

  // A minimal but well-formed client Initial (RFC 9000 §17.2.2): the
  // listener's refusal path never decrypts the client's own payload, so an
  // arbitrary 200-byte filler stands in for a real CRYPTO frame.
  let dcid = randomBytes(quicconnCidLen)
  let scid = randomBytes(quicconnCidLen)
  let fakeCryptoPayload = []byte(200)
  let length = u64(quicconnPnLen + len(fakeCryptoPayload))
  let header = encodeInitialHeader(
    quicVersion1,
    dcid,
    scid,
    []byte(0),
    length,
    u64(0),
    quicconnPnLen,
  )
  let packet = quicpktPutBytes(header, fakeCryptoPayload)
  client.send("127.0.0.1", port, string(packet)) catch e {
    assert(false, "send (Initial): ${e.message()}")
    return
  }

  let replyCh = chan<Datagram>(1)
  spawn quicRefusalRecv(client, replyCh)
  let timeoutCh = chan<bool>(1)
  spawn quicRefusalTimeout(2000, timeoutCh)
  let gotReply = false
  let replyBytes = []byte(0)
  select {
    case d = <- replyCh:
      gotReply = true
      replyBytes = []byte(d.data)
    case _ = <- timeoutCh:
      {}
  }
  if (!gotReply) {
    assert(false, "no reply within 2s of a well-formed Initial sent to a draining listener")
    return
  }

  let hdr = parseLongHeader(replyBytes) catch e {
    assert(false, "parseLongHeader: ${e.message()}")
    return
  }
  assert(string(hdr.dcid) == string(scid), "reply DCID does not echo the client's own SCID")

  // Decrypt exactly as a real client would (`quicconnDecryptAndProcess`,
  // recv.bit), keyed by the same client DCID `serverInitialKeys` used to
  // seal the reply (`quicListenerSendRefusal`, listener.bit).
  let h2 = quicconnParseLongHeader(replyBytes, 0) catch e {
    assert(false, "quicconnParseLongHeader: ${e.message()}")
    return
  }
  let pkt = quicconnCopyRange(replyBytes, 0, h2.packetEnd)
  let pnOffLocal = h2.pnOffset
  if (pnOffLocal + 20 > len(pkt)) {
    assert(false, "reply too short for a header-protection sample")
    return
  }
  let sample = pkt[pnOffLocal + 4:pnOffLocal + 20]
  let keys = serverInitialKeys(dcid)
  let mask = aesHeaderMask(keys.hp, sample) catch e {
    assert(false, "aesHeaderMask: ${e.message()}")
    return
  }
  let pnLen = removeHeaderProtection(pkt, pnOffLocal, mask) catch e {
    assert(false, "removeHeaderProtection: ${e.message()}")
    return
  }
  let trunc = 0
  let i = 0
  while (i < pnLen) {
    trunc = (trunc << 8) | int(pkt[pnOffLocal + i])
    i = i + 1
  }
  let fullPn = quicconnDecodePn(-1, trunc, pnLen)
  let aadEnd = pnOffLocal + pnLen
  let aad = pkt[0:aadEnd]
  let ct = pkt[aadEnd:len(pkt)]
  let pt = unprotectPayload(keys, u64(fullPn), aad, ct) catch e {
    assert(false, "unprotectPayload: ${e.message()}")
    return
  }
  let frames = parseFrames(pt) catch e {
    assert(false, "parseFrames: ${e.message()}")
    return
  }
  if (len(frames) == 0) {
    assert(false, "reply carried no frames")
    return
  }
  match (frames[0]) {
    ConnectionClose(code, frameType, reason) => {
      assert(code == u64(2), "CONNECTION_CLOSE code = ${code}, want 2 (CONNECTION_REFUSED)")
      assert(frameType == u64(0), "CONNECTION_CLOSE frame type = ${frameType}, want 0")
      assert(len(reason) == 0, "CONNECTION_CLOSE reason should be empty")
    }
    _ => { assert(false, "reply's first frame was not CONNECTION_CLOSE") }
  }
}
