// Bit standard library — quic module, the QUIC frame classifiers.
//
// Split out of `conn.bit` (#1503) to keep files readable; `stdlib/quic` is one
// flat module, so this file shares that file's imports and namespace.

// ---------------------------------------------------------------------------
// Frame classifiers (exhaustive matches, reused everywhere)
// ---------------------------------------------------------------------------

// Whether `f` is ack-eliciting (RFC 9002 §2): its receipt obliges the peer to
// send an ACK, and it counts against congestion control. ACK, PADDING, and the
// CLOSE frames are not.
function quicconnIsAckEliciting(f: Frame): bool {
  match (f) {
    Padding(n) => { return false }
    Ping => { return true }
    Ack(a) => { return false }
    ResetStream(id, code, size) => { return true }
    StopSending(id, code) => { return true }
    Crypto(offset, data) => { return true }
    NewToken(token) => { return true }
    Stream(s) => { return true }
    MaxData(m) => { return true }
    MaxStreamData(id, m) => { return true }
    MaxStreams(bidi, m) => { return true }
    DataBlocked(m) => { return true }
    StreamDataBlocked(id, m) => { return true }
    StreamsBlocked(bidi, m) => { return true }
    NewConnectionId(seq, retire, cid, token) => { return true }
    RetireConnectionId(seq) => { return true }
    PathChallenge(d) => { return true }
    PathResponse(d) => { return true }
    ConnectionClose(code, ft, reason) => { return false }
    ApplicationClose(code, reason) => { return false }
    HandshakeDone => { return true }
  }
}

// Whether `f` carries state that must be retransmitted if its packet is lost
// (RFC 9002 §6): CRYPTO, STREAM, and the flow/stream-control frames. ACK,
// PADDING, PING, PATH_*, and CLOSE are regenerated or dropped, never resent.
function quicconnIsRetransmittable(f: Frame): bool {
  match (f) {
    Padding(n) => { return false }
    Ping => { return false }
    Ack(a) => { return false }
    ResetStream(id, code, size) => { return true }
    StopSending(id, code) => { return true }
    Crypto(offset, data) => { return true }
    NewToken(token) => { return true }
    Stream(s) => { return true }
    MaxData(m) => { return true }
    MaxStreamData(id, m) => { return true }
    MaxStreams(bidi, m) => { return true }
    DataBlocked(m) => { return true }
    StreamDataBlocked(id, m) => { return true }
    StreamsBlocked(bidi, m) => { return true }
    NewConnectionId(seq, retire, cid, token) => { return true }
    RetireConnectionId(seq) => { return true }
    PathChallenge(d) => { return false }
    PathResponse(d) => { return false }
    ConnectionClose(code, ft, reason) => { return false }
    ApplicationClose(code, reason) => { return false }
    HandshakeDone => { return true }
  }
}

// The stream id `f` targets when it is a STREAM frame, else -1.
function quicconnFrameStreamId(f: Frame): int {
  match (f) {
    Padding(n) => { return -1 }
    Ping => { return -1 }
    Ack(a) => { return -1 }
    ResetStream(id, code, size) => { return -1 }
    StopSending(id, code) => { return -1 }
    Crypto(offset, data) => { return -1 }
    NewToken(token) => { return -1 }
    Stream(s) => { return int(s.id) }
    MaxData(m) => { return -1 }
    MaxStreamData(id, m) => { return -1 }
    MaxStreams(bidi, m) => { return -1 }
    DataBlocked(m) => { return -1 }
    StreamDataBlocked(id, m) => { return -1 }
    StreamsBlocked(bidi, m) => { return -1 }
    NewConnectionId(seq, retire, cid, token) => { return -1 }
    RetireConnectionId(seq) => { return -1 }
    PathChallenge(d) => { return -1 }
    PathResponse(d) => { return -1 }
    ConnectionClose(code, ft, reason) => { return -1 }
    ApplicationClose(code, reason) => { return -1 }
    HandshakeDone => { return -1 }
  }
}

// The send-side byte range `f` carries, as `[lo, hi]` inclusive, or `lo > hi`
// when it carries no stream bytes. Paired with `quicconnFrameStreamId` to record
// what a newly-acknowledged packet actually delivered.
function quicconnFrameStreamLo(f: Frame): int {
  match (f) {
    Padding(n) => { return 0 }
    Ping => { return 0 }
    Ack(a) => { return 0 }
    ResetStream(id, code, size) => { return 0 }
    StopSending(id, code) => { return 0 }
    Crypto(offset, data) => { return 0 }
    NewToken(token) => { return 0 }
    Stream(s) => { return int(s.offset) }
    MaxData(m) => { return 0 }
    MaxStreamData(id, m) => { return 0 }
    MaxStreams(bidi, m) => { return 0 }
    DataBlocked(m) => { return 0 }
    StreamDataBlocked(id, m) => { return 0 }
    StreamsBlocked(bidi, m) => { return 0 }
    NewConnectionId(seq, retire, cid, token) => { return 0 }
    RetireConnectionId(seq) => { return 0 }
    PathChallenge(d) => { return 0 }
    PathResponse(d) => { return 0 }
    ConnectionClose(code, ft, reason) => { return 0 }
    ApplicationClose(code, reason) => { return 0 }
    HandshakeDone => { return 0 }
  }
}

function quicconnFrameStreamLen(f: Frame): int {
  match (f) {
    Padding(n) => { return -1 }
    Ping => { return -1 }
    Ack(a) => { return -1 }
    ResetStream(id, code, size) => { return -1 }
    StopSending(id, code) => { return -1 }
    Crypto(offset, data) => { return -1 }
    NewToken(token) => { return -1 }
    Stream(s) => { return len(s.data) }
    MaxData(m) => { return -1 }
    MaxStreamData(id, m) => { return -1 }
    MaxStreams(bidi, m) => { return -1 }
    DataBlocked(m) => { return -1 }
    StreamDataBlocked(id, m) => { return -1 }
    StreamsBlocked(bidi, m) => { return -1 }
    NewConnectionId(seq, retire, cid, token) => { return -1 }
    RetireConnectionId(seq) => { return -1 }
    PathChallenge(d) => { return -1 }
    PathResponse(d) => { return -1 }
    ConnectionClose(code, ft, reason) => { return -1 }
    ApplicationClose(code, reason) => { return -1 }
    HandshakeDone => { return -1 }
  }
}

function quicconnFrameStreamFin(f: Frame): bool {
  match (f) {
    Padding(n) => { return false }
    Ping => { return false }
    Ack(a) => { return false }
    ResetStream(id, code, size) => { return false }
    StopSending(id, code) => { return false }
    Crypto(offset, data) => { return false }
    NewToken(token) => { return false }
    Stream(s) => { return s.fin }
    MaxData(m) => { return false }
    MaxStreamData(id, m) => { return false }
    MaxStreams(bidi, m) => { return false }
    DataBlocked(m) => { return false }
    StreamDataBlocked(id, m) => { return false }
    StreamsBlocked(bidi, m) => { return false }
    NewConnectionId(seq, retire, cid, token) => { return false }
    RetireConnectionId(seq) => { return false }
    PathChallenge(d) => { return false }
    PathResponse(d) => { return false }
    ConnectionClose(code, ft, reason) => { return false }
    ApplicationClose(code, reason) => { return false }
    HandshakeDone => { return false }
  }
}

// Whether `f` is a CRYPTO frame — used to decide whether a client Initial packet
// must be padded to the 1200-byte floor.
function quicconnIsCrypto(f: Frame): bool {
  match (f) {
    Padding(n) => { return false }
    Ping => { return false }
    Ack(a) => { return false }
    ResetStream(id, code, size) => { return false }
    StopSending(id, code) => { return false }
    Crypto(offset, data) => { return true }
    NewToken(token) => { return false }
    Stream(s) => { return false }
    MaxData(m) => { return false }
    MaxStreamData(id, m) => { return false }
    MaxStreams(bidi, m) => { return false }
    DataBlocked(m) => { return false }
    StreamDataBlocked(id, m) => { return false }
    StreamsBlocked(bidi, m) => { return false }
    NewConnectionId(seq, retire, cid, token) => { return false }
    RetireConnectionId(seq) => { return false }
    PathChallenge(d) => { return false }
    PathResponse(d) => { return false }
    ConnectionClose(code, ft, reason) => { return false }
    ApplicationClose(code, reason) => { return false }
    HandshakeDone => { return false }
  }
}

// The concatenated wire length of `frames`, without keeping the bytes.
function quicconnFramesLen(frames: []Frame): int {
  let n = 0
  for f of frames {
    n = n + len(encodeFrame(f))
  }
  return n
}

// The retransmittable subset of `frames`, stored on a sent packet so a loss can
// re-queue exactly the state it carried.
function quicconnRetransFrames(frames: []Frame): []Frame {
  let out = []Frame(0)
  for f of frames {
    if (quicconnIsRetransmittable(f)) {
      out = append(out, f)
    }
  }
  return out
}

function quicconnAnyAckEliciting(frames: []Frame): bool {
  for f of frames {
    if (quicconnIsAckEliciting(f)) {
      return true
    }
  }
  return false
}

function quicconnFramesHaveCrypto(frames: []Frame): bool {
  for f of frames {
    if (quicconnIsCrypto(f)) {
      return true
    }
  }
  return false
}

