// stdlib/quic/rewrite.test.bit — a caller may reuse the []byte it passed to
// `Stream.write` (#7734): the stream must not keep or key on the caller's slice
// once `write` returns (the io.Writer contract). Writing one slice twice, then
// mutating it and writing it a third time, delivers the three payloads in order.
// `quicRefusalCertPem`/`quicRefusalKeyPem` (listener.test.bit) and
// `quicAcceptClientConfig` (accept.test.bit) supply the identity.
const qrSize: int = 3000

// Server: accept the stream, read until `3 * qrSize` bytes arrived, answer
// "ok" when they are the three payloads in order, else what was wrong.
fn qrServer(sock: UdpSocket, resultCh: chan<string>) {
  let conn = acceptQuic(sock, quicRefusalCertPem(), quicRefusalKeyPem()) catch _ {
    resultCh <- "handshake-failed"
    return
  }
  let s = conn.acceptStream() catch _ {
    resultCh <- "accept-failed"
    return
  }
  let got = []byte(0)
  while (len(got) < 3 * qrSize) {
    let c = s.read() catch _ {
      resultCh <- "read-failed:${len(got)}"
      return
    }
    for b of c.data {
      got = append(got, b)
    }
  }
  resultCh <- qrVerify(got)
  conn.close()
}

// The i-th byte of payload `p` (0, 1, 2) is `p + 1` for the first two writes
// and `7` for the third, so any reordering, duplication or aliasing shows.
fn qrVerify(got: []byte): string {
  if (len(got) != 3 * qrSize) {
    return "length:${len(got)}"
  }
  let want = [1, 1, 7]
  let p = 0
  while (p < 3) {
    let i = 0
    while (i < qrSize) {
      if (int(got[p * qrSize + i]) != want[p]) {
        return "payload ${p} byte ${i} is ${got[p * qrSize + i]}, want ${want[p]}"
      }
      i = i + 1
    }
    p = p + 1
  }
  return "ok"
}

fn qrFill(buf: []byte, v: int) {
  let i = 0
  while (i < len(buf)) {
    buf[i] = byte(v)
    i = i + 1
  }
}

test "writing one []byte twice, then mutated, delivers the three payloads in order" {
  let srv = udpBind("127.0.0.1", 0) catch e {
    assert(false, "udpBind: ${e.message()}")
    return
  }
  let port = srv.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let res = chan<string>(1)
  spawn qrServer(srv, res)
  let conn = dialQuicTls("127.0.0.1", port, "localhost", quicAcceptClientConfig()) catch e {
    assert(false, "dialQuicTls: ${e.message()}")
    return
  }
  let s = conn.openStream() catch e {
    assert(false, "openStream: ${e.message()}")
    return
  }
  let buf = []byte(qrSize)
  qrFill(buf, 1)
  s.write(buf) catch e {
    assert(false, "write 1: ${e.message()}")
  }
  s.write(buf) catch e {
    assert(false, "write 2: ${e.message()}")
  }
  qrFill(buf, 7)
  s.write(buf) catch e {
    assert(false, "write 3: ${e.message()}")
  }
  let verdict = qrAwait(res)
  assert(verdict == "ok", "peer saw: ${verdict}")
  conn.close()
}

// The server's answer, or "timeout" after 2 s.
fn qrAwait(res: chan<string>): string {
  let waited = 0
  while (waited < 200) {
    select {
      case v = <- res:
        return v
      default:
        sleep(10 * Millisecond)
    }
    waited = waited + 1
  }
  return "timeout"
}
