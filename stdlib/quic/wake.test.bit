// A deadline covers command admission and replies without a timer worker.
fn qbFinish(s: Stream, bound: quicconnStreamBound, done: chan<string>) {
  streamFinishBounded(s, bound.wake, bound.deadlineNs) catch e {
    done <- e.message()
    return
  }
  done <- "unexpected success"
}

fn qbResult(done: chan<string>): string! {
  let timer = Timer(Second)
  defer {
    let _ = timer.stop()
  }
  select {
    case value = <- done:
      return value
    case _ = <- timer.c:
      fail newError("quic test: bounded operation did not return")
  }
}

fn qbReadError(s: Stream, deadlineNs: int): string {
  streamReadBounded(s, chan<int>(1), deadlineNs) catch e {
    return e.message()
  }
  return "unexpected success"
}

test "bounded receive preserves peer reset instead of treating it as connection EOF" {
  let st = qaState()
  defer st.sock.close()
  let s = qwAbortHandle(st)
  st.streams[0].recvCh <- StreamChunk{ reset = true, resetCode = 9 }
  let chunk = streamReadBounded(s, chan<int>(1), monotonic().ns + Second) catch e {
    assert(false, e.message())
    return
  }
  assert(chunk.reset && chunk.resetCode == 9, "peer reset survives the receive bound")
}

test "bounded receive deadline expires without consuming a later chunk" {
  let st = qaState()
  defer st.sock.close()
  let s = qwAbortHandle(st)
  assert(
    qbReadError(s, monotonic().ns + 10 * Millisecond) == "quic: stream deadline exceeded",
    "a stalled receive must expire",
  )
  st.streams[0].recvCh <- StreamChunk{ fin = true }
  let chunk = streamReadUntil(s, chan<int>(1)) catch e {
    assert(false, e.message())
    return
  }
  assert(chunk.fin, "EOF remains readable after a timeout")
}

test "bounded FIN refuses a closed actor with all64 command slots full" {
  let st = qaState()
  defer st.sock.close()
  let s = qwAbortHandle(st)
  qwFillCommands(st)
  close(st.doneCh)
  streamFinishBounded(s, chan<int>(1), monotonic().ns + Second) catch e {
    assert(e.message() == "quic: connection closed before the stream drained", e.message())
    return
  }
  assert(false, "a closed actor cannot acknowledge FIN")
}

test "bounded FIN admission wakes while a live command queue is full" {
  let st = qaState()
  defer st.sock.close()
  let s = qwAbortHandle(st)
  qwFillCommands(st)
  let wake = chan<int>(1)
  let bound = quicconnStreamBound(wake, monotonic().ns + Second)
  defer bound.stop()
  let done = chan<string>(1)
  spawn qbFinish(s, bound, done)
  sleep(10 * Millisecond)
  wake <- 1
  let result = qbResult(done) catch e {
    assert(false, e.message())
    return
  }
  assert(result == "quic: wait woken", "command admission observes cancellation")
}

test "bounded FIN deadline covers its acknowledgement wait" {
  let st = qaState()
  defer st.sock.close()
  let s = qwAbortHandle(st)
  streamFinishBounded(s, chan<int>(1), monotonic().ns + 10 * Millisecond) catch e {
    assert(e.message() == "quic: stream deadline exceeded", e.message())
    assert((<- st.cmdCh).kind == quicconnCmdFinish, "FIN was admitted before timeout")
    return
  }
  assert(false, "FIN without an actor reply must expire")
}

test "try abort refuses a live full64 command queue without consuming it" {
  let st = qaState()
  defer st.sock.close()
  let s = qwAbortHandle(st)
  qwFillCommands(st)
  assert(!streamTryAbort(s, 9), "full command queue reports incomplete cleanup")
  assert((<- st.cmdCh).kind == quicconnCmdWriteDrained, "queued work remains intact")
  select {
    case _ = <- st.doneCh:
      assert(false, "bounded cleanup must not close the connection")
    default:
      {}
  }
}

test "try abort reports incomplete cleanup when STOP cannot follow RESET" {
  let st = qaState()
  defer st.sock.close()
  let s = qwAbortHandle(st)
  let i = 0
  while (i < 63) {
    st.cmdCh <- qwWriteCmd()
    i = i + 1
  }
  assert(!streamTryAbort(s, 9), "partial command admission is explicit")
  i = 0
  while (i < 63) {
    assert((<- st.cmdCh).kind == quicconnCmdWriteDrained, "prior work retained")
    i = i + 1
  }
  assert((<- st.cmdCh).kind == quicconnCmdReset, "RESET is retained before missing STOP")
}

test "try abort bounds receive credit discard and preserves queued notes" {
  let st = qaState()
  defer st.sock.close()
  let s = qwAbortHandle(st)
  let i = 0
  while (i < quicconnReadQueue) {
    st.flowTx.readCh <- quicconnRead{ id = 7, bytes = 1 }
    i = i + 1
  }
  assert(!streamTryAbort(s, 9), "full read queue reports incomplete cleanup")
  assert((<- st.cmdCh).kind == quicconnCmdReset, "RESET admitted")
  assert((<- st.cmdCh).kind == quicconnCmdStopSending, "STOP admitted")
  let note = <- st.flowTx.readCh
  assert(note.id == 7 && note.bytes == 1 && !note.discard, "read notes retained")
}

test "try abort admits both directions and discarded receive credit" {
  let st = qaState()
  defer st.sock.close()
  let s = qwAbortHandle(st)
  assert(streamTryAbort(s, 9), "available queues accept complete cleanup")
  let reset = <- st.cmdCh
  let stop = <- st.cmdCh
  assert(reset.kind == quicconnCmdReset && stop.kind == quicconnCmdStopSending, "ordered cleanup")
  assert(string(reset.data) == string(encodeVarint(u64(9))), "application error retained")
  let note = <- st.flowTx.readCh
  assert(note.id == s.id() && note.discard, "receive credit discard admitted")
}

fn qrCreditRead(s: Stream, wake: chan<int>, deadline: int, done: chan<string>) {
  streamReadBounded(s, wake, deadline) catch e {
    done <- e.message()
    return
  }
  done <- "unexpected success"
}

fn qrCreditResult(st: quicconnState, done: chan<string>): string! {
  let timer = Timer(Second)
  defer { let _ = timer.stop() }
  select {
    case result = <- done:
      return result
    case _ = <- timer.c:
      close(st.doneCh)
      let _ = <- done
      fail newError("bounded read credit ignored its wake or deadline")
  }
}

fn qrCredit(kind: int): ()! {
  let st = qaState()
  defer st.sock.close()
  let s = qwAbortHandle(st)
  let data = []byte("fin")
  if (kind == 1) { data = []byte(quicconnReadBatchBytes) }
  if (kind == 2) {
    data = []byte("tail")
    s.acct.bytes = 3
    s.acct.chunks = quicconnReadBatchChunks - 1
  }
  let oldBytes = s.acct.bytes
  let oldChunks = s.acct.chunks
  let i = 0
  while (i < quicconnReadQueue) {
    st.flowTx.readCh <- quicconnRead{ id = 7, bytes = i + 1 }
    i = i + 1
  }
  s.recvCh <- StreamChunk{ data = data, fin = kind == 0 }
  let wake = chan<int>(1)
  let deadline = monotonic().ns + 100 * Millisecond
  let done = chan<string>(1)
  spawn qrCreditRead(s, wake, deadline, done)
  if (kind != 0) {
    sleep(20 * Millisecond)
    wake <- 1
  }
  let result = qrCreditResult(st, done)?
  let want = "quic: wait woken"
  if (kind == 0) { want = "quic: stream deadline exceeded" }
  assert(result == want, result)
  select {
    case _ = <- s.recvCh:
      assert(false, "the full-credit wait must follow actual chunk receipt")
    default: {}
  }
  assert(s.acct.bytes == oldBytes && s.acct.chunks == oldChunks, "failed admission commits no credit")
  i = 0
  while (i < quicconnReadQueue) {
    let note = <- st.flowTx.readCh
    assert(note.id == 7 && note.bytes == i + 1, "prior credit FIFO remains exact")
    i = i + 1
  }
  let resumed = StreamChunk{}
  if (kind == 0) {
    resumed = streamReadBounded(s, chan<int>(1), monotonic().ns + Second)?
  } else if (kind == 1) {
    resumed = streamReadUntil(s, chan<int>(1))?
  } else { resumed = s.read()? }
  assert(string(resumed.data) == string(data) && resumed.fin == (kind == 0), "retained chunk resumes exactly")
  let note = <- st.flowTx.readCh
  assert(note.bytes == oldBytes + len(data) && note.chunks == oldChunks + 1, "one exact credit batch")
  s.recvCh <- StreamChunk{ data = []byte("next"), fin = true }
  let next = streamReadBounded(s, chan<int>(1), monotonic().ns + Second)?
  assert(string(next.data) == "next", "next chunk follows retained data")
}

test "bounded read credit deadline retains FIN behind a live full64 queue" {
  qrCredit(0) catch e { assert(false, e.message()) }
}

test "bounded read credit wake retains the byte-threshold chunk behind live full64" {
  qrCredit(1) catch e { assert(false, e.message()) }
}

test "bounded read credit wake retains the sixteenth chunk for ordinary read" {
  qrCredit(2) catch e { assert(false, e.message()) }
}
