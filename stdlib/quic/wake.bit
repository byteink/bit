// Bit standard library — quic module, waking a blocked call from another green
// thread (#7640). Same flat `std/quic` module and namespace as `conn.bit`; the
// functions here read `Stream`'s private channels, which is why they are not
// in another module. `Stream.finish` is `streamFinishUntil` with a wake nothing
// ever sends on.

import { Timer } from "std/time"

// What `streamReadUntil`, `streamFinishUntil` and `dialQuicTlsUntil` fail with
// when their `wake` channel received a value first. The connection is not
// touched by the wake (a dial that was woken is closed, since nobody holds it).
export class Woken {
  export message(): string {
    return "quic: wait woken"
  }
}

// One timer slot per operation, released even when data wins the race.
class quicconnStreamBound {
  wake: chan<int>
  timeout: chan<bool>
  timer: Option<Timer>
  deadlineNs: int

  init(wake: chan<int>, deadlineNs: int) {
    this.wake = wake
    this.deadlineNs = deadlineNs
    this.timeout = chan<bool>(0)
    this.timer = Option.None
    if (deadlineNs != 0) {
      let timer = Timer(deadlineNs - monotonic().ns)
      this.timer = Option.Some(timer)
      this.timeout = timer.c
    }
  }

  check(): ()! {
    select {
      case _ = <- this.wake:
        fail Woken{}
      default:
        {}
    }
    if (this.deadlineNs != 0 && monotonic().ns >= this.deadlineNs) {
      fail newError("quic: stream deadline exceeded")
    }
  }

  stop() {
    if (isSome(this.timer)) {
      let _ = unwrap(this.timer).stop()
    }
  }
}

// A wake or absolute monotonic deadline stops this wait without taking a chunk.
export fn streamReadUntil(s: Stream, wake: chan<int>): StreamChunk! {
  select {
    case _ = <- wake:
      fail Woken{}
    default:
      {}
  }
  select {
    case c = <- s.recvCh:
      if (len(c.data) == 0 && !c.fin && !c.reset) {
        fail newError("quic: connection closed")
      }
      streamNoteRead(s, c)
      return c
    case _ = <- wake:
      fail Woken{}
  }
}

export fn streamReadBounded(s: Stream, wake: chan<int>, deadlineNs: int): StreamChunk! {
  if (deadlineNs == 0) {
    return streamReadUntil(s, wake)?
  }
  let bound = quicconnStreamBound(wake, deadlineNs)
  defer bound.stop()
  bound.check()?
  select {
    case c = <- s.recvCh:
      if (len(c.data) == 0 && !c.fin && !c.reset) {
        fail newError("quic: connection closed")
      }
      streamNoteRead(s, c)
      return c
    case _ = <- bound.wake:
      fail Woken{}
    case _ = <- bound.timeout:
      fail newError("quic: stream deadline exceeded")
  }
}

// The same deadline bounds both command admission and acknowledgement of FIN.
export fn streamFinishUntil(s: Stream, wake: chan<int>): ()! {
  streamFinishBounded(s, wake, 0)?
}

export fn streamFinishBounded(s: Stream, wake: chan<int>, deadlineNs: int): ()! {
  let bound = quicconnStreamBound(wake, deadlineNs)
  defer bound.stop()
  bound.check()?
  let done = chan<int>(1)
  quicconnFinishSend(s, done, bound)?
  let r = quicconnFinishWait(s, done, bound)?
  if (r < 0) {
    fail newError("quic: connection closed before the stream drained")
  }
}

// Best-effort cleanup after a bound expires must not acquire another wait.
export fn streamTryAbort(s: Stream, code: int): bool {
  if (!quicconnTryAbortCommand(s, code, quicconnCmdReset)) {
    return false
  }
  if (!quicconnTryAbortCommand(s, code, quicconnCmdStopSending)) {
    return false
  }
  select {
    case s.tx.readCh <- quicconnRead{ id = s.streamId, discard = true }:
      {}
    default:
      return false
  }
  select {
    case s.tx.wakeCh <- 0:
      {}
    default:
      {}
  }
  return true
}

fn quicconnTryAbortCommand(s: Stream, code: int, kind: int): bool {
  select {
    case _ = <- s.doneCh:
      return false
    default:
      {}
  }
  let cmd = quicconnCmd{
    kind = kind, id = s.streamId, data = encodeVarint(u64(code)),
    replyOpen = chan<quicconnOpenReply>(1), replyInt = chan<int>(1),
  }
  select {
    case s.cmdCh <- cmd:
      return true
    default:
      return false
  }
}

fn quicconnFinishSend(s: Stream, done: chan<int>, bound: quicconnStreamBound): ()! {
  let cmd = quicconnCmd{
    kind = quicconnCmdFinish, id = s.streamId, data = []byte(0),
    replyOpen = chan<quicconnOpenReply>(1), replyInt = done,
  }
  select {
    case s.cmdCh <- cmd:
      {}
    case _ = <- s.doneCh:
      fail newError("quic: connection closed before the stream drained")
    case _ = <- bound.wake:
      fail Woken{}
    case _ = <- bound.timeout:
      fail newError("quic: stream deadline exceeded")
  }
}

fn quicconnFinishWait(s: Stream, done: chan<int>, bound: quicconnStreamBound): int! {
  select {
    case r = <- done:
      return r
    case _ = <- s.doneCh:
      return -1
    case _ = <- bound.wake:
      fail Woken{}
    case _ = <- bound.timeout:
      fail newError("quic: stream deadline exceeded")
  }
}
