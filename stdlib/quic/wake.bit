// Bit standard library — quic module, waking a blocked call from another green
// thread (#7640). Same flat `std/quic` module and namespace as `conn.bit`; the
// functions here read `Stream`'s private channels, which is why they are not
// in another module. `Stream.finish` is `streamFinishUntil` with a wake nothing
// ever sends on.

// What `streamReadUntil`, `streamFinishUntil` and `dialQuicTlsUntil` fail with
// when their `wake` channel received a value first. The connection is not
// touched by the wake (a dial that was woken is closed, since nobody holds it).
export class Woken {
  export message(): string {
    return "quic: wait woken"
  }
}

// `Stream.read`, but a value on `wake` ends the wait with `Woken`. The wake is
// looked at before the stream, so a peer sending as fast as it is read cannot
// outrun it.
export fn streamReadUntil(s: Stream, wake: chan<int>): StreamChunk! {
  select {
    case _ = <- wake:
      fail Woken{}
    default:
      {}
  }
  select {
    case c = <- s.recvCh:
      // Every chunk the loop sends carries data, FIN or a reset; the zero value
      // is what a receive on the channel the loop closed at exit returns.
      if (len(c.data) == 0 && !c.fin) {
        fail newError("quic: connection closed")
      }
      return c
    case _ = <- wake:
      fail Woken{}
  }
}

// Mark the send half of `s` finished (FIN) and block until every queued byte has
// been acknowledged, the connection ends, or `wake` receives a value (`Woken`:
// the FIN stays queued, a `Stream.reset` abandons it).
export fn streamFinishUntil(s: Stream, wake: chan<int>): ()! {
  let done = chan<int>(1)
  s.cmdCh <- quicconnCmd{
    kind = quicconnCmdFinish,
    id = s.streamId,
    data = []byte(0),
    replyOpen = chan<quicconnOpenReply>(1),
    replyInt = done,
  }
  let r = -1
  select {
    case v = <- done:
      r = v
    case _ = <- s.doneCh:
      {}
    case _ = <- wake:
      fail Woken{}
  }
  if (r < 0) {
    fail newError("quic: connection closed before the stream drained")
  }
}
