// Bit standard library — quic module, the QUIC v1 transport core (RFC 9000
// transport + RFC 9002 loss recovery / congestion control, #1220).
//
// The connection layer sits on top of the pure codec (`frames.bit`), the
// packet-protection layer (`packet.bit`), and the QUIC-TLS handshake
// (`tls.bit`). It turns an unreliable UDP datagram flow into reliable, ordered,
// flow-controlled byte streams, exactly as a QUIC endpoint must:
//
//   * **Connection state machine** — drives the #1219 record-bypass TLS
//     handshake to 1-RTT over CRYPTO frames across the three packet-number
//     spaces (Initial / Handshake / AppData), installing per-level packet keys
//     from the exposed traffic secrets, then carries application data.
//
//   * **Streams** — client-initiated bidirectional streams with send buffering,
//     ordered reassembly of received STREAM data (offset/gap handling via the
//     module's `CryptoAssembler`), and FIN.
//
//   * **Flow control** — per-stream and connection windows (MAX_DATA /
//     MAX_STREAM_DATA), DATA_BLOCKED / STREAM_DATA_BLOCKED signaling, and window
//     auto-tuning as received data is consumed.
//
//   * **Loss recovery (RFC 9002)** — ACK generation and processing, smoothed RTT
//     and RTT variance, a PTO timer, packet- and time-threshold loss detection,
//     and retransmission of lost CRYPTO / STREAM data.
//
//   * **Congestion control** — NewReno (slow start / congestion avoidance /
//     recovery) gating how much in-flight data may be outstanding.
//
// Since #1503 that layer is spread over siblings, all one flat module: this
// file keeps the tunables, the shared helpers, the public types, and the
// connection-state record every other file operates on; `levels.bit` the
// per-level and per-stream state; `loop.bit` the reader/ticker/loop and the
// command channel; `recv.bit` and `send.bit` the two packet paths;
// `loss.bit` recovery, RTT and congestion control; `handshake.bit` handshake
// progression; `frameclass.bit` the frame classifiers; `api.bit` the public
// `Conn`/`Stream` methods; `listener.bit` the server listener.
//
// Concurrency is the actor model, the same shape as `std/http2`'s connection:
// one green thread (the *loop*) owns all mutable connection state and folds in
// one event at a time, selected from three channels — datagrams pushed by a
// *reader* thread parked on UDP recv, application *commands*, and *ticks* from a
// timer thread. No connection state is shared across threads, so there are no
// locks. The tick drives the RFC 9002 timers (`std/time` `monotonic` + `sleep`);
// a native cancellable timer would replace the fixed-interval tick, but the tick
// is sufficient and needs no runtime primitive.
//
// std/quic is one flat module, so this file calls `frames.bit` (`Frame`, the
// `quicfr*` cursor helpers), `packet.bit` (`PacketKeys`, `protectPayload`,
// `applyHeaderProtection`, the `quicpkt*` helpers, …) and `tls.bit`
// (`levelKeyPair`, `CryptoAssembler`, `cryptoFrames`, the transport-parameter
// codec) directly; its own private free functions are prefixed `quicconn`. The
// cross-module imports are UDP (`std/net`), the clock (`std/time`), and the
// handshake drivers (`std/tls`); `Hash`/`newSha256` come from `packet.bit`'s
// import into this module's shared namespace.
//
// ponytail: NewReno only (no CUBIC/BBR); connection migration is CID basics only
// (fixed 8-byte ids, no path validation); AES-128-GCM + X25519 only, matching
// `packet.bit`'s AEAD. A server accepts many connections per socket via
// `listenQuic` (DCID demultiplexing); `acceptQuic` remains for the single
// connection case. The upgrade paths are noted at each `// ponytail:` below.

import { udpBind, UdpSocket } from "std/net"
import { monotonic, sleep } from "std/time"
// `std/sync`'s Mutex guards the listener demux table (#1912) — see ./listener.bit.
import { Mutex, newMutex } from "std/sync"
import { randomBytes } from "std/crypto"
import {
  TlsClientConfig,
  TlsClientHandshake,
  tlsClientStartExts,
  TlsServerConfig,
  newTlsServerConfig,
  TlsServerHandshake,
  tlsServerStartExts,
  TlsGroup,
  GroupKeypair,
  emptyTrustStore,
  Extension,
  TLS_AES_128_GCM_SHA256,
} from "std/tls"

// ---------------------------------------------------------------------------
// Tunables (RFC 9002 §7.6.1 constants and local ceilings)
// ---------------------------------------------------------------------------

// The maximum UDP payload this endpoint emits for a normal packet, and the
// datagram size a client Initial is padded up to (RFC 9000 §14.1 anti-
// amplification floor of 1200). Loopback MTU is far larger, so the cap is
// conservative, not a PMTU discovery result. ponytail: no PMTU discovery.
const quicconnMaxPacket: int = 1200
const quicconnInitialPad: int = 1160
const quicconnFrameBudget: int = 1100

// Fixed 4-byte packet-number encoding on send: values stay well under 2^32, so
// the truncation is lossless and header-protection sampling is uniform.
const quicconnPnLen: int = 4

// Encryption-level indices, matching the three packet-number spaces.
const quicconnLvlInitial: int = 0
const quicconnLvlHandshake: int = 1
const quicconnLvlApp: int = 2

// Loss recovery (RFC 9002 §6.1.1 / §6.2.1). Times are nanoseconds.
const quicconnPacketThreshold: int = 3
const quicconnGranularity: int = 1000000
const quicconnMinPto: int = 8000000
// A client gives up a stalled handshake after this long so a dial to an absent
// or silent server fails instead of blocking forever (UDP has no connection
// refused, and the PTO only retransmits — it never times the handshake out).
// 5s in nanoseconds, written as a literal (#1231: top-level const cannot fold).
const quicconnHandshakeTimeout: int = 5000000000
// An established connection gives up after this long with nothing received
// (RFC 9000 §10.1, idle timeout). Without it a peer that vanishes — crashed,
// or simply closed while the ACK confirming our last flight was in flight and
// lost — leaves the PTO retransmitting into the void forever, and any thread
// parked in `finish`/`read`/`acceptStream` never returns (#1449). Generous
// relative to the 2 ms tick and loopback RTTs, so it can only fire on a peer
// that is genuinely gone. 30s in nanoseconds, written as a literal (#1231:
// top-level const cannot fold).
const quicconnIdleTimeout: int = 30000000000
// A listener-created connection (`serverHsTimeout`) whose handshake did not
// finish until AFTER its own `quicconnHandshakeTimeout` had elapsed is given
// this much extra grace before being reaped, instead of waiting out the full
// `quicconnIdleTimeout` (#1709). A connection that established late is with
// high confidence one whose client hit that identical deadline (both sides
// start the clock at essentially the same moment, the client's Initial) and
// already redialed elsewhere: RFC 9000's general idle timeout is sized for a
// connection that may legitimately go quiet between requests, but a lateborn
// one is not idle, it is abandoned, and letting it linger 30s under retry load
// ties up a demux slot and a green thread the scheduler must keep servicing,
// compounding admission pressure on every other connection. Same duration as
// `quicconnHandshakeTimeout`, deliberately: the client that would still be
// waiting on this connection gave up on that exact timescale, not the idle
// one. 5s in nanoseconds, written as a literal (#1231: top-level const cannot
// fold).
const quicconnAbandonTimeout: int = 5000000000
const quicconnInitialPto: int = 200000000
const quicconnTick: int = 2000000

// NewReno (RFC 9002 §7.2). Bytes.
const quicconnInitialWindow: int = 12000
const quicconnMinWindow: int = 2400

// Flow-control window we advertise and keep ahead of the peer as data is
// consumed. Deliberately smaller than a bulk transfer so MAX_DATA /
// MAX_STREAM_DATA updates actually drive the transfer (RFC 9000 §4.1).
const quicconnFlowWindow: int = 32768

// TLS handshake message types we scan for to know a CRYPTO flight is complete
// (RFC 8446 §4): ClientHello, ServerHello, Finished.
const quicconnMsgClientHello: int = 1
const quicconnMsgServerHello: int = 2
const quicconnMsgFinished: int = 20

// Command kinds carried on the loop's command channel.
const quicconnCmdOpen: int = 1
const quicconnCmdAccept: int = 2
const quicconnCmdWrite: int = 3
const quicconnCmdFinish: int = 4
const quicconnCmdClose: int = 5
const quicconnCmdSetIdle: int = 6
const quicconnCmdReset: int = 7
const quicconnCmdStopSending: int = 8

// Until the real value is learned from the peer's transport parameters
// (`quicconnReadPeerParams`, client-only today — see the comment there), assume
// a generous limit rather than 0, matching `peerMaxData`/`peerInitStreamData`'s
// existing placeholder style: the alternative (assume zero streams allowed)
// would make the server side — which never runs that read (#3229 follow-up) —
// permanently unable to open a stream, which is a strictly worse regression
// than the limit going unenforced until it is actually learned.
const quicconnDefaultPeerMaxStreams: int = 1 << 20

// This endpoint's advertised initial_max_streams_bidi (RFC 9000 §18.2): the
// number of bidirectional streams the PEER may open on this connection.
// `quicconnLocalParams` sends this value; `quicconnEnsureStream` (recv.bit)
// enforces it against every peer-initiated stream reference — sharing one
// constant means the advertised number and the enforced number cannot drift
// apart (#3247, the missing inbound half of #3229's outbound check).
const quicconnLocalMaxStreamsBidi: int = 16

// RFC 9000 §20.1 transport error code: a stream reference beyond the
// receiver's advertised initial_max_streams_bidi / MAX_STREAMS limit
// (§4.6) is a connection error of this type.
const quicconnErrStreamLimit: int = 0x04

// Connection-id length this endpoint issues (RFC 9000 §5.1). ponytail: no
// NEW_CONNECTION_ID pool (one id per direction for the connection's life).
const quicconnCidLen: int = 8

// ---------------------------------------------------------------------------
// Small shared helpers
// ---------------------------------------------------------------------------

fn quicconnMin(a: int, b: int): int {
  if (a < b) {
    return a
  }
  return b
}

fn quicconnMax(a: int, b: int): int {
  if (a > b) {
    return a
  }
  return b
}

fn quicconnAbs(a: int): int {
  if (a < 0) {
    return -a
  }
  return a
}

// Park the loop's cadence between ticks.
fn quicconnSleepTick() {
  sleep(quicconnTick)
}

// A copy of `src` as a fresh slice — used whenever a slice viewing a transient
// datagram buffer must outlive it (connection ids, delivered stream chunks).
fn quicconnCopyBytes(src: []byte): []byte {
  let out = []byte(len(src))
  let i = 0
  while (i < len(src)) {
    out[i] = src[i]
    i = i + 1
  }
  return out
}

// A copy of `data[lo:hi]` as a fresh, independently mutable slice.
fn quicconnCopyRange(data: []byte, lo: int, hi: int): []byte {
  let out = []byte(hi - lo)
  let i = 0
  while (i < hi - lo) {
    out[i] = data[lo + i]
    i = i + 1
  }
  return out
}

// A fresh, cryptographically random connection id (RFC 9000 §5.1). Random ids
// make a collision between two concurrent connections astronomically unlikely,
// which the server demultiplexer relies on to tell peers apart — a clock-seeded
// id collides whenever two connections start within one (coarse) clock tick.
fn quicconnMakeCid(): []byte {
  return randomBytes(quicconnCidLen)
}

// Zero packet keys, a placeholder until a level's keys are installed.
fn quicconnZeroKeys(): PacketKeys {
  return PacketKeys{ key: []byte(0), iv: []byte(0), hp: []byte(0) }
}

fn quicconnNewHash(): Hash {
  return newSha256()
}

// ---------------------------------------------------------------------------
// Channel message types
// ---------------------------------------------------------------------------

// A received datagram forwarded by the reader thread; `eof` on socket close.
class quicconnDgram { data: []byte, host: string, port: int, eof: bool }

// The reply to open/accept: the allocated stream id and the channel its inbound
// data is delivered on.
class quicconnOpenReply { id: int, recvCh: chan<StreamChunk> }

// One command from the public API to the loop. `replyOpen` answers open/accept;
// `replyInt` answers finish (delivery complete) and unblocks the caller.
class quicconnCmd {
  kind: int,
  id: int,
  data: []byte,
  replyOpen: chan<quicconnOpenReply>,
  replyInt: chan<int>,
}

// ---------------------------------------------------------------------------
// Public types
// ---------------------------------------------------------------------------

// One contiguous run of received stream bytes delivered to the application, with
// `fin` set on the final run (the end of the stream). `reset` is set instead of
// a normal end when the peer abruptly aborted its send side with RESET_STREAM
// (RFC 9000 §19.4) rather than finishing cleanly; `data` is then always empty and
// `resetCode` carries the peer's application error code.
export class StreamChunk {
  export data: []byte,
  export fin: bool,
  export reset: bool,
  export resetCode: int,
}

// An established QUIC connection. Its methods marshal to the owning loop thread
// over a channel; the connection has no directly-shared mutable state.
export class Conn { cmdCh: chan<quicconnCmd>, sock: UdpSocket }

// One bidirectional stream on a `Conn`. `write`/`finish` queue outbound data;
// `read` pulls the next reassembled inbound chunk.
export class Stream { export streamId: int, cmdCh: chan<quicconnCmd>, recvCh: chan<StreamChunk> }

// ---------------------------------------------------------------------------
// The whole connection state (owned exclusively by the loop thread)
// ---------------------------------------------------------------------------

class quicconnState {
  isClient: bool,
  sock: UdpSocket,
  // Whether this connection is the socket's sole owner and may therefore close
  // it. False for a listener-created connection, which shares `lst.sock` with
  // the listener and every sibling connection (#1473). Every teardown path must
  // go through `quicconnCloseOwnedSock` rather than touching `sock.close()`.
  ownsSock: bool,
  // Set once the owned socket has been closed, so the close is idempotent and no
  // teardown ordering can double-close a descriptor the kernel may have recycled.
  sockClosed: bool,
  peerHost: string,
  peerPort: int,
  havePeer: bool,
  version: int,
  scid: []byte,
  dcid: []byte,
  origDcid: []byte,
  dcidSwitched: bool,
  iLevel: quicconnLevel,
  hLevel: quicconnLevel,
  aLevel: quicconnLevel,
  chOpt: Option<TlsClientHandshake>,
  shOpt: Option<TlsServerHandshake>,
  suiteId: int,
  serverHelloDone: bool,
  clientFlightSent: bool,
  handshakeComplete: bool,
  established: bool,
  // `monotonic()` when `established` first became true, 0 until then. Lets a
  // listener-created connection that never sees a stream distinguish "just
  // established" from "established a while ago and still unused" (#1709).
  establishedAt: int,
  handshakeStart: int,
  sendHandshakeDone: bool,
  streams: map<int, quicconnStream>,
  present: map<int, int>,
  nextBidiId: int,
  acceptQueue: []int,
  acceptWaiter: chan<quicconnOpenReply>,
  hasAcceptWaiter: bool,
  peerMaxData: int,
  peerInitStreamData: int,
  // The peer's advertised initial_max_streams_bidi (RFC 9000 §18.2), learned
  // from its transport parameters and raised by any later MAX_STREAMS frame
  // (§19.11). Enforced in `quicconnDoOpen` — see `quicconnDefaultPeerMaxStreams`
  // for the placeholder used before the real value is known.
  peerMaxStreamsBidi: int,
  dataSent: int,
  dataBlockedSignaled: bool,
  localMaxData: int,
  dataConsumed: int,
  needMaxData: bool,
  srtt: int,
  rttvar: int,
  minRtt: int,
  latestRtt: int,
  haveRtt: bool,
  ptoCount: int,
  cwnd: int,
  ssthresh: int,
  bytesInFlight: int,
  recoveryStart: int,
  maxAckDelay: int,
  inCh: chan<quicconnDgram>,
  cmdCh: chan<quicconnCmd>,
  tickCh: chan<int>,
  readyCh: chan<int>,
  running: bool,
  closeSent: bool,
  doneCh: chan<int>,
  serverHsTimeout: bool,
  // `monotonic()` when a datagram from the peer was last accepted — the RFC
  // 9000 §10.1 idle timer's restart point.
  lastRecv: int,
  // How long an established connection tolerates hearing nothing before it gives
  // up, in nanoseconds. Defaults to `quicconnIdleTimeout`; `Conn.setIdleTimeout`
  // overrides it per connection.
  idleTimeout: int,
}

// `ownsSock` is a required parameter, not a default, so that every construction
// site has to state whether this connection may close `sock` (#1473). Adding a
// fourth way to make a connection therefore forces the same decision instead of
// silently inheriting the wrong one.
fn quicconnNewState(
  isClient: bool,
  sock: UdpSocket,
  ownsSock: bool,
  host: string,
  port: int,
  scid: []byte,
  dcid: []byte,
): quicconnState {
  return quicconnState{
    isClient: isClient,
    sock: sock,
    ownsSock: ownsSock,
    sockClosed: false,
    peerHost: host,
    peerPort: port,
    havePeer: isClient,
    version: quicVersion1,
    scid: scid,
    dcid: dcid,
    origDcid: dcid,
    dcidSwitched: false,
    iLevel: quicconnNewLevel(quicconnLvlInitial),
    hLevel: quicconnNewLevel(quicconnLvlHandshake),
    aLevel: quicconnNewLevel(quicconnLvlApp),
    chOpt: Option.None,
    shOpt: Option.None,
    suiteId: TLS_AES_128_GCM_SHA256,
    serverHelloDone: false,
    clientFlightSent: false,
    handshakeComplete: false,
    established: false,
    establishedAt: 0,
    handshakeStart: monotonic(),
    sendHandshakeDone: false,
    streams: map<int, quicconnStream>(),
    present: map<int, int>(),
    nextBidiId: quicconnFirstBidiId(isClient),
    acceptQueue: []int(0),
    acceptWaiter: chan<quicconnOpenReply>(1),
    hasAcceptWaiter: false,
    peerMaxData: 1 << 20,
    peerInitStreamData: 1 << 20,
    peerMaxStreamsBidi: quicconnDefaultPeerMaxStreams,
    dataSent: 0,
    dataBlockedSignaled: false,
    localMaxData: quicconnFlowWindow,
    dataConsumed: 0,
    needMaxData: false,
    srtt: 0,
    rttvar: 0,
    minRtt: 0,
    latestRtt: 0,
    haveRtt: false,
    ptoCount: 0,
    cwnd: quicconnInitialWindow,
    ssthresh: 1 << 30,
    bytesInFlight: 0,
    recoveryStart: 0,
    maxAckDelay: 5000000,
    inCh: chan<quicconnDgram>(256),
    cmdCh: chan<quicconnCmd>(64),
    tickCh: chan<int>(1),
    readyCh: chan<int>(1),
    running: true,
    closeSent: false,
    doneCh: chan<int>(1),
    serverHsTimeout: false,
    lastRecv: monotonic(),
    idleTimeout: quicconnIdleTimeout,
  }
}

// The first bidirectional stream id this endpoint allocates (RFC 9000 §2.1):
// clients use 0, 4, 8, …; a server would use 1, 5, 9, ….
fn quicconnFirstBidiId(isClient: bool): int {
  if (isClient) {
    return 0
  }
  return 1
}

// The three levels by index, returned by reference so callers mutate in place.
fn quicconnLvl(st: quicconnState, idx: int): quicconnLevel {
  if (idx == quicconnLvlInitial) {
    return st.iLevel
  }
  if (idx == quicconnLvlHandshake) {
    return st.hLevel
  }
  return st.aLevel
}

// The QUIC transport parameters this endpoint advertises (RFC 9000 §18.2): the
// deliberately-modest flow-control windows plus our source connection id.
fn quicconnLocalParams(scid: []byte): TransportParameters {
  let tp = defaultTransportParameters()
  tp.initialMaxData = u64(quicconnFlowWindow)
  tp.initialMaxStreamDataBidiLocal = u64(quicconnFlowWindow)
  tp.initialMaxStreamDataBidiRemote = u64(quicconnFlowWindow)
  tp.initialMaxStreamDataUni = u64(quicconnFlowWindow)
  tp.initialMaxStreamsBidi = u64(quicconnLocalMaxStreamsBidi)
  tp.initialMaxStreamsUni = u64(16)
  tp.initialSourceConnectionId = scid
  return tp
}

