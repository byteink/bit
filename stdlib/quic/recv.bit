// Bit standard library — quic module, the packet receive path.
//
// Split out of `conn.bit` (#1503) to keep files readable; `stdlib/quic` is one
// flat module, so this file shares that file's imports and namespace.

// ---------------------------------------------------------------------------
// Receiving
// ---------------------------------------------------------------------------

// Parse the (possibly coalesced) packets in one datagram (RFC 9000 §12.2), left
// to right; a short-header 1-RTT packet is always last.
fn quicconnRecvDatagram(st: quicconnState, data: []byte): ()! {
  let pos = 0
  let guard = 0
  while (pos < len(data) && guard <= len(data)) {
    guard = guard + 1
    let first = data[pos]
    if ((first & 0x80) != 0) {
      let nxt = quicconnRecvLong(st, data, pos)?
      if (nxt <= pos) {
        return
      }
      pos = nxt
    } else if ((first & 0x40) != 0) {
      quicconnRecvShort(st, data, pos)?
      return
    } else {
      return
    }
  }
}

// Parse one long-header packet at `start`, decrypt and process it, and return
// the offset of the next coalesced packet (RFC 9000 §17.2). A packet whose keys
// are not yet installed, or that fails to decrypt, is skipped — the peer will
// retransmit (RFC 9001 §5.4.1 / §5.5).
fn quicconnRecvLong(st: quicconnState, data: []byte, start: int): int! {
  if (start + 7 > len(data)) {
    return len(data)
  }
  let typ = int((data[start] >> 4) & 0x03)
  let p = start + 5
  let dcidLen = int(data[p])
  p = p + 1
  if (p + dcidLen + 1 > len(data)) {
    return len(data)
  }
  let dcid = data[p:p + dcidLen]
  p = p + dcidLen
  let scidLen = int(data[p])
  p = p + 1
  if (p + scidLen > len(data)) {
    return len(data)
  }
  let scid = data[p:p + scidLen]
  p = p + scidLen
  if (typ == longInitial) {
    let r = quicfrReader{ data: data, pos: p }
    let tokLen = int(quicfrReadVarint(r)?)
    p = r.pos + tokLen
    if (p > len(data)) {
      return len(data)
    }
  }
  let r2 = quicfrReader{ data: data, pos: p }
  let length = int(quicfrReadVarint(r2)?)
  let pnOffset = r2.pos
  let packetEnd = pnOffset + length
  if (packetEnd > len(data)) {
    return len(data)
  }
  let levelIdx = -1
  if (typ == longInitial) {
    levelIdx = quicconnLvlInitial
  } else if (typ == longHandshake) {
    levelIdx = quicconnLvlHandshake
  } else {
    return packetEnd
  }
  if (!st.isClient && levelIdx == quicconnLvlInitial && !st.iLevel.haveRecv) {
    quicconnServerInitKeys(st, dcid, scid)
  }
  if (st.isClient && !st.dcidSwitched && scidLen > 0) {
    st.dcid = quicconnCopyBytes(scid)
    st.dcidSwitched = true
  }
  let lvl = quicconnLvl(st, levelIdx)
  if (!lvl.haveRecv) {
    return packetEnd
  }
  quicconnDecryptAndProcess(st, levelIdx, data, start, pnOffset, packetEnd)?
  return packetEnd
}

// Parse and process the trailing short-header (1-RTT) packet at `start` (RFC
// 9000 §17.3). Its DCID length is our own issued id length.
fn quicconnRecvShort(st: quicconnState, data: []byte, start: int): ()! {
  if (!st.aLevel.haveRecv) {
    return
  }
  let pnOffset = start + 1 + len(st.scid)
  if (pnOffset + 20 > len(data)) {
    return
  }
  quicconnDecryptAndProcess(st, quicconnLvlApp, data, start, pnOffset, len(data))?
}

// Server-only: derive Initial keys from the client-chosen DCID carried in the
// clear on its first Initial (RFC 9001 §5.2), and adopt the client's SCID as the
// destination for replies.
fn quicconnServerInitKeys(st: quicconnState, dcid: []byte, scid: []byte) {
  st.origDcid = quicconnCopyBytes(dcid)
  st.dcid = quicconnCopyBytes(scid)
  st.dcidSwitched = true
  st.iLevel.ksend = serverInitialKeys(dcid)
  st.iLevel.krecv = clientInitialKeys(dcid)
  st.iLevel.haveSend = true
  st.iLevel.haveRecv = true
}

// Remove header protection, decrypt, and process one packet's frames (RFC 9001
// §5.4.1 / §5.3). Works on a copy of the packet so in-place unmasking never
// disturbs the shared datagram buffer. Undecryptable packets are dropped.
fn quicconnDecryptAndProcess(
  st: quicconnState,
  levelIdx: int,
  data: []byte,
  start: int,
  pnOffset: int,
  packetEnd: int,
): ()! {
  let lvl = quicconnLvl(st, levelIdx)
  let pkt = quicconnCopyRange(data, start, packetEnd)
  let pnOffLocal = pnOffset - start
  if (pnOffLocal + 20 > len(pkt)) {
    return
  }
  let sample = pkt[pnOffLocal + 4:pnOffLocal + 20]
  let mask = aesHeaderMask(lvl.krecv.hp, sample)?
  let pnLen = removeHeaderProtection(pkt, pnOffLocal, mask)?
  let trunc = 0
  let i = 0
  while (i < pnLen) {
    trunc = (trunc << 8) | int(pkt[pnOffLocal + i])
    i = i + 1
  }
  let fullPn = quicconnDecodePn(lvl.largestRecvPn, trunc, pnLen)
  let aadEnd = pnOffLocal + pnLen
  let header = pkt[0:aadEnd]
  let ct = pkt[aadEnd:len(pkt)]
  let pt = unprotectPayload(lvl.krecv, u64(fullPn), header, ct) catch _ {
    return
  }
  if (fullPn > lvl.largestRecvPn) {
    lvl.largestRecvPn = fullPn
  }
  quicconnRecordPn(lvl, fullPn)
  let frames = parseFrames(pt) catch _ {
    return
  }
  let elicit = false
  for f of frames {
    if (quicconnIsAckEliciting(f)) {
      elicit = true
    }
    quicconnHandleFrame(st, levelIdx, f)?
  }
  if (elicit) {
    lvl.ackPending = true
  }
  quicconnDriveHandshake(st)?
}

// Reconstruct a full packet number from its truncated form and the largest one
// received in the space (RFC 9000 §A.3).
fn quicconnDecodePn(largest: int, truncated: int, pnLen: int): int {
  let pnWin = 1 << (8 * pnLen)
  let pnHalf = pnWin / 2
  let expected = largest + 1
  let base = expected - expected % pnWin
  let cand = base + truncated
  if (cand + pnHalf <= expected && cand + pnWin < (1 << 62)) {
    return cand + pnWin
  }
  if (cand > expected + pnHalf && cand >= pnWin) {
    return cand - pnWin
  }
  return cand
}

// Fold one received frame into connection state.
//
// Seven arms are deliberate no-ops, each for its own reason rather than one
// blanket "not implemented" (#3229 — this match used to give no reason at all,
// the same shape `quictlsFeed` in tls.bit documents for its own, narrower,
// handshake-only match):
//
//   * `NewToken` (RFC 9000 §19.7) — a server hands the client a token here to
//     skip address validation (avoid a Retry round trip) on a *future*
//     connection. This module has no cross-connection token cache — every
//     `dialQuic` is a fresh connection with no memory of a prior one — and no
//     0-RTT/early-data support to spend such a token on even if it kept one.
//     Ignoring it costs a round trip on a subsequent connection under load;
//     it changes nothing about this one.
//   * `NewConnectionId`/`RetireConnectionId` (RFC 9000 §19.15/§19.16) — this
//     module does one fixed connection id per direction for the connection's
//     life (see `quicconnCidLen`'s doc comment); there is no CID pool to add to
//     or retire from, and no path validation to rotate onto a spare one.
//   * `PathResponse` (RFC 9000 §19.18, receive direction) — this endpoint only
//     ever originates a PATH_CHALLENGE reactively, in the `PathChallenge` arm
//     right below, to answer one from the peer; it never sends its own
//     PATH_CHALLENGE (no connection migration), so a PATH_RESPONSE to us can
//     never arrive for a challenge we actually issued.
//   * `DataBlocked`/`StreamDataBlocked` (RFC 9000 §19.9/§19.12, receive
//     direction) — advisory only. This endpoint already proactively re-extends
//     both windows as consumption crosses the midpoint
//     (`quicconnMaybeExtendWindows`), so hearing that the peer is blocked would
//     at best make an already-scheduled MAX_DATA/MAX_STREAM_DATA update fire
//     sooner; it cannot change what update gets sent. The send-side signal
//     (telling the peer WE are blocked) is implemented, in
//     `quicconnFillStreamFrames`.
//   * `StreamsBlocked` (RFC 9000 §19.14, receive direction) — telling us the
//     peer is blocked opening streams is only actionable if this endpoint can
//     raise its OWN advertised initial_max_streams_bidi (send a fresh
//     MAX_STREAMS), and nothing in this module does that today: `initial_max_
//     streams_bidi` is a fixed 16 for the connection's life
//     (`quicconnLocalParams`). Out of scope here; would need its own local-
//     limit-tracking-and-relaxation mechanism, symmetric to the peer-limit one
//     `peerMaxStreamsBidi` adds below for the *other* direction.
//
// `Padding` and `Ping` are outside this count entirely: neither carries any
// state to fold in (Padding is filler, Ping exists only to elicit an ACK,
// which `quicconnIsAckEliciting` already handles independently of this match),
// so there is nothing a "reason for the no-op" comment could say beyond that.
//
// The other three historically-empty arms — `ResetStream`, `StopSending`, and
// `MaxStreams` — are real fixes, not non-goals: see `quicconnOnResetStream`,
// `quicconnAbortSend`, and `quicconnOnMaxStreams` respectively. 7 non-goals + 3
// fixes accounts for all 10 arms this match originally left empty (#3229's
// finding named 9; `NewToken` above is the 10th, found in review).
fn quicconnHandleFrame(st: quicconnState, levelIdx: int, f: Frame): ()! {
  match (f) {
    Padding(_) => {}
    Ping => {}
    Ack(a) => { quicconnProcessAck(st, levelIdx, a) }
    ResetStream(id, code, _) => { quicconnOnResetStream(st, int(id), int(code)) }
    StopSending(id, code) => { quicconnAbortSend(st, int(id), int(code)) }
    Crypto(offset, cdata) => { quicconnLvl(st, levelIdx).crecv.insert(offset, cdata)? }
    NewToken(_) => {}
    Stream(s) => { quicconnOnStream(st, s)? }
    MaxData(m) => {
      if (int(m) > st.peerMaxData) {
        st.peerMaxData = int(m)
        st.dataBlockedSignaled = false
      }
    }
    MaxStreamData(id, m) => { quicconnOnMaxStreamData(st, int(id), int(m)) }
    MaxStreams(bidi, m) => { quicconnOnMaxStreams(st, bidi, int(m)) }
    DataBlocked(_) => {}
    StreamDataBlocked(_, _) => {}
    StreamsBlocked(_, _) => {}
    NewConnectionId(_, _, _, _) => {}
    RetireConnectionId(_) => {}
    PathChallenge(d) => { st.aLevel.pending = append(st.aLevel.pending, Frame.PathResponse(d)) }
    PathResponse(_) => {}
    ConnectionClose(_, _, _) => { st.running = false }
    ApplicationClose(_, _) => { st.running = false }
    HandshakeDone => { st.handshakeComplete = true }
  }
}

// Raise the peer's advertised bidirectional stream limit (RFC 9000 §19.11) so a
// later `Conn.openStream` can use the extra room; a MAX_STREAMS that does not
// advance the limit (reordered or duplicate) is a no-op. Uni-directional streams
// are untouched: this module has no uni-stream open path at all (`quicconnDoOpen`
// only ever allocates bidi ids), so a uni MAX_STREAMS has nothing to gate.
fn quicconnOnMaxStreams(st: quicconnState, bidi: bool, m: int) {
  if (!bidi) {
    return
  }
  if (m > st.peerMaxStreamsBidi) {
    st.peerMaxStreamsBidi = m
  }
}

// Fold an abrupt peer abort of their send side into our receive state (RFC 9000
// §19.4): stop expecting the rest of the stream and wake a blocked `read` with a
// distinguishable reset chunk instead of leaving it parked on a FIN that will
// never arrive (the bug this function fixes). A reset for a stream whose clean
// end was already delivered is a no-op — the application has already seen it
// end, and re-announcing that is not useful.
//
// `st.present[id] == 0` is ALSO treated as a no-op here, and that half is a
// known gap, not a considered choice: RFC 9000 §2.1 says receiving ANY frame
// that references a stream id — not only STREAM — implicitly opens it (and
// every lower-numbered stream of the same type), so a peer that resets a
// stream before ever sending data on it is valid QUIC and this drops that
// RESET_STREAM on the floor instead of surfacing it. Pre-existing and broader
// than this arm alone — `quicconnOnMaxStreamData` has the identical
// `st.present[id] == 0` early-return for the same reason, and `StreamDataBlocked`
// would need it too were it not already a no-op — so it is a cross-cutting
// "implicit stream creation" gap, not something #3229 introduces or is scoped
// to fix. Filed separately (#3232).
fn quicconnOnResetStream(st: quicconnState, id: int, code: int) {
  if (st.present[id] == 0) {
    return
  }
  let str = st.streams[id]
  if (str.finDelivered) {
    return
  }
  str.finDelivered = true
  str.recvCh <- StreamChunk{ data: []byte(0), fin: true, reset: true, resetCode: code }
}

fn quicconnOnMaxStreamData(st: quicconnState, id: int, m: int) {
  if (st.present[id] == 0) {
    return
  }
  let s = st.streams[id]
  if (m > s.peerMaxStreamData) {
    s.peerMaxStreamData = m
    s.blockedSignaled = false
  }
}

// Accept a STREAM frame (RFC 9000 §19.8): create the stream on first sight,
// enqueue it for `acceptStream`, reassemble the data, and deliver any newly
// contiguous prefix.
fn quicconnOnStream(st: quicconnState, s: StreamFrame): ()! {
  let id = int(s.id)
  if (st.present[id] == 0) {
    let ns = quicconnNewStream(st, id, true)
    st.streams[id] = ns
    st.present[id] = 1
    if (st.hasAcceptWaiter) {
      st.acceptWaiter <- quicconnOpenReply{ id: id, recvCh: ns.recvCh }
      st.hasAcceptWaiter = false
    } else {
      st.acceptQueue = append(st.acceptQueue, id)
    }
  }
  let str = st.streams[id]
  str.recvAsm.insert(s.offset, s.data)?
  if (s.fin) {
    str.recvFinalSize = int(s.offset) + len(s.data)
  }
  quicconnDeliverStream(st, str)
}

// Hand any newly contiguous received bytes to the application and advance the
// receive flow-control window (auto-tuning, RFC 9000 §4.1). When the FIN arrives
// after the last data was already delivered (an empty STREAM frame at the final
// offset, or a FIN reordered ahead of nothing), emit a trailing empty
// `fin = true` chunk so the reader still sees the end of stream.
fn quicconnDeliverStream(st: quicconnState, str: quicconnStream) {
  let contig = str.recvAsm.contiguousLen()
  if (contig > str.recvDelivered) {
    let all = str.recvAsm.contiguous()
    let chunk = quicconnCopyRange(all, str.recvDelivered, contig)
    let n = contig - str.recvDelivered
    let isFin = str.recvFinalSize >= 0 && contig == str.recvFinalSize
    str.recvDelivered = contig
    st.dataConsumed = st.dataConsumed + n
    str.recvCh <- StreamChunk{ data: chunk, fin: isFin, reset: false, resetCode: 0 }
    if (isFin) {
      str.finDelivered = true
    }
    quicconnMaybeExtendWindows(st, str)
  }
  if (!str.finDelivered && str.recvFinalSize >= 0 && str.recvDelivered >= str.recvFinalSize) {
    str.finDelivered = true
    str.recvCh <- StreamChunk{ data: []byte(0), fin: true, reset: false, resetCode: 0 }
  }
}

// Keep the advertised windows a full `quicconnFlowWindow` ahead of what has been
// consumed, queuing MAX_DATA / MAX_STREAM_DATA when they cross the midpoint.
fn quicconnMaybeExtendWindows(st: quicconnState, str: quicconnStream) {
  if (str.localMaxStreamData - str.recvDelivered < quicconnFlowWindow / 2) {
    str.localMaxStreamData = str.recvDelivered + quicconnFlowWindow
    str.needMaxStreamData = true
  }
  if (st.localMaxData - st.dataConsumed < quicconnFlowWindow / 2) {
    st.localMaxData = st.dataConsumed + quicconnFlowWindow
    st.needMaxData = true
  }
}

