// stdlib/quic/accept.test.bit — `Conn.acceptStream` hands out every stream the
// peer already opened before it reports the connection closed (#6776), the way
// a socket returns buffered bytes before EOF. The peer's CONNECTION_CLOSE ends
// the loop (`quicconnLoop`, loop.bit); streams still in `acceptQueue` at that
// point used to be dropped, so a server that was slow to call `acceptStream`
// lost them.
//
// `Conn.doneCh` (module sibling, conn.bit) is closed by the loop the instant it
// exits, so the server waits on it and calls `acceptStream` only AFTER the
// close was processed: the interleaving a loaded host produces by chance, made
// deterministic. `quicRefusalCertPem`/`quicRefusalKeyPem` (listener.test.bit)
// supply the throwaway self-signed identity; `dialQuicTls`/`acceptQuic` are
// module siblings (api.bit).
import { emptyTrustStore } from "std/tls"

const quicAcceptStreams: int = 6

// `dialQuic` verifies the certificate (#6235) and this identity chains to no
// trust store; the test is about stream accept, not certificate validation.
fn quicAcceptClientConfig(): TlsConfig {
  let cfg = TlsConfig(emptyTrustStore())
  cfg.insecureSkipVerify = true
  return cfg
}

// Server: take the connection, wait until its loop has exited (the client's
// CONNECTION_CLOSE was processed), and only then drain `acceptStream`. Reports
// "count:idsum" over the streams it got before the first error.
fn quicAcceptServer(sock: UdpSocket, resultCh: chan<string>) {
  let conn = acceptQuic(sock, quicRefusalCertPem(), quicRefusalKeyPem()) catch _ {
    resultCh <- "handshake-failed"
    return
  }
  <- conn.doneCh
  let count = 0
  let idSum = 0
  let i = 0
  while (i < quicAcceptStreams) {
    let s = conn.acceptStream() catch _ {
      i = quicAcceptStreams
      continue
    }
    count = count + 1
    idSum = idSum + s.id()
    i = i + 1
  }
  resultCh <- "${count}:${idSum}"
}

test "acceptStream drains the streams the peer opened before reporting the connection closed" {
  let srv = udpBind("127.0.0.1", 0) catch e {
    assert(false, "udpBind: ${e.message()}")
    return
  }
  let port = srv.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let res = chan<string>(1)
  spawn quicAcceptServer(srv, res)
  let conn = dialQuicTls("127.0.0.1", port, "localhost", quicAcceptClientConfig()) catch e {
    assert(false, "dialQuicTls: ${e.message()}")
    return
  }
  let i = 0
  while (i < quicAcceptStreams - 1) {
    let _ = conn.openStream() catch e {
      assert(false, "openStream: ${e.message()}")
      return
    }
    i = i + 1
  }
  let last = conn.openStream() catch e {
    assert(false, "openStream (last): ${e.message()}")
    return
  }
  last.write([]byte("x")) catch e {
    assert(false, "write: ${e.message()}")
    return
  }
  last.finish() catch e {
    assert(false, "finish: ${e.message()}")
    return
  }
  conn.close()
  let got = <- res
  assert(got == "6:60", "server accepted ${got} (count:idsum), want 6:60 — ids 0,4,8,12,16,20")
}
