// Bit standard library — core module.
//
// Small, dependency-free helpers available to every program. What lives here is
// bounded by what the compiler lowers today (non-generic functions over the
// builtins and string concatenation); it grows as the language does. See #348.

// Writes `s` to standard output followed by a newline.
export function println(s: string) {
  print(s + "\n")
}

// A basic error carrying a human-readable message. It satisfies the
// predeclared `error` interface (§10.6, §18) via its `message()` method, so a
// value built by `newError` can be `fail`ed or returned wherever an `error` is
// expected. The struct itself stays private to core; callers only see `error`.
struct errorString {
  msg: string
}

function (e: errorString) message(): string {
  return e.msg
}

// Builds an `error` with the given message — the ordinary way to produce one.
export function newError(msg: string): error {
  return errorString{ msg: msg }
}
