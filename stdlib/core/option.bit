// Bit standard library — core module, Option/Result helpers.
//
// Free functions over the prelude `Option<T>` and `Result<T, E>` (§14.7).
// Methods on a generic type don't parse yet (#348), so these are plain generic
// functions; they monomorphize per call site like any other. `unwrap`/`unwrapOk`
// panic on the empty case — use them only when it is a programmer error, and the
// `*Or` / `is*` variants when it is expected.

// The contained value, or a panic when the Option is None.
export fn unwrap<T>(o: Option<T>): T {
  match (o) {
    Some(v) => return v
    None => panic("unwrap: Option is None")
  }
}

// The contained value, or `dflt` when the Option is None.
export fn unwrapOr<T>(o: Option<T>, dflt: T): T {
  return match (o) {
    Some(v) => v
    None => dflt
  }
}

// Whether the Option holds a value.
export fn isSome<T>(o: Option<T>): bool {
  return match (o) {
    Some(v) => true
    None => false
  }
}

// Whether the Option is empty.
export fn isNone<T>(o: Option<T>): bool {
  return match (o) {
    Some(v) => false
    None => true
  }
}

// The Ok value, or a panic when the Result is Err.
export fn unwrapOk<T, E>(r: Result<T, E>): T {
  match (r) {
    Ok(v) => return v
    Err(e) => panic("unwrapOk: Result is Err")
  }
}

// The Ok value, or `dflt` when the Result is Err.
export fn okOr<T, E>(r: Result<T, E>, dflt: T): T {
  return match (r) {
    Ok(v) => v
    Err(e) => dflt
  }
}

// Whether the Result is Ok.
export fn isOk<T, E>(r: Result<T, E>): bool {
  return match (r) {
    Ok(v) => true
    Err(e) => false
  }
}

// Whether the Result is Err.
export fn isErr<T, E>(r: Result<T, E>): bool {
  return match (r) {
    Ok(v) => false
    Err(e) => true
  }
}
