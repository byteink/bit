// stdlib/where/where.test.bit — the Clause arity rule and the Where<T> tree.

import { Value } from "std/sql"

class Article {
  authorId: string,
}

class Comment {
  body: string,
}

fn one(): []Value {
  return [Value.Int(1)]
}

fn opCompiles(op: Op): bool {
  Clause("age", op, one()) catch _ {
    return false
  }
  return true
}

// True when the constructor refused the arguments.
fn refuses(field: string, op: Op, values: []Value): bool {
  let failed = false
  Clause(field, op, values) catch _ {
    failed = true
  }
  return failed
}

test "Eq builds a Clause" {
  assert(opCompiles(Op.Eq), "Eq")
}

test "Ne builds a Clause" {
  assert(opCompiles(Op.Ne), "Ne")
}

test "Lt builds a Clause" {
  assert(opCompiles(Op.Lt), "Lt")
}

test "Lte builds a Clause" {
  assert(opCompiles(Op.Lte), "Lte")
}

test "Gt builds a Clause" {
  assert(opCompiles(Op.Gt), "Gt")
}

test "Gte builds a Clause" {
  assert(opCompiles(Op.Gte), "Gte")
}

test "In builds a Clause from several values" {
  let c = Clause("status", Op.In, [Value.Text("draft"), Value.Text("review")]) catch e {
    assert(false, e.message())
    return
  }
  assert(len(c.values) == 2, "In keeps both values")
  assert(c.field == "status", "field")
}

test "In with one value is accepted" {
  let c = Clause("status", Op.In, [Value.Text("draft")]) catch e {
    assert(false, e.message())
    return
  }
  assert(len(c.values) == 1, "one value")
}

test "In with zero values is rejected" {
  assert(refuses("status", Op.In, []Value{}), "In with no values must fail")
}

test "Eq with two values is rejected" {
  assert(refuses("age", Op.Eq, [Value.Int(1), Value.Int(2)]), "Eq with two values must fail")
}

test "Eq with zero values is rejected" {
  assert(refuses("age", Op.Eq, []Value{}), "Eq with no values must fail")
}

test "an empty field name is rejected" {
  assert(refuses("", Op.Eq, one()), "empty field must fail")
}

test "Where<T>() is the empty always-true filter" {
  let w = Where<Article>()
  assert(len(w.clauses) == 0 && len(w.children) == 0, "empty")
  assert(!w.not, "not unset")
  assert(w.join == Join.And, "join defaults to And")
}

test "Where<T> holds clauses, join and children" {
  let a = Clause("authorId", Op.Eq, [Value.Text("u1")]) catch e {
    assert(false, e.message())
    return
  }
  let b = Clause("status", Op.Eq, [Value.Text("published")]) catch e {
    assert(false, e.message())
    return
  }
  let inner = Where<Article>(clauses = [b])
  let w = Where<Article>(clauses = [a], join = Join.Or, children = [inner])
  assert(len(w.clauses) == 1 && w.join == Join.Or, "clauses and join")
  assert(len(w.children) == 1 && w.children[0].clauses[0].field == "status", "child")
}

test "Where<T> negates with not" {
  let a = Clause("age", Op.Gte, [Value.Int(18)]) catch e {
    assert(false, e.message())
    return
  }
  let w = Where<Article>(not = true, children = [Where<Article>(clauses = [a])])
  assert(w.not, "not set")
  assert(!w.children[0].not, "child not unset")
}

test "the type argument is phantom, Where<Comment> builds too" {
  let w = Where<Comment>()
  assert(len(w.clauses) == 0, "empty")
}
