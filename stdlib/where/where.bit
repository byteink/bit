// Bit standard library — where module.
//
// The plain data a typed condition literal lowers to. A condition such as
// `{ authorId: user.id, status: "published" }`, written against a class `T`,
// becomes a `Where<T>`: a small tree of field comparisons (`Clause`) joined
// with And or Or and optionally negated. The tree carries no behaviour. This
// module only builds and holds it; the packages that consume it (an access
// policy check, a SQL query builder) each evaluate it their own way.
//
// `T` is a phantom: no field mentions it. It exists so a literal can be
// checked against `T`'s fields at compile time, and so a `Where<Article>`
// cannot be passed where a `Where<Comment>` is wanted.
//
// `Class<T>` is the one place a class name is a value: a parameter of that type
// takes a bare class name, `can(Read, Article, { authorId: 1 })`, infers `T`
// from it and so lets a later `Where<T>` parameter be checked against the same
// class. The compiler lowers the name to `Class<T>{}`.
//
// Values are `std/sql`'s `Value`, so one tree can be compared in memory or
// bound as query parameters without a second value model.

import { Value } from "std/sql"

// How a clause compares a field with its value(s).
export enum Op { Eq, Ne, In, Lt, Lte, Gt, Gte }

// How a `Where` combines its clauses and children.
export enum Join { And, Or }

// One comparison: `field` `op` the value(s). Every op takes exactly one value
// except `In`, which takes one or more and matches when the field equals any
// of them. The constructor refuses any other count, so a `Clause` that exists
// is well formed, and its fields are readonly so it stays that way.
export class Clause {
  export readonly field: string
  export readonly op: Op
  export readonly values: []Value

  init(field: string, op: Op, values: []Value)! {
    if (field == "") {
      fail newError("where: Clause(): the field name is empty")
    }
    match (op) {
      In => {
        if (len(values) < 1) {
          fail newError("where: Clause(): `${field}` In needs at least one value")
        }
      }
      _ => {
        if (len(values) != 1) {
          fail newError("where: Clause(): `${field}` takes exactly one value, got ${len(values)}")
        }
      }
    }
    this.field = field
    this.op = op
    this.values = values
  }
}

// A condition on a `T`: the clauses and the child conditions, combined by
// `join`, then negated when `not` is set. A `Where<T>()` with no clauses and
// no children is the empty filter and matches everything; `not` on it is
// still applied, so it then matches nothing.
//
// Nesting is how a literal's `and`, `or` and `not` keys lower: `or` is a node
// with `join = Or` whose children are the alternatives, and `not` is a node
// with `not = true` around the condition it negates.
export class Where<T> {
  export readonly clauses: []Clause
  export readonly join: Join
  export readonly not: bool
  export readonly children: []Where<T>

  init(
    clauses: []Clause = [],
    join: Join = Join.And,
    not: bool = false,
    children: []Where<T> = [],
  ) {
    this.clauses = clauses
    this.join = join
    this.not = not
    this.children = children
  }
}

// A class named as an argument. It carries nothing: `T` is its whole content.
// Passing a bare class name to a parameter of this type infers `T` from the
// name and checks the parameters after it against that `T`, left to right; a
// class name anywhere else is not a value. See SPEC 12.3.1.
export class Class<T> {}
