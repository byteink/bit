// Bit standard library — http2 module, the outbound half of the stream state
// machine: flow-controlled sending, state transitions, message delivery, error
// paths, and the frame-emitting helpers.
// Split out of `conn.bit`; same flat `std/http2` module and namespace.

// --- the peer's header-list limit --------------------------------------------

// The size of `fields` as SETTINGS_MAX_HEADER_LIST_SIZE counts it: the
// UNCOMPRESSED list, name + value + 32 per field (RFC 9113 §6.5.2).
//
// This is deliberately NOT `len(st.enc.encode(fields))`, which is what
// `st.maxHeaderListBytes` bounds on the receive path (#4593). The peer applies
// §6.5.2 to decide whether to refuse us, so comparing anything else against its
// advertised number answers a different question — and the two differ in both
// directions: Huffman coding can grow a block (an octet above 0x7f costs 20 to
// 30 bits) while the dynamic table can shrink a repeated block far below its
// list size. Encoding also has a side effect, inserting into `st.enc`'s table,
// so a block we are about to refuse must not be encoded at all.
//
// `hpackSizeOf` (hpack.bit) rather than the arithmetic written out again: RFC
// 7541 §4.1's entry size is the same name + value + 32 that §6.5.2 cites, and
// one copy of it cannot drift from the other.
fn h2connHeaderListSize(fields: []HeaderField): int {
  let total = 0
  for f of fields {
    total = total + hpackSizeOf(f.name, f.value)
  }
  return total
}

// What a refused header list is reported as, naming both numbers: the size we
// measured and the limit the peer advertised. One spelling for both refusal
// paths (`h2connCmdOpen` and `h2connCmdRespond`, events.bit) so a client reading
// the `roundTrip` error and a server reading its log see the same sentence.
fn h2connHeaderListMsg(size: int, limit: int): string {
  return "http2: header list is ${size} bytes, over the peer's SETTINGS_MAX_HEADER_LIST_SIZE of ${limit}"
}

// --- flow-controlled sending -------------------------------------------------

// Send as much of a stream's pending body as the stream and connection windows
// allow, in frames no larger than the peer's max frame size. Stops when the body
// drains (ending the stream if END_STREAM was requested) or a window is
// exhausted — a later WINDOW_UPDATE resumes it.
fn h2connFlushStream(st: h2connState, s: h2connStream) {
  while (s.hasPending) {
    let avail = s.sendWindow
    if (st.connSendWindow < avail) {
      avail = st.connSendWindow
    }
    if (avail <= 0) {
      return
    }
    let n = len(s.pendingData)
    if (n > avail) {
      n = avail
    }
    if (n > st.peerMaxFrameSize) {
      n = st.peerMaxFrameSize
    }
    let chunk = s.pendingData[0:n]
    let last = n == len(s.pendingData) && s.pendingEnd
    h2connSendData(st, DataFrame{ streamId: s.id, data: chunk, endStream: last, padLength: 0 - 1 })
    s.pendingData = s.pendingData[n:len(s.pendingData)]
    s.sendWindow = s.sendWindow - n
    st.connSendWindow = st.connSendWindow - n
    if (len(s.pendingData) == 0) {
      s.hasPending = false
      if (s.pendingEnd) {
        h2connLocalEnd(st, s)
      }
    }
  }
}

// Resume every stream blocked on send credit, after a connection-level
// WINDOW_UPDATE or a SETTINGS_INITIAL_WINDOW_SIZE increase handed some back.
//
// NOT `for (_, s) of st.streams { h2connFlushStream(st, s) }`, which is what
// this replaced at two call sites: draining a stream's last pending bytes ends
// it (`h2connLocalEnd`), ending it closes it, and closing it now removes it from
// `st.streams` (`h2connCloseStream`, #4594) — a mutation in the middle of a
// walk the runtime's iterator explicitly does not allow (SPEC §12.6;
// `bit_rt_map_iter_next`, runtime/root/maps.bit, "iteration assumes no
// mutation"). So collect the ids first — only a stream with `hasPending` can
// make progress, so the snapshot is normally empty — and flush outside the walk.
//
// The re-read is the two-result form because a single-result read of an absent
// key panics (SPEC §12.6) and only the comma-ok form is total; flushing one
// stream cannot release another today, and this does not depend on that.
fn h2connFlushAll(st: h2connState) {
  let ids = []int(0)
  for (id, s) of st.streams {
    if (s.hasPending) {
      ids = append(ids, id)
    }
  }
  for id of ids {
    let (s, ok) = st.streams[id]
    if (ok) {
      h2connFlushStream(st, s)
    }
  }
}

// --- stream state transitions ------------------------------------------------

// We sent END_STREAM: open -> half-closed(local); half-closed(remote) -> closed.
fn h2connLocalEnd(st: h2connState, s: h2connStream) {
  if (s.state == h2stHCRemote) {
    h2connCloseStream(st, s)
    return
  }
  s.state = h2stHCLocal
}

// The peer sent END_STREAM: open -> half-closed(remote); half-closed(local) ->
// closed.
fn h2connRecvEndTransition(st: h2connState, s: h2connStream) {
  if (s.state == h2stHCLocal) {
    h2connCloseStream(st, s)
    return
  }
  if (s.state == h2stOpen) {
    s.state = h2stHCRemote
  }
}

// Move `s` to the closed state (RFC 9113 §5.1) and drop it from the connection's
// stream table (#4594).
//
// Retaining a closed stream's PROTOCOL state is what §5.1 asks for; retaining
// its `recvBody`, `pendingData` and `recvHeaders` for the life of the connection
// is not, and until this deleted the entry a server holding one connection open
// for a browser accumulated every body it ever served on it — at up to
// `Config.maxBodyBytes` each (#4590), which bounds one stream and not their sum.
//
// A released entry is indistinguishable from a never-created one, which is what
// makes the removal safe rather than merely smaller. Every read of the table is
// guarded by the `ok` of `let (s, ok) = st.streams[id]`, and each of those
// guards already answers a PRESENT CLOSED stream exactly as it answers an
// absent one:
// `h2connDataStreamOk` reports STREAM_CLOSED either way (events.bit), and
// `h2connOnRstStream`, `h2connOnWindowUpdate` and `h2connCmdRespond` all return
// without acting either way — so a late RST_STREAM, WINDOW_UPDATE or PRIORITY on
// a stream that has just closed is answered without a table entry, which is what
// §5.1 requires of them. The ordering state a late HEADERS is judged against
// (`st.lastPeerStreamId`, `st.nextStreamId`) lives on the connection rather than
// in the table, so it survives the release and a released id stays unreusable.
//
// Nothing is owed on a stream by the time it reaches here, on either side:
//
//   - client: `h2connFailAll` — the only thing that ever wakes a `roundTrip`
//     parked on `s.replyCh` after the fact — already SKIPS a closed stream
//     (`s.state != h2stClosed`, below), so a closed entry was never reachable by
//     it and keeping one bought nothing. `h2connDeliverResponse` and
//     `h2connFailStreamMsg` both answer through the `s` they already hold, not
//     through the table.
//   - server: `h2connDeliverRequest` hands the `Request` to `serve`'s `acceptCh`
//     by value, so the handler holds its own reference, and it answers through
//     `h2connCmdRespond`, which refuses a closed stream already. A server
//     stream's `replyCh` is `h2connDummyReply()` and nothing receives from it.
//
// Every caller that closes a client stream whose `roundTrip` has not been
// answered goes through `h2connFailStreamMsg` below, which answers it first.
// `h2connCmdReset` (`Conn.resetStream`) was the one that did not: it closed the
// stream directly and left that caller parked forever at `deadlineNs == 0`
// (#4598). It now routes through `h2connStreamErrorMsg` like every other
// deliberate reset.
fn h2connCloseStream(st: h2connState, s: h2connStream) {
  if (s.state == h2stClosed) {
    return
  }
  s.state = h2stClosed
  st.activeStreams = st.activeStreams - 1
  // One exception to the release, added with the incremental body read (#4624):
  // a stream whose body reader has not taken its final answer keeps its entry,
  // because that answer is the only thing standing between a mid-body reset and
  // a silently truncated body. `h2connFinishReader` below releases it instead,
  // and the retention is bounded by that one read rather than by the connection.
  if (s.bodyOpen) {
    return
  }
  delete(st.streams, s.id)
}

// --- the incremental body read (#4624) ---------------------------------------

// Hand `k` bytes of receive credit back to the peer and say so on the wire: the
// connection window always, the stream window only while the stream can still
// receive. `ended` is END_STREAM — half-close, after which a stream
// WINDOW_UPDATE would grant credit nobody can spend.
//
// Called with the padding at arrival (`h2connOnData`, events.bit) and with the
// body bytes at the moment the application TAKES them (`h2connSendBody` below),
// which is the whole of what #4624 changed: credit follows consumption, so the
// window depletes for as long as a body sits unread.
fn h2connGrantWindows(st: h2connState, streamId: int, s: h2connStream, k: int, ended: bool) {
  h2connRenewConnWindow(st, k)
  if (k == 0 || ended) {
    return
  }
  s.recvWindow = s.recvWindow + k
  h2connSendWindowUpdate(st, WindowUpdateFrame{ streamId: streamId, increment: k })
}

// The reader of `s`'s body has taken its last answer — `eof` or an error — so it
// owes no more reads and nothing is waiting on this entry any longer. Releases
// the entry `h2connCloseStream` held back if the stream is already closed.
fn h2connFinishReader(st: h2connState, s: h2connStream) {
  if (!s.bodyOpen) {
    return
  }
  s.bodyOpen = false
  st.openBodies = st.openBodies - 1
  if (s.state == h2stClosed) {
    delete(st.streams, s.id)
  }
}

// Answer one read with everything `s` has buffered, and grant that much credit
// back. Takes the buffer whole: the reader asked for the next bytes, not for a
// count, so there is no partial take to account for and the held credit stays
// exactly `len(s.recvBody)`.
fn h2connSendBody(st: h2connState, s: h2connStream, ch: chan<h2connRead>) {
  let data = s.recvBody
  s.recvBody = []byte(0)
  h2connGrantWindows(st, s.id, s, len(data), s.recvEnded)
  if (s.recvEnded) {
    h2connFinishReader(st, s)
  }
  ch <- h2connRead{ data: data, eof: s.recvEnded, errMsg: "" }
}

// Release a parked reader if there is now something to tell it — bytes, or the
// end of the stream. Called from every site that adds to `recvBody` or sets
// `recvEnded`; a no-op when no reader is parked or nothing has changed.
fn h2connAnswerReader(st: h2connState, s: h2connStream) {
  if (!s.hasReader) {
    return
  }
  if (len(s.recvBody) == 0 && !s.recvEnded) {
    return
  }
  let ch = s.readCh
  s.hasReader = false
  s.readCh = h2connDummyRead()
  h2connSendBody(st, s, ch)
}

// Tell a parked reader its stream died. The message is the one the failure
// carried, so a reader and a waiting `roundTrip` are told the same sentence.
fn h2connFailReader(st: h2connState, s: h2connStream, msg: string) {
  if (!s.hasReader) {
    return
  }
  let ch = s.readCh
  s.hasReader = false
  s.readCh = h2connDummyRead()
  h2connFinishReader(st, s)
  ch <- h2connRead{ data: []byte(0), eof: true, errMsg: msg }
}

// Fail every stream still owing bytes to a body reader, on the way down
// (`h2connTerminate`, events.bit). Snapshotted before the walk for the reason
// `h2connFailAbandoned` gives: failing a stream can delete its table entry, and
// the runtime's map iterator does not allow mutation mid-walk (SPEC §12.6).
fn h2connFailBodies(st: h2connState, msg: string) {
  let doomed = []h2connStream(0)
  for (_, s) of st.streams {
    if (s.bodyOpen) {
      doomed = append(doomed, s)
    }
  }
  for s of doomed {
    h2connFailStreamMsg(st, s, errorInternalError, msg)
  }
}

// --- delivering completed messages -------------------------------------------

fn h2connDeliverResponse(st: h2connState, s: h2connStream) {
  if (s.replied) {
    return
  }
  s.replied = true
  let res = h2connBuildResponse(s.recvHeaders, s.recvBody)
  s.replyCh <- h2connMsg{ ok: true, response: res, errMsg: "" }
  h2connCloseStream(st, s)
}

// Hand a request to `serve` as soon as its HEADERS are complete, NOT at
// END_STREAM (#4624). `req.body` is empty and `hasBody` says whether DATA is
// still to come; the receiving thread drains it through `h2cmdRead`, which is
// what turns the receive windows into real backpressure — under the old
// deliver-at-END_STREAM rule nothing downstream existed to wait on, so credit
// had to be granted the instant DATA landed.
fn h2connDeliverRequest(st: h2connState, s: h2connStream) {
  if (s.delivered) {
    return
  }
  s.delivered = true
  if (!s.recvEnded) {
    s.bodyOpen = true
    st.openBodies = st.openBodies + 1
  }
  let req = h2connBuildRequest(s.recvHeaders)
  st.acceptCh <- h2connAccept{
    stop: false,
    streamId: s.id,
    request: req,
    hasBody: s.bodyOpen,
  }
}

// The `readCh` of every command that is not an `h2cmdRead`, and the `readCh` of
// a stream with no parked reader: a channel field needs a value, and this is one
// nothing ever sends to. Same role `h2connDummyReply` plays for `replyCh`.
fn h2connDummyRead(): chan<h2connRead> {
  return chan<h2connRead>(1)
}

// Take a served request's body from the loop, a chunk at a time, and return it
// whole (#4624). THIS thread is the consumer the receive windows now follow: the
// loop holds the credit for every byte it has buffered and renews it as this
// drains, so a peer uploading faster than a handler is reached stops at the
// window. Draining here and handing the handler a complete `req.body` is what
// keeps every existing handler working unchanged; an incremental surface for the
// handler itself is one method over this same command.
//
// A stream that dies mid-body fails the drain rather than truncating the body:
// the loop reports it in `errMsg` whether this thread was parked on the read or
// between two of them.
fn h2connDrainBody(s: Stream): []byte! {
  let body = []byte(0)
  while (true) {
    let ch = chan<h2connRead>(1)
    s.cmdCh <- h2connCmd{
      kind: h2cmdRead,
      readCh: ch,
      request: h2connZeroRequest(),
      response: h2connZeroResponse(),
      streamId: s.id,
      errorCode: 0,
      replyCh: h2connDummyReply(),
    }
    let r = <- ch
    if (r.errMsg != "") {
      fail newError(r.errMsg)
    }
    body = h2connAppendBytes(body, r.data)
    if (r.eof) {
      return body
    }
  }
}

// --- error paths -------------------------------------------------------------

// What a waiting `roundTrip` is told when the PEER reset a stream: nothing is
// known about it beyond the code the peer sent, so the code is the message.
fn h2connPeerResetMsg(code: int): string {
  return "http2: stream reset by peer (code " + h2connItoa(code) + ")"
}

// What a waiting `roundTrip` is told when THIS side reset the stream, i.e. the
// application called `Conn.resetStream` on it (#4598).
//
// `h2connPeerResetMsg`'s wording would be false here — nothing about the peer is
// being reported — and a caller told its own request was "reset by peer" would
// blame, and retry against, a peer that did nothing. Same distinction #4590 drew
// for the body budget. The code is the one the application chose, which is also
// all the peer is told (RFC 9113 §6.4).
fn h2connLocalResetMsg(code: int): string {
  return "http2: stream reset locally (code " + h2connItoa(code) + ")"
}

// Reset a single stream: tell the peer with RST_STREAM and tear our side down.
fn h2connStreamError(st: h2connState, streamId: int, code: int) {
  h2connStreamErrorMsg(st, streamId, code, h2connPeerResetMsg(code))
}

// `h2connStreamError` for a reset WE decided on, where the engine knows more
// than the wire code carries — an over-budget body naming the limit it broke
// (`h2connBodyBudgetOk`, events.bit, #4590). `msg` is what a waiting client
// `roundTrip` is handed; the peer still gets only `code`, which is all
// RST_STREAM can say (RFC 9113 §6.4).
fn h2connStreamErrorMsg(st: h2connState, streamId: int, code: int, msg: string) {
  h2connSendRstStream(st, RstStreamFrame{ streamId: streamId, errorCode: code })
  let (s, ok) = st.streams[streamId]
  if (!ok) {
    return
  }
  h2connFailStreamMsg(st, s, code, msg)
}

// Fail a stream we already hold: close it, and if a client `roundTrip` is waiting
// on it, hand back an error.
fn h2connFailStreamCode(st: h2connState, s: h2connStream, code: int) {
  h2connFailStreamMsg(st, s, code, h2connPeerResetMsg(code))
}

// `h2connFailStreamCode` with the message spelled by the caller rather than
// derived from `code`.
fn h2connFailStreamMsg(st: h2connState, s: h2connStream, code: int, msg: string) {
  if (s.state == h2stClosed) {
    return
  }
  s.reset = true
  s.errorCode = code
  // Recorded so a body reader that was BETWEEN reads when this happened is told
  // the same sentence when it next asks (`h2connCmdRead`, events.bit), rather
  // than an `eof` that would read as a complete body (#4624).
  s.errMsg = msg
  h2connFailReader(st, s, msg)
  h2connCloseStream(st, s)
  if (st.isClient && !s.replied) {
    s.replied = true
    s.replyCh <- h2connMsg{ ok: false, response: h2connZeroResponse(), errMsg: msg }
  }
}

// A connection error: emit GOAWAY once, then terminate the connection — RFC
// 9113 §5.4.1 requires an endpoint raising one to send GOAWAY and then close,
// and a connection that keeps serving a peer it has just declared dead is what
// #4606 was (every one of this module's connection-error paths kept running).
//
// The GOAWAY is queued BEFORE `h2connTerminate` (events.bit) deliberately: the
// terminate queues the writer's `stop`, and the writer drains `writeCh` in
// order, so this is what puts the GOAWAY on the wire ahead of the writer's own
// exit. Terminating also fails every waiting stream — `h2connFailAll` is called
// from in there, not from here.
//
// The GRACEFUL GOAWAY (`h2connCmdGoaway`, events.bit, behind `Conn.close()`) is
// a different thing and does not come through here: it keeps the connection
// running so in-flight streams can complete.
fn h2connConnError(st: h2connState, code: int, msg: string) {
  if (!st.goawaySent) {
    st.goawaySent = true
    h2connSendGoaway(
      st,
      GoawayFrame{ lastStreamId: st.lastPeerStreamId, errorCode: code, debugData: []byte(msg) },
    )
  }
  h2connTerminate(st, msg)
}

// What a waiting `roundTrip` is told when the peer's GOAWAY named a
// `lastStreamId` below its stream's id. RFC 9113 §6.8 makes that a positive
// statement — the stream was not processed and never will be — so it is a
// different thing from `h2connPeerResetMsg`'s "the peer reset this stream" and
// from `h2connFailAll`'s "the connection is gone", and the caller may safely
// retry the request on a new connection.
fn h2connGoawayMsg(code: int): string {
  return "http2: stream not processed, peer sent GOAWAY (code " + h2connItoa(code) + ")"
}

// True when `id` names a stream THIS endpoint opened. Client-initiated ids are
// odd and server-initiated ones even (RFC 9113 §5.1.1); rather than restate
// that here, ask `h2connFirstId` (conn.bit) — the one place this engine decides
// which ids it allocates — for the parity of its own.
fn h2connWeOpened(st: h2connState, id: int): bool {
  return (id & 1) == (h2connFirstId(st.isClient) & 1)
}

// Fail every stream WE opened that a GOAWAY says the peer never processed
// (#4605). `lastStreamId` is the highest id its sender might have acted on or
// might yet act on (RFC 9113 §6.8), so everything above it was not and will not
// be — a client `roundTrip` parked on one of those is waiting for a response
// that is never coming. Streams AT or below it are still live and are left
// alone; that is the whole point of the field.
//
// Only streams we opened: a GOAWAY's `lastStreamId` speaks about the streams
// its RECEIVER initiated, so a server reading a client's GOAWAY must not take
// it as licence to drop the requests it is still answering.
//
// The code is carried into the message rather than translated: nothing is known
// about an unprocessed stream beyond what the connection-level GOAWAY said, the
// same reasoning `h2connPeerResetMsg` uses for RST_STREAM.
//
// Snapshotted before the walk rather than failed inside it: failing a stream
// closes it and closing it removes it from `st.streams` (`h2connCloseStream`,
// #4594), and the runtime's map iterator does not allow mutation mid-walk
// (SPEC §12.6). The snapshot holds the `h2connStream` objects themselves, not
// their ids — by the second pass the entry is gone, and `h2connFailStreamMsg`
// works off the stream it is handed and never off the table.
fn h2connFailAbandoned(st: h2connState, lastStreamId: int, code: int) {
  let doomed = []h2connStream(0)
  for (id, s) of st.streams {
    if (id > lastStreamId && h2connWeOpened(st, id)) {
      doomed = append(doomed, s)
    }
  }
  let msg = h2connGoawayMsg(code)
  for s of doomed {
    h2connFailStreamMsg(st, s, code, msg)
  }
}

// Deliver `msg` as an error to every client stream still awaiting a response.
fn h2connFailAll(st: h2connState, msg: string) {
  for (_, s) of st.streams {
    if (st.isClient && !s.replied && s.state != h2stClosed) {
      s.replied = true
      s.replyCh <- h2connMsg{ ok: false, response: h2connZeroResponse(), errMsg: msg }
    }
  }
}

// --- outbound frame helpers --------------------------------------------------
//
// Each wrapper encodes a typed frame and queues its bytes for the writer. The
// `catch` arms are unreachable — every frame here is built from validated fields
// — so a failed encode drops the frame rather than crashing the loop.

fn h2connEnqueue(st: h2connState, b: []byte) {
  st.writeCh <- h2connOut{ stop: false, data: b }
}

fn h2connSendHeaders(st: h2connState, f: HeadersFrame) {
  let b = encodeHeaders(f) catch _ {
    return
  }
  h2connEnqueue(st, b)
}

fn h2connSendContinuation(st: h2connState, f: ContinuationFrame) {
  let b = encodeContinuation(f) catch _ {
    return
  }
  h2connEnqueue(st, b)
}

fn h2connSendData(st: h2connState, f: DataFrame) {
  let b = encodeData(f) catch _ {
    return
  }
  h2connEnqueue(st, b)
}

fn h2connSendWindowUpdate(st: h2connState, f: WindowUpdateFrame) {
  let b = encodeWindowUpdate(f) catch _ {
    return
  }
  h2connEnqueue(st, b)
}

fn h2connSendRstStream(st: h2connState, f: RstStreamFrame) {
  let b = encodeRstStream(f) catch _ {
    return
  }
  h2connEnqueue(st, b)
}

fn h2connSendGoaway(st: h2connState, f: GoawayFrame) {
  let b = encodeGoaway(f) catch _ {
    return
  }
  h2connEnqueue(st, b)
}

fn h2connSendPing(st: h2connState, f: PingFrame) {
  let b = encodePing(f) catch _ {
    return
  }
  h2connEnqueue(st, b)
}

fn h2connSendSettingsAck(st: h2connState) {
  let b = encodeSettings(SettingsFrame{ ack: true, settings: []Setting(0) }) catch _ {
    return
  }
  h2connEnqueue(st, b)
}

// Send a header block as a HEADERS frame, splitting into CONTINUATION frames when
// it does not fit one frame (RFC 9113 §6.2). END_STREAM rides the HEADERS frame;
// END_HEADERS rides the final fragment.
fn h2connSendHeaderBlock(st: h2connState, streamId: int, block: []byte, endStream: bool) {
  let maxf = st.peerMaxFrameSize
  if (maxf <= 0) {
    maxf = defaultMaxFrameSize
  }
  if (len(block) <= maxf) {
    h2connSendHeaders(
      st,
      HeadersFrame{
        streamId: streamId,
        blockFragment: block,
        endStream: endStream,
        endHeaders: true,
        padLength: 0 - 1,
        hasPriority: false,
        exclusive: false,
        streamDependency: 0,
        weight: 0,
      },
    )
    return
  }
  h2connSendHeaders(
    st,
    HeadersFrame{
      streamId: streamId,
      blockFragment: block[0:maxf],
      endStream: endStream,
      endHeaders: false,
      padLength: 0 - 1,
      hasPriority: false,
      exclusive: false,
      streamDependency: 0,
      weight: 0,
    },
  )
  let pos = maxf
  while (pos < len(block)) {
    let end = pos + maxf
    if (end > len(block)) {
      end = len(block)
    }
    let last = end == len(block)
    h2connSendContinuation(
      st,
      ContinuationFrame{ streamId: streamId, blockFragment: block[pos:end], endHeaders: last },
    )
    pos = end
  }
}

