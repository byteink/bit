// Bit standard library — http2 module, the outbound half of the stream state
// machine: flow-controlled sending, state transitions, message delivery, error
// paths, and the frame-emitting helpers.
// Split out of `conn.bit`; same flat `std/http2` module and namespace.

// --- flow-controlled sending -------------------------------------------------

// Send as much of a stream's pending body as the stream and connection windows
// allow, in frames no larger than the peer's max frame size. Stops when the body
// drains (ending the stream if END_STREAM was requested) or a window is
// exhausted — a later WINDOW_UPDATE resumes it.
fn h2connFlushStream(st: h2connState, s: h2connStream) {
  while (s.hasPending) {
    let avail = s.sendWindow
    if (st.connSendWindow < avail) {
      avail = st.connSendWindow
    }
    if (avail <= 0) {
      return
    }
    let n = len(s.pendingData)
    if (n > avail) {
      n = avail
    }
    if (n > st.peerMaxFrameSize) {
      n = st.peerMaxFrameSize
    }
    let chunk = s.pendingData[0:n]
    let last = n == len(s.pendingData) && s.pendingEnd
    h2connSendData(st, DataFrame{ streamId: s.id, data: chunk, endStream: last, padLength: 0 - 1 })
    s.pendingData = s.pendingData[n:len(s.pendingData)]
    s.sendWindow = s.sendWindow - n
    st.connSendWindow = st.connSendWindow - n
    if (len(s.pendingData) == 0) {
      s.hasPending = false
      if (s.pendingEnd) {
        h2connLocalEnd(st, s)
      }
    }
  }
}

// Resume every stream blocked on send credit, after a connection-level
// WINDOW_UPDATE or a SETTINGS_INITIAL_WINDOW_SIZE increase handed some back.
//
// NOT `for (_, s) of st.streams { h2connFlushStream(st, s) }`, which is what
// this replaced at two call sites: draining a stream's last pending bytes ends
// it (`h2connLocalEnd`), ending it closes it, and closing it now removes it from
// `st.streams` (`h2connCloseStream`, #4594) — a mutation in the middle of a
// walk the runtime's iterator explicitly does not allow (SPEC §12.6;
// `bit_rt_map_iter_next`, runtime/root/maps.bit, "iteration assumes no
// mutation"). So collect the ids first — only a stream with `hasPending` can
// make progress, so the snapshot is normally empty — and flush outside the walk.
//
// The re-read is the two-result form because a single-result read of an absent
// key panics (SPEC §12.6) and only the comma-ok form is total; flushing one
// stream cannot release another today, and this does not depend on that.
fn h2connFlushAll(st: h2connState) {
  let ids = []int(0)
  for (id, s) of st.streams {
    if (s.hasPending) {
      ids = append(ids, id)
    }
  }
  for id of ids {
    let (s, ok) = st.streams[id]
    if (ok) {
      h2connFlushStream(st, s)
    }
  }
}

// --- stream state transitions ------------------------------------------------

// We sent END_STREAM: open -> half-closed(local); half-closed(remote) -> closed.
fn h2connLocalEnd(st: h2connState, s: h2connStream) {
  if (s.state == h2stHCRemote) {
    h2connCloseStream(st, s)
    return
  }
  s.state = h2stHCLocal
}

// The peer sent END_STREAM: open -> half-closed(remote); half-closed(local) ->
// closed.
fn h2connRecvEndTransition(st: h2connState, s: h2connStream) {
  if (s.state == h2stHCLocal) {
    h2connCloseStream(st, s)
    return
  }
  if (s.state == h2stOpen) {
    s.state = h2stHCRemote
  }
}

// Move `s` to the closed state (RFC 9113 §5.1) and drop it from the connection's
// stream table (#4594).
//
// Retaining a closed stream's PROTOCOL state is what §5.1 asks for; retaining
// its `recvBody`, `pendingData` and `recvHeaders` for the life of the connection
// is not, and until this deleted the entry a server holding one connection open
// for a browser accumulated every body it ever served on it — at up to
// `Config.maxBodyBytes` each (#4590), which bounds one stream and not their sum.
//
// A released entry is indistinguishable from a never-created one, which is what
// makes the removal safe rather than merely smaller. Every read of the table is
// guarded by `st.present[id] == 0`, and each of those guards already answers a
// PRESENT CLOSED stream exactly as it answers an absent one:
// `h2connDataStreamOk` reports STREAM_CLOSED either way (events.bit), and
// `h2connOnRstStream`, `h2connOnWindowUpdate` and `h2connCmdRespond` all return
// without acting either way — so a late RST_STREAM, WINDOW_UPDATE or PRIORITY on
// a stream that has just closed is answered without a table entry, which is what
// §5.1 requires of them. The ordering state a late HEADERS is judged against
// (`st.lastPeerStreamId`, `st.nextStreamId`) lives on the connection rather than
// in the table, so it survives the release and a released id stays unreusable.
//
// Nothing is owed on a stream by the time it reaches here, on either side:
//
//   - client: `h2connFailAll` — the only thing that ever wakes a `roundTrip`
//     parked on `s.replyCh` after the fact — already SKIPS a closed stream
//     (`s.state != h2stClosed`, below), so a closed entry was never reachable by
//     it and keeping one bought nothing. `h2connDeliverResponse` and
//     `h2connFailStreamMsg` both answer through the `s` they already hold, not
//     through the table.
//   - server: `h2connDeliverRequest` hands the `Request` to `serve`'s `acceptCh`
//     by value, so the handler holds its own reference, and it answers through
//     `h2connCmdRespond`, which refuses a closed stream already. A server
//     stream's `replyCh` is `h2connDummyReply()` and nothing receives from it.
//
// The one caller that closes a client stream with its `roundTrip` still
// unanswered is `h2connCmdReset` (`Conn.resetStream`), which stranded that
// caller before this change too — see #4598, filed separately, and note no
// public API hands out the stream id it takes.
fn h2connCloseStream(st: h2connState, s: h2connStream) {
  if (s.state == h2stClosed) {
    return
  }
  s.state = h2stClosed
  st.activeStreams = st.activeStreams - 1
  delete(st.streams, s.id)
  delete(st.present, s.id)
}

// --- delivering completed messages -------------------------------------------

fn h2connDeliverResponse(st: h2connState, s: h2connStream) {
  if (s.replied) {
    return
  }
  s.replied = true
  let res = h2connBuildResponse(s.recvHeaders, s.recvBody)
  s.replyCh <- h2connMsg{ ok: true, response: res, errMsg: "" }
  h2connCloseStream(st, s)
}

fn h2connDeliverRequest(st: h2connState, s: h2connStream) {
  if (s.delivered) {
    return
  }
  s.delivered = true
  let req = h2connBuildRequest(s.recvHeaders)
  req.body = s.recvBody
  st.acceptCh <- h2connAccept{ stop: false, streamId: s.id, request: req }
}

// --- error paths -------------------------------------------------------------

// What a waiting `roundTrip` is told when the PEER reset a stream: nothing is
// known about it beyond the code the peer sent, so the code is the message.
fn h2connPeerResetMsg(code: int): string {
  return "http2: stream reset by peer (code " + h2connItoa(code) + ")"
}

// Reset a single stream: tell the peer with RST_STREAM and tear our side down.
fn h2connStreamError(st: h2connState, streamId: int, code: int) {
  h2connStreamErrorMsg(st, streamId, code, h2connPeerResetMsg(code))
}

// `h2connStreamError` for a reset WE decided on, where the engine knows more
// than the wire code carries — an over-budget body naming the limit it broke
// (`h2connBodyBudgetOk`, events.bit, #4590). `msg` is what a waiting client
// `roundTrip` is handed; the peer still gets only `code`, which is all
// RST_STREAM can say (RFC 9113 §6.4).
fn h2connStreamErrorMsg(st: h2connState, streamId: int, code: int, msg: string) {
  h2connSendRstStream(st, RstStreamFrame{ streamId: streamId, errorCode: code })
  if (st.present[streamId] == 0) {
    return
  }
  let s = st.streams[streamId]
  h2connFailStreamMsg(st, s, code, msg)
}

// Fail a stream we already hold: close it, and if a client `roundTrip` is waiting
// on it, hand back an error.
fn h2connFailStreamCode(st: h2connState, s: h2connStream, code: int) {
  h2connFailStreamMsg(st, s, code, h2connPeerResetMsg(code))
}

// `h2connFailStreamCode` with the message spelled by the caller rather than
// derived from `code`.
fn h2connFailStreamMsg(st: h2connState, s: h2connStream, code: int, msg: string) {
  if (s.state == h2stClosed) {
    return
  }
  s.reset = true
  s.errorCode = code
  h2connCloseStream(st, s)
  if (st.isClient && !s.replied) {
    s.replied = true
    s.replyCh <- h2connMsg{ ok: false, response: h2connZeroResponse(), errMsg: msg }
  }
}

// A connection error: emit GOAWAY once and fail every waiting stream.
fn h2connConnError(st: h2connState, code: int, msg: string) {
  if (!st.goawaySent) {
    st.goawaySent = true
    h2connSendGoaway(
      st,
      GoawayFrame{ lastStreamId: st.lastPeerStreamId, errorCode: code, debugData: []byte(msg) },
    )
  }
  h2connFailAll(st, msg)
}

// Deliver `msg` as an error to every client stream still awaiting a response.
fn h2connFailAll(st: h2connState, msg: string) {
  for (_, s) of st.streams {
    if (st.isClient && !s.replied && s.state != h2stClosed) {
      s.replied = true
      s.replyCh <- h2connMsg{ ok: false, response: h2connZeroResponse(), errMsg: msg }
    }
  }
}

// --- outbound frame helpers --------------------------------------------------
//
// Each wrapper encodes a typed frame and queues its bytes for the writer. The
// `catch` arms are unreachable — every frame here is built from validated fields
// — so a failed encode drops the frame rather than crashing the loop.

fn h2connEnqueue(st: h2connState, b: []byte) {
  st.writeCh <- h2connOut{ stop: false, data: b }
}

fn h2connSendHeaders(st: h2connState, f: HeadersFrame) {
  let b = encodeHeaders(f) catch _ {
    return
  }
  h2connEnqueue(st, b)
}

fn h2connSendContinuation(st: h2connState, f: ContinuationFrame) {
  let b = encodeContinuation(f) catch _ {
    return
  }
  h2connEnqueue(st, b)
}

fn h2connSendData(st: h2connState, f: DataFrame) {
  let b = encodeData(f) catch _ {
    return
  }
  h2connEnqueue(st, b)
}

fn h2connSendWindowUpdate(st: h2connState, f: WindowUpdateFrame) {
  let b = encodeWindowUpdate(f) catch _ {
    return
  }
  h2connEnqueue(st, b)
}

fn h2connSendRstStream(st: h2connState, f: RstStreamFrame) {
  let b = encodeRstStream(f) catch _ {
    return
  }
  h2connEnqueue(st, b)
}

fn h2connSendGoaway(st: h2connState, f: GoawayFrame) {
  let b = encodeGoaway(f) catch _ {
    return
  }
  h2connEnqueue(st, b)
}

fn h2connSendPing(st: h2connState, f: PingFrame) {
  let b = encodePing(f) catch _ {
    return
  }
  h2connEnqueue(st, b)
}

fn h2connSendSettingsAck(st: h2connState) {
  let b = encodeSettings(SettingsFrame{ ack: true, settings: []Setting(0) }) catch _ {
    return
  }
  h2connEnqueue(st, b)
}

// Send a header block as a HEADERS frame, splitting into CONTINUATION frames when
// it does not fit one frame (RFC 9113 §6.2). END_STREAM rides the HEADERS frame;
// END_HEADERS rides the final fragment.
fn h2connSendHeaderBlock(st: h2connState, streamId: int, block: []byte, endStream: bool) {
  let maxf = st.peerMaxFrameSize
  if (maxf <= 0) {
    maxf = defaultMaxFrameSize
  }
  if (len(block) <= maxf) {
    h2connSendHeaders(
      st,
      HeadersFrame{
        streamId: streamId,
        blockFragment: block,
        endStream: endStream,
        endHeaders: true,
        padLength: 0 - 1,
        hasPriority: false,
        exclusive: false,
        streamDependency: 0,
        weight: 0,
      },
    )
    return
  }
  h2connSendHeaders(
    st,
    HeadersFrame{
      streamId: streamId,
      blockFragment: block[0:maxf],
      endStream: endStream,
      endHeaders: false,
      padLength: 0 - 1,
      hasPriority: false,
      exclusive: false,
      streamDependency: 0,
      weight: 0,
    },
  )
  let pos = maxf
  while (pos < len(block)) {
    let end = pos + maxf
    if (end > len(block)) {
      end = len(block)
    }
    let last = end == len(block)
    h2connSendContinuation(
      st,
      ContinuationFrame{ streamId: streamId, blockFragment: block[pos:end], endHeaders: last },
    )
    pos = end
  }
}

