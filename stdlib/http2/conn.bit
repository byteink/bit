// Bit standard library — http2 module, the HTTP/2 connection engine (RFC 9113).
//
// `hpack.bit` and `frames.bit` are pure codecs; this file drives them over a
// live byte transport. A `Conn` runs the connection preface, the SETTINGS
// exchange, the per-stream state machine (§5.1), HEADERS+CONTINUATION assembly
// through the HPACK decoder (§6.2), DATA flow control at both the connection and
// stream level (§6.9), request/response multiplexing over concurrent streams,
// and the graceful/abrupt shutdown frames GOAWAY (§6.8) and RST_STREAM (§6.4).
// There is no TLS here — the `Transport` is any bidirectional byte stream, so a
// `Conn` is exercised over an in-memory pipe just as well as a socket.
//
// Concurrency model — a Conn is an **actor**. Three green threads run per Conn:
// a *reader* that turns transport bytes into whole frames, a *writer* that drains
// queued frame bytes to the transport, and the *loop* that owns every piece of
// mutable connection state (the stream table, the flow-control windows, the HPACK
// encoder/decoder, the settings). No other thread touches that state; the public
// API and the reader/writer communicate with the loop only through channels, so
// there is no shared mutable memory and thus no data race (SPEC §16.4). Because
// the single loop encodes outbound header blocks and decodes inbound ones in wire
// order, the two peers' HPACK dynamic tables stay in lock-step for free.
//
// This file is part of the flat `std/http2` module and shares one namespace with
// `hpack.bit` and `frames.bit`; every unexported helper here is prefixed
// `h2conn` so the three files never collide.

// `monotonic`/`sleep` bound the wait for the peer's opening SETTINGS
// (`h2connAwaitReady`, #3019) — the module's only use of std/time.
import { monotonic, sleep } from "std/time"

// --- the byte transport ------------------------------------------------------

// An abstract bidirectional byte stream. `read` returns up to `n` bytes and an
// empty slice at end-of-stream; `write` delivers every byte of its argument or
// fails; `close` releases the underlying stream. A `Conn` needs nothing else, so
// the same engine runs over a socket (`std/net`) or an in-memory pipe.
export struct Transport {
  export read: (int) => []byte,
  export write: ([]byte) => ()!,
  export shutdown: () => (),
}

// Bundle three closures into a `Transport`. `shutdown` releases the stream (the
// socket `close`, an EOF signal on a pipe); it is named `shutdown` rather than
// `close` to avoid shadowing the `close` channel builtin.
export fn newTransport(
  read: (int) => []byte,
  write: ([]byte) => ()!,
  shutdown: () => (),
): Transport {
  return Transport{ read: read, write: write, shutdown: shutdown }
}

// --- configuration -----------------------------------------------------------

// The local half of the SETTINGS a `Conn` advertises: `initialWindowSize` is the
// per-stream flow-control window we grant the peer (SETTINGS_INITIAL_WINDOW_SIZE),
// `maxFrameSize` the largest frame payload we accept (SETTINGS_MAX_FRAME_SIZE),
// and `headerTableSize` our HPACK dynamic-table bound (SETTINGS_HEADER_TABLE_SIZE).
export struct Config {
  export initialWindowSize: int,
  export maxFrameSize: int,
  export headerTableSize: int,
}

// The RFC-default configuration: a 65535-byte initial window, a 16384-byte max
// frame size, and a 4096-byte header table.
export fn defaultConfig(): Config {
  return Config{
    initialWindowSize: 65535,
    maxFrameSize: defaultMaxFrameSize,
    headerTableSize: 4096,
  }
}

// --- request / response ------------------------------------------------------

// An HTTP/2 request: the `:method`/`:scheme`/`:authority`/`:path` pseudo-headers
// as named fields, the remaining regular `headers`, and the `body`.
export struct Request {
  export method: string,
  export scheme: string,
  export authority: string,
  export path: string,
  export headers: []HeaderField,
  export body: []byte,
}

// An HTTP/2 response: the numeric `:status`, the regular `headers`, and the
// `body`. A `status` of 0 handed back from a `serve` handler is the signal to
// abort the stream with RST_STREAM (CANCEL) instead of answering.
export struct Response { export status: int, export headers: []HeaderField, export body: []byte }

// A GET-style request with empty headers and no body.
export fn newRequest(method: string, authority: string, path: string): Request {
  return Request{
    method: method,
    scheme: "https",
    authority: authority,
    path: path,
    headers: []HeaderField(0),
    body: []byte(0),
  }
}

// A response with a status and a body and no extra headers.
export fn newResponse(status: int, body: []byte): Response {
  return Response{ status: status, headers: []HeaderField(0), body: body }
}

// The value of header `name` (case-sensitive, as HTTP/2 requires lower-case
// field names), or "" if absent.
export fn getHeader(headers: []HeaderField, name: string): string {
  for h of headers {
    if (h.name == name) {
      return h.value
    }
  }
  return ""
}

// --- the connection handle ---------------------------------------------------

// A live HTTP/2 connection. Opaque: the mutable protocol state lives entirely in
// the loop thread, and every operation is a method that talks to it over a
// channel. Create one with `connect` (client) or `accept` (server).
// `readerDone`/`writerDone` are not exported (no field is) — reach them only
// through `waitReaderDone()`/`waitWriterDone()`.
//
// `deadlineNs` is the same absolute monotonic deadline `connect`/`accept`
// received (0 = no bound), kept here so `roundTrip` can bound its own wait
// on `replyCh` the same way `h2connAwaitReady` bounds the SETTINGS wait
// (#3036).
export struct Conn {
  isClient: bool,
  cmdCh: chan<h2connCmd>,
  acceptCh: chan<h2connAccept>,
  readerDone: chan<int>,
  writerDone: chan<int>,
  deadlineNs: int,
}

// --- connection setup --------------------------------------------------------

// The 24-byte client connection preface (RFC 9113 §3.4). The client sends it,
// then its initial SETTINGS; the server reads and validates it before anything
// else.
const h2connPreface: string = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"

// Dial: run the client side of the preface (magic + SETTINGS) over `t` and start
// the connection. The returned `Conn` is ready for `roundTrip`.
//
// `deadlineNs` bounds the wait for the peer's opening SETTINGS — an absolute
// monotonic nanosecond deadline (`std/time`'s `monotonic()` plus a budget,
// the same convention `std/net`/`std/tls` use), or 0 for no bound. Pass the
// SAME deadline the transport's own reads are bounded by (0 if none) — a
// nonzero deadline over an unbounded transport can make setup fail here
// while the transport itself waits out its own unrelated, unbounded read
// (#3019).
export fn connect(t: Transport, cfg: Config, deadlineNs: int): Conn! {
  t.write([]byte(h2connPreface))?
  let r = h2connNewFrameReader(t)
  return h2connStart(t, cfg, true, r, deadlineNs)?
}

// Answer: read and validate the client preface over `t`, then start the
// connection. Drive the returned `Conn` with `serve`. `deadlineNs` is as
// `connect`'s.
export fn accept(t: Transport, cfg: Config, deadlineNs: int): Conn! {
  let r = h2connNewFrameReader(t)
  let magic = h2connReadExact(r, len(h2connPreface))?
  if (!h2connBytesEqual(magic, []byte(h2connPreface))) {
    fail newError("http2: malformed client connection preface")
  }
  return h2connStart(t, cfg, false, r, deadlineNs)?
}

// Common startup: send our SETTINGS, allocate the channels, build the loop-owned
// state, and spawn the reader, writer, and loop threads.
fn h2connStart(
  t: Transport,
  cfg: Config,
  isClient: bool,
  r: h2connFrameReader,
  deadlineNs: int,
): Conn! {
  t.write(encodeSettings(h2connOurSettings(cfg))?)?

  let inCh = chan<h2connEvent>(64)
  let cmdCh = chan<h2connCmd>(64)
  let writeCh = chan<h2connOut>(256)
  let acceptCh = chan<h2connAccept>(256)
  let readyCh = chan<int>(1)
  let readerDoneCh = chan<int>(1)
  let writerDoneCh = chan<int>(1)

  let st = h2connState{
    isClient: isClient,
    inCh: inCh,
    cmdCh: cmdCh,
    writeCh: writeCh,
    acceptCh: acceptCh,
    readyCh: readyCh,
    readySignaled: false,
    enc: newEncoderConfig(cfg.headerTableSize, true),
    dec: newDecoderConfig(cfg.headerTableSize),
    streams: map<int, h2connStream>(),
    present: map<int, int>(),
    nextStreamId: h2connFirstId(isClient),
    lastPeerStreamId: 0,
    connSendWindow: 65535,
    connRecvWindow: 65535,
    peerInitialWindow: 65535,
    ourInitialWindow: cfg.initialWindowSize,
    peerMaxFrameSize: defaultMaxFrameSize,
    ourMaxFrameSize: cfg.maxFrameSize,
    lastStreamId: 0,
    contStream: 0,
    contBuf: []byte(0),
    contEndStream: false,
    contNewStream: false,
    goawaySent: false,
    goawayReceived: false,
    running: true,
    activeStreams: 0,
  }

  spawn h2connWriter(t, writeCh, writerDoneCh)
  spawn h2connReader(r, inCh, cfg.maxFrameSize, readerDoneCh)
  spawn h2connLoop(st)
  // Complete the SETTINGS handshake before handing the connection back: block
  // until the loop has processed the peer's initial SETTINGS, so the peer's
  // window and frame-size limits are known before the first request is sent.
  // Bounded by `deadlineNs` and by the teardown path, not a bare receive —
  // see `h2connAwaitReady` (#3019).
  h2connAwaitReady(readyCh, readerDoneCh, writerDoneCh, deadlineNs)?
  return Conn{
    isClient: isClient,
    cmdCh: cmdCh,
    acceptCh: acceptCh,
    readerDone: readerDoneCh,
    writerDone: writerDoneCh,
    deadlineNs: deadlineNs,
  }
}

// Block until the loop signals `readyCh` (1 for the peer's opening SETTINGS,
// 0 for a teardown before that — events.bit's EOF handling) or until
// `deadlineNs` elapses first (0 = no bound). A channel receive has no timer
// of its own, unlike a socket read, so one is armed here explicitly for
// exactly this wait: a green thread that sleeps for the remaining budget
// then signals `timeoutCh`, raced against `readyCh` with `select`.
//
// On EITHER failure, drains `readerDoneCh` then `writerDoneCh` before failing
// so the reader and writer green threads `h2connStart` just spawned are
// provably done touching the transport by the time this returns — required
// before whoever called `connect`/`accept` can safely close the transport
// (the same close-before-done fd-reuse hazard #3016 fixed for a live `Conn`'s
// reader, now guarded here — for both threads — for a `Conn` that never got
// created). Reader first, writer second: the writer's release is caused by
// the loop processing the reader's own eof event (`events.bit`), so draining
// it first is what makes the writer's drain bounded rather than a guess.
// This is bounded, not a second unbounded wait: a torn-down connection's
// reader has already hit the failure that triggered the teardown signal, and
// a timed-out wait's reader is reading over the identical `deadlineNs` (see
// `connect`'s doc), so either way the reader's own read fails at essentially
// the same moment, the loop's eof handling follows from that, and both
// `doneCh`s follow in short order.
fn h2connAwaitReady(
  readyCh: chan<int>,
  readerDoneCh: chan<int>,
  writerDoneCh: chan<int>,
  deadlineNs: int,
): ()! {
  let timeoutCh = chan<int>(1)
  if (deadlineNs != 0) {
    spawn h2connArmDeadline(deadlineNs, timeoutCh)
  }
  let outcome = 0
  select {
    case sig = <- readyCh:
      if (sig == 0) {
        outcome = 1
      }
    case tick = <- timeoutCh:
      outcome = 2
  }
  if (outcome == 0) {
    return
  }
  <- readerDoneCh
  <- writerDoneCh
  if (outcome == 2) {
    fail newError("http2: timed out waiting for peer SETTINGS")
  }
  fail newError("http2: connection closed before peer SETTINGS")
}

// Send once on `timeoutCh` once `deadlineNs` (an absolute monotonic
// nanosecond deadline) has passed, or immediately if it already has. Its own
// green thread so `h2connAwaitReady`'s `select` can race it against
// `readyCh`; `timeoutCh` is buffered (capacity 1) so this send never blocks,
// including when `readyCh` already won the race and nothing will ever
// receive it.
fn h2connArmDeadline(deadlineNs: int, timeoutCh: chan<int>) {
  let remaining = deadlineNs - monotonic()
  if (remaining > 0) {
    sleep(remaining)
  }
  timeoutCh <- 1
}

// Block until `replyCh` delivers a stream's outcome, or `deadlineNs` elapses
// first (0 = no bound) — the same race `h2connAwaitReady` runs for the
// SETTINGS wait, and needed for the identical reason: a channel receive has
// no timer of its own, and no deadline on the transport's own reads can
// reach it.
//
// This closes a real gap, not a hypothetical one: `h2connLoop`'s
// `while (st.running)` (loop.bit) stops as soon as an inbound `eof` flips
// `st.running`, WITHOUT draining anything still queued in `cmdCh` — so a
// `h2cmdOpen` that reaches `cmdCh` around the same moment the reader's `eof`
// reaches `inCh` can lose the race and sit there forever: the loop thread
// has already returned, nothing will ever read it, and nothing will ever
// send on the `replyCh` `roundTrip` is waiting on (#3036). Draining `cmdCh`
// in the `eof` branch would not fully close this — a command sent AFTER the
// loop has already left its `select` cannot be drained by a handler that
// thread will never run again — so `roundTrip` bounds its own wait instead,
// exactly as `h2connAwaitReady` already does for the symmetric case one step
// earlier in the connection's lifecycle.
fn h2connAwaitReply(replyCh: chan<h2connMsg>, deadlineNs: int): h2connMsg! {
  let timeoutCh = chan<int>(1)
  if (deadlineNs != 0) {
    spawn h2connArmDeadline(deadlineNs, timeoutCh)
  }
  select {
    case reply = <- replyCh:
      return reply
    case tick = <- timeoutCh:
      fail newError("http2: timed out waiting for response")
  }
}

// The first stream id this endpoint allocates: clients use odd ids from 1, and a
// server would use even ids for push (unused here, but kept correct).
fn h2connFirstId(isClient: bool): int {
  if (isClient) {
    return 1
  }
  return 2
}

// Our advertised SETTINGS built from `cfg`.
fn h2connOurSettings(cfg: Config): SettingsFrame {
  let list = []Setting(0)
  list = append(list, Setting{ id: settingsHeaderTableSize, value: cfg.headerTableSize })
  list = append(list, Setting{ id: settingsInitialWindowSize, value: cfg.initialWindowSize })
  list = append(list, Setting{ id: settingsMaxFrameSize, value: cfg.maxFrameSize })
  return SettingsFrame{ ack: false, settings: list }
}

// --- header <-> struct mapping -----------------------------------------------

fn h2connRequestFields(req: Request): []HeaderField {
  let fields = []HeaderField(0)
  fields = append(fields, HeaderField{ name: ":method", value: req.method, sensitive: false })
  fields = append(fields, HeaderField{ name: ":scheme", value: req.scheme, sensitive: false })
  fields = append(fields, HeaderField{ name: ":authority", value: req.authority, sensitive: false })
  fields = append(fields, HeaderField{ name: ":path", value: req.path, sensitive: false })
  for h of req.headers {
    fields = append(fields, h)
  }
  return fields
}

fn h2connResponseFields(res: Response): []HeaderField {
  let fields = []HeaderField(0)
  fields = append(
    fields,
    HeaderField{ name: ":status", value: h2connItoa(res.status), sensitive: false },
  )
  for h of res.headers {
    fields = append(fields, h)
  }
  return fields
}

fn h2connBuildRequest(fields: []HeaderField): Request {
  let method = ""
  let scheme = ""
  let authority = ""
  let path = ""
  let hs = []HeaderField(0)
  for h of fields {
    if (h.name == ":method") {
      method = h.value
    } else if (h.name == ":scheme") {
      scheme = h.value
    } else if (h.name == ":authority") {
      authority = h.value
    } else if (h.name == ":path") {
      path = h.value
    } else {
      hs = append(hs, h)
    }
  }
  return Request{
    method: method,
    scheme: scheme,
    authority: authority,
    path: path,
    headers: hs,
    body: []byte(0),
  }
}

fn h2connBuildResponse(fields: []HeaderField, body: []byte): Response {
  let status = 0
  let hs = []HeaderField(0)
  for h of fields {
    if (h.name == ":status") {
      status = h2connAtoi(h.value)
    } else {
      hs = append(hs, h)
    }
  }
  return Response{ status: status, headers: hs, body: body }
}

fn h2connMergeHeaders(a: []HeaderField, b: []HeaderField): []HeaderField {
  let out = a
  for h of b {
    out = append(out, h)
  }
  return out
}

// --- buffered frame reader ---------------------------------------------------

// Reads whole frames off a `Transport`, buffering the partial tail between reads.
// Used only by the reader thread (and, before it starts, the preface read), so
// its `buf` has a single owner.
struct h2connFrameReader { read: (int) => []byte, buf: []byte }

fn h2connNewFrameReader(t: Transport): h2connFrameReader {
  return h2connFrameReader{ read: t.read, buf: []byte(0) }
}

// Ensure at least `need` bytes are buffered, reading from the transport. Fails at
// end-of-stream.
fn h2connFill(r: h2connFrameReader, need: int): ()! {
  while (len(r.buf) < need) {
    let chunk = r.read(4096)
    if (len(chunk) == 0) {
      fail newError("http2: connection closed")
    }
    r.buf = h2connAppendBytes(r.buf, chunk)
  }
}

// Return the next `n` bytes as a fresh slice and advance. The copy keeps the
// returned bytes stable as later reads mutate the buffer.
fn h2connReadExact(r: h2connFrameReader, n: int): []byte! {
  h2connFill(r, n)?
  let out = h2connCopyN(r.buf, n)
  r.buf = r.buf[n:len(r.buf)]
  return out
}

// Read one whole frame, rejecting any whose declared length exceeds `maxFrameSize`
// (our advertised SETTINGS_MAX_FRAME_SIZE).
fn h2connNextFrame(r: h2connFrameReader, maxFrameSize: int): Frame! {
  let hdrBytes = h2connReadExact(r, 9)?
  let h = decodeFrameHeader(hdrBytes)?
  if (h.length > maxFrameSize) {
    fail newError("http2: frame exceeds max frame size")
  }
  let payload = h2connReadExact(r, h.length)?
  return Frame{ header: h, payload: payload }
}

// --- small helpers -----------------------------------------------------------

fn h2connZeroFrame(): Frame {
  return Frame{
    header: FrameHeader{ length: 0, ftype: 0, flags: 0, streamId: 0 },
    payload: []byte(0),
  }
}

fn h2connZeroResponse(): Response {
  return Response{ status: 0, headers: []HeaderField(0), body: []byte(0) }
}

fn h2connZeroRequest(): Request {
  return Request{
    method: "",
    scheme: "",
    authority: "",
    path: "",
    headers: []HeaderField(0),
    body: []byte(0),
  }
}

fn h2connDummyReply(): chan<h2connMsg> {
  return chan<h2connMsg>(1)
}

fn h2connBytesEqual(a: []byte, b: []byte): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

fn h2connCopyN(src: []byte, n: int): []byte {
  let out = []byte(n)
  let i = 0
  while (i < n) {
    out[i] = src[i]
    i = i + 1
  }
  return out
}

fn h2connAppendBytes(dst: []byte, src: []byte): []byte {
  let out = dst
  for x of src {
    out = append(out, x)
  }
  return out
}

// Decimal text of a non-negative integer.
fn h2connItoa(n: int): string {
  if (n == 0) {
    return "0"
  }
  let digits = []byte(0)
  let v = n
  while (v > 0) {
    digits = append(digits, byte(48 + v % 10))
    v = v / 10
  }
  let out = []byte(len(digits))
  let i = 0
  while (i < len(digits)) {
    out[i] = digits[len(digits) - 1 - i]
    i = i + 1
  }
  return string(out)
}

// Non-negative integer parsed from decimal text; 0 on any non-digit.
fn h2connAtoi(s: string): int {
  let v = 0
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      return 0
    }
    v = v * 10 + (int(c) - 48)
    i = i + 1
  }
  return v
}

// --- public connection API ---------------------------------------------------

// Send `req` on a fresh stream and block until its full response arrives. Safe to
// call from many green threads at once — each request rides its own stream,
// multiplexed over the one connection. Bounded by the same deadline
// `connect`/`accept` received (0 = no bound) — see `h2connAwaitReply` (#3036).
export fn (c: Conn) roundTrip(req: Request): Response! {
  let replyCh = chan<h2connMsg>(1)
  c.cmdCh <- h2connCmd{
    kind: h2cmdOpen,
    request: req,
    response: h2connZeroResponse(),
    streamId: 0,
    errorCode: 0,
    replyCh: replyCh,
  }
  let msg = h2connAwaitReply(replyCh, c.deadlineNs)?
  if (!msg.ok) {
    fail newError(msg.errMsg)
  }
  return msg.response
}

// Serve inbound requests, dispatching each to `handler` on its own green thread,
// until the connection closes. A handler that returns a `Response` with status 0
// aborts that stream with RST_STREAM (CANCEL).
export fn (c: Conn) serve(handler: (Request) => Response): ()! {
  while (true) {
    let a = <- c.acceptCh
    if (a.stop) {
      return
    }
    spawn h2connHandle(c.cmdCh, a.streamId, a.request, handler)
  }
}

fn h2connHandle(
  cmdCh: chan<h2connCmd>,
  streamId: int,
  req: Request,
  handler: (Request) => Response,
) {
  let res = handler(req)
  cmdCh <- h2connCmd{
    kind: h2cmdRespond,
    request: h2connZeroRequest(),
    response: res,
    streamId: streamId,
    errorCode: 0,
    replyCh: h2connDummyReply(),
  }
}

// Block until the reader green thread spawned by `connect`/`accept` has
// observed a transport read failure (an ordinary close included) and returned.
//
// A closer that releases the transport's underlying resource (e.g. an fd a
// later `dial` can recycle) WITHOUT calling this first is racing the reader,
// which is still parked in a read on that same resource with no way for
// anything outside this thread to interrupt it — closing does not wake it,
// it only makes the read the reader is retrying eventually fail, on the
// reader's own schedule. Call this AFTER closing the transport (that failure
// is what the reader is waiting to observe) and BEFORE reusing anything the
// transport owned. NOT idempotent — the reader signals exactly once, so a
// second call on the same `Conn` blocks forever; call it exactly once per
// `Conn`, from a single teardown path. Returns immediately if the reader has
// already stopped for any other reason (a protocol error, the peer closing
// first) by the time this is called.
export fn (c: Conn) waitReaderDone() {
  <- c.readerDone
}

// Block until the writer green thread spawned by `connect`/`accept` has
// stopped touching the transport. Unlike the reader, the writer is normally
// parked on an empty command channel rather than a transport read, so
// closing (or even shutting down) the transport does not wake it by itself —
// only the loop thread's own `eof` handling (`events.bit`) queues the stop
// message that lets it exit, once it has observed (via `waitReaderDone()`)
// that the connection is tearing down. Call this AFTER `waitReaderDone()`
// and BEFORE reusing anything the transport owned, for the identical
// use-after-close reason `waitReaderDone()` documents — the writer's last
// queued write is a real transport write, and closing out from under it is
// the same fd-reuse hazard #3016 fixed for reads. NOT idempotent — call it
// exactly once per `Conn`, from a single teardown path.
export fn (c: Conn) waitWriterDone() {
  <- c.writerDone
}

// Begin a graceful shutdown: emit GOAWAY so the peer starts no new streams.
// In-flight streams still complete; subsequent `roundTrip` calls are refused.
export fn (c: Conn) close() {
  c.cmdCh <- h2connCmd{
    kind: h2cmdGoaway,
    request: h2connZeroRequest(),
    response: h2connZeroResponse(),
    streamId: 0,
    errorCode: errorNoError,
    replyCh: h2connDummyReply(),
  }
}

// Abort stream `streamId` with RST_STREAM carrying `errorCode`.
export fn (c: Conn) resetStream(streamId: int, errorCode: int) {
  c.cmdCh <- h2connCmd{
    kind: h2cmdReset,
    request: h2connZeroRequest(),
    response: h2connZeroResponse(),
    streamId: streamId,
    errorCode: errorCode,
    replyCh: h2connDummyReply(),
  }
}
