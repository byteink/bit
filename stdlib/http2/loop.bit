// Bit standard library — http2 module, the connection actor: the loop-owned
// state, the channel message types, and the three green threads that run per
// `Conn`. Split out of `conn.bit`; same flat `std/http2` module and namespace.

// --- loop-owned state --------------------------------------------------------

// Stream states (RFC 9113 §5.1). The reserved-for-push states are omitted.
const h2stIdle: int = 0
const h2stOpen: int = 1
const h2stHCLocal: int = 2
const h2stHCRemote: int = 3
const h2stClosed: int = 4

// One multiplexed stream. Only the loop thread touches this. `sendWindow` is how
// many DATA bytes we may still send (the peer's receive window); `recvWindow` how
// many the peer may still send us. `pendingData`/`pendingEnd`/`hasPending` hold
// body bytes waiting on flow-control credit. `replyCh` is where a client stream's
// completed `Response` (or error) is delivered to the waiting `roundTrip`.
class h2connStream {
  id: int,
  state: int,
  sendWindow: int,
  recvWindow: int,
  recvHeaders: []HeaderField,
  headersDone: bool,
  recvBody: []byte,
  recvEnded: bool,
  pendingData: []byte,
  pendingEnd: bool,
  hasPending: bool,
  replyCh: chan<h2connMsg>,
  replied: bool,
  delivered: bool,
  reset: bool,
  errorCode: int,
}

// The whole connection state, owned exclusively by the loop thread.
class h2connState {
  isClient: bool,
  inCh: chan<h2connEvent>,
  cmdCh: chan<h2connCmd>,
  writeCh: chan<h2connOut>,
  acceptCh: chan<h2connAccept>,
  // `readyCh` delivers exactly one value to `h2connAwaitReady` (conn.bit): 1
  // once the peer's opening SETTINGS is in effect, or 0 if the connection
  // tore down before that ever happened (events.bit's EOF handling, #3019).
  // `readySignaled` guards it to that single send either way.
  readyCh: chan<int>,
  readySignaled: bool,
  enc: Encoder,
  dec: Decoder,
  // The stream table, keyed by stream id, with `present` its presence set (a
  // bare `streams[id]` on a miss has no zero value to yield, SPEC §12.6). It
  // holds IN-FLIGHT streams only: an entry is removed the moment its stream
  // reaches the closed state, so a long-lived connection does not accumulate
  // every body it ever carried — see `h2connCloseStream` (streams.bit, #4594)
  // for why an absent entry and a closed one answer every reader alike.
  streams: map<int, h2connStream>,
  present: map<int, int>,
  nextStreamId: int,
  lastPeerStreamId: int,
  connSendWindow: int,
  connRecvWindow: int,
  peerInitialWindow: int,
  ourInitialWindow: int,
  // The largest header block the engine will accumulate in `contBuf` before it
  // fails the connection (`Config.maxHeaderListBytes`, conn.bit, #4593). Truly
  // connection state: a block in progress spans frames and is keyed by
  // `contStream`, not by a stream table entry.
  maxHeaderListBytes: int,
  // The most DATA one stream may accumulate in `recvBody` before the engine
  // resets it (`Config.maxBodyBytes`, conn.bit, #4590). Connection-wide, not
  // per-stream state, because it is a setting rather than a running total.
  maxBodyBytes: int,
  peerMaxFrameSize: int,
  ourMaxFrameSize: int,
  // The most streams the peer may have OPEN at once
  // (`Config.maxConcurrentStreams`, config.bit, #4595): what we advertise as
  // SETTINGS_MAX_CONCURRENT_STREAMS and what `h2connServerHeaders` refuses a
  // new peer-initiated stream against. Compared with `activeStreams` below.
  maxConcurrentStreams: int,
  // The same limit in the other direction: what the PEER advertised, which
  // bounds the streams WE open (`h2connCmdOpen`, events.bit). RFC 9113 §6.5.2
  // gives the parameter no initial value — until a peer SETTINGS names one
  // there is no limit — so it starts at `h2connNoPeerStreamLimit` below, the
  // largest number the parameter can carry rather than a sentinel, which keeps
  // the check one comparison.
  peerMaxConcurrentStreams: int,
  // The largest header list the PEER will accept from us
  // (SETTINGS_MAX_HEADER_LIST_SIZE, #4607), counted the way RFC 9113 §6.5.2
  // counts it: name + value + 32 per field of the UNCOMPRESSED list. A limit on
  // what we SEND, so its twin is `peerMaxFrameSize` above and not
  // `maxHeaderListBytes`, which bounds what we ACCUMULATE and is counted in
  // encoded octets. Starts at `h2connNoPeerHeaderListLimit` below.
  peerMaxHeaderListBytes: int,
  lastStreamId: int,
  contStream: int,
  contBuf: []byte,
  contEndStream: bool,
  contNewStream: bool,
  goawaySent: bool,
  goawayReceived: bool,
  running: bool,
  // How many streams are in the table, i.e. how many are open or half-closed —
  // exactly the streams RFC 9113 §5.1.2 counts toward a concurrency limit.
  // Incremented at the two sites that insert into `streams` (`h2connCmdOpen`
  // and `h2connServerHeaders`, events.bit) and decremented at the one that
  // deletes (`h2connCloseStream`, streams.bit, #4594), which returns early on
  // an already-closed stream so no stream is counted out twice.
  activeStreams: int,
}

// The peer's SETTINGS_MAX_CONCURRENT_STREAMS before it has sent one: 2^32-1, the
// largest value the wire form of the parameter can carry (a 32-bit unsigned,
// RFC 9113 §6.5.1). The RFC's initial state is "unlimited", and this spells that
// as a number the peer could have sent itself rather than as a sentinel — so
// `h2connCmdOpen` compares, instead of branching on "has a limit arrived yet".
const h2connNoPeerStreamLimit: int = 4294967295

// The peer's SETTINGS_MAX_HEADER_LIST_SIZE before it has sent one, spelled the
// same way and for the same reason: 2^32-1, the largest value the parameter's
// 32-bit wire form can carry (RFC 9113 §6.5.1), standing for the RFC's initial
// state of "unlimited". It cannot be 0 — 0 is a legal advertised value and means
// the peer accepts no header list at all — and as a number the peer could itself
// have sent it keeps `h2connCmdOpen` and `h2connCmdRespond` (events.bit) to one
// comparison each, with no branch on whether a limit has arrived yet.
const h2connNoPeerHeaderListLimit: int = 4294967295

// A fresh stream in the idle state.
fn h2connNewStream(
  id: int,
  sendWindow: int,
  recvWindow: int,
  replyCh: chan<h2connMsg>,
): h2connStream {
  return h2connStream{
    id: id,
    state: h2stIdle,
    sendWindow: sendWindow,
    recvWindow: recvWindow,
    recvHeaders: []HeaderField(0),
    headersDone: false,
    recvBody: []byte(0),
    recvEnded: false,
    pendingData: []byte(0),
    pendingEnd: false,
    hasPending: false,
    replyCh: replyCh,
    replied: false,
    delivered: false,
    reset: false,
    errorCode: 0,
  }
}

// --- channel message types ---------------------------------------------------

// An inbound event from the reader thread: a whole `frame`, or `eof` when the
// transport closed.
class h2connEvent { eof: bool, frame: Frame }

// A byte buffer queued for the writer thread; `stop` tells it to stop (without
// touching the transport itself — see `h2connWriter`) and exit.
class h2connOut { stop: bool, data: []byte }

// Command kinds sent from the public API to the loop.
const h2cmdOpen: int = 1
const h2cmdRespond: int = 2
const h2cmdGoaway: int = 3
const h2cmdReset: int = 4

// A command to the loop: open a client stream, answer a server stream, send a
// GOAWAY, or reset a stream. Unused fields carry zero values.
class h2connCmd {
  kind: int,
  request: Request,
  response: Response,
  streamId: int,
  errorCode: int,
  replyCh: chan<h2connMsg>,
}

// The result delivered to a waiting `roundTrip`: `ok` with a `response`, or a
// failure with `errMsg`.
class h2connMsg { ok: bool, response: Response, errMsg: string }

// A fully-received request handed to the `serve` loop; `stop` ends the loop.
class h2connAccept { stop: bool, streamId: int, request: Request }

// --- the three threads -------------------------------------------------------

// Reader thread: read whole frames off the transport and forward them; on EOF or
// a framing error, emit one final `eof` event and stop.
//
// `doneCh` is signalled right before this thread returns, unconditionally — the
// ONLY way anything outside this thread can know it has stopped touching the
// transport. This runtime has no way to interrupt a thread parked in a transport
// read from outside, so a closer cannot make the reader stop; it can only wait
// for the reader to notice the close (or any other read failure) on its own and
// say so here. `Conn.waitReaderDone()` receives from `doneCh` — see its doc
// comment and `h2clientExchange` (stdlib/http/h2.bit) for why a caller closing
// the transport out from under a still-parked reader is a use-after-close.
fn h2connReader(
  r: h2connFrameReader,
  inCh: chan<h2connEvent>,
  maxFrameSize: int,
  doneCh: chan<int>,
) {
  while (true) {
    let fr = h2connNextFrame(r, maxFrameSize) catch _ {
      inCh <- h2connEvent{ eof: true, frame: h2connZeroFrame() }
      doneCh <- 1
      return
    }
    inCh <- h2connEvent{ eof: false, frame: fr }
  }
}

// Writer thread: drain queued frame bytes to the transport in order until a
// `stop` message or a write failure ends the thread.
//
// `doneCh` is signalled right before every return, unconditionally — the same
// contract `h2connReader`'s `doneCh` has above, and for the same reason: this
// runtime cannot interrupt a green thread from outside, so a closer can only
// wait for this thread to notice it should stop and say so here.
// `Conn.waitWriterDone()` receives from it.
//
// Deliberately does NOT call `t.shutdown()` (or any other transport
// operation) on the `stop` path. Releasing the transport belongs to the
// thread that owns it, never to this one or the loop — so this thread only
// ever writes queued bytes or stops; having it also shut down would race the
// caller's own explicit close (#3026). The one place inside this module that
// does shut a transport down, `h2connAwaitReady` (conn.bit, #4608), is not a
// counter-example: it runs on `connect`/`accept`'s own thread, which IS the
// owner, and it does so before either of these two threads has been joined
// precisely so that they can be.
fn h2connWriter(t: Transport, ch: chan<h2connOut>, doneCh: chan<int>) {
  while (true) {
    let out = <- ch
    if (out.stop) {
      doneCh <- 1
      return
    }
    t.write(out.data) catch _ {
      doneCh <- 1
      return
    }
  }
}

// Loop thread: the sole owner of `st`. Serially fold in one inbound frame or one
// command at a time until the transport closes.
fn h2connLoop(st: h2connState) {
  while (st.running) {
    select {
      case ev = <- st.inCh:
        h2connHandleEvent(st, ev)
      case cmd = <- st.cmdCh:
        h2connHandleCmd(st, cmd)
    }
  }
}

