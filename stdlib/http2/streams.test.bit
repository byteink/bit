// stdlib/http2/streams.test.bit — a terminal stream is released from the
// connection's stream table (#4594), and a stream THIS side resets answers the
// `roundTrip` waiting on it (#4598, the last section).
//
// #4590 bounded what ONE stream may buffer. Nothing bounded how many streams a
// connection keeps: `h2connCloseStream` flipped the state and left the entry —
// with its `recvBody`, `pendingData` and `recvHeaders` attached — in
// `st.streams` for the life of the connection, so a server holding one
// connection open for a browser grew by up to `Config.maxBodyBytes` for every
// request it ever served on it.
//
// These drive the frame and command handlers directly against a hand-built
// `h2connState` (`btState`/`btOpenStream`/`btPattern` from `events.test.bit`,
// same flat `std/http2` module, so nothing is imported), with no threads and no
// transport. That is what makes the claim checkable as `len(st.streams)` rather
// than inferred from a memory measurement.

// --- a server endpoint and the peer talking to it ----------------------------

// A hand-built server-side loop state plus the HPACK encoder a peer would use
// for its half of the connection.
//
// `enc` is deliberately NOT `st.enc`. Two encoder/decoder pairs run over an
// HTTP/2 connection and each must stay in lockstep on its own: the peer's
// encoder against `st.dec` for inbound blocks, and `st.enc` against the peer's
// decoder for outbound ones. Building inbound frames with `st.enc` would insert
// into a dynamic table `st.dec` never mirrors and desync both pairs after the
// first response.
class srPeer { st: h2connState, enc: Encoder }

fn srNewPeer(): srPeer {
  return srPeer{ st: btState(false, 1048576), enc: newEncoderConfig(4096, true) }
}

// The pseudo-header set a `POST path` request decodes to.
fn srRequestFields(path: string): []HeaderField {
  let fs = []HeaderField(0)
  fs = append(fs, HeaderField{ name: ":method", value: "POST", sensitive: false })
  fs = append(fs, HeaderField{ name: ":scheme", value: "https", sensitive: false })
  fs = append(fs, HeaderField{ name: ":authority", value: "example.com", sensitive: false })
  fs = append(fs, HeaderField{ name: ":path", value: path, sensitive: false })
  return fs
}

// A single-fragment HEADERS frame carrying `fields`, built through the real
// codec so the handler sees exactly what the wire would hand it.
fn srHeadersFrame(enc: Encoder, id: int, fields: []HeaderField, endStream: bool): Frame! {
  let wire = encodeHeaders(
    HeadersFrame{
      streamId: id,
      blockFragment: enc.encode(fields),
      endStream: endStream,
      endHeaders: true,
      padLength: 0 - 1,
      hasPriority: false,
      exclusive: false,
      streamDependency: 0,
      weight: 0,
    },
  )?
  return readFrame(wire, maxMaxFrameSize)?
}

// The peer's half of one request on `id`: HEADERS, then a 64-byte body that ends
// the request. Returns the `Request` `serve` takes off `acceptCh` — so the
// stream really did carry a body before anything released it. Driven through
// `h2connHandleFrame`, not the per-frame handlers, so the new-stream decision
// (`st.present[id] == 0`, which a release changes) is the engine's and not the
// test's.
fn srServeStart(p: srPeer, id: int, path: string): Request! {
  let hf = srHeadersFrame(p.enc, id, srRequestFields(path), false)?
  h2connHandleFrame(p.st, hf)
  let df = btDataFrame(id, btPattern(64), true)?
  h2connHandleFrame(p.st, df)
  let a = <- p.st.acceptCh
  return a.request
}

// The handler's answer, as `h2connHandle` (conn.bit) would deliver it.
fn srServeFinish(p: srPeer, id: int, body: []byte) {
  h2connCmdRespond(
    p.st,
    h2connCmd{
      kind: h2cmdRespond,
      request: h2connZeroRequest(),
      response: newResponse(200, body),
      streamId: id,
      errorCode: 0,
      replyCh: h2connDummyReply(),
    },
  )
}

// How many frames the loop has queued for the writer, discarding them.
// `btState`'s `writeCh` holds 64 and a served stream queues three, so a run of
// streams must drain as it goes; the count is returned rather than dropped so
// every caller states what it expected to be there.
fn srDrainWrites(st: h2connState): int {
  let n = 0
  while (true) {
    select {
      case _ = <- st.writeCh:
        n = n + 1
      default:
        return n
    }
  }
}

// The three frames one complete server stream queues: the connection-level
// WINDOW_UPDATE replenished when the request body landed, and the response's
// HEADERS and DATA.
const srFramesPerStream: int = 3

// A `:status` response header set.
fn srStatusFields(status: int): []HeaderField {
  let fs = []HeaderField(0)
  fs = append(fs, HeaderField{ name: ":status", value: h2connItoa(status), sensitive: false })
  return fs
}

// --- the release itself ------------------------------------------------------

test "a completed server stream is released from the connection's stream table" {
  let p = srNewPeer()
  let req = srServeStart(p, 1, "/echo") catch e {
    assert(false, "driving the stream failed: ${e.message()}")
    return
  }
  assert(len(req.body) == 64, "the handler saw a ${len(req.body)}-byte body, want 64")
  assert(len(p.st.streams) == 1, "the in-flight stream is not in the table")
  srServeFinish(p, 1, req.body)
  let queued = srDrainWrites(p.st)
  assert(queued == srFramesPerStream, "queued ${queued} frames, want ${srFramesPerStream}")
  assert(len(p.st.streams) == 0, "st.streams holds ${len(p.st.streams)} entries, want 0")
  assert(len(p.st.present) == 0, "st.present holds ${len(p.st.present)} entries, want 0")
  assert(p.st.activeStreams == 0, "activeStreams = ${p.st.activeStreams}, want 0")
}

test "the stream table does not grow with the number of completed streams" {
  // The bug itself: every one of these 64 streams used to stay in `st.streams`
  // with its body attached, and a real connection's bodies are bounded at
  // `Config.maxBodyBytes` (32 MiB by default) each, not at 64 bytes.
  let p = srNewPeer()
  let inflightPeak = 0
  let id = 1
  while (id <= 127) {
    let req = srServeStart(p, id, "/echo") catch e {
      assert(false, "stream ${id} failed: ${e.message()}")
      return
    }
    // The table DOES hold a stream while it is in flight. Without this the
    // assertion below would pass just as well on an engine that never created
    // one, which is the shape of a test that cannot fail.
    if (len(p.st.streams) > inflightPeak) {
      inflightPeak = len(p.st.streams)
    }
    srServeFinish(p, id, req.body)
    let queued = srDrainWrites(p.st)
    assert(queued == srFramesPerStream, "stream ${id} queued ${queued} frames")
    assert(len(p.st.streams) == 0, "after stream ${id} the table holds ${len(p.st.streams)}")
    id = id + 2
  }
  assert(inflightPeak == 1, "the table never held an in-flight stream (peak ${inflightPeak})")
  assert(len(p.st.streams) == 0, "after 64 streams the table holds ${len(p.st.streams)} entries")
  assert(len(p.st.present) == 0, "after 64 streams the presence set holds ${len(p.st.present)}")
  assert(p.st.activeStreams == 0, "activeStreams = ${p.st.activeStreams}, want 0")
}

test "a client stream is released once its round trip has been answered" {
  // The client's release point is `s.replied` — the moment `h2connDeliverResponse`
  // has handed the `Response` to the `roundTrip` parked on `replyCh`.
  let st = btState(true, 1048576)
  let replyCh = chan<h2connMsg>(1)
  let s = btOpenStream(st, 1, replyCh)
  h2connClientHeaders(st, 1, srStatusFields(200), false)
  let f = btDataFrame(1, btPattern(64), true) catch e {
    assert(false, "building the DATA frame failed: ${e.message()}")
    return
  }
  h2connOnData(st, f)
  let msg = <- replyCh
  assert(msg.ok, "the round trip failed: ${msg.errMsg}")
  assert(len(msg.response.body) == 64, "response body ${len(msg.response.body)} bytes, want 64")
  assert(s.state == h2stClosed, "the stream is in state ${s.state}, want ${h2stClosed}")
  assert(len(st.streams) == 0, "st.streams holds ${len(st.streams)} entries, want 0")
  assert(len(st.present) == 0, "st.present holds ${len(st.present)} entries, want 0")
}

test "a stream still in flight is not released, and a connection error reaches it" {
  // The control on the release predicate, and the invariant that bounds it: a
  // stream is dropped when it reaches the CLOSED state and not before, because
  // `h2connFailAll` walking `st.streams` is the only thing that ever wakes a
  // `roundTrip` parked on `replyCh` when the connection dies under it.
  //
  // (`h2connFailAll` skips a closed stream by its own test, `s.state !=
  // h2stClosed`, so a closed entry was never reachable by it — which is why the
  // release needs no second condition. This is the case that IS reachable.)
  let st = btState(true, 1048576)
  let replyCh = chan<h2connMsg>(1)
  let s = btOpenStream(st, 1, replyCh)
  h2connClientHeaders(st, 1, srStatusFields(200), false)
  assert(s.state == h2stOpen, "the stream is in state ${s.state}, want ${h2stOpen}")
  assert(len(st.streams) == 1, "a stream still in flight was released")
  assert(len(st.present) == 1, "a stream still in flight was released from st.present")
  h2connFailAll(st, "http2: connection closed")
  let msg = <- replyCh
  assert(!msg.ok, "the waiting round trip was answered with a success")
  assert(msg.errMsg == "http2: connection closed", "unexpected error: '${msg.errMsg}'")
  let queued = srDrainWrites(st)
  assert(queued == 0, "failing every stream queued ${queued} frames, want 0")
}

// --- what a late frame on a released stream gets -----------------------------

test "a late RST_STREAM on a released stream is ignored, not a protocol error" {
  // RFC 9113 §5.1: a closed stream may still receive RST_STREAM (and
  // WINDOW_UPDATE, and PRIORITY) for a short while, because the peer's frames
  // were in flight when we closed. Those are answered WITHOUT a table entry, not
  // by keeping one.
  let p = srNewPeer()
  let req = srServeStart(p, 1, "/echo") catch e {
    assert(false, "driving the stream failed: ${e.message()}")
    return
  }
  srServeFinish(p, 1, req.body)
  let queued = srDrainWrites(p.st)
  assert(queued == srFramesPerStream, "queued ${queued} frames, want ${srFramesPerStream}")
  assert(len(p.st.streams) == 0, "the stream was not released")

  let wire = encodeRstStream(RstStreamFrame{ streamId: 1, errorCode: errorCancel }) catch e2 {
    assert(false, "building the RST_STREAM failed: ${e2.message()}")
    return
  }
  let rst = readFrame(wire, maxMaxFrameSize) catch e3 {
    assert(false, "reading the RST_STREAM back failed: ${e3.message()}")
    return
  }
  h2connHandleFrame(p.st, rst)
  assert(!p.st.goawaySent, "a late RST_STREAM produced a GOAWAY")
  assert(p.st.running, "a late RST_STREAM tore the connection down")
  let after = srDrainWrites(p.st)
  assert(after == 0, "a late RST_STREAM queued ${after} frames, want 0")
}

test "a late DATA frame on a released stream is answered with RST_STREAM STREAM_CLOSED" {
  // The other half: an absent entry must read exactly like a present closed one,
  // and a present closed one has always been a STREAM_CLOSED stream error.
  let p = srNewPeer()
  let req = srServeStart(p, 1, "/echo") catch e {
    assert(false, "driving the stream failed: ${e.message()}")
    return
  }
  srServeFinish(p, 1, req.body)
  let queued = srDrainWrites(p.st)
  assert(queued == srFramesPerStream, "queued ${queued} frames, want ${srFramesPerStream}")

  let late = btDataFrame(1, btPattern(16), false) catch e2 {
    assert(false, "building the DATA frame failed: ${e2.message()}")
    return
  }
  h2connHandleFrame(p.st, late)
  assert(!p.st.goawaySent, "a late DATA frame produced a GOAWAY")
  let sent = btNextWritten(p.st) catch e3 {
    assert(false, "no frame was queued for the peer: ${e3.message()}")
    return
  }
  let rf = decodeRstStream(sent) catch e4 {
    assert(false, "the queued frame is not RST_STREAM: ${e4.message()}")
    return
  }
  assert(rf.streamId == 1, "RST_STREAM on stream ${rf.streamId}, want 1")
  assert(
    rf.errorCode == errorStreamClosed,
    "RST_STREAM code = ${rf.errorCode}, want ${errorStreamClosed} (STREAM_CLOSED)",
  )
  let after = srDrainWrites(p.st)
  assert(after == 0, "the late DATA queued ${after} extra frames, want 0")
}

test "a released stream id is not reusable" {
  // The ordering state a new stream is judged against (`st.lastPeerStreamId`)
  // lives on the connection, not in the table, so releasing stream 1 must not
  // make stream 1 look fresh again. RFC 9113 §5.1.1: reusing an identifier is a
  // connection error of type PROTOCOL_ERROR.
  let p = srNewPeer()
  let req = srServeStart(p, 1, "/echo") catch e {
    assert(false, "driving the stream failed: ${e.message()}")
    return
  }
  srServeFinish(p, 1, req.body)
  let queued = srDrainWrites(p.st)
  assert(queued == srFramesPerStream, "queued ${queued} frames, want ${srFramesPerStream}")
  assert(len(p.st.streams) == 0, "the stream was not released")

  let again = srHeadersFrame(p.enc, 1, srRequestFields("/again"), true) catch e2 {
    assert(false, "building the second HEADERS failed: ${e2.message()}")
    return
  }
  h2connHandleFrame(p.st, again)
  assert(p.st.goawaySent, "reusing a released stream id was accepted")
  let sent = btNextWritten(p.st) catch e3 {
    assert(false, "no GOAWAY was queued: ${e3.message()}")
    return
  }
  let ga = decodeGoaway(sent) catch e4 {
    assert(false, "the queued frame is not GOAWAY: ${e4.message()}")
    return
  }
  assert(
    ga.errorCode == errorProtocolError,
    "GOAWAY code = ${ga.errorCode}, want ${errorProtocolError} (PROTOCOL_ERROR)",
  )
}

// --- the path that resumes a stalled stream and then ends it -----------------

test "a body larger than the initial window completes through the resume path" {
  // The one place a stream can reach its close from INSIDE a walk of
  // `st.streams`: a body bigger than the 65535-byte connection window stalls in
  // `h2connFlushStream`, and the peer's WINDOW_UPDATE on stream 0 resumes it
  // through `h2connFlushAll` — which is where draining the last bytes ends the
  // stream, closes it, and deletes its entry. `h2connFlushAll` snapshots the ids
  // first for exactly that reason; the obvious
  // `for (_, s) of st.streams { h2connFlushStream(st, s) }` would be mutating
  // the map it is walking (SPEC §12.6).
  //
  // 200000 bytes is over three times the initial window in each direction, so
  // both the request and the echoed response take this path several times.
  let conn = btLoopback(defaultConfig()) catch e {
    assert(false, "loopback setup failed: ${e.message()}")
    return
  }
  let res = btPost(conn, 200000) catch e2 {
    assert(false, "a 200000-byte body did not complete: ${e2.message()}")
    return
  }
  assert(res.status == 200, "status = ${res.status}, want 200")
  assert(len(res.body) == 200000, "echoed ${len(res.body)} bytes, want 200000")
  assert(h2connBytesEqual(res.body, btPattern(200000)), "the echoed body is not the bytes sent")
}

// --- a reset THIS side asked for (#4598) -------------------------------------
//
// `Conn.resetStream` reaches the loop as an `h2cmdReset` command, and its
// handler used to close the stream and send nothing on `s.replyCh`. Nothing
// else would either: `h2connFailAll` is the only thing that wakes a `roundTrip`
// after the fact and it skips a closed stream by its own test, so a green
// thread parked in `roundTrip` on a stream another thread reset never returned
// at `deadlineNs == 0` — and on a deadline returned `http2: timed out waiting
// for response`, which named the wrong cause.
//
// Driven through `h2connHandleCmd` rather than `h2connCmdReset` directly, so
// the dispatch the loop actually performs is part of what is under test.

// The command `Conn.resetStream(streamId, errorCode)` puts on `cmdCh`, field
// for field.
fn srResetCmd(streamId: int, errorCode: int): h2connCmd {
  return h2connCmd{
    kind: h2cmdReset,
    request: h2connZeroRequest(),
    response: h2connZeroResponse(),
    streamId: streamId,
    errorCode: errorCode,
    replyCh: h2connDummyReply(),
  }
}

// The message a locally reset `roundTrip` must be handed, and the one it must
// NOT be handed. Spelled out here rather than built from the source's own
// helpers, so a change to either wording fails a test instead of following it.
fn srLocalWant(code: int): string {
  return "http2: stream reset locally (code ${code})"
}

fn srPeerWant(code: int): string {
  return "http2: stream reset by peer (code ${code})"
}

test "a locally reset client stream answers the round trip waiting on it" {
  // The ticket's acceptance: the reset arrives with the `roundTrip` still
  // parked, and the receive below is the last runnable task in this test, so
  // before the fix the runtime's deadlock detector turns the hang into a named
  // failure rather than a stall.
  let st = btState(true, 1048576)
  let replyCh = chan<h2connMsg>(1)
  let s = btOpenStream(st, 1, replyCh)

  h2connHandleCmd(st, srResetCmd(1, errorCancel))

  let msg = <- replyCh
  assert(!msg.ok, "the locally reset round trip was answered with a success")
  assert(msg.errMsg == srLocalWant(errorCancel), "roundTrip was told '${msg.errMsg}'")
  assert(
    msg.errMsg != srPeerWant(errorCancel),
    "a reset this side asked for was reported as the peer's doing",
  )
  assert(s.state == h2stClosed, "the stream is in state ${s.state}, want ${h2stClosed} (closed)")
  assert(s.reset, "the stream was closed without being marked reset")
  assert(s.errorCode == errorCancel, "stream error code = ${s.errorCode}, want ${errorCancel}")
  assert(len(st.streams) == 0, "st.streams holds ${len(st.streams)} entries, want 0")
  assert(len(st.present) == 0, "st.present holds ${len(st.present)} entries, want 0")

  // And the peer is still told, which is the half that already worked.
  let sent = btNextWritten(st) catch e {
    assert(false, "no frame was queued for the peer: ${e.message()}")
    return
  }
  let rst = decodeRstStream(sent) catch e2 {
    assert(false, "the queued frame is not RST_STREAM: ${e2.message()}")
    return
  }
  assert(rst.streamId == 1, "RST_STREAM on stream ${rst.streamId}, want 1")
  assert(rst.errorCode == errorCancel, "RST_STREAM code = ${rst.errorCode}, want ${errorCancel}")
}

test "a locally reset stream is answered exactly once" {
  // The reply is a send on a capacity-1 channel, so a second one would park the
  // loop thread outright. `h2connFailStreamMsg` sets `s.replied` and the close
  // drops the entry, so neither a later connection failure nor a second reset
  // can produce one — checked rather than argued, since both paths walk state
  // this test can drive.
  let st = btState(true, 1048576)
  let replyCh = chan<h2connMsg>(1)
  btOpenStream(st, 1, replyCh)

  h2connHandleCmd(st, srResetCmd(1, errorCancel))
  let msg = <- replyCh
  assert(msg.errMsg == srLocalWant(errorCancel), "roundTrip was told '${msg.errMsg}'")

  h2connHandleCmd(st, srResetCmd(1, errorCancel))
  h2connFailAll(st, "http2: connection closed")
  assert(
    gaReplyChEmpty(replyCh),
    "an already-answered round trip was answered a second time",
  )
}

test "resetting a stream that is already gone tells the peer and nothing else" {
  // `resetStream` takes an id the caller tracked itself, so it can name a
  // stream that has already finished — or one that never existed. RFC 9113 §6.4
  // allows RST_STREAM on a closed stream, and there is nothing on this side
  // left to fail.
  let st = btState(true, 1048576)
  h2connHandleCmd(st, srResetCmd(7, errorCancel))
  let sent = btNextWritten(st) catch e {
    assert(false, "no frame was queued for the peer: ${e.message()}")
    return
  }
  let rst = decodeRstStream(sent) catch e2 {
    assert(false, "the queued frame is not RST_STREAM: ${e2.message()}")
    return
  }
  assert(rst.streamId == 7, "RST_STREAM on stream ${rst.streamId}, want 7")
  assert(st.running, "resetting an unknown stream stopped the connection")
  assert(srDrainWrites(st) == 0, "resetting an unknown stream queued more than the RST_STREAM")
}

test "a server resetting a stream sends RST_STREAM and replies to nobody" {
  // The server half: `h2connFailStreamMsg`'s reply is behind `st.isClient`, so
  // a served stream is closed and released with its dummy reply channel left
  // untouched. A stray send there would be silent (the channel is buffered), so
  // it is asserted rather than assumed.
  let st = btState(false, 1048576)
  let replyCh = h2connDummyReply()
  let s = btOpenStream(st, 1, replyCh)

  h2connHandleCmd(st, srResetCmd(1, errorInternalError))

  assert(s.state == h2stClosed, "the stream is in state ${s.state}, want ${h2stClosed} (closed)")
  assert(len(st.streams) == 0, "st.streams holds ${len(st.streams)} entries, want 0")
  assert(gaReplyChEmpty(replyCh), "a server stream's reply channel was written to")
  let sent = btNextWritten(st) catch e {
    assert(false, "no frame was queued for the peer: ${e.message()}")
    return
  }
  let rst = decodeRstStream(sent) catch e2 {
    assert(false, "the queued frame is not RST_STREAM: ${e2.message()}")
    return
  }
  assert(
    rst.errorCode == errorInternalError,
    "RST_STREAM code = ${rst.errorCode}, want ${errorInternalError}",
  )
}

test "Conn.resetStream releases a round trip parked on that stream" {
  // End to end at `deadlineNs == 0`, over a real client `Conn` whose peer never
  // answers — the hang the ticket reports, and the only way `resetStream` is
  // reachable today: the caller knows the id because it opened the connection's
  // first stream and this engine allocates `h2connFirstId(true)` = 1 for it.
  // That is exactly the usage docs/stdlib/http2.md now documents, so this test
  // is the check that the documented usage works.
  //
  // `gaConnectOn`/`gaResult`/`gaRoundTrip` are goaway.test.bit's, same flat
  // `std/http2` module; a peer driven by hand is required either way, since a
  // second `Conn` would answer the request and there would be nothing parked.
  let (w, conn) = gaConnectOn() catch e {
    assert(false, "connect failed: ${e.message()}")
    return
  }
  let done = chan<gaResult>(1)
  spawn gaRoundTrip(conn, done)

  // Wait for the request's HEADERS, so the stream provably exists before the
  // reset — a reset that raced ahead of it would take the "already gone" path
  // above and prove nothing about a parked caller.
  let opened = false
  let i = 0
  while (i < 8 && !opened) {
    let f = hbNextFrame(w) catch e2 {
      assert(false, "the client stopped writing before its HEADERS: ${e2.message()}")
      return
    }
    if (f.header.ftype == frameHeaders) {
      opened = true
    }
    i = i + 1
  }
  assert(opened, "the client never sent its request")

  conn.resetStream(1, errorCancel)

  let res = <- done
  assert(!res.ok, "a round trip on a locally reset stream returned a response")
  assert(res.msg == srLocalWant(errorCancel), "roundTrip failed with '${res.msg}'")

  // The peer is told on the wire too, not just this side torn down.
  let sent = hbNextFrame(w) catch e3 {
    assert(false, "no frame reached the peer after the reset: ${e3.message()}")
    return
  }
  let rst = decodeRstStream(sent) catch e4 {
    assert(false, "the frame the peer got is not RST_STREAM: ${e4.message()}")
    return
  }
  assert(rst.streamId == 1, "RST_STREAM on stream ${rst.streamId}, want 1")
  assert(rst.errorCode == errorCancel, "RST_STREAM code = ${rst.errorCode}, want ${errorCancel}")
}
