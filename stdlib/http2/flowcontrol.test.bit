// stdlib/http2/flowcontrol.test.bit — the receive half of flow control (#4599).
//
// `st.connRecvWindow` and `s.recvWindow` used to be written once (`h2connStart`,
// conn.bit; `h2connNewStream`, loop.bit) and never moved again, so
// `h2connOnData`'s FLOW_CONTROL_ERROR check reduced to `len(df.data) > 65535` —
// a per-frame cap `h2connNextFrame` already enforces at `maxFrameSize`. The
// windows are now spent where a DATA frame is counted and renewed on the line
// that queues the WINDOW_UPDATE granting the credit back, so the check is an
// account rather than a constant.
//
// Every test drives `h2connOnData` (or `h2connHandleFrame` through it) against a
// hand-built `h2connState` with no threads and no transport: the window is loop
// state and reading it directly is the only way to see that a frame SPENT
// credit, as opposed to inferring it from a body that came back short. Same flat
// `std/http2` module, so `btState`/`btOpenStream`/`btDataFrame`/`btPattern`
// (events.test.bit) are in scope and nothing is imported.
//
// There is deliberately no loopback test here: the renewal is already exercised
// end to end by `streams.test.bit`'s 200000-byte POST (over three times the
// 65535-byte initial connection window, so it can only complete through repeated
// WINDOW_UPDATEs) and by `events.test.bit`'s 20000-byte one. A fix that spent
// the window and failed to renew it would hang both.
//
// Since #4621 the connection window is renewed for EVERY DATA frame the engine
// counts, including the two whose bytes it drops (a body over `maxBodyBytes`, a
// frame for a stream that is closed or gone), so it is back at its full value
// before the next frame is read. That is what makes the last two tests below
// possible and what makes a running total across frames impossible: this engine
// buffers whole bodies and therefore grants the credit back on arrival, so the
// connection-level check is a per-frame ceiling — the two boundary tests above
// are its whole reachable surface. A running total needs the WINDOW_UPDATE
// deferred until the body is handed to the application, which is real
// backpressure and a different engine (#4624).
//
// The queue walks below (`fcGoawayCode`, `fcConnCredit`) TAKE the frames off
// `writeCh`. At most one may be called per test, and any assertion after it
// reads an empty queue and passes vacuously.

// --- a state whose windows are small enough to reason about --------------------

// `btState`'s loop state with the receive windows narrowed: `connWindow` is the
// connection's, `streamWindow` every stream's (`btOpenStream` takes a new
// stream's receive window from `ourInitialWindow`, exactly as `h2connNewStream`
// does from `Config.initialWindowSize`). Nothing else is changed, so the tests
// below differ from the module's other fixtures only in the numbers.
fn fcState(connWindow: int, streamWindow: int, maxBody: int): h2connState {
  let st = btState(false, maxBody)
  st.connRecvWindow = connWindow
  st.ourInitialWindow = streamWindow
  return st
}

// The GOAWAY error code carried by one queued writer message, or -1 when that
// message is not a GOAWAY — a `stop` carries no frame at all, and `decodeGoaway`
// refuses any other frame type through `h2frameExpect`.
fn fcGoawayIn(out: h2connOut): int {
  if (out.stop) {
    return 0 - 1
  }
  let f = readFrame(out.data, maxMaxFrameSize) catch _ {
    return 0 - 1
  }
  let g = decodeGoaway(f) catch _ {
    return 0 - 1
  }
  return g.errorCode
}

// The code of the GOAWAY among everything the loop queued for the writer, or -1
// when it queued none. The receive is non-blocking (a `default` arm), so this is
// an assertion about the queue and never a wait that would hang a test on a
// failure, and the walk is bounded by `writeCh`'s own capacity rather than by
// the number of frames a test happens to expect.
fn fcGoawayCode(st: h2connState): int {
  let code = 0 - 1
  let i = 0
  while (i < 64) {
    i = i + 1
    select {
      case out = <- st.writeCh:
        let c = fcGoawayIn(out)
        if (c >= 0) {
          code = c
        }
      default:
        return code
    }
  }
  return code
}

// Feed one DATA frame of `n` pattern bytes to `st` on `streamId`, through the
// real codec so the handler sees exactly what the wire would hand it.
fn fcSendData(st: h2connState, streamId: int, n: int, endStream: bool): ()! {
  h2connOnData(st, btDataFrame(streamId, btPattern(n), endStream)?)
}

// --- a single frame against the advertised window -----------------------------

test "a DATA frame past the connection receive window is a connection error" {
  let st = fcState(100, 1048576, 1048576)
  let s = btOpenStream(st, 1, h2connDummyReply())
  fcSendData(st, 1, 101, false) catch e {
    assert(false, "building the DATA frame failed: ${e.message()}")
    return
  }
  assert(len(s.recvBody) == 0, "recvBody = ${len(s.recvBody)} bytes, want 0")
  assert(
    fcGoawayCode(st) == errorFlowControlError,
    "no GOAWAY carrying ${errorFlowControlError} (FLOW_CONTROL_ERROR) was queued",
  )
  // RFC 9113 §5.4.1: a connection error terminates the connection (#4606).
  assert(!st.running, "the connection is still running after a flow-control error")
}

test "a DATA frame exactly at the connection receive window is accepted and renewed" {
  // The off-by-one guard, and the pairing: the frame spends the whole window
  // and the WINDOW_UPDATE queued for the peer puts every byte of it back, so
  // the account is where it started and the next frame is not refused.
  let st = fcState(100, 1048576, 1048576)
  let s = btOpenStream(st, 1, h2connDummyReply())
  fcSendData(st, 1, 100, false) catch e {
    assert(false, "building the DATA frame failed: ${e.message()}")
    return
  }
  assert(st.running, "a frame exactly at the window terminated the connection")
  assert(len(s.recvBody) == 100, "recvBody = ${len(s.recvBody)} bytes, want 100")
  let f = btNextWritten(st) catch e2 {
    assert(false, "no WINDOW_UPDATE was queued for the peer: ${e2.message()}")
    return
  }
  let wu = decodeWindowUpdate(f) catch e3 {
    assert(false, "the queued frame is not a WINDOW_UPDATE: ${e3.message()}")
    return
  }
  assert(wu.streamId == 0, "the first WINDOW_UPDATE is on stream ${wu.streamId}, want 0")
  assert(wu.increment == 100, "the connection was granted ${wu.increment} bytes, want 100")
  assert(
    st.connRecvWindow == 100,
    "connRecvWindow = ${st.connRecvWindow} after the renewal, want 100",
  )
  assert(s.recvWindow == 1048576, "recvWindow = ${s.recvWindow} after the renewal, want 1048576")
}

test "the DATA that ends a stream spends its window and is not renewed" {
  // END_STREAM is half-close: the peer will send no more DATA on this stream, so
  // `h2connReplenishWindows` queues no stream WINDOW_UPDATE — and therefore adds
  // no stream credit back either. The connection window is renewed as always.
  // This is the one place the spending is visible on a single accepted frame.
  let st = fcState(1048576, 1000, 1048576)
  let s = btOpenStream(st, 1, h2connDummyReply())
  fcSendData(st, 1, 100, true) catch e {
    assert(false, "building the DATA frame failed: ${e.message()}")
    return
  }
  assert(len(s.recvBody) == 100, "recvBody = ${len(s.recvBody)} bytes, want 100")
  assert(
    s.recvWindow == 900,
    "recvWindow = ${s.recvWindow}, want 900 — the stream window was never spent",
  )
  assert(
    st.connRecvWindow == 1048576,
    "connRecvWindow = ${st.connRecvWindow}, want 1048576 — the connection window was not renewed",
  )
  let a = <- st.acceptCh
  assert(!a.stop, "the request was not delivered")
}

// --- credit for the bytes the engine drops -------------------------------------

// The connection-level WINDOW_UPDATE credit in one queued writer message:
// increments granted on stream 0, and nothing for anything else — a RST_STREAM,
// a stream-level WINDOW_UPDATE and a `stop` all carry no connection credit.
fn fcConnCreditIn(out: h2connOut): int {
  if (out.stop) {
    return 0
  }
  let f = readFrame(out.data, maxMaxFrameSize) catch _ {
    return 0
  }
  let wu = decodeWindowUpdate(f) catch _ {
    return 0
  }
  if (wu.streamId != 0) {
    return 0
  }
  return wu.increment
}

// The total connection credit the loop granted the peer, across everything it
// queued for the writer. Like `fcGoawayCode` the receive is non-blocking, so it
// is an assertion about the queue and never a wait that would hang a failing
// test, and the walk is bounded by `writeCh`'s own capacity.
//
// The peer's book is the one that binds: it is our WINDOW_UPDATE, not our own
// `connRecvWindow`, that lets a peer send again after we discard a frame, so a
// fix that only kept our number right would pass on `connRecvWindow` alone and
// still stall the connection.
fn fcConnCredit(st: h2connState): int {
  let total = 0
  let i = 0
  while (i < 64) {
    i = i + 1
    select {
      case out = <- st.writeCh:
        total = total + fcConnCreditIn(out)
      default:
        return total
    }
  }
  return total
}

// Send `count` DATA frames of `n` bytes each, every one over the body budget, so
// every one is refused by `h2connBodyBudgetOk` (#4590) and its bytes dropped.
// Each goes to a stream of its own because the refusal resets the stream it
// lands on and the reset releases it from the table (#4594).
fn fcRefuseBodies(st: h2connState, count: int, n: int): ()! {
  let i = 0
  while (i < count) {
    let id = 1 + 2 * i
    let s = btOpenStream(st, id, h2connDummyReply())
    fcSendData(st, id, n, false)?
    assert(s.reset, "stream ${id} was not refused by the body budget")
    assert(
      s.errorCode == errorEnhanceYourCalm,
      "stream ${id} failed with ${s.errorCode}, want ${errorEnhanceYourCalm}",
    )
    i = i + 1
  }
}

test "four refused bodies leave the whole connection receive window (#4621)" {
  // The stall, at the numbers that produce it: the RFC's fixed 65535-byte
  // connection window and the default 16384-byte frame size, where four refused
  // frames are 65536 bytes — one more than the window holds. Until the credit
  // for a discarded frame was handed back, the fourth upload took the window to
  // zero for good and every stream on the connection stalled: not because of
  // our own number, but because the peer's send window stays down until a
  // WINDOW_UPDATE we never sent.
  assert(
    4 * defaultMaxFrameSize > 65535,
    "four frames of ${defaultMaxFrameSize} no longer exceed the 65535-byte connection window",
  )
  let st = fcState(65535, 1048576, 100)
  fcRefuseBodies(st, 4, defaultMaxFrameSize) catch e {
    assert(false, "refusing four over-budget bodies failed: ${e.message()}")
    return
  }
  assert(st.running, "four refused bodies terminated the connection")
  assert(
    st.connRecvWindow == 65535,
    "connRecvWindow = ${st.connRecvWindow} after four refusals, want 65535",
  )
  // Our own number is only half of it: the peer is still holding a send window
  // short by 65536 bytes unless we granted every one of them back.
  let credit = fcConnCredit(st)
  assert(
    credit == 4 * defaultMaxFrameSize,
    "the peer was granted ${credit} bytes of connection credit, want ${4 * defaultMaxFrameSize}",
  )
  // And the connection still carries traffic: a body of exactly the budget on a
  // fresh stream, which is refused by nothing.
  let s = btOpenStream(st, 9, h2connDummyReply())
  fcSendData(st, 9, 100, false) catch e2 {
    assert(false, "building the DATA frame failed: ${e2.message()}")
    return
  }
  assert(st.running, "a legal DATA frame after four refusals terminated the connection")
  assert(!s.reset, "a legal DATA frame after four refusals was reset")
  assert(len(s.recvBody) == 100, "recvBody = ${len(s.recvBody)} bytes, want 100")
  assert(fcGoawayCode(st) == 0 - 1, "a GOAWAY was queued for a frame within the window")
  assert(
    st.connRecvWindow == 65535,
    "connRecvWindow = ${st.connRecvWindow} after the accepted frame, want 65535",
  )
}

test "DATA for a stream that is gone is counted and its credit handed back" {
  // The other discard path. No stream is opened: after #4594 a released stream
  // and a never-created one are the same thing to `h2connDataStreamOk`, which
  // reports STREAM_CLOSED for both — so this is exactly the state a stream we
  // reset a moment ago leaves behind, and DATA still in flight for it lands
  // here. RFC 9113 §5.1 counts those bytes against the connection window even
  // though they are dropped, so the frame is spent and renewed in one act:
  // `connRecvWindow` ends where it started and the peer is granted the credit.
  //
  // The stream window is deliberately not renewed on this path and cannot be —
  // there is no stream to renew, and a WINDOW_UPDATE on a dead id grants credit
  // nobody can spend.
  let st = fcState(65535, 1048576, 1048576)
  assert(st.present[1] == 0, "stream 1 exists before the test has opened one")
  fcSendData(st, 1, 100, false) catch e {
    assert(false, "building the DATA frame failed: ${e.message()}")
    return
  }
  assert(st.running, "a DATA frame for a stream that is gone terminated the connection")
  assert(st.present[1] == 0, "the discarded frame created stream 1")
  assert(
    st.connRecvWindow == 65535,
    "connRecvWindow = ${st.connRecvWindow} after the discard, want 65535 — unchanged",
  )
  let credit = fcConnCredit(st)
  assert(credit == 100, "the peer was granted ${credit} bytes of connection credit, want 100")
}

// --- the padding a DATA frame carries (#4622) ----------------------------------

// Feed one padded DATA frame of `n` pattern bytes and `padLength` padding octets
// to `st` on `streamId`, through the real codec. The payload the peer debits its
// send window by is `1 + n + padLength`: the Pad Length octet, the body, and the
// padding (RFC 9113 §6.1).
fn fcSendPadded(st: h2connState, streamId: int, n: int, padLength: int, endStream: bool): ()! {
  let wire = encodeData(
    DataFrame{
      streamId: streamId,
      data: btPattern(n),
      endStream: endStream,
      padLength: padLength,
    },
  )?
  let f = readFrame(wire, maxMaxFrameSize)?
  assert(
    f.header.length == 1 + n + padLength,
    "the padded frame's payload is ${f.header.length} bytes, want ${1 + n + padLength}",
  )
  h2connOnData(st, f)
}

test "a padded DATA frame is counted, and renewed, at its whole payload length" {
  // 100 body bytes in a 121-byte payload. Both windows are spent and granted
  // back at 121, not at 100: the peer's own send window went down by 121, so a
  // 100-byte grant leaves it 21 bytes short for ever and a peer that pads every
  // frame stalls. Only `recvBody` sees the stripped 100 — padding is discarded
  // and never resident, which is why the body budget still counts it at 100.
  let st = fcState(1000, 1000, 1048576)
  let s = btOpenStream(st, 1, h2connDummyReply())
  fcSendPadded(st, 1, 100, 20, false) catch e {
    assert(false, "building the padded DATA frame failed: ${e.message()}")
    return
  }
  assert(st.running, "a padded frame within the window terminated the connection")
  assert(len(s.recvBody) == 100, "recvBody = ${len(s.recvBody)} bytes, want 100")
  let f = btNextWritten(st) catch e2 {
    assert(false, "no WINDOW_UPDATE was queued for the peer: ${e2.message()}")
    return
  }
  let wu = decodeWindowUpdate(f) catch e3 {
    assert(false, "the queued frame is not a WINDOW_UPDATE: ${e3.message()}")
    return
  }
  assert(wu.streamId == 0, "the first WINDOW_UPDATE is on stream ${wu.streamId}, want 0")
  assert(
    wu.increment == 121,
    "the connection was granted ${wu.increment} bytes, want 121 (the whole payload)",
  )
  assert(
    st.connRecvWindow == 1000,
    "connRecvWindow = ${st.connRecvWindow} after the renewal, want 1000",
  )
  assert(s.recvWindow == 1000, "recvWindow = ${s.recvWindow} after the renewal, want 1000")
}

test "a padded DATA frame whose padding crosses the connection window is refused" {
  // The window has 120 bytes left and the body is 100, so counting the body
  // alone accepts the frame — but the peer spent 121 bytes of credit it did not
  // hold, which is the overrun §6.9.1 makes a connection error.
  let st = fcState(120, 1048576, 1048576)
  let s = btOpenStream(st, 1, h2connDummyReply())
  fcSendPadded(st, 1, 100, 20, false) catch e {
    assert(false, "building the padded DATA frame failed: ${e.message()}")
    return
  }
  assert(len(s.recvBody) == 0, "recvBody = ${len(s.recvBody)} bytes, want 0")
  assert(
    fcGoawayCode(st) == errorFlowControlError,
    "no GOAWAY carrying ${errorFlowControlError} (FLOW_CONTROL_ERROR) was queued",
  )
  assert(!st.running, "the connection is still running after a flow-control error")
}
