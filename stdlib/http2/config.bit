// Bit standard library — http2 module, the connection configuration: the local
// half of the SETTINGS a `Conn` advertises, and the defaults behind
// `defaultConfig()`. Split out of `conn.bit` when adding
// `maxConcurrentStreams` (#4595) took that file over the 800-line ceiling; same
// flat `std/http2` module and namespace, so nothing here is imported anywhere.

// --- configuration -----------------------------------------------------------

// The local half of the SETTINGS a `Conn` advertises, plus the one local limit
// that is not a SETTINGS parameter: `initialWindowSize` is the per-stream
// flow-control window we grant the peer (SETTINGS_INITIAL_WINDOW_SIZE),
// `maxFrameSize` the largest frame payload we accept (SETTINGS_MAX_FRAME_SIZE),
// `headerTableSize` our HPACK dynamic-table bound (SETTINGS_HEADER_TABLE_SIZE),
// `maxHeaderListBytes` the largest header block we will accumulate across a
// HEADERS and its CONTINUATIONs (SETTINGS_MAX_HEADER_LIST_SIZE, #4593),
// `maxConcurrentStreams` the most streams the peer may have open at once
// (SETTINGS_MAX_CONCURRENT_STREAMS, #4595), and `maxBodyBytes` the most DATA one
// stream may accumulate before we reset it (#4590).
//
// `streamBodies` is not a SETTINGS parameter either: it says a `serve` handler
// takes its own request body through `Stream.read` (stream.bit) instead of being
// handed it whole (#4624).
//
// `maxBodyBytes` has no wire representation on purpose: flow control bounds
// bytes IN FLIGHT, while this bounds the bytes one stream may accumulate here —
// two different questions, and since #4624 the windows do bound resident bytes
// as well, since the credit for a body is held until its consumer takes it.
export class Config {
  export initialWindowSize: int,
  export maxFrameSize: int,
  export headerTableSize: int,
  export maxHeaderListBytes: int,
  export maxConcurrentStreams: int,
  export maxBodyBytes: int,
  export streamBodies: bool,
}

// The most streams a peer may have open at once under `defaultConfig()`.
//
// 250, which is Go's `http2` server default; RFC 9113 §6.5.2 asks implementations
// not to go below 100. Unlike the two budgets below, this one has a wire form, so
// a conforming peer stops on its own side and the enforcement in
// `h2connServerHeaders` (events.bit) only ever fires on a peer that ignored what
// we advertised.
//
// It is the limit that bounds the CONNECTION rather than one stream: every open
// stream costs an `h2connStream`, up to `maxBodyBytes` of buffered body, and on a
// server a green thread per delivered request — so without it the other two
// budgets bound one stream each and nothing bounds their sum (#4595).
//
// As with those two, zero means "refuse every stream", not "unlimited": there is
// no unlimited value.
const h2connDefaultMaxConcurrentStreams: int = 250

// The most DATA one stream may accumulate under `defaultConfig()`.
//
// The twin of `std/http`'s `defaultMaxBodyBytes` (stdlib/http/message.bit,
// #4565) and the same 32 MiB, spelled out again here rather than imported:
// `std/http` imports `std/http2` (stdlib/http/http.bit), so the dependency runs
// the other way and importing it back would be a cycle. Keep the two numbers
// equal — `std/http`'s `setMaxBodyBytes` setters feed this field so one setting
// bounds both protocols (stdlib/http/h2.bit).
//
// As there, zero means "refuse every body", not "unlimited": there is no
// unlimited value, which is the point.
const h2connDefaultMaxBodyBytes: int = 32 * 1024 * 1024

// The largest header block `defaultConfig()` will accumulate, counted in the
// bytes we actually hold: the HPACK-ENCODED octets of a HEADERS frame and every
// CONTINUATION continuing it (`st.contBuf`, events.bit).
//
// 128 KiB rather than `std/http`'s 65536 (`maxHeaderBytes`, message.bit),
// because the two count different things. That number bounds a DECODED
// HTTP/1.1 block, and SETTINGS_MAX_HEADER_LIST_SIZE — how this one reaches the
// peer, `h2connOurSettings` below — is likewise defined on the UNCOMPRESSED
// field list (name + value + 32 per field, RFC 9113 §6.5.2). Huffman coding
// does not only shrink: an octet above 0x7f costs 20 to 30 bits, so an encoded
// block can exceed the list it decodes to. Doubling the precedent keeps the
// advertisement honest — a peer honouring 131072 by the RFC's own accounting is
// not reset by our encoded-byte check.
//
// The headroom is measured, not assumed: `_tests_/imports/http2conn`'s
// `testContinuation` sends one 60000-byte header value, which this module's
// encoder Huffman-codes to 56920 octets — 56947 for the whole block with its
// pseudo-headers and length prefixes, 43% of this budget.
//
// As with `maxBodyBytes`, zero means "refuse every header block", not
// "unlimited": there is no unlimited value.
const h2connDefaultMaxHeaderListBytes: int = 128 * 1024

// The RFC-default configuration: a 65535-byte initial window, a 16384-byte max
// frame size, a 4096-byte header table, a 128 KiB header-block budget, 250
// concurrent streams, a 32 MiB per-stream body budget, and request bodies
// delivered whole rather than read incrementally.
export fn defaultConfig(): Config {
  return Config{
    initialWindowSize: 65535,
    maxFrameSize: defaultMaxFrameSize,
    headerTableSize: 4096,
    maxHeaderListBytes: h2connDefaultMaxHeaderListBytes,
    maxConcurrentStreams: h2connDefaultMaxConcurrentStreams,
    maxBodyBytes: h2connDefaultMaxBodyBytes,
    streamBodies: false,
  }
}
