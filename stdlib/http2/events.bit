// Bit standard library — http2 module, the loop's dispatch: inbound frame and
// event handling, and the commands the public API sends the loop.
// Split out of `conn.bit`; same flat `std/http2` module and namespace.

// --- inbound event handling --------------------------------------------------

fn h2connHandleEvent(st: h2connState, ev: h2connEvent) {
  if (ev.eof) {
    h2connTerminate(st, "http2: connection closed")
    return
  }
  h2connHandleFrame(st, ev.frame)
}

// Terminate the connection: stop the loop and release everything parked on it.
//
// Called on both paths that end a connection — the transport dying (the `eof`
// arm above) and this side raising a connection error (`h2connConnError`,
// streams.bit, RFC 9113 §5.4.1, #4606). Every release below has to happen on
// BOTH: once `running` is false the loop returns, so no later event is ever
// processed and nothing else will run them.
//
// Idempotent by the `running` check, which is the whole guard: today the loop's
// own exit is what makes a second call unreachable, and a second call would
// queue a second `stop` for a writer that has already exited.
//
// Order is load-bearing at one point only: the writer's `stop` goes LAST, after
// every frame the loop has queued — a connection error's GOAWAY included —
// because `h2connWriter` (loop.bit) drains `writeCh` in order and exits on it.
//
// Releasing the transport is NOT done here and never from this thread; that
// stays the caller's job (`h2connWriter`'s doc comment, #3026).
fn h2connTerminate(st: h2connState, msg: string) {
  if (!st.running) {
    return
  }
  st.running = false
  // Wake a still-parked `h2connAwaitReady` with failure instead of leaving
  // it parked on `readyCh` forever (#3019) — the connection dying before
  // the peer's opening SETTINGS is a real, actionable answer, not silence.
  // Guarded by `readySignaled` exactly like the success send in `conn.bit`, so
  // this is a no-op once the peer's SETTINGS has already released it.
  if (!st.readySignaled) {
    st.readySignaled = true
    st.readyCh <- 0
  }
  h2connFailAll(st, msg)
  // A server's `serve()` (conn.bit) parks on `acceptCh` for the life of the
  // connection with no other release; only this teardown ever ends it, so it
  // must be signalled here (#3020). Guarded to the server: a client never calls
  // `serve()`, so nothing would ever receive an unguarded send — `acceptCh` is
  // buffered (cap 256, `h2connStart`) so that unclaimed send would not even
  // block, but it would be a message to nobody.
  if (!st.isClient) {
    st.acceptCh <- h2connAccept{ stop: true, streamId: 0, request: h2connZeroRequest() }
  }
  // The writer thread (`loop.bit`) parks on `writeCh` once it has drained
  // whatever the loop last queued — an empty-channel receive, not a
  // transport operation, so nothing about the transport dying wakes it on
  // its own (#3026). Sending it here, from the loop thread itself, is what
  // makes this race-free: every OTHER send to `writeCh` also comes from
  // this thread (`h2connEnqueue`), so this `stop` is strictly ordered after
  // every frame this connection will ever queue — the writer cannot dequeue
  // `stop` ahead of a real write the loop decided to send first. Sent
  // unconditionally (unlike `acceptCh` above): both client and server
  // connections have a writer to release.
  st.writeCh <- h2connOut{ stop: true, data: []byte(0) }
}

// Dispatch one frame. A header block in progress (`contStream != 0`) may only be
// continued by a CONTINUATION on the same stream — any other frame is a
// connection error (RFC 9113 §6.2).
fn h2connHandleFrame(st: h2connState, f: Frame) {
  let ft = f.header.ftype
  if (st.contStream != 0 && ft != frameContinuation) {
    h2connConnError(st, errorProtocolError, "http2: expected CONTINUATION")
    return
  }
  switch (ft) {
    case frameSettings:
      h2connOnSettings(st, f)
    case frameHeaders:
      h2connOnHeaders(st, f)
    case frameContinuation:
      h2connOnContinuation(st, f)
    case frameData:
      h2connOnData(st, f)
    case frameWindowUpdate:
      h2connOnWindowUpdate(st, f)
    case frameRstStream:
      h2connOnRstStream(st, f)
    case frameGoaway:
      h2connOnGoaway(st, f)
    case framePing:
      h2connOnPing(st, f)
    case framePushPromise:
      h2connConnError(st, errorProtocolError, "http2: unexpected PUSH_PROMISE")
    default:
    // PRIORITY and unknown frame types are accepted and ignored (RFC 9113
    // §4.1).
  }
}

fn h2connOnSettings(st: h2connState, f: Frame) {
  let sf = decodeSettings(f) catch _ {
    h2connConnError(st, errorProtocolError, "http2: bad SETTINGS")
    return
  }
  if (sf.ack) {
    return
  }
  for s of sf.settings {
    h2connApplySetting(st, s.id, s.value)
  }
  h2connSendSettingsAck(st)
  // Release `h2connAwaitReady` once the peer's opening SETTINGS is in effect.
  if (!st.readySignaled) {
    st.readySignaled = true
    st.readyCh <- 1
  }
}

// Apply one peer SETTINGS parameter. A changed initial window size retroactively
// shifts every open stream's send window by the delta (RFC 9113 §6.9.2), after
// which any stream that was blocked may be able to make progress.
fn h2connApplySetting(st: h2connState, id: int, value: int) {
  if (id == settingsInitialWindowSize) {
    let delta = value - st.peerInitialWindow
    st.peerInitialWindow = value
    for (_, s) of st.streams {
      s.sendWindow = s.sendWindow + delta
    }
    h2connFlushAll(st)
    return
  }
  if (id == settingsMaxFrameSize) {
    st.peerMaxFrameSize = value
    return
  }
  if (id == settingsHeaderTableSize) {
    st.enc.changeTableSize(value)
    return
  }
  if (id == settingsMaxConcurrentStreams) {
    st.peerMaxConcurrentStreams = value
    return
  }
  if (id == settingsMaxHeaderListSize) {
    st.peerMaxHeaderListBytes = value
    return
  }
  // ENABLE_PUSH: accepted, no-op, because this engine never pushes — a peer
  // forbidding or permitting push changes nothing we do. It is the only
  // parameter left in that class. MAX_CONCURRENT_STREAMS left it in #4595 and
  // MAX_HEADER_LIST_SIZE in #4607, both for the same reason: a limit on what WE
  // may do is not a limit on what we tolerate, and shelving one only moves the
  // refusal onto the wire, where it arrives as a GOAWAY or an RST_STREAM the
  // caller cannot connect to its own headers.
}

fn h2connOnHeaders(st: h2connState, f: Frame) {
  let hf = decodeHeaders(f) catch _ {
    h2connConnError(st, errorProtocolError, "http2: bad HEADERS")
    return
  }
  if (!h2connHeaderBudgetOk(st, 0, len(hf.blockFragment))) {
    return
  }
  st.contStream = hf.streamId
  st.contBuf = hf.blockFragment
  st.contEndStream = hf.endStream
  st.contNewStream = false
  if (!st.isClient && st.present[hf.streamId] == 0) {
    st.contNewStream = true
  }
  if (hf.endHeaders) {
    h2connFinishHeaders(st)
  }
}

// A header block spans a HEADERS and every CONTINUATION continuing it, and each
// of those frames is bounded only by `maxFrameSize` — a per-FRAME cap, which is
// not a per-BLOCK one. Without this the peer may send CONTINUATION forever and
// grow `st.contBuf` without limit (#4593); it is the same distinction #4590 had
// to make between a DATA frame and a body.
//
// Written as a subtraction, never `have + n > st.maxHeaderListBytes`: `have` is
// never above the budget (this check is what keeps it there), so the left side
// cannot overflow, while the addition can for a length near the top of the i64
// range and would then compare as negative.
//
// Over budget is a CONNECTION error, not a stream one, and ENHANCE_YOUR_CALM
// (0xb, RFC 9113 §7) rather than PROTOCOL_ERROR. Connection, because the HPACK
// decoder's dynamic table is shared by every stream and is only advanced by
// DECODING a block: skipping one desyncs the table for every later block on the
// connection, and decoding it is the very work we are refusing. ENHANCE_YOUR_CALM
// because the peer's framing is legal — each frame is within `maxFrameSize` and
// the CONTINUATION sequence is well formed — so PROTOCOL_ERROR would be a false
// statement about what it did; what it is actually doing is generating more load
// than we will process. Same choice, and the same reasoning, as the body budget.
fn h2connHeaderBudgetOk(st: h2connState, have: int, n: int): bool {
  if (n > st.maxHeaderListBytes - have) {
    h2connConnError(
      st,
      errorEnhanceYourCalm,
      "http2: header block exceeds ${st.maxHeaderListBytes} bytes",
    )
    return false
  }
  return true
}

fn h2connOnContinuation(st: h2connState, f: Frame) {
  if (st.contStream == 0 || f.header.streamId != st.contStream) {
    h2connConnError(st, errorProtocolError, "http2: unexpected CONTINUATION")
    return
  }
  let cf = decodeContinuation(f) catch _ {
    h2connConnError(st, errorProtocolError, "http2: bad CONTINUATION")
    return
  }
  if (!h2connHeaderBudgetOk(st, len(st.contBuf), len(cf.blockFragment))) {
    return
  }
  st.contBuf = h2connAppendBytes(st.contBuf, cf.blockFragment)
  if (cf.endHeaders) {
    h2connFinishHeaders(st)
  }
}

// A header block is complete: HPACK-decode it against the shared decoder and hand
// the fields to the client or server path.
fn h2connFinishHeaders(st: h2connState) {
  let streamId = st.contStream
  let block = st.contBuf
  let endStream = st.contEndStream
  let isNew = st.contNewStream
  st.contStream = 0
  st.contBuf = []byte(0)
  st.contEndStream = false
  st.contNewStream = false
  let fields = st.dec.decode(block) catch _ {
    h2connConnError(st, errorCompressionError, "http2: HPACK decode failed")
    return
  }
  if (st.isClient) {
    h2connClientHeaders(st, streamId, fields, endStream)
    return
  }
  h2connServerHeaders(st, streamId, fields, endStream, isNew)
}

fn h2connServerHeaders(
  st: h2connState,
  streamId: int,
  fields: []HeaderField,
  endStream: bool,
  isNew: bool,
) {
  if (isNew) {
    h2connOpenPeerStream(st, streamId, fields, endStream)
    return
  }
  if (st.present[streamId] == 0) {
    return
  }
  let s = st.streams[streamId]
  s.recvHeaders = h2connMergeHeaders(s.recvHeaders, fields)
  if (endStream) {
    s.recvEnded = true
    h2connRecvEndTransition(st, s)
    h2connDeliverRequest(st, s)
  }
}

// A peer-initiated stream's opening HEADERS: check the id, check we have room
// for another stream, and open it.
//
// The room check is `st.maxConcurrentStreams`, what we advertised as
// SETTINGS_MAX_CONCURRENT_STREAMS (`h2connOurSettings`, conn.bit), against
// `st.activeStreams`, which is the streams in the table — open or half-closed,
// exactly the ones RFC 9113 §5.1.2 says count. Over it is a STREAM error, not a
// connection error: the peer's framing is legal and every other stream on the
// connection is unaffected, so killing the connection would punish requests that
// did nothing wrong. The header block has already been HPACK-decoded by the time
// we get here (`h2connFinishHeaders`), so the shared dynamic table stays in step
// with the peer's whether we open the stream or refuse it — which is what makes
// a stream error sound here and made the header-block budget a connection one.
//
// REFUSED_STREAM (0x7) rather than PROTOCOL_ERROR, the two §5.1.2 offers: §8.7
// makes REFUSED_STREAM the positive statement that the request was NOT
// PROCESSED, so the peer may safely retry it, automatically, on another
// connection — and that is exactly true here, since we refuse before delivering
// anything to a handler. PROTOCOL_ERROR would be a false statement about the
// peer's framing and would suppress that retry. ENHANCE_YOUR_CALM, which this
// module uses for the two byte budgets, is not one of the two §5.1.2 names and
// carries no not-processed guarantee, so it would lose the retry as well.
//
// The id is recorded in `lastPeerStreamId` BEFORE the refusal: a refused stream
// still went idle -> open -> closed, so §5.1.1 forbids the peer reusing it, and
// leaving it unrecorded would let a peer that ignores our limit also recycle ids.
fn h2connOpenPeerStream(st: h2connState, streamId: int, fields: []HeaderField, endStream: bool) {
  if (streamId <= st.lastPeerStreamId || streamId % 2 == 0) {
    h2connConnError(st, errorProtocolError, "http2: illegal new stream id")
    return
  }
  st.lastPeerStreamId = streamId
  if (st.activeStreams >= st.maxConcurrentStreams) {
    // No table entry exists to tear down — this is the one reset path that
    // never had a stream — so the RST_STREAM is sent directly rather than
    // through `h2connStreamError`, whose remaining work is a no-op for an
    // absent id and whose message would describe a peer reset that never was.
    h2connSendRstStream(st, RstStreamFrame{ streamId: streamId, errorCode: errorRefusedStream })
    return
  }
  let s = h2connNewStream(streamId, st.peerInitialWindow, st.ourInitialWindow, h2connDummyReply())
  s.state = h2stOpen
  s.recvHeaders = fields
  s.headersDone = true
  st.streams[streamId] = s
  st.present[streamId] = 1
  st.activeStreams = st.activeStreams + 1
  if (endStream) {
    s.recvEnded = true
    s.state = h2stHCRemote
    h2connDeliverRequest(st, s)
  }
}

fn h2connClientHeaders(st: h2connState, streamId: int, fields: []HeaderField, endStream: bool) {
  if (st.present[streamId] == 0) {
    return
  }
  let s = st.streams[streamId]
  s.recvHeaders = h2connMergeHeaders(s.recvHeaders, fields)
  s.headersDone = true
  if (endStream) {
    s.recvEnded = true
    h2connRecvEndTransition(st, s)
    h2connDeliverResponse(st, s)
  }
}

// Whether `streamId` is present and still open to receive DATA, reporting a
// STREAM_CLOSED stream error itself when not. Split out of `h2connOnData`
// (#2448).
fn h2connDataStreamOk(st: h2connState, streamId: int): bool {
  if (st.present[streamId] == 0) {
    h2connStreamError(st, streamId, errorStreamClosed)
    return false
  }
  let s = st.streams[streamId]
  if (s.state == h2stClosed || s.state == h2stHCRemote || s.recvEnded) {
    h2connStreamError(st, streamId, errorStreamClosed)
    return false
  }
  return true
}

// Whether `n` more body bytes fit stream `s`'s remaining budget, resetting the
// stream with ENHANCE_YOUR_CALM itself when they do not (#4590).
//
// ENHANCE_YOUR_CALM (RFC 9113 §7) and not FLOW_CONTROL_ERROR: the peer has
// honoured every window we advertised — we replenish them on arrival because we
// buffer everything — so blaming flow control would be a lie about what it did.
// It is generating more load than we will process, which is what 0xb says. A
// stream error and not a connection error: one oversized body is that stream's
// fault, and the other streams multiplexed over the same connection are not.
//
// Written as a subtraction, never `len(s.recvBody) + n > st.maxBodyBytes`:
// `len(s.recvBody)` is never above `st.maxBodyBytes` (this check is what keeps
// it there), so the left side cannot overflow, while the addition can for a
// length near the top of the i64 range and would then compare as negative —
// i.e. the obvious spelling is the bypass.
fn h2connBodyBudgetOk(st: h2connState, s: h2connStream, n: int): bool {
  if (n > st.maxBodyBytes - len(s.recvBody)) {
    let msg = "http2: body exceeds ${st.maxBodyBytes} bytes"
    h2connStreamErrorMsg(st, s.id, errorEnhanceYourCalm, msg)
    return false
  }
  return true
}

// Hand `n` bytes of connection credit back to the peer: add it to our own window
// and queue the WINDOW_UPDATE granting it, never one without the other (#4599).
// A credit without the grant would have us refuse bytes the peer is entitled to
// send; a grant without the credit would let it send bytes we never advertised.
// The single place either happens, so every DATA frame `h2connOnData` counts is
// renewed the same way whether its bytes were kept or dropped (#4621).
//
// `n == 0` grants nothing: a WINDOW_UPDATE with a zero increment is a
// PROTOCOL_ERROR (RFC 9113 §6.9), and a zero-length DATA frame spent nothing.
fn h2connRenewConnWindow(st: h2connState, n: int) {
  if (n == 0) {
    return
  }
  st.connRecvWindow = st.connRecvWindow + n
  h2connSendWindowUpdate(st, WindowUpdateFrame{ streamId: 0, increment: n })
}

// We buffer the whole body, so the bytes are "consumed" the instant they land;
// replenish both windows and tell the peer with WINDOW_UPDATE so it may send on.
// Only ever reached for DATA whose bytes this connection kept: the two paths
// that drop them renew the connection window themselves and must not renew the
// stream's (#4621).
//
// The stream window is renewed only when the stream can still receive:
// END_STREAM is half-close, so a stream WINDOW_UPDATE after it would grant
// credit nobody can spend. The connection window is always renewed.
fn h2connReplenishWindows(st: h2connState, df: DataFrame, s: h2connStream, n: int) {
  h2connRenewConnWindow(st, n)
  if (n == 0 || df.endStream) {
    return
  }
  s.recvWindow = s.recvWindow + n
  h2connSendWindowUpdate(st, WindowUpdateFrame{ streamId: df.streamId, increment: n })
}

// The connection error a receive window overrun is (RFC 9113 §6.9.1), spelled
// once so the two places that raise it cannot drift apart.
fn h2connRecvWindowError(st: h2connState) {
  h2connConnError(st, errorFlowControlError, "http2: flow-control window exceeded")
}

fn h2connOnData(st: h2connState, f: Frame) {
  let df = decodeData(f) catch _ {
    h2connConnError(st, errorProtocolError, "http2: bad DATA")
    return
  }
  // What flow control counts is the WHOLE payload, padding included (RFC 9113
  // §6.9), and `decodeData` has already stripped the padding out of `df.data`
  // — so the body length is the wrong number here and was the number used
  // until #4622. The peer debits its send window by the payload length; we
  // debited ours by the body length and granted only that much back, leaking
  // `padLength + 1` bytes of the peer's window per padded frame until it
  // stalled. `f.header.length` is the payload length and is already in hand,
  // which is also why it is not respelled as `len(df.data) + df.padLength + 1`:
  // that would copy the codec's arithmetic into a second place, and
  // `padLength` is -1 on an unpadded frame.
  //
  // Only the accounting: `df.data` is still what reaches `s.recvBody`, and the
  // body budget below is still asked about `len(df.data)`, because padding is
  // discarded and never resident.
  let n = f.header.length
  // The peer has now spent this much of the credit we advertised, so spend it
  // here too (#4599): before this the two windows were set once and compared
  // for ever, which made the check `n > 65535` — a per-frame cap `maxFrameSize`
  // already enforces — rather than the account RFC 9113 §6.9.1 requires. Both
  // windows stay >= 0 because the comparison refuses anything larger first,
  // which is also what keeps `n > window` overflow-free.
  //
  // The connection window is checked and spent BEFORE the stream is looked up
  // (#4621): §5.1 counts a DATA frame that arrives for a stream we have already
  // closed against the connection window too, and §6.9.1 makes an overrun a
  // connection error whatever the stream's state — so a peer overrunning the
  // credit it holds cannot escape the check by aiming at a dead stream.
  if (n > st.connRecvWindow) {
    h2connRecvWindowError(st)
    return
  }
  st.connRecvWindow = st.connRecvWindow - n
  if (!h2connDataStreamOk(st, df.streamId)) {
    // The bytes are dropped, but the peer spent real credit on them and its own
    // window stays down until we say otherwise: renew the connection's, and
    // only the connection's — the stream is closed or gone, so a WINDOW_UPDATE
    // on it would grant credit nobody can spend (#4621).
    h2connRenewConnWindow(st, n)
    return
  }
  let s = st.streams[df.streamId]
  if (n > s.recvWindow) {
    h2connRecvWindowError(st)
    return
  }
  s.recvWindow = s.recvWindow - n
  // The debit above stays BEFORE the body budget: a frame refused below was
  // still sent under the credit we granted and the peer has debited its own
  // window for it, so keeping the debit is what holds the two accounts in step.
  // The connection credit comes straight back — without it, four over-budget
  // bodies at the default 16384-byte frame size consume the whole 65535-byte
  // connection window and every stream on the connection stalls (#4621). The
  // stream window is not renewed: the stream is being reset.
  if (!h2connBodyBudgetOk(st, s, len(df.data))) {
    h2connRenewConnWindow(st, n)
    return
  }
  s.recvBody = h2connAppendBytes(s.recvBody, df.data)
  h2connReplenishWindows(st, df, s, n)
  if (df.endStream) {
    s.recvEnded = true
    h2connRecvEndTransition(st, s)
    if (st.isClient) {
      h2connDeliverResponse(st, s)
      return
    }
    h2connDeliverRequest(st, s)
  }
}

fn h2connOnWindowUpdate(st: h2connState, f: Frame) {
  let wu = decodeWindowUpdate(f) catch _ {
    h2connConnError(st, errorProtocolError, "http2: bad WINDOW_UPDATE")
    return
  }
  if (wu.increment == 0) {
    if (wu.streamId == 0) {
      h2connConnError(st, errorProtocolError, "http2: zero connection window increment")
      return
    }
    h2connStreamError(st, wu.streamId, errorProtocolError)
    return
  }
  if (wu.streamId == 0) {
    st.connSendWindow = st.connSendWindow + wu.increment
    h2connFlushAll(st)
    return
  }
  if (st.present[wu.streamId] == 0) {
    return
  }
  let s = st.streams[wu.streamId]
  s.sendWindow = s.sendWindow + wu.increment
  h2connFlushStream(st, s)
}

fn h2connOnRstStream(st: h2connState, f: Frame) {
  let rf = decodeRstStream(f) catch _ {
    h2connConnError(st, errorProtocolError, "http2: bad RST_STREAM")
    return
  }
  if (st.present[rf.streamId] == 0) {
    return
  }
  let s = st.streams[rf.streamId]
  h2connFailStreamCode(st, s, rf.errorCode)
}

fn h2connOnGoaway(st: h2connState, f: Frame) {
  let gf = decodeGoaway(f) catch _ {
    h2connConnError(st, errorProtocolError, "http2: bad GOAWAY")
    return
  }
  // The flag only stops us opening NEW streams (`h2connCmdOpen`), and it is the
  // whole of what this side records: `gf.lastStreamId` is read here and not
  // kept, because a stream we could open after this point always has a higher
  // id than any the peer can name — `st.nextStreamId` only ever climbs — so a
  // check against a stored id would refuse exactly what this flag refuses
  // (#4613).
  st.goawayReceived = true
  // The streams already open above `gf.lastStreamId` are abandoned, and nothing
  // else will ever release them (#4605): a peer that sends GOAWAY and keeps the
  // connection open — which is exactly what this engine's own `Conn.close()`
  // does — produces no EOF, so the `eof` arm's `h2connTerminate` never runs.
  h2connFailAbandoned(st, gf.lastStreamId, gf.errorCode)
}

fn h2connOnPing(st: h2connState, f: Frame) {
  let pf = decodePing(f) catch _ {
    h2connConnError(st, errorProtocolError, "http2: bad PING")
    return
  }
  if (!pf.ack) {
    h2connSendPing(st, PingFrame{ ack: true, data: pf.data })
  }
}

// --- command handling --------------------------------------------------------

fn h2connHandleCmd(st: h2connState, cmd: h2connCmd) {
  if (cmd.kind == h2cmdOpen) {
    h2connCmdOpen(st, cmd)
    return
  }
  if (cmd.kind == h2cmdRespond) {
    h2connCmdRespond(st, cmd)
    return
  }
  if (cmd.kind == h2cmdGoaway) {
    h2connCmdGoaway(st, cmd)
    return
  }
  if (cmd.kind == h2cmdReset) {
    h2connCmdReset(st, cmd)
    return
  }
}

// Open a client stream for `cmd.request`: allocate the next odd id, send its
// header block, and queue any body for flow-controlled delivery.
fn h2connCmdOpen(st: h2connState, cmd: h2connCmd) {
  if (st.goawaySent || st.goawayReceived || !st.running) {
    cmd.replyCh <- h2connMsg{
      ok: false,
      response: h2connZeroResponse(),
      errMsg: "http2: connection is closing",
    }
    return
  }
  // RFC 9113 §5.1.2: "Endpoints MUST NOT exceed the limit set by their peer."
  // Refused here rather than on the wire, because the peer's answer to the
  // stream we must not open is an RST_STREAM at best and a connection error at
  // worst, and either way the caller waits for a round trip that cannot happen.
  // `st.activeStreams` counts our own streams on a client — nothing else ever
  // enters a client's table, `h2connClientHeaders` requiring an existing entry —
  // and `peerMaxConcurrentStreams` is 2^32-1 until the peer names a limit, so
  // this costs one comparison on a connection whose peer set no limit.
  if (st.activeStreams >= st.peerMaxConcurrentStreams) {
    cmd.replyCh <- h2connMsg{
      ok: false,
      response: h2connZeroResponse(),
      errMsg: "http2: peer's concurrent stream limit (${st.peerMaxConcurrentStreams}) reached",
    }
    return
  }
  // RFC 9113 §6.5.2: the peer's SETTINGS_MAX_HEADER_LIST_SIZE is what it will
  // accept from us, so a request over it is refused here rather than encoded
  // and sent (#4607). Same position as the concurrency check above and for the
  // same reason: before an id is spent and before a table entry exists, so a
  // caller whose own headers are the problem is told that, instead of waiting
  // out a round trip the peer answers with RST_STREAM or GOAWAY.
  //
  // The fields are built once and handed to the encoder below, so the check
  // costs the walk and not a second `h2connRequestFields`. It always walks:
  // `peerMaxHeaderListBytes` is 2^32-1 until the peer names a limit, which
  // keeps this one comparison rather than a branch on whether a limit exists.
  let fields = h2connRequestFields(cmd.request)
  let listSize = h2connHeaderListSize(fields)
  if (listSize > st.peerMaxHeaderListBytes) {
    cmd.replyCh <- h2connMsg{
      ok: false,
      response: h2connZeroResponse(),
      errMsg: h2connHeaderListMsg(listSize, st.peerMaxHeaderListBytes),
    }
    return
  }
  let id = st.nextStreamId
  st.nextStreamId = st.nextStreamId + 2
  let hasBody = len(cmd.request.body) > 0
  let s = h2connNewStream(id, st.peerInitialWindow, st.ourInitialWindow, cmd.replyCh)
  if (hasBody) {
    s.state = h2stOpen
  } else {
    s.state = h2stHCLocal
  }
  st.streams[id] = s
  st.present[id] = 1
  st.activeStreams = st.activeStreams + 1

  let block = st.enc.encode(fields)
  h2connSendHeaderBlock(st, id, block, !hasBody)
  if (hasBody) {
    s.pendingData = cmd.request.body
    s.pendingEnd = true
    s.hasPending = true
    h2connFlushStream(st, s)
  }
}

// Answer a server stream. A zero status is the handler's request to abort.
fn h2connCmdRespond(st: h2connState, cmd: h2connCmd) {
  if (st.present[cmd.streamId] == 0) {
    return
  }
  let s = st.streams[cmd.streamId]
  if (s.state == h2stClosed || s.reset) {
    return
  }
  if (cmd.response.status == 0) {
    h2connSendRstStream(st, RstStreamFrame{ streamId: cmd.streamId, errorCode: errorCancel })
    h2connCloseStream(st, s)
    return
  }
  // The same limit on the other side of the connection (#4607). There is no
  // caller to fail here — a server stream's `replyCh` is `h2connDummyReply()`
  // and the handler has already returned — so the stream is reset instead, and
  // the message reaches whoever reads the reset rather than a `roundTrip`.
  //
  // INTERNAL_ERROR, not PROTOCOL_ERROR or REFUSED_STREAM: the peer's framing is
  // legal and its request was processed. What failed is this endpoint producing
  // a response the peer told us it will not accept, which is a handler bug and
  // is what §7's INTERNAL_ERROR says. A stream error rather than a connection
  // one, because nothing about the connection or any other stream is wrong.
  let fields = h2connResponseFields(cmd.response)
  let listSize = h2connHeaderListSize(fields)
  if (listSize > st.peerMaxHeaderListBytes) {
    h2connStreamErrorMsg(
      st,
      cmd.streamId,
      errorInternalError,
      h2connHeaderListMsg(listSize, st.peerMaxHeaderListBytes),
    )
    return
  }
  let hasBody = len(cmd.response.body) > 0
  let block = st.enc.encode(fields)
  h2connSendHeaderBlock(st, cmd.streamId, block, !hasBody)
  if (hasBody) {
    s.pendingData = cmd.response.body
    s.pendingEnd = true
    s.hasPending = true
    h2connFlushStream(st, s)
    return
  }
  h2connLocalEnd(st, s)
}

fn h2connCmdGoaway(st: h2connState, cmd: h2connCmd) {
  if (st.goawaySent) {
    return
  }
  st.goawaySent = true
  h2connSendGoaway(
    st,
    GoawayFrame{
      lastStreamId: st.lastPeerStreamId,
      errorCode: cmd.errorCode,
      debugData: []byte(0),
    },
  )
}

// Abort a stream the application asked to abort (`Conn.resetStream`): tell the
// peer with RST_STREAM and fail our side.
//
// Through `h2connStreamErrorMsg` (streams.bit), which is the whole of it —
// sending the RST_STREAM, finding the stream and failing it are exactly what
// that helper does for every other reset this side decides on. This used to
// call `h2connCloseStream` directly instead, and closing answers nobody:
// `h2connFailAll` is the only thing that ever wakes a `roundTrip` parked on
// `s.replyCh` after the fact and it skips a closed stream by its own test
// (`s.state != h2stClosed`), so a client whose stream another green thread
// reset was never released — forever at `deadlineNs == 0`, and otherwise only
// on its deadline with a timeout message that named the wrong cause (#4598).
//
// The message names a LOCAL reset: `h2connStreamError`'s peer wording would be
// a lie on this path, since the peer has not acted at all.
fn h2connCmdReset(st: h2connState, cmd: h2connCmd) {
  h2connStreamErrorMsg(st, cmd.streamId, cmd.errorCode, h2connLocalResetMsg(cmd.errorCode))
}

