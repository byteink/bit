// Bit standard library — http2 module, the mapping between `Request`/`Response`
// and the header-field lists on the wire. Split out of `conn.bit` (a pure move)
// when extended CONNECT (RFC 8441, connect.bit) took that file past the 800-line
// ceiling; same flat `std/http2` module and namespace.

// --- header <-> class mapping -----------------------------------------------

fn h2connRequestFields(req: Request): []HeaderField {
  let fields = []HeaderField(0)
  fields = append(fields, HeaderField{ name = ":method", value = req.method, sensitive = false })
  fields = append(fields, HeaderField{ name = ":scheme", value = req.scheme, sensitive = false })
  fields = append(
    fields,
    HeaderField{ name = ":authority", value = req.authority, sensitive = false },
  )
  fields = append(fields, HeaderField{ name = ":path", value = req.path, sensitive = false })
  if (req.protocol != "") {
    // RFC 8441 §4: `:protocol` rides with the other request pseudo-headers,
    // before any regular field (RFC 9113 §8.3).
    fields = append(
      fields,
      HeaderField{ name = ":protocol", value = req.protocol, sensitive = false },
    )
  }
  for h of req.headers {
    fields = append(fields, h)
  }
  return fields
}

fn h2connResponseFields(res: Response): []HeaderField {
  let fields = []HeaderField(0)
  fields = append(
    fields,
    HeaderField{ name = ":status", value = h2connItoa(res.status), sensitive = false },
  )
  for h of res.headers {
    fields = append(fields, h)
  }
  return fields
}

fn h2connBuildRequest(fields: []HeaderField): Request {
  let method = ""
  let scheme = ""
  let authority = ""
  let path = ""
  let protocol = ""
  let hs = []HeaderField(0)
  for h of fields {
    if (h.name == ":protocol") {
      protocol = h.value
    } else if (h.name == ":method") {
      method = h.value
    } else if (h.name == ":scheme") {
      scheme = h.value
    } else if (h.name == ":authority") {
      authority = h.value
    } else if (h.name == ":path") {
      path = h.value
    } else {
      hs = append(hs, h)
    }
  }
  return Request{
    method = method,
    scheme = scheme,
    authority = authority,
    path = path,
    protocol = protocol,
    headers = hs,
    body = []byte(0),
  }
}

fn h2connMergeHeaders(a: []HeaderField, b: []HeaderField): []HeaderField {
  let out = a
  for h of b {
    // bit:lint allow E0214 -- unexported; its 2 call sites (events.bit:263,330) reassign s.recvHeaders = h2connMergeHeaders(s.recvHeaders, ...) and no other reference reads the pre-call slice
    out = append(out, h)
  }
  return out
}
