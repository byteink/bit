// stdlib/decimal/decimal.test.bit — #3983: toString/parseDecimal round-trip,
// round(scale, mode) for all six RoundMode variants, and parseDecimal's
// rejections.
//
// Same module as ./decimal.bit (SPEC §17.1): parseDecimal/toString/round/
// RoundMode are reached here unqualified, no import, no redeclaration.

test "toString round-trips through parseDecimal for a 55-value corpus, byte for byte" {
  // Negatives, trailing zeros ("1.50", "0.0100", "100.00"), the maximum and
  // minimum representable values (2^96-1, sign-magnitude), and two scale-28
  // values (the smallest nonzero magnitude, and a value one digit short of
  // the type's own 29-digit ceiling) — every value below is already in
  // toString's own canonical form, so an exact round trip is the only
  // correct outcome.
  let corpus = []string{
    "0", "1", "-1", "2", "-2", "3", "-3", "10", "-10", "100",
    "1.5", "-1.5", "0.1", "-0.1", "0.5", "2.5", "3.5", "19.99", "-19.99", "100.00",
    "1.50", "2.500", "0.010", "0.0100", "1.0", "-1.0", "1000000000000000000",
    "-1000000000000000000", "999999999999999999", "123456789012345678",
    "12345.6789", "-12345.6789", "0.001", "0.0001", "0.00001", "3.14159265",
    "-3.14159265", "7.000", "8.00", "9.0",
    "0.25", "0.125", "-0.125", "50.5", "-50.5", "1000.001", "-1000.001",
    "864197532.123456", "246813579.654321", "55.55",
    "79228162514264337593543950335", "-79228162514264337593543950335",
    "0.0000000000000000000000000001", "7.9228162514264337593543950335",
  }
  assert(len(corpus) >= 50, "corpus has ${len(corpus)} entries, want at least 50")
  let i = 0
  while (i < len(corpus)) {
    let text = corpus[i]
    let r = parseDecimal(text)
    assert(r.ok, "parseDecimal(${text}) failed: ${r.err}")
    let back = toString(r.value)
    assert(back == text, "toString(parseDecimal(${text})) = ${back}, want ${text}")
    i = i + 1
  }
}

test "round(2, HalfEven) and round(2, HalfUp) differ on 2.345, matching hand-computed values" {
  let x: decimal = 2.345
  // 2.345 rounded to 2 places: the dropped digit is exactly 5 with nothing
  // after it — a tie. HalfEven picks the even neighbor (4), HalfUp always
  // breaks a tie away from zero (5).
  assert(toString(round(x, 2, RoundMode.HalfEven)) == "2.34", "HalfEven(2.345,2)")
  assert(toString(round(x, 2, RoundMode.HalfUp)) == "2.35", "HalfUp(2.345,2)")
}

test "all six RoundMode variants, one hand-computed case each" {
  let truncateX: decimal = 2.9
  assert(toString(round(truncateX, 0, RoundMode.Truncate)) == "2", "Truncate(2.9,0)")

  let floorX: decimal = -2.7
  assert(toString(round(floorX, 0, RoundMode.Floor)) == "-3", "Floor(-2.7,0)")

  let ceilingX: decimal = 2.3
  assert(toString(round(ceilingX, 0, RoundMode.Ceiling)) == "3", "Ceiling(2.3,0)")

  let halfUpX: decimal = 2.5
  assert(toString(round(halfUpX, 0, RoundMode.HalfUp)) == "3", "HalfUp(2.5,0)")

  let halfDownX: decimal = 2.5
  assert(toString(round(halfDownX, 0, RoundMode.HalfDown)) == "2", "HalfDown(2.5,0)")

  let halfEvenX: decimal = 3.5
  assert(
    toString(round(halfEvenX, 0, RoundMode.HalfEven)) == "4",
    "HalfEven(3.5,0) picks even neighbor 4",
  )
}

test "negative scale rounds to tens and hundreds, both directions" {
  let belowHalf: decimal = 12345
  assert(
    toString(round(belowHalf, -2, RoundMode.HalfUp)) == "12300",
    "12345 to nearest hundred, remainder 45 < 50",
  )

  let atOrAboveHalf: decimal = 12395
  assert(
    toString(round(atOrAboveHalf, -2, RoundMode.HalfUp)) == "12400",
    "12395 to nearest hundred, remainder 95 >= 50",
  )

  let small: decimal = 0.3
  assert(toString(round(small, -1, RoundMode.Ceiling)) == "10", "0.3 up to the nearest ten")
  assert(toString(round(-small, -1, RoundMode.Floor)) == "-10", "-0.3 down to the nearest ten")
}

test "parseDecimal rejects whitespace, thousands separators, currency symbols, trailing junk, and empty input" {
  let leadingSpace = parseDecimal(" 1.5")
  assert(!leadingSpace.ok, "' 1.5' must be rejected, not silently trimmed")

  let thousands = parseDecimal("1,234")
  assert(!thousands.ok, "'1,234' must be rejected, not parsed as 1")

  let currency = parseDecimal("$1.50")
  assert(!currency.ok, "'$1.50' must be rejected")

  let trailingJunk = parseDecimal("1.5x")
  assert(!trailingJunk.ok, "'1.5x' must be rejected, not parsed as 1.5")

  let empty = parseDecimal("")
  assert(!empty.ok, "the empty string must be rejected")
}

// The wire form of a Postgres/MySQL `numeric` column is decimal text
// (#3983's own motivation): a value with more significant digits than
// decimal's 96-bit mantissa holds must surface as a parse error naming the
// problem, never a silently rounded/truncated value.
test "a numeric string with more digits than decimal holds is a parse error, not a rounded value" {
  // One past decimal's maximum magnitude (79228162514264337593543950335):
  // 30 digits, ending where the max's own last digit (5) would need a 6.
  let tooManyDigits = parseDecimal("792281625142643375935439503360")
  assert(
    !tooManyDigits.ok,
    "792281625142643375935439503360 exceeds decimal's precision and must be rejected",
  )

  // The true maximum itself must still parse exactly — the guard is at the
  // boundary, not short of it.
  let atMax = parseDecimal("79228162514264337593543950335")
  assert(atMax.ok, "the true maximum representable value must parse: ${atMax.err}")
}
