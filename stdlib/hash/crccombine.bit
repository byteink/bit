// All three CRCs use equal all-ones initial and final masks, so the masks
// cancel when the advanced first checksum is XORed with the second.

// Combines independently computed CRC-32 checksums of A and B; lenB is B's
// byte length. An empty B leaves a unchanged, regardless of b.
export fn crc32Combine(a: u32, b: u32, lenB: u64): u32 {
  return u32(crcCombine(u64(a), u64(b), lenB, 0xedb88320, 32))
}

// Combines independently computed CRC-32C checksums using B's byte length.
export fn crc32cCombine(a: u32, b: u32, lenB: u64): u32 {
  return u32(crcCombine(u64(a), u64(b), lenB, 0x82f63b78, 32))
}

// Combines independently computed CRC-64/NVME checksums using B's byte length.
export fn crc64nvmeCombine(a: u64, b: u64, lenB: u64): u64 {
  return crcCombine(a, b, lenB, 0x9a6c9329ac4bc9b5, 64)
}

fn crcMatrixTimes(matrix: [64]u64, value: u64, width: int): u64 {
  let result: u64 = 0
  let i = 0
  while (i < width) {
    if ((value & 1) != 0) {
      result = result ^ matrix[i]
    }
    value = value >> 1
    i = i + 1
  }
  return result
}

fn crcMatrixSquare(matrix: [64]u64, width: int): [64]u64 {
  let square: [64]u64
  let i = 0
  while (i < width) {
    square[i] = crcMatrixTimes(matrix, matrix[i], width)
    i = i + 1
  }
  return square
}

fn crcByteMatrix(poly: u64, width: int): [64]u64 {
  let matrix: [64]u64
  let i = 0
  while (i < width) {
    let value = u64(1) << u64(i)
    let bit = 0
    while (bit < 8) {
      let low = value & 1
      value = value >> 1
      if (low != 0) {
        value = value ^ poly
      }
      bit = bit + 1
    }
    matrix[i] = value
    i = i + 1
  }
  return matrix
}

fn crcCombine(a: u64, b: u64, lenB: u64, poly: u64, width: int): u64 {
  if (lenB == 0) {
    return a
  }
  let matrix = crcByteMatrix(poly, width)
  let bit = 0
  // Exponentiate by bytes rather than multiplying lenB by eight, which would
  // overflow for the largest u64 lengths.
  while (bit < 64 && lenB != 0) {
    if ((lenB & 1) != 0) {
      a = crcMatrixTimes(matrix, a, width)
    }
    lenB = lenB >> 1
    if (lenB != 0) {
      matrix = crcMatrixSquare(matrix, width)
    }
    bit = bit + 1
  }
  return a ^ b
}
