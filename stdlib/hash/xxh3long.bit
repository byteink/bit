// Bit standard library — hash module, XXH3-64 for inputs over 240 bytes.
//
// THE ALGORITHM (xxhash.h, `XXH3_hashLong_64b_internal`): eight 64-bit
// accumulators start at fixed constants. Each 64-byte stripe adds its eight
// lanes in: lane `l` xors the data word with a secret word, adds the product
// of that value's two 32-bit halves to accumulator `l`, and adds the raw data
// word to the neighbour `l ^ 1`. Stripe `s` of a 1024-byte block (16 stripes)
// reads the secret 8 bytes further along per stripe, and a full block ends
// with a scramble of every accumulator. The final stripe is always the last 64
// bytes of the input, which overlaps the previous stripe unless the length is a
// multiple of 64, and reads the secret at byte 121. The accumulators then
// merge, pairwise, through the same 64x64->128 multiply fold the short paths
// use, and avalanche.
//
// A stripe is consumed only when at least one byte follows it, so the stripe
// count is `(len - 1) / 64`; the streaming hasher (xxh3stream.bit) keeps its
// last stripe back for the same reason.
//
// The 128-bit hash (xxh3x128.bit) runs this same loop and merges the same
// accumulators twice, once at each offset, for its two halves.
//
// THE SECRET is a 192-byte "key": the default secret for seed 0 and the
// default secret with the seed added to every even word and subtracted from
// every odd one otherwise (`XXH3_initCustomSecret`; for seed 0 that is the
// identity, so one derivation serves both). It is held as bytes so every key
// word, word aligned or not (121, 11, 117), is one unaligned `loadU64`.
//
// The stripe loop reads data and key words with unchecked `loadU64`; each
// caller's range is checked once per call (`xxSpan`, xxhash64.bit).

const xxh3Lanes: int = 8

// Bytes per stripe: one 8-byte data word per lane.
const xxh3Stripe: int = 64

// Stripes per block: (192 secret bytes - 64) / 8 bytes per stripe.
const xxh3BlockStripes: int = 16

// Bytes in the key.
const xxh3KeyLen: int = 192

// Bytes per block.
const xxh3Block: int = 1024

// Key byte that scrambles the accumulators.
const xxh3ScrambleOff: int = 128

// Secret byte offset for the last stripe, and for merging the accumulators.
const xxh3LastOff: int = 121
const xxh3MergeOff: int = 11

// Where the 128-bit hash's high half merges: secret byte 117 (192 - 64 - 11).
const xxh3MergeOff128: int = 117

// The scramble multiplier, PRIME32_1.
const xxh3Prime32: u64 = 0x9e3779b1

// The 192-byte key for `seed`: the default secret moved by the seed.
fn xxh3Key(seed: u64): []byte {
  let key = []byte(xxh3KeyLen)
  let i = 0
  while (i < 24) {
    xxh3PutWord(key, 8 * i, xxh3Secret[i] + seed)
    xxh3PutWord(key, 8 * i + 8, xxh3Secret[i + 1] - seed)
    i = i + 2
  }
  return key
}

// Stores `w` little-endian at `key[off..off+8]`.
fn xxh3PutWord(key: []byte, off: int, w: u64) {
  let b = 0
  while (b < 8) {
    key[off + b] = byte(w >> u64(8 * b))
    b = b + 1
  }
}

// The eight accumulators at the start of a hash: PRIME32_3, PRIME64_1,
// PRIME64_2, PRIME64_3, PRIME64_4, PRIME32_2, PRIME64_5, PRIME32_1.
fn xxh3Acc(): []u64 {
  let acc = []u64(8)
  acc[0] = 0xc2b2ae3d
  acc[1] = xxP1
  acc[2] = xxP2
  acc[3] = xxP3
  acc[4] = xxP4
  acc[5] = 0x85ebca77
  acc[6] = xxP5
  acc[7] = 0x9e3779b1
  return acc
}

// The state both the one-shot and the streaming hash run the stripe loop on:
// the eight accumulators and the 192-byte key for the seed.
class Xxh3Core {
  acc: []u64
  key: []byte

  init(seed: u64) {
    this.acc = xxh3Acc()
    this.key = xxh3Key(seed)
  }
}

// Little-endian u64 of the key's bytes `off..off+8`.
fn xxh3KeyAt(key: []byte, off: int): u64 {
  return xxRead64(key, off)
}

// One lane's accumulator step: `a` plus its neighbour lane's data word `nb`
// plus the product of the two 32-bit halves of its own keyed word `dk`.
fn xxh3Lane(a: u64, nb: u64, dk: u64): u64 {
  return a + nb + (dk & 0xffffffff) * (dk >> 32)
}

// `count` consecutive 64-byte stripes from `data[from..]` into `acc`, the
// first keyed at key byte `ko` and each next one 8 bytes further. The eight
// accumulators run in locals, the lanes are raw loads, and both ranges are
// checked once here.
fn xxh3Run(acc: []u64, data: []byte, from: int, count: int, key: []byte, ko: int) {
  xxSpan(data, from, from + xxh3Stripe * count)
  xxSpan(key, ko, ko + 8 * count + 56)
  let a0 = acc[0]
  let a1 = acc[1]
  let a2 = acc[2]
  let a3 = acc[3]
  let a4 = acc[4]
  let a5 = acc[5]
  let a6 = acc[6]
  let a7 = acc[7]
  let d = ptrOf(data) + from
  let k = ptrOf(key) + ko
  let s = 0
  while (s < count) {
    let x0 = loadU64(d)
    let x1 = loadU64(d + 8)
    a0 = xxh3Lane(a0, x1, x0 ^ loadU64(k))
    a1 = xxh3Lane(a1, x0, x1 ^ loadU64(k + 8))
    let x2 = loadU64(d + 16)
    let x3 = loadU64(d + 24)
    a2 = xxh3Lane(a2, x3, x2 ^ loadU64(k + 16))
    a3 = xxh3Lane(a3, x2, x3 ^ loadU64(k + 24))
    let x4 = loadU64(d + 32)
    let x5 = loadU64(d + 40)
    a4 = xxh3Lane(a4, x5, x4 ^ loadU64(k + 32))
    a5 = xxh3Lane(a5, x4, x5 ^ loadU64(k + 40))
    let x6 = loadU64(d + 48)
    let x7 = loadU64(d + 56)
    a6 = xxh3Lane(a6, x7, x6 ^ loadU64(k + 48))
    a7 = xxh3Lane(a7, x6, x7 ^ loadU64(k + 56))
    d = d + xxh3Stripe
    k = k + 8
    s = s + 1
  }
  keepAlive(data)
  keepAlive(key)
  acc[0] = a0
  acc[1] = a1
  acc[2] = a2
  acc[3] = a3
  acc[4] = a4
  acc[5] = a5
  acc[6] = a6
  acc[7] = a7
}

// `count` consecutive stripes from `data[from..]` into `c`, the first against
// key word `kw` (key byte `8 * kw`) and each next one a word further.
fn xxh3Stripes(c: Xxh3Core, data: []byte, from: int, count: int, kw: int) {
  xxh3Run(c.acc, data, from, count, c.key, 8 * kw)
}

// The block-end scramble of every accumulator.
fn xxh3Scramble(acc: []u64, key: []byte) {
  let lane = 0
  while (lane < xxh3Lanes) {
    let a = acc[lane]
    a = a ^ (a >> 47)
    a = a ^ xxh3KeyAt(key, xxh3ScrambleOff + 8 * lane)
    acc[lane] = a * xxh3Prime32
    lane = lane + 1
  }
}

// Converges the eight accumulators of a hash into 64 bits: `init` plus the
// accumulator pairs, each xored with the key at byte `off` (and 8 further) and
// folded through the 64x64->128 multiply, then avalanched. The 64-bit hash
// merges at `xxh3MergeOff` from `n * PRIME64_1`; the 128-bit hash's high half
// merges at `xxh3MergeOff128` from `~(n * PRIME64_2)`.
fn xxh3Merge(acc: []u64, key: []byte, off: int, init: u64): u64 {
  let h = init
  let i = 0
  while (i < 4) {
    let o = off + 16 * i
    h = h + xxh3MulFold(acc[2 * i] ^ xxh3KeyAt(key, o), acc[2 * i + 1] ^ xxh3KeyAt(key, o + 8))
    i = i + 1
  }
  return xxh3Avalanche(h)
}

// A copy of the accumulators with the final stripe, `last[i..i+64]`, folded in
// (so `c` stays usable), ready to converge.
fn xxh3FinalAcc(c: Xxh3Core, last: []byte, i: int): []u64 {
  let acc = []u64(8)
  let lane = 0
  while (lane < xxh3Lanes) {
    acc[lane] = c.acc[lane]
    lane = lane + 1
  }
  xxh3Run(acc, last, i, 1, c.key, xxh3LastOff)
  return acc
}

// Finishes the 64-bit hash of `n` bytes from the final stripe `last[i..i+64]`.
fn xxh3Finish(c: Xxh3Core, last: []byte, i: int, n: u64): u64 {
  return xxh3Merge(xxh3FinalAcc(c, last, i), c.key, xxh3MergeOff, n * xxP1)
}

// Every stripe of `data` (longer than 240 bytes) but the last, under `seed`.
fn xxh3Absorb(data: []byte, seed: u64): Xxh3Core {
  let n = len(data)
  let c = Xxh3Core(seed)
  let blocks = (n - 1) / xxh3Block
  let b = 0
  while (b < blocks) {
    xxh3Stripes(c, data, b * xxh3Block, xxh3BlockStripes, 0)
    xxh3Scramble(c.acc, c.key)
    b = b + 1
  }
  let rest = (n - 1 - xxh3Block * blocks) / xxh3Stripe
  xxh3Stripes(c, data, blocks * xxh3Block, rest, 0)
  return c
}

// XXH3-64 of `data`, which must be longer than 240 bytes, under `seed`.
fn xxh3Long64(data: []byte, seed: u64): u64 {
  let n = len(data)
  return xxh3Finish(xxh3Absorb(data, seed), data, n - xxh3Stripe, u64(n))
}
