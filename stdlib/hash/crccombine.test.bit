test "CRC combine matches all 600 concatenations of a 3 MiB buffer" {
  let buf: []byte = []byte(3 * 1024 * 1024)
  let i = 0
  while (i < len(buf)) {
    buf[i] = byte((i * 7 + (i >> 8) * 13 + (i >> 16) * 31) & 0xff)
    i = i + 1
  }
  let ieee = crc32(buf)
  let castagnoli = crc32c(buf)
  let nvme = crc64nvme(buf)
  let trial = 0
  while (trial < 200) {
    let split = trial * len(buf) / 199
    let a = buf[:split]
    let b = buf[split:]
    let n = u64(len(b))
    assert(crc32Combine(crc32(a), crc32(b), n) == ieee, "IEEE split ${split}")
    assert(crc32cCombine(crc32c(a), crc32c(b), n) == castagnoli, "Castagnoli split ${split}")
    assert(crc64nvmeCombine(crc64nvme(a), crc64nvme(b), n) == nvme, "NVME split ${split}")
    trial = trial + 1
  }
}

test "CRC combine leaves an empty suffix unchanged and accepts one byte" {
  assert(crc32Combine(0x12345678, 0xffffffff, 0) == 0x12345678)
  assert(crc32cCombine(0x12345678, 0xffffffff, 0) == 0x12345678)
  assert(crc64nvmeCombine(0x123456789abcdef0, 0xffffffffffffffff, 0) == 0x123456789abcdef0)
  let a = []byte("12345678")
  let b = []byte("9")
  assert(crc32Combine(crc32(a), crc32(b), 1) == 0xcbf43926)
  assert(crc32cCombine(crc32c(a), crc32c(b), 1) == 0xe3069283)
  assert(crc64nvmeCombine(crc64nvme(a), crc64nvme(b), 1) == 0xae8b14860a799888)
}

test "CRC combine preserves lengths above 32 bits and at the u64 maximum" {
  // Independent scalar polynomial arithmetic: multiply the bit-reversed raw
  // state by x^(8*n) modulo the normal polynomial, then reverse and finalize.
  // b checksums n zero bytes; the result continues the catalogue check input.
  let n: u64 = 0x100000001
  assert(crc32Combine(0xcbf43926, 0x41d912ff, n) == 0xdd02d227)
  assert(crc32cCombine(0xe3069283, 0x6064a37a, n) == 0xc48fc8d7)
  assert(crc64nvmeCombine(0xae8b14860a799888, 0x3cbf876c3448e1cd, n) == 0x725f760c494fa72e)
  let max: u64 = 0xffffffffffffffff
  assert(crc32Combine(0xcbf43926, 0, max) == 0xcbf43926)
  assert(crc32cCombine(0xe3069283, 0x6064a37a, max) == 0xc48fc8d7)
  assert(crc64nvmeCombine(0xae8b14860a799888, 0, max) == 0xae8b14860a799888)
}
