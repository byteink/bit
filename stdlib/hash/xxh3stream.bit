// Bit standard library — hash module, streaming XXH3-64.
//
// `Xxh3` feeds the same stripe loop `xxh3Long64` runs (xxh3long.bit), so its
// digest equals `xxh3` of the concatenated chunks by construction, for any
// chunking; xxh3.test.bit proves it at every split point it can afford.
//
// WHAT IT KEEPS. Three byte buffers and the accumulators:
//   head  the first 240 bytes, because an input that never passes 240 bytes
//         takes a short path that needs all of its bytes at once;
//   buf   the pending stripe, 1..64 bytes once anything has been absorbed.
//         A stripe is consumed only when a byte follows it (`(len - 1) / 64`
//         stripes in the one-shot hash), so a full buffer waits for the next
//         `update`;
//   prev  the last consumed stripe. The final stripe of a hash is the last 64
//         bytes of the input; when `buf` holds fewer, the rest are the tail of
//         `prev`.

// Bytes of input the short paths cover, and so the bytes `head` keeps.
const xxh3Head: int = 240

export class Xxh3 {
  seed: u64
  core: Xxh3Core
  head: []byte
  buf: []byte
  prev: []byte
  bufLen: int
  stripesSoFar: int
  total: int

  init(seed: u64 = 0) {
    this.seed = seed
    this.core = Xxh3Core(seed)
    this.head = []byte(240)
    this.buf = []byte(64)
    this.prev = []byte(64)
    this.bufLen = 0
    this.stripesSoFar = 0
    this.total = 0
  }

  // Remembers the first 240 bytes of the whole input.
  keepHead(data: []byte) {
    let i = 0
    while (i < len(data) && this.total + i < xxh3Head) {
      this.head[this.total + i] = data[i]
      i = i + 1
    }
  }

  // Absorbs `count` stripes of `data` from `from`, scrambling at each block
  // end, and returns the index after them.
  consume(data: []byte, from: int, count: int): int {
    let i = from
    let left = count
    while (left > 0) {
      let take = xxh3BlockStripes - this.stripesSoFar
      if (take > left) {
        take = left
      }
      xxh3Stripes(this.core, data, i, take, this.stripesSoFar)
      this.stripesSoFar = this.stripesSoFar + take
      if (this.stripesSoFar == xxh3BlockStripes) {
        xxh3Scramble(this.core.acc, this.core.key)
        this.stripesSoFar = 0
      }
      i = i + take * xxh3Stripe
      left = left - take
    }
    return i
  }

  // Makes `data[from..from+64]` the last consumed stripe.
  keepPrev(data: []byte, from: int) {
    let i = 0
    while (i < xxh3Stripe) {
      this.prev[i] = data[from + i]
      i = i + 1
    }
  }

  // Absorbs `data`.
  export update(data: []byte) {
    let n = len(data)
    this.keepHead(data)
    this.total = this.total + n
    let i = 0
    if (this.bufLen > 0) {
      while (i < n && this.bufLen < xxh3Stripe) {
        this.buf[this.bufLen] = data[i]
        this.bufLen = this.bufLen + 1
        i = i + 1
      }
      if (i == n) {
        return
      }
      let _ = this.consume(this.buf, 0, 1)
      this.keepPrev(this.buf, 0)
      this.bufLen = 0
    }
    let stripes = (n - 1 - i) / xxh3Stripe
    if (stripes > 0) {
      i = this.consume(data, i, stripes)
      this.keepPrev(data, i - xxh3Stripe)
    }
    while (i < n) {
      this.buf[this.bufLen] = data[i]
      this.bufLen = this.bufLen + 1
      i = i + 1
    }
  }

  // The 64 bytes that end the input so far, as the final stripe's data.
  lastStripe(): []byte {
    if (this.bufLen == xxh3Stripe) {
      return this.buf
    }
    let tail = []byte(64)
    let gap = xxh3Stripe - this.bufLen
    let i = 0
    while (i < gap) {
      tail[i] = this.prev[this.bufLen + i]
      i = i + 1
    }
    i = 0
    while (i < this.bufLen) {
      tail[gap + i] = this.buf[i]
      i = i + 1
    }
    return tail
  }

  // The hash of everything absorbed so far. Does not consume the hasher: more
  // `update` calls may follow and a later `digest` covers them too.
  export digest(): u64 {
    if (this.total <= xxh3Head) {
      return xxh3(this.head[0:this.total], this.seed)
    }
    return xxh3Finish(this.core, this.lastStripe(), 0, u64(this.total))
  }

  // Rewinds to the empty input under the same seed, so one hasher can hash
  // many messages.
  export reset() {
    this.core.acc = xxh3Acc()
    this.bufLen = 0
    this.stripesSoFar = 0
    this.total = 0
  }
}
