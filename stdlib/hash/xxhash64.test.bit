// stdlib/hash/xxhash64.test.bit — xxHash64 correctness (#6571).
//
// Every expected value below comes from the reference implementation, none
// from this module:
//   1. The reference repository's own sanity vectors,
//      github.com/Cyan4973/xxHash tests/sanity_test_vectors.h
//      (XSUM_XXH64_testdata), pinned at commit
//      680bf463fa1ca0461b9a7c2dab7556e1f54cf4cf. That table covers every
//      length 0..4160 under seeds 0 and 0x9E3779B1 (8322 vectors) over the
//      buffer tests/sanity_test.c fillTestBuffer() builds: byteGen starts at
//      PRIME32 (2654435761), each byte is byteGen >> 56, and byteGen is then
//      multiplied by PRIME64 (11400714785074694797), wrapping. Lengths
//      0..256 are listed in full below; 257..4160 are listed at the 32-byte
//      stripe and 4 KiB boundaries and pinned in full by a fold (see
//      "all 8322 reference vectors" below).
//   2. The same pinned commit's xxhash.c compiled with cc -O2
//      -DXXH_INLINE_ALL, for what the sanity table does not hold: seeds with
//      high bits set, a few ASCII strings, and the 1 MiB buffer.
// A fold that matches the table row for row was checked to equal the
// reference library's own run over the same 8322 inputs before being used.

// The sanity buffer, 4161 bytes (SANITY_BUFFER_SIZE), or any longer prefix.
fn xxFill(n: int): []byte {
  let buf: []byte = []byte(n)
  let g: u64 = 2654435761
  let i = 0
  while (i < n) {
    buf[i] = byte(g >> 56)
    g = g * 11400714785074694797
    i = i + 1
  }
  return buf
}

// Hashes `data` in chunks of `size` bytes (the last one shorter).
fn xxChunked(data: []byte, size: int, seed: u64): u64 {
  let h = Xxhash64(seed)
  let i = 0
  while (i < len(data)) {
    let e = i + size
    if (e > len(data)) {
      e = len(data)
    }
    h.update(data[i:e])
    i = e
  }
  return h.digest()
}

