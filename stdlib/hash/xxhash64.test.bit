  0x2b5f2fbea26c36dd, 0xaa26f33c2898013b, 0x30123fd816c47db7, 0x6a128f7f02591e57,
  0xcb8b60cba513125d, 0x10c7d31644c76787, 0x3a9bf57dff788781, 0xa4cb59e19d6a35f9,
}

test "xxhash64 of the empty input matches the reference under seeds 0 and nonzero" {
  let empty: []byte = []byte(0)
  assert(xxhash64(empty) == 0xef46db3751d8e999, "xxhash64(empty) default seed")
  assert(xxhash64(empty, 0) == 0xef46db3751d8e999, "xxhash64(empty, 0)")
  assert(xxhash64(empty, 1) == 0xd5afba1336a3be4b, "xxhash64(empty, 1)")
  assert(xxhash64(empty, xxSeedB) == 0xac75fda2929b17ef, "xxhash64(empty, 0x9E3779B1)")
  assert(xxhash64(empty, 0xdeadbeefcafebabe) == 0x3ad50a3a77644ff9, "xxhash64(empty, 64-bit seed)")
  assert(
    xxhash64(empty, 0xffffffffffffffff) == 0x298f4c84b24f5380,
    "xxhash64(empty, all-ones seed)",
  )
}

test "xxhash64 matches the reference on ASCII strings and 64-bit seeds" {
  assert(xxhash64([]byte("a")) == 0xd24ec4f1a98c6e5b, "a, 0")
  assert(xxhash64([]byte("a"), 0xffffffffffffffff) == 0x60c43759873ece62, "a, all-ones")
  assert(xxhash64([]byte("abc")) == 0x44bc2cf5ad770999, "abc, 0")
  assert(xxhash64([]byte("abc"), 1) == 0xbea9ca8199328908, "abc, 1")
  assert(xxhash64([]byte("abc"), 0xdeadbeefcafebabe) == 0xdc7a93329bc72779, "abc, 64-bit seed")
  assert(xxhash64([]byte("123456789")) == 0x8cb841db40e6ae83, "123456789, 0")
  assert(xxhash64([]byte("123456789"), xxSeedB) == 0x6bc432bf21c3e5e2, "123456789, 0x9E3779B1")
  let fox = []byte("The quick brown fox jumps over the lazy dog")
  assert(xxhash64(fox) == 0x0b242d361fda71bc, "fox, 0")
  assert(xxhash64(fox, 1) == 0xdf5091b6dad2c6db, "fox, 1")
  assert(xxhash64(fox, 0xdeadbeefcafebabe) == 0xf72d377571af3e3a, "fox, 64-bit seed")
  assert(xxhash64(fox, 0xffffffffffffffff) == 0x9f3d039cd26eeafc, "fox, all-ones")
}

test "xxhash64 matches the sanity vectors at lengths 0 to 256, both seeds" {
  let buf = xxFill(257)
  let n = 0
  while (n <= 256) {
    let got0 = xxhash64(buf[0:n])
    assert(got0 == xxShort0[n], "xxhash64(len ${n}, seed 0) = ${got0}, want ${xxShort0[n]}")
    let got1 = xxhash64(buf[0:n], xxSeedB)
    assert(
      got1 == xxShort1[n],
      "xxhash64(len ${n}, seed 0x9E3779B1) = ${got1}, want ${xxShort1[n]}",
    )
    n = n + 1
  }
}

test "xxhash64 matches the sanity vectors at the stripe and block boundaries up to 4160" {
  let buf = xxFill(4161)
  let k = 0
  while (k < 20) {
    let n = xxLongLens[k]
    let got0 = xxhash64(buf[0:n])
    assert(got0 == xxLong0[k], "xxhash64(len ${n}, seed 0) = ${got0}, want ${xxLong0[k]}")
    let got1 = xxhash64(buf[0:n], xxSeedB)
    assert(got1 == xxLong1[k], "xxhash64(len ${n}, seed 0x9E3779B1) = ${got1}, want ${xxLong1[k]}")
    k = k + 1
  }
}

test "xxhash64 matches all 8322 reference vectors (lengths 0 to 4160, both seeds)" {
  // Fold of every sanity-table result in table order: acc = (acc ^ result) *
  // 0x9E3779B185EBCA87. Each step is a bijection, so a wrong hash at any one
  // length changes the final value. 0x9afb819ae8638727 is that fold over the
  // 8322 XSUM_XXH64_testdata rows, and equals the fold of the reference
  // library's own XXH64 over the same inputs.
  let buf = xxFill(4161)
  let acc: u64 = 0
  let n = 0
  while (n <= 4160) {
    acc = (acc ^ xxhash64(buf[0:n])) * 0x9e3779b185ebca87
    acc = (acc ^ xxhash64(buf[0:n], xxSeedB)) * 0x9e3779b185ebca87
    n = n + 1
  }
  assert(acc == 0x9afb819ae8638727, "fold over lengths 0..4160 = ${acc}, want 0x9afb819ae8638727")
}

test "xxhash64 matches the reference on 1 MiB" {
  let buf = xxFill(1048576)
  assert(xxhash64(buf) == 0x9f8b6862e54aaf54, "xxhash64(1 MiB, 0)")
  assert(xxhash64(buf, xxSeedB) == 0xe003178a100c7ed8, "xxhash64(1 MiB, 0x9E3779B1)")
}

test "Xxhash64 streamed in 1, 7, 32 and 33 byte chunks equals the one-shot hash" {
  let buf = xxFill(4161)
  let sizes: []int = []int{ 1, 7, 31, 32, 33, 64, 65, 1000 }
  let k = 0
  while (k < len(sizes)) {
    let want0 = xxhash64(buf)
    let got0 = xxChunked(buf, sizes[k], 0)
    assert(got0 == want0, "chunks of ${sizes[k]}, seed 0: ${got0}, want ${want0}")
    let want1 = xxhash64(buf, xxSeedB)
    let got1 = xxChunked(buf, sizes[k], xxSeedB)
    assert(got1 == want1, "chunks of ${sizes[k]}, seed 0x9E3779B1: ${got1}, want ${want1}")
    k = k + 1
  }
}

test "Xxhash64 streamed over 1 MiB equals the reference" {
  let buf = xxFill(1048576)
  assert(xxChunked(buf, 7, 0) == 0x9f8b6862e54aaf54, "7-byte chunks")
  assert(xxChunked(buf, 33, xxSeedB) == 0xe003178a100c7ed8, "33-byte chunks, seeded")
  assert(xxChunked(buf, 4096, 0) == 0x9f8b6862e54aaf54, "4096-byte chunks")
  assert(xxChunked(buf, 1048576, 0) == 0x9f8b6862e54aaf54, "one chunk")
}

test "Xxhash64 digest after every prefix length equals the reference vectors" {
  // One hasher fed one byte at a time; `digest` after each byte must equal
  // the sanity vector for that length (digest does not consume the hasher).
  let buf = xxFill(257)
  let h = Xxhash64()
  let g = Xxhash64(xxSeedB)
  assert(h.digest() == xxShort0[0], "digest of nothing, seed 0")
  assert(g.digest() == xxShort1[0], "digest of nothing, seeded")
  let n = 1
  while (n <= 256) {
    h.update(buf[n - 1:n])
    g.update(buf[n - 1:n])
    assert(h.digest() == xxShort0[n], "streamed prefix ${n}, seed 0")
    assert(g.digest() == xxShort1[n], "streamed prefix ${n}, seed 0x9E3779B1")
    n = n + 1
  }
}

test "Xxhash64 split in two at every point equals the one-shot hash" {
  let buf = xxFill(300)
  let want = xxhash64(buf, 0xdeadbeefcafebabe)
  let p = 0
  while (p <= 300) {
    let h = Xxhash64(0xdeadbeefcafebabe)
    h.update(buf[0:p])
    h.update(buf[p:300])
    assert(h.digest() == want, "split at ${p}")
    p = p + 1
  }
}

test "Xxhash64 split in three at every pair of points up to 140 equals the one-shot hash" {
  let buf = xxFill(140)
  let want = xxhash64(buf)
  let p = 0
  while (p <= 140) {
    let q = p
    while (q <= 140) {
      let h = Xxhash64()
      h.update(buf[0:p])
      h.update(buf[p:q])
      h.update(buf[q:140])
      assert(h.digest() == want, "split at ${p} and ${q}")
      q = q + 1
    }
    p = p + 1
  }
}

test "Xxhash64 digest does not consume the hasher and reset restarts it" {
  let buf = xxFill(100)
  let h = Xxhash64(7)
  h.update(buf[0:40])
  let mid = h.digest()
  assert(mid == xxhash64(buf[0:40], 7), "digest mid-stream")
  assert(h.digest() == mid, "digest twice")
  h.update(buf[40:100])
  assert(h.digest() == xxhash64(buf, 7), "digest after more input")
  h.reset()
  assert(h.digest() == xxhash64([]byte(0), 7), "digest after reset")
  h.update(buf[0:33])
  assert(h.digest() == xxhash64(buf[0:33], 7), "digest after reset and reuse")
}

test "Xxhash64 ignores empty updates" {
  let buf = xxFill(70)
  let h = Xxhash64()
  h.update([]byte(0))
  h.update(buf[0:32])
  h.update([]byte(0))
  h.update(buf[32:70])
  h.update([]byte(0))
  assert(h.digest() == xxhash64(buf), "empty updates between chunks")
}
