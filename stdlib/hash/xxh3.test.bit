  0xef368a8a2ebabaef, 0x96792bcf9af88519, 0x9dda30bbbf69bf13, 0x542632d046f3dde4,
  0xff8423d886707134, 0x8111bb82842ed0ae, 0x66f81670669ababc, 0xe48083836cd58024,
  0x9f7ddf29c377a8ec, 0x2a3bbb20a5439dcd, 0xa78887a19a340214, 0x19bc48ee50380e4d,
  0x1bf6f5faf9eecabd,
}

// Per seed in `xxh3Seeds`, the fold over lengths 241..1100 (the long path:
// one block boundary at 1024 and its scramble) of the sanity buffer.
const xxh3LongSeedFolds: [6]u64 = [6]u64{
  0x22236f4cce808455, 0xbfe7cab2f0b4ae78, 0x1cdc81e2eebd3a5f,
  0xdd4d5c6aeba22757, 0xf854de6cef64117e, 0xdfb536d902e592cd,
}

// Seeds with high bits set, in the order of the three tables below.
const xxh3Seeds: [6]u64 = [6]u64{
  0x0000000000000001, 0xdeadbeefcafebabe, 0xffffffffffffffff,
  0x00000000ffffffff, 0xffffffff00000000, 0x8000000000000000,
}

// XXH3_64bits_withSeed of the empty input under each of `xxh3Seeds`.
const xxh3EmptySeeded: [6]u64 = [6]u64{
  0x4dc5b0cc826f6703, 0x21605795bc1bc9c4, 0x4c093276ae47a555,
  0xa4f199794ccfa477, 0x4bd9bb19f765822b, 0x1fdb4382f72040b7,
}

// Per seed in `xxh3Seeds`, the fold over lengths 0..240 of the sanity buffer.
const xxh3SeedFolds: [6]u64 = [6]u64{
  0x53a0974e184f8aa9, 0x021aa6e2204fdbb5, 0xa7f3bf57a54ccf70,
  0x084043aee99d48fc, 0xbee40c4410843f09, 0x8f4afe14f131ef2d,
}

test "xxh3 of the empty input matches the reference under seeds 0 and with high bits set" {
  let empty: []byte = []byte(0)
  assert(xxh3(empty) == 0x2d06800538d394c2, "xxh3(empty) default seed")
  assert(xxh3(empty, 0) == 0x2d06800538d394c2, "xxh3(empty, 0)")
  assert(xxh3(empty, xxh3SeedB) == 0xa8a6b918b2f0364a, "xxh3(empty, sanity seed B)")
  let k = 0
  while (k < 6) {
    let got = xxh3(empty, xxh3Seeds[k])
    assert(
      got == xxh3EmptySeeded[k],
      "xxh3(empty, seed ${xxh3Seeds[k]}) = ${got}, want ${xxh3EmptySeeded[k]}",
    )
    k = k + 1
  }
}

test "xxh3 matches the reference on ASCII strings and 64-bit seeds" {
  let s0 = []byte("a")
  assert(xxh3(s0) == 0xe6c632b61e964e1f, "a, default seed")
  assert(xxh3(s0, 0x0000000000000001) == 0xd2f6d0996f37a720, "a, seed 0000000000000001")
  assert(xxh3(s0, 0xdeadbeefcafebabe) == 0x3a4d599d2aa4db73, "a, seed deadbeefcafebabe")
  assert(xxh3(s0, 0xffffffffffffffff) == 0x43a7e49bc8a25756, "a, seed ffffffffffffffff")
  assert(xxh3(s0, 0x00000000ffffffff) == 0x786461b9cda2751c, "a, seed 00000000ffffffff")
  assert(xxh3(s0, 0xffffffff00000000) == 0xb591b1f5f6e9d7c5, "a, seed ffffffff00000000")
  assert(xxh3(s0, 0x8000000000000000) == 0x2d595e0de968566a, "a, seed 8000000000000000")
  let s1 = []byte("abc")
  assert(xxh3(s1) == 0x78af5f94892f3950, "abc, default seed")
  assert(xxh3(s1, 0x0000000000000001) == 0x6b4467b443c76228, "abc, seed 0000000000000001")
  assert(xxh3(s1, 0xdeadbeefcafebabe) == 0xfa1fc96007987195, "abc, seed deadbeefcafebabe")
  assert(xxh3(s1, 0xffffffffffffffff) == 0x291c3db09146c9c9, "abc, seed ffffffffffffffff")
  assert(xxh3(s1, 0x00000000ffffffff) == 0x347a8da9594080f8, "abc, seed 00000000ffffffff")
  assert(xxh3(s1, 0xffffffff00000000) == 0x36ce5aa32216fdcf, "abc, seed ffffffff00000000")
  assert(xxh3(s1, 0x8000000000000000) == 0x581a650a400a5b1c, "abc, seed 8000000000000000")
  let s2 = []byte("123456789")
  assert(xxh3(s2) == 0x72dcb18b67a17dff, "123456789, default seed")
  assert(xxh3(s2, 0x0000000000000001) == 0xe967c19057995816, "123456789, seed 0000000000000001")
  assert(xxh3(s2, 0xdeadbeefcafebabe) == 0x80d8361644c90a60, "123456789, seed deadbeefcafebabe")
  assert(xxh3(s2, 0xffffffffffffffff) == 0x2cabe0e406d842fc, "123456789, seed ffffffffffffffff")
  assert(xxh3(s2, 0x00000000ffffffff) == 0xb87e58f1bb51608a, "123456789, seed 00000000ffffffff")
  assert(xxh3(s2, 0xffffffff00000000) == 0x2a8f8710e3b3073d, "123456789, seed ffffffff00000000")
  assert(xxh3(s2, 0x8000000000000000) == 0x844136396a2dfa6c, "123456789, seed 8000000000000000")
  let s3 = []byte("The quick brown fox jumps over the lazy dog")
  assert(xxh3(s3) == 0xce7d19a5418fb365, "fox, default seed")
  assert(xxh3(s3, 0x0000000000000001) == 0x1e098210b55fad4a, "fox, seed 0000000000000001")
  assert(xxh3(s3, 0xdeadbeefcafebabe) == 0xa276a6ac01589c02, "fox, seed deadbeefcafebabe")
  assert(xxh3(s3, 0xffffffffffffffff) == 0xbce97e3bb51bbd73, "fox, seed ffffffffffffffff")
  assert(xxh3(s3, 0x00000000ffffffff) == 0x011de6bfb11745d6, "fox, seed 00000000ffffffff")
  assert(xxh3(s3, 0xffffffff00000000) == 0x830b2b88d3bc7e97, "fox, seed ffffffff00000000")
  assert(xxh3(s3, 0x8000000000000000) == 0x006718ac697807a0, "fox, seed 8000000000000000")
}

test "xxh3 matches the sanity vectors at lengths 0 to 240, both seeds" {
  let buf = xxh3Fill(241)
  let n = 0
  let rows = 0
  while (n <= 240) {
    let got0 = xxh3(buf[0:n])
    assert(got0 == xxh3Sanity0[n], "xxh3(len ${n}, seed 0) = ${got0}, want ${xxh3Sanity0[n]}")
    let got1 = xxh3(buf[0:n], xxh3SeedB)
    assert(
      got1 == xxh3Sanity1[n],
      "xxh3(len ${n}, seed 0x9E3779B185EBCA8D) = ${got1}, want ${xxh3Sanity1[n]}",
    )
    rows = rows + 2
    n = n + 1
  }
  assert(rows == 482, "checked ${rows} sanity rows, want 482")
}

test "xxh3 matches all 482 reference vectors (lengths 0 to 240, both seeds)" {
  // The fold of every sanity-table row for lengths 0..240 in table order.
  // 0x4c16693a9a0d70ed is that fold over the 482 XSUM_XXH3_testdata rows, and equals the
  // fold of the reference library's own XXH3_64bits over the same inputs.
  let buf = xxh3Fill(241)
  let acc: u64 = 0
  let n = 0
  while (n <= 240) {
    acc = xxh3Fold(acc, xxh3(buf[0:n]))
    acc = xxh3Fold(acc, xxh3(buf[0:n], xxh3SeedB))
    n = n + 1
  }
  assert(acc == 0x4c16693a9a0d70ed, "fold over lengths 0..240 = ${acc}, want 0x4c16693a9a0d70ed")
}

test "xxh3 matches the reference under seeds with high bits set, lengths 0 to 240" {
  let buf = xxh3Fill(241)
  let k = 0
  while (k < 6) {
    let acc: u64 = 0
    let n = 0
    while (n <= 240) {
      acc = xxh3Fold(acc, xxh3(buf[0:n], xxh3Seeds[k]))
      n = n + 1
    }
    assert(
      acc == xxh3SeedFolds[k],
      "fold under seed ${xxh3Seeds[k]} = ${acc}, want ${xxh3SeedFolds[k]}",
    )
    k = k + 1
  }
}

test "xxh3 of a subslice equals the hash of a copy at every length" {
  let buf = xxh3Fill(300)
  let n = 0
  while (n <= 240) {
    let copy: []byte = []byte(n)
    let i = 0
    while (i < n) {
      copy[i] = buf[7 + i]
      i = i + 1
    }
    assert(xxh3(buf[7:7 + n]) == xxh3(copy), "subslice at 7, length ${n}")
    assert(xxh3(buf[7:7 + n], 5) == xxh3(copy, 5), "subslice at 7, length ${n}, seed 5")
    n = n + 1
  }
}

test "xxh3 matches the sanity vectors at the stripe, block and 4 KiB boundaries up to 4160" {
  let buf = xxh3Fill(4161)
  let k = 0
  while (k < 33) {
    let n = xxh3LongLens[k]
    let got0 = xxh3(buf[0:n])
    assert(got0 == xxh3Long0[k], "xxh3(len ${n}, seed 0) = ${got0}, want ${xxh3Long0[k]}")
    let got1 = xxh3(buf[0:n], xxh3SeedB)
    assert(
      got1 == xxh3Long1[k],
      "xxh3(len ${n}, seed 0x9E3779B185EBCA8D) = ${got1}, want ${xxh3Long1[k]}",
    )
    k = k + 1
  }
}

test "xxh3 matches all 8322 reference vectors (lengths 0 to 4160, both seeds)" {
  // The fold of every sanity-table row in table order. 0x69d8b256dad0e345 is that fold
  // over the 8322 XSUM_XXH3_testdata rows, and equals the fold of the
  // reference library's own XXH3_64bits over the same inputs.
  let buf = xxh3Fill(4161)
  let acc: u64 = 0
  let rows = 0
  let n = 0
  while (n <= 4160) {
    acc = xxh3Fold(acc, xxh3(buf[0:n]))
    acc = xxh3Fold(acc, xxh3(buf[0:n], xxh3SeedB))
    rows = rows + 2
    n = n + 1
  }
  assert(rows == 8322, "checked ${rows} of 8322 sanity rows")
  assert(acc == 0x69d8b256dad0e345, "fold over lengths 0..4160 = ${acc}, want 0x69d8b256dad0e345")
}

test "xxh3 matches the reference under seeds with high bits set, lengths 241 to 1100" {
  let buf = xxh3Fill(1101)
  let k = 0
  while (k < 6) {
    let acc: u64 = 0
    let n = 241
    while (n <= 1100) {
      acc = xxh3Fold(acc, xxh3(buf[0:n], xxh3Seeds[k]))
      n = n + 1
    }
    assert(
      acc == xxh3LongSeedFolds[k],
      "long fold under seed ${xxh3Seeds[k]} = ${acc}, want ${xxh3LongSeedFolds[k]}",
    )
    k = k + 1
  }
}

test "xxh3 matches the reference on 1 MiB, one-shot" {
  let buf = xxh3Fill(1048576)
  assert(xxh3(buf) == 0x7ade52bbfbd697ba, "xxh3(1 MiB, 0)")
  assert(xxh3(buf, xxh3SeedB) == 0x31146b91b00eb226, "xxh3(1 MiB, 0x9E3779B185EBCA8D)")
  assert(xxh3(buf, 0xdeadbeefcafebabe) == 0xd2893e5b4e1e2f29, "xxh3(1 MiB, 64-bit seed)")
  assert(xxh3(buf[0:1048575]) == 0xa385619e65f467fc, "xxh3(1 MiB - 1, 0)")
  assert(xxh3(buf[0:1000000]) == 0x1c6870b003c0180e, "xxh3(1000000, 0)")
}

// Hashes `data` in chunks of `size` bytes (the last one shorter).
fn xxh3Chunked(data: []byte, size: int, seed: u64): u64 {
  let h = Xxh3(seed)
  let i = 0
  while (i < len(data)) {
    let e = i + size
    if (e > len(data)) {
      e = len(data)
    }
    h.update(data[i:e])
    i = e
  }
  return h.digest()
}

test "Xxh3 streamed in chunks of 1, 7, 63, 64, 65, 240, 241, 1023, 1024 and 1025 bytes equals the one-shot hash" {
  let buf = xxh3Fill(5000)
  let sizes: [10]int = [10]int{ 1, 7, 63, 64, 65, 240, 241, 1023, 1024, 1025 }
  let want0 = xxh3(buf)
  let want1 = xxh3(buf, xxh3SeedB)
  let k = 0
  while (k < 10) {
    let got0 = xxh3Chunked(buf, sizes[k], 0)
    assert(got0 == want0, "chunks of ${sizes[k]}, seed 0: ${got0}, want ${want0}")
    let got1 = xxh3Chunked(buf, sizes[k], xxh3SeedB)
    assert(got1 == want1, "chunks of ${sizes[k]}, seed B: ${got1}, want ${want1}")
    k = k + 1
  }
}

test "Xxh3 streamed over 1 MiB equals the reference" {
  let buf = xxh3Fill(1048576)
  // 4097 is the chunking the reference's own XXH3_64bits_update produced 0x7ade52bbfbd697ba with.
  assert(xxh3Chunked(buf, 4097, 0) == 0x7ade52bbfbd697ba, "1 MiB in 4097-byte chunks, seed 0")
  assert(xxh3Chunked(buf, 65536, xxh3SeedB) == 0x31146b91b00eb226, "1 MiB in 64 KiB chunks, seed B")
  assert(
    xxh3Chunked(buf, 63, 0xdeadbeefcafebabe) == 0xd2893e5b4e1e2f29,
    "1 MiB in 63-byte chunks, 64-bit seed",
  )
}

test "Xxh3 digest after every prefix length up to 1100 equals the one-shot hash" {
  let buf = xxh3Fill(1100)
  let h = Xxh3(xxh3SeedB)
  let n = 0
  while (n <= 1100) {
    let got = h.digest()
    let want = xxh3(buf[0:n], xxh3SeedB)
    assert(got == want, "digest after ${n} bytes = ${got}, want ${want}")
    if (n < 1100) {
      h.update(buf[n:n + 1])
    }
    n = n + 1
  }
}

test "Xxh3 split in two at every point of 1100 bytes equals the one-shot hash" {
  let buf = xxh3Fill(1100)
  let want = xxh3(buf)
  let cut = 0
  while (cut <= 1100) {
    let h = Xxh3()
    h.update(buf[0:cut])
    h.update(buf[cut:1100])
    let got = h.digest()
    assert(got == want, "split at ${cut}: ${got}, want ${want}")
    cut = cut + 1
  }
}

test "Xxh3 split in three at the 64, 240, 256 and 1024 byte boundaries equals the one-shot hash" {
  let buf = xxh3Fill(1300)
  let want0 = xxh3(buf)
  let want1 = xxh3(buf, 7)
  let pts: [18]int = [18]int{
    0,
    1,
    63,
    64,
    65,
    127,
    128,
    129,
    239,
    240,
    241,
    255,
    256,
    257,
    1023,
    1024,
    1025,
    1088,
  }
  let a = 0
  while (a < 18) {
    let b = a
    while (b < 18) {
      let h0 = Xxh3()
      let h1 = Xxh3(7)
      h0.update(buf[0:pts[a]])
      h1.update(buf[0:pts[a]])
      h0.update(buf[pts[a]:pts[b]])
      h1.update(buf[pts[a]:pts[b]])
      h0.update(buf[pts[b]:1300])
      h1.update(buf[pts[b]:1300])
      assert(h0.digest() == want0, "split at ${pts[a]} and ${pts[b]}, seed 0")
      assert(h1.digest() == want1, "split at ${pts[a]} and ${pts[b]}, seed 7")
      b = b + 1
    }
    a = a + 1
  }
}

test "Xxh3 matches the reference on the sanity vectors at lengths 0 to 240 in one update" {
  let buf = xxh3Fill(241)
  let n = 0
  while (n <= 240) {
    let h = Xxh3(xxh3SeedB)
    h.update(buf[0:n])
    assert(h.digest() == xxh3Sanity1[n], "Xxh3 over ${n} bytes, seed B")
    n = n + 1
  }
}

test "Xxh3 digest does not consume the hasher and reset restarts it" {
  let buf = xxh3Fill(700)
  let h = Xxh3(3)
  h.update(buf[0:300])
  let first = h.digest()
  assert(h.digest() == first, "digest twice")
  h.update(buf[300:700])
  assert(h.digest() == xxh3(buf, 3), "digest after more input")
  h.reset()
  assert(h.digest() == xxh3(buf[0:0], 3), "digest after reset is the empty hash")
  h.update(buf[0:300])
  assert(h.digest() == first, "same input after reset")
}

test "Xxh3 ignores empty updates" {
  let buf = xxh3Fill(500)
  let h = Xxh3()
  h.update(buf[0:0])
  h.update(buf[0:200])
  h.update(buf[200:200])
  h.update(buf[200:500])
  h.update(buf[500:500])
  assert(h.digest() == xxh3(buf), "empty updates between chunks")
}
