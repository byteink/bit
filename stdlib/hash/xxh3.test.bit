// stdlib/hash/xxh3.test.bit — XXH3-64 correctness, one-shot and streaming
// (#6578 short paths, #6593 long path and `Xxh3`).
//
// Every expected value below comes from the reference implementation, none
// from this module:
//   1. The reference repository's own sanity vectors,
//      github.com/Cyan4973/xxHash tests/sanity_test_vectors.h
//      (XSUM_XXH3_testdata), pinned at commit
//      680bf463fa1ca0461b9a7c2dab7556e1f54cf4cf. That table covers every
//      length 0..4160 under seeds 0 and 0x9E3779B185EBCA8D (8322 vectors) over
//      the buffer tests/sanity_test.c fillTestBuffer() builds: byteGen starts
//      at PRIME32 (2654435761), each byte is byteGen >> 56, and byteGen is then
//      multiplied by PRIME64 (11400714785074694797), wrapping. Lengths 0..240
//      (the 0..16, 17..128 and 129..240 byte paths) are listed in full below;
//      241..4160 (the long path) are listed at the stripe, block and 4 KiB
//      boundaries and pinned in full by a fold (see "all 8322 reference
//      vectors" below).
//   2. The same pinned commit's xxhash.h compiled with cc -O2
//      -DXXH_INLINE_ALL, for what the sanity table does not hold: seeds with
//      high bits set (the 4..8 byte path swaps the seed's halves, the others
//      add and subtract it, the long path derives a whole secret from it), the
//      empty input under each, a few ASCII strings, a fold per seed over
//      lengths 0..240 and over 241..1100, and 1 MiB buffers, one-shot and
//      streamed through XXH3_64bits_update. That build's output was checked
//      equal to all 8322 table rows before it was used for anything else.

// The sanity buffer: `n` bytes of fillTestBuffer().
fn xxh3Fill(n: int): []byte {
  let buf: []byte = []byte(n)
  let g: u64 = 2654435761
  let i = 0
  while (i < n) {
    buf[i] = byte(g >> 56)
    g = g * 11400714785074694797
    i = i + 1
  }
  return buf
}

// The sanity table's second seed (XSUM_XXH3_testdata, every odd row).
const xxh3SeedB: u64 = 0x9e3779b185ebca8d

// The table's step: acc = (acc ^ result) * PRIME64_1, a bijection per step, so
// a wrong hash anywhere changes the final value.
fn xxh3Fold(acc: u64, h: u64): u64 {
  return (acc ^ h) * 0x9e3779b185ebca87
}

