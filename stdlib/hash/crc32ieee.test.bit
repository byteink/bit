// stdlib/hash/crc32ieee.test.bit — CRC-32 (IEEE 802.3) correctness (#6568).
//
// Every expected value below comes from outside this module: the CRC
// catalogue's CRC-32/ISO-HDLC check value, and zlib's `crc32()` (Python
// 3-alpine, run in a throwaway container) over the inputs named in each
// test. A table that is merely self-consistent would validate its own
// corrupt entries forever, so no expectation is computed from a table: the
// one computed expectation, `refCrc32ieee`, is bit-at-a-time from the
// polynomial.

import { Rand } from "std/rand"

fn fill251(n: int): []byte {
  let buf: []byte = []byte(n)
  let i = 0
  while (i < n) {
    buf[i] = byte(i % 251)
    i = i + 1
  }
  return buf
}

fn fillMix(n: int): []byte {
  let buf: []byte = []byte(n)
  let i = 0
  while (i < n) {
    buf[i] = byte((i * 7 + (i >> 8) * 13 + (i >> 16) * 31) & 0xff)
    i = i + 1
  }
  return buf
}

test "crc32 of the empty slice is zero" {
  let empty: []byte = []byte(0)
  let got = crc32(empty)
  assert(got == 0, "crc32(empty) = ${got}, want 0")
}

test "crc32 matches the published CRC-32/ISO-HDLC check value" {
  // "123456789" is the catalogue's check input: poly 0x04C11DB7, reflected
  // 0xEDB88320, init/xorout 0xFFFFFFFF, check 0xCBF43926.
  let nine: []byte = []byte{ '1', '2', '3', '4', '5', '6', '7', '8', '9' }
  let got = crc32(nine)
  assert(got == 0xcbf43926, "crc32(\"123456789\") = ${got}, want 3421780262 (0xCBF43926)")
}

test "crc32 matches zlib on short strings (every tail length 1..8 and the 8-byte block path)" {
  assert(crc32([]byte("a")) == 0xe8b7be43, "crc32(a)")
  assert(crc32([]byte("abc")) == 0x352441c2, "crc32(abc)")
  assert(crc32([]byte("Hello world")) == 0x8bd69e52, "crc32(Hello world)")
  assert(crc32([]byte("message digest")) == 0x20159d7f, "crc32(message digest)")
  assert(
    crc32([]byte("The quick brown fox jumps over the lazy dog")) == 0x414fa339,
    "crc32(quick brown fox)",
  )
}

test "crc32 matches zlib on all-zero and all-0xff 32-byte buffers" {
  let zeros: []byte = []byte(32)
  assert(crc32(zeros) == 0x190a55ad, "crc32(32 x 0x00)")
  let ones: []byte = []byte(32)
  let i = 0
  while (i < 32) {
    ones[i] = 0xff
    i = i + 1
  }
  assert(crc32(ones) == 0xff6cab0b, "crc32(32 x 0xff)")
}

test "crc32 matches zlib at lengths straddling the 8-byte block boundary" {
  // fill251(n): byte i is i % 251. zlib.crc32 of the first n bytes.
  let lens: []int = [1, 7, 8, 9, 15, 16, 17, 63, 64, 65, 4095, 4096]
  let want: []u32 = [
    0xd202ef8d, 0xad5809f9, 0x88aa689f, 0xbce14302, 0xa06c675e, 0xcecee288,
    0x2c183a19, 0xdbdea683, 0x100ece8c, 0x40c06fd8, 0xd1a3950a, 0xd465f907,
  ]
  let k = 0
  while (k < len(lens)) {
    let got = crc32(fill251(lens[k]))
    assert(got == want[k], "length ${lens[k]}: crc32 = ${got}, want ${want[k]}")
    k = k + 1
  }
}

test "crc32 matches zlib on 1 MiB of the i % 251 pattern" {
  let got = crc32(fill251(1048576))
  assert(got == 0xef0e6054, "crc32(1 MiB, i % 251) = ${got}, want 0xEF0E6054")
}

test "crc32 matches zlib on 1 MiB of a mixed pattern" {
  let got = crc32(fillMix(1048576))
  assert(got == 0xc162680b, "crc32(1 MiB, mix) = ${got}, want 0xC162680B")
}

test "crc32Update at 200 split points equals the one-shot checksum" {
  // 1 MiB split at 200 points, including 0 and the full length (empty
  // halves) and offsets that are not multiples of 8, so a block can start
  // or end at every residue and chaining crosses the slicing boundary.
  let n = 1048576
  let buf = fillMix(n)
  let whole = crc32(buf)
  assert(whole == 0xc162680b, "whole-buffer crc32 = ${whole}")
  let k = 0
  while (k < 200) {
    let sp = 0
    if (k == 199) {
      sp = n
    } else if (k > 0) {
      sp = (k * 5237 + k * k * 13) % n
    }
    let chained = crc32Update(crc32Update(0, buf[0:sp]), buf[sp:n])
    assert(chained == whole, "split at ${sp}: chained = ${chained}, want ${whole}")
    k = k + 1
  }
}

test "crc32Update over three chunks equals the one-shot checksum" {
  let n = 4096
  let buf = fill251(n)
  let whole = crc32(buf)
  let a = crc32Update(0, buf[0:3])
  let b = crc32Update(a, buf[3:1001])
  let c = crc32Update(b, buf[1001:n])
  assert(c == whole, "three-chunk crc32 = ${c}, want ${whole}")
}

// Bit-at-a-time CRC-32 straight from the reflected polynomial 0xEDB88320:
// no table, so it shares nothing with the implementation under test.
fn refCrc32ieee(seed: u32, data: []byte): u32 {
  let crc = seed ^ 0xffffffff
  for b of data {
    crc = crc ^ u32(b)
    let k = 0
    while (k < 8) {
      let low = crc & 1
      crc = crc >> 1
      if (low != 0) {
        crc = crc ^ 0xedb88320
      }
      k = k + 1
    }
  }
  return crc ^ 0xffffffff
}

test "crc32 matches the bitwise reference at random lengths, seeds and alignments" {
  // Every alignment 0..7 against lengths drawn from 0..4096, so both the
  // 8-byte block path and every 0..7 byte tail start at every address mod 8.
  let r = Rand(6679)
  let buf: []byte = []byte(4096 + 8)
  let i = 0
  while (i < len(buf)) {
    buf[i] = byte(r.intn(256))
    i = i + 1
  }
  let trial = 0
  while (trial < 400) {
    let off = trial % 8
    let n = r.intn(4097)
    let seed = u32(r.intn(0x100000000))
    let s: []byte = buf[off:off + n]
    let want = refCrc32ieee(seed, s)
    let got = crc32Update(seed, s)
    assert(got == want, "off ${off} len ${n} seed ${seed}: got ${got}, want ${want}")
    let soft = crc32ieeeSoft(seed ^ 0xffffffff, s, 0) ^ 0xffffffff
    assert(soft == want, "software path, off ${off} len ${n}: got ${soft}, want ${want}")
    trial = trial + 1
  }
}

test "the CRC-32 join and fold constants are x^k mod P" {
  let p: u32 = 0xedb88320
  assert(refXpow(16351, p) == 0x7b4aa8b7, "x^16351 mod P")
  assert(refXpow(8159, p) == 0xbbf2f6d6, "x^8159 mod P")
  // The fold's constants are shifted left one (crc32hw.bit).
  assert((u64(refXpow(544, p)) << 1) == 0x154442bd4, "x^544 mod P")
  assert((u64(refXpow(480, p)) << 1) == 0x1c6e41596, "x^480 mod P")
  assert((u64(refXpow(160, p)) << 1) == 0x1751997d0, "x^160 mod P")
  assert((u64(refXpow(96, p)) << 1) == 0xccaa009e, "x^96 mod P")
  assert((u64(refXpow(64, p)) << 1) == 0x163cd6124, "x^64 mod P")
}

test "crc32 matches the bitwise reference at every hardware split length" {
  // `crcSplitLengths` is crc32.test.bit's: one list for both variants.
  let r = Rand(6839)
  let buf: []byte = []byte(200007 + 8)
  let i = 0
  while (i < len(buf)) {
    buf[i] = byte(r.intn(256))
    i = i + 1
  }
  for n of crcSplitLengths() {
    for off of [0, 3] {
      let seed = u32(r.intn(0x100000000))
      let s: []byte = buf[off:off + n]
      let want = refCrc32ieee(seed, s)
      let got = crc32Update(seed, s)
      assert(got == want, "off ${off} len ${n} seed ${seed}: got ${got}, want ${want}")
    }
  }
}
