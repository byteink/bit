// stdlib/hash/crc32.test.bit — CRC-32C correctness (#4015).
//
// A checksum implementation that is merely self-consistent is worse than no
// checksum at all: it will happily validate its own corrupt table forever.
// So the load-bearing case here is the published CRC-32/ISCSI check value
// (from the CRC catalogue, not derived from this file), never this module's
// own output compared against itself.

import { Rand } from "std/rand"

test "crc32c of the empty slice is zero" {
  let empty: []byte = []byte(0)
  let got = crc32c(empty)
  assert(got == 0, "crc32c(empty) = ${got}, want 0")
}

test "crc32c matches the published CRC-32/ISCSI check value" {
  // The nine ASCII digits "123456789" — the standard check-value input for
  // every CRC in the catalogue — must checksum to 0xE3069283 under CRC-32C
  // (poly 0x1EDC6F41, reflected 0x82F63B78, init/xorout 0xFFFFFFFF). This
  // constant comes from the catalogue, not from this implementation: if the
  // table were subtly wrong, this is the one case that says so.
  let nine: []byte = []byte{ '1', '2', '3', '4', '5', '6', '7', '8', '9' }
  let got = crc32c(nine)
  assert(got == 0xe3069283, "crc32c(\"123456789\") = ${got}, want 3808858755 (0xE3069283)")
}

test "crc32cUpdate chaining across a split equals crc32c of the whole" {
  // A deterministic, non-repeating fill: an all-zero or all-repeating buffer
  // could hide a byte-order or indexing bug that a varied one would catch.
  let n = 4096
  let buf: []byte = []byte(n)
  let i = 0
  while (i < n) {
    buf[i] = byte(i % 251)
    i = i + 1
  }
  let whole = crc32c(buf)

  // Split points spanning both ends, including a ZERO-LENGTH first half —
  // the case the seeded update form exists for: a page checksum computed
  // over a header and a body without concatenating them first.
  let splits: []int = [0, 1, 2000, n]
  for sp of splits {
    let first: []byte = buf[0:sp]
    let second: []byte = buf[sp:n]
    let chained = crc32cUpdate(crc32cUpdate(0, first), second)
    assert(
      chained == whole,
      "split at ${sp}: chained = ${chained}, want ${whole} (whole-buffer crc32c)",
    )
  }
}

test "a single bit flip anywhere in a 4096-byte buffer changes the checksum" {
  let n = 4096
  let buf: []byte = []byte(n)
  let i = 0
  while (i < n) {
    buf[i] = byte(i % 251)
    i = i + 1
  }
  let base = crc32c(buf)

  // Seeded, not wall-clock: a failure must be reproducible by replaying this
  // same seed (std/rand's own header states this property).
  let r = Rand(4015)
  let totalBits = n * 8
  let trial = 0
  while (trial < 64) {
    let pos = r.intn(totalBits)
    let byteIdx = pos / 8
    let bitIdx = pos % 8
    let mask = byte(1 << bitIdx)
    buf[byteIdx] = buf[byteIdx] ^ mask
    let flipped = crc32c(buf)
    assert(
      flipped != base,
      "bit ${pos} (byte ${byteIdx}, bit ${bitIdx}): checksum unchanged after flip",
    )
    buf[byteIdx] = buf[byteIdx] ^ mask // restore for the next draw
    trial = trial + 1
  }
}

// Bit-at-a-time CRC-32C straight from the reflected polynomial 0x82F63B78:
// no table, so it shares nothing with the implementation under test.
fn refCrc32c(seed: u32, data: []byte): u32 {
  let crc = seed ^ 0xffffffff
  for b of data {
    crc = crc ^ u32(b)
    let k = 0
    while (k < 8) {
      let low = crc & 1
      crc = crc >> 1
      if (low != 0) {
        crc = crc ^ 0x82f63b78
      }
      k = k + 1
    }
  }
  return crc ^ 0xffffffff
}

test "crc32c matches the bitwise reference at random lengths, seeds and alignments" {
  // Every alignment 0..7 against lengths drawn from 0..4096, so both the
  // 8-byte block path and every 0..7 byte tail start at every address mod 8.
  let r = Rand(6678)
  let buf: []byte = []byte(4096 + 8)
  let i = 0
  while (i < len(buf)) {
    buf[i] = byte(r.intn(256))
    i = i + 1
  }
  let trial = 0
  while (trial < 400) {
    let off = trial % 8
    let n = r.intn(4097)
    let seed = u32(r.intn(0x100000000))
    let s: []byte = buf[off:off + n]
    let want = refCrc32c(seed, s)
    let got = crc32cUpdate(seed, s)
    assert(got == want, "off ${off} len ${n} seed ${seed}: got ${got}, want ${want}")
    let soft = crc32cSoft(seed ^ 0xffffffff, s, 0) ^ 0xffffffff
    assert(soft == want, "software path, off ${off} len ${n}: got ${soft}, want ${want}")
    trial = trial + 1
  }
}

// Lengths at the edges of every hardware split (crc32hw.bit): the 8-byte
// block, the 64-byte fold block, the 3 KiB three-lane block and its 63 KiB
// asm call, the 64 KiB one-stream chunk, and runs that cross several of each.
// A function, not a module `let`: a module value in a test file becomes a
// startup initializer in every program that imports std/hash.
fn crcSplitLengths(): []int {
  return [
    7, 8, 63, 64, 65, 127, 128, 1023, 1024, 3071, 3072, 3073, 3079, 3080, 6143,
    6144, 6151, 9216, 64511, 64512, 64513, 64519, 64520, 65535, 65536, 65537,
    65600, 129024, 132103, 196608, 200007,
  ]
}

// x^k mod P for the reflected polynomial `rpoly`, bit-reflected the way the
// CRC state is: x^0 is bit 31.
fn refXpow(k: int, rpoly: u32): u32 {
  let v: u32 = 0x80000000
  let i = 0
  while (i < k) {
    let low = v & 1
    v = v >> 1
    if (low != 0) {
      v = v ^ rpoly
    }
    i = i + 1
  }
  return v
}

test "the CRC-32C three-lane join constants are x^16351 and x^8159 mod P" {
  assert(refXpow(16351, 0x82f63b78) == 0xa51b6135, "x^16351 mod P")
  assert(refXpow(8159, 0x82f63b78) == 0x170076fa, "x^8159 mod P")
}

test "crc32c matches the bitwise reference at every hardware split length" {
  let r = Rand(6838)
  let buf: []byte = []byte(200007 + 8)
  let i = 0
  while (i < len(buf)) {
    buf[i] = byte(r.intn(256))
    i = i + 1
  }
  for n of crcSplitLengths() {
    for off of [0, 3] {
      let seed = u32(r.intn(0x100000000))
      let s: []byte = buf[off:off + n]
      let want = refCrc32c(seed, s)
      let got = crc32cUpdate(seed, s)
      assert(got == want, "off ${off} len ${n} seed ${seed}: got ${got}, want ${want}")
    }
  }
}
