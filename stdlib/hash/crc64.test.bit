// stdlib/hash/crc64.test.bit — CRC-64/NVME correctness (#6569).
//
// Every expected value below comes from outside this module, in three tiers:
//   1. The CRC RevEng catalogue entry for CRC-64/NVME: check value
//      0xAE8B14860A799888, residue 0xF310303B2B6F6E42, and its four
//      4096-byte codewords (byte patterns 00, FF, i and 4095-i, each
//      followed by the CRC in little-endian byte order).
//   2. The AWS SDKs' own vectors: aws-sdk-js-v3 Crc64Nvme.spec.ts (the
//      base64 digests, decoded to big-endian u64) and awslabs/aws-checksums
//      tests/crc64_test.c (32 zero bytes, bytes 0..31).
//   3. A bit-at-a-time Python reference (the shift-and-xor loop of
//      aws-checksums' crc64nvme_reference, poly 0x9A6C9329AC4BC9B5) for the
//      lengths and 1 MiB buffers; it reproduces every vector in tiers 1
//      and 2 before being trusted for tier 3.
// A table that is merely self-consistent would validate its own corrupt
// entries forever, so no expectation is computed by this file.

// fill251 and fillMix are shared with crc32ieee.test.bit (one module, one
// scope).

fn fillConst(n: int, v: int): []byte {
  let buf: []byte = []byte(n)
  let i = 0
  while (i < n) {
    buf[i] = byte(v)
    i = i + 1
  }
  return buf
}

test "crc64nvme of the empty slice is zero" {
  let empty: []byte = []byte(0)
  let got = crc64nvme(empty)
  assert(got == 0, "crc64nvme(empty) = ${got}, want 0")
}

test "crc64nvme matches the published CRC-64/NVME check value" {
  // "123456789" is the catalogue's check input: poly 0xAD93D23594C93659,
  // init/xorout all-ones, reflected, check 0xAE8B14860A799888. The same
  // value is KNOWN_CRC64NVME_TEST_VECTOR in aws-checksums and "rosUhgp5mIg="
  // in the aws-sdk-js-v3 spec.
  let nine: []byte = []byte{ '1', '2', '3', '4', '5', '6', '7', '8', '9' }
  let got = crc64nvme(nine)
  assert(got == 0xae8b14860a799888, "crc64nvme(\"123456789\") = ${got}, want 0xAE8B14860A799888")
}

test "crc64nvme matches the aws-sdk-js-v3 string vectors" {
  assert(crc64nvme([]byte("a")) == 0x8c2f8445b4cbfc3c, "crc64nvme(a)")
  assert(crc64nvme([]byte("abc")) == 0x05e5cabb3fc1faeb, "crc64nvme(abc)")
  assert(
    crc64nvme([]byte("The quick brown fox jumps over the lazy dog")) == 0xd76c54054954c143,
    "crc64nvme(quick brown fox)",
  )
  assert(crc64nvme(fillConst(1, 0x00)) == 0xd5da5047efec8728, "crc64nvme(00)")
  assert(crc64nvme(fillConst(4, 0x00)) == 0x6db811e5a1da5024, "crc64nvme(00 x 4)")
  // The SDK spec feeds "\xFF\xFF\xFF\xFF" through TextEncoder, which is
  // UTF-8: eight bytes, C3 BF four times.
  let utf8: []byte = []byte{ 0xc3, 0xbf, 0xc3, 0xbf, 0xc3, 0xbf, 0xc3, 0xbf }
  assert(crc64nvme(utf8) == 0x76a032c076e8105d, "crc64nvme(UTF-8 of four U+00FF)")
}

test "crc64nvme matches the aws-sdk-js-v3 single-byte vectors" {
  assert(crc64nvme(fillConst(1, 0x01)) == 0xaab4a08fdfd90e51, "crc64nvme(01)")
  assert(crc64nvme(fillConst(1, 0xff)) == 0xff00000000000000, "crc64nvme(ff)")
  assert(crc64nvme(fillConst(1, 0x41)) == 0x7dee7a32a5b7233e, "crc64nvme(41)")
  assert(crc64nvme(fillConst(1, 0x61)) == 0x8c2f8445b4cbfc3c, "crc64nvme(61)")
}

test "crc64nvme matches the aws-checksums vectors" {
  let zeros: []byte = fillConst(32, 0)
  assert(crc64nvme(zeros) == 0xcf3473434d4ecf3b, "crc64nvme(32 x 0x00)")
  let seq: []byte = []byte(32)
  let i = 0
  while (i < 32) {
    seq[i] = byte(i)
    i = i + 1
  }
  assert(crc64nvme(seq) == 0xb9d9d4a8492cbd7f, "crc64nvme(0..31)")
}

// The CRC of `data` followed by its own CRC (little-endian, the reflected
// byte order) always lands on one constant: the catalogue's residue
// 0xF310303B2B6F6E42 before xorout, so 0x0CEFCFC4D49091BD after it.
fn withTrailer(data: []byte): []byte {
  let n = len(data)
  let crc = crc64nvme(data)
  let out: []byte = []byte(n + 8)
  let i = 0
  while (i < n) {
    out[i] = data[i]
    i = i + 1
  }
  let k = 0
  while (k < 8) {
    out[n + k] = byte((crc >> u64(8 * k)) & 0xff)
    k = k + 1
  }
  return out
}

test "crc64nvme of data followed by its CRC is the catalogue residue" {
  let want: u64 = 0x0cefcfc4d49091bd
  let nine: []byte = []byte{ '1', '2', '3', '4', '5', '6', '7', '8', '9' }
  assert(crc64nvme(withTrailer(nine)) == want, "residue over 123456789")
  assert(crc64nvme(withTrailer(fill251(1000))) == want, "residue over 1000 bytes")
  assert(crc64nvme(withTrailer(fillMix(4096))) == want, "residue over 4096 bytes")
}

test "crc64nvme matches the four catalogue codewords" {
  // Each codeword is 4096 payload bytes then the 8 CRC bytes; the catalogue
  // prints those 8 bytes in transmission order, so the u64 below is that
  // byte string read little-endian.
  let pat: []byte = []byte(4096)
  let rev: []byte = []byte(4096)
  let i = 0
  while (i < 4096) {
    pat[i] = byte(i)
    rev[i] = byte(4095 - i)
    i = i + 1
  }
  assert(crc64nvme(fillConst(4096, 0x00)) == 0x6482d367eb22b64e, "codeword 00 x 4096")
  assert(crc64nvme(fillConst(4096, 0xff)) == 0xc0ddba7302eca3ac, "codeword FF x 4096")
  assert(crc64nvme(pat) == 0x3e729f5f6750449c, "codeword i x 4096")
  assert(crc64nvme(rev) == 0x9a2df64b8e9e517e, "codeword (4095-i) x 4096")
}

test "crc64nvme matches the reference at lengths straddling the 8-byte block boundary" {
  // fill251(n): byte i is i % 251.
  let lens: []int = [7, 8, 9, 15, 16, 17, 63, 64, 65, 1000]
  let want: []u64 = [
    0x1614f266082ec7a3,
    0x7703cc98ac9209d7,
    0x0eb6fdbb89d04d0b,
    0x555fd71d5814a5e7,
    0xcf6454c75df95620,
    0x5c34355fb173cefd,
    0x05e1746b5d43bc84,
    0xe13ddeba8972d85c,
    0xc2a59b652d8ed28b,
    0x3a2d3571b6998416,
  ]
  let k = 0
  while (k < len(lens)) {
    let got = crc64nvme(fill251(lens[k]))
    assert(got == want[k], "length ${lens[k]}: crc64nvme = ${got}, want ${want[k]}")
    k = k + 1
  }
}

test "crc64nvme matches the reference on 1 MiB of two patterns" {
  let a = crc64nvme(fill251(1048576))
  assert(a == 0x8821d9f150fec9fc, "crc64nvme(1 MiB, i % 251) = ${a}, want 0x8821D9F150FEC9FC")
  let b = crc64nvme(fillMix(1048576))
  assert(b == 0xe5b6c41d0f5e70c1, "crc64nvme(1 MiB, mix) = ${b}, want 0xE5B6C41D0F5E70C1")
}

test "crc64nvmeUpdate at 200 split points equals the one-shot checksum" {
  // 1 MiB split at 200 points, including 0 and the full length (empty
  // halves) and offsets that are not multiples of 8, so a block can start
  // or end at every residue and chaining crosses the slicing boundary.
  let n = 1048576
  let buf = fillMix(n)
  let whole = crc64nvme(buf)
  assert(whole == 0xe5b6c41d0f5e70c1, "whole-buffer crc64nvme = ${whole}")
  let k = 0
  while (k < 200) {
    let sp = 0
    if (k == 199) {
      sp = n
    } else if (k > 0) {
      sp = (k * 5237 + k * k * 13) % n
    }
    let chained = crc64nvmeUpdate(crc64nvmeUpdate(0, buf[0:sp]), buf[sp:n])
    assert(chained == whole, "split at ${sp}: chained = ${chained}, want ${whole}")
    k = k + 1
  }
}

test "crc64nvmeUpdate byte by byte equals the one-shot checksum" {
  // The aws-sdk-js-v3 'incremental updates' case: "123456789" one byte at a
  // time must give the check value, which exercises only the tail path.
  let nine: []byte = []byte{ '1', '2', '3', '4', '5', '6', '7', '8', '9' }
  let crc: u64 = 0
  let i = 0
  while (i < 9) {
    crc = crc64nvmeUpdate(crc, nine[i:i + 1])
    i = i + 1
  }
  assert(crc == 0xae8b14860a799888, "byte-at-a-time crc = ${crc}, want 0xAE8B14860A799888")
}

test "crc64nvmeUpdate over three chunks equals the one-shot checksum" {
  let n = 4096
  let buf = fill251(n)
  let whole = crc64nvme(buf)
  let a = crc64nvmeUpdate(0, buf[0:3])
  let b = crc64nvmeUpdate(a, buf[3:1001])
  let c = crc64nvmeUpdate(b, buf[1001:n])
  assert(c == whole, "three-chunk crc64nvme = ${c}, want ${whole}")
}
