// Bit standard library — hash module, xxHash64.
//
// xxHash64 IS A NON-CRYPTOGRAPHIC HASH, NOT AN INTEGRITY OR SECURITY
// PRIMITIVE. It is fast and well mixed, which makes it right for hash tables,
// sharding, deduplication and the S3 `XXHASH64` checksum algorithm, and wrong
// for anything an adversary may influence: anyone who knows the seed can
// construct colliding inputs. For that use `std/crypto`'s SHA-256 or HMAC
// (see crc32.bit's header for why checksums live in `std/hash`).
//
// THE ALGORITHM is Yann Collet's XXH64 (github.com/Cyan4973/xxHash, the
// "xxHash Algorithm Specification" in doc/xxhash_spec.md), little-endian
// reads, 64-bit seed, 64-bit result. Inputs of 32 bytes or more run four
// independent accumulators over 32-byte stripes (one multiply-rotate-multiply
// round per 8-byte lane, the four chains overlapping instead of forming one
// serial dependency), converge them, then fold the 0..31 byte remainder in
// 8-, 4- and 1-byte steps; shorter inputs start straight at the remainder.
// Every path ends in the same avalanche. The five 64-bit primes below are
// the specification's PRIME64_1..5.
//
// ONE-SHOT AND STREAMING SHARE ONE STRIPE LOOP AND ONE TAIL. `xxhash64` and
// `Xxhash64.digest` differ only in where the four accumulators and the
// remainder live, so streaming equals one-shot for any chunking by
// construction, and xxhash64.test.bit proves it at every split point.
//
// Correctness is pinned by the reference implementation's own sanity vectors
// (see xxhash64.test.bit), none of which come from this file.

const xxP1: u64 = 0x9e3779b185ebca87
const xxP2: u64 = 0xc2b2ae3d27d4eb4f
const xxP3: u64 = 0x165667b19e3779f9
const xxP4: u64 = 0x85ebca77c2b2ae63
const xxP5: u64 = 0x27d4eb2f165667c5

// Bytes per stripe: four 8-byte lanes, one per accumulator.
const xxStripe: int = 32

fn xxRotl(x: u64, r: u64): u64 {
  return (x << r) | (x >> (64 - r))
}

// One accumulator round: fold the lane `input` into `acc`.
fn xxRound(acc: u64, input: u64): u64 {
  return xxRotl(acc + input * xxP2, 31) * xxP1
}

// Folds an accumulator into the converged hash.
fn xxMerge(h: u64, v: u64): u64 {
  return (h ^ xxRound(0, v)) * xxP1 + xxP4
}

// Little-endian u64 at `data[i..i+8]`; the caller guarantees `i + 8 <= len(data)`.
fn xxRead64(data: []byte, i: int): u64 {
  return u64(data[i]) |
    (u64(data[i + 1]) << 8) |
    (u64(data[i + 2]) << 16) |
    (u64(data[i + 3]) << 24) |
    (u64(data[i + 4]) << 32) |
    (u64(data[i + 5]) << 40) |
    (u64(data[i + 6]) << 48) |
    (u64(data[i + 7]) << 56)
}

// Little-endian u32 at `data[i..i+4]`; the caller guarantees `i + 4 <= len(data)`.
fn xxRead32(data: []byte, i: int): u64 {
  return u64(data[i]) |
    (u64(data[i + 1]) << 8) |
    (u64(data[i + 2]) << 16) |
    (u64(data[i + 3]) << 24)
}

// The four accumulators' initial values for `seed`, as a fresh 4-word state.
fn xxInit(seed: u64): []u64 {
  let v = []u64(4)
  xxReset(v, seed)
  return v
}

// Rewinds the 4-word accumulator state `v` to the start of a `seed` hash.
fn xxReset(v: []u64, seed: u64) {
  v[0] = seed + xxP1 + xxP2
  v[1] = seed + xxP2
  v[2] = seed
  v[3] = seed - xxP1
}

// Absorbs whole 32-byte stripes of `data[from..end]` into `v`, returning the
// index after the last stripe consumed (`from + 32 * k`). The accumulators run
// in locals so they stay in registers across the loop.
fn xxStripes(v: []u64, data: []byte, from: int, end: int): int {
  let v1 = v[0]
  let v2 = v[1]
  let v3 = v[2]
  let v4 = v[3]
  let i = from
  while (i + xxStripe <= end) {
    v1 = xxRound(v1, xxRead64(data, i))
    v2 = xxRound(v2, xxRead64(data, i + 8))
    v3 = xxRound(v3, xxRead64(data, i + 16))
    v4 = xxRound(v4, xxRead64(data, i + 24))
    i = i + xxStripe
  }
  v[0] = v1
  v[1] = v2
  v[2] = v3
  v[3] = v4
  return i
}

// Converges the four accumulators of a hash that saw at least one stripe.
fn xxConverge(v: []u64): u64 {
  let h = xxRotl(v[0], 1) + xxRotl(v[1], 7) + xxRotl(v[2], 12) + xxRotl(v[3], 18)
  h = xxMerge(h, v[0])
  h = xxMerge(h, v[1])
  h = xxMerge(h, v[2])
  return xxMerge(h, v[3])
}

// Folds the remainder `data[i..end]` (fewer than 32 bytes) into `h` and
// finishes with the avalanche. `h` already includes the total input length.
fn xxFinish(h0: u64, data: []byte, from: int, end: int): u64 {
  let h = h0
  let i = from
  while (i + 8 <= end) {
    h = xxRotl(h ^ xxRound(0, xxRead64(data, i)), 27) * xxP1 + xxP4
    i = i + 8
  }
  if (i + 4 <= end) {
    h = xxRotl(h ^ (xxRead32(data, i) * xxP1), 23) * xxP2 + xxP3
    i = i + 4
  }
  while (i < end) {
    h = xxRotl(h ^ (u64(data[i]) * xxP5), 11) * xxP1
    i = i + 1
  }
  h = (h ^ (h >> 33)) * xxP2
  h = (h ^ (h >> 29)) * xxP3
  return h ^ (h >> 32)
}

// xxHash64 of `data` under `seed`. With the default seed 0 it equals the
// reference `XXH64(data, len, 0)`; the empty slice hashes to
// `0xEF46DB3751D8E999`. The seed is the full 64 bits, as in the reference.
export fn xxhash64(data: []byte, seed: u64 = 0): u64 {
  let n = len(data)
  if (n < xxStripe) {
    return xxFinish(seed + xxP5 + u64(n), data, 0, n)
  }
  let v = xxInit(seed)
  let i = xxStripes(v, data, 0, n)
  return xxFinish(xxConverge(v) + u64(n), data, i, n)
}

// A streaming xxHash64 hasher: feed any number of chunks with `update`, read
// the hash with `digest`. The result equals `xxhash64` of the concatenation
// of every chunk, however the bytes were split, including empty chunks.
// `Xxhash64()` hashes under seed 0; `Xxhash64(seed)` under that seed.
export class Xxhash64 {
  seed: u64
  v: []u64
  buf: []byte
  bufLen: int
  total: u64

  init(seed: u64 = 0) {
    this.seed = seed
    this.v = xxInit(seed)
    this.buf = []byte(32)
    this.bufLen = 0
    this.total = 0
  }

  // Absorbs `data`. Bytes that do not fill a 32-byte stripe wait in the
  // internal buffer for the next call or for `digest`.
  export update(data: []byte) {
    let n = len(data)
    this.total = this.total + u64(n)
    let i = 0
    if (this.bufLen > 0) {
      while (i < n && this.bufLen < xxStripe) {
        this.buf[this.bufLen] = data[i]
        this.bufLen = this.bufLen + 1
        i = i + 1
      }
      if (this.bufLen < xxStripe) {
        return
      }
      let _ = xxStripes(this.v, this.buf, 0, xxStripe)
      this.bufLen = 0
    }
    i = xxStripes(this.v, data, i, n)
    while (i < n) {
      this.buf[this.bufLen] = data[i]
      this.bufLen = this.bufLen + 1
      i = i + 1
    }
  }

  // The hash of everything absorbed so far. Does not consume the hasher:
  // more `update` calls may follow and a later `digest` covers them too.
  export digest(): u64 {
    if (this.total < u64(xxStripe)) {
      return xxFinish(this.seed + xxP5 + this.total, this.buf, 0, this.bufLen)
    }
    return xxFinish(xxConverge(this.v) + this.total, this.buf, 0, this.bufLen)
  }

  // Rewinds to the empty input under the same seed, so one hasher can hash
  // many messages.
  export reset() {
    xxReset(this.v, this.seed)
    this.bufLen = 0
    this.total = 0
  }
}
