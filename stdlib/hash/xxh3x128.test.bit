}

// The table's expected result for boundary length index `j` under sanity seed `k`.
fn xxh3x128Want(k: int, j: int): Hash128 {
  if (k == 0) {
    return Hash128{ hi = xxh3x128BHi0[j], lo = xxh3x128BLo0[j] }
  }
  if (k == 1) {
    return Hash128{ hi = xxh3x128BHi1[j], lo = xxh3x128BLo1[j] }
  }
  return Hash128{ hi = xxh3x128BHi2[j], lo = xxh3x128BLo2[j] }
}

fn xxh3x128Show(h: Hash128): string {
  return "hi ${h.hi} lo ${h.lo}"
}

test "xxh3x128 of the empty input matches the reference, and the canonical form is hi then lo big-endian" {
  let empty: []byte = []byte(0)
  let h = xxh3x128(empty)
  assert(h.hi == 0x99aa06d3014798d8, "empty hi: ${h.hi}")
  assert(h.lo == 0x6001c324468d497f, "empty lo: ${h.lo}")
  let b = h.bytes()
  assert(len(b) == 16, "canonical form is 16 bytes")
  let want: [16]byte = [16]byte{
    0x99, 0xaa, 0x06, 0xd3, 0x01, 0x47, 0x98, 0xd8,
    0x60, 0x01, 0xc3, 0x24, 0x46, 0x8d, 0x49, 0x7f,
  }
  let i = 0
  while (i < 16) {
    assert(b[i] == want[i], "canonical byte ${i}: ${b[i]}")
    i = i + 1
  }
  assert(xxh3x128(empty, 0).equals(h), "explicit seed 0 equals the default")
  assert(!xxh3x128(empty, 1).equals(h), "seed 1 differs from seed 0")
}

test "xxh3x128 of the empty input matches the reference under seeds with high bits set" {
  let empty: []byte = []byte(0)
  let k = 0
  while (k < 6) {
    let h = xxh3x128(empty, xxh3x128Seeds[k])
    assert(h.lo == xxh3x128Empty[2 * k], "empty, seed ${xxh3x128Seeds[k]}: lo ${h.lo}")
    assert(h.hi == xxh3x128Empty[2 * k + 1], "empty, seed ${xxh3x128Seeds[k]}: hi ${h.hi}")
    k = k + 1
  }
}

test "xxh3x128 matches the reference on ASCII strings and 64-bit seeds" {
  let strs: []string = [
    "a",
    "abc",
    "123456789",
    "The quick brown fox jumps over the lazy dog",
  ]
  let s = 0
  while (s < 4) {
    let data = []byte(strs[s])
    let k = 0
    while (k < 7) {
      let seed: u64 = 0
      if (k > 0) {
        seed = xxh3x128Seeds[k - 1]
      }
      let h = xxh3x128(data, seed)
      let at = 14 * s + 2 * k
      assert(h.lo == xxh3x128Strs[at], "${strs[s]}, seed ${seed}: lo ${h.lo}")
      assert(h.hi == xxh3x128Strs[at + 1], "${strs[s]}, seed ${seed}: hi ${h.hi}")
      k = k + 1
    }
    s = s + 1
  }
}

test "xxh3x128 matches the sanity vectors at the 60 path boundary lengths, all three seeds" {
  let buf = xxh3x128Fill(4161)
  let rows = 0
  let k = 0
  while (k < 3) {
    let j = 0
    while (j < 60) {
      let n = xxh3x128BLens[j]
      let got = xxh3x128(buf[0:n], xxh3x128SanitySeeds[k])
      let want = xxh3x128Want(k, j)
      assert(
        got.equals(want),
        "len ${n}, seed ${xxh3x128SanitySeeds[k]}: ${xxh3x128Show(got)}, want ${xxh3x128Show(want)}",
      )
      rows = rows + 1
      j = j + 1
    }
    k = k + 1
  }
  assert(rows == 180, "checked ${rows} of 180 boundary rows")
}

test "xxh3x128 matches all 723 reference vectors (lengths 0 to 240, three seeds)" {
  // The fold of the first 723 XSUM_XXH128_testdata rows: the 0..16, 17..128 and
  // 129..240 byte paths. It equals the fold of the reference library's own
  // XXH3_128bits_withSeed over the same inputs.
  let buf = xxh3x128Fill(241)
  let acc: u64 = 0
  let rows = 0
  let n = 0
  while (n <= 240) {
    let k = 0
    while (k < 3) {
      acc = xxh3x128Fold(acc, xxh3x128(buf[0:n], xxh3x128SanitySeeds[k]))
      rows = rows + 1
      k = k + 1
    }
    n = n + 1
  }
  assert(rows == 723, "checked ${rows} of 723 sanity rows")
  assert(acc == 0x74d07100e75d5ca4, "fold over lengths 0..240 = ${acc}, want 0x74d07100e75d5ca4")
}

test "xxh3x128 matches all 12483 reference vectors (lengths 0 to 4160, three seeds)" {
  // The fold of every XSUM_XXH128_testdata row in table order. 0x223986e1c6aaa0b5 is
  // that fold over the table's own rows, and equals the fold of the reference
  // library's XXH3_128bits_withSeed over the same inputs.
  let buf = xxh3x128Fill(4161)
  let acc: u64 = 0
  let rows = 0
  let n = 0
  while (n <= 4160) {
    let k = 0
    while (k < 3) {
      acc = xxh3x128Fold(acc, xxh3x128(buf[0:n], xxh3x128SanitySeeds[k]))
      rows = rows + 1
      k = k + 1
    }
    n = n + 1
  }
  assert(rows == 12483, "checked ${rows} of 12483 sanity rows")
  assert(acc == 0x223986e1c6aaa0b5, "fold over lengths 0..4160 = ${acc}, want 0x223986e1c6aaa0b5")
}

test "xxh3x128 matches the reference under seeds with high bits set, lengths 0 to 240 and 241 to 1100" {
  let buf = xxh3x128Fill(1101)
  let k = 0
  while (k < 6) {
    let short: u64 = 0
    let n = 0
    while (n <= 240) {
      short = xxh3x128Fold(short, xxh3x128(buf[0:n], xxh3x128Seeds[k]))
      n = n + 1
    }
    assert(
      short == xxh3x128SeedFolds0[k],
      "fold 0..240 under seed ${xxh3x128Seeds[k]} = ${short}, want ${xxh3x128SeedFolds0[k]}",
    )
    let long: u64 = 0
    while (n <= 1100) {
      long = xxh3x128Fold(long, xxh3x128(buf[0:n], xxh3x128Seeds[k]))
      n = n + 1
    }
    assert(
      long == xxh3x128SeedFolds1[k],
      "fold 241..1100 under seed ${xxh3x128Seeds[k]} = ${long}, want ${xxh3x128SeedFolds1[k]}",
    )
    k = k + 1
  }
}

test "xxh3x128 of a subslice equals the hash of a copy at every length" {
  let buf = xxh3x128Fill(400)
  let n = 0
  while (n <= 300) {
    let copy: []byte = []byte(n)
    let i = 0
    while (i < n) {
      copy[i] = buf[7 + i]
      i = i + 1
    }
    assert(xxh3x128(buf[7:7 + n]).equals(xxh3x128(copy)), "subslice at 7, length ${n}")
    assert(
      xxh3x128(buf[7:7 + n], 5).equals(xxh3x128(copy, 5)),
      "subslice at 7, length ${n}, seed 5",
    )
    n = n + 1
  }
}

test "xxh3x128 matches the reference on 1 MiB, one-shot" {
  let buf = xxh3x128Fill(1048576)
  let lens: [3]int = [3]int{ 1048576, 1048575, 1000000 }
  let seeds: [3]u64 = [3]u64{ 0, 0x9e3779b185ebca8d, 0xdeadbeefcafebabe }
  let l = 0
  while (l < 3) {
    let k = 0
    while (k < 3) {
      let h = xxh3x128(buf[0:lens[l]], seeds[k])
      let at = 6 * l + 2 * k
      assert(h.lo == xxh3x128Big[at], "len ${lens[l]}, seed ${seeds[k]}: lo ${h.lo}")
      assert(h.hi == xxh3x128Big[at + 1], "len ${lens[l]}, seed ${seeds[k]}: hi ${h.hi}")
      k = k + 1
    }
    l = l + 1
  }
}

// Hashes `data` in chunks of `size` bytes (the last one shorter).
fn xxh3x128Chunked(data: []byte, size: int, seed: u64): Hash128 {
  let h = Xxh3x128(seed)
  let i = 0
  while (i < len(data)) {
    let e = i + size
    if (e > len(data)) {
      e = len(data)
    }
    h.update(data[i:e])
    i = e
  }
  return h.digest()
}

test "Xxh3x128 streamed in chunks of 1, 7, 63, 64, 65, 240, 241, 1023, 1024 and 1025 bytes equals the one-shot hash" {
  let buf = xxh3x128Fill(5000)
  let sizes: [10]int = [10]int{ 1, 7, 63, 64, 65, 240, 241, 1023, 1024, 1025 }
  let want0 = xxh3x128(buf)
  let want1 = xxh3x128(buf, 0x9e3779b185ebca8d)
  let k = 0
  while (k < 10) {
    let got0 = xxh3x128Chunked(buf, sizes[k], 0)
    assert(got0.equals(want0), "chunks of ${sizes[k]}, seed 0: ${xxh3x128Show(got0)}")
    let got1 = xxh3x128Chunked(buf, sizes[k], 0x9e3779b185ebca8d)
    assert(got1.equals(want1), "chunks of ${sizes[k]}, seed B: ${xxh3x128Show(got1)}")
    k = k + 1
  }
}

test "Xxh3x128 streamed over 1 MiB equals the reference" {
  let buf = xxh3x128Fill(1048576)
  // 4097 is the chunking the reference's own XXH3_128bits_update produced the one-shot value with.
  let a = xxh3x128Chunked(buf, 4097, 0)
  assert(a.lo == xxh3x128Big[0] && a.hi == xxh3x128Big[1], "1 MiB in 4097-byte chunks, seed 0")
  let b = xxh3x128Chunked(buf, 65536, 0x9e3779b185ebca8d)
  assert(b.lo == xxh3x128Big[2] && b.hi == xxh3x128Big[3], "1 MiB in 64 KiB chunks, seed B")
  let c = xxh3x128Chunked(buf, 63, 0xdeadbeefcafebabe)
  assert(c.lo == xxh3x128Big[4] && c.hi == xxh3x128Big[5], "1 MiB in 63-byte chunks, 64-bit seed")
}

test "Xxh3x128 digest after every prefix length up to 1100 equals the one-shot hash" {
  let buf = xxh3x128Fill(1100)
  let h = Xxh3x128(0x9e3779b185ebca8d)
  let n = 0
  while (n <= 1100) {
    let got = h.digest()
    let want = xxh3x128(buf[0:n], 0x9e3779b185ebca8d)
    assert(got.equals(want), "digest after ${n} bytes = ${xxh3x128Show(got)}")
    if (n < 1100) {
      h.update(buf[n:n + 1])
    }
    n = n + 1
  }
}

test "Xxh3x128 split in two at every point of 1100 bytes equals the one-shot hash" {
  let buf = xxh3x128Fill(1100)
  let want = xxh3x128(buf)
  let cut = 0
  while (cut <= 1100) {
    let h = Xxh3x128()
    h.update(buf[0:cut])
    h.update(buf[cut:1100])
    let got = h.digest()
    assert(got.equals(want), "split at ${cut}: ${xxh3x128Show(got)}")
    cut = cut + 1
  }
}

test "Xxh3x128 split in three at the 64, 240, 256 and 1024 byte boundaries equals the one-shot hash" {
  let buf = xxh3x128Fill(1300)
  let want0 = xxh3x128(buf)
  let want1 = xxh3x128(buf, 7)
  let pts: [18]int = [18]int{
    0,
    1,
    63,
    64,
    65,
    127,
    128,
    129,
    239,
    240,
    241,
    255,
    256,
    257,
    1023,
    1024,
    1025,
    1088,
  }
  let a = 0
  while (a < 18) {
    let b = a
    while (b < 18) {
      let h0 = Xxh3x128()
      let h1 = Xxh3x128(7)
      h0.update(buf[0:pts[a]])
      h1.update(buf[0:pts[a]])
      h0.update(buf[pts[a]:pts[b]])
      h1.update(buf[pts[a]:pts[b]])
      h0.update(buf[pts[b]:1300])
      h1.update(buf[pts[b]:1300])
      assert(h0.digest().equals(want0), "split at ${pts[a]} and ${pts[b]}, seed 0")
      assert(h1.digest().equals(want1), "split at ${pts[a]} and ${pts[b]}, seed 7")
      b = b + 1
    }
    a = a + 1
  }
}

test "Xxh3x128 matches the reference on the boundary sanity vectors in one update" {
  let buf = xxh3x128Fill(4161)
  let k = 0
  while (k < 3) {
    let j = 0
    while (j < 60) {
      let h = Xxh3x128(xxh3x128SanitySeeds[k])
      h.update(buf[0:xxh3x128BLens[j]])
      let want = xxh3x128Want(k, j)
      assert(
        h.digest().equals(want),
        "Xxh3x128 over ${xxh3x128BLens[j]} bytes, seed ${xxh3x128SanitySeeds[k]}",
      )
      j = j + 1
    }
    k = k + 1
  }
}

test "Xxh3x128 digest does not consume the hasher and reset restarts it" {
  let buf = xxh3x128Fill(700)
  let h = Xxh3x128(3)
  h.update(buf[0:300])
  let first = h.digest()
  assert(h.digest().equals(first), "digest twice")
  h.update(buf[300:700])
  assert(h.digest().equals(xxh3x128(buf, 3)), "digest after more input")
  h.reset()
  assert(h.digest().equals(xxh3x128(buf[0:0], 3)), "digest after reset is the empty hash")
  h.update(buf[0:300])
  assert(h.digest().equals(first), "same input after reset")
}

test "Xxh3x128 ignores empty updates" {
  let buf = xxh3x128Fill(500)
  let h = Xxh3x128()
  h.update(buf[0:0])
  h.update(buf[0:200])
  h.update(buf[200:200])
  h.update(buf[200:500])
  h.update(buf[500:500])
  assert(h.digest().equals(xxh3x128(buf)), "empty updates between chunks")
}
