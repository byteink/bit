// 0xdeadbeefcafebabe, as lo, hi.
const xxh3x128Big: [18]u64 = [18]u64{
  0x7ade52bbfbd697ba, 0x6f7444ca6384250b, 0x31146b91b00eb226, 0x4006ed9c899a1bf7, 0xd2893e5b4e1e2f29, 0x0a7cedd63cca06fd,
