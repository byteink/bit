  0, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17,
  31, 32, 33, 63, 64, 65, 96, 97, 127, 128, 129, 159,
  160, 161, 191, 192, 193, 223, 224, 225, 239, 240, 241, 255,
  256, 257, 303, 304, 319, 320, 321, 383, 384, 385, 1023, 1024,
  1025, 1087, 1088, 1089, 2047, 2048, 2049, 4095, 4096, 4097, 4159, 4160,
}

