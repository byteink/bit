// stdlib/hash/xxh3x128.test.bit — XXH3-128 correctness, one-shot and streaming
// (#6600).
//
// Every expected value below comes from the reference implementation, none
// from this module:
//   1. The reference repository's own sanity vectors,
//      github.com/Cyan4973/xxHash tests/sanity_test_vectors.h
//      (XSUM_XXH128_testdata), pinned at commit
//      680bf463fa1ca0461b9a7c2dab7556e1f54cf4cf. That table covers every
//      length 0..4160 under the seeds 0, 0x9E3779B1 and 0x9E3779B185EBCA8D
//      (12483 vectors, three per length, in that order) over the buffer
//      tests/sanity_test.c fillTestBuffer() builds: byteGen starts at PRIME32
//      (2654435761), each byte is byteGen >> 56, and byteGen is then
//      multiplied by PRIME64 (11400714785074694797), wrapping. The 60 lengths
//      at the edges of every path (0, 1..3, 4..8, 9..16, 17..128, 129..240
//      and the long path's stripe, block and 4 KiB boundaries) are listed in
//      full below, under all three seeds; every row is pinned by a fold (see
//      "all 12483 reference vectors" below).
//   2. The same pinned commit's xxhash.h compiled with cc -O2
//      -DXXH_INLINE_ALL, for what the sanity table does not hold: seeds with
//      high bits set (the 4..8 byte path swaps the seed's halves, the others
//      add and subtract it, the long path derives a whole secret from it), the
//      empty input under each, a few ASCII strings, a fold per seed over
//      lengths 0..240 and over 241..1100, and 1 MiB buffers, one-shot and
//      streamed through XXH3_128bits_update. That build's output was checked
//      equal to all 12483 table rows (0 mismatches) before it was used for
//      anything else.
// A fold is acc = (acc ^ lo) * PRIME64_1, then acc = (acc ^ hi) * PRIME64_1,
// per result in table order: a bijection per step, so a wrong half anywhere
// changes the final value.

// The sanity buffer: `n` bytes of fillTestBuffer().
fn xxh3x128Fill(n: int): []byte {
  let buf: []byte = []byte(n)
  let g: u64 = 2654435761
  let i = 0
  while (i < n) {
    buf[i] = byte(g >> 56)
    g = g * 11400714785074694797
    i = i + 1
  }
  return buf
}

// The sanity table's seeds, in table order within a length.
const xxh3x128SanitySeeds: [3]u64 = [3]u64{ 0, 0x9e3779b1, 0x9e3779b185ebca8d }

// The fold step over one result.
fn xxh3x128Fold(acc: u64, h: Hash128): u64 {
  let a = (acc ^ h.lo) * 0x9e3779b185ebca87
  return (a ^ h.hi) * 0x9e3779b185ebca87
}

// Seeds with high bits set, in the order of the tables below.
const xxh3x128Seeds: [6]u64 = [6]u64{
  0x0000000000000001, 0xdeadbeefcafebabe, 0xffffffffffffffff,
  0x00000000ffffffff, 0xffffffff00000000, 0x8000000000000000,
}

// The 60 boundary lengths of the sanity table; the six tables below hold, per
// seed in `xxh3x128SanitySeeds`, the `lo` and `hi` of each.
