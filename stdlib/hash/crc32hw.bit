      0x66, 0x0F, 0x3A, 0x44, 0xC4, 0x00,                         // pclmulqdq xmm0, xmm4, 0x0
      0x66, 0x0F, 0x3A, 0x44, 0xFC, 0x11,                         // pclmulqdq xmm7, xmm4, 0x11
