      0x66, 0x0F, 0x38, 0x35, 0xC8,                               // pmovzxdq xmm1, xmm0
      0x66, 0x0F, 0x6F, 0xD1,                                     // movdqa xmm2, xmm1
      0x66, 0x0F, 0x3A, 0x44, 0xCC, 0x10,                         // pclmulqdq xmm1, xmm4, 0x10
      0x49, 0xB8, 0x24, 0x61, 0xCD, 0x63, 0x01, 0x00, 0x00, 0x00, // mov r8, 0x163cd6124
      0x66, 0x49, 0x0F, 0x6E, 0xD8,                               // movq xmm3, r8
      0x66, 0x0F, 0x3A, 0x44, 0xD3, 0x01,                         // pclmulqdq xmm2, xmm3, 0x1
