    }
    result arm64 x0 x64 rax : u64
    input arm64 x0 x64 rax = crc
    input arm64 x1 x64 rcx = p
    input arm64 x2 x64 rdx = blocks
    clobber arm64 { x3, memory }
    clobber x64 { r8, r9, memory }
