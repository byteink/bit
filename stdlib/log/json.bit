// Bit standard library — std/log: JsonHandler, one JSON object per line.
//
// Every string goes through std/json's own escaper, so the output is one
// valid JSON object per record and a newline in a value is `\n`, never a
// second line. A Duration is an integer of nanoseconds, a Time its RFC 3339
// string, an Error its message.

// `{"time":"…","level":"INFO","msg":"hello","k":"v"}`. Build it with
// `JsonHandler(out)`.
export class JsonHandler {
  out: Sink
  mu: Mutex
  level: int
  stamps: bool
  frames: []frame

  init(out: Sink, level: int = LevelInfo, timestamps: bool = true) {
    requireSink(out)
    this.out = out
    this.mu = Mutex()
    this.level = level
    this.stamps = timestamps
    this.frames = rootFrames()
  }

  export enabled(level: int): bool {
    return level >= this.level
  }

  export handle(r: Record): ()! {
    let buf = []byte(0)
    buf = append(buf, '{')
    let first = true
    if (this.stamps) {
      buf = jsonAppendKey(buf, "time", first)
      buf = jsonAppendString(buf, r.time.toString())
      first = false
    }
    buf = jsonAppendKey(buf, "level", first)
    buf = jsonAppendString(buf, levelName(r.level))
    buf = jsonAppendKey(buf, "msg", false)
    buf = jsonAppendString(buf, r.msg)
    let body = jsonFrameBody(this.frames, 0, r.attrs)
    if (len(body) > 0) {
      buf = append(buf, ',')
      buf = jsonAppendRaw(buf, string(body))
    }
    buf = append(buf, '}')
    buf = append(buf, '\n')
    writeLine(this.mu, this.out, string(buf))?
  }

  export with(attrs: []Attr): Handler {
    return this.child(framesWith(this.frames, attrs))
  }

  export withGroup(name: string): Handler {
    return this.child(framesGroup(this.frames, name))
  }

  child(frames: []frame): JsonHandler {
    let h = JsonHandler(this.out, this.level, this.stamps)
    h.mu = this.mu
    h.frames = frames
    return h
  }
}

// The members (no braces) of the object that frame `i` opens: its own
// attributes, then the object of the next frame under that frame's group name
// when it has any member. The last frame also holds the record's attributes.
fn jsonFrameBody(frames: []frame, i: int, recAttrs: []Attr): []byte {
  let f = frames[i]
  let buf = jsonMembers([]byte(0), f.attrs)
  let inner = []byte(0)
  if (i + 1 < len(frames)) {
    inner = jsonFrameBody(frames, i + 1, recAttrs)
  } else {
    buf = jsonMembers(buf, recAttrs)
  }
  if (len(inner) == 0) {
    return buf
  }
  buf = jsonAppendKey(buf, frames[i + 1].group, len(buf) == 0)
  buf = append(buf, '{')
  buf = jsonAppendRaw(buf, string(inner))
  return append(buf, '}')
}

fn jsonMembers(buf: []byte, attrs: []Attr): []byte {
  let i = 0
  while (i < len(attrs)) {
    let a = attrs[i]
    if (a.kind == Kind.Group) {
      let inner = jsonMembers([]byte(0), a.group)
      if (len(inner) > 0) {
        buf = jsonAppendKey(buf, a.key, len(buf) == 0)
        buf = append(buf, '{')
        buf = jsonAppendRaw(buf, string(inner))
        buf = append(buf, '}')
      }
    } else {
      buf = jsonAppendKey(buf, a.key, len(buf) == 0)
      buf = jsonValue(buf, a)
    }
    i = i + 1
  }
  return buf
}

fn jsonValue(buf: []byte, a: Attr): []byte {
  if (a.kind == Kind.Int || a.kind == Kind.Duration) {
    return jsonAppendInt(buf, a.num)
  }
  if (a.kind == Kind.Float) {
    return jsonAppendFloat(buf, a.flt)
  }
  if (a.kind == Kind.Bool) {
    return jsonAppendBool(buf, a.num != 0)
  }
  return jsonAppendString(buf, a.str)
}
