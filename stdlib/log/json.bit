// Bit standard library — std/log: JsonHandler, one JSON object per line.
//
// Every string goes through std/json's own escaper, so the output is one
// valid JSON object per record and a newline in a value is `\n`, never a
// second line. A Duration is an integer of nanoseconds, a Time its RFC 3339
// string, an Error its message.

// `{"time":"…","level":"INFO","msg":"hello","k":"v"}`. Build it with
// `JsonHandler(out)`.
export class JsonHandler {
  out: Sink
  mu: Mutex
  buf: Builder
  level: int
  stamps: bool
  frames: []frame

  init(out: Sink, level: int = LevelInfo, timestamps: bool = true) {
    requireSink(out)
    this.out = out
    this.mu = Mutex()
    this.buf = Builder()
    this.level = level
    this.stamps = timestamps
    this.frames = rootFrames()
  }

  export enabled(level: int): bool {
    return level >= this.level
  }

  export handle(r: Record): ()! {
    this.mu.lock()
    let buf = reuseBuf(this.buf)
    let start = buf.length()
    buf.writeByte('{')
    let first = true
    if (this.stamps) {
      buf = jsonWriteKey(buf, "time", first)
      buf.writeByte('"')
      buf = appendTime(buf, r.ns)
      buf.writeByte('"')
      first = false
    }
    buf = jsonWriteKey(buf, "level", first)
    buf.writeByte('"')
    buf = appendLevel(buf, r.lvl)
    buf.writeByte('"')
    buf = jsonWriteKey(buf, "msg", false)
    buf = jsonWriteString(buf, r.text)
    buf = jsonFrames(buf, this.frames, 0, r, 0 - 1)
    buf.write("}\n")
    this.buf = buf
    writeLocked(this.mu, this.out, buf, start)?
  }

  export with(attrs: []Attr): Handler {
    return this.child(framesWith(this.frames, attrs))
  }

  export withGroup(name: string): Handler {
    return this.child(framesGroup(this.frames, name))
  }

  child(frames: []frame): JsonHandler {
    let h = JsonHandler(this.out, this.level, this.stamps)
    h.mu = this.mu
    h.frames = frames
    return h
  }
}

// Frame `i`'s members, then the object of the next frame under that frame's
// group name when it has any member; the last frame also holds the record's
// attributes. `objStart` is the offset of the enclosing object's first member,
// or -1 when a member always follows one already written (the top level,
// after "msg"), so a member is first exactly when nothing was written since.
fn jsonFrames(buf: Builder, frames: []frame, i: int, r: Record, objStart: int): Builder {
  buf = jsonMembers(buf, frames[i].attrs, objStart)
  if (i + 1 == len(frames)) {
    buf = jsonInline(buf, r, objStart)
    buf = jsonMembers(buf, r.more, objStart)
    return buf
  }
  let mark = buf.length()
  buf = jsonWriteKey(buf, frames[i + 1].group, mark == objStart)
  buf.writeByte('{')
  let inner = buf.length()
  buf = jsonFrames(buf, frames, i + 1, r, inner)
  buf = closeObject(buf, mark, inner)
  return buf
}

fn jsonMembers(buf: Builder, attrs: []Attr, objStart: int): Builder {
  let i = 0
  while (i < len(attrs)) {
    let a = attrs[i]
    let mark = buf.length()
    buf = jsonWriteKey(buf, a.key, mark == objStart)
    if (a.kind == Kind.Group) {
      buf.writeByte('{')
      let inner = buf.length()
      buf = closeObject(jsonMembers(buf, a.group, inner), mark, inner)
    } else {
      buf = jsonValue(buf, a.kind, a.num, a.flt, a.str)
    }
    i = i + 1
  }
  return buf
}

// Closes the object whose members began at `inner`, or takes back its key
// (written from `mark`) when it got none: an empty group is left out.
fn closeObject(buf: Builder, mark: int, inner: int): Builder {
  if (buf.length() == inner) {
    return buf.truncate(mark)
  }
  buf.writeByte('}')
  return buf
}

// The attributes `r` and its chained records hold in their own fields, as
// members; an inline slot is never a group.
fn jsonInline(buf: Builder, r: Record, objStart: int): Builder {
  let i = 0
  while (i < r.n) {
    buf = jsonWriteKey(buf, r.keyAt(i), buf.length() == objStart)
    buf = jsonValue(buf, r.kindAt(i), r.nums[i], r.flts[i], r.strAt(i))
    i = i + 1
  }
  if (len(r.next) > 0) {
    return jsonInline(buf, r.next[0], objStart)
  }
  return buf
}

fn jsonValue(buf: Builder, kind: Kind, num: int, flt: f64, str: string): Builder {
  if (kind == Kind.Int || kind == Kind.Duration) {
    return appendInt(buf, num)
  }
  if (kind == Kind.Float) {
    return jsonWriteFloat(buf, flt)
  }
  if (kind == Kind.Bool) {
    return appendBool(buf, num != 0)
  }
  if (kind == Kind.Time) {
    buf.writeByte('"')
    buf = appendTime(buf, num)
    buf.writeByte('"')
    return buf
  }
  return jsonWriteString(buf, str)
}
