// Bit standard library — std/log: Logger and the process default.
//
// A Logger is a Handler plus the call-site API. Each level method returns a
// `Record` (record.bit) to add attributes to and write with `log(msg)`:
//
//   logger.info().str("method", m).int("status", 200).log("request")
//
// Up to five attributes the record holds them in its own fields, so an
// enabled line costs the record and the line. A disabled level returns one
// shared record that keeps nothing, so the whole chain allocates nothing and
// needs no `enabled` guard.

export class Logger {
  h: Handler

  init(h: Handler) {
    if (h == nil) {
      panic("log: Logger needs a handler; pass TextHandler(...) or JsonHandler(...)")
    }
    this.h = h
  }

  export enabled(level: int): bool {
    return this.h.enabled(level)
  }

  // The one core every level method calls. Use it for a level of your own:
  // `logger.at(LevelInfo + 2).log("cache warmed")`.
  export at(level: int): Record {
    if (!this.h.enabled(level)) {
      return offRecord
    }
    return Record{ h = this.h, on = true, ns = timeUnixNs(), lvl = level }
  }

  export debug(): Record {
    return this.at(LevelDebug)
  }

  export info(): Record {
    return this.at(LevelInfo)
  }

  export warn(): Record {
    return this.at(LevelWarn)
  }

  export error(): Record {
    return this.at(LevelError)
  }

  // A child that adds `fields`' attributes (built with `attrs()`) to every
  // record it writes.
  export with(fields: Record): Logger {
    return Logger(this.h.with(fields.attrs()))
  }

  // A child whose later attributes (and the ones `with` adds after it) nest
  // under `name`.
  export withGroup(name: string): Logger {
    return Logger(this.h.withGroup(name))
  }
}

let defaultLogger: Logger = Logger(TextHandler(stderr()))
let defaultSet: bool = false

// The process default: a TextHandler on stderr at LevelInfo until `setDefault`
// replaces it.
export fn getDefault(): Logger {
  return defaultLogger
}

// Replaces the process default. Call it once, at startup, before spawning
// tasks; a second call panics because two parts of a program fighting over
// the default is a bug to find, not to paper over.
export fn setDefault(l: Logger) {
  if (defaultSet) {
    panic("log: setDefault called twice; set the process logger once, at startup")
  }
  defaultSet = true
  defaultLogger = l
}
