// Bit standard library — std/log: Logger and the process default.
//
// A Logger is a Handler plus the call-site API, in two shapes. The level
// methods take `Attr`s (`info("msg", Str("k", v))`): each one is an object,
// built by the caller before the call. `at(level)` returns a `Record` filled
// by typed methods (`at(LevelInfo).str("k", v).log("msg")`) that holds its
// first five attributes in its own fields: one record object and the line,
// whatever those attributes are, and nothing at all when the level is
// disabled. Use `at` on a hot path.
//
// A failed write is dropped: a log line must never take the program down,
// and there is nobody to report the failure to but the log itself.

export class Logger {
  h: Handler

  init(h: Handler) {
    if (h == nil) {
      panic("log: Logger needs a handler; pass TextHandler(...) or JsonHandler(...)")
    }
    this.h = h
  }

  export enabled(level: int): bool {
    return this.h.enabled(level)
  }

  // The one core every level method calls. Use it for a level of your own:
  // `logger.log(LevelInfo + 2, "cache warmed")`.
  export log(level: int, msg: string, ...attrs: Attr) {
    if (!this.h.enabled(level)) {
      return
    }
    let r = Record{ h = this.h, ns = timeUnixNs(), lvl = level, text = msg, more = attrs }
    this.h.handle(r) catch _ {
      return
    }
  }

  // A record at `level` to add attributes to and write with `log(msg)`. A
  // disabled level returns one shared record that keeps nothing, so the
  // whole chain allocates nothing.
  export at(level: int): Record {
    if (!this.h.enabled(level)) {
      return offRecord
    }
    return Record{ h = this.h, ns = timeUnixNs(), lvl = level }
  }

  export debug(msg: string, ...attrs: Attr) {
    if (!this.h.enabled(LevelDebug)) {
      return
    }
    this.log(LevelDebug, msg, ...attrs)
  }

  export info(msg: string, ...attrs: Attr) {
    if (!this.h.enabled(LevelInfo)) {
      return
    }
    this.log(LevelInfo, msg, ...attrs)
  }

  export warn(msg: string, ...attrs: Attr) {
    if (!this.h.enabled(LevelWarn)) {
      return
    }
    this.log(LevelWarn, msg, ...attrs)
  }

  export error(msg: string, ...attrs: Attr) {
    if (!this.h.enabled(LevelError)) {
      return
    }
    this.log(LevelError, msg, ...attrs)
  }

  // A child that adds `attrs` to every record it writes.
  export with(...attrs: Attr): Logger {
    return Logger(this.h.with(attrs))
  }

  // A child whose later attributes (and the ones `with` adds after it) nest
  // under `name`.
  export withGroup(name: string): Logger {
    return Logger(this.h.withGroup(name))
  }
}

let defaultLogger: Logger = Logger(TextHandler(stderr()))
let defaultSet: bool = false

// The process default: a TextHandler on stderr at LevelInfo until `setDefault`
// replaces it.
export fn getDefault(): Logger {
  return defaultLogger
}

// Replaces the process default. Call it once, at startup, before spawning
// tasks; a second call panics because two parts of a program fighting over
// the default is a bug to find, not to paper over.
export fn setDefault(l: Logger) {
  if (defaultSet) {
    panic("log: setDefault called twice; set the process logger once, at startup")
  }
  defaultSet = true
  defaultLogger = l
}
