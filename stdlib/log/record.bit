// Bit standard library — std/log: Record, the one way to build a log line.
//
// `logger.info()` (or `debug`, `warn`, `error`, `at(level)`) returns a
// Record; typed methods add attributes to it and `log(msg)` writes it:
//
//   logger.info().str("method", m).int("status", 200).log("request")
//
// The first `inlineAttrs` attributes live in the record's own fields, so a
// record of up to that many costs no object per attribute; a later one, and a
// group, is an `Attr` in `more`. Bit has no value structs (SPEC 13.3) and a
// fixed array holds only scalars (E0072), so the two strings of each slot are
// fields of their own. `attrs()` builds a record with no logger, the set of
// attributes `Logger.with` and `group` take.

export class Record {
  h: Handler
  on: bool
  ns: int
  lvl: int
  text: string
  n: int
  codes: [5]int
  nums: [5]int
  flts: [5]f64
  k0: string
  k1: string
  k2: string
  k3: string
  k4: string
  s0: string
  s1: string
  s2: string
  s3: string
  s4: string
  more: []Attr

  export str(key: string, value: string): Record {
    return this.put(key, codeString, 0, 0.0, value)
  }

  export int(key: string, value: int): Record {
    return this.put(key, codeInt, value, 0.0, "")
  }

  export float(key: string, value: f64): Record {
    return this.put(key, codeFloat, 0, value, "")
  }

  export bool(key: string, value: bool): Record {
    let n = 0
    if (value) {
      n = 1
    }
    return this.put(key, codeBool, n, 0.0, "")
  }

  // `nanos` is a duration in nanoseconds, the unit std/time uses everywhere.
  export duration(key: string, nanos: int): Record {
    return this.put(key, codeDuration, nanos, 0.0, "")
  }

  // An instant, written as RFC 3339 in UTC.
  export time(key: string, at: Timestamp): Record {
    return this.put(key, codeTime, at.ns, 0.0, "")
  }

  // An error's message under `key` ("error" unless you say otherwise). A
  // disabled record never asks the error for it.
  export err(e: error, key: string = "error"): Record {
    requireKey(key)
    if (!this.on) {
      return this
    }
    return this.put(key, codeError, 0, 0.0, e.message())
  }

  // `members`' attributes nested under `key`: `key.sub=...` in text,
  // `{"key":{"sub":...}}` in JSON. A group with no attributes is left out.
  export group(key: string, members: Record): Record {
    requireKey(key)
    if (!this.on) {
      return this
    }
    let a = Attr{
      key = key,
      kind = Kind.Group,
      num = 0,
      flt = 0.0,
      str = "",
      group = members.attrs(),
    }
    this.more = append(this.more, a)
    return this
  }

  // Writes the record with `msg` through its logger's handler, or does
  // nothing when its level was disabled. A failed write is dropped: a log
  // line must never take the program down. A record from `attrs()` has no
  // logger to write to, and calling this on one is a bug, so it panics.
  export log(msg: string) {
    if (!this.on) {
      return
    }
    if (this.h == nil) {
      panic("log: log(msg) on a record from attrs(), which has no logger; pass it to with() or group()")
    }
    this.text = msg
    this.h.handle(this) catch _ {
      return
    }
  }

  // Nanoseconds since the Unix epoch at which the record was made.
  export unixNanos(): int {
    return this.ns
  }

  export level(): int {
    return this.lvl
  }

  export message(): string {
    return this.text
  }

  // Every attribute in the order it was added, as `Attr`s: built on each
  // call, for a handler of your own. The shipped handlers read the inline
  // fields instead and build none.
  export attrs(): []Attr {
    let out = []Attr(0)
    let i = 0
    while (i < this.n) {
      out = append(out, this.attrAt(i))
      i = i + 1
    }
    return concatAttrs(out, this.more)
  }

  // The empty key is a bug at the call site, so it panics even when the
  // record is disabled; a disabled record keeps nothing. Once one attribute
  // has gone to `more`, every later one does too, so order is kept.
  put(key: string, code: int, num: int, flt: f64, str: string): Record {
    requireKey(key)
    if (!this.on) {
      return this
    }
    if (this.n == inlineAttrs || len(this.more) > 0) {
      let a = Attr{ key = key, kind = kindOf(code), num = num, flt = flt, str = str }
      this.more = append(this.more, a)
      return this
    }
    this.codes[this.n] = code
    this.nums[this.n] = num
    this.flts[this.n] = flt
    this.setSlot(key, str)
    this.n = this.n + 1
    return this
  }

  setSlot(key: string, str: string) {
    if (this.n == 0) {
      this.k0 = key
      this.s0 = str
    } else if (this.n == 1) {
      this.k1 = key
      this.s1 = str
    } else if (this.n == 2) {
      this.k2 = key
      this.s2 = str
    } else if (this.n == 3) {
      this.k3 = key
      this.s3 = str
    } else {
      this.k4 = key
      this.s4 = str
    }
  }

  keyAt(i: int): string {
    if (i == 0) {
      return this.k0
    }
    if (i == 1) {
      return this.k1
    }
    if (i == 2) {
      return this.k2
    }
    if (i == 3) {
      return this.k3
    }
    return this.k4
  }

  strAt(i: int): string {
    if (i == 0) {
      return this.s0
    }
    if (i == 1) {
      return this.s1
    }
    if (i == 2) {
      return this.s2
    }
    if (i == 3) {
      return this.s3
    }
    return this.s4
  }

  kindAt(i: int): Kind {
    return kindOf(this.codes[i])
  }

  // Slot `i` as an `Attr`; a Time also gets its RFC 3339 text in `str`, which
  // the inline slot never stores.
  attrAt(i: int): Attr {
    let str = this.strAt(i)
    if (this.codes[i] == codeTime) {
      str = string(appendTime([]byte(0), this.nums[i]))
    }
    return Attr{
      key = this.keyAt(i),
      kind = this.kindAt(i),
      num = this.nums[i],
      flt = this.flts[i],
      str = str,
    }
  }
}

// A record with no logger: attributes for `Logger.with` and `group`, built
// with the same typed methods. Calling `log` on it panics.
export fn attrs(): Record {
  return Record{ on = true }
}

// How many attributes a record holds in its own fields; the size of the
// `[5]` arrays above.
const inlineAttrs: int = 5

// A Kind as the int an inline slot stores: a fixed array holds only scalars.
// A group is never inline.
const codeString: int = 0
const codeInt: int = 1
const codeFloat: int = 2
const codeBool: int = 3
const codeDuration: int = 4
const codeError: int = 5
const codeTime: int = 6

fn kindOf(code: int): Kind {
  if (code == codeInt) {
    return Kind.Int
  }
  if (code == codeFloat) {
    return Kind.Float
  }
  if (code == codeBool) {
    return Kind.Bool
  }
  if (code == codeDuration) {
    return Kind.Duration
  }
  if (code == codeError) {
    return Kind.Error
  }
  if (code == codeTime) {
    return Kind.Time
  }
  return Kind.String
}

// The record a disabled level returns: `on` is false, so every method
// returns before writing a field, which is what lets every task share it.
let offRecord: Record = Record{ on = false }
