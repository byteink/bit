// Bit standard library — std/log: levels, attributes, records and the Handler
// interface.
//
// A structured, leveled logger shaped after Go's log/slog: a `Logger` turns
// one call into a `Record` (time, level, message, attributes) and hands it to
// a `Handler`, which decides whether the level is enabled and where the bytes
// go. `TextHandler` (text.bit) and `JsonHandler` (json.bit) are the two
// shipped handlers; `Logger` and the process default live in logger.bit.
//
// This file also holds the module's only imports: imports are per module, so
// the sibling files use these names without importing them again.

import { Timestamp } from "std/time"
import { Mutex } from "std/sync"
import { stderr } from "std/io"
import {
  jsonAppendKey,
  jsonAppendString,
  jsonAppendFloat,
  jsonAppendBool,
} from "std/json"

// --- levels ---------------------------------------------------------------

// A level is a plain int so an application can name its own between the
// four. The gaps (4 apart) are slog's: room for `LevelInfo + 2` ("notice")
// without a new type.
export const LevelDebug: int = -4
export const LevelInfo: int = 0
export const LevelWarn: int = 4
export const LevelError: int = 8

// "DEBUG", "INFO", "WARN" or "ERROR" for the four named levels; any other
// level reads as the nearest named level below it plus the distance, so
// `LevelInfo + 2` is "INFO+2" and `LevelDebug - 4` is "DEBUG-4".
export fn levelName(level: int): string {
  let base = levelBase(level)
  return offsetName(baseName(base), level - base)
}

// The named level at or below `level`, the base its name is offset from.
fn levelBase(level: int): int {
  if (level < LevelInfo) {
    return LevelDebug
  }
  if (level < LevelWarn) {
    return LevelInfo
  }
  if (level < LevelError) {
    return LevelWarn
  }
  return LevelError
}

fn baseName(base: int): string {
  if (base == LevelDebug) {
    return "DEBUG"
  }
  if (base == LevelInfo) {
    return "INFO"
  }
  if (base == LevelWarn) {
    return "WARN"
  }
  return "ERROR"
}

fn offsetName(name: string, delta: int): string {
  if (delta == 0) {
    return name
  }
  if (delta > 0) {
    return "${name}+${delta}"
  }
  return "${name}${delta}"
}

// --- attributes -----------------------------------------------------------

// Which field of an `Attr` carries its value. A Duration is nanoseconds in
// `num`; a Time is nanoseconds since the Unix epoch in `num` and its RFC 3339
// text in `str`; an Error is the error's message in `str`.
export enum Kind { String, Int, Float, Bool, Duration, Time, Error, Group }

// One key and one typed value. Build them with `Str`, `Int`, `Float`, `Bool`,
// `Duration`, `Time`, `Err` and `Group`; a handler of your own reads `kind`
// and the field that kind names.
export class Attr {
  export readonly key: string,
  export readonly kind: Kind,
  export readonly num: int,
  export readonly flt: f64,
  export readonly str: string,
  export readonly group: []Attr,
}

fn requireKey(key: string) {
  if (key == "") {
    panic("log: an attribute key must not be empty")
  }
}

export fn Str(key: string, value: string): Attr {
  requireKey(key)
  return Attr{ key = key, kind = Kind.String, num = 0, flt = 0.0, str = value, group = []Attr(0) }
}

export fn Int(key: string, value: int): Attr {
  requireKey(key)
  return Attr{ key = key, kind = Kind.Int, num = value, flt = 0.0, str = "", group = []Attr(0) }
}

export fn Float(key: string, value: f64): Attr {
  requireKey(key)
  return Attr{ key = key, kind = Kind.Float, num = 0, flt = value, str = "", group = []Attr(0) }
}

export fn Bool(key: string, value: bool): Attr {
  requireKey(key)
  let n = 0
  if (value) {
    n = 1
  }
  return Attr{ key = key, kind = Kind.Bool, num = n, flt = 0.0, str = "", group = []Attr(0) }
}

// `nanos` is a duration in nanoseconds, the unit std/time uses everywhere.
export fn Duration(key: string, nanos: int): Attr {
  requireKey(key)
  return Attr{
    key = key,
    kind = Kind.Duration,
    num = nanos,
    flt = 0.0,
    str = "",
    group = []Attr(0),
  }
}

export fn Time(key: string, at: Timestamp): Attr {
  requireKey(key)
  return Attr{
    key = key,
    kind = Kind.Time,
    num = at.ns,
    flt = 0.0,
    str = at.toString(),
    group = []Attr(0),
  }
}

// An error's message under `key` ("error" unless you say otherwise).
export fn Err(e: error, key: string = "error"): Attr {
  requireKey(key)
  return Attr{
    key = key,
    kind = Kind.Error,
    num = 0,
    flt = 0.0,
    str = e.message(),
    group = []Attr(0),
  }
}

// Nests `attrs` under `key`: `key.sub=...` in text, `{"key":{"sub":...}}` in
// JSON. A group with no attributes is left out of the output.
export fn Group(key: string, ...attrs: Attr): Attr {
  requireKey(key)
  return Attr{ key = key, kind = Kind.Group, num = 0, flt = 0.0, str = "", group = attrs }
}

// --- records and handlers -------------------------------------------------

// Everything one log call produced, handed to `Handler.handle`, and the
// builder that call fills: `logger.at(LevelInfo).str("k", v).log("msg")`.
// The first `inlineAttrs` attributes live in the record's own fields, so a
// record of up to that many costs no object per attribute; later ones, and
// the ones a `...attrs` call passes, are `Attr`s in `more`. Bit has no value
// structs (SPEC 13.3) and a fixed array holds only scalars (E0072), so the
// two strings of each slot are fields of their own.
export class Record {
  h: Handler
  ns: int
  lvl: int
  text: string
  n: int
  codes: [5]int
  nums: [5]int
  flts: [5]f64
  k0: string
  k1: string
  k2: string
  k3: string
  k4: string
  s0: string
  s1: string
  s2: string
  s3: string
  s4: string
  more: []Attr

  export str(key: string, value: string): Record {
    return this.put(key, codeString, 0, 0.0, value)
  }

  export int(key: string, value: int): Record {
    return this.put(key, codeInt, value, 0.0, "")
  }

  export float(key: string, value: f64): Record {
    return this.put(key, codeFloat, 0, value, "")
  }

  export bool(key: string, value: bool): Record {
    let n = 0
    if (value) {
      n = 1
    }
    return this.put(key, codeBool, n, 0.0, "")
  }

  // `nanos` is a duration in nanoseconds, the unit std/time uses everywhere.
  export duration(key: string, nanos: int): Record {
    return this.put(key, codeDuration, nanos, 0.0, "")
  }

  // An error's message under `key` ("error" unless you say otherwise). A
  // disabled record never asks the error for it.
  export err(e: error, key: string = "error"): Record {
    requireKey(key)
    if (this.h == nil) {
      return this
    }
    return this.put(key, codeError, 0, 0.0, e.message())
  }

  // Writes the record with `msg` through the logger's handler, or does
  // nothing when the level was disabled. A failed write is dropped, as for
  // every other log call.
  export log(msg: string) {
    if (this.h == nil) {
      return
    }
    this.text = msg
    this.h.handle(this) catch _ {
      return
    }
  }

  // Nanoseconds since the Unix epoch at which the record was made.
  export time(): int {
    return this.ns
  }

  export level(): int {
    return this.lvl
  }

  export msg(): string {
    return this.text
  }

  // Every attribute in the order it was added, as `Attr`s: built on each
  // call, for a handler of your own. The shipped handlers read the inline
  // fields instead and build none.
  export attrs(): []Attr {
    let out = []Attr(0)
    let i = 0
    while (i < this.n) {
      out = append(out, this.attrAt(i))
      i = i + 1
    }
    return concatAttrs(out, this.more)
  }

  // The empty key is a bug at the call site, so it panics even when the
  // record is disabled; a disabled record keeps nothing.
  put(key: string, code: int, num: int, flt: f64, str: string): Record {
    requireKey(key)
    if (this.h == nil) {
      return this
    }
    if (this.n == inlineAttrs) {
      let a = Attr{ key = key, kind = kindOf(code), num = num, flt = flt, str = str }
      this.more = append(this.more, a)
      return this
    }
    this.codes[this.n] = code
    this.nums[this.n] = num
    this.flts[this.n] = flt
    this.setSlot(key, str)
    this.n = this.n + 1
    return this
  }

  setSlot(key: string, str: string) {
    if (this.n == 0) {
      this.k0 = key
      this.s0 = str
    } else if (this.n == 1) {
      this.k1 = key
      this.s1 = str
    } else if (this.n == 2) {
      this.k2 = key
      this.s2 = str
    } else if (this.n == 3) {
      this.k3 = key
      this.s3 = str
    } else {
      this.k4 = key
      this.s4 = str
    }
  }

  keyAt(i: int): string {
    if (i == 0) {
      return this.k0
    }
    if (i == 1) {
      return this.k1
    }
    if (i == 2) {
      return this.k2
    }
    if (i == 3) {
      return this.k3
    }
    return this.k4
  }

  strAt(i: int): string {
    if (i == 0) {
      return this.s0
    }
    if (i == 1) {
      return this.s1
    }
    if (i == 2) {
      return this.s2
    }
    if (i == 3) {
      return this.s3
    }
    return this.s4
  }

  kindAt(i: int): Kind {
    return kindOf(this.codes[i])
  }

  attrAt(i: int): Attr {
    return Attr{
      key = this.keyAt(i),
      kind = this.kindAt(i),
      num = this.nums[i],
      flt = this.flts[i],
      str = this.strAt(i),
      group = []Attr(0),
    }
  }
}

// How many attributes a record holds in its own fields; the size of the
// `[5]` arrays above.
const inlineAttrs: int = 5

// A Kind as the int an inline slot stores: a fixed array holds only scalars.
const codeString: int = 0
const codeInt: int = 1
const codeFloat: int = 2
const codeBool: int = 3
const codeDuration: int = 4
const codeError: int = 5

fn kindOf(code: int): Kind {
  if (code == codeInt) {
    return Kind.Int
  }
  if (code == codeFloat) {
    return Kind.Float
  }
  if (code == codeBool) {
    return Kind.Bool
  }
  if (code == codeDuration) {
    return Kind.Duration
  }
  if (code == codeError) {
    return Kind.Error
  }
  return Kind.String
}

// The record a disabled `Logger.at` returns: no handler, so every method
// returns before writing a field, which is what lets every task share it.
let offRecord: Record = Record{ n = 0 }

// Where records go. `enabled` is asked first, with only the level, so a
// disabled call never builds a `Record`. `with` and `withGroup` return a
// child handler and leave the receiver untouched.
export interface Handler {
  enabled(level: int): bool,
  handle(r: Record): ()!,
  with(attrs: []Attr): Handler,
  withGroup(name: string): Handler,
}

// Anything a handler can write a finished line to. `std/io`'s `Writer`
// satisfies it, so does any class with a `write(s: string): ()!` method.
export interface Sink {
  write(s: string): ()!,
}

// --- shared handler state -------------------------------------------------

// One nesting level: the group name that opened it ("" for the root), the
// attributes added while it was the innermost group, and the text key prefix
// every group up to it spells (`a.b.`), built once here so a record never
// concatenates it.
class frame {
  group: string,
  prefix: string,
  attrs: []Attr,
}

fn rootFrames(): []frame {
  return []frame{ frame{ group = "", prefix = "", attrs = []Attr(0) } }
}

// `frames` with `attrs` added to the innermost group; `frames` itself is not
// modified, a child handler shares nothing mutable with its parent.
fn framesWith(frames: []frame, attrs: []Attr): []frame {
  let last = len(frames) - 1
  let out = []frame(0)
  let i = 0
  while (i < last) {
    out = append(out, frames[i])
    i = i + 1
  }
  out = append(
    out,
    frame{
      group = frames[last].group,
      prefix = frames[last].prefix,
      attrs = concatAttrs(frames[last].attrs, attrs),
    },
  )
  return out
}

fn framesGroup(frames: []frame, name: string): []frame {
  requireKey(name)
  let out = []frame(0)
  let i = 0
  while (i < len(frames)) {
    out = append(out, frames[i])
    i = i + 1
  }
  let prefix = frames[len(frames) - 1].prefix + name + "."
  return append(out, frame{ group = name, prefix = prefix, attrs = []Attr(0) })
}

fn concatAttrs(a: []Attr, b: []Attr): []Attr {
  let out = []Attr(0)
  let i = 0
  while (i < len(a)) {
    out = append(out, a[i])
    i = i + 1
  }
  i = 0
  while (i < len(b)) {
    out = append(out, b[i])
    i = i + 1
  }
  return out
}

// A handler formats every record into one buffer it keeps, under its mutex,
// so an enabled record allocates only the line it hands the sink. Records
// are appended after one another and the buffer is emptied only once it
// holds this many bytes: re-slicing makes a new slice header, an object, so
// emptying it per record would cost one. A buffer grown past twice this by
// one huge record is dropped rather than kept for the life of the handler.
const maxKeptBuf: int = 16384

// Hands the record at `buf[start:]` to `out` as one line and releases `mu`,
// which the caller took before formatting: holding it across both keeps the
// shared buffer to one task and keeps lines from two tasks from interleaving
// on a sink that is not itself atomic.
fn writeLocked(mu: Mutex, out: Sink, buf: []byte, start: int): ()! {
  out.write(string(buf[start:len(buf)])) catch e {
    mu.unlock()
    fail e
  }
  mu.unlock()
}

// `buf` to append the next record to: as it is while it holds fewer than
// `maxKeptBuf` bytes, emptied once it holds more, and a fresh one when a
// record grew it past twice that.
fn reuseBuf(buf: []byte): []byte {
  if (len(buf) < maxKeptBuf) {
    return buf
  }
  if (cap(buf) > 2 * maxKeptBuf) {
    return []byte(0)
  }
  return buf[0:0]
}

// --- formatting straight into a buffer -------------------------------------
//
// The handlers' scalars, appended as bytes with no intermediate string, each
// byte-identical to the interpolation it replaces.

// `v` in decimal, `"${v}"`'s bytes. Works in negative space so the most
// negative int needs no special case.
fn appendInt(buf: []byte, v: int): []byte {
  let n = v
  if (v < 0) {
    buf = append(buf, '-')
  } else {
    n = -v
  }
  let p = 1
  while (n / p <= -10) {
    p = p * 10
  }
  while (p > 0) {
    buf = append(buf, u8(48 - n / p % 10))
    p = p / 10
  }
  return buf
}

// `v` (0 or more) zero-padded to at least `width` digits.
fn appendPad(buf: []byte, v: int, width: int): []byte {
  let p = 1
  let w = 1
  while (w < width) {
    p = p * 10
    w = w + 1
  }
  while (p > 1 && v < p) {
    buf = append(buf, '0')
    p = p / 10
  }
  buf = appendInt(buf, v)
  return buf
}

// `levelName(level)`'s bytes.
fn appendLevel(buf: []byte, level: int): []byte {
  let base = levelBase(level)
  buf = append(buf, baseName(base))
  if (level > base) {
    buf = append(buf, '+')
  }
  if (level != base) {
    buf = appendInt(buf, level - base)
  }
  return buf
}

// A Timestamp's `toString()` bytes for `ns` nanoseconds since the epoch:
// RFC 3339 in UTC, `2026-09-01T05:00:00Z`, nine fraction digits when the
// nanoseconds are not zero. The date is Hinnant's civil-from-days, the same
// arithmetic std/time's calendar uses.
fn appendTime(buf: []byte, ns: int): []byte {
  let secs = floorDiv(ns, 1000000000)
  let nanos = ns - secs * 1000000000
  let days = floorDiv(secs, 86400)
  let rem = secs - days * 86400
  let z = days + 719468
  let era = floorDiv(z, 146097)
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let month = mp + 3
  if (mp >= 10) {
    month = mp - 9
  }
  let year = yoe + era * 400
  if (month <= 2) {
    year = year + 1
  }
  buf = appendPad(buf, year, 4)
  buf = append(buf, '-')
  buf = appendPad(buf, month, 2)
  buf = append(buf, '-')
  buf = appendPad(buf, doy - (153 * mp + 2) / 5 + 1, 2)
  buf = append(buf, 'T')
  buf = appendClock(buf, rem, nanos)
  return buf
}

// `HH:MM:SS[.nnnnnnnnn]Z` for `rem` seconds into the day.
fn appendClock(buf: []byte, rem: int, nanos: int): []byte {
  buf = appendPad(buf, rem / 3600, 2)
  buf = append(buf, ':')
  buf = appendPad(buf, rem % 3600 / 60, 2)
  buf = append(buf, ':')
  buf = appendPad(buf, rem % 60, 2)
  if (nanos != 0) {
    buf = append(buf, '.')
    buf = appendPad(buf, nanos, 9)
  }
  buf = append(buf, 'Z')
  return buf
}

// `a / b` rounded toward negative infinity, for `b > 0`: an instant before
// 1970 has a negative `ns`, and `/` truncates toward zero.
fn floorDiv(a: int, b: int): int {
  let q = a / b
  if (a - q * b < 0) {
    q = q - 1
  }
  return q
}

fn requireSink(out: Sink) {
  if (out == nil) {
    panic("log: a handler needs a sink; pass std/io's stderr() or any class with write(s: string): ()!")
  }
}
