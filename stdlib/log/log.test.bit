// stdlib/log tests: levels and the filter, byte-exact text and JSON for every
// attribute kind, log injection, with/withGroup children, the process default
// and the disabled-call allocation floor (the byte count is proven by a
// BIT_GC_STATS run recorded on the ticket, since a test cannot read the GC).

import { Timestamp } from "std/time"
import { contains } from "std/strings"
import { runRecovering } from "std/runtime"

// A sink that keeps every write, so a test can read the exact bytes.
class capture {
  out: string
  writes: int
  export write(s: string): ()! {
    this.out = this.out + s
    this.writes = this.writes + 1
  }
}

fn newCapture(): capture {
  return capture{ out = "", writes = 0 }
}

fn textLogger(c: capture, level: int): Logger {
  return Logger(TextHandler(c, level, false))
}

fn jsonLogger(c: capture, level: int): Logger {
  return Logger(JsonHandler(c, level, false))
}

test "levelName names the four levels and offsets the rest" {
  assert(levelName(LevelDebug) == "DEBUG", levelName(LevelDebug))
  assert(levelName(LevelInfo) == "INFO", levelName(LevelInfo))
  assert(levelName(LevelWarn) == "WARN", levelName(LevelWarn))
  assert(levelName(LevelError) == "ERROR", levelName(LevelError))
  assert(levelName(LevelInfo + 2) == "INFO+2", levelName(LevelInfo + 2))
  assert(levelName(LevelDebug - 4) == "DEBUG-4", levelName(LevelDebug - 4))
  assert(levelName(LevelDebug + 3) == "DEBUG+3", levelName(LevelDebug + 3))
  assert(levelName(LevelError + 1) == "ERROR+1", levelName(LevelError + 1))
}

test "each level method writes its own level and the filter drops the rest" {
  let c = newCapture()
  let l = textLogger(c, LevelWarn)
  l.debug().log("d")
  l.info().log("i")
  l.warn().log("w")
  l.error().log("e")
  l.at(LevelWarn + 2).log("custom")
  l.at(LevelInfo + 2).log("below")
  assert(c.out == "level=WARN msg=w\nlevel=ERROR msg=e\nlevel=WARN+2 msg=custom\n", c.out)
  assert(c.writes == 3, "one write per record")
  assert(l.enabled(LevelError))
  assert(!l.enabled(LevelInfo))
}

test "debug level lets every named level through" {
  let c = newCapture()
  let l = textLogger(c, LevelDebug)
  l.debug().log("d")
  l.info().log("i")
  assert(c.out == "level=DEBUG msg=d\nlevel=INFO msg=i\n", c.out)
}

// `g.a=1 g.h.b=2`: a group holding a string and a group.
fn nested(): Record {
  return attrs().str("a", "1").group("h", attrs().int("b", 2))
}

test "text output is byte exact for every attribute kind" {
  let c = newCapture()
  let l = textLogger(c, LevelInfo)
  let r = l.info().str("s", "plain").str("empty", "").str("spaced", "a b").int("n", -42)
  r = r.float("f", 1.5).bool("yes", true).bool("no", false).duration("d", 1500000000)
  r = r.duration("ms", 340000000).duration("neg", -2500).time("t", Timestamp{ ns = 0 })
  r.err(newError("boom")).group("g", nested()).log("hello world")
  let want = "level=INFO msg=\"hello world\" s=plain empty=\"\" spaced=\"a b\" n=-42 f=1.5 yes=true no=false d=1.5s ms=340ms neg=-2.5us t=1970-01-01T00:00:00Z error=boom g.a=1 g.h.b=2\n"
  assert(c.out == want, c.out)
}

test "json output is byte exact for every attribute kind" {
  let c = newCapture()
  let l = jsonLogger(c, LevelInfo)
  let r = l.info().str("s", "plain").int("n", -42).float("f", 1.5).float("whole", 2.0)
  r = r.bool("yes", true).bool("no", false).duration("d", 1500000000)
  r = r.time("t", Timestamp{ ns = 0 }).err(newError("boom")).group("g", nested())
  r.group("empty", attrs()).log("hello")
  let want = "{\"level\":\"INFO\",\"msg\":\"hello\",\"s\":\"plain\",\"n\":-42,\"f\":1.5,\"whole\":2.0,\"yes\":true,\"no\":false,\"d\":1500000000,\"t\":\"1970-01-01T00:00:00Z\",\"error\":\"boom\",\"g\":{\"a\":\"1\",\"h\":{\"b\":2}}}\n"
  assert(c.out == want, c.out)
}

test "a newline, quote or control byte in a value cannot forge a second line" {
  let evil = "x\nlevel=ERROR msg=forged\r\t\"q\"\\ \u{1}"
  let c = newCapture()
  textLogger(c, LevelInfo).info().str(evil, evil).log(evil)
  let lines = 0
  let i = 0
  while (i < len(c.out)) {
    if (c.out[i] == '\n') {
      lines = lines + 1
    }
    i = i + 1
  }
  assert(lines == 1, "text: exactly one line, got ${lines}: ${c.out}")
  assert(c.out[len(c.out) - 1] == '\n', "text: the one newline ends the line")
  let cj = newCapture()
  jsonLogger(cj, LevelInfo).info().str(evil, evil).log(evil)
  let jl = 0
  i = 0
  while (i < len(cj.out)) {
    if (cj.out[i] == '\n') {
      jl = jl + 1
    }
    i = i + 1
  }
  assert(jl == 1, "json: exactly one line, got ${jl}: ${cj.out}")
}

test "a bare newline or carriage return alone is escaped, not written" {
  let c = newCapture()
  textLogger(c, LevelInfo).info().str("k", "x\ny").str("r", "p\rq").log("a\nb")
  assert(c.out == "level=INFO msg=\"a\\nb\" k=\"x\\ny\" r=\"p\\rq\"\n", c.out)
}

test "text quoting: bare when safe, JSON-escaped when not" {
  let c = newCapture()
  textLogger(c, LevelInfo).info().str("a", "x=y").str("b", "q\"r").str("c", "t\tu").str("d k", "v").log("m")
  assert(c.out == "level=INFO msg=m a=\"x=y\" b=\"q\\\"r\" c=\"t\\tu\" \"d k\"=v\n", c.out)
}

test "with and withGroup children keep their attributes and leave the parent alone" {
  let c = newCapture()
  let root = textLogger(c, LevelInfo)
  let req = root.with(attrs().str("req", "7"))
  let db = req.withGroup("db").with(attrs().str("table", "drafts"))
  db.info().int("rows", 3).log("q")
  req.info().log("r")
  root.info().log("p")
  let want = "level=INFO msg=q req=7 db.table=drafts db.rows=3\nlevel=INFO msg=r req=7\nlevel=INFO msg=p\n"
  assert(c.out == want, c.out)
}

test "json children nest groups and drop an empty one" {
  let c = newCapture()
  let root = jsonLogger(c, LevelInfo)
  let db = root.with(attrs().str("req", "7")).withGroup("db").with(attrs().str("table", "drafts"))
  db.info().int("rows", 3).log("q")
  db.withGroup("empty").info().log("e")
  root.withGroup("unused").info().log("u")
  let want = "{\"level\":\"INFO\",\"msg\":\"q\",\"req\":\"7\",\"db\":{\"table\":\"drafts\",\"rows\":3}}\n{\"level\":\"INFO\",\"msg\":\"e\",\"req\":\"7\",\"db\":{\"table\":\"drafts\"}}\n{\"level\":\"INFO\",\"msg\":\"u\"}\n"
  assert(c.out == want, c.out)
}

test "the time field is RFC 3339 and comes first" {
  let c = newCapture()
  Logger(TextHandler(c)).info().log("m")
  assert(c.out[0:5] == "time=", c.out)
  assert(contains(c.out, "Z level=INFO msg=m\n"), c.out)
  let cj = newCapture()
  Logger(JsonHandler(cj)).info().log("m")
  assert(cj.out[0:9] == "{\"time\":\"", cj.out)
  assert(contains(cj.out, "Z\",\"level\":\"INFO\",\"msg\":\"m\"}\n"), cj.out)
}

test "an empty key or group name panics" {
  let (p1, m1) = runRecovering(() => {
    attrs().str("", "v")
  })
  assert(p1 && contains(m1, "key must not be empty"), m1)
  let (p2, m2) = runRecovering(() => {
    attrs().group("", attrs())
  })
  assert(p2 && contains(m2, "key must not be empty"), m2)
  let (p3, m3) = runRecovering(() => {
    textLogger(newCapture(), LevelInfo).withGroup("")
  })
  assert(p3 && contains(m3, "key must not be empty"), m3)
}

test "a nil handler and a nil sink are refused at construction" {
  let (p1, m1) = runRecovering(() => {
    Logger(nil)
  })
  assert(p1 && contains(m1, "Logger needs a handler"), m1)
  let (p2, m2) = runRecovering(() => {
    TextHandler(nil)
  })
  assert(p2 && contains(m2, "needs a sink"), m2)
  let (p3, m3) = runRecovering(() => {
    JsonHandler(nil)
  })
  assert(p3 && contains(m3, "needs a sink"), m3)
}

test "a handler of your own plugs in through the interface" {
  let h = tally{ n = 0 }
  let l = Logger(h)
  l.info().log("a")
  l.debug().log("b")
  l.warn().log("c")
  assert(h.n == 2, "debug is disabled by the handler")
}

class tally {
  n: int
  export enabled(level: int): bool {
    return level >= LevelInfo
  }
  export handle(r: Record): ()! {
    this.n = this.n + 1
  }
  export with(attrs: []Attr): Handler {
    return this
  }
  export withGroup(name: string): Handler {
    return this
  }
}

test "a failing sink drops the line instead of crashing the caller" {
  let l = Logger(TextHandler(brokenSink{ n = 0 }, LevelInfo, false))
  l.info().log("lost")
  l.info().log("lost again")
}

class brokenSink {
  n: int
  export write(s: string): ()! {
    fail newError("closed pipe")
  }
}

test "the process default is a Logger and setDefault replaces it once" {
  assert(getDefault().enabled(LevelInfo), "default logs at info")
  assert(!getDefault().enabled(LevelDebug), "default hides debug")
  let c = newCapture()
  setDefault(textLogger(c, LevelDebug))
  getDefault().debug().log("now captured")
  assert(c.out == "level=DEBUG msg=\"now captured\"\n", c.out)
  let (p, m) = runRecovering(() => {
    setDefault(textLogger(c, LevelDebug))
  })
  assert(p && contains(m, "setDefault called twice"), m)
}

test "ten thousand disabled calls with attributes write nothing" {
  let c = newCapture()
  let l = textLogger(c, LevelError)
  let i = 0
  while (i < 10000) {
    l.debug().str("k", "v").int("i", i).log("never")
    i = i + 1
  }
  assert(c.writes == 0, "disabled calls reach no sink")
}

// #7435: the handlers append ints, durations, levels and times as bytes. Each
// appender is held to the string it replaced: `"${v}"`, `levelName`,
// `Timestamp.toString()` and the unit rule `durationRef` restates below.
fn appended(b: []byte): string {
  return string(b)
}

fn durationRef(d: int): string {
  if (d < 0) {
    return "-" + durationRef(-d)
  }
  if (d < 1000) {
    return "${d}ns"
  }
  if (d < 1000000) {
    return unitRef(d, 1000, 3, "us")
  }
  if (d < 1000000000) {
    return unitRef(d, 1000000, 6, "ms")
  }
  return unitRef(d, 1000000000, 9, "s")
}

fn unitRef(d: int, unit: int, digits: int, name: string): string {
  let rem = d % unit
  if (rem == 0) {
    return "${d / unit}${name}"
  }
  let frac = "${rem}"
  while (len(frac) < digits) {
    frac = "0" + frac
  }
  let end = len(frac)
  while (frac[end - 1] == '0') {
    end = end - 1
  }
  return "${d / unit}.${frac[0:end]}${name}"
}

test "ints, levels and durations append the bytes their strings had" {
  let ints = []int{
    0, 1, 9, 10, -1, -9, -10, 99, 100, 1234567890, -42,
    9223372036854775807, -9223372036854775807 - 1,
  }
  for v of ints {
    let got = appended(appendInt([]byte(0), v))
    assert(got == "${v}", "appendInt ${v}: ${got}")
  }
  let lv = LevelDebug - 9
  while (lv <= LevelError + 9) {
    let got = appended(appendLevel([]byte(0), lv))
    assert(got == levelName(lv), "appendLevel ${lv}: ${got}")
    lv = lv + 1
  }
  let ds = []int{
    0, 1, 999, 1000, 1001, 1500, 999999, 1000000, 1000010, 340000000,
    999999999, 1000000000, 1500000000, 1000000001, 90000000000, 3600000000000,
    -1, -2500, -999999, -1500000000, 9223372036854775807,
  }
  for d of ds {
    let got = appended(appendDuration([]byte(0), d))
    assert(got == durationRef(d), "appendDuration ${d}: ${got} want ${durationRef(d)}")
  }
  let minDur = appended(appendDuration([]byte(0), -9223372036854775807 - 1))
  assert(minDur == "-9223372036.854775808s", minDur)
}

test "a time appends the bytes Timestamp.toString() has" {
  let ns = []int{
    0, 1, -1, 500, 999999999, 1000000000, -1000000000, -1000000001,
    951782400000000000, 951868800000000000, 1709164800123456789,
    1798761599999999999, 4102444800000000000, 9223372036854775807,
    -9223372036854775807 - 1, -62135596800000000 / 1000,
  }
  for v of ns {
    let want = Timestamp{ ns = v }.toString()
    let got = appended(appendTime([]byte(0), v))
    assert(got == want, "appendTime ${v}: ${got} want ${want}")
  }
  let t = -9000000000000000000
  while (t < 9000000000000000000) {
    let want = Timestamp{ ns = t }.toString()
    let got = appended(appendTime([]byte(0), t))
    assert(got == want, "appendTime ${t}: ${got} want ${want}")
    t = t + 7777777777777777
  }
}

// --- the record: five attributes inline, the rest in order after them ---

class errBoom {
  export message(): string {
    return "boom"
  }
}

// Seven attributes with a group third, so the group and everything after it
// leave the inline slots and the order must still hold.
fn sevenAttrs(l: Logger) {
  let r = l.info().str("s", "a b").int("n", -42).group("g", attrs().bool("x", true))
  r.duration("d", 1500).err(errBoom{}).time("t", Timestamp{ ns = 1 }).str("last", "z").log("m")
}

test "attributes past the five held inline, and a group among them, keep their order" {
  let c = newCapture()
  sevenAttrs(textLogger(c, LevelInfo))
  let want = "level=INFO msg=m s=\"a b\" n=-42 g.x=true d=1.5us error=boom t=1970-01-01T00:00:00.000000001Z last=z\n"
  assert(c.out == want && c.writes == 1, c.out)
  let cj = newCapture()
  sevenAttrs(jsonLogger(cj, LevelInfo))
  let wj = "{\"level\":\"INFO\",\"msg\":\"m\",\"s\":\"a b\",\"n\":-42,\"g\":{\"x\":true},\"d\":1500,\"error\":\"boom\",\"t\":\"1970-01-01T00:00:00.000000001Z\",\"last\":\"z\"}\n"
  assert(cj.out == wj && cj.writes == 1, cj.out)
}

test "twelve attributes fill chained records and keep their order" {
  let c = newCapture()
  let cj = newCapture()
  let k = keeper{ recs = []Record(0) }
  let loggers = [textLogger(c, LevelInfo), jsonLogger(cj, LevelInfo), Logger(k)]
  for l of loggers {
    let r = l.info()
    let i = 0
    while (i < 12) {
      r = r.int("a${i}", i)
      i = i + 1
    }
    r.str("s", "end").log("m")
  }
  let want = "level=INFO msg=m"
  let wj = "{\"level\":\"INFO\",\"msg\":\"m\""
  let i = 0
  while (i < 12) {
    want = want + " a${i}=${i}"
    wj = wj + ",\"a${i}\":${i}"
    i = i + 1
  }
  assert(c.out == want + " s=end\n", c.out)
  assert(cj.out == wj + ",\"s\":\"end\"}\n", cj.out)
  let all = k.recs[0].attrs()
  assert(
    len(all) == 13 && all[7].key == "a7" && all[7].num == 7 && all[12].str == "end",
    "${len(all)}",
  )
}

test "a disabled level writes nothing and still rejects an empty key" {
  let c = newCapture()
  textLogger(c, LevelWarn).info().str("k", "v").err(errBoom{}).group("g", attrs().int("i", 1)).log("dropped")
  assert(c.writes == 0, c.out)
  let (p, m) = runRecovering(() => {
    textLogger(c, LevelWarn).info().int("", 1)
  })
  assert(p && contains(m, "key must not be empty"), m)
}

test "log() on a record from attrs() panics: it has no logger" {
  let (p, m) = runRecovering(() => {
    attrs().str("k", "v").log("lost")
  })
  assert(p && contains(m, "has no logger"), m)
}

class keeper {
  recs: []Record
  export enabled(level: int): bool {
    return true
  }
  export handle(r: Record): ()! {
    this.recs = append(this.recs, r)
  }
  export with(attrs: []Attr): Handler {
    return this
  }
  export withGroup(name: string): Handler {
    return this
  }
}

test "a handler of your own reads the record's level, message, time and attrs" {
  let k = keeper{ recs = []Record(0) }
  let l = Logger(k)
  sevenAttrs(l)
  l.warn().int("a", 1).time("t", Timestamp{ ns = 0 }).log("v")
  let r = k.recs[0]
  assert(r.level() == LevelInfo && r.message() == "m" && r.unixNanos() > 0, r.message())
  let all = r.attrs()
  assert(len(all) == 7, "${len(all)}")
  assert(all[1].kind == Kind.Int && all[1].num == -42, all[1].key)
  assert(all[2].kind == Kind.Group && len(all[2].group) == 1, all[2].key)
  assert(all[4].kind == Kind.Error && all[4].str == "boom", all[4].key)
  assert(all[6].key == "last" && all[6].str == "z", all[6].key)
  let v = k.recs[1].attrs()
  assert(k.recs[1].level() == LevelWarn && len(v) == 2 && v[0].num == 1, k.recs[1].message())
  assert(v[1].kind == Kind.Time && v[1].str == "1970-01-01T00:00:00Z", v[1].str)
}

test "records appended past the kept buffer's size each write their own line" {
  let c = newCapture()
  let l = jsonLogger(c, LevelInfo)
  let i = 0
  while (i < 2000) {
    l.info().int("i", i).log("r")
    i = i + 1
  }
  let want = ""
  i = 0
  while (i < 2000) {
    want = want + "{\"level\":\"INFO\",\"msg\":\"r\",\"i\":${i}}\n"
    i = i + 1
  }
  assert(c.writes == 2000 && c.out == want, "${c.writes} writes")
}
