// Bit standard library — std/log: TextHandler, one `key=value` line per record.
//
// A value that is empty or holds a space, `=`, `"`, `\` or a control byte is
// quoted with std/json's string escaping, so a newline in a value is the two
// characters `\n` and can never start a second log line (log injection,
// OWASP). Keys get the same treatment. One record is one `write` call.

// `time=… level=INFO msg=hello k=v`, the first three omitted or not as
// configured. Build it with `TextHandler(out)`.
export class TextHandler {
  out: Sink
  mu: Mutex
  level: int
  stamps: bool
  frames: []frame

  init(out: Sink, level: int = LevelInfo, timestamps: bool = true) {
    requireSink(out)
    this.out = out
    this.mu = Mutex()
    this.level = level
    this.stamps = timestamps
    this.frames = rootFrames()
  }

  export enabled(level: int): bool {
    return level >= this.level
  }

  export handle(r: Record): ()! {
    let buf = []byte(0)
    if (this.stamps) {
      buf = jsonAppendRaw(buf, "time=" + r.time.toString() + " ")
    }
    buf = jsonAppendRaw(buf, "level=" + levelName(r.level) + " msg=")
    buf = textToken(buf, r.msg)
    let prefix = ""
    let i = 0
    while (i < len(this.frames)) {
      let f = this.frames[i]
      if (f.group != "") {
        prefix = prefix + f.group + "."
      }
      buf = textAttrs(buf, prefix, f.attrs)
      i = i + 1
    }
    buf = textAttrs(buf, prefix, r.attrs)
    writeLine(this.mu, this.out, string(jsonAppendRaw(buf, "\n")))?
  }

  export with(attrs: []Attr): Handler {
    return this.child(framesWith(this.frames, attrs))
  }

  export withGroup(name: string): Handler {
    return this.child(framesGroup(this.frames, name))
  }

  child(frames: []frame): TextHandler {
    let h = TextHandler(this.out, this.level, this.stamps)
    h.mu = this.mu
    h.frames = frames
    return h
  }
}

fn textAttrs(buf: []byte, prefix: string, attrs: []Attr): []byte {
  let i = 0
  while (i < len(attrs)) {
    buf = textAttr(buf, prefix, attrs[i])
    i = i + 1
  }
  return buf
}

fn textAttr(buf: []byte, prefix: string, a: Attr): []byte {
  if (a.kind == Kind.Group) {
    return textAttrs(buf, prefix + a.key + ".", a.group)
  }
  buf = textToken(jsonAppendRaw(buf, " "), prefix + a.key)
  return textToken(jsonAppendRaw(buf, "="), textValue(a))
}

// The unquoted text of a scalar attribute.
fn textValue(a: Attr): string {
  if (a.kind == Kind.Int) {
    return "${a.num}"
  }
  if (a.kind == Kind.Float) {
    return "${a.flt}"
  }
  if (a.kind == Kind.Bool) {
    return boolText(a.num != 0)
  }
  if (a.kind == Kind.Duration) {
    return durationText(a.num)
  }
  return a.str
}

// Nanoseconds as the largest unit that keeps the integer part nonzero
// (ns, us, ms, s), with the fraction kept and trailing zeros trimmed:
// 1500000000 is "1.5s", 340000 is "340us", -2500 is "-2.5us". Seconds stay
// seconds however large; "90s" beats a second notation to parse in a pipeline.
fn durationText(d: int): string {
  if (d < 0) {
    return "-" + durationText(-d)
  }
  if (d < 1000) {
    return "${d}ns"
  }
  if (d < 1000000) {
    return unitText(d, 1000, 3, "us")
  }
  if (d < 1000000000) {
    return unitText(d, 1000000, 6, "ms")
  }
  return unitText(d, 1000000000, 9, "s")
}

fn unitText(d: int, unit: int, digits: int, name: string): string {
  let whole = d / unit
  let rem = d % unit
  if (rem == 0) {
    return "${whole}${name}"
  }
  let frac = "${rem}"
  while (len(frac) < digits) {
    frac = "0" + frac
  }
  let end = len(frac)
  while (frac[end - 1] == '0') {
    end = end - 1
  }
  return "${whole}.${frac[0:end]}${name}"
}

fn boolText(b: bool): string {
  if (b) {
    return "true"
  }
  return "false"
}

// `s` as it appears after `key=`: bare when it is safe, a JSON string
// literal when it is empty or holds a byte that would end or fake a token.
fn textToken(buf: []byte, s: string): []byte {
  if (needsQuote(s)) {
    return jsonAppendString(buf, s)
  }
  return jsonAppendRaw(buf, s)
}

fn needsQuote(s: string): bool {
  if (len(s) == 0) {
    return true
  }
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c <= ' ' || c == '"' || c == '=' || c == '\\' || c == 127) {
      return true
    }
    i = i + 1
  }
  return false
}
