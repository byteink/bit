// Bit standard library — std/log: TextHandler, one `key=value` line per record.
//
// A value that is empty or holds a space, `=`, `"`, `\` or a control byte is
// quoted with std/json's string escaping, so a newline in a value is the two
// characters `\n` and can never start a second log line (log injection,
// OWASP). Keys get the same treatment. One record is one `write` call.

// `time=… level=INFO msg=hello k=v`, the first three omitted or not as
// configured. Build it with `TextHandler(out)`.
export class TextHandler {
  out: Sink
  mu: Mutex
  buf: []byte
  level: int
  stamps: bool
  frames: []frame

  init(out: Sink, level: int = LevelInfo, timestamps: bool = true) {
    requireSink(out)
    this.out = out
    this.mu = Mutex()
    this.buf = []byte(0)
    this.level = level
    this.stamps = timestamps
    this.frames = rootFrames()
  }

  export enabled(level: int): bool {
    return level >= this.level
  }

  export handle(r: Record): ()! {
    this.mu.lock()
    let buf = reuseBuf(this.buf)
    let start = len(buf)
    if (this.stamps) {
      buf = append(buf, "time=")
      buf = appendTime(buf, r.ns)
      buf = append(buf, ' ')
    }
    buf = append(buf, "level=")
    buf = appendLevel(buf, r.lvl)
    buf = append(buf, " msg=")
    buf = textToken(buf, r.text)
    let i = 0
    while (i < len(this.frames)) {
      buf = textAttrs(buf, this.frames[i].prefix, this.frames[i].attrs)
      i = i + 1
    }
    let prefix = this.frames[len(this.frames) - 1].prefix
    buf = textInline(buf, prefix, r)
    buf = textAttrs(buf, prefix, r.more)
    buf = append(buf, '\n')
    this.buf = buf
    writeLocked(this.mu, this.out, buf, start)?
  }

  export with(attrs: []Attr): Handler {
    return this.child(framesWith(this.frames, attrs))
  }

  export withGroup(name: string): Handler {
    return this.child(framesGroup(this.frames, name))
  }

  child(frames: []frame): TextHandler {
    let h = TextHandler(this.out, this.level, this.stamps)
    h.mu = this.mu
    h.frames = frames
    return h
  }
}

fn textAttrs(buf: []byte, prefix: string, attrs: []Attr): []byte {
  let i = 0
  while (i < len(attrs)) {
    buf = textAttr(buf, prefix, attrs[i])
    i = i + 1
  }
  return buf
}

fn textAttr(buf: []byte, prefix: string, a: Attr): []byte {
  if (a.kind == Kind.Group) {
    return textAttrs(buf, prefix + a.key + ".", a.group)
  }
  buf = append(buf, ' ')
  buf = textKey(buf, prefix, a.key)
  buf = append(buf, '=')
  buf = textValue(buf, a.kind, a.num, a.flt, a.str)
  return buf
}

// The attributes `r` holds in its own fields, written as `textAttr` writes
// an `Attr`; an inline slot is never a group.
fn textInline(buf: []byte, prefix: string, r: Record): []byte {
  let i = 0
  while (i < r.n) {
    buf = append(buf, ' ')
    buf = textKey(buf, prefix, r.keyAt(i))
    buf = append(buf, '=')
    buf = textValue(buf, r.kindAt(i), r.nums[i], r.flts[i], r.strAt(i))
    i = i + 1
  }
  return buf
}

// `prefix + key` as a token, concatenated only on the quoting path.
fn textKey(buf: []byte, prefix: string, key: string): []byte {
  if (len(prefix) + len(key) == 0 || hasUnsafe(prefix) || hasUnsafe(key)) {
    return jsonAppendString(buf, prefix + key)
  }
  buf = append(buf, prefix)
  buf = append(buf, key)
  return buf
}

// A scalar attribute's value: numbers, durations and bools as their digits
// and letters, which never need quoting; text through `textToken`.
fn textValue(buf: []byte, kind: Kind, num: int, flt: f64, str: string): []byte {
  if (kind == Kind.Int) {
    return appendInt(buf, num)
  }
  if (kind == Kind.Float) {
    return textToken(buf, "${flt}")
  }
  if (kind == Kind.Bool) {
    return appendBool(buf, num != 0)
  }
  if (kind == Kind.Duration) {
    return appendDuration(buf, num)
  }
  return textToken(buf, str)
}

// Nanoseconds as the largest unit that keeps the integer part nonzero
// (ns, us, ms, s), with the fraction kept and trailing zeros trimmed:
// 1500000000 is "1.5s", 340000 is "340us", -2500 is "-2.5us". Seconds stay
// seconds however large; "90s" beats a second notation to parse in a pipeline.
fn appendDuration(buf: []byte, d: int): []byte {
  if (d < 0) {
    buf = append(buf, '-')
  }
  let unit = 1000000000
  let name = "s"
  if (d > -1000 && d < 1000) {
    unit = 1
    name = "ns"
  } else if (d > -1000000 && d < 1000000) {
    unit = 1000
    name = "us"
  } else if (d > -1000000000 && d < 1000000000) {
    unit = 1000000
    name = "ms"
  }
  buf = appendUnit(buf, d, unit, name)
  return buf
}

// `|d|` in `unit`s, `name` after it. Whole and remainder are negated
// separately, so the most negative int is never negated whole. The fraction
// is written most significant digit first and stops at the last nonzero one.
fn appendUnit(buf: []byte, d: int, unit: int, name: string): []byte {
  let whole = d / unit
  let rem = d % unit
  if (d < 0) {
    whole = -whole
    rem = -rem
  }
  buf = appendInt(buf, whole)
  if (rem != 0) {
    buf = append(buf, '.')
  }
  let p = unit / 10
  while (rem != 0) {
    buf = append(buf, u8(48 + rem / p))
    rem = rem % p
    p = p / 10
  }
  buf = append(buf, name)
  return buf
}

fn appendBool(buf: []byte, b: bool): []byte {
  if (b) {
    buf = append(buf, "true")
    return buf
  }
  buf = append(buf, "false")
  return buf
}

// `s` as it appears after `key=`: bare when it is safe, a JSON string
// literal when it is empty or holds a byte that would end or fake a token.
fn textToken(buf: []byte, s: string): []byte {
  if (len(s) == 0 || hasUnsafe(s)) {
    return jsonAppendString(buf, s)
  }
  buf = append(buf, s)
  return buf
}

// True when `s` holds a space, control byte, `"`, `=`, `\` or DEL.
fn hasUnsafe(s: string): bool {
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c <= ' ' || c == '"' || c == '=' || c == '\\' || c == 127) {
      return true
    }
    i = i + 1
  }
  return false
}
