// std/fs/secure — openBeneath/fstat (#5793), the root cause fix for #5787's
// worst finding: pkg/web's static file server validates every path
// component with `lstat` and then opens by path, so a parent directory
// swapped for a symlink to outside the served root between the check and
// the open is followed. `std/fs`'s only no-follow open, `openNoFollow`,
// refuses a symlink in the FINAL path component only (#4720) — every
// ancestor component is still an unguarded lookup.
//
// A SEPARATE submodule from "std/fs" ON PURPOSE, not a second function
// added there: compiler/ and tools/build import "std/fs" and are built by
// the pinned 0.25.0 stage0, whose libbitrt has no `bit_rt_fs_open_beneath_w`,
// `bit_rt_fs_fstat_w` or `bit_rt_fs_create_excl_w` symbol yet, so a
// reachable reference from "std/fs" breaks `rm -rf bit-out && ./make`'s
// bootstrap the way #2153 did before its revert. Nothing on the compiler's
// import path reaches this module, so a release that ships this commit can
// fold these functions into "std/fs" once the pin moves past it.
import { File, exists } from "std/fs"
import { base, clean, contains, dir, join } from "std/path"
import { sortInPlace } from "std/sort"

// `bit_rt_fs_open_beneath_w` (runtime/root/{darwin,linux}/fsbeneath.bit):
// `root` and `rel` travel SEPARATELY, not pre-joined — `root` is opened
// normally, following its own symlinks (a real deployment's configured
// static root is routinely reached through one, this machine's own
// `$TMPDIR` included); only `rel`'s resolution against `root` refuses a
// symlink in any component and a `..` that would climb out. fd, or -1 for
// a malformed `root` or `rel`, a directory, a symlink or a `..` anywhere in
// `rel`, or any other open failure alike.
extern fn bit_rt_fs_open_beneath_w(root: *byte, rootN: int, rel: *byte, relN: int): i64

// `bit_rt_fs_fstat_w`: `fd`'s metadata (size, mtime, mode, isDir, isSymlink
// — always `false`, isRegular) read from the already-open handle, not the
// path, so a caller never re-resolves a name that could have moved since
// `open` returned. 0 on success, -1 on failure.
extern fn bit_rt_fs_fstat_w(fd: i64, out: *i64): i64

const fstatOutWords: int = 6

// `statOpen`'s own metadata type — not `std/fs`'s `FileInfo`. A caller that
// opened through `openBeneath` needs one bit `FileInfo` does not carry:
// whether the file is a REGULAR file, so a FIFO, device or socket placed
// directly under a served root can be refused instead of served, or read
// from and hung on (a FIFO with no writer blocks the reading worker
// forever — the other half of #5798, alongside the outside-root read
// `openBeneath` itself closes). `std/fs`'s public `FileInfo`/`stat`/`lstat`
// are unaffected; this type exists only on this module's fd-based path.
export class OpenInfo {
  export size: i64,
  export mtime: i64,
  export mode: i64,
  export isDir: bool,
  export isSymlink: bool,
  export isRegular: bool,
}

// Open `rel`, resolved beneath `root`, refusing every symlink along the way
// and any `..` that would climb out of `root`. `root` is the trusted
// boundary — a caller's configured static-file directory, say — and is
// itself opened normally (following its own symlinks, exactly like `open`);
// only `rel`, the untrusted part of the path, gets the no-follow, no-escape
// treatment.
//
// Containment is checked TWICE, for two different reasons: `std/path`'s
// `contains` below is a lexical, pre-syscall refusal of a `..` that would
// climb out of `root` textually (cheap, and catches the common case before
// any syscall runs); the runtime's `O_NOFOLLOW_ANY`/per-component walk is
// what still holds if a symlink is planted on disk AFTER this lexical check
// passes but BEFORE the open reaches it — the exact race #5787 found.
// Neither alone is sufficient; #5787's finding is what the second one closes.
export fn openBeneath(root: string, rel: string): File! {
  if (!contains(root, join(root, rel))) {
    fail newError("openBeneath: escapes root: ${rel}")
  }
  let rootW = []byte(root)
  let relW = []byte(rel)
  let fd = bit_rt_fs_open_beneath_w(ptrOf(rootW), len(root), ptrOf(relW), len(rel))
  if (fd < 0) {
    fail newError("cannot open file beneath root: ${rel}")
  }
  return File{ fd = fd }
}

// `f`'s metadata, read from the open handle rather than re-resolving its
// path — the pairing `openBeneath` needs so a caller takes size/mtime/type
// from the SAME object it just opened, never from a second, separately
// racy path lookup. Named `statOpen`, not `fstat`: the root module keeps
// bare link names, and `fstat` collides with the libc symbol the runtime
// resolves externally (SPEC §11.7, E0096).
export fn statOpen(f: File): OpenInfo! {
  let out = []i64(fstatOutWords)
  let rc = bit_rt_fs_fstat_w(f.fd, ptrOf(out))
  if (rc < 0) {
    fail newError("fstat failed")
  }
  return OpenInfo{
    size = out[0],
    mtime = out[1],
    mode = out[2],
    isDir = out[3] != 0,
    isSymlink = out[4] != 0,
    isRegular = out[5] != 0,
  }
}

// `bit_rt_fs_create_excl_w` (runtime/root/{darwin,linux,windows}/
// fscreateexcl.bit, #5797): `O_CREAT|O_EXCL|O_NOFOLLOW` on darwin/linux
// (`CREATE_NEW` on Windows, which refuses an existing reparse point too) in
// ONE syscall/API call — the fix for pkg/kv's `create`, which checked
// `exists(path)` then opened without `O_EXCL` and followed symlinks: two
// concurrent creates on one path both succeeded, and a planted symlink at
// the target got followed and overwritten instead of refused (epic #5787's
// audit). `path`/`n` travel packed, not a Bit `string`, same convention as
// `bit_rt_fs_open_beneath_w` above. fd on success; `-2` specifically when
// the final path component already exists (of any type) — the same
// normalized three-way shape `bit_rt_fs_lock`/`bit_rt_fs_unlock` (ABI.md
// §14) already use in place of a raw, per-platform error code — so a
// caller can tell "already there" apart from every other failure, which
// gets `-1`.
extern fn bit_rt_fs_create_excl_w(path: *byte, n: int, mode: i64): i64

// Creates `path` exclusively at POSIX permission bits `mode` in ONE
// syscall/API call, closing both the exists-then-open TOCTOU window (two
// concurrent callers race the check, both win) and the symlink-follow
// hazard (a planted symlink at `path` gets opened and overwritten) that
// composing `std/fs`'s `exists` and `openReadWrite`/`create` leaves open.
// `Option.None`, not a `fail`, when something already exists at `path`:
// that is an ordinary, expected outcome for an exclusive create, not an
// error a caller should have to recover by matching `error.message()`
// text. A genuine I/O failure still `fail`s. `mode` is ignored on Windows,
// which has no POSIX permission bits (`CreateFileW`'s own ACL model
// applies instead); `CREATE_NEW` there still refuses to succeed if `path`
// already names anything, matching `O_EXCL`'s guarantee.
export fn createExclusive(path: string, mode: int): Option<File>! {
  let w = []byte(path)
  let fd = bit_rt_fs_create_excl_w(ptrOf(w), len(path), i64(mode))
  if (fd >= 0) {
    return Option.Some(File{ fd = fd })
  }
  if (fd == 0 - 2) {
    return Option.None
  }
  fail newError("cannot create file exclusively: ${path}")
}

// `bit_rt_fs_open_dir_w`/`bit_rt_fs_open_dir_beneath_fd_w`/
// `bit_rt_fs_list_dir_fd_w` (runtime/root/{darwin,linux}/fsbeneath.bit,
// #5800): the fd-based primitives `walkBeneath` below is built on. `root`
// is opened once, following its own symlinks (the trusted boundary, same as
// `openBeneath`'s `root`); every descent after that opens a listed child
// no-follow relative to the fd already held, never by re-resolving a path.
extern fn bit_rt_fs_open_dir_w(words: *byte, n: int): i64
extern fn bit_rt_fs_open_dir_beneath_fd_w(dirFd: i64, nameWords: *byte, nameN: int): i64
extern fn bit_rt_fs_list_dir_fd_w(fd: i64, outPtr: *byte, outCap: int): i64

// `bit_rt_fs_unlink_at_w` (runtime/root/{darwin,linux}/fsbeneath.bit, #5816):
// `removeAll` below's one removal primitive. Removes the single entry named
// `name`/`n` relative to the already-open directory `dirFd`, via `unlinkat` —
// never by re-resolving a path, the same fd-relative discipline
// `walkBeneath` above uses to read a tree. `isDir` selects `AT_REMOVEDIR`;
// the caller decides which by whether opening `name` as a directory
// (`bit_rt_fs_open_dir_beneath_fd_w`) just succeeded no-follow. 0 on
// success, -1 for a malformed name or any other failure.
extern fn bit_rt_fs_unlink_at_w(dirFd: i64, name: *byte, n: int, isDir: bool): i64

// Bound on `walkBeneath`'s recursion (Power of 10 rule 2), mirroring
// `std/fs`'s own private `maxWalkDepth` (stdlib/fs/fs.bit) — same value,
// same rationale (a bound on nesting depth, not a symlink-loop defence:
// `walkBeneath` never opens a symlink at all, so no link can add depth).
// A private copy rather than an import: `std/fs`'s constant is unexported,
// and duplicating one `int` is cheaper than widening that module's surface
// for it.
const maxWalkDepth: int = 64

// The primitive returns entries NUL-terminated (NUL is the one byte a POSIX
// filename cannot contain): its own private copy of `std/fs`'s
// `splitEntries` (stdlib/fs/fs.bit) rather than an export of it — that
// function is `std/fs`'s internal helper, not part of its documented public
// surface, and widening it just for this one cross-module call would owe
// `docs/stdlib/fs.md` a section (`test-stdlib-docs`) for something callers
// never call directly.
fn splitEntries(raw: string): []string {
  let out = []string(0)
  let start = 0
  let i = 0
  while (i < len(raw)) {
    if (raw[i] == 0) {
      out = append(out, raw[start:i])
      start = i + 1
    }
    i = i + 1
  }
  return out
}

// The names (not paths) of the already-open directory `fd`'s entries,
// through `bit_rt_fs_list_dir_fd_w`'s two-pass measure/fill convention —
// the fd-based twin of `std/fs`'s own path-based `readDir`. Does not close
// `fd`: `walkBeneathInto` below still needs it open to descend into each
// child.
fn listDirFd(fd: i64): []string! {
  let probe = []byte(1)
  let needed = bit_rt_fs_list_dir_fd_w(fd, ptrOf(probe), 0)
  if (needed < 0) {
    fail newError("cannot list directory")
  }
  if (needed == 0) {
    return []string(0)
  }
  let buf = []byte(needed)
  let got = bit_rt_fs_list_dir_fd_w(fd, ptrOf(buf), needed)
  if (got < 0) {
    fail newError("cannot list directory")
  }
  if (got > needed) {
    got = needed
  }
  return splitEntries(string(buf[0:got]))
}

// The race-free twin of `std/fs`'s `walk` (#5800): every *file* path
// beneath `root`, depth-first and sorted at each level, for a caller
// walking a tree an untrusted party can modify WHILE this runs (a
// multi-tenant upload directory, say). `std/fs`'s `walk` checks
// `isRealDir(p)` then calls `readDir(p)` BY PATH — two separate lookups of
// the same name, so a directory swapped for a symlink to outside `root`
// between them is followed. `walkBeneath` never re-resolves a path once it
// holds an fd: `root` is opened once (following its own symlinks, the
// trusted boundary), and every descent below it lists the CURRENTLY-open
// directory by fd and opens a listed child no-follow relative to that same
// fd — a swap of any ancestor after this walk holds its fd can no longer
// change what that fd names.
//
// Symbolic links are reported but never followed, and `root` itself is used
// as given — the same two contracts `std/fs`'s `walk` doc comment states,
// unchanged here.
export fn walkBeneath(root: string): []string! {
  let rootW = []byte(root)
  let fd = bit_rt_fs_open_dir_w(ptrOf(rootW), len(root))
  if (fd < 0) {
    fail newError("cannot open directory: ${root}")
  }
  return walkBeneathInto(fd, root, maxWalkDepth)?
}

// `defer`'s target must be a resolvable Bit function, not a bare compiler
// primitive (E0092) — `fsClose` is one of `std/fs`'s low-level primitives
// (ABI.md §14), so `walkBeneathInto`'s `defer` below wraps it in this
// one-line function instead of naming it directly.
fn closeDirFd(fd: i64) {
  fsClose(fd)
}

// `out` starts fresh every call — never assigned from a parameter — so
// growing it below is never an aliasing hazard: this function is the sole
// owner of its own backing array, and a child level's contribution is
// merged in by value (`for ... of walkBeneathInto(...)?`), not by handing
// this level's array down for a callee to grow.
fn walkBeneathInto(dirFd: i64, prefix: string, depth: int): []string! {
  defer closeDirFd(dirFd)
  if (depth <= 0) {
    fail newError("walkBeneath: directory nesting exceeds ${maxWalkDepth} at ${prefix}")
  }
  let names = listDirFd(dirFd)?
  sortInPlace(names, (a, b) => a < b)
  let out = []string(0)
  for name of names {
    let p = join(prefix, name)
    let nameW = []byte(name)
    let childFd = bit_rt_fs_open_dir_beneath_fd_w(dirFd, ptrOf(nameW), len(name))
    if (childFd >= 0) {
      for childPath of walkBeneathInto(childFd, p, depth - 1)? {
        out = append(out, childPath)
      }
    } else {
      out = append(out, p)
    }
  }
  return out
}

// The race-free twin of a hand-written recursive delete (#5816): every copy
// this ticket replaces (`_tests_/bit/pmaddgit.bit`, `pmimports.bit`,
// `pmvanityhelpers/pmvanityhelpers.bit`) does `lstat` then `readDir` then
// recurse then `remove` BY PATH — the exact shape of Rust's CVE-2022-21658:
// a directory swapped for a symlink between the check and the use is
// followed, and the "recursive delete" walks and deletes OUTSIDE the tree.
// `removeAll` never re-resolves a path once it holds an fd, the same
// invariant `walkBeneath` above gives reading: it lists the CURRENTLY-open
// directory by fd and removes a listed child relative to that same fd — a
// swap of any ancestor after this call holds its fd can no longer change
// what gets deleted.

// Remove the single entry named `name`, wherever `parentFd` says it is,
// recursing first if it turns out to be a real directory. Never re-resolves
// `name` by path: `bit_rt_fs_open_dir_beneath_fd_w` (no-follow) is the ONE
// classification this makes, and whichever branch it takes, the matching
// removal (`bit_rt_fs_unlink_at_w`) runs against the SAME `parentFd` — a
// swap of `name` itself, mid-call, cannot retarget either step, because
// neither one ever looks `name` up by path again.
//
// Each packed-bytes call gets its OWN fresh `[]byte(name)` immediately
// before the call it feeds, followed immediately by `keepAlive` — never one
// copy held across the recursive `removeChildren` call in between, which can
// allocate and would leave an earlier `ptrOf` with nothing provably keeping
// it live.
fn removeEntry(parentFd: i64, name: string, depth: int): ()! {
  if (depth <= 0) {
    fail newError("removeAll: directory nesting exceeds ${maxWalkDepth} at ${name}")
  }
  let openW = []byte(name)
  let childFd = bit_rt_fs_open_dir_beneath_fd_w(parentFd, ptrOf(openW), len(name))
  keepAlive(openW)
  if (childFd < 0) {
    let leafW = []byte(name)
    let rc = bit_rt_fs_unlink_at_w(parentFd, ptrOf(leafW), len(name), false)
    keepAlive(leafW)
    if (rc < 0) {
      fail newError("removeAll: cannot remove: ${name}")
    }
    return
  }
  removeChildren(childFd, depth - 1)?
  let dirW = []byte(name)
  let rc = bit_rt_fs_unlink_at_w(parentFd, ptrOf(dirW), len(name), true)
  keepAlive(dirW)
  if (rc < 0) {
    fail newError("removeAll: cannot remove directory: ${name}")
  }
}

// Remove every entry inside the already-open directory `dirFd`, then close
// it (`defer`). Does not remove `dirFd` itself: `removeEntry` above does
// that, one level up, once this returns.
fn removeChildren(dirFd: i64, depth: int): ()! {
  defer closeDirFd(dirFd)
  let names = listDirFd(dirFd)?
  for name of names {
    removeEntry(dirFd, name, depth)?
  }
}

// Remove `path` and everything beneath it, race-free: a directory or file
// swapped in beneath `path` WHILE this runs cannot make it delete anything
// outside the tree `path` named when this call started (#5816, epic #5787).
//
// `path` itself is opened no-follow, exactly like every entry beneath it:
// this function opens `path`'s PARENT normally (following its own symlinks,
// the same trusted-boundary treatment `walkBeneath`'s `root` gets above),
// then treats `path`'s own final component as just another entry under that
// parent fd, through the SAME `removeEntry` a nested child goes through. A
// symlink named by `path` is therefore unlinked itself, never followed into
// whatever it points at — matching Go's `os.RemoveAll`, and refusing the
// #5787 finding class this module exists to close.
//
// Depth beneath `path` is bounded by `maxWalkDepth`, the same bound
// `walkBeneath` gives. A missing `path` is success, matching `os.RemoveAll`
// — checked once, lexically, on this top-level argument only; the recursive
// descent below never re-checks existence by path.
export fn removeAll(path: string): ()! {
  if (!exists(path)) {
    return
  }
  let cleaned = clean(path)
  let parent = dir(cleaned)
  let name = base(cleaned)
  if (len(name) == 0) {
    fail newError("removeAll: refuses to remove: ${path}")
  }
  let parentW = []byte(parent)
  let parentFd = bit_rt_fs_open_dir_w(ptrOf(parentW), len(parent))
  keepAlive(parentW)
  if (parentFd < 0) {
    fail newError("removeAll: cannot open parent directory: ${parent}")
  }
  defer closeDirFd(parentFd)
  removeEntry(parentFd, name, maxWalkDepth)?
}
