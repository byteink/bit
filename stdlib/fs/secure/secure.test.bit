// stdlib/fs/secure/secure.test.bit — openBeneath/statOpen (#5793). The
// parent-swap RACE proof lives separately, in _tests_/bit/openbeneath/
// openbeneath.bit (a standalone harness binary, not a `test` block: it runs
// a background `spawn`ped swapper for a bounded 400k-iteration loop, far
// longer than a unit test should take). These are the two deterministic,
// single-shot cases: a lexical `..` escape and a symlink at the leaf.
import { envOr } from "std/os"
import { isSymlink, mkdir, writeFile } from "std/fs"
import { run } from "std/process"

fn scratchDir(tag: string): string {
  return "${envOr("TMPDIR", "/tmp")}/bit-fssecure-${tag}-${timeUnixNs()}"
}

fn mustMkdir(path: string) {
  mkdir(path) catch e {
    panic("secure.test: mkdir ${path}: ${e.message()}")
  }
}

fn mustWrite(path: string, content: string) {
  writeFile(path, content) catch e {
    panic("secure.test: write ${path}: ${e.message()}")
  }
}

// `/bin/ln -s`: std/fs has no symlink creator (pkg/web/static.test.bit's
// `mustLink` uses the same device).
fn mustLink(target: string, link: string) {
  let rc = run("/bin/ln", ["-s", target, link])
  assert(rc == 0, "/bin/ln -s ${target} ${link} exited ${rc}")
  assert(isSymlink(link), "the fixture did not create a symlink at ${link}")
}

test "openBeneath serves a plain file inside the root" {
  let dir = scratchDir("plain")
  mustMkdir(dir)
  let root = "${dir}/root"
  mustMkdir(root)
  mustWrite("${root}/a.txt", "INSIDE")
  let f = openBeneath(root, "a.txt") catch e {
    panic("openBeneath: ${e.message()}")
  }
  defer f.close()
  let got = f.readAll() catch e {
    panic("readAll: ${e.message()}")
  }
  assert(got == "INSIDE", "expected INSIDE, got '${got}'")
}

test "openBeneath refuses a lexical .. escape" {
  let dir = scratchDir("dotdot")
  mustMkdir(dir)
  mustWrite("${dir}/secret.txt", "OUTSIDE")
  let root = "${dir}/root"
  mustMkdir(root)
  let f = openBeneath(root, "../secret.txt") catch _ {
    return
  }
  f.close()
  panic("openBeneath followed a .. escape instead of refusing it")
}

test "openBeneath refuses a symlink at the leaf" {
  let dir = scratchDir("leaf")
  mustMkdir(dir)
  mustWrite("${dir}/secret.txt", "OUTSIDE")
  let root = "${dir}/root"
  mustMkdir(root)
  mustLink("${dir}/secret.txt", "${root}/link.txt")
  let f = openBeneath(root, "link.txt") catch _ {
    return
  }
  f.close()
  panic("openBeneath followed a symlink at the leaf instead of refusing it")
}

test "openBeneath refuses a symlinked intermediate directory" {
  let dir = scratchDir("mid")
  mustMkdir(dir)
  let outside = "${dir}/outside"
  mustMkdir(outside)
  mustWrite("${outside}/target.txt", "OUTSIDE")
  let root = "${dir}/root"
  mustMkdir(root)
  mustLink(outside, "${root}/a")
  let f = openBeneath(root, "a/target.txt") catch _ {
    return
  }
  f.close()
  panic("openBeneath followed a symlinked intermediate component instead of refusing it")
}

test "statOpen reads a plain file's size from the open handle" {
  let dir = scratchDir("stat")
  mustMkdir(dir)
  let root = "${dir}/root"
  mustMkdir(root)
  mustWrite("${root}/a.txt", "12345")
  let f = openBeneath(root, "a.txt") catch e {
    panic("openBeneath: ${e.message()}")
  }
  defer f.close()
  let info = statOpen(f) catch e {
    panic("statOpen: ${e.message()}")
  }
  assert(info.size == 5, "expected size 5, got ${info.size}")
  assert(!info.isDir, "a plain file reported as a directory")
}
