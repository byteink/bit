// stdlib/fs/secure/secure.test.bit — openBeneath/statOpen (#5793),
// walkBeneath (#5800). The parent-swap RACE proofs live separately, in
// _tests_/bit/openbeneath/openbeneath.bit and _tests_/bit/walkbeneath/
// walkbeneath.bit (standalone harness binaries, not `test` blocks: each
// runs a background `spawn`ped swapper for a bounded, 300k+-iteration loop,
// far longer than a unit test should take). These are the deterministic,
// single-shot cases.
import { envOr } from "std/os"
import { isSymlink, mkdir, writeFile } from "std/fs"
import { run } from "std/process"
// `exists` is NOT imported here: secure.bit, a sibling in this same module,
// already imports it from "std/fs" (Bit's imports are module-scoped, same
// reason secure.bit's own header states for its "std/fs"/"std/path" names).
// `removeAll` (#5816) is that same sibling's own export, in scope here for
// the same reason.

fn scratchDir(tag: string): string {
  return "${envOr("TMPDIR", "/tmp")}/bit-fssecure-${tag}-${timeUnixNs()}"
}

// `removeAll` is fallible; `defer` requires a plain call (SPEC §18.5's
// `postfix` grammar), so this wraps it. A cleanup failure is reported, never
// swallowed, and never changes the test's own verdict.
fn removeAllLogged(path: string) {
  removeAll(path) catch e {
    eprint("secure.test: removeAll ${path}: ${e.message()}\n")
  }
}

fn mustMkdir(path: string) {
  mkdir(path) catch e {
    panic("secure.test: mkdir ${path}: ${e.message()}")
  }
}

fn mustWrite(path: string, content: string) {
  writeFile(path, content) catch e {
    panic("secure.test: write ${path}: ${e.message()}")
  }
}

// `/bin/ln -s`: std/fs has no symlink creator (pkg/web/static.test.bit's
// `mustLink` uses the same device).
fn mustLink(target: string, link: string) {
  let rc = run("/bin/ln", ["-s", target, link])
  assert(rc == 0, "/bin/ln -s ${target} ${link} exited ${rc}")
  assert(isSymlink(link), "the fixture did not create a symlink at ${link}")
}

test "openBeneath serves a plain file inside the root" {
  let dir = scratchDir("plain")
  mustMkdir(dir)
  defer removeAllLogged(dir)
  let root = "${dir}/root"
  mustMkdir(root)
  mustWrite("${root}/a.txt", "INSIDE")
  let f = openBeneath(root, "a.txt") catch e {
    panic("openBeneath: ${e.message()}")
  }
  defer f.close()
  let got = f.readAll() catch e {
    panic("readAll: ${e.message()}")
  }
  assert(got == "INSIDE", "expected INSIDE, got '${got}'")
}

test "openBeneath refuses a lexical .. escape" {
  let dir = scratchDir("dotdot")
  mustMkdir(dir)
  defer removeAllLogged(dir)
  mustWrite("${dir}/secret.txt", "OUTSIDE")
  let root = "${dir}/root"
  mustMkdir(root)
  let f = openBeneath(root, "../secret.txt") catch _ {
    return
  }
  f.close()
  panic("openBeneath followed a .. escape instead of refusing it")
}

test "openBeneath refuses a symlink at the leaf" {
  let dir = scratchDir("leaf")
  mustMkdir(dir)
  defer removeAllLogged(dir)
  mustWrite("${dir}/secret.txt", "OUTSIDE")
  let root = "${dir}/root"
  mustMkdir(root)
  mustLink("${dir}/secret.txt", "${root}/link.txt")
  let f = openBeneath(root, "link.txt") catch _ {
    return
  }
  f.close()
  panic("openBeneath followed a symlink at the leaf instead of refusing it")
}

test "openBeneath refuses a symlinked intermediate directory" {
  let dir = scratchDir("mid")
  mustMkdir(dir)
  defer removeAllLogged(dir)
  let outside = "${dir}/outside"
  mustMkdir(outside)
  mustWrite("${outside}/target.txt", "OUTSIDE")
  let root = "${dir}/root"
  mustMkdir(root)
  mustLink(outside, "${root}/a")
  let f = openBeneath(root, "a/target.txt") catch _ {
    return
  }
  f.close()
  panic("openBeneath followed a symlinked intermediate component instead of refusing it")
}

test "statOpen reads a plain file's size from the open handle" {
  let dir = scratchDir("stat")
  mustMkdir(dir)
  defer removeAllLogged(dir)
  let root = "${dir}/root"
  mustMkdir(root)
  mustWrite("${root}/a.txt", "12345")
  let f = openBeneath(root, "a.txt") catch e {
    panic("openBeneath: ${e.message()}")
  }
  defer f.close()
  let info = statOpen(f) catch e {
    panic("statOpen: ${e.message()}")
  }
  assert(info.size == 5, "expected size 5, got ${info.size}")
  assert(!info.isDir, "a plain file reported as a directory")
}

test "walkBeneath finds every file in a nested tree" {
  let dir = scratchDir("walk-nested")
  mustMkdir(dir)
  defer removeAllLogged(dir)
  let root = "${dir}/root"
  mustMkdir(root)
  mustWrite("${root}/top.txt", "x")
  mustMkdir("${root}/sub")
  mustWrite("${root}/sub/nested.txt", "y")
  let got = walkBeneath(root) catch e {
    panic("walkBeneath: ${e.message()}")
  }
  assert(len(got) == 2, "expected 2 paths, got ${len(got)}")
  assert(got[0] == "${root}/sub/nested.txt", "unexpected first path: ${got[0]}")
  assert(got[1] == "${root}/top.txt", "unexpected second path: ${got[1]}")
}

test "walkBeneath reports a symlinked directory as a leaf, never descending into it" {
  let dir = scratchDir("walk-symlink")
  mustMkdir(dir)
  defer removeAllLogged(dir)
  let outside = "${dir}/outside"
  mustMkdir(outside)
  mustWrite("${outside}/secret.txt", "OUTSIDE")
  let root = "${dir}/root"
  mustMkdir(root)
  mustLink(outside, "${root}/a")
  let got = walkBeneath(root) catch e {
    panic("walkBeneath: ${e.message()}")
  }
  assert(len(got) == 1, "expected 1 path (the symlink itself), got ${len(got)}")
  assert(got[0] == "${root}/a", "expected the symlink reported as a leaf, got ${got[0]}")
}

test "removeAll removes a nested tree completely" {
  let dir = scratchDir("removeall-nested")
  mustMkdir(dir)
  defer removeAllLogged(dir)
  let root = "${dir}/root"
  mustMkdir(root)
  mustWrite("${root}/top.txt", "x")
  mustMkdir("${root}/sub")
  mustWrite("${root}/sub/nested.txt", "y")
  removeAll(root) catch e {
    panic("removeAll: ${e.message()}")
  }
  assert(!exists(root), "removeAll left ${root} behind")
}

test "removeAll unlinks a symlink inside the tree without following it" {
  let dir = scratchDir("removeall-symlink")
  mustMkdir(dir)
  defer removeAllLogged(dir)
  let outside = "${dir}/outside"
  mustMkdir(outside)
  mustWrite("${outside}/secret.txt", "OUTSIDE")
  let root = "${dir}/root"
  mustMkdir(root)
  mustLink(outside, "${root}/a")
  removeAll(root) catch e {
    panic("removeAll: ${e.message()}")
  }
  assert(!exists(root), "removeAll left ${root} behind")
  assert(
    exists("${outside}/secret.txt"),
    "removeAll followed the symlink and deleted outside the tree",
  )
}

test "removeAll on a missing path succeeds" {
  let dir = scratchDir("removeall-missing")
  mustMkdir(dir)
  defer removeAllLogged(dir)
  removeAll("${dir}/does-not-exist") catch e {
    panic("removeAll on a missing path should succeed, got: ${e.message()}")
  }
}

test "removeAll removes a plain file path" {
  let dir = scratchDir("removeall-file")
  mustMkdir(dir)
  defer removeAllLogged(dir)
  let path = "${dir}/a.txt"
  mustWrite(path, "x")
  removeAll(path) catch e {
    panic("removeAll: ${e.message()}")
  }
  assert(!exists(path), "removeAll left ${path} behind")
}

test "removeAll on a top-level symlink unlinks it without following it" {
  let dir = scratchDir("removeall-toplink")
  mustMkdir(dir)
  defer removeAllLogged(dir)
  let outside = "${dir}/outside"
  mustMkdir(outside)
  mustWrite("${outside}/secret.txt", "OUTSIDE")
  let link = "${dir}/link"
  mustLink(outside, link)
  removeAll(link) catch e {
    panic("removeAll: ${e.message()}")
  }
  assert(!exists(link) && !isSymlink(link), "removeAll left ${link} behind")
  assert(
    exists("${outside}/secret.txt"),
    "removeAll followed the top-level symlink and deleted outside the tree",
  )
}

// ---- the runtime's own containment, fast path AND fallback (#5809) ----
//
// `openBeneath` above runs `std/path`'s lexical `contains` BEFORE the
// runtime, so a `..` test through it never reaches the kernel. These call
// the runtime primitive directly (`bit_rt_fs_open_beneath_w`, declared by
// secure.bit, a sibling in this module) and its forced-fallback twin, so
// every shape is proven against BOTH Linux paths: the single `openat2` and
// the per-component walk. On Darwin both symbols are the one
// `O_NOFOLLOW_ANY` implementation; on Windows both refuse everything.

// Only this file declares the walk-only entry point: nothing that imports
// "std/fs/secure" for real needs the symbol to exist in its libbitrt.
extern fn bit_rt_fs_open_beneath_walk_w(root: *byte, rootN: int, rel: *byte, relN: int): i64

fn rawOpen(root: string, rel: string, fast: bool): i64 {
  let rootW = []byte(root)
  let relW = []byte(rel)
  if (fast) {
    return bit_rt_fs_open_beneath_w(ptrOf(rootW), len(root), ptrOf(relW), len(rel))
  }
  return bit_rt_fs_open_beneath_walk_w(ptrOf(rootW), len(root), ptrOf(relW), len(rel))
}

fn pathName(fast: bool): string {
  if (fast) {
    return "openat2 fast path"
  }
  return "walk fallback"
}

fn assertRefused(root: string, rel: string, fast: bool) {
  let fd = rawOpen(root, rel, fast)
  if (fd >= 0) {
    let f = File{ fd = fd }
    f.close()
    panic("${pathName(fast)} served root=${root} rel=${rel} (fd ${fd}) instead of refusing it")
  }
}

fn assertServes(root: string, rel: string, want: string, fast: bool) {
  let fd = rawOpen(root, rel, fast)
  assert(fd >= 0, "${pathName(fast)} refused ${rel}")
  let f = File{ fd = fd }
  defer f.close()
  let got = f.readAll() catch e {
    panic("readAll: ${e.message()}")
  }
  assert(got == want, "${pathName(fast)} ${rel}: expected ${want}, got '${got}'")
}

// root/ { real.txt, a/b.txt, a/up -> outside, in-link -> real.txt,
// dirlink -> a, outfile -> <dir>/secret.txt, outdir -> <dir>/outside,
// relfile -> ../secret.txt }; <dir>/secret.txt and <dir>/outside/secret.txt
// are the bytes that must never be served.
fn escapeFixture(tag: string): string {
  let dir = scratchDir(tag)
  mustMkdir(dir)
  mustWrite("${dir}/secret.txt", "OUTSIDE")
  mustMkdir("${dir}/outside")
  mustWrite("${dir}/outside/secret.txt", "OUTSIDE")
  let root = "${dir}/root"
  mustMkdir(root)
  mustWrite("${root}/real.txt", "INSIDE")
  mustMkdir("${root}/a")
  mustWrite("${root}/a/b.txt", "INSIDE")
  mustLink("${dir}/outside", "${root}/a/up")
  mustLink("real.txt", "${root}/in-link")
  mustLink("a", "${root}/dirlink")
  mustLink("${dir}/secret.txt", "${root}/outfile")
  mustLink("${dir}/outside", "${root}/outdir")
  mustLink("../secret.txt", "${root}/relfile")
  return dir
}

fn assertEscapesRefused(root: string, fast: bool) {
  // `..` escapes, the climbing and the merely-lexical alike.
  assertRefused(root, "..", fast)
  assertRefused(root, "../secret.txt", fast)
  assertRefused(root, "a/../../secret.txt", fast)
  assertRefused(root, "a/../../outside/secret.txt", fast)
  assertRefused(root, "a/..", fast)
  // An absolute `rel`, inside the root's own prefix or not.
  assertRefused(root, "/etc/hostname", fast)
  assertRefused(root, "${root}/real.txt", fast)
  // Symlinks: absolute and relative, leaf and intermediate, escaping and
  // in-root (the policy refuses every symlink, not only escaping ones).
  assertRefused(root, "outfile", fast)
  assertRefused(root, "relfile", fast)
  assertRefused(root, "outdir/secret.txt", fast)
  assertRefused(root, "a/up/secret.txt", fast)
  assertRefused(root, "in-link", fast)
  assertRefused(root, "dirlink/b.txt", fast)
  // A directory leaf, and a doubled slash (the paths must agree on it).
  assertRefused(root, "a", fast)
  assertRefused(root, "a/", fast)
  assertRefused(root, "a//b.txt", fast)
  assertRefused(root, "missing.txt", fast)
}

fn assertInsideServed(root: string, fast: bool) {
  assertServes(root, "real.txt", "INSIDE", fast)
  assertServes(root, "a/b.txt", "INSIDE", fast)
  assertServes(root, "a/./b.txt", "INSIDE", fast)
}

test "open_beneath fast path refuses every escape shape and serves inside files" {
  let dir = escapeFixture("esc-fast")
  defer removeAllLogged(dir)
  assertInsideServed("${dir}/root", true)
  assertEscapesRefused("${dir}/root", true)
}

test "open_beneath fallback walk refuses every escape shape and serves inside files" {
  let dir = escapeFixture("esc-walk")
  defer removeAllLogged(dir)
  assertInsideServed("${dir}/root", false)
  assertEscapesRefused("${dir}/root", false)
}

// Magic links (`/proc/self/exe`, `/proc/self/fd/N`, `/proc/self/cwd`) jump
// to a path the process names, not one under the root. A root of
// `/proc/self` makes them reachable as ordinary components; both paths must
// refuse (`O_NOFOLLOW` on the walk, `RESOLVE_NO_SYMLINKS|NO_MAGICLINKS` on
// the fast path). Where `/proc` does not exist the root open itself fails,
// which is a refusal too.
fn assertMagicLinksRefused(fdNum: i64, fast: bool) {
  assertRefused("/proc/self", "exe", fast)
  assertRefused("/proc/self", "cwd", fast)
  assertRefused("/proc/self", "cwd/anything", fast)
  assertRefused("/proc/self", "fd/${fdNum}", fast)
}

test "open_beneath refuses magic links on both paths" {
  let dir = escapeFixture("magic")
  defer removeAllLogged(dir)
  let f = openBeneath("${dir}/root", "real.txt") catch e {
    panic("openBeneath: ${e.message()}")
  }
  defer f.close()
  assertMagicLinksRefused(f.fd, true)
  assertMagicLinksRefused(f.fd, false)
}
