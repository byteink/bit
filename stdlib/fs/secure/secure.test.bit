// stdlib/fs/secure/secure.test.bit — openBeneath/statOpen (#5793),
// walkBeneath (#5800). The parent-swap RACE proofs live separately, in
// _tests_/bit/openbeneath/openbeneath.bit and _tests_/bit/walkbeneath/
// walkbeneath.bit (standalone harness binaries, not `test` blocks: each
// runs a background `spawn`ped swapper for a bounded, 300k+-iteration loop,
// far longer than a unit test should take). These are the deterministic,
// single-shot cases.
import { envOr } from "std/os"
import { isSymlink, lstat, mkdir, readDir, remove, writeFile } from "std/fs"
import { run } from "std/process"
// `exists` is NOT imported here: secure.bit, a sibling in this same module,
// already imports it from "std/fs" (Bit's imports are module-scoped, same
// reason secure.bit's own header states for its "std/fs"/"std/path" names).

fn scratchDir(tag: string): string {
  return "${envOr("TMPDIR", "/tmp")}/bit-fssecure-${tag}-${timeUnixNs()}"
}

// Recursively removes `path` (file, symlink, or directory tree) through
// std/fs only — `remove` (stdlib/fs/fs.bit:494) alone only handles a file or
// an already-empty directory. A symlink is unlinked, never followed: this
// never descends into a link's target, only into a REAL directory `lstat`
// reports. Best-effort: a failure at any step is swallowed so teardown never
// masks the test's own outcome.
fn removeTree(path: string) {
  let info = lstat(path) catch _ {
    return
  }
  if (!info.isSymlink && info.isDir) {
    let names = readDir(path) catch _ {
      []string(0)
    }
    for name of names {
      removeTree("${path}/${name}")
    }
  }
  remove(path) catch _ {}
}

fn mustMkdir(path: string) {
  mkdir(path) catch e {
    panic("secure.test: mkdir ${path}: ${e.message()}")
  }
}

fn mustWrite(path: string, content: string) {
  writeFile(path, content) catch e {
    panic("secure.test: write ${path}: ${e.message()}")
  }
}

// `/bin/ln -s`: std/fs has no symlink creator (pkg/web/static.test.bit's
// `mustLink` uses the same device).
fn mustLink(target: string, link: string) {
  let rc = run("/bin/ln", ["-s", target, link])
  assert(rc == 0, "/bin/ln -s ${target} ${link} exited ${rc}")
  assert(isSymlink(link), "the fixture did not create a symlink at ${link}")
}

test "openBeneath serves a plain file inside the root" {
  let dir = scratchDir("plain")
  mustMkdir(dir)
  defer removeTree(dir)
  let root = "${dir}/root"
  mustMkdir(root)
  mustWrite("${root}/a.txt", "INSIDE")
  let f = openBeneath(root, "a.txt") catch e {
    panic("openBeneath: ${e.message()}")
  }
  defer f.close()
  let got = f.readAll() catch e {
    panic("readAll: ${e.message()}")
  }
  assert(got == "INSIDE", "expected INSIDE, got '${got}'")
}

test "openBeneath refuses a lexical .. escape" {
  let dir = scratchDir("dotdot")
  mustMkdir(dir)
  defer removeTree(dir)
  mustWrite("${dir}/secret.txt", "OUTSIDE")
  let root = "${dir}/root"
  mustMkdir(root)
  let f = openBeneath(root, "../secret.txt") catch _ {
    return
  }
  f.close()
  panic("openBeneath followed a .. escape instead of refusing it")
}

test "openBeneath refuses a symlink at the leaf" {
  let dir = scratchDir("leaf")
  mustMkdir(dir)
  defer removeTree(dir)
  mustWrite("${dir}/secret.txt", "OUTSIDE")
  let root = "${dir}/root"
  mustMkdir(root)
  mustLink("${dir}/secret.txt", "${root}/link.txt")
  let f = openBeneath(root, "link.txt") catch _ {
    return
  }
  f.close()
  panic("openBeneath followed a symlink at the leaf instead of refusing it")
}

test "openBeneath refuses a symlinked intermediate directory" {
  let dir = scratchDir("mid")
  mustMkdir(dir)
  defer removeTree(dir)
  let outside = "${dir}/outside"
  mustMkdir(outside)
  mustWrite("${outside}/target.txt", "OUTSIDE")
  let root = "${dir}/root"
  mustMkdir(root)
  mustLink(outside, "${root}/a")
  let f = openBeneath(root, "a/target.txt") catch _ {
    return
  }
  f.close()
  panic("openBeneath followed a symlinked intermediate component instead of refusing it")
}

test "statOpen reads a plain file's size from the open handle" {
  let dir = scratchDir("stat")
  mustMkdir(dir)
  defer removeTree(dir)
  let root = "${dir}/root"
  mustMkdir(root)
  mustWrite("${root}/a.txt", "12345")
  let f = openBeneath(root, "a.txt") catch e {
    panic("openBeneath: ${e.message()}")
  }
  defer f.close()
  let info = statOpen(f) catch e {
    panic("statOpen: ${e.message()}")
  }
  assert(info.size == 5, "expected size 5, got ${info.size}")
  assert(!info.isDir, "a plain file reported as a directory")
}

test "walkBeneath finds every file in a nested tree" {
  let dir = scratchDir("walk-nested")
  mustMkdir(dir)
  defer removeTree(dir)
  let root = "${dir}/root"
  mustMkdir(root)
  mustWrite("${root}/top.txt", "x")
  mustMkdir("${root}/sub")
  mustWrite("${root}/sub/nested.txt", "y")
  let got = walkBeneath(root) catch e {
    panic("walkBeneath: ${e.message()}")
  }
  assert(len(got) == 2, "expected 2 paths, got ${len(got)}")
  assert(got[0] == "${root}/sub/nested.txt", "unexpected first path: ${got[0]}")
  assert(got[1] == "${root}/top.txt", "unexpected second path: ${got[1]}")
}

test "walkBeneath reports a symlinked directory as a leaf, never descending into it" {
  let dir = scratchDir("walk-symlink")
  mustMkdir(dir)
  defer removeTree(dir)
  let outside = "${dir}/outside"
  mustMkdir(outside)
  mustWrite("${outside}/secret.txt", "OUTSIDE")
  let root = "${dir}/root"
  mustMkdir(root)
  mustLink(outside, "${root}/a")
  let got = walkBeneath(root) catch e {
    panic("walkBeneath: ${e.message()}")
  }
  assert(len(got) == 1, "expected 1 path (the symlink itself), got ${len(got)}")
  assert(got[0] == "${root}/a", "expected the symlink reported as a leaf, got ${got[0]}")
}

test "removeAll removes a nested tree completely" {
  let dir = scratchDir("removeall-nested")
  mustMkdir(dir)
  let root = "${dir}/root"
  mustMkdir(root)
  mustWrite("${root}/top.txt", "x")
  mustMkdir("${root}/sub")
  mustWrite("${root}/sub/nested.txt", "y")
  removeAll(root) catch e {
    panic("removeAll: ${e.message()}")
  }
  assert(!exists(root), "removeAll left ${root} behind")
}

test "removeAll unlinks a symlink inside the tree without following it" {
  let dir = scratchDir("removeall-symlink")
  mustMkdir(dir)
  let outside = "${dir}/outside"
  mustMkdir(outside)
  mustWrite("${outside}/secret.txt", "OUTSIDE")
  let root = "${dir}/root"
  mustMkdir(root)
  mustLink(outside, "${root}/a")
  removeAll(root) catch e {
    panic("removeAll: ${e.message()}")
  }
  assert(!exists(root), "removeAll left ${root} behind")
  assert(
    exists("${outside}/secret.txt"),
    "removeAll followed the symlink and deleted outside the tree",
  )
}

test "removeAll on a missing path succeeds" {
  let dir = scratchDir("removeall-missing")
  mustMkdir(dir)
  removeAll("${dir}/does-not-exist") catch e {
    panic("removeAll on a missing path should succeed, got: ${e.message()}")
  }
}

test "removeAll removes a plain file path" {
  let dir = scratchDir("removeall-file")
  mustMkdir(dir)
  let path = "${dir}/a.txt"
  mustWrite(path, "x")
  removeAll(path) catch e {
    panic("removeAll: ${e.message()}")
  }
  assert(!exists(path), "removeAll left ${path} behind")
}

test "removeAll on a top-level symlink unlinks it without following it" {
  let dir = scratchDir("removeall-toplink")
  mustMkdir(dir)
  let outside = "${dir}/outside"
  mustMkdir(outside)
  mustWrite("${outside}/secret.txt", "OUTSIDE")
  let link = "${dir}/link"
  mustLink(outside, link)
  removeAll(link) catch e {
    panic("removeAll: ${e.message()}")
  }
  assert(!exists(link) && !isSymlink(link), "removeAll left ${link} behind")
  assert(
    exists("${outside}/secret.txt"),
    "removeAll followed the top-level symlink and deleted outside the tree",
  )
}
