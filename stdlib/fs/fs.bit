// Bit standard library — fs module.
//
// File I/O built on the low-level `fs*` primitives (ABI.md §14). `open`/`create`
// return a `File` or an error, so `defer f.close()` is the idiomatic cleanup;
// `readFile`/`writeFile` wrap the whole open→use→close dance. This module is
// written in Bit — it leans on the language's own error handling (`!`/`fail`/
// `?`), `defer`, structs, and methods.
//
// A note on concurrency: these calls block the green thread's worker for the
// duration of the syscall. That is not an oversight the netpoller could fix —
// POSIX has no non-blocking read of a regular file, and epoll/kqueue always
// report one as ready. The netpoller (ABI.md §11) exists for sockets and pipes.
import { join } from "std/path"
import { compare } from "std/strings"

// `bit_rt_fs_read_all` itself stays a single non-fallible primitive (ABI.md
// §14): `open`/`create`/`write` above report failure through an in-band `-1`
// sentinel because their results are integers, but a read's result is the
// whole file's content, and `string` has no sentinel value to spare. This
// out-of-band accessor is how `readAll` below tells a genuine I/O error (a
// failed `lseek`/alloc) from a genuine empty file, which never sets it. Must
// be read immediately after `fsReadAll` returns, with no other call between —
// runtime/root/slots.bit's `rtFsReadAllFailed` doc comment states the same
// adjacency requirement from the runtime side.
extern fn bit_rt_fs_read_all_failed(): bool

// An open file handle. `fd` is an OS file descriptor; do not use a File after
// close(). Exported so callers can name it (`let f: File = ...`) and reach `fd`
// to build a buffered `std/io` stream over it.
export struct File { fd: i64 }

// Open `path` for reading, or fail if it cannot be opened.
export fn open(path: string): File! {
  let fd = fsOpen(path, false)
  if (fd < 0) {
    fail newError("cannot open file: ${path}")
  }
  return File{ fd: fd }
}

// Create `path` (truncating any existing file) for writing, or fail.
export fn create(path: string): File! {
  let fd = fsOpen(path, true)
  if (fd < 0) {
    fail newError("cannot create file: ${path}")
  }
  return File{ fd: fd }
}

// The entire file contents as a string, or fail on a seek/read/allocation
// error. A genuinely empty file returns "" with no error (#2996).
export fn (f: File) readAll(): string! {
  let s = fsReadAll(f.fd)
  if (bit_rt_fs_read_all_failed()) {
    fail newError("read failed")
  }
  return s
}

// Write `s` to the file, or fail on a write error.
export fn (f: File) write(s: string): ()! {
  if (fsWrite(f.fd, s) < 0) {
    fail newError("write failed")
  }
}

// Close the file. Idiomatically deferred right after a successful open.
export fn (f: File) close() {
  fsClose(f.fd)
}

// Read an entire file by path — open, read, close.
export fn readFile(path: string): string! {
  let f = open(path)?
  defer f.close()
  return f.readAll()?
}

// Write `content` to `path`, creating/truncating it — open, write, close.
export fn writeFile(path: string, content: string): ()! {
  let f = create(path)?
  defer f.close()
  f.write(content)?
}

// --- appending ------------------------------------------------------------

// Open `path` for appending, creating it if absent. Every write lands at the
// end of the file, atomically with respect to other appenders (`O_APPEND`).
export fn openAppend(path: string): File! {
  let fd = fsAppend(path)
  if (fd < 0) {
    fail newError("cannot open for append: ${path}")
  }
  return File{ fd: fd }
}

// Append `content` to `path`, creating it if absent.
export fn appendFile(path: string, content: string): ()! {
  let f = openAppend(path)?
  defer f.close()
  f.write(content)?
}

// Read up to `max` bytes. The result is shorter than `max` at end of file, and
// empty exactly at end of file. Unlike `readAll` this works on pipes and stdin,
// which have no size to seek to.
export fn (f: File) read(max: int): string {
  return fsRead(f.fd, max)
}

// --- paths on disk --------------------------------------------------------

// Whether `path` names anything at all.
export fn exists(path: string): bool {
  return fsExists(path)
}

// Whether `path` names a directory. False for a missing path.
//
// This FOLLOWS a symbolic link, as `stat(2)` does and as Go's `os.Stat` does:
// a link to a directory answers true. Ask `isSymlink` as well when the
// distinction matters — `walk` does exactly that (#2152).
export fn isDir(path: string): bool {
  return fsIsDir(path)
}

// The symlink probe (#2152), and the one runtime fs primitive `std/fs` reaches
// by `extern` rather than by a compiler-recognized `fs*` name — so it is also
// the one that cannot be handed a `string`: SPEC §11.7 admits only scalars and
// raw pointers across an `extern` boundary.
//
// `path` IS NOT A C STRING. It is the backing store of a Bit `[]byte`, which
// stores ONE 8-BYTE WORD PER ELEMENT (SPEC §11.8: "`ptrOf` on a `[]u8` does not
// address packed bytes"), so it is `n` words each holding one byte's value.
// Packing them into a NUL-terminated path is the runtime's job, deliberately:
// that is where `max_path` and the embedded-NUL rejection (#2146) already live
// for the other eight path-taking primitives, and where the bounded path buffer
// already exists. Passing the elements one word each rather than packing them
// here also keeps the boundary free of any byte-order assumption.
extern fn bit_rt_fs_is_symlink_w(path: *byte, n: int): bool

// `path`'s bytes as a fresh `[]byte`, one WORD per element — the encoding
// every `_w`-suffixed primitive above and below needs, per
// `bit_rt_fs_is_symlink_w`'s doc comment. Factored out (#2153) so `stat`/
// `lstat` share it with `isSymlink` instead of a third copy of this loop.
fn pathWords(path: string): []byte {
  let n = len(path)
  let w = []byte(n)
  let i = 0
  while (i < n) {
    w[i] = path[i]
    i = i + 1
  }
  return w
}

// Whether `path` names a symbolic LINK itself — the question asked of the link,
// not of what it resolves to, so this is `lstat`-shaped where `exists` and
// `isDir` are `stat`-shaped. A link to a directory is `isDir(p) == true` AND
// `isSymlink(p) == true`; a link whose target is missing is still a link, and
// still answers true.
//
// False for the empty path, for a missing path, for anything that is not a
// link, and for a path the OS refuses to answer for — the same "never fails"
// contract `exists` and `isDir` carry.
export fn isSymlink(path: string): bool {
  let n = len(path)
  if (n == 0) {
    return false
  }
  return bit_rt_fs_is_symlink_w(ptrOf(pathWords(path)), n)
}

// --- metadata (#2153) ------------------------------------------------------

// The metadata `stat`/`lstat` report — everything answerable without reading
// a byte of the file's content. `mode` carries the low 12 permission bits
// (the 9 `rwxrwxrwx` bits plus setuid/setgid/sticky) — the same bits
// `bit_rt_fs_chmod` (ABI.md §14) accepts, so a value read back from `stat`
// round-trips through a future `chmod` wrapper unchanged.
export struct FileInfo {
  size: i64,
  mtime: i64, // seconds since the Unix epoch
  mode: i64, // low 12 permission bits
  isDir: bool,
  isSymlink: bool,
}

// `bit_rt_fs_stat_w`'s output buffer layout (ABI.md §14): 5 words, written by
// the runtime provider in this fixed order.
const statOutSize: int = 0
const statOutMtime: int = 1
const statOutMode: int = 2
const statOutIsDir: int = 3
const statOutIsSymlink: int = 4
const statOutWords: int = 5

// `path`/`n` are the same word-per-byte encoding `isSymlink` uses, for the
// same reason (`bit_rt_fs_is_symlink_w`'s doc comment); `out` is the 5-word
// sink above. Both return 0 on success or `-errno` on failure — the same
// signed convention #2343 gives the net primitives — so `statResult` below
// can tell a missing path from a permission error instead of a flat `-1`.
extern fn bit_rt_fs_stat_w(path: *byte, n: int, out: *i64): i64
extern fn bit_rt_fs_lstat_w(path: *byte, n: int, out: *i64): i64

// POSIX `ENOENT`, identical on Darwin and Linux (both runtime providers'
// `fillStat` comments confirm the measurement). The one errno this module
// distinguishes by name; anything else still fails, just less specifically —
// there is no richer `Error` type in this codebase yet to carry an errno
// through `fail`/`?`/`catch` (SPEC §10), so the distinction lives in the
// message text.
const eNoEnt: int = 2

fn statResult(rc: i64, path: string, out: []i64): FileInfo! {
  if (rc < 0) {
    if (0 - rc == eNoEnt) {
      fail newError("no such file or directory: ${path}")
    }
    fail newError("stat failed (errno ${0 - rc}): ${path}")
  }
  return FileInfo{
    size: out[statOutSize],
    mtime: out[statOutMtime],
    mode: out[statOutMode],
    isDir: out[statOutIsDir] != 0,
    isSymlink: out[statOutIsSymlink] != 0,
  }
}

// File metadata for `path`, FOLLOWING a trailing symbolic link — `stat(2)`-
// shaped, like `isDir`/`exists` above. `isSymlink` is always `false` in the
// result: a followed link is indistinguishable from its target. Fails if
// `path` does not exist or cannot be probed.
export fn stat(path: string): FileInfo! {
  let w = pathWords(path)
  let out = []i64(statOutWords)
  let rc = bit_rt_fs_stat_w(ptrOf(w), len(path), ptrOf(out))
  return statResult(rc, path, out)?
}

// File metadata for `path` ITSELF, NOT following a trailing symbolic link —
// `lstat(2)`-shaped, like `isSymlink` above. Unlike `stat`, the result's
// `isSymlink` reflects `path` itself.
export fn lstat(path: string): FileInfo! {
  let w = pathWords(path)
  let out = []i64(statOutWords)
  let rc = bit_rt_fs_lstat_w(ptrOf(w), len(path), ptrOf(out))
  return statResult(rc, path, out)?
}

// Create directory `path`. Fails if it exists, or if its parent does not.
export fn mkdir(path: string): ()! {
  if (fsMkdir(path) < 0) {
    fail newError("cannot create directory: ${path}")
  }
}

// Remove a file, or an empty directory.
export fn remove(path: string): ()! {
  if (fsRemove(path) < 0) {
    fail newError("cannot remove: ${path}")
  }
}

// --- directories ----------------------------------------------------------

// The names (not paths) of `path`'s entries, excluding "." and "..", sorted so
// a listing is reproducible across filesystems.
export fn readDir(path: string): []string! {
  if (!fsIsDir(path)) {
    fail newError("not a directory: ${path}")
  }
  return sortNames(splitEntries(fsListDir(path)))
}

// The primitive returns entries NUL-terminated: NUL is the one byte a POSIX
// filename cannot contain, so unlike a newline it can never appear inside a name.
fn splitEntries(raw: string): []string {
  let out = []string(0)
  let start = 0
  let i = 0
  while (i < len(raw)) {
    if (raw[i] == 0) {
      out = append(out, raw[start:i])
      start = i + 1
    }
    i = i + 1
  }
  return out
}

// O(n log n) bottom-up (iterative) merge sort (#2151) — replaces an insertion
// sort whose O(n^2) behavior cost 105s of CPU at 50,000 entries, since
// `readdir` returns names in hash order (effectively random) rather than
// anything close to sorted. Bottom-up rather than recursive so the loop nest
// is directly Power-of-10 bounded: the outer pass count is ceil(log2(n)),
// each inner loop is bounded by n, with no recursion depth to reason about.
fn sortNames(names: []string): []string {
  let n = len(names)
  if (n <= 1) {
    return names
  }
  let buf = []string(n)
  let width = 1
  while (width < n) {
    let lo = 0
    while (lo < n) {
      let mid = lo + width
      if (mid > n) {
        mid = n
      }
      let hi = lo + 2 * width
      if (hi > n) {
        hi = n
      }
      mergeRuns(names, buf, lo, mid, hi)
      lo = lo + 2 * width
    }
    let i = 0
    while (i < n) {
      names[i] = buf[i]
      i = i + 1
    }
    width = width * 2
  }
  return names
}

// Merges the two already-sorted runs `[lo, mid)` and `[mid, hi)` of `a` into
// the same index range of `buf`. `<=` (not `<`) keeps `a[i]` on a tie, so
// equal-named entries — impossible for real directory entries, but kept for
// any future caller of this general merge — stay in their original order.
fn mergeRuns(a: []string, buf: []string, lo: int, mid: int, hi: int) {
  let i = lo
  let j = mid
  let k = lo
  while (i < mid && j < hi) {
    if (compare(a[i], a[j]) <= 0) {
      buf[k] = a[i]
      i = i + 1
    } else {
      buf[k] = a[j]
      j = j + 1
    }
    k = k + 1
  }
  while (i < mid) {
    buf[k] = a[i]
    i = i + 1
    k = k + 1
  }
  while (j < hi) {
    buf[k] = a[j]
    j = j + 1
    k = k + 1
  }
}

// Maximum REAL directory nesting `walk` will descend, and a bound on the
// recursion (Power of 10 rule 2) — nothing more. It is explicitly NOT the
// defence against a symlink loop: `walk` does not follow links at all, so no
// link can add depth. It used to claim that job and could not do it, which is
// how a self-referential link inflated a one-file tree to 33 paths (#2152).
const maxWalkDepth: int = 64

// Every *file* path beneath `root`, depth-first and sorted at each level.
// Directories are descended into, not themselves returned.
//
// SYMBOLIC LINKS ARE REPORTED BUT NEVER FOLLOWED (#2152), which is Go's
// `filepath.WalkDir` ("WalkDir does not follow symbolic links") and the default
// of Rust's `walkdir` (`follow_links(false)`). A link is yielded as a leaf path
// exactly like a file, whatever it points at, so a caller still learns it is
// there and can call `isSymlink` to identify it — silently omitting it would be
// its own surprise. Nothing below `root` is descended through a link, so no
// returned path can name data outside the tree the caller asked about, and a
// link pointing at its own ancestor cannot loop.
//
// `root` ITSELF IS USED AS GIVEN. Naming a link as the root is an explicit
// request to walk what it points at, so it is followed — the `follow_root_links`
// default `walkdir` settled on. It leaks nothing: the caller chose it.
export fn walk(root: string): []string! {
  return walkInto(root, []string(0), maxWalkDepth)?
}

// Whether `p` is a directory `walk` may descend into: a REAL one, not a link
// that resolves to one. Both questions are needed because `fsIsDir` follows
// links (it is `opendir`/`stat`-shaped), which makes a link to a directory
// indistinguishable from a directory on its own.
//
// The `&&` order is load-bearing, not cosmetic. `isSymlink` reports false both
// for "not a link" and for "could not probe", and only the first is safe to
// descend on — but both primitives screen a path through the SAME runtime
// `max_path` and embedded-NUL rules, so a path `fsIsDir` accepted is always
// one `isSymlink` can decide. By the time the second operand runs, "could not
// probe" is unreachable. Reversing the operands would drop that guarantee.
fn isRealDir(p: string): bool {
  return fsIsDir(p) && !isSymlink(p)
}

fn walkInto(dir: string, acc: []string, depth: int): []string! {
  if (depth <= 0) {
    fail newError("walk: directory nesting exceeds ${maxWalkDepth} at ${dir}")
  }
  let out = acc
  for name of readDir(dir)? {
    let p = join(dir, name)
    if (isRealDir(p)) {
      out = walkInto(p, out, depth - 1)?
    } else {
      out = append(out, p)
    }
  }
  return out
}
