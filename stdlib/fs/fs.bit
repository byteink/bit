// Bit standard library — fs module.
//
// File I/O built on the low-level `fs*` primitives (ABI.md §14). `open`/`create`
// return a `File` or an error, so `defer f.close()` is the idiomatic cleanup;
// `readFile`/`writeFile` wrap the whole open→use→close dance. This module is
// written in Bit — it leans on the language's own error handling (`!`/`fail`/
// `?`), `defer`, structs, and methods.
//
// A note on concurrency: these calls block the green thread's worker for the
// duration of the syscall. That is not an oversight the netpoller could fix —
// POSIX has no non-blocking read of a regular file, and epoll/kqueue always
// report one as ready. The netpoller (ABI.md §11) exists for sockets and pipes.
import { join } from "std/path"
import { compare } from "std/strings"

// An open file handle. `fd` is an OS file descriptor; do not use a File after
// close(). Exported so callers can name it (`let f: File = ...`) and reach `fd`
// to build a buffered `std/io` stream over it.
export struct File { fd: i64 }

// Open `path` for reading, or fail if it cannot be opened.
export function open(path: string): File! {
  let fd = fsOpen(path, false)
  if (fd < 0) {
    fail newError("cannot open file: ${path}")
  }
  return File{ fd: fd }
}

// Create `path` (truncating any existing file) for writing, or fail.
export function create(path: string): File! {
  let fd = fsOpen(path, true)
  if (fd < 0) {
    fail newError("cannot create file: ${path}")
  }
  return File{ fd: fd }
}

// The entire file contents as a string.
export function (f: File) readAll(): string {
  return fsReadAll(f.fd)
}

// Write `s` to the file, or fail on a write error.
export function (f: File) write(s: string): ()! {
  if (fsWrite(f.fd, s) < 0) {
    fail newError("write failed")
  }
}

// Close the file. Idiomatically deferred right after a successful open.
export function (f: File) close() {
  fsClose(f.fd)
}

// Read an entire file by path — open, read, close.
export function readFile(path: string): string! {
  let f = open(path)?
  defer f.close()
  return f.readAll()
}

// Write `content` to `path`, creating/truncating it — open, write, close.
export function writeFile(path: string, content: string): ()! {
  let f = create(path)?
  defer f.close()
  f.write(content)?
}

// --- appending ------------------------------------------------------------

// Open `path` for appending, creating it if absent. Every write lands at the
// end of the file, atomically with respect to other appenders (`O_APPEND`).
export function openAppend(path: string): File! {
  let fd = fsAppend(path)
  if (fd < 0) {
    fail newError("cannot open for append: ${path}")
  }
  return File{ fd: fd }
}

// Append `content` to `path`, creating it if absent.
export function appendFile(path: string, content: string): ()! {
  let f = openAppend(path)?
  defer f.close()
  f.write(content)?
}

// Read up to `max` bytes. The result is shorter than `max` at end of file, and
// empty exactly at end of file. Unlike `readAll` this works on pipes and stdin,
// which have no size to seek to.
export function (f: File) read(max: int): string {
  return fsRead(f.fd, max)
}

// --- paths on disk --------------------------------------------------------

// Whether `path` names anything at all.
export function exists(path: string): bool {
  return fsExists(path)
}

// Whether `path` names a directory. False for a missing path.
export function isDir(path: string): bool {
  return fsIsDir(path)
}

// Create directory `path`. Fails if it exists, or if its parent does not.
export function mkdir(path: string): ()! {
  if (fsMkdir(path) < 0) {
    fail newError("cannot create directory: ${path}")
  }
}

// Remove a file, or an empty directory.
export function remove(path: string): ()! {
  if (fsRemove(path) < 0) {
    fail newError("cannot remove: ${path}")
  }
}

// --- directories ----------------------------------------------------------

// The names (not paths) of `path`'s entries, excluding "." and "..", sorted so
// a listing is reproducible across filesystems.
export function readDir(path: string): []string! {
  if (!fsIsDir(path)) {
    fail newError("not a directory: ${path}")
  }
  return sortNames(splitEntries(fsListDir(path)))
}

// The primitive returns entries NUL-terminated: NUL is the one byte a POSIX
// filename cannot contain, so unlike a newline it can never appear inside a name.
function splitEntries(raw: string): []string {
  let out = []string(0)
  let start = 0
  let i = 0
  while (i < len(raw)) {
    if (raw[i] == 0) {
      out = append(out, raw[start:i])
      start = i + 1
    }
    i = i + 1
  }
  return out
}

// O(n log n) bottom-up (iterative) merge sort (#2151) — replaces an insertion
// sort whose O(n^2) behavior cost 105s of CPU at 50,000 entries, since
// `readdir` returns names in hash order (effectively random) rather than
// anything close to sorted. Bottom-up rather than recursive so the loop nest
// is directly Power-of-10 bounded: the outer pass count is ceil(log2(n)),
// each inner loop is bounded by n, with no recursion depth to reason about.
function sortNames(names: []string): []string {
  let n = len(names)
  if (n <= 1) {
    return names
  }
  let buf = []string(n)
  let width = 1
  while (width < n) {
    let lo = 0
    while (lo < n) {
      let mid = lo + width
      if (mid > n) {
        mid = n
      }
      let hi = lo + 2 * width
      if (hi > n) {
        hi = n
      }
      mergeRuns(names, buf, lo, mid, hi)
      lo = lo + 2 * width
    }
    let i = 0
    while (i < n) {
      names[i] = buf[i]
      i = i + 1
    }
    width = width * 2
  }
  return names
}

// Merges the two already-sorted runs `[lo, mid)` and `[mid, hi)` of `a` into
// the same index range of `buf`. `<=` (not `<`) keeps `a[i]` on a tie, so
// equal-named entries — impossible for real directory entries, but kept for
// any future caller of this general merge — stay in their original order.
function mergeRuns(a: []string, buf: []string, lo: int, mid: int, hi: int) {
  let i = lo
  let j = mid
  let k = lo
  while (i < mid && j < hi) {
    if (compare(a[i], a[j]) <= 0) {
      buf[k] = a[i]
      i = i + 1
    } else {
      buf[k] = a[j]
      j = j + 1
    }
    k = k + 1
  }
  while (i < mid) {
    buf[k] = a[i]
    i = i + 1
    k = k + 1
  }
  while (j < hi) {
    buf[k] = a[j]
    j = j + 1
    k = k + 1
  }
}

// Maximum directory nesting `walk` will descend. Bounds the recursion, so a
// symlink loop fails loudly instead of running forever.
const maxWalkDepth: int = 64

// Every *file* path beneath `root`, depth-first and sorted at each level.
// Directories are descended into, not themselves returned.
export function walk(root: string): []string! {
  return walkInto(root, []string(0), maxWalkDepth)?
}

function walkInto(dir: string, acc: []string, depth: int): []string! {
  if (depth <= 0) {
    fail newError("walk: directory nesting exceeds ${maxWalkDepth} at ${dir}")
  }
  let out = acc
  for name of readDir(dir)? {
    let p = join(dir, name)
    if (fsIsDir(p)) {
      out = walkInto(p, out, depth - 1)?
    } else {
      out = append(out, p)
    }
  }
  return out
}
