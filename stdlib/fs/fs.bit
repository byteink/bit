// Bit standard library — fs module.
//
// File I/O built on the low-level `fs*` primitives (ABI.md §14). `open`/`create`
// return a `File` or an error, so `defer f.close()` is the idiomatic cleanup;
// `readFile`/`writeFile` wrap the whole open→use→close dance. This module is
// written in Bit — it leans on the language's own error handling (`!`/`fail`/
// `?`), `defer`, structs, and methods.
//
// A note on concurrency: these calls block the green thread's worker for the
// duration of the syscall. That is not an oversight the netpoller could fix —
// POSIX has no non-blocking read of a regular file, and epoll/kqueue always
// report one as ready. The netpoller (ABI.md §11) exists for sockets and pipes.
import { join } from "std/path"
import { sortInPlace } from "std/sort"

// `bit_rt_fs_read_all` itself stays a single non-fallible primitive (ABI.md
// §14): `open`/`create`/`write` above report failure through an in-band `-1`
// sentinel because their results are integers, but a read's result is the
// whole file's content, and `string` has no sentinel value to spare. This
// out-of-band accessor is how `readAll` below tells a genuine I/O error (a
// failed `lseek`/alloc) from a genuine empty file, which never sets it. Must
// be read immediately after `fsReadAll` returns, with no other call between —
// runtime/root/slots.bit's `rtFsReadAllFailed` doc comment states the same
// adjacency requirement from the runtime side.
extern fn bit_rt_fs_read_all_failed(): bool

// An open file handle. `fd` is an OS file descriptor; do not use a File after
// close(). Exported so callers can name it (`let f: File = ...`) and reach `fd`
// to build a buffered `std/io` stream over it.
export class File {
  fd: i64
  // The entire file contents as a string, or fail on a seek/read/allocation
  // error. A genuinely empty file returns "" with no error (#2996).
  export readAll(): string! {
    let s = fsReadAll(this.fd)
    if (bit_rt_fs_read_all_failed()) {
      fail newError("read failed")
    }
    return s
  }

  // Write `s` to the file, or fail on a write error.
  export write(s: string): ()! {
    if (fsWrite(this.fd, s) < 0) {
      fail newError("write failed")
    }
  }

  // Flush this file's written bytes to stable storage. Until this returns, a
  // write that `write` already reported as successful can still be lost to a
  // power failure.
  //
  // A failure here is unrecoverable for this file: do not retry the sync and
  // do not keep writing through this handle. The OS may have already
  // dropped the dirty pages and marked the error consumed, so a later
  // `sync()` call can return success with the data never actually written
  // (the mechanism behind PostgreSQL's 2018 "fsyncgate"). The only safe
  // response to a failed `sync()` is to stop using this file.
  export sync(): ()! {
    if (bit_rt_fs_sync(this.fd) < 0) {
      fail newError("fsync failed")
    }
  }

  // Set this file's length to `size`, without moving the file's own
  // read/write cursor (ABI.md §14). Shrinking discards the trailing bytes;
  // growing extends the file with a hole that reads as zeros. Neither
  // direction itself flushes -- call `sync` for the new length to be durable.
  export truncate(size: i64): ()! {
    if (size < 0) {
      fail newError("truncate: negative size")
    }
    if (bit_rt_fs_truncate(this.fd, size) < 0) {
      fail newError("truncate failed")
    }
  }

  // This file's current length in bytes.
  export size(): i64! {
    let n = bit_rt_fs_size(this.fd)
    if (n < 0) {
      fail newError("size failed")
    }
    return n
  }

  // Take a whole-file, ADVISORY exclusive lock, blocking until it is
  // available. Advisory only -- it constrains nothing about `read`/`write`/
  // `readAt`/`writeAt` on this or any other handle; only another `lock`/
  // `tryLock`/`lockShared`/`tryLockShared` call observes it. Two `File`
  // values open on the same path in ONE process contend with each other,
  // same as two processes (ABI.md §14, #4014).
  export lock(): ()! {
    if (bit_rt_fs_lock(this.fd, true, true) < 0) {
      fail newError("lock failed")
    }
  }

  // Like `lock`, but never blocks: `true` if the lock was taken, `false` if
  // it is currently held elsewhere. Only a genuine error fails.
  export tryLock(): bool! {
    let rc = bit_rt_fs_lock(this.fd, true, false)
    if (rc == 0) {
      return true
    }
    if (rc == 0 - 1) {
      return false
    }
    fail newError("tryLock failed")
  }

  // Take a whole-file, advisory SHARED lock, blocking until it is available.
  // Any number of shared holders coexist; an exclusive `lock`/`tryLock`
  // against them blocks/fails until every shared holder releases.
  export lockShared(): ()! {
    if (bit_rt_fs_lock(this.fd, false, true) < 0) {
      fail newError("lockShared failed")
    }
  }

  // Like `lockShared`, but never blocks: `true` if the shared lock was
  // taken, `false` if an exclusive lock is currently held elsewhere.
  export tryLockShared(): bool! {
    let rc = bit_rt_fs_lock(this.fd, false, false)
    if (rc == 0) {
      return true
    }
    if (rc == 0 - 1) {
      return false
    }
    fail newError("tryLockShared failed")
  }

  // Release a lock taken by `lock`/`tryLock`/`lockShared`/`tryLockShared` on
  // this handle. A safe no-op if this handle holds no lock.
  export unlock(): ()! {
    if (bit_rt_fs_unlock(this.fd) < 0) {
      fail newError("unlock failed")
    }
  }

  // Read into `buf` starting at byte offset `off`, without moving the file's
  // own read/write cursor (`pread(2)`). A short result -- including 0 at end
  // of file -- is not a failure; only a negative count from the OS is. Safe
  // to call concurrently with other readAt/writeAt calls on the same fd from
  // several green threads: there is no shared cursor to race.
  export readAt(buf: []byte, off: i64): int! {
    let n = bit_rt_fs_pread_w(this.fd, ptrOf(buf), len(buf), off)
    if (n < 0) {
      fail newError("readAt failed")
    }
    return int(n)
  }

  // Write `buf` starting at byte offset `off`, without moving the file's own
  // read/write cursor (`pwrite(2)`). Extends the file, or leaves a zero-filled
  // hole before `off` if the file was shorter, exactly as POSIX `pwrite`
  // does. Safe to call concurrently with other readAt/writeAt calls on the
  // same fd from several green threads: there is no shared cursor to race.
  export writeAt(buf: []byte, off: i64): int! {
    let n = bit_rt_fs_pwrite_w(this.fd, ptrOf(buf), len(buf), off)
    if (n < 0) {
      fail newError("writeAt failed")
    }
    return int(n)
  }

  // Close the file. Idiomatically deferred right after a successful open.
  //
  // Releases any lock this handle holds. Unix needs no help here -- `flock`
  // already releases when the last fd for the open file description closes
  // -- but Windows' `LockFileEx` has no such guarantee on close (undocumented
  // per Win32 convention), so this calls `bit_rt_fs_unlock` unconditionally
  // before closing: it is a safe no-op on every platform when nothing was
  // locked (ABI.md §14, #4014).
  export close() {
    let _ = bit_rt_fs_unlock(this.fd)
    fsClose(this.fd)
  }

  // Read up to `max` bytes. The result is shorter than `max` at end of file, and
  // empty exactly at end of file. Unlike `readAll` this works on pipes and stdin,
  // which have no size to seek to.
  export read(max: int): string {
    return fsRead(this.fd, max)
  }
}

// Open `path` for reading, or fail if it cannot be opened.
export fn open(path: string): File! {
  let fd = fsOpen(path, false)
  if (fd < 0) {
    fail newError("cannot open file: ${path}")
  }
  return File{ fd: fd }
}

// Create `path` (truncating any existing file) for writing, or fail.
export fn create(path: string): File! {
  let fd = fsOpen(path, true)
  if (fd < 0) {
    fail newError("cannot create file: ${path}")
  }
  return File{ fd: fd }
}

// `bit_rt_fs_open_rw_w` (ABI.md §14, #3533): `O_RDWR|O_CREAT`, deliberately
// WITHOUT `O_TRUNC` -- creates `path` if absent, never destroys existing
// content on open. `words`/`n` are the packed, one-byte-per-element backing
// store of a Bit `[]byte` (§2, #3121/#3226), the same convention
// `bit_rt_fs_is_symlink_w` uses, since §11.7 admits no `string` across an
// `extern fn` boundary.
extern fn bit_rt_fs_open_rw_w(path: *byte, n: int): i64

// Open `path` for both reading and writing via `readAt`/`writeAt`, creating
// it if absent. Existing content is preserved -- unlike `create`, this never
// truncates. Combine with `readAt`/`writeAt` to work one fd that supports
// both directions, the shape a page store needs.
export fn openReadWrite(path: string): File! {
  let w = pathWords(path)
  let fd = bit_rt_fs_open_rw_w(ptrOf(w), len(path))
  if (fd < 0) {
    fail newError("cannot open file read-write: ${path}")
  }
  return File{ fd: fd }
}

// `bit_rt_fs_sync` (ABI.md §14, #3462): darwin F_FULLFSYNC+fsync fallback,
// linux raw fsync syscall, windows FlushFileBuffers.
extern fn bit_rt_fs_sync(fd: i64): i64

// `bit_rt_fs_truncate`/`bit_rt_fs_size` (ABI.md §14, #4016): set/read `fd`'s
// length without moving its read/write cursor. Both return a negative value
// on any failure.
extern fn bit_rt_fs_truncate(fd: i64, size: i64): i64
extern fn bit_rt_fs_size(fd: i64): i64

// `bit_rt_fs_lock`/`bit_rt_fs_unlock` (ABI.md §14, #4014): whole-file
// advisory lock via `flock(2)`, deliberately not `fcntl` -- keyed on the
// open file description, so two `File`s from separate opens in ONE process
// correctly contend. `fs_lock` returns 0 on success, -1 ONLY when
// `blocking` is false and the lock is held elsewhere (the normal
// `tryLock`/`tryLockShared` outcome, not a failure), -2 for any other
// error. `fs_unlock` is a no-op success on a handle holding no lock.
extern fn bit_rt_fs_lock(fd: i64, exclusive: bool, blocking: bool): i64
extern fn bit_rt_fs_unlock(fd: i64): i64

// `bit_rt_fs_pread_w`/`bit_rt_fs_pwrite_w` (ABI.md §14, #3463): darwin
// pread/pwrite, linux raw pread64/pwrite64 syscalls, windows ReadFile/
// WriteFile over a synchronous OVERLAPPED. `buf` is the packed, one-byte-
// per-element backing store of a Bit `[]byte` (§2, #3121/#3226) -- not a C
// string, not `RtBytes` -- since §11.7 admits no `string` across an `extern
// fn` boundary. Byte count transferred, or negative on any I/O error; a
// short count, including 0 at end of file, is not an error.
extern fn bit_rt_fs_pread_w(fd: i64, buf: *byte, max: int, off: i64): i64
extern fn bit_rt_fs_pwrite_w(fd: i64, buf: *byte, n: int, off: i64): i64

// Read an entire file by path — open, read, close.
export fn readFile(path: string): string! {
  let f = open(path)?
  defer f.close()
  return f.readAll()?
}

// Write `content` to `path`, creating/truncating it — open, write, close.
export fn writeFile(path: string, content: string): ()! {
  let f = create(path)?
  defer f.close()
  f.write(content)?
}

// --- appending ------------------------------------------------------------

// Open `path` for appending, creating it if absent. Every write lands at the
// end of the file, atomically with respect to other appenders (`O_APPEND`).
export fn openAppend(path: string): File! {
  let fd = fsAppend(path)
  if (fd < 0) {
    fail newError("cannot open for append: ${path}")
  }
  return File{ fd: fd }
}

// Append `content` to `path`, creating it if absent.
export fn appendFile(path: string, content: string): ()! {
  let f = openAppend(path)?
  defer f.close()
  f.write(content)?
}

// --- the current directory -------------------------------------------------

// The absolute path of the process's current working directory. Fails if it
// could not be determined -- `getcwd`'s own failure modes: the directory has
// been removed out from under the running process, a path component became
// unreadable, or the resolved path exceeds the runtime's path length limit.
//
// The runtime primitive (`bit_rt_fs_cwd`) signals exactly that by returning
// the empty string, which is otherwise never a valid answer -- POSIX's
// `getcwd` always yields at least "/" on success -- so no out-of-band flag
// is needed to tell failure from a genuine result, unlike `readAll` above,
// whose result IS legitimately empty for an empty file.
export fn cwd(): string! {
  let s = fsCwd()
  if (len(s) == 0) {
    fail newError("cannot determine the current working directory")
  }
  return s
}

// --- paths on disk --------------------------------------------------------

// Whether `path` names anything at all.
export fn exists(path: string): bool {
  return fsExists(path)
}

// Whether `path` names a directory. False for a missing path.
//
// This FOLLOWS a symbolic link, as `stat(2)` does and as Go's `os.Stat` does:
// a link to a directory answers true. Ask `isSymlink` as well when the
// distinction matters — `walk` does exactly that (#2152).
export fn isDir(path: string): bool {
  return fsIsDir(path)
}

// The symlink probe (#2152), and the one runtime fs primitive `std/fs` reaches
// by `extern` rather than by a compiler-recognized `fs*` name — so it is also
// the one that cannot be handed a `string`: SPEC §11.7 admits only scalars and
// raw pointers across an `extern` boundary.
//
// `path` IS NOT A C STRING. It is the backing store of a Bit `[]byte` (packed,
// one byte per element — ABI.md §2, #3121/#3226), so it is `n` raw bytes, not
// NUL-terminated. NUL-terminating it into a real path is the runtime's job,
// deliberately: that is where `max_path` and the embedded-NUL rejection
// (#2146) already live for the other eight path-taking primitives, and where
// the bounded path buffer already exists.
extern fn bit_rt_fs_is_symlink_w(path: *byte, n: int): bool

// Copies `path`'s bytes into a fresh `[]byte` — the packed, one-byte-per-
// element encoding the `_w`-suffixed externs in this module take, since §11.7
// admits no `string` across an `extern fn` boundary. Shared by `isSymlink`,
// `stat` and `lstat`.
fn pathWords(path: string): []byte {
  let n = len(path)
  let w = []byte(n)
  let i = 0
  while (i < n) {
    w[i] = path[i]
    i = i + 1
  }
  return w
}

// Whether `path` names a symbolic LINK itself — the question asked of the link,
// not of what it resolves to, so this is `lstat`-shaped where `exists` and
// `isDir` are `stat`-shaped. A link to a directory is `isDir(p) == true` AND
// `isSymlink(p) == true`; a link whose target is missing is still a link, and
// still answers true.
//
// False for the empty path, for a missing path, for anything that is not a
// link, and for a path the OS refuses to answer for — the same "never fails"
// contract `exists` and `isDir` carry.
export fn isSymlink(path: string): bool {
  let n = len(path)
  if (n == 0) {
    return false
  }
  return bit_rt_fs_is_symlink_w(ptrOf(pathWords(path)), n)
}

// --- metadata (stat/lstat) -------------------------------------------------

// `stat(2)`/`lstat(2)` result (ABI.md §14, #2153): `size` in bytes, `mtime` in
// seconds since the Unix epoch, and `mode`'s low 12 bits (permission plus
// setuid/setgid/sticky). `isDir`/`isSymlink` mirror the standalone `isDir`/
// `isSymlink` functions above, computed from the same `st_mode` word.
export class FileInfo {
  size: i64,
  mtime: i64,
  mode: i64,
  isDir: bool,
  isSymlink: bool,
}

// Number of `i64` words `bit_rt_fs_stat_w`/`bit_rt_fs_lstat_w` write into
// `out`: size, mtime, mode, isDir, isSymlink, in that order (ABI.md §14's
// `fillStat`).
const statOutWords: int = 5

// `bit_rt_fs_stat_w`/`bit_rt_fs_lstat_w` (ABI.md §14, #2153): same `words`/`n`
// packed-path pair `bit_rt_fs_is_symlink_w` takes, plus `out`, a pointer to a
// `statOutWords`-word sink this module allocates and the runtime fills. `0` on
// success, `-errno` on failure — the same signed convention `std/net`'s
// syscall-backed primitives use (#2343).
extern fn bit_rt_fs_stat_w(words: *byte, n: int, out: *i64): i64
extern fn bit_rt_fs_lstat_w(words: *byte, n: int, out: *i64): i64

// ENOENT: identical on Darwin and Linux (POSIX), and the one errno `stat`/
// `lstat` name explicitly — every other failure reads as a bare errno number,
// matching `std/net`'s `netFailMsg` (no errno-to-name table is reachable here
// without a runtime change or per-platform source, out of this module's scope).
const enoent: i64 = 2

// `rc < 0` on either `stat`/`lstat` extern is `-errno`; turn it into the
// message `fail`s, distinguishing ENOENT from everything else.
fn statFailMsg(path: string, rc: i64): string {
  let errno = 0 - rc
  if (errno == enoent) {
    return "no such file or directory: ${path}"
  }
  return "stat failed (errno ${errno}): ${path}"
}

// Turns an extern's `(rc, out)` pair into a `FileInfo!`, shared by `stat` and
// `lstat` — the only difference between them is which extern fills `out`.
fn statResult(path: string, rc: i64, out: []i64): FileInfo! {
  if (rc < 0) {
    fail newError(statFailMsg(path, rc))
  }
  return FileInfo{
    size: out[0],
    mtime: out[1],
    mode: out[2],
    isDir: out[3] != 0,
    isSymlink: out[4] != 0,
  }
}

// Report `path`'s metadata, FOLLOWING a trailing symlink — `stat`-shaped, like
// `isDir` above. `isSymlink` is always `false` in the result: a followed link
// is indistinguishable from its target. Fails on a missing path or any other
// stat error.
export fn stat(path: string): FileInfo! {
  let w = pathWords(path)
  let out = []i64(statOutWords)
  let rc = bit_rt_fs_stat_w(ptrOf(w), len(path), ptrOf(out))
  return statResult(path, rc, out)?
}

// Report `path`'s metadata WITHOUT following a trailing symlink —
// `lstat`-shaped, like `isSymlink` above. `isSymlink` in the result reflects
// `path` itself. Fails on a missing path or any other stat error.
export fn lstat(path: string): FileInfo! {
  let w = pathWords(path)
  let out = []i64(statOutWords)
  let rc = bit_rt_fs_lstat_w(ptrOf(w), len(path), ptrOf(out))
  return statResult(path, rc, out)?
}

// Create directory `path`. Fails if it exists, or if its parent does not.
export fn mkdir(path: string): ()! {
  if (fsMkdir(path) < 0) {
    fail newError("cannot create directory: ${path}")
  }
}

// Remove a file, or an empty directory.
export fn remove(path: string): ()! {
  if (fsRemove(path) < 0) {
    fail newError("cannot remove: ${path}")
  }
}

// Rename (move) `oldPath` to `newPath`. POSIX semantics: if `newPath` already
// exists it is replaced atomically, which is not a failure. Fails if
// `oldPath` does not exist.
export fn rename(oldPath: string, newPath: string): ()! {
  if (fsRename(oldPath, newPath) < 0) {
    fail newError("cannot rename: ${oldPath} to ${newPath}")
  }
}

// --- directories ----------------------------------------------------------

// The names (not paths) of `path`'s entries, excluding "." and "..", sorted so
// a listing is reproducible across filesystems.
export fn readDir(path: string): []string! {
  if (!fsIsDir(path)) {
    fail newError("not a directory: ${path}")
  }
  let names = splitEntries(fsListDir(path))
  sortInPlace(names, (a, b) => a < b)
  return names
}

// The primitive returns entries NUL-terminated: NUL is the one byte a POSIX
// filename cannot contain, so unlike a newline it can never appear inside a name.
fn splitEntries(raw: string): []string {
  let out = []string(0)
  let start = 0
  let i = 0
  while (i < len(raw)) {
    if (raw[i] == 0) {
      out = append(out, raw[start:i])
      start = i + 1
    }
    i = i + 1
  }
  return out
}

// Maximum REAL directory nesting `walk` will descend, and a bound on the
// recursion (Power of 10 rule 2) — nothing more. It is explicitly NOT the
// defence against a symlink loop: `walk` does not follow links at all, so no
// link can add depth. It used to claim that job and could not do it, which is
// how a self-referential link inflated a one-file tree to 33 paths (#2152).
const maxWalkDepth: int = 64

// Every *file* path beneath `root`, depth-first and sorted at each level.
// Directories are descended into, not themselves returned.
//
// SYMBOLIC LINKS ARE REPORTED BUT NEVER FOLLOWED (#2152), which is Go's
// `filepath.WalkDir` ("WalkDir does not follow symbolic links") and the default
// of Rust's `walkdir` (`follow_links(false)`). A link is yielded as a leaf path
// exactly like a file, whatever it points at, so a caller still learns it is
// there and can call `isSymlink` to identify it — silently omitting it would be
// its own surprise. Nothing below `root` is descended through a link, so no
// returned path can name data outside the tree the caller asked about, and a
// link pointing at its own ancestor cannot loop.
//
// `root` ITSELF IS USED AS GIVEN. Naming a link as the root is an explicit
// request to walk what it points at, so it is followed — the `follow_root_links`
// default `walkdir` settled on. It leaks nothing: the caller chose it.
export fn walk(root: string): []string! {
  return walkInto(root, []string(0), maxWalkDepth)?
}

// Whether `p` is a directory `walk` may descend into: a REAL one, not a link
// that resolves to one. Both questions are needed because `fsIsDir` follows
// links (it is `opendir`/`stat`-shaped), which makes a link to a directory
// indistinguishable from a directory on its own.
//
// The `&&` order is load-bearing, not cosmetic. `isSymlink` reports false both
// for "not a link" and for "could not probe", and only the first is safe to
// descend on — but both primitives screen a path through the SAME runtime
// `max_path` and embedded-NUL rules, so a path `fsIsDir` accepted is always
// one `isSymlink` can decide. By the time the second operand runs, "could not
// probe" is unreachable. Reversing the operands would drop that guarantee.
fn isRealDir(p: string): bool {
  return fsIsDir(p) && !isSymlink(p)
}

fn walkInto(dir: string, acc: []string, depth: int): []string! {
  if (depth <= 0) {
    fail newError("walk: directory nesting exceeds ${maxWalkDepth} at ${dir}")
  }
  let out = acc
  for name of readDir(dir)? {
    let p = join(dir, name)
    if (isRealDir(p)) {
      out = walkInto(p, out, depth - 1)?
    } else {
      // bit:lint allow E0214 -- unexported; its 2 call sites (walk passes a fresh []string(0), the recursive call in walkInto itself reassigns out = walkInto(...)) never read the pre-call slice again
      out = append(out, p)
    }
  }
  return out
}
