// Bit standard library — seq module, transforms.
//
// Higher-order helpers over slices (`[]T`): each takes an arrow-fn callback and
// builds a fresh slice or scalar (the input is never mutated). They monomorphize
// at each call site for the element, result, and accumulator types. Companions
// to seq.bit's element-equality helpers; `find` returns an `Option<T>` (prelude).

// A new slice with `f` applied to every element of `xs`.
export fn mapped<T, U>(xs: []T, f: (T) => U): []U {
  let out: []U = []U(0)
  for x of xs {
    out = append(out, f(x))
  }
  return out
}

// A new slice of the elements of `xs` for which `keep` returns true.
export fn filter<T>(xs: []T, keep: (T) => bool): []T {
  let out: []T = []T(0)
  for x of xs {
    if (keep(x)) {
      out = append(out, x)
    }
  }
  return out
}

// Folds `xs` left-to-right into one accumulator, starting from `init`.
export fn reduce<T, A>(xs: []T, init: A, step: (A, T) => A): A {
  let acc = init
  for x of xs {
    acc = step(acc, x)
  }
  return acc
}

// Calls `f` on each element of `xs`, in order, for its side effects.
export fn forEach<T>(xs: []T, f: (T) => ()) {
  for x of xs {
    f(x)
  }
}

// The first element of `xs` for which `pred` is true, as `Some`, else `None`.
export fn find<T>(xs: []T, pred: (T) => bool): Option<T> {
  for x of xs {
    if (pred(x)) {
      return Option.Some(x)
    }
  }
  return Option<T>.None
}

// Whether `pred` holds for at least one element of `xs`.
export fn any<T>(xs: []T, pred: (T) => bool): bool {
  for x of xs {
    if (pred(x)) {
      return true
    }
  }
  return false
}

// Whether `pred` holds for every element of `xs` (true for an empty slice).
export fn all<T>(xs: []T, pred: (T) => bool): bool {
  for x of xs {
    if (!pred(x)) {
      return false
    }
  }
  return true
}
