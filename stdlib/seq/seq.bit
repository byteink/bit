// Bit standard library — seq module.
//
// Small generic helpers over slices (`[]T`), written in Bit itself: they lean
// only on for..of, `==`, and the `len`/`append` builtins, so they monomorphize
// at each call site for whatever element type is used. Element equality uses
// `==`, so `T` must be a comparable type (§14.9).
//
// `indexOf` reports "not found" as `-1` (a plain index is handy for slicing);
// for an `Option`-returning search by predicate, see `find` in transform.bit.

// Whether `xs` contains an element equal to `x`.
export fn contains<T>(xs: []T, x: T): bool {
  for e of xs {
    if (e == x) {
      return true
    }
  }
  return false
}

// The index of the first element equal to `x`, or `-1` if there is none.
export fn indexOf<T>(xs: []T, x: T): i64 {
  let i: i64 = 0
  for e of xs {
    if (e == x) {
      return i
    }
    i = i + 1
  }
  return -1
}

// How many elements of `xs` are equal to `x`.
export fn count<T>(xs: []T, x: T): i64 {
  let n: i64 = 0
  for e of xs {
    if (e == x) {
      n = n + 1
    }
  }
  return n
}

// A new slice holding `xs`'s elements in reverse order; `xs` is left unchanged.
export fn reverse<T>(xs: []T): []T {
  let out: []T = []T(0)
  let i: i64 = len(xs) - 1
  while (i >= 0) {
    out = append(out, xs[i])
    i = i - 1
  }
  return out
}

// A new slice holding a copy of `xs`'s elements, with its own backing array.
// `append` grows its argument in place and the result aliases the original's
// storage, so a slice handed to a callee that appends can have its own view
// mutated underneath it; `clone` is the way to take an independent snapshot
// before that happens. Appending to (or writing into) the clone never affects
// `xs`, and vice versa — including for a reference-typed element (`string`, a
// struct), since it is `xs`'s elements that are copied into a fresh backing
// array, not the slice header reinterpreted over the same one.
export fn clone<T>(xs: []T): []T {
  let out: []T = []T(0)
  for x of xs {
    out = append(out, x)
  }
  return out
}
