// Bit standard library — seq module, collections.
//
// The other half of std/seq: helpers that pull a slice out of a map, or
// change a slice's shape (insert, remove, concat, unique) instead of merely
// transforming its elements in place. Same budget as seq.bit and
// transform.bit: `for..of`, `==`, and the `len`/`append` builtins only, so
// every function here monomorphizes at each call site.

// `m`'s keys, as a slice. Iteration order is deterministic for a given build
// but is neither insertion order nor sorted — if callers need a stable
// printed order, sort the result with std/sort.
export fn keys<K, V>(m: map<K, V>): []K {
  let out: []K = []K(0)
  for (k, _) of m {
    out = append(out, k)
  }
  return out
}

// `m`'s values, as a slice, in the same (deterministic-but-unordered) order
// as `keys`. See `keys` for the order note.
export fn values<K, V>(m: map<K, V>): []V {
  let out: []V = []V(0)
  for (_, v) of m {
    out = append(out, v)
  }
  return out
}

// A new slice holding `a`'s elements followed by `b`'s; both are left
// unmodified.
export fn concat<T>(a: []T, b: []T): []T {
  let out: []T = []T(0)
  for x of a {
    out = append(out, x)
  }
  for x of b {
    out = append(out, x)
  }
  return out
}

// A new slice like `xs` with `v` inserted before index `at`; `xs` is left
// unmodified. `at <= 0` inserts at the front, `at >= len(xs)` appends at the
// end. Builds an entirely fresh backing array rather than growing `xs`'s, so
// unlike a hand-rolled splice via `append(xs, ...)` it cannot alias or
// mutate the caller's slice.
export fn insertAt<T>(xs: []T, at: i64, v: T): []T {
  let out: []T = []T(0)
  let i: i64 = 0
  while (i < len(xs)) {
    if (i == at) {
      out = append(out, v)
    }
    out = append(out, xs[i])
    i = i + 1
  }
  if (at >= len(xs)) {
    out = append(out, v)
  }
  return out
}

// A new slice like `xs` with the element at index `at` removed; `xs` is left
// unmodified. `at` out of `[0, len(xs))` removes nothing, returning a copy.
export fn removeAt<T>(xs: []T, at: i64): []T {
  let out: []T = []T(0)
  let i: i64 = 0
  while (i < len(xs)) {
    if (i != at) {
      out = append(out, xs[i])
    }
    i = i + 1
  }
  return out
}

// Whether `a` and `b` hold the same elements in the same order. A plain
// `a == b` is not this: §14.6 makes a slice non-comparable. Element equality
// uses `==`, so — like the rest of std/seq — this is only correct for `T`
// where `==` means value equality; `==` on a struct currently compares
// handles (#2105), so `equal` over a slice of structs is wrong until that
// lands.
export fn equal<T>(a: []T, b: []T): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i: i64 = 0
  while (i < len(a)) {
    if (!(a[i] == b[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

// A new slice holding `xs`'s elements with duplicates removed, keeping the
// first occurrence of each and its original relative order. O(n^2): an
// O(n) seen-set would need `map<T, bool>`, which needs `T` to be a
// comparable *type*, and an unbounded type parameter is not one — the
// language has no `comparable` constraint to write. `==` on an unbounded `T`
// is allowed (std/seq's own `contains` relies on it), so the quadratic scan
// is the only spelling available. Also subject to the #2105 handle-equality
// caveat on `equal` above: `unique` over a slice of structs will treat two
// distinct handles as different even when their fields match, until #2105
// lands.
export fn unique<T>(xs: []T): []T {
  let out: []T = []T(0)
  for x of xs {
    let seen = false
    for y of out {
      if (y == x) {
        seen = true
      }
    }
    if (!seen) {
      out = append(out, x)
    }
  }
  return out
}

// Partitions `xs` into buckets keyed by `key`, preserving each bucket's
// relative order of insertion.
export fn groupBy<T, K>(xs: []T, key: (T) => K): map<K, []T> {
  let out = map<K, []T>()
  for x of xs {
    let k = key(x)
    out[k] = append(out[k], x)
  }
  return out
}

// Indexes `xs` by `key`; a later element with a key already seen overwrites
// the earlier one, matching plain map-assignment semantics.
export fn indexBy<T, K>(xs: []T, key: (T) => K): map<K, T> {
  let out = map<K, T>()
  for x of xs {
    out[key(x)] = x
  }
  return out
}
