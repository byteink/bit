// Bit standard library — std/trace: the ambient span context, built on top
// of `std/runtime`'s task-local word (#3969, per #3968's decision — see
// docs/context-propagation.md and runtime/ABI.md's "Task-local storage
// slot"). THIS is the one typed value the decision document says a
// consumer must build for itself; nothing here is a second context
// mechanism.
//
// The task-local word is a single opaque `int`. A span context needs four
// (128-bit trace id, 64-bit span id, a sampled bool) — too much to pack into
// one word — so it is boxed in a 4-element `[]i64` and the word holds that
// box's ADDRESS, exactly as `runtime/ABI.md` describes ("may hold ... the
// address of a GC-managed object"). `[]i64` (a slice) is used, not a class,
// because `ptrOf` (SPEC §11.5) — the only bridge from a traced reference to
// a raw address — is defined on slices, not on classes. The box is kept
// alive by whichever `Span` or task-local word still points at it; the
// runtime's conservative scan of every task's `taskLocal` word
// (`runtime/stw/stwscan.bit`) roots it for exactly as long as that is true.

import { taskLocalGet, taskLocalSet } from "std/runtime"

const ctxTraceHi: int = 0
const ctxTraceLo: int = 1
const ctxSpanId: int = 2
const ctxSampled: int = 3
const ctxWords: int = 4

// The current task's ambient trace context: which trace and which span is
// the immediate parent of the next span this task starts. Copied by value
// out of the boxed word — mutating a `SpanContext` you hold never affects
// the ambient one; call `setCurrentContext` to change it.
export class SpanContext {
  export traceHi: uint,
  export traceLo: uint,
  export spanId: uint,
  export sampled: bool,
}

// True iff `c` is the zero context — no ambient trace (the word was never
// set, directly or by inheritance).
export fn isEmptyContext(c: SpanContext): bool {
  return c.traceHi == 0 && c.traceLo == 0 && c.spanId == 0
}

fn boxContext(c: SpanContext): []i64 {
  let box = []i64(ctxWords, ctxWords)
  box[ctxTraceHi] = i64(c.traceHi)
  box[ctxTraceLo] = i64(c.traceLo)
  box[ctxSpanId] = i64(c.spanId)
  box[ctxSampled] = 0
  if (c.sampled) {
    box[ctxSampled] = 1
  }
  return box
}

// Reconstructs a `*i64` into a live `[]i64` box from the raw address
// `taskLocalGet` returned. `nil + (addr / 8)` is SPEC §11.4's documented
// inverse of `int(p)`: a `*i64` box is 8-byte aligned (runtime/ABI.md
// "Alignment"), so this recovers the exact address `ptrOf` produced.
fn unboxWord(box: []i64, idx: int): uint {
  return uint(box[idx])
}

fn boxAt(addr: int): []i64! {
  if (addr == 0) {
    fail newError("std/trace: no context box at address 0")
  }
  if (addr % 8 != 0) {
    fail newError("std/trace: task-local word is not an aligned box address")
  }
  let base: *i64 = nil
  let p = base + addr / 8
  let box = []i64(ctxWords, ctxWords)
  let i = 0
  while (i < ctxWords) {
    box[i] = *(p + i)
    i = i + 1
  }
  return box
}

// The calling task's ambient span context, or the zero context if none has
// been set on this task, directly or by inheritance from `spawn`.
export fn currentContext(): SpanContext {
  let addr = taskLocalGet()
  if (addr == 0) {
    return SpanContext{ traceHi: 0, traceLo: 0, spanId: 0, sampled: false }
  }
  let box = boxAt(addr) catch _ {
    return SpanContext{ traceHi: 0, traceLo: 0, spanId: 0, sampled: false }
  }
  return SpanContext{
    traceHi: unboxWord(box, ctxTraceHi),
    traceLo: unboxWord(box, ctxTraceLo),
    spanId: unboxWord(box, ctxSpanId),
    sampled: box[ctxSampled] != 0,
  }
}

// Sets the calling task's ambient span context. Returns the raw word that
// was there before (opaque; pass it straight back to `restoreContextWord`
// when the span that set it ends — this is the push/pop discipline
// `span.bit`'s `Span.end()` uses to nest correctly and to leave no trace
// after the outermost span ends).
export fn setCurrentContext(c: SpanContext): int {
  let prev = taskLocalGet()
  let box = boxContext(c)
  taskLocalSet(int(ptrOf(box)))
  return prev
}

// Restores the calling task's task-local word to a value previously
// returned by `setCurrentContext`.
export fn restoreContextWord(prev: int) {
  taskLocalSet(prev)
}
