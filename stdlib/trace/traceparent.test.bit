// stdlib/trace/traceparent.test.bit — W3C traceparent strictness (#3969).
//
// A permissive parser passes every happy-path test; these prove the four
// rejections the ticket names by name: a wrong version, a wrong field
// count, a bad hex digit, and an all-zero trace id.

test "a valid traceparent round-trips through parse and format" {
  let header = "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01"
  let parsed = parseTraceParent(header)
  assert(isSome(parsed), "expected a parsed traceparent")
  let tp = unwrap(parsed)
  assert(tp.sampled, "flags 01 must decode sampled=true")
  assert(
    formatTraceParent(tp.traceHi, tp.traceLo, tp.parentSpanId, tp.sampled) == header,
    "format(parse(header)) must reproduce header",
  )
}

test "an unsampled traceparent decodes sampled=false" {
  let header = "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-00"
  let tp = unwrap(parseTraceParent(header))
  assert(!tp.sampled, "flags 00 must decode sampled=false")
}

test "a wrong version is rejected" {
  let header = "01-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01"
  assert(!isSome(parseTraceParent(header)), "version 01 must be rejected")
}

test "a wrong field count is rejected" {
  let tooFew = "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7"
  let tooMany = "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01-extra"
  assert(!isSome(parseTraceParent(tooFew)), "3 fields must be rejected")
  assert(!isSome(parseTraceParent(tooMany)), "5 fields must be rejected")
}

test "a bad hex digit is rejected" {
  // 'g' is not a hex digit, and 'A' is uppercase — W3C requires lowercase.
  let badDigit = "00-4bf92f3577b34da6a3ce929d0e0e473g-00f067aa0ba902b7-01"
  let upper = "00-4BF92F3577B34DA6A3CE929D0E0E4736-00f067aa0ba902b7-01"
  assert(!isSome(parseTraceParent(badDigit)), "a non-hex digit must be rejected")
  assert(!isSome(parseTraceParent(upper)), "an uppercase hex digit must be rejected")
}

test "an all-zero trace id is rejected" {
  let header = "00-00000000000000000000000000000000-00f067aa0ba902b7-01"
  assert(!isSome(parseTraceParent(header)), "an all-zero trace id is reserved-invalid")
}

test "an all-zero parent id is rejected" {
  let header = "00-4bf92f3577b34da6a3ce929d0e0e4736-0000000000000000-01"
  assert(!isSome(parseTraceParent(header)), "an all-zero parent id is reserved-invalid")
}
