// Bit standard library — std/trace: Span, Attribute, status (#3969).

import { monotonic, now, since, Mono } from "std/time"

// Attribute count and value-length caps — the same cardinality posture as
// `std/metrics`' label cap (#3966): an unbounded caller-supplied attribute
// (a raw request body, a user id repeated per call) must not grow a span
// without bound.
export const maxAttributes: int = 32
export const maxAttributeValueLen: int = 256

// One span attribute. Values are stored as strings; a caller with a numeric
// or bool value formats it before calling `setAttribute`.
export class Attribute {
  export key: string
  export value: string
}

// A span's final outcome (OTLP `Status.StatusCode`: UNSET=0, OK=1, ERROR=2).
export enum SpanStatus { Unset, Ok, Error }

// One unit of work inside a trace: a name, a time range from the monotonic
// clock, a parent-child link, and a bounded attribute set. Construct via
// `Tracer.startSpan`/`Tracer.startSpanFromHeader`, never directly — that is
// where the ambient task-local context (`context.bit`) and sampling
// decision are applied.
export class Span {
  export name: string
  export traceHi: uint
  export traceLo: uint
  export spanId: uint
  export parentSpanId: uint
  export sampled: bool
  export status: SpanStatus
  export attributes: []Attribute
  export droppedAttributes: i64
  export startWallNs: int
  export endWallNs: int
  export durationNs: int
  export ended: bool

  startMono: Mono
  prevContextWord: int
  owner: Tracer

  // Attaches `key`/`value` to this span. Silently drops past
  // `maxAttributes` and truncates a value past `maxAttributeValueLen` — the
  // same "never let caller data grow a signal unbounded" posture as
  // `std/metrics`. A drop only counts past the cap; a truncation is not a
  // drop.
  export setAttribute(key: string, value: string) {
    if (this.ended) {
      return
    }
    if (len(this.attributes) >= maxAttributes) {
      this.droppedAttributes = this.droppedAttributes + 1
      return
    }
    let v = value
    if (len(v) > maxAttributeValueLen) {
      v = v[0:maxAttributeValueLen]
    }
    this.attributes = append(this.attributes, Attribute{ key: key, value: v })
  }

  // Sets this span's final status. `SpanStatus.Error` is what a shutdown
  // force-close (`Tracer.shutdown`) applies to a span still open.
  export setStatus(status: SpanStatus) {
    if (this.ended) {
      return
    }
    this.status = status
  }

  // Ends this span: computes its duration from the monotonic clock,
  // restores the task's ambient context to whatever it was before this span
  // started (so a sibling started after this one is not misattributed as
  // this span's child), and hands the finished span to the owning
  // `Tracer`'s exporter when sampled. A second call is a no-op — the first
  // call's timing and status are final.
  export end() {
    if (this.ended) {
      return
    }
    this.durationNs = since(this.startMono)
    this.endWallNs = now().ns
    this.ended = true
    if (this.status == SpanStatus.Unset) {
      this.status = SpanStatus.Ok
    }
    restoreContextWord(this.prevContextWord)
    this.owner.finishSpan(this)
  }
}

// Builds a fresh, not-yet-started-in-context `Span`. Module-private:
// `tracer.bit`'s `Tracer.beginSpan` is the only caller, mirroring
// `std/metrics`' `Registry.counter` -> `newCounter` shape (construct
// through one function, never a bare composite literal from outside).
fn newSpan(name: string, traceHi: uint, traceLo: uint, spanId: uint, parentSpanId: uint, sampled: bool, prevContextWord: int, owner: Tracer): Span {
  return Span{
    name: name,
    traceHi: traceHi,
    traceLo: traceLo,
    spanId: spanId,
    parentSpanId: parentSpanId,
    sampled: sampled,
    status: SpanStatus.Unset,
    attributes: []Attribute(0),
    droppedAttributes: 0,
    startWallNs: now().ns,
    endWallNs: 0,
    durationNs: 0,
    ended: false,
    startMono: monotonic(),
    prevContextWord: prevContextWord,
    owner: owner,
  }
}
