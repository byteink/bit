// Bit standard library — std/trace: trace/span id generation and strict hex
// codec (#3969).
//
// A trace id is 128 bits (two `uint` halves), a span id is 64 bits — the W3C
// Trace Context sizes (https://www.w3.org/TR/trace-context/#trace-id,
// #parent-id). Both are drawn from `std/crypto`'s CSPRNG, never
// `std/rand`'s seedable generator: a predictable span id would let an
// outsider inject spans into someone else's trace (ticket #3969's own rule).
//
// `std/crypto`'s `decodeHex` (crypto/hex.bit) is case-INSENSITIVE, which is
// wrong for a `traceparent` header: W3C requires lowercase and an
// implementation must reject anything else, so `isLowerHex` here is a
// stricter gate this module runs before ever calling into `decodeHex`.

import { randomU64 } from "std/crypto"

const hexDigits: string = "0123456789abcdef"

// `v`'s 8 bytes as 16 lowercase hex characters, most significant byte first —
// the wire form every W3C `traceparent` field and OTLP JSON id string uses.
export fn hexEncodeU64(v: uint): string {
  let out = []byte(16)
  let i = 0
  while (i < 16) {
    let shift: uint = uint((15 - i) * 4)
    let nibble = int((v >> shift) & 0xf)
    out[i] = hexDigits[nibble]
    i = i + 1
  }
  return string(out)
}

// True iff `s` is exactly `n` LOWERCASE hex characters. `traceparent`
// fields must be rejected on an uppercase letter, not silently accepted.
export fn isLowerHex(s: string, n: int): bool {
  if (len(s) != n) {
    return false
  }
  let i = 0
  while (i < n) {
    let c = s[i]
    if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) {
      return false
    }
    i = i + 1
  }
  return true
}

// Parses exactly 16 lowercase hex characters into a `uint`. Fails on a wrong
// length, an uppercase letter, or any non-hex byte.
export fn hexDecodeU64(s: string): uint! {
  if (!isLowerHex(s, 16)) {
    fail newError("std/trace: expected 16 lowercase hex characters, got '${s}'")
  }
  let v: uint = 0
  let i = 0
  while (i < 16) {
    let c = s[i]
    let d: uint = 0
    if (c >= '0' && c <= '9') {
      d = uint(c - '0')
    } else {
      d = uint(c - 'a') + 10
    }
    v = (v << 4) | d
    i = i + 1
  }
  return v
}

// A fresh 128-bit trace id from the CSPRNG, as (high, low) `uint` halves.
// Redraws on the all-zero id — W3C reserves it as invalid
// (https://www.w3.org/TR/trace-context/#trace-id), and it is astronomically
// unlikely (2^-128) to matter how long this loop bounds the redraw.
export fn newTraceId(): (uint, uint) {
  while (true) {
    let hi = randomU64()
    let lo = randomU64()
    if (hi != 0 || lo != 0) {
      return hi, lo
    }
  }
}

// A fresh 64-bit span id from the CSPRNG. Redraws on the all-zero id, the
// span-id analogue of `newTraceId`'s reserved value
// (https://www.w3.org/TR/trace-context/#parent-id).
export fn newSpanId(): uint {
  while (true) {
    let v = randomU64()
    if (v != 0) {
      return v
    }
  }
}
