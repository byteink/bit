// Bit standard library — std/trace: W3C Trace Context header (#3969).
//
// https://www.w3.org/TR/trace-context/#traceparent-header. Format:
//
//   version "-" trace-id "-" parent-id "-" trace-flags
//   00      -  32 hex     -  16 hex     -  2 hex
//
// This module supports version `00` only (the only version defined by the
// spec at time of writing); any other version is rejected rather than
// guessed at, per the ticket's "malformed starts a new trace" rule below.
//
// PARSING NEVER FAILS THE REQUEST. `parseTraceParent` returns an `Option`,
// never a fallible `!` — the header is attacker-controlled, and #3969's own
// rule is that a malformed one starts a fresh trace rather than a 400 or a
// panic. `tracer.bit` is the caller that turns `None` into "start a new
// trace".

import { split } from "std/strings"

// A parsed (or freshly minted) W3C trace context: which trace, which span
// is the immediate parent, and whether this trace is sampled.
export class TraceParent {
  export traceHi: uint,
  export traceLo: uint,
  export parentSpanId: uint,
  export sampled: bool,
}

// The sampled flag is bit 0 of the flags byte (W3C §trace-flags), i.e. the
// low nibble's own low bit — its hex digit is one of 1/3/5/7/9/b/d/f.
// `flagsField` must already be validated as 2 lowercase hex characters.
fn sampledFlagBit(flagsField: string): bool {
  let lowNibble = flagsField[1]
  let lowNibbleValue = 0
  if (lowNibble >= '0' && lowNibble <= '9') {
    lowNibbleValue = int(lowNibble - '0')
  } else {
    lowNibbleValue = int(lowNibble - 'a') + 10
  }
  return (lowNibbleValue & 1) == 1
}

// Decodes the trace id and parent span id out of already hex-validated
// fields, `None` on a decode failure or a reserved-invalid all-zero id.
// Split out of `parseTraceParent` to keep both functions under the
// complexity ceiling (spec/LINT.md).
fn decodeTraceAndParentIds(traceIdField: string, spanIdField: string): Option<(uint, uint, uint)> {
  let traceHi = hexDecodeU64(traceIdField[0:16]) catch _ {
    return Option<(uint, uint, uint)>.None
  }
  let traceLo = hexDecodeU64(traceIdField[16:32]) catch _ {
    return Option<(uint, uint, uint)>.None
  }
  if (traceHi == 0 && traceLo == 0) {
    return Option<(uint, uint, uint)>.None // all-zero trace id is reserved-invalid
  }
  let spanId = hexDecodeU64(spanIdField) catch _ {
    return Option<(uint, uint, uint)>.None
  }
  if (spanId == 0) {
    return Option<(uint, uint, uint)>.None // all-zero parent id is reserved-invalid
  }
  return Option<(uint, uint, uint)>.Some((traceHi, traceLo, spanId))
}

// Parses a `traceparent` header value. `Option<TraceParent>.None` on ANY
// deviation from the spec: wrong field count, wrong version, a field of the
// wrong length, an uppercase or non-hex digit, or an all-zero trace id or
// parent id (both reserved-invalid by the spec). Never panics, never fails —
// see the module header.
export fn parseTraceParent(header: string): Option<TraceParent> {
  let fields = split(header, "-")
  if (len(fields) != 4) {
    return Option<TraceParent>.None
  }
  let version = fields[0]
  let traceIdField = fields[1]
  let spanIdField = fields[2]
  let flagsField = fields[3]

  if (!isLowerHex(version, 2) || version != "00") {
    return Option<TraceParent>.None
  }
  if (!isLowerHex(traceIdField, 32) || !isLowerHex(spanIdField, 16) || !isLowerHex(flagsField, 2)) {
    return Option<TraceParent>.None
  }

  let ids = decodeTraceAndParentIds(traceIdField, spanIdField)
  if (!isSome(ids)) {
    return Option<TraceParent>.None
  }
  let (traceHi, traceLo, spanId) = unwrap(ids)

  return Option<TraceParent>.Some(
    TraceParent{
      traceHi: traceHi,
      traceLo: traceLo,
      parentSpanId: spanId,
      sampled: sampledFlagBit(flagsField),
    },
  )
}

// Formats a `traceparent` header value for an outgoing request, carrying
// `spanId` as the parent id downstream sees — always version `00`.
export fn formatTraceParent(traceHi: uint, traceLo: uint, spanId: uint, sampled: bool): string {
  let flags = "00"
  if (sampled) {
    flags = "01"
  }
  return "00-" +
    hexEncodeU64(traceHi) +
    hexEncodeU64(traceLo) +
    "-" +
    hexEncodeU64(spanId) +
    "-" +
    flags
}
