// Bit standard library — std/trace: head-based ratio sampling (#3969).
//
// The sampling decision is made ONCE, at the root of a trace (a span with no
// incoming `traceparent`, or one starting a fresh trace because the incoming
// header was malformed), and recorded in the `traceparent` `sampled` flag so
// every downstream service honors the same decision rather than each
// re-sampling independently (the ticket's own rule). A span whose parent
// context already carries a decision (incoming valid header, or a same
// process parent span) never re-samples — see `tracer.bit`.

// `randomU64` is imported once for this module, in `ids.bit`.

// Decides, per draw, whether a NEW trace is sampled. `ratio` is clamped to
// `[0, 1]`: 0 samples nothing, 1 samples everything, and anything between
// samples that fraction of fresh traces — never a per-span decision inside
// an already-decided trace.
export class Sampler {
  // Fraction of `uint`'s range that counts as "sampled", precomputed once so
  // `shouldSample` is a single unsigned compare, not a float multiply per
  // call. Unused when `full` is set.
  threshold: uint
  // Ratio clamped to exactly 1: sample unconditionally rather than relying
  // on `randomU64() < uint max`, which is false for the one draw in 2^64
  // that lands on the max value itself — "1 exports every span" must be
  // exact, not merely overwhelmingly likely.
  full: bool

  export shouldSample(): bool {
    if (this.full) {
      return true
    }
    if (this.threshold == 0) {
      return false
    }
    return randomU64() < this.threshold
  }
}

// A `Sampler` that samples the fraction `ratio` of fresh traces. `ratio` is
// clamped into `[0, 1]` — a caller passing `1.5` or `-1` gets "sample
// everything" or "sample nothing" rather than undefined behavior.
export fn newSampler(ratio: f64): Sampler {
  let r = ratio
  if (r <= 0.0) {
    return Sampler{ threshold: 0, full: false }
  }
  if (r >= 1.0) {
    return Sampler{ threshold: 0, full: true }
  }
  // uint's full range scaled by r, computed in f64 and truncated — exact
  // enough for a sampling ratio, which is inherently a statistical target
  // rather than an exact count.
  let maxF: f64 = 18446744073709551615.0
  return Sampler{ threshold: uint(maxF * r), full: false }
}
