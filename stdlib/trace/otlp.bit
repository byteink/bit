// Bit standard library — std/trace: OTLP/HTTP JSON encoding (#3969).
//
// OTLP/HTTP supports both a binary protobuf body and a JSON body
// (opentelemetry-proto's `json_format.md`); this module emits the JSON
// form so std/trace needs no protobuf wire codec of its own, only
// `std/json`, which already ships. One deviation from the ordinary
// protobuf-JSON mapping is REQUIRED by the OTLP spec itself: `trace_id` and
// `span_id` are hex strings, not base64 — the mapping every other `bytes`
// field uses. `int64`/`fixed64` fields (the two timestamps) are JSON
// strings too, the ordinary protobuf-JSON mapping for 64-bit integers
// (JSON numbers only round-trip exactly through 2^53).

import { Json, JsonEntry, jsonEncode } from "std/json"

const otlpStatusUnset: i64 = 0
const otlpStatusOk: i64 = 1
const otlpStatusError: i64 = 2

fn otlpStatusCode(status: SpanStatus): i64 {
  if (status == SpanStatus.Ok) {
    return otlpStatusOk
  }
  if (status == SpanStatus.Error) {
    return otlpStatusError
  }
  return otlpStatusUnset
}

fn otlpAttribute(a: Attribute): Json {
  return Json.JsonObject([
    JsonEntry{ key: "key", value: Json.JsonString(a.key) },
    JsonEntry{ key: "value", value: Json.JsonObject([
      JsonEntry{ key: "stringValue", value: Json.JsonString(a.value) },
    ]) },
  ])
}

fn otlpAttributes(attrs: []Attribute): Json {
  let out = []Json(0)
  let i = 0
  while (i < len(attrs)) {
    out = append(out, otlpAttribute(attrs[i]))
    i = i + 1
  }
  return Json.JsonArray(out)
}

// `parentSpanId == 0` means a root span — OTLP represents "no parent" as an
// empty string, not an all-zero id (which `traceparent.bit` already treats
// as reserved-invalid on the wire).
fn otlpParentSpanIdHex(parentSpanId: uint): string {
  if (parentSpanId == 0) {
    return ""
  }
  return hexEncodeU64(parentSpanId)
}

fn otlpSpan(sp: Span): Json {
  return Json.JsonObject([
    JsonEntry{ key: "traceId", value: Json.JsonString(hexEncodeU64(sp.traceHi) + hexEncodeU64(sp.traceLo)) },
    JsonEntry{ key: "spanId", value: Json.JsonString(hexEncodeU64(sp.spanId)) },
    JsonEntry{ key: "parentSpanId", value: Json.JsonString(otlpParentSpanIdHex(sp.parentSpanId)) },
    JsonEntry{ key: "name", value: Json.JsonString(sp.name) },
    JsonEntry{ key: "startTimeUnixNano", value: Json.JsonString("${sp.startWallNs}") },
    JsonEntry{ key: "endTimeUnixNano", value: Json.JsonString("${sp.endWallNs}") },
    JsonEntry{ key: "attributes", value: otlpAttributes(sp.attributes) },
    JsonEntry{ key: "status", value: Json.JsonObject([
      JsonEntry{ key: "code", value: Json.JsonInt(otlpStatusCode(sp.status)) },
    ]) },
  ])
}

// The full `ExportTraceServiceRequest` JSON body for one batch. `scopeName`
// identifies the instrumentation library (OTLP's `InstrumentationScope`),
// per spec, not the traced service itself (that is `resource.attributes`,
// left empty here — a future ticket can add resource attributes without
// changing this shape).
export fn encodeOtlpBatch(spans: []Span, scopeName: string): string {
  let out = []Json(0)
  let i = 0
  while (i < len(spans)) {
    out = append(out, otlpSpan(spans[i]))
    i = i + 1
  }
  let body = Json.JsonObject([
    JsonEntry{ key: "resourceSpans", value: Json.JsonArray([
      Json.JsonObject([
        JsonEntry{ key: "resource", value: Json.JsonObject([]JsonEntry(0)) },
        JsonEntry{ key: "scopeSpans", value: Json.JsonArray([
          Json.JsonObject([
            JsonEntry{ key: "scope", value: Json.JsonObject([
              JsonEntry{ key: "name", value: Json.JsonString(scopeName) },
            ]) },
            JsonEntry{ key: "spans", value: Json.JsonArray(out) },
          ]),
        ]) },
      ]),
    ]) },
  ])
  return jsonEncode(body)
}
