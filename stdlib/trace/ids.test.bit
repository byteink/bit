// stdlib/trace/ids.test.bit — hex codec and id generation (#3969).

test "hexEncodeU64 and hexDecodeU64 round-trip" {
  let v: uint = 0x4bf92f3577b34da6
  let hex = hexEncodeU64(v)
  assert(len(hex) == 16, "hexEncodeU64 must produce 16 characters")
  assert(hex == "4bf92f3577b34da6", "got ${hex}")
  let back = hexDecodeU64(hex) catch e {
    assert(false, "hexDecodeU64: ${e.message()}")
    return
  }
  assert(back == v, "round trip must recover the original value")
}

test "hexDecodeU64 rejects a wrong length" {
  hexDecodeU64("abcd") catch _ {
    return
  }
  assert(false, "expected a failure for a short hex string")
}

test "hexDecodeU64 rejects an uppercase digit" {
  hexDecodeU64("4BF92F3577B34DA6") catch _ {
    return
  }
  assert(false, "expected a failure for an uppercase hex string")
}

test "TraceId.random and SpanId.random never draw all-zero" {
  let i = 0
  while (i < 64) {
    let t = TraceId.random()
    assert(t.hi != 0 || t.lo != 0, "trace id must never be all-zero")
    assert(SpanId.random().value != 0, "span id must never be zero")
    i = i + 1
  }
}
