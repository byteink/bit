// stdlib/trace/sampler.test.bit — head-based ratio sampling (#3969).

test "ratio 0 samples nothing" {
  let s = newSampler(0.0)
  let i = 0
  while (i < 200) {
    assert(!s.shouldSample(), "ratio 0 must never sample")
    i = i + 1
  }
}

test "ratio 1 samples everything" {
  let s = newSampler(1.0)
  let i = 0
  while (i < 200) {
    assert(s.shouldSample(), "ratio 1 must always sample")
    i = i + 1
  }
}

test "a Tracer's root span sampled flag matches its sampler's ratio" {
  let never = newTracer("http://127.0.0.1:1", "test", 0.0)
  let sp = never.startSpan("root")
  assert(!sp.sampled, "ratio 0 root span must not be sampled")
  sp.end()
  never.shutdown()

  let always = newTracer("http://127.0.0.1:1", "test", 1.0)
  let sp2 = always.startSpan("root")
  assert(sp2.sampled, "ratio 1 root span must be sampled")
  sp2.end()
  always.shutdown()
}
