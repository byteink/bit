// Bit standard library — io module.
//
// Buffered streams over raw file descriptors, and the three standard ones.
// A struct is a reference type (SPEC §11.2), so these methods mutate the
// stream in place: `w.write("a")` and no reassignment.
//
// Buffering is what makes many small writes cheap: each `write` appends to an
// in-memory buffer, and only a full buffer (or an explicit `flush`) costs a
// syscall. Always `flush` before the stream goes out of scope — nothing does it
// for you.

// Standard file descriptors, as the OS hands them to every process.
export const Stdin: i64 = 0
export const Stdout: i64 = 1
export const Stderr: i64 = 2

// How many bytes a Writer accumulates before it flushes on its own.
const writeBufferSize: int = 4096

// How many bytes a Reader pulls from the fd per refill.
const readChunkSize: int = 4096

// --- writing --------------------------------------------------------------

// Exported because `writer`/`stdout`/`stderr` all return one: a caller has to be
// able to name the type to annotate a binding or return it onward.
export struct Writer {
  fd: i64,
  buf: string
}

// A buffered writer over an already-open descriptor.
export function writer(fd: i64): Writer {
  return Writer{ fd: fd, buf: "" }
}

export function stdout(): Writer {
  return writer(Stdout)
}

export function stderr(): Writer {
  return writer(Stderr)
}

// Buffer `s`, flushing once the buffer is full.
export function (w: Writer) write(s: string) {
  w.buf = w.buf + s
  if (len(w.buf) >= writeBufferSize) {
    w.flush()
  }
}

// Buffer `s` and a newline.
export function (w: Writer) writeLine(s: string) {
  w.write(s + "\n")
}

// Write everything buffered to the descriptor. A no-op when nothing is pending.
export function (w: Writer) flush() {
  if (len(w.buf) > 0) {
    fsWrite(w.fd, w.buf)
    w.buf = ""
  }
}

// --- reading --------------------------------------------------------------

// Exported for the same reason as `Writer`: `reader`/`stdin` return one.
export struct Reader {
  fd: i64,
  buf: string,
  pos: int,
  eof: bool
}

// A buffered reader over an already-open descriptor.
export function reader(fd: i64): Reader {
  return Reader{ fd: fd, buf: "", pos: 0, eof: false }
}

export function stdin(): Reader {
  return reader(Stdin)
}

// Pulls another chunk when the buffer is spent. Returns whether any unread
// bytes are now available.
function (r: Reader) fill(): bool {
  if (r.pos < len(r.buf)) {
    return true
  }
  if (r.eof) {
    return false
  }
  let chunk = fsRead(r.fd, readChunkSize)
  if (len(chunk) == 0) {
    r.eof = true
    return false
  }
  r.buf = chunk
  r.pos = 0
  return true
}

// The next line, without its trailing newline. `None` only at end of input, so
// a final line with no newline of its own is still returned.
export function (r: Reader) readLine(): Option<string> {
  if (!r.fill()) {
    return Option<string>.None
  }
  let line = ""
  while (true) {
    if (!r.fill()) {
      // Input ended mid-line: what we have is a real, newline-less last line.
      return Option.Some(line)
    }
    // Consume up to the next newline in the current buffer, in one slice.
    let start = r.pos
    let i = r.pos
    while (i < len(r.buf) && r.buf[i] != '\n') {
      i = i + 1
    }
    line = line + r.buf[start:i]
    if (i < len(r.buf)) {
      r.pos = i + 1 // step over the newline; it is not part of the line
      return Option.Some(line)
    }
    r.pos = i // buffer exhausted mid-line: refill and keep going
  }
  return Option<string>.None // unreachable; the loop only exits by returning
}

// Everything still unread, to end of input.
export function (r: Reader) readAll(): string {
  let out = ""
  while (r.fill()) {
    out = out + r.buf[r.pos:len(r.buf)]
    r.pos = len(r.buf)
  }
  return out
}
