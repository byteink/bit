// Bit standard library — io module.
//
// Buffered streams over raw file descriptors, and the three standard ones.
// A class is a reference type (SPEC §11.2), so these methods mutate the
// stream in place: `w.write("a")` and no reassignment.
//
// Buffering is what makes many small writes cheap: each `write` appends to an
// in-memory buffer, and only a full buffer (or an explicit `flush`) costs a
// syscall. Always `flush` before a buffered stream goes out of scope — nothing
// does it for you.
//
// `stdout()`/`stderr()` are the exception, and deliberately unbuffered (#2323).
// Module state cannot hold a GC-traced type such as `Writer` (SPEC §11.11), so
// there is no single shared instance an accessor can hand back: every call to
// `stdout()`/`stderr()`/`writer(Stdout)`/`writer(Stderr)` builds a fresh
// `Writer`, and two independently-built Writers with their own buffers would
// silently diverge — a `write` through one is invisible to a `flush` through
// the other, and any buffered bytes never flushed are lost the moment the
// Writer goes out of scope. So a Writer aimed at `Stdout` or `Stderr` skips
// buffering: `write`/`writeLine` reach the fd before the call returns, and
// `flush` is always a no-op. Buffering stays in effect for a Writer over any
// other fd via `writer(fd)` and held across calls, e.g. writing to a file.
//
// Every write can fail — a closed pipe, a read-only fd, a full disk — and
// `write`/`writeLine`/`flush` all return a fallible result so the error is
// not silently dropped (#2338); propagate with `?` or handle with `catch`.

// Standard file descriptors, as the OS hands them to every process.
export const Stdin: i64 = 0
export const Stdout: i64 = 1
export const Stderr: i64 = 2

// How many bytes a Writer accumulates before it flushes on its own.
const writeBufferSize: int = 4096

// How many bytes a Reader pulls from the fd per refill.
const readChunkSize: int = 4096

// --- writing --------------------------------------------------------------

// Exported because `writer`/`stdout`/`stderr` all return one: a caller has to be
// able to name the type to annotate a binding or return it onward. `buf` is a
// `[]byte` grown with `append` (amortized O(1) per byte), not a `string`
// rebuilt with `+` on every write — the shape that made this quadratic (#2340,
// mirroring the #2328 `Reader.readLine` fix).
export class Writer {
  fd: i64
  buf: []byte
  // Buffer `s`, flushing once the buffer is full, or fail on a write error.
  // `Stdout`/`Stderr` are unbuffered (see file header): `s` reaches the fd
  // before this call returns.
  export write(s: string): ()! {
    if (isStandardStream(this.fd)) {
      if (fsWrite(this.fd, s) < 0) {
        fail newError("write failed")
      }
      return
    }
    this.buf = appendRange(this.buf, s, 0, len(s))
    if (len(this.buf) >= writeBufferSize) {
      this.flush()?
    }
  }

  // Buffer `s` and a newline, or fail on a write error.
  export writeLine(s: string): ()! {
    this.write(s + "\n")?
  }

  // Write everything buffered to the descriptor, or fail on a write error. A
  // no-op when nothing is pending — always true for `Stdout`/`Stderr`, which
  // never buffer.
  export flush(): ()! {
    if (len(this.buf) == 0) {
      return
    }
    let pending = string(this.buf)
    this.buf = []byte(0)
    if (fsWrite(this.fd, pending) < 0) {
      fail newError("write failed")
    }
  }
}

// True for the two descriptors every `stdout()`/`stderr()` call independently
// targets — see the file header (#2323) for why they must be unbuffered.
fn isStandardStream(fd: i64): bool {
  return fd == Stdout || fd == Stderr
}

// A buffered writer over an already-open descriptor.
export fn writer(fd: i64): Writer {
  return Writer{ fd: fd, buf: []byte(0) }
}

export fn stdout(): Writer {
  return writer(Stdout)
}

export fn stderr(): Writer {
  return writer(Stderr)
}

// --- reading --------------------------------------------------------------

// Exported for the same reason as `Writer`: `reader`/`stdin` return one.
export class Reader {
  fd: i64
  buf: string
  pos: int
  eof: bool
  // Pulls another chunk when the buffer is spent. Returns whether any unread
  // bytes are now available.
  fill(): bool {
    if (this.pos < len(this.buf)) {
      return true
    }
    if (this.eof) {
      return false
    }
    let chunk = fsRead(this.fd, readChunkSize)
    if (len(chunk) == 0) {
      this.eof = true
      return false
    }
    this.buf = chunk
    this.pos = 0
    return true
  }

  // The next line, without its trailing newline. `None` only at end of input, so
  // a final line with no newline of its own is still returned.
  export readLine(): Option<string> {
    if (!this.fill()) {
      return Option<string>.None
    }
    // Only a line that spans more than one refill needs `acc`: the common case
    // (a line found within the current buffer) returns a single string slice
    // below, no byte-by-byte copy at all (#2328).
    let acc = []byte(0)
    let haveAcc = false
    while (true) {
      if (!this.fill()) {
        // Input ended mid-line: what we have is a real, newline-less last line.
        return Option.Some(string(acc))
      }
      // Consume up to the next newline in the current buffer, in one slice.
      let start = this.pos
      let i = this.pos
      while (i < len(this.buf) && this.buf[i] != '\n') {
        i = i + 1
      }
      if (i < len(this.buf)) {
        this.pos = i + 1 // step over the newline; it is not part of the line
        if (!haveAcc) {
          return Option.Some(this.buf[start:i])
        }
        acc = appendRange(acc, this.buf, start, i)
        return Option.Some(string(acc))
      }
      // Buffer exhausted mid-line: accumulate what this refill held and keep
      // going. Each refill costs O(chunk), never O(line-so-far).
      acc = appendRange(acc, this.buf, start, i)
      haveAcc = true
      this.pos = i
    }
  }

  // Everything still unread, to end of input.
  export readAll(): string {
    let out = ""
    while (this.fill()) {
      out = out + this.buf[this.pos:len(this.buf)]
      this.pos = len(this.buf)
    }
    return out
  }

  // Exactly `n` bytes, or fewer only when input truly ends first. Buffered bytes
  // left by a prior `readLine` are consumed before any refill, so `readBytes`
  // composes with `readLine` on the same Reader — the basis for length-framed
  // protocols (LSP `Content-Length`). `n <= 0` reads nothing and touches no input.
  export readBytes(n: int): string {
    let out = ""
    while (len(out) < n && this.fill()) {
      let take = n - len(out)
      let avail = len(this.buf) - this.pos
      if (avail < take) {
        take = avail
      }
      out = out + this.buf[this.pos:this.pos + take]
      this.pos = this.pos + take
    }
    return out
  }
}

// A buffered reader over an already-open descriptor.
export fn reader(fd: i64): Reader {
  return Reader{ fd: fd, buf: "", pos: 0, eof: false }
}

export fn stdin(): Reader {
  return reader(Stdin)
}

// Appends `buf[start:end]` to `acc` one byte at a time and returns `acc`.
// `append` grows a `[]byte` in amortized O(1) per element, unlike
// concatenating onto a `string`, which copies everything gathered so far on
// every call — the shape that made `readLine` (#2328) and `Writer.write`
// (#2340) quadratic. Shared by both.
fn appendRange(acc: []byte, buf: string, start: int, end: int): []byte {
  let j = start
  while (j < end) {
    acc = append(acc, buf[j])
    j = j + 1
  }
  return acc
}

