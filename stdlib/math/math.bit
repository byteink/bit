// Bit standard library — math module (f64).
//
// Floating-point helpers written in Bit, on top of numeric conversions and
// comparisons; `sqrt` is the one hardware primitive. Integer min/max/abs are a
// couple of lines to write inline, so this module stays float-focused.

// The ratio of a circle's circumference to its diameter.
export const pi: f64 = 3.141592653589793

// Euler's number, the base of the natural logarithm.
export const e: f64 = 2.718281828459045

// The absolute value of `x`.
//
// IEEE 754-2019 §5.5.1 makes `abs` a SIGN-BIT operation — clear bit 63, touch
// nothing else — not a comparison. The `if (x < 0.0) { return -x }` form this
// replaces was wrong for every input whose sign bit is set but which does not
// compare less than zero: `-0.0 < 0.0` is false, so `abs(-0.0)` returned
// `-0.0` and `1.0 / abs(-0.0)` was `-inf` (#2269), and a negative NaN kept its
// sign too. `-0.0 == 0.0` is true, so `abs(-0.0) == 0.0` passed either way and
// hid it; only division, `copysign` or formatting can see the difference.
// `floatBits`/`bitsToFloat` are inline bitcasts (FMOV/movq, no numeric
// conversion — runtime/root/floats.bit), so this is one mask and no branch.
export function abs(x: f64): f64 {
  return bitsToFloat(floatBits(x) & ~(u64(1) << 63))
}

// The smaller of two values, matching Go's `math.Min`: NaN propagates
// regardless of position, and of the two zeros `-0.0` sorts below `+0.0`.
//
// `if (a < b) { return a } return b` is wrong for exactly these two cases,
// because IEEE 754 comparison is not a total order on them: a NaN compares
// false against everything, so the `return b` fallthrough leaked whichever
// operand was second, and `-0.0 < 0.0` is false so `min(-0.0, +0.0)` also
// fell through to `+0.0` — argument-order dependent on both inputs (#2420).
export function min(a: f64, b: f64): f64 {
  if (a != a) {
    return a
  }
  if (b != b) {
    return b
  }
  if (a == 0.0 && b == 0.0) {
    if (floatBits(a) != u64(0)) {
      return a
    }
    return b
  }
  if (a < b) {
    return a
  }
  return b
}

// The larger of two values, matching Go's `math.Max`: NaN propagates
// regardless of position, and of the two zeros `+0.0` sorts above `-0.0`.
// See `min` above for why the plain comparison this replaced was wrong.
export function max(a: f64, b: f64): f64 {
  if (a != a) {
    return a
  }
  if (b != b) {
    return b
  }
  if (a == 0.0 && b == 0.0) {
    if (floatBits(a) == u64(0)) {
      return a
    }
    return b
  }
  if (a > b) {
    return a
  }
  return b
}

// `x` limited to the range [lo, hi].
export function clamp(x: f64, lo: f64, hi: f64): f64 {
  if (x < lo) {
    return lo
  }
  if (x > hi) {
    return hi
  }
  return x
}

// -1, 0, or 1 by the sign of `x`.
export function sign(x: f64): f64 {
  if (x < 0.0) {
    return -1.0
  }
  if (x > 0.0) {
    return 1.0
  }
  return 0.0
}

// Rounding, each a single hardware instruction (ABI.md §17). These are exact
// for every finite `x`, including magnitudes beyond an i64's range — a
// round-trip through `i64(x)` would not be.

// Truncate toward zero — the integer part of `x`, as a float.
export function trunc(x: f64): f64 {
  return ftrunc(x)
}

// The largest integer not greater than `x`.
export function floor(x: f64): f64 {
  return ffloor(x)
}

// The smallest integer not less than `x`.
export function ceil(x: f64): f64 {
  return fceil(x)
}

// The nearest integer; halfway cases round away from zero.
export function round(x: f64): f64 {
  return fround(x)
}

// The square root of `x` (hardware `sqrt` instruction).
export function sqrt(x: f64): f64 {
  return fsqrt(x)
}

// `x` raised to the power `y`.
export function pow(x: f64, y: f64): f64 {
  return fpow(x, y)
}

// The angle in radians from the positive x-axis to the point (x, y), in
// [-pi, pi]. Takes `y` first, like C's atan2.
export function atan2(y: f64, x: f64): f64 {
  return fatan2(y, x)
}

// The natural logarithm of `x`.
export function log(x: f64): f64 {
  return flog(x)
}

// The base-2 logarithm of `x`.
export function log2(x: f64): f64 {
  return flog2(x)
}

// The base-10 logarithm of `x`.
export function log10(x: f64): f64 {
  return flog10(x)
}

// Trigonometry (sin/cos/tan) and exp are deliberately absent: the toolchain
// exposes them only as builtins that lower to libm calls, and a Bit binary
// links no libc. They land when a freestanding implementation does, rather
// than as a silently-approximate stand-in.

// --- integers -------------------------------------------------------------

// The absolute value of `x`. `iabs(minInt)` overflows, as it must.
export function iabs(x: int): int {
  if (x < 0) {
    return -x
  }
  return x
}

export function imin(a: int, b: int): int {
  if (a < b) {
    return a
  }
  return b
}

export function imax(a: int, b: int): int {
  if (a > b) {
    return a
  }
  return b
}

// `base` raised to a non-negative `exp`, by squaring. `0^0` is 1; a negative
// exponent has no integer result and yields 0.
export function ipow(base: int, exp: int): int {
  if (exp < 0) {
    return 0
  }
  let result = 1
  let b = base
  let e = exp
  while (e > 0) {
    if (e % 2 == 1) {
      result = result * b
    }
    b = b * b
    e = e / 2
  }
  return result
}

// The greatest common divisor of |a| and |b|; `gcd(0, 0)` is 0.
export function gcd(a: int, b: int): int {
  let x = iabs(a)
  let y = iabs(b)
  while (y != 0) {
    let t = x % y
    x = y
    y = t
  }
  return x
}
