// Bit standard library — math module (f64).
//
// Floating-point helpers written in Bit, on top of numeric conversions and
// comparisons; `sqrt` is the one hardware primitive, and the float bit casts
// (`f64Bits` and friends) are register moves. Integer min/max/abs are a
// couple of lines to write inline, so this module stays float-focused.

// The ratio of a circle's circumference to its diameter.
export const pi: f64 = 3.141592653589793

// Euler's number, the base of the natural logarithm.
export const e: f64 = 2.718281828459045

// The absolute value of `x`.
//
// IEEE 754-2019 §5.5.1 makes `abs` a SIGN-BIT operation — clear bit 63, touch
// nothing else — not a comparison. The `if (x < 0.0) { return -x }` form this
// replaces was wrong for every input whose sign bit is set but which does not
// compare less than zero: `-0.0 < 0.0` is false, so `abs(-0.0)` returned
// `-0.0` and `1.0 / abs(-0.0)` was `-inf` (#2269), and a negative NaN kept its
// sign too. `-0.0 == 0.0` is true, so `abs(-0.0) == 0.0` passed either way and
// hid it; only division, `copysign` or formatting can see the difference.
// `floatBits`/`bitsToFloat` are inline bitcasts (FMOV/movq, no numeric
// conversion — runtime/root/floats.bit), so this is one mask and no branch.
export fn abs(x: f64): f64 {
  return bitsToFloat(floatBits(x) & ~(u64(1) << 63))
}

// The smaller of two values, matching Go's `math.Min`: NaN propagates
// regardless of position, and of the two zeros `-0.0` sorts below `+0.0`.
//
// `if (a < b) { return a } return b` is wrong for exactly these two cases,
// because IEEE 754 comparison is not a total order on them: a NaN compares
// false against everything, so the `return b` fallthrough leaked whichever
// operand was second, and `-0.0 < 0.0` is false so `min(-0.0, +0.0)` also
// fell through to `+0.0` — argument-order dependent on both inputs (#2420).
export fn min(a: f64, b: f64): f64 {
  if (a != a) {
    return a
  }
  if (b != b) {
    return b
  }
  if (a == 0.0 && b == 0.0) {
    if (floatBits(a) != u64(0)) {
      return a
    }
    return b
  }
  if (a < b) {
    return a
  }
  return b
}

// The larger of two values, matching Go's `math.Max`: NaN propagates
// regardless of position, and of the two zeros `+0.0` sorts above `-0.0`.
// See `min` above for why the plain comparison this replaced was wrong.
export fn max(a: f64, b: f64): f64 {
  if (a != a) {
    return a
  }
  if (b != b) {
    return b
  }
  if (a == 0.0 && b == 0.0) {
    if (floatBits(a) == u64(0)) {
      return a
    }
    return b
  }
  if (a > b) {
    return a
  }
  return b
}

// `x` limited to the range [lo, hi].
export fn clamp(x: f64, lo: f64, hi: f64): f64 {
  if (x < lo) {
    return lo
  }
  if (x > hi) {
    return hi
  }
  return x
}

// -1, 0, or 1 by the sign of `x`.
export fn sign(x: f64): f64 {
  if (x < 0.0) {
    return -1.0
  }
  if (x > 0.0) {
    return 1.0
  }
  return 0.0
}

// Rounding, each a single hardware instruction (ABI.md §17). These are exact
// for every finite `x`, including magnitudes beyond an i64's range — a
// round-trip through `i64(x)` would not be.

// Truncate toward zero — the integer part of `x`, as a float.
export fn trunc(x: f64): f64 {
  return ftrunc(x)
}

// The largest integer not greater than `x`.
export fn floor(x: f64): f64 {
  return ffloor(x)
}

// The smallest integer not less than `x`.
export fn ceil(x: f64): f64 {
  return fceil(x)
}

// The nearest integer; halfway cases round away from zero.
export fn round(x: f64): f64 {
  return fround(x)
}

// The square root of `x` (hardware `sqrt` instruction).
export fn sqrt(x: f64): f64 {
  return fsqrt(x)
}

// `x` raised to the power `y`.
export fn pow(x: f64, y: f64): f64 {
  return fpow(x, y)
}

// The angle in radians from the positive x-axis to the point (x, y), in
// [-pi, pi]. Takes `y` first, like C's atan2.
export fn atan2(y: f64, x: f64): f64 {
  return fatan2(y, x)
}

// The natural logarithm of `x`.
export fn log(x: f64): f64 {
  return flog(x)
}

// The base-2 logarithm of `x`.
export fn log2(x: f64): f64 {
  return flog2(x)
}

// The base-10 logarithm of `x`.
export fn log10(x: f64): f64 {
  return flog10(x)
}

// Trigonometry (sin/cos/tan) and exp are deliberately absent: the toolchain
// exposes them only as builtins that lower to libm calls, and a Bit binary
// links no libc. They land when a freestanding implementation does, rather
// than as a silently-approximate stand-in.

// --- bit patterns ---------------------------------------------------------

// The IEEE 754 binary64 bit pattern of `x`, like Go's `math.Float64bits`: sign
// in bit 63, exponent in 62..52, fraction in 51..0. A register move
// (`fmov x, d` / `movq r, xmm`), not a numeric conversion, so a NaN keeps its
// payload and `-0.0` keeps its sign. Inlined, the call costs no more than the
// builtin `floatBits` it wraps.
export fn f64Bits(x: f64): u64 {
  return floatBits(x)
}

// The `f64` whose bit pattern is `b`, like Go's `math.Float64frombits`; the
// inverse of `f64Bits`.
export fn f64FromBits(b: u64): f64 {
  return bitsToFloat(b)
}

// The IEEE 754 binary32 bit pattern of `x`, like Go's `math.Float32bits`: sign
// in bit 31, exponent in 30..23, fraction in 22..0. One `fmov w, s` /
// `movd r32, xmm`.
export fn f32Bits(x: f32): u32 {
  return float32Bits(x)
}

// The `f32` whose bit pattern is `b`, like Go's `math.Float32frombits`; the
// inverse of `f32Bits`.
//
// Written without `bitsToFloat32` until the stage0 pin has it (#7862): std/math
// is compiled by the oracle, and 0.41.0 does not know the builtin.
//
// Finite values (and both zeros) widen exactly: the sign and the 31 magnitude
// bits shifted left 29 are a binary64 pattern whose exponent field is the
// binary32 one, so multiplying by 2^896 (the bias difference, 1023 - 127) puts
// it right for every normal AND every subnormal (a binary32 subnormal lands as
// a binary64 subnormal, and the power-of-two multiply is exact), and `f32(...)`
// narrows a value that is already representable, so nothing rounds.
//
// Infinity and NaN (exponent all ones) take `f32FromBitsRaw`: converting a
// signalling NaN through `f64` quiets it on arm64 (FCVT) and x86-64 (CVTSD2SS)
// alike, which would turn 0x7F800001 into 0x7FC00001.
export fn f32FromBits(b: u32): f32 {
  if ((b & u32(0x7F800000)) == u32(0x7F800000)) {
    return f32FromBitsRaw(b)
  }
  let wide = bitsToFloat((u64(b >> u32(31)) << 63) | (u64(b & u32(0x7FFFFFFF)) << 29))
  return f32(wide * bitsToFloat(u64(1919) << 52))
}

// `b` as an `f32` with no arithmetic on it: the word is stored into a heap cell
// and read back through an `f32` load (`ldr s` / `movss`), which moves the bits
// untouched. The cell is word-aligned, so its address divided by four indexes
// an `f32` pointer based at nil.
fn f32FromBitsRaw(b: u32): f32 {
  let cell = []u32(1)
  cell[0] = b
  let base: *f32 = nil
  let x = *(base + (int(ptrOf(cell)) >> 2))
  keepAlive(cell)
  return x
}

// `xs` as little-endian IEEE 754 binary32, four bytes each, in order: the
// float32 wire form of a vector (Redis `FP32`, GGUF and safetensors tensors).
export fn f32sToLe(xs: []f32): []u8 {
  let out = []u8(len(xs) * 4)
  let o = 0
  for x of xs {
    let b = f32Bits(x)
    out[o] = u8(b & u32(255))
    out[o + 1] = u8((b >> u32(8)) & u32(255))
    out[o + 2] = u8((b >> u32(16)) & u32(255))
    out[o + 3] = u8(b >> u32(24))
    o = o + 4
  }
  return out
}

// The `f32`s in little-endian binary32 bytes `b`; the inverse of `f32sToLe`.
// A length that is not a multiple of four is an error: the tail would be half
// a float.
export fn f32sFromLe(b: []u8): []f32! {
  if (len(b) % 4 != 0) {
    fail newError("math: f32sFromLe needs a multiple of 4 bytes, got ${len(b)}")
  }
  let n = len(b) / 4
  let out = []f32(n)
  let i = 0
  while (i < n) {
    let o = i * 4
    let w = u32(b[o]) |
      (u32(b[o + 1]) << u32(8)) |
      (u32(b[o + 2]) << u32(16)) |
      (u32(b[o + 3]) << u32(24))
    out[i] = f32FromBits(w)
    i = i + 1
  }
  return out
}

// --- integers -------------------------------------------------------------

// The absolute value of `x`. `iabs(minInt)` overflows, as it must.
export fn iabs(x: int): int {
  if (x < 0) {
    return -x
  }
  return x
}

export fn imin(a: int, b: int): int {
  if (a < b) {
    return a
  }
  return b
}

export fn imax(a: int, b: int): int {
  if (a > b) {
    return a
  }
  return b
}

// `base` raised to a non-negative `exp`, by squaring. `0^0` is 1; a negative
// exponent has no integer result and yields 0.
export fn ipow(base: int, exp: int): int {
  if (exp < 0) {
    return 0
  }
  let result = 1
  let b = base
  let k = exp
  while (k > 0) {
    if (k % 2 == 1) {
      result = result * b
    }
    b = b * b
    k = k / 2
  }
  return result
}

// The greatest common divisor of |a| and |b|; `gcd(0, 0)` is 0.
export fn gcd(a: int, b: int): int {
  let x = iabs(a)
  let y = iabs(b)
  while (y != 0) {
    let t = x % y
    x = y
    y = t
  }
  return x
}

// The full 128-bit product of `a` and `b` as `(hi, lo)`, so that
// `a * b == hi * 2^64 + lo` exactly: `hi` is the `umulHi` builtin (§5.3) and
// `lo` the wrapping `a * b`. Inlined, it is `umulh` + `mul` on AArch64 and
// one `mul` on x86-64, which leaves both words, with no call and no
// allocation, and every one of those instructions takes the same time for
// every operand.
export fn mul64(a: u64, b: u64): (u64, u64) {
  return umulHi(a, b), a * b
}
