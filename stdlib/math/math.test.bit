// std/math bit patterns: `f64Bits`/`f64FromBits`/`f32Bits`/`f32FromBits` move
// the bits verbatim, so every special value must come back with the pattern it
// went in with. Everything is compared as bits: `==` on a float cannot tell
// `-0.0` from `0.0`, and is false for a NaN against itself.

import { contains } from "std/strings"

const f64Patterns: []u64 = [
  u64(0x0000000000000000), // +0
  u64(0x8000000000000000), // -0
  u64(0x7FF0000000000000), // +inf
  u64(0xFFF0000000000000), // -inf
  u64(0x7FF8000000000000), // quiet NaN
  u64(0x7FF8000000000001), // quiet NaN, payload 1
  u64(0xFFF800000000ABCD), // negative quiet NaN, payload
  u64(0x7FF0000000000001), // signalling NaN, must not be quieted
  u64(0x0000000000000001), // smallest subnormal
  u64(0x000FFFFFFFFFFFFF), // largest subnormal
  u64(0x0010000000000000), // smallest normal
  u64(0x7FEFFFFFFFFFFFFF), // largest finite
  u64(0xFFEFFFFFFFFFFFFF), // most negative finite
  u64(0x3FF0000000000000), // 1.0
]

const f32Patterns: []u32 = [
  u32(0x00000000), // +0
  u32(0x80000000), // -0
  u32(0x7F800000), // +inf
  u32(0xFF800000), // -inf
  u32(0x7FC00000), // quiet NaN
  u32(0x7FC00001), // quiet NaN, payload 1
  u32(0xFFC0ABCD), // negative quiet NaN, payload
  u32(0x7F800001), // signalling NaN, must not be quieted
  u32(0x00000001), // smallest subnormal
  u32(0x007FFFFF), // largest subnormal
  u32(0x00800000), // smallest normal
  u32(0x7F7FFFFF), // largest finite
  u32(0xFF7FFFFF), // most negative finite
  u32(0x3F800000), // 1.0
]

test "f64 bit patterns survive a round trip" {
  for p of f64Patterns {
    let back = f64Bits(f64FromBits(p))
    assert(back == p, "f64 ${p} came back as ${back}")
  }
}

test "f32 bit patterns survive a round trip" {
  for p of f32Patterns {
    let back = f32Bits(f32FromBits(p))
    assert(back == p, "f32 ${p} came back as ${back}")
  }
}

test "f64Bits reads the IEEE 754 binary64 layout" {
  assert(f64Bits(1.0) == u64(0x3FF0000000000000), "1.0")
  assert(f64Bits(-2.0) == u64(0xC000000000000000), "-2.0")
  assert(f64Bits(0.0) == u64(0), "+0")
  assert(f64Bits(-0.0) == u64(0x8000000000000000), "-0 keeps its sign")
  assert(f64FromBits(u64(0x7FF0000000000000)) == 1.0 / 0.0, "+inf")
  let nan = f64FromBits(u64(0x7FF8000000000001))
  assert(nan != nan, "a NaN pattern is not equal to itself")
}

test "f32Bits reads the IEEE 754 binary32 layout" {
  assert(f32Bits(f32(1.0)) == u32(0x3F800000), "1.0")
  assert(f32Bits(f32(-2.0)) == u32(0xC0000000), "-2.0")
  assert(f32Bits(f32(0.1)) == u32(0x3DCCCCCD), "0.1 rounds to the nearest binary32")
  assert(f32Bits(f32FromBits(u32(0x80000000))) == u32(0x80000000), "-0 keeps its sign")
  assert(f32FromBits(u32(0x3F800000)) == f32(1.0), "1.0 from bits")
  let nan = f32FromBits(u32(0x7FC00001))
  assert(nan != nan, "a NaN pattern is not equal to itself")
}

test "f32sToLe writes little-endian binary32" {
  let b = f32sToLe([f32(1.0), f32(-2.0), f32FromBits(u32(0x7F800001))])
  let want = []u8(12)
  want[2] = 0x80
  want[3] = 0x3F
  want[7] = 0xC0
  want[8] = 0x01
  want[9] = 0x00
  want[10] = 0x80
  want[11] = 0x7F
  assert(len(b) == 12, "four bytes per float, got ${len(b)}")
  let i = 0
  while (i < 12) {
    assert(b[i] == want[i], "byte ${i}: ${b[i]} want ${want[i]}")
    i = i + 1
  }
  assert(len(f32sToLe([]f32(0))) == 0, "no floats, no bytes")
}

test "f32sFromLe is the inverse of f32sToLe, bit for bit" {
  let xs = []f32(0)
  for p of f32Patterns {
    xs = append(xs, f32FromBits(p))
  }
  let back = f32sFromLe(f32sToLe(xs)) catch e {
    panic("f32sFromLe: ${e.message()}")
  }
  assert(len(back) == len(xs), "length ${len(back)}")
  let i = 0
  while (i < len(back)) {
    assert(f32Bits(back[i]) == f32Patterns[i], "element ${i}")
    i = i + 1
  }
}

test "f32sFromLe refuses half a float" {
  for n of [1, 3, 5, 7] {
    let failed = false
    let got = f32sFromLe([]u8(n)) catch e {
      assert(contains(e.message(), "multiple of 4"), "message: ${e.message()}")
      failed = true
      []f32(0)
    }
    assert(failed, "${n} bytes decoded to ${len(got)} floats")
  }
  let none = f32sFromLe([]u8(0)) catch _ {
    panic("empty input is a vector of none")
  }
  assert(len(none) == 0, "empty")
}
