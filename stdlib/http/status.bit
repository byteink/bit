// Bit standard library — http module: a response's status line as one piece
// (#5972).
//
// `serializeResponseInto` (http.bit) used to write the status line as five
// pieces — "HTTP/1.1 ", the code's digits, " ", `reason`'s phrase, "\r\n" —
// and then "Content-Length: " as a sixth, each one a `putBytes` range check
// plus a `bit_rt_bytes_copy`. The cost was per piece, not per byte, so the
// common statuses below each have the whole run as one literal here, and
// every other status — including the many `reason` names (#6122) that have
// no literal of their own — still goes piece by piece.

// The status line plus the name of the field line that always follows it, as
// one literal for the common statuses below — a small subset of what
// `reason` names — so `serializeResponseInto` copies one piece where the
// generic path copies five (#5972). "" for any other status, which then
// goes through that generic path. Every arm is pinned byte for byte against
// a spelled-out status line in server.test.bit. The error statuses live in
// `errorStatusHead` only to keep each switch under the complexity limit; the
// success path, 200 first, never leaves this one.
fn statusHead(status: int): string {
  switch (status) {
    case 200:
      return "HTTP/1.1 200 OK\r\nContent-Length: "
    case 201:
      return "HTTP/1.1 201 Created\r\nContent-Length: "
    case 204:
      return "HTTP/1.1 204 No Content\r\nContent-Length: "
    case 301:
      return "HTTP/1.1 301 Moved Permanently\r\nContent-Length: "
    case 302:
      return "HTTP/1.1 302 Found\r\nContent-Length: "
    default:
      return errorStatusHead(status)
  }
}

// `statusHead` for the small set of 4xx and 5xx statuses this literal path
// covers; "" for any other, including most of what `reason` now names.
fn errorStatusHead(status: int): string {
  switch (status) {
    case 400:
      return "HTTP/1.1 400 Bad Request\r\nContent-Length: "
    case 401:
      return "HTTP/1.1 401 Unauthorized\r\nContent-Length: "
    case 403:
      return "HTTP/1.1 403 Forbidden\r\nContent-Length: "
    case 404:
      return "HTTP/1.1 404 Not Found\r\nContent-Length: "
    case 405:
      return "HTTP/1.1 405 Method Not Allowed\r\nContent-Length: "
    case 500:
      return "HTTP/1.1 500 Internal Server Error\r\nContent-Length: "
    default:
      return ""
  }
}

// `statusHead`'s bytes for a status it has no literal for, written piece by
// piece: the numeric code, then `reason`'s phrase (empty for an unknown one).
fn putGenericStatusHead(w: []byte, at: int, status: int): int {
  let i = putBytes(w, at, "HTTP/1.1 ")
  i = putDigits(w, i, status)
  i = putBytes(w, i, " ")
  i = putBytes(w, i, reason(status))
  return putBytes(w, i, "\r\nContent-Length: ")
}

// The byte count `putGenericStatusHead` writes for `status`.
fn genericStatusHeadLen(status: int): int {
  return len("HTTP/1.1 ") +
    digitCount(status) +
    len(" ") +
    len(reason(status)) +
    len("\r\nContent-Length: ")
}
