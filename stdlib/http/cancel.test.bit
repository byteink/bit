// stdlib/http/cancel.test.bit — `Cancel` (cancel.bit, #6602): a cancel from
// another task fails an in-flight request within 100 ms, in every phase a
// request waits in, with `Cancelled`, and no connection it touched is parked.
//
// Same module as cancel.bit and bodyreaderpool.test.bit (SPEC §19): `Client`,
// `ClientRequest`, `RequestError`, `kaStart`/`kaStartTls`/`kaPlanOf`/`kaFixed`/
// `kaUrl`/`kaOrigin`, `readerOf`, `tls5916ClientConfig`, `AtomicI64`,
// `monotonic`, `sleep`, `repeat` and `indexOf` are bound module-wide, so nothing
// is imported but the load scale.
//
// The bound is 100 ms from the `cancel()` call to the failure, scaled by the
// host's load like every other timing gate (`scaledBudgetMs`,
// _tests_/bit/loadscale/loadscale.bit): at or under one run-queue entry per
// core the scale is 1 and the bound is exactly 100 ms; on a loaded host the
// scheduler may hold the woken task off a CPU, which is not what these tests own.
import { loadProbe, scaledBudgetMs } from "../../_tests_/bit/loadscale"
import {
  encodeHeaders, HeadersFrame, encodeData, DataFrame, encodeSettings, SettingsFrame, Setting,
  readFrame, Frame, decodeRstStream, frameSettings, frameHeaders, frameRstStream, flagAck,
} from "std/http2"

// Wait this long before cancelling, so the request is parked in its phase.
const cancelDelayMs: int = 50

fn boundMs(): int {
  return scaledBudgetMs(100, loadProbe())
}

// Cancels `tok` after `delayMs`, recording the instant it did.
fn cancelLater(tok: Cancel, delayMs: int, at: AtomicI64) {
  sleep(delayMs * 1000000)
  at.store(monotonic().ns)
  tok.cancel()
}

fn startCancel(tok: Cancel): AtomicI64 {
  let at = AtomicI64(0)
  spawn cancelLater(tok, cancelDelayMs, at)
  return at
}

// The ms from the cancel call to now, asserted within the bound.
fn assertWithin(at: AtomicI64, what: string) {
  let ms = (monotonic().ns - at.load()) / 1000000
  let bound = boundMs()
  assert(at.load() != 0, "${what}: failed before the cancel was called")
  assert(ms <= bound, "${what}: failed ${ms} ms after the cancel, bound ${bound} ms")
}

fn silentPlan(): kaPlan {
  let plan = kaFixed("never")
  plan.silent = true
  return plan
}

fn stallPlan(head: string): kaPlan {
  let plan = kaPlanOf(head, repeat("s", 100))
  plan.part = 10
  return plan
}

fn assertCancelled(e: error, what: string) {
  assert(isCancelled(e), "${what}: failed with '${e.message()}', not Cancelled")
}

test "a token cancelled before send fails the request at once and dials nothing" {
  let o = kaStart(silentPlan()) catch e {
    assert(false, "start: ${e.message()}")
    return
  }
  let tok = Cancel()
  tok.cancel()
  tok.cancel()
  assert(tok.cancelled(), "cancelled() is false after cancel()")
  let c = Client()
  c.send(ClientRequest{ url = kaUrl(o), cancel = Option.Some(tok) }) catch e {
    o.stop()
    assertCancelled(e, "send")
    let (re, ok) = e.(RequestError)
    assert(ok && !re.sent, "a request cancelled before send must be unsent")
    assert(o.accepts.load() == 0, "accepts = ${o.accepts.load()}")
    return
  }
  o.stop()
  assert(false, "a cancelled token let the request through")
}

test "cancel while waiting for the response head fails the send within the bound" {
  let o = kaStart(silentPlan()) catch e {
    assert(false, "start: ${e.message()}")
    return
  }
  let c = Client()
  let tok = Cancel()
  let at = startCancel(tok)
  c.send(ClientRequest{ url = kaUrl(o), cancel = Option.Some(tok) }, stream = true) catch e {
    assertWithin(at, "streamed head")
    o.stop()
    assertCancelled(e, "streamed head")
    assert(len(c.pool.idle) == 0, "idle = ${len(c.pool.idle)}")
    return
  }
  o.stop()
  assert(false, "a silent server answered")
}

test "cancel while the buffered send waits for the response head fails within the bound" {
  let o = kaStart(silentPlan()) catch e {
    assert(false, "start: ${e.message()}")
    return
  }
  let c = Client()
  let tok = Cancel()
  let at = startCancel(tok)
  c.send(ClientRequest{ url = kaUrl(o), cancel = Option.Some(tok) }) catch e {
    assertWithin(at, "buffered head")
    o.stop()
    assertCancelled(e, "buffered head")
    let (re, ok) = e.(RequestError)
    assert(ok && re.sent, "the silent server had the request, so it was sent")
    assert(len(c.pool.idle) == 0, "idle = ${len(c.pool.idle)}")
    return
  }
  o.stop()
  assert(false, "a silent server answered")
}

test "cancel during the TLS handshake fails the send within the bound" {
  // A server that accepts the TCP connection and never speaks TLS.
  let o = kaStart(silentPlan()) catch e {
    assert(false, "start: ${e.message()}")
    return
  }
  let c = Client(tls = tls5916ClientConfig())
  let tok = Cancel()
  let at = startCancel(tok)
  let url = "https://127.0.0.1:${o.port}/obj"
  c.send(ClientRequest{ url = url, cancel = Option.Some(tok) }, stream = true) catch e {
    assertWithin(at, "TLS handshake")
    o.stop()
    assertCancelled(e, "TLS handshake")
    let (re, ok) = e.(RequestError)
    assert(ok && !re.sent, "nothing was sent before the handshake finished")
    assert(len(c.pool.idle) == 0, "idle = ${len(c.pool.idle)}")
    return
  }
  o.stop()
  assert(false, "a server that never speaks TLS completed a handshake")
}

test "cancel during connect fails the wait within the bound and closes a late connection" {
  // A dial that has not finished: nothing completes `job`, so the wait is in
  // its connect phase for certain, on any network. (A real stalled connect
  // cannot be made portably: a full accept queue stalls the SYN on Linux and
  // resets it on macOS.)
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    l.close()
    assert(false, "port: ${e.message()}")
    return
  }
  let job = newDialJob()
  let tok = Cancel()
  let at = startCancel(tok)
  awaitDial(job, tok) catch e {
    assertWithin(at, "connect")
    assertCancelled(e, "connect")
    // The dial lands after the cancel: its own task must close the connection.
    let late = dial("127.0.0.1", port) catch e2 {
      l.close()
      assert(false, "dial: ${e2.message()}")
      return
    }
    job.finish(dialOut{ conn = Option.Some(late), msg = "" })
    let peer = l.accept() catch e2 {
      l.close()
      assert(false, "accept: ${e2.message()}")
      return
    }
    let seen = peer.read(1)
    peer.close()
    l.close()
    assert(seen == "", "a dial that finished after the cancel was left open")
    return
  }
  l.close()
  assert(false, "a dial nothing completed returned a connection")
}

test "cancel wakes a send waiting for a connection under maxConnsPerHost" {
  let o = kaStart(kaFixed("hello")) catch e {
    assert(false, "start: ${e.message()}")
    return
  }
  let c = Client()
  c.setPool(PoolLimits{ maxConnsPerHost = 1 }) catch e {
    o.stop()
    assert(false, "setPool: ${e.message()}")
    return
  }
  // The first streamed response is never read, so it holds the only slot.
  let first = c.send(ClientRequest{ url = kaUrl(o) }, stream = true) catch e {
    o.stop()
    assert(false, "send 1: ${e.message()}")
    return
  }
  assert(first.status == 200, "the holder answered ${first.status}")
  let tok = Cancel()
  let at = startCancel(tok)
  // Bounded by `timeoutMs`, so a wait the cancel does not wake fails by the
  // clock, with a message that is not Cancelled, rather than hanging.
  c.send(ClientRequest{ url = kaUrl(o), cancel = Option.Some(tok), timeoutMs = 5000 }) catch e {
    assertWithin(at, "pool wait")
    assertCancelled(e, "pool wait")
    let (re, ok) = e.(RequestError)
    assert(ok && !re.sent, "a request that never got a connection was not sent")
    assert(o.accepts.load() == 1, "accepts = ${o.accepts.load()}: the waiter dialed")
    assert(len(c.pool.caps) == 1, "caps = ${len(c.pool.caps)}: only the holder keeps the origin")
    o.stop()
    return
  }
  o.stop()
  assert(false, "a send over the connection cap succeeded while the holder was open")
}

test "cancel mid-body fails the pending read with Cancelled within the bound" {
  let o = kaStart(stallPlan("HTTP/1.1 200 OK\r\nContent-Length: 100\r\n\r\n")) catch e {
    assert(false, "start: ${e.message()}")
    return
  }
  let c = Client()
  let tok = Cancel()
  let res = c.send(ClientRequest{ url = kaUrl(o), cancel = Option.Some(tok) }, stream = true) catch e {
    o.stop()
    assert(false, "send: ${e.message()}")
    return
  }
  let r = readerOf(res) catch e {
    o.stop()
    assert(false, "${e.message()}")
    return
  }
  let first = r.read(64) catch e {
    o.stop()
    assert(false, "first read: ${e.message()}")
    return
  }
  assert(len(first) == 10, "first read returned ${len(first)} bytes")
  let at = startCancel(tok)
  r.read(64) catch e {
    assertWithin(at, "mid-body read")
    o.stop()
    let (ce, ok) = e.(Cancelled)
    assert(ok, "the read failed with '${e.message()}', not Cancelled")
    assert(ce.op == "read", "op = '${ce.op}'")
    assert(len(c.pool.idle) == 0, "idle = ${len(c.pool.idle)}")
    r.read(1) catch e2 {
      assert(indexOf(e2.message(), "earlier read failed") >= 0, "message = '${e2.message()}'")
      return
    }
    assert(false, "a read after the cancel succeeded")
    return
  }
  o.stop()
  assert(false, "a stalled body read returned")
}

test "cancel mid-body of a read-to-close response is a failure, never a short body" {
  let o = kaStart(stallPlan("HTTP/1.1 200 OK\r\nConnection: close\r\n\r\n")) catch e {
    assert(false, "start: ${e.message()}")
    return
  }
  let c = Client()
  let tok = Cancel()
  let res = c.send(ClientRequest{ url = kaUrl(o), cancel = Option.Some(tok) }, stream = true) catch e {
    o.stop()
    assert(false, "send: ${e.message()}")
    return
  }
  let r = readerOf(res) catch e {
    o.stop()
    assert(false, "${e.message()}")
    return
  }
  let first = r.read(64) catch e {
    o.stop()
    assert(false, "first read: ${e.message()}")
    return
  }
  assert(len(first) == 10, "first read returned ${len(first)} bytes")
  let at = startCancel(tok)
  r.read(64) catch e {
    assertWithin(at, "read-to-close body")
    o.stop()
    assertCancelled(e, "read-to-close body")
    return
  }
  o.stop()
  assert(false, "the cancel of a read-to-close body read as a clean end")
}

test "cancel mid-body of a buffered send fails it, never returns the partial body" {
  let o = kaStart(stallPlan("HTTP/1.1 200 OK\r\nConnection: close\r\n\r\n")) catch e {
    assert(false, "start: ${e.message()}")
    return
  }
  let c = Client()
  let tok = Cancel()
  let at = startCancel(tok)
  c.send(ClientRequest{ url = kaUrl(o), cancel = Option.Some(tok) }) catch e {
    assertWithin(at, "buffered body")
    o.stop()
    assertCancelled(e, "buffered body")
    assert(len(c.pool.idle) == 0, "idle = ${len(c.pool.idle)}")
    return
  }
  o.stop()
  assert(false, "a cancelled buffered send returned a response")
}

test "one token cancels every request that holds it, and a later request fails at once" {
  let o = kaStart(silentPlan()) catch e {
    assert(false, "start: ${e.message()}")
    return
  }
  let c = Client()
  let tok = Cancel()
  let done = chan<int>(2)
  spawn sendUntilCancelled(c, kaUrl(o), tok, done)
  spawn sendUntilCancelled(c, kaUrl(o), tok, done)
  sleep(cancelDelayMs * 1000000)
  let at = AtomicI64(monotonic().ns)
  tok.cancel()
  let a = <- done
  let b = <- done
  assertWithin(at, "two requests")
  assert(a == 1 && b == 1, "results ${a} ${b}: both requests must fail with Cancelled")
  assert(len(c.pool.idle) == 0, "idle = ${len(c.pool.idle)}")
  c.send(ClientRequest{ url = kaUrl(o), cancel = Option.Some(tok) }) catch e {
    o.stop()
    assertCancelled(e, "after")
    return
  }
  o.stop()
  assert(false, "a request with a cancelled token succeeded")
}

fn sendUntilCancelled(c: Client, url: string, tok: Cancel, done: chan<int>) {
  c.send(ClientRequest{ url = url, cancel = Option.Some(tok) }, stream = true) catch e {
    if (isCancelled(e)) {
      done <- 1
      return
    }
  }
  done <- 0
}

test "a request that finishes before the cancel keeps its connection pooled" {
  let o = kaStart(kaFixed("hello")) catch e {
    assert(false, "start: ${e.message()}")
    return
  }
  let c = Client()
  let tok = Cancel()
  let res = c.send(ClientRequest{ url = kaUrl(o), cancel = Option.Some(tok) }) catch e {
    o.stop()
    assert(false, "send: ${e.message()}")
    return
  }
  tok.cancel()
  o.stop()
  assert(res.status == 200 && res.body == "hello", "status ${res.status} body '${res.body}'")
  assert(
    len(c.pool.idle) == 1,
    "idle = ${len(c.pool.idle)}: a finished request parks its connection",
  )
}

// ---------------------------------------------------------------------------
// HTTP/2: a cancel resets one stream and keeps the connection (#7639)
// ---------------------------------------------------------------------------
//
// An origin that speaks h2 at the frame level, so a response can stop in the
// middle of its body and the test can see every frame the client sends back.
// Stream 1 is the request under the token: the origin answers it with HEADERS
// and 4 body bytes and then waits. Stream 3 is a plain request: HEADERS and
// half its body. When the origin sees the client's RST_STREAM for stream 1 it
// records the code, sends the rest of stream 3, and then sends DATA on stream 1
// anyway, as a peer does that had it queued before the reset arrived. Every
// DATA frame stays under the 16384-byte default frame size.

const rawHalf: int = 10000

class rawH2 {
  l: TlsListener,
  port: int,
  accepts: AtomicI64,
  heads: AtomicI64,
  rstStream: AtomicI64,
  rstCode: AtomicI64,
  // Every RST_STREAM the client sent; a reply to the late DATA would be a second.
  rstCount: AtomicI64,
  // Completes the handshake and reads, but never sends SETTINGS (#7662).
  mute: bool,
}

class rawBuf { data: []byte }

fn rawSend(conn: TlsConn, b: []byte) {
  conn.write(b) catch _ {
    return
  }
}

fn rawCat(a: []byte, b: []byte): []byte {
  let out = []byte(0)
  for x of a {
    out = append(out, x)
  }
  for x of b {
    out = append(out, x)
  }
  return out
}

fn rawBytes(n: int): []byte {
  let b = []byte(0)
  let i = 0
  while (i < n) {
    b = append(b, byte(120))
    i = i + 1
  }
  return b
}

// `:status: 200`, the one HPACK byte (RFC 7541 appendix A, index 8).
fn rawHeaders(sid: int): []byte {
  return encodeHeaders(
    HeadersFrame{
      streamId = sid, blockFragment = [byte(136)], endStream = false, endHeaders = true, padLength = -1,
      hasPriority = false, exclusive = false, streamDependency = 0, weight = 0,
    },
  ) catch _ {
    return []byte(0)
  }
}

fn rawData(sid: int, n: int, end: bool): []byte {
  return encodeData(DataFrame{ streamId = sid, data = rawBytes(n), endStream = end, padLength = -1 }) catch _ {
    return []byte(0)
  }
}

fn rawSettings(ack: bool): []byte {
  return encodeSettings(SettingsFrame{ ack = ack, settings = []Setting(0) }) catch _ {
    return []byte(0)
  }
}

// The next whole frame of `rb`, reading from `conn` until there is one; None
// when the connection ended.
fn rawNext(conn: TlsConn, rb: rawBuf): Option<Frame> {
  while (true) {
    let got = readFrame(rb.data, 16384) catch _ {
      let more = conn.read(16384) catch _ {
        return Option.None
      }
      if (len(more) == 0) {
        return Option.None
      }
      rb.data = rawCat(rb.data, more)
      continue
    }
    rb.data = rb.data[9 + got.header.length:len(rb.data)]
    return Option.Some(got)
  }
}

fn rawOnFrame(conn: TlsConn, o: rawH2, f: Frame) {
  if (f.header.ftype == frameSettings && (f.header.flags & flagAck) == 0) {
    rawSend(conn, rawSettings(true))
    return
  }
  if (f.header.ftype == frameHeaders) {
    o.heads.add(1)
    rawSend(conn, rawHeaders(f.header.streamId))
    if (f.header.streamId == 1) {
      rawSend(conn, rawData(1, 4, false))
    } else if (o.rstStream.load() != 0) {
      rawSend(conn, rawData(f.header.streamId, rawHalf, false))
      rawSend(conn, rawData(f.header.streamId, rawHalf, true))
    } else {
      rawSend(conn, rawData(f.header.streamId, rawHalf, false))
    }
    return
  }
  if (f.header.ftype != frameRstStream) {
    return
  }
  let r = decodeRstStream(f) catch _ {
    return
  }
  o.rstCount.add(1)
  if (r.streamId != 1) {
    return
  }
  o.rstStream.store(r.streamId)
  o.rstCode.store(r.errorCode)
  rawSend(conn, rawData(3, rawHalf, true))
  rawSend(conn, rawData(1, rawHalf, false))
  rawSend(conn, rawData(1, rawHalf, false))
  rawSend(conn, rawData(1, rawHalf, true))
}

// Reads until the client closes, answering nothing.
fn rawMute(conn: TlsConn) {
  while (true) {
    let more = conn.read(16384) catch _ {
      return
    }
    if (len(more) == 0) {
      return
    }
  }
}

fn rawServe(conn: TlsConn, o: rawH2) {
  if (o.mute) {
    rawMute(conn)
    return
  }
  let rb = rawBuf{ data = []byte(0) }
  rawSend(conn, rawSettings(false))
  // The 24-byte client preface precedes the first frame.
  while (len(rb.data) < 24) {
    let more = conn.read(16384) catch _ {
      return
    }
    if (len(more) == 0) {
      return
    }
    rb.data = rawCat(rb.data, more)
  }
  rb.data = rb.data[24:len(rb.data)]
  while (true) {
    match (rawNext(conn, rb)) {
      Some(f) => { rawOnFrame(conn, o, f) }
      None => { return }
    }
  }
}

fn rawAccept(o: rawH2) {
  while (true) {
    let conn = o.l.accept() catch _ {
      return
    }
    o.accepts.add(1)
    spawn rawServe(conn, o)
  }
}

fn startRawH2(): rawH2! {
  return startRawH2Mode(false)?
}

fn startRawH2Mode(mute: bool): rawH2! {
  let cfg = tls5916ServerConfig()?
  cfg.alpn = ["h2", "http/1.1"]
  let l = tlsListen("127.0.0.1", 0, cfg)?
  let o = rawH2{
    l = l, port = l.port()?, accepts = AtomicI64(0), heads = AtomicI64(0), rstStream = AtomicI64(0),
    rstCode = AtomicI64(0), rstCount = AtomicI64(0), mute = mute,
  }
  spawn rawAccept(o)
  return o
}

fn rawClient(): Client {
  let cfg = tls5916ClientConfig()
  cfg.alpn = ["h2", "http/1.1"]
  return Client(tls = cfg)
}

// Polls until `a` reaches `want`, or fails after about 5 s.
fn rawWait(a: AtomicI64, want: int, what: string) {
  let i = 0
  while (a.load() < want && i < 1000) {
    sleep(5 * 1000000)
    i = i + 1
  }
  assert(a.load() >= want, "${what}: ${a.load()}, wanted ${want}")
}

fn rawSendTok(c: Client, url: string, tok: Cancel, out: chan<error>) {
  c.send(ClientRequest{ url = url, cancel = Option.Some(tok) }) catch e {
    out <- e
    return
  }
  out <- newError("the request under the token succeeded")
}

fn rawSendReq(c: Client, req: ClientRequest, out: chan<error>) {
  c.send(req) catch e {
    out <- e
    return
  }
  out <- newError("the request under the token succeeded")
}

fn rawGet(c: Client, url: string, out: chan<string>) {
  let res = c.get(url) catch e {
    out <- "error: ${e.message()}"
    return
  }
  out <- "${res.status} ${len(res.body)}"
}

test "cancel over h2 resets one stream with CANCEL and the other stream finishes on the same connection" {
  let o = startRawH2() catch e {
    assert(false, "start: ${e.message()}")
    return
  }
  let c = rawClient()
  let url = "https://127.0.0.1:${o.port}/x"
  let tok = Cancel()
  let slow = chan<error>(1)
  spawn rawSendTok(c, url, tok, slow)
  rawWait(o.heads, 1, "origin saw the request under the token")
  let fast = chan<string>(1)
  spawn rawGet(c, url, fast)
  rawWait(o.heads, 2, "origin saw the second request")
  let at = AtomicI64(monotonic().ns)
  tok.cancel()
  let e = <- slow
  assertWithin(at, "h2 cancel mid-body")
  assertCancelled(e, "h2 cancel mid-body")
  let (re, ok) = e.(RequestError)
  assert(ok && re.sent, "the origin had the request, so it was sent")
  assert(<- fast == "200 ${2 * rawHalf}", "the other stream did not finish with its whole body")
  assert(o.rstStream.load() == 1, "RST_STREAM was for stream ${o.rstStream.load()}, not 1")
  assert(o.rstCode.load() == 8, "RST_STREAM code ${o.rstCode.load()}, not CANCEL (0x8)")
  // The DATA the origin sent on stream 1 after the reset is ignored: no reply.
  let again = chan<string>(1)
  spawn rawGet(c, url, again)
  assert(<- again == "200 ${2 * rawHalf}", "a request after the cancel failed")
  assert(o.accepts.load() == 1, "accepts = ${o.accepts.load()}: the connection was not kept")
  assert(o.rstCount.load() == 1, "the client sent ${o.rstCount.load()} RST_STREAM frames, not 1")
}

test "cancel while the h2 connection waits for the server's opening SETTINGS fails within the bound" {
  let o = startRawH2Mode(true) catch e {
    assert(false, "start: ${e.message()}")
    return
  }
  let c = rawClient()
  let url = "https://127.0.0.1:${o.port}/x"
  let tok = Cancel()
  let out = chan<error>(1)
  let req = ClientRequest{ url = url, cancel = Option.Some(tok), timeoutMs = 5000 }
  spawn rawSendReq(c, req, out)
  rawWait(o.accepts, 1, "origin accepted the connection")
  let at = AtomicI64(monotonic().ns)
  sleep(cancelDelayMs * 1000000)
  at.store(monotonic().ns)
  tok.cancel()
  let e = <- out
  assertWithin(at, "h2 cancel before SETTINGS")
  assertCancelled(e, "h2 cancel before SETTINGS")
  assert(o.heads.load() == 0, "a request reached the origin")
}
