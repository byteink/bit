// Bit standard library — http module: the HTTP/3-over-QUIC glue.

// ---------------------------------------------------------------------------
// HTTP/3 over QUIC
// ---------------------------------------------------------------------------
//
// HTTP/3 (RFC 9114) runs over QUIC (UDP), not TLS-over-TCP, so it is opt-in: a
// server binds a UDP socket with `serveH3`, and a client reaches it either with an
// explicit `https+h3://` URL or by upgrading after reading an `Alt-Svc` header a
// TLS server advertised. The `std/http3` engine does the QUIC streams, QPACK, and
// framing; this module maps between its `H3Request`/`H3Response` (pseudo-headers +
// a `[]HeaderField` list) and the transport-agnostic `Request`/`Response`, exactly
// as the `h2glue*` helpers do for HTTP/2. Every helper here is prefixed `h3glue`.
//
// The QUIC transport demultiplexes many client connections on one socket, so
// `serveH3` runs an accept loop and serves each connection on its own green
// thread; run the call itself on its own green thread. The h3 client is still one
// request per connection, matching the rest of this module.

// Connection-specific header fields forbidden on an HTTP/3 message (RFC 9114
// §4.2), plus Content-Length (the framing supplies the body length).
fn h3glueHopByHop(name: string): bool {
  return name == "connection" ||
    name == "keep-alive" ||
    name == "proxy-connection" ||
    name == "transfer-encoding" ||
    name == "upgrade" ||
    name == "content-length"
}

// Serialize an h3 header-field list into this module's raw "Name: value\r\n" block.
fn h3glueBlock(fields: []HeaderField): string {
  let block = ""
  for f of fields {
    block = block + "${f.name}: ${f.value}\r\n"
  }
  return block
}

// Parse a raw "Name: value\r\n" block into h3 header fields, lower-casing each name
// (HTTP/3 requires it) and dropping connection-specific headers. Appends to `dst`.
// Bounded: each turn consumes at least one line from `rest`.
fn h3glueFields(dst: []HeaderField, block: string): []HeaderField {
  let out = dst
  let rest = block
  while (len(rest) > 0) {
    let eol = indexOf(rest, "\r\n")
    let line = rest
    if (eol >= 0) {
      line = rest[0:eol]
      rest = rest[eol + 2:len(rest)]
    } else {
      rest = ""
    }
    let colon = indexOf(line, ":")
    if (colon < 0) {
      continue
    }
    let name = toLower(trimSpace(line[0:colon]))
    if (len(name) == 0 || h3glueHopByHop(name)) {
      continue
    }
    // bit:lint allow E0214 -- unexported; its one call site (h3glueResponseOut) reassigns fields = h3glueFields(fields, ...) and never reads the pre-call slice again
    out = append(
      out,
      HeaderField{ name: name, value: trimSpace(line[colon + 1:len(line)]), sensitive: false },
    )
  }
  return out
}

// Build an h3 request for `method u.path` with `body` over scheme https.
fn h3glueRequestOf(method: string, u: Url, body: string): H3Request {
  return H3Request{
    method: method,
    scheme: "https",
    authority: h2glueAuthority(u),
    path: u.path,
    headers: []HeaderField(0),
    body: []byte(body),
  }
}

// Map an h3 response to this module's `Response`: `:status` is the status, the
// remaining fields become the raw header block, Content-Type is read from it.
fn h3glueResponse(res: H3Response): Response {
  let block = h3glueBlock(res.headers)
  return Response{
    status: res.status,
    contentType: header(block, "content-type"),
    headers: block,
    body: string(res.body),
  }
}

// Map an h3 request to this module's `Request`, flattening the header fields.
fn h3glueRequestIn(req: H3Request): Request {
  return Request{
    method: req.method,
    path: req.path,
    headers: h3glueBlock(req.headers),
    body: string(req.body),
  }
}

// Map this module's `Response` to an h3 response: Content-Type becomes a header
// field, the raw header block is parsed into fields, and the body carries over.
fn h3glueResponseOut(res: Response): H3Response {
  let fields = []HeaderField(0)
  if (len(res.contentType) > 0) {
    fields = append(
      fields,
      HeaderField{ name: "content-type", value: res.contentType, sensitive: false },
    )
  }
  fields = h3glueFields(fields, res.headers)
  return H3Response{ status: res.status, headers: fields, body: []byte(res.body) }
}

// Run one request/response over HTTP/3: dial QUIC at `u.host:u.port`, send the
// request on a fresh stream, read the response, and close the connection (one
// request per connection, as elsewhere in this module).
fn h3Exchange(u: Url, method: string, body: string): Response! {
  let conn = h3Dial(u.host, u.port, u.host)?
  let res = conn.request(h3glueRequestOf(method, u, body)) catch e {
    conn.close()
    fail e
  }
  conn.close()
  return h3glueResponse(res)
}

// As `h3Exchange`, bounded by `deadlineNs` — an absolute monotonic
// nanosecond deadline resolved ONCE before dial, matching the shape
// `requestTimeoutTls` (client.bit) already uses for `dialDeadline`/
// `tlsDialDeadline` on the http/https path (#2995/#3004).
//
// Unlike that path, this deadline does not bound every read/write
// individually: std/net's is a real syscall-level deadline
// (`bit_rt_net_read_deadline_w`); QUIC is not built on a `std/net` `Conn` at
// all and has no per-operation deadline primitive in this runtime. Instead
// it rides `h3DialDeadline`'s lowered CONNECTION idle timeout (RFC 9000
// §10.1) rather than adding a second, parallel timer: a peer that accepts
// the handshake and then never answers stops producing any transport
// traffic at all (this exchange's own HEADERS/FIN is the last thing that
// gets a transport ACK), so the idle timer elapses close to `deadlineNs` and
// tears the connection down, releasing `request()`.
//
// This IS a real, documented gap relative to the http/https path: QUIC's
// idle timer resets on ANY received datagram, not on request progress
// specifically (RFC 9000 §10.1 is a "peer is gone" detector, not a
// wall-clock ceiling), so a peer that keeps the connection alive with
// transport-level traffic while never answering at the application layer
// could in principle outlast `deadlineNs`. Closing it needs a true
// wall-clock check independent of `st.lastRecv`, which is out of this
// ticket's scope (see `h3DialDeadline`'s doc for the matching handshake-side
// gap). `h3Exchange` is one request per connection (this file's header), so
// tearing the connection down on timeout can never strand a sibling request
// the way it would on a server- or pool-side multiplexed connection.
fn h3ExchangeDeadline(u: Url, method: string, body: string, deadlineNs: int): Response! {
  let conn = h3DialDeadline(u.host, u.port, u.host, deadlineNs) catch e {
    fail h3DeadlineRelabel(e, deadlineNs)
  }
  let res = conn.request(h3glueRequestOf(method, u, body)) catch e {
    conn.close()
    fail h3DeadlineRelabel(e, deadlineNs)
  }
  conn.close()
  return h3glueResponse(res)
}

// Relabel `e` as a timeout only when `deadlineNs` had genuinely already
// elapsed by the time of failure, so a real handshake or protocol error that
// happens to land before the deadline is never misreported as one — the
// same distinction std/net's `-2` read/write sentinel draws at the syscall
// level, approximated here since QUIC has no equivalent signal to read.
fn h3DeadlineRelabel(e: error, deadlineNs: int): error {
  if (monotonic() >= deadlineNs) {
    return newError("h3: request timed out (${e.message()})")
  }
  return e
}

// Serve one accepted HTTP/3 connection: accept each request, dispatch it through
// the transport-agnostic `handler`, and answer on the same stream. Bounded so the
// loop is provably finite; returns (closing the connection) when the peer stops.
fn serveH3Conn(conn: H3Conn, handler: (Request) => Response) {
  let guard = 0
  while (guard < 1048576) {
    guard = guard + 1
    let sr = conn.accept() catch e {
      conn.close()
      return
    }
    conn.respond(sr, h3glueResponseOut(handler(h3glueRequestIn(sr.req)))) catch e2 {
      conn.close()
      return
    }
  }
  conn.close()
}

// Serve HTTP/3 on `host:port` (UDP) with the certificate chain `certPem` and
// matching private key `keyPem` (both PEM), dispatching every request to the same
// `(Request) => Response` handler `serve`/`serveTls` use. The QUIC listener
// demultiplexes many client connections on the one socket; each accepted
// connection is served on its own green thread. Runs an accept loop (bounded, so
// provably finite) until the socket closes; run the call itself on its own green
// thread. Advertise it from a `serveTls` server on the same port (its Alt-Svc
// header) so `https://` clients can discover and upgrade to it.
export fn serveH3(
  host: string,
  port: int,
  certPem: string,
  keyPem: string,
  handler: (Request) => Response,
): ()! {
  let sock = udpBind(host, port)?
  let lst = h3Listen(sock, certPem, keyPem)?
  let guard = 0
  while (guard < 1048576) {
    guard = guard + 1
    let conn = lst.accept() catch e {
      return
    }
    spawn serveH3Conn(conn, handler)
  }
}
