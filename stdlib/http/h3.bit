// Bit standard library — http module: the HTTP/3-over-QUIC glue.

// ---------------------------------------------------------------------------
// HTTP/3 over QUIC
// ---------------------------------------------------------------------------
//
// HTTP/3 (RFC 9114) runs over QUIC (UDP), not TLS-over-TCP, so it is opt-in: a
// server binds a UDP socket with `serveH3`, and a client reaches it either with an
// explicit `https+h3://` URL or by upgrading after reading an `Alt-Svc` header a
// TLS server advertised. The `std/http3` engine does the QUIC streams, QPACK, and
// framing; this module maps between its `H3Request`/`H3Response` (pseudo-headers +
// a `[]HeaderField` list) and the transport-agnostic `Request`/`Response`, exactly
// as the `h2glue*` helpers do for HTTP/2. Every helper here is prefixed `h3glue`.
//
// The QUIC transport demultiplexes many client connections on one socket, so
// `serveH3` runs an accept loop and serves each connection on its own green
// thread; run the call itself on its own green thread. The h3 client is still one
// request per connection, matching the rest of this module.

// Connection-specific header fields forbidden on an HTTP/3 message (RFC 9114
// §4.2), plus Content-Length (the framing supplies the body length).
fn h3glueHopByHop(name: string): bool {
  return name == "content-length" || connectionSpecificField(name)
}

// Serialize an h3 header-field list into this module's raw "Name: value\r\n" block.
fn h3glueBlock(fields: []HeaderField): string {
  let block = ""
  for f of fields {
    block = block + "${f.name}: ${f.value}\r\n"
  }
  return block
}

// `h3glueBlock` for a request a peer sent: fails, with no block, on the first field
// `putPeerField` (peerfields.bit) refuses (RFC 9114 §4.2, #6729), checking each
// byte as it is copied (#6736). The twin of `h2glueRequestBlock` (h2.bit): the
// two field types differ, the verdict is the one shared function.
fn h3glueRequestBlock(fields: []HeaderField): string! {
  let size = 0
  for f of fields {
    size = size + len(f.name) + len(f.value) + 4
  }
  let buf = []byte(size)
  let k = 0
  for f of fields {
    k = putPeerField(buf, k, f.name, f.value)
    if (k < 0) {
      fail newError("h3: malformed request: bad header field")
    }
  }
  return string(buf)
}

// Parse a raw "Name: value\r\n" block into h3 header fields, lower-casing each name
// (HTTP/3 requires it) and dropping connection-specific headers. Appends to `dst`.
// Bounded: each turn consumes at least one line from `rest`. Shared by the response
// path (`h3glueResponseOut`) and, since #2290, the outgoing-request path
// (`h3glueRequestOf`) — both always pass a freshly built `dst`, never one held
// elsewhere, so the append-aliasing note below stays true for either caller.
fn h3glueFields(dst: []HeaderField, block: string): []HeaderField {
  let out = dst
  let rest = block
  while (len(rest) > 0) {
    let eol = indexOf(rest, "\r\n")
    let line = rest
    if (eol >= 0) {
      line = rest[0:eol]
      rest = rest[eol + 2:len(rest)]
    } else {
      rest = ""
    }
    let colon = indexOf(line, ":")
    if (colon < 0) {
      continue
    }
    let name = toLower(trimSpace(line[0:colon]))
    if (len(name) == 0 || h3glueHopByHop(name)) {
      continue
    }
    // bit:lint allow E0214 -- unexported; every call site discards or never rereads its pre-call slice (see this function's doc comment)
    out = append(
      out,
      HeaderField{ name = name, value = trimSpace(line[colon + 1:len(line)]), sensitive = false },
    )
  }
  return out
}

// Build an h3 request for `method u.path` with `body` over scheme https. `block`
// is extra request headers, already validated and serialized by
// `serializeHeaders` (reqheader.bit, #2290) — "" for none.
fn h3glueRequestOf(method: string, u: Url, body: reqBody, block: string): H3Request {
  return H3Request{
    method = method,
    scheme = "https",
    authority = h2glueAuthority(u),
    path = u.path,
    headers = h3glueFields([]HeaderField(0), block),
    body = body.bytes(),
  }
}

// Map an h3 response to this module's `Response`: `:status` is the status, the
// remaining fields become the raw header block, Content-Type is read from it.
fn h3glueResponse(res: H3Response): Response {
  let block = h3glueBlock(res.headers)
  return Response{
    status = res.status,
    contentType = header(block, "content-type"),
    headers = block,
    body = string(res.body),
  }
}

// Map an h3 request to this module's `Request`, flattening the header fields. Fails
// when a field makes the request malformed (`putPeerField`, peerfields.bit, #6729), which
// `serveH3Conn` answers with a 400.
//
// `peer` is the connection's client address, read once per connection by
// `serveH3Conn` from `H3Conn.peerIp` and passed in here for every request on
// it — the same shape `h2glueRequestIn` uses, and for the same reason: HTTP/3
// multiplexes many requests over one connection, so the address is a property
// of the connection, not of the request.
//
// It cannot come from `net.Conn.peerIp` the way the HTTP/1.1 and HTTP/2 paths
// get it: HTTP/3 runs over QUIC on a BOUND UDP socket shared by every client,
// not a connected one, so `getpeername` on that fd has no peer to report at
// all. `quic.Conn.peerIp` answers instead, from the source address of the
// datagram that established that connection (#4555). `""` still
// means "peer unknown" — never an address — exactly as for a hand-built
// request.
fn h3glueRequestIn(req: H3Request, peer: string): Request! {
  return Request{
    method = req.method,
    path = req.path,
    headers = h3glueRequestBlock(req.headers)?,
    body = string(req.body),
    peer = peer,
  }
}

// Map this module's `Response` to an h3 response: Content-Type becomes a header
// field, the raw header block is parsed into fields, and the body carries over.
fn h3glueResponseOut(res: Response): H3Response {
  let fields = []HeaderField(0)
  if (len(res.contentType) > 0) {
    fields = append(
      fields,
      HeaderField{ name = "content-type", value = res.contentType, sensitive = false },
    )
  }
  fields = h3glueFields(fields, res.headers)
  return H3Response{ status = res.status, headers = fields, body = []byte(res.body) }
}

// The response to send for `req`: the handler's, or a 400 when the request is
// malformed (`h3glueRequestIn`) so the handler never sees it. RFC 9114 §4.1.2 asks
// for a stream error H3_MESSAGE_ERROR; `std/http3` keeps its `Stream` private, so
// the glue answers 400 and the stream ends cleanly instead (#6729).
fn h3glueAnswer(req: H3Request, peer: string, handler: (Request) => Response): H3Response {
  let r = h3glueRequestIn(req, peer) catch _ {
    return H3Response{ status = 400, headers = []HeaderField(0), body = []byte(0) }
  }
  return h3glueResponseOut(handler(r))
}

// Run one request/response over HTTP/3: dial QUIC at `u.host:u.port` with the
// caller's `config` (from `getTls`/`requestTls`/a `Client`'s own TLS config —
// #6235, the same `TlsConfig` the https leg already carries), send the
// request on a fresh stream, read the response, and close the connection (one
// request per connection, as elsewhere in this module). `block` is extra
// request headers, already validated and serialized by `serializeHeaders`
// (reqheader.bit, #2290) — "" for none.
fn h3Exchange(u: Url, method: string, body: reqBody, block: string, config: TlsConfig): Response! {
  let conn = h3DialTls(u.host, u.port, u.host, config) catch e {
    fail unsentError(e)
  }
  let res = conn.request(h3glueRequestOf(method, u, body, block)) catch e {
    conn.close()
    fail sentError(e)
  }
  conn.close()
  return h3glueResponse(res)
}

// As `h3Exchange`, bounded by `deadlineNs` — an absolute monotonic
// nanosecond deadline resolved ONCE before dial, matching the shape
// `requestTimeoutTls` (client.bit) already uses for `dialDeadline`/
// `tlsDialDeadline` on the http/https path (#2995/#3004).
//
// Unlike that path, this deadline does not bound every read/write
// individually: std/net's is a real syscall-level deadline
// (`bit_rt_net_read_deadline_w`); QUIC is not built on a `std/net` `Conn` at
// all and has no per-operation deadline primitive in this runtime. Instead
// it rides `h3DialTlsDeadline`'s lowered CONNECTION idle timeout (RFC 9000
// §10.1) rather than adding a second, parallel timer: a peer that accepts
// the handshake and then never answers stops producing any transport
// traffic at all (this exchange's own HEADERS/FIN is the last thing that
// gets a transport ACK), so the idle timer elapses close to `deadlineNs` and
// tears the connection down, releasing `request()`.
//
// This IS a real, documented gap relative to the http/https path: QUIC's
// idle timer resets on ANY received datagram, not on request progress
// specifically (RFC 9000 §10.1 is a "peer is gone" detector, not a
// wall-clock ceiling), so a peer that keeps the connection alive with
// transport-level traffic while never answering at the application layer
// could in principle outlast `deadlineNs`. Closing it needs a true
// wall-clock check independent of `st.lastRecv`, which is out of this
// ticket's scope (see `h3DialTlsDeadline`'s doc for the matching handshake-side
// gap). `h3Exchange` is one request per connection (this file's header), so
// tearing the connection down on timeout can never strand a sibling request
// the way it would on a server- or pool-side multiplexed connection.
// `extras` (client.bit's `RequestExtras`) carries `config` and `block` —
// taken as one value rather than two more parameters, E0202's ceiling is 5.
fn h3ExchangeDeadline(
  u: Url,
  method: string,
  body: reqBody,
  deadlineNs: int,
  extras: RequestExtras,
): Response! {
  let conn = h3DialTlsDeadline(u.host, u.port, u.host, extras.config, deadlineNs) catch e {
    fail unsentError(h3DeadlineRelabel(e, deadlineNs))
  }
  let res = conn.request(h3glueRequestOf(method, u, body, extras.block)) catch e {
    conn.close()
    fail sentError(h3DeadlineRelabel(e, deadlineNs))
  }
  conn.close()
  return h3glueResponse(res)
}

// Relabel `e` as a timeout only when `deadlineNs` had genuinely already
// elapsed by the time of failure, so a real handshake or protocol error that
// happens to land before the deadline is never misreported as one — the
// same distinction std/net's `-2` read/write sentinel draws at the syscall
// level, approximated here since QUIC has no equivalent signal to read.
fn h3DeadlineRelabel(e: error, deadlineNs: int): error {
  if (monotonic().ns >= deadlineNs) {
    return newError("h3: request timed out (${e.message()})")
  }
  return e
}

// Serve one accepted HTTP/3 connection: accept each request, dispatch it through
// the transport-agnostic `handler`, and answer on the same stream. Bounded so the
// loop is provably finite; returns (closing the connection) when the peer stops.
// `d` is the owning server's drain tracker (`shutdown.bit`, #6094): registered
// idle until this connection's first request starts, then active for the rest
// of its life — a graceful shutdown force-closes it right away if idle, or
// sends GOAWAY (`H3Conn.goAway`) and gives it up to its timeout to finish if
// active, the h3-native shape of the same promise `h2glueServe` and `serveOne`
// already make. `serveH3On`'s call site passes a private, never-drained `d`, so
// this bookkeeping is a no-op cost there (same pattern h2.bit's header comment
// documents for `serveTlsOn`).
fn serveH3Conn(conn: H3Conn, handler: (Request) => Response, d: drainState) {
  // Read once, before the accept loop: the address belongs to the connection,
  // and every request served here shares it (`h2glueServe` reads it in the same
  // place for the same reason). Cannot fail — see `H3Conn.peerIp`.
  let peer = conn.peerIp()
  let id = drainRegister(
    d,
    () => {
      conn.close()
    },
    () => {
      conn.goAway()
    },
  )
  defer drainDeregister(d, id)
  let guard = 0
  while (guard < 1048576) {
    guard = guard + 1
    let sr = conn.accept() catch _ {
      conn.close()
      return
    }
    drainMarkActive(d, id)
    conn.respond(sr, h3glueAnswer(sr.req, peer, handler)) catch _ {
      conn.close()
      return
    }
    // A shutdown mid-request (`goAway` above) already told the peer this was
    // the last one it would answer — closing right away, instead of looping
    // back to `accept` and waiting for the peer to hang up on its own or a
    // shutdown timeout to pass, is what makes `H3Server.shutdown` return
    // promptly once its one in-flight request finishes.
    if (conn.draining()) {
      conn.close()
      return
    }
  }
  conn.close()
}

// Serve HTTP/3 on `host:port` (UDP) with the certificate chain `certPem` and
// matching private key `keyPem` (both PEM), dispatching every request to the same
// `(Request) => Response` handler `serve`/`serveTls` use. The QUIC listener
// demultiplexes many client connections on the one socket; each accepted
// connection is served on its own green thread. Runs an accept loop (bounded, so
// provably finite) until the socket closes; run the call itself on its own green
// thread. Advertise it from a `serveTls` server on the same port (its Alt-Svc
// header) so `https://` clients can discover and upgrade to it.
export fn serveH3(
  host: string,
  port: int,
  certPem: string,
  keyPem: string,
  handler: (Request) => Response,
): ()! {
  serveH3On(udpBind(host, port)?, certPem, keyPem, handler)?
}

// Serve HTTP/3 on an already-bound UDP socket — the h3 mirror of
// `listenAndServeOn` and `serveTlsOn`, and the only way to learn the port
// before serving starts, since `serveH3` binds and loops in one call. With
// `port` 0 the kernel chooses the port, which is what an Alt-Svc pair needs:
// the TCP listener has to be on that same number, so the number cannot be
// known before one of the two sockets exists.
//
//   let sock = udpBind(host, 0)?
//   let boundPort = sock.port()?          // pair a TLS listener with this
//   serveH3On(sock, certPem, keyPem, handler)?
//
// Otherwise exactly `serveH3`: each accepted QUIC connection is served on its
// own green thread and the accept loop is bounded, so it is provably finite.
// Run the call on its own green thread; it returns when the socket closes.
export fn serveH3On(
  sock: UdpSocket,
  certPem: string,
  keyPem: string,
  handler: (Request) => Response,
): ()! {
  let lst = h3Listen(sock, certPem, keyPem)?
  let guard = 0
  while (guard < 1048576) {
    guard = guard + 1
    let conn = lst.accept() catch _ {
      return
    }
    // A private, never-drained tracker per connection — this path has no
    // shutdown handle to drain into (`h3Serve`/`H3Server` is that handle);
    // see `serveH3Conn`'s doc comment.
    spawn serveH3Conn(conn, handler, newDrainState())
  }
}

// ---------------------------------------------------------------------------
// H3Server — the shutdown-capable HTTP/3 server (#6094)
// ---------------------------------------------------------------------------

// A drain-capable HTTP/3 server handle: the h3 mirror of `TlsServer`
// (server.bit, #4314), bound with `h3Serve`, driven with `serveH3ServerOn`,
// stopped with `shutdown()`.
export class H3Server {
  lst: H3Listener
  sock: UdpSocket
  drain: drainState

  // The UDP port this server is bound to — the h3 mirror of
  // `TlsServer.port()`, needed the same way: `h3Serve`'s caller may have
  // asked for port 0 and let the kernel choose.
  export port(): int! {
    return this.sock.port()?
  }

  // Stop admitting brand-new QUIC connections (`H3Listener.stopAccepting`,
  // #6149 — connections already open keep being demuxed, only admission
  // stops), stop accepting new requests on connections already open (GOAWAY,
  // RFC 9114 §5.2, via each connection's `H3Conn.goAway`), give each one
  // already handling a request up to `timeoutMs` to finish, then force-close
  // whatever remains (`H3Conn.close`, H3_NO_ERROR). See shutdown.bit's header
  // comment for the full sequence; this reuses the exact same `drainRun`
  // engine `TlsServer.shutdown`/`Server.shutdown` do.
  //
  // A new connection attempted mid-drain gets the RFC 9000 §5.2.2 SHOULD: a
  // stateless CONNECTION_CLOSE(CONNECTION_REFUSED) reply
  // (`quic.Listener.stopAccepting`'s own doc has the mechanism, #6158), so
  // its dial fails immediately rather than running out its handshake
  // timeout. A datagram too malformed to answer still falls back to a
  // silent drop.
  export shutdown(timeoutMs: int): ()! {
    drainRun(
      () => {
        this.lst.stopAccepting()
      },
      this.drain,
      timeoutMs,
    )?
  }
}

// Bind `host:port` (UDP) for HTTP/3 with the certificate chain `certPem` and
// matching private key `keyPem` (both PEM) and return a shutdown-capable
// handle — the h3 mirror of `tlsServe`. Drive it with `serveH3ServerOn`.
export fn h3Serve(host: string, port: int, certPem: string, keyPem: string): H3Server! {
  let sock = udpBind(host, port)?
  let lst = h3Listen(sock, certPem, keyPem)?
  return H3Server{ lst = lst, sock = sock, drain = newDrainState() }
}

// Serve HTTP/3 forever on `hs` (`h3Serve`'s handle) — the shutdown-capable
// mirror of `serveH3On`. Every accepted connection registers in `hs.drain`
// (`serveH3Conn`) so `hs.shutdown(timeoutMs)` can drain it. Run on its own
// green thread; bounded so the loop is provably finite.
export fn serveH3ServerOn(hs: H3Server, handler: (Request) => Response): ()! {
  let guard = 0
  while (guard < 1048576) {
    guard = guard + 1
    let conn = hs.lst.accept() catch _ {
      return
    }
    spawn serveH3Conn(conn, handler, hs.drain)
  }
}
