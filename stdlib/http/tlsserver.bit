// Bit standard library — http module: the shutdown-capable TLS server,
// split out of server.bit when it passed the 800-line limit. A pure move;
// `serveTls`/`serveTlsOn` and the plaintext `Server` stay in server.bit,
// and every name here is module-scoped, so no import changes.

// ---------------------------------------------------------------------------
// TlsServer — the shutdown-capable TLS server (#4314)
// ---------------------------------------------------------------------------

// A listening TLS server with graceful shutdown: the TLS mirror of `Server`,
// bound with `tlsServe`, driven with `serveTlsServerOn`, stopped with
// `shutdown()` — the same three-call shape `serve`/`listenAndServeOn`/
// `Server.shutdown()` already use. `serveTls`/`serveTlsOn` above are
// unaffected — they keep their original `TlsListener`-based signatures for
// their existing ten call sites and are not reachable through this type.
export class TlsServer {
  listener: TlsListener
  drain: drainState
  maxBody: int
  // The paired HTTP/3 server this listener's port was also bound for (#6073),
  // or `Option.None` when there is none — `tlsServe` never sets one, only
  // `attachH3` does. `shutdown()` drains it too when present (#6094).
  h3: Option<H3Server>
  // The port the server is bound to.
  export port(): int! {
    return this.listener.port()?
  }

  // Pair `hs` (an `H3Server`, h3.bit) with this TLS listener so `shutdown()`
  // also drains it — the wiring `bindTls` (pkg/web/tls.bit, #6073/#6094) does
  // right after binding both on the same port. Not meant for a caller to
  // build a `TlsServer` and call directly; `tlsServe`'s result has no h3
  // attached until something does this.
  export attachH3(hs: H3Server) {
    this.h3 = Option.Some(hs)
  }

  // Raise or lower the byte budget this server reads a request body under —
  // the TLS mirror of `Server.setMaxBodyBytes`, with the same default. It
  // bounds BOTH protocols this listener serves (#4590): HTTP/1.1-over-TLS by
  // the same refusal `Server.setMaxBodyBytes` makes, and HTTP/2 by the
  // `std/http2` engine's `Config.maxBodyBytes`, which resets a stream whose
  // DATA passes the budget (the engine frames its own bodies and never calls
  // `readMessage`, so there is no declared length to refuse on).
  export setMaxBodyBytes(n: int) {
    this.maxBody = n
  }

  // Stop accepting new TLS connections, drain requests already in flight —
  // HTTP/1.1-over-TLS the same way `Server.shutdown()` drains a plain
  // connection, HTTP/2 by sending GOAWAY (`H2Conn.close()`) and letting
  // in-flight streams finish — and force-close whatever remains after
  // `timeoutMs`. See shutdown.bit's header comment for the full sequence.
  //
  // When `attachH3` paired this listener with an `H3Server`, its own
  // `shutdown(timeoutMs)` (#6094) runs CONCURRENTLY with the TCP-side drain
  // above, not after it — both share the one `timeoutMs` budget instead of
  // stacking to `2 * timeoutMs`. A failure from either side is reported;
  // when both fail, the HTTP/3 side's message wins, since the TCP path
  // already had `timeoutMs` to itself in the pre-#6094 contract this
  // preserves.
  export shutdown(timeoutMs: int): ()! {
    let h3Done = chan<string>(1)
    if (isSome(this.h3)) {
      spawn h3ShutdownBackground(unwrap(this.h3), timeoutMs, h3Done)
    } else {
      h3Done <- ""
    }
    let tcpErrMsg = ""
    drainTlsServer(this, timeoutMs) catch e {
      tcpErrMsg = e.message()
    }
    let h3ErrMsg = <- h3Done
    if (len(h3ErrMsg) > 0) {
      fail newError(h3ErrMsg)
    }
    if (len(tcpErrMsg) > 0) {
      fail newError(tcpErrMsg)
    }
  }

  // #6152: the TLS mirror of `Server.accept()` — accepts the next
  // connection, runs its handshake (so the caller can dispatch by ALPN
  // before reading anything), and returns a `TlsExchange` (tlshijack.bit)
  // ready for `read()`/`hijack()`. Refuses a connection that negotiated
  // "h2": hijacking over HTTP/2 needs RFC 8441, a materially different
  // mechanism from this one-shot-or-keep-alive HTTP/1.1 primitive — tracked
  // separately, not this method's job. Use `serveHijackableTlsOn`
  // (tlshijack.bit) to drive a whole server this way; call this directly
  // only to serve a bounded number of connections yourself, the same
  // relationship `Server.accept()` has to `listenAndServeOn`.
  export accept(): TlsExchange! {
    let c = this.listener.accept()?
    c.handshake()?
    if (c.alpnProtocol() == "h2") {
      fail newError(
          "http: TlsServer.accept: this connection negotiated h2 — " +
          "hijacking over HTTP/2 is not supported yet (RFC 8441)",
      )
    }
    return TlsExchange{ conn = c, maxBody = this.maxBody }
  }
}

// `TlsServer.shutdown`'s HTTP/3 half, run on its own green thread so it
// overlaps the TCP-side drain instead of following it: `hs.shutdown`'s error
// message (empty for none) is the whole of what the caller needs back.
fn h3ShutdownBackground(hs: H3Server, timeoutMs: int, done: chan<string>) {
  hs.shutdown(timeoutMs) catch e {
    done <- e.message()
    return
  }
  done <- ""
}

// Bind `host:port` for TLS with certificate chain `certPem` and matching
// private key `keyPem` (both PEM), advertising ALPN `h2` then `http/1.1` —
// the bind half of `serveTls`, split out so the listener it returns can be
// shut down gracefully. Drive it with `serveTlsServerOn`; `port` 0 lets the
// kernel choose one, read it back with `port()`.
export fn tlsServe(host: string, port: int, certPem: string, keyPem: string): TlsServer! {
  let cfg = TlsServerConfig(certPem, keyPem, ["h2", "http/1.1"])?
  let l = tlsListen(host, port, cfg)?
  return TlsServer{
    listener = l, drain = newDrainState(), maxBody = defaultMaxBodyBytes, h3 = Option.None,
  }
}

// Serve HTTPS forever on an already-bound `ts` — the shutdown-capable mirror
// of `serveTlsOn`. Every accepted connection, HTTP/1.1-over-TLS and h2 alike,
// registers in `ts.drain` (`serveTlsConn`, shared with `serveTlsOn`) so
// `ts.shutdown(timeoutMs)` can stop them. Once shutdown has closed the
// listener, `ts.listener.accept()`'s resulting failure ends this loop
// (`drainStarted`) instead of being swallowed as an ordinary per-connection
// failure the way `serveTlsOn` swallows one — see this function's sibling
// there for why an ordinary failure must NOT stop the loop.
export fn serveTlsServerOn(ts: TlsServer, handler: (Request) => Response): ()! {
  let altPort = ts.listener.port()?
  // See `serveTlsOn`'s comment on `idleTimeoutNs`: not yet enforced over TLS.
  let opts = connOpts{
    altPort = altPort, maxBody = ts.maxBody,
    idleTimeoutNs = defaultIdleTimeoutNs, maxRequests = defaultMaxRequestsPerConn,
    writeTimeoutNs = defaultIdleTimeoutNs,
  }
  while (true) {
    let conn = ts.listener.accept() catch _ {
      if (drainStarted(ts.drain)) {
        return
      }
      continue
    }
    spawn serveTlsConn(conn, handler, opts, ts.drain)
  }
}
