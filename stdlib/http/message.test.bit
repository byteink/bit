// stdlib/http/message.test.bit — the request body budget (#4565).
//
// `readMessage`, `Request`, `serve`, `listenAndServeOn`, `post`, `ok`,
// `indexOf`, `repeat` and `itoa` are all siblings or module-wide imports (SPEC
// §19), so nothing is imported here — `repeat` in particular already comes
// into this module through `multipart.test.bit`, and importing it twice is
// E0042.
//
// The last four tests are `header()`'s matching rule (#5437), which the body
// budget above depends on: `readRequestBody` frames a body from whatever
// `header()` says `Content-Length` and `Transfer-Encoding` are. They pin where
// a field line may begin, what must follow the name, and which occurrence
// wins, because `header()` scans the block in place with an ASCII case fold
// and an in-place scanner can get those wrong in ways lowercasing a copy of
// the whole block could not.
//
// The first three tests drive `readMessage` directly through a scripted
// `byteStream`, with no socket: that is what makes "refused BEFORE the bytes
// are read" mechanically checkable rather than a claim. The double counts its
// reads and remembers how far it was consumed, so a test can assert the server
// never asked for the body it refused. The fourth test proves the same budget
// reaching the wire through `Server.setMaxBodyBytes`, because a limit that is
// correct in `readMessage` and never plumbed through `serveOne` would pass
// all three of the others.

// A `byteStream` (http.bit) over a fixed script of bytes. `maxPerRead` caps
// what one `readUp` hands back regardless of what was asked for, so the reads
// are incremental the way a socket's are and `pos` is a real measure of how
// much of the request the server actually consumed. `reads` counts the calls.
// End of script is an empty read, exactly as a closed peer is.
class scriptedStream {
  data: string
  pos: int
  reads: int
  maxPerRead: int
  // Bytes `unread` pushed back — the same mechanism the real streams use
  // (#5419) to keep a pipelined next request from being dropped when a
  // framing function only wanted a prefix of what it read.
  pending: string

  readUp(n: int): string! {
    this.reads = this.reads + 1
    if (len(this.pending) > 0) {
      if (len(this.pending) <= n) {
        let out = this.pending
        this.pending = ""
        return out
      }
      let out = this.pending[0:n]
      this.pending = this.pending[n:len(this.pending)]
      return out
    }
    if (this.pos >= len(this.data)) {
      return ""
    }
    let want = n
    if (want > this.maxPerRead) {
      want = this.maxPerRead
    }
    let end = this.pos + want
    if (end > len(this.data)) {
      end = len(this.data)
    }
    let out = this.data[this.pos:end]
    this.pos = end
    return out
  }

  writeStr(data: string): ()! {
    // Nothing here writes a response; a write would be a test bug, not a
    // condition to tolerate quietly.
    fail newError("scriptedStream: unexpected write of ${len(data)} bytes")
  }

  shut() {}

  forceClose() {}

  peer(): string { return "" }

  unread(extra: string) { this.pending = extra + this.pending }

  setIdleDeadline(deadlineNs: int) {}
}

fn newScript(data: string, maxPerRead: int): scriptedStream {
  return scriptedStream{ data = data, pos = 0, reads = 0, maxPerRead = maxPerRead }
}

// One chunk of a `Transfer-Encoding: chunked` body: its size in hex, CRLF, the
// bytes, CRLF. `sizeHex` is spelled by the caller so the test data says on its
// face what the wire says.
fn chunk(sizeHex: string, body: string): string {
  return "${sizeHex}\r\n${body}\r\n"
}

test "a Content-Length above the budget is refused without reading the body" {
  // 4 GiB declared, and not one byte of it sent — the shape that used to
  // allocate 4 GiB before any handler saw the request.
  let head = "POST /u HTTP/1.1\r\nHost: x\r\nContent-Length: 4294967296\r\n\r\n"
  let st = newScript(head, 65536)
  let req = readMessage(st, 1024) catch e {
    let m = e.message()
    assert(indexOf(m, "exceeds 1024 bytes") >= 0, "message = '${m}'")
    assert(indexOf(m, "4294967296") >= 0, "message = '${m}'")
    // One read: the header block. The refusal happened before anything asked
    // the stream for a body byte — with the budget gone, the
    // Content-Length read makes at least one more call before giving up.
    assert(st.reads == 1, "reads = ${itoa(st.reads)}")
    assert(st.pos == len(head), "consumed ${itoa(st.pos)} of ${itoa(len(head))}")
    return
  }
  assert(false, "readMessage returned a ${itoa(len(req.body))}-byte body instead of failing")
}

test "a chunked body is refused on the chunk that crosses the budget, mid-stream" {
  // Three 256-byte chunks against a 512-byte budget: each one is individually
  // under the limit, so only a running total can catch this. Two fit exactly;
  // the third is refused. The 100000-byte chunk after it is the evidence that
  // the refusal stopped the read rather than tidying up after it.
  let head = "POST /u HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n"
  let small = chunk("100", repeat("a", 256))
  let data = head + small + small + small + chunk("186a0", repeat("b", 100000)) + "0\r\n\r\n"
  let st = newScript(data, 64)
  let req = readMessage(st, 512) catch e {
    let m = e.message()
    assert(indexOf(m, "chunked body exceeds 512 bytes") >= 0, "message = '${m}'")
    let left = len(data) - st.pos
    assert(left > 50000, "only ${itoa(left)} of ${itoa(len(data))} bytes were left unread")
    return
  }
  assert(false, "readMessage returned a ${itoa(len(req.body))}-byte body instead of failing")
}

test "a body of exactly the budget is accepted intact, Content-Length and chunked alike" {
  let body = repeat("a", 64)
  let clHead = "POST /u HTTP/1.1\r\nHost: x\r\nContent-Length: 64\r\n\r\n"
  let cl = newScript(clHead + body, 64)
  let clReq = readMessage(cl, 64) catch e {
    assert(false, "Content-Length at the budget: ${e.message()}")
    return
  }
  assert(clReq.method == "POST", "method = '${clReq.method}'")
  assert(clReq.path == "/u", "path = '${clReq.path}'")
  assert(clReq.body == body, "body was ${itoa(len(clReq.body))} bytes, not 64 intact")

  let chHead = "POST /u HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n"
  let ch = newScript(chHead + chunk("40", body) + "0\r\n\r\n", 64)
  let chReq = readMessage(ch, 64) catch e {
    assert(false, "chunked at the budget: ${e.message()}")
    return
  }
  assert(chReq.body == body, "chunked body was ${itoa(len(chReq.body))} bytes, not 64 intact")
}

// The whole server under test for the end-to-end case: report the size of the
// body the server managed to read, so a request that got through is
// distinguishable from one that was refused.
fn bodyLenEcho(req: Request): Response {
  return ok(itoa(len(req.body)))
}

// `listenAndServeOn` returns only on an accept error, which is what closing
// the listener at the end of the test produces; swallowing it is the intended
// end of this green thread, not an ignored failure.
fn budgetServe(s: Server) {
  listenAndServeOn(s, bodyLenEcho) catch _ {
    return
  }
}

test "Server.setMaxBodyBytes reaches the read path over a real connection" {
  let s = serve("127.0.0.1", 0) catch e {
    assert(false, "serve: ${e.message()}")
    return
  }
  // Before serving starts: `listenAndServeOn` reads the budget once, when the
  // loop begins.
  s.setMaxBodyBytes(64)
  let port = s.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  spawn budgetServe(s)

  let atLimit = post("http://127.0.0.1:${port}/u", repeat("a", 64)) catch e {
    s.close()
    assert(false, "post at the limit: ${e.message()}")
    return
  }
  assert(atLimit.status == 200, "at the limit: status ${itoa(atLimit.status)}")
  assert(atLimit.body == "64", "the handler read a body of '${atLimit.body}' bytes")

  let over = post("http://127.0.0.1:${port}/u", repeat("a", 65)) catch e {
    s.close()
    assert(false, "post over the limit: ${e.message()}")
    return
  }
  // 400, not 200: `answer` catches `readMessage`'s failure and answers
  // `answerBadRequest`. A 200 here would mean the handler ran on a body the
  // server was configured to refuse.
  assert(over.status == 400, "over the limit: status ${itoa(over.status)}")
  s.close()
}

// ---------------------------------------------------------------------------
// header() field-name matching (#5437)
// ---------------------------------------------------------------------------

// One block covering all three positions a match may be found in or confused
// by: a field at the very start, a field after a CRLF, and a VALUE that spells
// a field name of its own.
const matchBlock = "Content-Type: text/plain\r\nX-Note: content-length: 9\r\nContent-Length: 4\r\n"

test "header() matches a field name in any case, at the block start and after a CRLF" {
  // At byte 0.
  assert(
    header(matchBlock, "Content-Type") == "text/plain",
    "as written: '${header(matchBlock, "Content-Type")}'",
  )
  assert(
    header(matchBlock, "content-type") == "text/plain",
    "lower: '${header(matchBlock, "content-type")}'",
  )
  assert(
    header(matchBlock, "CONTENT-TYPE") == "text/plain",
    "upper: '${header(matchBlock, "CONTENT-TYPE")}'",
  )
  assert(
    header(matchBlock, "cOnTeNt-TyPe") == "text/plain",
    "mixed: '${header(matchBlock, "cOnTeNt-TyPe")}'",
  )
  // After a CRLF. The field itself is written in one case and asked for in
  // four, so neither side of the comparison can be the one being folded.
  assert(
    header(matchBlock, "Content-Length") == "4",
    "as written: '${header(matchBlock, "Content-Length")}'",
  )
  assert(
    header(matchBlock, "content-length") == "4",
    "lower: '${header(matchBlock, "content-length")}'",
  )
  assert(
    header(matchBlock, "CONTENT-LENGTH") == "4",
    "upper: '${header(matchBlock, "CONTENT-LENGTH")}'",
  )
  // A field written in lower case, asked for in upper.
  let lowerWritten = "x-trace: abc\r\n"
  assert(
    header(lowerWritten, "X-Trace") == "abc",
    "upper ask: '${header(lowerWritten, "X-Trace")}'",
  )
}

test "header() matches a whole field name at a line start, never a prefix or a value" {
  // "content-length: 9" appears in the X-Note VALUE, before the real field.
  // A search that does not insist on a line start reads 9.
  assert(
    header(matchBlock, "content-length") == "4",
    "value match won: '${header(matchBlock, "content-length")}'",
  )
  // A prefix of a field name is not that field: the ':' must follow the name.
  assert(header(matchBlock, "Content") == "", "prefix matched: '${header(matchBlock, "Content")}'")
  assert(
    header(matchBlock, "Content-") == "",
    "prefix matched: '${header(matchBlock, "Content-")}'",
  )
  // Nor is a field name that merely starts with the one asked for.
  let longer = "X-A: 1\r\nContent-Type-Options: nosniff\r\n"
  assert(
    header(longer, "Content-Type") == "",
    "longer field matched: '${header(longer, "Content-Type")}'",
  )
  // RFC 9112 §5: no whitespace between the field name and the colon.
  assert(header("X-Sp : 1\r\n", "X-Sp") == "", "space before colon matched")
  // Absent, and absent from an empty block.
  assert(header(matchBlock, "X-Missing") == "", "absent: '${header(matchBlock, "X-Missing")}'")
  assert(header("", "Content-Type") == "", "empty block matched something")
}

test "header() returns the first occurrence of a repeated field" {
  let repeated = "Set-Cookie: a=1\r\nSET-COOKIE: b=2\r\nset-cookie: c=3\r\n"
  assert(
    header(repeated, "Set-Cookie") == "a=1",
    "first of three: '${header(repeated, "Set-Cookie")}'",
  )
  assert(
    header(repeated, "set-cookie") == "a=1",
    "first of three: '${header(repeated, "set-cookie")}'",
  )
  // A repeat whose first occurrence is the one at byte 0.
  let firstAtStart = "X-Dup: one\r\nX-Dup: two\r\n"
  assert(
    header(firstAtStart, "x-dup") == "one",
    "first at byte 0: '${header(firstAtStart, "x-dup")}'",
  )
}

test "header() trims the value and reads a final line with no trailing CRLF" {
  assert(
    header("X-Pad:\tspaced  \r\n", "X-Pad") == "spaced",
    "trim: '${header("X-Pad:\tspaced  \r\n", "X-Pad")}'",
  )
  assert(
    header("X-Empty:\r\n", "X-Empty") == "",
    "empty value: '${header("X-Empty:\r\n", "X-Empty")}'",
  )
  assert(
    header("X-Empty:   \r\n", "X-Empty") == "",
    "blank value: '${header("X-Empty:   \r\n", "X-Empty")}'",
  )
  // No trailing CRLF on the last line: the value runs to the end of the block.
  assert(header("A: 1\r\nX-Last: tail", "X-Last") == "tail", "unterminated last line")
  assert(header("X-Only: solo", "X-Only") == "solo", "unterminated only line")
}

test "Response.setHeader replaces a field written in another case" {
  // `setHeader` finds the line to replace through `headerLineRange`, which
  // shares `header()`'s scanner: a case-insensitive find is what keeps two
  // spellings of one field from both reaching the wire.
  let r = ok("body")
  r.setHeader("X-Thing", "1") catch e {
    assert(false, "setHeader: ${e.message()}")
    return
  }
  r.setHeader("x-thing", "2") catch e {
    assert(false, "setHeader again: ${e.message()}")
    return
  }
  assert(r.headers == "x-thing: 2\r\n", "headers = '${r.headers}'")
  assert(r.getHeader("X-THING") == "2", "getHeader = '${r.getHeader("X-THING")}'")
}

// ---------------------------------------------------------------------------
// Framing the header block (#5898)
// ---------------------------------------------------------------------------

// A POST whose five-byte body follows its header block, then a pipelined GET:
// the wire image every split below cuts at a different point.
const pipeHead = "POST /a HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\n"
const pipeNext = "GET /b HTTP/1.1\r\nHost: y\r\n\r\n"

test "a header block that arrives in one read comes back as read, framed at its terminator" {
  let sep = len(pipeHead) - 4
  // Nothing after the terminator, the body alone, and the body plus a
  // pipelined request: all three in the first read, so the whole read is
  // returned and the offset is the one CRLFCRLF in the block.
  for after of ["", "hello", "hello" + pipeNext] {
    let st = newScript(pipeHead + after, 65536)
    let (raw, at) = readThroughHeaderEnd(st) catch e {
      assert(false, "readThroughHeaderEnd: ${e.message()}")
      return
    }
    assert(raw == pipeHead + after, "raw = '${raw}'")
    assert(at == sep, "offset ${itoa(at)}, want ${itoa(sep)}")
    assert(st.reads == 1, "reads = ${itoa(st.reads)}")
  }
}

test "a terminator split across two reads at each internal boundary is found at its offset" {
  let sep = len(pipeHead) - 4
  let wire = pipeHead + "hello"
  // The first read ends 1, 2 and 3 bytes into the CRLFCRLF: after its CR,
  // its first CRLF, and its second CR.
  let k = 1
  while (k <= 3) {
    let st = newScript(wire, sep + k)
    let (raw, at) = readThroughHeaderEnd(st) catch e {
      assert(false, "split +${itoa(k)}: ${e.message()}")
      return
    }
    assert(at == sep, "split +${itoa(k)}: offset ${itoa(at)}, want ${itoa(sep)}")
    assert(raw == wire[0:len(raw)], "split +${itoa(k)}: raw = '${raw}'")
    assert(len(raw) >= sep + 4, "split +${itoa(k)}: raw stops at ${itoa(len(raw))}")
    k = k + 1
  }
}

test "a pipelined pair parses the same whatever read size cuts the wire" {
  // Every read size from 1 byte up to the whole wire: that cuts the header
  // block mid CR/LF, mid header name and mid request line, starts the body in
  // the same read as the headers and in a later one, and leaves the pipelined
  // GET partly or wholly in the read that ended the POST.
  let wire = pipeHead + "hello" + pipeNext
  let size = 1
  while (size <= len(wire)) {
    let st = newScript(wire, size)
    let post = readMessage(st, 1024) catch e {
      assert(false, "read size ${itoa(size)}: POST: ${e.message()}")
      return
    }
    assert(
      post.method == "POST" && post.path == "/a",
      "read size ${itoa(size)}: POST '${post.method} ${post.path}'",
    )
    assert(post.body == "hello", "read size ${itoa(size)}: body '${post.body}'")
    assert(
      post.headers == "Host: x\r\nContent-Length: 5",
      "read size ${itoa(size)}: headers '${post.headers}'",
    )
    let get = readMessage(st, 1024) catch e {
      assert(false, "read size ${itoa(size)}: GET: ${e.message()}")
      return
    }
    assert(
      get.method == "GET" && get.path == "/b",
      "read size ${itoa(size)}: GET '${get.method} ${get.path}'",
    )
    assert(
      get.version == "HTTP/1.1" && get.body == "",
      "read size ${itoa(size)}: GET '${get.version}' body '${get.body}'",
    )
    let end = readMessage(st, 1024) catch e {
      assert(false, "read size ${itoa(size)}: end: ${e.message()}")
      return
    }
    assert(
      end.method == "",
      "read size ${itoa(size)}: a third request '${end.method}' after the pair",
    )
    size = size + 1
  }
}

test "a header block past maxHeaderBytes with no terminator is refused with the same message" {
  let st = newScript("GET / HTTP/1.1\r\nX: " + repeat("a", maxHeaderBytes + 8192), 65536)
  let req = readMessage(st, 1024) catch e {
    let m = e.message()
    assert(m == "readMessage: header block exceeds 65536 bytes", "message = '${m}'")
    return
  }
  assert(false, "readMessage returned '${req.method}' for an unterminated block")
}

test "a terminator in the read that crosses maxHeaderBytes is still accepted" {
  // Reads are 4096 bytes, so the read that starts at exactly maxHeaderBytes is
  // the last one the cap allows; a block ending inside it is accepted.
  let line = "GET / HTTP/1.1\r\nX: "
  let head = line + repeat("a", maxHeaderBytes + 100 - len(line)) + "\r\n\r\n"
  let st = newScript(head, 65536)
  let req = readMessage(st, 1024) catch e {
    assert(false, "readMessage: ${e.message()}")
    return
  }
  assert(
    req.method == "GET" && len(req.headers) == maxHeaderBytes + 100 - 16,
    "headers ${itoa(len(req.headers))} bytes",
  )
}
