// Bit standard library — http module: multipart/form-data parsing (RFC 7578).
//
// `parseMultipart` turns a request body into named text fields and named file
// parts — the missing piece that made file upload impossible with only
// `stdlib/http` (#3961). It lives in this module rather than in a web
// framework so any plain `stdlib/http` server can read an upload, not only
// one built on top of a framework.
//
// SECURITY: the body is attacker-controlled. Every `Limits` field below is
// REQUIRED and none is disableable by passing zero — a zero limit rejects
// every part that would otherwise consume it, it does not mean "unlimited".
// A malformed or missing boundary, an over-limit part, or a part whose
// headers exceed their own limit fails the WHOLE parse; nothing here ever
// returns a partially-built `Form`, and nothing here skips a bad part and
// continues — partial acceptance of a malformed body is how request
// smuggling works.
//
// `multipartField` is the same walk for a caller that wants ONE named text
// field: it applies every check above to every part and fails on exactly the
// bodies `parseMultipart` fails on, with the same messages, but materialises
// no part body except the one it returns. A CSRF token can be read out of a
// body carrying a 5 MiB upload without copying the upload.
//
// `filename` and the declared `Content-Type` of a file part are returned
// EXACTLY as received and are never inspected, sanitised, decoded or used to
// build a path. Both are attacker-controlled: a filename of `../../etc/passwd`
// is returned verbatim, and a declared `Content-Type` of `image/png` proves
// nothing about the bytes that follow it. Any path-joining or content
// sniffing is the caller's job, done deliberately, not this parser's.

import { indexOfFrom } from "std/strings"

// ---------------------------------------------------------------------------
// Limits
// ---------------------------------------------------------------------------

// The five bounds a caller MUST set before parsing an untrusted body — see the
// module comment. Each is a hard ceiling in bytes (or, for `maxParts`, a
// count): exceeding one fails the parse with a distinct error naming which
// limit was hit. None has a meaning for zero other than "reject everything
// that would use it".
export class Limits {
  export maxBodyBytes: int,
  export maxFileBytes: int,
  export maxParts: int,
  export maxHeaderLineBytes: int,
  export maxPartHeaderBytes: int,
}

// Reasonable defaults for an ordinary web upload form: a 32 MiB total body, a
// 10 MiB single file, at most 64 parts (fields plus files), an 8 KiB single
// header line and a 16 KiB total header block per part — generous for any
// real `Content-Disposition`/`Content-Type` pair, tight enough that a part
// with thousands of fake header lines cannot run unbounded.
export fn defaultLimits(): Limits {
  return Limits{
    maxBodyBytes: 32 * 1024 * 1024,
    maxFileBytes: 10 * 1024 * 1024,
    maxParts: 64,
    maxHeaderLineBytes: 8 * 1024,
    maxPartHeaderBytes: 16 * 1024,
  }
}

// ---------------------------------------------------------------------------
// Form
// ---------------------------------------------------------------------------

// One text field: its form name and value, exactly as sent.
export class FormField {
  export name: string,
  export value: string,
}

// One file part: its form name, the sender's declared filename and content
// type — both UNTRUSTED, see the module comment — and the raw file bytes.
export class FormFile {
  export name: string,
  export filename: string,
  export contentType: string,
  export content: []byte,
}

// The result of a successful `parseMultipart`: every text field and every
// file part, in the order they appeared in the body. A name may repeat (the
// wire format allows it); `value`/`file` return the first match.
export class Form {
  export fields: []FormField
  export files: []FormFile

  // The value of the first field named `name`, or "" if none matched.
  export value(name: string): string {
    for f of this.fields {
      if (f.name == name) {
        return f.value
      }
    }
    return ""
  }

  // The first file part named `name`. Fails if none matched.
  export file(name: string): FormFile! {
    for f of this.files {
      if (f.name == name) {
        return f
      }
    }
    fail newError("multipart: no file part named \"${name}\"")
  }
}

// ---------------------------------------------------------------------------
// Boundary
// ---------------------------------------------------------------------------

// RFC 2046 §5.1.1 `bcharsnospace`: the non-space bytes a boundary token may
// contain, alongside letters and digits.
const boundaryExtraBytes = "'()+_,-./:=?"

fn isBoundaryByte(c: byte): bool {
  if (c >= '0' && c <= '9') {
    return true
  }
  if (c >= 'A' && c <= 'Z') {
    return true
  }
  if (c >= 'a' && c <= 'z') {
    return true
  }
  return indexOfFrom(boundaryExtraBytes, string([]byte{ c }), 0) >= 0
}

// True iff `b` is a well-formed RFC 2046 boundary token: 1-70 bytes, every
// byte a boundary character or an interior space, and the last byte not a
// space. An empty, over-long, or byte-invalid boundary is malformed, not
// best-effort accepted — see the module comment.
fn validBoundary(b: string): bool {
  let n = len(b)
  if (n < 1 || n > 70) {
    return false
  }
  let i = 0
  while (i < n) {
    let c = b[i]
    if (c != ' ' && !isBoundaryByte(c)) {
      return false
    }
    i = i + 1
  }
  return b[n - 1] != ' '
}

// ---------------------------------------------------------------------------
// Content-Disposition parameter extraction
// ---------------------------------------------------------------------------

// Reads a `name="quoted value"` or `name=token` parameter value starting at
// `start` in `value` (right after the `=`). A quoted-string decodes RFC 2045
// `quoted-pair` escapes (`\X` -> `X`); an unterminated quote returns
// everything up to the end of the header line, since the caller's own
// per-line length limit already bounds how far this can scan. An unquoted
// token ends at the next `;` or end of string.
fn readParamValue(value: string, start: int, n: int): string {
  if (start >= n) {
    return ""
  }
  if (value[start] != '"') {
    let end = indexOfFrom(value, ";", start)
    if (end < 0) {
      end = n
    }
    return trimSpace(value[start:end])
  }
  let out = []byte(0)
  let i = start + 1
  // Bounded by n: `i` strictly increases by 1 or 2 every iteration.
  while (i < n) {
    let c = value[i]
    if (c == '\\' && i + 1 < n) {
      out = append(out, value[i + 1])
      i = i + 2
      continue
    }
    if (c == '"') {
      return string(out)
    }
    out = append(out, c)
    i = i + 1
  }
  return string(out)
}

// The value of parameter `paramName` in a `;`-separated parameter list like
// `form-data; name="a"; filename="b.txt"`, and whether it was present at
// all — present-but-empty (`filename=""`) must be distinguishable from
// absent, since an empty declared filename still marks a part as a file
// (RFC 7578 §4.2).
fn dispositionParam(value: string, paramName: string): (string, bool) {
  let n = len(value)
  let needle = toLower(paramName) + "="
  let lower = toLower(value)
  let i = 0
  // Bounded by n: each iteration either returns or advances `i` past the
  // candidate match it just rejected.
  while (i < n) {
    let at = indexOfFrom(lower, needle, i)
    if (at < 0) {
      return "", false
    }
    let boundaryOk = at == 0
    if (!boundaryOk) {
      let j = at - 1
      while (j >= 0 && (value[j] == ' ' || value[j] == '\t')) {
        j = j - 1
      }
      boundaryOk = j < 0 || value[j] == ';'
    }
    if (!boundaryOk) {
      i = at + 1
      continue
    }
    return readParamValue(value, at + len(needle), n), true
  }
  return "", false
}

// ---------------------------------------------------------------------------
// Scanning the body as bytes
// ---------------------------------------------------------------------------

// The byte index of the first occurrence of `needle` at or after `at` in
// `hay`, or -1 if there is none. `at` must not be negative; an `at` past the
// end yields -1, and an empty `needle` matches at `at`.
//
// The `[]byte` twin of `std/strings`' `indexOfFrom`, and the reason the walk
// below never converts the body: reaching the string form of this scan costs
// a `string(body)` copy of the WHOLE body before the first part is looked at,
// measured at 67,131,536 bytes on a 64 MiB upload (#4604).
//
// It is private because this is the only caller in the tree. The two cannot
// share a core: they differ only in the haystack's type, Bit's generics bound
// on interfaces (SPEC 11.3), and `string` and `[]byte` implement none in
// common — a shared core would mean dynamic dispatch per byte. The scan is
// the same one `indexOfFrom` runs, so both answer identically.
fn indexOfBytesFrom(hay: []byte, needle: string, at: int): int {
  let m = len(needle)
  let last = len(hay) - m
  let i = at
  // Bounded by len(hay): `i` strictly increases every iteration.
  while (i <= last) {
    let j = 0
    while (j < m && hay[i + j] == needle[j]) {
      j = j + 1
    }
    if (j == m) {
      return i
    }
    i = i + 1
  }
  return -1
}

// ---------------------------------------------------------------------------
// Part header block
// ---------------------------------------------------------------------------

// Reads one part's header block starting at `start` (right after the
// delimiter line's CRLF) up to and including the blank line that ends it.
// Returns the header block (excluding the blank line, in `header()`'s own
// "Name: value\r\n..." form) and the offset of the first body byte.
//
// The header block is the ONE range of the body this file turns into a
// string, and `maxPartHeaderBytes` — checked below, as it is read — is that
// copy's bound. A part's BODY is never copied here, whatever its size.
//
// Enforces `maxHeaderLineBytes` per line and `maxPartHeaderBytes` for the
// whole block as it goes, so a header this rejects is rejected the moment it
// is seen rather than after buffering it. Fails outright — never truncates —
// if a limit is exceeded or the block never reaches a blank line.
fn readPartHeaders(body: []byte, start: int, n: int, limits: Limits): (string, int)! {
  let pos = start
  let total = 0
  // Bounded by n: `pos` strictly advances by at least 2 bytes (a CRLF) every
  // iteration, and any line exceeding a limit fails immediately.
  while (pos <= n) {
    let lineEnd = indexOfBytesFrom(body, "\r\n", pos)
    if (lineEnd < 0) {
      fail newError("multipart: part header block is not terminated")
    }
    let lineLen = lineEnd - pos
    if (lineLen > limits.maxHeaderLineBytes) {
      fail newError("multipart: part header line exceeds ${limits.maxHeaderLineBytes}-byte limit")
    }
    total = total + lineLen + 2
    if (total > limits.maxPartHeaderBytes) {
      fail newError("multipart: part header block exceeds ${limits.maxPartHeaderBytes}-byte limit")
    }
    if (lineLen == 0) {
      return string(body[start:pos]), pos + 2
    }
    pos = lineEnd + 2
  }
  fail newError("multipart: part header block is not terminated")
}

// Skips any transport padding (spaces/tabs) after a delimiter and requires
// the CRLF that ends the delimiter line. Fails on anything else, so a
// delimiter line with junk instead of a terminator cannot be silently
// reinterpreted as part of the next header.
fn afterDelimiterLine(body: []byte, pos: int, n: int): int! {
  let i = pos
  // Bounded by n.
  while (i < n && (body[i] == ' ' || body[i] == '\t')) {
    i = i + 1
  }
  if (i + 2 > n || body[i] != '\r' || body[i + 1] != '\n') {
    fail newError("multipart: malformed boundary line")
  }
  return i + 2
}

// ---------------------------------------------------------------------------
// The part walk — one implementation, two entry points
// ---------------------------------------------------------------------------

// The single walk over a `multipart/form-data` body. `parseMultipart` and
// `multipartField` both drive it; there is exactly one delimiter scan, one
// close-delimiter test and one part-header reader in this file and this class
// calls them.
//
// It walks `body` as the `[]byte` it was handed — nothing here converts the
// whole body — and reports each part's body as a RANGE (`bodyStart`..`bodyEnd`)
// into it rather than as bytes, so a caller that does not want a part's
// content never materialises it. That is the ONLY thing a caller may skip: every limit and
// every structural check below is applied to every part before the caller
// sees it, so a part that would fail one entry point fails the other
// identically — the module comment's "fails the WHOLE body" rule does not
// weaken because a caller wanted one field.
class multipartWalk {
  body: []byte
  delim: string
  limits: Limits
  n: int
  pos: int
  partCount: int
  closed: bool
  headers: string
  bodyStart: int
  bodyEnd: int

  // Advances to the next part and reports whether there was one. Returns
  // false only after the CLOSING delimiter has been consumed; a body that
  // ends without one fails here instead, so "no more parts" and "truncated
  // body" can never be confused by a caller's loop condition.
  next(): bool! {
    if (this.closed) {
      return false
    }
    if (this.pos >= this.n) {
      fail newError("multipart: unterminated body (boundary never closes)")
    }
    this.pos = this.pos + len(this.delim)
    if (isCloseDelimiter(this.body, this.pos, this.n)) {
      this.pos = this.pos + 2
      this.closed = true
      return false
    }
    this.partCount = this.partCount + 1
    if (this.partCount > this.limits.maxParts) {
      fail newError("multipart: too many parts (limit ${this.limits.maxParts})")
    }
    this.locatePart()?
    return true
  }

  // Reads the current part's header block and finds the delimiter that ends
  // its body, leaving the cursor on that delimiter and the part's header
  // block and body range in `headers`/`bodyStart`/`bodyEnd`.
  locatePart(): ()! {
    let afterLine = afterDelimiterLine(this.body, this.pos, this.n)?
    let (headers, start) = readPartHeaders(this.body, afterLine, this.n, this.limits)?
    let nextDelimAt = indexOfBytesFrom(this.body, "\r\n" + this.delim, start)
    if (nextDelimAt < 0) {
      fail newError("multipart: unterminated part (boundary never closes)")
    }
    this.headers = headers
    this.bodyStart = start
    this.bodyEnd = nextDelimAt
    // Past this part's terminating CRLF: where the next delimiter starts.
    this.pos = nextDelimAt + 2
  }
}

// Starts a walk at the first delimiter occurrence in `body`. These are the
// checks that precede any part — an over-limit body, a malformed boundary, a
// body the boundary never appears in — made once here so both entry points
// make them in the same order with the same messages.
fn startWalk(body: []byte, boundary: string, limits: Limits): multipartWalk! {
  if (len(body) > limits.maxBodyBytes) {
    fail newError("multipart: body exceeds ${limits.maxBodyBytes}-byte limit")
  }
  if (!validBoundary(boundary)) {
    fail newError("multipart: missing or malformed boundary")
  }
  let delim = "--" + boundary
  let firstAt = indexOfBytesFrom(body, delim, 0)
  if (firstAt < 0) {
    fail newError("multipart: boundary delimiter not found in body")
  }
  return multipartWalk{
    body: body,
    delim: delim,
    limits: limits,
    n: len(body),
    pos: firstAt,
    partCount: 0,
    closed: false,
    headers: "",
    bodyStart: 0,
    bodyEnd: 0,
  }
}

// True iff `body[pos:]` starts with the close-delimiter's trailing `--` (the
// two bytes right after a delimiter's own `--boundary` text).
fn isCloseDelimiter(body: []byte, pos: int, n: int): bool {
  return pos + 2 <= n && body[pos] == '-' && body[pos + 1] == '-'
}

// What a part's `Content-Disposition` says it is: its form `name`, its
// declared `filename`, and whether that parameter was present at all —
// RFC 7578 §4.2's test for "this part is a file", however empty the value.
class partHead {
  name: string,
  filename: string,
  isFile: bool,
}

// Reads a part's `Content-Disposition` and enforces `maxFileBytes` on it.
// Fails on a missing or non-form-data disposition, a missing `name`, or a
// file part over its limit.
//
// It takes the part body's LENGTH, never its bytes: the file limit is a
// property of the range the walk already knows, so it is enforced on a part
// a caller is going to skip exactly as on one it keeps.
fn readPartHead(headers: string, bodyLen: int, limits: Limits): partHead! {
  let cd = header(headers, "Content-Disposition")
  if (!hasPrefix(trimSpace(toLower(cd)), "form-data")) {
    fail newError("multipart: part is missing a form-data Content-Disposition")
  }
  let (name, hasName) = dispositionParam(cd, "name")
  if (!hasName) {
    fail newError("multipart: part is missing the required name parameter")
  }
  let (filename, hasFilename) = dispositionParam(cd, "filename")
  if (hasFilename && bodyLen > limits.maxFileBytes) {
    fail newError("multipart: file part \"${name}\" exceeds ${limits.maxFileBytes}-byte limit")
  }
  return partHead{ name: name, filename: filename, isFile: hasFilename }
}

// ---------------------------------------------------------------------------
// parseMultipart
// ---------------------------------------------------------------------------

// Parses `body` as a `multipart/form-data` message (RFC 7578) delimited by
// `boundary` — the value of the request's `Content-Type: multipart/form-data;
// boundary=...` parameter, WITHOUT the leading `--`. Returns every text field
// and file part found, or fails with a specific error and no partial `Form`
// on the first problem: an over-limit body/file/part-count, an over-limit
// part header, a missing or malformed boundary, or a body whose last part
// never reaches a closing delimiter.
//
// Reading ONE field out of a body costs a copy of every file part here, since
// every part is materialised into the `Form`. `multipartField` is the same
// walk without that copy.
//
// See the module comment for what this deliberately does NOT do: sanitise or
// validate `filename`, or inspect a declared `Content-Type`.
export fn parseMultipart(body: []byte, boundary: string, limits: Limits): Form! {
  let walk = startWalk(body, boundary, limits)?
  let form = Form{ fields: []FormField(0), files: []FormFile(0) }
  // Bounded by the body length: `next` either fails or advances the cursor
  // past at least one delimiter, and reports false at the closing one.
  let more = walk.next()?
  while (more) {
    appendPart(form, walk)?
    more = walk.next()?
  }
  return form
}

// Appends the walk's current part to `form` as either a file (a `filename`
// parameter was present, however empty) or a text field.
fn appendPart(form: Form, walk: multipartWalk): ()! {
  let head = readPartHead(walk.headers, walk.bodyEnd - walk.bodyStart, walk.limits)?
  // `walk.body[lo:hi]` is a VIEW sharing the caller's body (SPEC 12.6), so
  // both arms below copy: a `Form` that aliased the request body would change
  // under a caller that reused its buffer, and would keep the whole body
  // alive for one small field. `string(view)` is that copy for a field.
  let partBody = string(walk.body[walk.bodyStart:walk.bodyEnd])
  if (!head.isFile) {
    form.fields = append(form.fields, FormField{ name: head.name, value: partBody })
    return
  }
  form.files = append(
    form.files,
    FormFile{
      name: head.name,
      filename: head.filename,
      contentType: header(walk.headers, "Content-Type"),
      content: []byte(partBody),
    },
  )
}

// ---------------------------------------------------------------------------
// multipartField
// ---------------------------------------------------------------------------

// The value of the first text field named `name` in `body`, and whether such
// a field was there at all — present-but-empty (`""`, `true`) must be
// distinguishable from absent (`""`, `false`), the same distinction
// `filename` needs in a part's `Content-Disposition`.
//
// This is `parseMultipart`'s walk with nothing built: no `Form`, and no part
// body materialised except the one returned. Reading a token or a form field
// out of a body that also carries a 5 MiB upload does not copy the upload.
//
// What it does NOT skip is a check. The whole body is walked even after the
// field is found, and every limit and structural error applies to every part,
// so this fails exactly when `parseMultipart` fails, with the same message —
// a value is never returned out of a body that is malformed further along.
// File parts are matched by no name: a part carrying a `filename` parameter
// is a file (RFC 7578 §4.2) and is never returned as a field value.
export fn multipartField(
  body: []byte,
  boundary: string,
  name: string,
  limits: Limits,
): (string, bool)! {
  let walk = startWalk(body, boundary, limits)?
  let value = ""
  let found = false
  // Bounded by the body length, as in `parseMultipart`.
  let more = walk.next()?
  while (more) {
    let head = readPartHead(walk.headers, walk.bodyEnd - walk.bodyStart, walk.limits)?
    if (!found && !head.isFile && head.name == name) {
      value = string(walk.body[walk.bodyStart:walk.bodyEnd])
      found = true
    }
    more = walk.next()?
  }
  return value, found
}
