// stdlib/http/pool.test.bit — the client's idle-connection pool (#6453).
//
// Same module as client.bit (SPEC §19): `Client`, `get`, `post`,
// `PoolLimits`, `connPool`, `newConnPool`, `Idle`, `readMessage`, `netStream`,
// `Listener`, `Conn`, `listen`, `hasPrefix`, `atoi`, `sleep`, `Millisecond`
// and `monotonic` are bound module-wide, so only `std/sync`'s atomic is
// imported. A pool's value is only provable by counting what the server
// accepts: `origin` below answers HTTP/1.1 keep-alive on a loopback listener
// and counts every accepted connection, so "reused" means "the count did not
// move" rather than "no error".
import { AtomicI64 } from "std/sync"

// One keep-alive origin. `closeAfter` > 0 closes each connection after that
// many answers WITHOUT announcing it, which is exactly what an idle timeout on
// a real server looks like to a client holding the connection.
class origin {
  l: Listener,
  accepts: AtomicI64,
  port: int,
}

fn answer(req: Request): string {
  if (hasPrefix(req.path, "/hop")) {
    let n = atoi(req.path[4:len(req.path)])
    if (n > 0) {
      return "HTTP/1.1 302 Found\r\nLocation: /hop${n - 1}\r\nContent-Length: 0\r\n\r\n"
    }
  }
  let body = "${req.method} ${req.path}"
  if (req.path == "/close") {
    return "HTTP/1.1 200 OK\r\nConnection: close\r\nContent-Length: ${len(body)}\r\n\r\n${body}"
  }
  return "HTTP/1.1 200 OK\r\nContent-Length: ${len(body)}\r\n\r\n${body}"
}

fn originConn(c: Conn, closeAfter: int) {
  defer c.close()
  let s = netStream{ conn = c }
  let n = 0
  while (true) {
    let req = readMessage(s, 1048576) catch _ {
      return
    }
    if (len(req.method) == 0) {
      return
    }
    n = n + 1
    s.writeStr(answer(req)) catch _ {
      return
    }
    if (closeAfter > 0 && n >= closeAfter) {
      return
    }
    if (req.path == "/close") {
      return
    }
  }
}

fn originAccept(l: Listener, accepts: AtomicI64, closeAfter: int) {
  while (true) {
    let c = l.accept() catch _ {
      return
    }
    accepts.add(1)
    spawn originConn(c, closeAfter)
  }
}

fn startOrigin(closeAfter: int): origin! {
  let l = listen("127.0.0.1", 0)?
  let port = l.port()?
  let accepts = AtomicI64(0)
  spawn originAccept(l, accepts, closeAfter)
  return origin{ l = l, accepts = accepts, port = port }
}

fn acceptsOf(o: origin): int {
  return int(o.accepts.load())
}

fn urlOf(o: origin, path: string): string {
  return "http://127.0.0.1:${o.port}${path}"
}

test "five sequential Client.get calls to one origin make one accept" {
  let o = startOrigin(0) catch e {
    assert(false, "startOrigin: ${e.message()}")
    return
  }
  let c = Client()
  let i = 0
  while (i < 5) {
    let res = c.get(urlOf(o, "/n${i}")) catch e {
      assert(false, "get ${i}: ${e.message()}")
      return
    }
    assert(res.body == "GET /n${i}", "body ${i} = '${res.body}'")
    i = i + 1
  }
  assert(acceptsOf(o) == 1, "accepts = ${acceptsOf(o)}, want 1")
  c.close()
  o.l.close()
}

test "a same-origin redirect chain of three hops makes one accept" {
  let o = startOrigin(0) catch e {
    assert(false, "startOrigin: ${e.message()}")
    return
  }
  let c = Client()
  let res = c.get(urlOf(o, "/hop3")) catch e {
    assert(false, "get: ${e.message()}")
    return
  }
  assert(res.status == 200 && res.redirects == 3, "status ${res.status} redirects ${res.redirects}")
  assert(res.body == "GET /hop0", "body = '${res.body}'")
  assert(acceptsOf(o) == 1, "accepts = ${acceptsOf(o)}, want 1")
  c.close()
  o.l.close()
}

test "a package-level get shares one connection across its redirect hops" {
  let o = startOrigin(0) catch e {
    assert(false, "startOrigin: ${e.message()}")
    return
  }
  let res = get(urlOf(o, "/hop3")) catch e {
    assert(false, "get: ${e.message()}")
    return
  }
  assert(res.body == "GET /hop0", "body = '${res.body}'")
  assert(acceptsOf(o) == 1, "accepts = ${acceptsOf(o)}, want 1")
  o.l.close()
}

test "a connection idle past idleTimeoutMs is not reused" {
  let o = startOrigin(0) catch e {
    assert(false, "startOrigin: ${e.message()}")
    return
  }
  let c = Client()
  c.setPool(PoolLimits{ idleTimeoutMs = 40 }) catch e {
    assert(false, "setPool: ${e.message()}")
    return
  }
  c.get(urlOf(o, "/a")) catch e {
    assert(false, "get a: ${e.message()}")
    return
  }
  sleep(120 * Millisecond)
  c.get(urlOf(o, "/b")) catch e {
    assert(false, "get b: ${e.message()}")
    return
  }
  assert(acceptsOf(o) == 2, "accepts = ${acceptsOf(o)}, want 2")
  c.close()
  o.l.close()
}

test "maxIdlePerHost 0 turns reuse off" {
  let o = startOrigin(0) catch e {
    assert(false, "startOrigin: ${e.message()}")
    return
  }
  let c = Client()
  c.setPool(PoolLimits{ maxIdlePerHost = 0 }) catch e {
    assert(false, "setPool: ${e.message()}")
    return
  }
  c.get(urlOf(o, "/a")) catch e {
    assert(false, "get a: ${e.message()}")
    return
  }
  c.get(urlOf(o, "/b")) catch e {
    assert(false, "get b: ${e.message()}")
    return
  }
  assert(acceptsOf(o) == 2, "accepts = ${acceptsOf(o)}, want 2")
  o.l.close()
}

test "a response with Connection: close is not pooled" {
  let o = startOrigin(0) catch e {
    assert(false, "startOrigin: ${e.message()}")
    return
  }
  let c = Client()
  c.get(urlOf(o, "/close")) catch e {
    assert(false, "get 1: ${e.message()}")
    return
  }
  c.get(urlOf(o, "/close")) catch e {
    assert(false, "get 2: ${e.message()}")
    return
  }
  assert(acceptsOf(o) == 2, "accepts = ${acceptsOf(o)}, want 2")
  o.l.close()
}

test "a GET on a connection the server closed while idle is retried on a fresh one" {
  let o = startOrigin(1) catch e {
    assert(false, "startOrigin: ${e.message()}")
    return
  }
  let c = Client()
  let i = 0
  while (i < 3) {
    let res = c.get(urlOf(o, "/n${i}")) catch e {
      assert(false, "get ${i} was not retried: ${e.message()}")
      return
    }
    assert(res.body == "GET /n${i}", "body ${i} = '${res.body}'")
    i = i + 1
  }
  assert(acceptsOf(o) == 3, "accepts = ${acceptsOf(o)}, want 3")
  c.close()
  o.l.close()
}

test "a POST on a connection the server closed while idle is not retried" {
  let o = startOrigin(1) catch e {
    assert(false, "startOrigin: ${e.message()}")
    return
  }
  let c = Client()
  c.post(urlOf(o, "/a"), "x") catch e {
    assert(false, "first post: ${e.message()}")
    return
  }
  // Let the server's close land, so the parked connection is dead.
  sleep(50 * Millisecond)
  let res = c.post(urlOf(o, "/b"), "x") catch _ {
    assert(
      acceptsOf(o) == 1,
      "accepts = ${acceptsOf(o)}: the POST was replayed on a new connection",
    )
    c.close()
    o.l.close()
    return
  }
  assert(false, "the POST on a dead connection returned ${res.status}")
}

// A stream whose only observable behaviour is whether it was closed.
class fakeIdle {
  closed: bool

  readUp(n: int): string! { return "" }

  writeStr(s: string): ()! {}

  writeBytes(b: []byte): ()! {}

  shut() { this.closed = true }

  forceClose() {}

  peer(): string { return "" }

  unread(extra: string) {}

  setIdleDeadline(deadlineNs: int) {}
}

fn isHit(i: Idle): bool {
  match (i) {
    Hit(_) => return true
    Miss => return false
  }
}

test "maxIdlePerHost caps one origin, closing the connection that does not fit" {
  let p = newConnPool(PoolLimits{ maxIdlePerHost = 2 })
  let a = fakeIdle{ closed = false }
  let b = fakeIdle{ closed = false }
  let c = fakeIdle{ closed = false }
  p.put("http://h:1", a, 1)
  p.put("http://h:1", b, 2)
  p.put("http://h:1", c, 3)
  assert(!a.closed && !b.closed, "the two that fit were closed")
  assert(c.closed, "the third did not fit and stayed open")
  assert(isHit(p.take("http://h:1", 4)) && isHit(p.take("http://h:1", 4)), "two hits expected")
  assert(!isHit(p.take("http://h:1", 4)), "a third hit: the pool held more than 2")
}

test "maxIdleTotal closes the oldest idle connection across origins" {
  let p = newConnPool(PoolLimits{ maxIdlePerHost = 2, maxIdleTotal = 2 })
  let a = fakeIdle{ closed = false }
  let b = fakeIdle{ closed = false }
  let c = fakeIdle{ closed = false }
  p.put("http://one:1", a, 1)
  p.put("http://two:1", b, 2)
  p.put("http://three:1", c, 3)
  assert(a.closed, "the oldest connection was not evicted")
  assert(!b.closed && !c.closed, "a newer connection was evicted")
  assert(!isHit(p.take("http://one:1", 4)), "the evicted origin still hit")
}

test "take returns the most recently parked connection and closes expired ones" {
  let p = newConnPool(PoolLimits{ idleTimeoutMs = 10 })
  let old = fakeIdle{ closed = false }
  let fresh = fakeIdle{ closed = false }
  p.put("http://h:1", old, 0)
  p.put("http://h:1", fresh, 5 * Millisecond)
  // 12 ms in: `old` (idle 12 ms) has expired, `fresh` (idle 7 ms) has not.
  assert(isHit(p.take("http://h:1", 12 * Millisecond)), "the live connection was not returned")
  assert(old.closed, "the expired connection was not closed")
  assert(!fresh.closed, "the live connection was closed")
}

test "a retired pool closes what is handed back to it" {
  let p = newConnPool(PoolLimits{})
  let a = fakeIdle{ closed = false }
  let b = fakeIdle{ closed = false }
  p.put("http://h:1", a, 1)
  p.retire()
  assert(a.closed, "retire left an idle connection open")
  p.put("http://h:1", b, 2)
  assert(b.closed, "a retired pool parked a connection")
}

test "setPool rejects limits that are a mistake" {
  let c = Client()
  c.setPool(PoolLimits{ maxIdlePerHost = -1 }) catch e {
    assert(indexOf(e.message(), "maxIdlePerHost") >= 0, "message = '${e.message()}'")
    c.setPool(PoolLimits{ maxIdlePerHost = 5, maxIdleTotal = 4 }) catch e2 {
      assert(indexOf(e2.message(), "maxIdleTotal") >= 0, "message = '${e2.message()}'")
      c.setPool(PoolLimits{ idleTimeoutMs = 0 }) catch e3 {
        assert(indexOf(e3.message(), "idleTimeoutMs") >= 0, "message = '${e3.message()}'")
        return
      }
      assert(false, "idleTimeoutMs = 0 was accepted")
      return
    }
    assert(false, "maxIdleTotal below maxIdlePerHost was accepted")
    return
  }
  assert(false, "a negative maxIdlePerHost was accepted")
}

// ---------------------------------------------------------------------------
// maxConnsPerHost: connections open at once to one origin (#6467)
// ---------------------------------------------------------------------------
//
// `holdOrigin` answers keep-alive requests like `origin` but holds each for
// 60 ms and counts the connections open now and the most there ever were, so a
// cap is proven by what the SERVER saw, not by what the client says it did.

class holdOrigin {
  l: Listener,
  accepts: AtomicI64,
  open: AtomicI64,
  peak: AtomicI64,
  port: int,
}

fn holdConn(c: Conn, o: holdOrigin) {
  let n = o.open.add(1)
  let p = o.peak.load()
  while (n > p && !o.peak.compareAndSwap(p, n)) {
    p = o.peak.load()
  }
  defer o.open.add(-1)
  defer c.close()
  let s = netStream{ conn = c }
  while (true) {
    let req = readMessage(s, 1048576) catch _ {
      return
    }
    if (len(req.method) == 0) {
      return
    }
    sleep(60 * Millisecond)
    s.writeStr(answer(req)) catch _ {
      return
    }
  }
}

fn holdAccept(o: holdOrigin) {
  while (true) {
    let c = o.l.accept() catch _ {
      return
    }
    o.accepts.add(1)
    spawn holdConn(c, o)
  }
}

fn startHoldOrigin(): holdOrigin! {
  let l = listen("127.0.0.1", 0)?
  let o = holdOrigin{
    l = l, accepts = AtomicI64(0), open = AtomicI64(0), peak = AtomicI64(0),
    port = l.port()?,
  }
  spawn holdAccept(o)
  return o
}

fn holdGet(c: Client, url: string, out: chan<string>) {
  let res = c.get(url) catch e {
    out <- "error: ${e.message()}"
    return
  }
  out <- "${res.status} ${res.body}"
}

// `n` concurrent gets of `/r<i>`; how many answered `200 GET /r<i>`.
fn holdBurst(c: Client, o: holdOrigin, n: int): int {
  let out = chan<string>(n)
  let i = 0
  while (i < n) {
    spawn holdGet(c, "http://127.0.0.1:${o.port}/r${i}", out)
    i = i + 1
  }
  let good = 0
  i = 0
  while (i < n) {
    let got = <- out
    if (hasPrefix(got, "200 GET /r")) {
      good = good + 1
    } else {
      assert(false, "a capped get answered '${got}'")
    }
    i = i + 1
  }
  return good
}

test "maxConnsPerHost = 2 never lets the server see a third open connection" {
  let o = startHoldOrigin() catch e {
    assert(false, "startHoldOrigin: ${e.message()}")
    return
  }
  let c = Client()
  c.setPool(PoolLimits{ maxConnsPerHost = 2 }) catch e {
    assert(false, "setPool: ${e.message()}")
    return
  }
  assert(holdBurst(c, o, 8) == 8, "not all 8 capped gets completed")
  assert(int(o.peak.load()) == 2, "peak open = ${o.peak.load()}, want exactly the cap 2")
  assert(int(o.accepts.load()) == 2, "accepts = ${o.accepts.load()}, want 2 (the waiters reuse)")
  c.close()
  o.l.close()
}

test "without maxConnsPerHost the same burst opens more than two connections" {
  let o = startHoldOrigin() catch e {
    assert(false, "startHoldOrigin: ${e.message()}")
    return
  }
  let c = Client()
  assert(holdBurst(c, o, 8) == 8, "not all 8 gets completed")
  assert(int(o.peak.load()) > 2, "peak open = ${o.peak.load()}: the control never exceeded 2")
  c.close()
  o.l.close()
}

test "a request over maxConnsPerHost fails at its deadline and the error names the cap" {
  let o = startHoldOrigin() catch e {
    assert(false, "startHoldOrigin: ${e.message()}")
    return
  }
  let c = Client()
  c.setPool(PoolLimits{ maxConnsPerHost = 1 }) catch e {
    assert(false, "setPool: ${e.message()}")
    return
  }
  let out = chan<string>(1)
  spawn holdGet(c, "http://127.0.0.1:${o.port}/slow", out)
  sleep(15 * Millisecond)
  c.getTimeout("http://127.0.0.1:${o.port}/late", 20) catch e {
    assert(indexOf(e.message(), "maxConnsPerHost = 1") >= 0, "message = '${e.message()}'")
    let first = <- out
    assert(first == "200 GET /slow", "the holder answered '${first}'")
    c.close()
    o.l.close()
    return
  }
  assert(false, "a request over the cap succeeded")
}

test "a slot is free again after its holder releases it twice or its waiter times out" {
  let p = newConnPool(PoolLimits{ maxConnsPerHost = 1 })
  let a = p.acquire("http://h:1", 0, Option.None) catch e {
    assert(false, "first acquire: ${e.message()}")
    return
  }
  p.acquire("http://h:1", monotonic().ns + 10 * Millisecond, Option.None) catch e {
    assert(indexOf(e.message(), "http://h:1") >= 0, "message = '${e.message()}'")
    a.release()
    a.release()
    let b = p.acquire("http://h:1", monotonic().ns + 10 * Millisecond, Option.None) catch e2 {
      assert(false, "acquire after release: ${e2.message()}")
      return
    }
    b.release()
    assert(len(p.caps) == 0, "caps holds ${len(p.caps)} entries after every user left")
    return
  }
  assert(false, "a second acquire got past a cap of 1")
}

test "maxConnsPerHost counts each origin separately" {
  let p = newConnPool(PoolLimits{ maxConnsPerHost = 1 })
  let a = p.acquire("http://h:1", 0, Option.None) catch e {
    assert(false, "acquire h:1: ${e.message()}")
    return
  }
  let b = p.acquire("http://h:2", monotonic().ns + 10 * Millisecond, Option.None) catch e {
    assert(false, "another origin was held back: ${e.message()}")
    return
  }
  a.release()
  b.release()
}

test "setPool rejects a negative maxConnsPerHost" {
  let c = Client()
  c.setPool(PoolLimits{ maxConnsPerHost = -1 }) catch e {
    assert(indexOf(e.message(), "maxConnsPerHost") >= 0, "message = '${e.message()}'")
    return
  }
  assert(false, "maxConnsPerHost = -1 was accepted")
}

// ---------------------------------------------------------------------------
// HTTP/2: one shared connection per origin (#6465)
// ---------------------------------------------------------------------------
//
// The TLS config helpers (`tls5916ServerConfig`, `tls5916ClientConfig`,
// tls.test.bit) are module siblings; they pin ALPN to HTTP/1.1, so each test
// here widens it to `h2`. A TLS handshake is counted as an accepted TCP
// connection, since every connection the server accepts runs exactly one. The
// handler holds each request for 60 ms so that eight requests started
// together are all in flight at once, and records how many were.

class h2origin {
  l: TlsListener,
  accepts: AtomicI64,
  active: AtomicI64,
  peak: AtomicI64,
  port: int,
}

fn h2originHandle(req: Request, o: h2origin): Response {
  let n = o.active.add(1)
  let p = o.peak.load()
  while (n > p && !o.peak.compareAndSwap(p, n)) {
    p = o.peak.load()
  }
  sleep(60 * Millisecond)
  o.active.add(-1)
  return ok("h2 ${req.path}")
}

fn h2originLoop(o: h2origin) {
  let opts = connOpts{
    altPort = 0, maxBody = defaultMaxBodyBytes,
    idleTimeoutNs = defaultIdleTimeoutNs, maxRequests = defaultMaxRequestsPerConn,
    writeTimeoutNs = defaultIdleTimeoutNs,
  }
  let d = newDrainState()
  acceptLoop(() => o.l.accept(), () => o.l.isClosed(), maxAcceptBackoffNs, (conn) => {
    o.accepts.add(1)
    spawn serveTlsConn(conn, (req) => h2originHandle(req, o), opts, d)
  }) catch _ {
    return
  }
}

fn startH2Origin(): h2origin! {
  let cfg = tls5916ServerConfig()?
  cfg.alpn = ["h2", "http/1.1"]
  let l = tlsListen("127.0.0.1", 0, cfg)?
  let o = h2origin{
    l = l, accepts = AtomicI64(0), active = AtomicI64(0), peak = AtomicI64(0),
    port = l.port()?,
  }
  spawn h2originLoop(o)
  return o
}

fn h2client(): Client {
  let cfg = tls5916ClientConfig()
  cfg.alpn = ["h2", "http/1.1"]
  return Client(tls = cfg)
}

fn h2get(c: Client, url: string, out: chan<string>) {
  let res = c.get(url) catch e {
    out <- "error: ${e.message()}"
    return
  }
  out <- "${res.status} ${res.body}"
}

// Starts `n` concurrent `c.get`s of `/r<i>` against `o` and returns how many
// answered `200 h2 /r<i>`, asserting each answer as it arrives.
fn h2burst(c: Client, o: h2origin, n: int): int {
  let out = chan<string>(n)
  let i = 0
  while (i < n) {
    spawn h2get(c, "https://127.0.0.1:${o.port}/r${i}", out)
    i = i + 1
  }
  let good = 0
  i = 0
  while (i < n) {
    let got = <- out
    if (hasPrefix(got, "200 h2 /r")) {
      good = good + 1
    } else {
      assert(false, "a concurrent get answered '${got}'")
    }
    i = i + 1
  }
  return good
}

test "eight concurrent Client.get calls to one h2 origin make one TLS handshake" {
  let o = startH2Origin() catch e {
    assert(false, "startH2Origin: ${e.message()}")
    return
  }
  let c = h2client()
  let good = h2burst(c, o, 8)
  assert(good == 8, "${good} of 8 concurrent gets succeeded")
  assert(int(o.accepts.load()) == 1, "handshakes = ${o.accepts.load()}, want 1")
  assert(
    int(o.peak.load()) > 1,
    "peak in-flight = ${o.peak.load()}: the requests were not multiplexed",
  )
  // A later request still rides the same connection.
  assert(h2burst(c, o, 1) == 1, "a request after the burst failed")
  assert(int(o.accepts.load()) == 1, "handshakes after reuse = ${o.accepts.load()}, want 1")
  c.close()
  o.l.close()
}

test "Client.close retires the shared h2 connection and the next request dials again" {
  let o = startH2Origin() catch e {
    assert(false, "startH2Origin: ${e.message()}")
    return
  }
  let c = h2client()
  assert(h2burst(c, o, 2) == 2, "first burst failed")
  c.close()
  assert(h2burst(c, o, 2) == 2, "burst after close failed")
  assert(int(o.accepts.load()) == 2, "handshakes = ${o.accepts.load()}, want 2")
  c.close()
  o.l.close()
}

test "PoolLimits.maxH2Streams caps the streams in flight and the rest wait" {
  let o = startH2Origin() catch e {
    assert(false, "startH2Origin: ${e.message()}")
    return
  }
  let c = h2client()
  c.setPool(PoolLimits{ maxH2Streams = 2 }) catch e {
    assert(false, "setPool: ${e.message()}")
    return
  }
  assert(h2burst(c, o, 8) == 8, "capped burst failed")
  assert(int(o.accepts.load()) == 1, "handshakes = ${o.accepts.load()}, want 1")
  assert(int(o.peak.load()) == 2, "peak in-flight = ${o.peak.load()}, want exactly the cap 2")
  c.close()
  o.l.close()
}

test "maxIdlePerHost = 0 turns h2 sharing off" {
  let o = startH2Origin() catch e {
    assert(false, "startH2Origin: ${e.message()}")
    return
  }
  let c = h2client()
  c.setPool(PoolLimits{ maxIdlePerHost = 0 }) catch e {
    assert(false, "setPool: ${e.message()}")
    return
  }
  assert(h2burst(c, o, 3) == 3, "burst failed")
  assert(int(o.accepts.load()) == 3, "handshakes = ${o.accepts.load()}, want 3 (one per request)")
  c.close()
  o.l.close()
}

test "setPool rejects a maxH2Streams below one" {
  let c = Client()
  c.setPool(PoolLimits{ maxH2Streams = 0 }) catch e {
    assert(indexOf(e.message(), "maxH2Streams") >= 0, "message = '${e.message()}'")
    return
  }
  assert(false, "maxH2Streams = 0 was accepted")
}

test "maxConnsPerHost does not cap h2: eight requests, cap 1, one connection, several in flight" {
  let o = startH2Origin() catch e {
    assert(false, "startH2Origin: ${e.message()}")
    return
  }
  let c = h2client()
  c.setPool(PoolLimits{ maxConnsPerHost = 1 }) catch e {
    assert(false, "setPool: ${e.message()}")
    return
  }
  assert(h2burst(c, o, 8) == 8, "burst under maxConnsPerHost = 1 failed")
  assert(int(o.accepts.load()) == 1, "handshakes = ${o.accepts.load()}, want 1")
  assert(int(o.peak.load()) > 1, "peak in-flight = ${o.peak.load()}: h2 was serialised by the cap")
  c.close()
  o.l.close()
}
