// stdlib/http/peerfields.test.bit — the fields a peer sends over HTTP/2 and
// HTTP/3 are validated before they are serialised into the text block
// `header()` reads (`peerFieldMalformed`, http.bit; `h2glueRequestIn`, h2.bit;
// `h3glueRequestIn`, h3.bit; #6729).
//
// HPACK and QPACK carry a field as a length-prefixed name and value, so a peer
// can put any bytes in either. Unchecked, a name with a space or a value with
// "\r\nX: y" became a second field line in `Request.headers`: a header the peer
// could not otherwise set, or `transfer-encoding ` read as `transfer-encoding`
// by a proxy that trims it. The request is refused instead (RFC 9113 §8.2.1,
// RFC 9114 §4.2).
//
// `h2glueRequestIn`, `h3glueRequestIn`, `H2Request`, `H3Request`,
// `H2HeaderField`, `HeaderField`, `Request`, `header` and `peerFieldMalformed`
// are module siblings or module-wide imports (SPEC §19), so nothing is imported.

const pfRefused = "refused"

fn pfH2Fields(name: string, value: string): string {
  let req = H2Request("GET", "example.com", "/")
  req.headers = []H2HeaderField{ H2HeaderField{ name = name, value = value, sensitive = false } }
  let r = h2glueRequestIn(req, "") catch _ {
    return pfRefused
  }
  return r.headers
}

fn pfH3Fields(name: string, value: string): string {
  let req = H3Request{
    method = "GET",
    scheme = "https",
    authority = "example.com",
    path = "/",
    headers = []HeaderField{ HeaderField{ name = name, value = value, sensitive = false } },
    body = []byte(0),
  }
  let r = h3glueRequestIn(req, "") catch _ {
    return pfRefused
  }
  return r.headers
}

test "peer fields: a well-formed h2 and h3 request is still served, headers readable" {
  let h2 = pfH2Fields("content-type", "text/plain")
  assert(h2 == "content-type: text/plain\r\n", "h2 block = ${h2}")
  assert(header(h2, "content-type") == "text/plain", "h2 content-type unreadable")
  let h3 = pfH3Fields("x-request-id", "a-b_c.1")
  assert(h3 == "x-request-id: a-b_c.1\r\n", "h3 block = ${h3}")
  // `te: trailers` is the one TE value HTTP/2 allows; content-length is a
  // legal request field (the glue only drops it on the way OUT).
  assert(pfH2Fields("te", "trailers") != pfRefused, "te: trailers refused")
  assert(pfH2Fields("content-length", "5") != pfRefused, "content-length refused")
  assert(pfH2Fields("x-empty", "") != pfRefused, "an empty value refused")
}

test "peer fields: an h2 field named 'transfer-encoding ' is refused" {
  assert(pfH2Fields("transfer-encoding ", "chunked") == pfRefused, "trailing-space name served")
}

test "peer fields: an h2 value carrying a CRLF and a second field is refused" {
  assert(pfH2Fields("x-a", "b\r\nX: y") == pfRefused, "CRLF value served")
}

test "peer fields: h3 refuses the same fields h2 does" {
  assert(pfH3Fields("transfer-encoding ", "chunked") == pfRefused, "h3 trailing-space name served")
  assert(pfH3Fields("x-a", "b\r\nX: y") == pfRefused, "h3 CRLF value served")
}

test "peer fields: a name that is not a lower-case token is refused on both protocols" {
  let names = []string{ "", "Host", "x a", "x:a", ":path", ":foo", "x\r\ny", "x\x00", "xé" }
  for n of names {
    assert(pfH2Fields(n, "v") == pfRefused, "h2 served name '${n}'")
    assert(pfH3Fields(n, "v") == pfRefused, "h3 served name '${n}'")
  }
}

test "peer fields: a value with CR, LF or NUL is refused on both protocols" {
  let values = []string{ "a\rb", "a\nb", "a\x00b", "\r", "\n", "\x00" }
  for v of values {
    assert(pfH2Fields("x-a", v) == pfRefused, "h2 served value ${len(v)} bytes")
    assert(pfH3Fields("x-a", v) == pfRefused, "h3 served value ${len(v)} bytes")
  }
}

test "peer fields: connection-specific fields and a te other than trailers are refused" {
  let names = []string{
    "connection",
    "keep-alive",
    "proxy-connection",
    "transfer-encoding",
    "upgrade",
  }
  for n of names {
    assert(pfH2Fields(n, "x") == pfRefused, "h2 served ${n}")
    assert(pfH3Fields(n, "x") == pfRefused, "h3 served ${n}")
  }
  assert(pfH2Fields("te", "gzip") == pfRefused, "h2 served te: gzip")
  assert(pfH3Fields("te", "gzip") == pfRefused, "h3 served te: gzip")
}

test "peer fields: one bad field among good ones refuses the whole request" {
  let req = H2Request("GET", "example.com", "/")
  req.headers = []H2HeaderField{
    H2HeaderField{ name = "accept", value = "*/*", sensitive = false },
    H2HeaderField{ name = "x a", value = "v", sensitive = false },
  }
  let r = h2glueRequestIn(req, "") catch _ {
    return
  }
  assert(false, "request with a bad second field served: ${r.headers}")
}

test "peer fields: isTokenByte keeps its verdict on every byte after dropping the per-byte allocation" {
  // `isTokenByte` no longer builds a string per byte; every byte's verdict must be
  // what the `tokenExtraBytes` set says, so a table walk over all 256.
  let i = 0
  while (i < 256) {
    let c = byte(i)
    let want = (c >= 'a' && c <= 'z') ||
      (c >= 'A' && c <= 'Z') ||
      (c >= '0' && c <= '9') ||
      indexOf("!#$%&'*+-.^_`|~", string([]byte{ c })) >= 0
    assert(isTokenByte(c) == want, "isTokenByte(${i}) = ${isTokenByte(c)}, want ${want}")
    i = i + 1
  }
}
