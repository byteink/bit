// Bit standard library — http module: the client's idle-connection pool (#6453).
//
// Every request used to dial, send `Connection: close` and tear the socket
// down, so a loop of N requests to one host paid N TCP connects (and, for
// https, N TLS handshakes). Go's `http.Transport`, hyper and .NET's
// `SocketsHttpHandler` all keep a bounded list of idle connections per origin
// instead; this file is that list for HTTP/1.1, with the same three bounds. An
// origin that negotiates HTTP/2 needs no list: h2pool.bit keeps ONE connection
// for it and every request is a stream on it (#6465), under `maxH2Streams`.
//
//   maxIdlePerHost  idle connections kept per origin (Go's
//                   `MaxIdleConnsPerHost`, default 2).
//   maxIdleTotal    idle connections kept across every origin (Go's
//                   `MaxIdleConns`; 100). The oldest idle connection anywhere
//                   is closed to make room.
//   idleTimeoutMs   how long a connection may sit idle (Go's `IdleConnTimeout`,
//                   90 s). Expired connections are closed lazily, on the next
//                   `take`/`put` and by `closeAll`: there is no reaper thread,
//                   so an idle pool costs nothing, and the other two bounds are
//                   what cap what a quiet pool can hold.
//   maxConnsPerHost connections open at once to one origin, idle or in use
//                   (Go's `MaxConnsPerHost`; 0 = unlimited, the default). A
//                   request over it waits for a connection to come back or
//                   close, within its own deadline (`connPool.acquire`). It
//                   governs HTTP/1.1 only: an h2 origin carries many requests
//                   on one connection, so `maxH2Streams` is its cap, and a
//                   request that finds the origin speaks h2 gives its slot back.
//
// A `Client` owns one pool (`Client.setPool` sets the bounds). Every
// package-level call (`get`, `post`, `request`, `requestTimeout` and the Tls
// variants) shares `defaultPool`, one per process under the default
// `PoolLimits`, so a loop of plain `http.get` calls reuses its connections
// like a `Client` loop does (#6482). It is never retired: nothing owns it, and
// an idle connection costs a bounded slot (`maxIdleTotal`) until it expires.
//
// Safety, in order of how a pooled connection can go wrong:
//
//   framing     a connection is parked only when the response left it exactly
//               at a message boundary (`keepsAlive`): HTTP/1.1, no
//               `Connection: close`, a Content-Length or chunked body (or none
//               by status), and no bytes past the declared end. Read-to-EOF
//               and HTTP/1.0 responses close.
//   staleness   a server may close an idle connection at any moment, and the
//               client only finds out on the next use. A reused connection
//               that fails is retried once on a fresh one, but only for an
//               idempotent method (RFC 9110 §9.2.2): replaying a POST that may
//               have been processed is the duplicate-side-effect bug, so it
//               fails loudly instead.
//   identity    the idle list is keyed by scheme, host and port. A `Client`'s
//               pool needs no more: its config never changes. `defaultPool`
//               is shared by callers with different configs, so an https key
//               also carries `RequestExtras.scope` (`tlsScope`), a digest of
//               the whole config: two configs never share a connection, and a
//               pinned-roots caller can never be handed a connection that
//               `insecureSkipVerify` dialed.
//   deadlines   a pooled connection carries the deadline of the request using
//               it only (`setIdleDeadline`), cleared before it is parked, so
//               one request's timeout never kills the next one's connection.
//
// `Mutex`/`Mutex` are shutdown.bit's imports and `monotonic` is client.bit's
// (an import is per-module, SPEC §19).

// The bounds of a `Client`'s idle pool. Every field has a default, so
// `PoolLimits{}` is the complete configuration `Client()` uses.
export class PoolLimits {
  // Idle connections kept for one origin; 0 turns reuse off.
  export maxIdlePerHost: int = 2,
  // Idle connections kept across all origins; at least `maxIdlePerHost`.
  export maxIdleTotal: int = 100,
  // Milliseconds a connection may stay idle before it is closed instead of
  // reused; positive. Applies to HTTP/2 connections too, by time since their
  // last request finished.
  export idleTimeoutMs: int = 90000,
  // Most requests in flight at once on the one shared HTTP/2 connection per
  // origin (h2pool.bit); at least 1. The effective cap is the lower of this
  // and the peer's SETTINGS_MAX_CONCURRENT_STREAMS, and a request beyond it
  // waits for a stream to finish, within its own deadline.
  export maxH2Streams: int = 100,
  // Most HTTP/1.1 connections open at once to one origin, idle ones included;
  // 0 means no bound. A request over the cap waits for a connection to be
  // parked or closed, within its own deadline, and then fails naming this
  // field. Does not apply to HTTP/2, where `maxH2Streams` is the cap.
  export maxConnsPerHost: int = 0,
}

// Rejects a `PoolLimits` that is a mistake rather than guessing what was meant.
fn validatePoolLimits(l: PoolLimits): ()! {
  if (l.maxIdlePerHost < 0) {
    fail newError("PoolLimits.maxIdlePerHost is ${l.maxIdlePerHost}; use 0 to disable reuse")
  }
  if (l.maxIdleTotal < l.maxIdlePerHost) {
    fail newError("PoolLimits.maxIdleTotal ${l.maxIdleTotal} is below maxIdlePerHost ${l.maxIdlePerHost}")
  }
  if (l.idleTimeoutMs <= 0) {
    fail newError("PoolLimits.idleTimeoutMs is ${l.idleTimeoutMs}; it must be positive")
  }
  if (l.maxH2Streams < 1) {
    fail newError("PoolLimits.maxH2Streams is ${l.maxH2Streams}; it must be at least 1")
  }
  if (l.maxConnsPerHost < 0) {
    fail newError("PoolLimits.maxConnsPerHost is ${l.maxConnsPerHost}; use 0 for no limit")
  }
}

// One parked connection: `since` is the `monotonic` ns it went idle.
class idleConn {
  key: string,
  stream: byteStream,
  since: int,
}

// What `connPool.take` found.
enum Idle {
  Hit(byteStream),
  Miss,
}

// The slots of one origin under `maxConnsPerHost`: a counting semaphore with
// one token per request holding a connection, and how many requests hold or
// await one, so the entry is dropped when none do.
class connCap {
  key: string,
  tokens: chan<int>,
  users: int,
}

// One request's claim on its origin's `maxConnsPerHost` slot. `release` is
// idempotent, so a request that gives the slot back early (it found the origin
// speaks h2) and then unwinds through its `defer` releases once.
class connSlot {
  pool: connPool
  key: string
  held: bool

  release() {
    if (!this.held) {
      return
    }
    this.held = false
    this.pool.leaveCap(this.key, true)
  }
}

// Idle connections, oldest first. Every method locks `mu`; a request's green
// thread never holds it across I/O.
class connPool {
  limits: PoolLimits
  mu: Mutex
  idle: []idleConn
  closed: bool
  // Origins with a request holding or awaiting a `maxConnsPerHost` slot.
  caps: []connCap
  // The shared HTTP/2 connections (h2pool.bit), one per origin: an h2 origin
  // has no use for an idle list, its one connection carries every request.
  h2: h2Pool

  // The most recently parked live connection for `key` (LIFO: the one most
  // likely still open), or `Miss`. Expired connections are closed on the way.
  take(key: string, now: int): Idle {
    this.mu.lock()
    defer this.mu.unlock()
    this.pruneLocked(now)
    let i = len(this.idle) - 1
    while (i >= 0) {
      if (this.idle[i].key == key) {
        let s = this.idle[i].stream
        this.idle = withoutIdle(this.idle, i)
        return Idle.Hit(s)
      }
      i = i - 1
    }
    return Idle.Miss
  }

  // Parks `s` for `key`, or closes it when the pool is retired or the origin
  // already holds `maxIdlePerHost` (Go closes the newcomer too). At
  // `maxIdleTotal` the oldest idle connection anywhere makes room.
  put(key: string, s: byteStream, now: int) {
    this.mu.lock()
    defer this.mu.unlock()
    this.pruneLocked(now)
    if (this.closed || this.countLocked(key) >= this.limits.maxIdlePerHost) {
      s.shut()
      return
    }
    if (len(this.idle) >= this.limits.maxIdleTotal) {
      this.idle[0].stream.shut()
      this.idle = withoutIdle(this.idle, 0)
    }
    this.idle = append(this.idle, idleConn{ key = key, stream = s, since = now })
  }

  // Claims a slot for a request to `key`: at once when `maxConnsPerHost` is 0
  // or the origin is under it, else after a holder releases, but not past
  // `deadlineNs` (0 = no bound), or until `cancel` fires, which fails with
  // `Cancelled`. The caller must `release` the slot it got.
  acquire(key: string, deadlineNs: int, cancel: Option<Cancel>): connSlot! {
    let slot = connSlot{ pool = this, key = key, held = false }
    let limit = this.limits.maxConnsPerHost
    if (limit == 0) {
      return slot
    }
    let wake = chan<int>(1)
    let waitId = cancelWait(cancel, wake)
    let c = this.joinCap(key, limit)
    acquireToken(
      c.tokens,
      deadlineNs,
      wake,
      "http: timed out waiting for a free connection",
      "PoolLimits.maxConnsPerHost = ${limit} connections to ${key} already open",
    ) catch e {
      cancelUnwait(cancel, waitId)
      this.leaveCap(key, false)
      fail e
    }
    cancelUnwait(cancel, waitId)
    slot.held = true
    return slot
  }

  // The entry for `key`, made if absent, with one more user.
  joinCap(key: string, limit: int): connCap {
    this.mu.lock()
    defer this.mu.unlock()
    for old of this.caps {
      if (old.key == key) {
        old.users = old.users + 1
        return old
      }
    }
    let fresh = connCap{ key = key, tokens = chan<int>(limit), users = 1 }
    this.caps = append(this.caps, fresh)
    return fresh
  }

  // One user of `key` is done; `held` when it owned a token, which it gives
  // back. The last user removes the entry, so `caps` holds only live origins.
  leaveCap(key: string, held: bool) {
    this.mu.lock()
    defer this.mu.unlock()
    let keep = []connCap(0)
    for c of this.caps {
      if (c.key != key) {
        keep = append(keep, c)
        continue
      }
      if (held) {
        <- c.tokens
      }
      c.users = c.users - 1
      if (c.users > 0) {
        keep = append(keep, c)
      }
    }
    this.caps = keep
  }

  // Closes every connection idle now. The pool stays usable.
  closeAll() {
    this.h2.closeAll()
    this.mu.lock()
    defer this.mu.unlock()
    for c of this.idle {
      c.stream.shut()
    }
    this.idle = []idleConn(0)
  }

  // `closeAll`, and from now on every connection handed back is closed: the
  // pool's owner is gone, so nothing may park here and outlive it.
  retire() {
    this.h2.retire()
    this.closeAll()
    this.mu.lock()
    this.closed = true
    this.mu.unlock()
  }

  // Idle connections currently parked for `key`; caller holds `mu`.
  countLocked(key: string): int {
    let n = 0
    for c of this.idle {
      if (c.key == key) {
        n = n + 1
      }
    }
    return n
  }

  // Closes every connection idle longer than `idleTimeoutMs`; caller holds `mu`.
  pruneLocked(now: int) {
    let limit = this.limits.idleTimeoutMs * 1000000
    let keep = []idleConn(0)
    for c of this.idle {
      if (now - c.since < limit) {
        keep = append(keep, c)
      } else {
        c.stream.shut()
      }
    }
    this.idle = keep
  }
}

// `list` without element `at`, order kept. Bounded by the pool's own size.
fn withoutIdle(list: []idleConn, at: int): []idleConn {
  let out = []idleConn(0)
  let i = 0
  while (i < len(list)) {
    if (i != at) {
      out = append(out, list[i])
    }
    i = i + 1
  }
  return out
}

fn newConnPool(limits: PoolLimits): connPool {
  return connPool{
    limits = limits,
    mu = Mutex(),
    idle = []idleConn(0),
    closed = false,
    caps = []connCap(0),
    h2 = newH2Pool(limits),
  }
}

// One length-prefixed field of a config digest, so no two field lists hash alike.
fn scopeField(h: Sha256, b: []byte) {
  h.write([]byte("${len(b)}:"))
  h.write(b)
}

// A digest of every field of `cfg` that changes who a connection trusts or how
// it was dialed: the roots (each certificate's DER), `insecureSkipVerify`,
// `alpn`, `serverName` and `nowUnix`. It is `RequestExtras.scope` for a
// `requestTls` call, the part of a `defaultPool` key that keeps one config's
// connection from serving another.
fn tlsScope(cfg: TlsConfig): string {
  let h = Sha256()
  scopeField(h, []byte("${len(cfg.roots.roots)}|${len(cfg.alpn)}"))
  for c of cfg.roots.roots {
    scopeField(h, c.raw)
  }
  scopeField(
    h,
    []byte("${cfg.insecureSkipVerify}|${cfg.serverName}|${cfg.nowUnix}"),
  )
  for a of cfg.alpn {
    scopeField(h, []byte(a))
  }
  return encodeHex(h.sum())
}

// The pool every package-level call shares (#6482), built at startup before
// `main` (SPEC §11.11). Safe for concurrent tasks because every `connPool` and
// `h2Pool` method locks its own `mu` and no request holds one across I/O.
const defaultPool: connPool = newConnPool(PoolLimits{})

// ---------------------------------------------------------------------------
// Reading a response, and deciding whether its connection can be reused
// ---------------------------------------------------------------------------

// Whether a response to `method` with `status` carries no body whatever its
// framing headers say (RFC 9112 §6.3): HEAD, 1xx, 204 and 304.
fn bodyless(method: string, status: int): bool {
  if (method == "HEAD" || status == 204 || status == 304) {
    return true
  }
  return status >= 100 && status < 200
}

// Whether any `Connection` field of `headers` carries the `close` option. Every
// field is read, not the first: `Connection: keep-alive` then `Connection:
// close` closes (RFC 9110 §7.6.1), and a connection parked on the first one
// would be reused after the server said it was done.
fn connectionCloses(headers: string): bool {
  let at = headerLineStart(headers, "connection")
  let seen = 0
  while (at >= 0 && seen < len(headers)) {
    seen = seen + 1
    if (indexOf(toLower(fieldValue(headers, at, "connection")), "close") >= 0) {
      return true
    }
    at = nextFieldLine(headers, at, "connection")
  }
  return false
}

// Whether the connection a response came off is still at a message boundary
// and may carry another request. `bodyStart` is what arrived with the headers
// beyond them: more than the declared body means the peer sent something the
// client did not ask for, and the next response would be read behind it.
fn keepsAlive(
  statusLine: string,
  headers: string,
  method: string,
  status: int,
  bodyStart: string,
): bool {
  if (!hasPrefix(statusLine, "HTTP/1.1") || status < 200) {
    return false
  }
  if (connectionCloses(headers)) {
    return false
  }
  if (bodyless(method, status)) {
    return len(bodyStart) == 0
  }
  if (len(header(headers, "transfer-encoding")) > 0) {
    return true
  }
  let cl = atoi(header(headers, "content-length"))
  return cl >= 0 && len(bodyStart) <= cl
}

// One response to a request that used `method`, framed per
// `readResponseBody` (client.bit), and whether its connection may be parked.
fn readResponseKeep(s: byteStream, method: string, maxBodyBytes: int): (Response, bool)! {
  let (headBlock, bodyStart) = readUntil(s, "", "\r\n\r\n")?

  let eol = indexOf(headBlock, "\r\n")
  let statusLine = headBlock
  let headers = ""
  if (eol >= 0) {
    statusLine = headBlock[0:eol]
    headers = headBlock[eol + 2:len(headBlock)]
  }
  let code = parseStatusCode(statusLine)?
  let body = ""
  if (!bodyless(method, code)) {
    body = readResponseBody(s, bodyStart, headers, method, maxBodyBytes)?
  }
  let res = Response{
    status = code,
    contentType = header(headers, "content-type"),
    headers = headers,
    body = body,
  }
  return res, keepsAlive(statusLine, headers, method, code, bodyStart)
}

// ---------------------------------------------------------------------------
// One exchange through the pool
// ---------------------------------------------------------------------------

// RFC 9110 §9.2.2: methods whose repetition has the same effect as one.
fn isIdempotent(method: string): bool {
  return method == "GET" ||
    method == "HEAD" ||
    method == "OPTIONS" ||
    method == "TRACE" ||
    method == "PUT" ||
    method == "DELETE"
}

// The idle-list key of `u`'s origin under `extras`: scheme, host and port, and
// for an https origin the TLS scope of the config the connection is dialed
// with ("" for a `Client`, whose pool has one config).
fn poolKey(u: Url, extras: RequestExtras): string {
  let origin = "${schemeName(u)}://${hostHeaderValue(u)}"
  if (u.https && len(extras.scope) > 0) {
    return "${origin}#${extras.scope}"
  }
  return origin
}

// `method u` over HTTP/1.1 or, when an https origin negotiates it, h2: the
// origin's shared h2 connection or a parked HTTP/1.1 one when the pool has one,
// else a fresh dial. An HTTP/1.1 connection costs a `maxConnsPerHost` slot for
// the exchange; an h2 stream does not (`maxH2Streams` bounds those). A reused connection that fails is retried once on a fresh
// one for an idempotent method only; a POST fails with the error it got, a
// `RequestError` whose `sent` says whether the server may have the request.
fn exchangeOrigin(method: string, u: Url, body: Body, extras: RequestExtras): Response! {
  if (u.https) {
    match (extras.pool.h2.take(poolKey(u, extras), monotonic().ns)) {
      Shared(e) => return reuseH2(e, method, u, body, extras)?
      None => return exchangeParked(method, u, body, extras)?
    }
  }
  return exchangeParked(method, u, body, extras)?
}

// `exchangeOrigin` for a request whose origin has a live shared h2 connection
// `e` (reference held for the caller): a stream on it, retried once on a fresh
// connection when the stream failed and `method` may be repeated.
fn reuseH2(e: h2Entry, method: string, u: Url, body: Body, extras: RequestExtras): Response! {
  let res = runH2(e, method, u, body, extras) catch err {
    if (!isIdempotent(method) || isCancelled(err)) {
      fail err
    }
    return exchangeCapped(method, u, body, extras) catch again {
      fail afterSent(again)
    }
  }
  return res
}

// `exchangeFresh` for a caller that holds no slot yet: claims one for the
// exchange, which hands it back before a stream starts if the origin is h2.
fn exchangeCapped(method: string, u: Url, body: Body, extras: RequestExtras): Response! {
  let slot = extras.pool.acquire(poolKey(u, extras), extras.deadline, extras.cancel) catch e {
    fail unsentError(e)
  }
  defer slot.release()
  return exchangeFresh(method, u, body, extras, slot)?
}

// The HTTP/1.1 half of `exchangeOrigin`: a parked connection, else a dial. The
// slot is claimed before the idle list is read, so a request that waited finds
// the connection whose return woke it.
fn exchangeParked(method: string, u: Url, body: Body, extras: RequestExtras): Response! {
  let key = poolKey(u, extras)
  let slot = extras.pool.acquire(key, extras.deadline, extras.cancel) catch e {
    fail unsentError(e)
  }
  defer slot.release()
  match (extras.pool.take(key, monotonic().ns)) {
    Hit(s) => {
      let (res, keep) = sendOn(s, u, method, body, extras) catch e {
        if (!isIdempotent(method)) {
          fail e
        }
        return exchangeFresh(method, u, body, extras, slot) catch again {
          fail afterSent(again)
        }
      }
      parkOrShut(s, key, keep, extras)
      return res
    }
    Miss => return exchangeFresh(method, u, body, extras, slot)?
  }
}

// `method u` on a connection dialed now, bounded by `extras.deadline` when set.
// `slot` is the caller's `maxConnsPerHost` claim, released here when the dial
// turns out to reach an h2 origin.
fn exchangeFresh(
  method: string,
  u: Url,
  body: Body,
  extras: RequestExtras,
  slot: connSlot,
): Response! {
  if (!u.https) {
    let s = dialPlain(u, extras) catch e {
      fail unsentError(e)
    }
    return runOn(s, u, method, body, extras)?
  }
  let d = dialOrigin(poolKey(u, extras), u, extras) catch e {
    fail unsentError(e)
  }
  match (d) {
    Shared(e) => {
      slot.release()
      return runH2(e, method, u, body, extras)?
    }
    Plain(tc) => { return runOn(tlsStream{ conn = tc }, u, method, body, extras)? }
  }
}

// A cleartext connection to `u`'s origin, bounded by `extras.deadline` and by
// the request's `Cancel` when it has one.
fn dialPlain(u: Url, extras: RequestExtras): byteStream! {
  match (extras.cancel) {
    Some(tok) => { return dialCancellable(u, extras.config, tok, extras.deadline)? }
    None => { return netStream{ conn = dialConn(u, extras.deadline)? } }
  }
}

fn dialConn(u: Url, deadline: int): Conn! {
  if (deadline == 0) {
    return dial(u.host, u.port)?
  }
  return dialDeadline(u.host, u.port, deadline)?
}

fn dialTlsConn(u: Url, cfg: TlsConfig, deadline: int): TlsConn! {
  if (deadline == 0) {
    return tlsDial(u.host, u.port, cfg)?
  }
  return tlsDialDeadline(u.host, u.port, cfg, deadline)?
}

// `sendOn` then `parkOrShut`, for a connection dialed for this request: one
// with no pool key in hand yet.
fn runOn(s: byteStream, u: Url, method: string, body: Body, extras: RequestExtras): Response! {
  let (res, keep) = sendOn(s, u, method, body, extras)?
  parkOrShut(s, poolKey(u, extras), keep, extras)
  return res
}

// Writes `method u` with `body` on `s` and reads the response, both bounded by
// `extras.deadline`. `s` is closed when either fails, so a failed or timed-out
// exchange never leaks the socket; the bool says whether `s` can carry another
// request, for `parkOrShut`.
fn sendOn(
  s: byteStream,
  u: Url,
  method: string,
  body: Body,
  extras: RequestExtras,
): (Response, bool)! {
  let req = buildRequest(method, u, extras.block, body, false)
  s.setIdleDeadline(extras.deadline)
  let w = watchOf(extras.cancel)
  w.attach(s) catch e {
    s.shut()
    fail unsentError(e)
  }
  let r = exchangeKeep(s, req, body, method, extras.maxBody) catch e {
    let hit = w.release()
    s.shut()
    if (hit) {
      fail sentError(Cancelled{ op = "send" })
    }
    fail sentError(e)
  }
  // A cancel shuts the connection, which a body read to the connection's close
  // takes for the end of the body; the whole response is dropped instead.
  if (w.release()) {
    s.shut()
    fail sentError(Cancelled{ op = "send" })
  }
  return r
}

// Parks `s` in `extras.pool` under the origin's `key`, its deadline cleared,
// when `keep` says it can carry another request; closes it otherwise.
fn parkOrShut(s: byteStream, key: string, keep: bool, extras: RequestExtras) {
  if (!keep) {
    s.shut()
    return
  }
  s.setIdleDeadline(0)
  extras.pool.put(key, s, monotonic().ns)
}

fn exchangeKeep(
  s: byteStream,
  req: string,
  body: Body,
  method: string,
  maxBody: int,
): (Response, bool)! {
  writeRequest(s, req, body)?
  let r = readResponseKeep(s, method, maxBody)?
  return r
}
