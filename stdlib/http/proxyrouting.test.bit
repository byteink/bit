import { x509Parse as routingParseCert } from "std/crypto"

fn routingMode(): string {
  match (lookupEnv("BIT_PROXY_CONTROL")) {
    Some(mode) => return mode
    None => return ""
  }
}

test "proxy-only headers cannot reach a destination (#8743)" {
  let block = "X-Draft: yes\r\npRoXy-AuThOrIzAtIoN: Basic caller\r\n"
  let extras = newRequestExtras(defaultClientConfig(), block, "")
  assert(header(extras.block, "proxy-authorization") == "")
  let c = Client()
  defer c.close()
  assert(header(c.extrasWith(block).block, "proxy-authorization") == "")
  let u = Url{ host = "origin.example", port = 443, path = "/draft", https = true }
  let (target, clean) = proxyRequestParts(u, block) catch e {
    panic(e.message())
  }
  assert(target == "/draft" && header(clean, "proxy-authorization") == "")
  assert(header(clean, "x-draft") == "yes")
}

fn routingForward(conn: Conn, count: int, location: string): string! {
  assert(count > 0 && count <= 2)
  let s = netStream{ conn = conn }
  let seen = Builder()
  for (let i = 0; i < count; i = i + 1) {
    let head = proxyReadConnectHead(s)?
    seen.write(head + "\r\n\r\n")
    let length = atoi(header(head, "content-length"))
    if (length > 0) {
      assert(length == 5, "unexpected request body length")
      let body = readContentLengthBody(s, "", length)?
      assert(body == "abcde", "proxy did not receive streamed request bytes")
    }
    let reply = "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n"
    if (len(location) > 0) {
      reply = "HTTP/1.1 302 Found\r\nContent-Length: 0\r\nLocation: ${location}\r\n"
    }
    if (count == 1) {
      reply = reply + "Connection: close\r\n"
    }
    reply = reply + "\r\n"
    if (len(location) == 0) {
      reply = reply + "ok"
    }
    s.writeStr(reply)?
  }
  return seen.toString()
}

fn routingForwardJob(l: Listener, count: int, location: string, out: chan<string>) {
  let conn = l.accept() catch e {
    out <- "ERROR: ${e.message()}"
    return
  }
  defer conn.close()
  conn.setDeadline(monotonic().ns + 4 * Second)
  let seen = routingForward(conn, count, location) catch e {
    out <- "ERROR: ${e.message()}"
    return
  }
  conn.close()
  out <- seen
}

fn routingCall(mode: string, url: string, c: Client): Response! {
  if (mode == "package") {
    return get(url)?
  }
  if (mode == "timeout") {
    return getTimeout(url, 3000)?
  }
  if (mode == "reader") {
    let res = c.send(ClientRequest{ url = url, timeoutMs = 3000 }, true)?
    let reader = readerOf(res)?
    defer reader.close()
    assert(drain(reader, 2)? == "ok")
    return res
  }
  if (mode == "download") {
    let sink = capturingSink{ parts = []string(0) }
    let res = getStreaming(url, []Header(0), sinkInto(sink), 100, 3000)?
    assert(joinParts(sink) == "ok")
    return res
  }
  if (mode == "upload") {
    let body = StreamBody{ source = patternSource(5, 5), length = Option.Some(5) }
    return requestWithStreamingBody("PUT", url, []Header(0), body, 3000)?
  }
  return c.getTimeout(url, 3000)?
}

fn routingProxyListener(https: bool): Listener! {
  let p = proxyHttpEndpoint(Url{ host = "127.0.0.2", https = https })?
  return listen(p.url.host, p.url.port)?
}

fn routingHttpControl(mode: string): ()! {
  let l = routingProxyListener(false)?
  defer l.close()
  let out = chan<string>(1)
  let count = mode == "pool" ? 2 : 1
  spawn routingForwardJob(l, count, "", out)
  let c = Client()
  defer c.close()
  c.setHeader("Proxy-Authorization", "Basic caller")?
  let url = "http://127.0.0.2:1/draft?published=no"
  let res = routingCall(mode, url, c)?
  assert(res.status == 200)
  if (count == 2) {
    let second = c.getTimeout(url, 3000)?
    assert(second.body == "ok")
  }
  c.close()
  let seen = <- out
  assert(hasPrefix(seen, mode == "upload" ? "PUT http://" : "GET http://"), seen)
  assert(indexOf(seen, "http://127.0.0.2:1/draft?published=no HTTP/1.1") >= 0, seen)
  assert(header(seen, "host") == "127.0.0.2:1", seen)
  assert(header(seen, "proxy-authorization") == "Basic dXNlcjpwYXNz", seen)
  let u = parseUrl(url)?
  let key = poolKey(u, c.extrasWith(""))
  assert(indexOf(key, "#proxy=") > 0 && indexOf(key, "user:pass") < 0)
}

fn routingDirectJob(l: Listener, out: chan<string>) {
  let c = l.accept() catch e {
    out <- "ERROR: ${e.message()}"
    return
  }
  defer c.close()
  c.setDeadline(monotonic().ns + 4 * Second)
  let head = proxyReadConnectHead(netStream{ conn = c }) catch e {
    out <- "ERROR: ${e.message()}"
    return
  }
  c.writeDeadline("HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok") catch e {
    out <- "ERROR: ${e.message()}"
    return
  }
  c.close()
  out <- head
}

fn routingRedirectControl(): ()! {
  let origin = listen("127.0.0.1", 0)?
  defer origin.close()
  let direct = chan<string>(1)
  spawn routingDirectJob(origin, direct)
  let destination = "http://127.0.0.1:${origin.port()?}/next"
  let l = routingProxyListener(false)?
  defer l.close()
  let forwarded = chan<string>(1)
  spawn routingForwardJob(l, 1, destination, forwarded)
  let res = getTimeout("http://127.0.0.2:1/start", 3000)?
  assert(res.body == "ok")
  assert(hasPrefix(<- forwarded, "GET http://127.0.0.2:1/start HTTP/1.1"))
  let head = <- direct
  assert(hasPrefix(head, "GET /next HTTP/1.1"), head)
  assert(header(head, "proxy-authorization") == "", head)
}

fn routingPump(a: Conn, b: Conn, done: chan<bool>) {
  for (let i = 0; i < 256; i = i + 1) {
    let bytes = a.readDeadline(4096) catch _ {
      break
    }
    if (len(bytes) == 0) {
      break
    }
    b.writeDeadline(bytes) catch _ {
      break
    }
  }
  a.shutdown()
  b.shutdown()
  done <- true
}

fn routingTunnelJob(l: Listener, originPort: int, out: chan<string>) {
  let c = l.accept() catch e {
    out <- "ERROR: ${e.message()}"
    return
  }
  defer c.close()
  c.setDeadline(monotonic().ns + 4 * Second)
  let head = proxyReadConnectHead(netStream{ conn = c }) catch e {
    out <- "ERROR: ${e.message()}"
    return
  }
  let upstream = dialDeadline("127.0.0.1", originPort, monotonic().ns + 4 * Second) catch e {
    out <- "ERROR: ${e.message()}"
    return
  }
  defer upstream.close()
  c.writeDeadline("HTTP/1.1 200 Connection Established\r\n\r\n") catch e {
    out <- "ERROR: ${e.message()}"
    return
  }
  let done = chan<bool>(2)
  spawn routingPump(c, upstream, done)
  routingPump(upstream, c, done)
  let _ = <- done
  let _ = <- done
  upstream.close()
  c.close()
  out <- head
}

fn routingTlsHandler(req: Request): Response {
  assert(header(req.headers, "proxy-authorization") == "", "proxy credential reached origin")
  return ok("verified")
}

fn routingServeTls(ts: TlsServer) {
  serveTlsServerOn(ts, routingTlsHandler) catch _ {
    return
  }
}

fn routingStopTls(ts: TlsServer) {
  ts.shutdown(2000) catch e {
    panic(e.message())
  }
}

fn routingStartTls(): TlsServer! {
  let ts = tlsServe(
    "127.0.0.1",
    0,
    tls5916Pem("CERTIFICATE", routingIpHex),
    tls5916Pem("PRIVATE KEY", routingKeyHex),
  )?
  spawn routingServeTls(ts)
  return ts
}

fn routingVerifiedConfig(): TlsConfig! {
  let root = routingParseCert(decodeHex(routingCaHex)?)?
  return TlsConfig(TlsTrustStore{ roots = [root] }, nowUnix = 1800000000, alpn = ["http/1.1"])
}

fn routingDirectTlsControl(): ()! {
  let ts = routingStartTls()?
  defer routingStopTls(ts)
  let c = Client(tls = routingVerifiedConfig()?)
  defer c.close()
  let url = "https://127.0.0.1:${ts.port()?}/draft"
  assert(!proxyActive(parseUrl(url)?), "empty lowercase HTTPS proxy did not disable uppercase")
  let res = c.getTimeout(url, 3000)?
  assert(res.body == "verified")
}

fn routingTlsBody(mode: string, url: string, c: Client): string! {
  if (mode == "tls-reader") {
    let res = c.send(ClientRequest{ url = url, timeoutMs = 3000 }, true)?
    let reader = readerOf(res)?
    defer reader.close()
    return drain(reader, 3)?
  }
  let res = c.getTimeout(url, 3000)?
  return res.body
}

fn routingTlsControl(mode: string): ()! {
  let ts = routingStartTls()?
  defer routingStopTls(ts)
  let l = routingProxyListener(true)?
  defer l.close()
  let out = chan<string>(1)
  let port = ts.port()?
  spawn routingTunnelJob(l, port, out)
  let root = routingParseCert(decodeHex(routingCaHex)?)?
  let roots = TlsTrustStore{ roots = [root] }
  if (mode == "wrong-root") {
    roots = emptyTrustStore()
  }
  let cfg = TlsConfig(roots, nowUnix = 1800000000, alpn = [mode == "h2" ? "h2" : "http/1.1"])
  if (mode == "wrong-name") {
    cfg.serverName = "inkwell.invalid"
  }
  let c = Client(tls = cfg)
  defer c.close()
  c.setHeader("Proxy-Authorization", "Basic caller")?
  c.h3Ports["127.0.0.1:${port}"] = 1
  let body = routingTlsBody(mode, "https://127.0.0.1:${port}/draft", c) catch e {
    c.close()
    assert(mode == "wrong-root" || mode == "wrong-name", e.message())
    let expected = mode == "wrong-root" ? "unable to build chain to a trusted root" : "certificate is not valid for hostname inkwell.invalid"
    assert(indexOf(e.message(), expected) >= 0, e.message())
    let head = <- out
    assert(hasPrefix(head, "CONNECT 127.0.0.1:${port} HTTP/1.1"), head)
    return
  }
  assert(mode != "wrong-root" && mode != "wrong-name", "untrusted destination accepted")
  assert(body == "verified")
  c.close()
  let head = <- out
  assert(hasPrefix(head, "CONNECT 127.0.0.1:${port} HTTP/1.1"), head)
  assert(header(head, "proxy-authorization") == "Basic dXNlcjpwYXNz", head)
}

fn routingExplicitH3(): ()! {
  let c = Client()
  defer c.close()
  let _ = c.getTimeout("https+h3://127.0.0.2:1/draft", 3000) catch e {
    assert(indexOf(e.message(), "UDP proxy transport") >= 0, e.message())
    return
  }
  assert(false, "explicit HTTP/3 bypassed its proxy")
}

fn routingStallJob(l: Listener, ready: chan<string>, release: chan<bool>, done: chan<bool>) {
  let c = l.accept() catch e {
    ready <- "ERROR: ${e.message()}"
    return
  }
  defer c.close()
  c.setDeadline(monotonic().ns + 4 * Second)
  let head = proxyReadConnectHead(netStream{ conn = c }) catch e {
    ready <- "ERROR: ${e.message()}"
    return
  }
  ready <- head
  let _ = <- release
  c.close()
  done <- true
}

fn routingIsTimeout(e: error): bool {
  let (_, bare) = e.(TimeoutError)
  if (bare) {
    return true
  }
  let (r, wrapped) = e.(RequestError)
  if (!wrapped) {
    return false
  }
  let (_, inner) = r.cause.(TimeoutError)
  return inner
}

fn routingBlockedCall(c: Client, req: ClientRequest, cancel: bool, result: chan<bool>) {
  let res = c.send(req, true) catch e {
    result <- cancel ? isCancelled(e) : routingIsTimeout(e)
    return
  }
  match (res.reader) {
    Some(reader) => { reader.close() }
    None => {}
  }
  result <- false
}

fn routingBlockedControl(mode: string): ()! {
  let l = routingProxyListener(true)?
  defer l.close()
  let ready = chan<string>(1)
  let release = chan<bool>(1)
  let done = chan<bool>(1)
  spawn routingStallJob(l, ready, release, done)
  let c = Client()
  defer c.close()
  let tok = Cancel()
  let req = ClientRequest{ url = "https://127.0.0.2:1/draft", timeoutMs = 1000 }
  if (mode == "cancel") {
    req.timeoutMs = 3000
    req.cancel = Option.Some(tok)
  }
  let result = chan<bool>(1)
  spawn routingBlockedCall(c, req, mode == "cancel", result)
  let head = <- ready
  assert(hasPrefix(head, "CONNECT 127.0.0.2:1 HTTP/1.1"), head)
  let at = AtomicI64(0)
  if (mode == "cancel") {
    at.store(monotonic().ns)
    tok.cancel()
  }
  let classified = <- result
  if (mode == "cancel") {
    assertWithin(at, "proxy CONNECT cancellation")
  }
  release <- true
  let _ = <- done
  assert(classified, "CONNECT did not preserve its cancellation/deadline cause")
}

fn routingDirectControl(): ()! {
  let origin = listen("127.0.0.1", 0)?
  defer origin.close()
  let out = chan<string>(1)
  spawn routingDirectJob(origin, out)
  let url = "http://127.0.0.1:${origin.port()?}/draft"
  assert(!proxyActive(parseUrl(url)?), "direct control unexpectedly selected a proxy")
  let res = getTimeout(url, 3000)?
  assert(res.body == "ok")
  let head = <- out
  assert(hasPrefix(head, "GET /draft HTTP/1.1"), head)
  assert(header(head, "proxy-authorization") == "", head)
}

fn routingUnsupportedTlsProxy(): ()! {
  let _ = getTimeout("http://127.0.0.2:1/draft", 3000) catch e {
    assert(indexOf(e.message(), "TLS proxy transport is not available") >= 0, e.message())
    return
  }
  assert(false, "TLS proxy endpoint silently dialed origin")
}

fn routingControl(mode: string): ()! {
  if (mode == "tls-direct") {
    routingDirectTlsControl()?
    return
  }
  if (mode == "direct") {
    routingDirectControl()?
    return
  }
  if (mode == "https-proxy") {
    routingUnsupportedTlsProxy()?
    return
  }
  routingRoutedControl(mode)?
}

fn routingRoutedControl(mode: string): ()! {
  if (mode == "cancel" || mode == "deadline") {
    routingBlockedControl(mode)?
    return
  }
  if (mode == "redirect") {
    routingRedirectControl()?
    return
  }
  if (mode == "tls" ||
    mode == "h2" ||
    mode == "tls-reader" ||
    mode == "wrong-root" ||
    mode == "wrong-name") {
    routingTlsControl(mode)?
    return
  }
  if (mode == "explicit-h3") {
    routingExplicitH3()?
    return
  }
  routingHttpControl(mode)?
}

test "public proxy subprocess control (#8743)" {
  let mode = routingMode()
  if (len(mode) == 0) {
    return
  }
  routingControl(mode) catch e {
    panic(e.message())
  }
}

// Fixed test CA keeps destination chain and IP identity verification enabled.
const routingCaHex: string = ""
const routingIpHex: string = ""
const routingKeyHex: string = ""
