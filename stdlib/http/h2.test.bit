// stdlib/http/h2.test.bit — the body budget crossing into the HTTP/2 engine
// (#4590).
//
// `h2glueConfig` is the whole of the plumbing that makes one `setMaxBodyBytes`
// bound both protocols: `h2glueServe` builds the server engine's config from
// `opts.maxBody` and `h2clientExchange` builds the client's from
// `extras.maxBody`. Neither can be driven from a unit test — both take a live
// `TlsConn` and an ALPN-negotiated peer, which is `_tests_/imports/http2e2e`'s
// job — so what is checked here is the part that can be: that the mapper is not
// a no-op, and that the two 32 MiB constants have not drifted apart.
//
// `h2defaultConfig`, `h2glueConfig` and `defaultMaxBodyBytes` are siblings or
// module-wide imports (SPEC §19), so nothing is imported here.

test "the http2 engine's default body budget is the number std/http defaults to" {
  // `std/http2` spells 32 MiB out again (`h2connDefaultMaxBodyBytes`,
  // stdlib/http2/conn.bit) because `std/http` imports `std/http2` and the
  // reverse import would be a cycle. A duplicated constant is a constant that
  // can drift, and a drift would silently give an h2 exchange a different
  // budget from the HTTP/1.1 one on the same listener. This is the check that
  // it has not.
  let cfg = h2defaultConfig()
  assert(
    cfg.maxBodyBytes == defaultMaxBodyBytes,
    "http2 default ${cfg.maxBodyBytes} != std/http default ${defaultMaxBodyBytes}",
  )
}

test "h2glueConfig carries the caller's budget into the http2 engine config" {
  // A no-op mapper — one that returned `h2defaultConfig()` and dropped its
  // argument — would leave every h2 exchange on the 32 MiB default however the
  // server or client was configured, and nothing else in this module would
  // notice.
  let cfg = h2glueConfig(64)
  assert(cfg.maxBodyBytes == 64, "maxBodyBytes = ${cfg.maxBodyBytes}, want 64")
  // Everything else stays the RFC default: this sets a budget, not a profile.
  let rfc = h2defaultConfig()
  assert(
    cfg.initialWindowSize == rfc.initialWindowSize && cfg.maxFrameSize == rfc.maxFrameSize,
    "h2glueConfig changed a SETTINGS parameter it should not touch",
  )
}
