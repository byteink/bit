// stdlib/http/headerend.test.bit — `headerEndIn` (message.bit, #6002).
//
// `readThroughHeaderEnd` finds the header terminator with `headerEndIn`
// instead of `indexOf(block, "\r\n\r\n")`, so the two must agree on every
// input. A sibling file rather than more of message.test.bit, which is near
// the 800-line ceiling; `indexOf` and `repeat` are module-wide imports.

// `k` as `n` base-3 digits over CR, LF and 'a', least significant first.
fn crlfWord(k: int, n: int): string {
  let alpha = "\r\na"
  let b = Builder()
  let r = k
  let p = 0
  while (p < n) {
    let d = r % 3
    b.write(alpha[d:d + 1])
    r = r / 3
    p = p + 1
  }
  return b.toString()
}

// Every string of length 0 to 8 over CR, LF and one other byte: each of the
// skip table's three shifts from every alignment, every partial terminator
// overlapping the next, and windows that end on the block's last byte.
test "headerEndIn agrees with indexOf on all 9,841 strings over CR, LF and 'a' up to 8 bytes" {
  let count = 0
  let total = 1
  let n = 0
  while (n <= 8) {
    let k = 0
    while (k < total) {
      let s = crlfWord(k, n)
      let got = headerEndIn(s)
      let want = indexOf(s, "\r\n\r\n")
      assert(got == want, "n ${n} k ${k}: ${got}, want ${want}")
      count = count + 1
      k = k + 1
    }
    total = total * 3
    n = n + 1
  }
  assert(count == 9841, "checked ${count} strings")
}

test "headerEndIn returns the first terminator at the offsets readThroughHeaderEnd sees" {
  assert(headerEndIn("\r\n\r\n") == 0, "bare terminator")
  assert(headerEndIn("\r\r\n\r\n") == 1, "CR before the terminator")
  assert(headerEndIn("\n\r\n\r\n") == 1, "LF before the terminator")
  assert(headerEndIn("") == -1 && headerEndIn("\r\n\r") == -1, "too short")
  let get = "GET / HTTP/1.1\r\n\r\n"
  assert(headerEndIn(get + get) == 14, "pipelined pair: ${headerEndIn(get + get)}")
  // The shape of one oha request: a request line and three short fields,
  // padded to the 128-byte block the profile in #6001 measured.
  let head = "GET / HTTP/1.1\r\nhost: 127.0.0.1:8080\r\naccept: */*\r\nuser-agent: oha/1.16.0\r\n"
  let block = head + "x-pad: " + repeat("p", 128 - len(head) - 11) + "\r\n\r\n"
  assert(len(block) == 128, "block is ${len(block)} bytes")
  assert(headerEndIn(block) == 124, "oha block: ${headerEndIn(block)}")
}
