// Bit standard library — http module: request header validation and wire
// serialization (#2290).
//
// `header(block, name)` (http.bit) only READS a raw header block; nothing in
// this module let a caller ATTACH one to an outgoing request. `Header` and
// `serializeHeaders` are the write side: a name/value pair, and the function
// that turns a validated list of them into the same raw "Name: value\r\n"
// block `header()` already reads. Every request-header entry point this
// module adds — `Client.setHeader`, `requestWith`, `Client.requestWith`
// (client.bit) — funnels through `serializeHeaders`, so there is exactly one
// place a bad header can be rejected, not one copy per call site.
//
// The byte-level name/value checks themselves are NOT reimplemented here:
// #2179 (Response.setHeader/addHeader, http.bit) landed the RFC 9110 token
// and CR/LF/NUL checks first, as `validHeaderName`/`hasForbiddenValueByte`.
// `validateHeaderName`/`validateHeaderValue` below are thin `!`-returning
// wrappers around those, so a header is validated identically whether it is
// going out on a request or coming back on a response.

// One request header: a caller-supplied name and value, validated before it
// ever reaches the wire.
export class Header { name: string, value: string }

// Fails unless `name` is a non-empty RFC 9110 §5.6.2 `token`. Reuses
// `validHeaderName` (http.bit, #2179) rather than re-implementing the same
// byte check on this side of the module — #2179 landed first, so this is the
// request-side wrapper around its validator, not a second copy of it.
export fn validateHeaderName(name: string): ()! {
  if (!validHeaderName(name)) {
    fail newError("header name \"${name}\" is not a valid RFC 9110 token")
  }
}

// Fails if `value` contains a raw CR, LF or NUL (RFC 9110 §5.5) — the
// request-side twin of #2169's response-header injection, and, since #2179
// landed first, a wrapper around the SAME check `Response.setHeader`/
// `addHeader` already run on the response side (`hasForbiddenValueByte`,
// http.bit), not a second implementation of it.
export fn validateHeaderValue(value: string): ()! {
  if (hasForbiddenValueByte(value)) {
    fail newError("header value contains a raw CR, LF or NUL byte")
  }
}

// Header names this module manages itself and never lets a caller set:
// `Host`/`Connection`/`Content-Length`/`Transfer-Encoding` (framing, decided
// per request by `buildRequest`/the h2/h3 glue — the same set
// `h2glueHopByHop`/`h3glueHopByHop` already strip on the response path),
// `Keep-Alive`/`Proxy-Connection`/`Upgrade` (connection-specific, meaningless
// on this module's one-request-per-connection model), and `Accept-Encoding`.
//
// ACCEPT-ENCODING, DECIDED (#2290): there is no compression module anywhere in
// this stdlib — no gzip/flate/zlib/compress (`bit doc` over the whole stdlib
// tree lists none). The client sends no `Accept-Encoding` today, so a
// conforming server never compresses and `Response.body` is always exactly
// what the server sent. The moment a caller could write
// `Accept-Encoding: gzip` by hand, a conforming server WOULD compress, and
// `Response.body` would silently become a gzip stream nothing here can
// inflate — a body-corruption bug the day this ships, not a missing
// convenience. Rejecting it here is the whole fix: it stays unsettable until
// a decoder exists, rather than shipping a decoder-less content-coding
// request.
fn isReservedRequestHeader(nameLower: string): bool {
  return nameLower == "host" ||
    nameLower == "connection" ||
    nameLower == "content-length" ||
    nameLower == "transfer-encoding" ||
    nameLower == "keep-alive" ||
    nameLower == "proxy-connection" ||
    nameLower == "upgrade" ||
    nameLower == "accept-encoding"
}

// Fails unless `h` is safe and permitted to send: a valid name, a value with
// no raw CR/LF/NUL, and not one of `isReservedRequestHeader`'s names.
fn validateHeader(h: Header): ()! {
  validateHeaderName(h.name)?
  validateHeaderValue(h.value)?
  if (isReservedRequestHeader(toLower(h.name))) {
    fail newError("header \"${h.name}\" is managed by std/http and cannot be set")
  }
}

// Validates every entry of `headers` and serializes them into one raw
// "Name: value\r\n"-per-line block — the exact wire form `header()` reads and
// `buildRequest` inserts verbatim. Fails on the first invalid header; a
// `fail` never returns any value at all, so a caller can never observe a
// partial block built from only the headers validated before it — the whole
// call comes back as one failure, and nothing derived from any header (valid
// or not) reaches whatever the caller does next.
export fn serializeHeaders(headers: []Header): string! {
  let block = ""
  for h of headers {
    validateHeader(h)?
    block = block + "${h.name}: ${h.value}\r\n"
  }
  return block
}

// `extra` layered onto `defaults` (typically a `Client`'s own headers,
// #2290): an entry in `extra` sharing a name with one in `defaults`
// (case-insensitively) REPLACES it there; anything new in `extra` is appended
// after. Builds a fresh output slice rather than mutating `defaults` in
// place — a `Client`'s `headers` field is exactly the slice a caller passes
// here as `defaults`, and mutating it in place would silently rewrite the
// client's own stored state out from under it the next time this runs (the
// aliasing hazard `append` on a slice parameter already carries elsewhere in
// this module).
fn mergeHeaders(defaults: []Header, extra: []Header): []Header {
  let out = []Header(0)
  for d of defaults {
    out = append(out, d)
  }
  for e of extra {
    let replaced = false
    let i = 0
    while (i < len(out) && !replaced) {
      if (toLower(out[i].name) == toLower(e.name)) {
        out[i] = e
        replaced = true
      }
      i = i + 1
    }
    if (!replaced) {
      out = append(out, e)
    }
  }
  return out
}
