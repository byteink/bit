// Private NO_PROXY policy for #6613; transport belongs to the caller.
import { isIpv4Literal } from "std/net"

fn proxyTrimToken(s: string): string {
  let start = 0
  let end = len(s)
  while (start < end && (s[start] == ' ' || s[start] == '\t')) {
    start = start + 1
  }
  while (end > start && (s[end - 1] == ' ' || s[end - 1] == '\t')) {
    end = end - 1
  }
  return s[start:end]
}

fn proxyDomainByte(c: byte): bool {
  let letter = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
  let digit = c >= '0' && c <= '9'
  return letter || digit || c == '-' || c == '.'
}

fn proxyDomainText(s: string): bool {
  if (len(s) == 0 || len(s) > 253) {
    return false
  }
  let i = 0
  while (i < len(s)) {
    if (!proxyDomainByte(s[i])) {
      return false
    }
    i = i + 1
  }
  return s[0] != '.' && s[len(s) - 1] != '.' && indexOf(s, "..") < 0
}

fn proxyValidHost(host: string): bool {
  if (firstForbiddenUrlByte(host) >= 0) {
    return false
  }
  for delimiter of ["/", "?", "#", "@", "[", "]"] {
    if (indexOf(host, delimiter) >= 0) {
      return false
    }
  }
  if (indexOf(host, ":") >= 0) {
    return isIpv6Literal(host)
  }
  return proxyDomainText(host) && (!proxyDecimalHost(host) || isIpv4Literal(host))
}

fn proxyDomainToken(host: string, raw: string): bool {
  let token = proxyTrimToken(raw)
  if (len(token) > 0 && token[0] == '.') {
    token = token[1:len(token)]
  }
  if (!proxyDomainText(token) || proxyDecimalHost(token)) {
    return false
  }
  let domain = toLower(token)
  if (host == domain) {
    return true
  }
  let offset = len(host) - len(domain)
  if (offset <= 0) {
    return false
  }
  return host[offset - 1] == '.' && host[offset:len(host)] == domain
}

fn proxyDomainBypass(host: string, noProxy: string): bool {
  if (len(host) == 0 || len(host) > 253 || len(noProxy) > 65536) {
    return false
  }
  if (!proxyValidHost(host)) {
    return false
  }
  if (proxyTrimToken(noProxy) == "*") {
    return true
  }
  return proxyDomainList(toLower(host), proxyIpBytes(host), noProxy)
}

fn proxyDomainList(host: string, address: []byte, noProxy: string): bool {
  let start = 0
  let i = 0
  while (i < len(noProxy)) {
    if (noProxy[i] == ',') {
      if (proxyListToken(host, address, noProxy[start:i])) {
        return true
      }
      start = i + 1
    }
    i = i + 1
  }
  return proxyListToken(host, address, noProxy[start:len(noProxy)])
}

fn proxyDecimalHost(s: string): bool {
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if ((c < '0' || c > '9') && c != '.') {
      return false
    }
    i = i + 1
  }
  return true
}

fn proxyIpv4Bytes(s: string): []byte {
  let out = []byte(4)
  let parts = split(s, ".")
  let i = 0
  while (i < 4) {
    let value = 0
    let part = parts[i]
    let j = 0
    while (j < len(part)) {
      value = value * 10 + int(part[j] - '0')
      j = j + 1
    }
    out[i] = byte(value)
    i = i + 1
  }
  return out
}

// Only validated literals reach these decoders; their output is at most 16 bytes.
fn proxyIpv6Part(s: string): []byte {
  let out = []byte(0)
  if (len(s) == 0) {
    return out
  }
  for group of split(s, ":") {
    if (indexOf(group, ".") >= 0) {
      for c of proxyIpv4Bytes(group) {
        out = append(out, c)
      }
    } else {
      let value = 0
      let i = 0
      while (i < len(group)) {
        value = value * 16 + queryHexDigit(group[i])
        i = i + 1
      }
      out = append(out, byte(value >> 8))
      out = append(out, byte(value & 255))
    }
  }
  return out
}

fn proxyIpBytes(s: string): []byte {
  if (len(s) == 0 || len(s) > 45) {
    return []byte(0)
  }
  if (isIpv4Literal(s)) {
    return proxyIpv4Bytes(s)
  }
  if (!isIpv6Literal(s)) {
    return []byte(0)
  }
  let dc = indexOf(s, "::")
  if (dc < 0) {
    return proxyIpv6Part(s)
  }
  let head = proxyIpv6Part(s[0:dc])
  let tail = proxyIpv6Part(s[dc + 2:len(s)])
  let out = []byte(16)
  let i = 0
  while (i < len(head)) {
    out[i] = head[i]
    i = i + 1
  }
  i = 0
  while (i < len(tail)) {
    out[16 - len(tail) + i] = tail[i]
    i = i + 1
  }
  return out
}

fn proxyPrefixBits(s: string, limit: int): int {
  if (len(s) == 0 || len(s) > 3) {
    return 0 - 1
  }
  let bits = 0
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      return 0 - 1
    }
    bits = bits * 10 + int(c - '0')
    i = i + 1
  }
  if (bits > limit) {
    return 0 - 1
  }
  return bits
}

fn proxyPrefixMatch(host: []byte, network: []byte, bits: int): bool {
  let i = 0
  while (i < bits / 8) {
    if (host[i] != network[i]) {
      return false
    }
    i = i + 1
  }
  let rest = bits % 8
  if (rest == 0) {
    return true
  }
  let shift = 8 - rest
  return (int(host[bits / 8]) >> shift) == (int(network[bits / 8]) >> shift)
}

fn proxyListToken(host: string, address: []byte, raw: string): bool {
  if (len(address) == 0) {
    return proxyDomainToken(host, raw)
  }
  let token = proxyTrimToken(raw)
  if (len(token) > 49) {
    return false
  }
  let slash = indexOf(token, "/")
  let literal = token
  let bits = len(address) * 8
  if (slash >= 0) {
    literal = token[0:slash]
    bits = proxyPrefixBits(token[slash + 1:len(token)], bits)
  }
  let network = proxyIpBytes(literal)
  if (bits < 0 || len(network) != len(address)) {
    return false
  }
  return proxyPrefixMatch(address, network, bits)
}
