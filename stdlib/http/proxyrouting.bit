// Environment selection is immutable during a process; each redirect selects its own origin.
fn proxyActive(u: Url): bool {
  return len(proxyEnvironment(u.host, u.https)) > 0
}

fn proxyHttpEndpoint(u: Url): proxyEndpoint! {
  let p = parseProxyEndpoint(proxyEnvironment(u.host, u.https))?
  if (p.url.https) {
    fail newError("http proxy: TLS proxy transport is not available")
  }
  return p
}

fn proxyProtocol(u: Url): ()! {
  if (u.h3 && proxyActive(u)) {
    fail newError("http proxy: explicit HTTP/3 requires a UDP proxy transport")
  }
}

fn proxyPoolKey(u: Url, origin: string): string {
  let value = proxyEnvironment(u.host, u.https)
  if (len(value) == 0) {
    return origin
  }
  // These inputs cannot produce a connection; keep rejected input work bounded too.
  if (len(value) > maxHeaderBytes) {
    return "${origin}#proxy=invalid"
  }
  let h = Sha256()
  scopeField(h, []byte(value))
  return "${origin}#proxy=${encodeHex(h.sum())}"
}

// Proxy credentials belong only to the forward request or CONNECT, never the origin.
fn proxyRequestParts(u: Url, headers: string): (string, string)! {
  let block = withoutHeaderLines(headers, "Proxy-Authorization")
  if (u.https || !proxyActive(u)) {
    return (u.path, block)
  }
  let p = proxyHttpEndpoint(u)?
  if (len(p.authorization) > 0) {
    block = block + "Proxy-Authorization: ${p.authorization}\r\n"
  }
  return (urlString(u), block)
}

fn proxyConnectWatched(conn: Conn, u: Url, auth: string, extras: RequestExtras): ()! {
  let s = netStream{ conn = conn }
  let w = watchOf(extras.cancel)
  w.attach(s) catch e {
    conn.close()
    fail e
  }
  proxyConnect(s, u, auth) catch e {
    let cancelled = w.release()
    conn.close()
    if (cancelled) {
      fail Cancelled{ op = "send" }
    }
    fail e
  }
  if (w.release()) {
    conn.close()
    fail Cancelled{ op = "send" }
  }
}

fn proxyTcp(endpoint: Url, extras: RequestExtras): Conn! {
  match (extras.cancel) {
    Some(tok) => { return dialRaced(endpoint, tok, extras.deadline)? }
    None => { return dialConn(endpoint, extras.deadline)? }
  }
}

fn proxyDialConn(u: Url, extras: RequestExtras): Conn! {
  let p = proxyHttpEndpoint(u)?
  let conn = proxyTcp(p.url, extras)?
  if (u.https) {
    proxyConnectWatched(conn, u, p.authorization, extras)?
  }
  return conn
}

fn proxyDialTls(u: Url, cfg: TlsConfig, extras: RequestExtras): TlsConn! {
  let conn = proxyDialConn(u, extras)?
  let w = watchOf(extras.cancel)
  w.attach(netStream{ conn = conn }) catch e {
    conn.close()
    fail e
  }
  let tc = tlsClient(conn, u.host, cfg) catch e {
    let cancelled = w.release()
    conn.close()
    if (cancelled) {
      fail Cancelled{ op = "send" }
    }
    fail e
  }
  if (w.release()) {
    tc.close()
    fail Cancelled{ op = "send" }
  }
  return tc
}
