// stdlib/http/hijack.test.bit — `serveHijackableOn`/`HijackOutcome` (#6102).
//
// `Server`, `Exchange`, `Request`, `Response`, `respond`, `ok`, `dial`,
// `serve`, `indexOf` and `newDrainState` are already bound module-wide (SPEC
// §19). `respReader`/`newRespReader` (keepalive.test.bit) are `.test.bit`-only
// siblings, visible here for the same reason (SPEC §17.2).

// A handler answering every request as ordinary, except a path of exactly
// "/hijack", which takes the connection over and writes a fixed raw line
// instead of an HTTP response — proving `HijackOutcome.Hijacked` really does
// hand the wire to the caller with no framing of its own added.
fn hijackOnPath(req: Request, ex: Exchange): HijackOutcome {
  if (req.path == "/hijack") {
    let conn = ex.hijack()
    conn.write("RAW\r\n") catch _ {}
    return HijackOutcome.Hijacked
  }
  return HijackOutcome.Answer(ok("hi ${req.path}"))
}

fn hijackServe(s: Server) {
  serveHijackableOn(s, hijackOnPath) catch _ {
    return
  }
}

fn startHijackServer(): (Server, int)! {
  let s = serve("127.0.0.1", 0)?
  let port = s.port()?
  spawn hijackServe(s)
  return s, port
}

test "an Answer outcome keeps the connection open for a second request" {
  let (s, port) = startHijackServer() catch e {
    assert(false, "startHijackServer: ${e.message()}")
    return
  }
  let conn = dial("127.0.0.1", port) catch e {
    s.close()
    assert(false, "dial: ${e.message()}")
    return
  }
  let reader = newRespReader(conn)

  conn.write("GET /a HTTP/1.1\r\nHost: x\r\n\r\n") catch e {
    s.close()
    assert(false, "write 1: ${e.message()}")
    return
  }
  let first = reader.next() catch e {
    s.close()
    assert(false, "response 1: ${e.message()}")
    return
  }
  assert(indexOf(first, "hi /a") >= 0, "want the first response to answer /a, got:\n${first}")
  assert(indexOf(first, "connection: close") < 0, "response 1 carried Connection: close:\n${first}")

  // The SAME socket, a second ordinary request — proves this connection
  // never dropped to one-request-per-connection just because the server ALSO
  // serves a hijackable path.
  conn.write("GET /b HTTP/1.1\r\nHost: x\r\n\r\n") catch e {
    s.close()
    assert(false, "write 2: ${e.message()}")
    return
  }
  let second = reader.next() catch e {
    s.close()
    assert(false, "response 2: ${e.message()}")
    return
  }
  assert(indexOf(second, "hi /b") >= 0, "want the second response to answer /b, got:\n${second}")

  conn.close()
  s.close()
}

test "a Hijacked outcome stops the loop and hands the raw connection over" {
  let (s, port) = startHijackServer() catch e {
    assert(false, "startHijackServer: ${e.message()}")
    return
  }
  let conn = dial("127.0.0.1", port) catch e {
    s.close()
    assert(false, "dial: ${e.message()}")
    return
  }
  conn.write("GET /hijack HTTP/1.1\r\nHost: x\r\n\r\n") catch e {
    s.close()
    assert(false, "write: ${e.message()}")
    return
  }
  let wire = conn.read(64)
  conn.close()
  s.close()
  assert(
    wire == "RAW\r\n",
    "want the raw bytes the handler wrote with no HTTP framing, got '${wire}'",
  )
}

test "a malformed first request on a hijackable server gets a plain 400" {
  let (s, port) = startHijackServer() catch e {
    assert(false, "startHijackServer: ${e.message()}")
    return
  }
  let conn = dial("127.0.0.1", port) catch e {
    s.close()
    assert(false, "dial: ${e.message()}")
    return
  }
  conn.write("GET / HTTP/1.1\r\nHost: x\r\nContent-Length: abc\r\n\r\n") catch e {
    s.close()
    assert(false, "write: ${e.message()}")
    return
  }
  let wire = conn.readAll()
  conn.close()
  s.close()
  assert(indexOf(wire, "400") >= 0, "want a 400 for a malformed first request, got:\n${wire}")
}
