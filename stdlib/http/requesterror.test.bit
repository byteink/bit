// stdlib/http/requesterror.test.bit — `RequestError.sent`, whether a failed
// client request may have reached the server (#7305).
//
// Same module as client.bit (SPEC §19): `Client`, `RequestError`, `Listener`,
// `Conn`, `listen`, `readMessage` and `netStream` are bound module-wide. The
// fakes are raw listeners: one reads the whole request and hangs up without
// answering, one answers a redirect to a port nothing listens on.

// Reads one request off every connection `l` accepts and closes it unanswered,
// or, when `location` is not "", answers it with a 302 to `location`.
fn hangUpAccept(l: Listener, location: string) {
  while (true) {
    let c = l.accept() catch _ {
      return
    }
    spawn hangUpConn(c, location)
  }
}

fn hangUpConn(c: Conn, location: string) {
  defer c.close()
  let s = netStream{ conn = c }
  readMessage(s, 1048576) catch _ {
    return
  }
  if (location == "") {
    return
  }
  s.writeStr("HTTP/1.1 302 Found\r\nLocation: ${location}\r\nContent-Length: 0\r\n\r\n") catch _ {
    return
  }
}

fn startHangUp(location: string): Listener! {
  let l = listen("127.0.0.1", 0)?
  spawn hangUpAccept(l, location)
  return l
}

// The `RequestError` `e` is, failing the test when it is another error.
fn requestErrorOf(e: error): RequestError {
  let (r, ok) = e.(RequestError)
  assert(ok, "want a RequestError, got: ${e.message()}")
  return r
}

test "a server that hangs up after reading the whole POST is sent=true" {
  let l = startHangUp("") catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  defer l.close()
  let port = l.port() catch _ {
    return
  }
  let c = Client()
  defer c.close()
  c.requestTimeout("POST", "http://127.0.0.1:${port}/send", "payload", 5000) catch e {
    assert(requestErrorOf(e).sent, "the request was read in full, so it was sent")
    return
  }
  assert(false, "a request the server never answered succeeded")
}

test "a refused connect is sent=false, for request and requestTimeout" {
  let c = Client()
  defer c.close()
  c.request("POST", "http://127.0.0.1:1/send", "payload") catch e {
    assert(!requestErrorOf(e).sent, "request: nothing was written to a refused connection")
    c.requestTimeout("POST", "http://127.0.0.1:1/send", "payload", 5000) catch e2 {
      assert(
        !requestErrorOf(e2).sent,
        "requestTimeout: nothing was written to a refused connection",
      )
      return
    }
    assert(false, "requestTimeout to a closed port succeeded")
    return
  }
  assert(false, "a request to a closed port succeeded")
}

test "RequestError keeps the cause's text and the cause itself" {
  let c = Client()
  defer c.close()
  c.post("http://127.0.0.1:1/send", "payload") catch e {
    let r = requestErrorOf(e)
    assert(r.message() == r.cause.message(), "message is the cause's: ${r.message()}")
    return
  }
  assert(false, "a request to a closed port succeeded")
}

test "a URL that cannot be parsed is a plain error, nothing was sent" {
  let c = Client()
  defer c.close()
  c.post("not a url", "payload") catch e {
    let (_, ok) = e.(RequestError)
    assert(!ok, "a local refusal is not a RequestError: ${e.message()}")
    return
  }
  assert(false, "a malformed URL succeeded")
}

test "a failed redirect hop reports sent=true, the first hop was sent" {
  let l = startHangUp("http://127.0.0.1:1/next") catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  defer l.close()
  let port = l.port() catch _ {
    return
  }
  let c = Client()
  defer c.close()
  c.get("http://127.0.0.1:${port}/start") catch e {
    assert(requestErrorOf(e).sent, "hop one was sent, so the request was")
    return
  }
  assert(false, "a redirect to a closed port succeeded")
}
