// stdlib/http/bodyreader.bit — pull-style streaming responses (#6580).
//
// `Client.send(req, stream = true)` (client.bit) returns the status line and
// headers of a response BEFORE any body byte is read, with the body behind a
// `BodyReader` the caller pulls from. Memory is O(one read), never O(body):
// a 5 GiB object streams through a 64 KiB window. It replaces the sink
// callback `getStreaming` (streambody.bit) for new code, which stays as it is.
//
// Rules this file keeps, because the device it runs on has no human to fix it:
//
//   * every read is bounded: by the caller's `max`, by `maxReadBytes`, and the
//     head and every framing line by their own byte limits, so a hostile
//     server cannot make this process buffer more than a few tens of KiB;
//   * every failure is an error, never a short body that looks complete: a
//     connection that closes before its Content-Length or before the final
//     chunk fails the read that hit it;
//   * a connection goes back to the client's idle pool (pool.bit) ONLY when the
//     body was read to its end and the response left it exactly at a message
//     boundary: HTTP/1.1, no `Connection: close`, a Content-Length or chunked
//     body (the final chunk and its trailer section consumed) or none by
//     status, and no byte past the end. A reader abandoned with `close()` after
//     a partial read, a failed read, a read deadline and a body that ends at
//     the connection closing all SHUT the connection instead: the unread rest
//     of the body is still on the wire, and the next request would read it as
//     its own response;
//   * a streamed exchange holds its origin's `maxConnsPerHost` slot (pool.bit)
//     until the connection is shut, so a caller that never reads cannot
//     exceed the cap it configured.
//
// A streamed response is not redirected: the 3xx is returned as it came, with
// its `Location` header, because the body of the response the caller asked
// for is what it holds. It speaks HTTP/1.1 only (ALPN `http/1.1`); an
// `https+h3://` URL is refused.
//
// `byteStream`, `connSlot`, `connPool`, `Idle`, `Url`, `Header`, `Response`,
// `RequestExtras`, `buildRequest`, `parseUrl`, `parseStatusCode`, `bodyless`,
// `header`, `hexToInt`, `trimSpace`, `dialConn`, `dialTlsConn`, `poolKey`,
// `isIdempotent`, `withDeadline`, `monotonic`, `maxHeaderBytes`, `netStream`,
// `tlsStream`, `TlsConfig`, `newError`, `atoi`, `indexOf`, `toLower` and
// `hasPrefix` are siblings or module-wide imports (SPEC §19): nothing is
// imported here.

// The most bytes one `BodyReader.read` returns, whatever `max` asks for.
const maxReadBytes: int = 65536

// The longest chunk-size line or trailer field line accepted.
const maxFramingLine: int = 4096

// Trailer field lines accepted after the final chunk.
const maxTrailerLines: int = 64

// Interim (1xx, other than 101) responses skipped before the final one.
const maxInterimResponses: int = 8

// The states of a `BodyReader`. `Open` is the only one that holds a connection.
const readerOpen: int = 0
const readerEof: int = 1
const readerClosed: int = 2
const readerFailed: int = 3

// A request for `Client.send` (client.bit): `method` and `url` as `Client.request`
// takes them, `headers` layered onto the client's own defaults exactly as
// `Client.requestWith` layers them, `body` sent whole with a Content-Length.
export class ClientRequest {
  export method: string = "GET",
  export url: string = "",
  export headers: []Header,
  export body: string = "",
  // Milliseconds bounding the connect, the response head, and EACH `read` of
  // the body (a read that waits longer fails with a `TimeoutError`); 0 means
  // no bound.
  export timeoutMs: int = 0,
  // `cancel()` on this token fails the request, in any phase and from any task,
  // with `Cancelled` (cancel.bit, #6602) and shuts its connection; a `Cancel`
  // already cancelled fails it before anything is dialed. The request is then
  // HTTP/1.1 only.
  export cancel: Option<Cancel> = Option.None,
}

// The error a streamed request returns when `ClientRequest.timeoutMs` ran out:
// `op` is "send" (connect, request and response head) or "read" (one
// `BodyReader.read`), `ms` the bound. A caller tells it from any other failure
// with `e.(TimeoutError)`.
export class TimeoutError {
  export op: string
  export ms: int

  export message(): string {
    return "http: ${this.op} timed out after ${this.ms} ms"
  }
}

// A `byteStream` that counts the bytes `unread` put back and the reads have not
// taken yet. A body that ends with such bytes left was followed by data nobody
// asked for, and the connection under it must not carry another request. The
// pool's streams have no way to say what they hold back, so the count is kept
// here, where every `unread` of a streamed response is made.
class countedStream {
  inner: byteStream
  buffered: int

  readUp(n: int): string! {
    let piece = this.inner.readUp(n)?
    // A stream serves what was pushed back before it touches the wire.
    let used = len(piece)
    if (used > this.buffered) {
      used = this.buffered
    }
    this.buffered = this.buffered - used
    return piece
  }

  writeStr(s: string): ()! { this.inner.writeStr(s)? }

  writeBytes(b: []byte): ()! { this.inner.writeBytes(b)? }

  shut() { this.inner.shut() }

  forceClose() { this.inner.forceClose() }

  peer(): string { return this.inner.peer() }

  unread(extra: string) {
    this.buffered = this.buffered + len(extra)
    this.inner.unread(extra)
  }

  setIdleDeadline(deadlineNs: int) { this.inner.setIdleDeadline(deadlineNs) }
}

// How the body of one response is delimited (RFC 9112 §6.3).
enum BodyFraming {
  Empty,
  Length,
  Chunked,
  UntilClose,
}

// What the head of a final response said: the status, the raw header block, and
// the framing of the body behind it (`length` is the Content-Length for
// `Length`, else 0), and `keep`: whether the head allows the connection to carry
// another request once the body is read (HTTP/1.1, no `Connection: close`, a
// body that is delimited by something other than the connection closing).
class streamHead {
  status: int,
  headers: string,
  framing: BodyFraming,
  length: int,
  keep: bool,
}

// The body of a streamed response, pulled by `read` until it returns an empty
// slice. Obtained from `Response.reader` after `Client.send(req, stream = true)`.
//
// Close it with `close()` unless `read` has returned an empty slice (or the
// Content-Length bytes are all read): until then it owns an open connection.
// Nothing frees an abandoned reader for you.
export class BodyReader {
  stream: countedStream
  slot: connSlot
  framing: BodyFraming
  // Bytes left in the Content-Length body, or in the current chunk.
  left: int
  // The CRLF that ends a chunk's data is still to be consumed.
  crlf: bool
  state: int
  // The response head allowed another request on this connection.
  keep: bool
  // The bound on each `read` in ms (0 = none), and the monotonic deadline the
  // read in progress was armed with.
  timeoutMs: int
  armed: int
  // This request's registration with its `Cancel` (cancel.bit), held until the
  // connection is parked or shut.
  watch: connWatch

  // Up to `max` bytes of the body, at least 1; an EMPTY slice only at the clean
  // end of the body, and again on every later call. May return fewer than
  // `max` (never more than 65536 whatever `max` is): loop until it is empty.
  // Fails, and closes the connection, when the connection ends or breaks before
  // the body does, when the framing is malformed, and on a read deadline (a
  // `TimeoutError`, when `ClientRequest.timeoutMs` is set); later calls fail
  // too. Fails after `close()`. `max` below 1 is an error. The call that
  // returns the last byte (or the empty slice) hands the connection back to
  // the pool when it can carry another request.
  export read(max: int): []byte! {
    if (max < 1) {
      fail newError("BodyReader.read: max is ${max}; it must be at least 1")
    }
    if (this.state == readerClosed) {
      fail newError("BodyReader.read: the reader is closed")
    }
    if (this.state == readerFailed) {
      fail newError("BodyReader.read: an earlier read failed")
    }
    if (this.state == readerEof) {
      return []byte(0)
    }
    let want = max
    if (want > maxReadBytes) {
      want = maxReadBytes
    }
    this.arm()
    let piece = this.pull(want) catch e {
      let err = this.asTimeout(e)
      this.finish(readerFailed)
      fail err
    }
    // A cancel shuts the connection, which a read to the connection's close
    // takes for the end of the body.
    if (this.watch.hit()) {
      this.finish(readerFailed)
      fail Cancelled{ op = "read" }
    }
    if (len(piece) == 0 || this.drained()) {
      this.finish(readerEof)
    }
    return []byte(piece)
  }

  // Shuts the connection if the body was not read to its end (it goes to the
  // pool only from a full read), and makes every later `read` fail. Safe to
  // call any number of times.
  export close() {
    if (this.state == readerOpen) {
      this.finish(readerClosed)
      return
    }
    this.state = readerClosed
  }

  // One bounded read of the body: "" at its clean end.
  pull(n: int): string! {
    match (this.framing) {
      Empty => return ""
      Length => return this.pullSized(n)?
      Chunked => return this.pullChunked(n)?
      UntilClose => return this.pullUntilClose(n)?
    }
  }

  // Starts the clock of one `read`: the transport's deadline is now plus
  // `timeoutMs`, so a server that stalls mid-body fails the read that waits.
  arm() {
    if (this.timeoutMs <= 0) {
      return
    }
    this.armed = monotonic().ns + this.timeoutMs * 1000000
    this.stream.setIdleDeadline(this.armed)
  }

  // Whether the read in progress has outlived its deadline.
  expired(): bool {
    return this.timeoutMs > 0 && monotonic().ns >= this.armed
  }

  // `e`, or the `TimeoutError` it is when the deadline had passed.
  asTimeout(e: error): error {
    if (this.watch.hit()) {
      return Cancelled{ op = "read" }
    }
    if (this.expired()) {
      return TimeoutError{ op = "read", ms = this.timeoutMs }
    }
    return e
  }

  // A read to the connection's close. A TLS read that hits its deadline comes
  // back EMPTY, the same as the peer closing (`TlsConn.readTimedOut`, std/tls),
  // so an empty read past the deadline is a timeout and never the end of the
  // body: otherwise a stalled server would look like a complete response.
  pullUntilClose(n: int): string! {
    let piece = this.stream.readUp(n)?
    if (len(piece) == 0 && this.expired()) {
      fail TimeoutError{ op = "read", ms = this.timeoutMs }
    }
    return piece
  }

  // Up to `n` of the `left` bytes still owed; the connection closing first is
  // an error, not an end.
  pullSized(n: int): string! {
    if (this.left == 0) {
      return ""
    }
    let want = n
    if (want > this.left) {
      want = this.left
    }
    let piece = this.stream.readUp(want)?
    if (len(piece) == 0) {
      fail newError("response: connection closed with ${this.left} bytes of the body unread")
    }
    if (len(piece) > want) {
      fail newError("response: ${len(piece)} bytes arrived for a read of ${want}")
    }
    this.left = this.left - len(piece)
    return piece
  }

  // As `pullSized` for a chunked body: the next chunk's header is read when the
  // current chunk is spent, and a size of 0 (the final chunk, its trailer
  // section consumed) is the end.
  pullChunked(n: int): string! {
    if (this.left == 0) {
      this.left = this.nextChunk()?
    }
    if (this.left == 0) {
      return ""
    }
    let piece = this.pullSized(n)?
    if (this.left == 0) {
      this.crlf = true
    }
    return piece
  }

  // The size of the next chunk, after the CRLF that closed the previous one; 0
  // after the final chunk's trailer section has been read up to its blank line.
  nextChunk(): int! {
    if (this.crlf) {
      this.crlf = false
      let _ = readLineBounded(this.stream, 0, "chunk terminator")?
    }
    let line = readLineBounded(this.stream, maxFramingLine, "chunk size line")?
    let token = line
    let semi = indexOf(line, ";")
    if (semi >= 0) {
      token = line[0:semi]
    }
    let size = hexToInt(trimSpace(token))
    if (size < 0) {
      fail newError("response: bad chunk size '${token}'")
    }
    if (size > 0) {
      return size
    }
    this.skipTrailers()?
    return 0
  }

  // Consumes the trailer section after the final chunk, up to and including
  // its blank line: at most `maxTrailerLines` lines of `maxFramingLine` bytes.
  skipTrailers(): ()! {
    let seen = 0
    while (seen <= maxTrailerLines) {
      seen = seen + 1
      let field = readLineBounded(this.stream, maxFramingLine, "trailer field")?
      if (len(field) == 0) {
        return
      }
    }
    fail newError("response: more than ${maxTrailerLines} trailer fields")
  }

  // Whether the whole Content-Length body has been handed out, so the
  // connection can go without waiting for a read that returns empty.
  drained(): bool {
    match (this.framing) {
      Length => return this.left == 0
      Empty => return true
      Chunked => return false
      UntilClose => return false
    }
  }

  // Leaves `Open`: hands the connection back to the pool when the body ended
  // cleanly on a connection that may carry another request, else shuts it;
  // then frees the origin's slot, after the connection is parked so a request
  // that waited for the slot finds it. Called once, from `Open` only.
  finish(next: int) {
    this.state = next
    let hit = this.watch.release()
    if (next == readerEof && this.keep && !hit && this.stream.buffered == 0) {
      this.park()
    } else {
      this.stream.shut()
    }
    this.slot.release()
  }

  // The connection goes idle in the pool, with no deadline of this request on it.
  park() {
    this.stream.setIdleDeadline(0)
    this.slot.pool.put(this.slot.key, this.stream.inner, monotonic().ns)
  }
}

// The text before the first CRLF the stream delivers, which must come within
// `limit` bytes; bytes past that CRLF go back to the stream for the next read.
// `what` names the line in the error.
fn readLineBounded(s: byteStream, limit: int, what: string): string! {
  let acc = ""
  let reads = 0
  // Each pass adds at least one byte, so `limit + 3` passes either find the CRLF
  // or leave `acc` past `limit` for the check below to refuse.
  while (reads <= limit + 3) {
    reads = reads + 1
    let at = indexOf(acc, "\r\n")
    if (at >= 0) {
      if (at > limit) {
        fail newError("response: ${what} exceeds ${limit} bytes")
      }
      s.unread(acc[at + 2:len(acc)])
      return acc[0:at]
    }
    // A CRLF that starts at or before `limit` ends at `limit + 1` at the latest.
    if (len(acc) >= limit + 2) {
      fail newError("response: ${what} exceeds ${limit} bytes")
    }
    let piece = s.readUp(maxFramingLine)?
    if (len(piece) == 0) {
      fail newError("response: connection closed inside the ${what}")
    }
    acc = acc + piece
  }
  fail newError("response: ${what} exceeds ${limit} bytes")
}

// The head of a response: everything before the blank line, which must come
// within `maxHeaderBytes`; bytes past it (the start of the body) go back to the
// stream.
fn readHeadBlock(s: byteStream): string! {
  let acc = ""
  let reads = 0
  while (reads <= maxHeaderBytes + 5) {
    reads = reads + 1
    let at = indexOf(acc, "\r\n\r\n")
    if (at > maxHeaderBytes) {
      fail newError("response: head exceeds ${maxHeaderBytes} bytes")
    }
    if (at >= 0) {
      s.unread(acc[at + 4:len(acc)])
      return acc[0:at]
    }
    if (len(acc) >= maxHeaderBytes + 4) {
      fail newError("response: head exceeds ${maxHeaderBytes} bytes")
    }
    let piece = s.readUp(maxFramingLine)?
    if (len(piece) == 0) {
      fail newError("response: connection closed inside the head")
    }
    acc = acc + piece
  }
  fail newError("response: head exceeds ${maxHeaderBytes} bytes")
}

// A Content-Length: decimal digits only, at most 18 of them; -1 for anything
// else, a sign, a list ("5, 5"), a space inside, an empty value.
fn parseLength(text: string): int {
  if (len(text) == 0 || len(text) > 18) {
    return -1
  }
  let i = 0
  while (i < len(text)) {
    if (text[i] < '0' || text[i] > '9') {
      return -1
    }
    i = i + 1
  }
  return atoi(text)
}

// How the body of a response with `headers` to `method` ends, per RFC 9112
// §6.3: nothing for HEAD and for 204/304, chunked, Content-Length, else the
// connection closing. Both framing fields together, a repeated Transfer-Encoding
// and differing Content-Length fields are refused outright (`checkFraming`,
// message.bit).
fn framingOf(headers: string, method: string, status: int): streamHead! {
  let head = streamHead{
    status = status,
    headers = headers,
    framing = BodyFraming.Empty,
    length = 0,
    keep = false,
  }
  if (bodyless(method, status)) {
    return head
  }
  checkFraming(headers, "response")?
  let clText = header(headers, "content-length")
  let teText = toLower(header(headers, "transfer-encoding"))
  if (len(teText) > 0) {
    if (teText != "chunked") {
      fail newError("response: unsupported Transfer-Encoding")
    }
    head.framing = BodyFraming.Chunked
    return head
  }
  if (len(clText) == 0) {
    head.framing = BodyFraming.UntilClose
    return head
  }
  head.length = parseLength(clText)
  if (head.length < 0) {
    fail newError("response: invalid Content-Length '${clText}'")
  }
  head.framing = BodyFraming.Length
  return head
}

// The status of the head block `block`, which must open with an HTTP/1.x
// status line, and the header lines after it.
fn parseHeadBlock(block: string, method: string): streamHead! {
  let eol = indexOf(block, "\r\n")
  let statusLine = block
  let headers = ""
  if (eol >= 0) {
    statusLine = block[0:eol]
    headers = block[eol + 2:len(block)]
  }
  if (!hasPrefix(statusLine, "HTTP/1.")) {
    fail newError("response: not an HTTP/1.x status line")
  }
  let status = parseStatusCode(statusLine)?
  if (status == 101) {
    fail newError("response: 101 Switching Protocols on a streamed request")
  }
  let head = framingOf(headers, method, status)?
  head.keep = hasPrefix(statusLine, "HTTP/1.1") &&
    !connectionCloses(headers) &&
    head.framing != BodyFraming.UntilClose
  return head
}

// The final response's head, after skipping interim 1xx responses.
fn readStreamHead(s: byteStream, method: string): streamHead! {
  let seen = 0
  while (seen <= maxInterimResponses) {
    seen = seen + 1
    let head = parseHeadBlock(readHeadBlock(s)?, method)?
    if (head.status < 100 || head.status >= 200) {
      return head
    }
  }
  fail newError("response: more than ${maxInterimResponses} interim responses")
}

// A TLS config like `cfg` that offers HTTP/1.1 only: a streamed response is
// read by this file's HTTP/1.1 framing, so ALPN must never pick h2. A copy,
// because `cfg` is the client's own and stays as it is.
fn http1Only(cfg: TlsConfig): TlsConfig {
  return TlsConfig(
    cfg.roots,
    serverName = cfg.serverName,
    alpn = ["http/1.1"],
    insecureSkipVerify = cfg.insecureSkipVerify,
    nowUnix = cfg.nowUnix,
  )
}

// A connection to `u`'s origin, over TLS for https, bounded by `extras.deadline`.
fn dialStream(u: Url, extras: RequestExtras): byteStream! {
  match (extras.cancel) {
    Some(tok) => { return dialCancellable(u, http1Only(extras.config), tok, extras.deadline)? }
    None => {}
  }
  if (u.https) {
    return tlsStream{ conn = dialTlsConn(u, http1Only(extras.config), extras.deadline)? }
  }
  return netStream{ conn = dialConn(u, extras.deadline)? }
}

// Reads the response head off `s`, the request already written, returning it
// with the reader over its body; `timeoutMs` is the bound on each of the
// reader's reads. A
// response with no body is finished here: its connection is parked or shut and
// its slot freed before the caller sees it.
fn startStream(
  s: byteStream,
  slot: connSlot,
  method: string,
  timeoutMs: int,
  watch: connWatch,
): Response! {
  let cs = countedStream{ inner = s, buffered = 0 }
  let head = readStreamHead(cs, method)?
  let reader = BodyReader{
    stream = cs,
    slot = slot,
    framing = head.framing,
    left = head.length,
    crlf = false,
    state = readerOpen,
    keep = head.keep,
    timeoutMs = timeoutMs,
    armed = 0,
    watch = watch,
  }
  if (reader.drained()) {
    reader.finish(readerEof)
  }
  return Response{
    status = head.status,
    contentType = header(head.headers, "content-type"),
    headers = head.headers,
    body = "",
    reader = Option.Some(reader),
  }
}

// One streamed exchange: where it goes (`u`), the origin's `slot`, the request
// head, its `body` and its `method`, how it dials (`extras`) and the per-read bound.
class streamCall {
  u: Url,
  slot: connSlot,
  req: string,
  body: Body,
  method: string,
  extras: RequestExtras,
  timeoutMs: int,
  watch: connWatch,
}

// Writes `call`'s request on `s` and starts reading its response, with `s`
// registered under `call.watch` from the first byte written; the reader keeps
// the registration, a failure here ends it.
fn startCall(s: byteStream, call: streamCall): Response! {
  call.watch.attach(s)?
  writeRequest(s, call.req, call.body) catch e {
    call.watch.release()
    fail e
  }
  return startStream(s, call.slot, call.method, call.timeoutMs, call.watch) catch e {
    call.watch.release()
    fail e
  }
}

// `call` on a connection dialed now: the slot and the connection are released
// on every failure here. A failed dial sent nothing (`unsentError`); a failure
// once the request is being written or after is `sentError` (#7308).
fn startFresh(call: streamCall): Response! {
  let s = dialStream(call.u, call.extras) catch e {
    call.slot.release()
    fail unsentError(e)
  }
  let res = startCall(s, call) catch e {
    s.shut()
    call.slot.release()
    fail sentError(e)
  }
  return res
}

// `startFresh`'s twin on the connection `s`, parked by an earlier exchange. A
// parked connection the server closed meanwhile fails here, before the caller
// has seen anything, so an idempotent method is retried once on a fresh
// connection, as `exchangeParked` (pool.bit) does; a POST fails with the error
// it got, a `RequestError` with `sent` true, and so does the retry: the first
// attempt already wrote the request.
fn startParked(s: byteStream, call: streamCall): Response! {
  s.setIdleDeadline(call.extras.deadline)
  let res = startCall(s, call) catch e {
    s.shut()
    if (!isIdempotent(call.method)) {
      call.slot.release()
      fail sentError(e)
    }
    return startFresh(call) catch again {
      fail afterSent(again)
    }
  }
  return res
}

// `method u` with `body`, answered by a response whose body has not been read:
// a connection the client's pool parked for the origin, else a fresh one, under
// the origin's `maxConnsPerHost` slot, both released on every failure here and
// by the returned reader otherwise. The request does not say `Connection:
// close`, so the connection can go back to the pool after a full read.
fn openStreamOn(
  method: string,
  u: Url,
  body: Body,
  extras: RequestExtras,
  timeoutMs: int,
): Response! {
  if (u.h3) {
    fail newError("send: https+h3:// cannot stream a response")
  }
  let key = poolKey(u, extras)
  let slot = extras.pool.acquire(key, extras.deadline, extras.cancel) catch e {
    fail unsentError(e)
  }
  let call = streamCall{
    u = u,
    slot = slot,
    req = buildRequest(method, u, extras.block, body, false),
    body = body,
    method = method,
    extras = extras,
    timeoutMs = timeoutMs,
    watch = watchOf(extras.cancel),
  }
  match (extras.pool.take(key, monotonic().ns)) {
    Hit(s) => return startParked(s, call)?
    Miss => return startFresh(call)?
  }
}

// `openStreamOn` under `timeoutMs` (0 = unbounded) for the connect, the request
// and the response head; a failure that came after the bound passed is a
// `TimeoutError` as the `cause` of the `RequestError` that says whether the
// request was sent.
fn openStream(
  method: string,
  u: Url,
  body: Body,
  extras: RequestExtras,
  timeoutMs: int,
): Response! {
  if (timeoutMs <= 0) {
    return openStreamOn(method, u, body, extras, 0)?
  }
  let deadline = monotonic().ns + timeoutMs * 1000000
  let res = openStreamOn(method, u, body, withDeadline(extras, deadline), timeoutMs) catch e {
    if (monotonic().ns >= deadline) {
      fail timedOut(e, TimeoutError{ op = "send", ms = timeoutMs })
    }
    fail e
  }
  return res
}
