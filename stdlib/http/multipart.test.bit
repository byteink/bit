// stdlib/http/multipart.test.bit — parseMultipart (RFC 7578, #3961). Same
// module as ./multipart.bit (SPEC §19): no import needed to reach
// parseMultipart/Form/Limits, or toLower/hasPrefix/indexOf/newBuilder, all
// already imported by ./http.bit in this module.

import { repeat } from "std/strings"

// --- fixtures ----------------------------------------------------------

fn tinyLimits(): Limits {
  return Limits{
    maxBodyBytes: 4096,
    maxFileBytes: 1024,
    maxParts: 8,
    maxHeaderLineBytes: 256,
    maxPartHeaderBytes: 1024,
  }
}

// Two text fields ("field1"/"field2") and one file part ("upload", filename
// `filename`, declared type `contentType`, body `fileBody`).
fn twoFieldsOneFile(
  boundary: string,
  filename: string,
  contentType: string,
  fileBody: string,
): string {
  return "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"field1\"\r\n" +
    "\r\n" +
    "value1\r\n" +
    "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"field2\"\r\n" +
    "\r\n" +
    "value2\r\n" +
    "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"upload\"; filename=\"${filename}\"\r\n" +
    "Content-Type: ${contentType}\r\n" +
    "\r\n" +
    "${fileBody}\r\n" +
    "--${boundary}--\r\n"
}

// The error message of a failed parse, or "" if it unexpectedly succeeded —
// used by every negative test below to check the failure is DISTINCT
// (names the specific limit or defect), not merely present. `fail` never
// returns a value at all (SPEC), so there is structurally no way for a
// caller to observe a partially-built Form from a failed call: the only
// two outcomes reachable from here are "" (bug: it succeeded) or a message.
fn parseFails(body: string, boundary: string, limits: Limits): string {
  parseMultipart([]byte(body), boundary, limits) catch e {
    return e.message()
  }
  return ""
}

// --- happy path ----------------------------------------------------------

test "parses two text fields and one file part with every value exact" {
  let boundary = "TestBoundary123"
  let body = twoFieldsOneFile(boundary, "photo.jpg", "image/jpeg", "binary-file-bytes")
  let form = parseMultipart([]byte(body), boundary, defaultLimits()) catch e {
    assert(false, "parse failed: ${e.message()}")
    return
  }
  assert(len(form.fields) == 2, "expected 2 fields, got ${len(form.fields)}")
  assert(len(form.files) == 1, "expected 1 file, got ${len(form.files)}")
  let v1 = form.value("field1")
  let v2 = form.value("field2")
  assert(v1 == "value1", "field1 = \"${v1}\", want \"value1\"")
  assert(v2 == "value2", "field2 = \"${v2}\", want \"value2\"")

  let f = form.file("upload") catch e {
    let msg = e.message()
    assert(false, "file(\"upload\") failed: ${msg}")
    return
  }
  assert(f.name == "upload", "file name = \"${f.name}\", want \"upload\"")
  assert(f.filename == "photo.jpg", "filename = \"${f.filename}\", want \"photo.jpg\"")
  assert(f.contentType == "image/jpeg", "contentType = \"${f.contentType}\", want \"image/jpeg\"")
  assert(
    string(f.content) == "binary-file-bytes",
    "content = \"${string(f.content)}\", want \"binary-file-bytes\"",
  )
}

// --- the six limits: each fails with its own distinct message ------------

test "a body exceeding the total limit fails, and only that limit" {
  let boundary = "B"
  let body = twoFieldsOneFile(boundary, "a.txt", "text/plain", "small file")
  let limits = tinyLimits()
  limits.maxBodyBytes = len(body) - 1
  let msg = parseFails(body, boundary, limits)
  assert(msg != "", "an over-total-size body was accepted")
  assert(indexOf(msg, "body exceeds") >= 0, "wrong error for over-total-size body: ${msg}")
}

test "a file part exceeding the per-file limit fails, and only that limit" {
  let boundary = "B"
  let bigFile = repeat("x", 2000)
  let body = twoFieldsOneFile(boundary, "big.bin", "application/octet-stream", bigFile)
  let limits = tinyLimits()
  // maxBodyBytes must be large enough to admit the body itself, so the
  // failure this test proves is the per-file check, not the total-body one.
  limits.maxBodyBytes = len(body) + 100
  let msg = parseFails(body, boundary, limits)
  assert(msg != "", "an over-per-file body was accepted")
  assert(
    indexOf(msg, "file part") >= 0 && indexOf(msg, "exceeds") >= 0,
    "wrong error for over-file body: ${msg}",
  )
}

test "a body over the part-count limit fails, and only that limit" {
  let boundary = "B"
  let body = twoFieldsOneFile(boundary, "a.txt", "text/plain", "small file") // 3 parts
  let limits = tinyLimits()
  limits.maxBodyBytes = len(body) + 100
  limits.maxParts = 2
  let msg = parseFails(body, boundary, limits)
  assert(msg != "", "a body with too many parts was accepted")
  assert(indexOf(msg, "too many parts") >= 0, "wrong error for too-many-parts body: ${msg}")
}

test "a part with an over-long header line fails, and only that limit" {
  let boundary = "B"
  let longName = repeat("x", 300)
  let body = "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"${longName}\"\r\n" +
    "\r\n" +
    "value\r\n" +
    "--${boundary}--\r\n"
  let limits = tinyLimits()
  limits.maxBodyBytes = len(body) + 100
  // maxHeaderLineBytes (256) is smaller than the Content-Disposition line
  // (over 300 bytes from longName alone), but maxPartHeaderBytes (1024) is
  // not, so this isolates the per-line check from the per-block one.
  let msg = parseFails(body, boundary, limits)
  assert(msg != "", "a part with an over-long header line was accepted")
  assert(indexOf(msg, "header line") >= 0, "wrong error for over-long header line: ${msg}")
}

test "a part whose total header block is over the limit fails" {
  let boundary = "B"
  // Ten header lines, each well under maxHeaderLineBytes on its own, whose
  // sum exceeds maxPartHeaderBytes -- isolates the per-block check.
  let padding = repeat("y", 40)
  let extra = "X-Pad: ${padding}\r\n"
  let headers = "Content-Disposition: form-data; name=\"f\"\r\n" +
    extra +
    extra +
    extra +
    extra +
    extra +
    extra +
    extra +
    extra +
    extra +
    extra
  let body = "--${boundary}\r\n" + headers + "\r\nvalue\r\n--${boundary}--\r\n"
  let limits = tinyLimits()
  limits.maxBodyBytes = len(body) + 100
  limits.maxPartHeaderBytes = 300
  let msg = parseFails(body, boundary, limits)
  assert(msg != "", "a part with an over-limit header block was accepted")
  assert(indexOf(msg, "header block") >= 0, "wrong error for over-limit header block: ${msg}")
}

// --- untrusted filename: never sanitised, never path-joined --------------

test "a path-traversal filename is returned exactly, unmodified" {
  let boundary = "B"
  let body = twoFieldsOneFile(boundary, "../../etc/passwd", "text/plain", "not real passwd content")
  let form = parseMultipart([]byte(body), boundary, defaultLimits()) catch e {
    assert(false, "parse failed: ${e.message()}")
    return
  }
  let f = form.file("upload") catch e {
    let msg = e.message()
    assert(false, "file(\"upload\") failed: ${msg}")
    return
  }
  assert(
    f.filename == "../../etc/passwd",
    "filename = \"${f.filename}\", want the literal string \"../../etc/passwd\" unmodified",
  )
}

// --- malformed boundary: missing, or never closing ------------------------

test "an empty boundary argument fails, specifically as a malformed boundary" {
  let body = twoFieldsOneFile("B", "a.txt", "text/plain", "x")
  let msg = parseFails(body, "", defaultLimits())
  assert(msg != "", "an empty boundary argument was accepted")
  // "missing or malformed" is validBoundary's own message text, distinct
  // from afterDelimiterLine's "malformed boundary line" -- both happen to
  // contain the word "boundary", which is not enough to prove which check
  // actually fired (a mutation disabling validBoundary alone still passed
  // a looser "contains boundary" assertion here, via a different failure
  // further into the parse).
  assert(indexOf(msg, "missing or malformed") >= 0, "wrong error for empty boundary: ${msg}")
}

test "a boundary containing an RFC 2046-illegal character fails, body otherwise well-formed" {
  // "!" is not in bcharsnospace (RFC 2046 §5.1.1). The body is built with
  // this exact string as its literal delimiter, so if validBoundary did not
  // gate this, the rest of the parser would happily accept it -- this test
  // isolates validBoundary from every other check.
  let boundary = "bad!boundary"
  let body = twoFieldsOneFile(boundary, "a.txt", "text/plain", "x")
  let msg = parseFails(body, boundary, defaultLimits())
  assert(msg != "", "a boundary with an illegal '!' byte was accepted")
  assert(indexOf(msg, "missing or malformed") >= 0, "wrong error for illegal boundary byte: ${msg}")
}

test "a boundary absent from the body fails, specifically as delimiter-not-found" {
  let body = twoFieldsOneFile("ActualBoundary", "a.txt", "text/plain", "x")
  let msg = parseFails(body, "NeverAppearsInBody", defaultLimits())
  assert(msg != "", "a body missing the given boundary was accepted")
  assert(indexOf(msg, "not found in body") >= 0, "wrong error for missing boundary: ${msg}")
}

test "a body whose last part never reaches a closing boundary fails" {
  let boundary = "B"
  // No closing "--B--", and no further "\r\n--B" at all -- the part's body
  // simply runs off the end of the input.
  let body = "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"f\"\r\n" +
    "\r\n" +
    "value with no terminator at all"
  let msg = parseFails(body, boundary, defaultLimits())
  assert(msg != "", "an unterminated multipart body was accepted")
  assert(indexOf(msg, "never closes") >= 0, "wrong error for unterminated body: ${msg}")
}

// --- zero limits reject, they never mean unlimited ------------------------

test "a zero body-size limit rejects a nonempty body outright" {
  let body = twoFieldsOneFile("B", "a.txt", "text/plain", "x")
  let limits = tinyLimits()
  limits.maxBodyBytes = 0
  let msg = parseFails(body, "B", limits)
  assert(msg != "", "a zero maxBodyBytes limit allowed a nonempty body through")
  assert(indexOf(msg, "body exceeds") >= 0, "wrong error for zero maxBodyBytes: ${msg}")
}

test "a zero part-count limit rejects a body with any part at all" {
  let body = twoFieldsOneFile("B", "a.txt", "text/plain", "x")
  let limits = tinyLimits()
  limits.maxBodyBytes = len(body) + 100
  limits.maxParts = 0
  let msg = parseFails(body, "B", limits)
  assert(msg != "", "a zero maxParts limit allowed a part through")
  assert(indexOf(msg, "too many parts") >= 0, "wrong error for zero maxParts: ${msg}")
}

test "every field of Limits set to zero rejects a real body, not allows it" {
  let body = twoFieldsOneFile("B", "a.txt", "text/plain", "x")
  let limits = Limits{
    maxBodyBytes: 0,
    maxFileBytes: 0,
    maxParts: 0,
    maxHeaderLineBytes: 0,
    maxPartHeaderBytes: 0,
  }
  let msg = parseFails(body, "B", limits)
  assert(msg != "", "an all-zero Limits value allowed a real body through")
}

// --- multipartField ------------------------------------------------------

// The shape a CSRF check meets: one wanted text field between two file
// parts, so the field cannot be found without walking past a file — and
// materialising both files is exactly the work `multipartField` exists not
// to do.
fn fileFieldFile(boundary: string, name: string, value: string, fileBody: string): string {
  return "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"avatar\"; filename=\"a.bin\"\r\n" +
    "Content-Type: application/octet-stream\r\n" +
    "\r\n" +
    "${fileBody}\r\n" +
    "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"${name}\"\r\n" +
    "\r\n" +
    "${value}\r\n" +
    "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"note\"; filename=\"n.txt\"\r\n" +
    "\r\n" +
    "${fileBody}\r\n" +
    "--${boundary}--\r\n"
}

// The error message of a failed lookup, or "" if it unexpectedly succeeded —
// the `multipartField` twin of `parseFails`, so a test can assert the two
// entry points fail the same body with the SAME message rather than merely
// both failing.
fn fieldFails(body: string, boundary: string, name: string, limits: Limits): string {
  multipartField([]byte(body), boundary, name, limits) catch e {
    return e.message()
  }
  return ""
}

// Asserts both entry points refuse `body` with one identical message. `what`
// names the defect so a failure says which body disagreed.
fn assertSameFailure(body: string, boundary: string, limits: Limits, what: string) {
  let viaParse = parseFails(body, boundary, limits)
  let viaField = fieldFails(body, boundary, "_csrf", limits)
  assert(viaParse != "", "${what}: parseMultipart accepted it")
  assert(viaField != "", "${what}: multipartField accepted it, parseMultipart said \"${viaParse}\"")
  assert(
    viaField == viaParse,
    "${what}: multipartField said \"${viaField}\", parseMultipart said \"${viaParse}\"",
  )
}

test "multipartField returns a text field found between two file parts" {
  let boundary = "TestBoundary123"
  let token = "9f2c4b1e7a" + repeat("0", 54)
  let body = fileFieldFile(boundary, "_csrf", token, "binary\r\nbytes\x89here")
  let limits = defaultLimits()
  let (value, found) = multipartField([]byte(body), boundary, "_csrf", limits) catch e {
    assert(false, "lookup failed: ${e.message()}")
    return
  }
  assert(found, "_csrf was not found in a body that carries it")
  assert(value == token, "value = \"${value}\", want \"${token}\"")

  // The control: the same body through parseMultipart agrees, so the value
  // above is the parser's answer and not a second reading of the body.
  let form = parseMultipart([]byte(body), boundary, limits) catch e {
    assert(false, "control parse failed: ${e.message()}")
    return
  }
  assert(form.value("_csrf") == value, "the two entry points disagree on _csrf")
  assert(len(form.files) == 2, "expected 2 file parts in the control, got ${len(form.files)}")
}

test "multipartField tells an absent name from a present-but-empty value" {
  let boundary = "B"
  let limits = defaultLimits()

  let present = fileFieldFile(boundary, "_csrf", "", "file-bytes")
  let (emptyValue, emptyFound) = multipartField([]byte(present), boundary, "_csrf", limits) catch e {
    assert(false, "lookup of an empty field failed: ${e.message()}")
    return
  }
  assert(emptyFound, "a present-but-empty _csrf reported as absent")
  assert(emptyValue == "", "empty field value = \"${emptyValue}\", want \"\"")

  let (absentValue, absentFound) = multipartField(
    []byte(present), boundary, "nosuchfield", limits,
  ) catch e {
    assert(false, "lookup of an absent field failed: ${e.message()}")
    return
  }
  assert(!absentFound, "an absent name reported as found")
  assert(absentValue == "", "absent field value = \"${absentValue}\", want \"\"")
}

test "multipartField never answers with a file part, whatever its name" {
  let boundary = "B"
  let limits = defaultLimits()
  // A file part named `_csrf` (it carries a filename, so RFC 7578 §4.2 makes
  // it a file) followed by a real text field of the same name: an attacker
  // must not be able to shadow the field with a file part.
  let body = "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"_csrf\"; filename=\"x\"\r\n" +
    "\r\n" +
    "not-the-token\r\n" +
    "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"_csrf\"\r\n" +
    "\r\n" +
    "the-token\r\n" +
    "--${boundary}--\r\n"
  let (value, found) = multipartField([]byte(body), boundary, "_csrf", limits) catch e {
    assert(false, "lookup failed: ${e.message()}")
    return
  }
  assert(found, "the text field named _csrf was not found")
  assert(value == "the-token", "value = \"${value}\", want \"the-token\" (the file part won)")
}

test "multipartField returns the first of two fields sharing a name" {
  let boundary = "B"
  let body = "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"_csrf\"\r\n" +
    "\r\n" +
    "first\r\n" +
    "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"_csrf\"\r\n" +
    "\r\n" +
    "second\r\n" +
    "--${boundary}--\r\n"
  let (value, found) = multipartField([]byte(body), boundary, "_csrf", defaultLimits()) catch e {
    assert(false, "lookup failed: ${e.message()}")
    return
  }
  assert(found && value == "first", "value = \"${value}\", want \"first\" — Form.value's rule")
}

test "multipartField fails a body over maxParts even with the field in part 1" {
  let boundary = "B"
  // `_csrf` is the FIRST part, so an implementation that stopped walking at
  // the match would answer with a token out of a body the parser refuses.
  let body = "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"_csrf\"\r\n" +
    "\r\n" +
    "the-token\r\n" +
    "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"b\"\r\n" +
    "\r\n" +
    "two\r\n" +
    "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"c\"\r\n" +
    "\r\n" +
    "three\r\n" +
    "--${boundary}--\r\n"
  let limits = tinyLimits()
  limits.maxBodyBytes = len(body) + 100
  limits.maxParts = 2

  let msg = fieldFails(body, boundary, "_csrf", limits)
  assert(indexOf(msg, "too many parts") >= 0, "wrong error for too-many-parts body: ${msg}")
  assertSameFailure(body, boundary, limits, "over maxParts with the field in part 1")

  // The control: the same body under a part limit that admits it yields the
  // token, so the refusal above is the limit and not a broken fixture.
  limits.maxParts = 8
  let (value, found) = multipartField([]byte(body), boundary, "_csrf", limits) catch e {
    assert(false, "control lookup failed: ${e.message()}")
    return
  }
  assert(found && value == "the-token", "control value = \"${value}\", want \"the-token\"")
}

test "multipartField enforces every limit on the parts it skips" {
  let boundary = "B"
  let big = tinyLimits()
  big.maxBodyBytes = 100000

  // A file part over maxFileBytes, skipped: its bytes are never copied, but
  // its LENGTH is still checked.
  let overFile = fileFieldFile(boundary, "_csrf", "tok", repeat("x", 2000))
  assertSameFailure(overFile, boundary, big, "a skipped file part over maxFileBytes")

  // An over-long header line on a part AFTER the wanted field.
  let longName = repeat("x", 300)
  let overLine = "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"_csrf\"\r\n" +
    "\r\n" +
    "tok\r\n" +
    "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"${longName}\"\r\n" +
    "\r\n" +
    "v\r\n" +
    "--${boundary}--\r\n"
  assertSameFailure(overLine, boundary, big, "an over-long header line after the field")

  // A later part with no usable Content-Disposition at all.
  let noDisposition = "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"_csrf\"\r\n" +
    "\r\n" +
    "tok\r\n" +
    "--${boundary}\r\n" +
    "X-Nothing: here\r\n" +
    "\r\n" +
    "v\r\n" +
    "--${boundary}--\r\n"
  assertSameFailure(noDisposition, boundary, big, "a later part with no Content-Disposition")

  // A body truncated after the wanted field, so the closing delimiter that
  // ends the walk never arrives.
  let truncated = "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"_csrf\"\r\n" +
    "\r\n" +
    "tok\r\n"
  assertSameFailure(truncated, boundary, big, "a body truncated after the field")

  // The whole body over maxBodyBytes, and a malformed boundary: the two
  // checks that precede any part.
  let small = tinyLimits()
  small.maxBodyBytes = 10
  assertSameFailure(overLine, boundary, small, "a body over maxBodyBytes")
  assertSameFailure(overLine, "bad boundary ", big, "a malformed boundary")
}

// --- the byte walk (#4604) ----------------------------------------------

// True iff `form` carries a TEXT field named `name` — the property
// `multipartField`'s `found` reports, which `Form.value` alone cannot answer
// (it returns "" for an absent name and for a present-but-empty one alike).
fn formHasField(form: Form, name: string): bool {
  for f of form.fields {
    if (f.name == name) {
      return true
    }
  }
  return false
}

test "both entry points return the same value for every name in a corpus body" {
  let boundary = "TestBoundary123"
  let limits = defaultLimits()
  let bodies = []string{
    twoFieldsOneFile(boundary, "photo.jpg", "image/jpeg", "binary-file-bytes"),
    fileFieldFile(boundary, "_csrf", "the-token", "binary\r\nbytes\x89here"),
    fileFieldFile(boundary, "_csrf", "", "file-bytes"),
  }
  // Text fields, file parts (never a field value) and an absent name.
  let names = []string{ "field1", "field2", "_csrf", "upload", "avatar", "nosuchfield" }
  for body of bodies {
    let form = parseMultipart([]byte(body), boundary, limits) catch e {
      assert(false, "parse failed: ${e.message()}")
      return
    }
    for name of names {
      let (value, found) = multipartField([]byte(body), boundary, name, limits) catch e {
        assert(false, "lookup of \"${name}\" failed: ${e.message()}")
        return
      }
      let want = form.value(name)
      assert(value == want, "\"${name}\": field said \"${value}\", parse said \"${want}\"")
      let wantFound = formHasField(form, name)
      assert(found == wantFound, "\"${name}\": found = ${found}, want ${wantFound}")
    }
  }
}

test "the walk reads a body whose file part is not valid UTF-8" {
  let boundary = "B"
  // Built as raw bytes, not a string: NUL, 0xFF and 0x80 are not UTF-8, and
  // the walk compares body bytes against the delimiter directly.
  let body = []byte(0)
  body = append(body, "--${boundary}\r\n")
  body = append(body, "Content-Disposition: form-data; name=\"upload\"; filename=\"b.bin\"\r\n")
  body = append(body, "\r\n")
  body = append(body, 0)
  body = append(body, 255)
  body = append(body, 128)
  body = append(body, 13)  // a bare CR inside the file body, not a delimiter
  body = append(body, 65)
  body = append(body, "\r\n--${boundary}\r\n")
  body = append(body, "Content-Disposition: form-data; name=\"_csrf\"\r\n\r\n")
  body = append(body, "tok\r\n--${boundary}--\r\n")

  let form = parseMultipart(body, boundary, defaultLimits()) catch e {
    assert(false, "parse failed: ${e.message()}")
    return
  }
  let f = form.file("upload") catch e {
    assert(false, "file(\"upload\") failed: ${e.message()}")
    return
  }
  assert(len(f.content) == 5, "content length = ${len(f.content)}, want 5")
  assert(f.content[0] == 0, "content[0] = ${f.content[0]}, want 0")
  assert(f.content[1] == 255, "content[1] = ${f.content[1]}, want 255")
  assert(f.content[2] == 128, "content[2] = ${f.content[2]}, want 128")
  assert(f.content[3] == 13, "content[3] = ${f.content[3]}, want 13")
  assert(f.content[4] == 65, "content[4] = ${f.content[4]}, want 65")

  let (value, found) = multipartField(body, boundary, "_csrf", defaultLimits()) catch e {
    assert(false, "lookup failed: ${e.message()}")
    return
  }
  assert(found && value == "tok", "value = \"${value}\", want \"tok\"")
}

test "a parsed Form does not alias the caller's body buffer" {
  let boundary = "B"
  let body = []byte(twoFieldsOneFile(boundary, "f.bin", "application/octet-stream", "file-bytes"))
  let form = parseMultipart(body, boundary, defaultLimits()) catch e {
    assert(false, "parse failed: ${e.message()}")
    return
  }
  let f = form.file("upload") catch e {
    assert(false, "file(\"upload\") failed: ${e.message()}")
    return
  }
  // Scribble over every byte the parser was handed. The walk slices this
  // buffer as a VIEW, so a Form holding a view rather than a copy would read
  // back as 'Z's — and a caller reusing its read buffer would corrupt it.
  let i = 0
  while (i < len(body)) {
    body[i] = 'Z'
    i = i + 1
  }
  let v1 = form.value("field1")
  assert(v1 == "value1", "field1 = \"${v1}\" after the body was overwritten, want \"value1\"")
  let content = string(f.content)
  assert(content == "file-bytes", "content = \"${content}\" after the overwrite, want \"file-bytes\"")
}
