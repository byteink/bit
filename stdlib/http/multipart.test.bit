// stdlib/http/multipart.test.bit — parseMultipart (RFC 7578, #3961). Same
// module as ./multipart.bit (SPEC §19): no import needed to reach
// parseMultipart/Form/Limits, or toLower/hasPrefix/indexOf/newBuilder, all
// already imported by ./http.bit in this module.

import { repeat } from "std/strings"

// --- fixtures ----------------------------------------------------------

fn tinyLimits(): Limits {
  return Limits{
    maxBodyBytes: 4096,
    maxFileBytes: 1024,
    maxParts: 8,
    maxHeaderLineBytes: 256,
    maxPartHeaderBytes: 1024,
  }
}

// Two text fields ("field1"/"field2") and one file part ("upload", filename
// `filename`, declared type `contentType`, body `fileBody`).
fn twoFieldsOneFile(
  boundary: string,
  filename: string,
  contentType: string,
  fileBody: string,
): string {
  return "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"field1\"\r\n" +
    "\r\n" +
    "value1\r\n" +
    "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"field2\"\r\n" +
    "\r\n" +
    "value2\r\n" +
    "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"upload\"; filename=\"${filename}\"\r\n" +
    "Content-Type: ${contentType}\r\n" +
    "\r\n" +
    "${fileBody}\r\n" +
    "--${boundary}--\r\n"
}

// The error message of a failed parse, or "" if it unexpectedly succeeded —
// used by every negative test below to check the failure is DISTINCT
// (names the specific limit or defect), not merely present. `fail` never
// returns a value at all (SPEC), so there is structurally no way for a
// caller to observe a partially-built Form from a failed call: the only
// two outcomes reachable from here are "" (bug: it succeeded) or a message.
fn parseFails(body: string, boundary: string, limits: Limits): string {
  parseMultipart([]byte(body), boundary, limits) catch e {
    return e.message()
  }
  return ""
}

// --- happy path ----------------------------------------------------------

test "parses two text fields and one file part with every value exact" {
  let boundary = "TestBoundary123"
  let body = twoFieldsOneFile(boundary, "photo.jpg", "image/jpeg", "binary-file-bytes")
  let form = parseMultipart([]byte(body), boundary, defaultLimits()) catch e {
    assert(false, "parse failed: ${e.message()}")
    return
  }
  assert(len(form.fields) == 2, "expected 2 fields, got ${len(form.fields)}")
  assert(len(form.files) == 1, "expected 1 file, got ${len(form.files)}")
  let v1 = form.value("field1")
  let v2 = form.value("field2")
  assert(v1 == "value1", "field1 = \"${v1}\", want \"value1\"")
  assert(v2 == "value2", "field2 = \"${v2}\", want \"value2\"")

  let f = form.file("upload") catch e {
    let msg = e.message()
    assert(false, "file(\"upload\") failed: ${msg}")
    return
  }
  assert(f.name == "upload", "file name = \"${f.name}\", want \"upload\"")
  assert(f.filename == "photo.jpg", "filename = \"${f.filename}\", want \"photo.jpg\"")
  assert(f.contentType == "image/jpeg", "contentType = \"${f.contentType}\", want \"image/jpeg\"")
  assert(
    string(f.content) == "binary-file-bytes",
    "content = \"${string(f.content)}\", want \"binary-file-bytes\"",
  )
}

// --- the six limits: each fails with its own distinct message ------------

test "a body exceeding the total limit fails, and only that limit" {
  let boundary = "B"
  let body = twoFieldsOneFile(boundary, "a.txt", "text/plain", "small file")
  let limits = tinyLimits()
  limits.maxBodyBytes = len(body) - 1
  let msg = parseFails(body, boundary, limits)
  assert(msg != "", "an over-total-size body was accepted")
  assert(indexOf(msg, "body exceeds") >= 0, "wrong error for over-total-size body: ${msg}")
}

test "a file part exceeding the per-file limit fails, and only that limit" {
  let boundary = "B"
  let bigFile = repeat("x", 2000)
  let body = twoFieldsOneFile(boundary, "big.bin", "application/octet-stream", bigFile)
  let limits = tinyLimits()
  // maxBodyBytes must be large enough to admit the body itself, so the
  // failure this test proves is the per-file check, not the total-body one.
  limits.maxBodyBytes = len(body) + 100
  let msg = parseFails(body, boundary, limits)
  assert(msg != "", "an over-per-file body was accepted")
  assert(
    indexOf(msg, "file part") >= 0 && indexOf(msg, "exceeds") >= 0,
    "wrong error for over-file body: ${msg}",
  )
}

test "a body over the part-count limit fails, and only that limit" {
  let boundary = "B"
  let body = twoFieldsOneFile(boundary, "a.txt", "text/plain", "small file") // 3 parts
  let limits = tinyLimits()
  limits.maxBodyBytes = len(body) + 100
  limits.maxParts = 2
  let msg = parseFails(body, boundary, limits)
  assert(msg != "", "a body with too many parts was accepted")
  assert(indexOf(msg, "too many parts") >= 0, "wrong error for too-many-parts body: ${msg}")
}

test "a part with an over-long header line fails, and only that limit" {
  let boundary = "B"
  let longName = repeat("x", 300)
  let body = "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"${longName}\"\r\n" +
    "\r\n" +
    "value\r\n" +
    "--${boundary}--\r\n"
  let limits = tinyLimits()
  limits.maxBodyBytes = len(body) + 100
  // maxHeaderLineBytes (256) is smaller than the Content-Disposition line
  // (over 300 bytes from longName alone), but maxPartHeaderBytes (1024) is
  // not, so this isolates the per-line check from the per-block one.
  let msg = parseFails(body, boundary, limits)
  assert(msg != "", "a part with an over-long header line was accepted")
  assert(indexOf(msg, "header line") >= 0, "wrong error for over-long header line: ${msg}")
}

test "a part whose total header block is over the limit fails" {
  let boundary = "B"
  // Ten header lines, each well under maxHeaderLineBytes on its own, whose
  // sum exceeds maxPartHeaderBytes -- isolates the per-block check.
  let padding = repeat("y", 40)
  let extra = "X-Pad: ${padding}\r\n"
  let headers = "Content-Disposition: form-data; name=\"f\"\r\n" +
    extra +
    extra +
    extra +
    extra +
    extra +
    extra +
    extra +
    extra +
    extra +
    extra
  let body = "--${boundary}\r\n" + headers + "\r\nvalue\r\n--${boundary}--\r\n"
  let limits = tinyLimits()
  limits.maxBodyBytes = len(body) + 100
  limits.maxPartHeaderBytes = 300
  let msg = parseFails(body, boundary, limits)
  assert(msg != "", "a part with an over-limit header block was accepted")
  assert(indexOf(msg, "header block") >= 0, "wrong error for over-limit header block: ${msg}")
}

// --- untrusted filename: never sanitised, never path-joined --------------

test "a path-traversal filename is returned exactly, unmodified" {
  let boundary = "B"
  let body = twoFieldsOneFile(boundary, "../../etc/passwd", "text/plain", "not real passwd content")
  let form = parseMultipart([]byte(body), boundary, defaultLimits()) catch e {
    assert(false, "parse failed: ${e.message()}")
    return
  }
  let f = form.file("upload") catch e {
    let msg = e.message()
    assert(false, "file(\"upload\") failed: ${msg}")
    return
  }
  assert(
    f.filename == "../../etc/passwd",
    "filename = \"${f.filename}\", want the literal string \"../../etc/passwd\" unmodified",
  )
}

// --- malformed boundary: missing, or never closing ------------------------

test "an empty boundary argument fails, specifically as a malformed boundary" {
  let body = twoFieldsOneFile("B", "a.txt", "text/plain", "x")
  let msg = parseFails(body, "", defaultLimits())
  assert(msg != "", "an empty boundary argument was accepted")
  // "missing or malformed" is validBoundary's own message text, distinct
  // from afterDelimiterLine's "malformed boundary line" -- both happen to
  // contain the word "boundary", which is not enough to prove which check
  // actually fired (a mutation disabling validBoundary alone still passed
  // a looser "contains boundary" assertion here, via a different failure
  // further into the parse).
  assert(indexOf(msg, "missing or malformed") >= 0, "wrong error for empty boundary: ${msg}")
}

test "a boundary containing an RFC 2046-illegal character fails, body otherwise well-formed" {
  // "!" is not in bcharsnospace (RFC 2046 §5.1.1). The body is built with
  // this exact string as its literal delimiter, so if validBoundary did not
  // gate this, the rest of the parser would happily accept it -- this test
  // isolates validBoundary from every other check.
  let boundary = "bad!boundary"
  let body = twoFieldsOneFile(boundary, "a.txt", "text/plain", "x")
  let msg = parseFails(body, boundary, defaultLimits())
  assert(msg != "", "a boundary with an illegal '!' byte was accepted")
  assert(indexOf(msg, "missing or malformed") >= 0, "wrong error for illegal boundary byte: ${msg}")
}

test "a boundary absent from the body fails, specifically as delimiter-not-found" {
  let body = twoFieldsOneFile("ActualBoundary", "a.txt", "text/plain", "x")
  let msg = parseFails(body, "NeverAppearsInBody", defaultLimits())
  assert(msg != "", "a body missing the given boundary was accepted")
  assert(indexOf(msg, "not found in body") >= 0, "wrong error for missing boundary: ${msg}")
}

test "a body whose last part never reaches a closing boundary fails" {
  let boundary = "B"
  // No closing "--B--", and no further "\r\n--B" at all -- the part's body
  // simply runs off the end of the input.
  let body = "--${boundary}\r\n" +
    "Content-Disposition: form-data; name=\"f\"\r\n" +
    "\r\n" +
    "value with no terminator at all"
  let msg = parseFails(body, boundary, defaultLimits())
  assert(msg != "", "an unterminated multipart body was accepted")
  assert(indexOf(msg, "never closes") >= 0, "wrong error for unterminated body: ${msg}")
}

// --- zero limits reject, they never mean unlimited ------------------------

test "a zero body-size limit rejects a nonempty body outright" {
  let body = twoFieldsOneFile("B", "a.txt", "text/plain", "x")
  let limits = tinyLimits()
  limits.maxBodyBytes = 0
  let msg = parseFails(body, "B", limits)
  assert(msg != "", "a zero maxBodyBytes limit allowed a nonempty body through")
  assert(indexOf(msg, "body exceeds") >= 0, "wrong error for zero maxBodyBytes: ${msg}")
}

test "a zero part-count limit rejects a body with any part at all" {
  let body = twoFieldsOneFile("B", "a.txt", "text/plain", "x")
  let limits = tinyLimits()
  limits.maxBodyBytes = len(body) + 100
  limits.maxParts = 0
  let msg = parseFails(body, "B", limits)
  assert(msg != "", "a zero maxParts limit allowed a part through")
  assert(indexOf(msg, "too many parts") >= 0, "wrong error for zero maxParts: ${msg}")
}

test "every field of Limits set to zero rejects a real body, not allows it" {
  let body = twoFieldsOneFile("B", "a.txt", "text/plain", "x")
  let limits = Limits{
    maxBodyBytes: 0,
    maxFileBytes: 0,
    maxParts: 0,
    maxHeaderLineBytes: 0,
    maxPartHeaderBytes: 0,
  }
  let msg = parseFails(body, "B", limits)
  assert(msg != "", "an all-zero Limits value allowed a real body through")
}
