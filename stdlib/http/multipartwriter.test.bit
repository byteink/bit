// stdlib/http/multipartwriter.test.bit — FormBuilder (RFC 7578, #7326). Same
// module as ./multipartwriter.bit and ./multipart.bit (SPEC §19): the parser is
// the oracle, every body is read back through it.

fn boundaryOf(contentType: string): string {
  let at = indexOf(contentType, "boundary=")
  assert(at >= 0, "no boundary in: ${contentType}")
  return contentType[at + 9:]
}

fn parseBack(r: FormBody): Form {
  return parseMultipart([]byte(r.body), boundaryOf(r.contentType), defaultLimits()) catch e {
    assert(false, "parse: ${e.message()}")
    return Form{ fields = []FormField(0), files = []FormFile(0) }
  }
}

fn built(b: FormBuilder): FormBody {
  return b.build() catch e {
    assert(false, "build: ${e.message()}")
    return FormBody{ contentType = "", body = "" }
  }
}

fn allBytes(): []byte {
  let out = []byte(0, 256)
  let i = 0
  while (i < 256) {
    out = append(out, u8(i))
    i = i + 1
  }
  return out
}

test "text fields, a binary file and an escaped name read back byte for byte" {
  let b = FormBuilder()
  b.field("to", "a@example.com") catch e { assert(false, e.message()) }
  b.field("to", "b@example.com") catch e { assert(false, e.message()) }
  b.field("say \"hi\" \\ there", "v\r\n--x\r\n") catch e { assert(false, e.message()) }
  b.field("empty", "") catch e { assert(false, e.message()) }
  b.file("up", "a \"q\".bin", "image/png", allBytes()) catch e { assert(false, e.message()) }
  b.file("plain", "", "", []byte("hello")) catch e { assert(false, e.message()) }
  let r = built(b)
  assert(hasPrefix(r.contentType, "multipart/form-data; boundary="), r.contentType)
  let f = parseBack(r)
  assert(len(f.fields) == 4, "${len(f.fields)} fields")
  assert(f.fields[0].name == "to" && f.fields[0].value == "a@example.com", "first to")
  assert(f.fields[1].value == "b@example.com", "second to")
  assert(f.fields[2].name == "say \"hi\" \\ there", "name: ${f.fields[2].name}")
  assert(f.fields[2].value == "v\r\n--x\r\n", "value")
  assert(f.value("empty") == "" && f.fields[3].name == "empty", "empty field")
  assert(len(f.files) == 2, "${len(f.files)} files")
  assert(f.files[0].filename == "a \"q\".bin", "filename: ${f.files[0].filename}")
  assert(f.files[0].contentType == "image/png", f.files[0].contentType)
  assert(string(f.files[0].content) == string(allBytes()), "binary content changed")
  assert(f.files[1].filename == "" && f.files[1].contentType == "application/octet-stream", "default type")
  assert(string(f.files[1].content) == "hello", "plain content")
}

test "the boundary is 41 boundary bytes, fresh per build, and in no part" {
  let b = FormBuilder()
  b.field("a", "x") catch e { assert(false, e.message()) }
  let one = boundaryOf(built(b).contentType)
  let two = boundaryOf(built(b).contentType)
  assert(len(one) == 41 && hasPrefix(one, "bit-form-"), one)
  assert(one != two, "two builds drew the same boundary")
  assert(validBoundary(one), "not a valid boundary: ${one}")
}

test "a boundary found in any part is dropped for the next candidate" {
  let b = FormBuilder()
  b.field("bit-form-aaaa", "x") catch e { assert(false, e.message()) }
  b.field("k", "x bit-form-bbbb y") catch e { assert(false, e.message()) }
  b.file("f", "bit-form-cccc", "text/plain", []byte("--bit-form-dddd")) catch e { assert(false, e.message()) }
  let candidates = ["bit-form-aaaa", "bit-form-bbbb", "bit-form-cccc", "bit-form-dddd", "bit-form-eeee"]
  let n = 0
  let r = b.buildWith(() => {
    n = n + 1
    return candidates[n - 1]
  }) catch e {
    assert(false, "build: ${e.message()}")
    return
  }
  assert(n == 5 && boundaryOf(r.contentType) == "bit-form-eeee", "${n} draws, ${r.contentType}")
  let f = parseBack(r)
  assert(f.fields[0].name == "bit-form-aaaa" && f.fields[1].value == "x bit-form-bbbb y", "fields")
  assert(string(f.files[0].content) == "--bit-form-dddd", "file part")
}

test "no parts and no free boundary are refused" {
  let b = FormBuilder()
  b.build() catch e {
    assert(indexOf(e.message(), "at least one part") >= 0, e.message())
    b.field("a", "same") catch e2 { assert(false, e2.message()) }
    b.buildWith(() => "same") catch e3 {
      assert(indexOf(e3.message(), "every boundary tried") >= 0, e3.message())
      return
    }
    assert(false, "a boundary that occurs in a part was used")
    return
  }
  assert(false, "an empty form was built")
}

test "a CR, LF or NUL in a name, filename or content type is refused" {
  let b = FormBuilder()
  let bad = ["a\r\nX: y", "a\nb", "a\rb", "a\u{0}b"]
  for s of bad {
    b.field(s, "v") catch e {
      assert(indexOf(e.message(), "CR") >= 0, e.message())
      continue
    }
    assert(false, "field name accepted")
  }
  b.file("f", "x\r\n", "text/plain", []byte("")) catch e { assert(indexOf(e.message(), "CR") >= 0, e.message()) }
  b.file("f", "x", "text/plain\r\nX: y", []byte("")) catch e { assert(indexOf(e.message(), "CR") >= 0, e.message()) }
  assert(len(b.parts) == 0, "a refused part was kept")
}

test "a large file part is one buffer and reads back" {
  let b = FormBuilder()
  let big = repeat("0123456789abcdef", 65536)
  b.file("big", "big.bin", "application/octet-stream", []byte(big)) catch e { assert(false, e.message()) }
  let r = built(b)
  assert(len(r.body) > len(big), "body shorter than its file")
  let f = parseBack(r)
  assert(string(f.files[0].content) == big, "1 MiB file changed")
}
