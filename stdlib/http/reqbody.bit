// Bit standard library — http module: a client request body and the HTTP/1.1
// request it goes out in.
//
// A body is carried as the caller gave it, through redirects and to whichever
// protocol the origin speaks, and is never converted to the other kind: a
// `Body.Bytes` is written to the socket after the head as a second write and
// the h2/h3 engines frame it as it is (#7378); a `Body.Text` leaves HTTP/1.1
// in one write with its head.

// A request body for `Client.request`: `Text` for a string, `Bytes` for bytes
// sent as they are, never copied (a `FormBody.body`). A `Bytes` body is the
// caller's slice, so it must not change until the request returns.
export enum Body {
  Text(string)
  Bytes([]byte)

  size(): int {
    match (this) {
      Text(s) => return len(s)
      Bytes(b) => return len(b)
    }
  }

  // The body as the h2/h3 engines take it: `Bytes` itself, `Text` copied.
  bytes(): []byte {
    match (this) {
      Text(s) => return []byte(s)
      Bytes(b) => return b
    }
  }
}

// The body of a request that has none, shared by every such request.
let noBody: Body = Body.Text("")

// `s` as a request body; "" is `noBody`, so a request without one allocates
// nothing for it.
fn textBody(s: string): Body {
  if (len(s) == 0) {
    return noBody
  }
  return Body.Text(s)
}

// The HTTP/1.1 request head for `method u.path` with `body`, through the blank
// line that ends it. `closeAfter` adds `Connection: close`, asking the server
// to end the connection after the response so `readResponse` can fall back to
// end-of-stream framing when neither Content-Length nor Transfer-Encoding is
// present; without it the connection is persistent (RFC 9112 §9.3) and the pool
// (pool.bit) may reuse it. `headerBlock` is extra request headers, already
// validated and serialized by `serializeHeaders` (reqheader.bit, #2290) —
// inserted verbatim, after the framing lines this function owns and before
// Content-Length, so a caller can never override either by supplying a
// same-named header (those names are rejected earlier, by
// `isReservedRequestHeader`).
fn buildRequest(
  method: string,
  u: Url,
  headerBlock: string,
  body: Body,
  closeAfter: bool,
): string {
  let req = "${method} ${u.path} HTTP/1.1\r\n"
  req = req + "Host: ${hostHeaderValue(u)}\r\n"
  if (closeAfter) {
    req = req + "Connection: close\r\n"
  }
  req = req + headerBlock
  if (body.size() > 0) {
    return req + "Content-Length: ${itoa(body.size())}\r\n\r\n"
  }
  return req + "\r\n"
}

// Writes the request `head` (from `buildRequest`) and `body` on `s`: a `Text`
// body in the same write as the head, a `Bytes` one straight after it.
fn writeRequest(s: byteStream, head: string, body: Body): ()! {
  match (body) {
    Text(t) => s.writeStr(head + t)?
    Bytes(b) => {
      s.writeStr(head)?
      if (len(b) > 0) {
        s.writeBytes(b)?
      }
    }
  }
}
