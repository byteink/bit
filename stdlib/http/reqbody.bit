// Bit standard library — http module: a client request body and the HTTP/1.1
// request it goes out in.
//
// A body reaches the client as the caller's `string` (`Client.request` and the
// rest) or as the caller's `[]byte` (`Client.requestBytes`, #7378: a
// multipart upload `FormBuilder` built). Either is carried as it was given,
// through redirects and to whichever protocol the origin speaks, and is never
// converted to the other: a `[]byte` body is written to the socket after the
// head as a second write, and the h2/h3 engines frame it as it is. A `string`
// body leaves HTTP/1.1 in one write with its head, as it always has.

// A request body: `text`, or `raw` when `isRaw`. The `[]byte` is the caller's,
// not a copy, so the caller must not change it until the request returns.
class reqBody {
  text: string
  raw: []byte
  isRaw: bool

  size(): int {
    if (this.isRaw) {
      return len(this.raw)
    }
    return len(this.text)
  }

  // The body as the h2/h3 engines take it: `raw` itself, or `text` copied.
  bytes(): []byte {
    if (this.isRaw) {
      return this.raw
    }
    return []byte(this.text)
  }
}

// The body of a request that has none, shared by every such request.
let noBody: reqBody = reqBody{ text = "", isRaw = false }

// `s` as a request body; "" is `noBody`.
fn textBody(s: string): reqBody {
  if (len(s) == 0) {
    return noBody
  }
  return reqBody{ text = s, isRaw = false }
}

// `b` as a request body, held by reference; empty is `noBody`.
fn rawBody(b: []byte): reqBody {
  if (len(b) == 0) {
    return noBody
  }
  return reqBody{ raw = b, isRaw = true }
}

// The HTTP/1.1 request head for `method u.path` with `body`, through the blank
// line that ends it. `closeAfter` adds `Connection: close`, asking the server
// to end the connection after the response so `readResponse` can fall back to
// end-of-stream framing when neither Content-Length nor Transfer-Encoding is
// present; without it the connection is persistent (RFC 9112 §9.3) and the pool
// (pool.bit) may reuse it. `headerBlock` is extra request headers, already
// validated and serialized by `serializeHeaders` (reqheader.bit, #2290) —
// inserted verbatim, after the framing lines this function owns and before
// Content-Length, so a caller can never override either by supplying a
// same-named header (those names are rejected earlier, by
// `isReservedRequestHeader`).
fn buildRequest(
  method: string,
  u: Url,
  headerBlock: string,
  body: reqBody,
  closeAfter: bool,
): string {
  let req = "${method} ${u.path} HTTP/1.1\r\n"
  req = req + "Host: ${hostHeaderValue(u)}\r\n"
  if (closeAfter) {
    req = req + "Connection: close\r\n"
  }
  req = req + headerBlock
  if (body.size() > 0) {
    return req + "Content-Length: ${itoa(body.size())}\r\n\r\n"
  }
  return req + "\r\n"
}

// Writes the request `head` (from `buildRequest`) and `body` on `s`: a `string`
// body in the same write as the head, a `[]byte` one straight after it.
fn writeRequest(s: byteStream, head: string, body: reqBody): ()! {
  if (!body.isRaw) {
    s.writeStr(head + body.text)?
    return
  }
  s.writeStr(head)?
  s.writeBytes(body.raw)?
}
