// stdlib/http/framing.test.bit — request and response smuggling vectors
// (RFC 9112 §6.3, #6596) and field-syntax violations that hide a framing field
// from one parser and not another (RFC 9112 §5, #6710).
//
// A message with differing Content-Length fields, or with Content-Length and
// Transfer-Encoding together, has no framing both ends agree on: the next hop
// reads the other number, and on a reused connection that is a smuggled
// message. Every reader must refuse it before a body byte is read, and the
// same vectors run through all four of them: `readMessage` (the server),
// `readResponse` (the client), `readResponseStreaming` (streambody.bit) and
// `framingOf` (the BodyReader, bodyreader.bit). `newScript`, `scriptedStream`,
// `capturingSink`, `sinkInto` and `itoa` are the module's other test files'
// (SPEC §19); nothing is imported here.

// One vector: the field lines the head carries and what the error must say.
class framingCase {
  fields: string,
  want: string,
}

fn framingCases(): []framingCase {
  return [
    framingCase{
      fields = "Content-Length: 5\r\nContent-Length: 50\r\n",
      want = "conflicting Content-Length",
    },
    framingCase{
      fields = "Content-Length: 5\r\ncontent-length: 6\r\n",
      want = "conflicting Content-Length",
    },
    framingCase{
      fields = "Content-Length: 5\r\nX: y\r\nContent-Length: 5\r\nContent-Length: 6\r\n",
      want = "conflicting Content-Length",
    },
    framingCase{
      fields = "Content-Length: 5\r\nTransfer-Encoding: chunked\r\n",
      want = "both present",
    },
    framingCase{
      fields = "Transfer-Encoding: chunked\r\nContent-Length: 5\r\n",
      want = "both present",
    },
    framingCase{
      fields = "Content-Length:\r\nTransfer-Encoding: chunked\r\n",
      want = "both present",
    },
    framingCase{ fields = "Content-Length: 5\r\nTransfer-Encoding:\r\n", want = "both present" },
    framingCase{
      fields = "Transfer-Encoding: chunked\r\nTransfer-Encoding: chunked\r\n",
      want = "more than one Transfer-Encoding",
    },
    framingCase{ fields = "Transfer-Encoding:\r\n", want = "unsupported Transfer-Encoding" },
    framingCase{ fields = "Content-Length: 5, 5\r\n", want = "invalid Content-Length" },
    framingCase{ fields = "Content-Length:\r\n", want = "invalid Content-Length" },
    framingCase{ fields = "Content-Length: +5\r\n", want = "invalid Content-Length" },
  ]
}

fn viaServer(fields: string): string {
  let st = newScript("POST /u HTTP/1.1\r\nHost: x\r\n${fields}\r\nhello", 64)
  readMessage(st, 1024) catch e {
    return e.message()
  }
  return ""
}

fn viaClient(fields: string): string {
  let st = newScript("HTTP/1.1 200 OK\r\n${fields}\r\nhello", 64)
  readResponse(st, "GET", 1024) catch e {
    return e.message()
  }
  return ""
}

fn viaStreaming(fields: string): string {
  let st = newScript("HTTP/1.1 200 OK\r\n${fields}\r\nhello", 64)
  let sink = capturingSink{ parts = []string(0) }
  readResponseStreaming(st, "GET", 1024, sinkInto(sink)) catch e {
    return e.message()
  }
  return ""
}

fn viaReader(fields: string): string {
  framingOf(fields, "GET", 200) catch e {
    return e.message()
  }
  return ""
}

fn assertRefused(who: string, got: string, c: framingCase) {
  assert(got != "", "${who} accepted '${c.fields}'")
  assert(indexOf(got, c.want) >= 0, "${who} refused '${c.fields}' with '${got}', want '${c.want}'")
}

test "differing Content-Length fields and Content-Length with Transfer-Encoding are refused by every reader" {
  let cases = framingCases()
  let i = 0
  while (i < len(cases)) {
    let c = cases[i]
    assertRefused("readMessage", viaServer(c.fields), c)
    assertRefused("readResponse", viaClient(c.fields), c)
    assertRefused("readResponseStreaming", viaStreaming(c.fields), c)
    assertRefused("framingOf", viaReader(c.fields), c)
    i = i + 1
  }
}

test "repeated Content-Length fields that agree are one length, not an error" {
  let fields = "Content-Length: 5\r\nX: y\r\nContent-Length: 5\r\n"
  assert(viaServer(fields) == "", "readMessage: '${viaServer(fields)}'")
  assert(viaClient(fields) == "", "readResponse: '${viaClient(fields)}'")
  assert(viaStreaming(fields) == "", "readResponseStreaming: '${viaStreaming(fields)}'")
  assert(viaReader(fields) == "", "framingOf: '${viaReader(fields)}'")
  let st = newScript("HTTP/1.1 200 OK\r\n${fields}\r\nhelloEXTRA", 64)
  let res = readResponse(st, "GET", 1024) catch e {
    assert(false, "readResponse: ${e.message()}")
    return
  }
  assert(res.body == "hello", "body '${res.body}'")
}

test "a refused request consumed its head and no body byte" {
  let head = "POST /u HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nContent-Length: 50\r\n\r\n"
  let st = newScript(head + "hello", 4096)
  let req = readMessage(st, 1024) catch _ {
    assert(st.reads == 1, "reads = ${itoa(st.reads)}")
    return
  }
  assert(false, "readMessage accepted differing Content-Length fields: ${req.body}")
}

test "a GET with neither framing field still frames as before" {
  assert(viaServer("") == "", "readMessage: '${viaServer("")}'")
  assert(viaReader("X: y\r\n") == "", "framingOf")
}

// Field lines a front proxy may read as framing fields and this parser does
// not, or the reverse (RFC 9112 §5.1, §5.2, §5.5): whitespace between the name
// and the colon, obs-fold, an empty name, a bare CR, LF or NUL. Each is a hard
// error in every reader; the request or response is never framed by guessing.
fn syntaxCases(): []framingCase {
  let bad = "malformed header field line"
  let ctl = "control character"
  return [
    framingCase{ fields = "Content-Length: 5\r\nTransfer-Encoding : chunked\r\n", want = bad },
    framingCase{ fields = "Content-Length: 5\r\nTransfer-Encoding\t: chunked\r\n", want = bad },
    framingCase{ fields = "Content-Length: 5\r\ntransfer-encoding  \t: chunked\r\n", want = bad },
    framingCase{ fields = "Transfer-Encoding : chunked\r\n", want = bad },
    framingCase{ fields = "Content-Length : 5\r\n", want = bad },
    framingCase{ fields = "X: y\r\nContent-Length\t: 5\r\n", want = bad },
    framingCase{ fields = "X: y\r\nContent-Length : 5\r\n", want = bad },
    framingCase{ fields = "X-Other : y\r\n", want = bad },
    framingCase{ fields = "X: a\r\n continued\r\n", want = bad },
    framingCase{ fields = "X: a\r\n\tcontinued\r\n", want = bad },
    framingCase{ fields = " Content-Length: 5\r\n", want = bad },
    framingCase{ fields = "X: a\r\n: novalue\r\n", want = bad },
    framingCase{ fields = ": novalue\r\n", want = bad },
    framingCase{ fields = "X: a\rb\r\n", want = ctl },
    framingCase{ fields = "X: a\nb\r\n", want = ctl },
    framingCase{ fields = "X: a\0b\r\n", want = ctl },
  ]
}

test "whitespace before the colon, obs-fold, an empty name and bare controls are refused by every reader" {
  let cases = syntaxCases()
  let i = 0
  while (i < len(cases)) {
    let c = cases[i]
    assertRefused("readMessage", viaServer(c.fields), c)
    assertRefused("readResponse", viaClient(c.fields), c)
    assertRefused("readResponseStreaming", viaStreaming(c.fields), c)
    // `framingOf` takes the block alone and reads no body, so a control byte
    // is `checkFieldSyntax`'s catch there too.
    assertRefused("framingOf", viaReader(c.fields), c)
    i = i + 1
  }
}

// The same heads with the space gone, and colons and spaces inside a VALUE
// (where they are ordinary text): none is refused.
test "the same field lines without the whitespace, and a colon inside a value, pass every reader" {
  let ok = []string{
    "Content-Length: 5\r\n",
    "Content-Length:5\r\n",
    "X: y\r\nContent-Length:\t5\r\n",
    "User-Agent: a (b : c) d\r\nX-Time: 10:20:30\r\nContent-Length: 5\r\n",
  }
  let i = 0
  while (i < len(ok)) {
    assert(viaServer(ok[i]) == "", "readMessage '${ok[i]}': ${viaServer(ok[i])}")
    assert(viaClient(ok[i]) == "", "readResponse '${ok[i]}': ${viaClient(ok[i])}")
    assert(viaStreaming(ok[i]) == "", "readResponseStreaming '${ok[i]}': ${viaStreaming(ok[i])}")
    assert(viaReader(ok[i]) == "", "framingOf '${ok[i]}': ${viaReader(ok[i])}")
    i = i + 1
  }
}

test "Transfer-Encoding: chunked without whitespace is framed as chunked by the server and the client" {
  let chunked = "5\r\nhello\r\n0\r\n\r\n"
  let st = newScript("POST /u HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n${chunked}", 64)
  let req = readMessage(st, 1024) catch e {
    assert(false, "readMessage: ${e.message()}")
    return
  }
  assert(req.body == "hello", "request body '${req.body}'")
  let cs = newScript("HTTP/1.1 200 OK\r\nTransfer-Encoding:chunked\r\n\r\n${chunked}", 64)
  let res = readResponse(cs, "GET", 1024) catch e {
    assert(false, "readResponse: ${e.message()}")
    return
  }
  assert(res.body == "hello", "response body '${res.body}'")
}
