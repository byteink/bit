// stdlib/http/h2tunnel.bit — the `byteStream` over an RFC 8441 extended-CONNECT
// tunnel (#6153), so `std/websocket`'s `Conn` runs the same RFC 6455 framing over
// an HTTP/2 stream that it runs over a socket (`netStream`/`tlsStream`,
// transport.bit). `ByteStream(h2 = Option.Some(t))?` is the constructor.
//
// Every operation is one call on the `H2Stream` (std/http2): a `readUp` is a
// `read`, a `writeStr` a `write` that returns once the bytes left under flow
// control, `shut` an orderly END_STREAM, `forceClose` an RST_STREAM(CANCEL) —
// RFC 8441 §5's two closes. There is no HTTP framing to skip: the tunnel starts
// after the 2xx.

class h2TunnelStream {
  t: H2Stream
  // Bytes `unread` pushed back, served before the next read.
  pending: string
  // The peer's address, read once off the connection that carried the CONNECT.
  peerValue: string

  readUp(n: int): string! {
    if (len(this.pending) > 0) {
      if (len(this.pending) <= n) {
        let out = this.pending
        this.pending = ""
        return out
      }
      let out = this.pending[0:n]
      this.pending = this.pending[n:len(this.pending)]
      return out
    }
    return this.t.read(n)?
  }

  writeStr(data: string): ()! { this.t.write(data)? }

  writeBytes(b: []byte): ()! { this.t.write(string(b))? }

  shut() { this.t.close() }

  forceClose() { this.t.reset(h2ErrCancel) }

  peer(): string { return this.peerValue }

  unread(extra: string) { this.pending = extra + this.pending }

  setIdleDeadline(deadlineNs: int) { this.t.setDeadline(deadlineNs) }
}
