// stdlib/http/tls.test.bit — the HTTPS accept-loop and read-deadline fixes
// (#5916): the TLS handshake moved off the accept loop and onto the
// connection's own task, and `TlsConn` gained a real deadline `tlsStream`
// forwards through.
//
// `TlsListener`, `TlsConn`, `TlsConfig`, `tlsListen` (aliasing std/tls's
// `listen`), `tlsDial`, `newTlsConfig`, `emptyTrustStore`, `newClientTls`,
// `serveTlsOn`, `serveOne`, `connOpts`, `tlsStream`, `newDrainState`,
// `defaultMaxBodyBytes`, `defaultMaxRequestsPerConn`, `tlsAcceptor`, `ok`,
// `dial`, `itoa` and `maxAcceptBackoffNs` are all module siblings (SPEC §19);
// only `decodeHex`/`pemEncode` (std/crypto) are new to this module.
// `sleep`/`Millisecond` (server.bit, shutdown.bit) and `Second`/`monotonic`
// (keepalive.test.bit, client.bit) are already imported by other files in
// this module — importing any of them again here would be E0042.

import { decodeHex, pemEncode } from "std/crypto"

// The same throwaway self-signed test leaf and key (SAN: localhost,
// example.com) `stdlib/smtp/tls.test.bit`, `stdlib/tls`'s own test files and
// several `_tests_/imports` fixtures already use.
const tls5916LeafHex: string = ""
const tls5916KeyHex: string = ""

fn tls5916Pem(label: string, h: string): string {
  let b = decodeHex(h) catch _ {
    return ""
  }
  return pemEncode(label, b)
}

// The server config: the leaf and its key, ALPN restricted to HTTP/1.1 so
// every test here runs the plain per-connection path, not h2 (`serveTlsConn`,
// server.bit).
fn tls5916ServerConfig(): TlsConfig {
  let cfg = newTlsConfig(emptyTrustStore())
  cfg.certPem = tls5916Pem("CERTIFICATE", tls5916LeafHex)
  cfg.keyPem = tls5916Pem("PRIVATE KEY", tls5916KeyHex)
  cfg.alpn = ["http/1.1"]
  return cfg
}

// The client config: this leaf's issuing CA is a throwaway test root no trust
// store here holds, so every client below skips verification — the tests are
// about the accept loop and the idle deadline, not certificate validation.
fn tls5916ClientConfig(): TlsConfig {
  let cfg = newTlsConfig(emptyTrustStore())
  cfg.insecureSkipVerify = true
  cfg.alpn = ["http/1.1"]
  return cfg
}

fn tls5916Echo(req: Request): Response {
  return ok("ok")
}

fn tls5916Serve(l: TlsListener) {
  serveTlsOn(l, tls5916Echo) catch _ {
    return
  }
}

// #5916, case 1: before this fix, `TlsListener.accept()` ran the TLS
// handshake inline, so `serveTlsOn`'s accept loop could not accept a second
// client until the first client's handshake finished — or, as here, never
// finished. A client that opens the TCP connection and sends no ClientHello
// at all used to block every later accept for as long as it stalled; on the
// old code this test's `getTimeout` call below times out because the server
// never even TCP-accepts the second client's connection.
test "a stalled ClientHello does not delay a second client's HTTPS request (#5916)" {
  let l = tlsListen("127.0.0.1", 0, tls5916ServerConfig()) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  spawn tls5916Serve(l)

  // The stalled client: a raw TCP connection that never sends a ClientHello.
  let stalled = dial("127.0.0.1", port) catch e {
    l.close()
    assert(false, "dial (stalled client): ${e.message()}")
    return
  }

  let res = newClientTls(tls5916ClientConfig()).getTimeout("https://127.0.0.1:${port}/", 3000) catch e {
    stalled.close()
    l.close()
    assert(false, "a stalled first client delayed the second client's request: ${e.message()}")
    return
  }
  assert(res.status == 200, "status = ${itoa(res.status)}")
  assert(res.body == "ok", "body = '${res.body}'")

  stalled.close()
  l.close()
}

// Reads `conn` until a genuine close (an empty result NOT caused by `conn`'s
// own deadline elapsing — `TlsConn.readTimedOut()` (std/tls) is the side
// channel that tells the two apart, since `read()` returns the same empty
// result either way) or the loop bound is hit. Mirrors
// `keepalive.test.bit`'s `drainUntilClosed`, adapted for `TlsConn`, which has
// no error-vs-close-distinguishing `readDeadline` of its own — only `read`.
fn tls5916DrainUntilClosed(conn: TlsConn): bool {
  let n = 0
  while (n < 100) {
    n = n + 1
    let chunk = conn.read(4096) catch _ {
      return false
    }
    if (len(chunk) == 0) {
      return !conn.readTimedOut()
    }
  }
  return false
}

fn tls5916ServeOneShortIdle(l: TlsListener) {
  let c = l.accept() catch _ {
    return
  }
  let opts = connOpts{
    altPort = 0, maxBody = defaultMaxBodyBytes,
    idleTimeoutNs = 50 * 1000000, maxRequests = defaultMaxRequestsPerConn,
  }
  serveOne(tlsStream{ conn = c }, tls5916Echo, opts, newDrainState())
}

// #5916, case 2: mirrors `keepalive.test.bit`'s "Server.setIdleTimeoutMs
// closes a connection whose Content-Length body stalls mid-read", over TLS.
// Before this fix, `tlsStream.setIdleDeadline` was a no-op (`TlsConn` had no
// deadline setter), so a stalled HTTPS request body was never closed — this
// test's read loop above would see its OWN 2-second deadline elapse first
// (`readTimedOut()` true) rather than a genuine close, and fail.
test "a stalled HTTPS request body is closed at the idle deadline (#5916, mirrors #5912)" {
  let l = tlsListen("127.0.0.1", 0, tls5916ServerConfig()) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  spawn tls5916ServeOneShortIdle(l)

  let conn = tlsDial("127.0.0.1", port, tls5916ClientConfig()) catch e {
    l.close()
    assert(false, "tlsDial: ${e.message()}")
    return
  }
  conn.setDeadline(monotonic().ns + 2 * Second)
  // Headers complete, Content-Length declares 10 body bytes, only 2 arrive.
  conn.write([]byte("POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 10\r\n\r\nab")) catch e {
    conn.close()
    l.close()
    assert(false, "write: ${e.message()}")
    return
  }
  sleep(300 * Millisecond)
  assert(
    tls5916DrainUntilClosed(conn),
    "a TLS connection whose Content-Length body stalled past the idle deadline was not closed",
  )
  conn.close()
  l.close()
}

// #5913's `fakeFailingListener` (server.test.bit), adapted for TLS: `real` is
// a genuine `TlsListener` bound over loopback, so every accept after the
// first `failures` simulated ones is answered for real. `serveTlsOn`'s
// parameter type is `tlsAcceptor` (server.bit, #5916) precisely so this can
// stand in for one — `TlsListener`'s fields are private to std/tls, so
// nothing here could otherwise fake an accept failure the way
// `fakeFailingListener` does for `Server.listener` (an `acceptor`).
class fakeFailingTlsListener {
  real: TlsListener
  failures: int
  fails: int
  export accept(): TlsConn! {
    if (this.fails < this.failures) {
      this.fails = this.fails + 1
      fail newError("fake accept failure (simulated EMFILE)")
    }
    return this.real.accept()?
  }
  export isClosed(): bool {
    return this.real.isClosed()
  }
  export port(): int! {
    return this.real.port()?
  }
}

fn tls5916BackoffServe(fake: fakeFailingTlsListener, endedWithError: chan<bool>) {
  serveTlsOn(fake, tls5916Echo) catch _ {
    endedWithError <- true
    return
  }
  endedWithError <- false
}

// #5916, case 3: before this fix, `serveTlsOn` passed `acceptLoop` a fixed
// `maxBackoffNs = 0` (no backoff at all — see `acceptLoop`'s own comment),
// because a handshake ran inline in `accept()` and a rejected handshake could
// not be told apart from a transient failure such as the fd limit. Now that
// the handshake has moved off `accept()`, `serveTlsOn` passes
// `maxAcceptBackoffNs`, the same backoff `listenAndServeOn` gives plain HTTP.
// This does not itself prove old code fails FAST — `maxBackoffNs = 0` retries
// immediately too — so what old code cannot do at all is COMPILE: `serveTlsOn`
// took a concrete `TlsListener`, and `fakeFailingTlsListener` is not one.
test "serveTlsOn retries a failed accept instead of ending, and still returns an error after close (#5916)" {
  let real = tlsListen("127.0.0.1", 0, tls5916ServerConfig()) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let fake = fakeFailingTlsListener{ real = real, failures = 3, fails = 0 }
  let port = fake.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let endedWithError = chan<bool>(1)
  spawn tls5916BackoffServe(fake, endedWithError)

  let res = newClientTls(tls5916ClientConfig()).getTimeout("https://127.0.0.1:${port}/", 3000) catch e {
    real.close()
    assert(false, "get after ${itoa(fake.failures)} simulated accept failures: ${e.message()}")
    return
  }
  assert(res.status == 200, "status = ${itoa(res.status)}")
  assert(
    fake.fails == fake.failures,
    "simulated accept failures seen = ${itoa(fake.fails)}, want ${itoa(fake.failures)}",
  )

  real.close()
  let sawError = <- endedWithError
  assert(sawError, "serveTlsOn returned without an error after real.close()")
}
