// Bit standard library — http module: the HTTP/2-over-ALPN glue.

// ---------------------------------------------------------------------------
// HTTP/2 over ALPN
// ---------------------------------------------------------------------------
//
// When a TLS handshake negotiates ALPN `h2`, the exchange runs over the
// `std/http2` connection engine instead of the HTTP/1.1 wire path. That engine
// drives its own reader/writer/loop green threads over an abstract byte
// `Transport`; `h2glueTransport` adapts a `TlsConn` to it. This is safe without a
// lock because TLS 1.3 keeps separate read (`appRead`) and write (`appWrite`)
// record state, so the engine's concurrent reader and writer touch disjoint halves
// of the connection. Requests and responses cross the http<->http2 boundary
// through the `h2glue*` mappers: the `:method`/`:scheme`/`:authority`/`:path` and
// `:status` pseudo-headers become the `Request`/`Response` fields, and the
// remaining fields become the raw header block this module carries. Every helper
// here is prefixed `h2glue`.

// Run `method u.path` with `body` over an established `TlsConn`, using the HTTP/2
// engine when ALPN negotiated `h2` and the HTTP/1.1 wire path otherwise. `block`
// is extra request headers, already validated and serialized by
// `serializeHeaders` (reqheader.bit, #2290) — "" for none.
fn httpsExchange(conn: TlsConn, method: string, u: Url, body: string, block: string): Response! {
  if (conn.alpnProtocol() == "h2") {
    return h2clientExchange(conn, method, u, body, block)?
  }
  return exchangeOn(tlsStream{ conn: conn }, buildRequest(method, u, block, body))?
}

// Adapt a `TlsConn` to the http2 engine's byte `Transport`. The engine's `read`
// is not fallible — a read error is end-of-stream — so the shim maps any TLS read
// failure to an empty slice, which the engine treats as a clean close. `TlsConn`
// itself already recorded whether that failure was this side's own read
// deadline elapsing (`readTimedOut()`, stdlib/tls/tls.bit, #3031) rather than
// the peer closing, so nothing needs recording again here — `h2clientExchange`
// reads it straight off `conn` once the round trip it was waiting on fails.
fn h2glueTransport(conn: TlsConn): H2Transport {
  return h2newTransport(
    (n) => {
      let b = conn.read(n) catch _ {
        return []byte(0)
      }
      return b
    },
    (b) => {
      h2glueWrite(conn, b)
    },
    () => {
      conn.close()
    },
  )
}

// Best-effort transport write for the http2 engine. A socket write failure is
// swallowed: the engine's reader observes the same closed transport and winds the
// connection down, and the writer thread is fire-and-forget, so propagating the
// error adds nothing. A named helper because an arrow closure cannot be fallible.
fn h2glueWrite(conn: TlsConn, b: []byte) {
  conn.write(b) catch _ {
    return
  }
}

// Run one request/response over the HTTP/2 engine on an h2-negotiated `TlsConn`,
// then tear the connection down (this module is one request per connection). A
// setup or round-trip failure closes the socket and propagates.
//
// `h2connect` spawns reader AND writer green threads (`stdlib/http2/conn.bit:193`)
// that park on the transport (reader) or an empty command channel (writer) for
// the life of the connection, and this runtime has no way to interrupt either
// park from outside. A bare `conn.close()` does not wake the reader — closing
// tears the fd down without notifying an already-parked reader at all
// (`std/net`'s `Conn.shutdown` doc comment has the verified mechanism) — so a
// still-parked reader is left retrying its read against whatever the OS has
// since done with the same fd number once this function returns and its caller
// opens the next connection: a later `dial()` in this same process, for
// instance, and the read can then return bytes that belong to that different
// connection entirely (#3016). The writer has the same fd-reuse exposure on
// its own next queued write, but neither `close()` nor `shutdown()` wakes it —
// it is parked on a channel, not the socket, and only the loop thread's own
// `eof` handling releases it (#3026, `stdlib/http2/events.bit`) once the
// reader's failure reaches the loop. So teardown here is always four steps in
// order: `conn.shutdown()` (the real wakeup — an orderly EOF the reader's next
// read observes), `hc.waitReaderDone()` (block until it has), `hc.waitWriterDone()`
// (block until the writer has followed, released by the loop's eof handling),
// THEN `conn.close()` (now provably safe to let something else reuse the fd).
//
// `h2connect`'s own failure path (a dead connection or an unresponsive peer
// before the peer's opening SETTINGS, #3019) already drains its reader and
// writer before returning the error — see `h2connAwaitReady` — so `conn.close()`
// there is just as safe as the four-step teardown above, without needing this
// function to repeat those waits for a `Conn` it never received. `conn.deadlineNs()`
// carries `getTimeout`'s whole-request deadline down into that wait, so a dead
// peer or one that never sends SETTINGS fails inside the caller's own
// deadline instead of parking forever.
fn h2clientExchange(conn: TlsConn, method: string, u: Url, body: string, block: string): Response! {
  let hc = h2connect(h2glueTransport(conn), h2defaultConfig(), conn.deadlineNs()) catch e {
    conn.close()
    fail e
  }
  let res = hc.roundTrip(h2glueRequestOf(method, u, body, block)) catch e {
    conn.shutdown()
    hc.waitReaderDone()
    hc.waitWriterDone()
    conn.close()
    fail h2glueDeadlineRelabel(e, conn)
  }
  conn.shutdown()
  hc.waitReaderDone()
  hc.waitWriterDone()
  conn.close()
  return h2glueResponse(res)
}

// Relabel a round-trip failure as a read timeout when the transport's
// terminal read failed because THIS side's own deadline elapsed
// (`conn.readTimedOut()`, stdlib/tls/tls.bit) rather than the peer closing or
// resetting a stream — otherwise a deadline expiry and an ordinary mid-stream
// peer close both arrive here as the identical generic message
// (`h2connFailAll`'s `"http2: connection closed"`, stdlib/http2/events.bit),
// and a caller cannot tell which one happened (#3031). `readTimedOut()` is
// only ever true when the reader thread's own read hit the deadline sentinel,
// so this never mislabels a genuine peer-driven failure (e.g. `RST_STREAM`,
// stdlib/http2/streams.bit) — those leave the flag false and `e` unchanged.
fn h2glueDeadlineRelabel(e: error, conn: TlsConn): error {
  if (conn.readTimedOut()) {
    return newError("http2: read timed out (${e.message()})")
  }
  return e
}

// Serve one h2-negotiated connection: run the http2 server engine and dispatch
// each stream to the transport-agnostic `handler`, mapping the http2 request and
// response to this module's types on the way in and out. Each response advertises
// the HTTP/3 endpoint on `altPort` via an Alt-Svc header. `d` is the owning
// server's drain tracker (`shutdown.bit`, #3963/#4314): this connection is
// registered idle until its first stream starts, then active for the rest of
// its life — a graceful shutdown force-closes it right away if idle, or sends
// GOAWAY and gives it up to its timeout to finish if active, exactly as
// `serveOne` does for HTTP/1.1 (server.bit). `serveTlsOn`'s call site passes a
// private, never-drained `d`, so this bookkeeping is a no-op cost there.
//
// `h2accept` spawns the same reader/writer/loop trio `h2connect` does
// (`stdlib/http2/conn.bit:193`), and `hc.serve()` additionally parks THIS green
// thread reading `hc.acceptCh` until the loop sends a stop (`stdlib/http2/events.bit`)
// — which happens when the loop observes the transport's own EOF, OR when this
// connection's `force` hook below calls `conn.shutdown()` to manufacture that
// same EOF from a graceful-shutdown timeout. So by the time `hc.serve()`
// returns, the reader has already hit that same EOF and is done touching the
// transport (that is what woke the loop in the first place) — `hc.waitReaderDone()`
// here is a bounded join, not a fresh wait, matching `h2clientExchange`'s teardown
// (`conn.shutdown()` -> `hc.waitReaderDone()` -> `hc.waitWriterDone()` ->
// `conn.close()`, #3016, #3026). `hc.waitWriterDone()` is bounded the same way
// `hc.waitReaderDone()` is: the same eof handling that released `hc.serve()`
// (via `acceptCh`) also queues the writer's stop (via `writeCh`), so both joins
// settle once the loop has run, not on a fresh unbounded wait. Calling
// `conn.shutdown()` here a second time, after the drain's own `force` already
// called it once, is safe — `net.Conn.shutdown` (stdlib/net/net.bit) is a plain
// idempotent syscall on a still-open fd, not a state transition guarded against
// re-entry the way `close()` is.
fn h2glueServe(conn: TlsConn, handler: (Request) => Response, altPort: int, d: drainState) {
  // No deadline: `serveTls` gives its handler no per-connection timeout
  // budget to thread through today, so this stays unbounded exactly as
  // before (#3019 is about `getTimeout`'s client-side deadline).
  let hc = h2accept(h2glueTransport(conn), h2defaultConfig(), 0) catch _ {
    conn.close()
    return
  }
  let id = drainRegister(
    d,
    () => {
      conn.shutdown()
    },
    () => {
      hc.close()
    },
  )
  defer drainDeregister(d, id)
  hc.serve(
    (r) => {
      drainMarkActive(d, id)
      return h2glueResponseOutAlt(handler(h2glueRequestIn(r)), altPort)
    },
  ) catch _ {
    conn.shutdown()
    hc.waitReaderDone()
    hc.waitWriterDone()
    conn.close()
    return
  }
  conn.shutdown()
  hc.waitReaderDone()
  hc.waitWriterDone()
  conn.close()
}

// Map this module's `Response` to an http2 response, first appending the Alt-Svc
// advertisement (when `altPort > 0`) so an HTTP/2 client learns the h3 endpoint.
fn h2glueResponseOutAlt(res: Response, altPort: int): H2Response {
  let out = res
  if (altPort > 0) {
    out.headers = out.headers + altSvcHeader(altPort)
  }
  return h2glueResponseOut(out)
}

// The HTTP/2 `:authority`: the host, with the port appended only when it is not
// the https default (443), matching how a client forms the pseudo-header.
fn h2glueAuthority(u: Url): string {
  if (u.port == 443) {
    return u.host
  }
  return "${u.host}:${itoa(u.port)}"
}

// Build an http2 request for `method u.path` with `body` over scheme https.
// `block` is extra request headers, already validated and serialized by
// `serializeHeaders` (reqheader.bit, #2290) — "" for none; `h2glueFields`
// parses it into fields the same way it already does for a raw response
// block, dropping any connection-specific name a caller's validation missed
// (defence in depth: `isReservedRequestHeader` already rejects those earlier).
fn h2glueRequestOf(method: string, u: Url, body: string, block: string): H2Request {
  return H2Request{
    method: method,
    scheme: "https",
    authority: h2glueAuthority(u),
    path: u.path,
    headers: h2glueFields([]H2HeaderField(0), block),
    body: []byte(body),
  }
}

// Whether a lower-case header `name` is a connection-specific field forbidden on
// an HTTP/2 stream (RFC 9113 §8.2.2). Content-Length is dropped too — the engine
// frames the body, so an explicit length is redundant.
fn h2glueHopByHop(name: string): bool {
  return name == "connection" ||
    name == "keep-alive" ||
    name == "proxy-connection" ||
    name == "transfer-encoding" ||
    name == "upgrade" ||
    name == "content-length"
}

// Serialize an http2 header-field list into this module's raw "Name: value\r\n"
// block, so `header()` reads it exactly as an HTTP/1.1 block.
fn h2glueBlock(fields: []H2HeaderField): string {
  let block = ""
  for f of fields {
    block = block + "${f.name}: ${f.value}\r\n"
  }
  return block
}

// Parse a raw "Name: value\r\n" block into http2 header fields, lower-casing each
// name (HTTP/2 requires it) and dropping connection-specific headers. Appends to
// `dst`. Bounded: each turn consumes at least one line from `rest`. Shared by the
// response path (`h2glueResponseOut`) and, since #2290, the outgoing-request path
// (`h2glueRequestOf`) — both always pass a freshly built `dst`, never one held
// elsewhere, so the append-aliasing note below stays true for either caller.
fn h2glueFields(dst: []H2HeaderField, block: string): []H2HeaderField {
  let out = dst
  let rest = block
  while (len(rest) > 0) {
    let eol = indexOf(rest, "\r\n")
    let line = rest
    if (eol >= 0) {
      line = rest[0:eol]
      rest = rest[eol + 2:len(rest)]
    } else {
      rest = ""
    }
    let colon = indexOf(line, ":")
    if (colon < 0) {
      continue
    }
    let name = toLower(trimSpace(line[0:colon]))
    if (len(name) == 0 || h2glueHopByHop(name)) {
      continue
    }
    // bit:lint allow E0214 -- unexported; every call site discards or never rereads its pre-call slice (see this function's doc comment)
    out = append(
      out,
      H2HeaderField{ name: name, value: trimSpace(line[colon + 1:len(line)]), sensitive: false },
    )
  }
  return out
}

// Map an http2 response to this module's `Response`: `:status` is the status, the
// remaining fields become the raw header block, and Content-Type is read from it
// just as on the HTTP/1.1 path.
fn h2glueResponse(res: H2Response): Response {
  let block = h2glueBlock(res.headers)
  return Response{
    status: res.status,
    contentType: header(block, "content-type"),
    headers: block,
    body: string(res.body),
  }
}

// Map an http2 request to this module's `Request`, flattening the header fields to
// a raw header block.
fn h2glueRequestIn(req: H2Request): Request {
  return Request{
    method: req.method,
    path: req.path,
    headers: h2glueBlock(req.headers),
    body: string(req.body),
  }
}

// Map this module's `Response` to an http2 response: Content-Type becomes a header
// field, the raw header block is parsed into fields, and the body carries over.
// The engine adds `:status` and frames the body itself.
fn h2glueResponseOut(res: Response): H2Response {
  let fields = []H2HeaderField(0)
  if (len(res.contentType) > 0) {
    fields = append(
      fields,
      H2HeaderField{ name: "content-type", value: res.contentType, sensitive: false },
    )
  }
  fields = h2glueFields(fields, res.headers)
  return H2Response{ status: res.status, headers: fields, body: []byte(res.body) }
}
