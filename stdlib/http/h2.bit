// Bit standard library — http module: the HTTP/2-over-ALPN glue.

// ---------------------------------------------------------------------------
// HTTP/2 over ALPN
// ---------------------------------------------------------------------------
//
// When a TLS handshake negotiates ALPN `h2`, the exchange runs over the
// `std/http2` connection engine instead of the HTTP/1.1 wire path. That engine
// drives its own reader/writer/loop green threads over an abstract byte
// `Transport`; `h2glueTransport` adapts a `TlsConn` to it. This is safe without a
// lock because TLS 1.3 keeps separate read (`appRead`) and write (`appWrite`)
// record state, so the engine's concurrent reader and writer touch disjoint halves
// of the connection. Requests and responses cross the http<->http2 boundary
// through the `h2glue*` mappers: the `:method`/`:scheme`/`:authority`/`:path` and
// `:status` pseudo-headers become the `Request`/`Response` fields, and the
// remaining fields become the raw header block this module carries. Every helper
// here is prefixed `h2glue`.

// The http2 engine configuration this module runs a connection under: the RFC
// defaults (`h2defaultConfig`) with `maxBody` as the per-stream body budget
// (#4590).
//
// This is the whole of the plumbing that makes one `setMaxBodyBytes` bound both
// protocols. `std/http2`'s `Config.maxBodyBytes` defaults to the same 32 MiB
// `defaultMaxBodyBytes` does (stdlib/http2/conn.bit spells out why the constant
// is duplicated rather than imported), so a caller that sets neither gets the
// same number either way; a caller that sets one gets it on both.
fn h2glueConfig(maxBody: int): H2Config {
  let cfg = h2defaultConfig()
  cfg.maxBodyBytes = maxBody
  return cfg
}

// Adapt a `TlsConn` to the http2 engine's byte `Transport`. The engine's `read`
// is not fallible — a read error is end-of-stream — so the shim maps any TLS read
// failure to an empty slice, which the engine treats as a clean close. A client
// connection carries no read deadline of its own (`h2glueOpen`), so an empty
// read there is always the peer or a teardown; a request's own timeout is the
// round trip's (`h2clientExchange`).
fn h2glueTransport(conn: TlsConn): H2Transport {
  return H2Transport(
    (n) => {
      let b = conn.read(n) catch _ {
        return []byte(0)
      }
      return b
    },
    (b) => {
      h2glueWrite(conn, b)
    },
    () => {
      conn.close()
    },
  )
}

// Best-effort transport write for the http2 engine. A socket write failure is
// swallowed: the engine's reader observes the same closed transport and winds the
// connection down, and the writer thread is fire-and-forget, so propagating the
// error adds nothing. A named helper because an arrow closure cannot be fallible.
fn h2glueWrite(conn: TlsConn, b: []byte) {
  conn.write(b) catch _ {
    return
  }
}

// Open the shared HTTP/2 connection of `key` over an h2-negotiated `TlsConn`:
// run the `std/http2` engine on it and return the `h2Entry` (h2pool.bit) that
// owns it, created holding ONE reference for the request that dialed it. A
// setup failure closes the socket and propagates. The connection's stream cap
// is the lower of the peer's SETTINGS_MAX_CONCURRENT_STREAMS and
// `PoolLimits.maxH2Streams`; a peer that allows no stream at all fails here,
// loudly, rather than parking every request forever.
//
// No deadline stays on `tc`: whatever `dialTlsConn` armed is read off it, used
// to bound the wait for the peer's opening SETTINGS (`h2connect`'s `deadlineNs`),
// and cleared BEFORE the engine's reader starts, because that deadline is the
// dialing request's own and a shared connection outlives it. Each request
// bounds itself instead (`h2clientExchange`).
//
// A request with a `Cancel` (cancel.bit, #7662) also ends that wait on
// `cancel()`: the connection being set up has no other stream, so it is shut and
// the request fails with `Cancelled`.
fn h2glueOpen(tc: TlsConn, key: string, extras: RequestExtras): h2Entry! {
  let dl = tc.deadlineNs()
  tc.setDeadline(0)
  let wake = chan<int>(1)
  let wid = cancelWait(extras.cancel, wake)
  defer cancelUnwait(extras.cancel, wid)
  let hc = h2connect(h2glueTransport(tc), h2glueConfig(extras.maxBody), dl, Option.Some(wake)) catch e {
    tc.close()
    let (_, aborted) = e.(H2Aborted)
    if (aborted) {
      fail Cancelled{ op = "send" }
    }
    fail e
  }
  let streams = hc.peerMaxStreams()
  if (streams > extras.pool.limits.maxH2Streams) {
    streams = extras.pool.limits.maxH2Streams
  }
  if (streams < 1) {
    h2teardown(tc, hc)
    fail newError("http2: ${key} allows no concurrent streams")
  }
  return h2Entry{
    id = 0, key = key, tc = tc, hc = hc, slots = chan<int>(streams), streamCap = streams,
    inflight = 1, lastUse = monotonic().ns, retired = false, torn = false,
  }
}

// Run one request/response as a stream on the shared connection `e`, holding a
// stream slot for its whole life and bounded by `extras.deadline` (0 = none).
// The caller owns the reference on `e` and releases it (`h2Pool.release`).
// Fails when the connection is at its stream cap for the whole deadline, or
// when the round trip fails; the second case also retires `e`, because a
// timed-out or reset stream leaves the engine's view of the connection
// uncertain and the next request must dial a new one.
//
// A request with a `Cancel` (cancel.bit, #7639) is woken by `cancel()` on `wake`
// for all three waits: the stream slot, the response headers and the body. The
// engine then resets only this stream (`Conn.roundTrip`'s `abort`), the request
// fails with `Cancelled`, and `e` stays in the pool: an abort says nothing
// about the connection.
fn h2clientExchange(
  e: h2Entry,
  method: string,
  u: Url,
  body: Body,
  extras: RequestExtras,
): Response! {
  let wake = chan<int>(1)
  let wid = cancelWait(extras.cancel, wake)
  defer cancelUnwait(extras.cancel, wid)
  e.acquire(extras.deadline, wake) catch err {
    if (isCancelled(err)) {
      fail unsentError(err)
    }
    fail err
  }
  // Cancelled before a stream is opened: nothing is sent.
  select {
    case _ = <- wake:
      e.free()
      fail unsentError(Cancelled{ op = "send" })
    default:
  }
  let res = e.hc.roundTrip(
    h2glueRequestOf(method, u, body, extras.block),
    extras.deadline,
    Option.Some(wake),
  ) catch err {
    e.free()
    let (_, aborted) = err.(H2Aborted)
    if (aborted) {
      fail Cancelled{ op = "send" }
    }
    extras.pool.h2.retireEntry(e)
    fail err
  }
  e.free()
  return h2glueResponse(res)
}

// Tear a client connection down: the ONE place its transport is closed.
//
// `h2connect` spawns reader AND writer green threads (`stdlib/http2/conn.bit:311`)
// that park on the transport (reader) or an empty command channel (writer) for
// the life of the connection, and this runtime has no way to interrupt either
// park from outside. A bare `conn.close()` does not wake the reader — closing
// tears the fd down without notifying an already-parked reader at all
// (`std/net`'s `Conn.shutdown` doc comment has the verified mechanism) — so a
// still-parked reader is left retrying its read against whatever the OS has
// since done with the same fd number once this function returns and its caller
// opens the next connection: a later `dial()` in this same process, for
// instance, and the read can then return bytes that belong to that different
// connection entirely (#3016). The writer has the same fd-reuse exposure on
// its own next queued write, but neither `close()` nor `shutdown()` wakes it —
// it is parked on a channel, not the socket, and only the loop thread's own
// teardown releases it (#3026, `h2connTerminate` in `stdlib/http2/events.bit`),
// once the reader's failure reaches the loop or the loop raises a connection
// error of its own (#4606). So teardown here is always four steps in
// order: `conn.shutdown()` (the real wakeup — an orderly EOF the reader's next
// read observes), `hc.waitReaderDone()` (block until it has), `hc.waitWriterDone()`
// (block until the writer has followed, released by the loop's teardown),
// THEN `conn.close()` (now provably safe to let something else reuse the fd).
//
// `h2connect`'s own failure path (a dead connection or an unresponsive peer
// before the peer's opening SETTINGS, #3019) already runs the first three of
// those steps itself — it shuts the transport down, which is what makes the
// reader's read fail (#4608), and then drains its reader and its writer before
// returning the error — see `h2connAwaitReady` — so `conn.close()`
// there is just as safe as the four-step teardown above, without needing this
// X
fn h2teardown(conn: TlsConn, hc: H2Conn) {
  conn.shutdown()
  hc.waitReaderDone()
  hc.waitWriterDone()
  conn.close()
}

// Serve one h2-negotiated connection: run the http2 server engine and dispatch
// each stream to the transport-agnostic `handler`, mapping the http2 request and
// response to this module's types on the way in and out. Each response advertises
// the HTTP/3 endpoint on `opts.altPort` via an Alt-Svc header, and every stream's
// body is accumulated under `opts.maxBody` — the same `connOpts` `serveOne` reads
// an HTTP/1.1 request under (server.bit), so one `setMaxBodyBytes` bounds both
// protocols (#4590). `d` is the owning
// server's drain tracker (`shutdown.bit`, #3963/#4314): this connection is
// registered idle until its first stream starts, then active for the rest of
// its life — a graceful shutdown force-closes it right away if idle, or sends
// GOAWAY and gives it up to its timeout to finish if active, exactly as
// `serveOne` does for HTTP/1.1 (server.bit). `serveTlsOn`'s call site passes a
// private, never-drained `d`, so this bookkeeping is a no-op cost there.
//
// `h2accept` spawns the same reader/writer/loop trio `h2connect` does
// (`stdlib/http2/conn.bit:311`), and `hc.serve()` additionally parks THIS green
// thread reading `hc.acceptCh` until the loop sends a stop (`h2connTerminate`,
// `stdlib/http2/events.bit`) — which happens when the loop observes the
// transport's own EOF, when this connection's `force` hook below calls
// `conn.shutdown()` to manufacture that same EOF from a graceful-shutdown
// timeout, or when the loop raises a connection error against a misbehaving
// peer (#4606). On the first two the reader has already hit that EOF by the
// time `hc.serve()` returns; on the third it is still parked, and the
// `conn.shutdown()` immediately below — which comes FIRST on every path for
// exactly this reason — is what makes its read fail. Either way
// `hc.waitReaderDone()` here is a bounded join, not a fresh wait, matching
// `h2teardown`'s teardown
// (`conn.shutdown()` -> `hc.waitReaderDone()` -> `hc.waitWriterDone()` ->
// `conn.close()`, #3016, #3026). `hc.waitWriterDone()` is bounded the same way
// `hc.waitReaderDone()` is: the same teardown that released `hc.serve()`
// (via `acceptCh`) also queues the writer's stop (via `writeCh`), so both joins
// settle once the loop has run, not on a fresh unbounded wait. Calling
// `conn.shutdown()` here a second time, after the drain's own `force` already
// called it once, is safe — `net.Conn.shutdown` (stdlib/net/net.bit) is a plain
// idempotent syscall on a still-open fd, not a state transition guarded against
// re-entry the way `close()` is.
fn h2glueServe(conn: TlsConn, handler: (Request) => Response, opts: connOpts, d: drainState) {
  // No deadline: `serveTls` gives its handler no per-connection timeout
  // budget to thread through today, so this stays unbounded exactly as
  // before (#3019 is about `getTimeout`'s client-side deadline).
  // `opts.maxBody` is the same budget `serveOne` reads an HTTP/1.1 body under,
  // enforced here by the engine as DATA accumulates (#4590).
  let hc = h2accept(h2glueTransport(conn), h2glueConfig(opts.maxBody), 0) catch _ {
    conn.close()
    return
  }
  // Once per connection, not once per stream: HTTP/2 multiplexes many requests
  // over one socket and the peer address is a property of the socket, so a
  // per-request call would be the identical `getpeername` repeated. Read here,
  // after the handshake and while the connection is certainly live, and carried
  // into every `Request` this connection produces. `""` when it cannot be read
  // — a peer address never fails a request (`Request.peer`, http.bit).
  let peer = conn.peerIp() catch ""
  let id = drainRegister(
    d,
    () => {
      conn.shutdown()
    },
    () => {
      hc.close()
    },
  )
  defer drainDeregister(d, id)
  // The `Stream` the engine hands each handler (#4616) is never passed on to
  // `handler`: this module's own handler type is `(Request) => Response` and is
  // shared by http/1.1, h2 and h3, so an http2-only stream handle has no place
  // in it — two of the three could not honour it. A `std/http` handler that
  // needs to abort a stream needs a protocol-agnostic shape, which is not this
  // one. The glue itself uses it once, to refuse a malformed request.
  hc.serve((r, s) => {
    drainMarkActive(d, id)
    let req = h2glueRequestIn(r, peer) catch _ {
      // A malformed request is a stream error PROTOCOL_ERROR (RFC 9113
      // §8.1.1): reset it and never reach the handler. The `Response`
      // returned is discarded by the engine after a reset (`Stream.reset`).
      s.reset(h2ErrProtocolError)
      return H2Response(0, []byte(0))
    }
    return h2glueResponseOutAlt(handler(req), opts.altPort)
  }) catch _ {
    conn.shutdown()
    hc.waitReaderDone()
    hc.waitWriterDone()
    conn.close()
    return
  }
  conn.shutdown()
  hc.waitReaderDone()
  hc.waitWriterDone()
  conn.close()
}

// Map this module's `Response` to an http2 response, first appending the Alt-Svc
// advertisement (when `altPort > 0`) so an HTTP/2 client learns the h3 endpoint.
fn h2glueResponseOutAlt(res: Response, altPort: int): H2Response {
  let out = res
  if (altPort > 0) {
    out.headers = out.headers + altSvcHeader(altPort)
  }
  return h2glueResponseOut(out)
}

// The HTTP/2 `:authority`: the host, with the port appended only when it is not
// the https default (443), matching how a client forms the pseudo-header.
fn h2glueAuthority(u: Url): string {
  if (u.port == 443) {
    return hostForAuthority(u.host)
  }
  return "${hostForAuthority(u.host)}:${itoa(u.port)}"
}

// Build an http2 request for `method u.path` with `body` over scheme https.
// `block` is extra request headers, already validated and serialized by
// `serializeHeaders` (reqheader.bit, #2290) — "" for none; `h2glueFields`
// parses it into fields the same way it already does for a raw response
// block, dropping any connection-specific name a caller's validation missed
// (defence in depth: `isReservedRequestHeader` already rejects those earlier).
fn h2glueRequestOf(method: string, u: Url, body: Body, block: string): H2Request {
  let req = H2Request(method, h2glueAuthority(u), u.path)
  req.headers = h2glueFields([]H2HeaderField(0), block)
  req.body = body.bytes()
  return req
}

// Whether a lower-case header `name` is a connection-specific field forbidden on
// an HTTP/2 stream (RFC 9113 §8.2.2). Content-Length is dropped too — the engine
// frames the body, so an explicit length is redundant.
fn h2glueHopByHop(name: string): bool {
  return name == "content-length" || connectionSpecificField(name)
}

// Serialize an http2 header-field list into this module's raw "Name: value\r\n"
// block, so `header()` reads it exactly as an HTTP/1.1 block.
fn h2glueBlock(fields: []H2HeaderField): string {
  let block = ""
  for f of fields {
    block = block + "${f.name}: ${f.value}\r\n"
  }
  return block
}

// `h2glueBlock` for a request a peer sent: fails, with no block, on the first field
// `putPeerField` (peerfields.bit) refuses, since a name or value carrying SP, ':',
// CR, LF or NUL would otherwise come out as extra or altered lines in the block
// (RFC 9113 §8.2.1, #6729). The block is sized once and each byte is checked as
// it is copied into it, so a request is walked once (#6736).
fn h2glueRequestBlock(fields: []H2HeaderField): string! {
  let size = 0
  for f of fields {
    size = size + len(f.name) + len(f.value) + 4
  }
  let buf = []byte(size)
  let k = 0
  for f of fields {
    k = putPeerField(buf, k, f.name, f.value)
    if (k < 0) {
      fail newError("http2: malformed request: bad header field")
    }
  }
  return string(buf)
}

// Parse a raw "Name: value\r\n" block into http2 header fields, lower-casing each
// name (HTTP/2 requires it) and dropping connection-specific headers. Appends to
// `dst`. Bounded: each turn consumes at least one line from `rest`. Shared by the
// response path (`h2glueResponseOut`) and, since #2290, the outgoing-request path
// (`h2glueRequestOf`) — both always pass a freshly built `dst`, never one held
// elsewhere, so the append-aliasing note below stays true for either caller.
fn h2glueFields(dst: []H2HeaderField, block: string): []H2HeaderField {
  let out = dst
  let rest = block
  while (len(rest) > 0) {
    let eol = indexOf(rest, "\r\n")
    let line = rest
    if (eol >= 0) {
      line = rest[0:eol]
      rest = rest[eol + 2:len(rest)]
    } else {
      rest = ""
    }
    let colon = indexOf(line, ":")
    if (colon < 0) {
      continue
    }
    let name = toLower(trimSpace(line[0:colon]))
    if (len(name) == 0 || h2glueHopByHop(name)) {
      continue
    }
    // bit:lint allow E0214 -- unexported; every call site discards or never rereads its pre-call slice (see this function's doc comment)
    out = append(
      out,
      H2HeaderField{ name = name, value = trimSpace(line[colon + 1:len(line)]), sensitive = false },
    )
  }
  return out
}

// Map an http2 response to this module's `Response`: `:status` is the status, the
// remaining fields become the raw header block, and Content-Type is read from it
// just as on the HTTP/1.1 path.
fn h2glueResponse(res: H2Response): Response {
  let block = h2glueBlock(res.headers)
  return Response{
    status = res.status,
    contentType = header(block, "content-type"),
    headers = block,
    body = string(res.body),
  }
}

// Map an http2 request to this module's `Request`, flattening the header fields to
// a raw header block. Fails when a field makes the request malformed
// (`putPeerField`, peerfields.bit, #6729), which `h2glueServe` answers by resetting the
// stream. `peer` is the connection's client address, read once by
// `h2glueServe` and the same for every stream on that connection.
fn h2glueRequestIn(req: H2Request, peer: string): Request! {
  return Request{
    method = req.method,
    path = req.path,
    headers = h2glueRequestBlock(req.headers)?,
    body = string(req.body),
    peer = peer,
  }
}

// Map this module's `Response` to an http2 response: Content-Type becomes a header
// field, the raw header block is parsed into fields, and the body carries over.
// The engine adds `:status` and frames the body itself.
fn h2glueResponseOut(res: Response): H2Response {
  let fields = []H2HeaderField(0)
  if (len(res.contentType) > 0) {
    fields = append(
      fields,
      H2HeaderField{ name = "content-type", value = res.contentType, sensitive = false },
    )
  }
  fields = h2glueFields(fields, res.headers)
  let out = H2Response(res.status, []byte(res.body))
  out.headers = fields
  return out
}
