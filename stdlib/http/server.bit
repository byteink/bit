// Bit standard library — http module: the HTTP/1.1 and HTTPS server.

// ---------------------------------------------------------------------------
// Server
// ---------------------------------------------------------------------------

// A listening HTTP server. Drive it with an `accept()` loop: `accept()` only
// accepts, so it returns as soon as a connection exists, before anything is
// read off it. Spawn a green thread per exchange and call `Exchange.read()`
// there to get the request — never inline in the loop, or a stalled or
// malicious peer's read blocks every accept behind it, same as
// `listenAndServe` already avoids doing since #2170.
export class Server {
  listener: Listener
  drain: drainState
  // The port the server is bound to.
  export port(): int! {
    return this.listener.port()?
  }

  // Accept the next connection. Parks until a client arrives, then returns
  // immediately — before anything is read off the wire. Call `Exchange.read()`
  // to get the request, on a freshly spawned green thread (see `Server`'s
  // comment above). This used to run `readMessage` here, on the caller's own
  // thread: a connection that declared a body and then stalled — or a peer
  // that connected and sent nothing at all — parked this call forever, so no
  // later connection was ever accepted (#2170's original bug, for this
  // direct-drive API; #2170 itself only fixed `listenAndServe`). Splitting the
  // read out of `accept()` fixes that for every caller of this API — it does
  // not bound how long any one connection's own read can take (`std/net` has
  // no read deadline yet — #2291), only that a slow one can no longer block
  // anyone else's accept or read.
  export accept(): Exchange! {
    let c = this.listener.accept()?
    return Exchange{ conn: c }
  }

  export close() {
    this.listener.close()
  }

  // Stop accepting new connections, drain requests already in flight, and
  // return. See shutdown.bit's header comment for the full sequence and the
  // exact scope (plain `Server` only — not `serveTls`/`serveTlsOn` or the
  // direct `accept()`/`Exchange` API). A non-nil error names exactly how many
  // in-flight connections were force-closed after `timeoutMs` — never the
  // idle ones, which had nothing to lose. A method, not a free function
  // (#4315): a top-level `fn shutdown` in a root module keeps its bare link
  // name and collides with the runtime's own extern `shutdown` symbol
  // (SPEC 11.7), the way `net.Conn.shutdown()` already avoids the same
  // collision.
  export shutdown(timeoutMs: int): ()! {
    drainServer(this, timeoutMs)?
  }
}

// One accepted connection. `accept()` does not read; call `read()` — ideally
// on its own spawned green thread — to get the request.
export class Exchange {
  conn: Conn
  // Reads this exchange's request off the wire: the request line, headers, and
  // body, framed the same way `readMessage` always has (see its own doc
  // comment for the exact failure cases, including the header-size cap). Fails
  // on a malformed or oversized request — the caller should answer 400
  // (`e.respond(respond(400, ""))`) and drop the connection rather than
  // propagate the failure to a handler. Parks until the whole request arrives;
  // call this on its own green thread (spawned from `accept()`, never inline
  // in the accept loop) so a stalled or silent peer can only ever block this
  // one exchange.
  export read(): Request! {
    return readMessage(netStream{ conn: this.conn })?
  }

  // Write `res` to the exchange's connection and close it (one request per
  // connection in v1) — on EVERY exit path, not only success. `defer`
  // (SPEC §18.5) runs on `?` propagation the same as a normal return, which
  // matters here: a peer that hangs up mid-response makes the write fail,
  // and without this the bare `close()` below the `?` never ran, leaking the
  // fd for the life of the process (#4175).
  export respond(res: Response): ()! {
    defer this.conn.close()
    this.conn.write(serializeResponse(res))?
  }
}

// Bind and start listening for HTTP on `host:port`. `port` 0 lets the kernel
// choose one; read it back with `port()`.
export fn serve(host: string, port: int): Server! {
  let l = listen(host, port)?
  return Server{ listener: l, drain: newDrainState() }
}

// Answers a malformed request with `400 Bad Request` and closes the
// connection. Best-effort: the peer may already be gone, in which case the
// write fails and is swallowed — there is no one left to tell.
fn answerBadRequest(s: byteStream) {
  s.writeStr(serializeResponse(respond(400, ""))) catch _ {
    s.shut()
    return
  }
  s.shut()
}

// Serve HTTP forever on an already-bound `s`, dispatching every request to
// `handler` on its own green thread. This is the loop `listenAndServe` runs
// after binding; call it directly to learn the bound port before serving
// starts — `serve(host, port)` and `listenAndServe(host, port, handler)` bind
// and loop in one call, so a kernel-chosen port (`serve(host, 0)`) is
// otherwise unreachable:
//
//   let s = serve(host, 0)?
//   let boundPort = s.port()?   // hand this to a test's client
//   listenAndServeOn(s, handler)?
//
// Returns only on an accept error.
//
// The accept loop only accepts — it does not read. `readMessage` (headers and
// body both) runs inside the spawned `serveOne`, on that connection's own
// green thread, same as `serveTls` already does, and same as `Server.accept()`
// plus `Exchange.read()` now does for direct callers of the
// `serve`/`accept`/`respond` API. A client that opens a connection and stalls
// mid-body — declares a Content-Length and then sends less, or nothing at
// all — used to park THIS loop forever, so no other client already
// connected, or arriving after, was ever answered. Now that connection's own
// read stalls on its own thread; every other accept and every other read
// proceeds.
export fn listenAndServeOn(s: Server, handler: (Request) => Response): ()! {
  while (true) {
    let c = s.listener.accept()?
    spawn serveOne(netStream{ conn: c }, handler, 0, s.drain)
  }
}

// Bind `host:port` and serve HTTP forever, dispatching every request to
// `handler` on its own green thread — the idiomatic server. `handler` is an
// ordinary function value: `listenAndServe("127.0.0.1", 8080, route)`. Returns
// only on a bind or accept error. For a kernel-chosen port, or to serve a
// bounded number of requests, use `serve` and `listenAndServeOn` instead — see
// `listenAndServeOn`'s doc comment — or drive the `Server`/`accept`/`respond`
// API yourself.
export fn listenAndServe(host: string, port: int, handler: (Request) => Response): ()! {
  let s = serve(host, port)?
  listenAndServeOn(s, handler)?
}

// Read one request off `s`, answer it with `handler`, and close. On the calling
// green thread; a read or write failure just drops the connection. `altPort` is
// advertised in the response's Alt-Svc header (0 to advertise nothing). `d` is
// the owning `Server`'s drain tracker (`shutdown.bit`, #3963): this connection
// is registered idle for as long as it waits for its request, then marked
// active for the rest of its life, so a graceful shutdown knows whether it is
// safe to force-close right away or must be given a chance to finish.
fn serveOne(s: byteStream, handler: (Request) => Response, altPort: int, d: drainState) {
  let id = drainRegister(
    d,
    () => {
      s.forceClose()
    },
  )
  defer drainDeregister(d, id)
  answer(s, handler, altPort, d, id) catch _ {
    return
  }
}

fn answer(
  s: byteStream,
  handler: (Request) => Response,
  altPort: int,
  d: drainState,
  id: int,
): ()! {
  let req = readMessage(s) catch _ {
    answerBadRequest(s)
    return
  }
  drainMarkActive(d, id)
  // `defer` (SPEC §18.5) runs on `?` propagation the same as a normal
  // return, so a peer that hangs up before the response write completes
  // still shuts `s` down — without this the bare `s.shut()` below the `?`
  // never ran, leaking the fd for the life of the process (#4175).
  // `answerBadRequest` above already shuts on both of its own paths, so this
  // is placed after that branch rather than at the top of the function.
  defer s.shut()
  let res = handler(req)
  if (altPort > 0) {
    res.headers = res.headers + altSvcHeader(altPort)
  }
  s.writeStr(serializeResponse(res))?
}

// Serve HTTPS forever on an already-bound `l`, dispatching every request to
// `handler` on its own green thread. This is the loop `serveTls` runs after
// binding; call it directly to learn the bound port before serving starts, the
// same way `listenAndServeOn` composes with `serve`:
//
//   let l = listen(host, 0, cfg)?   // std/tls's listen, port 0 for a kernel-chosen one
//   let boundPort = l.port()?
//   serveTlsOn(l, handler)?
//
// Every response carries an `Alt-Svc: h3=":<port>"` header (RFC 7838)
// advertising an HTTP/3 endpoint on `l`'s own bound port over UDP, so a client
// can discover it and upgrade a later request — pair with `serveH3` on that
// port. Returns only on an accept or handshake error.
export fn serveTlsOn(l: TlsListener, handler: (Request) => Response): ()! {
  let altPort = l.port()?
  // A private drain tracker, never exposed outside this call: `serveOne`
  // (server.bit) needs a `drainState` to register HTTP/1.1-over-TLS
  // connections in either way, and this keeps that signature uniform with the
  // plain path. Nothing external can drain it — `shutdown` (shutdown.bit,
  // #3963) is scoped to `Server` only; see that file's header comment for why.
  let d = newDrainState()
  while (true) {
    // A per-connection failure (a bad or rejected TLS handshake — e.g. a client
    // whose ALPN offer shares nothing with ours, which RFC 7301 §3.2 makes us
    // abort) must drop THAT connection, never the listener: propagating it would
    // let one malformed client take down the whole server. This does not hot-spin
    // — the next iteration blocks in the TCP accept until a real connection
    // arrives. A genuinely dead listener socket is the one case this can't tell
    // apart; that is a fatal, rare condition, tracked separately.
    let conn = l.accept() catch _ {
      continue
    }
    spawn serveTlsConn(conn, handler, altPort, d)
  }
}

// Bind `host:port` and serve HTTPS forever with the certificate chain
// `certPem` and matching private key `keyPem` (both PEM), dispatching every
// request to `handler` on its own green thread — the TLS mirror of
// `listenAndServe`. ALPN offers `h2` then `http/1.1`, so a client that
// negotiates HTTP/2 is served over the `std/http2` engine and any other over
// HTTP/1.1; `handler` is the same either way. Returns only on a bind, accept,
// or handshake error. For a kernel-chosen port, use `std/tls`'s `listen` and
// `serveTlsOn` instead — see `serveTlsOn`'s doc comment.
export fn serveTls(
  host: string,
  port: int,
  certPem: string,
  keyPem: string,
  handler: (Request) => Response,
): ()! {
  let cfg = newTlsConfig(emptyTrustStore())
  cfg.certPem = certPem
  cfg.keyPem = keyPem
  cfg.alpn = ["h2", "http/1.1"]
  let l = tlsListen(host, port, cfg)?
  serveTlsOn(l, handler)?
}

// The Alt-Svc advertisement (RFC 7838) a TLS server appends to every response:
// HTTP/3 is reachable at the same port number, over UDP.
fn altSvcHeader(port: int): string {
  return "Alt-Svc: h3=\":${itoa(port)}\"\r\n"
}

// Dispatch one accepted TLS connection to the HTTP/2 or HTTP/1.1 server path by
// its negotiated ALPN protocol. Runs on the spawned per-connection green thread.
// `altPort` is the HTTP/3 port advertised in each response's Alt-Svc header.
fn serveTlsConn(conn: TlsConn, handler: (Request) => Response, altPort: int, d: drainState) {
  if (conn.alpnProtocol() == "h2") {
    h2glueServe(conn, handler, altPort)
    return
  }
  serveOne(tlsStream{ conn: conn }, handler, altPort, d)
}
