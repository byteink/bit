// Bit standard library — http module: the HTTP/1.1 and HTTPS server.

// `acceptLoop`'s backoff (below `wantsClose`, #5913) needs `sleep` (std/time),
// new to this module as a PRODUCTION import — keepalive.test.bit used to
// import it too, as a test-only import, now redundant (and removed) now that
// a production file in the module binds it module-wide. `Millisecond`
// (std/time) is already imported by shutdown.bit (same module); a second
// import of it here would be E0042.
import { sleep } from "std/time"

// ---------------------------------------------------------------------------
// Server
// ---------------------------------------------------------------------------

// A `listenAndServe`/`serve` connection persists past its first request by
// default (#5419); these two bound what that costs. `setIdleTimeoutMs`/
// `setMaxRequestsPerConn` override either. 60s matches nginx's
// `keepalive_timeout` default; 1000 matches its `keepalive_requests` default.
const defaultIdleTimeoutNs = 60000000000
const defaultMaxRequestsPerConn = 1000

// A listening HTTP server. Drive it with an `accept()` loop: `accept()` only
// accepts, so it returns as soon as a connection exists, before anything is
// read off it. Spawn a green thread per exchange and call `Exchange.read()`
// there to get the request — never inline in the loop, or a stalled or
// malicious peer's read blocks every accept behind it, same as
// `listenAndServe` already avoids doing since #2170.
export class Server {
  // `acceptor` (below `wantsClose`), not the concrete `Listener` (std/net):
  // `listenAndServeOn`'s accept loop needs nothing else, and a test can then
  // substitute one whose `accept()` fails on demand (#5913) — the harness has
  // no way to lower the process's fd limit to reproduce EMFILE for real, and
  // a new runtime extern to do that is off the table. `std/net`'s `Listener`
  // satisfies this purely structurally (same pattern as `byteStream`,
  // transport.bit); nothing there changes. Module-private field, so this is
  // not a public API change.
  listener: acceptor
  drain: drainState
  maxBody: int
  idleTimeoutNs: int
  maxRequests: int
  // Set by `close()`, read by `listenAndServeOn`'s accept loop (#5913) to
  // tell "this accept failed because `close()` closed the listener" — end the
  // loop, same as today — from a transient failure such as the fd limit,
  // which must not. `shutdown()`'s own close path is covered separately, by
  // `drainStarted(this.drain)` (shutdown.bit): `shutdown()` never calls
  // `close()` directly.
  closed: bool
  // The port the server is bound to.
  export port(): int! {
    return this.listener.port()?
  }

  // Accept the next connection. Parks until a client arrives, then returns
  // immediately — before anything is read off the wire. Call `Exchange.read()`
  // to get the request, on a freshly spawned green thread (see `Server`'s
  // comment above). This used to run `readMessage` here, on the caller's own
  // thread: a connection that declared a body and then stalled — or a peer
  // that connected and sent nothing at all — parked this call forever, so no
  // later connection was ever accepted (#2170's original bug, for this
  // direct-drive API; #2170 itself only fixed `listenAndServe`). Splitting the
  // read out of `accept()` fixes that for every caller of this API — it does
  // not bound how long any one connection's own read can take (`std/net` has
  // no read deadline yet — #2291), only that a slow one can no longer block
  // anyone else's accept or read.
  export accept(): Exchange! {
    let c = this.listener.accept()?
    return Exchange{ conn = c, maxBody = this.maxBody }
  }

  // Raise or lower the byte budget this server reads a request body under
  // (#4565). It defaults to `defaultMaxBodyBytes` (32 MiB, message.bit): a
  // request whose `Content-Length` declares more, or whose chunk sizes add up
  // to more, is refused BEFORE the bytes are read, and the connection is
  // answered `400 Bad Request` and closed. Set it before serving starts;
  // connections already accepted keep the budget they were accepted with.
  //
  // There is deliberately no value meaning "unlimited" — zero means "refuse
  // every body", the same as `multipart.bit`'s `Limits`. A server that
  // genuinely accepts large uploads names the size it accepts.
  export setMaxBodyBytes(n: int) {
    this.maxBody = n
  }

  // How long (#5419) a connection served through `listenAndServeOn` may sit
  // idle between requests before the server closes it — reset at the start
  // of every wait for a new request, so activity keeps postponing it, not a
  // per-connection lifetime cap. Set before serving starts; connections
  // already accepted keep the value they were accepted with, same as
  // `setMaxBodyBytes`.
  export setIdleTimeoutMs(ms: int) {
    this.idleTimeoutNs = ms * 1000000
  }

  // How many requests (#5419) a single connection served through
  // `listenAndServeOn` may answer before the server closes it regardless of
  // `Connection: keep-alive` — the same bound `keepalive_requests` gives an
  // operator: an upstream load balancer or a slowly leaking handler cannot
  // pin one connection open forever. Set before serving starts, same caveat
  // as `setIdleTimeoutMs`.
  export setMaxRequestsPerConn(n: int) {
    this.maxRequests = n
  }

  export close() {
    this.closed = true
    this.listener.close()
  }

  // Stop accepting new connections, drain requests already in flight, and
  // return. See shutdown.bit's header comment for the full sequence and the
  // exact scope (plain `Server` only — not `serveTls`/`serveTlsOn` or the
  // direct `accept()`/`Exchange` API). A non-nil error names exactly how many
  // in-flight connections were force-closed after `timeoutMs` — never the
  // idle ones, which had nothing to lose. A method, not a free function
  // (#4315): a top-level `fn shutdown` in a root module keeps its bare link
  // name and collides with the runtime's own extern `shutdown` symbol
  // (SPEC 11.7), the way `net.Conn.shutdown()` already avoids the same
  // collision.
  export shutdown(timeoutMs: int): ()! {
    drainServer(this, timeoutMs)?
  }
}

// One accepted connection. `accept()` does not read; call `read()` — ideally
// on its own spawned green thread — to get the request.
export class Exchange {
  conn: Conn
  maxBody: int
  // The method of the request `read()` parsed off this exchange, "" until it
  // has. `respond()` needs it: a response to a `HEAD` carries the head a
  // `GET` would have carried and no content (RFC 9110 §9.3.2), and the
  // serializer is the only layer that can drop the body without also losing
  // the octet count. An exchange answered without a `read()` keeps "" and is
  // framed as an ordinary body-carrying response.
  method: string
  // Reads this exchange's request off the wire: the request line, headers, and
  // body, framed the same way `readMessage` always has (see its own doc
  // comment for the exact failure cases, including the header-size cap). Fails
  // on a malformed or oversized request — the caller should answer 400
  // (`e.respond(respond(400, ""))`) and drop the connection rather than
  // propagate the failure to a handler. Parks until the whole request arrives;
  // call this on its own green thread (spawned from `accept()`, never inline
  // in the accept loop) so a stalled or silent peer can only ever block this
  // one exchange.
  export read(): Request! {
    let req = readMessage(netStream{ conn = this.conn }, this.maxBody)?
    this.method = req.method
    return req
  }

  // Write `res` to the exchange's connection and close it (one request per
  // connection in v1) — on EVERY exit path, not only success. `defer`
  // (SPEC §18.5) runs on `?` propagation the same as a normal return, which
  // matters here: a peer that hangs up mid-response makes the write fail,
  // and without this the bare `close()` below the `?` never ran, leaking the
  // fd for the life of the process (#4175).
  export respond(res: Response): ()! {
    defer this.conn.close()
    // Always `close: true`: this API is one request per connection (this
    // class's own doc comment), unlike `listenAndServeOn`'s persistent
    // connections (#5419).
    this.conn.write(serializeResponse(res, this.method, true))?
  }

  // Take ownership of the exchange's underlying connection for a protocol
  // upgrade (e.g. WebSocket, RFC 6455 §4.1) that continues past the framing
  // `respond()` assumes: `respond()` always writes exactly one HTTP response
  // and closes the connection, which an upgraded connection must not do. Call
  // `read()` first, check the request looks like the upgrade you expect, then
  // call this instead of `respond()` — never both on the same exchange, since
  // the caller now owns the connection's lifetime, including closing it.
  export hijack(): Conn {
    return this.conn
  }
}

// Bind and start listening for HTTP on `host:port`. `port` 0 lets the kernel
// choose one; read it back with `port()`.
export fn serve(host: string, port: int): Server! {
  let l = listen(host, port)?
  return Server{
    listener = l, drain = newDrainState(), maxBody = defaultMaxBodyBytes,
    idleTimeoutNs = defaultIdleTimeoutNs, maxRequests = defaultMaxRequestsPerConn,
  }
}

// The per-server policy every accepted connection is served under: the HTTP/3
// port to advertise in `Alt-Svc` (0 to advertise nothing), the byte budget
// `readMessage` reads a request body under, and the idle-timeout/max-requests
// pair that bounds a persistent connection (#5419). One value built once per
// serve loop and shared by every connection it accepts — a class rather than
// more parameters because `answerOne` already carries six, which is E0202's
// ceiling.
class connOpts {
  altPort: int,
  maxBody: int,
  idleTimeoutNs: int,
  maxRequests: int,
}

// Answers a malformed request with `400 Bad Request` and closes the
// connection. Best-effort: the peer may already be gone, in which case the
// write fails and is swallowed — there is no one left to tell.
fn answerBadRequest(s: byteStream) {
  s.writeStr(serializeResponse(respond(400, ""), "", true)) catch _ {
    s.shut()
    return
  }
  s.shut()
}

// Whether the connection closes after answering a request whose Connection
// field is `conn` (as `header()` returns it) and whose version is `version`
// (RFC 9112 §9.3, #5419); `readMessage` records the answer in
// `Request.closeAsked` for `answerOne` (#5919). The client's own explicit
// `close` always wins; short of that, an HTTP/1.1 request (`version` is
// exactly "HTTP/1.1" — RFC 9110 §9.1's case-sensitive token) persists by
// default, and anything else (HTTP/1.0, or a request line with no version at
// all) closes unless the client opted into `keep-alive`. `Connection` may
// carry more than one token ("keep-alive, Upgrade"), so both checks are a
// substring search of the lowercased field, the same matching `header()`
// already gives every other caller of it.
fn wantsClose(conn: string, version: string): bool {
  let tokens = toLower(conn)
  if (indexOf(tokens, "close") >= 0) {
    return true
  }
  if (version == "HTTP/1.1") {
    return false
  }
  return indexOf(tokens, "keep-alive") < 0
}

// `Server.listener`'s seam (#5913, above): exactly the `Listener` (std/net)
// surface `listenAndServeOn`'s accept loop calls. `std/net`'s `Listener`
// satisfies this purely structurally, the same way `netStream`/`tlsStream`
// (transport.bit) satisfy `byteStream` — nothing in std/net changes.
interface acceptor {
  accept(): Conn!,
  close(),
  port(): int!,
}

// `serveTlsLoop`'s seam (#5916), the TLS mirror of `acceptor`: exactly the
// `TlsListener` (std/tls) surface its accept loop calls. `TlsListener`
// satisfies this purely structurally — nothing in std/tls changes, and every
// existing caller keeps passing a `TlsListener` exactly as before — so this
// exists only to let a test substitute one whose `accept()` fails on demand,
// the same reason `acceptor` exists for `listenAndServeOn`'s test (#5913):
// std/tls has no way to lower `RLIMIT_NOFILE` to reproduce EMFILE for real,
// and unlike `Server.listener`, `TlsListener`'s fields are private to std/tls,
// so a fake could not otherwise stand in for one from this module.
interface tlsAcceptor {
  accept(): TlsConn!,
  isClosed(): bool,
  port(): int!,
}

// Backoff `listenAndServeOn` and `serveTlsOn` share for a failed accept
// (#5913): Go's `net/http` `Server.Serve` gives a temporary accept error
// (EMFILE, ENFILE — the process or system's fd limit — and anything else
// `netAcceptTcpLoop`, runtime/net/{linux,darwin}/tcp.bit, does not already
// retry on its own) a doubling sleep instead of ending the server, so hitting
// the fd limit no longer takes down every connection already being served.
const initialAcceptBackoffNs = 5 * Millisecond
const maxAcceptBackoffNs = 1000 * Millisecond

// Drives a serve loop, shared by `listenAndServeOn` and `serveTlsOn` (#5913)
// so this decision is written once: calls `accept` for the next connection
// and hands it to `onAccept` (spawn its own green thread), forever. On a
// failed `accept`, `closed()` decides what happens. True ends the loop,
// returning that accept's own error exactly as an unhandled one always has —
// `listenAndServeOn` passes a `closed` that reports the listener itself was
// closed out from under this loop (`Server.close()`/`drainServer`,
// shutdown.bit:302/315). False means the failure is transient (most often
// the fd limit): it is dropped, the current backoff is slept and doubled —
// capped at `maxBackoffNs` — for the next consecutive failure, and the
// loop retries. A successful accept resets the backoff to
// `initialAcceptBackoffNs`. `serveTlsOn` passes `l.isClosed()` — `TlsListener`
// gained the same "was this closed" signal `Server` already had (#5916) — and
// `maxAcceptBackoffNs`, the same backoff plain HTTP gets: `TlsListener.accept()`
// (std/tls) no longer runs the handshake inline (#5916), so a failure here is
// a genuine TCP-level accept failure (most often the fd limit) and no longer
// one client's rejected handshake — a bad ClientHello can no longer even make
// this `accept` fail, since accepting the TCP connection and running its
// handshake are different steps now, the second on the connection's own task.
fn acceptLoop<C>(
  accept: () => C!,
  closed: () => bool,
  maxBackoffNs: int,
  onAccept: (C) => (),
): ()! {
  let backoffNs = initialAcceptBackoffNs
  while (true) {
    let c = accept() catch e {
      if (closed()) {
        fail e
      }
      if (maxBackoffNs > 0) {
        sleep(backoffNs)
        backoffNs = backoffNs * 2
        if (backoffNs > maxBackoffNs) {
          backoffNs = maxBackoffNs
        }
      }
      continue
    }
    backoffNs = initialAcceptBackoffNs
    onAccept(c)
  }
}

// Serve HTTP forever on an already-bound `s`, dispatching every request to
// `handler` on its own green thread. This is the loop `listenAndServe` runs
// after binding; call it directly to learn the bound port before serving
// starts — `serve(host, port)` and `listenAndServe(host, port, handler)` bind
// and loop in one call, so a kernel-chosen port (`serve(host, 0)`) is
// otherwise unreachable:
//
//   let s = serve(host, 0)?
//   let boundPort = s.port()?   // hand this to a test's client
//   listenAndServeOn(s, handler)?
//
// Returns only once `s.close()`/`s.shutdown()` has closed the listener
// (#5913) — any other accept failure (most often the fd limit, EMFILE/
// ENFILE) is retried with a backoff (`acceptLoop`, above) instead of ending
// the server.
//
// The accept loop only accepts — it does not read. `readMessage` (headers and
// body both) runs inside the spawned `serveOne`, on that connection's own
// green thread, same as `serveTls` already does, and same as `Server.accept()`
// plus `Exchange.read()` now does for direct callers of the
// `serve`/`accept`/`respond` API. A client that opens a connection and stalls
// mid-body — declares a Content-Length and then sends less, or nothing at
// all — used to park THIS loop forever, so no other client already
// connected, or arriving after, was ever answered. Now that connection's own
// read stalls on its own thread; every other accept and every other read
// proceeds.
export fn listenAndServeOn(s: Server, handler: (Request) => Response): ()! {
  let opts = connOpts{
    altPort = 0, maxBody = s.maxBody,
    idleTimeoutNs = s.idleTimeoutNs, maxRequests = s.maxRequests,
  }
  acceptLoop(
    () => s.listener.accept(),
    () => s.closed || drainStarted(s.drain),
    maxAcceptBackoffNs,
    (c) => {
      spawn serveOne(netStream{ conn = c }, handler, opts, s.drain)
    },
  )?
}

// Bind `host:port` and serve HTTP forever, dispatching every request to
// `handler` on its own green thread — the idiomatic server. `handler` is an
// ordinary function value: `listenAndServe("127.0.0.1", 8080, route)`. Returns
// only on a bind or accept error. For a kernel-chosen port, or to serve a
// bounded number of requests, use `serve` and `listenAndServeOn` instead — see
// `listenAndServeOn`'s doc comment — or drive the `Server`/`accept`/`respond`
// API yourself.
export fn listenAndServe(host: string, port: int, handler: (Request) => Response): ()! {
  let s = serve(host, port)?
  listenAndServeOn(s, handler)?
}

// Read and answer requests off `s` until the connection closes: the client
// asked to (`wantsClose`), it hit `opts.maxRequests`, it went idle past
// `opts.idleTimeoutNs`, or a read/write failed. On the calling green thread —
// spawned per connection, so one slow or malicious peer only ever blocks its
// own thread, never another connection's accept or read (#2170). `d` is the
// owning `Server`'s drain tracker (`shutdown.bit`, #3963): this connection is
// registered idle for as long as it waits for A request, then marked active
// for the rest of that request's life, every request in turn — so a graceful
// shutdown can tell a connection between requests (safe to force-close) from
// one mid-exchange (give it a chance to finish).
// This connection's drain registration (`shutdown.bit`, #3963): `d` is the
// owning `Server`'s tracker, `id` the handle this one connection registered
// under. Bundled into one value so `answerOne` (#5419, a persistent
// connection's per-request step) stays at 5 parameters, E0202's ceiling.
// `marked` is false until `answerOne`'s first successful request, then stays
// true for the rest of the connection's life: `drainMarkActive` (#5940)
// already no-ops past the first call (nothing ever sets a `connEntry` back to
// idle, ids are never reused), so a plain per-connection flag skips its
// mutex-guarded channel round trip and map lookup on every later
// keep-alive request instead of paying for a call whose answer never
// changes.
class drainSlot {
  d: drainState,
  id: int,
  marked: bool,
}

// Which request, of how many, this `answerOne` call is answering (#5419).
// `first` is true only for a connection's very first request: a malformed
// request there gets `answerBadRequest`'s 400, exactly the single-request
// behavior this replaces; on every later request the same read failure means
// the peer went idle past the deadline just armed, or the connection simply
// died between exchanges — closing without a response is the ordinary end of
// a persistent connection (RFC 9112 §9.3), not a fresh error to report.
// `atLimit` is `n == maxRequests` from the caller's loop counter: the last
// request this connection may answer, framed with `Connection: close`
// regardless of what the client asked for, same as an idle-timeout or
// `wantsClose` closure. Bundled with `first` for the same E0202 reason as
// `drainSlot`.
class answerTurn {
  first: bool,
  atLimit: bool,
}

fn serveOne(s: byteStream, handler: (Request) => Response, opts: connOpts, d: drainState) {
  let id = drainRegister(
    d,
    () => {
      s.forceClose()
    },
    () => {},
  )
  defer drainDeregister(d, id)
  let slot = drainSlot{ d = d, id = id, marked = false }
  let n = 0
  while (n < opts.maxRequests) {
    n = n + 1
    s.setIdleDeadline(monotonic().ns + opts.idleTimeoutNs)
    let turn = answerTurn{ first = n == 1, atLimit = n == opts.maxRequests }
    let more = answerOne(s, handler, opts, slot, turn)
    if (!more) {
      return
    }
  }
}

// Reads and answers one request off `s`, returning whether the connection
// stays open for another (#5419). See `answerTurn` for `turn.first`/
// `turn.atLimit`'s exact meaning.
fn answerOne(
  s: byteStream,
  handler: (Request) => Response,
  opts: connOpts,
  slot: drainSlot,
  turn: answerTurn,
): bool {
  let req = readMessage(s, opts.maxBody) catch _ {
    if (turn.first) {
      answerBadRequest(s)
    } else {
      s.shut()
    }
    return false
  }
  if (len(req.method) == 0) {
    // The peer closed before sending a(nother) request — the ordinary end of
    // a persistent connection, not a failure.
    s.shut()
    return false
  }
  if (!slot.marked) {
    drainMarkActive(slot.d, slot.id)
    slot.marked = true
  }
  let res = handler(req)
  if (opts.altPort > 0) {
    res.headers = res.headers + altSvcHeader(opts.altPort)
  }
  // Named `mustClose`, not `close`: `close` is a predeclared identifier
  // (E0048).
  let mustClose = turn.atLimit || req.closeAsked
  // No bare `defer s.shut()` (unlike the old one-shot `answer`): a connection
  // that stays open (`mustClose` false, write succeeded) must NOT be shut
  // before its next request, so every exit path shuts explicitly instead — a
  // write failure ends the connection exactly as it always has (#4175), just
  // via `catch` rather than `?`-propagation now that this function no longer
  // fails.
  s.writeStr(serializeResponse(res, req.method, mustClose)) catch _ {
    s.shut()
    return false
  }
  if (mustClose) {
    s.shut()
    return false
  }
  return true
}

// Serve HTTPS forever on an already-bound `l`, dispatching every request to
// `handler` on its own green thread. This is the loop `serveTls` runs after
// binding; call it directly to learn the bound port before serving starts, the
// same way `listenAndServeOn` composes with `serve`:
//
//   let l = listen(host, 0, cfg)?   // std/tls's listen, port 0 for a kernel-chosen one
//   let boundPort = l.port()?
//   serveTlsOn(l, handler)?
//
// Every response carries an `Alt-Svc: h3=":<port>"` header (RFC 7838)
// advertising an HTTP/3 endpoint on `l`'s own bound port over UDP, so a client
// can discover it and upgrade a later request — pair with `serveH3` on that
// port. Returns only once `l`'s
// `close()` has closed the listener (#5916: `TlsListener` gained the same
// "was this closed" signal `Server` already had) — any other accept failure
// (most often the fd limit) is retried with the same backoff
// `listenAndServeOn` uses (`acceptLoop`, above) instead of ending the loop.
// The TLS handshake itself no longer runs inside this loop's `accept` at all
// (#5916: it runs on the connection's own task, in `serveTlsConn` below), so a
// bad or stalled ClientHello can no longer make this loop retry, let alone
// block another client's accept. Use `tlsServe`/`serveTlsServerOn`/
// `TlsServer.shutdown` for a server whose shutdown also drains in-flight
// requests.
export fn serveTlsOn(l: TlsListener, handler: (Request) => Response): ()! {
  serveTlsLoop(l, handler)?
}

// `serveTlsOn`'s body over the `tlsAcceptor` seam, so a test can pass a fake
// listener while the exported signature keeps its concrete `TlsListener`.
fn serveTlsLoop(l: tlsAcceptor, handler: (Request) => Response): ()! {
  let altPort = l.port()?
  // A private drain tracker, never exposed outside this call: `serveOne`
  // (server.bit) needs a `drainState` to register HTTP/1.1-over-TLS
  // connections in either way, and this keeps that signature uniform with the
  // plain path. Nothing external can drain it — `shutdown` (shutdown.bit,
  // #3963) is scoped to `Server` only; see that file's header comment for why.
  let d = newDrainState()
  // `serveTlsOn` takes a bare listener, not a server object, so there is
  // nothing to configure a body budget on: it serves under the default. Use
  // `tlsServe`/`serveTlsServerOn` (below) to raise or lower it.
  let opts = connOpts{
    altPort = altPort, maxBody = defaultMaxBodyBytes,
    idleTimeoutNs = defaultIdleTimeoutNs, maxRequests = defaultMaxRequestsPerConn,
  }
  // A transient accept failure (most often the fd limit) must drop THAT
  // attempt, never the listener: propagating it would let a passing burst of
  // EMFILE take down the whole server. A per-connection handshake failure (a
  // bad ClientHello, a client whose ALPN offer shares nothing with ours) no
  // longer surfaces here at all (#5916) — `l.accept()` only ever fails on the
  // TCP accept itself — so it can no longer reach this `catch` or affect the
  // backoff; `serveTlsConn` drops it on the connection's own task instead.
  acceptLoop(() => l.accept(), () => l.isClosed(), maxAcceptBackoffNs, (conn) => {
    spawn serveTlsConn(conn, handler, opts, d)
  })?
}

// Bind `host:port` and serve HTTPS forever with the certificate chain
// `certPem` and matching private key `keyPem` (both PEM), dispatching every
// request to `handler` on its own green thread — the TLS mirror of
// `listenAndServe`. ALPN offers `h2` then `http/1.1`, so a client that
// negotiates HTTP/2 is served over the `std/http2` engine and any other over
// HTTP/1.1; `handler` is the same either way. Returns only on a bind error —
// `serveTlsOn` (#5913, see its own doc comment) never returns on its own.
// For a kernel-chosen port, use `std/tls`'s `listen` and `serveTlsOn` instead.
export fn serveTls(
  host: string,
  port: int,
  certPem: string,
  keyPem: string,
  handler: (Request) => Response,
): ()! {
  let cfg = newTlsConfig(emptyTrustStore())
  cfg.certPem = certPem
  cfg.keyPem = keyPem
  cfg.alpn = ["h2", "http/1.1"]
  let l = tlsListen(host, port, cfg)?
  serveTlsOn(l, handler)?
}

// The Alt-Svc advertisement (RFC 7838) a TLS server appends to every response:
// HTTP/3 is reachable at the same port number, over UDP.
fn altSvcHeader(port: int): string {
  return "Alt-Svc: h3=\":${itoa(port)}\"\r\n"
}

// Dispatch one accepted TLS connection to the HTTP/2 or HTTP/1.1 server path by
// its negotiated ALPN protocol. Runs on the spawned per-connection green thread
// (#5916), which is exactly what bounds the handshake this now runs first: a
// stalled or malicious ClientHello parks only this connection's own thread,
// under `TlsConn.ensureHandshake`'s handshake deadline, never the accept loop
// that spawned it. A handshake failure (deadline elapsed, a bad ClientHello, an
// ALPN offer sharing nothing with ours) drops this connection exactly as an
// `l.accept()` failure used to before #5916 — silently, never propagated. Once
// the handshake has run, dispatch follows the negotiated ALPN protocol.
// `altPort` is the HTTP/3 port advertised in each response's Alt-Svc header.
fn serveTlsConn(conn: TlsConn, handler: (Request) => Response, opts: connOpts, d: drainState) {
  conn.handshake() catch _ {
    conn.close()
    return
  }
  if (conn.alpnProtocol() == "h2") {
    // The h2 engine frames its own bodies (stdlib/http2) and does not read
    // through `readMessage`, so `opts.maxBody` reaches it as the engine's own
    // `Config.maxBodyBytes` instead — refused as DATA accumulates rather than
    // on a declared Content-Length, but the same budget and the same default
    // (#4590; #4565 covers the HTTP/1.1 read path).
    h2glueServe(conn, handler, opts, d)
    return
  }
  serveOne(tlsStream{ conn = conn }, handler, opts, d)
}

// ---------------------------------------------------------------------------
// TlsServer — the shutdown-capable TLS server (#4314)
// ---------------------------------------------------------------------------

// A listening TLS server with graceful shutdown: the TLS mirror of `Server`,
// bound with `tlsServe`, driven with `serveTlsServerOn`, stopped with
// `shutdown()` — the same three-call shape `serve`/`listenAndServeOn`/
// `Server.shutdown()` already use. `serveTls`/`serveTlsOn` above are
// unaffected — they keep their original `TlsListener`-based signatures for
// their existing ten call sites and are not reachable through this type.
export class TlsServer {
  listener: TlsListener
  drain: drainState
  maxBody: int
  // The port the server is bound to.
  export port(): int! {
    return this.listener.port()?
  }

  // Raise or lower the byte budget this server reads a request body under —
  // the TLS mirror of `Server.setMaxBodyBytes`, with the same default. It
  // bounds BOTH protocols this listener serves (#4590): HTTP/1.1-over-TLS by
  // the same refusal `Server.setMaxBodyBytes` makes, and HTTP/2 by the
  // `std/http2` engine's `Config.maxBodyBytes`, which resets a stream whose
  // DATA passes the budget (the engine frames its own bodies and never calls
  // `readMessage`, so there is no declared length to refuse on).
  export setMaxBodyBytes(n: int) {
    this.maxBody = n
  }

  // Stop accepting new TLS connections, drain requests already in flight —
  // HTTP/1.1-over-TLS the same way `Server.shutdown()` drains a plain
  // connection, HTTP/2 by sending GOAWAY (`H2Conn.close()`) and letting
  // in-flight streams finish — and force-close whatever remains after
  // `timeoutMs`. See shutdown.bit's header comment for the full sequence.
  export shutdown(timeoutMs: int): ()! {
    drainTlsServer(this, timeoutMs)?
  }
}

// Bind `host:port` for TLS with certificate chain `certPem` and matching
// private key `keyPem` (both PEM), advertising ALPN `h2` then `http/1.1` —
// the bind half of `serveTls`, split out so the listener it returns can be
// shut down gracefully. Drive it with `serveTlsServerOn`; `port` 0 lets the
// kernel choose one, read it back with `port()`.
export fn tlsServe(host: string, port: int, certPem: string, keyPem: string): TlsServer! {
  let cfg = newTlsConfig(emptyTrustStore())
  cfg.certPem = certPem
  cfg.keyPem = keyPem
  cfg.alpn = ["h2", "http/1.1"]
  let l = tlsListen(host, port, cfg)?
  return TlsServer{ listener = l, drain = newDrainState(), maxBody = defaultMaxBodyBytes }
}

// Serve HTTPS forever on an already-bound `ts` — the shutdown-capable mirror
// of `serveTlsOn`. Every accepted connection, HTTP/1.1-over-TLS and h2 alike,
// registers in `ts.drain` (`serveTlsConn`, shared with `serveTlsOn`) so
// `ts.shutdown(timeoutMs)` can stop them. Once shutdown has closed the
// listener, `ts.listener.accept()`'s resulting failure ends this loop
// (`drainStarted`) instead of being swallowed as an ordinary per-connection
// failure the way `serveTlsOn` swallows one — see this function's sibling
// there for why an ordinary failure must NOT stop the loop.
export fn serveTlsServerOn(ts: TlsServer, handler: (Request) => Response): ()! {
  let altPort = ts.listener.port()?
  // See `serveTlsOn`'s comment on `idleTimeoutNs`: not yet enforced over TLS.
  let opts = connOpts{
    altPort = altPort, maxBody = ts.maxBody,
    idleTimeoutNs = defaultIdleTimeoutNs, maxRequests = defaultMaxRequestsPerConn,
  }
  while (true) {
    let conn = ts.listener.accept() catch _ {
      if (drainStarted(ts.drain)) {
        return
      }
      continue
    }
    spawn serveTlsConn(conn, handler, opts, ts.drain)
  }
}
