// stdlib/http/server.test.bit — `Request.peer` (#4527, step 3 of #4524),
// `serializeResponseInto` (#5860, #5928), and the accept-failure backoff
// (#5913).
//
// `serve`, `listenAndServeOn`, `get`, `getTimeout`, `ok`, `respond`,
// `serializeResponseInto`, `Request`, `Response`, `Server`, `Listener`,
// `listen` and `newDrainState` are all siblings in this same module (SPEC
// §19), so nothing is imported.
//
// The address is asserted as an exact string rather than a shape: everything
// here runs over loopback, so the only correct answer is "127.0.0.1". The
// handler hands what it saw back as the response body, which makes the
// assertion the handler's own view of `req.peer` — not the test's guess at
// what the server should have read.

// The whole server under test: answer every request with the peer address the
// server plumbed into the `Request`.
fn peerEcho(req: Request): Response {
  return ok(req.peer)
}

// `listenAndServeOn` returns only on an accept error, which is what closing the
// listener at the end of the test produces; swallowing it is the intended end
// of this green thread, not an ignored failure.
fn peerServe(s: Server) {
  listenAndServeOn(s, peerEcho) catch _ {
    return
  }
}

test "a request served over loopback carries the client's address in req.peer" {
  let s = serve("127.0.0.1", 0) catch e {
    assert(false, "serve: ${e.message()}")
    return
  }
  let port = s.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  spawn peerServe(s)

  let res = get("http://127.0.0.1:${port}/") catch e {
    s.close()
    assert(false, "get: ${e.message()}")
    return
  }
  assert(res.status == 200, "status = ${itoa(res.status)}")
  // The body IS what the handler read off `req.peer`.
  assert(res.body == "127.0.0.1", "the handler saw req.peer = '${res.body}'")
  s.close()
}

test "a Request built by hand has no peer" {
  // Every field but `peer` spelled, exactly as the ~19 construction sites that
  // predate the field still spell it: omitting `peer` must keep compiling and
  // must mean "no peer known", never a placeholder address.
  let r = Request{ method = "GET", path = "/", headers = "", body = "" }
  assert(r.peer == "", "a hand-built Request's peer = '${r.peer}'")
}

// #5860 — `serializeResponseInto` used to build the wire form with seven
// string concatenations; it now writes every piece once into a single
// presized `[]byte`. These four cases pin the exact bytes that
// concatenation produced, so a change to the write order or a length
// miscount fails here rather than as a wire-protocol regression downstream.
// Every expected string is spelled out rather than rebuilt with the old
// concatenation, so the test cannot share a bug with the code it is
// checking. `[]byte(0)` is a fresh, empty buffer each call (#5928): these
// tests are checking the bytes written, not the reuse `serveOne`'s own
// `drainSlot.buf` exercises (`keepalive.test.bit`).

test "serializeResponse: a GET 200 is framed exactly as before, keep-alive" {
  let res = ok("Hello")
  let got = string(serializeResponseInto([]byte(0), res, "GET", false))
  let want = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: keep-alive\r\n\r\nHello"
  assert(got == want, "got:\n${got}\nwant:\n${want}")
}

test "serializeResponse: a HEAD 200 carries the GET's Content-Length and no body" {
  let res = ok("Hello")
  let got = string(serializeResponseInto([]byte(0), res, "HEAD", false))
  let want = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: keep-alive\r\n\r\n"
  assert(got == want, "got:\n${got}\nwant:\n${want}")
}

test "serializeResponse: a 404 with extra headers keeps them and drops a spoofed Content-Length" {
  let res = respond(404, "not found")
  res.setHeader("Content-Length", "999") catch e {
    assert(false, "setHeader Content-Length: ${e.message()}")
    return
  }
  res.setHeader("X-Test", "abc") catch e {
    assert(false, "setHeader X-Test: ${e.message()}")
    return
  }
  let got = string(serializeResponseInto([]byte(0), res, "GET", false))
  let want = "HTTP/1.1 404 Not Found\r\nContent-Length: 9\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: keep-alive\r\nX-Test: abc\r\n\r\nnot found"
  assert(got == want, "got:\n${got}\nwant:\n${want}")
}

test "serializeResponse: mustClose true writes Connection: close" {
  let res = ok("Hello")
  let got = string(serializeResponseInto([]byte(0), res, "GET", true))
  let want = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\nHello"
  assert(got == want, "got:\n${got}\nwant:\n${want}")
}

// #5927 — every piece is now one raw `bit_rt_bytes_copy`, which moves whole
// words when both ends are 8-aligned and single bytes otherwise, so these
// pin the bytes for the benchmark's own response, an empty body, and a
// five-digit Content-Length whose body lands at every one of the eight
// destination alignments (the Content-Type length shifts it one byte per
// round). The body cycles ten distinct digits, so a word written to the
// wrong offset or a byte dropped at either end changes the output.

test "serializeResponse: the plaintext benchmark's 200 is framed exactly" {
  let got = string(serializeResponseInto([]byte(0), ok("Hello, World!"), "GET", false))
  let want = "HTTP/1.1 200 OK\r\nContent-Length: 13\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: keep-alive\r\n\r\nHello, World!"
  assert(got == want, "got:\n${got}\nwant:\n${want}")
}

test "serializeResponse: a 404 with an empty body writes Content-Length: 0 and no body" {
  let got = string(serializeResponseInto([]byte(0), respond(404, ""), "GET", false))
  let want = "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: keep-alive\r\n\r\n"
  assert(got == want, "got:\n${got}\nwant:\n${want}")
}

test "serializeResponse: a 12345-byte body is copied whole at every destination alignment" {
  let body = repeat("0123456789", 1235)[0:12345]
  let k = 0
  while (k < 8) {
    let pad = repeat("y", k)
    let res = ok(body)
    res.contentType = "x/${pad}"
    let got = string(serializeResponseInto([]byte(0), res, "GET", false))
    let head = "HTTP/1.1 200 OK\r\nContent-Length: 12345\r\nContent-Type: x/${pad}\r\nConnection: keep-alive\r\n\r\n"
    assert(len(got) == len(head) + 12345, "k=${k}: ${len(got)} bytes, want ${len(head) + 12345}")
    assert(got == head + body, "k=${k}: the 12345-byte response differs from its pieces")
    k = k + 1
  }
}

// #5972/#6122 — a status `statusHead` has a literal for is written as one
// piece, any other status piece by piece via `reason`. This pins every
// status RFC 9110 §15 defines, plus 429/431 (RFC 6585), to its whole
// spelled-out wire form, so a phrase that drifts from the RFC or a size that
// disagrees with the bytes fails here. 306 (RFC 9110 §15.4.7, "(Unused)")
// and 599 (never assigned) both take the "" fallback — 599 also takes
// `mustClose`, the other connection line.
test "serializeResponse: every RFC 9110/6585 status, 306, and 599, is framed exactly" {
  let codes = [
    100, 101, 200, 201, 202, 203, 204, 205, 206, 300, 301, 302, 303, 304, 305,
    306, 307, 308, 400, 401, 402, 403, 404, 405, 406, 407, 408, 409, 410, 411,
    412, 413, 414, 415, 416, 417, 421, 422, 426, 429, 431, 500, 501, 502, 503,
    504, 505, 599,
  ]
  let lines = [
    "HTTP/1.1 100 Continue",
    "HTTP/1.1 101 Switching Protocols",
    "HTTP/1.1 200 OK",
    "HTTP/1.1 201 Created",
    "HTTP/1.1 202 Accepted",
    "HTTP/1.1 203 Non-Authoritative Information",
    "HTTP/1.1 204 No Content",
    "HTTP/1.1 205 Reset Content",
    "HTTP/1.1 206 Partial Content",
    "HTTP/1.1 300 Multiple Choices",
    "HTTP/1.1 301 Moved Permanently",
    "HTTP/1.1 302 Found",
    "HTTP/1.1 303 See Other",
    "HTTP/1.1 304 Not Modified",
    "HTTP/1.1 305 Use Proxy",
    "HTTP/1.1 306 ",
    "HTTP/1.1 307 Temporary Redirect",
    "HTTP/1.1 308 Permanent Redirect",
    "HTTP/1.1 400 Bad Request",
    "HTTP/1.1 401 Unauthorized",
    "HTTP/1.1 402 Payment Required",
    "HTTP/1.1 403 Forbidden",
    "HTTP/1.1 404 Not Found",
    "HTTP/1.1 405 Method Not Allowed",
    "HTTP/1.1 406 Not Acceptable",
    "HTTP/1.1 407 Proxy Authentication Required",
    "HTTP/1.1 408 Request Timeout",
    "HTTP/1.1 409 Conflict",
    "HTTP/1.1 410 Gone",
    "HTTP/1.1 411 Length Required",
    "HTTP/1.1 412 Precondition Failed",
    "HTTP/1.1 413 Content Too Large",
    "HTTP/1.1 414 URI Too Long",
    "HTTP/1.1 415 Unsupported Media Type",
    "HTTP/1.1 416 Range Not Satisfiable",
    "HTTP/1.1 417 Expectation Failed",
    "HTTP/1.1 421 Misdirected Request",
    "HTTP/1.1 422 Unprocessable Content",
    "HTTP/1.1 426 Upgrade Required",
    "HTTP/1.1 429 Too Many Requests",
    "HTTP/1.1 431 Request Header Fields Too Large",
    "HTTP/1.1 500 Internal Server Error",
    "HTTP/1.1 501 Not Implemented",
    "HTTP/1.1 502 Bad Gateway",
    "HTTP/1.1 503 Service Unavailable",
    "HTTP/1.1 504 Gateway Timeout",
    "HTTP/1.1 505 HTTP Version Not Supported",
    "HTTP/1.1 599 ",
  ]
  assert(len(codes) == len(lines), "${len(codes)} codes, ${len(lines)} status lines")
  let k = 0
  while (k < len(codes)) {
    let mustClose = codes[k] == 599
    let conn = "keep-alive"
    if (mustClose) {
      conn = "close"
    }
    let got = string(serializeResponseInto([]byte(0), respond(codes[k], "body"), "GET", mustClose))
    let want = "${lines[k]}\r\nContent-Length: 4\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: ${conn}\r\n\r\nbody"
    assert(got == want, "status ${codes[k]}: got:\n${got}\nwant:\n${want}")
    k = k + 1
  }
}

// #5928: `serializeResponseInto` reuses `buf`'s own backing array in place
// when the next response still fits it, rather than allocating a fresh
// `[]byte` on every call the way the old `serializeResponse` always did —
// that reuse is `serveOne`'s whole point (`drainSlot.buf`, server.bit). Two
// small responses in a row must land in the SAME backing array.
test "serializeResponseInto reuses buf's backing array when the response still fits" {
  let buf = []byte(0)
  buf = serializeResponseInto(buf, ok("hi"), "GET", false)
  let firstPtr = int(ptrOf(buf))
  let firstCap = cap(buf)
  buf = serializeResponseInto(buf, ok("x"), "GET", false)
  assert(int(ptrOf(buf)) == firstPtr, "a response that still fit reallocated a new backing array")
  assert(cap(buf) == firstCap, "cap changed on a reuse that should not have grown")
}

// The other half: a response that does NOT fit the buffer's capacity must
// grow into a fresh backing array rather than write past the old one.
test "serializeResponseInto grows to a fresh backing array when the response does not fit" {
  let buf = []byte(0)
  buf = serializeResponseInto(buf, ok("hi"), "GET", false)
  let firstPtr = int(ptrOf(buf))
  let big = ok(repeat("a", 20000))
  buf = serializeResponseInto(buf, big, "GET", false)
  assert(
    int(ptrOf(buf)) != firstPtr,
    "a response past the buffer's cap did not get a fresh backing array",
  )
  assert(
    cap(buf) >= len(big.body),
    "the grown buffer's cap is smaller than the response that needed it",
  )
}

// #5860's allocation budget: 6 objects per call (2 for the presized `[]byte`,
// 1 for the returned string, 2 for the status/length digit strings, 1 for
// `withoutHeaderLines`'s copy). A test-local loop rather than the pkg/web
// bench app, so the count isolates `serializeResponse` from everything else
// a live server call allocates (framing headers, the socket write, the
// request parse). `BIT_GC_STATS=1` writes swept/live counters to stderr at
// process exit; this test only proves the loop runs the declared number of
// iterations against a stable response shape — the actual swept/live delta
// is read from that output by the run recorded in the ticket, not asserted
// here, since a unit test has no portable way to read the runtime's own GC
// counters mid-process.
test "serializeResponse: 100000 calls on the plaintext response complete" {
  let res = ok("Hello, World!")
  res.contentType = "text/plain; charset=utf-8"
  let n = 100000
  let i = 0
  let last = ""
  while (i < n) {
    last = string(serializeResponseInto([]byte(0), res, "GET", false))
    i = i + 1
  }
  assert(i == n, "loop ran ${i} of ${n} iterations")
  assert(
    indexOf(last, "\r\n\r\nHello, World!") >= 0,
    "the last call's output was not the expected plaintext response:\n${last}",
  )
}

// #5913 — a failed accept (EMFILE/ENFILE, the process or system's fd limit)
// must not end `listenAndServeOn`. The harness has no way to lower
// RLIMIT_NOFILE to reproduce that for real (no rlimit support anywhere in
// this repo, and a new runtime extern for it is off the table), so this is a
// test double at the `acceptor` seam (server.bit) `Server.listener` now
// accepts: its first `failures` calls to `accept()` fail without touching
// the network; every call after that, and `close()`/`port()`, delegate to a
// real `Listener` bound over loopback, so the connection this test dials is
// genuinely accepted and answered.
class fakeFailingListener {
  real: Listener
  failures: int
  fails: int
  export accept(): Conn! {
    if (this.fails < this.failures) {
      this.fails = this.fails + 1
      fail newError("fake accept failure (simulated EMFILE)")
    }
    return this.real.accept()?
  }
  export close() {
    this.real.close()
  }
  export port(): int! {
    return this.real.port()?
  }
}

fn backoffServe(s: Server, endedWithError: chan<bool>) {
  listenAndServeOn(s, peerEcho) catch _ {
    endedWithError <- true
    return
  }
  endedWithError <- false
}

test "listenAndServeOn retries a failed accept instead of ending, and still returns an error after s.close()" {
  let real = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let fake = fakeFailingListener{ real = real, failures = 3, fails = 0 }
  let s = Server{
    listener = fake, drain = newDrainState(), maxBody = defaultMaxBodyBytes,
    idleTimeoutNs = defaultIdleTimeoutNs, maxRequests = defaultMaxRequestsPerConn,
    closed = false,
  }
  let port = s.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let endedWithError = chan<bool>(1)
  spawn backoffServe(s, endedWithError)

  // The first `fake.failures` accepts fail (simulating EMFILE); the old
  // `let c = s.listener.accept()?` loop returns on the very first one and
  // never answers this dial, failing this assertion.
  let res = getTimeout("http://127.0.0.1:${port}/", 2000) catch e {
    s.close()
    assert(false, "get after ${itoa(fake.failures)} simulated accept failures: ${e.message()}")
    return
  }
  assert(res.status == 200, "status = ${itoa(res.status)}")
  assert(res.body == "127.0.0.1", "the handler saw req.peer = '${res.body}'")
  assert(
    fake.fails == fake.failures,
    "simulated accept failures seen = ${itoa(fake.fails)}, want ${itoa(fake.failures)}",
  )

  s.close()
  let sawError = <- endedWithError
  assert(sawError, "listenAndServeOn returned without an error after s.close()")
}

// The shared helper both `listenAndServeOn` and `serveTlsOn` (server.bit)
// delegate their retry/backoff decision to — exercised directly, generic over
// a plain `int` in place of `Conn`/`TlsConn`, since the decision itself does
// not depend on which. This is `serveTlsOn`'s own test double: nothing about
// `TlsListener` (std/tls) needs to be faked, because `acceptLoop` is the
// exact code `serveTlsOn` runs on every accept.
test "acceptLoop retries transient accept failures, keeps serving, and returns once closed" {
  let fails = 0
  let onAcceptCalls = 0
  let closedNow = false
  let accept: () => int! = () => {
    if (closedNow) {
      fail newError("listener closed")
    }
    if (fails < 3) {
      fails = fails + 1
      fail newError("fake transient accept failure")
    }
    return 0
  }
  let onAccept: (int) => () = (c) => {
    onAcceptCalls = onAcceptCalls + 1
    // Stop the loop after the first successful accept, the same way `s.close()`
    // stops `listenAndServeOn` above — otherwise this loop runs forever.
    closedNow = true
  }
  acceptLoop(accept, () => closedNow, maxAcceptBackoffNs, onAccept) catch _ {
    assert(fails == 3, "transient failures retried = ${itoa(fails)}, want 3")
    assert(onAcceptCalls == 1, "onAccept calls = ${itoa(onAcceptCalls)}, want 1")
    return
  }
  assert(false, "acceptLoop returned without an error")
}
