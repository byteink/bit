// stdlib/http/drained.test.bit — a keep-alive read that follows a short one
// (#5985, #5993). On Linux and macOS the runtime waits for readiness instead
// of issuing a read it has proved would return EAGAIN; every test here first
// answers one request, so the read under test is always the one after a
// short read.
//
// Same module as http.bit (SPEC §19): `dial`, `serve`, `indexOf`, `sleep`,
// `Millisecond`, and keepalive.test.bit's `newRespReader`, `wireServe`,
// `echoPath` and `drainedToZero` are all siblings, so nothing is imported.

// One served request on `conn`, so the server's next read follows a short
// one. Returns the response, or "" when the write or the read failed.
fn warmOne(conn: Conn, reader: respReader): string {
  conn.write("GET /warm HTTP/1.1\r\nHost: x\r\n\r\n") catch _ {
    return ""
  }
  let res = reader.next() catch _ {
    return ""
  }
  return res
}

fn startEcho(): (Server, int)! {
  let s = serve("127.0.0.1", 0)?
  let port = s.port()?
  spawn wireServe(s, echoPath)
  return s, port
}

test "after a drained read, two requests pipelined in one write are each answered" {
  let (s, port) = startEcho() catch e {
    assert(false, "startEcho: ${e.message()}")
    return
  }
  let conn = dial("127.0.0.1", port) catch e {
    s.close()
    assert(false, "dial: ${e.message()}")
    return
  }
  let reader = newRespReader(conn)
  assert(indexOf(warmOne(conn, reader), "\r\n\r\nwarm") >= 0, "warm-up request was not answered")

  conn.write("GET /first HTTP/1.1\r\nHost: x\r\n\r\nGET /second HTTP/1.1\r\nHost: x\r\n\r\n") catch e {
    s.close()
    assert(false, "write: ${e.message()}")
    return
  }
  let r1 = reader.next() catch e {
    s.close()
    assert(false, "response 1: ${e.message()}")
    return
  }
  assert(indexOf(r1, "\r\n\r\nfirst") >= 0, "response 1 body was not 'first':\n${r1}")
  let r2 = reader.next() catch e {
    s.close()
    assert(false, "response 2: ${e.message()}")
    return
  }
  assert(indexOf(r2, "\r\n\r\nsecond") >= 0, "response 2 body was not 'second':\n${r2}")

  conn.close()
  s.close()
}

test "after a drained read, a request split across two writes with a delay is answered" {
  let (s, port) = startEcho() catch e {
    assert(false, "startEcho: ${e.message()}")
    return
  }
  let conn = dial("127.0.0.1", port) catch e {
    s.close()
    assert(false, "dial: ${e.message()}")
    return
  }
  let reader = newRespReader(conn)
  assert(indexOf(warmOne(conn, reader), "\r\n\r\nwarm") >= 0, "warm-up request was not answered")

  // The server reads the first half short, so it waits before reading the
  // second; the delay makes sure the second half arrives after that wait.
  conn.write("GET /split HTTP/1.1\r\nHo") catch e {
    s.close()
    assert(false, "write 1: ${e.message()}")
    return
  }
  sleep(50 * Millisecond)
  conn.write("st: x\r\n\r\n") catch e {
    s.close()
    assert(false, "write 2: ${e.message()}")
    return
  }
  let res = reader.next() catch e {
    s.close()
    assert(false, "response: ${e.message()}")
    return
  }
  assert(indexOf(res, "\r\n\r\nsplit") >= 0, "response body was not 'split':\n${res}")

  conn.close()
  s.close()
}

// The peer closes right behind its request, so the server's short read of
// the request may consume the FIN with it, and the read after the response
// then returns 0 with no new edge unless the drain marked the FIN. The reset
// the response provokes from a closed peer can also wake the server, so this
// proves the connection is forgotten in time, not which event woke it (the
// ticket carries a half-close probe for that). The 60 s default idle timeout
// is far past `drainedToZero`'s 500 ms bound, so a server left parked fails.
test "a peer that sends a request and closes at once is forgotten by the server" {
  let (s, port) = startEcho() catch e {
    assert(false, "startEcho: ${e.message()}")
    return
  }
  let conn = dial("127.0.0.1", port) catch e {
    s.close()
    assert(false, "dial: ${e.message()}")
    return
  }
  let reader = newRespReader(conn)
  assert(indexOf(warmOne(conn, reader), "\r\n\r\nwarm") >= 0, "warm-up request was not answered")

  conn.write("GET /last HTTP/1.1\r\nHost: x\r\n\r\n") catch e {
    s.close()
    assert(false, "write: ${e.message()}")
    return
  }
  conn.close()
  assert(
    drainedToZero(s),
    "server still held the connection 500ms after the peer closed",
  )
  s.close()
}

// Half a request, then close: the server writes nothing, so no reset
// arrives to wake it. Its short read of the fragment may take the FIN along
// with the data, and the read it then needs returns 0 with no new event, so
// only the drain's EOF mark keeps it from parking until the idle timeout.
test "a peer that sends half a request and closes is forgotten by the server" {
  let (s, port) = startEcho() catch e {
    assert(false, "startEcho: ${e.message()}")
    return
  }
  let conn = dial("127.0.0.1", port) catch e {
    s.close()
    assert(false, "dial: ${e.message()}")
    return
  }
  let reader = newRespReader(conn)
  assert(indexOf(warmOne(conn, reader), "\r\n\r\nwarm") >= 0, "warm-up request was not answered")

  conn.write("GET /half HTTP/1.1\r\nHo") catch e {
    s.close()
    assert(false, "write: ${e.message()}")
    return
  }
  conn.close()
  assert(
    drainedToZero(s),
    "server still held the connection 500ms after the peer closed mid-request",
  )
  s.close()
}
