test "NO_PROXY domain list has twelve fixed policy rows (#8529)" {
  let hosts = [
    "example.com", "example.com", "api.example.com", "api.example.com",
    "API.Example.COM", "example.com", "example.com", "example.com",
    "badexample.com", "example.com.evil", "example.com", "example.com",
  ]
  let lists = [
    "", "example.com", "example.com", ".example.com", "example.com",
    "other.test,example.com", " \tother.test , example.com\t ", " * ",
    "example.com", "example.com", ", ,\t,",
    "example.com:443,10.0.0.0/8,2001:db8::/32,[::1]",
  ]
  let wants = [false, true, true, true, true, true, true, true, false, false, false, false]
  let i = 0
  while (i < 12) {
    assert(proxyDomainBypass(hosts[i], lists[i]) == wants[i], "NO_PROXY row ${i}")
    i = i + 1
  }
  assert(hosts[4] == "API.Example.COM" && lists[6] == " \tother.test , example.com\t ")
}

test "NO_PROXY rejects badexample.com against example.com (#8529)" {
  assert(!proxyDomainBypass("badexample.com", "example.com"))
}

test "NO_PROXY bounds inputs before wildcard normalization (#8529)" {
  assert(!proxyDomainBypass(repeat("a", 254), "*"))
  assert(!proxyDomainBypass("example.com", repeat(" ", 65536) + "*"))
  assert(proxyDomainBypass(repeat("a", 253), "*"))
  assert(proxyDomainBypass("example.com", repeat(" ", 65535) + "*"))
}

test "NO_PROXY wildcard requires a valid bare target (#8529)" {
  for host of [
    "", "bad host", "bad\thost", "bad\rhost", "bad\nhost", "bad\0host", "bad\x7fhost",
    "https://example.com", "example.com/path", "example.com?x", "example.com#x",
    "user@example.com", "[::1]", "example.com:443", "bad::host", "*", ".", "..", "bad..host",
  ] {
    assert(!proxyDomainBypass(host, "*"), "invalid target ${host}")
  }
}

test "NO_PROXY domain matching excludes IP and authority policy (#8529)" {
  assert(!proxyDomainBypass("api.192.0.2.1", "192.0.2.1"))
  assert(!proxyDomainBypass("192.0.2.1", "2.1"))
  assert(!proxyDomainBypass("192.0.2.1", "192.0.2.1"))
  assert(!proxyDomainBypass("2001:db8::1", "2001:db8::1"))
  assert(proxyDomainBypass("192.0.2.1", "*"))
  assert(proxyDomainBypass("2001:db8::1", "*"))
  for list of [
    "example.com:443", "example.com/8", "[example.com]", "https://example.com",
    "user@example.com", "*,other.test", "other.test,*", "*.example.com",
  ] {
    assert(!proxyDomainBypass("api.example.com", list), "unsupported token ${list}")
  }
}
