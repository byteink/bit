// Bit standard library — http module: multipart/form-data writing (RFC 7578).
//
// `FormBuilder` is the writer that goes with the parser in ./multipart.bit: a
// caller adds text fields and file parts, `build` returns the request body and
// the `Content-Type` that names its boundary. What it writes is what
// `parseMultipart` reads back byte for byte.
//
// BOUNDARY (RFC 2046 §5.1.1). Every `build` draws a fresh boundary from the
// CSPRNG: `bit-form-` and 128 random bits in hex, 41 bytes, all of them
// boundary characters. A boundary that occurs anywhere in a part — its headers
// or its content — would end that part early, so each candidate is searched for
// in every part and a candidate that occurs is dropped for the next. Eight
// candidates that all occur fail the build; with 128 random bits that is a
// payload built to collide, not an accident.
//
// NAMES (RFC 7578 §4.2). A field name, a filename and a part's content type go
// into header lines. Within the quoted `name` and `filename` a `"` and a `\`
// are written as the quoted-pair `\"` and `\\`, which is what the parser reads
// back and what Go's mime/multipart writes. A CR, a LF or a NUL cannot be
// quoted and would let a caller-supplied value end the header line and start
// another, so `field` and `file` refuse them.
//
// ONE BUFFER. Every part is held as its rendered header block and its content
// when it is added, so `build` knows the size of the whole body before it
// writes the first byte and fills a buffer allocated at that size once: the
// bytes move through `append`'s bulk string copy, never one byte at a time and
// never through string concatenation.

import { indexOf } from "std/strings"

// Boundary candidates tried before a build is refused.
const boundaryTries: int = 8

// The content type of a file part whose caller gave none (RFC 7578 §4.4).
const defaultFileType: string = "application/octet-stream"

// One part as it is written: its header block, ending in the blank line, and
// its content.
class formPart {
  head: string,
  content: string,
}

// What `FormBuilder.build` returns: the value of the request's `Content-Type`
// header, which carries the boundary, and the body it delimits.
export class FormBody {
  export contentType: string,
  export body: string,
}

// A `multipart/form-data` request body being assembled. `FormBuilder()` is
// empty; parts are written in the order they are added, and a name may repeat.
export class FormBuilder {
  parts: []formPart

  init() {
    this.parts = []formPart(0)
  }

  // Adds the text field `name` holding `value`. Fails if `name` holds a CR, a
  // LF or a NUL.
  export field(name: string, value: string): ()! {
    let head = "Content-Disposition: form-data; name=\"${quoteParam(name)?}\"\r\n\r\n"
    this.parts = append(this.parts, formPart{ head = head, content = value })
  }

  // Adds the file part `name`, announced as `filename` with the declared
  // `contentType` (`application/octet-stream` when empty) and holding
  // `content` exactly. Fails if `name`, `filename` or `contentType` holds a CR,
  // a LF or a NUL.
  export file(name: string, filename: string, contentType: string, content: []byte): ()! {
    let ctype = contentType
    if (ctype == "") {
      ctype = defaultFileType
    }
    checkLine(ctype)?
    let head = "Content-Disposition: form-data; name=\"${quoteParam(name)?}\"; filename=\"${quoteParam(filename)?}\"\r\nContent-Type: ${ctype}\r\n\r\n"
    this.parts = append(this.parts, formPart{ head = head, content = string(content) })
  }

  // The body and its `Content-Type`, under a boundary drawn from the CSPRNG.
  // Fails when nothing was added, or when no candidate boundary is free of
  // every part.
  export build(): FormBody! {
    return this.buildWith(randomBoundary)?
  }

  // `build` with the boundary candidates drawn from `next`, so a test can name
  // them.
  buildWith(next: () => string): FormBody! {
    if (len(this.parts) == 0) {
      fail newError("multipart: a form body needs at least one part")
    }
    let boundary = this.freeBoundary(next)?
    let open = "--${boundary}\r\n"
    // Delimiter, headers, content and the CRLF that ends the part, then the
    // close delimiter `--boundary--` and its CRLF.
    let total = len(boundary) + 6
    for p of this.parts {
      total = total + len(open) + len(p.head) + len(p.content) + 2
    }
    let buf = []byte(0, total)
    for p of this.parts {
      buf = append(buf, open)
      buf = append(buf, p.head)
      buf = append(buf, p.content)
      buf = append(buf, "\r\n")
    }
    buf = append(buf, "--${boundary}--\r\n")
    assert(len(buf) == total, "multipart: the body is not the size it was allocated at")
    return FormBody{
      contentType = "multipart/form-data; boundary=${boundary}",
      body = string(buf),
    }
  }

  // The first candidate from `next` that no part contains.
  freeBoundary(next: () => string): string! {
    let tries = 0
    while (tries < boundaryTries) {
      tries = tries + 1
      let b = next()
      if (this.free(b)) {
        return b
      }
    }
    fail newError("multipart: every boundary tried occurs in a part")
  }

  // Whether no part holds `boundary`, in its headers or its content.
  free(boundary: string): bool {
    for p of this.parts {
      if (indexOf(p.head, boundary) >= 0 || indexOf(p.content, boundary) >= 0) {
        return false
      }
    }
    return true
  }
}

// A boundary: a fixed prefix and 128 random bits in hex.
fn randomBoundary(): string {
  return "bit-form-${encodeHex(randomBytes(16))}"
}

// Fails if `s` holds a byte that cannot be written into a header line.
fn checkLine(s: string): ()! {
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == 13 || c == 10 || c == 0) {
      fail newError("multipart: a name, filename or content type cannot hold a CR, a LF or a NUL")
    }
    i = i + 1
  }
}

// `s` as the inside of a quoted-string: `"` and `\` each behind a `\`. Fails
// on a byte `checkLine` refuses.
fn quoteParam(s: string): string! {
  checkLine(s)?
  let extra = 0
  let i = 0
  while (i < len(s)) {
    if (s[i] == '"' || s[i] == '\\') {
      extra = extra + 1
    }
    i = i + 1
  }
  if (extra == 0) {
    return s
  }
  let out = []byte(0, len(s) + extra)
  i = 0
  while (i < len(s)) {
    if (s[i] == '"' || s[i] == '\\') {
      out = append(out, '\\')
    }
    out = append(out, s[i])
    i = i + 1
  }
  return string(out)
}
