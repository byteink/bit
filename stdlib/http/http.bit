// Bit standard library — http module.
//
// HTTP/1.1 over std/net TCP — or, for `https://` URLs and `serveTls`, over
// std/tls (TLS 1.3) — built entirely in Bit: the flagship of the concurrency
// model. A server accepts connections and handles each on its own green thread;
// a client dials, sends one request, and reads the response. The wire protocol is
// identical on either transport; only the socket swaps, behind a small
// `byteStream` interface (`netStream` for cleartext, `tlsStream` for TLS).
//
// Scope for v1: HTTP/1.1 over cleartext or TLS, one request per connection
// (`Connection: close`), no redirects. Headers are carried as a raw block and
// read with `header()` — case-insensitively, by name. Request framing follows
// RFC 9112 §6: a body is read only when `Content-Length` or
// `Transfer-Encoding: chunked` says so — chunked is decoded, never passed
// through as raw framing bytes — and a request declaring both, an unparsable
// Content-Length, or a malformed chunk stream is rejected with 400 rather than
// guessed at. Responses are always sent with an exact Content-Length; the
// server itself never emits chunked.

import { listen, dial, dialDeadline, udpBind, Listener, Conn } from "std/net"
import { indexOf, hasPrefix, toLower } from "std/strings"
import {
  dial as tlsDial, dialDeadline as tlsDialDeadline, listen as tlsListen, TlsConn, TlsConfig,
  TlsListener, newTlsConfig, emptyTrustStore, TrustStore as TlsTrustStore,
} from "std/tls"
import { systemRoots, bundled, Certificate } from "std/crypto"
import {
  connect as h2connect, accept as h2accept, defaultConfig as h2defaultConfig,
  Transport as H2Transport, newTransport as h2newTransport,
  Request as H2Request, Response as H2Response, HeaderField as H2HeaderField,
} from "std/http2"
import {
  h3Dial, h3DialDeadline, h3Listen, H3Conn, H3Request, H3Response, HeaderField,
} from "std/http3"

// ---------------------------------------------------------------------------
// Small parsing helpers
// ---------------------------------------------------------------------------

// A non-negative integer parsed from a decimal string, or -1 on any non-digit
// (including the empty string) or a magnitude that would overflow `int` — it
// never silently wraps, the same guard `strings.parseInt` uses. Used for
// status codes, Content-Length, and a client's response status and URL port,
// all of which come straight off the network or a caller-supplied string.
export fn atoi(s: string): int {
  if (len(s) == 0) {
    return -1
  }
  // (2^63 - 1) = 9223372036854775807 = 922337203685477580 * 10 + 7.
  let maxDiv10 = 922337203685477580
  let maxMod10 = 7
  let v = 0
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      return -1
    }
    let d = i64(c - '0')
    if (v > maxDiv10 || (v == maxDiv10 && d > maxMod10)) {
      return -1
    }
    v = v * 10 + d
    i = i + 1
  }
  return v
}

// The decimal text of a non-negative integer.
fn itoa(n: int): string {
  if (n == 0) {
    return "0"
  }
  let count = 0
  let t = n
  while (t > 0) {
    count = count + 1
    t = t / 10
  }
  let b = []byte(count)
  let v = n
  let i = count - 1
  while (v > 0) {
    b[i] = byte(48 + v % 10)
    v = v / 10
    i = i - 1
  }
  return string(b)
}

// The non-negative integer a hex chunk-size token denotes, or -1 on any
// non-hex-digit (including the empty string) or a token long enough that the
// magnitude could approach an i64 overflow. Capped at 15 hex digits (60 bits,
// ~1.15e18) — comfortably below `int`'s 63-bit magnitude, so the accumulation
// below can never wrap.
fn hexToInt(s: string): int {
  if (len(s) == 0 || len(s) > 15) {
    return -1
  }
  let v = 0
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    let d = 0
    if (c >= '0' && c <= '9') {
      d = i64(c - '0')
    } else if (c >= 'a' && c <= 'f') {
      d = i64(c - 'a') + 10
    } else if (c >= 'A' && c <= 'F') {
      d = i64(c - 'A') + 10
    } else {
      return -1
    }
    v = v * 16 + d
    i = i + 1
  }
  return v
}

// `s` with leading and trailing spaces and tabs removed.
fn trimSpace(s: string): string {
  let lo = 0
  while (lo < len(s) && (s[lo] == ' ' || s[lo] == '\t')) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && (s[hi - 1] == ' ' || s[hi - 1] == '\t')) {
    hi = hi - 1
  }
  return s[lo:hi]
}

// The value of header `name` in a raw header block ("Name: value\r\n..."),
// matched case-insensitively at a line start, or "" if absent.
export fn header(block: string, name: string): string {
  let lower = toLower(block)
  let key = toLower(name) + ":"
  let start = 0 - 1
  if (hasPrefix(lower, key)) {
    start = len(key)
  } else {
    let at = indexOf(lower, "\r\n" + key)
    if (at >= 0) {
      start = at + 2 + len(key)
    }
  }
  if (start < 0) {
    return ""
  }
  let rest = block[start:len(block)]
  let end = indexOf(rest, "\r\n")
  if (end < 0) {
    return trimSpace(rest)
  }
  return trimSpace(rest[0:end])
}

// ---------------------------------------------------------------------------
// Request / Response
// ---------------------------------------------------------------------------

// A parsed HTTP request. `headers` is the raw block; read individual fields with
// `header(req.headers, "...")`.
export class Request { method: string, path: string, headers: string, body: string }

// An HTTP response. The server fills in `Content-Length` and `Connection` for
// you; set `contentType` and any extra `headers` (raw, "Name: value\r\n"-framed)
// yourself.
export class Response { status: int, contentType: string, headers: string, body: string }

// A `200 OK` response carrying `body` as UTF-8 text.
export fn ok(body: string): Response {
  return Response{ status: 200, contentType: "text/plain; charset=utf-8", headers: "", body: body }
}

// A response with an explicit status and a text body.
export fn respond(status: int, body: string): Response {
  return Response{
    status: status,
    contentType: "text/plain; charset=utf-8",
    headers: "",
    body: body,
  }
}

// ---------------------------------------------------------------------------
// Response.setHeader / addHeader / getHeader (#2179)
//
// `res.headers` is spliced into the wire response by `serializeResponse`
// completely unexamined (below) — so, before these existed, the ONLY way to
// set a response header was `res.headers = res.headers + "Name: value\r\n"`,
// making the framing bytes the application's responsibility on every single
// header, forever. The moment a service reflects any request-derived value
// into a header this way, an attacker-controlled CR or LF in that value
// injects an arbitrary extra header line (Set-Cookie, CORS, a whole second
// response) into bytes the application believes are one ordinary field. These
// three methods are the chokepoint that stops that: every value is checked
// for CR, LF and NUL, and every name for a non-token byte, before either ever
// reaches `headers`. The raw field is left in place so existing code keeps
// compiling; it is just no longer the only door.
// ---------------------------------------------------------------------------

// The non-alphanumeric bytes RFC 9110 §5.6.2 permits in a header field name
// token, alongside letters and digits — everything else, including ':',
// whitespace and the other delimiters (`"(),/;<=>?@[\]{}`), is rejected by
// `isTokenByte` below.
const tokenExtraBytes = "!#$%&'*+-.^_`|~"

// True if `c` is an RFC 9110 §5.6.2 `token` character — the bytes legal in a
// header field name.
fn isTokenByte(c: byte): bool {
  if (c >= 'a' && c <= 'z') {
    return true
  }
  if (c >= 'A' && c <= 'Z') {
    return true
  }
  if (c >= '0' && c <= '9') {
    return true
  }
  return indexOf(tokenExtraBytes, string([]byte{ c })) >= 0
}

// True if `name` is non-empty and every byte is a token character.
fn validHeaderName(name: string): bool {
  if (len(name) == 0) {
    return false
  }
  let i = 0
  while (i < len(name)) {
    if (!isTokenByte(name[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

// True if `value` contains a CR, LF or NUL byte. A header value is single-line,
// full stop (RFC 9110 §5.5) — unlike `hasBareControlChar` below (which exists
// to parse an incoming message and so tolerates a well-formed embedded CRLF
// pair as ordinary line framing), a value handed to `setHeader`/`addHeader`
// has no legitimate embedded CR or LF to spare, paired or not.
fn hasForbiddenValueByte(value: string): bool {
  let i = 0
  while (i < len(value)) {
    let c = value[i]
    if (c == '\r' || c == '\n' || c == '\0') {
      return true
    }
    i = i + 1
  }
  return false
}

// The [start, end) byte range of `name`'s header line in `block` (a
// "Name: value\r\n"-framed block, matched case-insensitively at a line
// start), including its trailing "\r\n" — or (-1, -1) if absent. Shared by
// `setHeader` (to replace a prior line) and `getHeader` (to read one), via
// `header()` above.
fn headerLineRange(block: string, name: string): (int, int) {
  let lower = toLower(block)
  let key = toLower(name) + ":"
  let start = 0 - 1
  if (hasPrefix(lower, key)) {
    start = 0
  } else {
    let at = indexOf(lower, "\r\n" + key)
    if (at >= 0) {
      start = at + 2
    }
  }
  if (start < 0) {
    return 0 - 1, 0 - 1
  }
  let rest = block[start:len(block)]
  let end = indexOf(rest, "\r\n")
  if (end < 0) {
    return start, len(block)
  }
  return start, start + end + 2
}

// Sets header `name` to `value`, replacing any existing field of the same
// name — the ordinary case, where a repeated field would be a bug rather
// than intentional (unlike `Set-Cookie`; see `addHeader`). Fails on a
// non-token byte in `name` or a CR, LF or NUL in `value`, and in that case
// leaves `r.headers` untouched.
export fn (r: Response) setHeader(name: string, value: string): ()! {
  if (!validHeaderName(name)) {
    fail newError("setHeader: invalid header name")
  }
  if (hasForbiddenValueByte(value)) {
    fail newError("setHeader: value for ${name} contains a CR, LF or NUL byte")
  }
  let (start, end) = headerLineRange(r.headers, name)
  if (start >= 0) {
    r.headers = r.headers[0:start] + r.headers[end:len(r.headers)]
  }
  r.headers = r.headers + "${name}: ${value}\r\n"
}

// Appends header `name: value` without removing any existing field of the
// same name — the spelling `Set-Cookie` needs, since a response can
// legitimately carry more than one. Same validation and failure behavior as
// `setHeader`.
export fn (r: Response) addHeader(name: string, value: string): ()! {
  if (!validHeaderName(name)) {
    fail newError("addHeader: invalid header name")
  }
  if (hasForbiddenValueByte(value)) {
    fail newError("addHeader: value for ${name} contains a CR, LF or NUL byte")
  }
  r.headers = r.headers + "${name}: ${value}\r\n"
}

// The value of header `name` already set on `r` (via `setHeader`,
// `addHeader`, or the raw `headers` field), matched case-insensitively, or
// "" if absent. On a field set more than once via `addHeader`, returns the
// first occurrence — the same policy `header()` uses for a request.
export fn (r: Response) getHeader(name: string): string {
  return header(r.headers, name)
}

// The reason phrase for a status code — a small, common set; anything else is
// labelled generically, which is legal (clients key on the numeric status).
fn reason(status: int): string {
  switch (status) {
    case 200:
      return "OK"
    case 201:
      return "Created"
    case 204:
      return "No Content"
    case 301:
      return "Moved Permanently"
    case 302:
      return "Found"
    case 400:
      return "Bad Request"
    case 401:
      return "Unauthorized"
    case 403:
      return "Forbidden"
    case 404:
      return "Not Found"
    case 405:
      return "Method Not Allowed"
    case 500:
      return "Internal Server Error"
    default:
      return "Status"
  }
}

// The wire form of a response: status line, framing headers, a blank line, body.
fn serializeResponse(res: Response): string {
  let head = "HTTP/1.1 ${res.status} ${reason(res.status)}\r\n"
  head = head + "Content-Length: ${itoa(len(res.body))}\r\n"
  head = head + "Content-Type: ${res.contentType}\r\n"
  head = head + "Connection: close\r\n"
  head = head + res.headers
  head = head + "\r\n"
  return head + res.body
}

// ---------------------------------------------------------------------------
// Transport: the byte stream a message is read from and written to
// ---------------------------------------------------------------------------

// The transport an HTTP/1.1 exchange runs over: read up to `n` bytes (empty at
// end of stream), write a whole string, and close. `netStream` wraps a cleartext
// std/net socket; `tlsStream` wraps a std/tls connection. The wire logic
// (`readMessage`, `serializeResponse`, `readAllStream`) speaks only this
// interface, so http:// and https:// share one code path and differ only in which
// stream they carry.
interface byteStream { readUp(n: int): string!, writeStr(s: string): ()!, shut() }

// A cleartext transport over a std/net TCP connection. `conn.deadlineNs != 0`
// (set by `dialDeadline`/`setDeadline`, #2291) routes through the
// deadline-bound siblings; the zero value — every `dial()`-made `Conn` — takes
// the exact call it always has, so a caller with no timeout sees no change.
class netStream { conn: Conn }
fn (s: netStream) readUp(n: int): string! {
  if (s.conn.deadlineNs != 0) {
    return s.conn.readDeadline(n)?
  }
  return s.conn.read(n)
}
fn (s: netStream) writeStr(data: string): ()! {
  if (s.conn.deadlineNs != 0) {
    s.conn.writeDeadline(data)?
    return
  }
  s.conn.write(data)?
}
fn (s: netStream) shut() { s.conn.close() }

// A TLS transport over a std/tls connection; strings cross the byte-oriented
// record API as raw bytes, no reinterpretation.
class tlsStream { conn: TlsConn }
fn (s: tlsStream) readUp(n: int): string! { return string(s.conn.read(n)?) }
fn (s: tlsStream) writeStr(data: string): ()! { s.conn.write([]byte(data))? }
fn (s: tlsStream) shut() { s.conn.close() }

// Read `s` to end of stream (an empty read). Only safe against a peer that
// closes — `Connection: close` guarantees it here.
fn readAllStream(s: byteStream): string! {
  let out = ""
  while (true) {
    let chunk = s.readUp(65536)?
    if (len(chunk) == 0) {
      return out
    }
    // ponytail: O(N^2) over the chunk count (~80 for a 1 MB body = ~50 MB of
    // copies, negligible); a bulk byte-buffer append would make it O(N) but needs
    // a runtime primitive the stdlib does not yet have.
    out = out + chunk
  }
}

// ---------------------------------------------------------------------------
// Reading a message off a connection
// ---------------------------------------------------------------------------

// Reads from `s`, appending to `buf`, until `buf` contains `delim`. Returns the
// text before the first `delim` and whatever of `buf` came after it (bytes
// already buffered past the delimiter — e.g. the start of a chunk body or the
// next header line). Fails if the peer closes before `delim` ever appears.
fn readUntil(s: byteStream, buf: string, delim: string): (string, string)! {
  let b = buf
  while (indexOf(b, delim) < 0) {
    let chunk = s.readUp(4096)?
    if (len(chunk) == 0) {
      fail newError("readMessage: connection closed mid-message")
    }
    b = b + chunk
  }
  let at = indexOf(b, delim)
  return b[0:at], b[at + len(delim):len(b)]
}

// Decodes a `Transfer-Encoding: chunked` body (RFC 9112 §7.1) off `s`,
// `buffered` being whatever body-position bytes already arrived with the
// headers. Fails on a non-hex chunk-size, a stream that closes mid-chunk, or a
// chunk stream that never terminates within `maxChunks` — bounded so the loop
// is provably finite (Power of 10 rule 2), not to cap a legitimately large body.
fn decodeChunkedBody(s: byteStream, buffered: string): string! {
  let maxChunks = 1048576
  let buf = buffered
  let body = ""
  let n = 0
  while (n < maxChunks) {
    n = n + 1
    let (sizeLine, rest) = readUntil(s, buf, "\r\n")?
    buf = rest
    let hexPart = sizeLine
    let semi = indexOf(sizeLine, ";")
    if (semi >= 0) {
      hexPart = sizeLine[0:semi]
    }
    let size = hexToInt(trimSpace(hexPart))
    if (size < 0) {
      fail newError("readMessage: bad chunk size")
    }
    if (size == 0) {
      // The final chunk: consume the (usually empty) trailer section, one
      // field line at a time, up to and including its terminating blank line.
      let t = 0
      while (t < maxChunks) {
        t = t + 1
        let (line, rest2) = readUntil(s, buf, "\r\n")?
        buf = rest2
        if (len(line) == 0) {
          return body
        }
      }
      fail newError("readMessage: too many trailer fields")
    }
    while (len(buf) < size + 2) {
      let chunk = s.readUp(4096)?
      if (len(chunk) == 0) {
        fail newError("readMessage: connection closed mid-chunk")
      }
      buf = buf + chunk
    }
    body = body + buf[0:size]
    buf = buf[size + 2:len(buf)]
  }
  fail newError("readMessage: too many chunks")
}

// Whether `headBlock` (the request line plus header lines, before splitting)
// carries a bare CR, a bare LF, or a NUL. RFC 9110 §5.5 forbids all three in a
// field value; letting one survive lets a single header line on the wire
// masquerade as several once something reflects it — e.g. a bare LF inside a
// header value is not a line terminator to this parser, so it stays embedded
// in that header's value, and anything after it (`Set-Cookie: admin=1`, say)
// rides along as attacker-controlled text inside what the application sees as
// one ordinary value. Scanning the whole block, not just header values, also
// catches an attempt to smuggle one through the request line.
fn hasBareControlChar(headBlock: string): bool {
  let i = 0
  while (i < len(headBlock)) {
    let c = headBlock[i]
    if (c == '\0') {
      return true
    }
    if (c == '\n' && (i == 0 || headBlock[i - 1] != '\r')) {
      return true
    }
    if (c == '\r' && (i + 1 >= len(headBlock) || headBlock[i + 1] != '\n')) {
      return true
    }
    i = i + 1
  }
  return false
}

// Header block size cap, checked while `readMessage` is still accumulating
// the request line and headers (the body is already bounded — by
// `Content-Length`, or chunk-by-chunk by `decodeChunkedBody`'s `maxChunks`).
// Deny by default: nothing else stops a peer that never sends the
// terminating blank line from growing `buf` without limit while this loop
// keeps reading. 64 KiB is generous for any real request (ordinary headers
// run a few hundred bytes) and is the same order of magnitude other servers
// use as a hard ceiling (nginx's 8 KiB per line, Node's ~16 KiB total
// default).
const maxHeaderBytes = 65536

// Reads a full HTTP message off `s`: the request line, headers, and a body
// framed per RFC 9112 §6 — `Content-Length` bytes read exactly (truncating
// anything beyond, e.g. a pipelined next request), `Transfer-Encoding: chunked`
// decoded, and no framing header meaning no body, whatever bytes happened to
// already be sitting in the read buffer. Fails — the caller answers 400 — on a
// message declaring both `Content-Length` and `Transfer-Encoding`, an
// unparsable `Content-Length`, an unsupported transfer coding, a malformed
// chunk stream, a bare CR/LF/NUL inside the header block (RFC 9110 §5.5 —
// left unrejected, that is a response-header-injection primitive for any
// handler that reflects a header value), or a header block over
// `maxHeaderBytes`. An empty method/path/headers/body `Request` (no failure)
// means the peer closed before a complete header block arrived; the caller's
// subsequent write will simply fail against the already-closed socket.
// The result of reading up to the blank line that ends a message's headers:
// the header block and whatever body bytes already arrived with it, or
// `closed` if the peer went away before the headers were complete. Split out
// of `readMessage` (#2448).
class HeaderReadResult { headBlock: string, bodyStart: string, closed: bool }

fn readHeaderBlock(s: byteStream): HeaderReadResult! {
  let buf = ""
  while (indexOf(buf, "\r\n\r\n") < 0) {
    if (len(buf) > maxHeaderBytes) {
      fail newError("readMessage: header block exceeds ${maxHeaderBytes} bytes")
    }
    let chunk = s.readUp(4096)?
    if (len(chunk) == 0) {
      return HeaderReadResult{ headBlock: "", bodyStart: "", closed: true }
    }
    buf = buf + chunk
  }
  let sep = indexOf(buf, "\r\n\r\n")
  return HeaderReadResult{ headBlock: buf[0:sep], bodyStart: buf[sep + 4:len(buf)], closed: false }
}

// The method and request-target off a request line ("GET /path HTTP/1.1"),
// or both "" if there is no space to split on. Split out of `readMessage`
// (#2448).
class RequestLine { method: string, path: string }

fn parseRequestLine(requestLine: string): RequestLine {
  let sp1 = indexOf(requestLine, " ")
  if (sp1 < 0) {
    return RequestLine{ method: "", path: "" }
  }
  let method = requestLine[0:sp1]
  let afterMethod = requestLine[sp1 + 1:len(requestLine)]
  let sp2 = indexOf(afterMethod, " ")
  let path = afterMethod
  if (sp2 >= 0) {
    path = afterMethod[0:sp2]
  }
  return RequestLine{ method: method, path: path }
}

// Reads the remaining `cl - len(initial)` bytes of a Content-Length-framed
// request body onto `initial`. Unlike the response-side twin
// (`readContentLengthBody`, client.bit), a peer closing early is tolerated
// (`break`, not `fail`) — request framing has always been lenient here.
// Split out of `readMessage` (#2448).
fn readRequestContentLengthBody(s: byteStream, initial: string, cl: int): string! {
  let body = initial
  if (len(body) > cl) {
    body = body[0:cl]
  }
  while (len(body) < cl) {
    let chunk = s.readUp(4096)?
    if (len(chunk) == 0) {
      break
    }
    body = body + chunk
    if (len(body) > cl) {
      body = body[0:cl]
    }
  }
  return body
}

// Frame the body per RFC 9112 §6. Content-Length and Transfer-Encoding
// together is a request-smuggling-grade ambiguity — reject outright rather
// than pick one. Chunked is decoded, never handed through as raw framing.
// Neither header present means no body, regardless of what already arrived.
// Split out of `readMessage` (#2448).
fn readRequestBody(s: byteStream, bodyStart: string, headers: string): string! {
  let clText = header(headers, "content-length")
  let teText = toLower(header(headers, "transfer-encoding"))
  let hasCl = len(clText) > 0
  let hasTe = len(teText) > 0
  if (hasCl && hasTe) {
    fail newError("readMessage: Content-Length and Transfer-Encoding both present")
  }
  if (hasTe) {
    if (teText != "chunked") {
      fail newError("readMessage: unsupported Transfer-Encoding")
    }
    return decodeChunkedBody(s, bodyStart)?
  }
  if (hasCl) {
    let cl = atoi(clText)
    if (cl < 0) {
      fail newError("readMessage: invalid Content-Length")
    }
    return readRequestContentLengthBody(s, bodyStart, cl)?
  }
  return ""
}

fn readMessage(s: byteStream): Request! {
  let hdr = readHeaderBlock(s)?
  if (hdr.closed) {
    // Peer closed mid-headers: return an empty request, the caller stops.
    return Request{ method: "", path: "", headers: "", body: "" }
  }
  let headBlock = hdr.headBlock
  let bodyStart = hdr.bodyStart
  if (hasBareControlChar(headBlock)) {
    fail newError("readMessage: control character in header block")
  }

  // Split the request line off the top of the header block.
  let eol = indexOf(headBlock, "\r\n")
  let requestLine = headBlock
  let headers = ""
  if (eol >= 0) {
    requestLine = headBlock[0:eol]
    headers = headBlock[eol + 2:len(headBlock)]
  }
  let rl = parseRequestLine(requestLine)
  let body = readRequestBody(s, bodyStart, headers)?
  return Request{ method: rl.method, path: rl.path, headers: headers, body: body }
}
