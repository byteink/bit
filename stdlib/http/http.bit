// Bit standard library — http module.
//
// HTTP/1.1 over std/net TCP — or, for `https://` URLs and `serveTls`, over
// std/tls (TLS 1.3) — built entirely in Bit: the flagship of the concurrency
// model. A server accepts connections and handles each on its own green thread;
// a client dials, sends one request, and reads the response. The wire protocol is
// identical on either transport; only the socket swaps, behind a small
// `byteStream` interface (`netStream` for cleartext, `tlsStream` for TLS).
//
// Scope for v1: HTTP/1.1 over cleartext or TLS, one request per connection
// (`Connection: close`), no redirects. Headers are carried as a raw block and
// read with `header()` — case-insensitively, by name. Request framing follows
// RFC 9112 §6: a body is read only when `Content-Length` or
// `Transfer-Encoding: chunked` says so — chunked is decoded, never passed
// through as raw framing bytes — and a request declaring both, an unparsable
// Content-Length, or a malformed chunk stream is rejected with 400 rather than
// guessed at. Responses are always sent with an exact Content-Length; the
// server itself never emits chunked.

import { listen, dial, udpBind, Listener, Conn } from "std/net"
import { indexOf, hasPrefix, toLower } from "std/strings"
import {
  dial as tlsDial, listen as tlsListen, TlsConn, TlsConfig,
  newTlsConfig, emptyTrustStore, TrustStore as TlsTrustStore,
} from "std/tls"
import { systemRoots, bundled, Certificate } from "std/crypto"
import {
  connect as h2connect, accept as h2accept, defaultConfig as h2defaultConfig,
  Transport as H2Transport, newTransport as h2newTransport,
  Request as H2Request, Response as H2Response, HeaderField as H2HeaderField,
} from "std/http2"
import {
  h3Dial, h3Accept, h3Listen, H3Conn, H3Listener, H3Request, H3Response, H3ServerRequest, HeaderField,
} from "std/http3"

// ---------------------------------------------------------------------------
// Small parsing helpers
// ---------------------------------------------------------------------------

// A non-negative integer parsed from a decimal string, or -1 on any non-digit
// (including the empty string) or a magnitude that would overflow `int` — it
// never silently wraps, the same guard `strings.parseInt` uses. Used for
// status codes, Content-Length, and a client's response status and URL port,
// all of which come straight off the network or a caller-supplied string.
export fn atoi(s: string): int {
  if (len(s) == 0) {
    return -1
  }
  // (2^63 - 1) = 9223372036854775807 = 922337203685477580 * 10 + 7.
  let maxDiv10 = 922337203685477580
  let maxMod10 = 7
  let v = 0
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      return -1
    }
    let d = i64(c - '0')
    if (v > maxDiv10 || (v == maxDiv10 && d > maxMod10)) {
      return -1
    }
    v = v * 10 + d
    i = i + 1
  }
  return v
}

// The decimal text of a non-negative integer.
fn itoa(n: int): string {
  if (n == 0) {
    return "0"
  }
  let count = 0
  let t = n
  while (t > 0) {
    count = count + 1
    t = t / 10
  }
  let b = []byte(count)
  let v = n
  let i = count - 1
  while (v > 0) {
    b[i] = byte(48 + v % 10)
    v = v / 10
    i = i - 1
  }
  return string(b)
}

// The non-negative integer a hex chunk-size token denotes, or -1 on any
// non-hex-digit (including the empty string) or a token long enough that the
// magnitude could approach an i64 overflow. Capped at 15 hex digits (60 bits,
// ~1.15e18) — comfortably below `int`'s 63-bit magnitude, so the accumulation
// below can never wrap.
fn hexToInt(s: string): int {
  if (len(s) == 0 || len(s) > 15) {
    return -1
  }
  let v = 0
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    let d = 0
    if (c >= '0' && c <= '9') {
      d = i64(c - '0')
    } else if (c >= 'a' && c <= 'f') {
      d = i64(c - 'a') + 10
    } else if (c >= 'A' && c <= 'F') {
      d = i64(c - 'A') + 10
    } else {
      return -1
    }
    v = v * 16 + d
    i = i + 1
  }
  return v
}

// `s` with leading and trailing spaces and tabs removed.
fn trimSpace(s: string): string {
  let lo = 0
  while (lo < len(s) && (s[lo] == ' ' || s[lo] == '\t')) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && (s[hi - 1] == ' ' || s[hi - 1] == '\t')) {
    hi = hi - 1
  }
  return s[lo:hi]
}

// The value of header `name` in a raw header block ("Name: value\r\n..."),
// matched case-insensitively at a line start, or "" if absent.
export fn header(block: string, name: string): string {
  let lower = toLower(block)
  let key = toLower(name) + ":"
  let start = 0 - 1
  if (hasPrefix(lower, key)) {
    start = len(key)
  } else {
    let at = indexOf(lower, "\r\n" + key)
    if (at >= 0) {
      start = at + 2 + len(key)
    }
  }
  if (start < 0) {
    return ""
  }
  let rest = block[start:len(block)]
  let end = indexOf(rest, "\r\n")
  if (end < 0) {
    return trimSpace(rest)
  }
  return trimSpace(rest[0:end])
}

// ---------------------------------------------------------------------------
// Request / Response
// ---------------------------------------------------------------------------

// A parsed HTTP request. `headers` is the raw block; read individual fields with
// `header(req.headers, "...")`.
export struct Request { method: string, path: string, headers: string, body: string }

// An HTTP response. The server fills in `Content-Length` and `Connection` for
// you; set `contentType` and any extra `headers` (raw, "Name: value\r\n"-framed)
// yourself.
export struct Response { status: int, contentType: string, headers: string, body: string }

// A `200 OK` response carrying `body` as UTF-8 text.
export fn ok(body: string): Response {
  return Response{ status: 200, contentType: "text/plain; charset=utf-8", headers: "", body: body }
}

// A response with an explicit status and a text body.
export fn respond(status: int, body: string): Response {
  return Response{
    status: status,
    contentType: "text/plain; charset=utf-8",
    headers: "",
    body: body,
  }
}

// The reason phrase for a status code — a small, common set; anything else is
// labelled generically, which is legal (clients key on the numeric status).
fn reason(status: int): string {
  if (status == 200) {
    return "OK"
  }
  if (status == 201) {
    return "Created"
  }
  if (status == 204) {
    return "No Content"
  }
  if (status == 301) {
    return "Moved Permanently"
  }
  if (status == 302) {
    return "Found"
  }
  if (status == 400) {
    return "Bad Request"
  }
  if (status == 401) {
    return "Unauthorized"
  }
  if (status == 403) {
    return "Forbidden"
  }
  if (status == 404) {
    return "Not Found"
  }
  if (status == 405) {
    return "Method Not Allowed"
  }
  if (status == 500) {
    return "Internal Server Error"
  }
  return "Status"
}

// The wire form of a response: status line, framing headers, a blank line, body.
fn serializeResponse(res: Response): string {
  let head = "HTTP/1.1 ${res.status} ${reason(res.status)}\r\n"
  head = head + "Content-Length: ${itoa(len(res.body))}\r\n"
  head = head + "Content-Type: ${res.contentType}\r\n"
  head = head + "Connection: close\r\n"
  head = head + res.headers
  head = head + "\r\n"
  return head + res.body
}

// ---------------------------------------------------------------------------
// Transport: the byte stream a message is read from and written to
// ---------------------------------------------------------------------------

// The transport an HTTP/1.1 exchange runs over: read up to `n` bytes (empty at
// end of stream), write a whole string, and close. `netStream` wraps a cleartext
// std/net socket; `tlsStream` wraps a std/tls connection. The wire logic
// (`readMessage`, `serializeResponse`, `readAllStream`) speaks only this
// interface, so http:// and https:// share one code path and differ only in which
// stream they carry.
interface byteStream { readUp(n: int): string!, writeStr(s: string): ()!, shut() }

// A cleartext transport over a std/net TCP connection.
struct netStream { conn: Conn }
fn (s: netStream) readUp(n: int): string! { return s.conn.read(n) }
fn (s: netStream) writeStr(data: string): ()! { s.conn.write(data)? }
fn (s: netStream) shut() { s.conn.close() }

// A TLS transport over a std/tls connection; strings cross the byte-oriented
// record API as raw bytes, no reinterpretation.
struct tlsStream { conn: TlsConn }
fn (s: tlsStream) readUp(n: int): string! { return string(s.conn.read(n)?) }
fn (s: tlsStream) writeStr(data: string): ()! { s.conn.write([]byte(data))? }
fn (s: tlsStream) shut() { s.conn.close() }

// Read `s` to end of stream (an empty read). Only safe against a peer that
// closes — `Connection: close` guarantees it here.
fn readAllStream(s: byteStream): string! {
  let out = ""
  while (true) {
    let chunk = s.readUp(65536)?
    if (len(chunk) == 0) {
      return out
    }
    // ponytail: O(N^2) over the chunk count (~80 for a 1 MB body = ~50 MB of
    // copies, negligible); a bulk byte-buffer append would make it O(N) but needs
    // a runtime primitive the stdlib does not yet have.
    out = out + chunk
  }
  return out
}

// ---------------------------------------------------------------------------
// Reading a message off a connection
// ---------------------------------------------------------------------------

// Reads from `s`, appending to `buf`, until `buf` contains `delim`. Returns the
// text before the first `delim` and whatever of `buf` came after it (bytes
// already buffered past the delimiter — e.g. the start of a chunk body or the
// next header line). Fails if the peer closes before `delim` ever appears.
fn readUntil(s: byteStream, buf: string, delim: string): (string, string)! {
  let b = buf
  while (indexOf(b, delim) < 0) {
    let chunk = s.readUp(4096)?
    if (len(chunk) == 0) {
      fail newError("readMessage: connection closed mid-message")
    }
    b = b + chunk
  }
  let at = indexOf(b, delim)
  return b[0:at], b[at + len(delim):len(b)]
}

// Decodes a `Transfer-Encoding: chunked` body (RFC 9112 §7.1) off `s`,
// `buffered` being whatever body-position bytes already arrived with the
// headers. Fails on a non-hex chunk-size, a stream that closes mid-chunk, or a
// chunk stream that never terminates within `maxChunks` — bounded so the loop
// is provably finite (Power of 10 rule 2), not to cap a legitimately large body.
fn decodeChunkedBody(s: byteStream, buffered: string): string! {
  let maxChunks = 1048576
  let buf = buffered
  let body = ""
  let n = 0
  while (n < maxChunks) {
    n = n + 1
    let (sizeLine, rest) = readUntil(s, buf, "\r\n")?
    buf = rest
    let hexPart = sizeLine
    let semi = indexOf(sizeLine, ";")
    if (semi >= 0) {
      hexPart = sizeLine[0:semi]
    }
    let size = hexToInt(trimSpace(hexPart))
    if (size < 0) {
      fail newError("readMessage: bad chunk size")
    }
    if (size == 0) {
      // The final chunk: consume the (usually empty) trailer section, one
      // field line at a time, up to and including its terminating blank line.
      let t = 0
      while (t < maxChunks) {
        t = t + 1
        let (line, rest2) = readUntil(s, buf, "\r\n")?
        buf = rest2
        if (len(line) == 0) {
          return body
        }
      }
      fail newError("readMessage: too many trailer fields")
    }
    while (len(buf) < size + 2) {
      let chunk = s.readUp(4096)?
      if (len(chunk) == 0) {
        fail newError("readMessage: connection closed mid-chunk")
      }
      buf = buf + chunk
    }
    body = body + buf[0:size]
    buf = buf[size + 2:len(buf)]
  }
  fail newError("readMessage: too many chunks")
}

// Whether `headBlock` (the request line plus header lines, before splitting)
// carries a bare CR, a bare LF, or a NUL. RFC 9110 §5.5 forbids all three in a
// field value; letting one survive lets a single header line on the wire
// masquerade as several once something reflects it — e.g. a bare LF inside a
// header value is not a line terminator to this parser, so it stays embedded
// in that header's value, and anything after it (`Set-Cookie: admin=1`, say)
// rides along as attacker-controlled text inside what the application sees as
// one ordinary value. Scanning the whole block, not just header values, also
// catches an attempt to smuggle one through the request line.
fn hasBareControlChar(headBlock: string): bool {
  let i = 0
  while (i < len(headBlock)) {
    let c = headBlock[i]
    if (c == '\0') {
      return true
    }
    if (c == '\n' && (i == 0 || headBlock[i - 1] != '\r')) {
      return true
    }
    if (c == '\r' && (i + 1 >= len(headBlock) || headBlock[i + 1] != '\n')) {
      return true
    }
    i = i + 1
  }
  return false
}

// Reads a full HTTP message off `s`: the request line, headers, and a body
// framed per RFC 9112 §6 — `Content-Length` bytes read exactly (truncating
// anything beyond, e.g. a pipelined next request), `Transfer-Encoding: chunked`
// decoded, and no framing header meaning no body, whatever bytes happened to
// already be sitting in the read buffer. Fails — the caller answers 400 — on a
// message declaring both `Content-Length` and `Transfer-Encoding`, an
// unparsable `Content-Length`, an unsupported transfer coding, a malformed
// chunk stream, or a bare CR/LF/NUL inside the header block (RFC 9110 §5.5 —
// left unrejected, that is a response-header-injection primitive for any
// handler that reflects a header value). An empty method/path/headers/body
// `Request` (no failure) means the peer closed before a complete header block
// arrived; the caller's subsequent write will simply fail against the
// already-closed socket.
fn readMessage(s: byteStream): Request! {
  let buf = ""
  while (indexOf(buf, "\r\n\r\n") < 0) {
    let chunk = s.readUp(4096)?
    if (len(chunk) == 0) {
      // Peer closed mid-headers: return an empty request, the caller stops.
      return Request{ method: "", path: "", headers: "", body: "" }
    }
    buf = buf + chunk
  }
  let sep = indexOf(buf, "\r\n\r\n")
  let headBlock = buf[0:sep]
  let bodyStart = buf[sep + 4:len(buf)]
  if (hasBareControlChar(headBlock)) {
    fail newError("readMessage: control character in header block")
  }

  // Split the request line off the top of the header block.
  let eol = indexOf(headBlock, "\r\n")
  let requestLine = headBlock
  let headers = ""
  if (eol >= 0) {
    requestLine = headBlock[0:eol]
    headers = headBlock[eol + 2:len(headBlock)]
  }
  let sp1 = indexOf(requestLine, " ")
  let method = ""
  let path = ""
  if (sp1 >= 0) {
    method = requestLine[0:sp1]
    let afterMethod = requestLine[sp1 + 1:len(requestLine)]
    let sp2 = indexOf(afterMethod, " ")
    if (sp2 >= 0) {
      path = afterMethod[0:sp2]
    } else {
      path = afterMethod
    }
  }

  // Frame the body per RFC 9112 §6. Content-Length and Transfer-Encoding
  // together is a request-smuggling-grade ambiguity — reject outright rather
  // than pick one. Chunked is decoded, never handed through as raw framing.
  // Neither header present means no body, regardless of what already arrived.
  let clText = header(headers, "content-length")
  let teText = toLower(header(headers, "transfer-encoding"))
  let hasCl = len(clText) > 0
  let hasTe = len(teText) > 0
  if (hasCl && hasTe) {
    fail newError("readMessage: Content-Length and Transfer-Encoding both present")
  }
  let body = ""
  if (hasTe) {
    if (teText != "chunked") {
      fail newError("readMessage: unsupported Transfer-Encoding")
    }
    body = decodeChunkedBody(s, bodyStart)?
  } else if (hasCl) {
    let cl = atoi(clText)
    if (cl < 0) {
      fail newError("readMessage: invalid Content-Length")
    }
    body = bodyStart
    if (len(body) > cl) {
      body = body[0:cl]
    }
    while (len(body) < cl) {
      let chunk = s.readUp(4096)?
      if (len(chunk) == 0) {
        break
      }
      body = body + chunk
      if (len(body) > cl) {
        body = body[0:cl]
      }
    }
  }
  return Request{ method: method, path: path, headers: headers, body: body }
}
