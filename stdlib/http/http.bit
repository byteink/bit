// Bit standard library — http module.
//
// HTTP/1.1 over std/net TCP — or, for `https://` URLs and `serveTls`, over
// std/tls (TLS 1.3) — built entirely in Bit: the flagship of the concurrency
// model. A server accepts connections and handles each on its own green thread;
// a client dials, sends one request, and reads the response. The wire protocol is
// identical on either transport; only the socket swaps, behind a small
// `byteStream` interface (`netStream` for cleartext, `tlsStream` for TLS).
//
// Scope for v1: HTTP/1.1 over cleartext or TLS, no redirects. The
// `listenAndServe`/`serve` server keeps a connection open for more than one
// request by default (RFC 9112 §9.3, #5419): `Connection: close` is honoured
// when the client sends it, sent by the server when it must close after a
// response (an HTTP/1.0 peer, an idle or request-count-capped connection),
// and otherwise the connection persists. Headers are carried as a raw block
// and read with `header()` — case-insensitively, by name. Request framing
// follows RFC 9112 §6: a body is read only when `Content-Length` or
// `Transfer-Encoding: chunked` says so — chunked is decoded, never passed
// through as raw framing bytes — and a request declaring both, an unparsable
// Content-Length, or a malformed chunk stream is rejected with 400 rather than
// guessed at. Responses are always sent with an exact Content-Length; the
// server itself never emits chunked. The direct `Server.accept()`/`Exchange`
// API stays one request per connection (`Exchange.respond`'s own comment).

import { listen, dial, dialDeadline, udpBind, Listener, Conn, UdpSocket } from "std/net"
import { indexOf, hasPrefix, toLower, newBuilder } from "std/strings"
// `monotonic` is client.bit's import (same module, SPEC §19) — used here too
// (`serveOne`, server.bit, #5419) without a second import, which would be
// E0042.
import {
  dial as tlsDial, dialDeadline as tlsDialDeadline, listen as tlsListen, TlsConn, TlsConfig,
  TlsListener, newTlsConfig, emptyTrustStore, TrustStore as TlsTrustStore,
} from "std/tls"
import { systemRoots, bundled, Certificate } from "std/crypto"
import {
  connect as h2connect, accept as h2accept, defaultConfig as h2defaultConfig, Config as H2Config,
  Transport as H2Transport, newTransport as h2newTransport,
  Request as H2Request, Response as H2Response, HeaderField as H2HeaderField,
} from "std/http2"
import {
  h3Dial, h3DialDeadline, h3Listen, H3Conn, H3Request, H3Response, HeaderField,
} from "std/http3"

// ---------------------------------------------------------------------------
// Small parsing helpers
// ---------------------------------------------------------------------------

// A non-negative integer parsed from a decimal string, or -1 on any non-digit
// (including the empty string) or a magnitude that would overflow `int` — it
// never silently wraps, the same guard `strings.parseInt` uses. Used for
// status codes, Content-Length, and a client's response status and URL port,
// all of which come straight off the network or a caller-supplied string.
export fn atoi(s: string): int {
  if (len(s) == 0) {
    return -1
  }
  // (2^63 - 1) = 9223372036854775807 = 922337203685477580 * 10 + 7.
  let maxDiv10 = 922337203685477580
  let maxMod10 = 7
  let v = 0
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      return -1
    }
    let d = i64(c - '0')
    if (v > maxDiv10 || (v == maxDiv10 && d > maxMod10)) {
      return -1
    }
    v = v * 10 + d
    i = i + 1
  }
  return v
}

// The decimal text of a non-negative integer.
fn itoa(n: int): string {
  if (n == 0) {
    return "0"
  }
  let count = 0
  let t = n
  while (t > 0) {
    count = count + 1
    t = t / 10
  }
  let b = []byte(count)
  let v = n
  let i = count - 1
  while (v > 0) {
    b[i] = byte(48 + v % 10)
    v = v / 10
    i = i - 1
  }
  return string(b)
}

// The number of decimal digits `itoa(n)` would produce for a non-negative
// `n` — 1 for 0 — without allocating the string itself. `serializeResponse`
// (#5860) uses this to size its presized buffer for a status code or a
// Content-Length count, then `putDigits` below writes the same digits
// straight into it.
fn digitCount(n: int): int {
  if (n == 0) {
    return 1
  }
  let count = 0
  let t = n
  while (t > 0) {
    count = count + 1
    t = t / 10
  }
  return count
}

// The non-negative integer a hex chunk-size token denotes, or -1 on any
// non-hex-digit (including the empty string) or a token long enough that the
// magnitude could approach an i64 overflow. Capped at 15 hex digits (60 bits,
// ~1.15e18) — comfortably below `int`'s 63-bit magnitude, so the accumulation
// below can never wrap.
fn hexToInt(s: string): int {
  if (len(s) == 0 || len(s) > 15) {
    return -1
  }
  let v = 0
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    let d = 0
    if (c >= '0' && c <= '9') {
      d = i64(c - '0')
    } else if (c >= 'a' && c <= 'f') {
      d = i64(c - 'a') + 10
    } else if (c >= 'A' && c <= 'F') {
      d = i64(c - 'A') + 10
    } else {
      return -1
    }
    v = v * 16 + d
    i = i + 1
  }
  return v
}

// `s` with leading and trailing spaces and tabs removed.
fn trimSpace(s: string): string {
  let lo = 0
  while (lo < len(s) && (s[lo] == ' ' || s[lo] == '\t')) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && (s[hi - 1] == ' ' || s[hi - 1] == '\t')) {
    hi = hi - 1
  }
  return s[lo:hi]
}

// True if ASCII bytes `a` and `b` are the same character ignoring case. RFC
// 9110 §5.1 makes a header field name a case-insensitive ASCII token, so
// folding 'A'-'Z' to 'a'-'z' is the whole of case-insensitivity here:
// `toLower`'s Unicode folding would only fold code points a field name may not
// contain in the first place.
fn asciiFoldEqual(a: byte, b: byte): bool {
  let x = a
  if (x >= 'A' && x <= 'Z') {
    x = x + 32
  }
  let y = b
  if (y >= 'A' && y <= 'Z') {
    y = y + 32
  }
  return x == y
}

// True if the `len(name)` bytes of `block` at `at` are `name` ignoring ASCII
// case. The caller guarantees `at + len(name) <= len(block)`.
fn headerNameAt(block: string, at: int, name: string): bool {
  let i = 0
  while (i < len(name)) {
    if (!asciiFoldEqual(block[at + i], name[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

// The byte index at which `name`'s field line begins in a raw header block
// ("Name: value\r\n..."), or -1 when no line does. A field line begins at byte
// 0 or immediately after a CRLF and the name must be followed by ':', so a
// name that occurs only inside a field VALUE never matches, and neither does a
// name that is merely a prefix of a longer field name. The first such line
// wins, which is what makes a repeated field read as its first occurrence.
//
// Scans `block` in place and allocates nothing (#5437). The lookup used to
// start with `toLower(block)`, which copies the whole block and allocates per
// rune while doing it, on every lookup a handler makes (the three framing
// fields every request needs go through `framingLines`, one walk, #5919).
// Terminates: each iteration either returns or moves `at` past a CRLF, so at
// most `len(block) / 2` of them run.
fn headerLineStart(block: string, name: string): int {
  let at = 0
  while (at + len(name) < len(block)) {
    if (block[at + len(name)] == ':' && headerNameAt(block, at, name)) {
      return at
    }
    let nl = indexOfFrom(block, "\r\n", at)
    if (nl < 0) {
      return 0 - 1
    }
    at = nl + 2
  }
  return 0 - 1
}

// The value of header `name` in a raw header block ("Name: value\r\n..."),
// matched case-insensitively at a line start, or "" if absent.
export fn header(block: string, name: string): string {
  return fieldValue(block, headerLineStart(block, name), name)
}

// The trimmed value of the `name` field line that begins at `start` in
// `block`, or "" when `start` is -1 (no such line).
fn fieldValue(block: string, start: int, name: string): string {
  if (start < 0) {
    return ""
  }
  let valueStart = start + len(name) + 1
  let end = indexOfFrom(block, "\r\n", valueStart)
  if (end < 0) {
    end = len(block)
  }
  return trimSpace(block[valueStart:end])
}

// True if a `name` field line begins at `at`: the name, case-insensitively,
// followed by ':'. The same test `headerLineStart` applies at each line start,
// bounds check included.
fn fieldLineAt(block: string, at: int, name: string): bool {
  return at + len(name) < len(block) &&
    block[at + len(name)] == ':' &&
    headerNameAt(block, at, name)
}

// Where the Content-Length, Transfer-Encoding and Connection field lines begin
// in a raw header block, in that order: each exactly `headerLineStart(block,
// name)` (first line wins, -1 when absent), read back with `fieldValue`. Every
// HTTP/1 request needs all three before its handler runs; three `header()`
// calls walked the block three times, and on a typical GET all three names are
// absent, so each walk visited every line (#5919). This walks the line starts
// once. Line starts rather than values because a multi-value return of
// strings boxes each one on the heap, which three ints do not. Terminates:
// each iteration moves `at` past a CRLF or leaves the loop.
fn framingLines(block: string): (int, int, int) {
  let clAt = 0 - 1
  let teAt = 0 - 1
  let connAt = 0 - 1
  let at = 0
  while (at < len(block)) {
    if (clAt < 0 && fieldLineAt(block, at, "content-length")) {
      clAt = at
    }
    if (teAt < 0 && fieldLineAt(block, at, "transfer-encoding")) {
      teAt = at
    }
    if (connAt < 0 && fieldLineAt(block, at, "connection")) {
      connAt = at
    }
    let nl = indexOfFrom(block, "\r\n", at)
    if (nl < 0) {
      break
    }
    at = nl + 2
  }
  return clAt, teAt, connAt
}

// ---------------------------------------------------------------------------
// Request / Response
// ---------------------------------------------------------------------------

// A parsed HTTP request. `headers` is the raw block; read individual fields with
// `header(req.headers, "...")`.
//
// `peer` is the client's IPv4 address in dotted quad — the transport's own view
// of who connected, which no client can set. It is the address to rate-limit,
// ban or audit by; `X-Forwarded-For` and friends are peer-supplied strings and
// are not. On HTTP/1.1 and HTTP/2 it is read off the socket with
// `net.Conn.peerIp()` (#4524); on HTTP/3 there is no connected socket to ask, so
// it comes from `quic.Conn.peerIp()` — the source of the datagram that
// established the QUIC connection (#4555, see h3.bit's `h3glueRequestIn`).
//
// `peer` is `""` — never a placeholder address — whenever there is no address to
// be had: a `Request` built by hand or by a test, and one whose connection died
// before the address could be read. `""` is the zero value of `string` (SPEC §12.2,
// §13.4), so every existing construction site that omits the field keeps
// compiling and keeps meaning "no peer known".
// `version` is the request line's third token verbatim ("HTTP/1.1",
// "HTTP/1.0"), or "" when the request line had none — matched exactly
// against "HTTP/1.1" (RFC 9110 §9.1's case sensitivity) by `wantsClose`
// (server.bit, #5419) to decide whether this connection persists by default.
// `closeAsked` is `wantsClose`'s answer for this request's Connection field and
// version, decided by `readMessage` in the same walk that frames the body
// (#5919) and read by `answerOne`. A bool rather than the field's text: storing
// a computed string in a field boxes it, one allocation per request.
// Unexported, so a hand-built `Request` leaves it false.
export class Request {
  export method: string,
  export path: string,
  export version: string,
  export headers: string,
  export body: string,
  export peer: string,
  closeAsked: bool,
}

// An HTTP response. The server fills in `Content-Length` and `Connection` for
// you; set `contentType` and any extra `headers` (raw, "Name: value\r\n"-framed)
// yourself.
export class Response {
  export status: int
  export contentType: string
  export headers: string
  export body: string
  // Sets header `name` to `value`, replacing any existing field of the same
  // name — the ordinary case, where a repeated field would be a bug rather
  // than intentional (unlike `Set-Cookie`; see `addHeader`). Fails on a
  // non-token byte in `name` or a CR, LF or NUL in `value`, and in that case
  // leaves `r.headers` untouched.
  export setHeader(name: string, value: string): ()! {
    if (!validHeaderName(name)) {
      fail newError("setHeader: invalid header name")
    }
    if (hasForbiddenValueByte(value)) {
      fail newError("setHeader: value for ${name} contains a CR, LF or NUL byte")
    }
    let (start, end) = headerLineRange(this.headers, name)
    if (start >= 0) {
      this.headers = this.headers[0:start] + this.headers[end:len(this.headers)]
    }
    this.headers = this.headers + "${name}: ${value}\r\n"
  }

  // Appends header `name: value` without removing any existing field of the
  // same name — the spelling `Set-Cookie` needs, since a response can
  // legitimately carry more than one. Same validation and failure behavior as
  // `setHeader`.
  export addHeader(name: string, value: string): ()! {
    if (!validHeaderName(name)) {
      fail newError("addHeader: invalid header name")
    }
    if (hasForbiddenValueByte(value)) {
      fail newError("addHeader: value for ${name} contains a CR, LF or NUL byte")
    }
    this.headers = this.headers + "${name}: ${value}\r\n"
  }

  // The value of header `name` already set on `r` (via `setHeader`,
  // `addHeader`, or the raw `headers` field), matched case-insensitively, or
  // "" if absent. On a field set more than once via `addHeader`, returns the
  // first occurrence — the same policy `header()` uses for a request.
  export getHeader(name: string): string {
    return header(this.headers, name)
  }
}

// A `200 OK` response carrying `body` as UTF-8 text.
export fn ok(body: string): Response {
  return Response{
    status = 200,
    contentType = "text/plain; charset=utf-8",
    headers = "",
    body = body,
  }
}

// A response with an explicit status and a text body.
export fn respond(status: int, body: string): Response {
  return Response{
    status = status,
    contentType = "text/plain; charset=utf-8",
    headers = "",
    body = body,
  }
}

// ---------------------------------------------------------------------------
// Response.setHeader / addHeader / getHeader (#2179)
//
// `res.headers` is spliced into the wire response by `serializeResponse`
// (below), which examines it for nothing but a `Content-Length` it owns
// itself — so, before these existed, the ONLY way to
// set a response header was `res.headers = res.headers + "Name: value\r\n"`,
// making the framing bytes the application's responsibility on every single
// header, forever. The moment a service reflects any request-derived value
// into a header this way, an attacker-controlled CR or LF in that value
// injects an arbitrary extra header line (Set-Cookie, CORS, a whole second
// response) into bytes the application believes are one ordinary field. These
// three methods are the chokepoint that stops that: every value is checked
// for CR, LF and NUL, and every name for a non-token byte, before either ever
// reaches `headers`. The raw field is left in place so existing code keeps
// compiling; it is just no longer the only door.
// ---------------------------------------------------------------------------

// The non-alphanumeric bytes RFC 9110 §5.6.2 permits in a header field name
// token, alongside letters and digits — everything else, including ':',
// whitespace and the other delimiters (`"(),/;<=>?@[\]{}`), is rejected by
// `isTokenByte` below.
const tokenExtraBytes = "!#$%&'*+-.^_`|~"

// RFC 9110 §9.1 makes the method token case-sensitive; matched exactly.
const methodHead = "HEAD"
const contentLengthField = "Content-Length"

// True if `c` is an RFC 9110 §5.6.2 `token` character — the bytes legal in a
// header field name.
fn isTokenByte(c: byte): bool {
  if (c >= 'a' && c <= 'z') {
    return true
  }
  if (c >= 'A' && c <= 'Z') {
    return true
  }
  if (c >= '0' && c <= '9') {
    return true
  }
  return indexOf(tokenExtraBytes, string([]byte{ c })) >= 0
}

// True if `name` is non-empty and every byte is a token character.
fn validHeaderName(name: string): bool {
  if (len(name) == 0) {
    return false
  }
  let i = 0
  while (i < len(name)) {
    if (!isTokenByte(name[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

// True if `value` contains a CR, LF or NUL byte. A header value is single-line,
// full stop (RFC 9110 §5.5) — unlike `hasBareControlChar` below (which exists
// to parse an incoming message and so tolerates a well-formed embedded CRLF
// pair as ordinary line framing), a value handed to `setHeader`/`addHeader`
// has no legitimate embedded CR or LF to spare, paired or not.
fn hasForbiddenValueByte(value: string): bool {
  let i = 0
  while (i < len(value)) {
    let c = value[i]
    if (c == '\r' || c == '\n' || c == '\0') {
      return true
    }
    i = i + 1
  }
  return false
}

// The [start, end) byte range of `name`'s header line in `block` (a
// "Name: value\r\n"-framed block, matched case-insensitively at a line
// start), including its trailing "\r\n" — or (-1, -1) if absent. Shared by
// `setHeader` (to replace a prior line) and `getHeader` (to read one), and
// finds the line with the same in-place scan `header()` uses
// (`headerLineStart` above), so both agree on what a field line is by
// construction rather than by two copies of the same rule.
fn headerLineRange(block: string, name: string): (int, int) {
  let start = headerLineStart(block, name)
  if (start < 0) {
    return 0 - 1, 0 - 1
  }
  let end = indexOfFrom(block, "\r\n", start)
  if (end < 0) {
    return start, len(block)
  }
  return start, end + 2
}

// `block` with every `name` field line removed. `serializeResponse` uses it to
// drop a handler-declared `Content-Length` before writing its own: two
// `Content-Length` fields with differing values make the framing invalid and
// the message unrecoverable (RFC 9112 §6.3), and a handler could have written
// more than one of them (`addHeader` appends). Bounded by `len(block)`: every
// iteration removes a whole line, so at most one per byte.
fn withoutHeaderLines(block: string, name: string): string {
  let out = block
  let removed = 0
  while (removed < len(block)) {
    let (start, end) = headerLineRange(out, name)
    if (start < 0) {
      return out
    }
    out = out[0:start] + out[end:len(out)]
    removed = removed + 1
  }
  return out
}

// The one `Content-Length` `block` declares, as it was written — or "" when
// there is nothing a framing layer may take at its word: no such field, more
// than one (differing values are an unrecoverable framing error, RFC 9112
// §6.3, so a repeat is not a claim), or a value that is not a plain decimal
// count. That last check is the load-bearing one: this value goes on the wire
// as framing rather than as an ordinary header, so a caller that set
// `Content-Length: abc` — or one with a sign, a space or a second number in
// it — must not be able to poison the framing of a message it does not own.
fn declaredContentLength(block: string): string {
  let (_, end) = headerLineRange(block, contentLengthField)
  if (end < 0) {
    return ""
  }
  let (dup, _) = headerLineRange(block[end:len(block)], contentLengthField)
  if (dup >= 0) {
    return ""
  }
  let value = header(block, contentLengthField)
  if (!isDecimalCount(value)) {
    return ""
  }
  return value
}

// A non-empty run of ASCII digits and nothing else — RFC 9112 §6.2's
// `Content-Length = 1*DIGIT`.
fn isDecimalCount(s: string): bool {
  if (len(s) == 0) {
    return false
  }
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      return false
    }
    i = i + 1
  }
  return true
}

// The single `Content-Length` a response is framed with, split as (declared
// text, count) rather than returned as one string (#5860): `serializeResponse`
// writes whichever one applies straight into its presized buffer, so the
// overwhelmingly common case — every non-HEAD response, and every HEAD whose
// body was already dropped without a declared length — never has to become an
// `itoa` string just to be copied into `w` and thrown away. `declared` non-empty
// means "write these bytes verbatim"; `declared` empty means "write `count`'s
// decimal digits", and `count` is meaningless when `declared` is non-empty.
//
// The bytes are counted whenever there are any, whatever the method: a body
// present is the representation itself, so its length is the number a GET
// would have sent, and a handler-declared field that disagrees with it is a
// response-smuggling claim to discard rather than a fact to honour (#4640).
// That covers every method but HEAD, and every HEAD whose response still
// carries the content the framer is about to withhold.
//
// A HEAD whose body is EMPTY has nothing to count — and counting the nothing
// declares every resource empty, which is the wrong answer rather than a
// missing one (#4635). RFC 9110 §9.3.2 wants "the same header fields ... as
// it would have sent if the request method had been GET", and once the
// content is gone the only party that still knows that number is the caller
// that dropped it: pkg/web's `withoutContent` (adapter.bit) sets the field
// from the body's length before stripping it, and `static()` declares
// `Res.declaredLen` for a branch that never reads the file (#4637). Only
// there is one well-formed declared field taken at its word; anything else
// falls back to the count, which for an empty body is the honest `0`.
fn framingLengthParts(res: Response, method: string): (string, int) {
  if (method == methodHead && len(res.body) == 0) {
    let declared = declaredContentLength(res.headers)
    if (len(declared) > 0) {
      return declared, 0
    }
  }
  return "", len(res.body)
}

// The reason phrase for a status code — a small, common set; anything else is
// labelled generically, which is legal (clients key on the numeric status).
fn reason(status: int): string {
  switch (status) {
    case 200:
      return "OK"
    case 201:
      return "Created"
    case 204:
      return "No Content"
    case 301:
      return "Moved Permanently"
    case 302:
      return "Found"
    case 400:
      return "Bad Request"
    case 401:
      return "Unauthorized"
    case 403:
      return "Forbidden"
    case 404:
      return "Not Found"
    case 405:
      return "Method Not Allowed"
    case 500:
      return "Internal Server Error"
    default:
      return "Status"
  }
}

// The wire form of a response to a request that used `method`: status line,
// framing headers, a blank line, body. A `HEAD` gets the identical head and
// no content at all (RFC 9110 §9.3.2), so its `Content-Length` is the octet
// count a `GET` would have sent — which is why the method has to reach here
// rather than a handler dropping the body itself. `method` is matched exactly
// (RFC 9110 §9.1 makes the method token case-sensitive); "" — an exchange
// answered without a `read()`, or a 400 for a request that never parsed — is
// framed as an ordinary body-carrying response, which is what it is.
//
// The framing layer owns `Content-Length`: whatever `framingLengthParts`
// decides is the ONLY field of that name on the wire, and every other one in
// `res.headers` is dropped rather than spliced in after it. Two differing
// ones are an unrecoverable framing error (RFC 9112 §6.3) — a
// response-smuggling primitive the day a connection carries more than one
// exchange. For a body-carrying response that value is counted from the bytes
// being written; only for a HEAD whose body is already empty, which leaves
// nothing to count, is a single well-formed declared field honoured instead
// (`framingLengthParts`, #4635, #4640).
// `mustClose` is the framing decision `wantsClose` (server.bit) already
// made — whether the connection closes after this response, per RFC 9112
// §9.3's negotiation between the request's own `Connection` header and the
// server's own limits (idle timeout, max requests, an HTTP/1.0 peer). This
// function only renders that decision onto the wire; it never re-derives it.
// Named `mustClose`, not `close`: `close` is a predeclared identifier
// (E0048).
// Copies `s` into `w` starting at `at`, returning the offset just past it —
// `serializeResponse`'s only way of putting bytes into its presized buffer,
// so every piece lands in order with no bounds check left to the caller.
fn putBytes(w: []byte, at: int, s: string): int {
  let i = 0
  let n = len(s)
  while (i < n) {
    w[at + i] = s[i]
    i = i + 1
  }
  return at + n
}

// Writes `n`'s decimal digits (`digitCount(n)` of them) into `w` starting at
// `at`, the same digits `itoa(n)` would allocate a string for — used instead
// of `itoa` here so a response's status code and body-length count never
// need their own throwaway string (#5860).
fn putDigits(w: []byte, at: int, n: int): int {
  if (n == 0) {
    w[at] = '0'
    return at + 1
  }
  let count = digitCount(n)
  let v = n
  let i = count - 1
  while (v > 0) {
    w[at + i] = byte(48 + v % 10)
    v = v / 10
    i = i - 1
  }
  return at + count
}

fn serializeResponse(res: Response, method: string, mustClose: bool): string {
  let reasonPhrase = reason(res.status)
  let (declaredLen, bodyLen) = framingLengthParts(res, method)
  let lengthTextLen = len(declaredLen)
  if (lengthTextLen == 0) {
    lengthTextLen = digitCount(bodyLen)
  }
  let connLine = "Connection: keep-alive\r\n"
  if (mustClose) {
    connLine = "Connection: close\r\n"
  }
  let extraHeaders = withoutHeaderLines(res.headers, contentLengthField)
  let includeBody = method != methodHead

  let n = len("HTTP/1.1 ") + digitCount(res.status) + len(" ") + len(reasonPhrase) + len("\r\n")
  n = n + len("Content-Length: ") + lengthTextLen + len("\r\n")
  n = n + len("Content-Type: ") + len(res.contentType) + len("\r\n")
  n = n + len(connLine) + len(extraHeaders) + len("\r\n")
  if (includeBody) {
    n = n + len(res.body)
  }

  let w = []byte(n)
  let i = 0
  i = putBytes(w, i, "HTTP/1.1 ")
  i = putDigits(w, i, res.status)
  i = putBytes(w, i, " ")
  i = putBytes(w, i, reasonPhrase)
  i = putBytes(w, i, "\r\n")
  i = putBytes(w, i, "Content-Length: ")
  if (len(declaredLen) > 0) {
    i = putBytes(w, i, declaredLen)
  } else {
    i = putDigits(w, i, bodyLen)
  }
  i = putBytes(w, i, "\r\n")
  i = putBytes(w, i, "Content-Type: ")
  i = putBytes(w, i, res.contentType)
  i = putBytes(w, i, "\r\n")
  i = putBytes(w, i, connLine)
  i = putBytes(w, i, extraHeaders)
  i = putBytes(w, i, "\r\n")
  if (includeBody) {
    i = putBytes(w, i, res.body)
  }
  return string(w)
}
