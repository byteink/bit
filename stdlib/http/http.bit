// Bit standard library — http module.
//
// HTTP/1.1 over std/net TCP — or, for `https://` URLs and `serveTls`, over
// std/tls (TLS 1.3) — built entirely in Bit: the flagship of the concurrency
// model. A server accepts connections and handles each on its own green thread;
// a client dials, sends one request, and reads the response. The wire protocol is
// identical on either transport; only the socket swaps, behind a small
// `byteStream` interface (`netStream` for cleartext, `tlsStream` for TLS).
//
// Scope for v1: HTTP/1.1 over cleartext or TLS, one request per connection
// (`Connection: close`), no chunked transfer encoding, no redirects. Headers are
// carried as a raw block and read with `header()` — case-insensitively, by name.

import { listen, dial, udpBind, Listener, Conn } from "std/net"
import { indexOf, hasPrefix, toLower } from "std/strings"
import {
  dial as tlsDial, listen as tlsListen, TlsConn, TlsConfig,
  newTlsConfig, emptyTrustStore, TrustStore as TlsTrustStore,
} from "std/tls"
import { systemRoots, bundled } from "std/crypto"
import {
  connect as h2connect, accept as h2accept, defaultConfig as h2defaultConfig,
  Transport as H2Transport, newTransport as h2newTransport,
  Request as H2Request, Response as H2Response, HeaderField as H2HeaderField,
} from "std/http2"
import {
  h3Dial, h3Accept, h3Listen, H3Conn, H3Listener, H3Request, H3Response, H3ServerRequest, HeaderField,
} from "std/http3"

// ---------------------------------------------------------------------------
// Small parsing helpers
// ---------------------------------------------------------------------------

// A non-negative integer parsed from a decimal string, or -1 on any non-digit
// (including the empty string). Used for status codes and Content-Length.
function atoi(s: string): int {
  if (len(s) == 0) {
    return -1
  }
  let v = 0
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      return -1
    }
    v = v * 10 + i64(c - '0')
    i = i + 1
  }
  return v
}

// The decimal text of a non-negative integer.
function itoa(n: int): string {
  if (n == 0) {
    return "0"
  }
  let count = 0
  let t = n
  while (t > 0) {
    count = count + 1
    t = t / 10
  }
  let b = []byte(count)
  let v = n
  let i = count - 1
  while (v > 0) {
    b[i] = byte(48 + v % 10)
    v = v / 10
    i = i - 1
  }
  return string(b)
}

// `s` with leading and trailing spaces and tabs removed.
function trimSpace(s: string): string {
  let lo = 0
  while (lo < len(s) && (s[lo] == ' ' || s[lo] == '\t')) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && (s[hi - 1] == ' ' || s[hi - 1] == '\t')) {
    hi = hi - 1
  }
  return s[lo:hi]
}

// The value of header `name` in a raw header block ("Name: value\r\n..."),
// matched case-insensitively at a line start, or "" if absent.
export function header(block: string, name: string): string {
  let lower = toLower(block)
  let key = toLower(name) + ":"
  let start = 0 - 1
  if (hasPrefix(lower, key)) {
    start = len(key)
  } else {
    let at = indexOf(lower, "\r\n" + key)
    if (at >= 0) {
      start = at + 2 + len(key)
    }
  }
  if (start < 0) {
    return ""
  }
  let rest = block[start:len(block)]
  let end = indexOf(rest, "\r\n")
  if (end < 0) {
    return trimSpace(rest)
  }
  return trimSpace(rest[0:end])
}

// ---------------------------------------------------------------------------
// Request / Response
// ---------------------------------------------------------------------------

// A parsed HTTP request. `headers` is the raw block; read individual fields with
// `header(req.headers, "...")`.
export struct Request { method: string, path: string, headers: string, body: string }

// An HTTP response. The server fills in `Content-Length` and `Connection` for
// you; set `contentType` and any extra `headers` (raw, "Name: value\r\n"-framed)
// yourself.
export struct Response { status: int, contentType: string, headers: string, body: string }

// A `200 OK` response carrying `body` as UTF-8 text.
export function ok(body: string): Response {
  return Response{ status: 200, contentType: "text/plain; charset=utf-8", headers: "", body: body }
}

// A response with an explicit status and a text body.
export function respond(status: int, body: string): Response {
  return Response{
    status: status,
    contentType: "text/plain; charset=utf-8",
    headers: "",
    body: body,
  }
}

// The reason phrase for a status code — a small, common set; anything else is
// labelled generically, which is legal (clients key on the numeric status).
function reason(status: int): string {
  if (status == 200) {
    return "OK"
  }
  if (status == 201) {
    return "Created"
  }
  if (status == 204) {
    return "No Content"
  }
  if (status == 301) {
    return "Moved Permanently"
  }
  if (status == 302) {
    return "Found"
  }
  if (status == 400) {
    return "Bad Request"
  }
  if (status == 401) {
    return "Unauthorized"
  }
  if (status == 403) {
    return "Forbidden"
  }
  if (status == 404) {
    return "Not Found"
  }
  if (status == 405) {
    return "Method Not Allowed"
  }
  if (status == 500) {
    return "Internal Server Error"
  }
  return "Status"
}

// The wire form of a response: status line, framing headers, a blank line, body.
function serializeResponse(res: Response): string {
  let head = "HTTP/1.1 ${res.status} ${reason(res.status)}\r\n"
  head = head + "Content-Length: ${itoa(len(res.body))}\r\n"
  head = head + "Content-Type: ${res.contentType}\r\n"
  head = head + "Connection: close\r\n"
  head = head + res.headers
  head = head + "\r\n"
  return head + res.body
}

// ---------------------------------------------------------------------------
// Transport: the byte stream a message is read from and written to
// ---------------------------------------------------------------------------

// The transport an HTTP/1.1 exchange runs over: read up to `n` bytes (empty at
// end of stream), write a whole string, and close. `netStream` wraps a cleartext
// std/net socket; `tlsStream` wraps a std/tls connection. The wire logic
// (`readMessage`, `serializeResponse`, `readAllStream`) speaks only this
// interface, so http:// and https:// share one code path and differ only in which
// stream they carry.
interface byteStream { readUp(n: int): string!, writeStr(s: string): ()!, shut() }

// A cleartext transport over a std/net TCP connection.
struct netStream { conn: Conn }
function (s: netStream) readUp(n: int): string! { return s.conn.read(n) }
function (s: netStream) writeStr(data: string): ()! { s.conn.write(data)? }
function (s: netStream) shut() { s.conn.close() }

// A TLS transport over a std/tls connection; strings cross the byte-oriented
// record API as raw bytes, no reinterpretation.
struct tlsStream { conn: TlsConn }
function (s: tlsStream) readUp(n: int): string! { return string(s.conn.read(n)?) }
function (s: tlsStream) writeStr(data: string): ()! { s.conn.write([]byte(data))? }
function (s: tlsStream) shut() { s.conn.close() }

// Read `s` to end of stream (an empty read). Only safe against a peer that
// closes — `Connection: close` guarantees it here.
function readAllStream(s: byteStream): string! {
  let out = ""
  while (true) {
    let chunk = s.readUp(65536)?
    if (len(chunk) == 0) {
      return out
    }
    // ponytail: O(N^2) over the chunk count (~80 for a 1 MB body = ~50 MB of
    // copies, negligible); a bulk byte-buffer append would make it O(N) but needs
    // a runtime primitive the stdlib does not yet have.
    out = out + chunk
  }
  return out
}

// ---------------------------------------------------------------------------
// Reading a message off a connection
// ---------------------------------------------------------------------------

// Reads a full HTTP message (headers, then a Content-Length body if any) from
// `s`. Returns the header block and body separately. An empty header block means
// the peer closed before sending a complete message.
function readMessage(s: byteStream): Request! {
  let buf = ""
  while (indexOf(buf, "\r\n\r\n") < 0) {
    let chunk = s.readUp(4096)?
    if (len(chunk) == 0) {
      // Peer closed mid-headers: return an empty request, the caller stops.
      return Request{ method: "", path: "", headers: "", body: "" }
    }
    buf = buf + chunk
  }
  let sep = indexOf(buf, "\r\n\r\n")
  let headBlock = buf[0:sep]
  let body = buf[sep + 4:len(buf)]

  // Split the request line off the top of the header block.
  let eol = indexOf(headBlock, "\r\n")
  let requestLine = headBlock
  let headers = ""
  if (eol >= 0) {
    requestLine = headBlock[0:eol]
    headers = headBlock[eol + 2:len(headBlock)]
  }
  let sp1 = indexOf(requestLine, " ")
  let method = ""
  let path = ""
  if (sp1 >= 0) {
    method = requestLine[0:sp1]
    let afterMethod = requestLine[sp1 + 1:len(requestLine)]
    let sp2 = indexOf(afterMethod, " ")
    if (sp2 >= 0) {
      path = afterMethod[0:sp2]
    } else {
      path = afterMethod
    }
  }

  // Read the rest of a declared body, if it did not all arrive with the headers.
  let cl = atoi(header(headers, "content-length"))
  while (cl > 0 && len(body) < cl) {
    let chunk = s.readUp(4096)?
    if (len(chunk) == 0) {
      break
    }
    body = body + chunk
  }
  return Request{ method: method, path: path, headers: headers, body: body }
}

// ---------------------------------------------------------------------------
// Server
// ---------------------------------------------------------------------------

// A listening HTTP server. Drive it with an `accept()` loop, spawning a green
// thread per exchange — a slow handler cannot delay the next accept.
export struct Server { listener: Listener }

// One accepted request and the connection to answer it on.
export struct Exchange { conn: Conn, request: Request }

// Bind and start listening for HTTP on `host:port`. `port` 0 lets the kernel
// choose one; read it back with `port()`.
export function serve(host: string, port: int): Server! {
  let l = listen(host, port)?
  return Server{ listener: l }
}

// The port the server is bound to.
export function (s: Server) port(): int! {
  return s.listener.port()?
}

// Accept the next connection and read its request. Parks until a client
// arrives; the returned `Exchange` carries the connection to respond on.
export function (s: Server) accept(): Exchange! {
  let c = s.listener.accept()?
  let req = readMessage(netStream{ conn: c })?
  return Exchange{ conn: c, request: req }
}

// Write `res` to the exchange's connection and close it (one request per
// connection in v1).
export function (e: Exchange) respond(res: Response): ()! {
  e.conn.write(serializeResponse(res))?
  e.conn.close()
}

export function (s: Server) close() {
  s.listener.close()
}

// Handle one exchange with `handler`, on the calling green thread. A write
// failure just drops the connection — there is no client left to tell.
function dispatch(ex: Exchange, handler: (Request) => Response) {
  ex.respond(handler(ex.request)) catch e {
    return
  }
}

// Serve HTTP on `host:port` forever, dispatching every request to `handler` on
// its own green thread — the idiomatic server. `handler` is an ordinary
// function value: `listenAndServe("127.0.0.1", 8080, route)`. Returns only on a
// bind or accept error. For a kernel-chosen port, or to serve a bounded number
// of requests, drive the `Server`/`accept`/`respond` API yourself instead.
export function listenAndServe(host: string, port: int, handler: (Request) => Response): ()! {
  let s = serve(host, port)?
  while (true) {
    let ex = s.accept()?
    spawn dispatch(ex, handler)
  }
}

// Read one request off `s`, answer it with `handler`, and close. On the calling
// green thread; a read or write failure just drops the connection. `altPort` is
// advertised in the response's Alt-Svc header (0 to advertise nothing).
function serveOne(s: byteStream, handler: (Request) => Response, altPort: int) {
  answer(s, handler, altPort) catch e {
    return
  }
}

function answer(s: byteStream, handler: (Request) => Response, altPort: int): ()! {
  let req = readMessage(s)?
  let res = handler(req)
  if (altPort > 0) {
    res.headers = res.headers + altSvcHeader(altPort)
  }
  s.writeStr(serializeResponse(res))?
  s.shut()
}

// Serve HTTPS on `host:port` forever with the certificate chain `certPem` and
// matching private key `keyPem` (both PEM), dispatching every request to
// `handler` on its own green thread — the TLS mirror of `listenAndServe`. ALPN
// offers `h2` then `http/1.1`, so a client that negotiates HTTP/2 is served over
// the `std/http2` engine and any other over HTTP/1.1; `handler` is the same either
// way. Every response also carries an `Alt-Svc: h3=":<port>"` header (RFC 7838)
// advertising an HTTP/3 endpoint on the same port number over UDP, so a client can
// discover it and upgrade a later request — pair `serveTls` with `serveH3` on the
// same `port`. Returns only on a bind, accept, or handshake error.
export function serveTls(
  host: string,
  port: int,
  certPem: string,
  keyPem: string,
  handler: (Request) => Response,
): ()! {
  let cfg = newTlsConfig(emptyTrustStore())
  cfg.certPem = certPem
  cfg.keyPem = keyPem
  cfg.alpn = ["h2", "http/1.1"]
  let l = tlsListen(host, port, cfg)?
  while (true) {
    // A per-connection failure (a bad or rejected TLS handshake — e.g. a client
    // whose ALPN offer shares nothing with ours, which RFC 7301 §3.2 makes us
    // abort) must drop THAT connection, never the listener: propagating it would
    // let one malformed client take down the whole server. This does not hot-spin
    // — the next iteration blocks in the TCP accept until a real connection
    // arrives. A genuinely dead listener socket is the one case this can't tell
    // apart; that is a fatal, rare condition, tracked separately.
    let conn = l.accept() catch e {
      continue
    }
    spawn serveTlsConn(conn, handler, port)
  }
}

// The Alt-Svc advertisement (RFC 7838) a TLS server appends to every response:
// HTTP/3 is reachable at the same port number, over UDP.
function altSvcHeader(port: int): string {
  return "Alt-Svc: h3=\":${itoa(port)}\"\r\n"
}

// Dispatch one accepted TLS connection to the HTTP/2 or HTTP/1.1 server path by
// its negotiated ALPN protocol. Runs on the spawned per-connection green thread.
// `altPort` is the HTTP/3 port advertised in each response's Alt-Svc header.
function serveTlsConn(conn: TlsConn, handler: (Request) => Response, altPort: int) {
  if (conn.alpnProtocol() == "h2") {
    h2glueServe(conn, handler, altPort)
    return
  }
  serveOne(tlsStream{ conn: conn }, handler, altPort)
}

// ---------------------------------------------------------------------------
// Client
// ---------------------------------------------------------------------------

// A parsed http://, https:// or https+h3:// URL. Port defaults to 80 (http) or
// 443 (https), path to "/". `https` selects the TLS transport; `h3` selects the
// HTTP/3 (QUIC) transport — an opt-in `https+h3://` scheme, never inferred.
struct Url { host: string, port: int, path: string, https: bool, h3: bool }

function parseUrl(url: string): Url! {
  let rest = url
  let https = false
  let h3 = false
  let port = 80
  let lower = toLower(rest)
  if (hasPrefix(lower, "https+h3://")) {
    https = true
    h3 = true
    port = 443
    rest = rest[11:len(rest)]
  } else if (hasPrefix(lower, "https://")) {
    https = true
    port = 443
    rest = rest[8:len(rest)]
  } else if (hasPrefix(lower, "http://")) {
    rest = rest[7:len(rest)]
  }
  // Split authority from path at the first '/'.
  let slash = indexOf(rest, "/")
  let authority = rest
  let path = "/"
  if (slash >= 0) {
    authority = rest[0:slash]
    path = rest[slash:len(rest)]
  }
  // Split host from an optional :port, which overrides the scheme default.
  let host = authority
  let colon = indexOf(authority, ":")
  if (colon >= 0) {
    host = authority[0:colon]
    let p = atoi(authority[colon + 1:len(authority)])
    if (p < 0) {
      fail newError("bad port in ${url}")
    }
    port = p
  }
  if (len(host) == 0) {
    fail newError("no host in ${url}")
  }
  return Url{ host: host, port: port, path: path, https: https, h3: h3 }
}

// Parse a response off a fully-read connection: status line, headers, body.
function parseResponse(raw: string): Response! {
  let sep = indexOf(raw, "\r\n\r\n")
  if (sep < 0) {
    fail newError("malformed response")
  }
  let headBlock = raw[0:sep]
  let body = raw[sep + 4:len(raw)]

  let eol = indexOf(headBlock, "\r\n")
  let statusLine = headBlock
  let headers = ""
  if (eol >= 0) {
    statusLine = headBlock[0:eol]
    headers = headBlock[eol + 2:len(headBlock)]
  }
  // "HTTP/1.1 200 OK" — the code is the token after the first space.
  let sp1 = indexOf(statusLine, " ")
  if (sp1 < 0) {
    fail newError("malformed status line")
  }
  let afterVer = statusLine[sp1 + 1:len(statusLine)]
  let sp2 = indexOf(afterVer, " ")
  let codeText = afterVer
  if (sp2 >= 0) {
    codeText = afterVer[0:sp2]
  }
  let code = atoi(codeText)
  if (code < 0) {
    fail newError("bad status code")
  }
  return Response{
    status: code,
    contentType: header(headers, "content-type"),
    headers: headers,
    body: body,
  }
}

// The HTTP/1.1 request text for `method u.path` with `body`, asking the server to
// close the connection so the whole response can be read to EOF.
function buildRequest(method: string, u: Url, body: string): string {
  let req = "${method} ${u.path} HTTP/1.1\r\n"
  req = req + "Host: ${u.host}\r\n"
  req = req + "Connection: close\r\n"
  if (len(body) > 0) {
    req = req + "Content-Length: ${itoa(len(body))}\r\n"
  }
  return req + "\r\n" + body
}

// Send `reqText` over `s`, read the whole response to EOF, close, and parse it.
function exchangeOn(s: byteStream, reqText: string): Response! {
  s.writeStr(reqText)?
  let raw = readAllStream(s)?
  s.shut()
  return parseResponse(raw)?
}

// Default trust anchors for verifying servers: the operating-system store when
// available, else the small bundled root set. Rewrapped as a std/tls trust store
// — both stores hold the same parsed X.509 roots, so no PEM round-trip is needed.
function defaultRoots(): TlsTrustStore {
  let sys = systemRoots() catch e {
    return TlsTrustStore{ roots: bundled().roots }
  }
  return TlsTrustStore{ roots: sys.roots }
}

// A secure-by-default client TLS config: verification on, default roots, ALPN
// `h2` then `http/1.1` (so the server may pick HTTP/2). SNI defaults to the
// request host inside `tls.dial`.
function defaultClientConfig(): TlsConfig {
  let cfg = newTlsConfig(defaultRoots())
  cfg.alpn = ["h2", "http/1.1"]
  return cfg
}

// Send `method url` with an optional body and return the response. An `https://`
// URL runs over TLS 1.3, verifying the server against the system/bundled roots;
// if ALPN negotiates `h2` the exchange runs over the `std/http2` engine, else over
// HTTP/1.1. An `http://` URL runs over cleartext TCP (HTTP/1.1). The server is
// asked to close the connection, so the whole HTTP/1.1 response is read to EOF.
// For a custom TLS config (pinned roots, a fixed `serverName`,
// `insecureSkipVerify`), use `requestTls`.
export function request(method: string, url: string, body: string): Response! {
  let u = parseUrl(url)?
  if (u.h3) {
    return h3Exchange(u, method, body)?
  }
  if (u.https) {
    return httpsExchange(tlsDial(u.host, u.port, defaultClientConfig())?, method, u, body)?
  }
  return exchangeOn(netStream{ conn: dial(u.host, u.port)? }, buildRequest(method, u, body))?
}

// As `request`, but over https with an explicit TLS `config` (custom roots, a
// pinned `serverName`, `insecureSkipVerify` for tests). Fails if `url` is not
// https. `config.alpn` defaults to `h2` then `http/1.1` when empty; the negotiated
// protocol selects the HTTP/2 engine or the HTTP/1.1 path.
export function requestTls(
  method: string,
  url: string,
  body: string,
  config: TlsConfig,
): Response! {
  let u = parseUrl(url)?
  if (!u.https) {
    fail newError("requestTls: ${url} is not an https URL")
  }
  let cfg = config
  if (len(cfg.alpn) == 0) {
    cfg.alpn = ["h2", "http/1.1"]
  }
  return httpsExchange(tlsDial(u.host, u.port, cfg)?, method, u, body)?
}

// GET `url` (http or https).
export function get(url: string): Response! {
  return request("GET", url, "")?
}

// POST `body` to `url` (http or https).
export function post(url: string, body: string): Response! {
  return request("POST", url, body)?
}

// GET an https `url` with an explicit TLS `config`.
export function getTls(url: string, config: TlsConfig): Response! {
  return requestTls("GET", url, "", config)?
}

// POST `body` to an https `url` with an explicit TLS `config`.
export function postTls(url: string, body: string, config: TlsConfig): Response! {
  return requestTls("POST", url, body, config)?
}

// ---------------------------------------------------------------------------
// HTTP/2 over ALPN
// ---------------------------------------------------------------------------
//
// When a TLS handshake negotiates ALPN `h2`, the exchange runs over the
// `std/http2` connection engine instead of the HTTP/1.1 wire path. That engine
// drives its own reader/writer/loop green threads over an abstract byte
// `Transport`; `h2glueTransport` adapts a `TlsConn` to it. This is safe without a
// lock because TLS 1.3 keeps separate read (`appRead`) and write (`appWrite`)
// record state, so the engine's concurrent reader and writer touch disjoint halves
// of the connection. Requests and responses cross the http<->http2 boundary
// through the `h2glue*` mappers: the `:method`/`:scheme`/`:authority`/`:path` and
// `:status` pseudo-headers become the `Request`/`Response` fields, and the
// remaining fields become the raw header block this module carries. Every helper
// here is prefixed `h2glue`.

// Run `method u.path` with `body` over an established `TlsConn`, using the HTTP/2
// engine when ALPN negotiated `h2` and the HTTP/1.1 wire path otherwise.
function httpsExchange(conn: TlsConn, method: string, u: Url, body: string): Response! {
  if (conn.alpnProtocol() == "h2") {
    return h2clientExchange(conn, method, u, body)?
  }
  return exchangeOn(tlsStream{ conn: conn }, buildRequest(method, u, body))?
}

// Adapt a `TlsConn` to the http2 engine's byte `Transport`. The engine's `read`
// is not fallible — a read error is end-of-stream — so the shim maps any TLS read
// failure to an empty slice, which the engine treats as a clean close.
function h2glueTransport(conn: TlsConn): H2Transport {
  return h2newTransport(
    (n) => {
      let b = conn.read(n) catch e {
        return []byte(0)
      }
      return b
    },
    (b) => {
      h2glueWrite(conn, b)
    },
    () => {
      conn.close()
    },
  )
}

// Best-effort transport write for the http2 engine. A socket write failure is
// swallowed: the engine's reader observes the same closed transport and winds the
// connection down, and the writer thread is fire-and-forget, so propagating the
// error adds nothing. A named helper because an arrow closure cannot be fallible.
function h2glueWrite(conn: TlsConn, b: []byte) {
  conn.write(b) catch e {
    return
  }
}

// Run one request/response over the HTTP/2 engine on an h2-negotiated `TlsConn`,
// then tear the connection down (this module is one request per connection). A
// setup or round-trip failure closes the socket and propagates.
function h2clientExchange(conn: TlsConn, method: string, u: Url, body: string): Response! {
  let hc = h2connect(h2glueTransport(conn), h2defaultConfig()) catch e {
    conn.close()
    fail e
  }
  let res = hc.roundTrip(h2glueRequestOf(method, u, body)) catch e {
    conn.close()
    fail e
  }
  conn.close()
  return h2glueResponse(res)
}

// Serve one h2-negotiated connection: run the http2 server engine and dispatch
// each stream to the transport-agnostic `handler`, mapping the http2 request and
// response to this module's types on the way in and out. Each response advertises
// the HTTP/3 endpoint on `altPort` via an Alt-Svc header.
function h2glueServe(conn: TlsConn, handler: (Request) => Response, altPort: int) {
  let hc = h2accept(h2glueTransport(conn), h2defaultConfig()) catch e {
    conn.close()
    return
  }
  hc.serve((r) => h2glueResponseOutAlt(handler(h2glueRequestIn(r)), altPort)) catch e2 {
    return
  }
}

// Map this module's `Response` to an http2 response, first appending the Alt-Svc
// advertisement (when `altPort > 0`) so an HTTP/2 client learns the h3 endpoint.
function h2glueResponseOutAlt(res: Response, altPort: int): H2Response {
  let out = res
  if (altPort > 0) {
    out.headers = out.headers + altSvcHeader(altPort)
  }
  return h2glueResponseOut(out)
}

// The HTTP/2 `:authority`: the host, with the port appended only when it is not
// the https default (443), matching how a client forms the pseudo-header.
function h2glueAuthority(u: Url): string {
  if (u.port == 443) {
    return u.host
  }
  return "${u.host}:${itoa(u.port)}"
}

// Build an http2 request for `method u.path` with `body` over scheme https.
function h2glueRequestOf(method: string, u: Url, body: string): H2Request {
  return H2Request{
    method: method,
    scheme: "https",
    authority: h2glueAuthority(u),
    path: u.path,
    headers: []H2HeaderField(0),
    body: []byte(body),
  }
}

// Whether a lower-case header `name` is a connection-specific field forbidden on
// an HTTP/2 stream (RFC 9113 §8.2.2). Content-Length is dropped too — the engine
// frames the body, so an explicit length is redundant.
function h2glueHopByHop(name: string): bool {
  return name == "connection" || name == "keep-alive" || name == "proxy-connection" || name == "transfer-encoding" || name == "upgrade" || name == "content-length"
}

// Serialize an http2 header-field list into this module's raw "Name: value\r\n"
// block, so `header()` reads it exactly as an HTTP/1.1 block.
function h2glueBlock(fields: []H2HeaderField): string {
  let block = ""
  for f of fields {
    block = block + "${f.name}: ${f.value}\r\n"
  }
  return block
}

// Parse a raw "Name: value\r\n" block into http2 header fields, lower-casing each
// name (HTTP/2 requires it) and dropping connection-specific headers. Appends to
// `dst`. Bounded: each turn consumes at least one line from `rest`.
function h2glueFields(dst: []H2HeaderField, block: string): []H2HeaderField {
  let out = dst
  let rest = block
  while (len(rest) > 0) {
    let eol = indexOf(rest, "\r\n")
    let line = rest
    if (eol >= 0) {
      line = rest[0:eol]
      rest = rest[eol + 2:len(rest)]
    } else {
      rest = ""
    }
    let colon = indexOf(line, ":")
    if (colon < 0) {
      continue
    }
    let name = toLower(trimSpace(line[0:colon]))
    if (len(name) == 0 || h2glueHopByHop(name)) {
      continue
    }
    out = append(
      out,
      H2HeaderField{ name: name, value: trimSpace(line[colon + 1:len(line)]), sensitive: false },
    )
  }
  return out
}

// Map an http2 response to this module's `Response`: `:status` is the status, the
// remaining fields become the raw header block, and Content-Type is read from it
// just as on the HTTP/1.1 path.
function h2glueResponse(res: H2Response): Response {
  let block = h2glueBlock(res.headers)
  return Response{
    status: res.status,
    contentType: header(block, "content-type"),
    headers: block,
    body: string(res.body),
  }
}

// Map an http2 request to this module's `Request`, flattening the header fields to
// a raw header block.
function h2glueRequestIn(req: H2Request): Request {
  return Request{
    method: req.method,
    path: req.path,
    headers: h2glueBlock(req.headers),
    body: string(req.body),
  }
}

// Map this module's `Response` to an http2 response: Content-Type becomes a header
// field, the raw header block is parsed into fields, and the body carries over.
// The engine adds `:status` and frames the body itself.
function h2glueResponseOut(res: Response): H2Response {
  let fields = []H2HeaderField(0)
  if (len(res.contentType) > 0) {
    fields = append(
      fields,
      H2HeaderField{ name: "content-type", value: res.contentType, sensitive: false },
    )
  }
  fields = h2glueFields(fields, res.headers)
  return H2Response{ status: res.status, headers: fields, body: []byte(res.body) }
}

// ---------------------------------------------------------------------------
// HTTP/3 over QUIC
// ---------------------------------------------------------------------------
//
// HTTP/3 (RFC 9114) runs over QUIC (UDP), not TLS-over-TCP, so it is opt-in: a
// server binds a UDP socket with `serveH3`, and a client reaches it either with an
// explicit `https+h3://` URL or by upgrading after reading an `Alt-Svc` header a
// TLS server advertised. The `std/http3` engine does the QUIC streams, QPACK, and
// framing; this module maps between its `H3Request`/`H3Response` (pseudo-headers +
// a `[]HeaderField` list) and the transport-agnostic `Request`/`Response`, exactly
// as the `h2glue*` helpers do for HTTP/2. Every helper here is prefixed `h3glue`.
//
// The QUIC transport demultiplexes many client connections on one socket, so
// `serveH3` runs an accept loop and serves each connection on its own green
// thread; run the call itself on its own green thread. The h3 client is still one
// request per connection, matching the rest of this module.

// Connection-specific header fields forbidden on an HTTP/3 message (RFC 9114
// §4.2), plus Content-Length (the framing supplies the body length).
function h3glueHopByHop(name: string): bool {
  return name == "connection" || name == "keep-alive" || name == "proxy-connection" || name == "transfer-encoding" || name == "upgrade" || name == "content-length"
}

// Serialize an h3 header-field list into this module's raw "Name: value\r\n" block.
function h3glueBlock(fields: []HeaderField): string {
  let block = ""
  for f of fields {
    block = block + "${f.name}: ${f.value}\r\n"
  }
  return block
}

// Parse a raw "Name: value\r\n" block into h3 header fields, lower-casing each name
// (HTTP/3 requires it) and dropping connection-specific headers. Appends to `dst`.
// Bounded: each turn consumes at least one line from `rest`.
function h3glueFields(dst: []HeaderField, block: string): []HeaderField {
  let out = dst
  let rest = block
  while (len(rest) > 0) {
    let eol = indexOf(rest, "\r\n")
    let line = rest
    if (eol >= 0) {
      line = rest[0:eol]
      rest = rest[eol + 2:len(rest)]
    } else {
      rest = ""
    }
    let colon = indexOf(line, ":")
    if (colon < 0) {
      continue
    }
    let name = toLower(trimSpace(line[0:colon]))
    if (len(name) == 0 || h3glueHopByHop(name)) {
      continue
    }
    out = append(
      out,
      HeaderField{ name: name, value: trimSpace(line[colon + 1:len(line)]), sensitive: false },
    )
  }
  return out
}

// Build an h3 request for `method u.path` with `body` over scheme https.
function h3glueRequestOf(method: string, u: Url, body: string): H3Request {
  return H3Request{
    method: method,
    scheme: "https",
    authority: h2glueAuthority(u),
    path: u.path,
    headers: []HeaderField(0),
    body: []byte(body),
  }
}

// Map an h3 response to this module's `Response`: `:status` is the status, the
// remaining fields become the raw header block, Content-Type is read from it.
function h3glueResponse(res: H3Response): Response {
  let block = h3glueBlock(res.headers)
  return Response{
    status: res.status,
    contentType: header(block, "content-type"),
    headers: block,
    body: string(res.body),
  }
}

// Map an h3 request to this module's `Request`, flattening the header fields.
function h3glueRequestIn(req: H3Request): Request {
  return Request{
    method: req.method,
    path: req.path,
    headers: h3glueBlock(req.headers),
    body: string(req.body),
  }
}

// Map this module's `Response` to an h3 response: Content-Type becomes a header
// field, the raw header block is parsed into fields, and the body carries over.
function h3glueResponseOut(res: Response): H3Response {
  let fields = []HeaderField(0)
  if (len(res.contentType) > 0) {
    fields = append(
      fields,
      HeaderField{ name: "content-type", value: res.contentType, sensitive: false },
    )
  }
  fields = h3glueFields(fields, res.headers)
  return H3Response{ status: res.status, headers: fields, body: []byte(res.body) }
}

// Run one request/response over HTTP/3: dial QUIC at `u.host:u.port`, send the
// request on a fresh stream, read the response, and close the connection (one
// request per connection, as elsewhere in this module).
function h3Exchange(u: Url, method: string, body: string): Response! {
  let conn = h3Dial(u.host, u.port, u.host)?
  let res = conn.request(h3glueRequestOf(method, u, body)) catch e {
    conn.close()
    fail e
  }
  conn.close()
  return h3glueResponse(res)
}

// Serve one accepted HTTP/3 connection: accept each request, dispatch it through
// the transport-agnostic `handler`, and answer on the same stream. Bounded so the
// loop is provably finite; returns (closing the connection) when the peer stops.
function serveH3Conn(conn: H3Conn, handler: (Request) => Response) {
  let guard = 0
  while (guard < 1048576) {
    guard = guard + 1
    let sr = conn.accept() catch e {
      conn.close()
      return
    }
    conn.respond(sr, h3glueResponseOut(handler(h3glueRequestIn(sr.req)))) catch e2 {
      conn.close()
      return
    }
  }
  conn.close()
}

// Serve HTTP/3 on `host:port` (UDP) with the certificate chain `certPem` and
// matching private key `keyPem` (both PEM), dispatching every request to the same
// `(Request) => Response` handler `serve`/`serveTls` use. The QUIC listener
// demultiplexes many client connections on the one socket; each accepted
// connection is served on its own green thread. Runs an accept loop (bounded, so
// provably finite) until the socket closes; run the call itself on its own green
// thread. Advertise it from a `serveTls` server on the same port (its Alt-Svc
// header) so `https://` clients can discover and upgrade to it.
export function serveH3(
  host: string,
  port: int,
  certPem: string,
  keyPem: string,
  handler: (Request) => Response,
): ()! {
  let sock = udpBind(host, port)?
  let lst = h3Listen(sock, certPem, keyPem)?
  let guard = 0
  while (guard < 1048576) {
    guard = guard + 1
    let conn = lst.accept() catch e {
      return
    }
    spawn serveH3Conn(conn, handler)
  }
}

// ---------------------------------------------------------------------------
// HTTP/3 client with Alt-Svc discovery
// ---------------------------------------------------------------------------
//
// A `Client` holds the two pieces of state a self-upgrading client needs, so no
// module-global mutable state is required: the TLS config for its `https://` leg,
// and an Alt-Svc cache mapping an authority (`host:port`) to the HTTP/3 UDP port a
// server advertised. The cache is a `map` (a reference type), so a method updates
// the same table the caller's `Client` holds. Hold one `Client` across requests to
// let a later request to a known authority upgrade to HTTP/3 automatically.

// The h3 port advertised for the `h3=` alternative in an Alt-Svc header value
// (RFC 7838), or -1 if there is none. Accepts `h3=":443"` and `h3="host:443"` —
// the port is the digits after the last colon inside the quoted authority.
function parseAltSvcH3Port(av: string): int {
  let at = indexOf(av, "h3=")
  if (at < 0) {
    return 0 - 1
  }
  let rest = av[at + 3:len(av)]
  if (len(rest) > 0 && rest[0] == '"') {
    rest = rest[1:len(rest)]
  }
  let q = indexOf(rest, "\"")
  let val = rest
  if (q >= 0) {
    val = rest[0:q]
  }
  let colon = 0 - 1
  let i = 0
  while (i < len(val)) {
    if (val[i] == ':') {
      colon = i
    }
    i = i + 1
  }
  if (colon < 0) {
    return 0 - 1
  }
  return atoi(val[colon + 1:len(val)])
}

// An HTTP client that remembers the HTTP/3 endpoints servers advertise via
// Alt-Svc, so a later request to the same authority upgrades to HTTP/3. It has no
// global state: hold one across requests to reuse its cache.
export struct Client { tls: TlsConfig, h3Ports: map<string, int> }

// A `Client` with secure-by-default TLS (verification on, system/bundled roots,
// ALPN `h2` then `http/1.1`) and an empty Alt-Svc cache.
export function newClient(): Client {
  return Client{ tls: defaultClientConfig(), h3Ports: map<string, int>() }
}

// A `Client` with an explicit `std/tls` config for its `https://` leg (pinned
// roots, a fixed `serverName`, `insecureSkipVerify`) and an empty Alt-Svc cache.
export function newClientTls(config: TlsConfig): Client {
  return Client{ tls: config, h3Ports: map<string, int>() }
}

// Record any `h3=` Alt-Svc advertisement `res` carried for `authority`.
function (c: Client) learnAltSvc(authority: string, res: Response) {
  let av = header(res.headers, "alt-svc")
  if (len(av) == 0) {
    return
  }
  let p = parseAltSvcH3Port(av)
  if (p > 0) {
    c.h3Ports[authority] = p
  }
}

// Send `method url` with an optional body. An `https+h3://` URL always uses
// HTTP/3. An `https://` URL upgrades to HTTP/3 when this client has cached an
// Alt-Svc endpoint for the authority from an earlier response; otherwise it runs
// over TLS (HTTP/2 or HTTP/1.1 by ALPN) and learns any Alt-Svc the response
// advertises. An `http://` URL runs over cleartext HTTP/1.1.
export function (c: Client) request(method: string, url: string, body: string): Response! {
  let u = parseUrl(url)?
  if (u.h3) {
    return h3Exchange(u, method, body)?
  }
  if (!u.https) {
    return request(method, url, body)?
  }
  let key = h2glueAuthority(u)
  let cached = c.h3Ports[key]
  if (cached != 0) {
    let hu = Url{ host: u.host, port: cached, path: u.path, https: true, h3: true }
    return h3Exchange(hu, method, body)?
  }
  let res = requestTls(method, url, body, c.tls)?
  c.learnAltSvc(key, res)
  return res
}

// GET `url` through this client (HTTP/3 when discovered, else TLS or cleartext).
export function (c: Client) get(url: string): Response! {
  return c.request("GET", url, "")?
}

// POST `body` to `url` through this client.
export function (c: Client) post(url: string, body: string): Response! {
  return c.request("POST", url, body)?
}
