// Bit standard library — http module: request-target and query-string
// helpers (#2177). Split out of client.bit (#2448) to keep that file under
// the 800-line lint limit; `stdlib/http` is one flat module, so this file
// shares client.bit's own imports and namespace.

// `split` backs `parseQuery`'s pair-splitting, below. `indexOf`/`hasPrefix`/
// `toLower`/`atoi` are already imported into this module's scope by
// http.bit — importing any of them again here would be an `E0042` duplicate
// declaration, since an import is per-module, not per-file.
import { split } from "std/strings"

// ---------------------------------------------------------------------------
// Query string parsing and percent-encoding (#2177)
// ---------------------------------------------------------------------------
//
// `Request.path` (stdlib/http/http.bit) is the raw request target straight off
// the wire — query string attached, still percent-encoded — and stays that way
// for compatibility. These four exports are the parsing every handler and
// every client otherwise hand-rolls: split the target, split and decode the
// query, and (for a client building one) escape a value going in.

// Splits an HTTP request target at its first `?` into `(path, rawQuery)`.
// A target with no `?` returns the whole target as the path and `""` as the
// query. Neither half is percent-decoded here — see `parseQuery` for why.
export fn splitTarget(target: string): (string, string) {
  let q = indexOf(target, "?")
  if (q < 0) {
    return target, ""
  }
  return target[0:q], target[q + 1:len(target)]
}

// Parses a raw (still percent-encoded) query string, as returned by
// `splitTarget`, into decoded key -> decoded value. Pairs are split on `&`,
// each pair on its first `=` (a pair with no `=` maps to `""`); percent-
// decoding (which also turns `+` into a space) runs only on the already-split
// pieces, never on `raw` as a whole — decoding first would let an encoded `&`
// or `=` inside a value masquerade as a real separator. A duplicate key is
// last-wins: `parseQuery("limit=1&limit=999")` yields `"999"`, the policy
// most frameworks use.
export fn parseQuery(raw: string): map<string, string> {
  let out = map<string, string>()
  if (len(raw) == 0) {
    return out
  }
  let pairs = split(raw, "&")
  let i = 0
  while (i < len(pairs)) {
    let pair = pairs[i]
    if (len(pair) > 0) {
      let eq = indexOf(pair, "=")
      let rawKey = pair
      let rawValue = ""
      if (eq >= 0) {
        rawKey = pair[0:eq]
        rawValue = pair[eq + 1:len(pair)]
      }
      out[percentDecode(rawKey)] = percentDecode(rawValue)
    }
    i = i + 1
  }
  return out
}

// The value of hex digit `c`, 0..15, or -1 if `c` is not `[0-9a-fA-F]`. Unlike
// `std/crypto`'s `decodeHex` nibble, this never fails: a malformed
// percent-escape must decode as literal text, not reject the whole request.
fn queryHexDigit(c: byte): int {
  if (c >= '0' && c <= '9') {
    return int(c - '0')
  }
  if (c >= 'a' && c <= 'f') {
    return int(c - 'a') + 10
  }
  if (c >= 'A' && c <= 'F') {
    return int(c - 'A') + 10
  }
  return 0 - 1
}

// Percent-decodes `s`: `%XX` becomes the byte `0xXX`, `+` becomes a space, and
// every other byte passes through unchanged. A malformed escape — a `%` not
// followed by two hex digits, including one cut short at the end of `s` — is
// left exactly as it appears in the input rather than failing the request,
// the same leniency mainstream HTTP servers apply.
export fn percentDecode(s: string): string {
  let out = []byte(0)
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == '%' && i + 2 < len(s)) {
      let hi = queryHexDigit(s[i + 1])
      let lo = queryHexDigit(s[i + 2])
      if (hi >= 0 && lo >= 0) {
        out = append(out, byte(hi * 16 + lo))
        i = i + 3
      } else {
        out = append(out, c)
        i = i + 1
      }
    } else if (c == '+') {
      out = append(out, ' ')
      i = i + 1
    } else {
      out = append(out, c)
      i = i + 1
    }
  }
  return string(out)
}

const queryHexUpper: string = "0123456789ABCDEF"

// True for the RFC 3986 unreserved set (`A-Z a-z 0-9 - . _ ~`) — the only
// bytes `percentEncode` leaves unescaped.
fn isUnreservedQueryByte(c: byte): bool {
  if (c >= 'A' && c <= 'Z') {
    return true
  }
  if (c >= 'a' && c <= 'z') {
    return true
  }
  if (c >= '0' && c <= '9') {
    return true
  }
  return c == '-' || c == '.' || c == '_' || c == '~'
}

// Percent-encodes every byte of `s` other than the RFC 3986 unreserved set as
// `%XX`, uppercase hex, high nibble first — the exact inverse of
// `percentDecode` for every byte 0-255, including a space (always emitted as
// `%20`, never `+`, so `percentDecode` never has to guess whether a literal
// `+` in the input was meant literally). This closes the gap that let a
// caller building `?q=${value}` corrupt the request line with an unescaped
// separator: encode any interpolated value with this first.
export fn percentEncode(s: string): string {
  let out = []byte(0)
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (isUnreservedQueryByte(c)) {
      out = append(out, c)
    } else {
      out = append(out, '%')
      out = append(out, queryHexUpper[int(c >> 4)])
      out = append(out, queryHexUpper[int(c & 0x0f)])
    }
    i = i + 1
  }
  return string(out)
}
