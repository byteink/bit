// Bit standard library — http module: the error a client request fails with once
// it reached the network layer (#7305).
//
// A caller that retries has to know whether the server may already have acted
// on the request. RFC 9110 §9.2.2 forbids repeating a non-idempotent request
// unless the client knows it was not processed, and Go's net/http draws the same
// line: it replays only a request it never wrote. `RequestError.sent` is that
// fact. It is set once a write of the request to the connection was started, so
// it is conservative: `true` can mean the bytes were only partly written, never
// that nothing was.
//
// A failure before the network layer (an unparsable URL, a header that cannot be
// sent) is a plain error and nothing was sent. `Client.send` with `stream = true`
// reports its failures as before, with `TimeoutError` for a timeout.

// Why a request failed, and whether any of it was sent.
//
//   sent   true once the client began writing the request on the connection (or
//          an HTTP/2 or HTTP/3 stream), so the server may have processed it. A
//          refused or timed-out connect, a failed TLS handshake and a wait for a
//          free connection that ran out are `false`: the request never left.
//          After a followed redirect it is `true` whatever the failing hop,
//          because an earlier hop was sent.
//   cause  the error underneath: a `std/net` or `std/tls` error, a `HandshakeError`
//          for a handshake that failed, a framing error from the response. Its
//          text is this error's `message()`.
export class RequestError {
  export sent: bool
  export cause: error

  export message(): string {
    return this.cause.message()
  }
}

// `e` as a failure that happened before any byte of the request was written.
fn unsentError(e: error): error {
  return RequestError{ sent = false, cause = e }
}

// `e` as a failure that happened once the request was being written or after.
fn sentError(e: error): error {
  return RequestError{ sent = true, cause = e }
}

// `e` as the failure of a request an earlier redirect hop already sent: the
// error of the hop with `sent` forced on.
fn afterSent(e: error): error {
  let (r, ok) = e.(RequestError)
  if (ok) {
    return sentError(r.cause)
  }
  return sentError(e)
}
