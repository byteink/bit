// stdlib/http/streambody.bit — bounded-memory request and response bodies
// for the http/https client, split into its own file rather than grown into
// client.bit (703 lines already; spec/LINT.md's 800-line ceiling is never
// raised) — the same precedent transport.bit's split from http.bit (#5860)
// set. `readResponse`, `buildRequest`, `hostHeaderValue`,
// `readContentLengthBody`, `decodeChunkedBody`, `readAllStream`, `header`,
// `RequestExtras`, `defaultRoots`, `defaultMaxBodyBytes`, `Url`, `parseUrl`,
// `Header`, `serializeHeaders`, `netStream`, `tlsStream`, `tlsDial`, `dial`,
// `TlsConfig`, `atoi`, `itoa` and `newError` are all siblings or
// module-wide imports (SPEC §19) already brought in by client.bit/http.bit —
// nothing is imported here.
//
// #4027/#6078 (pkg/s3): `requestWith`'s `body: string` parameter and
// `Response.body: string` field both require the WHOLE payload resident at
// once — fine for a JSON API call, wrong for a multi-hundred-MB object
// PUT/GET (pkg/s3's own `put`/`get` are its callers). The two entry points
// below move a body in bounded chunks instead: memory use is O(chunk size),
// never O(body size), on either side of the wire.
//
// PUT (`requestWithStreamingBody`, #6575): one call, one typed `StreamBody`.
// A body with a declared length (`StreamBody.length = Option.Some(n)`) sends
// `Content-Length: n` — SigV4 needs the count up front anyway, and a known
// length always wins over chunked. A body without one goes out
// `Transfer-Encoding: chunked` (RFC 9112 section 7.1), followed by an optional
// trailer section (RFC 9112 section 7.1.2, RFC 9110 section 6.5) the caller
// computes AFTER the last body byte has gone out — a checksum over the
// streamed bytes, as `aws-chunked` trailer checksums need. Chunked is sent
// by default, as Go's net/http, curl and undici do for an unknown length:
// RFC 9112 section 6.1 lets a client's knowledge that the server speaks
// HTTP/1.1 come from configuration or a prior response, and every connection
// here is a fresh one-shot dial with no pool recording an earlier response's
// version, so there is nothing to refuse on — a server that answers HTTP/1.0
// to a chunked request is the server's own non-conformance. Trailers need
// chunked framing, so a declared length with trailers is refused before
// anything is dialed. Per-chunk `aws-chunked` SIGNING (a chunk-extension
// protocol AWS layers on top) is not implemented.
//
// GET (`getStreaming`): delivers the response body to a `BodySink` one
// bounded chunk at a time instead of accumulating a `string`, for the
// Content-Length framing every S3-compatible GET response actually uses
// (verified: AWS S3, MinIO, Cloudflare R2 and Google Cloud Storage's XML API
// all answer a GET with a Content-Length header, never chunked
// Transfer-Encoding — the object's byte count is always known before the
// response starts). A response framed by chunked encoding or read-to-EOF
// instead (never observed from a real S3-compatible server, but a
// spec-legal HTTP/1.1 response) still succeeds, bounded by `maxBodyBytes`
// exactly as `readResponse` already bounds it, but is handed to `sink` as
// one whole chunk rather than streamed piece by piece.
//
// Both entry points force TLS ALPN to `http/1.1` only, never negotiating
// `h2` (`defaultClientConfig`'s `["h2", "http/1.1"]` list is not reused
// here): the HTTP/2 engine (`std/http2`) has its own DATA-frame body
// mechanism, and building a second streaming path through it is out of
// scope for this ticket — every S3-compatible endpoint serves HTTP/1.1 (or
// negotiates it when a client offers only that), so this is a real
// restriction with no observed cost.

// Pulls up to `n` bytes of a request body; "" only at true end of input, and
// any other return may be shorter than `n`. `writeStreamingBody` below calls
// this repeatedly until it returns "".
export type BodySource = (int) => string!

// Receives one chunk of a response body, in arrival order, called repeatedly
// until the body is exhausted.
export type BodySink = (string) => ()!

// How many bytes `writeStreamingBody`/`readContentLengthBodyStreaming` move
// per call to `source`/`sink` — matches `readChunkSize` (stdlib/io/io.bit)
// and the 4096 `readContentLengthBody`/`decodeChunkedBody` (message.bit)
// already use, so a streaming body advances the same amount of work per step
// as every other body reader in this module.
const streamChunkSize: int = 4096

// Writes `contentLength` bytes pulled from `source` directly onto `s`, one
// bounded chunk at a time — never concatenated into one `string` first.
// Fails if `source` runs out before `contentLength` bytes are written, or
// hands back more than it was asked for (a caller whose source disagrees
// with its own declared length is a caller bug, not a framing the peer
// should ever see on the wire).
fn writeStreamingBody(s: byteStream, contentLength: int, source: BodySource): ()! {
  let written = 0
  while (written < contentLength) {
    let want = contentLength - written
    if (want > streamChunkSize) {
      want = streamChunkSize
    }
    let chunk = source(want)?
    if (len(chunk) == 0) {
      fail newError("writeStreamingBody: source exhausted after ${itoa(written)} of ${itoa(contentLength)} bytes")
    }
    if (len(chunk) > want) {
      fail newError("writeStreamingBody: source returned ${itoa(len(chunk))} bytes, ${itoa(want)} requested")
    }
    s.writeStr(chunk)?
    written = written + len(chunk)
  }
}

// As `buildRequest` (client.bit), but ending after the header block — no
// body appended — with `framing` (a complete "Name: value\r\n" line:
// Content-Length for a declared length, Transfer-Encoding for chunked) in
// place of a framing derived from a body already in hand.
fn buildStreamingRequestHead(
  method: string,
  u: Url,
  headerBlock: string,
  framing: string,
): string {
  let req = "${method} ${u.path} HTTP/1.1\r\n"
  req = req + "Host: ${hostHeaderValue(u)}\r\n"
  req = req + "Connection: close\r\n"
  req = req + headerBlock
  req = req + framing
  return req + "\r\n"
}

// The http/1.1-only TLS config every function in this file dials with — see
// the file header for why `h2` is never offered here.
fn streamingTlsConfig(): TlsConfig {
  let cfg = TlsConfig(defaultRoots())
  cfg.alpn = ["http/1.1"]
  return cfg
}

// Pulls trailer fields once the request body is complete (RFC 9112 section
// 7.1.2): called by `requestWithStreamingBody` exactly once, after `source` has
// returned "", so a value computed over the streamed bytes (a checksum, a
// byte count) is final. Omit `StreamBody.trailers` for no trailer section.
export type TrailerSource = () => []Header!

// The request body `requestWithStreamingBody` sends: the `source` pulled until
// it returns "", how long it is, and the trailer fields that follow it.
//
//   - `length = Option.Some(n)`: exactly `n` bytes, framed by `Content-Length`.
//   - `length` omitted (`Option.None`): unknown length, framed
//     `Transfer-Encoding: chunked`, and `trailers`, when set, are sent after
//     the last chunk.
//
// `trailers` with a `length` is refused: a Content-Length message has no
// trailer section.
export class StreamBody {
  export source: BodySource,
  export length: Option<int>,
  export trailers: Option<TrailerSource>,
}

// The widest size line a chunk of at most `streamChunkSize` bytes needs
// ("1000\r\n"), reserved ahead of the data in `chunkFrame.buf` so the size
// line is written in front of bytes already in place instead of the bytes
// being shifted or concatenated behind it.
const chunkPrefix: int = 6

// size line + data + the CRLF that closes the chunk.
const chunkFrameCap: int = chunkPrefix + streamChunkSize + 2

// Header fields RFC 9110 section 6.5.1 forbids in a trailer section: framing,
// routing, request modifiers (controls, conditionals), authentication,
// response control data, payload processing, and the connection-specific
// fields of section 7.6.1.
fn forbiddenTrailerNames(): []string {
  return [
    "transfer-encoding", "content-length", "host", "trailer", "connection",
    "keep-alive", "upgrade", "proxy-connection", "te", "content-encoding",
    "content-type", "content-range", "authorization", "proxy-authorization",
    "proxy-authenticate", "www-authenticate", "cookie", "set-cookie",
    "cache-control", "expect", "max-forwards", "pragma", "range", "if-match",
    "if-none-match", "if-modified-since", "if-unmodified-since", "if-range",
    "age", "expires", "date", "location", "retry-after", "vary", "warning",
  ]
}

// The "Name: value\r\n" block for `fields`, failing on a malformed name or
// value (`serializeHeaders`) or on a field a trailer section may not carry.
fn serializeTrailers(fields: []Header): string! {
  let block = serializeHeaders(fields)?
  let banned = forbiddenTrailerNames()
  for h of fields {
    let name = toLower(h.name)
    for b of banned {
      if (name == b) {
        fail newError("trailer \"${h.name}\" is not allowed in a trailer section (RFC 9110 section 6.5.1)")
      }
    }
  }
  return block
}

// The count of hex digits of `n` >= 0 (1 for 0).
fn hexDigits(n: int): int {
  let d = 1
  let v = n >> 4
  while (v > 0) {
    d = d + 1
    v = v >> 4
  }
  return d
}

// The lowercase hex digit of `nib` in 0..15.
fn hexDigit(nib: int): u8 {
  if (nib < 10) {
    return u8(48 + nib)
  }
  return u8(87 + nib)
}

// One reusable buffer holding the next chunk frame: `chunkPrefix` reserved
// bytes, then up to `streamChunkSize` data bytes, then CRLF. Every chunk
// reuses the same backing array, so a body of any length moves through one
// allocation and one `writeBytes` per chunk.
class chunkFrame {
  buf: []byte
  eof: bool

  // Pulls `source` into the data region until it holds `streamChunkSize`
  // bytes or `source` returns "" (`eof`). A source answering in small pieces
  // still yields full-size chunks, never one tiny chunk per pull.
  fill(source: BodySource): ()! {
    this.buf = this.buf[0:chunkPrefix]
    let have = 0
    while (have < streamChunkSize) {
      let room = streamChunkSize - have
      let piece = source(room)?
      if (len(piece) == 0) {
        this.eof = true
        return
      }
      if (len(piece) > room) {
        fail newError("writeChunkedBody: source returned ${itoa(len(piece))} bytes, ${itoa(room)} requested")
      }
      this.buf = append(this.buf, piece)
      have = have + len(piece)
    }
  }

  // Writes the chunk-size line (RFC 9112 section 7.1: hex size, CRLF) into the
  // reserved gap right before the data and closes the chunk with CRLF.
  // Returns the offset the frame starts at. Needs at least one data byte: a
  // zero-size chunk is the terminator, not a data chunk.
  seal(): int {
    let n = len(this.buf) - chunkPrefix
    let digits = hexDigits(n)
    let start = chunkPrefix - 2 - digits
    let i = 0
    while (i < digits) {
      this.buf[start + i] = hexDigit((n >> (4 * (digits - 1 - i))) & 15)
      i = i + 1
    }
    this.buf[chunkPrefix - 2] = '\r'
    this.buf[chunkPrefix - 1] = '\n'
    this.buf = append(this.buf, "\r\n")
    return start
  }
}

// Writes `source` to `s` as a chunked body (RFC 9112 section 7.1):
// chunks of up to `streamChunkSize` bytes, the zero-size last chunk, the
// trailer section `trailers` returns once the source is exhausted, and
// the final CRLF. The last data chunk and the terminator share one write.
fn writeChunkedBody(s: byteStream, source: BodySource, trailers: Option<TrailerSource>): ()! {
  let f = chunkFrame{ buf = []byte(chunkPrefix, chunkFrameCap), eof = false }
  while (!f.eof) {
    f.fill(source)?
    let start = len(f.buf)
    if (len(f.buf) > chunkPrefix) {
      start = f.seal()
    }
    if (f.eof) {
      let block = trailerBlock(trailers)?
      f.buf = append(f.buf, "0\r\n")
      f.buf = append(f.buf, block)
      f.buf = append(f.buf, "\r\n")
    }
    s.writeBytes(f.buf[start:len(f.buf)])?
  }
}

// The trailer section text `trailers` yields once the body is complete: ""
// for none.
fn trailerBlock(trailers: Option<TrailerSource>): string! {
  match (trailers) {
    Some(t) => { return serializeTrailers(t()?)? }
    None => { return "" }
  }
}

// Fails when `trailers` is set: a Content-Length message has no trailer
// section, and silently dropping them would hide a caller's mistake.
fn refuseTrailers(trailers: Option<TrailerSource>): ()! {
  match (trailers) {
    Some(_) => {
      fail newError("requestWithStreamingBody: trailers need chunked framing, but the body declares a length")
    }
    None => {}
  }
}

// The framing header line and the body writer's inputs, decided once: a
// declared length is a `Content-Length` line, anything else is chunked.
fn framingLine(body: StreamBody): string! {
  match (body.length) {
    Some(n) => {
      if (n < 0) {
        fail newError("requestWithStreamingBody: negative body length ${itoa(n)}")
      }
      refuseTrailers(body.trailers)?
      return "Content-Length: ${itoa(n)}\r\n"
    }
    None => { return "Transfer-Encoding: chunked\r\n" }
  }
}

// Writes the body in the framing `framingLine` chose.
fn writeBody(s: byteStream, body: StreamBody): ()! {
  match (body.length) {
    Some(n) => { writeStreamingBody(s, n, body.source)? }
    None => { writeChunkedBody(s, body.source, body.trailers)? }
  }
}

// Sends `head` and the body, then reads the response — the
// transport-independent half of `requestWithStreamingBody`.
fn exchangeStreaming(s: byteStream, method: string, head: string, body: StreamBody): Response! {
  s.writeStr(head)?
  writeBody(s, body)?
  return readResponse(s, method, defaultMaxBodyBytes)?
}

// Runs `method url` with the request body `body` streamed from its source,
// and returns the response exactly as `request` (client.bit) does — the
// RESPONSE is still read in full, which is correct for an S3-compatible
// PUT/POST: the reply is a small XML document or an empty body, never the
// multi-GB payload the REQUEST side is streaming out. A declared length
// sends `Content-Length`; an unknown one sends `Transfer-Encoding: chunked`
// and then `body.trailers` (announce them with a `Trailer` header in
// `headers`, RFC 9110 section 6.5.2). http:// and https:// are both
// supported, same as `requestWith`; `https+h3://` is not (see the file
// header).
export fn requestWithStreamingBody(
  method: string,
  url: string,
  headers: []Header,
  body: StreamBody,
): Response! {
  let framing = framingLine(body)?
  let block = serializeHeaders(headers)?
  let u = parseUrl(url)?
  if (u.h3) {
    fail newError("requestWithStreamingBody: https+h3:// is not supported")
  }
  let head = buildStreamingRequestHead(method, u, block, framing)
  if (u.https) {
    let s = tlsStream{ conn = tlsDial(u.host, u.port, streamingTlsConfig())? }
    defer s.shut()
    return exchangeStreaming(s, method, head, body)?
  }
  let s = netStream{ conn = dial(u.host, u.port)? }
  defer s.shut()
  return exchangeStreaming(s, method, head, body)?
}

// Reads the remaining `cl - len(initial)` bytes of a Content-Length-framed
// body off `s`, delivering each bounded chunk to `sink` instead of
// accumulating one `string` — the streaming twin of `readContentLengthBody`
// (client.bit), same framing, same overshoot truncation.
fn readContentLengthBodyStreaming(s: byteStream, initial: string, cl: int, sink: BodySink): ()! {
  let have = 0
  if (len(initial) > 0) {
    let first = initial
    if (len(first) > cl) {
      first = first[0:cl]
    }
    sink(first)?
    have = len(first)
  }
  while (have < cl) {
    let want = cl - have
    if (want > streamChunkSize) {
      want = streamChunkSize
    }
    let chunk = s.readUp(want)?
    if (len(chunk) == 0) {
      fail newError("response: connection closed before Content-Length bytes arrived")
    }
    if (have + len(chunk) > cl) {
      chunk = chunk[0:cl - have]
    }
    sink(chunk)?
    have = have + len(chunk)
  }
}

// Bundles the response-framing facts `readResponseBodyStreaming` needs
// alongside the stream and sink, keeping it under `spec/LINT.md`'s
// 5-parameter ceiling — the same reason `RequestExtras` (client.bit) bundles
// the request side's per-call facts instead of taking them as separate
// parameters.
class responseFraming {
  headers: string,
  method: string,
  maxBodyBytes: int,
}

// Delivers `s` to `sink` unless it is empty — shared by the two framings
// below that read their whole body in one call (chunked, read-to-EOF) but
// still only want to invoke `sink` when there is something to deliver.
// Split out so the two call sites don't each add their own branch to
// `readResponseBodyStreaming`'s complexity.
fn sinkIfNonEmpty(sink: BodySink, s: string): ()! {
  if (len(s) > 0) {
    sink(s)?
  }
}

// As `readResponseBody` (client.bit), but the Content-Length framing streams
// to `sink` in bounded chunks — see the file header for why chunked and
// read-to-EOF instead hand `sink` one whole (still `maxBodyBytes`-bounded)
// chunk.
fn readResponseBodyStreaming(
  s: byteStream,
  bodyStart: string,
  framing: responseFraming,
  sink: BodySink,
): ()! {
  if (framing.method == "HEAD") {
    return
  }
  checkFraming(framing.headers, "response")?
  let clText = header(framing.headers, "content-length")
  let teText = toLower(header(framing.headers, "transfer-encoding"))
  let hasCl = len(clText) > 0
  let hasTe = len(teText) > 0
  if (hasTe) {
    if (teText != "chunked") {
      fail newError("response: unsupported Transfer-Encoding")
    }
    sinkIfNonEmpty(sink, decodeChunkedBody(s, bodyStart, framing.maxBodyBytes)?)?
    return
  }
  if (hasCl) {
    let cl = atoi(clText)
    if (cl < 0) {
      fail newError("response: invalid Content-Length")
    }
    if (cl > framing.maxBodyBytes) {
      fail newError("readResponse: Content-Length ${itoa(cl)} exceeds ${itoa(framing.maxBodyBytes)} bytes")
    }
    readContentLengthBodyStreaming(s, bodyStart, cl, sink)?
    return
  }
  sinkIfNonEmpty(sink, readAllStream(s, bodyStart, framing.maxBodyBytes)?)?
}

// As `readResponse` (client.bit), but the body is delivered to `sink`
// instead of returned — the returned `Response.body` is always "".
fn readResponseStreaming(
  s: byteStream,
  method: string,
  maxBodyBytes: int,
  sink: BodySink,
): Response! {
  let (headBlock, bodyStart) = readUntil(s, "", "\r\n\r\n")?
  let eol = indexOf(headBlock, "\r\n")
  let statusLine = headBlock
  let headers = ""
  if (eol >= 0) {
    statusLine = headBlock[0:eol]
    headers = headBlock[eol + 2:len(headBlock)]
  }
  let code = parseStatusCode(statusLine)?
  let framing = responseFraming{ headers = headers, method = method, maxBodyBytes = maxBodyBytes }
  readResponseBodyStreaming(s, bodyStart, framing, sink)?
  return Response{
    status = code,
    contentType = header(headers, "content-type"),
    headers = headers,
    body = "",
  }
}

// GET `url` over http or https, delivering the response body to `sink` in
// bounded chunks instead of returning it whole. The returned
// `Response.body` is always "" — everything the body carried already went
// to `sink`. `https+h3://` is not supported (see the file header).
//
// `maxBodyBytes` is the DECLARED Content-Length ceiling `readResponseBodyStreaming`
// still refuses up front (a malformed or hostile response's own number, not
// what this call actually holds in memory — streaming never accumulates
// more than one chunk regardless of how large the object is). A caller
// downloading a multi-GB object passes a bound that actually covers it;
// `defaultMaxBodyBytes` (32 MiB, sized for `request`/`requestWith`'s
// whole-body-in-memory case) would refuse it before a single chunk reached
// `sink` (#6078/#6104: caught live against a 220 MiB object, not found by
// any unit test — nothing before this exercised a Content-Length anywhere
// near that boundary).
export fn getStreaming(
  url: string,
  headers: []Header,
  sink: BodySink,
  maxBodyBytes: int,
): Response! {
  let block = serializeHeaders(headers)?
  let u = parseUrl(url)?
  if (u.h3) {
    fail newError("getStreaming: https+h3:// is not supported")
  }
  let req = buildRequest("GET", u, block, noBody, true)
  if (u.https) {
    let s = tlsStream{ conn = tlsDial(u.host, u.port, streamingTlsConfig())? }
    defer s.shut()
    s.writeStr(req)?
    return readResponseStreaming(s, "GET", maxBodyBytes, sink)?
  }
  let s = netStream{ conn = dial(u.host, u.port)? }
  defer s.shut()
  s.writeStr(req)?
  return readResponseStreaming(s, "GET", maxBodyBytes, sink)?
}
