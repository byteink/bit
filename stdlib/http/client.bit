// Bit standard library — http module: the HTTP client.

// `monotonic` is the clock `requestTimeout` resolves its ONE whole-request
// deadline from, below (#2291); no sibling file in this module imports
// std/time yet.
import { monotonic } from "std/time"

// ---------------------------------------------------------------------------
// Client
// ---------------------------------------------------------------------------

// Reads one HTTP/1.1 response off `s`: the status line, headers, and a body
// framed per RFC 9112 §6 — the same framing rule `readMessage` (http.bit)
// applies to a request, and the same two helpers (`decodeChunkedBody`,
// `readUntil`) do the work, so a chunked or Content-Length-delimited body is
// decoded identically on both sides of the wire (#2292). `Transfer-Encoding:
// chunked` is decoded, never returned with its chunk markers inline;
// Content-Length is read exactly — a short read before the peer closes fails
// outright rather than returning a truncated body as a clean response, the
// response-side twin of #2168's request-smuggling fix (trailing bytes beyond
// a declared Content-Length are discarded rather than appended to the body).
// A response declaring both headers together is rejected outright, same as a
// request. No framing header means no body.
// "HTTP/1.1 200 OK" — the numeric status code is the token after the first
// space. Split out of `readResponse` (#2448).
fn parseStatusCode(statusLine: string): int! {
  let sp1 = indexOf(statusLine, " ")
  if (sp1 < 0) {
    fail newError("malformed status line")
  }
  let afterVer = statusLine[sp1 + 1:len(statusLine)]
  let sp2 = indexOf(afterVer, " ")
  let codeText = afterVer
  if (sp2 >= 0) {
    codeText = afterVer[0:sp2]
  }
  let code = atoi(codeText)
  if (code < 0) {
    fail newError("bad status code")
  }
  return code
}

// Reads the remaining `cl - len(initial)` bytes of a Content-Length-framed
// body onto `initial`, failing if the peer closes first. Split out of
// `readResponseBody` (#2448).
fn readContentLengthBody(s: byteStream, initial: string, cl: int): string! {
  if (len(initial) >= cl) {
    return initial[0:cl]
  }
  let body = newBuilder()
  body.write(initial)
  let have = len(initial)
  while (have < cl) {
    let chunk = s.readUp(4096)?
    if (len(chunk) == 0) {
      fail newError("response: connection closed before Content-Length bytes arrived")
    }
    // Truncate the OVERSHOOTING CHUNK rather than the accumulated body — the
    // same `cl` bytes kept and the same excess dropped, without re-slicing
    // everything read so far on every read. `newBuilder` comes from the
    // module-wide `std/strings` import in http.bit (an import is per-module).
    if (have + len(chunk) > cl) {
      chunk = chunk[0:cl - have]
    }
    body.write(chunk)
    have = have + len(chunk)
  }
  return body.toString()
}

// The response body, per RFC 9112 §6.3's framing precedence: chunked
// Transfer-Encoding, else an exact Content-Length read, else read-to-EOF (the
// case 7 fallback — sound here because every request this client sends
// carries `Connection: close`, so the peer closing is the terminator, not an
// ambiguity). Fails if both framing headers are present. Split out of
// `readResponse` (#2448).
//
// All three framings are bounded by `maxBodyBytes` (#4585), the mirror of the
// server's own request budget (#4565): a hostile or broken server is as able
// to exhaust a client's memory as the other way round, and until this existed
// `get("http://evil/")` against a response declaring `Content-Length:
// 4294967296` allocated 4 GiB before `get` returned. Each framing refuses on
// the declared or accumulated size BEFORE the bytes are read — a Content-
// Length on the peer's own number, chunked on the running total of chunk
// sizes (`decodeChunkedBody`, message.bit), read-to-EOF on the read that
// would cross it (`readAllStream`, http.bit) — so an over-budget response
// costs nothing rather than being refused once it is already resident.
fn readResponseBody(s: byteStream, bodyStart: string, headers: string, maxBodyBytes: int): string! {
  let clText = header(headers, "content-length")
  let teText = toLower(header(headers, "transfer-encoding"))
  let hasCl = len(clText) > 0
  let hasTe = len(teText) > 0
  if (hasCl && hasTe) {
    fail newError("response: Content-Length and Transfer-Encoding both present")
  }
  if (hasTe) {
    if (teText != "chunked") {
      fail newError("response: unsupported Transfer-Encoding")
    }
    return decodeChunkedBody(s, bodyStart, maxBodyBytes)?
  }
  if (hasCl) {
    let cl = atoi(clText)
    if (cl < 0) {
      fail newError("response: invalid Content-Length")
    }
    // On the DECLARED length, before `readContentLengthBody` allocates or
    // reads anything: the server's own number is the whole basis of the read,
    // so refusing it here is what stops the bytes from ever becoming
    // resident. Refusing after the read would be a parse limit, not a read
    // limit.
    if (cl > maxBodyBytes) {
      fail newError("readResponse: Content-Length ${cl} exceeds ${maxBodyBytes} bytes")
    }
    return readContentLengthBody(s, bodyStart, cl)?
  }
  return readAllStream(s, bodyStart, maxBodyBytes)?
}

fn readResponse(s: byteStream, maxBodyBytes: int): Response! {
  let (headBlock, bodyStart) = readUntil(s, "", "\r\n\r\n")?

  let eol = indexOf(headBlock, "\r\n")
  let statusLine = headBlock
  let headers = ""
  if (eol >= 0) {
    statusLine = headBlock[0:eol]
    headers = headBlock[eol + 2:len(headBlock)]
  }
  let code = parseStatusCode(statusLine)?
  let body = readResponseBody(s, bodyStart, headers, maxBodyBytes)?
  return Response{
    status: code,
    contentType: header(headers, "content-type"),
    headers: headers,
    body: body,
  }
}

// The `Host` field value for `u` per RFC 7230 §5.4 — the port appended unless
// it is the scheme's default (80 for http, 443 for https). Omitting it always
// (#2296) misroutes or gets rejected by any server that virtual-hosts on
// Host, which is almost everything not listening on the bare default port:
// reverse proxies (nginx/Traefik/Caddy pick a `server` block from Host) and
// any local dev server on a non-default port (Rails, Django, Vite all
// validate it).
// Written as a lookup rather than `(!https && 80) || (https && 443)` because
// `bit fmt` strips the parentheses from that form (#1909), leaving a bare
// mixed `&&`/`||` chain whose reading depends on precedence the reader has to
// recall. This spelling is canonical under fmt and needs no such recall.
fn hostHeaderValue(u: Url): string {
  let defaultPort = 80
  if (u.https) {
    defaultPort = 443
  }
  if (u.port == defaultPort) {
    return u.host
  }
  return "${u.host}:${itoa(u.port)}"
}

// The HTTP/1.1 request text for `method u.path` with `body`, asking the
// server to close the connection so `readResponse` can fall back to
// end-of-stream framing when neither Content-Length nor Transfer-Encoding is
// present. `headerBlock` is extra request headers, already validated and
// serialized by `serializeHeaders` (reqheader.bit, #2290) — inserted verbatim,
// after the framing lines this function owns and before Content-Length, so a
// caller can never override either by supplying a same-named header (those
// names are rejected earlier, by `isReservedRequestHeader`).
fn buildRequest(method: string, u: Url, headerBlock: string, body: string): string {
  let req = "${method} ${u.path} HTTP/1.1\r\n"
  req = req + "Host: ${hostHeaderValue(u)}\r\n"
  req = req + "Connection: close\r\n"
  req = req + headerBlock
  if (len(body) > 0) {
    req = req + "Content-Length: ${itoa(len(body))}\r\n"
  }
  return req + "\r\n" + body
}

// Send `reqText` over `s`, read one framed response, and close — on EVERY
// exit path, not only success. `defer` (SPEC §18.5) runs on a `?`
// propagation same as a normal `return`, which matters now that a deadline
// (#2291) makes "the read failed" a routine outcome rather than an edge
// case: without this, a timed-out `getTimeout`/`requestTimeout` leaked the
// underlying socket, since the old bare `s.shut()` below the `?` never ran.
fn exchangeOn(s: byteStream, reqText: string, maxBodyBytes: int): Response! {
  defer s.shut()
  s.writeStr(reqText)?
  let res = readResponse(s, maxBodyBytes)?
  return res
}

// Default trust anchors for verifying servers: the operating-system store when
// available, else the small bundled root set, served from the process-wide
// cache in trustcache.bit once populated (#2298 — systemRoots() parses the
// whole OS bundle, ~170ms, and paid this unconditionally on every call before
// the cache existed). Rewrapped as a std/tls trust store — both stores hold
// the same parsed X.509 roots, so no PEM round-trip is needed.
fn defaultRoots(): TlsTrustStore {
  return TlsTrustStore{ roots: defaultTrustRoots() }
}

// A secure-by-default client TLS config: verification on, default roots, ALPN
// `h2` then `http/1.1` (so the server may pick HTTP/2). SNI defaults to the
// request host inside `tls.dial`.
fn defaultClientConfig(): TlsConfig {
  let cfg = newTlsConfig(defaultRoots())
  cfg.alpn = ["h2", "http/1.1"]
  return cfg
}

// The per-request shaping every client entry point carries, and the reason
// none of them takes it as four more parameters (E0202's ceiling is five).
// It comes from the caller's `Client`, or from `newRequestExtras` when there
// is no `Client`:
//
//   `config`   the TLS config for an https leg still to be dialed — read by
//              `requestBlock` and `requestTimeoutTls`, not by `httpsExchange`,
//              which receives an already-dialed connection.
//   `block`    this request's extra headers, already validated and serialized
//              by `serializeHeaders` (reqheader.bit, #2290); "" for none.
//   `h3Ports`  this client's Alt-Svc cache (#3522) — consulted and updated on
//              the paths that can upgrade to HTTP/3, inert (fresh and empty)
//              for the package-level calls.
//   `maxBody`  the byte budget the response body is read under —
//              `defaultMaxBodyBytes` unless a `Client` raised or lowered it
//              with `setMaxBodyBytes`. Read by the HTTP/1.1 path (#4585) and
//              carried into the http2 engine's `Config.maxBodyBytes` on the
//              `h2` leg (#4590, h2.bit).
class RequestExtras {
  config: TlsConfig,
  block: string,
  h3Ports: map<string, int>,
  maxBody: int,
}

// The extras a call with no `Client` behind it uses: `config` and `block` from
// the caller, no Alt-Svc cache to consult (a fresh, always-empty map, #3522),
// and the module's default response budget.
fn newRequestExtras(config: TlsConfig, block: string): RequestExtras {
  return RequestExtras{
    config: config,
    block: block,
    h3Ports: map<string, int>(),
    maxBody: defaultMaxBodyBytes,
  }
}

// Shared by `request`, `requestWith`, and (for the h3-or-cleartext leg, where
// no per-client TLS handling is needed) `Client.requestWith`: run `method
// url` with `body` over `http://`, `https://`, or `https+h3://`, appending
// `extras.block` as extra request headers, using `extras.config` for the
// https leg's TLS and `extras.maxBody` as the response body budget.
// `request` is exactly this with `extras.block` always "", so a caller
// carrying no extra headers gets byte-identical wire output to before #2290.
fn requestBlock(method: string, url: string, body: string, extras: RequestExtras): Response! {
  let u = parseUrl(url)?
  if (u.h3) {
    return h3Exchange(u, method, body, extras.block)?
  }
  if (u.https) {
    return httpsExchange(tlsDial(u.host, u.port, extras.config)?, method, u, body, extras)?
  }
  let req = buildRequest(method, u, extras.block, body)
  return exchangeOn(netStream{ conn: dial(u.host, u.port)? }, req, extras.maxBody)?
}

// Send `method url` with an optional body and return the response. An `https://`
// URL runs over TLS 1.3, verifying the server against the system/bundled roots;
// if ALPN negotiates `h2` the exchange runs over the `std/http2` engine, else over
// HTTP/1.1. An `http://` URL runs over cleartext TCP (HTTP/1.1). The HTTP/1.1
// response body is framed by Content-Length or chunked encoding (see
// `readResponse`); the server is still asked to close the connection so a
// response with neither framing header can fall back to end-of-stream.
// For a custom TLS config (pinned roots, a fixed `serverName`,
// `insecureSkipVerify`), use `requestTls`. To attach request headers, use
// `requestWith`.
//
// The response body is read under `defaultMaxBodyBytes` (32 MiB, message.bit)
// and a larger one fails rather than being allocated (#4585). A caller that
// genuinely downloads more names the size it accepts: `newClient()` plus
// `Client.setMaxBodyBytes(n)`, then `Client.request`/`get`/`post`.
export fn request(method: string, url: string, body: string): Response! {
  return requestBlock(method, url, body, newRequestExtras(defaultClientConfig(), ""))?
}

// As `request`, but attaches `headers` (#2290) — each validated (a legal RFC
// 9110 field name, a value with no raw CR/LF/NUL) and rejected outright, with
// no partial send, if any entry is invalid or names a header this module
// manages itself (`Host`, `Connection`, `Accept-Encoding`, ... — see
// reqheader.bit's `isReservedRequestHeader` for the full set and why
// `Accept-Encoding` is on it).
export fn requestWith(method: string, url: string, headers: []Header, body: string): Response! {
  let block = serializeHeaders(headers)?
  return requestBlock(method, url, body, newRequestExtras(defaultClientConfig(), block))?
}

// As `request`, but over https with an explicit TLS `config` (custom roots, a
// pinned `serverName`, `insecureSkipVerify` for tests). Fails if `url` is not
// https. `config.alpn` defaults to `h2` then `http/1.1` when empty; the negotiated
// protocol selects the HTTP/2 engine or the HTTP/1.1 path.
export fn requestTls(method: string, url: string, body: string, config: TlsConfig): Response! {
  let u = parseUrl(url)?
  if (!u.https) {
    fail newError("requestTls: ${url} is not an https URL")
  }
  let cfg = config
  if (len(cfg.alpn) == 0) {
    cfg.alpn = ["h2", "http/1.1"]
  }
  let extras = newRequestExtras(cfg, "")
  return httpsExchange(tlsDial(u.host, u.port, cfg)?, method, u, body, extras)?
}

// GET `url` (http or https).
export fn get(url: string): Response! {
  return request("GET", url, "")?
}

// POST `body` to `url` (http or https).
export fn post(url: string, body: string): Response! {
  return request("POST", url, body)?
}

// GET an https `url` with an explicit TLS `config`.
export fn getTls(url: string, config: TlsConfig): Response! {
  return requestTls("GET", url, "", config)?
}

// POST `body` to an https `url` with an explicit TLS `config`.
export fn postTls(url: string, body: string, config: TlsConfig): Response! {
  return requestTls("POST", url, body, config)?
}

// ---------------------------------------------------------------------------
// Whole-request timeout (#2291)
// ---------------------------------------------------------------------------
//
// A server that accepts and then never answers parks `request`/`get`/`post`
// forever — nothing above bounds the wait, and none of them gains a default
// here: `get`/`post`/`request` behave exactly as before (Go's `http.Get`,
// Python's `requests.get`, and JS `fetch` all leave their own zero-config
// call unbounded too — a caller who wants a bound already has to opt in with
// every one of them), so an existing caller mid-way through a legitimate
// large download is not newly cut off by this change. `requestTimeout` and
// its siblings are the opt-in.
//
// ONE deadline, resolved ONCE before dial, covers connect + send + read of
// headers AND body — a whole-request bound, not a per-read one (the shape
// `runtime/ABI.md` §19's `osForkExecWaitBounded` documents, and the same
// tradeoff Go's `http.Client.Timeout` makes). A caller fetching a large file
// must therefore choose `timeoutMs` to cover the whole transfer, not just the
// time to first byte — the same choice a Go caller setting `Timeout` makes.
//
// Covers `http://` and `https://` (#2995): an https `Url` dials through
// std/tls's `dialDeadline`, whose returned `TlsConn` inherits the SAME
// absolute deadline for the handshake and every later record-layer
// read/write, exactly as a plain `Conn` inherits it for a cleartext request —
// see `std/tls`'s `dialDeadline` doc for how that threading works.
//
// Covers `https+h3://` too (#3004): `h3Exchange` runs over std/http3's QUIC
// transport, which has its own timers and loss recovery and is not built on
// `std/net`'s `Conn`, so the deadline there is a different mechanism —
// `h3ExchangeDeadline` (stdlib/http/h3.bit) rides the QUIC connection's own
// idle timeout (RFC 9000 §10.1, lowered via `h3DialDeadline`) rather than
// adding a second, parallel timer. See that file's doc comment for two
// documented gaps relative to this http/https path: the handshake phase is
// still bounded by QUIC's fixed internal 5s abandon timer rather than by
// `timeoutMs`, and the idle timer resets on any received datagram rather
// than tracking request progress specifically.
//
// `extras` is the same `RequestExtras` the non-timeout path carries — see its
// declaration above for what each field is and which leg reads it.

// As `requestTimeout`, but over https with an explicit TLS config — the
// timeout-path twin of `requestTls`. `extras.config.alpn` defaults to `h2`
// then `http/1.1` when empty, same as `requestTls`. `extras.block` exists so
// `Client.requestTimeout` (#3484) can pass this client's own default headers
// (`setHeader`) through, same as `Client.request`/`requestWith` — the
// package-level `requestTimeout` below always passes "" (and an inert,
// always-empty `extras.h3Ports`, #3522).
// Shared by the package-level `requestTimeout` below (called with
// `defaultClientConfig()`) and `Client.requestTimeout` (called with `c.tls`,
// #3005) so a `Client` built with `newClientTls` gets its custom TLS config —
// pinned roots, a fixed `serverName`, `insecureSkipVerify` — honored on the
// timeout path exactly as it already is on `Client.request`/`requestTls`,
// instead of silently falling back to `defaultClientConfig()`.
fn requestTimeoutTls(
  method: string,
  url: string,
  body: string,
  timeoutMs: int,
  extras: RequestExtras,
): Response! {
  let block = extras.block
  let u = parseUrl(url)?
  let deadline = monotonic().ns + timeoutMs * 1000000
  if (u.h3) {
    return h3ExchangeDeadline(u, method, body, deadline, block)?
  }
  if (u.https) {
    let key = h2glueAuthority(u)
    let cached = cachedH3Port(extras.h3Ports, key)
    if (cached != 0) {
      let hu = Url{ host: u.host, port: cached, path: u.path, https: true, h3: true }
      return h3ExchangeDeadline(hu, method, body, deadline, block)?
    }
    let cfg = extras.config
    if (len(cfg.alpn) == 0) {
      cfg.alpn = ["h2", "http/1.1"]
    }
    let tlsConn = tlsDialDeadline(u.host, u.port, cfg, deadline)?
    let res = httpsExchange(tlsConn, method, u, body, extras)?
    learnAltSvcInto(extras.h3Ports, key, res)
    return res
  }
  let conn = dialDeadline(u.host, u.port, deadline)?
  return exchangeOn(netStream{ conn: conn }, buildRequest(method, u, block, body), extras.maxBody)?
}

export fn requestTimeout(method: string, url: string, body: string, timeoutMs: int): Response! {
  let extras = newRequestExtras(defaultClientConfig(), "")
  return requestTimeoutTls(method, url, body, timeoutMs, extras)?
}

// GET `url` (http://, https://, or https+h3://), bounded by a whole-request
// `timeoutMs`. See `requestTimeoutTls`'s doc for the h3 path's two gaps
// relative to http/https (#3004).
export fn getTimeout(url: string, timeoutMs: int): Response! {
  return requestTimeout("GET", url, "", timeoutMs)?
}

// POST `body` to `url` (http://, https://, or https+h3://), bounded by a
// whole-request `timeoutMs`. See `requestTimeoutTls`'s doc for the h3 path's
// two gaps relative to http/https (#3004).
export fn postTimeout(url: string, body: string, timeoutMs: int): Response! {
  return requestTimeout("POST", url, body, timeoutMs)?
}

// ---------------------------------------------------------------------------
// HTTP/3 client with Alt-Svc discovery
// ---------------------------------------------------------------------------
//
// A `Client` holds the two pieces of state a self-upgrading client needs, so no
// module-global mutable state is required: the TLS config for its `https://` leg,
// and an Alt-Svc cache mapping an authority (`host:port`) to the HTTP/3 UDP port a
// server advertised. The cache is a `map` (a reference type), so a method updates
// the same table the caller's `Client` holds. Hold one `Client` across requests to
// let a later request to a known authority upgrade to HTTP/3 automatically.

// The h3 port advertised for the `h3=` alternative in an Alt-Svc header value
// (RFC 7838), or -1 if there is none. Accepts `h3=":443"` and `h3="host:443"` —
// the port is the digits after the last colon inside the quoted authority.
fn parseAltSvcH3Port(av: string): int {
  let at = indexOf(av, "h3=")
  if (at < 0) {
    return 0 - 1
  }
  let rest = av[at + 3:len(av)]
  if (len(rest) > 0 && rest[0] == '"') {
    rest = rest[1:len(rest)]
  }
  let q = indexOf(rest, "\"")
  let val = rest
  if (q >= 0) {
    val = rest[0:q]
  }
  let colon = 0 - 1
  let i = 0
  while (i < len(val)) {
    if (val[i] == ':') {
      colon = i
    }
    i = i + 1
  }
  if (colon < 0) {
    return 0 - 1
  }
  return atoi(val[colon + 1:len(val)])
}

// An HTTP client that remembers the HTTP/3 endpoints servers advertise via
// Alt-Svc, so a later request to the same authority upgrades to HTTP/3. It has no
// global state: hold one across requests to reuse its cache. `headers` (#2290) is
// this client's own per-client default request headers, set with `setHeader` and
// sent with every `request`/`requestWith` call this client makes.
export class Client {
  tls: TlsConfig
  h3Ports: map<string, int>
  headers: []Header
  maxBody: int

  // Raise or lower the byte budget this client reads a response body under
  // (#4585). It defaults to `defaultMaxBodyBytes` (32 MiB, message.bit): a
  // response whose `Content-Length` declares more, whose chunk sizes add up
  // to more, or which streams more than that to end-of-stream, fails BEFORE
  // the bytes are read, so a hostile server cannot exhaust this process's
  // memory by declaring a size.
  //
  // This is the escape hatch the package-level `get`/`post`/`request*` do not
  // have: a caller that genuinely downloads more than 32 MiB names the size
  // it accepts here and calls `Client.get`/`post`/`request`/`requestTimeout`
  // instead. There is deliberately no value meaning "unlimited" — zero means
  // "refuse every body", the same as `Server.setMaxBodyBytes` and
  // `multipart.bit`'s `Limits`.
  //
  // Applies to the HTTP/1.1 response path AND, since #4590, to an `https://`
  // exchange that ALPN negotiates to `h2`: the budget travels into the
  // `std/http2` engine as `Config.maxBodyBytes` (`h2glueConfig`, h2.bit), which
  // resets the stream once its DATA passes it. An `https+h3://` exchange is
  // still framed by the `std/http3` engine and bounded by its limits, not by
  // this one.
  export setMaxBodyBytes(n: int) {
    this.maxBody = n
  }
  // Sets a per-client default header sent with every `Client.request`/
  // `Client.requestWith`/`Client.requestTimeout`/`getTimeout`/`postTimeout` call
  // this client makes (#3484) — e.g. an `Authorization` token used across a
  // whole session. A later call with the same
  // `name` (case-insensitively) replaces the earlier value rather than adding a
  // second line. Fails exactly as `serializeHeaders` would on this one header: an
  // invalid name, a value with a raw CR/LF/NUL, or a name `isReservedRequestHeader`
  // reserves (reqheader.bit).
  export setHeader(name: string, value: string): ()! {
    let h = Header{ name: name, value: value }
    validateHeader(h)?
    let lower = toLower(name)
    let i = 0
    while (i < len(this.headers)) {
      if (toLower(this.headers[i].name) == lower) {
        this.headers[i] = h
        return
      }
      i = i + 1
    }
    this.headers = append(this.headers, h)
  }

  // This client's shaping for one request carrying `block`: its TLS config,
  // its live Alt-Svc cache (the map itself, so a response learned on this
  // request updates the client's own table), and its response body budget.
  extrasWith(block: string): RequestExtras {
    return RequestExtras{
      config: this.tls,
      block: block,
      h3Ports: this.h3Ports,
      maxBody: this.maxBody,
    }
  }

  // Record any `h3=` Alt-Svc advertisement `res` carried for `authority`.
  learnAltSvc(authority: string, res: Response) {
    learnAltSvcInto(this.h3Ports, authority, res)
  }

  // Send `method url` with an optional body. An `https+h3://` URL always uses
  // HTTP/3. An `https://` URL upgrades to HTTP/3 when this client has cached an
  // Alt-Svc endpoint for the authority from an earlier response; otherwise it runs
  // over TLS (HTTP/2 or HTTP/1.1 by ALPN) and learns any Alt-Svc the response
  // advertises. An `http://` URL runs over cleartext HTTP/1.1. To attach request
  // headers, use `requestWith`.
  export request(method: string, url: string, body: string): Response! {
    return this.requestWith(method, url, []Header(0), body)?
  }

  // As `Client.request`, but attaches `headers` (#2290) layered onto this
  // client's own default headers (`setHeader`) — a header in `headers` sharing a
  // name with a default replaces it for this call only; the client's stored
  // default is untouched. Same validation as `requestWith`: an invalid name or
  // value, or a reserved header name, fails the whole call before anything is
  // sent.
  export requestWith(
    method: string,
    url: string,
    headers: []Header,
    body: string,
  ): Response! {
    let block = serializeHeaders(mergeHeaders(this.headers, headers))?
    let extras = this.extrasWith(block)
    let u = parseUrl(url)?
    if (u.h3 || !u.https) {
      return requestBlock(method, url, body, extras)?
    }
    let key = h2glueAuthority(u)
    let cached = cachedH3Port(this.h3Ports, key)
    if (cached != 0) {
      let hu = Url{ host: u.host, port: cached, path: u.path, https: true, h3: true }
      return h3Exchange(hu, method, body, block)?
    }
    let cfg = this.tls
    if (len(cfg.alpn) == 0) {
      cfg.alpn = ["h2", "http/1.1"]
    }
    let res = httpsExchange(tlsDial(u.host, u.port, cfg)?, method, u, body, extras)?
    this.learnAltSvc(key, res)
    return res
  }

  // GET `url` through this client (HTTP/3 when discovered, else TLS or cleartext).
  export get(url: string): Response! {
    return this.request("GET", url, "")?
  }

  // POST `body` to `url` through this client.
  export post(url: string, body: string): Response! {
    return this.request("POST", url, body)?
  }

  // As the package-level `requestTimeout`: a whole-request deadline covering
  // `http://`, `https://`, and `https+h3://` (#2995, #3004). Consults and
  // updates this client's Alt-Svc cache exactly as `Client.request`/
  // `requestWith` does (#3522) — upgrades to HTTP/3 when cached, learns any
  // `Alt-Svc` response header. Also uses its TLS config (#3005) and its own
  // default headers (`setHeader`, #3484) for `http://`/`https://`: an https
  // `Url` dials with `c.tls` and sends `c.headers`, so a `Client` built with
  // `newClientTls` or carrying its own `setHeader` defaults gets both applied
  // here, the same as `Client.request`/`requestTls` already do.
  export requestTimeout(
    method: string,
    url: string,
    body: string,
    timeoutMs: int,
  ): Response! {
    let block = serializeHeaders(this.headers)?
    return requestTimeoutTls(method, url, body, timeoutMs, this.extrasWith(block))?
  }

  // GET `url` through this client, bounded by a whole-request `timeoutMs`
  // (`http://`, `https://`, or `https+h3://`).
  export getTimeout(url: string, timeoutMs: int): Response! {
    return this.requestTimeout("GET", url, "", timeoutMs)?
  }

  // POST `body` to `url` through this client, bounded by a whole-request
  // `timeoutMs` (`http://`, `https://`, or `https+h3://`).
  export postTimeout(url: string, body: string, timeoutMs: int): Response! {
    return this.requestTimeout("POST", url, body, timeoutMs)?
  }
}

// A `Client` with secure-by-default TLS (verification on, system/bundled roots,
// ALPN `h2` then `http/1.1`), an empty Alt-Svc cache, and no default headers.
export fn newClient(): Client {
  return newClientTls(defaultClientConfig())
}

// A `Client` with an explicit `std/tls` config for its `https://` leg (pinned
// roots, a fixed `serverName`, `insecureSkipVerify`), an empty Alt-Svc cache, and
// no default headers.
export fn newClientTls(config: TlsConfig): Client {
  return Client{
    tls: config,
    h3Ports: map<string, int>(),
    headers: []Header(0),
    maxBody: defaultMaxBodyBytes,
  }
}

// Cached h3 port for `key`, or 0 — read side shared by `requestWith`/`requestTimeoutTls` (#3522).
fn cachedH3Port(h3Ports: map<string, int>, key: string): int {
  return h3Ports[key]
}

// Records any `h3=` Alt-Svc advertisement in `res` for `authority` into `h3Ports` — write side
// shared by `learnAltSvc`/`requestTimeoutTls` (#3522).
fn learnAltSvcInto(h3Ports: map<string, int>, authority: string, res: Response) {
  let av = header(res.headers, "alt-svc")
  if (len(av) == 0) {
    return
  }
  let p = parseAltSvcH3Port(av)
  if (p > 0) {
    h3Ports[authority] = p
  }
}

