// Bit standard library — http module: the request fields a peer sends over
// HTTP/2 and HTTP/3, checked as they are serialised into the text block
// `header()` reads (#6729, #6736).

// True if `c`, a byte that is neither a lower-case letter nor '-', may still
// appear in a field name a peer sends over HTTP/2 or HTTP/3 (RFC 9113 §8.2.1,
// RFC 9114 §4.2): a digit or one of `tokenExtraBytes`. An upper-case letter is a
// token byte (`isTokenByte`) those protocols forbid on the wire, and ':' is not
// a token byte, so a pseudo-header the engine did not consume is refused too.
fn peerNameOtherByte(c: byte): bool {
  return (c >= '0' && c <= '9') || isTokenPunct(c)
}

// The connection-specific field `name` could be, picked by its first byte, or
// "" when it can be none. Lets `connectionSpecificField` decide nearly every
// name on a byte and a length, with no string compare.
fn connectionFieldFor(name: string): string {
  if (len(name) < 7) {
    return ""
  }
  let c = name[0]
  if (c == 'c') {
    return "connection"
  }
  if (c == 'k') {
    return "keep-alive"
  }
  if (c == 'p') {
    return "proxy-connection"
  }
  if (c == 't') {
    return "transfer-encoding"
  }
  if (c == 'u') {
    return "upgrade"
  }
  return ""
}

// True if `name` (lower-case) is a connection-specific field, which an HTTP/2
// or HTTP/3 message must not carry (RFC 9113 §8.2.2, RFC 9114 §4.2). Content-
// Length is not one: it is legal there, and each glue drops it separately.
fn connectionSpecificField(name: string): bool {
  let want = connectionFieldFor(name)
  return len(want) == len(name) && name == want
}

// True if a peer's field is one HTTP/2 and HTTP/3 forbid by name: a
// connection-specific field, or `te` with any value but "trailers".
fn peerFieldForbidden(name: string, value: string): bool {
  if (len(name) == 2) {
    return name == "te" && value != "trailers"
  }
  return connectionSpecificField(name)
}

// Copies `name` into `dst` at `at`, returning the offset past it, or -1 at the
// first byte a peer's field name must not carry (`peerNameOtherByte`).
fn putPeerName(dst: []byte, at: int, name: string): int {
  let i = 0
  while (i < len(name)) {
    let c = name[i]
    // Lower-case letters and '-' are nearly every byte of a real name; skip
    // the digit and `tokenExtraBytes` tests for them.
    if ((c < 'a' || c > 'z') && c != '-' && !peerNameOtherByte(c)) {
      return 0 - 1
    }
    dst[at + i] = c
    i = i + 1
  }
  return at + len(name)
}

// Copies `value` into `dst` at `at`, returning the offset past it, or -1 at
// the first CR, LF or NUL, the bytes `hasForbiddenValueByte` refuses.
fn putPeerValue(dst: []byte, at: int, value: string): int {
  let i = 0
  while (i < len(value)) {
    let c = value[i]
    if (c <= '\r' && (c == '\r' || c == '\n' || c == '\0')) {
      return 0 - 1
    }
    dst[at + i] = c
    i = i + 1
  }
  return at + len(value)
}

// Writes the line "name: value\r\n" of a request field a peer sent over HTTP/2
// or HTTP/3 into `dst` at `at`, returning the offset past it, or -1 when the
// field makes the request malformed (RFC 9113 §8.2.1, §8.2.2, RFC 9114 §4.2):
// an empty name or one `putPeerName` refuses, a field `peerFieldForbidden`
// names, or a value `putPeerValue` refuses. HPACK and QPACK carry fields as
// length-prefixed binary, so nothing in the decoder stops these; serialised
// into the text block `header()` reads, one would become a second field line
// (#6729). Each byte is checked as it is copied, so a request is walked once
// (#6736). `dst` must hold `len(name) + len(value) + 4` bytes from `at`; on -1
// it is partly written and must be dropped. Shared by `h2glueRequestBlock`
// (h2.bit) and `h3glueRequestBlock` (h3.bit).
fn putPeerField(dst: []byte, at: int, name: string, value: string): int {
  if (len(name) == 0 || peerFieldForbidden(name, value)) {
    return 0 - 1
  }
  let k = putPeerName(dst, at, name)
  if (k < 0) {
    return k
  }
  dst[k] = ':'
  dst[k + 1] = ' '
  k = putPeerValue(dst, k + 2, value)
  if (k < 0) {
    return k
  }
  dst[k] = '\r'
  dst[k + 1] = '\n'
  return k + 2
}
