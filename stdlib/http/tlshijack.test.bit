// stdlib/http/tlshijack.test.bit — `serveHijackableTlsOn`/`TlsExchange`
// (#6152). `tlsServe`, `Request`, `Response`, `respond`, `ok`, `indexOf` and
// `newDrainState` are module-wide siblings (SPEC §19). `tls5916Pem`,
// `tls5916LeafHex`, `tls5916KeyHex`, `tls5916ClientConfig` and `tlsDial`
// (tls.test.bit) are `.test.bit`-only siblings, visible here for the same
// reason (SPEC §17.2).

fn hijackTlsOnPath(req: Request, ex: TlsExchange): HijackOutcome {
  if (req.path == "/hijack") {
    let conn = ex.hijack()
    conn.write([]byte("RAW\r\n")) catch _ {}
    return HijackOutcome.Hijacked
  }
  return HijackOutcome.Answer(ok("hi ${req.path}"))
}

fn tlsHijackPlain(req: Request): Response {
  return ok("h2 ${req.path}")
}

fn tlsHijackServe(ts: TlsServer) {
  serveHijackableTlsOn(ts, hijackTlsOnPath, tlsHijackPlain) catch _ {
    return
  }
}

fn startTlsHijackServer(): (TlsServer, int)! {
  let certPem = tls5916Pem("CERTIFICATE", tls5916LeafHex)
  let keyPem = tls5916Pem("PRIVATE KEY", tls5916KeyHex)
  let ts = tlsServe("127.0.0.1", 0, certPem, keyPem)?
  let port = ts.port()?
  spawn tlsHijackServe(ts)
  return ts, port
}

test "over TLS, an Answer outcome keeps the connection open for a second request" {
  let (ts, port) = startTlsHijackServer() catch e {
    assert(false, "startTlsHijackServer: ${e.message()}")
    return
  }
  let conn = tlsDial("127.0.0.1", port, tls5916ClientConfig()) catch e {
    ts.shutdown(2000) catch _ {}
    assert(false, "tlsDial: ${e.message()}")
    return
  }
  conn.write([]byte("GET /a HTTP/1.1\r\nHost: x\r\n\r\n")) catch e {
    conn.close()
    ts.shutdown(2000) catch _ {}
    assert(false, "write 1: ${e.message()}")
    return
  }
  let first = string(
    conn.read(4096) catch e {
      conn.close()
      ts.shutdown(2000) catch _ {}
      assert(false, "read 1: ${e.message()}")
      return
    },
  )
  assert(indexOf(first, "hi /a") >= 0, "want the first response to answer /a, got:\n${first}")
  assert(
    indexOf(first, "connection: close") < 0,
    "response 1 carried Connection: close:\n${first}",
  )

  // The SAME TLS connection, a second ordinary request — proves this
  // connection never dropped to one-request-per-connection.
  conn.write([]byte("GET /b HTTP/1.1\r\nHost: x\r\n\r\n")) catch e {
    conn.close()
    ts.shutdown(2000) catch _ {}
    assert(false, "write 2: ${e.message()}")
    return
  }
  let second = string(
    conn.read(4096) catch e {
      conn.close()
      ts.shutdown(2000) catch _ {}
      assert(false, "read 2: ${e.message()}")
      return
    },
  )
  assert(indexOf(second, "hi /b") >= 0, "want the second response to answer /b, got:\n${second}")

  conn.close()
  ts.shutdown(2000) catch _ {}
}

test "over TLS, a Hijacked outcome stops the loop and hands the raw connection over" {
  let (ts, port) = startTlsHijackServer() catch e {
    assert(false, "startTlsHijackServer: ${e.message()}")
    return
  }
  let conn = tlsDial("127.0.0.1", port, tls5916ClientConfig()) catch e {
    ts.shutdown(2000) catch _ {}
    assert(false, "tlsDial: ${e.message()}")
    return
  }
  conn.write([]byte("GET /hijack HTTP/1.1\r\nHost: x\r\n\r\n")) catch e {
    conn.close()
    ts.shutdown(2000) catch _ {}
    assert(false, "write: ${e.message()}")
    return
  }
  let wire = string(
    conn.read(64) catch e {
      conn.close()
      ts.shutdown(2000) catch _ {}
      assert(false, "read: ${e.message()}")
      return
    },
  )
  conn.close()
  ts.shutdown(2000) catch _ {}
  assert(
    wire == "RAW\r\n",
    "want the raw bytes the handler wrote with no HTTP framing, got '${wire}'",
  )
}

fn dialH2Noop(host: string, port: int, cfg: TlsConfig) {
  tlsDial(host, port, cfg) catch _ {
    return
  }
}

test "TlsServer.accept() refuses a connection that negotiated h2" {
  let certPem = tls5916Pem("CERTIFICATE", tls5916LeafHex)
  let keyPem = tls5916Pem("PRIVATE KEY", tls5916KeyHex)
  let ts = tlsServe("127.0.0.1", 0, certPem, keyPem) catch e {
    assert(false, "tlsServe: ${e.message()}")
    return
  }
  let port = ts.port() catch e {
    ts.shutdown(2000) catch _ {}
    assert(false, "port: ${e.message()}")
    return
  }
  let cfg = tls5916ClientConfig()
  cfg.alpn = ["h2"]
  spawn dialH2Noop("127.0.0.1", port, cfg)

  let _ = ts.accept() catch e {
    ts.shutdown(2000) catch _ {}
    assert(indexOf(e.message(), "h2") >= 0, "want the h2 refusal, got: ${e.message()}")
    return
  }
  ts.shutdown(2000) catch _ {}
  assert(false, "want accept() to refuse an h2 connection, got a TlsExchange")
}
