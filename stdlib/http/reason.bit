// Bit standard library — http module: RFC 9110 §15 / RFC 6585 reason phrases
// (#6122).
//
// Split out of http.bit to stay under `max-file-lines` (spec/LINT.md); a pure
// move, same module (files in a directory share a module, so `reason` needs
// no import at its call sites in http.bit and status.bit).

// The RFC 9110 §15 reason phrase for a status code that RFC defines, plus 429
// and 431 (RFC 6585). "" for anything else — legal (RFC 9112 §4: the phrase
// is descriptive only, clients key on the numeric status) and more honest
// than a made-up label. Dispatched by the hundreds digit to one sub-switch
// per class rather than one giant switch, so every switch stays well under
// `max-complexity` (spec/LINT.md) and this function itself stays a handful of
// branches; no allocation, every arm a string literal.
fn reason(status: int): string {
  switch (status / 100) {
    case 1:
      return reason1xx(status)
    case 2:
      return reason2xx(status)
    case 3:
      return reason3xx(status)
    case 4:
      return reason4xx(status)
    case 5:
      return reason5xx(status)
    default:
      return ""
  }
}

// RFC 9110 §15.2: the two informational statuses.
fn reason1xx(status: int): string {
  switch (status) {
    case 100:
      return "Continue"
    case 101:
      return "Switching Protocols"
    default:
      return ""
  }
}

// RFC 9110 §15.3: the seven successful statuses.
fn reason2xx(status: int): string {
  switch (status) {
    case 200:
      return "OK"
    case 201:
      return "Created"
    case 202:
      return "Accepted"
    case 203:
      return "Non-Authoritative Information"
    case 204:
      return "No Content"
    case 205:
      return "Reset Content"
    case 206:
      return "Partial Content"
    default:
      return ""
  }
}

// RFC 9110 §15.4: the redirection statuses, 300-308. 306 is deliberately
// absent — §15.4.7 reserves it as "(Unused)" and assigns it no phrase, so it
// falls to the same "" as any other undefined code.
fn reason3xx(status: int): string {
  switch (status) {
    case 300:
      return "Multiple Choices"
    case 301:
      return "Moved Permanently"
    case 302:
      return "Found"
    case 303:
      return "See Other"
    case 304:
      return "Not Modified"
    case 305:
      return "Use Proxy"
    case 307:
      return "Temporary Redirect"
    case 308:
      return "Permanent Redirect"
    default:
      return ""
  }
}

// RFC 9110 §15.5's 18 client-error statuses, 400-417, split at 409 so each
// half's switch stays under `max-complexity`; RFC 9110 renamed 413 from
// "Payload Too Large" to "Content Too Large".
fn reason4xxLow(status: int): string {
  switch (status) {
    case 400:
      return "Bad Request"
    case 401:
      return "Unauthorized"
    case 402:
      return "Payment Required"
    case 403:
      return "Forbidden"
    case 404:
      return "Not Found"
    case 405:
      return "Method Not Allowed"
    case 406:
      return "Not Acceptable"
    case 407:
      return "Proxy Authentication Required"
    case 408:
      return "Request Timeout"
    default:
      return ""
  }
}

fn reason4xxHigh(status: int): string {
  switch (status) {
    case 409:
      return "Conflict"
    case 410:
      return "Gone"
    case 411:
      return "Length Required"
    case 412:
      return "Precondition Failed"
    case 413:
      return "Content Too Large"
    case 414:
      return "URI Too Long"
    case 415:
      return "Unsupported Media Type"
    case 416:
      return "Range Not Satisfiable"
    case 417:
      return "Expectation Failed"
    default:
      return ""
  }
}

// RFC 9110 §15.5.19-21: 421, 422, 426; RFC 9110 renamed 422 from
// "Unprocessable Entity" to "Unprocessable Content". 429 and 431 are RFC
// 6585 (Additional HTTP Status Codes), not RFC 9110, but belong to the same
// 4xx class.
fn reason4xxRest(status: int): string {
  switch (status) {
    case 421:
      return "Misdirected Request"
    case 422:
      return "Unprocessable Content"
    case 426:
      return "Upgrade Required"
    case 429:
      return "Too Many Requests"
    case 431:
      return "Request Header Fields Too Large"
    default:
      return ""
  }
}

// Dispatches the 4xx range across the three switches above by sub-range, so
// none of them exceeds nine cases.
fn reason4xx(status: int): string {
  if (status <= 408) {
    return reason4xxLow(status)
  }
  if (status <= 417) {
    return reason4xxHigh(status)
  }
  return reason4xxRest(status)
}

// RFC 9110 §15.6: the six server-error statuses.
fn reason5xx(status: int): string {
  switch (status) {
    case 500:
      return "Internal Server Error"
    case 501:
      return "Not Implemented"
    case 502:
      return "Bad Gateway"
    case 503:
      return "Service Unavailable"
    case 504:
      return "Gateway Timeout"
    case 505:
      return "HTTP Version Not Supported"
    default:
      return ""
  }
}

