// Bit standard library — http module: reading a request off the wire.
//
// The server-side read path, split out of `http.bit` (#4565) so both files
// stay under the 800-line ceiling: `readMessage` and everything it calls to
// frame one HTTP/1.1 request — the header block, the `Content-Length` body,
// the chunked decoder — plus the two byte budgets that bound them. Same
// module as `http.bit` (SPEC §19), so nothing here is imported: `byteStream`,
// `Request`, `header`, `hexToInt`, `atoi` and the rest are siblings.

// ---------------------------------------------------------------------------
// Reading a message off a connection
// ---------------------------------------------------------------------------

// Reads from `s`, appending to `buf`, until `buf` contains `delim`. Returns the
// text before the first `delim` and whatever of `buf` came after it (bytes
// already buffered past the delimiter — e.g. the start of a chunk body or the
// next header line). Fails if the peer closes before `delim` ever appears.
// The last `n` bytes of `s`, or all of `s` when it is shorter. `n` is
// `len(delim) - 1` at both call sites: the widest window a delimiter match
// can straddle when the next chunk arrives.
fn lastBytes(s: string, n: int): string {
  if (len(s) <= n) {
    return s
  }
  return s[len(s) - n:len(s)]
}

// The index, within an accumulated buffer of `accLen` bytes followed by
// `chunk`, of the first `delim` — or -1 if there is none. `tail` is that
// buffer's last `len(delim) - 1` bytes, and the buffer is already known to
// contain no `delim`, so a match can only start inside `tail`: scanning
// `tail + chunk` is O(len(chunk)) per read where re-scanning the whole buffer
// would be O(accLen). That is what lets an accumulate-until-delimiter loop
// keep its accumulator in a Builder — it never has to be materialised as a
// string until the delimiter is actually found.
fn delimIndex(accLen: int, tail: string, chunk: string, delim: string): int {
  let hit = indexOf(tail + chunk, delim)
  if (hit < 0) {
    return -1
  }
  return accLen - len(tail) + hit
}

fn readUntil(s: byteStream, buf: string, delim: string): (string, string)! {
  let at = indexOf(buf, delim)
  if (at >= 0) {
    return buf[0:at], buf[at + len(delim):len(buf)]
  }
  let back = len(delim) - 1
  let acc = Builder()
  acc.write(buf)
  let n = len(buf)
  let tail = lastBytes(buf, back)
  while (true) {
    let chunk = s.readUp(4096)?
    if (len(chunk) == 0) {
      fail newError("readMessage: connection closed mid-message")
    }
    let hit = delimIndex(n, tail, chunk, delim)
    acc.write(chunk)
    n = n + len(chunk)
    if (hit >= 0) {
      let all = acc.toString()
      return all[0:hit], all[hit + len(delim):len(all)]
    }
    tail = lastBytes(tail + chunk, back)
  }
}

// Decodes a `Transfer-Encoding: chunked` body (RFC 9112 §7.1) off `s`,
// `buffered` being whatever body-position bytes already arrived with the
// headers. Fails on a non-hex chunk-size, a stream that closes mid-chunk, or a
// chunk stream that never terminates within `maxChunks` — bounded so the loop
// is provably finite (Power of 10 rule 2), not to cap a legitimately large body.
// Reads 4096-byte chunks from `s` onto `have` until it holds at least `n`
// bytes. Split out of `decodeChunkedBody` (#4028) so the chunk-fill
// accumulates into a Builder without spending a branch from that function's
// own complexity budget; the loop it replaces there re-copied the whole
// partially-filled chunk on every read.
fn fillTo(s: byteStream, have: string, n: int): string! {
  if (len(have) >= n) {
    return have
  }
  let b = Builder()
  b.write(have)
  let got = len(have)
  while (got < n) {
    let chunk = s.readUp(4096)?
    if (len(chunk) == 0) {
      fail newError("readMessage: connection closed mid-chunk")
    }
    b.write(chunk)
    got = got + len(chunk)
  }
  return b.toString()
}

fn decodeChunkedBody(s: byteStream, buffered: string, maxBodyBytes: int): string! {
  let maxChunks = 1048576
  let buf = buffered
  let body = Builder()
  let n = 0
  // Bytes of decoded body accumulated so far. A chunked body declares no
  // total length, so `maxBodyBytes` can only be enforced here, as the sizes
  // add up — the one budget it is easiest to forget.
  let total = 0
  while (n < maxChunks) {
    n = n + 1
    let (sizeLine, rest) = readUntil(s, buf, "\r\n")?
    buf = rest
    let hexPart = sizeLine
    let semi = indexOf(sizeLine, ";")
    if (semi >= 0) {
      hexPart = sizeLine[0:semi]
    }
    let size = hexToInt(trimSpace(hexPart))
    if (size < 0) {
      fail newError("readMessage: bad chunk size")
    }
    // Refused on the DECLARED size, before `fillTo` reads a byte of it: a
    // single chunk claiming 4 GiB is rejected without allocating 4 GiB, and a
    // stream of small chunks is rejected on the one that crosses the budget.
    // Written as a subtraction, not `total + size > maxBodyBytes`: `total` is
    // never above `maxBodyBytes` (this check is what keeps it there), so the
    // left side cannot overflow, while the addition could for a chunk size
    // near the top of the range and would then compare as negative.
    if (size > maxBodyBytes - total) {
      fail newError("readMessage: chunked body exceeds ${maxBodyBytes} bytes")
    }
    total = total + size
    if (size == 0) {
      // The final chunk: consume the (usually empty) trailer section, one
      // field line at a time, up to and including its terminating blank line.
      let t = 0
      while (t < maxChunks) {
        t = t + 1
        let (line, rest2) = readUntil(s, buf, "\r\n")?
        buf = rest2
        if (len(line) == 0) {
          // `buf` is whatever arrived after the trailer's terminating blank
          // line — a pipelined next request on a persistent connection, most
          // of the time "" (#5419). Not this body; push it back rather than
          // drop it. `unread("")` is a harmless no-op, so this needs no guard
          // that would add another nesting level (E0203).
          s.unread(buf)
          return body.toString()
        }
      }
      fail newError("readMessage: too many trailer fields")
    }
    buf = fillTo(s, buf, size + 2)?
    body.write(buf[0:size])
    buf = buf[size + 2:len(buf)]
  }
  fail newError("readMessage: too many chunks")
}

// `breaks` is -1 if `headBlock` (the request line plus header lines, before
// splitting) carries a bare CR, a bare LF, or a NUL; otherwise the number of
// `\n` bytes in it, each one a CRLF once those three conditions are ruled out.
// RFC 9110 §5.5 forbids all three in a field value; letting one survive lets a
// single header line on the wire masquerade as several once something
// reflects it — e.g. a bare LF inside a header value is not a line terminator
// to this parser, so it stays embedded in that header's value, and anything
// after it (`Set-Cookie: admin=1`, say) rides along as attacker-controlled
// text inside what the application sees as one ordinary value. Scanning the
// whole block, not just header values, also catches an attempt to smuggle one
// through the request line.
//
// The count doubles as `Request.headerLines` (http.bit, #5964): with a
// request line present (`readMessage`'s `eol >= 0`), the request line's own
// CRLF plays the same role as the "+1" in `pkg/web`'s `checkHeaderCaps`
// formula (`1 + CRLF pairs in headers`), so this return value equals that
// count exactly, off the one walk `readMessage` already had to make.
//
// `clAt`, `teAt` and `connAt` are where the first Content-Length,
// Transfer-Encoding and Connection field lines begin in `headBlock`, -1 when
// absent, and all -1 when `breaks` is. Every HTTP/1 request needs all three
// before its handler runs. Once the block is accepted, every `\n` closes a
// CRLF, so the byte after each one is exactly a line start `headerLineStart`
// (http.bit) would test; testing it here, on the walk that already visits
// every `\n`, replaced a second walk that found each line end again with
// `indexOfFrom` (#5970). The request line itself is never tested: no `\n`
// precedes it, and `headerLineStart` runs on `headers`, which starts after it.
// Ints rather than values because a multi-value return of strings boxes each
// one on the heap, which four ints do not.
fn headerBlockScan(headBlock: string): (int, int, int, int) {
  let breaks = 0
  let clAt = 0 - 1
  let teAt = 0 - 1
  let connAt = 0 - 1
  let i = 0
  while (i < len(headBlock)) {
    let c = headBlock[i]
    // A byte above CR can be none of NUL, CR or LF, so almost every header
    // byte leaves after this one compare instead of running all four tests
    // below (#5969).
    if (c > '\r') {
      i = i + 1
      continue
    }
    if (bareControlAt(headBlock, i, c)) {
      return 0 - 1, 0 - 1, 0 - 1, 0 - 1
    }
    i = i + 1
    if (c == '\n') {
      breaks = breaks + 1
      let (cl, te, conn) = framingLinesAt(headBlock, i, clAt, teAt, connAt)
      clAt = cl
      teAt = te
      connAt = conn
    }
  }
  return breaks, clAt, teAt, connAt
}

// `clAt`, `teAt` and `connAt` with the line starting at `at` tested for each
// field name that has not matched yet. A separate function so
// `headerBlockScan`'s loop body stays flat: an `if` nested in its LF test
// gives the loop's back edge a join the bounds-check pass (compiler/optbce.bit)
// cannot see through (#5969, #5971). One call, not three inlined tests, also
// keeps the name constants out of the byte loop, so on x86_64 the byte `c`
// stays in a register across it instead of a stack slot.
fn framingLinesAt(headBlock: string, at: int, clAt: int, teAt: int, connAt: int): (int, int, int) {
  let cl = firstLineAt(headBlock, at, clAt, "content-length")
  let te = firstLineAt(headBlock, at, teAt, "transfer-encoding")
  return cl, te, firstLineAt(headBlock, at, connAt, "connection")
}

// `found` when a `name` line was already seen (>= 0), else `at` when a `name`
// field line begins there, else -1: the first line wins, as in
// `headerLineStart` (http.bit).
fn firstLineAt(headBlock: string, at: int, found: int, name: string): int {
  if (found >= 0 || !fieldLineAt(headBlock, at, name)) {
    return found
  }
  return at
}

// True when `c`, the byte at `i`, is a NUL, an LF with no CR before it, or a
// CR with no LF after it. It is a separate function so the loop above stays
// within the complexity limit without nesting these tests: an `if` nested in
// the LF test gives the loop's back edge a join the bounds-check pass
// (compiler/optbce.bit) cannot see through, and `headBlock[i]` keeps its
// bounds check (#5969).
fn bareControlAt(headBlock: string, i: int, c: byte): bool {
  if (c == '\0') {
    return true
  }
  if (c == '\n' && (i == 0 || headBlock[i - 1] != '\r')) {
    return true
  }
  return c == '\r' && (i + 1 >= len(headBlock) || headBlock[i + 1] != '\n')
}

// Header block size cap, checked while `readMessage` is still accumulating
// the request line and headers; the body has its own budget below.
// Deny by default: nothing else stops a peer that never sends the
// terminating blank line from growing `buf` without limit while this loop
// keeps reading. 64 KiB is generous for any real request (ordinary headers
// run a few hundred bytes) and is the same order of magnitude other servers
// use as a hard ceiling (nginx's 8 KiB per line, Node's ~16 KiB total
// default).
const maxHeaderBytes = 65536

// The body a server will read off one request, in bytes, before the read is
// refused (#4565). Every `readMessage` caller passes one; this is the default
// a `Server`/`TlsServer` starts with, and `setMaxBodyBytes` (server.bit)
// raises or lowers it.
//
// Deny by default, the same way `maxHeaderBytes` does. Until this existed, a
// request declaring `Content-Length: 4294967296` had those bytes read and
// resident before any handler — or any framework limit above it, such as
// `pkg/web`'s `Config.maxBody` — could look at the request at all, so the
// limit above was a limit on what got PARSED, not on what got read.
//
// 32 MiB matches `multipart.bit`'s `defaultLimits().maxBodyBytes`, which is
// the same bound for the one body shape that already had one, and
// `std/http2`'s `h2connDefaultMaxBodyBytes` (stdlib/http2/conn.bit, #4590),
// which is this number spelled out again because `std/http` imports
// `std/http2` and the reverse import would be a cycle. Keep the three equal.
// As there, zero means "refuse every body", not "unlimited": there is no
// unlimited value, which is the point.
const defaultMaxBodyBytes = 32 * 1024 * 1024

// Reads a full HTTP message off `s`: the request line, headers, and a body
// framed per RFC 9112 §6 — `Content-Length` bytes read exactly (truncating
// anything beyond, e.g. a pipelined next request), `Transfer-Encoding: chunked`
// decoded, and no framing header meaning no body, whatever bytes happened to
// already be sitting in the read buffer. Fails — the caller answers 400 — on a
// message declaring both `Content-Length` and `Transfer-Encoding`, an
// unparsable `Content-Length`, an unsupported transfer coding, a malformed
// chunk stream, a bare CR/LF/NUL inside the header block (RFC 9110 §5.5 —
// left unrejected, that is a response-header-injection primitive for any
// handler that reflects a header value), a header block over
// `maxHeaderBytes`, or a body over `maxBodyBytes` — the last refused on the
// declared Content-Length, or on the running total of chunk sizes, before the
// bytes are read (#4565). An empty method/path/headers/body `Request` (no failure)
// means the peer closed before a complete header block arrived; the caller's
// subsequent write will simply fail against the already-closed socket.
// Reads through the blank line that ends a message's headers. Returns the
// buffer read so far — the header block, its terminating CRLFCRLF, and
// whatever body or pipelined bytes already arrived with it — together with the
// offset of that first CRLFCRLF, so `readMessage` slices at it without
// searching the same bytes again (#5898). ("", -1) means the peer went away
// before the headers were complete, and nothing else can return it — every
// other return has a four-byte terminator in the buffer. Split out of
// `readMessage` (#2448). The pair costs no allocation where the ABI returns a
// fallible tuple in words (runtime/ABI.md §1.2.2: aarch64-macos,
// aarch64-linux, x86_64-linux); x86_64-windows boxes it, as it boxes every
// tuple.
//
// The common case is a block that arrives whole in the first read: that chunk
// is returned as it is, searched once, with no Builder, no copy and no
// concatenation. Only a block split across reads accumulates.
fn readThroughHeaderEnd(s: byteStream): (string, int)! {
  let delim = "\r\n\r\n"
  let first = s.readUp(4096)?
  if (len(first) == 0) {
    return "", -1
  }
  let at = indexOf(first, delim)
  if (at >= 0) {
    return first, at
  }
  let acc = Builder()
  acc.write(first)
  let n = len(first)
  let tail = lastBytes(first, len(delim) - 1)
  // Same cap as before: the loop is left, and the message below raised, once
  // the accumulated block passes `maxHeaderBytes` with no terminator in it.
  // A terminator that arrives in the chunk which crosses the cap is still
  // accepted, exactly as the pre-#4028 `indexOf`-first loop accepted it.
  while (n <= maxHeaderBytes) {
    let chunk = s.readUp(4096)?
    if (len(chunk) == 0) {
      return "", -1
    }
    let hit = delimIndex(n, tail, chunk, delim)
    acc.write(chunk)
    n = n + len(chunk)
    if (hit >= 0) {
      return acc.toString(), hit
    }
    tail = lastBytes(tail + chunk, len(delim) - 1)
  }
  fail newError("readMessage: header block exceeds ${maxHeaderBytes} bytes")
}

// Reads the remaining `cl - len(initial)` bytes of a Content-Length-framed
// request body onto `initial`. Unlike the response-side twin
// (`readContentLengthBody`, client.bit), a peer closing early is tolerated
// (`break`, not `fail`) — request framing has always been lenient here.
// Split out of `readMessage` (#2448).
// Bytes past `cl` are not this body — on a persistent connection they are the
// start of the NEXT pipelined request — so they go back onto `s` via
// `unread` (#5419) rather than being dropped, exactly as the excess in
// `initial` already is below.
fn readRequestContentLengthBody(s: byteStream, initial: string, cl: int): string! {
  if (len(initial) >= cl) {
    if (len(initial) > cl) {
      s.unread(initial[cl:len(initial)])
    }
    return initial[0:cl]
  }
  let body = Builder()
  body.write(initial)
  let have = len(initial)
  while (have < cl) {
    let chunk = s.readUp(4096)?
    if (len(chunk) == 0) {
      break
    }
    // Truncate the OVERSHOOTING CHUNK rather than the accumulated body, which
    // is the same `cl` bytes kept and the same excess dropped, without
    // re-slicing everything read so far on every read.
    if (have + len(chunk) > cl) {
      s.unread(chunk[cl - have:len(chunk)])
      chunk = chunk[0:cl - have]
    }
    body.write(chunk)
    have = have + len(chunk)
  }
  return body.toString()
}

// The next `name` field line after the one that begins at `at` in `block`, as
// a byte index, or -1. `headerLineStart` (http.bit) finds only the first.
fn nextFieldLine(block: string, at: int, name: string): int {
  let nl = indexOfFrom(block, "\r\n", at)
  if (nl < 0) {
    return 0 - 1
  }
  let rest = headerLineStart(block[nl + 2:len(block)], name)
  if (rest < 0) {
    return 0 - 1
  }
  return nl + 2 + rest
}

// RFC 9112 §6.3 item 5: every `Content-Length` field of `block`, the first at
// `clAt`, must be a plain decimal count and all must agree. A message whose
// fields differ ("Content-Length: 5" then "Content-Length: 50") has no framing
// the two ends can share, which is the request/response-smuggling primitive:
// whichever field a proxy honours, the next hop reads the other. `who` prefixes
// the error. Each pass moves to a later line, so at most `len(block)` run.
fn checkLengthFields(block: string, clAt: int, who: string): ()! {
  let first = fieldValue(block, clAt, "content-length")
  if (!isDecimalCount(first)) {
    fail newError("${who}: invalid Content-Length")
  }
  let at = nextFieldLine(block, clAt, "content-length")
  let seen = 0
  while (at >= 0 && seen < len(block)) {
    seen = seen + 1
    if (fieldValue(block, at, "content-length") != first) {
      fail newError("${who}: conflicting Content-Length fields")
    }
    at = nextFieldLine(block, at, "content-length")
  }
}

// The framing check every HTTP/1.1 reader runs on a head before it reads a
// body (RFC 9112 §6.3): `clAt` and `teAt` are where the first Content-Length
// and Transfer-Encoding field lines begin in `block`, -1 when absent. A
// Content-Length together with a Transfer-Encoding, whatever either one's
// value (an empty one is still a field), a repeated Transfer-Encoding, and
// Content-Length fields that differ or are not plain digits are each a hard
// error, never a choice: a connection that was ever reused after one would
// carry a smuggled message. A message with neither field passes.
fn checkFramingAt(block: string, clAt: int, teAt: int, who: string): ()! {
  if (clAt >= 0 && teAt >= 0) {
    fail newError("${who}: Content-Length and Transfer-Encoding both present")
  }
  if (teAt >= 0 && nextFieldLine(block, teAt, "transfer-encoding") >= 0) {
    fail newError("${who}: more than one Transfer-Encoding field")
  }
  if (teAt >= 0 && len(fieldValue(block, teAt, "transfer-encoding")) == 0) {
    fail newError("${who}: unsupported Transfer-Encoding")
  }
  if (clAt >= 0) {
    checkLengthFields(block, clAt, who)?
  }
}

// `checkFramingAt` for a block no scan has indexed yet (the client side).
fn checkFraming(block: string, who: string): ()! {
  checkFramingAt(
    block,
    headerLineStart(block, "content-length"),
    headerLineStart(block, "transfer-encoding"),
    who,
  )?
}

// Frame the body per RFC 9112 §6. Content-Length and Transfer-Encoding
// together is a request-smuggling-grade ambiguity — reject outright rather
// than pick one. Chunked is decoded, never handed through as raw framing.
// Neither header present means no body, regardless of what already arrived.
// `clText`/`teText` are the two fields' values as `header()` returns them
// (`headerBlockScan`, #5970). Split out of `readMessage` (#2448).
fn readRequestBody(
  s: byteStream,
  bodyStart: string,
  clText: string,
  teText: string,
  maxBodyBytes: int,
): string! {
  let hasCl = len(clText) > 0
  let hasTe = len(teText) > 0
  if (hasCl && hasTe) {
    fail newError("readMessage: Content-Length and Transfer-Encoding both present")
  }
  if (hasTe) {
    if (toLower(teText) != "chunked") {
      fail newError("readMessage: unsupported Transfer-Encoding")
    }
    return decodeChunkedBody(s, bodyStart, maxBodyBytes)?
  }
  if (hasCl) {
    let cl = atoi(clText)
    if (cl < 0) {
      fail newError("readMessage: invalid Content-Length")
    }
    // On the DECLARED length, before `readRequestContentLengthBody` allocates
    // or reads anything: the peer's own number is the whole basis of the
    // read, so refusing it here is what stops the bytes from ever becoming
    // resident. Refusing after the read would be a parse limit, not a read
    // limit.
    if (cl > maxBodyBytes) {
      fail newError("readMessage: Content-Length ${cl} exceeds ${maxBodyBytes} bytes")
    }
    return readRequestContentLengthBody(s, bodyStart, cl)?
  }
  // Neither header: no body, so every byte already in `bodyStart` belongs to
  // whatever comes next on this connection — a pipelined request, on a
  // persistent connection (#5419). Push it back rather than drop it.
  if (len(bodyStart) > 0) {
    s.unread(bodyStart)
  }
  return ""
}

// The request line's method as the literal with the same bytes when it is one
// of the common ones, else `m` itself (#5945). A literal's header is static,
// so storing it into `Request.method` allocates nothing, where the substring
// `readMessage` sliced it as needs a fresh 24-byte header (#5937). Exact `==`,
// no case folding: methods are case-sensitive (RFC 9110 §9.1), so "get" stays
// "get".
fn canonMethod(m: string): string {
  if (m == "GET") {
    return "GET"
  }
  if (m == "POST") {
    return "POST"
  }
  if (m == "PUT") {
    return "PUT"
  }
  if (m == "DELETE") {
    return "DELETE"
  }
  if (m == "HEAD") {
    return "HEAD"
  }
  if (m == "PATCH") {
    return "PATCH"
  }
  if (m == "OPTIONS") {
    return "OPTIONS"
  }
  return m
}

// `canonMethod` for the request line's version token.
fn canonVersion(v: string): string {
  if (v == "HTTP/1.1") {
    return "HTTP/1.1"
  }
  if (v == "HTTP/1.0") {
    return "HTTP/1.0"
  }
  return v
}

// `checkFramingAt` for the request `readMessage` is reading off `s`: a refusal
// clears the idle deadline the caller armed, as every other way out of
// `readMessage` does. Split out of `readMessage` to keep it under the lint
// line ceiling.
fn checkRequestFraming(s: byteStream, headBlock: string, clAt: int, teAt: int): ()! {
  checkFramingAt(headBlock, clAt, teAt, "readMessage") catch e {
    s.setIdleDeadline(0)
    fail e
  }
}

fn readMessage(s: byteStream, maxBodyBytes: int): Request! {
  // Before the first read, not after it: the address is read off the socket
  // with `getpeername`, which stops answering once the connection is torn
  // down, and a request whose peer hangs up the moment it finishes sending is
  // exactly the one an audit log wants named. `readMessage` calls `s.peer()`
  // once per request even on a keep-alive connection (#5419), but
  // `netStream`/`tlsStream` (transport.bit) cache the address on their first
  // call and answer every later one from the stored field, so `getpeername`
  // itself still runs once per connection (#5893).
  let peer = s.peer()
  let (raw, sep) = readThroughHeaderEnd(s)?
  if (len(raw) == 0) {
    // Peer closed mid-headers: return an empty request, the caller stops.
    return Request{ method = "", path = "", version = "", headers = "", body = "", peer = peer }
  }
  let headBlock = raw[0:sep]
  let bodyStart = raw[sep + 4:len(raw)]
  let (headerLines, clAt, teAt, connAt) = headerBlockScan(headBlock)
  if (headerLines < 0) {
    fail newError("readMessage: control character in header block")
  }

  // Split the request line off the top of the header block.
  let eol = indexOf(headBlock, "\r\n")
  let requestLine = headBlock
  let headers = ""
  if (eol >= 0) {
    requestLine = headBlock[0:eol]
    headers = headBlock[eol + 2:len(headBlock)]
  }
  // The method, request-target and version off the request line
  // ("GET /path HTTP/1.1"), all "" when there is no space to split on.
  // Inlined at this one call site rather than returned as a class, which cost
  // an object on every request for a value read once (#3644). `version` feeds
  // `wantsClose` (server.bit, #5419): an HTTP/1.0 request line has no third
  // token and gets "", which `wantsClose` treats the same as HTTP/1.0 —
  // close-delimited by default.
  let method = ""
  let path = ""
  let version = ""
  let sp1 = indexOf(requestLine, " ")
  if (sp1 >= 0) {
    method = canonMethod(requestLine[0:sp1])
    let afterMethod = requestLine[sp1 + 1:len(requestLine)]
    let sp2 = indexOf(afterMethod, " ")
    path = sp2 >= 0 ? afterMethod[0:sp2] : afterMethod
    if (sp2 >= 0) {
      version = canonVersion(afterMethod[sp2 + 1:len(afterMethod)])
    }
  }
  // `serveOne`'s idle deadline (server.bit, #5419) stays armed through the
  // body read, not just the wait for the header block: a request whose
  // headers complete but whose body then stalls (`readRequestContentLengthBody`,
  // `decodeChunkedBody`, both routed through `byteStream.readUp`) used to
  // hold its connection forever, since nothing else bounds that read
  // (#5912). Cleared here on both the success and the failure path, right
  // before control leaves `readMessage`, so the deadline never stays armed
  // into `serializeResponseInto`'s write or a reused connection's next request —
  // that boundary is what keeps this off #5419's write-path cost (measured
  // there at 3.4x: 36 371 req/s with the clear vs 10 661 req/s without, one
  // reused connection, 2000 requests, aarch64-macos). A request with no body,
  // or whose body already arrived with the headers, makes no further
  // `readUp` call, so this costs it nothing.
  //
  // The three offsets index `headBlock`, and `headers` is its suffix, so
  // `fieldValue` reads the same bytes off `headBlock` directly.
  checkRequestFraming(s, headBlock, clAt, teAt)?
  let clText = fieldValue(headBlock, clAt, "content-length")
  let teText = fieldValue(headBlock, teAt, "transfer-encoding")
  let body = readRequestBody(s, bodyStart, clText, teText, maxBodyBytes) catch e {
    s.setIdleDeadline(0)
    fail e
  }
  s.setIdleDeadline(0)
  return Request{
    method = method, path = path, version = version, headers = headers, body = body, peer = peer,
    headerLines = headerLines,
    closeAsked = wantsClose(fieldValue(headBlock, connAt, "connection"), version),
  }
}
