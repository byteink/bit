// Fixed wire bytes protect the existing codec independently of its writer (#8261).
fn tc8261Certificate(): Certificate {
  return Certificate{
    raw = [byte(0), byte(255)], tbs = []byte("T"), version = 3,
    serial = [byte(128)], sigAlgOid = "sig", sigAlgParams = []byte(0),
    issuer = "issuer", subject = "subject",
    notBefore = -9223372036854775807 - 1, notAfter = 9223372036854775807,
    pubKeyAlg = 2, pubKeyBytes = []byte("key"), ecCurveOid = "curve",
    signature = []byte("signed"), dnsNames = ["a", ""],
    ipAddresses = [[byte(127), byte(0), byte(0), byte(1)], []byte(0)],
    isCa = true, hasBasicConstraints = false, maxPathLen = -1, hasPathLen = true,
    keyUsage = 72623859790382856, hasKeyUsage = false,
    extKeyUsageOids = []string(0), hasExtKeyUsage = true,
    subjectKeyId = []byte("ski"), authorityKeyId = []byte("aki"),
    unknownCriticalOids = ["critical"], hasNameConstraints = false,
    hasPermittedDns = true, permittedDnsNames = ["permitted"],
    excludedDnsNames = ["excluded"],
  }
}

const tc8261CertificateHex: string = ""

fn tc8261Bytes(h: string): []byte {
  return decodeHex(h) catch e {
    assert(false, e.message())
    return []byte(0)
  }
}

fn tc8261Rejects(b: []byte): bool {
  let _ = tcDecodeCertificates(b) catch _ {
    return true
  }
  return false
}

test "trustcache scalar encoding keeps its exact big-endian bytes (#8261)" {
  let wr = tcWriter{ buf = []byte(0), pos = 0 }
  tcPutU32(wr, 16909060)
  tcPutU32(wr, 4294967295)
  tcPutI64(wr, -9223372036854775807 - 1)
  tcPutI64(wr, 9223372036854775807)
  tcPutI64(wr, -1)
  tcPutI64(wr, 0)
  tcPutBool(wr, false)
  tcPutBool(wr, true)
  assert(
    tcBytesEqual(
      wr.buf[0:wr.pos],
      tc8261Bytes("01020304ffffffff80000000000000007fffffffffffffffffffffffffffffff00000000000000000001"),
    ),
  )
}

test "trustcache empty and all-field roots keep the exact wire format (#8261)" {
  assert(tcBytesEqual(tcEncodeCertificates([]Certificate(0)), tc8261Bytes("00000000")))
  let cert = tc8261Certificate()
  let one = tcEncodeCertificates([cert])
  let want = tc8261Bytes("00000001" + tc8261CertificateHex)
  assert(tcBytesEqual(one, want), "all-field wire bytes changed")
  let pair = tcEncodeCertificates([cert, cert])
  assert(tcBytesEqual(pair, tc8261Bytes("00000002" + tc8261CertificateHex + tc8261CertificateHex)))
  let decoded = tcDecodeCertificates(pair) catch e {
    assert(false, e.message())
    return
  }
  assert(len(decoded) == 2)
  assert(tcBytesEqual(tcEncodeCertificates(decoded), pair))
  assert(tcBytesEqual(cert.raw, [byte(0), byte(255)]), "encoding changed the source bytes")
  assert(len(cert.dnsNames) == 2 && cert.dnsNames[0] == "a" && cert.dnsNames[1] == "")
  assert(len(cert.ipAddresses[0]) == 4 && len(cert.ipAddresses[1]) == 0)
}

test "trustcache reserve preserves prefixes and grows geometrically (#8261)" {
  let wr = tcWriter{ buf = []byte(8), pos = 0 }
  let original = wr.buf
  tcPutU32(wr, 16909060)
  tcPutU32(wr, 84281096)
  assert(len(wr.buf) == 8 && wr.pos == 8)
  tcPutBool(wr, true)
  assert(len(wr.buf) == 16 && wr.pos == 9)
  assert(len(original) == 8 && tcBytesEqual(original, tc8261Bytes("0102030405060708")))
  let prefix = wr.buf[0:wr.pos]
  let payload = []byte(repeat("z", 4097))
  tcPutBytes(wr, payload)
  assert(wr.pos == 4110 && len(wr.buf) == 4110)
  assert(len(prefix) == 9 && tcBytesEqual(prefix, tc8261Bytes("010203040506070801")))
  assert(tcBytesEqual(wr.buf[13:wr.pos], payload), "bulk payload bytes changed")
  assert(len(payload) == 4097 && payload[0] == byte(122) && payload[4096] == byte(122))
  tcReserve(wr, 1)
  assert(len(wr.buf) == 8220 && wr.pos == 4110)
}

test "trustcache rejects every truncated all-field encoding and a trailing byte (#8261)" {
  let encoded = tc8261Bytes("00000001" + tc8261CertificateHex)
  let n = 0
  while (n < len(encoded)) {
    assert(tc8261Rejects(encoded[0:n]), "accepted a ${n}-byte prefix")
    n = n + 1
  }
  assert(tc8261Rejects(tc8261Bytes("00000001" + tc8261CertificateHex + "00")))
  assert(tc8261Rejects(tc8261Bytes("0000000100000005ff")))
}

test "trustcache publishes a self-checked codec and reads the same bytes (#8261)" {
  assert(atomicLoad(ptrOf(trustCacheState)) == 0)
  let cert = tc8261Certificate()
  assert(tcTryPublish([cert]), "codec self-check rejected a valid certificate")
  assert(atomicLoad(ptrOf(trustCacheState)) == 2)
  let roots = tcRead() catch e {
    assert(false, e.message())
    return
  }
  assert(len(roots) == 1)
  assert(tcBytesEqual(tcEncodeCertificates(roots), tc8261Bytes("00000001" + tc8261CertificateHex)))
  let cfg = TlsConfig(emptyTrustStore())
  let c = Client(tls = cfg)
  assert(len(c.tls.roots.roots) == 0, "explicit roots used the default cache")
}

test "trustcache refuses an oversized codec before publication and can retry (#8261)" {
  let cert = tc8261Certificate()
  cert.raw = []byte(trustCacheCap)
  assert(!tcTryPublish([cert]))
  assert(atomicLoad(ptrOf(trustCacheState)) == 0 && trustCacheLen == 0)
  assert(trustCacheBuf[0] == 0 && trustCacheBuf[trustCacheCap - 1] == 0)
  assert(tcTryPublish([tc8261Certificate()]), "oversize refusal prevented a later publication")
}

test "testpanic_trustcache reserve rejects negative lengths (#8261)" {
  tcReserve(tcWriter{ buf = []byte(0), pos = 0 }, -1)
}

test "testpanic_trustcache reserve rejects integer overflow (#8261)" {
  tcReserve(tcWriter{ buf = []byte(1), pos = 1 }, 9223372036854775807)
}

test "testpanic_trustcache reserve rejects an invalid cursor (#8261)" {
  tcReserve(tcWriter{ buf = []byte(1), pos = 2 }, 0)
}
