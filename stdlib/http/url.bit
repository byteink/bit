// Bit standard library — http module: URL parsing.
//
// Split out of client.bit (#4632), which had reached E0200's 800-line ceiling
// with 24 lines to spare. `Url` and the parser that produces it are one idea
// and the only part of client.bit that is not about sending a request or
// reading a response. Both files are the same module (SPEC §19), so nothing
// crosses the boundary: no import, no export, no name change.
// A parsed http://, https:// or https+h3:// URL. Port defaults to 80 (http) or
// 443 (https), path to "/". `https` selects the TLS transport; `h3` selects the
// HTTP/3 (QUIC) transport — an opt-in `https+h3://` scheme, never inferred.
class Url { host: string, port: int, path: string, https: bool, h3: bool }

// The index of the first byte in `s` forbidden in a URL host or path
// component — any ASCII control character (0x00-0x1F, 0x7F DEL) or a space
// (0x20) — or -1 if none. Left unrejected, a CR or LF here reaches the
// request line (or the Host header) unescaped and splits it into extra
// header lines or a whole second smuggled request (#2297 — the request-side
// twin of #2169's response-header injection via a raw LF in a header value);
// a bare space silently truncates the request-target at the HTTP version
// token. `percentEncode` (#2177) escapes a query VALUE before it is
// interpolated into a URL a caller is building — it is not applied here,
// because this function validates a URL the caller has already assembled;
// auto-rewriting it after the fact would silently alter a URL the caller
// believes is exact. So this stays a hard reject, not a silent rewrite.
fn firstForbiddenUrlByte(s: string): int {
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c <= ' ' || c == 127) {
      return i
    }
    i = i + 1
  }
  return 0 - 1
}

// A short, human-readable name for a byte `firstForbiddenUrlByte` flagged, for
// the error message.
fn forbiddenUrlByteName(c: byte): string {
  if (c == '\r') {
    return "CR"
  }
  if (c == '\n') {
    return "LF"
  }
  if (c == ' ') {
    return "space"
  }
  if (c == '\0') {
    return "NUL"
  }
  return "control byte ${itoa(i64(c))}"
}

// A URL port: decimal digits only, 0 to 65535. Empty is rejected, so a
// trailing "host:" fails loudly rather than silently meaning the scheme default.
fn parsePortText(text: string, url: string): int! {
  let p = atoi(text)
  if (p < 0 || p > 65535) {
    fail newError("bad port in ${url}")
  }
  return p
}

// The host and port of a URL's authority. `host` is the bare address: no
// brackets around an IPv6 literal, which is what `dial` and the resolver take.
// `hostForAuthority` puts the brackets back for anything written on the wire.
class Authority { host: string, port: int }

// True when `part` is 1 to 4 hex digits (either case).
fn isHexGroup(part: string): bool {
  if (len(part) == 0 || len(part) > 4) {
    return false
  }
  let i = 0
  while (i < len(part)) {
    let c = part[i]
    let digit = c >= '0' && c <= '9'
    let lower = c >= 'a' && c <= 'f'
    let upper = c >= 'A' && c <= 'F'
    if (!digit && !lower && !upper) {
      return false
    }
    i = i + 1
  }
  return true
}

// True when `part` is a decimal octet, 0 to 255, with no leading zero (RFC 3986
// dec-octet).
fn isDecOctet(part: string): bool {
  if (len(part) > 1 && part[0] == '0') {
    return false
  }
  if (len(part) > 3) {
    return false
  }
  let v = atoi(part)
  return v >= 0 && v <= 255
}

// True when `s` is a dotted quad of four decimal octets.
fn isIpv4Quad(s: string): bool {
  let parts = split(s, ".")
  if (len(parts) != 4) {
    return false
  }
  let i = 0
  while (i < 4) {
    if (!isDecOctet(parts[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

// How many 16-bit groups the colon-separated `part` holds, or -1 when it is not
// valid. The empty string holds none. A dotted-quad last group counts as two,
// and only when `tail` says `part` ends the address (RFC 4291 section 2.2 item 3).
fn ipv6GroupCount(part: string, tail: bool): int {
  if (len(part) == 0) {
    return 0
  }
  let groups = split(part, ":")
  let n = 0
  let i = 0
  while (i < len(groups)) {
    if (tail && i == len(groups) - 1 && indexOf(groups[i], ".") >= 0) {
      if (!isIpv4Quad(groups[i])) {
        return 0 - 1
      }
      n = n + 2
    } else if (isHexGroup(groups[i])) {
      n = n + 1
    } else {
      return 0 - 1
    }
    i = i + 1
  }
  return n
}

// True when `s` is an IPv6 address in RFC 4291 text form: eight groups, or
// fewer with one "::" standing for one or more zero groups, optionally ending in
// an IPv4 dotted quad ("::ffff:192.0.2.1"). No zone id.
fn isIpv6Literal(s: string): bool {
  let dc = indexOf(s, "::")
  if (dc < 0) {
    return ipv6GroupCount(s, true) == 8
  }
  let after = s[dc + 2:len(s)]
  if (indexOf(after, "::") >= 0) {
    return false
  }
  let head = ipv6GroupCount(s[0:dc], false)
  let rest = ipv6GroupCount(after, true)
  return head >= 0 && rest >= 0 && head + rest <= 7
}

// The authority of a `[v6]` or `[v6]:port` URL (RFC 3986 section 3.2.2). A
// missing `]`, an empty or malformed literal, a zone id and anything after the
// `]` that is not `:port` all fail.
fn parseBracketAuthority(authority: string, defaultPort: int, url: string): Authority! {
  let end = indexOf(authority, "]")
  if (end < 0) {
    fail newError("unterminated [ in host of ${url}")
  }
  let lit = authority[1:end]
  if (len(lit) == 0) {
    fail newError("empty IPv6 literal in ${url}")
  }
  if (indexOf(lit, "%") >= 0) {
    fail newError("zone id in IPv6 host of ${url} is not supported")
  }
  if (!isIpv6Literal(lit)) {
    fail newError("bad IPv6 literal in ${url}")
  }
  let after = authority[end + 1:len(authority)]
  if (len(after) == 0) {
    return Authority{ host = lit, port = defaultPort }
  }
  if (after[0] != ':') {
    fail newError("bad text after ] in host of ${url}")
  }
  let p = parsePortText(after[1:len(after)], url)?
  return Authority{ host = lit, port = p }
}

// Split host from an optional :port, which overrides the scheme default.
fn parseAuthority(authority: string, defaultPort: int, url: string): Authority! {
  if (hasPrefix(authority, "[")) {
    return parseBracketAuthority(authority, defaultPort, url)?
  }
  let host = authority
  let port = defaultPort
  let colon = indexOf(authority, ":")
  if (colon >= 0) {
    host = authority[0:colon]
    port = parsePortText(authority[colon + 1:len(authority)], url)?
  }
  if (indexOf(host, "[") >= 0 || indexOf(host, "]") >= 0) {
    fail newError("bad bracket in host of ${url}")
  }
  return Authority{ host = host, port = port }
}

// `host` as it is written in a Host header, an HTTP/2 `:authority` or a rebuilt
// URL: an IPv6 literal gets its brackets back (RFC 9110 section 7.2).
fn hostForAuthority(host: string): string {
  if (indexOf(host, ":") >= 0) {
    return "[${host}]"
  }
  return host
}

fn parseUrl(url: string): Url! {
  let rest = url
  let https = false
  let h3 = false
  let port = 80
  let lower = toLower(rest)
  if (hasPrefix(lower, "https+h3://")) {
    https = true
    h3 = true
    port = 443
    rest = rest[11:len(rest)]
  } else if (hasPrefix(lower, "https://")) {
    https = true
    port = 443
    rest = rest[8:len(rest)]
  } else if (hasPrefix(lower, "http://")) {
    rest = rest[7:len(rest)]
  }
  // Split authority from path at the first '/'.
  let slash = indexOf(rest, "/")
  let authority = rest
  let path = "/"
  if (slash >= 0) {
    authority = rest[0:slash]
    path = rest[slash:len(rest)]
  }
  let a = parseAuthority(authority, port, url)?
  let host = a.host
  port = a.port
  if (len(host) == 0) {
    fail newError("no host in ${url}")
  }
  let hostBad = firstForbiddenUrlByte(host)
  if (hostBad >= 0) {
    fail newError("bad character (${forbiddenUrlByteName(host[hostBad])}) in host of ${url}")
  }
  let pathBad = firstForbiddenUrlByte(path)
  if (pathBad >= 0) {
    fail newError("bad character (${forbiddenUrlByteName(path[pathBad])}) in path of ${url}")
  }
  return Url{ host = host, port = port, path = path, https = https, h3 = h3 }
}
