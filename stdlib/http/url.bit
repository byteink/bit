// Bit standard library — http module: URL parsing.
//
// Split out of client.bit (#4632), which had reached E0200's 800-line ceiling
// with 24 lines to spare. `Url` and the parser that produces it are one idea
// and the only part of client.bit that is not about sending a request or
// reading a response. Both files are the same module (SPEC §19), so nothing
// crosses the boundary: no import, no export, no name change.
// A parsed http://, https:// or https+h3:// URL. Port defaults to 80 (http) or
// 443 (https), path to "/". `https` selects the TLS transport; `h3` selects the
// HTTP/3 (QUIC) transport — an opt-in `https+h3://` scheme, never inferred.
class Url { host: string, port: int, path: string, https: bool, h3: bool }

// The index of the first byte in `s` forbidden in a URL host or path
// component — any ASCII control character (0x00-0x1F, 0x7F DEL) or a space
// (0x20) — or -1 if none. Left unrejected, a CR or LF here reaches the
// request line (or the Host header) unescaped and splits it into extra
// header lines or a whole second smuggled request (#2297 — the request-side
// twin of #2169's response-header injection via a raw LF in a header value);
// a bare space silently truncates the request-target at the HTTP version
// token. `percentEncode` (#2177) escapes a query VALUE before it is
// interpolated into a URL a caller is building — it is not applied here,
// because this function validates a URL the caller has already assembled;
// auto-rewriting it after the fact would silently alter a URL the caller
// believes is exact. So this stays a hard reject, not a silent rewrite.
fn firstForbiddenUrlByte(s: string): int {
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c <= ' ' || c == 127) {
      return i
    }
    i = i + 1
  }
  return 0 - 1
}

// A short, human-readable name for a byte `firstForbiddenUrlByte` flagged, for
// the error message.
fn forbiddenUrlByteName(c: byte): string {
  if (c == '\r') {
    return "CR"
  }
  if (c == '\n') {
    return "LF"
  }
  if (c == ' ') {
    return "space"
  }
  if (c == '\0') {
    return "NUL"
  }
  return "control byte ${itoa(i64(c))}"
}

fn parseUrl(url: string): Url! {
  let rest = url
  let https = false
  let h3 = false
  let port = 80
  let lower = toLower(rest)
  if (hasPrefix(lower, "https+h3://")) {
    https = true
    h3 = true
    port = 443
    rest = rest[11:len(rest)]
  } else if (hasPrefix(lower, "https://")) {
    https = true
    port = 443
    rest = rest[8:len(rest)]
  } else if (hasPrefix(lower, "http://")) {
    rest = rest[7:len(rest)]
  }
  // Split authority from path at the first '/'.
  let slash = indexOf(rest, "/")
  let authority = rest
  let path = "/"
  if (slash >= 0) {
    authority = rest[0:slash]
    path = rest[slash:len(rest)]
  }
  // Split host from an optional :port, which overrides the scheme default.
  let host = authority
  let colon = indexOf(authority, ":")
  if (colon >= 0) {
    host = authority[0:colon]
    let p = atoi(authority[colon + 1:len(authority)])
    if (p < 0) {
      fail newError("bad port in ${url}")
    }
    port = p
  }
  if (len(host) == 0) {
    fail newError("no host in ${url}")
  }
  let hostBad = firstForbiddenUrlByte(host)
  if (hostBad >= 0) {
    fail newError("bad character (${forbiddenUrlByteName(host[hostBad])}) in host of ${url}")
  }
  let pathBad = firstForbiddenUrlByte(path)
  if (pathBad >= 0) {
    fail newError("bad character (${forbiddenUrlByteName(path[pathBad])}) in path of ${url}")
  }
  return Url{ host: host, port: port, path: path, https: https, h3: h3 }
}
