// stdlib/http/idleshutdown.test.bit — `Server.shutdown` against a connection
// parked on keep-alive between requests (#6815).
//
// Package-level calls keep their connection open in the shared default pool
// (#6482), so a server routinely meets shutdown with a peer that has had its
// response and is waiting to send the next request. Such a connection has
// nothing in flight: shutdown must close it at once and report no error, as
// Go's `Server.Shutdown` does, not wait out `timeoutMs` and then count it as a
// force-closed in-flight request. `startServer`/`newRespReader`
// (keepalive.test.bit) and `monotonic`/`since`/`Millisecond` are module
// siblings, so nothing is imported here.

test "shutdown closes a connection idling on keep-alive at once and reports no error" {
  let (s, port) = startServer() catch e {
    assert(false, "startServer: ${e.message()}")
    return
  }
  let conn = dial("127.0.0.1", port) catch e {
    s.close()
    assert(false, "dial: ${e.message()}")
    return
  }
  let reader = newRespReader(conn)
  conn.write("GET /a HTTP/1.1\r\nHost: x\r\n\r\n") catch e {
    s.close()
    assert(false, "write: ${e.message()}")
    return
  }
  let res = reader.next() catch e {
    s.close()
    assert(false, "response: ${e.message()}")
    return
  }
  assert(indexOf(res, "200") >= 0, "first response was not a 200:\n${res}")

  let t0 = monotonic()
  let msg = ""
  s.shutdown(5000) catch e {
    msg = e.message()
  }
  let elapsedMs = since(t0) / Millisecond
  assert(len(msg) == 0, "shutdown reported an error for an idle keep-alive: ${msg}")
  assert(elapsedMs < 2000, "shutdown took ${elapsedMs}ms with only an idle keep-alive open")

  let tail = conn.read(4096) catch _ {
    ""
  }
  assert(len(tail) == 0, "the idle connection was not closed by shutdown: ${tail}")
}
