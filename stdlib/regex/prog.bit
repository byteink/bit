// Bit standard library — regex module, the instruction set and the AST ->
// program compiler.
//
// Eight opcodes, standard Thompson construction (Ken Thompson's 1968
// technique, the one RE2/Go's `regexp` and every other non-backtracking
// engine builds on): every `Ast` node becomes a small, fixed instruction
// shape, concatenated into one flat `[]Inst`. Two are "real" work — `Char`
// and `Class` test the current rune, `Any` tests it against `\n` — and
// `Match` ends a successful thread; the rest (`Split`, `Jump`, `Save`,
// `Assert`) are epsilon transitions the VM (pike.bit) resolves without
// consuming input. Nothing here is exported: `Regex` (regex.bit) is this
// ticket's only public surface, and `Prog` is an implementation detail baked
// into `Regex` once at `compile` time.
//
// `x`/`y` on `Split` are two absolute program-counter targets, tried in that
// order — `x` first — which is what makes alternation and the greedy/lazy
// quantifiers resolve Perl-preference ("leftmost-first") rather than
// leftmost-longest (pike.bit's closure walk pushes `y` before `x`, so `x`
// pops first). `Jump` reuses `x` alone as its one target. `Save` and
// `Assert` are not exercised by `Regex.matches` (a boolean predicate never
// needs a capture position), but the compiler always emits them for every
// group and anchor — the instruction set already supports #2029's capture
// slots; only the VM's thread representation stays capture-free until then.

// The eight instruction kinds a compiled program is built from.
enum Op { Char, Class, Any, Split, Jump, Save, Assert, Match }

// One instruction. Every field is meaningful only for the op(s) named:
// `ch` (Char), `cls` (Class), `x`/`y` (Split's two targets, or `x` alone for
// Jump), `slot` (Save), `kind` (Assert). The rest carry a harmless default —
// a class field can never be omitted (E0083), so every constructor below
// fills all seven.
class Inst { op: Op, ch: rune, cls: CharClass, x: int, y: int, slot: int, kind: AnchorKind }

// A compiled program: `insts[0]` is always a `Save slot=0` and the program
// always ends `Save slot=1; Match` — group 0 wraps the whole pattern, so
// `numSlots == 2 * (numGroups + 1)` (one open/close pair per group, plus the
// implicit whole-match group 0).
class Prog { insts: []Inst, numSlots: int, numGroups: int }

// --- instruction constructors ----------------------------------------------
//
// Each builds the one `Inst` shape its name promises; the fields that op
// does not use carry a harmless zero/empty default (a class field can never
// be omitted, E0083). `x`/`y` on `Split`/`Jump` are always 0 here —
// backpatched by the caller once the target address is known, once the
// arm/body the instruction precedes has been laid down.

fn instChar(r: rune): Inst {
  return Inst{ op: Op.Char, ch: r, cls: ccEmpty(), x: 0, y: 0, slot: 0, kind: AnchorKind.BeginText }
}

fn instClass(cc: CharClass): Inst {
  return Inst{ op: Op.Class, ch: rune(0), cls: cc, x: 0, y: 0, slot: 0, kind: AnchorKind.BeginText }
}

fn instAny(): Inst {
  return Inst{ op: Op.Any, ch: rune(0), cls: ccEmpty(), x: 0, y: 0, slot: 0, kind: AnchorKind.BeginText }
}

fn instSplit(): Inst {
  return Inst{ op: Op.Split, ch: rune(0), cls: ccEmpty(), x: 0, y: 0, slot: 0, kind: AnchorKind.BeginText }
}

fn instJump(): Inst {
  return Inst{ op: Op.Jump, ch: rune(0), cls: ccEmpty(), x: 0, y: 0, slot: 0, kind: AnchorKind.BeginText }
}

fn instSave(slot: int): Inst {
  return Inst{ op: Op.Save, ch: rune(0), cls: ccEmpty(), x: 0, y: 0, slot: slot, kind: AnchorKind.BeginText }
}

fn instAssert(kind: AnchorKind): Inst {
  return Inst{ op: Op.Assert, ch: rune(0), cls: ccEmpty(), x: 0, y: 0, slot: 0, kind: kind }
}

fn instMatch(): Inst {
  return Inst{ op: Op.Match, ch: rune(0), cls: ccEmpty(), x: 0, y: 0, slot: 0, kind: AnchorKind.BeginText }
}

// --- AST -> program ---------------------------------------------------------

// Compiles `ast` into a full `Prog`: `Save 0`, the pattern's own
// instructions, `Save 1`, `Match` — group 0 wrapping the whole thing, per
// `Prog`'s own doc comment above.
fn compileProg(ast: Ast, numGroups: int): Prog {
  let insts: []Inst = []Inst(0)
  insts = append(insts, instSave(0))
  insts = compileAst(ast, insts)
  insts = append(insts, instSave(1))
  insts = append(insts, instMatch())
  return Prog{ insts: insts, numSlots: 2 * (numGroups + 1), numGroups: numGroups }
}

// Appends `ast`'s instructions to `out` and returns the extended slice.
// Every AST node compiles to a self-contained run of instructions that
// falls through to `len(out)` (the next thing appended) on every path that
// does not jump elsewhere on purpose — so concatenation is just "compile the
// next node into the same `out`", with no separate linking step. A
// statement-form `match` (rather than `return match(...) {...}`) so each
// leaf arm can reassign `out` before returning it — `append` may or may not
// grow into a new backing array, and the reassignment is what keeps that
// safe (E0214).
fn compileAst(ast: Ast, out: []Inst): []Inst {
  match (ast) {
    Empty => return out
    Literal(r) => {
      out = append(out, instChar(r))
      return out
    }
    Class(cc) => {
      out = append(out, instClass(cc))
      return out
    }
    AnyChar => {
      out = append(out, instAny())
      return out
    }
    Anchor(kind) => {
      out = append(out, instAssert(kind))
      return out
    }
    Concat(items) => return compileConcat(items, out)
    Alternate(items) => return compileAlternate(items, out)
    Repeat(node) => return compileRepeat(node, out)
    Group(node) => return compileGroup(node, out)
  }
}

fn compileConcat(items: []Ast, out: []Inst): []Inst {
  let i = 0
  // Bounded by `items`'s length, fixed before the loop starts.
  while (i < len(items)) {
    out = compileAst(items[i], out)
    i = i + 1
  }
  return out
}

// Non-capturing groups (`node.index == 0`, `(?:...)`) compile to just their
// body; a capturing group wraps it in the `Save` pair that records the
// group's start/end slots (#2029 reads these; `Regex.matches` does not).
fn compileGroup(node: GroupNode, out: []Inst): []Inst {
  if (node.index == 0) {
    return compileAst(node.sub, out)
  }
  out = append(out, instSave(2 * node.index))
  out = compileAst(node.sub, out)
  out = append(out, instSave(2 * node.index + 1))
  return out
}

// `items[0] | items[1] | ... | items[n-1]`, an N-way chain of `Split`s
// (`ast.bit`'s `Alternate` is flat, not nested pairs, so this handles the
// general case directly): each non-last branch gets a `Split` trying it
// before falling through to try the rest, and ends with a `Jump` past every
// other branch to the shared exit; the last branch needs neither, since
// falling off its end already reaches the exit.
fn compileAlternate(items: []Ast, out: []Inst): []Inst {
  let jumpIdxs = []int(0)
  let i = 0
  // Bounded: each iteration compiles one non-last branch, consuming one
  // entry of `items`.
  while (i < len(items) - 1) {
    let splitIdx = len(out)
    out = append(out, instSplit())
    out[splitIdx].x = len(out)
    out = compileAst(items[i], out)
    let jumpIdx = len(out)
    out = append(out, instJump())
    jumpIdxs = append(jumpIdxs, jumpIdx)
    out[splitIdx].y = len(out)
    i = i + 1
  }
  out = compileAst(items[len(items) - 1], out)
  let end = len(out)
  let j = 0
  // Bounded by `jumpIdxs`'s length, fixed above.
  while (j < len(jumpIdxs)) {
    out[jumpIdxs[j]].x = end
    j = j + 1
  }
  return out
}

// Dispatches a `Repeat` node to the one of three shapes the parser can ever
// produce (`*` = min 0/max -1, `+` = min 1/max -1, `?` = min 0/max 1) —
// counted repetition (`{n,m}`) is rejected at parse time (#2031), so no
// other `(min, max)` pair can reach here; `min`/`max` are still carried on
// `RepeatNode` and honoured by name so #2031 only has to widen the parser.
fn compileRepeat(node: RepeatNode, out: []Inst): []Inst {
  if (node.min == 0 && node.max == -1) {
    return compileStar(node, out)
  }
  if (node.min == 1 && node.max == -1) {
    return compilePlus(node, out)
  }
  if (node.min == 0 && node.max == 1) {
    return compileQuest(node, out)
  }
  panic("regex: unsupported repeat bounds min=${node.min} max=${node.max}")
}

// `*`: `L: Split body, exit` (greedy: `x`=body — tried first; lazy:
// `y`=body), then the body, then `Jump L`. Zero repetitions is reaching
// `exit` straight from `L` without ever entering the body.
fn compileStar(node: RepeatNode, out: []Inst): []Inst {
  let splitIdx = len(out)
  out = append(out, instSplit())
  setPreferredArm(out, splitIdx, node.greedy, len(out))
  out = compileAst(node.sub, out)
  out = append(out, instJump())
  out[len(out) - 1].x = splitIdx
  setFallbackArm(out, splitIdx, node.greedy, len(out))
  return out
}

// `+`: the body once (mandatory), then `Split body, exit` — greedy tries
// looping back into the body again first; lazy tries the exit first.
fn compilePlus(node: RepeatNode, out: []Inst): []Inst {
  let bodyStart = len(out)
  out = compileAst(node.sub, out)
  let splitIdx = len(out)
  out = append(out, instSplit())
  setPreferredArm(out, splitIdx, node.greedy, bodyStart)
  setFallbackArm(out, splitIdx, node.greedy, len(out))
  return out
}

// `?`: a single `Split body, exit` (greedy tries the body first; lazy tries
// the exit first) with no loop-back.
fn compileQuest(node: RepeatNode, out: []Inst): []Inst {
  let splitIdx = len(out)
  out = append(out, instSplit())
  setPreferredArm(out, splitIdx, node.greedy, len(out))
  out = compileAst(node.sub, out)
  setFallbackArm(out, splitIdx, node.greedy, len(out))
  return out
}

// Points the arm a greedy quantifier tries FIRST (`x`; lazy tries it via
// `y`) at `target`. The other arm is `setFallbackArm`'s job — the two always
// come in a pair, one call bracketing the body just compiled.
fn setPreferredArm(out: []Inst, splitIdx: int, greedy: bool, target: int) {
  if (greedy) {
    out[splitIdx].x = target
  } else {
    out[splitIdx].y = target
  }
}

// The other arm of the same `Split` — greedy's fallback is `y`, lazy's is
// `x`.
fn setFallbackArm(out: []Inst, splitIdx: int, greedy: bool, target: int) {
  if (greedy) {
    out[splitIdx].y = target
  } else {
    out[splitIdx].x = target
  }
}
