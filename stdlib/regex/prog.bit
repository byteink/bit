// Bit standard library — regex module, the instruction set and the AST ->
// program compiler.
//
// Eight opcodes, standard Thompson construction (Ken Thompson's 1968
// technique, the one RE2/Go's `regexp` and every other non-backtracking
// engine builds on): every `Ast` node becomes a small, fixed instruction
// shape, concatenated into one flat `[]Inst`. Two are "real" work — `Char`
// and `Class` test the current rune, `Any` tests it against `\n` — and
// `Match` ends a successful thread; the rest (`Split`, `Jump`, `Save`,
// `Assert`) are epsilon transitions the VM (pike.bit) resolves without
// consuming input. Nothing here is exported: `Regex` (regex.bit) is this
// ticket's only public surface, and `Prog` is an implementation detail baked
// into `Regex` once at `compile` time.
//
// `x`/`y` on `Split` are two absolute program-counter targets, tried in that
// order — `x` first — which is what makes alternation and the greedy/lazy
// quantifiers resolve Perl-preference ("leftmost-first") rather than
// leftmost-longest (pike.bit's closure walk pushes `y` before `x`, so `x`
// pops first). `Jump` reuses `x` alone as its one target. `Save` and
// `Assert` are not exercised by `Regex.matches` (a boolean predicate never
// needs a capture position), but the compiler always emits them for every
// group and anchor — the instruction set already supports #2029's capture
// slots; only the VM's thread representation stays capture-free until then.
//
// COUNTED REPETITION (#2031) compiles by literal expansion — `x{3}` becomes
// three separate compiled copies of `x`'s own instructions, `x{2,4}` two
// mandatory copies plus two nested-optional ones — never a native "repeat N
// times" opcode. That is exponential in nesting (`((a{100}){100}){100}` is
// 33 source bytes and a million instructions), so `Compiler.steps` bounds
// it: `emitInst` and `chargeStep` both spend from the SAME budget,
// `progInstCap`, checked before the work happens, never after — see their
// doc comments below for why a single counter over "instructions actually
// appended" cannot, by itself, be enough.

// The nine instruction kinds a compiled program is built from. `AnyNL` is
// `(?s)`'s dotall `.` (#2030): every rune including `\n`, versus `Any`'s
// RE2/Go default of every rune except `\n` — two opcodes rather than a flag
// on `Any`, so `pike.bit`'s `instAccepts` reads the distinction off the
// instruction alone.
enum Op { Char, Class, Any, AnyNL, Split, Jump, Save, Assert, Match }

// One instruction. Every field is meaningful only for the op(s) named:
// `ch` (Char), `cls` (Class), `x`/`y` (Split's two targets, or `x` alone for
// Jump), `slot` (Save), `kind` (Assert). The rest carry a harmless default —
// a class field can never be omitted (E0083), so every constructor below
// fills all seven.
class Inst { op: Op, ch: rune, cls: CharClass, x: int, y: int, slot: int, kind: AnchorKind }

// A compiled program: `insts[0]` is always a `Save slot=0` and the program
// always ends `Save slot=1; Match` — group 0 wraps the whole pattern, so
// `numSlots == 2 * (numGroups + 1)` (one open/close pair per group, plus the
// implicit whole-match group 0).
class Prog { insts: []Inst, numSlots: int, numGroups: int }

// The total number of `Inst`s a compiled program may ever contain — checked
// DURING compilation (`emitInst`), not by building an oversized program and
// measuring `len()` afterward: that would already have done the unbounded
// allocation this cap exists to prevent.
const progInstCap: int = 20000

const errProgramTooComplex: string = "regex: pattern too complex (program exceeds 20000 instructions)"

// The compiler's mutable state, threaded through every `compile*` function
// below by reference (the same "class as a Pascal-style cursor" convention
// `RegexParser`/`pike.bit`'s `PcStack` use). `steps` is a SECOND counter,
// independent of `len(insts)`: see `chargeStep`'s doc comment for why
// `emitInst` alone cannot bound a counted-repeat's expansion loop.
class Compiler { insts: []Inst, steps: int }

fn newCompiler(): Compiler {
  return Compiler{ insts: []Inst(0), steps: 0 }
}

// Appends `inst`, failing `errProgramTooComplex` instead of growing past
// `progInstCap` — checked BEFORE the append, so the program never actually
// reaches `progInstCap + 1` instructions in memory.
fn emitInst(c: Compiler, inst: Inst): ()! {
  if (len(c.insts) >= progInstCap) {
    fail newError(errProgramTooComplex)
  }
  c.insts = append(c.insts, inst)
}

// Spends one unit of the SAME budget `emitInst` spends from, without
// appending anything — called once per copy `compileRepeatCounted`
// attempts to compile, mandatory or optional, REGARDLESS of how many (if
// any) real instructions that copy goes on to emit.
//
// `emitInst` alone cannot bound a counted-repeat's expansion loop: a
// sub-pattern that compiles to zero real instructions (a repeated
// non-capturing empty group, `(?:){1000}`) never grows `len(c.insts)` at
// all, however many times it is unrolled — nested inside ANOTHER counted
// repeat, `((?:){1000}){1000}`, the inner loop alone runs a million times,
// and a third level of nesting is a billion, all while `c.insts` stays
// empty and `emitInst`'s own check never fires. That is real, unbounded
// compile-time WORK even though the final program is trivially small — the
// Power-of-10 violation is in the loop count, not the allocation. Charging
// per attempted copy, on the same budget, bounds that work to
// `progInstCap` regardless of nesting shape, exactly like `emitInst` bounds
// the program's size.
fn chargeStep(c: Compiler): ()! {
  if (c.steps >= progInstCap) {
    fail newError(errProgramTooComplex)
  }
  c.steps = c.steps + 1
}

// --- instruction constructors ----------------------------------------------
//
// Each builds the one `Inst` shape its name promises; the fields that op
// does not use carry a harmless zero/empty default (a class field can never
// be omitted, E0083). `x`/`y` on `Split`/`Jump` are always 0 here —
// backpatched by the caller once the target address is known, once the
// arm/body the instruction precedes has been laid down.

fn instChar(r: rune): Inst {
  return Inst{ op: Op.Char, ch: r, cls: ccEmpty(), x: 0, y: 0, slot: 0, kind: AnchorKind.BeginText }
}

fn instClass(cc: CharClass): Inst {
  return Inst{ op: Op.Class, ch: rune(0), cls: cc, x: 0, y: 0, slot: 0, kind: AnchorKind.BeginText }
}

fn instAny(): Inst {
  return Inst{
    op: Op.Any,
    ch: rune(0),
    cls: ccEmpty(),
    x: 0,
    y: 0,
    slot: 0,
    kind: AnchorKind.BeginText,
  }
}

fn instAnyNL(): Inst {
  return Inst{
    op: Op.AnyNL,
    ch: rune(0),
    cls: ccEmpty(),
    x: 0,
    y: 0,
    slot: 0,
    kind: AnchorKind.BeginText,
  }
}

fn instSplit(): Inst {
  return Inst{
    op: Op.Split,
    ch: rune(0),
    cls: ccEmpty(),
    x: 0,
    y: 0,
    slot: 0,
    kind: AnchorKind.BeginText,
  }
}

fn instJump(): Inst {
  return Inst{
    op: Op.Jump,
    ch: rune(0),
    cls: ccEmpty(),
    x: 0,
    y: 0,
    slot: 0,
    kind: AnchorKind.BeginText,
  }
}

fn instSave(slot: int): Inst {
  return Inst{
    op: Op.Save,
    ch: rune(0),
    cls: ccEmpty(),
    x: 0,
    y: 0,
    slot: slot,
    kind: AnchorKind.BeginText,
  }
}

fn instAssert(kind: AnchorKind): Inst {
  return Inst{ op: Op.Assert, ch: rune(0), cls: ccEmpty(), x: 0, y: 0, slot: 0, kind: kind }
}

fn instMatch(): Inst {
  return Inst{
    op: Op.Match,
    ch: rune(0),
    cls: ccEmpty(),
    x: 0,
    y: 0,
    slot: 0,
    kind: AnchorKind.BeginText,
  }
}

// --- AST -> program ---------------------------------------------------------

// Compiles `ast` into a full `Prog`: `Save 0`, the pattern's own
// instructions, `Save 1`, `Match` — group 0 wrapping the whole thing, per
// `Prog`'s own doc comment above. Fails `errProgramTooComplex` (via
// `emitInst`/`chargeStep`, propagated up through every `compile*` call)
// instead of ever holding an oversized program in memory.
fn compileProg(ast: Ast, numGroups: int): Prog! {
  let c = newCompiler()
  emitInst(c, instSave(0))?
  compileAst(ast, c)?
  emitInst(c, instSave(1))?
  emitInst(c, instMatch())?
  return Prog{ insts: c.insts, numSlots: 2 * (numGroups + 1), numGroups: numGroups }
}

// Compiles `ast`'s instructions into `c`. Every AST node compiles to a
// self-contained run of instructions that falls through to the position
// right after it on every path that does not jump elsewhere on purpose — so
// concatenation is just "compile the next node into the same `c`", with no
// separate linking step. The four structural nodes dispatch to their own
// compiler; every leaf node (`Empty` plus the five one-instruction `Ast`
// variants) shares the `_` arm and goes to `compileLeaf` below — split out
// to keep both functions under the complexity ceiling (E0204): one extra
// leaf variant, #2030's `AnyCharNL`, was enough to push a single, unsplit
// `compileAst` over it.
fn compileAst(ast: Ast, c: Compiler): ()! {
  match (ast) {
    Concat(items) => compileConcat(items, c)?
    Alternate(items) => compileAlternate(items, c)?
    Repeat(node) => compileRepeat(node, c)?
    Group(node) => compileGroup(node, c)?
    _ => compileLeaf(ast, c)?
  }
}

// The non-structural `Ast` nodes, each a single self-contained instruction
// (or none, for `Empty`) appended via `emitInst`. The trailing `_` is
// unreachable from `compileAst` (every structural node is handled there
// first) but required for exhaustiveness; it panics rather than silently
// mishandling a node this function was never meant to see.
fn compileLeaf(ast: Ast, c: Compiler): ()! {
  match (ast) {
    Empty => {}
    Literal(r) => emitInst(c, instChar(r))?
    Class(cc) => emitInst(c, instClass(cc))?
    AnyChar => emitInst(c, instAny())?
    AnyCharNL => emitInst(c, instAnyNL())?
    Anchor(kind) => emitInst(c, instAssert(kind))?
    _ => panic("regex: internal: compileLeaf given a structural Ast node")
  }
}

fn compileConcat(items: []Ast, c: Compiler): ()! {
  let i = 0
  // Bounded by `items`'s length, fixed before the loop starts.
  while (i < len(items)) {
    compileAst(items[i], c)?
    i = i + 1
  }
}

// Non-capturing groups (`node.index == 0`, `(?:...)`) compile to just their
// body; a capturing group wraps it in the `Save` pair that records the
// group's start/end slots (#2029 reads these; `Regex.matches` does not).
fn compileGroup(node: GroupNode, c: Compiler): ()! {
  if (node.index == 0) {
    compileAst(node.sub, c)?
    return
  }
  emitInst(c, instSave(2 * node.index))?
  compileAst(node.sub, c)?
  emitInst(c, instSave(2 * node.index + 1))?
}

// `items[0] | items[1] | ... | items[n-1]`, an N-way chain of `Split`s
// (`ast.bit`'s `Alternate` is flat, not nested pairs, so this handles the
// general case directly): each non-last branch gets a `Split` trying it
// before falling through to try the rest, and ends with a `Jump` past every
// other branch to the shared exit; the last branch needs neither, since
// falling off its end already reaches the exit.
fn compileAlternate(items: []Ast, c: Compiler): ()! {
  let jumpIdxs = []int(0)
  let i = 0
  // Bounded: each iteration compiles one non-last branch, consuming one
  // entry of `items`.
  while (i < len(items) - 1) {
    let splitIdx = len(c.insts)
    emitInst(c, instSplit())?
    c.insts[splitIdx].x = len(c.insts)
    compileAst(items[i], c)?
    let jumpIdx = len(c.insts)
    emitInst(c, instJump())?
    jumpIdxs = append(jumpIdxs, jumpIdx)
    c.insts[splitIdx].y = len(c.insts)
    i = i + 1
  }
  compileAst(items[len(items) - 1], c)?
  let end = len(c.insts)
  let j = 0
  // Bounded by `jumpIdxs`'s length, fixed above.
  while (j < len(jumpIdxs)) {
    c.insts[jumpIdxs[j]].x = end
    j = j + 1
  }
}

// Dispatches a `Repeat` node. The three shapes `*`/`+`/`?` keep their own
// named compilers unchanged (byte-for-byte the same instruction shape as
// before #2031); everything else — every genuine `{n}`/`{n,}`/`{n,m}` — is
// `compileRepeatCounted`.
fn compileRepeat(node: RepeatNode, c: Compiler): ()! {
  if (node.min == 0 && node.max == -1) {
    compileStar(node, c)?
    return
  }
  if (node.min == 1 && node.max == -1) {
    compilePlus(node, c)?
    return
  }
  if (node.min == 0 && node.max == 1) {
    compileQuest(node, c)?
    return
  }
  compileRepeatCounted(node, c)?
}

// `*`: `L: Split body, exit` (greedy: `x`=body — tried first; lazy:
// `y`=body), then the body, then `Jump L`. Zero repetitions is reaching
// `exit` straight from `L` without ever entering the body.
fn compileStar(node: RepeatNode, c: Compiler): ()! {
  let splitIdx = len(c.insts)
  emitInst(c, instSplit())?
  setPreferredArm(c.insts, splitIdx, node.greedy, len(c.insts))
  compileAst(node.sub, c)?
  emitInst(c, instJump())?
  c.insts[len(c.insts) - 1].x = splitIdx
  setFallbackArm(c.insts, splitIdx, node.greedy, len(c.insts))
}

// `+`: the body once (mandatory), then `Split body, exit` — greedy tries
// looping back into the body again first; lazy tries the exit first.
fn compilePlus(node: RepeatNode, c: Compiler): ()! {
  let bodyStart = len(c.insts)
  compileAst(node.sub, c)?
  let splitIdx = len(c.insts)
  emitInst(c, instSplit())?
  setPreferredArm(c.insts, splitIdx, node.greedy, bodyStart)
  setFallbackArm(c.insts, splitIdx, node.greedy, len(c.insts))
}

// `?`: a single `Split body, exit` (greedy tries the body first; lazy tries
// the exit first) with no loop-back.
fn compileQuest(node: RepeatNode, c: Compiler): ()! {
  let splitIdx = len(c.insts)
  emitInst(c, instSplit())?
  setPreferredArm(c.insts, splitIdx, node.greedy, len(c.insts))
  compileAst(node.sub, c)?
  setFallbackArm(c.insts, splitIdx, node.greedy, len(c.insts))
}

// A genuine `{n}`/`{n,}`/`{n,m}` — the three special shapes above already
// took every `(min, max)` that isn't one of these. `min` mandatory copies of
// `node.sub`, each compiled fresh (Thompson construction has no shared
// subroutine call, so N copies really do need N separate instruction runs —
// the "expansion" #2031's ticket describes), followed by either a trailing
// Kleene star (unbounded, `max == -1` — reusing `compileStar` unchanged: it
// only reads `node.sub`/`node.greedy`, both already correct here) or
// `max - min` further copies nested as optional (`compileOptionalChain`).
// `chargeStep` is spent once per mandatory copy, for the reason its own doc
// comment gives.
fn compileRepeatCounted(node: RepeatNode, c: Compiler): ()! {
  let i = 0
  // Bounded: `node.min` was capped at parse time (parserepeat.bit's
  // `maxRepeatCount`).
  while (i < node.min) {
    chargeStep(c)?
    compileAst(node.sub, c)?
    i = i + 1
  }
  if (node.max == -1) {
    compileStar(RepeatNode{ min: 0, max: -1, greedy: node.greedy, sub: node.sub }, c)?
    return
  }
  compileOptionalChain(node, node.max - node.min, c)?
}

// `extra` further optional copies of `node.sub`, nested `(x(x...)?)?`:
// level 1's `Split` is emitted, then its body (one copy of `node.sub`) is
// compiled immediately after, then level 2's `Split`, its body, and so on —
// the same shape `compileQuest` uses for a single level, repeated `extra`
// times. Every level's FALLBACK arm — the one taken when this copy and
// every further one are skipped — targets the position after the LAST
// level's body, not just past its own: skipping any level means every level
// nested inside it is skipped too. That target is not known until the loop
// finishes, so every level's split index is recorded and backpatched
// together at the end, the same two-step shape `compileAlternate` already
// uses for its own forward jumps.
fn compileOptionalChain(node: RepeatNode, extra: int, c: Compiler): ()! {
  let splitIdxs = []int(0)
  let i = 0
  // Bounded: `extra` is `max - min`, both parse-time-capped.
  while (i < extra) {
    chargeStep(c)?
    let splitIdx = len(c.insts)
    emitInst(c, instSplit())?
    setPreferredArm(c.insts, splitIdx, node.greedy, len(c.insts))
    compileAst(node.sub, c)?
    splitIdxs = append(splitIdxs, splitIdx)
    i = i + 1
  }
  let end = len(c.insts)
  let j = 0
  // Bounded by `splitIdxs`'s length, fixed above.
  while (j < len(splitIdxs)) {
    setFallbackArm(c.insts, splitIdxs[j], node.greedy, end)
    j = j + 1
  }
}

// Points the arm a greedy quantifier tries FIRST (`x`; lazy tries it via
// `y`) at `target`. The other arm is `setFallbackArm`'s job — the two always
// come in a pair, one call bracketing the body just compiled.
fn setPreferredArm(insts: []Inst, splitIdx: int, greedy: bool, target: int) {
  if (greedy) {
    insts[splitIdx].x = target
  } else {
    insts[splitIdx].y = target
  }
}

// The other arm of the same `Split` — greedy's fallback is `y`, lazy's is
// `x`.
fn setFallbackArm(insts: []Inst, splitIdx: int, greedy: bool, target: int) {
  if (greedy) {
    insts[splitIdx].y = target
  } else {
    insts[splitIdx].x = target
  }
}
