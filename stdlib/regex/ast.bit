// Bit standard library — regex module, the pattern AST.
//
// `parse.bit` (this module) builds one of these from a pattern string;
// `regex.bit` stores it in a compiled `Regex`. Nothing here is exported
// (#2026's constraint) — `Regex` is this ticket's only public surface, and the
// AST shape is deliberately wider than what this ticket's parser can produce,
// so later tickets in #2025 grow the parser without reshaping the tree:
// `RepeatNode.max` already carries the `-1` = unbounded case #2031's counted
// repetition needs, and `GroupNode.name` is already a field for #2029's
// captures. `AnchorKind`'s four multiline variants and `Ast.AnyCharNL` are
// #2030's `(?m)`/`(?s)`: the parser picks `BeginLine`/`EndLine` over
// `BeginText`/`EndText` (and `AnyCharNL` over `AnyChar`) using whatever flag
// state is active at the point `^`/`$`/`.` is parsed (parse.bit's
// `beginAnchorKind`/`endAnchorKind`/`dotAst`) — a positional decision, so
// `pike.bit`'s assertion/accept logic never needs to consult a flag itself.

// A quantified sub-pattern: `min` and `max` repetitions of `sub` (`max == -1`
// means unbounded, i.e. `*`/`+`), greedy unless a trailing `?` made it lazy.
class RepeatNode { min: int, max: int, greedy: bool, sub: Ast }

// A parenthesized sub-pattern. `index == 0` means non-capturing (`(?:...)`);
// a positive `index` is this group's 1-based capture slot, and `name` is its
// name for `(?<name>...)`/`(?P<name>...)`, or `""` for an unnamed capture.
class GroupNode { index: int, name: string, sub: Ast }

// The six zero-width assertions the grammar accepts. Under `(?m)`, `^`/`$`
// parse to `BeginLine`/`EndLine` (line-boundary: also holds after/before a
// `\n`); otherwise they parse to `BeginText`/`EndText` (only at the very
// start/end of the subject). `\A`/`\z` always parse to `BeginText`/`EndText`
// regardless of `(?m)` — see `parsecursor.bit`'s `escapeAnchorFor`.
enum AnchorKind {
  BeginText,
  BeginLine,
  EndText,
  EndLine,
  WordBoundary,
  NoWordBoundary,
}

// The parsed form of a pattern. `Concat`/`Alternate` hold their branches as a
// flat `[]Ast` rather than a binary tree — a pattern like `a|b|c|d` is one
// `Alternate` of four, not three nested pairs, which is both the natural
// reading of the grammar and one fewer indirection per branch for #2027's
// compiler to walk.
enum Ast {
  Empty,
  Literal(rune),
  Class(CharClass),
  AnyChar,
  AnyCharNL,
  Concat([]Ast),
  Alternate([]Ast),
  Repeat(RepeatNode),
  Group(GroupNode),
  Anchor(AnchorKind),
}
