// Bit standard library — regex module, the public entry point.
//
// `Regex` is IMMUTABLE once `compile` returns it, and that is a promise this
// module makes from its first line and cannot walk back: a `Regex` is safe to
// share across any number of green threads, so the natural usage is one
// module-level `mustCompile` shared by every request handler an HTTP server
// spawns. Nothing here — nor anything a later ticket adds to this class —
// may put a mutable field on `Regex`; matching work (#2027 on) allocates its
// own scratch space per call instead.
//
// `Ast`, `RepeatNode`, `GroupNode`, `AnchorKind` and `CharClass` (ast.bit,
// charclass.bit) are deliberately not exported: a `Regex` value is opaque,
// and every one of #2026's fixed parse-error messages is produced by the
// parser (parse.bit, parsegroup.bit, parseescape.bit, parseclass.bit), never
// by this file. `matches`, `find` and `findAll` all run `re.prog` through
// the Pike VM (`pike.bit`); `Match.slots` carries every capture pair the
// winning thread reached, but stays module-private here — #2029 adds
// `Match.group`/`named` over the same array without touching the VM again.

// A compiled, validated regular expression: RE2/Pike-VM syntax, linear-time
// matching — no backreferences, no lookaround, ever. Immutable and safe to
// share across green threads (see above). `prog` is the instruction program
// `matches` runs (`prog.bit`, `pike.bit`); it is built once, here, at
// `compile` time, so a shared pattern is compiled once and matched many
// times, never recompiled per call. `names` is `groupNames()`'s backing
// array — one entry per capturing group, index order, `""` for an unnamed
// one — built once here too, alongside `prog`.
export class Regex { source: string, ast: Ast, groups: int, prog: Prog, names: []string }

// Parses `pattern` and returns a validated `Regex`, or fails with a
// `regex: <reason> at offset <n>` error naming the first place the syntax
// breaks down — a byte offset into `pattern`, never a panic and never a
// `Regex` that looks fine and misbehaves once matching exists.
export fn compile(pattern: string): Regex! {
  let ast = parsePattern(pattern)?
  let groups = countGroups(ast)
  let prog = compileProg(ast, groups)?
  let names = []string(groups)
  collectGroupNames(ast, names)
  return Regex{ source: pattern, ast: ast, groups: groups, prog: prog, names: names }
}

// `compile`, panicking on a malformed `pattern` instead of returning an
// error. For the common case — a fixed pattern known at write time, compiled
// once at module load — where a bad pattern is a programmer error, not
// something to recover from at run time.
export fn mustCompile(pattern: string): Regex {
  return compile(pattern) catch e {
    panic(e.message())
  }
}

// `re`'s source pattern, verbatim — exactly the string `compile` was given.
export fn (re: Regex) pattern(): string {
  return re.source
}

// The number of capturing groups in `re` — `(...)` and the two named-group
// forms, not counting the implicit whole-match group 0, and not counting a
// non-capturing `(?:...)`.
export fn (re: Regex) groupCount(): int {
  return re.groups
}

// One entry per capturing group in `re`'s pattern, in index order —
// `groupNames()[0]` is group 1's name — `""` for a group with no name
// (`(...)`); a non-capturing `(?:...)` never gets an entry, since it never
// gets an index either. `len(re.groupNames()) == re.groupCount()` always
// holds. Returns a fresh copy every call, never `re.names` itself: `re` is
// immutable and shared across green threads (this file's header), so no
// caller may ever be handed a reference it could mutate out from under a
// concurrent one.
export fn (re: Regex) groupNames(): []string {
  let out = []string(len(re.names))
  let i = 0
  while (i < len(re.names)) {
    out[i] = re.names[i]
    i = i + 1
  }
  return out
}

// Whether `re`'s pattern matches anywhere in `s` — an unanchored search, the
// same convention as Go's `regexp.MatchString`: use `^`/`$` in the pattern
// itself for a whole-string match. Runs `re.prog` with a Pike VM
// (`pike.bit`): exactly one left-to-right pass over `s`, so this always
// finishes in O(len(s) x len(re's program)) time — there is no
// backtracking, so no pattern and no input can make it exponential.
export fn (re: Regex) matches(s: string): bool {
  let (matched, _) = runPike(re.prog, s, 0)
  return matched
}

// A single match: `start`/`end` are byte offsets into the subject string —
// never rune indices, so they are usable directly as `s[m.start:m.end]`
// slice bounds. `slots` holds every capture group's start/end pair the
// winning thread reached (`-1` for a group that never participated);
// `names` is the same `Regex.names` array `m` was produced from, carried
// along so `named` can resolve a name without a separate `Regex` argument
// (this ticket's `Match.named(name: string)` signature takes only a name).
// Both stay module-private — `group`/`named` below are the only readers.
export class Match { export start: int, export end: int, slots: []int, names: []string }

// The substring of `s` this match covers, `s[m.start:m.end]`. `s` must be
// the same string (or an identical copy) `find`/`findAll` matched against —
// `m.start`/`m.end` are byte offsets into it, not into an arbitrary string.
export fn (m: Match) text(s: string): string {
  return s[m.start:m.end]
}

// `m`'s `i`-th capturing group: `group(0)` is the whole match, always
// `Option.Some` — it is how `m` itself was produced. `Option.None` for `i`
// out of range (`i < 0`, or past the pattern's own group count), and
// `Option.None` for a capturing group that took no part in this particular
// match, e.g. the untaken branch of `(a)|(b)` — distinct from a group that
// matched the empty string, which is `Option.Some` with `start == end`
// (`m.slots` holds `-1` in both halves of a slot pair no `Save` reached;
// `pike.bit`'s header). `2 * i + 1 >= len(m.slots)` catches both `i` too
// large and (defensively) a negative `i` reaching this far, though the
// explicit `i < 0` check above already rejects the latter.
export fn (m: Match) group(i: int): Option<Match> {
  if (i < 0 || 2 * i + 1 >= len(m.slots)) {
    return Option.None
  }
  let start = m.slots[2 * i]
  let end = m.slots[2 * i + 1]
  if (start < 0 || end < 0) {
    return Option.None
  }
  return Option.Some(Match{ start: start, end: end, slots: m.slots, names: m.names })
}

// `m.group(i)` for whichever `i` `m`'s pattern gave `name` to —
// `Option.None` for a name the pattern never declared, same as an
// out-of-range `group` index. Looks the name up in `m.names` (a copy of
// `Regex.names`, carried on `m` since the ticket's signature takes no
// separate `Regex` argument), bounded by `len(m.names) == groupCount()`.
export fn (m: Match) named(name: string): Option<Match> {
  let i = 0
  while (i < len(m.names)) {
    if (m.names[i] == name) {
      return m.group(i + 1)
    }
    i = i + 1
  }
  return Option.None
}

// The leftmost-first match of `re`'s pattern anywhere in `s`, or
// `Option.None` when there is none — an unanchored search, same convention
// as `matches`.
export fn (re: Regex) find(s: string): Option<Match> {
  let (matched, slots) = runPike(re.prog, s, 0)
  if (!matched) {
    return Option.None
  }
  return Option.Some(Match{ start: slots[0], end: slots[1], slots: slots, names: re.names })
}

// Successive non-overlapping matches of `re`'s pattern in `s`, scanning left
// to right. `limit < 0` means no limit; `limit == 0` returns an empty slice;
// otherwise at most `limit` matches.
//
// After a match, the next search starts at its end offset — except when the
// match is empty (`start == end`), where the next search starts one RUNE
// later instead of one byte later, so a multi-byte character is never split.
// Without that rule `findAll("a*", "bb")` never terminates; with it, `a*`
// over `"bb"` yields three empty matches, at byte offsets 0, 1 and 2.
//
// The loop below is bounded independently of that rule, at `len(s) + 1`
// iterations, so a bug in the advance logic can never hang a caller — it
// cannot make the reported matches wrong in a way this ticket's tests don't
// already cover, but it cannot hang the program either.
export fn (re: Regex) findAll(s: string, limit: int): []Match {
  let out: []Match = []Match(0)
  if (limit == 0) {
    return out
  }
  let n = len(s)
  let pos = 0
  let i = 0
  while (pos <= n && i <= n) {
    if (limit > 0 && len(out) >= limit) {
      return out
    }
    let (matched, slots) = runPike(re.prog, s, pos)
    if (!matched) {
      return out
    }
    out = append(out, Match{ start: slots[0], end: slots[1], slots: slots, names: re.names })
    pos = nextSearchPos(s, slots[0], slots[1])
    i = i + 1
  }
  return out
}

// Where `findAll`'s next search should start after a match spanning
// `[start, end)`: `end` itself, unless the match was empty (`start ==
// end`), in which case one rune past it — advancing by a byte would split a
// multi-byte character, and advancing by zero would loop forever on a
// pattern like `a*`.
fn nextSearchPos(s: string, start: int, end: int): int {
  if (end > start) {
    return end
  }
  let (_, width) = decodeRuneAt(s, end)
  return end + width
}

// The number of capturing groups in `ast`, walked once at `compile` time so
// `groupCount` is an O(1) field read rather than a walk on every call. Every
// leaf node (`Empty`, `Literal`, `Class`, `AnyChar`, `AnyCharNL`, `Anchor`)
// contributes zero and shares the `_` arm — only the four structural nodes
// need their own.
fn countGroups(ast: Ast): int {
  return match (ast) {
    Concat(items) => countGroupsIn(items)
    Alternate(items) => countGroupsIn(items)
    Repeat(node) => countGroups(node.sub)
    Group(node) => countGroupsInGroup(node)
    _ => 0
  }
}

// A capturing group counts itself (`index != 0`) plus whatever its own body
// contains.
fn countGroupsInGroup(node: GroupNode): int {
  let own = 0
  if (node.index != 0) {
    own = 1
  }
  return own + countGroups(node.sub)
}

// The sum of `countGroups` over every branch of a `Concat`/`Alternate`.
fn countGroupsIn(items: []Ast): int {
  let total = 0
  let i = 0
  // Bounded by `items`'s length, fixed before the loop starts.
  while (i < len(items)) {
    total = total + countGroups(items[i])
    i = i + 1
  }
  return total
}

// Fills `names[node.index - 1]` for every capturing `Group` node reached
// walking `ast` — `countGroups`'s companion walk, run once at `compile`
// time (into an array already sized `countGroups(ast)`) so `groupNames()`
// is an O(1) copy rather than a fresh walk on every call. `names` is
// mutated in place through the slice reference, the same convention
// `prog.bit`'s `setPreferredArm`/`setFallbackArm` use for `c.insts`.
fn collectGroupNames(ast: Ast, names: []string) {
  match (ast) {
    Concat(items) => collectGroupNamesIn(items, names)
    Alternate(items) => collectGroupNamesIn(items, names)
    Repeat(node) => collectGroupNames(node.sub, names)
    Group(node) => collectGroupNamesInGroup(node, names)
    _ => {}
  }
}

// A capturing group (`index != 0`) records its own name before its body is
// walked; a non-capturing `(?:...)` (`index == 0`) contributes nothing of
// its own but still needs its body walked for any capturing groups nested
// inside it.
fn collectGroupNamesInGroup(node: GroupNode, names: []string) {
  if (node.index != 0) {
    names[node.index - 1] = node.name
  }
  collectGroupNames(node.sub, names)
}

fn collectGroupNamesIn(items: []Ast, names: []string) {
  let i = 0
  // Bounded by `items`'s length, fixed before the loop starts.
  while (i < len(items)) {
    collectGroupNames(items[i], names)
    i = i + 1
  }
}
