// Bit standard library — regex module, the public entry point.
//
// `Regex` is IMMUTABLE once `compile` returns it, and that is a promise this
// module makes from its first line and cannot walk back: a `Regex` is safe to
// share across any number of green threads, so the natural usage is one
// module-level `mustCompile` shared by every request handler an HTTP server
// spawns. Nothing here — nor anything a later ticket adds to this class —
// may put a mutable field on `Regex`; matching work (#2027 on) allocates its
// own scratch space per call instead.
//
// This ticket parses a pattern into an AST and validates it; nothing here
// matches anything yet. `Ast`, `RepeatNode`, `GroupNode`, `AnchorKind` and
// `CharClass` (ast.bit, charclass.bit) are deliberately not exported: a
// `Regex` value is opaque, and every one of this ticket's fixed error
// messages is produced by the parser (parse.bit, parsegroup.bit,
// parseescape.bit, parseclass.bit), never by this file.

// A compiled, validated regular expression: RE2/Pike-VM syntax, linear-time
// matching — no backreferences, no lookaround, ever. Immutable and safe to
// share across green threads (see above). `prog` is the instruction program
// `matches` runs (`prog.bit`, `pike.bit`); it is built once, here, at
// `compile` time, so a shared pattern is compiled once and matched many
// times, never recompiled per call.
export class Regex { source: string, ast: Ast, groups: int, prog: Prog }

// Parses `pattern` and returns a validated `Regex`, or fails with a
// `regex: <reason> at offset <n>` error naming the first place the syntax
// breaks down — a byte offset into `pattern`, never a panic and never a
// `Regex` that looks fine and misbehaves once matching exists.
export fn compile(pattern: string): Regex! {
  let ast = parsePattern(pattern)?
  let groups = countGroups(ast)
  return Regex{ source: pattern, ast: ast, groups: groups, prog: compileProg(ast, groups) }
}

// `compile`, panicking on a malformed `pattern` instead of returning an
// error. For the common case — a fixed pattern known at write time, compiled
// once at module load — where a bad pattern is a programmer error, not
// something to recover from at run time.
export fn mustCompile(pattern: string): Regex {
  return compile(pattern) catch e {
    panic(e.message())
  }
}

// `re`'s source pattern, verbatim — exactly the string `compile` was given.
export fn (re: Regex) pattern(): string {
  return re.source
}

// The number of capturing groups in `re` — `(...)` and the two named-group
// forms, not counting the implicit whole-match group 0, and not counting a
// non-capturing `(?:...)`.
export fn (re: Regex) groupCount(): int {
  return re.groups
}

// Whether `re`'s pattern matches anywhere in `s` — an unanchored search, the
// same convention as Go's `regexp.MatchString`: use `^`/`$` in the pattern
// itself for a whole-string match. Runs `re.prog` with a Pike VM
// (`pike.bit`): exactly one left-to-right pass over `s`, so this always
// finishes in O(len(s) x len(re's program)) time — there is no
// backtracking, so no pattern and no input can make it exponential.
export fn (re: Regex) matches(s: string): bool {
  return runPike(re.prog, s)
}

// The number of capturing groups in `ast`, walked once at `compile` time so
// `groupCount` is an O(1) field read rather than a walk on every call.
fn countGroups(ast: Ast): int {
  return match (ast) {
    Empty => 0
    Literal(_) => 0
    Class(_) => 0
    AnyChar => 0
    Concat(items) => countGroupsIn(items)
    Alternate(items) => countGroupsIn(items)
    Repeat(node) => countGroups(node.sub)
    Group(node) => countGroupsInGroup(node)
    Anchor(_) => 0
  }
}

// A capturing group counts itself (`index != 0`) plus whatever its own body
// contains.
fn countGroupsInGroup(node: GroupNode): int {
  let own = 0
  if (node.index != 0) {
    own = 1
  }
  return own + countGroups(node.sub)
}

// The sum of `countGroups` over every branch of a `Concat`/`Alternate`.
fn countGroupsIn(items: []Ast): int {
  let total = 0
  let i = 0
  // Bounded by `items`'s length, fixed before the loop starts.
  while (i < len(items)) {
    total = total + countGroups(items[i])
    i = i + 1
  }
  return total
}
