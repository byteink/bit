// Bit standard library — regex module, the public entry point.
//
// `Regex` is IMMUTABLE once `compile` returns it, and that is a promise this
// module makes from its first line and cannot walk back: a `Regex` is safe to
// share across any number of green threads, so the natural usage is one
// module-level `mustCompile` shared by every request handler an HTTP server
// spawns. Nothing here — nor anything a later ticket adds to this class —
// may put a mutable field on `Regex`; matching work (#2027 on) allocates its
// own scratch space (`pike.bit`'s `PikeScratch`) as a local of the
// `matches`/`find`/`findAll` call and passes it down, so two green threads
// matching one shared `Regex` never share a buffer. `findAll` makes exactly
// one for its whole scan rather than one per match (#3659) — a per-CALL
// scratch, still never a per-`Regex` one.
//
// `Ast`, `RepeatNode`, `GroupNode`, `AnchorKind` and `CharClass` (ast.bit,
// charclass.bit) are deliberately not exported: a `Regex` value is opaque,
// and every one of #2026's fixed parse-error messages is produced by the
// parser (parse.bit, parsegroup.bit, parseescape.bit, parseclass.bit), never
// by this file. `matches`, `find` and `findAll` all funnel through
// `searchRegex` below, which runs `re.prog` through the Pike VM
// (`pike.bit`); `Match.slots` carries every capture pair the winning thread
// reached, but stays module-private here — #2029 adds `Match.group`/`named`
// over the same array without touching the VM again.
//
// `prefilter`/`selfCheck` are #2052's required-literal / first-byte
// skip-ahead (`prefilter.bit`): both are derived ONCE here, at `compile`
// time, from `ast` and from the process environment respectively, and never
// change afterward — not the "mutable scratch state" the header above rules
// out, which is about per-search working buffers, not compile-time-derived
// immutable data.

import { envOr } from "std/os"

// A compiled, validated regular expression: RE2/Pike-VM syntax, linear-time
// matching — no backreferences, no lookaround, ever. Immutable and safe to
// share across green threads (see above). `prog` is the instruction program
// `matches` runs (`prog.bit`, `pike.bit`); it is built once, here, at
// `compile` time, so a shared pattern is compiled once and matched many
// times, never recompiled per call. `names` is `groupNames()`'s backing
// array — one entry per capturing group, index order, `""` for an unnamed
// one — built once here too, alongside `prog`.
export class Regex {
  source: string
  ast: Ast
  groups: int
  prog: Prog
  names: []string
  prefilter: Prefilter
  selfCheck: bool

  // `re`'s source pattern, verbatim — exactly the string `compile` was given.
  export pattern(): string {
    return this.source
  }

  // The number of capturing groups in `re` — `(...)` and the two named-group
  // forms, not counting the implicit whole-match group 0, and not counting a
  // non-capturing `(?:...)`.
  export groupCount(): int {
    return this.groups
  }

  // One entry per capturing group in `re`'s pattern, in index order —
  // `groupNames()[0]` is group 1's name — `""` for a group with no name
  // (`(...)`); a non-capturing `(?:...)` never gets an entry, since it never
  // gets an index either. `len(re.groupNames()) == re.groupCount()` always
  // holds. Returns a fresh copy every call, never `re.names` itself: `re` is
  // immutable and shared across green threads (this file's header), so no
  // caller may ever be handed a reference it could mutate out from under a
  // concurrent one.
  export groupNames(): []string {
    let out = []string(len(this.names))
    let i = 0
    while (i < len(this.names)) {
      out[i] = this.names[i]
      i = i + 1
    }
    return out
  }

  // Whether `re`'s pattern matches anywhere in `s` — an unanchored search, the
  // same convention as Go's `regexp.MatchString`: use `^`/`$` in the pattern
  // itself for a whole-string match. Runs `re.prog` with a Pike VM
  // (`pike.bit`): exactly one left-to-right pass over `s`, so this always
  // finishes in O(len(s) x len(re's program)) time — there is no
  // backtracking, so no pattern and no input can make it exponential.
  export matches(s: string): bool {
    let (matched, _) = searchRegex(this, s, 0, newPikeScratch(this.prog))
    return matched
  }

  // The leftmost-first match of `re`'s pattern anywhere in `s`, or
  // `Option.None` when there is none — an unanchored search, same convention
  // as `matches`.
  export find(s: string): Option<Match> {
    let (matched, slots) = searchRegex(this, s, 0, newPikeScratch(this.prog))
    if (!matched) {
      return Option.None
    }
    return Option.Some(Match{ start: slots[0], end: slots[1], slots: slots, names: this.names })
  }

  // Successive non-overlapping matches of `re`'s pattern in `s`, scanning left
  // to right. `limit < 0` means no limit; `limit == 0` returns an empty slice;
  // otherwise at most `limit` matches.
  //
  // O(len(s) x len(re's program)) for the WHOLE scan, the same bound as
  // `matches`/`find` — one continuous left-to-right pass (`runPikeAll`,
  // pikeall.bit), not one restarted search per match. It was the latter
  // until #3866, which made it O(len(s)^2) for any pattern with a
  // high-priority branch that stays alive without completing; pike.bit's
  // `#3832` block holds that measurement. `replaceAll` and `split` are
  // expressed over this function, so all three share the one pass.
  //
  // The two rules that scan obeys are stated where it implements them
  // (pikeall.bit's `isEmptyEcho` and `forwardThreads`), and are unchanged in
  // effect: a zero-width match advances by one RUNE rather than one byte, so
  // a multi-byte character is never split and `findAll("a*", "bb")`
  // terminates with three empty matches at offsets 0, 1 and 2; and an empty
  // match sitting exactly where the previous match ended is rejected,
  // mirroring Go's `regexp.go` (`(*Regexp).matches`, go1.27.0
  // regexp.go:768), which is what stops `".*"` over `"abcdef"` from
  // reporting a spurious `[6,6)` right after `[0,6)`.
  //
  // The `Match`es returned are NOT views into the VM scratch: each carries
  // the `snapshotSlots` array its own winning thread produced (`pike.bit`),
  // so the scan reusing its buffers cannot reach back and alter a match
  // already collected.
  export findAll(s: string, limit: int): []Match {
    let out: []Match = []Match(0)
    let all = scanRegex(this, s, limit)
    let i = 0
    // Bounded by `len(all)`, itself bounded by `len(s) + 1` (one match per
    // input position at most — pikeall.bit's own bound).
    while (i < len(all)) {
      let slots = all[i]
      out = append(out, Match{ start: slots[0], end: slots[1], slots: slots, names: this.names })
      i = i + 1
    }
    return out
  }

  // The text between successive non-overlapping matches of `re`'s pattern in
  // `s`, using `findAll`'s exact scan (the same one-rune advance after a
  // zero-width match, and the same echo-rejection right after a real match —
  // this function adds nothing to that scan, it only slices around whatever
  // `findAll` finds). `limit < 0` is unlimited pieces; `limit == 0` returns an
  // empty slice with no scanning at all; `limit > 0` returns at most `limit`
  // pieces, the last one holding the entire unsplit remainder of `s` — found
  // by calling `findAll(s, limit)` (which itself returns at most `limit`
  // matches) and then, mirroring Go's own `(*Regexp).Split` loop (go1.27.0,
  // regexp.go:1291-1312) exactly, stopping one match early once `limit - 1`
  // pieces have been produced, so the final piece always absorbs the rest —
  // matches included — rather than truncating it.
  //
  // A pattern whose SOURCE TEXT is non-empty, applied to an empty subject, is
  // a hardcoded special case in Go's own implementation and reproduced here
  // verbatim: it always returns a single empty piece, `[""]`, without
  // scanning at all — never zero pieces, regardless of whether the pattern
  // could itself match the empty string. `split("", "")` (an empty PATTERN on
  // an empty subject) does not hit this case and falls through to the
  // general logic below, which independently yields zero pieces for it (see
  // the next paragraph) — the two both happen to avoid `[""]`, but by
  // entirely different mechanisms.
  //
  // THE TRAP: a match that is BOTH zero-width AND sits exactly at the
  // position a piece would start from — offset 0 for the very first match,
  // `len(s)` for the very last — does NOT produce the empty piece a plain
  // "every match boundary gets a piece" reading would suggest, exactly
  // mirroring Go's `if match[1] != 0` (leading) and `if end != len(s)`
  // (trailing) guards. Concretely, `split("", "abc", -1)` — the empty
  // pattern matches at every rune boundary, 0/1/2/3 — yields `["a","b","c"]`,
  // three pieces, not five: the zero-width matches sitting exactly at 0 and
  // 3 are this degenerate case, while the ones at 1 and 2 sit strictly
  // between real content and behave normally. A NON-empty match at offset 0
  // (e.g. splitting ",ab" on ",") still produces its leading empty piece —
  // the suppression is specific to a zero-width match, never to "any match
  // at offset 0".
  export split(s: string, limit: int): []string {
    if (limit == 0) {
      return []string(0)
    }
    if (len(s) == 0 && len(this.source) > 0) {
      let single: []string = []string(0)
      return append(single, "")
    }
    let matches = this.findAll(s, limit)
    let out: []string = []string(0)
    let beg = 0
    let lastStart = 0
    let pieceCap = limit - 1
    let i = 0
    let total = len(matches)
    // Bounded by `len(matches)`, itself bounded by `findAll`'s own
    // `len(s) + 1` iteration cap — a bug in either rule above can never hang
    // a caller.
    while (i < total) {
      if (limit > 0 && len(out) >= pieceCap) {
        break
      }
      let m = matches[i]
      lastStart = m.start
      if (m.end != 0) {
        out = append(out, s[beg:lastStart])
      }
      beg = m.end
      i = i + 1
    }
    if (lastStart != len(s)) {
      out = append(out, s[beg:len(s)])
    }
    return out
  }

  // The leftmost non-overlapping matches of `re`'s pattern in `s`, each
  // replaced by `repl` with its own `$`-template expanded against that
  // match's capture groups (see the module doc comment above for the exact
  // grammar). Text between matches, and any text after the last one, is
  // copied through unchanged. A pattern that never matches returns `s`
  // itself, unchanged.
  export replaceAll(s: string, repl: string): string {
    let b = newBuilder()
    let ms = this.findAll(s, -1)
    let written = 0
    let i = 0
    // Bounded by `len(ms)`. The matches are non-overlapping and in
    // increasing order (pikeall.bit), so `written` never runs past
    // `m.start` and each slice below is well-formed.
    while (i < len(ms)) {
      let m = ms[i]
      b = b.write(s[written:m.start])
      b = expandTemplate(b, repl, m, s)
      written = m.end
      i = i + 1
    }
    b = b.write(s[written:len(s)])
    return b.toString()
  }

  // The leftmost match of `re`'s pattern in `s`, replaced by `repl` with its
  // `$`-template expanded against that match's capture groups. Every other
  // match, if any, is left untouched. Returns `s` unchanged when there is no
  // match at all.
  export replaceFirst(s: string, repl: string): string {
    return match (this.find(s)) {
      Some(m) => buildReplaceFirst(s, repl, m)
      None => s
    }
  }
}

// Parses `pattern` and returns a validated `Regex`, or fails with a
// `regex: <reason> at offset <n>` error naming the first place the syntax
// breaks down — a byte offset into `pattern`, never a panic and never a
// `Regex` that looks fine and misbehaves once matching exists.
export fn compile(pattern: string): Regex! {
  let ast = parsePattern(pattern)?
  let groups = countGroups(ast)
  let prog = compileProg(ast, groups)?
  let names = []string(groups)
  collectGroupNames(ast, names)
  return Regex{
    source: pattern,
    ast: ast,
    groups: groups,
    prog: prog,
    names: names,
    prefilter: derivePrefilter(ast),
    selfCheck: prefilterSelfCheckEnabled(),
  }
}

// Whether #2052's agreement self-check is on for this process: read once,
// here, per `compile()` call — never per search — so the hot (off) path
// pays no per-call environment lookup. Undocumented and internal on
// purpose (the ticket's own constraint: no public API to force the
// prefilter off, including for this check) — `_tests_/imports/regexprefilter/`
// is the only setter, and it can only reach this by re-executing itself
// with the variable set (`std/os` has no `setEnv`), never by importing
// anything from this module that isn't already exported.
fn prefilterSelfCheckEnabled(): bool {
  return len(envOr("BIT_REGEX_PREFILTER_SELFCHECK", "")) > 0
}

// Runs `re`'s program against `s` from `startAt` — the real,
// prefilter-accelerated path every one of `matches`/`find`/`findAll`
// funnels through. When `re.selfCheck` is on, ALSO runs the same program
// with the prefilter forced off (`noPrefilter()`) and panics on any
// disagreement (`assertPrefilterAgrees`), so every search this module
// performs while the switch is set is checked, not just a hand-picked
// sample.
//
// `sc` is the caller's VM scratch (`pike.bit`'s `PikeScratch`), passed down
// rather than made here so `findAll` can allocate one for its whole scan
// instead of one per match (#3659). Both runs below share it — safe, and
// worth stating because it is exactly the kind of reuse that goes wrong:
// `slots` is the first run's own `snapshotSlots` array, not a view into
// `sc`, so the reference run resetting and refilling `sc` cannot disturb
// the result it is being compared against.
fn searchRegex(re: Regex, s: string, startAt: int, sc: PikeScratch): (bool, []int) {
  let (matched, slots) = runPike(re.prog, s, startAt, re.prefilter, sc)
  if (re.selfCheck) {
    let (refMatched, refSlots) = runPike(re.prog, s, startAt, noPrefilter(), sc)
    assertPrefilterAgrees(re.source, matched, slots, refMatched, refSlots)
  }
  return matched, slots
}

// `searchRegex`'s multi-match twin: every non-overlapping match of `re` in
// `s` in ONE continuous pass (`runPikeAll`, pikeall.bit), which is what
// `findAll` — and so `split` and `replaceAll` — is built on.
//
// The scratch is a local of this call, never a field on `re` (which is
// shared and immutable), so a concurrent scan on the same `Regex` gets its
// own; and the reference run under `selfCheck` gets a SECOND one rather than
// reusing the first, because unlike `searchRegex`'s two single searches
// these two scans must not share thread lists — the first scan's result is
// an array of arrays that outlives the scratch, but the scratch itself is
// still live bookkeeping while the second scan runs.
//
// #2052's agreement check is per SCAN here, not per search: the prefilter
// gates fresh start-thread seeding at every position of the pass, so the
// property to check is that the whole match sequence is unchanged with it
// forced off, not just one match at a time.
fn scanRegex(re: Regex, s: string, limit: int): [][]int {
  let all = runPikeAll(re.prog, s, re.prefilter, newPikeScratch(re.prog), limit)
  if (re.selfCheck) {
    let ref = runPikeAll(re.prog, s, noPrefilter(), newPikeScratch(re.prog), limit)
    assertScanAgrees(re.source, all, ref)
  }
  return all
}

// A different NUMBER of matches, or any slot disagreeing in any of them, is
// a correctness bug in `prefilter.bit`'s derivation — see
// `assertPrefilterAgrees`, of which this is the scan-wide form.
fn assertScanAgrees(source: string, all: [][]int, ref: [][]int) {
  if (len(all) != len(ref)) {
    panic("regex: prefilter disagreement on \"${source}\": ${len(all)} matches, reference ${len(ref)}")
  }
  let i = 0
  // Bounded by `len(all)`, checked equal to `len(ref)` just above.
  while (i < len(all)) {
    assertSlotsEqual(source, all[i], ref[i])
    i = i + 1
  }
}

// `matched`/`refMatched` disagreeing, or — when both matched — any slot
// disagreeing, is a correctness bug in `prefilter.bit`'s derivation, not a
// recoverable condition: panicking here is what makes the agreement test
// in `_tests_/imports/regexprefilter/` fail loudly instead of silently
// passing on a prefilter that skips a real match.
fn assertPrefilterAgrees(
  source: string,
  matched: bool,
  slots: []int,
  refMatched: bool,
  refSlots: []int,
) {
  if (matched != refMatched) {
    panic("regex: prefilter disagreement on \"${source}\": matched=${matched}, reference matched=${refMatched}")
  }
  if (!matched) {
    return
  }
  assertSlotsEqual(source, slots, refSlots)
}

fn assertSlotsEqual(source: string, slots: []int, refSlots: []int) {
  if (len(slots) != len(refSlots)) {
    panic("regex: prefilter disagreement on \"${source}\": slot count ${len(slots)} vs ${len(refSlots)}")
  }
  let i = 0
  // Bounded by `slots`'s length, fixed before the loop starts (`re.prog`'s
  // own `numSlots`, the same for both runs).
  while (i < len(slots)) {
    if (slots[i] != refSlots[i]) {
      panic("regex: prefilter disagreement on \"${source}\": slot ${i} differs (${slots[i]} vs ${refSlots[i]})")
    }
    i = i + 1
  }
}

// `compile`, panicking on a malformed `pattern` instead of returning an
// error. For the common case — a fixed pattern known at write time, compiled
// once at module load — where a bad pattern is a programmer error, not
// something to recover from at run time.
export fn mustCompile(pattern: string): Regex {
  return compile(pattern) catch e {
    panic(e.message())
  }
}

// A single match: `start`/`end` are byte offsets into the subject string —
// never rune indices, so they are usable directly as `s[m.start:m.end]`
// slice bounds. `slots` holds every capture group's start/end pair the
// winning thread reached (`-1` for a group that never participated);
// `names` is the same `Regex.names` array `m` was produced from, carried
// along so `named` can resolve a name without a separate `Regex` argument
// (this ticket's `Match.named(name: string)` signature takes only a name).
// Both stay module-private — `group`/`named` below are the only readers.
export class Match {
  export start: int
  export end: int
  slots: []int
  names: []string
  // The substring of `s` this match covers, `s[m.start:m.end]`. `s` must be
  // the same string (or an identical copy) `find`/`findAll` matched against —
  // `m.start`/`m.end` are byte offsets into it, not into an arbitrary string.
  export text(s: string): string {
    return s[this.start:this.end]
  }

  // `m`'s `i`-th capturing group: `group(0)` is the whole match, always
  // `Option.Some` — it is how `m` itself was produced. `Option.None` for `i`
  // out of range (`i < 0`, or past the pattern's own group count), and
  // `Option.None` for a capturing group that took no part in this particular
  // match, e.g. the untaken branch of `(a)|(b)` — distinct from a group that
  // matched the empty string, which is `Option.Some` with `start == end`
  // (`m.slots` holds `-1` in both halves of a slot pair no `Save` reached;
  // `pike.bit`'s header). `2 * i + 1 >= len(m.slots)` catches both `i` too
  // large and (defensively) a negative `i` reaching this far, though the
  // explicit `i < 0` check above already rejects the latter.
  export group(i: int): Option<Match> {
    if (i < 0 || 2 * i + 1 >= len(this.slots)) {
      return Option.None
    }
    let start = this.slots[2 * i]
    let end = this.slots[2 * i + 1]
    if (start < 0 || end < 0) {
      return Option.None
    }
    return Option.Some(Match{ start: start, end: end, slots: this.slots, names: this.names })
  }

  // `m.group(i)` for whichever `i` `m`'s pattern gave `name` to —
  // `Option.None` for a name the pattern never declared, same as an
  // out-of-range `group` index. Looks the name up in `m.names` (a copy of
  // `Regex.names`, carried on `m` since the ticket's signature takes no
  // separate `Regex` argument), bounded by `len(m.names) == groupCount()`.
  export named(name: string): Option<Match> {
    let i = 0
    while (i < len(this.names)) {
      if (this.names[i] == name) {
        return this.group(i + 1)
      }
      i = i + 1
    }
    return Option.None
  }
}

// The number of capturing groups in `ast`, walked once at `compile` time so
// `groupCount` is an O(1) field read rather than a walk on every call. Every
// leaf node (`Empty`, `Literal`, `Class`, `AnyChar`, `AnyCharNL`, `Anchor`)
// contributes zero and shares the `_` arm — only the four structural nodes
// need their own.
fn countGroups(ast: Ast): int {
  return match (ast) {
    Concat(items) => countGroupsIn(items)
    Alternate(items) => countGroupsIn(items)
    Repeat(node) => countGroups(node.sub)
    Group(node) => countGroupsInGroup(node)
    _ => 0
  }
}

// A capturing group counts itself (`index != 0`) plus whatever its own body
// contains.
fn countGroupsInGroup(node: GroupNode): int {
  let own = 0
  if (node.index != 0) {
    own = 1
  }
  return own + countGroups(node.sub)
}

// The sum of `countGroups` over every branch of a `Concat`/`Alternate`.
fn countGroupsIn(items: []Ast): int {
  let total = 0
  let i = 0
  // Bounded by `items`'s length, fixed before the loop starts.
  while (i < len(items)) {
    total = total + countGroups(items[i])
    i = i + 1
  }
  return total
}

// Fills `names[node.index - 1]` for every capturing `Group` node reached
// walking `ast` — `countGroups`'s companion walk, run once at `compile`
// time (into an array already sized `countGroups(ast)`) so `groupNames()`
// is an O(1) copy rather than a fresh walk on every call. `names` is
// mutated in place through the slice reference, the same convention
// `prog.bit`'s `setPreferredArm`/`setFallbackArm` use for `c.insts`.
fn collectGroupNames(ast: Ast, names: []string) {
  match (ast) {
    Concat(items) => collectGroupNamesIn(items, names)
    Alternate(items) => collectGroupNamesIn(items, names)
    Repeat(node) => collectGroupNames(node.sub, names)
    Group(node) => collectGroupNamesInGroup(node, names)
    _ => {}
  }
}

// A capturing group (`index != 0`) records its own name before its body is
// walked; a non-capturing `(?:...)` (`index == 0`) contributes nothing of
// its own but still needs its body walked for any capturing groups nested
// inside it.
fn collectGroupNamesInGroup(node: GroupNode, names: []string) {
  if (node.index != 0) {
    names[node.index - 1] = node.name
  }
  collectGroupNames(node.sub, names)
}

fn collectGroupNamesIn(items: []Ast, names: []string) {
  let i = 0
  // Bounded by `items`'s length, fixed before the loop starts.
  while (i < len(items)) {
    collectGroupNames(items[i], names)
    i = i + 1
  }
}
