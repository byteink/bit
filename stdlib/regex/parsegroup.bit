// Bit standard library — regex module, group parsing.
//
// `(...)`, `(?:...)`, `(?<name>...)` and `(?P<name>...)` — both named-group
// spellings are accepted as the same construct (#2026), one JavaScript-style
// and one Go/Python/RE2-style, since a pattern pasted from either ecosystem's
// docs should just work. Lookaround (`(?=`, `(?!`, `(?<=`, `(?<!`) and inline
// flags (`(?i)`, `(?s)`, `(?m)`, scoped `(?i:...)`) are recognized only far
// enough to reject them — see `parseSpecialGroup` — never to accept them.

// `(`, already known not to start a special `(?...)` form: an ordinary
// capturing group. Assigns the next 1-based capture index before parsing its
// body, so nested groups number outside-in, left to right (`(a(b))` is
// group 1 = the whole thing, group 2 = `b`).
fn parseGroup(p: RegexParser): Ast! {
  let openPos = p.pos
  advanceByte(p)
  if (!atEnd(p) && curByte(p) == '?') {
    return parseSpecialGroup(p, openPos)?
  }
  p.groupCount = p.groupCount + 1
  let idx = p.groupCount
  let sub = parseAlternate(p)?
  expectCloseParen(p, openPos)?
  return Ast.Group(GroupNode{ index: idx, name: "", sub: sub })
}

// Dispatches on the byte right after `(?`: `:` (non-capturing), `<` (a
// JS-style named group, or a rejected lookbehind), `P` (a Go-style named
// group), or an inline-flag letter (`i`/`s`/`m`/`-`, rejected: #2030's job).
// Anything else — including `=`/`!` for lookahead — falls through to the
// same "invalid named group" error lookbehind uses, since none of it is a
// form this parser ever accepts.
fn parseSpecialGroup(p: RegexParser, openPos: int): Ast! {
  advanceByte(p)
  if (atEnd(p)) {
    fail parseErr(errInvalidNamedGroup, openPos)
  }
  let b = curByte(p)
  if (b == ':') {
    return parseNonCapturingGroup(p, openPos)?
  }
  if (b == '<') {
    return parseAngleNamedGroup(p, openPos)?
  }
  if (b == 'P') {
    return parsePNamedGroup(p, openPos)?
  }
  if (isFlagLetter(b) || b == '-') {
    fail parseErr(errInlineFlagsUnsupported, openPos)
  }
  fail parseErr(errInvalidNamedGroup, openPos)
}

fn isFlagLetter(b: u8): bool {
  return b == 'i' || b == 's' || b == 'm'
}

// `(?:sub)` — a group that does not capture.
fn parseNonCapturingGroup(p: RegexParser, openPos: int): Ast! {
  advanceByte(p)
  let sub = parseAlternate(p)?
  expectCloseParen(p, openPos)?
  return Ast.Group(GroupNode{ index: 0, name: "", sub: sub })
}

// `(?<name>sub)`. `(?<=` and `(?<!` are lookbehind — permanently out of
// scope (no lookaround may ever be accepted) — and are rejected here before
// a name is even attempted, rather than being parsed as a name starting
// with `=`/`!` (which `parseGroupName` would reject anyway, but with the
// wrong offset: the `<`, not the group's `(`).
fn parseAngleNamedGroup(p: RegexParser, openPos: int): Ast! {
  advanceByte(p)
  if (!atEnd(p) && isLookbehindMark(curByte(p))) {
    fail parseErr(errInvalidNamedGroup, openPos)
  }
  let name = parseGroupName(p, openPos)?
  expectByte(p, '>', openPos, errInvalidNamedGroup)?
  return finishNamedGroup(p, openPos, name)?
}

fn isLookbehindMark(b: u8): bool {
  return b == '=' || b == '!'
}

// `(?P<name>sub)`.
fn parsePNamedGroup(p: RegexParser, openPos: int): Ast! {
  advanceByte(p)
  expectByte(p, '<', openPos, errInvalidNamedGroup)?
  let name = parseGroupName(p, openPos)?
  expectByte(p, '>', openPos, errInvalidNamedGroup)?
  return finishNamedGroup(p, openPos, name)?
}

// `[A-Za-z_][A-Za-z0-9_]*`, the shared name grammar for both spellings.
fn parseGroupName(p: RegexParser, openPos: int): string! {
  let start = p.pos
  if (atEnd(p) || !isNameStartByte(curByte(p))) {
    fail parseErr(errInvalidNamedGroup, openPos)
  }
  advanceByte(p)
  // Bounded: each iteration consumes one byte.
  while (!atEnd(p) && isNameContByte(curByte(p))) {
    advanceByte(p)
  }
  return p.src[start:p.pos]
}

fn isNameStartByte(b: u8): bool {
  return isAsciiLetter(b) || b == '_'
}

fn isNameContByte(b: u8): bool {
  return isNameStartByte(b) || isAsciiDigit(b)
}

// Assigns `name`'s capture index, parses its body, and consumes the closing
// `)` — the tail both named-group spellings share once the name itself is
// parsed and its `>` consumed.
fn finishNamedGroup(p: RegexParser, openPos: int, name: string): Ast! {
  p.groupCount = p.groupCount + 1
  let idx = p.groupCount
  let sub = parseAlternate(p)?
  expectCloseParen(p, openPos)?
  return Ast.Group(GroupNode{ index: idx, name: name, sub: sub })
}

// Consumes `)`, or fails `regex: missing closing )` at `openPos` — the
// position of the `(` this closes, which is more useful to a caller than the
// position where the search for it gave up (typically end of pattern).
fn expectCloseParen(p: RegexParser, openPos: int): ()! {
  if (atEnd(p) || curByte(p) != ')') {
    fail parseErr(errMissingCloseParen, openPos)
  }
  advanceByte(p)
  return
}

// Consumes `want`, or fails `msg` at `errAt`.
fn expectByte(p: RegexParser, want: u8, errAt: int, msg: string): ()! {
  if (atEnd(p) || curByte(p) != want) {
    fail parseErr(msg, errAt)
  }
  advanceByte(p)
  return
}
