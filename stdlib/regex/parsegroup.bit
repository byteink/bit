// Bit standard library — regex module, group parsing.
//
// `(...)`, `(?:...)`, `(?<name>...)`, `(?P<name>...)`, and #2030's inline
// flags — `(?flags)` (a setting group, `parseflags.bit`'s job) and
// `(?flags:...)` (a scoped non-capturing group, `parseFlagsGroup` below) —
// both named-group spellings are accepted as the same construct (#2026), one
// JavaScript-style and one Go/Python/RE2-style, since a pattern pasted from
// either ecosystem's docs should just work. Lookaround (`(?=`, `(?!`, `(?<=`,
// `(?<!`) is recognized only far enough to reject it — see
// `parseSpecialGroup` — never to accept it.
//
// Every function here that can produce an `Ast` returns `Option<Ast>`
// alongside the flags in effect for whatever follows: `Option.None` only for
// a bare `(?flags)` setting group, which contributes no node at all — not
// even an empty one, so a following quantifier (`(?i)*`) has no atom to
// apply to and fails `errNothingToRepeat`, exactly like a real Go pattern.
// Every other form — capturing, non-capturing, named, or scoped-flags —
// always returns `Option.Some` and returns `flags` UNCHANGED, since only a
// bare setting group can change what follows it within the enclosing group
// (`parseflags.bit`'s header comment).

// `(`, already known not to start a special `(?...)` form: an ordinary
// capturing group. Assigns the next 1-based capture index before parsing its
// body, so nested groups number outside-in, left to right (`(a(b))` is
// group 1 = the whole thing, group 2 = `b`).
//
// The single choke point every `(` passes through (`parseAtom` calls only
// this on `(`, and `parseSpecialGroup`'s four forms are all dispatched from
// here), so `p.depth` bumped on entry and dropped on exit (#3660) bounds
// grammar nesting for capturing, non-capturing, named AND scoped-flags
// groups alike — never manually reset on a `fail` path, since a rejected
// pattern abandons this `RegexParser` entirely.
fn parseGroup(p: RegexParser, flags: RegexFlags): (Option<Ast>, RegexFlags)! {
  let openPos = p.pos
  advanceByte(p)
  enterNesting(p, openPos)?
  if (!atEnd(p) && curByte(p) == '?') {
    let (sub, f) = parseSpecialGroup(p, openPos, flags)?
    p.depth = p.depth - 1
    return sub, f
  }
  p.groupCount = p.groupCount + 1
  let idx = p.groupCount
  let (sub, _) = parseAlternate(p, flags)?
  expectCloseParen(p, openPos)?
  p.depth = p.depth - 1
  return Option.Some(Ast.Group(GroupNode{ index: idx, name: "", sub: sub })), flags
}

// Bumps `p.depth` for the `(` just consumed, and fails once it reaches
// `maxNestingDepth` — checked BEFORE the group's body is parsed, so the
// recursive descent never goes one level deeper than the bound allows (the
// entire point: a rejection here, not a crash from recursing past it).
fn enterNesting(p: RegexParser, openPos: int): ()! {
  p.depth = p.depth + 1
  if (p.depth >= maxNestingDepth) {
    fail parseErr(errNestingTooDeep, openPos)
  }
  return
}

// Dispatches on the byte right after `(?`: `:` (non-capturing), `<` (a
// JS-style named group, or a rejected lookbehind), `P` (a Go-style named
// group), `)` right away (`(?)`, no flags at all), or an ASCII letter/`-`
// (the start of a flag run — `parseFlagsGroup` below decides pure-setting vs
// scoped, and rejects an unknown letter). Anything else — including `=`/`!`
// for lookahead — falls through to the same "invalid named group" error
// lookbehind uses, since none of it is a form this parser ever accepts.
fn parseSpecialGroup(p: RegexParser, openPos: int, flags: RegexFlags): (Option<Ast>, RegexFlags)! {
  advanceByte(p)
  if (atEnd(p)) {
    fail parseErr(errInvalidNamedGroup, openPos)
  }
  let b = curByte(p)
  if (b == ':') {
    return parseNonCapturingGroup(p, openPos, flags)?
  }
  if (b == '<') {
    return parseAngleNamedGroup(p, openPos, flags)?
  }
  if (b == 'P') {
    return parsePNamedGroup(p, openPos, flags)?
  }
  if (b == ')') {
    fail parseErr(errMissingFlags, openPos)
  }
  if (isAsciiLetter(b) || b == '-') {
    return parseFlagsGroup(p, openPos, flags)?
  }
  fail parseErr(errInvalidNamedGroup, openPos)
}

// `(?flags)` or `(?flags:...)`, once `parseSpecialGroup` knows `b` starts a
// flag run. `)` right after the run is the setting-group form: `flags` for
// the rest of the enclosing group changes, and no `Ast` is produced. `:` is
// the scoped form: a non-capturing group whose body alone sees `newFlags` —
// `flags` (the parameter, not `newFlags`) is what this function returns, so
// nothing leaks past the closing `)`.
fn parseFlagsGroup(p: RegexParser, openPos: int, flags: RegexFlags): (Option<Ast>, RegexFlags)! {
  let newFlags = parseFlagRun(p, flags, openPos)?
  if (curByte(p) == ')') {
    advanceByte(p)
    return Option.None, newFlags
  }
  advanceByte(p) // ':'
  let (sub, _) = parseAlternate(p, newFlags)?
  expectCloseParen(p, openPos)?
  return Option.Some(Ast.Group(GroupNode{ index: 0, name: "", sub: sub })), flags
}

// `(?:sub)` — a group that does not capture.
fn parseNonCapturingGroup(
  p: RegexParser,
  openPos: int,
  flags: RegexFlags,
): (Option<Ast>, RegexFlags)! {
  advanceByte(p)
  let (sub, _) = parseAlternate(p, flags)?
  expectCloseParen(p, openPos)?
  return Option.Some(Ast.Group(GroupNode{ index: 0, name: "", sub: sub })), flags
}

// `(?<name>sub)`. `(?<=` and `(?<!` are lookbehind — permanently out of
// scope (no lookaround may ever be accepted) — and are rejected here before
// a name is even attempted, rather than being parsed as a name starting
// with `=`/`!` (which `parseGroupName` would reject anyway, but with the
// wrong offset: the `<`, not the group's `(`).
fn parseAngleNamedGroup(
  p: RegexParser,
  openPos: int,
  flags: RegexFlags,
): (Option<Ast>, RegexFlags)! {
  advanceByte(p)
  if (!atEnd(p) && isLookbehindMark(curByte(p))) {
    fail parseErr(errInvalidNamedGroup, openPos)
  }
  let name = parseGroupName(p, openPos)?
  expectByte(p, '>', openPos, errInvalidNamedGroup)?
  return finishNamedGroup(p, openPos, name, flags)?
}

fn isLookbehindMark(b: u8): bool {
  return b == '=' || b == '!'
}

// `(?P<name>sub)`.
fn parsePNamedGroup(p: RegexParser, openPos: int, flags: RegexFlags): (Option<Ast>, RegexFlags)! {
  advanceByte(p)
  expectByte(p, '<', openPos, errInvalidNamedGroup)?
  let name = parseGroupName(p, openPos)?
  expectByte(p, '>', openPos, errInvalidNamedGroup)?
  return finishNamedGroup(p, openPos, name, flags)?
}

// `[A-Za-z_][A-Za-z0-9_]*`, the shared name grammar for both spellings.
fn parseGroupName(p: RegexParser, openPos: int): string! {
  let start = p.pos
  if (atEnd(p) || !isNameStartByte(curByte(p))) {
    fail parseErr(errInvalidNamedGroup, openPos)
  }
  advanceByte(p)
  // Bounded: each iteration consumes one byte.
  while (!atEnd(p) && isNameContByte(curByte(p))) {
    advanceByte(p)
  }
  return p.src[start:p.pos]
}

fn isNameStartByte(b: u8): bool {
  return isAsciiLetter(b) || b == '_'
}

fn isNameContByte(b: u8): bool {
  return isNameStartByte(b) || isAsciiDigit(b)
}

// Assigns `name`'s capture index, parses its body, and consumes the closing
// `)` — the tail both named-group spellings share once the name itself is
// parsed and its `>` consumed. A named group never changes `flags` for what
// follows it (same rule as an ordinary capturing group). Rejects `name` as a
// duplicate — of either spelling — before touching `p.groupCount`, so a
// rejected pattern never leaves the parser with an index it did not use.
fn finishNamedGroup(
  p: RegexParser,
  openPos: int,
  name: string,
  flags: RegexFlags,
): (Option<Ast>, RegexFlags)! {
  if (groupNameSeen(p, name)) {
    fail parseErr(errDuplicateGroupName, openPos)
  }
  p.names = append(p.names, name)
  p.groupCount = p.groupCount + 1
  let idx = p.groupCount
  let (sub, _) = parseAlternate(p, flags)?
  expectCloseParen(p, openPos)?
  return Option.Some(Ast.Group(GroupNode{ index: idx, name: name, sub: sub })), flags
}

// Whether `name` was already claimed by an earlier named group in this same
// pattern — bounded by `p.names`'s length, which grows by exactly one per
// named group already parsed.
fn groupNameSeen(p: RegexParser, name: string): bool {
  let i = 0
  while (i < len(p.names)) {
    if (p.names[i] == name) {
      return true
    }
    i = i + 1
  }
  return false
}

// Consumes `)`, or fails `regex: missing closing )` at `openPos` — the
// position of the `(` this closes, which is more useful to a caller than the
// position where the search for it gave up (typically end of pattern).
fn expectCloseParen(p: RegexParser, openPos: int): ()! {
  if (atEnd(p) || curByte(p) != ')') {
    fail parseErr(errMissingCloseParen, openPos)
  }
  advanceByte(p)
  return
}

// Consumes `want`, or fails `msg` at `errAt`.
fn expectByte(p: RegexParser, want: u8, errAt: int, msg: string): ()! {
  if (atEnd(p) || curByte(p) != want) {
    fail parseErr(msg, errAt)
  }
  advanceByte(p)
  return
}
