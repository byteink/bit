// Bit standard library — regex module, the Pike VM.
//
// Russ Cox's NFA-simulation algorithm (the technique behind RE2 and Go's
// `regexp`): one left-to-right pass over the input, one rune at a time, two
// thread lists (the current position's and the next's) swapped after each
// step. No backtracking, so no input can make it slow — match time is
// O(len(prog) x len(s)), full stop.
//
// THREAD-LIST DEDUPE, THE WHOLE REASON THIS IS LINEAR: `ThreadList` is a
// classic sparse set (`PcSet` below) keyed by program counter, so a given pc
// is added at most once per position. Skip it and a pattern like `(a*)*`
// walks the same split arbitrarily many times per position, and "linear
// time" becomes a lie every functional test still passes (see this file's
// mutation-test note in the ticket this shipped under).
//
// ALLOCATION: both thread lists, their sparse sets, and the closure stack
// are allocated exactly once per call to `runPike` — never per input
// position, never per rune, and never stored on `Regex` (which stays
// immutable and safe to share across any number of green threads; hanging
// scratch state off it would make every spawned caller race on the same
// buffer). The one exception, unavoidable once captures are tracked, is
// `slots`: a thread RECORDED into a `ThreadList` gets its own snapshot
// (`snapshotSlots`), because it has to outlive the closure walk that
// produced it. The walk itself allocates nothing — see CAPTURES below.
//
// WHY THE WALK MUST NOT COPY PER `Save` (#3629). It used to: every `Save`
// reached during the epsilon closure allocated a fresh `numSlots` array and
// copied into it. A pattern of `d` nested capturing groups —
// `(((...a...)))` — has `2d` `Save` instructions and `numSlots == 2(d+1)`,
// so ONE closure walk did `2d` copies of a `2d+2` array: O(d^2) int copies
// and O(d) allocations per input position, hence O(n*d^2) per search. A
// 893-byte, 446-deep pattern took minutes on a 4 KiB subject — a
// denial-of-service primitive for any caller that compiles and runs an
// untrusted pattern, and a direct contradiction of the linear-time promise
// at the top of this file, which bounds the walk by `len(prog)` alone.
//
// CAPTURES: every RECORDED thread carries a `slots` array (`Thread` below)
// alongside its program counter — `-1` in a slot no `Save` has reached yet.
// `runPike` returns the winning thread's slots on a match, so `matches`,
// `find` and `findAll` (regex.bit) all share this one function; `matches`
// simply discards the slots and keeps the boolean.
//
// DURING the closure walk there is no per-thread array at all: one scratch
// array, `PikeCtx.cur`, holds the capture state at the walk's current point
// and is mutated in place by `Save` and undone on the way back out (the
// `undoSlot`/`undoVal` entries in `PcStack`). That is sound because the walk
// is a depth-first traversal — the arms of a `Split` are explored one after
// the other, never interleaved — so restoring the one slot a `Save` wrote,
// after its subtree is drained, puts `cur` back exactly as the next arm must
// see it. This is Go's `regexp` design (`exec.go`'s `add`, which sets
// `t.cap[i.Arg]`, recurses, then writes `opos` back) done with an explicit
// stack instead of recursion, so a deeply nested pattern still cannot
// overflow the native stack.
class Thread { pc: int, slots: []int }

// A per-position "already visited" set, keyed by program counter: the
// classic sparse/dense pair. `pcSetHas`/`pcSetMark` are both O(1), and
// `pcSetClear` is O(1) too — it only resets `count`, never scrubs `dense` or
// `sparse`, which is safe because membership re-checks `dense[sparse[pc]] ==
// pc`, so a stale leftover from a previous position can never read as
// present.
class PcSet { sparse: []int, dense: []int, count: int }

fn newPcSet(numInsts: int): PcSet {
  return PcSet{ sparse: []int(numInsts), dense: []int(numInsts), count: 0 }
}

fn pcSetHas(set: PcSet, pc: int): bool {
  let idx = set.sparse[pc]
  return idx < set.count && set.dense[idx] == pc
}

// Caller must already have checked `!pcSetHas(set, pc)`.
fn pcSetMark(set: PcSet, pc: int) {
  set.sparse[pc] = set.count
  set.dense[set.count] = pc
  set.count = set.count + 1
}

fn pcSetClear(set: PcSet) {
  set.count = 0
}

// The threads live at one input position. `threads[0:count]` are the
// "blocking" instructions (Char/Class/Any/Match) this position's epsilon
// closure reached, in priority order — index 0 is tried first, which is
// what makes alternation and the greedy/lazy quantifiers resolve
// leftmost-first rather than leftmost-longest (prog.bit's `Split` always
// offers its `x` arm before its `y`). `visited` is the closure's dedupe set
// and covers every pc walked this position, including the epsilon-only ones
// that never themselves land in `threads`.
class ThreadList { threads: []Thread, count: int, visited: PcSet }

fn newThreadList(numInsts: int): ThreadList {
  return ThreadList{ threads: []Thread(numInsts), count: 0, visited: newPcSet(numInsts) }
}

fn threadListClear(tl: ThreadList) {
  tl.count = 0
  pcSetClear(tl.visited)
}

// `r`'s classification for `\b`/`\B`: `[0-9A-Za-z_]`, per the ticket's fixed
// definition — not `charclass.bit`'s `ccWord()`, which re-normalizes (and so
// re-allocates) a fresh `CharClass` on every call, exactly the per-position
// allocation this file's header rules out.
fn isWordRune(r: rune): bool {
  return (r >= rune('0') && r <= rune('9')) ||
    (r >= rune('A') && r <= rune('Z')) ||
    (r >= rune('a') && r <= rune('z')) ||
    r == rune('_')
}

// The sentinel "no rune here" value — before the start of the string, or
// after its end. `rune` is `i32` (SPEC §5.4), so `-1` can never collide with
// a real Unicode scalar value (always `>= 0`).
const noRune: rune = -1

// `before`/`after` are the runes immediately preceding/following the
// position this assertion is evaluated at (`noRune` past either edge).
// `BeginLine`/`EndLine` only ever reach here when `(?m)` was active at the
// `^`/`$` that produced them (`parse.bit`'s `beginAnchorKind`/`endAnchorKind`
// choose the AnchorKind positionally, at parse time) — so unlike `BeginText`/
// `EndText`, they also hold right after/before a `\n`, not only at the
// absolute start/end of the subject. `\A`/`\z` always parse to `BeginText`/
// `EndText` (`parsecursor.bit`'s `escapeAnchorFor`), so they never see this
// `\n`-aware branch regardless of `(?m)`.
fn assertHolds(kind: AnchorKind, before: rune, after: rune): bool {
  if (kind == AnchorKind.BeginText) {
    return before == noRune
  }
  if (kind == AnchorKind.EndText) {
    return after == noRune
  }
  if (kind == AnchorKind.BeginLine) {
    return before == noRune || before == rune('\n')
  }
  if (kind == AnchorKind.EndLine) {
    return after == noRune || after == rune('\n')
  }
  let wordBefore = isWordRune(before)
  let wordAfter = isWordRune(after)
  if (kind == AnchorKind.WordBoundary) {
    return wordBefore != wordAfter
  }
  return wordBefore == wordAfter // NoWordBoundary
}

// An independent copy of `slots`, taken when a thread is RECORDED into a
// `ThreadList` — the one place a capture state has to outlive the walk that
// built it, since `PikeCtx.cur` keeps being mutated afterwards. Bounded by
// `len(slots)`, which is `prog.numSlots`, fixed per pattern at compile time,
// and taken at most once per recorded thread (so at most `len(prog)` times
// per input position) — never once per `Save`, which is what made this
// quadratic in nesting depth before #3629.
fn snapshotSlots(slots: []int): []int {
  let out = []int(len(slots))
  let i = 0
  // Bounded by `len(slots)` == `prog.numSlots`, fixed at compile time.
  while (i < len(slots)) {
    out[i] = slots[i]
    i = i + 1
  }
  return out
}

// Resets the walk's scratch capture state to `src` — `addThread`'s first
// act, so each closure walk starts from exactly the capture state of the
// thread that seeded it. `dst` is `PikeCtx.cur`, allocated once per
// `runPike`; both are `prog.numSlots` long by construction.
fn loadSlots(dst: []int, src: []int) {
  let i = 0
  // Bounded by `len(dst)` == `prog.numSlots`, fixed at compile time.
  while (i < len(dst)) {
    dst[i] = src[i]
    i = i + 1
  }
}

// The explicit closure stack (`addThread` never recurses — a pattern nests
// arbitrarily deep, and a recursive closure walk is a stack-overflow crash
// on ordinary user input, not just a hostile one). `sp` lives on the class,
// Pascal-style (mutated in place, like `RegexParser.pos` elsewhere in this
// module), so the many small functions below that push/pop don't have to
// thread it through as a return value on top of everything else they need
// (keeping each at or under the five-parameter lint ceiling, E0202).
//
// THREE PARALLEL `[]int`s, not one `[]Thread`: an entry is either a pc to
// visit (`undoSlot == noUndo`) or an UNDO record left behind by a `Save`
// (`undoSlot >= 0`, meaning "put `undoVal` back into `PikeCtx.cur` at that
// index"). Plain ints mean a push allocates nothing at all — the old
// `[]Thread` form built one heap object per push, on top of the per-`Save`
// array copy #3629 removed.
class PcStack { pcs: []int, undoSlot: []int, undoVal: []int, sp: int }

// `PcStack.undoSlot`'s "this entry is a pc to visit, not an undo record".
// A real slot index is always `>= 0` (`prog.bit`'s `instSave`), so `-1`
// cannot collide with one.
const noUndo: int = -1

fn newPcStack(capacity: int): PcStack {
  return PcStack{
    pcs: []int(capacity),
    undoSlot: []int(capacity),
    undoVal: []int(capacity),
    sp: 0,
  }
}

// Pushes "visit `pc`", asserting the stack (sized by `runPike`, see its
// comment) never overflows — a bounded resource, checked, per the
// Power-of-Ten rule this whole VM is built to satisfy.
fn stackPush(stack: PcStack, pc: int) {
  assert(stack.sp < len(stack.pcs), "regex: pike VM closure stack overflow")
  stack.pcs[stack.sp] = pc
  stack.undoSlot[stack.sp] = noUndo
  stack.sp = stack.sp + 1
}

// Pushes "restore `cur[slot]` to `val`". Pushed by `Save` BEFORE its
// successor, so it pops LAST — after everything that successor's subtree
// pushed on top of it has drained, which is exactly when the arm that wrote
// `cur[slot]` is finished with it.
fn stackPushUndo(stack: PcStack, slot: int, val: int) {
  assert(stack.sp < len(stack.pcs), "regex: pike VM closure stack overflow")
  stack.undoSlot[stack.sp] = slot
  stack.undoVal[stack.sp] = val
  stack.sp = stack.sp + 1
}

// The values that stay fixed for every `addThread`/`addThreadStep` call
// within one `runPike` invocation, plus `pos`: the current byte offset a
// `Save` reached this closure walk should record. `runPike` mutates `pos`
// once per input position (before seeding a start thread) and once more
// per position (before extending survivors into `nlist`), same Pascal-style
// pattern as `PcStack.sp`. Bundled so those functions stay at or under the
// five-parameter ceiling without paying for extra parameters per call.
//
// `cur` is the walk's single scratch capture array (see CAPTURES at the top
// of this file): `prog.numSlots` long, allocated once per `runPike`, reset
// by `addThread` from whichever thread seeded the walk, mutated in place by
// `Save` and undone by `PcStack`'s undo records. It is walk-local scratch,
// never handed out — a recorded thread gets `snapshotSlots(cur)`.
class PikeCtx { prog: Prog, stack: PcStack, pos: int, cur: []int }

// Resolves one pc reached during the epsilon closure: pushes its
// successor(s) for the epsilon ops (`Jump`, `Split`, `Save`, a satisfied
// `Assert`), or records it as a real thread in `tl.threads` for the rest
// (`Char`/`Class`/`Any`/`Match`). `Split` pushes `y` before `x` so `x` pops
// first — the priority order `prog.bit` promises. `Save` writes `ctx.pos`
// into `ctx.cur[inst.slot]` in place, after pushing the undo record that
// puts the old value back once its successor's subtree has drained.
fn addThreadStep(tl: ThreadList, pc: int, before: rune, after: rune, ctx: PikeCtx) {
  let inst = ctx.prog.insts[pc]
  if (inst.op == Op.Jump) {
    stackPush(ctx.stack, inst.x)
    return
  }
  if (inst.op == Op.Split) {
    stackPush(ctx.stack, inst.y)
    stackPush(ctx.stack, inst.x)
    return
  }
  if (inst.op == Op.Save) {
    stackPushUndo(ctx.stack, inst.slot, ctx.cur[inst.slot])
    ctx.cur[inst.slot] = ctx.pos
    stackPush(ctx.stack, pc + 1)
    return
  }
  if (inst.op == Op.Assert) {
    if (assertHolds(inst.kind, before, after)) {
      stackPush(ctx.stack, pc + 1)
    }
    return
  }
  tl.threads[tl.count] = Thread{ pc: pc, slots: snapshotSlots(ctx.cur) }
  tl.count = tl.count + 1
}

// Walks the epsilon closure of `start` into `tl`, iteratively via
// `ctx.stack` — never recursively (see `PcStack`'s doc comment).
fn addThread(tl: ThreadList, start: Thread, before: rune, after: rune, ctx: PikeCtx) {
  loadSlots(ctx.cur, start.slots)
  stackPush(ctx.stack, start.pc)
  // Bounded: each iteration pops one entry, and a push only ever nets +1 —
  // a `Split` (two successors) or a `Save` (an undo record plus its
  // successor), and only the FIRST time that pc is visited, since every
  // later pop of it is a dead end via `pcSetHas` below. So total growth is
  // bounded by the program's own Split-plus-Save count, and an undo record
  // pops without pushing anything at all.
  while (ctx.stack.sp > 0) {
    ctx.stack.sp = ctx.stack.sp - 1
    let sp = ctx.stack.sp
    let undo = ctx.stack.undoSlot[sp]
    if (undo != noUndo) {
      ctx.cur[undo] = ctx.stack.undoVal[sp]
      continue
    }
    let pc = ctx.stack.pcs[sp]
    if (pcSetHas(tl.visited, pc)) {
      continue
    }
    pcSetMark(tl.visited, pc)
    addThreadStep(tl, pc, before, after, ctx)
  }
}

// Whether `inst` (one of `clist`'s recorded threads, so
// `Char`/`Class`/`Any`/`AnyNL`) accepts rune `r`. `Any` is RE2/Go's default
// `.`: any rune except `\n`. `AnyNL` is `(?s)`'s dotall `.`: every rune,
// `\n` included — `parse.bit`'s `dotAst` picks which one a given `.` compiles
// to, at parse time, so this never consults a flag itself.
fn instAccepts(inst: Inst, r: rune): bool {
  if (inst.op == Op.Char) {
    return inst.ch == r
  }
  if (inst.op == Op.Class) {
    return ccContains(inst.cls, r)
  }
  if (inst.op == Op.AnyNL) {
    return true
  }
  return r != rune('\n') // Op.Any
}

// Scans `clist` (already-closed, priority order) against `r` (`noRune` past
// the end of input), seeding `nlist` with every survivor via its own closure
// walk (`addThread`, contextualized by `r`/`nextAfter` for the position
// `nlist` belongs to). Returns `(true, slots)` the instant a `Match` is
// reached: under leftmost-first priority, no lower-index thread in `clist`
// can ever beat a match a higher-priority one already reached, so scanning
// further here can only waste work, never change the answer.
fn stepClist(
  clist: ThreadList,
  nlist: ThreadList,
  r: rune,
  nextAfter: rune,
  ctx: PikeCtx,
): (bool, []int) {
  let i = 0
  // Bounded by `clist.count`, fixed at loop entry — filling `nlist` never
  // changes it.
  while (i < clist.count) {
    let th = clist.threads[i]
    let inst = ctx.prog.insts[th.pc]
    if (inst.op == Op.Match) {
      return true, th.slots
    }
    if (r != noRune && instAccepts(inst, r)) {
      addThread(nlist, Thread{ pc: th.pc + 1, slots: th.slots }, r, nextAfter, ctx)
    }
    i = i + 1
  }
  return false, []int(0)
}

// Decodes the rune at byte `pos` of `s` and returns it with the number of
// bytes it occupies — `(noRune, 1)` at or past `len(s)`, so the VM can tell
// "no more input" apart from a genuine malformed-byte U+FFFD.
//
// Delegates the actual decode (and its malformed-input handling: a lead
// byte that is never valid, or a valid lead byte followed by a bad
// continuation byte, both correctly consuming 1 byte and producing U+FFFD)
// to `std/strings`' `decodeRuneAt`, rather than duplicating that validation
// here — see that function's doc comment for why pairing `runeAt` with
// `runeSize` instead would desync this position from what was decoded.
fn stepRune(s: string, pos: int): (rune, int) {
  if (pos >= len(s)) {
    return noRune, 1
  }
  return decodeRuneAt(s, pos)
}

// The rune immediately before byte offset `pos` in `s` — `noRune` when `pos
// <= 0` (nothing precedes the start of the string). A fresh search (`find`,
// `matches`, and `findAll`'s very first call) always starts at `pos == 0`
// and never needs this; `findAll`'s later calls resume mid-string, where an
// anchor like `^` or `\b` must see the REAL preceding character, not
// "nothing yet". Scans backward at most 4 bytes — the longest a UTF-8
// sequence can be (`decodeRune`'s own limit) — to find that rune's lead
// byte (a lead byte's top two bits are never `10`, unlike a continuation
// byte's), so this is O(1) per call, not a rescan of everything before
// `pos`.
fn runeBeforePos(s: string, pos: int): rune {
  if (pos <= 0) {
    return noRune
  }
  let start = pos - 1
  let floor = 0
  if (pos - 4 > floor) {
    floor = pos - 4
  }
  // Bounded: at most 4 steps back from `pos`.
  while (start > floor && (int(s[start]) & 0xC0) == 0x80) {
    start = start - 1
  }
  let (r, _) = decodeRuneAt(s, start)
  return r
}

// `numSlots` slots, all unset (`-1`) — the capture state a brand-new start
// thread begins with, seeded fresh at every input position an unanchored
// search tries starting from.
fn freshSlots(numSlots: int): []int {
  let out = []int(numSlots)
  let i = 0
  while (i < numSlots) {
    out[i] = -1
    i = i + 1
  }
  return out
}

// Runs `prog` against `s`, searching for the leftmost-first unanchored match
// starting at or after byte offset `startAt` — the standard `.*?`-prefix trick:
// a fresh start thread (`pc 0`) is seeded at every position from `startAt`
// onward, at the LOWEST priority (appended after whatever already-in-progress
// threads are carried over), UNTIL a match is found. That priority ordering
// is what makes the search leftmost: an already-started attempt always
// outranks one that would start later, and once matched, no new start is
// ever seeded again — the other half of "leftmost".
//
// Reaching `Match` does NOT return immediately: `stepClist` cuts off only the
// threads AFTER it in `clist` (strictly lower priority — they can never beat
// a match already found), but anything already forwarded into `nlist` (from
// indices BEFORE the match, so strictly HIGHER priority) is still alive and
// may reach its own, better `Match` later — that is exactly how a greedy `a+`
// keeps extending past its first, shortest possible match. `matchSlots` is
// unconditionally overwritten on every later match found this way, which is
// correct rather than arbitrary: every thread still in `nlist` when a match
// is recorded was, by construction, of strictly higher priority than that
// match's own thread, so a later match can only ever come from a
// higher-priority lineage than the one it replaces. This is only safe to
// stop early once `nlist` is empty — nothing left can possibly outrank the
// recorded match — which is the `matched && nlist.count == 0` check below;
// while unmatched, an empty `nlist` means nothing YET, not never, since a
// fresh seed at the next position is still owed.
//
// Returns `(matched, slots)`. `matches`/`find` always pass `startAt: 0`;
// `findAll` (regex.bit) passes the previous match's end (or one rune past
// it, for an empty match) to find the next non-overlapping one — so this one
// function is the whole VM entry point all three go through.
//
// All VM scratch state is allocated exactly once here, per call (this
// file's header). `ctx.stack` is sized `numInsts + 1`: `addThread`'s own
// bound (its comment) shows the closure stack can never hold more than one
// entry per Split-or-Save instruction plus the one initial push, and no
// instruction is both.
//
// `pf` (`prefilter.bit`, #2052) gates only whether a FRESH start thread is
// seeded at a given position — it never affects a thread already carried
// over in `nlist`, so it can only skip positions `pf` has proven cannot
// begin a match, never change which match is found once seeding begins.
// `noPrefilter()`'s `pf.kind == PrefilterKind.None` makes
// `isCandidateStart` unconditionally `true`, so this is byte-for-byte the
// pre-#2052 search whenever the caller passes it.
fn runPike(prog: Prog, s: string, startAt: int, pf: Prefilter): (bool, []int) {
  let numInsts = len(prog.insts)
  let n = len(s)
  let clist = newThreadList(numInsts)
  let nlist = newThreadList(numInsts)
  let ctx = PikeCtx{
    prog: prog,
    stack: newPcStack(numInsts + 1),
    pos: startAt,
    cur: []int(prog.numSlots),
  }
  let pos = startAt
  let before = runeBeforePos(s, startAt)
  let matched = false
  let matchSlots: []int = []int(0)
  // Bounded: `pos` strictly increases by the decoded rune's byte width
  // (>= 1) every iteration that does not return — at most `n - startAt + 1`
  // positions are ever visited.
  while (pos <= n) {
    let (after, width) = stepRune(s, pos)
    if (!matched && isCandidateStart(pf, s, pos)) {
      ctx.pos = pos
      addThread(clist, Thread{ pc: 0, slots: freshSlots(prog.numSlots) }, before, after, ctx)
    }
    // The linearity invariant, once per input position (never per VM
    // step): if the sparse-set dedupe above is ever removed, this is what
    // catches it — the one refactor that silently turns this engine
    // exponential while every functional test stays green.
    assert(clist.count <= numInsts, "regex: pike VM thread count exceeded program size")
    let nextPos = pos + width
    let (nextAfter, _) = stepRune(s, nextPos)
    ctx.pos = nextPos
    let (stepMatched, stepSlots) = stepClist(clist, nlist, after, nextAfter, ctx)
    if (stepMatched) {
      matched = true
      matchSlots = stepSlots
    }
    if (matched && nlist.count == 0) {
      return true, matchSlots
    }
    if (after == noRune) {
      return matched, matchSlots
    }
    threadListClear(clist)
    let tmp = clist
    clist = nlist
    nlist = tmp
    before = after
    pos = nextPos
  }
  return matched, matchSlots
}
