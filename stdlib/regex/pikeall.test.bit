// stdlib/regex/pikeall.test.bit — the multi-match scan is ONE pass (#3866).
//
// The functional answers `findAll` produces are already pinned, far more
// thoroughly than anything here could, by Go's own `findTests` table
// (`_tests_/imports/regexconform/`, 88 vectors). What that corpus cannot see
// is COST: every one of its subjects is short enough that the quadratic
// restart loop this ticket removed passed it in microseconds. So the load
// bearing assertion here is a step count, not a match list.
//
// `PikeScratch.steps` (pike.bit) is the VM's input-position counter. A
// single search has always been linear — #3832 measured `n+1` positions for
// exactly the pattern and subject below — so a per-match RESTART is the only
// way to make the whole scan quadratic, and it is also the only way to push
// this counter above `len(s) + 1`. Reintroduce one anywhere in `runPikeAll`
// and the first assertion reads 7,910,253 instead of 3,977.

import { repeat } from "std/strings"

// #3832's worst offender, verbatim: `numInsts == 30`, and the higher
// priority `(.+?\d+I)+` branch stays alive to the end of input at every
// position without ever completing (the subject has digits but no `I`),
// while the lower-priority `\w*?[0-9]*?` branch matches empty almost
// everywhere. That combination is what made each restarted search re-walk
// the whole remaining suffix.
fn quadraticRepro(): string {
  return "([^a-z0-9]*.*)?\\w?(.+?\\d+I)+|\\w*?[0-9]*?"
}

// tools/fuzz/regexdifffuzz/subject.bit's fixed 4 KiB `block4k` subject,
// 3976 bytes, reproduced here so this test does not depend on a fuzz tool.
fn block4k(): string {
  return repeat("The quick brown fox jumps over the lazy dog 0123456789. ", 71)
}

test "the whole findAll scan visits len(s)+1 input positions, once each" {
  let s = block4k()
  let n = len(s)
  assert(n == 3976, "block4k is ${n} bytes, want 3976")
  let re = mustCompile(quadraticRepro())
  let sc = newPikeScratch(re.prog)
  let all = runPikeAll(re.prog, s, re.prefilter, sc, -1)
  // The bound this ticket bought. `(n+1)(n+2)/2 == 7910253` was the measured
  // restart cost for this exact pair (pike.bit's `#3832` block).
  assert(sc.steps == n + 1, "scan visited ${sc.steps} positions, want ${n + 1}")
  // And it still finds every match: the lazy branch matches empty at every
  // position, so one per position including the one past the last byte.
  assert(len(all) == n + 1, "scan found ${len(all)} matches, want ${n + 1}")
}

test "findAll agrees with the scan it is built on" {
  let s = block4k()
  let re = mustCompile(quadraticRepro())
  let ms = re.findAll(s, -1)
  assert(len(ms) == len(s) + 1, "findAll returned ${len(ms)} matches, want ${len(s) + 1}")
  let last = ms[len(ms) - 1]
  assert(last.start == len(s) && last.end == len(s), "last match [${last.start},${last.end})")
}

test "a limit stops the scan without changing the matches it does return" {
  let re = mustCompile("[a-z]+")
  let s = "one two three four"
  let all = re.findAll(s, -1)
  let two = re.findAll(s, 2)
  assert(len(all) == 4, "unlimited findAll returned ${len(all)}, want 4")
  assert(len(two) == 2, "findAll(limit 2) returned ${len(two)}, want 2")
  assert(
    two[0].start == all[0].start && two[0].end == all[0].end,
    "first match differs under a limit",
  )
  assert(
    two[1].start == all[1].start && two[1].end == all[1].end,
    "second match differs under a limit",
  )
}

test "a deduped empty match still cuts the seed's lower-priority arms" {
  // THE ONE CASE A CONTINUOUS PASS GETS WRONG IF IT TRUSTS `clist` ALONE
  // (pikeall.bit's `probeEmptyMatch`). After `c` matches `[0,1)`, a fresh
  // search from offset 1 would find `a*?`'s empty match `[1,1)` — rejected
  // as the echo of the match that just ended there — and its own `stepClist`
  // would cut the lower-priority `Char a` thread behind it, so the next
  // reported match is the empty one at end of input. In one continuous pass
  // that empty match is INVISIBLE: the program has one `Match` pc and the
  // winning `c` thread reached it first, so the sparse-set dedupe drops the
  // seed's path to it. A scan that therefore lets the `Char a` thread live
  // reports "a" here — one match too many, at an offset Go never reports.
  let re = mustCompile("c|a*?")
  let ms = re.findAll("ca", -1)
  assert(len(ms) == 2, "findAll(\"c|a*?\", \"ca\") returned ${len(ms)} matches, want 2")
  assert(
    ms[0].start == 0 && ms[0].end == 1,
    "first match [${ms[0].start},${ms[0].end}), want [0,1)",
  )
  assert(
    ms[1].start == 2 && ms[1].end == 2,
    "second match [${ms[1].start},${ms[1].end}), want [2,2)",
  )
  assert(re.replaceAll("ca", "-") == "-a-", "replaceAll disagrees with findAll")
}

test "the empty-match rules survive the move to one pass" {
  let star = mustCompile("a*")
  let bb = star.findAll("bb", -1)
  assert(len(bb) == 3, "a* over \"bb\" gave ${len(bb)} matches, want 3 (offsets 0,1,2)")
  // The echo Go's regexp.go:768 rejects: no empty `[6,6)` after `[0,6)`.
  let dot = mustCompile(".*")
  let abc = dot.findAll("abcdef", -1)
  assert(len(abc) == 1, ".* over \"abcdef\" gave ${len(abc)} matches, want 1")
  // A multi-byte character is advanced over whole, never split.
  let empty = mustCompile("")
  let runes = empty.findAll("héllo", -1)
  assert(len(runes) == 6, "the empty pattern over \"héllo\" gave ${len(runes)} matches, want 6")
  assert(runes[2].start == 3, "third empty match at ${runes[2].start}, want 3 (past the 2-byte é)")
}
