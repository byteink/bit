// Bit standard library — regex module, counted repetition `{n}` / `{n,}` /
// `{n,m}`, both greedy and lazy (`{n,m}?`), and the per-count size cap.
//
// Grammar and error/literal boundary verified against real Go 1.27
// (`go run`, `regexp.Compile`) rather than assumed — #2031's ticket text
// asked for a THIRD error, `regex: invalid repeat count` on "a non-numeric
// or empty count", that Go itself does not produce: every syntactically
// malformed `{...}` — no leading digit (`{,3}`, `{}`, bare `{`), garbage
// where `,`/`}` is expected (`{3,x}`, `{3,,}`, `{3,5x}`), or unterminated
// (`{3`, `{3,`) — compiles as a LITERAL `{` in Go, never a compile error.
// Only two things Go actually rejects once the shape genuinely matches
// `{n[,[m]]}`: a count over its own cap (`{1001}` — Go's cap is 1000, same
// as this ticket's) and `n > m` (`{5,2}`). This file reproduces exactly
// that boundary — `tryCountedRepeat` returns "not a repeat" (no error, no
// cursor movement) for every malformed shape, and only ever fails for
// those two genuine cases.
//
// Go's parser also disallows a leading zero followed by another digit
// (`{03}` is literal, not `{3}`) — `scanRepeatCount` reproduces that too,
// so a count never has two readings.
//
// The expansion this unlocks (`prog.bit`'s `compileRepeatCounted`) is
// exponential in nesting, so the count itself is capped here, at PARSE
// time, before any expansion is attempted: `maxRepeatCount` (1000) bounds
// what a single `{n}`/`{n,}`/`{n,m}` can ask for, independent of
// `prog.bit`'s own running instruction-count cap over the whole compiled
// program.

// The largest value a single `{n}`, or either bound of a `{n,m}`, may hold.
// Matches Go's `regexp/syntax` (`maxRepeat = 1000`) exactly — verified with
// `go run`: `a{1000}` compiles, `a{1001}` fails "invalid repeat count".
const maxRepeatCount: int = 1000

// Once a scanned decimal value would exceed this, `scanRepeatCount` stops
// accumulating rather than risk overflowing `int` — a pattern's own length
// cap (4096 bytes) still allows a digit run thousands of characters long.
// Comfortably above `maxRepeatCount` and comfortably below any risk of
// overflow on the next `* 10 + 9`, so the exact value never matters: every
// count that reaches this guard already fails `n > maxRepeatCount`.
const repeatCountOverflowGuard: int = 1000000

const errRepeatCountTooLarge: string = "regex: repeat count too large (max 1000)"
const errRepeatCountOutOfOrder: string = "regex: repeat count out of order"

// The result of scanning one decimal count (`n` or `m`): the value, the
// offset one past its last digit, whether it was a well-formed digit run at
// all, and whether it was too long to trust the accumulated `value` (see
// `repeatCountOverflowGuard`). Bundled into one class — rather than four
// separate return values threaded through every caller — to keep every
// `finish*` helper below at or under the five-parameter lint ceiling
// (E0202).
class RepeatCount { value: int, endPos: int, ok: bool, overflowed: bool }

// Scans a decimal digit run starting at absolute offset `pos` in `p.src`
// (the caller has already checked `p.src[pos]` is a digit). `ok` is false
// only for the leading-zero case (`03`, `007` — a `0` immediately followed
// by another digit): Go disallows it so a count never has two readings, and
// a lone `0` (nothing after it, e.g. `{0}`) is unaffected. Bounded by
// `p.n - pos`, since every iteration consumes one byte.
fn scanRepeatCount(p: RegexParser, pos: int): RepeatCount {
  if (p.src[pos] == '0' && pos + 1 < p.n && isAsciiDigit(p.src[pos + 1])) {
    return RepeatCount{ value: 0, endPos: pos, ok: false, overflowed: false }
  }
  let value = 0
  let overflowed = false
  let cur = pos
  while (cur < p.n && isAsciiDigit(p.src[cur])) {
    if (value > repeatCountOverflowGuard) {
      overflowed = true
    } else {
      value = value * 10 + int(p.src[cur] - '0')
    }
    cur = cur + 1
  }
  return RepeatCount{ value: value, endPos: cur, ok: true, overflowed: overflowed }
}

// `{n}`: exactly `n`. Fails `errRepeatCountTooLarge` when `n` is out of
// range; otherwise consumes through the closing `}` and reports `(n, n)`.
fn finishExactCount(p: RegexParser, n: RepeatCount, closeAt: int): (bool, int, int)! {
  if (n.overflowed || n.value > maxRepeatCount) {
    fail parseErr(errRepeatCountTooLarge, p.pos)
  }
  p.pos = closeAt
  return true, n.value, n.value
}

// `{n,}`: `n` or more. Same size check as `finishExactCount`; reports
// `(n, -1)` — `-1` is `RepeatNode.max`'s existing "unbounded" sentinel,
// already used by `*`/`+` (ast.bit).
fn finishUnboundedCount(p: RegexParser, n: RepeatCount, closeAt: int): (bool, int, int)! {
  if (n.overflowed || n.value > maxRepeatCount) {
    fail parseErr(errRepeatCountTooLarge, p.pos)
  }
  p.pos = closeAt
  return true, n.value, -1
}

// `{n,m}`: between `n` and `m`. Both bounds are size-checked, then ordering
// (`n > m` — `errRepeatCountOutOfOrder`, verified against Go's `{5,2}`
// rejection); only once both pass does this consume through `}`.
fn finishRangeCount(
  p: RegexParser,
  n: RepeatCount,
  m: RepeatCount,
  closeAt: int,
): (bool, int, int)! {
  if (n.overflowed || m.overflowed || n.value > maxRepeatCount || m.value > maxRepeatCount) {
    fail parseErr(errRepeatCountTooLarge, p.pos)
  }
  if (n.value > m.value) {
    fail parseErr(errRepeatCountOutOfOrder, p.pos)
  }
  p.pos = closeAt
  return true, n.value, m.value
}

// Attempts to parse a counted repetition starting at the `{` under the
// cursor (`p.pos`, not yet consumed). Returns `(false, 0, 0)` and leaves
// `p.pos` completely untouched for anything that is not a well-formed
// `{n[,[m]]}` — the caller then falls through to the ordinary "no
// quantifier here" path, which is what leaves a lone `{` (or `{,m}`, or any
// other malformed brace) to be picked up as a literal by
// `parseAnchorOrLiteral`. Only a syntactically complete `{n[,[m]]}` reaches
// the three `finish*` helpers, which are the only paths that can fail.
fn tryCountedRepeat(p: RegexParser): (bool, int, int)! {
  let start = p.pos + 1
  if (start >= p.n || !isAsciiDigit(p.src[start])) {
    return false, 0, 0
  }
  let n = scanRepeatCount(p, start)
  if (!n.ok || n.endPos >= p.n) {
    return false, 0, 0
  }
  if (p.src[n.endPos] == '}') {
    return finishExactCount(p, n, n.endPos + 1)?
  }
  if (p.src[n.endPos] != ',') {
    return false, 0, 0
  }
  return tryCountedRepeatTail(p, n, n.endPos + 1)?
}

// The part of the grammar after `{n,`: either an immediate `}` (`{n,}`,
// unbounded) or a second digit run followed by `}` (`{n,m}`). Split out of
// `tryCountedRepeat` to keep both under the complexity ceiling (E0204).
fn tryCountedRepeatTail(p: RegexParser, n: RepeatCount, afterComma: int): (bool, int, int)! {
  if (afterComma >= p.n) {
    return false, 0, 0
  }
  if (p.src[afterComma] == '}') {
    return finishUnboundedCount(p, n, afterComma + 1)?
  }
  if (!isAsciiDigit(p.src[afterComma])) {
    return false, 0, 0
  }
  let m = scanRepeatCount(p, afterComma)
  if (!m.ok || m.endPos >= p.n || p.src[m.endPos] != '}') {
    return false, 0, 0
  }
  return finishRangeCount(p, n, m, m.endPos + 1)?
}

// `tryCountedRepeat` already consumed the whole `{n[,[m]]}`; this just
// checks for the trailing lazy `?` — same shape as `parse.bit`'s
// `finishRepeat`, which does the same thing after consuming `*`/`+`/`?`.
fn applyCountedRepeat(p: RegexParser, atom: Ast, min: int, max: int): Ast {
  let greedy = true
  if (!atEnd(p) && curByte(p) == '?') {
    advanceByte(p)
    greedy = false
  }
  return Ast.Repeat(RepeatNode{ min: min, max: max, greedy: greedy, sub: atom })
}
