// Bit standard library — regex module, `[...]` bracket-expression parsing.
//
// A class body is a run of members — a single rune, a `lo-hi` range, a `\d`
// -style shorthand, a `[:name:]` POSIX name, or a `\p{...}`/`\P{...}`
// Unicode property (#2032) — until an unescaped `]`. Following the POSIX
// bracket-expression convention Go's `regexp/syntax` also honors: a `]`
// that is the very FIRST member (right after `[` or `[^]`) is a literal
// `]`, not the closer — so `[]a]` matches `]` or `a`, and `[]` alone is
// `regex: missing closing ]` (the lone `]` was consumed as a literal, and
// nothing then closes the class).
//
// `\b` inside a class is treated the same as any other unrecognized
// alphanumeric escape (`regex: invalid escape sequence`), NOT as a backspace
// literal the way Perl/PCRE read it — deliberately narrower than those
// engines rather than guessing at a meaning nothing in #2026 pins down.
//
// A `[:` that never reaches a matching `:]` is NOT a syntax error (#3831,
// verified against go1.26.6's `regexp/syntax`): `[[:alpha]]+` has no `:]`
// anywhere in the pattern at all, so Go falls back to treating `[`, `:`,
// `a`, `l`, `p`, `h`, `a` as ordinary literal class members, closing at the
// first bare `]` — the SAME first-`]`-is-the-closer rule as any other class.
// `tryParsePosixClass` below implements that fallback; see its own comment
// for the (surprising, but Go-verified) rule that the search for `:]`
// spans the REST OF THE WHOLE PATTERN, not just this class body.

// One member of a class body, not yet folded into the accumulator:
// `isSingle` says whether it is a single rune usable as a range endpoint
// (`r`), or a multi-range contribution that is not (`contributed` — a `\d`
// shorthand, a `[:name:]` POSIX class, or a `\p{...}` property, which
// `mergeClassItem` unions in directly rather than ever treating as one side
// of a `lo-hi` range).
class classItem { isSingle: bool, r: rune, contributed: CharClass }

// `[`, already known present; parses through the matching `]`. Under `(?i)`
// (`flags.i`), folds the finished class to its full Unicode fold-closure
// BEFORE negating — folding after negation would fold the complement
// instead of the set the pattern named (`ccFold`'s doc comment,
// charclass.bit).
fn parseClass(p: RegexParser, flags: RegexFlags): Ast! {
  let openPos = p.pos
  advanceByte(p)
  let negated = false
  if (!atEnd(p) && curByte(p) == '^') {
    negated = true
    advanceByte(p)
  }
  let acc = parseClassBody(p, openPos, flags)?
  let cc = ccNormalize(acc)
  if (flags.i) {
    cc = ccFold(cc)
  }
  if (negated) {
    cc = ccNegate(cc)
  }
  return Ast.Class(cc)
}

// The members between `[`/`[^` and the closing `]`, unioned together
// (unnormalized — `parseClass` normalizes once, at the end).
fn parseClassBody(p: RegexParser, openPos: int, flags: RegexFlags): CharClass! {
  let acc = ccEmpty()
  let first = true
  // Bounded: `parseClassMember` always consumes >= 1 byte.
  while (!classBodyDone(p, first)) {
    acc = parseClassMember(p, acc, first, openPos, flags)?
    first = false
  }
  if (atEnd(p)) {
    fail parseErr(errMissingCloseBracket, openPos)
  }
  advanceByte(p)
  return acc
}

// Whether the class body loop should stop: at end of input (the caller
// reports the missing `]`), or on an unescaped `]` that is not the very
// first member (the POSIX first-`]`-is-literal rule above).
fn classBodyDone(p: RegexParser, first: bool): bool {
  if (atEnd(p)) {
    return true
  }
  return curByte(p) == ']' && !first
}

// One member: the POSIX first-`]`-literal special case, a `[:name:]` POSIX
// class, or an ordinary item (`parseClassItem`, folded in by
// `mergeClassItem`, which also handles `-` ranges). A `[:` that
// `tryParsePosixClass` decides was never a POSIX class attempt at all
// (`Option.None`) falls through to ordinary item parsing, so the `[` is
// simply consumed as one literal member and `:` follows on the next call.
fn parseClassMember(
  p: RegexParser,
  acc: CharClass,
  first: bool,
  openPos: int,
  flags: RegexFlags,
): CharClass! {
  if (first && curByte(p) == ']') {
    advanceByte(p)
    return ccAddRune(acc, rune(']'))
  }
  if (isPosixClassStart(p)) {
    let attempt = tryParsePosixClass(p, openPos)?
    if (isSome(attempt)) {
      return ccUnion(acc, unwrap(attempt))
    }
  }
  let item = parseClassItem(p, openPos, flags)?
  return mergeClassItem(p, acc, item, openPos, flags)?
}

fn isPosixClassStart(p: RegexParser): bool {
  return curByte(p) == '[' && peekByte(p, 1) == ':'
}

// The byte offset of the `:` in the next `:]` at or after `start`, or `-1`
// if none exists before the end of `p.src`. Bounded: the pattern is capped
// at `maxPatternLength` (4096 bytes, parse.bit) before parsing ever starts,
// so this scan is statically bounded regardless of how many `[:` a pattern
// contains.
fn findClassColonBracket(p: RegexParser, start: int): int {
  let i = start
  // Bounded by `p.n - start`, itself bounded by the 4096-byte pattern cap.
  while (i + 1 < p.n) {
    if (p.src[i] == ':' && p.src[i + 1] == ']') {
      return i
    }
    i = i + 1
  }
  return -1
}

// `[:name:]` — attempts to parse it starting at `p`'s cursor (already known
// to be `[:`, `isPosixClassStart`). Matches go1.26.6's `regexp/syntax`
// `parseNamedClass` exactly, verified directly against it (#3831):
//
//   - No `:]` anywhere in the REST OF THE PATTERN — not merely before this
//     class's own closing `]` — means this was never a POSIX class attempt:
//     returns `Option.None`, consuming nothing, so the caller treats the
//     `[` as an ordinary literal member. This is `[[:alpha]]+`'s case: no
//     `:]` exists anywhere in the pattern, so `[`, `:`, `a`, `l`, `p`, `h`,
//     `a` all become literal class members and the first bare `]` closes
//     the class (the POSIX first-`]`-is-literal rule does not apply here
//     since it is not the first member) — leaving `]+` outside the class,
//     a literal `]` followed by `+`.
//   - A `:]` DOES exist later in the pattern (Go's own search is a flat
//     string scan with no bracket-nesting awareness, so this can span past
//     this class's own `]`, or through an unrelated later `[:name:]`) and
//     the text between is one of the 13 recognized POSIX names: returns
//     `Option.Some` of that class, cursor advanced past the `:]`.
//   - A `:]` exists later but the enclosed text is not a recognized name:
//     `regex: invalid POSIX class name` — same as an unrecognized
//     well-formed name always was.
fn tryParsePosixClass(p: RegexParser, openPos: int): Option<CharClass>! {
  let nameStart = p.pos + 2
  let colon = findClassColonBracket(p, nameStart)
  if (colon < 0) {
    return Option.None
  }
  let name = p.src[nameStart:colon]
  let found = ccPosixByName(name)
  if (isNone(found)) {
    fail parseErr(errInvalidPosixClass, openPos)
  }
  p.pos = colon + 2
  return Option.Some(unwrap(found))
}

// One item: an escape (`parseClassEscape`) or a literal rune (possibly
// multi-byte UTF-8). Callers reach here only when `!atEnd(p)`
// (`classBodyDone`'s check, or `mergeClassItem`'s own guard before the
// second call for a range's end) — except this is also called right after
// consuming a range's `-`, where nothing upstream re-checks, so it checks
// for itself.
fn parseClassItem(p: RegexParser, openPos: int, flags: RegexFlags): classItem! {
  if (atEnd(p)) {
    fail parseErr(errMissingCloseBracket, openPos)
  }
  if (curByte(p) == '\\') {
    return parseClassEscape(p, openPos, flags)?
  }
  let r = advanceRune(p)
  return classItem{ isSingle: true, r: r, contributed: ccEmpty() }
}

// `\` inside a class: a `\p{...}`/`\P{...}` Unicode property (#2032), a Perl
// shorthand (`\d` etc — not a range endpoint, so `isSingle: false`), a
// control character (`\n` etc — a range endpoint), or a literal escape of
// any other non-alphanumeric byte.
fn parseClassEscape(p: RegexParser, openPos: int, flags: RegexFlags): classItem! {
  let backslashPos = p.pos
  advanceByte(p)
  if (atEnd(p)) {
    fail parseErr(errTrailingBackslash, backslashPos)
  }
  let b = curByte(p)
  if (isUnicodeClassStart(b)) {
    let cc = parseUnicodeClassEscape(p, flags, backslashPos)?
    return classItem{ isSingle: false, r: rune(0), contributed: cc }
  }
  let shorthand = escapeClassFor(b, flags)
  if (isSome(shorthand)) {
    advanceByte(p)
    return classItem{ isSingle: false, r: rune(0), contributed: classOfAst(unwrap(shorthand)) }
  }
  let ctrl = classControlByte(b)
  if (isSome(ctrl)) {
    advanceByte(p)
    return classItem{ isSingle: true, r: unwrap(ctrl), contributed: ccEmpty() }
  }
  if (isAsciiAlnum(b)) {
    fail parseErr(errInvalidEscape, backslashPos)
  }
  advanceByte(p)
  return classItem{ isSingle: true, r: rune(b), contributed: ccEmpty() }
}

// Unwraps the `CharClass` `escapeClassFor` always wraps as `Ast.Class` — an
// internal invariant of this file, never a real branch a caller can hit.
fn classOfAst(a: Ast): CharClass {
  match (a) {
    Class(cc) => return cc
    _ => panic("regex: internal: escapeClassFor produced a non-Class Ast")
  }
}

// Folds `item` into `acc`: as one side of a `lo-hi` range when `item` is
// immediately followed by `-` and then another item (`[z-a]`, backwards, and
// `[\d-z]`/`[a-\d]`, a shorthand on either side, are all still
// `regex: invalid character class range` — only a single rune can be a range
// endpoint); otherwise as a plain member. `flags` is only needed for the
// range-end `parseClassItem` call — a `\p{...}` can never itself be a range
// endpoint (rejected below, same as `\d`), so nothing here folds twice.
fn mergeClassItem(
  p: RegexParser,
  acc: CharClass,
  item: classItem,
  openPos: int,
  flags: RegexFlags,
): CharClass! {
  if (!atEnd(p) && curByte(p) == '-' && !classDashIsLiteral(p)) {
    if (!item.isSingle) {
      fail parseErr(errInvalidClassRange, openPos)
    }
    advanceByte(p)
    let endItem = parseClassItem(p, openPos, flags)?
    if (!endItem.isSingle || endItem.r < item.r) {
      fail parseErr(errInvalidClassRange, openPos)
    }
    return ccAddRange(acc, item.r, endItem.r)
  }
  if (item.isSingle) {
    return ccAddRune(acc, item.r)
  }
  return ccUnion(acc, item.contributed)
}

// A `-` right before the closing `]` is a literal dash, not a range
// separator (`[a-]` matches `a` or `-`).
fn classDashIsLiteral(p: RegexParser): bool {
  return peekByte(p, 1) == ']'
}
