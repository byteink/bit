fn unicodePropTable(): []unicodePropSpec {
  return []unicodePropSpec{
    unicodePropSpec{ name: "C", packed: packedPropC },
    unicodePropSpec{ name: "Cc", packed: packedPropCc },
    unicodePropSpec{ name: "Cf", packed: packedPropCf },
    unicodePropSpec{ name: "Co", packed: packedPropCo },
    unicodePropSpec{ name: "Cs", packed: packedPropCs },
