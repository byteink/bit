    unicodePropSpec{ name: "Thai", packed: packedPropThai },
    unicodePropSpec{ name: "Devanagari", packed: packedPropDevanagari },
  }
}

// Every general category (one- and two-letter) and script name #2032
// documents, resolved to a normalized `CharClass` — `Option.None` for any
// other name. Linear scan: 47 rows, and this runs once per `\p{...}`
// appearing in a pattern, at `compile()` time, never per search.
fn unicodePropertyRanges(name: string): Option<CharClass> {
  let table = unicodePropTable()
  let i = 0
  // Bounded by `len(table)`, fixed (47) before the loop starts.
  while (i < len(table)) {
    if (table[i].name == name) {
      return Option.Some(
        ccNormalize(CharClass{ ranges: decodePackedRanges(table[i].packed), negated: false }),
      )
    }
    i = i + 1
  }
  return Option.None
}

fn unicodeHexDigitValue(b: u8): int {
  if (b >= '0' && b <= '9') {
    return int(b) - int('0')
  }
  return int(b) - int('A') + 10 // packed hex is always uppercase A-F
}

fn decodeHexToRune(s: string): rune {
  let v = 0
  let i = 0
  // Bounded by `len(s)`, at most 6 hex digits for any valid codepoint.
  while (i < len(s)) {
    v = v * 16 + unicodeHexDigitValue(s[i])
    i = i + 1
  }
  return rune(v)
}

// Decodes a packed "lo-hi,lo-hi,..." string into ranges. `packed == ""`
// decodes to no ranges.
fn decodePackedRanges(packed: string): []RuneRange {
  if (len(packed) == 0) {
    return []RuneRange(0)
  }
  let parts = split(packed, ",")
  let out: []RuneRange = []RuneRange(0)
  let i = 0
  // Bounded by `len(parts)`, fixed before the loop starts.
  while (i < len(parts)) {
    let dash = indexOf(parts[i], "-")
    let lo = decodeHexToRune(parts[i][0:dash])
    let hi = decodeHexToRune(parts[i][int(dash) + 1:len(parts[i])])
    out = append(out, RuneRange{ lo: lo, hi: hi })
    i = i + 1
  }
  return out
}
