// Bit standard library — regex module, atom-position escape parsing.
//
// `\d \D \w \W \s \S` (classes), `\A \z \b \B` (anchors), `\a \n \t \r \f \v`
// (control characters), or `\` followed by any non-alphanumeric byte — a
// literal escape of that punctuation (`\. \\ \( \) \[ \] \{ \} \| \* \+ \? \^
// \$`, and more). `\` followed by any OTHER alphanumeric byte — including a
// digit, so a backreference such as `\1` can never parse — is
// `regex: invalid escape sequence`: permanently rejected, not merely
// unimplemented, since a digit escape only ever means a backreference and
// backreferences are out of scope for good (no backtracking, ever).

// `\` already consumed to be known present; this parses the byte after it.
fn parseEscapeAtom(p: RegexParser, flags: RegexFlags): Ast! {
  let backslashPos = p.pos
  advanceByte(p)
  if (atEnd(p)) {
    fail parseErr(errTrailingBackslash, backslashPos)
  }
  let b = curByte(p)
  if (isUnicodeClassStart(b)) {
    let cc = parseUnicodeClassEscape(p, flags, backslashPos)?
    return Ast.Class(cc)
  }
  let known = escapeAtomFor(b, flags)
  if (isSome(known)) {
    advanceByte(p)
    return unwrap(known)
  }
  if (isAsciiAlnum(b)) {
    fail parseErr(errInvalidEscape, backslashPos)
  }
  advanceByte(p)
  return Ast.Literal(rune(b))
}

// Tries each of the three recognized escape-letter tables in turn — classes,
// then anchors, then control characters (parsecursor.bit) — so this stays a
// couple of comparisons rather than a single 15-armed dispatch. `\p`/`\P`
// (parseunicodeclass.bit) are handled by the caller before this is reached,
// since they consume more than one byte and can fail.
fn escapeAtomFor(b: u8, flags: RegexFlags): Option<Ast> {
  let asClass = escapeClassFor(b, flags)
  if (isSome(asClass)) {
    return asClass
  }
  let asAnchor = escapeAnchorFor(b)
  if (isSome(asAnchor)) {
    return asAnchor
  }
  return escapeControlFor(b)
}
