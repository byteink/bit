// Bit standard library — regex module, the parser's cursor and shared
// escape tables.
//
// `RegexParser` is a forward-only byte cursor over the pattern text, mutated
// in place by every `parse*` function across this module (the same shape as
// `stdlib/json/lex.bit`'s `Lexer`) — no file here re-imports it, since
// unexported declarations are visible module-wide. `pos` only ever advances,
// so any loop bounded by "consumes at least one byte per iteration" is
// bounded by `len(pattern) - pos`, a statically finite quantity.
//
// The three escape-lookup tables (`escapeClassFor`, `escapeAnchorFor`,
// `classControlByte`) are shared by the atom-position escape parser
// (parseescape.bit, e.g. `\d` as a whole atom) and the class-body escape
// parser (parseclass.bit, e.g. `\d` inside `[...]`) — both recognize the same
// letters, so the table lives once, here.

import { decodeRuneAt } from "std/strings"

// A forward cursor over `src`. `groupCount` is the number of capturing groups
// opened so far, used to assign each `(...)`/`(?<name>...)` its 1-based
// index as it is parsed left to right. `names` is every name a named group
// has claimed so far (`(?<n>...)` and `(?P<n>...)` both add to the same
// list, #2029's parsegroup.bit), so a duplicate — in either spelling — can
// be rejected the moment the second one is seen. `depth` is the number of
// `(...)` currently open on the path from the pattern's root to the cursor —
// bumped on entry to `parseGroup` and dropped on exit (parsegroup.bit,
// #3660) — the real grammar-nesting counter `maxNestingDepth` (parse.bit) is
// checked against, as opposed to a raw count of `(` bytes in the source.
class RegexParser { src: string, pos: int, n: int, groupCount: int, names: []string, depth: int }

// A parser positioned at the start of `pattern`.
fn newRegexParser(pattern: string): RegexParser {
  return RegexParser{
    src: pattern,
    pos: 0,
    n: len(pattern),
    groupCount: 0,
    names: []string(0),
    depth: 0,
  }
}

// Whether the cursor has consumed all of `p.src`.
fn atEnd(p: RegexParser): bool {
  return p.pos >= p.n
}

// The byte under the cursor. Callers must check `!atEnd(p)` first.
fn curByte(p: RegexParser): u8 {
  return p.src[p.pos]
}

// The byte `offset` positions ahead of the cursor, or `0` past the end of
// `p.src` — a sentinel that never equals a real pattern byte we compare it
// against, so callers can peek without a separate bounds check.
fn peekByte(p: RegexParser, offset: int): u8 {
  let at = p.pos + offset
  if (at >= p.n) {
    return u8(0)
  }
  return p.src[at]
}

// Moves the cursor forward one byte.
fn advanceByte(p: RegexParser) {
  p.pos = p.pos + 1
}

// Decodes the rune at the cursor and advances past it (one or more bytes for
// a multi-byte UTF-8 sequence). Callers must check `!atEnd(p)` first.
fn advanceRune(p: RegexParser): rune {
  let (r, width) = decodeRuneAt(p.src, p.pos)
  p.pos = p.pos + width
  return r
}

// --- errors ----------------------------------------------------------------

const errMissingCloseParen: string = "regex: missing closing )"
const errUnexpectedCloseParen: string = "regex: unexpected )"
const errMissingCloseBracket: string = "regex: missing closing ]"
const errInvalidClassRange: string = "regex: invalid character class range"
const errTrailingBackslash: string = "regex: trailing backslash"
const errInvalidEscape: string = "regex: invalid escape sequence"
const errNothingToRepeat: string = "regex: nothing to repeat"
const errInvalidNamedGroup: string = "regex: invalid named group"
const errDuplicateGroupName: string = "regex: duplicate capture group name"
const errInvalidPosixClass: string = "regex: invalid POSIX class name"
const errUnknownFlag: string = "regex: unknown flag"
const errMissingFlags: string = "regex: missing flags"
const errRepeatedDash: string = "regex: repeated -"
const errNestingTooDeep: string = "regex: expression nests too deeply (max 1000)"

// Builds the `error` a parse failure fails with: `msg` plus the byte offset
// it occurred at, in the exact `"<msg> at offset <n>"` shape #2026 pins.
fn parseErr(msg: string, offset: int): error {
  return newError("${msg} at offset ${offset}")
}

// --- shared escape tables ----------------------------------------------

// `cc` folded under `flags.i`, unchanged otherwise — the shared
// "fold-before-negate" step every negatable escape class below runs BEFORE
// its own negation, never after (`CharClass.negated`'s doc comment,
// charclass.bit): folding an already-negated class would fold the
// complement the pattern named, not the set it actually named.
fn maybeFold(cc: CharClass, flags: RegexFlags): CharClass {
  if (flags.i) {
    return ccFold(cc)
  }
  return cc
}

// `\d \D \w \W \s \S` — the three Perl classes and their negations, valid
// both as a whole atom and inside `[...]`. Each negated form folds its
// POSITIVE base (`maybeFold`) before negating, matching `\p{...}`'s own
// rule (parseunicodeclass.bit) — for `\D`/`\S` this is a no-op (digits and
// ASCII whitespace have no case), but `\W`'s base (`ccWord`, ASCII
// `[0-9A-Za-z_]`) does: under full Unicode folding, `k`/`K` being in `\w`
// pulls U+212A KELVIN SIGN into its fold-closure too, so `(?i)\W` must
// exclude U+212A — which only happens if `\w`'s base is folded BEFORE
// negating, never after (verified against Go: `(?i)\W` does not match
// U+212A, `\W` without `i` does).
fn escapeClassFor(b: u8, flags: RegexFlags): Option<Ast> {
  if (b == 'd') {
    return Option.Some(Ast.Class(maybeFold(ccDigit(), flags)))
  }
  if (b == 'D') {
    return Option.Some(Ast.Class(ccNegate(maybeFold(ccDigit(), flags))))
  }
  if (b == 'w') {
    return Option.Some(Ast.Class(maybeFold(ccWord(), flags)))
  }
  if (b == 'W') {
    return Option.Some(Ast.Class(ccNegate(maybeFold(ccWord(), flags))))
  }
  if (b == 's') {
    return Option.Some(Ast.Class(maybeFold(ccSpace(), flags)))
  }
  if (b == 'S') {
    return Option.Some(Ast.Class(ccNegate(maybeFold(ccSpace(), flags))))
  }
  return Option.None
}

// `\A \z \b \B` — the four escape-form anchors. Atom position only: inside
// `[...]` these letters are not recognized as anchors (see parseclass.bit).
fn escapeAnchorFor(b: u8): Option<Ast> {
  if (b == 'A') {
    return Option.Some(Ast.Anchor(AnchorKind.BeginText))
  }
  if (b == 'z') {
    return Option.Some(Ast.Anchor(AnchorKind.EndText))
  }
  if (b == 'b') {
    return Option.Some(Ast.Anchor(AnchorKind.WordBoundary))
  }
  if (b == 'B') {
    return Option.Some(Ast.Anchor(AnchorKind.NoWordBoundary))
  }
  return Option.None
}

// `\a \n \t \r \f \v` — the six control-character escapes, valid both as a
// whole atom and inside `[...]`. Bit's own rune-literal grammar (SPEC §5.6)
// has no `\a`/`\f`/`\v` escape, so those three are written as explicit code
// points.
fn classControlByte(b: u8): Option<rune> {
  if (b == 'a') {
    return Option.Some(rune(0x07))
  }
  if (b == 'n') {
    return Option.Some(rune('\n'))
  }
  if (b == 't') {
    return Option.Some(rune('\t'))
  }
  if (b == 'r') {
    return Option.Some(rune('\r'))
  }
  if (b == 'f') {
    return Option.Some(rune(0x0C))
  }
  if (b == 'v') {
    return Option.Some(rune(0x0B))
  }
  return Option.None
}

// `classControlByte`, wrapped as the `Ast.Literal` an atom-position escape
// produces.
fn escapeControlFor(b: u8): Option<Ast> {
  let ctrl = classControlByte(b)
  if (isSome(ctrl)) {
    return Option.Some(Ast.Literal(unwrap(ctrl)))
  }
  return Option.None
}

// --- byte classification -----------------------------------------------

fn isAsciiLetter(b: u8): bool {
  return (b >= 'A' && b <= 'Z') || (b >= 'a' && b <= 'z')
}

fn isAsciiDigit(b: u8): bool {
  return b >= '0' && b <= '9'
}

fn isAsciiAlnum(b: u8): bool {
  return isAsciiLetter(b) || isAsciiDigit(b)
}
