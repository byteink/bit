// Bit standard library — regex module, `\p{...}`/`\P{...}` Unicode
// property-class escapes (#2032).
//
// Four syntactic forms, all documented by the ticket and nothing wider:
// `\p{Name}`/`\P{Name}` (braced — any general category or script name
// `charclass.bit`'s `ccUnicodeProperty` resolves) and `\pX`/`\PX` (the
// one-letter shorthand — only ever a single BYTE here, since every
// one-letter category name is ASCII; a non-ASCII byte right after `p`/`P`
// simply fails to resolve as "unknown Unicode property", the same as any
// other bad name). Go additionally accepts a leading `^` inside the braces
// (`\p{^Han}` == `\P{Han}`) — the ticket's syntax section lists only the
// four forms above, so that fifth form is deliberately not implemented
// here; do not add it without a ticket.
//
// Valid at atom position (parseescape.bit) and inside `[...]`
// (parseclass.bit), which share this file the same way they already share
// `escapeClassFor` (parsecursor.bit).
//
// FOLD-BEFORE-NEGATE (#2033): when `flags.i` is set, the class is folded
// BEFORE `\P` negation is applied, never after — folding an already
// negated class would fold the COMPLEMENT the pattern named, not the set
// it actually named (`CharClass.negated`'s doc comment, charclass.bit).
// This is the same reason `\D`/`\S`/`\W` (parsecursor.bit's
// `escapeClassFor`) fold their positive base before negating.

// Whether `b` starts a Unicode property escape — the caller has already
// consumed the `\`, not yet `b` itself.
fn isUnicodeClassStart(b: u8): bool {
  return b == 'p' || b == 'P'
}

// `\p{Name}`/`\P{Name}`/`\pX`/`\PX`, with `p`/`P` known present at the
// cursor (not yet consumed) and `backslashPos` the offset of the `\` that
// led here — every error this can fail with is reported at that offset,
// matching this module's other escape-parsing errors.
fn parseUnicodeClassEscape(p: RegexParser, flags: RegexFlags, backslashPos: int): CharClass! {
  let negated = curByte(p) == 'P'
  advanceByte(p)
  let name = readUnicodePropertyName(p, backslashPos)?
  let base = ccUnicodeProperty(name)
  if (isNone(base)) {
    fail newError("regex: unknown Unicode property '${name}' at offset ${backslashPos}")
  }
  let cc = unwrap(base)
  if (flags.i) {
    // ASCII-only for now, consistent with every other fold in this module
    // as of #2030 — #2033 swaps this for full Unicode simple folding, which
    // is the ticket that actually answers what `(?i)\p{Lu}` should do (Go's
    // own `regexp/syntax` folds `\p{...}` too, unioning in
    // `unicode.FoldCategory[name]` before any negation — so the deliberate
    // choice here is to MATCH that once the fold infra exists, not to leave
    // `\p{...}` permanently unfolded).
    cc = ccFoldAscii(cc)
  }
  if (negated) {
    cc = ccNegate(cc)
  }
  return cc
}

// The name text between `{`/`}` (braced form), or the single byte right
// after `p`/`P` (shorthand form) — `p`/`P` itself already consumed by the
// caller. Running out of input right after `p`/`P` with no name at all
// reuses `errTrailingBackslash`, since there is nothing Unicode-specific to
// say about it; an unterminated `{` is its own message, matching the
// ticket's exact wording.
fn readUnicodePropertyName(p: RegexParser, backslashPos: int): string! {
  if (atEnd(p)) {
    fail parseErr(errTrailingBackslash, backslashPos)
  }
  if (curByte(p) != '{') {
    let start = p.pos
    advanceByte(p)
    return p.src[start:p.pos]
  }
  advanceByte(p)
  let start = p.pos
  // Bounded: each iteration consumes at least one byte, and `p.src` is finite.
  while (!atEnd(p) && curByte(p) != '}') {
    advanceByte(p)
  }
  if (atEnd(p)) {
    fail newError("regex: missing closing } in Unicode property at offset ${backslashPos}")
  }
  let name = p.src[start:p.pos]
  advanceByte(p)
  return name
}
