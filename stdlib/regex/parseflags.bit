// Bit standard library — regex module, inline-flag state and grammar.
//
// `RegexFlags` is threaded through the parser's descent AS A VALUE — never
// mutated in place and never held on `RegexParser` itself — so a scoped
// `(?flags:...)` group restores the caller's exact prior state simply by the
// caller keeping its own copy and never seeing whatever the callee did with
// its own (`parse.bit`'s `parseAlternate`/`parseConcat`, `parsegroup.bit`'s
// `parseFlagsGroup`). A mutable global could not do this: leaving a scoped
// group would have no way to know what to restore.
//
// `(?flags)` (a setting group, no colon) changes `flags` for the rest of the
// enclosing group — including across `|`, per RE2/Go: `(?i)a|b` matches `A`
// and `b` and `B`, not just `A`/`a` and `b` — and produces no `Ast` node of
// its own; `(?flags:...)` is a scoped non-capturing group whose flags apply
// only inside it. Both share this file's `parseFlagRun`; `parsegroup.bit`'s
// `parseFlagsGroup` tells them apart by which byte follows the flag run.

// `i`/`s`/`m` — case-insensitive matching, dot-matches-`\n`, and multiline
// anchors, respectively. `i` folds ASCII only (`A-Z` <-> `a-z`); full Unicode
// simple folding is #2033.
class RegexFlags { i: bool, s: bool, m: bool }

// The flag state a pattern starts with: all three off, RE2/Go's default.
fn defaultFlags(): RegexFlags {
  return RegexFlags{ i: false, s: false, m: false }
}

fn isFlagLetter(b: u8): bool {
  return b == 'i' || b == 's' || b == 'm'
}

// `base` with `letter` (already known to be `i`, `s` or `m`) set to `value`.
fn setFlagLetter(base: RegexFlags, letter: u8, value: bool): RegexFlags {
  if (letter == 'i') {
    return RegexFlags{ i: value, s: base.s, m: base.m }
  }
  if (letter == 's') {
    return RegexFlags{ i: base.i, s: value, m: base.m }
  }
  return RegexFlags{ i: base.i, s: base.s, m: value } // 'm', the only letter left
}

// Parses the flag-letter run right after `(?` (already consumed) up to — but
// not including — the terminating `)` or `:`. Letters before an optional `-`
// turn that flag ON; letters after it turn it OFF, so `(?im-s)` sets `i` and
// `m` and clears `s` in one group.
//
// A completely empty run (`(?)`) is a documented no-op in Go's
// `regexp/syntax`, not an error (`parsePerlFlags`, verified against
// go1.27.0's own source, #3856): `sign` only goes negative once a `-` is
// seen, and the "at least one letter" requirement is gated on `sign < 0`, so
// it never fires when there was no `-` at all. `(?)hello` therefore compiles
// to exactly `hello`, and `(?i)(?)ABC` still matches case-insensitively — the
// empty group changes nothing and does not reset the flags it inherited.
//
// `sawFlagSinceDash` (Go's `sawFlag`) tracks "at least one flag letter since
// the most recent `-`", not "anywhere in the run" — it is reset to `false`
// every time a `-` is consumed (#3872). So the terminator check
// `clearing && !sawFlagSinceDash` rejects a `-` with nothing after it
// (`(?-)`, `(?i-)`: the letter before the `-` does not count) while still
// accepting a letter that comes after the `-` (`(?-i)`). A second `-` while
// already `clearing` (Go's `sign < 0`) is an immediate hard reject
// regardless of `sawFlagSinceDash` — `(?i-s-m)` rejects even though `s` sat
// between the two dashes, matching go1.27.0's `parsePerlFlags` exactly.
//
// Fails `regex: missing flags at offset N` for a run that ends with a `-`
// and no letter after it (`(?-)`, `(?i-)`), `regex: repeated - at offset N`
// at a second `-` (`(?i--m)`, `(?i-s-m)`), or `regex: unknown flag at
// offset N` at the first byte that is neither a flag letter nor `-` —
// including a letter outside `i`/`s`/`m`, e.g. `(?x)`.
fn parseFlagRun(p: RegexParser, base: RegexFlags, openPos: int): RegexFlags! {
  let flags = base
  let sawFlagSinceDash = false
  let clearing = false
  // Bounded: each iteration consumes exactly one byte, and `p.src` is finite.
  while (!atEnd(p) && curByte(p) != ')' && curByte(p) != ':') {
    let b = curByte(p)
    if (b == '-') {
      if (clearing) {
        fail parseErr(errRepeatedDash, p.pos)
      }
      clearing = true
      sawFlagSinceDash = false
      advanceByte(p)
    } else {
      if (!isFlagLetter(b)) {
        fail parseErr(errUnknownFlag, p.pos)
      }
      flags = setFlagLetter(flags, b, !clearing)
      sawFlagSinceDash = true
      advanceByte(p)
    }
  }
  if (atEnd(p)) {
    fail parseErr(errMissingCloseParen, openPos)
  }
  if (clearing && !sawFlagSinceDash) {
    fail parseErr(errMissingFlags, openPos)
  }
  return flags
}
