// stdlib/path/safepath.test.bit — safePath traversal guard (#3953, #4210).
//
// safePath was hoisted here verbatim from examples/staticserver/
// staticserver.bit, which had held it since #2397. Every verdict pinned
// below for the hoist itself was captured by running the PRE-HOIST
// implementation (the one still living in examples/staticserver at the
// time) against the same input through a standalone oracle program — this
// file is not testing what safePath "should" do, it is pinning what it
// DOES do, so the move is provably behaviour-preserving. #4210 (percent-
// encoded traversal) is fixed below rather than merely documented — see
// safePath's own doc comment in path.bit for the exact contract. #4211
// (a bare CR/LF) is still an open gap, pinned below rather than fixed.

import { newBuilder } from "std/strings"

test "a plain absolute path is accepted" {
  assert(safePath("/index.html") == true, "plain absolute path rejected")
  assert(safePath("/docs/style.css") == true, "nested absolute path rejected")
}

test "the root path itself is accepted" {
  assert(safePath("/") == true, "bare root path rejected")
}

test "a relative path (no leading slash) is rejected, however harmless" {
  // Not a traversal attempt at all — this is the "plain valid relative
  // path" case the hoist ticket calls out by name. safePath rejects it
  // purely because it is not absolute, before it ever looks at `..`.
  assert(safePath("index.html") == false, "relative path accepted")
  assert(safePath("../etc/passwd") == false, "relative traversal accepted")
}

test "an empty path is rejected" {
  assert(safePath("") == false, "empty path accepted")
}

test "a plain leading traversal is rejected" {
  assert(safePath("/../etc/passwd") == false, "leading .. accepted")
}

test "a doubled leading traversal is rejected" {
  assert(safePath("/../../etc/passwd") == false, "doubled .. accepted")
}

test "a deep overclimb past the root is rejected" {
  assert(
    safePath("/../../../../../../etc/passwd") == false,
    "deep overclimb accepted",
  )
}

test "a mid-path traversal that still climbs past the root is rejected" {
  assert(safePath("/a/../../etc/passwd") == false, "mid-path overclimb accepted")
}

test "a traversal that resolves to exactly the real filesystem root is rejected" {
  // Not the SITE root (which is legitimately requested as "/" above) —
  // this is a request whose `..` count exceeds every real component,
  // landing on the literal OS root "/", which sits one level above any
  // anchor and so is correctly outside it.
  assert(safePath("/..") == false, "single overclimb to the real root accepted")
  assert(
    safePath("/../../..") == false,
    "triple overclimb to the real root accepted",
  )
}

test "a trailing .. that only cancels back inside the root is accepted" {
  // Legitimate: these never climb past the root, they just walk back up
  // to somewhere still inside it.
  assert(safePath("/a/b/..") == true, "harmless trailing .. rejected")
  assert(safePath("/a/..") == true, "trailing .. back to the root rejected")
}

test "an empty path component (a doubled slash) is accepted" {
  // `clean` drops the empty component; this is not a traversal attempt.
  assert(safePath("/a//b") == true, "doubled-slash path rejected")
}

test "a trailing slash on a directory-shaped path is accepted" {
  assert(safePath("/docs/") == true, "trailing-slash path rejected")
}

test "a backslash anywhere in the path is rejected" {
  assert(safePath("/a\\b") == false, "plain backslash accepted")
  assert(
    safePath("/..\\..\\etc\\passwd") == false,
    "backslash-separated traversal accepted",
  )
}

test "an embedded NUL byte is rejected" {
  // "\0" in a literal can be mangled by an editor; build the real byte.
  let nulPath = newBuilder().write("/a").writeByte(0).write("b").toString()
  assert(safePath(nulPath) == false, "NUL-poisoned path accepted")
}

test "a path that would only escape through a filesystem symlink is accepted here" {
  // safePath is lexical and runs BEFORE any syscall — it cannot see a
  // symlink planted inside an already-safe-looking path. That containment
  // is a separate, filesystem-facing check (examples/staticserver's
  // hasSymlinkComponent), which must run AFTER this one, not instead of
  // it. Pinning `true` here documents that boundary rather than testing
  // something this function was never designed to catch.
  assert(
    safePath("/escape/secret.txt") == true,
    "an ordinary-looking path was rejected — safePath must not start doing filesystem work",
  )
}

test "FIX #4210: a percent-encoded traversal sequence is rejected, not decoded" {
  // safePath never decodes — it rejects any well-formed %XX escape
  // outright. These are the exact two cases #4210 filed as unrejected.
  assert(
    safePath("/%2e%2e/%2e%2e/etc/passwd") == false,
    "percent-encoded .. was accepted",
  )
  assert(
    safePath("/..%2f..%2fetc%2fpasswd") == false,
    "percent-encoded slash traversal was accepted",
  )
}

test "FIX #4210: every percent-encoding shape from the traversal family is rejected" {
  assert(safePath("/%2e%2e%2f") == false, "%2e%2e%2f accepted")
  assert(safePath("/..%2fetc/passwd") == false, "..%2f accepted")
  assert(safePath("/%2e%2e/etc/passwd") == false, "%2e%2e/ accepted")
  assert(safePath("/%2E%2E/etc/passwd") == false, "mixed-case %2E%2E accepted")
  assert(
    safePath("/%252e%252e/etc/passwd") == false,
    "double-encoded %252e%252e accepted (must reject on the outer %25, no second decode needed)",
  )
}

test "FIX #4210: a percent-encoding in a middle segment is rejected too, not just leading" {
  assert(safePath("/docs/%2e%2e/secret") == false, "mid-segment %2e%2e accepted")
  assert(safePath("/docs/..%2fsecret") == false, "mid-segment ..%2f accepted")
  assert(safePath("/docs/%2e%2e/etc/passwd") == false, "mid-segment %2e%2e/ accepted")
  assert(
    safePath("/docs/%2E%2E/secret") == false,
    "mid-segment mixed-case %2E%2E accepted",
  )
  assert(
    safePath("/docs/%252e%252e/secret") == false,
    "mid-segment double-encoded %252e%252e accepted",
  )
}

test "FIX #4210: a harmless-looking escape like %25 is rejected on the same rule" {
  // safePath rejects any well-formed %XX triplet without inspecting what
  // it decodes to — %25 decodes to a literal '%', but distinguishing that
  // from %2e needs the decode step this function deliberately never
  // performs. Documents the contract, not a traversal by itself.
  assert(safePath("/100%25off.html") == false, "%25 (a valid escape) accepted")
}

test "FIX #4210: a percent NOT starting a well-formed escape still passes through" {
  // %zz is not two hex digits, and a trailing lone % has no room for two
  // more bytes — neither is a well-formed escape, so both are untouched
  // by the #4210 rule, exactly like any other ordinary byte.
  assert(safePath("/100%zzoff.html") == true, "malformed %zz escape rejected")
  assert(safePath("/discount%") == true, "trailing bare % rejected")
}

test "GAP #4211: a bare newline in the path is not rejected by this function alone" {
  // Pinning current behaviour, not endorsing it — see #4211. std/http's
  // own hasBareControlChar rejects a bare LF before Request.path is ever
  // built, so this is not reachable through the shipped HTTP server; a
  // caller that builds a path some other way gets no protection here.
  let newlinePath = newBuilder().write("/a").write("\n").write("b").toString()
  assert(
    safePath(newlinePath) == true,
    "embedded newline was rejected — safePath must not change without updating #4211",
  )
}
