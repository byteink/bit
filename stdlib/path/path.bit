// Bit standard library — path module.
//
// Pure string manipulation over POSIX slash-separated paths: nothing here
// touches the filesystem, so `base("/no/such/file")` is perfectly well defined.

export const Separator: string = "/"

// Whether `p` starts at the filesystem root.
export fn isAbs(p: string): bool {
  return len(p) > 0 && p[0] == '/'
}

// `a` and `b` joined with a single separator. An absolute `b` replaces `a`
// entirely, and an empty component contributes nothing.
export fn join(a: string, b: string): string {
  if (len(a) == 0) {
    return b
  }
  if (len(b) == 0) {
    return a
  }
  if (isAbs(b)) {
    return b
  }
  if (a[len(a) - 1] == '/') {
    return a + b
  }
  return a + Separator + b
}

// The index just past the last separator in `p`, or 0 when there is none.
fn afterLastSep(p: string): int {
  let i = len(p)
  while (i > 0) {
    if (p[i - 1] == '/') {
      return i
    }
    i = i - 1
  }
  return 0
}

// The final component of `p`: `base("/a/b.txt")` is `"b.txt"`. A trailing
// separator yields the empty string, matching the "no final component" reading.
export fn base(p: string): string {
  return p[afterLastSep(p):len(p)]
}

// Everything before the final component: `dir("/a/b.txt")` is `"/a"`. A path
// with no separator has directory `"."`; the root's directory is `"/"`.
export fn dir(p: string): string {
  let cut = afterLastSep(p)
  if (cut == 0) {
    return "."
  }
  if (cut == 1) {
    return Separator // "/x" -> "/"
  }
  return p[0:cut - 1]
}

// The extension of `p`'s final component, including the dot: `".txt"`. A name
// with no dot, or a leading dot only (`".bashrc"`), has no extension.
export fn ext(p: string): string {
  let b = base(p)
  let i = len(b)
  while (i > 1) {
    if (b[i - 1] == '.') {
      return b[i - 1:len(b)]
    }
    i = i - 1
  }
  return ""
}

// The final component without its extension: `stem("/a/b.txt")` is `"b"`.
export fn stem(p: string): string {
  let b = base(p)
  return b[0:len(b) - len(ext(b))]
}

// `stack` with `elem` folded in per the `..`-cancellation rule: `.` is
// dropped, `..` pops the previous non-`..` element (or is itself dropped at
// the root of a rooted path, or kept when there is no root to cancel
// against), and anything else is pushed.
fn cleanPush(stack: []string, elem: string, rooted: bool): []string {
  if (elem == ".") {
    return stack
  }
  if (elem == "..") {
    if (len(stack) > 0 && stack[len(stack) - 1] != "..") {
      return stack[0:len(stack) - 1]
    }
    if (!rooted) {
      // bit:lint allow E0214 -- stack is cleanElems's accumulator, seeded fresh from []string(0); its only caller reassigns stack = cleanPush(stack, ...) and never reads the pre-call slice
      return append(stack, elem)
    }
    return stack
  }
  // bit:lint allow E0214 -- same stack, same single-owner accumulator; no caller keeps a pre-call reference
  return append(stack, elem)
}

// `p`'s slash-separated elements, folded left to right through `cleanPush`.
fn cleanElems(p: string, rooted: bool): []string {
  let n = len(p)
  let stack = []string(0)
  let i = 0
  while (i < n) {
    while (i < n && p[i] == '/') {
      i = i + 1
    }
    if (i >= n) {
      break
    }
    let start = i
    while (i < n && p[i] != '/') {
      i = i + 1
    }
    stack = cleanPush(stack, p[start:i], rooted)
  }
  return stack
}

// `stack`'s elements rejoined with `Separator`, rooted at `/` when `rooted`.
// An empty rooted stack is the root itself; an empty relative stack is `"."`.
fn cleanJoin(stack: []string, rooted: bool): string {
  if (rooted && len(stack) == 0) {
    return Separator
  }
  let result = ""
  let j = 0
  while (j < len(stack)) {
    if (j > 0 || rooted) {
      result = result + Separator
    }
    result = result + stack[j]
    j = j + 1
  }
  if (len(result) == 0) {
    return "."
  }
  return result
}

// `p`, normalized: runs of `/` collapse to one, `.` elements are dropped, and
// each inner `..` cancels the non-`..` element before it. A `..` that would
// climb above a rooted path's `/` is dropped instead. The result never ends
// in `/` unless it is the root, and an empty result becomes `"."` — matching
// Go's `filepath.Clean`. `clean("/srv/root/../../etc/passwd")` is
// `"/etc/passwd"`; `clean("../../a")` keeps its leading `..` elements since
// there is no root to cancel them against.
export fn clean(p: string): string {
  if (len(p) == 0) {
    return "."
  }
  let rooted = isAbs(p)
  return cleanJoin(cleanElems(p, rooted), rooted)
}
