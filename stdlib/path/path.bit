// Bit standard library — path module.
//
// Pure string manipulation over POSIX slash-separated paths: nothing here
// touches the filesystem, so `base("/no/such/file")` is perfectly well defined.

import { contains as strContains } from "std/strings"

export const Separator: string = "/"

// Whether `p` starts at the filesystem root.
export fn isAbs(p: string): bool {
  return len(p) > 0 && p[0] == '/'
}

// `a` and `b` joined with a single separator. An absolute `b` replaces `a`
// entirely, and an empty component contributes nothing.
export fn join(a: string, b: string): string {
  if (len(a) == 0) {
    return b
  }
  if (len(b) == 0) {
    return a
  }
  if (isAbs(b)) {
    return b
  }
  if (a[len(a) - 1] == '/') {
    return a + b
  }
  return a + Separator + b
}

// The index just past the last separator in `p`, or 0 when there is none.
fn afterLastSep(p: string): int {
  let i = len(p)
  while (i > 0) {
    if (p[i - 1] == '/') {
      return i
    }
    i = i - 1
  }
  return 0
}

// The final component of `p`: `base("/a/b.txt")` is `"b.txt"`. A trailing
// separator yields the empty string, matching the "no final component" reading.
export fn base(p: string): string {
  return p[afterLastSep(p):len(p)]
}

// Everything before the final component: `dir("/a/b.txt")` is `"/a"`. A path
// with no separator has directory `"."`; the root's directory is `"/"`.
export fn dir(p: string): string {
  let cut = afterLastSep(p)
  if (cut == 0) {
    return "."
  }
  if (cut == 1) {
    return Separator // "/x" -> "/"
  }
  return p[0:cut - 1]
}

// The extension of `p`'s final component, including the dot: `".txt"`. A name
// with no dot, or a leading dot only (`".bashrc"`), has no extension.
export fn ext(p: string): string {
  let b = base(p)
  let i = len(b)
  while (i > 1) {
    if (b[i - 1] == '.') {
      return b[i - 1:len(b)]
    }
    i = i - 1
  }
  return ""
}

// The final component without its extension: `stem("/a/b.txt")` is `"b"`.
export fn stem(p: string): string {
  let b = base(p)
  return b[0:len(b) - len(ext(b))]
}

// `stack` with `elem` folded in per the `..`-cancellation rule: `.` is
// dropped, `..` pops the previous non-`..` element (or is itself dropped at
// the root of a rooted path, or kept when there is no root to cancel
// against), and anything else is pushed.
fn cleanPush(stack: []string, elem: string, rooted: bool): []string {
  if (elem == ".") {
    return stack
  }
  if (elem == "..") {
    if (len(stack) > 0 && stack[len(stack) - 1] != "..") {
      return stack[0:len(stack) - 1]
    }
    if (!rooted) {
      // bit:lint allow E0214 -- stack is cleanElems's accumulator, seeded fresh from []string(0); its only caller reassigns stack = cleanPush(stack, ...) and never reads the pre-call slice
      return append(stack, elem)
    }
    return stack
  }
  // bit:lint allow E0214 -- same stack, same single-owner accumulator; no caller keeps a pre-call reference
  return append(stack, elem)
}

// `p`'s slash-separated elements, folded left to right through `cleanPush`.
fn cleanElems(p: string, rooted: bool): []string {
  let n = len(p)
  let stack = []string(0)
  let i = 0
  while (i < n) {
    while (i < n && p[i] == '/') {
      i = i + 1
    }
    if (i >= n) {
      break
    }
    let start = i
    while (i < n && p[i] != '/') {
      i = i + 1
    }
    stack = cleanPush(stack, p[start:i], rooted)
  }
  return stack
}

// `stack`'s elements rejoined with `Separator`, rooted at `/` when `rooted`.
// An empty rooted stack is the root itself; an empty relative stack is `"."`.
fn cleanJoin(stack: []string, rooted: bool): string {
  if (rooted && len(stack) == 0) {
    return Separator
  }
  let result = ""
  let j = 0
  while (j < len(stack)) {
    if (j > 0 || rooted) {
      result = result + Separator
    }
    result = result + stack[j]
    j = j + 1
  }
  if (len(result) == 0) {
    return "."
  }
  return result
}

// `p`, normalized: runs of `/` collapse to one, `.` elements are dropped, and
// each inner `..` cancels the non-`..` element before it. A `..` that would
// climb above a rooted path's `/` is dropped instead. The result never ends
// in `/` unless it is the root, and an empty result becomes `"."` — matching
// Go's `filepath.Clean`. `clean("/srv/root/../../etc/passwd")` is
// `"/etc/passwd"`; `clean("../../a")` keeps its leading `..` elements since
// there is no root to cancel them against.
export fn clean(p: string): string {
  if (len(p) == 0) {
    return "."
  }
  let rooted = isAbs(p)
  return cleanJoin(cleanElems(p, rooted), rooted)
}

// Whether `s` begins with `prefix`, byte for byte. A private helper so
// `contains` never needs a raw substring test that could match mid-component.
fn hasPrefixLocal(s: string, prefix: string): bool {
  let n = len(prefix)
  if (n > len(s)) {
    return false
  }
  return s[0:n] == prefix
}

// Whether `p` names a location inside (or equal to) `root`, after both are
// lexically normalized with `clean` — no filesystem access, so a `..` that
// only exists on disk (a planted symlink, say) is not this function's job.
//
// Comparison is by whole path *component*, never by raw character prefix:
// `contains("/a/b", "/a/bc")` is `false` even though `"/a/bc"` starts with
// the string `"/a/b"`, because `bc` and `b` are different components. This is
// why `clean` runs first — `contains("/srv/root", "/srv/root/../private.conf")`
// is `false`, not `true`, because the `..` is resolved away before the
// comparison ever happens.
//
// A relative `root` or `p` is normalized the same purely lexical way as
// `clean` itself (no cwd is ever consulted); an empty string cleans into
// `"."` and is compared like any other path. A path is always considered
// inside itself: `contains("/srv/root", "/srv/root") == true`.
//
// `root == "."` and `root == ""` both mean "the current directory": every
// relative `p` that does not climb above it with a leading `..` is inside,
// and an absolute `p` never is, since a relative root cannot contain an
// absolute path. `contains(".", "a/b")` and `contains("", "a/b")` are both
// `true`; `contains(".", "..")` and `contains(".", "../a")` stay `false`.
export fn contains(root: string, p: string): bool {
  let r = clean(root)
  let q = clean(p)
  if (q == r) {
    return true
  }
  if (r == Separator) {
    return hasPrefixLocal(q, Separator)
  }
  if (r == ".") {
    return !isAbs(q) && q != ".." && !hasPrefixLocal(q, ".." + Separator)
  }
  return hasPrefixLocal(q, r + Separator)
}

// A byte `safePath` refuses to let through, wherever it appears: a NUL
// (which can truncate a path at a syscall boundary) or a bare CR/LF (which
// could inject a line break into whatever the caller does with the path
// next — a log line, a header). This does not replace a CRLF-smuggling
// defense that must run earlier in a protocol stack (std/http's own
// `hasBareControlChar` does that for the whole request line, ahead of
// `Request.path`); it only guarantees safePath itself never accepts one.
fn isForbiddenPathByte(b: byte): bool {
  return b == 0 || b == '\r' || b == '\n'
}

// A synthetic, never-resolved stand-in for a real root, used only to prove
// containment lexically inside `safePath`. One path component is exactly
// enough: any `..` that has nothing left of its own to cancel pops this
// anchor and fails `contains`, and that is true whatever the real root
// turns out to be, since a real root always has at least one component
// too. A deeper anchor could pass something a shallower real root would
// reject; one component is the conservative choice.
const requestRootAnchor: string = "/root-anchor"

// The value of hex digit `c`, 0..15, or -1 if `c` is not `[0-9a-fA-F]`.
// A private twin of `std/http`'s `queryHexDigit`: `safePath` cannot import
// that module's decoder without a circular import (`std/http` already
// reaches `std/path` through `std/crypto`'s `truststore.bit`), and a
// query-string decoder is the wrong tool here anyway — it turns `+` into a
// space, which is form-encoding, not URI-path syntax.
fn pathHexDigit(c: byte): int {
  if (c >= '0' && c <= '9') {
    return int(c - '0')
  }
  if (c >= 'a' && c <= 'f') {
    return int(c - 'a') + 10
  }
  if (c >= 'A' && c <= 'F') {
    return int(c - 'A') + 10
  }
  return 0 - 1
}

// Whether `path[i]` begins a well-formed `%XX` percent-escape: a `%`
// followed by two hex digits, case-insensitive, whatever they decode to.
// `path[i]` must be a valid index; callers only call this from inside a
// bounds-checked loop.
fn isPercentEscapeAt(path: string, i: int): bool {
  if (path[i] != '%') {
    return false
  }
  if (i + 2 >= len(path)) {
    return false
  }
  return pathHexDigit(path[i + 1]) >= 0 && pathHexDigit(path[i + 2]) >= 0
}

// Is `path` safe to resolve under ANY root directory — i.e. is it certain
// never to escape outside wherever it ends up being joined to, no matter
// what that root is?
//
// Hoisted from examples/staticserver/staticserver.bit (#3953), which had
// its own copy alongside a third one in the separate bit-website repo —
// this is now the one copy. See the comment there for the caller's
// specific ordering rule (run this BEFORE touching the filesystem, since
// it cannot see a symlink planted inside an already-safe path — that is a
// filesystem-facing check, not this one).
//
// Rejects: anything not starting with `/` (a request line that is not a
// path), a backslash (a Windows-style separator a POSIX check would miss),
// a NUL byte or a bare CR/LF (see `isForbiddenPathByte`), a well-formed
// percent-escape anywhere in `path` (see below), and any `path` that still
// escapes once lexically resolved via `clean`/`contains` — a raw `..` in
// any position, doubled or otherwise, including one that would climb past
// the root entirely. A relative path (no leading `/`) is rejected
// outright, whatever its own contents.
//
// `path` must be the same byte-for-byte representation later used to
// resolve the file — safePath never percent-decodes. Instead, ANY
// well-formed `%XX` triplet (`%2e`, `%2E`, `%25`, ...) is rejected
// outright, without inspecting what it would decode to: telling `%25`
// (decodes to a harmless literal `%`) apart from `%2e` (decodes to `.`)
// needs exactly the decode step this function deliberately never performs.
// This also makes double-encoding irrelevant — `%252e%252e` is rejected on
// its very first `%25`, with no second decode pass needed to reach the
// inner `..`, so there is no "decode once vs. decode twice" ambiguity to
// get wrong. A `%` NOT starting a well-formed escape (`%zz`, or a `%` in
// the last one or two bytes of `path`) is not touched by this rule and
// passes through like any other byte, exactly as before. A caller that
// needs to accept a literal filename shaped like a percent-escape must
// decode its input before calling safePath, then call it on the decoded
// form.
//
export fn safePath(path: string): bool {
  if (!isAbs(path)) {
    return false
  }
  if (strContains(path, "\\")) {
    return false
  }
  let i = 0
  while (i < len(path)) {
    if (isForbiddenPathByte(path[i])) {
      return false
    }
    if (isPercentEscapeAt(path, i)) {
      return false
    }
    i = i + 1
  }
  let resolved = clean(requestRootAnchor + path)
  return contains(requestRootAnchor, resolved)
}
