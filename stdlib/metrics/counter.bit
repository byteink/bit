// Bit standard library — std/metrics: Counter (#3966).
//
// A Prometheus counter: monotonically non-decreasing, reset only by process
// restart. `add`'s delta must be >= 0 — Counter exists specifically to make
// "can this go down" unrepresentable in the type a caller reaches for; use
// Gauge for a value that can decrease.
//
// Construct via Registry.counter (registry.bit), never directly: that is
// where the name/label grammar and duplicate-registration checks live.

export class Counter {
  name: string
  help: string
  labelNames: []string
  idx: seriesIndex
  // f64 bit patterns, one per registered label-value combination,
  // preallocated to capMax at construction — see labelkey.bit's
  // seriesIndex header for why this makes the hot path lock-free.
  values: []u64
  dropped: []i64

  // Increments the series for `labelValues` by 1. `labelValues` must have
  // exactly as many entries as this Counter's declared label names, in the
  // same order; pass `[]string(0)` for a Counter with no labels.
  export inc(labelValues: []string) {
    this.add(1.0, labelValues)
  }

  // Adds `delta` (must be >= 0) to the series for `labelValues`.
  export add(delta: f64, labelValues: []string) {
    if (delta < 0.0) {
      panic("metrics: Counter.add: delta must be >= 0 (got ${delta}); a Counter never decreases — use Gauge")
    }
    requireLabelArity(this.labelNames, labelValues)
    let (slot, ok) = this.idx.resolve(encodeLabelKey(labelValues), labelValues)
    if (!ok) {
      atomicAdd(ptrOf(this.dropped), 1)
      return
    }
    atomicAddF64(ptrOf(this.values) + slot, delta)
  }

  writeExposition(b: Builder) {
    appendMetricHeader(b, this.name, this.help, "counter")
    let n = this.idx.count()
    let i = 0
    while (i < n) {
      let v = atomicLoadF64(ptrOf(this.values) + i)
      appendSeriesLine(
        b,
        this.name,
        labelSet{ names: this.labelNames, values: this.idx.labelsAt(i) },
        "${v}",
      )
      i = i + 1
    }
  }
}

fn newCounter(name: string, help: string, labelNames: []string, cfg: familyConfig): Counter {
  return Counter{
    name: name,
    help: help,
    labelNames: copyStrings(labelNames),
    idx: newSeriesIndex(labelNames, cfg.capMax),
    values: []u64(cfg.capMax),
    dropped: cfg.dropped,
  }
}
