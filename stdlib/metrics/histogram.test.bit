// Bit standard library — std/metrics: Histogram bucket-math tests (#3966).

test "histogram bucket counts and _sum/_count match hand-computed values for a known input set" {
  let reg = newRegistry(10)
  let h = reg.histogram("request_duration_seconds", "Request latency.", ["route"], [0.1, 0.5, 1.0])

  // Observations, and by hand which of [<=0.1, <=0.5, <=1.0, +Inf] each
  // falls into (Prometheus buckets are cumulative <= the bound):
  //   0.05 -> le=0.1, le=0.5, le=1.0, le=+Inf   (own bucket: le=0.1)
  //   0.2  ->         le=0.5, le=1.0, le=+Inf   (own bucket: le=0.5)
  //   0.8  ->                 le=1.0, le=+Inf   (own bucket: le=1.0)
  //   5.0  ->                         le=+Inf   (own bucket: +Inf)
  // Cumulative counts: le=0.1 -> 1, le=0.5 -> 2, le=1.0 -> 3, le=+Inf -> 4.
  // sum = 0.05 + 0.2 + 0.8 + 5.0 = 6.05; count = 4.
  h.observe(0.05, ["/a"])
  h.observe(0.2, ["/a"])
  h.observe(0.8, ["/a"])
  h.observe(5.0, ["/a"])

  let out = reg.exposition()
  assert(contains(out, "# TYPE request_duration_seconds histogram\n"), "TYPE line")
  assert(
    contains(out, "request_duration_seconds_bucket{route=\"/a\",le=\"0.1\"} 1\n"),
    "cumulative bucket le=0.1",
  )
  assert(
    contains(out, "request_duration_seconds_bucket{route=\"/a\",le=\"0.5\"} 2\n"),
    "cumulative bucket le=0.5",
  )
  assert(
    contains(out, "request_duration_seconds_bucket{route=\"/a\",le=\"1\"} 3\n"),
    "cumulative bucket le=1.0",
  )
  assert(
    contains(out, "request_duration_seconds_bucket{route=\"/a\",le=\"+Inf\"} 4\n"),
    "the +Inf bucket always equals the total observation count",
  )
  assert(
    contains(out, "request_duration_seconds_sum{route=\"/a\"} 6.05\n"),
    "sum of all observations",
  )
  assert(
    contains(out, "request_duration_seconds_count{route=\"/a\"} 4\n"),
    "count of all observations",
  )
}

test "a value exactly on a bucket boundary falls into that bucket, not the next one (le is <=)" {
  let reg = newRegistry(10)
  let h = reg.histogram("boundary_seconds", "help", [], [1.0, 2.0])
  h.observe(1.0, [])
  let out = reg.exposition()
  assert(
    contains(out, "boundary_seconds_bucket{le=\"1\"} 1\n"),
    "1.0 <= 1.0, so it counts in the first bucket",
  )
  assert(
    contains(out, "boundary_seconds_bucket{le=\"2\"} 1\n"),
    "and cumulatively in every bucket above it",
  )
}

test "the default bucket ladder is non-empty, strictly increasing and usable" {
  let buckets = defaultBuckets()
  assert(len(buckets) > 0, "defaultBuckets must not be empty")
  let i = 1
  while (i < len(buckets)) {
    assert(buckets[i - 1] < buckets[i], "defaultBuckets must be strictly increasing at index ${i}")
    i = i + 1
  }
  let reg = newRegistry(10)
  let h = reg.histogram("default_bucket_seconds", "help", [], defaultBuckets())
  h.observe(0.3, [])
  let out = reg.exposition()
  assert(
    contains(out, "default_bucket_seconds_count 1\n"),
    "the default ladder records an observation",
  )
}
