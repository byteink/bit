// Bit standard library — std/metrics: Prometheus text-format rendering
// helpers shared by Counter, Gauge and Histogram (#3966).
//
// Every render path appends into ONE caller-owned Builder (std/strings) —
// never builds a per-series string and concatenates it in, which is the
// O(n^2) shape a large registry's exposition() would otherwise pay on every
// scrape.
//
// `Builder` itself is imported once for the whole module, in registry.bit
// (where `newBuilder()` is actually called) — imports are per-MODULE here,
// not per-file, so importing the same name from two sibling files is a
// duplicate declaration (E0042).

// Appends `s` to `b`, escaped for a Prometheus HELP line: backslash and
// line feed are the only two bytes the format requires escaping there (the
// docstring is not quoted, so `"` needs no escape).
fn appendEscapedHelp(b: Builder, s: string) {
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == '\\') {
      b.write("\\\\")
    } else if (c == 10) {
      b.write("\\n")
    } else {
      b.writeByte(c)
    }
    i = i + 1
  }
}

// Appends `s` to `b`, escaped for a quoted Prometheus label value:
// backslash, the closing double quote, and line feed.
fn appendEscapedLabelValue(b: Builder, s: string) {
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == '\\') {
      b.write("\\\\")
    } else if (c == '"') {
      b.write("\\\"")
    } else if (c == 10) {
      b.write("\\n")
    } else {
      b.writeByte(c)
    }
    i = i + 1
  }
}

// Appends the `# HELP`/`# TYPE` header pair for one metric.
fn appendMetricHeader(b: Builder, name: string, help: string, kind: string) {
  b.write("# HELP ")
  b.write(name)
  b.write(" ")
  appendEscapedHelp(b, help)
  b.write("\n# TYPE ")
  b.write(name)
  b.write(" ")
  b.write(kind)
  b.write("\n")
}

// A metric's declared label names paired with one series' label values —
// bundled so appendSeriesLine/appendBucketLine each take one label
// argument instead of two (E0202's five-parameter limit, and it reads
// better at the call site than two same-length slices passed side by
// side). Never constructed with mismatched lengths; every caller here
// builds it from a Counter/Gauge/Histogram's own labelNames alongside a
// seriesIndex.labelsAt result, which requireLabelArity already keeps in
// sync at recording time.
class labelSet {
  names: []string,
  values: []string,
}

// Appends one `<name>{label1="v1",...} <value>\n` series line for a
// Counter or Gauge. An empty `labels.names` omits the `{...}` entirely
// (Prometheus's bare `name value` form).
fn appendSeriesLine(b: Builder, name: string, labels: labelSet, valueText: string) {
  b.write(name)
  if (len(labels.names) > 0) {
    b.write("{")
    let i = 0
    while (i < len(labels.names)) {
      if (i > 0) {
        b.write(",")
      }
      b.write(labels.names[i])
      b.write("=\"")
      appendEscapedLabelValue(b, labels.values[i])
      b.write("\"")
      i = i + 1
    }
    b.write("}")
  }
  b.write(" ")
  b.write(valueText)
  b.write("\n")
}

// Appends one histogram `_bucket{label1="v1",...,le="<boundText>"} <value>\n`
// line. Always has at least the `le` label, so — unlike appendSeriesLine —
// the `{...}` is unconditional. `boundText` is either "+Inf" or this
// module's own shortest-round-trip rendering of a bucket bound, never
// caller data, so it is written verbatim without escaping.
fn appendBucketLine(
  b: Builder,
  name: string,
  labels: labelSet,
  boundText: string,
  valueText: string,
) {
  b.write(name)
  b.write("{")
  let i = 0
  while (i < len(labels.names)) {
    b.write(labels.names[i])
    b.write("=\"")
    appendEscapedLabelValue(b, labels.values[i])
    b.write("\",")
    i = i + 1
  }
  b.write("le=\"")
  b.write(boundText)
  b.write("\"} ")
  b.write(valueText)
  b.write("\n")
}
