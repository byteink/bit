// Bit standard library — std/metrics: lock-free f64 accumulation (#3966).
//
// The atomic builtins (SPEC section 11.5) operate only on integer prims —
// there is no atomicAdd for f64. Counter/Gauge values and a histogram's
// running sum are f64, so this reinterprets the cell as its u64 bit pattern
// (floatBits/bitsToFloat — the same inline bitcast std/math's abs/min/max
// use, per stdlib/math/math.bit) and adds under a compare-and-swap retry:
// the standard construction for a lock-free float accumulator, the same
// technique an atomic-uint64-backed float64 accumulator uses in any
// language whose atomics are integer-only.

// Bounded per this codebase's own convention for a CAS retry loop
// (stdlib/rand/rand.bit's maxRejectionTries): a loop must still have a
// provable bound and a defined exit, even one this unlikely to be reached.
// One thousand OTHER workers would each have to win a CAS on this exact
// cell between our own load and compare-and-swap for this to be exhausted.
const maxCasRetries: int = 1000

// Atomically adds `delta` to the f64 at `*p`.
fn atomicAddF64(p: *u64, delta: f64) {
  let tries = 0
  while (tries < maxCasRetries) {
    let oldBits = atomicLoad(p)
    let newBits = floatBits(bitsToFloat(oldBits) + delta)
    if (atomicCmpxchg(p, oldBits, newBits)) {
      return
    }
    tries = tries + 1
  }
  // Unreached in practice (see above), but the loop must still have a
  // defined exit: force the add through with one more load+store rather
  // than looping without a limit. This can lose a concurrent update from
  // the very last iteration, unlike every prior one — the accepted cost of
  // a hard bound, the same trade maxRejectionTries makes.
  let oldBits = atomicLoad(p)
  atomicStore(p, floatBits(bitsToFloat(oldBits) + delta))
}

// Atomically reads the f64 at `*p`.
fn atomicLoadF64(p: *u64): f64 {
  return bitsToFloat(atomicLoad(p))
}

// Atomically overwrites the f64 at `*p` — a plain store, not a
// read-modify-write, since Gauge.set has nothing to preserve from the old
// value.
fn atomicStoreF64(p: *u64, v: f64) {
  atomicStore(p, floatBits(v))
}
