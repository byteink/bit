// Bit standard library — std/metrics: registration, recording and Prometheus
// exposition-format tests (#3966).
//
// What is NOT here, and why: this module's rules require an invalid metric
// or label name, and a duplicate metric-name registration, to PANIC at
// registration. v0.1 has no `recover` (SPEC section 18.4's own testing
// counterpart, stdlib/testing/testing.bit, says so directly), and `bit
// test` fails a test the instant it panics — so a `test "..." { }` block
// cannot assert "this call panics" without failing itself. Those two panic
// paths are instead covered two ways: directly, by unit-testing the pure
// validMetricName/validLabelName decision functions below (which is what
// the panicking wrapper's decision actually rests on); and by running a
// throwaway program through `bit run` as a subprocess and checking its exit
// code and panic message, recorded on smash ticket #3966 rather than
// compiled into this corpus.

import { contains, indexOf } from "std/strings"

test "validMetricName accepts the Prometheus grammar and rejects violations" {
  assert(validMetricName("http_requests_total"), "plain snake_case")
  assert(validMetricName("_leading_underscore"), "leading underscore")
  assert(validMetricName("a:namespaced_metric"), "colon is legal in a metric name")
  assert(validMetricName("m2"), "digits after the first byte")
  assert(!validMetricName(""), "empty")
  assert(!validMetricName("2_starts_with_digit"), "leading digit")
  assert(!validMetricName("has space"), "embedded space")
  assert(!validMetricName("has-dash"), "embedded dash")
}

test "validLabelName accepts the Prometheus grammar, rejects violations and this module's own reserved names" {
  assert(validLabelName("method"), "plain snake_case")
  assert(validLabelName("_ok"), "single leading underscore is fine")
  assert(!validLabelName(""), "empty")
  assert(!validLabelName("2bad"), "leading digit")
  assert(!validLabelName("has space"), "embedded space")
  assert(!validLabelName("__reserved"), "leading double underscore is Prometheus-reserved")
  assert(!validLabelName("le"), "\"le\" collides with this module's own histogram bucket label")
  assert(!validLabelName("quantile"), "\"quantile\" is reserved the same way")
  assert(!validLabelName(":"), "colon is not legal in a LABEL name, unlike a metric name")
}

test "a counter and a gauge render correct HELP, TYPE and value lines" {
  let reg = newRegistry(10)
  let hits = reg.counter("http_requests_total", "Total HTTP requests.", ["method", "code"])
  hits.inc(["GET", "200"])
  hits.inc(["GET", "200"])
  hits.add(3.0, ["POST", "500"])

  let temp = reg.gauge("cpu_temp_celsius", "Current CPU temperature.", [])
  temp.set(42.5, [])
  temp.add(1.5, [])
  temp.dec([])

  let out = reg.exposition()
  assert(contains(out, "# HELP http_requests_total Total HTTP requests.\n"), "counter HELP line")
  assert(contains(out, "# TYPE http_requests_total counter\n"), "counter TYPE line")
  assert(
    contains(out, "http_requests_total{method=\"GET\",code=\"200\"} 2\n"),
    "first counter series",
  )
  assert(
    contains(out, "http_requests_total{method=\"POST\",code=\"500\"} 3\n"),
    "second counter series",
  )
  assert(contains(out, "# TYPE cpu_temp_celsius gauge\n"), "gauge TYPE line")
  // 42.5 + 1.5 - 1 = 43, and a no-label series renders with no "{...}".
  assert(contains(out, "cpu_temp_celsius 43\n"), "gauge value, no-label bare form")
}

test "label values and HELP text are escaped per the Prometheus text format" {
  let reg = newRegistry(10)
  let c = reg.counter("weird_total", "Has a backslash \\ and a newline\nhere.", ["v"])
  c.inc(["quote\"backslash\\newline\nend"])
  let out = reg.exposition()
  assert(
    contains(out, "# HELP weird_total Has a backslash \\\\ and a newline\\nhere.\n"),
    "HELP escaping",
  )
  assert(
    contains(out, "weird_total{v=\"quote\\\"backslash\\\\newline\\nend\"} 1\n"),
    "label value escaping",
  )
}

test "exceeding the cardinality cap drops the new series, leaves existing series intact, and increments the self-reported drop counter" {
  let reg = newRegistry(2)
  let c = reg.counter("bounded_total", "help", ["id"])
  c.inc(["a"])
  c.inc(["b"])
  c.inc(["c"]) // over the cap of 2 distinct series -- dropped
  c.inc(["a"]) // an EXISTING series must still work after a drop elsewhere

  let out = reg.exposition()
  assert(
    contains(out, "bounded_total{id=\"a\"} 2\n"),
    "existing series a is intact and still updatable",
  )
  assert(contains(out, "bounded_total{id=\"b\"} 1\n"), "existing series b is intact")
  assert(!contains(out, "id=\"c\""), "the over-cap series was never created")
  assert(
    contains(out, "bit_metrics_dropped_series_total 1\n"),
    "the self-reported drop counter incremented by exactly one",
  )
}

test "registering the same metric name across Counter/Gauge/Histogram is one shared namespace" {
  let reg = newRegistry(10)
  let _ = reg.counter("shared_total", "help", [])
  // A second, distinct name on the same registry must succeed independently.
  let g = reg.gauge("other_gauge", "help", [])
  g.set(1.0, [])
  let out = reg.exposition()
  assert(
    contains(out, "shared_total 0\n"),
    "the first metric renders even though it was never recorded to",
  )
  assert(contains(out, "other_gauge 1\n"), "the second, independently named metric renders too")
}
