// Bit standard library — std/metrics: Prometheus name and label-name
// grammar (#3966).
//
// A metric or label name is validated once, at REGISTRATION, which the
// caller does at startup — never per-observation. A name that violates the
// grammar therefore fails the program at boot, matching this module's own
// rule: "a bad name must fail at boot, not appear as a corrupt scrape hours
// later."
//
// Grammar (the Prometheus exposition format's own `metric_name` and
// `label_name` productions):
//   metric name:  [a-zA-Z_:][a-zA-Z0-9_:]*
//   label name:   [a-zA-Z_][a-zA-Z0-9_]*, and a leading "__" is reserved
//                 for Prometheus's own internal use.
// "le" and "quantile" are additionally rejected as label names here: this
// module synthesizes both (the histogram bucket ladder; a future summary
// type's quantiles), so a caller-declared label of either name would
// silently collide with a line this module itself writes.

fn isNameStartByte(c: byte): bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

fn isNameByte(c: byte): bool {
  return isNameStartByte(c) || (c >= '0' && c <= '9')
}

// True iff `name` is a syntactically valid Prometheus metric name.
fn validMetricName(name: string): bool {
  if (len(name) == 0) {
    return false
  }
  let first = name[0]
  if (!isNameStartByte(first) && first != ':') {
    return false
  }
  let i = 1
  while (i < len(name)) {
    let c = name[i]
    if (!isNameByte(c) && c != ':') {
      return false
    }
    i = i + 1
  }
  return true
}

// True iff `name` is a syntactically valid, non-reserved Prometheus label
// name. See the module header for the "le"/"quantile" exclusion.
fn validLabelName(name: string): bool {
  if (len(name) == 0) {
    return false
  }
  if (!isNameStartByte(name[0])) {
    return false
  }
  if (len(name) >= 2 && name[0] == '_' && name[1] == '_') {
    return false
  }
  if (name == "le" || name == "quantile") {
    return false
  }
  let i = 1
  while (i < len(name)) {
    if (!isNameByte(name[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

fn requireValidMetricName(name: string) {
  if (!validMetricName(name)) {
    panic("metrics: \"${name}\" is not a valid Prometheus metric name (must match [a-zA-Z_:][a-zA-Z0-9_:]*)")
  }
}

// Panics if any label name is invalid, or if the same label name appears
// twice in `labels` — a caller declaring `["method", "method"]` is a
// programming error, the same class of mistake as registering a metric name
// twice: it produces a series with a duplicate label key, which is
// unparseable.
fn requireValidLabelNames(labels: []string) {
  let i = 0
  while (i < len(labels)) {
    if (!validLabelName(labels[i])) {
      panic("metrics: \"${labels[i]}\" is not a valid Prometheus label name (must match [a-zA-Z_][a-zA-Z0-9_]*, not start with \"__\", and not be \"le\" or \"quantile\")")
    }
    let j = i + 1
    while (j < len(labels)) {
      if (labels[i] == labels[j]) {
        panic("metrics: label \"${labels[i]}\" is declared twice")
      }
      j = j + 1
    }
    i = i + 1
  }
}
