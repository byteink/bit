// Bit standard library — std/metrics: Gauge (#3966).
//
// A Prometheus gauge: a value that can go up or down, e.g. an in-flight
// request count or a queue depth. Unlike Counter, `add`'s delta may be
// negative and `set` overwrites outright.
//
// Construct via Registry.gauge (registry.bit), never directly.

export class Gauge {
  name: string
  help: string
  labelNames: []string
  idx: seriesIndex
  values: []u64
  dropped: []i64

  // Overwrites the series for `labelValues` with `value`.
  export set(value: f64, labelValues: []string) {
    let slot = this.resolveOrDrop(labelValues)
    if (slot < 0) {
      return
    }
    atomicStoreF64(ptrOf(this.values) + slot, value)
  }

  // Adds `delta` (positive or negative) to the series for `labelValues`.
  export add(delta: f64, labelValues: []string) {
    let slot = this.resolveOrDrop(labelValues)
    if (slot < 0) {
      return
    }
    atomicAddF64(ptrOf(this.values) + slot, delta)
  }

  export inc(labelValues: []string) {
    this.add(1.0, labelValues)
  }

  export dec(labelValues: []string) {
    this.add(-1.0, labelValues)
  }

  // Resolves `labelValues` to a slot index, recording a drop and returning
  // -1 if the cardinality cap was reached — never fails the caller.
  // Factored out of set/add so the drop-accounting logic exists exactly
  // once.
  resolveOrDrop(labelValues: []string): int {
    requireLabelArity(this.labelNames, labelValues)
    let (slot, ok) = this.idx.resolve(encodeLabelKey(labelValues), labelValues)
    if (!ok) {
      atomicAdd(ptrOf(this.dropped), 1)
      return -1
    }
    return slot
  }

  writeExposition(b: Builder) {
    appendMetricHeader(b, this.name, this.help, "gauge")
    let n = this.idx.count()
    let i = 0
    while (i < n) {
      let v = atomicLoadF64(ptrOf(this.values) + i)
      appendSeriesLine(
        b,
        this.name,
        labelSet{ names: this.labelNames, values: this.idx.labelsAt(i) },
        "${v}",
      )
      i = i + 1
    }
  }
}

fn newGauge(name: string, help: string, labelNames: []string, cfg: familyConfig): Gauge {
  return Gauge{
    name: name,
    help: help,
    labelNames: copyStrings(labelNames),
    idx: newSeriesIndex(labelNames, cfg.capMax),
    values: []u64(cfg.capMax),
    dropped: cfg.dropped,
  }
}
