// Bit standard library — std/metrics: concurrency correctness (#3966).
//
// CHOICE AND WHY: Counter/Gauge values and a histogram's running sum are
// f64, and Bit's atomic builtins (SPEC section 11.5) are integer-only, so
// there is no direct atomicAdd for them. This module reinterprets the cell
// as its u64 bit pattern and updates it under a bounded compare-and-swap
// retry (atomicf64.bit's atomicAddF64) rather than guarding it with a
// Mutex: the CAS loop never blocks a concurrent reader/writer on a channel
// park, matching this stdlib's own Mutex-vs-atomic split (stdlib/sync's
// header: atomics for hot shared-memory paths, channels/Mutex for
// everything else) and keeping a single metric update to one machine-word
// operation (or a short retry of them) with no scheduler involvement.
// Bucket/observation COUNTS are plain integers and use the built-in
// atomicAdd directly, needing no such trick.
//
// This is tested here under REAL concurrency — real spawned green threads
// racing on the exact same memory cell — rather than asserted, because a
// racy (non-atomic) accumulator passes every single-threaded test and a
// great many low-contention runs too.

import { WaitGroup, newWaitGroup } from "std/sync"

const workers = 8
const itersPerWorker = 10000

test "8 concurrent workers each incrementing a counter 10000 times yields exactly 80000" {
  let reg = newRegistry(4)
  let c = reg.counter("bumps_total", "help", [])
  let wg = newWaitGroup()

  wg.add(workers)
  let w = 0
  while (w < workers) {
    spawn bumpCounter(c, wg)
    w = w + 1
  }
  wg.wait()

  let want = workers * itersPerWorker
  let out = reg.exposition()
  assert(
    indexOf(out, "bumps_total ${want}\n") >= 0,
    "counter total: want exactly ${want}, got:\n${out}",
  )
}

fn bumpCounter(c: Counter, wg: WaitGroup) {
  let i = 0
  while (i < itersPerWorker) {
    c.inc([])
    i = i + 1
  }
  wg.done()
}

test "8 concurrent workers each adding 0.5 to a gauge 10000 times yields exactly 40000.0 (exercises the f64 CAS path, not just integer atomicAdd)" {
  let reg = newRegistry(4)
  let g = reg.gauge("bumps_gauge", "help", [])
  let wg = newWaitGroup()

  wg.add(workers)
  let w = 0
  while (w < workers) {
    spawn bumpGauge(g, wg)
    w = w + 1
  }
  wg.wait()

  let out = reg.exposition()
  assert(indexOf(out, "bumps_gauge 40000\n") >= 0, "gauge total: want exactly 40000, got:\n${out}")
}

fn bumpGauge(g: Gauge, wg: WaitGroup) {
  let i = 0
  while (i < itersPerWorker) {
    g.add(0.5, [])
    i = i + 1
  }
  wg.done()
}
