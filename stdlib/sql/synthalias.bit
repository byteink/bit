// stdlib/sql/synthalias.bit — the `__` spellings the compiler's @table and
// find<T> synthesis writes std/sql's names in (#7564).
//
// A module that imports std/sql gets `import { Rows as __Rows, ... }` from the
// compiler, so the user's own `Rows`, `Value` or `sqlReqInt` never collides with
// the synthesized members. This module IS std/sql: it has nothing to import, so
// it declares the same `__` names itself and the synthesis writes one spelling
// everywhere. Unexported: a consumer imports the original names and binds the
// alias locally. A function alias is a forwarding function, so a signature that
// drifts from its target fails to compile here instead of at a user's class.

type __Value = Value
type __Rows = Rows
type __FieldDesc = FieldDesc
type __AttrDesc = AttrDesc
type __JoinDesc = JoinDesc

fn __sqlReqInt(rows: Rows, cols: []string, col: string): i64! {
  return sqlReqInt(rows, cols, col)?
}

fn __sqlReqFloat(rows: Rows, cols: []string, col: string): f64! {
  return sqlReqFloat(rows, cols, col)?
}

fn __sqlReqBool(rows: Rows, cols: []string, col: string): bool! {
  return sqlReqBool(rows, cols, col)?
}

fn __sqlReqText(rows: Rows, cols: []string, col: string): string! {
  return sqlReqText(rows, cols, col)?
}

fn __sqlReqBlob(rows: Rows, cols: []string, col: string): []byte! {
  return sqlReqBlob(rows, cols, col)?
}

fn __sqlOptInt(rows: Rows, cols: []string, col: string): Option<i64>! {
  return sqlOptInt(rows, cols, col)?
}

fn __sqlOptFloat(rows: Rows, cols: []string, col: string): Option<f64>! {
  return sqlOptFloat(rows, cols, col)?
}

fn __sqlOptBool(rows: Rows, cols: []string, col: string): Option<bool>! {
  return sqlOptBool(rows, cols, col)?
}

fn __sqlOptText(rows: Rows, cols: []string, col: string): Option<string>! {
  return sqlOptText(rows, cols, col)?
}

fn __sqlOptBlob(rows: Rows, cols: []string, col: string): Option<[]byte>! {
  return sqlOptBlob(rows, cols, col)?
}
