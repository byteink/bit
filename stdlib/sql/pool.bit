// Bit standard library — sql module: the connection pool.
//
// Without this there are two ways to run a server, and both are wrong. Open
// a connection per request and every request pays a TCP handshake plus
// authentication, and a burst exhausts the database's own connection limit.
// Share one connection between requests and the application serialises on it
// — and, worse, a transaction started by one request is visible to every
// other request using that connection.
//
// `pool` is the third way: a bounded set of physical connections, handed out
// one at a time, returned when the caller is done, and closed when they are
// too old or have gone bad.
//
// THE FOUR RULES THIS FILE EXISTS TO KEEP:
//
//   1. A transaction pins its connection for its whole life. `borrowedTx`
//      holds the driver's own `Tx`, made on one `slot`, and has no way to
//      reach another — the rule is the object graph, not a check.
//   2. A connection handed back with an open transaction is CLOSED, never
//      reused: whatever that transaction was holding must not become the
//      next caller's problem.
//   3. A connection a driver reported a transport failure on (`FatalError`,
//      ./config.bit) is discarded rather than handed out again.
//   4. Waiters are served strictly first-in. LIFO would starve a request
//      under sustained load, and "queue behind whoever is already queued"
//      is what stops a newly-arrived caller from taking a connection out
//      from under a parked one.
//
// THE BOUNDED, FIFO, HEALTH-CHECKED MACHINERY IS `std/sync`'s, NOT THIS
// FILE'S (#6024). `Pool` holds a `std/sync.Pool<slot>` and delegates every
// checkout to it: the idle list, the waiter queue (rule 4), the age limits,
// the dial reservation and the closing of retired connections all live in
// stdlib/sync/pool.bit, which pkg/mail and pkg/redis share. What stays here is
// what only SQL knows. Rules 2 and 3 are the one `connHealthy` predicate
// handed to that pool as its `healthy` closure, not extra fields on its
// `Lease`: `std/sync` checks `healthy` on every release and on every reuse
// from idle, which is exactly "never hand a connection out again if it has an
// open transaction or a transport failure", so `Pool.release` is always
// `release(lease, true)` and the predicate does the retiring.
//
// ./sql.bit's `pooledConn` is a different, smaller thing with a similar
// name: it serialises concurrent callers onto ONE physical connection so a
// driver's socket never sees two calls at once. It pools nothing. This file
// is the pool.
//
// READ REPLICA ROUTING (#5085) IS ./replica.bit's, not this file's: `query`
// below is one line into `replicaSet.read`, and every replica-specific
// decision — which node, when it is down, read-your-own-writes via
// `Session` — lives there. This file stays the writer's own pool.

import { Pool as connPool, Lease, PoolOptions } from "std/sync"

// One physical connection plus the two facts the pool's `healthy` closure
// (`connHealthy`) reads. Age and identity are `std/sync.Lease`'s.
class slot {
  inner: Conn,
  // A transaction is open on it. Rule 2: such a connection is closed, not
  // reused, when it comes back.
  txOpen: bool = false,
  // A driver reported a transport failure on it. Rule 3.
  broken: bool = false,
}

// Rules 2 and 3, in one place: `std/sync.Pool` retires a connection this
// rejects, on release and again before reuse.
fn connHealthy(s: slot): bool {
  return !s.txOpen && !s.broken
}

// A bounded set of connections to one database, safe to share across green
// threads. Built by `pool`.
export class Pool {
  // `.tx()`/`.txAt()`/`.txValue()`/`.txValueAt()` (#5055) — one line each,
  // delegating to ./tx.bit's free functions of the same name (./txmethods.bit).
  use Transactable

  cfg: Datasource
  // The connections: opened, bounded, aged and queued by `std/sync`.
  conns: connPool<slot>
  // Read replicas (#5085), built once by `pool` from `cfg.replicas`.
  // ./replica.bit owns every routing decision this field is used for.
  replicas: replicaSet

  // Runs `sqlText` and returns its rows — on a read replica when one is in
  // rotation, on the writer otherwise (./replica.bit's `replicaSet.read`).
  // THE CONNECTION STAYS CHECKED OUT UNTIL THE RETURNED `Rows` IS CLOSED,
  // whichever node it came from — a cursor lives on the connection that
  // produced it, so a caller that never closes its `Rows` leaks a connection
  // exactly as one that never closes a file leaks a descriptor.
  export query(sqlText: string, params: []Value): Rows! {
    return this.replicas.read(sqlText, params, this)?
  }

  // The writer-only path: what `query` falls back to when no replica is in
  // rotation, and the only path a `Session` (./replica.bit) that has written
  // uses. Never consults `replicas` — this is also why a failed `exec`
  // (below) is never retried on a replica: `exec` calls `this.acquire()`
  // directly and has no route to this file's replica set at all.
  queryWriter(sqlText: string, params: []Value): Rows! {
    let l = this.acquire()?
    let rows = l.value.inner.query(sqlText, params) catch e {
      this.failed(l, e)
      fail e
    }
    return borrowedRows{ p = this, l = l, inner = rows }
  }

  // Runs `sqlText` for its effect and returns the number of rows it changed.
  // The connection is back in the pool before this returns.
  export exec(sqlText: string, params: []Value): ExecResult! {
    let l = this.acquire()?
    let n = l.value.inner.exec(sqlText, params) catch e {
      this.failed(l, e)
      fail e
    }
    this.release(l)
    return n
  }

  // Starts a transaction on one connection and keeps that connection until
  // `commit` or `rollback` ends it. Every statement issued through the
  // returned `Tx` runs on that one connection (rule 1).
  //
  // NOT EXPORTED, and that is the API decision of #3979: every `?` between a
  // caller's `begin` and its `commit` is an early return that skips the
  // rollback, leaving the transaction open and this connection never returned.
  // `tx` (./tx.bit) is the only way in from outside this module, and it is the
  // only caller of this method.
  begin(opts: TxOptions): Tx! {
    let l = this.acquire()?
    let tx = l.value.inner.begin(opts) catch e {
      this.failed(l, e)
      fail e
    }
    l.value.txOpen = true
    return borrowedTx{ p = this, l = l, inner = tx }
  }

  // `.tx()`/`.txAt()` are `use Transactable`'s (./txmethods.bit); `txValue`
  // and `txValueAt` are declared here instead because a generic trait
  // member does not parse (./txmethods.bit's header comment) — each is one
  // line delegating to ./tx.bit's free function of the same name, exactly
  // like the trait's own methods do.
  export txValue<T>(f: (Tx) => T!): T! {
    return txValue<T>(this, f)?
  }

  export txValueAt<T>(opts: TxOptions, f: (Tx) => T!): T! {
    return txValueAt<T>(this, opts, f)?
  }

  // A per-request read-your-own-writes handle (./replica.bit's `Session`),
  // one line delegating to its constructor — the same shape as `tx`/`txAt`
  // above.
  export session(): Session {
    return newSession(this)
  }

  // Checks one physical connection out and hands it to `f` as an `Executor`
  // for the whole call, returning it once `f` returns — on every path out
  // via `fail`/`?` (SPEC §18.5), the same reach `defer` gives everywhere
  // else in this file. UNLIKE `.tx()`/`.begin()`, THIS OPENS NO
  // TRANSACTION: `f` may run any mix of statements on the one connection —
  // including ones a transaction cannot carry, like MySQL DDL or Postgres's
  // `CREATE INDEX CONCURRENTLY` — while still never sharing it with another
  // caller for as long as `f` runs. This is rule 1's own pinning
  // (`begin`, above), generalised to a caller that needs the pin without a
  // SQL transaction wrapping it — a session-scoped server lock
  // (`GET_LOCK`/`pg_advisory_lock`) is exactly that: the lock and every
  // statement it protects have to land on the one connection that took it,
  // or the lock protects nothing (#6328).
  export pinned<T>(f: (Executor) => T!): T! {
    let l = this.acquire()?
    defer this.release(l)
    return f(pinnedConn{ p = this, s = l.value })?
  }

  // Closes every idle connection and fails every parked caller. Connections
  // still checked out are closed as they are returned. Idempotent. Also
  // closes every read replica's own pool (./replica.bit).
  export close() {
    this.conns.close()
    this.replicas.closeAll()
  }

  // Checks a connection out, opening one or waiting for one as the
  // configuration allows. Fails after `acquireTimeout` milliseconds rather
  // than parking the caller forever.
  acquire(): Lease<slot>! {
    return this.conns.acquire()?
  }

  // Hands `l` back. Rules 2 and 3 are `connHealthy`'s: `std/sync` retires the
  // connection instead of reusing it when that says no, together with
  // `maxLifetime` and the closed check.
  release(l: Lease<slot>) {
    this.conns.release(l, true)
  }

  // A statement failed: record whether it killed the connection, then hand
  // the connection back.
  failed(l: Lease<slot>, e: error) {
    this.mark(l.value, e)
    this.release(l)
  }

  // Rule 3, in one place: only a failure the driver marked `FatalError`
  // takes the connection out of service. A constraint violation or a syntax
  // error leaves it perfectly usable.
  mark(s: slot, e: error) {
    let (fe, isFatal) = e.(FatalError)
    if (isFatal && fe.transportFatal()) {
      s.broken = true
    }
  }
}

// A pool of connections to the database `cfg` names, opened through `a`.
// Nothing is connected here: `cfg` is checked (`Datasource.validate`) and
// connections are opened on demand, up to `cfg.maxOpen`. Fails only on a
// configuration that cannot describe a pool — an unset `DATABASE_URL`
// surfaces here, not as a DNS error later.
export fn pool(a: Adapter, cfg: Datasource): Pool! {
  cfg.validate()?
  let reps = buildReplicas(a, cfg)?
  let open: () => slot! = () => {
    let c = a.connect(cfg)?
    return slot{ inner = c }
  }
  let conns = connPool<slot>(
    open,
    (s) => s.inner.close(),
    connHealthy,
    PoolOptions{
      maxSize = cfg.maxOpen, maxIdle = cfg.maxIdle,
      maxIdleTime = cfg.maxIdleTime, maxLifetime = cfg.maxLifetime,
      acquireTimeout = cfg.acquireTimeout,
    },
  )
  return Pool{ cfg = cfg, conns = conns, replicas = reps }
}

// The `Rows` a pooled `query` returns: the driver's own cursor, plus the
// connection it is reading from. `close` is what returns that connection to
// the pool, and it is safe to call twice — returning one connection twice
// would corrupt the pool's accounting, which is what `done` prevents.
class borrowedRows {
  p: Pool
  l: Lease<slot>
  inner: Rows
  done: bool = false
  next(): bool! {
    let more = this.inner.next() catch e {
      this.p.mark(this.l.value, e)
      fail e
    }
    return more
  }

  columns(): []string {
    return this.inner.columns()
  }

  value(col: int): Value {
    return this.inner.value(col)
  }

  close() {
    if (this.done) {
      return
    }
    this.done = true
    this.inner.close()
    this.p.release(this.l)
  }
}

// The `Executor` `Pool.pinned` hands its block: every statement runs
// directly on `s`'s connection, with no BEGIN/COMMIT of its own — the block
// controls its own transaction boundaries, or issues none.
class pinnedConn {
  p: Pool
  s: slot
  query(sqlText: string, params: []Value): Rows! {
    let rows = this.s.inner.query(sqlText, params) catch e {
      this.p.mark(this.s, e)
      fail e
    }
    return pinnedRows{ p = this.p, s = this.s, inner = rows }
  }

  exec(sqlText: string, params: []Value): ExecResult! {
    let n = this.s.inner.exec(sqlText, params) catch e {
      this.p.mark(this.s, e)
      fail e
    }
    return n
  }
}

// `pinnedConn.query`'s cursor. Closing it ends the cursor only — the
// connection goes back to the pool when `Pool.pinned`'s own block returns,
// never earlier, so a caller may still issue more statements on the same
// connection after closing one `Rows`.
class pinnedRows {
  p: Pool
  s: slot
  inner: Rows
  next(): bool! {
    let more = this.inner.next() catch e {
      this.p.mark(this.s, e)
      fail e
    }
    return more
  }

  columns(): []string {
    return this.inner.columns()
  }

  value(col: int): Value {
    return this.inner.value(col)
  }

  close() {
    this.inner.close()
  }
}

// The `Tx` a pooled `begin` returns. Rule 1 holds structurally: `inner` was
// made by `s.inner.begin()`, and nothing in this class can reach another
// connection, so every statement lands on the one connection the
// transaction started on. `commit`/`rollback` clear `slot.txOpen` and return
// the connection; a commit that FAILS leaves `txOpen` set, so the connection
// is closed rather than reused (rule 2) — the pool cannot know what the
// server did with a transaction whose commit did not answer.
class borrowedTx {
  p: Pool
  l: Lease<slot>
  inner: Tx
  query(sqlText: string, params: []Value): Rows! {
    let rows = this.inner.query(sqlText, params) catch e {
      this.p.mark(this.l.value, e)
      fail e
    }
    return rows
  }

  exec(sqlText: string, params: []Value): ExecResult! {
    let n = this.inner.exec(sqlText, params) catch e {
      this.p.mark(this.l.value, e)
      fail e
    }
    return n
  }

  commit(): ()! {
    this.inner.commit() catch e {
      this.p.mark(this.l.value, e)
      this.p.release(this.l)
      fail e
    }
    this.l.value.txOpen = false
    this.p.release(this.l)
  }

  rollback(): ()! {
    this.inner.rollback() catch e {
      this.p.mark(this.l.value, e)
      this.p.release(this.l)
      fail e
    }
    this.l.value.txOpen = false
    this.p.release(this.l)
  }
}
