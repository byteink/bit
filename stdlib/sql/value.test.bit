// stdlib/sql/value.test.bit — the ten `sqlValue<V>` specialisations
// `compiler/checksqlvalue.bit` retargets a call at (#6256), pinned where
// they live.
//
// `sqlValue<V>` ITSELF CANNOT BE CALLED HERE: `checksqlvalue.bit`'s retarget
// only fires once some OTHER module's import map resolves "std/sql" to this
// module's own id (`sqlValueStdModuleId`), and `std/sql` cannot import
// itself (E0044) — the identical limitation `row.test.bit`'s own header
// comment records for `find<T>`. What IS tested here is every specialisation
// the retarget can choose, called directly by name; the sugar itself
// (`sqlValue(v)` resolving to the right one) is pinned from outside, in
// `_tests_/cases/run_sql_value.bit`.

fn matchesText(v: Value, want: string): bool {
  match (v) {
    Text(s) => return s == want
    _ => return false
  }
}

fn matchesInt(v: Value, want: i64): bool {
  match (v) {
    Int(n) => return n == want
    _ => return false
  }
}

fn matchesBool(v: Value, want: bool): bool {
  match (v) {
    Bool(b) => return b == want
    _ => return false
  }
}

fn matchesFloat(v: Value, want: f64): bool {
  match (v) {
    Float(f) => return f == want
    _ => return false
  }
}

// `bytesEqual` is `sqlcheck.bit`'s own — same module, no import needed.
fn matchesBlob(v: Value, want: []byte): bool {
  match (v) {
    Blob(b) => return bytesEqual(b, want)
    _ => return false
  }
}

test "__sql_value_text wraps a plain string as Value.Text" {
  assert(matchesText(__sql_value_text("sara@example.com"), "sara@example.com"), "text mismatch")
}

test "__sql_value_int wraps a plain i64 as Value.Int" {
  assert(matchesInt(__sql_value_int(5), 5), "int mismatch")
}

test "__sql_value_bool wraps a plain bool as Value.Bool" {
  assert(matchesBool(__sql_value_bool(true), true), "bool mismatch")
}

test "__sql_value_float wraps a plain f64 as Value.Float" {
  assert(matchesFloat(__sql_value_float(3.5), 3.5), "float mismatch")
}

test "__sql_value_blob wraps a plain []byte as Value.Blob" {
  assert(matchesBlob(__sql_value_blob([]byte("hi")), []byte("hi")), "blob mismatch")
}

test "__sql_value_opt_text: None is Value.Null, Some is Value.Text" {
  assert(isNull(__sql_value_opt_text(Option.None)), "opt None should be Null")
  assert(matchesText(__sql_value_opt_text(Option.Some("x")), "x"), "opt Some text mismatch")
}

test "__sql_value_opt_int: None is Value.Null, Some is Value.Int" {
  assert(isNull(__sql_value_opt_int(Option.None)), "opt None should be Null")
  assert(matchesInt(__sql_value_opt_int(Option.Some(7)), 7), "opt Some int mismatch")
}

test "__sql_value_opt_bool: None is Value.Null, Some is Value.Bool" {
  assert(isNull(__sql_value_opt_bool(Option.None)), "opt None should be Null")
  assert(matchesBool(__sql_value_opt_bool(Option.Some(false)), false), "opt Some bool mismatch")
}

test "__sql_value_opt_float: None is Value.Null, Some is Value.Float" {
  assert(isNull(__sql_value_opt_float(Option.None)), "opt None should be Null")
  assert(matchesFloat(__sql_value_opt_float(Option.Some(1.5)), 1.5), "opt Some float mismatch")
}

test "__sql_value_opt_blob: None is Value.Null, Some is Value.Blob" {
  assert(isNull(__sql_value_opt_blob(Option.None)), "opt None should be Null")
  assert(
    matchesBlob(__sql_value_opt_blob(Option.Some([]byte("y"))), []byte("y")),
    "opt Some blob mismatch",
  )
}
