// stdlib/sql/config.test.bit — `Datasource`'s defaults and the two ways it
// can be unusable (#3962).
//
// `Datasource`, `SslMode` and `pool` are siblings in this module, and
// `contains` is imported once for the whole module by ./pool.test.bit
// (imports are per-module, SPEC §17.2 — importing it again here is E0042).
//
// EVERY DEFAULT IS ASSERTED BY VALUE, not "is nonzero". Each of these zero
// values is the dangerous answer — 0 connections, a 0ms acquire timeout that
// waits forever, a connection that never retires — so a default silently
// dropped from the class must fail here, and only an exact number does that.

// A class whose one field is an `SslMode`, used to state the property the
// enum's declaration order carries: an omitted enum field takes the FIRST
// DECLARED VARIANT, and a field of enum type cannot carry an explicit
// default (SPEC §10.5, E0064). If `Negotiate` is ever moved out of first
// place, this is what notices — `Datasource{}.sslmode` alone would not, as
// it would simply mean something else.
class sslModeProbe {
  mode: SslMode,
}

fn modeName(m: SslMode): string {
  match (m) {
    Negotiate => return "Negotiate"
    VerifyFull => return "VerifyFull"
    VerifyCa => return "VerifyCa"
    Require => return "Require"
    Disable => return "Disable"
  }
}

test "Negotiate is the first declared variant of SslMode" {
  let probe = sslModeProbe{}
  assert(
    modeName(probe.mode) == "Negotiate",
    "the zero value of SslMode is ${modeName(probe.mode)}",
  )
}

test "Datasource{} carries the argued pool defaults" {
  let d = Datasource{}
  assert(d.maxOpen == 10, "maxOpen = ${d.maxOpen}")
  assert(d.maxIdle == 10, "maxIdle = ${d.maxIdle}")
  assert(d.maxLifetime == 1800000, "maxLifetime = ${d.maxLifetime}")
  assert(d.maxIdleTime == 600000, "maxIdleTime = ${d.maxIdleTime}")
  assert(d.acquireTimeout == 5000, "acquireTimeout = ${d.acquireTimeout}")
  assert(d.statementCache == 0, "statementCache = ${d.statementCache}")
}

test "Datasource{} names no server and negotiates TLS" {
  let d = Datasource{}
  assert(d.port == 0, "port = ${d.port}")
  assert(modeName(d.sslmode) == "Negotiate", "sslmode = ${modeName(d.sslmode)}")
  assert(d.uri == "" && d.host == "", "uri = '${d.uri}', host = '${d.host}'")
  assert(d.connectTimeout == 10000, "connectTimeout = ${d.connectTimeout}")
}

test "a Datasource with neither uri nor host says there is nothing to connect to" {
  // The unset-DATABASE_URL case. It must not surface as a connection, DNS or
  // parse failure from inside a driver — nothing here ever reaches one.
  let d = Datasource{}
  d.validate() catch e {
    let m = e.message()
    assert(contains(m, "uri"), "message does not name uri: ${m}")
    assert(contains(m, "host"), "message does not name host: ${m}")
    assert(
      contains(m, "nothing to connect to"),
      "message does not say what is wrong: ${m}",
    )
    return
  }
  assert(false, "a Datasource naming no server validated")
}

test "a Datasource setting both uri and host is rejected, naming both" {
  let d = Datasource{ uri: "stub://db", host: "db.internal" }
  d.validate() catch e {
    let m = e.message()
    assert(contains(m, "uri"), "message does not name uri: ${m}")
    assert(contains(m, "host"), "message does not name host: ${m}")
    assert(
      contains(m, "mutually exclusive"),
      "message does not say they are exclusive: ${m}",
    )
    assert(
      !contains(m, "nothing to connect to"),
      "the both-set error reads as the neither-set one: ${m}",
    )
    return
  }
  assert(false, "a Datasource setting both forms validated")
}

test "pool rejects an acquireTimeout of zero" {
  // Zero would mean wait forever, so a database outage would park every
  // worker with no error and no log line.
  let a = newStub()
  let _ = pool(a, Datasource{ host: "db", acquireTimeout: 0 }) catch e {
    assert(
      contains(e.message(), "acquireTimeout"),
      "message does not name the field: ${e.message()}",
    )
    assert(a.connectCount() == 0, "it opened ${a.connectCount()} connections first")
    return
  }
  assert(false, "a pool with acquireTimeout 0 was built")
}

test "pool rejects a maxOpen below one" {
  let a = newStub()
  let _ = pool(a, Datasource{ host: "db", maxOpen: 0 }) catch e {
    assert(
      contains(e.message(), "maxOpen"),
      "message does not name the field: ${e.message()}",
    )
    return
  }
  assert(false, "a pool that may open no connections was built")
}
