// stdlib/sql/row.test.bit — the row-mapping runtime `find`/`findOne`/
// `findOneOrFail` are specialised in terms of (#5054), pinned where it lives.
//
// `find<T>`/`findOne<T>`/`findOneOrFail<T>` THEMSELVES CANNOT BE CALLED HERE:
// `checksqlrow.bit` recognises a call only through an `import { find } from
// "std/sql"` at the call site, and this module cannot import itself
// (E0044) — the identical limitation stdlib/json/decode.test.bit's own
// header comment records for `jsonDecode<T>`. What IS tested here is every
// function the compiler's synthesised mapper is written in terms of —
// `sqlReqInt`/`sqlOptInt`/... and the three generic drivers
// (`sqlFindMany`/`sqlFindOne`/`sqlFindOneOrFail`) — called with a
// HAND-WRITTEN mapper that does exactly what a synthesised one would. The
// sugar itself (the rewrite from `find<User>(...)` to this) is pinned from
// outside, in `_tests_/cases/run_sql_row_find.bit`.

// A canned result set: `cols`/`data` fixed at construction, `next` walks it
// once.
class rowFakeRows {
  cols: []string
  data: [][]Value
  i: int = -1
  next(): bool! {
    this.i = this.i + 1
    return this.i < len(this.data)
  }

  columns(): []string {
    return this.cols
  }

  value(col: int): Value {
    return this.data[this.i][col]
  }

  close() {}
}

class rowFakeConn {
  rows: rowFakeRows
  query(sqlText: string, params: []Value): Rows! {
    return rowFakeRows{ cols: this.rows.cols, data: this.rows.data }
  }

  exec(sqlText: string, params: []Value): int! {
    return 0
  }
}

// A plain projection class — no mark, exactly as `find<T>` accepts — mapped
// by hand the way the compiler's synthesised `__sql_row_probeUser` would.
class probeUser {
  id: i64,
  email: string,
  mail: string,
  active: bool,
  avatar: []byte,
  nick: Option<string>,
}

fn probeUserMapper(rows: Rows): probeUser! {
  let cols = rows.columns()
  return probeUser{
    id: sqlReqInt(rows, cols, "id")?,
    email: sqlReqText(rows, cols, "email")?,
    mail: sqlReqText(rows, cols, "e_mail")?,
    active: sqlReqBool(rows, cols, "active")?,
    avatar: sqlReqBlob(rows, cols, "avatar")?,
    nick: sqlOptText(rows, cols, "nick")?,
  }
}

fn oneRowConn(nick: Value): rowFakeConn {
  return rowFakeConn{
    rows: rowFakeRows{
      cols: ["id", "email", "e_mail", "active", "avatar", "nick", "extra"],
      data: [
        [
          Value.Int(7), Value.Text("a@b.com"), Value.Text("m@b.com"), Value.Int(1),
          Value.Blob([]byte("px")), nick, Value.Text("unclaimed"),
        ],
      ],
    },
  }
}

test "find maps every field: i64, string, bool, []byte, a set Option and a NULL Option" {
  let set = sqlFindMany<probeUser>(
    oneRowConn(Value.Text("hi")), "SELECT * FROM users", []Value(0), probeUserMapper,
  ) catch e {
    assert(false, "must map: ${e.message()}")
    return
  }
  assert(len(set) == 1, "one row, got ${len(set)}")
  let u = set[0]
  assert(u.id == 7, "id, got ${u.id}")
  assert(u.email == "a@b.com", "email, got '${u.email}'")
  assert(u.mail == "m@b.com", "e_mail via @column, got '${u.mail}'")
  assert(u.active, "active, got false")
  assert(string(u.avatar) == "px", "avatar, got '${string(u.avatar)}'")
  assert(isSome(u.nick) && unwrap(u.nick) == "hi", "a set Option, got isSome=${isSome(u.nick)}")

  let nullSet = sqlFindMany<probeUser>(
    oneRowConn(Value.Null), "SELECT * FROM users", []Value(0), probeUserMapper,
  ) catch e {
    assert(false, "must map a NULL Option: ${e.message()}")
    return
  }
  assert(!isSome(nullSet[0].nick), "a NULL Option must decode to None")
}

test "an unclaimed extra column maps successfully" {
  // `oneRowConn` always carries an "extra" column no field of `probeUser`
  // claims; every test in this file exercises that the mapper still
  // succeeds, which is the assertion — a claiming failure would fail every
  // other test here first.
  let set = sqlFindMany<probeUser>(
    oneRowConn(Value.Null), "SELECT * FROM users", []Value(0), probeUserMapper,
  ) catch e {
    assert(false, "the unclaimed column must not block mapping: ${e.message()}")
    return
  }
  assert(len(set) == 1, "the unclaimed column must not block mapping, got ${len(set)} rows")
}

class rowEmptyRows {
  next(): bool! {
    return false
  }

  columns(): []string {
    return []string(0)
  }

  value(col: int): Value {
    return Value.Null
  }

  close() {}
}

class rowEmptyConn {
  query(sqlText: string, params: []Value): Rows! {
    return rowEmptyRows{}
  }

  exec(sqlText: string, params: []Value): int! {
    return 0
  }
}

test "findOne on no rows returns the absent Option, not an error" {
  let none = sqlFindOne<probeUser>(
    rowEmptyConn{},
    "SELECT * FROM users",
    []Value(0),
    probeUserMapper,
  ) catch e {
    assert(false, "must not error on zero rows: ${e.message()}")
    return
  }
  assert(!isSome(none), "must be absent")
}

test "findOneOrFail on no rows fails, distinguishably from a mapping error" {
  sqlFindOneOrFail<probeUser>(
    rowEmptyConn{}, "SELECT * FROM users", []Value(0), probeUserMapper,
  ) catch e {
    let (re, ok) = e.(SqlRowError)
    assert(ok, "a SqlRowError, got '${e.message()}'")
    assert(re.cause == SqlRowCause.NoRows, "cause must be NoRows")
    return
  }
  assert(false, "must fail on zero rows")
}

test "findOneOrFail<i64> on a single-column result yields the integer, no class declared" {
  let conn = rowFakeConn{ rows: rowFakeRows{ cols: ["id"], data: [[Value.Int(42)]] } }
  let id = sqlFindOneOrFail<i64>(
    conn, "SELECT id FROM users LIMIT 1", []Value(0), sqlRowScalarInt,
  ) catch e {
    assert(false, "must yield the integer: ${e.message()}")
    return
  }
  assert(id == 42, "got ${id}")
}

test "a two-column result against a plain i64 errors naming the column count" {
  let conn = rowFakeConn{
    rows: rowFakeRows{ cols: ["id", "email"], data: [[Value.Int(1), Value.Text("x")]] },
  }
  sqlFindOneOrFail<i64>(conn, "SELECT id, email FROM users LIMIT 1", []Value(0), sqlRowScalarInt) catch e {
    let (re, ok) = e.(SqlRowError)
    assert(ok, "a SqlRowError, got '${e.message()}'")
    assert(re.cause == SqlRowCause.ColumnCount, "cause must be ColumnCount")
    assert(
      re.expected == "1" && re.found == "2",
      "must name both counts, got ${re.expected}/${re.found}",
    )
    return
  }
  assert(false, "must fail on a two-column result")
}

fn missingColumnConn(): rowFakeConn {
  return rowFakeConn{ rows: rowFakeRows{ cols: ["email"], data: [[Value.Text("x")]] } }
}

test "a missing claimed column errors naming the column" {
  sqlFindOneOrFail<probeUser>(
    missingColumnConn(), "SELECT email FROM users", []Value(0), probeUserMapper,
  ) catch e {
    let (re, ok) = e.(SqlRowError)
    assert(ok, "a SqlRowError, got '${e.message()}'")
    assert(re.cause == SqlRowCause.MissingColumn, "cause must be MissingColumn")
    assert(re.column == "id", "must name the column, got '${re.column}'")
    return
  }
  assert(false, "must fail on a missing column")
}

test "a type mismatch errors naming the column and both types" {
  let conn = rowFakeConn{ rows: rowFakeRows{ cols: ["id"], data: [[Value.Text("not-an-int")]] } }
  sqlFindOneOrFail<i64>(conn, "SELECT id FROM users", []Value(0), sqlRowScalarInt) catch e {
    let (re, ok) = e.(SqlRowError)
    assert(ok, "a SqlRowError, got '${e.message()}'")
    assert(re.cause == SqlRowCause.TypeMismatch, "cause must be TypeMismatch")
    assert(
      re.column == "id" && re.expected == "Int" && re.found == "Text",
      "must name column and both types, got ${re.column}/${re.expected}/${re.found}",
    )
    return
  }
  assert(false, "must fail on a type mismatch")
}

test "a NULL in a non-Option field errors naming the column" {
  let conn = rowFakeConn{ rows: rowFakeRows{ cols: ["id"], data: [[Value.Null]] } }
  sqlFindOneOrFail<i64>(conn, "SELECT id FROM users", []Value(0), sqlRowScalarInt) catch e {
    let (re, ok) = e.(SqlRowError)
    assert(ok, "a SqlRowError, got '${e.message()}'")
    assert(re.cause == SqlRowCause.NullField, "cause must be NullField")
    assert(re.column == "id", "must name the column, got '${re.column}'")
    return
  }
  assert(false, "must fail on a NULL in a non-Option field")
}
