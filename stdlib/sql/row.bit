  let cols = rows.columns()
  if (len(cols) != 1) {
    fail SqlRowError{
      cause: SqlRowCause.ColumnCount, column: "", expected: "1", found: "${len(cols)}",
    }
  }
  let v = rows.value(0)
  match (v) {
    Int(n) => return n != 0
    Null => fail SqlRowError{
      cause: SqlRowCause.NullField,
      column: cols[0],
      expected: "",
      found: "",
    }
    _ => fail SqlRowError{
      cause: SqlRowCause.TypeMismatch, column: cols[0], expected: "Bool",
      found: sqlValueKind(v),
    }
  }
}

export fn sqlRowScalarText(rows: Rows): string! {
  let cols = rows.columns()
  if (len(cols) != 1) {
    fail SqlRowError{
      cause: SqlRowCause.ColumnCount, column: "", expected: "1", found: "${len(cols)}",
    }
  }
  let v = rows.value(0)
  match (v) {
    Text(s) => return s
    Null => fail SqlRowError{
      cause: SqlRowCause.NullField,
      column: cols[0],
      expected: "",
      found: "",
    }
    _ => fail SqlRowError{
      cause: SqlRowCause.TypeMismatch, column: cols[0], expected: "Text",
      found: sqlValueKind(v),
