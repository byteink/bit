// ---- the shared runtime the compiler's rewrite calls ---------------------
//
// One generic driver per entry point, taking the per-`T` mapper as a value
// (SPEC §11's `func_type`) rather than being specialised itself: unlike
// `find<T>`'s own body, nothing here has to name `T`'s fields, so an ordinary
// generic function — the same shape stdlib/sql/tx.bit's `txValue<T>` already
// takes a `(Tx) => T!` block — does the whole job.

// `find<T>`: runs `sqlText`/`args` and maps every row through `mapper`.
export fn sqlFindMany<T>(db: Executor, sqlText: string, args: []Value, mapper: (Rows) => T!): []T! {
  let rows = db.query(sqlText, args)?
  defer rows.close()
  let out = []T(0)
  while (rows.next()?) {
    out = append(out, mapper(rows)?)
  }
  return out
}

// `findOne<T>`: the absent row is `None`, never an error. More than one row
// is `SqlRowCause.TooManyRows` — a `findOne` caller is asking for at most one.
export fn sqlFindOne<T>(
  db: Executor,
  sqlText: string,
  args: []Value,
  mapper: (Rows) => T!,
): Option<T>! {
  let rows = db.query(sqlText, args)?
  defer rows.close()
  if (!rows.next()?) {
    return Option<T>.None
  }
  let v = mapper(rows)?
  if (rows.next()?) {
    fail SqlRowError{ cause: SqlRowCause.TooManyRows, column: "", expected: "", found: "" }
  }
  return Option<T>.Some(v)
}

// `findOneOrFail<T>`: zero rows is `SqlRowCause.NoRows`; more than one is
// `SqlRowCause.TooManyRows`.
export fn sqlFindOneOrFail<T>(
  db: Executor,
  sqlText: string,
  args: []Value,
  mapper: (Rows) => T!,
): T! {
  let rows = db.query(sqlText, args)?
  defer rows.close()
  if (!rows.next()?) {
    fail SqlRowError{ cause: SqlRowCause.NoRows, column: "", expected: "", found: "" }
  }
  let v = mapper(rows)?
  if (rows.next()?) {
    fail SqlRowError{ cause: SqlRowCause.TooManyRows, column: "", expected: "", found: "" }
  }
  return v
}

// ---- the three entry points -----------------------------------------------
//
// Maps every row `sqlText`/`args` returns into `T`: a plain class refusing
// one that declares `init` (E0152), or one of `i64`/`f64`/`bool`/`string`/
// `[]byte` for a single-column result. THESE BODIES NEVER RUN — every call is
// rewritten by the compiler (compiler/checksqlrow.bit) into a call to
// `sqlFindMany`/`sqlFindOne`/`sqlFindOneOrFail` above, with the mapper
// synthesised for the concrete `T` (or the matching `sqlRowScalar*` function)
// passed in as a value. A `T` with no explicit type argument, or one this
// cannot map, is refused at compile time (E0151/E0152) — never left to fail
// here at runtime.

export fn find<T>(db: Executor, sqlText: string, ...args: Value): []T! {
  fail SqlRowError{
    cause: SqlRowCause.TypeMismatch, column: "", expected: "a plain class or scalar type",
    found: "unspecialised",
  }
}

export fn findOne<T>(db: Executor, sqlText: string, ...args: Value): Option<T>! {
  fail SqlRowError{
    cause: SqlRowCause.TypeMismatch, column: "", expected: "a plain class or scalar type",
    found: "unspecialised",
  }
}

export fn findOneOrFail<T>(db: Executor, sqlText: string, ...args: Value): T! {
  fail SqlRowError{
    cause: SqlRowCause.TypeMismatch, column: "", expected: "a plain class or scalar type",
    found: "unspecialised",
  }
}
