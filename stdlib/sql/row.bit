export fn sqlRowScalarBlob(rows: Rows): []byte! {
  let cols = rows.columns()
  if (len(cols) != 1) {
    fail SqlRowError{
      cause: SqlRowCause.ColumnCount, column: "", expected: "1", found: "${len(cols)}",
    }
  }
  let v = rows.value(0)
  match (v) {
    Blob(b) => return b
    Null => fail SqlRowError{
      cause: SqlRowCause.NullField,
