// stdlib/sql/rowtypes.test.bit — the timestamp/date/time/uuid/json/array
// accessors (#5457, epic #5449), unit-level: no live database, every text
// shape a driver's own converter has been observed sending. `oneColumnConn`
// (row.test.bit, same module, SPEC §17.1) is reused rather than
// redeclared. The live, end-to-end proof against real Postgres/MySQL
// containers lives in pkg/postgres/row.test.bit and pkg/mysql/row.test.bit.

@json class RowtypesSettings {
  theme: string,
  retries: i64,
}

fn colTimestamp(v: Value): Timestamp! {
  let c = oneColumnConn("ts", v)
  let rows = c.query("SELECT ts FROM t", []Value(0))?
  rows.next()?
  return sqlReqTimestamp(rows, rows.columns(), "ts")?
}

test "sqlReqTimestamp reads a plain timestamp (no offset) as UTC" {
  let ts = colTimestamp(Value.Text("2026-09-17 10:30:00")) catch e {
    assert(false, "sqlReqTimestamp: ${e.message()}")
    return
  }
  let w = ts.inZone(utc())
  assert(
      w.year() == 2026 &&
      w.month() == 9 &&
      w.day() == 17 &&
      w.hour() == 10 &&
      w.minute() == 30 &&
      w.second() == 0,
    "got ${w.year()}-${w.month()}-${w.day()} ${w.hour()}:${w.minute()}:${w.second()}",
  )
}

test "sqlReqTimestamp reads variable-width fractional seconds" {
  let ts = colTimestamp(Value.Text("2026-09-17 10:30:00.1")) catch e {
    assert(false, "sqlReqTimestamp: ${e.message()}")
    return
  }
  let w = ts.inZone(utc())
  assert(
    w.time().nanosecond() == 100000000,
    "got ${w.time().nanosecond()}ns",
  )
}

test "sqlReqTimestamp applies a timestamptz UTC offset" {
  let ts = colTimestamp(Value.Text("2026-09-17 10:30:00+02")) catch e {
    assert(false, "sqlReqTimestamp: ${e.message()}")
    return
  }
  let w = ts.inZone(utc())
  assert(
    w.hour() == 8 && w.minute() == 30,
    "a +02 offset must subtract 2 hours to reach UTC, got ${w.hour()}:${w.minute()}",
  )
}

test "sqlReqTimestamp on a NULL column fails NullField naming the column" {
  let c = oneColumnConn("ts", Value.Null)
  let rows = c.query("SELECT ts FROM t", []Value(0)) catch e {
    assert(false, "query: ${e.message()}")
    return
  }
  rows.next() catch e {
    assert(false, "next: ${e.message()}")
    return
  }
  sqlReqTimestamp(rows, rows.columns(), "ts") catch e {
    let (re, ok) = e.(SqlRowError)
    assert(ok, "a SqlRowError, got '${e.message()}'")
    assert(re.cause == SqlRowCause.NullField, "cause must be NullField")
    assert(re.column == "ts", "must name the column, got '${re.column}'")
    return
  }
  assert(false, "must fail on NULL")
}

test "sqlOptTimestamp on NULL returns None without erroring" {
  let c = oneColumnConn("ts", Value.Null)
  let rows = c.query("SELECT ts FROM t", []Value(0)) catch e {
    assert(false, "query: ${e.message()}")
    return
  }
  rows.next() catch e {
    assert(false, "next: ${e.message()}")
    return
  }
  let got = sqlOptTimestamp(rows, rows.columns(), "ts") catch e {
    assert(false, "sqlOptTimestamp: ${e.message()}")
    return
  }
  assert(!isSome(got), "NULL must decode to None")
}

test "sqlReqDate reads an ISO date" {
  let c = oneColumnConn("d", Value.Text("2026-09-17"))
  let rows = c.query("SELECT d FROM t", []Value(0)) catch e {
    assert(false, "query: ${e.message()}")
    return
  }
  rows.next() catch e {
    assert(false, "next: ${e.message()}")
    return
  }
  let got = sqlReqDate(rows, rows.columns(), "d") catch e {
    assert(false, "sqlReqDate: ${e.message()}")
    return
  }
  assert(
    got.year() == 2026 && got.month() == 9 && got.day() == 17,
    "got ${got.year()}-${got.month()}-${got.day()}",
  )
}

test "sqlReqTime reads an ISO time with a fractional second" {
  let c = oneColumnConn("t", Value.Text("10:30:00.123456"))
  let rows = c.query("SELECT t FROM t", []Value(0)) catch e {
    assert(false, "query: ${e.message()}")
    return
  }
  rows.next() catch e {
    assert(false, "next: ${e.message()}")
    return
  }
  let got = sqlReqTime(rows, rows.columns(), "t") catch e {
    assert(false, "sqlReqTime: ${e.message()}")
    return
  }
  assert(
    got.hour() == 10 && got.minute() == 30 && got.second() == 0,
    "got ${got.hour()}:${got.minute()}:${got.second()}",
  )
}

test "sqlReqUuid reads a canonical uuid, case-insensitively" {
  let c = oneColumnConn("id", Value.Text("00112233-4455-6677-8899-AABBCCDDEEFF"))
  let rows = c.query("SELECT id FROM t", []Value(0)) catch e {
    assert(false, "query: ${e.message()}")
    return
  }
  rows.next() catch e {
    assert(false, "next: ${e.message()}")
    return
  }
  sqlReqUuid(rows, rows.columns(), "id") catch e {
    assert(false, "sqlReqUuid: ${e.message()}")
    return
  }
}

test "sqlOptUuid on NULL returns None" {
  let c = oneColumnConn("id", Value.Null)
  let rows = c.query("SELECT id FROM t", []Value(0)) catch e {
    assert(false, "query: ${e.message()}")
    return
  }
  rows.next() catch e {
    assert(false, "next: ${e.message()}")
    return
  }
  let got = sqlOptUuid(rows, rows.columns(), "id") catch e {
    assert(false, "sqlOptUuid: ${e.message()}")
    return
  }
  assert(!isSome(got), "NULL must decode to None")
}

// Covers the epic's own trap list for one document: a nested object, an
// array, a `null` and an embedded quote.
test "sqlReqJson parses a nested object, an array, a null and an embedded quote" {
  let c = oneColumnConn(
    "payload",
    Value.Text("{\"a\":{\"b\":1},\"c\":[true,null],\"d\":\"x\\\"y\"}"),
  )
  let rows = c.query("SELECT payload FROM t", []Value(0)) catch e {
    assert(false, "query: ${e.message()}")
    return
  }
  rows.next() catch e {
    assert(false, "next: ${e.message()}")
    return
  }
  let j = sqlReqJson(rows, rows.columns(), "payload") catch e {
    assert(false, "sqlReqJson: ${e.message()}")
    return
  }
  let entries = jsonObjectEntries(j) catch e {
    assert(false, e.message())
    return
  }
  assert(len(entries) == 3, "got ${len(entries)} top-level entries")
}

fn jsonObjectEntries(j: Json): []JsonEntry! {
  match (j) {
    JsonObject(es) => return es
    _ => fail newError("expected a JsonObject")
  }
}

test "sqlReqJson on a SQL NULL fails, never becomes JsonNull" {
  let c = oneColumnConn("payload", Value.Null)
  let rows = c.query("SELECT payload FROM t", []Value(0)) catch e {
    assert(false, "query: ${e.message()}")
    return
  }
  rows.next() catch e {
    assert(false, "next: ${e.message()}")
    return
  }
  sqlReqJson(rows, rows.columns(), "payload") catch e {
    let (re, ok) = e.(SqlRowError)
    assert(ok, "a SqlRowError, got '${e.message()}'")
    assert(
      re.cause == SqlRowCause.NullField,
      "cause must be NullField, a SQL NULL is not a JSON null",
    )
    return
  }
  assert(false, "must fail on a SQL NULL")
}

test "sqlReqJson on the JSON literal null succeeds — a stored value, not an absent column" {
  let c = oneColumnConn("payload", Value.Text("null"))
  let rows = c.query("SELECT payload FROM t", []Value(0)) catch e {
    assert(false, "query: ${e.message()}")
    return
  }
  rows.next() catch e {
    assert(false, "next: ${e.message()}")
    return
  }
  sqlReqJson(rows, rows.columns(), "payload") catch e {
    assert(false, "the JSON literal null must parse, got ${e.message()}")
    return
  }
}

test "sqlReqJsonAs<T> decodes a class field" {
  let c = oneColumnConn("config", Value.Text("{\"theme\":\"dark\",\"retries\":3}"))
  let rows = c.query("SELECT config FROM t", []Value(0)) catch e {
    assert(false, "query: ${e.message()}")
    return
  }
  rows.next() catch e {
    assert(false, "next: ${e.message()}")
    return
  }
  let got = sqlReqJsonAs<RowtypesSettings>(rows, rows.columns(), "config") catch e {
    assert(false, "sqlReqJsonAs: ${e.message()}")
    return
  }
  assert(got.theme == "dark" && got.retries == 3, "got theme=${got.theme} retries=${got.retries}")
}

test "sqlOptJsonAs<T> on NULL returns None" {
  let c = oneColumnConn("config", Value.Null)
  let rows = c.query("SELECT config FROM t", []Value(0)) catch e {
    assert(false, "query: ${e.message()}")
    return
  }
  rows.next() catch e {
    assert(false, "next: ${e.message()}")
    return
  }
  let got = sqlOptJsonAs<RowtypesSettings>(rows, rows.columns(), "config") catch e {
    assert(false, "sqlOptJsonAs: ${e.message()}")
    return
  }
  assert(!isSome(got), "NULL must decode to None")
}

fn colInts(v: Value): []i64! {
  let c = oneColumnConn("ids", v)
  let rows = c.query("SELECT ids FROM t", []Value(0))?
  rows.next()?
  return sqlReqArray<i64>(rows, rows.columns(), "ids", sqlElemInt)?
}

test "sqlReqArray<i64> decodes a Postgres int array literal" {
  let got = colInts(Value.Text("{1,2,3}")) catch e {
    assert(false, "sqlReqArray: ${e.message()}")
    return
  }
  assert(len(got) == 3 && got[0] == 1 && got[1] == 2 && got[2] == 3, "got len=${len(got)}")
}

test "sqlReqArray<i64> on {} decodes to an empty slice" {
  let got = colInts(Value.Text("{}")) catch e {
    assert(false, "sqlReqArray: ${e.message()}")
    return
  }
  assert(len(got) == 0, "got len=${len(got)}")
}

test "sqlReqArray<i64> fails naming the column on an embedded NULL element" {
  let c = oneColumnConn("ids", Value.Text("{1,NULL,3}"))
  let rows = c.query("SELECT ids FROM t", []Value(0)) catch e {
    assert(false, "query: ${e.message()}")
    return
  }
  rows.next() catch e {
    assert(false, "next: ${e.message()}")
    return
  }
  sqlReqArray<i64>(rows, rows.columns(), "ids", sqlElemInt) catch e {
    let (re, ok) = e.(SqlRowError)
    assert(ok, "a SqlRowError, got '${e.message()}'")
    assert(re.column == "ids", "must name the column, got '${re.column}'")
    return
  }
  assert(false, "must fail on a NULL element")
}

test "sqlReqArray<string> decodes a quoted-element text array, unescaping" {
  let c = oneColumnConn("tags", Value.Text("{\"a,b\",\"c\\\"d\"}"))
  let rows = c.query("SELECT tags FROM t", []Value(0)) catch e {
    assert(false, "query: ${e.message()}")
    return
  }
  rows.next() catch e {
    assert(false, "next: ${e.message()}")
    return
  }
  let got = sqlReqArray<string>(rows, rows.columns(), "tags", sqlElemText) catch e {
    assert(false, "sqlReqArray: ${e.message()}")
    return
  }
  assert(len(got) == 2 && got[0] == "a,b" && got[1] == "c\"d", "got len=${len(got)} [0]=${got[0]}")
}

test "sqlOptArray<i64> on NULL returns None" {
  let c = oneColumnConn("ids", Value.Null)
  let rows = c.query("SELECT ids FROM t", []Value(0)) catch e {
    assert(false, "query: ${e.message()}")
    return
  }
  rows.next() catch e {
    assert(false, "next: ${e.message()}")
    return
  }
  let got = sqlOptArray<i64>(rows, rows.columns(), "ids", sqlElemInt) catch e {
    assert(false, "sqlOptArray: ${e.message()}")
    return
  }
  assert(!isSome(got), "NULL must decode to None")
}
