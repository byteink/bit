// Bit standard library — sql module: the class-attribute descriptor `@table`
// synthesizes (SPEC §10.5, #5051).
//
// The compiler walks a `@table` class's fields at the declaration and
// generates `tableDescriptor(): []FieldDesc` from them — field name, Bit
// type, and every attribute name plus its constant arguments, rendered to
// their source spelling. The compiler attaches NO MEANING to any of it:
// `unique` is a word it copied. `pkg/orm` is what decides `@unique` means a
// UNIQUE constraint; this file only names the shape the compiler hands it.

// One field of a `@table` class: its name and type exactly as written, and
// every attribute the compiler did not resolve to a callable validator
// (SPEC §10.5) — one that DID resolve was called from `validateFields()`
// instead and does not appear here.
export class FieldDesc {
  export name: string,
  export typeName: string,
  export attrs: []AttrDesc,
}

// One recorded attribute: its name and its constant arguments, each
// rendered to the exact text it was written with — `@maxLen(255)`'s `255`
// stays the three-character string "255"; this module never parses it.
export class AttrDesc {
  export name: string,
  export args: []string,
}

// #6301 (S1, epic #6298, `.claude/kb/orm-impl-plan-2026-09-30.md` Feature 2):
// one `@table` class's entry in the project-wide registry `__tables()`
// below builds — its resolved table name, its column list and its own
// class-level attributes, the same three things `__tableName()`/
// `__columns()`/`__tableAttrs()` (compiler/classtablerow.bit) already
// synthesize per class.
export class TableSchema {
  export name: string,
  export columns: []FieldDesc,
  export attrs: []AttrDesc,
}

// Every `@table` class in the project, one `TableSchema` each, in
// declaration order (module order, then source order). `pkg/orm`'s
// `open(url, Options{ synchronize = true })` walks this to create or update
// tables with no hand-written list of classes.
//
// std/sql cannot import the modules a `@table` class lives in — there is no
// source-level way to write this loop — so `compiler/lowertableregistry.bit`
// REPLACES this stub's body at the IR level, but only when something in the
// project actually calls `__tables`. A program with no reference to the
// registry gets exactly the empty answer below and no new IR at all.
export fn __tables(): []TableSchema {
  return []TableSchema(0)
}

// `__tables`'s synthesized body chains through one call to this per `@table`
// class (never from ordinary source — nothing else calls it). Kept as an
// ordinary function, doing the composite-literal/`append` work through the
// normal compiled pipeline, so the IR-level synthesis only ever has to chain
// plain calls together rather than hand-build a slice append itself.
fn __tableAppend(
  out: []TableSchema, name: string, columns: []FieldDesc, attrs: []AttrDesc,
): []TableSchema {
  out = append(out, TableSchema{ name = name, columns = columns, attrs = attrs })
  return out
}

// The seed `__tables`'s synthesized body starts its chain from — kept
// separate from writing `[]TableSchema(0)` directly in hand-built IR, so
// "what is an empty registry" is answered by the ordinary compiled pipeline
// too, the same as `__tableAppend` above.
fn __tableRegistryEmpty(): []TableSchema {
  return []TableSchema(0)
}
