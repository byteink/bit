// std/jwt (#3959): JWS sign/verify round trips, the `none`-algorithm and
// algorithm-confusion rejections, malformed-token rejections, RFC 7519
// claim validation, JWKS key selection, and cross-implementation checks
// against tokens independently produced by Python's `cryptography`/`hmac`
// (no PyJWT involved — every token below was hand-built with primitives
// this module never touches, so signer and verifier cannot share a bug).
//
// All key material is reused from the existing `std/crypto` known-answer
// tests (`_tests_/imports/cryptorsa`, `cryptoecdsa`, `cryptoed25519`), never
// freshly generated here.

import { decodeHex, rsaParsePrivateKey, rsaParsePublicKey } from "std/crypto"
import { contains } from "std/strings"

// --- fixed key material (reused from std/crypto's own KAT fixtures) --------

// The RS256 key: same PKCS#8/SPKI DER as `_tests_/imports/cryptorsa`.
fn rsaPrivDerHex(): string {
  return ""
}

fn rsaPubDerHex(): string {
  return ""
}

// The ES256 key: same P-256 scalar/point as `_tests_/imports/cryptoecdsa`'s
// "p256" vector.
fn p256PrivHex(): string {
  return "c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721"
}

fn p256PubSec1Hex(): string {
  return "0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299"
}

// The EdDSA key: RFC 8032 §7.1 vector t1, same as `_tests_/imports/cryptoed25519`.
fn ed25519SeedHex(): string {
  return "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"
}

fn ed25519PubHex(): string {
  return "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
}

fn hsSecret(): []byte { return []byte("jwt-hs256-test-secret-32-bytes!") }

// --- key construction (fixed-good hex; a decode/parse error here is
// unreachable and degrades to a zero-value key, matching nistec.bit's own
// `nistecHex` precedent -- any real corruption fails loudly downstream) ----

fn rsaSigningKeyFixture(): SigningKey {
  let der = decodeHex(rsaPrivDerHex()) catch _ { return SigningKey.Hs256Key([]byte(0)) }
  let priv = rsaParsePrivateKey(der) catch _ { return SigningKey.Hs256Key([]byte(0)) }
  return SigningKey.Rs256Key(priv)
}

fn rsaVerifyKeyFixture(): VerifyKey {
  let der = decodeHex(rsaPubDerHex()) catch _ { return VerifyKey.Hs256Key([]byte(0)) }
  let pub = rsaParsePublicKey(der) catch _ { return VerifyKey.Hs256Key([]byte(0)) }
  return VerifyKey.Rs256Key(pub)
}

fn es256SigningKeyFixture(): SigningKey {
  let scalar = decodeHex(p256PrivHex()) catch _ { return SigningKey.Hs256Key([]byte(0)) }
  let priv = es256PrivateKey(scalar) catch _ { return SigningKey.Hs256Key([]byte(0)) }
  return SigningKey.Es256Key(priv)
}

fn es256VerifyKeyFixture(): VerifyKey {
  let sec1 = decodeHex(p256PubSec1Hex()) catch _ { return VerifyKey.Hs256Key([]byte(0)) }
  let pub = es256PublicKey(sec1) catch _ { return VerifyKey.Hs256Key([]byte(0)) }
  return VerifyKey.Es256Key(pub)
}

fn ed25519SigningKeyFixture(): SigningKey {
  let seed = decodeHex(ed25519SeedHex()) catch _ { return SigningKey.Hs256Key([]byte(0)) }
  return SigningKey.Ed25519Key(seed)
}

fn ed25519VerifyKeyFixture(): VerifyKey {
  let pub = decodeHex(ed25519PubHex()) catch _ { return VerifyKey.Hs256Key([]byte(0)) }
  return VerifyKey.Ed25519Key(pub)
}

// --- generic test helpers ---------------------------------------------------

fn simplePayload(): Json {
  return Json.JsonObject([
    JsonEntry{ key: "sub", value: Json.JsonString("alice") },
    JsonEntry{ key: "role", value: Json.JsonString("admin") },
  ])
}

// Sign then verify `payload` under a matching key pair; on any failure the
// test itself fails via `assert(false, ...)`, so a caller only has to check
// the returned payload's contents.
fn signAndVerify(skey: SigningKey, vkey: VerifyKey, payload: Json): Json {
  let token = sign(skey, payload) catch e {
    assert(false, "sign failed: ${e.message()}")
    return Json.JsonNull
  }
  let got = verify(token, vkey) catch e {
    assert(false, "verify failed: ${e.message()}")
    return Json.JsonNull
  }
  return got
}

// `verify`'s error message, or `""` on success -- lets a test assert on the
// exact rejection reason without a `catch` block of its own.
fn verifyErrorMsg(token: string, vkey: VerifyKey): string {
  verify(token, vkey) catch e {
    return e.message()
  }
  return ""
}

// `verifyToken`'s error message, or `""` on success.
fn verifyTokenErrorMsg(token: string, vkey: VerifyKey, opts: ClaimsOptions): string {
  verifyToken(token, vkey, opts) catch e {
    return e.message()
  }
  return ""
}

fn jsonStr(v: string): Json { return Json.JsonString(v) }
fn jsonNum(v: int): Json { return Json.JsonInt(i64(v)) }

// The registered claims one test wants on a payload, each optional -- `None`
// means "omit this claim entirely", not "claim is zero/empty".
class ClaimSet {
  exp: Option<int>,
  nbf: Option<int>,
  iat: Option<int>,
  iss: Option<string>,
  aud: Option<string>,
}

// A `ClaimSet` with every claim omitted; set the fields a test needs on the
// result.
fn noClaims(): ClaimSet {
  return ClaimSet{
    exp: Option.None, nbf: Option.None, iat: Option.None,
    iss: Option.None, aud: Option.None,
  }
}

// A payload carrying exactly the claims present in `c`.
fn claimsPayload(c: ClaimSet): Json {
  let entries = []JsonEntry(0)
  if (isSome(c.exp)) { entries = append(entries, JsonEntry{ key: "exp", value: jsonNum(unwrap(c.exp)) }) }
  if (isSome(c.nbf)) { entries = append(entries, JsonEntry{ key: "nbf", value: jsonNum(unwrap(c.nbf)) }) }
  if (isSome(c.iat)) { entries = append(entries, JsonEntry{ key: "iat", value: jsonNum(unwrap(c.iat)) }) }
  if (isSome(c.iss)) { entries = append(entries, JsonEntry{ key: "iss", value: jsonStr(unwrap(c.iss)) }) }
  if (isSome(c.aud)) { entries = append(entries, JsonEntry{ key: "aud", value: jsonStr(unwrap(c.aud)) }) }
  return Json.JsonObject(entries)
}

// A token signed (HS256, the test fixture secret) over `claimsPayload`'s
// result -- the vehicle every claims test below verifies against.
fn signClaims(c: ClaimSet): string {
  let payload = claimsPayload(c)
  return sign(SigningKey.Hs256Key(hsSecret()), payload) catch e {
    assert(false, "sign failed: ${e.message()}")
    return ""
  }
}

// --- round trips: one per algorithm this module implements -----------------

test "HS256: sign then verify round-trips the payload" {
  let secret = hsSecret()
  let got = signAndVerify(SigningKey.Hs256Key(secret), VerifyKey.Hs256Key(secret), simplePayload())
  let sub = jsonAsString(unwrap(jsonGet(got, "sub")))
  assert(isSome(sub) && unwrap(sub) == "alice", "HS256 round trip lost 'sub'")
}

test "RS256: sign then verify round-trips the payload" {
  let got = signAndVerify(rsaSigningKeyFixture(), rsaVerifyKeyFixture(), simplePayload())
  let sub = jsonAsString(unwrap(jsonGet(got, "sub")))
  assert(isSome(sub) && unwrap(sub) == "alice", "RS256 round trip lost 'sub'")
}

test "ES256: sign then verify round-trips the payload" {
  let got = signAndVerify(es256SigningKeyFixture(), es256VerifyKeyFixture(), simplePayload())
  let sub = jsonAsString(unwrap(jsonGet(got, "sub")))
  assert(isSome(sub) && unwrap(sub) == "alice", "ES256 round trip lost 'sub'")
}

test "EdDSA: sign then verify round-trips the payload" {
  let got = signAndVerify(ed25519SigningKeyFixture(), ed25519VerifyKeyFixture(), simplePayload())
  let sub = jsonAsString(unwrap(jsonGet(got, "sub")))
  assert(isSome(sub) && unwrap(sub) == "alice", "EdDSA round trip lost 'sub'")
}

// --- the `alg: none` and algorithm-confusion rejections ---------------------

test "a token whose header claims alg:none is rejected, never dispatched" {
  // Hand-built: {"alg":"none","typ":"JWT"} / {} / a plausible-looking (but
  // never checked, because the alg comparison rejects first) signature.
  let token = "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.e30.QQ"
  let msg = verifyErrorMsg(token, VerifyKey.Hs256Key(hsSecret()))
  assert(msg != "", "alg:none token was accepted")
  assert(
    contains(msg, "algorithm mismatch"),
    "alg:none was rejected for the wrong reason: ${msg}",
  )
}

test "an HS256 token forged with the RSA public key's DER bytes as the HMAC secret is rejected when RS256 is requested" {
  // Independently produced (Python `hmac`+`hashlib`, no PyJWT): header
  // {"alg":"RS256"} to match what the verifier expects, payload arbitrary,
  // signature = HMAC-SHA256(rsaPublicKeySpkiDerBytes, signingInput) -- the
  // classic RS256-to-HS256 confusion forgery, using bytes an attacker who
  // only has the PUBLIC key legitimately possesses.
  let token = "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkphbmUgRG9lIiwiaWF0IjoxNzAwMDAwMDAwLCJleHAiOjQxMDI0NDQ4MDB9.VFTXs1SwuE56d_YfoN5RPkiTcMMUBKp1Li0GqP4f3YE"
  let msg = verifyErrorMsg(token, rsaVerifyKeyFixture())
  assert(msg != "", "algorithm-confusion forgery was accepted")
  assert(
    contains(msg, "invalid signature"),
    "confusion forgery was rejected for the wrong reason: ${msg}",
  )
}

// --- malformed compact tokens -----------------------------------------------

test "a token with three dots (four segments) is rejected" {
  let msg = verifyErrorMsg("a.b.c.d", VerifyKey.Hs256Key(hsSecret()))
  assert(msg != "", "four-segment token was accepted")
  assert(contains(msg, "3 segments"), "wrong rejection reason: ${msg}")
}

test "a token with an empty signature segment is rejected" {
  let msg = verifyErrorMsg("aGVhZGVy.cGF5bG9hZA.", VerifyKey.Hs256Key(hsSecret()))
  assert(msg != "", "empty-signature-segment token was accepted")
  assert(contains(msg, "empty signature"), "wrong rejection reason: ${msg}")
}

test "a token using the standard (non-URL-safe) base64 alphabet is rejected" {
  // "+" and "/" and "=" padding never appear in a valid JWS segment.
  let msg = verifyErrorMsg("ey+/==.ey+/==.ey+/==", VerifyKey.Hs256Key(hsSecret()))
  assert(msg != "", "standard-alphabet base64 token was accepted")
}

// --- RFC 7519 claim validation ----------------------------------------------

const fixedNow: int = 1700000000

test "an expired token is rejected" {
  let c = noClaims()
  c.exp = Option.Some(fixedNow - 3600)
  let token = signClaims(c)
  let opts = defaultClaimsOptions(fixedNow)
  let msg = verifyTokenErrorMsg(token, VerifyKey.Hs256Key(hsSecret()), opts)
  assert(msg != "", "expired token was accepted")
  assert(contains(msg, "expired"), "wrong rejection reason: ${msg}")
}

test "a not-yet-valid token is rejected" {
  let c = noClaims()
  c.nbf = Option.Some(fixedNow + 3600)
  let token = signClaims(c)
  let opts = defaultClaimsOptions(fixedNow)
  let msg = verifyTokenErrorMsg(token, VerifyKey.Hs256Key(hsSecret()), opts)
  assert(msg != "", "not-yet-valid token was accepted")
  assert(contains(msg, "not yet valid"), "wrong rejection reason: ${msg}")
}

test "a token with the wrong issuer is rejected" {
  let c = noClaims()
  c.iss = Option.Some("issuer-a")
  let token = signClaims(c)
  let opts = ClaimsOptions{
    now: fixedNow, leewaySeconds: 60,
    expectedIss: Option.Some("issuer-b"), expectedAud: Option.None,
  }
  let msg = verifyTokenErrorMsg(token, VerifyKey.Hs256Key(hsSecret()), opts)
  assert(msg != "", "wrong-issuer token was accepted")
  assert(contains(msg, "issuer"), "wrong rejection reason: ${msg}")
}

test "a token with the wrong audience is rejected" {
  let c = noClaims()
  c.aud = Option.Some("aud-a")
  let token = signClaims(c)
  let opts = ClaimsOptions{
    now: fixedNow, leewaySeconds: 60,
    expectedIss: Option.None, expectedAud: Option.Some("aud-b"),
  }
  let msg = verifyTokenErrorMsg(token, VerifyKey.Hs256Key(hsSecret()), opts)
  assert(msg != "", "wrong-audience token was accepted")
  assert(contains(msg, "audience"), "wrong rejection reason: ${msg}")
}

test "exp/iss/aud are each rejected with a DISTINCT message from one another" {
  let ce = noClaims()
  ce.exp = Option.Some(fixedNow - 3600)
  let ci = noClaims()
  ci.iss = Option.Some("a")
  let ca = noClaims()
  ca.aud = Option.Some("a")
  let expToken = signClaims(ce)
  let issToken = signClaims(ci)
  let audToken = signClaims(ca)
  let issOpts = ClaimsOptions{ now: fixedNow, leewaySeconds: 60, expectedIss: Option.Some("b"), expectedAud: Option.None }
  let audOpts = ClaimsOptions{ now: fixedNow, leewaySeconds: 60, expectedIss: Option.None, expectedAud: Option.Some("b") }
  let expMsg = verifyTokenErrorMsg(expToken, VerifyKey.Hs256Key(hsSecret()), defaultClaimsOptions(fixedNow))
  let issMsg = verifyTokenErrorMsg(issToken, VerifyKey.Hs256Key(hsSecret()), issOpts)
  let audMsg = verifyTokenErrorMsg(audToken, VerifyKey.Hs256Key(hsSecret()), audOpts)
  assert(expMsg != issMsg && issMsg != audMsg && expMsg != audMsg, "claim rejections are not distinct: exp=${expMsg} iss=${issMsg} aud=${audMsg}")
}

test "a token expired by LESS than the skew is accepted, by MORE is rejected" {
  let cWithin = noClaims()
  cWithin.exp = Option.Some(fixedNow - 30)
  let cBeyond = noClaims()
  cBeyond.exp = Option.Some(fixedNow - 90)
  let withinSkew = signClaims(cWithin)
  let beyondSkew = signClaims(cBeyond)
  let opts = defaultClaimsOptions(fixedNow)
  let withinMsg = verifyTokenErrorMsg(withinSkew, VerifyKey.Hs256Key(hsSecret()), opts)
  let beyondMsg = verifyTokenErrorMsg(beyondSkew, VerifyKey.Hs256Key(hsSecret()), opts)
  assert(withinMsg == "", "expired-by-30s (< 60s skew) was rejected: ${withinMsg}")
  assert(beyondMsg != "", "expired-by-90s (> 60s skew) was accepted")
}

test "a tampered payload fails signature verification" {
  let c = noClaims()
  c.exp = Option.Some(fixedNow + 3600)
  let token = signClaims(c)
  let parts = split(token, ".")
  // Flip the payload to a JSON object claiming a far-future exp -- still
  // well-formed JSON, still valid base64url, only the signed bytes differ.
  let tampered = parts[0] + "." + encodeBase64Url([]byte("{\"exp\":9999999999}")) + "." + parts[2]
  let msg = verifyErrorMsg(tampered, VerifyKey.Hs256Key(hsSecret()))
  assert(msg != "", "tampered payload was accepted")
  assert(contains(msg, "invalid signature"), "wrong rejection reason: ${msg}")
}

// --- JWKS --------------------------------------------------------------------

fn twoKeyJwks(): string {
  return "{\"keys\":[" +
    "{\"kty\":\"RSA\",\"kid\":\"key1\"," +
    "\"n\":\"tdfQzJOwLozRwoqnXQUKI7z9AWrpWx7BgU_3CXf9IK8ZxeBYXjjRzyuWVIeFy4x2nVi35MCvNWH5l17kY2jDRAdNz1TIk1-cNrY7X9ZHV1fOJPoqw3jcmFDEfODqWPCkAZ8_Z_V4LFjYsnzKr71Jk6i73kWrTrhcxfHqnhP3gcA8Aw8NQ1j0nyrpx2xcL-X_K93ojuYNgVXB0g7R2k09HjdlLWoaKsW1jfvG9FkUrTRzsqYjf8DJkmoKJD0CVml7_Y9O9DNw16t5xvw5qdAmwVkhFUL2ZiaJ-QWa0IlOFIFwCPp-Q3BsJ3ihd1h9CeuGRzeDsga9GJOoIV6sX_A-Qw\"," +
    "\"e\":\"AQAB\"}," +
    "{\"kty\":\"EC\",\"kid\":\"key2\",\"crv\":\"P-256\"," +
    "\"x\":\"YP7UuiVanTHJYet0xjVtaMBJuJI7Yfps5mliLmDyn7Y\"," +
    "\"y\":\"eQP-EAi4vJmkGunpVii8ZPLxsgwtfp9Rd6PClNRGIpk\"}" +
    "]}"
}

test "a JWKS with two keys selects the RSA key by kid and it verifies a real token" {
  let jwks = parseJwks(twoKeyJwks()) catch e {
    assert(false, "parseJwks failed: ${e.message()}")
    return
  }
  let key = jwksFindByKid(jwks, "key1") catch e {
    assert(false, "jwksFindByKid('key1') failed: ${e.message()}")
    return
  }
  let token = sign(rsaSigningKeyFixture(), simplePayload()) catch e {
    assert(false, "sign failed: ${e.message()}")
    return
  }
  verify(token, key) catch e {
    assert(false, "the JWKS-selected key1 did not verify the RS256 token it should match: ${e.message()}")
    return
  }
}

test "a JWKS with two keys selects the EC key by kid and it verifies a real token" {
  let jwks = parseJwks(twoKeyJwks()) catch e {
    assert(false, "parseJwks failed: ${e.message()}")
    return
  }
  let key = jwksFindByKid(jwks, "key2") catch e {
    assert(false, "jwksFindByKid('key2') failed: ${e.message()}")
    return
  }
  let token = sign(es256SigningKeyFixture(), simplePayload()) catch e {
    assert(false, "sign failed: ${e.message()}")
    return
  }
  verify(token, key) catch e {
    assert(false, "the JWKS-selected key2 did not verify the ES256 token it should match: ${e.message()}")
    return
  }
}

test "looking up a kid absent from the JWKS fails" {
  let jwks = parseJwks(twoKeyJwks()) catch e {
    assert(false, "parseJwks failed: ${e.message()}")
    return
  }
  jwksFindByKid(jwks, "no-such-kid") catch e {
    assert(contains(e.message(), "kid"), "wrong rejection reason: ${e.message()}")
    return
  }
  assert(false, "lookup of an absent kid succeeded")
}

test "refreshJwks re-parses a JWKS document the same way parseJwks does" {
  let a = parseJwks(twoKeyJwks()) catch e {
    assert(false, "parseJwks failed: ${e.message()}")
    return
  }
  let b = refreshJwks(twoKeyJwks()) catch e {
    assert(false, "refreshJwks failed: ${e.message()}")
    return
  }
  assert(len(a.keys) == len(b.keys), "refreshJwks produced a different key count")
  assert(len(a.keys) == 2, "expected 2 keys, got ${len(a.keys)}")
}

// --- cross-implementation verification --------------------------------------
//
// Every token below was produced OUTSIDE Bit, independently, with Python's
// `cryptography` library plus the `hmac`/`hashlib` stdlib -- never PyJWT, so
// there is no code shared with this module's own signer. See the ticket
// comment for the exact commands and their output (4 algorithms, 4 vectors).

test "cross-check: a Python-signed HS256 token verifies here" {
  let token = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkphbmUgRG9lIiwiaWF0IjoxNzAwMDAwMDAwLCJleHAiOjQxMDI0NDQ4MDB9.jSyvoRbFOeigtOwCqUIklr8OHlPPRBC0Z-TR5EO5D9I"
  let got = verify(token, VerifyKey.Hs256Key(hsSecret())) catch e {
    assert(false, "cross-check HS256 failed: ${e.message()}")
    return
  }
  let sub = jsonAsString(unwrap(jsonGet(got, "sub")))
  assert(isSome(sub) && unwrap(sub) == "1234567890", "HS256 cross-check payload mismatch")
}

test "cross-check: a Python-signed RS256 token verifies here" {
  let token = "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkphbmUgRG9lIiwiaWF0IjoxNzAwMDAwMDAwLCJleHAiOjQxMDI0NDQ4MDB9.akqSnN9mmwrkltYGG78U1WXsHexx0mqp7O8zrVgcIf7qCyxX-gKt3l_LYt7Z5_ktOu2FsunVekZzzC0ZARdFJ6Qt2TkU-gdo3FhUJi7r_y2LqOPWPzjmYIVlM0e7WksvBZRtN6MyfCjVGlh6k_AWExGF3oIwd5XGn4SvePmc-RzV0ipKxmsgQYocslJKK1zmeLy7iQxyCCm2l4yhkHOuVFSqiFeflz6CnCVRmQxNE2lUhBcf2SG3SFnUUxC0UTPBQ7io-f2u0BNZaazl1PCHjcWvABlCu4F45EuXpj9qVeojqx_XqmHAhM3K7JDULmWTV9-v8-rDdvpnAS2-ZbW7vA"
  let got = verify(token, rsaVerifyKeyFixture()) catch e {
    assert(false, "cross-check RS256 failed: ${e.message()}")
    return
  }
  let sub = jsonAsString(unwrap(jsonGet(got, "sub")))
  assert(isSome(sub) && unwrap(sub) == "1234567890", "RS256 cross-check payload mismatch")
}

test "cross-check: a Python-signed ES256 token verifies here" {
  let token = "eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkphbmUgRG9lIiwiaWF0IjoxNzAwMDAwMDAwLCJleHAiOjQxMDI0NDQ4MDB9.jZPVHa3SC42KXsNfDotGnp8rCCJdTIrbFc25G1ohICHJ3iBJcTk8V6Hjm6o8vBTdMpg4ml9MIzbCWJ2AoRDPuw"
  let got = verify(token, es256VerifyKeyFixture()) catch e {
    assert(false, "cross-check ES256 failed: ${e.message()}")
    return
  }
  let sub = jsonAsString(unwrap(jsonGet(got, "sub")))
  assert(isSome(sub) && unwrap(sub) == "1234567890", "ES256 cross-check payload mismatch")
}

test "cross-check: a Python-signed EdDSA token verifies here" {
  let token = "eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkphbmUgRG9lIiwiaWF0IjoxNzAwMDAwMDAwLCJleHAiOjQxMDI0NDQ4MDB9.cNcnXhvkI7xM71FVKHL7sbHQX39Zy18pAQAh_NY-0zCzkIK395laf0EKD2Smrpzel249zXUoRyIBF5L041rFCA"
  let got = verify(token, ed25519VerifyKeyFixture()) catch e {
    assert(false, "cross-check EdDSA failed: ${e.message()}")
    return
  }
  let sub = jsonAsString(unwrap(jsonGet(got, "sub")))
  assert(isSome(sub) && unwrap(sub) == "1234567890", "EdDSA cross-check payload mismatch")
}
