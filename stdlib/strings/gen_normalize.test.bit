// stdlib/strings/gen_normalize.test.bit — #6877. The generated normalization
// tables (gen_normalize.bit), checked from two sides: the values the ticket
// names, and a sweep of the whole codepoint space that needs no outside file.
//
// This file imports nothing: std/os and std/fs both import std/strings, so a
// test inside this module cannot read the UCD to check every UnicodeData.txt
// line against the tables. That sweep was run once against UCD 17.0.0 when the
// tables were generated (the ticket records the result).

fn normTestEq(a: []rune, b: []rune): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

fn normTestPair(a: int, b: int): []rune {
  return []rune{ rune(a), rune(b) }
}

test "ccc names the combining class" {
  assert(ccc(rune(0x301)) == 230, "ccc(U+0301)")
  assert(ccc(rune(0x316)) == 220, "ccc(U+0316)")
  assert(ccc(rune(0x334)) == 1, "ccc(U+0334)")
  assert(ccc(rune(0x5B0)) == 10, "ccc(U+05B0)")
  assert(ccc(rune(0x1E94A)) == 7, "ccc(U+1E94A), the last class-bearing rune")
  assert(ccc(rune(0x1E94B)) == 0, "ccc(U+1E94B)")
  assert(ccc(rune(0x65)) == 0, "ccc(e)")
  assert(ccc(rune(0)) == 0, "ccc(NUL)")
  assert(ccc(rune(0x10FFFF)) == 0, "ccc(U+10FFFF)")
}

test "canonicalDecomp is the single-level canonical mapping" {
  assert(normTestEq(canonicalDecomp(rune(0xE9)), normTestPair(0x65, 0x301)), "U+00E9")
  assert(normTestEq(canonicalDecomp(rune(0x212B)), []rune{ rune(0xC5) }), "U+212B is a singleton")
  assert(
    normTestEq(canonicalDecomp(rune(0x1EA5)), normTestPair(0xE2, 0x301)),
    "U+1EA5 is one level only",
  )
  assert(
    normTestEq(canonicalDecomp(rune(0x958)), normTestPair(0x915, 0x93C)),
    "U+0958 still decomposes",
  )
  assert(len(canonicalDecomp(rune(0x41))) == 0, "A has no decomposition")
  assert(len(canonicalDecomp(rune(0xFB01))) == 0, "U+FB01 is compatibility only")
  assert(len(canonicalDecomp(rune(0xAC00))) == 0, "Hangul is algorithmic")
}

test "compatDecomp is the single-level compatibility mapping" {
  assert(normTestEq(compatDecomp(rune(0xFB01)), normTestPair(0x66, 0x69)), "U+FB01")
  assert(normTestEq(compatDecomp(rune(0xA0)), []rune{ rune(0x20) }), "U+00A0")
  assert(len(compatDecomp(rune(0xFDFA))) == 18, "U+FDFA is the longest mapping")
  assert(len(compatDecomp(rune(0xE9))) == 0, "U+00E9 is canonical only")
  assert(len(compatDecomp(rune(0x10FFFF))) == 0, "past the last entry")
}

test "compose returns the primary composite and respects exclusions" {
  assert(compose(rune(0x65), rune(0x301)) == rune(0xE9), "e + acute")
  assert(compose(rune(0x11099), rune(0x110BA)) == rune(0x1109A), "Kaithi, a codepoint past 16 bits")
  assert(compose(rune(0x915), rune(0x93C)) == rune(0), "U+0958 is excluded")
  assert(compose(rune(0x41), rune(0x42)) == rune(0), "no such pair")
  assert(compose(rune(0xC5), rune(0)) == rune(0), "no pair ends in NUL")
  assert(compose(rune(0x10FFFF), rune(0x10FFFF)) == rune(0), "past the table range")
  assert(compose(rune(0x65), rune(0x1000000)) == rune(0), "second rune out of range")
}

// Every rune, no outside data: the two decomposition tables are disjoint, a
// composite round-trips through its own decomposition, and `compose` never
// invents a pair.
test "the tables agree with each other across the whole codepoint space" {
  let composites = 0
  let r = 0
  while (r <= 0x10FFFF) {
    let cd = canonicalDecomp(rune(r))
    let kd = compatDecomp(rune(r))
    assert(len(cd) == 0 || len(kd) == 0, "U+${r}: in both decomposition tables")
    if (len(cd) == 2) {
      let c = compose(cd[0], cd[1])
      assert(c == rune(0) || c == rune(r), "U+${r}: its pair composes to another rune")
      if (c == rune(r)) {
        composites = composites + 1
      }
    }
    r = r + 1
  }
  assert(composites == 961, "primary composites: ${composites}")
}
