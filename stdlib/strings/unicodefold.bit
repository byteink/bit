// Bit standard library — strings module, Unicode SIMPLE case folding.
//
// "Simple" means one code point maps to exactly one code point — never to a
// multi-character expansion. Unicode's FULL case folding maps German `ß` to
// `"ss"`, which grows the byte length; simple folding leaves `ß` unmapped, and
// #2278 pinned `equalFold("straße", "STRASSE") == false` as the wanted
// result, which this file must not regress.
//
// Coverage, the scripts #2341's acceptance bar names: Latin-1 Supplement,
// Latin Extended-A (in full) and Latin Extended-B (a conservative slice —
// see `latinExtBLower` below), Greek and Coptic, and Cyrillic (the main
// alphabet plus the historic 0x460-0x481 extension). A code point outside
// this coverage folds to itself: that is always safe, it just means two
// differently-cased spellings in an uncovered script compare unequal, same
// as today's ASCII-only behaviour for those scripts.
//
// Every block below is arithmetic over a verified contiguous range (a fixed
// offset, e.g. Latin-1's uppercase-to-lowercase +0x20) rather than a
// hand-transcribed per-codepoint table: fewer numbers to get wrong, and the
// rule documents itself. The genuinely irregular pairs (Greek's
// tonos-accented capitals, final sigma's uppercase) are called out as the
// exceptions they are, not folded into a range check that would be wrong for
// them.
//
// Two scripts' known irregulars are deliberately NOT covered, rather than
// guessed at: Latin Extended-B beyond the two verified runs below (several
// sub-ranges there are not uniformly paired — e.g. U+04C0 Cyrillic palochka's
// lowercase partner is the non-adjacent U+04CF, not U+04C1 that a blind
// even/odd rule would produce), and the Cyrillic block past U+0481. A wrong
// mapping is worse than a gap: a gap just leaves two spellings unequal, a
// wrong mapping can silently fold two UNRELATED letters together.

// Whether `v` falls in the inclusive range `lo..hi`. Factored out purely to
// keep the range checks below to one branch each at their call site — every
// caller here is a chain of independent range tests, and the E0204
// complexity gate counts each `&&` in a caller's own condition, not
// branching hidden inside a callee.
fn inRange(v: int, lo: int, hi: int): bool {
  return v >= lo && v <= hi
}

// Whether `v` is in `lo..hi` and has the given parity (0 even, 1 odd) — the
// even/odd alternating pairs that make up most of Latin Extended-A/B and
// Cyrillic's historic extension.
fn inParityRange(v: int, lo: int, hi: int, parity: int): bool {
  return v >= lo && v <= hi && v % 2 == parity
}

// The lowercase code point `r` folds to under simple case folding, or `r`
// itself if it has none in the scripts this file covers.
fn toLowerRune(r: rune): rune {
  let v = int(r)
  if (inRange(v, 65, 90)) {
    return rune(v + 32)
  }
  if (inRange(v, 0x80, 0xFF)) {
    return rune(latin1Lower(v))
  }
  if (inRange(v, 0x100, 0x24F)) {
    return rune(latinExtLower(v))
  }
  if (inRange(v, 0x370, 0x3FF)) {
    return rune(greekLower(v))
  }
  if (inRange(v, 0x400, 0x4FF)) {
    return rune(cyrillicLower(v))
  }
  return r
}

// The uppercase code point `r` folds to under simple case folding, or `r`
// itself if it has none in the scripts this file covers.
fn toUpperRune(r: rune): rune {
  let v = int(r)
  if (inRange(v, 97, 122)) {
    return rune(v - 32)
  }
  if (inRange(v, 0x80, 0xFF)) {
    return rune(latin1Upper(v))
  }
  if (inRange(v, 0x100, 0x24F)) {
    return rune(latinExtUpper(v))
  }
  if (inRange(v, 0x370, 0x3FF)) {
    return rune(greekUpper(v))
  }
  if (inRange(v, 0x400, 0x4FF)) {
    return rune(cyrillicUpper(v))
  }
  return r
}

// The canonical fold target used to compare `r` against another rune
// case-insensitively (`equalFold`). Simple folding only, same coverage as
// `toLowerRune`/`toUpperRune` — this file has no script where the fold
// target diverges from the lowercase mapping, so the two share one table.
fn foldRune(r: rune): rune {
  return toLowerRune(r)
}

// Latin-1 Supplement (U+0080-U+00FF): uppercase 0xC0-0xDE maps to lowercase
// by +0x20, except 0xD7 (multiplication sign, not a letter). 0xDF (sharp s)
// has no Latin-1 uppercase partner — left unmapped, which is exactly what
// keeps `equalFold("straße", "STRASSE")` false. 0xFF (y with diaeresis)'s
// uppercase (U+0178) lies in Latin Extended-A, handled below instead.
fn latin1Lower(v: int): int {
  if (inRange(v, 0xC0, 0xDE) && v != 0xD7) {
    return v + 0x20
  }
  return v
}

fn latin1Upper(v: int): int {
  if (inRange(v, 0xE0, 0xFE) && v != 0xF7) {
    return v - 0x20
  }
  if (v == 0xFF) {
    return 0x178 // ÿ -> Ÿ, the one cross-block pair into Latin Extended-A
  }
  return v
}

// Latin Extended-A (U+0100-U+017F) and a conservative slice of Latin
// Extended-B (U+0180-U+024F).
fn latinExtLower(v: int): int {
  if (v <= 0x17F) {
    return latinExtALower(v)
  }
  return latinExtBLower(v)
}

fn latinExtUpper(v: int): int {
  if (v <= 0x17F) {
    return latinExtAUpper(v)
  }
  return latinExtBUpper(v)
}

// Latin Extended-A: three runs of even/odd pairs whose parity flips twice
// within the block (0x100-0x137 even=upper, 0x139-0x148 odd=upper,
// 0x14A-0x177 even=upper, 0x179-0x17E odd=upper), plus U+0178 (Ÿ), whose
// lowercase (U+00FF) is in Latin-1. U+0138, U+0149 and U+017F are
// caseless/cross-script singles in this block and are left unmapped.
fn latinExtALower(v: int): int {
  if (v == 0x178) {
    return 0xFF
  }
  if (inParityRange(v, 0x100, 0x137, 0)) {
    return v + 1
  }
  if (inParityRange(v, 0x139, 0x148, 1)) {
    return v + 1
  }
  if (inParityRange(v, 0x14A, 0x177, 0)) {
    return v + 1
  }
  if (inParityRange(v, 0x179, 0x17E, 1)) {
    return v + 1
  }
  return v
}

fn latinExtAUpper(v: int): int {
  if (inParityRange(v, 0x100, 0x137, 1)) {
    return v - 1
  }
  if (inParityRange(v, 0x139, 0x148, 0)) {
    return v - 1
  }
  if (inParityRange(v, 0x14A, 0x177, 1)) {
    return v - 1
  }
  if (inParityRange(v, 0x179, 0x17E, 0)) {
    return v - 1
  }
  return v
}

// Latin Extended-B, conservative slice: U+01CD-U+01DC (the caron-accented
// vowels Ǎǎ...Ǜǜ, odd=upper) and U+0200-U+0233 (the double-grave,
// inverted-breve and comma-below accented Latin letters used for scholarly
// transcription, even=upper throughout, no exceptions in that run). The rest
// of Latin Extended-B is not covered — see the file header.
fn latinExtBLower(v: int): int {
  if (inParityRange(v, 0x1CD, 0x1DC, 1)) {
    return v + 1
  }
  if (inParityRange(v, 0x200, 0x233, 0)) {
    return v + 1
  }
  return v
}

fn latinExtBUpper(v: int): int {
  if (inParityRange(v, 0x1CD, 0x1DC, 0)) {
    return v - 1
  }
  if (inParityRange(v, 0x200, 0x233, 1)) {
    return v - 1
  }
  return v
}

// Greek and Coptic (U+0370-U+03FF). The main alphabet (Α-Ρ, Σ-Ω, plus Ϊ Ϋ)
// is a uniform +0x20 offset, same shape as ASCII/Latin-1/Cyrillic; the
// tonos-accented capitals (Ά Έ Ή Ί Ό Ύ Ώ) are scattered, irregular offsets
// and are listed as the exceptions they are. Final sigma (U+03C2, ς) has no
// lowercase target (it already is one) but DOES have a simple uppercase
// mapping to Σ — the same Σ that Σ's own lowering targets, which is why
// `toLower` on a word ending Σ produces plain σ, never ς: simple folding has
// no notion of word-final position, unlike Unicode's context-sensitive FULL
// casing rules.
fn greekLower(v: int): int {
  if (v == 0x386) {
    return 0x3AC
  }
  if (inRange(v, 0x388, 0x38A)) {
    return v + 0x25
  }
  if (v == 0x38C) {
    return 0x3CC
  }
  if (inRange(v, 0x38E, 0x38F)) {
    return v + 0x3F
  }
  if (inRange(v, 0x391, 0x3A1)) {
    return v + 0x20
  }
  if (inRange(v, 0x3A3, 0x3AB)) {
    return v + 0x20
  }
  return v
}

fn greekUpper(v: int): int {
  if (v == 0x3AC) {
    return 0x386
  }
  if (inRange(v, 0x3AD, 0x3AF)) {
    return v - 0x25
  }
  if (v == 0x3C2) {
    return 0x3A3 // final sigma -> Σ
  }
  if (v == 0x3CC) {
    return 0x38C
  }
  if (inRange(v, 0x3CD, 0x3CE)) {
    return v - 0x3F
  }
  if (inRange(v, 0x3B1, 0x3C1)) {
    return v - 0x20
  }
  if (inRange(v, 0x3C3, 0x3CB)) {
    return v - 0x20
  }
  return v
}

// Cyrillic (U+0400-U+04FF): U+0400-U+040F (Serbian/Macedonian/Ukrainian
// letters) is +0x50; U+0410-U+042F (the 32-letter Russian alphabet) is
// +0x20; U+0460-U+0481 (historic iotified/yus/psi letters) is even=upper,
// odd=lower. Past U+0481 is not covered — see the file header.
fn cyrillicLower(v: int): int {
  if (inRange(v, 0x400, 0x40F)) {
    return v + 0x50
  }
  if (inRange(v, 0x410, 0x42F)) {
    return v + 0x20
  }
  if (inParityRange(v, 0x460, 0x481, 0)) {
    return v + 1
  }
  return v
}

fn cyrillicUpper(v: int): int {
  if (inRange(v, 0x450, 0x45F)) {
    return v - 0x50
  }
  if (inRange(v, 0x430, 0x44F)) {
    return v - 0x20
  }
  if (inParityRange(v, 0x460, 0x481, 1)) {
    return v - 1
  }
  return v
}
