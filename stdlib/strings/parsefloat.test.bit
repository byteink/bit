// stdlib/strings/parsefloat.test.bit — #7825. `parseFloat` reads the special
// spellings Go's `strconv.ParseFloat` reads, ASCII-case-insensitively, as IEEE
// 754 values, and rejects every near miss with the one "invalid syntax" error.

fn mustParse(s: string): f64 {
  return parseFloat(s) catch e {
    panic("parseFloat(\"${s}\") failed: ${e.message()}")
  }
}

fn isPosInf(v: f64): bool {
  return v > 1.0e308 && v == v + 1.0e308
}

fn isNegInf(v: f64): bool {
  return v < -1.0e308 && v == v - 1.0e308
}

fn rejected(s: string): bool {
  parseFloat(s) catch e {
    return e.message() == "parseFloat: invalid syntax"
  }
  return false
}

test "positive infinity spellings" {
  for s of [
    "inf",
    "+inf",
    "Inf",
    "INF",
    "iNf",
    "infinity",
    "+infinity",
    "Infinity",
    "INFINITY",
    "+InFiNiTy",
  ] {
    assert(isPosInf(mustParse(s)), "parseFloat(\"${s}\") is +Inf")
  }
}

test "negative infinity spellings" {
  for s of ["-inf", "-Inf", "-INF", "-infinity", "-Infinity", "-INFINITY"] {
    assert(isNegInf(mustParse(s)), "parseFloat(\"${s}\") is -Inf")
  }
}

test "nan spellings" {
  for s of ["nan", "NaN", "NAN", "nAn"] {
    let v = mustParse(s)
    assert(v != v, "parseFloat(\"${s}\") is NaN")
  }
}

test "near misses still fail with the same error" {
  for s of [
    "infx",
    "xinf",
    "na",
    "in",
    "infin",
    "infinit",
    "infinityy",
    "nanx",
    "+nan",
    "-nan",
    "+",
    "-",
    "--inf",
    "+-inf",
    "inf ",
    " inf",
    "i",
    "n",
    "",
  ] {
    assert(rejected(s), "parseFloat(\"${s}\") is rejected")
  }
}

test "ordinary numbers are untouched" {
  assert(mustParse("1.5") == 1.5, "1.5")
  assert(mustParse("-2e3") == -2000.0, "-2e3")
  assert(isPosInf(mustParse("1e400")), "1e400 overflows to +Inf")
}
