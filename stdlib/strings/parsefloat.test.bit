// stdlib/strings/parsefloat.test.bit — #7825. `parseFloat` reads the special
// spellings Go's `strconv.ParseFloat` reads, ASCII-case-insensitively, as IEEE
// 754 values, and rejects every near miss with the one "invalid syntax" error.
// The predeclared builtin reads the same infinities (#7828), so the last test
// runs both over every spelling.

import { rawParseFloat } from "std/strings/internal"

fn mustParse(s: string): f64 {
  return parseFloat(s) catch e {
    panic("parseFloat(\"${s}\") failed: ${e.message()}")
  }
}

fn isPosInf(v: f64): bool {
  return v > 1.0e308 && v == v + 1.0e308
}

fn isNegInf(v: f64): bool {
  return v < -1.0e308 && v == v - 1.0e308
}

fn rejected(s: string): bool {
  parseFloat(s) catch e {
    return e.message() == "parseFloat: invalid syntax"
  }
  return false
}

test "positive infinity spellings" {
  for s of [
    "inf",
    "+inf",
    "Inf",
    "INF",
    "iNf",
    "infinity",
    "+infinity",
    "Infinity",
    "INFINITY",
    "+InFiNiTy",
  ] {
    assert(isPosInf(mustParse(s)), "parseFloat(\"${s}\") is +Inf")
  }
}

test "negative infinity spellings" {
  for s of ["-inf", "-Inf", "-INF", "-infinity", "-Infinity", "-INFINITY"] {
    assert(isNegInf(mustParse(s)), "parseFloat(\"${s}\") is -Inf")
  }
}

test "nan spellings" {
  for s of ["nan", "NaN", "NAN", "nAn"] {
    let v = mustParse(s)
    assert(v != v, "parseFloat(\"${s}\") is NaN")
  }
}

test "near misses still fail with the same error" {
  for s of [
    "infx",
    "xinf",
    "na",
    "in",
    "infin",
    "infinit",
    "infinityy",
    "nanx",
    "+nan",
    "-nan",
    "+",
    "-",
    "--inf",
    "+-inf",
    "inf ",
    " inf",
    "i",
    "n",
    "",
  ] {
    assert(rejected(s), "parseFloat(\"${s}\") is rejected")
  }
}

test "ordinary numbers are untouched" {
  assert(mustParse("1.5") == 1.5, "1.5")
  assert(mustParse("-2e3") == -2000.0, "-2e3")
  assert(isPosInf(mustParse("1e400")), "1e400 overflows to +Inf")
}

// One name, one behaviour (#7828): the builtin and `strings.parseFloat` give
// the same bits for every spelling the latter accepts, and the builtin answers
// NaN wherever the latter fails. `nan` is the one word the builtin cannot tell
// from a failure, so it is the only accepted spelling whose builtin answer is
// NaN too.
test "builtin parseFloat agrees with strings.parseFloat on every spelling" {
  let accepted = [
    "inf",
    "+inf",
    "-inf",
    "Inf",
    "-INF",
    "infinity",
    "+infinity",
    "-infinity",
    "INFINITY",
    "-InFiNiTy",
    "nan",
    "NaN",
    "NAN",
    "1.5",
    "-2e3",
    "0",
    "4_2",
    "0x1.8p1",
    "1e400",
    "-1e400",
  ]
  for s of accepted {
    let want = mustParse(s)
    let got = rawParseFloat(s)
    assert(
      floatBits(got) == floatBits(want),
      "builtin parseFloat(\"${s}\") has the bits strings gives",
    )
  }
  for s of ["inf", "-inf", "infinity", "-Infinity", "+INF"] {
    let got = rawParseFloat(s)
    assert(got == got, "builtin parseFloat(\"${s}\") is not NaN")
  }
  for s of [
    "infx",
    "xinf",
    "na",
    "in",
    "infin",
    "infinityy",
    "nanx",
    "+nan",
    "-nan",
    "+",
    "-",
    "--inf",
    "+-inf",
    "inf ",
    " inf",
    "",
    "1.2.3",
    "0x1.8",
    "1_",
  ] {
    let got = rawParseFloat(s)
    assert(rejected(s), "parseFloat(\"${s}\") is rejected")
    assert(got != got, "builtin parseFloat(\"${s}\") is NaN")
  }
}
