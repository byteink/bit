// Escape hatch for `std/strings.parseFloat` to reach the predeclared
// `parseFloat` builtin (SPEC §5.3).
//
// `strings.bit` declares its own `export fn parseFloat`, which shadows the
// builtin for every file in the `std/strings` module (E0048) — module scope
// is shared across sibling files, so once one file in a module declares a
// name, no file in that module can reach the builtin of the same name
// anymore, not even the declaring function itself (self-reference resolves
// to the new declaration, not the builtin it shadows). This sibling module
// declares nothing named `parseFloat`, so the call below still resolves to
// the builtin.
//
// Not part of the public `std/strings` surface — `std/strings.parseFloat` is
// the supported entry point, and it is the only intended caller of this.
export fn rawParseFloat(s: string): f64 {
  return parseFloat(s)
}
