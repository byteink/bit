// Bit standard library — strings module, Unicode normalization (#6878).
//
// `normalize(s, f)` returns `s` in Normalization Form C, D, KC or KD of UAX
// #15 (https://www.unicode.org/reports/tr15/), on the tables in
// gen_normalize.bit (UCD 17.0.0, #6877). It is checked against every line of
// the UCD's NormalizationTest.txt by normalize.test.bit.
//
// The algorithm is UAX #15's, run as ONE pass over the input with a small
// working segment instead of a whole-string buffer:
//
//   1. decode a code point (an ill-formed byte becomes U+FFFD, the rule
//      `decodeRune` states) and decompose it fully: Hangul syllables by
//      arithmetic (§3.12), then the canonical mapping, or for the K forms the
//      compatibility mapping first and the canonical one second, recursively;
//   2. every decomposed code point is pushed onto the segment: a starter
//      (canonical combining class 0) closes the segment before it, a
//      non-starter joins it;
//   3. closing a segment sorts its non-starters stably by class (canonical
//      ordering), then for the C forms folds them into the segment's starter
//      with the blocked-by rule (UAX #15 §1.3: a mark joins the starter only
//      when the class of the last mark left behind is below its own), then
//      writes the segment's bytes to the one output buffer.
//
// A starter that follows a lone starter may compose with it too (Hangul L+V,
// LV+T, and the Indic two-part vowels), so that case is tried before the
// segment is closed.
//
// Most text is already in the form asked for, so `normalize` first runs the
// UAX #15 §9 quick check (#7150): one pass over the bytes, one table lookup
// per non-ASCII code point. A string that passes is returned as is; otherwise
// only the code points from the last starter before a failing one up to the
// next starter that passes go through the steps above, and the stretches in
// between are copied. The tables hold full decompositions, so step 1 never
// recurses.
//
// Code points travel as plain `int`s and bytes are written by hand: std/strings
// is built by the pinned stage0, which has no `string(rune)`/`[]rune(s)` this
// module may lean on.

// The four Unicode normalization forms (UAX #15 §1.2).
export enum Form { Nfc, Nfd, Nfkc, Nfkd }

// Hangul syllable composition constants, UAX #15 §3.12 / Unicode §3.12.
const normSBase: int = 0xAC00
const normLBase: int = 0x1100
const normVBase: int = 0x1161
const normTBase: int = 0x11A7
const normLCount: int = 19
const normVCount: int = 21
const normTCount: int = 28
const normNCount: int = 588
const normSCount: int = 11172

// A segment entry packs a code point (21 bits) with its combining class
// above it, so the class is looked up once per code point, not per compare.
const normClassShift: int = 21
const normCpMask: int = 0x1FFFFF
const normEntryMask: int = 0x1FFFFFFF

// Above this many non-starters an out-of-order run is sorted by counting, not
// by insertion: insertion sort is quadratic and a hostile input can make a
// run as long as the string.
const normInsertionMax: int = 16

// Up to this many bytes, `normCopy` copies a passing stretch by hand rather
// than append a boxed substring.
const normCopyMin: int = 32

// The quick-check flags of each form, indexed by `Form` (gen_normalize.bit's
// record byte 1: the `No` bits of D, KD, C, KC, then C's and KC's `Maybe`),
// and the flag of a code point that is the second half of a primary
// composite.
const normQcBits: string = "\x0C\x01\x30\x02"
const normSecond: int = 64

// The code point at byte `i` of `s` (`i < len(s)`) packed with its length in
// bytes, `used << 24 | cp`, so the hot loops pay no tuple. An ill-formed
// sequence is `1 << 24 | 0xFFFD`, which a real U+FFFD (three bytes) never is.
// Well-formed two- and three-byte sequences are decoded here without a call;
// `normDecodeAny` checks everything else. In the three-byte check, bit `k` of
// `0xF7FFFFFE` says whether code points `k << 11` up are allowed: 0 is
// overlong, 0x1B is the surrogates.
fn normDecode(s: string, i: int): int {
  let b0 = int(s[i])
  if (b0 < 0x80) {
    return (1 << 24) | b0
  }
  let n = len(s)
  if (b0 < 0xE0) {
    if (b0 >= 0xC2 && i + 1 < n && (int(s[i + 1]) & 0xC0) == 0x80) {
      return (2 << 24) | ((b0 & 0x1F) << 6) | (int(s[i + 1]) & 0x3F)
    }
    return normDecodeAny(s, i, b0)
  }
  if (b0 < 0xF0 && i + 2 < n) {
    let b1 = int(s[i + 1])
    let b2 = int(s[i + 2])
    let cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
    if (((b1 & 0xC0) | ((b2 & 0xC0) << 8)) == 0x8080 && ((0xF7FFFFFE >> (cp >> 11)) & 1) != 0) {
      return (3 << 24) | cp
    }
  }
  return normDecodeAny(s, i, b0)
}

// `normDecode` for any sequence whose lead byte `b0` (not ASCII) is at `i`.
fn normDecodeAny(s: string, i: int, b0: int): int {
  let want = leadWant(b0)
  if (want == 0 || i + want > len(s)) {
    return (1 << 24) | 0xFFFD
  }
  let cp = decodeContinuationBytes(s, i, want, leadCpBits(b0, want))
  if (cp < 0 || !isValidScalar(cp, leadMinCp(want))) {
    return (1 << 24) | 0xFFFD
  }
  return (want << 24) | cp
}

// `normRec(cp)` for a decoded code point, its two `normU16` calls written
// out: the hot loops pay one call per code point for the record, not three.
fn normRecOf(cp: int): int {
  if (cp >= normTrieLimit) {
    return 0
  }
  let k = (cp >> normTrieShift) * 2
  let blk = (int(normStage1[k]) << 8) | int(normStage1[k + 1])
  let j = ((blk << normTrieShift) | (cp & normTrieMask)) * 2
  return ((int(normStage2[j]) << 8) | int(normStage2[j + 1])) * 8
}

// Whether the packed `normDecode` result `d` is a well-formed code point.
fn normWellFormed(d: int): bool {
  return d != ((1 << 24) | 0xFFFD)
}

// Whether the code point `d` (packed by `normDecode`), whose record is at
// `rec`, ends a quick-check run: ill-formed, not `Yes` in the form, or a
// non-starter out of class order after one of class `lastCc`.
fn normQcStops(d: int, rec: int, qc: int, lastCc: int): bool {
  let cc = int(normInfo[rec])
  if (!normWellFormed(d) || (int(normInfo[rec + 1]) & qc) != 0) {
    return true
  }
  return cc != 0 && lastCc > cc
}

// The end of the stretch of `s` from `pos` (a boundary) that is already in
// the form whose quick-check flags are `qc`, backed up to the last starter
// before the first code point that is not: the UAX #15 §9 quick check.
// Returns `len(s)` when the rest is in the form. A `Maybe` counts as `No`;
// the slow path settles it.
fn normQuickSpan(s: string, pos: int, qc: int): int {
  let last = pos
  let lastCc = 0
  let i = pos
  let n = len(s)
  while (i < n) {
    if (s[i] < 0x80) {
      i = i + 1
      // Bounded by `n`.
      while (i < n && s[i] < 0x80) {
        i = i + 1
      }
      last = i - 1
      lastCc = 0
      continue
    }
    let d = normDecode(s, i)
    let rec = normRecOf(d & normCpMask)
    if (normQcStops(d, rec, qc, lastCc)) {
      return last
    }
    lastCc = int(normInfo[rec])
    if (lastCc == 0) {
      last = i
    }
    i = i + (d >> 24)
  }
  return n
}

// Appends `s[lo:hi]` to `out`. Slicing `s` boxes the substring, one
// allocation, so a short stretch is copied a byte at a time instead.
fn normCopy(out: []byte, s: string, lo: int, hi: int): []byte {
  if (hi - lo > normCopyMin) {
    out = append(out, s[lo:hi])
    return out
  }
  let i = lo
  while (i < hi) {
    out = append(out, s[i])
    i = i + 1
  }
  return out
}

// Appends `cp` to `out` as UTF-8.
fn normPutUtf8(out: []byte, cp: int): []byte {
  if (cp < 0x80) {
    out = append(out, u8(cp))
    return out
  }
  if (cp < 0x800) {
    out = append(out, u8(0xC0 | (cp >> 6)))
  } else if (cp < 0x10000) {
    out = append(out, u8(0xE0 | (cp >> 12)))
    out = append(out, u8(0x80 | ((cp >> 6) & 0x3F)))
  } else {
    out = append(out, u8(0xF0 | (cp >> 18)))
    out = append(out, u8(0x80 | ((cp >> 12) & 0x3F)))
    out = append(out, u8(0x80 | ((cp >> 6) & 0x3F)))
  }
  out = append(out, u8(0x80 | (cp & 0x3F)))
  return out
}

// The primary composite of `a` followed by `b`, or 0: Hangul by arithmetic
// (L+V gives LV, LV+T gives LVT), everything else from the compose table.
fn normPair(a: int, b: int): int {
  if (a >= normLBase &&
    a < normLBase + normLCount &&
    b >= normVBase &&
    b < normVBase + normVCount) {
    return normSBase + ((a - normLBase) * normVCount + (b - normVBase)) * normTCount
  }
  if (a >= normSBase &&
    a < normSBase + normSCount &&
    (a - normSBase) % normTCount == 0 &&
    b > normTBase &&
    b < normTBase + normTCount) {
    return a + b - normTBase
  }
  return int(compose(rune(a), rune(b)))
}

// Whether the packed entries `seg[lo:hi]` are already in class order.
fn normSorted(seg: []int, lo: int, hi: int): bool {
  let i = lo + 1
  while (i < hi) {
    if ((seg[i - 1] >> normClassShift) > (seg[i] >> normClassShift)) {
      return false
    }
    i = i + 1
  }
  return true
}

// Stable insertion sort of `seg[lo:hi]` by class.
fn normInsertion(seg: []int, lo: int, hi: int) {
  let i = lo + 1
  while (i < hi) {
    let v = seg[i]
    let k = i - 1
    while (k >= lo && (seg[k] >> normClassShift) > (v >> normClassShift)) {
      seg[k + 1] = seg[k]
      k = k - 1
    }
    seg[k + 1] = v
    i = i + 1
  }
}

// Stable counting sort of `seg[lo:hi]` by class: O(n + 256), whatever the
// run.
fn normCounting(seg: []int, lo: int, hi: int) {
  let m = hi - lo
  let start = []int(257)
  let i = lo
  while (i < hi) {
    let bin = (seg[i] >> normClassShift) + 1
    start[bin] = start[bin] + 1
    i = i + 1
  }
  let b = 1
  while (b < 257) {
    start[b] = start[b] + start[b - 1]
    b = b + 1
  }
  let tmp = []int(m)
  i = lo
  while (i < hi) {
    let cls = seg[i] >> normClassShift
    tmp[start[cls]] = seg[i]
    start[cls] = start[cls] + 1
    i = i + 1
  }
  i = 0
  while (i < m) {
    seg[lo + i] = tmp[i]
    i = i + 1
  }
}

// Puts the non-starters `seg[lo:hi]` into canonical order (stable by class).
fn normOrder(seg: []int, lo: int, hi: int) {
  if (hi - lo < 2 || normSorted(seg, lo, hi)) {
    return
  }
  if (hi - lo <= normInsertionMax) {
    normInsertion(seg, lo, hi)
    return
  }
  normCounting(seg, lo, hi)
}

// Folds the ordered non-starters of `seg[0:n]` into `seg[0]`, the starter,
// with the blocked-by rule: a mark composes only when the class of the last
// mark left behind is lower than its own (so an equal class, or any starter
// between, blocks it). Returns how many entries are left, the folded marks
// removed. Works in place: a reslice would allocate a slice per segment.
fn normFold(seg: []int, n: int): int {
  let starter = seg[0]
  let kept = 1
  let last = 0
  let r = 1
  while (r < n) {
    let m = seg[r]
    let cls = m >> normClassShift
    let c = 0
    if (last < cls) {
      c = int(compose(rune(starter), rune(m & normCpMask)))
    }
    if (c != 0) {
      starter = c
    } else {
      seg[kept] = m
      kept = kept + 1
      last = cls
    }
    r = r + 1
  }
  seg[0] = starter
  return kept
}

// The working state of one `normalize` call's slow path: the open segment
// (a starter and the non-starters after it, or just non-starters) in
// `seg[0:segN]`, the one output buffer, the form's two switches and its
// quick-check flags. The segment keeps an explicit length so that emptying
// or folding it never reslices: each reslice allocates.
class NormState {
  seg: []int
  segN: int
  out: []byte
  compat: bool
  fold: bool
  qc: int

  // Appends `v` to the open segment, doubling its buffer when full: only a
  // run of non-starters longer than 16 grows it.
  add(v: int) {
    if (this.segN == len(this.seg)) {
      let grown = []int(2 * len(this.seg))
      let i = 0
      while (i < this.segN) {
        grown[i] = this.seg[i]
        i = i + 1
      }
      this.seg = grown
    }
    this.seg[this.segN] = v
    this.segN = this.segN + 1
  }

  // Orders the open segment and, for the C forms, folds its marks into its
  // starter.
  settle() {
    let n = this.segN
    let lo = 0
    if (n > 0 && (this.seg[0] >> normClassShift) == 0) {
      lo = 1
    }
    normOrder(this.seg, lo, n)
    if (this.fold && lo == 1 && n > 1) {
      this.segN = normFold(this.seg, n)
    }
  }

  // Writes the open segment to the output and empties it, keeping its buffer.
  flush() {
    let i = 0
    while (i < this.segN) {
      this.out = normPutUtf8(this.out, this.seg[i] & normCpMask)
      i = i + 1
    }
    this.segN = 0
  }

  // Adds `e`, a code point packed as `normElem` packs it (class above bit
  // 21, bit 30 when it can be the second half of a composite), to the stream.
  push(e: int) {
    let v = e & normEntryMask
    if ((v >> normClassShift) != 0) {
      this.add(v)
      return
    }
    this.settle()
    if ((e >> 30) != 0 && this.fold && this.segN == 1 && (this.seg[0] >> normClassShift) == 0) {
      let c = normPair(this.seg[0], v)
      if (c != 0) {
        this.seg[0] = c
        return
      }
    }
    this.flush()
    this.add(v)
  }

  // Pushes the three-or-two jamo a Hangul syllable decomposes to; the vowel
  // and the trailing consonant are second halves of the arithmetic pairs.
  hangul(cp: int) {
    let s = cp - normSBase
    this.push(normLBase + s / normNCount)
    this.push((1 << 30) | (normVBase + s % normNCount / normTCount))
    let t = s % normTCount
    if (t != 0) {
      this.push((1 << 30) | (normTBase + t))
    }
  }

  // Pushes the full decomposition of `cp`, whose record is at `rec` (`cp`
  // itself when it has none). The tables hold FULL decompositions, so this
  // never recurses.
  decompose(cp: int, rec: int) {
    if (cp >= normSBase && cp < normSBase + normSCount) {
      this.hangul(cp)
      return
    }
    let e = 0
    if (this.compat) {
      e = normU16(normInfo, rec + 4)
    }
    if (e == 0) {
      e = normU16(normInfo, rec + 2)
    }
    if (e == 0) {
      let second = (int(normInfo[rec + 1]) & normSecond) << 24
      this.push((int(normInfo[rec]) << normClassShift) | cp | second)
      return
    }
    let i = 1
    // Bounded by the sequence length, at most 18 in UCD 17.0.0.
    while (i <= normSeqLen(e)) {
      this.push(normElem(e + i))
      i = i + 1
    }
  }

  // Normalizes `s` from `from` up to the next well-formed starter that is
  // `Yes` in the form (past `from`), or the end, and returns where it
  // stopped: nothing before such a starter can reorder or compose with
  // anything after it.
  run(s: string, from: int): int {
    let i = from
    let n = len(s)
    while (i < n) {
      let d = normDecode(s, i)
      let cp = d & normCpMask
      let rec = normRecOf(cp)
      if (i > from && !normQcStops(d, rec, this.qc, 0) && normInfo[rec] == 0) {
        break
      }
      this.decompose(cp, rec)
      i = i + (d >> 24)
    }
    this.settle()
    this.flush()
    return i
  }
}

// The slow-path state for form number `k`, its output pre-sized to `size`.
fn normState(k: int, size: int): NormState {
  return NormState{
    seg = []int(16),
    segN = 0,
    out = []byte(0, size),
    compat = k >= 2,
    fold = k % 2 == 0,
    qc = int(normQcBits[k]),
  }
}

// `s` in normalization form `f`. Ill-formed UTF-8 is not preserved: each
// rejected byte becomes U+FFFD, as in `runes`. Text already in the form (the
// UAX #15 quick check says so in one pass) is returned as is, without
// allocating; otherwise the stretches the quick check passes are copied and
// only the rest is decomposed and recomposed.
export fn normalize(s: string, f: Form): string {
  let k = int(f)
  let qc = int(normQcBits[k])
  let n = len(s)
  let span = normQuickSpan(s, 0, qc)
  if (span == n) {
    return s
  }
  let st = normState(k, n + n / 2 + 16)
  let pos = 0
  // Bounded: `run` always moves past `span`, so `pos` strictly grows.
  while (pos < n) {
    st.out = normCopy(st.out, s, pos, span)
    if (span == n) {
      break
    }
    pos = st.run(s, span)
    span = normQuickSpan(s, pos, qc)
  }
  return string(st.out)
}

// Whether `s` is already in normalization form `f`: well-formed UTF-8 that
// `normalize` leaves unchanged. The quick check answers most strings in one
// pass; a `Maybe` is settled by normalizing and comparing.
export fn isNormalized(s: string, f: Form): bool {
  if (normQuickSpan(s, 0, int(normQcBits[int(f)])) == len(s)) {
    return true
  }
  return normalize(s, f) == s
}
