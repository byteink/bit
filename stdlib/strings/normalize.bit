// Bit standard library — strings module, Unicode normalization (#6878).
//
// `normalize(s, f)` returns `s` in Normalization Form C, D, KC or KD of UAX
// #15 (https://www.unicode.org/reports/tr15/), on the tables in
// gen_normalize.bit (UCD 17.0.0, #6877). It is checked against every line of
// the UCD's NormalizationTest.txt by normalize.test.bit.
//
// The algorithm is UAX #15's, run as ONE pass over the input with a small
// working segment instead of a whole-string buffer:
//
//   1. decode a code point (an ill-formed byte becomes U+FFFD, the rule
//      `decodeRune` states) and decompose it fully: Hangul syllables by
//      arithmetic (§3.12), then the canonical mapping, or for the K forms the
//      compatibility mapping first and the canonical one second, recursively;
//   2. every decomposed code point is pushed onto the segment: a starter
//      (canonical combining class 0) closes the segment before it, a
//      non-starter joins it;
//   3. closing a segment sorts its non-starters stably by class (canonical
//      ordering), then for the C forms folds them into the segment's starter
//      with the blocked-by rule (UAX #15 §1.3: a mark joins the starter only
//      when the class of the last mark left behind is below its own), then
//      writes the segment's bytes to the one output buffer.
//
// A starter that follows a lone starter may compose with it too (Hangul L+V,
// LV+T, and the Indic two-part vowels), so that case is tried before the
// segment is closed.
//
// A code point in `normPlain`'s ranges has no class, no mapping and is never
// the second half of a pair, so it skips every table lookup. The test file
// sweeps those ranges against the tables.
//
// Code points travel as plain `int`s and bytes are written by hand through
// `writeRuneUtf8` (utf8.bit): std/strings is built by the pinned stage0, which
// has no `string(rune)`/`[]rune(s)` this module may lean on.

// The four Unicode normalization forms (UAX #15 §1.2).
export enum Form { Nfc, Nfd, Nfkc, Nfkd }

// Hangul syllable composition constants, UAX #15 §3.12 / Unicode §3.12.
const normSBase: int = 0xAC00
const normLBase: int = 0x1100
const normVBase: int = 0x1161
const normTBase: int = 0x11A7
const normLCount: int = 19
const normVCount: int = 21
const normTCount: int = 28
const normNCount: int = 588
const normSCount: int = 11172

// A segment entry packs a code point (21 bits) with its combining class
// above it, so the class is looked up once per code point, not per compare.
const normClassShift: int = 21
const normCpMask: int = 0x1FFFFF

// Above this many non-starters an out-of-order run is sorted by counting, not
// by insertion: insertion sort is quadratic and a hostile input can make a
// run as long as the string.
const normInsertionMax: int = 16

// Whether `cp` is untouched by normalization AND cannot be the second half of
// a composition: class 0, no canonical or compatibility mapping, not a
// Hangul syllable or jamo. These are the stretches of the code space that are
// far larger than every table, found by sweeping the tables; the test file
// re-checks each range against them.
fn normPlain(cp: int): bool {
  if (cp < 0xA0) {
    return true
  }
  if (cp >= 0x3400 && cp <= 0xA66E) {
    return true
  }
  if (cp >= 0xD7A4 && cp <= 0xF8FF) {
    return true
  }
  if (cp >= 0x1FBFA && cp <= 0x2F7FF) {
    return true
  }
  return cp >= 0x2FA1E && cp <= 0x10FFFF
}

// The canonical combining class of `cp`. Nothing below U+0300 has one, so
// the Latin-1 and Latin Extended letters skip the table search.
fn normClass(cp: int): int {
  if (cp < 0x300) {
    return 0
  }
  return ccc(rune(cp))
}

// Whether every byte of `s` is below 0x80.
fn normIsAscii(s: string): bool {
  let i = 0
  let n = len(s)
  while (i < n) {
    if (s[i] >= 0x80) {
      return false
    }
    i = i + 1
  }
  return true
}

// The primary composite of `a` followed by `b`, or 0: Hangul by arithmetic
// (L+V gives LV, LV+T gives LVT), everything else from the compose table.
fn normPair(a: int, b: int): int {
  if (a >= normLBase &&
    a < normLBase + normLCount &&
    b >= normVBase &&
    b < normVBase + normVCount) {
    return normSBase + ((a - normLBase) * normVCount + (b - normVBase)) * normTCount
  }
  if (a >= normSBase &&
    a < normSBase + normSCount &&
    (a - normSBase) % normTCount == 0 &&
    b > normTBase &&
    b < normTBase + normTCount) {
    return a + b - normTBase
  }
  return int(compose(rune(a), rune(b)))
}

// Whether the packed entries `seg[lo:]` are already in class order.
fn normSorted(seg: []int, lo: int): bool {
  let i = lo + 1
  while (i < len(seg)) {
    if ((seg[i - 1] >> normClassShift) > (seg[i] >> normClassShift)) {
      return false
    }
    i = i + 1
  }
  return true
}

// Stable insertion sort of `seg[lo:]` by class.
fn normInsertion(seg: []int, lo: int) {
  let i = lo + 1
  while (i < len(seg)) {
    let v = seg[i]
    let k = i - 1
    while (k >= lo && (seg[k] >> normClassShift) > (v >> normClassShift)) {
      seg[k + 1] = seg[k]
      k = k - 1
    }
    seg[k + 1] = v
    i = i + 1
  }
}

// Stable counting sort of `seg[lo:]` by class: O(n + 256), whatever the run.
fn normCounting(seg: []int, lo: int) {
  let m = len(seg) - lo
  let start = []int(257)
  let i = lo
  while (i < len(seg)) {
    let bin = (seg[i] >> normClassShift) + 1
    start[bin] = start[bin] + 1
    i = i + 1
  }
  let b = 1
  while (b < 257) {
    start[b] = start[b] + start[b - 1]
    b = b + 1
  }
  let tmp = []int(m)
  i = lo
  while (i < len(seg)) {
    let cls = seg[i] >> normClassShift
    tmp[start[cls]] = seg[i]
    start[cls] = start[cls] + 1
    i = i + 1
  }
  i = 0
  while (i < m) {
    seg[lo + i] = tmp[i]
    i = i + 1
  }
}

// Puts the non-starters `seg[lo:]` into canonical order (stable by class).
fn normOrder(seg: []int, lo: int) {
  if (len(seg) - lo < 2 || normSorted(seg, lo)) {
    return
  }
  if (len(seg) - lo <= normInsertionMax) {
    normInsertion(seg, lo)
    return
  }
  normCounting(seg, lo)
}

// Folds the ordered non-starters of `seg` into `seg[0]`, the starter, with the
// blocked-by rule: a mark composes only when the class of the last mark left
// behind is lower than its own (so an equal class, or any starter between,
// blocks it). Returns the segment with the folded marks removed.
fn normFold(seg: []int): []int {
  let starter = seg[0]
  let kept = 1
  let last = 0
  let r = 1
  while (r < len(seg)) {
    let m = seg[r]
    let cls = m >> normClassShift
    let c = 0
    if (last < cls) {
      c = int(compose(rune(starter), rune(m & normCpMask)))
    }
    if (c != 0) {
      starter = c
    } else {
      seg[kept] = m
      kept = kept + 1
      last = cls
    }
    r = r + 1
  }
  seg[0] = starter
  return seg[0:kept]
}

// The working state of one `normalize` call: the open segment (a starter and
// the non-starters after it, or just non-starters at the start of the string),
// the one output buffer, and the form's two switches.
class NormState {
  seg: []int
  out: Builder
  compat: bool
  fold: bool

  // Orders the open segment and, for the C forms, folds its marks into its
  // starter.
  settle() {
    let lo = 0
    if (len(this.seg) > 0 && (this.seg[0] >> normClassShift) == 0) {
      lo = 1
    }
    normOrder(this.seg, lo)
    if (this.fold && lo == 1 && len(this.seg) > 1) {
      this.seg = normFold(this.seg)
    }
  }

  // Writes the open segment to the output and empties it, keeping its buffer.
  flush() {
    let i = 0
    while (i < len(this.seg)) {
      writeRuneUtf8(this.out, this.seg[i] & normCpMask)
      i = i + 1
    }
    this.seg = this.seg[0:0]
  }

  // Adds `cp`, of combining class `cc`, to the stream. `maybePair` is false
  // for a `normPlain` code point, which can never compose with what precedes.
  push(cp: int, cc: int, maybePair: bool) {
    if (cc != 0) {
      this.seg = append(this.seg, (cc << normClassShift) | cp)
      return
    }
    this.settle()
    if (maybePair && this.fold && len(this.seg) == 1 && (this.seg[0] >> normClassShift) == 0) {
      let c = normPair(this.seg[0], cp)
      if (c != 0) {
        this.seg[0] = c
        return
      }
    }
    this.flush()
    this.seg = append(this.seg, cp)
  }

  // Pushes the three-or-two jamo a Hangul syllable decomposes to.
  hangul(cp: int) {
    let s = cp - normSBase
    this.push(normLBase + s / normNCount, 0, true)
    this.push(normVBase + s % normNCount / normTCount, 0, true)
    let t = s % normTCount
    if (t != 0) {
      this.push(normTBase + t, 0, true)
    }
  }

  // Pushes the full decomposition of `cp` (`cp` itself when it has none).
  decompose(cp: int) {
    if (normPlain(cp)) {
      this.push(cp, 0, false)
      return
    }
    if (cp >= normSBase && cp < normSBase + normSCount) {
      this.hangul(cp)
      return
    }
    let d = []rune(0)
    if (this.compat) {
      d = compatDecomp(rune(cp))
    }
    if (len(d) == 0) {
      d = canonicalDecomp(rune(cp))
    }
    if (len(d) == 0) {
      this.push(cp, normClass(cp), true)
      return
    }
    // Bounded: the mapping tables hold at most 18 runes per entry and every
    // chain of mappings in them ends.
    let i = 0
    while (i < len(d)) {
      this.decompose(int(d[i]))
      i = i + 1
    }
  }
}

// `s` in normalization form `f`. Ill-formed UTF-8 is not preserved: each
// rejected byte becomes U+FFFD, as in `runes`. A string with no byte at or
// above 0x80 is already in every form and is returned as is, without
// allocating.
export fn normalize(s: string, f: Form): string {
  if (normIsAscii(s)) {
    return s
  }
  let k = int(f)
  let st = NormState{ seg = []int(0, 16), out = Builder(), compat = k >= 2, fold = k % 2 == 0 }
  let i = 0
  let n = len(s)
  while (i < n) {
    let (r, used) = decodeRune(s, i)
    let cp = int(r)
    st.decompose(cp)
    i = i + used
  }
  st.settle()
  st.flush()
  return st.out.toString()
}

// Whether `s` is already in normalization form `f`: well-formed UTF-8 that
// `normalize` leaves unchanged. The tables carry no quick-check properties, so
// a non-ASCII string is normalized and compared.
export fn isNormalized(s: string, f: Form): bool {
  if (normIsAscii(s)) {
    return true
  }
  return normalize(s, f) == s
}
