// Bit standard library — strings module, Builder.
//
// A growable string builder. v1 is concatenation-backed — each write allocates a
// fresh string — which is simple and correct; a byte-buffer backing that appends
// in place is a future optimization. Methods return an updated Builder (value
// semantics), so chain by reassigning: `b = b.write("a"); b = b.write("b")`.

export struct Builder { buf: string }

// A fresh, empty Builder.
export function newBuilder(): Builder {
  return Builder{ buf: "" }
}

// Appends `s`.
export function (b: Builder) write(s: string): Builder {
  return Builder{ buf: b.buf + s }
}

// Appends a single byte.
export function (b: Builder) writeByte(c: u8): Builder {
  let one = []byte(1)
  one[0] = c
  return Builder{ buf: b.buf + string(one) }
}

// The accumulated string.
export function (b: Builder) toString(): string {
  return b.buf
}

// The accumulated byte length.
export function (b: Builder) length(): i64 {
  return len(b.buf)
}
