// Bit standard library — strings module, Builder.
//
// A growable string builder, backed by a `[]byte` that grows with `append`'s
// amortised doubling (runtime/root/slices.bit), so accumulating n bytes across
// any number of writes is O(n) total, not O(n^2).
//
// `Builder` is a class, hence a reference type (§13.3): `write`/`writeByte`
// mutate the receiver's buffer in place, so `b.write("hello")` alone is a real
// append, not a no-op. Each also returns the same `b`, so fluent chaining still
// works: `b.write("a").write("b")`, or the old `b = b.write("a")` form (a
// reassignment to the same reference).
export class Builder {
  buf: []byte
  // Appends `s` to `b` in place and returns `b`.
  export write(s: string): Builder {
    let i = 0
    while (i < len(s)) {
      this.buf = append(this.buf, s[i])
      i = i + 1
    }
    return this
  }

  // Appends a single byte to `b` in place and returns `b`.
  export writeByte(c: u8): Builder {
    this.buf = append(this.buf, c)
    return this
  }

  // The accumulated string.
  export toString(): string {
    return string(this.buf)
  }

  // The accumulated byte length.
  export length(): i64 {
    return len(this.buf)
  }
}

// The backing capacity a fresh Builder starts with, in bytes.
//
// NOT A TUNING KNOB — it is what stops `append`'s DOUBLING-FROM-1 (#4055).
// `[]byte(0)` is the null header, which costs no object up front and then makes
// the FIRST `writeByte` allocate three (`rtSliceNew`'s header, its zero-byte
// buffer, and the cap-1 buffer that immediately replaces it), followed by one
// more per doubling. Measured over 150,000 builders of mean length 8.5, that was
// 8.33 heap objects to produce one ~8-character string.
//
// Sixteen bytes replaces the whole 0 -> 1 -> 2 -> 4 -> 8 chain — five objects
// holding fifteen bytes between them — with ONE object, so any string up to 16
// bytes now grows zero times. Above 16, `append`'s doubling is unchanged and
// keeps accumulation O(n) total; this only moves where the doubling starts.
const initialCap: int = 16

// A fresh, empty Builder.
export fn newBuilder(): Builder {
  return Builder{ buf: []byte(0, initialCap) }
}

