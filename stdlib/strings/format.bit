// Bit standard library — std/strings fixed-precision float formatting.
//
// `formatFloat` is the fixed-decimal counterpart to string interpolation's
// shortest-round-trip printing (`"${x}"`, SPEC §5.7): interpolation picks the
// fewest digits that read back to the same `f64`, so `${10.0}` is `"10"` and
// `${1234.5}` is `"1234.5"`. This instead renders to an EXACT number of
// digits after the point, the way a currency amount or a fixed-width table
// needs.
//
// The bug this file exists to avoid: scaling with binary floating-point
// arithmetic. `i64(150.15 * 100.0)` is `15014`, not `15015`, because
// `150.15` has no exact binary value — so a `formatFloat` built on
// `x * 10^decimals` prints `150.14` for `150.15`. This instead rounds the
// DECIMAL TEXT of `x`: `"${x}"` already carries `x`'s correctly-rounded
// shortest round-trip decimal, so re-rounding that text to fewer places only
// ever touches digits already known to be exact.

/// Renders `x` to exactly `decimals` digits after the decimal point.
///
/// `decimals` is clamped to `>= 0` (a negative value is treated as `0`), and
/// `decimals == 0` omits the point entirely: `formatFloat(2.5, 0)` is `"3"`.
///
/// Rounding is half AWAY FROM ZERO, with carry propagating through every
/// digit — including into a new leading digit: `formatFloat(9.999, 2)` is
/// `"10.00"`. This is deliberately not banker's rounding: a `5` in the first
/// dropped place always rounds the kept digit up, regardless of parity.
///
/// The sign comes from `x`, never from the rounded digits: a negative `x`
/// that rounds to all-zero digits still prints a leading `-`, so
/// `formatFloat(-0.004, 2)` is `"-0.00"`. There is no separate "negative
/// zero" case — `-0.0` follows the same rule and also prints `"-0.00"`,
/// because interpolation's `"${-0.0}"` is itself `"-0"`.
///
/// `NaN` is `"NaN"`; the infinities are `"+Inf"` and `"-Inf"`. The result
/// never uses exponent notation, for any finite `x`.
export fn formatFloat(x: f64, decimals: int): string {
  if (x != x) {
    return "NaN"
  }
  // The largest finite `f64`; anything past it in magnitude is one of the
  // two infinities. Compared against a finite constant rather than a
  // bit-pattern `isInf` check, which std/strings has no primitive for.
  let maxFinite = 1.7976931348623157e308
  if (x > maxFinite) {
    return "+Inf"
  }
  if (x < -maxFinite) {
    return "-Inf"
  }

  let d = decimals
  if (d < 0) {
    d = 0
  }

  let stripped = stripFloatSign("${x}")
  let text = stripped.text
  let neg = stripped.neg

  // `bit_rt_string_from_float` (runtime/root/floatfmt.bit's `render`) lays
  // every digit out positionally and has no exponent-emitting branch at all,
  // for any magnitude on any target — confirmed empirically to 1e300/1e-300.
  // Asserting the invariant here, rather than writing an exponent-expansion
  // path, is deliberate: no `f64` value can reach that branch on this
  // compiler, so code for it could never be exercised or proven correct.
  assert(indexOf(text, "e") < 0 && indexOf(text, "E") < 0, "formatFloat: unexpected exponent form")

  let dot = indexOf(text, ".")
  let intPart = text
  let fracPart = ""
  if (dot >= 0) {
    intPart = text[0:dot]
    fracPart = text[dot + 1:]
  }

  let digits = roundFracDigits(intPart, fracPart, d)
  let sign = ""
  if (neg) {
    sign = "-"
  }
  if (d == 0) {
    return sign + digits
  }
  let cut = len(digits) - d
  return sign + digits[0:cut] + "." + digits[cut:len(digits)]
}

// `text` with a leading `-` stripped, and whether one was present. Split out
// of `formatFloat` (#2448).
class SignStripped { neg: bool, text: string }

fn stripFloatSign(text: string): SignStripped {
  if (len(text) > 0 && text[0] == '-') {
    return SignStripped{ neg: true, text: text[1:] }
  }
  return SignStripped{ neg: false, text: text }
}

// Rounds the decimal digits `intPart + "." + fracPart` to `d` places after
// the point (`d >= 0`), half away from zero, and returns the combined digit
// string with NO point — the caller inserts one (or omits it for `d == 0`).
//
// `fracPart` shorter than `d` is padded with `'0'` (those places are exactly
// zero, not merely unknown, because `intPart`/`fracPart` come from the exact
// shortest round-trip text). `fracPart` longer than `d` is cut at `d`,
// deciding round-up from only the single digit immediately after the cut:
// sufficient because every digit is base 10, so a digit `'5'..'9'` there
// always means the discarded remainder is at least half a unit in the last
// kept place, and `'0'..'4'` always means it is less — regardless of any
// digits after that one.
fn roundFracDigits(intPart: string, fracPart: string, d: int): string {
  let frac = fracPart
  while (len(frac) < d) {
    frac = frac + "0"
  }
  let roundUp = false
  if (len(frac) > d && frac[d] >= '5') {
    roundUp = true
  }
  let digits = intPart + frac[0:d]
  if (roundUp) {
    return incrementDigits(digits)
  }
  return digits
}

// `digits` (a string of `'0'..'9'`) plus one, propagating carry from the
// right. A carry out of the leftmost digit prepends `'1'` — the only case
// where the result is longer than the input, e.g. `"999"` -> `"1000"`.
fn incrementDigits(digits: string): string {
  let b = []byte(digits)
  let i = len(b) - 1
  while (i >= 0) {
    if (b[i] == '9') {
      b[i] = '0'
      i = i - 1
    } else {
      b[i] = b[i] + 1
      return string(b)
    }
  }
  return "1" + string(b)
}

/// Inserts `sep` between groups of three digits in the integer part of `s`,
/// the way a formatter renders `1234567` as `1,234,567`. Meant to run on text
/// a number formatter already produced, e.g.
/// `groupDigits(formatFloat(x, 2), ",")`.
///
/// The integer part is everything before the first `.` (or the whole string
/// when there is none); text at and after the `.` is copied unchanged, and
/// grouping is counted from the right end of the integer part only:
/// `groupDigits("1234.50", ",")` is `"1,234.50"`.
///
/// A leading `-` or `+` sign is kept out of the grouping —
/// `groupDigits("-1234.50", ",")` is `"-1,234.50"`, never `"-,1234.50"` or
/// `"1,234.50-"`. An integer part of three digits or fewer after the sign is
/// returned unchanged (`"100.00"` stays `"100.00"`), and so are an empty `s`
/// and an empty `sep`: with nothing to insert, there is nothing to do.
///
/// A multi-byte `sep` is inserted whole at each group boundary, never split
/// across a boundary.
///
/// If any character of the integer part after the sign is not an ASCII digit
/// `0`-`9`, `s` is returned unchanged rather than grouping a best-effort guess
/// at digit boundaries: `groupDigits("abc", ",")` is `"abc"`. A caller that
/// passes text that isn't a plain signed integer-plus-fraction gets it back
/// untouched, not silently mangled.
export fn groupDigits(s: string, sep: string): string {
  if (len(s) == 0 || len(sep) == 0) {
    return s
  }

  let signLen = 0
  if (s[0] == '-' || s[0] == '+') {
    signLen = 1
  }

  let dot = indexOf(s, ".")
  let intEnd = len(s)
  if (dot >= 0) {
    intEnd = dot
  }

  if (!allAsciiDigits(s, signLen, intEnd)) {
    return s
  }

  let n = intEnd - signLen
  if (n <= 3) {
    return s
  }

  let tail = s[intEnd:len(s)]
  return writeGroupedDigits(s, sep, signLen, n, tail)
}

// Whether every byte of `s[start:end]` is an ASCII digit. Split out of
// `groupDigits` (#2448).
fn allAsciiDigits(s: string, start: int, end: int): bool {
  let i = start
  while (i < end) {
    if (s[i] < '0' || s[i] > '9') {
      return false
    }
    i = i + 1
  }
  return true
}

// Writes `s`'s sign (`s[0:signLen]`), its `n` integer digits grouped by
// `sep` every three places from the right, and its unchanged `tail`
// (fraction and beyond) into a fresh string. Split out of `groupDigits`
// (#2448).
fn writeGroupedDigits(s: string, sep: string, signLen: int, n: int, tail: string): string {
  // `(n - 1) / 3` counts the group separators without walking the string
  // twice.
  let seps = (n - 1) / 3
  let out = []byte(signLen + n + seps * len(sep) + len(tail))

  let pos = 0
  while (pos < signLen) {
    out[pos] = s[pos]
    pos = pos + 1
  }

  let j = 0
  while (j < n) {
    out[pos] = s[signLen + j]
    pos = pos + 1
    // One separator per group boundary to the right of the digit just
    // written.
    let remaining = n - 1 - j
    if (remaining > 0 && remaining % 3 == 0) {
      let k = 0
      while (k < len(sep)) {
        out[pos] = sep[k]
        pos = pos + 1
        k = k + 1
      }
    }
    j = j + 1
  }

  let t = 0
  while (t < len(tail)) {
    out[pos] = tail[t]
    pos = pos + 1
    t = t + 1
  }

  return string(out)
}
