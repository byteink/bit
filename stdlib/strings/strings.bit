// Bit standard library — strings module.
//
// Byte-oriented string routines written in Bit itself, over `len(s)`, `s[i]`
// (a `u8` byte), string slicing `s[lo:hi]`, `==`, and `+`. These operate on
// bytes, not Unicode code points — correct for ASCII and for byte-exact search;
// UTF-8-aware iteration is deferred (§21, #348). Substring search is naive
// (O(n*m)); a smarter matcher is a future optimization.

import { rawParseFloat } from "std/strings/internal"

// Whether `a` and `b` are byte-for-byte equal.
export fn equal(a: string, b: string): bool {
  return a == b
}

// Lexicographic byte comparison: -1 if `a < b`, 0 if equal, 1 if `a > b`.
export fn compare(a: string, b: string): i64 {
  let n = len(a)
  if (len(b) < n) {
    n = len(b)
  }
  let i = 0
  while (i < n) {
    if (a[i] < b[i]) {
      return -1
    }
    if (a[i] > b[i]) {
      return 1
    }
    i = i + 1
  }
  if (len(a) < len(b)) {
    return -1
  }
  if (len(a) > len(b)) {
    return 1
  }
  return 0
}

// Whether `a` and `b` are equal under Unicode SIMPLE case folding
// (`unicodefold.bit`'s `foldRune`) — ASCII plus Latin-1 Supplement, Latin
// Extended-A/B, Greek and Coptic, and Cyrillic. Decodes both sides rune by
// rune (`decodeRune`) rather than comparing bytes or requiring equal byte
// lengths up front: folding is a code-point mapping, and once it can span a
// script outside ASCII, byte-position comparison is simply wrong. Simple
// folding only, not full: `equalFold("straße", "STRASSE")` is `false` — `ß`
// has no fold partner in this table, and #2278 pinned that as the wanted
// result.
export fn equalFold(a: string, b: string): bool {
  let i = 0
  let j = 0
  let na = len(a)
  let nb = len(b)
  while (i < na && j < nb) {
    let (ra, ca) = decodeRune(a, i)
    let (rb, cb) = decodeRune(b, j)
    if (foldRune(ra) != foldRune(rb)) {
      return false
    }
    i = i + ca
    j = j + cb
  }
  return i == na && j == nb
}

// Whether `s` begins with `prefix`.
export fn hasPrefix(s: string, prefix: string): bool {
  if (len(prefix) > len(s)) {
    return false
  }
  return s[0:len(prefix)] == prefix
}

// Whether `s` ends with `suffix`.
export fn hasSuffix(s: string, suffix: string): bool {
  if (len(suffix) > len(s)) {
    return false
  }
  return s[len(s) - len(suffix):] == suffix
}

// The byte index of the first occurrence of `sub` in `s`, or -1 if absent. An
// empty `sub` matches at 0.
export fn indexOf(s: string, sub: string): i64 {
  return indexOfFrom(s, sub, 0)
}

// Whether `sub` occurs anywhere in `s`.
export fn contains(s: string, sub: string): bool {
  return indexOf(s, sub) >= 0
}

// The number of non-overlapping occurrences of `sub` in `s`.
export fn count(s: string, sub: string): i64 {
  if (len(sub) == 0) {
    return len(s) + 1
  }
  let subLen = len(sub)
  let n = 0
  let i = 0
  // Bounded: `i` advances by at least `subLen >= 1` past every hit, so this
  // runs at most `len(s)` times. Non-overlapping by construction.
  while (i + subLen <= len(s)) {
    let hit = indexOfFrom(s, sub, i)
    if (hit < 0) {
      return n
    }
    n = n + 1
    i = hit + subLen
  }
  return n
}

// `s` repeated `n` times (empty for `n <= 0`). The output length is known up
// front, so this fills one `[]byte` by index instead of concatenating in a
// loop (which would copy everything accumulated so far on every iteration).
export fn repeat(s: string, n: i64): string {
  if (n <= 0 || len(s) == 0) {
    return ""
  }
  let sl = len(s)
  let out = []byte(sl * n)
  let i = 0
  while (i < n) {
    let base = i * sl
    let j = 0
    while (j < sl) {
      out[base + j] = s[j]
      j = j + 1
    }
    i = i + 1
  }
  return string(out)
}

// The elements of `parts` concatenated with `sep` between each. The output
// length is known after one pass over `parts`, so this fills one `[]byte` by
// index instead of concatenating in a loop.
export fn join(parts: []string, sep: string): string {
  let n = len(parts)
  if (n == 0) {
    return ""
  }
  let total = 0
  let i = 0
  while (i < n) {
    total = total + len(parts[i])
    i = i + 1
  }
  total = total + len(sep) * (n - 1)
  let out = []byte(total)
  let pos = 0
  i = 0
  while (i < n) {
    if (i > 0) {
      let k = 0
      while (k < len(sep)) {
        out[pos] = sep[k]
        pos = pos + 1
        k = k + 1
      }
    }
    let part = parts[i]
    let pl = len(part)
    let k = 0
    while (k < pl) {
      out[pos] = part[k]
      pos = pos + 1
      k = k + 1
    }
    i = i + 1
  }
  return string(out)
}

// A copy of `s` with every code point that has a simple Unicode lowercase
// mapping (`unicodefold.bit`'s `toUpperRune`) folded to its uppercase form —
// ASCII plus Latin-1 Supplement, Latin Extended-A/B, Greek and Coptic, and
// Cyrillic. Decodes through `decodeRune` rather than a byte-at-a-time scan:
// a fold target's UTF-8 encoding is re-emitted (`writeRuneUtf8`) only when
// folding actually changed the rune, so an unfolded code point — including
// any malformed byte `decodeRune` rejected — is copied through unchanged.
export fn toUpper(s: string): string {
  let b = newBuilder()
  let i = 0
  let n = len(s)
  while (i < n) {
    let (r, consumed) = decodeRune(s, i)
    let folded = toUpperRune(r)
    if (folded == r) {
      b.write(s[i:i + consumed])
    } else {
      writeRuneUtf8(b, int(folded))
    }
    i = i + consumed
  }
  return b.toString()
}

// A copy of `s` with every code point that has a simple Unicode uppercase
// mapping (`unicodefold.bit`'s `toLowerRune`) folded to its lowercase form.
// Same coverage and same malformed-byte handling as `toUpper`.
export fn toLower(s: string): string {
  let b = newBuilder()
  let i = 0
  let n = len(s)
  while (i < n) {
    let (r, consumed) = decodeRune(s, i)
    let folded = toLowerRune(r)
    if (folded == r) {
      b.write(s[i:i + consumed])
    } else {
      writeRuneUtf8(b, int(folded))
    }
    i = i + consumed
  }
  return b.toString()
}

// The byte index of the first occurrence of `sub` in `s` at or after `at`, or
// -1 if absent — the offset form of `indexOf`, so a forward scan (`replace`,
// `splitN`, a hand-written scanner) never has to materialize `s[at:]` first.
// Scans by direct byte comparison — no slice is allocated for the search
// itself, only the eventual match (if any) is reported by index. An empty
// `sub` matches at `at` (clamped into `[0, len(s)]`), so
// `indexOfFrom(s, "", len(s)) == len(s)` but any `at` past `len(s)` finds
// nothing — there is no position beyond the string to match at, empty needle
// or not. A negative `at` clamps to 0 (same convention as JS's
// `String.prototype.indexOf`'s `fromIndex`) rather than reading out of bounds.
export fn indexOfFrom(s: string, sub: string, at: i64): i64 {
  let off = at
  if (off < 0) {
    off = 0
  }
  if (off > len(s)) {
    return -1
  }
  let subLen = len(sub)
  if (subLen == 0) {
    return off
  }
  let n = len(s)
  if (subLen > n) {
    return -1
  }
  let last = n - subLen
  let i = off
  while (i <= last) {
    let j = 0
    while (j < subLen && s[i + j] == sub[j]) {
      j = j + 1
    }
    if (j == subLen) {
      return i
    }
    i = i + 1
  }
  return -1
}

// The byte index of the LAST occurrence of `sub` in `s`, or -1 if absent.
// Matches Go's strings.LastIndex: an empty `sub` matches at `len(s)`, and an
// overlapping candidate (e.g. `lastIndexOf("aaa", "aa")`) reports the
// rightmost start position — `1`, not the leftmost `0` — since the scan never
// skips past a candidate start the way `count`'s non-overlapping scan does.
// Scans backward by direct byte comparison, same no-allocation shape as
// `indexOfFrom`.
export fn lastIndexOf(s: string, sub: string): i64 {
  let subLen = len(sub)
  if (subLen == 0) {
    return len(s)
  }
  let n = len(s)
  if (subLen > n) {
    return -1
  }
  let i = n - subLen
  while (i >= 0) {
    let j = 0
    while (j < subLen && s[i + j] == sub[j]) {
      j = j + 1
    }
    if (j == subLen) {
      return i
    }
    i = i - 1
  }
  return -1
}

// `s` split on every occurrence of `sep`, in order. Adjacent separators and
// leading/trailing ones yield empty parts, so `split("a,,b,", ",")` is
// `["a", "", "b", ""]`. An empty `sep` yields the whole string as one part.
export fn split(s: string, sep: string): []string {
  let out = []string(0)
  if (len(sep) == 0) {
    return append(out, s)
  }
  let start = 0
  let n = len(s)
  let sepLen = len(sep)
  // Bounded: `start` advances by at least `sepLen >= 1` each iteration. Scans
  // forward from `start` with no intermediate copy of the unconsumed tail —
  // each iteration allocates only the part it emits (#2110).
  while (start <= n) {
    let rel = indexOfFrom(s, sep, start)
    if (rel < 0) {
      return append(out, s[start:n])
    }
    out = append(out, s[start:rel])
    start = rel + sepLen
  }
  return out
}

// `s` split on `sep`, keeping at most `n` parts. `n > 0`: the first `n - 1`
// parts are split on `sep` and the last part keeps everything remaining,
// unsplit — so a limit larger than the number of matches behaves exactly
// like `split`. `n == 0`: no parts at all (an empty slice, not one containing
// `s`). `n < 0`: unlimited, identical to `split`. Matches Go's
// strings.SplitN. An empty `sep` yields `[s]` for any `n != 0`, same
// convention as `split`.
export fn splitN(s: string, sep: string, n: i64): []string {
  let out = []string(0)
  if (n == 0) {
    return out
  }
  if (len(sep) == 0) {
    return append(out, s)
  }
  if (n < 0) {
    return split(s, sep)
  }
  let start = 0
  let m = len(s)
  let sepLen = len(sep)
  // Bounded: at most `n - 1` iterations, each advancing `start` by at least
  // `sepLen >= 1` past a match, so this terminates regardless of `m`.
  while (len(out) < n - 1) {
    let rel = indexOfFrom(s, sep, start)
    if (rel < 0) {
      break
    }
    out = append(out, s[start:rel])
    start = rel + sepLen
  }
  return append(out, s[start:m])
}

// Whether byte `c` appears anywhere in `cutset`.
fn inCutset(c: u8, cutset: string): bool {
  let i = 0
  while (i < len(cutset)) {
    if (cutset[i] == c) {
      return true
    }
    i = i + 1
  }
  return false
}

// `s` with every leading byte that appears in `cutset` removed. Byte-level
// cutset membership, like the rest of this module (see the file header):
// each byte of `s` is compared against each byte of `cutset` directly, never
// decoded as a code point, so a multi-byte rune in `cutset` matches only its
// individual encoded bytes, not the character as a whole. Matches Go's
// strings.TrimLeft in shape — a leading run stripped against a set of cut
// bytes — but not in that one respect. An empty `cutset` matches nothing, so
// `s` is returned unchanged, same as Go.
export fn trimLeft(s: string, cutset: string): string {
  let lo = 0
  while (lo < len(s) && inCutset(s[lo], cutset)) {
    lo = lo + 1
  }
  return s[lo:len(s)]
}

// `s` with every trailing byte that appears in `cutset` removed. Same
// byte-level cutset membership as `trimLeft`. Matches Go's strings.TrimRight.
export fn trimRight(s: string, cutset: string): string {
  let hi = len(s)
  while (hi > 0 && inCutset(s[hi - 1], cutset)) {
    hi = hi - 1
  }
  return s[0:hi]
}

// `s` trimmed on both ends against `cutset`. Matches Go's strings.Trim.
export fn trim(s: string, cutset: string): string {
  return trimRight(trimLeft(s, cutset), cutset)
}

// `s` with leading and trailing ASCII whitespace removed: space, tab,
// newline, vertical tab, form feed, and carriage return — the same six bytes
// Go's unicode.IsSpace treats as whitespace over ASCII input. (This module's
// byte orientation stops there: it does not also strip U+0085 NEL or U+00A0
// NBSP, which are multi-byte and outside ASCII.) Previously stripped only
// space and tab, so a line read from a file or a socket kept its trailing
// `\n` — the single most likely silent bug in line-oriented input handling.
export fn trimSpace(s: string): string {
  return trim(s, " \t\n\r\x0B\x0C")
}

// `s` with every non-overlapping occurrence of `old` replaced by `repl`,
// scanned left to right — matches Go's strings.ReplaceAll in the non-empty
// case. An empty `old` is a no-op, returning `s` unchanged: Go instead
// inserts `repl` at every position including both ends
// (`ReplaceAll("abc", "", "Z")` is `"ZaZbZcZ"`, one insertion per gap — the
// same `len(s) + 1` count `count("abc", "")` already reports for this
// module). Both are defensible; this module picks the simpler, non-surprising
// one — a null query changes nothing — rather than an output whose length
// depends on `repl` and `runeCount` instead of on `old` actually occurring.
export fn replace(s: string, old: string, repl: string): string {
  if (len(old) == 0) {
    return s
  }
  let b = newBuilder()
  let start = 0
  let n = len(s)
  let oldLen = len(old)
  // Bounded: `start` advances by at least `oldLen >= 1` past every match,
  // same bound as `split`/`count` above.
  while (start <= n) {
    let rel = indexOfFrom(s, old, start)
    if (rel < 0) {
      b.write(s[start:n])
      return b.toString()
    }
    b.write(s[start:rel])
    b.write(repl)
    start = rel + oldLen
  }
  return b.toString()
}

// int64 MIN = -9223372036854775808 = -922337203685477580 * 10 - 8. Shared by
// `parseIntAccumulate` and `parseInt`'s own final overflow check.
const parseIntMinDiv10: i64 = -922337203685477580
const parseIntMinLastDigit: i64 = 8

// The first-digit index of a decimal literal: `1` past a leading `-` or
// `+`, otherwise `0`. Fails if nothing but the sign is present. Split out of
// `parseInt` (#2448).
//
// Returns a bare `int` rather than bundling the sign alongside it. A class
// is a heap object in Bit, so the bundle cost one allocation on every
// `parseInt` call -- on a path that allocated nothing at all before the
// split (#3637, measured at exactly 1.0000 objects per call). The sign is
// not lost: `s[0] == '-'` recovers it in one line, and `parseInt` has
// already proven `s` non-empty before calling here.
fn parseIntSign(s: string): int! {
  let i = 0
  if (s[0] == '-' || s[0] == '+') {
    i = 1
  }
  if (i >= len(s)) {
    fail newError("parseInt: no digits")
  }
  return i
}

// Accumulates `s[start:]`'s digits as a NEGATIVE magnitude, not positive:
// -9223372036854775808 (int64 MIN) is representable in `int`, but its
// positive counterpart, 9223372036854775808, is not — accumulating
// positively can therefore never parse int64 MIN without first forming an
// unrepresentable intermediate value. Negating only at the end, for the
// non-negative case, is `parseInt`'s job, not this function's. Split out of
// `parseInt` (#2448).
fn parseIntAccumulate(s: string, start: int): i64! {
  let v = i64(0)
  let i = start
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      fail newError("parseInt: invalid digit")
    }
    let d = i64(c - '0')
    if (v < parseIntMinDiv10 || (v == parseIntMinDiv10 && d > parseIntMinLastDigit)) {
      fail newError("parseInt: out of range")
    }
    v = v * 10 - d
    i = i + 1
  }
  return v
}

// The signed decimal integer `s` denotes. Fails on an empty string, a bare sign,
// a non-digit, or a value outside the `int` range — it never silently wraps.
// Accepts the most negative `int`, -9223372036854775808.
export fn parseInt(s: string): int! {
  if (len(s) == 0) {
    fail newError("parseInt: empty string")
  }
  let start = parseIntSign(s)?
  let v = parseIntAccumulate(s, start)?
  if (s[0] == '-') {
    return v
  }
  // `v` is int64 MIN itself only when the (unsigned) input magnitude was
  // exactly 9223372036854775808 — one past int64 MAX, and not representable
  // as a positive `int`, even though the same magnitude is representable
  // (negated) when the input carried a leading `-`.
  if (v == parseIntMinDiv10 * 10 - parseIntMinLastDigit) {
    fail newError("parseInt: out of range")
  }
  return 0 - v
}

// The `f64` that decimal or hexadecimal float text `s` denotes, correctly
// rounded (round-to-nearest-even on the exact value, never an approximation
// — so a given text always denotes the same `f64` on every target). Fails on
// empty input, a bare sign, leading or trailing whitespace, and any text the
// predeclared `parseFloat` builtin (SPEC §5.3) cannot parse — a bad parse
// never returns a valid-looking float. `parseFloat("0")` succeeds with value
// `0`, distinguishable from every failure.
//
// `1e400` and `1e-400` still succeed: overflow/underflow round to `+Inf`/`0`
// under IEEE 754, which is a correctly-rounded conversion result, not a
// parse failure — the same as the builtin's own contract.
export fn parseFloat(s: string): f64! {
  let v = rawParseFloat(s)
  if (v != v) {
    fail newError("parseFloat: invalid syntax")
  }
  return v
}
