// Bit standard library — strings module.
//
// Byte-oriented string routines written in Bit itself, over `len(s)`, `s[i]`
// (a `u8` byte), string slicing `s[lo:hi]`, `==`, and `+`. These operate on
// bytes, not Unicode code points — correct for ASCII and for byte-exact search;
// UTF-8-aware iteration is deferred (§21, #348). Substring search is naive
// (O(n*m)); a smarter matcher is a future optimization.

// Whether `a` and `b` are byte-for-byte equal.
export function equal(a: string, b: string): bool {
  return a == b
}

// Lexicographic byte comparison: -1 if `a < b`, 0 if equal, 1 if `a > b`.
export function compare(a: string, b: string): i64 {
  let n = len(a)
  if (len(b) < n) {
    n = len(b)
  }
  let i = 0
  while (i < n) {
    if (a[i] < b[i]) {
      return -1
    }
    if (a[i] > b[i]) {
      return 1
    }
    i = i + 1
  }
  if (len(a) < len(b)) {
    return -1
  }
  if (len(a) > len(b)) {
    return 1
  }
  return 0
}

// Whether `s` begins with `prefix`.
export function hasPrefix(s: string, prefix: string): bool {
  if (len(prefix) > len(s)) {
    return false
  }
  return s[0:len(prefix)] == prefix
}

// Whether `s` ends with `suffix`.
export function hasSuffix(s: string, suffix: string): bool {
  if (len(suffix) > len(s)) {
    return false
  }
  return s[len(s) - len(suffix):] == suffix
}

// The byte index of the first occurrence of `sub` in `s`, or -1 if absent. An
// empty `sub` matches at 0.
export function indexOf(s: string, sub: string): i64 {
  if (len(sub) == 0) {
    return 0
  }
  if (len(sub) > len(s)) {
    return -1
  }
  let last = len(s) - len(sub)
  let i = 0
  while (i <= last) {
    if (s[i:i + len(sub)] == sub) {
      return i
    }
    i = i + 1
  }
  return -1
}

// Whether `sub` occurs anywhere in `s`.
export function contains(s: string, sub: string): bool {
  return indexOf(s, sub) >= 0
}

// The number of non-overlapping occurrences of `sub` in `s`.
export function count(s: string, sub: string): i64 {
  if (len(sub) == 0) {
    return len(s) + 1
  }
  let n = 0
  let i = 0
  while (i + len(sub) <= len(s)) {
    if (s[i:i + len(sub)] == sub) {
      n = n + 1
      i = i + len(sub)
    } else {
      i = i + 1
    }
  }
  return n
}

// `s` repeated `n` times (empty for `n <= 0`).
export function repeat(s: string, n: i64): string {
  let out = ""
  let i = 0
  while (i < n) {
    out = out + s
    i = i + 1
  }
  return out
}

// The elements of `parts` concatenated with `sep` between each.
export function join(parts: []string, sep: string): string {
  let out = ""
  let i = 0
  while (i < len(parts)) {
    if (i > 0) {
      out = out + sep
    }
    out = out + parts[i]
    i = i + 1
  }
  return out
}

// A copy of `s` with ASCII lowercase letters uppercased (bytes only).
export function toUpper(s: string): string {
  let b = []byte(s)
  let i = 0
  while (i < len(b)) {
    if (b[i] >= 97 && b[i] <= 122) {
      b[i] = b[i] - 32
    }
    i = i + 1
  }
  return string(b)
}

// A copy of `s` with ASCII uppercase letters lowercased (bytes only).
export function toLower(s: string): string {
  let b = []byte(s)
  let i = 0
  while (i < len(b)) {
    if (b[i] >= 65 && b[i] <= 90) {
      b[i] = b[i] + 32
    }
    i = i + 1
  }
  return string(b)
}

// `s` split on every occurrence of `sep`, in order. Adjacent separators and
// leading/trailing ones yield empty parts, so `split("a,,b,", ",")` is
// `["a", "", "b", ""]`. An empty `sep` yields the whole string as one part.
export function split(s: string, sep: string): []string {
  let out = []string(0)
  if (len(sep) == 0) {
    return append(out, s)
  }
  let start = 0
  // Bounded: `start` advances by at least `len(sep) >= 1` each iteration.
  while (start <= len(s)) {
    let rest = s[start:len(s)]
    let rel = indexOf(rest, sep)
    if (rel < 0) {
      return append(out, rest)
    }
    out = append(out, rest[0:rel])
    start = start + rel + len(sep)
  }
  return out
}

// `s` with leading and trailing ASCII spaces and tabs removed.
export function trimSpace(s: string): string {
  let lo = 0
  while (lo < len(s) && (s[lo] == ' ' || s[lo] == '\t')) {
    lo = lo + 1
  }
  let hi = len(s)
  while (hi > lo && (s[hi - 1] == ' ' || s[hi - 1] == '\t')) {
    hi = hi - 1
  }
  return s[lo:hi]
}

// The signed decimal integer `s` denotes. Fails on an empty string, a bare sign,
// a non-digit, or a value outside the `int` range — it never silently wraps.
//
// The most negative `int` (-9223372036854775808) is rejected: the parser
// accumulates a positive magnitude and would overflow representing it. Callers
// needing that exact bound must special-case it.
export function parseInt(s: string): int! {
  if (len(s) == 0) {
    fail newError("parseInt: empty string")
  }
  let i = 0
  let neg = false
  if (s[0] == '-') {
    neg = true
    i = 1
  } else if (s[0] == '+') {
    i = 1
  }
  if (i >= len(s)) {
    fail newError("parseInt: no digits")
  }
  // (2^63 - 1) = 9223372036854775807 = 922337203685477580 * 10 + 7.
  let maxDiv10 = 922337203685477580
  let maxMod10 = 7
  let v = 0
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      fail newError("parseInt: invalid digit")
    }
    let d = i64(c - '0')
    if (v > maxDiv10 || v == maxDiv10 && d > maxMod10) {
      fail newError("parseInt: out of range")
    }
    v = v * 10 + d
    i = i + 1
  }
  if (neg) {
    return 0 - v
  }
  return v
}
