// Bit standard library — strings module, UTF-8 code-point (rune) decoding.
//
// Written in Bit over byte access (`len(s)`, `s[i]` as a `u8`). These make the
// strings module correct on multi-byte input rather than ASCII-only: runeCount
// counts code points (not bytes) and `runes` decodes the whole string into a
// `[]rune`. Input is not assumed well-formed: `runeAt`/`runeCount`/`runes` all
// decode through `decodeRune`, which never reads past `len(s)` and validates
// every continuation byte, encoding length, and resulting scalar value. Any
// malformed byte — truncated sequence, bad continuation byte, overlong
// encoding, an encoded surrogate (U+D800-U+DFFF), or a value above U+10FFFF —
// decodes as U+FFFD (the replacement character) and consumes exactly 1 byte,
// which guarantees forward progress no matter how the input is broken.

// Bytes in the UTF-8 sequence whose lead byte is `b` (always 1..4). This is a
// lead-byte-only classification, same as the first byte of any well-formed
// sequence of that length — it does not validate continuation bytes, so it is
// not used to advance `runeCount`/`runes`, which decode the whole sequence
// through `decodeRune` instead and may consume fewer bytes on malformed input.
export fn runeSize(b: int): int {
  if (b < 0x80) {
    return 1
  }
  if (b < 0xC0) {
    return 1 // stray continuation byte — count as 1 to keep scans progressing
  }
  if (b < 0xE0) {
    return 2
  }
  if (b < 0xF0) {
    return 3
  }
  return 4
}

// Decodes the UTF-8 sequence starting at byte `i` of `s`, returning the code
// point and the number of bytes it occupies. Never reads `s[j]` for `j >=
// len(s)`. On any malformed input — `i` out of range, an invalid or truncated
// lead byte, a continuation byte outside 0x80-0xBF, an overlong encoding, an
// encoded surrogate, or a value above U+10FFFF — returns (U+FFFD, 1).
fn decodeRune(s: string, i: int): (rune, int) {
  let n = len(s)
  if (i < 0 || i >= n) {
    return rune(0xFFFD), 1
  }
  let b0 = int(s[i])
  if (b0 < 0x80) {
    return rune(b0), 1
  }
  let want = 0
  let minCp = 0
  let cp = 0
  if (b0 >= 0xC2 && b0 <= 0xDF) {
    want = 2
    minCp = 0x80
    cp = b0 & 0x1F
  } else if (b0 >= 0xE0 && b0 <= 0xEF) {
    want = 3
    minCp = 0x800
    cp = b0 & 0x0F
  } else if (b0 >= 0xF0 && b0 <= 0xF4) {
    want = 4
    minCp = 0x10000
    cp = b0 & 0x07
  } else {
    // 0x80-0xC1 (stray continuation byte, or an overlong 2-byte lead) or
    // 0xF5-0xFF (no scalar value reaches that high) — never a valid lead byte.
    return rune(0xFFFD), 1
  }
  if (i + want > n) {
    return rune(0xFFFD), 1 // truncated: fewer bytes remain than the lead byte claims
  }
  let j = 1
  while (j < want) {
    let cb = int(s[i + j])
    if (cb < 0x80 || cb > 0xBF) {
      return rune(0xFFFD), 1
    }
    cp = (cp << 6) | (cb & 0x3F)
    j = j + 1
  }
  if (cp < minCp) {
    return rune(0xFFFD), 1 // overlong: a shorter encoding could have said this
  }
  if (cp >= 0xD800 && cp <= 0xDFFF) {
    return rune(0xFFFD), 1 // surrogate half: not a Unicode scalar value
  }
  if (cp > 0x10FFFF) {
    return rune(0xFFFD), 1 // above the maximum Unicode scalar value
  }
  return rune(cp), want
}

// Encodes Unicode scalar value `cp` as UTF-8 into `b`, returning `b`. Mirrors
// `decodeRune`'s branches in reverse. The only caller today is
// `toLower`/`toUpper` (strings.bit), and only for a rune `unicodefold.bit`'s
// case tables actually changed — an unfolded rune's original bytes are
// copied through unchanged instead, so this never has to round-trip a rune
// that didn't change. Assumes `cp` is a valid Unicode scalar value (never a
// surrogate, never above U+10FFFF): every caller only ever passes a value
// `decodeRune` produced or a fold table's mapped target, and both already
// exclude those.
fn writeRuneUtf8(b: Builder, cp: int): Builder {
  if (cp < 0x80) {
    return b.writeByte(u8(cp))
  }
  if (cp < 0x800) {
    return b.writeByte(u8(0xC0 | (cp >> 6))).writeByte(u8(0x80 | (cp & 0x3F)))
  }
  if (cp < 0x10000) {
    return b.writeByte(u8(0xE0 | (cp >> 12))).writeByte(u8(0x80 | ((cp >> 6) & 0x3F))).writeByte(
      u8(0x80 | (cp & 0x3F)),
    )
  }
  return b.writeByte(u8(0xF0 | (cp >> 18))).writeByte(u8(0x80 | ((cp >> 12) & 0x3F))).writeByte(
    u8(0x80 | ((cp >> 6) & 0x3F)),
  ).writeByte(u8(0x80 | (cp & 0x3F)))
}

// The code point starting at byte `i`. Assumes `i` is a rune boundary on
// well-formed input; on malformed input (including `i` out of range) returns
// U+FFFD rather than reading past `len(s)` or returning a non-scalar value.
export fn runeAt(s: string, i: int): rune {
  let (cp, _) = decodeRune(s, i)
  return cp
}

// Number of code points in `s` (not bytes). Malformed input counts as one
// U+FFFD per broken byte, same as `runes`, so this always terminates.
export fn runeCount(s: string): int {
  let i = 0
  let count = 0
  while (i < len(s)) {
    let (_, consumed) = decodeRune(s, i)
    i = i + consumed
    count = count + 1
  }
  return count
}

// `s` left-padded with U+0020 space characters until it is `width` runes
// long, measured with `runeCount` (never `len`, which counts bytes — a
// multi-byte rune like `é` is 2 bytes but must count as 1 column). If `s` is
// already `width` runes or longer, or `width` is 0 or less, returns `s`
// unchanged: this never truncates. The pad unit is a single ASCII space —
// one byte, one rune — so there is no empty-pad infinite loop and no
// multi-rune pad to cut at a rune boundary; those hazards apply only to a
// caller-supplied pad string, which this function does not take. On
// malformed UTF-8 input, `s` is passed through unexamined and `runeCount`
// counts it the same way it always does (one U+FFFD per broken byte, per the
// file header above), so the padding follows that same convention rather
// than being separately undefined here.
export fn padLeft(s: string, width: int): string {
  let n = runeCount(s)
  if (width <= 0 || n >= width) {
    return s
  }
  let padCount = width - n
  let sl = len(s)
  let out = []byte(sl + padCount)
  let i = 0
  while (i < padCount) {
    out[i] = ' '
    i = i + 1
  }
  let j = 0
  while (j < sl) {
    out[padCount + j] = s[j]
    j = j + 1
  }
  return string(out)
}

// `s` right-padded with U+0020 space characters until it is `width` runes
// long, measured with `runeCount` (never `len`, which counts bytes). Same
// rules as `padLeft`: already `width` runes or longer, or `width` is 0 or
// less, returns `s` unchanged and never truncates.
export fn padRight(s: string, width: int): string {
  let n = runeCount(s)
  if (width <= 0 || n >= width) {
    return s
  }
  let padCount = width - n
  let sl = len(s)
  let out = []byte(sl + padCount)
  let j = 0
  while (j < sl) {
    out[j] = s[j]
    j = j + 1
  }
  let i = 0
  while (i < padCount) {
    out[sl + i] = ' '
    i = i + 1
  }
  return string(out)
}

// Builds a string of exactly `count` runes by repeating `pad`'s own runes
// cyclically. `pad`'s rune count need not divide `count` evenly — the last
// cycle is simply cut short, so the result is always exactly `count` runes,
// matching how JS's `padStart`/`padEnd` truncate a pad string that does not
// fit evenly. `count <= 0` or an empty `pad` (nothing to repeat) yields "".
// Copies each rune's own UTF-8 bytes verbatim from `pad` rather than
// decoding to `rune` and re-encoding: `string(rune)`/`string([]rune)` are not
// implemented yet (SPEC §12.9, deferred to rune iteration landing).
fn padFill(pad: string, count: int): string {
  if (count <= 0 || len(pad) == 0) {
    return ""
  }
  // Byte spans of each rune in `pad`, walked once up front.
  let starts = []int(0)
  let lens = []int(0)
  let i = 0
  while (i < len(pad)) {
    let (_, consumed) = decodeRune(pad, i)
    starts = append(starts, i)
    lens = append(lens, consumed)
    i = i + consumed
  }
  let pn = len(starts)
  let b = newBuilder()
  let k = 0
  while (k < count) {
    let r = k % pn
    b.write(pad[starts[r]:starts[r] + lens[r]])
    k = k + 1
  }
  return b.toString()
}

// `s` left-padded with `pad`, repeated cyclically by code point (measured
// with `runeCount`, never `len`) until it is `width` runes long. Matches
// JS's `String.prototype.padStart`, generalised from UTF-16 units to code
// points. If `s` is already `width` runes or longer, `width` is 0 or less,
// or `pad` is empty (nothing to repeat), returns `s` unchanged — this never
// truncates `s` itself, and never removes anything on the already-long path.
export fn padStart(s: string, width: int, pad: string): string {
  let n = runeCount(s)
  if (width <= 0 || n >= width || len(pad) == 0) {
    return s
  }
  return padFill(pad, width - n) + s
}

// `s` right-padded with `pad`. Same rules as `padStart`, on the other end.
// Matches JS's `String.prototype.padEnd`.
export fn padEnd(s: string, width: int, pad: string): string {
  let n = runeCount(s)
  if (width <= 0 || n >= width || len(pad) == 0) {
    return s
  }
  return s + padFill(pad, width - n)
}

// Decode `s` into its sequence of code points.
export fn runes(s: string): []rune {
  let out = []rune(0)
  let i = 0
  while (i < len(s)) {
    let (cp, consumed) = decodeRune(s, i)
    out = append(out, cp)
    i = i + consumed
  }
  return out
}

// True if every byte of `s` belongs to a complete, minimal, in-range UTF-8
// encoding. `runeCount`/`runes` do not give a caller this: they launder a
// malformed byte into U+FFFD and keep going, so a validator built on top of
// them (checking each decoded rune) cannot tell malformed input from input
// that genuinely contains the replacement character.
//
// Reuses `decodeRune` rather than re-deriving its rules, so this enforces
// exactly the five things a UTF-8 validator must: continuation-byte shape,
// the three overlong minimums, the surrogate block (U+D800-U+DFFF), the
// U+10FFFF ceiling, and truncation at end-of-input (`decodeRune`'s own
// `i + want > n` check) — see that function's header for where each lives.
// `decodeRune` returns (U+FFFD, 1) only on one of those failures: no lead
// byte below 0x80 decodes to a value that high, and the genuine 3-byte
// encoding of U+FFFD itself reports consumed=3, so the pair is a safe
// sentinel for "this byte was rejected", not "this rune is U+FFFD".
export fn isValidUtf8(s: string): bool {
  let i = 0
  let n = len(s)
  while (i < n) {
    let (cp, consumed) = decodeRune(s, i)
    if (consumed == 1 && cp == rune(0xFFFD)) {
      return false
    }
    i = i + consumed
  }
  return true
}

// `s` with every ill-formed byte `decodeRune` rejects replaced by
// `replacement`; well-formed runs are copied through unchanged. Uses the
// same (U+FFFD, 1) sentinel as `isValidUtf8` to tell a rejected byte apart
// from a genuine decoded U+FFFD, so a real replacement character already
// present in `s` is never doubled up.
export fn toValidUtf8(s: string, replacement: string): string {
  let i = 0
  let n = len(s)
  let b = newBuilder()
  while (i < n) {
    let (cp, consumed) = decodeRune(s, i)
    if (consumed == 1 && cp == rune(0xFFFD)) {
      b.write(replacement)
    } else {
      b.write(s[i:i + consumed])
    }
    i = i + consumed
  }
  return b.toString()
}
