// Bit standard library — strings module, UTF-8 code-point (rune) decoding.
//
// Written in Bit over byte access (`len(s)`, `s[i]` as a `u8`). These make the
// strings module correct on multi-byte input rather than ASCII-only: runeCount
// counts code points (not bytes) and `runes` decodes the whole string into a
// `[]rune`. Decoding assumes well-formed UTF-8; it is lenient only enough to
// guarantee forward progress (a stray continuation/invalid lead byte counts as
// a 1-byte rune), so every loop over `runeSize` terminates.

// Bytes in the UTF-8 sequence whose lead byte is `b` (always 1..4).
export function runeSize(b: int): int {
  if (b < 0x80) {
    return 1
  }
  if (b < 0xC0) {
    return 1 // stray continuation byte — count as 1 to keep scans progressing
  }
  if (b < 0xE0) {
    return 2
  }
  if (b < 0xF0) {
    return 3
  }
  return 4
}

// The code point starting at byte `i`. Assumes `i` is a rune boundary.
export function runeAt(s: string, i: int): rune {
  let b0 = int(s[i])
  if (b0 < 0x80) {
    return rune(b0)
  }
  let n = runeSize(b0)
  let cp = b0 & 0x1F // 2-byte lead payload
  if (n == 3) {
    cp = b0 & 0x0F
  }
  if (n == 4) {
    cp = b0 & 0x07
  }
  let j = 1
  while (j < n) {
    cp = (cp << 6) | (int(s[i + j]) & 0x3F)
    j = j + 1
  }
  return rune(cp)
}

// Number of code points in `s` (not bytes).
export function runeCount(s: string): int {
  let i = 0
  let count = 0
  while (i < len(s)) {
    i = i + runeSize(int(s[i]))
    count = count + 1
  }
  return count
}

// Decode `s` into its sequence of code points.
export function runes(s: string): []rune {
  let out = []rune(0)
  let i = 0
  while (i < len(s)) {
    out = append(out, runeAt(s, i))
    i = i + runeSize(int(s[i]))
  }
  return out
}
