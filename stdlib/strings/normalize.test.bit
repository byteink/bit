// stdlib/strings/normalize.test.bit — #6878. `normalize` and `isNormalized`
// (normalize.bit) against the Unicode Character Database's conformance file
// for UAX #15, plus the cases the file cannot express.
//
// Data: _tests_/data/unicode/NormalizationTest.txt, UCD 17.0.0, from
//   https://www.unicode.org/Public/17.0.0/ucd/NormalizationTest.txt
//
// Same module as ./normalize.bit (SPEC §19): no import is needed, and none
// is possible for the file read. std/fs imports std/strings, so importing it
// here is an import cycle (E0044). `fsOpen`/`fsReadAll`/`fsClose` are the
// runtime primitives std/fs itself is built on, available without an import.

const ntDataPath: string = "_tests_/data/unicode/NormalizationTest.txt"

// The number of data lines in the 17.0.0 file: a truncated copy must fail.
const ntDataLines: int = 20034

fn ntHex(c: int): int {
  if (c >= int('a')) {
    return c - int('a') + 10
  }
  if (c >= int('A')) {
    return c - int('A') + 10
  }
  return c - int('0')
}

// The file's text, read relative to the working directory: `bit test` runs
// from the repo root.
fn ntLoad(): string {
  let fd = fsOpen(ntDataPath, false)
  assert(fd >= 0, "cannot open ${ntDataPath} (run `bit test` from the repo root)")
  let text = fsReadAll(fd)
  fsClose(fd)
  return text
}

// The UTF-8 string of the space-separated hex code points in `line[lo:hi]`.
fn ntDecode(line: string, lo: int, hi: int): string {
  let b = Builder()
  let v = 0
  let inTok = false
  let i = lo
  while (i < hi) {
    let c = int(line[i])
    if (c == 32) {
      if (inTok) {
        writeRuneUtf8(b, v)
      }
      v = 0
      inTok = false
    } else {
      v = v * 16 + ntHex(c)
      inTok = true
    }
    i = i + 1
  }
  if (inTok) {
    writeRuneUtf8(b, v)
  }
  return b.toString()
}

fn ntOne(cp: int): string {
  let b = Builder()
  writeRuneUtf8(b, cp)
  return b.toString()
}

// The value of the leading hex digits of `line`.
fn ntFirstCp(line: string): int {
  let v = 0
  let i = 0
  while (i < len(line) && line[i] != 59) {
    v = v * 16 + ntHex(int(line[i]))
    i = i + 1
  }
  return v
}

fn ntAll(c: string, f: Form, want: string): bool {
  return normalize(c, f) == want
}

// The NFC invariants of the file's header for one line's five columns.
fn ntNfcOk(c: []string): bool {
  let first = ntAll(c[0], Form.Nfc, c[1]) &&
    ntAll(c[1], Form.Nfc, c[1]) &&
    ntAll(c[2], Form.Nfc, c[1])
  return first && ntAll(c[3], Form.Nfc, c[3]) && ntAll(c[4], Form.Nfc, c[3])
}

// The NFD invariants.
fn ntNfdOk(c: []string): bool {
  let first = ntAll(c[0], Form.Nfd, c[2]) &&
    ntAll(c[1], Form.Nfd, c[2]) &&
    ntAll(c[2], Form.Nfd, c[2])
  return first && ntAll(c[3], Form.Nfd, c[4]) && ntAll(c[4], Form.Nfd, c[4])
}

// The NFKC and NFKD invariants: every column maps to column 4 and column 5.
fn ntCompatOk(c: []string): bool {
  let k = 0
  while (k < 5) {
    if (!ntAll(c[k], Form.Nfkc, c[3]) || !ntAll(c[k], Form.Nfkd, c[4])) {
      return false
    }
    k = k + 1
  }
  return true
}

fn ntInvariants(c: []string): bool {
  return ntNfcOk(c) && ntNfdOk(c) && ntCompatOk(c)
}

// The five columns of the data line `line[lo:hi]` (hi stops at a `#`).
fn ntColumns(line: string, hi: int): []string {
  let cols = []string(0, 5)
  let start = 0
  let i = 0
  while (i < hi && len(cols) < 5) {
    if (line[i] == 59) {
      cols = append(cols, ntDecode(line, start, i))
      start = i + 1
    }
    i = i + 1
  }
  return cols
}

fn ntDataEnd(line: string): int {
  let i = 0
  while (i < len(line) && line[i] != 35) {
    i = i + 1
  }
  return i
}

test "NormalizationTest.txt: every data line passes all four forms" {
  let text = ntLoad()
  let listed = []bool(0x110000)
  let lines = 0
  let passed = 0
  let part = 0
  let firstBad = ""
  let pos = 0
  while (pos < len(text)) {
    let end = pos
    while (end < len(text) && text[end] != 10) {
      end = end + 1
    }
    let line = text[pos:end]
    pos = end + 1
    if (len(line) == 0 || line[0] == 35) {
      continue
    }
    if (line[0] == 64) {
      part = int(line[5]) - int('0')
      continue
    }
    lines = lines + 1
    let cols = ntColumns(line, ntDataEnd(line))
    assert(len(cols) == 5, "five columns: ${line}")
    if (part == 1) {
      listed[ntFirstCp(line)] = true
    }
    if (ntInvariants(cols)) {
      passed = passed + 1
    } else if (len(firstBad) == 0) {
      firstBad = line
    }
  }
  println("normalization conformance: ${passed} of ${lines} passed")
  assert(lines == ntDataLines, "data lines in the file: ${lines}")
  assert(passed == lines, "first failing line: ${firstBad}")

  // Part 1's second invariant: a code point it does not list is unchanged by
  // all four forms. Hangul syllables are listed only in part (the rest are
  // algorithmic and covered below), and surrogates are not scalar values.
  let cp = 0
  let changed = 0
  while (cp < 0x110000) {
    let skip = listed[cp] || (cp >= 0xD800 && cp <= 0xDFFF) || (cp >= 0xAC00 && cp <= 0xD7A3)
    if (!skip) {
      let s = ntOne(cp)
      if (normalize(s, Form.Nfc) != s ||
        normalize(s, Form.Nfd) != s ||
        normalize(s, Form.Nfkc) != s ||
        normalize(s, Form.Nfkd) != s) {
        changed = changed + 1
        println("changed: U+${cp}")
      }
    }
    cp = cp + 1
  }
  assert(changed == 0, "unlisted code points changed")
}

test "Hangul syllables decompose and recompose by arithmetic" {
  let s = 0
  let bad = 0
  while (s < 11172) {
    let syl = ntOne(0xAC00 + s)
    let d = normalize(syl, Form.Nfd)
    let want = ntOne(0x1100 + s / 588) + ntOne(0x1161 + s % 588 / 28)
    if (s % 28 != 0) {
      want = want + ntOne(0x11A7 + s % 28)
    }
    if (d != want || normalize(d, Form.Nfc) != syl || normalize(syl, Form.Nfkd) != want) {
      bad = bad + 1
    }
    s = s + 1
  }
  assert(bad == 0, "Hangul syllables that did not round-trip")
}

test "the plain ranges hold no class, mapping or composition" {
  let cp = 0
  let bad = 0
  while (cp < 0x110000) {
    if (normPlain(cp)) {
      if (ccc(rune(cp)) != 0 ||
        len(canonicalDecomp(rune(cp))) != 0 ||
        len(compatDecomp(rune(cp))) != 0) {
        bad = bad + 1
      }
    }
    cp = cp + 1
  }
  assert(bad == 0, "plain code points with a class or mapping")
  // No pair of the compose table ends in a plain code point.
  let i = 0
  while (i + 15 <= len(normComposeTable)) {
    assert(
      !normPlain(normHex(normComposeTable, i + 5, 5)),
      "a plain second half at record ${i / 15}",
    )
    i = i + 15
  }
}

test "normalize names the examples of the ticket" {
  assert(normalize("e\u{301}", Form.Nfc) == "\u{E9}", "e + acute composes")
  assert(normalize("\u{E9}", Form.Nfc) == "\u{E9}", "composed stays composed")
  assert(normalize("\u{E9}", Form.Nfd) == "e\u{301}", "composed decomposes")
  assert(normalize("\u{FB01}", Form.Nfc) == "\u{FB01}", "a ligature is canonically stable")
  assert(normalize("\u{FB01}", Form.Nfkc) == "fi", "a ligature folds under NFKC")
  assert(normalize("\u{212B}", Form.Nfc) == "\u{C5}", "the Angstrom sign is a singleton")
  assert(
    normalize("a\u{323}\u{301}", Form.Nfc) == normalize("a\u{301}\u{323}", Form.Nfc),
    "marks are reordered",
  )
}

test "normalize leaves ASCII alone and rewrites ill-formed bytes" {
  let ascii = "plain text 123"
  assert(normalize(ascii, Form.Nfkd) == ascii, "ASCII is returned as is")
  assert(normalize("", Form.Nfc) == "", "empty")
  assert(normalize("a\xFFb\u{301}", Form.Nfc) == "a\u{FFFD}b\u{301}", "a bad byte is one U+FFFD")
  assert(normalize("\xE9", Form.Nfd) == "\u{FFFD}", "a lone Latin-1 byte is U+FFFD")
  assert(normalize("\xC3", Form.Nfc) == "\u{FFFD}", "a truncated sequence is U+FFFD")
}

test "a long run of marks is ordered without a quadratic sort" {
  let b = Builder()
  b.write("a")
  let i = 0
  while (i < 20000) {
    b.write("\u{301}\u{316}")
    i = i + 1
  }
  let out = normalize(b.toString(), Form.Nfd)
  assert(len(out) == 1 + 20000 * 4, "length is preserved")
  assert(out[1:3] == "\u{316}", "the class-220 marks sort first")
}

test "isNormalized agrees with normalize" {
  assert(isNormalized("abc", Form.Nfc), "ASCII")
  assert(isNormalized("\u{E9}", Form.Nfc), "composed is NFC")
  assert(!isNormalized("e\u{301}", Form.Nfc), "decomposed is not NFC")
  assert(isNormalized("e\u{301}", Form.Nfd), "decomposed is NFD")
  assert(!isNormalized("\u{E9}", Form.Nfd), "composed is not NFD")
  assert(!isNormalized("\u{FB01}", Form.Nfkc), "a ligature is not NFKC")
  assert(!isNormalized("a\xFF", Form.Nfc), "ill-formed UTF-8 is not normalized")
}
