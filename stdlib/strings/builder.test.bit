// stdlib/strings/builder.test.bit — #7039. A test body is lowered through
// `lowerTestDeclNamed` (compiler/testgen.bit), which once dropped the
// interior-pointer keepalive edges (#4406) the builder recorded: an exploded
// `string` local (`want` below) is `{ptr, len, base}`, `ptr` is the only word a
// later read uses, and without the edge from `ptr` to `base` the collector swept
// the 66560 bytes `want` still pointed into. The first read of `want` after
// enough allocation then segfaulted, or read swept bytes.
//
// The shape is the one that crashed: a >64 KiB string held across a loop that
// builds and drops a second copy of it, one `Builder` each, and compares the two.

// 66560 bytes (more than one 64 KiB large object), every byte value among them.
fn fixture(): string {
  let out: []byte = []byte(66560)
  let i = 0
  while (i < 66560) {
    out[i] = byte((i * 7 + i / 256) % 256)
    i = i + 1
  }
  return string(out)
}

// `data` written to a Builder `step` bytes at a time, then `toString()`.
fn rebuild(data: string, step: int): string {
  let out = Builder()
  let pos = 0
  while (pos < len(data)) {
    let take = step
    if (take > len(data) - pos) {
      take = len(data) - pos
    }
    out.write(data[pos:pos + take])
    pos = pos + take
  }
  return out.toString()
}

test "a 66560-byte string built twice stays intact across a loop of rebuilds" {
  let data = fixture()
  let want = rebuild(data, 65536)
  let bad = 0
  let k = 0
  while (k < 40) {
    let got = rebuild(data, 100)
    if (got != want) {
      bad = bad + 1
    }
    k = k + 1
  }
  assert(bad == 0, "${bad} of 40 rebuilds differed from the first")
  assert(want == data, "the first rebuild differs from the source")
}

test "concatenating 100-byte pieces of a 16383-byte string reproduces it" {
  let data = fixture()
  let part = data[0:16383]
  let k = 0
  while (k < 20) {
    let out = ""
    let pos = 0
    while (pos < len(part)) {
      let take = 100
      if (take > len(part) - pos) {
        take = len(part) - pos
      }
      out = out + part[pos:pos + take]
      pos = pos + take
    }
    assert(out == part, "round ${k}: the concatenation differs from the source")
    k = k + 1
  }
}

// An out-of-range read of a drained string is a bounds panic, not a segfault
// (#7039 saw `a[len(a)]` die on SIGSEGV with the keepalive edges missing).
test "testpanic_read at len of a rebuilt string" {
  let data = fixture()
  let a = rebuild(data[0:16383], 100)
  let i = len(a)
  assert(a[i] == 0, "unreachable")
}
