// Bit standard library — strings module, Unicode normalization data (#6877).
//
// GENERATED — do not hand-edit. Produced by tools/genunicode from the
// Unicode Character Database, version 17.0.0:
//   https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt
//   https://www.unicode.org/Public/17.0.0/ucd/DerivedNormalizationProps.txt
// Regenerate with:
//   bit run tools/genunicode -- norm \
//     <UnicodeData.txt> <DerivedNormalizationProps.txt> stdlib/strings
//
// `ccc` is the canonical combining class. `canonicalDecomp` is the
// SINGLE-level canonical mapping (UnicodeData.txt field 5 without a
// `<tag>`); `compatDecomp` is the single-level mapping of characters whose
// field 5 carries a `<tag>` — the two tables are disjoint, so NFKD takes
// `compatDecomp` first and `canonicalDecomp` second, and recurses on the
// result. Both return an empty slice when the rune has no such mapping.
// `compose` is the primary composite of a canonical pair, or 0: pairs in
// Full_Composition_Exclusion are never returned. Hangul syllables are
// algorithmic and are not tabled here.

// ccc records: lo(5) hi(5) class(2), sorted by lo.
const normCccTable: string = ""

// canonical keys: rune(5) offset(5), sorted, plus a sentinel.
const normCanonKeys: string = ""

// canonical mappings, five hex digits per rune.
const normCanonData: string = ""

// compatibility keys: rune(5) offset(5), sorted, plus a sentinel.
const normCompatKeys: string = ""

// compatibility mappings, five hex digits per rune.
const normCompatData: string = ""

// compose records: first(5) second(5) composite(5), sorted by (first, second).
const normComposeTable: string = ""

// The largest codepoint any table above can hold (five hex digits).
const normMaxRune: int = 0xFFFFF

// The value of the `n` uppercase hex digits of `s` starting at byte `at`.
fn normHex(s: string, at: int, n: int): int {
  let v = 0
  let i = at
  // Bounded by `at + n`.
  while (i < at + n) {
    let c = int(s[i])
    if (c <= int('9')) {
      v = v * 16 + c - int('0')
    } else {
      v = v * 16 + c - int('A') + 10
    }
    i = i + 1
  }
  return v
}

// The index of the last `recLen`-byte record of `tbl` whose leading
// `keyLen`-digit key is <= `key`, or -1 when every key is larger. Binary
// search: O(log n) probes, no allocation.
fn normFloor(tbl: string, recLen: int, keyLen: int, key: int): int {
  let lo = 0
  let hi = len(tbl) / recLen - 1
  let found = -1
  // Bounded: `hi - lo` strictly shrinks every iteration.
  while (lo <= hi) {
    let mid = lo + (hi - lo) / 2
    if (normHex(tbl, mid * recLen, keyLen) <= key) {
      found = mid
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  return found
}

// The canonical combining class of `r`; 0 for a starter.
fn ccc(r: rune): int {
  let i = normFloor(normCccTable, 12, 5, int(r))
  if (i < 0 || int(r) > normHex(normCccTable, i * 12 + 5, 5)) {
    return 0
  }
  return normHex(normCccTable, i * 12 + 10, 2)
}

// The mapping of `r` in the key/data table pair, or an empty slice. The
// record after `r`'s (the sentinel at worst) bounds the mapping. The
// sentinel's own key, `normMaxRune`, is no real mapping's: the guard keeps
// a lookup of exactly that rune (a noncharacter) off the record past it.
fn normDecomp(keys: string, data: string, r: rune): []rune {
  if (int(r) >= normMaxRune) {
    return []rune(0)
  }
  let i = normFloor(keys, 10, 5, int(r))
  if (i < 0 || normHex(keys, i * 10, 5) != int(r)) {
    return []rune(0)
  }
  let out: []rune = []rune(0)
  let j = normHex(keys, i * 10 + 5, 5)
  let end = normHex(keys, i * 10 + 15, 5)
  // Bounded by `end`, at most 18 runes past `j` in UCD 17.0.0.
  while (j < end) {
    out = append(out, rune(normHex(data, j * 5, 5)))
    j = j + 1
  }
  return out
}

// The single-level canonical decomposition of `r`, or an empty slice.
fn canonicalDecomp(r: rune): []rune {
  return normDecomp(normCanonKeys, normCanonData, r)
}

// The single-level compatibility (`<tag>`) decomposition of `r`, or an
// empty slice.
fn compatDecomp(r: rune): []rune {
  return normDecomp(normCompatKeys, normCompatData, r)
}

// The primary composite of the pair `a`, `b`, or 0.
fn compose(a: rune, b: rune): rune {
  if (int(a) > normMaxRune || int(b) > normMaxRune) {
    return rune(0)
  }
  let key = int(a) * 0x100000 + int(b)
  let i = normFloor(normComposeTable, 15, 10, key)
  if (i < 0 || normHex(normComposeTable, i * 15, 10) != key) {
    return rune(0)
  }
  return rune(normHex(normComposeTable, i * 15 + 10, 5))
}
