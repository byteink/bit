// stdlib/strings/punycode.test.bit - #6879. RFC 3492 section 7.1's nineteen
// sample strings (A through S), each encoded to the RFC's output and decoded
// back, plus the error paths: overflow (section 6.4), a non-ASCII or non-digit
// byte, truncated input, a non-scalar result and ill-formed UTF-8.

class Vec {
  name: string,
  text: string,
  puny: string,
}

const vectors: []Vec = [
  Vec{ name = "A", text = "ليهمابتكلموشعربي؟", puny = "egbpdaj6bu4bxfgehfvwxn" },
  Vec{ name = "B", text = "他们为什么不说中文", puny = "ihqwcrb4cv8a8dqg056pqjye" },
  Vec{ name = "C", text = "他們爲什麽不說中文", puny = "ihqwctvzc91f659drss3x8bo0yb" },
  Vec{ name = "D", text = "Pročprostěnemluvíčesky", puny = "Proprostnemluvesky-uyb24dma41a" },
  Vec{
    name = "E",
    text = "למההםפשוטלאמדבריםעברית",
    puny = "4dbcagdahymbxekheh6e0a7fei0b",
  },
  Vec{
    name = "F",
    text = "यहलोगहिन्दीक्योंनहींबोलसकतेहैं",
    puny = "i1baa7eci9glrd9b2ae1bj0hfcgg6iyaf8o0a1dig0cd",
  },
  Vec{
    name = "G",
    text = "なぜみんな日本語を話してくれないのか",
    puny = "n8jok5ay5dzabd5bym9f0cm5685rrjetr6pdxa",
  },
  Vec{
    name = "H",
    text = "세계의모든사람들이한국어를이해한다면얼마나좋을까",
    puny = "989aomsvi5e83db1d2a355cv1e0vak1dwrv93d5xbh15a0dt30a5jpsd879ccm6fea98c",
  },
  Vec{
    name = "I",
    text = "почемужеонинеговорятпорусски",
    puny = "b1abfaaepdrnnbgefbadotcwatmq2g4l",
  },
  Vec{
    name = "J",
    text = "PorquénopuedensimplementehablarenEspañol",
    puny = "PorqunopuedensimplementehablarenEspaol-fmd56a",
  },
  Vec{
    name = "K",
    text = "TạisaohọkhôngthểchỉnóitiếngViệt",
    puny = "TisaohkhngthchnitingVit-kjcr8268qyxafd2f1b9g",
  },
  Vec{ name = "L", text = "3年B組金八先生", puny = "3B-ww4c5e180e575a65lsy2b" },
  Vec{
    name = "M",
    text = "安室奈美恵-with-SUPER-MONKEYS",
    puny = "-with-SUPER-MONKEYS-pc58ag80a8qai00g7n9n",
  },
  Vec{
    name = "N",
    text = "Hello-Another-Way-それぞれの場所",
    puny = "Hello-Another-Way--fc4qua05auwb3674vfr0b",
  },
  Vec{ name = "O", text = "ひとつ屋根の下2", puny = "2-u9tlzr9756bt3uc0v" },
  Vec{ name = "P", text = "MajiでKoiする5秒前", puny = "MajiKoi5-783gue6qz075azm5e" },
  Vec{ name = "Q", text = "パフィーdeルンバ", puny = "de-jg4avhby1noc0d" },
  Vec{ name = "R", text = "そのスピードで", puny = "d9juau41awczczp" },
  Vec{ name = "S", text = "-> \$1.00 <-", puny = "-> \$1.00 <--" },
]

// The encoder's result, or its error message prefixed `error: `.
fn enc(s: string): string {
  let out = punycodeEncode(s) catch e {
    return "error: ${e.message()}"
  }
  return out
}

// The decoder's result, or its error message prefixed `error: `.
fn dec(s: string): string {
  let out = punycodeDecode(s) catch e {
    return "error: ${e.message()}"
  }
  return out
}

test "RFC 3492 7.1: all 19 samples encode to the RFC's output" {
  let ok = 0
  for v of vectors {
    let got = enc(v.text)
    assert(got == v.puny, "(${v.name}) encode: got ${got}, want ${v.puny}")
    ok = ok + 1
  }
  assert(ok == 19, "encoded ${ok} of 19")
}

test "RFC 3492 7.1: all 19 samples decode back" {
  let ok = 0
  for v of vectors {
    let got = dec(v.puny)
    assert(got == v.text, "(${v.name}) decode of ${v.puny} differs")
    ok = ok + 1
  }
  assert(ok == 19, "decoded ${ok} of 19")
}

test "decode accepts upper-case digits" {
  let want = dec("MajiKoi5-783gue6qz075azm5e")
  assert(dec("MajiKoi5-783GUE6QZ075AZM5E") == want, "upper-case digits decode the same")
}

test "empty and basic-only strings" {
  assert(enc("") == "", "empty encodes to empty")
  assert(dec("") == "", "empty decodes to empty")
  assert(enc("abc") == "abc-", "basic only gets the delimiter")
  assert(dec("abc-") == "abc", "delimiter then nothing")
  assert(enc("-") == "--", "a basic hyphen is followed by the delimiter")
  assert(dec("--") == "-", "and decodes back")
  assert(dec("-") == "error: punycode: invalid input at 0", "a lone delimiter is not a digit")
}

test "the minimal one-character case" {
  assert(enc("\u{fc}") == "tda", "u-umlaut")
  assert(dec("tda") == "\u{fc}", "u-umlaut back")
}

test "decode: overflow is an error, not a wrap" {
  assert(dec("99999999999") == "error: punycode: overflow", dec("99999999999"))
  assert(dec("a-99999999999") == "error: punycode: overflow", dec("a-99999999999"))
}

test "decode: invalid input is a typed error naming the byte index" {
  assert(dec("a-\u{e9}") == "error: punycode: invalid input at 2", dec("a-\u{e9}"))
  assert(dec("a-!") == "error: punycode: invalid input at 2", dec("a-!"))
  assert(dec("-abc") == "error: punycode: invalid input at 0", dec("-abc"))
  assert(dec("a-9") == "error: punycode: invalid input at 3", dec("a-9"))
}

test "decode: a result that is not a scalar value is rejected" {
  // U+D800 and U+DFFF are surrogates, U+110000 is past the last scalar value.
  assert(dec("ib9b") == "error: punycode: invalid input at 3", dec("ib9b"))
  assert(dec("zy0c") == "error: punycode: invalid input at 3", dec("zy0c"))
  assert(dec("en32g") == "error: punycode: invalid input at 4", dec("en32g"))
}

test "decode: input that ends inside a number is rejected" {
  assert(dec("a-9999") == "error: punycode: invalid input at 6", dec("a-9999"))
}

test "encode: ill-formed UTF-8 is an error" {
  let bad = string([byte(0xC0), byte(0xAF)])
  assert(enc(bad) == "error: punycode: invalid UTF-8", enc(bad))
  assert(enc("ab" + string([byte(0xFF)])) == "error: punycode: invalid UTF-8", "stray 0xFF")
}

test "encode then decode round-trips non-BMP and mixed text" {
  let samples = ["\u{1F600}", "a\u{1F600}b\u{e9}", "\u{10FFFF}", "x-y\u{e9}-z"]
  for s of samples {
    let p = enc(s)
    assert(dec(p) == s, "round trip of ${s} via ${p}")
  }
}
