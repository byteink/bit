// stdlib/runtime/runtime.test.bit — the panic boundary surface (#4745, epic
// #4739).
//
// Every case here runs a REAL panic through the runtime's resume path: there is
// no way to fake one, and a boundary that merely returns `(false, "")` for
// everything would pass any test that only asserted "no crash". So each case
// asserts the flag AND the message, and the two non-panicking cases assert the
// empty message — the answer a boundary that swallowed the panic would also
// give, which is why they are never the only cases.

// A divisor the optimizer cannot fold to a constant: it comes out of a slice
// this function wrote, so `xEmitPow2DivInt`'s compile-time-power-of-two path
// (runtime/ABI.md §12.1) cannot apply and the backend must emit the zero check
// that calls `bit_rt_panic_div_zero`.
fn opaqueZero(): int {
  let zeros = []int(1)
  zeros[0] = 0
  return zeros[0]
}

test "a non-panicking call reports (false, \"\")" {
  let ran = 0
  let (panicked, msg) = runRecovering(() => {
    ran = ran + 1
  })
  assert(ran == 1, "f ran ${ran} times, want 1")
  assert(!panicked, "panicked = true for a call that did not panic")
  assert(msg == "", "msg = \"${msg}\", want \"\"")
}

test "an explicit panic is recovered with its message" {
  let (panicked, msg) = runRecovering(() => {
    panic("boom")
  })
  assert(panicked, "panicked = false for panic(\"boom\")")
  assert(msg == "boom", "msg = \"${msg}\", want \"boom\"")
}

test "an interpolated panic message survives the copy out of the dead frame" {
  // The message is built in the frame the resume discards, so the bytes have to
  // be copied, not referenced. A stale reference would read as anything at all,
  // which is exactly what comparing the whole string catches.
  let id = 4745
  let (panicked, msg) = runRecovering(() => {
    panic("ticket ${id} failed")
  })
  assert(panicked, "panicked = false for an interpolated panic")
  assert(msg == "ticket 4745 failed", "msg = \"${msg}\", want \"ticket 4745 failed\"")
}

test "an index out of range is recovered with the runtime's own message" {
  let xs = []int(2)
  let got = 0
  let (panicked, msg) = runRecovering(() => {
    got = xs[5]
  })
  assert(panicked, "panicked = false for an out-of-range index")
  assert(msg == "index out of range", "msg = \"${msg}\", want \"index out of range\"")
  assert(got == 0, "the panicking assignment stored ${got}")
}

test "a divide by zero is recovered as reason code 1" {
  // The argument-free door (§12.1) carries no message — it must not allocate —
  // so this asserts the literal `runRecovering` maps code 1 to, which is the
  // wording `rootPanicDivZero` writes when nothing is armed.
  let d = opaqueZero()
  let got = 0
  let (panicked, msg) = runRecovering(() => {
    got = 10 / d
  })
  assert(panicked, "panicked = false for 10 / 0")
  assert(
    msg == "integer division by zero",
    "msg = \"${msg}\", want \"integer division by zero\"",
  )
  assert(got == 0, "the panicking division stored ${got}")
}

test "boundaries nest innermost first" {
  let innerPanicked = false
  let innerMsg = ""
  let outerRan = 0
  let (panicked, msg) = runRecovering(() => {
    let (ip, im) = runRecovering(() => {
      panic("inner")
    })
    innerPanicked = ip
    innerMsg = im
    outerRan = outerRan + 1
  })
  assert(innerPanicked, "the inner boundary did not catch its own panic")
  assert(innerMsg == "inner", "inner msg = \"${innerMsg}\", want \"inner\"")
  assert(outerRan == 1, "the outer body ran ${outerRan} times after the inner recovery")
  assert(!panicked, "the outer boundary caught a panic the inner one had taken")
  assert(msg == "", "outer msg = \"${msg}\", want \"\"")
}

test "a panic raised outside an inner boundary reaches the outer one" {
  let innerPanicked = true
  let (panicked, msg) = runRecovering(() => {
    let (ip, _) = runRecovering(() => {

      // quiet
    })
    innerPanicked = ip
    panic("outer")
  })
  assert(!innerPanicked, "the inner boundary reported a panic that never happened")
  assert(panicked, "the outer boundary did not catch a panic raised after the inner one")
  assert(msg == "outer", "msg = \"${msg}\", want \"outer\"")
}

test "a second panic after a recovery is recovered too" {
  // The record and the message buffer are reused between calls: a second panic
  // of the SAME kind overwrites the runtime's static buffer, so a first message
  // that was referenced rather than copied would change here.
  let xs = []int(1)
  let got = 0
  let (firstPanicked, first) = runRecovering(() => {
    got = xs[9]
  })
  let (secondPanicked, second) = runRecovering(() => {
    panic("after")
  })
  let (thirdPanicked, third) = runRecovering(() => {
    got = xs[7]
  })
  assert(firstPanicked && secondPanicked && thirdPanicked, "a later boundary failed to arm")
  assert(first == "index out of range", "first = \"${first}\"")
  assert(second == "after", "second = \"${second}\"")
  assert(third == "index out of range", "third = \"${third}\"")
  assert(got == 0, "a panicking index stored ${got}")
}

test "a boundary can be armed again after the task has used one" {
  // Guards the pop: a taken record left on the task's chain would make the next
  // arm chain onto a dead frame, and this second recovery would not return.
  let (firstPanicked, _) = runRecovering(() => {
    panic("one")
  })
  let ran = 0
  let (secondPanicked, secondMsg) = runRecovering(() => {
    ran = ran + 1
  })
  assert(firstPanicked, "the first boundary did not catch its panic")
  assert(!secondPanicked, "the second call reported a panic that never happened")
  assert(ran == 1, "the second body ran ${ran} times, want 1")
  assert(secondMsg == "", "second msg = \"${secondMsg}\", want \"\"")
}
