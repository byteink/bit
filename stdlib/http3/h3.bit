// Bit standard library — http3 module, the HTTP/3 core (RFC 9114).
//
// This file sits on top of two lower layers already in the tree: the QPACK field
// compressor in this same module (`qpack.bit`) and the QUIC v1 transport in
// `std/quic`. It turns QUIC streams into HTTP/3 requests and responses:
//
//   * **Unidirectional streams.** Each peer opens a *control* stream and the two
//     *QPACK* streams (encoder / decoder). A uni stream announces its purpose by
//     sending a stream-type varint first (control=0x00, push=0x01,
//     qpack-encoder=0x02, qpack-decoder=0x03, RFC 9114 §6.2 / RFC 9204 §4.2).
//     std/quic exposes only *bidirectional* streams (`openStream`), so an HTTP/3
//     uni stream here is a bidi stream the opener only ever writes to; the peer
//     tells a uni stream from a request stream by that leading type byte.
//
//   * **SETTINGS.** Both peers send a SETTINGS frame first thing on their control
//     stream (RFC 9114 §7.2.4). We advertise a zero-capacity QPACK dynamic table
//     (`SETTINGS_QPACK_MAX_TABLE_CAPACITY` = 0, `SETTINGS_QPACK_BLOCKED_STREAMS`
//     = 0); a client additionally sends MAX_PUSH_ID = 0 to forbid server push.
//
//   * **Frames.** Every HTTP/3 frame is a type varint, a length varint, then that
//     many payload bytes (RFC 9114 §7.1): DATA=0x0, HEADERS=0x1, SETTINGS=0x4,
//     GOAWAY=0x7, MAX_PUSH_ID=0xd. Unknown and reserved (grease) types are parsed
//     for their length and skipped, never an error (RFC 9114 §9).
//
//   * **Request / response.** A request is one client-initiated bidi stream: a
//     HEADERS frame (QPACK-encoded `:method` / `:scheme` / `:authority` / `:path`
//     pseudo-headers plus regular headers), then DATA frame(s) for the body, then
//     FIN. A response is symmetric — HEADERS carrying `:status`, then DATA.
//
//   * **QPACK over QUIC.** The encoder's table-mutation instructions go out on the
//     qpack-encoder uni stream and the decoder's acknowledgements on the
//     qpack-decoder uni stream; the peer feeds them back into its `Decoder` /
//     `Encoder`. This core uses a *zero-capacity* dynamic table, so every field
//     line is literal (or a static-table reference) and the Required Insert Count
//     is always 0: the QPACK streams then carry only their type byte, no
//     instruction ever blocks, and no section acknowledgement is required
//     (RFC 9204 §2.2.1). The plumbing (open the streams, emit the type prefix,
//     apply the peer's encoder stream, emit an ack when the capacity is nonzero)
//     is in place so the same code is correct once a capacity is negotiated.
//
// It is one flat module with `qpack.bit`, so it calls that file's helpers
// (`qpackAppendBytes`, the `Encoder`/`Decoder`/`HeaderField` types) directly and
// prefixes its own private free functions `h3` to avoid name collisions. The
// cross-module imports are the QUIC transport (`std/quic`) and the UDP socket
// type for the server entry point (`std/net`).

import { dialQuic, acceptQuic, listenQuic, Listener, Conn, Stream, StreamChunk, encodeVarint } from "std/quic"
import { UdpSocket } from "std/net"
import { monotonic } from "std/time"

// ---------------------------------------------------------------------------
// Wire constants (RFC 9114 §7.1 / §7.2, RFC 9204 §5)
// ---------------------------------------------------------------------------

// Unidirectional stream types (RFC 9114 §6.2 / §11.2.4, RFC 9204 §4.2). Push
// (0x01) is listed for completeness; this core neither sends nor accepts pushes.
const h3StreamControl: int = 0x00
const h3StreamQpackEncoder: int = 0x02
const h3StreamQpackDecoder: int = 0x03

// HTTP/3 frame types (RFC 9114 §7.2 / §11.2.1).
const h3FrameData: int = 0x00
const h3FrameHeaders: int = 0x01
const h3FrameSettings: int = 0x04
const h3FrameGoaway: int = 0x07
const h3FrameMaxPushId: int = 0x0d

// SETTINGS identifiers we send (RFC 9204 §5).
const h3SettingQpackMaxTableCapacity: int = 0x01
const h3SettingQpackBlockedStreams: int = 0x07

// The bound on how many peer streams `accept` will classify before it must have
// found a request stream — the three uni streams plus a generous margin.
const h3AcceptScan: int = 64

// ---------------------------------------------------------------------------
// Public types
// ---------------------------------------------------------------------------

// An HTTP/3 request. `method`/`scheme`/`authority`/`path` become the four
// pseudo-headers (RFC 9114 §4.3.1); `headers` are the regular header fields (all
// lower-case per §4.1.2); `body` is the entity carried in DATA frames.
export struct H3Request {
  export method: string,
  export scheme: string,
  export authority: string,
  export path: string,
  export headers: []HeaderField,
  export body: []byte,
}

// An HTTP/3 response. `status` is the `:status` pseudo-header as an integer;
// `headers` are the regular header fields; `body` is the DATA payload.
export struct H3Response { export status: int, export headers: []HeaderField, export body: []byte }

// An established HTTP/3 connection over one QUIC connection. It owns the QPACK
// `Encoder`/`Decoder` (one of each per connection, per RFC 9204) and the local
// control and QPACK unidirectional streams. Marshal all requests/responses
// through the one `H3Conn`, so the QPACK tables track the peer.
export struct H3Conn {
  conn: Conn,
  enc: Encoder,
  dec: Decoder,
  control: Stream,
  qpackEnc: Stream,
  qpackDec: Stream,
}

// A received request together with the stream it arrived on. `req` is the decoded
// request; the private `stream` is the bidi QUIC stream `respond` answers on.
export struct H3ServerRequest { export req: H3Request, stream: Stream }

// ---------------------------------------------------------------------------
// A varint read cursor (RFC 9000 §16) over an HTTP/3 stream buffer
// ---------------------------------------------------------------------------

// A read cursor over a byte buffer; `pos` advances as varints and frames are
// consumed.
struct h3Reader { data: []byte, pos: int }

// Read one QUIC variable-length integer (RFC 9000 §16): the top two bits of the
// first byte select a 1/2/4/8-byte length, the remaining bits are the high value
// bits. Fails at end of input or on a truncated encoding.
fn h3readVarint(r: h3Reader): u64! {
  if (r.pos >= len(r.data)) {
    fail newError("h3: varint past end of input")
  }
  let first = int(r.data[r.pos])
  let prefix = first >> 6
  let length = 1 << prefix
  if (r.pos + length > len(r.data)) {
    fail newError("h3: truncated varint")
  }
  let v = u64(first & 0x3f)
  let i = 1
  while (i < length) {
    v = (v << u64(8)) | u64(int(r.data[r.pos + i]))
    i = i + 1
  }
  r.pos = r.pos + length
  return v
}

// ---------------------------------------------------------------------------
// Frames (RFC 9114 §7.1)
// ---------------------------------------------------------------------------

// One parsed HTTP/3 frame: its `ftype` and the raw `payload` between the length
// and the next frame.
struct h3Frame { ftype: u64, payload: []byte }

// Encode a frame: type varint, length varint, then the payload bytes.
fn h3frame(ftype: int, payload: []byte): []byte {
  let out = encodeVarint(u64(ftype))
  out = qpackAppendBytes(out, encodeVarint(u64(len(payload))))
  return qpackAppendBytes(out, payload)
}

// Split `data` into its frames. The type and length varints are validated and the
// payload is sliced by the declared length; unknown and reserved (grease) types
// are returned like any other, so a caller skips them simply by ignoring a type
// it does not handle (RFC 9114 §9). Fails on a length that runs past the buffer.
// Bounded by `len(data)`: every iteration consumes at least the two varint bytes.
fn h3parseFrames(data: []byte): []h3Frame! {
  let r = h3Reader{ data: data, pos: 0 }
  let out = []h3Frame(0)
  let guard = 0
  while (r.pos < len(data) && guard <= len(data)) {
    guard = guard + 1
    let ftype = h3readVarint(r)?
    let length = h3readVarint(r)?
    let n = int(length)
    if (n < 0 || r.pos + n > len(data)) {
      fail newError("h3: frame length runs past end of input")
    }
    let payload = data[r.pos:r.pos + n]
    r.pos = r.pos + n
    out = append(out, h3Frame{ ftype: ftype, payload: payload })
  }
  return out
}

// The SETTINGS payload we advertise: a zero-capacity QPACK dynamic table and no
// blocked streams (RFC 9204 §5). Both are 0, so no dynamic-table state is ever
// exchanged and no field section can block.
fn h3settingsPayload(): []byte {
  let out = encodeVarint(u64(h3SettingQpackMaxTableCapacity))
  out = qpackAppendBytes(out, encodeVarint(u64(0)))
  out = qpackAppendBytes(out, encodeVarint(u64(h3SettingQpackBlockedStreams)))
  out = qpackAppendBytes(out, encodeVarint(u64(0)))
  return out
}

// The full initial control-stream write: the control stream-type byte, a SETTINGS
// frame, and — for a client — MAX_PUSH_ID = 0, which forbids server push (only a
// client may send MAX_PUSH_ID, RFC 9114 §7.2.7). Written in one call so it arrives
// as a single stream chunk.
fn h3controlBytes(isClient: bool): []byte {
  let out = encodeVarint(u64(h3StreamControl))
  out = qpackAppendBytes(out, h3frame(h3FrameSettings, h3settingsPayload()))
  if (isClient) {
    out = qpackAppendBytes(out, h3frame(h3FrameMaxPushId, encodeVarint(u64(0))))
  }
  return out
}

// The bytes of `data` after its leading stream-type byte (the QPACK-stream
// instruction bytes). Empty when only the type byte was sent.
fn h3tail(data: []byte): []byte {
  if (len(data) <= 1) {
    return []byte(0)
  }
  return data[1:len(data)]
}

// ---------------------------------------------------------------------------
// Reading whole request/response streams
// ---------------------------------------------------------------------------

// Read the next non-empty chunk of `s`, or the first chunk that carries FIN. Used
// to peek a freshly accepted stream's leading byte without losing an empty
// FIN-only stream. Bounded so a peer that streams empty chunks cannot spin us.
fn h3readFirst(s: Stream): StreamChunk! {
  let guard = 0
  while (guard < 100000) {
    guard = guard + 1
    let chunk = s.read()?
    if (len(chunk.data) > 0 || chunk.fin) {
      return chunk
    }
  }
  fail newError("h3: stream produced no data")
}

// Accumulate `s` to end of stream, seeded with an already-read `first` chunk.
// Bounded by an iteration guard; a well-behaved peer sends FIN.
fn h3readRest(s: Stream, first: StreamChunk): []byte! {
  let buf = qpackAppendBytes([]byte(0), first.data)
  if (first.fin) {
    return buf
  }
  let guard = 0
  while (guard < 1000000) {
    guard = guard + 1
    let chunk = s.read()?
    buf = qpackAppendBytes(buf, chunk.data)
    if (chunk.fin) {
      return buf
    }
  }
  fail newError("h3: stream longer than the read bound")
}

// Accumulate `s` from the start to end of stream. Used to read a full response.
fn h3readAll(s: Stream): []byte! {
  let first = s.read()?
  return h3readRest(s, first)?
}

// Parse a client control stream to validate its framing (SETTINGS, and MAX_PUSH_ID
// from a client), then discard it: a zero-capacity dynamic table needs nothing
// from the peer's SETTINGS, and this core neither pushes nor drives a graceful
// shutdown from a received GOAWAY. Framing errors are tolerated, not fatal.
fn h3drainControl(data: []byte) {
  let frames = h3parseFrames(h3tail(data)) catch e {
    return
  }
  let seen = 0
  while (seen < len(frames)) {
    seen = seen + 1
  }
}

// ---------------------------------------------------------------------------
// Field sections (RFC 9114 §4.2, over QPACK)
// ---------------------------------------------------------------------------

// The request pseudo-headers followed by the regular headers, in the order
// RFC 9114 §4.3.1 requires (all pseudo-headers before any regular header).
fn h3requestFields(req: H3Request): []HeaderField {
  let out = []HeaderField(0)
  out = append(out, HeaderField{ name: ":method", value: req.method, sensitive: false })
  out = append(out, HeaderField{ name: ":scheme", value: req.scheme, sensitive: false })
  out = append(out, HeaderField{ name: ":authority", value: req.authority, sensitive: false })
  out = append(out, HeaderField{ name: ":path", value: req.path, sensitive: false })
  for h of req.headers {
    out = append(out, h)
  }
  return out
}

// The `:status` pseudo-header followed by the regular response headers.
fn h3responseFields(resp: H3Response): []HeaderField {
  let out = []HeaderField(0)
  out = append(out, HeaderField{ name: ":status", value: "${resp.status}", sensitive: false })
  for h of resp.headers {
    out = append(out, h)
  }
  return out
}

// Parse a decimal status string (`:status` is always three ASCII digits).
fn h3parseStatus(s: string): int {
  let b = []byte(s)
  let v = 0
  let i = 0
  while (i < len(b)) {
    let d = int(b[i])
    if (d >= 0x30 && d <= 0x39) {
      v = v * 10 + (d - 0x30)
    }
    i = i + 1
  }
  return v
}

// Emit a Section Acknowledgment on our qpack-decoder stream for `streamId`, but
// only when the dynamic table has a nonzero capacity: a section that referenced no
// dynamic entry (Required Insert Count 0) is never acknowledged (RFC 9204 §4.4.1),
// and this core runs a zero-capacity table, so in practice no ack is sent. The
// call keeps the acknowledgement plumbing correct once a capacity is negotiated.
fn h3maybeAck(c: H3Conn, streamId: int): ()! {
  if (c.dec.capacity() > 0) {
    c.qpackDec.write(c.dec.sectionAck(streamId))?
  }
}

// Decode the frames of a fully-read request stream into an `H3Request`: the first
// HEADERS frame's field section supplies the pseudo- and regular headers, DATA
// frames concatenate into the body, and any other frame type is ignored.
fn h3parseRequest(c: H3Conn, sid: int, buf: []byte): H3Request! {
  let frames = h3parseFrames(buf)?
  let method = ""
  let scheme = ""
  let authority = ""
  let path = ""
  let headers = []HeaderField(0)
  let body = []byte(0)
  let sawHeaders = false
  for f of frames {
    if (int(f.ftype) == h3FrameHeaders && !sawHeaders) {
      sawHeaders = true
      let fields = c.dec.decodeFieldSection(f.payload)?
      h3maybeAck(c, sid)?
      for hf of fields {
        if (hf.name == ":method") {
          method = hf.value
        } else if (hf.name == ":scheme") {
          scheme = hf.value
        } else if (hf.name == ":authority") {
          authority = hf.value
        } else if (hf.name == ":path") {
          path = hf.value
        } else {
          headers = append(headers, hf)
        }
      }
    } else if (int(f.ftype) == h3FrameData) {
      body = qpackAppendBytes(body, f.payload)
    }
  }
  return H3Request{
    method: method,
    scheme: scheme,
    authority: authority,
    path: path,
    headers: headers,
    body: body,
  }
}

// Decode the frames of a fully-read response stream into an `H3Response`.
fn h3parseResponse(c: H3Conn, sid: int, buf: []byte): H3Response! {
  let frames = h3parseFrames(buf)?
  let status = 0
  let headers = []HeaderField(0)
  let body = []byte(0)
  let sawHeaders = false
  for f of frames {
    if (int(f.ftype) == h3FrameHeaders && !sawHeaders) {
      sawHeaders = true
      let fields = c.dec.decodeFieldSection(f.payload)?
      h3maybeAck(c, sid)?
      for hf of fields {
        if (hf.name == ":status") {
          status = h3parseStatus(hf.value)
        } else {
          headers = append(headers, hf)
        }
      }
    } else if (int(f.ftype) == h3FrameData) {
      body = qpackAppendBytes(body, f.payload)
    }
  }
  return H3Response{ status: status, headers: headers, body: body }
}

// ---------------------------------------------------------------------------
// Connection setup
// ---------------------------------------------------------------------------

// Build an `H3Conn` over an established QUIC connection: open the control and the
// two QPACK unidirectional streams and send each one's stream-type prefix (plus
// SETTINGS on the control stream) before any request, as RFC 9114 §6.2 requires.
fn h3newConn(conn: Conn, isClient: bool): H3Conn! {
  let control = conn.openStream()?
  control.write(h3controlBytes(isClient))?
  let qpackEnc = conn.openStream()?
  qpackEnc.write(encodeVarint(u64(h3StreamQpackEncoder)))?
  let qpackDec = conn.openStream()?
  qpackDec.write(encodeVarint(u64(h3StreamQpackDecoder)))?
  return H3Conn{
    conn: conn,
    enc: newEncoderConfig(0, true),
    dec: newDecoderConfig(0),
    control: control,
    qpackEnc: qpackEnc,
    qpackDec: qpackDec,
  }
}

// Dial an HTTP/3 server at `host:port` (validating its certificate for
// `serverName`), complete the QUIC handshake, and set up the HTTP/3 control and
// QPACK streams. The returned `H3Conn` is ready for `request`.
export fn h3Dial(host: string, port: int, serverName: string): H3Conn! {
  let conn = dialQuic(host, port, serverName)?
  return h3newConn(conn, true)?
}

// As `h3Dial`, bounded by `deadlineNs` — an ABSOLUTE monotonic nanosecond
// deadline (`monotonic() + budget`, not a duration), matching the shape
// std/net's `dialDeadline` and std/tls's `dialDeadline` already use (#2995).
//
// The QUIC handshake itself is NOT shortened by `deadlineNs`: `dialQuic`
// already bounds a stalled handshake at a fixed 5s regardless of caller
// (`quicconn`'s own abandoned-handshake timer, `quicconnHandshakeTimeout` in
// stdlib/quic/conn.bit — there is no smaller per-call knob for it today), so
// a caller asking for a shorter budget against a peer whose handshake never
// completes still waits up to that fixed ceiling before this call fails.
// This is a known, deliberate gap (#3004) rather than an oversight — closing
// it needs a second, handshake-scoped deadline argument threaded through
// `dialQuic`, which is out of this ticket's scope.
//
// Once the handshake succeeds, this connection's own idle timeout (RFC 9000
// §10.1, `Conn.setIdleTimeout`) is lowered from its 30s default to whatever
// budget remains, so a peer that completes the handshake and then never
// answers is torn down — and every green thread parked on it released via
// `quicconnReleaseWaiters` — within `deadlineNs`, rather than the default
// 30s. Fails immediately, without dialing further, if `deadlineNs` has
// already elapsed by the time the handshake completes.
export fn h3DialDeadline(host: string, port: int, serverName: string, deadlineNs: int): H3Conn! {
  let conn = dialQuic(host, port, serverName)?
  let remaining = deadlineNs - monotonic()
  if (remaining <= 0) {
    conn.close()
    fail newError("h3: dial ${host}:${port} timed out")
  }
  conn.setIdleTimeout(remaining)
  return h3newConn(conn, true)?
}

// Accept one HTTP/3 connection on the bound UDP socket `sock`, using the PEM
// certificate chain and private key for the QUIC-TLS handshake, and set up the
// control and QPACK streams. The returned `H3Conn` is ready for `accept`. Serves
// a single connection; use `h3Listen` for a multi-connection server.
export fn h3Accept(sock: UdpSocket, certChainPem: string, keyPem: string): H3Conn! {
  let conn = acceptQuic(sock, certChainPem, keyPem)?
  return h3newConn(conn, false)?
}

// An HTTP/3 server listener over a QUIC `Listener`: many client connections on
// one bound UDP socket, demultiplexed by connection id.
export struct H3Listener { lst: Listener }

// Start an HTTP/3 listener on the bound UDP socket `sock` with the PEM
// certificate chain and private key. Returns immediately; each established
// connection is handed back by `accept`, ready for its own `accept`/`respond`
// loop (run each on its own green thread).
export fn h3Listen(sock: UdpSocket, certChainPem: string, keyPem: string): H3Listener! {
  return H3Listener{ lst: listenQuic(sock, certChainPem, keyPem)? }
}

// Accept the next HTTP/3 connection, blocking until a client completes its
// handshake, and set up its control and QPACK streams.
export fn (l: H3Listener) accept(): H3Conn! {
  let conn = l.lst.accept()?
  return h3newConn(conn, false)?
}

// ---------------------------------------------------------------------------
// Client request / response
// ---------------------------------------------------------------------------

// Send `req` and read the response. Opens a client-initiated bidirectional stream,
// writes a HEADERS frame (a QPACK field section of the pseudo- and regular
// headers) then a DATA frame for the body if any, finishes the send half, and
// reads the response HEADERS + DATA back off the same stream.
export fn (c: H3Conn) request(req: H3Request): H3Response! {
  let s = c.conn.openStream()?
  let sid = s.id()
  let section = c.enc.encodeFieldSection(sid, c.enc.insertCount(), h3requestFields(req))
  let out = h3frame(h3FrameHeaders, section)
  if (len(req.body) > 0) {
    out = qpackAppendBytes(out, h3frame(h3FrameData, req.body))
  }
  s.write(out)?
  s.finish()?
  let buf = h3readAll(s)?
  return h3parseResponse(c, sid, buf)?
}

// ---------------------------------------------------------------------------
// Server accept / respond
// ---------------------------------------------------------------------------

// Accept the next request. Peer-initiated streams are classified by their leading
// byte: a control stream (0x00), qpack-encoder stream (0x02) and qpack-decoder
// stream (0x03) are consumed into the QPACK state and skipped; the first stream
// that is none of these is a request stream (its HEADERS frame type, 0x01), which
// is read to completion, decoded, and returned. Blocks until such a stream opens.
export fn (c: H3Conn) accept(): H3ServerRequest! {
  let guard = 0
  while (guard < h3AcceptScan) {
    guard = guard + 1
    let s = c.conn.acceptStream()?
    let first = h3readFirst(s)?
    if (len(first.data) > 0) {
      let t = int(first.data[0])
      if (t == h3StreamControl) {
        h3drainControl(first.data)
      } else if (t == h3StreamQpackEncoder) {
        c.dec.applyEncoderStream(h3tail(first.data))?
      } else if (t == h3StreamQpackDecoder) {
        c.enc.applyDecoderStream(h3tail(first.data))?
      } else {
        let buf = h3readRest(s, first)?
        let req = h3parseRequest(c, s.id(), buf)?
        return H3ServerRequest{ req: req, stream: s }
      }
    }
  }
  fail newError("h3: no request stream within the accept scan bound")
}

// Answer the request in `sr` with `resp` on its stream: a HEADERS frame carrying
// the `:status` field section, then a DATA frame for the body if any, then FIN.
export fn (c: H3Conn) respond(sr: H3ServerRequest, resp: H3Response): ()! {
  let sid = sr.stream.id()
  let section = c.enc.encodeFieldSection(sid, c.enc.insertCount(), h3responseFields(resp))
  let out = h3frame(h3FrameHeaders, section)
  if (len(resp.body) > 0) {
    out = qpackAppendBytes(out, h3frame(h3FrameData, resp.body))
  }
  sr.stream.write(out)?
  sr.stream.finish()?
}

// Best-effort GOAWAY on the control stream (RFC 9114 §5.2), ignoring a write error
// on an already-closing connection.
fn h3sendGoaway(c: H3Conn) {
  c.control.write(h3frame(h3FrameGoaway, encodeVarint(u64(0)))) catch e {
    return
  }
}

// Close the connection: send a GOAWAY, then tear down the underlying QUIC
// connection and its socket.
export fn (c: H3Conn) close() {
  h3sendGoaway(c)
  c.conn.close()
}
