// stdlib/http3/control.test.bit — the peer's control stream is read for the
// connection's life (control.bit, #7736; RFC 9114 §6.2.1, §7.2, §8.1).
//
// The frame tests drive `h3controlFeed` directly: split deliveries, a skipped
// frame far larger than anything buffered, and each frame that closes the
// connection. The loopback tests run a real client and server `H3Conn` over QUIC:
// the server floods its control stream with more reserved-type bytes than the
// connection window (32768, `quicconnFlowWindow`) and then sends GOAWAY; the
// client's `controlRead` counts every byte it took, and the GOAWAY behind the
// flood is only reachable once the credit of the bytes before it came back.
// A finished control stream is H3_CLOSED_CRITICAL_STREAM.
//
// `udpBind`, `decodeHex`, `pemEncode`, `emptyTrustStore` are new to this module's
// imports; `h3Accept`, `h3DialTls`, `monotonic`, `TlsConfig` are siblings (SPEC §19).
import { udpBind } from "std/net"
import { decodeHex, pemEncode } from "std/crypto"
import { emptyTrustStore } from "std/tls"
import { sleep, Millisecond } from "std/time"

const h3cLeafHex: string = ""
const h3cKeyHex: string = ""

fn h3cPem(label: string, h: string): string {
  let der = decodeHex(h) catch _ {
    return ""
  }
  return pemEncode(label, der)
}

fn h3cClientConfig(): TlsConfig {
  let cfg = TlsConfig(emptyTrustStore())
  cfg.insecureSkipVerify = true
  return cfg
}

// A frame of type `ft` with `n` payload bytes.
fn h3cFrame(ft: int, n: int): []byte {
  return h3frame(ft, []byte(n))
}

fn h3cSettings(): []byte {
  return h3frame(h3FrameSettings, h3settingsPayload())
}

fn h3cGoaway(id: int): []byte {
  return h3frame(h3FrameGoaway, encodeVarint(u64(id)))
}

// `a` then `b` in a new slice: `append` grows its operand in place here, so
// concatenating onto a shared `a` would lengthen it for every later reader.
fn h3cCat(a: []byte, b: []byte): []byte {
  return qpackAppendBytes(qpackAppendBytes([]byte(0), a), b)
}

test "SETTINGS then GOAWAY, delivered a byte at a time, is parsed" {
  let st = h3newControl(true)
  let wire = h3cCat(h3cSettings(), h3cGoaway(8))
  let i = 0
  while (i < len(wire)) {
    assert(h3controlFeed(st, wire[i:i + 1]) == 0, "byte ${i}")
    i = i + 1
  }
  assert(st.settings, "settings seen")
  assert(st.goaway, "goaway seen")
  assert(len(st.buf) == 0, "nothing left buffered: ${len(st.buf)}")
}

test "an unknown frame far larger than the buffer is skipped without being held" {
  let st = h3newControl(true)
  assert(h3controlFeed(st, h3cSettings()) == 0, "settings")
  // A reserved type (0x21) declaring a 1 GiB payload, then 1000 bytes of it.
  let head = h3cCat(encodeVarint(u64(0x21)), encodeVarint(u64(1 << 30)))
  assert(h3controlFeed(st, head) == 0, "header")
  assert(h3controlFeed(st, []byte(1000)) == 0, "payload")
  assert(len(st.buf) == 0, "payload not buffered: ${len(st.buf)}")
  assert(st.skip == (1 << 30) - 1000, "skip counts down: ${st.skip}")
  assert(!st.goaway, "no goaway")
}

test "frames after a skipped one still parse, GOAWAY included" {
  let st = h3newControl(true)
  let wire = h3cCat(h3cSettings(), h3cFrame(0x21, 40))
  wire = h3cCat(wire, h3cFrame(h3FrameMaxPushId + 0x1000, 0))
  wire = h3cCat(wire, h3cGoaway(4))
  assert(h3controlFeed(st, wire) == 0, "feed")
  assert(st.goaway, "goaway after the skipped frames")
}

test "the frames that are not allowed on a control stream close the connection" {
  let first = h3cSettings()
  assert(
    h3controlFeed(h3newControl(true), h3cGoaway(4)) == h3ErrMissingSettings,
    "no SETTINGS first",
  )
  assert(
    h3controlFeed(h3newControl(true), h3cFrame(h3FrameData, 1)) == h3ErrMissingSettings,
    "DATA first",
  )
  let st = h3newControl(true)
  assert(h3controlFeed(st, first) == 0, "settings")
  assert(h3controlFeed(st, first) == h3ErrFrameUnexpected, "second SETTINGS")
  let st2 = h3newControl(true)
  assert(
    h3controlFeed(st2, h3cCat(first, h3cFrame(h3FrameHeaders, 1))) == h3ErrFrameUnexpected,
    "HEADERS",
  )
  let st3 = h3newControl(false)
  assert(
    h3controlFeed(st3, h3cCat(first, h3cFrame(0x06, 0))) == h3ErrFrameUnexpected,
    "reserved HTTP/2 PING",
  )
  let st4 = h3newControl(true)
  let mpi = h3frame(h3FrameMaxPushId, encodeVarint(u64(0)))
  assert(
    h3controlFeed(st4, h3cCat(first, mpi)) == h3ErrFrameUnexpected,
    "MAX_PUSH_ID sent to a client",
  )
  let st5 = h3newControl(false)
  assert(h3controlFeed(st5, h3cCat(first, mpi)) == 0, "MAX_PUSH_ID sent to a server")
  let st6 = h3newControl(true)
  assert(
    h3controlFeed(st6, h3cCat(first, h3frame(h3FrameGoaway, []byte(9)))) == h3ErrFrame,
    "GOAWAY too long",
  )
  let dup = h3frame(h3FrameSettings, h3cCat(h3settingsPayload(), h3settingsPayload()))
  assert(h3controlFeed(h3newControl(true), dup) == h3ErrSettings, "repeated setting")
}

fn h3cServe(sock: UdpSocket, flood: int, doneCh: chan<int>, holdCh: chan<int>) {
  let srv = h3Accept(sock, h3cPem("CERTIFICATE", h3cLeafHex), h3cPem("PRIVATE KEY", h3cKeyHex)) catch _ {
    doneCh <- -1
    return
  }
  let sent = len(h3controlBytes(false))
  let left = flood
  while (left > 0) {
    let n = 1000
    if (left < n) {
      n = left
    }
    let f = h3cFrame(0x21, n)
    srv.control.write(f) catch _ {
      doneCh <- -1
      return
    }
    sent = sent + len(f)
    left = left - len(f)
  }
  let g = h3cGoaway(0)
  srv.control.write(g) catch _ {
    doneCh <- -1
    return
  }
  doneCh <- sent + len(g)
  // Hold the connection open until the test ends it.
  <- holdCh
}

// Waits up to two seconds for `done` to hold.
fn h3cWait(done: () => bool): bool {
  let i = 0
  while (i < 200) {
    if (done()) {
      return true
    }
    sleep(10 * Millisecond)
    i = i + 1
  }
  return done()
}

test "a flood of control-stream bytes past the connection window is read, and the GOAWAY behind it is honoured" {
  let sock = udpBind("127.0.0.1", 0) catch _ {
    assert(false, "udpBind")
    return
  }
  let port = sock.port() catch _ {
    assert(false, "port")
    return
  }
  let doneCh = chan<int>(2)
  let holdCh = chan<int>(1)
  spawn h3cServe(sock, 40000, doneCh, holdCh)
  let cl = h3DialTls("127.0.0.1", port, "localhost", h3cClientConfig()) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  cl.watchPeer()
  let sent = <- doneCh
  assert(sent > 40000, "server wrote ${sent}")
  assert(h3cWait(() => cl.peerGoaway), "client saw GOAWAY")
  assert(!cl.reusable(), "a connection with a peer GOAWAY is not reusable")
  assert(cl.controlRead == sent, "client read ${cl.controlRead} of ${sent} control bytes")
  println("control bytes sent=${sent} read=${cl.controlRead} window=32768")
  holdCh <- 0
  cl.close()
}

fn h3cServeFin(sock: UdpSocket, doneCh: chan<int>) {
  let srv = h3Accept(sock, h3cPem("CERTIFICATE", h3cLeafHex), h3cPem("PRIVATE KEY", h3cKeyHex)) catch _ {
    doneCh <- -1
    return
  }
  srv.control.finish() catch _ {
    doneCh <- -2
    return
  }
  doneCh <- 0
}

test "the peer finishing its control stream closes the connection" {
  let sock = udpBind("127.0.0.1", 0) catch _ {
    assert(false, "udpBind")
    return
  }
  let port = sock.port() catch _ {
    assert(false, "port")
    return
  }
  let doneCh = chan<int>(2)
  spawn h3cServeFin(sock, doneCh)
  let cl = h3DialTls("127.0.0.1", port, "localhost", h3cClientConfig()) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  cl.watchPeer()
  assert(h3cWait(() => cl.gone), "client connection closed after the peer's FIN on control")
  assert(!cl.reusable(), "not reusable")
  cl.close()
}
