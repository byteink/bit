// Bit standard library — http3 module, watching the peer of a shared client
// connection (#7688). Same flat `std/http3` module and namespace as `h3.bit`.

// What `H3Conn.request` fails with when no request stream could be opened: the
// QUIC connection was already closed or the peer's stream limit (RFC 9000 §4.6,
// initial_max_streams_bidi / MAX_STREAMS) was reached. Nothing was written, so
// the request may be repeated on another connection whatever its method.
export class H3Unsent {
  export cause: error

  export message(): string {
    return this.cause.message()
  }
}

// How many peer-initiated streams the watcher classifies: the peer's control
// and two QPACK streams plus a margin, as `h3AcceptScan` does for a server.
const h3WatchStreams: int = 16

// Accepts the peer's streams for the life of the connection and watches its
// control stream (`h3watchControl`); sets `gone` when the connection ends.
fn h3watchPeer(c: H3Conn) {
  let guard = 0
  while (guard < h3WatchStreams) {
    guard = guard + 1
    let s = c.conn.acceptStream() catch _ {
      c.gone = true
      return
    }
    spawn h3watchControl(c, s)
  }
}

// Reads `s` for the life of the connection if it is the peer's control stream
// (`h3controlRun`: GOAWAY sets `peerGoaway`, every byte is read so none holds
// connection credit); any other peer stream (the QPACK streams, which a
// zero-capacity table never fills) is left alone.
fn h3watchControl(c: H3Conn, s: Stream) {
  let first = h3readFirst(s) catch _ {
    return
  }
  if (len(first.data) == 0 || int(first.data[0]) != h3StreamControl) {
    return
  }
  if (h3claimControl(c)) {
    h3controlRun(c, s, first)
  }
}
