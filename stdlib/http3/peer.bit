// Bit standard library — http3 module, watching the peer of a shared client
// connection (#7688). Same flat `std/http3` module and namespace as `h3.bit`.

// What `H3Conn.request` fails with when no request stream could be opened: the
// QUIC connection was already closed or the peer's stream limit (RFC 9000 §4.6,
// initial_max_streams_bidi / MAX_STREAMS) was reached. Nothing was written, so
// the request may be repeated on another connection whatever its method.
export class H3Unsent {
  export cause: error

  export message(): string {
    return this.cause.message()
  }
}

// How many peer-initiated streams the watcher classifies: the peer's control
// and two QPACK streams plus a margin, as `h3AcceptScan` does for a server.
const h3WatchStreams: int = 16

// Chunks of a peer's control stream read before the watcher gives up on it; the
// control stream carries SETTINGS and, at most, one GOAWAY per shutdown.
const h3WatchChunks: int = 256

// Whether `data`, the control-stream bytes received so far (after the stream
// type byte), holds a GOAWAY frame header (RFC 9114 §7.2.6). A frame cut off by
// the end of `data` ends the scan rather than failing it: more bytes follow.
// Bounded by `len(data)`: every turn consumes at least the two varint bytes.
fn h3hasGoaway(data: []byte): bool {
  let r = h3Reader{ data = data, pos = 0 }
  let guard = 0
  while (r.pos < len(data) && guard <= len(data)) {
    guard = guard + 1
    let ftype = h3readVarint(r) catch _ {
      return false
    }
    let length = h3readVarint(r) catch _ {
      return false
    }
    if (int(ftype) == h3FrameGoaway) {
      return true
    }
    let n = int(length)
    if (n < 0 || r.pos + n > len(data)) {
      return false
    }
    r.pos = r.pos + n
  }
  return false
}

// Accepts the peer's streams for the life of the connection and watches its
// control stream (`h3watchControl`); sets `gone` when the connection ends.
fn h3watchPeer(c: H3Conn) {
  let guard = 0
  while (guard < h3WatchStreams) {
    guard = guard + 1
    let s = c.conn.acceptStream() catch _ {
      c.gone = true
      return
    }
    spawn h3watchControl(c, s)
  }
}

// Reads `s` if it is the peer's control stream and sets `peerGoaway` when a
// GOAWAY arrives; any other peer stream (the QPACK streams, which a zero-capacity
// table never fills) is left alone.
fn h3watchControl(c: H3Conn, s: Stream) {
  let first = h3readFirst(s) catch _ {
    return
  }
  if (len(first.data) == 0 || int(first.data[0]) != h3StreamControl) {
    return
  }
  let buf = h3tail(first.data)
  let last = first
  let guard = 0
  while (guard < h3WatchChunks) {
    guard = guard + 1
    if (h3hasGoaway(buf)) {
      c.peerGoaway = true
      return
    }
    if (last.fin || last.reset) {
      return
    }
    last = s.read() catch _ {
      return
    }
    buf = qpackAppendBytes(buf, last.data)
  }
}
