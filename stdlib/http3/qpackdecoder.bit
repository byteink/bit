// Bit standard library — http3 module, QPACK decoder (RFC 9204 §4.4, §4.5).

// ---------------------------------------------------------------------------
// Decoder
// ---------------------------------------------------------------------------

// A stateful QPACK decoder. It owns its dynamic table and enforces a `limit` —
// the largest capacity it will accept from a Set Dynamic Table Capacity
// instruction, i.e. the value it advertised. `applyEncoderStream` mutates the
// table; `decodeFieldSection` reconstructs a header list (blocking if it needs
// inserts not yet applied); `sectionAck`/`streamCancel`/`insertCountIncrement`
// produce the decoder-stream bytes to send back. Reuse one decoder per
// connection so its table tracks the peer encoder.
//
// `Decoder()` starts with no dynamic table, willing to accept a capacity up to
// the 4096-byte default; `limit` replaces that ceiling, and a Set Dynamic Table
// Capacity above it is rejected.
export class Decoder {
  table: qpackTable
  limit: int

  init(limit: int = qpackDefaultCapacity) {
    this.table = qpackNewTable(0)
    this.limit = limit
  }

  // Apply the encoder-stream instructions in `data` (§4.3), mutating the dynamic
  // table, and return the resulting insert count. Fails on a malformed
  // instruction, a bad index, or a capacity over the decoder's limit.
  export applyEncoderStream(data: []byte): int! {
    let r = qpackReader{ data = data, pos = 0 }
    let guard = 0
    while (r.pos < len(data) && guard <= len(data)) {
      qpackDecoderStep(this, r)?
      guard = guard + 1
    }
    return this.table.insertCount
  }

  // Decode one encoded field section (§4.5) into its header fields. Reads the
  // prefix to recover the Required Insert Count and Base, fails ("blocked") if the
  // section needs insertions not yet applied, then decodes each field line. Fails
  // on any malformed representation or out-of-range index.
  export decodeFieldSection(data: []byte): []HeaderField! {
    return qpackDecodeSection(this, data)?.fields
  }

  // Emit a Section Acknowledgment for `streamId` (§4.4.1).
  export sectionAck(streamId: int): []byte {
    return qpackPutInteger([]byte(0), 7, 0x80, streamId)
  }

  // Emit a Stream Cancellation for `streamId` (§4.4.2).
  export streamCancel(streamId: int): []byte {
    return qpackPutInteger([]byte(0), 6, 0x40, streamId)
  }

  // Emit an Insert Count Increment of `n` (§4.4.3).
  export insertCountIncrement(n: int): []byte {
    return qpackPutInteger([]byte(0), 6, 0x00, n)
  }

  // The number of insertions the decoder has processed (the next absolute index).
  export insertCount(): int {
    return this.table.insertCount
  }

  // The current byte size of the decoder's dynamic table.
  export tableSize(): int {
    return this.table.size
  }

  // The number of live entries in the decoder's dynamic table.
  export tableCount(): int {
    return len(this.table.entries)
  }

  // The current dynamic-table capacity in bytes.
  export capacity(): int {
    return this.table.capacity
  }
}

// The fields of one decoded section and the Required Insert Count it carried (0
// when it referenced no dynamic entry): the caller acknowledges a section only
// when `ric` is above zero (§4.4.1).
class qpackDecoded { fields: []HeaderField, ric: int }

// Decode one encoded field section (§4.5) into its header fields. Reads the
// prefix to recover the Required Insert Count and Base, fails ("blocked") if the
// section needs insertions not yet applied, then decodes each field line. Fails
// on any malformed representation or out-of-range index. The Required Insert Count
// wraps modulo twice the entries of the capacity this decoder advertised (`limit`),
// not of the table's current capacity, which the encoder may have set lower
// (§4.5.1.1).
fn qpackDecodeSection(d: Decoder, data: []byte): qpackDecoded! {
  let r = qpackReader{ data = data, pos = 0 }
  let firstRic = qpackReadByte(r)?
  let enc = qpackGetInteger(r, 8, firstRic)?
  let ric = qpackDecodeRIC(enc, d.table.insertCount, qpackMaxEntries(d.limit))?
  if (ric > d.table.insertCount) {
    fail newError("qpack: section blocked, needs insert count ${ric}")
  }
  let firstBase = qpackReadByte(r)?
  let negative = (firstBase & 0x80) != 0
  let delta = qpackGetInteger(r, 7, firstBase)?
  let base = ric + delta
  if (negative) {
    base = ric - delta - 1
  }
  if (base < 0) {
    fail newError("qpack: negative base")
  }
  let out = []HeaderField(0)
  let guard = 0
  while (r.pos < len(data) && guard <= len(data)) {
    out = append(out, qpackDecodeLine(d, r, base)?)
    guard = guard + 1
  }
  return qpackDecoded{ fields = out, ric = ric }
}

// Apply the one encoder-stream instruction at `r` (§4.3). The table changes only
// once the whole instruction has parsed, so an instruction cut short by the end of
// `r.data` (`qpackShort`) leaves it untouched.
fn qpackDecoderStep(d: Decoder, r: qpackReader): ()! {
  let b = qpackReadByte(r)?
  if ((b & 0x80) != 0) {
    qpackDecodeInsertNameRef(d, r, b)?
    return
  }
  if ((b & 0x40) != 0) {
    let name = string(qpackGetNameLiteral(r, b, 5, 0x20)?)
    let value = string(qpackGetString(r)?)
    qpackTableInsert(d.table, name, value)?
    return
  }
  if ((b & 0x20) != 0) {
    let newCap = qpackGetInteger(r, 5, b)?
    if (newCap > d.limit) {
      fail newError("qpack: capacity ${newCap} exceeds limit ${d.limit}")
    }
    qpackTableSetCapacity(d.table, newCap)
    return
  }
  let relIndex = qpackGetInteger(r, 5, b)?
  let en = qpackTableGetAbs(d.table, d.table.insertCount - relIndex - 1)?
  qpackTableInsert(d.table, en.name, en.value)?
}

// Apply the whole instructions at the front of `data` (the next bytes of the peer's
// encoder stream) and return how many bytes they took; an instruction cut short by
// the end of `data` is left for the caller to retry once more bytes arrive. Fails
// on a malformed instruction, a bad index, or a capacity over the decoder's limit.
fn qpackDecoderFeed(d: Decoder, data: []byte): int! {
  let r = qpackReader{ data = data, pos = 0 }
  let used = 0
  let guard = 0
  while (r.pos < len(data) && guard <= len(data)) {
    guard = guard + 1
    qpackDecoderStep(d, r) catch e {
      let (_, short) = e.(qpackShort)
      if (short) {
        return used
      }
      fail e
    }
    used = r.pos
  }
  return used
}

// Apply one Insert With Name Reference instruction (§4.3.2). `first` is the
// consumed instruction octet; the T bit selects static vs a dynamic index
// relative to the current insert count.
fn qpackDecodeInsertNameRef(d: Decoder, r: qpackReader, first: int): ()! {
  let isStatic = (first & 0x40) != 0
  let index = qpackGetInteger(r, 6, first)?
  let value = string(qpackGetString(r)?)
  let name = ""
  if (isStatic) {
    if (index < 0 || index >= qpackStaticLen) {
      fail newError("qpack: static name index ${index} out of range")
    }
    name = qpackStaticTable()[index].name
  } else {
    let abs = d.table.insertCount - index - 1
    name = qpackTableGetAbs(d.table, abs)?.name
  }
  qpackTableInsert(d.table, name, value)?
}

// Decode one field line at `r` against `base`.
fn qpackDecodeLine(d: Decoder, r: qpackReader, base: int): HeaderField! {
  let b = qpackReadByte(r)?
  if ((b & 0x80) != 0) {
    // Indexed Field Line (§4.5.2): static, or dynamic relative to Base.
    let isStatic = (b & 0x40) != 0
    let index = qpackGetInteger(r, 6, b)?
    let en = qpackResolveIndex(d, isStatic, index, base)?
    return HeaderField{ name = en.name, value = en.value, sensitive = false }
  }
  if ((b & 0x40) != 0) {
    // Literal Field Line With Name Reference (§4.5.4): static or dynamic name.
    let sensitive = (b & 0x20) != 0
    let isStatic = (b & 0x10) != 0
    let index = qpackGetInteger(r, 4, b)?
    let en = qpackResolveIndex(d, isStatic, index, base)?
    let value = string(qpackGetString(r)?)
    return HeaderField{ name = en.name, value = value, sensitive = sensitive }
  }
  if ((b & 0x20) != 0) {
    // Literal Field Line With Literal Name (§4.5.6).
    let sensitive = (b & 0x10) != 0
    let name = string(qpackGetNameLiteral(r, b, 3, 0x08)?)
    let value = string(qpackGetString(r)?)
    return HeaderField{ name = name, value = value, sensitive = sensitive }
  }
  if ((b & 0x10) != 0) {
    // Indexed Field Line With Post-Base Index (§4.5.3).
    let index = qpackGetInteger(r, 4, b)?
    let en = qpackTableGetAbs(d.table, base + index)?
    return HeaderField{ name = en.name, value = en.value, sensitive = false }
  }
  if ((b & 0x08) != 0) {
    // Literal Field Line With Post-Base Name Reference (§4.5.5).
    let sensitive = (b & 0x04) != 0
    let index = qpackGetInteger(r, 3, b)?
    let en = qpackTableGetAbs(d.table, base + index)?
    let value = string(qpackGetString(r)?)
    return HeaderField{ name = en.name, value = value, sensitive = sensitive }
  }
  fail newError("qpack: unknown field line representation")
}

// Resolve a static or pre-base dynamic index to its entry. A dynamic `index` is
// relative to `base`: absolute index = base - index - 1. Shared by the Indexed
// Field Line and the Literal Field Line With Name Reference, which use the same
// relative arithmetic.
fn qpackResolveIndex(d: Decoder, isStatic: bool, index: int, base: int): qpackEntry! {
  if (isStatic) {
    if (index < 0 || index >= qpackStaticLen) {
      fail newError("qpack: static index ${index} out of range")
    }
    return qpackStaticTable()[index]
  }
  return qpackTableGetAbs(d.table, base - index - 1)?
}

