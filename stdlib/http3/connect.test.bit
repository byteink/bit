import { after, Second, Timer } from "std/time"

// RFC 9220 extended CONNECT settings, malformed requests and real QUIC tunnels.
fn h3tReq(): H3Request {
  return H3Request{
    method = "CONNECT", scheme = "https", authority = "localhost", path = "/echo",
    protocol = "websocket",
  }
}

test "extended CONNECT settings advertise opt-in and reject illegal values" {
  assert(!h3connectSetting(h3settingsPayload()), "disabled by default")
  assert(h3connectSetting(h3settingsPayload(true)), "server advertises setting 0x08")
  let st = h3newControl(true)
  assert(h3controlFeed(st, h3frame(h3FrameSettings, h3settingsPayload(true))) == 0, "valid setting")
  assert(st.connectProtocol, "client records advertisement")
  for v of []u64{ 2, 4611686018427387903 } {
    let payload = qpackAppendBytes(encodeVarint(u64(8)), encodeVarint(v))
    assert(h3checkSettings(payload) == h3ErrSettings, "invalid setting ${v}")
  }
}

fn h3tMalformed(req: H3Request): bool {
  h3fieldsRequest(h3requestFields(req)) catch _ {
    return true
  }
  return false
}

test "extended CONNECT requires CONNECT scheme path authority and a single protocol" {
  let req = h3tReq()
  assert(!h3tMalformed(req), "valid extended CONNECT")
  req.method = "GET"
  assert(h3tMalformed(req), "protocol requires CONNECT")
  req.method = "CONNECT"
  req.scheme = ""
  assert(h3tMalformed(req), "scheme required")
  req.scheme = "https"
  req.path = ""
  assert(h3tMalformed(req), "path required")
  req.path = "/"
  req.authority = ""
  assert(h3tMalformed(req), "authority required")
  let fields = h3requestFields(h3tReq())
  fields = append(fields, HeaderField{ name = ":protocol", value = "websocket" })
  h3fieldsRequest(fields) catch _ {
    return
  }
  assert(false, "duplicate protocol accepted")
}

fn h3tServer(sock: UdpSocket, ready: chan<H3Conn>, done: chan<string>, enable: bool) {
  let c = h3Accept(
    sock,
    h3cPem("CERTIFICATE", h3cLeafHex),
    h3cPem("PRIVATE KEY", h3cKeyHex),
    enable,
  ) catch e {
    done <- e.message()
    return
  }
  ready <- c
  h3tEcho(c) catch e {
    done <- e.message()
    return
  }
  done <- "ok"
}

fn h3tEcho(c: H3Conn): ()! {
  let sr = c.accept()?
  let t = sr.acceptExtendedConnect()?
  let data = t.read(3)?
  let rest = t.read(100)?
  t.write(data + rest)?
  assert(t.read(1)? == "", "peer clean FIN")
  t.close()?
  let next = c.accept()?
  c.respond(next, H3Response{ status = 200, body = []byte("still open") })?
}

fn h3tRoundTrip(): ()! {
  let sock = udpBind("127.0.0.1", 0)?
  defer sock.close()
  let port = sock.port()?
  let ready = chan<H3Conn>(1)
  let done = chan<string>(1)
  spawn h3tServer(sock, ready, done, true)
  let client = h3DialTls("127.0.0.1", port, "localhost", h3cClientConfig())?
  defer client.close()
  let server = <- ready
  defer server.close()
  let t = client.openTunnel(h3tReq())?
  t.write("hello world")?
  assert(t.read(100)? == "hello world", "DATA echoed before either FIN")
  t.close()?
  assert(t.read(1)? == "", "server clean FIN")
  let res = client.request(
    H3Request{ method = "GET", scheme = "https", authority = "localhost", path = "/" },
  )?
  assert(res.status == 200 && string(res.body) == "still open", "connection remains reusable")
  assert(<- done == "ok", "server completed")
}

test "extended CONNECT exchanges DATA both ways before FIN and keeps connection usable" {
  h3tRoundTrip() catch e {
    assert(false, e.message())
  }
}

fn h3tUnadvertised(): ()! {
  let out = chan<H3Conn>(1)
  let hold = chan<int>(1)
  let client = h3qPair(out, hold)?
  defer client.close()
  let server = <- out
  defer server.close()
  server.watchPeer()
  defer {
    hold <- 1
  }
  client.openTunnel(h3tReq()) catch e {
    assert(e.message() == "h3: peer did not enable extended CONNECT", e.message())
    assert(server.highWater == -1, "client sent no request")
    return
  }
  assert(false, "client opened an unadvertised tunnel")
}

test "extended CONNECT client refuses a peer without advertisement before opening a stream" {
  h3tUnadvertised() catch e {
    assert(false, e.message())
  }
}

fn h3tRelease(hold: chan<int>) { hold <- 1 }

fn h3tWithConn(run: (H3Conn) => ()!): ()! {
  let out = chan<H3Conn>(1)
  let hold = chan<int>(1)
  let client = h3qPair(out, hold)?
  defer client.close()
  let server = <- out
  defer server.close()
  defer h3tRelease(hold)
  run(server)?
}

fn h3tDisabled(c: H3Conn): ()! {
  let s = c.rawConn().openStream()?
  let sr = H3ServerRequest{ req = h3tReq(), conn = c, stream = s, reader = h3TunnelReader{ s = s } }
  sr.acceptExtendedConnect() catch e {
    assert(e.message() == "h3: request cannot establish an extended CONNECT tunnel", e.message())
    assert(!sr.accepted, "refusal leaves the request unanswered")
    return
  }
  assert(false, "server accepted an unadvertised tunnel")
}

test "extended CONNECT server refuses an unadvertised tunnel" {
  h3tWithConn(h3tDisabled) catch e {
    assert(false, e.message())
  }
}

fn h3tUnknownHead(c: H3Conn): ()! {
  let s = c.rawConn().openStream()?
  let wire = qpackAppendBytes(h3frame(0x21, []byte{ 7 }), h3frame(h3FrameHeaders, []byte{ 9 }))
  let reader = h3TunnelReader{ s = s, buf = wire, fin = true }
  let head = h3tunnelHead(reader)?
  assert(
    int(head.ftype) == h3FrameHeaders && int(head.payload[0]) == 9,
    "HEADERS after unknown frame",
  )
}

test "extended CONNECT preserves unknown frames before HEADERS" {
  h3tWithConn(h3tUnknownHead) catch e {
    assert(false, e.message())
  }
}

fn h3tLargeData(c: H3Conn): ()! {
  let s = c.rawConn().openStream()?
  let data = []byte(h3TunnelFrameMax + 1)
  data[0] = 7
  data[h3TunnelFrameMax] = 9
  let reader = h3TunnelReader{ s = s, buf = h3frame(h3FrameData, data), fin = true }
  let t = H3Stream{ reader = reader }
  let first = t.read(1)?
  assert(int(first[0]) == 7, "first DATA byte")
  let rest = t.read(h3TunnelFrameMax)?
  assert(len(rest) == h3TunnelFrameMax && int(rest[h3TunnelFrameMax - 1]) == 9, "remaining DATA")
  assert(t.read(1)? == "", "orderly EOF after the large DATA frame")
}

test "extended CONNECT reads DATA larger than the header buffer limit incrementally" {
  h3tWithConn(h3tLargeData) catch e {
    assert(false, e.message())
  }
}

class h3wPeer {
  ready: chan<H3Conn>,
  tunnel: chan<H3Stream>,
  release: chan<int>,
  done: chan<string>,
}

fn h3wServe(sock: UdpSocket, peer: h3wPeer) {
  let c = h3Accept(sock, h3cPem("CERTIFICATE", h3cLeafHex), h3cPem("PRIVATE KEY", h3cKeyHex), true) catch e {
    peer.done <- e.message()
    return
  }
  defer c.close()
  peer.ready <- c
  let sr = c.accept() catch e {
    peer.done <- e.message()
    return
  }
  let tunnel = sr.acceptExtendedConnect() catch e {
    peer.done <- e.message()
    return
  }
  peer.tunnel <- tunnel
  <- peer.release
  peer.done <- "ok"
}

fn h3wWrite(t: H3Stream, wake: chan<int>, done: chan<string>) {
  t.writeUntil(string([]byte(65553)), wake) catch e {
    done <- e.message()
    return
  }
  done <- "ok"
}

fn h3wResult(done: chan<string>): string! {
  select {
    case result = <- done:
      return result
    case _ = <- after(2 * Second):
      fail newError("h3 test: writer did not return")
  }
}

fn h3wRun(mode: int): ()! {
  let sock = udpBind("127.0.0.1", 0)?
  defer sock.close()
  let peer = h3wPeer{
    ready = chan<H3Conn>(1), tunnel = chan<H3Stream>(1),
    release = chan<int>(1), done = chan<string>(1),
  }
  spawn h3wServe(sock, peer)
  let c = h3DialTls("127.0.0.1", sock.port()?, "localhost", h3cClientConfig())?
  defer c.close()
  let server = <- peer.ready
  defer server.close()
  defer {
    peer.release <- 1
  }
  let tunnel = c.openTunnel(h3tReq())?
  let remote = <- peer.tunnel
  let wake = chan<int>(1)
  let done = chan<string>(1)
  spawn h3wWrite(tunnel, wake, done)
  if (mode == 0) {
    h3wDrain(remote)?
    assert(h3wResult(done)? == "ok", "ACKed frames complete without FIN")
    remote.write("ok")?
    assert(tunnel.read(2)? == "ok", "reverse DATA before FIN")
    tunnel.close()?
    assert(remote.read(1)? == "", "clean FIN after acknowledged DATA")
    return
  }
  sleep(50 * Millisecond)
  select {
    case _ = <- done:
      assert(false, "writer completed while peer flow control was stalled")
    default:
      {}
  }
  h3wStop(remote, wake, mode)
  let result = h3wResult(done)?
  assert(result != "ok", "interrupted write must fail")
  if (mode == 1) {
    assert(result == "http3: request aborted", "cancellation preserves the H3 error contract")
  }
  assert(tunnel.closed, "partial DATA frame closes the local handle")
  tunnel.write("retry") catch _ {
    return
  }
  assert(false, "a partial DATA frame was resumed")
}

fn h3wDrain(remote: H3Stream): ()! {
  let total = 0
  let reads = 0
  while (total < 65553 && reads < 65553) {
    let data = remote.read(16384)?
    assert(len(data) > 0, "DATA arrived before FIN")
    for b of []byte(data) {
      assert(b == 0, "payload remains exact across released ACK prefixes")
    }
    total = total + len(data)
    reads = reads + 1
  }
  assert(total == 65553, "multiple flow windows arrive exactly")
}

fn h3wStop(remote: H3Stream, wake: chan<int>, mode: int) {
  if (mode == 1) {
    wake <- 1
    return
  }
  remote.reset()
}

test "extended CONNECT bounded DATA drains multiple flow windows before FIN" {
  h3wRun(0) catch e {
    assert(false, e.message())
  }
}

test "extended CONNECT stalled DATA wakes and forbids partial frame retry" {
  h3wRun(1) catch e {
    assert(false, e.message())
  }
}

test "extended CONNECT peer reset fails a stalled DATA writer" {
  h3wRun(2) catch e {
    assert(false, e.message())
  }
}

class h3dPair { client: H3Conn, server: H3Conn, local: H3Stream, remote: H3Stream }

fn h3dWith(run: (h3dPair) => ()!): ()! {
  let sock = udpBind("127.0.0.1", 0)?
  defer sock.close()
  let peer = h3wPeer{
    ready = chan<H3Conn>(1), tunnel = chan<H3Stream>(1),
    release = chan<int>(1), done = chan<string>(1),
  }
  spawn h3wServe(sock, peer)
  let c = h3DialTls("127.0.0.1", sock.port()?, "localhost", h3cClientConfig())?
  defer c.close()
  let server = <- peer.ready
  defer server.close()
  defer {
    peer.release <- 1
  }
  let local = c.openTunnel(h3tReq())?
  let remote = <- peer.tunnel
  run(h3dPair{ client = c, server = server, local = local, remote = remote })?
}

fn h3dRead(t: H3Stream, bound: H3Bound, done: chan<string>) {
  t.readUntil(1, bound) catch e {
    done <- e.message()
    return
  }
  done <- "unexpected success"
}

fn h3dResult(done: chan<string>): string! {
  let timer = Timer(Second)
  defer {
    let _ = timer.stop()
  }
  select {
    case value = <- done:
      return value
    case _ = <- timer.c:
      fail newError("h3 test: bounded read did not return")
  }
}

fn h3dPartial(p: h3dPair, deadline: bool): ()! {
  p.remote.reader.s.writeAll([]byte{ 0, 64 })?
  let bound = H3Bound{ wake = chan<int>(1) }
  if (deadline) {
    bound.deadlineNs = monotonic().ns + 10 * Millisecond
  }
  let done = chan<string>(1)
  spawn h3dRead(p.local, bound, done)
  sleep(30 * Millisecond)
  bound.wake <- 1
  let result = h3dResult(done)?
  if (deadline) {
    assert(
      result == "quic: stream deadline exceeded",
      "read deadline must win before fallback wake: ${result}",
    )
  } else {
    assert(result == "quic: wait woken", "read wake must stop the active receive: ${result}")
  }
  assert(len(p.local.reader.buf) == 2, "partial DATA type and length varint remain buffered")
  p.remote.reader.s.writeAll(qpackAppendBytes([]byte{ 70 }, []byte(70)))?
  let first = p.local.readUntil(
    1,
    H3Bound{ wake = chan<int>(1), deadlineNs = monotonic().ns + Second },
  )?
  assert(len(first) == 1 && int(first[0]) == 0, "partial varint resumes exactly")
  assert(len(p.local.read(69)?) == 69, "remaining DATA is preserved")
  p.remote.closeUntil(H3Bound{ wake = chan<int>(1), deadlineNs = monotonic().ns + Second })?
  assert(p.local.read(1)? == "", "FIN remains orderly EOF")
}

fn h3dPayload(p: h3dPair): ()! {
  p.remote.reader.s.writeAll([]byte{ 0, 3, 97 })?
  let bound = H3Bound{ wake = chan<int>(1), deadlineNs = monotonic().ns + Second }
  assert(p.local.readUntil(1, bound)? == "a", "partial DATA payload begins exactly")
  let stopped = H3Bound{ wake = chan<int>(1), deadlineNs = monotonic().ns + 10 * Millisecond }
  let done = chan<string>(1)
  spawn h3dRead(p.local, stopped, done)
  sleep(30 * Millisecond)
  stopped.wake <- 1
  assert(h3dResult(done)? == "quic: stream deadline exceeded", "partial DATA wait expires")
  assert(p.local.reader.remaining == 2, "deadline retains outstanding DATA bytes")
  p.remote.reader.s.writeAll([]byte("bc"))?
  assert(p.local.readUntil(2, bound)? == "bc", "partial DATA resumes without loss")
  p.remote.closeUntil(bound)?
  assert(p.local.read(1)? == "", "resumed DATA ends at orderly FIN")
}

fn h3dDeadline(p: h3dPair): ()! { h3dPartial(p, true)? }
fn h3dWake(p: h3dPair): ()! { h3dPartial(p, false)? }

fn h3dAnswer(c: H3Conn, done: chan<string>) {
  let sr = c.accept() catch e {
    done <- e.message()
    return
  }
  c.respond(sr, H3Response{ status = 200, body = []byte("still open") }) catch e {
    done <- e.message()
    return
  }
  done <- "ok"
}

fn h3dNext(p: h3dPair): ()! {
  let done = chan<string>(1)
  spawn h3dAnswer(p.server, done)
  let res = p.client.request(
    H3Request{ method = "GET", scheme = "https", authority = "localhost", path = "/" },
  )?
  assert(string(res.body) == "still open" && res.status == 200, "another stream remains usable")
  assert(h3dResult(done)? == "ok", "ordinary request finishes on the same connection")
}

fn h3dReadError(t: H3Stream, bound: H3Bound): string {
  t.readUntil(1, bound) catch e {
    return e.message()
  }
  return "unexpected success"
}

fn h3dReset(p: h3dPair): ()! {
  p.remote.reset()
  let message = h3dReadError(
    p.local,
    H3Bound{ wake = chan<int>(1), deadlineNs = monotonic().ns + Second },
  )
  assert(message == "h3: tunnel reset (${h3ErrRequestCancelled})", message)
  h3dNext(p)?
}

fn h3dFinish(p: h3dPair, wake: bool): ()! {
  let bound = H3Bound{ wake = chan<int>(1), deadlineNs = monotonic().ns + 10 * Millisecond }
  if (wake) {
    bound.wake <- 1
  } else {
    p.local.reader.s.write(h3frame(h3FrameData, []byte(65536)))?
  }
  let failed = false
  let started = monotonic().ns
  print("FIN bounded wait starts\n")
  p.local.closeUntil(bound) catch e {
    failed = true
    let want = "quic: stream deadline exceeded"
    if (wake) {
      want = "http3: request aborted"
    }
    assert(e.message() == want, e.message())
  }
  assert(failed && p.local.closed, "an interrupted FIN wait aborts only this stream")
  assert(monotonic().ns - started < Second, "FIN deadline completes before peer cleanup")
  print("FIN bounded wait returned before peer cleanup\n")
  // The fixture retained delivered bytes; release its receiver-owned credit.
  p.remote.reset()
  h3dNext(p)?
}

fn h3dFinishWake(p: h3dPair): ()! { h3dFinish(p, true)? }
fn h3dFinishDeadline(p: h3dPair): ()! { h3dFinish(p, false)? }

fn h3dIncomplete(p: h3dPair): ()! {
  p.client.rawConn().close()
  p.client.rawConn().openStream() catch _ {
    h3dClosedCleanup(p.local)?
    return
  }
  assert(false, "closed actor cannot open another stream")
}

fn h3dClosedCleanup(t: H3Stream): ()! {
  let wake = chan<int>(1)
  wake <- 1
  t.closeUntil(H3Bound{ wake = wake }) catch e {
    let (incomplete, ok) = e.(H3CleanupIncomplete)
    assert(ok && t.closed, "incomplete cleanup leaves the local handle terminal")
    let (_, woken) = incomplete.cause.(H3Aborted)
    assert(woken, "the original cancellation cause remains inspectable")
    assert(e.message() == "http3: request aborted; h3: stream cleanup incomplete", e.message())
    t.closeUntil(H3Bound{ wake = chan<int>(1) }) catch _ {
      assert(false, "terminal close remains idempotent")
    }
    return
  }
  assert(false, "unavailable cleanup cannot be reported complete")
}

test "tunnel close keeps its wake cause when a closed actor refuses cleanup" {
  h3dWith(h3dIncomplete) catch e {
    assert(false, e.message())
  }
}

test "tunnel read deadline preserves a partial length varint for resume and FIN" {
  h3dWith(h3dDeadline) catch e {
    assert(false, e.message())
  }
}

test "tunnel read cancellation preserves a partial length varint for resume" {
  h3dWith(h3dWake) catch e {
    assert(false, e.message())
  }
}

test "tunnel bounded read reports peer reset and preserves other request streams" {
  h3dWith(h3dReset) catch e {
    assert(false, e.message())
  }
}

test "tunnel FIN cancellation aborts this stream without closing the connection" {
  h3dWith(h3dFinishWake) catch e {
    assert(false, e.message())
  }
}

test "tunnel FIN deadline expires behind an unread flow window and preserves the connection" {
  h3dWith(h3dFinishDeadline) catch e {
    assert(false, e.message())
  }
}

test "tunnel read deadline preserves a partial DATA payload for resume" {
  h3dWith(h3dPayload) catch e {
    assert(false, e.message())
  }
}
