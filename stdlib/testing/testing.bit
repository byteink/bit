// Bit standard library — testing module.
//
// Assertions for `bit test` (SPEC §19). A test is a top-level
// `function test_<name>()`; it fails by panicking, and the runner gives each
// test its own process, so one failure neither hides the others nor aborts the
// run.
//
// Every assertion renders the offending values, so a failure reads
//
//     panic: sum: got 6, want 7
//
// rather than a bare "assertion failed". The generic ones monomorphize, so
// `got`/`want` print with the concrete type's own formatting; a type with
// neither a builtin rendering nor a `show` method is a compile error at the
// call site, not a mystery at runtime.

// Fail the current test unconditionally.
export function failNow(msg: string) {
  panic(msg)
}

// Fail unless `cond` holds.
export function ok(cond: bool, label: string) {
  if (!cond) {
    panic("${label}: expected true")
  }
}

// Fail unless `cond` is false.
export function notOk(cond: bool, label: string) {
  if (cond) {
    panic("${label}: expected false")
  }
}

// Fail unless `got == want`, showing both.
export function eq<T>(got: T, want: T, label: string) {
  if (got != want) {
    panic("${label}: got ${got}, want ${want}")
  }
}

// Fail if `got` equals `unwanted`.
export function neq<T>(got: T, unwanted: T, label: string) {
  if (got == unwanted) {
    panic("${label}: got ${got}, want anything else")
  }
}

// Fail unless |got - want| <= eps. Use this for f64, where `==` is a trap.
export function near(got: f64, want: f64, eps: f64, label: string) {
  let d = got - want
  if (d < 0.0) {
    d = -d
  }
  if (d > eps) {
    panic("${label}: got ${got}, want ${want} (+/- ${eps})")
  }
}

// Fail unless the slices have the same length and elements, naming the first
// index that differs.
export function eqSlice<T>(got: []T, want: []T, label: string) {
  if (len(got) != len(want)) {
    panic("${label}: length got ${len(got)}, want ${len(want)}")
  }
  let i = 0
  while (i < len(got)) {
    if (got[i] != want[i]) {
      panic("${label}[${i}]: got ${got[i]}, want ${want[i]}")
    }
    i = i + 1
  }
}
