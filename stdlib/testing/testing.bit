// Bit standard library — testing module.
//
// Assertions for `bit test` (SPEC §19). A test is a top-level
// `function test_<name>()`; it fails by panicking, and the runner gives each
// test its own process, so one failure neither hides the others nor aborts the
// run.
//
// Every assertion renders the offending values, so a failure reads
//
//     panic: sum: got 6, want 7
//
// rather than a bare "assertion failed". The generic ones monomorphize, so
// `got`/`want` print with the concrete type's own formatting; a type with
// neither a builtin rendering nor a `show` method is a compile error at the
// call site, not a mystery at runtime.
//
// Every assertion above is FATAL: it panics on the first bad value, which
// costs a table-driven test one edit-run cycle per bad row (#2255) — only
// the first row a loop reaches is ever reported. The `checkX` functions
// below are the non-fatal twin of each: on failure they print to stderr and
// record that the test has failed, then return so the caller's loop keeps
// going instead of ending the process. v0.1 has no `recover` (§18.4) and the
// runner's generated dispatch only calls the test function and returns, so
// nothing turns a recorded failure into a test failure automatically — call
// `checkDone()` to do that, normally as `defer checkDone()` at the top of
// the test function so it runs on every return path:
//
//     fn test_table() {
//       defer checkDone()
//       for (...) {
//         checkEq(c.got, c.want, "case ${c.name}")
//       }
//     }
//
// A test that calls a `checkX` and never calls `checkDone()` silently
// swallows the failure and reports as passing — the one sharp edge of this
// design, which is why every `checkX` doc comment below points back here.

// Set by a failed `checkX` call and read (and cleared) by `checkDone()`. One
// process per test (see above) gives every test a fresh `false`, so nothing
// needs to reset it between tests.
let checkFailed: bool = false

// Fail the current test unconditionally.
export fn failNow(msg: string) {
  panic(msg)
}

// Turns any failure recorded by a `checkX` call below into a test failure.
// Call once per test that uses them — normally `defer checkDone()` at the
// top of the test function, so it runs however the function returns. A
// no-op when nothing failed.
export fn checkDone() {
  if (checkFailed) {
    checkFailed = false
    panic("one or more checks failed above")
  }
}

// Fail unless `cond` holds.
export fn ok(cond: bool, label: string) {
  if (!cond) {
    panic("${label}: expected true")
  }
}

// The non-fatal twin of `ok`: records the failure and returns instead of
// panicking. Needs a paired `checkDone()` (see the file header) to actually
// fail the test.
export fn checkOk(cond: bool, label: string) {
  if (!cond) {
    eprint("check failed: ${label}: expected true\n")
    checkFailed = true
  }
}

// Fail unless `cond` is false.
export fn notOk(cond: bool, label: string) {
  if (cond) {
    panic("${label}: expected false")
  }
}

// The non-fatal twin of `notOk`. See `checkOk`.
export fn checkNotOk(cond: bool, label: string) {
  if (cond) {
    eprint("check failed: ${label}: expected false\n")
    checkFailed = true
  }
}

// Fail unless `got == want`, showing both.
export fn eq<T>(got: T, want: T, label: string) {
  if (got != want) {
    panic("${label}: got ${got}, want ${want}")
  }
}

// The non-fatal twin of `eq`. See `checkOk`.
export fn checkEq<T>(got: T, want: T, label: string) {
  if (got != want) {
    eprint("check failed: ${label}: got ${got}, want ${want}\n")
    checkFailed = true
  }
}

// Fail if `got` equals `unwanted`.
export fn neq<T>(got: T, unwanted: T, label: string) {
  if (got == unwanted) {
    panic("${label}: got ${got}, want anything else")
  }
}

// The non-fatal twin of `neq`. See `checkOk`.
export fn checkNeq<T>(got: T, unwanted: T, label: string) {
  if (got == unwanted) {
    eprint("check failed: ${label}: got ${got}, want anything else\n")
    checkFailed = true
  }
}

// Fail unless |got - want| <= eps. Use this for f64, where `==` is a trap.
export fn near(got: f64, want: f64, eps: f64, label: string) {
  let d = got - want
  if (d < 0.0) {
    d = -d
  }
  if (d > eps) {
    panic("${label}: got ${got}, want ${want} (+/- ${eps})")
  }
}

// The non-fatal twin of `near`. See `checkOk`.
export fn checkNear(got: f64, want: f64, eps: f64, label: string) {
  let d = got - want
  if (d < 0.0) {
    d = -d
  }
  if (d > eps) {
    eprint("check failed: ${label}: got ${got}, want ${want} (+/- ${eps})\n")
    checkFailed = true
  }
}

// Fail unless the slices have the same length and elements, naming the first
// index that differs.
export fn eqSlice<T>(got: []T, want: []T, label: string) {
  if (len(got) != len(want)) {
    panic("${label}: length got ${len(got)}, want ${len(want)}")
  }
  let i = 0
  while (i < len(got)) {
    if (got[i] != want[i]) {
      panic("${label}[${i}]: got ${got[i]}, want ${want[i]}")
    }
    i = i + 1
  }
}

// The non-fatal twin of `eqSlice`: same "first index that differs" report,
// recorded rather than panicked. See `checkOk`.
export fn checkEqSlice<T>(got: []T, want: []T, label: string) {
  if (len(got) != len(want)) {
    eprint("check failed: ${label}: length got ${len(got)}, want ${len(want)}\n")
    checkFailed = true
    return
  }
  let i = 0
  while (i < len(got)) {
    if (got[i] != want[i]) {
      eprint("check failed: ${label}[${i}]: got ${got[i]}, want ${want[i]}\n")
      checkFailed = true
      return
    }
    i = i + 1
  }
}
