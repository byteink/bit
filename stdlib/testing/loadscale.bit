// stdlib/testing/loadscale.bit — the host-load budget scale for gates
// whose deadline is a fixed wall picked against an idle box (fixmain
// 2026-10-07: test-hashseed's 900 s and test-book-ink's 60 s went red on a
// loaded host with no code change; old and new trees cost identical CPU).
//
// The one scheme every load-scaled gate and stdlib timing test shares
// (_tests_/bit/stress/verify.bit, stress/fanout.bit, pmimports.bit, pmaddgit.bit,
// stressparallel.bit and stdlib/http/cancel.test.bit call it rather than carry a
// copy; it lives in std/testing so a stdlib test never imports out of stdlib/):
// the one-minute load average over the core count, rounded UP, floored at 1 and
// capped at `loadScaleCap`. At or under the core count the scale is 1 and the
// budget is exactly the fixed number it always was. A probe that fails for any
// reason (no `uptime`/`getconf`, garbage output, its own timeout) reports
// scale 1, so a broken probe fails CLOSED to the old fixed wall and can never
// widen the budget past a real hang. The scale is a bounded multiple of the
// base, never an unbounded wait.
//
// The probe is `/bin/sh -c <script> sh <cap>` read from stdout, so it needs no
// scratch directory and writes no file (macOS SIGKILLs the exec of a rewritten
// executable, #4713).
import { output } from "std/process"
import { trimSpace, split, parseInt } from "std/strings"

export const loadScaleCap: int = 8
const probeTimeoutMs: int = 5000

export class LoadProbe {
  export scale: int,
  export text: string,
}

// `load averages*:` matches macOS's plural and Linux's singular; the `[ ,]+`
// split absorbs Linux's comma-separated triple. Output: "<scale> <load>".
const probeScript: string = `cores=$(getconf _NPROCESSORS_ONLN 2>/dev/null)
case "$cores" in ''|*[!0-9]*) cores=1 ;; esac
load=$(uptime 2>/dev/null | sed -n 's/.*load averages*: *//p' | awk -F'[ ,]+' '{print $1}')
case "$load" in ''|*[!0-9.]*) load=0 ;; esac
awk -v l="$load" -v c="$cores" -v cap="$1" 'BEGIN{r=l/c; s=int(r); if(r>s)s++; if(s<1)s=1; if(s>cap)s=cap; printf "%d %s\n", s, l}'
`

// One load sample. Never fatal; see the header for the fallback.
export fn loadProbe(): LoadProbe {
  let fallback = LoadProbe{ scale = 1, text = "unknown" }
  let r = output("/bin/sh", ["-c", probeScript, "sh", "${loadScaleCap}"], probeTimeoutMs)
  if (r.exitCode != 0) {
    return fallback
  }
  let parts = split(trimSpace(r.stdout), " ")
  if (len(parts) != 2) {
    return fallback
  }
  let scale = parseInt(parts[0]) catch _ {
    return fallback
  }
  if (scale < 1 || scale > loadScaleCap) {
    return fallback
  }
  return LoadProbe{ scale = scale, text = parts[1] }
}

// `baseMs` widened by the observed load; the result is at most
// `baseMs * loadScaleCap`.
export fn scaledBudgetMs(baseMs: int, probe: LoadProbe): int {
  return baseMs * probe.scale
}
