// Bit standard library — crypto module, X.509 validity times (RFC 5280 §4.1.2.5).

// ---------------------------------------------------------------------------
// Time (RFC 5280 §4.1.2.5): UTCTime and GeneralizedTime -> Unix seconds
// ---------------------------------------------------------------------------

// Parse a Validity time to Unix seconds. UTCTime is "YYMMDDHHMMSSZ" (a two-digit
// year, pivoted at 2050 per RFC 5280); GeneralizedTime is "YYYYMMDDHHMMSSZ".
// Both must be UTC ("Z") with seconds present, as RFC 5280 requires.
fn x509ParseTime(el: Element): int! {
  let s = []byte(asn1ReadString(el)?)
  if (el.tag == tagUtcTime) {
    if (len(s) != 13 || s[12] != 90) {
      fail newError("x509: malformed UTCTime")
    }
    let yy = x509Num(s, 0, 2)?
    let year = 2000 + yy
    if (yy >= 50) {
      year = 1900 + yy
    }
    return x509MakeTime(
      year,
      x509Num(s, 2, 2)?,
      x509Num(s, 4, 2)?,
      x509Num(s, 6, 2)?,
      x509Num(s, 8, 2)?,
      x509Num(s, 10, 2)?,
    )?
  }
  if (el.tag == tagGeneralizedTime) {
    if (len(s) != 15 || s[14] != 90) {
      fail newError("x509: malformed GeneralizedTime")
    }
    return x509MakeTime(
      x509Num(s, 0, 4)?,
      x509Num(s, 4, 2)?,
      x509Num(s, 6, 2)?,
      x509Num(s, 8, 2)?,
      x509Num(s, 10, 2)?,
      x509Num(s, 12, 2)?,
    )?
  }
  fail newError("x509: Validity time is neither UTCTime nor GeneralizedTime")
}

// The `n`-digit decimal at offset `off` of `s`, as an int. Fails on a non-digit.
fn x509Num(s: []byte, off: int, n: int): int! {
  let v = 0
  let i = 0
  while (i < n) {
    let c = s[off + i]
    if (c < 48 || c > 57) {
      fail newError("x509: non-digit in a time field")
    }
    v = v * 10 + int(c - 48)
    i = i + 1
  }
  return v
}

// Range-check a calendar date-time's fields before `x509MakeTime` converts
// them. Split out of `x509MakeTime` (#2448).
fn x509ValidateTimeFields(month: int, day: int, hour: int, min: int, sec: int): ()! {
  if (month < 1 || month > 12 || day < 1 || day > 31) {
    fail newError("x509: month or day out of range")
  }
  if (hour > 23 || min > 59 || sec > 60) {
    fail newError("x509: time-of-day out of range")
  }
}

// The Unix timestamp for a UTC calendar date-time. Days are counted with the
// standard days-from-civil algorithm (valid for any Gregorian date), which makes
// the conversion exact and independent of any library. Fails on an out-of-range
// month or day.
fn x509MakeTime(year: int, month: int, day: int, hour: int, min: int, sec: int): int! {
  x509ValidateTimeFields(month, day, hour, min, sec)?
  let y = year
  if (month <= 2) {
    y = y - 1
  }
  let era = y / 400
  if (y < 0) {
    era = (y - 399) / 400
  }
  let yoe = y - era * 400
  let mp = month + 9
  if (month > 2) {
    mp = month - 3
  }
  let doy = (153 * mp + 2) / 5 + day - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  let days = era * 146097 + doe - 719468
  return days * 86400 + hour * 3600 + min * 60 + sec
}
