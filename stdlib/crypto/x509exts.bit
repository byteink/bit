// Bit standard library — crypto module, X.509 certificate extensions (RFC 5280 §4.2).

// ---------------------------------------------------------------------------
// Extensions (RFC 5280 §4.2)
// ---------------------------------------------------------------------------

// Parse the Extensions SEQUENCE into `out`. Each Extension is
// SEQUENCE { extnID OID, critical BOOLEAN DEFAULT FALSE, extnValue OCTET STRING };
// the octet string wraps the DER of the extension value.
//
// RFC 5280 §4.2 requires that "a certificate-using system MUST reject the
// certificate if it encounters a critical extension it does not recognize or a
// critical extension that contains information that it cannot process". The
// `critical` BOOLEAN is therefore read here and the OID of every unrecognized
// critical extension is recorded in `out.unknownCriticalOids`; `x509VerifyChain`
// rejects any certificate in the path that carries one. A non-critical unknown
// extension stays ignorable, exactly as the RFC allows.
//
// This is deliberately fail-closed: an extension this verifier has not learned
// yet restricts the certificate in a way it cannot honour, so "not understood"
// must mean "not allowed" rather than "waved through".
function x509ParseExtensions(out: x509Exts, el: Element): ()! {
  let exts = asn1ReadSequence(el)?
  let i = 0
  while (i < len(exts)) {
    let parts = asn1ReadSequence(exts[i])?
    if (len(parts) < 2) {
      fail newError("x509: Extension must have an id and value")
    }
    let oid = asn1OidString(asn1ReadOid(parts[0])?)
    // critical BOOLEAN DEFAULT FALSE — present only in the 3-field form, where
    // it sits between the id and the value.
    let critical = false
    let valIdx = 1
    if (len(parts) >= 3) {
      critical = asn1ReadBoolean(parts[1])?
      valIdx = 2
    }
    let value = asn1ReadOctetString(parts[valIdx])?
    let inner = asn1Parse(value)?
    if (oid == x509OidSubjectAltName) {
      x509ParseSan(out, inner)?
    } else if (oid == x509OidBasicConstraints) {
      x509ParseBasicConstraints(out, inner)?
    } else if (oid == x509OidKeyUsage) {
      x509ParseKeyUsage(out, inner)?
    } else if (oid == x509OidExtKeyUsage) {
      x509ParseExtKeyUsage(out, inner)?
    } else if (oid == x509OidSubjectKeyId) {
      out.subjectKeyId = asn1ReadOctetString(inner)?
    } else if (oid == x509OidAuthorityKeyId) {
      x509ParseAuthorityKeyId(out, inner)?
    } else if (oid == x509OidNameConstraints) {
      x509ParseNameConstraints(out, inner)?
    } else if (critical) {
      out.unknownCriticalOids = append(out.unknownCriticalOids, oid)
    }
    i = i + 1
  }
}

// SubjectAltName: GeneralNames ::= SEQUENCE OF GeneralName. Only the dNSName [2]
// (an IA5String) and iPAddress [7] (an OCTET STRING, 4 bytes for IPv4 or 16 for
// IPv6) choices are collected; other name forms are skipped.
function x509ParseSan(out: x509Exts, el: Element): ()! {
  let names = asn1ReadSequence(el)?
  let i = 0
  while (i < len(names)) {
    let g = names[i]
    if (g.cls == classContext && !g.constructed && g.tag == 2) {
      out.dnsNames = append(out.dnsNames, string(g.bytes))
    } else if (g.cls == classContext && !g.constructed && g.tag == 7) {
      out.ipAddresses = append(out.ipAddresses, g.bytes)
    }
    i = i + 1
  }
}

// BasicConstraints ::= SEQUENCE { cA BOOLEAN DEFAULT FALSE, pathLenConstraint
// INTEGER OPTIONAL }. A DER encoder omits `cA` when false, so an empty SEQUENCE
// means a non-CA; the mere presence of the extension is recorded either way.
function x509ParseBasicConstraints(out: x509Exts, el: Element): ()! {
  let bc = asn1ReadSequence(el)?
  out.hasBasicConstraints = true
  let i = 0
  if (i < len(bc) && bc[i].cls == classUniversal && !bc[i].constructed && bc[i].tag == tagBoolean) {
    out.isCa = asn1ReadBoolean(bc[i])?
    i = i + 1
  }
  if (i < len(bc) && bc[i].cls == classUniversal && !bc[i].constructed && bc[i].tag == tagInteger) {
    out.maxPathLen = asn1ReadInteger(bc[i])?
    out.hasPathLen = true
  }
}

// KeyUsage ::= BIT STRING. DER BIT-STRING bit `n` (most-significant first) maps
// to `1 << n` in the `keyUsage` mask; trailing unused bits are zero (the strict
// reader guarantees it), so scanning whole octets is safe.
function x509ParseKeyUsage(out: x509Exts, el: Element): ()! {
  let bs = asn1ReadBitString(el)?
  out.hasKeyUsage = true
  let mask = 0
  let n = 0
  let total = len(bs.bytes) * 8
  while (n < total && n < 32) {
    let b = int(bs.bytes[n / 8])
    let bitPos = 7 - n % 8
    if (((b >> bitPos) & 1) == 1) {
      mask = mask | (1 << n)
    }
    n = n + 1
  }
  out.keyUsage = mask
}

// ExtKeyUsage ::= SEQUENCE OF KeyPurposeId (OBJECT IDENTIFIER).
function x509ParseExtKeyUsage(out: x509Exts, el: Element): ()! {
  let purposes = asn1ReadSequence(el)?
  out.hasExtKeyUsage = true
  let i = 0
  while (i < len(purposes)) {
    out.extKeyUsageOids = append(out.extKeyUsageOids, asn1OidString(asn1ReadOid(purposes[i])?))
    i = i + 1
  }
}

// AuthorityKeyIdentifier ::= SEQUENCE { keyIdentifier [0] OCTET STRING OPTIONAL,
// ... }. Only the [0] keyIdentifier is kept.
function x509ParseAuthorityKeyId(out: x509Exts, el: Element): ()! {
  let seq = asn1ReadSequence(el)?
  let i = 0
  while (i < len(seq)) {
    let c = seq[i]
    if (c.cls == classContext && !c.constructed && c.tag == 0) {
      out.authorityKeyId = c.bytes
    }
    i = i + 1
  }
}

// NameConstraints (RFC 5280 §4.2.1.10):
//   NameConstraints ::= SEQUENCE { permittedSubtrees [0] GeneralSubtrees OPTIONAL,
//                                  excludedSubtrees  [1] GeneralSubtrees OPTIONAL }
//   GeneralSubtree  ::= SEQUENCE { base GeneralName,
//                                  minimum [0] BaseDistance DEFAULT 0,
//                                  maximum [1] BaseDistance OPTIONAL }
//
// Only the dNSName [2] base is supported. Every other name form — iPAddress,
// directoryName, rfc822Name, uniformResourceIdentifier — is REJECTED outright
// rather than skipped: a constraint this verifier cannot evaluate is a
// restriction it cannot honour, and silently dropping it is exactly the
// fail-open behaviour this extension exists to prevent. The same reasoning
// rejects a non-default `minimum`/`maximum` (which RFC 5280 forbids in this
// profile anyway: "the minimum MUST be zero, and maximum MUST be absent") and an
// empty dNSName base, which would otherwise constrain nothing while looking like
// a constraint.
//
// `hasPermittedDns` records that a permitted set was PRESENT, separately from
// its contents, so that a present-but-empty set correctly permits nothing —
// distinct from an absent extension, which constrains nothing.
function x509ParseNameConstraints(out: x509Exts, el: Element): ()! {
  let nc = asn1ReadSequence(el)?
  out.hasNameConstraints = true
  let i = 0
  while (i < len(nc)) {
    let f = nc[i]
    if (f.cls == classContext && f.constructed && f.tag == 0) {
      out.hasPermittedDns = true
      out.permittedDnsNames = x509ReadDnsSubtrees(f)?
    } else if (f.cls == classContext && f.constructed && f.tag == 1) {
      out.excludedDnsNames = x509ReadDnsSubtrees(f)?
    } else {
      fail newError("x509: malformed nameConstraints")
    }
    i = i + 1
  }
}

// The dNSName bases of a GeneralSubtrees, failing on any subtree this verifier
// cannot fully evaluate. `el` is the IMPLICITLY-tagged [0]/[1] SEQUENCE OF
// GeneralSubtree — a context-class constructed element, not a universal
// SEQUENCE, so `asn1ReadSequence` would reject it; its children are the
// GeneralSubtrees and are read directly.
function x509ReadDnsSubtrees(el: Element): []string! {
  let out = []string(0)
  let subtrees = el.children
  let i = 0
  while (i < len(subtrees)) {
    let parts = asn1ReadSequence(subtrees[i])?
    if (len(parts) < 1) {
      fail newError("x509: nameConstraints subtree has no base")
    }
    // minimum/maximum must be absent (RFC 5280 §4.2.1.10 forbids both here).
    if (len(parts) > 1) {
      fail newError("x509: unsupported nameConstraints minimum/maximum")
    }
    let base = parts[0]
    if (base.cls != classContext || base.constructed || base.tag != 2) {
      fail newError("x509: unsupported nameConstraints name form")
    }
    if (len(base.bytes) == 0) {
      fail newError("x509: empty nameConstraints dNSName")
    }
    out = append(out, x509ToLower(string(base.bytes)))
    i = i + 1
  }
  return out
}
