// Bit standard library — crypto module, the ChaCha20-Poly1305 and
// XChaCha20-Poly1305 AEAD constructions (RFC 8439 §2.8; draft-irtf-cfrg-xchacha
// §2.1). Both bind confidentiality and integrity in one operation and satisfy
// the `Aead` interface, so callers can encrypt against `Aead` without naming the
// algorithm.
//
// ChaCha20-Poly1305 (RFC 8439 §2.8):
//   1. Derive a one-time Poly1305 key from the first 32 bytes of ChaCha20 block 0
//      (counter 0) under the message key and nonce.
//   2. Encrypt the plaintext with ChaCha20 starting at block counter 1 — the OTK
//      consumed block 0, so real data begins at 1.
//   3. Authenticate `aad ‖ pad16 ‖ ciphertext ‖ pad16 ‖ le64(len aad) ‖
//      le64(len ct)` under the OTK, where `pad16` zero-fills each part up to a
//      16-byte boundary. Output is `ciphertext ‖ tag`.
//   `open` recomputes the tag and verifies it in constant time
//   (`poly1305Aead` → `ctEq`); on any mismatch it FAILS and never returns the
//   unauthenticated plaintext — the whole point of authenticated encryption.
//   The nonce is 12 bytes and, like every stream cipher, MUST be unique per key.
//
// XChaCha20-Poly1305 (draft-irtf-cfrg-xchacha §2.1) takes a 24-byte nonce: it
// derives a subkey with HChaCha20 over the key and the first 16 nonce bytes,
// then runs the IETF construction above under that subkey with the 12-byte nonce
// `0x00000000 ‖ nonce[16:24]`. The 192-bit nonce makes random-nonce collisions
// negligible, so it tolerates random nonces where the 96-bit variant cannot.
//
// This module holds no cipher math of its own — it composes `chacha20`,
// `chacha20Into`, `hchacha20`, and `poly1305Aead`. Every loop is bounded by a
// public length, so it inherits their constant-time-by-construction property.

// A fresh 32-byte copy of `key`, so a cipher owns its key material rather than
// aliasing the caller's slice (which the caller may later wipe or reuse).
fn chachapolyCopyKey(key: []byte): []byte {
  let k = []byte(32)
  let i = 0
  while (i < 32) {
    k[i] = key[i]
    i = i + 1
  }
  return k
}

// The one-time Poly1305 key for (`key`, `nonce`): the first 32 bytes of the
// ChaCha20 keystream at block counter 0 (RFC 8439 §2.6). Encrypting 32 zero
// bytes yields exactly those keystream bytes.
fn chachapolyOtk(key: []byte, nonce: []byte): []byte {
  let zeros = []byte(32)
  return chacha20(key, nonce, 0, zeros)
}

// The AEAD seal under a 12-byte nonce: encrypt, then authenticate, writing
// `ciphertext ‖ tag` (16-byte tag) into `dst`, which is exactly
// `len(plaintext) + 16` bytes. `plaintext` may be `dst[0:len(plaintext)]`
// itself — the cipher is applied in place. `key` is 32 bytes; `chacha20Into`
// validates the nonce length.
fn chachapolySealInto(dst: []byte, key: []byte, nonce: []byte, plaintext: []byte, aad: []byte) {
  let n = len(plaintext)
  assert(len(dst) == n + 16, "chaChaPoly.sealInto: dst must be len(plaintext) + 16 bytes")
  let otk = chachapolyOtk(key, nonce)
  let ct = dst[0:n]
  chacha20Into(ct, key, nonce, 1, plaintext)
  let tag = poly1305Aead(otk, aad, ct)
  let i = 0
  while (i < 16) {
    dst[n + i] = tag[i]
    i = i + 1
  }
}

// `chachapolySealInto` into a fresh `len(plaintext) + 16`-byte slice.
fn chachapolySeal(key: []byte, nonce: []byte, plaintext: []byte, aad: []byte): []byte {
  let out = []byte(len(plaintext) + 16)
  chachapolySealInto(out, key, nonce, plaintext, aad)
  return out
}

// The AEAD open under a 12-byte nonce into `dst` (exactly `len(ciphertext) -
// 16` bytes; may be `ciphertext[0:len(ciphertext) - 16]` to open in place):
// split off the trailing 16-byte tag, verify it in constant time, and only then
// decrypt. FAILS on a short input or a tag mismatch, before a byte of `dst` is
// written — unauthenticated plaintext never reaches the caller.
fn chachapolyOpenInto(
  dst: []byte,
  key: []byte,
  nonce: []byte,
  ciphertext: []byte,
  aad: []byte,
): ()! {
  if (len(ciphertext) < 16) {
    fail newError("chachaPoly.open: ciphertext shorter than the 16-byte tag")
  }
  let n = len(ciphertext) - 16
  assert(len(dst) == n, "chaChaPoly.openInto: dst must be len(ciphertext) - 16 bytes")
  let ct = ciphertext[0:n]
  let otk = chachapolyOtk(key, nonce)
  if (!ctEq(poly1305Aead(otk, aad, ct), ciphertext[n:len(ciphertext)])) {
    fail newError("chachaPoly.open: authentication failed")
  }
  chacha20Into(dst, key, nonce, 1, ct)
}

// `chachapolyOpenInto` into a fresh slice.
fn chachapolyOpen(key: []byte, nonce: []byte, ciphertext: []byte, aad: []byte): []byte! {
  let n = len(ciphertext) - 16
  if (n < 0) {
    n = 0
  }
  let out = []byte(n)
  chachapolyOpenInto(out, key, nonce, ciphertext, aad)?
  return out
}

// The XChaCha20 message key: HChaCha20 of `key` and the first 16 bytes of the
// 24-byte nonce (draft-irtf-cfrg-xchacha §2.1).
fn chachapolyXKey(key: []byte, nonce24: []byte): []byte {
  return hchacha20(key, nonce24[0:16])
}

// The 12-byte IETF nonce for XChaCha20: four zero bytes then the last 8 bytes of
// the 24-byte nonce (draft-irtf-cfrg-xchacha §2.1).
fn chachapolyXNonce(nonce24: []byte): []byte {
  let n = []byte(12)
  let i = 0
  while (i < 8) {
    n[4 + i] = nonce24[16 + i]
    i = i + 1
  }
  return n
}

// XChaCha20-Poly1305 seal: derive the subkey and 12-byte nonce, then run the
// IETF construction.
fn chachapolyXSeal(key: []byte, nonce24: []byte, plaintext: []byte, aad: []byte): []byte {
  let sk = chachapolyXKey(key, nonce24)
  let n12 = chachapolyXNonce(nonce24)
  return chachapolySeal(sk, n12, plaintext, aad)
}

// XChaCha20-Poly1305 open: the inverse of `chachapolyXSeal`; fails on a tag
// mismatch.
fn chachapolyXOpen(key: []byte, nonce24: []byte, ciphertext: []byte, aad: []byte): []byte! {
  let sk = chachapolyXKey(key, nonce24)
  let n12 = chachapolyXNonce(nonce24)
  return chachapolyOpen(sk, n12, ciphertext, aad)?
}

// ChaCha20-Poly1305 (RFC 8439 §2.8), an `Aead` with a 12-byte nonce and a
// 16-byte tag. Build one with `ChaChaPoly(key)`, so the key length is validated
// and the key copied.
export class ChaChaPoly {
  key: []byte

  // Build a ChaCha20-Poly1305 cipher from a 32-byte `key`. Fails on any other
  // length. The key is copied, so the caller may reuse or wipe its slice.
  init(key: []byte)! {
    if (len(key) != 32) {
      fail newError("ChaChaPoly: key must be 32 bytes, got ${len(key)}")
    }
    this.key = chachapolyCopyKey(key)
  }

  // Encrypt `plaintext` and authenticate it with `aad`, returning `ciphertext ‖
  // tag`. `nonce` must be 12 bytes and unique per key. Panics on a wrong nonce
  // length — a programmer error, like Go's `cipher.AEAD.Seal`.
  export seal(nonce: []byte, plaintext: []byte, aad: []byte): []byte {
    assert(len(nonce) == 12, "chaChaPoly.seal: nonce must be 12 bytes")
    return chachapolySeal(this.key, nonce, plaintext, aad)
  }

  // `seal` writing `ciphertext ‖ tag` into the caller's `dst`, which must be
  // exactly `len(plaintext) + 16` bytes, instead of a fresh slice; `plaintext`
  // may be `dst[0:len(plaintext)]` to seal in place. Same nonce rules and
  // panics as `seal`.
  export sealInto(dst: []byte, nonce: []byte, plaintext: []byte, aad: []byte) {
    assert(len(nonce) == 12, "chaChaPoly.sealInto: nonce must be 12 bytes")
    chachapolySealInto(dst, this.key, nonce, plaintext, aad)
  }

  // Verify the tag over `ciphertext` and `aad`, then decrypt. Returns the
  // plaintext, or FAILS on a tampered message, wrong key/nonce/aad, or a short
  // input — never unauthenticated plaintext. Panics on a wrong nonce length.
  export open(nonce: []byte, ciphertext: []byte, aad: []byte): []byte! {
    assert(len(nonce) == 12, "chaChaPoly.open: nonce must be 12 bytes")
    return chachapolyOpen(this.key, nonce, ciphertext, aad)?
  }

  // `open` writing the plaintext into the caller's `dst`, which must be exactly
  // `len(ciphertext) - 16` bytes; `dst` may be `ciphertext[0:len(ciphertext) -
  // 16]` to open in place. The tag is verified before any byte of `dst` is
  // written. Same failures and panics as `open`.
  export openInto(dst: []byte, nonce: []byte, ciphertext: []byte, aad: []byte): ()! {
    assert(len(nonce) == 12, "chaChaPoly.openInto: nonce must be 12 bytes")
    chachapolyOpenInto(dst, this.key, nonce, ciphertext, aad)?
  }

  // The required nonce length in bytes: 12.
  export nonceSize(): int { return 12 }

  // The bytes `seal` adds — the 16-byte tag length.
  export overhead(): int { return 16 }
}

// XChaCha20-Poly1305 (draft-irtf-cfrg-xchacha §2.1), an `Aead` with a 24-byte
// nonce and a 16-byte tag. The extended nonce makes random nonces safe. Build
// one with `XChaChaPoly(key)`.
export class XChaChaPoly {
  key: []byte

  // Build an XChaCha20-Poly1305 cipher from a 32-byte `key`. Fails on any other
  // length. The key is copied.
  init(key: []byte)! {
    if (len(key) != 32) {
      fail newError("XChaChaPoly: key must be 32 bytes, got ${len(key)}")
    }
    this.key = chachapolyCopyKey(key)
  }

  // Encrypt `plaintext` and authenticate it with `aad`, returning `ciphertext ‖
  // tag`. `nonce` must be 24 bytes; a random nonce is safe at this width. Panics
  // on a wrong nonce length.
  export seal(nonce: []byte, plaintext: []byte, aad: []byte): []byte {
    assert(len(nonce) == 24, "xChaChaPoly.seal: nonce must be 24 bytes")
    return chachapolyXSeal(this.key, nonce, plaintext, aad)
  }

  // Verify the tag over `ciphertext` and `aad`, then decrypt. FAILS on any
  // mismatch or a short input. Panics on a wrong nonce length.
  export open(nonce: []byte, ciphertext: []byte, aad: []byte): []byte! {
    assert(len(nonce) == 24, "xChaChaPoly.open: nonce must be 24 bytes")
    return chachapolyXOpen(this.key, nonce, ciphertext, aad)?
  }

  // The required nonce length in bytes: 24.
  export nonceSize(): int { return 24 }

  // The bytes `seal` adds — the 16-byte tag length.
  export overhead(): int { return 16 }
}

