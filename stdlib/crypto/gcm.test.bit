// stdlib/crypto/gcm.test.bit — `AesGcm` lends one scratch to every
// uncontended `sealInto`/`openInto` (#7487): reuse must leave nothing behind
// that changes the next result, and a call that finds the scratch claimed
// must use its own and leave the claim alone.
//
// `decodeHex`, `encodeHex` and `ctEq` are this module's own; `gcmScratchTake`
// and `gcmScratchGive` are gcm.bit's.

fn gcmTestKey(): []byte {
  let k = []byte(16)
  let i = 0
  while (i < 16) {
    k[i] = byte(i * 7 + 3)
    i = i + 1
  }
  return k
}

fn gcmTestBytes(n: int, seed: int): []byte {
  let b = []byte(n)
  let i = 0
  while (i < n) {
    b[i] = byte(i * 31 + seed)
    i = i + 1
  }
  return b
}

fn gcmTestNonce(seed: int): []byte {
  return gcmTestBytes(12, seed)
}

test "AesGcm: NIST SP 800-38D test case 2 through a reused key" {
  let g = AesGcm([]byte(16)) catch e {
    panic("AesGcm: ${e.message()}")
  }
  let i = 0
  while (i < 3) {
    let out = g.seal([]byte(12), []byte(16), []byte(0))
    assert(
      encodeHex(out) == "0388dace60b6a392f328c2b971b2fe78ab6e47d42cec13bdf53a67b21257bddf",
      "seal #${i} = ${encodeHex(out)}",
    )
    i = i + 1
  }
}

test "AesGcm: a reused key seals and opens exactly as a fresh one" {
  let key = gcmTestKey()
  let g = AesGcm(key) catch e {
    panic("AesGcm: ${e.message()}")
  }
  let lens = [0, 1, 15, 16, 17, 31, 64, 100, 16385]
  let i = 0
  while (i < len(lens)) {
    let n = lens[i]
    let pt = gcmTestBytes(n, i)
    let aad = gcmTestBytes(i % 6, 90 + i)
    let fresh = AesGcm(key) catch e {
      panic("AesGcm: ${e.message()}")
    }
    let want = fresh.seal(gcmTestNonce(i), pt, aad)
    let got = g.seal(gcmTestNonce(i), pt, aad)
    assert(ctEq(got, want), "seal of ${n} bytes differs from a fresh key's")
    let back = g.open(gcmTestNonce(i), got, aad) catch e {
      panic("open of ${n} bytes: ${e.message()}")
    }
    assert(ctEq(back, pt), "open of ${n} bytes did not round-trip")
    i = i + 1
  }
}

test "AesGcm: a call that finds the scratch claimed uses its own and keeps the claim" {
  let key = gcmTestKey()
  let g = AesGcm(key) catch e {
    panic("AesGcm: ${e.message()}")
  }
  let pt = gcmTestBytes(100, 5)
  let want = g.seal(gcmTestNonce(1), pt, []byte(5))
  let held = gcmScratchTake(g)
  assert(held.owned, "the first take claims the key's own scratch")
  let got = g.seal(gcmTestNonce(1), pt, []byte(5))
  assert(ctEq(got, want), "a contended seal differs")
  let back = g.open(gcmTestNonce(1), got, []byte(5)) catch e {
    panic("contended open: ${e.message()}")
  }
  assert(ctEq(back, pt), "a contended open did not round-trip")
  assert(atomicLoad(ptrOf(g.busy)) == 1, "a contended call released a claim it did not hold")
  gcmScratchGive(g, held)
  assert(atomicLoad(ptrOf(g.busy)) == 0, "giving the scratch back releases the claim")
  keepAlive(g.busy)
}
