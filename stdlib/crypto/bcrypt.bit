// Bit standard library — crypto module, bcrypt password hashing.
//
// bcrypt is a deliberately slow, salted password hash built on the Blowfish
// cipher (Provos & Mazières, 1999). Its cost is *tunable*: a caller picks a
// work factor `cost` in `[4, 31]`, and the key schedule runs `2^cost` times, so
// the hash can be made as slow as hardware progress demands without changing the
// stored format. A hash is self-describing — `$2b$NN$` names the version and
// cost, then a 22-character salt and a 31-character digest — so `bcryptVerify`
// re-derives everything it needs from the encoded string alone.
//
// This module is self-contained: it carries its own Blowfish (the P-array, the
// four S-boxes, the key schedule, and the 16-round block cipher) and bcrypt's
// own base-64 variant, so it depends only on `randomBytes` (rand) for the salt
// and `ctEq` (subtle) for a constant-time digest compare. The large Blowfish
// initial tables are returned by functions rather than declared as module-level
// `const`, because a top-level `const` initializer must be a compile-time scalar
// (§15.4) and a slice literal is not; the tables themselves live in the sibling
// files `bcryptboxes.bit` and `bcryptboxes2.bit` (#1503), which are the same
// module — this file keeps only the assembly of them into a `BcryptCtx`.
//
// Password handling follows the `2b` rules: the password is truncated to 72
// bytes, a NUL terminator is appended, and the key bytes are then cycled through
// the schedule. Truncation is silent and matches every mainstream bcrypt.

// The running Blowfish key material: the 18-word P-array and the four 256-word
// S-boxes laid out as one flat 1024-word slice (box `b`, entry `k` is at
// `b*256 + k`). Both are mutated in place by the key schedule, so a fresh state
// is built per hash.
struct BcryptCtx { p: []u32, s: []u32 }

// Blowfish's F: split the 32-bit word into four bytes and combine one entry from
// each S-box as `(S0[a] + S1[b]) ^ S2[c] + S3[d]`, every `+` wrapping mod 2^32.
function bcryptF(s: []u32, x: u32): u32 {
  let a = int((x >> 24) & 0xff)
  let b = int((x >> 16) & 0xff)
  let c = int((x >> 8) & 0xff)
  let d = int(x & 0xff)
  let y = s[a] + s[256 + b]
  y = y ^ s[512 + c]
  y = y + s[768 + d]
  return y
}

// Encrypt one 64-bit block (the two halves packed as `xl<<32 | xr`) through the
// 16 Feistel rounds, returning the ciphertext packed the same way. This is the
// exact OpenBSD round order: XOR P[0], alternate `F` into each half against
// P[1..16], then emit `(xr ^ P[17]) << 32 | xl` — the final swap folded in.
function bcryptEncipher(p: []u32, s: []u32, block: uint): uint {
  let xl = u32(block >> 32)
  let xr = u32(block)
  xl = xl ^ p[0]
  let n = 1
  while (n <= 16) {
    if ((n & 1) == 1) {
      xr = xr ^ (bcryptF(s, xl) ^ p[n])
    } else {
      xl = xl ^ (bcryptF(s, xr) ^ p[n])
    }
    n = n + 1
  }
  let outL = xr ^ p[17]
  let outR = xl
  return (uint(outL) << 32) | uint(outR)
}

// Read four bytes of `data` big-endian into a 32-bit word, wrapping to the start
// whenever the cursor reaches the end (bcrypt's `stream2word`). Returns the word
// in the low 32 bits and the advanced cursor in the high bits, so callers thread
// the cursor across calls without a by-reference out-parameter. `data` is never
// empty here (the key carries a NUL, the salt is 16 bytes).
function bcryptStreamWord(data: []byte, cur: int): uint {
  let n = len(data)
  let j = cur
  let w: u32 = 0
  let i = 0
  while (i < 4) {
    if (j >= n) {
      j = 0
    }
    w = (w << 8) | u32(data[j])
    j = j + 1
    i = i + 1
  }
  return (uint(j) << 32) | uint(w)
}

// One key-schedule step: encrypt the carried `block`, first XOR-ing in the next
// two words of `data` when `useData` (the salt-mixing phase of `expandstate`);
// `dcur` is the one-element data cursor threaded across the whole expansion.
function bcryptNextBlock(
  ctx: BcryptCtx,
  block: uint,
  data: []byte,
  useData: bool,
  dcur: []int,
): uint {
  let bl = block
  if (useData) {
    let w1 = bcryptStreamWord(data, dcur[0])
    dcur[0] = int(w1 >> 32)
    let w2 = bcryptStreamWord(data, dcur[0])
    dcur[0] = int(w2 >> 32)
    let dl = u32(bl >> 32) ^ u32(w1)
    let dr = u32(bl) ^ u32(w2)
    bl = (uint(dl) << 32) | uint(dr)
  }
  return bcryptEncipher(ctx.p, ctx.s, bl)
}

// The Blowfish key expansion, in the two shapes bcrypt needs. `pKey` is XORed
// cyclically into the P-array; then P and every S-box are refilled by chaining
// the cipher over a running block. With `useData` the running block is XORed
// with successive words of `data` before each encryption (`Blowfish_expandstate`
// with the salt); without it the block is fed straight through
// (`Blowfish_expand0state`). Mutates `ctx` in place.
function bcryptExpand(ctx: BcryptCtx, pKey: []byte, data: []byte, useData: bool) {
  let cur = 0
  let i = 0
  while (i < 18) {
    let pk = bcryptStreamWord(pKey, cur)
    cur = int(pk >> 32)
    ctx.p[i] = ctx.p[i] ^ u32(pk)
    i = i + 1
  }

  let dcur = []int(1)
  let block: uint = 0
  i = 0
  while (i < 18) {
    block = bcryptNextBlock(ctx, block, data, useData, dcur)
    ctx.p[i] = u32(block >> 32)
    ctx.p[i + 1] = u32(block)
    i = i + 2
  }

  let b = 0
  while (b < 4) {
    let k = 0
    while (k < 256) {
      block = bcryptNextBlock(ctx, block, data, useData, dcur)
      let base = b * 256 + k
      ctx.s[base] = u32(block >> 32)
      ctx.s[base + 1] = u32(block)
      k = k + 2
    }
    b = b + 1
  }
}

// The expensive EksBlowfish key setup: seed the state from pi, mix in salt and
// key once, then alternately re-expand with key and salt `2^cost` times. This is
// the whole point of bcrypt — the `2^cost` loop is what makes it slow.
function bcryptSetup(cost: int, salt: []byte, key: []byte): BcryptCtx {
  let empty = []byte(0)
  let ctx = BcryptCtx{ p: bcryptInitP(), s: bcryptInitS() }
  bcryptExpand(ctx, key, salt, true)
  let total = 1 << cost
  let r = 0
  while (r < total) {
    bcryptExpand(ctx, key, empty, false)
    bcryptExpand(ctx, salt, empty, false)
    r = r + 1
  }
  return ctx
}

// bcrypt's base-64 alphabet — its own ordering (`.`/`/` first), unrelated to
// RFC 4648 and not interchangeable with `std/crypto`'s `base64`.
const bcryptB64: string = "./ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"

// Encode `data` in bcrypt's base-64, high bits first, no padding. 16 salt bytes
// become 22 characters and the 23-byte digest becomes 31, exactly as stored.
function bcryptEncode64(data: []byte): string {
  let alpha = []byte(bcryptB64)
  let n = len(data)
  let rem = n % 3
  let olen = n / 3 * 4
  if (rem == 1) {
    olen = olen + 2
  } else if (rem == 2) {
    olen = olen + 3
  }

  let out = []byte(olen)
  let si = 0
  let di = 0
  while (si + 3 <= n) {
    let c0 = int(data[si])
    let c1 = int(data[si + 1])
    let c2 = int(data[si + 2])
    out[di] = alpha[c0 >> 2]
    out[di + 1] = alpha[((c0 & 0x03) << 4) | (c1 >> 4)]
    out[di + 2] = alpha[((c1 & 0x0f) << 2) | (c2 >> 6)]
    out[di + 3] = alpha[c2 & 0x3f]
    si = si + 3
    di = di + 4
  }
  if (rem == 1) {
    let c0 = int(data[si])
    out[di] = alpha[c0 >> 2]
    out[di + 1] = alpha[(c0 & 0x03) << 4]
  } else if (rem == 2) {
    let c0 = int(data[si])
    let c1 = int(data[si + 1])
    out[di] = alpha[c0 >> 2]
    out[di + 1] = alpha[((c0 & 0x03) << 4) | (c1 >> 4)]
    out[di + 2] = alpha[(c1 & 0x0f) << 2]
  }
  return string(out)
}

// The reverse map for bcrypt's base-64: character code -> 6-bit value, `-1` for
// anything outside the alphabet.
function bcryptRev64(): []int {
  let alpha = []byte(bcryptB64)
  let rev = []int(256)
  let i = 0
  while (i < 256) {
    rev[i] = -1
    i = i + 1
  }
  i = 0
  while (i < 64) {
    rev[int(alpha[i])] = i
    i = i + 1
  }
  return rev
}

// The 6-bit value of `s[idx]`; fails on a short string or an out-of-alphabet
// character so a malformed salt is rejected rather than silently decoded.
function bcryptChar64(rev: []int, s: string, idx: int): int! {
  if (idx >= len(s)) {
    fail newError("bcrypt: encoded string too short")
  }
  let v = rev[int(s[idx])]
  if (v < 0) {
    fail newError("bcrypt: invalid base64 character")
  }
  return v
}

// Decode `outLen` bytes from bcrypt's base-64 string `s` (the inverse of
// `bcryptEncode64`). Used to recover the 16 salt bytes from an encoded hash.
function bcryptDecode64(s: string, outLen: int): []byte! {
  let rev = bcryptRev64()
  let out = []byte(outLen)
  let sp = 0
  let di = 0
  while (di < outLen) {
    let c1 = bcryptChar64(rev, s, sp)?
    let c2 = bcryptChar64(rev, s, sp + 1)?
    out[di] = byte((c1 << 2) | ((c2 & 0x30) >> 4))
    di = di + 1
    if (di >= outLen) {
      return out
    }
    let c3 = bcryptChar64(rev, s, sp + 2)?
    out[di] = byte(((c2 & 0x0f) << 4) | ((c3 & 0x3c) >> 2))
    di = di + 1
    if (di >= outLen) {
      return out
    }
    let c4 = bcryptChar64(rev, s, sp + 3)?
    out[di] = byte(((c3 & 0x03) << 6) | c4)
    di = di + 1
    sp = sp + 4
  }
  return out
}

// The raw 23-byte bcrypt digest for `password` at `cost` under `salt` (16 bytes)
// — the value both `bcryptHash` and `bcryptVerify` compute. The password is
// truncated to 72 bytes and NUL-terminated (`2b`), the EksBlowfish state is set
// up, and the magic text "OrpheanBeholderScryDoubt" is encrypted 64 times; the
// 24-byte result is truncated to 23 bytes, matching every bcrypt.
function bcryptRawHash(password: []byte, cost: int, salt: []byte): []byte {
  let plen = len(password)
  if (plen > 72) {
    plen = 72
  }
  let key = []byte(plen + 1)
  let i = 0
  while (i < plen) {
    key[i] = password[i]
    i = i + 1
  }
  key[plen] = 0

  let ctx = bcryptSetup(cost, salt, key)

  let magic = []byte("OrpheanBeholderScryDoubt")
  let cdata = []u32(6)
  let cur = 0
  i = 0
  while (i < 6) {
    let w = bcryptStreamWord(magic, cur)
    cur = int(w >> 32)
    cdata[i] = u32(w)
    i = i + 1
  }

  let rounds = 0
  while (rounds < 64) {
    let bi = 0
    while (bi < 6) {
      let blk = bcryptEncipher(ctx.p, ctx.s, (uint(cdata[bi]) << 32) | uint(cdata[bi + 1]))
      cdata[bi] = u32(blk >> 32)
      cdata[bi + 1] = u32(blk)
      bi = bi + 2
    }
    rounds = rounds + 1
  }

  let full = []byte(24)
  i = 0
  while (i < 6) {
    let v = cdata[i]
    let base = i * 4
    full[base] = byte(v >> 24)
    full[base + 1] = byte(v >> 16)
    full[base + 2] = byte(v >> 8)
    full[base + 3] = byte(v)
    i = i + 1
  }
  return full[0:23]
}

// Assemble the 60-character `$2b$NN$<salt><digest>` string from the two-digit
// cost and the already-encoded 22-char salt and 31-char digest.
function bcryptFormat(cost: int, salt64: string, dig64: string): string {
  let out = []byte(60)
  out[0] = '$'
  out[1] = '2'
  out[2] = 'b'
  out[3] = '$'
  out[4] = byte(int('0') + cost / 10)
  out[5] = byte(int('0') + cost % 10)
  out[6] = '$'
  let sb = []byte(salt64)
  let db = []byte(dig64)
  let i = 0
  while (i < 22) {
    out[7 + i] = sb[i]
    i = i + 1
  }
  i = 0
  while (i < 31) {
    out[29 + i] = db[i]
    i = i + 1
  }
  return string(out)
}

// Hash `password` with a fresh 16-byte random salt and work factor `cost`,
// returning the standard 60-character `$2b$` crypt string. `cost` must be in
// `[4, 31]`; the schedule runs `2^cost` times, so each step up roughly doubles
// the time. Passwords longer than 72 bytes are truncated (the `2b` rule).
export function bcryptHash(password: []byte, cost: int): string {
  if (cost < 4 || cost > 31) {
    panic("bcryptHash: cost must be in [4, 31]")
  }
  let salt = randomBytes(16)
  let dig = bcryptRawHash(password, cost, salt)
  return bcryptFormat(cost, bcryptEncode64(salt), bcryptEncode64(dig))
}

// Report whether `password` matches the bcrypt hash `encoded`. Parses the
// version, cost, and salt out of `encoded`, recomputes the digest, and compares
// it to the stored digest in constant time (`ctEq`). Returns `false` — never
// fails or panics — for any malformed input: wrong length, bad prefix, unknown
// version, non-numeric or out-of-range cost, or an undecodable salt. Accepts the
// `2a`/`2b`/`2x`/`2y` prefixes, which agree for all passwords up to 72 bytes.
export function bcryptVerify(password: []byte, encoded: string): bool {
  if (len(encoded) != 60) {
    return false
  }
  if (encoded[0] != '$' || encoded[1] != '2') {
    return false
  }
  let version = encoded[2]
  if (version != 'a' && version != 'b' && version != 'x' && version != 'y') {
    return false
  }
  if (encoded[3] != '$') {
    return false
  }
  let d0 = encoded[4]
  let d1 = encoded[5]
  if (d0 < '0' || d0 > '9' || d1 < '0' || d1 > '9') {
    return false
  }
  if (encoded[6] != '$') {
    return false
  }
  let cost = int(d0 - '0') * 10 + int(d1 - '0')
  if (cost < 4 || cost > 31) {
    return false
  }
  let salt = bcryptDecode64(encoded[7:29], 16) catch e {
    return false
  }
  let dig = bcryptRawHash(password, cost, salt)
  let expected = []byte(bcryptEncode64(dig))
  let actual = []byte(encoded[29:60])
  return ctEq(expected, actual)
}

// Combine the four pi-seeded S-boxes into one flat 1024-word state (a fresh copy
// per hash, since the schedule mutates it).
function bcryptInitS(): []u32 {
  let s = []u32(1024)
  bcryptCopyBox(s, 0, bcryptInitS0())
  bcryptCopyBox(s, 256, bcryptInitS1())
  bcryptCopyBox(s, 512, bcryptInitS2())
  bcryptCopyBox(s, 768, bcryptInitS3())
  return s
}

// Copy a 256-word S-box into `dst` at `off`.
function bcryptCopyBox(dst: []u32, off: int, src: []u32) {
  let i = 0
  while (i < 256) {
    dst[off + i] = src[i]
    i = i + 1
  }
}
