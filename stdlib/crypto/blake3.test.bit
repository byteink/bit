// Fixed-key construction keeps BLAKE3's published keyed-hash vector and copies
// caller-owned key bytes before they can change.

fn blake3KeyError(n: int): string {
  let key = [32]byte([]byte(n)) catch e {
    return e.message()
  }
  return "accepted ${len(key)}"
}

fn blake3SliceKeyError(n: int): string {
  let mac = blake3KeyedHash([]byte(n), []byte(0)) catch e {
    return e.message()
  }
  return "accepted ${len(mac)}"
}

test "Blake3: checked dynamic keys have exactly 32 bytes" {
  assert(blake3KeyError(31) == "array conversion length mismatch: expected 32, found 31")
  assert(blake3KeyError(32) == "accepted 32")
  assert(blake3KeyError(33) == "array conversion length mismatch: expected 32, found 33")
  assert(blake3SliceKeyError(31) == "Blake3: key must be 32 bytes, got 31")
  assert(blake3SliceKeyError(32) == "accepted 32")
  assert(blake3SliceKeyError(33) == "Blake3: key must be 32 bytes, got 33")
}

test "Blake3: fixed key is copied and retained through reset" {
  let bytes = []byte("whats the Elvish word for friend")
  let key = [32]byte(bytes) catch e {
    panic(e.message())
  }
  let mode = Blake3Mode.Keyed(key)
  bytes[0] = 0
  assert(key[0] == byte('w'), "slice mutation changed the copied key")
  key[0] = 0
  let h = Blake3(mode)
  key[1] = 0
  let data = []byte(1024)
  let i = 0
  while (i < 1024) {
    data[i] = byte(i % 251)
    i = i + 1
  }
  let expected = "75c46f6f3d9eb4f55ecaaee480db732e6c2105546f1e675003687c31719c7ba4"
  h.write(data)
  assert(encodeHex(h.sum()) == expected, "keyed hash vector")
  assert(encodeHex(digest(h, data)) == expected, "reset did not retain the key")
  assert(
      encodeHex(digest(HashAlg.Blake3.make(), []byte(0))) ==
      "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262",
  )
}
