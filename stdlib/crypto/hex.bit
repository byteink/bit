// Bit standard library — crypto module, hexadecimal encoding.
//
// Byte <-> hex-string conversion over plain u8 shifts and masks (correct post
// #1158). Each byte becomes exactly two hex digits, high nibble first, so a
// slice of `n` bytes encodes to a string of `2n` ASCII characters. `decodeHex`
// is the inverse for any even-length string of `[0-9a-fA-F]`; it rejects an odd
// length or a stray non-hex digit rather than guessing.

const lowerDigits: string = "0123456789abcdef"
const upperDigits: string = "0123456789ABCDEF"

// Encode `b` with the 16-character alphabet `digits`, high nibble first.
function encodeWith(b: []byte, digits: string): string {
  let out = []byte(len(b) * 2)
  let i = 0
  while (i < len(b)) {
    let v = b[i]
    out[i * 2] = digits[int(v >> 4)]
    out[i * 2 + 1] = digits[int(v & 0x0f)]
    i = i + 1
  }
  return string(out)
}

// The value of hex digit `c`, 0..15. Fails on any byte outside `[0-9a-fA-F]`.
function nibble(c: u8): u8! {
  if (c >= 48 && c <= 57) { // '0'..'9'
    return c - 48
  }
  if (c >= 97 && c <= 102) { // 'a'..'f'
    return c - 97 + 10
  }
  if (c >= 65 && c <= 70) { // 'A'..'F'
    return c - 65 + 10
  }
  fail newError("decodeHex: invalid hex digit ${int(c)}")
}

// `b` as a lowercase hex string, high nibble first. An empty slice yields "".
export function encodeHex(b: []byte): string { return encodeWith(b, lowerDigits) }

// `b` as an uppercase hex string, high nibble first. An empty slice yields "".
export function encodeHexUpper(b: []byte): string { return encodeWith(b, upperDigits) }

// The bytes `s` spells in hex, high nibble first. Fails if `s` has an odd
// length or contains any character outside `[0-9a-fA-F]`. Case-insensitive.
export function decodeHex(s: string): []byte! {
  if (len(s) % 2 != 0) {
    fail newError("decodeHex: odd length ${len(s)}")
  }
  let out = []byte(len(s) / 2)
  let i = 0
  while (i < len(out)) {
    let hi = nibble(s[i * 2])?
    let lo = nibble(s[i * 2 + 1])?
    out[i] = hi << 4 | lo
    i = i + 1
  }
  return out
}
