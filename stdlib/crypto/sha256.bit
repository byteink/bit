// Bit standard library — crypto module, SHA-224 and SHA-256 (FIPS 180-4).
//
// The two SHA-2 32-bit digests. Both share one 64-round compression function
// over 32-bit words; they differ only in their initial state and in how much of
// the final state they output — SHA-256 emits all eight words (32 bytes),
// SHA-224 the first seven (28 bytes). All arithmetic is `u32`, so it wraps mod
// 2^32 exactly as the standard prescribes (§13.5).
//
// `Sha256` is the streaming state for both: feed bytes with any number of
// `write` calls, then read the digest with `sum`. `sum` finalizes on a *copy* of
// the running state, so it never consumes the hasher — call it as often as you
// like, and keep writing afterward. `reset` rewinds to the empty message.
// `newSha256`/`newSha224` build the two variants and declare `Hash` as their
// return type directly (§14.3), matching every other constructor in this
// module — `Sha256` stays exported for callers who want the concrete type.
//
// The constant tables (`K`, and the two initial vectors) are returned by
// functions rather than declared as module-level `const`: a top-level `const`
// initializer must be a compile-time-constant scalar expression (§15.4), which a
// slice literal is not. Each hasher builds its tables once at construction and
// keeps them, so there is no per-block allocation of them.
//
// HARDWARE FAST PATH (task #1223). `compress` calls SHA-NI through
// `runtime/cryptohw/cryptohw.bit` when `bit_rt_crypto_sha256_hw_available()`
// reports it, else runs the 64-round software loop below unchanged — the same
// FIPS-180-4 round function either way, shared unchanged by SHA-224 and
// SHA-256 (they differ only in IV and output truncation, both applied
// outside `compress`). The dispatch branches on a cached CPU-capability flag
// only (ABI.md §21b), never on message bytes.
extern fn bit_rt_crypto_sha256_hw_available(): bool
extern fn bit_rt_crypto_sha256_compress_hw(state: *u32, block: *byte)

// ARM64 HARDWARE FAST PATH (task #2528, epic #1224), over #2524's
// `bit_rt_sha256_hw_blocks` (SHA256H/SHA256H2/SHA256SU0/SHA256SU1). Disjoint
// from the x86-64 SHA-NI dispatch above — disjoint hardware, disjoint runtime
// primitive, disjoint capability query — exactly as `gcm.bit` keeps
// `hwPmull()` and `bit_rt_crypto_ghash_hw_available()` apart. Gated on
// `hwSha2()` (hw.bit), read ONCE per hasher into `Sha256.hw`, so
// `BIT_CRYPTO_HW=0` forces every hasher built afterwards onto the software
// path and the two are testable from one binary.
//
// The software compression below is the fallback and stays byte-for-byte the
// authority: `absorb` picks a path, never a different digest. Neither the
// choice nor anything inside either path branches on message bytes, so the
// constant-time property is unchanged (§13.5).
//
// PACKED STATE, NOT `[]u32`. The primitive reads and writes eight u32 words
// tightly packed into 32 bytes. A Bit `[]u32` is word-STRIDED — one 8-byte
// word per element, only `[]byte` is byte-packed (SPEC §11.8) — so
// `ptrOf(h.state)` is the wrong layout and the running state is marshalled
// through a local 32-byte `[]byte` around each call. `data` needs no
// marshalling: it is a `[]byte` already.
//
// ONE CALL PER RUN OF WHOLE BLOCKS, not one per block: the primitive rebuilds
// its 256-byte round-constant table on every call, so `write` hands it every
// aligned block it has in a single call and buffers only the ragged ends.
extern fn bit_rt_sha256_hw_blocks(state: int, data: int, blocks: u64)

// The 64 round constants: the first 32 bits of the fractional parts of the cube
// roots of the first 64 primes (FIPS 180-4 §4.2.2).
fn roundConstants(): []u32 {
  return []u32{
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
  }
}

// SHA-256 initial state: the first 32 bits of the fractional parts of the square
// roots of the first eight primes (FIPS 180-4 §5.3.3).
fn iv256(): []u32 {
  return []u32{
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
  }
}

// SHA-224 initial state: the second 32 bits of the fractional parts of the
// square roots of the 9th through 16th primes (FIPS 180-4 §5.3.2).
fn iv224(): []u32 {
  return []u32{
    0xc1059ed8, 0x367cd507, 0x3070dd17, 0xf70e5939, 0xffc00b31, 0x68581511, 0x64f98fa7, 0xbefa4fa4,
  }
}

// Rotate the 32-bit word `x` right by `n` bits, `1 <= n <= 31`. The two shifted
// halves cover disjoint bit positions, so the `|` reassembles the rotation.
fn rotr32(x: u32, n: u32): u32 {
  return (x >> n) | (x << (32 - n))
}

// Absorb the 64-byte block at `block[off..off+63]` into `state` (the eight
// running words), running the full message schedule and 64 compression rounds
// against round constants `k`. Mutates `state` in place. `off` lets a caller
// compress straight out of its own buffer without copying a block out first;
// every existing caller passes 0.
fn compress(state: []u32, block: []byte, off: int, k: []u32) {
  if (bit_rt_crypto_sha256_hw_available()) {
    bit_rt_crypto_sha256_compress_hw(ptrOf(state), ptrOf(block[off:off + 64]))
    return
  }

  let w = []u32(64)

  // First 16 words are the block read big-endian; the rest extend the schedule.
  let i = 0
  while (i < 16) {
    let j = off + i * 4
    w[i] = (u32(block[j]) << 24) |
      (u32(block[j + 1]) << 16) |
      (u32(block[j + 2]) << 8) |
      u32(block[j + 3])
    i = i + 1
  }
  while (i < 64) {
    let a = w[i - 15]
    let s0 = rotr32(a, 7) ^ rotr32(a, 18) ^ (a >> 3)
    let b = w[i - 2]
    let s1 = rotr32(b, 17) ^ rotr32(b, 19) ^ (b >> 10)
    w[i] = w[i - 16] + s0 + w[i - 7] + s1
    i = i + 1
  }

  let a = state[0]
  let b = state[1]
  let c = state[2]
  let d = state[3]
  let e = state[4]
  let f = state[5]
  let g = state[6]
  let hh = state[7]

  let round = 0
  while (round < 64) {
    let s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)
    let ch = (e & f) ^ (~e & g)
    let temp1 = hh + s1 + ch + k[round] + w[round]
    let s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)
    let maj = (a & b) ^ (a & c) ^ (b & c)
    let temp2 = s0 + maj
    hh = g
    g = f
    f = e
    e = d + temp1
    d = c
    c = b
    b = a
    a = temp1 + temp2
    round = round + 1
  }

  state[0] = state[0] + a
  state[1] = state[1] + b
  state[2] = state[2] + c
  state[3] = state[3] + d
  state[4] = state[4] + e
  state[5] = state[5] + f
  state[6] = state[6] + g
  state[7] = state[7] + hh
}

// Write the eight running words of `state` into `out` as 32 tightly packed
// bytes, four native-endian bytes per word — the layout
// `bit_rt_sha256_hw_blocks` reads and writes, which a `[]u32` does not have
// (see the header). `unpackState` is the exact inverse, so a round trip with
// no call in between leaves `state` unchanged.
fn packState(state: []u32, out: []byte) {
  let i = 0
  while (i < 8) {
    let v = state[i]
    let j = i * 4
    out[j] = byte(v)
    out[j + 1] = byte(v >> 8)
    out[j + 2] = byte(v >> 16)
    out[j + 3] = byte(v >> 24)
    i = i + 1
  }
}

// Read the 32 packed bytes of `buf` back into the eight running words of
// `state`; the inverse of `packState`.
fn unpackState(buf: []byte, state: []u32) {
  let i = 0
  while (i < 8) {
    let j = i * 4
    state[i] = u32(buf[j]) |
      (u32(buf[j + 1]) << 8) |
      (u32(buf[j + 2]) << 16) |
      (u32(buf[j + 3]) << 24)
    i = i + 1
  }
}

// Whether `compress` is taking the SHA-NI hardware path on this host (task
// #1223) rather than the 64-round software loop — a diagnostic query, like
// `hwAvailableAes` (aes.bit); the dispatch itself is transparent.
export fn hwAvailableSha256(): bool {
  return bit_rt_crypto_sha256_hw_available()
}

// Streaming state shared by SHA-224 and SHA-256. `state` holds the eight running
// words; `buf`/`bufLen` accumulate a partial 64-byte block; `total` is the byte
// count for the length field; `sz` is the digest length (32 or 28); `iv` is the
// variant's initial state (kept so `reset` can restore it); `k` is the shared
// round-constant table. `hw` is `hwSha2()` sampled once here — the ARM64 SHA2
// dispatch, read from the CPU exactly once per hasher. `iv`, `k` and `hw` are
// all built once at construction and `reset` does not disturb them, so a hasher
// never re-reads the CPU.
export class Sha256 {
  state: []u32,
  buf: []byte,
  bufLen: int,
  total: uint,
  sz: int,
  iv: []u32,
  k: []u32,
  hw: bool,
}

// A fresh SHA-256 hasher over the empty message.
export fn newSha256(): Hash {
  let h = Sha256{
    state: []u32(8),
    buf: []byte(64),
    bufLen: 0,
    total: 0,
    sz: 32,
    iv: iv256(),
    k: roundConstants(),
    hw: hwSha2(),
  }
  h.reset()
  return h
}

// A fresh SHA-224 hasher over the empty message.
export fn newSha224(): Hash {
  let h = Sha256{
    state: []u32(8),
    buf: []byte(64),
    bufLen: 0,
    total: 0,
    sz: 28,
    iv: iv224(),
    k: roundConstants(),
    hw: hwSha2(),
  }
  h.reset()
  return h
}

// Fold `blocks` whole 64-byte blocks, starting at `data[off]`, into `state` —
// the one place either path is chosen. `state` is the caller's running state
// (`h.state` while writing, the finalization copy in `sum`), never assumed to
// be `h`'s own.
fn (h: Sha256) absorb(state: []u32, data: []byte, off: int, blocks: int) {
  if (!h.hw) {
    let i = 0
    while (i < blocks) {
      compress(state, data, off + i * 64, h.k)
      i = i + 1
    }
    return
  }
  // The 32-byte packed-state buffer is local, NOT a field on `h`: `sum`
  // finalizes on a copy of the running state and must stay read-only with
  // respect to the hasher, which a shared scratch field would quietly break for
  // two concurrent `sum` calls. `absorb` runs at most twice per `write` and
  // twice per `sum` — never once per block — so this is a per-run allocation,
  // and it replaces the software path's own `[]u32(64)` schedule, which is 512
  // bytes per BLOCK.
  let packed = []byte(32)
  packState(state, packed)
  bit_rt_sha256_hw_blocks(int(ptrOf(packed)), int(ptrOf(data)) + off, u64(blocks))
  unpackState(packed, state)

  // GC KEEP-ALIVE, and the reason it is AFTER the call rather than before it.
  // `data` reaches the primitive only as a raw address, and a raw `int` is not
  // a stack-map slot while a `[]byte` local is (`runtime/root/floats.bit`'s
  // `packLowBytes` header; `codegen.bit`'s `isRefType` excludes `*T`). Stack
  // maps are live-range precise — `regalloc.bit` records an interval at a
  // safepoint only while `start <= pos && end >= pos` — so a slice whose last
  // use precedes the call is absent from that call's map. The primitive
  // allocates (its round-constant table and its scratch block), so a
  // collection CAN run inside it. This read is what holds `data`'s interval,
  // and so its stack-map entry, open across the call above. It is also a real
  // bounds invariant: every caller must have `blocks` whole blocks in hand.
  if (len(data) < off + blocks * 64) {
    panic("sha256: hardware block run extends past the end of the buffer")
  }
}

// Absorb `data`, buffering into 64-byte blocks and compressing each full one.
// Whole blocks that are already 64-byte aligned in the caller's own buffer are
// handed to `absorb` in one run, so they are neither copied through `h.buf` nor
// split into one primitive call each; only the ragged head and tail are
// buffered. The block sequence, and so the digest, is identical either way.
export fn (h: Sha256) write(data: []byte) {
  let n = len(data)
  let i = 0

  // Head: top up a partial block, so the bulk run below starts block-aligned.
  while (h.bufLen > 0 && i < n) {
    h.buf[h.bufLen] = data[i]
    h.bufLen = h.bufLen + 1
    i = i + 1
    if (h.bufLen == 64) {
      h.absorb(h.state, h.buf, 0, 1)
      h.bufLen = 0
    }
  }

  let blocks = (n - i) / 64
  if (blocks > 0) {
    h.absorb(h.state, data, i, blocks)
    i = i + blocks * 64
  }

  // Tail: whatever is left cannot fill a block.
  while (i < n) {
    h.buf[h.bufLen] = data[i]
    h.bufLen = h.bufLen + 1
    i = i + 1
  }

  h.total = h.total + uint(n)
}

// The digest of everything written since the last reset. Finalizes on a copy of
// the running state, so it neither consumes the hasher nor blocks further
// `write`s. Padding is `0x80`, then zeros, then the 64-bit big-endian bit length.
export fn (h: Sha256) sum(): []byte {
  // Snapshot the running state so finalization is non-destructive.
  let s = []u32(8)
  let i = 0
  while (i < 8) {
    s[i] = h.state[i]
    i = i + 1
  }

  // Build the padded tail from the current partial block.
  let pad = []byte(64)
  i = 0
  while (i < h.bufLen) {
    pad[i] = h.buf[i]
    i = i + 1
  }
  let n = h.bufLen
  pad[n] = 0x80
  n = n + 1

  // The 8-byte length must fit in this block; if not, flush and start a fresh
  // all-zero block for it.
  if (n > 56) {
    while (n < 64) {
      pad[n] = 0
      n = n + 1
    }
    h.absorb(s, pad, 0, 1)
    i = 0
    while (i < 64) {
      pad[i] = 0
      i = i + 1
    }
    n = 0
  }
  while (n < 56) {
    pad[n] = 0
    n = n + 1
  }

  // 64-bit big-endian message length in bits.
  let bitLen = h.total * 8
  pad[56] = byte(bitLen >> 56)
  pad[57] = byte(bitLen >> 48)
  pad[58] = byte(bitLen >> 40)
  pad[59] = byte(bitLen >> 32)
  pad[60] = byte(bitLen >> 24)
  pad[61] = byte(bitLen >> 16)
  pad[62] = byte(bitLen >> 8)
  pad[63] = byte(bitLen)
  h.absorb(s, pad, 0, 1)

  // Serialize the first `sz` bytes of the state, each word big-endian.
  let out = []byte(h.sz)
  let words = h.sz / 4
  i = 0
  while (i < words) {
    let v = s[i]
    out[i * 4] = byte(v >> 24)
    out[i * 4 + 1] = byte(v >> 16)
    out[i * 4 + 2] = byte(v >> 8)
    out[i * 4 + 3] = byte(v)
    i = i + 1
  }
  return out
}

// Rewind to the empty message: restore the variant's initial state and drop any
// buffered bytes.
export fn (h: Sha256) reset() {
  let i = 0
  while (i < 8) {
    h.state[i] = h.iv[i]
    i = i + 1
  }
  h.bufLen = 0
  h.total = 0
}

// The digest length in bytes: 32 for SHA-256, 28 for SHA-224.
export fn (h: Sha256) size(): int {
  return h.sz
}

// The internal block size in bytes (64 for both variants).
export fn (h: Sha256) blockSize(): int {
  return 64
}
