// Bit standard library — crypto module, HKDF (RFC 5869).
//
// HKDF is the HMAC-based extract-and-expand key derivation function — the
// TLS 1.3 key-schedule primitive. It turns one (possibly non-uniform) input
// keying material into any number of independent, cryptographically strong
// output keys, in two steps built entirely from HMAC:
//
//   PRK          = HKDF-Extract(salt, IKM) = HMAC(salt, IKM)
//   OKM[0..L)    = HKDF-Expand(PRK, info, L)
//
// *Extract* concentrates whatever entropy the input keying material has into a
// fixed-length pseudo-random key `PRK` of exactly one hash digest; a public,
// non-secret `salt` (defaulting to a run of `HashLen` zero bytes when absent)
// makes the extraction a strong randomness extractor. *Expand* then stretches
// `PRK` to the requested `L` bytes with the T(1..n) counter chain
//
//   T(0) = ""                                  (the empty block)
//   T(i) = HMAC(PRK, T(i-1) || info || byte(i))
//   OKM  = (T(1) || T(2) || ...) truncated to L bytes
//
// where the application-specific `info` binds the derived key to its context.
// Because the output cannot exceed the counter's one-byte range, `L` is capped
// at `255 * HashLen`.
//
// The construction is generic over the digest: every function takes a `HashAlg`
// (e.g. `HashAlg.Sha256`/`HashAlg.Sha384`/`HashAlg.Sha512`) and asks the built
// hash for its own `size` rather than hard-coding one, so the same code derives
// keys under any SHA-2 member. This file is part of the flat
// `std/crypto` module, so it names `HashAlg`, `hmac`, and `newError` from its
// siblings and the prelude without importing them.

// The HMAC input for expand block T(i): the previous block, then `info`, then
// the single counter byte `counter` (RFC 5869 §2.3). `prev` is the empty slice
// for the first block, so T(1)'s input is just `info || byte(1)`.
fn hkdfBlockInput(prev: []byte, info: []byte, counter: byte): []byte {
  let out = []byte(len(prev) + len(info) + 1)
  let at = 0
  let i = 0
  while (i < len(prev)) {
    out[at] = prev[i]
    at = at + 1
    i = i + 1
  }
  i = 0
  while (i < len(info)) {
    out[at] = info[i]
    at = at + 1
    i = i + 1
  }
  out[at] = counter
  return out
}

// Copy `src` into `dst` starting at offset `off`, never writing past the end of
// `dst`, and return the new fill offset. This is what truncates the final
// expand block T(n) to the requested output length.
fn hkdfCopyInto(dst: []byte, off: int, src: []byte): int {
  let i = 0
  while (i < len(src) && off + i < len(dst)) {
    dst[off + i] = src[i]
    i = i + 1
  }
  return off + i
}

// HKDF-Extract (RFC 5869 §2.2): the pseudo-random key `PRK = HMAC(salt, IKM)`,
// exactly one digest long. An empty `salt` is replaced by a string of `HashLen`
// zero bytes, as the standard requires — the two are not equivalent, since the
// zero salt is what makes extraction a strong randomness extractor. `alg`
// selects the digest.
export fn hkdfExtract(alg: HashAlg, salt: []byte, ikm: []byte): []byte {
  let s = salt
  if (len(salt) == 0) {
    s = []byte(alg.make().size())
  }
  return hmac(alg, s, ikm)
}

// HKDF-Expand (RFC 5869 §2.3): stretch the pseudo-random key `prk` to `outLen`
// bytes of output keying material, bound to the context `info`, via the T(1..n)
// counter chain. Fails if `outLen` exceeds `255 * HashLen`, the most the
// one-byte block counter can address. `prk` should be a digest-length key from
// `hkdfExtract`; `info` may be empty.
export fn hkdfExpand(alg: HashAlg, prk: []byte, info: []byte, outLen: int): []byte! {
  let hashLen = alg.make().size()
  if (outLen > 255 * hashLen) {
    fail newError("hkdfExpand: outLen ${outLen} exceeds 255*HashLen ${255 * hashLen}")
  }
  let out = []byte(outLen)
  let prev = []byte(0)
  let counter = 1
  let filled = 0
  while (filled < outLen) {
    let block = hmac(alg, prk, hkdfBlockInput(prev, info, byte(counter)))
    filled = hkdfCopyInto(out, filled, block)
    prev = block
    counter = counter + 1
  }
  return out
}

// HKDF (RFC 5869 §2): extract then expand in one call — derive `outLen` bytes of
// output keying material from input keying material `ikm`, salted by `salt` and
// bound to the context `info`. Equivalent to
// `hkdfExpand(alg, hkdfExtract(alg, salt, ikm), info, outLen)`; fails on
// the same over-long `outLen` as `hkdfExpand`.
export fn hkdf(alg: HashAlg, salt: []byte, ikm: []byte, info: []byte, outLen: int): []byte! {
  let prk = hkdfExtract(alg, salt, ikm)
  return hkdfExpand(alg, prk, info, outLen)?
}
