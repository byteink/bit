// Bit standard library — crypto module, the SHA-512 family (FIPS 180-4 §5.3.5,
// §6.4-6.7). One 64-bit compression function drives all four digests defined
// over a 1024-bit (128-byte) block: SHA-512, SHA-384, and SHA-512/256 differ
// only in their initial hash value and how many of the eight output words they
// keep. (SHA-512/224 is omitted only because it is not requested here.)
//
// The concrete state (`sha512Digest`) and its five `Hash` methods are private:
// callers receive the streaming `Hash` interface from the constructors below,
// exactly as Go's `sha512.New` returns a `hash.Hash`, so no caller ever names
// the backing struct. The digest is streaming — feed bytes with any number of
// `write`s, read the result with `sum` — and `sum` is non-destructive, so it
// may be called repeatedly and writing may continue after it.

// Right-rotate `x` by `n` bits, 0 < n < 64 (every SHA-512 rotation is in range).
// The two halves partition the 64 bits, so no bit is dropped or doubled.
function rotr64(x: u64, n: u64): u64 { return (x >> n) | (x << (64 - n)) }

// The 80 round constants K_t: the first 64 bits of the fractional parts of the
// cube roots of the first 80 primes (FIPS 180-4 §4.2.3). Returned from a
// function because a top-level `const` may not hold a heap slice literal; one
// allocation per block is immaterial next to the 80-round compression.
function sha512K(): []u64 {
  return []u64{
    0x428a2f98d728ae22,
    0x7137449123ef65cd,
    0xb5c0fbcfec4d3b2f,
    0xe9b5dba58189dbbc,
    0x3956c25bf348b538,
    0x59f111f1b605d019,
    0x923f82a4af194f9b,
    0xab1c5ed5da6d8118,
    0xd807aa98a3030242,
    0x12835b0145706fbe,
    0x243185be4ee4b28c,
    0x550c7dc3d5ffb4e2,
    0x72be5d74f27b896f,
    0x80deb1fe3b1696b1,
    0x9bdc06a725c71235,
    0xc19bf174cf692694,
    0xe49b69c19ef14ad2,
    0xefbe4786384f25e3,
    0x0fc19dc68b8cd5b5,
    0x240ca1cc77ac9c65,
    0x2de92c6f592b0275,
    0x4a7484aa6ea6e483,
    0x5cb0a9dcbd41fbd4,
    0x76f988da831153b5,
    0x983e5152ee66dfab,
    0xa831c66d2db43210,
    0xb00327c898fb213f,
    0xbf597fc7beef0ee4,
    0xc6e00bf33da88fc2,
    0xd5a79147930aa725,
    0x06ca6351e003826f,
    0x142929670a0e6e70,
    0x27b70a8546d22ffc,
    0x2e1b21385c26c926,
    0x4d2c6dfc5ac42aed,
    0x53380d139d95b3df,
    0x650a73548baf63de,
    0x766a0abb3c77b2a8,
    0x81c2c92e47edaee6,
    0x92722c851482353b,
    0xa2bfe8a14cf10364,
    0xa81a664bbc423001,
    0xc24b8b70d0f89791,
    0xc76c51a30654be30,
    0xd192e819d6ef5218,
    0xd69906245565a910,
    0xf40e35855771202a,
    0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8,
    0x1e376c085141ab53,
    0x2748774cdf8eeb99,
    0x34b0bcb5e19b48a8,
    0x391c0cb3c5c95a63,
    0x4ed8aa4ae3418acb,
    0x5b9cca4f7763e373,
    0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc,
    0x78a5636f43172f60,
    0x84c87814a1f0ab72,
    0x8cc702081a6439ec,
    0x90befffa23631e28,
    0xa4506cebde82bde9,
    0xbef9a3f7b2c67915,
    0xc67178f2e372532b,
    0xca273eceea26619c,
    0xd186b8c721c0c207,
    0xeada7dd6cde0eb1e,
    0xf57d4f7fee6ed178,
    0x06f067aa72176fba,
    0x0a637dc5a2c898a6,
    0x113f9804bef90dae,
    0x1b710b35131c471b,
    0x28db77f523047d84,
    0x32caab7b40c72493,
    0x3c9ebe0a15c9bebc,
    0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6,
    0x597f299cfc657e2a,
    0x5fcb6fab3ad6faec,
    0x6c44198c4a475817,
  }
}

// Initial hash value H(0) for SHA-512 (FIPS 180-4 §5.3.5): fractional parts of
// the square roots of the first eight primes.
function iv512(): []u64 {
  return []u64{
    0x6a09e667f3bcc908,
    0xbb67ae8584caa73b,
    0x3c6ef372fe94f82b,
    0xa54ff53a5f1d36f1,
    0x510e527fade682d1,
    0x9b05688c2b3e6c1f,
    0x1f83d9abfb41bd6b,
    0x5be0cd19137e2179,
  }
}

// Initial hash value H(0) for SHA-384 (FIPS 180-4 §5.3.4).
function iv384(): []u64 {
  return []u64{
    0xcbbb9d5dc1059ed8,
    0x629a292a367cd507,
    0x9159015a3070dd17,
    0x152fecd8f70e5939,
    0x67332667ffc00b31,
    0x8eb44a8768581511,
    0xdb0c2e0d64f98fa7,
    0x47b5481dbefa4fa4,
  }
}

// Initial hash value H(0) for SHA-512/256 (FIPS 180-4 §5.3.6.2).
function iv512_256(): []u64 {
  return []u64{
    0x22312194fc2bf72c,
    0x9f555fa3c84c64c2,
    0x2393b86b6f53b151,
    0x963877195940eabd,
    0x96283ee2a88effe3,
    0xbe5e1e2553863992,
    0x2b0199fc2c85b8aa,
    0x0eb72ddc81c52ca2,
  }
}

// The big-endian u64 at `b[off..off+8]` (FIPS words are big-endian).
function beU64(b: []byte, off: int): u64 {
  let v: u64 = 0
  let i = 0
  while (i < 8) {
    v = (v << 8) | u64(b[off + i])
    i = i + 1
  }
  return v
}

// Write `v` big-endian into `b[off..off+8]`.
function putU64BE(b: []byte, off: int, v: u64) {
  b[off] = u8(v >> 56)
  b[off + 1] = u8(v >> 48)
  b[off + 2] = u8(v >> 40)
  b[off + 3] = u8(v >> 32)
  b[off + 4] = u8(v >> 24)
  b[off + 5] = u8(v >> 16)
  b[off + 6] = u8(v >> 8)
  b[off + 7] = u8(v)
}

// The SHA-512 compression: fold the 128-byte block at `block[off..]` into the
// eight-word state `s` in place (FIPS 180-4 §6.4.2). Shared verbatim by all
// three digests — only the initial `s` and the retained output differ.
function sha512Block(s: []u64, block: []byte, off: int) {
  let k = sha512K()

  // Message schedule W_t: the 16 block words, then 64 recurrences.
  let w = []u64(80)
  let t = 0
  while (t < 16) {
    w[t] = beU64(block, off + t * 8)
    t = t + 1
  }
  while (t < 80) {
    let s0 = rotr64(w[t - 15], 1) ^ rotr64(w[t - 15], 8) ^ (w[t - 15] >> 7)
    let s1 = rotr64(w[t - 2], 19) ^ rotr64(w[t - 2], 61) ^ (w[t - 2] >> 6)
    w[t] = w[t - 16] + s0 + w[t - 7] + s1
    t = t + 1
  }

  let a = s[0]
  let b = s[1]
  let c = s[2]
  let d = s[3]
  let e = s[4]
  let f = s[5]
  let g = s[6]
  let h = s[7]

  t = 0
  while (t < 80) {
    let bigS1 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41)
    let ch = (e & f) ^ (~e & g)
    let t1 = h + bigS1 + ch + k[t] + w[t]
    let bigS0 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39)
    let maj = (a & b) ^ (a & c) ^ (b & c)
    let t2 = bigS0 + maj
    h = g
    g = f
    f = e
    e = d + t1
    d = c
    c = b
    b = a
    a = t1 + t2
    t = t + 1
  }

  s[0] = s[0] + a
  s[1] = s[1] + b
  s[2] = s[2] + c
  s[3] = s[3] + d
  s[4] = s[4] + e
  s[5] = s[5] + f
  s[6] = s[6] + g
  s[7] = s[7] + h
}

// Streaming SHA-512-family state. `h` is the running eight-word chaining value,
// `iv` the constructor's H(0) so `reset` can restore it, `x`/`nx` the partial
// 128-byte block, `nlen` the total bytes absorbed (for the length pad), and
// `outLen` how many leading digest bytes this variant keeps.
struct sha512Digest { h: []u64, iv: []u64, x: []byte, nx: int, nlen: u64, outLen: int }

// A fresh digest starting from `iv`, keeping `outLen` output bytes. `h` is a
// private copy so it can advance while `iv` stays pinned for `reset`.
function newDigest(iv: []u64, outLen: int): sha512Digest {
  let h = []u64(8)
  let i = 0
  while (i < 8) {
    h[i] = iv[i]
    i = i + 1
  }
  return sha512Digest{ h: h, iv: iv, x: []byte(128), nx: 0, nlen: 0, outLen: outLen }
}

function (d: sha512Digest) write(data: []byte) {
  d.nlen = d.nlen + u64(len(data))
  let i = 0
  while (i < len(data)) {
    d.x[d.nx] = data[i]
    d.nx = d.nx + 1
    if (d.nx == 128) {
      sha512Block(d.h, d.x, 0)
      d.nx = 0
    }
    i = i + 1
  }
}

function (d: sha512Digest) sum(): []byte {
  // Finalize on a copy of the state and buffer so streaming can continue after.
  let s = []u64(8)
  let i = 0
  while (i < 8) {
    s[i] = d.h[i]
    i = i + 1
  }

  // Pad: 0x80, zeros, then the 128-bit big-endian bit length. The length owns
  // the final 16 bytes; if 0x80 leaves no room for it, spill into a second
  // block. `nlen * 8` as 128 bits is (nlen >> 61, nlen << 3).
  let n = d.nx
  let padded = 128
  if (n >= 112) {
    padded = 256
  }
  let tail = []byte(padded)
  let j = 0
  while (j < n) {
    tail[j] = d.x[j]
    j = j + 1
  }
  tail[n] = 0x80
  putU64BE(tail, padded - 16, d.nlen >> 61)
  putU64BE(tail, padded - 8, d.nlen << 3)

  sha512Block(s, tail, 0)
  if (padded == 256) {
    sha512Block(s, tail, 128)
  }

  // Emit the first `outLen` bytes; outLen is always a whole number of words.
  let out = []byte(d.outLen)
  let words = d.outLen / 8
  let wi = 0
  while (wi < words) {
    putU64BE(out, wi * 8, s[wi])
    wi = wi + 1
  }
  return out
}

function (d: sha512Digest) reset() {
  let i = 0
  while (i < 8) {
    d.h[i] = d.iv[i]
    i = i + 1
  }
  d.nx = 0
  d.nlen = 0
}

function (d: sha512Digest) size(): int { return d.outLen }

function (d: sha512Digest) blockSize(): int { return 128 }

// A new SHA-512 hasher (64-byte digest, 128-byte block), ready to `write`.
export function newSha512(): Hash { return newDigest(iv512(), 64) }

// A new SHA-384 hasher (48-byte digest, 128-byte block). Same compression as
// SHA-512 with a distinct H(0), truncated to six output words.
export function newSha384(): Hash { return newDigest(iv384(), 48) }

// A new SHA-512/256 hasher (32-byte digest, 128-byte block): SHA-512's engine
// with the FIPS 180-4 §5.3.6 initial value, truncated to four output words. It
// is not SHA-512 truncated — the different H(0) makes it a distinct function.
export function newSha512_256(): Hash { return newDigest(iv512_256(), 32) }
