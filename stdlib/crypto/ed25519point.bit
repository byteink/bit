// Bit standard library — crypto module, Ed25519 group arithmetic on
// preallocated storage (#7167).
//
// Every operation here writes into elements the caller already holds: the
// field temporaries, constants and accumulators live in one `ed25519Ctx`
// allocated per public call (`ed25519Sign`, `ed25519Verify`, ...), so a whole
// scalar multiplication allocates nothing. Points use extended coordinates
// (X:Y:Z:T) with x = X/Z, y = Y/Z, x*y = T/Z and the complete "hwcd" formulas
// for a = -1, so no input needs special-casing.
//
// Scalar multiplication uses a fixed 4-bit window: a table of the sixteen
// multiples 0*P..15*P in the cached form (Y+X, Y-X, Z, 2d*T), then for each of
// the 64 nibbles of the scalar, high to low, four doublings and one addition
// of the table entry. The entry is read by a masked scan of all sixteen, so
// neither the sequence of field operations nor any memory index depends on the
// scalar; the scalar only ever reaches arithmetic masks.

// A curve point in extended coordinates (X:Y:Z:T), x = X/Z, y = Y/Z, T = X*Y/Z.
// Each coordinate is a `field25519.bit` element (a `[]u64` of five 51-bit limbs).
class ed25519Point { X: []u64, Y: []u64, Z: []u64, T: []u64 }

// The words one cached table entry occupies: Y+X, Y-X, Z and 2d*T, five each.
fn ed25519EntryWords(): int { return 20 }

// The words of a whole 16-entry window table.
fn ed25519TableWords(): int { return 320 }

// The scratch of one Ed25519 operation. `a`..`h` are the point-formula
// temporaries, `i1`..`i3` the inversion chain's, `one`/`zero`/`dc`/`d2`/`sqrtM1`
// the field constants, `qp`/`qm`/`qz`/`qt` the table entry being added, `r` and
// `acc` working points, `tb` the base-point window table, `buf` a 32-byte
// encoding, and `sl`/`sr`/`st`/`sx` the scalar-mod-L limbs (`ed25519scalar.bit`).
class ed25519Ctx {
  a: []u64,
  b: []u64,
  c: []u64,
  d: []u64,
  e: []u64,
  f: []u64,
  g: []u64,
  h: []u64,
  i1: []u64,
  i2: []u64,
  i3: []u64,
  one: []u64,
  zero: []u64,
  dc: []u64,
  d2: []u64,
  sqrtM1: []u64,
  qp: []u64,
  qm: []u64,
  qz: []u64,
  qt: []u64,
  r: ed25519Point,
  acc: ed25519Point,
  tb: []u64,
  buf: []byte,
  sl: []u64,
  sr: []u64,
  st: []u64,
  sx: []u64,
}

// A point with fresh, zeroed coordinates.
fn ed25519NewPoint(): ed25519Point {
  return ed25519Point{ X = []u64(5), Y = []u64(5), Z = []u64(5), T = []u64(5) }
}

// The scratch for one public operation; its size never depends on any input.
fn ed25519NewCtx(): ed25519Ctx {
  return ed25519Ctx{
    a = []u64(5),
    b = []u64(5),
    c = []u64(5),
    d = []u64(5),
    e = []u64(5),
    f = []u64(5),
    g = []u64(5),
    h = []u64(5),
    i1 = []u64(5),
    i2 = []u64(5),
    i3 = []u64(5),
    one = []u64{ 1, 0, 0, 0, 0 },
    zero = []u64(5),
    dc = ed25519D(),
    d2 = ed25519D2(),
    sqrtM1 = ed25519SqrtM1(),
    qp = []u64(5),
    qm = []u64(5),
    qz = []u64(5),
    qt = []u64(5),
    r = ed25519NewPoint(),
    acc = ed25519NewPoint(),
    tb = []u64(ed25519TableWords()),
    buf = []byte(32),
    sl = ed25519LLimbs(),
    sr = []u64(8),
    st = []u64(8),
    sx = []u64(16),
  }
}

// p = the neutral element (0, 1).
fn ed25519SetIdentity(c: ed25519Ctx, p: ed25519Point) {
  fe25519Copy(p.X, c.zero)
  fe25519Copy(p.Y, c.one)
  fe25519Copy(p.Z, c.one)
  fe25519Copy(p.T, c.zero)
}

// p = the generator B (Z = 1, so T = Bx*By).
fn ed25519SetBase(c: ed25519Ctx, p: ed25519Point) {
  fe25519Copy(p.X, ed25519BaseX())
  fe25519Copy(p.Y, ed25519BaseY())
  fe25519Copy(p.Z, c.one)
  fe25519MulTo(p.T, p.X, p.Y)
}

// p = 2*p in place, "dbl-2008-hwcd" with a = -1. Every output coordinate is the
// negation of the textbook one (E*-F, -H*G, G*-F, E*-H), the same projective
// point, which saves the negation of X^2.
fn ed25519DoubleTo(c: ed25519Ctx, p: ed25519Point) {
  fe25519SqrTo(c.a, p.X)
  fe25519SqrTo(c.b, p.Y)
  fe25519SqrTo(c.c, p.Z)
  fe25519AddTo(c.c, c.c, c.c)
  fe25519AddTo(c.d, p.X, p.Y)
  fe25519SqrTo(c.d, c.d)
  fe25519SubTo(c.e, c.d, c.b)
  fe25519SubTo(c.e, c.e, c.a) // E = (X+Y)^2 - Y^2 - X^2
  fe25519AddTo(c.f, c.b, c.a) // -H = Y^2 + X^2
  fe25519SubTo(c.g, c.b, c.a) // G = Y^2 - X^2
  fe25519SubTo(c.h, c.c, c.g) // -F = 2Z^2 - G
  fe25519MulTo(p.X, c.e, c.h)
  fe25519MulTo(p.Y, c.f, c.g)
  fe25519MulTo(p.Z, c.g, c.h)
  fe25519MulTo(p.T, c.e, c.f)
}

// p = p + q in place, "add-2008-hwcd-3", where q is the cached entry held in
// `c.qp` (Y+X), `c.qm` (Y-X), `c.qz` (Z) and `c.qt` (2d*T). Complete for a = -1
// with a non-square d, so it is also correct for q == p or either the identity.
fn ed25519AddCached(c: ed25519Ctx, p: ed25519Point) {
  fe25519SubTo(c.a, p.Y, p.X)
  fe25519MulTo(c.a, c.a, c.qm)
  fe25519AddTo(c.b, p.Y, p.X)
  fe25519MulTo(c.b, c.b, c.qp)
  fe25519MulTo(c.c, p.T, c.qt)
  fe25519MulTo(c.d, p.Z, c.qz)
  fe25519AddTo(c.d, c.d, c.d)
  fe25519SubTo(c.e, c.b, c.a)
  fe25519SubTo(c.f, c.d, c.c)
  fe25519AddTo(c.g, c.d, c.c)
  fe25519AddTo(c.h, c.b, c.a)
  fe25519MulTo(p.X, c.e, c.f)
  fe25519MulTo(p.Y, c.g, c.h)
  fe25519MulTo(p.Z, c.f, c.g)
  fe25519MulTo(p.T, c.e, c.h)
}

// Copy the five limbs of `f` into `tbl` at word `off`.
fn ed25519TablePut(tbl: []u64, off: int, f: []u64) {
  let i = 0
  while (i < 5) {
    tbl[off + i] = f[i]
    i = i + 1
  }
}

// Store `p` as table entry `i` in cached form (Y+X, Y-X, Z, 2d*T).
fn ed25519StoreCached(c: ed25519Ctx, tbl: []u64, i: int, p: ed25519Point) {
  let off = i * ed25519EntryWords()
  fe25519AddTo(c.a, p.Y, p.X)
  fe25519SubTo(c.b, p.Y, p.X)
  fe25519MulTo(c.c, p.T, c.d2)
  ed25519TablePut(tbl, off, c.a)
  ed25519TablePut(tbl, off + 5, c.b)
  ed25519TablePut(tbl, off + 10, p.Z)
  ed25519TablePut(tbl, off + 15, c.c)
}

// Fill `tbl` with 0*P..15*P in cached form. Entry 0 is the identity, cached as
// (1, 1, 1, 0). `p` is only read, so it may be `c.r`; `c.acc` is overwritten.
fn ed25519TableBuild(c: ed25519Ctx, tbl: []u64, p: ed25519Point) {
  ed25519SetIdentity(c, c.acc)
  ed25519StoreCached(c, tbl, 0, c.acc)
  fe25519Copy(c.acc.X, p.X)
  fe25519Copy(c.acc.Y, p.Y)
  fe25519Copy(c.acc.Z, p.Z)
  fe25519Copy(c.acc.T, p.T)
  ed25519StoreCached(c, tbl, 1, c.acc)
  let i = 2
  while (i < 16) {
    ed25519TableLoad(c, tbl, 1)
    ed25519AddCached(c, c.acc)
    ed25519StoreCached(c, tbl, i, c.acc)
    i = i + 1
  }
}

// The window table of the generator B.
fn ed25519BaseTable(c: ed25519Ctx) {
  ed25519SetBase(c, c.r)
  ed25519TableBuild(c, c.tb, c.r)
}

// Load table entry `i` (a public index) into `c.qp`..`c.qt`.
fn ed25519TableLoad(c: ed25519Ctx, tbl: []u64, i: int) {
  let off = i * ed25519EntryWords()
  let j = 0
  while (j < 5) {
    c.qp[j] = tbl[off + j]
    c.qm[j] = tbl[off + 5 + j]
    c.qz[j] = tbl[off + 10 + j]
    c.qt[j] = tbl[off + 15 + j]
    j = j + 1
  }
}

// All ones when a == b, zero otherwise, without a branch: x | -x has bit 63 set
// exactly when x != 0.
fn ed25519EqMask(a: u64, b: u64): u64 {
  let x = a ^ b
  return ((x | (u64(0) - x)) >> 63) - 1
}

// Load table entry `idx` (secret) into `c.qp`..`c.qt` by scanning all sixteen
// entries and keeping the one whose mask is all ones: the memory touched and
// the work done are the same for every `idx`.
fn ed25519TableSelect(c: ed25519Ctx, tbl: []u64, idx: u64) {
  ed25519TableLoad(c, tbl, 0)
  let i = 1
  while (i < 16) {
    let m = ed25519EqMask(u64(i), idx)
    let off = i * ed25519EntryWords()
    let j = 0
    while (j < 5) {
      c.qp[j] = (c.qp[j] & ~m) | (tbl[off + j] & m)
      c.qm[j] = (c.qm[j] & ~m) | (tbl[off + 5 + j] & m)
      c.qz[j] = (c.qz[j] & ~m) | (tbl[off + 10 + j] & m)
      c.qt[j] = (c.qt[j] & ~m) | (tbl[off + 15 + j] & m)
      j = j + 1
    }
    i = i + 1
  }
}

// Nibble `j` (0 = least significant) of the 32-byte little-endian scalar `s`.
fn ed25519Nibble(s: []byte, j: int): u64 {
  return (u64(s[j / 2]) >> u64(j % 2 * 4)) & 15
}

// p = 4*p, the doublings between two windows.
fn ed25519Double4(c: ed25519Ctx, p: ed25519Point) {
  ed25519DoubleTo(c, p)
  ed25519DoubleTo(c, p)
  ed25519DoubleTo(c, p)
  ed25519DoubleTo(c, p)
}

// out = [s]P for the table `tbl` of P, constant-time in `s`.
fn ed25519WindowMul(c: ed25519Ctx, out: ed25519Point, tbl: []u64, s: []byte) {
  ed25519SetIdentity(c, out)
  let j = 63
  while (j >= 0) {
    if (j != 63) {
      ed25519Double4(c, out)
    }
    ed25519TableSelect(c, tbl, ed25519Nibble(s, j))
    ed25519AddCached(c, out)
    j = j - 1
  }
}

// out = [sb]B + [s]P for the base table `c.tb` and the table `t` of P, sharing
// the doublings (Straus), constant-time in both scalars.
fn ed25519WindowMul2(c: ed25519Ctx, out: ed25519Point, sb: []byte, t: []u64, s: []byte) {
  ed25519SetIdentity(c, out)
  let j = 63
  while (j >= 0) {
    if (j != 63) {
      ed25519Double4(c, out)
    }
    ed25519TableSelect(c, c.tb, ed25519Nibble(sb, j))
    ed25519AddCached(c, out)
    ed25519TableSelect(c, t, ed25519Nibble(s, j))
    ed25519AddCached(c, out)
    j = j - 1
  }
}

// Encode `p` as 32 bytes (RFC 8032 §5.1.2): little-endian y with the low bit of
// x in bit 255. Z is inverted once to reach affine (x, y). Allocates only the
// returned encoding.
fn ed25519Encode(c: ed25519Ctx, p: ed25519Point): []byte {
  fe25519InvertTo(c.a, p.Z, c.i1, c.i2, c.i3)
  fe25519MulTo(c.b, p.X, c.a)
  fe25519MulTo(c.c, p.Y, c.a)
  let out = []byte(32)
  fe25519PutBytes(out, c.c)
  fe25519PutBytes(c.buf, c.b)
  out[31] = out[31] | ((c.buf[0] & 1) << 7)
  return out
}

// Whether `f` is zero mod p, through its canonical encoding, without a branch on
// any byte.
fn ed25519FeIsZero(c: ed25519Ctx, f: []u64): bool {
  fe25519PutBytes(c.buf, f)
  let acc: u8 = 0
  let i = 0
  while (i < 32) {
    acc = acc | c.buf[i]
    i = i + 1
  }
  return acc == 0
}

// Whether the 32 bytes of `enc` with bit 255 cleared are the canonical encoding
// of `y` (that is, y < p).
fn ed25519IsCanonicalY(c: ed25519Ctx, y: []u64, enc: []byte): bool {
  fe25519PutBytes(c.buf, y)
  let diff: u8 = c.buf[31] ^ (enc[31] & 0x7f)
  let i = 0
  while (i < 31) {
    diff = diff | (c.buf[i] ^ enc[i])
    i = i + 1
  }
  return diff == 0
}

// p.X = the square root candidate x = u*v^3 * (u*v^7)^((p-5)/8) of x^2 = u/v,
// with u in `c.b` and v in `c.c`; leaves v*x^2 in `c.h`.
fn ed25519SqrtRatio(c: ed25519Ctx, p: ed25519Point) {
  fe25519SqrTo(c.d, c.c)
  fe25519MulTo(c.d, c.d, c.c) // v^3
  fe25519SqrTo(c.e, c.d)
  fe25519MulTo(c.e, c.e, c.c) // v^7
  fe25519MulTo(c.e, c.b, c.e) // u*v^7
  fe25519Pow22501(c.f, c.i1, c.i2, c.i3, c.e)
  fe25519SqNTo(c.f, 2)
  fe25519MulTo(c.f, c.f, c.e) // (u*v^7)^(2^252 - 3)
  fe25519MulTo(c.g, c.b, c.d) // u*v^3
  fe25519MulTo(p.X, c.g, c.f)
  fe25519SqrTo(c.h, p.X)
  fe25519MulTo(c.h, c.c, c.h) // v*x^2
}

// Decode a 32-byte encoding into `p` (RFC 8032 §5.1.3), recovering x from y.
// Returns 0 on success, 1 for a wrong length, 2 for a non-canonical encoding
// (y >= p, or x = 0 with the sign bit set), 3 for a y with no x on the curve.
fn ed25519DecodeTo(c: ed25519Ctx, p: ed25519Point, enc: []byte): int {
  if (len(enc) != 32) {
    return 1
  }
  let sign = (enc[31] >> 7) & 1
  fe25519FromBytesTo(p.Y, enc)
  if (!ed25519IsCanonicalY(c, p.Y, enc)) {
    return 2
  }
  // x^2 = u/v with u = y^2 - 1 and v = d*y^2 + 1.
  fe25519SqrTo(c.a, p.Y)
  fe25519SubTo(c.b, c.a, c.one)
  fe25519MulTo(c.c, c.dc, c.a)
  fe25519AddTo(c.c, c.c, c.one)
  ed25519SqrtRatio(c, p)
  // v*x^2 == u: x is right. v*x^2 == -u: x*sqrt(-1) is. Otherwise no root.
  fe25519SubTo(c.g, c.h, c.b)
  if (!ed25519FeIsZero(c, c.g)) {
    fe25519AddTo(c.g, c.h, c.b)
    if (!ed25519FeIsZero(c, c.g)) {
      return 3
    }
    fe25519MulTo(p.X, p.X, c.sqrtM1)
  }
  if (ed25519FeIsZero(c, p.X) && sign == 1) {
    return 2
  }
  fe25519PutBytes(c.buf, p.X)
  if ((c.buf[0] & 1) != sign) {
    fe25519SubTo(p.X, c.zero, p.X)
  }
  fe25519Copy(p.Z, c.one)
  fe25519MulTo(p.T, p.X, p.Y)
  return 0
}
