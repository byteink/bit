// Bit standard library — crypto module, the streaming Hash contract.
//
// `Hash` is a Go-style structural interface (§14.3): any concrete digest —
// SHA-256, SHA-512, and friends land as separate types — satisfies it simply by
// having these five methods, no `implements` clause. It is a *streaming* API:
// feed bytes with repeated `write`, then read the digest with `sum`; `reset`
// rewinds to the empty state so one value can hash many messages.
//
// `size` is the digest length in bytes (32 for SHA-256); `blockSize` is the
// algorithm's internal block size in bytes (64 for SHA-256) — HMAC keys the
// block, so it must be able to ask.

export interface Hash { write(data: []byte), sum(): []byte, reset(), size(): int, blockSize(): int }

// One-shot digest: reset to empty, absorb `data`, return the final digest.
// A convenience over the streaming methods for the common single-buffer case.
export function digest(h: Hash, data: []byte): []byte {
  h.reset()
  h.write(data)
  return h.sum()
}
