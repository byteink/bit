// Bit standard library — crypto module, Argon2 (RFC 9106).
//
// Argon2 is the memory-hard password-hashing and key-derivation function that
// won the Password Hashing Competition. Where PBKDF2 and bcrypt cost only CPU
// time, Argon2 also forces an attacker to hold a large block of memory for the
// whole computation, so a massively parallel guesser (GPU/ASIC) gains far less.
// It ships in three flavours that differ only in how each memory block picks the
// block it mixes with:
//
//   - Argon2d  — data-*dependent* indexing (the reference block is chosen from
//     the previous block's own bytes). Fastest and most GPU-resistant, but the
//     memory-access pattern depends on the password, so it can leak through a
//     side channel. For settings with no side-channel threat (e.g. a KDF over a
//     secret already in memory).
//   - Argon2i  — data-*independent* indexing (the reference block comes from a
//     password-independent pseudo-random stream generated in counter mode).
//     Side-channel resistant, so the access pattern reveals nothing; needs more
//     passes to match Argon2d's resistance. For password hashing on shared hosts.
//   - Argon2id — the hybrid RFC 9106 recommends: data-independent for the first
//     half of the first pass, data-dependent thereafter. The best of both.
//
// The whole thing is built on BLAKE2b (`newBlake2b`, this module): H0 is a
// BLAKE2b digest of all the inputs, the variable-length hash H' stretches short
// digests to any length by chaining BLAKE2b, and the compression `G` is BLAKE2b's
// round function (with an extra 32x32->64 multiply, "BlaMka") run over a
// 1 KiB / 128-word block. Parameters follow RFC 9106 §3.1: t passes (time), m
// KiB of memory, p lanes (parallelism), plus salt, an optional secret key K, and
// optional associated data X. All are folded into H0, so any change reshuffles
// the entire output.
//
// ponytail: the p lanes are filled *serially*, one after another within each of
// the four slices, rather than on p green threads. Argon2's four sync points make
// this byte-for-byte identical to the parallel schedule — a segment in slice s
// only ever references blocks from slices < s (other lanes) or its own lane — so
// the serial fill is a valid, simpler implementation of the same function, just
// without the parallel speedup. `argon2FillSegment` is where a `spawn` per lane
// would slot in if that speedup is ever wanted.
//
// This file is part of the flat `std/crypto` module, so it names `newBlake2b`,
// `digest`, `ctEq`, `encodeBase64`/`decodeBase64`, `assert`, and `newError`
// from its siblings and the prelude without importing them.

// Argon2 version 0x13 (19), the only one implemented. Version 0x10 differs in the
// pass>0 block update and is obsolete.
fn argon2Version(): int { return 19 }

// Store `v`'s low 32 bits into `buf` at `off`, little-endian (RFC 9106's LE32).
fn argon2PutLE32(buf: []byte, off: int, v: int) {
  buf[off] = byte(v)
  buf[off + 1] = byte(v >> 8)
  buf[off + 2] = byte(v >> 16)
  buf[off + 3] = byte(v >> 24)
}

// Append `LE32(len(data)) || data` to `buf` starting at `off`; return the new
// offset. This is the length-prefixed encoding H0 uses for each variable field.
fn argon2PutField(buf: []byte, off: int, data: []byte): int {
  argon2PutLE32(buf, off, len(data))
  let at = off + 4
  let i = 0
  while (i < len(data)) {
    buf[at + i] = data[i]
    i = i + 1
  }
  return at + len(data)
}

// The BLAKE2b digest of `data` to `outLen` bytes (1..64), unkeyed — the only hash
// primitive Argon2 uses.
fn argon2Blake2b(data: []byte, outLen: int): []byte {
  return digest(newBlake2b(outLen, []byte(0)), data)
}

// The variable-length hash H' (RFC 9106 §3.3): a BLAKE2b-based function producing
// `outLen` bytes for any `outLen >= 1`. For `outLen <= 64` it is one BLAKE2b over
// `LE32(outLen) || x`. For longer outputs it chains 64-byte BLAKE2b digests,
// emitting the low 32 bytes of each and a final short digest, so the result is
// exactly `outLen` bytes. Used for the 1 KiB initial blocks and the final tag.
fn argon2HPrime(x: []byte, outLen: int): []byte {
  let inp = []byte(4 + len(x))
  argon2PutLE32(inp, 0, outLen)
  let i = 0
  while (i < len(x)) {
    inp[4 + i] = x[i]
    i = i + 1
  }
  if (outLen <= 64) {
    return argon2Blake2b(inp, outLen)
  }

  // r = ceil(outLen/32) - 2 full 32-byte chunks, then a final (outLen - 32r)-byte
  // chunk. Each V is the BLAKE2b-512 of the previous; A_i is V_i's low 32 bytes.
  let r = (outLen + 31) / 32 - 2
  let out = []byte(outLen)
  let v = argon2Blake2b(inp, 64)
  argon2Copy(out, 0, v, 32)
  let pos = 32
  let bi = 1
  while (bi < r) {
    v = argon2Blake2b(v, 64)
    argon2Copy(out, pos, v, 32)
    pos = pos + 32
    bi = bi + 1
  }
  let lastLen = outLen - 32 * r
  let last = argon2Blake2b(v, lastLen)
  argon2Copy(out, pos, last, lastLen)
  return out
}

// Copy the first `n` bytes of `src` into `dst` starting at `off`.
fn argon2Copy(dst: []byte, off: int, src: []byte, n: int) {
  let i = 0
  while (i < n) {
    dst[off + i] = src[i]
    i = i + 1
  }
}

// H0 (RFC 9106 §3.2): the 64-byte BLAKE2b seed over every parameter and input —
// LE32 of p, tag length, m, t, version, and type, then each of password, salt,
// secret K, and associated data X length-prefixed. Every block ultimately
// derives from H0, so all inputs affect all output.
fn argon2H0(
  password: []byte,
  salt: []byte,
  secret: []byte,
  ad: []byte,
  t: int,
  m: int,
  p: int,
  outLen: int,
  typ: int,
): []byte {
  let n = 24 + 16 + len(password) + len(salt) + len(secret) + len(ad)
  let buf = []byte(n)
  argon2PutLE32(buf, 0, p)
  argon2PutLE32(buf, 4, outLen)
  argon2PutLE32(buf, 8, m)
  argon2PutLE32(buf, 12, t)
  argon2PutLE32(buf, 16, argon2Version())
  argon2PutLE32(buf, 20, typ)
  let o = argon2PutField(buf, 24, password)
  o = argon2PutField(buf, o, salt)
  o = argon2PutField(buf, o, secret)
  o = argon2PutField(buf, o, ad)
  return argon2Blake2b(buf, 64)
}

// The BlaMka mixing primitive: `x + y + 2*xL*yL` mod 2^64, where xL/yL are the
// low 32 bits (RFC 9106 §3.4). The extra multiply is what makes `G` resist
// time-memory trade-offs. `prod + prod` doubles without a literal-typed multiply.
fn argon2FBlaMka(x: u64, y: u64): u64 {
  let prod = (x & 0xffffffff) * (y & 0xffffffff)
  return x + y + prod + prod
}

// The Argon2 GB function (RFC 9106 §3.4): BLAKE2b's mixing step with BlaMka
// additions, over the four words `v[a], v[b], v[c], v[d]`. Mutates `v` in place.
// Rotation distances 32, 24, 16, 63 match BLAKE2b; `blake2Rotr64` is this module's
// own right-rotate.
fn argon2GB(v: []u64, a: int, b: int, c: int, d: int) {
  v[a] = argon2FBlaMka(v[a], v[b])
  v[d] = blake2Rotr64(v[d] ^ v[a], 32)
  v[c] = argon2FBlaMka(v[c], v[d])
  v[b] = blake2Rotr64(v[b] ^ v[c], 24)
  v[a] = argon2FBlaMka(v[a], v[b])
  v[d] = blake2Rotr64(v[d] ^ v[a], 16)
  v[c] = argon2FBlaMka(v[c], v[d])
  v[b] = blake2Rotr64(v[b] ^ v[c], 63)
}

// Permutation P (RFC 9106 §3.4): the BLAKE2b round over 16 consecutive words of
// `v` starting at `o` — four column steps then four diagonal steps.
fn argon2P(v: []u64, o: int) {
  argon2GB(v, o + 0, o + 4, o + 8, o + 12)
  argon2GB(v, o + 1, o + 5, o + 9, o + 13)
  argon2GB(v, o + 2, o + 6, o + 10, o + 14)
  argon2GB(v, o + 3, o + 7, o + 11, o + 15)
  argon2GB(v, o + 0, o + 5, o + 10, o + 15)
  argon2GB(v, o + 1, o + 6, o + 11, o + 12)
  argon2GB(v, o + 2, o + 7, o + 8, o + 13)
  argon2GB(v, o + 3, o + 4, o + 9, o + 14)
}

// Permutation P over column `c` of the block's 8x8 register matrix. Column `c`
// gathers the two words of registers c, c+8, ..., c+56 (stride 16), runs P, and
// scatters them back — the column pass of the compression's two-round structure.
fn argon2Pcol(v: []u64, c: int) {
  let t = []u64(16)
  let j = 0
  while (j < 8) {
    let base = 2 * c + 16 * j
    t[2 * j] = v[base]
    t[2 * j + 1] = v[base + 1]
    j = j + 1
  }
  argon2P(t, 0)
  j = 0
  while (j < 8) {
    let base = 2 * c + 16 * j
    v[base] = t[2 * j]
    v[base + 1] = t[2 * j + 1]
    j = j + 1
  }
}

// The compression function G (RFC 9106 §3.4). Reads the two 128-word input blocks
// at word offsets `xoff` and `yoff` in `mem`, computes R = X XOR Y, applies P to
// every row of R and then to every column of the result (Z), and writes Z XOR R
// to the block at `outoff`. With `withXor`, the new block is XORed into the old
// value there (the pass>1 update for version 0x13) instead of overwriting it.
// R and Z are snapshotted into local buffers before any write, so an aliased
// `yoff == outoff` (used by address generation) stays correct.
fn argon2G(mem: []u64, xoff: int, yoff: int, outoff: int, withXor: bool) {
  let r = []u64(128)
  let i = 0
  while (i < 128) {
    r[i] = mem[xoff + i] ^ mem[yoff + i]
    i = i + 1
  }
  let q = []u64(128)
  i = 0
  while (i < 128) {
    q[i] = r[i]
    i = i + 1
  }
  i = 0
  while (i < 8) {
    argon2P(q, i * 16)
    i = i + 1
  }
  i = 0
  while (i < 8) {
    argon2Pcol(q, i)
    i = i + 1
  }
  i = 0
  while (i < 128) {
    let z = q[i] ^ r[i]
    if (withXor) {
      mem[outoff + i] = mem[outoff + i] ^ z
    } else {
      mem[outoff + i] = z
    }
    i = i + 1
  }
}

// Load 1024 bytes of `b` as 128 little-endian u64 words into `mem` at `off`.
fn argon2LoadBlock(mem: []u64, off: int, b: []byte) {
  let i = 0
  while (i < 128) {
    let j = i * 8
    let w: u64 = 0
    let k = 0
    while (k < 8) {
      w = w | (u64(b[j + k]) << u64(k * 8))
      k = k + 1
    }
    mem[off + i] = w
    i = i + 1
  }
}

// Serialize the 128-word block at `off` to 1024 little-endian bytes in `out`.
fn argon2StoreBlock(mem: []u64, off: int, out: []byte) {
  let i = 0
  while (i < 128) {
    let w = mem[off + i]
    let j = i * 8
    let k = 0
    while (k < 8) {
      out[j + k] = byte(w >> u64(k * 8))
      k = k + 1
    }
    i = i + 1
  }
}

// The two starting blocks of each lane (RFC 9106 §3.2): B[l][0] and B[l][1] are
// H'(H0 || LE32(col) || LE32(l)) to 1024 bytes, loaded into `mem`. `laneLength`
// is the column count q.
fn argon2InitBlocks(mem: []u64, h0: []byte, lanes: int, laneLength: int) {
  let seed = []byte(72)
  argon2Copy(seed, 0, h0, 64)
  let lane = 0
  while (lane < lanes) {
    argon2PutLE32(seed, 68, lane)
    let col = 0
    while (col < 2) {
      argon2PutLE32(seed, 64, col)
      let blk = argon2HPrime(seed, 1024)
      argon2LoadBlock(mem, (lane * laneLength + col) * 128, blk)
      col = col + 1
    }
    lane = lane + 1
  }
}

// Regenerate the address block for data-independent (Argon2i / Argon2id) indexing
// (RFC 9106 §3.4.1.2). `ab` is a 384-word scratch: words [0,128) the zero block,
// [128,256) the input block (counter at 128+6), [256,384) the address block.
// The address block is G(zero, G(zero, input)) after bumping the counter.
fn argon2NextAddresses(ab: []u64) {
  ab[128 + 6] = ab[128 + 6] + 1
  argon2G(ab, 0, 128, 256, false)
  argon2G(ab, 0, 256, 256, false)
}

// Map a 32-bit pseudo-random value `j1` to a reference column (RFC 9106 §3.4.1.1).
// `refArea` blocks are eligible; the quadratic map biases toward recent blocks.
// `start` is the segment offset for pass>0, and the result wraps within the lane.
fn argon2RefColumn(j1: u64, refArea: int, start: int, laneLength: int): int {
  let x = (j1 * j1) >> 32
  let area = u64(refArea)
  let rel = area - 1 - ((area * x) >> 32)
  return (start + int(rel)) % laneLength
}

// The number of eligible reference blocks for the block at segment index `index`
// (RFC 9106 §3.4.1.1), depending on pass, slice, and whether the reference lane is
// the current one. Always >= 1 for valid parameters (m >= 8p gives q >= 8).
fn argon2RefArea(
  pass: int,
  slice: int,
  index: int,
  laneLength: int,
  segLength: int,
  sameLane: bool,
): int {
  if (pass == 0) {
    if (slice == 0) {
      return index - 1
    }
    if (sameLane) {
      return slice * segLength + index - 1
    }
    if (index == 0) {
      return slice * segLength - 1
    }
    return slice * segLength
  }
  if (sameLane) {
    return laneLength - segLength + index - 1
  }
  if (index == 0) {
    return laneLength - segLength - 1
  }
  return laneLength - segLength
}

// Fill one segment: the `segLength` blocks of lane `lane`, slice `slice`, in pass
// `pass` (RFC 9106 §3.4). Each block B[lane][col] = G(prev, ref), XORed into the
// old block after the first pass. The reference block is chosen data-dependently
// for Argon2d (and Argon2id past the first half-pass) from the previous block, or
// data-independently for Argon2i (and early Argon2id) from a counter-mode stream.
fn argon2FillSegment(
  mem: []u64,
  pass: int,
  slice: int,
  lane: int,
  laneLength: int,
  segLength: int,
  totalBlocks: int,
  lanes: int,
  passes: int,
  typ: int,
) {
  let dataIndep = typ == 1 || (typ == 2 && pass == 0 && slice < 2)

  let ab = []u64(0)
  if (dataIndep) {
    ab = []u64(384)
    ab[128 + 0] = u64(pass)
    ab[128 + 1] = u64(lane)
    ab[128 + 2] = u64(slice)
    ab[128 + 3] = u64(totalBlocks)
    ab[128 + 4] = u64(passes)
    ab[128 + 5] = u64(typ)
  }

  let start = 0
  if (pass == 0 && slice == 0) {
    start = 2
    if (dataIndep) {
      argon2NextAddresses(ab)
    }
  }

  let i = start
  while (i < segLength) {
    argon2FillColumn(mem, ab, dataIndep, pass, slice, lane, laneLength, segLength, lanes, i)
    i = i + 1
  }
}

// Fill column `i` of the segment (RFC 9106 §3.4): derive the reference block
// from either the address-block stream (data-independent) or the previous
// block itself (data-dependent), then run G into the current block. Split out
// of `argon2FillSegment` (#2448) to keep the per-segment setup and the
// per-column body each under E0204's complexity ceiling.
fn argon2FillColumn(
  mem: []u64,
  ab: []u64,
  dataIndep: bool,
  pass: int,
  slice: int,
  lane: int,
  laneLength: int,
  segLength: int,
  lanes: int,
  i: int,
) {
  let col = slice * segLength + i
  let prevCol = col - 1
  if (col == 0) {
    prevCol = laneLength - 1
  }
  let prevOff = (lane * laneLength + prevCol) * 128

  let pseudo: u64 = 0
  if (dataIndep) {
    if (i % 128 == 0) {
      argon2NextAddresses(ab)
    }
    pseudo = ab[256 + i % 128]
  } else {
    pseudo = mem[prevOff]
  }

  let refLane = int((pseudo >> 32) % u64(lanes))
  if (pass == 0 && slice == 0) {
    refLane = lane
  }
  let sameLane = refLane == lane
  let refArea = argon2RefArea(pass, slice, i, laneLength, segLength, sameLane)
  let segStart = 0
  if (pass != 0 && slice != 3) {
    segStart = (slice + 1) * segLength
  }
  let refCol = argon2RefColumn(pseudo & 0xffffffff, refArea, segStart, laneLength)
  let refOff = (refLane * laneLength + refCol) * 128

  let currOff = (lane * laneLength + col) * 128
  argon2G(mem, prevOff, refOff, currOff, pass != 0)
}

// The final tag (RFC 9106 §3.2): XOR the last column of every lane into one
// 1024-byte block C, then return H'(C) to `outLen` bytes.
fn argon2Finalize(mem: []u64, lanes: int, laneLength: int, outLen: int): []byte {
  let c = []u64(128)
  let lane = 0
  while (lane < lanes) {
    let off = (lane * laneLength + laneLength - 1) * 128
    let i = 0
    while (i < 128) {
      c[i] = c[i] ^ mem[off + i]
      i = i + 1
    }
    lane = lane + 1
  }
  let cb = []byte(1024)
  argon2StoreBlock(c, 0, cb)
  return argon2HPrime(cb, outLen)
}

// The Argon2 core over all three types (`typ`: 0 = Argon2d, 1 = Argon2i, 2 =
// Argon2id). Validates the parameter ranges, allocates the m'-block memory,
// seeds it from H0, runs `t` passes over the four slices of every lane, and folds
// the last column into the `outLen`-byte tag. `secret` (K) and `ad` (X) may be
// empty. Panics on an out-of-range parameter — a caller error, not a runtime one.
fn argon2Core(
  password: []byte,
  salt: []byte,
  secret: []byte,
  ad: []byte,
  t: int,
  m: int,
  p: int,
  outLen: int,
  typ: int,
): []byte {
  assert(p >= 1, "argon2: p (parallelism) must be >= 1")
  assert(t >= 1, "argon2: t (passes) must be >= 1")
  assert(outLen >= 4, "argon2: outLen (tag) must be >= 4")
  assert(len(salt) >= 8, "argon2: salt must be at least 8 bytes")
  assert(m >= 8 * p, "argon2: m (KiB) must be >= 8*p")

  // m' = 4p * floor(m / 4p): the block count, a multiple of 4p. q columns per
  // lane, four slices of segLength blocks each.
  let totalBlocks = 4 * p * (m / (4 * p))
  let laneLength = totalBlocks / p
  let segLength = laneLength / 4
  let mem = []u64(totalBlocks * 128)

  let h0 = argon2H0(password, salt, secret, ad, t, m, p, outLen, typ)
  argon2InitBlocks(mem, h0, p, laneLength)

  let pass = 0
  while (pass < t) {
    let slice = 0
    while (slice < 4) {
      let lane = 0
      while (lane < p) {
        argon2FillSegment(mem, pass, slice, lane, laneLength, segLength, totalBlocks, p, t, typ)
        lane = lane + 1
      }
      slice = slice + 1
    }
    pass = pass + 1
  }
  return argon2Finalize(mem, p, laneLength, outLen)
}

// Argon2d (RFC 9106): data-dependent indexing, `outLen`-byte tag. `secret` (K) and
// `ad` (X) may be empty (`[]byte(0)`). Fastest and most GPU-resistant, but its
// memory access depends on the password — use only where a side channel is not a
// threat (e.g. deriving a key from an already-secret value).
export fn argon2d(
  password: []byte,
  salt: []byte,
  secret: []byte,
  ad: []byte,
  t: int,
  m: int,
  p: int,
  outLen: int,
): []byte { return argon2Core(password, salt, secret, ad, t, m, p, outLen, 0) }

// Argon2i (RFC 9106): data-independent indexing, `outLen`-byte tag. Its
// memory-access pattern reveals nothing about the password, so it resists side
// channels; use it for password hashing on shared or observable hosts.
export fn argon2i(
  password: []byte,
  salt: []byte,
  secret: []byte,
  ad: []byte,
  t: int,
  m: int,
  p: int,
  outLen: int,
): []byte { return argon2Core(password, salt, secret, ad, t, m, p, outLen, 1) }

// Argon2id (RFC 9106): the recommended hybrid — data-independent for the first
// half of the first pass, data-dependent after. `outLen`-byte tag; `secret` (K)
// and `ad` (X) may be empty. Prefer this unless you have a specific reason not to.
export fn argon2id(
  password: []byte,
  salt: []byte,
  secret: []byte,
  ad: []byte,
  t: int,
  m: int,
  p: int,
  outLen: int,
): []byte { return argon2Core(password, salt, secret, ad, t, m, p, outLen, 2) }

// Standard-alphabet base64 without padding, the PHC string encoding. Reuses the
// module's padded `encodeBase64` and strips the trailing '='.
fn argon2B64Encode(b: []byte): string {
  let s = encodeBase64(b)
  let n = len(s)
  while (n > 0 && s[n - 1] == '=') {
    n = n - 1
  }
  return s[0:n]
}

// Decode unpadded standard base64 (PHC) by re-adding the padding `decodeBase64`
// needs. Fails on an impossible length or an out-of-alphabet character.
fn argon2B64Decode(s: string): []byte! {
  let rem = len(s) % 4
  if (rem == 1) {
    fail newError("argon2: invalid base64 length")
  }
  let padded = s
  if (rem == 2) {
    padded = s + "=="
  } else if (rem == 3) {
    padded = s + "="
  }
  return decodeBase64(padded)?
}

// Split `s` on the byte `sep` into its fields (one more than the separator count).
fn argon2Split(s: string, sep: byte): []string {
  let count = 1
  let i = 0
  while (i < len(s)) {
    if (s[i] == sep) {
      count = count + 1
    }
    i = i + 1
  }
  let out = []string(count)
  let idx = 0
  let start = 0
  i = 0
  while (i < len(s)) {
    if (s[i] == sep) {
      out[idx] = s[start:i]
      idx = idx + 1
      start = i + 1
    }
    i = i + 1
  }
  out[idx] = s[start:len(s)]
  return out
}

// Parse a non-negative decimal integer, failing on an empty string or a non-digit.
fn argon2ParseInt(s: string): int! {
  if (len(s) == 0) {
    fail newError("argon2: empty integer field")
  }
  let v = 0
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c < '0' || c > '9') {
      fail newError("argon2: non-digit in integer field")
    }
    v = v * 10 + int(c - '0')
    i = i + 1
  }
  return v
}

// Parse a `key=value` integer field, checking the `prefix` and parsing the rest.
fn argon2FieldInt(s: string, prefix: string): int! {
  if (len(s) < len(prefix)) {
    fail newError("argon2: field too short")
  }
  let i = 0
  while (i < len(prefix)) {
    if (s[i] != prefix[i]) {
      fail newError("argon2: unexpected field")
    }
    i = i + 1
  }
  return argon2ParseInt(s[len(prefix):len(s)])?
}

// Hash `password` with Argon2id and a caller-supplied `salt`, returning the PHC
// crypt string `$argon2id$v=19$m=<m>,t=<t>,p=<p>$<salt>$<tag>` (base64, unpadded).
// `t`, `m` (KiB), `p`, and `outLen` are the cost and tag-length parameters; store
// the returned string and check a login with `argon2Verify`. The salt should be a
// fresh 16-byte `randomBytes(16)` per password.
export fn argon2Hash(password: []byte, salt: []byte, t: int, m: int, p: int, outLen: int): string {
  let raw = argon2id(password, salt, []byte(0), []byte(0), t, m, p, outLen)
  let sb = argon2B64Encode(salt)
  let hb = argon2B64Encode(raw)
  return "$argon2id$v=19$m=${m},t=${t},p=${p}$${sb}$${hb}"
}

// The fields of a parsed PHC Argon2 string (`$argon2id$v=19$m=...,t=...,p=...$salt$tag`).
class Argon2Fields {
  typ: int,
  m: int,
  t: int,
  p: int,
  salt: []byte,
  expected: []byte,
}

// The Argon2 type tag (`argon2d`/`argon2i`/`argon2id`) as `argon2Core`'s `typ`
// parameter (0/1/2). Fails on any other tag.
fn argon2ParseType(tag: string): int! {
  if (tag == "argon2d") {
    return 0
  }
  if (tag == "argon2i") {
    return 1
  }
  if (tag == "argon2id") {
    return 2
  }
  fail newError("argon2: unknown type")
}

// Parse and validate every field of a PHC Argon2 string, without computing the
// tag. Split out of `argon2Verify` (#2448) so the parse — which fails on the
// first malformed field, exactly like the original early-return chain — and
// the constant-time compare are each their own function, under E0204's
// complexity ceiling.
fn argon2ParseEncoded(encoded: string): Argon2Fields! {
  let parts = argon2Split(encoded, '$')
  if (len(parts) != 6 || parts[0] != "") {
    fail newError("argon2: bad field count")
  }

  let typ = argon2ParseType(parts[1])?
  let ver = argon2FieldInt(parts[2], "v=")?
  if (ver != 19) {
    fail newError("argon2: unsupported version")
  }

  let params = argon2Split(parts[3], ',')
  if (len(params) != 3) {
    fail newError("argon2: bad param count")
  }
  let m = argon2FieldInt(params[0], "m=")?
  let t = argon2FieldInt(params[1], "t=")?
  let p = argon2FieldInt(params[2], "p=")?
  if (m < 8 * p || t < 1 || p < 1) {
    fail newError("argon2: bad params")
  }

  let salt = argon2B64Decode(parts[4])?
  let expected = argon2B64Decode(parts[5])?
  if (len(salt) < 8 || len(expected) < 4) {
    fail newError("argon2: bad salt/tag length")
  }

  return Argon2Fields{ typ: typ, m: m, t: t, p: p, salt: salt, expected: expected }
}

// Report whether `password` matches the PHC Argon2 string `encoded`. Parses the
// type, version, parameters, salt, and tag out of `encoded`, recomputes the tag,
// and compares it in constant time (`ctEq`). Accepts `$argon2d`/`$argon2i`/
// `$argon2id`. Returns `false` — never fails or panics — for any malformed input:
// wrong field count, unknown type, version other than 19, non-numeric parameter,
// or an undecodable salt or tag.
export fn argon2Verify(password: []byte, encoded: string): bool {
  let f = argon2ParseEncoded(encoded) catch _ {
    return false
  }
  let got = argon2Core(
    password,
    f.salt,
    []byte(0),
    []byte(0),
    f.t,
    f.m,
    f.p,
    len(f.expected),
    f.typ,
  )
  return ctEq(got, f.expected)
}
