// Bit standard library — crypto module, X25519 Diffie-Hellman (RFC 7748).
//
// X25519 is the ECDH function on Curve25519: given a 32-byte scalar and the
// 32-byte x-coordinate ("u") of a point, it returns the 32-byte x-coordinate of
// the scalar multiple. It is the (EC)DHE primitive TLS 1.3 (#1203) leans on —
// each side owns a scalar, publishes `scalar * basepoint`, and both derive the
// same `scalarA * scalarB * basepoint` whose x-coordinate is the shared secret.
//
// Everything is x-only: no y-coordinate, no point encoding, no cofactor step —
// the curve is engineered so the scalar clamp (below) handles the cofactor. The
// whole computation is a Montgomery ladder over the `fe25519*` field in
// `field25519.bit`, so it inherits that field's constant-time property. The two
// data-dependent decisions the ladder would otherwise make — which of the two
// running points to advance each bit — are made with a branchless `cswap`
// (masked XOR exchange), never an `if`, so no branch or memory index depends on
// a scalar bit.
//
// Clamping (RFC 7748 §5): the scalar's low 3 bits are cleared (multiply by the
// cofactor 8, killing any small-subgroup component), bit 255 is cleared and bit
// 254 is set (fix the position of the leading 1 so the ladder is a fixed 255
// steps and the result is timing-flat). Clamping is done on a private copy; the
// caller's scalar slice is never mutated, and the stored private key stays the
// raw random bytes (the libsodium / RFC convention — clamp on use, not on store).
//
// Ladder step formulation: this uses the ref10 sequence, which folds the curve
// constant in as 121666 against `BB = (x2-z2)^2` rather than 121665 against
// `AA = (x2+z2)^2`. The two are algebraically identical
// (BB + 121666*E == AA + 121665*E, where E = AA - BB), and the 121666 form is
// exactly what `fe25519Mul121666` implements — see field25519.bit.
//
// Contributory behaviour: `x25519` is the raw RFC primitive and returns an
// all-zero result when the input point has small order (the RFC-defined output
// for those points). `x25519SharedSecret` layers the standard defence on top —
// it rejects an all-zero shared secret, which a key-agreement protocol must
// treat as fatal (TLS 1.3, RFC 8446 §7.4.2, aborts the handshake on all-zero).
//
// Being part of the flat `std/crypto` module, this file reaches the `fe25519*`
// field API, `randomBytes`, and `encodeHex`/`decodeHex` without importing them,
// and names `newError` from the prelude. Every private free function is prefixed
// `x25519` to keep the module's flat namespace clean.

// An X25519 key pair. `priv` is the 32 raw random private bytes (clamped only
// when used, never as stored); `pub` is `priv * basepoint`, the 32-byte value
// to hand to a peer. Bit tuples are not yet lowerable, so the two outputs travel
// as a struct — which, unlike a tuple, also gets to name its halves.
export struct X25519Keypair { export priv: []byte, export pub: []byte }

// Constant-time conditional swap of two field elements. `swap` is 0 or 1; the
// mask is all-ones exactly when `swap == 1` (unsigned `0 - 1` wraps to the full
// word), so `a` and `b` exchange limbs when `swap == 1` and are untouched when
// `swap == 0`, with no branch on the scalar bit that produced `swap`.
function x25519Cswap(swap: u64, a: []u64, b: []u64) {
  let mask: u64 = 0 - swap
  let i = 0
  while (i < 5) {
    let t = mask & (a[i] ^ b[i])
    a[i] = a[i] ^ t
    b[i] = b[i] ^ t
    i = i + 1
  }
}

// Whether every byte of `b` is zero, folded branch-free so the check does not
// leak where the first nonzero byte sits.
function x25519IsAllZero(b: []byte): bool {
  let acc: byte = 0
  let i = 0
  while (i < len(b)) {
    acc = acc | b[i]
    i = i + 1
  }
  return acc == 0
}

// X25519 scalar multiplication (RFC 7748 §5): the 32-byte x-coordinate of
// `scalar * point`, where `point` is given by its 32-byte little-endian
// x-coordinate `uCoord`. Both `scalar` and `uCoord` must be at least 32 bytes.
//
// This is the raw primitive: it clamps the scalar, runs the constant-time
// Montgomery ladder, and returns the canonical encoding of the resulting
// x-coordinate. A small-order input point yields an all-zero result (the
// RFC-defined output); `x25519SharedSecret` is the checked wrapper that rejects
// that case for key agreement.
export function x25519(scalar: []byte, uCoord: []byte): []byte {
  // Clamp a private copy; never mutate the caller's scalar.
  let e = []byte(32)
  let i = 0
  while (i < 32) {
    e[i] = scalar[i]
    i = i + 1
  }
  e[0] = e[0] & 248
  e[31] = e[31] & 127
  e[31] = e[31] | 64

  // x1 = u (kept constant); (x2, z2) = point at infinity = (1, 0);
  // (x3, z3) = the input point = (u, 1).
  let x1 = fe25519FromBytes(uCoord)
  let x2 = []u64(5)
  x2[0] = 1
  let z2 = []u64(5)
  let x3 = fe25519FromBytes(uCoord)
  let z3 = []u64(5)
  z3[0] = 1
  let swap: u64 = 0

  // Fixed 255 steps over scalar bits 254..0. `swap` tracks whether the running
  // pair is currently exchanged, so a single cswap per bit suffices.
  let pos = 254
  while (pos >= 0) {
    let kt = (u64(e[pos >> 3]) >> u64(pos & 7)) & 1
    swap = swap ^ kt
    x25519Cswap(swap, x2, x3)
    x25519Cswap(swap, z2, z3)
    swap = kt

    // ref10 differential-addition-and-doubling step.
    let tmp0 = fe25519Sub(x3, z3) // D  = x3 - z3
    let tmp1 = fe25519Sub(x2, z2) // B  = x2 - z2
    x2 = fe25519Add(x2, z2) // A  = x2 + z2
    z2 = fe25519Add(x3, z3) // C  = x3 + z3
    z3 = fe25519Mul(tmp0, x2) // DA
    z2 = fe25519Mul(z2, tmp1) // CB
    tmp0 = fe25519Sqr(tmp1) // BB = B^2
    tmp1 = fe25519Sqr(x2) // AA = A^2
    x3 = fe25519Add(z3, z2) // DA + CB
    z2 = fe25519Sub(z3, z2) // DA - CB
    x2 = fe25519Mul(tmp1, tmp0) // x2' = AA * BB
    tmp1 = fe25519Sub(tmp1, tmp0) // E  = AA - BB
    z2 = fe25519Sqr(z2) // (DA - CB)^2
    z3 = fe25519Mul121666(tmp1) // 121666 * E
    x3 = fe25519Sqr(x3) // x3' = (DA + CB)^2
    tmp0 = fe25519Add(tmp0, z3) // BB + 121666*E
    z3 = fe25519Mul(x1, z2) // z3' = u * (DA - CB)^2
    z2 = fe25519Mul(tmp1, tmp0) // z2' = E * (BB + 121666*E)

    pos = pos - 1
  }

  // Undo any pending swap, then recover the affine x-coordinate x2 / z2.
  x25519Cswap(swap, x2, x3)
  x25519Cswap(swap, z2, z3)
  z2 = fe25519Invert(z2)
  x2 = fe25519Mul(x2, z2)
  return fe25519ToBytes(x2)
}

// X25519 against the Curve25519 base point (u = 9): the public key for a private
// `scalar`. `scalar` must be at least 32 bytes.
export function x25519Base(scalar: []byte): []byte {
  let base = []byte(32)
  base[0] = 9
  return x25519(scalar, base)
}

// The X25519 shared secret between our private `scalar` and a peer's public
// point `uCoord`, with the contributory-behaviour check applied: an all-zero
// output — produced when the peer point has small order — is rejected rather
// than returned. A key-agreement protocol must treat that as fatal (TLS 1.3
// aborts the handshake), so this is the function TLS (#1203) should call; feed
// the returned bytes to HKDF directly as input keying material.
export function x25519SharedSecret(scalar: []byte, uCoord: []byte): []byte! {
  let out = x25519(scalar, uCoord)
  if (x25519IsAllZero(out)) {
    fail newError("x25519SharedSecret: all-zero output (small-order peer point)")
  }
  return out
}

// Generate a fresh X25519 key pair. The private key is 32 bytes from the OS
// CSPRNG stored raw (clamped only inside `x25519`), and the public key is
// `priv * basepoint`. The clamp guarantees the public key is never a small-order
// point, so it needs no all-zero check here.
export function x25519GenerateKeypair(): X25519Keypair {
  let priv = randomBytes(32)
  let pub = x25519Base(priv)
  return X25519Keypair{ priv: priv, pub: pub }
}
