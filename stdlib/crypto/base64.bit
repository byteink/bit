// Bit standard library — crypto/base64 module (RFC 4648).
//
// Base64 turns arbitrary bytes into a 65-character ASCII text alphabet, three
// input bytes per four output characters. Two variants ship here: the
// *standard* alphabet (§4, `+` and `/`, `=`-padded) that
// `encodeBase64`/`decodeBase64` use, and the *URL-safe* alphabet (§5, `-` and
// `_`, no padding) that `encodeBase64Url`/`decodeBase64Url` use — safe inside
// URLs and filenames. Standard, `=`-padded is the default; URL-safe is a
// separate pair of exports, not a flag, so a caller cannot silently get the
// wrong alphabet. The two are self-inverse per variant:
// `decodeBase64(encodeBase64(b)) == b` and
// `decodeBase64Url(encodeBase64Url(b)) == b`.
//
// The byte math is plain shifts and masks over `int`; decoding validates every
// character against a reverse table and fails on an out-of-alphabet byte or a
// length that no valid encoding can produce — it never returns a guess.

// RFC 4648 §4 (standard) and §5 (URL-safe) 64-symbol alphabets. Positions 0..63
// map a 6-bit group to its character; the two differ only in the last two.
const stdAlphabet: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
const urlAlphabet: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

// Encode `b` with the standard alphabet and `=` padding (RFC 4648 §4). The
// output length is always a multiple of 4.
export fn encodeBase64(b: []byte): string { return base64EncodeWith(b, stdAlphabet, true) }

// Decode a standard, `=`-padded base64 string (RFC 4648 §4). Fails on a
// character outside the alphabet or a length that is not a multiple of 4.
export fn decodeBase64(s: string): []byte! { return decodeWith(s, stdAlphabet, true)? }

// Encode `b` with the URL-safe alphabet (`-`/`_`) and no padding (RFC 4648 §5).
// Safe to drop into a URL path, query, or filename.
export fn encodeBase64Url(b: []byte): string { return base64EncodeWith(b, urlAlphabet, false) }

// Decode an unpadded URL-safe base64 string (RFC 4648 §5). Fails on a character
// outside the URL-safe alphabet (a `=` included) or an impossible length.
export fn decodeBase64Url(s: string): []byte! { return decodeWith(s, urlAlphabet, false)? }

// Shared encoder: 3 input bytes -> 4 symbols of `alphabet`; a 1- or 2-byte tail
// becomes 2 or 3 symbols, filled up to 4 with '=' when `pad`.
fn base64EncodeWith(b: []byte, alphabet: string, pad: bool): string {
  let alpha = []byte(alphabet)
  let n = len(b)
  let rem = n % 3

  // Exact output length up front, so the buffer is written by index (no growth).
  let olen = n / 3 * 4
  if (rem == 1) {
    if (pad) {
      olen = olen + 4
    } else {
      olen = olen + 2
    }
  } else if (rem == 2) {
    if (pad) {
      olen = olen + 4
    } else {
      olen = olen + 3
    }
  }

  let out = []byte(olen)
  let si = 0
  let di = 0
  // Full 3-byte groups.
  while (si + 3 <= n) {
    let c0 = int(b[si])
    let c1 = int(b[si + 1])
    let c2 = int(b[si + 2])
    out[di] = alpha[c0 >> 2]
    out[di + 1] = alpha[((c0 & 3) << 4) | (c1 >> 4)]
    out[di + 2] = alpha[((c1 & 15) << 2) | (c2 >> 6)]
    out[di + 3] = alpha[c2 & 63]
    si = si + 3
    di = di + 4
  }
  // Trailing 1 or 2 bytes.
  if (rem == 1) {
    let c0 = int(b[si])
    out[di] = alpha[c0 >> 2]
    out[di + 1] = alpha[(c0 & 3) << 4]
    if (pad) {
      out[di + 2] = '='
      out[di + 3] = '='
    }
  } else if (rem == 2) {
    let c0 = int(b[si])
    let c1 = int(b[si + 1])
    out[di] = alpha[c0 >> 2]
    out[di + 1] = alpha[((c0 & 3) << 4) | (c1 >> 4)]
    out[di + 2] = alpha[(c1 & 15) << 2]
    if (pad) {
      out[di + 3] = '='
    }
  }
  return string(out)
}

// Shared decoder: validate, then fold 4 symbols back into 3 bytes. `padded`
// requires a multiple-of-4 length and strips up to two trailing `=`.
fn decodeWith(s: string, alphabet: string, padded: bool): []byte! {
  let n = len(s)

  // Reverse map: each alphabet byte -> its 6-bit value, every other byte -> -1.
  let rev = []i64(256)
  let i = 0
  while (i < 256) {
    rev[i] = -1
    i = i + 1
  }
  let alpha = []byte(alphabet)
  i = 0
  while (i < 64) {
    rev[int(alpha[i])] = i
    i = i + 1
  }

  // `m` is the count of significant symbols (padding removed).
  let m = n
  if (padded) {
    if (n % 4 != 0) {
      fail newError("base64: input length must be a multiple of 4")
    }
    // A final group is padded by at most two '='; anything else stays a symbol
    // and is rejected below by the reverse table.
    if (n >= 1 && s[n - 1] == '=') {
      m = m - 1
      if (n >= 2 && s[n - 2] == '=') {
        m = m - 1
      }
    }
  }

  let rem = m % 4
  if (rem == 1) {
    fail newError("base64: invalid input length")
  }
  // Exact output length: 3 bytes per 4 symbols, +1 for a 2-symbol tail, +2 for 3.
  let olen = m / 4 * 3
  if (rem == 2) {
    olen = olen + 1
  } else if (rem == 3) {
    olen = olen + 2
  }

  let out = []byte(olen)
  let si = 0
  let di = 0
  // Full 4-symbol groups.
  while (si + 4 <= m) {
    let v0 = symbolValue(rev, s, si)?
    let v1 = symbolValue(rev, s, si + 1)?
    let v2 = symbolValue(rev, s, si + 2)?
    let v3 = symbolValue(rev, s, si + 3)?
    let acc = (v0 << 18) | (v1 << 12) | (v2 << 6) | v3
    out[di] = byte((acc >> 16) & 255)
    out[di + 1] = byte((acc >> 8) & 255)
    out[di + 2] = byte(acc & 255)
    si = si + 4
    di = di + 3
  }
  // Trailing 2 or 3 symbols.
  if (rem == 2) {
    let v0 = symbolValue(rev, s, si)?
    let v1 = symbolValue(rev, s, si + 1)?
    let acc = (v0 << 18) | (v1 << 12)
    out[di] = byte((acc >> 16) & 255)
  } else if (rem == 3) {
    let v0 = symbolValue(rev, s, si)?
    let v1 = symbolValue(rev, s, si + 1)?
    let v2 = symbolValue(rev, s, si + 2)?
    let acc = (v0 << 18) | (v1 << 12) | (v2 << 6)
    out[di] = byte((acc >> 16) & 255)
    out[di + 1] = byte((acc >> 8) & 255)
  }
  return out
}

// Look up the 6-bit value of symbol `s[idx]`, failing on an out-of-alphabet byte.
fn symbolValue(rev: []i64, s: string, idx: int): i64! {
  let v = rev[int(s[idx])]
  if (v < 0) {
    fail newError("base64: invalid character")
  }
  return v
}
