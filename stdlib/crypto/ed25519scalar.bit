// Bit standard library — crypto module, Ed25519 scalars modulo the group order
// L = 2^252 + 27742317777372353535851937790883648493 (#7167).
//
// Scalars are held as 32-bit limbs in `u64` words, little-endian, in the
// `sl`/`sr`/`st`/`sx` buffers of an `ed25519Ctx`, so nothing here allocates
// beyond the 32-byte result. Reduction is bit-serial: the remainder r < L is
// doubled, the next input bit added, and L subtracted under a mask taken from
// the borrow. Every input bit costs the same limb operations, so the work is
// independent of the (secret) value: no branch, index or size depends on it.

// L as eight 32-bit little-endian limbs.
fn ed25519LLimbs(): []u64 {
  return []u64{
    0x5cf5d3ed,
    0x5812631a,
    0xa2f79cd6,
    0x14def9de,
    0,
    0,
    0,
    0x10000000,
  }
}

// The low 32 bits of a word.
fn ed25519M32(): u64 { return u64(0xffffffff) }

// The little-endian 32-bit word of `b` at byte `off`.
fn ed25519Le32(b: []byte, off: int): u64 {
  return u64(b[off]) | (u64(b[off + 1]) << 8) | (u64(b[off + 2]) << 16) | (u64(b[off + 3]) << 24)
}

// c.sr = 2*c.sr + bit, then c.sr -= L when that is not negative. Keeps c.sr < L
// given c.sr < L on entry (2r + 1 < 2L < 2^254 fits the eight limbs).
fn ed25519ScStep(c: ed25519Ctx, bit: u64) {
  let carry = bit
  let i = 0
  while (i < 8) {
    let v = ((c.sr[i] << 1) | carry) & ed25519M32()
    carry = c.sr[i] >> 31
    c.sr[i] = v
    i = i + 1
  }
  let borrow: u64 = 0
  i = 0
  while (i < 8) {
    let d = c.sr[i] - c.sl[i] - borrow
    c.st[i] = d & ed25519M32()
    borrow = d >> 63
    i = i + 1
  }
  // No borrow means r >= L: keep r - L.
  let m = borrow - 1
  i = 0
  while (i < 8) {
    c.sr[i] = (c.st[i] & m) | (c.sr[i] & ~m)
    i = i + 1
  }
}

// The 512-bit value in the sixteen limbs of `c.sx`, reduced mod L, as 32
// little-endian bytes.
fn ed25519ScReduceX(c: ed25519Ctx): []byte {
  let i = 0
  while (i < 8) {
    c.sr[i] = 0
    i = i + 1
  }
  let b = 511
  while (b >= 0) {
    ed25519ScStep(c, (c.sx[b / 32] >> u64(b % 32)) & 1)
    b = b - 1
  }
  let out = []byte(32)
  i = 0
  while (i < 32) {
    out[i] = byte(c.sr[i / 4] >> u64(i % 4 * 8))
    i = i + 1
  }
  return out
}

// Reduce a 64-byte little-endian hash to a 32-byte little-endian scalar mod L.
fn ed25519ScReduce64(c: ed25519Ctx, h: []byte): []byte {
  let i = 0
  while (i < 16) {
    c.sx[i] = ed25519Le32(h, i * 4)
    i = i + 1
  }
  return ed25519ScReduceX(c)
}

// s = (r + k*a) mod L, all operands 32-byte little-endian scalars. The 512-bit
// product is schoolbook over 32-bit limbs: k_i*a_j + limb + carry < 2^64.
fn ed25519ScMulAdd(c: ed25519Ctx, r: []byte, k: []byte, a: []byte): []byte {
  let i = 0
  while (i < 16) {
    c.sx[i] = 0
    i = i + 1
  }
  i = 0
  while (i < 8) {
    let ki = ed25519Le32(k, i * 4)
    let carry: u64 = 0
    let j = 0
    while (j < 8) {
      let t = c.sx[i + j] + ki * ed25519Le32(a, j * 4) + carry
      c.sx[i + j] = t & ed25519M32()
      carry = t >> 32
      j = j + 1
    }
    c.sx[i + 8] = carry
    i = i + 1
  }
  ed25519ScAddLow(c, r)
  return ed25519ScReduceX(c)
}

// c.sx += r for a 32-byte little-endian `r`; k*a + r < 2^509, so the carry out
// of the top limb is zero.
fn ed25519ScAddLow(c: ed25519Ctx, r: []byte) {
  let carry: u64 = 0
  let i = 0
  while (i < 16) {
    let t = c.sx[i] + carry
    if (i < 8) {
      t = t + ed25519Le32(r, i * 4)
    }
    c.sx[i] = t & ed25519M32()
    carry = t >> 32
    i = i + 1
  }
}

// Whether a 32-byte little-endian scalar is canonical (< L): the subtraction
// s - L borrows exactly when s < L.
fn ed25519ScLtL(c: ed25519Ctx, s: []byte): bool {
  let borrow: u64 = 0
  let i = 0
  while (i < 8) {
    let d = ed25519Le32(s, i * 4) - c.sl[i] - borrow
    borrow = d >> 63
    i = i + 1
  }
  return borrow == 1
}
