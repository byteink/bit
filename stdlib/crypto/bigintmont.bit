// Bit standard library — crypto module, fixed-width Montgomery workspace.
//
// One modular operation (an RSA signature, a modexp) used to allocate a fresh
// limb vector per multiply, per reduction and per doubling: 18 MB for one
// RSA-2048 signature (#7156). `MontCtx` is the fix, the shape of Go's
// crypto/internal/bigmod and BoringSSL's BN_MONT_CTX: everything sized to the
// modulus is allocated once when the context is built, and every primitive
// below writes into caller-owned buffers of exactly `k = len(n)` limbs.
//
// Constant time: every loop bound is a function of `k` (public) or of an
// explicitly public length, every conditional subtraction is a mask, and no
// array index depends on a value. `bigintInverseVarTime` is the one exception
// and says so in its name. Sibling of `./bigintmodexp.bit` (SPEC §17.1).

// A Montgomery context for the odd modulus `n` (normalized, `k` limbs):
// `n0inv = -n^-1 mod 2^32`, `r2 = R^2 mod n` with `R = 2^(32k)`, the width-`k`
// constant one, the `k+2`-limb accumulator every multiply reuses, and `s`, the
// `k`-limb scratch of `bigintMontReduceTo`/`ExpTo`/`PowPublicTo` (never pass it
// to them as an argument). A context is per operation, never shared between
// threads.
class MontCtx { n: []u32, n0inv: u32, r2: []u32, one: []u32, t: []u32, s: []u32 }

// The inverse of the odd word `a` modulo 2^32, by Newton's iteration: each step
// doubles the number of correct low bits, so five steps from a one-bit seed
// cover all 32 bits. All arithmetic is `u32`, i.e. modulo 2^32.
fn bigintInvWord(a: u32): u32 {
  let x: u32 = 1
  let i = 0
  while (i < 5) {
    x = x * (2 - a * x)
    i = i + 1
  }
  return x
}

// The context for the odd, normalized modulus `modN` (at least one limb).
fn bigintMontNew(modN: Nat): MontCtx {
  let n = modN.limbs
  let k = len(n)
  let c = MontCtx{
    n = n,
    n0inv = u32(0) - bigintInvWord(n[0]),
    r2 = []u32(k),
    one = bigintOneWidth(k),
    t = []u32(k + 2),
    s = []u32(k),
  }
  bigintMontR2To(c)
  return c
}

// Montgomery multiplication (CIOS form, Koc et al. 1996): `out = a*b*R^-1 mod
// n` for `a < R` and `b < n`, both of width `k`. Under that bound the
// accumulator stays below `2n`, so one masked subtraction reduces it. The
// product is built in the context's scratch `t` and copied out last, so `out`
// may alias `a` or `b`.
fn bigintMontMulTo(c: MontCtx, out: []u32, a: []u32, b: []u32) {
  let n = c.n
  let t = c.t
  let k = len(n)
  let i = 0
  while (i < k + 2) {
    t[i] = 0
    i = i + 1
  }
  i = 0
  while (i < k) {
    bigintMontRow(c, a, b[i])
    i = i + 1
  }
  i = 0
  while (i < k) {
    out[i] = t[i]
    i = i + 1
  }
  bigintCondSub(out, t[k], n)
}

fn bigintMontWord(t: u32, a: u32, b: u32, cy: u64): u64 {
  return u64(t) + u64(a) * u64(b) + cy
}

// One CIOS row: `t += a*bi`, then `t = (t + m*n) / 2^32` with `m` chosen so
// the low limb cancels. Each `(carry, limb)` update tops out at 2^64 - 1.
fn bigintMontRow(c: MontCtx, a: []u32, bi: u32) {
  let n = c.n
  let t = c.t
  let k = len(n)
  let cy: u64 = 0
  let j = 0
  while (j + 1 < k) {
    let uv = bigintMontWord(t[j], a[j], bi, cy)
    t[j] = u32(uv)
    cy = uv >> 32
    uv = bigintMontWord(t[j + 1], a[j + 1], bi, cy)
    t[j + 1] = u32(uv)
    cy = uv >> 32
    j = j + 2
  }
  if (j < k) {
    let uv = bigintMontWord(t[j], a[j], bi, cy)
    t[j] = u32(uv)
    cy = uv >> 32
  }
  let uv2 = u64(t[k]) + cy
  t[k] = u32(uv2)
  t[k + 1] = u32(uv2 >> 32)
  let m = u32(u64(t[0]) * u64(c.n0inv))
  cy = (u64(t[0]) + u64(m) * u64(n[0])) >> 32
  j = 1
  while (j + 1 < k) {
    let uv = bigintMontWord(t[j], m, n[j], cy)
    t[j - 1] = u32(uv)
    cy = uv >> 32
    uv = bigintMontWord(t[j + 1], m, n[j + 1], cy)
    t[j] = u32(uv)
    cy = uv >> 32
    j = j + 2
  }
  if (j < k) {
    let uv = bigintMontWord(t[j], m, n[j], cy)
    t[j - 1] = u32(uv)
    cy = uv >> 32
  }
  let uv4 = u64(t[k]) + cy
  t[k - 1] = u32(uv4)
  t[k] = u32(u64(t[k + 1]) + (uv4 >> 32))
}

// `x = 2x mod n` in place, for `x < n`.
fn bigintModDoubleTo(x: []u32, n: []u32) {
  let carry: u32 = 0
  let i = 0
  while (i < len(n)) {
    let top = x[i] >> 31
    x[i] = (x[i] << 1) | carry
    carry = top
    i = i + 1
  }
  bigintCondSub(x, carry, n)
}

// `c.r2 = R^2 mod n`. Start at `2^(bitlen-1)`, the largest power of two below
// `n`, and double up to `2^(32k + k) = 2^k * R`, the Montgomery form of `2^k`;
// five Montgomery squarings then give the form of `2^(32k) = R`, which is
// `R^2`. A doubling costs `3k` limb operations and a squaring `2k^2`, so five
// squarings after `~k` doublings beats both pure doubling (`32k` of them) and
// the longest squaring chain. Every count is a function of the modulus width
// and bit length, both public.
fn bigintMontR2To(c: MontCtx) {
  let n = c.n
  let k = len(n)
  let x = c.r2
  let top = bigintBitLen(Nat{ limbs = n }) - 1
  x[top / 32] = u32(1) << u32(top % 32)
  let steps = 32 * k - top + k
  let i = 0
  while (i < steps) {
    bigintModDoubleTo(x, n)
    i = i + 1
  }
  i = 0
  while (i < 5) {
    bigintMontMulTo(c, x, x, x)
    i = i + 1
  }
}

// `out = x mod n` for a limb slice `x` of any length, in constant time for a
// given `len(x)`: Horner over `k`-limb chunks from the top, entirely in the
// Montgomery domain. `acc*R` is one multiply by `r2` (`Mont(v) -> Mont(v*R)`)
// and each chunk enters as `Mont(chunk)`, another; one multiply by one leaves
// the domain. `out` must not alias `x`.
fn bigintMontReduceTo(c: MontCtx, out: []u32, x: []u32) {
  let k = len(c.n)
  let chunk = c.s
  let i = 0
  while (i < k) {
    out[i] = 0
    i = i + 1
  }
  let ci = (len(x) + k - 1) / k - 1
  while (ci >= 0) {
    bigintMontMulTo(c, out, out, c.r2)
    i = 0
    while (i < k) {
      let src = ci * k + i
      chunk[i] = 0
      if (src < len(x)) {
        chunk[i] = x[src]
      }
      i = i + 1
    }
    bigintMontMulTo(c, chunk, chunk, c.r2)
    bigintModAddTo(out, out, chunk, c.n)
    ci = ci - 1
  }
  bigintMontMulTo(c, out, out, c.one)
}

// `out = base^exp mod n` over the low `bits` exponent bits by a fixed 4-bit
// window, the shape of Go's crypto/internal/bigmod `Nat.Exp` and BoringSSL's
// `BN_mod_exp_mont_consttime`: a table of `Mont(base^i)` for `i < 16`, then per
// window from the top four squarings and one multiply by the entry the window
// names, about 1.25 multiplies per bit where a ladder pays two (#7166).
// Constant time: the window count is a function of `bits` alone, the top
// window is padded with zero bits, every window costs the same five multiplies
// and its entry is read by `bigintMontSelect`'s scan of all sixteen, so no
// branch, index or allocation size depends on the exponent. `base < n` and may
// alias `out`. `exp` must hold at least `bits` bits (`(bits+31)/32` limbs) so
// no bit fetch depends on the exponent's normalized length.
fn bigintMontExpTo(c: MontCtx, out: []u32, base: []u32, exp: []u32, bits: int) {
  let tab = []u32(16 * len(c.n))
  bigintMontTable(c, tab, out, base)
  let w = (bits + 3) / 4 - 1
  bigintMontSelect(out, tab, bigintExpWindow(exp, w, bits))
  w = w - 1
  while (w >= 0) {
    let i = 0
    while (i < 4) {
      bigintMontMulTo(c, out, out, out)
      i = i + 1
    }
    bigintMontSelect(c.s, tab, bigintExpWindow(exp, w, bits))
    bigintMontMulTo(c, out, out, c.s)
    w = w - 1
  }
  bigintMontMulTo(c, out, out, c.one)
}

// `tab[i*k .. (i+1)*k] = Mont(base^i)` for `i < 16`, `k = len(c.n)`, built in
// `acc` (k limbs, may alias `base`) and `c.s`: one multiply per entry, copied
// into the flat table so no reslice header is allocated per entry.
fn bigintMontTable(c: MontCtx, tab: []u32, acc: []u32, base: []u32) {
  let k = len(c.n)
  bigintMontMulTo(c, c.s, base, c.r2)
  bigintMontMulTo(c, acc, c.one, c.r2)
  let i = 0
  while (i < 16) {
    if (i > 0) {
      bigintMontMulTo(c, acc, acc, c.s)
    }
    let j = 0
    while (j < k) {
      tab[i * k + j] = acc[j]
      j = j + 1
    }
    i = i + 1
  }
}

// The `w`-th 4-bit window of `exp`, bits `4w .. 4w+3`, with every bit at or
// above `bits` read as zero (0 for a window wholly outside `[0, bits)`). A
// window never straddles a limb because 4 divides 32. Both branches test only
// `w` and `bits`, which are public.
fn bigintExpWindow(exp: []u32, w: int, bits: int): u32 {
  let lo = 4 * w
  if (lo < 0 || lo >= bits) {
    return 0
  }
  let win = (exp[lo / 32] >> u32(lo % 32)) & 0xf
  if (bits - lo < 4) {
    win = win & ((u32(1) << u32(bits - lo)) - 1)
  }
  return win
}

// `dst = tab[win*k .. (win+1)*k]`, `k = len(dst)`, by a masked scan of all
// sixteen entries of the flat table: every limb of every entry is read and
// OR-ed in under an all-ones-or-zero `rsaEqMask32` mask whatever `win` is, so
// neither the memory-access pattern nor the timing depends on it.
fn bigintMontSelect(dst: []u32, tab: []u32, win: u32) {
  let k = len(dst)
  let j = 0
  while (j < k) {
    dst[j] = 0
    j = j + 1
  }
  let i = 0
  while (i < 16) {
    let mask = rsaEqMask32(u32(i), win)
    j = 0
    while (j < k) {
      dst[j] = dst[j] | (tab[i * k + j] & mask)
      j = j + 1
    }
    i = i + 1
  }
}

// `out = base^exp mod n` for a PUBLIC exponent: left-to-right square and
// multiply that skips the multiply on a zero bit. `base < n`. Never call it
// with a secret exponent.
fn bigintMontPowPublicTo(c: MontCtx, out: []u32, base: []u32, exp: Nat) {
  let acc = c.s
  let bits = bigintBitLen(exp)
  bigintMontMulTo(c, out, base, c.r2)
  bigintMontMulTo(c, acc, c.one, c.r2)
  let bit = bits - 1
  while (bit >= 0) {
    bigintMontMulTo(c, acc, acc, acc)
    if (((exp.limbs[bit / 32] >> u32(bit % 32)) & 1) == 1) {
      bigintMontMulTo(c, acc, acc, out)
    }
    bit = bit - 1
  }
  bigintMontMulTo(c, out, acc, c.one)
}

// `x = x + y` over `len(x)` limbs, returning the carry out.
fn bigintAddTo(x: []u32, y: []u32): u32 {
  let carry: u64 = 0
  let i = 0
  while (i < len(x)) {
    let s = u64(x[i]) + u64(y[i]) + carry
    x[i] = u32(s & 0xffffffff)
    carry = s >> 32
    i = i + 1
  }
  return u32(carry)
}

// `x = x - y` over `len(x)` limbs, returning the borrow out.
fn bigintSubTo(x: []u32, y: []u32): u32 {
  let borrow: u64 = 0
  let i = 0
  while (i < len(x)) {
    let d = u64(x[i]) + 0x100000000 - u64(y[i]) - borrow
    x[i] = u32(d & 0xffffffff)
    borrow = 1 - (d >> 32)
    i = i + 1
  }
  return u32(borrow)
}

// `x = (top:x) >> 1`, shifting the bit `top` in at the high end.
fn bigintShr1To(x: []u32, top: u32) {
  let i = 0
  while (i < len(x)) {
    let hi = top
    if (i + 1 < len(x)) {
      hi = x[i + 1]
    }
    x[i] = (x[i] >> 1) | (hi << 31)
    i = i + 1
  }
}

// Whether every limb of `x` is zero.
fn bigintLimbsZero(x: []u32): bool {
  let acc: u32 = 0
  let i = 0
  while (i < len(x)) {
    acc = acc | x[i]
    i = i + 1
  }
  return acc == 0
}

// For odd m, adding m to an odd coefficient makes division by two exact.
// Keep the addition's carry: p + m can exceed the fixed limb width.
fn bigintXgcdHalve(y: []u32, p: []u32, m: []u32) {
  bigintShr1To(y, 0)
  let carry: u32 = 0
  if ((p[0] & 1) == 1) {
    carry = bigintAddTo(p, m)
  }
  bigintShr1To(p, carry)
}

// Only residues of the coefficients are needed: u = A*a and v = C*a modulo m.
// Both coefficients stay in [0, m), so two full Bezout coefficient buffers go away.
class XgcdState { u: []u32, v: []u32, aa: []u32, cc: []u32, m: []u32 }

fn bigintInverseWidth(out: []u32, a: []u32, m: []u32) {
  let k = len(m)
  assert(k > 0 && len(a) == k && len(out) == k && (m[0] & 1) == 1, "inverse width or modulus")
}

// `out = a^-1 mod m` by the bounded binary extended GCD (HAC 14.61 as adapted
// by BoringSSL's bn_mod_inverse_consttime and Go's bigmod, proof in fiat-crypto
// PR 333), on fixed `k`-limb buffers: u = A*a and v = C*a modulo m hold
// before and after every step, and each step halves `u` or `v`, so at most
// `64k` steps run. VARIABLE TIME in `a`: callers pass only a fresh random
// value (the RSA blinding factor). Returns false when `gcd(a, m) != 1`. `a < m`,
// `m` odd, both `k` limbs; `out` is `A`. It may overlap a, but must not overlap m.
fn bigintInverseVarTimeTo(out: []u32, a: []u32, m: []u32): bool {
  bigintInverseWidth(out, a, m)
  let k = len(m)
  let g = XgcdState{
    u = []u32(k),
    v = []u32(k),
    aa = out,
    cc = []u32(k),
    m = m,
  }
  let i = 0
  while (i < k) {
    g.u[i] = a[i]
    g.v[i] = m[i]
    i = i + 1
  }
  i = 0
  while (i < k) {
    out[i] = 0
    i = i + 1
  }
  out[0] = 1
  if (bigintLimbsZero(g.u)) {
    return false
  }
  let steps = 0
  while (!bigintLimbsZero(g.v) && steps <= 64 * k) {
    bigintXgcdStep(g)
    steps = steps + 1
  }
  if (!bigintLimbsZero(g.v)) {
    return false
  }
  return bigintLimbsZero(g.u[1:k]) && g.u[0] == 1
}

// One iteration of `bigintInverseVarTimeTo`: subtract the smaller of two odd
// `u`/`v` from the larger (updating its coefficient modulo m),
// then halve whichever is even.
fn bigintXgcdStep(g: XgcdState) {
  if ((g.u[0] & g.v[0] & 1) == 1) {
    if (bigintSubTo(g.v, g.u) == 1) {
      let _ = bigintAddTo(g.v, g.u)
      let _ = bigintSubTo(g.u, g.v)
      bigintModSubTo(g.aa, g.aa, g.cc, g.m)
    } else {
      bigintModSubTo(g.cc, g.cc, g.aa, g.m)
    }
  }
  if ((g.u[0] & 1) == 0) {
    bigintXgcdHalve(g.u, g.aa, g.m)
    return
  }
  bigintXgcdHalve(g.v, g.cc, g.m)
}

// Spare bits let each product digit and both incoming carries add without a
// 64-bit overflow. The CRT path keeps its original blinding and fault checks.
const mont52Mask: u64 = 0x000fffffffffffff
const mont52Base: u64 = 0x0010000000000000
class Mont52 { n: []u64, inv: u64, r2: []u64, one: []u64, t: []u64, s: []u64 }

fn bigintPack52(src: []u32, k: int): []u64 {
  let out = []u64(k)
  let i = 0
  while (i < k) {
    let off = i * 52
    let si = off / 32
    let shift = off % 32
    let word: u64 = 0
    if (si < len(src)) {
      word = u64(src[si]) >> u64(shift)
    }
    if (si + 1 < len(src)) {
      word = word | (u64(src[si + 1]) << u64(32 - shift))
    }
    if (shift > 12 && si + 2 < len(src)) {
      word = word | (u64(src[si + 2]) << u64(64 - shift))
    }
    out[i] = word & mont52Mask
    i = i + 1
  }
  return out
}

fn bigintUnpack52(out: []u32, src: []u64) {
  let i = 0
  while (i < len(out)) {
    let off = i * 32
    let si = off / 52
    let shift = off % 52
    let word = src[si] >> u64(shift)
    if (shift > 20) {
      word = word | (src[si + 1] << u64(52 - shift))
    }
    out[i] = u32(word)
    i = i + 1
  }
}

fn bigintMont52New(c: MontCtx): Mont52 {
  let k32 = len(c.n)
  let k = (32 * k32 + 51) / 52
  let n = bigintPack52(c.n, k)
  let inv: u64 = 1
  let i = 0
  while (i < 6) {
    inv = inv * (2 - n[0] * inv)
    i = i + 1
  }
  let one = []u64(k)
  one[0] = 1
  let w = Mont52{
    n = n, inv = (u64(0) - inv) & mont52Mask,
    r2 = bigintPack52(c.r2, k), one = one, t = []u64(k + 2), s = []u64(k),
  }
  // R52 is R32 times a public power of two; preserve the old reduced R².
  let doubles = 2 * (52 * k - 32 * k32)
  i = 0
  while (i < doubles) {
    bigintMont52Double(w.r2, n)
    i = i + 1
  }
  return w
}

fn bigintMont52CondSub(x: []u64, hi: u64, n: []u64) {
  let borrow: u64 = 0
  let i = 0
  while (i < len(n)) {
    let d = x[i] + mont52Base - n[i] - borrow
    borrow = 1 - (d >> 52)
    i = i + 1
  }
  let mask = u64(0) - (hi | (1 - borrow))
  borrow = 0
  i = 0
  while (i < len(n)) {
    let d = x[i] + mont52Base - (n[i] & mask) - borrow
    x[i] = d & mont52Mask
    borrow = 1 - (d >> 52)
    i = i + 1
  }
}

fn bigintMont52Double(x: []u64, n: []u64) {
  let carry: u64 = 0
  let i = 0
  while (i < len(n)) {
    let top = x[i] >> 51
    x[i] = ((x[i] << 1) | carry) & mont52Mask
    carry = top
    i = i + 1
  }
  bigintMont52CondSub(x, carry, n)
}

// (a*b + t + carry) < B² for B=2^52; the low-word sum is below 2^54.
fn bigintMont52Word(t: u64, a: u64, b: u64, carry: u64): (u64, u64) {
  let hi = umulHi(a, b)
  let lo = a * b
  let sum = (lo & mont52Mask) + t + carry
  return ((hi << 12) | (lo >> 52)) + (sum >> 52), sum & mont52Mask
}

// Product limbs are below B=2^52 and t below 3B; the low sum stays below 5B.
fn bigintMont52Sum(t: u64, a: u64, b: u64, m: u64, n: u64): (u64, u64) {
  let p = a * b
  let q = m * n
  let hi = ((umulHi(a, b) << 12) | (p >> 52)) + ((umulHi(m, n) << 12) | (q >> 52))
  let lo = (p & mont52Mask) + (q & mont52Mask) + t
  return hi + (lo >> 52), lo & mont52Mask
}

fn bigintMont52Row(c: Mont52, a: []u64, bi: u64) {
  let t = c.t
  let n = c.n
  let k = len(n)
  let (product, first) = bigintMont52Word(t[0], a[0], bi, 0)
  let m = (first * c.inv) & mont52Mask
  let (reduction, _) = bigintMont52Word(first, m, n[0], 0)
  let carry = product + reduction
  let j = 1
  while (j < k) {
    let (next, lo) = bigintMont52Sum(t[j] + carry, a[j], bi, m, n[j])
    t[j - 1] = lo
    carry = next
    j = j + 1
  }
  let last = t[k] + carry
  t[k - 1] = last & mont52Mask
  t[k] = last >> 52
  // Only the active k+1 limbs enter the next row and final reduction.
  t[k + 1] = 0
}

fn bigintMont52MulTo(c: Mont52, out: []u64, a: []u64, b: []u64) {
  let k = len(c.n)
  let i = 0
  while (i < k + 2) {
    c.t[i] = 0
    i = i + 1
  }
  i = 0
  while (i < k) {
    bigintMont52Row(c, a, b[i])
    i = i + 1
  }
  i = 0
  while (i < k) {
    out[i] = c.t[i]
    i = i + 1
  }
  bigintMont52CondSub(out, c.t[k], c.n)
}

fn bigintMont52Table(c: Mont52, tab: []u64, acc: []u64, base: []u64) {
  let k = len(c.n)
  bigintMont52MulTo(c, c.s, base, c.r2)
  bigintMont52MulTo(c, acc, c.one, c.r2)
  let i = 0
  while (i < 16) {
    if (i > 0) {
      bigintMont52MulTo(c, acc, acc, c.s)
    }
    let j = 0
    while (j < k) {
      tab[i * k + j] = acc[j]
      j = j + 1
    }
    i = i + 1
  }
}

fn bigintMont52Select(dst: []u64, tab: []u64, win: u32) {
  let k = len(dst)
  let j = 0
  while (j < k) {
    dst[j] = 0
    j = j + 1
  }
  let i = 0
  while (i < 16) {
    let mask32 = u64(rsaEqMask32(u32(i), win))
    let mask = mask32 | (mask32 << 32)
    j = 0
    while (j < k) {
      dst[j] = dst[j] | (tab[i * k + j] & mask)
      j = j + 1
    }
    i = i + 1
  }
}

// Only the two private CRT legs use this representation; their fixed exponent
// width, full table scan, per-operation scratch and outer fault check remain.
fn bigintMont52ExpTo(c: MontCtx, out: []u32, base: []u32, exp: []u32, bits: int) {
  let w = bigintMont52New(c)
  let acc = bigintPack52(base, len(w.n))
  let tab = []u64(16 * len(w.n))
  bigintMont52Table(w, tab, acc, acc)
  let window = (bits + 3) / 4 - 1
  bigintMont52Select(acc, tab, bigintExpWindow(exp, window, bits))
  window = window - 1
  while (window >= 0) {
    let i = 0
    while (i < 4) {
      bigintMont52MulTo(w, acc, acc, acc)
      i = i + 1
    }
    bigintMont52Select(w.s, tab, bigintExpWindow(exp, window, bits))
    bigintMont52MulTo(w, acc, acc, w.s)
    window = window - 1
  }
  bigintMont52MulTo(w, acc, acc, w.one)
  bigintUnpack52(out, acc)
}
