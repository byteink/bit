// Bit standard library — crypto module, SHA-1 (FIPS 180-1).
//
// LEGACY — INTEROP ONLY. SHA-1 is **not** collision-resistant: practical
// collisions exist (SHAttered, 2017). Never use it for new digital signatures,
// certificates, MACs, or any new security decision. It lives here solely to
// interoperate with formats that still mandate it — UUIDv5 (RFC 4122) and the
// fingerprints of pre-existing X.509 certificates. For anything new, reach for
// SHA-256 instead.
//
// A textbook implementation: u32 words, 80 rounds, a 64-byte (512-bit) block,
// and a 64-bit big-endian length pad. `newSha1()` conforms to the streaming
// `Hash` interface (§14.3) — digest size 20 bytes, block size 64 — so it plugs
// into `digest`, HMAC, and anything else that hashes against `Hash`.

// The five FIPS 180-1 initial chaining values (H0..H4).
const iv0: u32 = 0x67452301
const iv1: u32 = 0xEFCDAB89
const iv2: u32 = 0x98BADCFE
const iv3: u32 = 0x10325476
const iv4: u32 = 0xC3D2E1F0

// `x` rotated left by `n` bits, within 32 bits. The shift count is taken modulo
// the operand width (§13.5), so the two halves recombine losslessly for any
// `n` in `[1, 31]` — the only rotations SHA-1 uses (1, 5, and 30).
function rotl32(x: u32, n: u32): u32 {
  return x << n | x >> (32 - n)
}

// The internal SHA-1 state: the running chaining words, a 64-byte working block
// that fills as bytes arrive, how many of its bytes are live, and the total
// number of bytes absorbed since the last reset (for the length pad).
struct Sha1 {
  h0: u32
  h1: u32
  h2: u32
  h3: u32
  h4: u32
  block: []byte
  used: int
  total: u64
}

// A fresh SHA-1 hasher in the empty state, typed as the streaming `Hash`
// interface. The concrete state stays module-private; callers drive it purely
// through `Hash`'s five methods (or the `digest` one-shot helper).
export function newSha1(): Hash {
  return Sha1{ h0: iv0, h1: iv1, h2: iv2, h3: iv3, h4: iv4, block: []byte(64), used: 0, total: 0 }
}

// Compress the full 64-byte `s.block` into the chaining words. Assumes the
// block is full; `write` and `sum` only call it at that point.
function (s: Sha1) compress() {
  let w = []u32(80)

  // The 16 big-endian message words, then the 64-word schedule extension.
  let t = 0
  while (t < 16) {
    let base = t * 4
    w[t] = u32(s.block[base]) << 24 | u32(s.block[base + 1]) << 16 | u32(s.block[base + 2]) << 8 | u32(s.block[base + 3])
    t = t + 1
  }
  while (t < 80) {
    w[t] = rotl32(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1)
    t = t + 1
  }

  let a = s.h0
  let b = s.h1
  let c = s.h2
  let d = s.h3
  let e = s.h4

  let i = 0
  while (i < 80) {
    let f: u32 = 0
    let k: u32 = 0
    if (i < 20) {
      f = (b & c) | (~b & d)
      k = 0x5A827999
    } else if (i < 40) {
      f = b ^ c ^ d
      k = 0x6ED9EBA1
    } else if (i < 60) {
      f = (b & c) | (b & d) | (c & d)
      k = 0x8F1BBCDC
    } else {
      f = b ^ c ^ d
      k = 0xCA62C1D6
    }
    let tmp = rotl32(a, 5) + f + e + k + w[i]
    e = d
    d = c
    c = rotl32(b, 30)
    b = a
    a = tmp
    i = i + 1
  }

  s.h0 = s.h0 + a
  s.h1 = s.h1 + b
  s.h2 = s.h2 + c
  s.h3 = s.h3 + d
  s.h4 = s.h4 + e
}

// Absorb `data`, compressing each 64-byte block as it completes. Byte-at-a-time
// buffering keeps the block-boundary logic trivial and obviously correct.
function (s: Sha1) write(data: []byte) {
  let i = 0
  while (i < len(data)) {
    s.block[s.used] = data[i]
    s.used = s.used + 1
    s.total = s.total + 1
    if (s.used == 64) {
      s.compress()
      s.used = 0
    }
    i = i + 1
  }
}

// The 20-byte digest of everything written since the last reset. Finalization
// runs on a clone, so `s` is untouched and the caller may keep writing.
function (s: Sha1) sum(): []byte {
  // Message length in bits, captured before the pad extends the byte count.
  let bitLen: u64 = s.total * 8

  let c = Sha1{ h0: s.h0, h1: s.h1, h2: s.h2, h3: s.h3, h4: s.h4, block: []byte(64), used: s.used, total: s.total }
  let i = 0
  while (i < s.used) {
    c.block[i] = s.block[i]
    i = i + 1
  }

  // Pad: a single 0x80 byte, zeros up to the 56-byte mark, then the 64-bit
  // big-endian length. The `used == 56` loop always terminates: `used` advances
  // by one each write and wraps at 64, so it lands on 56 exactly once per block.
  let one = []byte(1)
  one[0] = 0x80
  c.write(one)
  let zero = []byte(1)
  while (c.used != 56) {
    c.write(zero)
  }
  let lenb = []byte(8)
  let n: u64 = bitLen
  let j = 7
  while (j >= 0) {
    lenb[j] = byte(n)
    n = n >> 8
    j = j - 1
  }
  c.write(lenb)

  let out = []byte(20)
  putU32(out, 0, c.h0)
  putU32(out, 4, c.h1)
  putU32(out, 8, c.h2)
  putU32(out, 12, c.h3)
  putU32(out, 16, c.h4)
  return out
}

// Write `v` big-endian into `out` at byte offset `off`.
function putU32(out: []byte, off: int, v: u32) {
  out[off] = byte(v >> 24)
  out[off + 1] = byte(v >> 16)
  out[off + 2] = byte(v >> 8)
  out[off + 3] = byte(v)
}

// Rewind to the empty state so one hasher can digest many messages.
function (s: Sha1) reset() {
  s.h0 = iv0
  s.h1 = iv1
  s.h2 = iv2
  s.h3 = iv3
  s.h4 = iv4
  s.used = 0
  s.total = 0
}

// Digest length in bytes: SHA-1 is always 160 bits.
function (s: Sha1) size(): int {
  return 20
}

// Internal block size in bytes (HMAC keys this block).
function (s: Sha1) blockSize(): int {
  return 64
}
