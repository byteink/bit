// Bit standard library — crypto module, ML-DSA-65 signatures (FIPS 204, Dilithium).
//
// A lattice-based (Module-LWE / Module-SIS) digital signature scheme standing on
// the ring R_q = Z_q[X]/(X^256 + 1) with q = 8380417. Security rests on the
// hardness of finding short vectors in module lattices, which — unlike the
// discrete-log and RSA problems — no known quantum algorithm breaks; ML-DSA is
// the NIST post-quantum standard companion to Ed25519/ECDSA here.
//
// This file implements the ML-DSA-65 (category-3) parameter set only:
//   (k, l) = (6, 5), eta = 4, tau = 49, beta = 196, gamma1 = 2^19,
//   gamma2 = (q-1)/32, omega = 55, d = 13, c_tilde = 48 bytes.
// Encoded sizes are pk = 1952, sk = 4032, signature = 3309 bytes — the FIPS 204
// byte strings, so keys and signatures interoperate with any conforming
// implementation.
//
// The number-theoretic transform (NTT) does the heavy lifting: X^256+1 splits
// fully over Z_q, so a polynomial is 256 independent residues and multiplication
// is pointwise. We use the plain (non-Montgomery) transform with the FIPS 204
// zeta table `pow(1753, bitrev8(i), q)`; every butterfly reduces mod q so the
// signed 64-bit coefficients stay bounded (a product is < q^2 < 2^47), which
// makes the whole transform overflow-free without Montgomery bookkeeping.
//
// Being part of the flat `std/crypto` module, this file names `newShake128`,
// `newShake256`, `Shake`, `randomBytes`, and `newError` from its sibling files
// with no import. Every private helper is prefixed `mldsa`.
//
// Signing is deterministic (the FIPS 204 rnd is fixed to zero): the signature is
// a pure function of `(sk, msg, ctx)`, which makes it reproducible and lets the
// known-answer tests pin it byte-for-byte against the NIST ACVP vectors. The
// arithmetic is data-independent; the rejection loop repeats on values derived
// from the per-attempt commitment, not on the secret key directly.

// ---------------------------------------------------------------------------
// Parameters (inlined as literals at their use sites): q = 8380417 = 2^23 -
// 2^13 + 1, (q-1)/2 = 4190208 is the centering threshold, and 256^-1 mod q =
// 8347681 is the inverse-NTT scaling factor. The zeta table below is returned
// from a function rather than a top-level `const` because Bit's top-level
// `const` is compile-time scalar only, and returning it keeps the inliner from
// choking on the bare literals (#1231/#1232).
// ---------------------------------------------------------------------------

// The 256 twiddle factors zetas[i] = pow(1753, bitrev8(i), q), in the order the
// Cooley-Tukey (`mldsaNtt`) and Gentleman-Sande (`mldsaInvNtt`) passes consume
// them. Returned from a function for the same reason the parameters are.
function mldsaZetas(): []int {
  return []int{
    1, 4808194, 3765607, 3761513, 5178923, 5496691, 5234739, 5178987,
    7778734, 3542485, 2682288, 2129892, 3764867, 7375178, 557458, 7159240,
    5010068, 4317364, 2663378, 6705802, 4855975, 7946292, 676590, 7044481,
    5152541, 1714295, 2453983, 1460718, 7737789, 4795319, 2815639, 2283733,
    3602218, 3182878, 2740543, 4793971, 5269599, 2101410, 3704823, 1159875,
    394148, 928749, 1095468, 4874037, 2071829, 4361428, 3241972, 2156050,
    3415069, 1759347, 7562881, 4805951, 3756790, 6444618, 6663429, 4430364,
    5483103, 3192354, 556856, 3870317, 2917338, 1853806, 3345963, 1858416,
    3073009, 1277625, 5744944, 3852015, 4183372, 5157610, 5258977, 8106357,
    2508980, 2028118, 1937570, 4564692, 2811291, 5396636, 7270901, 4158088,
    1528066, 482649, 1148858, 5418153, 7814814, 169688, 2462444, 5046034,
    4213992, 4892034, 1987814, 5183169, 1736313, 235407, 5130263, 3258457,
    5801164, 1787943, 5989328, 6125690, 3482206, 4197502, 7080401, 6018354,
    7062739, 2461387, 3035980, 621164, 3901472, 7153756, 2925816, 3374250,
    1356448, 5604662, 2683270, 5601629, 4912752, 2312838, 7727142, 7921254,
    348812, 8052569, 1011223, 6026202, 4561790, 6458164, 6143691, 1744507,
    1753, 6444997, 5720892, 6924527, 2660408, 6600190, 8321269, 2772600,
    1182243, 87208, 636927, 4415111, 4423672, 6084020, 5095502, 4663471,
    8352605, 822541, 1009365, 5926272, 6400920, 1596822, 4423473, 4620952,
    6695264, 4969849, 2678278, 4611469, 4829411, 635956, 8129971, 5925040,
    4234153, 6607829, 2192938, 6653329, 2387513, 4768667, 8111961, 5199961,
    3747250, 2296099, 1239911, 4541938, 3195676, 2642980, 1254190, 8368000,
    2998219, 141835, 8291116, 2513018, 7025525, 613238, 7070156, 6161950,
    7921677, 6458423, 4040196, 4908348, 2039144, 6500539, 7561656, 6201452,
    6757063, 2105286, 6006015, 6346610, 586241, 7200804, 527981, 5637006,
    6903432, 1994046, 2491325, 6987258, 507927, 7192532, 7655613, 6545891,
    5346675, 8041997, 2647994, 3009748, 5767564, 4148469, 749577, 4357667,
    3980599, 2569011, 6764887, 1723229, 1665318, 2028038, 1163598, 5011144,
    3994671, 8368538, 7009900, 3020393, 3363542, 214880, 545376, 7609976,
    3105558, 7277073, 508145, 7826699, 860144, 3430436, 140244, 6866265,
    6195333, 3123762, 2358373, 6187330, 5365997, 6663603, 2926054, 7987710,
    8077412, 3531229, 4405932, 4606686, 1900052, 7598542, 1054478, 7648983,
  }
}

// ---------------------------------------------------------------------------
// Modular arithmetic on i64 coefficients. Every polynomial coefficient is kept
// in the canonical range [0, q); the centered representative is recovered on
// demand for norm checks and the signed encodings.
// ---------------------------------------------------------------------------

// `x mod q` in [0, q). Bit's `%` follows the dividend's sign, so a negative
// input needs one add-back — never more, since a single coefficient step here
// stays within (-q, 2q).
function mldsaModQ(x: int): int {
  let r = x % 8380417
  if (r < 0) {
    return r + 8380417
  }
  return r
}

// The centered representative of `c` (assumed in [0, q)) in (-q/2, q/2], i.e.
// `c - q` once `c` passes the (q-1)/2 midpoint. This is FIPS 204's `mod^±`.
function mldsaCentered(c: int): int {
  if (c > 4190208) {
    return c - 8380417
  }
  return c
}

// `x mod^± n`: the representative in (-n/2, n/2]. `x` is first folded into
// [0, n), then shifted down past the midpoint.
function mldsaModPm(x: int, n: int): int {
  let r = x % n
  if (r < 0) {
    r = r + n
  }
  if (r > (n / 2)) {
    r = r - n
  }
  return r
}

// Whether |centered(c)| >= bound — the FIPS 204 infinity-norm rejection test,
// true when the coefficient is *out* of bounds.
function mldsaNormExceeds(c: int, bound: int): bool {
  let cc = mldsaCentered(c)
  if (cc < 0) {
    cc = -cc
  }
  return cc >= bound
}

// ---------------------------------------------------------------------------
// The NTT. `a` is a 256-coefficient view; both passes run fully in place. Every
// butterfly reduces mod q, so intermediates never leave [0, q) and the i64
// products (< q^2) never overflow.
// ---------------------------------------------------------------------------

// Forward NTT (Cooley-Tukey, decimation-in-time). Maps the coefficient domain
// to the evaluation (NTT) domain in bit-reversed order.
function mldsaNtt(a: []int, zetas: []int) {
  let k = 0
  let len = 128
  while (len > 0) {
    let start = 0
    while (start < 256) {
      k = k + 1
      let zeta = zetas[k]
      let j = start
      while (j < start + len) {
        let t = mldsaModQ(zeta * a[j + len])
        a[j + len] = mldsaModQ(a[j] - t)
        a[j] = mldsaModQ(a[j] + t)
        j = j + 1
      }
      start = start + 2 * len
    }
    len = len / 2
  }
}

// Inverse NTT (Gentleman-Sande), then the 256^-1 scaling. Uses the negated
// twiddles (q - zetas[k]) walked in reverse, returning to the coefficient domain.
function mldsaInvNtt(a: []int, zetas: []int) {
  let k = 256
  let len = 1
  while (len < 256) {
    let start = 0
    while (start < 256) {
      k = k - 1
      let zeta = mldsaModQ(-zetas[k])
      let j = start
      while (j < start + len) {
        let t = a[j]
        a[j] = mldsaModQ(t + a[j + len])
        a[j + len] = mldsaModQ(zeta * mldsaModQ(t - a[j + len]))
        j = j + 1
      }
      start = start + 2 * len
    }
    len = len * 2
  }
  let f = 8347681
  let i = 0
  while (i < 256) {
    a[i] = mldsaModQ(a[i] * f)
    i = i + 1
  }
}

// NTT (in place) every polynomial of a length-`npoly` vector packed into `v`.
function mldsaNttVec(v: []int, npoly: int, zetas: []int) {
  let p = 0
  while (p < npoly) {
    mldsaNtt(v[p * 256 : (p + 1) * 256], zetas)
    p = p + 1
  }
}

// Inverse-NTT (in place) every polynomial of a length-`npoly` vector.
function mldsaInvNttVec(v: []int, npoly: int, zetas: []int) {
  let p = 0
  while (p < npoly) {
    mldsaInvNtt(v[p * 256 : (p + 1) * 256], zetas)
    p = p + 1
  }
}

// The matrix-vector product `out = A_hat . y` in the NTT domain, where `a` is
// `rows x cols` polynomials (row-major) and `y`, `out` are length-`cols` and
// length-`rows` vectors. Each output residue is the pointwise dot product over
// the row; `cols <= 6` keeps the accumulator (< 6q) well inside i64.
function mldsaMatVec(a: []int, rows: int, cols: int, y: []int, out: []int) {
  let i = 0
  while (i < rows) {
    let n = 0
    while (n < 256) {
      let acc = 0
      let j = 0
      while (j < cols) {
        acc = acc + mldsaModQ(a[(i * cols + j) * 256 + n] * y[j * 256 + n])
        j = j + 1
      }
      out[i * 256 + n] = mldsaModQ(acc)
      n = n + 1
    }
    i = i + 1
  }
}

// Pointwise-multiply every polynomial of the length-`npoly` vector `v` by the
// single NTT-domain polynomial `c`, writing the result to `out` (the FIPS 204
// `scale`). Used to form c*s1, c*s2, c*t0 in the NTT domain.
function mldsaScaleVec(v: []int, npoly: int, c: []int, out: []int) {
  let p = 0
  while (p < npoly) {
    let n = 0
    while (n < 256) {
      out[p * 256 + n] = mldsaModQ(v[p * 256 + n] * c[n])
      n = n + 1
    }
    p = p + 1
  }
}

// ---------------------------------------------------------------------------
// The SHAKE stream reader. Rejection sampling draws an unbounded number of
// bytes; this pulls them one block at a time from a SHAKE XOF, refilling only
// once the current block is fully consumed so the byte stream matches the
// reference exactly regardless of read granularity.
// ---------------------------------------------------------------------------

// A buffered view over a SHAKE squeeze stream: `s` is the sponge, `buf` the
// current squeezed block, `pos` the read cursor, `blk` the refill size.
struct mldsaXof {
  s: Shake
  buf: []byte
  pos: int
  blk: int
}

// A SHAKE128 reader seeded with `seed` (block = the 168-byte rate).
function mldsaAbsorb128(seed: []byte): mldsaXof {
  let s = newShake128()
  s.absorb(seed)
  return mldsaXof{ s: s, buf: []byte(0), pos: 0, blk: 168 }
}

// A SHAKE256 reader seeded with `seed` (block = the 136-byte rate).
function mldsaAbsorb256(seed: []byte): mldsaXof {
  let s = newShake256()
  s.absorb(seed)
  return mldsaXof{ s: s, buf: []byte(0), pos: 0, blk: 136 }
}

// The next `n` bytes of the stream, refilling from the sponge whenever the
// buffered block runs out. Never skips bytes, so the consumption order is the
// same as reading `n` at a time from a single continuous squeeze.
function (x: mldsaXof) read(n: int): []byte {
  let out = []byte(n)
  let i = 0
  while (i < n) {
    if (x.pos >= len(x.buf)) {
      x.buf = x.s.squeeze(x.blk)
      x.pos = 0
    }
    out[i] = x.buf[x.pos]
    x.pos = x.pos + 1
    i = i + 1
  }
  return out
}

// ---------------------------------------------------------------------------
// Sampling / expansion (FIPS 204 §7.3). Each routine writes one 256-coefficient
// polynomial (in [0, q)) into `out` at `off`.
// ---------------------------------------------------------------------------

// RejNTTPoly: one uniform NTT-domain polynomial from `rho || j || i`, sampled by
// rejecting 23-bit little-endian draws that are >= q. Note the seed order —
// column byte `j` precedes row byte `i`.
function mldsaRejNtt(rho: []byte, i: int, j: int, out: []int, off: int) {
  let seed = []byte(34)
  let t = 0
  while (t < 32) {
    seed[t] = rho[t]
    t = t + 1
  }
  seed[32] = byte(j)
  seed[33] = byte(i)
  let xof = mldsaAbsorb128(seed)
  let cnt = 0
  while (cnt < 256) {
    let b = xof.read(3)
    let d = int(b[0]) | (int(b[1]) << 8) | (int(b[2]) << 16)
    d = d & 8388607
    if (d < 8380417) {
      out[off + cnt] = d
      cnt = cnt + 1
    }
  }
}

// RejBoundedPoly for eta = 4: one polynomial with coefficients in [-4, 4] (stored
// centered-into-[0,q)), sampled from `rho_prime || nonce` over SHAKE256. Each
// byte yields two half-byte candidates; a half-byte `< 9` maps to `4 - value`.
function mldsaRejBounded(rhop: []byte, nonce: int, out: []int, off: int) {
  let seed = []byte(66)
  let t = 0
  while (t < 64) {
    seed[t] = rhop[t]
    t = t + 1
  }
  seed[64] = byte(nonce & 255)
  seed[65] = byte((nonce >> 8) & 255)
  let xof = mldsaAbsorb256(seed)
  let cnt = 0
  while (cnt < 256) {
    let b = xof.read(1)
    let z = int(b[0])
    let z0 = z & 15
    let z1 = z >> 4
    if (z0 < 9) {
      out[off + cnt] = mldsaModQ(4 - z0)
      cnt = cnt + 1
    }
    if (z1 < 9 && cnt < 256) {
      out[off + cnt] = mldsaModQ(4 - z1)
      cnt = cnt + 1
    }
  }
}

// ExpandMask element: the masking polynomial for nonce `nonce`, with each
// coefficient `gamma1 - v` for a 20-bit little-endian draw `v` (gamma1 = 2^19).
// 640 bytes = 256 * 20 / 8 are squeezed at once — no rejection here.
function mldsaExpandMask(rhop: []byte, nonce: int, out: []int, off: int) {
  let seed = []byte(66)
  let t = 0
  while (t < 64) {
    seed[t] = rhop[t]
    t = t + 1
  }
  seed[64] = byte(nonce & 255)
  seed[65] = byte((nonce >> 8) & 255)
  let s = newShake256()
  s.absorb(seed)
  let b = s.squeeze(640)
  let raw = mldsaUnpackBits(b, 0, 20)
  let n = 0
  while (n < 256) {
    out[off + n] = mldsaModQ(524288 - raw[n])
    n = n + 1
  }
}

// SampleInBall: the challenge polynomial with exactly tau = 49 coefficients set
// to ±1 (the rest zero), from `c_tilde` over SHAKE256. The first 8 bytes are the
// little-endian sign source; a Fisher-Yates-style placement rejects position
// bytes above the current index.
function mldsaSampleInBall(ctilde: []byte, out: []int) {
  let n = 0
  while (n < 256) {
    out[n] = 0
    n = n + 1
  }
  let xof = mldsaAbsorb256(ctilde)
  let sb = xof.read(8)
  let sign: u64 = 0
  let t = 0
  while (t < 8) {
    sign = sign | (u64(sb[t]) << u64(t * 8))
    t = t + 1
  }
  let i = 207 // 256 - tau
  while (i < 256) {
    let j = 0
    while (true) {
      let bb = xof.read(1)
      let cand = int(bb[0])
      if (cand <= i) {
        j = cand
        break
      }
    }
    out[i] = out[j]
    let bit = int(sign & u64(1))
    out[j] = mldsaModQ(1 - 2 * bit)
    sign = sign >> u64(1)
    i = i + 1
  }
}

// ---------------------------------------------------------------------------
// Rounding and hints (FIPS 204 §7.4), coefficient-wise on values in [0, q).
// alpha = 2*gamma2 = (q-1)/16 is the decompose modulus.
// ---------------------------------------------------------------------------

// Power2Round: split `r` as r = r1*2^d + r0 with r0 the centered low `d` bits.
// `r1` (in [0, 1024)) goes to `t1[at]`, `r0` (stored into [0,q)) to `t0[at]`.
function mldsaPower2Round(r: int, t1: []int, t0: []int, at: int) {
  let r0 = mldsaModPm(r, 8192)
  t1[at] = (r - r0) / 8192
  t0[at] = mldsaModQ(r0)
}

// HighBits: the high part r1 of the decomposition of `r` modulo alpha. The
// special case rp - r0 == q-1 collapses r1 to 0 (FIPS 204 Decompose).
function mldsaHighBits(r: int): int {
  let r0 = mldsaModPm(r, 523776)
  let diff = r - r0
  if (diff == 8380416) {
    return 0
  }
  return diff / 523776
}

// LowBits: the centered low part r0 of the decomposition of `r` modulo alpha,
// with the matching q-1 boundary adjustment.
function mldsaLowBits(r: int): int {
  let r0 = mldsaModPm(r, 523776)
  if (r - r0 == 8380416) {
    return r0 - 1
  }
  return r0
}

// UseHint: recover the high bits of the pre-hint value. `hbit` says the high
// part moved by one step; `m = (q-1)/alpha = 16` wraps the step. Verification's
// inverse of MakeHint.
function mldsaUseHint(hbit: int, r: int): int {
  let r1 = mldsaHighBits(r)
  if (hbit == 1) {
    let r0 = mldsaLowBits(r)
    if (r0 > 0) {
      return (r1 + 1) % 16
    }
    let v = r1 - 1
    if (v < 0) {
      v = v + 16
    }
    return v
  }
  return r1
}

// ---------------------------------------------------------------------------
// Little-endian bit packing. Coefficients occupy `nbits` each, coefficient 0 in
// the lowest bits; `nbits * 256` is always a byte multiple so nothing straddles
// the end. A rolling i64 accumulator holds < nbits + 8 < 28 bits at a time.
// ---------------------------------------------------------------------------

// Pack 256 `nbits`-wide coefficients (each already < 2^nbits) into `out` at `off`.
function mldsaPackBits(coeffs: []int, nbits: int, out: []byte, off: int) {
  let acc = 0
  let nb = 0
  let o = off
  let i = 0
  while (i < 256) {
    acc = acc | (coeffs[i] << nb)
    nb = nb + nbits
    while (nb >= 8) {
      out[o] = byte(acc & 255)
      acc = acc >> 8
      nb = nb - 8
      o = o + 1
    }
    i = i + 1
  }
}

// Unpack 256 `nbits`-wide coefficients from `inp` starting at `off`.
function mldsaUnpackBits(inp: []byte, off: int, nbits: int): []int {
  let out = []int(256)
  let acc = 0
  let nb = 0
  let o = off
  let mask = (1 << nbits) - 1
  let i = 0
  while (i < 256) {
    while (nb < nbits) {
      acc = acc | (int(inp[o]) << nb)
      o = o + 1
      nb = nb + 8
    }
    out[i] = acc & mask
    acc = acc >> nbits
    nb = nb - nbits
    i = i + 1
  }
  return out
}

// t1 packs raw (10 bits); s subtracts from eta (4 bits); t0 and z subtract from
// their offset (13 / 20 bits); w1 packs raw (4 bits). Each helper writes or reads
// one polynomial at a byte offset that its stride implies.

// Pack a t1 polynomial (coefficients in [0,1024), 10 bits, 320 bytes).
function mldsaPackT1(p: []int, at: int, out: []byte, off: int) {
  mldsaPackBits(p[at * 256 : (at + 1) * 256], 10, out, off)
}

// Pack a t0 polynomial: altered = (2^12 - c) mod q, 13 bits, 416 bytes.
function mldsaPackT0(p: []int, at: int, out: []byte, off: int) {
  let a = []int(256)
  let n = 0
  while (n < 256) {
    a[n] = mldsaModQ(4096 - p[at * 256 + n])
    n = n + 1
  }
  mldsaPackBits(a, 13, out, off)
}

// Pack an s1/s2 polynomial: altered = (eta - c) mod q, 4 bits, 128 bytes.
function mldsaPackS(p: []int, at: int, out: []byte, off: int) {
  let a = []int(256)
  let n = 0
  while (n < 256) {
    a[n] = mldsaModQ(4 - p[at * 256 + n])
    n = n + 1
  }
  mldsaPackBits(a, 4, out, off)
}

// Pack a z polynomial: altered = (gamma1 - c) mod q, 20 bits, 640 bytes.
function mldsaPackZ(p: []int, at: int, out: []byte, off: int) {
  let a = []int(256)
  let n = 0
  while (n < 256) {
    a[n] = mldsaModQ(524288 - p[at * 256 + n])
    n = n + 1
  }
  mldsaPackBits(a, 20, out, off)
}

// Pack a w1 polynomial (coefficients in [0,16), 4 bits, 128 bytes).
function mldsaPackW1(p: []int, at: int, out: []byte, off: int) {
  mldsaPackBits(p[at * 256 : (at + 1) * 256], 4, out, off)
}

// Unpack a t1 polynomial into `v[at]` (10-bit raw values).
function mldsaUnpackT1(inp: []byte, off: int, v: []int, at: int) {
  let raw = mldsaUnpackBits(inp, off, 10)
  let n = 0
  while (n < 256) {
    v[at * 256 + n] = raw[n]
    n = n + 1
  }
}

// Unpack a t0 polynomial into `v[at]`: c = (2^12 - raw), stored into [0,q).
function mldsaUnpackT0(inp: []byte, off: int, v: []int, at: int) {
  let raw = mldsaUnpackBits(inp, off, 13)
  let n = 0
  while (n < 256) {
    v[at * 256 + n] = mldsaModQ(4096 - raw[n])
    n = n + 1
  }
}

// Unpack an s1/s2 polynomial into `v[at]`: c = (eta - raw), stored into [0,q).
function mldsaUnpackS(inp: []byte, off: int, v: []int, at: int) {
  let raw = mldsaUnpackBits(inp, off, 4)
  let n = 0
  while (n < 256) {
    v[at * 256 + n] = mldsaModQ(4 - raw[n])
    n = n + 1
  }
}

// Unpack a z polynomial into `v[at]`: c = (gamma1 - raw), stored into [0,q).
function mldsaUnpackZ(inp: []byte, off: int, v: []int, at: int) {
  let raw = mldsaUnpackBits(inp, off, 20)
  let n = 0
  while (n < 256) {
    v[at * 256 + n] = mldsaModQ(524288 - raw[n])
    n = n + 1
  }
}

// ---------------------------------------------------------------------------
// Hint (h) packing. The hint vector is sparse: for each of the k polynomials
// only the indices of the 1-bits are stored, terminated by k cumulative offsets.
// Layout: omega position bytes (zero-padded) then k offset bytes = 61 bytes.
// ---------------------------------------------------------------------------

// Pack hint vector `h` (k polynomials of 0/1 coefficients) into `out` at `off`.
function mldsaPackHint(h: []int, out: []byte, off: int) {
  let idx = 0
  let row = 0
  while (row < 6) {
    let n = 0
    while (n < 256) {
      if (h[row * 256 + n] == 1) {
        out[off + idx] = byte(n)
        idx = idx + 1
      }
      n = n + 1
    }
    out[off + 55 + row] = byte(idx)
    row = row + 1
  }
}

// Unpack and validate a hint vector from `inp[off:off+61]` into `h`. Returns
// false on any malformed encoding — non-monotonic offsets, a cumulative weight
// above omega, non-zero padding, or out-of-order positions within a row — which
// is how verification rejects tampered signatures.
function mldsaUnpackHint(inp: []byte, off: int, h: []int): bool {
  let n = 0
  while (n < 6 * 256) {
    h[n] = 0
    n = n + 1
  }
  // Cumulative offsets: offsets[0] = 0, offsets[row+1] = inp[off+55+row].
  let prevOff = 0
  let row = 0
  while (row < 6) {
    let curOff = int(inp[off + 55 + row])
    if (curOff < prevOff || curOff > 55) {
      return false
    }
    // Positions for this row occupy inp[off+prevOff : off+curOff], strictly
    // increasing so each names a distinct coefficient.
    let prevPos = -1
    let p = prevOff
    while (p < curOff) {
      let pos = int(inp[off + p])
      if (pos <= prevPos) {
        return false
      }
      h[row * 256 + pos] = 1
      prevPos = pos
      p = p + 1
    }
    prevOff = curOff
    row = row + 1
  }
  // Every padding byte between the last position and omega must be zero.
  let p = prevOff
  while (p < 55) {
    if (inp[off + p] != 0) {
      return false
    }
    p = p + 1
  }
  return true
}

// ---------------------------------------------------------------------------
// Matrix expansion and small SHAKE helpers shared by keygen/sign/verify.
// ---------------------------------------------------------------------------

// Expand the public matrix A_hat (k x l = 6 x 5 polynomials, NTT domain) from
// `rho`, filling `a` in row-major order.
function mldsaExpandA(rho: []byte, a: []int) {
  let i = 0
  while (i < 6) {
    let j = 0
    while (j < 5) {
      mldsaRejNtt(rho, i, j, a, (i * 5 + j) * 256)
      j = j + 1
    }
    i = i + 1
  }
}

// SHAKE256(data, n) as a fresh byte slice — the FIPS 204 `H` used for the seed
// expansion, tr, mu, rho', and c_tilde derivations.
function mldsaShake256(data: []byte, n: int): []byte {
  let s = newShake256()
  s.absorb(data)
  return s.squeeze(n)
}

// mu = H(tr || 0x00 || len(ctx) || ctx || msg, 64), streamed so the (possibly
// large) message is never copied into an intermediate M' buffer.
function mldsaComputeMu(tr: []byte, ctx: []byte, msg: []byte): []byte {
  let s = newShake256()
  s.absorb(tr)
  let pre = []byte(2)
  pre[0] = 0
  pre[1] = byte(len(ctx))
  s.absorb(pre)
  s.absorb(ctx)
  s.absorb(msg)
  return s.squeeze(64)
}

// Whether any coefficient of the length-`npoly` vector `v` has centered
// magnitude >= `bound` — the vector form of the norm rejection test.
function mldsaVecNormExceeds(v: []int, npoly: int, bound: int): bool {
  let i = 0
  while (i < npoly * 256) {
    if (mldsaNormExceeds(v[i], bound)) {
      return true
    }
    i = i + 1
  }
  return false
}

// ---------------------------------------------------------------------------
// Public surface.
// ---------------------------------------------------------------------------

// An ML-DSA-65 key pair: the 1952-byte public (verification) key `pk` and the
// 4032-byte secret (signing) key `sk`, both the FIPS 204 encodings.
export struct MldsaKeypair {
  pk: []byte
  sk: []byte
}

// KeyGen_internal (FIPS 204 Algorithm 6): derive a key pair deterministically
// from the 32-byte seed `seed` (the xi value). The same seed always yields the
// same keys, so a caller can store the seed instead of the full secret key.
// Panics if `seed` is not 32 bytes.
export function mldsaKeygenSeed(seed: []byte): MldsaKeypair {
  if (len(seed) != 32) {
    panic("mldsa: seed must be 32 bytes")
  }
  // Expand the seed (domain-separated by k and l) into rho, rho', and K.
  let sd = newShake256()
  sd.absorb(seed)
  let kl = []byte(2)
  kl[0] = 6
  kl[1] = 5
  sd.absorb(kl)
  let sb = sd.squeeze(128)
  let rho = sb[0:32]
  let rhoP = sb[32:96]
  let kk = sb[96:128]

  let zetas = mldsaZetas()

  // A_hat, and the secret vectors s1 (l), s2 (k).
  let a = []int(6 * 5 * 256)
  mldsaExpandA(rho, a)
  let s1 = []int(5 * 256)
  let s2 = []int(6 * 256)
  let i = 0
  while (i < 5) {
    mldsaRejBounded(rhoP, i, s1, i * 256)
    i = i + 1
  }
  i = 0
  while (i < 6) {
    mldsaRejBounded(rhoP, 5 + i, s2, i * 256)
    i = i + 1
  }

  // t = A_hat . NTT(s1) back in the coefficient domain, plus s2.
  let s1h = []int(5 * 256)
  i = 0
  while (i < 5 * 256) {
    s1h[i] = s1[i]
    i = i + 1
  }
  mldsaNttVec(s1h, 5, zetas)
  let t = []int(6 * 256)
  mldsaMatVec(a, 6, 5, s1h, t)
  mldsaInvNttVec(t, 6, zetas)
  i = 0
  while (i < 6 * 256) {
    t[i] = mldsaModQ(t[i] + s2[i])
    i = i + 1
  }

  // Split t into (t1, t0) and pack the public key.
  let t1 = []int(6 * 256)
  let t0 = []int(6 * 256)
  i = 0
  while (i < 6 * 256) {
    mldsaPower2Round(t[i], t1, t0, i)
    i = i + 1
  }
  let pk = []byte(1952)
  i = 0
  while (i < 32) {
    pk[i] = rho[i]
    i = i + 1
  }
  let p = 0
  while (p < 6) {
    mldsaPackT1(t1, p, pk, 32 + p * 320)
    p = p + 1
  }

  // sk = rho || K || tr || pack(s1) || pack(s2) || pack(t0).
  let tr = mldsaShake256(pk, 64)
  let sk = []byte(4032)
  i = 0
  while (i < 32) {
    sk[i] = rho[i]
    sk[32 + i] = kk[i]
    i = i + 1
  }
  i = 0
  while (i < 64) {
    sk[64 + i] = tr[i]
    i = i + 1
  }
  p = 0
  while (p < 5) {
    mldsaPackS(s1, p, sk, 128 + p * 128)
    p = p + 1
  }
  p = 0
  while (p < 6) {
    mldsaPackS(s2, p, sk, 768 + p * 128)
    p = p + 1
  }
  p = 0
  while (p < 6) {
    mldsaPackT0(t0, p, sk, 1536 + p * 416)
    p = p + 1
  }
  return MldsaKeypair{ pk: pk, sk: sk }
}

// KeyGen (FIPS 204 Algorithm 1): generate a fresh key pair from 32 bytes of OS
// cryptographic randomness. The seed is not retained.
export function mldsaKeygen(): MldsaKeypair {
  return mldsaKeygenSeed(randomBytes(32))
}

// Sign_internal (FIPS 204 Algorithm 7), deterministic (rnd = 0). Runs the
// rejection loop until a signature satisfying every norm and hint bound is
// found, then packs c_tilde || z || h.
function mldsaSignInternal(sk: []byte, tr: []byte, ctx: []byte, msg: []byte): []byte {
  let zetas = mldsaZetas()
  let rho = sk[0:32]
  let kk = sk[32:64]

  // Unpack the secret vectors and precompute their NTT forms.
  let s1 = []int(5 * 256)
  let s2 = []int(6 * 256)
  let t0 = []int(6 * 256)
  let p = 0
  while (p < 5) {
    mldsaUnpackS(sk, 128 + p * 128, s1, p)
    p = p + 1
  }
  p = 0
  while (p < 6) {
    mldsaUnpackS(sk, 768 + p * 128, s2, p)
    mldsaUnpackT0(sk, 1536 + p * 416, t0, p)
    p = p + 1
  }
  mldsaNttVec(s1, 5, zetas)
  mldsaNttVec(s2, 6, zetas)
  mldsaNttVec(t0, 6, zetas)

  let a = []int(6 * 5 * 256)
  mldsaExpandA(rho, a)

  let mu = mldsaComputeMu(tr, ctx, msg)
  // rho' = H(K || rnd || mu, 64) with rnd = 32 zero bytes (deterministic).
  let rs = newShake256()
  rs.absorb(kk)
  rs.absorb([]byte(32))
  rs.absorb(mu)
  let rhoP = rs.squeeze(64)

  let kappa = 0
  while (true) {
    // Commitment: w = A_hat . NTT(y) in the coefficient domain.
    let y = []int(5 * 256)
    let i = 0
    while (i < 5) {
      mldsaExpandMask(rhoP, kappa + i, y, i * 256)
      i = i + 1
    }
    kappa = kappa + 5
    let yh = []int(5 * 256)
    i = 0
    while (i < 5 * 256) {
      yh[i] = y[i]
      i = i + 1
    }
    mldsaNttVec(yh, 5, zetas)
    let w = []int(6 * 256)
    mldsaMatVec(a, 6, 5, yh, w)
    mldsaInvNttVec(w, 6, zetas)

    // Challenge c from c_tilde = H(mu || pack(HighBits(w))).
    let w1 = []byte(768)
    i = 0
    while (i < 6) {
      let poly = []int(256)
      let n = 0
      while (n < 256) {
        poly[n] = mldsaHighBits(w[i * 256 + n])
        n = n + 1
      }
      mldsaPackW1(poly, 0, w1, i * 128)
      i = i + 1
    }
    let cs = newShake256()
    cs.absorb(mu)
    cs.absorb(w1)
    let ctilde = cs.squeeze(48)
    let c = []int(256)
    mldsaSampleInBall(ctilde, c)
    let ch = []int(256)
    i = 0
    while (i < 256) {
      ch[i] = c[i]
      i = i + 1
    }
    mldsaNtt(ch, zetas)

    // z = y + c*s1; reject if any coefficient reaches gamma1 - beta.
    let z = []int(5 * 256)
    mldsaScaleVec(s1, 5, ch, z)
    mldsaInvNttVec(z, 5, zetas)
    i = 0
    while (i < 5 * 256) {
      z[i] = mldsaModQ(z[i] + y[i])
      i = i + 1
    }
    if (mldsaVecNormExceeds(z, 5, 524092)) {
      continue
    }

    // r0 = LowBits(w - c*s2); reject if it reaches gamma2 - beta.
    let cs2 = []int(6 * 256)
    mldsaScaleVec(s2, 6, ch, cs2)
    mldsaInvNttVec(cs2, 6, zetas)
    let wcs2 = []int(6 * 256)
    i = 0
    while (i < 6 * 256) {
      wcs2[i] = mldsaModQ(w[i] - cs2[i])
      i = i + 1
    }
    let bad = false
    i = 0
    while (i < 6 * 256) {
      // LowBits is centered; shift into [0,q) before the norm test.
      if (mldsaNormExceeds(mldsaModQ(mldsaLowBits(wcs2[i])), 261692)) {
        bad = true
        break
      }
      i = i + 1
    }
    if (bad) {
      continue
    }

    // c*t0: reject if any coefficient reaches gamma2, else build the hint.
    let ct0 = []int(6 * 256)
    mldsaScaleVec(t0, 6, ch, ct0)
    mldsaInvNttVec(ct0, 6, zetas)
    if (mldsaVecNormExceeds(ct0, 6, 261888)) {
      continue
    }
    // h[n] = HighBits(w-c*s2+c*t0) != HighBits(w-c*s2).
    let h = []int(6 * 256)
    let weight = 0
    i = 0
    while (i < 6 * 256) {
      let hi = mldsaHighBits(mldsaModQ(wcs2[i] + ct0[i]))
      let lo = mldsaHighBits(wcs2[i])
      if (hi != lo) {
        h[i] = 1
        weight = weight + 1
      } else {
        h[i] = 0
      }
      i = i + 1
    }
    if (weight > 55) {
      continue
    }

    // sig = c_tilde || pack(z) || pack(h).
    let sig = []byte(3309)
    i = 0
    while (i < 48) {
      sig[i] = ctilde[i]
      i = i + 1
    }
    p = 0
    while (p < 5) {
      mldsaPackZ(z, p, sig, 48 + p * 640)
      p = p + 1
    }
    mldsaPackHint(h, sig, 3248)
    return sig
  }
  return []byte(0) // unreachable: the loop returns on success
}

// Sign `msg` under signing key `sk` with an application context string `ctx`
// (FIPS 204 Algorithm 2, deterministic). The context binds the signature to a
// usage domain and defaults to empty in `mldsaSign`; it may be at most 255
// bytes. Returns the 3309-byte signature. Panics on a malformed `sk` or an
// over-long `ctx`.
export function mldsaSignCtx(sk: []byte, msg: []byte, ctx: []byte): []byte {
  if (len(sk) != 4032) {
    panic("mldsa: secret key must be 4032 bytes")
  }
  if (len(ctx) > 255) {
    panic("mldsa: context must be at most 255 bytes")
  }
  let tr = sk[64:128]
  return mldsaSignInternal(sk, tr, ctx, msg)
}

// Sign `msg` under signing key `sk` with an empty context (FIPS 204 Algorithm 2,
// deterministic). The signature is a pure function of `(sk, msg)`.
export function mldsaSign(sk: []byte, msg: []byte): []byte {
  return mldsaSignCtx(sk, msg, []byte(0))
}

// Verify_internal (FIPS 204 Algorithm 8): recompute the commitment from the
// signature and check its hash matches c_tilde. Returns false on any structural
// or arithmetic failure.
function mldsaVerifyInternal(pk: []byte, tr: []byte, ctx: []byte, msg: []byte, sig: []byte): bool {
  let zetas = mldsaZetas()
  let rho = pk[0:32]

  // Unpack and range-check the signature.
  let ctilde = sig[0:48]
  let z = []int(5 * 256)
  let p = 0
  while (p < 5) {
    mldsaUnpackZ(sig, 48 + p * 640, z, p)
    p = p + 1
  }
  let h = []int(6 * 256)
  if (!mldsaUnpackHint(sig, 3248, h)) {
    return false
  }
  if (mldsaVecNormExceeds(z, 5, 524092)) {
    return false
  }

  let t1 = []int(6 * 256)
  p = 0
  while (p < 6) {
    mldsaUnpackT1(pk, 32 + p * 320, t1, p)
    p = p + 1
  }

  let a = []int(6 * 5 * 256)
  mldsaExpandA(rho, a)
  let mu = mldsaComputeMu(tr, ctx, msg)

  let c = []int(256)
  mldsaSampleInBall(ctilde, c)
  mldsaNtt(c, zetas)
  mldsaNttVec(z, 5, zetas)

  // t1_hat = NTT(t1 * 2^d).
  let i = 0
  while (i < 6 * 256) {
    t1[i] = mldsaModQ(t1[i] * 8192)
    i = i + 1
  }
  mldsaNttVec(t1, 6, zetas)
  let ct1 = []int(6 * 256)
  mldsaScaleVec(t1, 6, c, ct1)

  // w' = A_hat . z - c * t1_hat, back in the coefficient domain.
  let az = []int(6 * 256)
  mldsaMatVec(a, 6, 5, z, az)
  i = 0
  while (i < 6 * 256) {
    az[i] = mldsaModQ(az[i] - ct1[i])
    i = i + 1
  }
  mldsaInvNttVec(az, 6, zetas)

  // Reapply the hint and compare c_tilde against H(mu || pack(w1')).
  let w1 = []byte(768)
  i = 0
  while (i < 6) {
    let poly = []int(256)
    let n = 0
    while (n < 256) {
      poly[n] = mldsaUseHint(h[i * 256 + n], az[i * 256 + n])
      n = n + 1
    }
    mldsaPackW1(poly, 0, w1, i * 128)
    i = i + 1
  }
  let vs = newShake256()
  vs.absorb(mu)
  vs.absorb(w1)
  let expect = vs.squeeze(48)
  let ok = true
  i = 0
  while (i < 48) {
    if (expect[i] != ctilde[i]) {
      ok = false
    }
    i = i + 1
  }
  return ok
}

// Verify signature `sig` on `msg` under verification key `pk` and context `ctx`
// (FIPS 204 Algorithm 3). Returns true only if the signature is well formed and
// valid; every malformed input yields false rather than an error.
export function mldsaVerifyCtx(pk: []byte, msg: []byte, sig: []byte, ctx: []byte): bool {
  if (len(pk) != 1952 || len(sig) != 3309 || len(ctx) > 255) {
    return false
  }
  let tr = mldsaShake256(pk, 64)
  return mldsaVerifyInternal(pk, tr, ctx, msg, sig)
}

// Verify signature `sig` on `msg` under verification key `pk` with an empty
// context (FIPS 204 Algorithm 3).
export function mldsaVerify(pk: []byte, msg: []byte, sig: []byte): bool {
  return mldsaVerifyCtx(pk, msg, sig, []byte(0))
}
