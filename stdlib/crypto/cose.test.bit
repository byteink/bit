// stdlib/crypto/cose.test.bit: COSE_Key parsing and verification (RFC 9052 and
// RFC 9053) against keys and signatures that did not come from this module.
//
// Keys: every distinct EC2 and OKP public key in the JSON files of
// github.com/cose-wg/Examples at commit 53c9d634333bb4f529d78f5980fffa2667ee2c12
// (13 of 13), re-encoded as public-only COSE_Keys with the alg the example
// used; and the example credential public keys of WebAuthn level 3 section
// 6.5.1.1 (3 of 3: the ES256 key verbatim, the PS256 and RS256 keys built to
// the shape the spec gives, with the 2048-bit modulus of cose-wg rsa-pss-01
// standing in for the digits the spec elides).
//
// Signatures: the ToBeSign and signature of cose-wg ecdsa-sig-01 (ES256),
// ecdsa-sig-02 (ES384), eddsa-sig-01 (EdDSA) and rsa-pss-01 (PS256). RS256 is
// the same RSA key and message signed by OpenSSL through Python `cryptography`,
// because the corpus has no RS256 signature. The COSE examples carry ECDSA as
// raw r || s; the vectors here hold the DER form WebAuthn sends, converted
// from those bytes outside this repository.

import { contains } from "std/strings"

class KeyRow {
  name: string,
  hex: string,
  alg: int,
  err: string,
}

fn keyRow(name: string, hex: string, alg: int, err: string): KeyRow {
  return KeyRow{ name = name, hex = hex, alg = alg, err = err }
}

fn hx(s: string): []byte {
  return decodeHex(s) catch e {
    panic("bad hex in cose.test.bit: ${e.message()}")
  }
}

fn key(s: string): CoseKey {
  return parseCoseKey(hx(s)) catch e {
    panic("parseCoseKey: ${e.message()}")
  }
}

// An error's message, or "" when the call succeeded.
fn parseErr(s: string): string {
  parseCoseKey(hx(s)) catch e {
    return e.message()
  }
  return ""
}

fn verifies(k: CoseKey, alg: int, msg: []byte, sig: []byte): bool {
  return coseVerify(k, alg, msg, sig) catch e {
    panic("coseVerify: ${e.message()}")
  }
}

fn verifyErr(k: CoseKey, alg: int): string {
  coseVerify(k, alg, []byte(1), []byte(1)) catch e {
    return e.message()
  }
  return ""
}

// `b` with its last byte flipped.
fn flipped(b: []byte): []byte {
  let t = rsaConcat(b, []byte(0))
  t[len(t) - 1] = t[len(t) - 1] ^ 1
  return t
}

// One signature known to verify, then the same signature over a tampered
// message and a tampered signature over the right message.
fn knownAnswer(name: string, k: CoseKey, alg: int, msg: string, sig: string) {
  let m = hx(msg)
  let s = hx(sig)
  assert(coseAlg(k) == alg, "${name}: coseAlg")
  assert(verifies(k, alg, m, s), "${name}: the valid signature must verify")
  assert(!verifies(k, alg, flipped(m), s), "${name}: a tampered message must not verify")
  assert(!verifies(k, alg, m, flipped(s)), "${name}: a tampered signature must not verify")
}

