fn corpus(): []KeyRow {
  let out = []KeyRow(0)
  for r of corpus1() {
    out = append(out, r)
  }
  for r of corpus2() {
    out = append(out, r)
  }
  for r of corpus3() {
    out = append(out, r)
  }
  for r of corpus4() {
    out = append(out, r)
  }
  for r of corpus5() {
    out = append(out, r)
  }
  return out
}

