  return [
    keyRow(
      "y of the wrong type",
      "a5010203262001215820bac5b11cad8f99f9c72b05cf4b9e26d244dc189f745228255a219a86d6a09eff226179",
      0,
      "neither a byte string nor a boolean",
    ),
  ]
}

fn rejections(): []KeyRow {
  let out = []KeyRow(0)
  for r of rejections1() {
    out = append(out, r)
  }
  for r of rejections2() {
    out = append(out, r)
  }
  for r of rejections3() {
    out = append(out, r)
  }
  for r of rejections4() {
    out = append(out, r)
  }
  for r of rejections5() {
    out = append(out, r)
  }
  return out
}

test "cose-wg corpus: 13 of 13 EC2 and OKP keys parse, or are refused by name" {
  let rows = corpus()
  assert(len(rows) == 13, "the corpus has 13 keys, got ${len(rows)}")
  let parsed = 0
  let refused = 0
  for r of rows {
    if (r.alg != 0) {
      assert(coseAlg(key(r.hex)) == r.alg, "${r.name}: coseAlg")
      parsed = parsed + 1
    } else {
      let got = parseErr(r.hex)
      assert(contains(got, r.err), "${r.name}: want an error containing '${r.err}', got '${got}'")
      refused = refused + 1
    }
  }
  assert(parsed == 7 && refused == 6, "7 parse and 6 are refused, got ${parsed} and ${refused}")
}

test "WebAuthn example credential public keys: 3 of 3 parse" {
  assert(
      coseAlg(key("a501020326200121582065eda5a12577c2bae829437fe338701a10aaa375e1bb5b5de108de439c08551d2258201e52ed75701163f7f9e40ddf9f341b3dc9ba860af7e0ca7ca7e9eecd0084d19c")) ==
      -7,
    "ES256 key",
  )
  assert(
      coseAlg(key("")) ==
      -37,
    "PS256 key",
  )
  assert(
      coseAlg(key("")) ==
      -257,
    "RS256 key",
  )
}

test "a boolean y is the compressed point and gives the same key" {
  let full = key("a501020326200121582065eda5a12577c2bae829437fe338701a10aaa375e1bb5b5de108de439c08551d2258201e52ed75701163f7f9e40ddf9f341b3dc9ba860af7e0ca7ca7e9eecd0084d19c")
  let packed = key("a501020326200121582065eda5a12577c2bae829437fe338701a10aaa375e1bb5b5de108de439c08551d22f4")
  match (full) {
    Ec2(a) => {
      match (packed) {
        Ec2(b) => {
          assert(bigintCmp(a.q.x, b.q.x) == 0 && bigintCmp(a.q.y, b.q.y) == 0, "same point")
        }
        _ => assert(false, "compressed key is not EC2")
      }
    }
    _ => assert(false, "key is not EC2")
  }
}

test "known answers: ES256, ES384, EdDSA, RS256, PS256 (5 of 5, 4 required)" {
  knownAnswer(
    "ES256",
    key("a5010203262001215820bac5b11cad8f99f9c72b05cf4b9e26d244dc189f745228255a219a86d6a09eff22582020138bf82dc1b6d562be0fa54ab7804a3a64b6d72ccfed6b6fb6ed28bbfc117e"),
    -7,
    "846a5369676e61747572653145a2012603004054546869732069732074686520636f6e74656e742e",
      "304502206520bbaf2081d7e0ed0f95f76eb0733d667005f7467cec4b87b9381a" +
      "6ba1ede8022100e00df29f32a37230f39a842a54821fdd223092819d7728efb9" +
      "d3a0080b75380b",
  )
  knownAnswer(
    "ES384",
    key("a5010203382220022158309132723f6292b010619dbe248d698c17b58756c639e7150f81bee4eb8ac37236ad0a1a19d67be32a66263e1e524d129c22583098cd3078c554d832ac603c4326410ff61662459b41f1f3df5dbcc83598ff7c5ed8411ca735679d1c4cb3009397d9ef2c"),
    -35,
    "846a5369676e61747572653144a10138224054546869732069732074686520636f6e74656e742e",
      "306502305f150abd1c7d25b32065a14e05d6cb1f665d10769ff455ea9a2e0ada" +
      "b5de63838db257f0949c41e13330e110eba7b912023100f34e1546fb1366a256" +
      "8faa91ec3e6c8d42f4a67a0edf731d88c9aead52258b2e2c4740ef614f02e9d9" +
      "1e9b7b59622a3c",
  )
  knownAnswer(
    "EdDSA",
    key("a4010103272006215820d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"),
    -8,
    "846a5369676e61747572653145a2012703004054546869732069732074686520636f6e74656e742e",
      "7142fd2ff96d56db85bee905a76ba1d0b7321a95c8c4d3607c5781932b7afb87" +
      "11497dfa751bf40b58b3bcc32300b1487f3db34085eef013bf08f4a44d6fef0d",
  )
  knownAnswer(
    "RS256",
    key(""),
    -257,
    "85695369676e617475726543a1030044a10138244054546869732069732074686520636f6e74656e742e",
      "5cdfbd7a8875ffea3f0c5052cc7ba20c0bfe882db7ce3bbc32290c3f7839dae7" +
      "ab25112eca19dc1e79c97627e36123cbfae9d3a4921d3ee46307c489260f10c6" +
      "76f9d806fe710f06a0478cf6d9899b681f230dc4590da8b684f56fcdd5982152" +
      "26d994bb209f1cedaf05a37b0be6410512ffb988ec6eaf16357ef042627f1a1f" +
      "84f62829e3868764c9baafd325fedc95e8b5aee316361c8b94c6795e8ac89dac" +
      "a15146ade7c37ff6c156c54a211e6895b518ad202cd1e246951ff178afd1ed5e" +
      "3766bbb681ac9009339756352568fde65ad35796d41fcf64e5218fa0977e7256" +
      "cc5f5c9c6949fbc96bc0bb8dfa31668b31984c55d1a9b575399582695339656a",
  )
  knownAnswer(
    "PS256",
    key(""),
    -37,
    "85695369676e617475726543a1030044a10138244054546869732069732074686520636f6e74656e742e",
      "3ad4027074989995f25e167f99c9b4096fdc5c242d438d30382ae7b30f83c88d" +
      "5b5ebecb64d2256d58d3cce5c47d343bfa532b117c2d04df3fb20679a99cf355" +
      "5a7dae6098bd123b0f3441a1e50e897cbaa1b17ce171ebab20ae2e10f16d6ee9" +
      "18d37af102175979be65ebcedeb47519346ea3ed6d13b5741bc63742ae31342b" +
      "10b46fe93f39b55fdd6e32128fd8b476fed88f671f304d0943d2c7a33bce48df" +
      "08e1f890cf5acda3ef46da21981c3a687cfff85eeb276a98612f38d6ee636448" +
      "59d66a9ad49939ea290f7a9fdfed9af1246930f522cb8c6909567dcbe2729716" +
      "cb18a31e6f231db3d69a7a432aa3d6fa1def9c9659616beb626f158378e0fbdd",
  )
}

test "an RS256 key does not verify a PS256 signature, nor the reverse" {
  let rs = key("")
  let ps = key("")
  assert(
    !verifies(
      rs,
      -257,
      hx("85695369676e617475726543a1030044a10138244054546869732069732074686520636f6e74656e742e"),
      hx(
          "3ad4027074989995f25e167f99c9b4096fdc5c242d438d30382ae7b30f83c88d" +
          "5b5ebecb64d2256d58d3cce5c47d343bfa532b117c2d04df3fb20679a99cf355" +
          "5a7dae6098bd123b0f3441a1e50e897cbaa1b17ce171ebab20ae2e10f16d6ee9" +
          "18d37af102175979be65ebcedeb47519346ea3ed6d13b5741bc63742ae31342b" +
          "10b46fe93f39b55fdd6e32128fd8b476fed88f671f304d0943d2c7a33bce48df" +
          "08e1f890cf5acda3ef46da21981c3a687cfff85eeb276a98612f38d6ee636448" +
          "59d66a9ad49939ea290f7a9fdfed9af1246930f522cb8c6909567dcbe2729716" +
          "cb18a31e6f231db3d69a7a432aa3d6fa1def9c9659616beb626f158378e0fbdd",
      ),
    ),
    "PSS under RS256",
  )
  assert(
    !verifies(
      ps,
      -37,
      hx("85695369676e617475726543a1030044a10138244054546869732069732074686520636f6e74656e742e"),
      hx(
          "5cdfbd7a8875ffea3f0c5052cc7ba20c0bfe882db7ce3bbc32290c3f7839dae7" +
          "ab25112eca19dc1e79c97627e36123cbfae9d3a4921d3ee46307c489260f10c6" +
          "76f9d806fe710f06a0478cf6d9899b681f230dc4590da8b684f56fcdd5982152" +
          "26d994bb209f1cedaf05a37b0be6410512ffb988ec6eaf16357ef042627f1a1f" +
          "84f62829e3868764c9baafd325fedc95e8b5aee316361c8b94c6795e8ac89dac" +
          "a15146ade7c37ff6c156c54a211e6895b518ad202cd1e246951ff178afd1ed5e" +
          "3766bbb681ac9009339756352568fde65ad35796d41fcf64e5218fa0977e7256" +
          "cc5f5c9c6949fbc96bc0bb8dfa31668b31984c55d1a9b575399582695339656a",
      ),
    ),
    "PKCS1 under PS256",
  )
}

test "malformed signatures are false, not errors" {
  let es = key("a5010203262001215820bac5b11cad8f99f9c72b05cf4b9e26d244dc189f745228255a219a86d6a09eff22582020138bf82dc1b6d562be0fa54ab7804a3a64b6d72ccfed6b6fb6ed28bbfc117e")
  assert(
    !verifies(
      es,
      -7,
      hx("846a5369676e61747572653145a2012603004054546869732069732074686520636f6e74656e742e"),
      []byte(0),
    ),
    "empty DER",
  )
  assert(
    !verifies(
      es,
      -7,
      hx("846a5369676e61747572653145a2012603004054546869732069732074686520636f6e74656e742e"),
      []byte(64),
    ),
    "raw zeros are not DER",
  )
  assert(
    !verifies(
      key("a4010103272006215820d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"),
      -8,
      hx("846a5369676e61747572653145a2012703004054546869732069732074686520636f6e74656e742e"),
      []byte(63),
    ),
    "short Ed25519 signature",
  )
  assert(
    !verifies(
      key(""),
      -257,
      hx("85695369676e617475726543a1030044a10138244054546869732069732074686520636f6e74656e742e"),
      []byte(255),
    ),
    "short RSA signature",
  )
}

test "coseVerify refuses an alg that is unsupported or not the key's" {
  let es = key("a5010203262001215820bac5b11cad8f99f9c72b05cf4b9e26d244dc189f745228255a219a86d6a09eff22582020138bf82dc1b6d562be0fa54ab7804a3a64b6d72ccfed6b6fb6ed28bbfc117e")
  assert(contains(verifyErr(es, -36), "unsupported alg -36"), "unsupported alg")
  assert(
    contains(verifyErr(es, -8), "does not match the key, which is for alg -7"),
    "EdDSA on an EC2 key",
  )
  assert(
    contains(
      verifyErr(
        key(""),
        -257,
      ),
      "which is for alg -37",
    ),
    "RS256 on a PS256 key",
  )
}

test "rejections: 29 of 29 malformed keys fail with a precise error" {
  let rows = rejections()
  assert(len(rows) == 29, "the table has 29 cases, got ${len(rows)}")
  for r of rows {
    let got = parseErr(r.hex)
    assert(got != "", "${r.name}: must be rejected")
    assert(contains(got, r.err), "${r.name}: want an error containing '${r.err}', got '${got}'")
  }
}
