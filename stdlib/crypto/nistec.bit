// Bit standard library — crypto module, NIST P-256 and P-384 curve arithmetic.
//
// Short-Weierstrass point arithmetic over the two prime-field NIST curves,
// secp256r1 (P-256) and secp384r1 (P-384), built on the variable-width `Nat`
// bigint in `bigint.bit`. Both curves have `a = -3` and a prime group order, so
// a single set of *complete* addition formulas covers every case with no
// exceptional inputs.
//
// Design, in the order the task fixes it: correctness first, then a scalar
// multiplication with no secret-dependent branch or table index, then speed.
//
//   * Point addition is the Renes-Costello-Batina complete formula (2016,
//     Algorithm 1 / EFD `add-2015-rcb`) in homogeneous projective coordinates
//     `(X:Y:Z)`, identity `(0:1:0)`. It is *unified* — the same routine doubles
//     a point — and *complete*: correct for the identity, for `P + (-P)`, and
//     for `P + P`, so scalar multiplication needs no special cases.
//
//   * Scalar multiplication is a Montgomery ladder: every scalar bit drives the
//     identical `add` + `double` pair, and the two accumulators are exchanged
//     by a branchless masked swap (`nistecSwapPt`) rather than a data-
//     dependent swap or an indexed table lookup. The ladder runs a fixed number
//     of iterations (`8 * field-byte-width`), so its control flow is independent
//     of the scalar value.
//
// Constant-time scope. The ladder is constant-time *by construction* at the
// algorithm level, and its field arithmetic is the fixed-width Montgomery code
// of `./bigintmont.bit` (#7567). The conversions into and out of the ladder,
// the affine conversion and point decoding still use the variable-width `Nat`
// code (schoolbook multiply, then Solinas special-prime reduction), whose
// running time depends on operand limb counts, as does the scalar's own
// normalized length. Until those move too this module, like the rest of
// `std/crypto`, is branch-safe but not timing-flat at the limb level. Secret
// scalars are still protected from the classic branch/index side channels; do
// not rely on it against a limb-timing adversary yet.
//
// Field inversion (projective -> affine) and the modular square root used to
// decompress a point both go through `bigintModExp`, i.e. Fermat's little
// theorem `z^(p-2)` and `rhs^((p+1)/4)` (valid because `p == 3 (mod 4)` for both
// curves). Being part of the flat `std/crypto` module, this file reaches the
// `bigint*` API and the module-private `Nat.limbs` / `bigintMake` directly, and
// names `newError` from the prelude without importing it. Every private helper
// is prefixed `nistec` to keep the module's flat namespace clean.

// A curve's public domain parameters plus the values derived once at
// construction. Fields are module-private; callers obtain a `Curve` from
// `nistecP256` / `nistecP384` and pass it opaquely to the point routines.
export class Curve {
  p: Nat,       // field prime
  n: Nat,       // group (subgroup) order
  a: Nat,       // curve coefficient a = p - 3
  b: Nat,       // curve coefficient b
  b3: Nat,      // 3*b mod p, the RCB addition constant
  gx: Nat,      // base point G x-coordinate
  gy: Nat,      // base point G y-coordinate
  size: int,    // field element width in bytes (32 for P-256, 48 for P-384)
  bits: int,    // scalar bit length scanned by the ladder = 8*size
  sqrtExp: Nat, // (p+1)/4, the square-root exponent (p == 3 mod 4)
  pm2: Nat,     // p - 2, the Fermat inversion exponent
}

// An affine curve point, or the point at infinity when `infinity` is set. `x`
// and `y` are exported so callers (ECDSA, ECDH) and tests can read coordinates.
export class Point { export x: Nat, export y: Nat, export infinity: bool }

// A point in homogeneous projective coordinates `(X:Y:Z)`; `Z == 0` is the point
// at infinity. Module-private working representation for the addition ladder.
class Jac { x: Nat, y: Nat, z: Nat }

// ---------------------------------------------------------------------------
// Domain parameters
// ---------------------------------------------------------------------------

// The `Nat` a big-endian hex literal spells. The literals below are fixed and
// valid, so a decode error is impossible; it degrades to zero, which any curve
// self-test would catch immediately.
fn nistecHex(s: string): Nat {
  let b = decodeHex(s) catch _ {
    return bigintZero()
  }
  return bigintFromBytes(b)
}

// `a - b` for a difference known to be non-negative (parameter setup only). The
// `catch` is unreachable for the callers here.
fn nistecSub(a: Nat, b: Nat): Nat {
  return bigintSub(a, b) catch _ {
    return bigintZero()
  }
}

// The quotient `a / b` for a known non-zero `b` (parameter setup only). The
// `catch` is unreachable.
fn nistecDivQ(a: Nat, b: Nat): Nat {
  let d = bigintDivMod(a, b) catch _ {
    return bigintZero()
  }
  return d.q
}

// Assemble a curve from its big-endian hex parameters, precomputing the derived
// constants (`a`, `3b`, `(p+1)/4`, `p-2`) the point routines need.
fn nistecMakeCurve(
  size: int,
  pHex: string,
  nHex: string,
  bHex: string,
  gxHex: string,
  gyHex: string,
): Curve {
  let p = nistecHex(pHex)
  let b = nistecHex(bHex)
  let one = bigintFromU64(1)
  let three = bigintFromU64(3)
  return Curve{
    p = p,
    n = nistecHex(nHex),
    a = nistecSub(p, three),
    b = b,
    b3 = bigintModNZ(bigintMul(b, three), p),
    gx = nistecHex(gxHex),
    gy = nistecHex(gyHex),
    size = size,
    bits = size * 8,
    sqrtExp = nistecDivQ(bigintAdd(p, one), bigintFromU64(4)),
    pm2 = nistecSub(p, bigintFromU64(2)),
  }
}

// The NIST P-256 curve (secp256r1 / prime256v1).
export fn nistecP256(): Curve {
  return nistecMakeCurve(
    32,
    "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff",
    "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551",
    "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b",
    "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296",
    "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5",
  )
}

// The NIST P-384 curve (secp384r1).
export fn nistecP384(): Curve {
  return nistecMakeCurve(
    48,
    "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff",
    "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973",
    "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef",
    "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7",
    "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f",
  )
}

// ---------------------------------------------------------------------------
// Field arithmetic modulo p
// ---------------------------------------------------------------------------
//
// Every field element is kept reduced in `[0, p)`. Multiplication reduces with
// Solinas (special-prime) reduction — word recombination driven by the sparse
// shape of each NIST prime — instead of Knuth long division, which allocated ~10
// heap objects per field multiply. Add and subtract of already-reduced operands
// finish with a single conditional subtraction of `p`. Only an unrecognized curve
// width falls back to the generic `bigintModNZ` divider.

// Whether the little-endian word slice `a` is `>= p`, where `p` is `L` words. `a`
// carries up to `L + 2` words after reduction (its value is a small multiple of
// `p`), so any non-zero word above index `L - 1` already proves `a >= p`.
fn nistecWordGE(a: []u32, p: []u32, L: int): bool {
  let i = len(a) - 1
  while (i >= L) {
    if (a[i] != 0) {
      return true
    }
    i = i - 1
  }
  i = L - 1
  while (i >= 0) {
    if (a[i] != p[i]) {
      return a[i] > p[i]
    }
    i = i - 1
  }
  return true
}

// Subtract the `L`-word prime `p` (zero-extended to `len(a)`) from the little-
// endian `a` in place. The caller has established `a >= p`, so the running borrow
// always cancels by the top word.
fn nistecWordSubP(a: []u32, p: []u32, L: int) {
  let borrow: u64 = 0
  let i = 0
  while (i < len(a)) {
    let pv: u64 = 0
    if (i < L) {
      pv = u64(p[i])
    }
    let d = u64(a[i]) + 0x100000000 - pv - borrow
    a[i] = u32(d & 0xffffffff)
    borrow = 1 - (d >> 32)
    i = i + 1
  }
}

// Finish a Solinas reduction. `col` holds the signed per-word coefficients of a
// value congruent to the product, with every word at index `>= L` already folded
// to zero. Bias by `k*p` so the value is non-negative, carry-propagate it into
// words, then subtract `p` at most `bound` times to land in `[0, p)`. `k` and
// `bound` are sized per curve from the worst-case column magnitudes, so both loops
// are statically bounded and exactly one result `Nat` is built. `int` is i64 in
// two's complement with an arithmetic `>>`, so the signed carry chain is exact.
fn nistecSolinasFinish(col: []int, p: []u32, L: int, k: int, bound: int): Nat {
  let j = 0
  while (j < L) {
    col[j] = col[j] + k * int(p[j])
    j = j + 1
  }
  let W = L + 2
  let out = []u32(W)
  let carry = 0
  j = 0
  while (j < W) {
    let s = col[j] + carry
    out[j] = u32(s & 0xffffffff)
    carry = s >> 32
    j = j + 1
  }
  let n = 0
  while (n < bound && nistecWordGE(out, p, L)) {
    nistecWordSubP(out, p, L)
    n = n + 1
  }
  return bigintMake(out)
}

// Load the little-endian product `prod` (<= `2L` words) into a signed `2L`-word
// column array; absent high words are zero.
fn nistecLoadCols(prod: []u32, L: int): []int {
  let col = []int(2 * L)
  let n = len(prod)
  let i = 0
  while (i < 2 * L) {
    if (i < n) {
      col[i] = int(prod[i])
    }
    i = i + 1
  }
  return col
}

// `prod mod p256` by Solinas reduction. Because `p256 = 2^256 - 2^224 + 2^192 +
// 2^96 - 1`, in 32-bit words (`t = 2^32`) the reduction relation is
// `t^8 == t^7 - t^6 - t^3 + 1 (mod p)`. Folding each word at index `>= 8` down by
// that relation — top-down, so a fold's own deposits into still-higher columns are
// folded in turn — clears every high word into signed columns 0..7. `k = 5` covers
// the negative terms (which sum to `< 4p`); the result reduces in at most a handful
// of subtractions (bound 16, worst case 10).
fn nistecReduceP256(prod: []u32): Nat {
  let col = nistecLoadCols(prod, 8)
  let i = 15
  while (i >= 8) {
    let x = col[i]
    col[i] = 0
    let base = i - 8
    col[base] = col[base] + x
    col[base + 3] = col[base + 3] - x
    col[base + 6] = col[base + 6] - x
    col[base + 7] = col[base + 7] + x
    i = i - 1
  }
  return nistecSolinasFinish(col, nistecP256Prime(), 8, 5, 16)
}

// `prod mod p384` by Solinas reduction. Because `p384 = 2^384 - 2^128 - 2^96 +
// 2^32 - 1`, with `t = 2^32` the relation is `t^12 == t^4 + t^3 - t + 1 (mod p)`.
// The same top-down fold clears words at index `>= 12` into signed columns 0..11.
// `k = 2` covers the negative terms (`< p`); the result reduces in at most a few
// subtractions (bound 16, worst case 6).
fn nistecReduceP384(prod: []u32): Nat {
  let col = nistecLoadCols(prod, 12)
  let i = 23
  while (i >= 12) {
    let x = col[i]
    col[i] = 0
    let base = i - 12
    col[base] = col[base] + x
    col[base + 1] = col[base + 1] - x
    col[base + 3] = col[base + 3] + x
    col[base + 4] = col[base + 4] + x
    i = i - 1
  }
  return nistecSolinasFinish(col, nistecP384Prime(), 12, 2, 16)
}

// The P-256 prime as exactly 8 little-endian words. The divider-free reducers need
// `p` in fixed-width word form; the KATs cross-check it against the curve's `p`.
fn nistecP256Prime(): []u32 {
  return []u32{
    0xffffffff, 0xffffffff, 0xffffffff, 0x00000000,
    0x00000000, 0x00000000, 0x00000001, 0xffffffff,
  }
}

// The P-384 prime as exactly 12 little-endian words.
fn nistecP384Prime(): []u32 {
  return []u32{
    0xffffffff, 0x00000000, 0x00000000, 0xffffffff,
    0xfffffffe, 0xffffffff, 0xffffffff, 0xffffffff,
    0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff,
  }
}

// Reduce a product to `[0, p)` for curve `c`: Solinas reduction for the two NIST
// primes (selected by field-byte width), else the generic divider.
fn nistecFeReduce(c: Curve, prod: Nat): Nat {
  if (c.size == 32) {
    return nistecReduceP256(prod.limbs)
  }
  if (c.size == 48) {
    return nistecReduceP384(prod.limbs)
  }
  return bigintModNZ(prod, c.p)
}

// `(a + b) mod p`. Reduced operands give `a + b < 2p`, so a single conditional
// subtraction of `p` reduces the sum; the `catch` is unreachable (`s >= p`).
fn nistecFeAdd(c: Curve, a: Nat, b: Nat): Nat {
  let s = bigintAdd(a, b)
  if (bigintCmp(s, c.p) >= 0) {
    return bigintSub(s, c.p) catch _ {
      return bigintZero()
    }
  }
  return s
}

// `(a - b) mod p`. For reduced `a, b`: when `a >= b` the difference is already in
// `[0, p)`; otherwise `a + p - b` lies in `(0, p)`. No division; the `catch`es are
// unreachable.
fn nistecFeSub(c: Curve, a: Nat, b: Nat): Nat {
  if (bigintCmp(a, b) >= 0) {
    return bigintSub(a, b) catch _ {
      return bigintZero()
    }
  }
  return bigintSub(bigintAdd(a, c.p), b) catch _ {
    return bigintZero()
  }
}

// `(a * b) mod p`.
fn nistecFeMul(c: Curve, a: Nat, b: Nat): Nat {
  return nistecFeReduce(c, bigintMul(a, b))
}

// `(a * a) mod p`.
fn nistecFeSqr(c: Curve, a: Nat): Nat {
  return nistecFeReduce(c, bigintSqr(a))
}

// `a^(-1) mod p` by Fermat's little theorem `a^(p-2)`. `bigintModExp` takes the
// constant-time Montgomery ladder for the odd prime `p`; it only fails on a zero
// modulus, so the `catch` is unreachable.
fn nistecFeInv(c: Curve, a: Nat): Nat {
  return bigintModExp(a, c.pm2, c.p) catch _ {
    return bigintZero()
  }
}

// A square root of `a` modulo `p`: `a^((p+1)/4)`, which is a square root exactly
// when `a` is a quadratic residue (`p == 3 mod 4`). The caller must verify the
// result squares back to `a`. The `catch` is unreachable.
fn nistecSqrt(c: Curve, a: Nat): Nat {
  return bigintModExp(a, c.sqrtExp, c.p) catch _ {
    return bigintZero()
  }
}

// The low bit of `y` (0 or 1), for SEC 1 compressed-point parity.
fn nistecParity(y: Nat): byte {
  if (len(y.limbs) == 0) {
    return 0
  }
  return byte(y.limbs[0] & 1)
}

// ---------------------------------------------------------------------------
// Complete projective point addition (Renes-Costello-Batina, a = -3)
// ---------------------------------------------------------------------------
//
// The point routines run on the fixed-width Montgomery workspace of
// `./bigintmont.bit`: a coordinate is exactly `len(p)` limbs in Montgomery form
// (`v*R mod p`), and every field operation writes into a preallocated buffer.
// The variable-width `Nat` form allocated a fresh value per field operation,
// about 48 KB per ladder step and 24.6 MB per ECDSA verification (#7567).
// Montgomery form commutes with addition and subtraction, so only the constants
// `a`, `3b` and the points entering or leaving the ladder are converted.

// The workspace one point operation or scalar multiplication runs in: the
// Montgomery context for `p`, the curve constants `a` and `3b` in Montgomery
// form, and the RCB temporaries. Built once per operation, never shared.
class NistecWs {
  m: MontCtx,
  a: []u32,
  b3: []u32,
  t0: []u32,
  t1: []u32,
  t2: []u32,
  t3: []u32,
  t4: []u32,
  t5: []u32,
  x3: []u32,
  y3: []u32,
  z3: []u32,
}

// A projective point whose coordinates are fixed-width Montgomery forms.
class MontPt { x: []u32, y: []u32, z: []u32 }

// `Mont(v) = v*R mod p` as a fresh `len(p)`-limb value, for `v < p`.
fn nistecToMont(m: MontCtx, v: Nat): []u32 {
  let out = bigintWiden(v, len(m.n))
  bigintMontMulTo(m, out, out, m.r2)
  return out
}

// The normalized `Nat` that the Montgomery form `v` represents.
fn nistecFromMont(m: MontCtx, v: []u32): Nat {
  let out = []u32(len(m.n))
  bigintMontMulTo(m, out, v, m.one)
  return bigintMake(out)
}

// The workspace for curve `c`.
fn nistecWsNew(c: Curve): NistecWs {
  let m = bigintMontNew(c.p)
  let k = len(m.n)
  return NistecWs{
    m = m,
    a = nistecToMont(m, c.a),
    b3 = nistecToMont(m, c.b3),
    t0 = []u32(k),
    t1 = []u32(k),
    t2 = []u32(k),
    t3 = []u32(k),
    t4 = []u32(k),
    t5 = []u32(k),
    x3 = []u32(k),
    y3 = []u32(k),
    z3 = []u32(k),
  }
}

// The Montgomery form of a projective point with reduced coordinates.
fn nistecMontPt(m: MontCtx, P: Jac): MontPt {
  return MontPt{ x = nistecToMont(m, P.x), y = nistecToMont(m, P.y), z = nistecToMont(m, P.z) }
}

// The projective point a Montgomery-form point represents.
fn nistecJacOf(m: MontCtx, P: MontPt): Jac {
  return Jac{ x = nistecFromMont(m, P.x), y = nistecFromMont(m, P.y), z = nistecFromMont(m, P.z) }
}

// `out = P + Q` for any projective points (including identity, doubling, and
// `P + (-P)`), via RCB Algorithm 1 with `a = c.a` and `b3 = 3b`. The operation
// sequence is transcribed verbatim from the reference formula, so the
// intermediates carry no geometric meaning on their own. Every primitive may
// alias its output with an input, and the result is built in the workspace
// and copied last, so `out` may alias `P` or `Q`. Allocates nothing.
fn nistecMontAdd(w: NistecWs, out: MontPt, P: MontPt, Q: MontPt) {
  let m = w.m
  let n = m.n
  let t0 = w.t0
  let t1 = w.t1
  let t2 = w.t2
  let t3 = w.t3
  let t4 = w.t4
  let t5 = w.t5
  let X3 = w.x3
  let Y3 = w.y3
  let Z3 = w.z3

  bigintMontMulTo(m, t0, P.x, Q.x)
  bigintMontMulTo(m, t1, P.y, Q.y)
  bigintMontMulTo(m, t2, P.z, Q.z)
  bigintModAddTo(t3, P.x, P.y, n)
  bigintModAddTo(t4, Q.x, Q.y, n)
  bigintMontMulTo(m, t3, t3, t4)
  bigintModAddTo(t4, t0, t1, n)
  bigintModSubTo(t3, t3, t4, n)
  bigintModAddTo(t4, P.x, P.z, n)
  bigintModAddTo(t5, Q.x, Q.z, n)
  bigintMontMulTo(m, t4, t4, t5)
  bigintModAddTo(t5, t0, t2, n)
  bigintModSubTo(t4, t4, t5, n)
  bigintModAddTo(t5, P.y, P.z, n)
  bigintModAddTo(X3, Q.y, Q.z, n)
  bigintMontMulTo(m, t5, t5, X3)
  bigintModAddTo(X3, t1, t2, n)
  bigintModSubTo(t5, t5, X3, n)
  bigintMontMulTo(m, Z3, w.a, t4)
  bigintMontMulTo(m, X3, w.b3, t2)
  bigintModAddTo(Z3, X3, Z3, n)
  bigintModSubTo(X3, t1, Z3, n)
  bigintModAddTo(Z3, t1, Z3, n)
  bigintMontMulTo(m, Y3, X3, Z3)
  bigintModAddTo(t1, t0, t0, n)
  bigintModAddTo(t1, t1, t0, n)
  bigintMontMulTo(m, t2, w.a, t2)
  bigintMontMulTo(m, t4, w.b3, t4)
  bigintModAddTo(t1, t1, t2, n)
  bigintModSubTo(t2, t0, t2, n)
  bigintMontMulTo(m, t2, w.a, t2)
  bigintModAddTo(t4, t4, t2, n)
  bigintMontMulTo(m, t0, t1, t4)
  bigintModAddTo(Y3, Y3, t0, n)
  bigintMontMulTo(m, t0, t5, t4)
  bigintMontMulTo(m, X3, t3, X3)
  bigintModSubTo(X3, X3, t0, n)
  bigintMontMulTo(m, t0, t3, t1)
  bigintMontMulTo(m, Z3, t5, Z3)
  bigintModAddTo(Z3, Z3, t0, n)
  nistecCopyLimbs(out.x, X3)
  nistecCopyLimbs(out.y, Y3)
  nistecCopyLimbs(out.z, Z3)
}

// `P + Q` on the variable-width form, for the one-off addition that combines
// the two ECDSA verification products.
fn nistecAdd(c: Curve, p1: Jac, p2: Jac): Jac {
  let w = nistecWsNew(c)
  let P = nistecMontPt(w.m, p1)
  nistecMontAdd(w, P, P, nistecMontPt(w.m, p2))
  return nistecJacOf(w.m, P)
}

// The projective point at infinity, `(0:1:0)`.
fn nistecInfinity(): Jac {
  return Jac{ x = bigintZero(), y = bigintFromU64(1), z = bigintZero() }
}

// ---------------------------------------------------------------------------
// Constant-time (branchless) swap and the scalar-multiplication ladder
// ---------------------------------------------------------------------------

// `dst = src`, limb by limb, for equal widths.
fn nistecCopyLimbs(dst: []u32, src: []u32) {
  let i = 0
  while (i < len(dst)) {
    dst[i] = src[i]
    i = i + 1
  }
}

// Exchange the equal-width `a` and `b` in place when `mask` is all ones and
// leave them when it is zero. Every limb of both is rewritten through the mask,
// so neither a branch nor the memory access pattern depends on it.
fn nistecSwapLimbs(mask: u32, a: []u32, b: []u32) {
  let i = 0
  while (i < len(a)) {
    let t = mask & (a[i] ^ b[i])
    a[i] = a[i] ^ t
    b[i] = b[i] ^ t
    i = i + 1
  }
}

// Exchange the points `P` and `Q` in place when `v == 1`, with no branch on
// `v`. `v` must be exactly 0 or 1.
fn nistecSwapPt(v: u32, P: MontPt, Q: MontPt) {
  let mask = u32(0) - v
  nistecSwapLimbs(mask, P.x, Q.x)
  nistecSwapLimbs(mask, P.y, Q.y)
  nistecSwapLimbs(mask, P.z, Q.z)
}

// Bit `i` of `scalar` (0 or 1), reading past the top as 0.
fn nistecScalarBit(scalar: Nat, i: int): u32 {
  let w = i / 32
  if (w >= len(scalar.limbs)) {
    return 0
  }
  return (scalar.limbs[w] >> u32(i % 32)) & 1
}

// `scalar * base` by a Montgomery ladder over the complete addition formula.
// Invariant: `R1 = R0 + base` throughout. Each iteration swaps the accumulators
// so the active one is `R0`, computes `R0 + R1` and `2*R0`, and swaps back, so
// the sequence of field operations is fixed by `c.bits`, not by the scalar,
// and the bit only drives two masked swaps. A scalar of `c.bits` or more bits
// has its leading bits dropped, which never happens for a valid scalar
// (`< n < 2^bits`). The workspace and the three points are the only
// allocations; a step allocates nothing.
fn nistecLadder(c: Curve, base: Jac, scalar: Nat): Jac {
  let w = nistecWsNew(c)
  let R0 = nistecMontPt(w.m, nistecInfinity())
  let R1 = nistecMontPt(w.m, base)
  let S = nistecMontPt(w.m, nistecInfinity())
  let i = c.bits - 1
  while (i >= 0) {
    let bit = nistecScalarBit(scalar, i)
    nistecSwapPt(bit, R0, R1)
    nistecMontAdd(w, S, R0, R1)
    nistecMontAdd(w, R0, R0, R0)
    let t = R1
    R1 = S
    S = t
    nistecSwapPt(bit, R0, R1)
    i = i - 1
  }
  return nistecJacOf(w.m, R0)
}

// Convert a projective point to affine `(x, y) = (X/Z, Y/Z)`; a zero `Z` is the
// point at infinity.
fn nistecToAffine(c: Curve, P: Jac): Point {
  if (bigintIsZero(P.z)) {
    return Point{ x = bigintZero(), y = bigintZero(), infinity = true }
  }
  let zi = nistecFeInv(c, P.z)
  return Point{ x = nistecFeMul(c, P.x, zi), y = nistecFeMul(c, P.y, zi), infinity = false }
}

// ---------------------------------------------------------------------------
// Public point operations
// ---------------------------------------------------------------------------

// Whether `point` satisfies the curve equation `y^2 = x^3 + a*x + b (mod p)`,
// with both coordinates in `[0, p)`. The point at infinity is on the curve.
export fn nistecIsOnCurve(curve: Curve, point: Point): bool {
  if (point.infinity) {
    return true
  }
  if (bigintCmp(point.x, curve.p) >= 0 || bigintCmp(point.y, curve.p) >= 0) {
    return false
  }
  let lhs = nistecFeSqr(curve, point.y)
  let x2 = nistecFeSqr(curve, point.x)
  let x3 = nistecFeMul(curve, x2, point.x)
  let ax = nistecFeMul(curve, curve.a, point.x)
  let rhs = nistecFeAdd(curve, nistecFeAdd(curve, x3, ax), curve.b)
  return bigintCmp(lhs, rhs) == 0
}

// `scalar * G`, the base-point multiplication used to derive a public key from a
// private scalar. `G` is always valid, so this cannot fail.
export fn nistecScalarBaseMult(curve: Curve, scalar: Nat): Point {
  let G = Jac{ x = curve.gx, y = curve.gy, z = bigintFromU64(1) }
  return nistecToAffine(curve, nistecLadder(curve, G, scalar))
}

// `scalar * point`. Validates that `point` is on the curve first — an off-curve
// input is rejected rather than multiplied, closing the invalid-curve attack.
export fn nistecScalarMult(curve: Curve, point: Point, scalar: Nat): Point! {
  if (point.infinity) {
    return point
  }
  if (!nistecIsOnCurve(curve, point)) {
    fail newError("nistecScalarMult: point is not on the curve")
  }
  let P = Jac{ x = point.x, y = point.y, z = bigintFromU64(1) }
  return nistecToAffine(curve, nistecLadder(curve, P, scalar))
}

// The SEC 1 octet encoding of `point`: a single `0x00` for infinity, the
// `0x04 || X || Y` uncompressed form otherwise, or the `0x02|0x03 || X`
// compressed form when `compressed` is set (prefix parity carries `y`'s low
// bit). Fails if a coordinate does not fit the field width.
export fn nistecPointEncode(curve: Curve, point: Point, compressed: bool): []byte! {
  if (point.infinity) {
    let out = []byte(1)
    out[0] = 0
    return out
  }
  let xb = bigintToBytes(point.x, curve.size)?
  if (compressed) {
    let out = []byte(1 + curve.size)
    out[0] = byte(2) | nistecParity(point.y)
    let i = 0
    while (i < curve.size) {
      out[1 + i] = xb[i]
      i = i + 1
    }
    return out
  }
  let yb = bigintToBytes(point.y, curve.size)?
  let out = []byte(1 + 2 * curve.size)
  out[0] = 4
  let i = 0
  while (i < curve.size) {
    out[1 + i] = xb[i]
    out[1 + curve.size + i] = yb[i]
    i = i + 1
  }
  return out
}

// Decode the uncompressed `0x04 || X || Y` SEC 1 form, checking the recovered
// point lies on the curve. Split out of `nistecPointDecode` (#2448).
fn nistecDecodeUncompressed(curve: Curve, data: []byte): Point! {
  if (len(data) != 1 + 2 * curve.size) {
    fail newError("nistecPointDecode: wrong length for uncompressed point")
  }
  let pt = Point{
    x = bigintFromBytes(data[1:1 + curve.size]),
    y = bigintFromBytes(data[1 + curve.size:len(data)]),
    infinity = false,
  }
  if (!nistecIsOnCurve(curve, pt)) {
    fail newError("nistecPointDecode: point is not on the curve")
  }
  return pt
}

// Decode the compressed `0x02|0x03 || X` SEC 1 form: recover y = sqrt(x^3 +
// a*x + b) and fix its parity to match `prefix`'s low bit. Split out of
// `nistecPointDecode` (#2448).
fn nistecDecodeCompressed(curve: Curve, data: []byte, prefix: byte): Point! {
  if (len(data) != 1 + curve.size) {
    fail newError("nistecPointDecode: wrong length for compressed point")
  }
  let x = bigintFromBytes(data[1:len(data)])
  if (bigintCmp(x, curve.p) >= 0) {
    fail newError("nistecPointDecode: x coordinate out of range")
  }
  // rhs = x^3 + a*x + b; recover y = sqrt(rhs) and fix its parity.
  let x2 = nistecFeSqr(curve, x)
  let x3 = nistecFeMul(curve, x2, x)
  let ax = nistecFeMul(curve, curve.a, x)
  let rhs = nistecFeAdd(curve, nistecFeAdd(curve, x3, ax), curve.b)
  let y = nistecSqrt(curve, rhs)
  if (bigintCmp(nistecFeSqr(curve, y), rhs) != 0) {
    fail newError("nistecPointDecode: x has no matching y (point off curve)")
  }
  if (nistecParity(y) != (prefix & 1)) {
    y = nistecFeSub(curve, curve.p, y)
  }
  return Point{ x = x, y = y, infinity = false }
}

// Decode a SEC 1 octet string into a validated affine point. Accepts the
// infinity byte `0x00`, the uncompressed `0x04 || X || Y`, and the compressed
// `0x02|0x03 || X` forms; the recovered point is always checked to lie on the
// curve (for compressed input, that `X` yields a real `Y`). Fails on a bad
// length, an out-of-range coordinate, an unknown prefix, or an off-curve point.
export fn nistecPointDecode(curve: Curve, data: []byte): Point! {
  if (len(data) == 0) {
    fail newError("nistecPointDecode: empty input")
  }
  let prefix = data[0]
  if (len(data) == 1 && prefix == 0) {
    return Point{ x = bigintZero(), y = bigintZero(), infinity = true }
  }
  if (prefix == 4) {
    return nistecDecodeUncompressed(curve, data)?
  }
  if (prefix == 2 || prefix == 3) {
    return nistecDecodeCompressed(curve, data, prefix)?
  }
  fail newError("nistecPointDecode: unknown SEC 1 prefix ${int(prefix)}")
}
