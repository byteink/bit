// Bit standard library — crypto module, the AEAD (authenticated encryption) contract.
//
// `Aead` is a Go-style structural interface (§14.3): any concrete authenticated
// cipher — AES-GCM, ChaCha20-Poly1305 — satisfies it simply by having these four
// methods, no `implements` clause. AEAD binds confidentiality and integrity in a
// single operation: `seal` encrypts `plaintext` and authenticates both it and the
// unencrypted `aad` (additional authenticated data), returning ciphertext with the
// authentication tag appended; `open` recomputes the tag in constant time and FAILS
// (fallible `[]byte!`) on any mismatch, so it never hands back unauthenticated
// plaintext.
//
// The `nonce` MUST be unique per key for every `seal` — reuse is catastrophic (it
// leaks the keystream, and for GCM the authentication key itself). `nonceSize` is
// the required nonce length in bytes; `overhead` is the number of bytes `seal`
// adds — the tag length — so `len(seal(...)) == len(plaintext) + overhead`.
//
// Methods are comma-separated (the formatter's canonical interface form): a bare
// fallible result `[]byte!` needs a following separator token so the parser does
// not read the next method's name as `open`'s error type — `!` alone does not
// trigger automatic-semicolon insertion the way a closing `)`/`]`/`>` does.

export interface Aead {
  seal(nonce: []byte, plaintext: []byte, aad: []byte): []byte,
  open(nonce: []byte, ciphertext: []byte, aad: []byte): []byte!,
  nonceSize(): int,
  overhead(): int,
}
