// Bit standard library — crypto module, AES modes of operation (NIST SP 800-38A).
//
// The AES block cipher (aes.bit) is a single 128-bit permutation; a *mode* turns
// it into a cipher over arbitrary-length messages. These three sit on top of an
// already-keyed `AesCipher`, so they reuse its expanded key schedule and add no
// key handling of their own.
//
// CTR (counter mode) is the workhorse — and the keystream generator GCM is built
// on. It enciphers a big-endian 128-bit counter, starting from the 16-byte `iv`,
// and XORs the resulting keystream into the data. Because XOR is its own inverse,
// encryption and decryption are the *same* operation; `ctr` serves both. It needs
// no padding and handles a trailing partial block.
//
// ECB (single block) is exposed only as the raw block permutation `ecbEncryptBlock`
// for QUIC header protection, which enciphers one sampled block to derive a mask.
// ECB leaks equality of plaintext blocks, so it is never a mode for real messages
// — do not reach for it as a general cipher.
//
// CBC (cipher block chaining) XORs each plaintext block with the previous
// ciphertext block (the `iv` seeds the first) before enciphering. It requires the
// data to be an exact multiple of the 16-byte block size — it does no padding —
// and is provided for interop with existing CBC protocols, not as a default.
//
// None of these authenticate: a mode gives confidentiality only. Use an AEAD
// (AES-GCM, ChaCha20-Poly1305) whenever the ciphertext could be tampered with.

// Increment the 16-byte big-endian counter `counter` by one, in place, wrapping
// mod 2^128. Walk from the least-significant byte up, stopping at the first byte
// that does not carry (i.e. did not wrap from 0xff to 0x00).
fn aesmodeIncr(counter: []byte) {
  let i = 15
  while (i >= 0) {
    let v: u8 = counter[i] + 1
    counter[i] = v
    if (v != 0) {
      return
    }
    i = i - 1
  }
}

// Encrypt or decrypt `data` in AES counter (CTR) mode under the keyed `cipher`.
// The 16-byte `iv` is the initial value of a big-endian 128-bit counter block;
// each successive block enciphers the incremented counter and XORs that keystream
// into the data. XORing the keystream is its own inverse, so the same call both
// encrypts and decrypts, and `data` may be any length (the final block is partial
// if it is not a multiple of 16). This is the keystream engine AES-GCM builds on.
export fn ctr(cipher: AesCipher, iv: []byte, data: []byte): []byte {
  assert(len(iv) == 16, "ctr: iv must be 16 bytes")
  let out = []byte(len(data))

  let counter = []byte(16)
  let i = 0
  while (i < 16) {
    counter[i] = iv[i]
    i = i + 1
  }

  let off = 0
  while (off < len(data)) {
    let ks = cipher.encryptBlock(counter)
    let n = len(data) - off
    if (n > 16) {
      n = 16
    }
    let j = 0
    while (j < n) {
      out[off + j] = data[off + j] ^ ks[j]
      j = j + 1
    }
    aesmodeIncr(counter)
    off = off + 16
  }
  return out
}

// Encipher one 16-byte `block` as a bare ECB block — i.e. the raw AES block
// permutation, with no chaining or IV. This is exposed ONLY for QUIC header
// protection, which enciphers a sampled ciphertext block to derive the header
// mask. It is UNSAFE as a general mode: ECB reveals when two plaintext blocks are
// equal. Never encrypt more than one block of real data through it — reach for
// `ctr`, `cbcEncrypt`, or an AEAD instead.
export fn ecbEncryptBlock(cipher: AesCipher, block: []byte): []byte {
  return cipher.encryptBlock(block)
}

// Encrypt `data` in AES cipher-block-chaining (CBC) mode under `cipher`, with the
// explicit 16-byte `iv`. Each plaintext block is XORed with the previous
// ciphertext block (the `iv` seeds the first) before being enciphered. `data`
// must already be an exact multiple of 16 bytes — CBC does no padding, so a
// non-block-multiple length is a caller error and panics. Provided for interop
// with existing CBC protocols; prefer `ctr` or an AEAD for new designs.
export fn cbcEncrypt(cipher: AesCipher, iv: []byte, data: []byte): []byte {
  assert(len(iv) == 16, "cbcEncrypt: iv must be 16 bytes")
  assert(len(data) % 16 == 0, "cbcEncrypt: data length must be a multiple of 16")
  let out = []byte(len(data))

  let prev = iv
  let off = 0
  while (off < len(data)) {
    let blk = []byte(16)
    let j = 0
    while (j < 16) {
      blk[j] = data[off + j] ^ prev[j]
      j = j + 1
    }
    let enc = cipher.encryptBlock(blk)
    j = 0
    while (j < 16) {
      out[off + j] = enc[j]
      j = j + 1
    }
    prev = enc
    off = off + 16
  }
  return out
}

// Decrypt `data` in AES cipher-block-chaining (CBC) mode under `cipher`, with the
// explicit 16-byte `iv` — the inverse of `cbcEncrypt`. Each block is deciphered
// then XORed with the previous ciphertext block (the `iv` for the first). Fails
// (fallible `[]byte!`) if `data` is not a multiple of 16 bytes, since a truncated
// ciphertext cannot be a valid CBC stream. Interop only; prefer an AEAD.
export fn cbcDecrypt(cipher: AesCipher, iv: []byte, data: []byte): []byte! {
  assert(len(iv) == 16, "cbcDecrypt: iv must be 16 bytes")
  if (len(data) % 16 != 0) {
    fail newError("cbcDecrypt: data length ${len(data)} is not a multiple of 16")
  }
  let out = []byte(len(data))

  let prev = iv
  let off = 0
  while (off < len(data)) {
    let blk = []byte(16)
    let j = 0
    while (j < 16) {
      blk[j] = data[off + j]
      j = j + 1
    }
    let dec = cipher.decryptBlock(blk)
    j = 0
    while (j < 16) {
      out[off + j] = dec[j] ^ prev[j]
      j = j + 1
    }
    prev = blk
    off = off + 16
  }
  return out
}
