// Bit standard library — crypto module, Ed25519 signatures (RFC 8032, PureEdDSA).
//
// EdDSA over the twisted Edwards curve edwards25519 (-x^2 + y^2 = 1 + d*x^2*y^2,
// d = -121665/121666), built on the GF(2^255-19) field arithmetic in
// `field25519.bit` and SHA-512 in `sha512.bit`. Group elements live in extended
// homogeneous coordinates (X:Y:Z:T) with x = X/Z, y = Y/Z, x*y = T/Z; the point
// formulas are the complete "hwcd" addition and doubling, so scalar
// multiplication needs no special-casing of the identity or a point with itself.
//
// The group arithmetic (`ed25519point.bit`) and the scalars mod L
// (`ed25519scalar.bit`) run on one preallocated `ed25519Ctx` per call, so a
// signature or a verification allocates only that scratch, the SHA-512 state
// and its results (#7167). Both are constant-time in the secret scalar: no
// branch, memory index or allocation size depends on it.
//
// Being part of the flat `std/crypto` module, this file names `fe25519*`,
// `ed25519Ctx`, `Sha512()`, and `newError` from its sibling files with no
// import. Every private helper is prefixed `ed25519` to keep the namespace clean.
//
// Public surface: `ed25519PublicKey`, `ed25519Sign`, `ed25519Verify`,
// `ed25519ParsePrivateKey` (the PKCS#8 form of RFC 8410). Keys and
// signatures are the RFC 8032 byte strings (32-byte seed, 32-byte public key,
// 64-byte signature), so they interoperate directly with other implementations
// and feed the X.509 (#1197) and TLS layers above.

// ---------------------------------------------------------------------------
// Field constants (radix 2^51, five little-endian limbs). Generated offline and
// pinned; each is the unique representative in [0, p). Returned from functions,
// not top-level `const`s, for the same reason the field masks are (#1231).
// ---------------------------------------------------------------------------

// The curve constant d = -121665/121666 mod p.
fn ed25519D(): []u64 {
  return []u64{
    0x34dca135978a3,
    0x1a8283b156ebd,
    0x5e7a26001c029,
    0x739c663a03cbb,
    0x52036cee2b6ff,
  }
}

// 2*d mod p, the multiplier the extended-coordinate addition folds into T.
fn ed25519D2(): []u64 {
  return []u64{
    0x69b9426b2f159,
    0x35050762add7a,
    0x3cf44c0038052,
    0x6738cc7407977,
    0x2406d9dc56dff,
  }
}

// sqrt(-1) = 2^((p-1)/4) mod p, used to pick the other square root in x-recovery.
fn ed25519SqrtM1(): []u64 {
  return []u64{
    0x61b274a0ea0b0,
    0x0d5a5fc8f189d,
    0x7ef5e9cbd0c60,
    0x78595a6804c9e,
    0x2b8324804fc1d,
  }
}

// The base point B = (Bx, By): the standard generator of the prime-order subgroup.
fn ed25519BaseX(): []u64 {
  return []u64{
    0x62d608f25d51a,
    0x412a4b4f6592a,
    0x75b7171a4b31d,
    0x1ff60527118fe,
    0x216936d3cd6e5,
  }
}
fn ed25519BaseY(): []u64 {
  return []u64{
    0x6666666666658,
    0x4cccccccccccc,
    0x1999999999999,
    0x3333333333333,
    0x6666666666666,
  }
}

// ---------------------------------------------------------------------------
// Byte helpers
// ---------------------------------------------------------------------------

// Whether two byte slices are equal in length and content.
fn ed25519BytesEqual(a: []byte, b: []byte): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// The clamped secret scalar from the first 32 bytes of the expanded key: clear
// the low 3 bits and bit 255, set bit 254 (RFC 8032 §5.1.5).
fn ed25519Clamp(h: []byte): []byte {
  let a = []byte(32)
  let i = 0
  while (i < 32) {
    a[i] = h[i]
    i = i + 1
  }
  a[0] = a[0] & 248
  a[31] = a[31] & 127
  a[31] = a[31] | 64
  return a
}

// Assemble the 64-byte signature from its halves, R || S. Kept a separate
// function on purpose: its loop makes it multi-block and thus not inline-
// eligible, so this byte-copy loop never lands *inside* `ed25519Sign`. That
// avoided an inliner bug in the pre-#1593 seed compiler (deleted along with
// the rest of that toolchain) that emitted a malformed jump —
// `error.BlockArgMismatch` under the debug IR verifier — when one function
// carried both many spliced single-block callees and a loop with
// loop-carried values. `ed25519Sign` triggered exactly that shape inline.
// The split is kept because it costs nothing, though the self-hosted
// compiler that replaced the seed has not been shown to share the bug.
fn ed25519JoinSig(encR: []byte, s: []byte): []byte {
  let sig = []byte(64)
  let i = 0
  while (i < 32) {
    sig[i] = encR[i]
    sig[32 + i] = s[i]
    i = i + 1
  }
  return sig
}

// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------

// The 32-byte Ed25519 public key A for a 32-byte private seed `priv`: A = [a]B,
// where a is the clamped low half of SHA-512(priv).
export fn ed25519PublicKey(priv: []byte): []byte {
  let c = ed25519NewCtx()
  let hs = Sha512()
  hs.write(priv)
  let a = ed25519Clamp(hs.sum())
  ed25519BaseTable(c)
  ed25519WindowMul(c, c.r, c.tb, a)
  return ed25519Encode(c, c.r)
}

// Sign `msg` with the 32-byte private seed `priv`, returning the 64-byte
// signature R || S (RFC 8032 §5.1.6). The nonce r = H(prefix || msg) is
// deterministic, so signing is reproducible and needs no RNG. One hasher and
// one base-point table serve the whole signature.
export fn ed25519Sign(priv: []byte, msg: []byte): []byte {
  let c = ed25519NewCtx()
  let hs = Sha512()
  hs.write(priv)
  let h = hs.sum()
  let a = ed25519Clamp(h)
  ed25519BaseTable(c)
  ed25519WindowMul(c, c.r, c.tb, a)
  let encA = ed25519Encode(c, c.r)

  // r = H(prefix || msg) mod L, then R = [r]B.
  hs.reset()
  hs.write(h[32:64])
  hs.write(msg)
  let r = ed25519ScReduce64(c, hs.sum())
  ed25519WindowMul(c, c.r, c.tb, r)
  let encR = ed25519Encode(c, c.r)

  // k = H(R || A || msg) mod L, then S = (r + k*a) mod L.
  hs.reset()
  hs.write(encR)
  hs.write(encA)
  hs.write(msg)
  let k = ed25519ScReduce64(c, hs.sum())
  return ed25519JoinSig(encR, ed25519ScMulAdd(c, r, k, a))
}

// Verify a 64-byte signature `sig` on `msg` under the 32-byte public key `pub`.
// Rejects a wrong length, a public key that is not a canonical curve point, or
// a non-canonical S (S >= L), then checks the group equation [S]B == R + [k]A,
// k = H(R || A || msg), as encode([S]B + [k](-A)) == R. Encoding is injective
// and only ever canonical, so an R that is non-canonical or off the curve can
// never match: the comparison subsumes decoding R.
export fn ed25519Verify(pub: []byte, msg: []byte, sig: []byte): bool {
  if (len(pub) != 32 || len(sig) != 64) {
    return false
  }
  let c = ed25519NewCtx()
  let encR = sig[0:32]
  let s = sig[32:64]
  if (!ed25519ScLtL(c, s)) {
    return false
  }
  if (ed25519DecodeTo(c, c.r, pub) != 0) {
    return false
  }
  fe25519SubTo(c.r.X, c.zero, c.r.X)
  fe25519SubTo(c.r.T, c.zero, c.r.T)
  let ta = []u64(ed25519TableWords())
  ed25519TableBuild(c, ta, c.r)

  let hs = Sha512()
  hs.write(encR)
  hs.write(pub)
  hs.write(msg)
  let k = ed25519ScReduce64(c, hs.sum())

  ed25519BaseTable(c)
  ed25519WindowMul2(c, c.r, s, ta, k)
  return ed25519BytesEqual(ed25519Encode(c, c.r), encR)
}

// Decode a 32-byte encoding to a point, recovering x from y. Fails on a wrong
// length, a non-canonical encoding (y >= p, or x = 0 with the sign bit set), or
// a y with no matching x (not on the curve). `enc` is not mutated.
fn ed25519Decode(enc: []byte): ed25519Point! {
  let p = ed25519NewPoint()
  let code = ed25519DecodeTo(ed25519NewCtx(), p, enc)
  if (code == 1) {
    fail newError("ed25519: point must be 32 bytes")
  }
  if (code == 2) {
    fail newError("ed25519: non-canonical point")
  }
  if (code == 3) {
    fail newError("ed25519: point not on curve")
  }
  return p
}

// ---------------------------------------------------------------------------
// PKCS#8 private keys (RFC 8410 §7, RFC 5958 OneAsymmetricKey)
// ---------------------------------------------------------------------------

// The arcs of id-Ed25519, 1.3.101.112 (RFC 8410 §3).
fn ed25519IsOid(arcs: []int): bool {
  return asn1OidString(arcs) == x509OidEd25519
}

// The AlgorithmIdentifier must be id-Ed25519 with the parameters ABSENT
// (RFC 8410 §3); a NULL or any other parameter is refused.
fn ed25519CheckAlgorithm(e: Element): ()! {
  let alg = asn1ReadSequence(e)?
  if (len(alg) < 1 || !ed25519IsOid(asn1ReadOid(alg[0])?)) {
    fail newError("ed25519: not an Ed25519 private key")
  }
  if (len(alg) != 1) {
    fail newError("ed25519: AlgorithmIdentifier parameters must be absent")
  }
}

// The `privateKey` field is an OCTET STRING holding a CurvePrivateKey, itself an
// OCTET STRING of exactly 32 bytes (RFC 8410 §7). The inner parse rejects
// trailing bytes. Errors name the shape, never the bytes.
fn ed25519ReadCurvePrivateKey(e: Element): []byte! {
  let inner = asn1Parse(asn1ReadOctetString(e)?)?
  let seed = asn1ReadOctetString(inner)?
  if (len(seed) != 32) {
    fail newError("ed25519: the private key must be 32 bytes")
  }
  return seed
}

// The v2 `publicKey` field: `[1] IMPLICIT BIT STRING`, 0 unused bits, 32 bytes.
fn ed25519ReadEmbeddedPublicKey(e: Element): []byte! {
  let ok = e.cls == classContext && !e.constructed && e.tag == 1
  if (!ok || len(e.bytes) != 33 || e.bytes[0] != 0) {
    fail newError("ed25519: malformed embedded public key")
  }
  return e.bytes[1:33]
}

// The fields after `privateKey`. A version 0 key has none. A version 1 key
// (RFC 5958 v2) may carry `[0] attributes` (parsed as DER, otherwise ignored)
// and `[1] publicKey`, in that order; a present public key must be the one
// derived from `seed`.
fn ed25519CheckTrailer(rest: []Element, version: int, seed: []byte): ()! {
  if (len(rest) == 0) {
    return
  }
  if (version == 0) {
    fail newError("ed25519: a version 0 key must not carry attributes or a public key")
  }
  let i = 0
  if (rest[0].cls == classContext && rest[0].constructed && rest[0].tag == 0) {
    i = 1
  }
  if (i == len(rest)) {
    return
  }
  if (len(rest) - i != 1) {
    fail newError("ed25519: unexpected fields after the private key")
  }
  let pub = ed25519ReadEmbeddedPublicKey(rest[i])?
  if (!ctEq(pub, ed25519PublicKey(seed))) {
    fail newError("ed25519: the embedded public key does not match")
  }
}

// The 32-byte seed from a PKCS#8 `PrivateKeyInfo` / `OneAsymmetricKey` DER, the
// body of the `PRIVATE KEY` PEM that `openssl genpkey -algorithm ed25519`
// writes (feed `pemDecode(...)[0].der`). Strict DER: trailing data, a wrong
// OID, algorithm parameters, a wrong length and a version above 1 all fail. A
// version 1 key with an embedded public key is accepted only if that public
// key matches the seed. Pass the result to `ed25519Sign` and `ed25519PublicKey`.
export fn ed25519ParsePrivateKey(der: []byte): []byte! {
  let seq = asn1ReadSequence(asn1Parse(der)?)?
  if (len(seq) < 3) {
    fail newError("ed25519: PrivateKeyInfo must have at least three fields")
  }
  let version = asn1ReadInteger(seq[0])?
  if (version < 0 || version > 1) {
    fail newError("ed25519: unsupported PrivateKeyInfo version")
  }
  ed25519CheckAlgorithm(seq[1])?
  let seed = ed25519ReadCurvePrivateKey(seq[2])?
  ed25519CheckTrailer(seq[3:len(seq)], version, seed)?
  return seed
}
