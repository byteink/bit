// Bit standard library — crypto module, ECDH over NIST P-256 and P-384.
//
// Elliptic-Curve Diffie-Hellman on the two prime-field NIST curves, layered
// directly on the `nistec.bit` point arithmetic. Key agreement is the SEC 1 /
// RFC 7748-style primitive TLS 1.3 (#1203) consumes as its (EC)DHE input: each
// side owns a private scalar `d`, publishes the SEC 1 point `d*G`, and both
// derive the same shared point `d_A * d_B * G`; its x-coordinate, fixed-width
// big-endian, is the raw ECDH secret handed straight to HKDF as input keying
// material (no hashing, no cofactor step — both curves have cofactor 1).
//
// Security posture, in the order it matters here:
//
//   * Invalid-curve defense. `ecdhnistSharedSecret` never multiplies an
//     unvalidated peer point. `nistecPointDecode` rejects any off-curve or
//     malformed SEC 1 encoding, the decoded point is checked not to be the
//     identity, and `nistecScalarMult` re-validates it lies on the curve before
//     the ladder runs. Skipping this is the classic invalid-curve attack that
//     leaks the private scalar one small-subgroup residue at a time.
//
//   * Scalar generation. The private scalar is drawn with the FIPS 186-4 B.4.1
//     "extra random bits" method: `size + 8` bytes from the OS CSPRNG are read
//     as an integer and reduced modulo `n-1`, then incremented, landing in
//     `[1, n-1]` with a modular bias below 2^-64. Never zero, never `>= n`.
//
//   * Constant-time scope. The ladder inside `nistec` is branch/index safe by
//     construction; the underlying variable-width field arithmetic is not yet
//     timing-flat (see `nistec.bit`). Do not rely on this against a limb-timing
//     adversary until the fixed-width Montgomery field lands.
//
// Being part of the flat `std/crypto` module, this file reaches the `nistec*`,
// `bigint*`, and `randomBytes` APIs and names `newError` from the prelude
// without importing them. Every private free function is prefixed `ecdhnist` to
// keep the module's flat namespace clean.

// An ephemeral or long-term ECDH key pair. `priv` is the private scalar as
// exactly `curve.size` big-endian bytes; `pub` is the peer-shareable public key,
// the SEC 1 *uncompressed* point `0x04 || X || Y` of `priv * G`. Bit tuples are
// not yet lowerable, so the two outputs travel as a struct — which, unlike a
// tuple, also gets to name its halves.
export struct EcdhKeypair { export priv: []byte, export pub: []byte }

// `n - 1` for a group order `n >= 2`. Setup arithmetic only; the `catch` is
// unreachable because every curve order is far larger than one.
fn ecdhnistSubOne(n: Nat): Nat {
  return bigintSub(n, bigintFromU64(1)) catch e {
    return bigintZero()
  }
}

// Fold `raw` (a big-endian byte string with at least 64 bits more than the group
// order) into a private scalar uniformly in `[1, n-1]`: reduce modulo `n-1` to
// land in `[0, n-2]`, then add one. `bigintModNZ` needs no fallible wrapper here
// because `n-1` is a fixed non-zero value.
fn ecdhnistScalarInRange(curve: Curve, raw: []byte): Nat {
  let k = bigintFromBytes(raw)
  let nm1 = ecdhnistSubOne(curve.n)
  let r = bigintModNZ(k, nm1)
  return bigintAdd(r, bigintFromU64(1))
}

// Generate a fresh ECDH key pair on `curve`. The private scalar comes from the
// OS CSPRNG reduced into `[1, n-1]` (FIPS 186-4 B.4.1 extra-bits), and the public
// key is the SEC 1 uncompressed encoding of `priv * G`. Both the scalar-to-bytes
// and the point encoding are infallible for an in-range scalar and a real curve
// point (the value always fits `curve.size` bytes), so the `catch` arms are
// unreachable and degrade rather than surface a phantom error.
export fn ecdhnistGenerateKeypair(curve: Curve): EcdhKeypair {
  let raw = randomBytes(curve.size + 8)
  let d = ecdhnistScalarInRange(curve, raw)
  let privBytes = bigintToBytes(d, curve.size) catch e {
    return EcdhKeypair{ priv: []byte(0), pub: []byte(0) }
  }
  let pubPoint = nistecScalarBaseMult(curve, d)
  let pubBytes = nistecPointEncode(curve, pubPoint, false) catch e {
    return EcdhKeypair{ priv: privBytes, pub: []byte(0) }
  }
  return EcdhKeypair{ priv: privBytes, pub: pubBytes }
}

// The raw ECDH shared secret between our private scalar `priv` (fixed-width
// big-endian bytes) and the peer's SEC 1 public point `peerPub`, as the
// fixed-width big-endian x-coordinate of `priv * peerPoint`.
//
// The peer point is fully validated before use: decoding rejects any off-curve
// or malformed encoding, the identity point is rejected explicitly, and the
// scalar multiply re-checks the on-curve invariant — closing the invalid-curve
// attack. A shared point at infinity (only possible for a degenerate input that
// survived the checks) is also rejected rather than returned as an all-zero
// secret. TLS feeds the returned bytes to HKDF directly as input keying material.
export fn ecdhnistSharedSecret(priv: []byte, peerPub: []byte, curve: Curve): []byte! {
  let peer = nistecPointDecode(curve, peerPub)?
  if (peer.infinity) {
    fail newError("ecdhnistSharedSecret: peer point is the identity")
  }
  let d = bigintFromBytes(priv)
  let shared = nistecScalarMult(curve, peer, d)?
  if (shared.infinity) {
    fail newError("ecdhnistSharedSecret: shared point is the identity")
  }
  return bigintToBytes(shared.x, curve.size)?
}
