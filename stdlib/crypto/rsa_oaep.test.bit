// Eight selected RSAES-OAEP vectors from C2SP/wycheproof (Apache-2.0).
// Commit: e0df04e0c033f2d25c5051dd06230336c7822358.
// Source: https://github.com/C2SP/wycheproof/blob/e0df04e0c033f2d25c5051dd06230336c7822358/testvectors_v1/rsa_oaep_2048_sha256_mgf1sha1_test.json
// File SHA256: d3f25242297957b3663ab5c9a7ff3fe7e34f8171ed1ff275842a0cfaccb5104d.
// LICENSE SHA256: 58d1e17ffe5109a7ae296caafcadfdbe6a7d176f0bc4ab01e12a689b0499d8bd.
// Published SHA-256 label hash, MGF1 SHA-1; this is a bounded sample, not the full corpus.

fn oaepTestHex(s: string): []byte {
  return decodeHex(s) catch e {
    panic(e.message())
  }
}

fn oaepTestKey(): RsaPrivateKey {
  return rsaParsePrivateKey(oaepTestHex("")) catch e {
    panic(e.message())
  }
}

fn oaepTestError(
  key: RsaPrivateKey,
  ciphertext: []byte,
  label: []byte,
  mgf: Option<HashAlg>,
): string {
  rsaDecryptOaep(key, HashAlg.Sha256, ciphertext, label, mgf) catch e {
    return e.message()
  }
  return ""
}

fn oaepTestValid(msg: string, ct: string, label: string) {
  let key = oaepTestKey()
  let ciphertext = oaepTestHex(ct)
  let context = oaepTestHex(label)
  let plain = rsaDecryptOaep(key, HashAlg.Sha256, ciphertext, context, Option.Some(HashAlg.Sha1)) catch e {
    panic(e.message())
  }
  assert(ctEq(plain, oaepTestHex(msg)), "published plaintext")
  let expected = "rsa: decryption error"
  assert(
    oaepTestError(key, ciphertext, context, Option.None) == expected,
    "omitted MGF uses SHA256",
  )
  assert(
    oaepTestError(key, ciphertext, context, Option.Some(HashAlg.Sha256)) == expected,
    "explicit SHA256 MGF rejects",
  )
  assert(
    oaepTestError(key, ciphertext, []byte{ 0xff }, Option.Some(HashAlg.Sha1)) == expected,
    "wrong label is uniform",
  )
}

fn oaepTestInvalid(ct: string) {
  assert(
      oaepTestError(oaepTestKey(), oaepTestHex(ct), []byte(0), Option.Some(HashAlg.Sha1)) ==
      "rsa: decryption error",
    "malformed ciphertext is uniform",
  )
}

// tcId 1: valid.
test "OAEP independent MGF1: tcId 1 valid" {
  oaepTestValid(
    "",
    "",
    "",
  )
}

// tcId 8: valid.
test "OAEP independent MGF1: tcId 8 valid" {
  oaepTestValid(
    "313233343030",
    "",
    "0000000000000000",
  )
}

// tcId 11: valid — Longest valid message size.
test "OAEP independent MGF1: tcId 11 valid" {
  oaepTestValid(
    "",
    "",
    "",
  )
}

// tcId 12: invalid — first byte of l_hash modified.
test "OAEP independent MGF1: tcId 12 invalid" {
  oaepTestInvalid("")
}

// tcId 18: invalid — ps terminated by 0xff.
test "OAEP independent MGF1: tcId 18 invalid" {
  oaepTestInvalid("")
}

// tcId 23: invalid — First byte is 1.
test "OAEP independent MGF1: tcId 23 invalid" {
  oaepTestInvalid("")
}

// tcId 28: invalid — ciphertext is empty.
test "OAEP independent MGF1: tcId 28 invalid" {
  oaepTestInvalid("")
}

// tcId 31: invalid — truncated ciphertext.
test "OAEP independent MGF1: tcId 31 invalid" {
  oaepTestInvalid("")
}

fn oaepTestRoundtrip(alg: HashAlg, mgf: HashAlg) {
  let key = oaepTestKey()
  let pub = RsaPublicKey{ n = key.n, e = key.e }
  let msg = []byte{ 0, 1, 2, 255 }
  let label = []byte{ 3, 4 }
  let ct = rsaEncryptOaep(pub, alg, msg, label, Option.Some(mgf)) catch e {
    panic(e.message())
  }
  let plain = rsaDecryptOaep(key, alg, ct, label, Option.Some(mgf)) catch e {
    panic(e.message())
  }
  assert(ctEq(plain, msg), "independent hash pair roundtrip")
}

test "OAEP hash pair roundtrip: Sha1/Sha1" {
  oaepTestRoundtrip(HashAlg.Sha1, HashAlg.Sha1)
}

test "OAEP hash pair roundtrip: Sha1/Sha256" {
  oaepTestRoundtrip(HashAlg.Sha1, HashAlg.Sha256)
}

test "OAEP hash pair roundtrip: Sha256/Sha1" {
  oaepTestRoundtrip(HashAlg.Sha256, HashAlg.Sha1)
}

test "OAEP hash pair roundtrip: Sha256/Sha256" {
  oaepTestRoundtrip(HashAlg.Sha256, HashAlg.Sha256)
}

