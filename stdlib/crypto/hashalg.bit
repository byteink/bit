// Bit standard library — crypto module, the hash algorithm selector.
//
// `HashAlg` names a hash the way Node's `createHmac("sha256", ...)`, .NET's
// `HashAlgorithmName` and Java's `"HmacSHA256"` do: as a typed value. HMAC, HKDF,
// PBKDF2 and the signature functions take one (`hmac(HashAlg.Sha256, key, msg)`)
// instead of a hasher factory, and a protocol that negotiates its hash at run
// time (TLS, QUIC) stores the value it negotiated and passes it along.
//
// `make` builds a fresh, empty hasher of the named algorithm; the SHA-2 variants
// are the `Sha256`/`Sha512` constructors with their `Bits` option, so each name
// here is exactly one concrete class and one option.
export enum HashAlg {
  Md5
  Sha1
  Sha224
  Sha256
  Sha384
  Sha512
  Sha512_256
  Blake3

  // A new empty hasher for this algorithm.
  export make(): Hash {
    match (this) {
      Md5 => return Md5()
      Sha1 => return Sha1()
      Sha224 => return Sha256(Sha256Bits.B224)
      Sha256 => return Sha256()
      Sha384 => return Sha512(Sha512Bits.B384)
      Sha512 => return Sha512()
      Sha512_256 => return Sha512(Sha512Bits.B256)
      Blake3 => return hashAlgBlake3()
    }
  }
}

// The unkeyed BLAKE3 hasher. `Blake3(mode)` is fallible only for a `Keyed` key of
// the wrong length, so the default mode cannot fail.
fn hashAlgBlake3(): Hash {
  return Blake3() catch _ {
    panic("HashAlg.Blake3: the unkeyed constructor cannot fail")
  }
}
