// Bit standard library — crypto module, MD5 (RFC 1321).
//
// BROKEN — INTEROP ONLY. MD5 is cryptographically dead: practical collisions are
// trivial (a single desktop finds one in seconds) and chosen-prefix collisions
// have forged real CA certificates. **Never** use it for integrity, signatures,
// MACs, password hashing, or any security decision. It lives here solely to read
// or reproduce data in legacy formats that still mandate it — old checksums,
// ETags, and pre-existing protocol fields. For anything new, use SHA-256.
//
// A textbook implementation: u32 words, 64 rounds, a 64-byte (512-bit) block, and
// a 64-bit *little-endian* length pad (MD5 is little-endian throughout, unlike
// the big-endian SHA family). `newMd5()` conforms to the streaming `Hash`
// interface (§14.3) — digest size 16 bytes, block size 64 — so it plugs into
// `digest`, HMAC, and anything else that hashes against `Hash`.
//
// The constant tables are returned by functions, not declared as module-level
// `const`: a top-level `const` initializer must be a compile-time-constant scalar
// (§15.4), which a slice literal is not. Each hasher builds its tables once at
// construction and keeps them, so there is no per-block allocation.

// The four RFC 1321 initial chaining words (A, B, C, D), little-endian order.
function md5IV(): []u32 {
  return []u32{ 0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476 }
}

// The 64 round constants: floor(2^32 * abs(sin(i + 1))) for i in 0..63
// (RFC 1321 §3.4).
function md5K(): []u32 {
  return []u32{
    0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
    0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
    0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
    0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
    0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
    0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
    0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
    0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391,
  }
}

// The 64 per-round left-rotation amounts (RFC 1321 §3.4), four distinct patterns
// repeated four times each across the four rounds.
function md5S(): []u32 {
  return []u32{
    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
    5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
    6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21,
  }
}

// `x` rotated left by `n` bits, within 32 bits. The two shifted halves cover
// disjoint bit positions, so the `|` reassembles the rotation. Every MD5 shift is
// in `[4, 23]`, so `n` is never 0 or 32.
function md5RotL(x: u32, n: u32): u32 {
  return (x << n) | (x >> (32 - n))
}

// The internal MD5 state: the four running chaining words, a 64-byte working
// block that fills as bytes arrive, how many of its bytes are live, the total
// number of bytes absorbed since the last reset (for the length pad), and the two
// constant tables built once at construction.
struct Md5 { state: []u32, buf: []byte, bufLen: int, total: uint, k: []u32, s: []u32 }

// A fresh MD5 hasher over the empty message, typed as the streaming `Hash`
// interface. The concrete state stays module-private; callers drive it purely
// through `Hash`'s five methods (or the `digest` one-shot helper).
export function newMd5(): Hash {
  let h = Md5{ state: []u32(4), buf: []byte(64), bufLen: 0, total: 0, k: md5K(), s: md5S() }
  h.reset()
  return h
}

// Absorb one 64-byte `block` into `state` (the four running words), running all
// 64 rounds against constant tables `k` and shift table `s`. Mutates `state` in
// place. The 16 message words are read little-endian.
function md5Compress(state: []u32, block: []byte, k: []u32, s: []u32) {
  let w = []u32(16)
  let t = 0
  while (t < 16) {
    let base = t * 4
    w[t] = u32(block[base]) | (u32(block[base + 1]) << 8) | (u32(block[base + 2]) << 16) | (u32(block[base + 3]) << 24)
    t = t + 1
  }

  let a = state[0]
  let b = state[1]
  let c = state[2]
  let d = state[3]

  let i = 0
  while (i < 64) {
    let f: u32 = 0
    let g = 0
    if (i < 16) {
      f = (b & c) | (~b & d)
      g = i
    } else if (i < 32) {
      f = (d & b) | (~d & c)
      g = (5 * i + 1) % 16
    } else if (i < 48) {
      f = b ^ c ^ d
      g = (3 * i + 5) % 16
    } else {
      f = c ^ (b | ~d)
      g = 7 * i % 16
    }
    f = f + a + k[i] + w[g]
    a = d
    d = c
    c = b
    b = b + md5RotL(f, s[i])
    i = i + 1
  }

  state[0] = state[0] + a
  state[1] = state[1] + b
  state[2] = state[2] + c
  state[3] = state[3] + d
}

// Absorb `data`, buffering into 64-byte blocks and compressing each full one.
// Byte-at-a-time buffering keeps the block-boundary logic obviously correct.
function (h: Md5) write(data: []byte) {
  let i = 0
  while (i < len(data)) {
    h.buf[h.bufLen] = data[i]
    h.bufLen = h.bufLen + 1
    h.total = h.total + 1
    if (h.bufLen == 64) {
      md5Compress(h.state, h.buf, h.k, h.s)
      h.bufLen = 0
    }
    i = i + 1
  }
}

// The 16-byte digest of everything written since the last reset. Finalizes on a
// copy of the running state, so it neither consumes the hasher nor blocks further
// `write`s. Padding is `0x80`, then zeros, then the 64-bit little-endian length.
function (h: Md5) sum(): []byte {
  // Snapshot the running state so finalization is non-destructive.
  let s = []u32(4)
  let i = 0
  while (i < 4) {
    s[i] = h.state[i]
    i = i + 1
  }

  // Build the padded tail from the current partial block.
  let pad = []byte(64)
  i = 0
  while (i < h.bufLen) {
    pad[i] = h.buf[i]
    i = i + 1
  }
  let n = h.bufLen
  pad[n] = 0x80
  n = n + 1

  // The 8-byte length must fit in this block; if not, flush and start a fresh
  // all-zero block for it.
  if (n > 56) {
    while (n < 64) {
      pad[n] = 0
      n = n + 1
    }
    md5Compress(s, pad, h.k, h.s)
    i = 0
    while (i < 64) {
      pad[i] = 0
      i = i + 1
    }
    n = 0
  }
  while (n < 56) {
    pad[n] = 0
    n = n + 1
  }

  // 64-bit little-endian message length in bits, low byte first.
  let bitLen = h.total * 8
  pad[56] = byte(bitLen)
  pad[57] = byte(bitLen >> 8)
  pad[58] = byte(bitLen >> 16)
  pad[59] = byte(bitLen >> 24)
  pad[60] = byte(bitLen >> 32)
  pad[61] = byte(bitLen >> 40)
  pad[62] = byte(bitLen >> 48)
  pad[63] = byte(bitLen >> 56)
  md5Compress(s, pad, h.k, h.s)

  // Serialize the four state words, each little-endian (low byte first).
  let out = []byte(16)
  i = 0
  while (i < 4) {
    let v = s[i]
    out[i * 4] = byte(v)
    out[i * 4 + 1] = byte(v >> 8)
    out[i * 4 + 2] = byte(v >> 16)
    out[i * 4 + 3] = byte(v >> 24)
    i = i + 1
  }
  return out
}

// Rewind to the empty message: restore the RFC 1321 initial state and drop any
// buffered bytes, so one hasher can digest many messages.
function (h: Md5) reset() {
  let iv = md5IV()
  let i = 0
  while (i < 4) {
    h.state[i] = iv[i]
    i = i + 1
  }
  h.bufLen = 0
  h.total = 0
}

// Digest length in bytes: MD5 is always 128 bits.
function (h: Md5) size(): int {
  return 16
}

// Internal block size in bytes (HMAC keys this block).
function (h: Md5) blockSize(): int {
  return 64
}
