// stdlib/crypto/ed25519.test.bit: `ed25519ParsePrivateKey` against the PKCS#8
// keys of RFC 8410 §10.3 and against keys written by `openssl genpkey
// -algorithm ed25519` (OpenSSL 3.5.9, run in a throwaway Alpine container),
// with the deterministic signatures `openssl pkeyutl -sign -rawin` produced
// under the same keys. The RSA key is `openssl genpkey -algorithm RSA` at 1024
// bits. The malformed keys are the RFC 8410 §10.3 key with one field changed.
//
// RFC 8410 §10.1 public key: 19bf4409...66e1; §10.3 private key: d4ee72db...5842.

import { contains } from "std/strings"

const rfcSeed: string = "d4ee72dbf913584ad5b6d8f1f769f8ad3afe7c28cbf1d4fbe097a88f44755842"
const rfcPub: string = "19bf44096984cdfe8541bac167dc3b96c85086aa30b6b6cb0c5c38ad703166e1"

const rfcV1Pem: string = "-----BEGIN PRIVATE KEY-----\n" +
  "MC4CAQAwBQYDK2VwBCIEINTuctv5E1hK1bbY8fdp+K06/nwoy/HU++CXqI9EdVhC\n" +
  "-----END PRIVATE KEY-----\n"

// RFC 8410 §10.3's second example: version 1 with an attribute and the public key.
const rfcV2Pem: string = "-----BEGIN PRIVATE KEY-----\n" +
  "MHICAQEwBQYDK2VwBCIEINTuctv5E1hK1bbY8fdp+K06/nwoy/HU++CXqI9EdVhC\n" +
  "oB8wHQYKKoZIhvcNAQkJFDEPDA1DdXJkbGUgQ2hhaXJzgSEAGb9ECWmEzf6FQbrB\n" +
  "Z9w7lshQhqowtrbLDFw4rXAxZuE=\n" +
  "-----END PRIVATE KEY-----\n"

const rfcPubPem: string = "-----BEGIN PUBLIC KEY-----\n" +
  "MCowBQYDK2VwAyEAGb9ECWmEzf6FQbrBZ9w7lshQhqowtrbLDFw4rXAxZuE=\n" +
  "-----END PUBLIC KEY-----\n"

const osslPem1: string = "-----BEGIN PRIVATE KEY-----\n" +
  "MC4CAQAwBQYDK2VwBCIEIIEFEaSZnvF28fVaqzhpBvtDYJOc4KK2d2rG2Lw710dj\n" +
  "-----END PRIVATE KEY-----\n"
const osslSeed1: string = "810511a4999ef176f1f55aab386906fb4360939ce0a2b6776ac6d8bc3bd74763"
const osslPub1: string = "c8964b003b1823c0bea58835f73c247a189c9f86ed07422248787695616a6edd"
const osslMsg1: string = "v=DKIM1; k=ed25519 1"
const osslSig1: string = "3dc5b73e750103649c60431b08717c5ab668264ee08edb902d82c1ec2bda406ca6f0b2ae3ee5cbbf62985ab2378fdab164a247b6f2e3c0de5e0e3e28de416309"

const osslPem2: string = "-----BEGIN PRIVATE KEY-----\n" +
  "MC4CAQAwBQYDK2VwBCIEIIWFaf0ShMoWd5vA/fBRY9Y2UjPHYOccM5UyLKwksW0A\n" +
  "-----END PRIVATE KEY-----\n"
const osslSeed2: string = "858569fd1284ca16779bc0fdf05163d6365233c760e71c3395322cac24b16d00"
const osslPub2: string = "2576f91dec7604e6a8d481c75b0599e9725c3d275a29036bb7aafee43dc031f2"
const osslMsg2: string = "v=DKIM1; k=ed25519 2"
const osslSig2: string = "67507f89003d6b152dd1bb8ee81b8c7c7f32eb2a1a41bee7c264e32d5f09fe7299865726773ec6f5abc320b2373b636b611f1c36c8fd7e6eb270f1b65e08cd00"

const rsaPem: string = "-----BEGIN PRIVATE KEY-----\n" +
  "MIICeAIBADANBgkqhkiG9w0BAQEFAASCAmIwggJeAgEAAoGBAL7x/xFVKKVy6DZi\n" +
  "udsQhqYlfONX0IIzO5SqEZqyc3OAWWI29vKSiqIorsPgZ02X+g5s/WBARgzRsfrt\n" +
  "2UaWZVCrsGE1ZE7ZMeJUh1sbAjHVVGzGmz4YtYz8GpiNCSHhUbgvYC5gzFGpd8dc\n" +
  "nQslkrbNzp/brzj9EHyF8uof/LWJAgMBAAECgYEApst9pAZfmybk8Z0L/PBSro/Q\n" +
  "qEbtPM7EHPjyp896Skqzybd5wCuCLmSbRT+g/YbkR/Ws34dFqa0Da86ZHbACjw9e\n" +
  "6sVjSZ2vWOcaooINI0XYzj33zkpgElgWytMtdPVinPEsenA3IkuK9NkfYTXaBw0z\n" +
  "EhdD/W0sO0g2gYBreIECQQD+RfRdukWdqSZlolpO+zGxl33xNuvfLOuXOmwNg3Qv\n" +
  "gBw9evnRqN2/iqWyKhuFBV7HVwS9fe6UBqnPS/ERjHcfAkEAwD3ywv7TR9805IEU\n" +
  "IT42SdG8N/VdzkpBRKNYPbtyS/i8VuEljHvyZjfThEt3eV1rmOGkzWMjjeoEkBRl\n" +
  "/lqGVwJBANL8YORU5+cGsCGtMZpPvNBLj+lTVSz+LQ5zH62m4gV4G/a30As0P6vr\n" +
  "88l+Pw+FgTuO7RP/JrQVQ1oK/aE+GKkCQQCWrfehr2qbYvBqSmIkzEZxBdupYMDt\n" +
  "+HW//ugjOtETixrUXhS4UE5moEtB3oT+s6KqafJqqdIsYcjBxbtL6lhxAkAxRc4o\n" +
  "77EORzUi61CJ91VDF/a4cG1JcaGKR73QsBwUCnEfa3n/NVSH4puMxksVIwpWr3tb\n" +
  "oVIQQGYCQzgmOLTL\n" +
  "-----END PRIVATE KEY-----\n"

fn edHex(s: string): []byte {
  return decodeHex(s) catch e {
    panic("bad hex in ed25519.test.bit: ${e.message()}")
  }
}

fn pemDer(pem: string): []byte {
  let blocks = pemDecode(pem) catch e {
    panic("pemDecode: ${e.message()}")
  }
  assert(len(blocks) == 1, "expected one PEM block")
  return blocks[0].der
}

fn parseOk(der: []byte): []byte {
  return ed25519ParsePrivateKey(der) catch e {
    panic("ed25519ParsePrivateKey: ${e.message()}")
  }
}

// Fails the test unless parsing `hex` fails with a message containing `want`.
fn expectFail(name: string, hex: string, want: string) {
  let got = ed25519ParsePrivateKey(edHex(hex)) catch e {
    assert(contains(e.message(), want), "${name}: error \"${e.message()}\" lacks \"${want}\"")
    assert(!contains(e.message(), rfcSeed), "${name}: error text carries key bytes")
    return
  }
  panic("${name}: expected failure, got ${len(got)} bytes")
}

// The last 32 bytes of a SubjectPublicKeyInfo (12-byte header for Ed25519).
fn spkiKey(pem: string): []byte {
  let der = pemDer(pem)
  assert(len(der) == 44, "SPKI length")
  return der[12:44]
}

// DER of the RFC 8410 key with its fields spelled out, so a test changes one.
// Layout: SEQUENCE { INTEGER ver, SEQUENCE { OID }, OCTET STRING { OCTET STRING seed } }.
const v1Head: string = "302e020100300506032b657004220420"

test "ed25519ParsePrivateKey: RFC 8410 §10.3 key without the public key" {
  let seed = parseOk(pemDer(rfcV1Pem))
  assert(ctEq(seed, edHex(rfcSeed)), "seed")
  assert(ctEq(ed25519PublicKey(seed), edHex(rfcPub)), "public key")
  assert(ctEq(spkiKey(rfcPubPem), edHex(rfcPub)), "fixture: RFC 8410 §10.1 key")
}

test "ed25519ParsePrivateKey: RFC 8410 §10.3 key with attribute and public key" {
  let seed = parseOk(pemDer(rfcV2Pem))
  assert(ctEq(seed, edHex(rfcSeed)), "seed")
  assert(ctEq(ed25519PublicKey(seed), edHex(rfcPub)), "public key")
}

test "ed25519ParsePrivateKey: version 1 with only the public key" {
  let seed = parseOk(edHex("3051020101300506032b657004220420" + rfcSeed + "812100" + rfcPub))
  assert(ctEq(seed, edHex(rfcSeed)), "seed")
}

test "ed25519ParsePrivateKey: openssl keys sign and verify" {
  let seed1 = parseOk(pemDer(osslPem1))
  assert(ctEq(seed1, edHex(osslSeed1)), "key 1 seed")
  assert(ctEq(ed25519PublicKey(seed1), edHex(osslPub1)), "key 1 public key")
  let sig1 = ed25519Sign(seed1, []byte(osslMsg1))
  assert(ctEq(sig1, edHex(osslSig1)), "key 1: signature differs from openssl's")
  assert(ed25519Verify(edHex(osslPub1), []byte(osslMsg1), sig1), "key 1: verify")
  assert(
    ed25519Verify(edHex(osslPub1), []byte(osslMsg1), edHex(osslSig1)),
    "key 1: openssl signature",
  )

  let seed2 = parseOk(pemDer(osslPem2))
  assert(ctEq(seed2, edHex(osslSeed2)), "key 2 seed")
  let sig2 = ed25519Sign(seed2, []byte(osslMsg2))
  assert(ctEq(sig2, edHex(osslSig2)), "key 2: signature differs from openssl's")
  assert(ed25519Verify(edHex(osslPub2), []byte(osslMsg2), sig2), "key 2: verify")
  assert(!ed25519Verify(edHex(osslPub2), []byte(osslMsg1), sig2), "key 2: wrong message")
}

test "ed25519ParsePrivateKey: an RSA PKCS#8 key is not an Ed25519 key" {
  let got = ed25519ParsePrivateKey(pemDer(rsaPem)) catch e {
    assert(contains(e.message(), "not an Ed25519 private key"), e.message())
    return
  }
  panic("RSA key parsed to ${len(got)} bytes")
}

test "ed25519ParsePrivateKey: wrong OID, parameters, lengths and version" {
  expectFail(
    "Ed448 OID",
    "302e020100300506032b657104220420" + rfcSeed,
    "not an Ed25519 private key",
  )
  expectFail(
    "NULL parameters",
    "3030020100300706032b6570050004220420" + rfcSeed,
    "parameters must be absent",
  )
  expectFail(
    "31-byte key",
    "302d020100300506032b6570" + "0421" + "041f" + rfcSeed[0:62],
    "must be 32 bytes",
  )
  expectFail(
    "33-byte key",
    "302f020100300506032b6570" + "0423" + "0421" + rfcSeed + "00",
    "must be 32 bytes",
  )
  expectFail(
    "version 2",
    "302e020102300506032b657004220420" + rfcSeed,
    "unsupported PrivateKeyInfo version",
  )
  expectFail(
    "version -1",
    "302e0201ff300506032b657004220420" + rfcSeed,
    "unsupported PrivateKeyInfo version",
  )
}

test "ed25519ParsePrivateKey: strict DER" {
  expectFail("trailing byte", v1Head + rfcSeed + "00", "trailing bytes")
  expectFail(
    "trailing inside the wrapper",
    "302f020100300506032b6570" + "0423" + "0420" + rfcSeed + "00",
    "trailing bytes",
  )
  expectFail("truncated", v1Head + rfcSeed[0:62], "asn1:")
  expectFail("two fields", "300a020100300506032b6570", "at least three fields")
  expectFail("empty", "", "asn1:")
}

test "ed25519ParsePrivateKey: embedded public key rules" {
  let wrong = "3051020101300506032b657004220420" + rfcSeed + "812100" + osslPub1
  expectFail("mismatched public key", wrong, "the embedded public key does not match")
  expectFail(
    "public key in a version 0 key",
    "3051020100300506032b657004220420" + rfcSeed + "812100" + rfcPub,
    "version 0 key must not carry",
  )
  expectFail(
    "short public key",
    "3050020101300506032b657004220420" + rfcSeed + "812000" + rfcPub[0:62],
    "malformed embedded public key",
  )
  expectFail(
    "public key with unused bits",
    "3051020101300506032b657004220420" + rfcSeed + "812103" + rfcPub,
    "malformed embedded public key",
  )
  expectFail(
    "public key twice",
    "3074020101300506032b657004220420" + rfcSeed + "812100" + rfcPub + "812100" + rfcPub,
    "unexpected fields",
  )
}
