// Bit standard library — crypto module, PBKDF2 (RFC 8018 §5.2).
//
// PBKDF2 is the password-based key derivation function: it stretches a
// low-entropy password into a derived key of any length, deliberately slowing
// a brute-force guesser by repeating a pseudo-random function `c` times per
// output block. The PRF here is HMAC (RFC 8018 §5.2 recommends HMAC), so the
// whole construction is built from `hmac` and inherits its digest-agnosticism.
//
// The derived key is the concatenation of blocks T(1), T(2), ..., each one
// hash-digest long and the last truncated to fill exactly `outLen` bytes:
//
//   DK       = T(1) || T(2) || ... || T(l)   truncated to outLen
//   T(i)     = U(1) ^ U(2) ^ ... ^ U(c)      the F-function for block i
//   U(1)     = HMAC(password, salt || INT_32_BE(i))
//   U(j)     = HMAC(password, U(j-1))        for j = 2..c
//
// where `INT_32_BE(i)` is the one-based block index as four big-endian octets,
// so distinct blocks derive from distinct PRF inputs. The iteration count `c`
// is the whole cost knob: every one of the `c` HMAC calls per block must be
// redone by an attacker per password guess, while a legitimate caller pays it
// once. Choose it as high as the login latency budget allows.
//
// The construction is generic over the digest: the caller hands in a hash
// *constructor* (`() => Hash`, e.g. `newSha1`/`newSha256`), and the block
// length is the hash's own `size()`. This file is part of the flat `std/crypto`
// module, so it names `Hash`, `hmac`, and `assert` from its siblings and the
// prelude without importing them.

// `salt || INT_32_BE(index)` — the HMAC message for U(1) of block `index`: the
// salt followed by the one-based block index as four octets, most significant
// first (RFC 8018 §5.2 step 3, the INT(i) encoding).
function pbkdf2FirstInput(salt: []byte, index: int): []byte {
  let out = []byte(len(salt) + 4)
  let i = 0
  while (i < len(salt)) {
    out[i] = salt[i]
    i = i + 1
  }
  let at = len(salt)
  out[at] = byte(index >> 24)
  out[at + 1] = byte(index >> 16)
  out[at + 2] = byte(index >> 8)
  out[at + 3] = byte(index)
  return out
}

// The F-function (RFC 8018 §5.2): block T(index) = U(1) ^ U(2) ^ ... ^ U(iters),
// exactly one digest long. U(1) folds in the salt and block index; each later
// U(j) is the HMAC of the previous one, and all are XORed together. `newHash`
// selects the PRF digest; `password` is the HMAC key.
function pbkdf2Block(
  newHash: () => Hash,
  password: []byte,
  salt: []byte,
  iters: int,
  index: int,
): []byte {
  let u = hmac(newHash, password, pbkdf2FirstInput(salt, index))
  // Accumulate into a fresh copy of U(1), so reassigning `u` below never
  // aliases the block being XORed into.
  let block = []byte(len(u))
  let k = 0
  while (k < len(u)) {
    block[k] = u[k]
    k = k + 1
  }
  let j = 1
  while (j < iters) {
    u = hmac(newHash, password, u)
    k = 0
    while (k < len(block)) {
      block[k] = block[k] ^ u[k]
      k = k + 1
    }
    j = j + 1
  }
  return block
}

// Copy `src` into `dst` starting at offset `off`, never writing past the end of
// `dst`, and return the new fill offset. This truncates the final block T(l) to
// the requested derived-key length.
function pbkdf2CopyInto(dst: []byte, off: int, src: []byte): int {
  let i = 0
  while (i < len(src) && off + i < len(dst)) {
    dst[off + i] = src[i]
    i = i + 1
  }
  return off + i
}

// PBKDF2 (RFC 8018 §5.2): derive `outLen` bytes of key material from `password`
// and `salt`, running the HMAC PRF `iters` times per output block. `newHash`
// selects the digest (e.g. `newSha1`, `newSha256`) and must return a fresh,
// empty hasher on each call; `iters` is the cost factor and must be at least 1.
// The result is deterministic in all five inputs, so the same arguments always
// derive the same key. Panics if `iters < 1` or `outLen` exceeds the block
// counter's `(2^32 - 1) * hLen` ceiling.
export function pbkdf2(
  newHash: () => Hash,
  password: []byte,
  salt: []byte,
  iters: int,
  outLen: int,
): []byte {
  assert(iters >= 1, "pbkdf2: iters must be >= 1")
  let hLen = newHash().size()
  assert(outLen <= 4294967295 * hLen, "pbkdf2: outLen exceeds (2^32-1)*hLen")
  let out = []byte(outLen)
  let filled = 0
  let index = 1
  while (filled < outLen) {
    filled = pbkdf2CopyInto(out, filled, pbkdf2Block(newHash, password, salt, iters, index))
    index = index + 1
  }
  return out
}
