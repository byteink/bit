// Bit standard library — crypto/subtle module.
//
// Branchless, data-independent building blocks for constant-time code. The
// compiler does not machine-verify constant-timeness in v1 (see docs), so these
// are written to be branchless *by construction*: no primitive here branches on,
// or indexes memory by, a secret value. Comparisons run over the full input and
// selection is a pure bit-mask, so their control flow and memory access depend
// only on public lengths — never on secret contents. Use them for MAC/hash tag
// checks, key selection, and wiping key material.

// Constant-time equality of two byte slices. Unlike `a == b` — which may return
// as soon as it meets the first differing byte and so leaks *where* two tags
// diverge — this always scans the full length before deciding.
//
// The only length-dependent branch is the fast `len(a) != len(b)` reject: slice
// lengths are public, not secret, so short-circuiting on them leaks nothing. For
// equal lengths it OR-accumulates every `a[i] ^ b[i]`; the accumulator stays 0
// only when every byte matched. Use it to compare MACs and hash digests, where a
// timing oracle on the mismatch position breaks the tag.
export function ctEq(a: []byte, b: []byte): bool {
  if (len(a) != len(b)) {
    return false
  }
  let acc: byte = 0
  let i = 0
  while (i < len(a)) {
    acc = acc | (a[i] ^ b[i])
    i = i + 1
  }
  return acc == 0
}

// Constant-time select: returns `a` when `v` is 1 and `b` when `v` is 0, with no
// branch on `v`. `v` must be exactly 0 or 1 (any other value yields a garbage
// mask); callers pass the 0/1 result of a prior constant-time comparison.
//
// `0 - v` builds an all-ones mask (-1) for v == 1 and an all-zeros mask for
// v == 0. `a` is kept through `mask`, `b` through its complement, and the two
// are ORed — so exactly one operand survives and the choice never becomes a
// branch. (Bit is Go-like and has no `bool`->`int` conversion, so — like Go's
// own `crypto/subtle` — the selector is an `int` in {0, 1}, not a `bool`.)
export function ctSelect(v: int, a: int, b: int): int {
  let mask = 0 - v
  return (a & mask) | (b & ~mask)
}

// Wipe every byte of `b` to zero through the runtime's un-elidable barrier
// (ABI.md §21), so a dead-store optimizer cannot drop the clear. Use it to
// destroy key material, plaintext, or intermediate secrets the moment they are
// no longer needed; `b`'s length is unchanged.
export function secureZero(b: []byte) { cryptoSecureZero(b) }
