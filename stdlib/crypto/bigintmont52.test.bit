// Independent integer-power vectors cover radix padding, carry and aliasing.
fn mont52TestNat(h: string): Nat {
  let b = decodeHex(h) catch _ {
    panic("invalid radix52 test vector")
  }
  return bigintFromBytes(b)
}

class Mont52TestVector { n: string, b: string, e: string, r: string, rr: string }

fn mont52TestVector(v: Mont52TestVector, bits: int) {
  let n = mont52TestNat(v.n)
  let c = bigintMontNew(n)
  let w = bigintMont52New(c)
  assert(len(w.n) == (32 * len(c.n) + 51) / 52, "radix52 public width")
  assert(((w.n[0] * w.inv) & mont52Mask) == mont52Mask, "radix52 inverse")
  let rr = []u32(len(c.n))
  bigintUnpack52(rr, w.r2)
  assert(bigintCmp(bigintMake(rr), mont52TestNat(v.rr)) == 0, "radix52 translated R2")
  let base = bigintWiden(mont52TestNat(v.b), len(c.n))
  let exp = bigintWiden(mont52TestNat(v.e), (bits + 31) / 32)
  let out = []u32(len(c.n))
  bigintMont52ExpTo(c, out, base, exp, bits)
  assert(bigintCmp(bigintMake(out), mont52TestNat(v.r)) == 0, "radix52 independent exponent")
  bigintMont52ExpTo(c, base, base, exp, bits)
  assert(bigintCmp(bigintMake(base), mont52TestNat(v.r)) == 0, "radix52 aliased exponent")
}

test "radix52 full product and carry are exact" {
  let (carry, lo) = bigintMont52Word(mont52Mask, mont52Mask, mont52Mask, mont52Mask)
  assert(carry == mont52Mask && lo == mont52Mask, "radix52 maximal carry")
  let (high, low) = bigintMont52Word(0, u64(1) << 51, u64(1) << 51, 0)
  assert(high == (u64(1) << 50) && low == 0, "radix52 high product")
}

test "radix52 packing retains every bit and guards" {
  let src = []u32(52)
  let i = 0
  while (i < len(src)) {
    src[i] = 0xfedcba98 ^ (u32(i) * 0x01020305)
    i = i + 1
  }
  let packed = bigintPack52(src, 32)
  let guarded = []u32(54)
  guarded[0] = 0x89abcdef
  guarded[53] = 0x76543210
  bigintUnpack52(guarded[1:53], packed)
  assert(guarded[0] == 0x89abcdef && guarded[53] == 0x76543210, "radix52 packing guards")
  i = 0
  while (i < len(src)) {
    assert(guarded[i + 1] == src[i], "radix52 packing roundtrip")
    i = i + 1
  }
}

test "radix52 selection retains high bits for all windows" {
  let tab = []u64(32)
  let i = 0
  while (i < 16) {
    tab[2 * i] = mont52Mask - u64(i)
    tab[2 * i + 1] = (u64(1) << 51) | u64(i)
    i = i + 1
  }
  let dst = []u64(2)
  i = 0
  while (i < 16) {
    bigintMont52Select(dst, tab, u32(i))
    assert(dst[0] == tab[2 * i] && dst[1] == tab[2 * i + 1], "radix52 selection mask")
    i = i + 1
  }
}

test "radix52 independent 32-bit padded exponent" {
  mont52TestVector(
    Mont52TestVector{
      n = "ff60ffe5",
      b = "3fa5fd27",
      e = "012345",
      r = "69ca4b2b",
      rr = "557a6ee5",
    },
    32,
  )
}

