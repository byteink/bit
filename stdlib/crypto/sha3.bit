// Bit standard library — crypto module, SHA-3 and SHAKE (FIPS 202).
//
// Keccak-f[1600] sponge: a 25-lane u64 state permuted by 24 rounds of the five
// step mappings (theta, rho, pi, chi, iota). SHA3-224/256/384/512 are the
// fixed-output hashes; SHAKE128/256 are the extendable-output functions (XOFs).
// All four SHA-3 variants conform structurally to `Hash` (§14.3); the two SHAKE
// variants expose `absorb` + `squeeze` for arbitrary-length output.
//
// The state is addressed as little-endian bytes (FIPS 202 §B.1): byte position
// `p` is bit-lane `p / 8`, low byte first. This makes the byte<->lane mapping
// endianness-independent — correct on both x86-64 and ARM64 — rather than
// aliasing the lane array as raw memory the way a C union would.
//
// Domain separation and pad10*1 (FIPS 202 §B.2): SHA-3 appends `0x06`, SHAKE
// appends `0x1F`, then the final block's top byte gets `0x80`. The round
// constants and rotation/lane-permutation tables below are the canonical
// Keccak values; the NIST known-answer vectors in the test corpus prove them.

// A 64-bit left rotation by `r` (0 <= r < 64). Shift counts are taken modulo the
// operand width (§SPEC 881), so `64 - r` reduces to a plain rotation with no
// undefined shift-by-width.
function rotl64(x: u64, r: u64): u64 { return (x << r) | (x >> (64 - r)) }

// XOR one input byte `b` into the little-endian state at byte position `p`.
function absorbByte(st: []u64, p: int, b: u8) {
  let lane = p / 8
  let shift = u64(p % 8 * 8)
  st[lane] = st[lane] ^ (u64(b) << shift)
}

// The little-endian state byte at position `p`.
function squeezeByte(st: []u64, p: int): u8 {
  let lane = p / 8
  let shift = u64(p % 8 * 8)
  return u8((st[lane] >> shift) & 0xff)
}

// Theta: XOR each lane with the parity of its two neighbouring columns. `bc` is
// caller-owned scratch (5 lanes), reused across the round to avoid re-allocating.
function theta(st: []u64, bc: []u64) {
  let i = 0
  while (i < 5) {
    bc[i] = st[i] ^ st[i + 5] ^ st[i + 10] ^ st[i + 15] ^ st[i + 20]
    i = i + 1
  }
  i = 0
  while (i < 5) {
    let t = bc[(i + 4) % 5] ^ rotl64(bc[(i + 1) % 5], 1)
    let j = 0
    while (j < 25) {
      st[j + i] = st[j + i] ^ t
      j = j + 5
    }
    i = i + 1
  }
}

// Rho + Pi: rotate each lane by its offset (`rotc`) and move it to its permuted
// position (`piln`), walking the 24-lane cycle with a single carried temporary.
function rhoPi(st: []u64, piln: []int, rotc: []int) {
  let t = st[1]
  let i = 0
  while (i < 24) {
    let j = piln[i]
    let tmp = st[j]
    st[j] = rotl64(t, u64(rotc[i]))
    t = tmp
    i = i + 1
  }
}

// Chi: the row-wise nonlinear step, `a[x] ^= (~a[x+1]) & a[x+2]`. `bc` is
// caller-owned 5-lane scratch, refilled per row.
function chi(st: []u64, bc: []u64) {
  let j = 0
  while (j < 25) {
    let k = 0
    while (k < 5) {
      bc[k] = st[j + k]
      k = k + 1
    }
    k = 0
    while (k < 5) {
      st[j + k] = st[j + k] ^ (~bc[(k + 1) % 5] & bc[(k + 2) % 5])
      k = k + 1
    }
    j = j + 5
  }
}

// The Keccak-f[1600] permutation, applied to `st` (25 lanes) in place. The five
// step mappings are separate functions (theta, rho+pi, chi, iota) — factoring
// them keeps each register-light, which the round loop below then sequences.
//
// Bit's top-level `const` is compile-time scalar only (§10.1), so the round
// constants and the rho/pi tables live as function-local `const` slices, built
// once per permutation and shared with the step helpers.
function keccakF(st: []u64) {
  const rc: []u64 = []u64{
    0x0000000000000001,
    0x0000000000008082,
    0x800000000000808a,
    0x8000000080008000,
    0x000000000000808b,
    0x0000000080000001,
    0x8000000080008081,
    0x8000000000008009,
    0x000000000000008a,
    0x0000000000000088,
    0x0000000080008009,
    0x000000008000000a,
    0x000000008000808b,
    0x800000000000008b,
    0x8000000000008089,
    0x8000000000008003,
    0x8000000000008002,
    0x8000000000000080,
    0x000000000000800a,
    0x800000008000000a,
    0x8000000080008081,
    0x8000000000008080,
    0x0000000080000001,
    0x8000000080008008,
  }
  const rotc: []int = []int{
    1,
    3,
    6,
    10,
    15,
    21,
    28,
    36,
    45,
    55,
    2,
    14,
    27,
    41,
    56,
    8,
    25,
    43,
    62,
    18,
    39,
    61,
    20,
    44,
  }
  const piln: []int = []int{
    10,
    7,
    11,
    17,
    18,
    3,
    5,
    16,
    8,
    21,
    24,
    4,
    15,
    23,
    19,
    13,
    12,
    2,
    20,
    14,
    22,
    9,
    6,
    1,
  }

  let bc = []u64(5)
  let r = 0
  while (r < 24) {
    theta(st, bc)
    rhoPi(st, piln, rotc)
    chi(st, bc)
    // Iota: break the round symmetry with a constant into lane 0.
    st[0] = st[0] ^ rc[r]
    r = r + 1
  }
}

// A fresh copy of a 25-lane state, so `sum` can finalize without disturbing the
// running hash (a `Hash` may be summed and then written to again).
function cloneState(st: []u64): []u64 {
  let c = []u64(25)
  let i = 0
  while (i < 25) {
    c[i] = st[i]
    i = i + 1
  }
  return c
}

// Absorb `data` into `st` starting at block offset `pt`, permuting each time the
// `rate`-byte block fills. Returns the new block offset, always in `[0, rate)`.
function spongeAbsorb(st: []u64, rate: int, pt: int, data: []byte): int {
  let j = pt
  let i = 0
  while (i < len(data)) {
    absorbByte(st, j, data[i])
    j = j + 1
    if (j >= rate) {
      keccakF(st)
      j = 0
    }
    i = i + 1
  }
  return j
}

// Apply domain-separation byte `ds` and the pad10*1 terminator at offset `pt`,
// then permute — closing absorption so the state is ready to squeeze. When the
// message fills all but the last byte of the block, `ds` and `0x80` land on the
// same byte and combine, exactly as FIPS 202 prescribes.
function spongePad(st: []u64, rate: int, pt: int, ds: u8) {
  absorbByte(st, pt, ds)
  absorbByte(st, rate - 1, 0x80)
  keccakF(st)
}

// A fixed-output SHA-3 hash (FIPS 202 §6.1). Streaming: `write` any number of
// times, then `sum`; `reset` returns to empty. Conforms to `Hash`.
export struct Sha3 {
  st: []u64, // 25-lane Keccak state
  rate: int, // bytes absorbed per permutation (the block size)
  outLen: int, // digest length in bytes
  pt: int, // current byte offset within the block being filled
}

// Absorb more input.
export function (h: Sha3) write(data: []byte) { h.pt = spongeAbsorb(h.st, h.rate, h.pt, data) }

// The digest of everything written since the last `reset`. Non-destructive: it
// finalizes a copy, so the hash may keep accepting input afterward. Every SHA-3
// digest is no longer than its rate, so one squeezed block always suffices.
export function (h: Sha3) sum(): []byte {
  let st = cloneState(h.st)
  spongePad(st, h.rate, h.pt, 0x06)
  let out = []byte(h.outLen)
  let i = 0
  while (i < h.outLen) {
    out[i] = squeezeByte(st, i)
    i = i + 1
  }
  return out
}

// Return to the empty state, ready to hash a new message.
export function (h: Sha3) reset() {
  let i = 0
  while (i < 25) {
    h.st[i] = 0
    i = i + 1
  }
  h.pt = 0
}

// The digest length in bytes (28, 32, 48, or 64).
export function (h: Sha3) size(): int { return h.outLen }

// The internal block size in bytes (the sponge rate).
export function (h: Sha3) blockSize(): int { return h.rate }

// SHA3-224: 224-bit digest, 144-byte rate.
export function newSha3_224(): Sha3 { return Sha3{ st: []u64(25), rate: 144, outLen: 28, pt: 0 } }

// SHA3-256: 256-bit digest, 136-byte rate.
export function newSha3_256(): Sha3 { return Sha3{ st: []u64(25), rate: 136, outLen: 32, pt: 0 } }

// SHA3-384: 384-bit digest, 104-byte rate.
export function newSha3_384(): Sha3 { return Sha3{ st: []u64(25), rate: 104, outLen: 48, pt: 0 } }

// SHA3-512: 512-bit digest, 72-byte rate.
export function newSha3_512(): Sha3 { return Sha3{ st: []u64(25), rate: 72, outLen: 64, pt: 0 } }

// A SHAKE extendable-output function (FIPS 202 §6.2). Feed input with `absorb`,
// then draw as many output bytes as wanted with one or more `squeeze` calls; the
// output stream is continuous across calls. Absorbing after the first squeeze is
// a misuse and panics, because the sponge has already switched to squeezing.
export struct Shake {
  st: []u64, // 25-lane Keccak state
  rate: int, // bytes per permutation (168 for SHAKE128, 136 for SHAKE256)
  pt: int, // current byte offset within the block
  squeezing: bool, // true once output has begun; absorption is then closed
}

// Absorb more input. Panics if called after squeezing has begun.
export function (s: Shake) absorb(data: []byte) {
  if (s.squeezing) {
    panic("shake: absorb after squeeze")
  }
  s.pt = spongeAbsorb(s.st, s.rate, s.pt, data)
}

// The next `n` output bytes of the stream. The first call closes absorption with
// SHAKE's `0x1F` domain separation; further calls continue where the last left
// off, so `squeeze(a)` then `squeeze(b)` yields the same bytes as `squeeze(a+b)`.
// A non-positive `n` yields an empty slice.
export function (s: Shake) squeeze(n: int): []byte {
  if (!s.squeezing) {
    spongePad(s.st, s.rate, s.pt, 0x1f)
    s.pt = 0
    s.squeezing = true
  }
  if (n <= 0) {
    return []byte(0)
  }
  let out = []byte(n)
  let j = s.pt
  let i = 0
  while (i < n) {
    if (j >= s.rate) {
      keccakF(s.st)
      j = 0
    }
    out[i] = squeezeByte(s.st, j)
    j = j + 1
    i = i + 1
  }
  s.pt = j
  return out
}

// SHAKE128: 128-bit security, 168-byte rate.
export function newShake128(): Shake {
  return Shake{ st: []u64(25), rate: 168, pt: 0, squeezing: false }
}

// SHAKE256: 256-bit security, 136-byte rate.
export function newShake256(): Shake {
  return Shake{ st: []u64(25), rate: 136, pt: 0, squeezing: false }
}
