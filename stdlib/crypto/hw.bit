// Bit standard library — crypto module, ARM64 hardware crypto-capability
// detection (#2521, epic #1224, over `bit_rt_crypto_hwcaps` from #2520).
//
// `bit_rt_crypto_hwcaps()` (ABI.md §21c) returns a u64 bitmask: bit 0 = AES,
// bit 1 = PMULL, bit 2 = SHA2. This file exposes it as four stdlib
// predicates rather than the raw bitmask, so no caller needs to know the bit
// layout to ask "does this CPU have AES?":
//
//   hwAes(), hwPmull(), hwSha2() — one per bit, mirroring the three
//   independent capabilities the runtime primitive reports. A target could
//   in principle have AES without PMULL (Apple Silicon and every
//   aarch64-linux host tested so far report all three together, but the
//   bitmask does not guarantee that for every future target).
//
//   hwAvailable() — true only when all three are set. This is not a fourth
//   independent bit; it is the convenience the common case needs, since an
//   accelerated AES-GCM path (the rest of epic #1224) requires AES *and*
//   PMULL *and* SHA2 together and would otherwise have to AND three calls
//   itself every time it wants to decide whether to take the hardware path.
//
// These are distinct from `hwAvailableAes`/`hwAvailableGhash`/
// `hwAvailableSha256` (aes.bit/gcm.bit/sha256.bit, task #1223): those report
// the *x86-64* AES-NI/PCLMULQDQ/SHA-NI dispatch (always false today, since no
// x86-64 hardware path exists yet). These four report the *ARM64* extensions
// `bit_rt_crypto_hwcaps` was built for. Same idea, disjoint hardware,
// disjoint runtime primitives — do not conflate the two families.
//
// `BIT_CRYPTO_HW=0` (the exact string "0") forces every function below to
// report false, overriding whatever the hardware actually has — a kill
// switch for benchmarking the software path, or working around a hardware
// erratum, without recompiling. Any other value — unset, empty, "1", or
// garbage — uses the real hardware answer. The environment is read ONCE and
// cached: a crypto hot path cannot afford an `osEnv` read per call, and the
// answer cannot change mid-process, the same argument
// `runtime/cryptohw/{linux,darwin}/cryptohw.bit`'s own `hwcapsCache` makes
// for `bit_rt_crypto_hwcaps` itself.

extern fn bit_rt_crypto_hwcaps(): uint

const hwBitAes: int = 1
const hwBitPmull: int = 2
const hwBitSha2: int = 4
const hwBitAll: int = 7

// Sentinel -1: "not yet computed". A real answer is always in [0, 7], the
// same sentinel convention the runtime cache uses for `hwcapsCache`. Racing
// initializers are harmless — every racing thread reads the identical
// environment and hardware state and computes the identical value.
let hwCache: int = -1

// The cached capability bitmask, computed once: `BIT_CRYPTO_HW=0` forces 0
// (nothing available); any other value copies `bit_rt_crypto_hwcaps()`.
fn hwCaps(): int {
  if (hwCache >= 0) {
    return hwCache
  }
  let caps = 0
  if (osEnv("BIT_CRYPTO_HW") != "0") {
    caps = int(bit_rt_crypto_hwcaps())
  }
  hwCache = caps
  return caps
}

// Whether this CPU has the ARMv8 AES instruction set (bit 0 of
// `bit_rt_crypto_hwcaps`, ABI.md §21c). False when `BIT_CRYPTO_HW=0`, or on
// any target `bit_rt_crypto_hwcaps` reports 0 for (x86_64, etc).
export fn hwAes(): bool {
  return (hwCaps() & hwBitAes) != 0
}

// Whether this CPU has the ARMv8 PMULL (carry-less multiply) instruction —
// bit 1 of `bit_rt_crypto_hwcaps`. False when `BIT_CRYPTO_HW=0`.
export fn hwPmull(): bool {
  return (hwCaps() & hwBitPmull) != 0
}

// Whether this CPU has the ARMv8 SHA2 instruction set — bit 2 of
// `bit_rt_crypto_hwcaps`. False when `BIT_CRYPTO_HW=0`.
export fn hwSha2(): bool {
  return (hwCaps() & hwBitSha2) != 0
}

// Whether AES, PMULL and SHA2 are ALL available — the full ARM64 crypto
// extension, and the condition an accelerated AES-GCM path needs before it
// can skip the software fallback. False if any one of the three is missing,
// or if `BIT_CRYPTO_HW=0`.
export fn hwAvailable(): bool {
  return hwCaps() == hwBitAll
}
