// Bit standard library — crypto module, HMAC (RFC 2104).
//
// HMAC turns any unkeyed hash `H` into a keyed message authentication code:
//   HMAC(K, m) = H((K' ^ opad) || H((K' ^ ipad) || m))
// where `ipad` is the byte 0x36 and `opad` the byte 0x5c, each repeated across a
// whole block, and `K'` is the key normalized to exactly one hash block. The two
// nested hashes with the pad-masked key are what make HMAC a pseudo-random
// function even when the bare hash is not, and they defend against the
// length-extension weakness of the Merkle–Damgård hashes (SHA-1, SHA-2).
//
// The construction is generic over the digest: the caller hands in a hash
// *constructor* (`() => Hash`, e.g. `newSha256`/`newSha512`), so one
// implementation authenticates under any member of the SHA-2 family — HMAC asks
// the hash for its own `blockSize` rather than hard-coding one. This file is part
// of the flat `std/crypto` module, so it names `Hash`, `digest`, and `ctEq` from
// its siblings without importing them.
//
// The key is reduced to a single block first (RFC 2104 §2): a key longer than the
// block is hashed down — after which it is `size()` bytes, always <= the block —
// and any key shorter than the block is zero-padded up. Everything below is byte
// arithmetic with no secret-dependent branch, and tag comparison goes through
// `hmacEqual`, which is constant-time.

// The ipad/opad constants (RFC 2104 §2): the inner and outer pad bytes, each
// XORed across the whole block-sized key.
const hmacIpad: byte = 0x36
const hmacOpad: byte = 0x5c

// Normalize `key` to exactly `blockSize` bytes: hash a too-long key down to its
// digest first (then it is `size()` bytes, always <= `blockSize`), and zero-pad a
// short key up. `newHash` builds the fresh hasher used for the long-key case.
function hmacBlockKey(newHash: () => Hash, key: []byte, blockSize: int): []byte {
  let k = key
  if (len(key) > blockSize) {
    k = digest(newHash(), key)
  }
  let out = []byte(blockSize)
  let i = 0
  while (i < len(k)) {
    out[i] = k[i]
    i = i + 1
  }
  return out
}

// The block-sized key XORed byte-for-byte with the repeated pad byte `pad`,
// yielding `K' ^ ipad` or `K' ^ opad`.
function hmacXorPad(blockKey: []byte, pad: byte): []byte {
  let out = []byte(len(blockKey))
  let i = 0
  while (i < len(blockKey)) {
    out[i] = blockKey[i] ^ pad
    i = i + 1
  }
  return out
}

// The HMAC of `msg` under `key`, using the hash built by `newHash` — the digest
// length is the hash's own `size()` (32 bytes for SHA-256, 64 for SHA-512). A
// `key` longer than the hash's block is hashed first; a shorter one is
// zero-padded. `newHash` must return a fresh, empty hasher on each call.
export function hmac(newHash: () => Hash, key: []byte, msg: []byte): []byte {
  let probe = newHash()
  let blockSize = probe.blockSize()
  let blockKey = hmacBlockKey(newHash, key, blockSize)

  // inner = H((K' ^ ipad) || msg)
  let inner = newHash()
  inner.write(hmacXorPad(blockKey, hmacIpad))
  inner.write(msg)
  let innerSum = inner.sum()

  // outer = H((K' ^ opad) || inner)
  let outer = newHash()
  outer.write(hmacXorPad(blockKey, hmacOpad))
  outer.write(innerSum)
  return outer.sum()
}

// Constant-time equality of two HMAC tags, via `ctEq`. Always compare tags with
// this rather than `==`: a comparison that stops at the first differing byte
// leaks *where* two tags diverge, and that timing oracle is enough to forge a
// valid tag one byte at a time.
export function hmacEqual(a: []byte, b: []byte): bool { return ctEq(a, b) }
