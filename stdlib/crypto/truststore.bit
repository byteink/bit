// Bit standard library — crypto/truststore module.
//
// A *trust store* is the set of certificate authorities a caller is willing to
// treat as trust anchors: the roots a TLS client verifies a server's chain up
// to. This module holds those roots as parsed `Certificate`s and verifies a
// leaf against them, delegating the actual path building and signature checks to
// `x509VerifyChain` — it never reimplements verification, it only owns the
// anchor set.
//
// Three ways to populate a store, in decreasing order of preference for a real
// deployment:
//
//   - `systemRoots()` — the operating system's own trust store. On Linux this is
//     the distribution's CA bundle (`/etc/ssl/certs/ca-certificates.crt`) or, as
//     a fallback, the hashed-certificate directory `/etc/ssl/certs`. Reading the
//     platform store means the store tracks the administrator's decisions
//     (added corporate roots, distrusted CAs). macOS and Windows keep their trust
//     in the Keychain / certificate store behind Security.framework / CryptoAPI;
//     integrating those is a later task, so on those systems `systemRoots` fails
//     with a clear error and the caller falls back to `bundled`.
//
//   - `fromPem(pem)` — an explicit set of roots the caller supplies (a pinned
//     corporate root, a private PKI, a test fixture). Strict: every CERTIFICATE
//     block must parse.
//
//   - `bundled()` — a small, curated set of well-known public roots compiled
//     into the binary, so a program has a working default even with no system
//     store. This is a convenience floor, not a substitute for the system store;
//     see the `// ponytail:` note on the embedded set below.
//
// Verification is deterministic: `nowUnix` is injected, never read from a clock,
// exactly as `x509VerifyChain` requires.

import { readFile, exists, isDir, readDir } from "std/fs"
import { join } from "std/path"

// The Debian/Ubuntu/Alpine single-file CA bundle, and the RHEL/other hashed
// per-certificate directory to fall back to. Declared ahead of `systemRoots`
// deliberately: a module-level const referenced in a string interpolation must
// be declared before the function that interpolates it (a forward reference
// there fails to lower).
const truststoreLinuxBundle: string = "/etc/ssl/certs/ca-certificates.crt"
const truststoreLinuxCertDir: string = "/etc/ssl/certs"

// Upper bound on directory entries scanned, so the fallback read is provably
// finite (Power of 10) even against a pathological directory.
const truststoreMaxDirEntries: int = 8192

// A set of trust-anchor certificates. `roots` is exported so a TLS client can
// hand the anchors straight to a lower-level verifier, or inspect them.
export struct TrustStore { export roots: []Certificate }

// Build a store from a PEM bundle: every `CERTIFICATE` block in `pem`, in order,
// parsed into a root. Strict — a block whose DER is not a well-formed
// certificate fails the whole parse — and fails if the input carries no
// certificate at all. Non-CERTIFICATE blocks (a stray CRL, a key) are ignored.
export function fromPem(pem: string): TrustStore! { return TrustStore{
  roots: truststoreParseStrict(pem)?,
} }

// Verify `leaf` up to one of this store's roots, through `intermediates`, for
// `hostname` at `nowUnix`. A thin delegation to `x509VerifyChain` with the
// store's anchors as the trusted roots: it fails with that function's specific
// error for the first problem found (hostname mismatch, expiry, a non-CA issuer,
// a broken signature, an unbuildable chain, a path-length violation).
export function (t: TrustStore) verifyChain(
  leaf: Certificate,
  intermediates: []Certificate,
  hostname: string,
  nowUnix: int,
): ()! { x509VerifyChain(leaf, intermediates, t.roots, hostname, nowUnix)? }

// The operating system's trust store. Linux: the distribution CA bundle, else
// the hashed-certificate directory. Any other OS fails with a clear error rather
// than silently trusting nothing — call `bundled()` there until native
// trust-store integration lands. The directory read is tolerant (an entry the
// parser cannot yet handle is skipped) so one odd certificate cannot sink the
// whole store; the single-file bundle is likewise read tolerantly.
export function systemRoots(): TrustStore! {
  if (exists(truststoreLinuxBundle)) {
    return TrustStore{ roots: truststoreParseTolerant(readFile(truststoreLinuxBundle)?) }
  }
  if (isDir(truststoreLinuxCertDir)) {
    return TrustStore{ roots: truststoreLoadDir(truststoreLinuxCertDir)? }
  }
  fail newError(
    "truststore: no system trust store found (looked for ${truststoreLinuxBundle} and ${truststoreLinuxCertDir}); on macOS and Windows call bundled() until native trust-store integration lands",
  )
}

// A store of a small, curated set of well-known public CA roots compiled into
// the binary — a working default when no system store is available. The embedded
// PEM is vetted at commit time and parsed by CI, so a parse failure here is a
// build-time invariant violation, not a runtime condition: it panics rather than
// return a silently empty (trust-nothing) store.
export function bundled(): TrustStore { return fromPem(truststoreBundledPem()) catch e {
  panic("truststore: embedded root bundle failed to parse: ${e.message()}")
  return TrustStore{ roots: []Certificate(0) }
} }

// --- system store directory read -------------------------------------------

// Every certificate under `dir` that the parser accepts. Each entry is read and
// parsed tolerantly: a non-PEM file, or a certificate the parser cannot yet
// handle, is skipped rather than failing the whole store. Hashed symlinks make a
// root appear more than once; duplicate anchors are harmless to verification.
function truststoreLoadDir(dir: string): []Certificate! {
  let names = readDir(dir)?
  let out = []Certificate(0)
  let i = 0
  while (i < len(names) && i < truststoreMaxDirEntries) {
    let path = join(dir, names[i])
    if (!isDir(path)) {
      let text = readFile(path) catch e {
        ""
      }
      for c of truststoreParseTolerant(text) {
        out = append(out, c)
      }
    }
    i = i + 1
  }
  return out
}

// --- PEM parsing -----------------------------------------------------------

// Every `CERTIFICATE` block in `pem`, parsed into a `Certificate` in order, or a
// failure on the first malformed block. Fails if no certificate is present.
function truststoreParseStrict(pem: string): []Certificate! {
  let blocks = pemDecode(pem)?
  let out = []Certificate(0)
  for b of blocks {
    if (b.label == "CERTIFICATE") {
      out = append(out, x509Parse(b.der)?)
    }
  }
  if (len(out) == 0) {
    fail newError("truststore: PEM input carries no CERTIFICATE block")
  }
  return out
}

// Every `CERTIFICATE` block in `pem` the parser accepts, skipping any it cannot
// (a malformed or unsupported certificate, or an unparseable body). Never fails:
// a heterogeneous system bundle must yield the roots it can, not nothing.
function truststoreParseTolerant(pem: string): []Certificate {
  let out = []Certificate(0)
  let blocks = pemDecode(pem) catch e {
    return out
  }
  for b of blocks {
    if (b.label == "CERTIFICATE") {
      let parsed = truststoreTryParse(b.der)
      if (len(parsed) == 1) {
        out = append(out, parsed[0])
      }
    }
  }
  return out
}

// A one-element slice with the parsed certificate, or empty if `der` is not a
// certificate the parser accepts — so a tolerant read can skip the odd entry
// without a loop-level `catch`.
function truststoreTryParse(der: []byte): []Certificate {
  let c = x509Parse(der) catch e {
    return []Certificate(0)
  }
  return append([]Certificate(0), c)
}

// --- bundled root set ------------------------------------------------------

// ponytail: a curated three-root subset of the Mozilla CA set — enough for a
// working default and the test, not the full ~150-cert bundle (that is a
// release-time data task). Source: https://curl.se/ca/cacert.pem (Mozilla's
// trust list, as packaged by curl). To refresh: download that file, copy the
// PEM body of the desired roots, and replace the base64 in the functions below;
// verify each still parses with `x509Parse`. The three chosen roots are
// long-lived, widely deployed anchors.
function truststoreBundledPem(): string { return truststoreIsrgRootX1() + truststoreDigicertGlobalG2() + truststoreAmazonRootCa1() }

// ISRG Root X1 — Internet Security Research Group (Let's Encrypt), RSA-4096,
// valid 2015-06-04 .. 2035-06-04.
function truststoreIsrgRootX1(): string { return "-----BEGIN CERTIFICATE-----\\n-----END CERTIFICATE-----\n" }

// DigiCert Global Root G2 — DigiCert Inc, RSA-2048, valid 2013-08-01 ..
// 2038-01-15.
function truststoreDigicertGlobalG2(): string { return "-----BEGIN CERTIFICATE-----\\n-----END CERTIFICATE-----\n" }

// Amazon Root CA 1 — Amazon, RSA-2048, valid 2015-05-26 .. 2038-01-17.
function truststoreAmazonRootCa1(): string { return "-----BEGIN CERTIFICATE-----\\n-----END CERTIFICATE-----\n" }
