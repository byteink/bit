// stdlib/crypto/x509chain.test.bit: `x509VerifyChain` path building when the peer
// sends its own self-signed CA after the leaf (#7786).
//
// RFC 5280 section 6.1: a path ends at a trust anchor the relying party chose.
// A self-signed certificate that is only in the peer's `intermediates` is not
// one, so the path stops there as untrusted; it must not loop on the
// certificate's own subject until the depth cap and report a length overflow.
//
// Fixtures: three throwaway P-256 keys under OpenSSL 4.0.3, valid 2026-10-10 ..
// 2036-10-07. `xcCaHex` is a self-signed CA (CN=Bit Chain Test CA), `xcOtherHex`
// an unrelated self-signed CA (CN=Bit Chain Unrelated CA), and `xcLeafHex` a leaf
// for the DNS name chain.test signed by the first CA.

const xcCaHex: string = ""
const xcOtherHex: string = ""
const xcLeafHex: string = ""
const xcNow: int = 1800000000

fn xcCert(h: string): Certificate {
  let der = decodeHex(h) catch e {
    panic("xcCert hex: ${e.message()}")
  }
  return x509Parse(der) catch e {
    panic("xcCert parse: ${e.message()}")
  }
}

// The verification error's message, or "" when the chain verified.
fn xcVerify(intermediates: []Certificate, roots: []Certificate): string {
  x509VerifyChain(xcCert(xcLeafHex), intermediates, roots, "chain.test", xcNow) catch e {
    return e.message()
  }
  return ""
}

test "a self-signed CA in the peer chain that is not a trust anchor is an untrusted root" {
  let got = xcVerify([xcCert(xcCaHex)], [xcCert(xcOtherHex)])
  assert(got == "x509: unable to build chain to a trusted root", "got '${got}'")
}

test "the same chain verifies when that CA is a trust anchor" {
  let got = xcVerify([xcCert(xcCaHex)], [xcCert(xcCaHex)])
  assert(got == "", "got '${got}'")
}

test "a leaf with no issuer anywhere is an untrusted root" {
  let got = xcVerify([]Certificate(0), [xcCert(xcOtherHex)])
  assert(got == "x509: unable to build chain to a trusted root", "got '${got}'")
}
