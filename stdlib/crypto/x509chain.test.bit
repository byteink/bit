// stdlib/crypto/x509chain.test.bit: `x509VerifyChain` path building when the peer
// sends its own self-signed CA after the leaf (#7786).
//
// RFC 5280 section 6.1: a path ends at a trust anchor the relying party chose.
// A self-signed certificate that is only in the peer's `intermediates` is not
// one, so the path stops there as untrusted; it must not loop on the
// certificate's own subject until the depth cap and report a length overflow.
//
// Fixtures: three throwaway P-256 keys under OpenSSL 4.0.3, valid 2026-10-10 ..
// 2036-10-07. `xcCaHex` is a self-signed CA (CN=Bit Chain Test CA), `xcOtherHex`
// an unrelated self-signed CA (CN=Bit Chain Unrelated CA), and `xcLeafHex` a leaf
// for the DNS name chain.test signed by the first CA.

const xcCaHex: string = ""
const xcOtherHex: string = ""
const xcLeafHex: string = ""
const xcNow: int = 1800000000

fn xcCert(h: string): Certificate {
  let der = decodeHex(h) catch e {
    panic("xcCert hex: ${e.message()}")
  }
  return x509Parse(der) catch e {
    panic("xcCert parse: ${e.message()}")
  }
}

// The verification error's message, or "" when the chain verified.
fn xcVerify(intermediates: []Certificate, roots: []Certificate): string {
  x509VerifyChain(xcCert(xcLeafHex), intermediates, roots, "chain.test", xcNow) catch e {
    return e.message()
  }
  return ""
}

test "a self-signed CA in the peer chain that is not a trust anchor is an untrusted root" {
  let got = xcVerify([xcCert(xcCaHex)], [xcCert(xcOtherHex)])
  assert(got == "x509: unable to build chain to a trusted root", "got '${got}'")
}

test "the same chain verifies when that CA is a trust anchor" {
  let got = xcVerify([xcCert(xcCaHex)], [xcCert(xcCaHex)])
  assert(got == "", "got '${got}'")
}

test "a leaf with no issuer anywhere is an untrusted root" {
  let got = xcVerify([]Certificate(0), [xcCert(xcOtherHex)])
  assert(got == "x509: unable to build chain to a trusted root", "got '${got}'")
}

fn xcPath(leaf: Certificate, intermediates: []Certificate, roots: []Certificate, at: int): string {
  x509VerifyPath(leaf, intermediates, roots, at) catch e {
    return e.message()
  }
  return ""
}

fn xcTls(leaf: Certificate, host: string): string {
  x509VerifyChain(leaf, []Certificate(0), [xcCert(xcCaHex)], host, xcNow) catch e {
    return e.message()
  }
  return ""
}

test "certificate path trust does not assert a DNS identity" {
  let ca = xcCert(xcCaHex)
  assert(len(ca.dnsNames) == 0, "the real CA fixture has no DNS identity")
  assert(
    xcPath(ca, []Certificate(0), [xcCert(xcCaHex)], xcNow) == "",
    "trusted path without a hostname",
  )
  assert(
    xcTls(ca, "chain.test") == "x509: certificate is not valid for hostname chain.test",
    "TLS still checks SAN",
  )
  assert(xcTls(xcCert(xcLeafHex), "other.test") != "", "TLS refuses the wrong hostname")
}

test "certificate path trust leaves the leaf purpose to its caller" {
  // Isolate the verifier's policy fields; DER parsing and signature checks
  // remain covered by the unmodified signed fixtures and invalid-signature control.
  let leaf = xcCert(xcLeafHex)
  leaf.hasExtKeyUsage = true
  leaf.extKeyUsageOids = ["1.3.6.1.5.5.7.3.3"]
  assert(
    xcPath(leaf, []Certificate(0), [xcCert(xcCaHex)], xcNow) == "",
    "a path alone has no TLS purpose",
  )
  assert(
    xcTls(leaf, "chain.test") == "x509: leaf certificate is not valid for server authentication",
    "TLS retains EKU policy",
  )
}

test "certificate path refuses missing and untrusted anchors" {
  let leaf = xcCert(xcLeafHex)
  assert(
      xcPath(leaf, []Certificate(0), []Certificate(0), xcNow) ==
      "x509: unable to build chain to a trusted root",
    "missing issuer",
  )
  assert(
      xcPath(leaf, [xcCert(xcCaHex)], [xcCert(xcOtherHex)], xcNow) ==
      "x509: unable to build chain to a trusted root",
    "peer CA is not an anchor",
  )
}

test "certificate path checks leaf and issuer validity" {
  let leaf = xcCert(xcLeafHex)
  assert(
      xcPath(leaf, []Certificate(0), [xcCert(xcCaHex)], leaf.notBefore - 1) ==
      "x509: certificate is not yet valid",
    "early leaf",
  )
  assert(
      xcPath(leaf, []Certificate(0), [xcCert(xcCaHex)], leaf.notAfter + 1) ==
      "x509: certificate has expired",
    "expired leaf",
  )
  let issuer = xcCert(xcCaHex)
  issuer.notAfter = xcNow - 1
  assert(
    xcPath(leaf, []Certificate(0), [issuer], xcNow) == "x509: certificate has expired",
    "expired issuer",
  )
}

test "certificate path checks signatures and issuer constraints" {
  let leaf = xcCert(xcLeafHex)
  leaf.signature[0] = leaf.signature[0] ^ 1
  assert(
      xcPath(leaf, []Certificate(0), [xcCert(xcCaHex)], xcNow) ==
      "x509: signature verification failed",
    "changed signature",
  )
  let issuer = xcCert(xcCaHex)
  issuer.isCa = false
  assert(
    xcPath(xcCert(xcLeafHex), []Certificate(0), [issuer], xcNow) == "x509: issuer is not a CA",
    "issuer basic constraints",
  )
  issuer = xcCert(xcCaHex)
  issuer.keyUsage = 0
  assert(
      xcPath(xcCert(xcLeafHex), []Certificate(0), [issuer], xcNow) ==
      "x509: issuer key usage does not permit certificate signing",
    "issuer key usage",
  )
}

test "certificate path checks critical extensions and DNS constraints" {
  let leaf = xcCert(xcLeafHex)
  leaf.unknownCriticalOids = ["1.2.3.4"]
  assert(
      xcPath(leaf, []Certificate(0), [xcCert(xcCaHex)], xcNow) ==
      "x509: unrecognized critical extension 1.2.3.4",
    "critical leaf extension",
  )
  let issuer = xcCert(xcCaHex)
  issuer.hasNameConstraints = true
  issuer.excludedDnsNames = ["chain.test"]
  assert(
      xcPath(xcCert(xcLeafHex), []Certificate(0), [issuer], xcNow) ==
      "x509: chain.test is excluded by a name constraint",
    "issuer DNS constraint",
  )
}

test "certificate path keeps the shared path length check" {
  // Policy-field controls build a two-issuer path using the same signed CA
  // key; only the path topology and constraint fields differ.
  let issuer = xcCert(xcCaHex)
  issuer.issuer = "root"
  let root = xcCert(xcCaHex)
  root.subject = "root"
  root.hasPathLen = true
  root.maxPathLen = 0
  let leaf = xcCert(xcLeafHex)
  assert(
    xcPath(leaf, [issuer], [root], xcNow) == "x509: path length constraint exceeded",
    "one intermediate exceeds zero",
  )
  root.maxPathLen = 1
  assert(xcPath(leaf, [issuer], [root], xcNow) == "", "one intermediate fits one")
}
