// stdlib/crypto/base32.test.bit — RFC 4648 §10's own base32 test vectors,
// exactly, plus the decode error paths `decodeBase32` documents.
//
// `ctEq` (subtle.bit) is this module's own byte-slice comparison — used
// here rather than `==`, which is not defined over `[]byte`.

fn decodeOk(s: string): []byte {
  let b = decodeBase32(s) catch e {
    panic("decodeBase32(\"${s}\"): ${e.message()}")
  }
  return b
}

test "encodeBase32: RFC 4648 §10 test vectors" {
  assert(encodeBase32([]byte("")) == "", "encodeBase32(\"\")")
  assert(encodeBase32([]byte("f")) == "MY======", "encodeBase32(\"f\")")
  assert(encodeBase32([]byte("fo")) == "MZXQ====", "encodeBase32(\"fo\")")
  assert(encodeBase32([]byte("foo")) == "MZXW6===", "encodeBase32(\"foo\")")
  assert(encodeBase32([]byte("foob")) == "MZXW6YQ=", "encodeBase32(\"foob\")")
  assert(encodeBase32([]byte("fooba")) == "MZXW6YTB", "encodeBase32(\"fooba\")")
  assert(
    encodeBase32([]byte("foobar")) == "MZXW6YTBOI======",
    "encodeBase32(\"foobar\")",
  )
}

test "decodeBase32: RFC 4648 §10 test vectors" {
  assert(ctEq(decodeOk(""), []byte("")), "decodeBase32(\"\")")
  assert(ctEq(decodeOk("MY======"), []byte("f")), "decodeBase32(\"MY======\")")
  assert(ctEq(decodeOk("MZXQ===="), []byte("fo")), "decodeBase32(\"MZXQ====\")")
  assert(ctEq(decodeOk("MZXW6==="), []byte("foo")), "decodeBase32(\"MZXW6===\")")
  assert(ctEq(decodeOk("MZXW6YQ="), []byte("foob")), "decodeBase32(\"MZXW6YQ=\")")
  assert(ctEq(decodeOk("MZXW6YTB"), []byte("fooba")), "decodeBase32(\"MZXW6YTB\")")
  assert(
    ctEq(decodeOk("MZXW6YTBOI======"), []byte("foobar")),
    "decodeBase32(\"MZXW6YTBOI======\")",
  )
}

test "decodeBase32(encodeBase32(b)) == b for arbitrary bytes" {
  let b = []byte{ 0, 1, 2, 253, 254, 255, 42, 7, 128, 199 }
  let decoded = decodeBase32(encodeBase32(b)) catch e {
    panic("round trip failed: ${e.message()}")
  }
  assert(ctEq(decoded, b), "round trip did not reproduce the input")
}

test "decodeBase32: rejects a length that is not a multiple of 8" {
  let result = decodeBase32("MY=====") catch _ {
    return
  }
  panic("decodeBase32(\"MY=====\") should have failed, got ${len(result)} bytes")
}

test "decodeBase32: rejects a character outside the alphabet" {
  let result = decodeBase32("0ZXQ====") catch _ {
    return
  }
  panic("decodeBase32 with a '0' should have failed, got ${len(result)} bytes")
}
