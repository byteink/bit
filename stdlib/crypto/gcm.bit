// Bit standard library — crypto module, AES-GCM authenticated encryption and its
// GHASH universal hash (NIST SP 800-38D).
//
// AES-GCM binds AES counter-mode confidentiality to a GHASH-based authentication
// tag in one pass, satisfying the `Aead` contract (aead.bit). `newGcm` keys it
// once — expanding the AES schedule and deriving the hash subkey H = AES_K(0) —
// and the returned `AesGcm` then seals and opens any number of messages under a
// 96-bit (12-byte) nonce, appending or checking a 16-byte tag.
//
// GHASH multiplies in GF(2^128) modulo the reversed polynomial x^128 + x^7 + x^2
// + x + 1. The field element is two big-endian `u64` words (word 0 = bytes 0..7,
// the field's low-order coefficients in GCM's bit-reversed convention), so the
// per-bit reduction constant is 0xe1 in the top byte.
//
// CONSTANT-TIME BY CONSTRUCTION. The multiply is a fixed 128-iteration shift-and-
// xor whose "add V" and "reduce after shift" decisions are all-ones/all-zeros
// masks, never branches on a data bit — deliberately NOT a precomputed table
// indexed by the (secret or attacker-chosen) block, which would leak through the
// data cache and timing. Tag verification uses the constant-time `ctEq`, and
// `open` fails before returning any plaintext when the tag does not match. The
// cost is speed; a PCLMULQDQ/PMULL hardware GHASH is a separate, later track.
//
// The 128-bit state lives in fixed two-element `[]u64` arrays and every step is a
// small helper, both for readability and to keep any one function's live-word set
// modest — 128-bit field math is otherwise a register-pressure trap.

// Load 8 bytes of `data` at `off` as a big-endian `u64`, treating any index past
// the end as a zero byte (the zero-padding GHASH applies to a final short block).
function gcmLoadWord(data: []byte, off: int): u64 {
  let w: u64 = 0
  let i = 0
  while (i < 8) {
    let b: u64 = 0
    if (off + i < len(data)) {
      b = u64(data[off + i])
    }
    w = (w << 8) | b
    i = i + 1
  }
  return w
}

// Store `w` as 8 big-endian bytes into `out` at `off`.
function gcmStoreWord(out: []byte, off: int, w: u64) {
  out[off] = byte(w >> 56)
  out[off + 1] = byte(w >> 48)
  out[off + 2] = byte(w >> 40)
  out[off + 3] = byte(w >> 32)
  out[off + 4] = byte(w >> 24)
  out[off + 5] = byte(w >> 16)
  out[off + 6] = byte(w >> 8)
  out[off + 7] = byte(w)
}

// Load a 16-byte block of `data` at `off` into a two-word field element, zero-
// padding past the end so a final partial block is framed exactly as GHASH needs.
function gcmLoadBlock(data: []byte, off: int): []u64 {
  let blk = []u64(2)
  blk[0] = gcmLoadWord(data, off)
  blk[1] = gcmLoadWord(data, off + 8)
  return blk
}

// Bit `i` of the field element `y` in GCM's bit order: bit 0 is the most
// significant bit of word 0, bit 127 the least significant bit of word 1. Used by
// the two-word GF helpers that back AES-GCM-SIV's POLYVAL (aesgcmsiv.bit); the
// AES-GCM hot path uses the allocation-free `gcmMulHWords` below.
function gcmBitAt(y: []u64, i: int): u64 {
  if (i < 64) {
    return (y[0] >> u64(63 - i)) & 1
  }
  return (y[1] >> u64(127 - i)) & 1
}

// Multiply the 128-bit big-endian value `v` by the field generator x, in place:
// shift right one bit and fold the reduction constant when a 1 fell off. Branchless.
function gcmShiftReduce(v: []u64) {
  let r: u64 = 0xe100000000000000
  let lsb = v[1] & 1
  v[1] = (v[1] >> 1) | (v[0] << 63)
  v[0] = v[0] >> 1
  let rmask = u64(0) - lsb
  v[0] = v[0] ^ (r & rmask)
}

// The GF(2^128) product x · y under GCM's reversed polynomial, as a fresh two-word
// element. Full 128 branchless bit-iterations, data-independent timing.
function gcmGfMul(x: []u64, y: []u64): []u64 {
  let z = []u64(2)
  let v = []u64(2)
  v[0] = x[0]
  v[1] = x[1]
  let i = 0
  while (i < 128) {
    let mask = u64(0) - gcmBitAt(y, i)
    z[0] = z[0] ^ (v[0] & mask)
    z[1] = z[1] ^ (v[1] & mask)
    gcmShiftReduce(v)
    i = i + 1
  }
  return z
}

// Absorb one two-word block into an accumulator: acc = (acc XOR block) · H. Mutates
// `acc`. Backs AES-GCM-SIV; the GCM hot path uses `gcmMulHWords`.
function gcmMulH(acc: []u64, block: []u64, h: []u64) {
  acc[0] = acc[0] ^ block[0]
  acc[1] = acc[1] ^ block[1]
  let p = gcmGfMul(acc, h)
  acc[0] = p[0]
  acc[1] = p[1]
}

// Absorb one block `(b0,b1)` into the GHASH accumulator: acc = (acc XOR block) · H,
// where H = `(h0,h1)`. The GF(2^128) product under GCM's reversed polynomial runs
// the full 128 bit-iterations every call, accumulating a masked copy of the
// running V wherever a bit of H is set — no branch on, or memory index by, any
// operand bit, so the timing is data-independent (the `i < 64` split is on the
// public loop counter). Operates entirely on `u64` locals — no per-block heap
// allocation, the previous two-word-array formulation's dominant cost — and
// writes the result back into the caller's two-word `acc`.
function gcmMulHWords(acc: []u64, b0: u64, b1: u64, h0: u64, h1: u64) {
  // R = 11100001 ‖ 0^120: 0xe1 in the top byte of word 0, the fold applied when a
  // 1 falls off the low end of V during the ×x shift.
  let r: u64 = 0xe100000000000000
  let v0 = acc[0] ^ b0
  let v1 = acc[1] ^ b1
  let z0: u64 = 0
  let z1: u64 = 0
  let i = 0
  while (i < 128) {
    let bit: u64 = 0
    if (i < 64) {
      bit = (h0 >> u64(63 - i)) & 1
    } else {
      bit = (h1 >> u64(127 - i)) & 1
    }
    let mask = u64(0) - bit
    z0 = z0 ^ (v0 & mask)
    z1 = z1 ^ (v1 & mask)
    // V *= x: shift the 128-bit V right one bit, fold R when a 1 fell off.
    let lsb = v1 & 1
    v1 = (v1 >> 1) | (v0 << 63)
    v0 = v0 >> 1
    let rmask = u64(0) - lsb
    v0 = v0 ^ (r & rmask)
    i = i + 1
  }
  acc[0] = z0
  acc[1] = z1
}

// Fold every 16-byte block of `data` (zero-padded final block) into `acc` under
// subkey `(h0,h1)`. Mutates `acc`. Words are loaded straight into `u64` locals, so
// no per-block block element is allocated.
function gcmAbsorb(acc: []u64, h0: u64, h1: u64, data: []byte) {
  let off = 0
  while (off < len(data)) {
    gcmMulHWords(acc, gcmLoadWord(data, off), gcmLoadWord(data, off + 8), h0, h1)
    off = off + 16
  }
}

// GHASH_H(aad, ct): fold the AAD blocks, then the ciphertext blocks, then a final
// block carrying the two 64-bit bit-lengths, and return the 128-bit result as a
// two-word element. This is GCM's authenticator input before the J0 mask.
function gcmGhash(h: []u64, aad: []byte, ct: []byte): []u64 {
  let acc = []u64(2)
  let h0 = h[0]
  let h1 = h[1]
  gcmAbsorb(acc, h0, h1, aad)
  gcmAbsorb(acc, h0, h1, ct)
  gcmMulHWords(acc, u64(len(aad)) * 8, u64(len(ct)) * 8, h0, h1)
  return acc
}

// The pre-counter block J0 for a 96-bit nonce: nonce ‖ 0x00000001.
function gcmJ0(nonce: []byte): []byte {
  let j0 = []byte(16)
  let i = 0
  while (i < 12) {
    j0[i] = nonce[i]
    i = i + 1
  }
  j0[15] = 1
  return j0
}

// inc32: increment the rightmost 32 bits of the 16-byte counter block modulo
// 2^32, in place — the carry stays within bytes 12..15 and never reaches the
// fixed nonce field, exactly as GCM's GCTR requires (not a full 128-bit add).
function gcmInc32(ctr: []byte) {
  let i = 15
  while (i >= 12) {
    let v: u8 = ctr[i] + 1
    ctr[i] = v
    if (v != 0) {
      return
    }
    i = i - 1
  }
}

// A fresh 16-byte copy of `src` (the first 16 bytes).
function gcmCopyBlock(src: []byte): []byte {
  let b = []byte(16)
  let i = 0
  while (i < 16) {
    b[i] = src[i]
    i = i + 1
  }
  return b
}

// GCTR keystream: encipher `icb`, inc32, encipher, ... and XOR the keystream into
// `data`, returning ciphertext of the same length. `icb` is not mutated (an
// internal counter copy advances instead), so the caller can reuse it. Handles a
// trailing partial block.
//
// The keystream runs through the bitsliced constant-time AES (aesct.bit), which
// enciphers four counter blocks at once — the bulk of GCM's cost, ~100x faster
// than the per-byte-inverse scalar block cipher. The round keys are bitsliced once
// here; the counter sequence is byte-for-byte the same as the scalar path (start
// at `icb`, `gcmInc32` per block), so ciphertext is unchanged. Lanes past the data
// end still get a valid (advanced) counter but their keystream is simply not used.
function gcmGctr(cipher: AesCipher, icb: []byte, data: []byte): []byte {
  let out = []byte(len(data))
  let sk = aesctExpandSkey(cipher.roundKeys, cipher.nr)
  let counter = gcmCopyBlock(icb)
  let blocks = []byte(64)
  let ks = []byte(64)
  let off = 0
  while (off < len(data)) {
    // Assemble the next four counter blocks, advancing exactly as the scalar
    // GCTR would (icb, icb+1, ... via inc32).
    let b = 0
    while (b < 4) {
      let bb = b * 16
      let j = 0
      while (j < 16) {
        blocks[bb + j] = counter[j]
        j = j + 1
      }
      gcmInc32(counter)
      b = b + 1
    }
    aesctKeystream4(sk, cipher.nr, blocks, ks)

    let n = len(data) - off
    if (n > 64) {
      n = 64
    }
    let k = 0
    while (k < n) {
      out[off + k] = data[off + k] ^ ks[k]
      k = k + 1
    }
    off = off + 64
  }
  return out
}

// Assemble the 16-byte tag: serialize the GHASH result `s` big-endian and XOR the
// J0 keystream block `ej0` = AES_K(J0) over it.
function gcmTag(s: []u64, ej0: []byte): []byte {
  let tag = []byte(16)
  gcmStoreWord(tag, 0, s[0])
  gcmStoreWord(tag, 8, s[1])
  let i = 0
  while (i < 16) {
    tag[i] = tag[i] ^ ej0[i]
    i = i + 1
  }
  return tag
}

// A keyed AES-GCM cipher. `cipher` is the expanded AES schedule; `h` is the hash
// subkey H = AES_K(0^128) as a two-word field element, derived once at
// construction and reused by every `seal`/`open`. Build one with `newGcm`.
export struct AesGcm {
  cipher: AesCipher
  h: []u64
}

// Key an AES-GCM cipher from `key` (16, 24, or 32 bytes — AES-128/192/256, the
// GCM/TLS variants). Fails on any other key length. The hash subkey H is derived
// here by enciphering a zero block, so it is computed once and shared by all
// later operations under this key.
export function newGcm(key: []byte): AesGcm! {
  let cipher = newAes(key)?
  let zero = []byte(16)
  let hb = cipher.encryptBlock(zero)
  return AesGcm{ cipher: cipher, h: gcmLoadBlock(hb, 0) }
}

// Seal: encrypt `plaintext` under the 12-byte `nonce` and authenticate both it
// and `aad`, returning ciphertext with the 16-byte tag appended (so the result is
// `len(plaintext) + 16` bytes). The **nonce must be unique per key** — reuse is
// catastrophic for GCM (it leaks the authentication subkey H). A wrong nonce
// length is a caller error and panics.
export function (g: AesGcm) seal(nonce: []byte, plaintext: []byte, aad: []byte): []byte {
  assert(len(nonce) == 12, "gcm.seal: nonce must be 12 bytes")
  let j0 = gcmJ0(nonce)
  let ej0 = g.cipher.encryptBlock(j0)

  let counter0 = gcmCopyBlock(j0)
  gcmInc32(counter0)
  let ct = gcmGctr(g.cipher, counter0, plaintext)

  let tag = gcmTag(gcmGhash(g.h, aad, ct), ej0)

  let out = []byte(len(ct) + 16)
  let i = 0
  while (i < len(ct)) {
    out[i] = ct[i]
    i = i + 1
  }
  let k = 0
  while (k < 16) {
    out[len(ct) + k] = tag[k]
    k = k + 1
  }
  return out
}

// Open: verify and decrypt `ciphertext` (the sealed `ct ‖ tag`) under the 12-byte
// `nonce` and `aad`. Recomputes the tag, compares it to the trailing 16 bytes in
// constant time, and FAILS on any mismatch — a tampered message, or a wrong key,
// nonce, or `aad` — without returning the plaintext. Also fails if the input is
// shorter than the 16-byte tag. A wrong nonce length is a caller error and panics.
export function (g: AesGcm) open(nonce: []byte, ciphertext: []byte, aad: []byte): []byte! {
  assert(len(nonce) == 12, "gcm.open: nonce must be 12 bytes")
  if (len(ciphertext) < 16) {
    fail newError("gcm.open: ciphertext shorter than the 16-byte tag")
  }
  let ctLen = len(ciphertext) - 16
  let ct = ciphertext[0:ctLen]
  let recvTag = ciphertext[ctLen:len(ciphertext)]

  let j0 = gcmJ0(nonce)
  let ej0 = g.cipher.encryptBlock(j0)
  let wantTag = gcmTag(gcmGhash(g.h, aad, ct), ej0)
  if (!ctEq(wantTag, recvTag)) {
    fail newError("gcm.open: authentication failed")
  }

  let counter0 = gcmCopyBlock(j0)
  gcmInc32(counter0)
  return gcmGctr(g.cipher, counter0, ct)
}

// The required nonce length in bytes: 12 (96-bit), the GCM/TLS standard.
export function (g: AesGcm) nonceSize(): int { return 12 }

// The number of bytes `seal` appends: the 16-byte authentication tag.
export function (g: AesGcm) overhead(): int { return 16 }
