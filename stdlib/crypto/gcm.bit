// Bit standard library — crypto module, AES-GCM authenticated encryption and its
// GHASH universal hash (NIST SP 800-38D).
//
// AES-GCM binds AES counter-mode confidentiality to a GHASH-based authentication
// tag in one pass, satisfying the `Aead` contract (aead.bit). `AesGcm(key)` keys it
// once — expanding the AES schedule and deriving the hash subkey H = AES_K(0) —
// and the returned `AesGcm` then seals and opens any number of messages under a
// 96-bit (12-byte) nonce, appending or checking a 16-byte tag.
//
// GHASH multiplies in GF(2^128) modulo the reversed polynomial x^128 + x^7 + x^2
// + x + 1. The field element is two big-endian `u64` words (word 0 = bytes 0..7,
// the field's low-order coefficients in GCM's bit-reversed convention), so the
// per-bit reduction constant is 0xe1 in the top byte.
//
// CONSTANT-TIME BY CONSTRUCTION. The multiply is a fixed 128-iteration shift-and-
// xor whose "add V" and "reduce after shift" decisions are all-ones/all-zeros
// masks, never branches on a data bit — deliberately NOT a precomputed table
// indexed by the (secret or attacker-chosen) block, which would leak through the
// data cache and timing. Tag verification uses the constant-time `ctEq`, and
// `open` fails before returning any plaintext when the tag does not match. The
// cost is speed; a PCLMULQDQ/PMULL hardware GHASH is a separate, later track.
//
// The 128-bit state lives in fixed two-element `[]u64` arrays and every step is a
// small helper, both for readability and to keep any one function's live-word set
// modest — 128-bit field math is otherwise a register-pressure trap.
//
// HARDWARE FAST PATH (task #1223). `gcmMulHWords` calls PCLMULQDQ through
// `runtime/cryptohw/cryptohw.bit` when `bit_rt_crypto_ghash_hw_available()`
// reports it, else runs the constant-time shift-and-xor above unchanged; `gcmGctr`
// similarly prefers `aes.bit`'s `encryptBlockInto` over the bitsliced software
// keystream — GCM's real bulk cost — whenever `encryptBlockInto` itself would
// take a hardware route: `cipher.hw` (the ARM64 Crypto Extension, decided once
// at key setup in `Aes.init`) or `bit_rt_crypto_aes_hw_available()` (x86-64
// AES-NI, `runtime/cryptohw/x64aes.bit`, #7390). Either GCTR runs through the
// multi-block `bit_rt_crypto_aes_ctr32_hw` (#7397 on arm64). `aes.bit` already
// declared `bit_rt_crypto_aes_hw_available` (siblings share one module, so it
// needs no re-declaration here); see that file and ABI.md §21b.
extern fn bit_rt_crypto_ghash_hw_available(): bool
extern fn bit_rt_crypto_aes_ctr32_hw(rk: *byte, ctr: *byte, src: *byte, dst: *byte, blocks: int)
extern fn bit_rt_crypto_ghash_mul_hw(
  acc0: uint,
  acc1: uint,
  b0: uint,
  b1: uint,
  h0: uint,
  h1: uint,
  outHi: *uint,
): uint

// ARM64 HARDWARE FAST PATH (#2527, epic #1224), separate from the x86-64 family
// above: `bit_rt_ghash_hw_keys`/`bit_rt_ghash_hw_blocks_keyed` (`runtime/
// cryptohw/armghash.bit`, #2523, #7460) run the ARMv8 Cryptographic
// Extension's PMULL/PMULL2 carry-less multiply, gated on `hwPmull()` (`hw.bit`) rather than on
// `bit_rt_crypto_ghash_hw_available()` — a disjoint capability, disjoint
// runtime primitive, checked once when `AesGcm` is constructed (`AesGcm(key)`) and
// cached in `AesGcm.pmull`, the same "read once, not per block" contract
// `Aes.hw` already uses for AES. `gcmGhashHw` below is the hardware
// mirror of `gcmGhashSw`'s exact recurrence (`state = (state XOR block) * H`,
// once per 16-byte block, AAD then ciphertext then the length block) and is
// the oracle-checked alternative, never a replacement — `gcmGhashSw` is
// unchanged and still runs whenever `hwPmull()` is false (`BIT_CRYPTO_HW=0`,
// or a CPU with no PMULL/PCLMULQDQ). On x86-64 the same two pins run
// PCLMULQDQ (`runtime/cryptohw/x64ghash.bit`, #7385). The key table (H's
// powers) is built once, into `AesGcm.hk`, and every fold reads it there.
extern fn bit_rt_ghash_hw_keys(h: *byte, keys: *byte, keysLen: int)
extern fn bit_rt_ghash_hw_blocks_keyed(keys: *byte, state: *byte, data: *byte, blocks: u64)

// The key-table buffer `bit_rt_ghash_hw_keys` fills, the runtime's
// `ghashHwKeysLen`; the runtime panics on a shorter one.
const gcmHwKeysLen: int = 304

// Load 8 bytes of `data` at `off` as a big-endian `u64`, treating any index past
// the end as a zero byte (the zero-padding GHASH applies to a final short block).
fn gcmLoadWord(data: []byte, off: int): u64 {
  let w: u64 = 0
  let i = 0
  while (i < 8) {
    let b: u64 = 0
    if (off + i < len(data)) {
      b = u64(data[off + i])
    }
    w = (w << 8) | b
    i = i + 1
  }
  return w
}

// Store `w` as 8 big-endian bytes into `out` at `off`.
fn gcmStoreWord(out: []byte, off: int, w: u64) {
  out[off] = byte(w >> 56)
  out[off + 1] = byte(w >> 48)
  out[off + 2] = byte(w >> 40)
  out[off + 3] = byte(w >> 32)
  out[off + 4] = byte(w >> 24)
  out[off + 5] = byte(w >> 16)
  out[off + 6] = byte(w >> 8)
  out[off + 7] = byte(w)
}

// Load a 16-byte block of `data` at `off` into a two-word field element, zero-
// padding past the end so a final partial block is framed exactly as GHASH needs.
fn gcmLoadBlock(data: []byte, off: int): []u64 {
  let blk = []u64(2)
  blk[0] = gcmLoadWord(data, off)
  blk[1] = gcmLoadWord(data, off + 8)
  return blk
}

// Bit `i` of the field element `y` in GCM's bit order: bit 0 is the most
// significant bit of word 0, bit 127 the least significant bit of word 1. Used by
// the two-word GF helpers that back AES-GCM-SIV's POLYVAL (aesgcmsiv.bit); the
// AES-GCM hot path uses the allocation-free `gcmMulHWords` below.
fn gcmBitAt(y: []u64, i: int): u64 {
  if (i < 64) {
    return (y[0] >> u64(63 - i)) & 1
  }
  return (y[1] >> u64(127 - i)) & 1
}

// Multiply the 128-bit big-endian value `v` by the field generator x, in place:
// shift right one bit and fold the reduction constant when a 1 fell off. Branchless.
fn gcmShiftReduce(v: []u64) {
  let r: u64 = 0xe100000000000000
  let lsb = v[1] & 1
  v[1] = (v[1] >> 1) | (v[0] << 63)
  v[0] = v[0] >> 1
  let rmask = u64(0) - lsb
  v[0] = v[0] ^ (r & rmask)
}

// The GF(2^128) product x · y under GCM's reversed polynomial, as a fresh two-word
// element. Full 128 branchless bit-iterations, data-independent timing.
fn gcmGfMul(x: []u64, y: []u64): []u64 {
  let z = []u64(2)
  let v = []u64(2)
  v[0] = x[0]
  v[1] = x[1]
  let i = 0
  while (i < 128) {
    let mask = u64(0) - gcmBitAt(y, i)
    z[0] = z[0] ^ (v[0] & mask)
    z[1] = z[1] ^ (v[1] & mask)
    gcmShiftReduce(v)
    i = i + 1
  }
  return z
}

// Absorb one two-word block into an accumulator: acc = (acc XOR block) · H. Mutates
// `acc`. Backs AES-GCM-SIV; the GCM hot path uses `gcmMulHWords`.
fn gcmMulH(acc: []u64, block: []u64, h: []u64) {
  acc[0] = acc[0] ^ block[0]
  acc[1] = acc[1] ^ block[1]
  let p = gcmGfMul(acc, h)
  acc[0] = p[0]
  acc[1] = p[1]
}

// Absorb one block `(b0,b1)` into the GHASH accumulator: acc = (acc XOR block) · H,
// where H = `(h0,h1)`. The GF(2^128) product under GCM's reversed polynomial runs
// the full 128 bit-iterations every call, accumulating a masked copy of the
// running V wherever a bit of H is set — no branch on, or memory index by, any
// operand bit, so the timing is data-independent (the `i < 64` split is on the
// public loop counter). Operates entirely on `u64` locals — no per-block heap
// allocation, the previous two-word-array formulation's dominant cost — and
// writes the result back into the caller's two-word `acc`.
fn gcmMulHWords(acc: []u64, b0: u64, b1: u64, h0: u64, h1: u64) {
  if (bit_rt_crypto_ghash_hw_available()) {
    let outHi = []uint(1)
    let lo = bit_rt_crypto_ghash_mul_hw(acc[0], acc[1], b0, b1, h0, h1, ptrOf(outHi))
    acc[0] = outHi[0]
    acc[1] = lo
    return
  }

  // R = 11100001 ‖ 0^120: 0xe1 in the top byte of word 0, the fold applied when a
  // 1 falls off the low end of V during the ×x shift.
  let r: u64 = 0xe100000000000000
  let v0 = acc[0] ^ b0
  let v1 = acc[1] ^ b1
  let z0: u64 = 0
  let z1: u64 = 0
  let i = 0
  while (i < 128) {
    let bit: u64 = 0
    if (i < 64) {
      bit = (h0 >> u64(63 - i)) & 1
    } else {
      bit = (h1 >> u64(127 - i)) & 1
    }
    let mask = u64(0) - bit
    z0 = z0 ^ (v0 & mask)
    z1 = z1 ^ (v1 & mask)
    // V *= x: shift the 128-bit V right one bit, fold R when a 1 fell off.
    let lsb = v1 & 1
    v1 = (v1 >> 1) | (v0 << 63)
    v0 = v0 >> 1
    let rmask = u64(0) - lsb
    v0 = v0 ^ (r & rmask)
    i = i + 1
  }
  acc[0] = z0
  acc[1] = z1
}

// Fold every 16-byte block of `data` (zero-padded final block) into `acc` under
// subkey `(h0,h1)`. Mutates `acc`. Words are loaded straight into `u64` locals, so
// no per-block block element is allocated.
fn gcmAbsorb(acc: []u64, h0: u64, h1: u64, data: []byte) {
  let off = 0
  while (off < len(data)) {
    gcmMulHWords(acc, gcmLoadWord(data, off), gcmLoadWord(data, off + 8), h0, h1)
    off = off + 16
  }
}

// GHASH_H(aad, ct): fold the AAD blocks, then the ciphertext blocks, then a final
// block carrying the two 64-bit bit-lengths, and return the 128-bit result as a
// two-word element. This is GCM's authenticator input before the J0 mask.
fn gcmGhashSw(h: []u64, aad: []byte, ct: []byte): []u64 {
  let acc = []u64(2)
  let h0 = h[0]
  let h1 = h[1]
  gcmAbsorb(acc, h0, h1, aad)
  gcmAbsorb(acc, h0, h1, ct)
  gcmMulHWords(acc, u64(len(aad)) * 8, u64(len(ct)) * 8, h0, h1)
  return acc
}

// Fold every full 16-byte block of `data[0:n]` directly from the caller's
// buffer into `state` under the key table `hk`, then zero-pad any trailing
// partial block into the caller's 16-byte `spare` and fold it the same way —
// the hardware mirror of `gcmAbsorb`, one `state = (state XOR block) * H`
// step per block. `n` (at most `len(data)`) is passed rather than resliced
// because a reslice allocates a header (#7487).
fn gcmAbsorbHw(hk: []byte, state: []byte, data: []byte, n: int, spare: []byte) {
  let full = n / 16
  if (full > 0) {
    bit_rt_ghash_hw_blocks_keyed(ptrOf(hk), ptrOf(state), ptrOf(data), u64(full))
  }
  let rem = n - full * 16
  if (rem > 0) {
    let i = 0
    while (i < 16) {
      spare[i] = 0
      if (i < rem) {
        spare[i] = data[full * 16 + i]
      }
      i = i + 1
    }
    bit_rt_ghash_hw_blocks_keyed(ptrOf(hk), ptrOf(state), ptrOf(spare), 1)
  }
  keepAlive(hk)
  keepAlive(state)
  keepAlive(data)
  keepAlive(spare)
}

// GHASH_H(aad, ct[0:n]) into the 16-byte `s`, the hardware carry-less-multiply
// mirror of `gcmGhashSw`: same recurrence, checked against it by the
// differential in _tests_/imports/cryptogcm. Folds AAD then the ciphertext
// (each independently block-padded, per GCM's own definition), then the
// length block from `w.spare`, all via `bit_rt_ghash_hw_blocks_keyed` under
// the key table `hk`, into `w.s`. `w` is caller scratch, so the call
// allocates nothing of its own.
fn gcmGhashHw(w: gcmScratch, hk: []byte, aad: []byte, ct: []byte, n: int) {
  let s = w.s
  let spare = w.spare
  let i = 0
  while (i < 16) {
    s[i] = 0
    i = i + 1
  }
  gcmAbsorbHw(hk, s, aad, len(aad), spare)
  gcmAbsorbHw(hk, s, ct, n, spare)
  gcmStoreWord(spare, 0, u64(len(aad)) * 8)
  gcmStoreWord(spare, 8, u64(n) * 8)
  bit_rt_ghash_hw_blocks_keyed(ptrOf(hk), ptrOf(s), ptrOf(spare), 1)
  keepAlive(hk)
  keepAlive(spare)
  keepAlive(s)
}

// GHASH_H(aad, ct[0:n]) into `w.s`: the ARM64 PMULL hardware path when
// `g.pmull` is true (read once at construction), else the constant-time
// software path. Both compute the identical NIST SP 800-38D value; see
// `gcmGhashHw`'s header for the correctness argument.
fn gcmGhash(w: gcmScratch, g: AesGcm, aad: []byte, ct: []byte, n: int) {
  if (g.pmull) {
    gcmGhashHw(w, g.hk, aad, ct, n)
    return
  }
  let acc = gcmGhashSw(g.h, aad, ct[0:n])
  gcmStoreWord(w.s, 0, acc[0])
  gcmStoreWord(w.s, 8, acc[1])
}

// The pre-counter block J0 for a 96-bit nonce, nonce ‖ 0x00000001, into the
// 16-byte `j0`.
fn gcmJ0Into(j0: []byte, nonce: []byte) {
  let i = 0
  while (i < 12) {
    j0[i] = nonce[i]
    i = i + 1
  }
  j0[12] = 0
  j0[13] = 0
  j0[14] = 0
  j0[15] = 1
}

// inc32: increment the rightmost 32 bits of the 16-byte counter block modulo
// 2^32, in place — the carry stays within bytes 12..15 and never reaches the
// fixed nonce field, exactly as GCM's GCTR requires (not a full 128-bit add).
fn gcmInc32(ctr: []byte) {
  let i = 15
  while (i >= 12) {
    let v: u8 = ctr[i] + 1
    ctr[i] = v
    if (v != 0) {
      return
    }
    i = i - 1
  }
}

// `j0` advanced by one counter step into `ctr`: the first GCTR counter block,
// J0 + 1 under inc32.
fn gcmCounterAfter(ctr: []byte, j0: []byte) {
  let i = 0
  while (i < 16) {
    ctr[i] = j0[i]
    i = i + 1
  }
  gcmInc32(ctr)
}

// GCTR over `data[off:]` into `out[off:]` one hardware block call per counter
// block, `w.spare` holding each keystream block: the trailing partial block of
// the hardware route. `off` is passed rather than resliced because a reslice
// allocates a header (#7487). Arguments otherwise as `gcmGctrInto`.
fn gcmGctrBlocks(out: []byte, cipher: Aes, w: gcmScratch, data: []byte, off: int) {
  let counter = w.ctr
  let ks = w.spare
  while (off < len(data)) {
    cipher.encryptBlockInto(ks, counter)
    gcmInc32(counter)
    let n = len(data) - off
    if (n > 16) {
      n = 16
    }
    let k = 0
    while (k < n) {
      out[off + k] = data[off + k] ^ ks[k]
      k = k + 1
    }
    off = off + 16
  }
}

// GCTR on hardware AES (x86-64 AES-NI, or the ARM64 Crypto Extension when
// `cipher.hw`): every full block in one `bit_rt_crypto_aes_ctr32_hw` call,
// which pipelines several counter blocks per round key and XORs in the same
// pass, then the trailing partial block through `gcmGctrBlocks`. Arguments
// as `gcmGctrInto`; `w.ctr` is advanced in place, and since it is the first
// 16 bytes of the CTR block `w.blk` the runtime advances, no copy back.
fn gcmGctrHw(out: []byte, cipher: Aes, w: gcmScratch, data: []byte) {
  let full = len(data) / 16
  if (full > 0) {
    w.blk[16] = byte(cipher.nr)
    bit_rt_crypto_aes_ctr32_hw(ptrOf(cipher.roundKeys), ptrOf(w.blk), ptrOf(data), ptrOf(out), full)
    keepAlive(w.blk)
  }
  let off = full * 16
  if (off < len(data)) {
    gcmGctrBlocks(out, cipher, w, data, off)
  }
  keepAlive(cipher.roundKeys)
  keepAlive(data)
  keepAlive(out)
}

// GCTR keystream into `out` (its first `len(data)` bytes; `out` may be
// longer): encipher `w.ctr`, inc32, encipher, ... and XOR the keystream into
// `data`. `w.ctr` is the caller's initial counter block and is ADVANCED in
// place; `w.spare` is keystream scratch for the hardware route. `out` may be
// `data` itself: each byte is read before the same index is written. Handles
// a trailing partial block.
//
// Without a hardware route the keystream runs through the bitsliced
// constant-time AES (aesct.bit), which enciphers four counter blocks at once —
// ~100x faster than the per-byte-inverse scalar block cipher. The counter
// sequence is byte-for-byte the same as the scalar path (start at `w.ctr`,
// `gcmInc32` per block), so ciphertext is unchanged. Lanes past the data end
// still get a valid (advanced) counter but their keystream is simply not used.
fn gcmGctrInto(out: []byte, cipher: Aes, w: gcmScratch, data: []byte) {
  if (cipher.hw || bit_rt_crypto_aes_hw_available()) {
    gcmGctrHw(out, cipher, w, data)
    return
  }
  let counter = w.ctr

  let sk = aesctExpandSkey(cipher.roundKeys, cipher.nr)
  let blocks = []byte(64)
  let ks4 = []byte(64)
  let off = 0
  while (off < len(data)) {
    // Assemble the next four counter blocks, advancing exactly as the scalar
    // GCTR would (icb, icb+1, ... via inc32).
    let b = 0
    while (b < 4) {
      let bb = b * 16
      let j = 0
      while (j < 16) {
        blocks[bb + j] = counter[j]
        j = j + 1
      }
      gcmInc32(counter)
      b = b + 1
    }
    aesctKeystream4(sk, cipher.nr, blocks, ks4)

    let n = len(data) - off
    if (n > 64) {
      n = 64
    }
    let k = 0
    while (k < n) {
      out[off + k] = data[off + k] ^ ks4[k]
      k = k + 1
    }
    off = off + 64
  }
}

// Whether GCM's GHASH runs on a hardware carry-less multiply on this host
// (PCLMULQDQ on x86-64, PMULL on arm64; `hwPmull()`, the flag `AesGcm`
// caches) rather than the constant-time shift-and-xor software path — a
// diagnostic query, like `hwAvailableAes` (aes.bit); the dispatch itself is
// transparent.
export fn hwAvailableGhash(): bool {
  return hwPmull()
}

// The work area one `sealInto`/`openInto` uses, views carved once from one
// 88-byte buffer: J0, AES_K(J0), the GHASH state (then the tag), one spare
// block (keystream, padded tail, length block), and `blk`, the 24-byte CTR
// block `bit_rt_crypto_aes_ctr32_hw` reads and advances (counter ‖ round
// count as a little-endian word), whose first 16 bytes are the running
// counter `ctr`. A reslice allocates a header, so carving per call cost
// more than the buffer (#7487); an `AesGcm` keeps one and lends it out, and
// `owned` marks that one.
class gcmScratch {
  owned: bool,
  j0: []byte,
  ej0: []byte,
  s: []byte,
  spare: []byte,
  blk: []byte,
  ctr: []byte,
}

fn gcmScratchNew(owned: bool): gcmScratch {
  let w = []byte(88)
  let blk = w[64:88]
  return gcmScratch{
    owned = owned, j0 = w[0:16], ej0 = w[16:32], s = w[32:48], spare = w[48:64], blk = blk, ctr = blk[0:16],
  }
}

// The key's own scratch when no other call holds it, else a fresh one, so
// concurrent `seal`/`open` calls on one shared `AesGcm` never share a work
// area. The holder is exclusive between a successful claim of `g.busy` and
// `gcmScratchGive`, so the lazy first build of `g.work` cannot race.
fn gcmScratchTake(g: AesGcm): gcmScratch {
  if (!atomicCmpxchg(ptrOf(g.busy), 0, 1)) {
    return gcmScratchNew(false)
  }
  if (len(g.work) == 0) {
    g.work = [gcmScratchNew(true)]
  }
  return g.work[0]
}

// Release `w` if it is `g`'s own (`gcmScratchTake`); a fresh one is garbage.
fn gcmScratchGive(g: AesGcm, w: gcmScratch) {
  if (w.owned) {
    atomicStore(ptrOf(g.busy), 0)
  }
}

// The plaintext length of a sealed `ciphertext`: its length less the 16-byte
// tag, or 0 when it is too short to carry one (`openInto` then fails).
fn gcmPlainLen(ciphertext: []byte): int {
  if (len(ciphertext) < 16) {
    return 0
  }
  return len(ciphertext) - 16
}

// A keyed AES-GCM cipher. `cipher` is the expanded AES schedule; `h` is the hash
// subkey H = AES_K(0^128) as a two-word field element and `hk` the hardware
// GHASH's key table built from it (#7460; empty without the hardware path),
// both derived once at construction and reused by every `seal`/`open`.
// `pmull` caches `hwPmull()` (#2527) — whether GHASH takes the hardware
// carry-less multiply — read once here rather than once per block. `work`
// holds, once the first call builds it, the scratch every uncontended call
// borrows while `busy` (one atomic word) is 1 (`gcmScratchTake`, #7487), so
// sharing an `AesGcm` between threads stays safe. Build one with
// `AesGcm(key)`.
export class AesGcm {
  cipher: Aes
  h: []u64
  hk: []byte
  pmull: bool
  busy: []i64
  work: []gcmScratch

  // Key an AES-GCM cipher from `key` (16, 24, or 32 bytes — AES-128/192/256, the
  // GCM/TLS variants). Fails on any other key length. The hash subkey H is derived
  // here by enciphering a zero block, so it is computed once and shared by all
  // later operations under this key.
  init(key: []byte)! {
    this.cipher = Aes(key)?
    let hb = this.cipher.encryptBlock([]byte(16))
    this.h = gcmLoadBlock(hb, 0)
    this.pmull = hwPmull()
    this.busy = []i64(1)
    this.hk = []byte(0)
    if (this.pmull) {
      this.hk = []byte(gcmHwKeysLen)
      bit_rt_ghash_hw_keys(ptrOf(hb), ptrOf(this.hk), len(this.hk))
      keepAlive(hb)
      keepAlive(this.hk)
    }
  }

  // Seal: encrypt `plaintext` under the 12-byte `nonce` and authenticate both it
  // and `aad`, returning ciphertext with the 16-byte tag appended (so the result is
  // `len(plaintext) + 16` bytes). The **nonce must be unique per key** — reuse is
  // catastrophic for GCM (it leaks the authentication subkey H). A wrong nonce
  // length is a caller error and panics.
  export seal(nonce: []byte, plaintext: []byte, aad: []byte): []byte {
    let out = []byte(len(plaintext) + 16)
    this.sealInto(out, nonce, plaintext, aad)
    return out
  }

  // `seal` writing `ciphertext ‖ tag` into the caller's `dst`, which must be
  // exactly `len(plaintext) + 16` bytes, instead of a fresh slice; `plaintext`
  // may be `dst[0:len(plaintext)]` to seal in place. Same nonce rules and
  // panics as `seal`.
  export sealInto(dst: []byte, nonce: []byte, plaintext: []byte, aad: []byte) {
    assert(len(nonce) == 12, "gcm.seal: nonce must be 12 bytes")
    let n = len(plaintext)
    assert(len(dst) == n + 16, "gcm.sealInto: dst must be len(plaintext) + 16 bytes")
    let w = gcmScratchTake(this)
    gcmJ0Into(w.j0, nonce)
    this.cipher.encryptBlockInto(w.ej0, w.j0)
    gcmCounterAfter(w.ctr, w.j0)
    gcmGctrInto(dst, this.cipher, w, plaintext)
    gcmGhash(w, this, aad, dst, n)
    let k = 0
    while (k < 16) {
      dst[n + k] = w.s[k] ^ w.ej0[k]
      k = k + 1
    }
    gcmScratchGive(this, w)
  }

  // Open: verify and decrypt `ciphertext` (the sealed `ct ‖ tag`) under the 12-byte
  // `nonce` and `aad`. Recomputes the tag, compares it to the trailing 16 bytes in
  // constant time, and FAILS on any mismatch — a tampered message, or a wrong key,
  // nonce, or `aad` — without returning the plaintext. Also fails if the input is
  // shorter than the 16-byte tag. A wrong nonce length is a caller error and panics.
  export open(nonce: []byte, ciphertext: []byte, aad: []byte): []byte! {
    let out = []byte(gcmPlainLen(ciphertext))
    this.openInto(out, nonce, ciphertext, aad)?
    return out
  }

  // `open` writing the plaintext into the caller's `dst`, which must be exactly
  // `len(ciphertext) - 16` bytes, instead of a fresh slice; `dst` may be
  // `ciphertext[0:len(ciphertext) - 16]` to open in place. The tag is checked
  // in constant time BEFORE a single byte of `dst` is written, so a failed open
  // leaves `dst` untouched and never exposes unauthenticated plaintext. Same
  // failures and panics as `open`.
  export openInto(dst: []byte, nonce: []byte, ciphertext: []byte, aad: []byte): ()! {
    assert(len(nonce) == 12, "gcm.open: nonce must be 12 bytes")
    if (len(ciphertext) < 16) {
      fail newError("gcm.open: ciphertext shorter than the 16-byte tag")
    }
    let n = len(ciphertext) - 16
    assert(len(dst) == n, "gcm.openInto: dst must be len(ciphertext) - 16 bytes")
    let ct = ciphertext[0:n]
    let w = gcmScratchTake(this)
    gcmJ0Into(w.j0, nonce)
    this.cipher.encryptBlockInto(w.ej0, w.j0)
    gcmGhash(w, this, aad, ct, n)
    let k = 0
    while (k < 16) {
      w.s[k] = w.s[k] ^ w.ej0[k]
      k = k + 1
    }
    if (!ctEq(w.s, ciphertext[n:len(ciphertext)])) {
      gcmScratchGive(this, w)
      fail newError("gcm.open: authentication failed")
    }
    gcmCounterAfter(w.ctr, w.j0)
    gcmGctrInto(dst, this.cipher, w, ct)
    gcmScratchGive(this, w)
  }

  // The required nonce length in bytes: 12 (96-bit), the GCM/TLS standard.
  export nonceSize(): int { return 12 }

  // The number of bytes `seal` appends: the 16-byte authentication tag.
  export overhead(): int { return 16 }
}

