// Bit standard library — crypto module, the AES block cipher (FIPS 197).
//
// AES-128, AES-192, and AES-256: the same round structure keyed by a 16-, 24-,
// or 32-byte key (10, 12, or 14 rounds). `newAes` expands the key once; the
// returned `AesCipher` then enciphers or deciphers any number of 16-byte blocks
// with `encryptBlock`/`decryptBlock`. This is the raw block primitive — a single
// 128-bit permutation with no chaining or padding. A mode of operation (CBC,
// CTR, GCM) sits on top of it; do not encrypt more than one block of real data
// under ECB semantics.
//
// CONSTANT-TIME BY CONSTRUCTION. The classic S-box is a 256-byte table indexed
// by a secret byte, which leaks the byte through the data cache. This module has
// no such table: `sbox`/`invSbox` compute the multiplicative inverse in GF(2^8)
// arithmetically (Fermat: x^254 == x^-1, since x^255 == 1 for x != 0), built
// from a branchless GF multiply, then apply the affine map with rotates and
// XORs. Every operation's control flow and memory access is independent of the
// data, so there is no key- or plaintext-dependent timing. The cost is speed —
// each S-box is ~13 field multiplies rather than one load. Hardware AES-NI /
// ARMv8 crypto acceleration is a separate, later track; this is the portable
// reference every target shares.
//
// All byte math is `u8`, so shifts and adds wrap mod 2^8 exactly as the field
// requires (§13.5). The reduction polynomial is AES's x^8 + x^4 + x^3 + x + 1
// (0x11b), whose reduction byte is 0x1b.
//
// HARDWARE FAST PATH (task #1223). `encryptBlockInto`/`decryptBlock` call
// AES-NI through `runtime/cryptohw/cryptohw.bit` when
// `bit_rt_crypto_aes_hw_available()` reports it, else run the software
// rounds above unchanged. The dispatch
// branches on a cached CPU-capability flag only (never on key or plaintext
// bytes — ABI.md §21b), so it introduces no new timing channel; the software
// path stays the one every target without AES-NI (including every ARM64
// build) uses, and stays exactly as constant-time as documented above. The
// extern's Bit-side identifier IS the linker symbol verbatim (SPEC.md §11.7
// — no aliasing), hence the un-camelCased names below.
extern fn bit_rt_crypto_aes_hw_available(): bool
extern fn bit_rt_crypto_aes_encrypt_hw(rk: *byte, nr: int, block: *byte, out: *byte)
extern fn bit_rt_crypto_aes_decrypt_hw(drk: *byte, nr: int, block: *byte, out: *byte)
extern fn bit_rt_crypto_aes_invert_schedule_hw(erk: *byte, nr: int, out: *byte)

// ARM64 HARDWARE FAST PATH (#2526, epic #1224, over #2522's ARMv8
// Cryptographic Extension primitives in `runtime/cryptohw/armaes.bit`).
// Unlike the x86-64 path above, this one is decided ONCE, at cipher creation
// (`aesNewCipher`), not per block: `AesCipher.hw` caches whether
// `hwAes()` (`hw.bit`, itself reading `BIT_CRYPTO_HW`/`bit_rt_crypto_hwcaps`
// exactly once and caching that too) was true for a key size the hardware
// path supports. `bit_rt_aes_hw_expand_key` only accepts a 128- or 256-bit
// key (AES-192 panics inside it — see `armaes.bit`'s header), so `aesNewCipher`
// gates on `keyBits` as well as `hwAes()`; a 24-byte key always takes the
// software schedule below regardless of hardware support. `hwAes()` is false
// on every non-ARM64 target (`bit_rt_crypto_hwcaps` is hard-wired to 0 on
// x86-64, ABI.md §21c), so `AesCipher.hw` is never true where
// `bit_rt_aes_hw_encrypt_block`/`_decrypt_block` would no-op under their own
// `onX64()` guard.
extern fn bit_rt_aes_hw_expand_key(key: *byte, keyBits: int, roundKeys: *byte)
extern fn bit_rt_aes_hw_encrypt_block(roundKeys: *byte, rounds: int, blockIn: *byte, out: *byte)
extern fn bit_rt_aes_hw_decrypt_block(roundKeys: *byte, rounds: int, blockIn: *byte, out: *byte)

// Branchless GF(2^8) multiply of `a` and `b` under the AES polynomial. Runs the
// full 8-bit shift-and-add every call; the "add this partial product" and
// "reduce after the shift" decisions are folded into all-ones/all-zeros masks
// (`u8(0) - bit`) rather than branches, so the timing never depends on the
// operands. Both are secret in the S-box, so this must not branch on either.
fn gmul(a: u8, b: u8): u8 {
  let product: u8 = 0
  let x = a
  let y = b
  let i = 0
  while (i < 8) {
    let addMask: u8 = u8(0) - (y & 1)
    product = product ^ (x & addMask)
    let carry: u8 = (x >> 7) & 1
    let reduceMask: u8 = u8(0) - carry
    x = (x << 1) ^ (0x1b & reduceMask)
    y = y >> 1
    i = i + 1
  }
  return product
}

// Multiply `a` by 2 in GF(2^8): shift left, conditionally reduce by 0x1b when a
// bit carried out of bit 7. Branchless via the same mask trick. The multiplier
// is public (always 2), but the operand is secret in MixColumns, so this stays
// data-independent too.
fn xtime(a: u8): u8 {
  let carry: u8 = (a >> 7) & 1
  let reduceMask: u8 = u8(0) - carry
  return (a << 1) ^ (0x1b & reduceMask)
}

// The multiplicative inverse of `x` in GF(2^8), with inverse(0) defined as 0.
// Since the non-zero elements form a group of order 255, x^255 == 1 and thus
// x^254 == x^-1; 0^254 == 0 falls out for free. The exponent 254 = 0b11111110
// is reached by squaring up to x^128 and multiplying the seven even powers —
// a fixed 13-multiply addition chain, identical work for every input.
fn gInverse(x: u8): u8 {
  let p2 = gmul(x, x)
  let p4 = gmul(p2, p2)
  let p8 = gmul(p4, p4)
  let p16 = gmul(p8, p8)
  let p32 = gmul(p16, p16)
  let p64 = gmul(p32, p32)
  let p128 = gmul(p64, p64)
  let r = gmul(p2, p4)
  r = gmul(r, p8)
  r = gmul(r, p16)
  r = gmul(r, p32)
  r = gmul(r, p64)
  r = gmul(r, p128)
  return r
}

// Rotate the byte `x` left by `n` bits (1..7). The two shifted halves cover
// disjoint bit positions, so the `|` reassembles the rotation.
fn rotl8(x: u8, n: u8): u8 {
  return (x << n) | (x >> (8 - n))
}

// The AES S-box: GF(2^8) inverse followed by the affine map. The affine map
// b ^ (b<<<1) ^ (b<<<2) ^ (b<<<3) ^ (b<<<4) ^ 0x63 (rotates on 8 bits) is the
// compact form of FIPS 197 §5.1.1's bit matrix.
fn sbox(x: u8): u8 {
  let b = gInverse(x)
  return b ^ rotl8(b, 1) ^ rotl8(b, 2) ^ rotl8(b, 3) ^ rotl8(b, 4) ^ 0x63
}

// The inverse S-box: the inverse affine map rotl(s,1) ^ rotl(s,3) ^ rotl(s,6) ^
// 0x05 (FIPS 197 §5.3.2) followed by the same GF(2^8) inverse.
fn invSbox(x: u8): u8 {
  let b = rotl8(x, 1) ^ rotl8(x, 3) ^ rotl8(x, 6) ^ 0x05
  return gInverse(b)
}

// Products by the fixed InvMixColumns coefficients {9, 11, 13, 14}, each built
// from the doubling chain x, 2x, 4x, 8x. Public multipliers, secret operand;
// xtime is branchless, so these are constant-time.
fn mul9(x: u8): u8 {
  let x2 = xtime(x)
  let x4 = xtime(x2)
  let x8 = xtime(x4)
  return x8 ^ x
}
fn mul11(x: u8): u8 {
  let x2 = xtime(x)
  let x4 = xtime(x2)
  let x8 = xtime(x4)
  return x8 ^ x2 ^ x
}
fn mul13(x: u8): u8 {
  let x2 = xtime(x)
  let x4 = xtime(x2)
  let x8 = xtime(x4)
  return x8 ^ x4 ^ x
}
fn mul14(x: u8): u8 {
  let x2 = xtime(x)
  let x4 = xtime(x2)
  let x8 = xtime(x4)
  return x8 ^ x4 ^ x2
}

// Expand `key` (nk 32-bit words) into the round-key schedule: nb*(nr+1) = 4*(nr+1)
// words, laid out as bytes. FIPS 197 §5.2. Every fourth word (every nk-th for
// 256-bit keys, plus the extra SubWord) passes through the S-box, so the schedule
// is as key-dependent — and as constant-time — as the cipher itself.
fn expandKey(key: []byte, nk: int, nr: int): []byte {
  let total = 16 * (nr + 1)
  let rk = []byte(total)
  let nk4 = nk * 4

  let i = 0
  while (i < nk4) {
    rk[i] = key[i]
    i = i + 1
  }

  // The round constant RC[j] = x^(j-1) in GF(2^8); it starts at 1 and doubles
  // each time the key-schedule core fires. It is public (never key-dependent).
  let rcon: u8 = 1
  let temp = []byte(4)
  let n = nk4
  while (n < total) {
    temp[0] = rk[n - 4]
    temp[1] = rk[n - 3]
    temp[2] = rk[n - 2]
    temp[3] = rk[n - 1]

    let pos = n % nk4
    if (pos == 0) {
      // RotWord, then SubWord, then XOR the round constant into byte 0.
      let t = temp[0]
      temp[0] = sbox(temp[1]) ^ rcon
      temp[1] = sbox(temp[2])
      temp[2] = sbox(temp[3])
      temp[3] = sbox(t)
      rcon = xtime(rcon)
    } else if (nk > 6 && pos == 16) {
      // 256-bit keys apply an extra SubWord at the word four in from the core.
      temp[0] = sbox(temp[0])
      temp[1] = sbox(temp[1])
      temp[2] = sbox(temp[2])
      temp[3] = sbox(temp[3])
    }

    let base = n - nk4
    let j = 0
    while (j < 4) {
      rk[n] = rk[base + j] ^ temp[j]
      n = n + 1
      j = j + 1
    }
  }
  return rk
}

// XOR the 16 bytes of round key `round` into the state, in place (AddRoundKey).
fn addRoundKey(s: []byte, rk: []byte, round: int) {
  let off = round * 16
  let i = 0
  while (i < 16) {
    s[i] = s[i] ^ rk[off + i]
    i = i + 1
  }
}

// SubBytes / InvSubBytes: apply the S-box (or its inverse) to all 16 bytes.
fn subBytes(s: []byte) {
  let i = 0
  while (i < 16) {
    s[i] = sbox(s[i])
    i = i + 1
  }
}

fn invSubBytes(s: []byte) {
  let i = 0
  while (i < 16) {
    s[i] = invSbox(s[i])
    i = i + 1
  }
}

// ShiftRows: cyclically left-shift row r by r bytes. The state is column-major
// (byte 4*c+r is row r, column c), so row r lives at indices r, r+4, r+8, r+12.
fn shiftRows(s: []byte) {
  let t = s[1]
  s[1] = s[5]
  s[5] = s[9]
  s[9] = s[13]
  s[13] = t
  t = s[2]
  s[2] = s[10]
  s[10] = t
  t = s[6]
  s[6] = s[14]
  s[14] = t
  t = s[15]
  s[15] = s[11]
  s[11] = s[7]
  s[7] = s[3]
  s[3] = t
}

// InvShiftRows: cyclically right-shift row r by r bytes (undoes ShiftRows).
fn invShiftRows(s: []byte) {
  let t = s[13]
  s[13] = s[9]
  s[9] = s[5]
  s[5] = s[1]
  s[1] = t
  t = s[2]
  s[2] = s[10]
  s[10] = t
  t = s[6]
  s[6] = s[14]
  s[14] = t
  t = s[3]
  s[3] = s[7]
  s[7] = s[11]
  s[11] = s[15]
  s[15] = t
}

// MixColumns: multiply each column by the fixed matrix [2 3 1 1 / 1 2 3 1 /
// 1 1 2 3 / 3 1 1 2] over GF(2^8). 2*x is xtime(x); 3*x is xtime(x) ^ x.
fn mixColumns(s: []byte) {
  let c = 0
  while (c < 4) {
    let i = c * 4
    let a0 = s[i]
    let a1 = s[i + 1]
    let a2 = s[i + 2]
    let a3 = s[i + 3]
    s[i] = xtime(a0) ^ (xtime(a1) ^ a1) ^ a2 ^ a3
    s[i + 1] = a0 ^ xtime(a1) ^ (xtime(a2) ^ a2) ^ a3
    s[i + 2] = a0 ^ a1 ^ xtime(a2) ^ (xtime(a3) ^ a3)
    s[i + 3] = xtime(a0) ^ a0 ^ a1 ^ a2 ^ xtime(a3)
    c = c + 1
  }
}

// InvMixColumns: multiply each column by the inverse matrix [14 11 13 9 / ...].
fn invMixColumns(s: []byte) {
  let c = 0
  while (c < 4) {
    let i = c * 4
    let a0 = s[i]
    let a1 = s[i + 1]
    let a2 = s[i + 2]
    let a3 = s[i + 3]
    s[i] = mul14(a0) ^ mul11(a1) ^ mul13(a2) ^ mul9(a3)
    s[i + 1] = mul9(a0) ^ mul14(a1) ^ mul11(a2) ^ mul13(a3)
    s[i + 2] = mul13(a0) ^ mul9(a1) ^ mul14(a2) ^ mul11(a3)
    s[i + 3] = mul11(a0) ^ mul13(a1) ^ mul9(a2) ^ mul14(a3)
    c = c + 1
  }
}

// Whether `encryptBlockInto`/`decryptBlock` are taking the AES-NI hardware
// path on this host (task #1223) rather than the software rounds above — a
// diagnostic query (e.g. for a program to log which path it is running),
// not something calling code needs to branch on: the dispatch is transparent.
export fn hwAvailableAes(): bool {
  return bit_rt_crypto_aes_hw_available()
}

// A key-scheduled AES cipher. `roundKeys` is the flattened schedule (16*(nr+1)
// bytes) and `nr` the round count (10, 12, or 14). `hw` caches, once, whether
// this cipher's block calls take the ARM64 hardware path (see the "ARM64
// HARDWARE FAST PATH" comment above `bit_rt_aes_hw_expand_key`) — neither
// field is exported, so this is invisible outside the module. Build one with
// `newAes`, not a class literal — the constructor validates the key length,
// picks the schedule path, and expands it. One value ciphers any number of
// blocks.
export class AesCipher {
  roundKeys: []byte
  nr: int
  hw: bool
  // Encipher one 16-byte `block`, returning a fresh 16-byte ciphertext block. The
  // input must be exactly 16 bytes. This is the bare block permutation with no
  // chaining — use a mode of operation for multi-block messages.
  export encryptBlock(block: []byte): []byte {
    let s = []byte(16)
    this.encryptBlockInto(s, block)
    return s
  }

  // Encipher `block` into the caller-owned 16-byte `dst`, in place. Identical to
  // `encryptBlock` but reuses `dst`, so a hot loop (GCTR keystream) can encipher
  // many blocks with no per-block allocation. `dst` and `block` must not alias.
  export encryptBlockInto(dst: []byte, block: []byte) {
    assert(len(dst) == 16, "aes.encryptBlockInto: dst must be 16 bytes")
    assert(len(block) == 16, "aes.encryptBlockInto: block must be 16 bytes")

    if (this.hw) {
      bit_rt_aes_hw_encrypt_block(ptrOf(this.roundKeys), this.nr, ptrOf(block), ptrOf(dst))
      return
    }

    if (bit_rt_crypto_aes_hw_available()) {
      bit_rt_crypto_aes_encrypt_hw(ptrOf(this.roundKeys), this.nr, ptrOf(block), ptrOf(dst))
      return
    }

    let i = 0
    while (i < 16) {
      dst[i] = block[i]
      i = i + 1
    }

    addRoundKey(dst, this.roundKeys, 0)
    let round = 1
    while (round < this.nr) {
      subBytes(dst)
      shiftRows(dst)
      mixColumns(dst)
      addRoundKey(dst, this.roundKeys, round)
      round = round + 1
    }
    // The last round omits MixColumns.
    subBytes(dst)
    shiftRows(dst)
    addRoundKey(dst, this.roundKeys, this.nr)
  }

  // Decipher one 16-byte `block`, returning a fresh 16-byte plaintext block. The
  // inverse of `encryptBlock` under the same key: `decryptBlock(encryptBlock(b))`
  // == b. The input must be exactly 16 bytes.
  export decryptBlock(block: []byte): []byte {
    assert(len(block) == 16, "aes.decryptBlock: block must be 16 bytes")
    let s = []byte(16)

    if (this.hw) {
      // Unlike the AES-NI path below, `bit_rt_aes_hw_decrypt_block` takes the
      // FORWARD schedule `c.roundKeys` directly and derives the inverse
      // schedule itself, once per call (`armaes.bit`'s `decRoundKeySchedule`)
      // — no separate invert-schedule step needed on this side.
      bit_rt_aes_hw_decrypt_block(ptrOf(this.roundKeys), this.nr, ptrOf(block), ptrOf(s))
      return s
    }

    if (bit_rt_crypto_aes_hw_available()) {
      // AES-NI decrypt needs the AESIMC-transformed schedule, not the forward
      // one `c.roundKeys` holds — derive it fresh each call (cheap: `nr - 1`
      // AESIMC instructions against the actual per-block decrypt cost, and
      // `decryptBlock` is not GCM's hot path, which never calls it).
      let decRoundKeys = []byte(16 * (this.nr + 1))
      bit_rt_crypto_aes_invert_schedule_hw(ptrOf(this.roundKeys), this.nr, ptrOf(decRoundKeys))
      bit_rt_crypto_aes_decrypt_hw(ptrOf(decRoundKeys), this.nr, ptrOf(block), ptrOf(s))
      return s
    }

    let i = 0
    while (i < 16) {
      s[i] = block[i]
      i = i + 1
    }

    addRoundKey(s, this.roundKeys, this.nr)
    let round = this.nr - 1
    while (round > 0) {
      invShiftRows(s)
      invSubBytes(s)
      addRoundKey(s, this.roundKeys, round)
      invMixColumns(s)
      round = round - 1
    }
    // The last (first, in decryption order) round omits InvMixColumns.
    invShiftRows(s)
    invSubBytes(s)
    addRoundKey(s, this.roundKeys, 0)
    return s
  }
}

// Expand `key` into a keyed cipher for the given (`nk` 32-bit words, `nr`
// rounds, `keyBits` = 8*len(key)) variant, taking the ARM64 hardware key
// schedule when `hwAes()` is true and `keyBits` is one `bit_rt_aes_hw_expand_key`
// supports (128 or 256 — AES-192 always uses the software schedule). Shared by
// `newAes` and `aesgcmsivCipher` (aesgcmsiv.bit) so the hardware/software
// decision lives in exactly one place.
fn aesNewCipher(key: []byte, nk: int, nr: int, keyBits: int): AesCipher {
  if (hwAes() && (keyBits == 128 || keyBits == 256)) {
    let total = 16 * (nr + 1)
    let rk = []byte(total)
    bit_rt_aes_hw_expand_key(ptrOf(key), keyBits, ptrOf(rk))
    return AesCipher{ roundKeys: rk, nr: nr, hw: true }
  }
  return AesCipher{ roundKeys: expandKey(key, nk, nr), nr: nr, hw: false }
}

// Build an AES cipher from `key`, whose length selects the variant: 16 bytes
// (AES-128), 24 (AES-192), or 32 (AES-256). Fails on any other length. The key
// schedule is expanded once here and reused by every `encryptBlock`/
// `decryptBlock` call.
export fn newAes(key: []byte): AesCipher! {
  let n = len(key)
  if (n == 16) {
    return aesNewCipher(key, 4, 10, 128)
  }
  if (n == 24) {
    return aesNewCipher(key, 6, 12, 192)
  }
  if (n == 32) {
    return aesNewCipher(key, 8, 14, 256)
  }
  fail newError("newAes: key must be 16, 24, or 32 bytes, got ${n}")
}

