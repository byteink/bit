// Bit standard library — crypto module, `Nat` modular exponentiation.
//
// The in-place limb helpers and the two `base^exp mod mod` entry points; the
// Montgomery context they drive is `./bigintmont.bit`. Sibling of
// `./bigint.bit`, same module (SPEC §17.1) —
// `Nat`, `bigintMake`, `bigintMinInt`, `bigintFromU64`, `bigintIsZero`,
// `bigintCmp`, `bigintMod`, `bigintMul`, `bigintSqr` and `bigintBitLen` are
// all visible here with no import, the flat `std/crypto` arrangement this
// module's other files use. Split out to keep `./bigint.bit` under
// `_tests_/bit/lintfilelines.bit`'s 800-line gate (E0200); every declaration
// below only calls earlier `bigint*` primitives, so there is no ordering
// question, only a diagnostic-order one the differentials would catch.
//
// Montgomery code operates on limb slices of a fixed width `k = len(modulus)`,
// which may carry high zero limbs (so it is deliberately *not* normalized). This
// keeps every operation constant-width, a prerequisite for constant time.

// `n`'s limbs zero-extended (or, where the caller guarantees it fits, truncated)
// to exactly `k` limbs.
fn bigintWiden(n: Nat, k: int): []u32 {
  let out = []u32(k)
  let src = bigintMinInt(len(n.limbs), k)
  let i = 0
  while (i < src) {
    out[i] = n.limbs[i]
    i = i + 1
  }
  return out
}

// The fixed-width representation of one: `[1, 0, ..., 0]` of length `k`.
fn bigintOneWidth(k: int): []u32 {
  let out = []u32(k)
  out[0] = 1
  return out
}

// Subtract `n` from the `k`-limb value `hi:x` in place when `hi:x >= n`, where
// `hi` is the single overflow bit (0 or 1) and `hi:x < 2n`. The borrow of
// `x - n` is computed first without storing, then `n & mask` is subtracted, so
// both passes run whether or not the subtraction was needed: no branch and no
// memory access depends on the value. The constant-time core of every
// Montgomery step below.
fn bigintCondSub(x: []u32, hi: u32, n: []u32) {
  let k = len(n)
  let borrow: u64 = 0
  let i = 0
  while (i < k) {
    let d = u64(x[i]) + 0x100000000 - u64(n[i]) - borrow
    borrow = 1 - (d >> 32)
    i = i + 1
  }
  // hi:x >= n  iff  the overflow bit is set OR the subtraction did not borrow.
  let mask = u32(0) - (hi | (1 - u32(borrow)))
  borrow = 0
  i = 0
  while (i < k) {
    let d = u64(x[i]) + 0x100000000 - u64(n[i] & mask) - borrow
    x[i] = u32(d & 0xffffffff)
    borrow = 1 - (d >> 32)
    i = i + 1
  }
}

// `out = (a + b) mod n`, for `a, b < n` of width `len(n)`. Each limb of `out`
// is written only after `a` and `b` are read at that index, so `out` may alias
// either operand.
fn bigintModAddTo(out: []u32, a: []u32, b: []u32, n: []u32) {
  let carry: u64 = 0
  let i = 0
  while (i < len(n)) {
    let s = u64(a[i]) + u64(b[i]) + carry
    out[i] = u32(s & 0xffffffff)
    carry = s >> 32
    i = i + 1
  }
  bigintCondSub(out, u32(carry), n)
}

// `out = (a - b) mod n`, for `a, b < n` of width `len(n)`: subtract, then add
// back `n & mask` where the mask is all-ones exactly on a borrow. `out` may
// alias either operand, as in `bigintModAddTo`.
fn bigintModSubTo(out: []u32, a: []u32, b: []u32, n: []u32) {
  let borrow: u64 = 0
  let i = 0
  while (i < len(n)) {
    let d = u64(a[i]) + 0x100000000 - u64(b[i]) - borrow
    out[i] = u32(d & 0xffffffff)
    borrow = 1 - (d >> 32)
    i = i + 1
  }
  let mask = u32(0) - u32(borrow)
  let carry: u64 = 0
  i = 0
  while (i < len(n)) {
    let s = u64(out[i]) + u64(n[i] & mask) + carry
    out[i] = u32(s & 0xffffffff)
    carry = s >> 32
    i = i + 1
  }
}

// ---------------------------------------------------------------------------
// Modular exponentiation
// ---------------------------------------------------------------------------

// `base^exp mod mod` by *constant-time* fixed-window Montgomery exponentiation
// (`bigintMontExpTo`), for an odd modulus. Every 4-bit exponent window drives
// four squarings, a masked table scan and one multiply, so the operation
// sequence — and thus the timing — is identical for every exponent of a given
// bit length. This is the path secret exponents (RSA `d`, ECDSA nonces) must
// take. `expBitLen` fixes how many bits are scanned.
fn bigintModExpMont(baseReduced: Nat, exp: Nat, modN: Nat, expBitLen: int): Nat {
  let c = bigintMontNew(modN)
  let k = len(modN.limbs)
  let out = bigintWiden(baseReduced, k)
  bigintMontExpTo(c, out, out, exp.limbs, expBitLen)
  return bigintMake(out)
}

// `base^exp mod mod` by variable-time square-and-multiply. Faster for small or
// public exponents (e.g. the RSA public exponent 65537), but it branches on the
// exponent bits, so it must never be used with a secret exponent. Also the
// fallback for an even modulus, where Montgomery reduction does not apply.
fn bigintModExpVartime(base: Nat, exp: Nat, modN: Nat): Nat! {
  let result = bigintFromU64(1)
  let b = bigintMod(base, modN)?
  let bitLen = bigintBitLen(exp)
  let i = 0
  while (i < bitLen) {
    if (((exp.limbs[i / 32] >> u32(i % 32)) & 1) == 1) {
      result = bigintMod(bigintMul(result, b), modN)?
    }
    b = bigintMod(bigintSqr(b), modN)?
    i = i + 1
  }
  return result
}

// `base^exp mod mod`, defaulting to the constant-time Montgomery exponentiation
// so it is safe for secret exponents. Fails on a zero modulus. `mod == 1` gives
// 0 and a zero exponent gives 1. An even modulus cannot use Montgomery
// reduction, so it falls back to variable-time square-and-multiply (even moduli do not arise in
// the public-key settings where exponent secrecy matters).
export fn bigintModExp(base: Nat, exp: Nat, modN: Nat): Nat! {
  if (bigintIsZero(modN)) {
    fail newError("bigintModExp: zero modulus")
  }
  let one = bigintFromU64(1)
  if (bigintCmp(modN, one) == 0) {
    return bigintZero()
  }
  if (bigintIsZero(exp)) {
    return one
  }
  let baseReduced = bigintMod(base, modN)?
  if ((modN.limbs[0] & 1) == 0) {
    return bigintModExpVartime(baseReduced, exp, modN)?
  }
  return bigintModExpMont(baseReduced, exp, modN, bigintBitLen(exp))
}

// `base^exp mod mod` optimized for a *public* exponent: variable-time
// square-and-multiply, which does no multiply on a zero exponent bit. Use only
// when the exponent is not secret (RSA verification/encryption). Fails on a zero
// modulus.
export fn bigintModExpPublic(base: Nat, exp: Nat, modN: Nat): Nat! {
  if (bigintIsZero(modN)) {
    fail newError("bigintModExpPublic: zero modulus")
  }
  if (bigintCmp(modN, bigintFromU64(1)) == 0) {
    return bigintZero()
  }
  if ((modN.limbs[0] & 1) == 0) {
    return bigintModExpVartime(base, exp, modN)?
  }
  let k = len(modN.limbs)
  let c = bigintMontNew(modN)
  let out = bigintWiden(base, k)
  if (bigintCmp(base, modN) >= 0) {
    bigintMontReduceTo(c, out, base.limbs)
  }
  bigintMontPowPublicTo(c, out, out, exp)
  return bigintMake(out)
}
