// Bit standard library — crypto/base32 module (RFC 4648 §6).
//
// Base32 turns arbitrary bytes into a 33-character ASCII text alphabet, five
// input bytes per eight output characters — the encoding TOTP secrets
// (RFC 6238, `pkg/auth`'s `totp.bit`) are provisioned in, since it needs no
// case-sensitive transcription and a user can read or type it without the
// `+`/`/` of base64. Only the standard alphabet ships here (RFC 4648 has no
// URL-safe base32 variant to mirror `base64.bit`'s pair).
//
// The bit math runs over `int` (`byte` values promote implicitly), accumulating
// input bits 8 at a time and draining 5-bit symbols as they become available —
// `decodeBase32` runs the same accumulator in reverse, 5 bits in and 8-bit bytes
// out. Decoding validates every character against a reverse table and the
// padded length against the five valid symbol-count remainders (0, 2, 4, 5, 7 of
// 8); anything else fails rather than returning a guess.

// RFC 4648 §6's 32-symbol alphabet: A-Z then 2-7 (0, 1, 8, 9 are skipped —
// easily confused with O, I, B, S when handwritten or read aloud).
const base32Alphabet: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"

// Encode `b` with the standard alphabet and `=` padding to a multiple of 8
// characters (RFC 4648 §6).
export fn encodeBase32(b: []byte): string {
  let alpha = []byte(base32Alphabet)
  let n = len(b)
  if (n == 0) {
    return ""
  }

  // ceil(n*8/5) symbols before padding, then rounded up to a multiple of 8.
  let symLen = (n * 8 + 4) / 5
  let olen = (symLen + 7) / 8 * 8

  let out = []byte(olen)
  let di = 0
  let acc = 0
  let accBits = 0
  let bi = 0
  while (bi < n) {
    acc = (acc << 8) | int(b[bi])
    accBits = accBits + 8
    bi = bi + 1
    while (accBits >= 5) {
      accBits = accBits - 5
      out[di] = alpha[(acc >> accBits) & 31]
      di = di + 1
    }
  }
  if (accBits > 0) {
    out[di] = alpha[(acc << (5 - accBits)) & 31]
    di = di + 1
  }
  while (di < olen) {
    out[di] = '='
    di = di + 1
  }
  return string(out)
}

// The reverse map for `base32Alphabet`: each alphabet byte -> its 5-bit value,
// every other byte -> -1. Mirrors `base64.bit`'s `base64RevMap`.
fn base32RevMap(): []i64 {
  let rev = []i64(256)
  let i = 0
  while (i < 256) {
    rev[i] = -1
    i = i + 1
  }
  let alpha = []byte(base32Alphabet)
  i = 0
  while (i < 32) {
    rev[int(alpha[i])] = i
    i = i + 1
  }
  return rev
}

// The decoded byte count for `rem` significant symbols in a final 8-symbol
// group (`rem` in `[0, 8)`; `rem == 8` never reaches this — a full group has
// no padding to strip). Only 0, 2, 4, 5 and 7 are symbol counts a valid
// RFC 4648 encoding produces; the other three (1, 3, 6) fail.
fn base32RemBytes(rem: int): int! {
  if (rem == 0) {
    return 0
  }
  if (rem == 2) {
    return 1
  }
  if (rem == 4) {
    return 2
  }
  if (rem == 5) {
    return 3
  }
  if (rem == 7) {
    return 4
  }
  fail newError("base32: invalid input length")
}

// Decode a standard, `=`-padded base32 string (RFC 4648 §6). Fails on a
// character outside the alphabet, a length that is not a multiple of 8, or a
// final group whose symbol count no valid encoding produces.
export fn decodeBase32(s: string): []byte! {
  let n = len(s)
  if (n == 0) {
    return []byte(0)
  }
  if (n % 8 != 0) {
    fail newError("base32: input length must be a multiple of 8")
  }

  // Strip trailing '=' padding to find the significant symbol count.
  let m = n
  while (m > 0 && s[m - 1] == '=') {
    m = m - 1
  }
  let extra = base32RemBytes(m % 8)?
  let olen = m / 8 * 5 + extra

  let rev = base32RevMap()
  let out = []byte(olen)
  let di = 0
  let acc = 0
  let accBits = 0
  let i = 0
  while (i < m) {
    let v = rev[int(s[i])]
    if (v < 0) {
      fail newError("base32: invalid character")
    }
    acc = (acc << 5) | v
    accBits = accBits + 5
    i = i + 1
    if (accBits >= 8) {
      accBits = accBits - 8
      out[di] = byte((acc >> accBits) & 255)
      di = di + 1
    }
  }
  return out
}
