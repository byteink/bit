// Bit standard library — crypto/pem module (RFC 7468).
//
// PEM is the textual wrapper that carries DER-encoded cryptographic objects —
// certificates, public and private keys, CSRs — as ASCII. Each object is one
// *block*:
//
//   -----BEGIN <label>-----
//   <base64 of the DER, wrapped at 64 columns>
//   -----END <label>-----
//
// where `<label>` names the object type ("CERTIFICATE", "PRIVATE KEY", ...) and
// must be identical on the BEGIN and END lines. `pemEncode` builds one such
// block; `pemDecode` parses one or more concatenated blocks back into their DER.
//
// Decoding is deliberately strict, because a lax PEM reader is a classic parser
// attack surface: the END label must match its BEGIN, a block with no END line
// is a truncation error, and the base64 body must be valid (`decode` rejects any
// out-of-alphabet byte). Line endings are tolerant — CRLF, LF, and stray spaces
// or tabs inside the body are stripped before the base64 is decoded — so PEM
// produced on either Windows or Unix parses the same.

// The BEGIN marker prefix, the END marker prefix, and the five-dash tail that
// closes both marker lines. A label is exactly the text between a prefix and the
// next tail.
const pemBeginPrefix: string = "-----BEGIN "
const pemEndPrefix: string = "-----END "
const pemDashes: string = "-----"

// The base64 body is wrapped to this many columns per line (RFC 7468 §2).
const pemLineWidth: int = 64

// A single decoded PEM block: the `label` from its BEGIN/END markers (the object
// type, e.g. "CERTIFICATE") and the raw DER `der` its base64 body decoded to.
export struct PemBlock { export label: string, export der: []byte }

// Encode `der` as one PEM block with type `label`: the framing lines around the
// standard `=`-padded base64 of `der`, wrapped at 64 columns and LF-terminated.
// `pemDecode` inverts it: `pemDecode(pemEncode(l, d))[0].der == d`.
export function pemEncode(label: string, der: []byte): string {
  let body = encode(der)
  let out = pemBeginPrefix + label + pemDashes + "\n"
  let i = 0
  let n = len(body)
  while (i < n) {
    let end = i + pemLineWidth
    if (end > n) {
      end = n
    }
    out = out + body[i:end] + "\n"
    i = end
  }
  return out + pemEndPrefix + label + pemDashes + "\n"
}

// Parse one or more concatenated PEM blocks from `pem`, in order. Text before,
// between, or after blocks (RFC 7468 explanatory text) is ignored. Fails on a
// block whose END line is missing (truncated) or whose END label does not match
// its BEGIN label, and on a body that is not valid base64.
export function pemDecode(pem: string): []PemBlock! {
  let blocks = []PemBlock(0)
  let pos = 0
  let n = len(pem)

  // Each pass consumes one complete block, so at most `n` passes can run before
  // `pemIndexFrom` reports no further BEGIN marker.
  let guard = 0
  while (guard <= n) {
    guard = guard + 1

    let bi = pemIndexFrom(pem, pemBeginPrefix, pos)
    if (bi < 0) {
      break
    }

    // Label of the BEGIN line: from just after the prefix to the closing dashes.
    let labelStart = bi + len(pemBeginPrefix)
    let labelEnd = pemIndexFrom(pem, pemDashes, labelStart)
    if (labelEnd < 0) {
      fail newError("pem: BEGIN line has no closing dashes")
    }
    let label = pem[labelStart:labelEnd]
    let bodyStart = labelEnd + len(pemDashes)

    // The body runs up to the first END marker after it; that marker's label
    // must match this block's, or the file is malformed.
    let ei = pemIndexFrom(pem, pemEndPrefix, bodyStart)
    if (ei < 0) {
      fail newError("pem: block ${label} is truncated (no END line)")
    }
    let endLabelStart = ei + len(pemEndPrefix)
    let endLabelEnd = pemIndexFrom(pem, pemDashes, endLabelStart)
    if (endLabelEnd < 0) {
      fail newError("pem: END line has no closing dashes")
    }
    let endLabel = pem[endLabelStart:endLabelEnd]
    if (endLabel != label) {
      fail newError("pem: END label ${endLabel} does not match BEGIN label ${label}")
    }

    let der = decode(pemStripSpace(pem[bodyStart:ei]))?
    blocks = append(blocks, PemBlock{ label: label, der: der })
    pos = endLabelEnd + len(pemDashes)
  }

  if (len(blocks) == 0) {
    fail newError("pem: no BEGIN/END block found")
  }
  return blocks
}

// The byte index of the first occurrence of `sub` in `s` at or after `start`,
// or -1 if it does not occur there.
function pemIndexFrom(s: string, sub: string, start: int): int {
  let n = len(s)
  let m = len(sub)
  if (start + m > n) {
    return -1
  }
  let last = n - m
  let i = start
  while (i <= last) {
    if (s[i:i + m] == sub) {
      return i
    }
    i = i + 1
  }
  return -1
}

// `s` with every ASCII whitespace byte removed (space, tab, CR, LF, VT, FF), so
// a CRLF- or LF-wrapped base64 body collapses to the contiguous symbols that
// `decode` expects.
function pemStripSpace(s: string): string {
  let out = []byte(0)
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c != 9 && c != 10 && c != 11 && c != 12 && c != 13 && c != 32) {
      out = append(out, c)
    }
    i = i + 1
  }
  return string(out)
}
