// Bit standard library — crypto/rand module.
//
// A cryptographically secure random surface over the OS CSPRNG. Every draw
// comes from `cryptoRandomBytes` (ABI.md §21), which reads the operating
// system's entropy pool — never a userspace PRNG and never a weak or zero
// fallback. This module only reshapes those raw bytes; it never invents
// randomness of its own, so its output is exactly as strong as the OS source.

// `n` cryptographically secure random bytes, as a fresh mutable slice the
// caller owns. A non-positive `n` yields an empty slice. The draw is fatal, not
// degraded, if the OS entropy source ever fails (ABI.md §21).
export function randomBytes(n: int): []byte { return []byte(cryptoRandomBytes(n)) }

// A uniformly random 64-bit value, packed big-endian from 8 secure random
// bytes. Every bit is independent and uniform.
export function randomU64(): uint {
  let b = randomBytes(8)
  let x: uint = 0
  let i = 0
  while (i < 8) {
    x = (x << 8) | uint(b[i])
    i = i + 1
  }
  return x
}

// A uniformly random value in `[0, n)`, free of modulo bias. `n` must be
// greater than zero.
//
// A plain `randomU64() % n` over-represents the low residues whenever `n` does
// not divide 2^64. Splitting `[0, 2^64)` into blocks of `n`, the top
// `2^64 mod n` values form a partial final block that causes exactly that skew;
// this rejects a draw landing there and redraws, so every residue is equally
// likely. When `n` divides 2^64 the band is empty and no draw is ever rejected.
export function randomUintBelow(n: uint): uint {
  if (n == 0) {
    panic("randomUintBelow: n must be > 0")
  }
  // `rem` is the top band's size, `2^64 mod n`, written as `(-n) mod n` because
  // 2^64 wraps to 0 in u64. `maxAccept` is the largest draw below the band; for
  // an empty band (rem == 0) it wraps to the full u64 max, accepting everything.
  let rem: uint = (0 - n) % n
  let maxAccept: uint = 0 - rem - 1
  while (true) {
    let x = randomU64()
    if (x <= maxAccept) {
      return x % n
    }
  }
  return 0 // unreachable: the loop exits only by returning
}

// Overwrite every byte of `buf` in place with secure random bytes. The slice's
// length is unchanged.
export function fillRandom(buf: []byte) {
  let src = randomBytes(len(buf))
  let i = 0
  while (i < len(buf)) {
    buf[i] = src[i]
    i = i + 1
  }
}
