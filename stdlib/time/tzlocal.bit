// The host's local time zone, read straight from the system's TZif file
// rather than a bundled copy of the tzdata database. Sibling of ./time.bit,
// same module (SPEC §17.1) — nothing here is declared there and nothing
// there is used here, so no import of it is needed. This file imports
// std/fs on its own account, the first file in std/time to import anything.

import { readFile } from "std/fs"

const tzMagic: string = "TZif"
const tzHeaderLen: int = 44

// The host's offset from UTC, in seconds east of UTC, in effect at the
// instant `ns` (nanoseconds since the Unix epoch). Dubai returns 14400, UTC
// returns 0.
//
// Reads /etc/localtime (RFC 8536's version 1 block only) directly — the path
// is the same on macOS and Linux, so there is no platform branch, and this
// file ships no timezone data of its own, only a reader for whatever the
// host provides. Returns 0 for any I/O or parse failure — a missing file, a
// dangling symlink, a file shorter than the 44-byte header, or content that
// does not start with the "TZif" magic — rather than failing: a caller
// asking "what is the local offset" has no fallback better than UTC.
//
// ponytail: the v1 block's transition times are signed 32-bit seconds,
// which overflow in 2038. An instant past then resolves against the last
// v1 transition rather than the correct one. RFC 8536 §3.2's version 2
// block, with 64-bit transition times, follows the v1 block in the same
// file and is the upgrade path; this reader stops at v1.
export fn utcOffset(ns: int): int {
  let content = readFile("/etc/localtime") catch ""
  let data = []byte(content)
  if (len(data) < tzHeaderLen || string(data[0:4]) != tzMagic) {
    return 0
  }
  let timecnt = tzBE32(data, 32)
  let typecnt = tzBE32(data, 36)
  if (typecnt < 1 || timecnt < 0) {
    return 0
  }
  let transStart = tzHeaderLen
  let typesStart = transStart + timecnt * 4
  let ttinfoStart = typesStart + timecnt
  if (len(data) < ttinfoStart + typecnt * 6) {
    return 0
  }
  let target = ns / 1000000000
  let typeIdx = 0
  let i = 0
  while (i < timecnt) {
    let t = tzBE32Signed(data, transStart + i * 4)
    if (t > target) {
      break
    }
    let idx = int(data[typesStart + i])
    if (idx < typecnt) {
      typeIdx = idx
    }
    i = i + 1
  }
  return tzBE32Signed(data, ttinfoStart + typeIdx * 6)
}

// Read a big-endian uint32 at byte offset `off` of `data`. Caller must have
// already checked `off + 4 <= len(data)`.
fn tzBE32(data: []byte, off: int): int {
  let a = int(data[off])
  let b = int(data[off + 1])
  let c = int(data[off + 2])
  let d = int(data[off + 3])
  return (a << 24) | (b << 16) | (c << 8) | d
}

// Read a big-endian signed int32 (two's complement) at byte offset `off` of
// `data`. Caller must have already checked `off + 4 <= len(data)`.
fn tzBE32Signed(data: []byte, off: int): int {
  let u = tzBE32(data, off)
  if (u >= 0x80000000) {
    return u - 0x100000000
  }
  return u
}
