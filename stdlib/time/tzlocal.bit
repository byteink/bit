// TZif header primitives, shared by ./zone.bit (the version 1 block) and
// ./zoneif.bit (the version 2/3 block, RFC 8536 §3.2). Sibling of both,
// same module (SPEC §17.1): `tzMagic`, `tzHeaderLen`, `tzBE32` and
// `tzBE32Signed` below are used by ./zoneif.bit unqualified, no import, no
// redeclaration.
//
// This file's own public `utcOffset`, which read only the version 1 block
// directly off `/etc/localtime`, was superseded by `localZone()`/`Zone`
// (./zone.bit, #4071) — which reads the version 2/3 block via ./zoneif.bit
// and so does not share v1's 2038 overflow — and removed (#4084;
// docs/stdlib/time.md, "Superseded API").

const tzMagic: string = "TZif"
const tzHeaderLen: int = 44

// Read a big-endian uint32 at byte offset `off` of `data`. Caller must have
// already checked `off + 4 <= len(data)`.
fn tzBE32(data: []byte, off: int): int {
  let a = int(data[off])
  let b = int(data[off + 1])
  let c = int(data[off + 2])
  let d = int(data[off + 3])
  return (a << 24) | (b << 16) | (c << 8) | d
}

// Read a big-endian signed int32 (two's complement) at byte offset `off` of
// `data`. Caller must have already checked `off + 4 <= len(data)`.
fn tzBE32Signed(data: []byte, off: int): int {
  let u = tzBE32(data, off)
  if (u >= 0x80000000) {
    return u - 0x100000000
  }
  return u
}
