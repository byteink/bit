// Bit standard library — time module, calendar arithmetic (#4076).
//
// Every `add*`/`with*` method in docs/stdlib/time.md's "Arithmetic" and
// "Setting a field" tables, for `Date` (./date.bit, #4072), `Time`
// (./timeofday.bit, #4073), `NaiveDateTime` (./naive.bit, #4074), `DateTime`
// (./zoned.bit, #4075) and `Timestamp.add` (./time.bit). None of these
// methods fails.
//
// Bit has no extension-method syntax (SPEC §10.4): a method exists only
// inside the class body that declares it, and a class cannot be redeclared
// across files — a second `export class Date { ... }` anywhere in this
// module is `E0042`. The mechanism that lets this file supply the methods
// without touching the other five files' own logic is trait injection
// (SPEC §10.7): each trait below is `use`d by one added line in the target
// class's own body (`./date.bit`, `./timeofday.bit`, `./naive.bit`,
// `./zoned.bit`, `./time.bit`), and its provided methods are injected there
// "as if declared" in that class — `this` is typed concretely once
// injected, so every unexported field of that class is reachable exactly as
// it already is from any other file in this module.
//
// Month/year arithmetic CLAMPS, it never normalises (docs/stdlib/time.md,
// "Month arithmetic clamps"): 2026-01-31 `addMonths(1)` is 2026-02-28, not
// 2026-03-03. `calArithShiftMonth` is the one clamp implementation shared by
// every `addMonths`/`addYears`/`withMonth`/`withYear` below — the same
// shape the shipped `stdlib/time/arith.bit`'s `addMonths` already uses on
// raw nanoseconds, reproduced here on bare (year, month, day) since `Date`
// carries no time of day to round-trip. Clamping is not reversible:
// `d.addMonths(1).addMonths(-1)` is not always `d` (2026-01-31 -> 2026-02-28
// -> 2026-01-28), and that is correct, not a bug.
//
// `Time` arithmetic wraps within the day and never carries into a date,
// because a `Time` has no date to carry into (docs/stdlib/time.md, "Time
// arithmetic wraps within the day"). The same operation on `NaiveDateTime`
// DOES carry, via `calArithNaiveAddNs` below, which converts the wall clock
// to "days since epoch" plus "nanosecond of day", shifts, and reconstructs
// through Hinnant's civil-from-days (`civilFromSeconds`, ./civil.bit) — the
// same trick `zonedWallSeconds`/`zonedFromInstant` (./zoned.bit) already use
// to treat a wall clock "as if UTC".
//
// `DateTime` arithmetic operates on the WALL CLOCK and re-resolves the zone
// offset through `NaiveDateTime.inZone` (./naive.bit), never by adding
// nanoseconds to the instant (docs/stdlib/time.md, "Arithmetic across a
// transition") — a daily 09:00 job must still read 09:00 after the clocks
// change, even though the elapsed real time was 23 or 25 hours.
// `Timestamp.add`, injected here for the same reason every other method is
// — `use` must live inside the class body — is the one method in this
// family that DOES add nanoseconds to an instant; it is documented as the
// way to add real elapsed time instead (docs/stdlib/time.md, same section).
//
// Sibling of ./civil.bit, ./date.bit, ./timeofday.bit, ./naive.bit and
// ./zoned.bit, same module (SPEC §17.1): `Civil`, `civilFloorDiv`,
// `civilDaysInMonth`, `civilDaysFromCivil`, `civilFromSeconds`,
// `civilDayNs`, `civilHourNs`, `civilMinuteNs`, `civilSecondNs`, `Date`,
// `Time`, `NaiveDateTime` and `DateTime` are used here unqualified, no
// import, no redeclaration.

// The (year, month, day) `n` months after year `y`, month `m`, with `day`
// clamped to the last valid day of the resulting month
// (docs/stdlib/time.md, "Month arithmetic clamps"). Pure calendar math, no
// nanosecond round-trip — `addMonths`, `addYears` (as `n * 12` months) and
// `withMonth`/`withYear` on `Date`, `NaiveDateTime` and `DateTime` all reach
// this instead of writing their own clamp. `n` may be negative.
fn calArithShiftMonth(y: int, m: int, day: int, n: int): (int, int, int) {
  let totalMonths = y * 12 + (m - 1) + n
  let newYear = civilFloorDiv(totalMonths, 12)
  let newMonth = totalMonths - newYear * 12 + 1
  let dim = civilDaysInMonth(newYear, newMonth)
  let newDay = day
  if (newDay > dim) {
    newDay = dim
  }
  return (newYear, newMonth, newDay)
}

// `day`, clamped to the last valid day of `year`/`month` — the shared body
// of `withYear`/`withMonth`, which only ever change one field and so never
// need `calArithShiftMonth`'s month-count shift.
fn calArithClampDay(year: int, month: int, day: int): int {
  let dim = civilDaysInMonth(year, month)
  if (day > dim) {
    return dim
  }
  return day
}

// `wall` shifted by `deltaNs` nanoseconds of wall-clock time, carrying into
// the date when the shift crosses a day boundary — unlike `Time`'s own
// `addNanoseconds`, which wraps within the day and never carries. Shared by
// `NaiveDateTime`'s `addHours`/`addMinutes`/`addSeconds`/`addNanoseconds`.
fn calArithNaiveAddNs(wall: NaiveDateTime, deltaNs: int): NaiveDateTime {
  let d = wall.date()
  let t = wall.time()
  let dayNs = t.hour() * civilHourNs +
    t.minute() * civilMinuteNs +
    t.second() * civilSecondNs +
    t.nanosecond()
  let totalNs = dayNs + deltaNs
  let dayShift = civilFloorDiv(totalNs, civilDayNs)
  let remNs = totalNs - dayShift * civilDayNs
  let days = civilDaysFromCivil(d.year(), d.month(), d.day()) + dayShift
  let seconds = days * 86400 + remNs / civilSecondNs
  let nanos = remNs % civilSecondNs
  let c = civilFromSeconds(seconds, nanos)
  return NaiveDateTime{
    dt: Date{ y: c.year, m: c.month, d: c.day },
    tm: Time{ h: c.hour, min: c.minute, s: c.second, nanos: c.nanosecond },
  }
}

// --- Date ------------------------------------------------------------------

trait DateCalArith {
  // `this`, `n` calendar years later (clamped: see file header). `n` may be
  // negative.
  addYears(n: int): Date {
    let (y, m, d) = calArithShiftMonth(this.y, this.m, this.d, n * 12)
    return Date{ y: y, m: m, d: d }
  }

  // `this`, `n` calendar months later (clamped: see file header). `n` may
  // be negative.
  addMonths(n: int): Date {
    let (y, m, d) = calArithShiftMonth(this.y, this.m, this.d, n)
    return Date{ y: y, m: m, d: d }
  }

  // `this`, `n` weeks later — exactly `n * 7` days, so it is exact across a
  // month or year boundary by construction. `n` may be negative.
  addWeeks(n: int): Date {
    return this.addDays(n * 7)
  }

  // `this`, `n` days later. `n` may be negative.
  addDays(n: int): Date {
    let days = civilDaysFromCivil(this.y, this.m, this.d) + n
    let c = civilFromSeconds(days * 86400, 0)
    return Date{ y: c.year, m: c.month, d: c.day }
  }

  // `this` with the year replaced by `y`, day clamped to the last valid day
  // of `y`/`this.m` (docs/stdlib/time.md, "Setting a field").
  withYear(y: int): Date {
    return Date{ y: y, m: this.m, d: calArithClampDay(y, this.m, this.d) }
  }

  // `this` with the month replaced by `m`, day clamped to the last valid
  // day of `this.y`/`m`: 2026-01-31 `withMonth(2)` is 2026-02-28.
  withMonth(m: int): Date {
    return Date{ y: this.y, m: m, d: calArithClampDay(this.y, m, this.d) }
  }

  // `this` with the day of month replaced by `d`.
  withDay(d: int): Date {
    return Date{ y: this.y, m: this.m, d: d }
  }
}

// --- Time --------------------------------------------------------------------

trait TimeCalArith {
  // `this`, `n` hours later, wrapping within the day (docs/stdlib/time.md,
  // "Time arithmetic wraps within the day") — never carries into a date,
  // because a `Time` has no date. `n` may be negative.
  addHours(n: int): Time {
    return this.addNanoseconds(n * civilHourNs)
  }

  // `this`, `n` minutes later, wrapping within the day. `23:30`
  // `addMinutes(60)` is `00:30`. `n` may be negative.
  addMinutes(n: int): Time {
    return this.addNanoseconds(n * civilMinuteNs)
  }

  // `this`, `n` seconds later, wrapping within the day. `n` may be
  // negative.
  addSeconds(n: int): Time {
    return this.addNanoseconds(n * civilSecondNs)
  }

  // `this`, `n` nanoseconds later, wrapping within the day. `n` may be
  // negative.
  addNanoseconds(n: int): Time {
    let total = this.h * civilHourNs +
      this.min * civilMinuteNs +
      this.s * civilSecondNs +
      this.nanos +
      n
    let wrapped = total % civilDayNs
    if (wrapped < 0) {
      wrapped = wrapped + civilDayNs
    }
    let hour = wrapped / civilHourNs
    wrapped = wrapped - hour * civilHourNs
    let minute = wrapped / civilMinuteNs
    wrapped = wrapped - minute * civilMinuteNs
    let second = wrapped / civilSecondNs
    let nanos = wrapped - second * civilSecondNs
    return Time{ h: hour, min: minute, s: second, nanos: nanos }
  }

  // `this` with the hour replaced by `h`.
  withHour(h: int): Time {
    return Time{ h: h, min: this.min, s: this.s, nanos: this.nanos }
  }

  // `this` with the minute replaced by `m`.
  withMinute(m: int): Time {
    return Time{ h: this.h, min: m, s: this.s, nanos: this.nanos }
  }

  // `this` with the second replaced by `s`.
  withSecond(s: int): Time {
    return Time{ h: this.h, min: this.min, s: s, nanos: this.nanos }
  }

  // `this` with the nanosecond replaced by `n`.
  withNanosecond(n: int): Time {
    return Time{ h: this.h, min: this.min, s: this.s, nanos: n }
  }
}

// --- NaiveDateTime -----------------------------------------------------------

trait NaiveDateTimeCalArith {
  // `this`, `n` calendar years later (clamped: see file header), time of
  // day unchanged. `n` may be negative.
  addYears(n: int): NaiveDateTime {
    return NaiveDateTime{ dt: this.dt.addYears(n), tm: this.tm }
  }

  // `this`, `n` calendar months later (clamped), time of day unchanged.
  // `n` may be negative.
  addMonths(n: int): NaiveDateTime {
    return NaiveDateTime{ dt: this.dt.addMonths(n), tm: this.tm }
  }

  // `this`, `n` weeks later, time of day unchanged. `n` may be negative.
  addWeeks(n: int): NaiveDateTime {
    return NaiveDateTime{ dt: this.dt.addWeeks(n), tm: this.tm }
  }

  // `this`, `n` days later, time of day unchanged. `n` may be negative.
  addDays(n: int): NaiveDateTime {
    return NaiveDateTime{ dt: this.dt.addDays(n), tm: this.tm }
  }

  // `this`, `n` hours later, CARRYING into the date when the shift crosses
  // midnight — unlike `Time.addHours`, which wraps. `n` may be negative.
  addHours(n: int): NaiveDateTime {
    return calArithNaiveAddNs(this, n * civilHourNs)
  }

  // `this`, `n` minutes later, carrying into the date. `n` may be negative.
  addMinutes(n: int): NaiveDateTime {
    return calArithNaiveAddNs(this, n * civilMinuteNs)
  }

  // `this`, `n` seconds later, carrying into the date. `n` may be negative.
  addSeconds(n: int): NaiveDateTime {
    return calArithNaiveAddNs(this, n * civilSecondNs)
  }

  // `this`, `n` nanoseconds later, carrying into the date. `n` may be
  // negative.
  addNanoseconds(n: int): NaiveDateTime {
    return calArithNaiveAddNs(this, n)
  }

  // `this` with the year replaced by `y` (clamped), time of day unchanged.
  withYear(y: int): NaiveDateTime {
    return NaiveDateTime{ dt: this.dt.withYear(y), tm: this.tm }
  }

  // `this` with the month replaced by `m` (clamped), time of day unchanged.
  withMonth(m: int): NaiveDateTime {
    return NaiveDateTime{ dt: this.dt.withMonth(m), tm: this.tm }
  }

  // `this` with the day of month replaced by `d`, time of day unchanged.
  withDay(d: int): NaiveDateTime {
    return NaiveDateTime{ dt: this.dt.withDay(d), tm: this.tm }
  }

  // `this` with the hour replaced by `h`, date unchanged.
  withHour(h: int): NaiveDateTime {
    return NaiveDateTime{ dt: this.dt, tm: this.tm.withHour(h) }
  }

  // `this` with the minute replaced by `m`, date unchanged.
  withMinute(m: int): NaiveDateTime {
    return NaiveDateTime{ dt: this.dt, tm: this.tm.withMinute(m) }
  }

  // `this` with the second replaced by `s`, date unchanged.
  withSecond(s: int): NaiveDateTime {
    return NaiveDateTime{ dt: this.dt, tm: this.tm.withSecond(s) }
  }

  // `this` with the nanosecond replaced by `n`, date unchanged.
  withNanosecond(n: int): NaiveDateTime {
    return NaiveDateTime{ dt: this.dt, tm: this.tm.withNanosecond(n) }
  }

  // `this` with the time of day replaced by `h`:`m`:`s`, nanosecond and
  // date unchanged.
  withTime(h: int, m: int, s: int): NaiveDateTime {
    return NaiveDateTime{ dt: this.dt, tm: Time{ h: h, min: m, s: s, nanos: this.tm.nanos } }
  }
}

// --- DateTime ------------------------------------------------------------------

trait DateTimeCalArith {
  // `this`, `n` calendar years later, on the WALL CLOCK — the offset is
  // re-resolved through the zone, never derived by adding nanoseconds to
  // the instant (file header; docs/stdlib/time.md, "Arithmetic across a
  // transition"). `n` may be negative.
  addYears(n: int): DateTime {
    return this.naive().addYears(n).inZone(this.zone())
  }

  // `this`, `n` calendar months later, on the wall clock. `n` may be
  // negative.
  addMonths(n: int): DateTime {
    return this.naive().addMonths(n).inZone(this.zone())
  }

  // `this`, `n` weeks later, on the wall clock. `n` may be negative.
  addWeeks(n: int): DateTime {
    return this.naive().addWeeks(n).inZone(this.zone())
  }

  // `this`, `n` days later, on the wall clock: adding a day to 09:00 gives
  // 09:00 the next day, even across a daylight-saving transition, though
  // the elapsed real time was 23 or 25 hours. `n` may be negative.
  addDays(n: int): DateTime {
    return this.naive().addDays(n).inZone(this.zone())
  }

  // `this`, `n` hours later, on the wall clock. `n` may be negative.
  addHours(n: int): DateTime {
    return this.naive().addHours(n).inZone(this.zone())
  }

  // `this`, `n` minutes later, on the wall clock. `n` may be negative.
  addMinutes(n: int): DateTime {
    return this.naive().addMinutes(n).inZone(this.zone())
  }

  // `this`, `n` seconds later, on the wall clock. `n` may be negative.
  addSeconds(n: int): DateTime {
    return this.naive().addSeconds(n).inZone(this.zone())
  }

  // `this`, `n` nanoseconds later, on the wall clock. `n` may be negative.
  addNanoseconds(n: int): DateTime {
    return this.naive().addNanoseconds(n).inZone(this.zone())
  }

  // `this` with the year replaced by `y` (clamped), on the wall clock.
  withYear(y: int): DateTime {
    return this.naive().withYear(y).inZone(this.zone())
  }

  // `this` with the month replaced by `m` (clamped), on the wall clock.
  withMonth(m: int): DateTime {
    return this.naive().withMonth(m).inZone(this.zone())
  }

  // `this` with the day of month replaced by `d`, on the wall clock.
  withDay(d: int): DateTime {
    return this.naive().withDay(d).inZone(this.zone())
  }

  // `this` with the hour replaced by `h`, on the wall clock.
  withHour(h: int): DateTime {
    return this.naive().withHour(h).inZone(this.zone())
  }

  // `this` with the minute replaced by `m`, on the wall clock.
  withMinute(m: int): DateTime {
    return this.naive().withMinute(m).inZone(this.zone())
  }

  // `this` with the second replaced by `s`, on the wall clock.
  withSecond(s: int): DateTime {
    return this.naive().withSecond(s).inZone(this.zone())
  }

  // `this` with the nanosecond replaced by `n`, on the wall clock.
  withNanosecond(n: int): DateTime {
    return this.naive().withNanosecond(n).inZone(this.zone())
  }

  // `this` with the time of day replaced by `h`:`m`:`s`, on the wall clock.
  withTime(h: int, m: int, s: int): DateTime {
    return this.naive().withTime(h, m, s).inZone(this.zone())
  }
}

// --- Timestamp -----------------------------------------------------------------

trait TimestampCalArith {
  // `this`, `ns` nanoseconds later — real elapsed time added to the
  // instant, the one method in this file that does exactly that (file
  // header; docs/stdlib/time.md, "Arithmetic across a transition"). `ns`
  // may be negative.
  add(ns: int): Timestamp {
    return Timestamp{ ns: this.ns + ns }
  }
}
