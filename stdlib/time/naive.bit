// Bit standard library — time module, the NaiveDateTime type (#4074).
//
// A wall-clock reading with no zone: a `Date` and a `Time` glued together,
// meaning "this date, this time of day, somewhere"
// (docs/stdlib/time.md, "Design" / "Choosing a type"). RFC 5545 calls this a
// floating time — "gym at 07:00 daily" means 07:00 wherever the reader wakes
// up, not one fixed instant. `NaiveDateTime` is deliberately independent of
// `Timestamp` (./time.bit) for the same reason `Date` and `Time` are: turning
// a wall-clock reading into an instant needs a `Zone`, which does not exist
// yet (#4071). That conversion is `inZone`, and it belongs to the
// `DateTime` child, a separate ticket — not here.
//
// Sibling of ./date.bit (#4072) and ./timeofday.bit (#4073), same module
// (SPEC §17.1): `Date` and `Time` are used here unqualified, no import, no
// re-declaration. Every accessor below forwards to the matching `Date` or
// `Time` accessor rather than re-deriving it — this file owns no calendar
// arithmetic of its own. `atTime`, the only way to build a `NaiveDateTime`,
// lives on `Date` in ./date.bit, because Bit has no extension-method syntax
// (SPEC §10.4): a method can only be declared inside the body of the class
// it targets.

// A calendar date and a time of day, with no zone. Two `NaiveDateTime`
// values naming the same date and time are equal field-for-field.
// Immutable (docs/stdlib/time.md, "Immutability"): fields are readonly and
// unexported, so a caller reaches them only through the methods below, and
// every method reads `this` without ever mutating it.
export class NaiveDateTime {
  readonly dt: Date
  readonly tm: Time

  // The `Date` half.
  export date(): Date {
    return this.dt
  }

  // The `Time` half.
  export time(): Time {
    return this.tm
  }

  // The calendar year, 1..9999. Forwards to `date().year()`.
  export year(): int {
    return this.dt.year()
  }

  // The calendar month, 1..12. Forwards to `date().month()`.
  export month(): int {
    return this.dt.month()
  }

  // The day of month, 1..`daysInMonth()`. Forwards to `date().day()`.
  export day(): int {
    return this.dt.day()
  }

  // The hour, 0..23. Forwards to `time().hour()`.
  export hour(): int {
    return this.tm.hour()
  }

  // The minute, 0..59. Forwards to `time().minute()`.
  export minute(): int {
    return this.tm.minute()
  }

  // The second, 0..59. Never 60 — this module has no leap seconds. Forwards
  // to `time().second()`.
  export second(): int {
    return this.tm.second()
  }

  // The nanosecond, 0..999999999. Forwards to `time().nanosecond()`.
  export nanosecond(): int {
    return this.tm.nanosecond()
  }

  // 1 for Monday through 7 for Sunday, ISO 8601 numbering. Forwards to
  // `date().dayOfWeek()`.
  export dayOfWeek(): int {
    return this.dt.dayOfWeek()
  }

  // 1 for January 1 up to 365, or 366 in a leap year, for December 31.
  // Forwards to `date().dayOfYear()`.
  export dayOfYear(): int {
    return this.dt.dayOfYear()
  }

  // 1..4: Jan-Mar is 1, Apr-Jun is 2, Jul-Sep is 3, Oct-Dec is 4. Forwards
  // to `date().quarter()`.
  export quarter(): int {
    return this.dt.quarter()
  }

  // 28..31, leap years included. Forwards to `date().daysInMonth()`.
  export daysInMonth(): int {
    return this.dt.daysInMonth()
  }

  // 1..53, ISO 8601 week-date numbering. Forwards to `date().weekOfYear()`.
  export weekOfYear(): int {
    return this.dt.weekOfYear()
  }

  // True when this date's year is a Gregorian leap year. Forwards to
  // `date().isLeapYear()`.
  export isLeapYear(): bool {
    return this.dt.isLeapYear()
  }

  // "2026-09-01T09:00:00" — the `Date` and `Time` canonical forms joined by
  // an uppercase "T", RFC 3339's date-time separator
  // (docs/stdlib/time.md, "toString()"). With nanoseconds:
  // "2026-09-01T09:00:00.000000500". A space is the ISO 8601-permitted
  // alternative; "T" is used here because it is what `parseNaiveDateTime`
  // is specified to read back (docs/stdlib/time.md, "Parsing") and what
  // every other RFC 3339 form in this module already uses.
  export toString(): string {
    return this.dt.toString() + "T" + this.tm.toString()
  }
}
