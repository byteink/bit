// stdlib/time/zoneif.test.bit — RFC 8536 v2/v3 TZif parsing correctness
// (#4070). Same module as ./zoneif.bit (SPEC §19): no import needed to reach
// `tzifParse`/`Transition`/`ZoneData`, which are deliberately unexported.
//
// Two kinds of case. First, against REAL zoneinfo files on this host
// (/usr/share/zoneinfo), each assertion pinned to a transition independently
// cross-checked with macOS's own `zdump`/`date` (never derived from this
// parser or from this file's own earlier output) — a parser that is merely
// self-consistent would happily validate its own bug forever. Second,
// against hostile bytes — truncated, wrong magic, unsupported version,
// counts that would read past the end, an out-of-range type index — each of
// which must `fail` cleanly. `tzifBuildZone`'s bounds check runs before any
// of its three per-type slices are allocated, so the 2,000,000,000-count
// case below proves the rejection happens instead of the allocation, not
// merely alongside it.
//
// Real transitions used below (epoch seconds, cross-checked with `date`):
//   Europe/London  1711846800 -> BST +3600 (2024 spring-forward)
//                  1729990800 -> GMT +0    (2024 fall-back)
//   Australia/Sydney (southern hemisphere)
//                  1712419200 -> AEST +36000 (2024 DST end)
//                  1728144000 -> AEDT +39600 (2024 DST start)
//   Asia/Hebron (largest transition table on this host past 2^31, 310
//   entries; RFC 8536's version 1 32-bit reader cannot even represent this
//   value without overflowing)
//                  3686425200 -> EET +7200, 2086-10-25 — the file's own max
//                  listed transition, independently confirmed via
//                  `zdump -v` and `date -u -r 3686425200`.

// `readFile` is already imported by ./tzlocal.bit, same module (SPEC §17.1)
// -- re-importing it here would be E0042 "already declared in this scope".

fn zoneifFindAt(z: ZoneData, at: int): Transition! {
  for t of z.transitions {
    if (t.at == at) {
      return t
    }
  }
  fail newError("no transition at ${at}")
}

test "tzifParse reads Europe/London's 2024 v2-block transitions" {
  let data = []byte(readFile("/usr/share/zoneinfo/Europe/London") catch "")
  let z = tzifParse(data) catch e {
    assert(false, "parse failed on a real system TZif file: ${e.message()}")
    return
  }
  let bst = zoneifFindAt(z, 1711846800) catch e {
    assert(false, "2024 BST-start transition not found: ${e.message()}")
    return
  }
  assert(bst.offset == 3600, "BST offset = ${bst.offset}, want 3600")
  assert(bst.isDst, "BST isDst = false, want true")
  assert(bst.abbrev == "BST", "BST abbrev = ${bst.abbrev}, want BST")

  let gmt = zoneifFindAt(z, 1729990800) catch e {
    assert(false, "2024 GMT-start (BST end) transition not found: ${e.message()}")
    return
  }
  assert(gmt.offset == 0, "GMT offset = ${gmt.offset}, want 0")
  assert(!gmt.isDst, "GMT isDst = true, want false")
  assert(gmt.abbrev == "GMT", "GMT abbrev = ${gmt.abbrev}, want GMT")
}

test "tzifParse reads a southern-hemisphere zone (Australia/Sydney)" {
  let data = []byte(readFile("/usr/share/zoneinfo/Australia/Sydney") catch "")
  let z = tzifParse(data) catch e {
    assert(false, "parse failed on a real system TZif file: ${e.message()}")
    return
  }
  let aest = zoneifFindAt(z, 1712419200) catch e {
    assert(false, "2024 AEST-start (DST end) transition not found: ${e.message()}")
    return
  }
  assert(aest.offset == 36000, "AEST offset = ${aest.offset}, want 36000")
  assert(!aest.isDst, "AEST isDst = true, want false")
  assert(aest.abbrev == "AEST", "AEST abbrev = ${aest.abbrev}, want AEST")

  let aedt = zoneifFindAt(z, 1728144000) catch e {
    assert(false, "2024 AEDT-start (DST start) transition not found: ${e.message()}")
    return
  }
  assert(aedt.offset == 39600, "AEDT offset = ${aedt.offset}, want 39600")
  assert(aedt.isDst, "AEDT isDst = false, want true")
  assert(aedt.abbrev == "AEDT", "AEDT abbrev = ${aedt.abbrev}, want AEDT")
}

test "tzifParse reads a v2 transition past 2^31 (Asia/Hebron, large table)" {
  let data = []byte(readFile("/usr/share/zoneinfo/Asia/Hebron") catch "")
  let z = tzifParse(data) catch e {
    assert(false, "parse failed on a real system TZif file: ${e.message()}")
    return
  }
  assert(
    len(z.transitions) > 100,
    "Hebron transitions = ${len(z.transitions)}, want > 100 (a large table)",
  )

  let boundary = 2147483648 // 2^31 -- the v1 reader's 32-bit signed times overflow here
  let beyond = zoneifFindAt(z, 3686425200) catch e {
    assert(false, "the 2086 EET transition (at > 2^31) was not found: ${e.message()}")
    return
  }
  assert(
    beyond.at > boundary,
    "beyond.at = ${beyond.at}, want > ${boundary} (proves the 64-bit v2 block was read)",
  )
  println("Asia/Hebron transition at ${beyond.at}: offset=${beyond.offset}")
  assert(beyond.offset == 7200, "offset = ${beyond.offset}, want 7200 (EET)")
  assert(!beyond.isDst, "isDst = true, want false (EET is standard time)")
  assert(beyond.abbrev == "EET", "abbrev = ${beyond.abbrev}, want EET")
}

test "tzifParse truncated only in the POSIX-TZ footer still succeeds" {
  // The v2 data block (transitions/types/ttinfo/abbreviations) always ends
  // well before the file's own last byte -- leap-second records, the
  // std/wall and UT/local indicator arrays, and the footer string all
  // follow it. Cutting exactly one byte off the end must not disturb a
  // parse that never reads that far.
  let data = []byte(readFile("/usr/share/zoneinfo/Europe/London") catch "")
  let whole = tzifParse(data) catch e {
    assert(false, "parse of the untruncated file failed: ${e.message()}")
    return
  }
  let footerCut = tzifParse(data[0:len(data) - 1]) catch e {
    assert(false, "parse failed after trimming only the trailing footer byte: ${e.message()}")
    return
  }
  assert(
    len(footerCut.transitions) == len(whole.transitions),
    "footer-trimmed transitions = ${len(footerCut.transitions)}, want ${len(whole.transitions)}",
  )
}

test "tzifParse fails, never panics, on a real file truncated at several offsets" {
  let data = []byte(readFile("/usr/share/zoneinfo/Europe/London") catch "")
  let n = len(data)
  let cuts = [0, 1, 20, 43, 44, n / 4, n / 2, n * 3 / 4]
  for k of cuts {
    tzifParse(data[0:k]) catch _ {
      continue
    }
    assert(false, "tzifParse did not fail on a file truncated to ${k} of ${n} bytes")
  }
}

test "tzifParse fails on wrong magic" {
  let data = []byte(readFile("/usr/share/zoneinfo/Europe/London") catch "")
  let mutated = tzifTestCopy(data)
  mutated[0] = 'X'
  tzifParse(mutated) catch _ {
    return
  }
  assert(false, "tzifParse accepted data whose magic was not 'TZif'")
}

test "tzifParse fails on an unsupported version byte" {
  let data = []byte(readFile("/usr/share/zoneinfo/Europe/London") catch "")
  let versions = ['1', '4', '9']
  for v of versions {
    let mutated = tzifTestCopy(data)
    mutated[4] = byte(v)
    tzifParse(mutated) catch _ {
      continue
    }
    assert(false, "tzifParse accepted an unsupported version byte ${v}")
  }
}

test "tzifParse fails when the v2 header is corrupted after a valid v1 skip" {
  // The v1 block's own header/data is untouched; only the byte at the start
  // of the v2 header (its magic) is corrupted, so `tzifV2Offset`'s
  // second-magic check is the one under test here.
  let data = []byte(readFile("/usr/share/zoneinfo/Europe/London") catch "")
  let h1 = tzifReadHeaderFields(data, 0)
  let base2 = tzHeaderLen + tzifBlockLen(h1, 4)
  let mutated = tzifTestCopy(data)
  mutated[base2] = 'X'
  tzifParse(mutated) catch _ {
    return
  }
  assert(false, "tzifParse accepted a corrupted version 2 header")
}

test "tzifParse fails when a transition type index is out of range" {
  // typecnt=1, so index 5 into it is bogus.
  let buf = tzifTestBadTypeIndex()
  tzifParse(buf) catch _ {
    return
  }
  assert(false, "tzifParse accepted a transition type index outside typecnt")
}

test "tzifParse fails when typecnt is zero" {
  let buf = []byte(tzHeaderLen)
  tzifTestPutHeader(
    buf,
    0,
    tzifHeaderFields{ isutcnt: 0, isstdcnt: 0, leapcnt: 0, timecnt: 0, typecnt: 0, charcnt: 0 },
  )
  tzifParse(buf) catch _ {
    return
  }
  assert(false, "tzifParse accepted a header with typecnt == 0")
}

test "tzifParse rejects a claimed 2,000,000,000 transitions without allocating" {
  // 50 bytes total -- nowhere near enough to back the claimed count. This is
  // the exact case tzifBuildZone's single bounds check exists for: reject
  // before any of the three per-type slices are sized from `h.typecnt`/
  // `h.timecnt`, not merely fail somewhere inside the allocation.
  let buf = []byte(50)
  tzifTestPutHeader(
    buf,
    0,
    tzifHeaderFields{
      isutcnt: 0,
      isstdcnt: 0,
      leapcnt: 0,
      timecnt: 2000000000,
      typecnt: 1,
      charcnt: 4,
    },
  )
  tzifParse(buf) catch _ {
    return
  }
  assert(false, "tzifParse accepted an unbacked 2,000,000,000-transition claim")
}

test "tzifParse reads a minimal synthetic version 1 (0x00) file" {
  let buf = tzifTestV1Minimal()
  let z = tzifParse(buf) catch e {
    assert(false, "parse of a minimal valid v1 file failed: ${e.message()}")
    return
  }
  assert(len(z.transitions) == 1, "transitions = ${len(z.transitions)}, want 1")
  assert(z.transitions[0].offset == 3600, "offset = ${z.transitions[0].offset}, want 3600")
  assert(z.transitions[0].abbrev == "UTC", "abbrev = ${z.transitions[0].abbrev}, want UTC")
}

test "tzifParse fails on a truncated synthetic version 1 file" {
  let buf = tzifTestV1Minimal()
  tzifParse(buf[0:len(buf) - 1]) catch _ {
    return
  }
  assert(false, "tzifParse accepted a version 1 file missing its last abbreviation byte")
}

// ---------------------------------------------------------------------------
// Synthetic-buffer helpers. Ordinary functions (they take parameters), so
// none of these is itself test-discovered (SPEC §19) -- only the `test`
// declarations above are.
// ---------------------------------------------------------------------------

fn tzifTestCopy(data: []byte): []byte {
  let out = []byte(len(data))
  let i = 0
  while (i < len(data)) {
    out[i] = data[i]
    i = i + 1
  }
  return out
}

fn tzifTestPutBE32(buf: []byte, off: int, val: int) {
  buf[off] = byte((val >> 24) & 0xff)
  buf[off + 1] = byte((val >> 16) & 0xff)
  buf[off + 2] = byte((val >> 8) & 0xff)
  buf[off + 3] = byte(val & 0xff)
}

// Reuses ./zoneif.bit's `tzifHeaderFields` (same module, already exactly the
// six header counts) instead of six loose parameters.
fn tzifTestPutHeader(buf: []byte, version: byte, h: tzifHeaderFields) {
  buf[0] = 'T'
  buf[1] = 'Z'
  buf[2] = 'i'
  buf[3] = 'f'
  buf[4] = version
  tzifTestPutBE32(buf, 20, h.isutcnt)
  tzifTestPutBE32(buf, 24, h.isstdcnt)
  tzifTestPutBE32(buf, 28, h.leapcnt)
  tzifTestPutBE32(buf, 32, h.timecnt)
  tzifTestPutBE32(buf, 36, h.typecnt)
  tzifTestPutBE32(buf, 40, h.charcnt)
}

// header(44) + 1 transition(4) + 1 type index(1) + 1 ttinfo(6) + "UTC\0"(4) = 59 bytes.
fn tzifTestV1Minimal(): []byte {
  let buf = []byte(59)
  tzifTestPutHeader(
    buf,
    0,
    tzifHeaderFields{ isutcnt: 0, isstdcnt: 0, leapcnt: 0, timecnt: 1, typecnt: 1, charcnt: 4 },
  )
  // transition time at [44:48] left as 0 (epoch); type index at [48] left as 0.
  tzifTestPutBE32(buf, 49, 3600) // ttinfo.utoff
  // ttinfo.isdst at [53] left 0; ttinfo.desigidx at [54] left 0.
  buf[55] = 'U'
  buf[56] = 'T'
  buf[57] = 'C'
  buf[58] = 0
  return buf
}

// header(44) + 1 transition(4) + 1 type index(1, deliberately out of range)
// + 1 ttinfo(6) + 4-byte abbreviation block = 59 bytes.
fn tzifTestBadTypeIndex(): []byte {
  let buf = []byte(59)
  tzifTestPutHeader(
    buf,
    0,
    tzifHeaderFields{ isutcnt: 0, isstdcnt: 0, leapcnt: 0, timecnt: 1, typecnt: 1, charcnt: 4 },
  )
  buf[48] = 5 // type index: typecnt is 1, so only 0 is valid
  tzifTestPutBE32(buf, 49, 0)
  return buf
}
