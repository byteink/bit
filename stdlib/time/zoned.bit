// Bit standard library — time module, the DateTime type (#4075).
//
// Joins a `NaiveDateTime` to a `Zone` and yields a real point in time: a
// wall clock, a zone, and the offset that zone has at the resulting
// instant. Depends on `NaiveDateTime` (./naive.bit, #4074) and `Zone`
// (./zone.bit, #4071), same module (SPEC §17.1), used here unqualified.
//
// `inZone` (on `NaiveDateTime` and `Timestamp`) and `atStartOfDay` (on
// `Date`) all construct a `DateTime`, but Bit has no extension-method
// syntax (SPEC §10.4): a method can only be declared inside the body of
// the class it targets. So those three methods live in ./naive.bit,
// ./time.bit and ./date.bit respectively — the same reason `Date.atTime`
// lives in ./date.bit rather than on `NaiveDateTime` — and each forwards
// to a private constructor here. `Timestamp.toString` is added in
// ./time.bit for the same reason: every type's canonical form belongs
// beside the type (docs/stdlib/time.md, "`toString()`"), and `Timestamp`
// was the one type in the table missing it.
//
// Two constructions, and they are different operations
// (docs/stdlib/time.md, "`inZone` and `withZone` are different
// operations"):
//
//   zonedFromWall(wall, z)      -- a WALL CLOCK is given; the instant is
//                                  derived from it via `zoneOffsetForWall`,
//                                  which alone owns the daylight-saving
//                                  disambiguation policy (constraint: do
//                                  not resolve a gap or an overlap here).
//   zonedFromInstant(s, ns, z)  -- an INSTANT is given; the wall clock is
//                                  derived from it via `zoneOffsetAt`, an
//                                  ordinary lookup with nothing to
//                                  disambiguate, because every instant has
//                                  exactly one offset.
//
// Both are total. `zonedFromWall`'s spring-gap case needs one detail
// spelled out, because it is the one place a second lookup is needed
// beyond the single call to `zoneOffsetForWall` the constraint asks for:
// `zoneOffsetForWall` decides WHICH offset should apply (after-gap, or the
// earlier of an overlap's two) but a wall time in the gap does not, by
// itself, correspond to any real instant at that offset. Guessing an
// instant from the wall reading and that offset, then asking
// `zoneOffsetAt` what offset REALLY applies at that guess, lands on the
// correct instant in every case (self-consistent immediately away from a
// transition and inside an overlap; corrected exactly once inside a gap).
// Handing the corrected instant to `zonedFromInstant` then reproduces the
// documented "pushed forward by the size of the gap" result — 2026-03-29
// 01:30 in Europe/London comes back as 02:30 +01:00 — as a consequence of
// ordinary instant arithmetic, not a second policy decision. That second
// lookup is `zoneOffsetAt`, not `zoneOffsetForWall`: it never re-decides
// which of two valid offsets wins, it only asks what offset is in effect
// at one already-chosen instant, which is exactly the question
// `zoneOffsetAt` exists to answer.

// A wall-clock reading, a zone, and the offset that zone has at the
// resulting instant, resolved once at construction (docs/stdlib/time.md,
// "Design": "9am on the 1st in Dubai"). Immutable (docs/stdlib/time.md,
// "Immutability"): every field is readonly and unexported (constraint), so
// a caller reaches them only through the methods below.
export class DateTime {
  use DateTimeCalArith // add*/with*, on the wall clock (./calarith.bit, #4076)
  use DateTimeBounds // startOf*/endOf*, on the wall clock (./bounds.bit, #4077)

  readonly wall: NaiveDateTime
  readonly z: Zone
  readonly off: int

  // The `NaiveDateTime` half — the wall clock, with the zone dropped.
  export naive(): NaiveDateTime {
    return this.wall
  }

  // The `Date` half of the wall clock.
  export date(): Date {
    return this.wall.date()
  }

  // The `Time` half of the wall clock.
  export time(): Time {
    return this.wall.time()
  }

  // The zone this instant is being read in.
  export zone(): Zone {
    return this.z
  }

  // Seconds east of UTC at this instant, `14400` for Dubai
  // (docs/stdlib/time.md, "Reading fields").
  export offset(): int {
    return this.off
  }

  // Whether daylight saving is in effect at this instant. Not derivable
  // from the offset alone: several zones have a non-zero standard offset
  // (docs/stdlib/time.md's own point about this method).
  export isDst(): bool {
    return zoneIsDstAt(this.z, zonedInstantSeconds(this.wall, this.off))
  }

  // The calendar year, 1..9999. Forwards to the wall clock.
  export year(): int {
    return this.wall.year()
  }

  // The calendar month, 1..12. Forwards to the wall clock.
  export month(): int {
    return this.wall.month()
  }

  // The day of month, 1..`daysInMonth()`. Forwards to the wall clock.
  export day(): int {
    return this.wall.day()
  }

  // The hour, 0..23. Forwards to the wall clock.
  export hour(): int {
    return this.wall.hour()
  }

  // The minute, 0..59. Forwards to the wall clock.
  export minute(): int {
    return this.wall.minute()
  }

  // The second, 0..59. Forwards to the wall clock.
  export second(): int {
    return this.wall.second()
  }

  // The nanosecond, 0..999999999. Forwards to the wall clock.
  export nanosecond(): int {
    return this.wall.nanosecond()
  }

  // 1 for Monday through 7 for Sunday. Forwards to the wall clock.
  export dayOfWeek(): int {
    return this.wall.dayOfWeek()
  }

  // 1 for January 1 up to 365 or 366. Forwards to the wall clock.
  export dayOfYear(): int {
    return this.wall.dayOfYear()
  }

  // 1..4. Forwards to the wall clock.
  export quarter(): int {
    return this.wall.quarter()
  }

  // 28..31. Forwards to the wall clock.
  export daysInMonth(): int {
    return this.wall.daysInMonth()
  }

  // 1..53, ISO 8601. Forwards to the wall clock.
  export weekOfYear(): int {
    return this.wall.weekOfYear()
  }

  // True when this wall clock's year is a Gregorian leap year. Forwards to
  // the wall clock.
  export isLeapYear(): bool {
    return this.wall.isLeapYear()
  }

  // Same instant, a different zone's view of it (docs/stdlib/time.md,
  // "`inZone` and `withZone` are different operations"): the instant is
  // kept, the wall clock is recomputed via `zoneOffsetAt`. Total — every
  // instant has exactly one offset in any zone.
  export withZone(z: Zone): DateTime {
    let seconds = zonedInstantSeconds(this.wall, this.off)
    return zonedFromInstant(seconds, this.wall.nanosecond(), z)
  }

  // The instant this `DateTime` names, as nanoseconds since the Unix
  // epoch. Fails when it falls outside `Timestamp`'s representable range
  // (docs/stdlib/time.md, "Ranges"): `Date`/`NaiveDateTime` span years
  // 1..9999, `Timestamp` only 1677-09-21T00:12:43.145224192Z to
  // 2262-04-11T23:47:16.854775807Z. Never wraps — a silent wrap here would
  // be a wrong balance on every value outside that range.
  export toTimestamp(): Timestamp! {
    let seconds = zonedInstantSeconds(this.wall, this.off)
    let nanos = this.wall.nanosecond()
    if (seconds > zonedTimestampMaxSeconds ||
      (seconds == zonedTimestampMaxSeconds && nanos > zonedTimestampMaxNanoRemainder)) {
      fail newError("toTimestamp: instant is after the representable range")
    }
    if (seconds < zonedTimestampMinSeconds ||
      (seconds == zonedTimestampMinSeconds && nanos < zonedTimestampMinNanoRemainder)) {
      fail newError("toTimestamp: instant is before the representable range")
    }
    return Timestamp{ ns: seconds * civilSecondNs + nanos }
  }

  // "2026-09-01T09:00:00+04:00" — the wall clock's own canonical form
  // (./naive.bit) plus a numeric `±HH:MM` offset (docs/stdlib/time.md,
  // "`toString()`").
  export toString(): string {
    return this.wall.toString() + zonedFormatOffset(this.off)
  }
}

// `wall`'s reading expressed as seconds since the Unix epoch, ignoring any
// zone — the same "as if UTC" convention `zoneOffsetForWall`'s own
// `wallSeconds` parameter uses. Offsets are always whole seconds (TZif has
// no sub-second offsets), so the nanosecond field never needs to cross
// this boundary and is handled separately by every caller.
fn zonedWallSeconds(wall: NaiveDateTime): int {
  let d = wall.date()
  let t = wall.time()
  return civilDaysFromCivil(d.year(), d.month(), d.day()) * 86400 +
    t.hour() * 3600 +
    t.minute() * 60 +
    t.second()
}

// The instant `wall` names when read at the already-resolved offset
// `off`: `wall`'s own reading minus `off`. Valid only for a `(wall, off)`
// pair produced by `zonedFromWall`/`zonedFromInstant`/`withZone` below,
// which are always self-consistent by construction — this is plain
// arithmetic, not a lookup.
fn zonedInstantSeconds(wall: NaiveDateTime, off: int): int {
  return zonedWallSeconds(wall) - off
}

// Builds a `DateTime` for the wall-clock reading `wall`, read as `z`
// (docs/stdlib/time.md, "`inZone` pushes forward"/"takes the first
// occurrence"). See the file header for why the second lookup below is
// not itself a disambiguation.
fn zonedFromWall(wall: NaiveDateTime, z: Zone): DateTime {
  let wallSeconds = zonedWallSeconds(wall)
  let guessOffset = zoneOffsetForWall(z, wallSeconds)
  let trueOffset = zoneOffsetAt(z, wallSeconds - guessOffset)
  let instantSeconds = wallSeconds - trueOffset
  return zonedFromInstant(instantSeconds, wall.nanosecond(), z)
}

// Builds a `DateTime` for the instant `instantSeconds` seconds since the
// Unix epoch (plus `nanos`, 0..999999999, of that second), as it reads in
// `z`. An ordinary, unambiguous instant -> offset lookup: every instant
// has exactly one offset, so there is nothing to disambiguate here, unlike
// `zonedFromWall`, which resolves a wall clock.
fn zonedFromInstant(instantSeconds: int, nanos: int, z: Zone): DateTime {
  let off = zoneOffsetAt(z, instantSeconds)
  let c = civilFromSeconds(instantSeconds + off, nanos)
  let wall = NaiveDateTime{
    dt: Date{ y: c.year, m: c.month, d: c.day },
    tm: Time{ h: c.hour, min: c.minute, s: c.second, nanos: c.nanosecond },
  }
  return DateTime{ wall: wall, z: z, off: off }
}

// `off` as `±HH:MM`, `zonedFormatOffset(14400)` -> `"+04:00"`, always
// numeric (docs/stdlib/time.md's own `DateTime` examples never abbreviate
// a zero offset to `Z` — that shorthand is `Timestamp.toString`'s alone,
// ./time.bit).
fn zonedFormatOffset(off: int): string {
  let sign = "+"
  let mag = off
  if (off < 0) {
    sign = "-"
    mag = -off
  }
  return sign + fmtPad(mag / 3600, 2) + ":" + fmtPad(mag / 60 % 60, 2)
}

// `Timestamp`'s representable range (docs/stdlib/time.md, "Ranges"),
// split into whole seconds since the epoch plus a non-negative
// nanosecond-of-second remainder — the same floored convention
// `civilFromUnix`/`unixFromCivil` already use — so `toTimestamp` can
// compare against it without the multiply-by-1e9 that would overflow
// `int` for most of `Date`'s wider 1..9999 year range before the
// comparison ever ran.
//
// `9223372036854775807 / civilSecondNs` truncates to `9223372036`, exactly
// `2262-04-11T23:47:16.854775807Z`, with the remainder as the max
// nanosecond-of-second. `-9223372036854775808` (i64 min, written the same
// overflow-avoiding way `compiler/optfold.bit` writes it) floors to
// `-9223372037`, exactly `1677-09-21T00:12:43.145224192Z`.
const zonedTimestampMaxSeconds: int = 9223372036
const zonedTimestampMaxNanoRemainder: int = 854775807
const zonedTimestampMinSeconds: int = -9223372037
const zonedTimestampMinNanoRemainder: int = 145224192
