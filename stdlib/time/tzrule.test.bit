// stdlib/time/tzrule.test.bit — the TZif footer rule (#6375): parsing in
// ./tzrule.bit, evaluation in ./tzrulefn.bit, use in ./zone.bit. Same module
// as those (SPEC §19), so every unexported name is reachable.
//
// Two kinds of case. The hermetic ones build a version 2 TZif file in memory
// around a footer and assert on the `Zone` it yields, so they do not move
// when the host's tzdata changes a rule. The host ones read the real
// zoneinfo file of America/New_York, Europe/London, Australia/Lord_Howe and
// Asia/Tokyo, whose rules are long-lived, through the public `zone()`.
//
// Expected instants and offsets were taken from an implementation that shares
// no code with this one (Python 3 `zoneinfo`, which evaluates the footer of
// the host's file past its last transition), never from this parser's own
// output. The instants are UTC epoch seconds of the transition itself: the
// offset is the old one at `at - 1` and the new one at `at`.

// --- hermetic file builder ------------------------------------------------

// `dst` followed by `src`, in a fresh slice.
fn tzrTestAppend(dst: []byte, src: []byte): []byte {
  let out = []byte(len(dst) + len(src))
  let i = 0
  while (i < len(dst)) {
    out[i] = dst[i]
    i = i + 1
  }
  i = 0
  while (i < len(src)) {
    out[len(dst) + i] = src[i]
    i = i + 1
  }
  return out
}

fn tzrTestHeader(timecnt: int, charcnt: int): []byte {
  let h = []byte(44)
  tzifTestPutHeader(
    h,
    '2',
    tzifHeaderFields{
      isutcnt = 0,
      isstdcnt = 0,
      leapcnt = 0,
      timecnt = timecnt,
      typecnt = 1,
      charcnt = charcnt,
    },
  )
  return h
}

// A version 2 file: an empty v1 block (one type, one abbreviation byte), a
// v2 block of one local time type at `stdOff` and, if `at >= 0`, one
// transition at `at` into it, then the footer `\n<footer>\n`.
fn tzrTestFile(stdOff: int, at: int, footer: string): []byte {
  let buf = tzrTestHeader(0, 1)
  buf = tzrTestAppend(buf, []byte(7))
  let timecnt = 0
  if (at >= 0) {
    timecnt = 1
  }
  buf = tzrTestAppend(buf, tzrTestHeader(timecnt, 4))
  if (at >= 0) {
    let t = []byte(8)
    tzifTestPutBE32(t, 4, at)
    buf = tzrTestAppend(buf, t)
    buf = tzrTestAppend(buf, []byte(1))
  }
  let tt = []byte(6)
  tzifTestPutBE32(tt, 0, stdOff)
  buf = tzrTestAppend(buf, tt)
  buf = tzrTestAppend(buf, []byte("UTC\x00"))
  buf = tzrTestAppend(buf, []byte("\n"))
  buf = tzrTestAppend(buf, []byte(footer))
  buf = tzrTestAppend(buf, []byte("\n"))
  return buf
}

fn tzrTestZoneAt(stdOff: int, at: int, footer: string): Zone {
  let d = tzifParse(tzrTestFile(stdOff, at, footer)) catch e {
    panic("tzrTestZone '${footer}': ${e.message()}")
  }
  return zoneFromData("T", d)
}

fn tzrTestZone(footer: string): Zone {
  return tzrTestZoneAt(0, -1, footer)
}

fn tzrDate(y: int, m: int, d: int): Date {
  return date(y, m, d) catch e {
    panic("tzrDate: ${e.message()}")
  }
}

fn tzrWall(day: Date, h: int, mi: int, sec: int): NaiveDateTime {
  return day.atTime(h, mi, sec) catch e {
    panic("tzrWall time: ${e.message()}")
  }
}

// --- assertions -----------------------------------------------------------

// `before` holds one second before `at` and `after` from `at` on, both as
// the offset and as the daylight-saving flag.
fn tzrCheckEdge(z: Zone, label: string, at: int, before: int, after: int) {
  let b = zoneOffsetAt(z, at - 1)
  let a = zoneOffsetAt(z, at)
  assert(b == before, "${label}: offset at ${at - 1} is ${b}, want ${before}")
  assert(a == after, "${label}: offset at ${at} is ${a}, want ${after}")
}

fn tzrCheckWall(z: Zone, label: string, wall: int, want: int) {
  let got = zoneOffsetForWall(z, wall)
  assert(got == want, "${label}: wall ${wall} resolves to ${got}, want ${want}")
}

// Whether `s` contains `sub`.
fn tzrHas(s: string, sub: string): bool {
  let i = 0
  while (i + len(sub) <= len(s)) {
    if (s[i:i + len(sub)] == sub) {
      return true
    }
    i = i + 1
  }
  return false
}

fn tzrCheckBad(footer: string, frag: string) {
  tzrParse(footer) catch e {
    assert(tzrHas(e.message(), frag), "footer '${footer}': error '${e.message()}' lacks '${frag}'")
    return
  }
  assert(false, "footer '${footer}' parsed, want a failure mentioning '${frag}'")
}

// --- parsing --------------------------------------------------------------

test "tzrParse reads EST5EDT,M3.2.0,M11.1.0 and flips the POSIX sign to east-positive" {
  let r = tzrParse("EST5EDT,M3.2.0,M11.1.0") catch e {
    assert(false, "parse failed: ${e.message()}")
    return
  }
  assert(
    r.stdOff == -18000 && r.dstOff == -14400,
    "offsets ${r.stdOff}/${r.dstOff}, want -18000/-14400",
  )
  assert(
    r.hasDst && !r.alwaysDst,
    "hasDst/alwaysDst = ${r.hasDst}/${r.alwaysDst}, want true/false",
  )
  assert(
    r.start.kind == tzrKindMonth && r.start.month == 3 && r.start.week == 2 && r.start.day == 0,
    "start is not M3.2.0",
  )
  assert(
    r.end.kind == tzrKindMonth && r.end.month == 11 && r.end.week == 1 && r.end.day == 0,
    "end is not M11.1.0",
  )
  assert(
    r.start.secs == 7200 && r.end.secs == 7200,
    "default time is ${r.start.secs}/${r.end.secs}, want 02:00:00 both",
  )
}

test "tzrParse reads a fixed zone (Asia/Tokyo JST-9) and a colon offset" {
  let tokyo = tzrParse("JST-9") catch e {
    assert(false, "JST-9: ${e.message()}")
    return
  }
  assert(tokyo.stdOff == 32400 && !tokyo.hasDst, "JST-9 gave ${tokyo.stdOff}/${tokyo.hasDst}")
  let india = tzrParse("IST-5:30") catch e {
    assert(false, "IST-5:30: ${e.message()}")
    return
  }
  assert(india.stdOff == 19800, "IST-5:30 gave ${india.stdOff}, want 19800")
  let full = tzrParse("<+054530>-5:45:30") catch e {
    assert(false, "hh:mm:ss: ${e.message()}")
    return
  }
  assert(full.stdOff == 5 * 3600 + 45 * 60 + 30, "hh:mm:ss gave ${full.stdOff}")
}

test "tzrParse reads a quoted name with signed /time (America/Nuuk style)" {
  let r = tzrParse("<-02>2<-01>,M3.5.0/-1,M10.5.0/0") catch e {
    assert(false, "parse failed: ${e.message()}")
    return
  }
  assert(r.stdOff == -7200 && r.dstOff == -3600, "offsets ${r.stdOff}/${r.dstOff}")
  assert(
    r.start.secs == -3600 && r.end.secs == 0,
    "times ${r.start.secs}/${r.end.secs}, want -3600/0",
  )
}

test "tzrParse reads a half-hour DST shift (Australia/Lord_Howe)" {
  let r = tzrParse("<+1030>-10:30<+11>-11,M10.1.0,M4.1.0") catch e {
    assert(false, "parse failed: ${e.message()}")
    return
  }
  assert(
    r.stdOff == 37800 && r.dstOff == 39600,
    "offsets ${r.stdOff}/${r.dstOff}, want 37800/39600",
  )
}

test "tzrParse reads the Jn and n date forms with hh:mm:ss times" {
  let r = tzrParse("EST5EDT,J60/3:30:15,200") catch e {
    assert(false, "parse failed: ${e.message()}")
    return
  }
  assert(r.start.kind == tzrKindJulian1 && r.start.day == 60, "start is not J60")
  assert(r.start.secs == 3 * 3600 + 30 * 60 + 15, "start time ${r.start.secs}")
  assert(
    r.end.kind == tzrKindZeroBased && r.end.day == 200 && r.end.secs == 7200,
    "end is not 200/02:00",
  )
}

test "tzrParse accepts the version 3 hour range -167..167 and an explicit DST offset" {
  let r = tzrParse("<-03>3<-02>,M3.5.0/-167,M10.5.0/167") catch e {
    assert(false, "parse failed: ${e.message()}")
    return
  }
  assert(
    r.start.secs == -167 * 3600 && r.end.secs == 167 * 3600,
    "times ${r.start.secs}/${r.end.secs}",
  )
  let s = tzrParse("XXX5YYY4:30,M3.2.0,M11.1.0") catch e {
    assert(false, "explicit DST offset: ${e.message()}")
    return
  }
  assert(s.dstOff == -16200, "explicit DST offset gave ${s.dstOff}, want -16200")
}

test "tzrParse marks EST5EDT,0/0,J365/25 as daylight saving all year and nothing else" {
  let all = tzrParse("EST5EDT,0/0,J365/25") catch e {
    assert(false, "parse failed: ${e.message()}")
    return
  }
  assert(all.alwaysDst, "EST5EDT,0/0,J365/25 is not alwaysDst")
  let jn = tzrParse("EST5EDT,J1/0,J365/25") catch e {
    assert(false, "J1 form: ${e.message()}")
    return
  }
  assert(jn.alwaysDst, "EST5EDT,J1/0,J365/25 is not alwaysDst")
  let notAll = tzrParse("EST5EDT,0/0,J365/24") catch e {
    assert(false, "parse failed: ${e.message()}")
    return
  }
  assert(!notAll.alwaysDst, "J365/24 leaves an hour of standard time, it is not alwaysDst")
}

test "tzrParse fails by name on every malformed footer" {
  tzrCheckBad("", "zone name")
  tzrCheckBad(":EST5", "leading ':'")
  tzrCheckBad("ES5", "zone name")
  tzrCheckBad("EST", "number expected")
  tzrCheckBad("<EST5", "unterminated")
  tzrCheckBad("<ES!>5", "unterminated")
  tzrCheckBad("EST5EDT", "without a rule")
  tzrCheckBad("EST5EDT,M3.2.0", "',' expected")
  tzrCheckBad("EST5EDT,M3.2.0,", "number expected")
  tzrCheckBad("EST5EDT,M13.1.0,M11.1.0", "above 12")
  tzrCheckBad("EST5EDT,M0.1.0,M11.1.0", "Mm.w.d")
  tzrCheckBad("EST5EDT,M3.0.0,M11.1.0", "Mm.w.d")
  tzrCheckBad("EST5EDT,M3.6.0,M11.1.0", "above 5")
  tzrCheckBad("EST5EDT,M3.2.7,M11.1.0", "above 6")
  tzrCheckBad("EST5EDT,J0,J5", "Jn")
  tzrCheckBad("EST5EDT,J366,J5", "above 365")
  tzrCheckBad("EST5EDT,366,5", "above 365")
  tzrCheckBad("EST25", "above 24")
  tzrCheckBad("EST5:60", "above 59")
  tzrCheckBad("EST5EDT,M3.2.0/168,M11.1.0", "above 167")
  tzrCheckBad("EST5EDT,M3.2.0,M11.1.0x", "unexpected")
  tzrCheckBad("EST5EDT,M3.2.0,M11.1.0,", "unexpected")
  tzrCheckBad("EST5,EDT", "zone name")
}

// --- the footer in a TZif file --------------------------------------------

test "tzifParse fails at load on a malformed footer, naming it" {
  let bad = tzrTestFile(0, -1, "EST5EDT,M3.2.0")
  tzifParse(bad) catch e {
    assert(tzrHas(e.message(), "malformed footer 'EST5EDT,M3.2.0'"), "error was '${e.message()}'")
    return
  }
  assert(false, "a v2 file with a malformed footer parsed")
}

test "tzifParse fails on a v2 file with a missing or unterminated footer" {
  let good = tzrTestFile(0, -1, "JST-9")
  tzifParse(good[0:len(good) - 1]) catch e {
    assert(tzrHas(e.message(), "not newline-terminated"), "unterminated: '${e.message()}'")
    let noFooter = good[0:len(good) - 7]
    tzifParse(noFooter) catch e2 {
      assert(tzrHas(e2.message(), "footer missing"), "missing: '${e2.message()}'")
      return
    }
    assert(false, "a v2 file with no footer parsed")
    return
  }
  assert(false, "a v2 file with an unterminated footer parsed")
}

test "an empty footer gives no rule and the table rules alone, as before" {
  let z = tzrTestZoneAt(3600, 0, "")
  assert(len(z.rule) == 0, "empty footer gave ${len(z.rule)} rules")
  assert(
    zoneOffsetAt(z, 4102444800) == 3600,
    "offset in 2100 is ${zoneOffsetAt(z, 4102444800)}, want the last transition's 3600",
  )
}

test "a file with no transitions takes its offset from the footer" {
  let z = tzrTestZone("JST-9")
  assert(z.fallback == 32400, "fallback is ${z.fallback}, want 32400")
  assert(zoneIsFixed(z), "a footer with no DST and no transitions is a fixed zone")
  assert(
    zoneOffsetAt(z, 2215062000) == 32400,
    "Tokyo-style 2040 offset is ${zoneOffsetAt(z, 2215062000)}",
  )
  assert(!zoneIsDstAt(z, 2215062000), "a fixed footer is never daylight saving")
  let dst = tzrTestZone("EST5EDT,M3.2.0,M11.1.0")
  assert(!zoneIsFixed(dst), "a DST footer with no transitions is not a fixed zone")
}

// --- evaluation, hermetic -------------------------------------------------

test "New York footer: both sides of each 2040 and 2100 transition" {
  let z = tzrTestZone("EST5EDT,M3.2.0,M11.1.0")
  tzrCheckEdge(z, "NY 2040 spring", 2215062000, -18000, -14400)
  tzrCheckEdge(z, "NY 2040 fall", 2235621600, -14400, -18000)
  tzrCheckEdge(z, "NY 2100 spring", 4108690800, -18000, -14400)
  tzrCheckEdge(z, "NY 2100 fall", 4129250400, -14400, -18000)
  assert(
    zoneIsDstAt(z, 2215062000) && !zoneIsDstAt(z, 2215061999),
    "2040 spring isDst flips at the transition",
  )
  assert(
    !zoneIsDstAt(z, 2235621600) && zoneIsDstAt(z, 2235621599),
    "2040 fall isDst flips at the transition",
  )
}

test "London footer (M3.5.0/1 is the last Sunday): 2040 and 2100" {
  let z = tzrTestZone("GMT0BST,M3.5.0/1,M10.5.0")
  tzrCheckEdge(z, "London 2040 spring", 2216250000, 0, 3600)
  tzrCheckEdge(z, "London 2040 fall", 2234998800, 3600, 0)
  tzrCheckEdge(z, "London 2100 spring", 4109878800, 0, 3600)
  tzrCheckEdge(z, "London 2100 fall", 4128627600, 3600, 0)
}

test "Lord Howe footer (30-minute DST, southern hemisphere): 2040 and 2100" {
  let z = tzrTestZone("<+1030>-10:30<+11>-11,M10.1.0,M4.1.0")
  tzrCheckEdge(z, "Lord Howe 2040 DST end", 2216818800, 39600, 37800)
  tzrCheckEdge(z, "Lord Howe 2040 DST start", 2233150200, 37800, 39600)
  tzrCheckEdge(z, "Lord Howe 2100 DST end", 4110447600, 39600, 37800)
  tzrCheckEdge(z, "Lord Howe 2100 DST start", 4126174200, 37800, 39600)
  assert(
    zoneIsDstAt(z, 2233150200) && !zoneIsDstAt(z, 2216818800),
    "Lord Howe isDst follows its +11 summer",
  )
}

test "Nuuk footer with negative /time: transitions the evening before" {
  let z = tzrTestZone("<-02>2<-01>,M3.5.0/-1,M10.5.0/0")
  tzrCheckEdge(z, "Nuuk 2040 spring", 2216250000, -7200, -3600)
  tzrCheckEdge(z, "Nuuk 2040 fall", 2234998800, -3600, -7200)
  tzrCheckEdge(z, "Nuuk 2100 spring", 4109878800, -7200, -3600)
  tzrCheckEdge(z, "Nuuk 2100 fall", 4128627600, -3600, -7200)
}

test "footers with /time past 24 hours: Gaza /50 and Santiago /24 in 2100" {
  let gaza = tzrTestZone("EET-2EEST,M3.4.4/50,M10.4.4/50")
  tzrCheckEdge(gaza, "Gaza 2100 spring", 4109788800, 7200, 10800)
  tzrCheckEdge(gaza, "Gaza 2100 fall", 4128534000, 10800, 7200)
  let santiago = tzrTestZone("<-04>4<-03>,M9.1.6/24,M4.1.6/24")
  tzrCheckEdge(santiago, "Santiago 2100 DST end", 4110490800, -10800, -14400)
  tzrCheckEdge(santiago, "Santiago 2100 DST start", 4123800000, -14400, -10800)
}

test "negative daylight saving (Irish IST-1GMT0): winter is the DST side" {
  let z = tzrTestZone("IST-1GMT0,M10.5.0,M3.5.0/1")
  tzrCheckEdge(z, "Dublin 2040 to summer", 2216250000, 0, 3600)
  tzrCheckEdge(z, "Dublin 2040 to winter", 2234998800, 3600, 0)
  assert(zoneIsDstAt(z, 2224756800) == false, "July 2040 is standard time (+01) in this footer")
  assert(zoneIsDstAt(z, 2208988800 + 86400), "January 2040 is daylight saving (+00) in this footer")
  // Clocks go forward 00:59:59 -> 02:00:00 at 2216250000 (a gap) and back
  // 02:00:00 -> 01:00:00 at 2234998800 (an overlap): the same policy as a
  // positive shift, so the gap takes the post-gap offset and the overlap the
  // first occurrence.
  tzrCheckWall(z, "Dublin gap 01:30", 2216250000 + 1800, 3600)
  tzrCheckWall(z, "Dublin before gap", 2216250000 - 1, 0)
  tzrCheckWall(z, "Dublin overlap 01:30", 2234998800 + 1800, 3600)
  tzrCheckWall(z, "Dublin after overlap", 2234998800 + 3600, 0)
}

test "permanent daylight saving (EST5EDT,0/0,J365/25) never reverts" {
  let z = tzrTestZone("EST5EDT,0/0,J365/25")
  let samples = [
    2208988800,
    2215062000,
    2225000000,
    2235621600,
    2240611200,
    2240611200 + 18000,
    4102444800,
  ]
  for t of samples {
    assert(zoneOffsetAt(z, t) == -14400, "offset at ${t} is ${zoneOffsetAt(z, t)}, want -14400")
    assert(zoneIsDstAt(z, t), "isDst at ${t} is false")
  }
  assert(zoneOffsetForWall(z, 2215062000) == -14400, "wall resolution is not the DST offset")
}

test "a rule takes over exactly at the last table transition (a slim file)" {
  // One table transition at the epoch into a -05:00 type, footer New York:
  // the table ends in 1970, so every later instant is the footer's.
  let z = tzrTestZoneAt(-18000, 0, "EST5EDT,M3.2.0,M11.1.0")
  assert(zoneOffsetAt(z, -1) == -18000, "before the transition is the fallback -18000")
  assert(zoneOffsetAt(z, 1700000000) == -18000, "November 2023 is EST")
  assert(zoneOffsetAt(z, 1720000000) == -14400, "July 2024 is EDT, from the footer")
  tzrCheckEdge(z, "slim NY 2040 spring", 2215062000, -18000, -14400)
  assert(zoneIsDstAt(z, 1720000000), "July 2024 is daylight saving")
}

// --- evaluation through the public DateTime route -------------------------

test "DateTime in 2040: a spring gap reads forward, an autumn overlap the first occurrence" {
  let z = tzrTestZone("EST5EDT,M3.2.0,M11.1.0")
  let gap = tzrWall(tzrDate(2040, 3, 11), 2, 30, 0)
  assert(
    gap.inZone(z).toString() == "2040-03-11T03:30:00-04:00",
    "gap read as ${gap.inZone(z).toString()}",
  )
  let overlap = tzrWall(tzrDate(2040, 11, 4), 1, 30, 0)
  assert(
    overlap.inZone(z).toString() == "2040-11-04T01:30:00-04:00",
    "overlap read as ${overlap.inZone(z).toString()}",
  )
  let after = tzrWall(tzrDate(2040, 11, 4), 2, 0, 0)
  assert(
    after.inZone(z).toString() == "2040-11-04T02:00:00-05:00",
    "after read as ${after.inZone(z).toString()}",
  )
}

test "wall readings around each 2040 transition: New York and Lord Howe" {
  let ny = tzrTestZone("EST5EDT,M3.2.0,M11.1.0")
  let springWall = 2215062000 - 18000
  tzrCheckWall(ny, "NY before gap", springWall - 1, -18000)
  tzrCheckWall(ny, "NY gap start", springWall, -14400)
  tzrCheckWall(ny, "NY gap middle", springWall + 1800, -14400)
  tzrCheckWall(ny, "NY after gap", springWall + 3600, -14400)
  let fallWall = 2235621600 - 14400
  tzrCheckWall(ny, "NY before overlap", fallWall - 3601, -14400)
  tzrCheckWall(ny, "NY overlap start", fallWall - 3600, -14400)
  tzrCheckWall(ny, "NY overlap end", fallWall - 1, -14400)
  tzrCheckWall(ny, "NY after overlap", fallWall, -18000)
  let lh = tzrTestZone("<+1030>-10:30<+11>-11,M10.1.0,M4.1.0")
  let lhGap = 2233150200 + 37800
  tzrCheckWall(lh, "Lord Howe before 30-minute gap", lhGap - 1, 37800)
  tzrCheckWall(lh, "Lord Howe in gap", lhGap + 900, 39600)
  tzrCheckWall(lh, "Lord Howe after gap", lhGap + 1800, 39600)
  let lhFall = 2216818800 + 39600
  tzrCheckWall(lh, "Lord Howe in 30-minute overlap", lhFall - 900, 39600)
  tzrCheckWall(lh, "Lord Howe after overlap", lhFall, 37800)
}

// --- real host files, through zone() --------------------------------------

fn tzrHostZone(name: string): Zone {
  return zone(name) catch e {
    panic("zone(${name}): ${e.message()}")
  }
}

test "host America/New_York, Europe/London, Australia/Lord_Howe in 2040 and 2100" {
  let ny = tzrHostZone("America/New_York")
  tzrCheckEdge(ny, "host NY 2040 spring", 2215062000, -18000, -14400)
  tzrCheckEdge(ny, "host NY 2040 fall", 2235621600, -14400, -18000)
  tzrCheckEdge(ny, "host NY 2100 spring", 4108690800, -18000, -14400)
  tzrCheckEdge(ny, "host NY 2100 fall", 4129250400, -14400, -18000)
  let london = tzrHostZone("Europe/London")
  tzrCheckEdge(london, "host London 2040 spring", 2216250000, 0, 3600)
  tzrCheckEdge(london, "host London 2100 fall", 4128627600, 3600, 0)
  let lh = tzrHostZone("Australia/Lord_Howe")
  tzrCheckEdge(lh, "host Lord Howe 2040 DST end", 2216818800, 39600, 37800)
  tzrCheckEdge(lh, "host Lord Howe 2100 DST start", 4126174200, 37800, 39600)
}

test "host Asia/Tokyo is JST +09:00 in 2040 and 2100 (fixed footer)" {
  let tokyo = tzrHostZone("Asia/Tokyo")
  assert(
    zoneOffsetAt(tokyo, 2215062000) == 32400,
    "Tokyo 2040 is ${zoneOffsetAt(tokyo, 2215062000)}",
  )
  assert(
    zoneOffsetAt(tokyo, 4108690800) == 32400,
    "Tokyo 2100 is ${zoneOffsetAt(tokyo, 4108690800)}",
  )
  assert(!zoneIsDstAt(tokyo, 4108690800), "Tokyo is never daylight saving")
}

test "host New York July 2040 through Timestamp.inZone is EDT (-14400), the #6375 probe" {
  let ny = tzrHostZone("America/New_York")
  let july = Timestamp{ ns = 2224756800 * 1000000000 }
  assert(july.inZone(ny).offset() == -14400, "offset is ${july.inZone(ny).offset()}, want -14400")
  assert(july.inZone(ny).isDst(), "July 2040 in New York is not flagged daylight saving")
}
