// stdlib/time/timeofday.test.bit — Time construction, validation, field
// accessors and toString (#4073). Same module as ./timeofday.bit (SPEC
// §19): no import needed to reach `time`/`timeNs`/`Time`.

// True when `time(h, m, s)` fails.
fn timeFails(h: int, m: int, s: int): bool {
  time(h, m, s) catch _ {
    return true
  }
  return false
}

// True when `timeNs(h, m, s, ns)` fails.
fn timeNsFails(h: int, m: int, s: int, ns: int): bool {
  timeNs(h, m, s, ns) catch _ {
    return true
  }
  return false
}

// --- construction: the representable range's own edges ---------------------

test "time accepts the representable range's boundaries, 00:00:00 and 23:59:59" {
  assert(!timeFails(0, 0, 0), "time(0,0,0) failed, want success (the day's first second)")
  assert(!timeFails(23, 59, 59), "time(23,59,59) failed, want success (the day's last second)")
}

test "time rejects hour 24 -- no end-of-day alias" {
  assert(timeFails(24, 0, 0), "time(24,0,0) succeeded, want fail (hour 24 is out of range)")
}

test "time rejects hour -1 and hour 24" {
  assert(timeFails(0 - 1, 0, 0), "time(-1,0,0) succeeded, want fail (hour out of range)")
  assert(timeFails(24, 0, 0), "time(24,0,0) succeeded, want fail (hour out of range)")
}

test "time rejects minute 60" {
  assert(timeFails(0, 60, 0), "time(0,60,0) succeeded, want fail (minute out of range)")
}

test "time accepts minute 59, the boundary just inside range" {
  assert(!timeFails(0, 59, 0), "time(0,59,0) failed, want success (minute 59 is in range)")
}

test "time rejects second 60 -- no leap seconds in this module" {
  assert(timeFails(23, 59, 60), "time(23,59,60) succeeded, want fail (no leap seconds)")
}

test "time accepts second 59, the boundary just inside range" {
  assert(!timeFails(0, 0, 59), "time(0,0,59) failed, want success (second 59 is in range)")
}

// --- timeNs: the extra nanosecond field -------------------------------------

test "timeNs accepts nanosecond 0 and nanosecond 999999999" {
  assert(!timeNsFails(0, 0, 0, 0), "timeNs(0,0,0,0) failed, want success")
  assert(
    !timeNsFails(0, 0, 0, 999999999),
    "timeNs(0,0,0,999999999) failed, want success (max representable nanosecond)",
  )
}

test "timeNs rejects nanosecond 1000000000 -- one whole second, out of range" {
  assert(
    timeNsFails(0, 0, 0, 1000000000),
    "timeNs(0,0,0,1000000000) succeeded, want fail (nanosecond out of range)",
  )
}

test "timeNs rejects a negative nanosecond" {
  assert(
    timeNsFails(0, 0, 0, 0 - 1),
    "timeNs(0,0,0,-1) succeeded, want fail (nanosecond out of range)",
  )
}

test "timeNs shares time's hour/minute/second validation" {
  assert(timeNsFails(24, 0, 0, 0), "timeNs(24,0,0,0) succeeded, want fail (hour out of range)")
  assert(timeNsFails(0, 60, 0, 0), "timeNs(0,60,0,0) succeeded, want fail (minute out of range)")
  assert(timeNsFails(23, 59, 60, 0), "timeNs(23,59,60,0) succeeded, want fail (no leap seconds)")
}

// --- fields and toString -----------------------------------------------

test "hour, minute, second, nanosecond and toString for 09:00:00" {
  let t = time(9, 0, 0) catch e {
    assert(false, "time(9,0,0) failed: ${e.message()}")
    return
  }
  assert(t.hour() == 9, "hour() = ${t.hour()}, want 9")
  assert(t.minute() == 0, "minute() = ${t.minute()}, want 0")
  assert(t.second() == 0, "second() = ${t.second()}, want 0")
  assert(t.nanosecond() == 0, "nanosecond() = ${t.nanosecond()}, want 0")
  assert(t.toString() == "09:00:00", "toString() = ${t.toString()}, want 09:00:00")
}

test "toString appends exactly nine fractional digits, never a shorter form" {
  let t = timeNs(9, 0, 0, 500) catch e {
    assert(false, "timeNs(9,0,0,500) failed: ${e.message()}")
    return
  }
  assert(t.nanosecond() == 500, "nanosecond() = ${t.nanosecond()}, want 500")
  assert(
    t.toString() == "09:00:00.000000500",
    "toString() = ${t.toString()}, want 09:00:00.000000500",
  )
}

test "toString pads every single-digit field" {
  let t = time(1, 2, 3) catch e {
    assert(false, "time(1,2,3) failed: ${e.message()}")
    return
  }
  assert(t.toString() == "01:02:03", "toString() = ${t.toString()}, want 01:02:03")
}

test "toString at the day's last second, with a one-nanosecond fraction" {
  let t = timeNs(23, 59, 59, 1) catch e {
    assert(false, "timeNs(23,59,59,1) failed: ${e.message()}")
    return
  }
  assert(
    t.toString() == "23:59:59.000000001",
    "toString() = ${t.toString()}, want 23:59:59.000000001",
  )
}
