// stdlib/time/bounds.test.bit — the period-boundary family (#4077). Same
// module as ./bounds.bit, ./date.bit, ./naive.bit and ./zoned.bit (SPEC
// §19): no import needed to reach `date`, `zone`, `Date`, `NaiveDateTime`
// or `DateTime`.
//
// Every expected value below is quoted from docs/stdlib/time.md's
// "Boundaries" table (2026-09-17, a Thursday) or derived from a calendar
// fact this module already pins elsewhere, never from this file's own
// output:
//
//   2026-09-01 is a Tuesday — ./naive.test.bit's own inherited value
//   (dow = 2) — which puts 2026-09-17 on a Thursday, as the doc says, and
//   2026-10-01 on a Thursday too.
//   Europe/London's 2026 spring-forward is 2026-03-29T01:00:00Z, GMT(0) ->
//   BST(3600) — ./zone.test.bit's header, cross-checked there against this
//   host's `zdump -v`, never against this module's output.
//   2024 is a leap year and 2026 is not, so February is 29 and 28 days.

// `date(y, m, d)`, for a triple this file already knows is a real calendar
// date. Every call below passes literal constants, so the failure path is
// unreachable; it panics rather than returning a substitute date, the same
// way `stdlib/time/arith.bit`'s `addMonths` treats its own impossible
// `unixFromCivil` failure — a silently substituted date would make every
// assertion downstream of it meaningless.
fn boundsTestDate(y: int, m: int, d: int): Date {
  return date(y, m, d) catch e {
    panic("date(${y}, ${m}, ${d}) failed: ${e.message()}")
  }
}

// `y-m-d` at midnight, as a wall clock with no zone. Same unreachable
// failure path as `boundsTestDate`.
fn boundsTestNaive(y: int, m: int, d: int, h: int, min: int, s: int): NaiveDateTime {
  return boundsTestDate(y, m, d).atTime(h, min, s) catch e {
    panic("atTime(${h}, ${min}, ${s}) failed: ${e.message()}")
  }
}

test "Date: the doc's worked example, every boundary of 2026-09-17" {
  let d = boundsTestDate(2026, 9, 17)
  assert(d.dayOfWeek() == 4, "2026-09-17 dayOfWeek = ${d.dayOfWeek()}, want 4 (Thursday)")
  assert(
    d.startOfDay().toString() == "2026-09-17",
    "startOfDay = ${d.startOfDay().toString()}, want 2026-09-17",
  )
  assert(
    d.endOfDay().toString() == "2026-09-17",
    "endOfDay = ${d.endOfDay().toString()}, want 2026-09-17",
  )
  assert(
    d.startOfWeek().toString() == "2026-09-14",
    "startOfWeek = ${d.startOfWeek().toString()}, want 2026-09-14",
  )
  assert(
    d.endOfWeek().toString() == "2026-09-20",
    "endOfWeek = ${d.endOfWeek().toString()}, want 2026-09-20",
  )
  assert(
    d.startOfMonth().toString() == "2026-09-01",
    "startOfMonth = ${d.startOfMonth().toString()}, want 2026-09-01",
  )
  assert(
    d.endOfMonth().toString() == "2026-09-30",
    "endOfMonth = ${d.endOfMonth().toString()}, want 2026-09-30",
  )
  assert(
    d.startOfQuarter().toString() == "2026-07-01",
    "startOfQuarter = ${d.startOfQuarter().toString()}, want 2026-07-01",
  )
  assert(
    d.endOfQuarter().toString() == "2026-09-30",
    "endOfQuarter = ${d.endOfQuarter().toString()}, want 2026-09-30",
  )
  assert(
    d.startOfYear().toString() == "2026-01-01",
    "startOfYear = ${d.startOfYear().toString()}, want 2026-01-01",
  )
  assert(
    d.endOfYear().toString() == "2026-12-31",
    "endOfYear = ${d.endOfYear().toString()}, want 2026-12-31",
  )
}

test "Date: the week starts on Monday, and the Monday of a week is its own start" {
  // Every day of the week containing 2026-09-17 floors to the same Monday
  // and ceilings to the same Sunday — including the Monday and the Sunday
  // themselves, the two off-by-one candidates.
  let day = 14
  while (day <= 20) {
    let d = boundsTestDate(2026, 9, day)
    assert(
      d.startOfWeek().toString() == "2026-09-14",
      "2026-09-${day} startOfWeek = ${d.startOfWeek().toString()}, want 2026-09-14",
    )
    assert(
      d.endOfWeek().toString() == "2026-09-20",
      "2026-09-${day} endOfWeek = ${d.endOfWeek().toString()}, want 2026-09-20",
    )
    day = day + 1
  }
}

test "Date: startOfWeekOn takes an explicit first day, 1 Monday .. 7 Sunday" {
  let d = boundsTestDate(2026, 9, 17)
  assert(
    d.startOfWeekOn(7).toString() == "2026-09-13",
    "startOfWeekOn(7) = ${d.startOfWeekOn(7).toString()}, want 2026-09-13",
  )
  assert(
    d.endOfWeekOn(7).toString() == "2026-09-19",
    "endOfWeekOn(7) = ${d.endOfWeekOn(7).toString()}, want 2026-09-19",
  )
  assert(
    d.startOfWeekOn(1).toString() == d.startOfWeek().toString(),
    "startOfWeekOn(1) = ${d.startOfWeekOn(1).toString()}, want startOfWeek()",
  )
  // 6 is Saturday: the week containing Thursday 2026-09-17 starts on
  // Saturday 2026-09-12 and ends on Friday 2026-09-18.
  assert(
    d.startOfWeekOn(6).toString() == "2026-09-12",
    "startOfWeekOn(6) = ${d.startOfWeekOn(6).toString()}, want 2026-09-12",
  )
  assert(
    d.endOfWeekOn(6).toString() == "2026-09-18",
    "endOfWeekOn(6) = ${d.endOfWeekOn(6).toString()}, want 2026-09-18",
  )
}

test "Date: an out-of-range first day clamps to Monday or Sunday, it never wraps" {
  let d = boundsTestDate(2026, 9, 17)
  assert(
    d.startOfWeekOn(0).toString() == "2026-09-14",
    "startOfWeekOn(0) = ${d.startOfWeekOn(0).toString()}, want 2026-09-14 (clamped to Monday)",
  )
  assert(
    d.startOfWeekOn(-7).toString() == "2026-09-14",
    "startOfWeekOn(-7) = ${d.startOfWeekOn(-7).toString()}, want 2026-09-14 (clamped to Monday)",
  )
  assert(
    d.startOfWeekOn(8).toString() == "2026-09-13",
    "startOfWeekOn(8) = ${d.startOfWeekOn(8).toString()}, want 2026-09-13 (clamped to Sunday)",
  )
}

test "Date: a week crossing a month boundary keeps the whole week" {
  // 2026-10-01 is a Thursday: its ISO week starts in September and ends in
  // October.
  let d = boundsTestDate(2026, 10, 1)
  assert(d.dayOfWeek() == 4, "2026-10-01 dayOfWeek = ${d.dayOfWeek()}, want 4 (Thursday)")
  assert(
    d.startOfWeek().toString() == "2026-09-28",
    "startOfWeek = ${d.startOfWeek().toString()}, want 2026-09-28",
  )
  assert(
    d.endOfWeek().toString() == "2026-10-04",
    "endOfWeek = ${d.endOfWeek().toString()}, want 2026-10-04",
  )
  // A week crossing a year boundary, the same shape: 2027-01-01 is a
  // Friday (2026-12-31 is a Thursday, one day after 2026-12-30).
  let ny = boundsTestDate(2027, 1, 1)
  assert(
    ny.startOfWeek().toString() == "2026-12-28",
    "2027-01-01 startOfWeek = ${ny.startOfWeek().toString()}, want 2026-12-28",
  )
  assert(
    ny.endOfWeek().toString() == "2027-01-03",
    "2027-01-01 endOfWeek = ${ny.endOfWeek().toString()}, want 2027-01-03",
  )
}

test "Date: endOfMonth is 28, 29, 30 or 31, derived from the month and the year" {
  assert(
    boundsTestDate(2026, 2, 10).endOfMonth().toString() == "2026-02-28",
    "February 2026 endOfMonth = ${boundsTestDate(2026, 2, 10).endOfMonth().toString()}, want 2026-02-28",
  )
  assert(
    boundsTestDate(2024, 2, 10).endOfMonth().toString() == "2024-02-29",
    "February 2024 endOfMonth = ${boundsTestDate(2024, 2, 10).endOfMonth().toString()}, want 2024-02-29",
  )
  assert(
    boundsTestDate(2026, 1, 5).endOfMonth().toString() == "2026-01-31",
    "January 2026 endOfMonth = ${boundsTestDate(2026, 1, 5).endOfMonth().toString()}, want 2026-01-31",
  )
  assert(
    boundsTestDate(2026, 4, 5).endOfMonth().toString() == "2026-04-30",
    "April 2026 endOfMonth = ${boundsTestDate(2026, 4, 5).endOfMonth().toString()}, want 2026-04-30",
  )
  // 1900 is not a leap year and 2000 is — the century rule, the same pair
  // `Date.isLeapYear` pins.
  assert(
    boundsTestDate(1900, 2, 1).endOfMonth().toString() == "1900-02-28",
    "February 1900 endOfMonth = ${boundsTestDate(1900, 2, 1).endOfMonth().toString()}, want 1900-02-28",
  )
  assert(
    boundsTestDate(2000, 2, 1).endOfMonth().toString() == "2000-02-29",
    "February 2000 endOfMonth = ${boundsTestDate(2000, 2, 1).endOfMonth().toString()}, want 2000-02-29",
  )
}

test "Date: every quarter's first and last day, leap February included" {
  assert(
    boundsTestDate(2026, 1, 1).startOfQuarter().toString() == "2026-01-01",
    "Q1 start = ${boundsTestDate(2026, 1, 1).startOfQuarter().toString()}, want 2026-01-01",
  )
  assert(
    boundsTestDate(2026, 2, 28).endOfQuarter().toString() == "2026-03-31",
    "Q1 end = ${boundsTestDate(2026, 2, 28).endOfQuarter().toString()}, want 2026-03-31",
  )
  assert(
    boundsTestDate(2026, 6, 30).startOfQuarter().toString() == "2026-04-01",
    "Q2 start = ${boundsTestDate(2026, 6, 30).startOfQuarter().toString()}, want 2026-04-01",
  )
  assert(
    boundsTestDate(2026, 4, 1).endOfQuarter().toString() == "2026-06-30",
    "Q2 end = ${boundsTestDate(2026, 4, 1).endOfQuarter().toString()}, want 2026-06-30",
  )
  assert(
    boundsTestDate(2026, 9, 30).startOfQuarter().toString() == "2026-07-01",
    "Q3 start = ${boundsTestDate(2026, 9, 30).startOfQuarter().toString()}, want 2026-07-01",
  )
  assert(
    boundsTestDate(2026, 12, 31).startOfQuarter().toString() == "2026-10-01",
    "Q4 start = ${boundsTestDate(2026, 12, 31).startOfQuarter().toString()}, want 2026-10-01",
  )
  assert(
    boundsTestDate(2026, 10, 1).endOfQuarter().toString() == "2026-12-31",
    "Q4 end = ${boundsTestDate(2026, 10, 1).endOfQuarter().toString()}, want 2026-12-31",
  )
  // The quarter containing a leap February still ends on 31 March: the
  // quarter's last month is not the receiver's month.
  assert(
    boundsTestDate(2024, 2, 29).endOfQuarter().toString() == "2024-03-31",
    "2024 Q1 end = ${boundsTestDate(2024, 2, 29).endOfQuarter().toString()}, want 2024-03-31",
  )
}

test "NaiveDateTime: every boundary sets the time of day as well as the date" {
  let n = boundsTestNaive(2026, 9, 17, 13, 45, 30)
  assert(
    n.startOfDay().toString() == "2026-09-17T00:00:00",
    "startOfDay = ${n.startOfDay().toString()}, want 2026-09-17T00:00:00",
  )
  assert(
    n.endOfDay().toString() == "2026-09-17T23:59:59.999999999",
    "endOfDay = ${n.endOfDay().toString()}, want 2026-09-17T23:59:59.999999999",
  )
  assert(
    n.endOfDay().nanosecond() == 999999999,
    "endOfDay nanosecond = ${n.endOfDay().nanosecond()}, want 999999999",
  )
  assert(
    n.startOfWeek().toString() == "2026-09-14T00:00:00",
    "startOfWeek = ${n.startOfWeek().toString()}, want 2026-09-14T00:00:00",
  )
  assert(
    n.endOfWeek().toString() == "2026-09-20T23:59:59.999999999",
    "endOfWeek = ${n.endOfWeek().toString()}, want 2026-09-20T23:59:59.999999999",
  )
  assert(
    n.startOfWeekOn(7).toString() == "2026-09-13T00:00:00",
    "startOfWeekOn(7) = ${n.startOfWeekOn(7).toString()}, want 2026-09-13T00:00:00",
  )
  assert(
    n.endOfWeekOn(7).toString() == "2026-09-19T23:59:59.999999999",
    "endOfWeekOn(7) = ${n.endOfWeekOn(7).toString()}, want 2026-09-19T23:59:59.999999999",
  )
  assert(
    n.startOfMonth().toString() == "2026-09-01T00:00:00",
    "startOfMonth = ${n.startOfMonth().toString()}, want 2026-09-01T00:00:00",
  )
  assert(
    n.endOfMonth().toString() == "2026-09-30T23:59:59.999999999",
    "endOfMonth = ${n.endOfMonth().toString()}, want 2026-09-30T23:59:59.999999999",
  )
  assert(
    n.startOfQuarter().toString() == "2026-07-01T00:00:00",
    "startOfQuarter = ${n.startOfQuarter().toString()}, want 2026-07-01T00:00:00",
  )
  assert(
    n.endOfQuarter().toString() == "2026-09-30T23:59:59.999999999",
    "endOfQuarter = ${n.endOfQuarter().toString()}, want 2026-09-30T23:59:59.999999999",
  )
  assert(
    n.startOfYear().toString() == "2026-01-01T00:00:00",
    "startOfYear = ${n.startOfYear().toString()}, want 2026-01-01T00:00:00",
  )
  assert(
    n.endOfYear().toString() == "2026-12-31T23:59:59.999999999",
    "endOfYear = ${n.endOfYear().toString()}, want 2026-12-31T23:59:59.999999999",
  )
}

test "NaiveDateTime: endOfMonth on a leap February is the 29th at the last nanosecond" {
  let n = boundsTestNaive(2024, 2, 10, 8, 0, 0)
  assert(
    n.endOfMonth().toString() == "2024-02-29T23:59:59.999999999",
    "endOfMonth = ${n.endOfMonth().toString()}, want 2024-02-29T23:59:59.999999999",
  )
  let common = boundsTestNaive(2026, 2, 10, 8, 0, 0)
  assert(
    common.endOfMonth().toString() == "2026-02-28T23:59:59.999999999",
    "endOfMonth = ${common.endOfMonth().toString()}, want 2026-02-28T23:59:59.999999999",
  )
}

test "DateTime: a day carrying a DST transition ends at a different offset than it starts" {
  let london = zone("Europe/London") catch e {
    assert(false, "zone(Europe/London) failed: ${e.message()}")
    return
  }
  // 2026-03-29 is the spring-forward day: 01:00 GMT becomes 02:00 BST
  // (./zone.test.bit's header). Midnight is before the transition, the
  // last nanosecond of the day is after it, so the two boundaries must
  // resolve to different offsets — which they only can because both go
  // through `inZone` rather than through instant arithmetic.
  let z = boundsTestNaive(2026, 3, 29, 12, 0, 0).inZone(london)
  assert(
    z.startOfDay().toString() == "2026-03-29T00:00:00+00:00",
    "startOfDay = ${z.startOfDay().toString()}, want 2026-03-29T00:00:00+00:00",
  )
  assert(
    z.endOfDay().toString() == "2026-03-29T23:59:59.999999999+01:00",
    "endOfDay = ${z.endOfDay().toString()}, want 2026-03-29T23:59:59.999999999+01:00",
  )
  assert(
    z.startOfDay().offset() == 0,
    "startOfDay offset = ${z.startOfDay().offset()}, want 0 (GMT)",
  )
  assert(
    z.endOfDay().offset() == 3600,
    "endOfDay offset = ${z.endOfDay().offset()}, want 3600 (BST)",
  )
  // The same split across a whole month: March 2026 starts in GMT and ends
  // in BST.
  assert(
    z.startOfMonth().toString() == "2026-03-01T00:00:00+00:00",
    "startOfMonth = ${z.startOfMonth().toString()}, want 2026-03-01T00:00:00+00:00",
  )
  assert(
    z.endOfMonth().toString() == "2026-03-31T23:59:59.999999999+01:00",
    "endOfMonth = ${z.endOfMonth().toString()}, want 2026-03-31T23:59:59.999999999+01:00",
  )
}

test "DateTime: the autumn overlap day, and a zone with no transition at all" {
  let london = zone("Europe/London") catch e {
    assert(false, "zone(Europe/London) failed: ${e.message()}")
    return
  }
  // 2026-10-25 is the fall-back day: 02:00 BST becomes 01:00 GMT
  // (./zone.test.bit's header), so this day starts in BST and ends in GMT
  // — the mirror of the March case.
  let autumn = boundsTestNaive(2026, 10, 25, 12, 0, 0).inZone(london)
  assert(
    autumn.startOfDay().toString() == "2026-10-25T00:00:00+01:00",
    "startOfDay = ${autumn.startOfDay().toString()}, want 2026-10-25T00:00:00+01:00",
  )
  assert(
    autumn.endOfDay().toString() == "2026-10-25T23:59:59.999999999+00:00",
    "endOfDay = ${autumn.endOfDay().toString()}, want 2026-10-25T23:59:59.999999999+00:00",
  )
  // Asia/Dubai has one transition, in 1919, and +04:00 forever after
  // (./zone.test.bit's header): every boundary keeps the same offset.
  let dubai = zone("Asia/Dubai") catch e {
    assert(false, "zone(Asia/Dubai) failed: ${e.message()}")
    return
  }
  let d = boundsTestNaive(2026, 9, 17, 9, 0, 0).inZone(dubai)
  assert(
    d.startOfDay().toString() == "2026-09-17T00:00:00+04:00",
    "startOfDay = ${d.startOfDay().toString()}, want 2026-09-17T00:00:00+04:00",
  )
  assert(
    d.endOfQuarter().toString() == "2026-09-30T23:59:59.999999999+04:00",
    "endOfQuarter = ${d.endOfQuarter().toString()}, want 2026-09-30T23:59:59.999999999+04:00",
  )
  assert(
    d.startOfYear().toString() == "2026-01-01T00:00:00+04:00",
    "startOfYear = ${d.startOfYear().toString()}, want 2026-01-01T00:00:00+04:00",
  )
  assert(
    d.startOfWeekOn(7).toString() == "2026-09-13T00:00:00+04:00",
    "startOfWeekOn(7) = ${d.startOfWeekOn(7).toString()}, want 2026-09-13T00:00:00+04:00",
  )
}
