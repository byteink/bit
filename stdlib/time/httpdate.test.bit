// stdlib/time/httpdate.test.bit — `formatHttpDate` and `parseHttpDate`
// (./httpdate.bit, #6573). Same module as ./httpdate.bit (SPEC §19): no
// import is needed to reach `Timestamp`, `HttpDateError` or `HttpDateCause`.
//
// Every expected instant below is an input, never an output of this
// module. The first three spellings and the instant behind them are RFC
// 9110 section 5.6.7's own example; the epoch seconds, weekdays and range
// ends were computed with Python's `calendar.timegm` and `strftime`:
//   Sun, 06 Nov 1994 08:49:37 GMT   784111777
//   Sat, 06 Nov 2094 08:49:37 GMT   3939871777
//   Sun, 06 Nov 2044 08:49:37 GMT   2362034977
//   Sun, 29 Feb 2060 00:00:00 GMT   2845238400
//   Mon, 29 Feb 1960 00:00:00 GMT   -310521600
//   Wed, 31 Dec 1969 23:59:59 GMT   -1
//   Tue, 29 Feb 2000 23:59:59 GMT   951868799
//   Fri, 11 Apr 2262 23:47:16 GMT   9223372036   (last second a Timestamp holds)
//   Tue, 21 Sep 1677 00:12:44 GMT   -9223372036  (first)
// A parser tested against its own formatter agrees with itself, so the
// formatter is pinned to these strings too, not only round-tripped.

const hdtNs: int = 1000000000
const hdtRfcInstant: int = 784111777

fn hdtAt(secs: int): Timestamp {
  return Timestamp{ ns = secs * hdtNs }
}

// The reference the RFC 850 century is read against in every test that does
// not name its own: 2026-10-03T12:00:00Z (python: timegm 1791028800).
fn hdtRef(): Timestamp {
  return hdtAt(1791028800)
}

// The parse of `s` as whole seconds, or the failure's cause name prefixed
// `ERR:`. A success cannot start with `ERR:`, so an expected failure cannot
// pass on a success.
fn hdtRead(s: string, ref: Timestamp): string {
  let t = parseHttpDate(s, ref) catch e {
    let he = e.(HttpDateError)
    match (he.cause) {
      Syntax => return "ERR:Syntax"
      Range => return "ERR:Range"
      Zone => return "ERR:Zone"
      Weekday => return "ERR:Weekday"
    }
  }
  return "${t.ns / hdtNs}"
}

fn hdtSecs(s: string): string {
  return hdtRead(s, hdtRef())
}

test "RFC 9110 5.6.7's three spellings parse to the same instant" {
  assert(hdtSecs("Sun, 06 Nov 1994 08:49:37 GMT") == "784111777", "IMF-fixdate")
  assert(hdtSecs("Sunday, 06-Nov-94 08:49:37 GMT") == "784111777", "RFC 850")
  assert(hdtSecs("Sun Nov  6 08:49:37 1994") == "784111777", "asctime")
}

test "parseHttpDate keeps the nanosecond count whole seconds times 1e9" {
  let t = parseHttpDate("Sun, 06 Nov 1994 08:49:37 GMT", hdtRef()) catch _ {
    assert(false, "parse failed")
    return
  }
  assert(t.ns == 784111777000000000, "ns ${t.ns}")
}

test "formatHttpDate writes IMF-fixdate" {
  assert(formatHttpDate(hdtAt(hdtRfcInstant)) == "Sun, 06 Nov 1994 08:49:37 GMT", "RFC example")
  assert(formatHttpDate(hdtAt(0)) == "Thu, 01 Jan 1970 00:00:00 GMT", "epoch")
  assert(
    formatHttpDate(hdtAt(-1)) == "Wed, 31 Dec 1969 23:59:59 GMT",
    "one second before the epoch",
  )
  assert(formatHttpDate(hdtAt(951868799)) == "Tue, 29 Feb 2000 23:59:59 GMT", "leap day")
  assert(
    formatHttpDate(hdtAt(2845238400)) == "Sun, 29 Feb 2060 00:00:00 GMT",
    "leap day, zero-padded clock",
  )
  assert(
    formatHttpDate(hdtAt(9223372036)) == "Fri, 11 Apr 2262 23:47:16 GMT",
    "last representable second",
  )
  assert(
    formatHttpDate(hdtAt(-9223372036)) == "Tue, 21 Sep 1677 00:12:44 GMT",
    "first representable second",
  )
}

test "formatHttpDate drops a fraction toward the past" {
  let up = Timestamp{ ns = hdtRfcInstant * hdtNs + 999999999 }
  assert(formatHttpDate(up) == "Sun, 06 Nov 1994 08:49:37 GMT", "fraction after the second")
  let before = Timestamp{ ns = -1 }
  assert(formatHttpDate(before) == "Wed, 31 Dec 1969 23:59:59 GMT", "-1ns is still 23:59:59")
}

test "format then parse round-trips across the whole range" {
  let secs = -9223372036
  let n = 0
  while (secs <= 9223372036 && n < 2000) {
    let s = formatHttpDate(hdtAt(secs))
    assert(hdtSecs(s) == "${secs}", "round trip of ${secs} via '${s}' read ${hdtSecs(s)}")
    secs = secs + 9223372036 / 1000
    n = n + 1
  }
  assert(hdtSecs(formatHttpDate(hdtAt(9223372036))) == "9223372036", "last second")
}

test "asctime reads a one-digit and a two-digit day" {
  assert(hdtSecs("Wed Dec 31 23:59:59 1969") == "-1", "two-digit day")
  assert(hdtSecs("Sun Nov  6 08:49:37 1994") == "784111777", "space-padded day")
  assert(hdtSecs("Sun Nov 06 08:49:37 1994") == "784111777", "zero-padded day is two digits too")
}

test "an RFC 850 year is placed by the 50-year rule" {
  assert(hdtSecs("Sunday, 06-Nov-94 08:49:37 GMT") == "784111777", "94 is 1994 against 2026")
  assert(
    hdtSecs("Sunday, 29-Feb-60 00:00:00 GMT") == "2845238400",
    "60 is 2060 against 2026, 34 years ahead",
  )
  assert(
    hdtRead("Monday, 29-Feb-60 00:00:00 GMT", hdtAt(hdtRfcInstant)) == "-310521600",
    "60 is 1960 against 1994",
  )
  assert(
    hdtRead("Sunday, 06-Nov-94 08:49:37 GMT", hdtAt(hdtRfcInstant)) == "784111777",
    "94 is 1994 against 1994",
  )
}

test "an RFC 850 year exactly 50 years ahead stays, one second more goes back a century" {
  // 2094-11-06T08:49:37Z is a Saturday, 1994-11-06T08:49:37Z a Sunday: the
  // weekday in the input says which century the parser chose.
  let atLimit = hdtAt(2362034977) // 2044-11-06T08:49:37Z, python timegm
  let justUnder = hdtAt(2362034976)
  assert(
    hdtRead("Saturday, 06-Nov-94 08:49:37 GMT", atLimit) == "3939871777",
    "exactly 50 years is not more than 50",
  )
  assert(
    hdtRead("Sunday, 06-Nov-94 08:49:37 GMT", atLimit) == "ERR:Weekday",
    "2094 was chosen, and is no Sunday",
  )
  assert(
    hdtRead("Sunday, 06-Nov-94 08:49:37 GMT", justUnder) == "784111777",
    "one second over 50 years is 1994",
  )
  assert(
    hdtRead("Saturday, 06-Nov-94 08:49:37 GMT", justUnder) == "ERR:Weekday",
    "1994 was chosen, and is no Saturday",
  )
}

test "the default reference is the clock: an RFC 850 form of now reads back as now" {
  let n = now()
  let imf = formatHttpDate(n)
  let days = []string{
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday",
    "Sunday",
  }
  let full = ""
  let k = 0
  while (k < len(days)) {
    if (days[k][0:3] == imf[0:3]) {
      full = days[k]
    }
    k = k + 1
  }
  let r850 = full + ", " + imf[5:7] + "-" + imf[8:11] + "-" + imf[14:16] + imf[16:]
  let t = parseHttpDate(r850) catch e {
    assert(false, "'${r850}' failed: ${e.message()}")
    return
  }
  assert(t.ns / hdtNs == n.ns / hdtNs, "'${r850}' read ${t.ns / hdtNs}, now is ${n.ns / hdtNs}")
  let u = parseHttpDate(imf) catch _ {
    assert(false, "IMF with the default reference failed")
    return
  }
  assert(u.ns / hdtNs == n.ns / hdtNs, "IMF default reference")
}

test "a field no calendar has is Range" {
  assert(hdtSecs("Sun, 32 Nov 1994 08:49:37 GMT") == "ERR:Range", "day 32")
  assert(hdtSecs("Sun, 00 Nov 1994 08:49:37 GMT") == "ERR:Range", "day 0")
  assert(hdtSecs("Sun, 31 Nov 1994 08:49:37 GMT") == "ERR:Range", "31 November")
  assert(hdtSecs("Sun, 06 Nov 1994 24:49:37 GMT") == "ERR:Range", "hour 24")
  assert(hdtSecs("Sun, 06 Nov 1994 08:60:37 GMT") == "ERR:Range", "minute 60")
  assert(hdtSecs("Sun, 06 Nov 1994 08:49:60 GMT") == "ERR:Range", "second 60, no leap second")
  assert(hdtSecs("Sun, 06 Nov 0000 08:49:37 GMT") == "ERR:Range", "year 0")
  assert(hdtSecs("Wed, 29 Feb 1900 00:00:00 GMT") == "ERR:Range", "1900 is not a leap year")
  assert(hdtSecs("Sunday, 32-Nov-94 08:49:37 GMT") == "ERR:Range", "RFC 850 day 32")
  assert(hdtSecs("Sunday, 06-Nov-94 24:49:37 GMT") == "ERR:Range", "RFC 850 hour 24")
  assert(hdtSecs("Sun Nov 32 08:49:37 1994") == "ERR:Range", "asctime day 32")
  assert(hdtSecs("Sun Nov  6 24:49:37 1994") == "ERR:Range", "asctime hour 24")
  assert(hdtSecs("Sun Nov  0 08:49:37 1994") == "ERR:Range", "asctime day 0")
}

test "an instant a Timestamp cannot hold is Range, its neighbours are not" {
  assert(hdtSecs("Fri, 11 Apr 2262 23:47:16 GMT") == "9223372036", "last second")
  assert(hdtSecs("Fri, 11 Apr 2262 23:47:17 GMT") == "ERR:Range", "one second past")
  assert(hdtSecs("Tue, 21 Sep 1677 00:12:44 GMT") == "-9223372036", "first second")
  assert(hdtSecs("Tue, 21 Sep 1677 00:12:43 GMT") == "ERR:Range", "one second before")
  assert(hdtSecs("Fri, 31 Dec 9999 23:59:59 GMT") == "ERR:Range", "year 9999")
  assert(hdtSecs("Mon, 01 Jan 0001 00:00:00 GMT") == "ERR:Range", "year 1")
}

test "a zone other than GMT is Zone" {
  assert(hdtSecs("Sun, 06 Nov 1994 08:49:37 UTC") == "ERR:Zone", "UTC")
  assert(hdtSecs("Sun, 06 Nov 1994 08:49:37 +0000") == "ERR:Zone", "numeric offset")
  assert(hdtSecs("Sun, 06 Nov 1994 08:49:37 PST") == "ERR:Zone", "PST")
  assert(hdtSecs("Sun, 06 Nov 1994 08:49:37 gmt") == "ERR:Zone", "lowercase gmt")
  assert(hdtSecs("Sunday, 06-Nov-94 08:49:37 PST") == "ERR:Zone", "RFC 850 PST")
  assert(hdtSecs("Sunday, 06-Nov-94 08:49:37 +0100") == "ERR:Zone", "RFC 850 offset")
}

test "a day name that disagrees with the date is Weekday" {
  assert(hdtSecs("Mon, 06 Nov 1994 08:49:37 GMT") == "ERR:Weekday", "IMF")
  assert(hdtSecs("Monday, 06-Nov-94 08:49:37 GMT") == "ERR:Weekday", "RFC 850")
  assert(hdtSecs("Mon Nov  6 08:49:37 1994") == "ERR:Weekday", "asctime")
}

test "anything else is Syntax" {
  let bad = []string{
    "",
    "Sun",
    "Sun, 06 Nov 1994 08:49:37",
    " Sun, 06 Nov 1994 08:49:37 GMT",
    "Sun, 06 Nov 1994 08:49:37 GMT ",
    "Sun, 06 Nov 1994 08:49:37 GMT\r\n",
    "Sun, 06 Nov 1994 08:49:37  GMT",
    "Sun,  06 Nov 1994 08:49:37 GMT",
    "Sun, 6 Nov 1994 08:49:37 GMT",
    "sun, 06 Nov 1994 08:49:37 GMT",
    "SUN, 06 NOV 1994 08:49:37 GMT",
    "Sun, 06 nov 1994 08:49:37 GMT",
    "Sun, 06 Nov 94 08:49:37 GMT",
    "Sun, 06 Nov 1994 8:49:37 GMT",
    "Sun, 06 Nov 1994 08-49-37 GMT",
    "Sun, 0a Nov 1994 08:49:37 GMT",
    "Sun, +6 Nov 1994 08:49:37 GMT",
    "Sun, -6 Nov 1994 08:49:37 GMT",
    "Sun, 06 Foo 1994 08:49:37 GMT",
    "Sun, 06 Nov 1994 08:49:37 GMT, Sun, 06 Nov 1994 08:49:37 GMT",
    "1994-11-06T08:49:37Z",
    "784111777",
    "Sunday, 06-Nov-1994 08:49:37 GMT",
    "Sunday, 06 Nov 94 08:49:37 GMT",
    "Sunday,06-Nov-94 08:49:37 GMT",
    "Sunday, 06-Nov-94 08:49:37",
    "Sunday, 06-Nov-94 08:49:37 GMT ",
    "sunday, 06-Nov-94 08:49:37 GMT",
    "Sun, 06-Nov-94 08:49:37 GMT",
    "Sunday, 6-Nov-94 08:49:37 GMT",
    "Sun Nov 6 08:49:37 1994",
    "Sun Nov  6 08:49:37 1994 ",
    "Sun Nov  6 08:49:37 1994 GMT",
    "Sun Nov  6 08:49:37 1994 PST",
    "Sun Nov  6 08:49:37 94",
    "Sun Nov  6 08:49:37  1994",
    "sun Nov  6 08:49:37 1994",
    "Sun nov  6 08:49:37 1994",
    "Sun Nov  x 08:49:37 1994",
    "Sun Nov  6 08.49.37 1994",
    "Sun Nov   6 08:49:37 1994",
  }
  let k = 0
  while (k < len(bad)) {
    let r = hdtSecs(bad[k])
    assert(r == "ERR:Syntax", "'${bad[k]}' read ${r}, want ERR:Syntax")
    k = k + 1
  }
}

test "every proper prefix of each valid form fails, and none traps" {
  let good = []string{
    "Sun, 06 Nov 1994 08:49:37 GMT",
    "Sunday, 06-Nov-94 08:49:37 GMT",
    "Sun Nov  6 08:49:37 1994",
  }
  let k = 0
  while (k < len(good)) {
    let s = good[k]
    k = k + 1
    let n = 0
    while (n < len(s)) {
      let r = hdtSecs(s[0:n])
      assert(len(r) > 4 && r[0:4] == "ERR:", "prefix '${s[0:n]}' of '${s}' read ${r}")
      n = n + 1
    }
  }
}

test "replacing any single byte of a valid form with X fails" {
  let good = []string{
    "Sun, 06 Nov 1994 08:49:37 GMT",
    "Sunday, 06-Nov-94 08:49:37 GMT",
    "Sun Nov  6 08:49:37 1994",
  }
  let k = 0
  while (k < len(good)) {
    let s = good[k]
    k = k + 1
    let i = 0
    while (i < len(s)) {
      let m = s[0:i] + "X" + s[i + 1:]
      let r = hdtSecs(m)
      assert(len(r) > 4 && r[0:4] == "ERR:", "'${m}' read ${r}")
      i = i + 1
    }
  }
}

test "non-ASCII and NUL bytes fail without trapping" {
  assert(
    hdtSecs("Sun, 06 Nov 1994 08:49:37 GM\u{e9}") == "ERR:Syntax",
    "multi-byte after the clock",
  )
  assert(hdtSecs("Sun, 06 Nov 1994 08:49:37\u{a0}GMT") == "ERR:Syntax", "no-break space")
  assert(hdtSecs("Sun, 06 Nov 1994 08:49:37\0GMT") == "ERR:Syntax", "NUL for the space")
  assert(hdtSecs("Sun, 06 Nov 1994 08:49:37 GMT\0") == "ERR:Syntax", "NUL after the zone")
  assert(
    hdtSecs("\u{e9}\u{e9}\u{e9}, 06 Nov 1994 08:49:37 GMT") == "ERR:Syntax",
    "non-ASCII day name",
  )
}

test "the error carries its cause and the refused input" {
  let s = "Sun, 32 Nov 1994 08:49:37 GMT"
  let t = parseHttpDate(s, hdtRef()) catch e {
    let he = e.(HttpDateError)
    assert(he.input == s, "input not kept")
    assert(len(he.message()) > 0, "empty message")
    assert(len(he.message()) < len(s) + 64, "message is a fixed sentence")
    return
  }
  assert(false, "day 32 parsed to ${t.ns}")
}
