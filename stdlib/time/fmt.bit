// Bit standard library — time module, human-readable formatting.
//
// Sibling of `time.bit` and `civil.bit`; shares the module's flat namespace,
// so `civilFromUnix` and `Civil` below are the symbols `civil.bit` exports.
// Every private helper here is prefixed `fmt` to stay out of that namespace's
// way.

// The strftime subset `formatUnix` understands. Every other character in
// `layout` is copied through unchanged:
//
//   %Y  year, at least four digits, zero padded (more than four if needed)
//   %m  month,  two digits, zero padded (01-12)
//   %d  day,    two digits, zero padded (01-31)
//   %H  hour,   two digits, zero padded (00-23)
//   %M  minute, two digits, zero padded (00-59)
//   %S  second, two digits, zero padded (00-59)
//   %%  a literal `%`
//
// An unrecognized `%x` pair is copied through unchanged, both characters —
// including a `%` with nothing recognized after it. A trailing lone `%` (no
// character follows it in `layout`) is copied through as-is.
export fn formatUnix(ns: int, layout: string): string {
  return fmtLayout(civilFromUnix(ns), layout)
}

// RFC 3339, always UTC (`Z`, never a numeric `±HH:MM` offset — this module
// has no notion of a non-UTC zone). Seconds are always shown; a nonzero
// nanosecond field is appended as `.` plus exactly nine zero-padded digits
// (RFC 3339 §5.6 `time-secfrac`), so 500 nanoseconds prints `.000000500`, not
// `.5`. A zero nanosecond field prints no fractional part at all.
export fn formatRfc3339(ns: int): string {
  let c = civilFromUnix(ns)
  let base = fmtLayout(c, "%Y-%m-%dT%H:%M:%S")
  if (c.nanosecond == 0) {
    return base + "Z"
  }
  return base + "." + fmtPad(c.nanosecond, 9) + "Z"
}

// Renders `layout` against `c`, substituting the verbs documented above.
fn fmtLayout(c: Civil, layout: string): string {
  let out = ""
  let i = 0
  let n = len(layout)
  while (i < n) {
    if (layout[i] != '%') {
      out = out + layout[i:i + 1]
      i = i + 1
      continue
    }
    if (i + 1 >= n) {
      out = out + "%"
      i = i + 1
      continue
    }
    out = out + fmtVerb(c, layout[i + 1], layout[i:i + 2])
    i = i + 2
  }
  return out
}

// The replacement for one `%<verb>` pair, or `raw` (the pair itself)
// unchanged when `verb` is not one of the recognized letters.
fn fmtVerb(c: Civil, verb: u8, raw: string): string {
  if (verb == 'Y') {
    return fmtPad(c.year, 4)
  }
  if (verb == 'm') {
    return fmtPad(c.month, 2)
  }
  if (verb == 'd') {
    return fmtPad(c.day, 2)
  }
  if (verb == 'H') {
    return fmtPad(c.hour, 2)
  }
  if (verb == 'M') {
    return fmtPad(c.minute, 2)
  }
  if (verb == 'S') {
    return fmtPad(c.second, 2)
  }
  if (verb == '%') {
    return "%"
  }
  return raw
}

// `n` in decimal, left-padded with zeros to at least `width` digits. A
// negative `n` pads its magnitude and keeps the sign out front, so
// `fmtPad(-1, 4)` is `"-0001"`, never `"0-001"`.
fn fmtPad(n: int, width: int): string {
  if (n < 0) {
    return "-" + fmtPad(-n, width)
  }
  let s = "${n}"
  while (len(s) < width) {
    s = "0" + s
  }
  return s
}
