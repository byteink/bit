// Bit standard library — time module, zero-padded decimal formatting.
//
// `fmtPad` is the module's one zero-pad helper, reused unqualified by
// ./date.bit, ./timeofday.bit, ./naive.bit, ./zoned.bit, ./ldmlfmt.bit and
// ./hijri.bit (same module, SPEC §17.1, no import, no redeclaration). The
// strftime-style `formatUnix`/`formatRfc3339` this file used to export were
// superseded by `toString()`/`format(pattern)` on the typed calendar values
// and removed (#4084; docs/stdlib/time.md, "Superseded API").

// `n` in decimal, left-padded with zeros to at least `width` digits. A
// negative `n` pads its magnitude and keeps the sign out front, so
// `fmtPad(-1, 4)` is `"-0001"`, never `"0-001"`.
fn fmtPad(n: int, width: int): string {
  if (n < 0) {
    return "-" + fmtPad(-n, width)
  }
  let s = "${n}"
  while (len(s) < width) {
    s = "0" + s
  }
  return s
}
