// stdlib/time/naive.test.bit — NaiveDateTime composition, field forwarding
// and toString (#4074). Same module as ./naive.bit and ./date.bit (SPEC
// §19): no import needed to reach `date`/`Date`/`NaiveDateTime`.
//
// Every non-trivial expected value is inherited from #4072's and #4073's
// own pinned values (2026-09-01 -> dow=2 doy=244 quarter=3 dim=30
// weekOfYear=36; the leap-year and range boundaries) — this file adds no
// new calendar arithmetic of its own to verify, only that `NaiveDateTime`
// forwards to it correctly and joins the two `toString`s right.

// True when `date(2026, 9, 1)?.atTime(h, m, s)` fails. Fixed date because
// every boundary this checks is a Time boundary, not a Date one.
fn atTimeFails(h: int, m: int, s: int): bool {
  let d = date(2026, 9, 1) catch _ {
    return true
  }
  d.atTime(h, m, s) catch _ {
    return true
  }
  return false
}

test "atTime composes a valid Date and a valid Time into a valid NaiveDateTime" {
  let d = date(2026, 9, 1) catch e {
    assert(false, "date(2026,9,1) failed: ${e.message()}")
    return
  }
  let dt = d.atTime(9, 0, 0) catch e {
    assert(false, "atTime(9,0,0) failed: ${e.message()}")
    return
  }
  assert(
    dt.toString() == "2026-09-01T09:00:00",
    "toString() = ${dt.toString()}, want 2026-09-01T09:00:00",
  )
}

test "atTime rejects an out-of-range hour, minute or second" {
  assert(atTimeFails(24, 0, 0), "atTime(24,0,0) succeeded, want fail (hour out of range)")
  assert(atTimeFails(0, 60, 0), "atTime(0,60,0) succeeded, want fail (minute out of range)")
  assert(atTimeFails(23, 59, 60), "atTime(23,59,60) succeeded, want fail (no leap seconds)")
}

test "atTime accepts the day's first and last second" {
  assert(!atTimeFails(0, 0, 0), "atTime(0,0,0) failed, want success")
  assert(!atTimeFails(23, 59, 59), "atTime(23,59,59) failed, want success")
}

test "date() and time() return the composed halves, matching their own toString" {
  let d = date(2026, 9, 1) catch e {
    assert(false, "date(2026,9,1) failed: ${e.message()}")
    return
  }
  let dt = d.atTime(9, 0, 0) catch e {
    assert(false, "atTime(9,0,0) failed: ${e.message()}")
    return
  }
  assert(
    dt.date().toString() == "2026-09-01",
    "date().toString() = ${dt.date().toString()}, want 2026-09-01",
  )
  assert(
    dt.time().toString() == "09:00:00",
    "time().toString() = ${dt.time().toString()}, want 09:00:00",
  )
}

test "every accessor forwards to the matching Date or Time accessor" {
  let d = date(2026, 9, 1) catch e {
    assert(false, "date(2026,9,1) failed: ${e.message()}")
    return
  }
  let dt = d.atTime(9, 30, 15) catch e {
    assert(false, "atTime(9,30,15) failed: ${e.message()}")
    return
  }
  assert(dt.year() == 2026, "year() = ${dt.year()}, want 2026")
  assert(dt.month() == 9, "month() = ${dt.month()}, want 9")
  assert(dt.day() == 1, "day() = ${dt.day()}, want 1")
  assert(dt.hour() == 9, "hour() = ${dt.hour()}, want 9")
  assert(dt.minute() == 30, "minute() = ${dt.minute()}, want 30")
  assert(dt.second() == 15, "second() = ${dt.second()}, want 15")
  assert(dt.nanosecond() == 0, "nanosecond() = ${dt.nanosecond()}, want 0")
  assert(dt.dayOfWeek() == 2, "dayOfWeek() = ${dt.dayOfWeek()}, want 2 (Tuesday)")
  assert(dt.dayOfYear() == 244, "dayOfYear() = ${dt.dayOfYear()}, want 244")
  assert(dt.quarter() == 3, "quarter() = ${dt.quarter()}, want 3")
  assert(dt.daysInMonth() == 30, "daysInMonth() = ${dt.daysInMonth()}, want 30")
  assert(dt.weekOfYear() == 36, "weekOfYear() = ${dt.weekOfYear()}, want 36")
  assert(!dt.isLeapYear(), "isLeapYear() = true, want false (2026 is not a leap year)")
}

test "isLeapYear forwards to the composed Date, true for 2024" {
  let d = date(2024, 2, 29) catch e {
    assert(false, "date(2024,2,29) failed: ${e.message()}")
    return
  }
  let dt = d.atTime(0, 0, 0) catch e {
    assert(false, "atTime(0,0,0) failed: ${e.message()}")
    return
  }
  assert(dt.isLeapYear(), "isLeapYear() = false, want true (2024 is a leap year)")
}

test "toString joins Date and Time with an uppercase T, no fraction when nanoseconds are zero" {
  let d = date(2026, 1, 5) catch e {
    assert(false, "date(2026,1,5) failed: ${e.message()}")
    return
  }
  let dt = d.atTime(1, 2, 3) catch e {
    assert(false, "atTime(1,2,3) failed: ${e.message()}")
    return
  }
  assert(
    dt.toString() == "2026-01-05T01:02:03",
    "toString() = ${dt.toString()}, want 2026-01-05T01:02:03",
  )
}

// `atTime` has no nanosecond parameter (it delegates to `time`, not
// `timeNs`), so the only way to reach a nanosecond-bearing NaiveDateTime is
// the composite literal — valid here because this file is in the same
// module as ./naive.bit, and `dt`/`tm` are unexported, not private to the
// class (SPEC §10.3/§10.5).
test "toString appends nine fractional digits when nanoseconds are nonzero" {
  let d = date(2026, 9, 1) catch e {
    assert(false, "date(2026,9,1) failed: ${e.message()}")
    return
  }
  let t = timeNs(9, 0, 0, 500) catch e {
    assert(false, "timeNs(9,0,0,500) failed: ${e.message()}")
    return
  }
  let dt = NaiveDateTime{ dt: d, tm: t }
  assert(dt.nanosecond() == 500, "nanosecond() = ${dt.nanosecond()}, want 500")
  assert(
    dt.toString() == "2026-09-01T09:00:00.000000500",
    "toString() = ${dt.toString()}, want 2026-09-01T09:00:00.000000500",
  )
}
