// stdlib/time/compare.test.bit — the ordering family (./compare.bit) and
// the whole-unit difference family (./difference.bit), both #4078. Same
// module as those two and as ./date.bit, ./naive.bit, ./zoned.bit and
// ./time.bit (SPEC §19): no import needed to reach `date`, `zone`, `Date`,
// `Time`, `NaiveDateTime`, `DateTime` or `Timestamp`.
//
// Every expected value below is quoted from docs/stdlib/time.md's
// "Comparison" and "Differences" sections, or from a calendar fact this
// module already pins elsewhere, never from this file's own output:
//
//   Someone born 2000-06-15 is 25 on 2026-06-14 and 26 on 2026-06-15 —
//   docs/stdlib/time.md, "Differences", verbatim.
//   09:00 in Dubai is before 09:00 in London — docs/stdlib/time.md,
//   "Comparison", verbatim; Asia/Dubai is +04:00 at every modern instant
//   and Europe/London is +01:00 in October before the fall-back
//   (./zone.test.bit's header, cross-checked there against this host's
//   `zdump -v`).
//   Europe/London's 2026 fall-back is 2026-10-25T01:00:00Z, BST(3600) ->
//   GMT(0) — ./zone.test.bit's header. So the 25-hour day is 2026-10-25:
//   midnight on the 25th is still BST and midnight on the 26th is GMT.
//   #4078's acceptance names 2026-10-24 -> 2026-10-25 for that pair, which
//   is a day early — the transition is on the night of the 25th — so the
//   pair used below is 2026-10-25 -> 2026-10-26. 25 hours is
//   90000000000000 ns, the figure the acceptance asks for.
//   2026-01-31 plus one month is 2026-02-28, clamped
//   (docs/stdlib/time.md, "Month arithmetic clamps"; ./calarith.test.bit
//   pins the same clamp).
//
// `isPast`/`isFuture` read `now()` and the doc gives them no fixed-clock
// form (docs/stdlib/time.md, "Comparison": "compared against `now()`"),
// so they are exercised against instants far enough from any run time —
// 2000 and 2200 — that the wall clock of the machine running the suite
// cannot change the answer.

// `date(y, m, d)`, for a triple this file already knows is a real calendar
// date. Every call below passes literal constants, so the failure path is
// unreachable; it panics rather than returning a substitute date, the same
// way ./bounds.test.bit does — a silently substituted date would make
// every assertion downstream of it meaningless.
fn compareTestDate(y: int, m: int, d: int): Date {
  return date(y, m, d) catch e {
    panic("date(${y}, ${m}, ${d}) failed: ${e.message()}")
  }
}

// `d` at `h:min:s`, as a wall clock with no zone. Takes a `Date` rather
// than a (year, month, day) triple so it stays inside the four-parameter
// limit `bit lint` enforces (spec/LINT.md, max-params). Same unreachable
// failure path as `compareTestDate`.
fn compareTestNaive(d: Date, h: int, min: int, s: int): NaiveDateTime {
  return d.atTime(h, min, s) catch e {
    panic("atTime(${h}, ${min}, ${s}) failed: ${e.message()}")
  }
}

// The named zone. Panics rather than substituting UTC: a fallback zone
// would silently turn every zone-sensitive assertion below into a
// tautology.
fn compareTestZone(name: string): Zone {
  return zone(name) catch e {
    panic("zone(${name}) failed: ${e.message()}")
  }
}

// `hour` on `d` in `name`'s zone, as a `DateTime`.
fn compareTestZoned(d: Date, hour: int, name: string): DateTime {
  return compareTestNaive(d, hour, 0, 0).inZone(compareTestZone(name))
}

// The instant `t` names. Panics on a `t` outside `Timestamp`'s range; every
// caller below is in the 2000s.
fn compareTestStamp(t: DateTime): Timestamp {
  return t.toTimestamp() catch e {
    panic("toTimestamp failed: ${e.message()}")
  }
}

test "compare returns exactly -1, 0 and 1, on every type" {
  let early = compareTestDate(2026, 9, 17)
  let late = compareTestDate(2026, 9, 18)
  assert(early.compare(late) == -1, "Date earlier: ${early.compare(late)}, want -1")
  assert(early.compare(early) == 0, "Date equal: ${early.compare(early)}, want 0")
  assert(late.compare(early) == 1, "Date later: ${late.compare(early)}, want 1")

  let a = compareTestNaive(early, 9, 0, 0)
  let b = compareTestNaive(early, 17, 0, 0)
  assert(a.compare(b) == -1, "NaiveDateTime earlier: ${a.compare(b)}, want -1")
  assert(a.compare(a) == 0, "NaiveDateTime equal: ${a.compare(a)}, want 0")
  assert(b.compare(a) == 1, "NaiveDateTime later: ${b.compare(a)}, want 1")

  assert(a.time().compare(b.time()) == -1, "Time earlier: ${a.time().compare(b.time())}, want -1")
  assert(a.time().compare(a.time()) == 0, "Time equal: ${a.time().compare(a.time())}, want 0")
  assert(b.time().compare(a.time()) == 1, "Time later: ${b.time().compare(a.time())}, want 1")

  let za = a.inZone(compareTestZone("Europe/London"))
  let zb = b.inZone(compareTestZone("Europe/London"))
  assert(za.compare(zb) == -1, "DateTime earlier: ${za.compare(zb)}, want -1")
  assert(za.compare(za) == 0, "DateTime equal: ${za.compare(za)}, want 0")
  assert(zb.compare(za) == 1, "DateTime later: ${zb.compare(za)}, want 1")

  let ta = compareTestStamp(za)
  let tb = compareTestStamp(zb)
  assert(ta.compare(tb) == -1, "Timestamp earlier: ${ta.compare(tb)}, want -1")
  assert(ta.compare(ta) == 0, "Timestamp equal: ${ta.compare(ta)}, want 0")
  assert(tb.compare(ta) == 1, "Timestamp later: ${tb.compare(ta)}, want 1")
}

test "isBefore/isAfter/isSame agree with compare on Date and Timestamp" {
  let early = compareTestDate(2026, 9, 17)
  let late = compareTestDate(2026, 9, 18)
  assert(early.isBefore(late), "2026-09-17 isBefore 2026-09-18")
  assert(!late.isBefore(early), "2026-09-18 is not before 2026-09-17")
  assert(late.isAfter(early), "2026-09-18 isAfter 2026-09-17")
  assert(!early.isAfter(early), "isAfter is strict: a date is not after itself")
  assert(early.isSame(compareTestDate(2026, 9, 17)), "two 2026-09-17 values isSame")
  assert(!early.isBefore(early) && !early.isAfter(early), "isBefore/isAfter are both strict")

  let ta = Timestamp{ ns: 1000 }
  let tb = Timestamp{ ns: 1001 }
  assert(ta.isBefore(tb), "Timestamp 1000 isBefore 1001")
  assert(tb.isAfter(ta), "Timestamp 1001 isAfter 1000")
  assert(ta.isSame(Timestamp{ ns: 1000 }), "Timestamp 1000 isSame 1000")
}

test "isBetween includes both endpoints" {
  let lo = compareTestDate(2026, 9, 1)
  let hi = compareTestDate(2026, 9, 30)
  assert(lo.isBetween(lo, hi), "the low endpoint is inside an inclusive range")
  assert(hi.isBetween(lo, hi), "the high endpoint is inside an inclusive range")
  assert(compareTestDate(2026, 9, 17).isBetween(lo, hi), "an interior date is inside")
  assert(!compareTestDate(2026, 8, 31).isBetween(lo, hi), "the day before the range is outside")
  assert(!compareTestDate(2026, 10, 1).isBetween(lo, hi), "the day after the range is outside")
  assert(!hi.isBetween(hi, lo), "lo after hi names an empty range")

  let tlo = Timestamp{ ns: 100 }
  let thi = Timestamp{ ns: 200 }
  assert(tlo.isBetween(tlo, thi), "Timestamp: the low endpoint is included")
  assert(thi.isBetween(tlo, thi), "Timestamp: the high endpoint is included")
  let past = Timestamp{ ns: 201 }
  assert(!past.isBetween(tlo, thi), "Timestamp: one past the high end is outside")

  let day = compareTestNaive(lo, 0, 0, 0)
  let dayEnd = compareTestNaive(lo, 23, 59, 59)
  assert(day.isBetween(day, dayEnd), "NaiveDateTime: the low endpoint is included")
  assert(dayEnd.isBetween(day, dayEnd), "NaiveDateTime: the high endpoint is included")
  assert(
    day.time().isBetween(day.time(), dayEnd.time()),
    "Time: the low endpoint is included",
  )
  assert(
    dayEnd.time().isBetween(day.time(), dayEnd.time()),
    "Time: the high endpoint is included",
  )
}

test "DateTime compares by instant: 09:00 Dubai is before 09:00 London" {
  // December, so Europe/London is on GMT and the gap is the doc's own
  // "four hours apart"; in September London is on BST and it is three.
  let d = compareTestDate(2026, 12, 17)
  let dubai = compareTestZoned(d, 9, "Asia/Dubai")
  let london = compareTestZoned(d, 9, "Europe/London")
  assert(dubai.isBefore(london), "09:00 Dubai isBefore 09:00 London (four hours apart)")
  assert(london.isAfter(dubai), "09:00 London isAfter 09:00 Dubai")
  assert(!dubai.isSame(london), "the two are different instants")
  assert(dubai.compare(london) == -1, "compare: ${dubai.compare(london)}, want -1")
  assert(
    dubai.naive().isSame(london.naive()),
    "the two WALL CLOCKS are the same: ${dubai.naive().toString()} vs ${london.naive().toString()}",
  )
  assert(
    dubai.differenceInHours(london) == 4,
    "instant gap in hours: ${dubai.differenceInHours(london)}, want 4",
  )
  assert(
    london.withZone(dubai.zone()).isSame(london),
    "the same instant read in another zone compares equal",
  )
}

test "DateTime compares by instant across the 2026 London fall-back" {
  let z = "Europe/London"
  let before = compareTestZoned(compareTestDate(2026, 10, 25), 1, z)
  let after = compareTestZoned(compareTestDate(2026, 10, 25), 2, z)
  assert(before.isBefore(after), "01:00 (BST, the first occurrence) is before 02:00 GMT")
  assert(before.compare(after) == -1, "compare: ${before.compare(after)}, want -1")
  assert(before.offset() == 3600, "01:00 takes the earlier offset: ${before.offset()}, want 3600")
  assert(after.offset() == 0, "02:00 is after the transition: ${after.offset()}, want 0")
  assert(
    before.differenceInHours(after) == 2,
    "01:00 BST to 02:00 GMT is two real hours: ${before.differenceInHours(after)}",
  )
  assert(
    before.naive().differenceInHours(after.naive()) == 1,
    "the wall clocks are one hour apart: ${before.naive().differenceInHours(after.naive())}",
  )
}

test "the doc's age example: born 2000-06-15 is 25 on 2026-06-14, 26 on 2026-06-15" {
  let birth = compareTestDate(2000, 6, 15)
  let dayBefore = compareTestDate(2026, 6, 14)
  let birthday = compareTestDate(2026, 6, 15)
  assert(
    birth.differenceInYears(dayBefore) == 25,
    "age on 2026-06-14: ${birth.differenceInYears(dayBefore)}, want 25",
  )
  assert(
    birth.differenceInYears(birthday) == 26,
    "age on 2026-06-15: ${birth.differenceInYears(birthday)}, want 26",
  )
  assert(
    birth.differenceInMonths(dayBefore) == 311,
    "months to 2026-06-14: ${birth.differenceInMonths(dayBefore)}, want 311",
  )
  assert(
    birth.differenceInMonths(birthday) == 312,
    "months to 2026-06-15: ${birth.differenceInMonths(birthday)}, want 312",
  )
}

test "differenceInMonths: across a year end, and the month-end clamp" {
  let dec = compareTestDate(2025, 12, 31)
  assert(
    dec.differenceInMonths(compareTestDate(2026, 1, 31)) == 1,
    "2025-12-31 to 2026-01-31: ${dec.differenceInMonths(compareTestDate(2026, 1, 31))}, want 1",
  )
  assert(
    dec.differenceInMonths(compareTestDate(2026, 1, 30)) == 0,
    "2025-12-31 to 2026-01-30 is not a complete month",
  )
  assert(
    dec.differenceInMonths(compareTestDate(2026, 12, 31)) == 12,
    "2025-12-31 to 2026-12-31: ${dec.differenceInMonths(compareTestDate(2026, 12, 31))}, want 12",
  )
  assert(
    dec.differenceInYears(compareTestDate(2026, 12, 30)) == 0,
    "2025-12-31 to 2026-12-30 is not a complete year",
  )

  // 2026-01-31 plus one month IS 2026-02-28 (the documented clamp), so
  // that is one complete month, not zero.
  let jan31 = compareTestDate(2026, 1, 31)
  assert(
    jan31.differenceInMonths(compareTestDate(2026, 2, 28)) == 1,
    "2026-01-31 to 2026-02-28: ${jan31.differenceInMonths(compareTestDate(2026, 2, 28))}, want 1",
  )
  assert(
    jan31.differenceInMonths(compareTestDate(2026, 2, 27)) == 0,
    "2026-01-31 to 2026-02-27 is not a complete month",
  )
  assert(
    compareTestDate(2024, 2, 29).differenceInYears(compareTestDate(2025, 2, 28)) == 1,
    "2024-02-29 to 2025-02-28 is one complete year, by the same clamp",
  )
}

test "differences truncate toward zero in the negative direction" {
  let start = compareTestDate(2026, 9, 17)
  let backThirteen = compareTestDate(2026, 9, 4)
  assert(
    start.differenceInDays(backThirteen) == -13,
    "days back: ${start.differenceInDays(backThirteen)}, want -13",
  )
  assert(
    start.differenceInWeeks(backThirteen) == -1,
    "13 days back is one complete week: ${start.differenceInWeeks(backThirteen)}, want -1",
  )
  assert(
    start.differenceInWeeks(compareTestDate(2026, 9, 11)) == 0,
    "6 days back is no complete week",
  )
  assert(
    start.differenceInWeeks(compareTestDate(2026, 9, 3)) == -2,
    "14 days back is two complete weeks",
  )
  assert(
    backThirteen.differenceInWeeks(start) == 1,
    "the same pair forwards is +1: ${backThirteen.differenceInWeeks(start)}",
  )
  assert(
    start.differenceInMonths(compareTestDate(2026, 8, 18)) == 0,
    "one day short of a month back is 0, not -1",
  )
  assert(
    start.differenceInMonths(compareTestDate(2026, 8, 17)) == -1,
    "exactly a month back is -1",
  )
}

test "NaiveDateTime differences drop the partial unit" {
  let d = compareTestDate(2026, 9, 17)
  let nine = compareTestNaive(d, 9, 0, 0)
  let nextEight = compareTestNaive(compareTestDate(2026, 9, 18), 8, 59, 59)
  assert(nine.differenceInDays(nextEight) == 0, "23h59m59s is no complete day")
  assert(
    nine.differenceInHours(nextEight) == 23,
    "hours: ${nine.differenceInHours(nextEight)}, want 23",
  )
  assert(
    nine.differenceInMinutes(nextEight) == 1439,
    "minutes: ${nine.differenceInMinutes(nextEight)}, want 1439",
  )
  assert(
    nine.differenceInSeconds(nextEight) == 86399,
    "seconds: ${nine.differenceInSeconds(nextEight)}, want 86399",
  )
  assert(
    nextEight.differenceInHours(nine) == -23,
    "the same pair backwards: ${nextEight.differenceInHours(nine)}, want -23",
  )
  assert(nine.isSameDay(compareTestNaive(d, 23, 59, 59)), "09:00 and 23:59 are the same day")
  assert(!nine.isSameDay(nextEight), "09:00 and the next morning are not")
  assert(nine.isSameMonth(nextEight), "both readings are in September 2026")
  assert(nine.isSameYear(nextEight), "both readings are in 2026")
  assert(
    !nine.isSameMonth(compareTestNaive(compareTestDate(2026, 10, 1), 9, 0, 0)),
    "September and October are not the same month",
  )
}

test "DateTime: calendar days across a DST day, real time from the instants" {
  let z = "Europe/London"
  let start = compareTestZoned(compareTestDate(2026, 10, 25), 0, z)
  let next = compareTestZoned(compareTestDate(2026, 10, 26), 0, z)
  assert(
    start.differenceInDays(next) == 1,
    "calendar days across the fall-back: ${start.differenceInDays(next)}, want 1",
  )
  assert(
    start.differenceInHours(next) == 25,
    "real hours across the fall-back: ${start.differenceInHours(next)}, want 25",
  )
  let elapsed = compareTestStamp(start).differenceInNanoseconds(compareTestStamp(next))
  assert(elapsed == 90000000000000, "Timestamp gap: ${elapsed} ns, want 90000000000000")
  assert(
    compareTestStamp(start).differenceInHours(compareTestStamp(next)) == 25,
    "the Timestamp pair agrees with the DateTime instant difference",
  )
  assert(start.isBefore(next), "the 25th is before the 26th by instant too")
  assert(!start.isSameDay(next), "different calendar days")
  assert(start.isSameMonth(next) && start.isSameYear(next), "same month and year")
}

test "isPast and isFuture read the clock" {
  let past = compareTestStamp(compareTestZoned(compareTestDate(2000, 1, 1), 0, "Europe/London"))
  let future = compareTestZoned(compareTestDate(2200, 1, 1), 0, "Europe/London")
  assert(past.isPast(), "2000-01-01 is in the past")
  assert(!past.isFuture(), "2000-01-01 is not in the future")
  assert(future.isFuture(), "2200-01-01 is in the future")
  assert(!future.isPast(), "2200-01-01 is not in the past")
  assert(
    compareTestZoned(compareTestDate(2000, 1, 1), 0, "Europe/London").isPast(),
    "the same instant as a DateTime is in the past",
  )
  assert(compareTestStamp(compareTestZoned(compareTestDate(2100, 1, 1), 0, "Europe/London")).isFuture(),
    "2100-01-01 as a Timestamp is in the future")
}
