// stdlib/time/extend.test.bit — the extend() extension point (#5096). Same
// module as ./extend.bit and ./zone.bit (SPEC §17.1): `extend`, `zone`,
// `zoneOffsetAt`, `tzExtendCap` and `readFile` are all reached here
// unqualified, no import, no redeclaration — same convention
// ./zone.test.bit and ./zoneif.test.bit already use.
//
// Deviation from the ticket's literal acceptance wording, spelled out here
// because it changes what a reader sees run: the acceptance text describes
// the host-fallback case as "zone(\"Asia/Dubai\") ... with the host
// zoneinfo directory made unreadable". `/usr/share/zoneinfo` is root-owned
// on this host and shared with every other agent and process on this
// machine; chmod-ing it (even temporarily, even as a no-op for a reading
// user) is neither possible without root nor safe to attempt on a box other
// work depends on. The same code path -- zone()'s `readFile` failing, so it
// falls through to the extension buffer -- is exercised instead with a zone
// name the host genuinely has no file for ("Bit/ExtendOnly"), which is
// exactly what "unreadable" reduces to from zone()'s point of view: a
// failed read. The HOST-WINS half of the acceptance (a real host zone,
// "Asia/Dubai", must resolve from the host file and ignore a wrong blob
// entry of the same name) is tested literally, unmodified, below.
//
// Real transition used below, the same one ./zone.test.bit already pins
// (cross-checked there against this host's own `zdump -v`, never derived
// from this module's own output): Asia/Dubai has been a flat +04 (14400)
// at every instant used here (1700000000 is long after its one historical
// transition in 1919).

// One hand-built index entry: `name`'s TZif bytes are `payload`.
class tzExtendTestZone {
  name: string,
  payload: string,
}

fn tzExtendTestU16(buf: []byte, v: int): []byte {
  buf = append(buf, byte((v >> 8) & 0xff))
  buf = append(buf, byte(v & 0xff))
  return buf
}

fn tzExtendTestU32(buf: []byte, v: int): []byte {
  buf = append(buf, byte((v >> 24) & 0xff))
  buf = append(buf, byte((v >> 16) & 0xff))
  buf = append(buf, byte((v >> 8) & 0xff))
  buf = append(buf, byte(v & 0xff))
  return buf
}

// Hand-builds a blob in extend.bit's own format: magic+version, count,
// index (name length/name/offset/length, offsets absolute from the start
// of the blob), then payload -- computed in a first pass over `zones`
// before any index byte is written, so every offset is correct on the
// first write, matching what tzExtendParseIndex (./extend.bit) expects to
// read back.
fn tzExtendTestBuildBlob(zones: []tzExtendTestZone): string {
  let indexLen = 0
  for z of zones {
    indexLen = indexLen + 2 + len(z.name) + 4 + 4
  }
  let headerLen = 12
  let payloadStart = headerLen + indexLen

  let buf = []byte(0)
  buf = append(buf, byte('B'))
  buf = append(buf, byte('I'))
  buf = append(buf, byte('T'))
  buf = append(buf, byte('T'))
  buf = append(buf, byte('Z'))
  buf = append(buf, byte(0))
  buf = append(buf, byte(0))
  buf = append(buf, byte(1))
  buf = tzExtendTestU32(buf, len(zones))

  let pos = payloadStart
  for z of zones {
    buf = tzExtendTestU16(buf, len(z.name))
    buf = append(buf, z.name)
    buf = tzExtendTestU32(buf, pos)
    buf = tzExtendTestU32(buf, len(z.payload))
    pos = pos + len(z.payload)
  }
  for z of zones {
    buf = append(buf, z.payload)
  }
  return string(buf)
}

// A minimal, self-contained one-entry blob whose index offset+length runs
// past the end of the blob -- built by hand rather than through
// tzExtendTestBuildBlob, since that function always computes a correct
// offset.
fn tzExtendTestBadOffsetBlob(): string {
  let buf = []byte(0)
  buf = append(buf, byte('B'))
  buf = append(buf, byte('I'))
  buf = append(buf, byte('T'))
  buf = append(buf, byte('T'))
  buf = append(buf, byte('Z'))
  buf = append(buf, byte(0))
  buf = append(buf, byte(0))
  buf = append(buf, byte(1))
  buf = tzExtendTestU32(buf, 1)    // count
  buf = tzExtendTestU16(buf, 1)    // name length
  buf = append(buf, "X")           // name
  buf = tzExtendTestU32(buf, 9999) // offset: far past this 23-byte blob
  buf = tzExtendTestU32(buf, 1)    // length
  return string(buf)
}

fn tzExtendTestMutateByte(s: string, at: int, v: byte): string {
  let buf = []byte(s)
  buf[at] = v
  return string(buf)
}

fn tzExtendTestTwoZoneBlob(): string {
  let dubai = readFile("/usr/share/zoneinfo/Asia/Dubai") catch ""
  let london = readFile("/usr/share/zoneinfo/Europe/London") catch ""
  let zones = []tzExtendTestZone(0)
  // Deliberately WRONG: the host has its own real "Asia/Dubai" file, so
  // this entry's payload (a different zone's TZif image, London's, whose
  // offset is 0 or 3600 and never 14400) must never be observed.
  zones = append(zones, tzExtendTestZone{ name: "Asia/Dubai", payload: london })
  // The host has no file by this name at all; it resolves only from here.
  zones = append(zones, tzExtendTestZone{ name: "Bit/ExtendOnly", payload: dubai })
  return tzExtendTestBuildBlob(zones)
}

test "extend() resolves a zone the host has no file for, from the published extension buffer" {
  let blob = tzExtendTestTwoZoneBlob()
  assert(extend(blob), "extend() rejected a well-formed two-zone blob")

  let z = zone("Bit/ExtendOnly") catch e {
    assert(false, "zone(Bit/ExtendOnly) failed after extend(): ${e.message()}")
    return
  }
  let offset = zoneOffsetAt(z, 1700000000)
  assert(offset == 14400, "extension-resolved offset = ${offset}, want 14400")
}

test "a zone the host provides resolves from the host file, never from a wrong blob entry of the same name" {
  let blob = tzExtendTestTwoZoneBlob()
  assert(extend(blob), "extend() rejected a well-formed two-zone blob")

  let z = zone("Asia/Dubai") catch e {
    assert(false, "zone(Asia/Dubai) failed: ${e.message()}")
    return
  }
  let offset = zoneOffsetAt(z, 1700000000)
  assert(
    offset == 14400,
    "host zone(Asia/Dubai) offset = ${offset}, want 14400 (the HOST's value, not the blob's wrong London entry)",
  )
}

test "extend() rejects a bad magic, an unknown version, a past-the-end index offset, and an oversized blob" {
  let placeholder = []tzExtendTestZone(0)
  placeholder = append(placeholder, tzExtendTestZone{ name: "X", payload: "" })
  let goodBlob = tzExtendTestBuildBlob(placeholder)

  let badMagic = tzExtendTestMutateByte(goodBlob, 0, 'X')
  assert(!extend(badMagic), "extend() accepted a bad magic")

  let badVersion = tzExtendTestMutateByte(goodBlob, 7, byte(9))
  assert(!extend(badVersion), "extend() accepted an unsupported version byte")

  let badOffset = tzExtendTestBadOffsetBlob()
  assert(!extend(badOffset), "extend() accepted an index offset past the end of the blob")

  let oversized = string([]byte(tzExtendCap + 1))
  assert(!extend(oversized), "extend() accepted a blob larger than tzExtendCap")

  // zone() behaves exactly as it did before any of the four rejected
  // calls above: none of them ever won the publish CAS, so tzExtendState
  // never left 0 -- a real host zone still resolves from disk, and a name
  // neither the host nor any extension has still fails as "unknown zone".
  let z = zone("Asia/Dubai") catch e {
    assert(false, "zone(Asia/Dubai) failed after four rejected extend() calls: ${e.message()}")
    return
  }
  assert(
    zoneOffsetAt(z, 1700000000) == 14400,
    "host zone(Asia/Dubai) disturbed by a rejected extend() call",
  )

  zone("Bit/ExtendOnly") catch _ {
    return
  }
  assert(false, "zone(Bit/ExtendOnly) unexpectedly succeeded with no extension ever published")
}

test "a second extend() call returns false and leaves the first published blob unchanged" {
  let dubai = readFile("/usr/share/zoneinfo/Asia/Dubai") catch ""
  let london = readFile("/usr/share/zoneinfo/Europe/London") catch ""

  let firstZones = []tzExtendTestZone(0)
  firstZones = append(firstZones, tzExtendTestZone{ name: "Bit/ExtendOnly", payload: dubai })
  let first = tzExtendTestBuildBlob(firstZones)
  assert(extend(first), "extend() rejected the first, well-formed blob")

  let secondZones = []tzExtendTestZone(0)
  secondZones = append(secondZones, tzExtendTestZone{ name: "Bit/ExtendOnly", payload: london })
  let second = tzExtendTestBuildBlob(secondZones)
  assert(!extend(second), "a second extend() call did not return false")

  let z = zone("Bit/ExtendOnly") catch e {
    assert(false, "zone(Bit/ExtendOnly) failed after a rejected second extend(): ${e.message()}")
    return
  }
  let offset = zoneOffsetAt(z, 1700000000)
  assert(
    offset == 14400,
    "post-second-call offset = ${offset}, want 14400 (the FIRST blob's data, unchanged)",
  )
}
