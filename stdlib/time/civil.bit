// Bit standard library — time module, civil (calendar) conversions.
//
// Converts between a Unix nanosecond count and a broken-down UTC calendar
// date/time, and back. Days are counted with Howard Hinnant's days-from-civil
// algorithm and its inverse (both exact for any Gregorian date, proleptic
// included). `stdlib/crypto/x509time.bit:80` (`x509MakeTime`) holds the same
// forward shape for RFC 5280 timestamps; this file does not import it, since
// sibling files in one module already share `std/time`'s flat namespace.

const civilDayNs: int = 86400000000000
const civilHourNs: int = 3600000000000
const civilMinuteNs: int = 60000000000
const civilSecondNs: int = 1000000000

// A broken-down UTC date and time. `weekday` is 0 for Sunday up to 6 for
// Saturday. `yearDay` is 1 for January 1.
export class Civil {
  year: int,
  month: int,
  day: int,
  hour: int,
  minute: int,
  second: int,
  nanosecond: int,
  weekday: int,
  yearDay: int,
}

// Floor division: `a / b` rounded toward negative infinity, for positive `b`.
// Bit's `/` truncates toward zero, which is wrong for a negative `a` — the
// correction below is what makes every conversion below exact for instants
// before the Unix epoch.
fn civilFloorDiv(a: int, b: int): int {
  let q = a / b
  let r = a - q * b
  if (r < 0) {
    q = q - 1
  }
  return q
}

// True if `year` is a Gregorian leap year. Sign-invariant: an equality-to-zero
// remainder means the same thing whether `%` truncates or floors.
fn civilIsLeap(year: int): bool {
  if (year % 4 != 0) {
    return false
  }
  if (year % 100 != 0) {
    return true
  }
  return year % 400 == 0
}

// Days in `month` of `year`, leap-year aware.
fn civilDaysInMonth(year: int, month: int): int {
  if (month == 4 || month == 6 || month == 9 || month == 11) {
    return 30
  }
  if (month == 2) {
    if (civilIsLeap(year)) {
      return 29
    }
    return 28
  }
  return 31
}

// 1 for January 1 up to 365/366 for December 31. `month` and `day` are
// assumed already in range.
fn civilYearDay(year: int, month: int, day: int): int {
  let total = day
  let m = 1
  while (m < month) {
    total = total + civilDaysInMonth(year, m)
    m = m + 1
  }
  return total
}

// 0 (Sunday) .. 6 (Saturday) for `days` since the Unix epoch. 1970-01-01 was
// a Thursday, hence the `+4` before reducing mod 7.
fn civilWeekday(days: int): int {
  let wd = civilFloorDiv(days + 4, 7)
  return (days + 4) - wd * 7
}

// Days since the Unix epoch for a UTC calendar date. Howard Hinnant's
// days-from-civil, valid for any Gregorian date. Same shape as
// `x509MakeTime` (`stdlib/crypto/x509time.bit:80`), with the era computed by
// `civilFloorDiv` instead of a truncating-division correction.
fn civilDaysFromCivil(year: int, month: int, day: int): int {
  let y = year
  if (month <= 2) {
    y = y - 1
  }
  let era = civilFloorDiv(y, 400)
  let yoe = y - era * 400
  let mp = month + 9
  if (month > 2) {
    mp = month - 3
  }
  let doy = (153 * mp + 2) / 5 + day - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  return era * 146097 + doe - 719468
}

// Nanoseconds since the Unix epoch, as a broken-down UTC date and time.
export fn civilFromUnix(ns: int): Civil {
  let days = civilFloorDiv(ns, civilDayNs)
  let rem = ns - days * civilDayNs

  let hour = rem / civilHourNs
  rem = rem - hour * civilHourNs
  let minute = rem / civilMinuteNs
  rem = rem - minute * civilMinuteNs
  let second = rem / civilSecondNs
  let nanosecond = rem - second * civilSecondNs

  // Hinnant's civil-from-days, the inverse of civilDaysFromCivil.
  let z = days + 719468
  let era = civilFloorDiv(z, 146097)
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let y = yoe + era * 400
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = mp + 3
  if (mp >= 10) {
    m = mp - 9
  }
  let year = y
  if (m <= 2) {
    year = y + 1
  }

  return Civil{
    year: year,
    month: m,
    day: d,
    hour: hour,
    minute: minute,
    second: second,
    nanosecond: nanosecond,
    weekday: civilWeekday(days),
    yearDay: civilYearDay(year, m, d),
  }
}

// The inverse of `civilFromUnix`: nanoseconds since the Unix epoch for a
// broken-down UTC date and time. Fails on an out-of-range field. Ignores
// `weekday` and `yearDay`.
export fn unixFromCivil(c: Civil): int! {
  if (c.month < 1 || c.month > 12) {
    fail newError("time: month out of range")
  }
  let dim = civilDaysInMonth(c.year, c.month)
  if (c.day < 1 || c.day > dim) {
    fail newError("time: day out of range")
  }
  if (c.hour > 23) {
    fail newError("time: hour out of range")
  }
  if (c.minute > 59) {
    fail newError("time: minute out of range")
  }
  if (c.second > 59) {
    fail newError("time: second out of range")
  }
  if (c.nanosecond < 0 || c.nanosecond > 999999999) {
    fail newError("time: nanosecond out of range")
  }
  let days = civilDaysFromCivil(c.year, c.month, c.day)
  return days * civilDayNs + c.hour * civilHourNs + c.minute * civilMinuteNs +
    c.second * civilSecondNs + c.nanosecond
}
