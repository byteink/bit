// Bit standard library — time module, civil (calendar) internals.
//
// `Civil` and the day-count algorithm below are unexported: the public
// calendar surface this file used to export (`Civil`, `civilFromUnix`,
// `unixFromCivil`) was superseded by `Date`/`NaiveDateTime`/`DateTime` and
// removed (#4084; docs/stdlib/time.md, "Superseded API"). What remains is
// Howard Hinnant's days-from-civil algorithm and its inverse (both exact
// for any Gregorian date, proleptic included), which `Date` (./date.bit)
// and `civilFromSeconds` below still need. `stdlib/crypto/x509time.bit:80`
// (`x509MakeTime`) holds the same forward shape for RFC 5280 timestamps;
// this file does not import it, since sibling files in one module already
// share `std/time`'s flat namespace.

const civilDayNs: int = 86400000000000
const civilHourNs: int = 3600000000000
const civilMinuteNs: int = 60000000000
const civilSecondNs: int = 1000000000

// A broken-down UTC date and time. Module-private (constraint, #4084): the
// public `Civil` this used to be was superseded and removed; this shape
// survives only as `civilFromSeconds`'s own return type. `weekday` is 0 for
// Sunday up to 6 for Saturday. `yearDay` is 1 for January 1.
class Civil {
  year: int,
  month: int,
  day: int,
  hour: int,
  minute: int,
  second: int,
  nanosecond: int,
  weekday: int,
  yearDay: int,
}

// Floor division: `a / b` rounded toward negative infinity, for positive `b`.
// Bit's `/` truncates toward zero, which is wrong for a negative `a` — the
// correction below is what makes every conversion below exact for instants
// before the Unix epoch.
fn civilFloorDiv(a: int, b: int): int {
  let q = a / b
  let r = a - q * b
  if (r < 0) {
    q = q - 1
  }
  return q
}

// True if `year` is a Gregorian leap year. Sign-invariant: an equality-to-zero
// remainder means the same thing whether `%` truncates or floors.
fn civilIsLeap(year: int): bool {
  if (year % 4 != 0) {
    return false
  }
  if (year % 100 != 0) {
    return true
  }
  return year % 400 == 0
}

// Days in `month` of `year`, leap-year aware.
fn civilDaysInMonth(year: int, month: int): int {
  if (month == 4 || month == 6 || month == 9 || month == 11) {
    return 30
  }
  if (month == 2) {
    if (civilIsLeap(year)) {
      return 29
    }
    return 28
  }
  return 31
}

// 1 for January 1 up to 365/366 for December 31. `month` and `day` are
// assumed already in range.
fn civilYearDay(year: int, month: int, day: int): int {
  let total = day
  let m = 1
  while (m < month) {
    total = total + civilDaysInMonth(year, m)
    m = m + 1
  }
  return total
}

// 0 (Sunday) .. 6 (Saturday) for `days` since the Unix epoch. 1970-01-01 was
// a Thursday, hence the `+4` before reducing mod 7.
fn civilWeekday(days: int): int {
  let wd = civilFloorDiv(days + 4, 7)
  return days + 4 - wd * 7
}

// Days since the Unix epoch for a UTC calendar date. Howard Hinnant's
// days-from-civil, valid for any Gregorian date. Same shape as
// `x509MakeTime` (`stdlib/crypto/x509time.bit:80`), with the era computed by
// `civilFloorDiv` instead of a truncating-division correction.
fn civilDaysFromCivil(year: int, month: int, day: int): int {
  let y = year
  if (month <= 2) {
    y = y - 1
  }
  let era = civilFloorDiv(y, 400)
  let yoe = y - era * 400
  let mp = month + 9
  if (month > 2) {
    mp = month - 3
  }
  let doy = (153 * mp + 2) / 5 + day - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  return era * 146097 + doe - 719468
}

// Whole seconds since the Unix epoch, with `nanosecond` (0..999999999)
// supplied separately rather than folded into a single nanosecond count,
// as a broken-down UTC date and time. `Timestamp.inZone`/`DateTime`
// (./time.bit, ./zoned.bit) call this after their own ns/seconds split;
// `seconds` can be far outside `Timestamp`'s narrower +-292-year range —
// `Date` spans years 1..9999 — and `seconds * civilSecondNs` would
// overflow `int` for most of that range before a nanosecond-based
// conversion ever got to look at it.
fn civilFromSeconds(seconds: int, nanosecond: int): Civil {
  let days = civilFloorDiv(seconds, 86400)
  let rem = seconds - days * 86400

  let hour = rem / 3600
  rem = rem - hour * 3600
  let minute = rem / 60
  let second = rem - minute * 60

  // Hinnant's civil-from-days, the inverse of civilDaysFromCivil.
  let z = days + 719468
  let era = civilFloorDiv(z, 146097)
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let y = yoe + era * 400
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = doy - (153 * mp + 2) / 5 + 1
  let m = mp + 3
  if (mp >= 10) {
    m = mp - 9
  }
  let year = y
  if (m <= 2) {
    year = y + 1
  }

  return Civil{
    year: year,
    month: m,
    day: d,
    hour: hour,
    minute: minute,
    second: second,
    nanosecond: nanosecond,
    weekday: civilWeekday(days),
    yearDay: civilYearDay(year, m, d),
  }
}
