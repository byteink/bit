// Bit standard library — time module, the Time type (#4073).
//
// A time of day: hour, minute, second and nanosecond, with no date and no
// zone (docs/stdlib/time.md, "Design" / "Ranges"). What a shop's opening
// hour or a nightly cut-off is. Named `timeofday.bit`, deliberately not
// `time.bit` — that name is already the shipped clock file (./time.bit,
// `now`/`monotonic`/`sleep`/timers), same module, same flat namespace.
//
// `Time` is independent of `Timestamp` for the same reason `Date` (#4072,
// ./date.bit) is: a time of day has no instant and no timezone, and
// converting one to the other needs both a `Date` and a `Zone` — a
// `NaiveDateTime`/`DateTime` conversion, not this type's job.
//
// Resolution is nanoseconds, matching `Timestamp.ns` (./time.bit) and
// `Civil.nanosecond` (./civil.bit) — the module has one time-of-day
// resolution everywhere, not a coarser one here. `time()` sets nanoseconds
// to zero; `timeNs()` takes them explicitly.
//
// No leap seconds: `second` tops out at 59, never 60. Every day in this
// module is exactly 86400 seconds (docs/stdlib/time.md, "Ranges"). No
// `24:00:00` alias for end-of-day either — `hour` tops out at 23, matching
// most libraries' choice over the ISO 8601 permission to write it — a
// second type for "one instant past the last representable Time" would
// only exist to name a value `Date.addDays(1).atTime(0,0,0)` already names
// better.
//
// Reuses `fmt.bit`'s `fmtPad`, its own private zero-pad helper, same
// module, no import, no second padding implementation.

// A time of day with no date and no zone. Two `Time` values naming the same
// wall-clock instant are equal field-for-field. Immutable: fields are
// readonly and unexported, so a caller reaches them only through the
// methods below, and every method reads `this` without ever mutating it.
export class Time {
  readonly h: int
  readonly min: int
  readonly s: int
  readonly nanos: int

  // The hour, 0..23.
  export hour(): int {
    return this.h
  }

  // The minute, 0..59.
  export minute(): int {
    return this.min
  }

  // The second, 0..59. Never 60 — this module has no leap seconds.
  export second(): int {
    return this.s
  }

  // The nanosecond, 0..999999999.
  export nanosecond(): int {
    return this.nanos
  }

  // "09:00:00" — zero-padded, always exactly two digits per field. When
  // `nanosecond()` is nonzero, a "." followed by exactly nine zero-padded
  // digits is appended: 500 nanoseconds prints "09:00:00.000000500", never
  // "09:00:00.5". Matches ./fmt.bit's `formatRfc3339`'s existing fractional
  // rule, so the two are consistent.
  export toString(): string {
    let base = fmtPad(this.h, 2) + ":" + fmtPad(this.min, 2) + ":" + fmtPad(this.s, 2)
    if (this.nanos == 0) {
      return base
    }
    return base + "." + fmtPad(this.nanos, 9)
  }
}

// "" when `hour`, `minute` and `second` are each in range; otherwise names
// which field failed. Shared by `time` and `timeNs` so the three-field
// range check is written once rather than duplicated across both
// constructors.
fn timeHmsError(hour: int, minute: int, second: int): string {
  if (hour < 0 || hour > 23) {
    return "hour out of range"
  }
  if (minute < 0 || minute > 59) {
    return "minute out of range"
  }
  if (second < 0 || second > 59) {
    return "second out of range"
  }
  return ""
}

// Builds a time of day with zero nanoseconds. Fails when `hour` is outside
// 0..23, `minute` outside 0..59, or `second` outside 0..59
// (docs/stdlib/time.md, "Constructing"). A `second` of 60 fails — there are
// no leap seconds in this module.
export fn time(hour: int, minute: int, second: int): Time! {
  let err = timeHmsError(hour, minute, second)
  if (len(err) > 0) {
    fail newError("time: " + err)
  }
  return Time{ h: hour, min: minute, s: second, nanos: 0 }
}

// As `time`, with an explicit `nanosecond` field. Fails on the same three
// fields, plus when `nanosecond` is outside 0..999999999.
export fn timeNs(hour: int, minute: int, second: int, nanosecond: int): Time! {
  let err = timeHmsError(hour, minute, second)
  if (len(err) > 0) {
    fail newError("timeNs: " + err)
  }
  if (nanosecond < 0 || nanosecond > 999999999) {
    fail newError("timeNs: nanosecond out of range")
  }
  return Time{ h: hour, min: minute, s: second, nanos: nanosecond }
}
