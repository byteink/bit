// Bit standard library — time module, human-readable duration formatting.
//
// Sibling of time.bit; shares the module's flat namespace, so `Microsecond`,
// `Millisecond` and `Second` below are the constants declared there.

// Renders `d`, a duration in nanoseconds, the way a person reads it:
//
//   formatDuration(0)             == "0s"
//   formatDuration(340)           == "340ns"
//   formatDuration(340000)        == "340us"   (ASCII "us", never "µs")
//   formatDuration(340000000)     == "340ms"
//   formatDuration(4984000000000) == "1h23m4s"
//   formatDuration(-45000000000)  == "-45s"
//
// Below 1 second the value is truncated to whole units (ns, us, or ms) and
// tagged with that unit. At 1 second and above it prints hours, minutes and
// seconds, each truncated to a whole second; the hours part is printed only
// when nonzero, the minutes part is printed when the hours part is printed
// or the minutes count is nonzero, and the seconds part is always printed.
//
// ponytail: fractional seconds are dropped once `d` reaches `Second` (one
// second) — a duration of 1500000000ns prints "1s", not "1.5s".
export fn formatDuration(d: int): string {
  if (d == 0) {
    return "0s"
  }
  if (d < 0) {
    return "-" + formatDuration(-d)
  }
  if (d < Microsecond) {
    return "${d}ns"
  }
  if (d < Millisecond) {
    return "${d / Microsecond}us"
  }
  if (d < Second) {
    return "${d / Millisecond}ms"
  }
  return durHMS(d)
}

// Formats `d` (already known to be at least one second) as hours, minutes
// and seconds, each truncated to a whole second.
fn durHMS(d: int): string {
  let totalSecs = d / Second
  let hours = totalSecs / 3600
  let minutes = totalSecs % 3600 / 60
  let seconds = totalSecs % 60
  if (hours > 0) {
    return "${hours}h${minutes}m${seconds}s"
  }
  if (minutes > 0) {
    return "${minutes}m${seconds}s"
  }
  return "${seconds}s"
}
