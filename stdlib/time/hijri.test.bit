// stdlib/time/hijri.test.bit — `Date.hijri()`, `HijriDate` and
// `hijriDate()` (./hijri.bit, #4082). Same module as ./hijri.bit,
// ./date.bit and ./civil.bit (SPEC §19): no import needed to reach `date`,
// `Date`, `hijriDate` or the module's private helpers.
//
// EVERY ANCHOR BELOW IS AN INDEPENDENTLY PUBLISHED DATE, not this
// module's own output. ./hijri.bit's table is transcribed from ICU4C's
// `UMALQURA_MONTHLENGTH` (its header names the commit); these are the
// cross-checks that transcription was verified against:
//
//   1 Muharram 1300 AH   = 1882-11-12  the tabulated span's first day,
//                                      ICU's own `yearStart(1300)` anchor
//   1 Muharram 1443 AH   = 2021-08-09  github.com/dralshehri/hijridate's
//                                      `MONTH_STARTS`, an unrelated
//                                      transcription of the official
//                                      Umm al-Qura tables
//   1 Ramadan 1445 AH    = 2024-03-11  the same source, and the start of
//                                      Ramadan Saudi Arabia observed
//   1 Muharram 1447 AH   = 2025-06-26  the published Umm al-Qura New Year
//   1 Muharram 1448 AH   = 2026-06-16  the same
//   30 Dhu al-Hijjah 1500 AH = 2077-11-16  the span's last day, and the
//                                      end of hijridate's own documented
//                                      Gregorian range
//
// hijridate agrees with the table here month-for-month over 1420-1450 AH;
// the two transcriptions differ by a day for some months further out,
// where they descend from different revisions of the published tables, so
// the anchors are all inside the agreeing range or are ICU's own span
// ends.
//
// 2026-09-01 is 1448-03-19 AH, the value docs/stdlib/time.md prints for
// `toString()`, so that example is pinned here too.

// `date(y, m, d)` for a triple this file already knows is a real calendar
// date. Every call below passes literal constants, so the failure path is
// unreachable; it panics rather than returning a substitute date, the same
// way ./business.test.bit does — a silently substituted date would make
// every assertion downstream of it meaningless.
fn hijriTestDate(y: int, m: int, d: int): Date {
  return date(y, m, d) catch e {
    panic("date(${y}, ${m}, ${d}) failed: ${e.message()}")
  }
}

// The Hijri rendering of a Gregorian date this file knows is in span.
fn hijriTestOf(y: int, m: int, d: int): HijriDate {
  return hijriTestDate(y, m, d).hijri() catch e {
    panic("hijri() failed for ${y}-${m}-${d}: ${e.message()}")
  }
}

// `hijriDate(y, m, d)` for a triple this file knows is in span.
fn hijriTestBuild(y: int, m: int, d: int): HijriDate {
  return hijriDate(y, m, d) catch e {
    panic("hijriDate(${y}, ${m}, ${d}) failed: ${e.message()}")
  }
}

// True when `hijri()` on this Gregorian date fails AND its failure
// carries a message. The fallible form is the point: a rejection that
// returned a usable `HijriDate` would be indistinguishable from an
// accepted one here, so the success path deliberately answers false.
fn hijriTestRejectsDate(y: int, m: int, d: int): bool {
  let h = hijriTestDate(y, m, d).hijri() catch e {
    return len(e.message()) > 0
  }
  return h.year() < 0
}

// The same, for the direct constructor.
fn hijriTestRejectsBuild(y: int, m: int, d: int): bool {
  let h = hijriDate(y, m, d) catch e {
    return len(e.message()) > 0
  }
  return h.year() < 0
}

// The same, for a format pattern.
fn hijriTestRejectsPattern(h: HijriDate, pattern: string): bool {
  let s = h.format(pattern) catch e {
    return len(e.message()) > 0
  }
  return len(s) < 0
}

// `format(pattern)` for a pattern this file knows is valid.
fn hijriTestFormat(h: HijriDate, pattern: string): string {
  return h.format(pattern) catch e {
    panic("format(${pattern}) failed: ${e.message()}")
  }
}

test "the published anchor dates convert exactly" {
  assert(
    hijriTestOf(1882, 11, 12).toString() == "1300-01-01",
    "the span's first day is 1 Muharram 1300",
  )
  assert(hijriTestOf(2021, 8, 9).toString() == "1443-01-01", "1 Muharram 1443 AH is 2021-08-09")
  assert(hijriTestOf(2024, 3, 11).toString() == "1445-09-01", "1 Ramadan 1445 AH is 2024-03-11")
  assert(hijriTestOf(2025, 6, 26).toString() == "1447-01-01", "1 Muharram 1447 AH is 2025-06-26")
  assert(hijriTestOf(2026, 6, 16).toString() == "1448-01-01", "1 Muharram 1448 AH is 2026-06-16")
  assert(
    hijriTestOf(2077, 11, 16).toString() == "1500-12-30",
    "the span's last day is 30 Dhu al-Hijjah 1500",
  )
  assert(
    hijriTestOf(2026, 9, 1).toString() == "1448-03-19",
    "the value docs/stdlib/time.md prints",
  )
}

test "the fields read what toString prints" {
  let h = hijriTestOf(2024, 3, 11)
  assert(h.year() == 1445, "year")
  assert(h.month() == 9, "month, Ramadan")
  assert(h.day() == 1, "day")
}

test "gregorian goes back to the day hijri came from" {
  assert(hijriTestOf(2024, 3, 11).gregorian().toString() == "2024-03-11", "1 Ramadan 1445")
  assert(
    hijriTestBuild(1443, 1, 1).gregorian().toString() == "2021-08-09",
    "built directly, not converted",
  )
  assert(hijriTestBuild(1300, 1, 1).gregorian().toString() == "1882-11-12", "the span's first day")
  assert(hijriTestBuild(1500, 12, 30).gregorian().toString() == "2077-11-16", "the span's last day")
}

test "every day of the tabulated span round-trips" {
  let masks = hijriMonthMasks()
  let total = 0
  let y = hijriFirstYear
  while (y <= hijriLastYear) {
    total = total + hijriYearLength(masks, y)
    y = y + 1
  }
  assert(total == 71228, "1300..1500 AH is 71228 days, ICU's table accumulated")

  let d = hijriTestDate(1882, 11, 12)
  let seen = 0
  while (seen < total) {
    let h = d.hijri() catch e {
      panic("hijri() failed ${seen} days into the span: ${e.message()}")
    }
    let back = h.gregorian()
    assert(back.isSame(d), "round trip at ${d.toString()} gave ${back.toString()}")
    d = d.addDays(1)
    seen = seen + 1
  }
  assert(d.toString() == "2077-11-17", "the sweep ended one day past the span")
}

test "the table itself is well formed" {
  let masks = hijriMonthMasks()
  assert(len(masks) == hijriLastYear - hijriFirstYear + 1, "one mask per tabulated year")
  let y = hijriFirstYear
  while (y <= hijriLastYear) {
    let ylen = hijriYearLength(masks, y)
    assert(ylen == 354 || ylen == 355, "year ${y} AH is 354 or 355 days, not ${ylen}")
    let m = 1
    while (m <= 12) {
      let mlen = hijriMonthLength(masks, y, m)
      assert(mlen == 29 || mlen == 30, "month ${m} of ${y} AH is 29 or 30 days")
      m = m + 1
    }
    y = y + 1
  }
}

test "a date outside the tabulated span fails rather than extrapolating" {
  assert(hijriTestRejectsDate(1882, 11, 11), "the day before 1 Muharram 1300 AH")
  assert(hijriTestRejectsDate(2077, 11, 17), "the day after 30 Dhu al-Hijjah 1500 AH")
  assert(hijriTestRejectsDate(1900, 1, 1) == false, "a date inside the span is accepted")
  assert(hijriTestRejectsBuild(1299, 12, 30), "1299 AH is before the table")
  assert(hijriTestRejectsBuild(1501, 1, 1), "1501 AH is after it")
}

test "hijriDate rejects a field the table does not carry" {
  assert(hijriTestRejectsBuild(1445, 0, 1), "month 0")
  assert(hijriTestRejectsBuild(1445, 13, 1), "month 13")
  assert(hijriTestRejectsBuild(1445, 9, 0), "day 0")
  assert(hijriTestRejectsBuild(1445, 10, 30), "Shawwal 1445 has 29 days")
  assert(hijriTestBuild(1445, 9, 30).toString() == "1445-09-30", "Ramadan 1445 has 30")
}

test "format renders the Hijri month names" {
  let h = hijriTestOf(2024, 3, 11)
  assert(hijriTestFormat(h, "d MMMM yyyy") == "1 Ramadan 1445", "full month name")
  assert(hijriTestFormat(h, "dd MMM yy") == "01 Ram 45", "abbreviation and two-digit year")
  assert(hijriTestFormat(h, "yyyy-MM-dd") == "1445-09-01", "numeric, the toString order")
  assert(
    hijriTestFormat(h, "EEEE d MMMM") == "Monday 1 Ramadan",
    "the weekday of the Gregorian day it renders",
  )
  assert(hijriTestFormat(h, "d MMMM yyyy 'AH'") == "1 Ramadan 1445 AH", "a quoted literal")
}

test "format rejects every field a HijriDate does not carry" {
  let h = hijriTestOf(2024, 3, 11)
  assert(hijriTestRejectsPattern(h, "HH:mm"), "a time field")
  assert(hijriTestRejectsPattern(h, "yyyy Z"), "a zone field")
  assert(hijriTestRejectsPattern(h, "YYYY"), "the week-based year")
  assert(hijriTestRejectsPattern(h, "D"), "the day of the year")
  assert(hijriTestRejectsPattern(h, "Q"), "a quarter of the Gregorian year")
  assert(hijriTestRejectsPattern(h, "MMMMM"), "the narrow month form")
  assert(hijriTestRejectsPattern(h, "d 'AH"), "an unterminated quoted literal")
}
