// stdlib/time/zoned.test.bit — the two `zonedFromWall` paths, differenced
// (#5591). Same module as ./zoned.bit (SPEC §19): no import is needed to
// reach `zonedFromWall`, `zonedFromWallScanning`, `zonedInstantSeconds`,
// `zoneIsFixed` or `ldmlpFixedZone`, all of which are deliberately
// unexported. A `_tests_/cases` program is a separate module and cannot
// reach any of them, exactly as ./zone.test.bit records for the two offset
// lookups; this file is the sanctioned in-module route.
//
// WHAT IS BEING GUARDED. #5591 made `zonedFromWall` return
// `DateTime{ wall: wall, z: z, off: z.fallback }` directly when the zone
// has no transitions, instead of converting the wall clock to an instant
// and converting it back. The claim that makes that sound is an EXACT
// INVERSE claim about ./civil.bit — `civilFromSeconds(zonedWallSeconds(w),
// w.nanosecond())` reproduces `w` field for field — and an exact-inverse
// claim is only ever as good as its worst input. So every case below runs
// BOTH constructions over the same wall clock and the same zone and
// compares every accessor `DateTime` has, rather than checking the fast
// path against hand-written expectations: `zonedFromWallScanning` is the
// code that shipped before #5591, so it is the oracle, and a divergence
// anywhere in the 1..9999 year range is a red test rather than a wrong
// `DateTime` in a user's program.
//
// The inputs are chosen where an inverse fails if it is going to: the
// epoch itself, either side of it (`civilFloorDiv`'s negative branch), the
// first and last instants `date()` admits, a leap day, a leap-year
// boundary, the last representable nanosecond of a day, and negative as
// well as positive fixed offsets, since `wallSeconds - z.fallback` crosses
// a day boundary in opposite directions for the two signs.

// One wall clock, one transition-free zone, both constructions, every
// accessor. `zoneIsFixed` is asserted first: were it false the two calls
// would run the same code and the whole differential would be vacuous.
fn zonedAssertSamePath(label: string, wall: NaiveDateTime, z: Zone) {
  assert(zoneIsFixed(z), "${label}: zone '${z.name}' has transitions; the differential is vacuous")
  let fast = zonedFromWall(wall, z)
  let slow = zonedFromWallScanning(wall, z)
  assert(fast.year() == slow.year(), "${label}: year ${fast.year()} != ${slow.year()}")
  assert(fast.month() == slow.month(), "${label}: month ${fast.month()} != ${slow.month()}")
  assert(fast.day() == slow.day(), "${label}: day ${fast.day()} != ${slow.day()}")
  assert(fast.hour() == slow.hour(), "${label}: hour ${fast.hour()} != ${slow.hour()}")
  assert(fast.minute() == slow.minute(), "${label}: minute ${fast.minute()} != ${slow.minute()}")
  assert(fast.second() == slow.second(), "${label}: second ${fast.second()} != ${slow.second()}")
  assert(
    fast.nanosecond() == slow.nanosecond(),
    "${label}: nanosecond ${fast.nanosecond()} != ${slow.nanosecond()}",
  )
  assert(
    fast.dayOfWeek() == slow.dayOfWeek(),
    "${label}: dayOfWeek ${fast.dayOfWeek()} != ${slow.dayOfWeek()}",
  )
  assert(
    fast.dayOfYear() == slow.dayOfYear(),
    "${label}: dayOfYear ${fast.dayOfYear()} != ${slow.dayOfYear()}",
  )
  assert(
    fast.weekOfYear() == slow.weekOfYear(),
    "${label}: weekOfYear ${fast.weekOfYear()} != ${slow.weekOfYear()}",
  )
  assert(fast.offset() == slow.offset(), "${label}: offset ${fast.offset()} != ${slow.offset()}")
  assert(fast.isDst() == slow.isDst(), "${label}: isDst ${fast.isDst()} != ${slow.isDst()}")
  assert(
    fast.zone().name == slow.zone().name,
    "${label}: zone name ${fast.zone().name} != ${slow.zone().name}",
  )
  assert(
    fast.toString() == slow.toString(),
    "${label}: toString ${fast.toString()} != ${slow.toString()}",
  )
  assert(
      zonedInstantSeconds(fast.naive(), fast.offset()) ==
      zonedInstantSeconds(slow.naive(), slow.offset()),
      "${label}: instant ${zonedInstantSeconds(fast.naive(), fast.offset())} != " +
      "${zonedInstantSeconds(slow.naive(), slow.offset())}",
  )
  // The wall clock the fast path keeps must also BE the one it was handed,
  // not merely agree with the rebuilt one: that is the saving itself.
  assert(
    fast.toString() == wall.toString() + zonedFormatOffset(z.fallback),
    "${label}: fast ${fast.toString()} is not ${wall.toString()} at ${z.fallback}",
  )
}

// Every transition-free zone shape there is, against the wall clock `s`
// names: `utc()` (offset 0, name "UTC"), two positive fixed offsets, two
// negative ones, and one whose minutes are not zero, since
// `wallSeconds - z.fallback` leaves the minute field alone in every other
// case. `parseNaiveDateTime` builds the wall clock because it is the
// module's own validating reader and touches no zone and no `DateTime` —
// nothing on the path under test here.
fn zonedAssertEveryFixedZone(s: string) {
  let wall = parseNaiveDateTime(s) catch e {
    assert(false, "${s}: not a wall clock: ${e.message()}")
    return
  }
  zonedAssertSamePath("${s} UTC", wall, utc())
  zonedAssertSamePath("${s} +14:00", wall, ldmlpFixedZone(50400))
  zonedAssertSamePath("${s} +04:00", wall, ldmlpFixedZone(14400))
  zonedAssertSamePath("${s} -05:30", wall, ldmlpFixedZone(-19800))
  zonedAssertSamePath("${s} -12:00", wall, ldmlpFixedZone(-43200))
}

test "#5591: the fixed-zone fast path matches the scanning path at the epoch" {
  zonedAssertEveryFixedZone("1970-01-01T00:00:00")
}

test "#5591: the fixed-zone fast path matches the scanning path before 1970" {
  zonedAssertEveryFixedZone("1969-12-31T23:59:59.999999999")
  zonedAssertEveryFixedZone("1900-06-15T12:00:00")
}

test "#5591: the fixed-zone fast path matches the scanning path on a leap day" {
  zonedAssertEveryFixedZone("2024-02-29T12:34:56.123456789")
  zonedAssertEveryFixedZone("2000-02-29T00:00:00")
}

test "#5591: the fixed-zone fast path matches the scanning path at a day's last nanosecond" {
  zonedAssertEveryFixedZone("2023-12-31T23:59:59.999999999")
  zonedAssertEveryFixedZone("2024-01-01T00:00:00.000000001")
}

test "#5591: the fixed-zone fast path matches the scanning path at both ends of the year range" {
  zonedAssertEveryFixedZone("0001-01-01T00:00:00")
  zonedAssertEveryFixedZone("9999-12-31T23:59:59.999999999")
}

// The fast path is EQUAL to the scanning path above; this pins what both
// of them are, so a defect shared by the two (an inverse that is wrong in
// the same direction twice) cannot pass. Expectations are the documented
// canonical forms and the plain instant arithmetic, not this module's own
// output read back.
test "#5591: parseDateTime's own values are unchanged by the fast path" {
  let zulu = parseDateTime("2024-01-01T00:00:00Z") catch e {
    assert(false, "parse Z failed: ${e.message()}")
    return
  }
  assert(zulu.toString() == "2024-01-01T00:00:00+00:00", "Z: ${zulu.toString()}")
  assert(
    zonedInstantSeconds(zulu.naive(), zulu.offset()) == 1704067200,
    "Z instant = ${zonedInstantSeconds(zulu.naive(), zulu.offset())}, want 1704067200",
  )
  let west = parseDateTime("1969-07-20T20:17:40-05:30") catch e {
    assert(false, "parse -05:30 failed: ${e.message()}")
    return
  }
  assert(west.toString() == "1969-07-20T20:17:40-05:30", "-05:30: ${west.toString()}")
  assert(west.offset() == -19800, "-05:30 offset = ${west.offset()}")
  assert(
    zonedInstantSeconds(west.naive(), west.offset()) == -14163140,
    "-05:30 instant = ${zonedInstantSeconds(west.naive(), west.offset())}, want -14163140",
  )
  assert(!west.isDst(), "a fixed offset is never daylight saving")
}

// The other half of the branch: a zone that DOES have transitions must not
// reach the fast path at all, or #5591 would have silently deleted the
// daylight-saving policy. Europe/London's 2026 spring gap is the case that
// proves it — the fast path would answer 01:30 +00:00, the documented
// result is 02:30 +01:00 (docs/stdlib/time.md, "`inZone` pushes forward").
test "#5591: a zone with transitions still resolves its spring gap" {
  let z = zone("Europe/London") catch e {
    assert(false, "zone(Europe/London) failed: ${e.message()}")
    return
  }
  assert(!zoneIsFixed(z), "Europe/London has no transitions on this host")
  let wall = parseNaiveDateTime("2026-03-29T01:30:00") catch e {
    assert(false, "gap wall clock failed: ${e.message()}")
    return
  }
  let dt = zonedFromWall(wall, z)
  assert(dt.hour() == 2 && dt.minute() == 30, "gap resolved to ${dt.toString()}, want 02:30")
  assert(dt.offset() == 3600, "gap offset = ${dt.offset()}, want 3600")
}
