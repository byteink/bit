// stdlib/time/ldmlparse.test.bit — the five parse functions
// (./ldmlparse.bit, #4081). Same module as ./ldmlparse.bit, ./date.bit,
// ./timeofday.bit, ./naive.bit and ./zoned.bit (SPEC §19): no import is
// needed to reach `parseDate`, `parseTime`, `parseNaiveDateTime`,
// `parseDateTime`, `parseWith`, `date`, `timeNs` or `zone`.
//
// The property under test is the round trip: what a type's `toString`
// writes, its parse function reads back to the same value, and printing
// that value again gives the same bytes. Every strictness rule in
// docs/stdlib/time.md ("Parsing") has a rejection case below — a parser is
// only as good as what it refuses.

// The parse of `s`, printed, or the failure message prefixed `ERR:`. No
// canonical form starts with `ERR:`, so a test expecting a failure cannot
// pass on a success.
fn ldmlpTestDate(s: string): string {
  let v = parseDate(s) catch e {
    return "ERR:" + e.message()
  }
  return v.toString()
}

fn ldmlpTestTime(s: string): string {
  let v = parseTime(s) catch e {
    return "ERR:" + e.message()
  }
  return v.toString()
}

fn ldmlpTestNaive(s: string): string {
  let v = parseNaiveDateTime(s) catch e {
    return "ERR:" + e.message()
  }
  return v.toString()
}

fn ldmlpTestZoned(s: string): string {
  let v = parseDateTime(s) catch e {
    return "ERR:" + e.message()
  }
  return v.toString()
}

fn ldmlpTestWith(pattern: string, s: string): string {
  let v = parseWith(pattern, s) catch e {
    return "ERR:" + e.message()
  }
  return v.toString()
}

// True when `hay` starts with `needle` — the rejection tests only check
// that a failure happened and which field it names, never the whole
// message, so rewording an error does not break them.
fn ldmlpTestHas(hay: string, needle: string): bool {
  let i = 0
  while (i + len(needle) <= len(hay)) {
    if (hay[i:i + len(needle)] == needle) {
      return true
    }
    i = i + 1
  }
  return false
}

test "each canonical toString reads back to the same bytes" {
  assert(ldmlpTestDate("2026-09-01") == "2026-09-01", "a date round-trips")
  assert(ldmlpTestTime("09:00:00") == "09:00:00", "a time of day round-trips")
  assert(
    ldmlpTestTime("09:00:00.000000500") == "09:00:00.000000500",
    "a nanosecond-bearing time round-trips: ${ldmlpTestTime("09:00:00.000000500")}",
  )
  assert(
    ldmlpTestNaive("2026-09-01T09:00:00") == "2026-09-01T09:00:00",
    "a wall clock round-trips: ${ldmlpTestNaive("2026-09-01T09:00:00")}",
  )
  assert(
    ldmlpTestZoned("2026-09-01T09:00:00+04:00") == "2026-09-01T09:00:00+04:00",
    "a zoned value round-trips: ${ldmlpTestZoned("2026-09-01T09:00:00+04:00")}",
  )
}

test "a parsed date carries the fields it was written with" {
  let d = parseDate("2026-09-01") catch e {
    panic("parseDate failed: ${e.message()}")
  }
  assert(d.year() == 2026, "year")
  assert(d.month() == 9, "month")
  assert(d.day() == 1, "day")
  assert(d.dayOfWeek() == 2, "2026-09-01 is a Tuesday")
}

test "a fraction is zero-padded on the right, not left" {
  assert(ldmlpTestTime("09:00:00.5") == "09:00:00.500000000", "'.5' is half a second")
  assert(ldmlpTestTime("09:00:00.000000500") == "09:00:00.000000500", "nine digits is 500ns")
  assert(ldmlpTestTime("09:00:00.123456789") == "09:00:00.123456789", "every place is kept")
}

test "a ten-digit fraction fails rather than truncating" {
  let got = ldmlpTestTime("09:00:00.1234567890")
  assert(ldmlpTestHas(got, "ERR:"), "ten digits is refused: ${got}")
  assert(ldmlpTestHas(got, "fractional second"), "and says why: ${got}")
  assert(ldmlpTestHas(ldmlpTestTime("09:00:00."), "ERR:"), "an empty fraction is refused")
}

test "a lowercase t or z is not the RFC 3339 separator this module writes" {
  assert(ldmlpTestHas(ldmlpTestNaive("2026-09-01t09:00:00"), "ERR:"), "lowercase t")
  assert(ldmlpTestHas(ldmlpTestZoned("2026-09-01T09:00:00z"), "ERR:"), "lowercase z")
  assert(ldmlpTestHas(ldmlpTestZoned("2026-09-01t09:00:00z"), "ERR:"), "both at once")
}

test "a zone offset needs its colon" {
  let got = ldmlpTestZoned("2026-09-01T09:00:00+0400")
  assert(ldmlpTestHas(got, "ERR:"), "+0400 is refused: ${got}")
  assert(
    ldmlpTestZoned("2026-09-01T09:00:00-04:00") == "2026-09-01T09:00:00-04:00",
    "a west offset",
  )
  assert(ldmlpTestHas(ldmlpTestZoned("2026-09-01T09:00:00"), "ERR:"), "a missing zone is refused")
}

test "a leap second is refused, by timeofday.bit's own bound" {
  assert(ldmlpTestHas(ldmlpTestTime("09:00:60"), "ERR:"), "a :60 second")
  assert(ldmlpTestHas(ldmlpTestZoned("2026-09-01T09:00:60Z"), "ERR:"), "and through the zoned form")
  assert(ldmlpTestHas(ldmlpTestTime("24:00:00"), "ERR:"), "and there is no 24:00:00")
}

test "whitespace and trailing characters are never skipped" {
  assert(ldmlpTestHas(ldmlpTestDate(" 2026-09-01"), "ERR:"), "a leading space")
  assert(ldmlpTestHas(ldmlpTestDate("2026-09-01 "), "ERR:"), "a trailing space")
  assert(ldmlpTestHas(ldmlpTestDate("2026-09-01x"), "ERR:"), "a trailing character")
  assert(ldmlpTestHas(ldmlpTestNaive("2026-09-01T09:00:00 "), "ERR:"), "on a wall clock too")
  assert(ldmlpTestHas(ldmlpTestTime("09:00:00x"), "ERR:"), "and on a time of day")
}

test "an impossible calendar date is date()'s own refusal" {
  assert(ldmlpTestHas(ldmlpTestDate("2026-02-30"), "ERR:"), "February has no 30th")
  assert(ldmlpTestHas(ldmlpTestDate("2026-13-01"), "ERR:"), "there is no month 13")
  assert(ldmlpTestDate("2024-02-29") == "2024-02-29", "but 2024 is a leap year")
  assert(ldmlpTestHas(ldmlpTestDate("2026-02-29"), "ERR:"), "and 2026 is not")
}

test "the zone recovered from an offset is a fixed offset, not an IANA zone" {
  let t = parseDateTime("2026-09-01T09:00:00+04:00") catch e {
    panic("parseDateTime failed: ${e.message()}")
  }
  assert(t.offset() == 14400, "+04:00 is 14400 seconds east: ${t.offset()}")
  assert(t.zone().name == "+04:00", "the zone is named by the offset: ${t.zone().name}")
  assert(!t.isDst(), "a fixed offset is never daylight saving")
  assert(t.date().toString() == "2026-09-01", "the wall clock is kept")
  assert(t.time().toString() == "09:00:00", "including the time of day")
}

test "Z is the utc() zone and keeps the instant it names" {
  let t = parseDateTime("2026-09-01T09:00:00Z") catch e {
    panic("parseDateTime failed: ${e.message()}")
  }
  assert(t.zone().name == "UTC", "Z is utc(): ${t.zone().name}")
  assert(t.offset() == 0, "with a zero offset")
  assert(t.toString() == "2026-09-01T09:00:00+00:00", "printed numerically: ${t.toString()}")
}

test "withZone moves a parsed offset onto a real zone, same instant" {
  let parsed = parseDateTime("2026-09-01T05:00:00Z") catch e {
    panic("parseDateTime failed: ${e.message()}")
  }
  let dubai = zone("Asia/Dubai") catch e {
    panic("zone failed: ${e.message()}")
  }
  let moved = parsed.withZone(dubai)
  assert(
    moved.toString() == "2026-09-01T09:00:00+04:00",
    "05:00Z is 09:00 in Dubai: ${moved.toString()}",
  )
  assert(moved.zone().name == "Asia/Dubai", "and the zone identity is the caller's")
}

test "parseWith reads a foreign order through the formatter's own table" {
  assert(ldmlpTestWith("dd/MM/yyyy", "01/09/2026") == "2026-09-01T00:00:00", "UK order")
  assert(ldmlpTestWith("MM/dd/yyyy", "09/01/2026") == "2026-09-01T00:00:00", "US order")
  assert(ldmlpTestWith("d/M/yyyy", "1/9/2026") == "2026-09-01T00:00:00", "single-digit widths")
  assert(
    ldmlpTestWith("yyyy-MM-dd HH:mm:ss", "2026-09-01 09:05:07") == "2026-09-01T09:05:07",
    "with a time",
  )
}

test "parseWith reads the month and day names format() writes" {
  assert(ldmlpTestWith("d MMMM yyyy", "1 September 2026") == "2026-09-01T00:00:00", "MMMM")
  assert(ldmlpTestWith("d MMM yyyy", "1 Sep 2026") == "2026-09-01T00:00:00", "MMM")
  assert(
    ldmlpTestWith("EEEE, d MMMM yyyy", "Tuesday, 1 September 2026") == "2026-09-01T00:00:00",
    "EEEE: ${ldmlpTestWith("EEEE, d MMMM yyyy", "Tuesday, 1 September 2026")}",
  )
  let wrong = ldmlpTestWith("EEEE, d MMMM yyyy", "Monday, 1 September 2026")
  assert(ldmlpTestHas(wrong, "ERR:"), "a weekday name that contradicts the date: ${wrong}")
}

test "parseWith handles the 12-hour clock only with its meridiem" {
  assert(ldmlpTestWith("h:mm a", "9:05 AM") == "0001-01-01T09:05:00", "AM")
  assert(ldmlpTestWith("h:mm a", "9:05 PM") == "0001-01-01T21:05:00", "PM")
  assert(ldmlpTestWith("h:mm a", "12:00 AM") == "0001-01-01T00:00:00", "midnight is 12 AM")
  assert(ldmlpTestWith("h:mm a", "12:00 PM") == "0001-01-01T12:00:00", "noon is 12 PM")
  assert(ldmlpTestHas(ldmlpTestWith("h:mm", "9:05"), "ERR:"), "h with no a is refused")
  assert(ldmlpTestHas(ldmlpTestWith("h:mm a", "9:05 am"), "ERR:"), "lowercase am is refused")
}

test "parseWith rejects Y and D with the formatter's own message" {
  let y = ldmlpTestWith("YYYY-MM-dd", "2026-09-01")
  assert(ldmlpTestHas(y, "WEEK-BASED year"), "Y names the week-based year: ${y}")
  assert(ldmlpTestHas(y, "weekOfYear()"), "and points at the alternative")
  let d = ldmlpTestWith("yyyy-DDD", "2026-244")
  assert(ldmlpTestHas(d, "day of the YEAR"), "D names the day of the year: ${d}")
  assert(ldmlpTestHas(d, "dayOfYear()"), "and points at the alternative")
}

test "parseWith rejects what a NaiveDateTime cannot carry" {
  assert(ldmlpTestHas(ldmlpTestWith("yyyy-MM-ddZ", "2026-09-01+0400"), "zone field"), "Z")
  assert(ldmlpTestHas(ldmlpTestWith("X", "Z"), "zone field"), "X")
  assert(ldmlpTestHas(ldmlpTestWith("V", "UTC"), "zone field"), "V")
  assert(ldmlpTestHas(ldmlpTestWith("Q", "3"), "quarter"), "Q names no month")
  assert(ldmlpTestHas(ldmlpTestWith("G", "AD"), "ERR:"), "an unimplemented letter")
}

test "parseWith is as strict about the input as the canonical parsers" {
  assert(ldmlpTestHas(ldmlpTestWith("dd/MM/yyyy", "1/9/2026"), "ERR:"), "dd wants two digits")
  assert(ldmlpTestHas(ldmlpTestWith("dd/MM/yyyy", "01-09-2026"), "ERR:"), "a literal must match")
  assert(
    ldmlpTestHas(ldmlpTestWith("dd/MM/yyyy", "01/09/2026 "), "ERR:"),
    "nothing may be left over",
  )
  assert(ldmlpTestHas(ldmlpTestWith("yyyy", "202"), "ERR:"), "a short input fails")
  assert(
    ldmlpTestHas(ldmlpTestWith("yyyy-MM-dd", "2026-02-30"), "ERR:"),
    "date() still owns the calendar",
  )
}

test "parseWith reads yy inside this century and S as a padded fraction" {
  assert(ldmlpTestWith("yy-MM-dd", "26-09-01") == "2026-09-01T00:00:00", "yy is 2000..2099")
  assert(
    ldmlpTestWith("HH:mm:ss.SSS", "09:00:00.123") == "0001-01-01T09:00:00.123000000",
    "SSS is millis",
  )
  assert(
    ldmlpTestWith("HH:mm:ss.SSSSSSSSS", "09:00:00.000000500") == "0001-01-01T09:00:00.000000500",
    "nine S is the whole field",
  )
}

test "a pattern error from the shared tokeniser surfaces here too" {
  let got = ldmlpTestWith("'unterminated", "x")
  assert(ldmlpTestHas(got, "ERR:"), "an unterminated quoted literal: ${got}")
  assert(
    ldmlpTestWith("'at' HH:mm", "at 09:05") == "0001-01-01T09:05:00",
    "a quoted literal matches",
  )
}
