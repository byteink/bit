// Bit standard library — time module, whole-unit differences (#4078).
//
// The `differenceIn*` family of docs/stdlib/time.md's "Differences"
// section, for `Date` (./date.bit), `NaiveDateTime` (./naive.bit),
// `DateTime` (./zoned.bit) and `Timestamp` (./time.bit). Split out of its
// sibling ./compare.bit — same ticket, same trait-injection mechanism
// (SPEC §10.7, see that file's header for why a second `export class Date`
// here would be `E0042`) — so neither file carries two families at once.
// None of these methods fails.
//
// Sibling of ./civil.bit, ./calarith.bit and ./compare.bit, same module
// (SPEC §17.1): `civilSecondNs`/`civilMinuteNs`/`civilHourNs`,
// `compareDateDays`, `compareNaiveSeconds`, `compareZonedSeconds`,
// `zonedInstantSeconds` and every type's own `compare`/`addMonths` are used
// here unqualified, no import, no redeclaration.
//
// Three rules this file exists to hold:
//
//   EVERY RESULT IS TRUNCATED TOWARD ZERO — complete units only, partial
//   units dropped, in both directions (docs/stdlib/time.md,
//   "Differences"). This is what an age calculation needs: someone born
//   2000-06-15 is 25 on 2026-06-14 and 26 on 2026-06-15. A negative
//   difference truncates the same way, toward zero and never away from it,
//   so `a.differenceInDays(b)` is exactly `-b.differenceInDays(a)` for
//   every pair.
//
//   A COMPLETE MONTH IS ONE THE `addMonths` ANNIVERSARY HAS REACHED.
//   `differenceInMonths` asks whether `this.addMonths(n)` has arrived at
//   or passed `other`, so it inherits ./calarith.bit's documented clamp
//   (docs/stdlib/time.md, "Month arithmetic clamps") rather than adding a
//   second end-of-month rule of its own: 2026-01-31 to 2026-02-28 is ONE
//   complete month, because 2026-01-31 plus one month IS 2026-02-28.
//   `differenceInYears` is that count divided by 12, so the two can never
//   disagree.
//
//   ON A `DateTime`, DATE UNITS READ THE WALL CLOCK AND TIME UNITS READ
//   THE INSTANT. `differenceInDays` across a daylight-saving transition is
//   1 — a calendar day — while `differenceInHours` over the same pair is
//   25, and subtracting the two `Timestamp` values gives the same 25 hours
//   of real time. Both answers are correct and they legitimately disagree
//   (docs/stdlib/time.md, "Differences"); nothing here tries to reconcile
//   them. The split is the same one the rest of the module already makes:
//   `addDays` (./calarith.bit) moves the wall clock, `Timestamp.add` moves
//   the instant.
//
// No nanosecond key is ever built for a `Date`, `NaiveDateTime` or
// `DateTime` — years 1..9999 in nanoseconds is about 2.5e20, past `int`'s
// range (./compare.bit's header). Sub-day differences on those types are
// computed in seconds and only then scaled.

// A difference of `deltaSeconds` seconds and `deltaNanos` nanoseconds,
// truncated toward zero to whole seconds. The two parts can disagree in
// sign — 3 seconds minus a fraction is 2 complete seconds, -3 seconds plus
// a fraction is -2 — which is the only reason this is not a subtraction.
fn differenceTruncSeconds(deltaSeconds: int, deltaNanos: int): int {
  if (deltaSeconds > 0 && deltaNanos < 0) {
    return deltaSeconds - 1
  }
  if (deltaSeconds < 0 && deltaNanos > 0) {
    return deltaSeconds + 1
  }
  return deltaSeconds
}

// Complete seconds from wall clock `start` to wall clock `to`, truncated
// toward zero. Both readings are unzoned, so a day here is exactly 86400
// seconds and every coarser unit below is a division of this one.
fn differenceNaiveSeconds(start: NaiveDateTime, to: NaiveDateTime): int {
  return differenceTruncSeconds(
    compareNaiveSeconds(to) - compareNaiveSeconds(start),
    to.nanosecond() - start.nanosecond(),
  )
}

// Complete months from wall clock `start` to wall clock `to`, truncated
// toward zero (file header: the `addMonths` anniversary rule). The
// calendar month gap is right or one too many in magnitude, never more:
// `start.addMonths(rough - 1)` lands in the month before `to`'s own, so it
// cannot itself overshoot, and the same argument mirrors for a negative
// gap. Hence one correction, not a loop.
fn differenceNaiveMonths(start: NaiveDateTime, to: NaiveDateTime): int {
  let rough = to.year() * 12 + to.month() - (start.year() * 12 + start.month())
  if (rough > 0 && start.addMonths(rough).compare(to) > 0) {
    return rough - 1
  }
  if (rough < 0 && start.addMonths(rough).compare(to) < 0) {
    return rough + 1
  }
  return rough
}

// `d` at midnight, as a wall clock with no zone. Lets `Date`'s own
// `differenceInMonths` reach `differenceNaiveMonths` instead of carrying a
// second copy of the anniversary rule: both types clamp through the same
// `calArithShiftMonth` (./calarith.bit), and two dates at midnight are a
// whole number of days apart, so no time of day can change the answer.
fn differenceAtMidnight(d: Date): NaiveDateTime {
  return NaiveDateTime{ dt: d, tm: Time{ h: 0, min: 0, s: 0, nanos: 0 } }
}

// Complete seconds of REAL ELAPSED TIME from the instant `(wall, off)`
// names to the instant `to` names, truncated toward zero. The `DateTime`
// time-unit path (file header), and the one place in this file that reads
// an offset.
fn differenceZonedSeconds(wall: NaiveDateTime, off: int, to: DateTime): int {
  return differenceTruncSeconds(
    compareZonedSeconds(to) - zonedInstantSeconds(wall, off),
    to.nanosecond() - wall.nanosecond(),
  )
}

// Seconds in a day and in a week, for the divisions below. A day is
// exactly 86400 seconds everywhere in this module — no leap seconds
// (./timeofday.bit), and a daylight-saving transition moves the offset,
// never the length of a wall-clock day.
const differenceDaySeconds: int = 86400
const differenceWeekSeconds: int = 604800

// --- Date --------------------------------------------------------------------

trait DateDifference {
  // Complete calendar days from `this` to `other`, negative when `other`
  // is earlier. Exact: a `Date` has no time of day, so nothing is
  // truncated away.
  differenceInDays(other: Date): int {
    return compareDateDays(other) - civilDaysFromCivil(this.y, this.m, this.d)
  }

  // Complete weeks from `this` to `other` — `differenceInDays` divided by
  // 7, truncated toward zero, so six days is 0 and eight days is 1.
  differenceInWeeks(other: Date): int {
    return this.differenceInDays(other) / 7
  }

  // Complete months from `this` to `other` (file header: the `addMonths`
  // anniversary rule, so 2026-01-31 to 2026-02-28 is 1). Negative when
  // `other` is earlier.
  differenceInMonths(other: Date): int {
    let start = differenceAtMidnight(Date{ y: this.y, m: this.m, d: this.d })
    return differenceNaiveMonths(start, differenceAtMidnight(other))
  }

  // Complete years from `this` to `other`: `differenceInMonths` divided by
  // 12, so the two can never disagree. An age in years — someone born
  // 2000-06-15 is 25 on 2026-06-14 and 26 on 2026-06-15
  // (docs/stdlib/time.md, "Differences").
  differenceInYears(other: Date): int {
    return this.differenceInMonths(other) / 12
  }
}

// --- NaiveDateTime -----------------------------------------------------------

trait NaiveDateTimeDifference {
  // Complete seconds from `this` to `other`, truncated toward zero.
  // Nanoseconds count toward completeness but are never reported here: a
  // gap of 1.9 seconds is 1.
  differenceInSeconds(other: NaiveDateTime): int {
    return differenceNaiveSeconds(NaiveDateTime{ dt: this.dt, tm: this.tm }, other)
  }

  // Complete minutes from `this` to `other`.
  differenceInMinutes(other: NaiveDateTime): int {
    return this.differenceInSeconds(other) / 60
  }

  // Complete hours from `this` to `other`.
  differenceInHours(other: NaiveDateTime): int {
    return this.differenceInSeconds(other) / 3600
  }

  // Complete days from `this` to `other`. A wall-clock day here is exactly
  // 24 hours, so 2026-09-17T09:00 to 2026-09-18T08:59 is 0 days, not 1.
  differenceInDays(other: NaiveDateTime): int {
    return this.differenceInSeconds(other) / differenceDaySeconds
  }

  // Complete weeks from `this` to `other`.
  differenceInWeeks(other: NaiveDateTime): int {
    return this.differenceInSeconds(other) / differenceWeekSeconds
  }

  // Complete months from `this` to `other`, time of day included: the
  // anniversary must have been reached, so 2026-01-31T09:00 to
  // 2026-02-28T08:00 is 0 months and 2026-02-28T09:00 is 1.
  differenceInMonths(other: NaiveDateTime): int {
    return differenceNaiveMonths(NaiveDateTime{ dt: this.dt, tm: this.tm }, other)
  }

  // Complete years from `this` to `other`: `differenceInMonths` divided by
  // 12.
  differenceInYears(other: NaiveDateTime): int {
    return this.differenceInMonths(other) / 12
  }
}

// --- DateTime ----------------------------------------------------------------

trait DateTimeDifference {
  // Complete seconds of REAL ELAPSED TIME from `this` to `other` — the
  // instant difference, so it agrees with `compare` (./compare.bit) and
  // with subtracting the two `Timestamp` values, and it is 90000 across a
  // fall-back day rather than 86400 (file header).
  differenceInSeconds(other: DateTime): int {
    return differenceZonedSeconds(this.wall, this.off, other)
  }

  // Complete minutes of real elapsed time from `this` to `other`.
  differenceInMinutes(other: DateTime): int {
    return this.differenceInSeconds(other) / 60
  }

  // Complete hours of real elapsed time from `this` to `other`: 25 across
  // a fall-back day, 23 across a spring-forward day.
  differenceInHours(other: DateTime): int {
    return this.differenceInSeconds(other) / 3600
  }

  // Complete CALENDAR days from `this` to `other`, read on the wall clock:
  // 1 across a daylight-saving transition even though 25 hours of real
  // time elapsed (file header). Cross-zone callers convert one side with
  // `withZone` first — this reads each side's own wall clock.
  differenceInDays(other: DateTime): int {
    return this.wall.differenceInDays(other.naive())
  }

  // Complete calendar weeks from `this` to `other`, on the wall clock.
  differenceInWeeks(other: DateTime): int {
    return this.wall.differenceInWeeks(other.naive())
  }

  // Complete calendar months from `this` to `other`, on the wall clock.
  differenceInMonths(other: DateTime): int {
    return this.wall.differenceInMonths(other.naive())
  }

  // Complete calendar years from `this` to `other`, on the wall clock.
  differenceInYears(other: DateTime): int {
    return this.wall.differenceInYears(other.naive())
  }
}

// --- Timestamp ---------------------------------------------------------------

trait TimestampDifference {
  // Nanoseconds of real elapsed time from `this` to `other`, exact and
  // negative when `other` is earlier. Wraps for a pair spanning nearly the
  // whole representable range — 1677 to 2262 is more than `int` can hold —
  // the same way `Timestamp.add` (./calarith.bit) wraps, and for the same
  // reason: this family is total (docs/stdlib/time.md, "Differences").
  differenceInNanoseconds(other: Timestamp): int {
    return other.ns - this.ns
  }

  // Complete seconds of real elapsed time from `this` to `other`,
  // truncated toward zero.
  differenceInSeconds(other: Timestamp): int {
    return this.differenceInNanoseconds(other) / civilSecondNs
  }

  // Complete minutes of real elapsed time from `this` to `other`.
  differenceInMinutes(other: Timestamp): int {
    return this.differenceInNanoseconds(other) / civilMinuteNs
  }

  // Complete hours of real elapsed time from `this` to `other`.
  differenceInHours(other: Timestamp): int {
    return this.differenceInNanoseconds(other) / civilHourNs
  }
}
