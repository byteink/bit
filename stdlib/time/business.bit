// Bit standard library — time module, business days (#4079).
//
// `Weekend`, `Calendar` and the five business-day methods on the three
// calendar types (docs/stdlib/time.md, "Business days"). A business day is
// any day that is not a weekend day and not in the supplied holiday set.
//
// Delivered by trait injection (SPEC §10.7), the same mechanism
// ./calarith.bit (#4076), ./bounds.bit (#4077) and ./compare.bit (#4078)
// already use, and for the same reason: Bit has no extension-method syntax
// (SPEC §10.4), a method exists only inside the body of the class that
// declares it, and a second `export class Date { ... }` in this module is
// `E0042`. Each trait below is `use`d by one added line in its target
// class's own body.
//
// Sibling of ./civil.bit, ./date.bit, ./naive.bit and ./zoned.bit, same
// module (SPEC §17.1): `Date`, `NaiveDateTime`, `DateTime`,
// `civilDaysFromCivil` and `newError` are used here unqualified, no import,
// no redeclaration.
//
// Four rules this file exists to hold:
//
//   THE WEEKEND IS ALWAYS A PARAMETER. There is no correct global default
//   and none is read from the host, an environment variable or a locale.
//   The UAE moved from Friday/Saturday to Saturday/Sunday in 2022, Saudi
//   Arabia is still Friday/Saturday, Europe and the Americas are
//   Saturday/Sunday: the right answer is a property of the organisation,
//   not of the machine the code runs on. `weekendSatSun()` exists as the
//   common case, not as an implicit default.
//
//   NO HOLIDAY DATA SHIPS. `Calendar` takes its holidays from the caller.
//   Public holidays are set by governments, change every year, and several
//   in this region depend on a moon sighting announced days in advance. A
//   bundled list would be silently wrong, and silently wrong is worse than
//   absent.
//
//   EVERY DAY-STEPPING LOOP IS BOUNDED. `weekendOn` rejects an all-seven-day
//   weekend, so at least one weekday always exists — but a holiday list
//   could still cover a long run, so the search for the next business day
//   is capped at `businessMaxStep` days and a run past it panics naming the
//   calendar. Ten years of consecutive holidays is a caller error, not a
//   runtime condition, so it is not reported as a failure.
//
//   ON `NaiveDateTime` AND `DateTime` THESE METHODS READ THE WALL-CLOCK
//   DATE AND RETURN A `Date`. A business day is a property of the calendar
//   day, so the time of day and the offset carry no information here. This
//   is the same wall-clock reading the rest of the module already makes for
//   date units (docs/stdlib/time.md, "Differences"), so the answer is
//   unchanged across a daylight saving transition.

// The furthest any single search steps before giving up: 3660 days, ten
// years (file header). A cap on the CONSECUTIVE non-business-day run, not
// on a whole `addBusinessDays` call, so `addBusinessDays(c, 5000)` is fine
// while a decade-long holiday list is not.
const businessMaxStep: int = 3660

// Which days of the week are not worked, as day numbers 1 Monday .. 7
// Sunday (docs/stdlib/time.md, "Business days"). Immutable: the field is
// unexported and every constructor below copies the caller's slice, so a
// caller mutating the slice it passed cannot change a `Weekend` afterwards.
export class Weekend {
  readonly days: []int
}

// A `Weekend` plus the holiday dates it is used with — everything
// `isBusinessDay` needs. Built by `calendar`, immutable for the same reason
// `Weekend` is.
export class Calendar {
  readonly weekend: Weekend
  readonly holidays: []Date
}

// Saturday and Sunday off: Europe, the Americas, and the UAE since 2022.
// The common case, NOT a default anything reads implicitly (file header).
export fn weekendSatSun(): Weekend {
  return Weekend{ days: []int{ 6, 7 } }
}

// Friday and Saturday off: Saudi Arabia, Egypt, and much of the region.
export fn weekendFriSat(): Weekend {
  return Weekend{ days: []int{ 5, 6 } }
}

// A weekend on exactly `days`, each 1 Monday .. 7 Sunday — anything the
// two named constructors do not cover, including a six-day week and, with
// an empty slice, a seven-day one.
//
// Fails on a number outside 1..7, and on a set covering all seven days:
// with no weekday left, `nextBusinessDay` would step for ten years and
// panic, so the empty week is rejected at construction where the caller can
// still do something about it. Repeats are accepted and mean nothing extra.
export fn weekendOn(days: []int): Weekend! {
  let seen = []int(8)
  let distinct = 0
  let i = 0
  while (i < len(days)) {
    let day = days[i]
    if (day < 1 || day > 7) {
      fail newError("weekendOn: day ${day} out of range, want 1..7")
    }
    if (seen[day] == 0) {
      seen[day] = 1
      distinct = distinct + 1
    }
    i = i + 1
  }
  if (distinct == 7) {
    fail newError("weekendOn: all seven days are weekend days, no business day would exist")
  }
  return Weekend{ days: businessCopyDays(days) }
}

// A business calendar: `w`'s weekend, plus `holidays` as the set of dates
// that are not worked whichever day of the week they fall on. This module
// ships no holiday list for any country (file header).
export fn calendar(w: Weekend, holidays: []Date): Calendar {
  return Calendar{ weekend: w, holidays: businessCopyHolidays(holidays) }
}

// `src`, copied. The two constructors above own their slices rather than
// aliasing the caller's: `readonly` stops the FIELD being reassigned, not
// the elements behind it, and a `Weekend` that changed under a caller's
// later `days[0] = 1` would not be immutable.
fn businessCopyDays(src: []int): []int {
  let out = []int(0, len(src))
  let i = 0
  while (i < len(src)) {
    out = append(out, src[i])
    i = i + 1
  }
  return out
}

// `src`, copied — `businessCopyDays` for the holiday set.
fn businessCopyHolidays(src: []Date): []Date {
  let out = []Date(0, len(src))
  let i = 0
  while (i < len(src)) {
    out = append(out, src[i])
    i = i + 1
  }
  return out
}

// True when `day` (1 Monday .. 7 Sunday) is one of `w`'s days off. A linear
// scan over at most six entries; a `Weekend` covering all seven cannot be
// built (`weekendOn`).
fn businessWeekendHas(w: Weekend, day: int): bool {
  let i = 0
  while (i < len(w.days)) {
    if (w.days[i] == day) {
      return true
    }
    i = i + 1
  }
  return false
}

// True when `d` is one of `c`'s holidays. Compared on the day count rather
// than field-by-field so the answer cannot depend on how the caller's
// `Date` was built.
fn businessIsHoliday(c: Calendar, d: Date): bool {
  let key = civilDaysFromCivil(d.year(), d.month(), d.day())
  let i = 0
  while (i < len(c.holidays)) {
    let h = c.holidays[i]
    if (civilDaysFromCivil(h.year(), h.month(), h.day()) == key) {
      return true
    }
    i = i + 1
  }
  return false
}

// True when `d` is neither a weekend day nor a holiday — the definition
// every method in this file is written against. A holiday that falls on a
// weekend day is simply already not a business day; it is not carried to
// the following Monday, because whether a country observes a holiday in
// lieu is a policy the caller expresses by putting the observed date in the
// list.
fn businessIsDay(c: Calendar, d: Date): bool {
  return !businessWeekendHas(c.weekend, d.dayOfWeek()) && !businessIsHoliday(c, d)
}

// The first business day strictly `delta` days at a time from `d`, where
// `delta` is 1 for the next one and -1 for the previous. `d` itself is
// never the answer, so this is the whole of `nextBusinessDay` and
// `previousBusinessDay` and one step of `addBusinessDays`.
//
// Panics when `businessMaxStep` days pass with no business day among them
// (file header): a ten-year holiday run is a caller error, and these
// methods do not fail.
fn businessStep(c: Calendar, d: Date, delta: int): Date {
  let cur = d
  let found = false
  let i = 0
  while (i < businessMaxStep && !found) {
    cur = cur.addDays(delta)
    found = businessIsDay(c, cur)
    i = i + 1
  }
  if (!found) {
    panic("addBusinessDays: no business day within ${businessMaxStep} days of ${d.toString()}, " +
      "calendar weekend [${businessWeekendLabel(c.weekend)}] with ${len(c.holidays)} holidays")
  }
  return cur
}

// `c`'s weekend day numbers as "6,7", for the panic message above — the one
// place a `Calendar` has to name itself.
fn businessWeekendLabel(w: Weekend): string {
  let out = ""
  let i = 0
  while (i < len(w.days)) {
    if (i > 0) {
      out = out + ","
    }
    out = out + "${w.days[i]}"
    i = i + 1
  }
  return out
}

// `d` moved `n` business days, forward when `n` is positive and back when
// it is negative.
//
// `n == 0` returns `d` UNCHANGED, even when `d` is itself a weekend day or
// a holiday: zero business days of movement is no movement, and rounding
// the receiver forward here would make `addBusinessDays(c, 0)` and
// `nextBusinessDay(c)` the same call on a Saturday.
fn businessAdd(c: Calendar, d: Date, n: int): Date {
  let delta = 1
  let remaining = n
  if (n < 0) {
    delta = -1
    remaining = -n
  }
  let cur = d
  let i = 0
  while (i < remaining) {
    cur = businessStep(c, cur, delta)
    i = i + 1
  }
  return cur
}

// Business days in the half-open span `(earlier, earlier + days]` — the
// counting half of `businessDifference`, always walked forward so the
// answer cannot depend on which end the walk started from. `days` is a
// non-negative calendar-day count, so the loop is bounded by it.
fn businessCountAfter(c: Calendar, earlier: Date, days: int): int {
  let count = 0
  let cur = earlier
  let i = 0
  while (i < days) {
    cur = cur.addDays(1)
    if (businessIsDay(c, cur)) {
      count = count + 1
    }
    i = i + 1
  }
  return count
}

// Complete business days from `start` to `target`: the business days in the
// span EXCLUDING the earlier of the two dates and INCLUDING the later one,
// negative when `target` is the earlier date.
//
// Excluding the EARLIER end rather than the RECEIVER is what makes this
// exactly antisymmetric — `a.differenceInBusinessDays(c, b)` is always
// `-b.differenceInBusinessDays(c, a)`, the promise the rest of the
// difference family makes (docs/stdlib/time.md, "Differences") — because
// both directions count the same set of days and only the sign changes.
//
// It is also `addBusinessDays`' inverse going forward from any date,
// weekend days included: `start.addBusinessDays(c, k)` for `k >= 0` is `k`
// business days away by this count. Going BACKWARD from a date that is not
// itself a business day the two differ by one, and they must: no half-open
// span can both be antisymmetric and count a non-business receiver as a
// step, so the antisymmetry is kept and the difference is documented.
fn businessDifference(c: Calendar, start: Date, target: Date): int {
  let span = start.differenceInDays(target)
  if (span < 0) {
    return -businessCountAfter(c, target, -span)
  }
  return businessCountAfter(c, start, span)
}

// --- Date --------------------------------------------------------------------

trait DateBusiness {
  // True when this day is one of `w`'s days off.
  isWeekend(w: Weekend): bool {
    return businessWeekendHas(w, this.dayOfWeek())
  }

  // True when this day is not one of `w`'s days off. Exactly `!isWeekend(w)`:
  // holidays play no part, a holiday is still a weekday.
  isWeekday(w: Weekend): bool {
    return !businessWeekendHas(w, this.dayOfWeek())
  }

  // True when this day is neither a weekend day nor one of `c`'s holidays.
  isBusinessDay(c: Calendar): bool {
    return businessIsDay(c, Date{ y: this.y, m: this.m, d: this.d })
  }

  // The next business day STRICTLY after this one.
  nextBusinessDay(c: Calendar): Date {
    return businessStep(c, Date{ y: this.y, m: this.m, d: this.d }, 1)
  }

  // The last business day STRICTLY before this one.
  previousBusinessDay(c: Calendar): Date {
    return businessStep(c, Date{ y: this.y, m: this.m, d: this.d }, -1)
  }

  // This day moved `n` business days; `n` may be negative, and `n == 0`
  // returns this day unchanged even when it is not itself a business day.
  addBusinessDays(c: Calendar, n: int): Date {
    return businessAdd(c, Date{ y: this.y, m: this.m, d: this.d }, n)
  }

  // Complete business days from this day to `other`, excluding the earlier
  // of the two and including the later, negative when `other` is earlier.
  differenceInBusinessDays(c: Calendar, other: Date): int {
    return businessDifference(c, Date{ y: this.y, m: this.m, d: this.d }, other)
  }
}

// --- NaiveDateTime -----------------------------------------------------------

trait NaiveDateTimeBusiness {
  // True when this wall clock's DATE is one of `w`'s days off. The time of
  // day carries no information here (file header).
  isWeekend(w: Weekend): bool {
    return businessWeekendHas(w, this.dt.dayOfWeek())
  }

  // True when this wall clock's date is not one of `w`'s days off.
  isWeekday(w: Weekend): bool {
    return !businessWeekendHas(w, this.dt.dayOfWeek())
  }

  // True when this wall clock's date is neither a weekend day nor one of
  // `c`'s holidays.
  isBusinessDay(c: Calendar): bool {
    return businessIsDay(c, this.dt)
  }

  // The next business day strictly after this wall clock's date, as a
  // `Date`: the time of day is not carried, because a business day is a
  // calendar day.
  nextBusinessDay(c: Calendar): Date {
    return businessStep(c, this.dt, 1)
  }

  // The last business day strictly before this wall clock's date.
  previousBusinessDay(c: Calendar): Date {
    return businessStep(c, this.dt, -1)
  }

  // This wall clock's date moved `n` business days, as a `Date`.
  addBusinessDays(c: Calendar, n: int): Date {
    return businessAdd(c, this.dt, n)
  }

  // Complete business days from this wall clock's date to `other`.
  differenceInBusinessDays(c: Calendar, other: Date): int {
    return businessDifference(c, this.dt, other)
  }
}

// --- DateTime ----------------------------------------------------------------

trait DateTimeBusiness {
  // True when this zoned value's WALL-CLOCK date is one of `w`'s days off.
  // Read from the wall clock, not from the instant, so it answers in the
  // caller's zone rather than in UTC.
  isWeekend(w: Weekend): bool {
    return businessWeekendHas(w, this.wall.date().dayOfWeek())
  }

  // True when this zoned value's wall-clock date is not one of `w`'s days
  // off.
  isWeekday(w: Weekend): bool {
    return !businessWeekendHas(w, this.wall.date().dayOfWeek())
  }

  // True when this zoned value's wall-clock date is neither a weekend day
  // nor one of `c`'s holidays. Unaffected by a daylight saving transition
  // on that date: the calendar day is the same whether it ran 23, 24 or 25
  // hours.
  isBusinessDay(c: Calendar): bool {
    return businessIsDay(c, this.wall.date())
  }

  // The next business day strictly after this zoned value's wall-clock
  // date, as a `Date` — no zone and no offset, so nothing has to be
  // resolved against a transition.
  nextBusinessDay(c: Calendar): Date {
    return businessStep(c, this.wall.date(), 1)
  }

  // The last business day strictly before this zoned value's wall-clock
  // date.
  previousBusinessDay(c: Calendar): Date {
    return businessStep(c, this.wall.date(), -1)
  }

  // This zoned value's wall-clock date moved `n` business days, as a
  // `Date`.
  addBusinessDays(c: Calendar, n: int): Date {
    return businessAdd(c, this.wall.date(), n)
  }

  // Complete business days from this zoned value's wall-clock date to
  // `other`.
  differenceInBusinessDays(c: Calendar, other: Date): int {
    return businessDifference(c, this.wall.date(), other)
  }
}
