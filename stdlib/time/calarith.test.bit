// stdlib/time/calarith.test.bit — calendar arithmetic (#4076). Same module
// as ./calarith.bit, ./date.bit, ./timeofday.bit, ./naive.bit, ./zoned.bit
// and ./time.bit (SPEC §19): no import needed to reach `date`/`time`/`zone`/
// `Date`/`Time`/`NaiveDateTime`/`DateTime`/`Timestamp`.
//
// Two groups of cases, deliberately kept apart:
//
//   BOUNDARY  -- a case where the target month is shorter than the source
//                day, so clamping and normalising disagree. These are the
//                only cases that can tell the two implementations apart.
//   ORDINARY  -- a case where every month involved has enough days, so
//                clamping and normalising agree. These exist to prove the
//                arithmetic isn't broken in some OTHER way while a
//                normalising bug hides behind them.
//
// A boundary case failing under a normalise-instead-of-clamp mutation and an
// ordinary case still passing under the same mutation is what proves this
// suite actually tests the clamp rule, not just "some plausible date came
// out" (docs/stdlib/time.md, "Month arithmetic clamps").

// --- Date: boundary (clamp) cases -------------------------------------------

test "Date.addMonths clamps forward into a shorter month" {
  let d = date(2026, 1, 31) catch e {
    assert(false, "date(2026,1,31) failed: ${e.message()}")
    return
  }
  assert(
    d.addMonths(1).toString() == "2026-02-28",
    "addMonths(1) = ${d.addMonths(1).toString()}, want 2026-02-28",
  )
}

test "Date.addMonths clamps forward into a shorter month, leap year" {
  let d = date(2024, 1, 31) catch e {
    assert(false, "date(2024,1,31) failed: ${e.message()}")
    return
  }
  assert(
    d.addMonths(1).toString() == "2024-02-29",
    "addMonths(1) = ${d.addMonths(1).toString()}, want 2024-02-29",
  )
}

test "Date.addMonths clamps backward into a shorter month" {
  let d = date(2026, 3, 31) catch e {
    assert(false, "date(2026,3,31) failed: ${e.message()}")
    return
  }
  assert(
    d.addMonths(-1).toString() == "2026-02-28",
    "addMonths(-1) = ${d.addMonths(-1).toString()}, want 2026-02-28",
  )
}

test "Date.addYears clamps across a leap day" {
  let d = date(2024, 2, 29) catch e {
    assert(false, "date(2024,2,29) failed: ${e.message()}")
    return
  }
  assert(
    d.addYears(1).toString() == "2025-02-28",
    "addYears(1) = ${d.addYears(1).toString()}, want 2025-02-28",
  )
}

test "Date.withMonth clamps the day to the target month" {
  let d = date(2026, 1, 31) catch e {
    assert(false, "date(2026,1,31) failed: ${e.message()}")
    return
  }
  assert(
    d.withMonth(2).toString() == "2026-02-28",
    "withMonth(2) = ${d.withMonth(2).toString()}, want 2026-02-28",
  )
}

test "Date.withYear clamps the day when landing on a non-leap February" {
  let d = date(2024, 2, 29) catch e {
    assert(false, "date(2024,2,29) failed: ${e.message()}")
    return
  }
  assert(
    d.withYear(2025).toString() == "2025-02-28",
    "withYear(2025) = ${d.withYear(2025).toString()}, want 2025-02-28",
  )
}

test "Date.addMonths clamping is not reversible" {
  let d = date(2026, 1, 31) catch e {
    assert(false, "date(2026,1,31) failed: ${e.message()}")
    return
  }
  let there = d.addMonths(1)
  let back = there.addMonths(-1)
  assert(
    back.toString() == "2026-01-28",
    "addMonths(1).addMonths(-1) = ${back.toString()}, want 2026-01-28 (not 2026-01-31)",
  )
}

// --- Date: ordinary cases, including negative n -----------------------------

test "Date.addMonths and addYears accept negative n on an ordinary date" {
  let d = date(2026, 6, 15) catch e {
    assert(false, "date(2026,6,15) failed: ${e.message()}")
    return
  }
  assert(
    d.addMonths(-3).toString() == "2026-03-15",
    "addMonths(-3) = ${d.addMonths(-3).toString()}, want 2026-03-15",
  )
  assert(
    d.addYears(-2).toString() == "2024-06-15",
    "addYears(-2) = ${d.addYears(-2).toString()}, want 2024-06-15",
  )
}

test "Date.addWeeks and addDays accept negative n" {
  let d = date(2026, 3, 1) catch e {
    assert(false, "date(2026,3,1) failed: ${e.message()}")
    return
  }
  assert(d.addWeeks(-1).toString() == "2026-02-22", "addWeeks(-1) = ${d.addWeeks(-1).toString()}, want 2026-02-22")
  assert(d.addDays(-1).toString() == "2026-02-28", "addDays(-1) = ${d.addDays(-1).toString()}, want 2026-02-28")
}

test "Date.withDay replaces the day of month directly" {
  let d = date(2026, 6, 15) catch e {
    assert(false, "date(2026,6,15) failed: ${e.message()}")
    return
  }
  assert(d.withDay(1).toString() == "2026-06-01", "withDay(1) = ${d.withDay(1).toString()}, want 2026-06-01")
}

// --- Time: wraps within the day, never carries ------------------------------

test "Time.addMinutes wraps forward within the day" {
  let t = time(23, 30, 0) catch e {
    assert(false, "time(23,30,0) failed: ${e.message()}")
    return
  }
  assert(t.addMinutes(60).toString() == "00:30:00", "addMinutes(60) = ${t.addMinutes(60).toString()}, want 00:30:00")
}

test "Time.addMinutes wraps backward within the day, negative n" {
  let t = time(0, 10, 0) catch e {
    assert(false, "time(0,10,0) failed: ${e.message()}")
    return
  }
  assert(t.addMinutes(-20).toString() == "23:50:00", "addMinutes(-20) = ${t.addMinutes(-20).toString()}, want 23:50:00")
}

test "Time.addHours, addSeconds and addNanoseconds all wrap the same way" {
  let t = time(23, 0, 0) catch e {
    assert(false, "time(23,0,0) failed: ${e.message()}")
    return
  }
  assert(t.addHours(2).toString() == "01:00:00", "addHours(2) = ${t.addHours(2).toString()}, want 01:00:00")
  assert(t.addHours(-24).toString() == "23:00:00", "addHours(-24) = ${t.addHours(-24).toString()}, want 23:00:00")

  let t2 = timeNs(0, 0, 0, 0) catch e {
    assert(false, "timeNs failed: ${e.message()}")
    return
  }
  assert(t2.addSeconds(-1).toString() == "23:59:59", "addSeconds(-1) = ${t2.addSeconds(-1).toString()}, want 23:59:59")
  assert(
    t2.addNanoseconds(-1).toString() == "23:59:59.999999999",
    "addNanoseconds(-1) = ${t2.addNanoseconds(-1).toString()}, want 23:59:59.999999999",
  )
}

test "Time.withHour/withMinute/withSecond/withNanosecond replace only the named field" {
  let t = timeNs(9, 30, 15, 500) catch e {
    assert(false, "timeNs failed: ${e.message()}")
    return
  }
  assert(t.withHour(10).toString() == "10:30:15.000000500", "withHour(10) = ${t.withHour(10).toString()}")
  assert(t.withMinute(0).toString() == "09:00:15.000000500", "withMinute(0) = ${t.withMinute(0).toString()}")
  assert(t.withSecond(0).toString() == "09:30:00.000000500", "withSecond(0) = ${t.withSecond(0).toString()}")
  assert(t.withNanosecond(0).toString() == "09:30:15", "withNanosecond(0) = ${t.withNanosecond(0).toString()}")
}

// --- NaiveDateTime: same clamp as Date, but time-of-day arithmetic carries --

test "NaiveDateTime.addMonths clamps exactly like Date, time of day unchanged" {
  let d = date(2026, 1, 31) catch e {
    assert(false, "date(2026,1,31) failed: ${e.message()}")
    return
  }
  let ndt = d.atTime(9, 30, 0) catch e {
    assert(false, "atTime failed: ${e.message()}")
    return
  }
  assert(
    ndt.addMonths(1).toString() == "2026-02-28T09:30:00",
    "addMonths(1) = ${ndt.addMonths(1).toString()}, want 2026-02-28T09:30:00",
  )
}

test "NaiveDateTime.addMinutes carries into the date forward, unlike Time itself" {
  let d = date(2026, 1, 31) catch e {
    assert(false, "date(2026,1,31) failed: ${e.message()}")
    return
  }
  let ndt = d.atTime(23, 30, 0) catch e {
    assert(false, "atTime failed: ${e.message()}")
    return
  }
  assert(
    ndt.addMinutes(60).toString() == "2026-02-01T00:30:00",
    "addMinutes(60) = ${ndt.addMinutes(60).toString()}, want 2026-02-01T00:30:00 (date carried)",
  )
}

test "NaiveDateTime.addMinutes carries into the date backward, negative n" {
  let d = date(2026, 2, 1) catch e {
    assert(false, "date(2026,2,1) failed: ${e.message()}")
    return
  }
  let ndt = d.atTime(0, 10, 0) catch e {
    assert(false, "atTime failed: ${e.message()}")
    return
  }
  assert(
    ndt.addMinutes(-20).toString() == "2026-01-31T23:50:00",
    "addMinutes(-20) = ${ndt.addMinutes(-20).toString()}, want 2026-01-31T23:50:00",
  )
}

test "NaiveDateTime.withTime sets hour/minute/second, keeps date and nanosecond" {
  let d = date(2026, 9, 1) catch e {
    assert(false, "date(2026,9,1) failed: ${e.message()}")
    return
  }
  let ndt = d.atTime(9, 0, 0) catch e {
    assert(false, "atTime failed: ${e.message()}")
    return
  }
  assert(
    ndt.withTime(14, 45, 30).toString() == "2026-09-01T14:45:30",
    "withTime(14,45,30) = ${ndt.withTime(14, 45, 30).toString()}",
  )
}

// --- DateTime: wall clock preserved, offset re-resolved through the zone ---

test "DateTime.addDays preserves the wall clock across the autumn transition" {
  let london = zone("Europe/London") catch e {
    assert(false, "zone(Europe/London) failed: ${e.message()}")
    return
  }
  let d = date(2026, 10, 24) catch e {
    assert(false, "date(2026,10,24) failed: ${e.message()}")
    return
  }
  let naive = d.atTime(9, 0, 0) catch e {
    assert(false, "atTime failed: ${e.message()}")
    return
  }
  let before = naive.inZone(london)
  let after = before.addDays(1)
  assert(after.hour() == 9, "after.hour() = ${after.hour()}, want 9 (wall clock preserved)")

  let beforeTs = before.toTimestamp() catch e {
    assert(false, "toTimestamp failed: ${e.message()}")
    return
  }
  let afterTs = after.toTimestamp() catch e {
    assert(false, "toTimestamp failed: ${e.message()}")
    return
  }
  assert(
    afterTs.ns - beforeTs.ns == 90000000000000,
    "elapsed = ${afterTs.ns - beforeTs.ns}, want 90000000000000 (25 real hours)",
  )
}

test "DateTime.addDays preserves the wall clock across the spring gap" {
  let london = zone("Europe/London") catch e {
    assert(false, "zone(Europe/London) failed: ${e.message()}")
    return
  }
  let d = date(2026, 3, 28) catch e {
    assert(false, "date(2026,3,28) failed: ${e.message()}")
    return
  }
  let naive = d.atTime(9, 0, 0) catch e {
    assert(false, "atTime failed: ${e.message()}")
    return
  }
  let before = naive.inZone(london)
  let after = before.addDays(1)
  assert(after.hour() == 9, "after.hour() = ${after.hour()}, want 9 (wall clock preserved)")

  let beforeTs = before.toTimestamp() catch e {
    assert(false, "toTimestamp failed: ${e.message()}")
    return
  }
  let afterTs = after.toTimestamp() catch e {
    assert(false, "toTimestamp failed: ${e.message()}")
    return
  }
  assert(
    afterTs.ns - beforeTs.ns == 82800000000000,
    "elapsed = ${afterTs.ns - beforeTs.ns}, want 82800000000000 (23 real hours)",
  )
}

test "DateTime.addHours(24) matches addDays(1)'s wall clock, not a raw 24h instant shift" {
  let london = zone("Europe/London") catch e {
    assert(false, "zone(Europe/London) failed: ${e.message()}")
    return
  }
  let d = date(2026, 10, 24) catch e {
    assert(false, "date(2026,10,24) failed: ${e.message()}")
    return
  }
  let naive = d.atTime(9, 0, 0) catch e {
    assert(false, "atTime failed: ${e.message()}")
    return
  }
  let before = naive.inZone(london)
  let afterHours = before.addHours(24)
  let afterDays = before.addDays(1)
  assert(
    afterHours.toString() == afterDays.toString(),
    "addHours(24) = ${afterHours.toString()}, addDays(1) = ${afterDays.toString()}, want equal",
  )
}

test "DateTime.withMonth re-resolves the offset through the zone" {
  let london = zone("Europe/London") catch e {
    assert(false, "zone(Europe/London) failed: ${e.message()}")
    return
  }
  let d = date(2026, 1, 15) catch e {
    assert(false, "date(2026,1,15) failed: ${e.message()}")
    return
  }
  let naive = d.atTime(9, 0, 0) catch e {
    assert(false, "atTime failed: ${e.message()}")
    return
  }
  let jan = naive.inZone(london)
  assert(jan.offset() == 0, "January offset = ${jan.offset()}, want 0 (GMT)")

  let july = jan.withMonth(7)
  assert(july.hour() == 9, "July hour = ${july.hour()}, want 9 (wall clock kept)")
  assert(july.offset() == 3600, "July offset = ${july.offset()}, want 3600 (BST)")
}

test "DateTime.addMonths clamps like Date and preserves the wall clock" {
  let london = zone("Europe/London") catch e {
    assert(false, "zone(Europe/London) failed: ${e.message()}")
    return
  }
  let d = date(2026, 1, 31) catch e {
    assert(false, "date(2026,1,31) failed: ${e.message()}")
    return
  }
  let naive = d.atTime(9, 0, 0) catch e {
    assert(false, "atTime failed: ${e.message()}")
    return
  }
  let dt = naive.inZone(london)
  assert(
    dt.addMonths(1).toString() == "2026-02-28T09:00:00+00:00",
    "addMonths(1) = ${dt.addMonths(1).toString()}, want 2026-02-28T09:00:00+00:00",
  )
}

// --- Timestamp: the one method that DOES add real elapsed time -------------

test "Timestamp.add shifts the instant by real nanoseconds, positive and negative" {
  let ts = Timestamp{ ns: 1000000000 }
  assert(ts.add(500).ns == 1000000500, "add(500).ns = ${ts.add(500).ns}, want 1000000500")
  assert(ts.add(-1000000000).ns == 0, "add(-1000000000).ns = ${ts.add(-1000000000).ns}, want 0")
}
