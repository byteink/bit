// stdlib/time/zone.test.bit — the two module-internal offset lookups
// behind the public Zone surface (#4071). Same module as ./zone.bit
// (SPEC §19): no import needed to reach `zoneOffsetAt`/`zoneOffsetForWall`,
// which are deliberately unexported (constraint: "Do not export
// zoneOffsetAt or zoneOffsetForWall").
//
// A `_tests_/cases` fixture cannot reach either — proved the same way
// #4070's `zoneif.test.bit` proved it for `tzifParse`: a `_tests_/cases`
// program is a separate module, and `import { zoneOffsetAt } from
// "std/time"` fails `E0046 'zoneOffsetAt' is not exported by this module`.
// This file is the sanctioned in-module route, same shape as
// `./zoneif.test.bit` and `stdlib/hash/crc32.test.bit` (#4015). The public
// surface (`zone`/`utc`/`localZone`) is covered separately by
// `_tests_/cases/run_time_zone.bit`.
//
// Real transitions used below, cross-checked against this host's own
// `zdump -v` (never derived from this module's own output):
//   Asia/Dubai   one real transition, 1919-12-31T20:18:48Z, LMT(+13272)
//                -> +04(14400) forever after — every instant used below is
//                long after it, so the offset is 14400 throughout.
//   Europe/London 2026 spring-forward: transition at 2026-03-29T01:00:00Z
//                (1774746000), GMT(0) -> BST(3600); the wall range
//                [01:00, 02:00) local never happens.
//                2026 fall-back: transition at 2026-10-25T01:00:00Z
//                (1792890000), BST(3600) -> GMT(0); the wall range
//                [01:00, 02:00) local happens twice.

test "zoneOffsetAt: Asia/Dubai is 14400 at any modern instant" {
  let z = zone("Asia/Dubai") catch e {
    assert(false, "zone(Asia/Dubai) failed: ${e.message()}")
    return
  }
  assert(zoneOffsetAt(z, 0) == 14400, "at epoch 0: ${zoneOffsetAt(z, 0)}, want 14400")
  assert(
    zoneOffsetAt(z, 1700000000) == 14400,
    "at 1700000000: ${zoneOffsetAt(z, 1700000000)}, want 14400",
  )
  assert(
    zoneOffsetAt(z, 4102444800) == 14400,
    "at 2100-01-01: ${zoneOffsetAt(z, 4102444800)}, want 14400",
  )
}

test "zoneOffsetAt: Europe/London is 3600 in July 2026 and 0 in January 2026" {
  let z = zone("Europe/London") catch e {
    assert(false, "zone(Europe/London) failed: ${e.message()}")
    return
  }
  // 2026-07-01T12:00:00Z, mid-BST.
  let july = zoneOffsetAt(z, 1782907200)
  assert(july == 3600, "July 2026 offset = ${july}, want 3600")
  // 2026-01-01T12:00:00Z, mid-GMT.
  let january = zoneOffsetAt(z, 1767268800)
  assert(january == 0, "January 2026 offset = ${january}, want 0")
}

test "zoneOffsetForWall: London spring gap pushes forward to the post-transition offset" {
  let z = zone("Europe/London") catch e {
    assert(false, "zone(Europe/London) failed: ${e.message()}")
    return
  }
  // 2026-03-29T01:30:00, naive (never happens: GMT->BST at 01:00:00Z).
  let offset = zoneOffsetForWall(z, 1774747800)
  assert(offset == 3600, "spring gap 01:30 offset = ${offset}, want 3600")
}

test "zoneOffsetForWall: London autumn overlap takes the earlier (first) offset" {
  let z = zone("Europe/London") catch e {
    assert(false, "zone(Europe/London) failed: ${e.message()}")
    return
  }
  // 2026-10-25T01:30:00, naive (happens twice: BST->GMT at 01:00:00Z).
  let offset = zoneOffsetForWall(z, 1792891800)
  assert(offset == 3600, "autumn overlap 01:30 offset = ${offset}, want 3600 (the earlier one)")
}

test "zoneOffsetForWall and zoneOffsetAt agree away from any transition" {
  let z = zone("Europe/London") catch e {
    assert(false, "zone(Europe/London) failed: ${e.message()}")
    return
  }
  // 2026-01-01T12:00:00, naive, far from any transition: both lookups must
  // return the same GMT offset.
  let wall = zoneOffsetForWall(z, 1767268800)
  let instant = zoneOffsetAt(z, 1767268800)
  assert(wall == instant, "wall=${wall} instant=${instant}, want equal away from a transition")
  assert(wall == 0, "wall offset = ${wall}, want 0")
}

test "zoneOffsetAt: at the exact transition instant, the NEW offset already applies" {
  let z = zone("Europe/London") catch e {
    assert(false, "zone(Europe/London) failed: ${e.message()}")
    return
  }
  // 2026-03-29T01:00:00Z is the spring transition itself: "the last
  // transition AT OR BEFORE" the instant means this instant already sees
  // the new BST offset, not the outgoing GMT one.
  let atTransition = zoneOffsetAt(z, 1774746000)
  assert(atTransition == 3600, "at the transition instant: ${atTransition}, want 3600")
  let justBefore = zoneOffsetAt(z, 1774745999)
  assert(justBefore == 0, "one second before the transition: ${justBefore}, want 0")
}

test "utc() has no transitions and offset 0 everywhere" {
  let z = utc()
  assert(zoneOffsetAt(z, 0) == 0, "utc offset at 0 = ${zoneOffsetAt(z, 0)}, want 0")
  assert(
    zoneOffsetAt(z, 1782907200) == 0,
    "utc offset at 1782907200 = ${zoneOffsetAt(z, 1782907200)}, want 0",
  )
  assert(
    zoneOffsetForWall(z, 1774747800) == 0,
    "utc wall offset = ${zoneOffsetForWall(z, 1774747800)}, want 0",
  )
}
