// stdlib/time/rfc3339.test.bit — `parseRfc3339` and `parseEpochSeconds`
// (./rfc3339.bit, #6574). Same module as ./rfc3339.bit (SPEC §19): no import
// is needed to reach `Timestamp`, `TimestampParseError` or
// `TimestampParseCause`.
//
// Every expected instant is an input, never an output of this module. The
// RFC 3339 section 5.8 examples are the RFC's own text; the instants behind
// them, and every other epoch value below, were computed with Python's
// `calendar.timegm`:
//   1985-04-12T23:20:50.52Z          482196050.52   (RFC 3339 5.8)
//   1996-12-19T16:39:57-08:00        851042397      (RFC 3339 5.8)
//   1990-12-31T23:59:60Z             662688000      (RFC 3339 5.8, = 1991-01-01T00:00:00Z)
//   1990-12-31T15:59:60-08:00        662688000      (RFC 3339 5.8)
//   1937-01-01T12:00:27.87+00:20     -1041337172.13 (RFC 3339 5.8)
//   2024-01-02T03:04:05Z             1704164645
//   2024-01-02T03:04:05+05:30        1704144845
//   2024-01-02T03:04:05-23:59        1704250985
//   2016-12-31T23:59:60Z             1483228800     (leap second, = 2017-01-01T00:00:00Z)
//   2012-06-30T23:59:60Z             1341100800
//   2024-02-29T00:00:00Z             1709164800
//   2000-02-29T12:00:00-14:00        951876000
//   2262-04-11T23:47:16Z             9223372036     (last whole second a Timestamp holds)
//   1677-09-21T00:12:44Z             -9223372036
// i64 max and min nanoseconds are 9223372036854775807 and
// -9223372036854775808, so the exact range ends are 9223372036.854775807 and
// -9223372036.854775808 seconds.

const rtNs: int = 1000000000

// The expected text for an instant of `secs` whole seconds and `nanos` after
// them (floored, `nanos` in 0..999999999).
fn rtNsOf(secs: int, nanos: int): string {
  return "${secs * rtNs + nanos}"
}

fn rtCause(e: error): string {
  let pe = e.(TimestampParseError)
  match (pe.cause) {
    Syntax => return "ERR:Syntax"
    Range => return "ERR:Range"
  }
}

// The nanoseconds `parseRfc3339(s)` returns as text, or the failure's cause
// name prefixed `ERR:`. A success cannot start with `ERR:`, so an expected
// failure cannot pass on a success.
fn rtRfc(s: string): string {
  let t = parseRfc3339(s) catch e {
    return rtCause(e)
  }
  return "${t.ns}"
}

fn rtEpoch(s: string): string {
  let t = parseEpochSeconds(s) catch e {
    return rtCause(e)
  }
  return "${t.ns}"
}

test "RFC 3339 5.8 examples parse to their instants" {
  assert(rtRfc("1985-04-12T23:20:50.52Z") == rtNsOf(482196050, 520000000), "1985 fraction")
  assert(rtRfc("1996-12-19T16:39:57-08:00") == rtNsOf(851042397, 0), "1996 -08:00")
  assert(rtRfc("1990-12-31T23:59:60Z") == rtNsOf(662688000, 0), "1990 leap second")
  assert(rtRfc("1990-12-31T15:59:60-08:00") == rtNsOf(662688000, 0), "1990 leap second with offset")
  assert(rtRfc("1937-01-01T12:00:27.87+00:20") == rtNsOf(-1041337173, 870000000), "1937 +00:20")
}

test "the ticket's four shapes" {
  assert(rtRfc("2024-01-02T03:04:05Z") == rtNsOf(1704164645, 0), "whole seconds")
  assert(rtRfc("2024-01-02T03:04:05.000Z") == rtNsOf(1704164645, 0), "zero fraction")
  assert(rtRfc("2024-01-02T03:04:05.123456789Z") == rtNsOf(1704164645, 123456789), "nine digits")
  assert(rtRfc("2024-01-02T03:04:05+05:30") == rtNsOf(1704144845, 0), "+05:30")
  assert(rtRfc("2024-01-02T03:04:05-23:59") == rtNsOf(1704250985, 0), "-23:59")
}

test "the offset sign moves the instant the right way" {
  let z = rtRfc("2024-01-02T03:04:05Z")
  assert(rtRfc("2024-01-02T08:34:05+05:30") == z, "east of UTC is earlier")
  assert(rtRfc("2024-01-01T21:34:05-05:30") == z, "west of UTC is later")
}

test "T, t, Z and z are interchangeable" {
  let want = rtNsOf(1704164645, 0)
  assert(rtRfc("2024-01-02t03:04:05Z") == want, "lowercase t")
  assert(rtRfc("2024-01-02T03:04:05z") == want, "lowercase z")
  assert(rtRfc("2024-01-02t03:04:05z") == want, "both lowercase")
}

test "-00:00 is accepted as UTC, RFC 3339 4.3 and 5.6" {
  assert(rtRfc("2024-01-02T03:04:05-00:00") == rtNsOf(1704164645, 0), "-00:00")
  assert(rtRfc("2024-01-02T03:04:05+00:00") == rtNsOf(1704164645, 0), "+00:00")
}

test "a fraction of any length is read and truncated past nanoseconds" {
  let base = 1704164645
  assert(rtRfc("2024-01-02T03:04:05.5Z") == rtNsOf(base, 500000000), "one digit")
  assert(rtRfc("2024-01-02T03:04:05.000000001Z") == rtNsOf(base, 1), "one nanosecond")
  assert(rtRfc("2024-01-02T03:04:05.1234567891Z") == rtNsOf(base, 123456789), "ten digits truncate")
  assert(rtRfc("2024-01-02T03:04:05.9999999999Z") == rtNsOf(base, 999999999), "never rounds up")
  assert(
    rtRfc("2024-01-02T03:04:05.123456789123456789123456789123Z") == rtNsOf(base, 123456789),
    "thirty digits",
  )
  assert(
    rtRfc("1969-12-31T23:59:59.9999999999Z") == rtNsOf(-1, 999999999),
    "truncation before 1970 is still floor",
  )
}

test "an instant before 1970 is floored, not truncated toward zero" {
  assert(rtRfc("1969-12-31T23:59:59Z") == rtNsOf(-1, 0), "one second before")
  assert(
    rtRfc("1969-12-31T23:59:59.5Z") == rtNsOf(-1, 500000000),
    "half a second before the epoch second",
  )
  assert(rtRfc("1970-01-01T00:00:00Z") == "0", "epoch")
}

test "leap second: only 23:59:60 UTC at a month end, read as the next second" {
  assert(rtRfc("2016-12-31T23:59:60Z") == rtNsOf(1483228800, 0), "december")
  assert(rtRfc("2012-06-30T23:59:60Z") == rtNsOf(1341100800, 0), "june")
  assert(rtRfc("2017-01-01T00:59:60+01:00") == rtNsOf(1483228800, 0), "offset to UTC month end")
  assert(rtRfc("2016-12-31T23:59:60.5Z") == rtNsOf(1483228800, 500000000), "fraction kept")
  assert(
    rtRfc("2016-12-31T23:59:60Z") == rtRfc("2017-01-01T00:00:00Z"),
    "same instant as the next second",
  )
  assert(rtRfc("2024-01-02T03:04:60Z") == "ERR:Range", "mid-day")
  assert(rtRfc("2016-12-31T23:59:60+01:00") == "ERR:Range", "UTC time is 22:59:60")
  assert(rtRfc("2016-12-30T23:59:60Z") == "ERR:Range", "not a month end")
  assert(rtRfc("2016-12-31T23:58:60Z") == "ERR:Range", "not the last minute")
  assert(rtRfc("2016-12-31T23:59:61Z") == "ERR:Range", "second 61")
}

test "every field is bounded" {
  assert(rtRfc("2024-13-01T00:00:00Z") == "ERR:Range", "month 13")
  assert(rtRfc("2024-00-01T00:00:00Z") == "ERR:Range", "month 0")
  assert(rtRfc("2024-01-00T00:00:00Z") == "ERR:Range", "day 0")
  assert(rtRfc("2024-01-32T00:00:00Z") == "ERR:Range", "day 32")
  assert(rtRfc("2023-02-29T00:00:00Z") == "ERR:Range", "29 February, common year")
  assert(rtRfc("1900-02-29T00:00:00Z") == "ERR:Range", "29 February 1900")
  assert(rtRfc("2024-04-31T00:00:00Z") == "ERR:Range", "31 April")
  assert(rtRfc("2024-02-29T00:00:00Z") == rtNsOf(1709164800, 0), "29 February, leap year")
  assert(rtRfc("2000-02-29T12:00:00-14:00") == rtNsOf(951876000, 0), "29 February 2000 with offset")
  assert(rtRfc("2024-01-02T24:00:00Z") == "ERR:Range", "hour 24")
  assert(rtRfc("2024-01-02T03:60:00Z") == "ERR:Range", "minute 60")
  assert(rtRfc("2024-01-02T03:04:05+25:00") == "ERR:Range", "offset hour 25")
  assert(rtRfc("2024-01-02T03:04:05+24:00") == "ERR:Range", "offset hour 24")
  assert(rtRfc("2024-01-02T03:04:05-24:00") == "ERR:Range", "offset hour -24")
  assert(rtRfc("2024-01-02T03:04:05+00:60") == "ERR:Range", "offset minute 60")
  assert(
    rtRfc("2024-01-02T03:04:05+23:59") == rtNsOf(1704164645 - 23 * 3600 - 59 * 60, 0),
    "offset +23:59",
  )
}

test "an instant a Timestamp cannot hold is Range, never wrapped" {
  assert(rtRfc("2262-04-11T23:47:16Z") == rtNsOf(9223372036, 0), "last second")
  assert(rtRfc("2262-04-11T23:47:16.854775807Z") == "9223372036854775807", "i64 max")
  assert(rtRfc("2262-04-11T23:47:16.854775808Z") == "ERR:Range", "one past i64 max")
  assert(rtRfc("2262-04-11T23:47:17Z") == "ERR:Range", "next second")
  assert(
    rtRfc("1677-09-21T00:12:44Z") == rtNsOf(-9223372036, 0),
    "first whole second of the 1677 side",
  )
  assert(rtRfc("1677-09-21T00:12:43.145224192Z") == "-9223372036854775808", "i64 min")
  assert(rtRfc("1677-09-21T00:12:43.145224191Z") == "ERR:Range", "one before i64 min")
  assert(rtRfc("9999-12-31T23:59:59Z") == "ERR:Range", "year 9999")
  assert(rtRfc("0000-01-01T00:00:00Z") == "ERR:Range", "year 0")
  assert(rtRfc("1500-01-01T00:00:00Z") == "ERR:Range", "year 1500")
  assert(rtRfc("2262-04-11T23:47:16-23:59") == "ERR:Range", "offset pushes past the end")
}

test "text that is not the RFC 3339 grammar is Syntax" {
  assert(rtRfc("") == "ERR:Syntax", "empty")
  assert(rtRfc("2024-01-02") == "ERR:Syntax", "date only")
  assert(rtRfc("2024-01-02T03:04:05") == "ERR:Syntax", "no zone")
  assert(rtRfc("2024-01-02T03:04:05.5") == "ERR:Syntax", "fraction, no zone")
  assert(rtRfc("2024-01-02 03:04:05Z") == "ERR:Syntax", "space for T")
  assert(rtRfc("2024-01-02T03:04Z") == "ERR:Syntax", "no seconds")
  assert(rtRfc("2024-01-02T03:04:05.Z") == "ERR:Syntax", "dot without digits")
  assert(rtRfc("2024-01-02T03:04:05,5Z") == "ERR:Syntax", "comma fraction")
  assert(rtRfc("2024-01-02T03:04:05+0530") == "ERR:Syntax", "offset without colon")
  assert(rtRfc("2024-01-02T03:04:05+05") == "ERR:Syntax", "offset hours only")
  assert(rtRfc("2024-01-02T03:04:05+5:30") == "ERR:Syntax", "one-digit offset hour")
  assert(rtRfc("2024-01-02T03:04:05 +05:30") == "ERR:Syntax", "space before offset")
  assert(rtRfc("2024-01-02T03:04:05ZZ") == "ERR:Syntax", "two Z")
  assert(rtRfc("2024-01-02T03:04:05Z ") == "ERR:Syntax", "trailing space")
  assert(rtRfc(" 2024-01-02T03:04:05Z") == "ERR:Syntax", "leading space")
  assert(rtRfc("2024-01-02T03:04:05Z\n") == "ERR:Syntax", "trailing newline")
  assert(rtRfc("2024-1-02T03:04:05Z") == "ERR:Syntax", "one-digit month")
  assert(rtRfc("24-01-02T03:04:05Z") == "ERR:Syntax", "two-digit year")
  assert(rtRfc("2024/01/02T03:04:05Z") == "ERR:Syntax", "slashes")
  assert(rtRfc("2024-01-02T03.04.05Z") == "ERR:Syntax", "dots in the time")
  assert(rtRfc("2024-01-02T0a:04:05Z") == "ERR:Syntax", "letter in the hour")
  assert(rtRfc("+024-01-02T03:04:05Z") == "ERR:Syntax", "sign in the year")
  assert(rtRfc("2024-01-02T03:04:05+05:3x") == "ERR:Syntax", "letter in the offset")
  assert(rtRfc("2024-01-02T03:04:05.5xZ") == "ERR:Syntax", "letter in the fraction")
}

test "epoch seconds: whole, fractional, negative" {
  assert(rtEpoch("0") == "0", "zero")
  assert(rtEpoch("-0") == "0", "negative zero")
  assert(rtEpoch("0.0") == "0", "0.0")
  assert(rtEpoch("1700000000") == rtNsOf(1700000000, 0), "whole")
  assert(rtEpoch("1700000000.123") == rtNsOf(1700000000, 123000000), "the ticket's example")
  assert(rtEpoch("1700000000.000000001") == rtNsOf(1700000000, 1), "one nanosecond")
  assert(rtEpoch("00000012.5") == rtNsOf(12, 500000000), "leading zeros")
  assert(rtEpoch("0.5") == rtNsOf(0, 500000000), "half")
  assert(rtEpoch("-1") == rtNsOf(-1, 0), "-1")
  assert(rtEpoch("-1.5") == rtNsOf(-2, 500000000), "-1.5")
  assert(rtEpoch("-0.5") == rtNsOf(-1, 500000000), "-0.5")
  assert(rtEpoch("-0.000000001") == "-1", "-1 ns")
  assert(rtEpoch("-1700000000.123") == rtNsOf(-1700000001, 877000000), "negative with fraction")
}

test "epoch seconds: digits past nanoseconds truncate toward the past" {
  assert(rtEpoch("1700000000.1234567891") == rtNsOf(1700000000, 123456789), "ten digits")
  assert(rtEpoch("1700000000.9999999999") == rtNsOf(1700000000, 999999999), "never rounds up")
  assert(rtEpoch("-1.0000000001") == "-1000000001", "negative, one ns further back")
  assert(rtEpoch("-0.0000000001") == "-1", "-1e-10 is one ns before the epoch")
  assert(rtEpoch("-1.0000000000") == rtNsOf(-1, 0), "trailing zeros are exact")
  assert(rtEpoch("-0.9999999999") == rtNsOf(-1, 0), "carry into the whole second")
  assert(rtEpoch("0.0000000001") == "0", "positive tiny")
}

test "epoch seconds: exponent form" {
  assert(rtEpoch("1.7E9") == rtNsOf(1700000000, 0), "1.7E9")
  assert(rtEpoch("1.7e9") == rtNsOf(1700000000, 0), "1.7e9")
  assert(rtEpoch("1.7e+9") == rtNsOf(1700000000, 0), "1.7e+9")
  assert(rtEpoch("1700000000123e-3") == rtNsOf(1700000000, 123000000), "e-3")
  assert(rtEpoch("15e-1") == rtNsOf(1, 500000000), "15e-1")
  assert(rtEpoch("0.001e3") == rtNsOf(1, 0), "0.001e3")
  assert(rtEpoch("-1.5e0") == rtNsOf(-2, 500000000), "-1.5e0")
  assert(rtEpoch("0e99999999999") == "0", "zero with a huge exponent")
  assert(rtEpoch("1e-100000") == "0", "tiny positive")
  assert(rtEpoch("-1e-100000") == "-1", "tiny negative")
  assert(rtEpoch("1e100000000000000000000") == "ERR:Range", "huge exponent")
  assert(rtEpoch("1e-100000000000000000000") == "0", "huge negative exponent")
}

test "epoch seconds: range ends and overflow" {
  assert(rtEpoch("9223372036.854775807") == "9223372036854775807", "i64 max")
  assert(rtEpoch("9223372036.854775808") == "ERR:Range", "one past i64 max")
  assert(rtEpoch("-9223372036.854775808") == "-9223372036854775808", "i64 min")
  assert(rtEpoch("-9223372036.854775809") == "ERR:Range", "one before i64 min")
  assert(
    rtEpoch("-9223372036.8547758081") == "ERR:Range",
    "truncation goes further back, past i64 min",
  )
  assert(rtEpoch("9223372037") == "ERR:Range", "9223372037")
  assert(rtEpoch("-9223372038") == "ERR:Range", "-9223372038")
  assert(rtEpoch("99999999999") == "ERR:Range", "eleven digits")
  assert(rtEpoch("123456789012345678901234567890") == "ERR:Range", "thirty digits")
  assert(rtEpoch("-123456789012345678901234567890.5") == "ERR:Range", "negative thirty digits")
  assert(rtEpoch("18446744073.709551616") == "ERR:Range", "2^64 over 1e9, the wrapped-to-zero trap")
}

test "epoch seconds: anything else is Syntax" {
  assert(rtEpoch("") == "ERR:Syntax", "empty")
  assert(rtEpoch("-") == "ERR:Syntax", "bare minus")
  assert(rtEpoch("+5") == "ERR:Syntax", "plus sign")
  assert(rtEpoch(".5") == "ERR:Syntax", "no integer digits")
  assert(rtEpoch("5.") == "ERR:Syntax", "no fraction digits")
  assert(rtEpoch("1e") == "ERR:Syntax", "empty exponent")
  assert(rtEpoch("1e+") == "ERR:Syntax", "signed empty exponent")
  assert(rtEpoch("1e5.5") == "ERR:Syntax", "fractional exponent")
  assert(rtEpoch("1.2.3") == "ERR:Syntax", "two dots")
  assert(rtEpoch(" 5") == "ERR:Syntax", "leading space")
  assert(rtEpoch("5 ") == "ERR:Syntax", "trailing space")
  assert(rtEpoch("5\n") == "ERR:Syntax", "trailing newline")
  assert(rtEpoch("0x10") == "ERR:Syntax", "hex")
  assert(rtEpoch("NaN") == "ERR:Syntax", "NaN")
  assert(rtEpoch("Infinity") == "ERR:Syntax", "Infinity")
  assert(rtEpoch("--1") == "ERR:Syntax", "two minus signs")
  assert(rtEpoch("1_000") == "ERR:Syntax", "underscore")
}

test "the error carries its input and a message" {
  let bad = "2024-13-01T00:00:00Z"
  let t = parseRfc3339(bad) catch e {
    let pe = e.(TimestampParseError)
    assert(pe.input == bad, "input")
    assert(len(pe.message()) > 0, "message")
    return
  }
  assert(false, "expected a failure, got ${t.ns}")
}
