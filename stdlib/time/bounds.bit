// Bit standard library — time module, period boundaries (#4077).
//
// Every `startOf*`/`endOf*` method in docs/stdlib/time.md's "Boundaries"
// section, for `Date` (./date.bit, #4072), `NaiveDateTime` (./naive.bit,
// #4074) and `DateTime` (./zoned.bit, #4075). What a report's date range is
// built from. None of these methods fails.
//
// Delivered by trait injection (SPEC §10.7), the same mechanism
// ./calarith.bit (#4076) already uses for the `add*`/`with*` family and for
// the same reason: Bit has no extension-method syntax (SPEC §10.4), a method
// exists only inside the body of the class that declares it, and a second
// `export class Date { ... }` in this module is `E0042`. Each trait below is
// `use`d by one added line in its target class's own body, and `this` is
// typed concretely once injected, so the unexported `y`/`m`/`d`, `wall`,
// `dt`/`tm` and `z` fields are reachable here exactly as they are from any
// other file in this module.
//
// Sibling of ./civil.bit, ./date.bit, ./timeofday.bit, ./naive.bit and
// ./zoned.bit, same module (SPEC §17.1): `civilDaysInMonth`, `Date`, `Time`,
// `NaiveDateTime`, `DateTime` and `Zone` are used here unqualified, no
// import, no redeclaration.
//
// Three rules this file exists to hold:
//
//   The week starts on MONDAY, ISO 8601 (docs/stdlib/time.md,
//   "Boundaries"), matching `Date.dayOfWeek`'s own 1 = Monday .. 7 = Sunday
//   numbering. The `*WeekOn(firstDay)` variants take an explicit first day,
//   because many organisations in the Gulf and the United States start the
//   week on Sunday. They are separate names rather than an overload of
//   `startOfWeek`: Bit has no function overloading (SPEC §10.4 for `init`;
//   proved for methods here — a second `f` in a class body replaces the
//   first, and a no-argument call to it is `E0050 expected 1 argument(s),
//   found 0`), so `startOfWeek()` and `startOfWeek(firstDay)` cannot
//   coexist.
//
//   `endOfDay` is the LAST REPRESENTABLE NANOSECOND, 23:59:59.999999999,
//   not the next midnight (docs/stdlib/time.md, "Boundaries"). The doc's own
//   recommendation that a range check prefer a half-open interval is
//   guidance for callers and does not change this method.
//
//   No month length is written down. `endOfMonth`, `endOfQuarter` and
//   `endOfYear` all reach `Date.daysInMonth()` or its own
//   `civilDaysInMonth` (./civil.bit) — 2026-02 is 28 and 2024-02 is 29,
//   derived, never hardcoded.
//
// On a `DateTime` every method sets the WALL CLOCK and re-resolves the zone
// offset through `NaiveDateTime.inZone` (./naive.bit), never by computing an
// instant directly — the same rule ./calarith.bit's `DateTime` arithmetic
// follows, and for a sharper reason here: in a handful of zones midnight
// itself falls inside a spring gap and does not exist, and `inZone` is the
// path that resolves it (docs/stdlib/time.md, "`inZone` pushes forward").
// A day carrying a transition therefore ends at a different offset than it
// starts at — 2026-03-29 in Europe/London starts 00:00:00+00:00 and ends
// 23:59:59.999999999+01:00.

// 1 = Monday .. 7 = Sunday, `Date.dayOfWeek`'s numbering: the number of
// distinct weekday values, and so the length of a week in days.
const boundsWeekDays: int = 7

// `firstDay` clamped to 1..7. The module clamps rather than failing or
// normalising, the same choice `withMonth`/`withDay` make
// (./calarith.bit, docs/stdlib/time.md "Month arithmetic clamps"): every
// method in this file is total, so an out-of-range first day resolves to
// the nearest real one — 0 or less is Monday, 8 or more is Sunday — rather
// than wrapping a 0-based caller's argument onto a different weekday than
// it meant.
fn boundsClampFirstDay(firstDay: int): int {
  if (firstDay < 1) {
    return 1
  }
  if (firstDay > boundsWeekDays) {
    return boundsWeekDays
  }
  return firstDay
}

// The first day of the week containing `d`, when a week starts on
// `firstDay`. `d.dayOfWeek()` and the clamped `firstDay` are both 1..7, so
// their difference is -6..6 and the `+ boundsWeekDays` below is enough to
// make the remainder non-negative — no floored division needed.
fn boundsWeekStart(d: Date, firstDay: int): Date {
  let first = boundsClampFirstDay(firstDay)
  let back = (d.dayOfWeek() - first + boundsWeekDays) % boundsWeekDays
  return d.addDays(-back)
}

// The first month of the quarter containing month `m`, 1..12 -> 1, 4, 7 or
// 10. `Date.quarter()` numbers the same quarters 1..4.
fn boundsQuarterStartMonth(m: int): int {
  return (m - 1) / 3 * 3 + 1
}

// Midnight, the first representable time of day.
fn boundsStartTime(): Time {
  return Time{ h: 0, min: 0, s: 0, nanos: 0 }
}

// 23:59:59.999999999, the last representable time of day: this module has
// nanosecond resolution (./timeofday.bit) and no `24:00:00` alias, so this
// is one nanosecond before the next midnight, not the next midnight.
fn boundsEndTime(): Time {
  return Time{ h: 23, min: 59, s: 59, nanos: 999999999 }
}

// `d` at midnight, as a wall clock with no zone.
fn boundsNaiveStart(d: Date): NaiveDateTime {
  return NaiveDateTime{ dt: d, tm: boundsStartTime() }
}

// `d` at its last representable nanosecond, as a wall clock with no zone.
fn boundsNaiveEnd(d: Date): NaiveDateTime {
  return NaiveDateTime{ dt: d, tm: boundsEndTime() }
}

// `d` at midnight, read in `z`. Goes through `inZone` so a midnight inside
// a spring gap is resolved by the one code path that owns that policy
// (./zoned.bit's `zonedFromWall`); computing the instant here would not.
fn boundsZonedStart(d: Date, z: Zone): DateTime {
  return boundsNaiveStart(d).inZone(z)
}

// `d` at its last representable nanosecond, read in `z`. Same re-resolution
// as `boundsZonedStart`.
fn boundsZonedEnd(d: Date, z: Zone): DateTime {
  return boundsNaiveEnd(d).inZone(z)
}

// --- Date --------------------------------------------------------------------

trait DateBounds {
  // `this`. A `Date` has no time of day to floor (docs/stdlib/time.md,
  // "Boundaries": on a `Date` these return a `Date`), so the day's start is
  // the day itself. Present so the same call reads the same on all three
  // types.
  startOfDay(): Date {
    return Date{ y: this.y, m: this.m, d: this.d }
  }

  // `this` — the identity, for the same reason `startOfDay` is. The last
  // representable NANOSECOND of the day is a `NaiveDateTime`/`DateTime`
  // notion; a `Date` has no time of day to carry it.
  endOfDay(): Date {
    return Date{ y: this.y, m: this.m, d: this.d }
  }

  // The Monday of the week containing `this` — ISO 8601
  // (docs/stdlib/time.md, "Boundaries"). 2026-09-17, a Thursday, gives
  // 2026-09-14.
  startOfWeek(): Date {
    return boundsWeekStart(Date{ y: this.y, m: this.m, d: this.d }, 1)
  }

  // The Sunday of the week containing `this`, ISO 8601: six days after
  // `startOfWeek()`. 2026-09-17 gives 2026-09-20.
  endOfWeek(): Date {
    return this.startOfWeek().addDays(boundsWeekDays - 1)
  }

  // The first day of the week containing `this` when a week starts on
  // `firstDay`, 1 = Monday .. 7 = Sunday, clamped to that range. The
  // explicit-first-day form of `startOfWeek()`; a separate name because Bit
  // has no overloading (file header). `startOfWeekOn(7)` on 2026-09-17
  // gives 2026-09-13.
  startOfWeekOn(firstDay: int): Date {
    return boundsWeekStart(Date{ y: this.y, m: this.m, d: this.d }, firstDay)
  }

  // Six days after `startOfWeekOn(firstDay)`. `endOfWeekOn(7)` on
  // 2026-09-17 gives 2026-09-19, a Saturday.
  endOfWeekOn(firstDay: int): Date {
    return this.startOfWeekOn(firstDay).addDays(boundsWeekDays - 1)
  }

  // The first day of `this` month. 2026-09-17 gives 2026-09-01.
  startOfMonth(): Date {
    return Date{ y: this.y, m: this.m, d: 1 }
  }

  // The last day of `this` month, 28, 29, 30 or 31 as the month and year
  // require (constraint: never hardcoded). 2026-09-17 gives 2026-09-30,
  // 2026-02-10 gives 2026-02-28, 2024-02-10 gives 2024-02-29.
  endOfMonth(): Date {
    return Date{ y: this.y, m: this.m, d: this.daysInMonth() }
  }

  // The first day of `this` quarter: 1 January, 1 April, 1 July or
  // 1 October. 2026-09-17 gives 2026-07-01.
  startOfQuarter(): Date {
    return Date{ y: this.y, m: boundsQuarterStartMonth(this.m), d: 1 }
  }

  // The last day of `this` quarter: 31 March, 30 June, 30 September or
  // 31 December. 2026-09-17 gives 2026-09-30. The day comes from
  // `civilDaysInMonth` (./civil.bit) rather than `this.daysInMonth()`,
  // which reads `this.m` — the quarter's last month is a different month.
  endOfQuarter(): Date {
    let last = boundsQuarterStartMonth(this.m) + 2
    return Date{ y: this.y, m: last, d: civilDaysInMonth(this.y, last) }
  }

  // 1 January of `this` year. 2026-09-17 gives 2026-01-01.
  startOfYear(): Date {
    return Date{ y: this.y, m: 1, d: 1 }
  }

  // 31 December of `this` year — derived from `civilDaysInMonth`, not
  // written down, so the family has one rule and no exception.
  // 2026-09-17 gives 2026-12-31.
  endOfYear(): Date {
    return Date{ y: this.y, m: 12, d: civilDaysInMonth(this.y, 12) }
  }
}

// --- NaiveDateTime -----------------------------------------------------------

trait NaiveDateTimeBounds {
  // `this` date at 00:00:00.000000000. The time of day is replaced, the
  // date kept.
  startOfDay(): NaiveDateTime {
    return boundsNaiveStart(this.dt)
  }

  // `this` date at 23:59:59.999999999 — the last representable nanosecond
  // of the day, not the next midnight (file header).
  endOfDay(): NaiveDateTime {
    return boundsNaiveEnd(this.dt)
  }

  // The Monday of `this` week, at midnight.
  startOfWeek(): NaiveDateTime {
    return boundsNaiveStart(this.dt.startOfWeek())
  }

  // The Sunday of `this` week, at 23:59:59.999999999.
  endOfWeek(): NaiveDateTime {
    return boundsNaiveEnd(this.dt.endOfWeek())
  }

  // The first day of `this` week at midnight, when a week starts on
  // `firstDay`, 1 = Monday .. 7 = Sunday, clamped to that range.
  startOfWeekOn(firstDay: int): NaiveDateTime {
    return boundsNaiveStart(this.dt.startOfWeekOn(firstDay))
  }

  // The last day of `this` week at 23:59:59.999999999, when a week starts
  // on `firstDay`.
  endOfWeekOn(firstDay: int): NaiveDateTime {
    return boundsNaiveEnd(this.dt.endOfWeekOn(firstDay))
  }

  // The first day of `this` month, at midnight.
  startOfMonth(): NaiveDateTime {
    return boundsNaiveStart(this.dt.startOfMonth())
  }

  // The last day of `this` month, at 23:59:59.999999999.
  endOfMonth(): NaiveDateTime {
    return boundsNaiveEnd(this.dt.endOfMonth())
  }

  // The first day of `this` quarter, at midnight.
  startOfQuarter(): NaiveDateTime {
    return boundsNaiveStart(this.dt.startOfQuarter())
  }

  // The last day of `this` quarter, at 23:59:59.999999999.
  endOfQuarter(): NaiveDateTime {
    return boundsNaiveEnd(this.dt.endOfQuarter())
  }

  // 1 January of `this` year, at midnight.
  startOfYear(): NaiveDateTime {
    return boundsNaiveStart(this.dt.startOfYear())
  }

  // 31 December of `this` year, at 23:59:59.999999999.
  endOfYear(): NaiveDateTime {
    return boundsNaiveEnd(this.dt.endOfYear())
  }
}

// --- DateTime ----------------------------------------------------------------

trait DateTimeBounds {
  // `this` date at 00:00:00.000000000 in `this` zone, with the offset
  // re-resolved for that new wall time — the one method in this family
  // where the distinction bites, because midnight itself is inside a spring
  // gap in some zones (file header).
  startOfDay(): DateTime {
    return boundsZonedStart(this.wall.date(), this.z)
  }

  // `this` date at 23:59:59.999999999 in `this` zone, offset re-resolved.
  // On a day carrying a transition this is not `startOfDay`'s offset.
  endOfDay(): DateTime {
    return boundsZonedEnd(this.wall.date(), this.z)
  }

  // The Monday of `this` week, at midnight in `this` zone.
  startOfWeek(): DateTime {
    return boundsZonedStart(this.wall.date().startOfWeek(), this.z)
  }

  // The Sunday of `this` week, at 23:59:59.999999999 in `this` zone.
  endOfWeek(): DateTime {
    return boundsZonedEnd(this.wall.date().endOfWeek(), this.z)
  }

  // The first day of `this` week at midnight in `this` zone, when a week
  // starts on `firstDay`, 1 = Monday .. 7 = Sunday, clamped to that range.
  startOfWeekOn(firstDay: int): DateTime {
    return boundsZonedStart(this.wall.date().startOfWeekOn(firstDay), this.z)
  }

  // The last day of `this` week at 23:59:59.999999999 in `this` zone, when
  // a week starts on `firstDay`.
  endOfWeekOn(firstDay: int): DateTime {
    return boundsZonedEnd(this.wall.date().endOfWeekOn(firstDay), this.z)
  }

  // The first day of `this` month, at midnight in `this` zone.
  startOfMonth(): DateTime {
    return boundsZonedStart(this.wall.date().startOfMonth(), this.z)
  }

  // The last day of `this` month, at 23:59:59.999999999 in `this` zone.
  endOfMonth(): DateTime {
    return boundsZonedEnd(this.wall.date().endOfMonth(), this.z)
  }

  // The first day of `this` quarter, at midnight in `this` zone.
  startOfQuarter(): DateTime {
    return boundsZonedStart(this.wall.date().startOfQuarter(), this.z)
  }

  // The last day of `this` quarter, at 23:59:59.999999999 in `this` zone.
  endOfQuarter(): DateTime {
    return boundsZonedEnd(this.wall.date().endOfQuarter(), this.z)
  }

  // 1 January of `this` year, at midnight in `this` zone.
  startOfYear(): DateTime {
    return boundsZonedStart(this.wall.date().startOfYear(), this.z)
  }

  // 31 December of `this` year, at 23:59:59.999999999 in `this` zone.
  endOfYear(): DateTime {
    return boundsZonedEnd(this.wall.date().endOfYear(), this.z)
  }
}
