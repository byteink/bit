// Private conversion boundaries make the overflow regression independent of uptime.
test "timer deadline saturates without wrapping" {
  let max = 9223372036854775807
  assert(timerDeadline(0, max) == max, "zero clock")
  assert(timerDeadline(17, max - 17) == max, "exact boundary")
  assert(timerDeadline(17, max - 16) == max, "one past boundary")
  assert(timerDeadline(17, max) == max, "maximum duration")
  assert(timerDeadline(max, 1) == max, "maximum clock")
  assert(timerDeadline(17, 23) == 40, "ordinary duration")
}

test "timer nonpositive durations are already due" {
  assert(timerDeadline(17, 0) == 17, "zero duration")
  assert(timerDeadline(17, -1) == 17, "negative duration")
  assert(timerDeadline(17, -9223372036854775807 - 1) == 17, "minimum duration")
}

fn timerTestPending(c: chan<bool>): bool {
  let guard = Timer(30 * Millisecond)
  select {
    case <- c:
      let _ = guard.stop()
      return false
    case <- guard.c:
      return true
  }
}

fn timerTestReady(c: chan<bool>): bool {
  let guard = Timer(Second)
  select {
    case <- c:
      let _ = guard.stop()
      return true
    case <- guard.c:
      return false
  }
}

test "timer maximum durations stay pending" {
  let max = 9223372036854775807
  assert(timerTestPending(after(max)), "after fired early")
  let timer = Timer(max)
  assert(timerTestPending(timer.c), "Timer fired early")
  assert(timer.stop(), "pending Timer must stop")
  let reset = Timer(Second)
  assert(reset.reset(max), "pending Timer must reset")
  assert(timerTestPending(reset.c), "reset Timer fired early")
  assert(reset.stop(), "reset Timer must stop")
  let ticker = Ticker(max)
  assert(timerTestPending(ticker.c), "Ticker fired early")
  assert(ticker.stop(), "pending Ticker must stop")
}

test "timer immediate durations retain one-shot behavior" {
  assert(timerTestReady(after(0)), "zero after did not fire")
  let timer = Timer(-9223372036854775807 - 1)
  assert(timerTestReady(timer.c), "minimum Timer did not fire")
  assert(!timer.reset(0), "fired Timer resurrected")
  let ticker = Ticker(-1)
  assert(timerTestReady(ticker.c), "negative Ticker did not fire")
  assert(!ticker.stop(), "nonpositive Ticker must have fired once")
}

test "timer reset cannot resurrect a stopped slot" {
  let timer = Timer(9223372036854775807)
  assert(timer.stop(), "pending Timer must stop")
  assert(!timer.reset(0), "stopped Timer resurrected")
  assert(!timer.stop(), "stopped Timer stopped twice")
}
