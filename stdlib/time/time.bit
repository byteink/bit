// Bit standard library — time module.
//
// A duration is a plain `int` nanoseconds, so it composes with ordinary
// arithmetic: `3 * Second`, `timeout / 2`, `a - b`. Two clocks, for two
// different jobs, and each returns its own nominal record rather than a bare
// int — so a reading from one clock can never be passed to the other clock's
// API by accident:
//
//   monotonic()  returns a `Mono`. Never jumps; the only clock that may
//                measure elapsed time. Pass a `Mono` to `since` to get the
//                elapsed nanoseconds.
//   now()        returns an `Instant`: wall-clock nanoseconds since the Unix
//                epoch. Dates events, and can jump backwards (NTP, an
//                operator setting the clock). Never pass an `Instant` to
//                `since` — that would measure elapsed time against a clock
//                that can jump.
//
// Both `Mono` and `Instant` expose their raw nanoseconds as `.ns`, for the
// rare caller that genuinely needs the bare int (serialising a timestamp,
// printing a reading).
//
// `sleep` parks the calling green thread on the scheduler's timer queue and
// leaves its worker free to run other threads (ABI.md §18) — a thousand
// concurrent sleepers finish together, not one after another.

export const Nanosecond: int = 1
export const Microsecond: int = 1000
export const Millisecond: int = 1000000
export const Second: int = 1000000000
export const Minute: int = 60000000000
export const Hour: int = 3600000000000

// A wall-clock reading, nanoseconds since the Unix epoch. Returned by `now`.
// Never pass one to `since` — use a `Mono` from `monotonic` instead.
export class Instant { export ns: int }

// A monotonic reading. Returned by `monotonic`. Only differences between two
// `Mono` readings are meaningful; pass one to `since` to get the elapsed
// nanoseconds.
export class Mono { export ns: int }

// Nanoseconds since the Unix epoch. For dating an event, never for measuring
// an interval — use `monotonic` for that.
export fn now(): Instant {
  return Instant{ ns: timeUnixNs() }
}

// A monotonic reading. Meaningful only when compared with another reading
// from this same clock, via `since`.
export fn monotonic(): Mono {
  return Mono{ ns: timeMonoNs() }
}

// Nanoseconds elapsed since the `monotonic()` reading `start`.
export fn since(start: Mono): int {
  return timeMonoNs() - start.ns
}

// Park the calling green thread for at least `d` nanoseconds. The OS thread
// is never blocked. The runtime turns `d` into an absolute monotonic
// deadline and clamps it to `i64max` nanoseconds, so
// `sleep(9223372036854775807)` parks for about 292 years and never returns
// early. A duration of `0` or less merely yields to the scheduler and
// returns at once.
export fn sleep(d: int) {
  timeSleepNs(d)
}

// --- duration views -------------------------------------------------------

// Whole milliseconds in `d`, truncated.
export fn millis(d: int): int {
  return d / Millisecond
}

// Whole seconds in `d`, truncated.
export fn secs(d: int): int {
  return d / Second
}

// `d` as fractional seconds.
export fn toSeconds(d: int): f64 {
  return f64(d) / f64(Second)
}

// `d` as fractional milliseconds.
export fn toMillis(d: int): f64 {
  return f64(d) / f64(Millisecond)
}

// --- timers and tickers -----------------------------------------------------
//
// Built directly on the scheduler's channel-timer queue (runtime/sched/timer.bit,
// #2665): expiry does a non-blocking send on a channel with no task and no
// stack behind it, so nothing below ever spawns a green thread — a timer here
// is one entry in a fixed pool, not a thread. `schedTimerChanArm` is a
// compiler builtin (its `chan<bool>` argument cannot cross a plain `extern fn`
// boundary); cancel and reset are plain `extern fn`s reaching
// `bit_rt_sched_timer_chan_cancel`/`_reset`.

extern fn bit_rt_sched_timer_chan_cancel(id: int): bool
extern fn bit_rt_sched_timer_chan_reset(id: int, deadlineNs: int): bool

// A channel that receives `true` once, at least `d` nanoseconds from now.
// There is no id to cancel it with, so if the receiving `select` never takes
// this arm, the entry stays pending until its own deadline — at which point
// it fires (the value is dropped, since nothing is left to receive it) and
// frees itself. The leak this can cause is bounded by `d`, never permanent;
// calling `after` inside a loop still accumulates one pending entry per call
// until each fires — use `newTimer` and `stop` there instead.
export fn after(d: int): chan<bool> {
  let c = chan<bool>(1)
  schedTimerChanArm(monotonic().ns + d, c, 0)
  return c
}

// A one-shot timer. `c` receives `true` once, at least `d` nanoseconds after
// `newTimer` returned. `id` is the underlying queue entry and is never
// exposed — `stop` and `reset` are the only way to touch it.
export class Timer { export c: chan<bool>, id: int }

// Starts a `Timer` that fires once, at least `d` nanoseconds from now.
export fn newTimer(d: int): Timer {
  let c = chan<bool>(1)
  let id = schedTimerChanArm(monotonic().ns + d, c, 0)
  return Timer{ c: c, id: id }
}

// Stops `t` before it fires. Returns `true` when `t` was still pending (and
// is now cancelled — nothing will ever arrive on `t.c`), `false` when it had
// already fired. `stop` never drains `t.c`: on a `false` return, a `true` may
// already be sitting in its one-slot buffer from the firing, and a caller
// that reuses `t.c` must drain it first — the same `if !t.stop() { <- t.c }`
// idiom Go's `Timer.Stop` documents, for the same reason.
export fn (t: Timer) stop(): bool {
  return bit_rt_sched_timer_chan_cancel(t.id)
}

// Re-arms `t` to fire at least `d` nanoseconds from now, replacing its
// current deadline. Returns `true` when `t` was still pending and has been
// moved. Returns `false` when `t` had already fired: firing frees the
// underlying queue entry, so there is nothing left to move, `t.id` no longer
// names a live entry, and this call has NO OTHER EFFECT — `t.c` is
// untouched, and no new value arrives on it. A caller that needs `t` to fire
// again after that must build a new one with `newTimer`.
export fn (t: Timer) reset(d: int): bool {
  return bit_rt_sched_timer_chan_reset(t.id, monotonic().ns + d)
}

// A repeating timer. `c` receives `true` every `d` nanoseconds until `stop`
// is called.
export class Ticker { export c: chan<bool>, id: int }

// Starts a `Ticker` that fires every `d` nanoseconds, the first tick at
// least `d` nanoseconds from now. A tick nobody was ready to receive is
// dropped, never queued — the same one-slot-buffer drop `after` and
// `newTimer` use.
export fn newTicker(d: int): Ticker {
  let c = chan<bool>(1)
  let id = schedTimerChanArm(monotonic().ns + d, c, d)
  return Ticker{ c: c, id: id }
}

// Stops `t`. No further ticks arrive on `t.c` after this returns. A `Ticker`
// that is never stopped holds its queue entry forever — a permanent leak of
// one pool slot, the same caveat Go documents for an un-stopped
// `time.Ticker`.
export fn (t: Ticker) stop(): bool {
  return bit_rt_sched_timer_chan_cancel(t.id)
}

// A channel that receives `true` every `d` nanoseconds, forever. Equivalent
// to `newTicker(d).c`, with the same permanent-leak caveat and no way to
// stop it — there is no id to call `stop` with. Use `newTicker` instead
// whenever the ticker must eventually stop.
export fn tick(d: int): chan<bool> {
  return newTicker(d).c
}
