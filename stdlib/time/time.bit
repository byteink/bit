// Bit standard library — time module.
//
// A duration is a plain `int` nanoseconds, so it composes with ordinary
// arithmetic: `3 * Second`, `timeout / 2`, `a - b`. Two clocks, for two
// different jobs, and each returns its own nominal record rather than a bare
// int — so a reading from one clock can never be passed to the other clock's
// API by accident:
//
//   monotonic()  returns a `Mono`. Never jumps; the only clock that may
//                measure elapsed time. Pass a `Mono` to `since` to get the
//                elapsed nanoseconds.
//   now()        returns a `Timestamp`: wall-clock nanoseconds since the
//                Unix epoch. Dates events, and can jump backwards (NTP, an
//                operator setting the clock). Never pass a `Timestamp` to
//                `since` — that would measure elapsed time against a clock
//                that can jump.
//
// Both `Mono` and `Timestamp` expose their raw nanoseconds as `.ns`, for the
// rare caller that genuinely needs the bare int (serialising a timestamp,
// printing a reading). `Timestamp.ns` is readonly — only `now` produces one.
//
// `sleep` parks the calling green thread on the scheduler's timer queue and
// leaves its worker free to run other threads (ABI.md §18) — a thousand
// concurrent sleepers finish together, not one after another.

export const Nanosecond: int = 1
export const Microsecond: int = 1000
export const Millisecond: int = 1000000
export const Second: int = 1000000000
export const Minute: int = 60000000000
export const Hour: int = 3600000000000

// A wall-clock reading, nanoseconds since the Unix epoch. Returned by `now`.
// Never pass one to `since` — use a `Mono` from `monotonic` instead.
export class Timestamp { export readonly ns: int }

// A monotonic reading. Returned by `monotonic`. Only differences between two
// `Mono` readings are meaningful; pass one to `since` to get the elapsed
// nanoseconds.
export class Mono { export ns: int }

// Nanoseconds since the Unix epoch. For dating an event, never for measuring
// an interval — use `monotonic` for that.
export fn now(): Timestamp {
  return Timestamp{ ns: timeUnixNs() }
}

// A monotonic reading. Meaningful only when compared with another reading
// from this same clock, via `since`.
export fn monotonic(): Mono {
  return Mono{ ns: timeMonoNs() }
}

// Nanoseconds elapsed since the `monotonic()` reading `start`.
export fn since(start: Mono): int {
  return timeMonoNs() - start.ns
}

// Park the calling green thread for at least `d` nanoseconds. The OS thread
// is never blocked. The runtime turns `d` into an absolute monotonic
// deadline and clamps it to `i64max` nanoseconds, so
// `sleep(9223372036854775807)` parks for about 292 years and never returns
// early. A duration of `0` or less merely yields to the scheduler and
// returns at once.
export fn sleep(d: int) {
  timeSleepNs(d)
}

// The scheduler's own park primitive (`runtime/sched/timer.bit`), taking the
// ABSOLUTE deadline `sleep` itself computes internally
// (`bit_rt_time_sleep_ns` is `schedSleepUntil(parkMonoNs() + ns)`). Exposed
// directly so a caller holding one deadline under a shared mutex — a rate
// limiter handing out a slot, for instance — parks every waiter on that same
// instant instead of each recomputing `deadline - monotonic().ns` after the
// mutex, which drifts.
extern fn bit_rt_port_sched_sleep_until(deadlineNs: int)

// Park the calling green thread until `deadlineNs` on the clock
// `monotonic().ns` reads — an absolute instant, not a duration. The OS
// thread is never blocked; this is the same cooperative park `sleep` itself
// parks on, not a raw syscall, so it needs no safepoint bracket of its own.
// A `deadlineNs` already in the past still parks, briefly: the scheduler's
// next idle pass finds it due at once and wakes it, so this returns quickly
// rather than either hanging forever or spinning to check the clock itself.
export fn sleepUntil(deadlineNs: int) {
  bit_rt_port_sched_sleep_until(deadlineNs)
}

// --- duration views -------------------------------------------------------

// Whole milliseconds in `d`, truncated.
export fn millis(d: int): int {
  return d / Millisecond
}

// Whole seconds in `d`, truncated.
export fn secs(d: int): int {
  return d / Second
}

// `d` as fractional seconds.
export fn toSeconds(d: int): f64 {
  return f64(d) / f64(Second)
}

// `d` as fractional milliseconds.
export fn toMillis(d: int): f64 {
  return f64(d) / f64(Millisecond)
}

// --- timer channels ---------------------------------------------------------
//
// Built on the scheduler's own timer-channel primitives
// (`runtime/sched/timer.bit`, #2665): arming a timer claims one of a fixed
// pool of slots and queues it against the scheduler's timer wheel. Nothing
// below spawns a green thread; expiry is a plain send on the channel, with no
// task and no stack. A duration `d` is nanoseconds, the same unit `sleep`
// takes.

extern fn bit_rt_sched_timer_chan_cancel(id: int): bool
extern fn bit_rt_sched_timer_chan_reset(id: int, deadlineNs: int): bool

// A channel that receives `true` once, `d` nanoseconds from now — the
// idiomatic `select` timeout arm:
// `select { case v = <-work: ...; case <-after(d): ... }`.
// If the timeout arm is never taken, the pool slot leaks only until its own
// deadline: it fires and self-frees regardless, so the leak is bounded by
// `d`, never permanent. In a loop, prefer `newTimer` and `reset` over a fresh
// `after` each iteration, which would otherwise accumulate one live slot per
// iteration between fires.
export fn after(d: int): chan<bool> {
  let c = chan<bool>(1)
  schedTimerChanArm(monotonic().ns + d, c, 0)
  return c
}

// A one-shot timer. `c` receives `true` once, when the timer fires. `id`
// names the scheduler's pool slot and is private to `stop`/`reset`.
export class Timer {
  export c: chan<bool>
  id: int

  // Cancels the timer. Returns `true` when it was still pending, `false`
  // when it had already fired. Does NOT drain `c` — a fired timer's buffered
  // `true` stays there, matching Go's own `Timer.Stop`: `if !t.stop() { <-t.c }`
  // drains it before reuse.
  export stop(): bool {
    return bit_rt_sched_timer_chan_cancel(this.id)
  }

  // Re-arms the timer for `d` nanoseconds from now. Returns `false`, with NO
  // effect, when the timer already fired — its pool slot was freed at fire
  // time, so there is no entry left to move and no second value will ever
  // arrive on `c`. Build a new `Timer` with `newTimer` instead of trying to
  // resurrect a fired one.
  export reset(d: int): bool {
    return bit_rt_sched_timer_chan_reset(this.id, monotonic().ns + d)
  }
}

// Starts a one-shot `Timer` that fires `d` nanoseconds from now.
export fn newTimer(d: int): Timer {
  let c = chan<bool>(1)
  let id = schedTimerChanArm(monotonic().ns + d, c, 0)
  return Timer{ c: c, id: id }
}

// A repeating timer. `c` receives `true` every `d` nanoseconds until
// `stop`ped. An un-stopped `Ticker` leaks its pool slot forever — the same
// caveat Go's own `time.Ticker` documents.
export class Ticker {
  export c: chan<bool>
  id: int

  // Cancels the ticker. Returns `true` when it was still pending, `false`
  // otherwise. After this returns, `c` receives no further ticks.
  export stop(): bool {
    return bit_rt_sched_timer_chan_cancel(this.id)
  }
}

// Starts a `Ticker` that ticks every `d` nanoseconds.
export fn newTicker(d: int): Ticker {
  let c = chan<bool>(1)
  let id = schedTimerChanArm(monotonic().ns + d, c, d)
  return Ticker{ c: c, id: id }
}

// A channel that receives `true` every `d` nanoseconds, forever. There is no
// way to stop it — the underlying `Ticker` is discarded, so its pool slot
// leaks for the life of the program. Use `newTicker` directly when the
// ticker must ever be stopped.
export fn tick(d: int): chan<bool> {
  return newTicker(d).c
}
