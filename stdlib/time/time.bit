// Bit standard library — time module.
//
// Durations are plain `int` nanoseconds, so they compose with ordinary
// arithmetic: `3 * Second`, `timeout / 2`, `a - b`. Two clocks, for two
// different jobs:
//
//   monotonic()  never jumps; the only clock that may measure elapsed time.
//   now()        wall-clock nanoseconds since the Unix epoch; dates events,
//                and can jump backwards (NTP, an operator setting the clock).
//
// `sleep` parks the calling green thread on the scheduler's timer queue and
// leaves its worker free to run other threads (ABI.md §18) — a thousand
// concurrent sleepers finish together, not one after another.

export const Nanosecond: int = 1
export const Microsecond: int = 1000
export const Millisecond: int = 1000000
export const Second: int = 1000000000
export const Minute: int = 60000000000
export const Hour: int = 3600000000000

// Nanoseconds since the Unix epoch. For dating an event, never for measuring
// an interval — use `monotonic` for that.
export fn now(): int {
  return timeUnixNs()
}

// A monotonic reading in nanoseconds. Meaningful only when compared with
// another reading from this same clock.
export fn monotonic(): int {
  return timeMonoNs()
}

// Nanoseconds elapsed since the `monotonic()` reading `start`.
export fn since(start: int): int {
  return timeMonoNs() - start
}

// Park the calling green thread for at least `d` nanoseconds. A non-positive
// duration merely yields to the scheduler. The OS thread is never blocked.
export fn sleep(d: int) {
  timeSleepNs(d)
}

// --- duration views -------------------------------------------------------

// Whole milliseconds in `d`, truncated.
export fn millis(d: int): int {
  return d / Millisecond
}

// Whole seconds in `d`, truncated.
export fn secs(d: int): int {
  return d / Second
}

// `d` as fractional seconds.
export fn toSeconds(d: int): f64 {
  return f64(d) / f64(Second)
}

// `d` as fractional milliseconds.
export fn toMillis(d: int): f64 {
  return f64(d) / f64(Millisecond)
}
