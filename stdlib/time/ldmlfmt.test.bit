// stdlib/time/ldmlfmt.test.bit — `format(pattern)` on all four types
// (./ldmlfmt.bit, #4080). Same module as ./ldmlfmt.bit, ./date.bit,
// ./timeofday.bit, ./naive.bit and ./zoned.bit (SPEC §19): no import is
// needed to reach `date`, `time`, `timeNs`, `zone`, `Date`, `Time`,
// `NaiveDateTime` or `DateTime`.
//
// Every rendered value below is checked against the token table in
// docs/stdlib/time.md ("Formatting"), whose example row is
// 2026-09-01T09:05:00+04:00 — the value used throughout. 2026-09-01 is a
// Tuesday (./date.test.bit and _tests_/cases/run_time_date_fields.bit both
// pin it) and Asia/Dubai is +04:00 all year (./zone.test.bit, checked there
// against this host's tzdata).

// The four constructors, for arguments this file already knows are valid.
// Every call below passes literal constants, so the failure paths are
// unreachable; they panic rather than substituting a value, the same way
// ./business.test.bit does — a silently substituted date would make every
// assertion downstream of it meaningless.
fn ldmlTestDate(y: int, m: int, d: int): Date {
  return date(y, m, d) catch e {
    panic("date(${y}, ${m}, ${d}) failed: ${e.message()}")
  }
}

fn ldmlTestTime(h: int, min: int, s: int, nanos: int): Time {
  return timeNs(h, min, s, nanos) catch e {
    panic("timeNs(${h}, ${min}, ${s}, ${nanos}) failed: ${e.message()}")
  }
}

fn ldmlTestNaive(): NaiveDateTime {
  return ldmlTestDate(2026, 9, 1).atTime(9, 5, 0) catch e {
    panic("atTime failed: ${e.message()}")
  }
}

fn ldmlTestZoned(name: string): DateTime {
  let z = zone(name) catch e {
    panic("zone(${name}) failed: ${e.message()}")
  }
  return ldmlTestNaive().inZone(z)
}

// True when `needle` occurs anywhere in `hay`. Bounded by `len(hay)`;
// written here rather than imported so this file adds no `std/*` import to
// the module (./tzlocal.bit's `readFile` is the module's only one).
fn ldmlTestHas(hay: string, needle: string): bool {
  let i = 0
  while (i + len(needle) <= len(hay)) {
    if (hay[i:i + len(needle)] == needle) {
      return true
    }
    i = i + 1
  }
  return false
}

// The failure message of a rejected pattern, prefixed `ERR:`, or the
// rendering when the pattern is accepted. No rendering starts with `ERR:`,
// so a test that expects a failure cannot pass on a success.
fn ldmlTestZonedFmt(t: DateTime, pattern: string): string {
  return t.format(pattern) catch e {
    "ERR:" + e.message()
  }
}

fn ldmlTestDateFmt(d: Date, pattern: string): string {
  return d.format(pattern) catch e {
    "ERR:" + e.message()
  }
}

fn ldmlTestTimeFmt(t: Time, pattern: string): string {
  return t.format(pattern) catch e {
    "ERR:" + e.message()
  }
}

fn ldmlTestNaiveFmt(n: NaiveDateTime, pattern: string): string {
  return n.format(pattern) catch e {
    "ERR:" + e.message()
  }
}

test "the doc table's date symbols, on the row it documents" {
  let d = ldmlTestDate(2026, 9, 1)
  assert(ldmlTestDateFmt(d, "y") == "2026", "y is the year as written: ${ldmlTestDateFmt(d, "y")}")
  assert(ldmlTestDateFmt(d, "yy") == "26", "yy is the last two digits")
  assert(ldmlTestDateFmt(d, "yyyy") == "2026", "yyyy is four digits")
  assert(ldmlTestDateFmt(d, "M") == "9", "M is the bare month number")
  assert(ldmlTestDateFmt(d, "MM") == "09", "MM is zero-padded")
  assert(ldmlTestDateFmt(d, "MMM") == "Sep", "MMM is the three-letter name")
  assert(ldmlTestDateFmt(d, "MMMM") == "September", "MMMM is the full name")
  assert(ldmlTestDateFmt(d, "d") == "1", "d is the bare day of month")
  assert(ldmlTestDateFmt(d, "dd") == "01", "dd is zero-padded")
  assert(ldmlTestDateFmt(d, "Q") == "3", "September is in quarter 3")
}

test "E widens from the three-letter name to the full one" {
  let d = ldmlTestDate(2026, 9, 1)
  assert(ldmlTestDateFmt(d, "E") == "Tue", "E is the abbreviation")
  assert(ldmlTestDateFmt(d, "EEE") == "Tue", "EEE is the same abbreviation")
  assert(ldmlTestDateFmt(d, "EEEE") == "Tuesday", "EEEE is the full name")
}

test "a four-digit year is padded, not truncated, on a small year" {
  let d = ldmlTestDate(7, 1, 2)
  assert(ldmlTestDateFmt(d, "yyyy-MM-dd") == "0007-01-02", "year 7 pads to four digits")
  assert(ldmlTestDateFmt(d, "yy") == "07", "yy of year 7 is 07, not 7")
}

test "the doc table's time symbols, including the 12-hour clock" {
  let t = ldmlTestTime(9, 5, 0, 0)
  assert(ldmlTestTimeFmt(t, "H") == "9", "H is the bare 0..23 hour")
  assert(ldmlTestTimeFmt(t, "HH") == "09", "HH is zero-padded")
  assert(ldmlTestTimeFmt(t, "h") == "9", "h is the bare 1..12 hour")
  assert(ldmlTestTimeFmt(t, "hh") == "09", "hh is zero-padded")
  assert(ldmlTestTimeFmt(t, "m") == "5", "m is the bare minute")
  assert(ldmlTestTimeFmt(t, "mm") == "05", "mm is zero-padded")
  assert(ldmlTestTimeFmt(t, "s") == "0", "s is the bare second")
  assert(ldmlTestTimeFmt(t, "ss") == "00", "ss is zero-padded")
  assert(ldmlTestTimeFmt(t, "a") == "AM", "09:05 is AM")
}

test "midnight and noon are both 12 on the h clock" {
  let midnight = ldmlTestTime(0, 0, 0, 0)
  let noon = ldmlTestTime(12, 0, 0, 0)
  let evening = ldmlTestTime(23, 59, 59, 0)
  assert(ldmlTestTimeFmt(midnight, "h a") == "12 AM", "00:00 is 12 AM")
  assert(ldmlTestTimeFmt(noon, "h a") == "12 PM", "12:00 is 12 PM")
  assert(ldmlTestTimeFmt(evening, "h:mm a") == "11:59 PM", "23:59 is 11:59 PM")
}

test "S truncates the nanosecond field to that many places" {
  let t = ldmlTestTime(9, 5, 0, 123456789)
  assert(ldmlTestTimeFmt(t, "S") == "1", "S is one tenth of a second")
  assert(ldmlTestTimeFmt(t, "SSS") == "123", "SSS is milliseconds")
  assert(ldmlTestTimeFmt(t, "SSSSSSSSS") == "123456789", "nine S is the whole field")
  let sparse = ldmlTestTime(9, 5, 0, 500)
  assert(ldmlTestTimeFmt(sparse, "SSSSSSSSS") == "000000500", "500ns keeps its leading zeros")
  assert(ldmlTestTimeFmt(sparse, "SSS") == "000", "and truncates to 000 at millisecond width")
  assert(
    ldmlTestHas(ldmlTestTimeFmt(t, "SSSSSSSSSS"), "ERR:"),
    "ten S is rejected: ${ldmlTestTimeFmt(t, "SSSSSSSSSS")}",
  )
}

test "a NaiveDateTime renders date and time symbols but no zone symbol" {
  let n = ldmlTestNaive()
  assert(ldmlTestNaiveFmt(n, "yyyy-MM-dd HH:mm") == "2026-09-01 09:05", "both halves render")
  assert(ldmlTestNaiveFmt(n, "EEEE, d MMMM yyyy") == "Tuesday, 1 September 2026", "long form")
  let zoned = ldmlTestNaiveFmt(n, "Z")
  assert(ldmlTestHas(zoned, "ERR:") && ldmlTestHas(zoned, "'Z'"), "Z has no answer here: ${zoned}")
}

test "a DateTime renders the offset three ways and its zone id" {
  let t = ldmlTestZoned("Asia/Dubai")
  assert(ldmlTestZonedFmt(t, "Z") == "+0400", "Z is the basic offset")
  assert(ldmlTestZonedFmt(t, "X") == "+04:00", "X is the ISO 8601 offset")
  assert(ldmlTestZonedFmt(t, "V") == "Asia/Dubai", "V is the zone identifier")
  assert(
    ldmlTestZonedFmt(t, "yyyy-MM-dd'T'HH:mm:ssX") == "2026-09-01T09:05:00+04:00",
    "the whole RFC 3339 form: ${ldmlTestZonedFmt(t, "yyyy-MM-dd'T'HH:mm:ssX")}",
  )
}

test "X is Z at a zero offset and the numeric form is not" {
  let t = ldmlTestZoned("UTC")
  assert(ldmlTestZonedFmt(t, "X") == "Z", "X abbreviates a zero offset")
  assert(ldmlTestZonedFmt(t, "Z") == "+0000", "Z never does")
  assert(ldmlTestZonedFmt(t, "V") == "UTC", "the zone identifier is carried through")
}

test "a zone symbol takes no repeat" {
  let t = ldmlTestZoned("Asia/Dubai")
  assert(ldmlTestHas(ldmlTestZonedFmt(t, "ZZ"), "ERR:"), "ZZ is rejected")
  assert(ldmlTestHas(ldmlTestZonedFmt(t, "XXX"), "ERR:"), "XXX is rejected")
  assert(ldmlTestHas(ldmlTestZonedFmt(t, "VV"), "ERR:"), "VV is rejected")
}

test "Y names the week-based year, y and weekOfYear" {
  let t = ldmlTestZoned("Asia/Dubai")
  let msg = ldmlTestZonedFmt(t, "YYYY-MM-dd")
  assert(ldmlTestHas(msg, "ERR:"), "YYYY fails rather than rendering: ${msg}")
  assert(ldmlTestHas(msg, "'Y'"), "the message names the symbol: ${msg}")
  assert(ldmlTestHas(msg, "'y'"), "and points at y: ${msg}")
  assert(ldmlTestHas(msg, "weekOfYear()"), "and at weekOfYear(): ${msg}")
}

test "D names the day of the year, d and dayOfYear" {
  let t = ldmlTestZoned("Asia/Dubai")
  let msg = ldmlTestZonedFmt(t, "yyyy-DDD")
  assert(ldmlTestHas(msg, "ERR:"), "DDD fails rather than rendering: ${msg}")
  assert(ldmlTestHas(msg, "'D'"), "the message names the symbol: ${msg}")
  assert(ldmlTestHas(msg, "'d'"), "and points at d: ${msg}")
  assert(ldmlTestHas(msg, "dayOfYear()"), "and at dayOfYear(): ${msg}")
}

test "a symbol the receiver does not carry fails, naming it" {
  let d = ldmlTestDate(2026, 9, 1)
  let onDate = ldmlTestDateFmt(d, "HH:mm")
  assert(ldmlTestHas(onDate, "ERR:") && ldmlTestHas(onDate, "'H'"), "H on a Date: ${onDate}")
  let zoneOnDate = ldmlTestDateFmt(d, "V")
  assert(ldmlTestHas(zoneOnDate, "ERR:"), "V on a Date: ${zoneOnDate}")
  let t = ldmlTestTime(9, 5, 0, 0)
  let onTime = ldmlTestTimeFmt(t, "dd")
  assert(ldmlTestHas(onTime, "ERR:") && ldmlTestHas(onTime, "'d'"), "d on a Time: ${onTime}")
}

test "an unknown pattern letter fails, never copied through" {
  let d = ldmlTestDate(2026, 9, 1)
  let era = ldmlTestDateFmt(d, "G yyyy")
  assert(ldmlTestHas(era, "ERR:") && ldmlTestHas(era, "'G'"), "G is not implemented: ${era}")
  assert(ldmlTestHas(ldmlTestDateFmt(d, "MMMMM"), "ERR:"), "the narrow month form is not either")
  assert(ldmlTestHas(ldmlTestDateFmt(d, "EEEEE"), "ERR:"), "nor the narrow weekday form")
}

test "quoting: a run is literal, two quotes are one, punctuation is copied" {
  let n = ldmlTestNaive()
  assert(ldmlTestNaiveFmt(n, "'at' HH:mm") == "at 09:05", "a quoted run is literal")
  assert(ldmlTestNaiveFmt(n, "''") == "'", "two quotes render one")
  assert(ldmlTestNaiveFmt(n, "'it''s' HH") == "it's 09", "and inside a run too")
  assert(ldmlTestNaiveFmt(n, "'yMd'") == "yMd", "pattern letters inside a run are literal")
  assert(
    ldmlTestNaiveFmt(n, "[dd/MM] -- HH:mm") == "[01/09] -- 09:05",
    "punctuation copies through",
  )
  let open = ldmlTestNaiveFmt(n, "'unterminated")
  assert(ldmlTestHas(open, "ERR:"), "an unterminated quote fails: ${open}")
}

test "an empty pattern renders an empty string on every type" {
  let d = ldmlTestDate(2026, 9, 1)
  let t = ldmlTestTime(9, 5, 0, 0)
  let n = ldmlTestNaive()
  let z = ldmlTestZoned("Asia/Dubai")
  assert(ldmlTestDateFmt(d, "") == "", "Date")
  assert(ldmlTestTimeFmt(t, "") == "", "Time")
  assert(ldmlTestNaiveFmt(n, "") == "", "NaiveDateTime")
  assert(ldmlTestZonedFmt(z, "") == "", "DateTime")
}
