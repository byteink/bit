// stdlib/time/zonefooter.test.bit — the TZif footer against the table (#6380):
// the footer must agree with the last transition (RFC 8536 §3.3), and the
// `n` spelling of "daylight saving all year" must read as it (RFC 8536
// §3.3.1). Same module as ./zoneif.bit and ./tzrule.bit (SPEC §19); the
// hermetic file builder is ./tzrule.test.bit's `tzrTestFileTyped`.
//
// Expected values for the `n` form come from the C library of this host
// (`localtime` under `TZ=EST5EDT,0/0,365/25`, through Python's `time.tzset`):
// Python's own `zoneinfo` places a zero-based day one day early in every year
// (its `_post_epoch_days_before_year` is one short, so only the one-based `Jn`
// form comes out right), which makes it no oracle for this spelling.

import { walk } from "std/fs"

const zfNewYork: string = "EST5EDT,M3.2.0,M11.1.0"

// --- "DST all year" in the `n` spelling -----------------------------------

test "EST5EDT,0/0,365/25 (n form) is daylight saving at every instant, leap and common years" {
  let z = tzrTestZone("EST5EDT,0/0,365/25")
  let samples = [
    2224713600,
    2240611200 - 1,
    2240611200,
    2240611200 + 18000 - 1,
    2240611200 + 18000,
    2256249600,
    2272251600 - 1,
    2272251600,
    2287785600,
    2303424000,
  ]
  for t of samples {
    assert(zoneOffsetAt(z, t) == -14400, "offset at ${t} is ${zoneOffsetAt(z, t)}, want -14400")
    assert(zoneIsDstAt(z, t), "isDst at ${t} is false")
  }
}

test "a same-year end on the start instant (J100/3 EST is J100/4 EDT) is an empty window: standard time" {
  let z = tzrTestZone("EST5EDT,J100/3,J100/4")
  // J100 is April 10 (April 9 in a leap year), 08:00Z either way.
  for t of [2224713600, 2216000000 + 864000, 2230000000] {
    assert(!zoneIsDstAt(z, t), "an empty window held daylight saving at ${t}")
    assert(zoneOffsetAt(z, t) == -18000, "offset at ${t} is not the standard -18000")
  }
}

// --- the footer must agree with the last transition -----------------------

// `tzifParse` of a one-transition file at `at` whose type is (`off`, `isDst`,
// `abbr`) under `footer`: its failure message, or "" when it loads.
fn zfLoad(off: int, isDst: bool, abbr: string, at: int, footer: string): string {
  tzifParse(tzrTestFileTyped(off, isDst, abbr, at, footer)) catch e {
    return e.message()
  }
  return ""
}

fn zfWant(got: string, want: string) {
  assert(got == want, "got '${got}', want '${want}'")
}

test "a footer that agrees with the last transition loads, winter, summer and on the change itself" {
  zfWant(zfLoad(-18000, false, "EST", 1700000000, zfNewYork), "")
  zfWant(zfLoad(-14400, true, "EDT", 1720000000, zfNewYork), "")
  // The instants the rule itself changes at, 2024-03-10T07:00Z and
  // 2024-11-03T06:00Z: the rule's answer AT the instant is the new type.
  zfWant(zfLoad(-14400, true, "EDT", 1710054000, zfNewYork), "")
  zfWant(zfLoad(-18000, false, "EST", 1730613600, zfNewYork), "")
  zfWant(zfLoad(32400, false, "JST", 1700000000, "JST-9"), "")
  zfWant(zfLoad(-14400, true, "EDT", 2240629200, "EST5EDT,0/0,365/25"), "")
}

test "a footer that disagrees with the last transition fails at load, naming the first field" {
  zfWant(
    zfLoad(3600, false, "EST", 1700000000, zfNewYork),
    "tzif: footer '${zfNewYork}' disagrees with the last transition at 1700000000: offset 3600 vs -18000",
  )
  zfWant(
    zfLoad(-18000, true, "EST", 1700000000, zfNewYork),
    "tzif: footer '${zfNewYork}' disagrees with the last transition at 1700000000: isdst true vs false",
  )
  zfWant(
    zfLoad(-18000, false, "XYZ", 1700000000, zfNewYork),
    "tzif: footer '${zfNewYork}' disagrees with the last transition at 1700000000: abbreviation XYZ vs EST",
  )
  zfWant(
    zfLoad(-18000, false, "EST", 1720000000, zfNewYork),
    "tzif: footer '${zfNewYork}' disagrees with the last transition at 1720000000: offset -18000 vs -14400",
  )
}

test "one second before the rule's own change the old type is the one the table must name" {
  zfWant(zfLoad(-18000, false, "EST", 1710054000 - 1, zfNewYork), "")
  let got = zfLoad(-14400, true, "EDT", 1710054000 - 1, zfNewYork)
  assert(tzrHas(got, "at 1710053999: offset -14400 vs -18000"), "got '${got}'")
}

test "a quoted footer designation is compared without its brackets" {
  zfWant(zfLoad(-10800, false, "-03", 1700000000, "<-03>3"), "")
  let got = zfLoad(-10800, false, "-02", 1700000000, "<-03>3")
  assert(tzrHas(got, "abbreviation -02 vs -03"), "got '${got}'")
}

test "a last transition too far out to evaluate a footer at is refused by name" {
  let far = 1 << 60
  let got = zfLoad(-18000, false, "EST", far, zfNewYork)
  assert(tzrHas(got, "outside the range a footer can be checked over"), "got '${got}'")
}

// --- every host zone still loads ------------------------------------------

test "every TZif file of the host zoneinfo tree loads through zone()" {
  let root = zoneInfoDir
  let loaded = 0
  for path of walk(root) catch "" {
    let name = path[len(root):len(path)]
    let data = readFile(path) catch ""
    if (len(data) < 4 || data[0:4] != "TZif" || !zoneNameValid(name)) {
      continue
    }
    zone(name) catch e {
      assert(false, "zone(${name}) failed: ${e.message()}")
      return
    }
    loaded = loaded + 1
  }
  println("host zones loaded: ${loaded}")
  assert(loaded > 0, "no TZif file found under ${root}")
}
