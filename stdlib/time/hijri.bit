// Bit standard library — time module, Umm al-Qura Hijri display (#4082).
//
// `Date.hijri()`, `HijriDate` and `hijriDate()` (docs/stdlib/time.md,
// "Hijri dates"). A DISPLAY CONVERSION, NOT A SECOND CALENDAR SYSTEM:
// values are stored and computed in the Gregorian calendar throughout,
// `hijri()` produces a rendering and `gregorian()` goes back. There is
// deliberately no Hijri arithmetic — no `addMonths` on a `HijriDate`; add
// months to the `Date` and convert for display.
//
// THE VARIANT IS UMM AL-QURA, and no other. It is the calendar used for
// official and civil purposes in Saudi Arabia and across the Gulf. The
// purely arithmetic Hijri variants and the observation-based ones can
// differ from it by a day, and a document that must match a government
// record needs Umm al-Qura.
//
// IT IS TABULATED, NOT COMPUTED. Umm al-Qura is published as month-length
// tables. `hijriMonthMasks` below holds one 12-bit mask per Hijri year,
// bit 11 the first month and bit 0 the twelfth, a set bit meaning that
// month has 30 days rather than 29 — the same encoding the source data
// uses. The span is 1300..1500 AH; both `hijri()` and `hijriDate()` FAIL
// outside it rather than extrapolating, because an extrapolated official
// date is wrong in a way nobody notices.
//
// DATA PROVENANCE. The masks are transcribed from ICU4C's
// `UMALQURA_MONTHLENGTH`, at
// https://raw.githubusercontent.com/unicode-org/icu/main/icu4c/source/i18n/islamcal.cpp
// (ICU commit 59af52bb6f967bc5061bc3f6a91063de88e4aa78), entries
// `UMALQURA_YEAR_START` = 1300 through 1500. The Gregorian anchor is
// ICU's own: `CIVIL_EPOC` 1948440 (Julian day) plus its
// `yearStart(1300)` of 460322 gives Julian day 2408762 for 1 Muharram
// 1300 AH, which is Gregorian 1882-11-12 — `hijriEpochDay` below, as a
// day count from the Unix epoch.
//
// The transcription was cross-checked three ways before it landed, all
// recorded in ./hijri.test.bit: ICU's two independent representations of
// the same data agree (its least-squares `yearStart` fit plus correction
// table reproduces the accumulated mask lengths for every year 1300-1599,
// 0 mismatches); an unrelated transcription of the official tables,
// github.com/dralshehri/hijridate's `MONTH_STARTS`, agrees month-for-month
// over 1420-1450 and pins the same span end, 30 Dhu al-Hijjah 1500 AH =
// 2077-11-16; and the published Umm al-Qura New Year dates for 1447-1450
// AH match.
//
// Delivered by trait injection (SPEC §10.7), the same mechanism
// ./calarith.bit (#4076), ./bounds.bit (#4077), ./compare.bit (#4078),
// ./business.bit (#4079) and ./ldmlfmt.bit (#4080) already use, and for
// the same reason: Bit has no extension-method syntax (SPEC §10.4), a
// method exists only inside the body of the class that declares it, and a
// second `export class Date { ... }` in this module is `E0042`.
//
// Sibling of ./civil.bit, ./date.bit, ./fmt.bit and ./ldmlfmt.bit, same
// module (SPEC §17.1): `Date`, `newError`, `civilDaysFromCivil`,
// `civilFromSeconds`, `fmtPad` and ./ldmlfmt.bit's `ldmlNextToken`,
// `ldmlIsTimeSym`, `ldmlIsZoneSym`, `ldmlRejectMessage`, `ldmlYear` and
// `ldmlWeekday` are
// used here unqualified, no import and no redeclaration — `format` below
// reads the SAME token table the Gregorian formatter does, and the only
// thing it renders differently is the month name.

// The tabulated span, in Hijri years. Nothing outside it converts.
const hijriFirstYear: int = 1300
const hijriLastYear: int = 1500

// Days from the Unix epoch to 1 Muharram 1300 AH, Gregorian 1882-11-12
// (file header, ICU's `CIVIL_EPOC` plus its `yearStart(1300)`). Negative
// because that day is before 1970-01-01.
const hijriEpochDay: int = -31826

// Days in a 12-month Hijri year with no 30-day month, the base every
// year length below is built from: a set mask bit adds one day to it.
const hijriShortYear: int = 12 * 29

// One 12-bit mask per Hijri year, 1300 AH first (file header): bit 11 is
// the first month and bit 0 the twelfth, a set bit meaning 30 days.
// Transcribed from ICU4C's `UMALQURA_MONTHLENGTH`; the file header names
// the commit and the three cross-checks.
fn hijriMonthMasks(): []int {
  return []int{
    0xaaa, 0xd54, 0xec9, 0x6d4, 0x6ea, 0x36c, // 1300-1305
    0xaad, 0x555, 0x6a9, 0x792, 0xba9, 0x5d4, // 1306-1311
    0xada, 0x55c, 0xd2d, 0x695, 0x74a, 0xb54, // 1312-1317
    0xb6a, 0x5ad, 0x4ae, 0xa4f, 0x517, 0x68b, // 1318-1323
    0x6a5, 0xad5, 0x2d6, 0x95b, 0x49d, 0xa4d, // 1324-1329
    0xd26, 0xd95, 0x5ac, 0x9b6, 0x2ba, 0xa5b, // 1330-1335
    0x52b, 0xa95, 0x6ca, 0xae9, 0x2f4, 0x976, // 1336-1341
    0x2b6, 0x956, 0xaca, 0xba4, 0xbd2, 0x5d9, // 1342-1347
    0x2dc, 0x96d, 0x54d, 0xaa5, 0xb52, 0xba5, // 1348-1353
    0x5b4, 0x9b6, 0x557, 0x297, 0x54b, 0x6a3, // 1354-1359
    0x752, 0xb65, 0x56a, 0xaab, 0x52b, 0xc95, // 1360-1365
    0xd4a, 0xda5, 0x5ca, 0xad6, 0x957, 0x4ab, // 1366-1371
    0x94b, 0xaa5, 0xb52, 0xb6a, 0x575, 0x276, // 1372-1377
    0x8b7, 0x45b, 0x555, 0x5a9, 0x5b4, 0x9da, // 1378-1383
    0x4dd, 0x26e, 0x936, 0xaaa, 0xd54, 0xdb2, // 1384-1389
    0x5d5, 0x2da, 0x95b, 0x4ab, 0xa55, 0xb49, // 1390-1395
    0xb64, 0xb71, 0x5b4, 0xab5, 0xa55, 0xd25, // 1396-1401
    0xe92, 0xec9, 0x6d4, 0xae9, 0x96b, 0x4ab, // 1402-1407
    0xa93, 0xd49, 0xda4, 0xdb2, 0xab9, 0x4ba, // 1408-1413
    0xa5b, 0x52b, 0xa95, 0xb2a, 0xb55, 0x55c, // 1414-1419
    0x4bd, 0x23d, 0x91d, 0xa95, 0xb4a, 0xb5a, // 1420-1425
    0x56d, 0x2b6, 0x93b, 0x49b, 0x655, 0x6a9, // 1426-1431
    0x754, 0xb6a, 0x56c, 0xaad, 0x555, 0xb29, // 1432-1437
    0xb92, 0xba9, 0x5d4, 0xada, 0x55a, 0xaab, // 1438-1443
    0x595, 0x749, 0x764, 0xbaa, 0x5b5, 0x2b6, // 1444-1449
    0xa56, 0xe4d, 0xb25, 0xb52, 0xb6a, 0x5ad, // 1450-1455
    0x2ae, 0x92f, 0x497, 0x64b, 0x6a5, 0x6ac, // 1456-1461
    0xad6, 0x55d, 0x49d, 0xa4d, 0xd16, 0xd95, // 1462-1467
    0x5aa, 0x5b5, 0x2da, 0x95b, 0x4ad, 0x595, // 1468-1473
    0x6ca, 0x6e4, 0xaea, 0x4f5, 0x2b6, 0x956, // 1474-1479
    0xaaa, 0xb54, 0xbd2, 0x5d9, 0x2ea, 0x96d, // 1480-1485
    0x4ad, 0xa95, 0xb4a, 0xba5, 0x5b2, 0x9b5, // 1486-1491
    0x4d6, 0xa97, 0x547, 0x693, 0x749, 0xb55, // 1492-1497
    0x56a, 0xa6b, 0x52b, // 1498-1500
  }
}

// The Hijri month names, Muharram first (docs/stdlib/time.md, "Hijri
// dates"). Latin script, deliberately: Arabic-script rendering and
// Arabic-Indic digits are out of scope for this module and belong with the
// rest of internationalisation. The three-letter abbreviation `MMM` wants
// is the first three letters of each of these, so they are sliced rather
// than listed a second time.
fn hijriMonthNames(): []string {
  return []string{
    "Muharram", "Safar", "Rabi al-Awwal", "Rabi al-Thani",
    "Jumada al-Awwal", "Jumada al-Thani", "Rajab", "Shaban",
    "Ramadan", "Shawwal", "Dhu al-Qadah", "Dhu al-Hijjah",
  }
}

// Days in month `m` (1..12) of Hijri year `y`, read from `masks`. Both
// arguments are assumed already in range — every caller below checks the
// span first.
fn hijriMonthLength(masks: []int, y: int, m: int): int {
  if ((masks[y - hijriFirstYear] & (1 << (12 - m))) != 0) {
    return 30
  }
  return 29
}

// Days in Hijri year `y`: 354 plus one for each 30-day month, so 354 or
// 355 as the mask says.
fn hijriYearLength(masks: []int, y: int): int {
  let total = hijriShortYear
  let m = 1
  while (m <= 12) {
    total = total + hijriMonthLength(masks, y, m) - 29
    m = m + 1
  }
  return total
}

// Days from the Unix epoch to `y`-`m`-`d` AH. The year walk is bounded by
// the tabulated span and the month walk by 12, so both are provably
// finite; the fields are assumed already validated.
fn hijriDayOf(masks: []int, y: int, m: int, d: int): int {
  let day = hijriEpochDay
  let yy = hijriFirstYear
  while (yy < y) {
    day = day + hijriYearLength(masks, yy)
    yy = yy + 1
  }
  let mm = 1
  while (mm < m) {
    day = day + hijriMonthLength(masks, y, mm)
    mm = mm + 1
  }
  return day + d - 1
}

// The Hijri date `day` days after the Unix epoch. Fails when `day` falls
// outside the tabulated span — before 1 Muharram 1300 AH or after the
// last day of 1500 AH — naming both ends, because the caller cannot see
// the table. The early end is checked before the walk, not by it: the
// walk's first comparison is against the END of 1300 AH, which an earlier
// day also satisfies, and it would then report a negative day of a month.
fn hijriFromDay(day: int): HijriDate! {
  if (day < hijriEpochDay) {
    fail newError(hijriOutOfSpanMessage())
  }
  let masks = hijriMonthMasks()
  let start = hijriEpochDay
  let y = hijriFirstYear
  while (y <= hijriLastYear) {
    let ylen = hijriYearLength(masks, y)
    if (day < start + ylen) {
      return hijriSplitYear(masks, y, day - start)
    }
    start = start + ylen
    y = y + 1
  }
  fail newError(hijriOutOfSpanMessage())
}

// The month and day of `offset` days into Hijri year `y`, `offset` being
// 0 for its first day and less than that year's length. The walk is
// bounded by 12 and, by that precondition, always returns from inside it;
// the trailing return is the twelfth month, which the loop reaches only
// when `offset` names a day in it.
fn hijriSplitYear(masks: []int, y: int, offset: int): HijriDate {
  let left = offset
  let m = 1
  while (m < 12) {
    let mlen = hijriMonthLength(masks, y, m)
    if (left < mlen) {
      return HijriDate{ y: y, m: m, d: left + 1 }
    }
    left = left - mlen
    m = m + 1
  }
  return HijriDate{ y: y, m: 12, d: left + 1 }
}

// Why a conversion outside the tabulated span fails, in one message used
// by both directions (file header): the span is a property of the
// published data, not of this implementation, so the message says which
// data and what its ends are.
fn hijriOutOfSpanMessage(): string {
  return "hijri: outside the tabulated Umm al-Qura span, " +
    "1 Muharram 1300 AH (1882-11-12) to 30 Dhu al-Hijjah 1500 AH (2077-11-16); " +
    "the published tables end there and this module does not extrapolate"
}

// A Hijri calendar date in the Umm al-Qura variant, as a rendering of a
// Gregorian `Date` (file header). Immutable: the fields are readonly and
// unexported, so a caller reaches them only through the methods below.
export class HijriDate {
  readonly y: int
  readonly m: int
  readonly d: int

  // The Hijri year, 1300..1500.
  export year(): int {
    return this.y
  }

  // The Hijri month, 1 Muharram .. 12 Dhu al-Hijjah.
  export month(): int {
    return this.m
  }

  // The day of the Hijri month, 1..29 or 1..30 as the table says.
  export day(): int {
    return this.d
  }

  // Back to the Gregorian `Date` this renders. Total: every `HijriDate`
  // that exists was checked against the table when it was built, and the
  // whole tabulated span lies inside `Date`'s own 1..9999 year range.
  export gregorian(): Date {
    let c = civilFromSeconds(hijriDayOf(hijriMonthMasks(), this.y, this.m, this.d) * 86400, 0)
    return Date{ y: c.year, m: c.month, d: c.day }
  }

  // "1448-03-19" — the Hijri fields, zero-padded, in the same
  // year-month-day order `Date.toString()` uses. The year is always
  // exactly four digits: the span is 1300..1500.
  export toString(): string {
    return fmtPad(this.y, 4) + "-" + fmtPad(this.m, 2) + "-" + fmtPad(this.d, 2)
  }

  // `pattern` rendered with the SAME LDML tokens `Date.format` takes
  // (./ldmlfmt.bit, docs/stdlib/time.md), reading the Hijri fields and
  // the Hijri month names. `MMM` and `MMMM` give "Ramadan" where the
  // Gregorian formatter gives "September". Fails on a pattern this value
  // cannot answer: a time or zone field, `Y` or `D`, `Q`, or an unknown
  // pattern letter.
  export format(pattern: string): string! {
    return hijriRender(this, pattern)?
  }
}

// Builds a Hijri date directly, for reading one off a document. Fails
// when `year` is outside the tabulated span, `month` outside 1..12, or
// `day` outside 1..(that month's tabulated length) — `hijriDate(1445, 9,
// 30)` fails when Ramadan 1445 has 29 days, rather than rolling over into
// Shawwal.
export fn hijriDate(year: int, month: int, day: int): HijriDate! {
  if (year < hijriFirstYear || year > hijriLastYear) {
    fail newError(hijriOutOfSpanMessage())
  }
  if (month < 1 || month > 12) {
    fail newError("hijriDate: month out of range")
  }
  let dim = hijriMonthLength(hijriMonthMasks(), year, month)
  if (day < 1 || day > dim) {
    fail newError("hijriDate: day out of range")
  }
  return HijriDate{ y: year, m: month, d: day }
}

// --- formatting --------------------------------------------------------------

// `pattern` rendered against `h`. The scan is ./ldmlfmt.bit's own —
// `ldmlNextToken` splits the pattern into literal runs and (symbol,
// width) fields — so there is one token table in this module, not a
// second one written here. Every token's `next` is strictly greater than
// the index it started at, so `i` reaches `len(pattern)` in at most that
// many steps.
fn hijriRender(h: HijriDate, pattern: string): string! {
  let out = ""
  let i = 0
  while (i < len(pattern)) {
    let tok = ldmlNextToken(pattern, i)?
    if (tok.isField) {
      out = out + hijriField(h, tok.text, tok.width)?
    } else {
      out = out + tok.text
    }
    i = tok.next
  }
  return out
}

// One field, `sym` repeated `width` times. `Y` and `D` are rejected with
// ./ldmlfmt.bit's own message, for the reason it gives. A time or zone
// field fails: a `HijriDate` is a calendar day, it carries no time of day
// and no zone, the same way `d` on a `Time` fails there.
fn hijriField(h: HijriDate, sym: string, width: int): string! {
  if (sym == "Y" || sym == "D") {
    fail newError(ldmlRejectMessage(sym))
  }
  if (ldmlIsTimeSym(sym) || ldmlIsZoneSym(sym)) {
    fail newError("format: '" + sym + "' is not a field a HijriDate carries; " +
      "it is a calendar day, with no time of day and no zone")
  }
  if (sym == "y") {
    return ldmlYear(h.y, width)
  }
  if (sym == "M") {
    return hijriMonthField(h.m, width)?
  }
  if (sym == "d") {
    return fmtPad(h.d, width)
  }
  if (sym == "E") {
    return ldmlWeekday(h.gregorian().dayOfWeek(), width)?
  }
  fail newError(hijriUnknownSymbolMessage(sym))
}

// Why `Q` and every unrecognised letter fail. `Q` is rejected rather than
// computed: a quarter is a division of the Gregorian year, and
// `(month - 1) / 3 + 1` on a Hijri month names a period nobody reports
// on.
fn hijriUnknownSymbolMessage(sym: string): string {
  if (sym == "Q") {
    return "format: 'Q' is a quarter of the GREGORIAN year and names no Hijri period; " +
      "format the Date itself for a quarter"
  }
  return "format: '" + sym + "' is not an LDML pattern symbol this module implements"
}

// `M`/`MM` numeric, `MMM` the three-letter abbreviation of the Hijri
// month name, `MMMM` the full name. `MMMMM`, LDML's narrow form, is not
// implemented here for the same reason ./ldmlfmt.bit does not implement
// it: a single letter is ambiguous.
fn hijriMonthField(m: int, width: int): string! {
  if (width <= 2) {
    return fmtPad(m, width)
  }
  if (width == 3) {
    return hijriMonthNames()[m - 1][0:3]
  }
  if (width == 4) {
    return hijriMonthNames()[m - 1]
  }
  fail newError("format: 'MMMMM' and wider are not implemented; use M, MM, MMM or MMMM")
}

// --- Date --------------------------------------------------------------------

trait DateHijri {
  // This day in the Umm al-Qura Hijri calendar. Fails outside the
  // tabulated span, 1882-11-12 to 2077-11-16 (file header).
  hijri(): HijriDate! {
    return hijriFromDay(civilDaysFromCivil(this.y, this.m, this.d))?
  }
}
