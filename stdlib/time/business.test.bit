// stdlib/time/business.test.bit — `Weekend`, `Calendar` and the five
// business-day methods (./business.bit, #4079). Same module as
// ./business.bit, ./date.bit, ./naive.bit and ./zoned.bit (SPEC §19): no
// import needed to reach `date`, `zone`, `Date`, `NaiveDateTime` or
// `DateTime`.
//
// Every day-of-week below is a calendar fact this module already pins
// elsewhere, not this file's own output: 2026-09-17 is a Thursday
// (_tests_/cases/run_time_bounds.bit and ./bounds.test.bit both pin it), so
// the week used throughout is
//
//   Mon 2026-09-14  Tue 15  Wed 16  Thu 17  Fri 18  Sat 19  Sun 20  Mon 21
//
// and 1 Monday .. 7 Sunday is `Date.dayOfWeek()`'s ISO numbering
// (docs/stdlib/time.md, "Reading fields").
//
// Europe/London's 2026 fall-back is 2026-10-25T01:00:00Z, BST -> GMT
// (./zone.test.bit's header, cross-checked there against this host's
// `zdump -v`). 2026-10-25 is a Sunday — 35 days after Sunday 2026-09-20 —
// so it is both a 25-hour day and a weekend day, which is what makes it the
// right date for the `DateTime` case: the extra hour must not move the
// answer, because a business day is a calendar day (./business.bit's
// header).
//
// #4079's acceptance asks for 2026-09-19, a SATURDAY, to be a weekday under
// `weekendFriSat`. It is not: `weekendFriSat` is Friday and Saturday, so
// Saturday is a day off under both constructors. The contrast the
// acceptance is after is the day the two constructors DISAGREE on, and
// there are two of them — Friday 2026-09-18 and Sunday 2026-09-20 — so both
// are pinned below, along with Saturday 2026-09-19 being a weekend day
// under either.

// `date(y, m, d)`, for a triple this file already knows is a real calendar
// date. Every call below passes literal constants, so the failure path is
// unreachable; it panics rather than returning a substitute date, the same
// way ./compare.test.bit does — a silently substituted date would make
// every assertion downstream of it meaningless.
fn businessTestDate(y: int, m: int, d: int): Date {
  return date(y, m, d) catch e {
    panic("date(${y}, ${m}, ${d}) failed: ${e.message()}")
  }
}

// A `Calendar` on `w` with no holidays at all.
fn businessTestPlain(w: Weekend): Calendar {
  return calendar(w, []Date(0))
}

// A `Calendar` on `w` whose only holiday is `h`.
fn businessTestOneHoliday(w: Weekend, h: Date): Calendar {
  return calendar(w, append([]Date(0), h))
}

// `weekendOn(days)` for a `days` this file knows is valid.
fn businessTestWeekendOn(days: []int): Weekend {
  return weekendOn(days) catch e {
    panic("weekendOn failed: ${e.message()}")
  }
}

// True when `weekendOn(days)` fails AND its failure carries a message. The
// fallible form is the point of the test: a rejection that returned a
// usable `Weekend` would be indistinguishable from an accepted one here,
// so the success path deliberately answers false.
fn businessTestRejects(days: []int): bool {
  let w = weekendOn(days) catch e {
    return len(e.message()) > 0
  }
  return len(w.days) < 0
}

test "isWeekend and isWeekday read the Weekend, never a default" {
  let satSun = weekendSatSun()
  let friSat = weekendFriSat()
  let fri = businessTestDate(2026, 9, 18)
  let sat = businessTestDate(2026, 9, 19)
  let sun = businessTestDate(2026, 9, 20)
  assert(sat.isWeekend(satSun), "Saturday 2026-09-19 is a weekend day under weekendSatSun")
  assert(sat.isWeekend(friSat), "Saturday is a weekend day under weekendFriSat too")
  assert(!sat.isWeekday(satSun) && !sat.isWeekday(friSat), "Saturday is a weekday under neither")
  assert(sun.isWeekend(satSun), "Sunday is a weekend day under weekendSatSun")
  assert(sun.isWeekday(friSat), "Sunday is a WORKING day under weekendFriSat")
  assert(fri.isWeekday(satSun), "Friday is a working day under weekendSatSun")
  assert(fri.isWeekend(friSat), "Friday is a weekend day under weekendFriSat")
}

test "isWeekday ignores holidays entirely" {
  let mon = businessTestDate(2026, 9, 21)
  let c = businessTestOneHoliday(weekendSatSun(), mon)
  assert(mon.isWeekday(weekendSatSun()), "a holiday is still a weekday")
  assert(!mon.isBusinessDay(c), "but it is not a business day")
}

test "isBusinessDay is neither a weekend day nor a holiday" {
  let plain = businessTestPlain(weekendSatSun())
  let withHoliday = businessTestOneHoliday(weekendSatSun(), businessTestDate(2026, 9, 21))
  assert(businessTestDate(2026, 9, 18).isBusinessDay(plain), "Friday is a business day")
  assert(!businessTestDate(2026, 9, 19).isBusinessDay(plain), "Saturday is not")
  assert(!businessTestDate(2026, 9, 20).isBusinessDay(plain), "Sunday is not")
  assert(businessTestDate(2026, 9, 21).isBusinessDay(plain), "Monday is, with no holidays")
  assert(!businessTestDate(2026, 9, 21).isBusinessDay(withHoliday), "Monday is not, once it is a holiday")
}

test "next and previous business day skip the weekend" {
  let c = businessTestPlain(weekendSatSun())
  let fri = businessTestDate(2026, 9, 18)
  let mon = businessTestDate(2026, 9, 21)
  assert(fri.nextBusinessDay(c).toString() == "2026-09-21", "Friday -> Monday: ${fri.nextBusinessDay(c).toString()}")
  assert(mon.previousBusinessDay(c).toString() == "2026-09-18", "Monday -> Friday: ${mon.previousBusinessDay(c).toString()}")
  assert(
    businessTestDate(2026, 9, 19).nextBusinessDay(c).toString() == "2026-09-21",
    "from Saturday, the next business day is Monday",
  )
  assert(
    businessTestDate(2026, 9, 21).nextBusinessDay(c).toString() == "2026-09-22",
    "next is STRICTLY after: Monday -> Tuesday, not Monday",
  )
  assert(
    businessTestDate(2026, 9, 18).previousBusinessDay(c).toString() == "2026-09-17",
    "previous is STRICTLY before: Friday -> Thursday",
  )
}

test "addBusinessDays skips weekends and holidays" {
  let plain = businessTestPlain(weekendSatSun())
  let withHoliday = businessTestOneHoliday(weekendSatSun(), businessTestDate(2026, 9, 21))
  let fri = businessTestDate(2026, 9, 18)
  assert(fri.addBusinessDays(plain, 1).toString() == "2026-09-21", "Friday + 1 business day is Monday")
  assert(
    fri.addBusinessDays(withHoliday, 1).toString() == "2026-09-22",
    "a holiday on the Monday pushes it to Tuesday: ${fri.addBusinessDays(withHoliday, 1).toString()}",
  )
  assert(fri.addBusinessDays(plain, 5).toString() == "2026-09-25", "five business days on is the next Friday")
  assert(
    businessTestDate(2026, 9, 14).addBusinessDays(plain, 30).toString() == "2026-10-26",
    "30 business days from Monday 2026-09-14: ${businessTestDate(2026, 9, 14).addBusinessDays(plain, 30).toString()}",
  )
}

test "addBusinessDays goes back on a negative n" {
  let plain = businessTestPlain(weekendSatSun())
  let withHoliday = businessTestOneHoliday(weekendSatSun(), businessTestDate(2026, 9, 18))
  let mon = businessTestDate(2026, 9, 21)
  assert(mon.addBusinessDays(plain, -1).toString() == "2026-09-18", "Monday - 1 business day is Friday")
  assert(
    mon.addBusinessDays(withHoliday, -1).toString() == "2026-09-17",
    "a holiday on the Friday takes it back to Thursday: ${mon.addBusinessDays(withHoliday, -1).toString()}",
  )
  assert(mon.addBusinessDays(plain, -5).toString() == "2026-09-14", "five business days back is the previous Monday")
  assert(
    mon.addBusinessDays(plain, -1).addBusinessDays(plain, 1).toString() == "2026-09-21",
    "back one and forward one returns to a business day it started on",
  )
}

test "addBusinessDays with n == 0 returns the receiver unchanged" {
  let c = businessTestPlain(weekendSatSun())
  let sat = businessTestDate(2026, 9, 19)
  assert(sat.addBusinessDays(c, 0).toString() == "2026-09-19", "zero movement does not round a Saturday forward")
  assert(
    businessTestDate(2026, 9, 21).addBusinessDays(businessTestOneHoliday(weekendSatSun(), businessTestDate(2026, 9, 21)), 0).toString() ==
      "2026-09-21",
    "nor a holiday",
  )
}

test "a holiday on a weekend day changes nothing" {
  let plain = businessTestPlain(weekendSatSun())
  let onSat = businessTestOneHoliday(weekendSatSun(), businessTestDate(2026, 9, 19))
  let fri = businessTestDate(2026, 9, 18)
  let mon = businessTestDate(2026, 9, 21)
  assert(!businessTestDate(2026, 9, 19).isBusinessDay(onSat), "the Saturday is not a business day, as it already was not")
  assert(fri.addBusinessDays(onSat, 1).toString() == "2026-09-21", "Friday + 1 is still Monday, not Tuesday")
  assert(fri.nextBusinessDay(onSat).toString() == fri.nextBusinessDay(plain).toString(), "next is unchanged")
  assert(
    fri.differenceInBusinessDays(onSat, mon) == fri.differenceInBusinessDays(plain, mon),
    "the count is unchanged: a Saturday holiday is not carried to the Monday",
  )
}

test "differenceInBusinessDays over a full week is 5" {
  let c = businessTestPlain(weekendSatSun())
  let mon = businessTestDate(2026, 9, 14)
  let nextMon = businessTestDate(2026, 9, 21)
  assert(mon.differenceInBusinessDays(c, nextMon) == 5, "Monday to Monday: ${mon.differenceInBusinessDays(c, nextMon)}, want 5")
  assert(nextMon.differenceInBusinessDays(c, mon) == -5, "and -5 the other way round")
  assert(mon.differenceInBusinessDays(c, mon) == 0, "a day to itself is 0")
  assert(
    businessTestDate(2026, 9, 20).differenceInBusinessDays(c, businessTestDate(2026, 9, 19)) ==
      -businessTestDate(2026, 9, 19).differenceInBusinessDays(c, businessTestDate(2026, 9, 20)),
    "antisymmetric even between two weekend days",
  )
  assert(
    mon.differenceInBusinessDays(businessTestOneHoliday(weekendSatSun(), businessTestDate(2026, 9, 16)), nextMon) == 4,
    "one holiday inside the week takes it to 4",
  )
}

test "differenceInBusinessDays over a span starting on a weekend day" {
  let c = businessTestPlain(weekendSatSun())
  let sat = businessTestDate(2026, 9, 19)
  let mon = businessTestDate(2026, 9, 21)
  let fri = businessTestDate(2026, 9, 25)
  assert(sat.differenceInBusinessDays(c, mon) == 1, "Saturday to Monday is 1: ${sat.differenceInBusinessDays(c, mon)}")
  assert(mon.differenceInBusinessDays(c, sat) == -1, "and exactly -1 the other way: the earlier end is excluded, not the receiver")
  assert(sat.differenceInBusinessDays(c, fri) == 5, "Saturday to the Friday after is 5")
  assert(
    sat.differenceInBusinessDays(c, sat.addBusinessDays(c, 3)) == 3,
    "going forward the count is addBusinessDays' inverse, from a weekend day too",
  )
  assert(
    sat.differenceInBusinessDays(c, businessTestDate(2026, 9, 18)) == 0,
    "going BACK from a Saturday the two differ by one: the Friday is the excluded earlier end",
  )
  assert(sat.addBusinessDays(c, -1).toString() == "2026-09-18", "while addBusinessDays still steps to the Friday")
}

test "weekendOn covers what the two named constructors do not" {
  let sundayOnly = businessTestWeekendOn([]int{ 7 })
  let c = businessTestPlain(sundayOnly)
  assert(businessTestDate(2026, 9, 19).isBusinessDay(c), "a six-day week works the Saturday")
  assert(!businessTestDate(2026, 9, 20).isBusinessDay(c), "and rests the Sunday")
  assert(
    businessTestDate(2026, 9, 14).differenceInBusinessDays(c, businessTestDate(2026, 9, 21)) == 6,
    "so a full week is 6 business days",
  )
  let repeated = businessTestWeekendOn([]int{ 6, 6, 7 })
  assert(businessTestDate(2026, 9, 19).isWeekend(repeated), "a repeated day number is accepted and means nothing extra")
}

test "weekendOn rejects an all-seven-day week and a day out of range" {
  assert(businessTestRejects([]int{ 1, 2, 3, 4, 5, 6, 7 }), "all seven days off leaves no business day and must fail")
  assert(businessTestRejects([]int{ 0 }), "day 0 is out of range, 1 Monday .. 7 Sunday")
  assert(businessTestRejects([]int{ 8 }), "day 8 is out of range too")
  assert(businessTestRejects([]int{ 6, 7, 1, 2, 3, 4, 5 }), "the all-seven check does not depend on the order")
  assert(!businessTestRejects([]int(0)), "an empty weekend is a seven-day working week, and is allowed")
}

test "a Weekend does not change when the caller mutates the slice it passed" {
  let days = []int{ 6, 7 }
  let w = businessTestWeekendOn(days)
  days[0] = 1
  assert(businessTestDate(2026, 9, 19).isWeekend(w), "Saturday is still a weekend day")
  assert(!businessTestDate(2026, 9, 14).isWeekend(w), "and Monday is still not")
}

test "the same answers on a NaiveDateTime, from its wall-clock date" {
  let c = businessTestPlain(weekendSatSun())
  let sat = businessTestDate(2026, 9, 19).atTime(9, 30, 0) catch e {
    panic("atTime failed: ${e.message()}")
  }
  let fri = businessTestDate(2026, 9, 18).atTime(23, 59, 59) catch e {
    panic("atTime failed: ${e.message()}")
  }
  assert(sat.isWeekend(weekendSatSun()) && !sat.isWeekday(weekendSatSun()), "the Saturday wall clock is a weekend")
  assert(!sat.isBusinessDay(c), "and not a business day")
  assert(fri.isBusinessDay(c), "one second before midnight on the Friday is still the Friday")
  assert(fri.nextBusinessDay(c).toString() == "2026-09-21", "next is a Date: ${fri.nextBusinessDay(c).toString()}")
  assert(fri.previousBusinessDay(c).toString() == "2026-09-17", "previous is a Date too")
  assert(fri.addBusinessDays(c, 1).toString() == "2026-09-21", "the time of day is not carried")
  assert(fri.differenceInBusinessDays(c, businessTestDate(2026, 9, 25)) == 5, "and the count is the date's")
}

test "a DateTime across a daylight saving day answers by the calendar day" {
  let london = zone("Europe/London") catch e {
    panic("zone failed: ${e.message()}")
  }
  let c = businessTestPlain(weekendSatSun())
  let transition = businessTestDate(2026, 10, 25).atStartOfDay(london)
  let monday = businessTestDate(2026, 10, 26).atStartOfDay(london)
  assert(transition.isWeekend(weekendSatSun()), "2026-10-25, the 25-hour fall-back day, is a Sunday")
  assert(!transition.isBusinessDay(c), "so it is not a business day, extra hour or not")
  assert(
    transition.nextBusinessDay(c).toString() == "2026-10-26",
    "the next business day is the Monday: ${transition.nextBusinessDay(c).toString()}",
  )
  assert(transition.previousBusinessDay(c).toString() == "2026-10-23", "and the previous one is the Friday")
  assert(transition.addBusinessDays(c, 1).toString() == "2026-10-26", "one business day on is the Monday")
  assert(monday.isBusinessDay(c) && monday.isWeekday(weekendSatSun()), "the Monday after the transition is a business day")
  assert(
    transition.differenceInBusinessDays(c, businessTestDate(2026, 10, 30)) == 5,
    "Sunday to the Friday after is 5 business days, the same as the wall-clock Date gives",
  )
}
