// Bit standard library — time module: evaluating a TZif footer rule (#6375).
//
// ./tzrule.bit parses the POSIX TZ string of RFC 8536 §3.3 into a `TzRule`;
// this file answers the two questions the zone lookups in ./zone.bit ask of
// it, for any instant: the offset in effect, and whether daylight saving is.
//
// POSIX.1-2024 Base Definitions §8.3: the start change is written in the
// local time in effect BEFORE it (standard time) and the end change in the
// time in effect before THAT one (daylight time). So an occurrence lands at
// `local seconds - stdOff` UTC for the start and `- dstOff` for the end.
//
// Nothing here allocates and every loop is bounded by a constant.
//
// How "is DST in effect at `t`" is decided. Each change recurs once a year.
// The latest occurrence of each change at or before `t` is found; DST is
// in effect iff the latest start is later than the latest end. That holds
// in the northern pattern (start in spring, end in autumn), the southern
// one (end before start in the calendar year) and a rule whose end falls
// before its start in the same year alike, with no hemisphere branch.
// A change's occurrence in year k sits within about eight days of year k
// (a `time` of up to 167 hours, RFC 8536 §3.3.1), so with `y` the year of
// `t` the latest occurrence is in year y-2 .. y+1 and four probes suffice.

// "No occurrence found"; below any instant this module can be asked about.
const tzrNone: int = -4611686018427387904

// The Gregorian year containing day number `days` (days since the Unix
// epoch): Hinnant's civil-from-days, year part only, so a lookup allocates
// no `Civil`. Same algorithm as `civilFromSeconds` (./civil.bit).
fn tzrYearOfDays(days: int): int {
  let z = days + 719468
  let era = civilFloorDiv(z, 146097)
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  if (mp >= 10) {
    return yoe + era * 400 + 1
  }
  return yoe + era * 400
}

// The day number (days since the Unix epoch) `d` falls on in `year`.
fn tzrDayNumber(d: TzDay, year: int): int {
  if (d.kind == tzrKindMonth) {
    return tzrMonthDayNumber(d, year)
  }
  let jan1 = civilDaysFromCivil(year, 1, 1)
  if (d.kind == tzrKindZeroBased) {
    return jan1 + d.day
  }
  // `Jn` never counts February 29: from March 1 (n = 60) a leap year is one
  // day further on.
  if (d.day >= 60 && civilIsLeap(year)) {
    return jan1 + d.day
  }
  return jan1 + d.day - 1
}

// `Mm.w.d`: the d'th weekday of week w of month m; week 5 is "the last",
// which is the fourth occurrence when the month has no fifth.
fn tzrMonthDayNumber(d: TzDay, year: int): int {
  let first = civilDaysFromCivil(year, d.month, 1)
  let ahead = (d.day - civilWeekday(first) + 7) % 7
  let day = first + ahead + (d.week - 1) * 7
  if (day >= first + civilDaysInMonth(year, d.month)) {
    return day - 7
  }
  return day
}

// The UTC instant `d` occurs at in `year`, given the offset `off` (east of
// UTC) in force just before the change.
fn tzrOccurrence(d: TzDay, year: int, off: int): int {
  return tzrDayNumber(d, year) * 86400 + d.secs - off
}

// The latest occurrence of `d` at or before `t`, probing years y+1 down to
// y-2 (see the file header); `tzrNone` if there is none, which the window
// makes unreachable for any year a `Date` can hold.
fn tzrLatest(d: TzDay, off: int, y: int, t: int): int {
  let k = y + 1
  while (k >= y - 2) {
    let at = tzrOccurrence(d, k, off)
    if (at <= t) {
      return at
    }
    k = k - 1
  }
  return tzrNone
}

// Whether daylight saving is in effect at the UTC instant `t` under `r`.
fn tzrIsDstAt(r: TzRule, t: int): bool {
  if (!r.hasDst) {
    return false
  }
  if (r.alwaysDst) {
    return true
  }
  let y = tzrYearOfDays(civilFloorDiv(t + r.stdOff, 86400))
  let start = tzrLatest(r.start, r.stdOff, y, t)
  let end = tzrLatest(r.end, r.dstOff, y, t)
  return start > end
}

// The offset (seconds east of UTC) in effect at the UTC instant `t`.
fn tzrOffsetAt(r: TzRule, t: int): int {
  if (tzrIsDstAt(r, t)) {
    return r.dstOff
  }
  return r.stdOff
}
