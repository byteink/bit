// stdlib/time/date.test.bit — Date construction, validation, field accessors
// and toString (#4072). Same module as ./date.bit (SPEC §19): no import
// needed to reach `date`/`Date`.
//
// Every non-trivial expected value below (dayOfWeek, dayOfYear, quarter,
// weekOfYear) is cross-checked against Python's `datetime.date.isocalendar()`
// and `.timetuple().tm_yday` — never derived from this module's own code, so
// a self-consistent-but-wrong implementation cannot validate itself:
//   2026-09-01 -> dow=2 (Tue) doy=244 quarter=3 dim=30 weekOfYear=36
//   2000-01-01 -> weekOfYear=52 (week 52 of ISO year 1999)
//   2019-12-30 -> weekOfYear=1  (week 1 of ISO year 2020)
//   2020-12-31 -> weekOfYear=53 (2020 has 53 ISO weeks)
//   2021-01-01 -> weekOfYear=53 (still ISO year 2020)
//   0001-01-01 -> weekOfYear=1, 9999-12-31 -> weekOfYear=52

// True when `date(y, m, d)` fails.
fn dateFails(y: int, m: int, d: int): bool {
  date(y, m, d) catch _ {
    return true
  }
  return false
}

test "date rejects an out-of-range month, day or year" {
  assert(
    dateFails(2026, 2, 30),
    "date(2026,2,30) succeeded, want fail (February has 28 days in 2026)",
  )
  assert(dateFails(2026, 13, 1), "date(2026,13,1) succeeded, want fail (month out of range)")
  assert(dateFails(0, 1, 1), "date(0,1,1) succeeded, want fail (year out of range)")
  assert(dateFails(10000, 1, 1), "date(10000,1,1) succeeded, want fail (year out of range)")
}

test "date(2024, 2, 29) succeeds (2024 is a leap year)" {
  assert(!dateFails(2024, 2, 29), "date(2024,2,29) failed, want success (2024 is a leap year)")
}

test "date rejects day 0 and day 32" {
  assert(dateFails(2026, 1, 0), "date(2026,1,0) succeeded, want fail (day 0 is out of range)")
  assert(dateFails(2026, 1, 32), "date(2026,1,32) succeeded, want fail (January has 31 days)")
}

test "date rejects month 0 and month 13" {
  assert(dateFails(2026, 0, 1), "date(2026,0,1) succeeded, want fail (month 0 is out of range)")
  assert(dateFails(2026, 13, 1), "date(2026,13,1) succeeded, want fail (month 13 is out of range)")
}

test "date accepts the representable range's boundaries, year 1 and year 9999" {
  assert(
    !dateFails(1, 1, 1),
    "date(1,1,1) failed, want success (year 1 is the minimum representable year)",
  )
  assert(
    !dateFails(9999, 12, 31),
    "date(9999,12,31) failed, want success (year 9999 is the maximum representable year)",
  )
}

// --- leap years: the 4/100/400 rule, each century tested in isolation ------

test "leap year 1900: divisible by 100, not by 400 -- not a leap year" {
  let d = date(1900, 1, 1) catch e {
    assert(false, "date(1900,1,1) failed: ${e.message()}")
    return
  }
  assert(!d.isLeapYear(), "isLeapYear(1900) = true, want false")
}

test "daysInMonth: February 1900 has 28 days (not a leap year)" {
  let d = date(1900, 2, 1) catch e {
    assert(false, "date(1900,2,1) failed: ${e.message()}")
    return
  }
  assert(d.daysInMonth() == 28, "daysInMonth(1900,2) = ${d.daysInMonth()}, want 28")
}

test "date(1900, 2, 29) fails (1900 is not a leap year)" {
  assert(dateFails(1900, 2, 29), "date(1900,2,29) succeeded, want fail (1900 is not a leap year)")
}

test "leap year 2000: divisible by 100 AND by 400 -- a leap year" {
  let d = date(2000, 1, 1) catch e {
    assert(false, "date(2000,1,1) failed: ${e.message()}")
    return
  }
  assert(d.isLeapYear(), "isLeapYear(2000) = false, want true")
}

test "daysInMonth: February 2000 has 29 days (divisible by 400)" {
  let d = date(2000, 2, 1) catch e {
    assert(false, "date(2000,2,1) failed: ${e.message()}")
    return
  }
  assert(d.daysInMonth() == 29, "daysInMonth(2000,2) = ${d.daysInMonth()}, want 29")
}

test "date(2000, 2, 29) succeeds (2000 is a leap year)" {
  assert(!dateFails(2000, 2, 29), "date(2000,2,29) failed, want success (2000 is a leap year)")
}

test "leap year 2024: divisible by 4, not by 100 -- a leap year" {
  let d = date(2024, 1, 1) catch e {
    assert(false, "date(2024,1,1) failed: ${e.message()}")
    return
  }
  assert(d.isLeapYear(), "isLeapYear(2024) = false, want true")
}

// --- daysInMonth: every month, non-leap and leap ---------------------------

test "daysInMonth returns every month's length in a non-leap and a leap year" {
  let nonLeap = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
  let leap = [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
  let m = 1
  while (m <= 12) {
    let a = date(2023, m, 1) catch e {
      assert(false, "date(2023,${m},1) failed: ${e.message()}")
      return
    }
    assert(
      a.daysInMonth() == nonLeap[m - 1],
      "daysInMonth(2023,${m}) = ${a.daysInMonth()}, want ${nonLeap[m - 1]}",
    )
    let b = date(2024, m, 1) catch e {
      assert(false, "date(2024,${m},1) failed: ${e.message()}")
      return
    }
    assert(
      b.daysInMonth() == leap[m - 1],
      "daysInMonth(2024,${m}) = ${b.daysInMonth()}, want ${leap[m - 1]}",
    )
    m = m + 1
  }
}

// --- fields ------------------------------------------------------------

test "dayOfWeek numbers Monday 1 through Sunday 7" {
  let monday = date(2024, 1, 1) catch e {
    assert(false, "date(2024,1,1) failed: ${e.message()}")
    return
  }
  assert(monday.dayOfWeek() == 1, "dayOfWeek(2024-01-01) = ${monday.dayOfWeek()}, want 1 (Monday)")
  let sunday = date(2024, 1, 7) catch e {
    assert(false, "date(2024,1,7) failed: ${e.message()}")
    return
  }
  assert(sunday.dayOfWeek() == 7, "dayOfWeek(2024-01-07) = ${sunday.dayOfWeek()}, want 7 (Sunday)")
}

test "year, month, day, dayOfYear, quarter, daysInMonth, weekOfYear and toString for 2026-09-01" {
  let d = date(2026, 9, 1) catch e {
    assert(false, "date(2026,9,1) failed: ${e.message()}")
    return
  }
  assert(d.year() == 2026, "year() = ${d.year()}, want 2026")
  assert(d.month() == 9, "month() = ${d.month()}, want 9")
  assert(d.day() == 1, "day() = ${d.day()}, want 1")
  assert(d.dayOfWeek() == 2, "dayOfWeek() = ${d.dayOfWeek()}, want 2 (Tuesday)")
  assert(d.dayOfYear() == 244, "dayOfYear() = ${d.dayOfYear()}, want 244")
  assert(d.quarter() == 3, "quarter() = ${d.quarter()}, want 3")
  assert(d.daysInMonth() == 30, "daysInMonth() = ${d.daysInMonth()}, want 30")
  assert(d.weekOfYear() == 36, "weekOfYear() = ${d.weekOfYear()}, want 36")
  assert(d.toString() == "2026-09-01", "toString() = ${d.toString()}, want 2026-09-01")
}

test "toString pads a single-digit month and day" {
  let d = date(2026, 1, 5) catch e {
    assert(false, "date(2026,1,5) failed: ${e.message()}")
    return
  }
  assert(d.toString() == "2026-01-05", "toString() = ${d.toString()}, want 2026-01-05")
}

// --- weekOfYear: ISO year-boundary crossings and the representable range's
// own edges -------------------------------------------------------------

test "weekOfYear crosses an ISO year boundary in both directions" {
  let a = date(2000, 1, 1) catch e {
    assert(false, "date(2000,1,1) failed: ${e.message()}")
    return
  }
  assert(
    a.weekOfYear() == 52,
    "weekOfYear(2000-01-01) = ${a.weekOfYear()}, want 52 (week 52 of ISO year 1999)",
  )
  let b = date(2019, 12, 30) catch e {
    assert(false, "date(2019,12,30) failed: ${e.message()}")
    return
  }
  assert(
    b.weekOfYear() == 1,
    "weekOfYear(2019-12-30) = ${b.weekOfYear()}, want 1 (week 1 of ISO year 2020)",
  )
  let c = date(2020, 12, 31) catch e {
    assert(false, "date(2020,12,31) failed: ${e.message()}")
    return
  }
  assert(
    c.weekOfYear() == 53,
    "weekOfYear(2020-12-31) = ${c.weekOfYear()}, want 53 (2020 has 53 ISO weeks)",
  )
  let dd = date(2021, 1, 1) catch e {
    assert(false, "date(2021,1,1) failed: ${e.message()}")
    return
  }
  assert(
    dd.weekOfYear() == 53,
    "weekOfYear(2021-01-01) = ${dd.weekOfYear()}, want 53 (still ISO year 2020)",
  )
}

// Referenced by ./date.bit's `dateIsoP` comment: pins the day count and ISO
// week number at both ends of the representable range.
test "date_iso_week_boundaries" {
  let first = date(1, 1, 1) catch e {
    assert(false, "date(1,1,1) failed: ${e.message()}")
    return
  }
  assert(first.weekOfYear() == 1, "weekOfYear(0001-01-01) = ${first.weekOfYear()}, want 1")
  let last = date(9999, 12, 31) catch e {
    assert(false, "date(9999,12,31) failed: ${e.message()}")
    return
  }
  assert(last.weekOfYear() == 52, "weekOfYear(9999-12-31) = ${last.weekOfYear()}, want 52")
}
