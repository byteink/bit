// Bit standard library — time module, ordering and equality (#4078).
//
// `isBefore`/`isAfter`/`isSame`/`isBetween`/`compare` on all five value
// types, plus `isSameDay`/`isSameMonth`/`isSameYear` on the three calendar
// types and `isPast`/`isFuture` on the two that name an instant
// (docs/stdlib/time.md, "Comparison"). The whole-unit `differenceIn*`
// family is the sibling file ./difference.bit, same ticket. None of these
// methods fails.
//
// Delivered by trait injection (SPEC §10.7), the same mechanism
// ./calarith.bit (#4076) and ./bounds.bit (#4077) already use, and for the
// same reason: Bit has no extension-method syntax (SPEC §10.4), a method
// exists only inside the body of the class that declares it, and a second
// `export class Date { ... }` in this module is `E0042`. Each trait below
// is `use`d by one added line in its target class's own body, so the
// unexported `y`/`m`/`d`, `h`/`min`/`s`/`nanos`, `dt`/`tm`, `wall`/`z`/`off`
// fields are reachable here exactly as they are from any other file in this
// module.
//
// Sibling of ./civil.bit, ./date.bit, ./timeofday.bit, ./naive.bit,
// ./zoned.bit and ./time.bit, same module (SPEC §17.1): `Date`, `Time`,
// `NaiveDateTime`, `DateTime`, `Timestamp`, `now`, `civilDaysFromCivil`,
// `civilFloorDiv`, `civilSecondNs`/`civilMinuteNs`/`civilHourNs` and
// `zonedInstantSeconds` are used here unqualified, no import, no
// redeclaration.
//
// Three rules this file exists to hold:
//
//   COMPARISON IS SAME-TYPE ONLY. Every method below takes its own
//   receiver's type. There is no cross-type form and no overload: a caller
//   with a `Date` and a `Timestamp` converts one of them first
//   (docs/stdlib/time.md, "Comparison").
//
//   TWO `DateTime` VALUES COMPARE BY INSTANT, NOT BY WALL CLOCK. 09:00 in
//   Dubai is BEFORE 09:00 in London on the same date, because the two
//   instants are four hours apart. This is the comparison rule people get
//   wrong. A caller wanting wall clocks compares `.naive()` on both sides,
//   which is a `NaiveDateTime` comparison and lands on this file's other
//   trait.
//
//   `isBetween(lo, hi)` IS INCLUSIVE ON BOTH ENDS: `lo <= this && this <=
//   hi` (docs/stdlib/time.md, "Comparison"). `lo` above `hi` names an empty
//   range and is false for every receiver — not an error, this family is
//   total. A half-open day check writes `!t.isBefore(dayStart) &&
//   t.isBefore(nextDayStart)` instead, which is the doc's own recommendation
//   under "Boundaries".
//
// No key wider than an `int` is ever built. A `NaiveDateTime` spans years
// 1..9999, and that range in NANOSECONDS is about 2.5e20 — 28 times past
// `int`'s range — so nothing here multiplies a day count out to
// nanoseconds. Every comparison is lexicographic on a (coarse, fine) pair
// whose coarse half is a day or second count: 2932896 days, or about 2.5e11
// seconds, at the top of the range.

// -1, 0 or 1 as `a` is less than, equal to, or greater than `b` — the
// shape every `compare` in this module returns, so sorting a slice of any
// of these types reads the same (docs/stdlib/time.md, "Comparison").
fn compareInts(a: int, b: int): int {
  if (a < b) {
    return -1
  }
  if (a > b) {
    return 1
  }
  return 0
}

// -1, 0 or 1 comparing the pair `(a1, a2)` with `(b1, b2)`
// lexicographically: the coarse half decides unless it ties. Used instead
// of a single combined key wherever combining would overflow `int` (file
// header).
fn comparePairs(a1: int, a2: int, b1: int, b2: int): int {
  let coarse = compareInts(a1, b1)
  if (coarse != 0) {
    return coarse
  }
  return compareInts(a2, b2)
}

// `d` as a day count relative to 1970-01-01, `civilDaysFromCivil`'s own
// epoch (./civil.bit) — negative for dates before it. Monotone in the
// calendar, which is all any comparison here needs.
fn compareDateDays(d: Date): int {
  return civilDaysFromCivil(d.year(), d.month(), d.day())
}

// `t` as nanoseconds since midnight, 0..86399999999999. A `Time` is bounded
// by one day, so this key is exact and cannot overflow.
fn compareTimeNs(t: Time): int {
  return t.hour() * civilHourNs +
    t.minute() * civilMinuteNs +
    t.second() * civilSecondNs +
    t.nanosecond()
}

// `n`'s wall-clock reading as whole seconds relative to 1970-01-01
// 00:00:00, ignoring any zone — the coarse half of a `NaiveDateTime` key,
// with `n.nanosecond()` as the fine half. Deliberately seconds, not
// nanoseconds (file header).
fn compareNaiveSeconds(n: NaiveDateTime): int {
  return compareDateDays(n.date()) * 86400 +
    n.hour() * 3600 +
    n.minute() * 60 +
    n.second()
}

// The instant `t` names, as whole seconds since the Unix epoch — the
// coarse half of a `DateTime` key, with `t.nanosecond()` as the fine half.
// Reaches ./zoned.bit's own `zonedInstantSeconds` rather than recomputing
// the wall-clock-minus-offset arithmetic a second time.
fn compareZonedSeconds(t: DateTime): int {
  return zonedInstantSeconds(t.naive(), t.offset())
}

// -1, 0 or 1 comparing the instant `(seconds, nanos)` with `now()`
// (./time.bit). The reading is taken once and split with `civilFloorDiv`,
// not plain `/`, because `now().ns` is negative before 1970 and `/`
// truncates toward zero, which would leave the nanosecond remainder
// negative for such an instant. Compared as a pair rather than as one
// nanosecond count so that a `DateTime` outside `Timestamp`'s range —
// years 1..1677 and 2262..9999 — answers correctly instead of overflowing.
fn compareInstantToNow(seconds: int, nanos: int): int {
  let nowNs = now().ns
  let nowSeconds = civilFloorDiv(nowNs, civilSecondNs)
  return comparePairs(seconds, nanos, nowSeconds, nowNs - nowSeconds * civilSecondNs)
}

// --- Date --------------------------------------------------------------------

trait DateCompare {
  // -1, 0 or 1 as `this` is earlier than, the same day as, or later than
  // `other` (docs/stdlib/time.md, "Comparison"). The one method in this
  // trait that reads the calendar; the other five are written in terms of
  // it, so there is one ordering rule per type, not six.
  compare(other: Date): int {
    return compareInts(civilDaysFromCivil(this.y, this.m, this.d), compareDateDays(other))
  }

  // True when `this` is a strictly earlier day than `other`.
  isBefore(other: Date): bool {
    return this.compare(other) < 0
  }

  // True when `this` is a strictly later day than `other`.
  isAfter(other: Date): bool {
    return this.compare(other) > 0
  }

  // True when `this` and `other` are the same calendar day.
  isSame(other: Date): bool {
    return this.compare(other) == 0
  }

  // True when `lo <= this && this <= hi` — INCLUSIVE on both ends (file
  // header). `lo` after `hi` is an empty range and is false everywhere.
  isBetween(lo: Date, hi: Date): bool {
    return this.compare(lo) >= 0 && this.compare(hi) <= 0
  }

  // True when `this` and `other` are the same calendar day. The same
  // answer as `isSame` on a `Date`, which has nothing finer than a day;
  // it is spelled out here so the same call reads the same on all three
  // calendar types.
  isSameDay(other: Date): bool {
    return this.compare(other) == 0
  }

  // True when `this` and `other` fall in the same month of the same year.
  // 2026-01-31 and 2026-01-01 are the same month; 2025-01-31 and
  // 2026-01-31 are not.
  isSameMonth(other: Date): bool {
    return this.y == other.year() && this.m == other.month()
  }

  // True when `this` and `other` fall in the same calendar year.
  isSameYear(other: Date): bool {
    return this.y == other.year()
  }
}

// --- Time --------------------------------------------------------------------

trait TimeCompare {
  // -1, 0 or 1 as `this` is earlier in the day than, the same time of day
  // as, or later in the day than `other`. Nanoseconds included: 09:00:00
  // is before 09:00:00.000000001.
  compare(other: Time): int {
    let mine = Time{ h: this.h, min: this.min, s: this.s, nanos: this.nanos }
    return compareInts(compareTimeNs(mine), compareTimeNs(other))
  }

  // True when `this` is a strictly earlier time of day than `other`.
  isBefore(other: Time): bool {
    return this.compare(other) < 0
  }

  // True when `this` is a strictly later time of day than `other`.
  isAfter(other: Time): bool {
    return this.compare(other) > 0
  }

  // True when `this` and `other` are the same time of day, to the
  // nanosecond.
  isSame(other: Time): bool {
    return this.compare(other) == 0
  }

  // True when `lo <= this && this <= hi`, inclusive on both ends. A
  // shop open 09:00 to 17:00 includes both readings exactly.
  isBetween(lo: Time, hi: Time): bool {
    return this.compare(lo) >= 0 && this.compare(hi) <= 0
  }
}

// --- NaiveDateTime -----------------------------------------------------------

trait NaiveDateTimeCompare {
  // -1, 0 or 1 as `this`'s wall-clock reading is earlier than, the same as,
  // or later than `other`'s. Two floating readings with no zone between
  // them: this is what "compare the wall clocks" means for two `DateTime`
  // values compared through `.naive()` (file header).
  compare(other: NaiveDateTime): int {
    return comparePairs(
      compareNaiveSeconds(NaiveDateTime{ dt: this.dt, tm: this.tm }),
      this.tm.nanosecond(),
      compareNaiveSeconds(other),
      other.nanosecond(),
    )
  }

  // True when `this` reads strictly earlier than `other`.
  isBefore(other: NaiveDateTime): bool {
    return this.compare(other) < 0
  }

  // True when `this` reads strictly later than `other`.
  isAfter(other: NaiveDateTime): bool {
    return this.compare(other) > 0
  }

  // True when `this` and `other` read the same, to the nanosecond.
  isSame(other: NaiveDateTime): bool {
    return this.compare(other) == 0
  }

  // True when `lo <= this && this <= hi`, inclusive on both ends.
  isBetween(lo: NaiveDateTime, hi: NaiveDateTime): bool {
    return this.compare(lo) >= 0 && this.compare(hi) <= 0
  }

  // True when `this` and `other` fall on the same calendar day, whatever
  // the time of day. 2026-09-17T00:00 and 2026-09-17T23:59 are the same
  // day; `isSame` on the same pair is false.
  isSameDay(other: NaiveDateTime): bool {
    return this.dt.isSameDay(other.date())
  }

  // True when `this` and `other` fall in the same month of the same year.
  isSameMonth(other: NaiveDateTime): bool {
    return this.dt.isSameMonth(other.date())
  }

  // True when `this` and `other` fall in the same calendar year.
  isSameYear(other: NaiveDateTime): bool {
    return this.dt.isSameYear(other.date())
  }
}

// --- DateTime ----------------------------------------------------------------

trait DateTimeCompare {
  // -1, 0 or 1 as `this` names an earlier INSTANT than `other`, the same
  // instant, or a later one — never by wall clock, so 09:00 in Dubai
  // compares BEFORE 09:00 in London on the same date (file header;
  // docs/stdlib/time.md, "Comparison"). Two readings of the same instant
  // in different zones compare equal. To compare wall clocks instead,
  // compare `.naive()` on both sides.
  compare(other: DateTime): int {
    return comparePairs(
      zonedInstantSeconds(this.wall, this.off),
      this.wall.nanosecond(),
      compareZonedSeconds(other),
      other.nanosecond(),
    )
  }

  // True when `this` is a strictly earlier instant than `other`.
  isBefore(other: DateTime): bool {
    return this.compare(other) < 0
  }

  // True when `this` is a strictly later instant than `other`.
  isAfter(other: DateTime): bool {
    return this.compare(other) > 0
  }

  // True when `this` and `other` are the same instant, whatever zone each
  // is read in.
  isSame(other: DateTime): bool {
    return this.compare(other) == 0
  }

  // True when `lo <= this && this <= hi` by instant, inclusive on both
  // ends.
  isBetween(lo: DateTime, hi: DateTime): bool {
    return this.compare(lo) >= 0 && this.compare(hi) <= 0
  }

  // True when the two WALL CLOCKS fall on the same calendar day — each
  // read in its own zone, the same way the `add*` (./calarith.bit) and
  // `startOf*` (./bounds.bit) families work on the wall clock. Two zones
  // are rarely worth mixing here: convert one side with `withZone` first
  // when the question is about a single observer's day.
  isSameDay(other: DateTime): bool {
    return this.wall.isSameDay(other.naive())
  }

  // True when the two wall clocks fall in the same month of the same year.
  isSameMonth(other: DateTime): bool {
    return this.wall.isSameMonth(other.naive())
  }

  // True when the two wall clocks fall in the same calendar year.
  isSameYear(other: DateTime): bool {
    return this.wall.isSameYear(other.naive())
  }

  // True when this instant is strictly before `now()` (./time.bit)
  // (docs/stdlib/time.md, "Comparison"). Reads the clock on every call, so
  // a value that is future now becomes past later; a caller pinning a
  // moment holds a `Timestamp` and compares against it instead.
  isPast(): bool {
    return compareInstantToNow(zonedInstantSeconds(this.wall, this.off), this.wall.nanosecond()) < 0
  }

  // True when this instant is strictly after `now()`. `isPast()` and
  // `isFuture()` are both false in the one nanosecond they name exactly.
  isFuture(): bool {
    return compareInstantToNow(zonedInstantSeconds(this.wall, this.off), this.wall.nanosecond()) > 0
  }
}

// --- Timestamp ---------------------------------------------------------------

trait TimestampCompare {
  // -1, 0 or 1 as `this` is an earlier instant than `other`, the same, or
  // a later one. An instant carries no zone and no calendar, so this is a
  // plain nanosecond comparison.
  compare(other: Timestamp): int {
    return compareInts(this.ns, other.ns)
  }

  // True when `this` is a strictly earlier instant than `other`.
  isBefore(other: Timestamp): bool {
    return this.compare(other) < 0
  }

  // True when `this` is a strictly later instant than `other`.
  isAfter(other: Timestamp): bool {
    return this.compare(other) > 0
  }

  // True when `this` and `other` are the same instant, to the nanosecond.
  isSame(other: Timestamp): bool {
    return this.compare(other) == 0
  }

  // True when `lo <= this && this <= hi`, inclusive on both ends. A
  // half-open window — the right shape for "inside this day" — writes
  // `!t.isBefore(dayStart) && t.isBefore(nextDayStart)` instead
  // (docs/stdlib/time.md, "Boundaries").
  isBetween(lo: Timestamp, hi: Timestamp): bool {
    return this.compare(lo) >= 0 && this.compare(hi) <= 0
  }

  // True when this instant is strictly before `now()` (./time.bit).
  isPast(): bool {
    return this.ns < now().ns
  }

  // True when this instant is strictly after `now()`.
  isFuture(): bool {
    return this.ns > now().ns
  }
}
