// Bit standard library — time module, calendar arithmetic on UTC instants.
//
// Sibling of `civil.bit`; shares the module's flat namespace, so `Civil`,
// `civilFromUnix`, `unixFromCivil`, `civilFloorDiv`, `civilDaysInMonth` and
// `civilDayNs` below are the declarations that file already provides. This
// file adds no second Gregorian conversion — every function here either does
// plain nanosecond arithmetic or defers to `civil.bit` for the calendar.
//
// Every argument and result below is nanoseconds since the Unix epoch, and
// every operation is UTC.

// The UTC midnight that starts the day containing `ns`. Floors rather than
// truncates, so a negative `ns` still lands on the calendar day it belongs
// to: `startOfDay(-1)` (one nanosecond before the epoch, i.e.
// 1969-12-31T23:59:59.999999999Z) is -86400000000000
// (1969-12-31T00:00:00Z), not 0 — a plain truncating division would give 0,
// which is the *next* day's midnight. `startOfDay(0)` is `0`, unchanged.
export fn startOfDay(ns: int): int {
  return civilFloorDiv(ns, civilDayNs) * civilDayNs
}

// `ns` shifted by `n` days of exactly 86400000000000 nanoseconds each. `n`
// may be negative. Pure nanosecond arithmetic — no calendar lookup, so it is
// exact across a leap day or a year boundary by construction.
export fn addDays(ns: int, n: int): int {
  return ns + n * civilDayNs
}

// `ns` shifted by `n` calendar months, keeping the time-of-day fields
// (`hour`, `minute`, `second`, `nanosecond`) unchanged. `n` may be negative.
//
// The day is CLAMPED to the last valid day of the target month rather than
// overflowing into the next one: 2026-01-31 plus one month is 2026-02-28,
// not 2026-03-03 (contrast Go's `time.AddDate`, which normalizes and would
// give 2026-03-03; this function never does). The same clamp applies going
// backwards: 2025-12-31 minus one month is 2025-11-30, not 2025-12-01.
export fn addMonths(ns: int, n: int): int {
  let c = civilFromUnix(ns)
  let totalMonths = c.year * 12 + (c.month - 1) + n
  let newYear = civilFloorDiv(totalMonths, 12)
  let newMonth = totalMonths - newYear * 12 + 1
  let dim = civilDaysInMonth(newYear, newMonth)
  let day = c.day
  if (day > dim) {
    day = dim
  }
  let target = Civil{
    year: newYear,
    month: newMonth,
    day: day,
    hour: c.hour,
    minute: c.minute,
    second: c.second,
    nanosecond: c.nanosecond,
    weekday: 0,
    yearDay: 0,
  }
  // `target` is built from a clamped day and a month/time already known
  // valid, so this cannot fail; the catch is a safety net, not a real path.
  return unixFromCivil(target) catch e {
    panic(e.message())
  }
}
