// Bit standard library — time module, the Date type (#4072).
//
// A calendar day: a proleptic Gregorian year, month and day, with no time
// of day and no zone (docs/stdlib/time.md, "Design" / "Ranges"). `Date` is
// deliberately independent of `Timestamp` (./time.bit): a date has no
// instant and no timezone, and converting one to the other needs a `Zone`,
// which does not exist yet (#4071) — that conversion is a separate child.
//
// Sibling of ./civil.bit, same module (SPEC §17.1): `civilIsLeap`,
// `civilDaysInMonth`, `civilDaysFromCivil`, `civilWeekday`, `civilYearDay`
// and `civilFloorDiv` are civil.bit's own private helpers, used here
// unqualified with no import and no redeclaration — reusing Howard
// Hinnant's days-from-civil algorithm rather than writing a second
// Gregorian day-count. `fmtPad` is ./fmt.bit's own private zero-pad
// helper, reused the same way for toString().
//
// `atTime` below returns `NaiveDateTime` (./naive.bit, #4074), also same
// module and used unqualified. It lives here rather than on `NaiveDateTime`
// itself because Bit has no extension-method syntax (SPEC §10.4): a method
// can only be declared inside the body of the class it targets, and its
// receiver is `Date`.

// A calendar day with no time of day and no zone: an invoice value date, a
// due date, a date of birth. Two `Date` values naming the same day are
// equal field-for-field. Immutable (docs/stdlib/time.md, "Immutability"):
// fields are readonly and unexported, so a caller reaches them only
// through the methods below, and every method reads `this` without ever
// mutating it.
export class Date {
  readonly y: int
  readonly m: int
  readonly d: int

  // The calendar year, 1..9999.
  export year(): int {
    return this.y
  }

  // The calendar month, 1..12.
  export month(): int {
    return this.m
  }

  // The day of month, 1..this.daysInMonth().
  export day(): int {
    return this.d
  }

  // 1 for Monday through 7 for Sunday — ISO 8601 numbering
  // (docs/stdlib/time.md, "Reading fields"). The superseded
  // `Civil.weekday` is 0 for Sunday through 6 for Saturday; this is a
  // deliberately different numbering, not a bug.
  export dayOfWeek(): int {
    let wd = civilWeekday(civilDaysFromCivil(this.y, this.m, this.d))
    if (wd == 0) {
      return 7
    }
    return wd
  }

  // 1 for January 1 up to 365, or 366 in a leap year, for December 31.
  export dayOfYear(): int {
    return civilYearDay(this.y, this.m, this.d)
  }

  // 1..4: Jan-Mar is 1, Apr-Jun is 2, Jul-Sep is 3, Oct-Dec is 4.
  export quarter(): int {
    return (this.m - 1) / 3 + 1
  }

  // 28..31, leap years included.
  export daysInMonth(): int {
    return civilDaysInMonth(this.y, this.m)
  }

  // 1..53, ISO 8601: week 1 is the week containing the year's first
  // Thursday, and weeks start on Monday. A date in the last days of
  // December can fall in week 1 of the following ISO year, and a date in
  // the first days of January can fall in the last week (52 or 53) of the
  // previous one — the returned number is scoped to that ISO
  // week-numbering year, which need not equal `this.y`.
  export weekOfYear(): int {
    let week = civilFloorDiv(this.dayOfYear() - this.dayOfWeek() + 10, 7)
    if (week < 1) {
      return dateWeeksInIsoYear(this.y - 1)
    }
    if (week > dateWeeksInIsoYear(this.y)) {
      return 1
    }
    return week
  }

  // True when `this.y` is divisible by 4, and not by 100 unless also by
  // 400 — so 1900 is not a leap year and 2000 is.
  export isLeapYear(): bool {
    return civilIsLeap(this.y)
  }

  // "2026-09-01" — ISO 8601, zero-padded. The year is always exactly four
  // digits: the representable range is 1..9999, so it is never shorter
  // than four digits or five digits long, and never negative.
  export toString(): string {
    return fmtPad(this.y, 4) + "-" + fmtPad(this.m, 2) + "-" + fmtPad(this.d, 2)
  }

  // Combines this date with a time of day, producing the wall-clock
  // reading "this date, at this time, somewhere"
  // (docs/stdlib/time.md, "Converting between types"). Fails exactly when
  // `time(hour, minute, second)` fails (../timeofday.bit) — the field
  // bounds are that constructor's, not re-checked here.
  export atTime(hour: int, minute: int, second: int): NaiveDateTime! {
    let t = time(hour, minute, second)?
    return NaiveDateTime{ dt: this, tm: t }
  }
}

// Builds a calendar date. Fails when `year` is outside 1..9999, `month`
// outside 1..12, or `day` outside 1..(days in that month, leap years
// included) — docs/stdlib/time.md, "Constructing". `date(2026, 2, 30)`
// fails rather than rolling over into March.
export fn date(year: int, month: int, day: int): Date! {
  if (year < 1 || year > 9999) {
    fail newError("date: year out of range")
  }
  if (month < 1 || month > 12) {
    fail newError("date: month out of range")
  }
  let dim = civilDaysInMonth(year, month)
  if (day < 1 || day > dim) {
    fail newError("date: day out of range")
  }
  return Date{ y: year, m: month, d: day }
}

// The number of ISO 8601 weeks in year `y`: 53 when `dateIsoP(y) == 4`
// (1 January is a Thursday) or `dateIsoP(y - 1) == 3` (`y` is a leap year
// and 1 January is a Wednesday), 52 otherwise. Wikipedia's "ISO week date"
// derivation of the rule; verified here against nine dates spanning both
// wrap directions, cross-checked with Python's `datetime.isocalendar()`
// (2000-01-01 -> week 52 of 1999, 2019-12-30 -> week 1 of 2020,
// 2020-12-31 and 2021-01-01 -> week 53 of 2020, 9999-12-31 -> week 52,
// among others).
fn dateWeeksInIsoYear(y: int): int {
  if (dateIsoP(y) == 4 || dateIsoP(y - 1) == 3) {
    return 53
  }
  return 52
}

// `(y + floor(y/4) - floor(y/100) + floor(y/400)) mod 7`, the ISO
// week-date algorithm's parity term. `dateWeeksInIsoYear` calls this with
// `y` and `y - 1`, where `y` is `this.y` (1..9999) or `this.y - 1`
// (0..9998) — so the one case where the second argument goes negative,
// `y == 0`, only happens through `this.y == 1`'s `y - 1` branch, and
// 0001-01-01 is a Monday (Bit's own `civilWeekday`, cross-checked against
// Python's `datetime.date(1, 1, 1)`), which never takes that branch. The
// `date_iso_week_boundaries` test below pins 0001-01-01 and 9999-12-31 so a
// change to the day-count algorithm cannot silently reopen this.
fn dateIsoP(y: int): int {
  return (y + y / 4 - y / 100 + y / 400) % 7
}
