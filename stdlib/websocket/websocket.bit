// Bit standard library — websocket module: the RFC 6455 handshake, frame
// codec, and close protocol, over a plain-TCP std/net connection.
//
// A WebSocket connection begins life as an ordinary std/http request: accept
// it and read it the normal way, then hand the exchange and the parsed
// request to `upgrade` once it looks like a WebSocket handshake
// (`Upgrade: websocket`) — this module never parses a request line itself.
// `upgrade` takes ownership of the exchange's connection (`Exchange.hijack`,
// std/http) and returns a `Conn` for framing from then on; `respond()` must
// not be called on the same exchange afterward. The client side is
// symmetric: `dial` opens a plain TCP connection and performs the client
// handshake itself, given a bare host/port/path the same way std/net's own
// `dial` takes a bare host/port — no URL parsing here.
//
// Origin policy is the caller's decision, not this module's (RFC 6455
// §4.2.1 makes checking it optional and application-specific): call
// `upgrade` only after checking `header(req.headers, "Origin")` yourself —
// std/http's `header()` already reads any request header. A caller that
// does not care can call `upgrade` unconditionally.
//
// Every frame read is bounded before its payload is read, never after
// (`Limits.maxFrameBytes`), and every reassembled message is bounded the
// same way across fragments (`Limits.maxMessageBytes`,
// `Limits.maxFragments`) — the length in a frame header is attacker
// controlled and, unmasked, unbounded up to 2^63.
//
// Per-message compression (permessage-deflate, RFC 7692) is out of scope.
//
// ponytail: outgoing messages are never fragmented by this module — every
// `sendText`/`sendBinary` call is a single, unfragmented frame, which is a
// fully RFC-conformant choice (fragmentation is a sender's option, never a
// receiver's requirement). Incoming fragmented messages ARE reassembled by
// `receive`, since a peer's fragmentation choice is not this module's to
// make. `sendText`/`sendBinary`/`receive` are TLS-unaware, the same
// intentional limit std/net documents for itself; run the handshake over a
// caller-supplied encrypted transport is not supported in this version.

// A complete, reassembled application message. `kind` is one of
// `MessageText`, `MessageBinary` or `MessageClose`. `code` is meaningful
// only for `MessageClose` — the status code the peer's close frame carried,
// or `closeNoStatus` if it carried none. `data` is the message body for
// text/binary, or the close reason (already validated as UTF-8) for close.
export class Message {
  export kind: int,
  export code: int,
  export data: string,
}

export const MessageText = 1
export const MessageBinary = 2
export const MessageClose = 3

// RFC 6455 §7.4.1 status codes this module can send or report. Only the
// ones this implementation actually uses; the registry has more.
export const closeNormal = 1000
export const closeGoingAway = 1001
export const closeProtocolError = 1002
export const closeUnsupportedData = 1003
// Reserved: never sent on the wire. `receive` reports it in `Message.code`
// when the peer's close frame carried no status code at all (an empty
// payload is legal — RFC 6455 §7.1.5).
export const closeNoStatus = 1005
export const closeInvalidPayload = 1007
export const closePolicyViolation = 1008
export const closeMessageTooBig = 1009
export const closeInternalError = 1011

// The bounds every `upgrade`/`dial` caller must set. None is disableable by
// passing zero — a zero limit rejects every frame or message that would
// otherwise use it, the same policy std/http/multipart's `Limits` uses, and
// for the same reason: the peer's declared lengths are never trusted before
// they are checked against these.
export class Limits {
  // A single frame's payload, checked against the frame header's declared
  // length BEFORE that many bytes are read off the wire.
  export maxFrameBytes: int,
  // A complete message's payload, summed across every fragment as they
  // arrive — bounds a peer that sends many frames each under
  // `maxFrameBytes` but whose total is not.
  export maxMessageBytes: int,
  // The number of fragments one message may be split into, so a peer
  // sending one byte per frame forever cannot keep a reassembly running
  // without limit (Power of 10 rule 2: every loop needs a provable bound).
  export maxFragments: int,
  // How long `Conn.close()` waits for the peer's own close frame (RFC 6455
  // §7.1.1 leaves the exact bound to the implementation) before closing the
  // socket regardless — a close the peer never answers still ends the
  // connection, just once this elapses rather than the instant a reply
  // arrives. Nanoseconds.
  export closeTimeoutNs: int,
}

// Reasonable defaults: a 1 MiB single frame, a 4 MiB reassembled message, at
// most 1024 fragments per message, a 5-second close wait.
export fn defaultLimits(): Limits {
  return Limits{
    maxFrameBytes: 1 * 1024 * 1024,
    maxMessageBytes: 4 * 1024 * 1024,
    maxFragments: 1024,
    closeTimeoutNs: 5000000000,
  }
}
