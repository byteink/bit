import { repeat } from "std/strings"
import { emptyTrustStore } from "std/tls"

class handshakeScript {
  wire: string
  request: string
  pos: int
  closed: bool
  badAccept: bool
  readError: bool
  writeError: bool
  eof: bool
  oversized: bool
  oversizedTerminated: bool
  readUp(n: int): string! {
    if (this.readError) {
      fail newError("script read")
    }
    if (this.eof || this.pos >= len(this.wire)) {
      return ""
    }
    let end = this.pos + n
    if (end > len(this.wire)) {
      end = len(this.wire)
    }
    let out = this.wire[this.pos:end]
    this.pos = end
    return out
  }
  writeStr(s: string): ()! {
    if (this.writeError) {
      fail newError("script write")
    }
    this.request = s
    let accept = acceptKey(header(s, "Sec-WebSocket-Key"))
    if (this.badAccept) {
      accept = "wrong"
    }
    this.wire = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\n" +
      "Connection: Upgrade\r\nSec-WebSocket-Accept: ${accept}\r\n\r\n\x81\x02hi"
    if (this.oversized) {
      this.wire = repeat("x", maxHandshakeBytes + 1)
    }
    if (this.oversizedTerminated) {
      let prefix = this.wire[:indexOf(this.wire, "\r\n\r\n")] + "\r\nX-Pad: "
      this.wire = prefix + repeat("x", maxHandshakeBytes + 1 - len(prefix) - 4) + "\r\n\r\n"
      assert(len(this.wire) == maxHandshakeBytes + 1, "terminated response is one byte over cap")
    }
  }
  writeBytes(b: []byte): ()! { this.writeStr(string(b))? }
  shut() { this.closed = true }
  forceClose() { this.closed = true }
  peer(): string { return "" }
  unread(extra: string) {
    this.wire = extra + this.wire[this.pos:]
    this.pos = 0
  }
  setIdleDeadline(deadlineNs: int) {}
}

test "client handshake keeps the first coalesced frame and wire authority" {
  let s = handshakeScript{}
  let c = finishDial(s, "[::1]:9000", "/notes?draft=1", defaultLimits()) catch e {
    assert(false, e.message())
    return
  }
  assert(contains(s.request, "GET /notes?draft=1 HTTP/1.1\r\nHost: [::1]:9000\r\n"), s.request)
  let m = c.receive() catch e {
    assert(false, e.message())
    return
  }
  assert(m.kind == MessageText && m.data == "hi", "coalesced first frame")
  assert(!s.closed, "returned connection owns stream")
  s.shut()
}

fn expectHandshakeClosed(s: handshakeScript) {
  let failed = false
  finishDial(s, "localhost:80", "/", defaultLimits()) catch e {
    failed = true
    if (s.oversized || s.oversizedTerminated) {
      assert(contains(e.message(), "handshake response exceeds"), e.message())
    }
  }
  assert(failed && s.closed, "handshake failure must close the owned stream")
}

test "client handshake accepts valid headers exactly at the cap" {
  let key = "0123456789abcdef"
  let s = handshakeScript{ oversizedTerminated = true }
  s.writeStr("GET / HTTP/1.1\r\nSec-WebSocket-Key: ${key}\r\n\r\n") catch e {
    assert(false, e.message())
    return
  }
  s.wire = s.wire[:len(s.wire) - 5] + "\r\n\r\n"
  let raw = readHandshakeResponse(s) catch e {
    assert(false, e.message())
    return
  }
  assert(len(raw) == maxHandshakeBytes, "exact cap")
  validateHandshakeResponse(raw, key) catch e {
    assert(false, e.message())
  }
}

test "client handshake closes after accept EOF read write and size failures" {
  expectHandshakeClosed(handshakeScript{ badAccept = true })
  expectHandshakeClosed(handshakeScript{ eof = true })
  expectHandshakeClosed(handshakeScript{ readError = true })
  expectHandshakeClosed(handshakeScript{ writeError = true })
  expectHandshakeClosed(handshakeScript{ oversized = true })
  expectHandshakeClosed(handshakeScript{ oversizedTerminated = true })
}

fn expectDialTarget(host: string, port: int, path: string, authority: string, resource: string) {
  let (_, _, r, _, a) = dialTarget(host, port, path) catch e {
    assert(false, e.message())
    return
  }
  assert(a == authority && r == resource, "${host} target")
}

test "legacy and URL dial targets validate before connection" {
  expectDialTarget("localhost", 80, "/notes", "localhost:80", "/notes")
  expectDialTarget("127.0.0.1", 9000, "", "127.0.0.1:9000", "/")
  expectDialTarget("::1", 9000, "/", "[::1]:9000", "/")
  expectDialTarget("[::1]", 9000, "/", "[::1]:9000", "/")
  expectDialTarget("wss://host/notes", 443, "/notes", "host:443", "/notes")
  let failed = false
  dialTarget("localhost", -1, "") catch _ {
    failed = true
  }
  assert(failed, "missing bare port")
  failed = false
  dialTarget("localhost", 0, "") catch _ {
    failed = true
  }
  assert(failed, "zero bare port")
  failed = false
  dialTarget("ws://host/", 81, "") catch _ {
    failed = true
  }
  assert(failed, "conflicting port")
  failed = false
  dialTarget("ws://host/", -1, "/notes") catch _ {
    failed = true
  }
  assert(failed, "conflicting resource")
}

test "plaintext config rejects before dial and TLS config is copied" {
  let cfg = TlsConfig(emptyTrustStore(), "localhost", ["h2"], true, 1800000000)
  let copy = freshTlsConfig(Option.Some(cfg))
  assert(copy.serverName == cfg.serverName && copy.nowUnix == cfg.nowUnix, "name and time")
  assert(copy.insecureSkipVerify && len(copy.roots.roots) == 0, "verification and roots")
  assert(copy.alpn[0] == "http/1.1" && cfg.alpn[0] == "h2", "ALPN copy")
  let failed = false
  dial("ws://invalid.invalid/", config = Option.Some(cfg)) catch e {
    failed = contains(e.message(), "TLS config requires wss")
  }
  assert(failed, "reject config before DNS")
}

test "bare dial host and resource reject delimiter and header injection" {
  let hosts = ["host/path", "host?query", "u@host", "host\r\nX: x"]
  let i = 0
  while (i < len(hosts)) {
    let failed = false
    dialTarget(hosts[i], 80, "") catch _ {
      failed = true
    }
    assert(failed, "bad bare host")
    i = i + 1
  }
  let failed = false
  dialTarget("host", 80, "relative") catch _ {
    failed = true
  }
  assert(failed, "relative path")
  failed = false
  dialTarget("host", 80, "/\r\nX: x") catch _ {
    failed = true
  }
  assert(failed, "bad bare path")
}
