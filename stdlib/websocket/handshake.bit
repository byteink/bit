// Bit standard library — websocket module: the RFC 6455 §4 handshake, both
// directions.
//
// Server side (`upgrade`/`upgradeTls`, #6172) takes an already-read std/http
// `Request` and the `Exchange`/`TlsExchange` it came from; client side
// (`dial`) opens the TCP or TLS connection and speaks the client half.
// Neither touches framing — that starts only once a `Conn` exists (conn.bit).

import { Exchange, TlsExchange, Request, header, ByteStream, parseWebSocketUrl } from "std/http"
// RFC 8441 (#6153): the HTTP/2 side. `Conn` is this module's own class
// (conn.bit), so std/http2's is aliased, as are its `Request`/`Stream`.
import {
  Conn as H2Conn, Request as H2Request, HeaderField as H2HeaderField, Stream as H2StreamHandle,
} from "std/http2"
import { dial as tcpDial } from "std/net"
import { dial as tlsDial, TlsConfig } from "std/tls"
import { systemRoots, bundled } from "std/crypto"
import { digest, encodeBase64, decodeBase64, Sha1 } from "std/crypto"
import { toLower, trimSpace, split, indexOf, contains, hasPrefix } from "std/strings"

// RFC 6455 §1.3's fixed GUID, concatenated onto the client's key before
// hashing. Exact by construction: this file's own accept-key test pins the
// RFC's own worked example (§1.3), so a transposed character here fails
// that test rather than only a real client's handshake.
const wsGuid = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

// The value that must appear as `Sec-WebSocket-Accept`, derived from the
// client's `Sec-WebSocket-Key` (RFC 6455 §1.3, §4.2.2 item 5.4): SHA-1 of
// the key concatenated with the fixed GUID, base64-encoded.
export fn acceptKey(clientKey: string): string {
  return encodeBase64(digest(Sha1(), []byte(clientKey + wsGuid)))
}

// True if `headerValue` (a comma-separated list, e.g. `Connection`'s) has
// `token` as one of its elements, compared case-insensitively after
// trimming surrounding whitespace — RFC 9110 §5.6.1's list syntax.
fn containsToken(headerValue: string, token: string): bool {
  let parts = split(headerValue, ",")
  let i = 0
  while (i < len(parts)) {
    if (toLower(trimSpace(parts[i])) == token) {
      return true
    }
    i = i + 1
  }
  return false
}

// RFC 6455 §4.2.1's server-side request checks. Origin is deliberately not
// checked here — see the module doc comment (websocket.bit): the caller
// reads `header(req.headers, "Origin")` itself, before calling `upgrade`.
fn validateUpgradeRequest(req: Request): ()! {
  if (req.method != "GET") {
    fail newError("websocket: upgrade request method must be GET")
  }
  if (!containsToken(header(req.headers, "Connection"), "upgrade")) {
    fail newError("websocket: missing Connection: Upgrade")
  }
  if (toLower(header(req.headers, "Upgrade")) != "websocket") {
    fail newError("websocket: missing Upgrade: websocket")
  }
  if (header(req.headers, "Sec-WebSocket-Version") != "13") {
    fail newError("websocket: unsupported Sec-WebSocket-Version")
  }
  let decoded = decodeBase64(header(req.headers, "Sec-WebSocket-Key")) catch _ {
    fail newError("websocket: Sec-WebSocket-Key is not valid base64")
  }
  if (len(decoded) != 16) {
    fail newError("websocket: Sec-WebSocket-Key must decode to 16 bytes")
  }
}

// RFC 6455 §4.1's `101` reply and the resulting `Conn`, shared by `upgrade`
// and `upgradeTls` (#6172) so the response text and the construction are
// written once — `nc` is already the right transport either way, `std/
// http`'s `byteStream` (transport.bit).
fn finishUpgrade(nc: byteStream, req: Request, limits: Limits): Conn! {
  let accept = acceptKey(header(req.headers, "Sec-WebSocket-Key"))
  let resp = "HTTP/1.1 101 Switching Protocols\r\n" +
    "Upgrade: websocket\r\n" +
    "Connection: Upgrade\r\n" +
    "Sec-WebSocket-Accept: ${accept}\r\n\r\n"
  nc.writeStr(resp)?
  return Conn{
    nc = nc, isServer = true, limits = limits, buf = "", closed = false, sentClose = false,
  }
}

// Completes the server-side handshake on `ex`/`req` — a request `read()`
// already returned, checked to look like a WebSocket upgrade — and returns
// a `Conn` ready for `sendText`/`sendBinary`/`receive`. Takes ownership of
// `ex`'s connection (`Exchange.hijackStream`, std/http): do not call
// `ex.respond` afterward, on success or failure alike; a failure here means
// the caller still owns `ex` and should answer it (e.g.
// `ex.respond(respond(400, ""))`).
export fn upgrade(ex: Exchange, req: Request, limits: Limits): Conn! {
  validateUpgradeRequest(req)?
  return finishUpgrade(ex.hijackStream(), req, limits)?
}

// #6172: `upgrade`'s exact TLS mirror — the WebSocket handshake over
// TLS+HTTP/1.1 (ALPN "http/1.1"; a request negotiated "h2" takes `upgradeH2`,
// RFC 8441, #6153). Takes ownership of `ex`'s
// connection (`TlsExchange.hijackStream`) the same way `upgrade` does.
export fn upgradeTls(ex: TlsExchange, req: Request, limits: Limits): Conn! {
  validateUpgradeRequest(req)?
  return finishUpgrade(ex.hijackStream(), req, limits)?
}

// RFC 8441 §5 server-side request checks for a WebSocket over HTTP/2. `req` is the
// request std/http hands a `tunnel` handler (`h2glueTunnel`): the extended CONNECT
// whose `:protocol` is "websocket", presented as the GET its RFC 6455 handshake
// replaces. There is no Upgrade, Connection, Sec-WebSocket-Key or -Accept to
// check: the `:protocol` pseudo-header superseded them (§5), so only the version
// is left of RFC 6455 §4.2.1's list. Origin stays the caller's, as for `upgrade`.
fn validateTunnelRequest(req: Request): ()! {
  if (req.method != "GET") {
    fail newError("websocket: not an RFC 8441 WebSocket request (:protocol must be websocket)")
  }
  if (header(req.headers, "Sec-WebSocket-Version") != "13") {
    fail newError("websocket: unsupported Sec-WebSocket-Version")
  }
}

// RFC 8441's server-side handshake: the WebSocket over an HTTP/2 stream, the
// counterpart of `upgrade` for a request that arrived as an extended CONNECT.
// `s` is the unaccepted stream std/http handed the route (`serveHijackableTlsOn`'s
// `tunnel` handler), `req` its request. Validates `req`, answers 200 on `s`
// (`Stream.acceptExtendedConnect`) and returns a `Conn` for framing from then on:
// the same `Conn`, the same `sendText`/`receive`/`close`, as over HTTP/1.1 — the
// tunnel is a `ByteStream` (std/http) like any other. A failure before the 200
// leaves `s` unanswered, so the caller may still return an ordinary `Response`
// to refuse; returning from the handler after success ends the stream.
export fn upgradeH2(s: H2StreamHandle, req: Request, limits: Limits): Conn! {
  validateTunnelRequest(req)?
  let t = s.acceptExtendedConnect()?
  return Conn{
    nc = ByteStream(h2 = Option.Some(t))?,
    isServer = true,
    limits = limits,
    buf = "",
    closed = false,
    sentClose = false,
  }
}

// The client side of RFC 8441 §5: open a WebSocket tunnel on the HTTP/2
// connection `hc` (std/http2, whose peer must have advertised
// SETTINGS_ENABLE_CONNECT_PROTOCOL) with a CONNECT request carrying
// `:protocol websocket` for `authority`/`path` over https, and return a `Conn`
// ready for `sendText`/`sendBinary`/`receive`. `origin` is sent as the Origin
// header when non-empty. Frames are masked, as RFC 6455 §5.3 requires of a client.
export fn dialH2(
  hc: H2Conn,
  authority: string,
  path: string,
  origin: string,
  limits: Limits,
): Conn! {
  let req = H2Request("CONNECT", authority, path)
  req.protocol = "websocket"
  req.headers = append(
    req.headers,
    H2HeaderField{ name = "sec-websocket-version", value = "13", sensitive = false },
  )
  if (origin != "") {
    req.headers = append(
      req.headers,
      H2HeaderField{ name = "origin", value = origin, sensitive = false },
    )
  }
  let (_, t) = hc.openTunnel(req)?
  return Conn{
    nc = ByteStream(h2 = Option.Some(t))?,
    isServer = false,
    limits = limits,
    buf = "",
    closed = false,
    sentClose = false,
  }
}

// Header block size cap for the client-side handshake response, checked
// while still accumulating it — the same defense std/http's own
// `readThroughHeaderEnd` uses against a peer that never sends a
// terminator: deny by default rather than growing the buffer without limit.
const maxHandshakeBytes = 65536

// Reads off `nc` until the blank line ending the response headers has
// arrived, returning everything read so far (status line, headers, and any
// bytes that arrived with them — a server MUST NOT send frame data before
// this response completes, per RFC 6455 §4.1, so in practice there are
// none). Bounded by `maxHandshakeBytes`; a peer that never completes the
// response, or sends an implausibly large one, fails rather than growing
// this buffer forever (Power of 10 rule 2).
fn readHandshakeResponse(nc: byteStream): string! {
  let buf = ""
  while (len(buf) <= maxHandshakeBytes) {
    let chunk = nc.readUp(4096)?
    if (len(chunk) == 0) {
      fail newError("websocket: connection closed during the handshake")
    }
    buf = buf + chunk
    let end = indexOf(buf, "\r\n\r\n")
    if (end >= 0) {
      if (end + 4 > maxHandshakeBytes) {
        fail newError("websocket: handshake response exceeds ${maxHandshakeBytes} bytes")
      }
      return buf
    }
  }
  fail newError("websocket: handshake response exceeds ${maxHandshakeBytes} bytes")
}

// RFC 6455 §4.1's client-side response checks: 101 status, the same
// `Upgrade`/`Connection` tokens the server must send, and — the one check
// that actually proves this server ran the real handshake rather than just
// echoing headers — `Sec-WebSocket-Accept` matching what `acceptKey` derives
// from the key this client sent.
fn validateHandshakeResponse(raw: string, key: string): ()! {
  let eol = indexOf(raw, "\r\n")
  let statusLine = raw
  if (eol >= 0) {
    statusLine = raw[0:eol]
  }
  if (!contains(statusLine, " 101 ")) {
    fail newError("websocket: handshake failed: ${statusLine}")
  }
  if (toLower(header(raw, "Upgrade")) != "websocket") {
    fail newError("websocket: response missing Upgrade: websocket")
  }
  if (!containsToken(header(raw, "Connection"), "upgrade")) {
    fail newError("websocket: response missing Connection: Upgrade")
  }
  if (header(raw, "Sec-WebSocket-Accept") != acceptKey(key)) {
    fail newError("websocket: Sec-WebSocket-Accept does not match this request's key")
  }
}

// Any bytes already read past the header terminator — see
// `readHandshakeResponse`'s doc comment on why there normally are none.
fn leftoverAfterHeaders(raw: string): string {
  let idx = indexOf(raw, "\r\n\r\n")
  if (idx < 0) {
    return ""
  }
  return raw[idx + 4:len(raw)]
}

// URL options must agree before any connection opens; bare-host calls retain
// their existing port/path positions (#6178).
export fn dial(
  host: string,
  port: int = -1,
  path: string = "",
  limits: Limits = defaultLimits(),
  config: Option<TlsConfig> = Option.None,
): Conn! {
  let (name, targetPort, resource, secure, authority) = dialTarget(host, port, path)?
  if (!secure && isSome(config)) {
    fail newError("websocket: TLS config requires wss")
  }
  let nc = dialStream(name, targetPort, secure, config)?
  return finishDial(nc, authority, resource, limits)?
}

fn dialTarget(host: string, port: int, path: string): (string, int, string, bool, string)! {
  let url = host
  if (indexOf(host, "://") < 0) {
    url = bareWebSocketUrl(host, port, path)?
  }
  let target = parseWebSocketUrl(url)?
  let (_, targetPort, resource, _, _) = target
  if (port != -1 && port != targetPort) {
    fail newError("websocket: port conflicts with URL")
  }
  if (path != "" && path != resource) {
    fail newError("websocket: path conflicts with URL")
  }
  return target
}

fn freshTlsConfig(config: Option<TlsConfig>): TlsConfig {
  if (isSome(config)) {
    let cfg = unwrap(config)
    return TlsConfig(cfg.roots, cfg.serverName, ["http/1.1"], cfg.insecureSkipVerify, cfg.nowUnix)
  }
  let roots = systemRoots() catch _ {
    bundled()
  }
  return TlsConfig(roots, alpn = ["http/1.1"])
}

fn dialStream(host: string, port: int, secure: bool, config: Option<TlsConfig>): byteStream! {
  if (!secure) {
    let c = tcpDial(host, port)?
    return ByteStream(conn = Option.Some(c)) catch e {
      c.close()
      fail e
    }
  }
  let c = tlsDial(host, port, freshTlsConfig(config))?
  if (c.alpnProtocol() != "" && c.alpnProtocol() != "http/1.1") {
    c.close()
    fail newError("websocket: unexpected negotiated ALPN")
  }
  return ByteStream(tls = Option.Some(c)) catch e {
    c.close()
    fail e
  }
}

fn finishDial(nc: byteStream, authority: string, path: string, limits: Limits): Conn! {
  let key = encodeBase64(randomBytes(16))
  let reqText = "GET ${path} HTTP/1.1\r\n" +
    "Host: ${authority}\r\n" +
    "Upgrade: websocket\r\n" +
    "Connection: Upgrade\r\n" +
    "Sec-WebSocket-Key: ${key}\r\n" +
    "Sec-WebSocket-Version: 13\r\n\r\n"
  let raw = dialHandshake(nc, reqText, key) catch e {
    nc.shut()
    fail e
  }
  return Conn{
    nc = nc, isServer = false, limits = limits,
    buf = leftoverAfterHeaders(raw), closed = false, sentClose = false,
  }
}

fn dialHandshake(nc: byteStream, reqText: string, key: string): string! {
  nc.writeStr(reqText)?
  let raw = readHandshakeResponse(nc)?
  validateHandshakeResponse(raw, key)?
  return raw
}

fn bareWebSocketUrl(host: string, port: int, path: string): string! {
  if (indexOf(host, "/") >= 0 || indexOf(host, "?") >= 0) {
    fail newError("websocket: bare host must not contain a resource")
  }
  if (port < 1 || port > 65535) {
    fail newError("websocket: bare host requires a valid port")
  }
  let name = host
  if (indexOf(name, ":") >= 0 && !hasPrefix(name, "[")) {
    name = "[${name}]"
  }
  let resource = path
  if (resource == "") {
    resource = "/"
  }
  if (!hasPrefix(resource, "/")) {
    fail newError("websocket: path must start with /")
  }
  return "ws://${name}:${port}${resource}"
}
