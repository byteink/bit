// stdlib/tz/tz.test.bit — the checked-in IANA database (#5098). Same
// module as ./data.bit (SPEC §17.1): `data` and `release` are reached here
// unqualified, no import, no redeclaration.
//
// `stdlib/time/extend.test.bit` already covers `extend()`'s CAS/rejection
// mechanics with a hand-built blob, including the documented deviation for
// "host zoneinfo made unreadable" (root-owned and shared on this box, so
// the fallback path is exercised with a name the host has no file for
// instead). This file is about the REAL generated ./data.bit: that it
// carries the host's own TZif bytes unmodified, and that the end-to-end
// call site the ticket names — `time.extend(tz.data)` — resolves real
// zones correctly (host-backed here, since Asia/Dubai and America/New_York
// are both zones this host has, so host-wins never diverts to the blob;
// the byte-for-byte containment check below is what pins the blob's own
// content, independent of that).
//
// Real transition used below, cross-checked against this host's own
// `zdump -v America/New_York` on 2026-09-12 (release 2026c, never derived
// from this module's own output): the 2026 spring-forward is exactly
// 2026-03-08T07:00:00Z — EST (-18000) the second before, EDT (-14400) at
// and after.
//
// The third test above needs no host at all: it decodes the checked-in blob
// via the real `time.extend`/`zone` call site and checks the result against
// hardcoded transition offsets, so it is the self-consistency proof that
// runs everywhere. The other two compare the blob against the RUNNING
// host's own zoneinfo and so can only run where that host data exists;
// #5413 found the Linux gate image has zone files (transitively pulled in
// by another package) but no `+VERSION` marker and a different IANA
// release, so both skip explicitly rather than misreport a missing/mismatched
// host as a corrupt blob.

import * as fs from "std/fs"
import * as strings from "std/strings"
import { Second, Timestamp, extend, zone } from "std/time"

// `/usr/share/zoneinfo/+VERSION` is the IANA release tarball's own marker
// file -- present on a host whose zoneinfo came from a real IANA release
// (macOS, or a from-source Linux install), absent from Debian's `tzdata`
// package, which ships the zone files without it (#5413). Its presence is
// what the two host-comparison tests below actually need: a zoneinfo
// DIRECTORY existing is not enough, since Debian's carries no release id to
// compare `tz.release` against and is very likely a different IANA release
// from whatever this blob was generated from anyway.
fn hostZoneinfoAvailable(): bool {
  return fs.exists("/usr/share/zoneinfo/+VERSION")
}

test "data carries Asia/Dubai's and America/New_York's host TZif payload, byte for byte" {
  if (!hostZoneinfoAvailable()) {
    println(
        "tz: skipping host byte-for-byte comparison — " +
        "/usr/share/zoneinfo/+VERSION not present (no host IANA release to compare against)",
    )
    return
  }
  let dubai = fs.readFile("/usr/share/zoneinfo/Asia/Dubai") catch e {
    assert(false, "reading host Asia/Dubai: ${e.message()}")
    return
  }
  let newYork = fs.readFile("/usr/share/zoneinfo/America/New_York") catch e {
    assert(false, "reading host America/New_York: ${e.message()}")
    return
  }
  assert(strings.contains(data, dubai), "tz.data does not contain Asia/Dubai's host TZif bytes")
  assert(
    strings.contains(data, newYork),
    "tz.data does not contain America/New_York's host TZif bytes",
  )
}

test "release is non-empty and equals the host's IANA +VERSION" {
  assert(len(release) > 0, "tz.release is empty")
  if (!hostZoneinfoAvailable()) {
    println(
        "tz: skipping host release comparison — " +
        "/usr/share/zoneinfo/+VERSION not present (no host IANA release to compare against)",
    )
    return
  }
  let version = fs.readFile("/usr/share/zoneinfo/+VERSION") catch e {
    assert(false, "reading /usr/share/zoneinfo/+VERSION: ${e.message()}")
    return
  }
  assert(release == version, "tz.release = ${release}, want the host's +VERSION = ${version}")
}

test "time.extend(tz.data) resolves Asia/Dubai to 14400 and America/New_York DST-correct on both sides of a transition" {
  assert(extend(data), "time.extend(tz.data) rejected the checked-in database")

  let dubai = zone("Asia/Dubai") catch e {
    assert(false, "zone(Asia/Dubai): ${e.message()}")
    return
  }
  let dubaiOffset = Timestamp{ ns = 1700000000 * Second }.inZone(dubai).offset()
  assert(dubaiOffset == 14400, "Asia/Dubai offset = ${dubaiOffset}, want 14400")

  let ny = zone("America/New_York") catch e {
    assert(false, "zone(America/New_York): ${e.message()}")
    return
  }
  let before = Timestamp{ ns = 1772953199 * Second }.inZone(ny).offset()
  let after = Timestamp{ ns = 1772953200 * Second }.inZone(ny).offset()
  assert(
    before == -18000,
    "America/New_York offset before the 2026 spring-forward = ${before}, want -18000",
  )
  assert(
    after == -14400,
    "America/New_York offset after the 2026 spring-forward = ${after}, want -14400",
  )
}
