// The generated database is a pinned snapshot of its generator source (#5098).
// Host payloads are comparable only when the exact release markers agree.
// stdlib/time/extend.test.bit parses the real bundled payloads directly,
// without zone()'s host-first lookup, and pins their transition offsets.

import * as fs from "std/fs"
import * as strings from "std/strings"

fn hostSnapshotComparable(snapshotRelease: string, hostRelease: string): bool {
  return len(hostRelease) > 0 && snapshotRelease == hostRelease
}

fn hostSnapshotPayloadMatches(
  snapshotRelease: string,
  hostRelease: string,
  blob: string,
  payload: string,
): bool {
  if (!hostSnapshotComparable(snapshotRelease, hostRelease)) {
    return true
  }
  return strings.contains(blob, payload)
}

test "host comparison requires the same release and still rejects changed payloads" {
  let snapshot = "2026c\n"
  let payload = "TZif payload"
  assert(hostSnapshotComparable(snapshot, snapshot), "matching release is comparable")
  assert(!hostSnapshotComparable(snapshot, "2026e\n"), "newer host release is incomparable")
  assert(!hostSnapshotComparable(snapshot, "2026b\n"), "older host release is incomparable")
  assert(!hostSnapshotComparable(snapshot, ""), "missing host release is incomparable")
  assert(
    hostSnapshotPayloadMatches(snapshot, snapshot, payload, payload),
    "matching bytes rejected",
  )
  assert(
    !hostSnapshotPayloadMatches(snapshot, snapshot, "corrupt", payload),
    "same-release corruption accepted",
  )
  assert(
    hostSnapshotPayloadMatches(snapshot, "2026e\n", "different", payload),
    "newer host compared",
  )
  assert(hostSnapshotPayloadMatches(snapshot, "", "different", payload), "missing host compared")
}

test "release is a non-empty IANA snapshot release" {
  let id = strings.trimSpace(release)
  assert(len(id) >= 5, "tz.release is not an IANA release")
  let i = 0
  while (i < 4) {
    assert(id[i] >= '0' && id[i] <= '9', "tz.release year is not numeric")
    i = i + 1
  }
  while (i < len(id)) {
    assert(id[i] >= 'a' && id[i] <= 'z', "tz.release suffix is not lowercase")
    i = i + 1
  }
}

test "data contains host TZif payloads when the exact IANA release matches" {
  if (!fs.exists("/usr/share/zoneinfo/+VERSION")) {
    println("tz: skipping host payload comparison: no host IANA +VERSION marker")
    return
  }
  let version = fs.readFile("/usr/share/zoneinfo/+VERSION") catch e {
    assert(false, "reading /usr/share/zoneinfo/+VERSION: ${e.message()}")
    return
  }
  if (!hostSnapshotComparable(release, version)) {
    println("tz: skipping host payload comparison: snapshot ${strings.trimSpace(release)}, host ${strings.trimSpace(version)}")
    return
  }
  let dubai = fs.readFile("/usr/share/zoneinfo/Asia/Dubai") catch e {
    assert(false, "reading host Asia/Dubai: ${e.message()}")
    return
  }
  let newYork = fs.readFile("/usr/share/zoneinfo/America/New_York") catch e {
    assert(false, "reading host America/New_York: ${e.message()}")
    return
  }
  assert(
    hostSnapshotPayloadMatches(release, version, data, dubai),
    "tz.data lacks Asia/Dubai's host bytes",
  )
  assert(
    hostSnapshotPayloadMatches(release, version, data, newYork),
    "tz.data lacks America/New_York's host bytes",
  )
}
