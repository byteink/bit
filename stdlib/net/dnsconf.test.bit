// stdlib/net/dnsconf.test.bit — the DNS policy std/net owns (#6350): resolv.conf's
// `options timeout:N attempts:N` over glibc's defaults, and proof that the policy
// reaches the runtime (a nameserver that never answers is given up on after
// exactly the budget std/net handed down, not a number the runtime keeps).
//
// `monotonic`/`since` come from net.test.bit's `std/time` import (imports are
// module-scoped).

test "parseDnsPolicy defaults are glibc's: 5 s windows, 2 attempts" {
  let p = parseDnsPolicy("nameserver 1.1.1.1\n")
  assert(p.timeoutMs == 5000, "timeout ${p.timeoutMs}ms, want 5000")
  assert(p.attempts == 2, "attempts ${p.attempts}, want 2")
  assert(p.servers == 1, "servers ${p.servers}, want 1")
}

test "parseDnsPolicy reads options timeout and attempts" {
  let p = parseDnsPolicy("nameserver 1.1.1.1\noptions timeout:3 attempts:4\n")
  assert(p.timeoutMs == 3000, "timeout ${p.timeoutMs}ms, want 3000")
  assert(p.attempts == 4, "attempts ${p.attempts}, want 4")
}

test "parseDnsPolicy reads either option alone and keeps the other default" {
  let t = parseDnsPolicy("options timeout:1\n")
  assert(t.timeoutMs == 1000 && t.attempts == 2, "timeout only: ${t.timeoutMs}ms x ${t.attempts}")
  let a = parseDnsPolicy("options attempts:1\n")
  assert(a.timeoutMs == 5000 && a.attempts == 1, "attempts only: ${a.timeoutMs}ms x ${a.attempts}")
}

test "parseDnsPolicy caps timeout at 30 s and attempts at 5, as glibc does" {
  let p = parseDnsPolicy("options timeout:600 attempts:99\n")
  assert(p.timeoutMs == 30000, "timeout ${p.timeoutMs}ms, want 30000")
  assert(p.attempts == 5, "attempts ${p.attempts}, want 5")
}

test "parseDnsPolicy ignores unknown options and numbers that are not 1 or more" {
  let p = parseDnsPolicy("options ndots:2 rotate timeout:0 attempts:-1 timeout:x attempts: edns0\n")
  assert(p.timeoutMs == 5000 && p.attempts == 2, "defaults held: ${p.timeoutMs}ms x ${p.attempts}")
}

test "parseDnsPolicy takes the last options line and tab-separated tokens" {
  let p = parseDnsPolicy("options timeout:2 attempts:2\n\toptions\tattempts:3\ttimeout:7\n")
  assert(p.timeoutMs == 7000 && p.attempts == 3, "got ${p.timeoutMs}ms x ${p.attempts}")
}

test "parseDnsPolicy skips an options keyword in a comment or glued to a word" {
  let p = parseDnsPolicy("# options timeout:1\n; options timeout:1\noptionsx timeout:1\noptions\n")
  assert(p.timeoutMs == 5000 && p.attempts == 2, "got ${p.timeoutMs}ms x ${p.attempts}")
}

test "parseDnsPolicy ignores an options line past the resolver's 4096-byte read" {
  let pad = ""
  while (len(pad) < 4096) {
    pad = pad + "# padding padding padding padding padding\n"
  }
  let p = parseDnsPolicy(pad[0:4096] + "\noptions timeout:1\n")
  assert(p.timeoutMs == 5000, "timeout ${p.timeoutMs}ms, want the default past the window")
}

// Binds a UDP socket that reads queries and never answers; returns its port, or
// -1 after reporting why not. The socket stays referenced by its own task.
fn silentNameserver(): int {
  let s = udpBind("127.0.0.1", 0) catch e {
    assert(false, "udpBind: ${e.message()}")
    return -1
  }
  let port = s.port() catch e {
    assert(false, "port: ${e.message()}")
    return -1
  }
  spawn drain(s)
  return port
}

// Reads datagrams and drops them, so the resolver's sends succeed and only its
// receive window can end the exchange. Ends after eight bounded reads.
fn drain(s: UdpSocket) {
  let i = 0
  while (i < 8) {
    i = i + 1
    let _ = s.recv(512) catch _ {
      break
    }
  }
  s.close()
}

// Milliseconds `lookupTxtVia` takes to give up on the silent nameserver under `p`.
fn msToGiveUp(p: DnsPolicy): int {
  let port = silentNameserver()
  if (port < 0) {
    return -1
  }
  let start = monotonic()
  let got = lookupTxtVia("sel._domainkey.example.com", "127.0.0.1", port, p) catch _ {
    return since(start) / 1000000
  }
  assert(false, "lookup succeeded with ${len(got)} entries against a silent server")
  return -1
}

test "the runtime gives up after exactly the attempts and window std/net passes" {
  let one = msToGiveUp(DnsPolicy{ timeoutMs = 250, attempts = 1, servers = 1 })
  assert(one >= 200 && one < 700, "1 x 250ms took ${one}ms")
  let three = msToGiveUp(DnsPolicy{ timeoutMs = 250, attempts = 3, servers = 1 })
  assert(three >= 700 && three < 1500, "3 x 250ms took ${three}ms")
}
