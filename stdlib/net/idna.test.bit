// stdlib/net/idna.test.bit — #6881. `idnaToAscii` and `idnaToUnicode`
// (idna.bit) against the Unicode Consortium's conformance file for UTS #46,
// plus the cases the file cannot express.
//
// Data: _tests_/data/unicode/IdnaTestV2.txt, UTS #46 17.0.0, from
//   https://www.unicode.org/Public/17.0.0/idna/IdnaTestV2.txt
// (the file's own header reads "Version: 17.0.0", "Date: 2025-05-01").
//
// Same module as ./idna.bit (SPEC §19): no import for it. `std/fs` imports
// `std/strings`, and `fsOpen`/`fsReadAll`/`fsClose` are the runtime primitives
// it is built on, available without an import. `monotonic` and `since` come
// from the import net.test.bit already holds, as every file of a module
// shares its imports.
//
// A data line is `source; toUnicode; toUnicodeStatus; toAsciiN;
// toAsciiNStatus; toAsciiT; toAsciiTStatus # comment`. The `T` columns are
// transitional processing, which this module does not offer. A status is a
// list of rule codes: the file says an implementation "need only record that
// there is an error", and these functions return an error rather than a
// string, so the check is "an error exactly when the expected status is
// non-empty, and the expected string otherwise".

const itDataPath: string = "_tests_/data/unicode/IdnaTestV2.txt"

// The number of data lines in the 17.0.0 file: a truncated copy must fail.
const itDataLines: int = 6391

fn itHexVal(c: int): int {
  if (c >= int('a')) {
    return c - int('a') + 10
  }
  if (c >= int('A')) {
    return c - int('A') + 10
  }
  return c - int('0')
}

// The file's text, read relative to the working directory: `bit test` runs
// from the repo root.
fn itLoad(): string {
  let fd = fsOpen(itDataPath, false)
  assert(fd >= 0, "cannot open ${itDataPath} (run `bit test` from the repo root)")
  let text = fsReadAll(fd)
  fsClose(fd)
  return text
}

fn itIsSpace(c: u8): bool {
  return c == ' ' || c == '\t'
}

fn itTrim(s: string): string {
  let lo = 0
  let hi = len(s)
  while (lo < hi && itIsSpace(s[lo])) {
    lo = lo + 1
  }
  while (hi > lo && itIsSpace(s[hi - 1])) {
    hi = hi - 1
  }
  return s[lo:hi]
}

// The index just past the escape that starts at `s[i]` (`\uXXXX` or
// `\x{X...}`), the code point going into `cp[0]`.
fn itEscape(s: string, i: int, cp: []int): int {
  let v = 0
  let j = i + 2
  if (s[i + 1] == 'u') {
    while (j < i + 6) {
      v = v * 16 + itHexVal(int(s[j]))
      j = j + 1
    }
    cp[0] = v
    return j
  }
  j = i + 3
  while (s[j] != '}') {
    v = v * 16 + itHexVal(int(s[j]))
    j = j + 1
  }
  cp[0] = v
  return j + 1
}

// A column's text with its escapes decoded; `""` is the empty string.
fn itUnescape(col: string): string {
  if (col == "\"\"") {
    return ""
  }
  let b = Builder()
  let cp = []int{ 0 }
  let i = 0
  while (i < len(col)) {
    if (col[i] == '\\') {
      i = itEscape(col, i, cp)
      idnaPut(b, cp[0])
    } else {
      b.writeByte(col[i])
      i = i + 1
    }
  }
  return b.toString()
}

// The line without its `#` comment.
fn itData(line: string): string {
  let i = 0
  while (i < len(line) && line[i] != '#') {
    i = i + 1
  }
  return itTrim(line[0:i])
}

// Whether a status column lists any error: blank means "same as the column
// before" and `[]` means none, both resolved by the caller.
fn itHasErr(status: string): bool {
  return status != "" && status != "[]"
}

class ItOut { failed: bool, value: string }

fn itToAscii(src: string): ItOut {
  let failed = false
  let v = idnaToAscii(src) catch _ {
    failed = true
    ""
  }
  return ItOut{ failed = failed, value = v }
}

fn itToUnicode(src: string): ItOut {
  let failed = false
  let v = idnaToUnicode(src) catch _ {
    failed = true
    ""
  }
  return ItOut{ failed = failed, value = v }
}

// Whether `got` is what a line expects: an error when `wantErr`, else `want`.
fn itAgrees(got: ItOut, wantErr: bool, want: string): bool {
  if (wantErr) {
    return got.failed
  }
  return !got.failed && got.value == want
}

class ItTally { lines: int, uniOk: int, ascOk: int, errs: int }

fn itNote(kind: string, src: string, got: ItOut, wantErr: bool, want: string) {
  print("MISMATCH ${kind}(${src}): failed=${got.failed} '${got.value}', want error=${wantErr} '${want}'\n")
}

// Runs one data line, updating `t`.
fn itLine(data: string, t: ItTally) {
  let c = split(data, ";")
  assert(len(c) == 7, "data line has ${len(c)} columns: ${data}")
  let src = itUnescape(itTrim(c[0]))
  let uni = src
  if (itTrim(c[1]) != "") {
    uni = itUnescape(itTrim(c[1]))
  }
  let uniStatus = itTrim(c[2])
  let asc = uni
  if (itTrim(c[3]) != "") {
    asc = itUnescape(itTrim(c[3]))
  }
  let ascStatus = itTrim(c[4])
  if (ascStatus == "") {
    ascStatus = uniStatus
  }
  let gu = itToUnicode(src)
  let ga = itToAscii(src)
  t.lines = t.lines + 1
  if (itHasErr(uniStatus)) {
    t.errs = t.errs + 1
  }
  if (itAgrees(gu, itHasErr(uniStatus), uni)) {
    t.uniOk = t.uniOk + 1
  } else if (t.lines - t.uniOk < 20) {
    itNote("toUnicode", src, gu, itHasErr(uniStatus), uni)
  }
  if (itAgrees(ga, itHasErr(ascStatus), asc)) {
    t.ascOk = t.ascOk + 1
  } else if (t.lines - t.ascOk < 20) {
    itNote("toAsciiN", src, ga, itHasErr(ascStatus), asc)
  }
}

test "IdnaTestV2.txt: every data line agrees for toUnicode and toAsciiN" {
  let lines = split(itLoad(), "\n")
  let t = ItTally{ lines = 0, uniOk = 0, ascOk = 0, errs = 0 }
  let i = 0
  // Bounded by `len(lines)`, fixed before the loop starts.
  while (i < len(lines)) {
    let data = itData(lines[i])
    if (len(data) > 0) {
      itLine(data, t)
    }
    i = i + 1
  }
  print("IdnaTestV2.txt toUnicode: ${t.uniOk} of ${t.lines} agree\n")
  print("IdnaTestV2.txt toAsciiN: ${t.ascOk} of ${t.lines} agree\n")
  print("IdnaTestV2.txt lines expecting a toUnicode error: ${t.errs}\n")
  assert(t.lines == itDataLines, "data lines ${t.lines}, want ${itDataLines}")
  assert(t.uniOk == t.lines, "toUnicode agrees on ${t.uniOk} of ${t.lines}")
  assert(t.ascOk == t.lines, "toAsciiN agrees on ${t.ascOk} of ${t.lines}")
}

fn itExpectAscii(domain: string, want: string) {
  let got = idnaToAscii(domain) catch e {
    panic("idnaToAscii('${domain}') failed: ${e.message()}")
  }
  assert(got == want, "idnaToAscii('${domain}') = '${got}', want '${want}'")
}

fn itExpectUnicode(domain: string, want: string) {
  let got = idnaToUnicode(domain) catch e {
    panic("idnaToUnicode('${domain}') failed: ${e.message()}")
  }
  assert(got == want, "idnaToUnicode('${domain}') = '${got}', want '${want}'")
}

// Asserts `idnaToAscii(domain)` fails with a message holding `part`.
fn itExpectAsciiErr(domain: string, part: string) {
  let r = itToAscii(domain)
  assert(r.failed, "idnaToAscii('${domain}') = '${r.value}', want an error")
  let msg = idnaToAscii(domain) catch e {
    e.message()
  }
  assert(indexOf(msg, part) >= 0, "idnaToAscii('${domain}') error '${msg}' lacks '${part}'")
}

test "idnaToAscii: the examples of the ticket" {
  itExpectAscii("Bücher.Example", "xn--bcher-kva.example")
  itExpectAscii("faß.de", "xn--fa-hia.de")
  itExpectAscii("xn--fa-hia.de", "xn--fa-hia.de")
  itExpectAscii("例子.广告", "xn--fsqu00a.xn--4rr70v")
  itExpectAscii("EXAMPLE.com", "example.com")
  itExpectAscii("a.b-c.d0", "a.b-c.d0")
}

test "idnaToUnicode: A-labels decode, ASCII lowercases" {
  itExpectUnicode("xn--bcher-kva.Example", "bücher.example")
  itExpectUnicode("xn--fa-hia.de", "faß.de")
  itExpectUnicode("Example.COM.", "example.com.")
  itExpectUnicode("ＡＢＣ．ｃｏｍ", "abc.com")
}

test "idnaToAscii: ß is kept, not transitioned to ss" {
  itExpectAscii("ß", "xn--zca")
  itExpectAscii("ς", "xn--3xa")
}

test "idnaToAscii: ASCII fast path returns the very string for lowercase input" {
  let d = "mail.example.com"
  assert((idnaToAscii(d) catch "") == d, "lowercase ASCII is unchanged")
  assert(ptrOf(idnaToAscii(d) catch "") == ptrOf(d), "the fast path allocates no new string")
}

test "errors name the label and the rule" {
  itExpectAsciiErr("a b.example", "idna: label 'a b' contains the ASCII character U+0020")
  itExpectAsciiErr("-a.example", "idna: label '-a' begins or ends with a hyphen")
  itExpectAsciiErr(
    "ab--c.example",
    "idna: label 'ab--c' has hyphens in the third and fourth positions",
  )
  itExpectAsciiErr("a..b", "idna: label '' is empty")
  itExpectAsciiErr("example.com.", "idna: label '' is empty")
  itExpectAsciiErr("", "idna: label '' is empty")
  itExpectAsciiErr("xn--abc-", "is Punycode for an empty or all-ASCII label")
  itExpectAsciiErr("xn--ab-!", "is not valid Punycode")
  itExpectAsciiErr("\u{0301}a.example", "begins with a combining mark")
  itExpectAsciiErr("a\u{200C}b", "CONTEXTJ")
  itExpectAsciiErr("a\u{200D}b", "CONTEXTJ")
  itExpectAsciiErr("à\u{05D0}", "Bidi rule")
  itExpectAsciiErr("\u{05D0}1\u{0661}", "Bidi rule")
}

test "idnaToAscii: DNS lengths" {
  let l63 = "1234567890123456789012345678901234567890123456789012345678901ab"
  assert(len(l63) == 63, "l63 is 63 octets")
  itExpectAscii(l63 + ".com", l63 + ".com")
  itExpectAsciiErr(l63 + "c.com", "is longer than 63 octets")
  itExpectAsciiErr(
    "1234567890123456789012345678901234567890123456789012345678901234ä.com",
    "is longer than 63 octets",
  )
  let l61 = "12345678901234567890123456789012345678901234567890123456789ab"
  let long = l61 + "." + l61 + "." + l61 + "." + l61
  assert(len(long) == 247, "long is 247 octets")
  itExpectAscii(long, long)
  itExpectAsciiErr(long + ".abcdefg", "domain is longer than 253 octets")
  itExpectAsciiErr(long + ".ab\u{E9}def", "domain is longer than 253 octets")
}

fn itNsPer(domain: string, iters: int): int {
  let start = monotonic()
  let n = 0
  let i = 0
  while (i < iters) {
    let r = idnaToAscii(domain) catch ""
    n = n + len(r)
    i = i + 1
  }
  assert(n > 0, "idnaToAscii produced output")
  return since(start) / iters
}

test "idnaToAscii: cost per call" {
  print("idnaToAscii(\"mail.example.com\"): ${itNsPer("mail.example.com", 200000)} ns/call\n")
  print("idnaToAscii(\"Mail.Example.Com\"): ${itNsPer("Mail.Example.Com", 200000)} ns/call\n")
  print("idnaToAscii(\"Bücher.Example\"): ${itNsPer("Bücher.Example", 20000)} ns/call\n")
}
