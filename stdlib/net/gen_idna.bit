// Bit standard library — net module, UTS #46 IDNA data (#6880).
//
// GENERATED — do not hand-edit. Produced by tools/genunicode from
// the UTS #46 mapping table and the Unicode Character Database, both
// version 17.0.0:
//   https://www.unicode.org/Public/17.0.0/idna/IdnaMappingTable.txt
//   https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt
//   https://www.unicode.org/Public/17.0.0/ucd/extracted/DerivedBidiClass.txt
//   https://www.unicode.org/Public/17.0.0/ucd/extracted/DerivedJoiningType.txt
// Regenerate with:
//   bit run tools/genunicode -- idna \
//     <IdnaMappingTable.txt> <UnicodeData.txt> <DerivedBidiClass.txt> \
//     <DerivedJoiningType.txt> stdlib/net
//
// `idnaStatus` is one of the `idna*` codes below: the status UTS #46
// section 5 gives the code point (the `disallowed_STD3_*` statuses are gone
// since Unicode 16; UseSTD3ASCIIRules is the caller's flag). `idnaMapping`
// is the sequence a mapped or deviation code point maps to, and an empty
// slice for every other status (and for U+200C and U+200D, whose deviation
// maps to nothing). `bidiClass` and `joiningType` are the UAX #9 Bidi_Class
// and ArabicShaping Joining_Type values as the `bidi*` and `join*` codes;
// every scalar value has one. `isVirama` is canonical combining class 9.
// A rune outside 0..10FFFF is disallowed, `bidiL` and `joinU`.

// IDNA statuses (UTS #46 section 5).
const idnaValid: int = 0
const idnaIgnored: int = 1
const idnaMapped: int = 2
const idnaDeviation: int = 3
const idnaDisallowed: int = 4

// Bidi_Class values (UAX #9).
const bidiL: int = 0
const bidiR: int = 1
const bidiAL: int = 2
const bidiEN: int = 3
const bidiES: int = 4
const bidiET: int = 5
const bidiAN: int = 6
const bidiCS: int = 7
const bidiNSM: int = 8
const bidiBN: int = 9
const bidiB: int = 10
const bidiS: int = 11
const bidiWS: int = 12
const bidiON: int = 13
const bidiLRE: int = 14
const bidiLRO: int = 15
const bidiRLE: int = 16
const bidiRLO: int = 17
const bidiPDF: int = 18
const bidiLRI: int = 19
const bidiRLI: int = 20
const bidiFSI: int = 21
const bidiPDI: int = 22

// Joining_Type values (ArabicShaping.txt).
const joinU: int = 0
const joinC: int = 1
const joinD: int = 2
const joinL: int = 3
const joinR: int = 4
const joinT: int = 5

// status records: lo(6) status(1) offset(5), sorted, plus a sentinel.
const idnaStatusTable: string = ""

// mappings, five hex digits per rune.
const idnaMapData: string = ""

// Bidi_Class runs: lo(6) class(2), sorted, covering 0..10FFFF.
const idnaBidiTable: string = ""

// Joining_Type runs: lo(6) type(1), sorted, covering 0..10FFFF.
const idnaJoiningTable: string = ""

// virama ranges: lo(6) hi(6), sorted.
const idnaViramaTable: string = ""

// The value of the `n` uppercase hex digits of `s` starting at byte `at`.
fn idnaHex(s: string, at: int, n: int): int {
  let v = 0
  let i = at
  // Bounded by `at + n`.
  while (i < at + n) {
    let c = int(s[i])
    if (c <= int('9')) {
      v = v * 16 + c - int('0')
    } else {
      v = v * 16 + c - int('A') + 10
    }
    i = i + 1
  }
  return v
}

// The index of the last `recLen`-byte record of `tbl` whose leading six-digit
// key is <= `key`, or -1 when every key is larger. Binary search: O(log n)
// probes, no allocation.
fn idnaFloor(tbl: string, recLen: int, key: int): int {
  let lo = 0
  let hi = len(tbl) / recLen - 1
  let found = -1
  // Bounded: `hi - lo` strictly shrinks every iteration.
  while (lo <= hi) {
    let mid = lo + (hi - lo) / 2
    if (idnaHex(tbl, mid * recLen, 6) <= key) {
      found = mid
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  return found
}

// Whether `r` is a scalar value in 0..10FFFF, the range every table covers.
fn idnaInRange(r: rune): bool {
  return int(r) >= 0 && int(r) <= 0x10FFFF
}

// The UTS #46 status of `r`: one of the `idna*` codes.
fn idnaStatus(r: rune): int {
  if (!idnaInRange(r)) {
    return idnaDisallowed
  }
  let i = idnaFloor(idnaStatusTable, 12, int(r))
  return idnaHex(idnaStatusTable, i * 12 + 6, 1)
}

// The sequence `r` maps to when its status is mapped or deviation, else an
// empty slice. The record after `r`'s (the sentinel at worst) bounds it.
fn idnaMapping(r: rune): []rune {
  let out: []rune = []rune(0)
  if (!idnaInRange(r)) {
    return out
  }
  let i = idnaFloor(idnaStatusTable, 12, int(r))
  let st = idnaHex(idnaStatusTable, i * 12 + 6, 1)
  if (st != idnaMapped && st != idnaDeviation) {
    return out
  }
  let j = idnaHex(idnaStatusTable, i * 12 + 7, 5)
  let end = idnaHex(idnaStatusTable, i * 12 + 19, 5)
  // Bounded by `end`, at most 18 runes past `j` in UCD 17.0.0.
  while (j < end) {
    out = append(out, rune(idnaHex(idnaMapData, j * 5, 5)))
    j = j + 1
  }
  return out
}

// The Bidi_Class of `r`: one of the `bidi*` codes.
fn bidiClass(r: rune): int {
  if (!idnaInRange(r)) {
    return bidiL
  }
  let i = idnaFloor(idnaBidiTable, 8, int(r))
  return idnaHex(idnaBidiTable, i * 8 + 6, 2)
}

// The Joining_Type of `r`: one of the `join*` codes.
fn joiningType(r: rune): int {
  if (!idnaInRange(r)) {
    return joinU
  }
  let i = idnaFloor(idnaJoiningTable, 7, int(r))
  return idnaHex(idnaJoiningTable, i * 7 + 6, 1)
}

// Whether `r` has canonical combining class 9 (a virama).
fn isVirama(r: rune): bool {
  if (!idnaInRange(r)) {
    return false
  }
  let i = idnaFloor(idnaViramaTable, 12, int(r))
  return i >= 0 && int(r) <= idnaHex(idnaViramaTable, i * 12 + 6, 6)
}
