// Bit standard library — net module: a socket peer's address as text.
//
// The runtime hands `Conn.peerIp` the address as 16 bytes in the IPv6 wire form
// whatever the socket's family (`bit_rt_net_peer_addr_w`): an IPv4 peer arrives
// as its IPv4-mapped address `::ffff:a.b.c.d`. This file renders them.
//
// One rule makes a client's address the same string on every kind of socket:
// an IPv4-mapped address prints as the plain dotted quad, so the peer of a
// `::` listener that a v4-only client reaches (the kernel reports it mapped)
// and the peer of a `0.0.0.0` listener are both "192.0.2.7" — one rate-limit
// key, as Go's `net.IP.String` gives. Every other address prints per RFC 5952:
// lowercase hex, no leading zeros in a group, and the longest run of two or
// more zero groups (the first, on a tie) collapsed to "::".

const hexDigits: string = "0123456789abcdef"

// True for `::ffff:0:0/96`: ten zero bytes, then `ff ff`.
fn isMappedV4(b: []byte): bool {
  let i = 0
  while (i < 10) {
    if (b[i] != 0) {
      return false
    }
    i = i + 1
  }
  return b[10] == 255 && b[11] == 255
}

// Group `i` (0..7) of the address as its value, 0..0xffff.
fn groupAt(b: []byte, i: int): int {
  return int(b[2 * i]) * 256 + int(b[2 * i + 1])
}

// Group `i` as one to four lowercase hex digits, no leading zeros.
fn groupText(b: []byte, i: int): string {
  let v = groupAt(b, i)
  if (v == 0) {
    return "0"
  }
  let s = ""
  while (v > 0) {
    let d = v % 16
    s = hexDigits[d:d + 1] + s
    v = v / 16
  }
  return s
}

// Groups `[from, to)` joined by ":".
fn groupsText(b: []byte, from: int, to: int): string {
  let s = ""
  let i = from
  while (i < to) {
    if (i > from) {
      s = s + ":"
    }
    s = s + groupText(b, i)
    i = i + 1
  }
  return s
}

// The longest run of zero groups as `start * 16 + length`; the first wins a
// tie (RFC 5952 section 4.2.3). Length 0 when no group is zero.
fn longestZeroRun(b: []byte): int {
  let bestAt = 0
  let bestLen = 0
  let i = 0
  while (i < 8) {
    let j = i
    while (j < 8 && groupAt(b, j) == 0) {
      j = j + 1
    }
    if (j - i > bestLen) {
      bestAt = i
      bestLen = j - i
    }
    i = j + 1
  }
  return bestAt * 16 + bestLen
}

// The text of the 16-byte address `b`: the dotted quad for an IPv4-mapped one,
// RFC 5952 otherwise.
fn ipText(b: []byte): string {
  if (isMappedV4(b)) {
    return "${int(b[12])}.${int(b[13])}.${int(b[14])}.${int(b[15])}"
  }
  let run = longestZeroRun(b)
  let at = run / 16
  let n = run % 16
  if (n < 2) {
    return groupsText(b, 0, 8)
  }
  return groupsText(b, 0, at) + "::" + groupsText(b, at + n, 8)
}
