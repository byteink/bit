// Bit standard library — net module: IP address literal checks.
//
// Strict text-form validators for the AWS endpoint rules' `isIp` and for URL
// hosts (`std/http`). They accept exactly the canonical forms: no brackets, no
// zone id, no surrounding space, and nothing a lenient `inet_aton` would take
// (octal, hex, shorthand like "127.1", leading zeros).

// True when `part` is 1 to 4 hex digits (either case).
fn isHexGroup(part: string): bool {
  if (len(part) == 0 || len(part) > 4) {
    return false
  }
  let i = 0
  while (i < len(part)) {
    let c = part[i]
    let digit = c >= '0' && c <= '9'
    let lower = c >= 'a' && c <= 'f'
    let upper = c >= 'A' && c <= 'F'
    if (!digit && !lower && !upper) {
      return false
    }
    i = i + 1
  }
  return true
}

// True when `part` is a decimal octet, 0 to 255, ASCII digits only and no
// leading zero (RFC 3986 dec-octet): "0" is an octet, "01" and "+1" are not.
fn isDecOctet(part: string): bool {
  if (len(part) == 0 || len(part) > 3) {
    return false
  }
  if (len(part) > 1 && part[0] == '0') {
    return false
  }
  let v = 0
  let i = 0
  while (i < len(part)) {
    let c = part[i]
    if (c < '0' || c > '9') {
      return false
    }
    v = v * 10 + i64(c - '0')
    i = i + 1
  }
  return v <= 255
}

// True when `s` is an IPv4 address in strict dotted-quad form: four decimal
// octets, 0 to 255, no leading zeros.
export fn isIpv4Literal(s: string): bool {
  let parts = split(s, ".")
  if (len(parts) != 4) {
    return false
  }
  let i = 0
  while (i < 4) {
    if (!isDecOctet(parts[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

// How many 16-bit groups the colon-separated `part` holds, or -1 when it is not
// valid. The empty string holds none. A dotted-quad last group counts as two,
// and only when `tail` says `part` ends the address (RFC 4291 section 2.2 item 3).
fn ipv6GroupCount(part: string, tail: bool): int {
  if (len(part) == 0) {
    return 0
  }
  let groups = split(part, ":")
  let n = 0
  let i = 0
  while (i < len(groups)) {
    if (tail && i == len(groups) - 1 && indexOf(groups[i], ".") >= 0) {
      if (!isIpv4Literal(groups[i])) {
        return 0 - 1
      }
      n = n + 2
    } else if (isHexGroup(groups[i])) {
      n = n + 1
    } else {
      return 0 - 1
    }
    i = i + 1
  }
  return n
}

// True when `s` is an IPv6 address in RFC 4291 text form: eight groups, or
// fewer with one "::" standing for one or more zero groups, optionally ending in
// an IPv4 dotted quad ("::ffff:192.0.2.1"). No brackets and no zone id.
export fn isIpv6Literal(s: string): bool {
  let dc = indexOf(s, "::")
  if (dc < 0) {
    return ipv6GroupCount(s, true) == 8
  }
  let after = s[dc + 2:len(s)]
  if (indexOf(after, "::") >= 0) {
    return false
  }
  let head = ipv6GroupCount(s[0:dc], false)
  let rest = ipv6GroupCount(after, true)
  return head >= 0 && rest >= 0 && head + rest <= 7
}
