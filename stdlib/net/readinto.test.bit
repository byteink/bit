// stdlib/net/readinto.test.bit — reads into a caller-owned buffer:
// `Conn.readDeadlineInto` (#5857, #5890) and `Conn.readInto` (#7389), over
// loopback (their own file: net.test.bit is at the 800-line ceiling).
//
// `listen`, `dial` and `Conn` are siblings in this same module (net.bit), so
// they are not imported; `monotonic` arms the deadlines.
import { monotonic } from "std/time"

// #5857 — `readDeadlineInto` reads into a CALLER-OWNED buffer instead of
// allocating a fresh one per call, the way `stdlib/http/http.bit`'s
// `netStream.rbuf` reuses it across every request on a keep-alive
// connection. Same three outcomes as `readDeadline`: bytes read (returned as
// a count, not a fresh string — the caller decides what to do with
// `buf[0:n]`), `0` for a clean close, and a `fail` for a timeout or a read
// failure.
test "readDeadlineInto reads into the caller's buffer and reports a clean close as 0" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  a.setDeadline(monotonic().ns + 60000000000)

  c.write("hello") catch e {
    assert(false, "write: ${e.message()}")
    return
  }
  let buf = []byte(4096)
  let n = a.readDeadlineInto(buf, 4096) catch e {
    assert(false, "readDeadlineInto: ${e.message()}")
    return
  }
  assert(n == 5, "readDeadlineInto returned n=${n}, want 5")
  assert(string(buf[0:n]) == "hello", "readDeadlineInto read '${string(buf[0:n])}', want 'hello'")

  // A second call reuses the SAME `buf`, the way `netStream.rbuf` does
  // across requests: the peer has closed, so this read must report a clean
  // close (`0`) rather than replaying the first call's bytes or failing.
  c.close()
  let closed = a.readDeadlineInto(buf, 4096) catch e {
    assert(false, "readDeadlineInto after close: ${e.message()}")
    return
  }
  assert(closed == 0, "readDeadlineInto after the peer closed returned ${closed}, want 0")

  a.close()
  l.close()
}

// The runtime writes through a raw pointer, so a `max` larger than the buffer
// must be clamped to `len(buf)`, never trusted: 16 bytes sent into a 4-byte
// buffer with max 4096 must come back as exactly 4.
test "readDeadlineInto never reads past len(buf), whatever max says" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  a.setDeadline(monotonic().ns + 60000000000)
  c.write("0123456789abcdef") catch e {
    assert(false, "write: ${e.message()}")
    return
  }
  let small = []byte(4)
  let n = a.readDeadlineInto(small, 4096) catch e {
    assert(false, "readDeadlineInto: ${e.message()}")
    return
  }
  assert(n == 4, "readDeadlineInto with max 4096 into a 4-byte buffer returned ${n}, want 4")
  assert(string(small) == "0123", "read '${string(small)}', want '0123'")
  c.close()
  a.close()
  l.close()
}

// #5890 — `readDeadlineInto` hands `buf` itself to the kernel: the runtime
// no longer reads into a scratch of its own and copies it across, and what
// keeps `buf` live across the park is the caller's `keepAlive` (net.bit). So
// 10,000 reads into ONE reused buffer must each return exactly the bytes sent
// for that round — never a previous round's, never zeros. Lockstep, the
// writer on its own green thread waiting for an ack, so each read finds an
// empty socket and parks before its bytes arrive, and the writer allocates a
// fresh message per round, which gives `BIT_GC=stress` a collection to run
// while the reader is parked. The writer goes through `writeDeadline` and
// `readDeadline`, the other two callers of the same no-scratch contract.
fn intoMsg(i: int): string {
  return "${i}:${i * 7919 % 100003};"
}

// On an early exit the writer shuts `c` down, so a reader with no deadline
// sees a close instead of parking forever.
fn intoWriter(c: Conn, rounds: int) {
  c.setDeadline(monotonic().ns + 120000000000)
  let i = 0
  while (i < rounds) {
    c.writeDeadline(intoMsg(i)) catch _ {
      c.shutdown()
      return
    }
    let ack = c.readDeadline(1) catch _ {
      c.shutdown()
      return
    }
    if (ack != "A") {
      c.shutdown()
      return
    }
    i = i + 1
  }
}

// One round: read `want` in as many `readInto` calls as it takes, never
// asking for more than is still owed, so a read cannot run into the next
// round's bytes. `readInto` is `readDeadlineInto` on a deadline-armed `a`
// and `bit_rt_net_read_bytes_w` (#7389) on an unarmed one. Returns the calls
// made, or -1 with `why` set.
fn intoRound(a: Conn, buf: []byte, want: string, why: []string): int {
  let acc = ""
  let calls = 0
  while (len(acc) < len(want)) { // each pass grows `acc` by n > 0 or returns
    let n = a.readInto(buf, len(want) - len(acc)) catch e {
      why[0] = e.message()
      return 0 - 1
    }
    calls = calls + 1
    if (n == 0) {
      why[0] = "peer closed"
      return 0 - 1
    }
    acc = acc + string(buf[0:n])
  }
  if (acc != want) {
    why[0] = "read '${acc}', want '${want}'"
    return 0 - 1
  }
  return calls
}

// `rounds` lockstep rounds into ONE reused buffer, the reader deadline-armed
// or not; "" when every round read exactly its own bytes, else what broke.
fn intoRun(rounds: int, armed: bool): string {
  let l = listen("127.0.0.1", 0) catch e {
    return "listen: ${e.message()}"
  }
  let port = l.port() catch e {
    return "port: ${e.message()}"
  }
  let c = dial("127.0.0.1", port) catch e {
    return "dial: ${e.message()}"
  }
  let a = l.accept() catch e {
    return "accept: ${e.message()}"
  }
  if (armed) {
    a.setDeadline(monotonic().ns + 120000000000)
  }
  spawn intoWriter(c, rounds)
  let why = intoRounds(a, rounds)
  c.close()
  a.close()
  l.close()
  return why
}

// The reader's side of `intoRun`: every round read into one 64-byte buffer,
// then acked; "" or what broke.
fn intoRounds(a: Conn, rounds: int): string {
  let buf = []byte(64)
  let why = [""]
  let calls = 0
  let i = 0
  while (i < rounds) {
    let k = intoRound(a, buf, intoMsg(i), why)
    if (k < 0) {
      return "round ${i} of ${rounds}: ${why[0]}"
    }
    calls = calls + k
    a.write("A") catch e {
      return "round ${i} of ${rounds}: ack: ${e.message()}"
    }
    i = i + 1
  }
  if (calls < rounds) {
    return "${calls} reads for ${rounds} rounds"
  }
  return ""
}

test "readDeadlineInto returns exactly the bytes sent across 10,000 parked reads into one buffer" {
  let why = intoRun(10000, true)
  assert(why == "", why)
}

// #7389: with no deadline the kernel reads straight into the caller's buffer
// through `bit_rt_net_read_bytes_w`, held live across the park by
// `readInto`'s `keepAlive` alone, the same contract `readDeadlineInto` keeps.
test "readInto with no deadline returns exactly the bytes sent across 10,000 parked reads into one buffer" {
  let why = intoRun(10000, false)
  assert(why == "", why)
}

// Reads into `buf` until it holds at least `want` bytes or the peer closes;
// the count read, or -1 on a failure.
fn readIntoAtLeast(a: Conn, buf: []byte, want: int): int {
  let got = 0
  let guard = 0
  while (got < want && guard < want) { // each pass reads at least one byte or exits
    guard = guard + 1
    let k = a.readInto(buf[got:len(buf)], len(buf)) catch _ {
      return 0 - 1
    }
    if (k == 0) {
      return got
    }
    got = got + k
  }
  return got
}

// `readInto` with no deadline clamps `max` to `len(buf)` (the runtime writes
// through a raw pointer) and reports a clean close as 0, not as a failure.
test "readInto with no deadline never reads past len(buf) and reports a clean close as 0" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  c.write("0123456789abcdef") catch e {
    assert(false, "write: ${e.message()}")
    return
  }
  let small = []byte(4)
  let n = a.readInto(small, 4096) catch e {
    assert(false, "readInto: ${e.message()}")
    return
  }
  assert(n == 4, "readInto with max 4096 into a 4-byte buffer returned ${n}, want 4")
  assert(string(small) == "0123", "read '${string(small)}', want '0123'")
  let rest = []byte(64)
  let got = readIntoAtLeast(a, rest, 12)
  assert(
    string(rest[0:got]) == "456789abcdef",
    "read '${string(rest[0:got])}', want '456789abcdef'",
  )
  c.close()
  let closed = a.readInto(rest, 64) catch e {
    assert(false, "readInto after close: ${e.message()}")
    return
  }
  assert(closed == 0, "readInto after the peer closed returned ${closed}, want 0")
  a.close()
  l.close()
}
