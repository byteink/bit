// Bit standard library — net module.
//
// Non-blocking TCP over green threads. A `Conn` that waits for bytes parks the
// green thread reading it and leaves its OS thread free, so the idiomatic
// "one green thread per connection" server costs one `Task` per connection
// rather than one OS thread.
//
// Addresses are dotted-quad IPv4 literals: `"127.0.0.1"`, not `"localhost"`.
// There is no name resolution yet.
//
// ponytail: no TLS. Plain TCP only — do not put this on a public port without a
// terminating proxy in front. Adding TLS means an implementation of the record
// layer and a certificate verifier, which is its own task.

// A listening socket. Not a `Conn`: the only thing you can do with it is accept.
export struct Listener { fd: i64 }

// One end of an established connection. `deadlineNs` is an ABSOLUTE monotonic
// nanosecond deadline (`std/time`'s `monotonic()` plus a budget) that
// `readDeadline`/`writeDeadline` respect; `0`, the zero value every `Conn` not
// built by `dialDeadline` gets, means "no deadline" — `read`/`write` never
// consult it at all, so an existing `dial()`-then-`read()` caller is
// unaffected (#2291).
export struct Conn { fd: i64, deadlineNs: i64 }

// #2314: `netListen`/`netDial`/`netUdpBind` return `0 - errno` when the
// failure reached a real syscall (#2343) and the flat sentinel `-1` when it
// didn't — a malformed host, or a port outside 0-65535, neither of which has
// a kernel cause to report. Appending the errno number to the message lets
// two different failures (EADDRINUSE vs EACCES, say) read differently
// instead of both collapsing to the same "<op> host:port failed". It's the
// raw platform number, not a symbolic name: EADDRINUSE/EADDRNOTAVAIL/
// ECONNREFUSED are numbered completely differently on Darwin vs Linux, and
// no errno-to-name table is reachable from here without either a runtime
// change or per-platform source under this module — out of this ticket's
// scope (`stdlib/net/**` only).
fn netFailMsg(op: string, host: string, port: int, fd: i64): string {
  if (fd < 0 - 1) {
    return "${op} ${host}:${port} failed: errno ${0 - fd}"
  }
  return "${op} ${host}:${port} failed"
}

// Listen for TCP connections on `host:port`.
//
// `port` may be 0, which asks the kernel to pick a free one — ask the returned
// listener for `port()` to find out which. That is the reliable way to bind in a
// test: picking a number yourself races every other process on the machine.
export fn listen(host: string, port: int): Listener! {
  let fd = netListen(host, port)
  if (fd < 0) {
    fail newError(netFailMsg("listen", host, port, fd))
  }
  return Listener{ fd: fd }
}

// The port this listener is bound to. Meaningful even when 0 was requested.
export fn (l: Listener) port(): int! {
  let p = netLocalPort(l.fd)
  if (p < 0) {
    fail newError("could not read the listener's port")
  }
  return p
}

// Wait for the next connection. Parks the calling green thread; the OS thread
// goes and runs somebody else.
export fn (l: Listener) accept(): Conn! {
  let fd = netAccept(l.fd)
  if (fd < 0) {
    fail newError("accept failed")
  }
  return Conn{ fd: fd }
}

// Idempotent: a second call is a no-op. Without this, a second close on an
// already-closed listener closes whatever fd number the kernel has since
// reassigned to a different, live socket.
export fn (l: Listener) close() {
  if (l.fd >= 0) {
    fsClose(l.fd)
    l.fd = 0 - 1
  }
}

// Connect to `host:port`. A refused connection fails here, not at the first
// write.
export fn dial(host: string, port: int): Conn! {
  let fd = netDial(host, port)
  if (fd < 0) {
    fail newError(netFailMsg("dial", host, port, fd))
  }
  return Conn{ fd: fd }
}

// Up to `max` bytes. An empty result means the peer closed: an orderly end of
// stream, and the condition that ends a read loop.
export fn (c: Conn) read(max: int): string {
  return netRead(c.fd, max)
}

// Write all of `s`. A short write is retried internally, so this either wrote
// every byte or failed.
export fn (c: Conn) write(s: string): ()! {
  if (netWrite(c.fd, s) < 0) {
    fail newError("write failed")
  }
}

// Read until the peer closes. Only safe against a peer that actually closes —
// a keep-alive protocol needs a framing layer instead.
export fn (c: Conn) readAll(): string {
  let out = ""
  while (true) {
    let chunk = c.read(4096)
    if (len(chunk) == 0) {
      return out
    }
    out = out + chunk
  }
}

// Idempotent: a second call is a no-op. Without this, a second close on an
// already-closed connection closes whatever fd number the kernel has since
// reassigned to a different, live socket.
export fn (c: Conn) close() {
  if (c.fd >= 0) {
    fsClose(c.fd)
    c.fd = 0 - 1
  }
}

// Shut both directions of the connection down WITHOUT releasing the fd (#3016)
// — unlike `close`, a later `dial`/`listen`/`accept` elsewhere in this process
// cannot reuse the number until `close` follows this. Idempotent (a no-op once
// `close` has run); does not clear `fd`, since `read`/`write`/`close` still need
// it afterward.
//
// USE THIS, NOT `close`, TO UNBLOCK A GREEN THREAD PARKED READING THIS SAME
// `Conn` FROM ANOTHER THREAD. Nothing in this runtime lets one thread interrupt
// another's blocked read directly, and closing the fd out from under it does
// NOT wake it either — closing tears the descriptor down without notifying an
// existing `netAwaitReady` registration for it at all, so the parked read
// simply never returns. Shutting the socket down instead is a real state
// transition on the still-open descriptor the parked read is registered
// against, which the kernel reports as newly readable (an orderly EOF) —
// exactly the wakeup a bare `close` does not produce. Call this, then wait for
// the parked reader to actually observe the resulting empty read/error and
// return, and only THEN call `close` — see `std/http2`'s `Conn.waitReaderDone`
// (stdlib/http2/conn.bit) and its caller `h2clientExchange`
// (stdlib/http/h2.bit) for the shape this exists for.
extern fn bit_rt_net_shutdown_sock_w(fd: i64): bool

export fn (c: Conn) shutdown() {
  if (c.fd >= 0) {
    let _ = bit_rt_net_shutdown_sock_w(c.fd)
  }
}

// One received datagram: its bytes and the address it came from. The address is
// what a server replies to — UDP has no connection to reply over.
export struct Datagram { data: string, host: string, port: int }

// A UDP socket. Connectionless: there is no accept or dial, you send and receive
// datagrams straight off the socket, each carrying its own destination.
export struct UdpSocket { fd: i64 }

// Bind a UDP socket to `host:port`. Like `listen`, `port` may be 0 to let the
// kernel choose one — read it back with `port()`.
export fn udpBind(host: string, port: int): UdpSocket! {
  let fd = netUdpBind(host, port)
  if (fd < 0) {
    fail newError(netFailMsg("udp bind", host, port, fd))
  }
  return UdpSocket{ fd: fd }
}

// The port this socket is bound to. Meaningful even when 0 was requested.
export fn (s: UdpSocket) port(): int! {
  let p = netLocalPort(s.fd)
  if (p < 0) {
    fail newError("could not read the socket's port")
  }
  return p
}

// Send one datagram to `host:port`. All-or-nothing: a datagram is never
// partially sent, so success means every byte went.
export fn (s: UdpSocket) send(host: string, port: int, data: string): ()! {
  if (netUdpSend(s.fd, host, port, data) < 0) {
    fail newError("udp send to ${host}:${port} failed")
  }
}

// Receive the next datagram, up to `max` bytes, parking until one arrives. The
// returned `Datagram` carries the sender's address. A zero-length datagram is
// legal and is not an error — unlike a TCP read, empty does not mean "closed".
export fn (s: UdpSocket) recv(max: int): Datagram! {
  let data = netUdpRecv(s.fd, max)
  let port = netUdpSenderPort()
  if (port < 0) {
    fail newError("udp recv failed")
  }
  let host = netUdpSenderHost()
  return Datagram{ data: data, host: host, port: port }
}

// Idempotent: a second call is a no-op. Without this, a second close on an
// already-closed socket closes whatever fd number the kernel has since
// reassigned to a different, live socket.
export fn (s: UdpSocket) close() {
  if (s.fd >= 0) {
    fsClose(s.fd)
    s.fd = 0 - 1
  }
}

// Resolve a hostname to an IPv4 address (dotted quad) via the system resolver
// (the first nameserver in /etc/resolv.conf). A dotted-quad argument is returned
// unchanged, so it is safe to call on an address that may already be numeric.
//
// Only A records — no IPv6, no search domains, no caching. Pair it with `dial`:
// `dial(resolve("example.com")?, 80)`.
export fn resolve(host: string): string! {
  let ip = netResolve(host)
  if (len(ip) == 0) {
    fail newError("could not resolve ${host}")
  }
  return ip
}

// ---------------------------------------------------------------------------
// Deadline-bounded operations (#2291)
// ---------------------------------------------------------------------------
//
// A server that completes the handshake (or accepts a connection) and then
// never writes parks `dial`/`read` forever — nothing above bounds the wait.
// These give a caller a way to defend itself: an ABSOLUTE monotonic deadline
// (`std/time`'s `monotonic()` plus a budget), resolved ONCE and carried by
// the `Conn` it produces, so a whole request's connect, write and read can
// share the SAME deadline without restarting it per operation — the pattern
// `runtime/ABI.md` §19's `osForkExecWaitBounded` documents. A timeout is a
// `fail`; a clean close is `Ok("")` from `readDeadline`, exactly as `read`
// reports it — the two are never confusable by a caller checking which one
// it got.
//
// Reached through a plain `extern fn`, not a compiler-recognized builtin
// (SPEC §11.7 admits no `string` across that boundary), so `host`/the body
// cross as a packed `[]byte` and a length — the same shape `std/fs`'s
// `bit_rt_fs_is_symlink_w` uses.
extern fn bit_rt_net_dial_deadline_w(host: *byte, hostLen: int, port: int, deadlineNs: i64): i64
extern fn bit_rt_net_read_deadline_w(fd: i64, out: *byte, cap: int, deadlineNs: i64): i64
extern fn bit_rt_net_write_deadline_w(fd: i64, data: *byte, n: int, deadlineNs: i64): i64

// Connect to `host:port`, bounded by `deadlineNs` (an absolute monotonic
// nanosecond deadline, not a duration — `monotonic() + budget`) rather than
// parking forever. The returned `Conn` remembers `deadlineNs` and
// `readDeadline`/`writeDeadline` on it reuse the SAME value automatically, so
// a caller does not have to re-derive or re-pass it per operation.
export fn dialDeadline(host: string, port: int, deadlineNs: int): Conn! {
  let n = len(host)
  if (n == 0 || n > 255) {
    fail newError("dial ${host}:${port} failed")
  }
  let w = []byte(n)
  let i = 0
  while (i < n) {
    w[i] = host[i]
    i = i + 1
  }
  let fd = bit_rt_net_dial_deadline_w(ptrOf(w), n, port, deadlineNs)
  if (fd == 0 - 2) {
    fail newError("dial ${host}:${port} timed out")
  }
  if (fd < 0) {
    fail newError("dial ${host}:${port} failed")
  }
  return Conn{ fd: fd, deadlineNs: deadlineNs }
}

// Set (or, with `0`, clear) the absolute monotonic deadline `readDeadline`/
// `writeDeadline` respect on this connection from now on. Does not reach back
// to bound a `dial`/`dialDeadline` connect already completed.
export fn (c: Conn) setDeadline(deadlineNs: int) {
  c.deadlineNs = deadlineNs
}

// Up to `max` bytes, bounded by the connection's deadline (`dialDeadline`/
// `setDeadline`; the zero value blocks like `read` — at most one hour, the
// same ceiling `runtime/ABI.md` §19's `os_run_bounded_max_ms` clamps a
// forgotten timeout to). An empty result is a CLEAN CLOSE, exactly as `read`
// reports it — an orderly end of stream, never an error. A timeout is a
// `fail` whose message names it, so a caller distinguishes the two by
// which one it got: a value back (even `""`) was never on the timeout path.
export fn (c: Conn) readDeadline(max: int): string! {
  if (max <= 0) {
    return ""
  }
  let w = []byte(max)
  let n = bit_rt_net_read_deadline_w(c.fd, ptrOf(w), max, c.deadlineNs)
  if (n == 0 - 2) {
    fail newError("read timed out")
  }
  if (n < 0) {
    fail newError("read failed")
  }
  if (n == 0) {
    return ""
  }
  return string(w[0:n])
}

// Write all of `s`, bounded by the connection's deadline. `()!` already, so
// no new distinguishing shape is needed: a plain error is a hard I/O
// failure, an error naming the timeout is the deadline elapsing first.
export fn (c: Conn) writeDeadline(s: string): ()! {
  let n = len(s)
  if (n == 0) {
    return
  }
  let w = []byte(n)
  let i = 0
  while (i < n) {
    w[i] = s[i]
    i = i + 1
  }
  let wrote = bit_rt_net_write_deadline_w(c.fd, ptrOf(w), n, c.deadlineNs)
  if (wrote == 0 - 2) {
    fail newError("write timed out")
  }
  if (wrote < 0) {
    fail newError("write failed")
  }
}
