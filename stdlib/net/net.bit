// Bit standard library — net module.
//
// Non-blocking TCP over green threads. A `Conn` that waits for bytes parks the
// green thread reading it and leaves its OS thread free, so the idiomatic
// "one green thread per connection" server costs one `Task` per connection
// rather than one OS thread.
//
// Addresses are dotted-quad IPv4 literals: `"127.0.0.1"`, not `"localhost"`.
// There is no name resolution yet.
//
// ponytail: no TLS. Plain TCP only — do not put this on a public port without a
// terminating proxy in front. Adding TLS means an implementation of the record
// layer and a certificate verifier, which is its own task.

// A listening socket. Not a `Conn`: the only thing you can do with it is accept.
export struct Listener {
  fd: i64
}

// One end of an established connection.
export struct Conn {
  fd: i64
}

// Listen for TCP connections on `host:port`.
//
// `port` may be 0, which asks the kernel to pick a free one — ask the returned
// listener for `port()` to find out which. That is the reliable way to bind in a
// test: picking a number yourself races every other process on the machine.
export function listen(host: string, port: int): Listener! {
  let fd = netListen(host, port)
  if (fd < 0) {
    fail newError("listen ${host}:${port} failed")
  }
  return Listener{ fd: fd }
}

// The port this listener is bound to. Meaningful even when 0 was requested.
export function (l: Listener) port(): int! {
  let p = netLocalPort(l.fd)
  if (p < 0) {
    fail newError("could not read the listener's port")
  }
  return p
}

// Wait for the next connection. Parks the calling green thread; the OS thread
// goes and runs somebody else.
export function (l: Listener) accept(): Conn! {
  let fd = netAccept(l.fd)
  if (fd < 0) {
    fail newError("accept failed")
  }
  return Conn{ fd: fd }
}

export function (l: Listener) close() {
  fsClose(l.fd)
}

// Connect to `host:port`. A refused connection fails here, not at the first
// write.
export function dial(host: string, port: int): Conn! {
  let fd = netDial(host, port)
  if (fd < 0) {
    fail newError("dial ${host}:${port} failed")
  }
  return Conn{ fd: fd }
}

// Up to `max` bytes. An empty result means the peer closed: an orderly end of
// stream, and the condition that ends a read loop.
export function (c: Conn) read(max: int): string {
  return netRead(c.fd, max)
}

// Write all of `s`. A short write is retried internally, so this either wrote
// every byte or failed.
export function (c: Conn) write(s: string): ()! {
  if (netWrite(c.fd, s) < 0) {
    fail newError("write failed")
  }
}

// Read until the peer closes. Only safe against a peer that actually closes —
// a keep-alive protocol needs a framing layer instead.
export function (c: Conn) readAll(): string {
  let out = ""
  while (true) {
    let chunk = c.read(4096)
    if (len(chunk) == 0) {
      return out
    }
    out = out + chunk
  }
  return out
}

export function (c: Conn) close() {
  fsClose(c.fd)
}
