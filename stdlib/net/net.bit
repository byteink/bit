// Bit standard library — net module.
//
// Non-blocking TCP over green threads. A `Conn` that waits for bytes parks the
// green thread reading it and leaves its OS thread free, so the idiomatic
// "one green thread per connection" server costs one `Task` per connection
// rather than one OS thread.
//
// Addresses are dotted-quad IPv4 literals: `"127.0.0.1"`, not `"localhost"`.
// There is no name resolution yet.
//
// ponytail: no TLS. Plain TCP only — do not put this on a public port without a
// terminating proxy in front. Adding TLS means an implementation of the record
// layer and a certificate verifier, which is its own task.
import { readFile } from "std/fs"
import { split, hasPrefix, indexOf, trimSpace, replace, parseInt } from "std/strings"

// A listening socket. Not a `Conn`: the only thing you can do with it is accept.
export class Listener {
  fd: i64
  // The port this listener is bound to. Meaningful even when 0 was requested.
  export port(): int! {
    let p = netLocalPort(this.fd)
    if (p < 0) {
      fail newError("could not read the listener's port")
    }
    return p
  }

  // Wait for the next connection. Parks the calling green thread; the OS thread
  // goes and runs somebody else.
  export accept(): Conn! {
    let fd = netAccept(this.fd)
    if (fd < 0) {
      fail newError("accept failed")
    }
    return Conn{ fd = fd }
  }

  // Idempotent: a second call is a no-op. Without this, a second close on an
  // already-closed listener closes whatever fd number the kernel has since
  // reassigned to a different, live socket.
  export close() {
    if (this.fd >= 0) {
      bit_rt_net_close_w(this.fd)
      this.fd = 0 - 1
    }
  }
}

// One end of an established connection. `deadlineNs` is an ABSOLUTE monotonic
// nanosecond deadline (`std/time`'s `monotonic()` plus a budget); `0`, the
// zero value every `Conn` not built by `dialDeadline`/`setDeadline` gets,
// means "no deadline". Go-style (`net.Conn.SetDeadline`): a non-zero
// `deadlineNs` bounds EVERY read and write on this `Conn` — `read`/`readInto`/
// `write` below, `readDeadline`/`readDeadlineInto`/`writeDeadline` — never
// only some of them (#5915). `read`/`write` stay non-fallible/plain-fallible
// exactly as before (no new failure SHAPE), so an existing `dial()`-then-
// `read()` caller with `deadlineNs == 0` is unaffected either way (#2291):
// that fast path waits as long as it always did, behind one cheap
// `deadlineNs == 0` branch.
export class Conn {
  fd: i64
  deadlineNs: i64
  // Whether the most recent `read()` timed out rather than hit a clean close;
  // see `readTimedOut()` below.
  timedOut: bool
  // Up to `max` bytes, bounded by the connection's deadline exactly as
  // `readDeadline` is when `deadlineNs != 0` (#5915), through `readInto`
  // into a fresh buffer of `max` bytes. An empty result means either the peer closed (an orderly end of stream,
  // the condition that ends a read loop) OR the deadline elapsed first;
  // `read`'s signature has no room for a distinct error value the way
  // `readDeadline` does, so the two collapse to the same "" a caller not
  // watching for a deadline already treats as end-of-stream. A caller that
  // DOES need to tell them apart reads `readTimedOut()` right after — the
  // same side channel `std/tls`'s `TlsConn.readTimedOut()` (#3031) exposes
  // for exactly this shape of non-fallible read.
  export read(max: int): string {
    this.timedOut = false
    if (max <= 0) {
      return ""
    }
    let w = []byte(max)
    let n = this.readInto(w, max) catch e {
      this.timedOut = e.message() == "read timed out"
      return ""
    }
    return string(w[0:n])
  }

  // Up to `min(max, len(buf))` bytes into `buf[0:n]`, overwriting what the
  // previous call left there; `0` is a clean close. Unlike `read`, nothing is
  // allocated per call (#7389): with no deadline the kernel reads straight
  // into `buf` and waits exactly as `read` does, through
  // `bit_rt_net_read_bytes_w` (`netAbiRead`'s byte-taking sibling in
  // runtime/net/{linux,darwin,windows}/netabi.bit); with one it is
  // `readDeadlineInto`. A hard I/O error fails "read failed" and an elapsed
  // deadline "read timed out", so a caller can tell both from a close.
  export readInto(buf: []byte, max: int): int! {
    if (this.deadlineNs != 0) {
      return this.readDeadlineInto(buf, max)?
    }
    let want = max
    if (want > len(buf)) {
      want = len(buf)
    }
    if (want <= 0) {
      return 0
    }
    let n = bit_rt_net_read_bytes_w(this.fd, ptrOf(buf), want)
    keepAlive(buf)
    if (n < 0) {
      fail newError("read failed")
    }
    return n
  }

  // Whether the `read()` call just before this one returned "" because THIS
  // side's own deadline (`setDeadline`) elapsed while waiting, rather than
  // the peer closing cleanly — `read()`, above, is the only setter. Every
  // `read()` call overwrites it, deadline armed or not, so it is meaningless
  // only before the first `read()` call on this `Conn`.
  export readTimedOut(): bool {
    return this.timedOut
  }

  // Write all of `s`, bounded by the connection's deadline exactly as
  // `writeDeadline` is when `deadlineNs != 0` (#5915) — the fast,
  // `deadlineNs == 0` path is the original single `netWrite` call, unchanged.
  // A short write is retried internally, so this either wrote every byte or
  // failed; a deadline elapsing first fails with `writeDeadline`'s own
  // "write timed out", not a fresh message, since it IS `writeDeadline` past
  // that branch.
  export write(s: string): ()! {
    if (this.deadlineNs != 0) {
      this.writeDeadline(s)?
      return
    }
    if (netWrite(this.fd, s) < 0) {
      fail newError("write failed")
    }
  }

  // Write all of `b`, bounded by the connection's deadline exactly as
  // `write(s: string)` is (#5928) — the same no-deadline fast path (blocks
  // until every byte is written, however slowly the peer drains, never
  // bounded by `netDeadlineMaxWaitNs`) and the same deadline-bound path when
  // `deadlineNs != 0`. `write` falls back to `netWrite`, a compiler builtin
  // that takes a `string`; turning `b` into one to reach it would be the
  // exact allocate-and-copy this method exists to avoid (std/http's
  // `serializeResponseInto` builds the wire response straight into a
  // `[]byte` and hands it here), so this reaches `bit_rt_net_write_bytes_w`
  // instead — `netAbiWrite`'s byte-taking sibling (runtime/net/{linux,
  // darwin,windows}/netabi.bit), calling the identical true-blocking
  // `netWriteSock` engine. A short write is retried internally, so this
  // either wrote every byte or failed.
  export writeBytes(b: []byte): ()! {
    let n = len(b)
    if (n == 0) {
      return
    }
    if (this.deadlineNs != 0) {
      let wrote = bit_rt_net_write_deadline_w(this.fd, ptrOf(b), n, this.deadlineNs)
      keepAlive(b)
      if (wrote == 0 - 2) {
        fail newError("write timed out")
      }
      if (wrote < 0) {
        fail newError("write failed")
      }
      return
    }
    let wrote = bit_rt_net_write_bytes_w(this.fd, ptrOf(b), n)
    keepAlive(b)
    if (wrote < 0) {
      fail newError("write failed")
    }
  }

  // Read until the peer closes. Only safe against a peer that actually closes —
  // a keep-alive protocol needs a framing layer instead.
  export readAll(): string {
    let out = ""
    while (true) {
      let chunk = this.read(4096)
      if (len(chunk) == 0) {
        return out
      }
      out = out + chunk
    }
  }

  // The peer's address as text: the dotted quad for an IPv4 peer ("127.0.0.1"),
  // RFC 5952 for an IPv6 one ("::1", "2001:db8::7": lowercase, the longest
  // zero run collapsed to "::"). An IPv4-mapped peer (`::ffff:192.0.2.7`, how a
  // `::` listener sees a v4-only client) prints as the IPv4 address it maps to,
  // so one client has one string whether the socket is dual-stack or not, and
  // is one rate-limit key. See ipaddr.bit.
  //
  // Fails, rather than returning a placeholder, whenever there is no peer to
  // name: a `Conn` that has been `close`d (its fd is -1 by then, so the kernel
  // answers EBADF), one whose peer hung up hard, or a peer whose address family
  // is neither AF_INET nor AF_INET6. A caller logging or rate-limiting by
  // address must see that difference — a sentinel string would silently bucket
  // every unknown peer together, which is exactly the failure mode the address
  // is being read for.
  export peerIp(): string! {
    let b = []byte(16)
    let rc = bit_rt_net_peer_addr_w(this.fd, ptrOf(b))
    keepAlive(b)
    if (rc < 0) {
      fail newError("could not read the peer's address")
    }
    return ipText(b)
  }

  // Idempotent: a second call is a no-op. Without this, a second close on an
  // already-closed connection closes whatever fd number the kernel has since
  // reassigned to a different, live socket.
  export close() {
    if (this.fd >= 0) {
      bit_rt_net_close_w(this.fd)
      this.fd = 0 - 1
    }
  }

  export shutdown() {
    if (this.fd >= 0) {
      let _ = bit_rt_net_shutdown_sock_w(this.fd)
    }
  }

  // Set (or, with `0`, clear) the absolute monotonic deadline `readDeadline`/
  // `writeDeadline` respect on this connection from now on. Does not reach back
  // to bound a `dial`/`dialDeadline` connect already completed.
  export setDeadline(deadlineNs: int) {
    this.deadlineNs = deadlineNs
  }

  // The absolute monotonic deadline this connection's reads and writes are
  // bounded by, or `0` for none. `deadlineNs` itself is internal state and
  // stays module-private (SPEC 10.5, enforced since #4631); a layer building
  // its own connection on top of a `Conn` needs to know only whether there is
  // a deadline and what it is, which is what this answers. `std/tls`'s
  // `TlsConn.deadlineNs()` is the same accessor one level up.
  //
  // Named `deadline` rather than `deadlineNs` because a method may not share a
  // name with a field of the same class: `structFieldLookup` answers first for
  // a member access, so `c.deadlineNs()` would read the FIELD and then try to
  // call an i64.
  export deadline(): int {
    return this.deadlineNs
  }

  // Up to `max` bytes, bounded by the connection's deadline (`dialDeadline`/
  // `setDeadline`; the zero value blocks like `read` — at most one hour
  // (`netDeadlineMaxWaitNs`, `runtime/net/net.bit`), a sanity ceiling against a
  // caller's unit typo, kept independent of `runtime/ABI.md` §19's
  // `os_run_bounded_max_ms` gate-timing clamp — #3720). An empty result is a
  // CLEAN CLOSE, exactly as `read`
  // reports it — an orderly end of stream, never an error. A timeout is a
  // `fail` whose message names it, so a caller distinguishes the two by
  // which one it got: a value back (even `""`) was never on the timeout path.
  export readDeadline(max: int): string! {
    if (max <= 0) {
      return ""
    }
    let w = []byte(max)
    let n = bit_rt_net_read_deadline_w(this.fd, ptrOf(w), max, this.deadlineNs)
    keepAlive(w)
    if (n == 0 - 2) {
      fail newError("read timed out")
    }
    if (n < 0) {
      fail newError("read failed")
    }
    if (n == 0) {
      return ""
    }
    return string(w[0:n])
  }

  // Like `readDeadline`, but into a caller-owned `buf` rather than a fresh
  // one — the allocation `readDeadline` makes on every call (#5850, #5857).
  // At most `min(max, len(buf))` bytes are read: the runtime writes through a
  // raw pointer, so a `max` past the buffer would write past its end, and it
  // is clamped here rather than trusted. The bytes land at `buf[0:n]` and the
  // caller reads them out (a slice, a copy — its choice) before the next call,
  // which overwrites the same backing storage. Same failure modes as
  // `readDeadline`: a `fail` naming the timeout or a read failure, `0` for a
  // clean close.
  //
  // The kernel reads straight into `buf`'s backing (#5890); the runtime holds
  // no copy of its own. `keepAlive(buf)` after the call is what keeps that
  // backing live across every poll and park inside it, and `readDeadline`
  // and `writeDeadline` keep theirs the same way. The runtime side of the
  // contract is the "WHY THE BUFFERS HERE ARE MANAGED" header of
  // runtime/net/linux/netabi.bit.
  export readDeadlineInto(buf: []byte, max: int): int! {
    let want = max
    if (want > len(buf)) {
      want = len(buf)
    }
    if (want <= 0) {
      return 0
    }
    let n = bit_rt_net_read_deadline_w(this.fd, ptrOf(buf), want, this.deadlineNs)
    keepAlive(buf)
    if (n == 0 - 2) {
      fail newError("read timed out")
    }
    if (n < 0) {
      fail newError("read failed")
    }
    return n
  }

  // Write all of `s`, bounded by the connection's deadline. `()!` already, so
  // no new distinguishing shape is needed: a plain error is a hard I/O
  // failure, an error naming the timeout is the deadline elapsing first.
  //
  // One packed copy of `s` is the only one: `ptrOf` takes a slice, never a
  // `string` (SPEC §11.5), so the bytes cannot cross without it. The kernel
  // reads `w` directly and `keepAlive(w)` holds it across the call.
  export writeDeadline(s: string): ()! {
    let n = len(s)
    if (n == 0) {
      return
    }
    let w = []byte(s)
    let wrote = bit_rt_net_write_deadline_w(this.fd, ptrOf(w), n, this.deadlineNs)
    keepAlive(w)
    if (wrote == 0 - 2) {
      fail newError("write timed out")
    }
    if (wrote < 0) {
      fail newError("write failed")
    }
  }
}

// #2314: `netListen`/`netDial`/`netUdpBind` return `0 - errno` when the
// failure reached a real syscall (#2343) and the flat sentinel `-1` when it
// didn't — a malformed host, or a port outside 0-65535, neither of which has
// a kernel cause to report. Appending the errno number to the message lets
// two different failures (EADDRINUSE vs EACCES, say) read differently
// instead of both collapsing to the same "<op> host:port failed". It's the
// raw platform number, not a symbolic name: EADDRINUSE/EADDRNOTAVAIL/
// ECONNREFUSED are numbered completely differently on Darwin vs Linux, and
// no errno-to-name table is reachable from here without either a runtime
// change or per-platform source under this module — out of this ticket's
// scope (`stdlib/net/**` only).
fn netFailMsg(op: string, host: string, port: int, fd: i64): string {
  if (fd < 0 - 1) {
    return "${op} ${host}:${port} failed: errno ${0 - fd}"
  }
  return "${op} ${host}:${port} failed"
}

// Listen for TCP connections on `host:port`.
//
// `port` may be 0, which asks the kernel to pick a free one — ask the returned
// listener for `port()` to find out which. That is the reliable way to bind in a
// test: picking a number yourself races every other process on the machine.
export fn listen(host: string, port: int): Listener! {
  let fd = netListen(host, port)
  if (fd < 0) {
    fail newError(netFailMsg("listen", host, port, fd))
  }
  return Listener{ fd = fd }
}

// Connect to `host:port`. A refused connection fails here, not at the first
// write.
export fn dial(host: string, port: int): Conn! {
  let fd = netDial(host, port)
  if (fd < 0) {
    fail newError(netFailMsg("dial", host, port, fd))
  }
  return Conn{ fd = fd }
}

// Shut both directions of the connection down WITHOUT releasing the fd (#3016)
// — unlike `close`, a later `dial`/`listen`/`accept` elsewhere in this process
// cannot reuse the number until `close` follows this. Idempotent (a no-op once
// `close` has run); does not clear `fd`, since `read`/`write`/`close` still need
// it afterward.
//
// `close` ITSELF NOW WAKES A PARKED READER TOO (#5865, darwin only so far —
// #5866 tracks linux). This function predates that: it exists because closing
// the fd out from under a green thread parked reading it did NOT used to wake
// it — closing tore the descriptor down without notifying an existing
// registration for it at all, so the parked read simply never returned.
// Shutting the socket down instead is a real state transition on the
// still-open descriptor the parked read is registered against, which the
// kernel reports as newly readable (an orderly EOF) — a wakeup `close` alone
// did not produce. `std/http2`'s `Conn.waitReaderDone` (stdlib/http2/conn.bit)
// and its caller `h2clientExchange` (stdlib/http/h2.bit) still use this
// shutdown-then-close shape and do not need to change: it remains correct on
// every platform, `close` alone is just no longer the ONLY way on darwin.
extern fn bit_rt_net_shutdown_sock_w(fd: i64): bool

// `bit_rt_net_close_w` (#5865): the actual OS `close(fd)`, routed through the
// platform's own `netClose` rather than a generic filesystem close, so a
// platform that has wired persistent poll registrations up to it (darwin)
// retracts them and wakes a still-parked reader before the fd number can be
// reused. A no-op return; nothing here reports failure, matching `fsClose`'s
// own contract, which this call directly replaces in `close()` below.
extern fn bit_rt_net_close_w(fd: i64)

// The connected peer's address for `fd` written to `out`, 16 bytes in the IPv6
// wire form (an IPv4 peer as its IPv4-mapped `::ffff:a.b.c.d`): 0, or -1 when
// there is no peer at all — an unconnected or listening socket, a closed one, or
// a peer whose family is neither AF_INET nor AF_INET6. `Conn.peerIp` above is
// the only caller and renders the bytes (ipaddr.bit).
//
// A plain `extern fn`, not a compiler builtin, for the reason
// `bit_rt_net_shutdown_sock_w` above and `bit_rt_net_dial_deadline_w` below
// are: a builtin buys nothing for an `(i64, *byte) -> i64` signature — it exists
// for the ones an `extern` cannot express, SPEC §11.7 — and it could not be
// reached from here anyway until the next stage0 repin, because `make selfhost`
// compiles this file with the PINNED stage0 (`compiler/pmfetch.bit` imports
// `std/http`, which imports this module). `out` is held live across the call
// with `keepAlive`.
extern fn bit_rt_net_peer_addr_w(fd: i64, out: *byte): i64

// One received datagram: its bytes and the address it came from. The address is
// what a server replies to — UDP has no connection to reply over.
export class Datagram { export data: string, export host: string, export port: int }

// A UDP socket. Connectionless: there is no accept or dial, you send and receive
// datagrams straight off the socket, each carrying its own destination.
export class UdpSocket {
  fd: i64
  // The port this socket is bound to. Meaningful even when 0 was requested.
  export port(): int! {
    let p = netLocalPort(this.fd)
    if (p < 0) {
      fail newError("could not read the socket's port")
    }
    return p
  }

  // Send one datagram to `host:port`. All-or-nothing: a datagram is never
  // partially sent, so success means every byte went.
  export send(host: string, port: int, data: string): ()! {
    if (netUdpSend(this.fd, host, port, data) < 0) {
      fail newError("udp send to ${host}:${port} failed")
    }
  }

  // Receive the next datagram, up to `max` bytes, parking until one arrives. The
  // returned `Datagram` carries the sender's address. A zero-length datagram is
  // legal and is not an error — unlike a TCP read, empty does not mean "closed".
  export recv(max: int): Datagram! {
    let data = netUdpRecv(this.fd, max)
    let port = netUdpSenderPort()
    if (port < 0) {
      fail newError("udp recv failed")
    }
    let host = netUdpSenderHost()
    return Datagram{ data = data, host = host, port = port }
  }

  // Idempotent: a second call is a no-op. Without this, a second close on an
  // already-closed socket closes whatever fd number the kernel has since
  // reassigned to a different, live socket.
  export close() {
    if (this.fd >= 0) {
      bit_rt_net_close_w(this.fd)
      this.fd = 0 - 1
    }
  }
}

// Bind a UDP socket to `host:port`. Like `listen`, `port` may be 0 to let the
// kernel choose one — read it back with `port()`.
export fn udpBind(host: string, port: int): UdpSocket! {
  let fd = netUdpBind(host, port)
  if (fd < 0) {
    fail newError(netFailMsg("udp bind", host, port, fd))
  }
  return UdpSocket{ fd = fd }
}

// `bit_rt_net_resolve_w` (#6350): the first A record of the host
// `host[0..hostLen)` written into `out` (at least 16 bytes) as a dotted quad,
// its byte count returned; -1 once every nameserver failed. `timeoutMs` is ONE
// attempt's receive window and `attempts` how many each nameserver gets: both
// are this module's (`DnsPolicy`, dnsconf.bit), the runtime has no default.
// A plain `extern fn`, not a builtin: SPEC §11.7 admits no `string` across that
// boundary, and a new builtin arity could not be reached from here until the
// next stage0 repin, because `make selfhost` compiles this file with the PINNED
// stage0. Both buffers are packed `[]byte` backings held live with `keepAlive`.
extern fn bit_rt_net_resolve_w(
  host: *byte,
  hostLen: int,
  timeoutMs: int,
  attempts: int,
  out: *byte,
): int

// The longest dotted quad is 15 bytes; the runtime wants 16.
const resolveOutCap: int = 16

// Resolve a hostname to an IPv4 address (dotted quad) via the system resolver
// (every nameserver in /etc/resolv.conf, in order). A dotted-quad argument or an
// IPv6 literal (`isIpv6Literal`, no brackets) is returned unchanged, so it is
// safe to call on an address that may already be numeric.
//
// Each nameserver is asked under resolv.conf's `options timeout:N attempts:N`
// (defaults 5 s and 2 attempts, glibc's), see `resolveBudgetMs`.
//
// Only A records — no AAAA, no search domains, no caching. Pair it with `dial`:
// `dial(resolve("example.com")?, 80)`.
export fn resolve(host: string): string! {
  if (isIpv6Literal(host)) {
    return host
  }
  return resolveUnder(host, readDnsPolicy())?
}

// `resolve` under an explicit policy: the seam the tests give a short budget.
fn resolveUnder(host: string, p: DnsPolicy): string! {
  let packed = []byte(len(host) + 1)
  let i = 0
  while (i < len(host)) {
    packed[i] = host[i]
    i = i + 1
  }
  let out = []byte(resolveOutCap)
  let n = bit_rt_net_resolve_w(ptrOf(packed), len(host), p.timeoutMs, p.attempts, ptrOf(out))
  keepAlive(packed)
  keepAlive(out)
  if (n <= 0 || n > resolveOutCap) {
    fail newError("could not resolve ${host}")
  }
  return string(out[0:n])
}

// `bit_rt_net_lookup_txt_w` (#6882): the TXT records of a host, as a list of
// entries each a two-byte big-endian length then that many bytes, written into
// `out` (`txtOutCap` bytes). `in` holds a 16-byte budget header (`txtHeaderBytes`:
// `timeoutMs`, then `attempts`, each a little-endian 64-bit word, this module's
// `DnsPolicy` as `resolve` passes it; it rides in the buffer because the entry
// point is at the five-parameter lint ceiling), then the host (`hostLen` bytes)
// and then, when `nsLen > 0`, ONE nameserver's address text (IPv4 or IPv6),
// `port` being its port; `nsLen == 0` asks every nameserver in /etc/resolv.conf
// in order on port 53. Returns the bytes written (0: the name has no TXT record), -1 on a timeout
// or server failure, -2 for a malformed reply, -3 where the runtime has no TXT
// lookup (Windows). A plain `extern fn`, not a builtin, for the reason
// `bit_rt_net_peer_addr_w` above gives; both buffers cross as packed `[]byte`
// backings and are held live across the call with `keepAlive`.
extern fn bit_rt_net_lookup_txt_w(
  inBytes: *byte,
  hostLen: int,
  nsLen: int,
  port: int,
  out: *byte,
): int

// The size of `out` the runtime requires: a TCP reply is at most 65535 bytes and
// the entries written from it never outgrow it, plus the last entry's length.
const txtOutCap: int = 65537

// The budget header `bit_rt_net_lookup_txt_w`'s `in` opens with: two words.
const txtHeaderBytes: int = 16

// `v` (not negative) as eight little-endian bytes at `b[off..off+8)`.
fn putWordLe(b: []byte, off: int, v: int) {
  let x = v
  let k = 0
  while (k < 8) {
    b[off + k] = byte(x % 256)
    x = x / 256
    k = k + 1
  }
}

// The runtime's request: the budget header, then `host`, then `ns`, as one
// packed byte buffer.
fn txtPack(host: string, ns: string, p: DnsPolicy): []byte {
  let n = txtHeaderBytes + len(host) + len(ns)
  let b = []byte(n)
  putWordLe(b, 0, p.timeoutMs)
  putWordLe(b, 8, p.attempts)
  let i = 0
  while (i < len(host)) {
    b[txtHeaderBytes + i] = host[i]
    i = i + 1
  }
  let j = 0
  while (j < len(ns)) {
    b[txtHeaderBytes + len(host) + j] = ns[j]
    j = j + 1
  }
  return b
}

// Splits the runtime's `out[0..n)` (length-prefixed entries) into strings, or
// fails when an entry runs past `n`: the runtime wrote it, so this is a guard
// on the layout, never a branch a reply can reach.
fn txtEntries(name: string, out: []byte, n: int): []string! {
  let entries: []string = []
  let p = 0
  while (p < n) {
    if (p + 2 > n) {
      fail newError("lookupTxt ${name}: malformed reply")
    }
    let l = int(out[p]) * 256 + int(out[p + 1])
    if (p + 2 + l > n) {
      fail newError("lookupTxt ${name}: malformed reply")
    }
    entries = append(entries, string(out[p + 2:p + 2 + l]))
    p = p + 2 + l
  }
  return entries
}

// `lookupTxt` against an explicit nameserver `ns:port` (`ns == ""` is the
// system resolver). Unexported: the seam the tests point at a fake DNS server on
// 127.0.0.1, since 53 cannot be bound without root, and give a short budget.
fn lookupTxtVia(name: string, ns: string, port: int, p: DnsPolicy): []string! {
  let n = len(name)
  // A trailing dot spells the root (`example.com.`); the wire format has no
  // empty label for it.
  if (n > 1 && name[n - 1] == '.') {
    n = n - 1
  }
  if (n == 0 || n > 253) {
    fail newError("lookupTxt ${name}: invalid name")
  }
  let packed = txtPack(name[0:n], ns, p)
  let out = []byte(txtOutCap)
  let rc = bit_rt_net_lookup_txt_w(ptrOf(packed), n, len(ns), port, ptrOf(out))
  keepAlive(packed)
  keepAlive(out)
  if (rc == 0 - 2) {
    fail newError("lookupTxt ${name}: malformed reply")
  }
  if (rc == 0 - 3) {
    fail newError("lookupTxt ${name}: not supported on this platform")
  }
  if (rc < 0) {
    fail newError("lookupTxt ${name}: no answer (timeout or server failure)")
  }
  return txtEntries(name, out, rc)?
}

// The TXT records of `name` through the system resolver: one entry per record,
// the record's character-strings joined in order with nothing between them
// (RFC 7208 section 3.3, RFC 6376 section 3.6.2.2), as the raw bytes the server
// sent. A name with no TXT record, NXDOMAIN included, is an empty list, not an
// error; a timeout, a SERVFAIL, a malformed reply and a platform without the
// lookup (Windows) fail.
//
// Asked like `resolve`: every nameserver in /etc/resolv.conf in turn, each for
// at most the same per-server budget (`resolveBudgetMs`), and a reply truncated
// over UDP is asked again over TCP (RFC 7766) inside that budget, since a
// 2048-bit DKIM key does not fit 512 bytes. That retry reaches IPv4 nameservers
// only. `lookupTxt("sel._domainkey.example.com")` is how a mailer reads its
// published DKIM key.
export fn lookupTxt(name: string): []string! {
  return lookupTxtVia(name, "", 0, readDnsPolicy())?
}

// ---------------------------------------------------------------------------
// Deadline-bounded operations (#2291)
// ---------------------------------------------------------------------------
//
// A server that completes the handshake (or accepts a connection) and then
// never writes parks `dial`/`read` forever — nothing above bounds the wait.
// These give a caller a way to defend itself: an ABSOLUTE monotonic deadline
// (`std/time`'s `monotonic()` plus a budget), resolved ONCE and carried by
// the `Conn` it produces, so a whole request's connect, write and read can
// share the SAME deadline without restarting it per operation — the pattern
// `runtime/ABI.md` §19's `osForkExecWaitBounded` documents. A timeout is a
// `fail`; a clean close is `Ok("")` from `readDeadline`, exactly as `read`
// reports it — the two are never confusable by a caller checking which one
// it got.
//
// Reached through a plain `extern fn`, not a compiler-recognized builtin
// (SPEC §11.7 admits no `string` across that boundary), so `host`/the body
// cross as a packed `[]byte` and a length — the same shape `std/fs`'s
// `bit_rt_fs_is_symlink_w` uses.
extern fn bit_rt_net_dial_deadline_w(host: *byte, hostLen: int, port: int, deadlineNs: i64): i64
extern fn bit_rt_net_read_deadline_w(fd: i64, out: *byte, cap: int, deadlineNs: i64): i64
extern fn bit_rt_net_write_deadline_w(fd: i64, data: *byte, n: int, deadlineNs: i64): i64

// `bit_rt_net_write`'s byte-taking sibling (#5928): same `data`/`n` packed
// shape as `bit_rt_net_write_deadline_w` above, but the true-blocking,
// never-give-up engine `write(s: string)`'s own no-deadline fast path uses
// — `Conn.writeBytes`'s no-deadline branch, not this section's deadline
// machinery, is the only caller.
extern fn bit_rt_net_write_bytes_w(fd: i64, data: *byte, n: int): i64

// `bit_rt_net_read`'s byte-taking sibling (#7389), the read-side twin of
// `bit_rt_net_write_bytes_w`: `Conn.readInto`'s no-deadline branch.
extern fn bit_rt_net_read_bytes_w(fd: i64, out: *byte, cap: int): i64

// Connect to `host:port`, bounded by `deadlineNs` (an absolute monotonic
// nanosecond deadline, not a duration — `monotonic() + budget`) rather than
// parking forever. The returned `Conn` remembers `deadlineNs` and
// `readDeadline`/`writeDeadline` on it reuse the SAME value automatically, so
// a caller does not have to re-derive or re-pass it per operation.
export fn dialDeadline(host: string, port: int, deadlineNs: int): Conn! {
  let n = len(host)
  if (n == 0 || n > 255) {
    fail newError("dial ${host}:${port} failed")
  }
  let w = []byte(n)
  let i = 0
  while (i < n) {
    w[i] = host[i]
    i = i + 1
  }
  let fd = bit_rt_net_dial_deadline_w(ptrOf(w), n, port, deadlineNs)
  if (fd == 0 - 2) {
    fail newError("dial ${host}:${port} timed out")
  }
  if (fd < 0) {
    fail newError("dial ${host}:${port} failed")
  }
  return Conn{ fd = fd, deadlineNs = deadlineNs }
}

