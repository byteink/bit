// stdlib/net/gen_idna.test.bit — #6880. The generated UTS #46 tables
// (gen_idna.bit), checked from three sides: the values the ticket names (one
// per status, each also above U+FFFF where the table has one), counts over the
// whole scalar range that need no outside file, and — when BIT_IDNA_TABLE
// names a copy of IdnaMappingTable.txt 17.0.0 — every line of that file.
//
// The source file is not in the repository, so the last check is opt-in:
//
//   BIT_IDNA_TABLE=<path>/IdnaMappingTable.txt bit test stdlib/net

import { env } from "std/os"

fn idnaTestSeq(a: []rune, want: []int): bool {
  if (len(a) != len(want)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (int(a[i]) != want[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

fn expectIdna(cp: int, status: int, mapping: []int) {
  assert(
    idnaStatus(rune(cp)) == status,
    "idnaStatus(U+${toHex(cp)}) = ${idnaStatus(rune(cp))}, want ${status}",
  )
  assert(idnaTestSeq(idnaMapping(rune(cp)), mapping), "idnaMapping(U+${toHex(cp)})")
}

fn toHex(v: int): string {
  let digits = "0123456789ABCDEF"
  let out = ""
  let n = v
  while (n > 0) {
    out = digits[n % 16:n % 16 + 1] + out
    n = n / 16
  }
  if (len(out) == 0) {
    return "0"
  }
  return out
}

test "idnaStatus and idnaMapping name the five statuses" {
  expectIdna(0x41, idnaMapped, []int{ 0x61 })
  expectIdna(0xDF, idnaDeviation, []int{ 0x73, 0x73 })
  expectIdna(0xAD, idnaIgnored, []int(0))
  expectIdna(0x80, idnaDisallowed, []int(0))
  expectIdna(0xD800, idnaDisallowed, []int(0))
  // Since Unicode 16 the ASCII controls and punctuation are `valid` (with an
  // IDNA2008 NV8 note): UseSTD3ASCIIRules, the caller's flag, rejects them.
  expectIdna(0x0, idnaValid, []int(0))
  expectIdna(0x2F, idnaValid, []int(0))
  expectIdna(0x61, idnaValid, []int(0))
  expectIdna(0xFF0E, idnaMapped, []int{ 0x2E })
  expectIdna(0x3C2, idnaDeviation, []int{ 0x3C3 })
  expectIdna(0x200C, idnaDeviation, []int(0))
  expectIdna(0x200D, idnaDeviation, []int(0))
  expectIdna(0xA8, idnaMapped, []int{ 0x20, 0x308 })
  expectIdna(0x132, idnaMapped, []int{ 0x69, 0x6A })
  expectIdna(0x133, idnaMapped, []int{ 0x69, 0x6A })
  expectIdna(0x134, idnaMapped, []int{ 0x135 })
  expectIdna(
    0xFDFA,
    idnaMapped,
    []int{
      0x635, 0x644, 0x649, 0x20, 0x627, 0x644, 0x644, 0x647, 0x20, 0x639, 0x644,
      0x64A, 0x647, 0x20, 0x648, 0x633, 0x644, 0x645,
    },
  )
}

test "idnaStatus and idnaMapping above U+FFFF" {
  expectIdna(0x10000, idnaValid, []int(0))
  expectIdna(0x1D400, idnaMapped, []int{ 0x61 })
  expectIdna(0x1E900, idnaMapped, []int{ 0x1E922 })
  expectIdna(0x1BCA0, idnaIgnored, []int(0))
  expectIdna(0xE0100, idnaIgnored, []int(0))
  expectIdna(0xE01EF, idnaIgnored, []int(0))
  expectIdna(0xE01F0, idnaDisallowed, []int(0))
  expectIdna(0x100000, idnaDisallowed, []int(0))
  expectIdna(0x10FFFF, idnaDisallowed, []int(0))
}

test "a rune outside the scalar range is disallowed and has no mapping" {
  expectIdna(0x110000, idnaDisallowed, []int(0))
  expectIdna(0x7FFFFFFF, idnaDisallowed, []int(0))
  expectIdna(-1, idnaDisallowed, []int(0))
  assert(bidiClass(rune(0x110000)) == bidiL, "bidiClass above the range")
  assert(joiningType(rune(0x110000)) == joinU, "joiningType above the range")
  assert(!isVirama(rune(0x110000)), "isVirama above the range")
  assert(!isVirama(rune(-1)), "isVirama below the range")
}

test "bidiClass is the Bidi_Class of the code point" {
  assert(bidiClass(rune(0x41)) == bidiL, "A")
  assert(bidiClass(rune(0x5D0)) == bidiR, "HEBREW ALEF")
  assert(bidiClass(rune(0x627)) == bidiAL, "ARABIC ALEF")
  assert(bidiClass(rune(0x660)) == bidiAN, "ARABIC-INDIC DIGIT ZERO")
  assert(bidiClass(rune(0x30)) == bidiEN, "DIGIT ZERO")
  assert(bidiClass(rune(0x2B)) == bidiES, "PLUS SIGN")
  assert(bidiClass(rune(0x24)) == bidiET, "DOLLAR SIGN")
  assert(bidiClass(rune(0x2C)) == bidiCS, "COMMA")
  assert(bidiClass(rune(0x300)) == bidiNSM, "COMBINING GRAVE ACCENT")
  assert(bidiClass(rune(0x200B)) == bidiBN, "ZERO WIDTH SPACE")
  assert(bidiClass(rune(0xA)) == bidiB, "LINE FEED")
  assert(bidiClass(rune(0x9)) == bidiS, "TAB")
  assert(bidiClass(rune(0x20)) == bidiWS, "SPACE")
  assert(bidiClass(rune(0x21)) == bidiON, "EXCLAMATION MARK")
  assert(bidiClass(rune(0x202A)) == bidiLRE, "LRE")
  assert(bidiClass(rune(0x202D)) == bidiLRO, "LRO")
  assert(bidiClass(rune(0x202B)) == bidiRLE, "RLE")
  assert(bidiClass(rune(0x202E)) == bidiRLO, "RLO")
  assert(bidiClass(rune(0x202C)) == bidiPDF, "PDF")
  assert(bidiClass(rune(0x2066)) == bidiLRI, "LRI")
  assert(bidiClass(rune(0x2067)) == bidiRLI, "RLI")
  assert(bidiClass(rune(0x2068)) == bidiFSI, "FSI")
  assert(bidiClass(rune(0x2069)) == bidiPDI, "PDI")
}

test "bidiClass above U+FFFF and for unassigned code points" {
  assert(bidiClass(rune(0x10800)) == bidiR, "CYPRIOT SYLLABLE A")
  assert(bidiClass(rune(0x1E900)) == bidiR, "ADLAM CAPITAL LETTER ALIF")
  assert(bidiClass(rune(0x10D01)) == bidiAL, "HANIFI ROHINGYA LETTER A")
  assert(bidiClass(rune(0x1EE00)) == bidiAL, "ARABIC MATHEMATICAL ALEF")
  assert(bidiClass(rune(0x1D400)) == bidiL, "MATHEMATICAL BOLD CAPITAL A")
  assert(bidiClass(rune(0x10A3F)) == bidiNSM, "KHAROSHTHI VIRAMA")
  assert(bidiClass(rune(0xE0001)) == bidiBN, "LANGUAGE TAG")
  assert(bidiClass(rune(0x10FFFF)) == bidiBN, "a noncharacter")
  assert(bidiClass(rune(0x5FF)) == bidiR, "unassigned in Hebrew: @missing R")
  assert(bidiClass(rune(0x20CF)) == bidiET, "unassigned in Currency Symbols: @missing ET")
  assert(bidiClass(rune(0x870)) == bidiAL, "ARABIC SMALL HIGH WORD AR-RUB, in an AL block")
  assert(bidiClass(rune(0x378)) == bidiL, "unassigned elsewhere: L")
}

test "joiningType is the Joining_Type of the code point" {
  assert(joiningType(rune(0x640)) == joinC, "ARABIC TATWEEL")
  assert(joiningType(rune(0x200D)) == joinC, "ZERO WIDTH JOINER")
  assert(joiningType(rune(0x628)) == joinD, "ARABIC BEH")
  assert(joiningType(rune(0x622)) == joinR, "ARABIC ALEF WITH MADDA ABOVE")
  assert(joiningType(rune(0xA872)) == joinL, "PHAGS-PA SUPERFIXED LETTER RA")
  assert(joiningType(rune(0x300)) == joinT, "COMBINING GRAVE ACCENT")
  assert(joiningType(rune(0x621)) == joinU, "ARABIC HAMZA")
  assert(joiningType(rune(0x200C)) == joinU, "ZERO WIDTH NON-JOINER")
  assert(joiningType(rune(0x41)) == joinU, "A")
  assert(joiningType(rune(0x10D01)) == joinD, "HANIFI ROHINGYA LETTER A")
  assert(joiningType(rune(0x10A3F)) == joinT, "KHAROSHTHI VIRAMA")
  assert(joiningType(rune(0x10FFFF)) == joinU, "the last scalar value")
}

test "isVirama is canonical combining class 9" {
  assert(isVirama(rune(0x94D)), "DEVANAGARI SIGN VIRAMA")
  assert(isVirama(rune(0x9CD)), "BENGALI SIGN VIRAMA")
  assert(isVirama(rune(0x1039)), "MYANMAR SIGN VIRAMA")
  assert(isVirama(rune(0x10A3F)), "KHAROSHTHI VIRAMA")
  assert(isVirama(rune(0x1612F)), "the last virama")
  assert(!isVirama(rune(0x915)), "DEVANAGARI KA")
  assert(!isVirama(rune(0x93C)), "DEVANAGARI NUKTA, class 7")
  assert(!isVirama(rune(0x94C)), "DEVANAGARI VOWEL SIGN AU")
  assert(!isVirama(rune(0x300)), "COMBINING GRAVE ACCENT")
  assert(!isVirama(rune(0x0)), "NUL")
}

// Counts over every scalar value, derived from the source files (UCD 17.0.0)
// with a parse written separately from the generator's.
test "whole-range counts match the source tables" {
  let status = []int{ 0, 0, 0, 0, 0 }
  let bidi = []int(23)
  let joining = []int(6)
  let viramas = 0
  let mappedRunes = 0
  let c = 0
  while (c <= 0x10FFFF) {
    let r = rune(c)
    let s = idnaStatus(r)
    assert(s >= 0 && s < 5, "status out of range at U+${toHex(c)}")
    status[s] = status[s] + 1
    let m = idnaMapping(r)
    if (s != idnaMapped && s != idnaDeviation) {
      assert(len(m) == 0, "mapping on a status without one at U+${toHex(c)}")
    }
    if (s == idnaMapped) {
      assert(len(m) > 0, "empty mapping on a mapped code point at U+${toHex(c)}")
      mappedRunes = mappedRunes + len(m)
    }
    let b = bidiClass(r)
    assert(b >= 0 && b < 23, "bidi out of range at U+${toHex(c)}")
    bidi[b] = bidi[b] + 1
    let j = joiningType(r)
    assert(j >= 0 && j < 6, "joining out of range at U+${toHex(c)}")
    joining[j] = joining[j] + 1
    if (isVirama(r)) {
      viramas = viramas + 1
    }
    c = c + 1
  }
  assert(status[idnaValid] == 152965, "valid: ${status[idnaValid]}")
  assert(status[idnaIgnored] == 294, "ignored: ${status[idnaIgnored]}")
  assert(status[idnaMapped] == 6377, "mapped: ${status[idnaMapped]}")
  assert(status[idnaDeviation] == 4, "deviation: ${status[idnaDeviation]}")
  assert(status[idnaDisallowed] == 954472, "disallowed: ${status[idnaDisallowed]}")
  assert(bidi[bidiL] == 1095407 && bidi[bidiR] == 3631 && bidi[bidiAL] == 1731, "L/R/AL")
  assert(bidi[bidiAN] == 73 && bidi[bidiEN] == 178 && bidi[bidiES] == 12, "AN/EN/ES")
  assert(bidi[bidiET] == 92 && bidi[bidiCS] == 15 && bidi[bidiNSM] == 2067, "ET/CS/NSM")
  assert(bidi[bidiBN] == 4016 && bidi[bidiB] == 7 && bidi[bidiS] == 3, "BN/B/S")
  assert(bidi[bidiWS] == 17 && bidi[bidiON] == 6854, "WS/ON")
  assert(
    bidi[bidiLRE] + bidi[bidiLRO] + bidi[bidiRLE] + bidi[bidiRLO] + bidi[bidiPDF] == 5,
    "embeddings",
  )
  assert(bidi[bidiLRI] + bidi[bidiRLI] + bidi[bidiFSI] + bidi[bidiPDI] == 4, "isolates")
  assert(joining[joinC] == 7 && joining[joinD] == 615 && joining[joinL] == 5, "C/D/L")
  assert(joining[joinR] == 153 && joining[joinT] == 2224 && joining[joinU] == 1111108, "R/T/U")
  assert(viramas == 69, "viramas: ${viramas}")
  print("scalar values swept: ${c}; mapped runes ${mappedRunes}\n")
}

// One IdnaMappingTable.txt data line: `lo[..hi] ; status [; mapping] # comment`.
fn checkIdnaLine(line: string): int {
  let body = line
  let hash = indexOf(line, "#")
  if (hash >= 0) {
    body = line[0:hash]
  }
  if (len(trimSpace(body)) == 0) {
    return 0
  }
  let fields = split(body, ";")
  let range = trimSpace(fields[0])
  let lo = idnaTestHex(range)
  let hi = lo
  let dots = indexOf(range, "..")
  if (dots >= 0) {
    lo = idnaTestHex(range[0:dots])
    hi = idnaTestHex(range[dots + 2:len(range)])
  }
  let want = idnaTestStatus(trimSpace(fields[1]))
  let mapping: []int = []int(0)
  if (len(fields) > 2 && (want == idnaMapped || want == idnaDeviation)) {
    mapping = idnaTestRunes(trimSpace(fields[2]))
  }
  let c = lo
  while (c <= hi) {
    expectIdna(c, want, mapping)
    c = c + 1
  }
  return hi - lo + 1
}

fn idnaTestHex(s: string): int {
  let v = 0
  let i = 0
  while (i < len(s)) {
    let d = int(s[i])
    if (d <= int('9')) {
      v = v * 16 + d - int('0')
    } else {
      v = v * 16 + d - int('A') + 10
    }
    i = i + 1
  }
  return v
}

fn idnaTestRunes(s: string): []int {
  let out: []int = []int(0)
  if (len(s) == 0) {
    return out
  }
  let parts = split(s, " ")
  let i = 0
  while (i < len(parts)) {
    out = append(out, idnaTestHex(parts[i]))
    i = i + 1
  }
  return out
}

fn idnaTestStatus(name: string): int {
  if (name == "valid") {
    return idnaValid
  }
  if (name == "ignored") {
    return idnaIgnored
  }
  if (name == "mapped") {
    return idnaMapped
  }
  if (name == "deviation") {
    return idnaDeviation
  }
  assert(name == "disallowed", "unknown IDNA status '${name}'")
  return idnaDisallowed
}

test "every line of IdnaMappingTable.txt agrees with the tables" {
  let path = env("BIT_IDNA_TABLE")
  if (len(path) == 0) {
    print("skipped: BIT_IDNA_TABLE is not set\n")
    return
  }
  let text = readFile(path) catch e {
    panic("reading ${path}: ${e.message()}")
  }
  let lines = split(text, "\n")
  let swept = 0
  let i = 0
  while (i < len(lines)) {
    swept = swept + checkIdnaLine(trimSpace(lines[i]))
    i = i + 1
  }
  assert(swept == 0x110000, "the source file covers ${swept} code points")
  print("IdnaMappingTable.txt: ${len(lines)} lines, ${swept} code points checked\n")
}
