// stdlib/net/net.test.bit — `Conn.peerIp()` (#4526).
//
// Everything here runs over loopback, so both ends and the listener are
// 127.0.0.1 and the assertion is an exact string rather than a shape.
//
// THAT SAMENESS IS ALSO THE TRAP, and the reason the third assertion below
// exists. A `peerIp()` that read the LOCAL address by mistake — the one-word
// slip of `getsockname` for `getpeername` — returns "127.0.0.1" for both
// connected ends and passes the first two assertions unchanged. Only a socket
// that HAS a local address and no peer separates the two, so the listener is
// asked as well and must fail.
//
// `listen`, `dial` and `Conn` are siblings in this same module (net.bit), so
// they are not imported. `std/time` is the one import: `monotonic`/`since`
// time a read path for the #5428 test below, and `sleep` gives the #5958
// "data already ready" test a moment for the loopback write to actually
// land before that test arms a past deadline — otherwise it races the
// kernel, not the deadline logic.
import { monotonic, since, sleep } from "std/time"

test "peerIp reads 127.0.0.1 on both ends of a loopback connection" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  // Sequential, no spawn: the kernel completes a loopback handshake against the
  // backlog, so `dial` returns before anyone calls `accept`.
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }

  let seen = a.peerIp() catch e {
    assert(false, "peerIp on the accepted conn: ${e.message()}")
    return
  }
  assert(seen == "127.0.0.1", "accepted conn peerIp = '${seen}'")

  let dialed = c.peerIp() catch e {
    assert(false, "peerIp on the dialing conn: ${e.message()}")
    return
  }
  assert(dialed == "127.0.0.1", "dialing conn peerIp = '${dialed}'")

  // The listener has a local address and no peer. Reading it through a `Conn`
  // over the same fd must FAIL — this is what distinguishes the peer address
  // from the local one on loopback, where the two are the same string.
  let asConn = Conn{ fd = l.fd, deadlineNs = 0 }
  let bad = asConn.peerIp() catch _ {
    a.close()
    c.close()
    l.close()
    return
  }
  assert(false, "a listener has no peer, but peerIp returned '${bad}'")
  a.close()
  c.close()
  l.close()
}

test "peerIp on a closed conn fails with an error rather than panicking" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  c.close()

  // Reaching this line at all is half the assertion: `close` leaves fd -1, and
  // the failure has to arrive as an error the caller can catch, not as a panic
  // that takes the process down.
  let leaked = c.peerIp() catch e {
    assert(len(e.message()) > 0, "the failure carries no message")
    a.close()
    l.close()
    return
  }
  assert(false, "a closed conn has no peer, but peerIp returned '${leaked}'")
  a.close()
  l.close()
}

// #5915 — `Conn.read()` used to ignore `deadlineNs` entirely: a caller that
// called `setDeadline` and then `read()` against a silent peer parked
// forever, exactly the trap #5912's agent had to route around with
// `readDeadline` instead. This hangs the suite on the old code (`read()`
// never returns) and passes here inside `elapsedMs < 1000` — `read()`'s
// signature has no room for a distinct timeout error, so `readTimedOut()`
// is what tells this apart from an ordinary clean close.
test "read against a silent peer times out instead of blocking forever" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  // `c` never writes anything: `a` is the silent peer `read()` must not park
  // on forever once its own deadline is armed.
  a.setDeadline(monotonic().ns + 50000000)
  let start = monotonic()
  let out = a.read(64)
  let elapsedMs = since(start) / 1000000
  assert(out == "", "read against a silent peer returned '${out}', want ''")
  assert(a.readTimedOut(), "read against a silent peer did not report readTimedOut()")
  assert(elapsedMs < 1000, "read against a silent peer took ${elapsedMs}ms, want < 1000ms")
  c.close()
  a.close()
  l.close()
}

// A clean close must still read as a clean close, not a false timeout: a
// `read()` armed with a deadline whose peer closes in time reports "" with
// `readTimedOut()` false, exactly as an unarmed `read()` already does.
test "read against a peer that closes in time is a clean close, not a timeout" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  a.setDeadline(monotonic().ns + 60000000000)
  c.close()
  let out = a.read(64)
  assert(out == "", "read against a closed peer returned '${out}', want ''")
  assert(!a.readTimedOut(), "read against a closed peer falsely reported readTimedOut()")
  a.close()
  l.close()
}

// #5958 — the deadline clamp moved from the read loop's entry to the first
// EAGAIN; these two pin the contract that must not move with it: an
// already-past deadline still times out (`netClampDeadline`'s `now` clamp,
// reached on that first EAGAIN instead of up front), and a read whose data
// is already queued ready still returns it, because the clock is never read
// before the kernel read is tried.
test "read with an already-past deadline times out" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  // `c` never writes: `a`'s read finds nothing ready, hits EAGAIN, and
  // clamps against a deadline that is already behind `now`.
  a.setDeadline(monotonic().ns - 1000000000)
  let out = a.read(64)
  assert(out == "", "read with an already-past deadline returned '${out}', want ''")
  assert(a.readTimedOut(), "read with an already-past deadline did not report readTimedOut()")
  c.close()
  a.close()
  l.close()
}

// `writeBytes` (#5928) is `write`'s byte-taking sibling: a connection with
// no deadline armed at all is the first thing to prove still works.
test "writeBytes with no deadline armed writes the bytes across" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  a.writeBytes([]byte("hello")) catch e {
    assert(false, "writeBytes: ${e.message()}")
    return
  }
  let got = c.read(64)
  assert(got == "hello", "peer read '${got}', want 'hello'")
  c.close()
  a.close()
  l.close()
}

// Reads `total` bytes off `c` in `chunk`-sized pieces with a short sleep
// between each — slow enough that a writer sending `total` bytes at once
// must park on a full send buffer and retry more than once, the shape
// `bit_rt_net_write_bytes_w`'s underlying `netWriteSock` exists for
// (runtime/net/{linux,darwin,windows}/netabi.bit's own comment on it).
fn slowDrain(c: Conn, total: int, chunk: int) {
  let got = 0
  while (got < total) {
    let want = chunk
    if (want > total - got) {
      want = total - got
    }
    let piece = c.read(want)
    if (len(piece) == 0) {
      return
    }
    got = got + len(piece)
    sleep(2000000) // 2ms
  }
}

// #5928: `writeBytes` with NO deadline armed must behave exactly like
// `write(s: string)`'s own no-deadline fast path — block until every byte
// is written, however slowly the peer drains its socket buffer, never
// bounded by `netDeadlineMaxWaitNs` the way a deadline-armed write already
// is. 4 MiB paced at one 4 KiB read every 2ms (~2s total) is comfortably
// past every default socket buffer size, so `a`'s write below cannot
// complete in one syscall and must park and retry against `slowDrain`'s own
// pace more than once.
test "writeBytes with no deadline armed completes against a peer that drains slowly" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  let total = 4194304
  spawn slowDrain(c, total, 4096)
  a.writeBytes([]byte(total)) catch e {
    assert(false, "writeBytes with no deadline against a slow-draining peer: ${e.message()}")
    return
  }
  a.close()
  c.close()
  l.close()
}

// The write-side mirror of "read whose data is ready returns it even with a
// past deadline": a `writeBytes` call whose bytes fit the socket's send
// buffer completes on its first attempt (`netWriteSockDeadlineLoop`'s own
// raw `write(2)`, runtime/net/{linux,darwin}/tcpdeadline.bit) without ever
// consulting the deadline, so an already-elapsed one must not fail a write
// that could go out immediately.
test "writeBytes whose data fits immediately succeeds even with a past deadline" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  a.setDeadline(monotonic().ns - 1000000000)
  a.writeBytes([]byte("hello")) catch e {
    assert(false, "writeBytes with a past deadline but room to write: ${e.message()}")
    return
  }
  let got = c.read(64)
  assert(got == "hello", "peer read '${got}', want 'hello'")
  c.close()
  a.close()
  l.close()
}

// A `writeBytes` against a peer that never reads eventually fills both ends'
// socket buffers, at which point the write can make no more progress until
// something reads — which never happens here — so the connection's own
// deadline must end it rather than parking forever. 16 MiB comfortably
// exceeds the default send/receive buffer sizes on every platform this runs
// on; 200ms bounds the wait the same way the read-side timeout tests above
// do, generous next to a local loopback round trip.
test "writeBytes against a peer that never reads times out rather than blocking forever" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  a.setDeadline(monotonic().ns + 200000000)
  let big = []byte(16777216)
  let start = monotonic()
  a.writeBytes(big) catch e {
    let elapsedMs = since(start) / 1000000
    assert(e.message() == "write timed out", "want 'write timed out', got '${e.message()}'")
    assert(
      elapsedMs < 2000,
      "writeBytes against a non-reading peer took ${elapsedMs}ms, want < 2000ms",
    )
    c.close()
    a.close()
    l.close()
    return
  }
  assert(
    false,
    "a 16 MiB writeBytes against a non-reading peer with a 200ms deadline did not time out",
  )
  c.close()
  a.close()
  l.close()
}

test "read whose data is ready returns it even with a past deadline" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  c.write("hello") catch e {
    assert(false, "write: ${e.message()}")
    return
  }
  // `write` returning only guarantees the kernel accepted the bytes, not
  // that `a`'s receive side has them yet; this gives loopback delivery a
  // moment so the read below finds them ready instead of racing it.
  sleep(10000000)
  a.setDeadline(monotonic().ns - 1000000000)
  let out = a.read(64)
  assert(out == "hello", "read with data ready returned '${out}', want 'hello'")
  assert(!a.readTimedOut(), "read with data ready falsely reported readTimedOut()")
  c.close()
  a.close()
  l.close()
}

// #5428 — A DEADLINE-ARMED READ MUST NOT COST A POLL INTERVAL PER EXCHANGE.
//
// `readDeadline` reaches `netReadSockDeadline`, which cannot park on readiness
// (see runtime/net/darwin/tcp.bit's "Deadline-bounded connect/read/write") and
// retries on a timer instead. It used to wait a flat `netDeadlinePollNs` (2ms)
// on EVERY miss, so a request/response protocol on one reused connection was
// capped at 500 exchanges per second no matter how near its peer was — the
// 78x regression #5419's keep-alive server measured. The slice now starts at
// `netDeadlineFastPollNs` (1us) and doubles toward the same 2ms ceiling.
//
// THE ASSERTION IS A RATIO AGAINST A SAME-RUN CONTROL, NOT A WALL-CLOCK
// BOUND. A flat 250ms bound went red at 1353ms on a host with a load average
// near 650 (#6820): wall clock cannot tell "waited a poll slice" from "the box
// is busy". The control runs the same 500 exchanges against a server whose
// reads carry NO deadline (they park on readiness), interleaved with the armed
// rounds, so a busy host slows both sides alike and cancels out of the ratio.
// A flat 2ms slice adds 2ms per exchange to the armed side only, which no
// amount of load on the control can mask.
// The deadline is re-armed per exchange, as an idle timeout is, so the read
// that answers each wait is a fresh one rather than one long deadline set
// once — which is the case that pays the slice.
fn deadlineEchoServer(c: Conn, n: int) {
  let i = 0
  while (i < n) {
    i = i + 1
    c.setDeadline(monotonic().ns + 60000000000)
    let req = c.readDeadline(64) catch _ {
      return
    }
    if (len(req) == 0) {
      return
    }
    c.setDeadline(0)
    c.write("R") catch _ {
      return
    }
  }
}

// A plain echo peer: reads carry no deadline, so they park on readiness.
fn plainEchoServer(c: Conn, n: int) {
  let i = 0
  while (i < n) {
    i = i + 1
    let req = c.read(64)
    if (len(req) == 0) {
      return
    }
    c.write("R") catch _ {
      return
    }
  }
}

// `exchanges` one-byte round trips over one loopback connection against
// `deadlineEchoServer` (armed) or `plainEchoServer` (control). Returns the
// elapsed nanoseconds, or -1 after reporting why it could not finish.
fn timedExchanges(armed: bool, exchanges: int): int {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return -1
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return -1
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return -1
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return -1
  }
  if (armed) {
    spawn deadlineEchoServer(a, exchanges)
  } else {
    spawn plainEchoServer(a, exchanges)
  }
  let start = monotonic()
  let done = 0
  let i = 0
  while (i < exchanges) {
    i = i + 1
    c.write("Q") catch _ {
      break
    }
    if (len(c.read(64)) == 0) {
      break
    }
    done = done + 1
  }
  let elapsed = since(start)
  assert(done == exchanges, "completed ${done} of ${exchanges} exchanges")
  c.close()
  a.close()
  l.close()
  return elapsed
}

test "a deadline-armed read answers a near peer without waiting a poll interval" {
  let exchanges = 500
  let rounds = 3
  let armedNs = 0
  let controlNs = 0
  let r = 0
  while (r < rounds) {
    r = r + 1
    let ctl = timedExchanges(false, exchanges)
    let arm = timedExchanges(true, exchanges)
    assert(ctl >= 0 && arm >= 0, "an exchange round failed")
    controlNs = controlNs + ctl
    armedNs = armedNs + arm
  }
  // 4x the control plus 100ms of fixed slack. The flat 2ms slice costs
  // 500 * 2ms = 1000ms per round on top of the control.
  let limit = controlNs * 4 + 100000000
  let msg = "armed ${armedNs / 1000000}ms, control ${controlNs / 1000000}ms, limit ${limit / 1000000}ms"
  assert(armedNs <= limit, "${rounds * exchanges} deadline-armed exchanges: ${msg}")
}

// #6337: `resolveBudgetMs` scales with the nameservers the resolver will try
// (#6338), one per-server budget each (`attempts` tries of `timeout`, #6350),
// and never drops below one server.
test "parseDnsPolicy counts each nameserver line and skips comments" {
  assert(parseDnsPolicy("").servers == 0, "empty file")
  assert(parseDnsPolicy("search example.com\n").servers == 0, "no nameserver line")
  assert(parseDnsPolicy("nameserver 1.1.1.1\n").servers == 1, "one server")
  let conf = "# nameserver 9.9.9.9\nnameserver 1.1.1.1\n\tnameserver\t8.8.8.8\nnameserver ::1\nnameservers 4.4.4.4\nnameserver\n"
  assert(
    parseDnsPolicy(conf).servers == 3,
    "three servers, comment, plural and bare keyword skipped",
  )
}

test "parseDnsPolicy ignores a nameserver line past the resolver's 4096-byte read" {
  let pad = ""
  while (len(pad) < 4096) {
    pad = pad + "# padding padding padding padding padding\n"
  }
  let head = pad[0:4096]
  assert(parseDnsPolicy(head + "\nnameserver 1.1.1.1\n").servers == 0, "line past the scan window")
}

// #7480: Windows has no resolv.conf, so the server count is what the runtime
// discovers (`bit_rt_net_dns_servers_w`); three discovered servers are budgeted
// as three, and a file that names servers is never second-guessed by it.
test "dnsPolicy budgets the runtime's discovered servers when the file names none" {
  let p = dnsPolicy("", 3)
  assert(p.servers == 3, "three discovered servers")
  assert(
    dnsBudgetMs(p) == 3 * p.attempts * p.timeoutMs,
    "budget is three servers x attempts x timeout",
  )
  assert(dnsPolicy("nameserver 1.1.1.1\n", 3).servers == 1, "the file's own count wins")
  let none = dnsPolicy("", 0)
  assert(
    dnsBudgetMs(none) == none.attempts * none.timeoutMs,
    "no servers at all is budgeted as one",
  )
}

test "resolveBudgetMs is a whole number of per-server budgets, at least one" {
  let p = readDnsPolicy()
  let b = resolveBudgetMs()
  assert(b >= p.timeoutMs * p.attempts, "at least one server's budget")
  assert(b % (p.timeoutMs * p.attempts) == 0, "a multiple of the per-server budget")
}

// #7111 — tasks spawned just before the spawner parks on a deadline-armed
// read must start at once: the read parks the TASK on the netpoller, so its
// worker is free to run the ring. #7107 saw two such tasks start ~500 ms late;
// that was its own probe task blocking the only worker in a raw nanosleep, not
// this path (a thread-blocking call strands the ring at one worker, see #7111).
// The bound is a quarter of the 2 s deadline, a hang guard that still fails
// when the tasks wait for the deadline; idle start latency is ~0.1 ms.
fn stampStart(out: chan<int>) {
  out <- monotonic().ns
}

test "tasks spawned before a deadline-armed read start while the spawner is parked" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  let starts = chan<int>(4)
  let t0 = monotonic().ns
  let i = 0
  while (i < 4) {
    spawn stampStart(starts)
    i = i + 1
  }
  a.setDeadline(monotonic().ns + 2000000000)
  let out = a.read(64)
  assert(a.readTimedOut(), "the silent peer's read did not time out, got '${out}'")
  let worst = 0
  i = 0
  while (i < 4) {
    let s = <- starts
    if (s - t0 > worst) {
      worst = s - t0
    }
    i = i + 1
  }
  assert(worst < 500000000, "a task started ${worst / 1000000} ms after spawn, want < 500 ms")
  c.close()
  a.close()
  l.close()
}

test "resolve returns an IPv6 literal and a dotted quad unchanged (#7409)" {
  let v6 = ["::1", "2001:db8::1", "::ffff:192.0.2.1", "0:0:0:0:0:0:0:1"]
  for a of v6 {
    let got = resolve(a) catch e {
      assert(false, "resolve('${a}'): ${e.message()}")
      return
    }
    assert(got == a, "resolve('${a}') = '${got}'")
  }
  let v4 = resolve("192.0.2.7") catch e {
    assert(false, "resolve v4: ${e.message()}")
    return
  }
  assert(v4 == "192.0.2.7", "resolve v4 = '${v4}'")
}
