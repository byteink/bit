// stdlib/net/net.test.bit — `Conn.peerIp()` (#4526).
//
// Everything here runs over loopback, so both ends and the listener are
// 127.0.0.1 and the assertion is an exact string rather than a shape.
//
// THAT SAMENESS IS ALSO THE TRAP, and the reason the third assertion below
// exists. A `peerIp()` that read the LOCAL address by mistake — the one-word
// slip of `getsockname` for `getpeername` — returns "127.0.0.1" for both
// connected ends and passes the first two assertions unchanged. Only a socket
// that HAS a local address and no peer separates the two, so the listener is
// asked as well and must fail.
//
// `listen`, `dial` and `Conn` are siblings in this same module (net.bit), so
// they are not imported. `std/time` is the one import, for the last test
// below (#5428): it times a read path, and `monotonic` is the same clock the
// deadlines that read arms are measured against.
import { monotonic, since } from "std/time"

test "peerIp reads 127.0.0.1 on both ends of a loopback connection" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  // Sequential, no spawn: the kernel completes a loopback handshake against the
  // backlog, so `dial` returns before anyone calls `accept`.
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }

  let seen = a.peerIp() catch e {
    assert(false, "peerIp on the accepted conn: ${e.message()}")
    return
  }
  assert(seen == "127.0.0.1", "accepted conn peerIp = '${seen}'")

  let dialed = c.peerIp() catch e {
    assert(false, "peerIp on the dialing conn: ${e.message()}")
    return
  }
  assert(dialed == "127.0.0.1", "dialing conn peerIp = '${dialed}'")

  // The listener has a local address and no peer. Reading it through a `Conn`
  // over the same fd must FAIL — this is what distinguishes the peer address
  // from the local one on loopback, where the two are the same string.
  let asConn = Conn{ fd = l.fd, deadlineNs = 0 }
  let bad = asConn.peerIp() catch _ {
    a.close()
    c.close()
    l.close()
    return
  }
  assert(false, "a listener has no peer, but peerIp returned '${bad}'")
  a.close()
  c.close()
  l.close()
}

test "peerIp on a closed conn fails with an error rather than panicking" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  c.close()

  // Reaching this line at all is half the assertion: `close` leaves fd -1, and
  // the failure has to arrive as an error the caller can catch, not as a panic
  // that takes the process down.
  let leaked = c.peerIp() catch e {
    assert(len(e.message()) > 0, "the failure carries no message")
    a.close()
    l.close()
    return
  }
  assert(false, "a closed conn has no peer, but peerIp returned '${leaked}'")
  a.close()
  l.close()
}

// #5428 — A DEADLINE-ARMED READ MUST NOT COST A POLL INTERVAL PER EXCHANGE.
//
// `readDeadline` reaches `netReadSockDeadline`, which cannot park on readiness
// (see runtime/net/darwin/tcp.bit's "Deadline-bounded connect/read/write") and
// retries on a timer instead. It used to wait a flat `netDeadlinePollNs` (2ms)
// on EVERY miss, so a request/response protocol on one reused connection was
// capped at 500 exchanges per second no matter how near its peer was — the
// 78x regression #5419's keep-alive server measured. The slice now starts at
// `netDeadlineFastPollNs` (1us) and doubles toward the same 2ms ceiling.
//
// THE BOUND IS DELIBERATELY FAR FROM BOTH ANSWERS, because a wall-clock
// assertion on a machine running a build fleet has to fail only for the
// defect. 500 exchanges cost about 18ms here and at least 500 * 2ms = 1000ms
// with the flat slice back: 250ms is a 14x headroom on the healthy path and a
// 4x margin on the broken one.
//
// The deadline is re-armed per exchange, as an idle timeout is, so the read
// that answers each wait is a fresh one rather than one long deadline set
// once — which is the case that pays the slice.
fn deadlineEchoServer(c: Conn, n: int) {
  let i = 0
  while (i < n) {
    i = i + 1
    c.setDeadline(monotonic().ns + 60000000000)
    let req = c.readDeadline(64) catch _ {
      return
    }
    if (len(req) == 0) {
      return
    }
    c.setDeadline(0)
    c.write("R") catch _ {
      return
    }
  }
}

test "a deadline-armed read answers a near peer without waiting a poll interval" {
  let exchanges = 500
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  spawn deadlineEchoServer(a, exchanges)
  let start = monotonic()
  let done = 0
  let i = 0
  while (i < exchanges) {
    i = i + 1
    c.write("Q") catch _ {
      break
    }
    if (len(c.read(64)) == 0) {
      break
    }
    done = done + 1
  }
  let elapsedMs = since(start) / 1000000
  assert(done == exchanges, "completed ${done} of ${exchanges} exchanges")
  assert(elapsedMs < 250, "${exchanges} deadline-armed exchanges took ${elapsedMs}ms")
  c.close()
  a.close()
  l.close()
}

// #5857 — `readDeadlineInto` reads into a CALLER-OWNED buffer instead of
// allocating a fresh one per call, the way `stdlib/http/http.bit`'s
// `netStream.rbuf` reuses it across every request on a keep-alive
// connection. Same three outcomes as `readDeadline`: bytes read (returned as
// a count, not a fresh string — the caller decides what to do with
// `buf[0:n]`), `0` for a clean close, and a `fail` for a timeout or a read
// failure.
test "readDeadlineInto reads into the caller's buffer and reports a clean close as 0" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  a.setDeadline(monotonic().ns + 60000000000)

  c.write("hello") catch e {
    assert(false, "write: ${e.message()}")
    return
  }
  let buf = []byte(4096)
  let n = a.readDeadlineInto(buf, 4096) catch e {
    assert(false, "readDeadlineInto: ${e.message()}")
    return
  }
  assert(n == 5, "readDeadlineInto returned n=${n}, want 5")
  assert(string(buf[0:n]) == "hello", "readDeadlineInto read '${string(buf[0:n])}', want 'hello'")

  // A second call reuses the SAME `buf`, the way `netStream.rbuf` does
  // across requests: the peer has closed, so this read must report a clean
  // close (`0`) rather than replaying the first call's bytes or failing.
  c.close()
  let closed = a.readDeadlineInto(buf, 4096) catch e {
    assert(false, "readDeadlineInto after close: ${e.message()}")
    return
  }
  assert(closed == 0, "readDeadlineInto after the peer closed returned ${closed}, want 0")

  a.close()
  l.close()
}
