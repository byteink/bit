// stdlib/net/net.test.bit — `Conn.peerIp()` (#4526).
//
// Everything here runs over loopback, so both ends and the listener are
// 127.0.0.1 and the assertion is an exact string rather than a shape.
//
// THAT SAMENESS IS ALSO THE TRAP, and the reason the third assertion below
// exists. A `peerIp()` that read the LOCAL address by mistake — the one-word
// slip of `getsockname` for `getpeername` — returns "127.0.0.1" for both
// connected ends and passes the first two assertions unchanged. Only a socket
// that HAS a local address and no peer separates the two, so the listener is
// asked as well and must fail.
//
// `listen`, `dial` and `Conn` are siblings in this same module (net.bit), so
// nothing is imported.

test "peerIp reads 127.0.0.1 on both ends of a loopback connection" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  // Sequential, no spawn: the kernel completes a loopback handshake against the
  // backlog, so `dial` returns before anyone calls `accept`.
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }

  let seen = a.peerIp() catch e {
    assert(false, "peerIp on the accepted conn: ${e.message()}")
    return
  }
  assert(seen == "127.0.0.1", "accepted conn peerIp = '${seen}'")

  let dialed = c.peerIp() catch e {
    assert(false, "peerIp on the dialing conn: ${e.message()}")
    return
  }
  assert(dialed == "127.0.0.1", "dialing conn peerIp = '${dialed}'")

  // The listener has a local address and no peer. Reading it through a `Conn`
  // over the same fd must FAIL — this is what distinguishes the peer address
  // from the local one on loopback, where the two are the same string.
  let asConn = Conn{ fd: l.fd, deadlineNs: 0 }
  let bad = asConn.peerIp() catch e {
    a.close()
    c.close()
    l.close()
    return
  }
  assert(false, "a listener has no peer, but peerIp returned '${bad}'")
  a.close()
  c.close()
  l.close()
}

test "peerIp on a closed conn fails with an error rather than panicking" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  c.close()

  // Reaching this line at all is half the assertion: `close` leaves fd -1, and
  // the failure has to arrive as an error the caller can catch, not as a panic
  // that takes the process down.
  let leaked = c.peerIp() catch e {
    assert(len(e.message()) > 0, "the failure carries no message")
    a.close()
    l.close()
    return
  }
  assert(false, "a closed conn has no peer, but peerIp returned '${leaked}'")
  a.close()
  l.close()
}
