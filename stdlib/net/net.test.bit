// stdlib/net/net.test.bit — `Conn.peerIp()` (#4526).
//
// Everything here runs over loopback, so both ends and the listener are
// 127.0.0.1 and the assertion is an exact string rather than a shape.
//
// THAT SAMENESS IS ALSO THE TRAP, and the reason the third assertion below
// exists. A `peerIp()` that read the LOCAL address by mistake — the one-word
// slip of `getsockname` for `getpeername` — returns "127.0.0.1" for both
// connected ends and passes the first two assertions unchanged. Only a socket
// that HAS a local address and no peer separates the two, so the listener is
// asked as well and must fail.
//
// `listen`, `dial` and `Conn` are siblings in this same module (net.bit), so
// they are not imported. `std/time` is the one import: `monotonic`/`since`
// time a read path for the #5428 test below, and `sleep` gives the #5958
// "data already ready" test a moment for the loopback write to actually
// land before that test arms a past deadline — otherwise it races the
// kernel, not the deadline logic.
import { monotonic, since, sleep } from "std/time"

test "peerIp reads 127.0.0.1 on both ends of a loopback connection" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  // Sequential, no spawn: the kernel completes a loopback handshake against the
  // backlog, so `dial` returns before anyone calls `accept`.
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }

  let seen = a.peerIp() catch e {
    assert(false, "peerIp on the accepted conn: ${e.message()}")
    return
  }
  assert(seen == "127.0.0.1", "accepted conn peerIp = '${seen}'")

  let dialed = c.peerIp() catch e {
    assert(false, "peerIp on the dialing conn: ${e.message()}")
    return
  }
  assert(dialed == "127.0.0.1", "dialing conn peerIp = '${dialed}'")

  // The listener has a local address and no peer. Reading it through a `Conn`
  // over the same fd must FAIL — this is what distinguishes the peer address
  // from the local one on loopback, where the two are the same string.
  let asConn = Conn{ fd = l.fd, deadlineNs = 0 }
  let bad = asConn.peerIp() catch _ {
    a.close()
    c.close()
    l.close()
    return
  }
  assert(false, "a listener has no peer, but peerIp returned '${bad}'")
  a.close()
  c.close()
  l.close()
}

test "peerIp on a closed conn fails with an error rather than panicking" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  c.close()

  // Reaching this line at all is half the assertion: `close` leaves fd -1, and
  // the failure has to arrive as an error the caller can catch, not as a panic
  // that takes the process down.
  let leaked = c.peerIp() catch e {
    assert(len(e.message()) > 0, "the failure carries no message")
    a.close()
    l.close()
    return
  }
  assert(false, "a closed conn has no peer, but peerIp returned '${leaked}'")
  a.close()
  l.close()
}

// #5915 — `Conn.read()` used to ignore `deadlineNs` entirely: a caller that
// called `setDeadline` and then `read()` against a silent peer parked
// forever, exactly the trap #5912's agent had to route around with
// `readDeadline` instead. This hangs the suite on the old code (`read()`
// never returns) and passes here inside `elapsedMs < 1000` — `read()`'s
// signature has no room for a distinct timeout error, so `readTimedOut()`
// is what tells this apart from an ordinary clean close.
test "read against a silent peer times out instead of blocking forever" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  // `c` never writes anything: `a` is the silent peer `read()` must not park
  // on forever once its own deadline is armed.
  a.setDeadline(monotonic().ns + 50000000)
  let start = monotonic()
  let out = a.read(64)
  let elapsedMs = since(start) / 1000000
  assert(out == "", "read against a silent peer returned '${out}', want ''")
  assert(a.readTimedOut(), "read against a silent peer did not report readTimedOut()")
  assert(elapsedMs < 1000, "read against a silent peer took ${elapsedMs}ms, want < 1000ms")
  c.close()
  a.close()
  l.close()
}

// A clean close must still read as a clean close, not a false timeout: a
// `read()` armed with a deadline whose peer closes in time reports "" with
// `readTimedOut()` false, exactly as an unarmed `read()` already does.
test "read against a peer that closes in time is a clean close, not a timeout" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  a.setDeadline(monotonic().ns + 60000000000)
  c.close()
  let out = a.read(64)
  assert(out == "", "read against a closed peer returned '${out}', want ''")
  assert(!a.readTimedOut(), "read against a closed peer falsely reported readTimedOut()")
  a.close()
  l.close()
}

// #5958 — the deadline clamp moved from the read loop's entry to the first
// EAGAIN; these two pin the contract that must not move with it: an
// already-past deadline still times out (`netClampDeadline`'s `now` clamp,
// reached on that first EAGAIN instead of up front), and a read whose data
// is already queued ready still returns it, because the clock is never read
// before the kernel read is tried.
test "read with an already-past deadline times out" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  // `c` never writes: `a`'s read finds nothing ready, hits EAGAIN, and
  // clamps against a deadline that is already behind `now`.
  a.setDeadline(monotonic().ns - 1000000000)
  let out = a.read(64)
  assert(out == "", "read with an already-past deadline returned '${out}', want ''")
  assert(a.readTimedOut(), "read with an already-past deadline did not report readTimedOut()")
  c.close()
  a.close()
  l.close()
}

test "read whose data is ready returns it even with a past deadline" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  c.write("hello") catch e {
    assert(false, "write: ${e.message()}")
    return
  }
  // `write` returning only guarantees the kernel accepted the bytes, not
  // that `a`'s receive side has them yet; this gives loopback delivery a
  // moment so the read below finds them ready instead of racing it.
  sleep(10000000)
  a.setDeadline(monotonic().ns - 1000000000)
  let out = a.read(64)
  assert(out == "hello", "read with data ready returned '${out}', want 'hello'")
  assert(!a.readTimedOut(), "read with data ready falsely reported readTimedOut()")
  c.close()
  a.close()
  l.close()
}

// #5428 — A DEADLINE-ARMED READ MUST NOT COST A POLL INTERVAL PER EXCHANGE.
//
// `readDeadline` reaches `netReadSockDeadline`, which cannot park on readiness
// (see runtime/net/darwin/tcp.bit's "Deadline-bounded connect/read/write") and
// retries on a timer instead. It used to wait a flat `netDeadlinePollNs` (2ms)
// on EVERY miss, so a request/response protocol on one reused connection was
// capped at 500 exchanges per second no matter how near its peer was — the
// 78x regression #5419's keep-alive server measured. The slice now starts at
// `netDeadlineFastPollNs` (1us) and doubles toward the same 2ms ceiling.
//
// THE BOUND IS DELIBERATELY FAR FROM BOTH ANSWERS, because a wall-clock
// assertion on a machine running a build fleet has to fail only for the
// defect. 500 exchanges cost about 18ms here and at least 500 * 2ms = 1000ms
// with the flat slice back: 250ms is a 14x headroom on the healthy path and a
// 4x margin on the broken one.
//
// The deadline is re-armed per exchange, as an idle timeout is, so the read
// that answers each wait is a fresh one rather than one long deadline set
// once — which is the case that pays the slice.
fn deadlineEchoServer(c: Conn, n: int) {
  let i = 0
  while (i < n) {
    i = i + 1
    c.setDeadline(monotonic().ns + 60000000000)
    let req = c.readDeadline(64) catch _ {
      return
    }
    if (len(req) == 0) {
      return
    }
    c.setDeadline(0)
    c.write("R") catch _ {
      return
    }
  }
}

test "a deadline-armed read answers a near peer without waiting a poll interval" {
  let exchanges = 500
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  spawn deadlineEchoServer(a, exchanges)
  let start = monotonic()
  let done = 0
  let i = 0
  while (i < exchanges) {
    i = i + 1
    c.write("Q") catch _ {
      break
    }
    if (len(c.read(64)) == 0) {
      break
    }
    done = done + 1
  }
  let elapsedMs = since(start) / 1000000
  assert(done == exchanges, "completed ${done} of ${exchanges} exchanges")
  assert(elapsedMs < 250, "${exchanges} deadline-armed exchanges took ${elapsedMs}ms")
  c.close()
  a.close()
  l.close()
}

// #5857 — `readDeadlineInto` reads into a CALLER-OWNED buffer instead of
// allocating a fresh one per call, the way `stdlib/http/http.bit`'s
// `netStream.rbuf` reuses it across every request on a keep-alive
// connection. Same three outcomes as `readDeadline`: bytes read (returned as
// a count, not a fresh string — the caller decides what to do with
// `buf[0:n]`), `0` for a clean close, and a `fail` for a timeout or a read
// failure.
test "readDeadlineInto reads into the caller's buffer and reports a clean close as 0" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  a.setDeadline(monotonic().ns + 60000000000)

  c.write("hello") catch e {
    assert(false, "write: ${e.message()}")
    return
  }
  let buf = []byte(4096)
  let n = a.readDeadlineInto(buf, 4096) catch e {
    assert(false, "readDeadlineInto: ${e.message()}")
    return
  }
  assert(n == 5, "readDeadlineInto returned n=${n}, want 5")
  assert(string(buf[0:n]) == "hello", "readDeadlineInto read '${string(buf[0:n])}', want 'hello'")

  // A second call reuses the SAME `buf`, the way `netStream.rbuf` does
  // across requests: the peer has closed, so this read must report a clean
  // close (`0`) rather than replaying the first call's bytes or failing.
  c.close()
  let closed = a.readDeadlineInto(buf, 4096) catch e {
    assert(false, "readDeadlineInto after close: ${e.message()}")
    return
  }
  assert(closed == 0, "readDeadlineInto after the peer closed returned ${closed}, want 0")

  a.close()
  l.close()
}

// The runtime writes through a raw pointer, so a `max` larger than the buffer
// must be clamped to `len(buf)`, never trusted: 16 bytes sent into a 4-byte
// buffer with max 4096 must come back as exactly 4.
test "readDeadlineInto never reads past len(buf), whatever max says" {
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  a.setDeadline(monotonic().ns + 60000000000)
  c.write("0123456789abcdef") catch e {
    assert(false, "write: ${e.message()}")
    return
  }
  let small = []byte(4)
  let n = a.readDeadlineInto(small, 4096) catch e {
    assert(false, "readDeadlineInto: ${e.message()}")
    return
  }
  assert(n == 4, "readDeadlineInto with max 4096 into a 4-byte buffer returned ${n}, want 4")
  assert(string(small) == "0123", "read '${string(small)}', want '0123'")
  c.close()
  a.close()
  l.close()
}

// #5890 — `readDeadlineInto` hands `buf` itself to the kernel: the runtime
// no longer reads into a scratch of its own and copies it across, and what
// keeps `buf` live across the park is the caller's `keepAlive` (net.bit). So
// 10,000 reads into ONE reused buffer must each return exactly the bytes sent
// for that round — never a previous round's, never zeros. Lockstep, the
// writer on its own green thread waiting for an ack, so each read finds an
// empty socket and parks before its bytes arrive, and the writer allocates a
// fresh message per round, which gives `BIT_GC=stress` a collection to run
// while the reader is parked. The writer goes through `writeDeadline` and
// `readDeadline`, the other two callers of the same no-scratch contract.
fn intoMsg(i: int): string {
  return "${i}:${i * 7919 % 100003};"
}

fn intoWriter(c: Conn, rounds: int) {
  c.setDeadline(monotonic().ns + 120000000000)
  let i = 0
  while (i < rounds) {
    c.writeDeadline(intoMsg(i)) catch _ {
      return
    }
    let ack = c.readDeadline(1) catch _ {
      return
    }
    if (ack != "A") {
      return
    }
    i = i + 1
  }
}

// One round: read `want` in as many `readDeadlineInto` calls as it takes,
// never asking for more than is still owed, so a read cannot run into the
// next round's bytes. Returns the calls made, or -1 with `why` set.
fn intoRound(a: Conn, buf: []byte, want: string, why: []string): int {
  let acc = ""
  let calls = 0
  while (len(acc) < len(want)) { // each pass grows `acc` by n > 0 or returns
    let n = a.readDeadlineInto(buf, len(want) - len(acc)) catch e {
      why[0] = e.message()
      return 0 - 1
    }
    calls = calls + 1
    if (n == 0) {
      why[0] = "peer closed"
      return 0 - 1
    }
    acc = acc + string(buf[0:n])
  }
  if (acc != want) {
    why[0] = "read '${acc}', want '${want}'"
    return 0 - 1
  }
  return calls
}

test "readDeadlineInto returns exactly the bytes sent across 10,000 parked reads into one buffer" {
  let rounds = 10000
  let l = listen("127.0.0.1", 0) catch e {
    assert(false, "listen: ${e.message()}")
    return
  }
  let port = l.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let c = dial("127.0.0.1", port) catch e {
    assert(false, "dial: ${e.message()}")
    return
  }
  let a = l.accept() catch e {
    assert(false, "accept: ${e.message()}")
    return
  }
  a.setDeadline(monotonic().ns + 120000000000)
  spawn intoWriter(c, rounds)
  let buf = []byte(64)
  let why = [""]
  let calls = 0
  let i = 0
  while (i < rounds) {
    let k = intoRound(a, buf, intoMsg(i), why)
    if (k < 0) {
      break
    }
    calls = calls + k
    a.write("A") catch e {
      why[0] = "ack: ${e.message()}"
      break
    }
    i = i + 1
  }
  assert(i == rounds, "round ${i} of ${rounds}: ${why[0]}")
  assert(calls >= rounds, "${calls} readDeadlineInto calls for ${rounds} rounds")
  c.close()
  a.close()
  l.close()
}
