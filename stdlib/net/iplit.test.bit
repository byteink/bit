// stdlib/net/iplit.test.bit — `isIpv4Literal` and `isIpv6Literal` (#6577, iplit.bit).
//
// Hosts: every distinct host in the Smithy S3 endpoint-rules test cases that
// is an IP (6 of 142, all dotted quads) must classify as IPv4, and a spread of
// the 136 others (bucket-style and region-style names) must classify as neither.
// Then RFC 4291 section 2.2 / RFC 5952 section 4 forms and the strictness
// cases: leading zeros, octal, shorthand, brackets, zone ids, a stray space.

fn expectV4(s: string, want: bool) {
  assert(isIpv4Literal(s) == want, "isIpv4Literal('${s}') != ${want}")
  assert(!isIpv6Literal(s), "isIpv6Literal('${s}') is true for a v4 text")
}

fn expectV6(s: string, want: bool) {
  assert(isIpv6Literal(s) == want, "isIpv6Literal('${s}') != ${want}")
}

test "every IP host in the S3 endpoint test cases is IPv4" {
  let ips = ["10.0.0.1", "10.0.1.12", "123.123.0.1", "127.0.0.1", "192.168.0.1", "192.168.1.1"]
  let i = 0
  while (i < len(ips)) {
    expectV4(ips[i], true)
    i = i + 1
  }
  print("endpoint-test IP hosts classified: ${len(ips)}\n")
}

test "no non-IP host in the S3 endpoint test cases is an IP" {
  let hosts = [
    "abc.com", "amazonaws.com", "beta.example.com", "example.com", "foo.com",
    "nota", "s3.amazonaws.com", "s3.us-west-2.amazonaws.com",
    "bucket-name.s3.cn-north-1.amazonaws.com.cn",
    "control.vpce-1a2b3c4d-5e6f.s3.us-west-2.vpce.amazonaws.com",
    "mybucket--usw2-az1--x-s3.s3express-usw2-az1.us-west-2.amazonaws.com",
    "myaccesspoint-123456789012.op-01234567890123456.s3-outposts.us-east-1.amazonaws.com",
    "mfzwi23gnjvgw.mrap.accesspoint.s3-global.amazonaws.com",
    "123.example.com", "1.2.3.4.example.com",
  ]
  let i = 0
  while (i < len(hosts)) {
    expectV4(hosts[i], false)
    i = i + 1
  }
  print("endpoint-test non-IP hosts classified: ${len(hosts)}\n")
}

test "IPv4 is strict dotted-quad" {
  expectV4("0.0.0.0", true)
  expectV4("255.255.255.255", true)
  expectV4("256.1.1.1", false)
  expectV4("1.2.3", false)
  expectV4("1.2.3.4.5", false)
  expectV4("127.1", false)
  expectV4("2130706433", false)
  expectV4("0x7f.0.0.1", false)
  expectV4("01.2.3.4", false)
  expectV4("1.2.3.04", false)
  expectV4("0177.0.0.1", false)
  expectV4("1.2.3.+4", false)
  expectV4("1.2.3.-4", false)
  expectV4("1..3.4", false)
  expectV4("1.2.3.4.", false)
  expectV4(" 1.2.3.4", false)
  expectV4("1.2.3.4 ", false)
  expectV4("1.2.3.4/24", false)
  expectV4("[1.2.3.4]", false)
  expectV4("", false)
}

test "IPv6 accepts the RFC 4291 and RFC 5952 forms" {
  expectV6("::", true)
  expectV6("::1", true)
  expectV6("1::", true)
  expectV6("2001:db8::1", true)
  expectV6("2001:DB8:0:0:8:800:200C:417A", true)
  expectV6("1:2:3:4:5:6:7:8", true)
  expectV6("1:2:3:4:5:6:7::", true)
  expectV6("::2:3:4:5:6:7:8", true)
  expectV6("1::8", true)
  expectV6("::ffff:192.0.2.1", true)
  expectV6("64:ff9b::192.0.2.33", true)
  expectV6("1:2:3:4:5:6:1.2.3.4", true)
  expectV6("fe80::1", true)
}

test "IPv6 rejects malformed text" {
  expectV6("", false)
  expectV6(":", false)
  expectV6(":::", false)
  expectV6("1::2::3", false)
  expectV6("1:2:3:4:5:6:7", false)
  expectV6("1:2:3:4:5:6:7:8:9", false)
  expectV6("1:2:3:4:5:6:7:8::", false)
  expectV6("::1:2:3:4:5:6:7:8", false)
  expectV6("12345::1", false)
  expectV6("g::1", false)
  expectV6("1:2:3:4:5:6:7:", false)
  expectV6(":1:2:3:4:5:6:7", false)
  expectV6("::1.2.3", false)
  expectV6("::01.2.3.4", false)
  expectV6("1.2.3.4::", false)
  expectV6("::1.2.3.4:1", false)
  expectV6("[::1]", false)
  expectV6("::1%eth0", false)
  expectV6(" ::1", false)
  expectV6("::1 ", false)
  expectV6("1.2.3.4", false)
}
