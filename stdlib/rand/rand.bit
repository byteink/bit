// Bit standard library — rand module.
//
// A FAST, SEEDABLE pseudo-random generator for ordinary application code:
// picking an index, choosing a shard, shuffling a slice, jittering a retry
// delay. It is the missing half of the split this module deliberately does
// NOT fill: `crypto.randomBytes` / `crypto.fillRandom` (std/crypto) are a
// CSPRNG with no seed, so nothing built on them can ever replay a sequence.
//
// THIS GENERATOR IS NOT CRYPTOGRAPHICALLY SECURE. Never use it for keys,
// tokens, nonces, session ids, passwords, or anything else where an attacker
// predicting the next value would matter. Its whole value — a seed you can
// print and replay — is the opposite of what a security-sensitive draw
// needs, which must be unpredictable even to someone who has seen every
// prior output. For that, use `std/crypto`'s `randomBytes`, `fillRandom`, or
// `randomUintBelow`. This split, and the reason for it, is copied directly
// from Go's `math/rand` (this module) versus `crypto/rand` (std/crypto):
// the two must be hard to confuse, which is why this module lives in its
// own directory rather than as a "fast mode" flag inside std/crypto.
//
// The algorithm is SplitMix64 (Steele, Lea & Flood, "Fast Splittable
// Pseudorandom Number Generators", 2014): 64 bits of state, three
// multiply-xorshift rounds per draw, and the standard choice whenever only
// speed, a long period and a printable seed matter — not unpredictability.
// Two `Rand`s constructed with `newRand(seed)` from the same seed produce a
// byte-identical sequence from every method below, forever: that is what
// lets a failing randomized test print its seed and be replayed exactly.

import { randomU64 } from "std/crypto"

// A seedable, non-cryptographic pseudo-random generator. See the module
// header above: never use this for anything security-sensitive. The zero
// value is a valid (if predictable) generator; prefer `newRand`.
export class Rand {
  state: uint
  // The next raw draw, uniform over the full `uint` range. Most callers want
  // `intn`, `int64`, `f64`, or `shuffle` instead.
  export uint64(): uint {
    this.state = splitmix64Next(this.state)
    return splitmix64Mix(this.state)
  }

  // A uniformly random value in `[0, n)`, free of modulo bias. Panics if `n`
  // is not positive — there is no meaningful uniform draw from an empty or
  // negative range, and returning 0 would silently hide the caller's bug.
  export intn(n: int): int {
    if (n <= 0) {
      panic("rand: intn: n must be > 0")
    }
    let u: uint = uint(n)
    // `rem` is the size of the top partial block that a plain `draw % u`
    // would over-represent: `2^64 mod u`, written as `(0 - u) % u` because
    // 2^64 wraps to 0 in `uint`. Rejecting a draw that lands in that block and
    // retrying makes every residue in [0, u) equally likely. Because
    // `rem < u <= 2^64`, one can show `rem` is always less than half of
    // 2^64 — so a draw is accepted on the first try more often than not,
    // regardless of `u`. `maxAccept` is the largest accepted raw draw.
    let rem: uint = (0 - u) % u
    let maxAccept: uint = 0 - rem - 1
    let tries = 0
    while (tries < maxRejectionTries) {
      let x = this.uint64()
      if (x <= maxAccept) {
        return int(x % u)
      }
      tries = tries + 1
    }
    // Unreached in practice — see the probability bound above — but the loop
    // must still be bounded and its exit defined: take one more draw and
    // accept its residue rather than loop without a limit.
    return int(this.uint64() % u)
  }

  // A uniformly random value over the full `i64` range, positive or negative:
  // a raw 64-bit draw reinterpreted as signed. Unlike `crypto.randomU64`
  // (unsigned, so always non-negative), this can be negative — pick this when
  // you want an arbitrary signed value, `intn` when you want a bounded range.
  export int64(): int {
    return int(this.uint64())
  }

  // A uniformly random value in `[0.0, 1.0)`. Built from the top 53 bits of a
  // draw — the number of bits an `f64` mantissa holds exactly — scaled down,
  // so every one of the 2^53 representable outcomes is equally likely.
  export f64(): f64 {
    let top53 = this.uint64() >> 11
    return f64(int(top53)) / 9007199254740992.0 // 2^53
  }

  // Shuffles `xs` in place using the Fisher-Yates algorithm: uniformly random
  // among all `len(xs)!` orderings, O(n) draws, no extra allocation.
  export shuffle<T>(xs: []T) {
    let i = len(xs) - 1
    while (i > 0) {
      let j = this.intn(i + 1)
      let tmp = xs[i]
      xs[i] = xs[j]
      xs[j] = tmp
      i = i - 1
    }
  }

  // A random permutation of `[0, n)` as a fresh slice: `perm(n, r)[i]` is the
  // `i`th element of the permutation. Panics if `n` is negative; `n == 0`
  // yields an empty slice.
  export perm(n: int): []int {
    if (n < 0) {
      panic("rand: perm: n must be >= 0")
    }
    let p: []int = []int(n)
    let i = 0
    while (i < n) {
      p[i] = i
      i = i + 1
    }
    this.shuffle(p)
    return p
  }
}

// A generator seeded with `seed`. Two `Rand`s built from the same seed
// produce an identical sequence from every method below — this is the
// property that makes a randomized test reproducible: print the seed on
// failure, replay with `newRand(thatSeed)`.
export fn newRand(seed: uint): Rand {
  return Rand{ state: seed }
}

// One SplitMix64 round: advances `state` by the golden-ratio increment, then
// avalanches it through two multiply-xorshift steps. Free functions so the
// step is written once and shared by `Rand.uint64` and the package-level
// convenience functions below, which keep their own state.
fn splitmix64Next(state: uint): uint {
  return state + 0x9E3779B97F4A7C15
}

fn splitmix64Mix(state: uint): uint {
  let z = state
  z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
  z = (z ^ (z >> 27)) * 0x94D049BB133111EB
  return z ^ (z >> 31)
}

// Rejection-sampling retries `intn` allows before accepting the residual
// bias of a bare modulo. The loop below always terminates: the acceptance
// probability of a single draw is provably greater than 1/2 (see the
// comment on the loop), so the chance of needing more than 64 draws is below
// 2^-64 for every `n` — not "practically never", but a bound the loop
// actually reaches in the worst case, satisfying Power of 10 rule 2.
const maxRejectionTries: int = 64

// --- package-level convenience, seeded from the OS ------------------------
//
// One shared, lazily-seeded generator for quick one-off use with no `Rand`
// to manage — `intn(6) + 1` for a die roll, not `newRand(seed).intn(6) + 1`.
// It shares one unsynchronized state across every caller in the process, so
// it is NOT safe to call from more than one worker thread at a time; a
// program that draws from multiple workers concurrently must give each
// worker its own `newRand(seed)` instead. `sharedState` holds only the
// generator's `uint` state (never a `Rand` value) because module-level
// storage may not hold a reference type (SPEC §11.11).

let sharedState: uint = 0
let sharedReady: bool = false

fn sharedRand(): Rand {
  if (!sharedReady) {
    sharedState = randomU64()
    sharedReady = true
  }
  return Rand{ state: sharedState }
}

// A uniformly random value in `[0, n)` from the shared generator. See
// `Rand.intn` for the panic condition and the bias-free construction.
export fn intn(n: int): int {
  let r = sharedRand()
  let v = r.intn(n)
  sharedState = r.state
  return v
}

// A uniformly random `i64`, positive or negative, from the shared generator.
export fn int64(): int {
  let r = sharedRand()
  let v = r.int64()
  sharedState = r.state
  return v
}

// A uniformly random `f64` in `[0.0, 1.0)` from the shared generator. Named
// `float64`, not `f64`: a bare package-level function named after a builtin
// conversion (`f64(x)`) shadows it module-wide (SPEC §11.1), breaking every
// other `f64(...)` cast in this file. `Rand.f64` above has no such
// conflict — methods live in the receiver's namespace, not the global one.
export fn float64(): f64 {
  let r = sharedRand()
  let v = r.f64()
  sharedState = r.state
  return v
}

// Shuffles `xs` in place using the shared generator.
export fn shuffle<T>(xs: []T) {
  let r = sharedRand()
  r.shuffle(xs)
  sharedState = r.state
}

// A random permutation of `[0, n)` from the shared generator. See
// `Rand.perm` for the panic condition.
export fn perm(n: int): []int {
  let r = sharedRand()
  let v = r.perm(n)
  sharedState = r.state
  return v
}
