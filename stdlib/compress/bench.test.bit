// stdlib/compress/bench.test.bit — allocation-count benchmark for
// compressing a 100KB input (#3957's acceptance: "a future regression is
// visible").
//
// GC allocation counts are only observable from OUTSIDE a process: the
// runtime prints `[bit-gc] ... swept=N live=N` to stderr, gated on the
// `BIT_GC_STATS=1` environment variable it reads once at boot
// (runtime/stw/stwstats.bit) — there is no in-process introspection call a
// Bit program can make on itself. So this test builds and runs a small
// throwaway FIXTURE program as a real subprocess with `BIT_GC_STATS=1` set,
// the same technique `_tests_/bit/allocslope.bit` uses for the whole repo's
// alloc-slope gate.
//
// That needs a `bit` binary to build the fixture with, which this test
// cannot always locate: `bit test`'s own child-per-test process (SPEC §19)
// is the FIXTURE it already compiled, not the compiler — `selfExe()` inside
// a test returns that ephemeral binary's path, never a usable compiler. And
// `./make test`'s `test-stdlib-unit` Gate (tools/build/gates.bit) sets only
// `BIT_STDLIB`, not `BIT_SELF_EXE`. `locateBit` below tries, in order: an
// explicit `BIT_SELF_EXE` override, a path derived from `BIT_STDLIB`
// (exactly what that Gate provides), and a plain cwd-relative guess for a
// developer running `bit test stdlib/compress` by hand from a repo root —
// degrading to a clear skip message, never a failure, when none apply.

import { exists } from "std/fs"
import { hasSuffix } from "std/strings"

class BitLocation {
  bin: string,
  stdlib: string,
}

fn locateBit(): BitLocation {
  let fromEnv = envOr("BIT_SELF_EXE", "")
  let stdlibEnv = envOr("BIT_STDLIB", "")
  if (len(fromEnv) > 0 && exists(fromEnv) && len(stdlibEnv) > 0 && exists(stdlibEnv)) {
    return BitLocation{ bin: fromEnv, stdlib: stdlibEnv }
  }
  if (len(stdlibEnv) > 0 && hasSuffix(stdlibEnv, "/stdlib")) {
    let repoRoot = stdlibEnv[0:len(stdlibEnv) - len("/stdlib")]
    let candidate = "${repoRoot}/bit-out/bin/bit"
    if (exists(candidate)) {
      return BitLocation{ bin: candidate, stdlib: stdlibEnv }
    }
  }
  if (exists("bit-out/bin/bit") && exists("stdlib")) {
    return BitLocation{ bin: "bit-out/bin/bit", stdlib: "stdlib" }
  }
  return BitLocation{ bin: "", stdlib: "" }
}

// A standalone program's own source: 100KB of realistic, compressible text
// (a repeated log-line shape), gzipped once at level 6. Written to a
// scratch file and built with the caller's own `bit`/stdlib pair.
fn benchFixtureSource(): string {
  return "import { gzip } from \"std/compress\"\n\n" +
    "fn main(): ()! {\n" +
    "  let phrase = \"GET /api/v1/users/42 HTTP/1.1 200 OK\\n\"\n" +
    "  let plen = len(phrase)\n" +
    "  let n = 100000\n" +
    "  let src: []u8 = []u8(n)\n" +
    "  let i = 0\n" +
    "  while (i < n) {\n" +
    "    src[i] = phrase[i % plen]\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  let out = gzip(src, 6)?\n" +
    "  println(\"\${len(out)}\")\n" +
    "  return\n" +
    "}\n"
}

// Finds the FIRST `key` followed by decimal digits in `s` and parses them,
// or -1 if `key` never occurs or is followed by no digit — the same shape
// `_tests_/bit/allocslope.bit`'s own `intAfter` uses to read a
// `BIT_GC_STATS` summary line.
fn intAfter(s: string, key: string): int {
  let klen = len(key)
  let i = 0
  while (i + klen <= len(s)) {
    if (s[i:i + klen] == key) {
      return digitsAt(s, i + klen)
    }
    i = i + 1
  }
  return 0 - 1
}

fn digitsAt(s: string, start: int): int {
  let j = start
  let v = 0
  let digits = 0
  while (j < len(s) && s[j] >= byte('0') && s[j] <= byte('9')) {
    v = v * 10 + (int(s[j]) - int(byte('0')))
    digits = digits + 1
    j = j + 1
  }
  if (digits == 0) {
    return 0 - 1
  }
  return v
}

// This benchmark's own deadline, deliberately well INSIDE `bit test`'s 30s
// per-test bound (`defaultTestTimeoutMs`, compiler/testrun.bit) so THIS one
// always fires first. The old inner bounds (60s for the build, 30s for the
// run) were both >= the outer bound and therefore unreachable: the harness
// killed the process at 30s and reported `FAIL ... (timed out)`, which is
// the flake #4549 closes.
//
// WHAT THE BUDGET IS SPENT ON, and why it is not the compile. Measured on
// this box under #4484: the `bit build` of a fixture this size is ~0.5s and
// the fixture's own run is milliseconds — but macOS charges a provenance
// scan on the FIRST `execve` of a newly written executable, serialized
// system-wide, timed at 16.2s (a `cp` of an already-scanned binary) to
// 32.7s under fleet load, and at 18-23ms for the same files a second time.
// This test body writes TWO fresh executables, `bench.sh` and the fixture,
// so it pays that tax twice. Two is the floor: `osRunBounded` takes a path
// and no argv (runtime/ABI.md §19), so the script cannot be avoided, and
// the fixture binary is the thing being measured. The test binary's own
// third scan is no longer charged here at all — `runModuleTests` pays it
// before test 0 as of #4557.
//
// So a skip is expected on a loaded box and is a PASS, not a failure: the
// alternative is the outer bound firing and reporting a defect that is not
// there. 12000 is the same budget `pkg/web/node.test.bit` carries for the
// same two-exec shape (#4484), and leaves 18s of the outer bound spare.
const benchBudgetMs: int = 12000

// `osRunBounded`'s deadline outcome (runtime/ABI.md §19): the child's whole
// process group was SIGKILLed at the deadline. Distinct from every exit
// code, so it is the one result that means "the box was too slow", not
// "the code under test is wrong".
const benchTimedOut: int = 0 - 2

// Either outcome of one attempt: `objects` when the fixture was measured,
// or a non-empty `skip` line explaining why it was not. A skip is a pass —
// same contract as `locateBit()` returning an empty location.
class BenchResult {
  objects: int,
  elapsedMs: int,
  skip: string,
}

// Build and run as ONE child: `set -e` makes a failed build the script's
// exit status, and the marker file written between the two halves is what
// tells the two phases apart afterwards without a second taxed exec.
fn benchScript(loc: BitLocation, dir: string, prog: string): string {
  return "#!/bin/sh\nset -e\nBIT_STDLIB='${loc.stdlib}'\nexport BIT_STDLIB\n" +
    "'${loc.bin}' build '${dir}/fixture.bit' -o '${prog}'\n" +
    ": > '${dir}/built'\n" +
    "BIT_GC_STATS=1\nexport BIT_GC_STATS\n" +
    "exec '${prog}' > '${dir}/out.txt' 2> '${dir}/err.txt'\n"
}

// Which half the single child was in when it was killed — the marker file
// `benchScript` writes between them is the only evidence left.
fn benchPhase(dir: string): string {
  if (exists("${dir}/built")) {
    return "running the fixture"
  }
  return "compiling the fixture"
}

// Builds and runs the fixture with `BIT_GC_STATS=1`, returning its
// `swept+live` object count — or a skip line when the child did not finish
// inside `benchBudgetMs`.
fn buildAndMeasureAlloc(loc: BitLocation): BenchResult {
  let dir = scratchDir("bench")
  mkdir(dir) catch e {
    panic("bench: mkdir ${dir}: ${e.message()}")
  }
  writeFile("${dir}/fixture.bit", benchFixtureSource()) catch e {
    panic("bench: write fixture.bit: ${e.message()}")
  }
  let prog = "${dir}/fixture"
  let started = timeUnixNs()
  let code = shellRun("${dir}/bench.sh", benchScript(loc, dir, prog), benchBudgetMs)
  let elapsedMs = (timeUnixNs() - started) / 1000000
  if (code == benchTimedOut) {
    return BenchResult{
      objects: 0,
      elapsedMs: elapsedMs,
      skip: "${benchPhase(dir)} did not finish within this benchmark's " +
        "${benchBudgetMs}ms budget (a loaded box charges macOS's first-exec provenance " +
        "scan on the fresh script and the fresh fixture binary) — not measured",
    }
  }
  if (code != 0) {
    panic("bench: ${benchPhase(dir)} exited ${code} — see ${dir}")
  }
  let err = readFile("${dir}/err.txt") catch _ {
    ""
  }
  let swept = intAfter(err, "swept=")
  let live = intAfter(err, "live=")
  if (swept < 0 || live < 0) {
    panic("bench: no 'swept=N live=N' summary in ${dir}/err.txt (got: ${err})")
  }
  return BenchResult{ objects: swept + live, elapsedMs: elapsedMs, skip: "" }
}

test "compressing 100KB reports its allocation count" {
  let loc = locateBit()
  if (len(loc.bin) == 0) {
    println(
        "compress bench: no usable bit binary + BIT_STDLIB pair found " +
        "(set BIT_SELF_EXE to enable) — skipping the allocation measurement",
    )
    return
  }
  let r = buildAndMeasureAlloc(loc)
  if (len(r.skip) > 0) {
    println("compress bench: ${r.skip} (gave up after ${r.elapsedMs}ms)")
    return
  }
  println(
      "compress bench: gzip(100KB text, level=6) allocated ${r.objects} objects " +
      "(swept+live), compiled and run in ${r.elapsedMs}ms of a ${benchBudgetMs}ms budget",
  )
  assert(r.objects > 0, "compress bench: expected at least one allocation, got ${r.objects}")
  // Generous on purpose (observed ~75 on 2026-09-04) — this is a
  // regression tripwire against an accidental per-byte or per-token
  // allocation creeping into the hot path, not a tight pin.
  assert(
    r.objects < 5000,
      "compress bench: ${r.objects} objects for a 100KB input looks like a regression " +
      "(expected roughly constant per block, not per byte or per token)",
  )
}
