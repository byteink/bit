// Bit standard library — compress module, LSB-first bit-level writer for
// RFC 1951 DEFLATE streams.
//
// DEFLATE packs an ordinary multi-bit field (the 3-bit block header, a
// stored block's byte-aligned length, every length/distance extra-bit
// field) with the value's LSB written first (RFC 1951 §3.1.1). A Huffman
// code is the one field packed the OPPOSITE way, MSB first (§3.2.2).
// `writeBits` is the LSB-first primitive every other field uses;
// `writeHuffman` bit-reverses a code before handing it to `writeBits` —
// writing the reversed value LSB-first produces exactly the MSB-first
// sequence the format requires, the standard trick every DEFLATE encoder
// uses instead of a second, bit-by-bit primitive.
//
// The output buffer grows with `append`, one whole byte at a time as the
// accumulator fills — never built by string concatenation or a slice copy
// (bitlang-ws/CLAUDE.md's #2945/#3115 land on exactly this path: a
// compressor appends per output byte, so a hidden per-append allocation or
// a `s[lo:hi]` copy would show up directly in the allocation-count
// benchmark).
class BitWriter {
  out: []u8
  acc: u32
  nbits: int

  // Appends the low `n` bits of `v`, LSB of `v` first. Every caller here
  // passes `n` <= 16 (the longest static Huffman code is 9 bits, the widest
  // extra-bit field 13), and `nbits` is always < 8 between calls (the while
  // loop below drains full bytes eagerly), so `acc` never needs more than
  // its low 24 bits — comfortably inside `u32`.
  writeBits(v: u32, n: int) {
    this.acc = this.acc | ((v & bitMask(n)) << u32(this.nbits))
    this.nbits = this.nbits + n
    while (this.nbits >= 8) {
      this.out = append(this.out, u8(this.acc & 0xff))
      this.acc = this.acc >> 8
      this.nbits = this.nbits - 8
    }
  }

  // Appends a Huffman code, MSB of `code` first (RFC 1951 §3.2.2) — see the
  // file header for why this bit-reverses rather than writing bit by bit.
  writeHuffman(code: u32, codeLen: int) {
    this.writeBits(reverseBits(code, codeLen), codeLen)
  }

  // Pads with zero bits to the next byte boundary. RFC 1951 §3.2.4: a
  // stored block's LEN/NLEN and raw data all start byte-aligned, and the
  // discarded padding bits are exactly what a decoder expects to skip.
  align() {
    if (this.nbits > 0) {
      this.out = append(this.out, u8(this.acc & 0xff))
      this.acc = 0
      this.nbits = 0
    }
  }

  // Appends one raw byte with no bit packing. Only meaningful right after
  // `align()` — a stored block's LEN/NLEN header and its literal data.
  writeByte(b: u8) {
    this.out = append(this.out, b)
  }
}

// A fresh writer, its output buffer pre-sized to `capacityHint` bytes so the
// common case (compressed output no larger than the input) grows `out` zero
// times. `capacityHint` is advisory only: `append`'s doubling still handles
// any input this undersizes.
fn newBitWriter(capacityHint: int): BitWriter {
  return BitWriter{ out: []u8(0, capacityHint), acc: 0, nbits: 0 }
}

fn bitMask(n: int): u32 {
  return (u32(1) << u32(n)) - u32(1)
}

// Reverses the low `n` bits of `v`; bits at or above position `n` are
// ignored and the result never sets them.
fn reverseBits(v: u32, n: int): u32 {
  let r: u32 = 0
  let x = v
  let i = 0
  while (i < n) {
    r = (r << 1) | (x & 1)
    x = x >> 1
    i = i + 1
  }
  return r
}
