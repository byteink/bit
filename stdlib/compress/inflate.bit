// Raw DEFLATE decoding keeps output storage fixed at the caller's limit.
class InflateTree {
  counts: []int
  offsets: []int
  symbols: []int
  total: int

  reset(lengths: []int, start: int, size: int): ()! {
    this.total = 0
    let i = 0
    while (i < 16) {
      this.counts[i] = 0
      i = i + 1
    }
    i = 0
    while (i < size) {
      let width = lengths[start + i]
      if (width < 0 || width > 15) {
        fail newError("inflate: invalid Huffman code length")
      }
      if (width > 0) {
        this.counts[width] = this.counts[width] + 1
        this.total = this.total + 1
      }
      i = i + 1
    }
  }

  validate(single: bool, empty: bool): ()! {
    if (this.total == 0) {
      if (empty) {
        return
      }
      fail newError("inflate: empty Huffman tree")
    }
    let left = 1
    let width = 1
    while (width <= 15) {
      left = left * 2 - this.counts[width]
      if (left < 0) {
        fail newError("inflate: oversubscribed Huffman tree")
      }
      width = width + 1
    }
    if (left != 0 && !(single && this.total == 1 && this.counts[1] == 1)) {
      fail newError("inflate: incomplete Huffman tree")
    }
  }

  build(lengths: []int, start: int, size: int, single: bool, empty: bool): ()! {
    this.reset(lengths, start, size)?
    this.validate(single, empty)?
    this.offsets[1] = 0
    let width = 1
    while (width < 15) {
      this.offsets[width + 1] = this.offsets[width] + this.counts[width]
      width = width + 1
    }
    let i = 0
    while (i < size) {
      width = lengths[start + i]
      if (width > 0) {
        this.symbols[this.offsets[width]] = i
        this.offsets[width] = this.offsets[width] + 1
      }
      i = i + 1
    }
  }

  decode(reader: InflateReader): int! {
    let code = 0
    let first = 0
    let index = 0
    let width = 1
    while (width <= 15) {
      code = code | reader.bits(1)?
      let count = this.counts[width]
      if (code >= first && code - first < count) {
        return this.symbols[index + code - first]
      }
      index = index + count
      first = (first + count) * 2
      code = code * 2
      width = width + 1
    }
    fail newError("inflate: invalid Huffman code")
  }
}

fn newInflateTree(): InflateTree {
  return InflateTree{ counts = []int(16), offsets = []int(16), symbols = []int(288), total = 0 }
}

class InflateReader {
  src: []u8
  pos: int
  bit: int

  bits(size: int): int! {
    let value = 0
    let i = 0
    while (i < size) {
      if (this.pos >= len(this.src)) {
        fail newError("inflate: truncated input")
      }
      value = value | (((int(this.src[this.pos]) >> this.bit) & 1) << i)
      this.bit = this.bit + 1
      if (this.bit == 8) {
        this.bit = 0
        this.pos = this.pos + 1
      }
      i = i + 1
    }
    return value
  }

  align() {
    if (this.bit != 0) {
      this.pos = this.pos + 1
      this.bit = 0
    }
  }
}

const inflateCodeOrder: [19]int = [19]int{
  16,
  17,
  18,
  0,
  8,
  7,
  9,
  6,
  10,
  5,
  11,
  4,
  12,
  3,
  13,
  2,
  14,
  1,
  15,
}

class Inflater {
  reader: InflateReader
  out: []u8
  used: int
  literal: InflateTree
  distance: InflateTree
  code: InflateTree
  lengths: []int
  codeLengths: []int

  room(size: int): ()! {
    if (size > len(this.out) - this.used) {
      fail newError("inflate: output exceeds maxOut")
    }
  }

  stored(): ()! {
    this.reader.align()
    let size = this.reader.bits(16)?
    let complement = this.reader.bits(16)?
    if ((size ^ complement) != 65535) {
      fail newError("inflate: stored length mismatch")
    }
    if (size > len(this.reader.src) - this.reader.pos) {
      fail newError("inflate: truncated stored block")
    }
    this.room(size)?
    let i = 0
    while (i < size) {
      this.out[this.used] = this.reader.src[this.reader.pos]
      this.used = this.used + 1
      this.reader.pos = this.reader.pos + 1
      i = i + 1
    }
  }

  fixed(): ()! {
    let i = 0
    while (i < 288) {
      this.lengths[i] = fixedLitCodeLen(i)
      i = i + 1
    }
    this.literal.build(this.lengths, 0, 288, false, false)?
    i = 0
    while (i < 32) {
      this.lengths[i] = fixedDistCodeLen(i)
      i = i + 1
    }
    this.distance.build(this.lengths, 0, 32, false, false)?
  }

  readCodeTree(size: int): ()! {
    let i = 0
    while (i < 19) {
      this.codeLengths[i] = 0
      i = i + 1
    }
    i = 0
    while (i < size) {
      this.codeLengths[inflateCodeOrder[i]] = this.reader.bits(3)?
      i = i + 1
    }
    this.code.build(this.codeLengths, 0, 19, false, false)?
  }

  repeatLength(symbol: int, at: int, size: int): int! {
    let value = 0
    let count = 0
    if (symbol == 16) {
      if (at == 0) {
        fail newError("inflate: repeat has no previous code length")
      }
      value = this.lengths[at - 1]
      count = 3 + this.reader.bits(2)?
    } else if (symbol == 17) {
      count = 3 + this.reader.bits(3)?
    } else {
      count = 11 + this.reader.bits(7)?
    }
    if (count > size - at) {
      fail newError("inflate: code length repeat exceeds tree")
    }
    let i = 0
    while (i < count) {
      this.lengths[at + i] = value
      i = i + 1
    }
    return count
  }

  readLengths(size: int): ()! {
    let at = 0
    while (at < size) {
      let symbol = this.code.decode(this.reader)?
      if (symbol < 16) {
        this.lengths[at] = symbol
        at = at + 1
      } else {
        at = at + this.repeatLength(symbol, at, size)?
      }
    }
  }

  dynamic(): ()! {
    let literals = 257 + this.reader.bits(5)?
    let distances = 1 + this.reader.bits(5)?
    let codes = 4 + this.reader.bits(4)?
    if (literals > 286) {
      fail newError("inflate: reserved literal tree size")
    }
    this.readCodeTree(codes)?
    this.readLengths(literals + distances)?
    if (this.lengths[256] == 0) {
      fail newError("inflate: missing end of block code")
    }
    this.literal.build(this.lengths, 0, literals, true, false)?
    // An all-literal block has no distance codes, even though HDIST is one.
    this.distance.build(this.lengths, literals, distances, true, true)?
  }

  copyMatch(symbol: int): ()! {
    if (symbol > 285) {
      fail newError("inflate: reserved length symbol")
    }
    let index = symbol - 257
    let size = lengthBaseTable[index] + this.reader.bits(lengthExtraTable[index])?
    if (this.distance.total == 0) {
      fail newError("inflate: match without distance tree")
    }
    let distanceSymbol = this.distance.decode(this.reader)?
    if (distanceSymbol > 29) {
      fail newError("inflate: reserved distance symbol")
    }
    let distance = distBaseTable[distanceSymbol] + this.reader.bits(distExtraTable[distanceSymbol])?
    if (distance > this.used) {
      fail newError("inflate: distance exceeds output history")
    }
    this.room(size)?
    let i = 0
    while (i < size) {
      this.out[this.used] = this.out[this.used - distance]
      this.used = this.used + 1
      i = i + 1
    }
  }

  compressed(): ()! {
    // Each nonterminal symbol emits at least one byte. The extra iteration
    // permits an end marker at exactly maxOut without overflowing a counter.
    let remaining = len(this.out)
    while (remaining >= 0) {
      let symbol = this.literal.decode(this.reader)?
      if (symbol == 256) {
        return
      }
      if (symbol < 256) {
        this.room(1)?
        this.out[this.used] = u8(symbol)
        this.used = this.used + 1
      } else {
        this.copyMatch(symbol)?
      }
      remaining = remaining - 1
    }
    fail newError("inflate: output exceeds maxOut")
  }

  run(): []u8! {
    let blocks = 0
    // Every block consumes at least one input byte, including empty blocks.
    while (blocks < len(this.reader.src)) {
      let final = this.reader.bits(1)?
      let kind = this.reader.bits(2)?
      if (kind == 3) {
        fail newError("inflate: reserved block type")
      }
      if (kind == 0) {
        this.stored()?
      } else {
        if (kind == 1) {
          this.fixed()?
        } else {
          this.dynamic()?
        }
        this.compressed()?
      }
      if (final != 0) {
        this.reader.align()
        if (this.reader.pos != len(this.reader.src)) {
          fail newError("inflate: trailing input")
        }
        return this.out[:this.used]
      }
      blocks = blocks + 1
    }
    fail newError("inflate: missing final block")
  }
}

export fn inflate(src: []u8, maxOut: int): []u8! {
  if (maxOut <= 0) {
    fail newError("inflate: maxOut must be positive")
  }
  let decoder = Inflater{
    reader = InflateReader{ src = src, pos = 0, bit = 0 }, out = []u8(maxOut), used = 0,
    literal = newInflateTree(), distance = newInflateTree(), code = newInflateTree(),
    lengths = []int(318), codeLengths = []int(19),
  }
  return decoder.run()?
}

fn inflateU16(src: []u8, at: int): int {
  return int(src[at]) | (int(src[at + 1]) << 8)
}

fn inflateU32(src: []u8, at: int): u32 {
  return u32(src[at]) |
    (u32(src[at + 1]) << 8) |
    (u32(src[at + 2]) << 16) |
    (u32(src[at + 3]) << 24)
}

fn gzipHeaderString(src: []u8, at: int, limit: int): int! {
  let i = at
  while (i < limit) {
    if (src[i] == 0) {
      return i + 1
    }
    i = i + 1
  }
  fail newError("gunzip: unterminated header string")
}

fn gzipSkipExtra(src: []u8, at: int, limit: int): int! {
  if (limit - at < 2) {
    fail newError("gunzip: truncated extra length")
  }
  let size = inflateU16(src, at)
  let start = at + 2
  if (size > limit - start) {
    fail newError("gunzip: truncated extra field")
  }
  return start + size
}

fn gzipCheckHeader(src: []u8, at: int, limit: int): int! {
  if (limit - at < 2) {
    fail newError("gunzip: truncated header checksum")
  }
  if (u32(inflateU16(src, at)) != (gzipCrc32(src[:at]) & 65535)) {
    fail newError("gunzip: header checksum mismatch")
  }
  return at + 2
}

fn gzipHeaderEnd(src: []u8): int! {
  if (len(src) < 18) {
    fail newError("gunzip: truncated container")
  }
  if (src[0] != u8(gzipMagic0) || src[1] != u8(gzipMagic1) || src[2] != u8(gzipCmDeflate)) {
    fail newError("gunzip: invalid header")
  }
  let flags = int(src[3])
  if ((flags & 224) != 0) {
    fail newError("gunzip: reserved header flags")
  }
  let limit = len(src) - 8
  let at = 10
  if ((flags & 4) != 0) {
    at = gzipSkipExtra(src, at, limit)?
  }
  if ((flags & 8) != 0) {
    at = gzipHeaderString(src, at, limit)?
  }
  if ((flags & 16) != 0) {
    at = gzipHeaderString(src, at, limit)?
  }
  if ((flags & 2) != 0) {
    at = gzipCheckHeader(src, at, limit)?
  }
  return at
}

export fn gunzip(src: []u8, maxOut: int): []u8! {
  if (maxOut <= 0) {
    fail newError("gunzip: maxOut must be positive")
  }
  let start = gzipHeaderEnd(src)?
  let trailer = len(src) - 8
  let out = inflate(src[start:trailer], maxOut)?
  if (gzipCrc32(out) != inflateU32(src, trailer)) {
    fail newError("gunzip: CRC32 mismatch")
  }
  if (u32(len(out)) != inflateU32(src, trailer + 4)) {
    fail newError("gunzip: size mismatch")
  }
  return out
}
