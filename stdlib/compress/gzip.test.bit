// stdlib/compress/gzip.test.bit — `gzip` correctness (#3957).
//
// Same rule as deflate.test.bit: verified against an INDEPENDENT tool
// (`gzip -dc`), never this module's own code. `scratchDir`/`shellRun` and
// their imports (`std/fs`, `std/os`) are declared once in deflate.test.bit
// and reused here unqualified — a module's files share one flat scope
// (SPEC §19), and importing the same name twice is E0042 "already declared
// in this scope" (bitlang-ws/CLAUDE.md's #3308).

// Verifies `compressed` (a full gzip member from `gzip`) decompresses under
// the system `gzip -dc` — which also checks the CRC32 trailer this module
// writes, not just the DEFLATE body — to exactly `want`.
fn assertGzipRoundTrip(label: string, compressed: []u8, want: []u8) {
  let dir = scratchDir("gzip")
  mkdir(dir) catch e {
    panic("${label}: mkdir ${dir}: ${e.message()}")
  }
  writeFile("${dir}/in.gz", string(compressed)) catch e {
    panic("${label}: write in.gz: ${e.message()}")
  }
  let code = shellRun(
    "${dir}/run.sh",
    "#!/bin/sh\nset -e\ngzip -dc '${dir}/in.gz' > '${dir}/out.bin'\n",
    30000,
  )
  if (code != 0) {
    panic("${label}: gzip -dc exited ${code} — see ${dir}")
  }
  let got: []byte = []byte(
    readFile("${dir}/out.bin") catch e {
      panic("${label}: read out.bin: ${e.message()}")
    },
  )
  eqSlice(got, want, label)
}

test "gzip output starts with the RFC 1952 magic bytes 0x1f 0x8b" {
  let src: []byte = []byte{ 1, 2, 3, 4, 5 }
  let got = gzip(src, 6) catch e {
    panic("gzip: ${e.message()}")
  }
  assert(len(got) >= 2, "gzip output is only ${len(got)} bytes, too short for a header")
  assert(got[0] == 0x1f, "first byte = ${got[0]}, want 0x1f")
  assert(got[1] == 0x8b, "second byte = ${got[1]}, want 0x8b")
}

test "a text fixture round-trips through gzip -d byte for byte" {
  let src = repeatText(5000, "the quick brown fox jumps over the lazy dog. ")
  let got = gzip(src, 6) catch e {
    panic("gzip(text): ${e.message()}")
  }
  assertGzipRoundTrip("text", got, src)
}

test "empty input round-trips through gzip -d" {
  let src: []byte = []byte(0)
  let got = gzip(src, 6) catch e {
    panic("gzip(empty): ${e.message()}")
  }
  assertGzipRoundTrip("empty", got, src)
}

test "64KB of random bytes round-trips through gzip -d and never expands beyond input + 1%" {
  let src = pseudoRandomBytes(65536, 7)
  let got = gzip(src, 6) catch e {
    panic("gzip(random): ${e.message()}")
  }
  assertGzipRoundTrip("random 64KB", got, src)
  // +18 for gzip's own header+trailer (deflate.test.bit's equivalent case
  // covers the raw DEFLATE body's own +1% bound; this asserts the CONTAINER
  // does not add more than its fixed, known overhead on top of that).
  let bound = len(src) + len(src) / 100 + 18
  assert(
    len(got) <= bound,
    "64KB random -> gzip ${len(got)}, want <= ${bound} (input + 1% + gzip's fixed 18-byte header/trailer)",
  )
}

test "input larger than one block round-trips through gzip -d" {
  let src = repeatText(100000, "GET /api/v1/users/42 HTTP/1.1 200 OK\n")
  let got = gzip(src, 6) catch e {
    panic("gzip(100KB): ${e.message()}")
  }
  assertGzipRoundTrip("100KB multi-block", got, src)
}

test "level out of range fails and is propagated from deflate" {
  let src: []byte = []byte{ 1 }
  let ok = true
  let _ = gzip(src, 42) catch _ {
    ok = false
    []byte(0)
  }
  assert(!ok, "gzip(src, 42) should have failed")
}
