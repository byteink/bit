// Bit standard library — compress module, `gzip`: the RFC 1952 container
// around `deflate`'s RFC 1951 stream.
//
// A minimal, single-member gzip stream: the mandatory 10-byte header
// (RFC 1952 §2.3.1) with every optional field (FNAME, FCOMMENT, FEXTRA,
// FHCRC) turned off, `MTIME = 0` ("no timestamp available", explicitly
// allowed by §2.3.1), `XFL = 0`, `OS = 255` ("unknown", also an explicit
// registered value) — then the DEFLATE body, then the mandatory CRC32 +
// ISIZE trailer. `gzip -d`/`zlib.decompress(data, 16 + MAX_WBITS)` read this
// with no special-casing; nothing here is Bit-specific.

const gzipMagic0 = 0x1f
const gzipMagic1 = 0x8b
const gzipCmDeflate = 8
const gzipFlgNone = 0
const gzipXflNone = 0
const gzipOsUnknown = 255

// gzip-compresses `src` at `level` (0..9, see `deflate`'s own doc comment).
// Fails only when `level` is out of range (propagated from `deflate`).
export fn gzip(src: []u8, level: int): []u8! {
  let body = deflate(src, level)?
  let out = []u8(0, len(body) + 18)
  out = append(out, u8(gzipMagic0))
  out = append(out, u8(gzipMagic1))
  out = append(out, u8(gzipCmDeflate))
  out = append(out, u8(gzipFlgNone))
  out = gzipAppendU32LE(out, 0) // MTIME: unavailable
  out = append(out, u8(gzipXflNone))
  out = append(out, u8(gzipOsUnknown))
  out = gzipAppendBytes(out, body)
  out = gzipAppendU32LE(out, gzipCrc32(src))
  // ISIZE (RFC 1952 §2.3.1): input size MODULO 2^32. `u32(int)` truncates to
  // the low 32 bits (SPEC §12.2), which is exactly that reduction.
  out = gzipAppendU32LE(out, u32(len(src)))
  return out
}

fn gzipAppendBytes(dst: []u8, src: []u8): []u8 {
  let i = 0
  let n = len(src)
  while (i < n) {
    dst = append(dst, src[i])
    i = i + 1
  }
  return dst
}

fn gzipAppendU32LE(dst: []u8, v: u32): []u8 {
  dst = append(dst, u8(v & 0xff))
  dst = append(dst, u8((v >> 8) & 0xff))
  dst = append(dst, u8((v >> 16) & 0xff))
  dst = append(dst, u8((v >> 24) & 0xff))
  return dst
}
