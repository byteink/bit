// Bit standard library — sync module, Once.
//
// Runs a function exactly once, however many green threads call `do`
// concurrently. Standard double-checked locking: an atomic fast-path load
// skips the Mutex (mutex.bit, same module) entirely once `f` has already run.

export struct Once { ran: []i64, mu: Mutex }

// A fresh Once, not yet run.
export function newOnce(): Once {
  return Once{ ran: []i64(1), mu: newMutex() }
}

// Runs `f` on the first call only; every call — concurrent or not — blocks
// until that first run has completed.
export function (o: Once) do(f: () => ()) {
  let p = ptrOf(o.ran)
  if (atomicLoad(p) == 1) {
    return
  }
  o.mu.lock()
  if (atomicLoad(p) == 0) {
    f()
    atomicStore(p, 1)
  }
  o.mu.unlock()
}
