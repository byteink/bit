// Bit standard library — sync module, RWMutex.
//
// Many readers or one writer, never both. Built on two Mutex instances
// (mutex.bit, same module): `readers` guards the live-reader count; `writer`
// is held continuously from the first RLock to the last matching RUnlock, and
// held directly by Lock/Unlock. This is the textbook two-mutex
// readers-writer lock, not a novel design.
//
// ponytail: no writer-starvation guard — a steady stream of overlapping
// readers can delay a writer indefinitely. Add writer-priority (a pending-
// writer flag new readers check) if that shows up under real load.

export class RWMutex { readers: Mutex, writer: Mutex, count: []i64 }

// An RWMutex ready to use.
export fn newRWMutex(): RWMutex {
  return RWMutex{ readers: newMutex(), writer: newMutex(), count: []i64(1) }
}

// Acquires the lock for reading. Multiple readers may hold it at once.
export fn (rw: RWMutex) rLock() {
  rw.readers.lock()
  let p = ptrOf(rw.count)
  if (atomicAdd(p, 1) == 0) {
    rw.writer.lock()
  }
  rw.readers.unlock()
}

// Releases a read lock acquired by rLock().
export fn (rw: RWMutex) rUnlock() {
  rw.readers.lock()
  let p = ptrOf(rw.count)
  if (atomicSub(p, 1) == 1) {
    rw.writer.unlock()
  }
  rw.readers.unlock()
}

// Acquires the lock for writing. Excludes both readers and other writers.
export fn (rw: RWMutex) lock() {
  rw.writer.lock()
}

// Releases a write lock acquired by lock().
export fn (rw: RWMutex) unlock() {
  rw.writer.unlock()
}
