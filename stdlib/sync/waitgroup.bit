// Bit standard library — sync module, WaitGroup.
//
// Coordinates a parallel fan-out/fan-in: add(n) before spawning n workers,
// done() at the end of each, wait() in the coordinator. The counter is a
// single-word atomic cell (SPEC §11.5); wait() blocks on a channel close,
// which — like Mutex (mutex.bit) — parks the caller on the scheduler rather
// than spinning, and broadcasts to every waiter at once (SPEC §16.2).
//
// ponytail: single-use. Once the counter reaches zero and wait() has
// unblocked, this WaitGroup is spent — add()ing more work and reusing it races
// the already-closed channel. Construct a fresh WaitGroup per fan-out round.

export struct WaitGroup { count: []i64, doneCh: chan<bool> }

// A fresh WaitGroup with a zero counter.
export fn newWaitGroup(): WaitGroup {
  return WaitGroup{ count: []i64(1), doneCh: chan<bool>() }
}

// Adds `n` (may be negative) to the counter. Call before spawning the workers
// that will later call done() — spawn's own happens-before edge (SPEC §16.1)
// makes this safe without further synchronization.
export fn (wg: WaitGroup) add(n: i64) {
  let p = ptrOf(wg.count)
  atomicAdd(p, n)
}

// Decrements the counter by one; the last caller to reach zero unblocks every
// wait().
export fn (wg: WaitGroup) done() {
  let p = ptrOf(wg.count)
  if (atomicSub(p, 1) == 1) {
    close(wg.doneCh)
  }
}

// Blocks until the counter reaches zero.
export fn (wg: WaitGroup) wait() {
  <- wg.doneCh
}
