// Bit standard library — sync module, atomic integers.
//
// Named wrappers over SPEC §11.5's atomic builtins, which operate on a raw
// `*T` and require `T` be an integer prim. Generic constraints (SPEC §11.3)
// are interface bounds only — there is no "integer prim" bound to write a
// single `Atomic<T>` against — so this offers one concrete class per width
// in common use, the same shape as Go's `sync/atomic.Int64`/`Uint64`.
//
// All operations use sequential consistency (SPEC §11.5) — the strongest
// ordering, and the only one v0.1 exposes.

export class AtomicI64 {
  cell: []i64
  export load(): i64 {
    return atomicLoad(ptrOf(this.cell))
  }

  export store(v: i64) {
    atomicStore(ptrOf(this.cell), v)
  }

  // Adds `delta` and returns the new value (unlike the raw builtin, which
  // returns the previous one — this matches Go's `atomic.Int64.Add`).
  export add(delta: i64): i64 {
    return atomicAdd(ptrOf(this.cell), delta) + delta
  }

  // If the current value equals `old`, stores `newVal` and returns true.
  export compareAndSwap(old: i64, newVal: i64): bool {
    return atomicCmpxchg(ptrOf(this.cell), old, newVal)
  }

  // Stores `v` and returns the previous value.
  export swap(v: i64): i64 {
    return atomicXchg(ptrOf(this.cell), v)
  }
}
export class AtomicU64 {
  cell: []u64
  export load(): u64 {
    return atomicLoad(ptrOf(this.cell))
  }

  export store(v: u64) {
    atomicStore(ptrOf(this.cell), v)
  }

  export add(delta: u64): u64 {
    return atomicAdd(ptrOf(this.cell), delta) + delta
  }

  export compareAndSwap(old: u64, newVal: u64): bool {
    return atomicCmpxchg(ptrOf(this.cell), old, newVal)
  }

  export swap(v: u64): u64 {
    return atomicXchg(ptrOf(this.cell), v)
  }
}

export fn newAtomicI64(v: i64): AtomicI64 {
  let a = AtomicI64{ cell: []i64(1) }
  atomicStore(ptrOf(a.cell), v)
  return a
}

export fn newAtomicU64(v: u64): AtomicU64 {
  let a = AtomicU64{ cell: []u64(1) }
  atomicStore(ptrOf(a.cell), v)
  return a
}

