// Bit standard library — cbor module, IEEE 754 binary16/binary32 <-> binary64.
//
// CBOR carries a float as 2, 4 or 8 bytes. Bit has no f16 type and no f32 bit
// cast back to f64, so the widening is done here on the bit patterns: widening
// to binary64 is always exact, and the narrowing the encoder needs ("the
// shortest width that round-trips", RFC 8949 section 4.2.2) is an exactness
// test on the same patterns, never a lossy conversion followed by a compare.

// What `narrowBits` returns when the value does not fit the narrower format
// exactly. No binary16 or binary32 pattern without its sign bit reaches it.
const narrowNone: u64 = 0xffffffffffffffff

const f64FracMask: u64 = 0xfffffffffffff
const f64ExpInf: u64 = 0x7ff

// `x` with its sign bit set when `neg` is.
fn withSign(bits: u64, neg: bool): u64 {
  if (neg) {
    return bits | (u64(1) << 63)
  }
  return bits
}

// A subnormal value `m * 2^-scale`, `m` the integer mantissa. The power of two
// is built as a binary64 pattern, so the product is exact.
fn subnormal(m: u64, scale: int): f64 {
  return f64(m) * bitsToFloat(u64(1023 - scale) << 52)
}

// The binary64 value of the binary16 pattern `h` (the low 16 bits).
fn halfToF64(h: u64): f64 {
  let neg = ((h >> 15) & 1) == 1
  let e = int((h >> 10) & 0x1f)
  let m = h & 0x3ff
  if (e == 0) {
    return bitsToFloat(withSign(floatBits(subnormal(m, 24)), neg))
  }
  if (e == 31) {
    return bitsToFloat(withSign((f64ExpInf << 52) | (m << 42), neg))
  }
  return bitsToFloat(withSign((u64(e - 15 + 1023) << 52) | (m << 42), neg))
}

// The binary64 value of the binary32 pattern `b` (the low 32 bits).
fn singleToF64(b: u64): f64 {
  let neg = ((b >> 31) & 1) == 1
  let e = int((b >> 23) & 0xff)
  let m = b & 0x7fffff
  if (e == 0) {
    return bitsToFloat(withSign(floatBits(subnormal(m, 149)), neg))
  }
  if (e == 255) {
    return bitsToFloat(withSign((f64ExpInf << 52) | (m << 29), neg))
  }
  return bitsToFloat(withSign((u64(e - 127 + 1023) << 52) | (m << 29), neg))
}

// The magnitude pattern (no sign bit) of a finite, nonzero binary64 value of
// unbiased exponent `exp` and fraction `frac` in a format with `mw` fraction
// bits, largest exponent `emax` and exponent bias `bias`, or `narrowNone` when
// that format cannot hold it exactly (too large, too small, or a nonzero bit
// would be dropped).
fn narrowBits(frac: u64, exp: int, mw: u64, emax: int, bias: int): u64 {
  if (exp > emax) {
    return narrowNone
  }
  let drop: u64 = 52 - mw
  let emin = 1 - bias
  if (exp >= emin) {
    if ((frac & ((u64(1) << drop) - 1)) != 0) {
      return narrowNone
    }
    return (u64(exp + bias) << mw) | (frac >> drop)
  }
  // Subnormal in the narrow format: the full 53-bit significand shifts right
  // by `drop + (emin - exp)`; past 52 the mantissa would be zero for a nonzero
  // value.
  let shift = drop + u64(emin - exp)
  if (shift > 52) {
    return narrowNone
  }
  let full = (u64(1) << 52) | frac
  if ((full & ((u64(1) << shift) - 1)) != 0) {
    return narrowNone
  }
  return full >> shift
}

// The shortest CBOR float encoding of the binary64 pattern `bits`: its width in
// bytes (2, 4 or 8) and the pattern in that width. NaN is always the one
// canonical half NaN (0x7e00), whatever its sign or payload, so equal inputs
// give equal bytes. Zero and infinity are exact in binary16.
class FloatForm {
  width: int,
  bits: u64,
}

fn shortestFloat(bits: u64): FloatForm {
  let neg = (bits >> 63) == 1
  let e = (bits >> 52) & 0x7ff
  let frac = bits & f64FracMask
  if (e == f64ExpInf && frac != 0) {
    return FloatForm{ width = 2, bits = 0x7e00 }
  }
  let sign16 = withSign(0, neg) >> 48
  if (e == f64ExpInf) {
    return FloatForm{ width = 2, bits = sign16 | 0x7c00 }
  }
  if (e == 0 && frac == 0) {
    return FloatForm{ width = 2, bits = sign16 }
  }
  if (e != 0) {
    let exp = int(e) - 1023
    let h = narrowBits(frac, exp, 10, 15, 15)
    if (h != narrowNone) {
      return FloatForm{ width = 2, bits = sign16 | h }
    }
    let s = narrowBits(frac, exp, 23, 127, 127)
    if (s != narrowNone) {
      return FloatForm{ width = 4, bits = (withSign(0, neg) >> 32) | s }
    }
  }
  return FloatForm{ width = 8, bits = bits }
}
