// std/cbor: every row of the RFC 8949 Appendix A table decodes to the value the
// RFC names, every deterministic row re-encodes to its own hex, and malformed
// input fails with an error instead of a crash.
//
// The expected values are built with constructors, not parsed from the RFC's
// diagnostic text, so decoder and expectation share no code. `diag` renders a
// tree for comparison; floats compare by bit pattern (any NaN equals any NaN),
// which `==` on f64 cannot do for NaN or the two zeros.

import { contains } from "std/strings"

// Hex helpers of this file's own: std/crypto reads COSE keys with std/cbor, so
// std/cbor cannot import std/crypto, not even from a test.
const hexDigits: string = "0123456789abcdef"

fn encodeHex(b: []byte): string {
  let out = []byte(len(b) * 2)
  let i = 0
  while (i < len(b)) {
    out[i * 2] = hexDigits[int(b[i] >> 4)]
    out[i * 2 + 1] = hexDigits[int(b[i] & 0x0f)]
    i = i + 1
  }
  return string(out)
}

fn hexNibble(c: u8): u8! {
  if (c >= 48 && c <= 57) {
    return c - 48
  }
  if (c >= 97 && c <= 102) {
    return c - 87
  }
  if (c >= 65 && c <= 70) {
    return c - 55
  }
  fail newError("bad hex digit ${int(c)}")
}

fn decodeHex(s: string): []byte! {
  if (len(s) % 2 != 0) {
    fail newError("odd hex length")
  }
  let out = []byte(len(s) / 2)
  let i = 0
  while (i < len(out)) {
    let hi = hexNibble(s[i * 2])?
    let lo = hexNibble(s[i * 2 + 1])?
    out[i] = (hi << 4) | lo
    i = i + 1
  }
  return out
}

// One Appendix A row: the encoded hex, the value it decodes to, and whether
// `encode` reproduces the hex. A row is decode-only when the RFC shows an
// encoding that is valid CBOR but not the deterministic one: an indefinite
// length, or a float wider than its value needs.
class Row {
  hex: string,
  want: Cbor,
  det: bool,
}

fn row(hex: string, want: Cbor, det: bool): Row {
  return Row{ hex = hex, want = want, det = det }
}

fn ui(n: uint): Cbor { return Cbor.Uint(n) }
fn ng(n: uint): Cbor { return Cbor.Negative(n) }
fn tx(s: string): Cbor { return Cbor.Text(s) }
fn fl(f: f64): Cbor { return Cbor.Float(f) }
fn ar(items: []Cbor): Cbor { return Cbor.Array(items) }
fn ent(k: Cbor, v: Cbor): CborEntry { return CborEntry{ key = k, value = v } }

fn by(hex: string): Cbor {
  let b = decodeHex(hex) catch _ {
    return Cbor.Null
  }
  return Cbor.Bytes(b)
}

fn hexBytes(hex: string): []byte {
  let b = decodeHex(hex) catch _ {
    assert(false, "bad hex in test: ${hex}")
    return []byte(0)
  }
  return b
}

// --- diagnostic rendering ---------------------------------------------------

fn diagFloat(f: f64): string {
  if (f != f) {
    return "NaN"
  }
  return "float:${floatBits(f)}"
}

fn diagItems(xs: []Cbor): string {
  let out = "["
  let i = 0
  while (i < len(xs)) {
    if (i > 0) {
      out = out + ","
    }
    out = out + diag(xs[i])
    i = i + 1
  }
  return out + "]"
}

fn diagEntries(es: []CborEntry): string {
  let out = "{"
  let i = 0
  while (i < len(es)) {
    if (i > 0) {
      out = out + ","
    }
    out = out + diag(es[i].key) + ":" + diag(es[i].value)
    i = i + 1
  }
  return out + "}"
}

fn diagLeaf(v: Cbor): string {
  return match (v) {
    Null => "null"
    Undefined => "undefined"
    Uint(n) => "${n}"
    Negative(n) => "-1-${n}"
    Simple(n) => "simple(${n})"
    Float(f) => diagFloat(f)
    Bool(b) => "${b}"
    _ => ""
  }
}

fn diag(v: Cbor): string {
  return match (v) {
    Bytes(b) => "h'${encodeHex(b)}'"
    Text(s) => "\"${s}\""
    Array(xs) => diagItems(xs)
    Map(es) => diagEntries(es)
    Tag(t, c) => "${t}(${diag(c)})"
    _ => diagLeaf(v)
  }
}

// --- the Appendix A table ---------------------------------------------------

fn rowsIntegers(): []Row {
  return [
    row("00", ui(0), true),
    row("01", ui(1), true),
    row("0a", ui(10), true),
    row("17", ui(23), true),
    row("1818", ui(24), true),
    row("1819", ui(25), true),
    row("1864", ui(100), true),
    row("1903e8", ui(1000), true),
    row("1a000f4240", ui(1000000), true),
    row("1b000000e8d4a51000", ui(1000000000000), true),
    row("1bffffffffffffffff", ui(18446744073709551615), true),
    row("c249010000000000000000", Cbor.Tag(2, by("010000000000000000")), true),
    row("3bffffffffffffffff", ng(18446744073709551615), true),
    row("c349010000000000000000", Cbor.Tag(3, by("010000000000000000")), true),
    row("20", ng(0), true),
    row("29", ng(9), true),
    row("3863", ng(99), true),
    row("3903e7", ng(999), true),
  ]
}

fn rowsFloats(): []Row {
  return [
    row("f90000", fl(0.0), true),
    row("f98000", fl(-0.0), true),
    row("f93c00", fl(1.0), true),
    row("fb3ff199999999999a", fl(1.1), true),
    row("f93e00", fl(1.5), true),
    row("f97bff", fl(65504.0), true),
    row("fa47c35000", fl(100000.0), true),
    row("fa7f7fffff", fl(3.4028234663852886e+38), true),
    row("fb7e37e43c8800759c", fl(1.0e+300), true),
    row("f90001", fl(5.960464477539063e-8), true),
    row("f90400", fl(0.00006103515625), true),
    row("f9c400", fl(-4.0), true),
    row("fbc010666666666666", fl(-4.1), true),
    row("f97c00", fl(bitsToFloat(0x7ff0000000000000)), true),
    row("f97e00", fl(bitsToFloat(0x7ff8000000000000)), true),
    row("f9fc00", fl(bitsToFloat(0xfff0000000000000)), true),
    row("fa7f800000", fl(bitsToFloat(0x7ff0000000000000)), false),
    row("fa7fc00000", fl(bitsToFloat(0x7ff8000000000000)), false),
    row("faff800000", fl(bitsToFloat(0xfff0000000000000)), false),
    row("fb7ff0000000000000", fl(bitsToFloat(0x7ff0000000000000)), false),
    row("fb7ff8000000000000", fl(bitsToFloat(0x7ff8000000000000)), false),
    row("fbfff0000000000000", fl(bitsToFloat(0xfff0000000000000)), false),
  ]
}

fn rowsSimpleAndTags(): []Row {
  return [
    row("f4", Cbor.Bool(false), true),
    row("f5", Cbor.Bool(true), true),
    row("f6", Cbor.Null, true),
    row("f7", Cbor.Undefined, true),
    row("f0", Cbor.Simple(16), true),
    row("f8ff", Cbor.Simple(255), true),
    row(
      "c074323031332d30332d32315432303a30343a30305a",
      Cbor.Tag(0, tx("2013-03-21T20:04:00Z")),
      true,
    ),
    row("c11a514b67b0", Cbor.Tag(1, ui(1363896240)), true),
    row("c1fb41d452d9ec200000", Cbor.Tag(1, fl(1363896240.5)), true),
    row("d74401020304", Cbor.Tag(23, by("01020304")), true),
    row("d818456449455446", Cbor.Tag(24, by("6449455446")), true),
    row(
      "d82076687474703a2f2f7777772e6578616d706c652e636f6d",
      Cbor.Tag(32, tx("http://www.example.com")),
      true,
    ),
  ]
}

fn rowsStrings(): []Row {
  return [
    row("40", by(""), true),
    row("4401020304", by("01020304"), true),
    row("60", tx(""), true),
    row("6161", tx("a"), true),
    row("6449455446", tx("IETF"), true),
    row("62225c", tx("\"\\"), true),
    row("62c3bc", tx("ü"), true),
    row("63e6b0b4", tx("水"), true),
    row("64f0908591", tx("𐅑"), true),
  ]
}

fn oneToTwentyFive(): []Cbor {
  let xs = []Cbor(0)
  let i: uint = 1
  while (i <= 25) {
    xs = append(xs, ui(i))
    i = i + 1
  }
  return xs
}

fn nested(): Cbor {
  return ar([ui(1), ar([ui(2), ui(3)]), ar([ui(4), ui(5)])])
}

fn rowsContainers(): []Row {
  return [
    row("80", ar([]Cbor(0)), true),
    row("83010203", ar([ui(1), ui(2), ui(3)]), true),
    row("8301820203820405", nested(), true),
    row("98190102030405060708090a0b0c0d0e0f101112131415161718181819", ar(oneToTwentyFive()), true),
    row("a0", Cbor.Map([]CborEntry(0)), true),
    row("a201020304", Cbor.Map([ent(ui(1), ui(2)), ent(ui(3), ui(4))]), true),
    row(
      "a26161016162820203",
      Cbor.Map([ent(tx("a"), ui(1)), ent(tx("b"), ar([ui(2), ui(3)]))]),
      true,
    ),
    row("826161a161626163", ar([tx("a"), Cbor.Map([ent(tx("b"), tx("c"))])]), true),
    row(
      "a56161614161626142616361436164614461656145",
      Cbor.Map(
        [
          ent(tx("a"), tx("A")),
          ent(tx("b"), tx("B")),
          ent(tx("c"), tx("C")),
          ent(tx("d"), tx("D")),
          ent(tx("e"), tx("E")),
        ],
      ),
      true,
    ),
  ]
}

fn rowsIndefinite(): []Row {
  let mixed = ar([ui(1), ar([ui(2), ui(3)]), ar([ui(4), ui(5)])])
  return [
    row("5f42010243030405ff", by("0102030405"), false),
    row("7f657374726561646d696e67ff", tx("streaming"), false),
    row("9fff", ar([]Cbor(0)), false),
    row("9f018202039f0405ffff", mixed, false),
    row("9f01820203820405ff", mixed, false),
    row("83018202039f0405ff", mixed, false),
    row("83019f0203ff820405", mixed, false),
    row("9f0102030405060708090a0b0c0d0e0f101112131415161718181819ff", ar(oneToTwentyFive()), false),
    row(
      "bf61610161629f0203ffff",
      Cbor.Map([ent(tx("a"), ui(1)), ent(tx("b"), ar([ui(2), ui(3)]))]),
      false,
    ),
    row("826161bf61626163ff", ar([tx("a"), Cbor.Map([ent(tx("b"), tx("c"))])]), false),
    row(
      "bf6346756ef563416d7421ff",
      Cbor.Map([ent(tx("Fun"), Cbor.Bool(true)), ent(tx("Amt"), ng(1))]),
      false,
    ),
  ]
}

fn appendixA(): []Row {
  let all = []Row(0)
  all = append(all, ...rowsIntegers())
  all = append(all, ...rowsFloats())
  all = append(all, ...rowsSimpleAndTags())
  all = append(all, ...rowsStrings())
  all = append(all, ...rowsContainers())
  all = append(all, ...rowsIndefinite())
  return all
}

// `decode` of `hex` rendered, or the error text.
fn decoded(hex: string, opts: DecodeOptions): string {
  let v = decode(hexBytes(hex), opts) catch e {
    return "error: ${e.message()}"
  }
  return diag(v)
}

fn isError(s: string): bool {
  return len(s) >= 6 && s[0:6] == "error:"
}

test "Appendix A: every row decodes to the value the RFC names" {
  let rows = appendixA()
  let ok = 0
  for r of rows {
    let got = decoded(r.hex, DecodeOptions{})
    let want = diag(r.want)
    if (got == want) {
      ok = ok + 1
    } else {
      assert(false, "${r.hex}: got ${got}, want ${want}")
    }
  }
  println("cbor appendix A: ${ok} of ${len(rows)} decoded")
  assert(len(rows) == 81, "Appendix A has 81 rows, the table here has ${len(rows)}")
  assert(ok == len(rows), "${ok} of ${len(rows)} rows decoded")
}

test "Appendix A: every deterministic row re-encodes to its own hex" {
  let rows = appendixA()
  let same = 0
  let det = 0
  for r of rows {
    if (r.det) {
      det = det + 1
      let out = encode(r.want) catch e {
        assert(false, "${r.hex}: encode failed: ${e.message()}")
        return
      }
      if (encodeHex(out) == r.hex) {
        same = same + 1
      } else {
        assert(false, "${r.hex}: encoded to ${encodeHex(out)}")
      }
    }
  }
  println("cbor appendix A: ${same} of ${det} deterministic rows re-encode identically, ${len(rows) - det} decode-only")
  assert(same == det, "${same} of ${det} rows re-encode identically")
}

test "Appendix A: decode-only rows are named by their reason" {
  // 17 rows: 11 indefinite-length, and 6 infinities and NaNs written wider than
  // the 2 bytes the encoder uses for them.
  let rows = appendixA()
  let n = 0
  for r of rows {
    if (!r.det) {
      n = n + 1
    }
  }
  assert(n == 17, "decode-only rows: ${n}")
}

test "strict mode accepts exactly the deterministic rows" {
  let rows = appendixA()
  let strict = DecodeOptions{ strict = true }
  for r of rows {
    let got = decoded(r.hex, strict)
    if (r.det) {
      assert(got == diag(r.want), "${r.hex} strict: ${got}")
    } else {
      assert(isError(got), "${r.hex} must fail strict, got ${got}")
    }
  }
}

// --- malformed input --------------------------------------------------------

class Bad {
  name: string,
  hex: string,
  strict: bool,
  want: string,
}

fn bad(name: string, hex: string, strict: bool, want: string): Bad {
  return Bad{ name = name, hex = hex, strict = strict, want = want }
}

fn deepArrays(n: int): string {
  let out = ""
  let i = 0
  while (i < n) {
    out = out + "81"
    i = i + 1
  }
  return out + "00"
}

// The twelve malformed shapes the ticket names, each with the error text it
// must produce. Every one must fail; a few more variants of each follow.
fn malformed(): []Bad {
  return [
    bad("truncated head", "1903", false, "unexpected end"),
    bad("truncated array", "830102", false, "exceeds the remaining input"),
    bad("truncated element", "8301", false, "exceeds the remaining input"),
    bad("truncated map value", "bf01", false, "unexpected end"),
    bad("truncated map", "a1", false, "exceeds the remaining input"),
    bad("truncated string body", "6449", false, "exceeds the remaining input"),
    bad("length bomb, bytes", "5bffffffffffffffff", false, "exceeds the remaining input"),
    bad("length bomb 2^63", "5b8000000000000000", false, "exceeds the remaining input"),
    bad("length bomb, array", "9bffffffffffffffff", false, "exceeds the remaining input"),
    bad("length bomb, map", "bb7fffffffffffffff", false, "exceeds the remaining input"),
    bad("depth 17", deepArrays(17), false, "nesting deeper"),
    bad("duplicate keys, strict", "a201020103", true, "duplicate map key"),
    bad("bad UTF-8", "62c328", false, "not valid UTF-8"),
    bad("UTF-8 surrogate", "63eda080", false, "not valid UTF-8"),
    bad("UTF-8 overlong", "62c080", false, "not valid UTF-8"),
    bad("reserved info 28", "1c", false, "reserved additional information"),
    bad("reserved info 30 on a string", "5e", false, "reserved additional information"),
    bad("break at top level", "ff", false, "unexpected break"),
    bad("break in a definite array", "8301ff02", false, "unexpected break"),
    bad("trailing bytes", "0000", false, "trailing bytes"),
    bad("non-shortest int, strict", "1800", true, "shortest form"),
    bad("non-shortest length, strict", "180a", true, "shortest form"),
    bad("non-shortest 4-byte, strict", "1a00000001", true, "shortest form"),
    bad("unsorted keys, strict", "a202000100", true, "bytewise order"),
    bad("tag without content", "c1", false, "unexpected end"),
    bad("tag over a break", "c1ff", false, "unexpected break"),
    bad("two-byte simple 0", "f800", false, "below 32"),
    bad("two-byte simple 20", "f814", false, "below 32"),
    bad("two-byte simple 31", "f81f", false, "below 32"),
    bad("indefinite array, strict", "9fff", true, "strict"),
    bad("indefinite string, strict", "5f4101ff", true, "strict"),
    bad("float not shortest, strict", "fb3ff8000000000000", true, "shortest form"),
    bad("NaN payload, strict", "f97e01", true, "shortest form"),
    bad("unterminated indefinite array", "9f01", false, "unexpected end"),
    bad("unterminated indefinite string", "5f4101", false, "unexpected end"),
    bad("chunk of the wrong type", "5f6101ff", false, "same type"),
    bad("nested indefinite chunk", "5f5fffff", false, "same type"),
    bad("indefinite integer", "1f", false, "indefinite length on an integer"),
    bad("indefinite tag", "df", false, "indefinite length"),
    bad("empty input", "", false, "unexpected end"),
  ]
}

test "malformed input fails with a named error, never a crash" {
  let cases = malformed()
  let n = 0
  for c of cases {
    let got = decoded(c.hex, DecodeOptions{ strict = c.strict })
    if (isError(got) && contains(got, c.want)) {
      n = n + 1
    } else {
      assert(false, "${c.name} (${c.hex}): got ${got}, want error containing '${c.want}'")
    }
  }
  println("cbor malformed: ${n} of ${len(cases)} rejected with the expected error")
}

test "controls: the same shapes decode when they are legal" {
  assert(
    decoded(deepArrays(16), DecodeOptions{}) == "[[[[[[[[[[[[[[[[0]]]]]]]]]]]]]]]]",
    "16 nested arrays",
  )
  assert(
    decoded("a201020103", DecodeOptions{}) == "{1:2,1:3}",
    "duplicate keys keep wire order when not strict",
  )
  assert(decoded("1800", DecodeOptions{}) == "0", "non-shortest int when not strict")
  assert(decoded("a202000100", DecodeOptions{}) == "{2:0,1:0}", "unsorted keys when not strict")
  assert(
    decoded("a201020304", DecodeOptions{ strict = true }) == "{1:2,3:4}",
    "sorted keys when strict",
  )
}

test "limits: depth, items and string bytes come from the options" {
  assert(
    isError(decoded(deepArrays(4), DecodeOptions{ maxDepth = 3 })),
    "depth 4 over a limit of 3",
  )
  assert(
    !isError(decoded(deepArrays(3), DecodeOptions{ maxDepth = 3 })),
    "depth 3 within a limit of 3",
  )
  assert(isError(decoded("c1c1c100", DecodeOptions{ maxDepth = 2 })), "tags count as nesting")
  assert(isError(decoded("83010203", DecodeOptions{ maxItems = 3 })), "4 items over a limit of 3")
  assert(
    !isError(decoded("83010203", DecodeOptions{ maxItems = 4 })),
    "4 items within a limit of 4",
  )
  assert(isError(decoded("a2010203", DecodeOptions{ maxItems = 4 })), "map entries are items too")
  assert(
    isError(decoded("4401020304", DecodeOptions{ maxBytes = 3 })),
    "4 string bytes over a limit of 3",
  )
  assert(
    !isError(decoded("4401020304", DecodeOptions{ maxBytes = 4 })),
    "4 string bytes within a limit of 4",
  )
  assert(isError(decoded("5f420102420304ff", DecodeOptions{ maxBytes = 3 })), "chunks add up")
  assert(isError(decoded("9a00010000", DecodeOptions{})), "a count over the limit and the input")
}

test "decodePrefix reports the bytes it used and ignores the rest" {
  let data = hexBytes("8301820203f5ff00")
  let (v, used) = decodePrefix(data) catch e {
    assert(false, e.message())
    return
  }
  assert(diag(v) == "[1,[2,3],true]", "prefix value ${diag(v)}")
  assert(used == 6, "used ${used}")
  let (w, n) = decodePrefix(hexBytes("a1616101f6")) catch e {
    assert(false, e.message())
    return
  }
  assert(diag(w) == "{\"a\":1}" && n == 4, "map prefix ${diag(w)} ${n}")
}

test "truncating any Appendix A row at any point is an error, not a crash" {
  let rows = appendixA()
  let cut = 0
  for r of rows {
    let full = hexBytes(r.hex)
    let n = 0
    while (n < len(full)) {
      let got = decode(full[0:n]) catch _ {
        cut = cut + 1
        n = n + 1
        continue
      }
      assert(false, "${r.hex} cut to ${n} bytes decoded to ${diag(got)}")
    }
  }
  println("cbor truncation: ${cut} proper prefixes of ${len(rows)} rows, all rejected")
}

test "flipping any single byte of an Appendix A row never crashes" {
  let rows = appendixA()
  let tried = 0
  for r of rows {
    let full = hexBytes(r.hex)
    let i = 0
    while (i < len(full)) {
      let mutated = append([]byte(0), ...full)
      mutated[i] = mutated[i] ^ 0xa5
      decode(mutated) catch _ {
        tried = tried + 1
        i = i + 1
        continue
      }
      tried = tried + 1
      i = i + 1
    }
  }
  assert(tried > 0, "no mutations ran")
}

test "strict decode accepts exactly what encode writes: encode(decode(x)) == x" {
  let rows = appendixA()
  for r of rows {
    if (!r.det) {
      continue
    }
    let v = decode(hexBytes(r.hex), DecodeOptions{ strict = true }) catch e {
      assert(false, "${r.hex}: ${e.message()}")
      return
    }
    let out = encode(v) catch e {
      assert(false, "${r.hex}: ${e.message()}")
      return
    }
    assert(encodeHex(out) == r.hex, "${r.hex} re-encoded as ${encodeHex(out)}")
  }
}

// --- encoder ----------------------------------------------------------------

fn encodedHex(v: Cbor): string {
  let out = encode(v) catch e {
    return "error: ${e.message()}"
  }
  return encodeHex(out)
}

test "encode: integers and lengths use the shortest head" {
  assert(encodedHex(ui(23)) == "17", "23")
  assert(encodedHex(ui(24)) == "1818", "24")
  assert(encodedHex(ui(255)) == "18ff", "255")
  assert(encodedHex(ui(256)) == "190100", "256")
  assert(encodedHex(ui(65535)) == "19ffff", "65535")
  assert(encodedHex(ui(65536)) == "1a00010000", "65536")
  assert(encodedHex(ui(4294967295)) == "1affffffff", "2^32-1")
  assert(encodedHex(ui(4294967296)) == "1b0000000100000000", "2^32")
  assert(encodedHex(Cbor.Bytes([]byte(0))) == "40", "empty bytes")
  assert(encodedHex(tx("")) == "60", "empty text")
  assert(encodedHex(Cbor.Tag(55799, ui(0))) == "d9d9f700", "self-describe tag")
}

test "encode: floats take the shortest width that round-trips" {
  assert(encodedHex(fl(1.0)) == "f93c00", "1.0 half")
  assert(encodedHex(fl(65504.0)) == "f97bff", "max half")
  assert(encodedHex(fl(65536.0)) == "fa47800000", "2^16 needs single")
  assert(encodedHex(fl(5.960464477539063e-8)) == "f90001", "smallest half subnormal")
  assert(encodedHex(fl(2.9802322387695312e-8)) == "fa33000000", "2^-25 is single")
  assert(encodedHex(fl(1.401298464324817e-45)) == "fa00000001", "smallest single subnormal")
  assert(
    encodedHex(fl(1.0e-46)) == "fb" + encodeHex(u64Bytes(floatBits(1.0e-46))),
    "below single stays double",
  )
  assert(encodedHex(fl(1.1)) == "fb3ff199999999999a", "1.1 double")
  assert(encodedHex(fl(-0.0)) == "f98000", "negative zero")
  assert(encodedHex(fl(bitsToFloat(0x7ff0000000000000))) == "f97c00", "infinity")
  assert(
    encodedHex(fl(bitsToFloat(0xfff8000000000001))) == "f97e00",
    "any NaN is the canonical NaN",
  )
}

fn u64Bytes(v: u64): []byte {
  let out = []byte(0)
  let i = 7
  while (i >= 0) {
    out = append(out, u8((v >> u64(8 * i)) & 0xff))
    i = i - 1
  }
  return out
}

test "encode: map keys sort bytewise by their encoding, whatever the input order" {
  let m = Cbor.Map(
    [
      ent(tx("b"), ui(1)),
      ent(ui(10), ui(2)),
      ent(tx("a"), ui(3)),
      ent(ui(1), ui(4)),
      ent(Cbor.Bool(false), ui(5)),
    ],
  )
  // 01, 0a, 6161, 6162, f4 sort by first byte then length.
  assert(
    encodedHex(m) == "a5" + "0104" + "0a02" + "616103" + "616201" + "f405",
    "sorted map ${encodedHex(m)}",
  )
  // nested maps sort too
  let nest = Cbor.Map(
    [ent(ui(2), Cbor.Map([ent(ui(9), ui(0)), ent(ui(3), ui(0))])), ent(ui(1), ui(0))],
  )
  assert(encodedHex(nest) == "a2" + "0100" + "02a2" + "0300" + "0900", "nested ${encodedHex(nest)}")
}

test "encode refuses what it cannot write deterministically" {
  assert(isError(encodedHex(Cbor.Map([ent(ui(1), ui(2)), ent(ui(1), ui(3))]))), "duplicate keys")
  assert(
    isError(encodedHex(Cbor.Map([ent(fl(0.0), ui(2)), ent(fl(-0.0), ui(3)), ent(fl(0.0), ui(4))]))),
    "duplicate float key",
  )
  assert(isError(encodedHex(Cbor.Simple(24))), "simple 24 is not well-formed")
  assert(isError(encodedHex(Cbor.Simple(31))), "simple 31 is not well-formed")
  assert(encodedHex(Cbor.Simple(32)) == "f820", "simple 32")
  assert(encodedHex(Cbor.Simple(19)) == "f3", "simple 19")
}

test "encode: a value nested past the depth limit is an error, not a stack overflow" {
  let v = Cbor.Null
  let i = 0
  while (i < 1100) {
    v = ar([v])
    i = i + 1
  }
  assert(isError(encodedHex(v)), "1100 levels")
}

test "text and byte strings round-trip, including multi-byte text" {
  let v = ar(
    [tx("ü水𐅑"), by("00ff80"), Cbor.Tag(7, tx("")), Cbor.Undefined, Cbor.Simple(200), ng(0)],
  )
  let out = encode(v) catch e {
    assert(false, e.message())
    return
  }
  let back = decode(out, DecodeOptions{ strict = true }) catch e {
    assert(false, e.message())
    return
  }
  assert(diag(back) == diag(v), "round trip ${diag(back)}")
}

test "the zero Cbor is null" {
  let z: Cbor
  assert(diag(z) == "null", "zero value ${diag(z)}")
}
