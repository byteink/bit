// Bit standard library — cbor module, the deterministic encoder
// (RFC 8949 section 4.2).

import { sortInPlace } from "std/sort"

// How deep `encode` follows nested values. A `Cbor` tree built from immutable
// variants cannot be cyclic, but its slices are mutable, so a cycle is
// reachable; the limit turns one into an error instead of a stack overflow.
const encodeMaxDepth = 1024

class Writer {
  buf: []byte,
}

// `n` bytes of `v`, most significant first.
fn putBe(w: Writer, v: u64, n: int) {
  let i = n - 1
  while (i >= 0) {
    w.buf = append(w.buf, u8((v >> u64(8 * i)) & 0xff))
    i = i - 1
  }
}

// A head: `major` in the top three bits, then `arg` in its shortest form.
fn putHead(w: Writer, major: int, arg: u64) {
  let m = u8(major << 5)
  if (arg < 24) {
    w.buf = append(w.buf, m | u8(arg))
    return
  }
  if (arg < 256) {
    w.buf = append(w.buf, m | 24)
    putBe(w, arg, 1)
    return
  }
  if (arg < 65536) {
    w.buf = append(w.buf, m | 25)
    putBe(w, arg, 2)
    return
  }
  if (arg < 4294967296) {
    w.buf = append(w.buf, m | 26)
    putBe(w, arg, 4)
    return
  }
  w.buf = append(w.buf, m | 27)
  putBe(w, arg, 8)
}

fn putFloat(w: Writer, f: f64) {
  let form = shortestFloat(floatBits(f))
  if (form.width == 2) {
    w.buf = append(w.buf, u8(0xf9))
  }
  if (form.width == 4) {
    w.buf = append(w.buf, u8(0xfa))
  }
  if (form.width == 8) {
    w.buf = append(w.buf, u8(0xfb))
  }
  putBe(w, form.bits, form.width)
}

fn putSimple(w: Writer, n: u8): ()! {
  if (n >= 24 && n < 32) {
    fail newError("cbor: simple values 24 to 31 are not well-formed")
  }
  putHead(w, 7, u64(n))
}

// An encoded map entry: the key's encoding, which is the sort key, and the
// whole entry's.
class EncEntry {
  key: []byte,
  whole: []byte,
}

// Bytewise lexicographic order of two encodings (RFC 8949 section 4.2.1).
fn bytesLess(a: []byte, b: []byte): bool {
  let i = 0
  while (i < len(a) && i < len(b)) {
    if (a[i] != b[i]) {
      return a[i] < b[i]
    }
    i = i + 1
  }
  return len(a) < len(b)
}

fn sameBytes(a: []byte, b: []byte): bool {
  return len(a) == len(b) && !bytesLess(a, b) && !bytesLess(b, a)
}

fn encLess(a: EncEntry, b: EncEntry): bool {
  return bytesLess(a.key, b.key)
}

fn encodeToBytes(v: Cbor, depth: int): []byte! {
  let w = Writer{ buf = []byte(0) }
  putValue(w, v, depth)?
  return w.buf
}

// A map: every entry encoded on its own, sorted by key encoding, then written.
// Two equal key encodings are a duplicate key, which a map cannot hold.
fn putMap(w: Writer, entries: []CborEntry, depth: int): ()! {
  let enc = []EncEntry(0, len(entries))
  for e of entries {
    let k = encodeToBytes(e.key, depth + 1)?
    let v = encodeToBytes(e.value, depth + 1)?
    enc = append(enc, EncEntry{ key = k, whole = append(append([]byte(0), ...k), ...v) })
  }
  sortInPlace(enc, encLess)
  putHead(w, 5, u64(len(enc)))
  let i = 0
  while (i < len(enc)) {
    if (i > 0 && sameBytes(enc[i - 1].key, enc[i].key)) {
      fail newError("cbor: duplicate map key")
    }
    w.buf = append(w.buf, ...enc[i].whole)
    i = i + 1
  }
}

fn putArray(w: Writer, items: []Cbor, depth: int): ()! {
  putHead(w, 4, u64(len(items)))
  for item of items {
    putValue(w, item, depth + 1)?
  }
}

fn putBool(w: Writer, b: bool) {
  if (b) {
    putHead(w, 7, 21)
    return
  }
  putHead(w, 7, 20)
}

// The variants with no children.
fn putScalar(w: Writer, v: Cbor): ()! {
  match (v) {
    Null => putHead(w, 7, 22)
    Undefined => putHead(w, 7, 23)
    Uint(n) => putHead(w, 0, n)
    Negative(n) => putHead(w, 1, n)
    Simple(n) => putSimple(w, n)?
    Float(f) => putFloat(w, f)
    Bool(b) => putBool(w, b)
    _ => return
  }
}

fn putValue(w: Writer, v: Cbor, depth: int): ()! {
  if (depth > encodeMaxDepth) {
    fail newError("cbor: value nested deeper than ${encodeMaxDepth}")
  }
  match (v) {
    Bytes(b) => {
      putHead(w, 2, u64(len(b)))
      w.buf = append(w.buf, ...b)
    }
    Text(s) => {
      putHead(w, 3, u64(len(s)))
      w.buf = append(w.buf, ...[]byte(s))
    }
    Array(items) => putArray(w, items, depth)?
    Map(entries) => putMap(w, entries, depth)?
    Tag(t, inner) => {
      putHead(w, 6, t)
      putValue(w, inner, depth + 1)?
    }
    _ => putScalar(w, v)?
  }
}

// The deterministic encoding of `v`. Fails on a map with two equal keys, on a
// `Simple` value 24 to 31 (not a well-formed item), and on a value nested more
// than 1024 deep.
export fn encode(v: Cbor): []byte! {
  return encodeToBytes(v, 0)?
}
