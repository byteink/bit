// Bit standard library — cbor module (RFC 8949).
//
// CBOR is the binary data model under WebAuthn attestation objects and COSE
// keys. This module decodes and encodes it, and treats every input as
// untrusted: a decode never panics, never trusts a declared length before
// checking it against the bytes that are actually there, and is bounded in
// nesting depth, item count and string bytes.
//
//   decode(data, opts)        one item that must fill `data` exactly.
//   decodePrefix(data, opts)  the first item and the number of bytes it used,
//                             for formats that put more bytes after it (a
//                             WebAuthn authenticator-data credential key is
//                             followed by extension data).
//   encode(v)                 the deterministic encoding of RFC 8949 section
//                             4.2: shortest integers and lengths, the shortest
//                             float that round-trips, map keys sorted bytewise
//                             by their encoding, no indefinite lengths.
//
// `DecodeOptions.strict` makes `decode` accept exactly what `encode` can
// produce: `encode(decode(x)) == x` byte for byte for every `x` it accepts.
//
// The value tree is one sum type, `Cbor`, mirroring std/json's `Json`. A map is
// `[]CborEntry`, not `map<K, V>`: CBOR keys are any item, and order and
// duplicates must survive a decode so the caller can see them. `Null` is the
// first variant so `Cbor` has a zero value (a payload-first enum has none).

// One key/value pair of a CBOR map, in wire order.
export class CborEntry { export key: Cbor, export value: Cbor }

// A CBOR data item (RFC 8949 section 3).
//
// `Uint(n)` is the integer n. `Negative(n)` is the integer -1 - n, so the full
// RFC range down to -2^64 is representable. `Bool`, `Null` and `Undefined` are
// the simple values 20 to 23; `Simple(n)` is every other simple value, n in 0
// to 19 or 32 to 255. `Float` holds a half, single or double alike: the width
// on the wire is a property of the encoding, not of the value.
export enum Cbor {
  Null,
  Undefined,
  Uint(uint),
  Negative(uint),
  Bytes([]byte),
  Text(string),
  Array([]Cbor),
  Map([]CborEntry),
  Tag(uint, Cbor),
  Simple(u8),
  Float(f64),
  Bool(bool),
}

// The limits and strictness of one decode. Every field has a default, so
// `DecodeOptions{}` is a complete configuration.
export class DecodeOptions {
  // Containers (arrays, maps, tags) may nest this deep: with 16, a chain of 16
  // nested arrays decodes and a 17th fails.
  export maxDepth: int = 16,
  // The most data items one decode may produce, counting every nested item.
  export maxItems: int = 65536,
  // The most string bytes one decode may produce, counting every byte and text
  // string, chunks included.
  export maxBytes: int = 16777216,
  // Reject everything `encode` would not have written: integers and lengths
  // that are not shortest, floats wider than needed, indefinite lengths, and
  // map keys that are duplicated or out of bytewise order.
  export strict: bool = false,
}

// The first data item in `data` and the number of bytes it occupies. Whatever
// follows it is not looked at, so a caller can walk a stream of items or read a
// CBOR value embedded in a larger structure.
//
// Fails, never panics, on truncated input, a declared length longer than the
// remaining bytes, reserved additional information (28 to 30), a misplaced
// break, invalid UTF-8 in a text string, a two-byte simple value below 32, and
// any limit in `opts`; in strict mode also on everything `encode` would not
// write.
export fn decodePrefix(data: []byte, opts: DecodeOptions = DecodeOptions{}): (Cbor, int)! {
  let r = newReader(data, opts)
  let v = decodeItem(r, 0)?
  return (v, r.pos)
}

// The one data item that makes up all of `data`. Bytes after the item are an
// error; use `decodePrefix` to read an item that is followed by something else.
export fn decode(data: []byte, opts: DecodeOptions = DecodeOptions{}): Cbor! {
  let (v, used) = decodePrefix(data, opts)?
  if (used != len(data)) {
    fail newError("cbor: ${len(data) - used} trailing bytes after the item")
  }
  return v
}
