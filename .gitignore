# Build output and caches
bit-out/

# OS / editor cruft
.DS_Store

# VS Code extension build output
editors/vscode/node_modules/
editors/vscode/dist/
editors/vscode/out/
editors/vscode/*.vsix

# scripts/selfhost-fixpoint.sh scratch (stage binaries)
.fixpoint-work/
scripts/.x64gate-host

# machine-local x86-64 gate hosts (see scripts/x64host.sh)
.x64hosts
# ssd deploy config + its build cache. Machine-local: deploy credentials and
# server paths are not repo content. This repo no longer deploys anything itself
# — the website moved to byteink/bit-website — but the rule stands if it ever does.
.ssd/
# Release build output (dist/release.sh). Artifacts are attached to the GitHub
# release, never committed - and release.sh refuses to run on a dirty tree, so
# leaving this untracked would make the second run fail on the first run's output.
dist/out/

# Per-checkout smash project pointer (see bitlang-ws/CLAUDE.md). smash does not
# walk up parent directories, so every worktree needs its own copy of the
# workspace root's smash.json to resolve the project at all — but that copy is
# local plumbing, not repo content, and it is not this ignore that stops
# `smash` from reading it: .gitignore only controls what git reports (#2493).
smash.json
