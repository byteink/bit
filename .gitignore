# Build output and caches
bit-out/

# OS / editor cruft
.DS_Store

# VS Code extension build output
editors/vscode/node_modules/
editors/vscode/dist/
editors/vscode/out/
editors/vscode/*.vsix

# scripts/selfhost-fixpoint.sh scratch (stage binaries)
.fixpoint-work/
scripts/.x64gate-host

# machine-local x86-64 gate hosts (see scripts/x64host.sh)
.x64hosts
# ssd deploy config + its build cache (machine-local; `ssd init` in this repo).
# Deploy credentials and server paths are not repo content — website/deploy.sh
# and website/deploy/bitlang-org.yaml remain the committed, reviewable path.
.ssd/
# Fetched GitHub advisory feed for the support page (website/advisories.sh).
# Build state, not source: absent is a valid state the page renders honestly.
website/advisories.json
# Release build output (dist/release.sh). Artifacts are attached to the GitHub
# release, never committed - and release.sh refuses to run on a dirty tree, so
# leaving this untracked would make the second run fail on the first run's output.
dist/out/
