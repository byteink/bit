// pkg/redis/json.live.test.bit - `r.json(key)` against a real server.
// `liveUrl`/`liveClient` are `client.live.test.bit`'s own (same module, no
// import); every test is skipped, and says so, when `REDIS_TEST_URL` is unset.
// `./make test-package-redis-live` (`_tests_/bit/redislive.bit`) supplies it,
// against `redis:8.10.2` in a throwaway Docker container, where JSON is
// built in. `InkAuthor` and its nested classes are `json.test.bit`'s.

fn jsonClean(c: Client, keys: []string) {
  c.del(keys) catch e {
    panic("del: ${e.message()}")
  }
}

// A tree from JSON text, for the values a test writes by hand.
fn jtree(text: string): JsonValue {
  return jsonParse(text) catch e {
    panic("jtree '${text}': ${e.message()}")
  }
}

// Stores `a` at `key` through the class's own `toJson()`.
fn jsonPut(c: Client, key: string, a: InkAuthor) {
  let ok = c.json(key).set(a.toJson()) catch e {
    panic("set ${key}: ${e.message()}")
  }
  assert(ok, "set at the root of ${key} applies")
}

fn commaJoin(parts: []string): string {
  let out = ""
  let i = 0
  while (i < len(parts)) {
    if (i > 0) {
      out = "${out},"
    }
    out = "${out}${parts[i]}"
    i = i + 1
  }
  return out
}

// One slot per match, `-` for a match the command does not apply to.
fn showInts(xs: []Option<i64>): string {
  let out = []string(0)
  for x of xs {
    match (x) {
      Some(n) => out = append(out, "${n}")
      None => out = append(out, "-")
    }
  }
  return commaJoin(out)
}

fn showNums(xs: []Option<f64>): string {
  let out = []string(0)
  for x of xs {
    match (x) {
      Some(n) => out = append(out, "${n}")
      None => out = append(out, "-")
    }
  }
  return commaJoin(out)
}

fn showTrees(xs: []Option<JsonValue>): string {
  let out = []string(0)
  for x of xs {
    match (x) {
      Some(t) => out = append(out, jsonEncode(t))
      None => out = append(out, "-")
    }
  }
  return commaJoin(out)
}

// The tree at one path, as compact JSON text.
fn jsonAtPath(c: Client, key: string, path: string): string {
  let found = c.json(key).getPaths(path) catch e {
    panic("getPaths ${path}: ${e.message()}")
  }
  assert(len(found) == 1 && len(found[0].values) == 1, "${path} has one match")
  return jsonEncode(found[0].values[0])
}

test "live: a nested @json class set then get<T> round-trips every field" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:json:author"
  jsonClean(c, [key])
  let a = inkAuthor()
  jsonPut(c, key, a)

  let kind = c.command(["TYPE", key]) catch e {
    panic("type: ${e.message()}")
  }
  match (kind) {
    Simple(name) => assert(name == "ReJSON-RL", "the key is a JSON document, got ${name}")
    _ => panic("TYPE answered a different shape")
  }
  let back = c.json(key).get<InkAuthor>() catch e {
    panic("get: ${e.message()}")
  }
  match (back) {
    Some(b) => {
      assert(jsonEncode(b.toJson()) == jsonEncode(a.toJson()), "the whole class survives")
      assert(b.address.city == "Lisbon" && b.address.country == "PT", "nested class")
      assert(
        len(b.drafts) == 2 && b.drafts[0].title == "One" && b.drafts[1].words == 120,
        "array of classes",
      )
      assert(b.tags[0] == "essays" && b.rating == 4.5 && b.verified, "array, float and bool")
      assert(unwrapOr(b.nickname, "") == "ana", "Option field")
    }
    None => panic("the document is there")
  }

  let drafts = c.json(key).getAt<InkDraft>("$.drafts[*]") catch e {
    panic("getAt drafts: ${e.message()}")
  }
  assert(len(drafts) == 2 && drafts[1].title == "Two", "every match of a wildcard path")
  let addr = c.json(key).getAt<InkAddress>("$.address") catch e {
    panic("getAt address: ${e.message()}")
  }
  assert(len(addr) == 1 && addr[0].city == "Lisbon", "a nested class at its path")
  let none = c.json(key).getAt<InkDraft>("$.nothing[*]") catch e {
    panic("getAt nothing: ${e.message()}")
  }
  assert(len(none) == 0, "a path with no match is empty")
  jsonClean(c, [key])
  c.close()
}

test "live: get is None for a missing key, and a document that does not fit T fails" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:json:shape"
  jsonClean(c, [key])
  let missing = c.json(key).get<InkAuthor>() catch e {
    panic("get missing: ${e.message()}")
  }
  assert(isNone(missing), "a missing key is None")

  c.json(key).set(jtree("{\"id\":\"a1\"}")) catch e {
    panic("set: ${e.message()}")
  }
  let failed = false
  let _ = c.json(key).get<InkAuthor>() catch e {
    failed = contains(e.message(), "cannot decode")
    Option.None
  }
  assert(failed, "a document missing the class's fields fails Unexpected")
  jsonClean(c, [key])
  c.close()
}

test "live: set at a path honours NX, XX and a missing parent" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:json:set"
  let other = "bit:live:json:setother"
  jsonClean(c, [key, other])
  let j = c.json(key)

  let xxMissing = j.set(jtree("1"), "$", JsonSetOptions{ xx = true }) catch e {
    panic("xx on a missing key: ${e.message()}")
  }
  assert(!xxMissing, "XX on a missing key sets nothing")
  let first = j.set(jtree("{\"a\":1}"), "$", JsonSetOptions{ nx = true }) catch e {
    panic("nx: ${e.message()}")
  }
  assert(first, "NX on a missing key sets it")
  let again = j.set(jtree("{\"a\":2}"), "$", JsonSetOptions{ nx = true }) catch e {
    panic("nx again: ${e.message()}")
  }
  assert(!again, "NX on an existing key sets nothing")

  let added = j.set(jtree("8"), "$.b") catch e {
    panic("new member: ${e.message()}")
  }
  assert(added, "a new object member is created under an existing parent")
  let xxNew = j.set(jtree("9"), "$.c", JsonSetOptions{ xx = true }) catch e {
    panic("xx new member: ${e.message()}")
  }
  assert(!xxNew, "XX on a path with no match sets nothing")
  let orphan = j.set(jtree("1"), "$.x.y") catch e {
    panic("orphan: ${e.message()}")
  }
  assert(!orphan, "a path whose parent is missing cannot be created")
  assert(
    jsonAtPath(c, key, "$") == "{\"a\":1,\"b\":8}",
    "the document is ${jsonAtPath(c, key, "$")}",
  )

  let refused = false
  let _ = c.json(other).set(jtree("1"), "$.x") catch e {
    refused = contains(e.message(), "root")
    false
  }
  assert(refused, "a new key can only be created at the root")

  let ok = j.set(jtree("[1.5,2.5]"), "$", JsonSetOptions{ fpha = JsonFloatType.Fp32 }) catch e {
    panic("fpha: ${e.message()}")
  }
  assert(ok, "FPHA pins the number array's type")
  assert(jsonAtPath(c, key, "$") == "[1.5,2.5]", "the FPHA array reads back")
  jsonClean(c, [key, other])
  c.close()
}

test "live: mget, mset, merge and getPaths read and write several places at once" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let ka = "bit:live:json:ma"
  let kb = "bit:live:json:mb"
  let kc = "bit:live:json:mc"
  jsonClean(c, [ka, kb, kc])
  let bo = inkAuthor()
  bo.id = "b2"
  bo.name = "Bo"
  jsonPut(c, ka, inkAuthor())
  jsonPut(c, kb, bo)

  let both = c.json(ka).mget<InkAuthor>([kb, kc]) catch e {
    panic("mget: ${e.message()}")
  }
  assert(len(both) == 3, "one slot per key, got ${len(both)}")
  assert(isSome(both[0]) && isSome(both[1]) && isNone(both[2]), "the third key is missing")
  assert(unwrap(both[1]).name == "Bo", "slots follow the order of the keys")
  let ids = c.json(ka).mget<InkAddress>([kb], "$.address") catch e {
    panic("mget path: ${e.message()}")
  }
  assert(unwrap(ids[0]).city == "Lisbon", "mget reads one path across keys")

  c.json(ka).mset(
    JsonValue.JsonFloat(3.5), "$.rating",
    JsonTarget{ key = kc, path = "$", value = jtree("{\"fresh\":true}") },
  ) catch e {
    panic("mset: ${e.message()}")
  }
  assert(jsonAtPath(c, ka, "$.rating") == "3.5", "mset updated a path of an existing key")
  assert(jsonAtPath(c, kc, "$") == "{\"fresh\":true}", "mset created a key at its root")

  c.json(ka).merge(jtree("{\"nickname\":null,\"address\":{\"city\":\"Porto\"}}")) catch e {
    panic("merge: ${e.message()}")
  }
  let merged = unwrap(
    c.json(ka).get<InkAuthor>() catch e {
      panic("get merged: ${e.message()}")
    },
  )
  assert(isNone(merged.nickname), "merging null deletes the key")
  assert(
    merged.address.city == "Porto" && merged.address.country == "PT",
    "objects merge key by key",
  )
  assert(len(merged.tags) == 2, "keys the merge did not name stay")

  let many = c.json(ka).getPaths("$.name", "$.address.city", "$.nothing") catch e {
    panic("getPaths: ${e.message()}")
  }
  assert(len(many) == 3, "one entry per path asked")
  assert(many[0].path == "$.name" && jsonEncode(many[0].values[0]) == "\"Ana\"", "first path")
  assert(jsonEncode(many[1].values[0]) == "\"Porto\"", "second path")
  assert(len(many[2].values) == 0, "a path with no match has no values")
  jsonClean(c, [ka, kb, kc])
  c.close()
}

test "live: del, clear and typeOf work on the matches of a path" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:json:shape2"
  jsonClean(c, [key])
  jsonPut(c, key, inkAuthor())
  let j = c.json(key)

  let kinds = j.typeOf() catch e {
    panic("type root: ${e.message()}")
  }
  assert(len(kinds) == 1 && kinds[0] == "object", "the root is an object")
  let titles = j.typeOf("$.drafts[*].title") catch e {
    panic("type titles: ${e.message()}")
  }
  assert(commaJoin(titles) == "string,string", "one type per match: ${commaJoin(titles)}")
  let mixed = j.typeOf("$.rating") catch e {
    panic("type rating: ${e.message()}")
  }
  assert(commaJoin(mixed) == "number", "a float is a number: ${commaJoin(mixed)}")
  let words = j.typeOf("$.drafts[0].words") catch e {
    panic("type words: ${e.message()}")
  }
  assert(commaJoin(words) == "integer", "an integer: ${commaJoin(words)}")
  let nothing = j.typeOf("$.nothing") catch e {
    panic("type nothing: ${e.message()}")
  }
  assert(len(nothing) == 0, "no match, no type")
  let gone = c.json("bit:live:json:nokey").typeOf() catch e {
    panic("type missing key: ${e.message()}")
  }
  assert(len(gone) == 0, "a missing key has no type")

  let cleared = j.clear("$.tags") catch e {
    panic("clear: ${e.message()}")
  }
  assert(cleared == 1, "an array is emptied, got ${cleared}")
  assert(jsonAtPath(c, key, "$.tags") == "[]", "the cleared array is empty")
  let zeroed = j.clear("$.drafts[*].words") catch e {
    panic("clear numbers: ${e.message()}")
  }
  assert(zeroed == 2, "numbers are zeroed, got ${zeroed}")
  assert(jsonAtPath(c, key, "$.drafts[1].words") == "0", "a zeroed number is 0")

  let removed = j.del("$.address.country") catch e {
    panic("del: ${e.message()}")
  }
  assert(removed == 1, "one member removed, got ${removed}")
  let none = j.del("$.nothing") catch e {
    panic("del nothing: ${e.message()}")
  }
  assert(none == 0, "nothing to remove")
  assert(jsonAtPath(c, key, "$.address") == "{\"city\":\"Lisbon\"}", "the member is gone")
  let root = j.del() catch e {
    panic("del root: ${e.message()}")
  }
  assert(root == 1, "the root goes")
  let after = j.get<InkAuthor>() catch e {
    panic("get after: ${e.message()}")
  }
  assert(isNone(after), "deleting the root deletes the key")
  jsonClean(c, [key])
  c.close()
}

test "live: numIncrBy, numMultBy, strAppend and strLen answer one slot per match" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:json:nums"
  jsonClean(c, [key])
  jsonPut(c, key, inkAuthor())
  let j = c.json(key)

  let bumped = j.numIncrBy(2.0, "$.drafts[*].words") catch e {
    panic("incr: ${e.message()}")
  }
  assert(showNums(bumped) == "902,122", "incr gave ${showNums(bumped)}")
  let doubled = j.numMultBy(2.0, "$.drafts[*].words") catch e {
    panic("mult: ${e.message()}")
  }
  assert(showNums(doubled) == "1804,244", "mult gave ${showNums(doubled)}")
  let rating = j.numIncrBy(0.5, "$.rating") catch e {
    panic("incr rating: ${e.message()}")
  }
  assert(showNums(rating) == "5", "a float result: ${showNums(rating)}")
  let notNumber = j.numIncrBy(1.0, "$.name") catch e {
    panic("incr string: ${e.message()}")
  }
  assert(showNums(notNumber) == "-", "a string is not a number")
  let noMatch = j.numMultBy(3.0, "$.nothing") catch e {
    panic("mult nothing: ${e.message()}")
  }
  assert(len(noMatch) == 0, "no match, no slot")
  assert(jsonAtPath(c, key, "$.drafts[0].words") == "1804", "the stored number moved")

  let grown = j.strAppend("!!", "$.name") catch e {
    panic("strAppend: ${e.message()}")
  }
  assert(showInts(grown) == "5", "Ana! is 5, got ${showInts(grown)}")
  let quoted = j.strAppend("\"q\"", "$.id") catch e {
    panic("strAppend quote: ${e.message()}")
  }
  assert(showInts(quoted) == "5", "a1 plus three characters, got ${showInts(quoted)}")
  assert(jsonAtPath(c, key, "$.id") == "\"a1\\\"q\\\"\"", "the quotes are escaped on the wire")
  let lens = j.strLen("$..title") catch e {
    panic("strLen: ${e.message()}")
  }
  assert(showInts(lens) == "3,3", "two titles, got ${showInts(lens)}")
  let notString = j.strLen("$.rating") catch e {
    panic("strLen number: ${e.message()}")
  }
  assert(showInts(notString) == "-", "a number has no string length")
  jsonClean(c, [key])
  c.close()
}

test "live: the array commands append, insert, find, pop and trim" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:json:arrays"
  jsonClean(c, [key])
  jsonPut(c, key, inkAuthor())
  let j = c.json(key)

  let appended = j.arrAppend("$.tags", JsonValue.JsonString("x"), JsonValue.JsonString("y")) catch e {
    panic("arrAppend: ${e.message()}")
  }
  assert(showInts(appended) == "4", "append gave ${showInts(appended)}")
  let inserted = j.arrInsert("$.tags", 0, JsonValue.JsonString("first")) catch e {
    panic("arrInsert: ${e.message()}")
  }
  assert(showInts(inserted) == "5", "insert gave ${showInts(inserted)}")
  let lens = j.arrLen("$.tags") catch e {
    panic("arrLen: ${e.message()}")
  }
  assert(showInts(lens) == "5", "len gave ${showInts(lens)}")
  let notArray = j.arrLen("$.name") catch e {
    panic("arrLen string: ${e.message()}")
  }
  assert(showInts(notArray) == "-", "a string is not an array")
  let both = j.arrLen("$..tags") catch e {
    panic("arrLen deep: ${e.message()}")
  }
  assert(showInts(both) == "5", "one array matches")

  let at = j.arrIndex("$.tags", JsonValue.JsonString("x")) catch e {
    panic("arrIndex: ${e.message()}")
  }
  assert(showInts(at) == "3", "x sits at 3, got ${showInts(at)}")
  let absent = j.arrIndex("$.tags", JsonValue.JsonString("nope")) catch e {
    panic("arrIndex absent: ${e.message()}")
  }
  assert(showInts(absent) == "-1", "an absent value is -1")
  let past = j.arrIndex("$.tags", JsonValue.JsonString("essays"), 2, 0) catch e {
    panic("arrIndex range: ${e.message()}")
  }
  assert(showInts(past) == "-1", "essays is before the range")
  let inside = j.arrIndex("$.tags", JsonValue.JsonString("essays"), 0, 2) catch e {
    panic("arrIndex inside: ${e.message()}")
  }
  assert(showInts(inside) == "1", "essays is inside 0..2, got ${showInts(inside)}")

  let last = j.arrPop("$.tags") catch e {
    panic("arrPop: ${e.message()}")
  }
  assert(showTrees(last) == "\"y\"", "the last element, got ${showTrees(last)}")
  let first = j.arrPop("$.tags", 0) catch e {
    panic("arrPop first: ${e.message()}")
  }
  assert(showTrees(first) == "\"first\"", "the first element, got ${showTrees(first)}")
  let trimmed = j.arrTrim("$.tags", 0, 1) catch e {
    panic("arrTrim: ${e.message()}")
  }
  assert(showInts(trimmed) == "2", "trim gave ${showInts(trimmed)}")
  assert(
    jsonAtPath(c, key, "$.tags") == "[\"essays\",\"bit\"]",
    "the array is ${jsonAtPath(c, key, "$.tags")}",
  )

  j.set(jtree("[]"), "$.tags") catch e {
    panic("empty array: ${e.message()}")
  }
  let none = j.arrPop("$.tags") catch e {
    panic("arrPop empty: ${e.message()}")
  }
  assert(showTrees(none) == "-", "an empty array pops nothing")
  let nothing = j.arrPop("$.name") catch e {
    panic("arrPop string: ${e.message()}")
  }
  assert(showTrees(nothing) == "-", "a string pops nothing")
  jsonClean(c, [key])
  c.close()
}

test "live: objKeys, objLen and toggle; a missing key is the server's error" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:json:objs"
  jsonClean(c, [key])
  jsonPut(c, key, inkAuthor())
  let j = c.json(key)

  let names = j.objKeys() catch e {
    panic("objKeys: ${e.message()}")
  }
  assert(len(names) == 1, "one object at the root")
  assert(
    commaJoin(unwrap(names[0])) == "id,name,address,tags,drafts,rating,verified,nickname",
    "keys in order",
  )
  let notObject = j.objKeys("$.name") catch e {
    panic("objKeys string: ${e.message()}")
  }
  assert(isNone(notObject[0]), "a string has no keys")
  let sizes = j.objLen("$..address") catch e {
    panic("objLen: ${e.message()}")
  }
  assert(showInts(sizes) == "2", "address has two keys, got ${showInts(sizes)}")
  let root = j.objLen() catch e {
    panic("objLen root: ${e.message()}")
  }
  assert(showInts(root) == "8", "the root has eight keys, got ${showInts(root)}")

  let off = j.toggle("$.verified") catch e {
    panic("toggle: ${e.message()}")
  }
  assert(len(off) == 1 && unwrapOr(off[0], true) == false, "true flips to false")
  let on = j.toggle("$.verified") catch e {
    panic("toggle again: ${e.message()}")
  }
  assert(unwrapOr(on[0], false), "and back to true")
  let notBool = j.toggle("$.name") catch e {
    panic("toggle string: ${e.message()}")
  }
  assert(isNone(notBool[0]), "a string cannot be toggled")

  let missing = c.json("bit:live:json:nokey")
  let failed = false
  let _ = missing.arrLen() catch e {
    failed = contains(e.message(), "key")
    []Option<i64>(0)
  }
  assert(failed, "arrLen on a missing key is the server's error")
  jsonClean(c, [key])
  c.close()
}

test "live: json commands run in a pipeline and a transaction through JsonBatch" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:json:batch"
  jsonClean(c, [key])
  let a = inkAuthor()

  let p = c.pipeline()
  let q = p.json(key)
  let stored = q.set(a.toJson())
  let read = q.get<InkAuthor>()
  let tags = q.arrAppend("$.tags", JsonValue.JsonString("late"))
  let kinds = q.typeOf("$.tags")
  p.exec() catch e {
    panic("pipeline exec: ${e.message()}")
  }
  let ok = stored.get() catch e {
    panic("set future: ${e.message()}")
  }
  assert(ok, "the queued set applied")
  let doc = read.get() catch e {
    panic("get future: ${e.message()}")
  }
  assert(unwrap(doc).name == "Ana", "the queued get saw the queued set")
  let n = tags.get() catch e {
    panic("append future: ${e.message()}")
  }
  assert(showInts(n) == "3", "append gave ${showInts(n)}")
  let t = kinds.get() catch e {
    panic("type future: ${e.message()}")
  }
  assert(commaJoin(t) == "array", "type gave ${commaJoin(t)}")

  let words = c.transaction<Future<[]Option<f64>>>([key], (tx) => {
    tx.json(key).toggle("$.verified")
    return tx.json(key).numIncrBy(10.0, "$.drafts[0].words")
  }) catch e {
    panic("transaction: ${e.message()}")
  }
  let w = words.get() catch e {
    panic("transaction future: ${e.message()}")
  }
  assert(showNums(w) == "910", "incr inside the transaction gave ${showNums(w)}")
  assert(jsonAtPath(c, key, "$.verified") == "false", "the queued toggle committed")
  jsonClean(c, [key])
  c.close()
}

// The module's wrong-type error is `-Existing key has wrong Redis type`, with
// no WRONGTYPE prefix, so it reaches the caller as `RedisError.Server`, not
// `RedisError.WrongType`; the message is what is pinned here.
test "live: a json command on a string key fails with the module's own wrong-type error" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:json:wrongtype"
  jsonClean(c, [key])
  c.set(key, "plain") catch e {
    panic("set: ${e.message()}")
  }
  let wrong = ""
  let _ = c.json(key).get<InkAuthor>() catch e {
    wrong = e.message()
    Option.None
  }
  assert(contains(wrong, "wrong Redis type"), "JSON.GET on a string key fails: ${wrong}")
  jsonClean(c, [key])
  c.close()
}
