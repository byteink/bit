// pkg/redis/strings.live.test.bit — `Client.set`/`get`/`setGet` and `r.str
// (key)` against a real server. `liveUrl`/`liveClient` are `client.live.test
// .bit`'s own (this file is the same module, epic #6013's own convention —
// no import needed); every test is skipped, and says so, when
// `REDIS_TEST_URL` is unset. `./make test-package-redis-live`
// (`_tests_/bit/redislive.bit`) is what actually supplies it, against
// `redis:8.10.2` in a throwaway Docker container.

test "live: SET/GET round-trip a value, a missing key reads as None" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:strings:setget"
  c.del([key]) catch e {
    panic("del: ${e.message()}")
  }

  let wrote = c.set(key, "hello") catch e {
    panic("set: ${e.message()}")
  }
  assert(wrote, "plain set should report true")

  let got = c.get(key) catch e {
    panic("get: ${e.message()}")
  }
  match (got) {
    Some(v) => assert(v == "hello", "get = '${v}'")
    None => panic("get returned no value")
  }

  let missing = c.get("bit:live:strings:nope") catch e {
    panic("get: ${e.message()}")
  }
  assert(isNone(missing), "expected None for a missing key")
  c.close()
}

test "live: SET NX/XX refuse or allow the write, PX attaches a TTL" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:strings:nxxx"
  c.del([key]) catch e {
    panic("del: ${e.message()}")
  }

  let created = c.set(key, "v1", 0, true, false) catch e {
    panic("set NX: ${e.message()}")
  }
  assert(created, "NX on a fresh key should succeed")

  let blocked = c.set(key, "v2", 0, true, false) catch e {
    panic("set NX again: ${e.message()}")
  }
  assert(!blocked, "NX on an existing key should refuse")

  let updated = c.set(key, "v3", 0, false, true) catch e {
    panic("set XX: ${e.message()}")
  }
  assert(updated, "XX on an existing key should succeed")

  c.del(["bit:live:strings:xxmissing"]) catch e {
    panic("del: ${e.message()}")
  }
  let refused = c.set("bit:live:strings:xxmissing", "v", 0, false, true) catch e {
    panic("set XX missing: ${e.message()}")
  }
  assert(!refused, "XX on a missing key should refuse")

  let withTtl = c.set(key, "v4", 30 * Second, false, false) catch e {
    panic("set PX: ${e.message()}")
  }
  assert(withTtl, "set with a TTL should still report true")
  let ttl = c.keys().ttl(key) catch e {
    panic("ttl: ${e.message()}")
  }
  match (ttl) {
    Remaining(ns) => assert(ns > 0 && ns <= 30 * Second, "ttl = ${ns}")
    _ => panic("expected Remaining after a SET with a TTL")
  }
  c.close()
}

test "live: setGet returns the previous value and still applies NX/XX" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:strings:setget2"
  c.del([key]) catch e {
    panic("del: ${e.message()}")
  }

  let first = c.setGet(key, "v1") catch e {
    panic("setGet: ${e.message()}")
  }
  assert(isNone(first), "expected None on the first write")

  let second = c.setGet(key, "v2") catch e {
    panic("setGet: ${e.message()}")
  }
  match (second) {
    Some(v) => assert(v == "v1", "setGet previous value = '${v}'")
    None => panic("expected the previous value 'v1'")
  }

  let stillThere = c.get(key) catch e {
    panic("get: ${e.message()}")
  }
  match (stillThere) {
    Some(v) => assert(v == "v2", "get after setGet = '${v}'")
    None => panic("expected 'v2' after setGet")
  }
  c.close()
}

test "live: GETEX/GETDEL manage TTLs alongside reads" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:strings:getex"
  c.set(key, "v") catch e {
    panic("set: ${e.message()}")
  }
  let s = c.str(key)

  let withTtl = s.getEx(30 * Second) catch e {
    panic("getEx: ${e.message()}")
  }
  match (withTtl) {
    Some(v) => assert(v == "v", "getEx value = '${v}'")
    None => panic("getEx returned no value")
  }
  let ttl = c.keys().ttl(key) catch e {
    panic("ttl: ${e.message()}")
  }
  match (ttl) {
    Remaining(_) => {}
    _ => panic("expected a TTL after getEx(ttl)")
  }

  let persisted = s.getEx(0, true) catch e {
    panic("getEx persist: ${e.message()}")
  }
  assert(isSome(persisted), "getEx(persist) should still return the value")
  let ttlAfter = c.keys().ttl(key) catch e {
    panic("ttl: ${e.message()}")
  }
  match (ttlAfter) {
    NoExpiry => {}
    _ => panic("expected NoExpiry after getEx(persist)")
  }

  let removed = s.getDel() catch e {
    panic("getDel: ${e.message()}")
  }
  match (removed) {
    Some(v) => assert(v == "v", "getDel value = '${v}'")
    None => panic("getDel returned no value")
  }
  let gone = c.get(key) catch e {
    panic("get: ${e.message()}")
  }
  assert(isNone(gone), "expected the key to be gone after getDel")
  c.close()
}

test "live: APPEND/STRLEN/GETRANGE/SETRANGE operate on a string's bytes" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:strings:bytes"
  c.del([key]) catch e {
    panic("del: ${e.message()}")
  }
  let s = c.str(key)

  let len1 = s.append("Hello") catch e {
    panic("append: ${e.message()}")
  }
  assert(len1 == 5, "append('Hello') length = ${len1}")
  let len2 = s.append(" World") catch e {
    panic("append: ${e.message()}")
  }
  assert(len2 == 11, "append(' World') length = ${len2}")

  let strLen = s.strLen() catch e {
    panic("strLen: ${e.message()}")
  }
  assert(strLen == 11, "strLen = ${strLen}")

  let sub = s.getRange(0, 4) catch e {
    panic("getRange: ${e.message()}")
  }
  assert(sub == "Hello", "getRange(0,4) = '${sub}'")

  let newLen = s.setRange(6, "Redis") catch e {
    panic("setRange: ${e.message()}")
  }
  assert(newLen == 11, "setRange length = ${newLen}")
  let after = s.getRange(0, -1) catch e {
    panic("getRange: ${e.message()}")
  }
  assert(after == "Hello Redis", "after setRange = '${after}'")
  c.close()
}

test "live: LCS finds the longest common subsequence between two keys" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let k1 = "bit:live:strings:lcs1"
  let k2 = "bit:live:strings:lcs2"
  c.set(k1, "ohmytext") catch e {
    panic("set: ${e.message()}")
  }
  c.set(k2, "mynewtext") catch e {
    panic("set: ${e.message()}")
  }

  let matched = c.str(k1).lcs(k2) catch e {
    panic("lcs: ${e.message()}")
  }
  assert(matched == "mytext", "lcs = '${matched}'")

  let matchedLen = c.str(k1).lcsLen(k2) catch e {
    panic("lcsLen: ${e.message()}")
  }
  assert(matchedLen == 6, "lcsLen = ${matchedLen}")
  c.close()
}

test "live: a pipeline and a transaction can both queue string commands" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:strings:queued"
  c.del([key]) catch e {
    panic("del: ${e.message()}")
  }

  let p = c.pipeline()
  let setFuture = p.str(key).append("ab")
  let strLenFuture = p.str(key).strLen()
  p.exec() catch e {
    panic("pipeline exec: ${e.message()}")
  }
  let setLen = setFuture.get() catch e {
    panic("setFuture.get: ${e.message()}")
  }
  assert(setLen == 2, "pipelined append length = ${setLen}")
  let strLen = strLenFuture.get() catch e {
    panic("strLenFuture.get: ${e.message()}")
  }
  assert(strLen == 2, "pipelined strLen = ${strLen}")
  c.close()
}

test "live: tx.read.str reads the value before the queued write runs, and refuses a write" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:strings:txread"
  c.set(key, "hello") catch e {
    panic("set: ${e.message()}")
  }
  let out = c.transaction<Future<i64>>([key], (tx) => {
    let queued = tx.str(key).append(" world")
    let s = tx.read.str(key)
    let before = s.getRange(0, -1)?
    assert(before == "hello", "getRange saw '${before}', not the pre-EXEC 'hello'")
    let size = s.strLen()?
    assert(size == 5, "strLen = ${size}: the queued append has not run")
    let refused = false
    let _ = s.append("!") catch _ {
      refused = true
      0
    }
    assert(refused, "a write through tx.read is refused")
    return queued
  }) catch e {
    panic("transaction: ${e.message()}")
  }
  let appended = out.get() catch e {
    panic("future: ${e.message()}")
  }
  assert(appended == 11, "the queued append committed, length ${appended}")
  let after = c.str(key).getRange(0, -1) catch e {
    panic("getRange after: ${e.message()}")
  }
  assert(after == "hello world", "after EXEC '${after}': the refused '!' never landed")
  c.del([key]) catch e {
    panic("del: ${e.message()}")
  }
  c.close()
}
