// pkg/redis/searchfind.bit - `FT.SEARCH`'s options and arguments, and the
// typed result. Epic #6013, #6044. The query itself is `searchquery.bit`'s
// `Query`; the reply is decoded in `searchcmd.bit`.
//
// THE ORDER IS THE DOCS'. `FT.SEARCH index query [NOCONTENT] [VERBATIM]
// [NOSTOPWORDS] [WITHSCORES] [WITHPAYLOADS] [WITHSORTKEYS] [FILTER ..]
// [GEOFILTER ..] [INKEYS ..] [INFIELDS ..] [RETURN ..] [SUMMARIZE ..]
// [HIGHLIGHT ..] [SLOP n] [TIMEOUT ms] [INORDER] [LANGUAGE l] [EXPANDER e]
// [SCORER s] [EXPLAINSCORE] [PAYLOAD p] [SORTBY f [ASC|DESC] [WITHCOUNT]]
// [LIMIT offset num] [PARAMS n ..] [DIALECT d]`.

// `FILTER field min max`: a numeric field in `[min, max]`.
export class NumFilter {
  export field: string,
  export min: f64,
  export max: f64,
}

// `GEOFILTER field lon lat radius unit`.
export class GeoFilter {
  export field: string,
  export lon: f64,
  export lat: f64,
  export radius: f64,
  export unit: GeoUnit = GeoUnit.Kilometers,
}

// `RETURN`: a field to return, `alias` (`AS`) the name it comes back under.
export class Returned {
  export field: string,
  export alias: string = "",
}

// `SUMMARIZE`: fragments of the matching text instead of all of it. `fields`
// limits it to those fields (all text fields when empty); `frags` is how many
// fragments, `len` their length in words, `separator` what goes between.
export class Summarize {
  export fields: []string = []string(0),
  export frags: Option<i64> = Option.None,
  export len: Option<i64> = Option.None,
  export separator: Option<string> = Option.None,
}

// `HIGHLIGHT`: the matched words wrapped in `open` and `close` (`<b>`/`</b>`
// when both are empty).
export class Highlight {
  export fields: []string = []string(0),
  export open: string = "",
  export close: string = "",
}

// `SORTBY`: a sortable field, `desc` for descending; `withCount` makes the
// total count every match, not only the first page's.
export class SortBy {
  export field: string,
  export desc: bool = false,
  export withCount: bool = false,
}

// `LIMIT offset num`: the page of results (the server's default is 0, 10).
export class Page {
  export offset: i64,
  export num: i64,
}

// `FT.SEARCH`'s optional arguments; unset leaves the server's default.
// `noContent` returns ids only; `verbatim` turns off stemming; `noStopwords`
// turns off the stopword list; `withScores`/`withPayloads`/`withSortKeys`
// fill `Hit.score`/`payload`/`sortKey`; `inKeys`/`inFields` restrict the
// search; `returns` picks fields; `slop`/`inOrder` constrain phrase matches;
// `timeout` is in milliseconds; `explainScore` fills `Hit.scoreExplain`
// (needs `withScores`); `params` adds `$name` values (name, value) to the ones the query
// carries; `dialect` defaults to 2 for a query that carries params.
export class SearchOptions {
  export noContent: bool = false,
  export verbatim: bool = false,
  export noStopwords: bool = false,
  export withScores: bool = false,
  export withPayloads: bool = false,
  export withSortKeys: bool = false,
  export numeric: []NumFilter = []NumFilter(0),
  export geo: []GeoFilter = []GeoFilter(0),
  export inKeys: []string = []string(0),
  export inFields: []string = []string(0),
  export returns: []Returned = []Returned(0),
  export summarize: Option<Summarize> = Option.None,
  export highlight: Option<Highlight> = Option.None,
  export slop: Option<i64> = Option.None,
  export timeout: Option<i64> = Option.None,
  export inOrder: bool = false,
  export language: Option<string> = Option.None,
  export expander: Option<string> = Option.None,
  export scorer: Option<string> = Option.None,
  export explainScore: bool = false,
  export payload: Option<string> = Option.None,
  export sortBy: Option<SortBy> = Option.None,
  export page: Option<Page> = Option.None,
  export params: []Field = []Field(0),
  export dialect: Option<i64> = Option.None,
}

// One matching document: its key, and the fields the server returned. For an
// `ON JSON` index without `returns` the document is the single field `$`.
export class Hit {
  export id: string
  export score: Option<f64> = Option.None
  export scoreExplain: Option<string> = Option.None
  export payload: Option<string> = Option.None
  export sortKey: Option<string> = Option.None
  export fields: []Field = []Field(0)

  // The field `name`; `None` when it was not returned.
  export field(name: string): Option<string> {
    for f of this.fields {
      if (f.name == name) {
        return Option.Some(f.value)
      }
    }
    return Option.None
  }
  // The JSON document of an `ON JSON` hit as a `T` (a `@json` class): the `$`
  // field, or the one field `name` when a `returns` picked a sub-document.
  export doc<T>(name: string = "$"): T!RedisError {
    match (this.field(name)) {
      Some(text) => return jsonInto<T>(jsonTree(text, "FT.SEARCH")?, "FT.SEARCH")?
      None => fail RedisError.Unexpected("FT.SEARCH", "hit ${this.id} has no ${name} field")
    }
  }
}

// `FT.SEARCH`'s answer: how many documents match in all (not only this page)
// and this page's hits, best first.
export class SearchResult {
  export total: i64,
  export hits: []Hit,
}

fn numFilterArgs(fs: []NumFilter): []string {
  let args = []string(0)
  for f of fs {
    args = append(args, "FILTER", f.field, "${f.min}", "${f.max}")
  }
  return args
}

fn geoFilterArgs(fs: []GeoFilter): []string {
  let args = []string(0)
  for f of fs {
    args = append(args, "GEOFILTER", f.field, "${f.lon}", "${f.lat}", "${f.radius}", f.unit.text())
  }
  return args
}

fn countedArgs2(name: string, values: []string): []string {
  if (len(values) == 0) {
    return []string(0)
  }
  return append([name, "${len(values)}"], ...values)
}

fn returnArgs(rs: []Returned): []string {
  if (len(rs) == 0) {
    return []string(0)
  }
  let n = 0
  let tail = []string(0)
  for r of rs {
    tail = append(tail, r.field)
    n = n + 1
    if (r.alias != "") {
      tail = append(tail, "AS", r.alias)
      n = n + 2
    }
  }
  return append(["RETURN", "${n}"], ...tail)
}

fn summarizeArgs(s: Option<Summarize>): []string {
  match (s) {
    None => return []string(0)
    Some(v) => {
      let args = append(["SUMMARIZE"], ...countedArgs2("FIELDS", v.fields))
      args = append(args, ...optInt("FRAGS", v.frags))
      args = append(args, ...optInt("LEN", v.len))
      return append(args, ...tokensOpt("SEPARATOR", v.separator))
    }
  }
}

fn highlightArgs(h: Option<Highlight>): []string {
  match (h) {
    None => return []string(0)
    Some(v) => {
      let args = append(["HIGHLIGHT"], ...countedArgs2("FIELDS", v.fields))
      if (v.open != "" || v.close != "") {
        args = append(args, "TAGS", v.open, v.close)
      }
      return args
    }
  }
}

fn sortArgsOf(s: Option<SortBy>): []string {
  match (s) {
    None => return []string(0)
    Some(v) => {
      let args = ["SORTBY", v.field]
      if (v.desc) {
        args = append(args, "DESC")
      }
      return append(args, ...flagIf(v.withCount, "WITHCOUNT"))
    }
  }
}

fn pageArgs(p: Option<Page>): []string {
  match (p) {
    None => return []string(0)
    Some(v) => return ["LIMIT", "${v.offset}", "${v.num}"]
  }
}

// `PARAMS n name value ..`: the query's own, then the options'. A name given
// in both is the options' (the later one wins on the server).
fn paramArgs(q: Query, extra: []Field): []string {
  let flat = q.params
  for f of extra {
    flat = append(flat, f.name, f.value)
  }
  if (len(flat) == 0) {
    return []string(0)
  }
  return append(["PARAMS", "${len(flat)}"], ...flat)
}

fn dialectArgs(q: Query, extra: []Field, d: Option<i64>): []string {
  match (d) {
    Some(n) => return ["DIALECT", "${n}"]
    None => {
      if (len(q.params) > 0 || len(extra) > 0) {
        return ["DIALECT", "2"]
      }
      return []string(0)
    }
  }
}

fn searchFlags(o: SearchOptions): []string {
  let args = flagIf(o.noContent, "NOCONTENT")
  args = append(args, ...flagIf(o.verbatim, "VERBATIM"))
  args = append(args, ...flagIf(o.noStopwords, "NOSTOPWORDS"))
  args = append(args, ...flagIf(o.withScores, "WITHSCORES"))
  args = append(args, ...flagIf(o.withPayloads, "WITHPAYLOADS"))
  return append(args, ...flagIf(o.withSortKeys, "WITHSORTKEYS"))
}

fn searchScope(o: SearchOptions): []string {
  let args = numFilterArgs(o.numeric)
  args = append(args, ...geoFilterArgs(o.geo))
  args = append(args, ...countedArgs2("INKEYS", o.inKeys))
  args = append(args, ...countedArgs2("INFIELDS", o.inFields))
  args = append(args, ...returnArgs(o.returns))
  args = append(args, ...summarizeArgs(o.summarize))
  return append(args, ...highlightArgs(o.highlight))
}

fn searchTuning(o: SearchOptions): []string {
  let args = optInt("SLOP", o.slop)
  args = append(args, ...optInt("TIMEOUT", o.timeout))
  args = append(args, ...flagIf(o.inOrder, "INORDER"))
  args = append(args, ...tokensOpt("LANGUAGE", o.language))
  args = append(args, ...tokensOpt("EXPANDER", o.expander))
  args = append(args, ...tokensOpt("SCORER", o.scorer))
  args = append(args, ...flagIf(o.explainScore, "EXPLAINSCORE"))
  return append(args, ...tokensOpt("PAYLOAD", o.payload))
}

fn searchArgs(index: string, q: Query, o: SearchOptions): []string {
  let args = append(["FT.SEARCH", index, q.expr], ...searchFlags(o))
  args = append(args, ...searchScope(o))
  args = append(args, ...searchTuning(o))
  args = append(args, ...sortArgsOf(o.sortBy))
  args = append(args, ...pageArgs(o.page))
  args = append(args, ...paramArgs(q, o.params))
  return append(args, ...dialectArgs(q, o.params, o.dialect))
}
