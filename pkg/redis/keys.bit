// pkg/redis/keys.bit — `r.keys()`: the key-management handle (`SCAN`,
// `TTL`, `TYPE`, `RENAME`, ...) — a namespace, not a per-key handle like
// `hash.bit`/`zset.bit`/..., since `SCAN` iterates the whole keyspace
// rather than operating on one key. Epic #6013, #6028: SCAFFOLD ONLY, no
// commands wired yet — a follow-up ticket adds `scan(pattern): Keys`'s
// `next(): Option<string>` iterator (#6014 probe d) plus `ttl`/`type`/
// `rename`, each taking its own key argument. `cmd.bit`'s header is the
// template.
export class Keys {
  client: Client,
}
