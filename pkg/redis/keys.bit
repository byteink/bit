// pkg/redis/keys.bit — `r.keys()`: the key-management handle (`SCAN`,
// `TTL`, `TYPE`, `RENAME`, ...) — a namespace, not a per-key handle like
// `hash.bit`/`zset.bit`/`strings.bit`, since most of what it wraps (`SCAN`,
// `MGET`, `MSET`) has no single "primary" key. Epic #6013, #6028, #6034.
//
// `DEL`/`EXISTS`/`EXPIRE` ARE NOT REPEATED HERE — they already exist as flat
// `Client` methods (`client.bit`, #6022/#6028), and this ticket's own scope
// keeps `client.bit` closed to everything except `set`/`get`. This file adds
// what is genuinely new: `UNLINK`/`TOUCH` (no flat equivalent at all), the
// fuller `EXPIRE`/`PEXPIRE`/`EXPIREAT`/`PEXPIREAT` family with the `NX`/
// `XX`/`GT`/`LT` condition flags `Client.expire` has no room for, `TTL`/
// `PTTL`/`PERSIST`, `TYPE`, `RENAME`/`RENAMENX`/`COPY`, `RANDOMKEY`,
// `OBJECT ENCODING`, and `SCAN` itself.
//
// `MGET`/`MSET`/`MSETNX` LIVE HERE, NOT ON `strings.bit` — `strings.bit`'s
// own header explains why: they have no single key to bind a `Str` handle
// to, and `Keys` is already this package's "no bound key" handle.
//
// CONDITION FLAGS (`when` ON THE EXPIRE FAMILY) ARE A PLAIN `string = ""`,
// NOT AN ENUM — the same reasoning `hash.bit`'s own `when` parameter
// documents: a parameter default must be a bare literal (SPEC §10.3), and an
// enum variant constructor is not one (#6112, still open). An empty string
// omits the flag; the server rejects an unrecognised one with a normal
// `RedisError`.
//
// `Ttl`/`KeyType` ARE ENUMS, NOT SENTINEL INTEGERS OR BARE STRINGS — unlike
// `hash.bit`'s field-level `HTTL`/`HPTTL` (which pass Redis's own `-1`/`-2`
// sentinels straight through, since those methods already return `[]i64`
// for every field at once and a per-element enum would need its own
// wrapper type), `TTL`/`PTTL` here return exactly one result, so distinguishing
// "no such key" from "no expiry" from "N left" as three enum variants (in
// nanoseconds either way, `std/time`'s own unit) reads better at the call
// site than a caller re-deriving the same two sentinels this file already
// knows how to name.
//
// `Keys` HOLDS `runner: Runner` (`cmd.bit`'s HOW-TO header, #6029):
// `r.keys()` runs over the pool, `tx.read.keys()` over a transaction
// attempt's own pinned connection (`tx.bit`'s header), where the read
// commands (`ttl`, `pttl`, `keyType`, `randomKey`, `objectEncoding`,
// `getMany`, `scan`) see the keys the transaction `WATCH`es. A write there
// (`unlink`, `expire`, `rename`, `mset`, ...) is refused (`runPinnedCmd`,
// `cmd.bit`): queue it with `tx.keys()`.

export enum Ttl {
  NoKey,
  NoExpiry,
  Remaining(int),
}

export enum KeyType {
  KeyNone,
  KeyString,
  KeyList,
  KeySet,
  KeyZset,
  KeyHash,
  KeyStream,
}

export class Keys {
  runner: Runner

  export unlink(...keys: string): i64!RedisError {
    return this.runner.runCmd(unlinkCmd(keys))?
  }
  export touch(...keys: string): i64!RedisError {
    return this.runner.runCmd(touchCmd(keys))?
  }
  export expire(key: string, ttl: int, when: string = ""): bool!RedisError {
    return this.runner.runCmd(keysExpireCmd(key, ttl, when))?
  }
  export pexpire(key: string, ttl: int, when: string = ""): bool!RedisError {
    return this.runner.runCmd(keysPexpireCmd(key, ttl, when))?
  }
  // `at` is nanoseconds since the Unix epoch (`std/time.now().ns`), not a
  // relative TTL — `EXPIREAT` wants an absolute unix-time-seconds.
  export expireAt(key: string, at: int, when: string = ""): bool!RedisError {
    return this.runner.runCmd(keysExpireAtCmd(key, at, when))?
  }
  export pexpireAt(key: string, at: int, when: string = ""): bool!RedisError {
    return this.runner.runCmd(keysPexpireAtCmd(key, at, when))?
  }
  export ttl(key: string): Ttl!RedisError {
    return this.runner.runCmd(ttlCmd(key))?
  }
  export pttl(key: string): Ttl!RedisError {
    return this.runner.runCmd(pttlCmd(key))?
  }
  export persist(key: string): bool!RedisError {
    return this.runner.runCmd(persistCmd(key))?
  }
  export keyType(key: string): KeyType!RedisError {
    return this.runner.runCmd(typeCmd(key))?
  }
  export rename(src: string, dst: string): ()!RedisError {
    return this.runner.runCmd(renameCmd(src, dst))?
  }
  export renameNx(src: string, dst: string): bool!RedisError {
    return this.runner.runCmd(renameNxCmd(src, dst))?
  }
  // `db` HAS NO DEFAULT: SPEC §10.3 restricts a parameter default to a
  // literal token, and `-1` (this method's own "no `DB` clause, same
  // database as the source key" sentinel) parses as a unary-minus
  // expression, not one — E0159 (#6112, still open, names this exact gap: a
  // negative-literal default). A caller who does not care passes `-1`
  // explicitly, the same way `zset.bit`'s `union`/`inter` already require an
  // explicit `[]f64(0)`/`Aggregate.Sum` for the identical reason.
  export copy(src: string, dst: string, replace: bool, db: i64): bool!RedisError {
    return this.runner.runCmd(copyCmd(src, dst, replace, db))?
  }
  export randomKey(): Option<string>!RedisError {
    return this.runner.runCmd(randomKeyCmd())?
  }
  export objectEncoding(key: string): string!RedisError {
    return this.runner.runCmd(objectEncodingCmd(key))?
  }
  export getMany(...keys: string): []Option<string>!RedisError {
    return this.runner.runCmd(mgetCmd(keys))?
  }
  export mset(fields: map<string, string>): ()!RedisError {
    return this.runner.runCmd(msetCmd(fields))?
  }
  export msetNx(fields: map<string, string>): bool!RedisError {
    return this.runner.runCmd(msetNxCmd(fields))?
  }
  // Lazily follows `SCAN`'s cursor — see `KeysScanIterator` below. No
  // queued counterpart: a cursor is several round trips, and `Batch.queue`
  // hands back exactly one `Future<T>` per queued command (`hash.bit`'s
  // identical note for `HSCAN`).
  export scan(pattern: string = "", count: int = 0, keyType: string = ""): KeysScanIterator {
    return KeysScanIterator{
      runner = this.runner,
      pattern = pattern,
      count = count,
      keyType = keyType,
      cursor = "0",
      page = []string(0),
      started = false,
    }
  }
}

// The queued view `Pipeline.keys`/`Tx.keys` both return — `cmd.bit`'s
// `Batch` is the ONE client-side queue the two executors share, so this is
// the ONLY queued view `Keys` needs. Every method mirrors `Keys`'s own,
// except `scan` (this file's own note above).
export class KeysBatch {
  batch: Batch

  export unlink(...keys: string): Future<i64> { return this.batch.queue(unlinkCmd(keys)) }
  export touch(...keys: string): Future<i64> { return this.batch.queue(touchCmd(keys)) }
  export expire(key: string, ttl: int, when: string = ""): Future<bool> {
    return this.batch.queue(keysExpireCmd(key, ttl, when))
  }
  export pexpire(key: string, ttl: int, when: string = ""): Future<bool> {
    return this.batch.queue(keysPexpireCmd(key, ttl, when))
  }
  export expireAt(key: string, at: int, when: string = ""): Future<bool> {
    return this.batch.queue(keysExpireAtCmd(key, at, when))
  }
  export pexpireAt(key: string, at: int, when: string = ""): Future<bool> {
    return this.batch.queue(keysPexpireAtCmd(key, at, when))
  }
  export ttl(key: string): Future<Ttl> { return this.batch.queue(ttlCmd(key)) }
  export pttl(key: string): Future<Ttl> { return this.batch.queue(pttlCmd(key)) }
  export persist(key: string): Future<bool> { return this.batch.queue(persistCmd(key)) }
  export keyType(key: string): Future<KeyType> { return this.batch.queue(typeCmd(key)) }
  export rename(src: string, dst: string): Future<()> {
    return this.batch.queue(renameCmd(src, dst))
  }
  export renameNx(src: string, dst: string): Future<bool> {
    return this.batch.queue(renameNxCmd(src, dst))
  }
  export copy(src: string, dst: string, replace: bool, db: i64): Future<bool> {
    return this.batch.queue(copyCmd(src, dst, replace, db))
  }
  export randomKey(): Future<Option<string>> { return this.batch.queue(randomKeyCmd()) }
  export objectEncoding(key: string): Future<string> {
    return this.batch.queue(objectEncodingCmd(key))
  }
  export getMany(...keys: string): Future<[]Option<string>> {
    return this.batch.queue(mgetCmd(keys))
  }
  export mset(fields: map<string, string>): Future<()> { return this.batch.queue(msetCmd(fields)) }
  export msetNx(fields: map<string, string>): Future<bool> {
    return this.batch.queue(msetNxCmd(fields))
  }
}

fn unlinkCmd(keys: []string): Cmd<i64> {
  return Cmd<i64>{
    args = withKeys("UNLINK", keys),
    decode = (r) => asInt(r, "UNLINK"),
    readOnly = false,
  }
}

fn touchCmd(keys: []string): Cmd<i64> {
  return Cmd<i64>{
    args = withKeys("TOUCH", keys),
    decode = (r) => asInt(r, "TOUCH"),
    readOnly = true,
  }
}

fn appendWhen(args: []string, when: string): []string {
  if (when != "") {
    args = append(args, when)
  }
  return args
}

fn keysExpireCmd(key: string, ttl: int, when: string): Cmd<bool> {
  let args = appendWhen(["EXPIRE", key, "${ttl / Second}"], when)
  return Cmd<bool>{ args = args, decode = (r) => asBool(r, "EXPIRE"), readOnly = false }
}

fn keysPexpireCmd(key: string, ttl: int, when: string): Cmd<bool> {
  let args = appendWhen(["PEXPIRE", key, "${ttl / Millisecond}"], when)
  return Cmd<bool>{ args = args, decode = (r) => asBool(r, "PEXPIRE"), readOnly = false }
}

fn keysExpireAtCmd(key: string, at: int, when: string): Cmd<bool> {
  let args = appendWhen(["EXPIREAT", key, "${at / Second}"], when)
  return Cmd<bool>{ args = args, decode = (r) => asBool(r, "EXPIREAT"), readOnly = false }
}

fn keysPexpireAtCmd(key: string, at: int, when: string): Cmd<bool> {
  let args = appendWhen(["PEXPIREAT", key, "${at / Millisecond}"], when)
  return Cmd<bool>{ args = args, decode = (r) => asBool(r, "PEXPIREAT"), readOnly = false }
}

fn ttlFromSentinel(n: i64, unit: int): Ttl {
  if (n == -2) {
    return Ttl.NoKey
  }
  if (n == -1) {
    return Ttl.NoExpiry
  }
  return Ttl.Remaining(int(n) * unit)
}

fn ttlCmd(key: string): Cmd<Ttl> {
  return Cmd<Ttl>{
    args = ["TTL", key],
    decode = (r) => ttlFromReply(r, "TTL", Second),
    readOnly = true,
  }
}

fn pttlCmd(key: string): Cmd<Ttl> {
  return Cmd<Ttl>{
    args = ["PTTL", key],
    decode = (r) => ttlFromReply(r, "PTTL", Millisecond),
    readOnly = true,
  }
}

fn ttlFromReply(r: Reply, cmd: string, unit: int): Ttl!RedisError {
  let n = asInt(r, cmd)?
  return ttlFromSentinel(n, unit)
}

fn persistCmd(key: string): Cmd<bool> {
  return Cmd<bool>{
    args = ["PERSIST", key],
    decode = (r) => asBool(r, "PERSIST"),
    readOnly = false,
  }
}

fn keyTypeFromName(s: string, cmd: string): KeyType!RedisError {
  switch (s) {
    case "none":
      return KeyType.KeyNone
    case "string":
      return KeyType.KeyString
    case "list":
      return KeyType.KeyList
    case "set":
      return KeyType.KeySet
    case "zset":
      return KeyType.KeyZset
    case "hash":
      return KeyType.KeyHash
    case "stream":
      return KeyType.KeyStream
    default:
      fail RedisError.Unexpected(cmd, "Simple")
  }
}

fn asKeyType(r: Reply, cmd: string): KeyType!RedisError {
  let s = replyToString(r, cmd)?
  return keyTypeFromName(s, cmd)?
}

fn typeCmd(key: string): Cmd<KeyType> {
  return Cmd<KeyType>{ args = ["TYPE", key], decode = (r) => asKeyType(r, "TYPE"), readOnly = true }
}

fn renameCmd(src: string, dst: string): Cmd<()> {
  return Cmd<()>{
    args = ["RENAME", src, dst],
    decode = (r) => asOk(r, "RENAME"),
    readOnly = false,
  }
}

fn renameNxCmd(src: string, dst: string): Cmd<bool> {
  return Cmd<bool>{
    args = ["RENAMENX", src, dst],
    decode = (r) => asBool(r, "RENAMENX"),
    readOnly = false,
  }
}

fn copyArgs(src: string, dst: string, replace: bool, db: i64): []string {
  let args = ["COPY", src, dst]
  if (db >= 0) {
    args = append(args, "DB", "${db}")
  }
  if (replace) {
    args = append(args, "REPLACE")
  }
  return args
}

fn copyCmd(src: string, dst: string, replace: bool, db: i64): Cmd<bool> {
  return Cmd<bool>{
    args = copyArgs(src, dst, replace, db),
    decode = (r) => asBool(r, "COPY"),
    readOnly = false,
  }
}

fn randomKeyCmd(): Cmd<Option<string>> {
  return Cmd<Option<string>>{
    args = ["RANDOMKEY"],
    decode = (r) => asOptString(r, "RANDOMKEY"),
    readOnly = true,
  }
}

fn objectEncodingCmd(key: string): Cmd<string> {
  return Cmd<string>{
    args = ["OBJECT", "ENCODING", key],
    decode = (r) => replyToString(r, "OBJECT ENCODING"),
    readOnly = true,
  }
}

fn mgetCmd(keys: []string): Cmd<[]Option<string>> {
  return Cmd<[]Option<string>>{
    args = withKeys("MGET", keys),
    decode = (r) => asOptStrings(r, "MGET"),
    readOnly = true,
  }
}

fn msetArgs(cmd: string, fields: map<string, string>): []string {
  let args = [cmd]
  for (key, value) of fields {
    args = append(args, key)
    args = append(args, value)
  }
  return args
}

fn msetCmd(fields: map<string, string>): Cmd<()> {
  return Cmd<()>{
    args = msetArgs("MSET", fields),
    decode = (r) => asOk(r, "MSET"),
    readOnly = false,
  }
}

fn msetNxCmd(fields: map<string, string>): Cmd<bool> {
  return Cmd<bool>{
    args = msetArgs("MSETNX", fields),
    decode = (r) => asBool(r, "MSETNX"),
    readOnly = false,
  }
}

fn keysScanArgs(cursor: string, pattern: string, count: int, keyType: string): []string {
  let args = ["SCAN", cursor]
  if (pattern != "") {
    args = append(args, "MATCH", pattern)
  }
  if (count > 0) {
    args = append(args, "COUNT", "${count}")
  }
  if (keyType != "") {
    args = append(args, "TYPE", keyType)
  }
  return args
}

fn keysScanCmd(
  cursor: string,
  pattern: string,
  count: int,
  keyType: string,
): Cmd<(string, []string)> {
  return Cmd<(string, []string)>{
    args = keysScanArgs(cursor, pattern, count, keyType),
    decode = (r) => asScanPage(r, "SCAN"),
    readOnly = true,
  }
}

// `r.keys().scan()`'s lazy cursor - the fallible iterator shape,
// `next(): Option<string>!` (docs/development/iterator-trait.md): a page
// fetch that fails comes back as the error, so the loop is written
// `for key of it?`.
export class KeysScanIterator {
  runner: Runner
  pattern: string
  count: int
  keyType: string
  cursor: string
  page: []string
  started: bool

  export next(): Option<string>! {
    while (len(this.page) == 0 && (!this.started || this.cursor != "0")) {
      this.fetch()?
    }
    if (len(this.page) == 0) {
      return Option.None
    }
    let key = this.page[0]
    this.page = this.page[1:len(this.page)]
    return Option.Some(key)
  }

  fetch(): ()!RedisError {
    this.started = true
    let (cursor, keys) = this.runner.runCmd(
      keysScanCmd(this.cursor, this.pattern, this.count, this.keyType),
    )?
    this.cursor = cursor
    this.page = keys
  }
}
