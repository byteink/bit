// pkg/redis/array.bit — `r.array(key)`: the array handle. Epic
// #6013, #6028: SCAFFOLD ONLY, no commands wired yet (`ARSET, ARGET, ARAPPEND (Redis 8.8's array type)`, a
// follow-up ticket) — this file exists so later family tickets touch only
// their own file, never `client.bit`. `cmd.bit`'s header is the template:
// one `Cmd<T>` factory per command, called from a method here.
export class Arr {
  client: Client,
  key: string,
}

// The queued view `Pipeline.array`/`Tx.array` both return — `cmd.bit`'s
// `Batch` is the ONE client-side queue the two executors share, so this
// is the ONLY queued view Arr needs (`cmd.bit`'s header, point 2).
export class ArrBatch {
  batch: Batch,
  key: string,
}
