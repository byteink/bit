// Exact schema tokens keep typed options compatible with Redis field ordering.

test "typed schema options: NUMERIC default options preserve the base schema" {
  let base = schema().text("title")
  let full = base.numeric("words")
  assertArgs(base.args(), ["title", "TEXT"])
  assertArgs(full.args(), ["title", "TEXT", "words", "NUMERIC"])
  assert(base.size() == 1, "base schema stays unchanged")
  assert(full.size() == 2, "numeric field extends the schema")
}

test "typed schema options: NUMERIC all options emit exact ordered tokens" {
  assertArgs(
    schema().numeric(
      "$.words",
      NumericOptions{ alias = "words", indexMissing = true, sortable = true, noIndex = true },
    ).args(),
    ["$.words", "AS", "words", "NUMERIC", "INDEXMISSING", "SORTABLE", "NOINDEX"],
  )
}

test "typed schema options: GEO default options emit exact tokens" {
  assertArgs(schema().geo("origin").args(), ["origin", "GEO"])
}

test "typed schema options: GEO all options emit exact ordered tokens" {
  assertArgs(
    schema().geo(
      "$.origin",
      GeoOptions{ alias = "origin", indexMissing = true, sortable = true, noIndex = true },
    ).args(),
    ["$.origin", "AS", "origin", "GEO", "INDEXMISSING", "SORTABLE", "NOINDEX"],
  )
}

test "typed schema options: GEOSHAPE default options emit spherical coordinates" {
  assertArgs(schema().geoShape("area").args(), ["area", "GEOSHAPE", "SPHERICAL"])
}

test "typed schema options: GEOSHAPE all options emit exact ordered tokens" {
  assertArgs(
    schema().geoShape(
      "$.area",
      GeoShapeOptions{ alias = "area", coords = Coords.Flat, indexMissing = true },
    ).args(),
    ["$.area", "AS", "area", "GEOSHAPE", "FLAT", "INDEXMISSING"],
  )
}
