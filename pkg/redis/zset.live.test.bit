// pkg/redis/zset.live.test.bit — the acceptance that needs a real server
// (#6033, epic #6013). Same model as `client.live.test.bit`'s own header:
// EACH TEST IS SKIPPED WHEN `REDIS_TEST_URL` IS UNSET, and says so —
// `liveUrl`/`liveClient` are that file's own helpers, module-visible here
// with no import (same module, `cmd.bit`'s header, point 2 convention).
// `./make test-package-redis-live` (`_tests_/bit/redislive.bit`) supplies
// the URL by provisioning a throwaway Docker container.

import { monotonic, since, sleep } from "std/time"

fn delKey(c: Client, key: string) {
  c.del([key]) catch e {
    panic("del ${key}: ${e.message()}")
  }
}

test "live: add, addIf, addMany, score, scores, card and top/bottom" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:zset:board"
  delKey(c, key)
  let board = c.zset(key)

  board.add("ada", 42.0) catch e {
    panic("add: ${e.message()}")
  }
  board.addIf("ada", 1.0, ZaddOptions{ onlyIfHigher = true }) catch e {
    panic("addIf onlyIfHigher: ${e.message()}")
  }
  let n = board.addMany(
    Scored{ member = "bob", score = 30.0 },
    Scored{ member = "cy", score = 55.0 },
  ) catch e {
    panic("addMany: ${e.message()}")
  }
  assert(n == 2, "addMany should report 2 new members, got ${n}")

  let adaScore = board.score("ada") catch e {
    panic("score: ${e.message()}")
  }
  match (adaScore) {
    Some(s) => assert(s == 42.0, "ada's score should still be 42.0 (GT refused 1.0), got ${s}")
    None => panic("score('ada') returned no value")
  }

  let scores = board.scores("ada", "nobody") catch e {
    panic("scores: ${e.message()}")
  }
  assert(len(scores) == 2, "scores should return one entry per member, got ${len(scores)}")
  assert(isSome(scores[0]) && unwrap(scores[0]) == 42.0, "scores[0] = ${unwrap(scores[0])}")
  assert(isNone(scores[1]), "scores('nobody') should be None")

  let card = board.card() catch e {
    panic("card: ${e.message()}")
  }
  assert(card == 3, "card should be 3 (ada, bob, cy), got ${card}")

  let top2 = board.top(2) catch e {
    panic("top: ${e.message()}")
  }
  assert(len(top2) == 2, "top(2) should return 2 members, got ${len(top2)}")
  assert(
    top2[0].member == "cy" && top2[1].member == "ada",
    "top(2) order: ${top2[0].member}, ${top2[1].member}",
  )

  let bottom1 = board.bottom(1) catch e {
    panic("bottom: ${e.message()}")
  }
  assert(len(bottom1) == 1 && bottom1[0].member == "bob", "bottom(1) = ${bottom1[0].member}")
  c.close()
}

test "live: incr (ZADD INCR) and incrBy (ZINCRBY) both raise a member's score" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:zset:incr"
  delKey(c, key)
  let z = c.zset(key)

  let afterIncr = z.incr("ada", 5.0) catch e {
    panic("incr: ${e.message()}")
  }
  assert(afterIncr == 5.0, "incr on a fresh member should start from 0, got ${afterIncr}")

  let afterIncrBy = z.incrBy("ada", 3.0) catch e {
    panic("incrBy: ${e.message()}")
  }
  assert(afterIncrBy == 8.0, "incrBy should add on top of incr's result, got ${afterIncrBy}")
  c.close()
}

test "live: rank reports both directions with WITHSCORE" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:zset:rank"
  delKey(c, key)
  let z = c.zset(key)
  z.addMany(
    Scored{ member = "ada", score = 10.0 },
    Scored{ member = "bob", score = 20.0 },
    Scored{ member = "cy", score = 30.0 },
  ) catch e {
    panic("addMany: ${e.message()}")
  }

  // The extremes tell the two directions apart; the middle member is rank 1
  // both ways (#7755 shipped with only that check and ZRANK/ZREVRANK swapped).
  let leader = z.rank("cy", true) catch e {
    panic("rank cy fromTop=true: ${e.message()}")
  }
  assert(unwrap(leader).0 == 0 && unwrap(leader).1 == 30.0, "rank('cy', true) is (0, 30.0)")
  let last = z.rank("ada", true) catch e {
    panic("rank ada fromTop=true: ${e.message()}")
  }
  assert(unwrap(last).0 == 2 && unwrap(last).1 == 10.0, "rank('ada', true) is (2, 10.0)")
  let lowest = z.rank("ada", false) catch e {
    panic("rank ada fromTop=false: ${e.message()}")
  }
  assert(unwrap(lowest).0 == 0 && unwrap(lowest).1 == 10.0, "rank('ada', false) is (0, 10.0)")
  let highest = z.rank("cy", false) catch e {
    panic("rank cy fromTop=false: ${e.message()}")
  }
  assert(unwrap(highest).0 == 2 && unwrap(highest).1 == 30.0, "rank('cy', false) is (2, 30.0)")

  let fromBottom = z.rank("bob", false) catch e {
    panic("rank fromTop=false: ${e.message()}")
  }
  match (fromBottom) {
    Some(pair) => {
      let (rank, score) = pair
      assert(rank == 1 && score == 20.0, "rank fromTop=false('bob') = (${rank}, ${score})")
    }
    None => panic("rank('bob') should find a present member")
  }

  let missing = z.rank("nobody") catch e {
    panic("rank on a missing member: ${e.message()}")
  }
  assert(isNone(missing), "rank('nobody') should be None")
  c.close()
}

test "live: countByScore/countByLex and byScore/byLex with infinite and exclusive bounds" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:zset:range"
  delKey(c, key)
  let z = c.zset(key)
  z.addMany(
    Scored{ member = "a", score = 10.0 },
    Scored{ member = "b", score = 20.0 },
    Scored{ member = "c", score = 30.0 },
  ) catch e {
    panic("addMany: ${e.message()}")
  }

  let allByScore = z.countByScore(Bound<f64>.Unbounded, Bound<f64>.Unbounded) catch e {
    panic("countByScore(-inf, +inf): ${e.message()}")
  }
  assert(allByScore == 3, "countByScore(-inf, +inf) should count every member, got ${allByScore}")

  let above10 = z.countByScore(Bound<f64>.Exclusive(10.0), Bound<f64>.Unbounded) catch e {
    panic("countByScore exclusive: ${e.message()}")
  }
  assert(above10 == 2, "countByScore((10, +inf) should exclude 'a', got ${above10}")

  let lex = z.countByLex(Bound<string>.Unbounded, Bound<string>.Unbounded) catch e {
    panic("countByLex(-, +): ${e.message()}")
  }
  assert(lex == 3, "countByLex(-, +) should count every member, got ${lex}")

  let range = z.byScore(Bound<f64>.Inclusive(20.0), Bound<f64>.Unbounded, noLimit()) catch e {
    panic("byScore: ${e.message()}")
  }
  assert(len(range) == 2, "byScore([20, +inf) should return 2 members, got ${len(range)}")
  assert(
    range[0].member == "b" && range[1].member == "c",
    "byScore order: ${range[0].member}, ${range[1].member}",
  )

  let lexRange = z.byLex(Bound<string>.Inclusive("a"), Bound<string>.Exclusive("c"), limitTo(1)) catch e {
    panic("byLex: ${e.message()}")
  }
  assert(len(lexRange) == 1 && lexRange[0] == "a", "byLex limited to 1 = ${lexRange[0]}")
  c.close()
}

test "live: storeTop, storeByScore and storeByLex write a range into another key" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let src = "bit:live:zset:store:src"
  let dstTop = "bit:live:zset:store:top"
  let dstScore = "bit:live:zset:store:score"
  let dstLex = "bit:live:zset:store:lex"
  delKey(c, src)
  delKey(c, dstTop)
  delKey(c, dstScore)
  delKey(c, dstLex)
  let z = c.zset(src)
  z.addMany(
    Scored{ member = "a", score = 10.0 },
    Scored{ member = "b", score = 20.0 },
    Scored{ member = "c", score = 30.0 },
  ) catch e {
    panic("addMany: ${e.message()}")
  }

  let nTop = z.storeTop(dstTop, 2) catch e {
    panic("storeTop: ${e.message()}")
  }
  assert(nTop == 2, "storeTop(2) should store 2 members, got ${nTop}")

  let nScore = z.storeByScore(dstScore, Bound<f64>.Inclusive(20.0), Bound<f64>.Unbounded, noLimit()) catch e {
    panic("storeByScore: ${e.message()}")
  }
  assert(nScore == 2, "storeByScore([20, +inf) should store 2 members, got ${nScore}")

  let nLex = z.storeByLex(dstLex, Bound<string>.Unbounded, Bound<string>.Unbounded, limitTo(1)) catch e {
    panic("storeByLex: ${e.message()}")
  }
  assert(nLex == 1, "storeByLex limited to 1 should store 1 member, got ${nLex}")
  c.close()
}

test "live: remove, removeByRank, removeByScore and removeByLex" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:zset:remove"
  delKey(c, key)
  let z = c.zset(key)
  z.addMany(
    Scored{ member = "a", score = 10.0 },
    Scored{ member = "b", score = 20.0 },
    Scored{ member = "c", score = 30.0 },
    Scored{ member = "d", score = 40.0 },
    Scored{ member = "e", score = 50.0 },
  ) catch e {
    panic("addMany: ${e.message()}")
  }

  let removed = z.remove("a") catch e {
    panic("remove: ${e.message()}")
  }
  assert(removed == 1, "remove('a') should remove 1 member, got ${removed}")

  let byRank = z.removeByRank(0, 0) catch e {
    panic("removeByRank: ${e.message()}")
  }
  assert(byRank == 1, "removeByRank(0, 0) should remove the lowest remaining member, got ${byRank}")

  let byScore = z.removeByScore(Bound<f64>.Unbounded, Bound<f64>.Exclusive(40.0)) catch e {
    panic("removeByScore: ${e.message()}")
  }
  assert(byScore == 1, "removeByScore(-inf, (40) should remove 'c', got ${byScore}")

  let byLex = z.removeByLex(Bound<string>.Unbounded, Bound<string>.Unbounded) catch e {
    panic("removeByLex: ${e.message()}")
  }
  assert(byLex == 2, "removeByLex(-, +) should remove everything left, got ${byLex}")

  let card = z.card() catch e {
    panic("card: ${e.message()}")
  }
  assert(card == 0, "the set should be empty after every remove, got ${card}")
  c.close()
}

test "live: popMin, popMax, popMinMany and popMaxMany" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:zset:pop"
  delKey(c, key)
  let z = c.zset(key)
  z.addMany(
    Scored{ member = "a", score = 10.0 },
    Scored{ member = "b", score = 20.0 },
    Scored{ member = "c", score = 30.0 },
    Scored{ member = "d", score = 40.0 },
  ) catch e {
    panic("addMany: ${e.message()}")
  }

  let min = z.popMin() catch e {
    panic("popMin: ${e.message()}")
  }
  assert(
    len(min) == 1 && min[0].member == "a",
    "popMin() should pop the lowest score, got ${min[0].member}",
  )

  let max = z.popMax() catch e {
    panic("popMax: ${e.message()}")
  }
  assert(
    len(max) == 1 && max[0].member == "d",
    "popMax() should pop the highest score, got ${max[0].member}",
  )

  let minMany = z.popMinMany(1) catch e {
    panic("popMinMany: ${e.message()}")
  }
  assert(len(minMany) == 1 && minMany[0].member == "b", "popMinMany(1) = ${minMany[0].member}")

  let maxMany = z.popMaxMany(1) catch e {
    panic("popMaxMany: ${e.message()}")
  }
  assert(len(maxMany) == 1 && maxMany[0].member == "c", "popMaxMany(1) = ${maxMany[0].member}")

  let card = z.card() catch e {
    panic("card: ${e.message()}")
  }
  assert(card == 0, "every member should be popped, got ${card}")
  c.close()
}

fn delayedAdd(admin: Client, key: string, member: string, score: f64) {
  sleep(200000000)
  admin.zset(key).add(member, score) catch e {
    panic("delayed add: ${e.message()}")
  }
}

// The blocking-pop acceptance: `blockPopMin` genuinely waits (the key
// starts empty) and is satisfied by a second, independent connection's
// `add`, run on its own green thread (`spawn`) after a short delay — the
// same "satisfied by a push from another connection" shape the sibling
// list ticket's own acceptance names.
test "live: blockPopMin blocks until a concurrent add satisfies it" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let admin = liveClient(u)
  let key = "bit:live:zset:blockpop"
  delKey(c, key)

  spawn delayedAdd(admin, key, "ada", 1.0)
  let got = c.zset(key).blockPopMin(5 * Second) catch e {
    panic("blockPopMin: ${e.message()}")
  }
  match (got) {
    Some(scored) => assert(
      scored.member == "ada" && scored.score == 1.0,
      "blockPopMin should return the concurrently-added member, got ${scored.member}, ${scored.score}",
    )
    None => panic("blockPopMin timed out waiting for the spawned add")
  }
  c.close()
  admin.close()
}

fn zsetBlockedPop(c: Client, key: string, done: chan<bool>) {
  let got = c.zset(key).blockPopMin(500 * Millisecond) catch _ {
    done <- false
    return
  }
  done <- isNone(got)
}

// A blocked zset pop never holds the pool's only connection (`pool=1`):
// `get` completes while a 500ms `BZPOPMIN` is still waiting (#7147).
test "live: a blocked blockPopMin leaves a one-connection pool free" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient("${u}?pool=1")
  let key = "bit:live:zset:starve"
  delKey(c, key)

  let done = chan<bool>(1)
  spawn zsetBlockedPop(c, key, done)
  sleep(100 * Millisecond)
  let start = monotonic()
  let got = c.get("bit:live:zset:starve:probe") catch e {
    panic("get while a zset pop is blocked: ${e.message()}")
  }
  let took = since(start)
  assert(isNone(got), "the probe key was never set")
  // The pop still has ~400ms to wait: a pool that queued this `get` behind
  // it would take that long.
  assert(took < 250 * Millisecond, "get took ${took}ns while a pop was blocked")
  let timedOut = <- done
  assert(timedOut, "the blocked pop should have timed out to None")
  c.close()
}

test "live: blockPopMin times out on an empty key that nothing satisfies" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:zset:blockpop:timeout"
  delKey(c, key)
  let got = c.zset(key).blockPopMin(300000000) catch e {
    panic("blockPopMin: ${e.message()}")
  }
  assert(isNone(got), "blockPopMin on a key nothing ever fills should time out to None")
  c.close()
}

test "live: blockPopMax, blockPopMinMany and blockPopMaxMany on an already-populated key return immediately" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:zset:blockmany"
  delKey(c, key)
  let z = c.zset(key)
  z.addMany(
    Scored{ member = "a", score = 10.0 },
    Scored{ member = "b", score = 20.0 },
    Scored{ member = "c", score = 30.0 },
  ) catch e {
    panic("addMany: ${e.message()}")
  }

  let max = z.blockPopMax(1 * Second) catch e {
    panic("blockPopMax: ${e.message()}")
  }
  match (max) {
    Some(scored) => assert(
      scored.member == "c",
      "blockPopMax should pop the highest score, got ${scored.member}",
    )
    None => panic("blockPopMax on a non-empty key should not time out")
  }

  let minMany = z.blockPopMinMany(1, 1 * Second) catch e {
    panic("blockPopMinMany: ${e.message()}")
  }
  assert(len(minMany) == 1 && minMany[0].member == "a", "blockPopMinMany(1) = ${minMany[0].member}")

  let maxMany = z.blockPopMaxMany(1, 1 * Second) catch e {
    panic("blockPopMaxMany: ${e.message()}")
  }
  assert(len(maxMany) == 1 && maxMany[0].member == "b", "blockPopMaxMany(1) = ${maxMany[0].member}")
  c.close()
}

test "live: union, inter and diff, plain and weighted with an aggregate" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let a = "bit:live:zset:setop:a"
  let b = "bit:live:zset:setop:b"
  delKey(c, a)
  delKey(c, b)
  c.zset(a).addMany(Scored{ member = "x", score = 1.0 }, Scored{ member = "y", score = 2.0 }) catch e {
    panic("addMany a: ${e.message()}")
  }
  c.zset(b).addMany(Scored{ member = "y", score = 10.0 }, Scored{ member = "z", score = 3.0 }) catch e {
    panic("addMany b: ${e.message()}")
  }

  let union = c.zset(a).union([b], []f64(0), Aggregate.Sum) catch e {
    panic("union: ${e.message()}")
  }
  assert(len(union) == 3, "union(a, b) should have 3 members (x, y, z), got ${len(union)}")

  let inter = c.zset(a).inter([b], [2.0, 1.0], Aggregate.Max) catch e {
    panic("inter weighted: ${e.message()}")
  }
  assert(
    len(inter) == 1 && inter[0].member == "y",
    "inter(a, b) should only share 'y', got ${inter[0].member}",
  )
  assert(
    inter[0].score == 10.0,
    "inter weighted MAX(2*2, 1*10) should be 10.0, got ${inter[0].score}",
  )

  let diff = c.zset(a).diff([b]) catch e {
    panic("diff: ${e.message()}")
  }
  assert(
    len(diff) == 1 && diff[0].member == "x",
    "diff(a, b) should only be 'x', got ${diff[0].member}",
  )
  c.close()
}

test "live: unionStore, interStore and diffStore write their result into a destination key" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let a = "bit:live:zset:setopstore:a"
  let b = "bit:live:zset:setopstore:b"
  let unionDst = "bit:live:zset:setopstore:union"
  let interDst = "bit:live:zset:setopstore:inter"
  let diffDst = "bit:live:zset:setopstore:diff"
  delKey(c, a)
  delKey(c, b)
  delKey(c, unionDst)
  delKey(c, interDst)
  delKey(c, diffDst)
  c.zset(a).addMany(Scored{ member = "x", score = 1.0 }, Scored{ member = "y", score = 2.0 }) catch e {
    panic("addMany a: ${e.message()}")
  }
  c.zset(b).addMany(Scored{ member = "y", score = 10.0 }, Scored{ member = "z", score = 3.0 }) catch e {
    panic("addMany b: ${e.message()}")
  }

  let nUnion = c.zset(a).unionStore(unionDst, [b], []f64(0), Aggregate.Sum) catch e {
    panic("unionStore: ${e.message()}")
  }
  assert(nUnion == 3, "unionStore should write 3 members, got ${nUnion}")

  let nInter = c.zset(a).interStore(interDst, [b], []f64(0), Aggregate.Sum) catch e {
    panic("interStore: ${e.message()}")
  }
  assert(nInter == 1, "interStore should write 1 member, got ${nInter}")

  let nDiff = c.zset(a).diffStore(diffDst, [b]) catch e {
    panic("diffStore: ${e.message()}")
  }
  assert(nDiff == 1, "diffStore should write 1 member, got ${nDiff}")
  c.close()
}

test "live: randMember and randMembers draw from present members" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:zset:rand"
  delKey(c, key)
  let z = c.zset(key)
  z.addMany(Scored{ member = "a", score = 1.0 }, Scored{ member = "b", score = 2.0 }) catch e {
    panic("addMany: ${e.message()}")
  }

  let one = z.randMember() catch e {
    panic("randMember: ${e.message()}")
  }
  match (one) {
    Some(m) => assert(m == "a" || m == "b", "randMember should return a present member, got '${m}'")
    None => panic("randMember on a non-empty set should return a value")
  }

  let many = z.randMembers(2) catch e {
    panic("randMembers: ${e.message()}")
  }
  assert(len(many) == 2, "randMembers(2) should return 2 entries, got ${len(many)}")

  let empty = "bit:live:zset:rand:empty"
  delKey(c, empty)
  let none = c.zset(empty).randMember() catch e {
    panic("randMember on an empty set: ${e.message()}")
  }
  assert(isNone(none), "randMember on an empty set should be None")
  c.close()
}

test "live: scan iterates every member exactly once, scores intact" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:zset:scan"
  delKey(c, key)
  let z = c.zset(key)
  z.addMany(
    Scored{ member = "a", score = 1.0 },
    Scored{ member = "b", score = 2.0 },
    Scored{ member = "c", score = 3.0 },
  ) catch e {
    panic("addMany: ${e.message()}")
  }

  let it = z.scan()
  let seen = 0
  let total = 0.0
  let next = it.next() catch e {
    panic("scan: ${e.message()}")
  }
  while (isSome(next)) {
    let scored = unwrap(next)
    assert(
      scored.member == "a" || scored.member == "b" || scored.member == "c",
      "scan yielded an unexpected member '${scored.member}'",
    )
    seen = seen + 1
    total = total + scored.score
    next = it.next() catch e {
      panic("scan: ${e.message()}")
    }
  }
  assert(seen == 3, "scan should yield exactly 3 members, got ${seen}")
  assert(total == 6.0, "scan scores should sum to 6.0, got ${total}")
  c.close()
}

fn seedBoard(c: Client, key: string) {
  delKey(c, key)
  c.zset(key).addMany(
    Scored{ member = "ada", score = 10.0 },
    Scored{ member = "bob", score = 20.0 },
    Scored{ member = "cy", score = 30.0 },
  ) catch e {
    panic("addMany ${key}: ${e.message()}")
  }
}

test "live: tx.read.zset reads score, rank, card, counts and ranges before the queued write runs" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:zset:txread"
  let lex = "bit:live:zset:txread:lex"
  seedBoard(c, key)
  delKey(c, lex)
  c.zset(lex).addMany(
    Scored{ member = "a", score = 0.0 },
    Scored{ member = "b", score = 0.0 },
    Scored{ member = "c", score = 0.0 },
  ) catch e {
    panic("addMany lex: ${e.message()}")
  }
  let out = c.transaction<Future<i64>>([key, lex], (tx) => {
    tx.zset(lex).add("d", 0.0)
    let queued = tx.zset(key).add("dee", 40.0)
    let z = tx.read.zset(key)
    let dee = z.score("dee")?
    let bob = z.score("bob")?
    assert(isNone(dee) && unwrap(bob) == 20.0, "score runs now: dee is not added until EXEC")
    let both = z.scores("ada", "dee")?
    assert(unwrap(both[0]) == 10.0 && isNone(both[1]), "scores runs now")
    let placed = z.rank("cy", true)?
    assert(
      unwrap(placed).0 == 0 && unwrap(placed).1 == 30.0,
      "rank runs now: dee does not outrank cy yet",
    )
    let card = z.card()?
    assert(card == 3, "card = ${card}, not 4")
    let byScoreCount = z.countByScore(Bound<f64>.Unbounded, Bound<f64>.Unbounded)?
    assert(byScoreCount == 3, "countByScore = ${byScoreCount}")
    let byLexCount = tx.read.zset(lex).countByLex(Bound<string>.Unbounded, Bound<string>.Unbounded)?
    assert(byLexCount == 3, "countByLex = ${byLexCount}, not 4")
    let top = z.top(10)?
    assert(len(top) == 3 && top[0].member == "cy", "top sees three members, cy first")
    let bottom = z.bottom(10)?
    assert(len(bottom) == 3 && bottom[0].member == "ada", "bottom sees three members, ada first")
    let range = z.byScore(Bound<f64>.Inclusive(15.0), Bound<f64>.Unbounded, noLimit())?
    assert(len(range) == 2, "byScore sees bob and cy, got ${len(range)}")
    let words = tx.read.zset(lex).byLex(
      Bound<string>.Inclusive("a"),
      Bound<string>.Unbounded,
      noLimit(),
    )?
    assert(len(words) == 3, "byLex sees a, b, c, not d, got ${len(words)}")
    return queued
  }) catch e {
    panic("transaction: ${e.message()}")
  }
  let added = out.get() catch e {
    panic("future: ${e.message()}")
  }
  assert(added == 1, "the queued add committed, got ${added}")
  let after = c.zset(key).card() catch e {
    panic("card after: ${e.message()}")
  }
  assert(after == 4, "dee landed at EXEC, card = ${after}")
  delKey(c, key)
  delKey(c, lex)
  c.close()
}

test "live: tx.read.zset reads union, inter, diff, randMember and scan before the queued write runs, and refuses a write" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:zset:txread:sets"
  let other = "bit:live:zset:txread:other"
  seedBoard(c, key)
  delKey(c, other)
  c.zset(other).addMany(
    Scored{ member = "ada", score = 1.0 },
    Scored{ member = "zed", score = 5.0 },
  ) catch e {
    panic("addMany other: ${e.message()}")
  }
  let out = c.transaction<Future<i64>>([key], (tx) => {
    let queued = tx.zset(key).add("dee", 40.0)
    let z = tx.read.zset(key)
    let union = z.union([other], []f64(0), Aggregate.Sum)?
    assert(len(union) == 4, "union = ${len(union)} members: ada, bob, cy, zed, not dee")
    let inter = z.inter([other], []f64(0), Aggregate.Sum)?
    assert(
      len(inter) == 1 && inter[0].member == "ada" && inter[0].score == 11.0,
      "inter = ada at 11",
    )
    let shared = z.interCard([other])?
    assert(shared == 1, "interCard = ${shared}: ada only, dee is not added until EXEC")
    let diff = z.diff([other])?
    assert(len(diff) == 2, "diff = bob and cy, got ${len(diff)}")
    let one = z.randMember()?
    assert(unwrap(one) != "dee", "randMember draws from the three members present")
    let many = z.randMembers(10)?
    assert(len(many) == 3, "randMembers(10) = ${len(many)}, not 4")
    let it = z.scan()
    let seen = 0
    let next = it.next()?
    while (isSome(next)) {
      assert(unwrap(next).member != "dee", "scan yielded dee before EXEC")
      seen = seen + 1
      next = it.next()?
    }
    assert(seen == 3, "scan yields the three members present, got ${seen}")
    let refused = false
    let _ = z.add("eve", 1.0) catch _ {
      refused = true
      0
    }
    assert(refused, "a write through tx.read is refused")
    let refusedPop = false
    let _ = z.blockPopMin(1000000) catch _ {
      refusedPop = true
      Option.None
    }
    assert(refusedPop, "a blocking pop through tx.read is refused")
    return queued
  }) catch e {
    panic("transaction: ${e.message()}")
  }
  let added = out.get() catch e {
    panic("future: ${e.message()}")
  }
  assert(added == 1, "the queued add committed, got ${added}")
  let after = c.zset(key).score("eve") catch e {
    panic("score after: ${e.message()}")
  }
  assert(isNone(after), "eve never landed")
  delKey(c, key)
  delKey(c, other)
  c.close()
}
