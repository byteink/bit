// pkg/redis/counter.bit — `r.counter(key)`: an integer counter (`INCR`,
// `DECR`, `INCRBY`, `DECRBY`, `GET`). Epic #6013, #6028, #6029: the
// REFERENCE FAMILY for `cmd.bit`'s runner-based immediate-handle pattern —
// copy this file's shape (one `Cmd<T>` factory per command, a `runner:
// Runner` field on the immediate handle, a `batch: Batch` field on the
// queued view) when wiring another family's real commands.
//
// `incrByFloat` (#6034) IS THE ONE CROSS-FAMILY EXCEPTION: `INCRBYFLOAT` is
// a plain-string command (`strings.bit`'s own ticket lists it there), but
// `r.counter(k).incrByFloat(...)` is the natural call — the same key this
// file's `incr`/`incrBy` already operate on, read as "one more way to grow
// this counter" rather than a second, unrelated handle a caller would need
// to open on the same key. `strings.bit`'s header notes the same decision
// from that file's side.
//
// `get()` RETURNS `i64`, NEVER `Option<i64>`, AND A MISSING KEY READS AS
// 0 — this mirrors `INCR`/`DECR`'s own Redis semantics (a nonexistent
// counter key starts at 0 before the operation applies), so
// `counter("hits").get()` reads as "the count so far" exactly the way
// `counter("hits").incr()` already treats a fresh key. `client.bit`'s plain
// `GET` stays `Option<string>` (a cache miss and an empty string are
// genuinely different there); a counter has no such ambiguity, since an
// absent counter and one that is 0 mean the same thing to every other
// method on this handle.

// The immediate handle: `r.counter(key)` (pool-backed) or
// `tx.read.counter(key)` (pinned to a transaction attempt's own
// connection, #6029) — same class, same commands, either way.
export class Counter {
  runner: Runner
  key: string

  export get(): i64!RedisError { return this.runner.runCmd(counterGetCmd(this.key))? }
  export incr(): i64!RedisError { return this.runner.runCmd(incrCmd(this.key))? }
  export incrBy(delta: i64): i64!RedisError {
    return this.runner.runCmd(incrByCmd(this.key, delta))?
  }
  export decr(): i64!RedisError { return this.runner.runCmd(decrCmd(this.key))? }
  export decrBy(delta: i64): i64!RedisError {
    return this.runner.runCmd(decrByCmd(this.key, delta))?
  }
  export incrByFloat(delta: f64): f64!RedisError {
    return this.runner.runCmd(incrByFloatCmd(this.key, delta))?
  }
}

// The queued view `Pipeline.counter`/`Tx.counter` both return — `cmd.bit`'s
// `Batch` is the ONE client-side queue the two executors share, so this is
// the ONLY queued view `Counter` needs (`cmd.bit`'s header, point 2).
export class CounterBatch {
  batch: Batch
  key: string

  export get(): Future<i64> { return this.batch.queue(counterGetCmd(this.key)) }
  export incr(): Future<i64> { return this.batch.queue(incrCmd(this.key)) }
  export incrBy(delta: i64): Future<i64> { return this.batch.queue(incrByCmd(this.key, delta)) }
  export decr(): Future<i64> { return this.batch.queue(decrCmd(this.key)) }
  export decrBy(delta: i64): Future<i64> { return this.batch.queue(decrByCmd(this.key, delta)) }
  export incrByFloat(delta: f64): Future<f64> {
    return this.batch.queue(incrByFloatCmd(this.key, delta))
  }
}

fn counterGetCmd(key: string): Cmd<i64> {
  return Cmd<i64>{ args = ["GET", key], decode = (r) => asCounterInt(r, "GET"), readOnly = true }
}

fn incrCmd(key: string): Cmd<i64> {
  return Cmd<i64>{ args = ["INCR", key], decode = (r) => asInt(r, "INCR"), readOnly = false }
}

fn incrByCmd(key: string, delta: i64): Cmd<i64> {
  return Cmd<i64>{
    args = ["INCRBY", key, "${delta}"],
    decode = (r) => asInt(r, "INCRBY"),
    readOnly = false,
  }
}

fn decrCmd(key: string): Cmd<i64> {
  return Cmd<i64>{ args = ["DECR", key], decode = (r) => asInt(r, "DECR"), readOnly = false }
}

fn decrByCmd(key: string, delta: i64): Cmd<i64> {
  return Cmd<i64>{
    args = ["DECRBY", key, "${delta}"],
    decode = (r) => asInt(r, "DECRBY"),
    readOnly = false,
  }
}

fn incrByFloatCmd(key: string, delta: f64): Cmd<f64> {
  return Cmd<f64>{
    args = ["INCRBYFLOAT", key, "${delta}"],
    decode = (r) => asDouble(r, "INCRBYFLOAT"),
    readOnly = false,
  }
}

// A counter's `GET` is always either absent (a fresh counter, 0) or a
// base-10 integer string — `INCR`/`DECR`/`INCRBY`/`DECRBY` never write
// anything else to this key — decoded straight to `i64`, matching `get()`'s
// own contract above (this file's header).
fn asCounterInt(r: Reply, cmd: string): i64!RedisError {
  match (r) {
    Bulk(v) => return counterIntFromBulk(v, cmd)?
    Null => return 0
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

fn counterIntFromBulk(v: Option<string>, cmd: string): i64!RedisError {
  match (v) {
    Some(s) => return parseCounterInt(s, cmd)?
    None => return 0
  }
}

fn parseCounterInt(s: string, cmd: string): i64!RedisError {
  return parseInt(s) catch _ {
    fail RedisError.Unexpected(cmd, "Bulk")
  }
}
