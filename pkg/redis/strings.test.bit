// pkg/redis/strings.test.bit — `strings.bit`'s wire-arg builders and decode
// helpers, tested directly against plain arguments and `Reply` values: none
// of this needs a socket, real or fake (`cmd.test.bit`'s own split already
// proved the shared decode helpers this file reuses).

test "getExArgs sends PX milliseconds when ttl is set" {
  let withTtl = getExArgs("k", 5000000000, false)
  assert(
    withTtl[0] == "GETEX" && withTtl[1] == "k",
    "args[0..1] = '${withTtl[0]}', '${withTtl[1]}'",
  )
  assert(
    withTtl[2] == "PX" && withTtl[3] == "5000",
    "expected PX 5000, got '${withTtl[2]}' '${withTtl[3]}'",
  )
}

test "getExArgs sends PERSIST and ignores ttl when persist is true" {
  let persisted = getExArgs("k", 5000000000, true)
  assert(len(persisted) == 3, "expected 3 args, got ${len(persisted)}")
  assert(persisted[2] == "PERSIST", "expected PERSIST, got '${persisted[2]}'")
}

test "getExArgs sends neither flag when ttl is 0 and persist is false" {
  let bare = getExArgs("k", 0, false)
  assert(len(bare) == 2, "expected 2 args, got ${len(bare)}")
}

test "asOptString distinguishes a null bulk from an empty one for GETDEL" {
  let missing = asOptString(Reply.Null, "GETDEL") catch e {
    panic("asOptString: ${e.message()}")
  }
  assert(isNone(missing), "expected None for a null bulk")
  let empty = asOptString(Reply.Bulk(Option.Some("")), "GETDEL") catch e {
    panic("asOptString: ${e.message()}")
  }
  assert(isSome(empty) && unwrap(empty) == "", "expected Some('') for an empty bulk")
}

test "replyToString reads GETRANGE's bulk reply, empty string included" {
  let got = replyToString(Reply.Bulk(Option.Some("")), "GETRANGE") catch e {
    panic("replyToString: ${e.message()}")
  }
  assert(got == "", "expected '', got '${got}'")
  let word = replyToString(Reply.Bulk(Option.Some("ell")), "GETRANGE") catch e {
    panic("replyToString: ${e.message()}")
  }
  assert(word == "ell", "expected 'ell', got '${word}'")
}

test "getRangeCmd/setRangeCmd/appendCmd/strLenCmd build the expected wire args" {
  let range = getRangeCmd("k", 0, -1)
  assert(
    range.args[0] == "GETRANGE" && range.args[2] == "0" && range.args[3] == "-1",
    "getRangeCmd args = '${range.args[0]}', '${range.args[2]}', '${range.args[3]}'",
  )

  let setRange = setRangeCmd("k", 6, "Redis")
  assert(
    setRange.args[0] == "SETRANGE" && setRange.args[2] == "6" && setRange.args[3] == "Redis",
    "setRangeCmd args[3] = '${setRange.args[3]}'",
  )

  let appended = appendCmd("k", "abc")
  assert(
    appended.args[0] == "APPEND" && appended.args[2] == "abc",
    "appendCmd args[2] = '${appended.args[2]}'",
  )

  let strLen = strLenCmd("k")
  assert(
    strLen.args[0] == "STRLEN" && strLen.args[1] == "k",
    "strLenCmd args = '${strLen.args[0]}'",
  )
}

test "lcsCmd/lcsLenCmd send LCS with and without the LEN flag" {
  let plain = lcsCmd("k1", "k2")
  assert(len(plain.args) == 3 && plain.args[0] == "LCS", "lcsCmd args = ${len(plain.args)}")

  let withLen = lcsLenCmd("k1", "k2")
  assert(
    len(withLen.args) == 4 && withLen.args[3] == "LEN",
    "lcsLenCmd args = ${len(withLen.args)}, last = '${withLen.args[len(withLen.args) - 1]}'",
  )
}
