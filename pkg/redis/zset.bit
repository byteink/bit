// pkg/redis/zset.bit — `r.zset(key)`: the sorted-set handle. Epic
// #6013, #6028: SCAFFOLD ONLY, no commands wired yet (`ZADD, ZSCORE, ZRANGE, ZREM`, a
// follow-up ticket) — this file exists so later family tickets touch only
// their own file, never `client.bit`. `cmd.bit`'s header is the template:
// one `Cmd<T>` factory per command, called from a method here.
export class Zset {
  client: Client,
  key: string,
}

// The queued view `Pipeline.zset`/`Tx.zset` both return — `cmd.bit`'s
// `Batch` is the ONE client-side queue the two executors share, so this
// is the ONLY queued view Zset needs (`cmd.bit`'s header, point 2).
export class ZsetBatch {
  batch: Batch,
  key: string,
}
