// pkg/redis/zset.bit — `r.zset(key)`: every sorted-set command. Epic
// #6013, #6028, #6029, #6033. The leaderboard is this package's own running
// doc example (`docs/sorted-sets.md`): `r.zset("board").add("ada", 42.0)?`,
// `r.zset("board").top(10)?`.
//
// `zsetcmd.bit` (same module, sibling file) holds every command's `Cmd<T>`
// factory and this family's decode helpers — sorted sets have the largest
// command surface of any family in this epic (~40 commands), and keeping
// both halves in one file would cross spec/LINT.md's 800-line ceiling
// (E0200); this file keeps the two public classes (`Zset`, `ZsetBatch`),
// the small supporting types (`ZaddOptions`, `Bound<T>`, `Limit`,
// `Aggregate`) and `ZsetScan`.
//
// `Zset` (and `ZsetScan`) HOLD `runner: Runner`, as `set.bit`'s `Set` does:
// `r.zset(key)` runs over the pool, `tx.read.zset(key)` over a transaction
// attempt's own pinned connection (`tx.bit`'s header), where the read
// commands (`score`, `rank`, `card`, `top`, `byScore`, `randMember`, `scan`,
// ...) see the keys the transaction `WATCH`es. A write there is refused
// (#7754): queue it with `tx.zset(key)`. A blocking pop needs a connection of
// its own, so it is refused on a pinned runner too (`blockRun`).
//
// TWO-METHOD SPLIT ON `ZADD`: `add(member, score)` is the plain call the
// epic's spine shows verbatim, so it stays exactly 2 params. `addIf(member,
// score, opts)` carries NX/XX/GT/LT/CH (`ZaddOptions`) as one options value,
// not five more parameters on `add` itself — `bit check` rejects a
// parameter's default value unless it is a constant literal (E0159; a bare
// class literal, a negative number and an enum variant were all tried and
// all refused — a compiler-verified constraint, not a style choice), so a
// class-typed `opts: ZaddOptions = ZaddOptions{}` default cannot exist, and
// five individual `bool` parameters plus `member`/`score` would be seven,
// past spec/LINT.md's five-parameter ceiling (E0202). Splitting the method
// keeps the common call two params and the flagged call one options value,
// with no default anywhere the checker would refuse.
//
// `Limit` (BYSCORE/BYLEX's `LIMIT offset count`) is the same story: the
// ticket's own `byScore(min, max, limit)` shape needs a THIRD parameter
// named `limit`, and a `Limit` value cannot default either (same E0159), so
// it is a required argument — `noLimit()`/`limitTo(n)` are the two calls a
// caller actually needs, so the common case still reads as one extra
// argument, not a bag of individually-defaulted numbers.
//
// `union`/`inter`/their STORE forms take `weights`/`aggregate` as required
// arguments for the identical reason (`[]f64(0)`/`Aggregate.Sum` cannot
// default either) — a caller with no weighting passes `[]f64(0)` and
// `Aggregate.Sum` explicitly; both are ordinary call-site expressions, only
// a parameter's OWN default is restricted.
//
// SCORES ENCODE/DECODE THROUGH RESP3 `Double` IN PRACTICE. This package
// negotiates `HELLO 3` by default (`tx.bit`'s header), so every score-
// bearing reply this file decodes (`ZSCORE`, `ZRANGE ... WITHSCORES`, ...)
// arrives as `Reply.Double`, which `cmd.bit`'s `asDouble`/`asScored` already
// handle correctly for `+inf`/`-inf` (`resp3.bit`'s `decodeDouble` parses
// RESP3's `inf`/`-inf` wire spelling directly into the two infinities
// before this file ever sees a `Reply`). The RESP2 bulk-string fallback
// path for an infinite score (`cmd.bit`'s `doubleFromBulk`, built on the
// predeclared `parseFloat`, which does NOT understand "inf" text —
// `resp3.bit`'s own header says so) is a real, separate gap, but only
// reachable over the RESP2 fallback this package does not negotiate by
// default (#6027, still open, is where that fallback itself is tested) —
// not fixed here, since `doubleFromBulk` lives in `cmd.bit`, a shared file
// this dispatch is scoped away from; reported on the ticket instead.
// `scoreArg` below (the ENCODE direction, this file's own code) emits
// `+inf`/`-inf` explicitly for outgoing command args regardless of
// protocol, since Redis parses those unconditionally on the way in.
//
// A BLOCKING COMMAND NEVER LEASES A POOL CONNECTION (#7147).
// `BZPOPMIN`/`BZPOPMAX`/`BZMPOP` must neither trip the pooled connection's
// fixed `commandTimeout` while waiting up to their OWN `timeout` argument,
// nor hold a pooled connection for the whole wait (N blocked pops would leave
// a pool of N nothing for `get`/`set`). The four blocking methods below run
// on `runBlocking` (`cmd.bit`; `list.bit`'s header has the cost and deadline
// rules): a connection dialed for the call and closed after it, read deadline
// `timeout + commandTimeout`, none for `timeoutNs <= 0` ("block forever").
// Queuing a blocking command through `ZsetBatch` shares one `Cmd<T>`
// factory with its immediate method (`cmd.bit`'s header, point 2) — queuing
// does no I/O, so it has no deadline problem of its own — but running that
// queued command still means `Pipeline.exec()`/`tx.bit`'s per-attempt wire
// loop, both fixed to `client.opts.commandTimeout` for every command in the
// batch. A blocking command queued into either one is bounded by that FIXED
// timeout, not its own `timeout` argument — a real, known gap in those two
// shared files, reported on the ticket rather than fixed here.

// One member's ZADD flags — `NX`, `XX`, `GT` (`onlyIfHigher`), `LT`
// (`onlyIfLower`) and `CH`, as one required argument to `addIf` (this
// file's header explains why it cannot default and so is not folded into
// `add` itself). Every field defaults to `false` on its own declaration —
// `bool` is a literal default (E0159 allows it), so `ZaddOptions{
// onlyIfHigher = true }` only ever needs to name the flags actually wanted.
export class ZaddOptions {
  export nx: bool = false,
  export xx: bool = false,
  export onlyIfHigher: bool = false,
  export onlyIfLower: bool = false,
  export ch: bool = false,
}

// `BYSCORE`/`BYLEX`'s `LIMIT offset count` — required on `byScore`/`byLex`/
// their STORE forms (this file's header: a class-typed default cannot
// exist). `noLimit()`/`limitTo(count)` cover the two calls a caller
// actually needs; `Limit{ offset = ..., count = ... }` is there for the
// rest. `count <= 0` OMITS the `LIMIT` clause entirely (`appendLimit`
// below) rather than sending a literal `0`, since Redis's own `LIMIT`
// requires BOTH numbers together and there is no other way to spell "no
// limit" through this type — a caller who genuinely wants zero results
// back is better served by not calling `byScore` at all.
export class Limit { export offset: i64, export count: i64 }

export fn noLimit(): Limit { return Limit{ offset = 0, count = 0 } }

export fn limitTo(count: i64): Limit { return Limit{ offset = 0, count = count } }

// One score-range endpoint (`BYSCORE`'s `min`/`max`) or one lex-range
// endpoint (`BYLEX`'s), shared by both `Bound<f64>` and `Bound<string>`
// instantiations — `scoreBoundArg`/`lexBoundArg` below are what turn one
// into wire text, each choosing the right infinity spelling for its own
// syntax ("+inf"/"-inf" for a score, "+"/"-" for a lex bound) from the
// SAME `Unbounded` variant, so a caller never picks the wrong one by hand.
export enum Bound<T> {
  Inclusive(T),
  Exclusive(T),
  Unbounded,
}

// `ZUNION`/`ZINTER`'s `AGGREGATE` clause — Redis defaults to `SUM` when the
// clause is omitted, so `appendAggregate` below skips it exactly for this
// variant (never emitting a redundant `AGGREGATE SUM`).
export enum Aggregate { Sum, Min, Max }

fn aggregateName(a: Aggregate): string {
  match (a) {
    Sum => return "SUM"
    Min => return "MIN"
    Max => return "MAX"
  }
}

// A score, as ZADD/ZINCRBY/WEIGHTS wire text. `"${score}"` (string
// interpolation) already round-trips every finite `f64` exactly
// (`pkg/yaml/encode.bit`'s own header documents the same Dragon4 engine);
// the only gap is the two infinities, which interpolation does not spell
// the way Redis parses incoming command text (`resp3.bit`'s own note: `"${
// x}"`'s lowercase "inf" is not what any wire format here relies on), so
// both are matched directly against the largest finite `f64`
// (`stdlib/strings/format.bit`'s `formatFloat`'s own `maxFinite` technique,
// mirrored here rather than reused, since that constant is function-local
// there, not exported).
fn scoreArg(score: f64): string {
  let maxFinite = 1.7976931348623157e308
  if (score > maxFinite) {
    return "+inf"
  }
  if (score < 0.0 - maxFinite) {
    return "-inf"
  }
  return "${score}"
}

fn scoreBoundArg(b: Bound<f64>, isMin: bool): string {
  match (b) {
    Inclusive(v) => return scoreArg(v)
    Exclusive(v) => return "(" + scoreArg(v)
    Unbounded => return scoreInfArg(isMin)
  }
}

fn scoreInfArg(isMin: bool): string {
  if (isMin) {
    return "-inf"
  }
  return "+inf"
}

fn lexBoundArg(b: Bound<string>, isMin: bool): string {
  match (b) {
    Inclusive(v) => return "[" + v
    Exclusive(v) => return "(" + v
    Unbounded => return lexInfArg(isMin)
  }
}

fn lexInfArg(isMin: bool): string {
  if (isMin) {
    return "-"
  }
  return "+"
}

// EVERY HELPER BELOW REASSIGNS ITS OWN SLICE PARAMETER (`args = append(args,
// ...)`) AND THEN RETURNS THAT SAME NAME BARE, ON ITS OWN LINE — the one
// shape spec/LINT.md's `append-aliasing` (E0214) recognizes as safely
// handing a parameter's growth back to the caller; `return append(args,
// ...)` directly (skipping the self-reassignment) is flagged just the same
// as growing an unrelated local a parameter was only ever aliased into
// (proved empirically, both tried and reported on this ticket). Any list
// built up conditionally (a loop, a variable number of flags) is assembled
// into its OWN fresh slice first (seeded `[]string(0)`/a literal, never
// aliased to a parameter, so its own internal appends carry no aliasing
// risk at all) and merged in with one spread `append`.
fn appendKeys(args: []string, keys: []string): []string {
  args = append(args, ...keys)
  return args
}

fn appendWeights(args: []string, weights: []f64): []string {
  if (len(weights) == 0) {
    return args
  }
  args = append(args, ...weightsClause(weights))
  return args
}

fn weightsClause(weights: []f64): []string {
  let out = ["WEIGHTS"]
  let i = 0
  while (i < len(weights)) {
    out = append(out, scoreArg(weights[i]))
    i = i + 1
  }
  return out
}

fn appendAggregate(args: []string, aggregate: Aggregate): []string {
  if (aggregate == Aggregate.Sum) {
    return args
  }
  args = append(args, "AGGREGATE", aggregateName(aggregate))
  return args
}

fn appendLimit(args: []string, limit: Limit): []string {
  if (limit.count <= 0) {
    return args
  }
  args = append(args, "LIMIT", "${limit.offset}", "${limit.count}")
  return args
}

// `CMD key item [item ...]` — `ZMSCORE`/`ZREM`'s shared shape (one key,
// then a variadic tail), distinct from `client.bit`'s own `withKeys` (which
// has no leading key, just a repeated one for `DEL`/`EXISTS`).
fn withKeyMembers(cmd: string, key: string, members: []string): []string {
  let args = [cmd, key]
  args = append(args, ...members)
  return args
}

// `0 (n-1)` (ascending) or `0 (n-1) REV` (descending) is EMPTY, not the
// whole set, exactly when `n <= 0`: Redis's stop index `-1` means "the
// last element", so a naive `n - 1` for `n == 0` would ask for "0 to -1"
// and get everything back. `1 0` (start > stop) is unconditionally empty
// under Redis's own rank-range rule regardless of the set's real size.
fn rankRangeBounds(n: i64): (string, string) {
  if (n <= 0) {
    return "1", "0"
  }
  return "0", "${n - 1}"
}

// The blocking-command timeout argument: `"0"` for "forever" (`timeoutNs <=
// 0`, the convention this file's header names), else `cmd.bit`'s
// `blockSeconds` - whole milliseconds, a positive sub-millisecond timeout
// sent as 1ms so it is never read as "forever".
fn blockTimeoutArg(timeoutNs: int): string {
  if (timeoutNs <= 0) {
    return "0"
  }
  return blockSeconds(timeoutNs)
}

// A blocking pop runs on its own connection (`runBlocking`). A transaction
// attempt's pinned connection cannot wait, so `tx.read.zset(k)` refuses it.
fn blockRun<T>(runner: Runner, cmd: Cmd<T>, timeoutNs: int): T!RedisError {
  match (runner.client) {
    Some(c) => return runBlocking<T>(c, cmd, timeoutNs)?
    None => fail RedisError.Invalid("a blocking pop needs r.zset(key), not tx.read.zset(key)")
  }
}

// The immediate handle: `r.zset(key)` (pool-backed) and `tx.read.zset(key)`
// (pinned to a transaction attempt's connection).
export class Zset {
  runner: Runner
  key: string

  export add(member: string, score: f64): i64!RedisError {
    return this.runner.runCmd(addCmd(this.key, member, score, ZaddOptions{}))?
  }

  export addIf(member: string, score: f64, opts: ZaddOptions): i64!RedisError {
    return this.runner.runCmd(addCmd(this.key, member, score, opts))?
  }

  export addMany(...pairs: Scored): i64!RedisError {
    return this.runner.runCmd(addManyCmd(this.key, pairs))?
  }

  export incr(member: string, by: f64): f64!RedisError {
    return this.runner.runCmd(zaddIncrCmd(this.key, member, by))?
  }

  export incrBy(member: string, by: f64): f64!RedisError {
    return this.runner.runCmd(zincrByCmd(this.key, member, by))?
  }

  export score(member: string): Option<f64>!RedisError {
    return this.runner.runCmd(scoreCmd(this.key, member))?
  }

  export scores(...members: string): []Option<f64>!RedisError {
    return this.runner.runCmd(scoresCmd(this.key, members))?
  }

  export rank(member: string, fromTop: bool = true): Option<(i64, f64)>!RedisError {
    return this.runner.runCmd(rankCmd(this.key, member, fromTop))?
  }

  export card(): i64!RedisError {
    return this.runner.runCmd(cardCmd(this.key))?
  }

  export countByScore(min: Bound<f64>, max: Bound<f64>): i64!RedisError {
    return this.runner.runCmd(countByScoreCmd(this.key, min, max))?
  }

  export countByLex(min: Bound<string>, max: Bound<string>): i64!RedisError {
    return this.runner.runCmd(countByLexCmd(this.key, min, max))?
  }

  export top(n: i64): []Scored!RedisError {
    return this.runner.runCmd(rangeRankCmd(this.key, n, true))?
  }

  export bottom(n: i64): []Scored!RedisError {
    return this.runner.runCmd(rangeRankCmd(this.key, n, false))?
  }

  export byScore(min: Bound<f64>, max: Bound<f64>, limit: Limit): []Scored!RedisError {
    return this.runner.runCmd(rangeByScoreCmd(this.key, min, max, limit))?
  }

  export byLex(min: Bound<string>, max: Bound<string>, limit: Limit): []string!RedisError {
    return this.runner.runCmd(rangeByLexCmd(this.key, min, max, limit))?
  }

  export storeTop(dst: string, n: i64): i64!RedisError {
    return this.runner.runCmd(rangeStoreRankCmd(dst, this.key, n, true))?
  }

  export storeBottom(dst: string, n: i64): i64!RedisError {
    return this.runner.runCmd(rangeStoreRankCmd(dst, this.key, n, false))?
  }

  export storeByScore(dst: string, min: Bound<f64>, max: Bound<f64>, limit: Limit): i64!RedisError {
    return this.runner.runCmd(rangeStoreByScoreCmd(dst, this.key, min, max, limit))?
  }

  export storeByLex(
    dst: string,
    min: Bound<string>,
    max: Bound<string>,
    limit: Limit,
  ): i64!RedisError {
    return this.runner.runCmd(rangeStoreByLexCmd(dst, this.key, min, max, limit))?
  }

  export remove(...members: string): i64!RedisError {
    return this.runner.runCmd(removeCmd(this.key, members))?
  }

  export removeByRank(start: i64, stop: i64): i64!RedisError {
    return this.runner.runCmd(removeByRankCmd(this.key, start, stop))?
  }

  export removeByScore(min: Bound<f64>, max: Bound<f64>): i64!RedisError {
    return this.runner.runCmd(removeByScoreCmd(this.key, min, max))?
  }

  export removeByLex(min: Bound<string>, max: Bound<string>): i64!RedisError {
    return this.runner.runCmd(removeByLexCmd(this.key, min, max))?
  }

  export popMin(count: i64 = 1): []Scored!RedisError {
    return this.runner.runCmd(popMinCmd(this.key, count))?
  }

  export popMax(count: i64 = 1): []Scored!RedisError {
    return this.runner.runCmd(popMaxCmd(this.key, count))?
  }

  export popMinMany(count: i64 = 1): []Scored!RedisError {
    return this.runner.runCmd(popMinManyCmd(this.key, count))?
  }

  export popMaxMany(count: i64 = 1): []Scored!RedisError {
    return this.runner.runCmd(popMaxManyCmd(this.key, count))?
  }

  // This file's header: runs on a dedicated connection (`runBlocking`,
  // `cmd.bit`), never a pooled one.
  export blockPopMin(timeoutNs: int): Option<Scored>!RedisError {
    let cmd = blockPopMinCmd(this.key, timeoutNs)
    return blockRun<Option<Scored>>(this.runner, cmd, timeoutNs)?
  }

  export blockPopMax(timeoutNs: int): Option<Scored>!RedisError {
    let cmd = blockPopMaxCmd(this.key, timeoutNs)
    return blockRun<Option<Scored>>(this.runner, cmd, timeoutNs)?
  }

  export blockPopMinMany(count: i64, timeoutNs: int): []Scored!RedisError {
    let cmd = blockPopMinManyCmd(this.key, count, timeoutNs)
    return blockRun<[]Scored>(this.runner, cmd, timeoutNs)?
  }

  export blockPopMaxMany(count: i64, timeoutNs: int): []Scored!RedisError {
    let cmd = blockPopMaxManyCmd(this.key, count, timeoutNs)
    return blockRun<[]Scored>(this.runner, cmd, timeoutNs)?
  }

  export union(otherKeys: []string, weights: []f64, aggregate: Aggregate): []Scored!RedisError {
    return this.runner.runCmd(unionCmd(this.key, otherKeys, weights, aggregate))?
  }

  export inter(otherKeys: []string, weights: []f64, aggregate: Aggregate): []Scored!RedisError {
    return this.runner.runCmd(interCmd(this.key, otherKeys, weights, aggregate))?
  }

  export diff(otherKeys: []string): []Scored!RedisError {
    return this.runner.runCmd(diffCmd(this.key, otherKeys))?
  }

  export unionStore(
    dst: string,
    otherKeys: []string,
    weights: []f64,
    aggregate: Aggregate,
  ): i64!RedisError {
    return this.runner.runCmd(unionStoreCmd(dst, this.key, otherKeys, weights, aggregate))?
  }

  export interStore(
    dst: string,
    otherKeys: []string,
    weights: []f64,
    aggregate: Aggregate,
  ): i64!RedisError {
    return this.runner.runCmd(interStoreCmd(dst, this.key, otherKeys, weights, aggregate))?
  }

  export diffStore(dst: string, otherKeys: []string): i64!RedisError {
    return this.runner.runCmd(diffStoreCmd(dst, this.key, otherKeys))?
  }

  export randMember(): Option<string>!RedisError {
    return this.runner.runCmd(randMemberCmd(this.key))?
  }

  export randMembers(count: i64): []Scored!RedisError {
    return this.runner.runCmd(randMembersCmd(this.key, count))?
  }

  // `ZSCAN`, lazily — no queued counterpart on `ZsetBatch`: a cursor
  // iterator holds state across several round trips of its own, which does
  // not fit `Batch`'s "one queued command, one reply" shape at all
  // (`keys.bit`'s own scaffold note makes the identical call for `SCAN`).
  export scan(): ZsetScan {
    return ZsetScan{
      runner = this.runner,
      key = this.key,
      cursor = "0",
      page = []string(0),
      started = false,
    }
  }
}

// The queued view `Pipeline.zset`/`Tx.zset` both return — `cmd.bit`'s
// `Batch` is the ONE client-side queue the two executors share (`cmd.bit`'s
// header, point 2). A queued blocking command still shares its `Cmd<T>`
// factory with its immediate counterpart above; this file's header names
// the real gap in running one through `Pipeline`/`Tx` later.
export class ZsetBatch {
  batch: Batch
  key: string

  export add(member: string, score: f64): Future<i64> {
    return this.batch.queue(addCmd(this.key, member, score, ZaddOptions{}))
  }

  export addIf(member: string, score: f64, opts: ZaddOptions): Future<i64> {
    return this.batch.queue(addCmd(this.key, member, score, opts))
  }

  export addMany(...pairs: Scored): Future<i64> {
    return this.batch.queue(addManyCmd(this.key, pairs))
  }

  export incr(member: string, by: f64): Future<f64> {
    return this.batch.queue(zaddIncrCmd(this.key, member, by))
  }

  export incrBy(member: string, by: f64): Future<f64> {
    return this.batch.queue(zincrByCmd(this.key, member, by))
  }

  export score(member: string): Future<Option<f64>> {
    return this.batch.queue(scoreCmd(this.key, member))
  }

  export scores(...members: string): Future<[]Option<f64>> {
    return this.batch.queue(scoresCmd(this.key, members))
  }

  export rank(member: string, fromTop: bool = true): Future<Option<(i64, f64)>> {
    return this.batch.queue(rankCmd(this.key, member, fromTop))
  }

  export card(): Future<i64> { return this.batch.queue(cardCmd(this.key)) }

  export countByScore(min: Bound<f64>, max: Bound<f64>): Future<i64> {
    return this.batch.queue(countByScoreCmd(this.key, min, max))
  }

  export countByLex(min: Bound<string>, max: Bound<string>): Future<i64> {
    return this.batch.queue(countByLexCmd(this.key, min, max))
  }

  export top(n: i64): Future<[]Scored> { return this.batch.queue(rangeRankCmd(this.key, n, true)) }

  export bottom(n: i64): Future<[]Scored> {
    return this.batch.queue(rangeRankCmd(this.key, n, false))
  }

  export byScore(min: Bound<f64>, max: Bound<f64>, limit: Limit): Future<[]Scored> {
    return this.batch.queue(rangeByScoreCmd(this.key, min, max, limit))
  }

  export byLex(min: Bound<string>, max: Bound<string>, limit: Limit): Future<[]string> {
    return this.batch.queue(rangeByLexCmd(this.key, min, max, limit))
  }

  export storeTop(dst: string, n: i64): Future<i64> {
    return this.batch.queue(rangeStoreRankCmd(dst, this.key, n, true))
  }

  export storeBottom(dst: string, n: i64): Future<i64> {
    return this.batch.queue(rangeStoreRankCmd(dst, this.key, n, false))
  }

  export storeByScore(dst: string, min: Bound<f64>, max: Bound<f64>, limit: Limit): Future<i64> {
    return this.batch.queue(rangeStoreByScoreCmd(dst, this.key, min, max, limit))
  }

  export storeByLex(
    dst: string,
    min: Bound<string>,
    max: Bound<string>,
    limit: Limit,
  ): Future<i64> {
    return this.batch.queue(rangeStoreByLexCmd(dst, this.key, min, max, limit))
  }

  export remove(...members: string): Future<i64> {
    return this.batch.queue(removeCmd(this.key, members))
  }

  export removeByRank(start: i64, stop: i64): Future<i64> {
    return this.batch.queue(removeByRankCmd(this.key, start, stop))
  }

  export removeByScore(min: Bound<f64>, max: Bound<f64>): Future<i64> {
    return this.batch.queue(removeByScoreCmd(this.key, min, max))
  }

  export removeByLex(min: Bound<string>, max: Bound<string>): Future<i64> {
    return this.batch.queue(removeByLexCmd(this.key, min, max))
  }

  export popMin(count: i64 = 1): Future<[]Scored> {
    return this.batch.queue(popMinCmd(this.key, count))
  }

  export popMax(count: i64 = 1): Future<[]Scored> {
    return this.batch.queue(popMaxCmd(this.key, count))
  }

  export popMinMany(count: i64 = 1): Future<[]Scored> {
    return this.batch.queue(popMinManyCmd(this.key, count))
  }

  export popMaxMany(count: i64 = 1): Future<[]Scored> {
    return this.batch.queue(popMaxManyCmd(this.key, count))
  }

  export blockPopMin(timeoutNs: int): Future<Option<Scored>> {
    return this.batch.queue(blockPopMinCmd(this.key, timeoutNs))
  }

  export blockPopMax(timeoutNs: int): Future<Option<Scored>> {
    return this.batch.queue(blockPopMaxCmd(this.key, timeoutNs))
  }

  export blockPopMinMany(count: i64, timeoutNs: int): Future<[]Scored> {
    return this.batch.queue(blockPopMinManyCmd(this.key, count, timeoutNs))
  }

  export blockPopMaxMany(count: i64, timeoutNs: int): Future<[]Scored> {
    return this.batch.queue(blockPopMaxManyCmd(this.key, count, timeoutNs))
  }

  export union(otherKeys: []string, weights: []f64, aggregate: Aggregate): Future<[]Scored> {
    return this.batch.queue(unionCmd(this.key, otherKeys, weights, aggregate))
  }

  export inter(otherKeys: []string, weights: []f64, aggregate: Aggregate): Future<[]Scored> {
    return this.batch.queue(interCmd(this.key, otherKeys, weights, aggregate))
  }

  export diff(otherKeys: []string): Future<[]Scored> {
    return this.batch.queue(diffCmd(this.key, otherKeys))
  }

  export unionStore(
    dst: string,
    otherKeys: []string,
    weights: []f64,
    aggregate: Aggregate,
  ): Future<i64> {
    return this.batch.queue(unionStoreCmd(dst, this.key, otherKeys, weights, aggregate))
  }

  export interStore(
    dst: string,
    otherKeys: []string,
    weights: []f64,
    aggregate: Aggregate,
  ): Future<i64> {
    return this.batch.queue(interStoreCmd(dst, this.key, otherKeys, weights, aggregate))
  }

  export diffStore(dst: string, otherKeys: []string): Future<i64> {
    return this.batch.queue(diffStoreCmd(dst, this.key, otherKeys))
  }

  export randMember(): Future<Option<string>> { return this.batch.queue(randMemberCmd(this.key)) }

  export randMembers(count: i64): Future<[]Scored> {
    return this.batch.queue(randMembersCmd(this.key, count))
  }
}

// `r.zset(key).scan()`'s lazy cursor, one `ZSCAN` page at a time.
// `next(): Option<Scored>!` is the fallible iterator shape
// (docs/development/iterator-trait.md, same as `HashScanIterator`): a page
// fetch that fails (network, timeout, server error) or a score that does
// not parse comes back as the error, so the loop is written `for x of it?`.
// `page` is `ZSCAN`'s flat member, score, member, score, ... array.
export class ZsetScan {
  runner: Runner
  key: string
  cursor: string
  page: []string
  started: bool

  export next(): Option<Scored>! {
    while (len(this.page) == 0 && (!this.started || this.cursor != "0")) {
      this.fetch()?
    }
    if (len(this.page) == 0) {
      return Option.None
    }
    let score = parseFloat(this.page[1])
    if (score != score) {
      fail RedisError.Unexpected("ZSCAN", "Bulk")
    }
    let item = Scored{ member = this.page[0], score = score }
    this.page = this.page[2:len(this.page)]
    return Option.Some(item)
  }

  fetch(): ()!RedisError {
    this.started = true
    let (cursor, items) = this.runner.runCmd(zscanCmd(this.key, this.cursor))?
    if (len(items) % 2 != 0) {
      fail RedisError.Unexpected("ZSCAN", "Array")
    }
    this.cursor = cursor
    this.page = items
  }
}
