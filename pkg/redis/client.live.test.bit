// pkg/redis/client.live.test.bit — the acceptance that needs a real server
// (#6021, epic #6013). Same model as pkg/postgres/live.test.bit: EACH TEST IS
// SKIPPED WHEN ITS URL IS UNSET, and says so — this file also runs whenever
// `bit test pkg/redis` or `./make test-package-redis` does, on a machine with
// no Docker at all, so a hard dependency on a live server would make those
// unrunnable. `./make test-package-redis-live`
// (tools/build/gatestable2.bit, _tests_/bit/redislive.bit) is what actually
// supplies REDIS_TEST_URL / REDIS_TEST_TLS_URL, by provisioning a throwaway
// Docker container itself rather than depending on one someone else started.
//
// Today's `Client` (client.bit) has no built-in AUTH or TLS — that is #6022's
// scope. This file authenticates through the generic `command()` escape
// hatch instead (`authed` below) and only exercises PING/SET/GET, over plain
// TCP. REDIS_TEST_TLS_URL is provisioned by the gate already (it starts the
// TLS container so the wait-for-ready path is proven end to end) but is not
// yet dialled from here — there is no TLS-capable `Client` to dial with
// until #6022 lands one; the env var name is stable so a TLS test slots in
// later with no gate change.

import { env } from "std/os"
import { hasPrefix, lastIndexOf } from "std/strings"

// The three fields `test-package-redis-live` ever encodes into its URL:
// "redis://:PASSWORD@HOST:PORT". Not a general URL parser — #6022 owns that.
class liveTarget {
  host: string,
  port: int,
  password: string,
}

// The value of `name`, or "" — printed once so a skipped run is visible as a
// skip rather than as a silent pass (pkg/postgres/live.test.bit's own
// `liveUri`).
fn liveUrl(name: string): string {
  let u = env(name)
  if (u == "") {
    print("  skipped: ${name} is unset, no live server to talk to\n")
  }
  return u
}

// `parseInt` is not imported here: resp.bit's own `import { indexOf,
// parseInt } from "std/strings"` already binds it module-wide (SPEC
// §17.1) — importing it again from a `.test.bit` file would duplicate that
// declaration (E0042).
fn parseLiveUrl(u: string): liveTarget {
  if (!hasPrefix(u, "redis://:")) {
    panic("live url '${u}' is not 'redis://:PASSWORD@HOST:PORT'")
  }
  let rest = u[9:]
  let at = lastIndexOf(rest, "@")
  if (at < 0) {
    panic("live url '${u}' has no '@' separating the password from host:port")
  }
  let password = rest[0:at]
  let hostport = rest[at + 1:]
  let colon = lastIndexOf(hostport, ":")
  if (colon < 0) {
    panic("live url '${u}' has no ':port'")
  }
  let host = hostport[0:colon]
  let port = parseInt(hostport[colon + 1:]) catch e {
    panic("live url '${u}': ${e.message()}")
  }
  return liveTarget{ host = host, port = port, password = password }
}

// Authenticates `c` with `AUTH password` over the generic `command()` escape
// hatch — the only route available before #6022's `Client` gains its own.
fn authed(c: Client, password: string): Client {
  let r = c.command(["AUTH", password]) catch e {
    panic("AUTH: ${e.message()}")
  }
  match (r) {
    Simple(s) => {
      if (s != "OK") {
        panic("AUTH: unexpected reply '${s}'")
      }
    }
    _ => panic("AUTH: unexpected reply type")
  }
  return c
}

fn liveClient(t: liveTarget): Client {
  let c = connect(t.host, t.port) catch e {
    panic("connect(${t.host}:${t.port}): ${e.message()}")
  }
  return authed(c, t.password)
}

test "live: PING replies PONG" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(parseLiveUrl(u))
  let pong = c.ping() catch e {
    panic("ping: ${e.message()}")
  }
  assert(pong == "PONG", "PING replied '${pong}'")
  c.close()
}

test "live: SET then GET round-trips a value" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(parseLiveUrl(u))
  c.set("bit:live:client", "hello-live") catch e {
    panic("set: ${e.message()}")
  }
  let got = c.get("bit:live:client") catch e {
    panic("get: ${e.message()}")
  }
  match (got) {
    Some(v) => assert(v == "hello-live", "GET returned '${v}'")
    None => panic("GET returned no value for a key just SET")
  }
  c.close()
}

test "live: GET on a missing key returns no value, not an empty one" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(parseLiveUrl(u))
  c.del(["bit:live:missing"]) catch e {
    panic("del: ${e.message()}")
  }
  let got = c.get("bit:live:missing") catch e {
    panic("get: ${e.message()}")
  }
  match (got) {
    Some(v) => panic("GET on a missing key returned Some('${v}')")
    None => {}
  }
  c.close()
}
