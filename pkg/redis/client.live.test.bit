// pkg/redis/client.live.test.bit — the acceptance that needs a real server
// (#6021/#6022, epic #6013). Same model as pkg/postgres/live.test.bit: EACH
// TEST IS SKIPPED WHEN ITS URL IS UNSET, and says so — this file also runs
// whenever `bit test pkg/redis` or `./make test-package-redis` does, on a
// machine with no Docker at all, so a hard dependency on a live server would
// make those unrunnable. `./make test-package-redis-live`
// (tools/build/gatestable2.bit, _tests_/bit/redislive.bit) is what actually
// supplies REDIS_TEST_URL / REDIS_TEST_TLS_URL, by provisioning a throwaway
// Docker container itself rather than depending on one someone else started.
//
// `REDIS_TEST_URL`/`REDIS_TEST_TLS_URL` ARE ALREADY THIS PACKAGE'S OWN URL
// FORM (`redis://:PASSWORD@HOST:PORT` / `rediss://...`), so every test below
// goes through the real public entry point, `open`, rather than a
// file-local URL parser.
//
// TLS CERTIFICATE VERIFICATION: `REDIS_TEST_TLS_URL`'s server presents a
// self-signed leaf with no path to a public root, so `open` on it (default
// verification) is expected to FAIL — proven by "live: TLS with default
// verification rejects the self-signed certificate" below — and the
// positive TLS path connects with `insecureSkipVerify` instead
// (`tlsInsecure` below). Verifying against the actual self-signed CA
// (`Options.tlsRootCa`) needs the harness to hand this file the CA PEM it
// generated, which `_tests_/bit/redislive.bit` does not do yet — filed as a
// follow-up rather than threaded through here.

import { env } from "std/os"

// The value of `name`, or "" — printed once so a skipped run is visible as a
// skip rather than as a silent pass (pkg/postgres/live.test.bit's own
// `liveUri`).
fn liveUrl(name: string): string {
  let u = env(name)
  if (u == "") {
    print("  skipped: ${name} is unset, no live server to talk to\n")
  }
  return u
}

fn liveClient(u: string): Client {
  return open(u) catch e {
    panic("open(${u}): ${e.message()}")
  }
}

// `open`'s URL with `db` set to 1 — proves `SELECT` runs during `connect`
// (`conn.bit`'s `handshake`), by writing to a different keyspace than the
// bare URL's db 0.
fn withDb1(u: string): string {
  return "${u}/1"
}

// `u` with its password corrupted — proves the server, not this package,
// rejected the credentials, and that the failure is `RedisError.WrongPass`.
fn withWrongPassword(u: string): string {
  let at = lastIndexOf(u, "@")
  panicIf(at < 0, "live url '${u}' has no '@' separating credentials from host:port")
  let colon = lastIndexOf(u[0:at], ":")
  panicIf(colon < 0, "live url '${u}' has no ':password'")
  return u[0:colon + 1] + "not-the-password" + u[at:len(u)]
}

fn panicIf(cond: bool, msg: string) {
  if (cond) {
    panic(msg)
  }
}

test "live: PING replies PONG" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let pong = c.ping() catch e {
    panic("ping: ${e.message()}")
  }
  assert(pong == "PONG", "PING replied '${pong}'")
  c.close()
}

test "live: SET then GET round-trips a value" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  c.set("bit:live:client", "hello-live") catch e {
    panic("set: ${e.message()}")
  }
  let got = c.get("bit:live:client") catch e {
    panic("get: ${e.message()}")
  }
  match (got) {
    Some(v) => assert(v == "hello-live", "GET returned '${v}'")
    None => panic("GET returned no value for a key just SET")
  }
  c.close()
}

test "live: INFO server decodes the RESP3 verbatim reply as text" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let server = c.info(InfoSection.Server) catch e {
    panic("info: ${e.message()}")
  }
  assert(contains(server, "redis_version:"), "INFO server has no redis_version: '${server}'")
  let all = c.info() catch e {
    panic("info: ${e.message()}")
  }
  assert(contains(all, "redis_version:"), "plain INFO has no redis_version: '${all}'")
  let keyspace = c.info(InfoSection.Keyspace) catch e {
    panic("info: ${e.message()}")
  }
  assert(
    contains(keyspace, "# Keyspace"),
    "INFO keyspace has no '# Keyspace' header: '${keyspace}'",
  )
  c.close()
}

test "live: GET on a missing key returns no value, not an empty one" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  c.del(["bit:live:missing"]) catch e {
    panic("del: ${e.message()}")
  }
  let got = c.get("bit:live:missing") catch e {
    panic("get: ${e.message()}")
  }
  match (got) {
    Some(v) => panic("GET on a missing key returned Some('${v}')")
    None => {}
  }
  c.close()
}

test "live: a wrong password fails with RedisError.WrongPass" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let bad = withWrongPassword(u)
  let c = open(bad) catch e {
    match (e) {
      WrongPass(_) => return
      _ => panic("open with a wrong password: expected RedisError.WrongPass, got: ${e.message()}")
    }
  }
  c.close()
  panic("open connected with a wrong password")
}

test "live: SELECT isolates db 1 from db 0" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let key = "bit:live:select"
  let base = liveClient(u)
  base.del([key]) catch e {
    panic("del: ${e.message()}")
  }
  base.close()

  let db1 = liveClient(withDb1(u))
  db1.set(key, "db1-value") catch e {
    panic("set on db 1: ${e.message()}")
  }
  db1.close()

  let db0 = liveClient(u)
  let got = db0.get(key) catch e {
    panic("get on db 0: ${e.message()}")
  }
  db0.close()
  match (got) {
    Some(v) => panic("db 0 saw db 1's key: '${v}'")
    None => {}
  }
}

test "live: a command past commandTimeout fails with RedisError.Timeout" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let opts = parseUrl(u) catch e {
    panic("parseUrl(${u}): ${e.message()}")
  }
  opts.commandTimeout = 100000000
  let c = connect(opts) catch e {
    panic("connect: ${e.message()}")
  }
  c.command(["DEBUG", "SLEEP", "1"]) catch e {
    match (e) {
      Timeout => {}
      _ => panic("DEBUG SLEEP past commandTimeout: expected RedisError.Timeout, got: ${e.message()}")
    }
    Reply.Null
  }
  c.close()
}

test "live: a killed connection is transparently reconnected on the next read" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let opts = parseUrl(u) catch e {
    panic("parseUrl(${u}): ${e.message()}")
  }
  opts.poolSize = 1
  let c = connect(opts) catch e {
    panic("connect: ${e.message()}")
  }
  c.ping() catch e {
    panic("warm-up ping: ${e.message()}")
  }
  let idReply = c.command(["CLIENT", "ID"]) catch e {
    panic("CLIENT ID: ${e.message()}")
  }
  let id = replyInt(idReply)

  let admin = liveClient(u)
  admin.command(["CLIENT", "KILL", "ID", "${id}"]) catch e {
    panic("CLIENT KILL ID ${id}: ${e.message()}")
  }
  admin.close()

  let pong = c.ping() catch e {
    panic("ping after CLIENT KILL: expected a transparent reconnect, got: ${e.message()}")
  }
  assert(pong == "PONG", "PING after reconnect replied '${pong}'")
  c.close()
}

fn replyInt(r: Reply): i64 {
  match (r) {
    Int(n) => return n
    _ => panic("expected an Int reply")
  }
}

// #6028's architecture acceptance: a pipelined batch sends once (one write
// of all 3 commands, one read of all 3 replies) and each `Future<T>`
// decodes its own reply correctly.
test "live: a 3-command pipeline sends once and each Future decodes its own reply" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:pipeline"
  c.del([key]) catch e {
    panic("del: ${e.message()}")
  }

  let p = c.pipeline()
  let setF = p.set(key, "pipelined")
  let getF = p.get(key)
  let existsF = p.exists([key])
  p.exec() catch e {
    panic("pipeline exec: ${e.message()}")
  }

  setF.get() catch e {
    panic("pipelined set: ${e.message()}")
  }
  let got = getF.get() catch e {
    panic("pipelined get: ${e.message()}")
  }
  match (got) {
    Some(v) => assert(v == "pipelined", "pipelined GET returned '${v}'")
    None => panic("pipelined GET returned no value")
  }
  let n = existsF.get() catch e {
    panic("pipelined exists: ${e.message()}")
  }
  assert(n == 1, "pipelined EXISTS returned ${n}")
  c.close()
}

// A small mutable counter a transaction body captures across retries — a
// class (a reference type) so the object the closure holds a pointer to,
// not the closure's own capture, is what changes.
class attemptCounter { n: i64 }

// #6028's architecture acceptance: WATCH detects a real conflict (a second
// client changing the watched key), EXEC comes back nil, `Client.transaction`
// retries — succeeding and committing on the second attempt — and the
// `Future<Option<string>>` `body` returned reads the COMMITTED transaction's
// value once `transaction` returns, not a discarded first attempt's.
// Deterministic, not a network race: `body` runs after this attempt's WATCH
// and before its MULTI (`tx.bit`'s header), so the conflicting write —
// issued synchronously, inline, in `body` itself — is guaranteed to have
// already happened by the time EXEC runs.
test "live: transaction retries once after a WATCH conflict, then its Future reads the committed value" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let admin = liveClient(u)
  let key = "bit:live:tx:balance"
  c.set(key, "100") catch e {
    panic("set: ${e.message()}")
  }

  let attempts = attemptCounter{ n = 0 }
  let f = c.transaction<Future<Option<string>>>([key], (tx) => {
    attempts.n = attempts.n + 1
    if (attempts.n == 1) {
      // Forces THIS attempt's WATCH conflict: changes the watched key from
      // a SECOND connection, synchronously, before this attempt's MULTI is
      // ever sent.
      admin.set(key, "999") catch e {
        panic("conflicting set: ${e.message()}")
      }
    }
    return tx.get(key)
  }) catch e {
    panic("transaction: ${e.message()}")
  }

  assert(
    attempts.n == 2,
    "expected exactly one retry after the conflict, got ${attempts.n} attempts",
  )
  let got = f.get() catch e {
    panic("committed transaction's Future: ${e.message()}")
  }
  match (got) {
    Some(v) => assert(v == "999", "committed transaction's Future read '${v}', want '999'")
    None => panic("committed transaction's Future read no value")
  }
  admin.close()
  c.close()
}

// A flag a `catch` block sets to prove control actually passed through it —
// `attemptCounter`'s own shape, a class so the closure's write is visible
// to the code that reads it after.
class boolBox { hit: bool }

// #6029's acceptance: a real check-and-set transfer. `tx.read.counter
// (from).get()` reads the sender's balance NOW, on this attempt's own
// pinned connection (never queued, unlike `tx.counter(...)`), while a
// second connection's conflicting write forces this attempt's EXEC to come
// back nil — same deterministic mechanism as the WATCH-conflict test
// above (`tx.bit`'s header: `body` runs inside the WATCH..MULTI window).
// The retried attempt re-reads the balance the conflicting write actually
// left behind, so the committed transfer is computed off the CURRENT
// balance, not the stale one the first attempt saw.
test "live: a two-account transfer reads the balance via tx.read, retries once after a conflicting write, and commits the correct result" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let admin = liveClient(u)
  let from = "bit:live:tx:transfer:from"
  let to = "bit:live:tx:transfer:to"
  let amount = i64(30)
  c.set(from, "100") catch e {
    panic("set from: ${e.message()}")
  }
  c.set(to, "50") catch e {
    panic("set to: ${e.message()}")
  }

  let attempts = attemptCounter{ n = 0 }
  let (debitF, creditF) = c.transaction<(Future<i64>, Future<i64>)>([from, to], (tx) => {
    attempts.n = attempts.n + 1
    let balance = tx.read.counter(from).get()?
    if (attempts.n == 1) {
      // Forces THIS attempt's WATCH conflict on `from`, from a second
      // connection, synchronously, before this attempt's MULTI is ever
      // sent — #6028's own WATCH-conflict test's exact mechanism.
      admin.set(from, "999") catch e {
        panic("conflicting set: ${e.message()}")
      }
    }
    if (balance < amount) {
      fail RedisError.Unexpected("transfer", "insufficient funds")
    }
    let debit = tx.counter(from).decrBy(amount)
    let credit = tx.counter(to).incrBy(amount)
    return debit, credit
  }) catch e {
    panic("transaction: ${e.message()}")
  }

  assert(
    attempts.n == 2,
    "expected exactly one retry after the conflict, got ${attempts.n} attempts",
  )
  let debited = debitF.get() catch e {
    panic("debit future: ${e.message()}")
  }
  let credited = creditF.get() catch e {
    panic("credit future: ${e.message()}")
  }
  assert(debited == 969, "debited balance = ${debited}, want 969 (999 - 30)")
  assert(credited == 80, "credited balance = ${credited}, want 80 (50 + 30)")
  admin.close()
  c.close()
}

// #6029's acceptance: a check-and-set read that makes `body` fail — the
// exact error `body` raised surfaces from `transaction()` unchanged
// (`tx.bit`'s catch-and-UNWATCH path re-`fail`s `e` as-is), and the failed
// attempt's `WATCH` was cleared (`UNWATCH`), not left dangling on the
// pooled connection. Proved by reusing the SAME connection (`poolSize = 1`)
// for a second, unrelated transaction: if the first attempt's `WATCH` on
// `watched` were still in effect, `admin`'s later write to `watched` would
// spuriously conflict the second transaction's EXEC even though it never
// touches `watched` itself (`tx.bit`'s header, "the NEXT caller to lease it
// would silently inherit stale watched keys").
test "live: a check-and-set read that fails body sends UNWATCH and surfaces the error unchanged" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let opts = parseUrl(u) catch e {
    panic("parseUrl(${u}): ${e.message()}")
  }
  opts.poolSize = 1
  let c = connect(opts) catch e {
    panic("connect: ${e.message()}")
  }
  let admin = liveClient(u)
  let watched = "bit:live:tx:unwatch:watched"
  let other = "bit:live:tx:unwatch:other"
  c.set(watched, "5") catch e {
    panic("set watched: ${e.message()}")
  }
  c.set(other, "0") catch e {
    panic("set other: ${e.message()}")
  }

  let sawErr = boolBox{ hit = false }
  c.transaction<bool>([watched], (tx) => {
    let balance = tx.read.counter(watched).get()?
    if (balance < 1000) {
      fail RedisError.Unexpected("transfer", "insufficient funds")
    }
    return true
  }) catch e {
    sawErr.hit = true
    match (e) {
      Unexpected(cmd, detail) => {
        assert(cmd == "transfer", "failed body's error command = '${cmd}', want 'transfer'")
        assert(
          detail == "insufficient funds",
          "failed body's error detail = '${detail}', want 'insufficient funds'",
        )
      }
      _ => panic("expected RedisError.Unexpected(\"transfer\", \"insufficient funds\"), got: ${e.message()}")
    }
    false
  }
  assert(sawErr.hit, "expected the check-and-set transaction to fail with insufficient funds")

  admin.set(watched, "6") catch e {
    panic("admin set watched: ${e.message()}")
  }
  let attempts = attemptCounter{ n = 0 }
  c.transaction<bool>([other], (tx) => {
    attempts.n = attempts.n + 1
    tx.counter(other).incr()
    return true
  }) catch e {
    panic("second transaction: ${e.message()}")
  }
  assert(
    attempts.n == 1,
    "second transaction retried ${attempts.n} time(s); a stale WATCH from the failed body's connection would force a retry",
  )
  admin.close()
  c.close()
}

// #7434: a poolSize=1 client, so the very connection a failed transaction
// used is the one the next command gets. The server rejects the queued
// command at queue time (`GET` with no key: wrong number of arguments), which
// used to leave MULTI open on the pooled connection and answer the next
// `ping()` with `+QUEUED`. The queued `SET` must not have run either: DISCARD
// dropped it.
test "live: a transaction whose queued command is rejected leaves a clean pooled connection" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let opts = parseUrl(u) catch e {
    panic("parseUrl(${u}): ${e.message()}")
  }
  opts.poolSize = 1
  let c = connect(opts) catch e {
    panic("connect: ${e.message()}")
  }
  let key = "bit:live:tx:reject"
  c.del([key]) catch e {
    panic("del: ${e.message()}")
  }
  let failed = boolBox{ hit = false }
  c.transaction<bool>([key], (tx) => {
    let _ = tx.set(key, "must-not-be-written")
    let _ = tx.queue(Cmd<Reply>{ args = ["GET"], decode = (r) => r, readOnly = true })
    return true
  }) catch _ {
    failed.hit = true
    false
  }
  assert(failed.hit, "a queue-time rejection must fail the transaction")
  let pong = c.ping() catch e {
    panic("ping after the failed transaction: ${e.message()}")
  }
  assert(pong == "PONG", "ping read '${pong}', want PONG")
  let v = c.get(key) catch e {
    panic("get: ${e.message()}")
  }
  match (v) {
    Some(s) => panic("the discarded transaction wrote '${s}'")
    None => {}
  }
  c.close()
}

// #7434: the same poolSize=1 shape for the WATCH-conflict path: a nil EXEC
// retries on the one connection, and after the commit the connection answers
// a plain command with its own reply.
test "live: a WATCH conflict on a single-connection pool leaves the connection in step" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let opts = parseUrl(u) catch e {
    panic("parseUrl(${u}): ${e.message()}")
  }
  opts.poolSize = 1
  let c = connect(opts) catch e {
    panic("connect: ${e.message()}")
  }
  let admin = liveClient(u)
  let key = "bit:live:tx:conflict"
  c.set(key, "1") catch e {
    panic("set: ${e.message()}")
  }
  let attempts = attemptCounter{ n = 0 }
  c.transaction<bool>([key], (tx) => {
    attempts.n = attempts.n + 1
    if (attempts.n == 1) {
      admin.set(key, "2") catch e {
        panic("conflicting set: ${e.message()}")
      }
    }
    tx.counter(key).incr()
    return true
  }) catch e {
    panic("transaction: ${e.message()}")
  }
  assert(attempts.n == 2, "expected one retry after the conflict, got ${attempts.n} attempts")
  let pong = c.ping() catch e {
    panic("ping after the conflicted transaction: ${e.message()}")
  }
  assert(pong == "PONG", "ping read '${pong}', want PONG")
  let v = c.get(key) catch e {
    panic("get: ${e.message()}")
  }
  match (v) {
    Some(s) => assert(s == "3", "key = '${s}', want '3' (2 from the conflict, +1 committed)")
    None => panic("key vanished")
  }
  admin.close()
  c.close()
}
