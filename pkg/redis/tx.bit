// pkg/redis/tx.bit — `r.transaction(keys, (tx) => { ... })`: WATCH every
// key, MULTI, run `body` to queue commands server-side, EXEC. Retried on a
// nil EXEC (a WATCHed key changed between WATCH and EXEC — Redis's own
// optimistic-lock conflict signal) up to a bounded count. Epic #6013,
// #6028.
//
// `Tx.queue` IS NOT `Pipeline.queue`: inside MULTI, Redis does not RUN a
// queued command at all, only acknowledges it with `+QUEUED` — the real
// result is only known once `EXEC` commits, as one reply per queued
// command, in order. `Tx` has nothing typed to hand back mid-transaction,
// so `queue<T>` returns `()!RedisError`, failing only if the server refused
// to queue the command at all (a syntax error, `WRONGTYPE` is still
// possible pre-EXEC for some commands). A family wanting its typed result
// back reads it from `EXEC`'s own reply array after `transaction` returns —
// out of scope for this ticket (#6028 ships the plain commands only: get,
// set, del, exists, expire, ping, none of which a caller needs a value back
// from INSIDE the transaction body for).

const maxTxRetries: int = 10

// One command queued inside a transaction body. Every family's queued view
// calls this with the SAME `Cmd<T>` its `Client`/`Pipeline` methods use
// (`cmd.bit`'s header) — only the executor differs, never the command.
export class Tx {
  conn: redisConn
  timeoutNs: int

  export queue<T>(cmd: Cmd<T>): ()!RedisError {
    writeCommand(this.conn, cmd.args, this.timeoutNs)?
    let r = readOneReply(this.conn, this.timeoutNs)?
    match (r) {
      Simple(s) => return expectQueued(s, cmd.args[0])?
      _ => fail RedisError.Unexpected(cmd.args[0], shapeName(r))
    }
  }

  export get(key: string): ()!RedisError {
    return this.queue(getCmd(key))?
  }

  export set(key: string, value: string): ()!RedisError {
    return this.queue(setCmd(key, value))?
  }

  export del(keys: []string): ()!RedisError {
    return this.queue(delCmd(keys))?
  }

  export exists(keys: []string): ()!RedisError {
    return this.queue(existsCmd(keys))?
  }

  export expire(key: string, seconds: i64): ()!RedisError {
    return this.queue(expireCmd(key, seconds))?
  }
}

fn expectQueued(s: string, cmdName: string): ()!RedisError {
  if (s != "QUEUED") {
    fail RedisError.Protocol("redis: ${cmdName}: expected +QUEUED, got '${s}'")
  }
}

// `Client.transaction`'s body — retries a fresh WATCH/MULTI/body/EXEC
// attempt up to `maxTxRetries` times, only when the conflict was a nil
// EXEC. Any other failure (a transport error, a `body` failure) propagates
// immediately, never retried — see `runTxAttempt`'s own DISCARD note.
fn runTransaction(client: Client, keys: []string, body: (Tx) => ()!RedisError): ()!RedisError {
  let attempt = 0
  while (attempt < maxTxRetries) {
    let committed = client.withConn<bool>((conn) => {
      return runTxAttempt(conn, client.opts.commandTimeout, keys, body)?
    })?
    if (committed) {
      return
    }
    attempt = attempt + 1
  }
  fail RedisError.ExecAbort("transaction: exceeded ${maxTxRetries} retries after WATCH conflicts")
}

// One WATCH/MULTI/body/EXEC attempt over `conn`. `true` when EXEC
// committed; `false` only for a nil EXEC reply, so the caller retries with
// a fresh WATCH. A `body` failure DISCARDs this attempt's queued MULTI
// before propagating, so a half-queued transaction never leaks into a
// retry.
fn runTxAttempt(
  conn: redisConn,
  timeoutNs: int,
  keys: []string,
  body: (Tx) => ()!RedisError,
): bool!RedisError {
  writeCommand(conn, withKeys("WATCH", keys), timeoutNs)?
  readOneReply(conn, timeoutNs)?
  writeCommand(conn, ["MULTI"], timeoutNs)?
  readOneReply(conn, timeoutNs)?
  let tx = Tx{ conn = conn, timeoutNs = timeoutNs }
  body(tx) catch e {
    writeCommand(conn, ["DISCARD"], timeoutNs)?
    readOneReply(conn, timeoutNs)?
    fail e
  }
  writeCommand(conn, ["EXEC"], timeoutNs)?
  let r = readOneReply(conn, timeoutNs)?
  return execCommitted(r)?
}

// A conflicting EXEC is `*-1\r\n` on RESP2 (`Reply.Array(Option.None)`) but
// the unified `_\r\n` on RESP3 (`Reply.Null`) — the same RESP2/RESP3 split
// `client.bit`'s `get()` already documents for a missing `GET`, proved live
// here too (#6028's own live gate caught this: RESP3 is this package's
// default protocol, so the RESP2 shape alone was never actually exercised).
fn execCommitted(r: Reply): bool!RedisError {
  match (r) {
    Array(items) => return committedOpt(items)
    Null => return false
    _ => fail RedisError.Unexpected("EXEC", shapeName(r))
  }
}

fn committedOpt(items: Option<[]Reply>): bool {
  match (items) {
    Some(_) => return true
    None => return false
  }
}
