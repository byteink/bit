// pkg/redis/tx.bit — `r.transaction(keys, (tx) => { ... })`: WATCH every
// key, run `body` to queue commands into a `Batch` (`cmd.bit`) client-side,
// MULTI, send every queued command, EXEC. Retried on a nil EXEC (a WATCHed
// key changed between WATCH and EXEC — Redis's own optimistic-lock
// conflict signal) up to a bounded count. Epic #6013, #6028.
//
// WHY `body` RUNS AFTER WATCH, NOT BEFORE: `Tx.queue`/every flat/family
// method never touches the network itself (`this.batch.queue`, the exact
// mechanism `Pipeline` also uses — `cmd.bit`'s header, point 2) — but
// `body` is still invoked from INSIDE the leased connection's WATCH..EXEC
// window (`runTxAttempt` below), after WATCH and before MULTI. That is
// what makes a live conflict test deterministic rather than a network
// race: `body` runs synchronous Bit code, so a caller that does its own
// (separate-connection) conflicting write FROM WITHIN `body` is guaranteed
// to have completed it before this attempt's MULTI/EXEC are ever sent —
// no `spawn`, no timing window to land in.
//
// A FRESH `Batch` (AND A FRESH `Tx`) PER ATTEMPT is the whole answer to "a
// retried attempt must not leak a stale Future": `runTxAttempt` calls
// `body` again on every retry, over a brand-new `Batch`/`box`, and hands
// back `(result, committed)` for THAT attempt only. `runTransaction` below
// returns `result` to the caller ONLY from the iteration whose `committed`
// came back `true` — never a cached result from an earlier, abandoned
// attempt — so a discarded attempt's `Future`s are never reachable through
// the public API at all, not merely "still there but stale".
//
// A `body` FAILURE SENDS `UNWATCH`, NEVER `MULTI`: `body` runs before
// `MULTI`, so there is nothing queued server-side to `DISCARD` yet: only
// the `WATCH` needs clearing before the connection goes back to the pool,
// or the NEXT caller to lease it would silently inherit stale watched
// keys. A failure AFTER `MULTI` (the server rejected a queued command, or
// answered something other than `+QUEUED`) sends `DISCARD` instead, which
// also clears the WATCH: otherwise the next caller's command would be queued
// into the old MULTI and answered `+QUEUED` (`abortTx`, #7434).
//
// `tx.read` (#6029): real check-and-set ("read balance, fail if
// insufficient, else decrement") needs a read INSIDE `body` that runs now,
// synchronously, on THIS attempt's own pinned connection — `tx.counter(k)`
// only ever QUEUES. `TxRead` exposes the identical immediate handles
// `Client` does (`Counter`, ...), built over a `pinnedRunner` on `conn`
// instead of a `poolRunner` (`cmd.bit`'s header) — `tx.read.counter(k)
// .get()` returns `i64` immediately, same call shape as `r.counter(k)
// .get()`. Calling a WRITE method through `tx.read` (`tx.read.counter(k)
// .incr()`) fails `RedisError.Invalid` (`runPinnedCmd`, `cmd.bit`, #7738):
// it would run immediately, unqueued, outside this attempt's eventual
// MULTI/EXEC — `tx.read` exists for the read half of check-and-set, `tx.counter(k)
// .incr()` for the queued write half.

const maxTxRetries: int = 10

// The immediate handles bound to one transaction attempt's own pinned
// connection — this file's header, "`tx.read`". Grows one accessor per
// family as that family's commands land, mirroring `Client`'s own
// (`client.bit`); `counter` is the first (#6029), `sset` the second (#7138),
// `stream` the third (#7642), `geo`, `hll` and `bitmap` the next (#7738),
// `zset` the last of the sorted-set family (#7754).
export class TxRead {
  conn: redisConn
  timeoutNs: int

  export counter(key: string): Counter {
    return Counter{ runner = pinnedRunner(this.conn, this.timeoutNs), key = key }
  }

  // Immediate set reads (`SMEMBERS`, `SISMEMBER`, `SCARD`, `SSCAN`, ...) on
  // this attempt's pinned connection; queue writes with `tx.sset(key)`.
  export sset(key: string): Set {
    return Set{ runner = pinnedRunner(this.conn, this.timeoutNs), key = key }
  }

  // Immediate stream reads (`XLEN`, `XRANGE`, `XREAD` without `block`,
  // `XINFO`, `XPENDING`, ...) on this attempt's pinned connection; queue
  // writes with `tx.stream(key)`. A `block` is refused: the pinned
  // connection cannot wait.
  export stream(key: string): Stream {
    return Stream{ runner = pinnedRunner(this.conn, this.timeoutNs), key = key }
  }

  // Immediate sorted-set reads (`ZSCORE`, `ZRANK`, `ZCARD`, `ZCOUNT`,
  // `ZRANGE` and its forms, `ZRANDMEMBER`, `ZSCAN`, ...) on this attempt's
  // pinned connection; queue writes with `tx.zset(key)`. A blocking pop is
  // refused: the pinned connection cannot wait.
  export zset(key: string): Zset {
    return Zset{ runner = pinnedRunner(this.conn, this.timeoutNs), key = key }
  }

  // Immediate geo reads (`GEOPOS`, `GEODIST`, `GEOHASH`, `GEOSEARCH`) on
  // this attempt's pinned connection; queue writes with `tx.geo(key)`.
  export geo(key: string): Geo {
    return Geo{ runner = pinnedRunner(this.conn, this.timeoutNs), key = key }
  }

  // Immediate `PFCOUNT` on this attempt's pinned connection; queue writes
  // with `tx.hll(key)`.
  export hll(key: string): Hll {
    return Hll{ runner = pinnedRunner(this.conn, this.timeoutNs), key = key }
  }

  // Immediate bit reads (`GETBIT`, `BITCOUNT`, `BITPOS`, `BITFIELD_RO`) on
  // this attempt's pinned connection; queue writes with `tx.bitmap(key)`.
  export bitmap(key: string): Bitmap {
    return Bitmap{ runner = pinnedRunner(this.conn, this.timeoutNs), key = key }
  }
}

// One command queued inside a transaction body, and the six commands every
// `Client` exposes directly — both just forward to `this.batch`, the exact
// methods `Pipeline` forwards to (`cmd.bit`'s header, point 4).
export class Tx {
  batch: Batch
  export read: TxRead

  export queue<T>(cmd: Cmd<T>): Future<T> { return this.batch.queue(cmd) }

  export get(key: string): Future<Option<string>> { return this.batch.get(key) }
  export set(key: string, value: string): Future<()> { return this.batch.set(key, value) }
  export del(keys: []string): Future<i64> { return this.batch.del(keys) }
  export exists(keys: []string): Future<i64> { return this.batch.exists(keys) }
  export expire(key: string, seconds: i64): Future<bool> { return this.batch.expire(key, seconds) }
  export ping(): Future<string> { return this.batch.ping() }

  // The identical family accessors `Pipeline` exposes, over the identical
  // queued-view classes — one view per family, shared by both executors.
  export str(key: string): StrBatch { return StrBatch{ batch = this.batch, key = key } }
  export counter(key: string): CounterBatch { return CounterBatch{ batch = this.batch, key = key } }
  export keys(): KeysBatch { return KeysBatch{ batch = this.batch } }
  export hash(key: string): HashBatch { return HashBatch{ batch = this.batch, key = key } }
  export list(key: string): ListBatch { return ListBatch{ batch = this.batch, key = key } }
  export sset(key: string): SetBatch { return SetBatch{ batch = this.batch, key = key } }
  export zset(key: string): ZsetBatch { return ZsetBatch{ batch = this.batch, key = key } }
  export stream(key: string): StreamBatch { return StreamBatch{ batch = this.batch, key = key } }
  export geo(key: string): GeoBatch { return GeoBatch{ batch = this.batch, key = key } }
  export hll(key: string): HllBatch { return HllBatch{ batch = this.batch, key = key } }
  export bitmap(key: string): BitmapBatch { return BitmapBatch{ batch = this.batch, key = key } }
  export json(key: string): JsonBatch { return JsonBatch{ batch = this.batch, key = key } }
  export timeseries(key: string): TimeSeriesBatch {
    return TimeSeriesBatch{ batch = this.batch, key = key }
  }
  export bloom(key: string): BloomBatch { return BloomBatch{ batch = this.batch, key = key } }
  export vset(key: string): VectorSetBatch {
    return VectorSetBatch{ batch = this.batch, key = key }
  }
  export array(key: string): ArrBatch { return ArrBatch{ batch = this.batch, key = key } }
}

// `Client.transaction`'s retry loop: a fresh attempt (fresh connection
// lease, fresh `body` call, fresh `Batch`) each time, returning `result`
// ONLY from the attempt whose EXEC actually committed.
fn runTransaction<R>(client: Client, keys: []string, body: (Tx) => R!RedisError): R!RedisError {
  let attempt = 0
  while (attempt < maxTxRetries) {
    let (result, committed) = client.withConn<(R, bool)>((conn) => {
      return runTxAttempt<R>(conn, client.opts.commandTimeout, keys, body)?
    })?
    if (committed) {
      return result
    }
    attempt = attempt + 1
  }
  fail RedisError.ExecAbort("transaction: exceeded ${maxTxRetries} retries after WATCH conflicts")
}

// One WATCH/body/MULTI/queued-commands/EXEC attempt over `conn`, leaving
// `conn` clean whatever happens: a failure that is not a dead connection is
// followed by `abortTx` (UNWATCH, or DISCARD once MULTI is open) before the
// error is returned, so the connection can go back to the pool (#7434). A
// dead connection is retired by `Client.withConn`, so there is nothing to
// clean.
fn runTxAttempt<R>(
  conn: redisConn,
  timeoutNs: int,
  keys: []string,
  body: (Tx) => R!RedisError,
): (R, bool)!RedisError {
  let out = attemptTx<R>(conn, timeoutNs, keys, body) catch e {
    abortTx(conn, timeoutNs, e)
    fail e
  }
  return out
}

// `body` runs between WATCH and MULTI (this file's header) — its own return
// value is `result`; its queued commands are `batch.queued`. `committed` is
// `true` only when EXEC actually ran them (and `batch.box` is now filled —
// every `Future<T>` `result` carries is live); `false` only for a nil EXEC,
// so the caller retries with a fresh WATCH and a fresh `Batch`. `conn.watching`
// and `conn.multi` record what the server holds open, for `abortTx`.
fn attemptTx<R>(
  conn: redisConn,
  timeoutNs: int,
  keys: []string,
  body: (Tx) => R!RedisError,
): (R, bool)!RedisError {
  conn.watching = true
  writeCommand(conn, withKeys("WATCH", keys), timeoutNs)?
  readOneReply(conn, timeoutNs)?
  let batch = Batch()
  let tx = Tx{ batch = batch, read = TxRead{ conn = conn, timeoutNs = timeoutNs } }
  let result = body(tx)?
  writeCommand(conn, ["MULTI"], timeoutNs)?
  readOneReply(conn, timeoutNs)?
  conn.multi = true
  queueBatchOverWire(conn, timeoutNs, batch.queued)?
  let r = execOverWire(conn, timeoutNs)?
  let committed = fillFromExec(batch, r)?
  return result, committed
}

// Sends EXEC and reads its reply. EXEC ends the MULTI and clears the WATCH
// whatever it answers (an `-EXECABORT` included), so both flags drop as soon
// as the reply is read, before a server error is turned into a failure.
fn execOverWire(conn: redisConn, timeoutNs: int): Reply!RedisError {
  writeCommand(conn, ["EXEC"], timeoutNs)?
  let r = readReplyRaw(conn, timeoutNs)?
  conn.multi = false
  conn.watching = false
  match (r) {
    Err(msg) => fail fromServer(msg)
    _ => return r
  }
}

// Undoes whatever `attemptTx` left open on the server after failing with `e`:
// DISCARD once MULTI is open (it also clears the WATCH), else UNWATCH. Skipped
// when `e` says the connection is dead — `withConn` retires it. If the
// cleanup itself fails, the flags stay set and `withConn` retires the
// connection instead (`connClean`); the error the caller sees is still `e`.
fn abortTx(conn: redisConn, timeoutNs: int, e: RedisError) {
  if (connectionBad(e)) {
    return
  }
  if (conn.multi) {
    settleTx(conn, timeoutNs, "DISCARD")
    return
  }
  if (conn.watching) {
    settleTx(conn, timeoutNs, "UNWATCH")
  }
}

fn settleTx(conn: redisConn, timeoutNs: int, name: string) {
  writeCommand(conn, [name], timeoutNs) catch _ {
    return
  }
  let _ = readReplyRaw(conn, timeoutNs) catch _ {
    return
  }
  conn.multi = false
  conn.watching = false
}

// Sends every already-queued command, expecting `+QUEUED` for each — the
// server's own acknowledgment that a command landed inside this MULTI, not
// the command's real result (that only exists once `EXEC` runs).
fn queueBatchOverWire(conn: redisConn, timeoutNs: int, cmds: [][]string): ()!RedisError {
  let i = 0
  while (i < len(cmds)) {
    writeCommand(conn, cmds[i], timeoutNs)?
    let r = readOneReply(conn, timeoutNs)?
    expectQueued(r, cmds[i][0])?
    i = i + 1
  }
}

fn expectQueued(r: Reply, cmdName: string): ()!RedisError {
  match (r) {
    Simple(s) => return checkQueued(s, cmdName)?
    _ => fail RedisError.Unexpected(cmdName, shapeName(r))
  }
}

fn checkQueued(s: string, cmdName: string): ()!RedisError {
  if (s != "QUEUED") {
    fail RedisError.Protocol("redis: ${cmdName}: expected +QUEUED, got '${s}'")
  }
}

// A conflicting EXEC is `*-1\r\n` on RESP2 (`Reply.Array(Option.None)`) but
// the unified `_\r\n` on RESP3 (`Reply.Null`) — the same RESP2/RESP3 split
// `client.bit`'s `get()` already documents for a missing `GET`, proved live
// here too (RESP3 is this package's default protocol, so the RESP2 shape
// alone was never actually exercised).
fn fillFromExec(batch: Batch, r: Reply): bool!RedisError {
  match (r) {
    Array(items) => return fillFromArrayOpt(batch, items)
    Null => return false
    _ => fail RedisError.Unexpected("EXEC", shapeName(r))
  }
}

fn fillFromArrayOpt(batch: Batch, items: Option<[]Reply>): bool {
  match (items) {
    Some(list) => {
      batch.box.replies = list
      batch.box.ready = true
      return true
    }
    None => return false
  }
}
