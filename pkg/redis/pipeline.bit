// pkg/redis/pipeline.bit — `r.pipeline()`: queue several `Cmd<T>`s
// client-side (via `cmd.bit`'s `Batch`), send them all on one connection,
// read all their replies back in order. Epic #6013, #6028.
//
// `let p = r.pipeline(); let b = p.counter("n").incr(); p.exec()?; b.get()?`
// — `queue`/every family method never touches the network; `exec()` writes
// every queued command before reading any reply (true RESP pipelining, one
// round trip for N commands, not N), then fills the shared `Batch.box`
// every `Future<T>` handed out reads from.

// A `Pipeline` is single-use: `exec()` may run once. Reusing one after
// `exec()` (or queuing more after it) is a caller bug, not a retryable
// condition.
export class Pipeline {
  client: Client
  batch: Batch

  export queue<T>(cmd: Cmd<T>): Future<T> { return this.batch.queue(cmd) }

  export get(key: string): Future<Option<string>> { return this.batch.get(key) }
  export set(key: string, value: string): Future<()> { return this.batch.set(key, value) }
  export del(keys: []string): Future<i64> { return this.batch.del(keys) }
  export exists(keys: []string): Future<i64> { return this.batch.exists(keys) }
  export expire(key: string, seconds: i64): Future<bool> { return this.batch.expire(key, seconds) }
  export ping(): Future<string> { return this.batch.ping() }

  // One typed queued-view accessor per data-type family, mirroring
  // `Client`'s own — `Tx` exposes the identical set over the identical
  // view classes (`cmd.bit`'s header).
  export str(key: string): StrBatch { return StrBatch{ batch = this.batch, key = key } }
  export counter(key: string): CounterBatch { return CounterBatch{ batch = this.batch, key = key } }
  export keys(): KeysBatch { return KeysBatch{ batch = this.batch } }
  export hash(key: string): HashBatch { return HashBatch{ batch = this.batch, key = key } }
  export list(key: string): ListBatch { return ListBatch{ batch = this.batch, key = key } }
  export sset(key: string): SetBatch { return SetBatch{ batch = this.batch, key = key } }
  export zset(key: string): ZsetBatch { return ZsetBatch{ batch = this.batch, key = key } }
  export stream(key: string): StreamBatch { return StreamBatch{ batch = this.batch, key = key } }
  export geo(key: string): GeoBatch { return GeoBatch{ batch = this.batch, key = key } }
  export hll(key: string): HllBatch { return HllBatch{ batch = this.batch, key = key } }
  export bitmap(key: string): BitmapBatch { return BitmapBatch{ batch = this.batch, key = key } }
  export json(key: string): JsonBatch { return JsonBatch{ batch = this.batch, key = key } }
  export timeseries(key: string): TimeSeriesBatch {
    return TimeSeriesBatch{ batch = this.batch, key = key }
  }
  export bloom(key: string): BloomBatch { return BloomBatch{ batch = this.batch, key = key } }
  export vset(key: string): VectorSetBatch {
    return VectorSetBatch{ batch = this.batch, key = key }
  }
  export array(key: string): ArrBatch { return ArrBatch{ batch = this.batch, key = key } }

  // Sends every queued command over one leased connection, in order, then
  // reads exactly that many replies back, in the same order. Every
  // `Future<T>` already handed out reads its result out of the box this
  // fills.
  export exec(): ()!RedisError {
    let cmds = this.batch.queued
    let replies = this.client.withConn<[]Reply>((conn) => {
      return pipelineBatch(conn, cmds, this.client.opts.commandTimeout)?
    })?
    this.batch.box.replies = replies
    this.batch.box.ready = true
  }
}

// Reads one reply per command even when some are server errors, so a failed
// pipeline leaves nothing unread on the pooled connection; the FIRST server
// error is then returned and `exec()` fills no futures, as before. A transport
// or decode failure still stops at once: that connection is dropped anyway.
fn pipelineBatch(conn: redisConn, cmds: [][]string, timeoutNs: int): []Reply!RedisError {
  let i = 0
  while (i < len(cmds)) {
    writeCommand(conn, cmds[i], timeoutNs)?
    i = i + 1
  }
  let out = []Reply(0)
  let firstErr = ""
  let failed = false
  i = 0
  while (i < len(cmds)) {
    let r = readReplyRaw(conn, timeoutNs)?
    match (r) {
      Err(msg) => {
        if (!failed) {
          firstErr = msg
          failed = true
        }
      }
      _ => {}
    }
    out = append(out, r)
    i = i + 1
  }
  if (failed) {
    fail fromServer(firstErr)
  }
  return out
}

// A `Future<T>` that is already failed with `err`: its own ready box, so
// `get()` reports `err` with or without an `exec()`, and no command is queued
// for it. How a queued method refuses an argument the direct form refuses.
fn failedFuture<T>(err: RedisError): Future<T> {
  let box = resultBox{ replies = [Reply.Null], ready = true }
  return Future<T>{
    box = box,
    index = 0,
    decode = (r) => {
      fail err
    },
  }
}
