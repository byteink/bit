// pkg/redis/pipeline.bit — `r.pipeline()`: queue several `Cmd<T>`s
// client-side, send them all on one connection, read all their replies back
// in order. Epic #6013, #6028.
//
// `let p = r.pipeline(); let b = p.counter("n").incr(); p.exec()?; b.get()?`
// — `queue` never touches the network; `exec()` writes every queued command
// before reading any reply (true RESP pipelining, one round trip for N
// commands, not N), then fills the shared `resultBox` every `Future<T>`
// handed out by `queue` reads from.

// A `Pipeline` is single-use: `exec()` may run once. Reusing one after
// `exec()` (or queuing more after it) is a caller bug, not a retryable
// condition — mirrors `Tx`'s own `queued`/no-post-exec-mutation shape.
export class Pipeline {
  client: Client
  box: resultBox
  queued: [][]string

  // Queues `cmd`, returning a `Future<T>` that resolves once `exec()` fills
  // this pipeline's `resultBox` — see `cmd.bit`'s header for how a family
  // builds `cmd`.
  export queue<T>(cmd: Cmd<T>): Future<T> {
    let idx = len(this.queued)
    this.queued = append(this.queued, cmd.args)
    return Future<T>{ box = this.box, index = idx, decode = cmd.decode }
  }

  export get(key: string): Future<Option<string>> {
    return this.queue(getCmd(key))
  }

  export set(key: string, value: string): Future<()> {
    return this.queue(setCmd(key, value))
  }

  export del(keys: []string): Future<i64> {
    return this.queue(delCmd(keys))
  }

  export exists(keys: []string): Future<i64> {
    return this.queue(existsCmd(keys))
  }

  export expire(key: string, seconds: i64): Future<bool> {
    return this.queue(expireCmd(key, seconds))
  }

  export ping(): Future<string> {
    return this.queue(pingCmd())
  }

  // Sends every queued command over one leased connection, in order, then
  // reads exactly that many replies back, in the same order. Every
  // `Future<T>` `queue` already handed out reads its result out of the box
  // this fills.
  export exec(): ()!RedisError {
    let cmds = this.queued
    let replies = this.client.withConn<[]Reply>((conn) => {
      return pipelineBatch(conn, cmds, this.client.opts.commandTimeout)?
    })?
    this.box.replies = replies
    this.box.ready = true
  }
}

fn pipelineBatch(conn: redisConn, cmds: [][]string, timeoutNs: int): []Reply!RedisError {
  let i = 0
  while (i < len(cmds)) {
    writeCommand(conn, cmds[i], timeoutNs)?
    i = i + 1
  }
  let out = []Reply(0)
  i = 0
  while (i < len(cmds)) {
    let r = readOneReply(conn, timeoutNs)?
    out = append(out, r)
    i = i + 1
  }
  return out
}

