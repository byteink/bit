// pkg/redis/vsetfilter.bit - the filter expressions `VSIM ... FILTER` takes,
// as a typed builder: `vattr("team").is("red").and(vattr("lvl").gt(3))`
// builds `(.team == "red") and (.lvl > 3)`. Epic #6013, #6028, #6040.
// `rawVFilter` writes the server's own expression for anything the builder
// leaves out (arithmetic, `**`, `%`). Pure functions of their inputs, so
// `vset.test.bit` checks every expression without a server.
//
// An attribute is a field of the JSON object stored with an element
// (`VADD ... SETATTR`, `VSETATTR`); an element with no attributes, or without
// the field, never matches a comparison against it.

// A filter expression, passed to `SimilarOptions.filter`.
export class VFilter {
  export expr: string

  // `(a) and (b)`: both hold.
  export and(other: VFilter): VFilter {
    return VFilter{ expr = "(${this.expr}) and (${other.expr})" }
  }
  // `(a) or (b)`: either holds.
  export or(other: VFilter): VFilter {
    return VFilter{ expr = "(${this.expr}) or (${other.expr})" }
  }
  // `not (a)`.
  export not(): VFilter { return VFilter{ expr = "not (${this.expr})" } }
}

// `vattr(name)`: what to test an element's attribute against.
export class VAttr {
  export name: string

  // `.name == "value"`.
  export is(value: string): VFilter {
    return VFilter{ expr = ".${this.name} == ${quoteVString(value)}" }
  }
  // `.name != "value"`.
  export isNot(value: string): VFilter {
    return VFilter{ expr = ".${this.name} != ${quoteVString(value)}" }
  }
  // `.name == n`.
  export eq(n: f64): VFilter { return VFilter{ expr = ".${this.name} == ${n}" } }
  // `.name != n`.
  export ne(n: f64): VFilter { return VFilter{ expr = ".${this.name} != ${n}" } }
  // `.name > n`.
  export gt(n: f64): VFilter { return VFilter{ expr = ".${this.name} > ${n}" } }
  // `.name >= n`.
  export ge(n: f64): VFilter { return VFilter{ expr = ".${this.name} >= ${n}" } }
  // `.name < n`.
  export lt(n: f64): VFilter { return VFilter{ expr = ".${this.name} < ${n}" } }
  // `.name <= n`.
  export le(n: f64): VFilter { return VFilter{ expr = ".${this.name} <= ${n}" } }
  // `.name in ["a", "b"]`: the attribute is one of `values`.
  export oneOf(...values: string): VFilter {
    return VFilter{ expr = ".${this.name} in [${quotedList(values)}]" }
  }
  // `"value" in .name`: the attribute is an array (or string) holding `value`.
  export has(value: string): VFilter {
    return VFilter{ expr = "${quoteVString(value)} in .${this.name}" }
  }
}

export fn vattr(name: string): VAttr { return VAttr{ name = name } }

// A filter written as the server's own expression.
export fn rawVFilter(expr: string): VFilter { return VFilter{ expr = expr } }

// A double-quoted string literal; the quote and the backslash are escaped.
fn quoteVString(s: string): string {
  let out = "\""
  let i = 0
  while (i < len(s)) {
    let c = s[i:i + 1]
    if (c == "\"" || c == "\\") {
      out = out + "\\"
    }
    out = out + c
    i = i + 1
  }
  return out + "\""
}

fn quotedList(values: []string): string {
  let out = ""
  let i = 0
  while (i < len(values)) {
    if (i > 0) {
      out = out + ", "
    }
    out = out + quoteVString(values[i])
    i = i + 1
  }
  return out
}
