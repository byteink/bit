// pkg/redis/info.test.bit — `InfoSection`'s wire words and `INFO`'s argument
// list (`info.bit`), tested without a socket.

fn sameArgs(got: []string, want: []string): bool {
  if (len(got) != len(want)) {
    return false
  }
  for (let i = 0; i < len(want); i++) {
    if (got[i] != want[i]) {
      return false
    }
  }
  return true
}

test "INFO with the Default section sends no argument" {
  let got = infoArgs(InfoSection.Default)
  assert(sameArgs(got, ["INFO"]), "Default sent ${len(got)} args")
}

test "every named InfoSection sends its lowercase word" {
  let sections = [
    InfoSection.Server,
    InfoSection.Clients,
    InfoSection.Memory,
    InfoSection.Persistence,
    InfoSection.Threads,
    InfoSection.Stats,
    InfoSection.Replication,
    InfoSection.Cpu,
    InfoSection.Modules,
    InfoSection.Keyspace,
    InfoSection.Commandstats,
    InfoSection.Errorstats,
    InfoSection.Latencystats,
    InfoSection.Sentinel,
    InfoSection.Cluster,
    InfoSection.Keysizes,
    InfoSection.Hotkeys,
    InfoSection.All,
    InfoSection.Everything,
  ]
  let words = [
    "server",
    "clients",
    "memory",
    "persistence",
    "threads",
    "stats",
    "replication",
    "cpu",
    "modules",
    "keyspace",
    "commandstats",
    "errorstats",
    "latencystats",
    "sentinel",
    "cluster",
    "keysizes",
    "hotkeys",
    "all",
    "everything",
  ]
  assert(len(sections) == len(words), "table lengths differ")
  for (let i = 0; i < len(words); i++) {
    let got = infoArgs(sections[i])
    assert(
      sameArgs(got, ["INFO", words[i]]),
      "section ${i} sent '${got[len(got) - 1]}', want '${words[i]}'",
    )
  }
}

test "a Module section sends the module's own name" {
  let got = infoArgs(InfoSection.Module("search"))
  assert(sameArgs(got, ["INFO", "search"]), "Module('search') sent ${len(got)} args")
}
