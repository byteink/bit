// pkg/redis/tdigest.bit - `r.tdigest(key)`: the t-digest (`TDIGEST.*`)
// commands. Epic #6013, #6028, #6039. Follows `cmd.bit`'s HOW-TO header and
// `counter.bit`'s shape; `sketch.bit` holds the decoders it shares.
//
// A t-digest summarises a stream of numbers in a few KB and answers rank
// questions about it: "what is the 99th percentile" (`quantile`), "what share
// of the values is below 250" (`cdf`), "where would 250 rank" (`rank`).
// It is most exact at the extremes, which is where latency questions live.
//
// `TDigest` holds `runner: Runner`, as `set.bit`'s `Set` does; a write
// through a pinned runner (`tx.read`) is refused (#7738).
//
// AN EMPTY DIGEST ANSWERS NaN, NOT AN ERROR: `quantile`, `cdf`, `min`, `max`,
// `trimmedMean`, `byRank` and `byRevRank` return `NaN` for it (test with
// `x != x`), and `byRank` / `byRevRank` return +/-infinity for a rank beyond
// the data. `rank` / `revRank` answer -2 for an empty digest and -1 / the
// count for a value below / above everything, as the server does.

import * as strings from "std/strings"

// `TDIGEST.MERGE`'s optional arguments: `compression` of the result (the
// largest source's if `None`), and `overwrite` to replace the destination's
// content instead of merging into it.
export class TDigestMergeOptions {
  export compression: Option<i64> = Option.None,
  export overwrite: bool = false,
}

// `TDIGEST.INFO`. `observations` is how many values were added; the weights
// count the values summarised in merged / not yet merged centroids.
export class TDigestInfo {
  export compression: i64,
  export capacity: i64,
  export mergedNodes: i64,
  export unmergedNodes: i64,
  export mergedWeight: i64,
  export unmergedWeight: i64,
  export observations: i64,
  export totalCompressions: i64,
  export memoryUsage: i64,
}

export class TDigest {
  runner: Runner
  key: string

  // `TDIGEST.CREATE`: `compression` trades memory for accuracy (the server's
  // default is 100).
  export create(compression: Option<i64> = Option.None): ()!RedisError {
    return this.runner.runCmd(tdCreateCmd(this.key, compression))?
  }
  // `TDIGEST.ADD`: adds values to the digest.
  export add(...values: f64): ()!RedisError {
    return this.runner.runCmd(tdAddCmd(this.key, values))?
  }
  // `TDIGEST.MERGE`: merges `sources` into this key.
  export merge(
    sources: []string,
    opts: TDigestMergeOptions = TDigestMergeOptions{},
  ): ()!RedisError {
    return this.runner.runCmd(tdMergeCmd(this.key, sources, opts))?
  }
  // `TDIGEST.RESET`: empties the digest, keeping its compression.
  export reset(): ()!RedisError { return this.runner.runCmd(tdResetCmd(this.key))? }
  // `TDIGEST.QUANTILE`: the value at each fraction (0.99 is the p99).
  export quantile(...fractions: f64): []f64!RedisError {
    return this.runner.runCmd(tdFloatsCmd("TDIGEST.QUANTILE", this.key, fractions))?
  }
  // `TDIGEST.CDF`: the fraction of values at or below each value.
  export cdf(...values: f64): []f64!RedisError {
    return this.runner.runCmd(tdFloatsCmd("TDIGEST.CDF", this.key, values))?
  }
  // `TDIGEST.RANK`: how many values are below each value (the file header
  // has the sentinels).
  export rank(...values: f64): []i64!RedisError {
    return this.runner.runCmd(tdRankCmd("TDIGEST.RANK", this.key, values))?
  }
  // `TDIGEST.REVRANK`: `rank` counted from the top.
  export revRank(...values: f64): []i64!RedisError {
    return this.runner.runCmd(tdRankCmd("TDIGEST.REVRANK", this.key, values))?
  }
  // `TDIGEST.BYRANK`: the value at each rank (0 is the smallest).
  export byRank(...ranks: i64): []f64!RedisError {
    return this.runner.runCmd(tdByRankCmd("TDIGEST.BYRANK", this.key, ranks))?
  }
  // `TDIGEST.BYREVRANK`: the value at each rank from the top (0 is the largest).
  export byRevRank(...ranks: i64): []f64!RedisError {
    return this.runner.runCmd(tdByRankCmd("TDIGEST.BYREVRANK", this.key, ranks))?
  }
  export min(): f64!RedisError { return this.runner.runCmd(tdExtremeCmd("TDIGEST.MIN", this.key))? }
  export max(): f64!RedisError { return this.runner.runCmd(tdExtremeCmd("TDIGEST.MAX", this.key))? }
  // `TDIGEST.TRIMMED_MEAN`: the mean of the values between the `low` and
  // `high` fractions, cutting off the outliers.
  export trimmedMean(low: f64, high: f64): f64!RedisError {
    return this.runner.runCmd(tdTrimmedMeanCmd(this.key, low, high))?
  }
  export info(): TDigestInfo!RedisError { return this.runner.runCmd(tdInfoCmd(this.key))? }
}

// The queued view `Pipeline.tdigest`/`Tx.tdigest` both return.
export class TDigestBatch {
  batch: Batch
  key: string

  export create(compression: Option<i64> = Option.None): Future<()> {
    return this.batch.queue(tdCreateCmd(this.key, compression))
  }
  export add(...values: f64): Future<()> { return this.batch.queue(tdAddCmd(this.key, values)) }
  export merge(
    sources: []string,
    opts: TDigestMergeOptions = TDigestMergeOptions{},
  ): Future<()> {
    return this.batch.queue(tdMergeCmd(this.key, sources, opts))
  }
  export reset(): Future<()> { return this.batch.queue(tdResetCmd(this.key)) }
  export quantile(...fractions: f64): Future<[]f64> {
    return this.batch.queue(tdFloatsCmd("TDIGEST.QUANTILE", this.key, fractions))
  }
  export cdf(...values: f64): Future<[]f64> {
    return this.batch.queue(tdFloatsCmd("TDIGEST.CDF", this.key, values))
  }
  export rank(...values: f64): Future<[]i64> {
    return this.batch.queue(tdRankCmd("TDIGEST.RANK", this.key, values))
  }
  export revRank(...values: f64): Future<[]i64> {
    return this.batch.queue(tdRankCmd("TDIGEST.REVRANK", this.key, values))
  }
  export byRank(...ranks: i64): Future<[]f64> {
    return this.batch.queue(tdByRankCmd("TDIGEST.BYRANK", this.key, ranks))
  }
  export byRevRank(...ranks: i64): Future<[]f64> {
    return this.batch.queue(tdByRankCmd("TDIGEST.BYREVRANK", this.key, ranks))
  }
  export min(): Future<f64> { return this.batch.queue(tdExtremeCmd("TDIGEST.MIN", this.key)) }
  export max(): Future<f64> { return this.batch.queue(tdExtremeCmd("TDIGEST.MAX", this.key)) }
  export trimmedMean(low: f64, high: f64): Future<f64> {
    return this.batch.queue(tdTrimmedMeanCmd(this.key, low, high))
  }
  export info(): Future<TDigestInfo> { return this.batch.queue(tdInfoCmd(this.key)) }
}

// A double that may be `NaN` or infinite: RESP3 sends `Double`, RESP2 a
// bulk string (`nan`, `inf`, `-inf`). `asDouble` refuses a NaN; here it is
// the empty digest's answer.
fn sketchDouble(r: Reply, cmd: string): f64!RedisError {
  match (r) {
    Double(v) => return v
    Bulk(v) => return parseSketchDouble(unwrapOr(v, ""), cmd)?
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

// `std/strings.parseFloat` reads `nan`, `inf`, `+inf` and `-inf` as IEEE 754
// values, the words the server spells them with; anything else it cannot read
// is an unexpected reply. It is reached through the namespace because the
// predeclared `parseFloat` builtin, which the rest of this module uses, would
// be shadowed by a named import (E0048).
fn parseSketchDouble(s: string, cmd: string): f64!RedisError {
  return strings.parseFloat(s) catch _ {
    fail RedisError.Unexpected(cmd, "Bulk")
  }
}

fn sketchDoubles(r: Reply, cmd: string): []f64!RedisError {
  return sketchList<f64>(r, cmd, (e) => sketchDouble(e, cmd))?
}

// The values as argv words.
fn floatWords(head: []string, values: []f64): []string {
  let out = append([]string(0), ...head)
  let i = 0
  while (i < len(values)) {
    out = append(out, "${values[i]}")
    i = i + 1
  }
  return out
}

fn tdCreateCmd(key: string, compression: Option<i64>): Cmd<()> {
  return Cmd<()>{
    args = append(["TDIGEST.CREATE", key], ...optInt("COMPRESSION", compression)),
    decode = (r) => asOk(r, "TDIGEST.CREATE"),
    readOnly = false,
  }
}

fn tdAddCmd(key: string, values: []f64): Cmd<()> {
  return Cmd<()>{
    args = floatWords(["TDIGEST.ADD", key], values),
    decode = (r) => asOk(r, "TDIGEST.ADD"),
    readOnly = false,
  }
}

fn tdMergeArgs(dest: string, sources: []string, opts: TDigestMergeOptions): []string {
  let args = append(["TDIGEST.MERGE", dest, "${len(sources)}"], ...sources)
  args = append(args, ...optInt("COMPRESSION", opts.compression))
  if (opts.overwrite) {
    args = append(args, "OVERRIDE")
  }
  return args
}

fn tdMergeCmd(dest: string, sources: []string, opts: TDigestMergeOptions): Cmd<()> {
  return Cmd<()>{
    args = tdMergeArgs(dest, sources, opts),
    decode = (r) => asOk(r, "TDIGEST.MERGE"),
    readOnly = false,
  }
}

fn tdResetCmd(key: string): Cmd<()> {
  return Cmd<()>{
    args = ["TDIGEST.RESET", key],
    decode = (r) => asOk(r, "TDIGEST.RESET"),
    readOnly = false,
  }
}

// `QUANTILE` and `CDF`: floats in, floats out.
fn tdFloatsCmd(name: string, key: string, values: []f64): Cmd<[]f64> {
  return Cmd<[]f64>{
    args = floatWords([name, key], values),
    decode = (r) => sketchDoubles(r, name),
    readOnly = true,
  }
}

fn tdRankCmd(name: string, key: string, values: []f64): Cmd<[]i64> {
  return Cmd<[]i64>{
    args = floatWords([name, key], values),
    decode = (r) => sketchInts(r, name),
    readOnly = true,
  }
}

fn tdByRankCmd(name: string, key: string, ranks: []i64): Cmd<[]f64> {
  let args = [name, key]
  let i = 0
  while (i < len(ranks)) {
    args = append(args, "${ranks[i]}")
    i = i + 1
  }
  return Cmd<[]f64>{ args = args, decode = (r) => sketchDoubles(r, name), readOnly = true }
}

fn tdExtremeCmd(name: string, key: string): Cmd<f64> {
  return Cmd<f64>{ args = [name, key], decode = (r) => sketchDouble(r, name), readOnly = true }
}

fn tdTrimmedMeanCmd(key: string, low: f64, high: f64): Cmd<f64> {
  return Cmd<f64>{
    args = ["TDIGEST.TRIMMED_MEAN", key, "${low}", "${high}"],
    decode = (r) => sketchDouble(r, "TDIGEST.TRIMMED_MEAN"),
    readOnly = true,
  }
}

fn tdInfoCmd(key: string): Cmd<TDigestInfo> {
  return Cmd<TDigestInfo>{
    args = ["TDIGEST.INFO", key],
    decode = (r) => asTDigestInfo(r),
    readOnly = true,
  }
}

fn asTDigestInfo(r: Reply): TDigestInfo!RedisError {
  let pairs = sketchPairs(r, "TDIGEST.INFO")?
  return TDigestInfo{
    compression = sketchField(pairs, "Compression", "TDIGEST.INFO")?,
    capacity = sketchField(pairs, "Capacity", "TDIGEST.INFO")?,
    mergedNodes = sketchField(pairs, "Merged nodes", "TDIGEST.INFO")?,
    unmergedNodes = sketchField(pairs, "Unmerged nodes", "TDIGEST.INFO")?,
    mergedWeight = sketchField(pairs, "Merged weight", "TDIGEST.INFO")?,
    unmergedWeight = sketchField(pairs, "Unmerged weight", "TDIGEST.INFO")?,
    observations = sketchField(pairs, "Observations", "TDIGEST.INFO")?,
    totalCompressions = sketchField(pairs, "Total compressions", "TDIGEST.INFO")?,
    memoryUsage = sketchField(pairs, "Memory usage", "TDIGEST.INFO")?,
  }
}
