// pkg/redis/errors.bit — `RedisError`: one enum a caller can `match` or ask
// `.retryable()` of, replacing the plain `newError("redis: ...")` every
// command in `client.bit` still fails with (#3466's escape hatch, unchanged
// by this file). Epic #6013 decision 2: every public method returns
// `T ! RedisError`, the concrete error type, not the generic `error` — this
// file is that type; wiring `client.bit`'s commands to return it is later
// tickets (#6018/#6020/#6022), not this one.
//
// Variants split into two halves. Server-side variants are what
// `fromServer` below builds from a `-ERR`/`-WRONGTYPE ...` reply's first
// word (`resp.bit`'s `Reply.Err(string)` payload) — one variant per
// documented Redis error prefix, plus `Server(code, msg)` for any prefix
// this file does not name yet, so an unrecognised server error still
// carries its real code instead of collapsing into a generic failure.
// Client-side variants (`Io`, `Timeout`, `Closed`, `Protocol`,
// `PoolExhausted`, `Unexpected`) are built directly by the connection and
// pool layers, never by `fromServer`; `Invalid(msg)` is a caller's own
// mistake (a negative `count`) refused before anything is sent.
//
// `message()`/`fromServer`'s prefix table are each split across a small
// chain of functions purely to stay under spec/LINT.md's max-complexity
// (10): a single `match`/`switch` naming all ~15-21 cases would exceed it,
// so each function names a handful of cases and falls through (`_`/
// `default`) to the next one in the chain. This is a size constraint, not a
// grouping with its own meaning — do not read significance into which
// function a variant landed in.

// `indexOf`/`parseInt` (std/strings) are already imported module-wide by
// `resp.bit` — an import binds per MODULE (SPEC §17.1), so re-importing
// either here is E0042, the same rule `pkg/web/errors.bit`'s own header
// documents.

// One failure this package can report, satisfying the predeclared `error`
// interface (SPEC §10.6, §18.3) via `message()` below. `Moved`/`Ask` carry
// the slot number and the `host:port` a client is redirected to — the two
// fields a `-MOVED`/`-ASK` reply's body always carries in that order.
//
// `Closed` IS DECLARATION-ORDER FIRST, AND MUST STAY THAT WAY (integrator,
// #6028): SPEC §13.4 gives an enum a zero value only when its first variant
// carries no payload; #6017's `let (re, ok) = e.(RedisError)` needs that
// zero value for a failed assertion (§14.4). With `WrongType(string)` first,
// the assertion had no zero value to produce and was a compile-time E0083.
// `Closed` was chosen over the enum's other no-payload variant (`Timeout`)
// because `retryable()` is `false` for it: a caller that forgets to check
// `ok` and acts on the zero value anyway reads an error that never triggers
// a retry loop, where `Timeout`'s zero value would.
export enum RedisError {
  Closed
  WrongType(string)
  NoScript(string)
  NoAuth(string)
  WrongPass(string)
  NoPerm(string)
  ReadOnly(string)
  Loading(string)
  Busy(string)
  ExecAbort(string)
  Moved(int, string)
  Ask(int, string)
  TryAgain(string)
  ClusterDown(string)
  OutOfMemory(string)
  Server(string, string)

  Io(string)
  Timeout
  Protocol(string)
  PoolExhausted
  Unexpected(string, string)
  Invalid(string)

  export message(): string {
    match (this) {
      WrongType(msg) => return "redis: WRONGTYPE ${msg}"
      NoScript(msg) => return "redis: NOSCRIPT ${msg}"
      NoAuth(msg) => return "redis: NOAUTH ${msg}"
      WrongPass(msg) => return "redis: WRONGPASS ${msg}"
      NoPerm(msg) => return "redis: NOPERM ${msg}"
      ReadOnly(msg) => return "redis: READONLY ${msg}"
      Loading(msg) => return "redis: LOADING ${msg}"
      _ => return messageAvailability(this)
    }
  }

  // true for a failure a caller's reconnect/retry loop should act on: a
  // transport failure, a timeout, or a server condition expected to clear
  // on its own (still loading its dataset, a busy script, mid resharding,
  // mid failover). Everything else is either a programmer/data error
  // (`WrongType`, `Protocol`, ...) or already final (`Closed`).
  export retryable(): bool {
    match (this) {
      Io(_) => return true
      Timeout => return true
      Loading(_) => return true
      Busy(_) => return true
      TryAgain(_) => return true
      ClusterDown(_) => return true
      _ => return false
    }
  }
}

// `message()`'s second link: the remaining server-error variants whose
// message is a fixed prefix plus the server's own text, plus the two that
// carry a slot and address instead.
fn messageAvailability(e: RedisError): string {
  match (e) {
    Busy(msg) => return "redis: BUSY ${msg}"
    ExecAbort(msg) => return "redis: EXECABORT ${msg}"
    TryAgain(msg) => return "redis: TRYAGAIN ${msg}"
    ClusterDown(msg) => return "redis: CLUSTERDOWN ${msg}"
    OutOfMemory(msg) => return "redis: OOM ${msg}"
    Moved(slot, addr) => return "redis: MOVED ${slot} ${addr}"
    Ask(slot, addr) => return "redis: ASK ${slot} ${addr}"
    _ => return messageGeneric(e)
  }
}

// `message()`'s last link: the generic server fallback plus every
// client-side variant. The trailing `_` is unreachable — every variant is
// named across this function and its two callers above — but the `match`
// still requires it, since each link's exhaustiveness is checked against
// the whole `RedisError` type, not just the variants its callers left it.
fn messageGeneric(e: RedisError): string {
  match (e) {
    Server(code, msg) => return "redis: ${code} ${msg}"
    Io(msg) => return "redis: io: ${msg}"
    Timeout => return "redis: timeout"
    Closed => return "redis: use of closed connection"
    Protocol(msg) => return "redis: protocol: ${msg}"
    PoolExhausted => return "redis: connection pool exhausted"
    Invalid(msg) => return "redis: invalid argument: ${msg}"
    Unexpected(command, shape) => return "redis: ${command}: unexpected reply, got ${shape}"
    _ => return "redis: unknown error"
  }
}

// Parses a `-ERR`/`-WRONGTYPE ...` reply's body (`resp.bit`'s
// `Reply.Err(string)` payload, the text after the leading `-`) into a
// `RedisError`, by its first word. Empty text, or a first word this file
// does not name, becomes `Server(code, msg)` — the code is `""` for empty
// text — never a panic: a server this package has not seen every prefix
// from still produces a `RedisError` a caller can inspect.
export fn fromServer(text: string): RedisError {
  let sp = indexOf(text, " ")
  if (sp < 0) {
    return fromCode(text, "")
  }
  return fromCode(text[0:sp], text[sp + 1:len(text)])
}

// The first link of `fromServer`'s prefix table.
fn fromCode(code: string, detail: string): RedisError {
  switch (code) {
    case "WRONGTYPE":
      return RedisError.WrongType(detail)
    case "NOSCRIPT":
      return RedisError.NoScript(detail)
    case "NOAUTH":
      return RedisError.NoAuth(detail)
    case "WRONGPASS":
      return RedisError.WrongPass(detail)
    case "NOPERM":
      return RedisError.NoPerm(detail)
    case "READONLY":
      return RedisError.ReadOnly(detail)
    case "LOADING":
      return RedisError.Loading(detail)
    case "BUSY":
      return RedisError.Busy(detail)
    case "EXECABORT":
      return RedisError.ExecAbort(detail)
    default:
      return fromCodeRest(code, detail)
  }
}

// The second link: the remaining named prefixes, `MOVED`/`ASK` (which need
// their own slot/address parse, `parseSlotAddr` below), and the fallback to
// `Server(code, msg)` for anything else.
fn fromCodeRest(code: string, detail: string): RedisError {
  switch (code) {
    case "TRYAGAIN":
      return RedisError.TryAgain(detail)
    case "CLUSTERDOWN":
      return RedisError.ClusterDown(detail)
    case "OOM":
      return RedisError.OutOfMemory(detail)
    case "MOVED":
      return parseSlotAddr(detail, true)
    case "ASK":
      return parseSlotAddr(detail, false)
    default:
      return RedisError.Server(code, detail)
  }
}

// `detail` is `"<slot> <host:port>"` (a `-MOVED`/`-ASK` reply's body past
// its prefix). Falls back to `Server("MOVED"/"ASK", detail)`, the original
// text intact, when there is no second token or the first is not an
// integer — a malformed redirect still produces an inspectable
// `RedisError` instead of panicking.
fn parseSlotAddr(detail: string, isMoved: bool): RedisError {
  let code = "ASK"
  if (isMoved) {
    code = "MOVED"
  }
  let sp = indexOf(detail, " ")
  if (sp < 0) {
    return RedisError.Server(code, detail)
  }
  let slot = parseInt(detail[0:sp]) catch _ {
    return RedisError.Server(code, detail)
  }
  let addr = detail[sp + 1:len(detail)]
  if (isMoved) {
    return RedisError.Moved(slot, addr)
  }
  return RedisError.Ask(slot, addr)
}
