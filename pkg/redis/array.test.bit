// pkg/redis/array.test.bit - the wire arguments and reply decoding of
// `array.bit` and `arraycmd.bit`, tested without a server. `assertArgs` is
// `list.test.bit`s, `arr` `bloom.test.bit`s and `vbulk` `vset.test.bit`s (same
// module). `array.live.test.bit` runs every command against a real server.

fn bigIndex(): u64 { return u64(18446744073709551614) }

test "AR commands put the key first and write indexes as unsigned decimals" {
  assertArgs(arsetCmd("k", u64(5), ["a", "b"]).args, ["ARSET", "k", "5", "a", "b"])
  assertArgs(
    arsetCmd("k", bigIndex(), ["a"]).args,
    ["ARSET", "k", "18446744073709551614", "a"],
  )
  assertArgs(
    armsetCmd(
      "k",
      [ArEntry{ index = u64(1), value = "a" }, ArEntry{ index = u64(9), value = "b" }],
    ).args,
    ["ARMSET", "k", "1", "a", "9", "b"],
  )
  assertArgs(argetCmd("k", u64(3)).args, ["ARGET", "k", "3"])
  assertArgs(armgetCmd("k", [u64(1), u64(2)]).args, ["ARMGET", "k", "1", "2"])
  assertArgs(argetrangeCmd("k", u64(0), u64(4)).args, ["ARGETRANGE", "k", "0", "4"])
  assertArgs(arinsertCmd("k", ["a", "b"]).args, ["ARINSERT", "k", "a", "b"])
  assertArgs(arringCmd("k", 3, ["a"]).args, ["ARRING", "k", "3", "a"])
  assertArgs(arnextCmd("k").args, ["ARNEXT", "k"])
  assertArgs(arseekCmd("k", u64(7)).args, ["ARSEEK", "k", "7"])
  assertArgs(arlastitemsCmd("k", 2, false).args, ["ARLASTITEMS", "k", "2"])
  assertArgs(arlastitemsCmd("k", 2, true).args, ["ARLASTITEMS", "k", "2", "REV"])
  assertArgs(arcountCmd("k").args, ["ARCOUNT", "k"])
  assertArgs(arlenCmd("k").args, ["ARLEN", "k"])
  assertArgs(ardelCmd("k", [u64(1), u64(2)]).args, ["ARDEL", "k", "1", "2"])
  assertArgs(
    ardelrangeCmd(
      "k",
      [ArRange{ start = u64(1), end = u64(4) }, ArRange{ start = u64(8), end = u64(9) }],
    ).args,
    ["ARDELRANGE", "k", "1", "4", "8", "9"],
  )
  assertArgs(arscanCmd("k", u64(0), u64(9), Option.None).args, ["ARSCAN", "k", "0", "9"])
  assertArgs(
    arscanCmd("k", u64(0), u64(9), Option.Some(2)).args,
    ["ARSCAN", "k", "0", "9", "LIMIT", "2"],
  )
  assertArgs(arinfoCmd("k", false).args, ["ARINFO", "k"])
  assertArgs(arinfoCmd("k", true).args, ["ARINFO", "k", "FULL"])
}

test "ARGREP lists the predicates, then AND/OR, LIMIT, WITHVALUES and NOCASE" {
  let preds = [ArPred.Exact("a"), ArPred.Glob("b*")]
  assertArgs(
    argrepCmd("k", u64(0), u64(9), preds, ArGrepOptions{}).args,
    ["ARGREP", "k", "0", "9", "EXACT", "a", "GLOB", "b*"],
  )
  let all = ArGrepOptions{ combine = ArCombine.And, limit = Option.Some(3), noCase = true }
  assertArgs(
    argrepValuesCmd("k", u64(0), u64(9), [ArPred.Match("x"), ArPred.Re("^y")], all).args,
    [
      "ARGREP", "k", "0", "9", "MATCH", "x", "RE", "^y", "AND", "LIMIT", "3", "WITHVALUES",
      "NOCASE",
    ],
  )
  assertArgs(
    argrepCmd("k", u64(0), u64(9), [ArPred.Exact("a")], ArGrepOptions{ combine = ArCombine.Or }).args,
    ["ARGREP", "k", "0", "9", "EXACT", "a", "OR"],
  )
}

test "AROP names its operation, MATCH carries its value" {
  assertArgs(aropCmd("k", u64(0), u64(9), ArOp.Sum).args, ["AROP", "k", "0", "9", "SUM"])
  assertArgs(aropCmd("k", u64(0), u64(9), ArOp.Min).args, ["AROP", "k", "0", "9", "MIN"])
  assertArgs(aropCmd("k", u64(0), u64(9), ArOp.Max).args, ["AROP", "k", "0", "9", "MAX"])
  assertArgs(aropCmd("k", u64(0), u64(9), ArOp.And).args, ["AROP", "k", "0", "9", "AND"])
  assertArgs(aropCmd("k", u64(0), u64(9), ArOp.Or).args, ["AROP", "k", "0", "9", "OR"])
  assertArgs(aropCmd("k", u64(0), u64(9), ArOp.Xor).args, ["AROP", "k", "0", "9", "XOR"])
  assertArgs(aropCmd("k", u64(0), u64(9), ArOp.Used).args, ["AROP", "k", "0", "9", "USED"])
  assertArgs(
    aropCmd("k", u64(0), u64(9), ArOp.Match("3")).args,
    ["AROP", "k", "0", "9", "MATCH", "3"],
  )
}

test "an index above 2^63 decodes from a big number, a bulk string and an integer" {
  let big = asIndex(Reply.BigNumber("18446744073709551614"), "T") catch e {
    panic("big: ${e.message()}")
  }
  assert(big == bigIndex(), "big number")
  let bulk = asIndex(vbulk("9223372036854775808"), "T") catch e {
    panic("bulk: ${e.message()}")
  }
  assert(bulk == u64(9223372036854775808), "bulk")
  let small = asIndex(Reply.Int(42), "T") catch e {
    panic("int: ${e.message()}")
  }
  assert(small == u64(42), "int")
  let neg = asIndex(Reply.Int(-1), "T") catch _ {
    u64(7)
  }
  assert(neg == u64(7), "a negative integer is not an index")
  let junk = asIndex(vbulk("12x"), "T") catch _ {
    u64(7)
  }
  assert(junk == u64(7), "a non-numeric string is refused")
  let long = asIndex(vbulk("123456789012345678901"), "T") catch _ {
    u64(7)
  }
  assert(long == u64(7), "more than 20 digits is refused")
}

test "ARSCAN and ARGREP WITHVALUES decode [index, value] pairs, ARGREP indexes alone" {
  let pairs = arr(
    [
      arr([Reply.Int(0), vbulk("x")]),
      arr([Reply.BigNumber("9223372036854775809"), vbulk("y")]),
    ],
  )
  let got = asArEntries(pairs, "ARSCAN") catch e {
    panic("entries: ${e.message()}")
  }
  assert(len(got) == 2 && got[0].value == "x" && got[1].index == u64(9223372036854775809), "pairs")
  let idx = asIndexes(arr([Reply.Int(1), Reply.BigNumber("18446744073709551614")]), "ARGREP") catch e {
    panic("indexes: ${e.message()}")
  }
  assert(len(idx) == 2 && idx[1] == bigIndex(), "indexes")
  let torn = asArEntries(arr([arr([Reply.Int(0)])]), "ARSCAN") catch _ {
    []ArEntry(0)
  }
  assert(len(torn) == 0, "a pair of one is refused")
}

test "AROP decodes integers, printed numbers and an empty range" {
  let sum = asAgg(vbulk("10")) catch e {
    panic("sum: ${e.message()}")
  }
  let frac = asAgg(vbulk("2.5")) catch e {
    panic("frac: ${e.message()}")
  }
  let bits = asAgg(Reply.Int(7)) catch e {
    panic("bits: ${e.message()}")
  }
  let none = asAgg(Reply.Null) catch e {
    panic("null: ${e.message()}")
  }
  match (sum) {
    Int(n) => assert(n == 10, "sum")
    _ => panic("sum is whole")
  }
  match (frac) {
    Float(f) => assert(f == 2.5, "frac")
    _ => panic("frac is a float")
  }
  match (bits) {
    Int(n) => assert(n == 7, "bits")
    _ => panic("bits is an int")
  }
  match (none) {
    Empty => {}
    _ => panic("an empty range has no value")
  }
}

test "ARINFO decodes the counters, the big length and the FULL extras" {
  let base = [
    MapEntry{ key = vbulk("count"), value = Reply.Int(2) },
    MapEntry{ key = vbulk("len"), value = Reply.BigNumber("9223372036854775809") },
    MapEntry{ key = vbulk("next-insert-index"), value = Reply.Int(0) },
    MapEntry{ key = vbulk("slices"), value = Reply.Int(2) },
    MapEntry{ key = vbulk("slice-size"), value = Reply.Int(4096) },
  ]
  let info = asArInfo(Reply.Map(base), false) catch e {
    panic("info: ${e.message()}")
  }
  assert(
    info.count == 2 && info.len == u64(9223372036854775809) && info.sliceSize == 4096,
    "fields",
  )
  assert(info.full == Option.None, "no extras without FULL")
  let withFull = append(base, MapEntry{ key = vbulk("dense-slices"), value = Reply.Int(1) })
  let withAvg = append(
    withFull,
    MapEntry{ key = vbulk("avg-sparse-size"), value = Reply.Double(6.0) },
  )
  let withDense = append(
    withAvg,
    MapEntry{ key = vbulk("avg-dense-size"), value = Reply.Double(0.0) },
  )
  let withFill = append(
    withDense,
    MapEntry{ key = vbulk("avg-dense-fill"), value = Reply.Double(0.5) },
  )
  let full = asArInfo(Reply.Map(withFill), true) catch e {
    panic("full: ${e.message()}")
  }
  match (full.full) {
    Some(f) => assert(
      f.denseSlices == 1 && f.avgSparseSize == 6.0 && f.avgDenseFill == 0.5,
      "extras",
    )
    None => panic("FULL gives the extras")
  }
}
