// pkg/redis/vsetcmd.bit - the wire half of `vset.bit`: one `Cmd<T>` factory
// per vector set command, the argument builders behind them and the decoders
// for their replies. Epic #6013, #6028, #6040. A pure split of one family, the
// way `jsoncmd.bit` is `json.bit`'s.
//
// THE ORDER IS THE DOCS'. `VADD key [REDUCE dim] (FP32 blob | VALUES n v..)
// element [CAS] [NOQUANT | Q8 | BIN] [EF n] [SETATTR json] [M n]`; `VSIM key
// (ELE e | FP32 blob | VALUES n v..) [WITHSCORES] [WITHATTRIBS] [COUNT n]
// [EPSILON d] [EF n] [FILTER expr] [FILTER-EF n] [TRUTH] [NOTHREAD]`. Floats
// are always sent as `FP32`, never `VALUES` (`fp32Args`).
//
// `VSIM` ALWAYS ASKS FOR `WITHSCORES`, so a `Similar` always has its score;
// `WITHATTRIBS` is sent only when `SimilarOptions.withAttrs` is set. Both
// wire protocols are read: RESP3 answers a map (element -> score, or element
// -> [score, attributes]), RESP2 a flat array of two or three per element.

import { f32sToLe } from "std/math"

// One `VSIM` hit: the element, its similarity (1 is identical, 0 is
// opposite) and, when `withAttrs` was set and it has any, its JSON attributes.
export class Similar {
  export element: string,
  export score: f64,
  export attrs: Option<string> = Option.None,
}

// `VINFO`.
export class VectorSetInfo {
  export quantType: string,
  export hnswM: i64,
  export vectorDim: i64,
  export projectionInputDim: i64,
  export size: i64,
  export maxLevel: i64,
  export attributesCount: i64,
  export vsetUid: i64,
  export hnswMaxNodeUid: i64,
}

// `VEMB key element RAW`: the stored form of a vector. `quant` is the
// quantization name (`fp32`, `int8`, `bin`), `blob` the stored bytes, `norm`
// the L2 norm the vector had before quantization and `range` the Q8 range
// (`None` for the other formats).
export class VectorRaw {
  export quant: string,
  export blob: string,
  export norm: f64,
  export range: Option<f64> = Option.None,
}

// `FP32 blob`: the floats as four little-endian IEEE 754 bytes each. Floats go
// as the blob, never as `VALUES` text: it is exact for every bit pattern (a
// NaN or an infinity included), four bytes a component against up to 17
// digits, and the server reads it without parsing a number per component.
fn fp32Args(v: []f32): []string {
  return ["FP32", string(f32sToLe(v))]
}

fn vecArgs(v: Vec): []string {
  match (v) {
    Values(xs) => return fp32Args(xs)
    Fp32(blob) => return ["FP32", blob]
  }
}

fn quantArgs(q: VecQuant): []string {
  match (q) {
    Default => return []string(0)
    NoQuant => return ["NOQUANT"]
    Q8 => return ["Q8"]
    Bin => return ["BIN"]
  }
}

fn optText(name: string, v: Option<string>): []string {
  match (v) {
    Some(s) => return [name, s]
    None => return []string(0)
  }
}

fn vaddTail(opts: VectorAddOptions): []string {
  let args = []string(0)
  if (opts.cas) {
    args = append(args, "CAS")
  }
  args = append(args, ...quantArgs(opts.quant))
  args = append(args, ...optInt("EF", opts.ef))
  args = append(args, ...optText("SETATTR", opts.attrs))
  return append(args, ...optInt("M", opts.m))
}

fn vaddArgs(key: string, element: string, vector: Vec, opts: VectorAddOptions): []string {
  let args = append(["VADD", key], ...optInt("REDUCE", opts.reduce))
  args = append(args, ...vecArgs(vector))
  args = append(args, element)
  return append(args, ...vaddTail(opts))
}

fn vaddCmd(key: string, element: string, vector: Vec, opts: VectorAddOptions): Cmd<bool> {
  return Cmd<bool>{
    args = vaddArgs(key, element, vector, opts),
    decode = (r) => asBool(r, "VADD"),
    readOnly = false,
  }
}

fn similarToArgs(to: SimilarTo): []string {
  match (to) {
    Element(e) => return ["ELE", e]
    Values(xs) => return fp32Args(xs)
    Fp32(blob) => return ["FP32", blob]
  }
}

fn vsimTail(opts: SimilarOptions): []string {
  let args = optInt("COUNT", opts.count)
  args = append(args, ...optFloat("EPSILON", opts.epsilon))
  args = append(args, ...optInt("EF", opts.ef))
  match (opts.filter) {
    Some(f) => args = append(args, "FILTER", f.expr)
    None => {}
  }
  args = append(args, ...optInt("FILTER-EF", opts.filterEf))
  if (opts.truth) {
    args = append(args, "TRUTH")
  }
  if (opts.noThread) {
    args = append(args, "NOTHREAD")
  }
  return args
}

fn vsimArgs(key: string, to: SimilarTo, opts: SimilarOptions): []string {
  let args = append(["VSIM", key], ...similarToArgs(to))
  args = append(args, "WITHSCORES")
  if (opts.withAttrs) {
    args = append(args, "WITHATTRIBS")
  }
  return append(args, ...vsimTail(opts))
}

fn vsimCmd(key: string, to: SimilarTo, opts: SimilarOptions): Cmd<[]Similar> {
  let withAttrs = opts.withAttrs
  return Cmd<[]Similar>{
    args = vsimArgs(key, to, opts),
    decode = (r) => asSimilar(r, withAttrs),
    readOnly = true,
  }
}

fn vremCmd(key: string, element: string): Cmd<bool> {
  return Cmd<bool>{
    args = ["VREM", key, element],
    decode = (r) => asBool(r, "VREM"),
    readOnly = false,
  }
}

fn vcardCmd(key: string): Cmd<i64> {
  return Cmd<i64>{ args = ["VCARD", key], decode = (r) => asInt(r, "VCARD"), readOnly = true }
}

fn vdimCmd(key: string): Cmd<i64> {
  return Cmd<i64>{ args = ["VDIM", key], decode = (r) => asInt(r, "VDIM"), readOnly = true }
}

fn vismemberCmd(key: string, element: string): Cmd<bool> {
  return Cmd<bool>{
    args = ["VISMEMBER", key, element],
    decode = (r) => asBool(r, "VISMEMBER"),
    readOnly = true,
  }
}

fn vembCmd(key: string, element: string): Cmd<Option<[]f32>> {
  return Cmd<Option<[]f32>>{
    args = ["VEMB", key, element],
    decode = (r) => asEmbedding(r),
    readOnly = true,
  }
}

fn vembRawCmd(key: string, element: string): Cmd<Option<VectorRaw>> {
  return Cmd<Option<VectorRaw>>{
    args = ["VEMB", key, element, "RAW"],
    decode = (r) => asVectorRaw(r),
    readOnly = true,
  }
}

fn vgetattrCmd(key: string, element: string): Cmd<Option<string>> {
  return Cmd<Option<string>>{
    args = ["VGETATTR", key, element],
    decode = (r) => asOptString(r, "VGETATTR"),
    readOnly = true,
  }
}

fn vsetattrCmd(key: string, element: string, json: string): Cmd<bool> {
  return Cmd<bool>{
    args = ["VSETATTR", key, element, json],
    decode = (r) => asBool(r, "VSETATTR"),
    readOnly = false,
  }
}

fn vinfoCmd(key: string): Cmd<Option<VectorSetInfo>> {
  return Cmd<Option<VectorSetInfo>>{
    args = ["VINFO", key],
    decode = (r) => asVectorSetInfo(r),
    readOnly = true,
  }
}

fn vlinksCmd(key: string, element: string): Cmd<Option<[][]string>> {
  return Cmd<Option<[][]string>>{
    args = ["VLINKS", key, element],
    decode = (r) => asLinks(r),
    readOnly = true,
  }
}

fn vlinksScoredCmd(key: string, element: string): Cmd<Option<[][]Scored>> {
  return Cmd<Option<[][]Scored>>{
    args = ["VLINKS", key, element, "WITHSCORES"],
    decode = (r) => asLinksScored(r),
    readOnly = true,
  }
}

fn vrandmemberCmd(key: string): Cmd<Option<string>> {
  return Cmd<Option<string>>{
    args = ["VRANDMEMBER", key],
    decode = (r) => asOptString(r, "VRANDMEMBER"),
    readOnly = true,
  }
}

fn vrandmembersCmd(key: string, count: i64): Cmd<[]string> {
  return Cmd<[]string>{
    args = ["VRANDMEMBER", key, "${count}"],
    decode = (r) => asStrings(r, "VRANDMEMBER"),
    readOnly = true,
  }
}

// ------------------------------------------------------------------ decoders

// `VSIM`'s reply: RESP3's map or RESP2's flat array, one `Similar` each.
fn asSimilar(r: Reply, withAttrs: bool): []Similar!RedisError {
  match (r) {
    Map(entries) => return similarFromMap(entries, withAttrs)?
    Array(items) => return similarFromFlat(unwrapOr(items, []Reply(0)), withAttrs)?
    Null => return []Similar(0)
    _ => fail RedisError.Unexpected("VSIM", shapeName(r))
  }
}

fn similarFromMap(entries: []MapEntry, withAttrs: bool): []Similar!RedisError {
  let out = []Similar(0)
  for e of entries {
    let element = replyToString(e.key, "VSIM")?
    out = append(out, similarOf(element, e.value, withAttrs)?)
  }
  return out
}

// `value` is the score, or `[score, attributes]` when attributes were asked.
fn similarOf(element: string, value: Reply, withAttrs: bool): Similar!RedisError {
  if (!withAttrs) {
    return Similar{ element = element, score = asDouble(value, "VSIM")? }
  }
  let pair = replyItems(value, "VSIM")?
  if (len(pair) != 2) {
    fail RedisError.Unexpected("VSIM", "Array")
  }
  return Similar{
    element = element,
    score = asDouble(pair[0], "VSIM")?,
    attrs = asOptString(pair[1], "VSIM")?,
  }
}

fn similarFromFlat(list: []Reply, withAttrs: bool): []Similar!RedisError {
  let stride = 2
  if (withAttrs) {
    stride = 3
  }
  if (len(list) % stride != 0) {
    fail RedisError.Unexpected("VSIM", "Array")
  }
  let out = []Similar(0)
  let i = 0
  while (i < len(list)) {
    let element = replyToString(list[i], "VSIM")?
    let value = list[i + 1]
    if (withAttrs) {
      value = Reply.Array(Option.Some([list[i + 1], list[i + 2]]))
    }
    out = append(out, similarOf(element, value, withAttrs)?)
    i = i + stride
  }
  return out
}

fn asEmbedding(r: Reply): Option<[]f32>!RedisError {
  match (r) {
    Null => return Option.None
    Array(items) => return Option.Some(f32sOf(unwrapOr(items, []Reply(0)))?)
    _ => fail RedisError.Unexpected("VEMB", shapeName(r))
  }
}

fn f32sOf(list: []Reply): []f32!RedisError {
  let out = []f32(0)
  for x of list {
    out = append(out, f32(asDouble(x, "VEMB")?))
  }
  return out
}

fn asVectorRaw(r: Reply): Option<VectorRaw>!RedisError {
  match (r) {
    Null => return Option.None
    Array(items) => return Option.Some(rawOf(unwrapOr(items, []Reply(0)))?)
    _ => fail RedisError.Unexpected("VEMB", shapeName(r))
  }
}

fn rawOf(list: []Reply): VectorRaw!RedisError {
  if (len(list) < 3) {
    fail RedisError.Unexpected("VEMB", "Array")
  }
  let range: Option<f64> = Option.None
  if (len(list) > 3) {
    range = Option.Some(asDouble(list[3], "VEMB")?)
  }
  return VectorRaw{
    quant = replyToString(list[0], "VEMB")?,
    blob = replyToString(list[1], "VEMB")?,
    norm = asDouble(list[2], "VEMB")?,
    range = range,
  }
}

fn asVectorSetInfo(r: Reply): Option<VectorSetInfo>!RedisError {
  match (r) {
    Null => return Option.None
    _ => return Option.Some(infoOf(sketchPairs(r, "VINFO")?)?)
  }
}

fn infoOf(p: []MapEntry): VectorSetInfo!RedisError {
  return VectorSetInfo{
    quantType = replyToString(infoFind(p, "quant-type"), "VINFO")?,
    hnswM = sketchField(p, "hnsw-m", "VINFO")?,
    vectorDim = sketchField(p, "vector-dim", "VINFO")?,
    projectionInputDim = sketchField(p, "projection-input-dim", "VINFO")?,
    size = sketchField(p, "size", "VINFO")?,
    maxLevel = sketchField(p, "max-level", "VINFO")?,
    attributesCount = sketchField(p, "attributes-count", "VINFO")?,
    vsetUid = sketchField(p, "vset-uid", "VINFO")?,
    hnswMaxNodeUid = sketchField(p, "hnsw-max-node-uid", "VINFO")?,
  }
}

// `VLINKS`: one list of neighbours per graph level, level 0 first.
fn asLinks(r: Reply): Option<[][]string>!RedisError {
  match (r) {
    Null => return Option.None
    _ => return Option.Some(sketchList<[]string>(r, "VLINKS", (l) => asStrings(l, "VLINKS"))?)
  }
}

// `VLINKS ... WITHSCORES`: each level a map (RESP3) or a flat array (RESP2).
fn asLinksScored(r: Reply): Option<[][]Scored>!RedisError {
  match (r) {
    Null => return Option.None
    _ => return Option.Some(sketchList<[]Scored>(r, "VLINKS", (l) => linksLevel(l))?)
  }
}

fn linksLevel(l: Reply): []Scored!RedisError {
  let pairs = sketchPairs(l, "VLINKS")?
  let out = []Scored(0)
  for p of pairs {
    out = append(
      out,
      Scored{ member = replyToString(p.key, "VLINKS")?, score = asDouble(p.value, "VLINKS")? },
    )
  }
  return out
}
