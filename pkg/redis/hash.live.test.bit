// pkg/redis/hash.live.test.bit — `r.hash(key)` against a real server.
// `liveUrl`/`liveClient` are `client.live.test.bit`'s own (this file is the
// same module, epic #6013's own convention — no import needed); every test
// is skipped, and says so, when `REDIS_TEST_URL` is unset, same as every
// other live test in this package. `./make test-package-redis-live`
// (`_tests_/bit/redislive.bit`) is what actually supplies it, against
// `redis:8.10.2` in a throwaway Docker container.

import { now } from "std/time"

fn cleanHash(c: Client, key: string): Hash {
  c.del([key]) catch e {
    panic("del(${key}): ${e.message()}")
  }
  return c.hash(key)
}

test "live: HSET/HGET/HMGET/HGETALL/HDEL/HEXISTS round-trip a hash" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let h = cleanHash(c, "bit:live:hash:profile")

  let added = h.set(map<string, string>{ "name": "Ada", "lang": "bit" }) catch e {
    panic("set: ${e.message()}")
  }
  assert(added == 2, "expected 2 fields added, got ${added}")

  let name = h.get("name") catch e {
    panic("get: ${e.message()}")
  }
  match (name) {
    Some(v) => assert(v == "Ada", "get('name') = '${v}'")
    None => panic("get('name') returned no value")
  }

  let missing = h.get("missing") catch e {
    panic("get: ${e.message()}")
  }
  match (missing) {
    Some(v) => panic("get('missing') returned Some('${v}')")
    None => {}
  }

  let many = h.getMany("name", "missing", "lang") catch e {
    panic("getMany: ${e.message()}")
  }
  assert(len(many) == 3, "expected 3 results, got ${len(many)}")
  assert(isSome(many[0]) && unwrap(many[0]) == "Ada", "many[0] should be Some('Ada')")
  assert(isNone(many[1]), "many[1] should be None")

  let all = h.all() catch e {
    panic("all: ${e.message()}")
  }
  assert(
    all["name"] == "Ada" && all["lang"] == "bit",
    "all['name']='${all["name"]}' all['lang']='${all["lang"]}'",
  )

  let existed = h.has("name") catch e {
    panic("has: ${e.message()}")
  }
  assert(existed, "has('name') should be true")

  let created = h.setIfAbsent("name", "Grace") catch e {
    panic("setIfAbsent: ${e.message()}")
  }
  assert(!created, "setIfAbsent on an existing field should be false")

  let removed = h.del("lang") catch e {
    panic("del: ${e.message()}")
  }
  assert(removed == 1, "expected 1 field removed, got ${removed}")
  c.close()
}

test "live: HINCRBY and HINCRBYFLOAT accumulate on a fresh field" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let h = cleanHash(c, "bit:live:hash:counters")

  let n = h.incrBy("visits", 3) catch e {
    panic("incrBy: ${e.message()}")
  }
  assert(n == 3, "incrBy = ${n}")
  let n2 = h.incrBy("visits", 2) catch e {
    panic("incrBy: ${e.message()}")
  }
  assert(n2 == 5, "incrBy again = ${n2}")

  let f = h.incrByFloat("rating", 1.5) catch e {
    panic("incrByFloat: ${e.message()}")
  }
  assert(f == 1.5, "incrByFloat = ${f}")
  c.close()
}

test "live: HKEYS/HVALS/HLEN/HSTRLEN describe a hash's fields" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let h = cleanHash(c, "bit:live:hash:describe")
  h.set(map<string, string>{ "name": "Ada", "lang": "bit" }) catch e {
    panic("set: ${e.message()}")
  }

  let keys = h.keys() catch e {
    panic("keys: ${e.message()}")
  }
  assert(len(keys) == 2, "expected 2 keys, got ${len(keys)}")

  let values = h.values() catch e {
    panic("values: ${e.message()}")
  }
  assert(len(values) == 2, "expected 2 values, got ${len(values)}")

  let n = h.len() catch e {
    panic("len: ${e.message()}")
  }
  assert(n == 2, "len = ${n}")

  let sl = h.strLen("name") catch e {
    panic("strLen: ${e.message()}")
  }
  assert(sl == 3, "strLen('name') = ${sl}")
  c.close()
}

test "live: HRANDFIELD returns count fields, WITHVALUES pairs them up" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let h = cleanHash(c, "bit:live:hash:random")
  h.set(map<string, string>{ "a": "1", "b": "2", "c": "3" }) catch e {
    panic("set: ${e.message()}")
  }

  let fields = h.random(2) catch e {
    panic("random: ${e.message()}")
  }
  assert(len(fields) == 2, "expected 2 fields, got ${len(fields)}")

  let pairs = h.random(2, true) catch e {
    panic("random withValues: ${e.message()}")
  }
  assert(len(pairs) == 4, "expected 4 entries (2 pairs), got ${len(pairs)}")
  c.close()
}

// 500 fields, `count = 10`: HSCAN's own default COUNT hint is 10, so this
// forces the iterator through multiple cursor pages before it sees "0".
test "live: HSCAN walks every field across more than one cursor page" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let h = cleanHash(c, "bit:live:hash:scan")

  let fields = map<string, string>()
  let i = 0
  while (i < 500) {
    fields["field:${i}"] = "value:${i}"
    i = i + 1
  }
  h.set(fields) catch e {
    panic("set: ${e.message()}")
  }

  let it = h.scan("", 10)
  let seen = map<string, string>()
  let pages = 0
  let next = it.next() catch e {
    panic("scan: ${e.message()}")
  }
  while (isSome(next)) {
    let (field, value) = unwrap(next)
    seen[field] = value
    pages = pages + 1
    next = it.next() catch e {
      panic("scan: ${e.message()}")
    }
  }
  assert(pages == 500, "expected to walk 500 fields, got ${pages}")
  assert(seen["field:0"] == "value:0", "seen['field:0'] = '${seen["field:0"]}'")
  assert(seen["field:499"] == "value:499", "seen['field:499'] = '${seen["field:499"]}'")
  c.close()
}

test "live: hash field expiry sets, reads and clears TTLs" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let h = cleanHash(c, "bit:live:hash:expiry")
  h.set(map<string, string>{ "a": "1", "b": "2" }) catch e {
    panic("set: ${e.message()}")
  }

  let expired = h.expire(["a"], 60 * Second) catch e {
    panic("expire: ${e.message()}")
  }
  assert(len(expired) == 1 && expired[0] == 1, "expire = ${expired[0]}")

  let ttl = h.ttl(["a", "b"]) catch e {
    panic("ttl: ${e.message()}")
  }
  assert(ttl[0] > 0 && ttl[0] <= 60, "ttl('a') = ${ttl[0]}")
  assert(ttl[1] == -1, "ttl('b') (no TTL) = ${ttl[1]}")

  let pttl = h.pttl(["a"]) catch e {
    panic("pttl: ${e.message()}")
  }
  assert(pttl[0] > 0, "pttl('a') = ${pttl[0]}")

  let persisted = h.persist(["a"]) catch e {
    panic("persist: ${e.message()}")
  }
  assert(persisted[0] == 1, "persist = ${persisted[0]}")

  let ttlAfter = h.ttl(["a"]) catch e {
    panic("ttl: ${e.message()}")
  }
  assert(ttlAfter[0] == -1, "ttl('a') after persist = ${ttlAfter[0]}")

  let atSeconds = now().ns / Second + 120
  let expiredAt = h.expireAt(["b"], atSeconds * Second) catch e {
    panic("expireAt: ${e.message()}")
  }
  assert(expiredAt[0] == 1, "expireAt = ${expiredAt[0]}")

  let missingField = h.ttl(["nope"]) catch e {
    panic("ttl: ${e.message()}")
  }
  assert(missingField[0] == -2, "ttl on a missing field = ${missingField[0]}")
  c.close()
}

test "live: HGETEX/HSETEX/HGETDEL manage TTLs alongside reads and writes" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let h = cleanHash(c, "bit:live:hash:getsetex")

  let set = h.setEx(map<string, string>{ "a": "1" }, 60 * Second) catch e {
    panic("setEx: ${e.message()}")
  }
  assert(set, "setEx should report success")

  let ttlAfterSetEx = h.ttl(["a"]) catch e {
    panic("ttl: ${e.message()}")
  }
  assert(ttlAfterSetEx[0] > 0, "ttl after setEx = ${ttlAfterSetEx[0]}")

  let notCreated = h.setEx(map<string, string>{ "a": "2" }, 60 * Second, "FNX") catch e {
    panic("setEx FNX: ${e.message()}")
  }
  assert(!notCreated, "FNX should refuse an existing field")

  let read = h.getEx(["a"], 0, true) catch e {
    panic("getEx: ${e.message()}")
  }
  assert(isSome(read[0]) && unwrap(read[0]) == "1", "getEx should return Some('1')")

  let ttlAfterPersist = h.ttl(["a"]) catch e {
    panic("ttl: ${e.message()}")
  }
  assert(ttlAfterPersist[0] == -1, "ttl after getEx(persist) = ${ttlAfterPersist[0]}")

  let removed = h.getDel("a") catch e {
    panic("getDel: ${e.message()}")
  }
  assert(isSome(removed[0]) && unwrap(removed[0]) == "1", "getDel should return Some('1')")

  let goneNow = h.has("a") catch e {
    panic("has: ${e.message()}")
  }
  assert(!goneNow, "field should be gone after getDel")
  c.close()
}

test "live: a pipeline and a transaction can both queue hash commands" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:hash:queued"
  c.del([key]) catch e {
    panic("del: ${e.message()}")
  }

  let p = c.pipeline()
  let setFuture = p.hash(key).setField("a", "1")
  let getFuture = p.hash(key).get("a")
  p.exec() catch e {
    panic("pipeline exec: ${e.message()}")
  }
  let created = setFuture.get() catch e {
    panic("setFuture.get: ${e.message()}")
  }
  assert(created, "pipelined setField should report the field as new")
  let got = getFuture.get() catch e {
    panic("getFuture.get: ${e.message()}")
  }
  match (got) {
    Some(v) => assert(v == "1", "pipelined get = '${v}'")
    None => panic("pipelined get returned no value")
  }
  c.close()
}

test "live: tx.read.hash reads fields before the queued write runs, and refuses a write" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:hash:txread"
  let h = cleanHash(c, key)
  h.setField("name", "ada") catch e {
    panic("seed: ${e.message()}")
  }
  let out = c.transaction<Future<bool>>([key], (tx) => {
    let queued = tx.hash(key).setField("name", "grace")
    let r = tx.read.hash(key)
    match (r.get("name")?) {
      Some(v) => assert(v == "ada", "get saw '${v}', not the pre-EXEC 'ada'")
      None => panic("get saw no name")
    }
    let size = r.len()?
    assert(size == 1, "len = ${size}")
    let everything = r.all()?
    assert(everything["name"] == "ada", "all saw the pre-EXEC field")
    let it = r.scan()
    let seen = 0
    let next = it.next()?
    while (isSome(next)) {
      let (field, value) = unwrap(next)
      assert(field == "name" && value == "ada", "scan saw ${field}=${value}")
      seen = seen + 1
      next = it.next()?
    }
    assert(seen == 1, "scan yielded ${seen} fields")
    let refused = false
    let _ = r.setField("name", "eve") catch _ {
      refused = true
      false
    }
    assert(refused, "a write through tx.read is refused")
    return queued
  }) catch e {
    panic("transaction: ${e.message()}")
  }
  let changed = out.get() catch e {
    panic("future: ${e.message()}")
  }
  assert(!changed, "HSET reports the existing field as updated, not created")
  let name = c.hash(key).get("name") catch e {
    panic("get after: ${e.message()}")
  }
  match (name) {
    Some(v) => assert(v == "grace", "after EXEC '${v}': the refused 'eve' never landed")
    None => panic("name vanished")
  }
  c.del([key]) catch e {
    panic("del: ${e.message()}")
  }
  c.close()
}
