// pkg/redis/uri.test.bit — `parseUrl` (#6022, epic #6013). Nothing here
// opens a socket: `parseUrl` is a pure function of the URL string, so every
// form and every malformed input can be pinned with no server.

fn mustOpts(url: string): Options {
  return parseUrl(url) catch e {
    panic("parseUrl(${url}): ${e.message()}")
  }
}

fn refuses(url: string): string {
  let o = parseUrl(url) catch e {
    return e.message()
  }
  panic("parseUrl(${url}) was accepted, host ${o.host}")
}

test "a bare host takes every other default" {
  let o = mustOpts("redis://cache")
  assert(o.host == "cache", "host: ${o.host}")
  assert(o.port == 6379, "port: ${o.port}")
  assert(o.username == "", "username: '${o.username}'")
  assert(o.password == "", "password: '${o.password}'")
  assert(o.db == 0, "db: ${o.db}")
  assert(!o.tls, "redis:// must not turn tls on")
}

test "rediss:// turns tls on, otherwise identically to redis://" {
  let o = mustOpts("rediss://cache:6380")
  assert(o.host == "cache", "host: ${o.host}")
  assert(o.port == 6380, "port: ${o.port}")
  assert(o.tls, "rediss:// must turn tls on")
}

test "a password with no username is Redis's ACL-less form" {
  let o = mustOpts("redis://:secret@cache:6380")
  assert(o.username == "", "username: '${o.username}'")
  assert(o.password == "secret", "password: '${o.password}'")
  assert(o.host == "cache", "host: ${o.host}")
  assert(o.port == 6380, "port: ${o.port}")
}

test "user and password both parse" {
  let o = mustOpts("redis://app:pw@cache:6380")
  assert(o.username == "app", "username: '${o.username}'")
  assert(o.password == "pw", "password: '${o.password}'")
}

test "the path names a database index" {
  let o = mustOpts("redis://cache/2")
  assert(o.db == 2, "db: ${o.db}")
}

test "no path leaves db at 0" {
  let o = mustOpts("redis://cache")
  assert(o.db == 0, "db: ${o.db}")
}

test "percent-decodes a password containing a reserved character" {
  let o = mustOpts("redis://:p%40ss%2Fw%3Ford@cache")
  assert(o.password == "p@ss/w?ord", "password: '${o.password}'")
}

test "percent-decodes the username too" {
  let o = mustOpts("redis://us%40er:pw@cache")
  assert(o.username == "us@er", "username: '${o.username}'")
}

test "timeout= sets both connectTimeout and commandTimeout, in seconds" {
  let o = mustOpts("redis://cache?timeout=2s")
  assert(o.connectTimeout == 2000000000, "connectTimeout: ${o.connectTimeout}")
  assert(o.commandTimeout == 2000000000, "commandTimeout: ${o.commandTimeout}")
}

test "timeout= accepts milliseconds" {
  let o = mustOpts("redis://cache?timeout=250ms")
  assert(o.connectTimeout == 250000000, "connectTimeout: ${o.connectTimeout}")
}

test "pool= sets poolSize" {
  let o = mustOpts("redis://cache?pool=16")
  assert(o.poolSize == 16, "poolSize: ${o.poolSize}")
}

test "name= sets clientName, percent-decoded" {
  let o = mustOpts("redis://cache?name=checkout%20api")
  assert(o.clientName == "checkout api", "clientName: '${o.clientName}'")
}

test "every query parameter together" {
  let o = mustOpts("redis://app:pw@cache:6380/3?timeout=5s&pool=16&name=app")
  assert(o.host == "cache", "host: ${o.host}")
  assert(o.port == 6380, "port: ${o.port}")
  assert(o.username == "app", "username: '${o.username}'")
  assert(o.password == "pw", "password: '${o.password}'")
  assert(o.db == 3, "db: ${o.db}")
  assert(o.connectTimeout == 5000000000, "connectTimeout: ${o.connectTimeout}")
  assert(o.poolSize == 16, "poolSize: ${o.poolSize}")
  assert(o.clientName == "app", "clientName: '${o.clientName}'")
}

test "a URL with no scheme is refused" {
  let msg = refuses("cache:6379")
  assert(contains(msg, "redis://"), "message: ${msg}")
}

test "a postgres:// URL is refused by scheme" {
  let msg = refuses("postgres://app@cache/db")
  assert(contains(msg, "redis://"), "message: ${msg}")
}

test "a URL with no host is refused" {
  let msg = refuses("redis://:secret@")
  assert(contains(msg, "no host") || contains(msg, "names no host"), "message: ${msg}")
}

test "an out-of-range port is refused" {
  let msg = refuses("redis://cache:70000")
  assert(contains(msg, "range"), "message: ${msg}")
}

test "a non-numeric port is refused" {
  let msg = refuses("redis://cache:abc")
  assert(contains(msg, "number"), "message: ${msg}")
}

test "a non-numeric db path is refused" {
  let msg = refuses("redis://cache/not-a-number")
  assert(contains(msg, "number"), "message: ${msg}")
}

test "an unrecognised query parameter is refused, not silently ignored" {
  let msg = refuses("redis://cache?ssl=true")
  assert(contains(msg, "ssl"), "message: ${msg}")
}

test "a timeout with no unit is refused" {
  let msg = refuses("redis://cache?timeout=5")
  assert(contains(msg, "timeout"), "message: ${msg}")
}

test "a truncated percent-escape is refused" {
  let msg = refuses("redis://:se%4@cache")
  assert(contains(msg, "percent-escape"), "message: ${msg}")
}

test "a non-hex percent-escape is refused" {
  let msg = refuses("redis://:se%zzcret@cache")
  assert(contains(msg, "percent-escape"), "message: ${msg}")
}

test "Options{} alone is a complete, working configuration" {
  let o = Options{}
  assert(o.host == "127.0.0.1", "host: ${o.host}")
  assert(o.port == 6379, "port: ${o.port}")
  assert(!o.tls, "tls: ${o.tls}")
  assert(!o.insecureSkipVerify, "insecureSkipVerify: ${o.insecureSkipVerify}")
  assert(o.poolSize == 10, "poolSize: ${o.poolSize}")
  assert(o.protocol == 3, "protocol: ${o.protocol}")
}
