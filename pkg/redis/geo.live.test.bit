// pkg/redis/geo.live.test.bit - `r.geo(key)` against a real server.
// `liveUrl`/`liveClient` are `client.live.test.bit`'s own (same module, no
// import); every test is skipped, and says so, when `REDIS_TEST_URL` is unset.
// `./make test-package-redis-live` (`_tests_/bit/redislive.bit`) supplies it,
// against `redis:8.10.2` in a throwaway Docker container.
//
// The map: four German cities, whose great-circle distances from Berlin are
// about 26.7 km (Potsdam), 255.3 km (Hamburg) and 504.6 km (Munich).

fn geoCities(c: Client, key: string): Geo {
  c.del([key]) catch e {
    panic("del(${key}): ${e.message()}")
  }
  let g = c.geo(key)
  let n = g.add(
    [
      place("berlin", 13.405, 52.52),
      place("potsdam", 13.0645, 52.3989),
      place("hamburg", 9.9937, 53.5511),
      place("munich", 11.582, 48.1351),
    ],
  ) catch e {
    panic("add cities: ${e.message()}")
  }
  assert(n == 4, "four cities added, got ${n}")
  return g
}

fn geoNear(got: f64, want: f64, tol: f64): bool {
  return got > want - tol && got < want + tol
}

fn geoNames(hits: []GeoHit): string {
  let out = ""
  for h of hits {
    out = out + h.member + ","
  }
  return out
}

fn geoIsServerError(e: RedisError): bool {
  match (e) {
    Server(_, _) => return true
    _ => return false
  }
}

test "live: geo add, pos, dist and hash answer for placed and missing members" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let g = geoCities(c, "bit:live:geo:cities")

  let ps = g.pos("berlin", "nowhere", "potsdam") catch e {
    panic("pos: ${e.message()}")
  }
  assert(len(ps) == 3, "pos answers one slot per member, got ${len(ps)}")
  assert(geoNear(unwrap(ps[0]).lon, 13.405, 0.0001), "berlin lon = ${unwrap(ps[0]).lon}")
  assert(geoNear(unwrap(ps[0]).lat, 52.52, 0.0001), "berlin lat = ${unwrap(ps[0]).lat}")
  assert(isNone(ps[1]), "a missing member has no position")
  assert(geoNear(unwrap(ps[2]).lon, 13.0645, 0.0001), "potsdam lon = ${unwrap(ps[2]).lon}")

  let km = g.dist("berlin", "potsdam", GeoUnit.Kilometers) catch e {
    panic("dist km: ${e.message()}")
  }
  assert(geoNear(unwrap(km), 26.72, 0.05), "berlin to potsdam in km = ${unwrap(km)}")
  let m = g.dist("berlin", "potsdam") catch e {
    panic("dist m: ${e.message()}")
  }
  assert(geoNear(unwrap(m), 26719.9, 50.0), "berlin to potsdam in m (the default) = ${unwrap(m)}")
  let mi = g.dist("berlin", "potsdam", GeoUnit.Miles) catch e {
    panic("dist mi: ${e.message()}")
  }
  assert(geoNear(unwrap(mi), 16.6, 0.1), "berlin to potsdam in mi = ${unwrap(mi)}")
  let ft = g.dist("berlin", "potsdam", GeoUnit.Feet) catch e {
    panic("dist ft: ${e.message()}")
  }
  assert(geoNear(unwrap(ft), 87660.0, 200.0), "berlin to potsdam in ft = ${unwrap(ft)}")
  let none = g.dist("berlin", "nowhere") catch e {
    panic("dist missing: ${e.message()}")
  }
  assert(isNone(none), "a missing member has no distance")

  let hs = g.hash("berlin", "nowhere") catch e {
    panic("hash: ${e.message()}")
  }
  assert(len(hs) == 2, "hash answers one slot per member, got ${len(hs)}")
  assert(unwrap(hs[0]) == "u33dc0cppj0", "berlin geohash = ${unwrap(hs[0])}")
  assert(isNone(hs[1]), "a missing member has no geohash")
  c.close()
}

test "live: geo add honours NX, XX and CH" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let g = geoCities(c, "bit:live:geo:flags")
  let moved = [place("berlin", 13.5, 52.6)]

  let nx = g.add(moved, GeoAddOptions{ nx = true }) catch e {
    panic("add nx: ${e.message()}")
  }
  assert(nx == 0, "NX adds nothing for an existing member, got ${nx}")
  let still = g.pos("berlin") catch e {
    panic("pos: ${e.message()}")
  }
  assert(geoNear(unwrap(still[0]).lon, 13.405, 0.0001), "NX left berlin where it was")

  let xxNew = g.add([place("bonn", 7.1, 50.7)], GeoAddOptions{ xx = true }) catch e {
    panic("add xx: ${e.message()}")
  }
  assert(xxNew == 0, "XX adds no new member, got ${xxNew}")
  let bonn = g.pos("bonn") catch e {
    panic("pos bonn: ${e.message()}")
  }
  assert(isNone(bonn[0]), "XX did not create bonn")

  let plain = g.add(moved) catch e {
    panic("add plain: ${e.message()}")
  }
  assert(plain == 0, "moving a member counts no new member, got ${plain}")
  let ch = g.add([place("berlin", 13.6, 52.7)], GeoAddOptions{ ch = true }) catch e {
    panic("add ch: ${e.message()}")
  }
  assert(ch == 1, "CH counts the moved member, got ${ch}")
  let after = g.pos("berlin") catch e {
    panic("pos after: ${e.message()}")
  }
  assert(geoNear(unwrap(after[0]).lat, 52.7, 0.0001), "berlin moved to lat 52.7")
  c.close()
}

test "live: geo add refuses bad coordinates before sending and surfaces the server's own error" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:geo:bad"
  c.del([key]) catch e {
    panic("del: ${e.message()}")
  }
  let g = c.geo(key)
  let refused = false
  let _ = g.add([place("a", 1.0, 1.0), place("far", 181.0, 0.0)]) catch e {
    refused = isInvalid(e)
    0
  }
  assert(refused, "longitude 181 is Invalid")
  let left = c.exists([key]) catch e {
    panic("exists: ${e.message()}")
  }
  assert(left == 0, "the good first member was not sent either")

  let both = false
  let _ = g.add([place("a", 1.0, 1.0)], GeoAddOptions{ nx = true, xx = true }) catch e {
    both = geoIsServerError(e)
    0
  }
  assert(both, "NX with XX reaches the caller as the server's error")
  c.close()
}

test "live: geo search by radius from a member sorts, counts and carries dist, hash and coordinates" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let g = geoCities(c, "bit:live:geo:radius")
  let from = GeoFrom.Member("berlin")
  let r300 = GeoBy.Radius(300.0, GeoUnit.Kilometers)

  let near = g.search(from, r300, GeoSearchOptions{ order = GeoOrder.Nearest }) catch e {
    panic("search: ${e.message()}")
  }
  assert(geoNames(near) == "berlin,potsdam,hamburg,", "nearest first = ${geoNames(near)}")
  assert(
    isNone(near[0].dist) && isNone(near[0].hash) && isNone(near[0].at),
    "no WITH flag, no extras",
  )

  let far = g.search(from, r300, GeoSearchOptions{ order = GeoOrder.Farthest }) catch e {
    panic("search desc: ${e.message()}")
  }
  assert(geoNames(far) == "hamburg,potsdam,berlin,", "farthest first = ${geoNames(far)}")

  let top2 = g.search(from, r300, GeoSearchOptions{ order = GeoOrder.Nearest, count = 2 }) catch e {
    panic("search count: ${e.message()}")
  }
  assert(geoNames(top2) == "berlin,potsdam,", "count 2 = ${geoNames(top2)}")

  let all = GeoSearchOptions{
    order = GeoOrder.Nearest,
    withCoord = true,
    withDist = true,
    withHash = true,
  }
  let full = g.search(from, r300, all) catch e {
    panic("search with: ${e.message()}")
  }
  assert(len(full) == 3, "three cities within 300 km, got ${len(full)}")
  assert(geoNear(unwrap(full[1].dist), 26.72, 0.05), "potsdam dist in km = ${unwrap(full[1].dist)}")
  assert(unwrap(full[1].hash) == 3673911213912111, "potsdam hash = ${unwrap(full[1].hash)}")
  assert(
    geoNear(unwrap(full[1].at).lon, 13.0645, 0.0001),
    "potsdam lon = ${unwrap(full[1].at).lon}",
  )
  assert(geoNear(unwrap(full[2].dist), 255.32, 0.1), "hamburg dist in km = ${unwrap(full[2].dist)}")

  let onlyDist = g.search(
    from,
    GeoBy.Radius(30000.0, GeoUnit.Meters),
    GeoSearchOptions{ withDist = true },
  ) catch e {
    panic("search dist: ${e.message()}")
  }
  assert(len(onlyDist) == 2, "two cities within 30 km, got ${len(onlyDist)}")
  let pot = onlyDist[0]
  if (pot.member == "berlin") {
    pot = onlyDist[1]
  }
  assert(geoNear(unwrap(pot.dist), 26719.9, 50.0), "dist is in the unit asked: ${unwrap(pot.dist)}")
  assert(isNone(pot.hash) && isNone(pot.at), "WITHDIST alone carries no hash or coordinates")

  let onlyCoord = g.search(
    from,
    GeoBy.Radius(30.0, GeoUnit.Kilometers),
    GeoSearchOptions{ withCoord = true },
  ) catch e {
    panic("search coord: ${e.message()}")
  }
  assert(
    isSome(onlyCoord[0].at) && isNone(onlyCoord[0].dist),
    "WITHCOORD alone carries only coordinates",
  )

  let empty = g.search(from, GeoBy.Radius(1.0, GeoUnit.Meters), GeoSearchOptions{ withDist = true }) catch e {
    panic("search tiny: ${e.message()}")
  }
  assert(len(empty) == 1 && empty[0].member == "berlin", "only berlin itself within 1 m")
  c.close()
}

test "live: geo search by box from a point, with any, and an unknown member is the server's error" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let g = geoCities(c, "bit:live:geo:box")
  let centre = GeoFrom.At(Point{ lon = 13.4, lat = 52.5 })

  let box = g.search(
    centre,
    GeoBy.Box(100.0, 100.0, GeoUnit.Kilometers),
    GeoSearchOptions{ order = GeoOrder.Nearest },
  ) catch e {
    panic("box: ${e.message()}")
  }
  assert(geoNames(box) == "berlin,potsdam,", "100 km box around Berlin = ${geoNames(box)}")

  let wide = g.search(
    centre,
    GeoBy.Box(1200.0, 1200.0, GeoUnit.Kilometers),
    GeoSearchOptions{ count = 2, any = true },
  ) catch e {
    panic("any: ${e.message()}")
  }
  assert(len(wide) == 2, "ANY with COUNT 2 stops at two, got ${len(wide)}")

  let feet = g.search(centre, GeoBy.Box(300000.0, 300000.0, GeoUnit.Feet), GeoSearchOptions{}) catch e {
    panic("feet: ${e.message()}")
  }
  assert(len(feet) == 2, "a 300000 ft box holds Berlin and Potsdam, got ${len(feet)}")
  let miles = g.search(centre, GeoBy.Radius(200.0, GeoUnit.Miles), GeoSearchOptions{}) catch e {
    panic("miles: ${e.message()}")
  }
  assert(len(miles) == 3, "200 miles reach Hamburg too, got ${len(miles)}")

  let unknown = false
  let _ = g.search(GeoFrom.Member("atlantis"), GeoBy.Radius(1.0, GeoUnit.Meters)) catch e {
    unknown = geoIsServerError(e)
    []GeoHit(0)
  }
  assert(unknown, "an unknown FROMMEMBER is the server's error")

  let offMap = false
  let _ = g.search(GeoFrom.At(Point{ lon = 0.0, lat = 89.0 }), GeoBy.Radius(1.0, GeoUnit.Meters)) catch e {
    offMap = isInvalid(e)
    []GeoHit(0)
  }
  assert(offMap, "a centre at latitude 89 is Invalid")
  c.close()
}

test "live: geo searchStore writes a geo key, or distances with storeDist" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let g = geoCities(c, "bit:live:geo:src")
  let dst = "bit:live:geo:dst"
  let dstDist = "bit:live:geo:dstdist"
  c.del([dst, dstDist]) catch e {
    panic("del: ${e.message()}")
  }
  let from = GeoFrom.Member("berlin")
  let by = GeoBy.Radius(300.0, GeoUnit.Kilometers)

  let n = g.searchStore(dst, from, by) catch e {
    panic("searchStore: ${e.message()}")
  }
  assert(n == 3, "three members stored, got ${n}")
  let there = c.geo(dst).search(
    from,
    GeoBy.Radius(30.0, GeoUnit.Kilometers),
    GeoSearchOptions{ order = GeoOrder.Nearest },
  ) catch e {
    panic("search stored: ${e.message()}")
  }
  assert(geoNames(there) == "berlin,potsdam,", "the stored key is a geo key: ${geoNames(there)}")

  let m = g.searchStore(
    dstDist,
    from,
    by,
    GeoStoreOptions{ order = GeoOrder.Nearest, count = 2, storeDist = true },
  ) catch e {
    panic("searchStore dist: ${e.message()}")
  }
  assert(m == 2, "COUNT 2 stores two, got ${m}")
  let score = c.zset(dstDist).score("potsdam") catch e {
    panic("score: ${e.message()}")
  }
  assert(
    geoNear(unwrap(score), 26.72, 0.05),
    "STOREDIST stores the distance in km: ${unwrap(score)}",
  )
  c.close()
}

test "live: geo commands run in a pipeline and a transaction through GeoBatch" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:geo:queued"
  c.del([key]) catch e {
    panic("del: ${e.message()}")
  }

  let p = c.pipeline()
  let q = p.geo(key)
  let added = q.add([place("berlin", 13.405, 52.52), place("potsdam", 13.0645, 52.3989)])
  let dist = q.dist("berlin", "potsdam", GeoUnit.Kilometers)
  let pos = q.pos("berlin")
  let hash = q.hash("berlin")
  let hits = q.search(
    GeoFrom.Member("berlin"),
    GeoBy.Radius(50.0, GeoUnit.Kilometers),
    GeoSearchOptions{ order = GeoOrder.Nearest },
  )
  let stored = q.searchStore(
    "bit:live:geo:queued:out",
    GeoFrom.Member("berlin"),
    GeoBy.Radius(50.0, GeoUnit.Kilometers),
  )
  p.exec() catch e {
    panic("pipeline exec: ${e.message()}")
  }
  let n = added.get() catch e {
    panic("add future: ${e.message()}")
  }
  assert(n == 2, "queued add = ${n}")
  let d = dist.get() catch e {
    panic("dist future: ${e.message()}")
  }
  assert(geoNear(unwrap(d), 26.72, 0.05), "queued dist = ${unwrap(d)}")
  let ps = pos.get() catch e {
    panic("pos future: ${e.message()}")
  }
  assert(geoNear(unwrap(ps[0]).lon, 13.405, 0.0001), "queued pos")
  let hs = hash.get() catch e {
    panic("hash future: ${e.message()}")
  }
  assert(unwrap(hs[0]) == "u33dc0cppj0", "queued hash = ${unwrap(hs[0])}")
  let found = hits.get() catch e {
    panic("search future: ${e.message()}")
  }
  assert(geoNames(found) == "berlin,potsdam,", "queued search = ${geoNames(found)}")
  let s = stored.get() catch e {
    panic("searchStore future: ${e.message()}")
  }
  assert(s == 2, "queued searchStore = ${s}")

  let size = c.transaction<Future<i64>>([key], (tx) => {
    tx.geo(key).add([place("hamburg", 9.9937, 53.5511)])
    return tx.geo(key).add([place("munich", 11.582, 48.1351)])
  }) catch e {
    panic("transaction: ${e.message()}")
  }
  let t = size.get() catch e {
    panic("transaction future: ${e.message()}")
  }
  assert(t == 1, "transaction add = ${t}")
  c.del([key, "bit:live:geo:queued:out"]) catch e {
    panic("del: ${e.message()}")
  }
  c.close()
}
