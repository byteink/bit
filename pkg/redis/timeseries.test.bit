// pkg/redis/timeseries.test.bit - the `TS.*` wire arguments (`tsargs.bit`,
// `tscmd.bit`) and reply decoding, tested without a server. `assertArgs` is
// `list.test.bit`'s (same module). `timeseries.live.test.bit` runs every
// command against a real server.

import { toUpper } from "std/strings"
import { Hour, Minute, Second } from "std/time"

fn tsSome<T>(o: Option<T>): bool {
  match (o) {
    Some(_) => return true
    None => return false
  }
}

fn tsBulk(s: string): Reply { return Reply.Bulk(Option.Some(s)) }

fn tsArray(items: []Reply): Reply { return Reply.Array(Option.Some(items)) }

fn tsPair(ts: i64, v: f64): Reply { return tsArray([Reply.Int(ts), Reply.Double(v)]) }

fn tsEntry(k: string, v: Reply): MapEntry { return MapEntry{ key = tsBulk(k), value = v } }

fn tsLabels(name: string, value: string): Reply {
  return Reply.Map([tsEntry(name, tsBulk(value))])
}

fn tsAll(): SeriesOptions {
  return SeriesOptions{
    retention = Option.Some(2 * Hour),
    encoding = Option.Some(Encoding.Uncompressed),
    chunkSize = Option.Some(8192),
    duplicatePolicy = Option.Some(DuplicatePolicy.Max),
    ignore = Option.Some(Ignore{ maxTimeDiff = 5, maxValueDiff = 0.5 }),
    labels = { "region": "eu" },
  }
}

test "TS.CREATE sends its options in the docs' order, and none when none are set" {
  assertArgs(tsCreateCmd("k", SeriesOptions{}).args, ["TS.CREATE", "k"])
  assertArgs(
    tsCreateCmd("k", tsAll()).args,
    [
      "TS.CREATE", "k", "RETENTION", "7200000", "ENCODING", "UNCOMPRESSED", "CHUNK_SIZE", "8192",
      "DUPLICATE_POLICY", "MAX", "IGNORE", "5", "0.5", "LABELS", "region", "eu",
    ],
  )
}

test "a retention is rounded up to a whole millisecond, zero stays zero" {
  let o = SeriesOptions{ retention = Option.Some(1) }
  assertArgs(tsCreateCmd("k", o).args, ["TS.CREATE", "k", "RETENTION", "1"])
  let forever = SeriesOptions{ retention = Option.Some(0) }
  assertArgs(tsCreateCmd("k", forever).args, ["TS.CREATE", "k", "RETENTION", "0"])
}

test "TS.ALTER sends only what is set, clearLabels sends a bare LABELS" {
  let o = AlterOptions{ chunkSize = Option.Some(1024) }
  assertArgs(tsAlterCmd("k", o).args, ["TS.ALTER", "k", "CHUNK_SIZE", "1024"])
  let set = AlterOptions{ labels = { "a": "b" } }
  assertArgs(tsAlterCmd("k", set).args, ["TS.ALTER", "k", "LABELS", "a", "b"])
  let clear = AlterOptions{ clearLabels = true }
  assertArgs(tsAlterCmd("k", clear).args, ["TS.ALTER", "k", "LABELS"])
}

test "TS.ADD puts the timestamp and value first, ON_DUPLICATE after the series options" {
  assertArgs(
    tsAddCmd("k", Stamp.Auto, 1.5, SeriesOptions{}, Option.None).args,
    ["TS.ADD", "k", "*", "1.5"],
  )
  let o = SeriesOptions{ duplicatePolicy = Option.Some(DuplicatePolicy.Last) }
  assertArgs(
    tsAddCmd("k", Stamp.At(1000), 2.0, o, Option.Some(DuplicatePolicy.Sum)).args,
    ["TS.ADD", "k", "1000", "2", "DUPLICATE_POLICY", "LAST", "ON_DUPLICATE", "SUM"],
  )
}

test "TS.INCRBY and TS.DECRBY leave TIMESTAMP off for Auto and send it otherwise" {
  assertArgs(
    tsIncrCmd("TS.INCRBY", "k", 3.0, Stamp.Auto, SeriesOptions{}).args,
    ["TS.INCRBY", "k", "3"],
  )
  let o = SeriesOptions{ labels = { "a": "b" } }
  assertArgs(
    tsIncrCmd("TS.DECRBY", "k", 1.5, Stamp.At(70000), o).args,
    ["TS.DECRBY", "k", "1.5", "TIMESTAMP", "70000", "LABELS", "a", "b"],
  )
}

test "TS.MADD, TS.DEL, TS.GET and the rules are plain argument lists" {
  let pts = [
    KeyedSample{ key = "a", ts = Stamp.At(1), value = 1.0 },
    KeyedSample{ key = "b", ts = Stamp.Auto, value = 2.5 },
  ]
  assertArgs(tsMaddCmd(pts).args, ["TS.MADD", "a", "1", "1", "b", "*", "2.5"])
  assertArgs(tsDelCmd("k", Stamp.Oldest, Stamp.At(9)).args, ["TS.DEL", "k", "-", "9"])
  assertArgs(tsGetCmd("k", false).args, ["TS.GET", "k"])
  assertArgs(tsGetCmd("k", true).args, ["TS.GET", "k", "LATEST"])
  assertArgs(tsInfoCmd("k", false).args, ["TS.INFO", "k"])
  assertArgs(tsInfoCmd("k", true).args, ["TS.INFO", "k", "DEBUG"])
  assertArgs(
    tsCreateRuleCmd("src", "dst", Aggregation.StdP, Minute, Option.None).args,
    ["TS.CREATERULE", "src", "dst", "AGGREGATION", "std.p", "60000"],
  )
  assertArgs(
    tsCreateRuleCmd("src", "dst", Aggregation.Sum, Second, Option.Some(500)).args,
    ["TS.CREATERULE", "src", "dst", "AGGREGATION", "sum", "1000", "500"],
  )
  assertArgs(tsDeleteRuleCmd("src", "dst").args, ["TS.DELETERULE", "src", "dst"])
}

test "every aggregation says the word the server expects" {
  let want = [
    "avg", "sum", "min", "max", "range", "count", "first", "last", "std.p", "std.s", "var.p",
    "var.s", "twa", "countnan", "countall",
  ]
  let all = [
    Aggregation.Avg,
    Aggregation.Sum,
    Aggregation.Min,
    Aggregation.Max,
    Aggregation.Range,
    Aggregation.Count,
    Aggregation.First,
    Aggregation.Last,
    Aggregation.StdP,
    Aggregation.StdS,
    Aggregation.VarP,
    Aggregation.VarS,
    Aggregation.Twa,
    Aggregation.CountNan,
    Aggregation.CountAll,
  ]
  assert(len(all) == len(want), "every variant is listed")
  let i = 0
  while (i < len(all)) {
    assert(all[i].text() == want[i], "variant ${i} is ${all[i].text()}, want ${want[i]}")
    let back = aggregationOf(toUpper(want[i]))
    match (back) {
      Some(a) => assert(a.text() == want[i], "${want[i]} round-trips")
      None => panic("${want[i]} does not parse")
    }
    i = i + 1
  }
}

test "TS.RANGE lays out LATEST, the filters, COUNT and the aggregation in the docs' order" {
  assertArgs(
    tsRangeArgs("TS.RANGE", "k", Stamp.Oldest, Stamp.Newest, RangeOptions{}),
    ["TS.RANGE", "k", "-", "+"],
  )
  let o = RangeOptions{
    latest = true,
    onlyTs = [10, 20],
    valueRange = Option.Some(ValueRange{ min = 1.0, max = 9.5 }),
    count = 3,
    downsample = Option.Some(
      Downsample{
        by = Aggregation.Avg,
        bucket = Minute,
        align = Option.Some(1000),
        bucketTs = BucketTs.Mid,
        empty = true,
      },
    ),
  }
  assertArgs(
    tsRangeArgs("TS.REVRANGE", "k", Stamp.At(0), Stamp.At(99), o),
    [
      "TS.REVRANGE", "k", "0", "99", "LATEST", "FILTER_BY_TS", "10", "20", "FILTER_BY_VALUE", "1",
      "9.5", "COUNT", "3", "ALIGN", "1000", "AGGREGATION", "avg", "60000", "BUCKETTIMESTAMP",
      "mid", "EMPTY",
    ],
  )
}

test "a downsample with defaults sends no ALIGN, BUCKETTIMESTAMP or EMPTY" {
  let o = RangeOptions{ downsample = Option.Some(Downsample{ by = Aggregation.Max, bucket = Hour }) }
  assertArgs(
    tsRangeArgs("TS.RANGE", "k", Stamp.Oldest, Stamp.Newest, o),
    ["TS.RANGE", "k", "-", "+", "AGGREGATION", "max", "3600000"],
  )
}

test "several aggregators go out as one comma-separated list, by first" {
  let d = Downsample{
    by = Aggregation.Avg,
    also = [Aggregation.Max, Aggregation.CountAll],
    bucket = Minute,
    align = Option.Some(500),
  }
  let o = RangeOptions{ downsample = Option.Some(d) }
  assertArgs(
    tsRangeArgs("TS.RANGE", "k", Stamp.Oldest, Stamp.Newest, o),
    ["TS.RANGE", "k", "-", "+", "ALIGN", "500", "AGGREGATION", "avg,max,countall", "60000"],
  )
  let m = MrangeOptions{ range = o, labels = LabelsOut.All }
  assertArgs(
    mrangeArgs("TS.MRANGE", Stamp.Oldest, Stamp.Newest, [label("a").eq("b")], m),
    [
      "TS.MRANGE", "-", "+", "WITHLABELS", "ALIGN", "500", "AGGREGATION", "avg,max,countall",
      "60000", "FILTER", "a=b",
    ],
  )
}

test "a sample with several aggregators decodes value and also, a plain one has no also" {
  let many = asSamples(
    tsArray([tsArray([Reply.Int(1000), Reply.Double(3.0), Reply.Double(5.0), Reply.Int(2)])]),
    "TS.RANGE",
  ) catch e {
    panic("samples: ${e.message()}")
  }
  assert(many[0].ts == 1000 && many[0].value == 3.0, "ts and the first aggregator")
  assert(len(many[0].also) == 2 && many[0].also[0] == 5.0 && many[0].also[1] == 2.0, "the others, in order")
  let one = asSample(tsPair(1, 2.0), "TS.GET") catch e {
    panic("sample: ${e.message()}")
  }
  assert(len(one.also) == 0, "a plain sample has no also")
}

test "TS.MRANGE with several aggregators decodes the extra values past the aggregators entry" {
  let r = Reply.Map(
    [
      tsEntry(
        "a",
        tsArray(
          [
            tsLabels("region", "eu"),
            Reply.Map([tsEntry("aggregators", tsArray([tsBulk("avg"), tsBulk("max")]))]),
            tsArray([tsArray([Reply.Int(0), Reply.Double(1.5), Reply.Double(2.0)])]),
          ],
        ),
      ),
    ],
  )
  let got = asSeriesRanges(r, "TS.MRANGE") catch e {
    panic("mrange: ${e.message()}")
  }
  assert(len(got[0].samples) == 1 && got[0].samples[0].also[0] == 2.0, "max rides in also")
  assert(len(got[0].sources) == 0, "the aggregators entry is not sources")
}

test "TS.INFO DEBUG decodes one ChunkInfo per chunk, none without it" {
  let chunk = Reply.Map(
    [
      tsEntry("startTimestamp", Reply.Int(1000)),
      tsEntry("endTimestamp", Reply.Int(2500)),
      tsEntry("samples", Reply.Int(4)),
      tsEntry("size", Reply.Int(4096)),
      tsEntry("bytesPerSample", Reply.Double(1024.0)),
    ],
  )
  let withChunks = Reply.Map([tsEntry("totalSamples", Reply.Int(4)), tsEntry("Chunks", tsArray([chunk]))])
  let got = asSeriesInfo(withChunks) catch e {
    panic("info debug: ${e.message()}")
  }
  assert(len(got.chunks) == 1, "one chunk")
  let c = got.chunks[0]
  assert(c.startTimestamp == 1000 && c.endTimestamp == 2500 && c.samples == 4, "chunk span")
  assert(c.size == 4096 && c.bytesPerSample == 1024.0, "chunk size")
  let plain = asSeriesInfo(Reply.Map([tsEntry("totalSamples", Reply.Int(4))])) catch e {
    panic("info: ${e.message()}")
  }
  assert(len(plain.chunks) == 0, "no chunks without DEBUG")
}

test "TS.MRANGE puts the label selection before COUNT, FILTER before GROUPBY" {
  let f = [label("region").eq("eu"), label("kind").oneOf("a", "b")]
  assertArgs(
    mrangeArgs("TS.MRANGE", Stamp.Oldest, Stamp.Newest, f, MrangeOptions{}),
    ["TS.MRANGE", "-", "+", "FILTER", "region=eu", "kind=(a,b)"],
  )
  let o = MrangeOptions{
    range = RangeOptions{
      latest = true,
      count = 2,
      downsample = Option.Some(Downsample{ by = Aggregation.Sum, bucket = Minute }),
    },
    labels = LabelsOut.Only(["region", "host"]),
    groupBy = Option.Some(GroupBy{ label = "region", reduce = Aggregation.Max }),
    excludeEmpty = true,
  }
  assertArgs(
    mrangeArgs("TS.MREVRANGE", Stamp.At(1), Stamp.At(2), f, o),
    [
      "TS.MREVRANGE", "1", "2", "LATEST", "SELECTED_LABELS", "region", "host", "COUNT", "2",
      "AGGREGATION", "sum", "60000", "FILTER", "region=eu", "kind=(a,b)", "GROUPBY", "region",
      "REDUCE", "max", "EXCLUDEEMPTY",
    ],
  )
  let all = MrangeOptions{ labels = LabelsOut.All }
  assertArgs(
    mrangeArgs("TS.MRANGE", Stamp.Oldest, Stamp.Newest, f, all),
    ["TS.MRANGE", "-", "+", "WITHLABELS", "FILTER", "region=eu", "kind=(a,b)"],
  )
}

test "TS.MGET and TS.QUERYINDEX" {
  let f = [label("region").ne("us"), label("host").exists(), label("zone").absent()]
  assertArgs(
    mgetArgs(f, true, LabelsOut.All),
    ["TS.MGET", "LATEST", "WITHLABELS", "FILTER", "region!=us", "host!=", "zone="],
  )
  assertArgs(
    tsQueryIndexCmd([label("kind").noneOf("x", "y")]).args,
    ["TS.QUERYINDEX", "kind!=(x,y)"],
  )
  assert(rawFilter("a=b").expr == "a=b", "rawFilter keeps its text")
}

test "samples decode from RESP3 doubles, integers and bulk decimals" {
  let s = asSample(tsPair(1000, 1.5), "TS.GET") catch e {
    panic("sample: ${e.message()}")
  }
  assert(s.ts == 1000 && s.value == 1.5, "sample = ${s.ts} ${s.value}")
  let mixed = asSample(tsArray([Reply.Int(5), Reply.Int(7)]), "TS.GET") catch e {
    panic("int value: ${e.message()}")
  }
  assert(mixed.value == 7.0, "an integer value is 7.0")
  let bulk = asSample(tsArray([Reply.Int(5), tsBulk("2.25")]), "TS.GET") catch e {
    panic("bulk value: ${e.message()}")
  }
  assert(bulk.value == 2.25, "a bulk decimal is 2.25")
  let none = asOptSample(tsArray([]Reply(0)), "TS.GET") catch e {
    panic("empty: ${e.message()}")
  }
  assert(!tsSome(none), "an empty reply is None")
  let bad = false
  asSample(tsArray([Reply.Int(1)]), "TS.GET") catch _ {
    bad = true
  }
  assert(bad, "a one-element sample is malformed")
}

test "TS.MRANGE decodes labels, samples and a GROUPBY entry's sources" {
  let plain = Reply.Map(
    [
      tsEntry(
        "a",
        tsArray(
          [
            tsLabels("region", "eu"),
            Reply.Map([tsEntry("aggregators", tsArray([]Reply(0)))]),
            tsArray([tsPair(1, 1.0), tsPair(2, 2.0)]),
          ],
        ),
      ),
    ],
  )
  let one = asSeriesRanges(plain, "TS.MRANGE") catch e {
    panic("mrange: ${e.message()}")
  }
  assert(len(one) == 1 && one[0].key == "a", "one series, key a")
  assert(len(one[0].samples) == 2 && one[0].samples[1].value == 2.0, "two samples")
  assert(one[0].labels["region"] == "eu", "label region = eu")
  assert(len(one[0].sources) == 0, "a plain entry has no sources")

  let grouped = Reply.Map(
    [
      tsEntry(
        "region=eu",
        tsArray(
          [
            Reply.Map([]MapEntry(0)),
            Reply.Map([tsEntry("reducers", tsArray([tsBulk("sum")]))]),
            Reply.Map([tsEntry("sources", tsArray([tsBulk("a"), tsBulk("b")]))]),
            tsArray([tsPair(0, 11.0)]),
          ],
        ),
      ),
    ],
  )
  let g = asSeriesRanges(grouped, "TS.MRANGE") catch e {
    panic("grouped: ${e.message()}")
  }
  assert(g[0].key == "region=eu", "grouped key is label=value")
  assert(len(g[0].sources) == 2 && g[0].sources[1] == "b", "sources a, b")
  assert(g[0].samples[0].value == 11.0, "grouped sample")
}

test "TS.MGET decodes the newest sample, None for an empty series" {
  let r = Reply.Map(
    [
      tsEntry("a", tsArray([tsLabels("region", "eu"), tsPair(5, 9.0)])),
      tsEntry("b", tsArray([Reply.Map([]MapEntry(0)), tsArray([]Reply(0))])),
    ],
  )
  let got = asSeriesLasts(r) catch e {
    panic("mget: ${e.message()}")
  }
  assert(len(got) == 2, "two series")
  assert(got[0].labels["region"] == "eu", "labels")
  assert(tsSome(got[0].sample), "a has a sample")
  assert(!tsSome(got[1].sample), "b is empty")
}

test "TS.MADD decodes a timestamp or the server's error per point" {
  let r = tsArray([Reply.Int(1000), Reply.Err("TSDB: duplicate"), Reply.Int(3)])
  let got = asAddResults(r) catch e {
    panic("madd: ${e.message()}")
  }
  assert(len(got) == 3, "three results")
  assert(got[0].ts == 1000 && !tsSome(got[0].error), "first stored")
  assert(tsSome(got[1].error), "second refused")
  assert(got[2].ts == 3, "third stored")
}

test "TS.INFO decodes the settings and the rules" {
  let r = Reply.Map(
    [
      tsEntry("totalSamples", Reply.Int(4)),
      tsEntry("memoryUsage", Reply.Int(5200)),
      tsEntry("firstTimestamp", Reply.Int(1000)),
      tsEntry("lastTimestamp", Reply.Int(61000)),
      tsEntry("retentionTime", Reply.Int(3600000)),
      tsEntry("chunkCount", Reply.Int(1)),
      tsEntry("chunkSize", Reply.Int(4096)),
      tsEntry("chunkType", tsBulk("uncompressed")),
      tsEntry("duplicatePolicy", tsBulk("max")),
      tsEntry("labels", tsLabels("region", "eu")),
      tsEntry("sourceKey", Reply.Null),
      tsEntry(
        "rules",
        Reply.Map([tsEntry("dst", tsArray([Reply.Int(60000), tsBulk("SUM"), Reply.Int(0)]))]),
      ),
      tsEntry("ignoreMaxTimeDiff", Reply.Int(0)),
      tsEntry("ignoreMaxValDiff", Reply.Double(0.0)),
    ],
  )
  let i = asSeriesInfo(r) catch e {
    panic("info: ${e.message()}")
  }
  assert(i.totalSamples == 4 && i.lastTimestamp == 61000, "counters")
  assert(i.retention == Hour, "retention is in nanoseconds")
  assert(i.encoding == Encoding.Uncompressed, "encoding")
  assert(tsSome(i.duplicatePolicy), "policy")
  assert(i.labels["region"] == "eu", "labels")
  assert(!tsSome(i.sourceKey), "no source")
  assert(len(i.rules) == 1 && i.rules[0].dest == "dst", "one rule to dst")
  assert(
    i.rules[0].bucket == Minute && i.rules[0].by == Aggregation.Sum,
    "rule bucket and aggregator",
  )
}

test "a reply of the wrong shape names the command" {
  let bad = false
  asSeriesRanges(Reply.Int(1), "TS.MRANGE") catch _ {
    bad = true
  }
  assert(bad, "an integer is not an MRANGE reply")
  let badInfo = false
  asSeriesInfo(Reply.Int(1)) catch _ {
    badInfo = true
  }
  assert(badInfo, "an integer is not an INFO reply")
}

test "TimeSeriesBatch queues the commands with TimeSeries' argv" {
  let batch = Batch()
  let t = TimeSeriesBatch{ batch = batch, key = "k" }
  let _ = t.create()
  let _ = t.add(Stamp.At(5), 1.0)
  let _ = t.incrBy(2.0)
  let _ = t.get(true)
  let _ = t.range(Stamp.Oldest, Stamp.Newest)
  let _ = t.createRule("d", Aggregation.Avg, Minute)
  assert(len(batch.queued) == 6, "queued ${len(batch.queued)} commands")
  assertArgs(batch.queued[0], ["TS.CREATE", "k"])
  assertArgs(batch.queued[1], ["TS.ADD", "k", "5", "1"])
  assertArgs(batch.queued[2], ["TS.INCRBY", "k", "2"])
  assertArgs(batch.queued[3], ["TS.GET", "k", "LATEST"])
  assertArgs(batch.queued[4], ["TS.RANGE", "k", "-", "+"])
  assertArgs(batch.queued[5], ["TS.CREATERULE", "k", "d", "AGGREGATION", "avg", "60000"])
}

test "TimeSeriesMultiBatch queues the multi-series commands with TimeSeriesMulti's argv" {
  let batch = Batch()
  let t = TimeSeriesMultiBatch{ batch = batch }
  let f = [label("region").eq("eu")]
  let _ = t.madd([KeyedSample{ key = "a", ts = Stamp.At(1), value = 2.0 }])
  let _ = t.mget(f, true, LabelsOut.All)
  let _ = t.mrange(Stamp.Oldest, Stamp.Newest, f)
  let _ = t.mrevrange(Stamp.At(1), Stamp.At(2), f)
  let _ = t.queryIndex(f)
  assert(len(batch.queued) == 5, "queued ${len(batch.queued)} commands")
  assertArgs(batch.queued[0], ["TS.MADD", "a", "1", "2"])
  assertArgs(batch.queued[1], ["TS.MGET", "LATEST", "WITHLABELS", "FILTER", "region=eu"])
  assertArgs(batch.queued[2], ["TS.MRANGE", "-", "+", "FILTER", "region=eu"])
  assertArgs(batch.queued[3], ["TS.MREVRANGE", "1", "2", "FILTER", "region=eu"])
  assertArgs(batch.queued[4], ["TS.QUERYINDEX", "region=eu"])
}

test "TimeSeriesBatch.info queues DEBUG on request" {
  let batch = Batch()
  let t = TimeSeriesBatch{ batch = batch, key = "k" }
  let _ = t.info()
  let _ = t.info(true)
  assertArgs(batch.queued[0], ["TS.INFO", "k"])
  assertArgs(batch.queued[1], ["TS.INFO", "k", "DEBUG"])
}
