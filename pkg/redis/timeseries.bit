// pkg/redis/timeseries.bit — `r.timeseries(key)`: the RedisTimeSeries handle. Epic
// #6013, #6028: SCAFFOLD ONLY, no commands wired yet (`TS.ADD, TS.RANGE, TS.CREATE`, a
// follow-up ticket) — this file exists so later family tickets touch only
// their own file, never `client.bit`. `cmd.bit`'s header is the template:
// one `Cmd<T>` factory per command, called from a method here.
export class TimeSeries {
  client: Client,
  key: string,
}

// The queued view `Pipeline.timeseries`/`Tx.timeseries` both return — `cmd.bit`'s
// `Batch` is the ONE client-side queue the two executors share, so this
// is the ONLY queued view TimeSeries needs (`cmd.bit`'s header, point 2).
export class TimeSeriesBatch {
  batch: Batch,
  key: string,
}
