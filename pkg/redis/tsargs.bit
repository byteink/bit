// pkg/redis/tsargs.bit - the wire arguments of the `TS.*` commands, built
// from the option classes in `tsopts.bit`. Pure functions of their inputs, so
// `timeseries.test.bit` checks every argument list without a server. Epic
// #6013, #6038. The `Cmd<T>` factories that use them are in `tscmd.bit`.
//
// THE ORDER IS THE DOCS'. Each command's optional tokens are appended in the
// order redis.io lists them: `RETENTION`, `ENCODING`, `CHUNK_SIZE`,
// `DUPLICATE_POLICY`, `ON_DUPLICATE`, `IGNORE`, `LABELS` for the creating
// commands; `LATEST`, `FILTER_BY_TS`, `FILTER_BY_VALUE`, the label selection,
// `COUNT`, then `ALIGN` and `AGGREGATION` for the reads.

// Nanoseconds as whole milliseconds, rounded up; a non-positive duration is 0.
fn msCeil(ns: int): int {
  if (ns <= 0) {
    return 0
  }
  return (ns + Millisecond - 1) / Millisecond
}

// `[token, value]`, or nothing when the option is unset.
fn tokenPair(token: string, value: Option<string>): []string {
  match (value) {
    Some(v) => return [token, v]
    None => return []string(0)
  }
}

fn retentionText(o: Option<int>): Option<string> {
  match (o) {
    Some(ns) => return Option.Some("${msCeil(ns)}")
    None => return Option.None
  }
}

fn encodingText(o: Option<Encoding>): Option<string> {
  match (o) {
    Some(e) => return Option.Some(e.text())
    None => return Option.None
  }
}

fn chunkText(o: Option<i64>): Option<string> {
  match (o) {
    Some(n) => return Option.Some("${n}")
    None => return Option.None
  }
}

fn policyText(o: Option<DuplicatePolicy>): Option<string> {
  match (o) {
    Some(p) => return Option.Some(p.text())
    None => return Option.None
  }
}

fn ignoreArgs(o: Option<Ignore>): []string {
  match (o) {
    Some(ig) => return ["IGNORE", "${ig.maxTimeDiff}", "${ig.maxValueDiff}"]
    None => return []string(0)
  }
}

fn labelArgs(o: Option<map<string, string>>): []string {
  match (o) {
    Some(labels) => return labelPairs(labels)
    None => return []string(0)
  }
}

fn labelPairs(labels: map<string, string>): []string {
  let out = ["LABELS"]
  for (name, value) of labels {
    out = append(append(out, name), value)
  }
  return out
}

// The creation options of `TS.CREATE`, `TS.ALTER`, `TS.ADD`, `TS.INCRBY` and
// `TS.DECRBY`. `onDup` is `TS.ADD`'s `ON_DUPLICATE`, `None` for the rest.
fn seriesArgs(o: SeriesOptions, onDup: Option<DuplicatePolicy>): []string {
  let args = []string(0)
  args = append(args, ...tokenPair("RETENTION", retentionText(o.retention)))
  args = append(args, ...tokenPair("ENCODING", encodingText(o.encoding)))
  args = append(args, ...tokenPair("CHUNK_SIZE", chunkText(o.chunkSize)))
  args = append(args, ...tokenPair("DUPLICATE_POLICY", policyText(o.duplicatePolicy)))
  args = append(args, ...tokenPair("ON_DUPLICATE", policyText(onDup)))
  args = append(args, ...ignoreArgs(o.ignore))
  return append(args, ...labelArgs(o.labels))
}

fn tsListArgs(tss: []i64): []string {
  if (len(tss) == 0) {
    return []string(0)
  }
  let out = ["FILTER_BY_TS"]
  let i = 0
  while (i < len(tss)) {
    out = append(out, "${tss[i]}")
    i = i + 1
  }
  return out
}

fn valueRangeArgs(o: Option<ValueRange>): []string {
  match (o) {
    Some(v) => return ["FILTER_BY_VALUE", "${v.min}", "${v.max}"]
    None => return []string(0)
  }
}

// `LATEST`, `FILTER_BY_TS` and `FILTER_BY_VALUE`, the part of a read that
// comes before the label selection.
fn rangeFilterArgs(o: RangeOptions): []string {
  let args = []string(0)
  if (o.latest) {
    args = append(args, "LATEST")
  }
  args = append(args, ...tsListArgs(o.onlyTs))
  return append(args, ...valueRangeArgs(o.valueRange))
}

fn downsampleArgs(d: Downsample): []string {
  let out = []string(0)
  match (d.align) {
    Some(a) => out = ["ALIGN", "${a}"]
    None => {}
  }
  out = append(append(append(out, "AGGREGATION"), d.by.text()), "${msCeil(d.bucket)}")
  if (d.bucketTs != BucketTs.Start) {
    out = append(append(out, "BUCKETTIMESTAMP"), d.bucketTs.text())
  }
  if (d.empty) {
    out = append(out, "EMPTY")
  }
  return out
}

// `COUNT` and the aggregation, the part of a read that follows the label
// selection.
fn rangeShapeArgs(o: RangeOptions): []string {
  let args = []string(0)
  if (o.count > 0) {
    args = append(append(args, "COUNT"), "${o.count}")
  }
  match (o.downsample) {
    Some(d) => return append(args, ...downsampleArgs(d))
    None => return args
  }
}

fn labelsOutArgs(l: LabelsOut): []string {
  match (l) {
    Omit => return []string(0)
    All => return ["WITHLABELS"]
    Only(names) => return append(["SELECTED_LABELS"], ...names)
  }
}

fn filterArgs(filters: []Filter): []string {
  let out = ["FILTER"]
  let i = 0
  while (i < len(filters)) {
    out = append(out, filters[i].expr)
    i = i + 1
  }
  return out
}

fn groupArgs(o: MrangeOptions): []string {
  let args = []string(0)
  match (o.groupBy) {
    Some(g) => args = ["GROUPBY", g.label, "REDUCE", g.reduce.text()]
    None => {}
  }
  if (o.excludeEmpty) {
    args = append(args, "EXCLUDEEMPTY")
  }
  return args
}

// `TS.RANGE` / `TS.REVRANGE key from to ..`.
fn tsRangeArgs(name: string, key: string, from: Stamp, to: Stamp, o: RangeOptions): []string {
  let args = [name, key, from.text(), to.text()]
  args = append(args, ...rangeFilterArgs(o))
  return append(args, ...rangeShapeArgs(o))
}

// `TS.MRANGE` / `TS.MREVRANGE from to .. FILTER .. [GROUPBY ..]`.
fn mrangeArgs(name: string, from: Stamp, to: Stamp, filters: []Filter, o: MrangeOptions): []string {
  let args = [name, from.text(), to.text()]
  args = append(args, ...rangeFilterArgs(o.range))
  args = append(args, ...labelsOutArgs(o.labels))
  args = append(args, ...rangeShapeArgs(o.range))
  args = append(args, ...filterArgs(filters))
  return append(args, ...groupArgs(o))
}

// `TS.MGET [LATEST] [labels] FILTER ..`.
fn mgetArgs(filters: []Filter, latest: bool, labels: LabelsOut): []string {
  let args = ["TS.MGET"]
  if (latest) {
    args = append(args, "LATEST")
  }
  args = append(args, ...labelsOutArgs(labels))
  return append(args, ...filterArgs(filters))
}
