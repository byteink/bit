  let args = appendAggregate(setOpStoreArgs("ZINTERSTORE", dst, key, otherKeys, weights), aggregate)
  return Cmd<i64>{ args = args, decode = (r) => asInt(r, "ZINTERSTORE"), readOnly = false }
}

fn diffStoreCmd(dst: string, key: string, otherKeys: []string): Cmd<i64> {
  let numkeys = 1 + len(otherKeys)
  let args = appendKeys(["ZDIFFSTORE", dst, "${numkeys}", key], otherKeys)
  return Cmd<i64>{ args = args, decode = (r) => asInt(r, "ZDIFFSTORE"), readOnly = false }
