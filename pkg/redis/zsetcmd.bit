fn setOpArgs(name: string, key: string, otherKeys: []string, weights: []f64): []string {
  let numkeys = 1 + len(otherKeys)
  let args = [name, "${numkeys}", key]
  args = appendKeys(args, otherKeys)
  return appendWeights(args, weights)
}

fn setOpStoreArgs(
  name: string,
  dst: string,
  key: string,
  otherKeys: []string,
  weights: []f64,
): []string {
  let numkeys = 1 + len(otherKeys)
  let args = [name, dst, "${numkeys}", key]
  args = appendKeys(args, otherKeys)
  return appendWeights(args, weights)
}

// `ZINTERCARD numkeys key [key ...] [LIMIT limit]` - `numkeys` counts the
// handle's own key plus `otherKeys`; `LIMIT` is sent only when positive
// (0 means no limit to Redis, so it is simply left off).
fn interCardArgs(key: string, otherKeys: []string, limit: int): []string {
  let args = ["ZINTERCARD", "${len(otherKeys) + 1}", key]
  args = appendKeys(args, otherKeys)
  if (limit > 0) {
    args = append(args, "LIMIT")
    args = append(args, "${limit}")
  }
  return args
}

fn interCardCmd(key: string, otherKeys: []string, limit: int): Cmd<i64> {
  return Cmd<i64>{
    args = interCardArgs(key, otherKeys, limit),
    decode = (r) => asInt(r, "ZINTERCARD"),
    readOnly = true,
  }
}

fn unionCmd(key: string, otherKeys: []string, weights: []f64, aggregate: Aggregate): Cmd<[]Scored> {
  let args = appendAggregate(setOpArgs("ZUNION", key, otherKeys, weights), aggregate)
  args = append(args, "WITHSCORES")
  return Cmd<[]Scored>{ args = args, decode = (r) => asScoredEither(r, "ZUNION"), readOnly = true }
}

fn interCmd(key: string, otherKeys: []string, weights: []f64, aggregate: Aggregate): Cmd<[]Scored> {
  let args = appendAggregate(setOpArgs("ZINTER", key, otherKeys, weights), aggregate)
  args = append(args, "WITHSCORES")
  return Cmd<[]Scored>{ args = args, decode = (r) => asScoredEither(r, "ZINTER"), readOnly = true }
}

fn diffCmd(key: string, otherKeys: []string): Cmd<[]Scored> {
  let numkeys = 1 + len(otherKeys)
  let args = appendKeys(["ZDIFF", "${numkeys}", key], otherKeys)
  args = append(args, "WITHSCORES")
  return Cmd<[]Scored>{ args = args, decode = (r) => asScoredEither(r, "ZDIFF"), readOnly = true }
}

fn unionStoreCmd(
  dst: string,
  key: string,
  otherKeys: []string,
  weights: []f64,
  aggregate: Aggregate,
): Cmd<i64> {
  let args = appendAggregate(setOpStoreArgs("ZUNIONSTORE", dst, key, otherKeys, weights), aggregate)
  return Cmd<i64>{ args = args, decode = (r) => asInt(r, "ZUNIONSTORE"), readOnly = false }
}

fn interStoreCmd(
  dst: string,
