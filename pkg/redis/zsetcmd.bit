  max: Bound<string>,
  limit: Limit,
): Cmd<i64> {
  let args = ["ZRANGESTORE", dst, key, lexBoundArg(min, true), lexBoundArg(max, false), "BYLEX"]
  args = appendLimit(args, limit)
  return Cmd<i64>{ args = args, decode = (r) => asInt(r, "ZRANGESTORE"), readOnly = false }
}

