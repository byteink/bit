fn randMemberCmd(key: string): Cmd<Option<string>> {
  return Cmd<Option<string>>{
    args = ["ZRANDMEMBER", key],
    decode = (r) => asOptString(r, "ZRANDMEMBER"),
    readOnly = true,
  }
}

fn randMembersCmd(key: string, count: i64): Cmd<[]Scored> {
  return Cmd<[]Scored>{
    args = ["ZRANDMEMBER", key, "${count}", "WITHSCORES"],
    decode = (r) => asScoredEither(r, "ZRANDMEMBER"),
    readOnly = true,
  }
}

fn zscanCmd(key: string, cursor: string): Cmd<(string, []string)> {
  return Cmd<(string, []string)>{
    args = ["ZSCAN", key, cursor],
    decode = (r) => asScanPage(r, "ZSCAN"),
    readOnly = true,
  }
}

// `ZSCORE`/`ZMSCORE`'s "a score, or nothing" reply — `Reply.Double` (RESP3,
// this file's header) or `Reply.Bulk` (RESP2, finite scores only, same
// caveat), `Reply.Null` for a missing member.
fn asOptScore(r: Reply, cmd: string): Option<f64>!RedisError {
  match (r) {
    Bulk(v) => return optScoreFromBulk(v, cmd)?
    Double(d) => return Option.Some(d)
    Null => return Option.None
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

fn optScoreFromBulk(v: Option<string>, cmd: string): Option<f64>!RedisError {
  match (v) {
    Some(s) => return optScoreFromString(s, cmd)?
    None => return Option.None
  }
}

fn optScoreFromString(s: string, cmd: string): Option<f64>!RedisError {
  let f = parseFloat(s)
  if (f != f) {
    fail RedisError.Unexpected(cmd, "Bulk")
  }
  return Option.Some(f)
}

fn asOptScores(r: Reply, cmd: string): []Option<f64>!RedisError {
  match (r) {
    Array(items) => return optScoresFromList(unwrapOr(items, []Reply(0)), cmd)?
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

fn optScoresFromList(list: []Reply, cmd: string): []Option<f64>!RedisError {
  let out = []Option<f64>(0)
  let i = 0
  while (i < len(list)) {
    let v = asOptScore(list[i], cmd)?
    out = append(out, v)
    i = i + 1
  }
  return out
}

// `ZRANK`/`ZREVRANK ... WITHSCORE` — `[rank, score]` or nil for a missing
// member.
fn asRankScore(r: Reply, cmd: string): Option<(i64, f64)>!RedisError {
  match (r) {
    Array(items) => return rankScoreFromList(unwrapOr(items, []Reply(0)), cmd)?
    Null => return Option.None
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

fn rankScoreFromList(list: []Reply, cmd: string): Option<(i64, f64)>!RedisError {
  if (len(list) == 0) {
    return Option.None
  }
  if (len(list) != 2) {
    fail RedisError.Unexpected(cmd, "Array")
  }
  let rank = asInt(list[0], cmd)?
  let score = asDouble(list[1], cmd)?
  return Option.Some((rank, score))
}

// `ZMPOP`/`BZMPOP`'s `[key, [[member, score], ...]]` — nested, unlike
// `ZPOPMIN`/`ZPOPMAX`'s flat alternating array (`cmd.bit`'s `asScored`
// already covers those). Nil (either RESP form) is an empty pop, not a
// failure — a timed-out `BZMPOP` and an empty source key both mean "nothing
// popped" to a caller.
fn asPopped(r: Reply, cmd: string): []Scored!RedisError {
  match (r) {
    Array(items) => return poppedFromList(unwrapOr(items, []Reply(0)), cmd)?
    Null => return []Scored(0)
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

fn poppedFromList(list: []Reply, cmd: string): []Scored!RedisError {
  if (len(list) == 0) {
    return []Scored(0)
  }
  if (len(list) != 2) {
    fail RedisError.Unexpected(cmd, "Array")
  }
  return poppedElements(list[1], cmd)?
}

fn poppedElements(r: Reply, cmd: string): []Scored!RedisError {
  match (r) {
    Array(items) => return poppedPairsFromList(unwrapOr(items, []Reply(0)), cmd)?
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

fn poppedPairsFromList(list: []Reply, cmd: string): []Scored!RedisError {
  let out = []Scored(0)
  let i = 0
  while (i < len(list)) {
    let scored = poppedPair(list[i], cmd)?
    out = append(out, scored)
    i = i + 1
  }
  return out
}

fn poppedPair(r: Reply, cmd: string): Scored!RedisError {
  match (r) {
    Array(items) => return poppedPairFromList(unwrapOr(items, []Reply(0)), cmd)?
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

fn poppedPairFromList(list: []Reply, cmd: string): Scored!RedisError {
  if (len(list) != 2) {
    fail RedisError.Unexpected(cmd, "Array")
  }
  let member = replyToString(list[0], cmd)?
  let score = asDouble(list[1], cmd)?
  return Scored{ member = member, score = score }
}

// `BZPOPMIN`/`BZPOPMAX`'s `[key, member, score]` — flat, unlike `BZMPOP`'s
// nesting (`asPopped` above), and exactly one element (never a count).
fn asBlockPopped(r: Reply, cmd: string): Option<Scored>!RedisError {
  match (r) {
    Array(items) => return blockPoppedFromList(unwrapOr(items, []Reply(0)), cmd)?
    Null => return Option.None
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

fn blockPoppedFromList(list: []Reply, cmd: string): Option<Scored>!RedisError {
  if (len(list) == 0) {
    return Option.None
  }
  if (len(list) != 3) {
    fail RedisError.Unexpected(cmd, "Array")
  }
  let member = replyToString(list[1], cmd)?
  let score = asDouble(list[2], cmd)?
  return Option.Some(Scored{ member = member, score = score })
}

// `cmd.bit`'s `asScored` assumes RESP2's FLAT alternating `[member, score,
// member, score, ...]` array. That is correct for `ZSCAN`'s own page items
// (`zscanCmd` above, proved live) but WRONG for every command
// whose reply is a genuine "list of member/score pairs" — `ZRANGE ...
// WITHSCORES`, `ZPOPMIN`/`ZPOPMAX`, `ZUNION`/`ZINTER`/`ZDIFF ...
// WITHSCORES` and `ZRANDMEMBER ... WITHSCORES` all reply with an array of
// NESTED `[member, score]` pairs under RESP3 (this package's default
// protocol) instead — Redis's own RESP3 reply-shape change for exactly
// these commands, proved live on this ticket (`./make
// test-package-redis-live` failed all five with "unexpected reply, got
// Array" before this helper existed). Not fixed in `cmd.bit` itself (a
// shared file this dispatch is scoped away from, per this ticket's own
// constraint on a missing/wrong decode helper there): every WITHSCORES-
// bearing zset command decodes through THIS helper instead, which accepts
// either shape — nested pairs (RESP3, the live-tested path) checked first,
// falling back to `asScored`'s own flat-array parse (RESP2, #6027's
// fallback-protocol scope, untested here but cheap to also accept).
fn asScoredEither(r: Reply, cmd: string): []Scored!RedisError {
  match (r) {
    Array(items) => return scoredEitherFromList(unwrapOr(items, []Reply(0)), cmd)?
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

fn scoredEitherFromList(list: []Reply, cmd: string): []Scored!RedisError {
  if (len(list) == 0) {
    return []Scored(0)
  }
  match (list[0]) {
    Array(_) => return scoredPairsFromList(list, cmd)?
    _ => return asScored(Reply.Array(Option.Some(list)), cmd)?
  }
}

fn scoredPairsFromList(list: []Reply, cmd: string): []Scored!RedisError {
  let out = []Scored(0)
  let i = 0
  while (i < len(list)) {
    let pair = scoredPair(list[i], cmd)?
    out = append(out, pair)
    i = i + 1
  }
  return out
}

fn scoredPair(r: Reply, cmd: string): Scored!RedisError {
  match (r) {
    Array(items) => return scoredPairFromList(unwrapOr(items, []Reply(0)), cmd)?
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

fn scoredPairFromList(list: []Reply, cmd: string): Scored!RedisError {
  if (len(list) != 2) {
    fail RedisError.Unexpected(cmd, "Array")
  }
  let member = replyToString(list[0], cmd)?
  let score = asDouble(list[1], cmd)?
  return Scored{ member = member, score = score }
}
