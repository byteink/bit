// pkg/redis/zsetcmd.bit — every ZSET command's `Cmd<T>` factory (`cmd.bit`'s
// HOW-TO template) and the decode helpers only sorted sets need, split out
// of `zset.bit` purely to stay under spec/LINT.md's 800-line file ceiling
// (E0200) — same module as `zset.bit` (SPEC §17.1, sibling files in one
// directory), so `Zset`/`ZsetBatch`/`ZsetScan`, `ZaddOptions`, `Bound<T>`,
// `Limit`, `Aggregate` and every `appendX`/`scoreArg`/`*BoundArg` helper
// declared there are already in scope here with no import, and vice versa.
// A pure move: every declaration below is unchanged from `zset.bit`, only
// relocated (`git diff --stat` on this pair is the proof, no line rewritten
// beyond the file split itself).

fn addCmd(key: string, member: string, score: f64, opts: ZaddOptions): Cmd<i64> {
  let args = addFlags(["ZADD", key], opts)
  args = append(args, scoreArg(score))
  args = append(args, member)
  return Cmd<i64>{ args = args, decode = (r) => asInt(r, "ZADD"), readOnly = false }
}

fn addFlags(args: []string, opts: ZaddOptions): []string {
  args = append(args, ...zaddFlagTokens(opts))
  return args
}

fn zaddFlagTokens(opts: ZaddOptions): []string {
  let out = []string(0)
  if (opts.nx) {
    out = append(out, "NX")
  }
  if (opts.xx) {
    out = append(out, "XX")
  }
  if (opts.onlyIfHigher) {
    out = append(out, "GT")
  }
  if (opts.onlyIfLower) {
    out = append(out, "LT")
  }
  if (opts.ch) {
    out = append(out, "CH")
  }
  return out
}

fn addManyCmd(key: string, pairs: []Scored): Cmd<i64> {
  let args = ["ZADD", key]
  let i = 0
  while (i < len(pairs)) {
    args = append(args, scoreArg(pairs[i].score))
    args = append(args, pairs[i].member)
    i = i + 1
  }
  return Cmd<i64>{ args = args, decode = (r) => asInt(r, "ZADD"), readOnly = false }
}

fn zaddIncrCmd(key: string, member: string, by: f64): Cmd<f64> {
  return Cmd<f64>{
    args = ["ZADD", key, "INCR", scoreArg(by), member],
    decode = (r) => asDouble(r, "ZADD"),
    readOnly = false,
  }
}

fn zincrByCmd(key: string, member: string, by: f64): Cmd<f64> {
  return Cmd<f64>{
    args = ["ZINCRBY", key, scoreArg(by), member],
    decode = (r) => asDouble(r, "ZINCRBY"),
    readOnly = false,
  }
}

fn scoreCmd(key: string, member: string): Cmd<Option<f64>> {
  return Cmd<Option<f64>>{
    args = ["ZSCORE", key, member],
    decode = (r) => asOptScore(r, "ZSCORE"),
    readOnly = true,
  }
}

fn scoresCmd(key: string, members: []string): Cmd<[]Option<f64>> {
  return Cmd<[]Option<f64>>{
    args = withKeyMembers("ZMSCORE", key, members),
    decode = (r) => asOptScores(r, "ZMSCORE"),
    readOnly = true,
  }
}

// `scores` before 6.2: no `ZMSCORE`, so one `ZSCORE` per member, all sent in
// one round trip (`Runner.runPipelined`). The same `[]Option<f64>`, in the
// order of `members`.
fn scoresPre62(runner: Runner, key: string, members: []string): []Option<f64>!RedisError {
  if (len(members) == 0) {
    fail RedisError.Invalid("redis: ZMSCORE needs at least one member")
  }
  let cmds = [][]string(0)
  for m of members {
    cmds = append(cmds, ["ZSCORE", key, m])
  }
  let replies = runner.runPipelined(cmds)?
  let out = []Option<f64>(0)
  for r of replies {
    out = append(out, asOptScore(r, "ZSCORE")?)
  }
  return out
}

// The refusal a QUEUED `scores` gives a server before 6.2: a `Batch` holds one
// command per reply, so it cannot fan out into a `ZSCORE` per member the way
// the immediate `scores` does.
fn scoresQueuedRefusal(version: int): RedisError {
  return RedisError.Invalid("redis: queued ZMSCORE needs Redis 6.2 or newer; the server is ${versionText(version)}, call scores() on the handle instead (it sends ZSCORE per member)")
}

// `WITHSCORE` is 7.2; an older server gets `rankOldCmd` (`zsetold.bit`).
fn rankCmd(key: string, member: string, fromTop: bool, version: int): Cmd<Option<(i64, f64)>> {
  // Rank 0 is the HIGHEST score for `fromTop`, which is what ZREVRANK counts.
  let name = "ZRANK"
  if (fromTop) {
    name = "ZREVRANK"
  }
  if (tooOld(version, serverV72)) {
    return rankOldCmd(name, key, member)
  }
  return Cmd<Option<(i64, f64)>>{
    args = [name, key, member, "WITHSCORE"],
    decode = (r) => asRankScore(r, name),
    readOnly = true,
  }
}

fn cardCmd(key: string): Cmd<i64> {
  return Cmd<i64>{ args = ["ZCARD", key], decode = (r) => asInt(r, "ZCARD"), readOnly = true }
}

fn countByScoreCmd(key: string, min: Bound<f64>, max: Bound<f64>): Cmd<i64> {
  return Cmd<i64>{
    args = ["ZCOUNT", key, scoreBoundArg(min, true), scoreBoundArg(max, false)],
    decode = (r) => asInt(r, "ZCOUNT"),
    readOnly = true,
  }
}

fn countByLexCmd(key: string, min: Bound<string>, max: Bound<string>): Cmd<i64> {
  return Cmd<i64>{
    args = ["ZLEXCOUNT", key, lexBoundArg(min, true), lexBoundArg(max, false)],
    decode = (r) => asInt(r, "ZLEXCOUNT"),
    readOnly = true,
  }
}

// `top`/`bottom`: `ZRANGE ... [REV] WITHSCORES` (6.2+), `ZREVRANGE`/`ZRANGE ...
// WITHSCORES` for a server before 6.2, which has no `REV` option. Same
// elements, same order, same reply shape.
fn rangeRankCmd(key: string, n: i64, rev: bool, version: int): Cmd<[]Scored> {
  let (start, stop) = rankRangeBounds(n)
  let args = ["ZRANGE", key, start, stop]
  if (preV62(version)) {
    args = [rankRangeName(rev), key, start, stop, "WITHSCORES"]
  } else if (rev) {
    args = append(args, "REV", "WITHSCORES")
  } else {
    args = append(args, "WITHSCORES")
  }
  return Cmd<[]Scored>{ args = args, decode = (r) => asScored(r, "ZRANGE"), readOnly = true }
}

fn rankRangeName(rev: bool): string {
  if (rev) {
    return "ZREVRANGE"
  }
  return "ZRANGE"
}

// `byScore`: `ZRANGE ... BYSCORE [LIMIT] WITHSCORES` (6.2+), `ZRANGEBYSCORE ...
// WITHSCORES [LIMIT]` for a server before 6.2. Same bound syntax (`(` for
// exclusive, `+inf`/`-inf`), same `LIMIT offset count`.
fn rangeByScoreCmd(
  key: string,
  min: Bound<f64>,
  max: Bound<f64>,
  limit: Limit,
  version: int,
): Cmd<[]Scored> {
  let lo = scoreBoundArg(min, true)
  let hi = scoreBoundArg(max, false)
  let args = ["ZRANGE", key, lo, hi, "BYSCORE"]
  if (preV62(version)) {
    args = ["ZRANGEBYSCORE", key, lo, hi, "WITHSCORES"]
    args = appendLimit(args, limit)
  } else {
    args = appendLimit(args, limit)
    args = append(args, "WITHSCORES")
  }
  return Cmd<[]Scored>{ args = args, decode = (r) => asScored(r, "ZRANGE"), readOnly = true }
}

fn rangeByLexCmd(key: string, min: Bound<string>, max: Bound<string>, limit: Limit): Cmd<[]string> {
  let args = ["ZRANGE", key, lexBoundArg(min, true), lexBoundArg(max, false), "BYLEX"]
  args = appendLimit(args, limit)
  return Cmd<[]string>{ args = args, decode = (r) => asStrings(r, "ZRANGE"), readOnly = true }
}

fn rangeStoreRankCmd(dst: string, key: string, n: i64, rev: bool): Cmd<i64> {
  let (start, stop) = rankRangeBounds(n)
  let args = ["ZRANGESTORE", dst, key, start, stop]
  if (rev) {
    args = append(args, "REV")
  }
  return Cmd<i64>{ args = args, decode = (r) => asInt(r, "ZRANGESTORE"), readOnly = false }
}

fn rangeStoreByScoreCmd(
  dst: string,
  key: string,
  min: Bound<f64>,
  max: Bound<f64>,
  limit: Limit,
): Cmd<i64> {
  let args = [
    "ZRANGESTORE",
    dst,
    key,
    scoreBoundArg(min, true),
    scoreBoundArg(max, false),
    "BYSCORE",
  ]
  args = appendLimit(args, limit)
  return Cmd<i64>{ args = args, decode = (r) => asInt(r, "ZRANGESTORE"), readOnly = false }
}

fn rangeStoreByLexCmd(
  dst: string,
