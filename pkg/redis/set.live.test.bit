// pkg/redis/set.live.test.bit - `r.sset(key)` against a real server.
// `liveUrl`/`liveClient` are `client.live.test.bit`'s own (same module, no
// import); every test is skipped, and says so, when `REDIS_TEST_URL` is
// unset. `./make test-package-redis-live` (`_tests_/bit/redislive.bit`)
// supplies it against `redis:8.10.2` in a throwaway Docker container.

fn cleanSet(c: Client, keys: []string): Set {
  c.del(keys) catch e {
    panic("del(${keys[0]}): ${e.message()}")
  }
  return c.sset(keys[0])
}

fn setHas(list: []string, member: string): bool {
  let i = 0
  while (i < len(list)) {
    if (list[i] == member) {
      return true
    }
    i = i + 1
  }
  return false
}

fn assertSetEq(got: []string, want: []string, what: string) {
  assert(len(got) == len(want), "${what}: expected ${len(want)} members, got ${len(got)}")
  let i = 0
  while (i < len(want)) {
    assert(setHas(got, want[i]), "${what}: missing '${want[i]}'")
    i = i + 1
  }
}

test "live: add, remove, has, hasMany, members and len round-trip a set" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let s = cleanSet(c, ["bit:live:set:basic"])

  let added = s.add("a", "b", "c", "a") catch e {
    panic("add: ${e.message()}")
  }
  assert(added == 3, "a duplicate member does not count, expected 3 added, got ${added}")

  let n = s.len() catch e {
    panic("len: ${e.message()}")
  }
  assert(n == 3, "len = ${n}")

  let hit = s.has("a") catch e {
    panic("has: ${e.message()}")
  }
  assert(hit, "has('a') should be true")
  let miss = s.has("z") catch e {
    panic("has: ${e.message()}")
  }
  assert(!miss, "has('z') should be false")

  let many = s.hasMany("a", "z", "c") catch e {
    panic("hasMany: ${e.message()}")
  }
  assert(len(many) == 3, "expected 3 answers, got ${len(many)}")
  assert(many[0] && !many[1] && many[2], "hasMany = ${many[0]}, ${many[1]}, ${many[2]}")

  let all = s.members() catch e {
    panic("members: ${e.message()}")
  }
  assertSetEq(all, ["a", "b", "c"], "members")

  let removed = s.remove("a", "z") catch e {
    panic("remove: ${e.message()}")
  }
  assert(removed == 1, "only 'a' was present, expected 1 removed, got ${removed}")
  c.close()
}

test "live: members, len and has on a missing key read as empty" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let s = cleanSet(c, ["bit:live:set:missing"])
  let all = s.members() catch e {
    panic("members: ${e.message()}")
  }
  assert(len(all) == 0, "missing key should have no members, got ${len(all)}")
  let n = s.len() catch e {
    panic("len: ${e.message()}")
  }
  assert(n == 0, "len of a missing key = ${n}")
  let popped = s.pop() catch e {
    panic("pop: ${e.message()}")
  }
  assert(len(popped) == 0, "pop on a missing key returned ${len(popped)} members")
  c.close()
}

test "live: pop removes members and random leaves them in place" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let s = cleanSet(c, ["bit:live:set:draw"])
  s.add("a", "b", "c", "d", "e") catch e {
    panic("add: ${e.message()}")
  }

  let drawn = s.random(3) catch e {
    panic("random: ${e.message()}")
  }
  assert(len(drawn) == 3, "random(3) returned ${len(drawn)} members")
  let stillThere = s.len() catch e {
    panic("len: ${e.message()}")
  }
  assert(stillThere == 5, "random must not remove, len = ${stillThere}")

  let repeats = s.random(-8) catch e {
    panic("random: ${e.message()}")
  }
  assert(len(repeats) == 8, "a negative count allows repeats, got ${len(repeats)} members")

  let one = s.pop() catch e {
    panic("pop: ${e.message()}")
  }
  assert(len(one) == 1, "pop() returned ${len(one)} members")
  let popped = s.pop(2) catch e {
    panic("pop: ${e.message()}")
  }
  assert(len(popped) == 2, "pop(2) returned ${len(popped)} members")
  let left = s.members() catch e {
    panic("members: ${e.message()}")
  }
  assert(len(left) == 2, "5 members minus 3 popped should leave 2, got ${len(left)}")
  assert(!setHas(left, one[0]), "'${one[0]}' was popped, it must be gone")
  c.close()
}

test "live: move transfers a member between sets" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let src = cleanSet(c, ["bit:live:set:move:src", "bit:live:set:move:dst"])
  src.add("a", "b") catch e {
    panic("add: ${e.message()}")
  }

  let moved = src.move("bit:live:set:move:dst", "a") catch e {
    panic("move: ${e.message()}")
  }
  assert(moved, "move('a') should report true")
  let again = src.move("bit:live:set:move:dst", "a") catch e {
    panic("move: ${e.message()}")
  }
  assert(!again, "a member the source no longer holds moves nothing")

  let there = c.sset("bit:live:set:move:dst").has("a") catch e {
    panic("has: ${e.message()}")
  }
  assert(there, "'a' should be in the destination")
  let gone = src.has("a") catch e {
    panic("has: ${e.message()}")
  }
  assert(!gone, "'a' should have left the source")
  c.close()
}

test "live: inter, union and diff read the other keys without writing" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let a = cleanSet(c, ["bit:live:set:ops:a", "bit:live:set:ops:b", "bit:live:set:ops:c"])
  a.add("1", "2", "3", "4") catch e {
    panic("add a: ${e.message()}")
  }
  c.sset("bit:live:set:ops:b").add("3", "4", "5") catch e {
    panic("add b: ${e.message()}")
  }
  c.sset("bit:live:set:ops:c").add("4", "6") catch e {
    panic("add c: ${e.message()}")
  }
  let b = "bit:live:set:ops:b"
  let cc = "bit:live:set:ops:c"

  let inter = a.inter(b, cc) catch e {
    panic("inter: ${e.message()}")
  }
  assertSetEq(inter, ["4"], "inter")
  let union = a.union(b, cc) catch e {
    panic("union: ${e.message()}")
  }
  assertSetEq(union, ["1", "2", "3", "4", "5", "6"], "union")
  let diff = a.diff(b, cc) catch e {
    panic("diff: ${e.message()}")
  }
  assertSetEq(diff, ["1", "2"], "diff")
  let alone = a.inter() catch e {
    panic("inter(): ${e.message()}")
  }
  assertSetEq(alone, ["1", "2", "3", "4"], "inter with no other keys")
  c.close()
}

test "live: interStore, unionStore and diffStore write a destination key" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let a = cleanSet(c, ["bit:live:set:store:a", "bit:live:set:store:b", "bit:live:set:store:out"])
  a.add("1", "2", "3") catch e {
    panic("add a: ${e.message()}")
  }
  c.sset("bit:live:set:store:b").add("2", "3", "4") catch e {
    panic("add b: ${e.message()}")
  }
  let b = "bit:live:set:store:b"
  let out = "bit:live:set:store:out"

  let n = a.interStore(out, b) catch e {
    panic("interStore: ${e.message()}")
  }
  assert(n == 2, "interStore stored ${n} members")
  let got = c.sset(out).members() catch e {
    panic("members: ${e.message()}")
  }
  assertSetEq(got, ["2", "3"], "interStore result")

  let m = a.unionStore(out, b) catch e {
    panic("unionStore: ${e.message()}")
  }
  assert(m == 4, "unionStore stored ${m} members, replacing the old result")

  let d = a.diffStore(out, b) catch e {
    panic("diffStore: ${e.message()}")
  }
  assert(d == 1, "diffStore stored ${d} members")
  let diffed = c.sset(out).members() catch e {
    panic("members: ${e.message()}")
  }
  assertSetEq(diffed, ["1"], "diffStore result")
  c.close()
}

test "live: interCard counts the intersection and stops at limit" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let a = cleanSet(c, ["bit:live:set:card:a", "bit:live:set:card:b"])
  a.add("1", "2", "3", "4") catch e {
    panic("add a: ${e.message()}")
  }
  c.sset("bit:live:set:card:b").add("2", "3", "4", "9") catch e {
    panic("add b: ${e.message()}")
  }

  let all = a.interCard(["bit:live:set:card:b"]) catch e {
    panic("interCard: ${e.message()}")
  }
  assert(all == 3, "interCard = ${all}")
  let capped = a.interCard(["bit:live:set:card:b"], 2) catch e {
    panic("interCard limit: ${e.message()}")
  }
  assert(capped == 2, "interCard with limit 2 = ${capped}")
  c.close()
}

test "live: scan follows the cursor across several pages and yields every member once" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let s = cleanSet(c, ["bit:live:set:scan"])
  // 400 non-integer members force the hashtable encoding: a small or all-
  // integer set is a listpack/intset, which SSCAN returns whole in ONE
  // page whatever COUNT says.
  let total = 400
  let i = 0
  while (i < total) {
    s.add("m${i}") catch e {
      panic("add: ${e.message()}")
    }
    i = i + 1
  }

  let it = s.scan("", 10)
  let first = it.next() catch e {
    panic("scan: ${e.message()}")
  }
  assert(isSome(first), "scan yielded nothing from a 400-member set")
  assert(it.cursor != "0", "the first page must leave the cursor open, cursor='${it.cursor}'")

  let seen = map<string, bool>()
  seen[unwrap(first)] = true
  let pages = 1
  let lastCursor = it.cursor
  let more = it.next() catch e {
    panic("scan: ${e.message()}")
  }
  while (isSome(more)) {
    seen[unwrap(more)] = true
    if (it.cursor != lastCursor) {
      pages = pages + 1
      lastCursor = it.cursor
    }
    more = it.next() catch e {
      panic("scan: ${e.message()}")
    }
  }
  assert(len(seen) == total, "scan saw ${len(seen)} distinct members, want ${total}")
  assert(pages > 2, "scan should span several pages, saw ${pages}")
  c.close()
}

test "live: scan with MATCH yields only matching members" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let s = cleanSet(c, ["bit:live:set:scanmatch"])
  s.add("user:1", "user:2", "order:1") catch e {
    panic("add: ${e.message()}")
  }
  let got = []string(0)
  let it = s.scan("user:*")
  let more = it.next() catch e {
    panic("scan: ${e.message()}")
  }
  while (isSome(more)) {
    got = append(got, unwrap(more))
    more = it.next() catch e {
      panic("scan: ${e.message()}")
    }
  }
  assertSetEq(got, ["user:1", "user:2"], "scan MATCH user:*")
  c.close()
}

test "live: a pipeline queues set commands through SetBatch" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:set:queued"
  let other = "bit:live:set:queued:other"
  let _ = cleanSet(c, [key, other])

  let p = c.pipeline()
  let q = p.sset(key)
  let added = q.add("a", "b", "c")
  let isIn = q.has("a")
  let both = q.hasMany("a", "x")
  let size = q.len()
  let members = q.members()
  let otherAdd = p.sset(other).add("b", "c", "d")
  let inter = q.inter(other)
  let card = q.interCard([other], 0)
  p.exec() catch e {
    panic("pipeline exec: ${e.message()}")
  }

  let n = added.get() catch e {
    panic("add future: ${e.message()}")
  }
  assert(n == 3, "queued add = ${n}")
  let hit = isIn.get() catch e {
    panic("has future: ${e.message()}")
  }
  assert(hit, "queued has('a') should be true")
  let flags = both.get() catch e {
    panic("hasMany future: ${e.message()}")
  }
  assert(len(flags) == 2 && flags[0] && !flags[1], "queued hasMany length ${len(flags)}")
  let sz = size.get() catch e {
    panic("len future: ${e.message()}")
  }
  assert(sz == 3, "queued len = ${sz}")
  let all = members.get() catch e {
    panic("members future: ${e.message()}")
  }
  assertSetEq(all, ["a", "b", "c"], "queued members")
  let o = otherAdd.get() catch e {
    panic("other add future: ${e.message()}")
  }
  assert(o == 3, "queued add on the other set = ${o}")
  let common = inter.get() catch e {
    panic("inter future: ${e.message()}")
  }
  assertSetEq(common, ["b", "c"], "queued inter")
  let k = card.get() catch e {
    panic("interCard future: ${e.message()}")
  }
  assert(k == 2, "queued interCard = ${k}")
  c.close()
}

test "live: a transaction can queue set commands" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:set:tx"
  let _ = cleanSet(c, [key])

  let size = c.transaction<Future<i64>>([key], (tx) => {
    tx.sset(key).add("a", "b")
    return tx.sset(key).len()
  }) catch e {
    panic("transaction: ${e.message()}")
  }
  let n = size.get() catch e {
    panic("len future: ${e.message()}")
  }
  assert(n == 2, "len inside the transaction = ${n}")
  c.close()
}

test "live: tx.read.sset reads the set on the transaction's own connection" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:set:txread"
  let s = cleanSet(c, [key])
  s.add("a") catch e {
    panic("add: ${e.message()}")
  }

  let had = c.transaction<bool>([key], (tx) => {
    let has = tx.read.sset(key).has("a")?
    if (!has) {
      tx.sset(key).add("a")
    }
    tx.sset(key).add("b")
    return has
  }) catch e {
    panic("transaction: ${e.message()}")
  }
  assert(had, "tx.read.sset(key).has('a') should see the committed member")
  let n = s.len() catch e {
    panic("len: ${e.message()}")
  }
  assert(n == 2, "len after the transaction = ${n}")
  c.close()
}
