// pkg/redis/keys.live.test.bit — `r.keys()` against a real server.
// `liveUrl`/`liveClient` are `client.live.test.bit`'s own (this file is the
// same module, epic #6013's own convention — no import needed); every test
// is skipped, and says so, when `REDIS_TEST_URL` is unset. `./make
// test-package-redis-live` (`_tests_/bit/redislive.bit`) is what actually
// supplies it, against `redis:8.10.2` in a throwaway Docker container.

test "live: UNLINK/TOUCH act on existing and missing keys" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let a = "bit:live:keys:unlink:a"
  let b = "bit:live:keys:unlink:b"
  c.set(a, "1") catch e {
    panic("set: ${e.message()}")
  }
  c.set(b, "2") catch e {
    panic("set: ${e.message()}")
  }

  let touched = c.keys().touch(a, b, "bit:live:keys:unlink:missing") catch e {
    panic("touch: ${e.message()}")
  }
  assert(touched == 2, "expected 2 keys touched, got ${touched}")

  let removed = c.keys().unlink(a, b) catch e {
    panic("unlink: ${e.message()}")
  }
  assert(removed == 2, "expected 2 keys unlinked, got ${removed}")

  let gone = c.get(a) catch e {
    panic("get: ${e.message()}")
  }
  assert(isNone(gone), "expected key to be gone after unlink")
  c.close()
}

test "live: EXPIRE/PEXPIRE/EXPIREAT/PEXPIREAT honor NX/XX/GT/LT condition flags" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:keys:expireflags"
  c.set(key, "v") catch e {
    panic("set: ${e.message()}")
  }
  let k = c.keys()

  let setFresh = k.expire(key, 100 * Second, "NX") catch e {
    panic("expire NX: ${e.message()}")
  }
  assert(setFresh, "NX on a key with no TTL should succeed")

  let blockedNx = k.expire(key, 200 * Second, "NX") catch e {
    panic("expire NX again: ${e.message()}")
  }
  assert(!blockedNx, "NX on a key that already has a TTL should refuse")

  let grown = k.expire(key, 500 * Second, "GT") catch e {
    panic("expire GT: ${e.message()}")
  }
  assert(grown, "GT with a larger TTL should succeed")

  let refusedShrink = k.expire(key, 10 * Second, "GT") catch e {
    panic("expire GT smaller: ${e.message()}")
  }
  assert(!refusedShrink, "GT with a smaller TTL should refuse")

  // `100 * Second`, not a sub-second value: a TTL small enough to expire
  // before the next command in this test runs would make every assertion
  // after it fail on "no such key", not on LT itself.
  let shrunk = k.pexpire(key, 100 * Second, "LT") catch e {
    panic("pexpire LT: ${e.message()}")
  }
  assert(shrunk, "LT with a smaller TTL should succeed")

  let nowNs = now().ns
  let atFuture = k.expireAt(key, nowNs + 300 * Second, "") catch e {
    panic("expireAt: ${e.message()}")
  }
  assert(atFuture, "expireAt in the future should succeed")

  let pAtFuture = k.pexpireAt(key, nowNs + 300 * Second, "") catch e {
    panic("pexpireAt: ${e.message()}")
  }
  assert(pAtFuture, "pexpireAt in the future should succeed")
  c.close()
}

test "live: TTL/PTTL distinguish no-key, no-expiry and a real duration" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let k = c.keys()
  let missing = "bit:live:keys:ttl:missing"
  c.del([missing]) catch e {
    panic("del: ${e.message()}")
  }
  let noKey = k.ttl(missing) catch e {
    panic("ttl: ${e.message()}")
  }
  match (noKey) {
    NoKey => {}
    _ => panic("expected NoKey for a missing key")
  }

  let noExpiryKey = "bit:live:keys:ttl:noexpiry"
  c.set(noExpiryKey, "v") catch e {
    panic("set: ${e.message()}")
  }
  let noExpiry = k.ttl(noExpiryKey) catch e {
    panic("ttl: ${e.message()}")
  }
  match (noExpiry) {
    NoExpiry => {}
    _ => panic("expected NoExpiry for a key with no TTL")
  }

  let withTtlKey = "bit:live:keys:ttl:withttl"
  c.set(withTtlKey, "v") catch e {
    panic("set: ${e.message()}")
  }
  k.expire(withTtlKey, 60 * Second, "") catch e {
    panic("expire: ${e.message()}")
  }
  let remaining = k.ttl(withTtlKey) catch e {
    panic("ttl: ${e.message()}")
  }
  match (remaining) {
    Remaining(ns) => assert(ns > 0 && ns <= 60 * Second, "ttl remaining = ${ns}")
    _ => panic("expected Remaining")
  }

  let pRemaining = k.pttl(withTtlKey) catch e {
    panic("pttl: ${e.message()}")
  }
  match (pRemaining) {
    Remaining(ns) => assert(ns > 0, "pttl remaining = ${ns}")
    _ => panic("expected Remaining from pttl")
  }

  let persisted = k.persist(withTtlKey) catch e {
    panic("persist: ${e.message()}")
  }
  assert(persisted, "persist should report true")
  let afterPersist = k.ttl(withTtlKey) catch e {
    panic("ttl: ${e.message()}")
  }
  match (afterPersist) {
    NoExpiry => {}
    _ => panic("expected NoExpiry after persist")
  }
  c.close()
}

test "live: TYPE reports the right KeyType for each data structure" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let strKey = "bit:live:keys:type:string"
  let hashKey = "bit:live:keys:type:hash"
  let missing = "bit:live:keys:type:missing"
  c.set(strKey, "v") catch e {
    panic("set: ${e.message()}")
  }
  c.hash(hashKey).setField("f", "v") catch e {
    panic("hset: ${e.message()}")
  }
  c.del([missing]) catch e {
    panic("del: ${e.message()}")
  }

  let strType = c.keys().keyType(strKey) catch e {
    panic("type: ${e.message()}")
  }
  match (strType) {
    KeyString => {}
    _ => panic("expected KeyString")
  }

  let hashType = c.keys().keyType(hashKey) catch e {
    panic("type: ${e.message()}")
  }
  match (hashType) {
    KeyHash => {}
    _ => panic("expected KeyHash")
  }

  let noneType = c.keys().keyType(missing) catch e {
    panic("type: ${e.message()}")
  }
  match (noneType) {
    KeyNone => {}
    _ => panic("expected KeyNone for a missing key")
  }
  c.close()
}

test "live: RENAME/RENAMENX/COPY/RANDOMKEY/OBJECT ENCODING manage keys" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let k = c.keys()
  let src = "bit:live:keys:manage:src"
  let dst = "bit:live:keys:manage:dst"
  let dst2 = "bit:live:keys:manage:dst2"
  c.del([src, dst, dst2]) catch e {
    panic("del: ${e.message()}")
  }
  c.set(src, "v") catch e {
    panic("set: ${e.message()}")
  }

  k.rename(src, dst) catch e {
    panic("rename: ${e.message()}")
  }
  let renamed = c.get(dst) catch e {
    panic("get: ${e.message()}")
  }
  match (renamed) {
    Some(v) => assert(v == "v", "renamed value = '${v}'")
    None => panic("expected the value at the new name")
  }

  c.set(dst2, "existing") catch e {
    panic("set: ${e.message()}")
  }
  let refused = k.renameNx(dst, dst2) catch e {
    panic("renameNx: ${e.message()}")
  }
  assert(!refused, "renameNx onto an existing key should refuse")

  let copied = k.copy(dst, "bit:live:keys:manage:copy1", false, -1) catch e {
    panic("copy: ${e.message()}")
  }
  assert(copied, "copy to a fresh destination should succeed")

  let refusedCopy = k.copy(dst, dst2, false, -1) catch e {
    panic("copy: ${e.message()}")
  }
  assert(!refusedCopy, "copy onto an existing destination without REPLACE should refuse")

  let replaced = k.copy(dst, dst2, true, -1) catch e {
    panic("copy REPLACE: ${e.message()}")
  }
  assert(replaced, "copy with REPLACE should succeed")

  let random = k.randomKey() catch e {
    panic("randomKey: ${e.message()}")
  }
  assert(isSome(random), "expected a random key in a non-empty database")

  let encoding = k.objectEncoding(dst) catch e {
    panic("objectEncoding: ${e.message()}")
  }
  assert(encoding != "", "expected a non-empty encoding name")
  c.close()
}

test "live: MGET/MSET/MSETNX operate on several keys at once" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let k = c.keys()
  let a = "bit:live:keys:mset:a"
  let b = "bit:live:keys:mset:b"
  c.del([a, b]) catch e {
    panic("del: ${e.message()}")
  }

  k.mset(map<string, string>{ "bit:live:keys:mset:a": "1", "bit:live:keys:mset:b": "2" }) catch e {
    panic("mset: ${e.message()}")
  }
  let got = k.getMany(a, b, "bit:live:keys:mset:missing") catch e {
    panic("getMany: ${e.message()}")
  }
  assert(len(got) == 3, "expected 3 results, got ${len(got)}")
  assert(isSome(got[0]) && unwrap(got[0]) == "1", "got[0] should be Some('1')")
  assert(isNone(got[2]), "got[2] should be None")

  let refused = k.msetNx(map<string, string>{ a: "3" }) catch e {
    panic("msetNx: ${e.message()}")
  }
  assert(!refused, "msetNx should refuse when any key already exists")

  c.del([a, b]) catch e {
    panic("del: ${e.message()}")
  }
  let created = k.msetNx(map<string, string>{ a: "1", b: "2" }) catch e {
    panic("msetNx: ${e.message()}")
  }
  assert(created, "msetNx on fresh keys should succeed")
  c.close()
}

// 500 keys, `count = 10`: SCAN's own default COUNT hint is 10, so this
// forces the iterator through multiple cursor pages before it sees "0".
test "live: SCAN walks every matching key across more than one cursor page" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let prefix = "bit:live:keys:scan:"
  let i = 0
  while (i < 500) {
    c.set("${prefix}${i}", "v") catch e {
      panic("set: ${e.message()}")
    }
    i = i + 1
  }

  let it = c.keys().scan("${prefix}*", 10, "")
  let seen = map<string, string>()
  let next = it.next() catch e {
    panic("scan: ${e.message()}")
  }
  while (isSome(next)) {
    let key = unwrap(next)
    seen[key] = "1"
    next = it.next() catch e {
      panic("scan: ${e.message()}")
    }
  }
  assert(len(seen) == 500, "expected to see 500 keys, got ${len(seen)}")
  assert(seen["${prefix}0"] == "1", "expected to see the first key")
  assert(seen["${prefix}499"] == "1", "expected to see the last key")
  c.close()
}

test "live: a pipeline and a transaction can both queue key-management commands" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:keys:queued"
  c.set(key, "v") catch e {
    panic("set: ${e.message()}")
  }

  let p = c.pipeline()
  let touchFuture = p.keys().touch(key)
  let ttlFuture = p.keys().ttl(key)
  p.exec() catch e {
    panic("pipeline exec: ${e.message()}")
  }
  let touched = touchFuture.get() catch e {
    panic("touchFuture.get: ${e.message()}")
  }
  assert(touched == 1, "pipelined touch = ${touched}")
  let ttl = ttlFuture.get() catch e {
    panic("ttlFuture.get: ${e.message()}")
  }
  match (ttl) {
    NoExpiry => {}
    _ => panic("expected NoExpiry")
  }
  c.close()
}

test "live: tx.read.keys reads type, ttl and values before the queued write runs, and refuses a write" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:keys:txread"
  c.set(key, "v") catch e {
    panic("set: ${e.message()}")
  }
  let out = c.transaction<Future<bool>>([key], (tx) => {
    let queued = tx.keys().expire(key, 60 * Second, "")
    let k = tx.read.keys()
    match (k.ttl(key)?) {
      NoExpiry => {}
      _ => panic("ttl saw the queued expire before EXEC")
    }
    match (k.keyType(key)?) {
      KeyString => {}
      _ => panic("keyType = not a string")
    }
    let got = k.getMany(key)?
    assert(len(got) == 1 && unwrap(got[0]) == "v", "getMany saw the pre-EXEC value")
    let refused = false
    let _ = k.expire(key, 5 * Second, "") catch _ {
      refused = true
      false
    }
    assert(refused, "a write through tx.read is refused")
    return queued
  }) catch e {
    panic("transaction: ${e.message()}")
  }
  let applied = out.get() catch e {
    panic("future: ${e.message()}")
  }
  assert(applied, "the queued expire committed")
  let left = c.keys().ttl(key) catch e {
    panic("ttl after: ${e.message()}")
  }
  match (left) {
    Remaining(ns) => assert(ns > 50 * Second, "ttl after EXEC = ${ns}: the refused 5s never landed")
    _ => panic("expected a TTL after EXEC")
  }
  c.del([key]) catch e {
    panic("del: ${e.message()}")
  }
  c.close()
}
