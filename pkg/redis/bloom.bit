// pkg/redis/bloom.bit — `r.bloom(key)`: the probabilistic data-structures
// handle covering RedisBloom's five types (bloom, cuckoo, count-min sketch,
// top-k, t-digest — epic #6013's data-type list). Epic #6013, #6028:
// SCAFFOLD ONLY, no commands wired yet (`BF.ADD`, `CF.ADD`, `CMS.INCRBY`,
// `TOPK.ADD`, `TDIGEST.ADD`, ...). One class for now; a follow-up ticket
// splits it into five once real commands land, if `Bloom` alone would
// otherwise cross spec/LINT.md's 800-line/complexity-10 ceilings — not
// before, since an empty split has nothing to prove it is a pure move yet
// (`file-splits.md`). `cmd.bit`'s header is the template.
export class Bloom {
  client: Client,
  key: string,
}

// The queued view `Pipeline.bloom`/`Tx.bloom` both return — `cmd.bit`'s
// `Batch` is the ONE client-side queue the two executors share, so this
// is the ONLY queued view Bloom needs (`cmd.bit`'s header, point 2).
export class BloomBatch {
  batch: Batch,
  key: string,
}
