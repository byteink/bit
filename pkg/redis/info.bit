// pkg/redis/info.bit — `INFO`'s section argument as an enum (#7444), so a
// typo (`"sever"`) is a compile error instead of a server-side reply that
// silently names nothing.
//
// The variants are the sections and groups on redis.io's INFO page. `Module`
// is the one free-form case: a module-defined section has no fixed name.
// `Default` is first because it is the enum's zero value (SPEC §13.4) and
// matches the server: no argument means the `default` group.

export enum InfoSection {
  Default
  Server
  Clients
  Memory
  Persistence
  Threads
  Stats
  Replication
  Cpu
  Modules
  Keyspace
  Commandstats
  Errorstats
  Latencystats
  Sentinel
  Cluster
  Keysizes
  Hotkeys
  All
  Everything
  Module(string)

  // The word `INFO` takes for this section. `Default` has none: plain `INFO`
  // sends no argument at all (`infoArgs`).
  word(): string {
    match (this) {
      Default => return "default"
      Server => return "server"
      Clients => return "clients"
      Memory => return "memory"
      Persistence => return "persistence"
      Threads => return "threads"
      Stats => return "stats"
      Replication => return "replication"
      Cpu => return "cpu"
      Modules => return "modules"
      Keyspace => return "keyspace"
      Commandstats => return "commandstats"
      Errorstats => return "errorstats"
      Latencystats => return "latencystats"
      Sentinel => return "sentinel"
      Cluster => return "cluster"
      Keysizes => return "keysizes"
      Hotkeys => return "hotkeys"
      All => return "all"
      Everything => return "everything"
      Module(name) => return name
    }
  }
}

// `["INFO"]` for `Default`, `["INFO", word]` otherwise.
fn infoArgs(section: InfoSection): []string {
  match (section) {
    Default => return ["INFO"]
    _ => return ["INFO", section.word()]
  }
}

// `INFO` replies with a bulk string (RESP2) or a verbatim string (RESP3);
// `replyToString` reads both.
fn infoCmd(section: InfoSection): Cmd<string> {
  return Cmd<string>{
    args = infoArgs(section),
    decode = (r) => replyToString(r, "INFO"),
    readOnly = true,
  }
}
