// pkg/redis/geo.bit — `r.geo(key)`: the geospatial handle. Epic
// #6013, #6028: SCAFFOLD ONLY, no commands wired yet (`GEOADD, GEOSEARCH, GEODIST`, a
// follow-up ticket) — this file exists so later family tickets touch only
// their own file, never `client.bit`. `cmd.bit`'s header is the template:
// one `Cmd<T>` factory per command, called from a method here.
export class Geo {
  client: Client,
  key: string,
}

// The queued view `Pipeline.geo`/`Tx.geo` both return — `cmd.bit`'s
// `Batch` is the ONE client-side queue the two executors share, so this
// is the ONLY queued view Geo needs (`cmd.bit`'s header, point 2).
export class GeoBatch {
  batch: Batch,
  key: string,
}
