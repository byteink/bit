// pkg/redis/geo.test.bit - `geo.bit`'s wire arguments, coordinate checks and
// reply decoders, tested without a server: plain arguments and `Reply`
// values. `assertArgs` is `list.test.bit`'s, `sBulk`/`sArr` are
// `script.test.bit`'s and `isInvalid` is `stream.test.bit`'s (same module).
// `geo.live.test.bit` runs every command against a real server.

fn geoPt(lon: f64, lat: f64): Reply {
  return sArr([Reply.Double(lon), Reply.Double(lat)])
}

fn geoEdges(): []GeoMember {
  return [place("a", 180.0, 85.05112878), place("b", -180.0, -85.05112878)]
}

fn geoRefused(members: []GeoMember): bool {
  let refused = false
  checkMembers(members) catch e {
    refused = isInvalid(e)
  }
  return refused
}

test "GEOADD sends the flags, then lon lat member for every member" {
  let two = [place("ana", 13.4, 52.5), place("bo", -0.12, 51.5)]
  assertArgs(
    geoAddCmd("k", two, GeoAddOptions{}).args,
    ["GEOADD", "k", "13.4", "52.5", "ana", "-0.12", "51.5", "bo"],
  )
  assertArgs(
    geoAddCmd("k", [place("ana", 13.4, 52.5)], GeoAddOptions{ nx = true, ch = true }).args,
    ["GEOADD", "k", "NX", "CH", "13.4", "52.5", "ana"],
  )
  assertArgs(
    geoAddCmd("k", [place("ana", 1.0, 2.0)], GeoAddOptions{ xx = true }).args,
    ["GEOADD", "k", "XX", "1", "2", "ana"],
  )
}

test "coordinates outside the map are Invalid, the edges are not" {
  assert(!geoRefused(geoEdges()), "the four edges of the map are valid")
  assert(geoRefused([place("a", 180.1, 0.0)]), "longitude 180.1")
  assert(geoRefused([place("a", -180.1, 0.0)]), "longitude -180.1")
  assert(geoRefused([place("a", 0.0, 85.06)]), "latitude 85.06")
  assert(geoRefused([place("a", 0.0, -85.06)]), "latitude -85.06")
  assert(geoRefused([place("ok", 1.0, 1.0), place("bad", 1.0, 90.0)]), "the second member is bad")
  let nan = 0.0 / 0.0
  assert(geoRefused([place("a", nan, 0.0)]), "NaN longitude")
  assert(geoRefused([place("a", 0.0, nan)]), "NaN latitude")
  assert(geoRefused([]GeoMember(0)), "no members")
}

test "the Invalid message names the value and the range" {
  let msg = ""
  checkMembers([place("a", 200.0, 0.0)]) catch e {
    msg = e.message()
  }
  assert(
    msg == "redis: invalid argument: longitude must be in -180..180, got 200",
    "msg = '${msg}'",
  )
}

test "GEOPOS, GEODIST and GEOHASH wire arguments" {
  assertArgs(geoPosCmd("k", ["a", "b"]).args, ["GEOPOS", "k", "a", "b"])
  assertArgs(geoDistCmd("k", "a", "b", GeoUnit.Kilometers).args, ["GEODIST", "k", "a", "b", "km"])
  assertArgs(geoDistCmd("k", "a", "b", GeoUnit.Meters).args, ["GEODIST", "k", "a", "b", "m"])
  assertArgs(geoDistCmd("k", "a", "b", GeoUnit.Feet).args, ["GEODIST", "k", "a", "b", "ft"])
  assertArgs(geoDistCmd("k", "a", "b", GeoUnit.Miles).args, ["GEODIST", "k", "a", "b", "mi"])
  assertArgs(geoHashCmd("k", ["a"]).args, ["GEOHASH", "k", "a"])
}

test "GEOSEARCH lays out the centre, the shape, the order, COUNT and the WITH flags" {
  assertArgs(
    geoSearchCmd(
      "k",
      GeoFrom.Member("ana"),
      GeoBy.Radius(5.0, GeoUnit.Kilometers),
      GeoSearchOptions{},
    ).args,
    ["GEOSEARCH", "k", "FROMMEMBER", "ana", "BYRADIUS", "5", "km"],
  )
  let all = GeoSearchOptions{
    order = GeoOrder.Nearest,
    count = 3,
    any = true,
    withCoord = true,
    withDist = true,
    withHash = true,
  }
  assertArgs(
    geoSearchCmd(
      "k",
      GeoFrom.At(Point{ lon = 13.4, lat = 52.5 }),
      GeoBy.Box(2.5, 4.0, GeoUnit.Miles),
      all,
    ).args,
    [
      "GEOSEARCH", "k", "FROMLONLAT", "13.4", "52.5", "BYBOX", "2.5", "4", "mi", "ASC", "COUNT", "3",
      "ANY", "WITHCOORD", "WITHDIST", "WITHHASH",
    ],
  )
  let far = GeoSearchOptions{ order = GeoOrder.Farthest, count = 1 }
  assertArgs(
    geoSearchCmd("k", GeoFrom.Member("a"), GeoBy.Radius(1.0, GeoUnit.Feet), far).args,
    ["GEOSEARCH", "k", "FROMMEMBER", "a", "BYRADIUS", "1", "ft", "DESC", "COUNT", "1"],
  )
}

test "GEOSEARCHSTORE names the destination first and ends with STOREDIST" {
  let opts = GeoStoreOptions{ order = GeoOrder.Farthest, count = 2, storeDist = true }
  assertArgs(
    geoSearchStoreCmd("dst", "src", GeoFrom.Member("a"), GeoBy.Radius(9.0, GeoUnit.Meters), opts).args,
    [
      "GEOSEARCHSTORE", "dst", "src", "FROMMEMBER", "a", "BYRADIUS", "9", "m", "DESC", "COUNT", "2",
      "STOREDIST",
    ],
  )
  assertArgs(
    geoSearchStoreCmd(
      "dst",
      "src",
      GeoFrom.Member("a"),
      GeoBy.Box(1.0, 2.0, GeoUnit.Meters),
      GeoStoreOptions{},
    ).args,
    ["GEOSEARCHSTORE", "dst", "src", "FROMMEMBER", "a", "BYBOX", "1", "2", "m"],
  )
}

test "a search refuses a centre off the map, a negative count and any without count" {
  let from = GeoFrom.Member("a")
  let offMap = false
  checkSearch(GeoFrom.At(Point{ lon = 0.0, lat = 90.0 }), 0, false) catch e {
    offMap = isInvalid(e)
  }
  assert(offMap, "a centre at latitude 90 is refused")
  let neg = false
  checkSearch(from, -1, false) catch e {
    neg = isInvalid(e)
  }
  assert(neg, "count -1 is refused")
  let any = false
  checkSearch(from, 0, true) catch e {
    any = isInvalid(e)
  }
  assert(any, "any without count is refused")
  checkSearch(from, 5, true) catch e {
    panic("count 5 with any is fine: ${e.message()}")
  }
}

test "GEOPOS decodes RESP3 doubles, RESP2 bulk strings and both kinds of missing member" {
  let resp3 = asGeoPoints(sArr([geoPt(13.4, 52.5), Reply.Null]), "GEOPOS") catch e {
    panic("resp3: ${e.message()}")
  }
  assert(len(resp3) == 2 && isSome(resp3[0]) && isNone(resp3[1]), "resp3 shape")
  assert(unwrap(resp3[0]).lon == 13.4 && unwrap(resp3[0]).lat == 52.5, "resp3 point")

  let two = sArr([sBulk("13.4"), sBulk("52.5")])
  let resp2 = asGeoPoints(sArr([two, Reply.Array(Option.None)]), "GEOPOS") catch e {
    panic("resp2: ${e.message()}")
  }
  assert(len(resp2) == 2 && isSome(resp2[0]) && isNone(resp2[1]), "resp2 shape")
  assert(unwrap(resp2[0]).lat == 52.5, "resp2 point")
}

test "GEODIST decodes a double, a decimal string and a missing member" {
  let d = asGeoDist(Reply.Double(12.5), "GEODIST") catch e {
    panic("double: ${e.message()}")
  }
  assert(isSome(d) && unwrap(d) == 12.5, "double")
  let s = asGeoDist(sBulk("7.25"), "GEODIST") catch e {
    panic("bulk: ${e.message()}")
  }
  assert(isSome(s) && unwrap(s) == 7.25, "bulk")
  let n1 = asGeoDist(Reply.Null, "GEODIST") catch e {
    panic("null: ${e.message()}")
  }
  assert(isNone(n1), "RESP3 null")
  let n2 = asGeoDist(Reply.Bulk(Option.None), "GEODIST") catch e {
    panic("null bulk: ${e.message()}")
  }
  assert(isNone(n2), "RESP2 null bulk")
}

test "GEOHASH decodes a string per member and None for a missing one" {
  let hs = asGeoHashes(sArr([sBulk("u33dc0cpke0"), Reply.Null]), "GEOHASH") catch e {
    panic("hashes: ${e.message()}")
  }
  assert(len(hs) == 2 && unwrap(hs[0]) == "u33dc0cpke0" && isNone(hs[1]), "hashes")
}

test "GEOSEARCH decodes bare members, and the extras in dist, hash, coordinates order" {
  let bare = geoWith{ dist = false, hash = false, coord = false }
  let names = asGeoHits(sArr([sBulk("a"), sBulk("b")]), bare, "GEOSEARCH") catch e {
    panic("bare: ${e.message()}")
  }
  assert(len(names) == 2 && names[0].member == "a" && names[1].member == "b", "bare members")
  assert(
    isNone(names[0].dist) && isNone(names[0].hash) && isNone(names[0].at),
    "bare extras are None",
  )

  let want = geoWith{ dist = true, hash = true, coord = true }
  let hit = sArr([sBulk("a"), Reply.Double(1.5), Reply.Int(3471579339700058), geoPt(13.4, 52.5)])
  let full = asGeoHits(sArr([hit]), want, "GEOSEARCH") catch e {
    panic("full: ${e.message()}")
  }
  assert(full[0].member == "a" && unwrap(full[0].dist) == 1.5, "member and dist")
  assert(unwrap(full[0].hash) == 3471579339700058 && unwrap(full[0].at).lat == 52.5, "hash and at")

  let onlyCoord = geoWith{ dist = false, hash = false, coord = true }
  let c = asGeoHits(
    sArr([sArr([sBulk("a"), sArr([sBulk("1.5"), sBulk("2.5")])])]),
    onlyCoord,
    "GEOSEARCH",
  ) catch e {
    panic("coord: ${e.message()}")
  }
  assert(isNone(c[0].dist) && unwrap(c[0].at).lon == 1.5, "coord alone sits in slot 1")
}

test "geo decoders refuse a reply of the wrong shape" {
  let none = geoWith{ dist = false, hash = false, coord = false }
  let bad = false
  let _ = asGeoHits(Reply.Int(1), none, "GEOSEARCH") catch _ {
    bad = true
    []GeoHit(0)
  }
  assert(bad, "an integer is not a hit list")
  let short = false
  let withDist = geoWith{ dist = true, hash = false, coord = false }
  let _ = asGeoHits(sArr([sArr([sBulk("a")])]), withDist, "GEOSEARCH") catch _ {
    short = true
    []GeoHit(0)
  }
  assert(short, "a hit missing its distance is refused")
  let pos = false
  let _ = asGeoPoints(Reply.Int(1), "GEOPOS") catch _ {
    pos = true
    []Option<Point>(0)
  }
  assert(pos, "an integer is not a position list")
}

test "GeoBatch queues the commands with Geo's argv and refuses what Geo refuses" {
  let batch = Batch()
  let g = GeoBatch{ batch = batch, key = "k" }
  let _ = g.add([place("a", 1.0, 2.0)], GeoAddOptions{ nx = true })
  let _ = g.pos("a")
  let _ = g.dist("a", "b", GeoUnit.Feet)
  let _ = g.hash("a")
  let _ = g.search(GeoFrom.Member("a"), GeoBy.Radius(1.0, GeoUnit.Meters))
  let _ = g.searchStore("d", GeoFrom.Member("a"), GeoBy.Radius(1.0, GeoUnit.Meters))
  let want = [
    ["GEOADD", "k", "NX", "1", "2", "a"],
    ["GEOPOS", "k", "a"],
    ["GEODIST", "k", "a", "b", "ft"],
    ["GEOHASH", "k", "a"],
    ["GEOSEARCH", "k", "FROMMEMBER", "a", "BYRADIUS", "1", "m"],
    ["GEOSEARCHSTORE", "d", "k", "FROMMEMBER", "a", "BYRADIUS", "1", "m"],
  ]
  assert(len(batch.queued) == len(want), "queued ${len(batch.queued)} commands")
  let i = 0
  while (i < len(want)) {
    assertArgs(batch.queued[i], want[i])
    i = i + 1
  }

  let refused = g.add([place("a", 999.0, 2.0)])
  let failed = false
  let _ = refused.get() catch e {
    failed = isInvalid(e)
    0
  }
  assert(failed, "a bad coordinate is a failed Future, not a queued command")
  assert(len(batch.queued) == len(want), "the refused add queued nothing")
}
