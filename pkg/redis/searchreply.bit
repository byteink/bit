// pkg/redis/searchreply.bit - decoders for `FT.SEARCH`, `FT.AGGREGATE` and
// `FT.CURSOR READ`. Epic #6013, #6044. RESP3 (the default) answers a map
// (`total_results`, `results` -> a map per document with `id`, `score`,
// `payload`, `sortkey`, `extra_attributes`); RESP2 a flat array (`total`, then
// per document the id, optional score/payload/sortkey, and the field list).
// Both are read, so a client opened with RESP2 sees the same values.

// The text of a field value: a string as is, a number as it prints. A value
// that is neither (a nested array a `RETURN` of a JSON path produced) is the
// decoder's `Unexpected`, not a silent empty.
fn fieldText(r: Reply, cmd: string): string!RedisError {
  match (r) {
    Int(n) => return "${n}"
    Double(d) => return "${d}"
    Null => return ""
    _ => return replyToString(r, cmd)?
  }
}

fn isNullReply(r: Reply): bool {
  match (r) {
    Null => return true
    _ => return false
  }
}

fn fieldsOfPairs(pairs: []MapEntry, cmd: string): []Field!RedisError {
  let out = []Field(0)
  for p of pairs {
    out = append(out, Field{ name = replyToString(p.key, cmd)?, value = fieldText(p.value, cmd)? })
  }
  return out
}

// A score, or `[score, explanation]` under `EXPLAINSCORE`.
fn scoreOf(r: Reply, cmd: string): (f64, Option<string>)!RedisError {
  match (r) {
    Array(items) => {
      let l = unwrapOr(items, []Reply(0))
      if (len(l) == 0) {
        fail RedisError.Unexpected(cmd, "Array")
      }
      let score = asDouble(l[0], cmd)?
      let why: Option<string> = Option.Some(explainText(l[1:len(l)], cmd)?)
      return score, why
    }
    _ => {
      let score = asDouble(r, cmd)?
      let why: Option<string> = Option.None
      return score, why
    }
  }
}

fn explainText(rest: []Reply, cmd: string): string!RedisError {
  let out = ""
  for x of rest {
    match (x) {
      Array(items) => out = out + explainText(unwrapOr(items, []Reply(0)), cmd)?
      _ => out = out + fieldText(x, cmd)? + "\n"
    }
  }
  return out
}

// One RESP3 document map.
fn hitOfMap(r: Reply): Hit!RedisError {
  let cmd = "FT.SEARCH"
  let pairs = sketchPairs(r, cmd)?
  let hit = Hit{ id = replyToString(infoFind(pairs, "id"), cmd)? }
  let score = infoFind(pairs, "score")
  if (!isNullReply(score)) {
    let (sc, why) = scoreOf(score, cmd)?
    hit.score = Option.Some(sc)
    hit.scoreExplain = why
  }
  hit.payload = asOptString(infoFind(pairs, "payload"), cmd)?
  hit.sortKey = asOptString(infoFind(pairs, "sortkey"), cmd)?
  let extra = infoFind(pairs, "extra_attributes")
  if (!isNullReply(extra)) {
    hit.fields = fieldsOfPairs(sketchPairs(extra, cmd)?, cmd)?
  }
  return hit
}

fn searchOfMap(entries: []MapEntry): SearchResult!RedisError {
  let hits = []Hit(0)
  let rs = infoFind(entries, "results")
  if (!isNullReply(rs)) {
    for d of replyItems(rs, "FT.SEARCH")? {
      hits = append(hits, hitOfMap(d)?)
    }
  }
  return SearchResult{ total = sketchField(entries, "total_results", "FT.SEARCH")?, hits = hits }
}

// RESP2's flat array: after `total`, each document is its id, then the score,
// payload and sort key it was asked for, then (unless `NOCONTENT`) its field
// list.
fn searchOfFlat(list: []Reply, o: SearchOptions): SearchResult!RedisError {
  let cmd = "FT.SEARCH"
  if (len(list) == 0) {
    fail RedisError.Unexpected(cmd, "Array")
  }
  let stride = 1
  if (o.withScores) {
    stride = stride + 1
  }
  if (o.withPayloads) {
    stride = stride + 1
  }
  if (o.withSortKeys) {
    stride = stride + 1
  }
  if (!o.noContent) {
    stride = stride + 1
  }
  if ((len(list) - 1) % stride != 0) {
    fail RedisError.Unexpected(cmd, "Array")
  }
  let hits = []Hit(0)
  let i = 1
  while (i < len(list)) {
    hits = append(hits, hitOfFlat(list[i:i + stride], o)?)
    i = i + stride
  }
  return SearchResult{ total = asInt(list[0], cmd)?, hits = hits }
}

fn hitOfFlat(d: []Reply, o: SearchOptions): Hit!RedisError {
  let cmd = "FT.SEARCH"
  let hit = Hit{ id = replyToString(d[0], cmd)? }
  let i = 1
  if (o.withScores) {
    let (sc, why) = scoreOf(d[i], cmd)?
    hit.score = Option.Some(sc)
    hit.scoreExplain = why
    i = i + 1
  }
  if (o.withPayloads) {
    hit.payload = asOptString(d[i], cmd)?
    i = i + 1
  }
  if (o.withSortKeys) {
    hit.sortKey = asOptString(d[i], cmd)?
    i = i + 1
  }
  if (!o.noContent) {
    hit.fields = fieldsOfPairs(sketchPairs(d[i], cmd)?, cmd)?
  }
  return hit
}

fn asSearchResult(r: Reply, o: SearchOptions): SearchResult!RedisError {
  match (r) {
    Map(entries) => return searchOfMap(entries)?
    Array(items) => return searchOfFlat(unwrapOr(items, []Reply(0)), o)?
    _ => fail RedisError.Unexpected("FT.SEARCH", shapeName(r))
  }
}

// ----------------------------------------------------------------- aggregate

fn rowOf(r: Reply, cmd: string): AggRow!RedisError {
  let pairs = sketchPairs(r, cmd)?
  match (r) {
    Map(_) => return rowOfMap(pairs, cmd)?
    _ => return AggRow{ fields = fieldsOfPairs(pairs, cmd)? }
  }
}

fn rowOfMap(pairs: []MapEntry, cmd: string): AggRow!RedisError {
  let extra = infoFind(pairs, "extra_attributes")
  if (isNullReply(extra)) {
    return AggRow{ fields = []Field(0) }
  }
  return AggRow{ fields = fieldsOfPairs(sketchPairs(extra, cmd)?, cmd)? }
}

fn aggOfMap(entries: []MapEntry, cursor: i64): AggResult!RedisError {
  let cmd = "FT.AGGREGATE"
  let rows = []AggRow(0)
  let rs = infoFind(entries, "results")
  if (!isNullReply(rs)) {
    for d of replyItems(rs, cmd)? {
      rows = append(rows, rowOf(d, cmd)?)
    }
  }
  return AggResult{
    total = sketchField(entries, "total_results", cmd)?,
    rows = rows,
    cursor = cursor,
  }
}

fn aggOfFlat(list: []Reply, cursor: i64): AggResult!RedisError {
  let cmd = "FT.AGGREGATE"
  if (len(list) == 0) {
    fail RedisError.Unexpected(cmd, "Array")
  }
  let rows = []AggRow(0)
  for d of list[1:len(list)] {
    rows = append(rows, rowOf(d, cmd)?)
  }
  return AggResult{ total = asInt(list[0], cmd)?, rows = rows, cursor = cursor }
}

fn aggBody(r: Reply, cursor: i64): AggResult!RedisError {
  match (r) {
    Map(entries) => return aggOfMap(entries, cursor)?
    Array(items) => return aggOfFlat(unwrapOr(items, []Reply(0)), cursor)?
    _ => fail RedisError.Unexpected("FT.AGGREGATE", shapeName(r))
  }
}

fn isBody(r: Reply): bool {
  match (r) {
    Map(_) => return true
    Array(_) => return true
    _ => return false
  }
}

// `FT.AGGREGATE`/`FT.CURSOR READ`: a body, or `[body, cursor]` under
// `WITHCURSOR`. A RESP2 body is itself an array that starts with an integer,
// so the pair is told by its first element being an aggregate.
fn asAggResult(r: Reply): AggResult!RedisError {
  match (r) {
    Array(items) => {
      let l = unwrapOr(items, []Reply(0))
      if (len(l) == 2 && isBody(l[0])) {
        return aggBody(l[0], asInt(l[1], "FT.AGGREGATE")?)?
      }
      return aggBody(r, 0)?
    }
    _ => return aggBody(r, 0)?
  }
}
