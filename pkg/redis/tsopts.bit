// pkg/redis/tsopts.bit - the vocabulary of `r.timeseries(key)`: samples,
// timestamps, aggregators, duplicate policies, label filters and the option
// classes the `TS.*` commands take. Epic #6013, #6028, #6038. The handles are
// in `timeseries.bit`, the `Cmd<T>` factories and reply decoders in
// `tscmd.bit`, the argument builders in `tsargs.bit`.
//
// TIMESTAMPS ARE UNIX MILLISECONDS (`i64`), exactly as the server stores
// them. DURATIONS ARE NANOSECONDS (`int`, `std/time`'s `Minute`, `Hour`), as
// everywhere in this package: a retention or a bucket is rounded UP to whole
// milliseconds on the way out, so `retention = Option.Some(Hour)` is 3600000.
//
// A TIMESTAMP ARGUMENT IS A `Stamp`, not a bare number, because three of its
// values are words: `Auto` is `*` (the server's clock, for `add`, `incrBy`
// and `decrBy`), `Oldest` is `-` and `Newest` is `+` (the open ends of a
// range). `Stamp.At(ms)` is a number. `StreamId` is the same shape.
//
// ONE OPTIONS CLASS PER SHAPE, NEVER TWO METHODS. `SeriesOptions` is the
// creation options `TS.CREATE`, `TS.ALTER`, `TS.ADD`, `TS.INCRBY` and
// `TS.DECRBY` all accept (a series `add` creates on the fly gets them);
// `RangeOptions` is what `TS.RANGE` and `TS.REVRANGE` take and
// `MrangeOptions` wraps it with the multi-key extras.

// One data point: when (unix ms) and what.
export class Sample { export ts: i64, export value: f64 }

// A timestamp argument. `text()` is the word or number the server expects.
export enum Stamp {
  Auto
  Oldest
  Newest
  At(i64)

  export text(): string {
    match (this) {
      Auto => return "*"
      Oldest => return "-"
      Newest => return "+"
      At(ms) => return "${ms}"
    }
  }
}

// What the server does when a sample arrives at a timestamp the series
// already has: refuse it (`Block`), keep the first or the last, keep the
// smaller or larger, or add the two values.
export enum DuplicatePolicy {
  Block
  First
  Last
  Min
  Max
  Sum

  export text(): string {
    match (this) {
      Block => return "BLOCK"
      First => return "FIRST"
      Last => return "LAST"
      Min => return "MIN"
      Max => return "MAX"
      Sum => return "SUM"
    }
  }
}

// How the series stores its chunks.
export enum Encoding {
  Compressed
  Uncompressed

  export text(): string {
    match (this) {
      Compressed => return "COMPRESSED"
      Uncompressed => return "UNCOMPRESSED"
    }
  }
}

// Every aggregator `TS.RANGE .. AGGREGATION`, `TS.CREATERULE` and `GROUPBY ..
// REDUCE` accept (Redis 8.10). `StdP`/`StdS` are the population and sample
// standard deviation, `VarP`/`VarS` the variances, `Twa` the time-weighted
// average, `CountNan` counts NaN samples, `CountAll` counts every sample, NaN
// or not.
export enum Aggregation {
  Avg
  Sum
  Min
  Max
  Range
  Count
  First
  Last
  StdP
  StdS
  VarP
  VarS
  Twa
  CountNan
  CountAll

  // The lowercase word the server expects.
  export text(): string {
    match (this) {
      Avg => return "avg"
      Sum => return "sum"
      Min => return "min"
      Max => return "max"
      Range => return "range"
      Count => return "count"
      First => return "first"
      Last => return "last"
      StdP => return "std.p"
      StdS => return "std.s"
      VarP => return "var.p"
      VarS => return "var.s"
      Twa => return "twa"
      CountNan => return "countnan"
      CountAll => return "countall"
    }
  }
}

// Which timestamp a bucket carries in an aggregated range: where it starts,
// where it ends (the start of the next bucket), or its middle.
export enum BucketTs {
  Start
  End
  Mid

  export text(): string {
    match (this) {
      Start => return "start"
      End => return "end"
      Mid => return "mid"
    }
  }
}

// `IGNORE`: a sample within `maxTimeDiff` milliseconds of the last one and
// within `maxValueDiff` of its value is dropped, which keeps a flat sensor
// from filling the series.
export class Ignore { export maxTimeDiff: i64, export maxValueDiff: f64 }

// What a series is made with. Every field is left to the server's default
// until set. `retention` (nanoseconds, `Option.Some(0)` keeps forever) drops
// samples older than the newest minus that; `chunkSize` is in bytes;
// `labels` are the `name -> value` pairs the filters match on: `None` leaves
// them alone, `Some(m)` sets exactly `m` (an empty `m` removes every label).
// `encoding` is fixed at creation, which is why `alter` takes `AlterOptions`.
export class SeriesOptions {
  export retention: Option<int> = Option.None,
  export encoding: Option<Encoding> = Option.None,
  export chunkSize: Option<i64> = Option.None,
  export duplicatePolicy: Option<DuplicatePolicy> = Option.None,
  export ignore: Option<Ignore> = Option.None,
  export labels: Option<map<string, string>> = Option.None,
}

// What `alter` changes: `SeriesOptions` without `encoding`, which the server
// silently ignores on `TS.ALTER`. A field left `None` stays as it is.
export class AlterOptions {
  export retention: Option<int> = Option.None,
  export chunkSize: Option<i64> = Option.None,
  export duplicatePolicy: Option<DuplicatePolicy> = Option.None,
  export ignore: Option<Ignore> = Option.None,
  export labels: Option<map<string, string>> = Option.None,
}

// A label test for `mget`, `mrange` and `queryIndex`: `label("region")
// .eq("eu")`. Each test is a `Filter`; the server wants at least one
// equality among them.
export class Filter { export expr: string }

// `label(name)`: what to test a label against.
export class LabelRef {
  export name: string

  // `name=value`.
  export eq(value: string): Filter { return Filter{ expr = "${this.name}=${value}" } }
  // `name!=value`.
  export ne(value: string): Filter { return Filter{ expr = "${this.name}!=${value}" } }
  // `name=(a,b,..)`: the label is one of `values`.
  export oneOf(...values: string): Filter {
    return Filter{ expr = "${this.name}=(${joinCommas(values)})" }
  }
  // `name!=(a,b,..)`: the label is none of `values`.
  export noneOf(...values: string): Filter {
    return Filter{ expr = "${this.name}!=(${joinCommas(values)})" }
  }
  // `name!=`: the series has the label, whatever its value.
  export exists(): Filter { return Filter{ expr = "${this.name}!=" } }
  // `name=`: the series does not have the label.
  export absent(): Filter { return Filter{ expr = "${this.name}=" } }
}

export fn label(name: string): LabelRef { return LabelRef{ name = name } }

// A filter written as the server's own text, for anything the builder does
// not cover.
export fn rawFilter(expr: string): Filter { return Filter{ expr = expr } }

fn joinCommas(values: []string): string {
  let out = ""
  let i = 0
  while (i < len(values)) {
    if (i > 0) {
      out = out + ","
    }
    out = out + values[i]
    i = i + 1
  }
  return out
}

// `FILTER_BY_VALUE`: only samples with `min <= value <= max`.
export class ValueRange { export min: f64, export max: f64 }

// `AGGREGATION`: group the samples into buckets of `bucket` (nanoseconds,
// rounded up to a millisecond) and reduce each with `by`. Buckets start at
// `align` (a unix ms timestamp, default 0) plus whole multiples of the bucket.
// `empty` also reports the buckets with no sample (`Twa` and `Count` fill them
// meaningfully, the rest answer NaN).
export class Downsample {
  export by: Aggregation,
  export bucket: int,
  export align: Option<i64> = Option.None,
  export bucketTs: BucketTs = BucketTs.Start,
  export empty: bool = false,
}

// What `range`, `revrange` and the multi-key reads share. `latest` also
// reports a compaction rule's still-open bucket, `onlyTs` keeps just the
// samples at those timestamps, `count` caps the samples returned (0 is all).
export class RangeOptions {
  export latest: bool = false,
  export onlyTs: []i64 = []i64(0),
  export valueRange: Option<ValueRange> = Option.None,
  export count: i64 = 0,
  export downsample: Option<Downsample> = Option.None,
}

// Which labels a multi-key read returns with each series: none, all
// (`WITHLABELS`), or just the named ones (`SELECTED_LABELS`).
export enum LabelsOut {
  Omit,
  All,
  Only([]string),
}

// `GROUPBY label REDUCE reduce`: merge the series that share a value of
// `label` into one, combining their samples at each timestamp with `reduce`.
export class GroupBy { export label: string, export reduce: Aggregation }

// `mrange`/`mrevrange`'s knobs: the single-key ones (`range`) plus which
// labels to return, how to group, and whether to leave out empty buckets
// (`EXCLUDEEMPTY`, with `groupBy`).
export class MrangeOptions {
  export range: RangeOptions = RangeOptions{},
  export labels: LabelsOut = LabelsOut.Omit,
  export groupBy: Option<GroupBy> = Option.None,
  export excludeEmpty: bool = false,
}

// One sample for `madd`: which series, when, what.
export class KeyedSample { export key: string, export ts: Stamp, export value: f64 }

// What `madd` answered for one point: the timestamp it was stored at, or the
// server's refusal (a duplicate under `Block`, a key that is not a series).
export class AddResult { export ts: i64, export error: Option<string> }

// One series of `mrange`/`mrevrange`: its key, the labels asked for, its
// samples. For a `groupBy` result `key` is `label=value` and `sources` are
// the series merged into it (empty otherwise).
export class SeriesRange {
  export key: string,
  export labels: map<string, string>,
  export sources: []string,
  export samples: []Sample,
}

// One series of `mget`: its key, the labels asked for, its newest sample
// (`None` for an empty series).
export class SeriesLast {
  export key: string,
  export labels: map<string, string>,
  export sample: Option<Sample>,
}

// A compaction rule: samples of the source go to `dest` aggregated by `by`
// into buckets of `bucket` nanoseconds starting at `align` (unix ms).
export class Rule {
  export dest: string,
  export bucket: int,
  export by: Aggregation,
  export align: i64,
}

// `TS.INFO`. Times are the server's: `firstTimestamp` and `lastTimestamp` are
// unix ms (0 for an empty series), `retention` nanoseconds. `duplicatePolicy`
// is `None` when the series has none set; `sourceKey` is `Some` for a rule's
// destination; `rules` are the compaction rules leaving this series.
export class SeriesInfo {
  export totalSamples: i64,
  export memoryUsage: i64,
  export firstTimestamp: i64,
  export lastTimestamp: i64,
  export retention: int,
  export chunkCount: i64,
  export chunkSize: i64,
  export encoding: Encoding,
  export duplicatePolicy: Option<DuplicatePolicy>,
  export labels: map<string, string>,
  export sourceKey: Option<string>,
  export rules: []Rule,
  export ignoreMaxTimeDiff: i64,
  export ignoreMaxValDiff: f64,
}
