// pkg/redis/zsetold.live.test.bit — the 6.2-gated sorted-set reads against a
// real server (#7840). `scores`, `top`, `bottom` and `byScore` send ZMSCORE and
// `ZRANGE ... REV|BYSCORE` on Redis 6.2+, and ZSCORE per member, ZREVRANGE,
// ZRANGE and ZRANGEBYSCORE before it. One checker runs against Redis 8.10.2
// (RESP3, `REDIS_TEST_URL`) and Redis 5.0.14 (the RESP2 fallback,
// `REDIS_TEST_V5_URL`) and compares both to the same literal answers, so the
// two servers give identical results. The second half (#7844) runs `rank`,
// `union`, `inter` and `interCard` the same way (an EVAL on a server older than
// 7.2/6.2/7.0) and asserts the commands with no older form fail naming 6.2 on
// Redis 5 while they work on Redis 8. Same module as `zset.live.test.bit`:
// `liveUrl`, `liveClient`, `legacyClient` and `delKey` are in scope.

fn inc(v: f64): Bound<f64> { return Bound<f64>.Inclusive(v) }

fn exc(v: f64): Bound<f64> { return Bound<f64>.Exclusive(v) }

fn show(xs: []Scored): string {
  let out = ""
  for x of xs {
    out = out + "${x.member}:${x.score} "
  }
  return out
}

fn showScores(xs: []Option<f64>): string {
  let out = ""
  for x of xs {
    match (x) {
      Some(v) => out = out + "${v} "
      None => out = out + "- "
    }
  }
  return out
}

fn seedGated(c: Client, key: string): Zset {
  delKey(c, key)
  let z = c.zset(key)
  z.addMany(
    Scored{ member = "lo", score = 0.0 - 1.0 / 0.0 },
    Scored{ member = "a", score = 1.0 },
    Scored{ member = "b", score = 2.5 },
    Scored{ member = "c", score = 3.0 },
    Scored{ member = "d", score = 4.0 },
    Scored{ member = "hi", score = 1.0 / 0.0 },
  ) catch e {
    panic("addMany: ${e.message()}")
  }
  return z
}

fn expectRange(label: string, run: () => []Scored!RedisError, want: string) {
  let xs = run() catch e {
    panic("${label}: ${e.message()}")
  }
  assert(show(xs) == want, "${label}: got '${show(xs)}', want '${want}'")
}

fn checkScores(z: Zset) {
  let xs = z.scores("c", "nobody", "hi", "lo", "a") catch e {
    panic("scores: ${e.message()}")
  }
  assert(showScores(xs) == "3 - inf -inf 1 ", "scores: '${showScores(xs)}'")
  let one = z.scores("b") catch e {
    panic("scores one: ${e.message()}")
  }
  assert(showScores(one) == "2.5 ", "scores one: '${showScores(one)}'")
  z.scores() catch _ {
    return
  }
  panic("scores() with no member should fail")
}

fn checkRankRanges(z: Zset) {
  expectRange("top(2)", () => z.top(2), "hi:inf d:4 ")
  expectRange("bottom(2)", () => z.bottom(2), "lo:-inf a:1 ")
  expectRange("top(100)", () => z.top(100), "hi:inf d:4 c:3 b:2.5 a:1 lo:-inf ")
  expectRange("bottom(100)", () => z.bottom(100), "lo:-inf a:1 b:2.5 c:3 d:4 hi:inf ")
  expectRange("top(0)", () => z.top(0), "")
}

fn checkScoreRanges(z: Zset) {
  let all = Bound<f64>.Unbounded
  expectRange("all", () => z.byScore(all, all, noLimit()), "lo:-inf a:1 b:2.5 c:3 d:4 hi:inf ")
  expectRange("[1,3]", () => z.byScore(inc(1.0), inc(3.0), noLimit()), "a:1 b:2.5 c:3 ")
  expectRange("(1,3)", () => z.byScore(exc(1.0), exc(3.0), noLimit()), "b:2.5 ")
  expectRange("(1,3]", () => z.byScore(exc(1.0), inc(3.0), noLimit()), "b:2.5 c:3 ")
  expectRange(
    "[-inf,2.5]",
    () => z.byScore(inc(0.0 - 1.0 / 0.0), inc(2.5), noLimit()),
    "lo:-inf a:1 b:2.5 ",
  )
  expectRange(
    "(2.5,+inf]",
    () => z.byScore(exc(2.5), inc(1.0 / 0.0), noLimit()),
    "c:3 d:4 hi:inf ",
  )
  expectRange(
    "(-inf,+inf)",
    () => z.byScore(exc(0.0 - 1.0 / 0.0), exc(1.0 / 0.0), noLimit()),
    "a:1 b:2.5 c:3 d:4 ",
  )
  expectRange("limit 2", () => z.byScore(all, all, limitTo(2)), "lo:-inf a:1 ")
  expectRange(
    "offset 2 count 2",
    () => z.byScore(all, all, Limit{ offset = 2, count = 2 }),
    "b:2.5 c:3 ",
  )
  expectRange(
    "offset 5 count 9",
    () => z.byScore(all, all, Limit{ offset = 5, count = 9 }),
    "hi:inf ",
  )
  expectRange("empty range", () => z.byScore(inc(10.0), inc(20.0), noLimit()), "")
}

// The queued forms read the version off their Batch (a Pipeline's, a Tx's).
fn checkPipelined(c: Client, key: string, modern: bool) {
  let p = c.pipeline()
  let v = p.zset(key)
  let top = v.top(2)
  let bottom = v.bottom(1)
  let by = v.byScore(Bound<f64>.Exclusive(1.0), Bound<f64>.Unbounded, limitTo(2))
  p.exec() catch e {
    panic("exec: ${e.message()}")
  }
  expectRange("pipelined top", () => top.get(), "hi:inf d:4 ")
  expectRange("pipelined bottom", () => bottom.get(), "lo:-inf ")
  expectRange("pipelined byScore", () => by.get(), "b:2.5 c:3 ")
  checkQueuedScores(c, key, modern)
}

fn checkQueuedScores(c: Client, key: string, modern: bool) {
  let p = c.pipeline()
  let f = p.zset(key).scores("a", "zz")
  if (!modern) {
    f.get() catch e {
      assert(
        contains(e.message(), "6.2") && contains(e.message(), "5.0"),
        "message: ${e.message()}",
      )
      return
    }
    panic("a queued scores on Redis 5 should fail naming 6.2")
  }
  p.exec() catch e {
    panic("exec scores: ${e.message()}")
  }
  let xs = f.get() catch e {
    panic("queued scores: ${e.message()}")
  }
  assert(showScores(xs) == "1 - ", "queued scores: '${showScores(xs)}'")
}

// `tx.read` runs the immediate forms on the attempt's pinned connection.
fn checkTxRead(c: Client, key: string) {
  let out = c.transaction<string>([key], (tx) => {
    let z = tx.read.zset(key)
    let xs = z.scores("a", "zz")?
    let top = z.top(1)?
    let by = z.byScore(Bound<f64>.Inclusive(3.0), Bound<f64>.Unbounded, noLimit())?
    return showScores(xs) + "| " + show(top) + "| " + show(by)
  }) catch e {
    panic("transaction: ${e.message()}")
  }
  assert(out == "1 - | hi:inf | c:3 d:4 hi:inf ", "tx.read: '${out}'")
}

fn checkVersionGatedReads(c: Client, key: string, modern: bool) {
  if (modern) {
    assert(c.version >= 6002, "version ${c.version} should be 6.2+")
  } else {
    assert(c.version == 5000, "version ${c.version} should be 5.0")
  }
  let z = seedGated(c, key)
  checkScores(z)
  checkRankRanges(z)
  checkScoreRanges(z)
  checkPipelined(c, key, modern)
  checkTxRead(c, key)
  delKey(c, key)
}

fn seedPair(c: Client, a: string, b: string): Zset {
  delKey(c, a)
  delKey(c, b)
  let za = c.zset(a)
  za.addMany(
    Scored{ member = "x", score = 1.0 },
    Scored{ member = "y", score = 2.0 },
    Scored{ member = "z", score = 3.0 },
  ) catch e {
    panic("seed a: ${e.message()}")
  }
  c.zset(b).addMany(
    Scored{ member = "y", score = 10.0 },
    Scored{ member = "z", score = 20.0 },
    Scored{ member = "q", score = 5.0 },
  ) catch e {
    panic("seed b: ${e.message()}")
  }
  return za
}

fn showRank(r: Option<(i64, f64)>): string {
  match (r) {
    Some(t) => return "${t.0}:${t.1}"
    None => return "-"
  }
}

fn checkRank(z: Zset) {
  let top = z.rank("z", true) catch e {
    panic("rank top: ${e.message()}")
  }
  let bottom = z.rank("x", false) catch e {
    panic("rank bottom: ${e.message()}")
  }
  let mid = z.rank("y", true) catch e {
    panic("rank mid: ${e.message()}")
  }
  let none = z.rank("nobody", true) catch e {
    panic("rank missing: ${e.message()}")
  }
  assert(showRank(top) == "0:3", "rank z top: ${showRank(top)}")
  assert(showRank(bottom) == "0:1", "rank x bottom: ${showRank(bottom)}")
  assert(showRank(mid) == "1:2", "rank y top: ${showRank(mid)}")
  assert(showRank(none) == "-", "rank missing: ${showRank(none)}")
}

fn checkSetOps(c: Client, z: Zset, b: string, scratch: string) {
  let other = [b]
  expectRange("union sum", () => z.union(other, []f64(0), Aggregate.Sum), "x:1 q:5 y:12 z:23 ")
  expectRange(
    "union weights max",
    () => z.union(other, [2.0, 1.0], Aggregate.Max),
    "x:2 q:5 y:10 z:20 ",
  )
  expectRange(
    "union missing key",
    () => z.union(["bit:live:zset:nokey"], []f64(0), Aggregate.Sum),
    "x:1 y:2 z:3 ",
  )
  expectRange("inter sum", () => z.inter(other, []f64(0), Aggregate.Sum), "y:12 z:23 ")
  expectRange("inter min", () => z.inter(other, []f64(0), Aggregate.Min), "y:2 z:3 ")
  expectRange(
    "inter missing key",
    () => z.inter(["bit:live:zset:nokey"], []f64(0), Aggregate.Sum),
    "",
  )
  let all = z.interCard(other, 0) catch e {
    panic("interCard: ${e.message()}")
  }
  let capped = z.interCard(other, 1) catch e {
    panic("interCard limit: ${e.message()}")
  }
  let roomy = z.interCard(other, 9) catch e {
    panic("interCard roomy: ${e.message()}")
  }
  assert(all == 2 && capped == 1 && roomy == 2, "interCard ${all} ${capped} ${roomy}")
  let left = c.exists([scratch]) catch e {
    panic("exists: ${e.message()}")
  }
  assert(left == 0, "the scratch key must not outlive the call")
}

fn expectTooOld<T>(label: string, run: () => T!RedisError) {
  run() catch e {
    assert(
      contains(e.message(), "6.2") && contains(e.message(), "5.0"),
      "${label}: ${e.message()}",
    )
    return
  }
  panic("${label} should fail on Redis 5")
}

fn checkNoOlderForm(c: Client, z: Zset, b: string) {
  expectTooOld("diff", () => z.diff([b]))
  expectTooOld("diffStore", () => z.diffStore("bit:live:zset:dst", [b]))
  expectTooOld("randMember", () => z.randMember())
  expectTooOld("randMembers", () => z.randMembers(2))
  expectTooOld("storeTop", () => z.storeTop("bit:live:zset:dst", 2))
  expectTooOld("storeBottom", () => z.storeBottom("bit:live:zset:dst", 2))
  let n = c.exists(["bit:live:zset:dst"]) catch e {
    panic("exists: ${e.message()}")
  }
  assert(n == 0, "a refused command must not have written")
}

fn checkNewForms(z: Zset, b: string) {
  expectRange("diff", () => z.diff([b]), "x:1 ")
  let stored = z.storeTop("bit:live:zset:dst", 2) catch e {
    panic("storeTop: ${e.message()}")
  }
  assert(stored == 2, "storeTop stored ${stored}")
  let one = z.randMember() catch e {
    panic("randMember: ${e.message()}")
  }
  assert(isSome(one), "randMember of a non-empty set")
}

// The same four on a pipeline and on `tx.read`: each is one command.
fn checkSetOpsQueued(c: Client, key: string, b: string) {
  let p = c.pipeline()
  let v = p.zset(key)
  let rank = v.rank("z", true)
  let union = v.union([b], []f64(0), Aggregate.Sum)
  let card = v.interCard([b], 0)
  p.exec() catch e {
    panic("exec: ${e.message()}")
  }
  let r = rank.get() catch e {
    panic("queued rank: ${e.message()}")
  }
  assert(showRank(r) == "0:3", "queued rank: ${showRank(r)}")
  expectRange("queued union", () => union.get(), "x:1 q:5 y:12 z:23 ")
  let n = card.get() catch e {
    panic("queued interCard: ${e.message()}")
  }
  assert(n == 2, "queued interCard ${n}")
  let out = c.transaction<string>([key], (tx) => {
    let z = tx.read.zset(key)
    let ranked = z.rank("y", false)?
    let u = z.inter([b], []f64(0), Aggregate.Max)?
    return showRank(ranked) + "| " + show(u)
  }) catch e {
    panic("transaction: ${e.message()}")
  }
  assert(out == "1:2| y:10 z:20 ", "tx.read: '${out}'")
}

fn checkScratchCollision(c: Client, z: Zset, b: string, scratch: string) {
  c.zset(scratch).add("keep", 1.0) catch e {
    panic("seed scratch: ${e.message()}")
  }
  z.union([b], []f64(0), Aggregate.Sum) catch e {
    assert(contains(e.message(), "scratch key exists"), "collision: ${e.message()}")
    let kept = c.zset(scratch).card() catch e2 {
      panic("card: ${e2.message()}")
    }
    assert(kept == 1, "a user key that looks like the scratch key must survive")
    delKey(c, scratch)
    return
  }
  panic("union over an existing scratch key should fail")
}

fn checkSetOpsAndRank(c: Client, a: string, b: string, modern: bool) {
  let z = seedPair(c, a, b)
  let scratch = "bit:zsetop:" + a
  checkRank(z)
  checkSetOps(c, z, b, scratch)
  checkSetOpsQueued(c, a, b)
  if (modern) {
    checkNewForms(z, b)
  } else {
    checkNoOlderForm(c, z, b)
    checkScratchCollision(c, z, b, scratch)
  }
  delKey(c, a)
  delKey(c, b)
  delKey(c, "bit:live:zset:dst")
}

test "live: scores, top, bottom and byScore on RESP3 (Redis 8)" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  checkVersionGatedReads(c, "bit:live:zset:gated3", true)
  checkSetOpsAndRank(c, "bit:live:zset:ops3a", "bit:live:zset:ops3b", true)
  c.close()
}

test "live: scores, top, bottom and byScore give the same answers over the RESP2 fallback (Redis 5)" {
  let u = liveUrl("REDIS_TEST_V5_URL")
  if (u == "") {
    return
  }
  let c = legacyClient(u)
  checkVersionGatedReads(c, "bit:live:zset:gated2", false)
  checkSetOpsAndRank(c, "bit:live:zset:ops2a", "bit:live:zset:ops2b", false)
  c.close()
}
