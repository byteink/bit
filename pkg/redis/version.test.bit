// pkg/redis/version.test.bit — the server-version readers in `version.bit`
// (#7840), against the exact strings Redis 5.0.14 and 8.10.2 answer.

test "versionCode reads major.minor and ignores patch and suffix" {
  assert(versionCode("5.0.14") == 5000, "5.0.14 = ${versionCode("5.0.14")}")
  assert(versionCode("6.2.0") == 6002, "6.2.0 = ${versionCode("6.2.0")}")
  assert(versionCode("8.10.2") == 8010, "8.10.2 = ${versionCode("8.10.2")}")
  assert(versionCode("7.0.0-rc1") == 7000, "7.0.0-rc1 = ${versionCode("7.0.0-rc1")}")
  assert(versionCode("255.255.255") == 255255, "unstable build = ${versionCode("255.255.255")}")
}

test "versionCode is 0, unknown, for anything that is not a version" {
  assert(versionCode("") == 0, "empty")
  assert(versionCode("garbage") == 0, "no dot")
  assert(versionCode(".5") == 0, "no major")
  assert(versionCode("7.") == 7000, "major only reads as x.0")
}

test "infoVersion reads the redis_version line of an INFO body" {
  let info = "# Server\r\nredis_version:5.0.14\r\nredis_mode:standalone\r\n"
  assert(infoVersion(info) == "5.0.14", "infoVersion = '${infoVersion(info)}'")
  assert(infoVersion("# Server\nredis_version:8.10.2\n") == "8.10.2", "LF only")
  assert(infoVersion("no version here") == "", "absent")
}

test "helloVersion reads the version field of a RESP3 map and a RESP2 flat array" {
  let m = Reply.Map(
    [
      MapEntry{ key = Reply.Bulk(Option.Some("server")), value = Reply.Bulk(Option.Some("redis")) },
      MapEntry{
        key = Reply.Bulk(Option.Some("version")),
        value = Reply.Bulk(Option.Some("8.10.2")),
      },
      MapEntry{ key = Reply.Bulk(Option.Some("proto")), value = Reply.Int(3) },
    ],
  )
  assert(helloVersion(m) == "8.10.2", "map = '${helloVersion(m)}'")
  let flat = Reply.Array(
    Option.Some(
      [
        Reply.Bulk(Option.Some("server")),
        Reply.Bulk(Option.Some("redis")),
        Reply.Bulk(Option.Some("version")),
        Reply.Bulk(Option.Some("6.2.6")),
      ],
    ),
  )
  assert(helloVersion(flat) == "6.2.6", "flat = '${helloVersion(flat)}'")
  assert(helloVersion(Reply.Null) == "", "a reply with no fields has no version")
}
