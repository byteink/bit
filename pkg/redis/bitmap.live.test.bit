// pkg/redis/bitmap.live.test.bit - `r.bitmap(key)` against a real server.
// `liveUrl`/`liveClient` are `client.live.test.bit`'s own (same module, no
// import); every test is skipped, and says so, when `REDIS_TEST_URL` is unset.
// `./make test-package-redis-live` (`_tests_/bit/redislive.bit`) supplies it,
// against `redis:8.10.2` in a throwaway Docker container.

fn bmClean(c: Client, keys: []string) {
  c.del(keys) catch e {
    panic("del: ${e.message()}")
  }
}

// The first byte of the bitmap as "10110000", leftmost bit first.
fn bmByte(b: Bitmap): string {
  let out = ""
  let i = 0
  while (i < 8) {
    let on = b.get(i) catch e {
      panic("get(${i}): ${e.message()}")
    }
    if (on) {
      out = out + "1"
    } else {
      out = out + "0"
    }
    i = i + 1
  }
  return out
}

// A one-byte bitmap with the given bits set.
fn bmWith(c: Client, key: string, bits: []int): Bitmap {
  bmClean(c, [key])
  let b = c.bitmap(key)
  for bit of bits {
    let _ = b.set(bit, true) catch e {
      panic("set(${bit}): ${e.message()}")
    }
  }
  return b
}

fn bmVals(ops: BitFieldOps, b: Bitmap): []Option<i64> {
  return b.bitfield(ops) catch e {
    panic("bitfield: ${e.message()}")
  }
}

test "live: bitmap set returns the old bit, get reads it, past the end is false" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:bitmap:daily"
  bmClean(c, [key])
  let b = c.bitmap(key)

  let was = b.set(7, true) catch e {
    panic("set: ${e.message()}")
  }
  assert(!was, "bit 7 was clear")
  let now = b.get(7) catch e {
    panic("get: ${e.message()}")
  }
  assert(now, "bit 7 is set")
  assert(bmByte(b) == "00000001", "bit 7 is the last bit of byte 0: ${bmByte(b)}")
  let raw = c.get(key) catch e {
    panic("raw get: ${e.message()}")
  }
  assert(len(unwrap(raw)) == 1, "one byte so far, got ${len(unwrap(raw))}")

  let again = b.set(7, false) catch e {
    panic("set false: ${e.message()}")
  }
  assert(again, "setting it off returns the old value, true")
  let far = b.get(100000) catch e {
    panic("get far: ${e.message()}")
  }
  assert(!far, "a bit past the end reads false")
  b.set(15, true) catch e {
    panic("set 15: ${e.message()}")
  }
  let grown = c.get(key) catch e {
    panic("raw get grown: ${e.message()}")
  }
  assert(len(unwrap(grown)) == 2, "writing bit 15 grows the string to two bytes")

  let refused = false
  let _ = b.set(4294967296, true) catch e {
    refused = isInvalid(e)
    false
  }
  assert(refused, "offset 2^32 is Invalid")
  let neg = false
  let _ = b.get(-1) catch e {
    neg = isInvalid(e)
    false
  }
  assert(neg, "offset -1 is Invalid")
  bmClean(c, [key])
  c.close()
}

test "live: bitmap count and pos honour byte and bit ranges" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:bitmap:foobar"
  bmClean(c, [key])
  let _ = c.set(key, "foobar") catch e {
    panic("set: ${e.message()}")
  }
  let b = c.bitmap(key)

  let all = b.count() catch e {
    panic("count: ${e.message()}")
  }
  assert(all == 26, "foobar has 26 set bits, got ${all}")
  let first = b.count(BitRange.Bytes(0, 0)) catch e {
    panic("count bytes 0: ${e.message()}")
  }
  assert(first == 4, "byte 0 has 4 set bits, got ${first}")
  let second = b.count(BitRange.Bytes(1, 1)) catch e {
    panic("count bytes 1: ${e.message()}")
  }
  assert(second == 6, "byte 1 has 6 set bits, got ${second}")
  let tail = b.count(BitRange.Bytes(-2, -1)) catch e {
    panic("count bytes -2: ${e.message()}")
  }
  assert(tail == 7, "the last two bytes (a, r) have 7 set bits, got ${tail}")
  let bits = b.count(BitRange.Bits(5, 30)) catch e {
    panic("count bits: ${e.message()}")
  }
  assert(bits == 17, "bits 5 to 30 hold 17 set bits, got ${bits}")
  let startOnly = false
  let _ = b.count(BitRange.From(1)) catch e {
    startOnly = isInvalid(e)
    0
  }
  assert(startOnly, "count with only a start is Invalid")

  let one = b.pos(true) catch e {
    panic("pos: ${e.message()}")
  }
  assert(one == 1, "the first set bit of 'f' (0x66) is bit 1, got ${one}")
  let zero = b.pos(false) catch e {
    panic("pos 0: ${e.message()}")
  }
  assert(zero == 0, "the first clear bit is bit 0, got ${zero}")
  let fromByte = b.pos(true, BitRange.From(1)) catch e {
    panic("pos from: ${e.message()}")
  }
  assert(fromByte == 9, "the first set bit from byte 1 is bit 9, got ${fromByte}")
  let span = b.pos(true, BitRange.Bytes(1, 2)) catch e {
    panic("pos bytes: ${e.message()}")
  }
  assert(span == 9, "bytes 1 to 2: bit 9, got ${span}")
  let inBits = b.pos(true, BitRange.Bits(7, 15)) catch e {
    panic("pos bits: ${e.message()}")
  }
  assert(inBits == 9, "bits 7 to 15: bit 9, got ${inBits}")
  bmClean(c, [key])
  c.close()
}

test "live: bitmap pos on a string of ones answers one past the end without an end, -1 with one" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:bitmap:ones"
  let b = bmWith(c, key, [0, 1, 2, 3, 4, 5, 6, 7])

  let open = b.pos(false) catch e {
    panic("pos: ${e.message()}")
  }
  assert(open == 8, "no end: one past the end, got ${open}")
  let from = b.pos(false, BitRange.From(0)) catch e {
    panic("pos from: ${e.message()}")
  }
  assert(from == 8, "a start alone is still open ended, got ${from}")
  let closed = b.pos(false, BitRange.Bytes(0, -1)) catch e {
    panic("pos bytes: ${e.message()}")
  }
  assert(closed == -1, "an end makes it -1, got ${closed}")

  let missing = c.bitmap("bit:live:bitmap:missing")
  let none = missing.pos(true) catch e {
    panic("pos missing set: ${e.message()}")
  }
  assert(none == -1, "no set bit in a missing key, got ${none}")
  let clear = missing.pos(false) catch e {
    panic("pos missing clear: ${e.message()}")
  }
  assert(clear == 0, "a missing key is all clear, got ${clear}")
  bmClean(c, [key])
  c.close()
}

test "live: bitmap op runs every operator the server accepts" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let ka = "bit:live:bitmap:opa"
  let kb = "bit:live:bitmap:opb"
  let kc = "bit:live:bitmap:opc"
  let kd = "bit:live:bitmap:opdst"
  let _ = bmWith(c, ka, [0, 1, 2, 3])
  let _ = bmWith(c, kb, [2, 3, 4, 5])
  let _ = bmWith(c, kc, [3, 4])
  let dst = c.bitmap(kd)

  let cases = [
    (BitOp.And, "00110000"), (BitOp.Or, "11111100"), (BitOp.Xor, "11001100"),
    (BitOp.Diff, "11000000"), (BitOp.Diff1, "00001100"),
  ]
  for pair of cases {
    let (op, want) = pair
    let size = dst.op(op, ka, kb) catch e {
      panic("${op.text()}: ${e.message()}")
    }
    assert(size == 1, "${op.text()} stores one byte, got ${size}")
    assert(bmByte(dst) == want, "${op.text()} a b = ${bmByte(dst)}, want ${want}")
  }
  let notSize = dst.op(BitOp.Not, ka) catch e {
    panic("NOT: ${e.message()}")
  }
  assert(notSize == 1 && bmByte(dst) == "00001111", "NOT a = ${bmByte(dst)}")
  let andor = dst.op(BitOp.AndOr, ka, kb, kc) catch e {
    panic("ANDOR: ${e.message()}")
  }
  assert(andor == 1 && bmByte(dst) == "00110000", "ANDOR a b c = ${bmByte(dst)}")
  let one = dst.op(BitOp.One, ka, kb, kc) catch e {
    panic("ONE: ${e.message()}")
  }
  assert(one == 1 && bmByte(dst) == "11000100", "ONE a b c = ${bmByte(dst)}")

  let bad = false
  let _ = dst.op(BitOp.Not, ka, kb) catch e {
    match (e) {
      Server(_, _) => bad = true
      _ => bad = false
    }
    0
  }
  assert(bad, "NOT with two sources is the server's error")
  bmClean(c, [ka, kb, kc, kd])
  c.close()
}

test "live: bitmap bitfield get, set, incrBy and the three overflow modes" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:bitmap:field"
  bmClean(c, [key])
  let b = c.bitmap(key)
  let byteType = BitType.Unsigned(8)

  let set = bmVals(bitfield().set(byteType, BitAt.Bit(0), 200).get(byteType, BitAt.Bit(0)), b)
  assert(
    len(set) == 2 && unwrap(set[0]) == 0 && unwrap(set[1]) == 200,
    "set answers the old value, then get",
  )

  let wrap = bmVals(bitfield().incrBy(byteType, BitAt.Bit(0), 100), b)
  assert(unwrap(wrap[0]) == 44, "200 + 100 wraps to 44, got ${unwrap(wrap[0])}")

  let sat = bmVals(bitfield().overflow(BitOverflow.Sat).incrBy(byteType, BitAt.Bit(0), 300), b)
  assert(unwrap(sat[0]) == 255, "SAT stops at 255, got ${unwrap(sat[0])}")

  let refused = bmVals(
    bitfield().overflow(BitOverflow.Fail).incrBy(byteType, BitAt.Bit(0), 1).get(
      byteType,
      BitAt.Bit(0),
    ),
    b,
  )
  assert(len(refused) == 2 && isNone(refused[0]), "FAIL refuses the increment")
  assert(unwrap(refused[1]) == 255, "and leaves the value, got ${unwrap(refused[1])}")

  let back = bmVals(
    bitfield().overflow(BitOverflow.Wrap).incrBy(byteType, BitAt.Bit(0), 1).get(
      byteType,
      BitAt.Bit(0),
    ),
    b,
  )
  assert(unwrap(back[0]) == 0 && unwrap(back[1]) == 0, "WRAP takes 255 + 1 to 0")

  bmClean(c, [key])
  let i5 = BitType.Signed(5)
  let slot = BitAt.Slot(1)
  let steps = bitfield().set(i5, slot, -3).get(i5, slot).get(BitType.Unsigned(5), slot)
  let clamped = steps.overflow(BitOverflow.Sat).incrBy(i5, slot, -100).incrBy(i5, slot, 100)
  let signed = bmVals(clamped, b)
  assert(len(signed) == 5, "five results, got ${len(signed)}")
  assert(unwrap(signed[1]) == -3, "i5 reads back -3, got ${unwrap(signed[1])}")
  assert(unwrap(signed[2]) == 29, "the same five bits as u5 are 29, got ${unwrap(signed[2])}")
  assert(unwrap(signed[3]) == -16, "SAT clamps at -16, got ${unwrap(signed[3])}")
  assert(unwrap(signed[4]) == 15, "and at 15, got ${unwrap(signed[4])}")
  let none = bmVals(bitfield(), b)
  assert(len(none) == 0, "no operations, no results")
  bmClean(c, [key])
  c.close()
}

test "live: bitmap bitfieldRo reads, and refuses writes before sending" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:bitmap:fieldro"
  bmClean(c, [key])
  let b = c.bitmap(key)
  let byteType = BitType.Unsigned(8)
  let _ = bmVals(bitfield().set(byteType, BitAt.Bit(0), 7).set(byteType, BitAt.Slot(1), 9), b)

  let got = b.bitfieldRo(bitfield().get(byteType, BitAt.Bit(0)).get(byteType, BitAt.Slot(1))) catch e {
    panic("bitfieldRo: ${e.message()}")
  }
  assert(len(got) == 2 && unwrap(got[0]) == 7 && unwrap(got[1]) == 9, "reads both values")

  let write = false
  let _ = b.bitfieldRo(bitfield().set(byteType, BitAt.Bit(0), 1)) catch e {
    write = isInvalid(e)
    []Option<i64>(0)
  }
  assert(write, "a set through bitfieldRo is Invalid")
  let badType = false
  let _ = b.bitfield(bitfield().get(BitType.Unsigned(64), BitAt.Bit(0))) catch e {
    badType = isInvalid(e)
    []Option<i64>(0)
  }
  assert(badType, "u64 is Invalid")
  let unchanged = bmVals(bitfield().get(byteType, BitAt.Bit(0)), b)
  assert(unwrap(unchanged[0]) == 7, "the refused set changed nothing")
  bmClean(c, [key])
  c.close()
}

test "live: bitmap commands run in a pipeline and a transaction through BitmapBatch" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:bitmap:queued"
  let other = "bit:live:bitmap:queued:other"
  bmClean(c, [key, other])

  let p = c.pipeline()
  let q = p.bitmap(key)
  let s1 = q.set(1, true)
  let s2 = q.set(3, true)
  let g = q.get(3)
  let n = q.count()
  let pos = q.pos(true, BitRange.Bits(2, 7))
  let op = p.bitmap(other).op(BitOp.Or, key)
  let field = q.bitfield(bitfield().get(BitType.Unsigned(4), BitAt.Bit(0)))
  let ro = q.bitfieldRo(bitfield().get(BitType.Unsigned(4), BitAt.Bit(0)))
  p.exec() catch e {
    panic("pipeline exec: ${e.message()}")
  }
  let w1 = s1.get() catch e {
    panic("set future: ${e.message()}")
  }
  assert(!w1, "queued set returned the old bit")
  let w2 = s2.get() catch e {
    panic("set future: ${e.message()}")
  }
  assert(!w2, "queued second set returned the old bit")
  let bit = g.get() catch e {
    panic("get future: ${e.message()}")
  }
  assert(bit, "queued get(3)")
  let cnt = n.get() catch e {
    panic("count future: ${e.message()}")
  }
  assert(cnt == 2, "queued count = ${cnt}")
  let first = pos.get() catch e {
    panic("pos future: ${e.message()}")
  }
  assert(first == 3, "queued pos = ${first}")
  let size = op.get() catch e {
    panic("op future: ${e.message()}")
  }
  assert(size == 1, "queued op = ${size}")
  let f = field.get() catch e {
    panic("bitfield future: ${e.message()}")
  }
  assert(unwrap(f[0]) == 5, "queued bitfield u4 = ${unwrap(f[0])}")
  let r = ro.get() catch e {
    panic("bitfieldRo future: ${e.message()}")
  }
  assert(unwrap(r[0]) == 5, "queued bitfieldRo u4 = ${unwrap(r[0])}")

  let total = c.transaction<Future<i64>>([key], (tx) => {
    tx.bitmap(key).set(5, true)
    return tx.bitmap(key).count()
  }) catch e {
    panic("transaction: ${e.message()}")
  }
  let t = total.get() catch e {
    panic("transaction future: ${e.message()}")
  }
  assert(t == 3, "count inside the transaction = ${t}")
  bmClean(c, [key, other])
  c.close()
}
