// pkg/redis/keys.test.bit — `keys.bit`'s wire-arg builders and decode
// helpers, tested directly against plain arguments and `Reply` values: none
// of this needs a socket, real or fake (`cmd.test.bit`'s own split already
// proved the shared decode helpers this file reuses).

test "appendWhen adds the condition flag only when it is not empty" {
  let bare = appendWhen(["EXPIRE", "k", "60"], "")
  assert(len(bare) == 3, "expected 3 args, got ${len(bare)}")
  let flagged = appendWhen(["EXPIRE", "k", "60"], "NX")
  assert(len(flagged) == 4 && flagged[3] == "NX", "expected NX at index 3, got '${flagged[3]}'")
}

test "keysExpireCmd/keysPexpireCmd convert nanoseconds to their own wire unit" {
  let sec = keysExpireCmd("k", 60000000000, "")
  assert(sec.args[0] == "EXPIRE" && sec.args[2] == "60", "EXPIRE args[2] = '${sec.args[2]}'")

  let ms = keysPexpireCmd("k", 60000000000, "")
  assert(ms.args[0] == "PEXPIRE" && ms.args[2] == "60000", "PEXPIRE args[2] = '${ms.args[2]}'")
}

test "ttlFromSentinel distinguishes no-key, no-expiry and a real duration" {
  let noKey = ttlFromSentinel(-2, Second)
  match (noKey) {
    NoKey => {}
    _ => panic("expected NoKey")
  }
  let noExpiry = ttlFromSentinel(-1, Second)
  match (noExpiry) {
    NoExpiry => {}
    _ => panic("expected NoExpiry")
  }
  let remaining = ttlFromSentinel(30, Second)
  match (remaining) {
    Remaining(ns) => assert(ns == 30 * Second, "expected 30s in ns, got ${ns}")
    _ => panic("expected Remaining")
  }
}

test "keyTypeFromName maps every Redis TYPE name, unknown text fails" {
  let s = keyTypeFromName("string", "TYPE") catch e {
    panic("keyTypeFromName: ${e.message()}")
  }
  match (s) {
    KeyString => {}
    _ => panic("expected KeyString")
  }
  let none = keyTypeFromName("none", "TYPE") catch e {
    panic("keyTypeFromName: ${e.message()}")
  }
  match (none) {
    KeyNone => {}
    _ => panic("expected KeyNone")
  }
  let failed = false
  let _ = keyTypeFromName("bogus", "TYPE") catch _ {
    failed = true
    KeyType.KeyNone
  }
  assert(failed, "expected an unrecognised TYPE name to fail")
}

test "copyArgs sends DB only when db >= 0, REPLACE only when requested" {
  let bare = copyArgs("a", "b", false, -1)
  assert(len(bare) == 3, "expected 3 args, got ${len(bare)}")
  let full = copyArgs("a", "b", true, 2)
  assert(len(full) == 6, "expected 6 args, got ${len(full)}")
  assert(full[3] == "DB" && full[4] == "2", "args[3..4] = '${full[3]}', '${full[4]}'")
  assert(full[5] == "REPLACE", "args[5] = '${full[5]}'")
}

test "msetArgs puts the command then every key/value pair" {
  let args = msetArgs("MSET", map<string, string>{ "a": "1", "b": "2" })
  assert(args[0] == "MSET", "args[0] = '${args[0]}'")
  assert(len(args) == 5, "expected 5 args (cmd + 2 pairs), got ${len(args)}")
}

test "asOptStrings keeps the null-vs-empty distinction per key" {
  let items = [Reply.Bulk(Option.Some("v1")), Reply.Null, Reply.Bulk(Option.Some(""))]
  let got = asOptStrings(Reply.Array(Option.Some(items)), "MGET") catch e {
    panic("asOptStrings: ${e.message()}")
  }
  assert(len(got) == 3, "expected 3 entries, got ${len(got)}")
  assert(isSome(got[0]) && unwrap(got[0]) == "v1", "got[0] should be Some('v1')")
  assert(isNone(got[1]), "got[1] should be None")
  assert(isSome(got[2]) && unwrap(got[2]) == "", "got[2] should be Some('')")
}

test "keysScanArgs adds MATCH, COUNT and TYPE only when set" {
  let bare = keysScanArgs("0", "", 0, "")
  assert(len(bare) == 2, "expected 2 args, got ${len(bare)}")
  let full = keysScanArgs("12", "user:*", 50, "hash")
  assert(len(full) == 8, "expected 8 args, got ${len(full)}")
  assert(full[2] == "MATCH" && full[3] == "user:*", "args[2..3] = '${full[2]}', '${full[3]}'")
  assert(full[4] == "COUNT" && full[5] == "50", "args[4..5] = '${full[4]}', '${full[5]}'")
  assert(full[6] == "TYPE" && full[7] == "hash", "args[6..7] = '${full[6]}', '${full[7]}'")
}
