// pkg/redis/scan.test.bit - the SCAN-family iterators (`HashScanIterator`,
// `SetScanIterator`, `KeysScanIterator`, `ZsetScan`) against a FAKE local
// server that answers page 1 and then fails page 2 (#7138): a failed page fetch must
// come back from `next()` as an error, never a panic. Same fake-server shape
// as client.test.bit: bind port 0, `spawn` one accept-and-reply, dial it.

import { listen, Listener } from "std/net"

// Page 1 of each command: cursor "7" (so a page 2 is due), then one item.
const hscanPage1: string = "*2\r\n\$1\r\n7\r\n*2\r\n\$1\r\na\r\n\$1\r\n1\r\n"
const itemsPage1: string = "*2\r\n\$1\r\n7\r\n*1\r\n\$1\r\nx\r\n"
const zscanPage1: string = "*2\r\n\$1\r\n7\r\n*2\r\n\$1\r\nm\r\n\$1\r\n5\r\n"

// Serves `HELLO`, then page 1, then fails page 2: `page2` is a reply to send
// (a server error), or "" to drop the connection AND the listener - a
// network failure, so the client's one read retry cannot reconnect. The
// first accepted connection is `connect`'s HELLO probe (client.test.bit's
// `serveOnce`), the second is the one commands run on. Bounded: at most 2
// accepted connections.
fn serveScan(l: Listener, page1: string, page2: string, done: chan<int>) {
  let i = 0
  while (i < 2) {
    i = i + 1
    let c = l.accept() catch _ {
      done <- 0
      return
    }
    c.read(4096)
    c.write("%0\r\n") catch _ {
      c.close()
      done <- 0
      return
    }
    if (len(c.read(4096)) == 0) {
      c.close()
      continue
    }
    c.write(page1) catch _ {
      c.close()
      done <- 0
      return
    }
    c.read(4096)
    if (page2 != "") {
      c.write(page2) catch _ {
        c.close()
        done <- 0
        return
      }
    }
    c.close()
    l.close()
    done <- 1
    return
  }
  done <- 0
}

fn dialScan(page1: string, page2: string): (Client, chan<int>) {
  let l = listen("127.0.0.1", 0) catch e {
    panic("listen: ${e.message()}")
  }
  let port = l.port() catch e {
    panic("port: ${e.message()}")
  }
  let done = chan<int>(1)
  spawn serveScan(l, page1, page2, done)
  let client = connect(Options{ host = "127.0.0.1", port = port }) catch e {
    panic("connect: ${e.message()}")
  }
  return client, done
}

fn drainHash(it: HashScanIterator): int! {
  let n = 0
  for _ of it? {
    n = n + 1
  }
  return n
}

fn drainSet(it: SetScanIterator): int! {
  let n = 0
  for _ of it? {
    n = n + 1
  }
  return n
}

fn drainKeys(it: KeysScanIterator): int! {
  let n = 0
  for _ of it? {
    n = n + 1
  }
  return n
}

fn drainZset(it: ZsetScan): int! {
  let n = 0
  for _ of it? {
    n = n + 1
  }
  return n
}

test "HSCAN: a connection lost on page 2 fails next(), after page 1's pair" {
  let (client, done) = dialScan(hscanPage1, "")
  let it = client.hash("h").scan()
  let first = it.next() catch e {
    panic("page 1: ${e.message()}")
  }
  assert(isSome(first), "page 1 should yield its pair")
  let (field, value) = unwrap(first)
  assert(field == "a" && value == "1", "pair = '${field}', '${value}'")
  let failed = false
  let _ = it.next() catch _ {
    failed = true
    Option.None
  }
  <- done
  client.close()
  assert(failed, "next() must return the page-2 failure as an error")
}

test "HSCAN: a for-of loop over the iterator returns the page-2 error" {
  let (client, done) = dialScan(hscanPage1, "-ERR boom\r\n")
  let failed = false
  let _ = drainHash(client.hash("h").scan()) catch _ {
    failed = true
    0
  }
  <- done
  client.close()
  assert(failed, "for pair of it? must return the page-2 error")
}

test "SSCAN: a connection lost on page 2 fails next(), after page 1's member" {
  let (client, done) = dialScan(itemsPage1, "")
  let it = client.sset("s").scan()
  let first = it.next() catch e {
    panic("page 1: ${e.message()}")
  }
  assert(isSome(first) && unwrap(first) == "x", "page 1 should yield 'x'")
  let failed = false
  let _ = it.next() catch _ {
    failed = true
    Option.None
  }
  <- done
  client.close()
  assert(failed, "next() must return the page-2 failure as an error")
}

test "SSCAN: a for-of loop over the iterator returns the page-2 error" {
  let (client, done) = dialScan(itemsPage1, "-ERR boom\r\n")
  let failed = false
  let _ = drainSet(client.sset("s").scan()) catch _ {
    failed = true
    0
  }
  <- done
  client.close()
  assert(failed, "for member of it? must return the page-2 error")
}

test "SCAN: a for-of loop over the keyspace iterator returns the page-2 error" {
  let (client, done) = dialScan(itemsPage1, "")
  let failed = false
  let _ = drainKeys(client.keys().scan()) catch _ {
    failed = true
    0
  }
  <- done
  client.close()
  assert(failed, "for key of it? must return the page-2 error")
}

test "ZSCAN: a connection lost on page 2 fails next(), after page 1's scored member" {
  let (client, done) = dialScan(zscanPage1, "")
  let it = client.zset("z").scan()
  let first = it.next() catch e {
    panic("page 1: ${e.message()}")
  }
  assert(isSome(first), "page 1 should yield its member")
  let scored = unwrap(first)
  assert(
    scored.member == "m" && scored.score == 5.0,
    "scored = '${scored.member}', ${scored.score}",
  )
  let failed = false
  let _ = it.next() catch _ {
    failed = true
    Option.None
  }
  <- done
  client.close()
  assert(failed, "next() must return the page-2 failure as an error")
}

test "ZSCAN: a for-of loop over the iterator returns the page-2 server error" {
  let (client, done) = dialScan(zscanPage1, "-ERR boom\r\n")
  let failed = false
  let _ = drainZset(client.zset("z").scan()) catch _ {
    failed = true
    0
  }
  <- done
  client.close()
  assert(failed, "for entry of it? must return the page-2 error")
}
