// pkg/redis/vset.live.test.bit - the vector set handle against a real server.
// `liveUrl`/`liveClient` are `client.live.test.bit`'s own (same module, no
// import); every test is skipped, and says so, when `REDIS_TEST_URL` is
// unset. `./make test-package-redis-live` (`_tests_/bit/redislive.bit`)
// supplies it, against `redis:8.10.2`, which carries vector sets built in.
//
// The search is approximate, so each test stores a handful of vectors whose
// neighbours are not in doubt.

import { f32sFromLe } from "std/math"

@json class Player {
  team: string,
  lvl: i64,
}

fn vsetClean(c: Client, keys: []string) {
  c.del(keys) catch e {
    panic("del: ${e.message()}")
  }
}

// Four players on a plane: ana and bo close together, cy a little off, di on
// the opposite side.
fn vsetSeed(c: Client, k: string) {
  let vs = c.vset(k)
  let team = ["red", "red", "blue", "blue"]
  let names = ["ana", "bo", "cy", "di"]
  let xs: []f32 = [1.0, 0.9, 0.6, -1.0]
  let ys: []f32 = [0.0, 0.1, 0.8, 0.0]
  let i = 0
  while (i < len(names)) {
    let opts = VectorAddOptions{
      attrs = Option.Some(jsonAttrs(Player{ team = team[i], lvl = i + 1 })),
      quant = VecQuant.NoQuant,
    }
    let added = vs.add(names[i], Vec.Values([xs[i], ys[i]]), opts) catch e {
      panic("add ${names[i]}: ${e.message()}")
    }
    assert(added, "${names[i]} is new")
    i = i + 1
  }
}

test "live: vset add, card, dim, isMember, emb, remove and info" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let k = "bit:live:vset:a"
  vsetClean(c, [k])
  vsetSeed(c, k)
  let vs = c.vset(k)

  let again = vs.add("ana", Vec.Values([1.0, 0.0]), VectorAddOptions{ quant = VecQuant.NoQuant }) catch e {
    panic("add again: ${e.message()}")
  }
  assert(!again, "an existing element is replaced, not new")
  assert(
      (vs.card() catch e {
        panic("card: ${e.message()}")
      }) ==
      4,
    "card",
  )
  assert(
      (vs.dim() catch e {
        panic("dim: ${e.message()}")
      }) ==
      2,
    "dim",
  )
  assert(
    vs.isMember("bo") catch e {
      panic("isMember: ${e.message()}")
    },
    "bo is a member",
  )
  assert(
    !(vs.isMember("zed") catch e {
      panic("isMember zed: ${e.message()}")
    }),
    "zed is not",
  )

  let emb = vs.emb("cy") catch e {
    panic("emb: ${e.message()}")
  }
  match (emb) {
    Some(v) => assert(
      len(v) == 2 && v[0] > 0.59 && v[0] < 0.61 && v[1] > 0.79 && v[1] < 0.81,
      "NOQUANT keeps the floats",
    )
    None => panic("emb: cy has a vector")
  }
  let missing = vs.emb("zed") catch e {
    panic("emb zed: ${e.message()}")
  }
  assert(missing == Option.None, "a missing element has no vector")
  let raw = vs.embRaw("cy") catch e {
    panic("embRaw: ${e.message()}")
  }
  match (raw) {
    Some(r) => assert(
      r.quant == "f32" && len(r.blob) == 8 && r.norm > 0.99 && r.norm < 1.01,
      "raw: ${r.quant}",
    )
    None => panic("embRaw: cy has a vector")
  }

  let info = vs.info() catch e {
    panic("info: ${e.message()}")
  }
  match (info) {
    Some(i) => assert(
      i.size == 4 && i.vectorDim == 2 && i.quantType == "f32" && i.attributesCount == 4,
      "info: ${i.quantType} ${i.size}",
    )
    None => panic("info: the key exists")
  }
  let gone = vs.info() catch _ {
    panic("unreachable")
  }
  assert(gone != Option.None, "info again")

  let removed = vs.remove("di") catch e {
    panic("remove: ${e.message()}")
  }
  let removedAgain = vs.remove("di") catch e {
    panic("remove again: ${e.message()}")
  }
  assert(removed && !removedAgain, "remove: ${removed} ${removedAgain}")
  assert(
      (vs.card() catch e {
        panic("card 2: ${e.message()}")
      }) ==
      3,
    "card after remove",
  )
  vsetClean(c, [k])
}

test "live: vset similar by element, by vector, with scores, count, epsilon and truth" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let k = "bit:live:vset:sim"
  vsetClean(c, [k])
  vsetSeed(c, k)
  let vs = c.vset(k)

  let hits = vs.similar(SimilarTo.Element("ana")) catch e {
    panic("similar element: ${e.message()}")
  }
  assert(
    len(hits) == 4 && hits[0].element == "ana" && hits[0].score > 0.99,
    "ana is its own best match",
  )
  assert(
    hits[1].element == "bo" && hits[3].element == "di",
    "best first: ${hits[1].element} ${hits[3].element}",
  )
  assert(hits[1].score > hits[2].score && hits[2].score > hits[3].score, "scores fall")

  let two = vs.similar(SimilarTo.Values([1.0, 0.0]), SimilarOptions{ count = Option.Some(2) }) catch e {
    panic("similar values: ${e.message()}")
  }
  assert(len(two) == 2 && two[0].element == "ana" && two[1].element == "bo", "count caps the hits")

  let near = vs.similar(
    SimilarTo.Element("ana"),
    SimilarOptions{
      epsilon = Option.Some(0.1),
      truth = true,
      noThread = true,
      ef = Option.Some(50),
    },
  ) catch e {
    panic("similar epsilon: ${e.message()}")
  }
  assert(
    len(near) == 2 && near[1].element == "bo",
    "epsilon keeps only the close ones: ${len(near)}",
  )

  let refused = vs.similar(SimilarTo.Element("zed")) catch _ {
    []Similar(0)
  }
  assert(len(refused) == 0, "a missing element is the server's error")
  vsetClean(c, [k])
}

test "live: vset similar filters on attributes and returns them" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let k = "bit:live:vset:filter"
  vsetClean(c, [k])
  vsetSeed(c, k)
  let vs = c.vset(k)

  let red = vs.similar(
    SimilarTo.Element("cy"),
    SimilarOptions{ filter = Option.Some(vattr("team").is("red")), withAttrs = true },
  ) catch e {
    panic("similar filter: ${e.message()}")
  }
  assert(len(red) == 2, "two red players: ${len(red)}")
  for h of red {
    match (h.attrs) {
      Some(a) => assert(contains(a, "red"), "attrs of ${h.element}: ${a}")
      None => panic("withAttrs gave no attributes for ${h.element}")
    }
  }

  let f = vattr("team").is("blue").and(vattr("lvl").gt(3.0))
  let only = vs.similar(
    SimilarTo.Element("ana"),
    SimilarOptions{ filter = Option.Some(f), filterEf = Option.Some(100) },
  ) catch e {
    panic("similar and: ${e.message()}")
  }
  assert(len(only) == 1 && only[0].element == "di", "blue and level above 3 is di")

  let raw = vs.similar(
    SimilarTo.Element("ana"),
    SimilarOptions{ filter = Option.Some(rawVFilter(".lvl % 2 == 0")) },
  ) catch e {
    panic("similar raw: ${e.message()}")
  }
  assert(len(raw) == 2, "even levels: ${len(raw)}")
  vsetClean(c, [k])
}

test "live: vset attributes, links and random members" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let k = "bit:live:vset:attr"
  vsetClean(c, [k])
  vsetSeed(c, k)
  let vs = c.vset(k)

  let p = vs.attr<Player>("cy") catch e {
    panic("attr: ${e.message()}")
  }
  match (p) {
    Some(v) => assert(v.team == "blue" && v.lvl == 3, "attr fields")
    None => panic("cy has attributes")
  }
  let set = vs.setAttr("cy", Player{ team = "green", lvl = 9 }) catch e {
    panic("setAttr: ${e.message()}")
  }
  let setMissing = vs.setAttrJson("zed", "{}") catch e {
    panic("setAttrJson zed: ${e.message()}")
  }
  assert(set && !setMissing, "setAttr is true for a member, false for a missing element")
  let text = vs.attrJson("cy") catch e {
    panic("attrJson: ${e.message()}")
  }
  match (text) {
    Some(t) => assert(contains(t, "green"), "attrJson: ${t}")
    None => panic("attrJson none")
  }
  let cleared = vs.setAttrJson("cy", "") catch e {
    panic("clear: ${e.message()}")
  }
  let none = vs.attrJson("cy") catch e {
    panic("attrJson cleared: ${e.message()}")
  }
  assert(cleared && none == Option.None, "an empty text clears the attributes")

  let links = vs.links("ana") catch e {
    panic("links: ${e.message()}")
  }
  match (links) {
    Some(levels) => assert(len(levels) >= 1 && len(levels[0]) >= 1, "ana has neighbours")
    None => panic("links none")
  }
  let scored = vs.linksScored("ana") catch e {
    panic("linksScored: ${e.message()}")
  }
  match (scored) {
    Some(levels) => assert(len(levels[0]) >= 1 && levels[0][0].score > -1.01, "scores")
    None => panic("linksScored none")
  }

  let one = vs.randomMember() catch e {
    panic("randomMember: ${e.message()}")
  }
  assert(one != Option.None, "a random member exists")
  let many = vs.randomMembers(3) catch e {
    panic("randomMembers: ${e.message()}")
  }
  assert(len(many) == 3, "three distinct members")
  let dup = vs.randomMembers(-6) catch e {
    panic("randomMembers -6: ${e.message()}")
  }
  assert(len(dup) == 6, "a negative count may repeat: ${len(dup)}")
  vsetClean(c, [k])
}

test "live: vset quantization, reduce, m and the FP32 blob" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let q = "bit:live:vset:q8"
  let b = "bit:live:vset:bin"
  let r = "bit:live:vset:red"
  vsetClean(c, [q, b, r])

  c.vset(q).add(
    "a",
    Vec.Values([0.5, 0.5, 0.5, 0.5]),
    VectorAddOptions{ quant = VecQuant.Q8, m = Option.Some(8), ef = Option.Some(100), cas = true },
  ) catch e {
    panic("q8: ${e.message()}")
  }
  let raw = c.vset(q).embRaw("a") catch e {
    panic("q8 raw: ${e.message()}")
  }
  match (raw) {
    Some(v) => assert(
      v.quant == "int8" && v.range != Option.None,
      "Q8 stores bytes and a range: ${v.quant}",
    )
    None => panic("q8 raw none")
  }
  let qi = c.vset(q).info() catch e {
    panic("q8 info: ${e.message()}")
  }
  match (qi) {
    Some(i) => assert(i.hnswM == 8, "M reached the server: ${i.hnswM}")
    None => panic("q8 info none")
  }

  c.vset(b).add("a", Vec.Values([1.0, -1.0, 1.0, -1.0]), VectorAddOptions{ quant = VecQuant.Bin }) catch e {
    panic("bin: ${e.message()}")
  }
  let bi = c.vset(b).info() catch e {
    panic("bin info: ${e.message()}")
  }
  match (bi) {
    Some(i) => assert(i.quantType == "bin", "bin: ${i.quantType}")
    None => panic("bin info none")
  }

  c.vset(r).add("a", Vec.Values([1.0, 0.0, 0.0, 0.0]), VectorAddOptions{ reduce = Option.Some(2) }) catch e {
    panic("reduce: ${e.message()}")
  }
  assert(
      (c.vset(r).dim() catch e {
        panic("reduce dim: ${e.message()}")
      }) ==
      2,
    "REDUCE projects to two dimensions",
  )
  let ri = c.vset(r).info() catch e {
    panic("reduce info: ${e.message()}")
  }
  match (ri) {
    Some(i) => assert(
      i.projectionInputDim == 4,
      "the input dimension is kept: ${i.projectionInputDim}",
    )
    None => panic("reduce info none")
  }

  // Four little-endian float32s: 1.0, 0.0, 0.0, 0.0.
  let blob = "\x00\x00\x80\x3f\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
  let fresh = c.vset(q).add("blob", Vec.Fp32(blob), VectorAddOptions{ m = Option.Some(8) }) catch e {
    panic("fp32 add: ${e.message()}")
  }
  assert(fresh, "the blob is a new element")
  let hits = c.vset(q).similar(SimilarTo.Fp32(blob), SimilarOptions{ count = Option.Some(1) }) catch e {
    panic("fp32 similar: ${e.message()}")
  }
  assert(len(hits) == 1 && hits[0].element == "blob", "the blob finds itself")
  vsetClean(c, [q, b, r])
}

// `Vec.Values` travels as the FP32 blob, so the server must read exactly the
// floats given: (3, 4) has norm 5, which `VEMB ... RAW` reports, and the stored
// vector is the unit (0.6, 0.8), whose bytes decode with `f32sFromLe`. Any other
// reading of the blob (VALUES text, big-endian, f64) gives another norm.
test "live: vset reads a []f32 sent as FP32" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let k = "bit:live:vset:fp32"
  vsetClean(c, [k])
  let vs = c.vset(k)
  let noq = VectorAddOptions{ quant = VecQuant.NoQuant }
  vs.add("a", Vec.Values([3.0, 4.0]), noq) catch e {
    panic("add values: ${e.message()}")
  }
  vs.add("b", Vec.Fp32(string(f32sToLe([f32(3.0), f32(4.0)]))), noq) catch e {
    panic("add blob: ${e.message()}")
  }
  vs.add("c", Vec.Values([-4.0, 3.0]), noq) catch e {
    panic("add c: ${e.message()}")
  }
  let raw = vs.embRaw("a") catch e {
    panic("embRaw: ${e.message()}")
  }
  match (raw) {
    Some(r) => {
      assert(r.norm > 4.999 && r.norm < 5.001, "norm of (3, 4) is 5, got ${r.norm}")
      let got = f32sFromLe([]byte(r.blob)) catch e {
        panic("blob: ${e.message()}")
      }
      assert(len(got) == 2, "two components, got ${len(got)}")
      assert(got[0] > 0.599 && got[0] < 0.601 && got[1] > 0.799 && got[1] < 0.801, "unit vector")
    }
    None => panic("embRaw: a has a vector")
  }
  let hits = vs.similar(SimilarTo.Values([6.0, 8.0]), SimilarOptions{ count = Option.Some(3) }) catch e {
    panic("similar: ${e.message()}")
  }
  assert(len(hits) == 3, "three hits, got ${len(hits)}")
  assert(
    hits[2].element == "c" && hits[0].score > 0.999,
    "a and b are the query's direction, c is orthogonal",
  )
  vsetClean(c, [k])
}

test "live: vset in a pipeline and in tx.read" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let k = "bit:live:vset:batch"
  vsetClean(c, [k])
  let p = c.pipeline()
  let added = p.vset(k).add("a", Vec.Values([1.0, 0.0]))
  let added2 = p.vset(k).add("b", Vec.Values([0.0, 1.0]))
  let card = p.vset(k).card()
  p.exec() catch e {
    panic("exec: ${e.message()}")
  }
  let a1 = added.get() catch e {
    panic("added: ${e.message()}")
  }
  let a2 = added2.get() catch e {
    panic("added2: ${e.message()}")
  }
  let n = card.get() catch e {
    panic("card: ${e.message()}")
  }
  assert(a1 && a2 && n == 2, "pipelined adds: ${a1} ${a2} ${n}")

  let removed = c.transaction<Future<bool>>([k], (tx) => {
    let queued = tx.vset(k).remove("b")
    let r = tx.read.vset(k)
    let now = r.card()?
    assert(now == 2, "tx.read sees the set as it is now: ${now}")
    let refused = false
    let _ = r.remove("a") catch _ {
      refused = true
      false
    }
    assert(refused, "a write through tx.read is refused")
    return queued
  }) catch e {
    panic("transaction: ${e.message()}")
  }
  let was = removed.get() catch e {
    panic("tx future: ${e.message()}")
  }
  assert(was, "the queued remove took b out")
  assert(
      (c.vset(k).card() catch e {
        panic("card after: ${e.message()}")
      }) ==
      1,
    "one element left",
  )
  vsetClean(c, [k])
  c.close()
}
