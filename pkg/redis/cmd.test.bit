// pkg/redis/cmd.test.bit — `cmd.bit`'s decode helpers and `Future<T>`,
// tested directly against `Reply` values: none of this needs a socket, real
// or fake (`resp.bit`'s own split already proved the wire codec itself).

test "asInt decodes Reply.Int, fails RedisError.Unexpected otherwise" {
  let n = asInt(Reply.Int(42), "INCR") catch e {
    panic("asInt: ${e.message()}")
  }
  assert(n == 42, "asInt Int(42) = ${n}")

  let failed = false
  let _ = asInt(Reply.Simple("OK"), "INCR") catch _ {
    failed = true
    0
  }
  assert(failed, "asInt on a Simple reply should fail")
}

test "asOptString keeps the null-vs-empty distinction" {
  let some = asOptString(Reply.Bulk(Option.Some("v")), "GET") catch e {
    panic("asOptString: ${e.message()}")
  }
  assert(isSome(some), "Bulk(Some) should decode to Some")
  assert(unwrap(some) == "v", "asOptString Bulk(Some('v')) = '${unwrap(some)}'")

  let none = asOptString(Reply.Null, "GET") catch e {
    panic("asOptString: ${e.message()}")
  }
  assert(isNone(none), "Reply.Null should decode to None")
}

test "asOptString and replyToString read a RESP3 verbatim string as its text" {
  let some = asOptString(Reply.Verbatim("txt", "x"), "INFO") catch e {
    panic("asOptString: ${e.message()}")
  }
  assert(isSome(some), "asOptString Verbatim should be Some")
  assert(unwrap(some) == "x", "asOptString Verbatim('txt', 'x') = '${unwrap(some)}'")

  let text = replyToString(Reply.Verbatim("mkd", "# Report\r\n"), "MEMORY DOCTOR") catch e {
    panic("replyToString: ${e.message()}")
  }
  assert(text == "# Report\r\n", "replyToString Verbatim = '${text}'")
}

test "asBool accepts both Int and RESP3 Bool" {
  let fromInt = asBool(Reply.Int(1), "EXPIRE") catch e {
    panic("asBool: ${e.message()}")
  }
  assert(fromInt, "asBool Int(1) should be true")
  let fromBool = asBool(Reply.Bool(false), "EXPIRE") catch e {
    panic("asBool: ${e.message()}")
  }
  assert(!fromBool, "asBool Bool(false) should be false")
}

test "asDouble accepts both RESP3 Double and a RESP2 bulk decimal string" {
  let fromDouble = asDouble(Reply.Double(3.5), "ZSCORE") catch e {
    panic("asDouble: ${e.message()}")
  }
  assert(fromDouble == 3.5, "asDouble Double(3.5) = ${fromDouble}")
  let fromBulk = asDouble(Reply.Bulk(Option.Some("2.25")), "ZSCORE") catch e {
    panic("asDouble: ${e.message()}")
  }
  assert(fromBulk == 2.25, "asDouble Bulk('2.25') = ${fromBulk}")
}

test "asStrings decodes an Array of bulk strings" {
  let items = [Reply.Bulk(Option.Some("a")), Reply.Bulk(Option.Some("b"))]
  let got = asStrings(Reply.Array(Option.Some(items)), "LRANGE") catch e {
    panic("asStrings: ${e.message()}")
  }
  assert(len(got) == 2, "expected 2 strings, got ${len(got)}")
  assert(got[0] == "a" && got[1] == "b", "asStrings = ${got[0]}, ${got[1]}")
}

test "asMap decodes a flat RESP2 array as key/value pairs" {
  let items = [
    Reply.Bulk(Option.Some("name")), Reply.Bulk(Option.Some("Ada")),
    Reply.Bulk(Option.Some("lang")), Reply.Bulk(Option.Some("bit")),
  ]
  let got = asMap(Reply.Array(Option.Some(items)), "HGETALL") catch e {
    panic("asMap: ${e.message()}")
  }
  assert(got["name"] == "Ada", "asMap['name'] = '${got["name"]}'")
  assert(got["lang"] == "bit", "asMap['lang'] = '${got["lang"]}'")
}

test "asScored decodes a flat member/score array" {
  let items = [
    Reply.Bulk(Option.Some("alice")), Reply.Bulk(Option.Some("10")),
    Reply.Bulk(Option.Some("bob")), Reply.Bulk(Option.Some("20")),
  ]
  let got = asScored(Reply.Array(Option.Some(items)), "ZRANGE") catch e {
    panic("asScored: ${e.message()}")
  }
  assert(len(got) == 2, "expected 2 scored members, got ${len(got)}")
  assert(
    got[0].member == "alice" && got[0].score == 10.0,
    "asScored[0] = ${got[0].member}, ${got[0].score}",
  )
  assert(
    got[1].member == "bob" && got[1].score == 20.0,
    "asScored[1] = ${got[1].member}, ${got[1].score}",
  )
}

// `Future<T>.get()` reads `box.replies[index]` and decodes it — the same
// plumbing `pipeline.bit`'s `exec()` fills, exercised here with no network.
test "Future.get decodes the resolved reply at its index, once the box is ready" {
  let box = resultBox{ replies = [Reply.Int(7), Reply.Simple("OK")], ready = true }
  let f = Future<i64>{ box = box, index = 0, decode = (r) => asInt(r, "INCR") }
  let v = f.get() catch e {
    panic("Future.get: ${e.message()}")
  }
  assert(v == 7, "Future.get at index 0 = ${v}")
}

// A family's queued-view accessor (`Tx.counter`/`Pipeline.counter`, ...)
// must return a view over the SAME `Batch` its owner holds — never a fresh
// one — or a command queued through the family view would never reach
// `exec()`/the transaction attempt that actually sends `batch.queued`.
// `Pipeline`'s accessors build the identical `<Family>Batch{ batch =
// this.batch, key = key }` literal (pipeline.bit), so this one check
// (no live connection needed — `Batch` is a plain client-side queue)
// covers both.
test "a family accessor's queued view shares its owner's Batch" {
  let batch = Batch()
  let tx = Tx{ batch = batch, read = TxRead{ conn = redisConn{}, timeoutNs = 0 } }
  let counterView = tx.counter("n")
  counterView.batch.queue(pingCmd())
  assert(
    len(batch.queued) == 1,
    "queuing through tx.counter(...).batch should be visible on tx's own batch",
  )
}

test "Future.get fails RedisError.Closed before the box is filled" {
  let box = resultBox{ replies = []Reply(0), ready = false }
  let f = Future<i64>{ box = box, index = 0, decode = (r) => asInt(r, "INCR") }
  let failed = false
  let _ = f.get() catch e {
    match (e) {
      Closed => failed = true
      _ => panic("Future.get before ready: expected RedisError.Closed, got ${e.message()}")
    }
    0
  }
  assert(failed, "Future.get before the box is ready should fail")
}

test "asScanPage decodes the cursor and the flat item page" {
  let items = [
    Reply.Bulk(Option.Some("12")),
    Reply.Array(Option.Some([Reply.Bulk(Option.Some("a")), Reply.Bulk(Option.Some("1"))])),
  ]
  let (cursor, page) = asScanPage(Reply.Array(Option.Some(items)), "HSCAN") catch e {
    panic("asScanPage: ${e.message()}")
  }
  assert(cursor == "12", "cursor = '${cursor}'")
  assert(len(page) == 2 && page[0] == "a" && page[1] == "1", "page = ${len(page)} items")
}

test "asScanPage refuses a reply that is not a two-element array" {
  let failed = false
  let _ = asScanPage(Reply.Array(Option.Some([Reply.Bulk(Option.Some("0"))])), "SSCAN") catch _ {
    failed = true
    ("", []string(0))
  }
  assert(failed, "a one-element reply has no item page")
}
