// pkg/redis/array.live.test.bit - the array handle against a real server.
// `liveUrl`/`liveClient` are `client.live.test.bit`'s own (same module, no
// import); every test is skipped, and says so, when `REDIS_TEST_URL` is
// unset. `./make test-package-redis-live` (`_tests_/bit/redislive.bit`)
// supplies it, against `redis:8.10.2`, which carries the `AR*` commands.

fn arClean(c: Client, keys: []string) {
  c.del(keys) catch e {
    panic("del: ${e.message()}")
  }
}

fn some(o: Option<string>): string {
  match (o) {
    Some(s) => return s
    None => return "<empty>"
  }
}

test "live: array set, get, mget, getRange, count, length, del and delRange" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let k = "bit:live:ar:a"
  arClean(c, [k])
  let a = c.array(k)

  let set = a.set(u64(0), "x", "y", "z") catch e {
    panic("set: ${e.message()}")
  }
  let m = a.mset(ArEntry{ index = u64(10), value = "p" }, ArEntry{ index = u64(11), value = "q" }) catch e {
    panic("mset: ${e.message()}")
  }
  assert(set == 3 && m == 2, "set counts: ${set} ${m}")
  let one = a.get(u64(1)) catch e {
    panic("get: ${e.message()}")
  }
  let hole = a.get(u64(5)) catch e {
    panic("get hole: ${e.message()}")
  }
  assert(one == Option.Some("y") && hole == Option.None, "a hole is None")
  let many = a.mget(u64(0), u64(5), u64(2)) catch e {
    panic("mget: ${e.message()}")
  }
  assert(
    len(many) == 3 && some(many[0]) == "x" && many[1] == Option.None && some(many[2]) == "z",
    "mget",
  )
  let fwd = a.getRange(u64(0), u64(3)) catch e {
    panic("getRange: ${e.message()}")
  }
  let back = a.getRange(u64(3), u64(0)) catch e {
    panic("getRange back: ${e.message()}")
  }
  assert(len(fwd) == 4 && some(fwd[0]) == "x" && fwd[3] == Option.None, "forward")
  assert(
    len(back) == 4 && some(back[3]) == "x" && back[0] == Option.None,
    "start > end reads backwards",
  )
  assert(
      (a.count() catch e {
        panic("count: ${e.message()}")
      }) ==
      5,
    "five filled slots",
  )
  assert(
      (a.length() catch e {
        panic("length: ${e.message()}")
      }) ==
      u64(12),
    "length is the top index plus one",
  )

  let removed = a.del(u64(0), u64(1), u64(99)) catch e {
    panic("del: ${e.message()}")
  }
  let ranged = a.delRange(ArRange{ start = u64(2), end = u64(10) }) catch e {
    panic("delRange: ${e.message()}")
  }
  assert(removed == 2 && ranged == 2, "del counts the filled slots: ${removed} ${ranged}")
  assert(
      (a.count() catch e {
        panic("count 2: ${e.message()}")
      }) ==
      1,
    "q is left",
  )
  arClean(c, [k])
}

test "live: array indexes above 2^63 round-trip through set, get, scan, grep, length and info" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let k = "bit:live:ar:big"
  arClean(c, [k])
  let a = c.array(k)
  let mid = u64(9223372036854775808)
  let top = u64(18446744073709551614)

  a.set(mid, "a", "b") catch e {
    panic("set mid: ${e.message()}")
  }
  a.set(top, "z") catch e {
    panic("set top: ${e.message()}")
  }
  let got = a.get(mid + u64(1)) catch e {
    panic("get: ${e.message()}")
  }
  assert(got == Option.Some("b"), "get above 2^63")
  let hits = a.scan(mid - u64(8), top) catch e {
    panic("scan: ${e.message()}")
  }
  assert(
    len(hits) == 3 && hits[0].index == mid && hits[2].index == top && hits[2].value == "z",
    "scan: ${len(hits)}",
  )
  let idx = a.grep(u64(0), top, [ArPred.Glob("*")]) catch e {
    panic("grep: ${e.message()}")
  }
  assert(len(idx) == 3 && idx[2] == top, "grep indexes")
  let withValues = a.grepValues(u64(0), top, [ArPred.Exact("z")]) catch e {
    panic("grepValues: ${e.message()}")
  }
  assert(len(withValues) == 1 && withValues[0].index == top, "grepValues")
  assert(
      (a.length() catch e {
        panic("length: ${e.message()}")
      }) ==
      u64(18446744073709551615),
    "length is 2^64-1",
  )
  let info = a.info() catch e {
    panic("info: ${e.message()}")
  }
  assert(info.count == 3 && info.len == u64(18446744073709551615), "info.len above i64")
  arClean(c, [k])
}

test "live: array insert, next, seek, ring, lastItems and the cursor above 2^63" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let k = "bit:live:ar:cur"
  let r = "bit:live:ar:ring"
  arClean(c, [k, r])
  let a = c.array(k)

  let last = a.insert("u", "v", "w") catch e {
    panic("insert: ${e.message()}")
  }
  assert(last == u64(2), "insert answers the last index: ${last}")
  assert(
      (a.next() catch e {
        panic("next: ${e.message()}")
      }) ==
      u64(3),
    "next",
  )
  let sought = a.seek(u64(1)) catch e {
    panic("seek: ${e.message()}")
  }
  assert(sought, "seek")
  a.insert("t") catch e {
    panic("insert 2: ${e.message()}")
  }
  let recent = a.lastItems(2) catch e {
    panic("lastItems: ${e.message()}")
  }
  let newest = a.lastItems(2, true) catch e {
    panic("lastItems rev: ${e.message()}")
  }
  assert(len(recent) == 2 && some(recent[0]) == "u" && some(recent[1]) == "t", "oldest first")
  assert(some(newest[0]) == "t" && some(newest[1]) == "u", "rev: newest first")

  a.seek(u64(9223372036854775809)) catch e {
    panic("seek big: ${e.message()}")
  }
  let at = a.insert("big") catch e {
    panic("insert big: ${e.message()}")
  }
  assert(at == u64(9223372036854775809), "the cursor moved above 2^63: ${at}")
  assert(
      (a.next() catch e {
        panic("next big: ${e.message()}")
      }) ==
      u64(9223372036854775810),
    "next above 2^63",
  )

  let ring = c.array(r)
  let lastWritten = ring.ring(3, "a", "b", "c", "d", "e") catch e {
    panic("ring: ${e.message()}")
  }
  let window = ring.getRange(u64(0), u64(2)) catch e {
    panic("ring range: ${e.message()}")
  }
  assert(lastWritten == u64(1), "last write landed at ${lastWritten}")
  assert(
    some(window[0]) == "d" && some(window[1]) == "e" && some(window[2]) == "c",
    "the ring overwrote the oldest",
  )
  arClean(c, [k, r])
}

test "live: array grep, aggregate and info" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let k = "bit:live:ar:ops"
  let w = "bit:live:ar:words"
  arClean(c, [k, w])
  let n = c.array(k)
  n.set(u64(0), "1", "2", "3", "4") catch e {
    panic("set: ${e.message()}")
  }
  let sum = n.aggregate(u64(0), u64(3), ArOp.Sum) catch e {
    panic("sum: ${e.message()}")
  }
  let min = n.aggregate(u64(0), u64(3), ArOp.Min) catch e {
    panic("min: ${e.message()}")
  }
  let max = n.aggregate(u64(0), u64(3), ArOp.Max) catch e {
    panic("max: ${e.message()}")
  }
  let and = n.aggregate(u64(0), u64(3), ArOp.And) catch e {
    panic("and: ${e.message()}")
  }
  let orr = n.aggregate(u64(0), u64(3), ArOp.Or) catch e {
    panic("or: ${e.message()}")
  }
  let xor = n.aggregate(u64(0), u64(3), ArOp.Xor) catch e {
    panic("xor: ${e.message()}")
  }
  let hit = n.aggregate(u64(0), u64(3), ArOp.Match("3")) catch e {
    panic("match: ${e.message()}")
  }
  let used = n.aggregate(u64(0), u64(9), ArOp.Used) catch e {
    panic("used: ${e.message()}")
  }
  assert(aggInt(sum) == 10 && aggInt(min) == 1 && aggInt(max) == 4, "sum, min, max")
  assert(aggInt(and) == 0 && aggInt(orr) == 7 && aggInt(xor) == 4, "and, or, xor")
  assert(aggInt(hit) == 1 && aggInt(used) == 4, "match, used")

  let words = c.array(w)
  words.set(u64(0), "apple", "Banana", "cherry", "apricot") catch e {
    panic("set words: ${e.message()}")
  }
  let exact = words.grep(u64(0), u64(3), [ArPred.Exact("cherry")]) catch e {
    panic("exact: ${e.message()}")
  }
  assert(len(exact) == 1 && exact[0] == u64(2), "exact")
  let glob = words.grepValues(u64(0), u64(3), [ArPred.Glob("ap*")]) catch e {
    panic("glob: ${e.message()}")
  }
  assert(len(glob) == 2 && glob[1].value == "apricot", "glob with values")
  let either = words.grep(
    u64(0),
    u64(3),
    [ArPred.Re("^a"), ArPred.Exact("cherry")],
    ArGrepOptions{ combine = ArCombine.Or, limit = Option.Some(2) },
  ) catch e {
    panic("or limit: ${e.message()}")
  }
  assert(len(either) == 2, "limit caps the hits: ${len(either)}")
  let caseless = words.grep(
    u64(0),
    u64(3),
    [ArPred.Exact("BANANA")],
    ArGrepOptions{ noCase = true },
  ) catch e {
    panic("nocase: ${e.message()}")
  }
  assert(len(caseless) == 1 && caseless[0] == u64(1), "nocase")
  let sub = words.grep(u64(0), u64(3), [ArPred.Match("err")]) catch e {
    panic("match substring: ${e.message()}")
  }
  assert(len(sub) == 1, "substring")

  let info = words.info(true) catch e {
    panic("info: ${e.message()}")
  }
  assert(info.count == 4 && info.len == u64(4) && info.sliceSize > 0, "info")
  match (info.full) {
    Some(f) => assert(f.denseSlices + f.sparseSlices == info.slices, "slice split")
    None => panic("FULL gives the extras")
  }
  let missing = c.array("bit:live:ar:none").info() catch e {
    match (e) {
      Server(_, _) => return
      _ => panic("info missing: ${e.message()}")
    }
  }
  panic("ARINFO on a missing key is the server's error, got ${missing.count}")
}

fn aggInt(a: ArAgg): i64 {
  match (a) {
    Int(n) => return n
    _ => panic("expected an integer")
  }
}

test "live: array in a pipeline and in tx.read" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let k = "bit:live:ar:batch"
  arClean(c, [k])
  let p = c.pipeline()
  let set = p.array(k).set(u64(0), "a", "b")
  let cnt = p.array(k).count()
  p.exec() catch e {
    panic("exec: ${e.message()}")
  }
  let s = set.get() catch e {
    panic("set future: ${e.message()}")
  }
  let n = cnt.get() catch e {
    panic("count future: ${e.message()}")
  }
  assert(s == 2 && n == 2, "pipelined: ${s} ${n}")

  let queued = c.transaction<Future<i64>>([k], (tx) => {
    let q = tx.array(k).del(u64(0))
    let r = tx.read.array(k)
    let now = r.count()?
    assert(now == 2, "tx.read sees the array as it is now: ${now}")
    let refused = false
    let _ = r.set(u64(5), "x") catch _ {
      refused = true
      0
    }
    assert(refused, "a write through tx.read is refused")
    return q
  }) catch e {
    panic("transaction: ${e.message()}")
  }
  let gone = queued.get() catch e {
    panic("tx future: ${e.message()}")
  }
  assert(gone == 1, "the queued del emptied a slot")
  arClean(c, [k])
  c.close()
}
