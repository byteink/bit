// pkg/redis/resp.test.bit — codec tests (#3466), driven directly against
// captured RESP byte strings. No socket, no fake server: `fakeSource` hands
// back one full captured reply on its first read and reports EOF (an empty
// read) forever after — exercising the exact decoder `client.bit` runs over
// a live `std/net.Conn`, with nothing live involved.

class fakeSource {
  data: string
  done: bool
  readUp(n: int): string! {
    if (this.done) {
      return ""
    }
    this.done = true
    return this.data
  }
}

// Decodes exactly one reply from a fully captured `wire` string and asserts
// nothing was left over — every fixture below is exactly one reply, so any
// trailing byte means the decoder read the wrong amount.
fn decodeOne(wire: string): Reply {
  let (reply, rest) = decodeReply(fakeSource{ data = wire, done = false }, "") catch e {
    panic("decodeOne(${wire}): ${e.message()}")
  }
  assert(len(rest) == 0, "decodeOne(${wire}): unconsumed trailing bytes: '${rest}'")
  return reply
}

// Whether decoding `wire` fails — for truncated input, which must fail
// loudly rather than loop: `fakeSource` hands `wire` back once, then reports
// EOF forever, so a decoder that keeps asking for more on a short input
// fails on the second read instead of spinning.
fn decodeFails(wire: string): bool {
  decodeReply(fakeSource{ data = wire, done = false }, "") catch _ {
    return true
  }
  return false
}

// The failure message decoding `wire` produces, or "" if it succeeds — used
// to prove a bound check specifically fired (its message names the bound),
// not just that decoding failed for some other reason such as EOF.
fn decodeErrorMessage(wire: string): string {
  decodeReply(fakeSource{ data = wire, done = false }, "") catch e {
    return e.message()
  }
  return ""
}

// `depth` nested single-element arrays wrapping a trailing `+OK\r\n` simple
// string reply — `nestedArrayWire(2)` is `"*1\r\n*1\r\n+OK\r\n"`.
fn nestedArrayWire(depth: int): string {
  let wire = ""
  let i = 0
  while (i < depth) {
    wire = wire + "*1\r\n"
    i = i + 1
  }
  return wire + "+OK\r\n"
}

test "encodes a SET command as a RESP array" {
  let wire = encodeCommand(["SET", "k", "v"])
  let want = "*3\r\n\$3\r\nSET\r\n\$1\r\nk\r\n\$1\r\nv\r\n"
  assert(wire == want, "wire mismatch: got '${wire}', want '${want}'")
}

test "decodes a simple string reply" {
  let r = decodeOne("+OK\r\n")
  match (r) {
    Simple(s) => assert(s == "OK", "got '${s}'")
    _ => panic("expected Simple, got a different reply type")
  }
}

test "decodes an error reply" {
  let r = decodeOne("-ERR wrong number of arguments\r\n")
  match (r) {
    Err(s) => assert(s == "ERR wrong number of arguments", "got '${s}'")
    _ => panic("expected Err, got a different reply type")
  }
}

test "decodes an integer reply" {
  let r = decodeOne(":1000\r\n")
  match (r) {
    Int(n) => assert(n == 1000, "got ${n}")
    _ => panic("expected Int, got a different reply type")
  }
}

test "decodes a bulk string reply" {
  let r = decodeOne("\$6\r\nfoobar\r\n")
  match (r) {
    Bulk(v) => {
      let got = unwrapOr(v, "?")
      assert(got == "foobar", "got '${got}'")
    }
    _ => panic("expected Bulk, got a different reply type")
  }
}

// THE BUG THIS TEST EXISTS TO CATCH (#3466's mutation target): a null bulk
// string and an empty bulk string must decode to DIFFERENT values.
test "a null bulk string decodes differently from an empty one" {
  let nullBulk = decodeOne("\$-1\r\n")
  let emptyBulk = decodeOne("\$0\r\n\r\n")
  match (nullBulk) {
    Bulk(v) => assert(isNone(v), "null bulk: expected None, got Some")
    _ => panic("expected Bulk, got a different reply type")
  }
  match (emptyBulk) {
    Bulk(v) => {
      assert(isSome(v), "empty bulk: expected Some, got None")
      let got = unwrap(v)
      assert(got == "", "empty bulk: expected '', got '${got}'")
    }
    _ => panic("expected Bulk, got a different reply type")
  }
}

test "a null array decodes differently from an empty one" {
  let nullArr = decodeOne("*-1\r\n")
  let emptyArr = decodeOne("*0\r\n")
  match (nullArr) {
    Array(v) => assert(isNone(v), "null array: expected None, got Some")
    _ => panic("expected Array, got a different reply type")
  }
  match (emptyArr) {
    Array(v) => {
      assert(isSome(v), "empty array: expected Some, got None")
      assert(len(unwrap(v)) == 0, "empty array: expected 0 elements")
    }
    _ => panic("expected Array, got a different reply type")
  }
}

test "decodes an array of bulk strings" {
  let r = decodeOne("*2\r\n\$3\r\nfoo\r\n\$3\r\nbar\r\n")
  match (r) {
    Array(v) => {
      let items = unwrap(v)
      assert(len(items) == 2, "expected 2 elements, got ${len(items)}")
      match (items[0]) {
        Bulk(a) => {
          let got = unwrapOr(a, "?")
          assert(got == "foo", "elem0: got '${got}'")
        }
        _ => panic("elem0: expected Bulk, got a different reply type")
      }
      match (items[1]) {
        Bulk(b) => {
          let got = unwrapOr(b, "?")
          assert(got == "bar", "elem1: got '${got}'")
        }
        _ => panic("elem1: expected Bulk, got a different reply type")
      }
    }
    _ => panic("expected Array, got a different reply type")
  }
}

// ---- RESP3 (#6018) ----

test "decodes a null reply" {
  let r = decodeOne("_\r\n")
  match (r) {
    Null => {}
    _ => panic("expected Null, got a different reply type")
  }
}

test "decodes a boolean reply" {
  let t = decodeOne("#t\r\n")
  let f = decodeOne("#f\r\n")
  match (t) {
    Bool(v) => assert(v, "expected true")
    _ => panic("expected Bool, got a different reply type")
  }
  match (f) {
    Bool(v) => assert(!v, "expected false")
    _ => panic("expected Bool, got a different reply type")
  }
}

test "decodes a double reply" {
  let r = decodeOne(",3.14\r\n")
  match (r) {
    Double(v) => assert(v == 3.14, "got ${v}")
    _ => panic("expected Double, got a different reply type")
  }
}

test "decodes double infinities and nan" {
  let posInf = decodeOne(",inf\r\n")
  let negInf = decodeOne(",-inf\r\n")
  let nan = decodeOne(",nan\r\n")
  match (posInf) {
    Double(v) => assert(v == 1.0 / 0.0, "+inf: got ${v}")
    _ => panic("expected Double, got a different reply type")
  }
  match (negInf) {
    Double(v) => assert(v == 0.0 - 1.0 / 0.0, "-inf: got ${v}")
    _ => panic("expected Double, got a different reply type")
  }
  match (nan) {
    Double(v) => assert(v != v, "nan: expected v != v, got ${v}")
    _ => panic("expected Double, got a different reply type")
  }
}

test "decodes a big number, kept as a decimal string" {
  let r = decodeOne("(3492890328409238509324850943850943825024385\r\n")
  match (r) {
    BigNumber(s) => assert(s == "3492890328409238509324850943850943825024385", "got '${s}'")
    _ => panic("expected BigNumber, got a different reply type")
  }
}

test "decodes a blob error the same way a simple error decodes" {
  let r = decodeOne("!21\r\nSYNTAX invalid syntax\r\n")
  match (r) {
    Err(s) => assert(s == "SYNTAX invalid syntax", "got '${s}'")
    _ => panic("expected Err, got a different reply type")
  }
}

test "decodes a verbatim string, keeping its 3-byte type prefix" {
  let r = decodeOne("=15\r\ntxt:Some string\r\n")
  match (r) {
    Verbatim(kind, text) => {
      assert(kind == "txt", "kind: got '${kind}'")
      assert(text == "Some string", "text: got '${text}'")
    }
    _ => panic("expected Verbatim, got a different reply type")
  }
}

test "decodes a map with ordered entries" {
  let r = decodeOne("%2\r\n+key1\r\n:1\r\n+key2\r\n:2\r\n")
  match (r) {
    Map(entries) => {
      assert(len(entries) == 2, "expected 2 map entries, got ${len(entries)}")
      match (entries[0].key) {
        Simple(k) => assert(k == "key1", "entry0 key: got '${k}'")
        _ => panic("entry0 key: expected Simple, got a different reply type")
      }
      match (entries[0].value) {
        Int(n) => assert(n == 1, "entry0 value: got ${n}")
        _ => panic("entry0 value: expected Int, got a different reply type")
      }
      match (entries[1].key) {
        Simple(k) => assert(k == "key2", "entry1 key: got '${k}'")
        _ => panic("entry1 key: expected Simple, got a different reply type")
      }
      match (entries[1].value) {
        Int(n) => assert(n == 2, "entry1 value: got ${n}")
        _ => panic("entry1 value: expected Int, got a different reply type")
      }
    }
    _ => panic("expected Map, got a different reply type")
  }
}

test "decodes a set" {
  let r = decodeOne("~2\r\n+a\r\n+b\r\n")
  match (r) {
    Set(items) => {
      assert(len(items) == 2, "expected 2 set members, got ${len(items)}")
      match (items[0]) {
        Simple(s) => assert(s == "a", "member0: got '${s}'")
        _ => panic("member0: expected Simple, got a different reply type")
      }
      match (items[1]) {
        Simple(s) => assert(s == "b", "member1: got '${s}'")
        _ => panic("member1: expected Simple, got a different reply type")
      }
    }
    _ => panic("expected Set, got a different reply type")
  }
}

test "decodes a push" {
  let r = decodeOne(">2\r\n+pub\r\n+ch\r\n")
  match (r) {
    Push(items) => {
      assert(len(items) == 2, "expected 2 push elements, got ${len(items)}")
      match (items[0]) {
        Simple(s) => assert(s == "pub", "elem0: got '${s}'")
        _ => panic("elem0: expected Simple, got a different reply type")
      }
      match (items[1]) {
        Simple(s) => assert(s == "ch", "elem1: got '${s}'")
        _ => panic("elem1: expected Simple, got a different reply type")
      }
    }
    _ => panic("expected Push, got a different reply type")
  }
}

// THE BEHAVIOR THIS TEST EXISTS TO CATCH: an attribute must be decoded and
// attached to the reply it describes, never dropped and never mistaken for
// that reply — the decoded value is `Reply.Attribute`, a distinct variant
// from the `Simple` reply it wraps, so a caller cannot confuse the two.
test "decodes an attribute ahead of a reply, without dropping or conflating it" {
  let r = decodeOne("|1\r\n+key\r\n+val\r\n+OK\r\n")
  match (r) {
    Attribute(entries, inner) => {
      assert(len(entries) == 1, "expected 1 attribute entry, got ${len(entries)}")
      match (entries[0].key) {
        Simple(k) => assert(k == "key", "attribute key: got '${k}'")
        _ => panic("attribute key: expected Simple, got a different reply type")
      }
      match (entries[0].value) {
        Simple(v) => assert(v == "val", "attribute value: got '${v}'")
        _ => panic("attribute value: expected Simple, got a different reply type")
      }
      match (inner) {
        Simple(s) => assert(s == "OK", "attribute inner reply: got '${s}'")
        _ => panic("attribute inner reply: expected Simple, got a different reply type")
      }
    }
    _ => panic("expected Attribute, got a different reply type")
  }
}

test "truncated RESP3 input fails, never loops" {
  assert(decodeFails("_"), "truncated null header")
  assert(decodeFails("#t"), "truncated boolean header")
  assert(decodeFails(",3.1"), "truncated double header")
  assert(decodeFails("(123"), "truncated big number header")
  assert(decodeFails("=15\r\ntxt:Some"), "truncated verbatim string body")
  assert(decodeFails("!21\r\nSYNTAX invalid"), "truncated blob error body")
  assert(decodeFails("%2\r\n+a\r\n"), "truncated map, missing a value and a pair")
  assert(decodeFails("~2\r\n+a\r\n"), "truncated set, missing a member")
  assert(decodeFails(">2\r\n+a\r\n"), "truncated push, missing an element")
  assert(
    decodeFails("|1\r\n+key\r\n+val\r\n"),
    "truncated attribute, missing the reply it describes",
  )
}

test "an oversized length is rejected before reading, for every $-framed and aggregate type" {
  let bulk = decodeErrorMessage("\$99999999999\r\n")
  assert(indexOf(bulk, "exceeds max") >= 0, "bulk: expected an exceeds-max error, got '${bulk}'")

  let verbatim = decodeErrorMessage("=99999999999\r\n")
  assert(
    indexOf(verbatim, "exceeds max") >= 0,
    "verbatim: expected an exceeds-max error, got '${verbatim}'",
  )

  let blobErr = decodeErrorMessage("!99999999999\r\n")
  assert(
    indexOf(blobErr, "exceeds max") >= 0,
    "blob error: expected an exceeds-max error, got '${blobErr}'",
  )

  let mapMsg = decodeErrorMessage("%99999999999\r\n")
  assert(indexOf(mapMsg, "exceeds max") >= 0, "map: expected an exceeds-max error, got '${mapMsg}'")

  let setMsg = decodeErrorMessage("~99999999999\r\n")
  assert(indexOf(setMsg, "exceeds max") >= 0, "set: expected an exceeds-max error, got '${setMsg}'")

  let pushMsg = decodeErrorMessage(">99999999999\r\n")
  assert(
    indexOf(pushMsg, "exceeds max") >= 0,
    "push: expected an exceeds-max error, got '${pushMsg}'",
  )
}

test "nesting within the depth cap decodes successfully" {
  let wire = nestedArrayWire(10)
  assert(!decodeFails(wire), "expected depth-10 nesting to decode successfully")
}

test "nesting beyond the depth cap fails, not loops forever" {
  let wire = nestedArrayWire(100)
  let msg = decodeErrorMessage(wire)
  assert(indexOf(msg, "depth") >= 0, "expected a depth-cap error, got '${msg}'")
}
