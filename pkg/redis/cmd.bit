// pkg/redis/cmd.bit — `Cmd<T>`: one command, defined once, shared by
// `Client` (runs it now), `Pipeline` and `Tx` (both queue it into a shared
// `Batch`, handing back a `Future<T>`). Epic #6013, #6028.
//
// HOW A FAMILY ADDS A COMMAND (read this before writing a family file):
// write ONE factory function that builds a `Cmd<T>`, e.g.
//
//   fn incrCmd(key: string): Cmd<i64> {
//     return Cmd<i64>{ args = ["INCR", key], decode = (r) => asInt(r, "INCR"), readOnly = false }
//   }
//
// `args` is the wire command; `decode` turns the raw `Reply` into the typed
// result or fails `RedisError.Unexpected` — reuse one of this file's decode
// helpers (`asInt`, `asOptString`, `asBool`, `asDouble`, `asStrings`,
// `asMap`, `asScored`, `asScanPage`) when the reply shape fits, or write a
// short inline closure when it does not (`client.bit`'s `pingCmd` is the example: PING's
// reply is `Simple` OR `Bulk`, a shape none of the shared helpers matches).
// `readOnly` picks the retry policy `Client.runCmd` uses — true only for a
// command that is safe to run twice (a read; never `SET`, `INCR`, ...).
//
// Then give the family TWO methods, immediate and queued, each ONE line:
//
//   // On the family's immediate handle (e.g. `Counter` in counter.bit) —
//   // a `runner: Runner` field, never a `client: Client` one (#6029):
//   export incr(): i64!RedisError { return this.runner.runCmd(incrCmd(this.key)) }
//   // On the family's QUEUED view (e.g. `CounterBatch`, same file) — the
//   // ONE view `Pipeline.counter(key)` AND `Tx.counter(key)` both return,
//   // since both just hold a `Batch` (this file's `Batch` class):
//   export incr(): Future<i64> { return this.batch.queue(incrCmd(this.key)) }
//
// The command definition — `args` and `decode` — is written exactly once;
// only these two one-line calls differ, `runner.runCmd` vs `batch.queue`.
//
// WHY THE IMMEDIATE HANDLE HOLDS A `Runner`, NOT A `Client`, DIRECTLY
// (#6029): `Client.counter(key)` and a transaction body's `tx.read.counter
// (key)` must both hand back the exact same `Counter`, so a family's
// commands are written once and run either way. `Runner` (below) is that
// shared "run one command now" shape — pool-backed (`poolRunner`, every
// `Client` accessor) or pinned to one connection already leased for a
// transaction attempt (`pinnedRunner`, `tx.bit`'s `Tx.read`). A family's
// immediate handle never knows which; it only calls `this.runner.runCmd`.
//
// WHY PIPELINE AND TX SHARE ONE `Batch`, NOT TWO QUEUED VIEWS PER FAMILY:
// `Pipeline.exec()` sends every queued command back-to-back then reads all
// the replies (`pipeline.bit`); `Tx` sends WATCH/MULTI/each queued command/
// EXEC instead (`tx.bit`) — the two differ ONLY in how the queued `Batch`
// eventually reaches the wire, never in the client-side queuing itself
// (`Batch.queue<T>`, append `args`, hand back a `Future<T>` over the SAME
// shared `resultBox`). So a family's queued view holds a `Batch` field, not
// a `Pipeline` or `Tx` one, and `Pipeline`/`Tx` both expose the identical
// family accessor (`counter(key): CounterBatch`) over their own `batch`
// field — one queued view per family, not two.
//
// WHY NOT ONE HANDLE CLASS GENERIC OVER "THE EXECUTOR": prototyped first
// (recorded on #6013) and rejected — `Client.runCmd` must return `T`
// directly (the spine's `r.counter("n").incr()?` is `i64` NOW), while a
// queued call must return `Future<T>` instead. Bit has no higher-kinded
// types (#6014's probes, confirmed again here), so a single generic method
// cannot flip its OWN return type between `T` and `Future<T>` depending on
// which executor it closed over — the two shapes need two methods.

// One command: the wire form and how to decode its reply. `T` is the
// decoded result's type — never itself fallible; a decode failure is
// reported through `RedisError`, same as every other command failure.
export class Cmd<T> {
  export args: []string,
  export decode: (Reply) => T!RedisError,
  export readOnly: bool,
}

// A batch's shared result slot: empty until `Pipeline.exec`/the owning
// transaction attempt fills it, read by every `Future<T>` handed out before
// that happened. A plain class (a reference type, SPEC §13.3) rather than a
// mutable local a closure would capture — `Future<T>` instances created at
// different `queue` calls all need to observe the SAME fill, after the fact.
class resultBox {
  replies: []Reply,
  ready: bool,
}

// The result of one command queued into a `Batch` — see `pipeline.bit`/
// `tx.bit`. Worthless before the batch's owner fills its box (`get()` fails
// `RedisError.Closed`, the same variant a caller-error would if there were
// nothing better named for it); reads `box.replies[index]` and decodes it
// afterward, exactly once per call, never cached, since the replies slice
// itself is filled once and then immutable.
export class Future<T> {
  box: resultBox
  index: int
  decode: (Reply) => T!RedisError
  export get(): T!RedisError {
    if (!this.box.ready) {
      fail RedisError.Closed
    }
    return this.decode(this.box.replies[this.index])?
  }
}

// The client-side queue `Pipeline` and `Tx` share (this file's header):
// append `args`, hand back a `Future<T>` over one `resultBox` — nothing
// here ever touches the network. `Pipeline.exec()`/`tx.bit`'s per-attempt
// driver are what actually run `queued` and fill `box`; a fresh `Batch`
// (`Batch()`) per transaction ATTEMPT is what makes a retry's futures
// never alias a discarded attempt's (`tx.bit`'s header).
export class Batch {
  box: resultBox
  queued: [][]string

  // An empty batch, ready to `queue` into.
  init() {
    this.box = resultBox{ replies = []Reply(0), ready = false }
    this.queued = [][]string(0)
  }

  export queue<T>(cmd: Cmd<T>): Future<T> {
    let idx = len(this.queued)
    this.queued = append(this.queued, cmd.args)
    return Future<T>{ box = this.box, index = idx, decode = cmd.decode }
  }

  // The six commands every `Client` exposes directly (`client.bit`), moved
  // onto the ONE queued shape `Pipeline`/`Tx` both forward to (this file's
  // header, point 4) — so a pipelined or transacted `GET`/`SET`/... is one
  // pattern, not two.
  export get(key: string): Future<Option<string>> { return this.queue(getCmd(key)) }
  export set(key: string, value: string): Future<()> { return this.queue(setCmd(key, value)) }
  export del(keys: []string): Future<i64> { return this.queue(delCmd(keys)) }
  export exists(keys: []string): Future<i64> { return this.queue(existsCmd(keys)) }
  export expire(key: string, seconds: i64): Future<bool> {
    return this.queue(expireCmd(key, seconds))
  }
  export ping(): Future<string> { return this.queue(pingCmd()) }
}

// The immediate half of the one-command-definition-per-family contract —
// `Batch` above is the queued half. Runs `cmd` now, over either a
// pool-backed `Client` or one connection already leased for a transaction
// attempt (`tx.bit`'s `Tx.read`, #6029) — never both, exactly one of
// `client`/`conn` is set, per the two factory functions below.
//
// A CONCRETE CLASS, NOT AN INTERFACE: SPEC §10.6's `method_sig = IDENT
// signature` has no `[ generic_params ]` (unlike `method_decl`), so an
// interface method cannot itself be generic — `interface Runner { runCmd<T>
// (...): T!RedisError }` does not parse. The same "no higher-kinded types"
// limit this file's header already names rules an interface out here too.
export class Runner {
  client: Option<Client>
  conn: Option<redisConn>
  timeoutNs: int

  export runCmd<T>(cmd: Cmd<T>): T!RedisError {
    match (this.client) {
      Some(c) => return c.runCmd(cmd)?
      None => return runPinnedCmd<T>(this, cmd)?
    }
  }
}

// A pool-backed runner — every `Client` family accessor (`Client.counter`,
// ...) builds its handle over one of these.
export fn poolRunner(client: Client): Runner {
  return Runner{ client = Option.Some(client), conn = Option.None, timeoutNs = 0 }
}

// A runner pinned to `conn`, already leased for one transaction attempt —
// `tx.bit`'s `Tx.read`. Never retried, unlike `Client.runCmd`: this
// connection is checked out for the whole WATCH..EXEC window already, and a
// command run twice mid-transaction could double a caller's side effect the
// same way a retried write on `Client` could (`client.bit`'s header on why
// writes never retry there).
export fn pinnedRunner(conn: redisConn, timeoutNs: int): Runner {
  return Runner{ client = Option.None, conn = Option.Some(conn), timeoutNs = timeoutNs }
}

fn runPinnedCmd<T>(runner: Runner, cmd: Cmd<T>): T!RedisError {
  match (runner.conn) {
    Some(conn) => {
      writeCommand(conn, cmd.args, runner.timeoutNs)?
      let r = readOneReply(conn, runner.timeoutNs)?
      return cmd.decode(r)?
    }
    None => panic("redis: Runner has neither a pool-backed client nor a pinned connection")
  }
}

// One member/score pair — `ZRANGE ... WITHSCORES` and friends, decoded by
// `asScored` below. Field order matches the spine's `[]Scored{member,
// score}` (epic #6013's API SPINE block).
export class Scored { export member: string, export score: f64 }

// A `Reply.Bulk`/`Reply.Simple` as a plain string — every decode helper
// below that reads a string out of an aggregate goes through this, so
// "what counts as a string reply" is answered in exactly one place. A null
// bulk element (RESP2's sparse-array convention) becomes `""` rather than
// failing — Redis returns those inside an array `RedisError.Unexpected`
// would otherwise refuse to decode at all.
fn replyToString(r: Reply, cmd: string): string!RedisError {
  match (r) {
    Bulk(v) => return unwrapOr(v, "")
    Simple(s) => return s
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

// `Reply.Int` as `i64` — `INCR`, `DEL`, `EXISTS`, and most other integer-
// reply commands.
export fn asInt(r: Reply, cmd: string): i64!RedisError {
  match (r) {
    Int(n) => return n
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

// `Reply.Bulk`/`Reply.Null` as `Option<string>` — the null-vs-empty
// distinction `resp.bit`'s header exists to preserve, carried through to
// every command whose reply is "a string, or nothing" (`GET` and its kin).
export fn asOptString(r: Reply, cmd: string): Option<string>!RedisError {
  match (r) {
    Bulk(v) => return v
    Null => return Option.None
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

// `Reply.Int` (RESP2's `0`/`1` convention) or `Reply.Bool` (RESP3) as a
// `bool` — `EXPIRE`, `SISMEMBER`, and other predicate commands.
export fn asBool(r: Reply, cmd: string): bool!RedisError {
  match (r) {
    Int(n) => return n != 0
    Bool(b) => return b
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

// `Reply.Double` (RESP3) or a `Reply.Bulk` decimal string (RESP2's
// convention for `ZSCORE` and friends) as `f64`.
export fn asDouble(r: Reply, cmd: string): f64!RedisError {
  match (r) {
    Double(v) => return v
    Bulk(v) => return doubleFromBulk(v, cmd)?
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

fn doubleFromBulk(v: Option<string>, cmd: string): f64!RedisError {
  let s = unwrapOr(v, "")
  let f = parseFloat(s)
  if (f != f) {
    fail RedisError.Unexpected(cmd, "Bulk")
  }
  return f
}

// `Reply.Array` of bulk/simple strings as `[]string` — `LRANGE`, `SMEMBERS`,
// and other list-of-strings replies. A null array decodes to the empty
// slice, same convention `resp.bit`'s own null-vs-empty note describes.
export fn asStrings(r: Reply, cmd: string): []string!RedisError {
  match (r) {
    Array(items) => return stringsFromOpt(items, cmd)?
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

fn stringsFromOpt(items: Option<[]Reply>, cmd: string): []string!RedisError {
  match (items) {
    Some(list) => return stringsFromReplies(list, cmd)?
    None => return []string(0)
  }
}

fn stringsFromReplies(list: []Reply, cmd: string): []string!RedisError {
  let out = []string(0)
  let i = 0
  while (i < len(list)) {
    let s = replyToString(list[i], cmd)?
    out = append(out, s)
    i = i + 1
  }
  return out
}

// One `SCAN`-family page: `[cursor, [items...]]`, the reply `SCAN`, `HSCAN`
// and `SSCAN` all share (only the command name in an error differs). The
// items stay flat - `HSCAN` interleaves field, value, the rest are one
// element each; the caller knows which.
export fn asScanPage(r: Reply, cmd: string): (string, []string)!RedisError {
  match (r) {
    Array(items) => return scanPageFromOpt(items, cmd)?
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

fn scanPageFromOpt(items: Option<[]Reply>, cmd: string): (string, []string)!RedisError {
  match (items) {
    Some(list) => return scanPageFromList(list, cmd)?
    None => fail RedisError.Unexpected(cmd, "Array")
  }
}

fn scanPageFromList(list: []Reply, cmd: string): (string, []string)!RedisError {
  if (len(list) != 2) {
    fail RedisError.Unexpected(cmd, "Array")
  }
  let cursor = replyToString(list[0], cmd)?
  let items = asStrings(list[1], cmd)?
  return cursor, items
}

// `Reply.Map` (RESP3) or a flat `Reply.Array` of alternating key, value
// (RESP2's `HGETALL` convention) as `map<string, string>`.
export fn asMap(r: Reply, cmd: string): map<string, string>!RedisError {
  match (r) {
    Map(entries) => return mapFromEntries(entries, cmd)?
    Array(items) => return mapFromFlatOpt(items, cmd)?
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

fn mapFromEntries(entries: []MapEntry, cmd: string): map<string, string>!RedisError {
  let out = map<string, string>()
  let i = 0
  while (i < len(entries)) {
    let k = replyToString(entries[i].key, cmd)?
    let v = replyToString(entries[i].value, cmd)?
    out[k] = v
    i = i + 1
  }
  return out
}

fn mapFromFlatOpt(items: Option<[]Reply>, cmd: string): map<string, string>!RedisError {
  match (items) {
    Some(list) => return mapFromFlatArray(list, cmd)?
    None => return map<string, string>()
  }
}

fn mapFromFlatArray(list: []Reply, cmd: string): map<string, string>!RedisError {
  if (len(list) % 2 != 0) {
    fail RedisError.Unexpected(cmd, "Array")
  }
  let out = map<string, string>()
  let i = 0
  while (i < len(list)) {
    let k = replyToString(list[i], cmd)?
    let v = replyToString(list[i + 1], cmd)?
    out[k] = v
    i = i + 2
  }
  return out
}

// A flat `Reply.Array` of alternating member, score (`ZRANGE ...
// WITHSCORES`'s RESP2 shape) as `[]Scored`.
export fn asScored(r: Reply, cmd: string): []Scored!RedisError {
  match (r) {
    Array(items) => return scoredFromOpt(items, cmd)?
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

fn scoredFromOpt(items: Option<[]Reply>, cmd: string): []Scored!RedisError {
  match (items) {
    Some(list) => return scoredFromFlatArray(list, cmd)?
    None => return []Scored(0)
  }
}

fn scoredFromFlatArray(list: []Reply, cmd: string): []Scored!RedisError {
  if (len(list) % 2 != 0) {
    fail RedisError.Unexpected(cmd, "Array")
  }
  let out = []Scored(0)
  let i = 0
  while (i < len(list)) {
    let member = replyToString(list[i], cmd)?
    let score = asDouble(list[i + 1], cmd)?
    out = append(out, Scored{ member = member, score = score })
    i = i + 2
  }
  return out
}

// A blocking command's timeout argument, in seconds: whole milliseconds, so
// "2.500". `list.bit`'s header says why a positive sub-millisecond timeout is
// sent as 1ms and a negative one as -1.
fn blockSeconds(ns: int): string {
  if (ns < 0) {
    return "-1"
  }
  let ms = ns / Millisecond
  if (ns > 0 && ms == 0) {
    ms = 1
  }
  if (ms % 1000 == 0) {
    return "${ms / 1000}"
  }
  let frac = ms % 1000
  if (frac < 10) {
    return "${ms / 1000}.00${frac}"
  }
  if (frac < 100) {
    return "${ms / 1000}.0${frac}"
  }
  return "${ms / 1000}.${frac}"
}

// The read deadline for a blocking reply: the block itself plus the
// connection's `commandTimeout` of slack, or none (0) for a forever wait.
fn blockDeadline(blockNs: int, commandTimeoutNs: int): int {
  if (blockNs <= 0 || commandTimeoutNs <= 0) {
    return 0
  }
  return blockNs + commandTimeoutNs
}

fn blockRoundTrip(
  conn: redisConn,
  args: []string,
  commandTimeoutNs: int,
  blockNs: int,
): Reply!RedisError {
  writeCommand(conn, args, commandTimeoutNs)?
  let deadline = blockDeadline(blockNs, commandTimeoutNs)
  if (deadline == 0) {
    conn.setDeadline(0)
  }
  return readOneReply(conn, deadline)?
}

// Shared by every family's blocking command (`list.bit`, `zset.bit`).
// Runs a blocking `cmd` on a connection dialed for this call alone and
// closed after it - `list.bit`'s header, "A BLOCKING CALL NEVER LEASES A POOL
// CONNECTION". `blockNs` must be the timeout `cmd.args` was built with.
fn runBlocking<T>(client: Client, cmd: Cmd<T>, blockNs: int): T!RedisError {
  let roots = tlsRootsFor(client.opts)?
  let conn = dialConn(client.opts, roots)?
  let r = blockRoundTrip(conn, cmd.args, client.opts.commandTimeout, blockNs) catch e {
    conn.close()
    fail e
  }
  conn.close()
  return cmd.decode(r)?
}
