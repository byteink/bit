// pkg/redis/zsetinf.live.test.bit — infinite zset scores against a real server
// (#7831). Split out of `zset.live.test.bit` to stay under the 800-line
// ceiling; same model (each test is skipped when its URL is unset) and same
// module, so `liveUrl`, `liveClient`, `legacyClient` and `delKey` are in scope
// with no import.

// An infinite score round-trips: written as `+inf`/`-inf` command text, read
// back as bulk text on RESP2 and as `Reply.Double` on RESP3, both through
// `readDouble` (`resp3.bit`). `modern` is false for Redis 5, which lacks the
// 6.2 commands `scores`, `top` and `bottom` send.
fn checkInfiniteScores(c: Client, key: string, modern: bool) {
  delKey(c, key)
  let z = c.zset(key)
  z.addMany(
    Scored{ member = "hi", score = 1.0 / 0.0 },
    Scored{ member = "lo", score = 0.0 - 1.0 / 0.0 },
    Scored{ member = "mid", score = 1.5 },
  ) catch e {
    panic("addMany: ${e.message()}")
  }
  checkInfiniteLookups(z)
  checkInfiniteScan(z)
  if (modern) {
    checkInfiniteRanges(z)
    checkInfiniteMultiScore(z)
  }
  delKey(c, key)
}

fn checkInfiniteLookups(z: Zset) {
  let hi = z.score("hi") catch e {
    panic("score hi: ${e.message()}")
  }
  assert(isSome(hi) && unwrap(hi) == 1.0 / 0.0, "score('hi') should be +inf")
  let lo = z.score("lo") catch e {
    panic("score lo: ${e.message()}")
  }
  assert(isSome(lo) && unwrap(lo) == 0.0 - 1.0 / 0.0, "score('lo') should be -inf")
}

// ZMSCORE is Redis 6.2+, so `scores` is checked on the RESP3 server only.
fn checkInfiniteMultiScore(z: Zset) {
  let both = z.scores("lo", "mid", "hi") catch e {
    panic("scores: ${e.message()}")
  }
  assert(
    unwrap(both[0]) == 0.0 - 1.0 / 0.0 && unwrap(both[1]) == 1.5 && unwrap(both[2]) == 1.0 / 0.0,
    "scores should read -inf, 1.5, +inf",
  )
}

// `top`/`bottom` send ZRANGE ... REV (Redis 6.2+): RESP3 server only.
fn checkInfiniteRanges(z: Zset) {
  let top = z.top(1) catch e {
    panic("top: ${e.message()}")
  }
  assert(top[0].member == "hi" && top[0].score == 1.0 / 0.0, "top(1) should be hi at +inf")
  let bottom = z.bottom(1) catch e {
    panic("bottom: ${e.message()}")
  }
  assert(
    bottom[0].member == "lo" && bottom[0].score == 0.0 - 1.0 / 0.0,
    "bottom(1) should be lo at -inf",
  )
}

fn checkInfiniteScan(z: Zset) {
  let it = z.scan()
  let seen = 0
  while (true) {
    let item = it.next() catch e {
      panic("scan: ${e.message()}")
    }
    if (isNone(item)) {
      break
    }
    seen = seen + 1
    let sc = unwrap(item)
    if (sc.member == "hi") {
      assert(sc.score == 1.0 / 0.0, "scan hi should be +inf")
    }
  }
  assert(seen == 3, "scan should visit 3 members, got ${seen}")
}

test "live: infinite scores round-trip on RESP3" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  checkInfiniteScores(c, "bit:live:zset:inf3", true)
  c.close()
}

test "live: infinite scores round-trip over the RESP2 fallback (Redis 5)" {
  let u = liveUrl("REDIS_TEST_V5_URL")
  if (u == "") {
    return
  }
  let c = legacyClient(u)
  checkInfiniteScores(c, "bit:live:zset:inf2", false)
  c.close()
}
