// pkg/redis/set.test.bit - `set.bit`'s wire-arg builders and reply
// decoders, tested directly against plain arguments and `Reply` values: no
// socket needed (`hash.test.bit`'s own split).

fn setBulk(s: string): Reply { return Reply.Bulk(Option.Some(s)) }

fn setArr(items: []Reply): Reply { return Reply.Array(Option.Some(items)) }

test "ssetKeyArgs puts the command, the key, then every member in order" {
  let args = ssetKeyArgs("SADD", "tags", ["a", "b", "c"])
  assert(len(args) == 5, "expected 5 args, got ${len(args)}")
  assert(args[0] == "SADD" && args[1] == "tags", "args[0..1] = '${args[0]}', '${args[1]}'")
  assert(
    args[2] == "a" && args[3] == "b" && args[4] == "c",
    "args[2..4] = '${args[2]}', '${args[3]}', '${args[4]}'",
  )
}

test "ssetKeyArgs with no tail is just the command and the key" {
  let args = ssetKeyArgs("SINTER", "tags", []string(0))
  assert(len(args) == 2, "expected 2 args, got ${len(args)}")
}

test "ssetStoreArgs puts the destination before the first source key" {
  let args = ssetStoreArgs("SDIFFSTORE", "out", "a", ["b", "c"])
  assert(len(args) == 5, "expected 5 args, got ${len(args)}")
  assert(
    args[0] == "SDIFFSTORE" && args[1] == "out" && args[2] == "a",
    "args[0..2] = '${args[0]}', '${args[1]}', '${args[2]}'",
  )
  assert(args[3] == "b" && args[4] == "c", "args[3..4] = '${args[3]}', '${args[4]}'")
}

test "ssetInterCardArgs counts the handle's own key in numkeys" {
  let args = ssetInterCardArgs("a", ["b", "c"], 0)
  assert(len(args) == 5, "expected 5 args, got ${len(args)}")
  assert(args[0] == "SINTERCARD" && args[1] == "3", "args[0..1] = '${args[0]}', '${args[1]}'")
  assert(
    args[2] == "a" && args[3] == "b" && args[4] == "c",
    "args[2..4] = '${args[2]}', '${args[3]}', '${args[4]}'",
  )
}

test "ssetInterCardArgs appends LIMIT only when limit is positive" {
  let args = ssetInterCardArgs("a", ["b"], 7)
  assert(len(args) == 6, "expected 6 args, got ${len(args)}")
  assert(args[1] == "2", "numkeys = '${args[1]}'")
  assert(args[4] == "LIMIT" && args[5] == "7", "tail = '${args[4]}', '${args[5]}'")
}

test "ssetScanArgs sends MATCH and COUNT only when set" {
  let plain = ssetScanArgs("s", "0", "", 0)
  assert(len(plain) == 3, "expected 3 args, got ${len(plain)}")
  let full = ssetScanArgs("s", "17", "u:*", 50)
  assert(len(full) == 7, "expected 7 args, got ${len(full)}")
  assert(full[0] == "SSCAN" && full[2] == "17", "head = '${full[0]}', '${full[2]}'")
  assert(full[3] == "MATCH" && full[4] == "u:*", "match = '${full[3]}', '${full[4]}'")
  assert(full[5] == "COUNT" && full[6] == "50", "count = '${full[5]}', '${full[6]}'")
}

test "command factories pick the retry policy: reads retry, writes never" {
  assert(ssetMembersCmd("s").readOnly, "SMEMBERS is a read")
  assert(ssetRandomCmd("s", 1).readOnly, "SRANDMEMBER is a read")
  assert(ssetCombineCmd("SUNION", "s", ["t"]).readOnly, "SUNION is a read")
  assert(!ssetPopCmd("s", 1).readOnly, "SPOP removes members")
  assert(!ssetStoreCmd("SUNIONSTORE", "d", "s", ["t"]).readOnly, "SUNIONSTORE writes")
  assert(!ssetMoveCmd("s", "d", "m").readOnly, "SMOVE writes")
}

test "ssetPopCmd and ssetRandomCmd always send their count" {
  let pop = ssetPopCmd("s", 1)
  assert(len(pop.args) == 3 && pop.args[2] == "1", "SPOP args = ${len(pop.args)}")
  let random = ssetRandomCmd("s", -4)
  assert(random.args[2] == "-4", "SRANDMEMBER count = '${random.args[2]}'")
}

test "asSetMembers decodes a RESP3 Set reply" {
  let r = Reply.Set([setBulk("a"), setBulk("b")])
  let got = asSetMembers(r, "SMEMBERS") catch e {
    panic("asSetMembers: ${e.message()}")
  }
  assert(len(got) == 2 && got[0] == "a" && got[1] == "b", "got ${len(got)} members")
}

test "asSetMembers decodes a RESP2 Array reply and a null array" {
  let got = asSetMembers(setArr([setBulk("a")]), "SMEMBERS") catch e {
    panic("asSetMembers: ${e.message()}")
  }
  assert(len(got) == 1 && got[0] == "a", "got ${len(got)} members")
  let none = asSetMembers(Reply.Array(Option.None), "SMEMBERS") catch e {
    panic("asSetMembers null: ${e.message()}")
  }
  assert(len(none) == 0, "null array should decode to no members, got ${len(none)}")
}

test "asSetMembers refuses an integer reply" {
  let failed = false
  asSetMembers(Reply.Int(3), "SMEMBERS") catch _ {
    failed = true
  }
  assert(failed, "an Int reply is not a member list")
}

test "asSetBools decodes SMISMEMBER's 0/1 integers and RESP3 booleans" {
  let got = asSetBools(setArr([Reply.Int(1), Reply.Int(0), Reply.Bool(true)]), "SMISMEMBER") catch e {
    panic("asSetBools: ${e.message()}")
  }
  assert(len(got) == 3, "expected 3 results, got ${len(got)}")
  assert(got[0] && !got[1] && got[2], "got = ${got[0]}, ${got[1]}, ${got[2]}")
}

test "SSCAN's page decodes through asHashScanPage with the cursor first" {
  let page = setArr([setBulk("9"), setArr([setBulk("x"), setBulk("y")])])
  let (cursor, members) = ssetScanCmd("s", "0", "", 0).decode(page) catch e {
    panic("ssetScanCmd decode: ${e.message()}")
  }
  assert(cursor == "9", "cursor = '${cursor}'")
  assert(len(members) == 2 && members[0] == "x" && members[1] == "y", "members = ${len(members)}")
}
