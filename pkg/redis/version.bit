// pkg/redis/version.bit — the server version a connection reports, read once
// at the handshake (`conn.bit`'s `handshake`) so a family can send the form a
// pre-6.2 server understands (#7840).
//
// A version is one int, `major * 1000 + minor` (`versionCode`): 5.0.14 is 5000,
// 6.2.0 is 6002, 8.10.2 is 8010. The patch level never gates a command. 0 means
// "unknown" (a proxy that hides `INFO`, an unparseable string) and is treated
// as a modern server, so a server this package cannot identify gets the
// commands it always got.

// The first release with `ZMSCORE`, `ZRANGE ... REV|BYSCORE|BYLEX|LIMIT` and
// the other 6.2 sorted-set commands.
const serverV62: int = 6002

// True for a server known to predate 6.2; false for 6.2+ and for unknown.
fn preV62(version: int): bool {
  return version != 0 && version < serverV62
}

// `major.minor[.patch][-suffix]` as `major * 1000 + minor`; 0 when it does not
// start with two dot-separated numbers.
fn versionCode(text: string): int {
  let dot = indexOf(text, ".")
  if (dot <= 0) {
    return 0
  }
  let major = leadingNumber(text[0:dot])
  let minor = leadingNumber(text[dot + 1:len(text)])
  return major * 1000 + minor
}

// The leading run of decimal digits of `s` as an int, 0 when there is none.
fn leadingNumber(s: string): int {
  let digits = "0123456789"
  let end = 0
  while (end < len(s) && indexOf(digits, s[end:end + 1]) >= 0) {
    end = end + 1
  }
  if (end == 0) {
    return 0
  }
  return parseInt(s[0:end]) catch _ {
    return 0
  }
}

// The `redis_version:` line of an `INFO server` body ("" when absent).
fn infoVersion(info: string): string {
  let tag = "redis_version:"
  let at = indexOf(info, tag)
  if (at < 0) {
    return ""
  }
  let rest = info[at + len(tag):len(info)]
  let end = 0
  while (end < len(rest) && rest[end:end + 1] != "\r" && rest[end:end + 1] != "\n") {
    end = end + 1
  }
  return rest[0:end]
}

// The `version` field of a `HELLO` reply: a RESP3 map, or the flat
// key/value array RESP2 answers `HELLO 2` with. "" when absent.
fn helloVersion(r: Reply): string {
  match (r) {
    Map(entries) => return versionFromEntries(entries)
    Array(items) => return versionFromFlat(unwrapOr(items, []Reply(0)))
    _ => return ""
  }
}

fn versionFromEntries(entries: []MapEntry): string {
  let i = 0
  while (i < len(entries)) {
    if (replyText(entries[i].key) == "version") {
      return replyText(entries[i].value)
    }
    i = i + 1
  }
  return ""
}

fn versionFromFlat(items: []Reply): string {
  let i = 0
  while (i + 1 < len(items)) {
    if (replyText(items[i]) == "version") {
      return replyText(items[i + 1])
    }
    i = i + 2
  }
  return ""
}
