// pkg/redis/hash.test.bit — `hash.bit`'s decode helpers and wire-arg
// builders, tested directly against `Reply` values and plain arguments:
// none of this needs a socket, real or fake (`cmd.test.bit`'s own split
// already proved the shared decode helpers this file reuses).

test "hashSetArgs puts HSET, the key, then every field/value pair" {
  let args = hashSetArgs("user:1", map<string, string>{ "name": "Ada", "lang": "bit" })
  assert(args[0] == "HSET", "args[0] = '${args[0]}'")
  assert(args[1] == "user:1", "args[1] = '${args[1]}'")
  assert(len(args) == 6, "expected 6 args (HSET, key, 2 pairs), got ${len(args)}")
  let hasName = (args[2] == "name" && args[3] == "Ada") || (args[4] == "name" && args[5] == "Ada")
  let hasLang = (args[2] == "lang" && args[3] == "bit") || (args[4] == "lang" && args[5] == "bit")
  assert(hasName, "missing name/Ada pair")
  assert(hasLang, "missing lang/bit pair")
}

test "hashKeyFieldsArgs builds CMD key field [field ...] with no FIELDS wrapper" {
  let args = hashKeyFieldsArgs("HDEL", "user:1", ["name", "lang"])
  assert(len(args) == 4, "expected 4 args, got ${len(args)}")
  assert(args[0] == "HDEL" && args[1] == "user:1", "args[0..1] = '${args[0]}', '${args[1]}'")
  assert(args[2] == "name" && args[3] == "lang", "args[2..3] = '${args[2]}', '${args[3]}'")
}

test "hashFieldsArgs wraps fields with FIELDS numfields" {
  let args = hashFieldsArgs("HTTL", "user:1", ["a", "b", "c"])
  assert(len(args) == 7, "expected 7 args, got ${len(args)}")
  assert(args[2] == "FIELDS" && args[3] == "3", "args[2..3] = '${args[2]}', '${args[3]}'")
  assert(
    args[4] == "a" && args[5] == "b" && args[6] == "c",
    "args[4..6] = '${args[4]}', '${args[5]}', '${args[6]}'",
  )
}

test "hashExpireArgs converts nanoseconds to the command's own unit and carries the condition flag" {
  let args = hashExpireArgs("HEXPIRE", "user:1", "${60}", "NX", ["a"])
  assert(
    args[0] == "HEXPIRE" && args[1] == "user:1" && args[2] == "60",
    "args[0..2] = '${args[0]}', '${args[1]}', '${args[2]}'",
  )
  assert(args[3] == "NX", "condition flag = '${args[3]}'")
  assert(args[4] == "FIELDS" && args[5] == "1" && args[6] == "a", "args[6] = '${args[6]}'")
}

test "hashExpireArgs omits the condition flag when when is empty" {
  let args = hashExpireArgs("HPEXPIRE", "user:1", "60000", "", ["a"])
  assert(args[3] == "FIELDS", "expected no condition flag, args[3] = '${args[3]}'")
}

test "hashGetExArgs sends EX seconds when ttl is set, PERSIST when persist is true" {
  let withTtl = hashGetExArgs("user:1", ["a"], 5000000000, false)
  assert(
    withTtl[2] == "EX" && withTtl[3] == "5",
    "expected EX 5, got '${withTtl[2]}' '${withTtl[3]}'",
  )

  let persisted = hashGetExArgs("user:1", ["a"], 0, true)
  assert(persisted[2] == "PERSIST", "expected PERSIST, got '${persisted[2]}'")

  let plain = hashGetExArgs("user:1", ["a"], 0, false)
  assert(plain[2] == "FIELDS", "expected no TTL option, got '${plain[2]}'")
}

test "hashSetExArgs sends KEEPTTL instead of EX when keepTtl is true" {
  let kept = hashSetExArgs("user:1", map<string, string>{ "a": "1" }, 0, "", true)
  assert(kept[2] == "KEEPTTL", "expected KEEPTTL, got '${kept[2]}'")

  let timed = hashSetExArgs("user:1", map<string, string>{ "a": "1" }, 30000000000, "FNX", false)
  assert(timed[2] == "FNX", "expected FNX flag, got '${timed[2]}'")
  assert(timed[3] == "EX" && timed[4] == "30", "expected EX 30, got '${timed[3]}' '${timed[4]}'")
  assert(
    timed[5] == "FIELDS" && timed[6] == "1",
    "expected FIELDS 1, got '${timed[5]}' '${timed[6]}'",
  )
}

test "hashRandomArgs appends WITHVALUES only when requested" {
  let plain = hashRandomArgs("user:1", 2, false)
  assert(len(plain) == 3, "expected 3 args, got ${len(plain)}")
  let withValues = hashRandomArgs("user:1", 2, true)
  assert(
    len(withValues) == 4 && withValues[3] == "WITHVALUES",
    "expected WITHVALUES at index 3, got '${withValues[3]}'",
  )
}

test "hashScanArgs adds MATCH and COUNT only when set" {
  let bare = hashScanArgs("user:1", "0", "", 0)
  assert(len(bare) == 3, "expected 3 args, got ${len(bare)}")
  let full = hashScanArgs("user:1", "12", "u:*", 10)
  assert(len(full) == 7, "expected 7 args, got ${len(full)}")
  assert(full[3] == "MATCH" && full[4] == "u:*", "args[3..4] = '${full[3]}', '${full[4]}'")
  assert(full[5] == "COUNT" && full[6] == "10", "args[5..6] = '${full[5]}', '${full[6]}'")
}

test "asHashOptStrings keeps the null-vs-empty distinction per field" {
  let items = [
    Reply.Bulk(Option.Some("Ada")), Reply.Null, Reply.Bulk(Option.Some("")),
  ]
  let got = asOptStrings(Reply.Array(Option.Some(items)), "HMGET") catch e {
    panic("asHashOptStrings: ${e.message()}")
  }
  assert(len(got) == 3, "expected 3 entries, got ${len(got)}")
  assert(isSome(got[0]) && unwrap(got[0]) == "Ada", "got[0] should be Some('Ada')")
  assert(isNone(got[1]), "got[1] should be None for a missing field")
  assert(isSome(got[2]) && unwrap(got[2]) == "", "got[2] should be Some('')")
}

test "asInts decodes the field-expiry sentinel array, negatives included" {
  let items = [Reply.Int(1), Reply.Int(-1), Reply.Int(-2)]
  let got = asInts(Reply.Array(Option.Some(items)), "HTTL") catch e {
    panic("asInts: ${e.message()}")
  }
  assert(len(got) == 3, "expected 3 entries, got ${len(got)}")
  assert(
    got[0] == 1 && got[1] == -1 && got[2] == -2,
    "got = ${got[0]}, ${got[1]}, ${got[2]}",
  )
}

test "asHashRandomFields flattens the RESP2 flat array unchanged" {
  let items = [
    Reply.Bulk(Option.Some("a")), Reply.Bulk(Option.Some("1")),
    Reply.Bulk(Option.Some("b")), Reply.Bulk(Option.Some("2")),
  ]
  let got = asHashRandomFields(Reply.Array(Option.Some(items)), "HRANDFIELD") catch e {
    panic("asHashRandomFields: ${e.message()}")
  }
  assert(len(got) == 4, "expected 4 entries, got ${len(got)}")
  assert(
    got[0] == "a" && got[1] == "1" && got[2] == "b" && got[3] == "2",
    "got = ${got[0]}, ${got[1]}, ${got[2]}, ${got[3]}",
  )
}

test "asHashRandomFields flattens RESP3's nested field/value pairs" {
  let pairA = Reply.Array(Option.Some([Reply.Bulk(Option.Some("a")), Reply.Bulk(Option.Some("1"))]))
  let pairB = Reply.Array(Option.Some([Reply.Bulk(Option.Some("b")), Reply.Bulk(Option.Some("2"))]))
  let got = asHashRandomFields(Reply.Array(Option.Some([pairA, pairB])), "HRANDFIELD") catch e {
    panic("asHashRandomFields: ${e.message()}")
  }
  assert(len(got) == 4, "expected 4 entries, got ${len(got)}")
  assert(
    got[0] == "a" && got[1] == "1" && got[2] == "b" && got[3] == "2",
    "got = ${got[0]}, ${got[1]}, ${got[2]}, ${got[3]}",
  )
}
