// pkg/redis/bitmap.test.bit - `bitmap.bit`'s wire arguments, the offset and
// builder checks, and the `BITFIELD` reply decoder, tested without a server.
// `assertArgs` is `list.test.bit`'s and `isInvalid` is `stream.test.bit`'s
// (same module). `bitmap.live.test.bit` runs every command against a real
// server.

fn bmRefusedOffset(offset: i64): bool {
  let refused = false
  checkOffset(offset) catch e {
    refused = isInvalid(e)
  }
  return refused
}

fn bmFutureInvalid(f: Future<bool>): bool {
  let refused = false
  let _ = f.get() catch e {
    refused = isInvalid(e)
    false
  }
  return refused
}

fn bmRefusedOps(ops: BitFieldOps, readOnly: bool): bool {
  let refused = false
  checkOps(ops, readOnly) catch e {
    refused = isInvalid(e)
  }
  return refused
}

test "SETBIT and GETBIT send the offset and 1 or 0" {
  assertArgs(setBitCmd("b", 7, true).args, ["SETBIT", "b", "7", "1"])
  assertArgs(setBitCmd("b", 0, false).args, ["SETBIT", "b", "0", "0"])
  assertArgs(getBitCmd("b", 4294967295).args, ["GETBIT", "b", "4294967295"])
  let old = setBitCmd("b", 7, true).decode(Reply.Int(1)) catch e {
    panic("setbit: ${e.message()}")
  }
  assert(old, "Int(1) is true")
}

test "an offset outside 0..2^32-1 is Invalid" {
  assert(!bmRefusedOffset(0), "0")
  assert(!bmRefusedOffset(4294967295), "2^32-1")
  assert(bmRefusedOffset(-1), "-1")
  assert(bmRefusedOffset(4294967296), "2^32")
}

test "BITCOUNT and BITPOS spell each range, and BITCOUNT refuses a start-only one" {
  assertArgs(bitCountCmd("b", BitRange.All).args, ["BITCOUNT", "b"])
  assertArgs(bitCountCmd("b", BitRange.Bytes(0, -1)).args, ["BITCOUNT", "b", "0", "-1"])
  assertArgs(bitCountCmd("b", BitRange.Bits(5, 30)).args, ["BITCOUNT", "b", "5", "30", "BIT"])
  assertArgs(bitPosCmd("b", true, BitRange.All).args, ["BITPOS", "b", "1"])
  assertArgs(bitPosCmd("b", false, BitRange.From(2)).args, ["BITPOS", "b", "0", "2"])
  assertArgs(bitPosCmd("b", true, BitRange.Bytes(1, 3)).args, ["BITPOS", "b", "1", "1", "3"])
  assertArgs(bitPosCmd("b", true, BitRange.Bits(1, 9)).args, ["BITPOS", "b", "1", "1", "9", "BIT"])
  let refused = false
  checkCountRange(BitRange.From(1)) catch e {
    refused = isInvalid(e)
  }
  assert(refused, "BITCOUNT with only a start is refused")
  checkCountRange(BitRange.Bits(1, 2)) catch e {
    panic("a full range is fine: ${e.message()}")
  }
}

test "BITOP has all eight operators, destination first" {
  let words = [
    (BitOp.And, "AND"), (BitOp.Or, "OR"), (BitOp.Xor, "XOR"), (BitOp.Not, "NOT"),
    (BitOp.Diff, "DIFF"), (BitOp.Diff1, "DIFF1"), (BitOp.AndOr, "ANDOR"), (BitOp.One, "ONE"),
  ]
  assert(len(words) == 8, "eight operators")
  for pair of words {
    let (op, word) = pair
    assert(op.text() == word, "text = ${op.text()}, want ${word}")
    assertArgs(bitOpCmd("dst", op, ["a", "b"]).args, ["BITOP", word, "dst", "a", "b"])
  }
}

test "BitType, BitAt and BitOverflow use the server's spelling" {
  assert(BitType.Unsigned(8).text() == "u8", "u8")
  assert(BitType.Signed(16).text() == "i16", "i16")
  assert(BitAt.Bit(100).text() == "100", "bit 100")
  assert(BitAt.Slot(2).text() == "#2", "slot 2")
  assert(BitOverflow.Wrap.text() == "WRAP", "wrap")
  assert(BitOverflow.Sat.text() == "SAT", "sat")
  assert(BitOverflow.Fail.text() == "FAIL", "fail")
}

test "the BITFIELD builder appends in call order and never changes the builder it was called on" {
  let base = bitfield().get(BitType.Unsigned(8), BitAt.Bit(0))
  let sat = base.overflow(BitOverflow.Sat).incrBy(BitType.Signed(5), BitAt.Slot(1), -3)
  let longer = sat.set(BitType.Unsigned(4), BitAt.Bit(8), 9)
  assertArgs(base.args, ["GET", "u8", "0"])
  assertArgs(
    bitFieldCmd("BITFIELD", "b", longer).args,
    [
      "BITFIELD", "b", "GET", "u8", "0", "OVERFLOW", "SAT", "INCRBY", "i5", "#1", "-3", "SET", "u4",
      "8", "9",
    ],
  )
  assert(base.readsOnly && !longer.readsOnly, "only the builder with writes stops reading only")
}

test "BITFIELD_RO refuses writes and OVERFLOW, BITFIELD refuses a bad type or offset" {
  let reads = bitfield().get(BitType.Unsigned(8), BitAt.Bit(0)).get(
    BitType.Signed(4),
    BitAt.Slot(1),
  )
  assert(!bmRefusedOps(reads, true), "gets are fine for BITFIELD_RO")
  assert(bmRefusedOps(reads.set(BitType.Unsigned(8), BitAt.Bit(0), 1), true), "set")
  assert(bmRefusedOps(reads.incrBy(BitType.Unsigned(8), BitAt.Bit(0), 1), true), "incrBy")
  assert(bmRefusedOps(reads.overflow(BitOverflow.Fail), true), "overflow")
  assert(!bmRefusedOps(reads.overflow(BitOverflow.Fail), false), "BITFIELD allows overflow")

  assert(bmRefusedOps(bitfield().get(BitType.Unsigned(64), BitAt.Bit(0)), false), "u64")
  assert(bmRefusedOps(bitfield().get(BitType.Unsigned(0), BitAt.Bit(0)), false), "u0")
  assert(bmRefusedOps(bitfield().get(BitType.Signed(65), BitAt.Bit(0)), false), "i65")
  assert(!bmRefusedOps(bitfield().get(BitType.Signed(64), BitAt.Bit(0)), false), "i64 is allowed")
  assert(bmRefusedOps(bitfield().get(BitType.Unsigned(8), BitAt.Bit(-1)), false), "bit -1")
  assert(bmRefusedOps(bitfield().get(BitType.Unsigned(8), BitAt.Slot(-1)), false), "slot -1")
  let carried = bitfield().get(BitType.Unsigned(64), BitAt.Bit(0)).get(
    BitType.Unsigned(8),
    BitAt.Bit(0),
  )
  assert(bmRefusedOps(carried, false), "a later good step keeps the earlier problem")
}

test "BITFIELD is retry-safe only while it holds nothing but gets" {
  let reads = bitfield().get(BitType.Unsigned(8), BitAt.Bit(0))
  assert(bitFieldCmd("BITFIELD", "b", reads).readOnly, "gets only")
  let writes = reads.incrBy(BitType.Unsigned(8), BitAt.Bit(0), 1)
  assert(!bitFieldCmd("BITFIELD", "b", writes).readOnly, "with an incrBy")
}

test "BITFIELD decodes one Option per operation, null being a refused incrBy" {
  let got = asBitFieldValues(
    sArr([Reply.Int(5), Reply.Null, Reply.Int(-2), Reply.Bulk(Option.None)]),
    "BITFIELD",
  ) catch e {
    panic("values: ${e.message()}")
  }
  assert(len(got) == 4, "four values")
  assert(unwrap(got[0]) == 5 && isNone(got[1]) && unwrap(got[2]) == -2 && isNone(got[3]), "values")
  let bad = false
  let _ = asBitFieldValues(sArr([sBulk("x")]), "BITFIELD") catch _ {
    bad = true
    []Option<i64>(0)
  }
  assert(bad, "a non-null string is not a BITFIELD value")
}

test "BitmapBatch queues the commands with Bitmap's argv and refuses what Bitmap refuses" {
  let batch = Batch()
  let b = BitmapBatch{ batch = batch, key = "b" }
  let _ = b.set(3, true)
  let _ = b.get(3)
  let _ = b.count(BitRange.Bytes(0, 1))
  let _ = b.pos(false)
  let _ = b.op(BitOp.One, "x", "y")
  let _ = b.bitfield(bitfield().incrBy(BitType.Unsigned(8), BitAt.Bit(0), 1))
  let _ = b.bitfieldRo(bitfield().get(BitType.Unsigned(8), BitAt.Bit(0)))
  assert(len(batch.queued) == 7, "queued ${len(batch.queued)} commands")
  assertArgs(batch.queued[0], ["SETBIT", "b", "3", "1"])
  assertArgs(batch.queued[4], ["BITOP", "ONE", "b", "x", "y"])
  assertArgs(batch.queued[6], ["BITFIELD_RO", "b", "GET", "u8", "0"])

  assert(bmFutureInvalid(b.get(-1)), "get(-1) is a failed Future")
  assert(bmFutureInvalid(b.set(-1, true)), "set(-1) is a failed Future")
  assert(len(batch.queued) == 7, "the refused calls queued nothing")
}
