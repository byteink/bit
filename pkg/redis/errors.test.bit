// pkg/redis/errors.test.bit — `fromServer`'s prefix table, `message()`'s
// text, and `retryable()`'s classification (#6019). `fromServer` only ever
// builds the server-side variants (plus `Server`/`Moved`/`Ask`'s fallback
// paths); the client-side variants are built directly by the connection and
// pool layers, so their `message()`/`retryable()` tests construct them by
// hand instead of routing through `fromServer`.

// A pre-6 server's bad password is `-ERR invalid password` (#7787); only
// `authFailure`, which `legacyAuth` applies to the AUTH reply, maps it.
test "authFailure files a Redis 5 bad password as WrongPass and nothing else" {
  match (authFailure(fromServer("ERR invalid password"))) {
    WrongPass(msg) => assert(msg == "invalid password", "WrongPass: got '${msg}'")
    _ => panic("expected WrongPass")
  }
  match (authFailure(fromServer("ERR Client sent AUTH, but no password is set"))) {
    Server(code, _) => assert(code == "ERR", "Server code: got '${code}'")
    _ => panic("expected Server for an AUTH with no password configured")
  }
  match (authFailure(fromServer("WRONGPASS invalid username-password pair"))) {
    WrongPass(msg) => assert(msg == "invalid username-password pair", "WrongPass: got '${msg}'")
    _ => panic("expected WrongPass")
  }
  match (authFailure(RedisError.Timeout)) {
    Timeout => {}
    _ => panic("expected Timeout to pass through")
  }
}

test "fromServer leaves -ERR invalid password a Server error outside AUTH" {
  match (fromServer("ERR invalid password")) {
    Server(code, msg) => assert(code == "ERR" && msg == "invalid password", "got ${code} ${msg}")
    _ => panic("expected Server")
  }
}

test "fromServer parses every documented server error prefix" {
  match (fromServer("WRONGTYPE Operation against a key holding the wrong kind of value")) {
    WrongType(msg) => assert(
      msg == "Operation against a key holding the wrong kind of value",
      "WrongType: got '${msg}'",
    )
    _ => panic("expected WrongType")
  }
  match (fromServer("NOSCRIPT No matching script")) {
    NoScript(msg) => assert(msg == "No matching script", "NoScript: got '${msg}'")
    _ => panic("expected NoScript")
  }
  match (fromServer("NOAUTH Authentication required")) {
    NoAuth(msg) => assert(msg == "Authentication required", "NoAuth: got '${msg}'")
    _ => panic("expected NoAuth")
  }
  match (fromServer("WRONGPASS invalid username-password pair")) {
    WrongPass(msg) => assert(msg == "invalid username-password pair", "WrongPass: got '${msg}'")
    _ => panic("expected WrongPass")
  }
  match (fromServer("NOPERM this user has no permissions")) {
    NoPerm(msg) => assert(msg == "this user has no permissions", "NoPerm: got '${msg}'")
    _ => panic("expected NoPerm")
  }
  match (fromServer("READONLY You can't write against a read only replica")) {
    ReadOnly(msg) => assert(
      msg == "You can't write against a read only replica",
      "ReadOnly: got '${msg}'",
    )
    _ => panic("expected ReadOnly")
  }
  match (fromServer("LOADING Redis is loading the dataset in memory")) {
    Loading(msg) => assert(msg == "Redis is loading the dataset in memory", "Loading: got '${msg}'")
    _ => panic("expected Loading")
  }
  match (fromServer("BUSY Redis is busy running a script")) {
    Busy(msg) => assert(msg == "Redis is busy running a script", "Busy: got '${msg}'")
    _ => panic("expected Busy")
  }
  match (fromServer("EXECABORT Transaction discarded because of previous errors")) {
    ExecAbort(msg) => assert(
      msg == "Transaction discarded because of previous errors",
      "ExecAbort: got '${msg}'",
    )
    _ => panic("expected ExecAbort")
  }
  match (fromServer("TRYAGAIN Multiple keys request during rehashing")) {
    TryAgain(msg) => assert(
      msg == "Multiple keys request during rehashing",
      "TryAgain: got '${msg}'",
    )
    _ => panic("expected TryAgain")
  }
  match (fromServer("CLUSTERDOWN The cluster is down")) {
    ClusterDown(msg) => assert(msg == "The cluster is down", "ClusterDown: got '${msg}'")
    _ => panic("expected ClusterDown")
  }
  match (fromServer("OOM command not allowed when used memory > 'maxmemory'")) {
    OutOfMemory(msg) => assert(
      msg == "command not allowed when used memory > 'maxmemory'",
      "OutOfMemory: got '${msg}'",
    )
    _ => panic("expected OutOfMemory")
  }
}

test "fromServer files RedisJSON's wrong-type reply as WrongType, and only that reply" {
  match (fromServer("Existing key has wrong Redis type")) {
    WrongType(msg) => assert(msg == "Existing key has wrong Redis type", "WrongType: got '${msg}'")
    _ => panic("expected WrongType")
  }
  match (fromServer("ERR could not perform this operation on a key that doesn't exist")) {
    Server(code, _) => assert(code == "ERR", "Server code: got '${code}'")
    _ => panic("expected Server for the missing-key reply")
  }
  match (fromServer("Existing key has wrong")) {
    Server(code, _) => assert(code == "Existing", "Server code: got '${code}'")
    _ => panic("expected Server for a truncated sentence")
  }
  match (fromServer("Existing")) {
    Server(code, _) => assert(code == "Existing", "Server code: got '${code}'")
    _ => panic("expected Server for a lone first word")
  }
}

test "fromServer parses MOVED and ASK redirects" {
  match (fromServer("MOVED 3999 127.0.0.1:6381")) {
    Moved(slot, addr) => {
      assert(slot == 3999, "Moved slot: got ${slot}")
      assert(addr == "127.0.0.1:6381", "Moved addr: got '${addr}'")
    }
    _ => panic("expected Moved")
  }
  match (fromServer("ASK 3999 127.0.0.1:6381")) {
    Ask(slot, addr) => {
      assert(slot == 3999, "Ask slot: got ${slot}")
      assert(addr == "127.0.0.1:6381", "Ask addr: got '${addr}'")
    }
    _ => panic("expected Ask")
  }
}

test "fromServer falls back to Server for a bad MOVED/ASK redirect" {
  match (fromServer("MOVED notanumber 127.0.0.1:6381")) {
    Server(code, msg) => {
      assert(code == "MOVED", "bad slot code: got '${code}'")
      assert(msg == "notanumber 127.0.0.1:6381", "bad slot msg: got '${msg}'")
    }
    _ => panic("expected Server for a non-numeric slot")
  }
  match (fromServer("ASK 3999")) {
    Server(code, msg) => {
      assert(code == "ASK", "missing addr code: got '${code}'")
      assert(msg == "3999", "missing addr msg: got '${msg}'")
    }
    _ => panic("expected Server for a redirect with no address")
  }
}

test "fromServer falls back to Server for a prefix it does not name" {
  match (fromServer("CUSTOMCODE something went wrong")) {
    Server(code, msg) => {
      assert(code == "CUSTOMCODE", "unknown prefix code: got '${code}'")
      assert(msg == "something went wrong", "unknown prefix msg: got '${msg}'")
    }
    _ => panic("expected Server")
  }
}

test "fromServer of empty text is Server with an empty code and message" {
  match (fromServer("")) {
    Server(code, msg) => {
      assert(code == "", "empty text code: got '${code}'")
      assert(msg == "", "empty text msg: got '${msg}'")
    }
    _ => panic("expected Server")
  }
}

test "message() renders every variant's text" {
  assert(RedisError.WrongType("bad type").message() == "redis: WRONGTYPE bad type", "WrongType")
  assert(
    RedisError.NoScript("no such script").message() == "redis: NOSCRIPT no such script",
    "NoScript",
  )
  assert(RedisError.NoAuth("auth required").message() == "redis: NOAUTH auth required", "NoAuth")
  assert(RedisError.WrongPass("bad pass").message() == "redis: WRONGPASS bad pass", "WrongPass")
  assert(RedisError.NoPerm("denied").message() == "redis: NOPERM denied", "NoPerm")
  assert(RedisError.ReadOnly("replica").message() == "redis: READONLY replica", "ReadOnly")
  assert(RedisError.Loading("loading").message() == "redis: LOADING loading", "Loading")
  assert(RedisError.Busy("script").message() == "redis: BUSY script", "Busy")
  assert(RedisError.ExecAbort("aborted").message() == "redis: EXECABORT aborted", "ExecAbort")
  assert(RedisError.TryAgain("rehash").message() == "redis: TRYAGAIN rehash", "TryAgain")
  assert(RedisError.ClusterDown("down").message() == "redis: CLUSTERDOWN down", "ClusterDown")
  assert(RedisError.OutOfMemory("oom").message() == "redis: OOM oom", "OutOfMemory")
  assert(
    RedisError.Moved(3999, "127.0.0.1:6381").message() == "redis: MOVED 3999 127.0.0.1:6381",
    "Moved",
  )
  assert(
    RedisError.Ask(3999, "127.0.0.1:6381").message() == "redis: ASK 3999 127.0.0.1:6381",
    "Ask",
  )
  assert(RedisError.Server("CUSTOMCODE", "boom").message() == "redis: CUSTOMCODE boom", "Server")
  assert(RedisError.Io("connection reset").message() == "redis: io: connection reset", "Io")
  assert(RedisError.Timeout.message() == "redis: timeout", "Timeout")
  assert(RedisError.Closed.message() == "redis: use of closed connection", "Closed")
  assert(RedisError.Protocol("bad reply").message() == "redis: protocol: bad reply", "Protocol")
  assert(RedisError.PoolExhausted.message() == "redis: connection pool exhausted", "PoolExhausted")
  assert(
    RedisError.Unexpected("GET", "Array").message() == "redis: GET: unexpected reply, got Array",
    "Unexpected",
  )
}

test "retryable() is true only for transport and transient-topology failures" {
  assert(RedisError.Io("reset").retryable(), "Io")
  assert(RedisError.Timeout.retryable(), "Timeout")
  assert(RedisError.Loading("wait").retryable(), "Loading")
  assert(RedisError.Busy("script").retryable(), "Busy")
  assert(RedisError.TryAgain("rehash").retryable(), "TryAgain")
  assert(RedisError.ClusterDown("down").retryable(), "ClusterDown")

  assert(!RedisError.WrongType("x").retryable(), "WrongType")
  assert(!RedisError.NoScript("x").retryable(), "NoScript")
  assert(!RedisError.NoAuth("x").retryable(), "NoAuth")
  assert(!RedisError.WrongPass("x").retryable(), "WrongPass")
  assert(!RedisError.NoPerm("x").retryable(), "NoPerm")
  assert(!RedisError.ReadOnly("x").retryable(), "ReadOnly")
  assert(!RedisError.ExecAbort("x").retryable(), "ExecAbort")
  assert(!RedisError.OutOfMemory("x").retryable(), "OutOfMemory")
  assert(!RedisError.Moved(1, "a:1").retryable(), "Moved")
  assert(!RedisError.Ask(1, "a:1").retryable(), "Ask")
  assert(!RedisError.Server("X", "y").retryable(), "Server")
  assert(!RedisError.Protocol("x").retryable(), "Protocol")
  assert(!RedisError.Closed.retryable(), "Closed")
  assert(!RedisError.PoolExhausted.retryable(), "PoolExhausted")
  assert(!RedisError.Unexpected("GET", "Array").retryable(), "Unexpected")
}

test "Invalid is a caller mistake: its message names the argument and it never retries" {
  assert(
      RedisError.Invalid("count must be >= 0, got -1").message() ==
      "redis: invalid argument: count must be >= 0, got -1",
    "Invalid message",
  )
  assert(!RedisError.Invalid("count").retryable(), "Invalid")
}
