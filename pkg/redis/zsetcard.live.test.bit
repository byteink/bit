// pkg/redis/zsetcard.live.test.bit — `Zset.interCard` (ZINTERCARD, #7755)
// against a real server. Split out of `zset.live.test.bit` to stay under the
// 800-line ceiling; same model (each test is skipped when `REDIS_TEST_URL` is
// unset) and same module, so `liveUrl`, `liveClient`, `delKey` and
// `seedBoard` are in scope with no import.

test "live: interCard counts the intersection, stops at limit, and queues through a batch" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:zset:card:a"
  let other = "bit:live:zset:card:b"
  seedBoard(c, key)
  delKey(c, other)
  c.zset(other).addMany(
    Scored{ member = "ada", score = 1.0 },
    Scored{ member = "bob", score = 2.0 },
    Scored{ member = "cy", score = 3.0 },
    Scored{ member = "zed", score = 5.0 },
  ) catch e {
    panic("addMany other: ${e.message()}")
  }
  let all = c.zset(key).interCard([other]) catch e {
    panic("interCard: ${e.message()}")
  }
  assert(all == 3, "interCard = ${all}")
  let capped = c.zset(key).interCard([other], 2) catch e {
    panic("interCard limit: ${e.message()}")
  }
  assert(capped == 2, "interCard with limit 2 = ${capped}")
  let none = c.zset(key).interCard(["bit:live:zset:card:missing"]) catch e {
    panic("interCard missing: ${e.message()}")
  }
  assert(none == 0, "interCard with a missing key = ${none}")
  let p = c.pipeline()
  let queued = p.zset(key).interCard([other], 0)
  p.exec() catch e {
    panic("pipeline exec: ${e.message()}")
  }
  let k = queued.get() catch e {
    panic("future: ${e.message()}")
  }
  assert(k == 3, "queued interCard = ${k}")
  delKey(c, key)
  delKey(c, other)
  c.close()
}
