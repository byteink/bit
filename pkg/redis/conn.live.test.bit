// pkg/redis/conn.live.test.bit — the connection-level live tests (#6027, epic
// #6013): TLS verification and the RESP2 fallback. Same model as
// client.live.test.bit (it shares that file's `liveUrl`, `liveClient` and
// `withWrongPassword`): each test is skipped, and says so, when its variable
// is unset; `./make test-package-redis-live` (_tests_/bit/redislive.bit)
// supplies them.
//
// TLS CERTIFICATE VERIFICATION: `REDIS_TEST_TLS_URL`'s server presents a
// leaf signed by a CA the harness generated for this run (named for DNS
// `localhost` and IP `127.0.0.1`), handed over as `REDIS_TEST_TLS_CA`;
// `REDIS_TEST_TLS_OTHER_CA` is a second, unrelated CA. The tests below prove
// `Options.tlsRootCa` accepts the real chain, and that an unrelated CA, the
// OS trust store and a wrong `tlsServerName` are each refused with the
// verifier's own message, with `insecureSkipVerify` as the control that the
// server is reachable at all.
//
// RESP2 FALLBACK: `REDIS_TEST_V5_URL` is a real Redis 5 (no `HELLO`).
// `env` comes from client.live.test.bit's import: an import binds per MODULE.

import { join } from "std/strings"

fn tlsOptions(): Options {
  let u = env("REDIS_TEST_TLS_URL")
  return parseUrl(u) catch e {
    panic("parseUrl(${u}): ${e.message()}")
  }
}

// Whether the TLS fixtures were provided; says so once when they were not.
fn tlsLive(): bool {
  return liveUrl("REDIS_TEST_TLS_URL") != "" && liveUrl("REDIS_TEST_TLS_CA") != ""
}

// What the verifier says when no path reaches a trusted root. This server also
// sends the self-signed CA that signed its leaf (OpenSSL's automatic chain);
// std/crypto's `x509VerifyChain` ends the path at that untrusted self-issued
// certificate (#7786).
fn untrustedRootMessages(): []string {
  return ["unable to build chain to a trusted root"]
}

// Connecting with `opts` must fail, and the failure must be one of the
// verifier's `wants`, not a transport problem.
fn expectTlsRefused(opts: Options, wants: []string) {
  let c = connect(opts) catch e {
    for want of wants {
      if (contains(e.message(), "x509: ${want}")) {
        return
      }
    }
    panic("expected an x509 failure from ${join(wants, " | ")}, got: ${e.message()}")
  }
  c.close()
  panic("connect succeeded, expected a TLS failure from ${join(wants, " | ")}")
}

test "live: TLS connects when Options.tlsRootCa is the CA that signed the server" {
  if (!tlsLive()) {
    return
  }
  let opts = tlsOptions()
  opts.tlsRootCa = env("REDIS_TEST_TLS_CA")
  let c = connect(opts) catch e {
    panic("connect with the signing CA: ${e.message()}")
  }
  c.set("bit:live:tls", "verified") catch e {
    panic("set: ${e.message()}")
  }
  let got = c.get("bit:live:tls") catch e {
    panic("get: ${e.message()}")
  }
  match (got) {
    Some(v) => assert(v == "verified", "GET returned '${v}'")
    None => panic("GET returned no value for a key just SET")
  }
  c.close()
}

test "live: TLS with insecureSkipVerify reaches the same server" {
  if (!tlsLive()) {
    return
  }
  let opts = tlsOptions()
  opts.insecureSkipVerify = true
  let c = connect(opts) catch e {
    panic("connect with insecureSkipVerify: ${e.message()}")
  }
  let pong = c.ping() catch e {
    panic("ping: ${e.message()}")
  }
  assert(pong == "PONG", "PING replied '${pong}'")
  c.close()
}

test "live: TLS refuses a server not signed by Options.tlsRootCa" {
  if (!tlsLive() || liveUrl("REDIS_TEST_TLS_OTHER_CA") == "") {
    return
  }
  let opts = tlsOptions()
  opts.tlsRootCa = env("REDIS_TEST_TLS_OTHER_CA")
  expectTlsRefused(opts, untrustedRootMessages())
}

test "live: TLS with default verification refuses a CA the OS does not trust" {
  if (!tlsLive()) {
    return
  }
  expectTlsRefused(tlsOptions(), untrustedRootMessages())
}

test "live: TLS refuses a certificate that does not name the requested host" {
  if (!tlsLive()) {
    return
  }
  let opts = tlsOptions()
  opts.tlsRootCa = env("REDIS_TEST_TLS_CA")
  opts.tlsServerName = "wrong.example"
  expectTlsRefused(opts, ["certificate is not valid for hostname wrong.example"])
}

fn legacyClient(u: string): Client {
  let opts = parseUrl(u) catch e {
    panic("parseUrl(${u}): ${e.message()}")
  }
  opts.clientName = "bit-live-v5"
  opts.db = 1
  return connect(opts) catch e {
    panic("connect to Redis 5: ${e.message()}")
  }
}

// The failure text of a raw `HELLO 3` on `c`, or "" if the server took it.
fn helloRefusal(c: Client): string {
  c.command(["HELLO", "3"]) catch e {
    return e.message()
  }
  return ""
}

test "live: a Redis 5 server refuses HELLO and commands still work over RESP2" {
  let u = liveUrl("REDIS_TEST_V5_URL")
  if (u == "") {
    return
  }
  let c = legacyClient(u)
  // The server really is the HELLO-less one the fallback exists for.
  let refusal = helloRefusal(c)
  assert(contains(refusal, "unknown command"), "HELLO on Redis 5: '${refusal}'")
  let info = c.info(InfoSection.Server) catch e {
    panic("info: ${e.message()}")
  }
  assert(contains(info, "redis_version:5."), "not a Redis 5 server: ${info}")
  c.set("bit:live:v5", "resp2") catch e {
    panic("set: ${e.message()}")
  }
  let got = c.get("bit:live:v5") catch e {
    panic("get: ${e.message()}")
  }
  match (got) {
    Some(v) => assert(v == "resp2", "GET returned '${v}'")
    None => panic("GET returned no value for a key just SET")
  }
  c.close()
}

test "live: the RESP2 fallback applies AUTH, CLIENT SETNAME and SELECT" {
  let u = liveUrl("REDIS_TEST_V5_URL")
  if (u == "") {
    return
  }
  let c = legacyClient(u)
  let reply = c.command(["CLIENT", "GETNAME"]) catch e {
    panic("CLIENT GETNAME: ${e.message()}")
  }
  let name = asOptString(reply, "CLIENT GETNAME") catch e {
    panic("CLIENT GETNAME decode: ${e.message()}")
  }
  match (name) {
    Some(s) => assert(s == "bit-live-v5", "CLIENT GETNAME returned '${s}'")
    None => panic("CLIENT GETNAME returned no name, SETNAME never ran")
  }
  c.set("bit:live:v5:select", "db1") catch e {
    panic("set: ${e.message()}")
  }
  let db0 = liveClient(u)
  let seen = db0.get("bit:live:v5:select") catch e {
    panic("get on db 0: ${e.message()}")
  }
  match (seen) {
    Some(v) => panic("db 0 saw db 1's key: '${v}'")
    None => {}
  }
  db0.close()
  c.close()
}

// Redis 5 has no WRONGPASS code: `-ERR invalid password`, which `legacyAuth`
// files as `RedisError.WrongPass` (#7787).
test "live: a wrong password on a Redis 5 server fails with RedisError.WrongPass" {
  let u = liveUrl("REDIS_TEST_V5_URL")
  if (u == "") {
    return
  }
  let c = open(withWrongPassword(u)) catch e {
    match (e) {
      WrongPass(_) => return
      _ => panic("open with a wrong password on Redis 5: expected RedisError.WrongPass, got: ${e.message()}")
    }
  }
  c.close()
  panic("open connected to a Redis 5 server with a wrong password")
}
