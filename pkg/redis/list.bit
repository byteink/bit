// pkg/redis/list.bit — `r.list(key)`: the list handle. Epic
// #6013, #6028: SCAFFOLD ONLY, no commands wired yet (`LPUSH, RPUSH, LPOP, RPOP, LRANGE`, a
// follow-up ticket) — this file exists so later family tickets touch only
// their own file, never `client.bit`. `cmd.bit`'s header is the template:
// one `Cmd<T>` factory per command, called from a method here.
export class List {
  client: Client,
  key: string,
}

// The queued view `Pipeline.list`/`Tx.list` both return — `cmd.bit`'s
// `Batch` is the ONE client-side queue the two executors share, so this
// is the ONLY queued view List needs (`cmd.bit`'s header, point 2).
export class ListBatch {
  batch: Batch,
  key: string,
}
