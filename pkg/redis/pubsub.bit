// pkg/redis/pubsub.bit — `r.subscribe("news")?` / `for msg of ...`. Epic
// #6013, #6028: SCAFFOLD ONLY, an empty `Subscription` for a follow-up
// ticket to fill in against `PSUBSCRIBE`/`SSUBSCRIBE` and RESP3 `Push`
// replies (`resp3.bit`'s `Reply.Push`). Not wired to `Client` yet — no
// `subscribe`/`psubscribe` method exists until that ticket lands, so this
// file has nothing to test beyond compiling.
//
// Per epic #6013's SPINE DECISIONS comment (5): iterated with `for msg of`
// via `next(): Option<Message>` (a class with that method satisfies Bit's
// iterator trait, #6014 probe d), and separately exposes `messages(): chan
// <Message>` for select-style use alongside other channels.
export class Message { export channel: string, export payload: string }

export class Subscription {
  client: Client,
}
