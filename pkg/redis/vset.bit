// pkg/redis/vset.bit — `r.vset(key)`: the vector-set handle. Epic
// #6013, #6028: SCAFFOLD ONLY, no commands wired yet (`VADD, VSIM, VREM (Redis 8's vector sets)`, a
// follow-up ticket) — this file exists so later family tickets touch only
// their own file, never `client.bit`. `cmd.bit`'s header is the template:
// one `Cmd<T>` factory per command, called from a method here.
export class VectorSet {
  client: Client,
  key: string,
}
