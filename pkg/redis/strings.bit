// pkg/redis/strings.bit — `r.str(key)`: the plain-string handle. Epic
// #6013, #6028: SCAFFOLD ONLY, no commands wired yet (`APPEND, STRLEN, GETRANGE, SETRANGE, GETSET, INCRBYFLOAT`, a
// follow-up ticket) — this file exists so later family tickets touch only
// their own file, never `client.bit`. `cmd.bit`'s header is the template:
// one `Cmd<T>` factory per command, called from a method here.
export class Str {
  client: Client,
  key: string,
}
