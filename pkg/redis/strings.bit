// pkg/redis/strings.bit — `r.str(key)`: the plain-string command surface
// beyond `Client.set`/`get` (`client.bit`, #6034) — `GETEX`, `GETDEL`,
// `APPEND`, `STRLEN`, `GETRANGE`, `SETRANGE`, `LCS`. Epic #6013, #6028,
// #6034. Follows `cmd.bit`'s HOW-TO header and `counter.bit`'s reference
// shape: one `Cmd<T>` factory per command, an immediate method on `Str`, a
// queued method on `StrBatch`.
//
// `INCRBYFLOAT` LIVES ON `counter.bit`, NOT HERE, despite being a plain-
// string command — `r.counter(k).incrByFloat(...)` reads as "grow this
// counter" on the same key `incr`/`incrBy` already use, not a second handle
// a caller would need to open just for one method. `counter.bit`'s own
// header names this the one cross-family exception.
//
// `MGET`/`MSET`/`MSETNX` LIVE ON `keys.bit`, NOT HERE — they have no single
// "primary" key the way `r.str(key)`'s other methods below all take
// `this.key` as their one operand; `Keys` (`r.keys()`) is already this
// package's namespace-style handle with no bound key of its own (`SCAN`
// lives there for the identical reason), so the multi-key string commands
// join it there instead of being bolted onto a handle whose `this.key`
// they would just ignore. `keys.bit`'s own header repeats this from that
// file's side.
//
// `Str` HOLDS `runner: Runner` (`cmd.bit`'s HOW-TO header, #6029):
// `r.str(key)` runs over the pool, `tx.read.str(key)` over a transaction
// attempt's own pinned connection (`tx.bit`'s header), where the read
// commands (`strLen`, `getRange`, `lcs`, `lcsLen`) see the keys the
// transaction `WATCH`es. A write there (`getEx`, `getDel`, `append`,
// `setRange`) is refused (`runPinnedCmd`, `cmd.bit`): queue it with
// `tx.str(key)`.
//
// `LCS` IS THE PLAIN MATCH AND `LEN` FORMS ONLY (`lcs`/`lcsLen`) — `LCS key1
// key2 IDX [MINMATCHLEN n] [WITHMATCHLEN]` returns a nested match-position
// structure with no natural typed shape yet (a `[]MapEntry`-driven decode
// this ticket's scope did not need); the two forms here cover "give me the
// matched text" and "give me its length", the common cases, and a follow-up
// can add `lcsIdx` alongside them without touching either of these.

export class Str {
  runner: Runner
  key: string

  // `GETEX key [PX ms|PERSIST]` — reads the value and optionally changes its
  // TTL in the same round trip, never both a TTL and `PERSIST` at once
  // (`getExArgs` below sends `PERSIST` and returns before it would ever
  // consider `ttl`). `ttl` is nanoseconds, same convention as `Client.set`.
  export getEx(ttl: int = 0, persist: bool = false): Option<string>!RedisError {
    return this.runner.runCmd(getExCmd(this.key, ttl, persist))?
  }

  // `GETDEL key` — reads and removes the key atomically.
  export getDel(): Option<string>!RedisError {
    return this.runner.runCmd(getDelCmd(this.key))?
  }

  // `APPEND key value` — creates the key first if it did not exist; returns
  // the value's length AFTER the append.
  export append(value: string): i64!RedisError {
    return this.runner.runCmd(appendCmd(this.key, value))?
  }

  // `STRLEN key` — `0` for a missing key, the same convention `HSTRLEN`
  // uses for a missing field.
  export strLen(): i64!RedisError {
    return this.runner.runCmd(strLenCmd(this.key))?
  }

  // `GETRANGE key start stop` — a 0-indexed, inclusive substring; a negative
  // index counts from the end, same as Redis's own convention. Returns `""`
  // (never fails) when the key is missing or the range is empty.
  export getRange(start: i64, stop: i64): string!RedisError {
    return this.runner.runCmd(getRangeCmd(this.key, start, stop))?
  }

  // `SETRANGE key offset value` — overwrites starting at `offset`, zero-
  // padding the gap if `offset` is past the current length; returns the
  // value's length after the write.
  export setRange(offset: i64, value: string): i64!RedisError {
    return this.runner.runCmd(setRangeCmd(this.key, offset, value))?
  }

  // `LCS key otherKey` — the longest common subsequence of the two keys'
  // values, as a string; `""` if they share nothing (or either is missing).
  export lcs(otherKey: string): string!RedisError {
    return this.runner.runCmd(lcsCmd(this.key, otherKey))?
  }

  // `LCS key otherKey LEN` — the match's length only, without building the
  // string itself; cheaper when a caller only needs "how similar".
  export lcsLen(otherKey: string): i64!RedisError {
    return this.runner.runCmd(lcsLenCmd(this.key, otherKey))?
  }
}

// The queued view `Pipeline.str`/`Tx.str` both return — `cmd.bit`'s `Batch`
// is the ONE client-side queue the two executors share, so this is the
// ONLY queued view `Str` needs (`cmd.bit`'s header, point 2).
export class StrBatch {
  batch: Batch
  key: string

  export getEx(ttl: int = 0, persist: bool = false): Future<Option<string>> {
    return this.batch.queue(getExCmd(this.key, ttl, persist))
  }
  export getDel(): Future<Option<string>> { return this.batch.queue(getDelCmd(this.key)) }
  export append(value: string): Future<i64> { return this.batch.queue(appendCmd(this.key, value)) }
  export strLen(): Future<i64> { return this.batch.queue(strLenCmd(this.key)) }
  export getRange(start: i64, stop: i64): Future<string> {
    return this.batch.queue(getRangeCmd(this.key, start, stop))
  }
  export setRange(offset: i64, value: string): Future<i64> {
    return this.batch.queue(setRangeCmd(this.key, offset, value))
  }
  export lcs(otherKey: string): Future<string> {
    return this.batch.queue(lcsCmd(this.key, otherKey))
  }
  export lcsLen(otherKey: string): Future<i64> {
    return this.batch.queue(lcsLenCmd(this.key, otherKey))
  }
}

fn getExArgs(key: string, ttl: int, persist: bool): []string {
  let args = ["GETEX", key]
  if (persist) {
    args = append(args, "PERSIST")
    return args
  }
  if (ttl > 0) {
    args = append(args, "PX", "${ttl / Millisecond}")
  }
  return args
}

fn getExCmd(key: string, ttl: int, persist: bool): Cmd<Option<string>> {
  return Cmd<Option<string>>{
    args = getExArgs(key, ttl, persist),
    decode = (r) => asOptString(r, "GETEX"),
    readOnly = false,
  }
}

fn getDelCmd(key: string): Cmd<Option<string>> {
  return Cmd<Option<string>>{
    args = ["GETDEL", key],
    decode = (r) => asOptString(r, "GETDEL"),
    readOnly = false,
  }
}

fn appendCmd(key: string, value: string): Cmd<i64> {
  return Cmd<i64>{
    args = ["APPEND", key, value],
    decode = (r) => asInt(r, "APPEND"),
    readOnly = false,
  }
}

fn strLenCmd(key: string): Cmd<i64> {
  return Cmd<i64>{ args = ["STRLEN", key], decode = (r) => asInt(r, "STRLEN"), readOnly = true }
}

fn getRangeCmd(key: string, start: i64, stop: i64): Cmd<string> {
  return Cmd<string>{
    args = ["GETRANGE", key, "${start}", "${stop}"],
    decode = (r) => replyToString(r, "GETRANGE"),
    readOnly = true,
  }
}

fn setRangeCmd(key: string, offset: i64, value: string): Cmd<i64> {
  return Cmd<i64>{
    args = ["SETRANGE", key, "${offset}", value],
    decode = (r) => asInt(r, "SETRANGE"),
    readOnly = false,
  }
}

fn lcsCmd(key: string, otherKey: string): Cmd<string> {
  return Cmd<string>{
    args = ["LCS", key, otherKey],
    decode = (r) => replyToString(r, "LCS"),
    readOnly = true,
  }
}

fn lcsLenCmd(key: string, otherKey: string): Cmd<i64> {
  return Cmd<i64>{
    args = ["LCS", key, otherKey, "LEN"],
    decode = (r) => asInt(r, "LCS"),
    readOnly = true,
  }
}
