// pkg/redis/list.test.bit - `list.bit`'s wire-arg builders, reply decoders
// and the blocking-call path, tested without a Redis server: plain arguments
// and `Reply` values, plus one fake local server for `runBlocking`
// (`client.test.bit`'s shape). `list.live.test.bit` runs the same commands
// against a real server.

fn listBulk(s: string): Reply { return Reply.Bulk(Option.Some(s)) }

fn listArr(items: []Reply): Reply { return Reply.Array(Option.Some(items)) }

fn argsEq(got: []string, want: []string): bool {
  if (len(got) != len(want)) {
    return false
  }
  let i = 0
  while (i < len(want)) {
    if (got[i] != want[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

fn joined(a: []string): string {
  let out = ""
  let i = 0
  while (i < len(a)) {
    out = "${out}${a[i]} "
    i = i + 1
  }
  return out
}

fn assertArgs(got: []string, want: []string) {
  assert(argsEq(got, want), "args = [${joined(got)}], want [${joined(want)}]")
}

test "listArgs lays out head, key, others, tail in that order" {
  assertArgs(
    listArgs(["BLMPOP", "1.5", "3"], "a", ["b", "c"], ["LEFT"]),
    [
      "BLMPOP", "1.5", "3", "a", "b", "c", "LEFT",
    ],
  )
  assertArgs(listArgs(["LLEN"], "a", []string(0), []string(0)), ["LLEN", "a"])
}

test "push commands send every value in order, to the right end" {
  assertArgs(listPushCmd("RPUSH", "q", ["a", "b"]).args, ["RPUSH", "q", "a", "b"])
  assertArgs(listPushCmd("LPUSH", "q", ["a"]).args, ["LPUSH", "q", "a"])
  assertArgs(listPushCmd("RPUSHX", "q", ["a"]).args, ["RPUSHX", "q", "a"])
  assertArgs(listPushCmd("LPUSHX", "q", ["a"]).args, ["LPUSHX", "q", "a"])
}

test "pop commands send a count only for the many form" {
  assertArgs(listPopCmd("LPOP", "q").args, ["LPOP", "q"])
  assertArgs(listPopManyCmd("RPOP", "q", 3).args, ["RPOP", "q", "3"])
}

test "range, len, index, set, trim, remove and insert wire forms" {
  assertArgs(listRangeCmd("q", 0, -1).args, ["LRANGE", "q", "0", "-1"])
  assertArgs(listLenCmd("q").args, ["LLEN", "q"])
  assertArgs(listIndexCmd("q", -2).args, ["LINDEX", "q", "-2"])
  assertArgs(listSetCmd("q", 1, "v").args, ["LSET", "q", "1", "v"])
  assertArgs(listTrimCmd("q", 1, 5).args, ["LTRIM", "q", "1", "5"])
  assertArgs(listRemoveCmd("q", -2, "x").args, ["LREM", "q", "-2", "x"])
  assertArgs(listInsertCmd("q", "p", "v", false).args, ["LINSERT", "q", "BEFORE", "p", "v"])
  assertArgs(listInsertCmd("q", "p", "v", true).args, ["LINSERT", "q", "AFTER", "p", "v"])
}

test "LPOS leaves out RANK at 0, MAXLEN at 0 and COUNT for the single form" {
  assertArgs(listPositionCmd("q", "x", 0, 0).args, ["LPOS", "q", "x"])
  assertArgs(
    listPositionCmd("q", "x", -1, 10).args,
    ["LPOS", "q", "x", "RANK", "-1", "MAXLEN", "10"],
  )
  assertArgs(listPositionsCmd("q", "x", 0, 0, 0).args, ["LPOS", "q", "x", "COUNT", "0"])
  assertArgs(
    listPositionsCmd("q", "x", 2, 2, 5).args,
    ["LPOS", "q", "x", "RANK", "2", "COUNT", "2", "MAXLEN", "5"],
  )
}

test "move commands name both ends, LEFT for Front and RIGHT for Back" {
  assertArgs(
    listMoveCmd("a", "b", ListEnd.Back, ListEnd.Front).args,
    ["LMOVE", "a", "b", "RIGHT", "LEFT"],
  )
  assertArgs(
    listBlockMoveCmd("a", "b", ListEnd.Front, ListEnd.Back, 2500000000).args,
    ["BLMOVE", "a", "b", "LEFT", "RIGHT", "2.500"],
  )
}

test "LMPOP counts the handle's key and sends the end and COUNT last" {
  assertArgs(
    listPopAnyCmd("a", ["b"], ListEnd.Front, 2).args,
    ["LMPOP", "2", "a", "b", "LEFT", "COUNT", "2"],
  )
  assertArgs(
    listBlockPopAnyCmd("a", []string(0), ListEnd.Back, 1, 1000000000).args,
    ["BLMPOP", "1", "1", "a", "RIGHT", "COUNT", "1"],
  )
}

test "BLPOP and BRPOP put the timeout after the last key" {
  assertArgs(listBlockPopCmd("BLPOP", "a", ["b"], 5000000000).args, ["BLPOP", "a", "b", "5"])
  assertArgs(listBlockPopCmd("BRPOP", "a", []string(0), 0).args, ["BRPOP", "a", "0"])
}

test "blockSeconds sends whole milliseconds and never turns a wait into forever" {
  assert(blockSeconds(0) == "0", "0 = '${blockSeconds(0)}'")
  assert(blockSeconds(2 * Second) == "2", "2s = '${blockSeconds(2 * Second)}'")
  assert(
    blockSeconds(1500 * Millisecond) == "1.500",
    "1500ms = '${blockSeconds(1500 * Millisecond)}'",
  )
  assert(
    blockSeconds(2005 * Millisecond) == "2.005",
    "2005ms = '${blockSeconds(2005 * Millisecond)}'",
  )
  assert(blockSeconds(250 * Millisecond) == "0.250", "250ms = '${blockSeconds(250 * Millisecond)}'")
  assert(blockSeconds(7) == "0.001", "7ns = '${blockSeconds(7)}'")
  assert(blockSeconds(-5) == "-1", "negative = '${blockSeconds(-5)}'")
}

test "blockDeadline adds commandTimeout to a finite block and drops it for forever" {
  assert(blockDeadline(2 * Second, 5 * Second) == 7 * Second, "finite block")
  assert(blockDeadline(0, 5 * Second) == 0, "forever has no deadline")
  assert(blockDeadline(2 * Second, 0) == 0, "no commandTimeout means no deadline")
}

test "the retry policy: reads retry, every pop and push never does" {
  assert(listRangeCmd("q", 0, -1).readOnly, "LRANGE is a read")
  assert(listLenCmd("q").readOnly, "LLEN is a read")
  assert(listIndexCmd("q", 0).readOnly, "LINDEX is a read")
  assert(listPositionCmd("q", "x", 0, 0).readOnly, "LPOS is a read")
  assert(!listPushCmd("RPUSH", "q", ["a"]).readOnly, "RPUSH writes")
  assert(!listPopCmd("LPOP", "q").readOnly, "LPOP removes")
  assert(!listMoveCmd("a", "b", ListEnd.Front, ListEnd.Back).readOnly, "LMOVE writes")
  assert(!listBlockPopCmd("BLPOP", "a", []string(0), 0).readOnly, "BLPOP removes")
}

test "asListItems reads a null as no items and an array as its strings" {
  let none = asListItems(Reply.Null, "LPOP") catch e {
    panic("null: ${e.message()}")
  }
  assert(len(none) == 0, "null decoded to ${len(none)} items")
  let got = asListItems(listArr([listBulk("a"), listBulk("b")]), "LPOP") catch e {
    panic("array: ${e.message()}")
  }
  assert(len(got) == 2 && got[1] == "b", "got ${len(got)} items")
}

test "asOptInt decodes an index, a null and refuses anything else" {
  let hit = asOptInt(Reply.Int(4), "LPOS") catch e {
    panic("int: ${e.message()}")
  }
  assert(isSome(hit) && unwrap(hit) == 4, "LPOS hit")
  let miss = asOptInt(Reply.Null, "LPOS") catch e {
    panic("null: ${e.message()}")
  }
  assert(isNone(miss), "LPOS miss should be None")
  let failed = false
  let _ = asOptInt(listBulk("x"), "LPOS") catch _ {
    failed = true
    Option.None
  }
  assert(failed, "a bulk reply is not an index")
}

test "asInts decodes LPOS COUNT's array, an empty one included" {
  let got = asInts(listArr([Reply.Int(1), Reply.Int(5)]), "LPOS") catch e {
    panic("asInts: ${e.message()}")
  }
  assert(len(got) == 2 && got[0] == 1 && got[1] == 5, "got ${len(got)} indexes")
  let none = asInts(listArr([]Reply(0)), "LPOS") catch e {
    panic("asInts empty: ${e.message()}")
  }
  assert(len(none) == 0, "empty array decoded to ${len(none)}")
}

test "asListPopped decodes a pair, and a RESP3 or RESP2 null is a timeout" {
  let got = asListPopped(listArr([listBulk("q"), listBulk("job")]), "BLPOP") catch e {
    panic("pair: ${e.message()}")
  }
  assert(isSome(got), "pair should decode to Some")
  assert(unwrap(got).key == "q" && unwrap(got).value == "job", "popped = ${unwrap(got).key}")
  let resp3 = asListPopped(Reply.Null, "BLPOP") catch e {
    panic("null: ${e.message()}")
  }
  assert(isNone(resp3), "RESP3 null is a timeout")
  let resp2 = asListPopped(Reply.Array(Option.None), "BLPOP") catch e {
    panic("null array: ${e.message()}")
  }
  assert(isNone(resp2), "RESP2 null array is a timeout")
}

test "asListPopped refuses a pair of the wrong length" {
  let failed = false
  let _ = asListPopped(listArr([listBulk("q")]), "BLPOP") catch _ {
    failed = true
    Option.None
  }
  assert(failed, "a one-element reply is malformed")
}

test "asListPoppedMany decodes the key and its elements, null is None" {
  let r = listArr([listBulk("q"), listArr([listBulk("a"), listBulk("b")])])
  let got = asListPoppedMany(r, "LMPOP") catch e {
    panic("asListPoppedMany: ${e.message()}")
  }
  assert(isSome(got), "should be Some")
  let m = unwrap(got)
  assert(
    m.key == "q" && len(m.values) == 2 && m.values[1] == "b",
    "key = ${m.key}, ${len(m.values)} values",
  )
  let none = asListPoppedMany(Reply.Null, "LMPOP") catch e {
    panic("null: ${e.message()}")
  }
  assert(isNone(none), "null is None")
}

// A fake server for one blocking call. `connect` dials a probe connection
// and a pool connection (`client.test.bit`'s `serveOnce`); the blocking call
// dials a THIRD, its own. Every connection is acked `HELLO`; a connection
// that sends a command gets `reply` after `delayNs`, which `blockedOn` then
// reports (the command's first word), so the test can prove the command ran
// on a new connection and was answered late. Bounded: 3 accepts.
fn serveBlocking(l: Listener, reply: string, delayNs: int, seen: chan<string>) {
  let i = 0
  while (i < 3) {
    i = i + 1
    let c = l.accept() catch _ {
      seen <- ""
      return
    }
    c.read(4096)
    c.write("%0\r\n") catch _ {
      c.close()
      continue
    }
    let req = c.read(4096)
    if (len(req) == 0) {
      c.close()
      continue
    }
    sleep(delayNs)
    c.write(reply) catch _ {
      c.close()
      seen <- ""
      return
    }
    c.close()
    seen <- req
    return
  }
  seen <- ""
}

fn dialBlockingFake(
  reply: string,
  delayNs: int,
  commandTimeoutNs: int,
): (Client, chan<string>, Listener) {
  let l = listen("127.0.0.1", 0) catch e {
    panic("listen: ${e.message()}")
  }
  let port = l.port() catch e {
    panic("port: ${e.message()}")
  }
  let seen = chan<string>(1)
  spawn serveBlocking(l, reply, delayNs, seen)
  let client = connect(Options{ host = "127.0.0.1", port = port, commandTimeout = commandTimeoutNs }) catch e {
    panic("connect: ${e.message()}")
  }
  return client, seen, l
}

test "a blocking pop outlives commandTimeout and returns the popped pair" {
  // The server answers after 300ms; commandTimeout is 100ms, so only the
  // extended deadline (timeout + commandTimeout) lets this succeed.
  let (client, seen, l) = dialBlockingFake(
    "*2\r\n\$1\r\nq\r\n\$3\r\njob\r\n",
    300 * Millisecond,
    100 * Millisecond,
  )
  let got = client.list("q").blockPopFront(2 * Second) catch e {
    panic("blockPopFront: ${e.message()}")
  }
  client.close()
  let req = <- seen
  l.close()
  assert(contains(req, "BLPOP"), "server saw '${req}'")
  assert(isSome(got), "expected Some, got a timeout")
  assert(unwrap(got).key == "q" && unwrap(got).value == "job", "popped '${unwrap(got).value}'")
}

test "a blocking pop whose block elapses is None, not an error" {
  let (client, seen, l) = dialBlockingFake("*-1\r\n", 50 * Millisecond, 100 * Millisecond)
  let got = client.list("q").blockPop(1 * Second) catch e {
    panic("blockPop: ${e.message()}")
  }
  client.close()
  <- seen
  l.close()
  assert(isNone(got), "a null reply is a timeout, expected None")
}

test "a server that never answers fails Timeout once timeout plus commandTimeout passes" {
  let (client, _, l) = dialBlockingFake("*-1\r\n", 3 * Second, 100 * Millisecond)
  let failed = false
  let _ = client.list("q").blockPop(200 * Millisecond) catch e {
    failed = e.message() == "redis: timeout"
    Option.None
  }
  client.close()
  l.close()
  assert(failed, "expected RedisError.Timeout from a silent server")
}

test "positions with a negative count fails Invalid naming count and sends nothing" {
  // `serveBlocking` reports the first command a connection sends, or "" when
  // none ever does: "" proves the refusal came before the wire.
  let (client, seen, l) = dialBlockingFake("*0\r\n", 0, 100 * Millisecond)
  let msg = ""
  let _ = client.list("q").positions("x", count = -1) catch e {
    msg = e.message()
    []i64(0)
  }
  client.close()
  l.close()
  let req = <- seen
  assert(msg == "redis: invalid argument: count must be >= 0, got -1", "error = '${msg}'")
  assert(req == "", "positions sent '${req}' before refusing")
}

// A fake server for one pipelined batch: acks `HELLO` on each connection,
// reads until the batch's last command (`LLEN`) has arrived, answers `reply`
// and reports every byte the batch sent. Bounded: 3 accepts, 16 reads.
fn servePipeline(l: Listener, reply: string, seen: chan<string>) {
  let i = 0
  while (i < 3) {
    i = i + 1
    let c = l.accept() catch _ {
      seen <- ""
      return
    }
    c.read(4096)
    c.write("%0\r\n") catch _ {
      c.close()
      continue
    }
    let req = c.read(4096)
    let reads = 0
    while (len(req) > 0 && !contains(req, "LLEN") && reads < 16) {
      req = "${req}${c.read(4096)}"
      reads = reads + 1
    }
    if (len(req) == 0) {
      c.close()
      continue
    }
    c.write(reply) catch _ {
      c.close()
      seen <- ""
      return
    }
    c.close()
    seen <- req
    return
  }
  seen <- ""
}

test "a batched positions with a negative count is a failed Future and never queued" {
  let l = listen("127.0.0.1", 0) catch e {
    panic("listen: ${e.message()}")
  }
  let port = l.port() catch e {
    panic("port: ${e.message()}")
  }
  let seen = chan<string>(1)
  spawn servePipeline(l, ":1\r\n:7\r\n", seen)
  let client = connect(Options{ host = "127.0.0.1", port = port, commandTimeout = 1 * Second }) catch e {
    panic("connect: ${e.message()}")
  }
  let p = client.pipeline()
  let first = p.list("q").push("a")
  let bad = p.list("q").positions("x", count = -1)
  let last = p.list("q").len()
  p.exec() catch e {
    panic("exec: ${e.message()}")
  }
  let a = first.get() catch e {
    panic("push: ${e.message()}")
  }
  let n = last.get() catch e {
    panic("len: ${e.message()}")
  }
  let msg = ""
  let _ = bad.get() catch e {
    msg = e.message()
    []i64(0)
  }
  client.close()
  let req = <- seen
  l.close()
  assert(
    req == "*3\r\n\$5\r\nRPUSH\r\n\$1\r\nq\r\n\$1\r\na\r\n*2\r\n\$4\r\nLLEN\r\n\$1\r\nq\r\n",
    "wire = '${req}'",
  )
  assert(a == 1 && n == 7, "futures read ${a} and ${n}")
  assert(msg == "redis: invalid argument: count must be >= 0, got -1", "error = '${msg}'")
}
