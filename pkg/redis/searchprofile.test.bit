// Private FT.PROFILE SEARCH boundary from the Redis command reference.
// Inner replies stay opaque because profile details vary by server version.

test "FT.PROFILE SEARCH wire preserves raw bytes and read-only classification" {
  let cmd = profileSearchCmd("idx\x00\r\n", rawQuery("@name:{a b}\x00"), SearchOptions{}, false)
  assertArgs(cmd.args, ["FT.PROFILE", "idx\x00\r\n", "SEARCH", "QUERY", "@name:{a b}\x00"])
  assert(cmd.readOnly, "profiling SEARCH is read-only")
}

test "FT.PROFILE LIMITED retains search options and explicit DIALECT order" {
  let o = SearchOptions{
    noContent = true,
    withScores = true,
    returns = [Returned{ field = "name", alias = "title" }],
    sortBy = Option.Some(SortBy{ field = "price", desc = true, withCount = true }),
    page = Option.Some(Page{ offset = 4, num = 8 }),
    params = [Field{ name = "price", value = "12" }],
    dialect = Option.Some(4),
  }
  assertArgs(
    profileSearchCmd("i", rawQuery("@price:[$price +inf]"), o, true).args,
    [
      "FT.PROFILE", "i", "SEARCH", "LIMITED", "QUERY", "@price:[$price +inf]", "NOCONTENT",
      "WITHSCORES", "RETURN", "3", "name", "AS", "title", "SORTBY", "price", "DESC", "WITHCOUNT",
      "LIMIT", "4", "8", "PARAMS", "2", "price", "12", "DIALECT", "4",
    ],
  )
}

test "FT.PROFILE typed query retains PARAMS bytes and automatic DIALECT" {
  let q = knn("embedding", [1.0], 3, everything(), "distance")
  assertArgs(
    profileSearchCmd("i", q, SearchOptions{}, false).args,
    [
      "FT.PROFILE", "i", "SEARCH", "QUERY", "*=>[KNN 3 @embedding $knnvec AS distance]",
      "PARAMS", "2", "knnvec", "\x00\x00\x80\x3f", "DIALECT", "2",
    ],
  )
}

fn assertProfileTrees(decoded: SearchProfile) {
  let hits = replyItems(decoded.results, "fixture") catch e {
    panic(e.message())
  }
  assert(len(hits) == 3, "result shape unchanged")
  assert(
      (asInt(hits[0], "fixture") catch _ {
        -1
      }) ==
      1,
    "result total unchanged",
  )
  assert(
      (replyToString(hits[1], "fixture") catch _ {
        ""
      }) ==
      "doc\x00\xff",
    "document bytes unchanged",
  )
  assert(isNullReply(hits[2]), "null result member unchanged")
  assertProfileMap(decoded.profile)
}

fn assertProfileMap(profile: Reply) {
  match (profile) {
    Map(entries) => {
      assert(len(entries) == 1, "profile pair count unchanged")
      assert(
          (replyToString(entries[0].key, "fixture") catch _ {
            ""
          }) ==
          "Timing",
        "key unchanged",
      )
      match (entries[0].value) {
        Attribute(attrs, inner) => {
          assert(len(attrs) == 1, "nested attributes retained")
          assert(
              (replyToString(attrs[0].value, "fixture") catch _ {
                ""
              }) ==
              "meta\x00",
            "attribute bytes",
          )
          assert(
              (asDouble(inner, "fixture") catch _ {
                -1.0
              }) ==
              0.125,
            "profile value unchanged",
          )
        }
        _ => panic("profile attributes lost")
      }
    }
    _ => panic("profile map lost")
  }
}

fn profileFixture(): Reply {
  return Reply.Map(
    [spair("Timing", Reply.Attribute([spair("source", sbulk("meta\x00"))], Reply.Double(0.125)))],
  )
}

fn profileResultsFixture(): Reply { return arr([Reply.Int(1), sbulk("doc\x00\xff"), Reply.Null]) }

test "FT.PROFILE RESP2 pair retains opaque nested replies" {
  let decoded = asSearchProfile(
    arr([profileResultsFixture(), profileFixture()]),
  ) catch e {
    panic(e.message())
  }
  assertProfileTrees(decoded)
  let empty = asSearchProfile(arr([arr([Reply.Int(0)]), arr([]Reply(0))])) catch e {
    panic(e.message())
  }
  assert(
    len(
      replyItems(empty.profile, "fixture") catch _ {
        [Reply.Null]
      },
    ) == 0,
    "empty profile is valid",
  )
}

test "FT.PROFILE RESP3 uses exact Results and Profile keys and ignores unknown members" {
  let decoded = asSearchProfile(
    Reply.Map(
      [
        spair("unknown", Reply.Err("opaque")), spair("Profile", profileFixture()),
        spair("Results", profileResultsFixture()),
      ],
    ),
  ) catch e {
    panic(e.message())
  }
  assertProfileTrees(decoded)
}

fn assertProfileFailure(r: Reply, shape: string) {
  let failed = false
  let _ = asSearchProfile(r) catch e {
    failed = true
    match (e) {
      Unexpected(cmd, got) => assert(cmd == "FT.PROFILE" && got == shape, "redacted shape only")
      _ => panic("wrong error kind")
    }
    SearchProfile{ results = Reply.Null, profile = Reply.Null }
  }
  assert(failed, "malformed profile must fail")
}

test "FT.PROFILE rejects wrong outer shapes and pair cardinalities" {
  assertProfileFailure(sbulk("secret reply"), "Bulk")
  assertProfileFailure(Reply.Err("secret server error"), "Err")
  assertProfileFailure(Reply.Null, "Null")
  assertProfileFailure(Reply.Array(Option.None), "Array")
  assertProfileFailure(arr([]Reply(0)), "Array")
  assertProfileFailure(arr([arr([]Reply(0))]), "Array")
  assertProfileFailure(arr([arr([]Reply(0)), arr([]Reply(0)), Reply.Null]), "Array")
}

test "FT.PROFILE rejects missing or duplicate exact map keys" {
  let results = spair("Results", profileResultsFixture())
  let profile = spair("Profile", profileFixture())
  assertProfileFailure(Reply.Map([]MapEntry(0)), "Map")
  assertProfileFailure(Reply.Map([results]), "Map")
  assertProfileFailure(Reply.Map([profile]), "Map")
  assertProfileFailure(Reply.Map([results, results, profile]), "Map")
  assertProfileFailure(Reply.Map([results, profile, profile]), "Map")
  assertProfileFailure(Reply.Map([spair("results", profileResultsFixture()), profile]), "Map")
  assertProfileFailure(Reply.Map([results, spair("profile", profileFixture())]), "Map")
}

test "FT.PROFILE rejects scalar or null profile containers without partial success" {
  for invalid of [
    Reply.Null,
    Reply.Bulk(Option.None),
    sbulk("secret"),
    Reply.Int(1),
    Reply.Array(Option.None),
  ] {
    assertProfileFailure(arr([profileResultsFixture(), invalid]), shapeName(invalid))
    assertProfileFailure(
      Reply.Map([spair("Results", profileResultsFixture()), spair("Profile", invalid)]),
      shapeName(invalid),
    )
  }
}

test "FT.PROFILE public result decodes search options and preserves profile details" {
  let cmd = profileSearchCmd("i", everything(), SearchOptions{ noContent = true }, false)
  let r = cmd.decode(arr([arr([Reply.Int(1), sbulk("doc\x00\xff")]), profileFixture()])) catch e {
    panic(e.message())
  }
  assert(r.result.total == 1 && len(r.result.hits) == 1, "typed result cardinality")
  assert(r.result.hits[0].id == "doc\x00\xff", "typed result preserves id bytes")
  assert(len(r.result.hits[0].fields) == 0, "NOCONTENT forwarded to decoder")
  assertProfileMap(r.profile)
}

test "FT.PROFILE public result rejects malformed SEARCH before partial success" {
  for invalid of [Reply.Null, sbulk("secret"), arr([Reply.Int(1)]), arr([sbulk("bad total")])] {
    let failed = false
    let _ = asProfileResult(arr([invalid, profileFixture()]), SearchOptions{}) catch _ {
      failed = true
      ProfileResult{ result = SearchResult{ total = 0, hits = []Hit(0) }, profile = Reply.Null }
    }
    assert(failed, "malformed SEARCH result must fail")
  }
}
