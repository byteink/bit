// pkg/redis/hll.bit - `r.hll(key)`: HyperLogLog, `PFADD`, `PFCOUNT` and
// `PFMERGE`. Epic #6013, #6028, #6036. Follows `cmd.bit`'s HOW-TO header and
// `counter.bit`'s shape: one `Cmd<T>` factory per command, an immediate
// method on `Hll`, a queued one on `HllBatch`.
//
// A HyperLogLog counts DISTINCT elements in about 12 KB however many there
// are, with a standard error of 0.81%. It cannot list its elements or remove
// one. The key is a plain string underneath, so `TYPE` says `string`.
//
// `Hll` HOLDS `client: Client`, NOT `runner: Runner`, as `zset.bit` does:
// `runner` needs `client.bit`'s `hll()` accessor and a `TxRead.hll` on
// `tx.bit` to change, outside this ticket's files (#6036).
//
// THE HANDLE'S KEY IS THE FIRST (OR ONLY) KEY of every command: `count` adds
// the other keys it should union, `merge` writes into this key from the
// sources it is given. `PFMERGE` also folds the destination's own previous
// content in, so merging twice into one key accumulates.

export class Hll {
  client: Client
  key: string

  // `PFADD`: records the elements; true when the estimate may have changed
  // (some register moved), false when every element was already counted.
  // With no elements it only creates the key.
  export add(...elements: string): bool!RedisError {
    return this.client.runCmd(pfAddCmd(this.key, elements))?
  }
  // `PFCOUNT`: the estimated number of distinct elements in this key, or in
  // the union of this key and `others`. A missing key counts as empty.
  export count(...others: string): i64!RedisError {
    return this.client.runCmd(pfCountCmd(this.key, others))?
  }
  // `PFMERGE`: stores the union of `sources` and this key's own content in
  // this key.
  export merge(...sources: string): ()!RedisError {
    return this.client.runCmd(pfMergeCmd(this.key, sources))?
  }
}

// The queued view `Pipeline.hll`/`Tx.hll` both return.
export class HllBatch {
  batch: Batch
  key: string

  export add(...elements: string): Future<bool> {
    return this.batch.queue(pfAddCmd(this.key, elements))
  }
  export count(...others: string): Future<i64> {
    return this.batch.queue(pfCountCmd(this.key, others))
  }
  export merge(...sources: string): Future<()> {
    return this.batch.queue(pfMergeCmd(this.key, sources))
  }
}

fn pfAddCmd(key: string, elements: []string): Cmd<bool> {
  return Cmd<bool>{
    args = append(["PFADD", key], ...elements),
    decode = (r) => asBool(r, "PFADD"),
    readOnly = false,
  }
}

// `PFCOUNT` caches its estimate in the key (the server flags it as a write),
// but running it twice returns the same answer, so it is retry-safe.
fn pfCountCmd(key: string, others: []string): Cmd<i64> {
  return Cmd<i64>{
    args = append(["PFCOUNT", key], ...others),
    decode = (r) => asInt(r, "PFCOUNT"),
    readOnly = true,
  }
}

fn pfMergeCmd(dest: string, sources: []string): Cmd<()> {
  return Cmd<()>{
    args = append(["PFMERGE", dest], ...sources),
    decode = (r) => asOk(r, "PFMERGE"),
    readOnly = false,
  }
}
