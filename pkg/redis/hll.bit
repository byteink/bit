// pkg/redis/hll.bit — `r.hll(key)`: the HyperLogLog handle. Epic
// #6013, #6028: SCAFFOLD ONLY, no commands wired yet (`PFADD, PFCOUNT, PFMERGE`, a
// follow-up ticket) — this file exists so later family tickets touch only
// their own file, never `client.bit`. `cmd.bit`'s header is the template:
// one `Cmd<T>` factory per command, called from a method here.
export class Hll {
  client: Client,
  key: string,
}

// The queued view `Pipeline.hll`/`Tx.hll` both return — `cmd.bit`'s
// `Batch` is the ONE client-side queue the two executors share, so this
// is the ONLY queued view Hll needs (`cmd.bit`'s header, point 2).
export class HllBatch {
  batch: Batch,
  key: string,
}
