// pkg/redis/zset.test.bit — the encode/decode helpers and `Cmd<T>` factories
// `zset.bit`/`zsetcmd.bit` build on, tested directly against `Reply` values
// and wire `args`: none of this needs a socket, real or fake (`cmd.test.bit`'s
// own header makes the identical call for the shared decode helpers).

test "scoreArg round-trips a finite score and spells both infinities" {
  assert(scoreArg(42.0) == "42", "scoreArg(42.0) = '${scoreArg(42.0)}'")
  assert(scoreArg(3.5) == "3.5", "scoreArg(3.5) = '${scoreArg(3.5)}'")
  assert(scoreArg(1.0 / 0.0) == "+inf", "scoreArg(+inf) = '${scoreArg(1.0 / 0.0)}'")
  assert(scoreArg(0.0 - 1.0 / 0.0) == "-inf", "scoreArg(-inf) = '${scoreArg(0.0 - 1.0 / 0.0)}'")
}

test "scoreBoundArg spells inclusive, exclusive and unbounded for both ends" {
  assert(
    scoreBoundArg(Bound<f64>.Inclusive(10.0), true) == "10",
    "Inclusive(10.0) min = '${scoreBoundArg(Bound<f64>.Inclusive(10.0), true)}'",
  )
  assert(
    scoreBoundArg(Bound<f64>.Exclusive(10.0), true) == "(10",
    "Exclusive(10.0) min = '${scoreBoundArg(Bound<f64>.Exclusive(10.0), true)}'",
  )
  assert(
    scoreBoundArg(Bound<f64>.Unbounded, true) == "-inf",
    "Unbounded min = '${scoreBoundArg(Bound<f64>.Unbounded, true)}'",
  )
  assert(
    scoreBoundArg(Bound<f64>.Unbounded, false) == "+inf",
    "Unbounded max = '${scoreBoundArg(Bound<f64>.Unbounded, false)}'",
  )
}

test "lexBoundArg spells inclusive, exclusive and unbounded for both ends" {
  assert(
    lexBoundArg(Bound<string>.Inclusive("ada"), true) == "[ada",
    "Inclusive('ada') min = '${lexBoundArg(Bound<string>.Inclusive("ada"), true)}'",
  )
  assert(
    lexBoundArg(Bound<string>.Exclusive("ada"), true) == "(ada",
    "Exclusive('ada') min = '${lexBoundArg(Bound<string>.Exclusive("ada"), true)}'",
  )
  assert(
    lexBoundArg(Bound<string>.Unbounded, true) == "-",
    "Unbounded min = '${lexBoundArg(Bound<string>.Unbounded, true)}'",
  )
  assert(
    lexBoundArg(Bound<string>.Unbounded, false) == "+",
    "Unbounded max = '${lexBoundArg(Bound<string>.Unbounded, false)}'",
  )
}

test "appendLimit omits the clause for noLimit(), includes it otherwise" {
  let bare = appendLimit(["ZRANGE", "k"], noLimit())
  assert(len(bare) == 2, "noLimit() should not append a LIMIT clause, got ${len(bare)}")
  let limited = appendLimit(["ZRANGE", "k"], limitTo(5))
  assert(
    len(limited) == 5 && limited[2] == "LIMIT" && limited[3] == "0" && limited[4] == "5",
    "limitTo(5) = ${limited[2]} ${limited[3]} ${limited[4]}",
  )
}

test "addCmd carries every ZaddOptions flag, in NX/XX/GT/LT/CH order" {
  let cmd = addCmd("board", "ada", 42.0, ZaddOptions{ onlyIfHigher = true, ch = true })
  assert(
    cmd.args[0] == "ZADD" && cmd.args[1] == "board",
    "addCmd base args = ${cmd.args[0]} ${cmd.args[1]}",
  )
  assert(
    cmd.args[2] == "GT" && cmd.args[3] == "CH",
    "addCmd flags = ${cmd.args[2]} ${cmd.args[3]}",
  )
  assert(
    cmd.args[4] == "42" && cmd.args[5] == "ada",
    "addCmd score/member = ${cmd.args[4]} ${cmd.args[5]}",
  )
}

test "addManyCmd interleaves score, member for every pair" {
  let pairs = [Scored{ member = "ada", score = 10.0 }, Scored{ member = "bob", score = 20.0 }]
  let cmd = addManyCmd("board", pairs)
  assert(
    cmd.args[2] == "10" && cmd.args[3] == "ada" && cmd.args[4] == "20" && cmd.args[5] == "bob",
    "addManyCmd args[2:6] = ${cmd.args[2]} ${cmd.args[3]} ${cmd.args[4]} ${cmd.args[5]}",
  )
}

test "rangeByScoreCmd builds BYSCORE with LIMIT and WITHSCORES" {
  let cmd = rangeByScoreCmd(
    "board",
    Bound<f64>.Inclusive(10.0),
    Bound<f64>.Unbounded,
    limitTo(3),
    8010,
  )
  assert(
    cmd.args[0] == "ZRANGE" && cmd.args[4] == "BYSCORE",
    "rangeByScoreCmd args[0], args[4] = ${cmd.args[0]}, ${cmd.args[4]}",
  )
  assert(cmd.args[len(cmd.args) - 1] == "WITHSCORES", "WITHSCORES must be last")
  assert(
    cmd.args[5] == "LIMIT" && cmd.args[7] == "3",
    "LIMIT clause = ${cmd.args[5]} ${cmd.args[6]} ${cmd.args[7]}",
  )
}

test "rangeByLexCmd builds BYLEX with no WITHSCORES" {
  let cmd = rangeByLexCmd(
    "board",
    Bound<string>.Inclusive("a"),
    Bound<string>.Exclusive("z"),
    noLimit(),
  )
  assert(
    cmd.args[2] == "[a" && cmd.args[3] == "(z" && cmd.args[4] == "BYLEX",
    "rangeByLexCmd args[2:5] = ${cmd.args[2]} ${cmd.args[3]} ${cmd.args[4]}",
  )
  let i = 0
  while (i < len(cmd.args)) {
    assert(cmd.args[i] != "WITHSCORES", "ZRANGE BYLEX must never send WITHSCORES")
    i = i + 1
  }
}

test "blockTimeoutArg spells forever as 0 and a duration as whole milliseconds" {
  assert(blockTimeoutArg(0) == "0", "blockTimeoutArg(0) = '${blockTimeoutArg(0)}'")
  assert(
    blockTimeoutArg(0 - 1) == "0",
    "blockTimeoutArg(negative) = '${blockTimeoutArg(0 - 1)}'",
  )
  assert(
    blockTimeoutArg(1500000000) == "1.500",
    "blockTimeoutArg(1.5s) = '${blockTimeoutArg(1500000000)}'",
  )
  assert(blockTimeoutArg(7) == "0.001", "a sub-millisecond block rounds up to 1ms, never 0")
}

test "asOptScore decodes Bulk, RESP3 Double and Null" {
  let fromBulk = asOptScore(Reply.Bulk(Option.Some("3.5")), "ZSCORE") catch e {
    panic("asOptScore: ${e.message()}")
  }
  assert(
    isSome(fromBulk) && unwrap(fromBulk) == 3.5,
    "asOptScore Bulk('3.5') = ${unwrap(fromBulk)}",
  )
  let fromDouble = asOptScore(Reply.Double(9.0), "ZSCORE") catch e {
    panic("asOptScore: ${e.message()}")
  }
  assert(
    isSome(fromDouble) && unwrap(fromDouble) == 9.0,
    "asOptScore Double(9.0) = ${unwrap(fromDouble)}",
  )
  let missing = asOptScore(Reply.Null, "ZSCORE") catch e {
    panic("asOptScore: ${e.message()}")
  }
  assert(isNone(missing), "asOptScore Null should be None")
}

test "asOptScores decodes a mix of present and missing members" {
  let items = [Reply.Bulk(Option.Some("1")), Reply.Null]
  let got = asOptScores(Reply.Array(Option.Some(items)), "ZMSCORE") catch e {
    panic("asOptScores: ${e.message()}")
  }
  assert(len(got) == 2, "expected 2 entries, got ${len(got)}")
  assert(isSome(got[0]) && unwrap(got[0]) == 1.0, "asOptScores[0] = ${unwrap(got[0])}")
  assert(isNone(got[1]), "asOptScores[1] should be None")
}

test "asRankScore decodes [rank, score] and a missing member as None" {
  let items = [Reply.Int(2), Reply.Double(9.5)]
  let got = asRankScore(Reply.Array(Option.Some(items)), "ZRANK") catch e {
    panic("asRankScore: ${e.message()}")
  }
  match (got) {
    Some(pair) => {
      let (rank, score) = pair
      assert(rank == 2 && score == 9.5, "asRankScore = (${rank}, ${score})")
    }
    None => panic("asRankScore on a present member should be Some")
  }
  let missing = asRankScore(Reply.Null, "ZRANK") catch e {
    panic("asRankScore: ${e.message()}")
  }
  assert(isNone(missing), "asRankScore Null should be None")
}

test "asPopped decodes ZMPOP's nested [key, [[member, score], ...]] shape" {
  let pair = Reply.Array(Option.Some([Reply.Bulk(Option.Some("ada")), Reply.Double(42.0)]))
  let outer = Reply.Array(
    Option.Some([Reply.Bulk(Option.Some("board")), Reply.Array(Option.Some([pair]))]),
  )
  let got = asPopped(outer, "ZMPOP") catch e {
    panic("asPopped: ${e.message()}")
  }
  assert(len(got) == 1, "expected 1 popped member, got ${len(got)}")
  assert(
    got[0].member == "ada" && got[0].score == 42.0,
    "asPopped[0] = ${got[0].member}, ${got[0].score}",
  )
  let nilPop = asPopped(Reply.Null, "ZMPOP") catch e {
    panic("asPopped: ${e.message()}")
  }
  assert(len(nilPop) == 0, "asPopped Null should be an empty pop, got ${len(nilPop)}")
}

test "asBlockPopped decodes BZPOPMIN's flat [key, member, score] shape" {
  let items = [Reply.Bulk(Option.Some("board")), Reply.Bulk(Option.Some("ada")), Reply.Double(42.0)]
  let got = asBlockPopped(Reply.Array(Option.Some(items)), "BZPOPMIN") catch e {
    panic("asBlockPopped: ${e.message()}")
  }
  match (got) {
    Some(scored) => {
      assert(
        scored.member == "ada" && scored.score == 42.0,
        "asBlockPopped = ${scored.member}, ${scored.score}",
      )
    }
    None => panic("asBlockPopped on a satisfied pop should be Some")
  }
  let timedOut = asBlockPopped(Reply.Null, "BZPOPMIN") catch e {
    panic("asBlockPopped: ${e.message()}")
  }
  assert(isNone(timedOut), "asBlockPopped Null (timeout) should be None")
}

// A family's queued-view accessor must return a view over the SAME `Batch`
// its owner holds — `cmd.test.bit`'s own check makes this exact case for
// `Tx.counter`; this is its zset counterpart.
test "a Pipeline/Tx zset accessor's queued view shares its owner's Batch" {
  let batch = Batch()
  let view = ZsetBatch{ batch = batch, key = "board" }
  view.top(3)
  assert(
    len(batch.queued) == 1,
    "queuing through a ZsetBatch view should be visible on the owner's batch",
  )
}

test "rankCmd sends ZREVRANK from the top and ZRANK from the bottom" {
  assert(
    rankCmd("k", "m", true, 0).args[0] == "ZREVRANK",
    "fromTop=true must count from the highest score",
  )
  assert(
    rankCmd("k", "m", false, 0).args[0] == "ZRANK",
    "fromTop=false must count from the lowest score",
  )
  assert(
    rankCmd("k", "m", true, 0).args[3] == "WITHSCORE",
    "rank asks for the score in the same call",
  )
}

test "interCardArgs counts the handle's own key in numkeys" {
  let args = interCardArgs("a", ["b", "c"], 0)
  assert(len(args) == 5, "args = ${len(args)}")
  assert(args[0] == "ZINTERCARD" && args[1] == "3", "head = ${args[0]} ${args[1]}")
  assert(args[2] == "a" && args[3] == "b" && args[4] == "c", "keys in order")
}

test "interCardArgs appends LIMIT only when limit is positive" {
  let args = interCardArgs("a", ["b"], 7)
  assert(len(args) == 6, "args = ${len(args)}")
  assert(args[4] == "LIMIT" && args[5] == "7", "tail = ${args[4]} ${args[5]}")
  assert(len(interCardArgs("a", ["b"], 0)) == 4, "limit 0 sends no LIMIT")
  assert(len(interCardArgs("a", ["b"], -1)) == 4, "a negative limit sends no LIMIT")
  assert(interCardCmd("a", ["b"], 0, 0).readOnly, "ZINTERCARD is a read")
}

// A server from 6.2 on, and one whose version is unknown (0), get the
// commands this package always sent.
test "top, bottom and byScore keep ZRANGE REV/BYSCORE from 6.2 and when the version is unknown" {
  for v of [6002, 7002, 8010, 0] {
    assert(
      joined(rangeRankCmd("b", 3, true, v).args) == "ZRANGE b 0 2 REV WITHSCORES ",
      "top at ${v}: ${joined(rangeRankCmd("b", 3, true, v).args)}",
    )
    assert(
      joined(rangeRankCmd("b", 3, false, v).args) == "ZRANGE b 0 2 WITHSCORES ",
      "bottom at ${v}: ${joined(rangeRankCmd("b", 3, false, v).args)}",
    )
    let by = rangeByScoreCmd("b", Bound<f64>.Exclusive(1.0), Bound<f64>.Unbounded, limitTo(2), v)
    assert(
      joined(by.args) == "ZRANGE b (1 +inf BYSCORE LIMIT 0 2 WITHSCORES ",
      "byScore at ${v}: ${joined(by.args)}",
    )
  }
}

test "top, bottom and byScore send ZREVRANGE, ZRANGE and ZRANGEBYSCORE before 6.2" {
  for v of [5000, 6000, 6001] {
    assert(
      joined(rangeRankCmd("b", 3, true, v).args) == "ZREVRANGE b 0 2 WITHSCORES ",
      "top at ${v}: ${joined(rangeRankCmd("b", 3, true, v).args)}",
    )
    assert(
      joined(rangeRankCmd("b", 3, false, v).args) == "ZRANGE b 0 2 WITHSCORES ",
      "bottom at ${v}: ${joined(rangeRankCmd("b", 3, false, v).args)}",
    )
    assert(
      joined(rangeRankCmd("b", 0, true, v).args) == "ZREVRANGE b 1 0 WITHSCORES ",
      "top(0) at ${v} must stay empty: ${joined(rangeRankCmd("b", 0, true, v).args)}",
    )
    let by = rangeByScoreCmd("b", Bound<f64>.Exclusive(1.0), Bound<f64>.Unbounded, limitTo(2), v)
    assert(
      joined(by.args) == "ZRANGEBYSCORE b (1 +inf WITHSCORES LIMIT 0 2 ",
      "byScore at ${v}: ${joined(by.args)}",
    )
    let all = rangeByScoreCmd("b", Bound<f64>.Unbounded, Bound<f64>.Inclusive(5.0), noLimit(), v)
    assert(
      joined(all.args) == "ZRANGEBYSCORE b -inf 5 WITHSCORES ",
      "byScore without a limit at ${v}: ${joined(all.args)}",
    )
  }
}

test "a queued view picks the form for its Batch's server version" {
  let old = Batch(5000)
  let view = ZsetBatch{ batch = old, key = "b" }
  view.top(1)
  view.bottom(1)
  view.byScore(Bound<f64>.Unbounded, Bound<f64>.Unbounded, noLimit())
  assert(old.queued[0][0] == "ZREVRANGE", "queued top = ${old.queued[0][0]}")
  assert(old.queued[1][0] == "ZRANGE" && old.queued[1][4] == "WITHSCORES", "queued bottom")
  assert(old.queued[2][0] == "ZRANGEBYSCORE", "queued byScore = ${old.queued[2][0]}")
  let modern = Batch(7002)
  let mview = ZsetBatch{ batch = modern, key = "b" }
  mview.top(1)
  mview.scores("a")
  assert(modern.queued[0][3] == "0" && modern.queued[0][4] == "REV", "modern top keeps REV")
  assert(modern.queued[1][0] == "ZMSCORE", "modern scores = ${modern.queued[1][0]}")
}

test "a queued scores before 6.2 fails with the version instead of sending ZMSCORE" {
  let old = Batch(5000)
  let f = ZsetBatch{ batch = old, key = "b" }.scores("a", "b")
  assert(len(old.queued) == 0, "nothing may be queued for the refused scores")
  f.get() catch e {
    assert(contains(e.message(), "6.2") && contains(e.message(), "5.0"), "message = ${e.message()}")
    return
  }
  panic("scores before 6.2 should fail")
}

test "preV62 is false for 6.2+ and for an unknown version" {
  assert(preV62(5000) && preV62(6001), "5.0 and 6.1 predate 6.2")
  assert(!preV62(6002) && !preV62(8010) && !preV62(0), "6.2, 8.10 and unknown do not")
}

test "tooOld is false at the minimum, above it and for an unknown version" {
  assert(tooOld(6002, serverV70) && tooOld(7000, serverV72), "6.2 < 7.0 and 7.0 < 7.2")
  assert(!tooOld(7000, serverV70) && !tooOld(7002, serverV72), "the minimum itself is enough")
  assert(!tooOld(0, serverV72) && !tooOld(8010, serverV72), "unknown and newer are enough")
  assert(versionText(5000) == "5.0" && versionText(7002) == "7.2", "versionText")
}

// Commands with no pre-6.2 form fail naming 6.2 and send nothing.
fn expectRefused<T>(name: string, f: Future<T>) {
  f.get() catch e {
    assert(
      contains(e.message(), name) && contains(e.message(), "6.2") && contains(e.message(), "5.0"),
      "${name}: ${e.message()}",
    )
    return
  }
  panic("${name} before 6.2 should fail")
}

test "a queued 6.2-only command fails with the version before 6.2" {
  let old = Batch(5000)
  let z = ZsetBatch{ batch = old, key = "b" }
  expectRefused<[]Scored>("ZDIFF", z.diff(["c"]))
  expectRefused<i64>("ZDIFFSTORE", z.diffStore("d", ["c"]))
  expectRefused<Option<string>>("ZRANDMEMBER", z.randMember())
  expectRefused<[]Scored>("ZRANDMEMBER", z.randMembers(2))
  expectRefused<i64>("ZRANGESTORE", z.storeTop("d", 2))
  expectRefused<i64>("ZRANGESTORE", z.storeBottom("d", 2))
  expectRefused<i64>(
    "ZRANGESTORE",
    z.storeByScore("d", Bound<f64>.Unbounded, Bound<f64>.Unbounded, noLimit()),
  )
  expectRefused<i64>(
    "ZRANGESTORE",
    z.storeByLex("d", Bound<string>.Unbounded, Bound<string>.Unbounded, noLimit()),
  )
  assert(len(old.queued) == 0, "nothing may be queued for a refused command")
}

test "6.2-only commands keep their own form from 6.2 and when the version is unknown" {
  for v of [0, 6002, 8010] {
    let b = Batch(v)
    let z = ZsetBatch{ batch = b, key = "k" }
    z.diff(["c"])
    z.diffStore("d", ["c"])
    z.randMember()
    z.storeTop("d", 2)
    assert(b.queued[0][0] == "ZDIFF", "diff at ${v}: ${b.queued[0][0]}")
    assert(b.queued[1][0] == "ZDIFFSTORE", "diffStore at ${v}: ${b.queued[1][0]}")
    assert(b.queued[2][0] == "ZRANDMEMBER", "randMember at ${v}: ${b.queued[2][0]}")
    assert(b.queued[3][0] == "ZRANGESTORE", "storeTop at ${v}: ${b.queued[3][0]}")
  }
}

test "rank sends one EVAL before 7.2 and WITHSCORE from 7.2" {
  let old = Batch(7000)
  ZsetBatch{ batch = old, key = "k" }.rank("m", true)
  let a = old.queued[0]
  assert(a[0] == "EVAL" && a[2] == "1" && a[3] == "k" && a[4] == "m", "args = ${joined(a)}")
  assert(contains(a[1], "ZREVRANK") && contains(a[1], "ZSCORE"), "script = ${a[1]}")
  ZsetBatch{ batch = old, key = "k" }.rank("m", false)
  assert(contains(old.queued[1][1], "'ZRANK'"), "fromTop=false counts with ZRANK")
  let modern = Batch(7002)
  ZsetBatch{ batch = modern, key = "k" }.rank("m", true)
  assert(
    modern.queued[0][0] == "ZREVRANK" && modern.queued[0][3] == "WITHSCORE",
    "7.2 keeps WITHSCORE",
  )
}

test "union and inter send ZUNION/ZINTER from 6.2 and one scratch-key EVAL before it" {
  let old = Batch(5000)
  let z = ZsetBatch{ batch = old, key = "a" }
  z.union(["b"], [2.0, 3.0], Aggregate.Max)
  let u = old.queued[0]
  assert(u[0] == "EVAL" && u[2] == "3", "numkeys counts the scratch key: ${joined(u)}")
  assert(u[3] == "bit:zsetop:a" && u[4] == "a" && u[5] == "b", "keys = ${joined(u)}")
  assert(joined(u[6:len(u)]) == "WEIGHTS 2 3 AGGREGATE MAX ", "tail = ${joined(u[6:len(u)])}")
  assert(contains(u[1], "ZUNIONSTORE") && contains(u[1], "WITHSCORES"), "script = ${u[1]}")
  z.inter(["b"], []f64(0), Aggregate.Sum)
  assert(contains(old.queued[1][1], "ZINTERSTORE"), "inter script = ${old.queued[1][1]}")
  assert(len(old.queued[1]) == 6, "no weights, no aggregate: ${joined(old.queued[1])}")
  let modern = Batch(6002)
  ZsetBatch{ batch = modern, key = "a" }.union(["b"], []f64(0), Aggregate.Sum)
  assert(modern.queued[0][0] == "ZUNION", "6.2 keeps ZUNION: ${modern.queued[0][0]}")
}

test "interCard sends ZINTERCARD from 7.0 and an EVAL capped at LIMIT before it" {
  let old = Batch(6002)
  ZsetBatch{ batch = old, key = "a" }.interCard(["b"], 5)
  let a = old.queued[0]
  assert(a[0] == "EVAL" && a[2] == "3" && a[3] == "bit:zsetop:a", "args = ${joined(a)}")
  assert(a[len(a) - 1] == "5" && contains(a[1], "ZINTERSTORE"), "limit last: ${joined(a)}")
  let modern = Batch(7000)
  ZsetBatch{ batch = modern, key = "a" }.interCard(["b"], 5)
  assert(modern.queued[0][0] == "ZINTERCARD", "7.0 keeps ZINTERCARD")
}
