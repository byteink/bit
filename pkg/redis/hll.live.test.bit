// pkg/redis/hll.live.test.bit - `r.hll(key)` against a real server.
// `liveUrl`/`liveClient` are `client.live.test.bit`'s own (same module, no
// import); every test is skipped, and says so, when `REDIS_TEST_URL` is unset.
// `./make test-package-redis-live` (`_tests_/bit/redislive.bit`) supplies it,
// against `redis:8.10.2` in a throwaway Docker container.
//
// A HyperLogLog is exact for a handful of elements (the server keeps them in
// a sparse encoding), so these tests assert exact counts.

fn hllClean(c: Client, keys: []string) {
  c.del(keys) catch e {
    panic("del: ${e.message()}")
  }
}

test "live: hll add reports whether the estimate changed, count and merge follow" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let a = "bit:live:hll:a"
  let b = "bit:live:hll:b"
  let dst = "bit:live:hll:dst"
  hllClean(c, [a, b, dst])

  let first = c.hll(a).add("ana", "bo", "cy") catch e {
    panic("add: ${e.message()}")
  }
  assert(first, "new elements change the estimate")
  let again = c.hll(a).add("ana", "bo") catch e {
    panic("add again: ${e.message()}")
  }
  assert(!again, "elements already counted change nothing")
  let n = c.hll(a).count() catch e {
    panic("count: ${e.message()}")
  }
  assert(n == 3, "three distinct elements, got ${n}")

  c.hll(b).add("cy", "di", "ed", "fay") catch e {
    panic("add b: ${e.message()}")
  }
  let union = c.hll(a).count(b) catch e {
    panic("count union: ${e.message()}")
  }
  assert(union == 6, "a and b hold six distinct elements together, got ${union}")
  let missing = c.hll(a).count(b, "bit:live:hll:nobody") catch e {
    panic("count missing: ${e.message()}")
  }
  assert(missing == 6, "a missing key counts as empty, got ${missing}")

  c.hll(dst).merge(a, b) catch e {
    panic("merge: ${e.message()}")
  }
  let merged = c.hll(dst).count() catch e {
    panic("count merged: ${e.message()}")
  }
  assert(merged == 6, "the merged key counts six, got ${merged}")

  c.hll(b).add("gus") catch e {
    panic("add gus: ${e.message()}")
  }
  c.hll(dst).merge(b) catch e {
    panic("merge again: ${e.message()}")
  }
  let grown = c.hll(dst).count() catch e {
    panic("count grown: ${e.message()}")
  }
  assert(grown == 7, "merging into a key keeps what it had, got ${grown}")

  let sources = c.hll("bit:live:hll:none").count() catch e {
    panic("count none: ${e.message()}")
  }
  assert(sources == 0, "a missing key counts 0, got ${sources}")
  hllClean(c, [a, b, dst])
  c.close()
}

test "live: hll add with no elements creates the key, and a non-HLL key is the server's error" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:hll:empty"
  let plain = "bit:live:hll:plain"
  hllClean(c, [key, plain])

  let created = c.hll(key).add() catch e {
    panic("add nothing: ${e.message()}")
  }
  assert(created, "PFADD with no elements creates the key")
  let t = c.keys().keyType(key) catch e {
    panic("type: ${e.message()}")
  }
  let isString = false
  match (t) {
    KeyString => isString = true
    _ => isString = false
  }
  assert(isString, "a HyperLogLog is a string key")

  let _ = c.set(plain, "not a hyperloglog") catch e {
    panic("set: ${e.message()}")
  }
  let wrong = false
  let _ = c.hll(plain).count() catch e {
    match (e) {
      Server(_, _) => wrong = true
      WrongType(_) => wrong = true
      _ => wrong = false
    }
    0
  }
  assert(wrong, "PFCOUNT on a plain string is the server's error")
  hllClean(c, [key, plain])
  c.close()
}

test "live: hll commands run in a pipeline and a transaction through HllBatch" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let a = "bit:live:hll:qa"
  let dst = "bit:live:hll:qdst"
  hllClean(c, [a, dst])

  let p = c.pipeline()
  let q = p.hll(a)
  let added = q.add("x", "y")
  let counted = q.count()
  let merged = p.hll(dst).merge(a)
  let total = p.hll(dst).count()
  p.exec() catch e {
    panic("pipeline exec: ${e.message()}")
  }
  let ch = added.get() catch e {
    panic("add future: ${e.message()}")
  }
  assert(ch, "queued add changed the estimate")
  let n = counted.get() catch e {
    panic("count future: ${e.message()}")
  }
  assert(n == 2, "queued count = ${n}")
  merged.get() catch e {
    panic("merge future: ${e.message()}")
  }
  let t = total.get() catch e {
    panic("total future: ${e.message()}")
  }
  assert(t == 2, "queued count after merge = ${t}")

  let size = c.transaction<Future<i64>>([a], (tx) => {
    tx.hll(a).add("z")
    return tx.hll(a).count()
  }) catch e {
    panic("transaction: ${e.message()}")
  }
  let s = size.get() catch e {
    panic("transaction future: ${e.message()}")
  }
  assert(s == 3, "count inside the transaction = ${s}")
  hllClean(c, [a, dst])
  c.close()
}

test "live: tx.read.hll counts before the queued add runs, and refuses a write" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:hll:txread"
  hllClean(c, [key])
  c.hll(key).add("ana", "bo") catch e {
    panic("add: ${e.message()}")
  }
  let out = c.transaction<Future<bool>>([key], (tx) => {
    let queued = tx.hll(key).add("cy", "di", "ed")
    let r = tx.read.hll(key)
    let n = r.count()?
    assert(n == 2, "count runs now: the queued add has not run, got ${n}")
    let refused = false
    let _ = r.add("fay") catch _ {
      refused = true
      false
    }
    assert(refused, "a write through tx.read is refused")
    return queued
  }) catch e {
    panic("transaction: ${e.message()}")
  }
  let changed = out.get() catch e {
    panic("future: ${e.message()}")
  }
  assert(changed, "the queued add changed the estimate")
  let n = c.hll(key).count() catch e {
    panic("count after: ${e.message()}")
  }
  assert(n == 5, "five distinct after EXEC (fay was refused), got ${n}")
  hllClean(c, [key])
  c.close()
}
