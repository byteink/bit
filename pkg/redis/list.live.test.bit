// pkg/redis/list.live.test.bit - `r.list(key)` against a real server.
// `liveUrl`/`liveClient` are `client.live.test.bit`'s own, `delKey` is
// `zset.live.test.bit`'s (same module, no import); every test is skipped,
// and says so, when `REDIS_TEST_URL` is unset. `./make
// test-package-redis-live` (`_tests_/bit/redislive.bit`) supplies it against
// `redis:8.10.2` in a throwaway Docker container.

fn listAll(l: List, what: string): []string {
  return l.all() catch e {
    panic("${what}: all: ${e.message()}")
  }
}

fn assertList(got: []string, want: []string, what: string) {
  assert(len(got) == len(want), "${what}: expected ${len(want)} items, got ${len(got)}")
  let i = 0
  while (i < len(want)) {
    assert(got[i] == want[i], "${what}: item ${i} is '${got[i]}', want '${want[i]}'")
    i = i + 1
  }
}

fn assertCount(got: i64, want: i64, what: string) {
  assert(got == want, "${what}: expected ${want}, got ${got}")
}

fn assertSome(got: Option<string>, want: string, what: string) {
  match (got) {
    Some(v) => assert(v == want, "${what}: expected '${want}', got '${v}'")
    None => panic("${what}: expected '${want}', got None")
  }
}

// `push` after `delayNs`, run on its own green thread by the blocking tests:
// the push that satisfies a pop already waiting on another connection.
fn listDelayedPush(admin: Client, key: string, delayNs: int, value: string) {
  sleep(delayNs)
  admin.list(key).push(value) catch e {
    panic("delayed push: ${e.message()}")
  }
}

test "live: push, pushFront, range, all, len, index, pop and popFront round-trip a list" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:list:basic"
  delKey(c, key)
  let l = c.list(key)

  let n = l.push("a", "b", "c") catch e {
    panic("push: ${e.message()}")
  }
  assertCount(n, 3, "push")
  let m = l.pushFront("z", "y") catch e {
    panic("pushFront: ${e.message()}")
  }
  assertCount(m, 5, "pushFront")
  assertList(
    listAll(l, "basic"),
    ["y", "z", "a", "b", "c"],
    "pushFront puts each value on the head in turn",
  )

  let mid = l.range(1, 2) catch e {
    panic("range: ${e.message()}")
  }
  assertList(mid, ["z", "a"], "range(1, 2) is inclusive")
  let size = l.len() catch e {
    panic("len: ${e.message()}")
  }
  assertCount(size, 5, "len")

  let first = l.index(0) catch e {
    panic("index: ${e.message()}")
  }
  assertSome(first, "y", "index(0)")
  let last = l.index(-1) catch e {
    panic("index: ${e.message()}")
  }
  assertSome(last, "c", "index(-1)")
  let gone = l.index(99) catch e {
    panic("index: ${e.message()}")
  }
  assert(isNone(gone), "index past the end should be None")

  let tail = l.pop() catch e {
    panic("pop: ${e.message()}")
  }
  assertSome(tail, "c", "pop")
  let head = l.popFront() catch e {
    panic("popFront: ${e.message()}")
  }
  assertSome(head, "y", "popFront")
  assertList(listAll(l, "after pops"), ["z", "a", "b"], "after pop and popFront")
  c.close()
}

test "live: pop and len on a missing key read as empty" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:list:missing"
  delKey(c, key)
  let l = c.list(key)
  let a = l.pop() catch e {
    panic("pop: ${e.message()}")
  }
  assert(isNone(a), "pop on a missing key should be None")
  let b = l.popFront() catch e {
    panic("popFront: ${e.message()}")
  }
  assert(isNone(b), "popFront on a missing key should be None")
  let many = l.popFrontMany(3) catch e {
    panic("popFrontMany: ${e.message()}")
  }
  assert(len(many) == 0, "popFrontMany on a missing key should be empty, got ${len(many)}")
  assert(len(listAll(l, "missing")) == 0, "all on a missing key should be empty")
  let n = l.len() catch e {
    panic("len: ${e.message()}")
  }
  assertCount(n, 0, "len")
  c.close()
}

test "live: pushIfExists and pushFrontIfExists create nothing" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:list:ifexists"
  delKey(c, key)
  let l = c.list(key)

  let none = l.pushIfExists("a") catch e {
    panic("pushIfExists: ${e.message()}")
  }
  assertCount(none, 0, "pushIfExists on a missing key")
  let noneFront = l.pushFrontIfExists("a") catch e {
    panic("pushFrontIfExists: ${e.message()}")
  }
  assertCount(noneFront, 0, "pushFrontIfExists on a missing key")
  assert(len(listAll(l, "still missing")) == 0, "neither X push may create the list")

  l.push("m") catch e {
    panic("push: ${e.message()}")
  }
  let n = l.pushIfExists("n") catch e {
    panic("pushIfExists: ${e.message()}")
  }
  assertCount(n, 2, "pushIfExists on a present key")
  let f = l.pushFrontIfExists("l") catch e {
    panic("pushFrontIfExists: ${e.message()}")
  }
  assertCount(f, 3, "pushFrontIfExists on a present key")
  assertList(listAll(l, "x pushes"), ["l", "m", "n"], "X pushes land on their own end")
  c.close()
}

test "live: popMany and popFrontMany take from their own end" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:list:popmany"
  delKey(c, key)
  let l = c.list(key)
  l.push("a", "b", "c", "d", "e") catch e {
    panic("push: ${e.message()}")
  }
  let tail = l.popMany(2) catch e {
    panic("popMany: ${e.message()}")
  }
  assertList(tail, ["e", "d"], "popMany takes the tail first")
  let head = l.popFrontMany(2) catch e {
    panic("popFrontMany: ${e.message()}")
  }
  assertList(head, ["a", "b"], "popFrontMany takes the head first")
  let rest = l.popMany(5) catch e {
    panic("popMany: ${e.message()}")
  }
  assertList(rest, ["c"], "asking for more than is left returns what is left")
  let empty = l.popMany(1) catch e {
    panic("popMany: ${e.message()}")
  }
  assert(len(empty) == 0, "popMany on an emptied list should be empty, got ${len(empty)}")
  c.close()
}

test "live: set, insert, remove and trim edit a list in place" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:list:edit"
  delKey(c, key)
  let l = c.list(key)
  l.push("a", "b", "c", "b", "d") catch e {
    panic("push: ${e.message()}")
  }

  l.set(0, "A") catch e {
    panic("set: ${e.message()}")
  }
  let before = l.insert("c", "X") catch e {
    panic("insert: ${e.message()}")
  }
  assertCount(before, 6, "insert before")
  let after = l.insert("c", "Y", after = true) catch e {
    panic("insert after: ${e.message()}")
  }
  assertCount(after, 7, "insert after")
  let missing = l.insert("nope", "v") catch e {
    panic("insert: ${e.message()}")
  }
  assertCount(missing, -1, "insert with a pivot that is not in the list")
  assertList(listAll(l, "inserted"), ["A", "b", "X", "c", "Y", "b", "d"], "insert before and after")

  let fromHead = l.remove("b", 1) catch e {
    panic("remove: ${e.message()}")
  }
  assertCount(fromHead, 1, "remove(count = 1)")
  let fromTail = l.remove("b", -1) catch e {
    panic("remove: ${e.message()}")
  }
  assertCount(fromTail, 1, "remove(count = -1)")
  let none = l.remove("zzz") catch e {
    panic("remove: ${e.message()}")
  }
  assertCount(none, 0, "remove of an absent value")
  assertList(listAll(l, "removed"), ["A", "X", "c", "Y", "d"], "remove")

  l.trim(1, 3) catch e {
    panic("trim: ${e.message()}")
  }
  assertList(listAll(l, "trimmed"), ["X", "c", "Y"], "trim(1, 3) keeps that inclusive range")

  let failed = false
  l.set(10, "x") catch _ {
    failed = true
  }
  assert(failed, "set past the end should fail")
  c.close()
}

test "live: position and positions honour rank, count and maxLen" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:list:pos"
  delKey(c, key)
  let l = c.list(key)
  l.push("a", "b", "c", "a", "b", "a") catch e {
    panic("push: ${e.message()}")
  }

  let first = l.position("a") catch e {
    panic("position: ${e.message()}")
  }
  assert(isSome(first) && unwrap(first) == 0, "first 'a' is at 0")
  let second = l.position("a", rank = 2) catch e {
    panic("position: ${e.message()}")
  }
  assert(isSome(second) && unwrap(second) == 3, "second 'a' is at 3")
  let fromTail = l.position("a", rank = -1) catch e {
    panic("position: ${e.message()}")
  }
  assert(isSome(fromTail) && unwrap(fromTail) == 5, "last 'a' is at 5")
  let absent = l.position("zz") catch e {
    panic("position: ${e.message()}")
  }
  assert(isNone(absent), "an absent value has no position")
  let capped = l.position("c", maxLen = 2) catch e {
    panic("position: ${e.message()}")
  }
  assert(isNone(capped), "'c' is at 2, beyond a maxLen of 2")

  let every = l.positions("a") catch e {
    panic("positions: ${e.message()}")
  }
  assert(
    len(every) == 3 && every[0] == 0 && every[1] == 3 && every[2] == 5,
    "positions = ${len(every)}",
  )
  let two = l.positions("a", count = 2) catch e {
    panic("positions: ${e.message()}")
  }
  assert(len(two) == 2 && two[0] == 0 && two[1] == 3, "positions(count = 2) = ${len(two)}")
  let back = l.positions("a", count = 2, rank = -1) catch e {
    panic("positions: ${e.message()}")
  }
  assert(len(back) == 2 && back[0] == 5 && back[1] == 3, "positions(rank = -1) = ${len(back)}")
  let none = l.positions("zz") catch e {
    panic("positions: ${e.message()}")
  }
  assert(len(none) == 0, "positions of an absent value is empty, got ${len(none)}")
  c.close()
}

test "live: move shifts an element between ends and popAny takes from the first non-empty list" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let src = "bit:live:list:move:src"
  let dst = "bit:live:list:move:dst"
  delKey(c, src)
  delKey(c, dst)
  let s = c.list(src)
  let d = c.list(dst)
  s.push("a", "b", "c") catch e {
    panic("push: ${e.message()}")
  }

  let one = s.move(dst, ListEnd.Back, ListEnd.Front) catch e {
    panic("move: ${e.message()}")
  }
  assertSome(one, "c", "move tail to head")
  let two = s.move(dst, ListEnd.Front, ListEnd.Back) catch e {
    panic("move: ${e.message()}")
  }
  assertSome(two, "a", "move head to tail")
  assertList(listAll(d, "dst"), ["c", "a"], "dst after two moves")
  assertList(listAll(s, "src"), ["b"], "src after two moves")
  s.pop() catch e {
    panic("pop: ${e.message()}")
  }
  let empty = s.move(dst, ListEnd.Front, ListEnd.Back) catch e {
    panic("move: ${e.message()}")
  }
  assert(isNone(empty), "move from an empty list should be None")

  // `src` is empty now, `dst` holds c, a: popAny skips the empty handle.
  let got = s.popAny(ListEnd.Front, [dst], 5) catch e {
    panic("popAny: ${e.message()}")
  }
  assert(isSome(got), "popAny should find the second list")
  let popped = unwrap(got)
  assert(popped.key == dst, "popAny answered from '${popped.key}', want '${dst}'")
  assertList(popped.values, ["c", "a"], "popAny(count = 5) takes what is there")
  let nothing = s.popAny(ListEnd.Back, [dst]) catch e {
    panic("popAny: ${e.message()}")
  }
  assert(isNone(nothing), "popAny over empty lists should be None")
  c.close()
}

test "live: blockPopFront and blockPop are satisfied by a push from another connection" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let admin = liveClient(u)
  let key = "bit:live:list:block"
  delKey(c, key)

  spawn listDelayedPush(admin, key, 200 * Millisecond, "job-1")
  let got = c.list(key).blockPopFront(5 * Second) catch e {
    panic("blockPopFront: ${e.message()}")
  }
  assert(isSome(got), "blockPopFront timed out waiting for the spawned push")
  assert(unwrap(got).key == key && unwrap(got).value == "job-1", "popped '${unwrap(got).value}'")

  spawn listDelayedPush(admin, key, 200 * Millisecond, "job-2")
  let tail = c.list(key).blockPop(5 * Second) catch e {
    panic("blockPop: ${e.message()}")
  }
  assert(isSome(tail), "blockPop timed out waiting for the spawned push")
  assert(unwrap(tail).value == "job-2", "popped '${unwrap(tail).value}'")
  c.close()
  admin.close()
}

test "live: blockPopFront reads the first of several keys that has an element" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let high = "bit:live:list:prio:high"
  let low = "bit:live:list:prio:low"
  delKey(c, high)
  delKey(c, low)
  c.list(low).push("slow") catch e {
    panic("push: ${e.message()}")
  }
  let got = c.list(high).blockPopFront(1 * Second, [low]) catch e {
    panic("blockPopFront: ${e.message()}")
  }
  assert(isSome(got), "should pop from the low list")
  assert(unwrap(got).key == low && unwrap(got).value == "slow", "popped from '${unwrap(got).key}'")
  c.close()
}

test "live: blockMove and blockPopAny are satisfied by a concurrent push" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let admin = liveClient(u)
  let src = "bit:live:list:bmove:src"
  let dst = "bit:live:list:bmove:dst"
  delKey(c, src)
  delKey(c, dst)

  spawn listDelayedPush(admin, src, 200 * Millisecond, "t1")
  let moved = c.list(src).blockMove(dst, ListEnd.Front, ListEnd.Back, 5 * Second) catch e {
    panic("blockMove: ${e.message()}")
  }
  assertSome(moved, "t1", "blockMove")
  assertList(listAll(c.list(dst), "bmove dst"), ["t1"], "blockMove's destination")

  spawn listDelayedPush(admin, src, 200 * Millisecond, "t2")
  let any = c.list(src).blockPopAny(ListEnd.Front, 5 * Second, [dst], 1) catch e {
    panic("blockPopAny: ${e.message()}")
  }
  assert(isSome(any), "blockPopAny timed out")
  assert(len(unwrap(any).values) == 1, "blockPopAny took ${len(unwrap(any).values)} elements")
  c.close()
  admin.close()
}

test "live: every blocking pop times out to None on an empty key, after about its timeout" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:list:timeout"
  let other = "bit:live:list:timeout:dst"
  delKey(c, key)
  delKey(c, other)
  let l = c.list(key)
  let t0 = monotonic().ns
  let serverBefore = liveServerNowNs(c)

  let a = l.blockPop(250 * Millisecond) catch e {
    panic("blockPop: ${e.message()}")
  }
  assert(isNone(a), "blockPop on an empty key should time out to None")
  let b = l.blockPopFront(250 * Millisecond) catch e {
    panic("blockPopFront: ${e.message()}")
  }
  assert(isNone(b), "blockPopFront on an empty key should time out to None")
  let m = l.blockMove(other, ListEnd.Front, ListEnd.Back, 250 * Millisecond) catch e {
    panic("blockMove: ${e.message()}")
  }
  assert(isNone(m), "blockMove on an empty key should time out to None")
  let p = l.blockPopAny(ListEnd.Front, 250 * Millisecond) catch e {
    panic("blockPopAny: ${e.message()}")
  }
  assert(isNone(p), "blockPopAny on an empty key should time out to None")

  // The waits are the server's: the lower bound is on its TIME, the caller's
  // clock only guards against a hang (#7747).
  let serverElapsed = liveServerNowNs(c) - serverBefore
  let elapsed = monotonic().ns - t0
  assert(
    serverElapsed >= 900 * Millisecond,
    "four 250ms waits took only ${serverElapsed / Millisecond}ms on the server's clock",
  )
  assert(elapsed < 4 * Second, "four 250ms waits took ${elapsed / Millisecond}ms")
  c.close()
}

test "live: a negative timeout is refused by the server" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let failed = false
  let _ = c.list("bit:live:list:negative").blockPop(-1) catch _ {
    failed = true
    Option.None
  }
  assert(failed, "a negative timeout should fail")
  c.close()
}

fn listBlockedPop(c: Client, key: string, done: chan<bool>) {
  let got = c.list(key).blockPopFront(2 * Second) catch _ {
    done <- false
    return
  }
  done <- isSome(got)
}

// The two properties a blocking call owes the rest of the client: it never
// holds the pool's only connection (`pool=1`), and it is not cut off by
// `commandTimeout` (`timeout=500ms`) while it waits longer than that.
test "live: a blocked pop leaves a one-connection pool free and outlives commandTimeout" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient("${u}?timeout=500ms&pool=1")
  let admin = liveClient(u)
  let key = "bit:live:list:starve"
  delKey(admin, key)

  let done = chan<bool>(1)
  spawn listBlockedPop(c, key, done)
  sleep(100 * Millisecond)
  let pong = c.ping() catch e {
    panic("ping while a pop is blocked: ${e.message()}")
  }
  assert(pong == "PONG", "ping = '${pong}'")

  // 900ms is past commandTimeout (500ms): only the extended deadline lets it land.
  sleep(800 * Millisecond)
  admin.list(key).push("late") catch e {
    panic("push: ${e.message()}")
  }
  let satisfied = <- done
  assert(satisfied, "the blocked pop should have been satisfied by the late push")
  c.close()
  admin.close()
}

test "live: a pipeline queues every non-blocking list command and fills its futures" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:list:pipe"
  delKey(c, key)
  let p = c.pipeline()
  let pushed = p.list(key).push("a", "b", "c")
  let popped = p.list(key).popFront()
  let size = p.list(key).len()
  let rest = p.list(key).all()
  p.exec() catch e {
    panic("exec: ${e.message()}")
  }
  let n = pushed.get() catch e {
    panic("push future: ${e.message()}")
  }
  assertCount(n, 3, "pipelined push")
  let head = popped.get() catch e {
    panic("popFront future: ${e.message()}")
  }
  assertSome(head, "a", "pipelined popFront")
  let k = size.get() catch e {
    panic("len future: ${e.message()}")
  }
  assertCount(k, 2, "pipelined len")
  let items = rest.get() catch e {
    panic("all future: ${e.message()}")
  }
  assertList(items, ["b", "c"], "pipelined all")
  c.close()
}

test "live: a list command on a string key fails WrongType" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:list:wrongtype"
  c.set(key, "plain") catch e {
    panic("set: ${e.message()}")
  }
  let wrong = false
  let _ = c.list(key).pop() catch e {
    wrong = e.message() ==
      "redis: WRONGTYPE Operation against a key holding the wrong kind of value"
    Option.None
  }
  assert(wrong, "RPOP on a string key should fail WRONGTYPE")
  delKey(c, key)
  c.close()
}

test "live: tx.read.list reads before the queued write runs, and refuses a write and a blocking pop" {
  let u = liveUrl("REDIS_TEST_URL")
  if (u == "") {
    return
  }
  let c = liveClient(u)
  let key = "bit:live:list:txread"
  delKey(c, key)
  c.list(key).push("a", "b", "c") catch e {
    panic("seed: ${e.message()}")
  }
  let out = c.transaction<Future<i64>>([key], (tx) => {
    let queued = tx.list(key).push("d")
    let l = tx.read.list(key)
    assertList(l.all()?, ["a", "b", "c"], "all before EXEC")
    assertCount(l.len()?, 3, "len before EXEC")
    assertSome(l.index(0)?, "a", "index 0")
    let at = l.position("b")?
    assert(isSome(at) && unwrap(at) == 1, "position of b is index 1")
    let refused = false
    let _ = l.push("x") catch _ {
      refused = true
      0
    }
    assert(refused, "a write through tx.read is refused")
    let refusedPop = false
    let _ = l.blockPop(1000000) catch _ {
      refusedPop = true
      Option.None
    }
    assert(refusedPop, "a blocking pop through tx.read is refused")
    return queued
  }) catch e {
    panic("transaction: ${e.message()}")
  }
  let size = out.get() catch e {
    panic("future: ${e.message()}")
  }
  assert(size == 4, "the queued push committed, length ${size}")
  assertList(listAll(c.list(key), "after EXEC"), ["a", "b", "c", "d"], "after EXEC: no 'x'")
  delKey(c, key)
  c.close()
}
