// pkg/redis/search.test.bit - the schema, query, search, aggregate and reply
// code of `search*.bit`, tested without a server. `assertArgs` is
// `list.test.bit`s and `arr` `bloom.test.bit`s (same module).
// `search.live.test.bit` runs every command against a real server.

@json class Product {
  name: string,
  price: f64,
}

fn sbulk(s: string): Reply { return Reply.Bulk(Option.Some(s)) }

fn searchFails(r: Reply, o: SearchOptions): bool {
  let failed = false
  let _ = asSearchResult(r, o) catch _ {
    failed = true
    SearchResult{ total = 0, hits = []Hit(0) }
  }
  return failed
}

fn spair(k: string, v: Reply): MapEntry { return MapEntry{ key = sbulk(k), value = v } }

test "FT.CREATE writes the options in the docs' order, then the schema's field tokens" {
  let s = schema().text("name", TextOptions{ weight = 2.0, sortable = true }).tag(
    "brand",
    TagOptions{ separator = "|" },
  ).numeric(
    "price",
    NumericOptions{ sortable = true },
  )
  assertArgs(
    createCmd("idx", s, CreateOptions{}).args,
    [
      "FT.CREATE", "idx", "SCHEMA", "name", "TEXT", "WEIGHT", "2", "SORTABLE", "brand", "TAG", "SEPARATOR", "|",
      "price", "NUMERIC", "SORTABLE",
    ],
  )
  let opts = CreateOptions{
    over = IndexOn.Json,
    prefixes = ["p:", "q:"],
    filter = Option.Some("@stock>0"),
    language = Option.Some("french"),
    score = Option.Some(0.5),
    temporary = Option.Some(60),
    noHl = true,
    stopwords = Option.Some(["a", "the"]),
    skipInitialScan = true,
  }
  assertArgs(
    createCmd("idx", schema().numeric("$.n", NumericOptions{ alias = "n" }), opts).args,
    [
      "FT.CREATE", "idx", "ON", "JSON", "PREFIX", "2", "p:", "q:", "FILTER", "@stock>0", "LANGUAGE", "french",
      "SCORE", "0.5", "TEMPORARY", "60", "NOHL", "STOPWORDS", "2", "a", "the", "SKIPINITIALSCAN", "SCHEMA",
      "$.n", "AS", "n", "NUMERIC",
    ],
  )
  assertArgs(
    createCmd("idx", schema(), CreateOptions{ stopwords = Option.Some([]string(0)) }).args,
    ["FT.CREATE", "idx", "STOPWORDS", "0", "SCHEMA"],
  )
}

test "schema fields: TEXT flags, TAG flags and GEO/GEOSHAPE tokens" {
  let wordy = TextOptions{
    noStem = true,
    phonetic = Phonetic.French,
    suffixTrie = true,
    indexEmpty = true,
    indexMissing = true,
    unf = true,
    noIndex = true,
  }
  let s = schema().text("t", wordy).tag(
    "g",
    TagOptions{ caseSensitive = true, suffixTrie = true, sortable = true },
  ).geo(
    "loc",
    GeoOptions{ indexMissing = true },
  ).geoShape("area", GeoShapeOptions{ coords = Coords.Flat })
  assertArgs(
    s.args(),
    [
      "t", "TEXT", "NOSTEM", "PHONETIC", "dm:fr", "WITHSUFFIXTRIE", "INDEXEMPTY", "INDEXMISSING", "SORTABLE",
      "UNF", "NOINDEX", "g", "TAG", "CASESENSITIVE", "WITHSUFFIXTRIE", "SORTABLE", "loc", "GEO", "INDEXMISSING",
      "area", "GEOSHAPE", "FLAT",
    ],
  )
  assert(s.size() == 4, "four fields")
  assert(schema().size() == 0, "empty")
}

test "a VECTOR field counts its attributes and HNSW options apply only to HNSW" {
  assertArgs(
    schema().vector("emb", 3).args(),
    ["emb", "VECTOR", "HNSW", "6", "TYPE", "FLOAT32", "DIM", "3", "DISTANCE_METRIC", "COSINE"],
  )
  assertArgs(
    schema().vector(
      "emb",
      128,
      VectorOptions{ algo = VecAlgo.Flat, metric = VecMetric.L2, m = 16, initialCap = 1000 },
    ).args(),
    [
      "emb",
      "VECTOR",
      "FLAT",
      "8",
      "TYPE",
      "FLOAT32",
      "DIM",
      "128",
      "DISTANCE_METRIC",
      "L2",
      "INITIAL_CAP",
      "1000",
    ],
  )
  assertArgs(
    schema().vector(
      "e",
      2,
      VectorOptions{
        alias = "v",
        metric = VecMetric.InnerProduct,
        elem = VecType.Float64,
        m = 8,
        efConstruction = 100,
        efRuntime = 20,
        epsilon = 0.01,
      },
    ).args(),
    [
      "e", "AS", "v", "VECTOR", "HNSW", "14", "TYPE", "FLOAT64", "DIM", "2", "DISTANCE_METRIC", "IP", "M", "8",
      "EF_CONSTRUCTION", "100", "EF_RUNTIME", "20", "EPSILON", "0.01",
    ],
  )
}

test "SVS-VAMANA preserves required attributes and alias for FLOAT32 and FLOAT16" {
  for elem of [VecType.Float32, VecType.Float16] {
    let opts = VectorOptions{
      algo = VecAlgo.SvsVamana, elem = elem, metric = VecMetric.L2, alias = "v",
    }
    assertArgs(
      schema().vector("embedding", 2, opts).args(),
      [
        "embedding", "AS", "v", "VECTOR", "SVS-VAMANA", "6", "TYPE", vecTypeName(elem),
        "DIM", "2", "DISTANCE_METRIC", "L2",
      ],
    )
  }
}

test "FT.ALTER, FT.DROPINDEX, aliases and the small commands" {
  assertArgs(
    alterCmd("idx", schema().tag("t"), true).args,
    ["FT.ALTER", "idx", "SKIPINITIALSCAN", "SCHEMA", "ADD", "t", "TAG"],
  )
  assertArgs(dropCmd("idx", true).args, ["FT.DROPINDEX", "idx", "DD"])
  assertArgs(dropCmd("idx", false).args, ["FT.DROPINDEX", "idx"])
  assertArgs(aliasCmd("FT.ALIASUPDATE", "a", "idx").args, ["FT.ALIASUPDATE", "a", "idx"])
  assertArgs(aliasDelCmd("a").args, ["FT.ALIASDEL", "a"])
  assertArgs(listCmd().args, ["FT._LIST"])
  assertArgs(ftInfoCmd("idx").args, ["FT.INFO", "idx"])
  assertArgs(tagValsCmd("idx", "brand").args, ["FT.TAGVALS", "idx", "brand"])
  assertArgs(
    synUpdateCmd("idx", "g1", ["boot", "shoe"], true).args,
    ["FT.SYNUPDATE", "idx", "g1", "SKIPINITIALSCAN", "boot", "shoe"],
  )
  assertArgs(synDumpCmd("idx").args, ["FT.SYNDUMP", "idx"])
  assertArgs(cursorReadCmd("idx", 42, 10).args, ["FT.CURSOR", "READ", "idx", "42", "COUNT", "10"])
  assertArgs(cursorReadCmd("idx", 42, 0).args, ["FT.CURSOR", "READ", "idx", "42"])
  assertArgs(cursorDelCmd("idx", 42).args, ["FT.CURSOR", "DEL", "idx", "42"])
  assertArgs(
    explainCmd("idx", freeText("a b"), Option.Some(2)).args,
    ["FT.EXPLAIN", "idx", "a b", "DIALECT", "2"],
  )
  assert(listCmd().readOnly && !createCmd("i", schema(), CreateOptions{}).readOnly, "read flags")
}

test "queries: text, phrase, prefix, fuzzy, tags and numbers, escaped" {
  assert(freeText("red shoe").expr == "red shoe", "words")
  assert(freeText("50% off!").expr == "50\\% off\\!", "escaped: ${freeText("50% off!").expr}")
  assert(qfield("name").text("red shoe").expr == "@name:(red shoe)", "text")
  assert(qfield("name").phrase("say \"hi\"").expr == "@name:\"say \\\"hi\\\"\"", "phrase")
  assert(qfield("name").anyWord("a", "b").expr == "@name:(a|b)", "anyWord")
  assert(qfield("name").prefix("sho").expr == "@name:sho*", "prefix")
  assert(qfield("name").suffix("oe").expr == "@name:*oe", "suffix")
  assert(qfield("name").infix("ho").expr == "@name:*ho*", "infix")
  assert(qfield("name").fuzzy("shoe").expr == "@name:%shoe%", "fuzzy 1")
  assert(qfield("name").fuzzy("shoe", 2).expr == "@name:%%shoe%%", "fuzzy 2")
  assert(
    qfield("brand").anyOf("acme co", "zeta").expr == "@brand:{acme\\ co|zeta}",
    "tags: ${qfield("brand").anyOf("acme co", "zeta").expr}",
  )
  assert(
    qfield("price").between(10.0, 50.0).expr == "@price:[10 50]",
    "between: ${qfield("price").between(10.0, 50.0).expr}",
  )
  assert(qfield("price").gt(5.0).expr == "@price:[(5 +inf]", "gt")
  assert(qfield("price").ge(5.0).expr == "@price:[5 +inf]", "ge")
  assert(qfield("price").lt(5.0).expr == "@price:[-inf (5]", "lt")
  assert(qfield("price").le(5.0).expr == "@price:[-inf 5]", "le")
  assert(qfield("price").eq(5.0).expr == "@price:[5 5]", "eq")
  assert(
    qfield("loc").near(2.5, 48.5, 10.0).expr == "@loc:[2.5 48.5 10 km]",
    "near: ${qfield("loc").near(2.5, 48.5, 10.0).expr}",
  )
  assert(qfield("brand").missing().expr == "ismissing(@brand)", "missing")
  let sh = qfield("area").shape(ShapeOp.Within, "POINT(1 2)")
  assert(
    sh.expr == "@area:[WITHIN $shape_area]" && sh.params[1] == "POINT(1 2)",
    "shape: ${sh.expr}",
  )
  assert(qfield("a").shape(ShapeOp.Contain, "x").expr == "@a:[CONTAINS $shape_a]", "contains")
  assert(qfield("a").shape(ShapeOp.Intersect, "x").expr == "@a:[INTERSECTS $shape_a]", "intersects")
  assert(qfield("a").shape(ShapeOp.Disjoint, "x").expr == "@a:[DISJOINT $shape_a]", "disjoint")
}

test "queries combine with and, or, not, optional and weighted, and rawQuery is verbatim" {
  let a = qfield("name").text("shoe")
  let b = qfield("brand").anyOf("acme")
  assert(a.and(b).expr == "(@name:(shoe)) (@brand:{acme})", "and: ${a.and(b).expr}")
  assert(a.or(b).expr == "(@name:(shoe))|(@brand:{acme})", "or")
  assert(a.not().expr == "-(@name:(shoe))", "not")
  assert(a.optional().expr == "~(@name:(shoe))", "optional")
  assert(
    a.weighted(2.0).expr == "(@name:(shoe)) => { $weight: 2; }",
    "weighted: ${a.weighted(2.0).expr}",
  )
  assert(everything().expr == "*", "everything")
  assert(rawQuery("@a:{x} -@b:y").expr == "@a:{x} -@b:y", "raw")
}

test "knn and vectorRange carry the FP32 blob as a param" {
  let q = knn("emb", [1.0, 0.5], 3)
  assert(q.expr == "*=>[KNN 3 @emb $knnvec]", "knn: ${q.expr}")
  assert(
      len(q.params) == 2 &&
      q.params[0] == "knnvec" &&
      q.params[1] == "\x00\x00\x80\x3f\x00\x00\x00\x3f",
    "param",
  )
  let f = knn("emb", [1.0], 2, filter = qfield("brand").anyOf("acme"), score = "dist")
  assert(f.expr == "(@brand:{acme})=>[KNN 2 @emb $knnvec AS dist]", "filtered: ${f.expr}")
  let r = vectorRange("emb", [1.0], 0.25)
  assert(r.expr == "@emb:[VECTOR_RANGE 0.25 $vrvec]" && r.params[0] == "vrvec", "range: ${r.expr}")
  let both = qfield("a").text("x").and(r)
  assert(len(both.params) == 2, "and merges params")
}

test "FT.SEARCH sends the options in the docs' order and defaults the dialect for params" {
  let q = everything()
  assertArgs(searchArgs("idx", q, SearchOptions{}), ["FT.SEARCH", "idx", "*"])
  let o = SearchOptions{
    noContent = false,
    verbatim = true,
    withScores = true,
    withSortKeys = true,
    numeric = [NumFilter{ field = "price", min = 1.0, max = 9.0 }],
    geo = [GeoFilter{ field = "loc", lon = 1.0, lat = 2.0, radius = 3.0, unit = GeoUnit.Miles }],
    inKeys = ["k1"],
    inFields = ["name", "desc"],
    returns = [Returned{ field = "name" }, Returned{ field = "$.p", alias = "p" }],
    summarize = Option.Some(
      Summarize{
        fields = ["desc"],
        frags = Option.Some(2),
        len = Option.Some(10),
        separator = Option.Some(".."),
      },
    ),
    highlight = Option.Some(Highlight{ open = "<i>", close = "</i>" }),
    slop = Option.Some(1),
    timeout = Option.Some(500),
    inOrder = true,
    language = Option.Some("english"),
    scorer = Option.Some("BM25"),
    explainScore = true,
    sortBy = Option.Some(SortBy{ field = "price", desc = true, withCount = true }),
    page = Option.Some(Page{ offset = 10, num = 5 }),
    params = [Field{ name = "x", value = "y" }],
  }
  assertArgs(
    searchArgs("idx", q, o),
    [
      "FT.SEARCH", "idx", "*", "VERBATIM", "WITHSCORES", "WITHSORTKEYS", "FILTER", "price", "1", "9",
      "GEOFILTER", "loc", "1", "2", "3", "mi", "INKEYS", "1", "k1", "INFIELDS", "2", "name", "desc", "RETURN",
      "4", "name", "$.p", "AS", "p", "SUMMARIZE", "FIELDS", "1", "desc", "FRAGS", "2", "LEN", "10", "SEPARATOR",
      "..", "HIGHLIGHT", "TAGS", "<i>", "</i>", "SLOP", "1", "TIMEOUT", "500", "INORDER", "LANGUAGE", "english",
      "SCORER", "BM25", "EXPLAINSCORE", "SORTBY", "price", "DESC", "WITHCOUNT", "LIMIT", "10", "5", "PARAMS",
      "2", "x", "y", "DIALECT", "2",
    ],
  )
  let k = knn("emb", [1.0], 3)
  let a = searchArgs("idx", k, SearchOptions{ noContent = true, dialect = Option.Some(3) })
  assert(a[len(a) - 2] == "DIALECT" && a[len(a) - 1] == "3", "explicit dialect wins")
  let b = searchArgs("idx", k, SearchOptions{})
  assert(b[3] == "PARAMS" && b[4] == "2" && b[len(b) - 1] == "2", "dialect 2 for params")
}

test "FT.SEARCH reads RESP3's map with scores, sort keys, JSON documents and a doc decode" {
  let doc = sbulk("{\"name\":\"shoe\",\"price\":9.5}")
  let r3 = Reply.Map(
    [
      spair("attributes", arr([])),
      spair("format", sbulk("STRING")),
      spair(
        "results",
        arr(
          [
            Reply.Map(
              [
                spair("id", sbulk("p:1")),
                spair("score", Reply.Double(1.5)),
                spair("sortkey", sbulk("#9.5")),
                spair("extra_attributes", Reply.Map([spair("$", doc)])),
                spair("values", arr([])),
              ],
            ),
          ],
        ),
      ),
      spair("total_results", Reply.Int(7)),
      spair("warning", arr([])),
    ],
  )
  let got = asSearchResult(r3, SearchOptions{}) catch e {
    panic("map: ${e.message()}")
  }
  assert(got.total == 7 && len(got.hits) == 1, "total ${got.total}")
  let h = got.hits[0]
  assert(h.id == "p:1" && h.score == Option.Some(1.5) && h.sortKey == Option.Some("#9.5"), "hit")
  let p = h.doc<Product>() catch e {
    panic("doc: ${e.message()}")
  }
  assert(p.name == "shoe" && p.price == 9.5, "decoded")
  let failed = false
  let _ = h.doc<Product>("nope") catch _ {
    failed = true
    Product{ name = "", price = 0.0 }
  }
  assert(failed, "a missing field is an error")
}

test "FT.SEARCH reads RESP2's flat array in the order the flags imply" {
  let flat = arr(
    [
      Reply.Int(2),
      sbulk("a"), sbulk("0.5"), arr([sbulk("name"), sbulk("x"), sbulk("n"), sbulk("3")]),
      sbulk("b"), sbulk("0.25"), arr([sbulk("name"), sbulk("y")]),
    ],
  )
  let got = asSearchResult(flat, SearchOptions{ withScores = true }) catch e {
    panic("flat: ${e.message()}")
  }
  assert(got.total == 2 && len(got.hits) == 2, "two")
  assert(
    got.hits[0].score == Option.Some(0.5) && got.hits[0].field("n") == Option.Some("3"),
    "first",
  )
  assert(
    got.hits[1].field("name") == Option.Some("y") && got.hits[1].field("n") == Option.None,
    "second",
  )
  let ids = arr([Reply.Int(2), sbulk("a"), sbulk("b")])
  let g2 = asSearchResult(ids, SearchOptions{ noContent = true }) catch e {
    panic("ids: ${e.message()}")
  }
  assert(len(g2.hits) == 2 && g2.hits[1].id == "b" && len(g2.hits[1].fields) == 0, "nocontent")
  assert(
    searchFails(arr([Reply.Int(2), sbulk("a"), sbulk("b"), sbulk("c")]), SearchOptions{}),
    "a stride mismatch is an error",
  )
}

test "FT.AGGREGATE lays out LOAD first and the steps in order, with a cursor" {
  let p = agg().load("price", "@brand").groupBy(
    ["brand"],
    [Reducer{ reduce = Reduce.Avg("price"), alias = "avg" }, Reducer{ reduce = Reduce.Count }],
  ).apply("@avg * 2", "double").sortBy("avg", desc = true, max = 3).filter("@avg > 1").limit(0, 5)
  let o = AggregateOptions{
    verbatim = true,
    timeout = Option.Some(100),
    cursor = Option.Some(CursorOptions{ count = 2, maxIdle = 1000 }),
  }
  assertArgs(
    aggregateArgs("idx", everything(), p, o),
    [
      "FT.AGGREGATE", "idx", "*", "VERBATIM", "LOAD", "2", "price", "@brand", "TIMEOUT", "100", "GROUPBY", "1",
      "@brand", "REDUCE", "AVG", "1", "@price", "AS", "avg", "REDUCE", "COUNT", "0", "APPLY", "@avg * 2", "AS",
      "double", "SORTBY", "2", "@avg", "DESC", "MAX", "3", "FILTER", "@avg > 1", "LIMIT", "0", "5", "WITHCURSOR",
      "COUNT", "2", "MAXIDLE", "1000",
    ],
  )
  assertArgs(
    aggregateArgs("idx", knn("e", [1.0], 1), agg().loadAll(), AggregateOptions{}),
    [
      "FT.AGGREGATE", "idx", "*=>[KNN 1 @e $knnvec]", "LOAD", "*", "PARAMS", "2", "knnvec", "\x00\x00\x80\x3f",
      "DIALECT", "2",
    ],
  )
  assert(
    aggregateCmd("i", everything(), agg(), AggregateOptions{}).readOnly,
    "plain is a read",
  )
  assert(
    !aggregateCmd("i", everything(), agg(), o).readOnly,
    "cursor creation is not retried",
  )
}

test "every REDUCE function names its arguments" {
  let calls = [
    Reduce.CountDistinct("a"), Reduce.CountDistinctIsh("a"), Reduce.Sum("a"), Reduce.Min("a"), Reduce.Max("a"),
    Reduce.StdDev("a"), Reduce.Quantile("a", 0.5), Reduce.ToList("a"), Reduce.FirstValue("a"),
    Reduce.FirstValueBy("a", "b", true), Reduce.FirstValueBy("a", "b", false), Reduce.RandomSample(
      "a",
      3,
    ),
  ]
  let want = [
    "COUNT_DISTINCT 1 @a", "COUNT_DISTINCTISH 1 @a", "SUM 1 @a", "MIN 1 @a", "MAX 1 @a", "STDDEV 1 @a",
    "QUANTILE 2 @a 0.5", "TOLIST 1 @a", "FIRST_VALUE 1 @a", "FIRST_VALUE 4 @a BY @b DESC",
    "FIRST_VALUE 3 @a BY @b", "RANDOM_SAMPLE 2 @a 3",
  ]
  let i = 0
  while (i < len(calls)) {
    let got = reduceCall(calls[i])
    let text = ""
    for t of got {
      if (text != "") {
        text = text + " "
      }
      text = text + t
    }
    assert(text == want[i], "${i}: ${text}")
    i = i + 1
  }
}

test "FT.AGGREGATE reads RESP3 maps, RESP2 arrays and the cursor pair" {
  let row3 = Reply.Map(
    [
      spair("extra_attributes", Reply.Map([spair("brand", sbulk("acme")), spair("n", sbulk("2"))])),
      spair("values", arr([])),
    ],
  )
  let body3 = Reply.Map([spair("results", arr([row3])), spair("total_results", Reply.Int(1))])
  let got = asAggResult(body3) catch e {
    panic("map: ${e.message()}")
  }
  assert(
    got.total == 1 && got.cursor == 0 && got.rows[0].field("brand") == Option.Some("acme"),
    "map",
  )
  assert(
    got.rows[0].num("n") == Option.Some(2.0) && got.rows[0].num("brand") == Option.None,
    "num",
  )

  let paired = asAggResult(arr([body3, Reply.Int(77)])) catch e {
    panic("pair: ${e.message()}")
  }
  assert(paired.cursor == 77 && len(paired.rows) == 1, "cursor pair")

  let flat = arr([Reply.Int(1), arr([sbulk("brand"), sbulk("zeta")])])
  let g2 = asAggResult(flat) catch e {
    panic("flat: ${e.message()}")
  }
  assert(g2.rows[0].field("brand") == Option.Some("zeta") && g2.cursor == 0, "flat")
  let pf = asAggResult(arr([flat, Reply.Int(5)])) catch e {
    panic("flat pair: ${e.message()}")
  }
  assert(pf.cursor == 5 && len(pf.rows) == 1, "flat pair")
}

test "FT.INFO, FT.SPELLCHECK, FT.SUGGET and FT.SYNDUMP decode" {
  let attr = Reply.Map(
    [
      spair("identifier", sbulk("name")),
      spair("attribute", sbulk("name")),
      spair("type", sbulk("TEXT")),
      spair("flags", arr([sbulk("SORTABLE")])),
    ],
  )
  let info = Reply.Map(
    [
      spair("index_name", sbulk("idx")),
      spair(
        "index_definition",
        Reply.Map([spair("key_type", sbulk("HASH")), spair("prefixes", arr([sbulk("p:")]))]),
      ),
      spair("attributes", arr([attr])),
      spair("num_docs", Reply.Int(3)),
      spair("indexing", Reply.Int(0)),
      spair("percent_indexed", Reply.Double(1.0)),
      spair("hash_indexing_failures", Reply.Int(1)),
    ],
  )
  let i = asSearchInfo(info) catch e {
    panic("info: ${e.message()}")
  }
  assert(i.name == "idx" && i.keyType == "HASH" && i.prefixes[0] == "p:" && i.numDocs == 3, "info")
  assert(i.fields[0].kind == "TEXT" && i.fields[0].flags[0] == "SORTABLE" && !i.indexing, "field")
  assert(i.percentIndexed == 1.0 && i.indexingFailures == 1, "numbers")

  let sp3 = Reply.Map(
    [
      spair(
        "results",
        Reply.Map([spair("shue", arr([Reply.Map([spair("shoe", Reply.Double(0.5))])]))]),
      ),
    ],
  )
  let m = asSpellcheck(sp3) catch e {
    panic("spell3: ${e.message()}")
  }
  assert(
    m[0].term == "shue" && m[0].suggestions[0].member == "shoe" && m[0].suggestions[0].score == 0.5,
    "spell3",
  )
  let sp2 = arr([arr([sbulk("TERM"), sbulk("shue"), arr([arr([sbulk("0.5"), sbulk("shoe")])])])])
  let m2 = asSpellcheck(sp2) catch e {
    panic("spell2: ${e.message()}")
  }
  assert(m2[0].suggestions[0].member == "shoe" && m2[0].suggestions[0].score == 0.5, "spell2")

  let sg = asSuggestions(
    arr(
      [sbulk("help"), Reply.Double(1.5), sbulk("x"), sbulk("hello"), Reply.Double(0.5), Reply.Null],
    ),
    SuggestOptions{ withScores = true, withPayloads = true },
  ) catch e {
    panic("sugget: ${e.message()}")
  }
  assert(
    sg[0].text == "help" && sg[0].score == Option.Some(1.5) && sg[0].payload == Option.Some("x"),
    "sug0",
  )
  assert(sg[1].payload == Option.None, "sug1")
  let plain = asSuggestions(arr([sbulk("a"), sbulk("b")]), SuggestOptions{}) catch e {
    panic("plain: ${e.message()}")
  }
  assert(len(plain) == 2 && plain[1].text == "b" && plain[0].score == Option.None, "plain")
  assertArgs(
    sugGetArgs(
      "k",
      "he",
      SuggestOptions{ fuzzy = true, max = Option.Some(3), withScores = true, withPayloads = true },
    ),
    ["FT.SUGGET", "k", "he", "FUZZY", "WITHSCORES", "WITHPAYLOADS", "MAX", "3"],
  )
  assertArgs(
    sugAddCmd("k", "t", 2.0, true, Option.Some("p")).args,
    ["FT.SUGADD", "k", "t", "2", "INCR", "PAYLOAD", "p"],
  )
  assertArgs(
    spellArgs(
      "idx",
      "q",
      SpellOptions{
        distance = Option.Some(2),
        include = ["d1"],
        exclude = ["d2"],
        dialect = Option.Some(2),
      },
    ),
    [
      "FT.SPELLCHECK",
      "idx",
      "q",
      "DISTANCE",
      "2",
      "TERMS",
      "INCLUDE",
      "d1",
      "TERMS",
      "EXCLUDE",
      "d2",
      "DIALECT",
      "2",
    ],
  )
  let syn = asSynonyms(
    Reply.Map([spair("boot", arr([sbulk("g1")])), spair("shoe", arr([sbulk("g1")]))]),
  ) catch e {
    panic("syn: ${e.message()}")
  }
  assert(len(syn) == 2 && syn[0].term == "boot" && syn[0].groups[0] == "g1", "syndump")
}

test "dictionary commands preserve arguments, counts and both dump protocols" {
  let add = dictAddCmd("spelling", ["shoe", "hello world", "shoe"])
  let del = dictDelCmd("spelling", ["boot", "absent"])
  let dump = dictDumpCmd("spelling")
  assertArgs(add.args, ["FT.DICTADD", "spelling", "shoe", "hello world", "shoe"])
  assertArgs(del.args, ["FT.DICTDEL", "spelling", "boot", "absent"])
  assertArgs(dump.args, ["FT.DICTDUMP", "spelling"])
  assert(!add.readOnly && !del.readOnly && dump.readOnly, "dictionary read flags")
  assert(
      (add.decode(Reply.Int(2)) catch _ {
        -1
      }) ==
      2,
    "new terms count",
  )
  assert(
      (del.decode(Reply.Int(1)) catch _ {
        -1
      }) ==
      1,
    "deleted terms count",
  )
  for r of [Reply.Array(Option.Some([sbulk("shoe")])), Reply.Set([sbulk("shoe")])] {
    let terms = dump.decode(r) catch e {
      panic(e.message())
    }
    assertArgs(terms, ["shoe"])
  }
  for r of [Reply.Array(Option.Some([]Reply(0))), Reply.Set([]Reply(0))] {
    let terms = dump.decode(r) catch e {
      panic(e.message())
    }
    assert(len(terms) == 0, "empty dictionary")
  }
}

test "dictionary commands reject malformed replies and server errors" {
  let failed = 0
  let _ = dictAddCmd("d", ["a"]).decode(sbulk("bad")) catch _ {
    failed = failed + 1
    0
  }
  let _ = dictDelCmd("d", ["a"]).decode(Reply.Err("ERR refused")) catch _ {
    failed = failed + 1
    0
  }
  let _ = dictDumpCmd("d").decode(Reply.Int(1)) catch _ {
    failed = failed + 1
    []string(0)
  }
  let _ = dictDumpCmd("d").decode(Reply.Set([Reply.Int(1)])) catch _ {
    failed = failed + 1
    []string(0)
  }
  let _ = dictDumpCmd("d").decode(Reply.Err("ERR absent")) catch _ {
    failed = failed + 1
    []string(0)
  }
  assert(failed == 5, "five invalid replies refused")
}

test "dictionary writes are refused on tx.read and SearchBatch queues the same commands" {
  let read = TxRead{ conn = redisConn{ closed = AtomicI64(0) }, timeoutNs = 0 }.search("d")
  let refused = 0
  let _ = read.dictAdd(["a"]) catch e {
    assert(isInvalid(e), e.message())
    refused = refused + 1
    0
  }
  let _ = read.dictDel(["a"]) catch e {
    assert(isInvalid(e), e.message())
    refused = refused + 1
    0
  }
  assert(refused == 2, "both writes refused before I/O")
  let batch = Batch()
  let s = SearchBatch{ batch = batch, name = "d" }
  let added = s.dictAdd(["a", "b"])
  let deleted = s.dictDel(["a"])
  let terms = s.dictDump()
  assert(len(batch.queued) == 3, "three queued commands")
  assertArgs(batch.queued[0], dictAddCmd("d", ["a", "b"]).args)
  assertArgs(batch.queued[1], dictDelCmd("d", ["a"]).args)
  assertArgs(batch.queued[2], dictDumpCmd("d").args)
  batch.box.replies = [Reply.Int(2), Reply.Int(1), Reply.Set([sbulk("b")])]
  batch.box.ready = true
  assert(
      (added.get() catch _ {
        -1
      }) ==
      2,
    "queued add count",
  )
  assert(
      (deleted.get() catch _ {
        -1
      }) ==
      1,
    "queued delete count",
  )
  assertArgs(
    terms.get() catch e {
      panic(e.message())
    },
    ["b"],
  )
}

fn searchIndexFieldFails(r: Reply): bool {
  let failed = false
  let _ = indexFieldOf(r) catch _ {
    failed = true
    IndexField{ identifier = "", attribute = "", kind = "", flags = []string(0) }
  }
  return failed
}

test "FT.INFO optional flags accepts the captured RESP2 GEOSHAPE attribute list" {
  let attribute = arr(
    [
      sbulk("identifier"), sbulk("area"), sbulk("attribute"), sbulk("area"),
      sbulk("type"), sbulk("GEOSHAPE"), sbulk("coord_system"), sbulk("FLAT"),
    ],
  )
  let info = asSearchInfo(
    arr(
      [
        sbulk("index_name"), sbulk("geometry"), sbulk("attributes"), arr([attribute]),
        sbulk("num_docs"), Reply.Int(0),
      ],
    ),
  ) catch e {
    panic(e.message())
  }
  assert(info.name == "geometry" && len(info.fields) == 1, "captured index")
  let field = info.fields[0]
  assert(
    field.identifier == "area" && field.attribute == "area" && field.kind == "GEOSHAPE",
    "required fields",
  )
  assert(len(field.flags) == 0, "absent optional flags are empty")
}

test "FT.INFO optional flags preserves present arrays and sets" {
  for flags of [arr([sbulk("SORTABLE")]), Reply.Set([sbulk("SORTABLE")])] {
    let field = indexFieldOf(
      Reply.Map(
        [
          spair("identifier", sbulk("price")), spair("attribute", sbulk("price")),
          spair("type", sbulk("NUMERIC")), spair("flags", flags),
        ],
      ),
    ) catch e {
      panic(e.message())
    }
    assertArgs(field.flags, ["SORTABLE"])
  }
}

test "FT.INFO optional flags rejects malformed values and missing required fields" {
  let required = [
    spair("identifier", sbulk("area")),
    spair("attribute", sbulk("area")),
    spair("type", sbulk("GEOSHAPE")),
  ]
  for missing of ["identifier", "attribute", "type"] {
    let fields = []MapEntry(0)
    for pair of required {
      if ((replyToString(pair.key, "FT.INFO") catch e {
          panic(e.message())
        }) !=
        missing) {
        fields = append(fields, pair)
      }
    }
    assert(searchIndexFieldFails(Reply.Map(fields)), "missing ${missing} rejected")
  }
  for flags of [Reply.Null, Reply.Int(1), arr([Reply.Int(1)])] {
    assert(
      searchIndexFieldFails(Reply.Map(append(required, spair("flags", flags)))),
      "malformed flags rejected",
    )
  }
}
