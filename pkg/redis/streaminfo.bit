// pkg/redis/streaminfo.bit - `XINFO`: what a stream, its groups and a group's
// consumers look like from the server's side. Epic #6013, #6035. Reached by
// `Stream.info`, `Stream.groups` and `Group.consumers` (`stream.bit`,
// `streamgroup.bit`).
//
// THE REPLIES ARE NAMED PAIRS. RESP3 answers `XINFO` with maps, RESP2 with
// flat `[name, value, ...]` arrays; `infoPairs` reads either as one list and
// every field is then looked up by name, so a field a newer server adds is
// ignored and one an older server lacks reads as 0 / "" / `None`, never as a
// decode failure.

// `XINFO STREAM`. `lastGeneratedId` is the id the next automatic one must
// exceed, `entriesAdded` counts every entry ever appended (including deleted
// ones), `groups` how many consumer groups exist.
export class StreamInfo {
  export length: i64,
  export radixTreeKeys: i64,
  export radixTreeNodes: i64,
  export lastGeneratedId: string,
  export maxDeletedEntryId: string,
  export entriesAdded: i64,
  export recordedFirstEntryId: string,
  export groups: i64,
  export firstEntry: Option<Entry>,
  export lastEntry: Option<Entry>,
}

// `XINFO GROUPS`. `lag` is how many entries the group has yet to be given,
// `None` when the server cannot tell (after deletions in the middle of the
// stream); `entriesRead` is `None` for a group created without it.
export class GroupInfo {
  export name: string,
  export consumers: i64,
  export pending: i64,
  export lastDeliveredId: string,
  export entriesRead: Option<i64>,
  export lag: Option<i64>,
}

// `XINFO CONSUMERS`. `idle` is the time since the consumer's last attempt to
// read or claim, `inactive` since its last successful one (`None` before Redis
// 7.2.0); both nanoseconds.
export class ConsumerInfo {
  export name: string,
  export pending: i64,
  export idle: int,
  export inactive: Option<int>,
}

fn xinfoStreamCmd(key: string): Cmd<StreamInfo> {
  return Cmd<StreamInfo>{
    args = ["XINFO", "STREAM", key],
    decode = (r) => asStreamInfo(r),
    readOnly = true,
  }
}

fn xinfoGroupsCmd(key: string): Cmd<[]GroupInfo> {
  return Cmd<[]GroupInfo>{
    args = ["XINFO", "GROUPS", key],
    decode = (r) => asGroupInfos(r),
    readOnly = true,
  }
}

fn xinfoConsumersCmd(key: string, group: string): Cmd<[]ConsumerInfo> {
  return Cmd<[]ConsumerInfo>{
    args = ["XINFO", "CONSUMERS", key, group],
    decode = (r) => asConsumerInfos(r),
    readOnly = true,
  }
}

// A map reply or a flat name/value array as one list of pairs.
fn infoPairs(r: Reply): []MapEntry!RedisError {
  match (r) {
    Map(pairs) => return pairs
    Array(items) => return pairsFromFlat(unwrapOr(items, []Reply(0)))?
    _ => fail RedisError.Unexpected("XINFO", shapeName(r))
  }
}

fn pairsFromFlat(list: []Reply): []MapEntry!RedisError {
  if (len(list) % 2 != 0) {
    fail RedisError.Unexpected("XINFO", "Array")
  }
  let out = []MapEntry(0)
  let i = 0
  while (i < len(list)) {
    out = append(out, MapEntry{ key = list[i], value = list[i + 1] })
    i = i + 2
  }
  return out
}

// The value called `name`, `Reply.Null` when the server did not send it.
fn infoFind(pairs: []MapEntry, name: string): Reply {
  let i = 0
  while (i < len(pairs)) {
    let k = replyToString(pairs[i].key, "XINFO") catch _ {
      ""
    }
    if (k == name) {
      return pairs[i].value
    }
    i = i + 1
  }
  return Reply.Null
}

fn infoInt(pairs: []MapEntry, name: string): i64!RedisError {
  let r = infoFind(pairs, name)
  match (r) {
    Null => return 0
    _ => return asInt(r, "XINFO")?
  }
}

fn infoOptInt(pairs: []MapEntry, name: string): Option<i64>!RedisError {
  let r = infoFind(pairs, name)
  match (r) {
    Null => return Option.None
    _ => return Option.Some(asInt(r, "XINFO")?)
  }
}

fn infoStr(pairs: []MapEntry, name: string): string!RedisError {
  let r = infoFind(pairs, name)
  match (r) {
    Null => return ""
    _ => return replyToString(r, "XINFO")?
  }
}

// An entry, or `None` for the nil an empty stream sends.
fn infoEntry(pairs: []MapEntry, name: string): Option<Entry>!RedisError {
  let r = infoFind(pairs, name)
  match (r) {
    Null => return Option.None
    _ => return Option.Some(asEntry(r, "XINFO")?)
  }
}

fn infoNanos(pairs: []MapEntry, name: string): Option<int>!RedisError {
  let ms = infoOptInt(pairs, name)?
  match (ms) {
    Some(n) => return Option.Some(n * Millisecond)
    None => return Option.None
  }
}

fn asStreamInfo(r: Reply): StreamInfo!RedisError {
  let p = infoPairs(r)?
  return StreamInfo{
    length = infoInt(p, "length")?,
    radixTreeKeys = infoInt(p, "radix-tree-keys")?,
    radixTreeNodes = infoInt(p, "radix-tree-nodes")?,
    lastGeneratedId = infoStr(p, "last-generated-id")?,
    maxDeletedEntryId = infoStr(p, "max-deleted-entry-id")?,
    entriesAdded = infoInt(p, "entries-added")?,
    recordedFirstEntryId = infoStr(p, "recorded-first-entry-id")?,
    groups = infoInt(p, "groups")?,
    firstEntry = infoEntry(p, "first-entry")?,
    lastEntry = infoEntry(p, "last-entry")?,
  }
}

fn asGroupInfos(r: Reply): []GroupInfo!RedisError {
  match (r) {
    Array(items) => return groupInfosFromList(unwrapOr(items, []Reply(0)))?
    _ => fail RedisError.Unexpected("XINFO", shapeName(r))
  }
}

fn groupInfosFromList(list: []Reply): []GroupInfo!RedisError {
  let out = []GroupInfo(len(list))
  let i = 0
  while (i < len(list)) {
    out[i] = asGroupInfo(list[i])?
    i = i + 1
  }
  return out
}

fn asGroupInfo(r: Reply): GroupInfo!RedisError {
  let p = infoPairs(r)?
  return GroupInfo{
    name = infoStr(p, "name")?,
    consumers = infoInt(p, "consumers")?,
    pending = infoInt(p, "pending")?,
    lastDeliveredId = infoStr(p, "last-delivered-id")?,
    entriesRead = infoOptInt(p, "entries-read")?,
    lag = infoOptInt(p, "lag")?,
  }
}

fn asConsumerInfos(r: Reply): []ConsumerInfo!RedisError {
  match (r) {
    Array(items) => return consumerInfosFromList(unwrapOr(items, []Reply(0)))?
    _ => fail RedisError.Unexpected("XINFO", shapeName(r))
  }
}

fn consumerInfosFromList(list: []Reply): []ConsumerInfo!RedisError {
  let out = []ConsumerInfo(len(list))
  let i = 0
  while (i < len(list)) {
    out[i] = asConsumerInfo(list[i])?
    i = i + 1
  }
  return out
}

fn asConsumerInfo(r: Reply): ConsumerInfo!RedisError {
  let p = infoPairs(r)?
  let idle = infoNanos(p, "idle")?
  return ConsumerInfo{
    name = infoStr(p, "name")?,
    pending = infoInt(p, "pending")?,
    idle = unwrapOr(idle, 0),
    inactive = infoNanos(p, "inactive")?,
  }
}
