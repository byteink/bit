// pkg/redis/client.bit — a connection to a Redis (or RESP2-compatible)
// server: `connect`, six named commands, and `command()`, a generic escape
// hatch so a command this package has not wrapped yet never blocks a caller.
//
// `Client` implements `resp.bit`'s `byteSource` directly (its `readUp`
// method below), so `decodeReply` runs unmodified over the live connection —
// the same interface `resp.test.bit`'s `fakeSource` implements over a plain
// captured buffer, with no socket at all.

import { Conn, dial } from "std/net"

export class Client { conn: Conn, buf: string }

fn (c: Client) readUp(n: int): string! {
  return c.conn.read(n)
}

// Connects to a Redis server at `host:port`. Plain TCP, no auth, no TLS —
// the same scope `std/net` itself has.
export fn connect(host: string, port: int): Client! {
  let conn = dial(host, port)?
  return Client{ conn: conn, buf: "" }
}

export fn (c: Client) close() {
  c.conn.close()
}

// The generic escape hatch (#3466): sends any command, returns its raw
// decoded `Reply`, so a command this package has not wrapped yet never
// blocks a caller. A `-ERR ...` reply is surfaced as a `fail`, exactly like
// any other failure — a caller distinguishes the two only by message, same
// as any other `error`.
export fn (c: Client) command(args: []string): Reply! {
  c.conn.write(encodeCommand(args))?
  let (reply, rest) = decodeReply(c, c.buf)?
  c.buf = rest
  return checkError(reply)?
}

fn checkError(r: Reply): Reply! {
  match (r) {
    Err(msg) => fail newError("redis: ${msg}")
    _ => return r
  }
}

// A cache miss decodes to `Option.None`, never `Option.Some("")` — the null
// vs. empty distinction `resp.bit`'s `decodeBulk` exists to preserve, carried
// all the way through to this package's own public API.
export fn (c: Client) get(key: string): Option<string>! {
  let r = c.command(["GET", key])?
  match (r) {
    Bulk(v) => return v
    _ => fail newError("redis: GET: unexpected reply type")
  }
}

export fn (c: Client) set(key: string, value: string): ()! {
  let r = c.command(["SET", key, value])?
  match (r) {
    Simple(_) => return
    _ => fail newError("redis: SET: unexpected reply type")
  }
}

fn withKeys(cmd: string, keys: []string): []string {
  let args = [cmd]
  let i = 0
  while (i < len(keys)) {
    args = append(args, keys[i])
    i = i + 1
  }
  return args
}

export fn (c: Client) del(keys: []string): i64! {
  let r = c.command(withKeys("DEL", keys))?
  match (r) {
    Int(n) => return n
    _ => fail newError("redis: DEL: unexpected reply type")
  }
}

export fn (c: Client) exists(keys: []string): i64! {
  let r = c.command(withKeys("EXISTS", keys))?
  match (r) {
    Int(n) => return n
    _ => fail newError("redis: EXISTS: unexpected reply type")
  }
}

export fn (c: Client) expire(key: string, seconds: i64): bool! {
  let r = c.command(["EXPIRE", key, "${seconds}"])?
  match (r) {
    Int(n) => return n != 0
    _ => fail newError("redis: EXPIRE: unexpected reply type")
  }
}

export fn (c: Client) ping(): string! {
  let r = c.command(["PING"])?
  match (r) {
    Simple(s) => return s
    Bulk(v) => return unwrapOr(v, "")
    _ => fail newError("redis: PING: unexpected reply type")
  }
}
