// pkg/redis/client.bit — `open(url)`/`connect(Options)`: a pooled `Client`
// over `conn.bit`'s physical connections (epic #6013, #6022). Replaces the
// v0.1 `connect(host, port)`'s single, unauthenticated, plaintext socket.
//
// `Client` IS A THIN WRAPPER OVER `std/sync.Pool<redisConn>` (#6020).
// `command()` acquires a lease, runs one round trip, and releases it —
// healthy back to the pool, or retired (`ok = false`) when `conn.bit`'s
// `classifyTransportError`/`classifyDecodeError` reported `Io`, `Timeout` or
// `Protocol`: exactly the failures that leave the physical connection in an
// unknown state. A server-side failure (`WRONGTYPE`, `WRONGPASS`, ...)
// leaves the connection itself fine, so it goes back healthy.
//
// RECONNECT IS FOR READS ONLY. `readCommand` retries once, on a fresh
// connection, when the failure is both `retryable()` (errors.bit: a
// transport failure, a timeout, or a server condition expected to clear) and
// one that already retired the connection — never for a write (`command`),
// per epic #6013's own ticket text: a retried `SET` could silently double an
// increment a caller only meant to run once.
//
// `Reply` FROM THE ESCAPE HATCH: RESP3 attributes are unwrapped before ANY
// reply reaches a caller (#6018's note on this ticket) and the most recent
// reply's attributes are kept on `Client` — `lastAttributes()` — for a
// caller (client-side caching, later) that needs them; `command()`'s return
// value is always the reply the attribute decorated, never the attribute
// map itself.

import { Pool, PoolOptions } from "std/sync"

export class Client {
  pool: Pool<redisConn>
  opts: Options
  lastAttrs: []MapEntry

  // The RESP3 attribute map (if any) that decorated the most recent reply —
  // empty when there was none. Overwritten by every call to `command`/
  // `readCommand`, including through `get`/`set`/... below.
  export lastAttributes(): []MapEntry {
    return this.lastAttrs
  }

  export close() {
    this.pool.close()
  }

  // The generic escape hatch (#3466): sends any command, returns its raw
  // decoded, attribute-unwrapped `Reply`. Never retried — see this file's
  // header.
  export command(args: []string): Reply!RedisError {
    return this.doCommand(args, false)?
  }

  // Like `command`, but a `retryable()` failure that left the connection
  // unusable is retried once, on a fresh connection from the pool — for a
  // read, where running it twice is safe.
  readCommand(args: []string): Reply!RedisError {
    return this.doCommand(args, true)?
  }

  doCommand(args: []string, allowRetry: bool): Reply!RedisError {
    let lease = this.pool.acquire() catch e {
      fail RedisError.Io(e.message())
    }
    let r = rawCommand(lease.value, args, this.opts.commandTimeout) catch e {
      this.pool.release(lease, !connectionBad(e))
      if (allowRetry && e.retryable() && connectionBad(e)) {
        return this.doCommand(args, false)?
      }
      fail e
    }
    this.lastAttrs = lease.value.lastAttrs
    this.pool.release(lease, true)
    return r
  }

  // Runs `cmd` now (#6028's `Cmd<T>` — see `cmd.bit`'s header), picking the
  // same retry policy `command()`/`readCommand()` always have from
  // `cmd.readOnly`. The immediate half of the one-command-definition-per-
  // family contract; `Pipeline.queue`/`Tx.queue` are the queued halves.
  export runCmd<T>(cmd: Cmd<T>): T!RedisError {
    if (cmd.readOnly) {
      let r = this.readCommand(cmd.args)?
      return cmd.decode(r)?
    }
    let r = this.command(cmd.args)?
    return cmd.decode(r)?
  }

  // Runs `f` over one leased connection, releasing it exactly once `f`
  // returns or fails — for a caller that needs more than one round trip on
  // the SAME physical connection before releasing it (`pipeline.bit`'s
  // batch, `tx.bit`'s WATCH/MULTI/.../EXEC). Never retried: with more than
  // one command in flight there is no single command to safely replay.
  //
  // THE CONNECTION GOES BACK TO THE POOL ONLY WHEN ITS PROTOCOL STATE IS
  // PROVABLY CLEAN (`connClean`, `conn.bit`), whatever `f` returned: a server
  // error that left replies unread or MULTI open would otherwise hand the
  // next caller someone else's reply (#7434). `f` is expected to drain and
  // DISCARD itself (`tx.bit`'s `abortTx`); this is the safety net for when it
  // could not, e.g. a read timeout in the middle of that cleanup.
  export withConn<T>(f: (redisConn) => T!RedisError): T!RedisError {
    let lease = this.pool.acquire() catch e {
      fail RedisError.Io(e.message())
    }
    let v = f(lease.value) catch e {
      this.pool.release(lease, !connectionBad(e) && connClean(lease.value))
      fail e
    }
    this.lastAttrs = lease.value.lastAttrs
    this.pool.release(lease, connClean(lease.value))
    return v
  }

  // A cache miss decodes to `Option.None`, never `Option.Some("")` — the null
  // vs. empty distinction `resp.bit`'s `decodeBulk` exists to preserve, carried
  // all the way through to this package's own public API.
  export get(key: string): Option<string>!RedisError {
    return this.runCmd(getCmd(key))?
  }

  // `ttl` is nanoseconds (`std/time.Second`/`Millisecond`), sent as `PX
  // milliseconds` — the same "one field, converted to each wire command's
  // own unit" convention `hash.bit`'s field-expiry methods already use.
  // `ttl == -1` sends `KEEPTTL` instead: a numeric sentinel, not a fifth
  // `keepTtl: bool` parameter, is what keeps this method at spec/LINT.md's
  // five-parameter ceiling (E0202 — a method receiver does not count, but
  // `key, value, ttl, ifAbsent, ifExists` alone is already five) while still
  // landing epic #6013's own flagship call verbatim: `r.set("k", "v", ttl =
  // 60 * Second, ifAbsent = true)?`. `ttl == 0` (the default) sends neither
  // flag, matching plain `SET`'s own behavior of clearing any TTL the key
  // already had. `ifAbsent`/`ifExists` are `NX`/`XX`; passing both `true` is
  // a caller mistake the server itself rejects with a normal `RedisError`
  // (Redis's own `ERR syntax error`), so there is nothing to validate
  // client-side — the same reasoning `hash.bit`'s `when` condition flags
  // already documented for the identical situation.
  //
  // Returns `true` when the key was actually written, `false` only when
  // `ifAbsent`/`ifExists` refused it (the reply is a null bulk, not `+OK`,
  // exactly when the condition failed) — never a silent no-op a caller
  // could mistake for success. A plain `set(key, value)` call (no flags)
  // always returns `true` or fails.
  export set(
    key: string,
    value: string,
    ttl: int = 0,
    ifAbsent: bool = false,
    ifExists: bool = false,
  ): bool!RedisError {
    return this.runCmd(setOptsCmd(key, value, ttl, ifAbsent, ifExists))?
  }

  // `SET ... GET` — atomically returns the key's PREVIOUS value
  // (`Option.None` if it had none) instead of whether the write happened.
  // A separate method from `set`, not an extra return value on it: the two
  // calls' return types genuinely differ (`bool` vs `Option<string>`), and
  // Bit has no overloading (#6014's probes) to let one method name cover
  // both. Same option set as `set` (this method's header, above).
  export setGet(
    key: string,
    value: string,
    ttl: int = 0,
    ifAbsent: bool = false,
    ifExists: bool = false,
  ): Option<string>!RedisError {
    return this.runCmd(setGetCmd(key, value, ttl, ifAbsent, ifExists))?
  }

  export del(keys: []string): i64!RedisError {
    return this.runCmd(delCmd(keys))?
  }

  export exists(keys: []string): i64!RedisError {
    return this.runCmd(existsCmd(keys))?
  }

  export expire(key: string, seconds: i64): bool!RedisError {
    return this.runCmd(expireCmd(key, seconds))?
  }

  export ping(): string!RedisError {
    return this.runCmd(pingCmd())?
  }

  // `INFO` / `INFO section` — the server's report as the raw `name:value`
  // text (`redis_version:7.2.4\r\n...`), whichever of RESP2's bulk string or
  // RESP3's verbatim string the connection negotiated. `section` is an
  // `InfoSection` (`info.bit`), so a mistyped name is a compile error;
  // `InfoSection.Default` (the default) sends plain `INFO`.
  export info(section: InfoSection = InfoSection.Default): string!RedisError {
    return this.runCmd(infoCmd(section))?
  }

  // `let p = r.pipeline(); let b = p.counter("n").incr(); p.exec()?;
  // b.get()?` — an empty batch, ready to `queue` into (`pipeline.bit`).
  export pipeline(): Pipeline {
    return Pipeline{ client = this, batch = Batch() }
  }

  // `let bal = r.transaction(["balance"], (tx) => { return tx.get("balance") })?`
  // — WATCH every key, run `body` to queue commands client-side, MULTI/.../
  // EXEC over the wire, retried on a nil EXEC (a WATCHed key changed) up to
  // a bounded count (`tx.bit`). Hands back `body`'s own return value — its
  // `Future<T>`s, once `EXEC` has committed and filled them — rather than
  // discarding it the way an earlier version of this method did; `tx.bit`'s
  // header covers why a retry can never hand back a stale one.
  export transaction<R>(keys: []string, body: (Tx) => R!RedisError): R!RedisError {
    return runTransaction<R>(this, keys, body)?
  }

  // One typed handle accessor per data-type family (epic #6013's SPINE),
  // each a cheap value over `this` and the key — every family file is
  // scaffold-only today (#6028); a follow-up ticket per family adds its
  // commands, following `cmd.bit`'s header.
  export str(key: string): Str { return Str{ client = this, key = key } }
  // `Counter`'s immediate handle takes a `runner: Runner`, not a
  // `client: Client` — the one shape `Client.counter` and a transaction
  // body's `tx.read.counter` both build (`cmd.bit`'s header, #6029); every
  // other family below is still scaffold-only (#6028) and moves to the same
  // shape as its own commands land.
  export counter(key: string): Counter { return Counter{ runner = poolRunner(this), key = key } }
  export keys(): Keys { return Keys{ client = this } }
  export hash(key: string): Hash { return Hash{ client = this, key = key } }
  export list(key: string): List { return List{ client = this, key = key } }
  // `sset`, not `set` — `Client.set` is already the plain string `SET`
  // command (epic #6013's SPINE), and Bit has no overloading (#6014's
  // probes) to let both share a name.
  export sset(key: string): Set { return Set{ runner = poolRunner(this), key = key } }
  export zset(key: string): Zset { return Zset{ client = this, key = key } }
  export stream(key: string): Stream { return Stream{ runner = poolRunner(this), key = key } }
  export geo(key: string): Geo { return Geo{ client = this, key = key } }
  export hll(key: string): Hll { return Hll{ client = this, key = key } }
  export bitmap(key: string): Bitmap { return Bitmap{ client = this, key = key } }
  export json(key: string): Json { return Json{ client = this, key = key } }
  export timeseries(key: string): TimeSeries { return TimeSeries{ client = this, key = key } }
  export bloom(key: string): Bloom { return Bloom{ client = this, key = key } }
  export vset(key: string): VectorSet { return VectorSet{ client = this, key = key } }
  export array(key: string): Arr { return Arr{ client = this, key = key } }
}

// The six commands `Client` exposed before #6028, now each a `Cmd<T>`
// factory — `cmd.bit`'s header is the template every data-type family
// follows. `Pipeline`/`Tx` share these same factories (`pipeline.bit`,
// `tx.bit`), so a pipelined/transacted `GET`/`SET`/... decodes identically
// to Client's own.

fn getCmd(key: string): Cmd<Option<string>> {
  return Cmd<Option<string>>{
    args = ["GET", key],
    decode = (r) => asOptString(r, "GET"),
    readOnly = true,
  }
}

// A bare `+OK` reply, discarded — `SET` (below), plus `RENAME`/`MSET`
// (`keys.bit`, #6034), reuse this cross-file (same module, SPEC §17.1).
// Lives here rather than among `cmd.bit`'s shared decode helpers simply
// because `SET` was the first command that needed it.
fn asOk(r: Reply, cmd: string): ()!RedisError {
  match (r) {
    Simple(_) => return
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

// `Batch.set` (`cmd.bit`) still queues the plain, flag-free `SET` through
// this exact factory — kept as-is, not folded into `setOptsArgs` below,
// since `cmd.bit` is a shared file this ticket does not touch and already
// calls `setCmd(key, value)` expecting `Cmd<()>` back.
fn setCmd(key: string, value: string): Cmd<()> {
  return Cmd<()>{ args = ["SET", key, value], decode = (r) => asOk(r, "SET"), readOnly = false }
}

// `Client.set`/`setGet`'s wire args — this method's own header explains the
// `ttl` sentinel and why `ifAbsent`/`ifExists` are two plain bools.
fn appendSetTtl(args: []string, ttl: int): []string {
  if (ttl > 0) {
    args = append(args, "PX", "${ttl / Millisecond}")
    return args
  }
  if (ttl == -1) {
    args = append(args, "KEEPTTL")
  }
  return args
}

fn appendSetCond(args: []string, ifAbsent: bool, ifExists: bool): []string {
  if (ifAbsent) {
    args = append(args, "NX")
  }
  if (ifExists) {
    args = append(args, "XX")
  }
  return args
}

fn setOptsArgs(key: string, value: string, ttl: int, ifAbsent: bool, ifExists: bool): []string {
  let args = ["SET", key, value]
  args = appendSetTtl(args, ttl)
  args = appendSetCond(args, ifAbsent, ifExists)
  return args
}

// `true` on a bare `+OK`; `false` on the null bulk Redis sends when `NX`/
// `XX` refused the write — `Client.set`'s own header explains why that is
// a return value, not a failure.
fn asSetOk(r: Reply, cmd: string): bool!RedisError {
  match (r) {
    Simple(_) => return true
    Null => return false
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

fn setOptsCmd(key: string, value: string, ttl: int, ifAbsent: bool, ifExists: bool): Cmd<bool> {
  return Cmd<bool>{
    args = setOptsArgs(key, value, ttl, ifAbsent, ifExists),
    decode = (r) => asSetOk(r, "SET"),
    readOnly = false,
  }
}

// `SET ... GET` always replies with the previous value (or a null bulk) —
// the exact `Option<string>` shape `asOptString` already decodes for `GET`
// itself, regardless of whether `ifAbsent`/`ifExists` ultimately blocked
// the write.
fn setGetCmd(
  key: string,
  value: string,
  ttl: int,
  ifAbsent: bool,
  ifExists: bool,
): Cmd<Option<string>> {
  let args = setOptsArgs(key, value, ttl, ifAbsent, ifExists)
  args = append(args, "GET")
  return Cmd<Option<string>>{ args = args, decode = (r) => asOptString(r, "SET"), readOnly = false }
}

fn delCmd(keys: []string): Cmd<i64> {
  return Cmd<i64>{ args = withKeys("DEL", keys), decode = (r) => asInt(r, "DEL"), readOnly = false }
}

fn existsCmd(keys: []string): Cmd<i64> {
  return Cmd<i64>{
    args = withKeys("EXISTS", keys),
    decode = (r) => asInt(r, "EXISTS"),
    readOnly = true,
  }
}

fn expireCmd(key: string, seconds: i64): Cmd<bool> {
  return Cmd<bool>{
    args = ["EXPIRE", key, "${seconds}"],
    decode = (r) => asBool(r, "EXPIRE"),
    readOnly = false,
  }
}

// `PING`'s reply is `Simple` normally, `Bulk` when it carries a message
// argument (unused here) — a shape none of `cmd.bit`'s shared helpers
// matches, so it stays a short inline closure per that file's own guidance.
fn pingCmd(): Cmd<string> {
  return Cmd<string>{
    args = ["PING"],
    decode = (r) => {
      match (r) {
        Simple(s) => return s
        Bulk(v) => return unwrapOr(v, "")
        _ => fail RedisError.Unexpected("PING", shapeName(r))
      }
    },
    readOnly = true,
  }
}

// Whether `e` means the physical connection that produced it must not be
// reused — the `Io`/`Timeout`/`Protocol` set `conn.bit`'s two classifiers are
// restricted to. Every other `RedisError` (a server error) leaves the
// connection itself fine.
fn connectionBad(e: RedisError): bool {
  match (e) {
    Io(_) => return true
    Timeout => return true
    Protocol(_) => return true
    _ => return false
  }
}

// `open("redis://[user[:pass]@]host[:port][/db][?timeout=5s&pool=16&name=app]")`
// / `open("rediss://...")` for TLS. Parses the URL (`uri.bit`) and connects.
export fn open(url: string): Client!RedisError {
  let opts = parseUrl(url)?
  return connect(opts)?
}

// Connects with `opts` directly — the escape hatch `open` has no room for
// (a self-signed `tlsRootCa`, `insecureSkipVerify`, split connect/command
// timeouts).
//
// DIALS ONE CONNECTION EAGERLY, THEN CLOSES IT. `std/sync.Pool` itself dials
// lazily, on first `acquire` — fine for a pool's own reuse, but it would
// make `connect` "succeed" against a wrong password or an unreachable host
// and only fail on the caller's first command, which is not the DX a
// connection function should have (proved wrong live, #6022: `open` with a
// bad password returned a `Client` with an empty, never-dialled pool). The
// probe connection is thrown away rather than seeded into the pool — `Pool`
// has no API to hand it one already open — so `opts.poolSize` connections
// still exist only once callers actually use them.
export fn connect(opts: Options): Client!RedisError {
  let roots = tlsRootsFor(opts)?
  let probe = dialConn(opts, roots)?
  probe.close()
  let pool = Pool<redisConn>(
    () => dialConn(opts, roots)?,
    (c) => c.close(),
    (c) => true,
    PoolOptions{ maxSize = i64(opts.poolSize) },
  )
  return Client{ pool = pool, opts = opts, lastAttrs = []MapEntry(0) }
}

fn withKeys(cmd: string, keys: []string): []string {
  let args = [cmd]
  let i = 0
  while (i < len(keys)) {
    args = append(args, keys[i])
    i = i + 1
  }
  return args
}
