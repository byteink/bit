// pkg/redis/client.bit — `open(url)`/`connect(Options)`: a pooled `Client`
// over `conn.bit`'s physical connections (epic #6013, #6022). Replaces the
// v0.1 `connect(host, port)`'s single, unauthenticated, plaintext socket.
//
// `Client` IS A THIN WRAPPER OVER `std/sync.Pool<redisConn>` (#6020).
// `command()` acquires a lease, runs one round trip, and releases it —
// healthy back to the pool, or retired (`ok = false`) when `conn.bit`'s
// `classifyTransportError`/`classifyDecodeError` reported `Io`, `Timeout` or
// `Protocol`: exactly the failures that leave the physical connection in an
// unknown state. A server-side failure (`WRONGTYPE`, `WRONGPASS`, ...)
// leaves the connection itself fine, so it goes back healthy.
//
// RECONNECT IS FOR READS ONLY. `readCommand` retries once, on a fresh
// connection, when the failure is both `retryable()` (errors.bit: a
// transport failure, a timeout, or a server condition expected to clear) and
// one that already retired the connection — never for a write (`command`),
// per epic #6013's own ticket text: a retried `SET` could silently double an
// increment a caller only meant to run once.
//
// `Reply` FROM THE ESCAPE HATCH: RESP3 attributes are unwrapped before ANY
// reply reaches a caller (#6018's note on this ticket) and the most recent
// reply's attributes are kept on `Client` — `lastAttributes()` — for a
// caller (client-side caching, later) that needs them; `command()`'s return
// value is always the reply the attribute decorated, never the attribute
// map itself.

import { Pool, PoolOptions, newPool } from "std/sync"

export class Client {
  pool: Pool<redisConn>
  opts: Options
  lastAttrs: []MapEntry

  // The RESP3 attribute map (if any) that decorated the most recent reply —
  // empty when there was none. Overwritten by every call to `command`/
  // `readCommand`, including through `get`/`set`/... below.
  export lastAttributes(): []MapEntry {
    return this.lastAttrs
  }

  export close() {
    this.pool.close()
  }

  // The generic escape hatch (#3466): sends any command, returns its raw
  // decoded, attribute-unwrapped `Reply`. Never retried — see this file's
  // header.
  export command(args: []string): Reply!RedisError {
    return this.doCommand(args, false)?
  }

  // Like `command`, but a `retryable()` failure that left the connection
  // unusable is retried once, on a fresh connection from the pool — for a
  // read, where running it twice is safe.
  readCommand(args: []string): Reply!RedisError {
    return this.doCommand(args, true)?
  }

  doCommand(args: []string, allowRetry: bool): Reply!RedisError {
    let lease = this.pool.acquire() catch e {
      fail RedisError.Io(e.message())
    }
    let r = rawCommand(lease.value, args, this.opts.commandTimeout) catch e {
      this.pool.release(lease, !connectionBad(e))
      if (allowRetry && e.retryable() && connectionBad(e)) {
        return this.doCommand(args, false)?
      }
      fail e
    }
    this.lastAttrs = lease.value.lastAttrs
    this.pool.release(lease, true)
    return r
  }

  // A cache miss decodes to `Option.None`, never `Option.Some("")` — the null
  // vs. empty distinction `resp.bit`'s `decodeBulk` exists to preserve, carried
  // all the way through to this package's own public API.
  export get(key: string): Option<string>!RedisError {
    let r = this.readCommand(["GET", key])?
    match (r) {
      Bulk(v) => return v
      // RESP3: a missing key's GET reply is the unified `_` null
      // (`Reply.Null`), not RESP2's `$-1\r\n` (`Reply.Bulk(Option.None)`) —
      // proved against a real Redis 8 server (#6022's live gate), not
      // assumed. Both mean the same thing here: no value.
      Null => return Option.None
      _ => fail RedisError.Unexpected("GET", shapeName(r))
    }
  }

  export set(key: string, value: string): ()!RedisError {
    let r = this.command(["SET", key, value])?
    match (r) {
      Simple(_) => return
      _ => fail RedisError.Unexpected("SET", shapeName(r))
    }
  }

  export del(keys: []string): i64!RedisError {
    let r = this.command(withKeys("DEL", keys))?
    match (r) {
      Int(n) => return n
      _ => fail RedisError.Unexpected("DEL", shapeName(r))
    }
  }

  export exists(keys: []string): i64!RedisError {
    let r = this.readCommand(withKeys("EXISTS", keys))?
    match (r) {
      Int(n) => return n
      _ => fail RedisError.Unexpected("EXISTS", shapeName(r))
    }
  }

  export expire(key: string, seconds: i64): bool!RedisError {
    let r = this.command(["EXPIRE", key, "${seconds}"])?
    match (r) {
      Int(n) => return n != 0
      _ => fail RedisError.Unexpected("EXPIRE", shapeName(r))
    }
  }

  export ping(): string!RedisError {
    let r = this.readCommand(["PING"])?
    match (r) {
      Simple(s) => return s
      Bulk(v) => return unwrapOr(v, "")
      _ => fail RedisError.Unexpected("PING", shapeName(r))
    }
  }
}

// Whether `e` means the physical connection that produced it must not be
// reused — the `Io`/`Timeout`/`Protocol` set `conn.bit`'s two classifiers are
// restricted to. Every other `RedisError` (a server error) leaves the
// connection itself fine.
fn connectionBad(e: RedisError): bool {
  match (e) {
    Io(_) => return true
    Timeout => return true
    Protocol(_) => return true
    _ => return false
  }
}

// `open("redis://[user[:pass]@]host[:port][/db][?timeout=5s&pool=16&name=app]")`
// / `open("rediss://...")` for TLS. Parses the URL (`uri.bit`) and connects.
export fn open(url: string): Client!RedisError {
  let opts = parseUrl(url)?
  return connect(opts)?
}

// Connects with `opts` directly — the escape hatch `open` has no room for
// (a self-signed `tlsRootCa`, `insecureSkipVerify`, split connect/command
// timeouts).
//
// DIALS ONE CONNECTION EAGERLY, THEN CLOSES IT. `std/sync.Pool` itself dials
// lazily, on first `acquire` — fine for a pool's own reuse, but it would
// make `connect` "succeed" against a wrong password or an unreachable host
// and only fail on the caller's first command, which is not the DX a
// connection function should have (proved wrong live, #6022: `open` with a
// bad password returned a `Client` with an empty, never-dialled pool). The
// probe connection is thrown away rather than seeded into the pool — `Pool`
// has no API to hand it one already open — so `opts.poolSize` connections
// still exist only once callers actually use them.
export fn connect(opts: Options): Client!RedisError {
  let roots = tlsRootsFor(opts)?
  let probe = dialConn(opts, roots)?
  probe.close()
  let pool = newPool<redisConn>(
    () => dialConn(opts, roots)?,
    (c) => c.close(),
    (c) => true,
    PoolOptions{ maxSize = i64(opts.poolSize) },
  )
  return Client{ pool = pool, opts = opts, lastAttrs = []MapEntry(0) }
}

fn withKeys(cmd: string, keys: []string): []string {
  let args = [cmd]
  let i = 0
  while (i < len(keys)) {
    args = append(args, keys[i])
    i = i + 1
  }
  return args
}
