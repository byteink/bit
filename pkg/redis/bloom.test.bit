// pkg/redis/bloom.test.bit - the wire arguments and reply decoding of
// `bloom.bit`, `sketch.bit` and `tdigest.bit`, tested without a server.
// `assertArgs` is `list.test.bit`s and `bulk` `pubsub.test.bit`s (same module). `bloom.live.test.bit` runs
// every command against a real server.

fn arr(items: []Reply): Reply { return Reply.Array(Option.Some(items)) }

test "BF commands put the key first and the options in the server's order" {
  assertArgs(bfReserveCmd("k", 0.01, 100, BloomGrowth.Default).args, ["BF.RESERVE", "k", "0.01", "100"])
  assertArgs(
    bfReserveCmd("k", 0.01, 100, BloomGrowth.Expansion(4)).args,
    ["BF.RESERVE", "k", "0.01", "100", "EXPANSION", "4"],
  )
  assertArgs(
    bfReserveCmd("k", 0.01, 100, BloomGrowth.NonScaling).args,
    ["BF.RESERVE", "k", "0.01", "100", "NONSCALING"],
  )
  assertArgs(bfAddCmd("k", "a").args, ["BF.ADD", "k", "a"])
  assertArgs(bfAddManyCmd("k", ["a", "b"]).args, ["BF.MADD", "k", "a", "b"])
  assertArgs(bfExistsCmd("k", "a").args, ["BF.EXISTS", "k", "a"])
  assertArgs(bfExistsManyCmd("k", ["a", "b"]).args, ["BF.MEXISTS", "k", "a", "b"])
  assertArgs(bfCardCmd("k").args, ["BF.CARD", "k"])
  assertArgs(bfInfoCmd("k").args, ["BF.INFO", "k"])
  assertArgs(scanDumpCmd("BF.SCANDUMP", "k", 0).args, ["BF.SCANDUMP", "k", "0"])
  assertArgs(loadChunkCmd("BF.LOADCHUNK", "k", 7, "xy").args, ["BF.LOADCHUNK", "k", "7", "xy"])
}

test "BF.INSERT sends only the options that are set, then ITEMS last" {
  assertArgs(bfInsertCmd("k", ["a"], BloomInsertOptions{}).args, ["BF.INSERT", "k", "ITEMS", "a"])
  let all = BloomInsertOptions{
    capacity = Option.Some(50),
    errorRate = Option.Some(0.001),
    growth = BloomGrowth.NonScaling,
    noCreate = true,
  }
  assertArgs(
    bfInsertCmd("k", ["a", "b"], all).args,
    [
      "BF.INSERT", "k", "CAPACITY", "50", "ERROR", "0.001", "NONSCALING", "NOCREATE", "ITEMS", "a",
      "b",
    ],
  )
}

test "CF commands put the key first and the options in the server's order" {
  assertArgs(cfReserveCmd("k", 100, CuckooReserveOptions{}).args, ["CF.RESERVE", "k", "100"])
  let all = CuckooReserveOptions{
    bucketSize = Option.Some(2),
    maxIterations = Option.Some(10),
    expansion = Option.Some(1),
  }
  assertArgs(
    cfReserveCmd("k", 100, all).args,
    ["CF.RESERVE", "k", "100", "BUCKETSIZE", "2", "MAXITERATIONS", "10", "EXPANSION", "1"],
  )
  assertArgs(cfAddCmd("CF.ADD", "k", "a").args, ["CF.ADD", "k", "a"])
  assertArgs(cfAddCmd("CF.ADDNX", "k", "a").args, ["CF.ADDNX", "k", "a"])
  assertArgs(
    cfInsertCmd("CF.INSERT", "k", ["a"], CuckooInsertOptions{ capacity = Option.Some(9), noCreate = true }).args,
    ["CF.INSERT", "k", "CAPACITY", "9", "NOCREATE", "ITEMS", "a"],
  )
  assertArgs(
    cfInsertCmd("CF.INSERTNX", "k", ["a", "b"], CuckooInsertOptions{}).args,
    ["CF.INSERTNX", "k", "ITEMS", "a", "b"],
  )
  assertArgs(cfExistsCmd("k", "a").args, ["CF.EXISTS", "k", "a"])
  assertArgs(cfExistsManyCmd("k", ["a", "b"]).args, ["CF.MEXISTS", "k", "a", "b"])
  assertArgs(cfDeleteCmd("k", "a").args, ["CF.DEL", "k", "a"])
  assertArgs(cfCountCmd("k", "a").args, ["CF.COUNT", "k", "a"])
  assertArgs(cfInfoCmd("k").args, ["CF.INFO", "k"])
}

test "CMS commands: INITBYDIM or INITBYPROB, pairs flat, weights after the keys" {
  assertArgs(cmsInitCmd("k", CmsSize.Dims(2000, 7)).args, ["CMS.INITBYDIM", "k", "2000", "7"])
  assertArgs(cmsInitCmd("k", CmsSize.Bounds(0.001, 0.01)).args, ["CMS.INITBYPROB", "k", "0.001", "0.01"])
  assertArgs(
    cmsIncrByCmd("k", [counted("a", 3), counted("b", 1)]).args,
    ["CMS.INCRBY", "k", "a", "3", "b", "1"],
  )
  assertArgs(cmsQueryCmd("k", ["a", "b"]).args, ["CMS.QUERY", "k", "a", "b"])
  assertArgs(
    cmsMergeCmd("d", [CmsSource{ key = "x" }, CmsSource{ key = "y", weight = 3 }]).args,
    ["CMS.MERGE", "d", "2", "x", "y", "WEIGHTS", "1", "3"],
  )
  assertArgs(cmsInfoCmd("k").args, ["CMS.INFO", "k"])
}

test "TOPK commands: RESERVE with or without a shape, LIST always WITHCOUNT" {
  assertArgs(topkReserveCmd("k", 3, TopKShape.Default).args, ["TOPK.RESERVE", "k", "3"])
  assertArgs(
    topkReserveCmd("k", 3, TopKShape.Sized(8, 7, 0.9)).args,
    ["TOPK.RESERVE", "k", "3", "8", "7", "0.9"],
  )
  assertArgs(topkAddCmd("k", ["a", "b"]).args, ["TOPK.ADD", "k", "a", "b"])
  assertArgs(topkIncrByCmd("k", [counted("a", 5)]).args, ["TOPK.INCRBY", "k", "a", "5"])
  assertArgs(topkQueryCmd("k", ["a"]).args, ["TOPK.QUERY", "k", "a"])
  assertArgs(topkCountCmd("k", ["a"]).args, ["TOPK.COUNT", "k", "a"])
  assertArgs(topkListCmd("k").args, ["TOPK.LIST", "k", "WITHCOUNT"])
  assertArgs(topkInfoCmd("k").args, ["TOPK.INFO", "k"])
}

test "TDIGEST commands: floats and ranks as words, MERGE counts its sources" {
  assertArgs(tdCreateCmd("k", Option.None).args, ["TDIGEST.CREATE", "k"])
  assertArgs(tdCreateCmd("k", Option.Some(200)).args, ["TDIGEST.CREATE", "k", "COMPRESSION", "200"])
  assertArgs(tdAddCmd("k", [1.5, 2.0]).args, ["TDIGEST.ADD", "k", "1.5", "2"])
  assertArgs(
    tdMergeCmd("d", ["a", "b"], TDigestMergeOptions{ compression = Option.Some(50), overwrite = true }).args,
    ["TDIGEST.MERGE", "d", "2", "a", "b", "COMPRESSION", "50", "OVERRIDE"],
  )
  assertArgs(tdMergeCmd("d", ["a"], TDigestMergeOptions{}).args, ["TDIGEST.MERGE", "d", "1", "a"])
  assertArgs(tdResetCmd("k").args, ["TDIGEST.RESET", "k"])
  assertArgs(tdFloatsCmd("TDIGEST.QUANTILE", "k", [0.5, 0.99]).args, ["TDIGEST.QUANTILE", "k", "0.5", "0.99"])
  assertArgs(tdFloatsCmd("TDIGEST.CDF", "k", [10.0]).args, ["TDIGEST.CDF", "k", "10"])
  assertArgs(tdRankCmd("TDIGEST.REVRANK", "k", [3.0]).args, ["TDIGEST.REVRANK", "k", "3"])
  assertArgs(tdByRankCmd("TDIGEST.BYREVRANK", "k", [0, 2]).args, ["TDIGEST.BYREVRANK", "k", "0", "2"])
  assertArgs(tdExtremeCmd("TDIGEST.MAX", "k").args, ["TDIGEST.MAX", "k"])
  assertArgs(tdTrimmedMeanCmd("k", 0.1, 0.9).args, ["TDIGEST.TRIMMED_MEAN", "k", "0.1", "0.9"])
  assertArgs(tdInfoCmd("k").args, ["TDIGEST.INFO", "k"])
}

test "a flag list decodes from booleans (RESP3) and integers (RESP2) alike" {
  let got = bfAddManyCmd("k", ["a", "b"]).decode(arr([Reply.Bool(true), Reply.Int(0)])) catch e {
    panic("madd: ${e.message()}")
  }
  assert(got[0] && !got[1], "got ${got[0]} ${got[1]}")
}

test "BF.INFO reads its fields by name, from a map or a flat array, nil expansion is None" {
  let flat = arr([
    bulk("Capacity"), Reply.Int(100), bulk("Size"), Reply.Int(240), bulk("Number of filters"),
    Reply.Int(1), bulk("Number of items inserted"), Reply.Int(3), bulk("Expansion rate"), Reply.Null,
  ])
  let info = bfInfoCmd("k").decode(flat) catch e {
    panic("info: ${e.message()}")
  }
  assert(info.capacity == 100 && info.size == 240 && info.filters == 1 && info.items == 3, "fields")
  assert(info.expansion == Option.None, "a non-scaling filter has no expansion")

  let named = Reply.Map([
    MapEntry{ key = bulk("Capacity"), value = Reply.Int(10) },
    MapEntry{ key = bulk("Expansion rate"), value = Reply.Int(2) },
  ])
  let second = bfInfoCmd("k").decode(named) catch e {
    panic("info map: ${e.message()}")
  }
  assert(second.capacity == 10 && second.items == 0, "a field the server did not send reads 0")
  assert(second.expansion == Option.Some(2), "expansion 2")
}

test "CF.INSERT answers Added, Exists or Full per item" {
  let r = arr([Reply.Bool(true), Reply.Int(1), Reply.Int(0), Reply.Int(-1)])
  let got = cfInsertCmd("CF.INSERTNX", "k", ["a"], CuckooInsertOptions{}).decode(r) catch e {
    panic("insert: ${e.message()}")
  }
  assert(len(got) == 4, "four results")
  assert(got[0] == CuckooInsert.Added && got[1] == CuckooInsert.Added, "added")
  assert(got[2] == CuckooInsert.Exists && got[3] == CuckooInsert.Full, "exists, full")
  let bad = false
  cfInsertCmd("CF.INSERT", "k", ["a"], CuckooInsertOptions{}).decode(arr([Reply.Int(7)])) catch _ {
    bad = true
  }
  assert(bad, "7 is not a CF.INSERT result")
}

test "CF.INFO, CMS.INFO, TOPK.INFO and TDIGEST.INFO decode into typed classes" {
  let cf = cfInfoCmd("k").decode(arr([bulk("Size"), Reply.Int(184), bulk("Bucket size"), Reply.Int(2), bulk("Number of items deleted"), Reply.Int(1)])) catch e {
    panic("cf: ${e.message()}")
  }
  assert(cf.size == 184 && cf.bucketSize == 2 && cf.deleted == 1, "cuckoo info")
  let cms = cmsInfoCmd("k").decode(arr([bulk("width"), Reply.Int(100), bulk("depth"), Reply.Int(5), bulk("count"), Reply.Int(9)])) catch e {
    panic("cms: ${e.message()}")
  }
  assert(cms.width == 100 && cms.depth == 5 && cms.count == 9, "cms info")
  let tk = topkInfoCmd("k").decode(arr([bulk("k"), Reply.Int(3), bulk("width"), Reply.Int(8), bulk("depth"), Reply.Int(7), bulk("decay"), bulk("0.9")])) catch e {
    panic("topk: ${e.message()}")
  }
  assert(tk.k == 3 && tk.width == 8 && tk.depth == 7 && tk.decay == 0.9, "topk info")
  let td = tdInfoCmd("k").decode(arr([bulk("Compression"), Reply.Int(100), bulk("Observations"), Reply.Int(5), bulk("Memory usage"), Reply.Int(9840)])) catch e {
    panic("td: ${e.message()}")
  }
  assert(td.compression == 100 && td.observations == 5 && td.memoryUsage == 9840, "tdigest info")
}

test "TOPK.ADD keeps the nil of an item that expelled nothing, TOPK.LIST pairs item and count" {
  let r = arr([Reply.Bulk(Option.None), bulk("d"), Reply.Null])
  let out = topkAddCmd("k", ["a", "b", "c"]).decode(r) catch e {
    panic("add: ${e.message()}")
  }
  assert(out[0] == Option.None && out[1] == Option.Some("d") && out[2] == Option.None, "expelled")
  let list = topkListCmd("k").decode(arr([bulk("a"), Reply.Int(11), bulk("e"), Reply.Int(5)])) catch e {
    panic("list: ${e.message()}")
  }
  assert(len(list) == 2 && list[0].item == "a" && list[0].count == 11 && list[1].count == 5, "list")
  let odd = false
  topkListCmd("k").decode(arr([bulk("a")])) catch _ {
    odd = true
  }
  assert(odd, "an odd-length list is malformed")
}

test "t-digest doubles accept NaN and infinity in both protocols" {
  let r3 = tdFloatsCmd("TDIGEST.QUANTILE", "k", [0.5]).decode(arr([Reply.Double(1.5), Reply.Double(parseFloat("nan"))])) catch e {
    panic("resp3: ${e.message()}")
  }
  assert(r3[0] == 1.5 && r3[1] != r3[1], "resp3 NaN")
  let r2 = tdByRankCmd("TDIGEST.BYRANK", "k", [0]).decode(arr([bulk("nan"), bulk("inf"), bulk("-inf"), bulk("2.5")])) catch e {
    panic("resp2: ${e.message()}")
  }
  assert(r2[0] != r2[0], "resp2 nan")
  assert(r2[1] > 1.0e300 && r2[2] < -1.0e300 && r2[3] == 2.5, "resp2 inf, -inf, 2.5")
  let bad = false
  tdExtremeCmd("TDIGEST.MIN", "k").decode(bulk("banana")) catch _ {
    bad = true
  }
  assert(bad, "a bulk that is no number is not a reply")
  let ranks = tdRankCmd("TDIGEST.RANK", "k", [1.0]).decode(arr([Reply.Int(-2), Reply.Int(4)])) catch e {
    panic("rank: ${e.message()}")
  }
  assert(ranks[0] == -2 && ranks[1] == 4, "ranks")
}

test "SCANDUMP decodes the iterator and the bytes" {
  let c = scanDumpCmd("BF.SCANDUMP", "k", 0).decode(arr([Reply.Int(1), bulk("ab")])) catch e {
    panic("scandump: ${e.message()}")
  }
  assert(c.iterator == 1 && c.data == "ab", "chunk")
  let done = scanDumpCmd("BF.SCANDUMP", "k", 1).decode(arr([Reply.Int(0), bulk("")])) catch e {
    panic("scandump end: ${e.message()}")
  }
  assert(done.iterator == 0 && done.data == "", "end of dump")
}

test "the queued views queue the same argv as the immediate handles" {
  let batch = Batch()
  let _ = BloomBatch{ batch = batch, key = "b" }.add("x")
  let _ = CuckooBatch{ batch = batch, key = "c" }.delete("x")
  let _ = CmsBatch{ batch = batch, key = "s" }.query("x")
  let _ = TopKBatch{ batch = batch, key = "t" }.list()
  let _ = TDigestBatch{ batch = batch, key = "d" }.quantile(0.5)
  assert(len(batch.queued) == 5, "queued ${len(batch.queued)}")
  assertArgs(batch.queued[0], ["BF.ADD", "b", "x"])
  assertArgs(batch.queued[1], ["CF.DEL", "c", "x"])
  assertArgs(batch.queued[2], ["CMS.QUERY", "s", "x"])
  assertArgs(batch.queued[3], ["TOPK.LIST", "t", "WITHCOUNT"])
  assertArgs(batch.queued[4], ["TDIGEST.QUANTILE", "d", "0.5"])
}
