// pkg/redis/hll.test.bit - `hll.bit`'s wire arguments and reply decoding,
// tested without a server. `assertArgs` is `list.test.bit`'s (same module).
// `hll.live.test.bit` runs every command against a real server.

test "PFADD, PFCOUNT and PFMERGE put the key first, then the rest in order" {
  assertArgs(pfAddCmd("v", ["a", "b"]).args, ["PFADD", "v", "a", "b"])
  assertArgs(pfAddCmd("v", []string(0)).args, ["PFADD", "v"])
  assertArgs(pfCountCmd("v", []string(0)).args, ["PFCOUNT", "v"])
  assertArgs(pfCountCmd("v", ["w", "x"]).args, ["PFCOUNT", "v", "w", "x"])
  assertArgs(pfMergeCmd("v", ["w", "x"]).args, ["PFMERGE", "v", "w", "x"])
}

test "PFADD answers a bool, PFCOUNT an integer, PFMERGE a bare OK" {
  let changed = pfAddCmd("v", ["a"]).decode(Reply.Int(1)) catch e {
    panic("pfadd: ${e.message()}")
  }
  assert(changed, "Int(1) is true")
  let same = pfAddCmd("v", ["a"]).decode(Reply.Bool(false)) catch e {
    panic("pfadd resp3: ${e.message()}")
  }
  assert(!same, "Bool(false) is false")
  let n = pfCountCmd("v", []string(0)).decode(Reply.Int(42)) catch e {
    panic("pfcount: ${e.message()}")
  }
  assert(n == 42, "count = ${n}")
  pfMergeCmd("v", ["w"]).decode(Reply.Simple("OK")) catch e {
    panic("pfmerge: ${e.message()}")
  }
  let bad = false
  pfMergeCmd("v", ["w"]).decode(Reply.Int(1)) catch _ {
    bad = true
  }
  assert(bad, "an integer is not a PFMERGE reply")
}

test "HllBatch queues the three commands with Hll's argv" {
  let batch = Batch()
  let h = HllBatch{ batch = batch, key = "v" }
  let _ = h.add("a", "b")
  let _ = h.count("w")
  let _ = h.merge("w", "x")
  assert(len(batch.queued) == 3, "queued ${len(batch.queued)} commands")
  assertArgs(batch.queued[0], ["PFADD", "v", "a", "b"])
  assertArgs(batch.queued[1], ["PFCOUNT", "v", "w"])
  assertArgs(batch.queued[2], ["PFMERGE", "v", "w", "x"])
}
