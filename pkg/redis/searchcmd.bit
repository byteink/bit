// pkg/redis/searchcmd.bit - the wire half of `search.bit`: one `Cmd<T>`
// factory per `FT.*` command and the decoders for the small replies. Epic
// #6013, #6044. `searchschema.bit`/`searchfind.bit`/`searchagg.bit` build the
// arguments of the big three, `searchreply.bit` reads their replies.

// One field of an index, from `FT.INFO`: its `identifier` (the hash field or
// JSON path), the name a query uses (`attribute`), its `kind` (`TEXT`, `TAG`,
// `NUMERIC`, `GEO`, `GEOSHAPE`, `VECTOR`) and the flags the server lists
// (`SORTABLE`, `NOINDEX`, ...).
export class IndexField {
  export identifier: string,
  export attribute: string,
  export kind: string,
  export flags: []string,
}

// `FT.INFO`. `keyType` is `HASH` or `JSON`; `indexing` is true while the
// initial scan still runs (`percentIndexed` says how far).
export class SearchInfo {
  export name: string,
  export keyType: string,
  export prefixes: []string,
  export fields: []IndexField,
  export numDocs: i64,
  export maxDocId: i64,
  export numTerms: i64,
  export numRecords: i64,
  export indexingFailures: i64,
  export indexing: bool,
  export percentIndexed: f64,
}

// One misspelled query term and the server's suggestions for it, best first.
export class Misspelled {
  export term: string,
  export suggestions: []Scored,
}

// `FT.SPELLCHECK`'s optional arguments. `distance` is the most edits
// (1 to 4, default 1); `include`/`exclude` name dictionaries whose terms are
// suggested/never suggested.
export class SpellOptions {
  export distance: Option<i64> = Option.None,
  export include: []string = []string(0),
  export exclude: []string = []string(0),
  export dialect: Option<i64> = Option.None,
}

// `FT.SUGGET`'s optional arguments: `fuzzy` allows one edit, `max` caps the
// count (5 by default), `withScores`/`withPayloads` fill the matching fields.
export class SuggestOptions {
  export fuzzy: bool = false,
  export max: Option<i64> = Option.None,
  export withScores: bool = false,
  export withPayloads: bool = false,
}

// One autocomplete suggestion.
export class Suggestion {
  export text: string,
  export score: Option<f64> = Option.None,
  export payload: Option<string> = Option.None,
}

// One term and the synonym groups it belongs to (`FT.SYNDUMP`).
export class Synonym {
  export term: string,
  export groups: []string,
}

fn createCmd(index: string, s: Schema, opts: CreateOptions): Cmd<()> {
  return Cmd<()>{
    args = createArgs(index, s, opts),
    decode = (r) => asOk(r, "FT.CREATE"),
    readOnly = false,
  }
}

fn alterCmd(index: string, s: Schema, skipInitialScan: bool): Cmd<()> {
  return Cmd<()>{
    args = ftAlterArgs(index, s, skipInitialScan),
    decode = (r) => asOk(r, "FT.ALTER"),
    readOnly = false,
  }
}

fn dropCmd(index: string, deleteDocs: bool): Cmd<()> {
  return Cmd<()>{
    args = append(["FT.DROPINDEX", index], ...flagIf(deleteDocs, "DD")),
    decode = (r) => asOk(r, "FT.DROPINDEX"),
    readOnly = false,
  }
}

fn listCmd(): Cmd<[]string> {
  return Cmd<[]string>{
    args = ["FT._LIST"],
    decode = (r) => asSetMembers(r, "FT._LIST"),
    readOnly = true,
  }
}

fn ftInfoCmd(index: string): Cmd<SearchInfo> {
  return Cmd<SearchInfo>{
    args = ["FT.INFO", index],
    decode = (r) => asSearchInfo(r),
    readOnly = true,
  }
}

fn findCmd(index: string, q: Query, o: SearchOptions): Cmd<SearchResult> {
  return Cmd<SearchResult>{
    args = searchArgs(index, q, o),
    decode = (r) => asSearchResult(r, o),
    readOnly = true,
  }
}

fn aggregateCmd(index: string, q: Query, p: AggPipeline, o: AggregateOptions): Cmd<AggResult> {
  return Cmd<AggResult>{
    args = aggregateArgs(index, q, p, o),
    decode = (r) => asAggResult(r),
    readOnly = isNone(o.cursor),
  }
}

fn cursorReadCmd(index: string, cursor: i64, count: i64): Cmd<AggResult> {
  return Cmd<AggResult>{
    args = append(["FT.CURSOR", "READ", index, "${cursor}"], ...optPos("COUNT", count)),
    decode = (r) => asAggResult(r),
    readOnly = false,
  }
}

fn cursorDelCmd(index: string, cursor: i64): Cmd<()> {
  return Cmd<()>{
    args = ["FT.CURSOR", "DEL", index, "${cursor}"],
    decode = (r) => asOk(r, "FT.CURSOR"),
    readOnly = false,
  }
}

fn aliasCmd(verb: string, alias: string, index: string): Cmd<()> {
  return Cmd<()>{
    args = [verb, alias, index],
    decode = (r) => asOk(r, verb),
    readOnly = false,
  }
}

fn aliasDelCmd(alias: string): Cmd<()> {
  return Cmd<()>{
    args = ["FT.ALIASDEL", alias],
    decode = (r) => asOk(r, "FT.ALIASDEL"),
    readOnly = false,
  }
}

fn explainCmd(index: string, q: Query, dialect: Option<i64>): Cmd<string> {
  let args = append(["FT.EXPLAIN", index, q.expr], ...optInt("DIALECT", dialect))
  return Cmd<string>{
    args = args,
    decode = (r) => replyToString(r, "FT.EXPLAIN"),
    readOnly = true,
  }
}

fn spellArgs(index: string, query: string, o: SpellOptions): []string {
  let args = append(["FT.SPELLCHECK", index, query], ...optInt("DISTANCE", o.distance))
  for d of o.include {
    args = append(args, "TERMS", "INCLUDE", d)
  }
  for d of o.exclude {
    args = append(args, "TERMS", "EXCLUDE", d)
  }
  return append(args, ...optInt("DIALECT", o.dialect))
}

fn spellcheckCmd(index: string, query: string, o: SpellOptions): Cmd<[]Misspelled> {
  return Cmd<[]Misspelled>{
    args = spellArgs(index, query, o),
    decode = (r) => asSpellcheck(r),
    readOnly = true,
  }
}

fn sugAddCmd(key: string, text: string, score: f64, incr: bool, payload: Option<string>): Cmd<i64> {
  let args = append(["FT.SUGADD", key, text, "${score}"], ...flagIf(incr, "INCR"))
  return Cmd<i64>{
    args = append(args, ...tokensOpt("PAYLOAD", payload)),
    decode = (r) => asInt(r, "FT.SUGADD"),
    readOnly = false,
  }
}

fn sugGetArgs(key: string, prefix: string, o: SuggestOptions): []string {
  let args = append(["FT.SUGGET", key, prefix], ...flagIf(o.fuzzy, "FUZZY"))
  args = append(args, ...flagIf(o.withScores, "WITHSCORES"))
  args = append(args, ...flagIf(o.withPayloads, "WITHPAYLOADS"))
  return append(args, ...optInt("MAX", o.max))
}

fn sugGetCmd(key: string, prefix: string, o: SuggestOptions): Cmd<[]Suggestion> {
  return Cmd<[]Suggestion>{
    args = sugGetArgs(key, prefix, o),
    decode = (r) => asSuggestions(r, o),
    readOnly = true,
  }
}

fn sugDelCmd(key: string, text: string): Cmd<bool> {
  return Cmd<bool>{
    args = ["FT.SUGDEL", key, text],
    decode = (r) => asBool(r, "FT.SUGDEL"),
    readOnly = false,
  }
}

fn sugLenCmd(key: string): Cmd<i64> {
  return Cmd<i64>{
    args = ["FT.SUGLEN", key],
    decode = (r) => asInt(r, "FT.SUGLEN"),
    readOnly = true,
  }
}

fn synUpdateCmd(index: string, group: string, terms: []string, skipInitialScan: bool): Cmd<()> {
  let args = append(["FT.SYNUPDATE", index, group], ...flagIf(skipInitialScan, "SKIPINITIALSCAN"))
  return Cmd<()>{
    args = append(args, ...terms),
    decode = (r) => asOk(r, "FT.SYNUPDATE"),
    readOnly = false,
  }
}

fn synDumpCmd(index: string): Cmd<[]Synonym> {
  return Cmd<[]Synonym>{
    args = ["FT.SYNDUMP", index],
    decode = (r) => asSynonyms(r),
    readOnly = true,
  }
}

fn tagValsCmd(index: string, field: string): Cmd<[]string> {
  return Cmd<[]string>{
    args = ["FT.TAGVALS", index, field],
    decode = (r) => asSetMembers(r, "FT.TAGVALS"),
    readOnly = true,
  }
}

// ------------------------------------------------------------------ decoders

fn indexFieldOf(r: Reply): IndexField!RedisError {
  let cmd = "FT.INFO"
  let p = sketchPairs(r, cmd)?
  return IndexField{
    identifier = replyToString(infoFind(p, "identifier"), cmd)?,
    attribute = replyToString(infoFind(p, "attribute"), cmd)?,
    kind = replyToString(infoFind(p, "type"), cmd)?,
    flags = asSetMembers(infoFind(p, "flags"), cmd)?,
  }
}

fn ftInfoText(p: []MapEntry, name: string): string {
  return replyToString(infoFind(p, name), "FT.INFO") catch _ {
    ""
  }
}

fn asSearchInfo(r: Reply): SearchInfo!RedisError {
  let cmd = "FT.INFO"
  let p = sketchPairs(r, cmd)?
  let def = sketchPairs(infoFind(p, "index_definition"), cmd) catch _ {
    []MapEntry(0)
  }
  let fields = []IndexField(0)
  for f of replyItems(infoFind(p, "attributes"), cmd)? {
    fields = append(fields, indexFieldOf(f)?)
  }
  let percent = 0.0
  let pi = infoFind(p, "percent_indexed")
  if (!isNullReply(pi)) {
    percent = asDouble(pi, cmd)?
  }
  return SearchInfo{
    name = ftInfoText(p, "index_name"),
    keyType = ftInfoText(def, "key_type"),
    prefixes = asSetMembers(infoFind(def, "prefixes"), cmd) catch _ {
      []string(0)
    },
    fields = fields,
    numDocs = sketchField(p, "num_docs", cmd)?,
    maxDocId = sketchField(p, "max_doc_id", cmd)?,
    numTerms = sketchField(p, "num_terms", cmd)?,
    numRecords = sketchField(p, "num_records", cmd)?,
    indexingFailures = sketchField(p, "hash_indexing_failures", cmd)?,
    indexing = sketchField(p, "indexing", cmd)? != 0,
    percentIndexed = percent,
  }
}

// RESP3: `{results: {term: [{suggestion: score}, ..]}}`; RESP2: `[["TERM",
// term, [[score, suggestion], ..]], ..]`.
fn asSpellcheck(r: Reply): []Misspelled!RedisError {
  let cmd = "FT.SPELLCHECK"
  match (r) {
    Map(entries) => return spellOfMap(sketchPairs(infoFind(entries, "results"), cmd)?)?
    Array(items) => return spellOfFlat(unwrapOr(items, []Reply(0)))?
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

fn spellOfMap(terms: []MapEntry): []Misspelled!RedisError {
  let cmd = "FT.SPELLCHECK"
  let out = []Misspelled(0)
  for t of terms {
    let sugg = []Scored(0)
    for s of replyItems(t.value, cmd)? {
      for e of sketchPairs(s, cmd)? {
        sugg = append(
          sugg,
          Scored{ member = replyToString(e.key, cmd)?, score = asDouble(e.value, cmd)? },
        )
      }
    }
    out = append(out, Misspelled{ term = replyToString(t.key, cmd)?, suggestions = sugg })
  }
  return out
}

fn spellOfFlat(list: []Reply): []Misspelled!RedisError {
  let cmd = "FT.SPELLCHECK"
  let out = []Misspelled(0)
  for t of list {
    let parts = replyItems(t, cmd)?
    if (len(parts) != 3) {
      fail RedisError.Unexpected(cmd, "Array")
    }
    let sugg = []Scored(0)
    for s of replyItems(parts[2], cmd)? {
      let pair = replyItems(s, cmd)?
      if (len(pair) != 2) {
        fail RedisError.Unexpected(cmd, "Array")
      }
      sugg = append(
        sugg,
        Scored{ member = replyToString(pair[1], cmd)?, score = asDouble(pair[0], cmd)? },
      )
    }
    out = append(out, Misspelled{ term = replyToString(parts[1], cmd)?, suggestions = sugg })
  }
  return out
}

fn asSuggestions(r: Reply, o: SuggestOptions): []Suggestion!RedisError {
  let cmd = "FT.SUGGET"
  let stride = 1
  if (o.withScores) {
    stride = stride + 1
  }
  if (o.withPayloads) {
    stride = stride + 1
  }
  let list = replyItems(r, cmd)?
  if (len(list) % stride != 0) {
    fail RedisError.Unexpected(cmd, "Array")
  }
  let out = []Suggestion(0)
  let i = 0
  while (i < len(list)) {
    let s = Suggestion{ text = replyToString(list[i], cmd)? }
    let j = i + 1
    if (o.withScores) {
      s.score = Option.Some(asDouble(list[j], cmd)?)
      j = j + 1
    }
    if (o.withPayloads) {
      s.payload = asOptString(list[j], cmd)?
    }
    out = append(out, s)
    i = i + stride
  }
  return out
}

fn asSynonyms(r: Reply): []Synonym!RedisError {
  let out = []Synonym(0)
  for p of sketchPairs(r, "FT.SYNDUMP")? {
    out = append(
      out,
      Synonym{
        term = replyToString(p.key, "FT.SYNDUMP")?,
        groups = asSetMembers(p.value, "FT.SYNDUMP")?,
      },
    )
  }
  return out
}
