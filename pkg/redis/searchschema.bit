// pkg/redis/searchschema.bit - the typed half of `FT.CREATE`/`FT.ALTER`: the
// schema builder and the index options. Epic #6013, #6044. `search.bit` holds
// the handle that takes them, `searchcmd.bit` the wire.
//
//   let s = schema().
//     text("name", TextOptions{ weight = 2.0 }).
//     tag("brand").
//     numeric("price", NumericOptions{ sortable = true }).
//     vector("embedding", 3)
//
// A `Schema` is immutable: every method returns a new one, so a base schema
// can be extended two ways. Each method writes the field's tokens in the
// order redis.io's `FT.CREATE` page lists them (`NOSTEM`, `WEIGHT`, `PHONETIC`,
// ... `SORTABLE [UNF]`, `NOINDEX`). Every kind takes a typed options class.
// The first argument is the field name for
// a hash index and the JSON path for a JSON index (`$.title`); `alias` is the
// name a query uses (`AS`), which a JSON path needs.
//
// Pure functions of their inputs, so `search.test.bit` checks every argument
// list without a server.

// What the index covers: hashes (`HASH`, the default) or JSON documents.
export enum IndexOn {
  Hash,
  Json,
}

// `PHONETIC`: the matcher that finds words which sound alike.
export enum Phonetic {
  Off,
  English,
  French,
  Portuguese,
  Spanish,
}

// A vector field's distance function.
export enum VecMetric {
  L2,
  InnerProduct,
  Cosine,
}

// How a vector field stores a component.
export enum VecType {
  Float32,
  Float64,
  Bfloat16,
  Float16,
}

// A vector field's index: an exact scan (`Flat`) or the approximate graph
// (`Hnsw` or `SvsVamana`).
export enum VecAlgo {
  Flat,
  Hnsw,
  SvsVamana,
}

// Whether a geometry field is on a plane (`Flat`) or the globe (`Spherical`).
export enum Coords {
  Spherical,
  Flat,
}

// `TEXT` field options. `alias` is the name a query uses (`AS`); `weight`
// scales this field's share of the score; `noStem` keeps words unstemmed;
// `phonetic` matches by sound; `suffixTrie` makes `*suffix` and `*infix*`
// fast; `indexEmpty`/`indexMissing` make empty and absent values findable;
// `sortable` keeps the value for `SORTBY` (`unf` also keeps it un-normalized);
// `noIndex` stores it for `SORTBY`/`RETURN` only.
export class TextOptions {
  export alias: string = "",
  export weight: f64 = 1.0,
  export noStem: bool = false,
  export phonetic: Phonetic = Phonetic.Off,
  export suffixTrie: bool = false,
  export indexEmpty: bool = false,
  export indexMissing: bool = false,
  export sortable: bool = false,
  export unf: bool = false,
  export noIndex: bool = false,
}

// `TAG` field options: `separator` splits a field holding several values
// (`,` when empty); `caseSensitive` keeps case; the rest are `TextOptions`'.
export class TagOptions {
  export alias: string = "",
  export separator: string = "",
  export caseSensitive: bool = false,
  export suffixTrie: bool = false,
  export indexEmpty: bool = false,
  export indexMissing: bool = false,
  export sortable: bool = false,
  export unf: bool = false,
  export noIndex: bool = false,
}

// `NUMERIC` field options: `alias` names the field in queries;
// `indexMissing` makes absent values findable; `sortable` keeps the value
// for sorting; `noIndex` stores it for sorting and returning only.
export class NumericOptions {
  export alias: string = "",
  export indexMissing: bool = false,
  export sortable: bool = false,
  export noIndex: bool = false,
}

// `GEO` field options have the same meanings as `NumericOptions`.
export class GeoOptions {
  export alias: string = "",
  export indexMissing: bool = false,
  export sortable: bool = false,
  export noIndex: bool = false,
}

// `GEOSHAPE` field options: `alias` names the field in queries; `coords`
// selects a plane or the globe; `indexMissing` makes absent values findable.
export class GeoShapeOptions {
  export alias: string = "",
  export coords: Coords = Coords.Spherical,
  export indexMissing: bool = false,
}

// `VECTOR` field options. `Hnsw` takes `m`, `efConstruction`, `efRuntime`
// and `epsilon`; `SvsVamana` takes `constructionWindowSize`, `graphMaxDegree`,
// `searchWindowSize` and `epsilon`. Nonpositive tuning values are omitted,
// leaving the server's defaults; `initialCap` and `blockSize` are shared.
export class VectorOptions {
  export alias: string = "",
  export metric: VecMetric = VecMetric.Cosine,
  export algo: VecAlgo = VecAlgo.Hnsw,
  export elem: VecType = VecType.Float32,
  export initialCap: i64 = 0,
  export blockSize: i64 = 0,
  export m: i64 = 0,
  export efConstruction: i64 = 0,
  export efRuntime: i64 = 0,
  export constructionWindowSize: i64 = 0,
  export graphMaxDegree: i64 = 0,
  export searchWindowSize: i64 = 0,
  export epsilon: f64 = 0.0,
  export indexMissing: bool = false,
}

// An index definition's fields.
export class Schema {
  tokens: [][]string

  // `TEXT`: full-text search; see `TextOptions`.
  export text(name: string, opts: TextOptions = TextOptions{}): Schema {
    let t = fieldHead(name, opts.alias, "TEXT")
    if (opts.noStem) {
      t = append(t, "NOSTEM")
    }
    if (opts.weight != 1.0) {
      t = append(t, "WEIGHT", "${opts.weight}")
    }
    t = append(t, ...phoneticArgs(opts.phonetic))
    t = append(t, ...flagIf(opts.suffixTrie, "WITHSUFFIXTRIE"))
    t = append(t, ...flagIf(opts.indexEmpty, "INDEXEMPTY"))
    t = append(t, ...flagIf(opts.indexMissing, "INDEXMISSING"))
    t = append(t, ...sortArgs(opts.sortable, opts.unf))
    return this.plus(append(t, ...flagIf(opts.noIndex, "NOINDEX")))
  }

  // `TAG`: exact values (ids, categories, colours); see `TagOptions`.
  export tag(name: string, opts: TagOptions = TagOptions{}): Schema {
    let t = fieldHead(name, opts.alias, "TAG")
    if (opts.separator != "") {
      t = append(t, "SEPARATOR", opts.separator)
    }
    t = append(t, ...flagIf(opts.caseSensitive, "CASESENSITIVE"))
    t = append(t, ...flagIf(opts.suffixTrie, "WITHSUFFIXTRIE"))
    t = append(t, ...flagIf(opts.indexEmpty, "INDEXEMPTY"))
    t = append(t, ...flagIf(opts.indexMissing, "INDEXMISSING"))
    t = append(t, ...sortArgs(opts.sortable, opts.unf))
    return this.plus(append(t, ...flagIf(opts.noIndex, "NOINDEX")))
  }

  // `NUMERIC`: range queries and sorting on numbers; see `NumericOptions`.
  export numeric(name: string, opts: NumericOptions = NumericOptions{}): Schema {
    let t = fieldHead(name, opts.alias, "NUMERIC")
    t = append(t, ...flagIf(opts.indexMissing, "INDEXMISSING"))
    t = append(t, ...sortArgs(opts.sortable, false))
    return this.plus(append(t, ...flagIf(opts.noIndex, "NOINDEX")))
  }

  // `GEO`: a `lon,lat` position, queried by radius; see `GeoOptions`.
  export geo(name: string, opts: GeoOptions = GeoOptions{}): Schema {
    let t = fieldHead(name, opts.alias, "GEO")
    t = append(t, ...flagIf(opts.indexMissing, "INDEXMISSING"))
    t = append(t, ...sortArgs(opts.sortable, false))
    return this.plus(append(t, ...flagIf(opts.noIndex, "NOINDEX")))
  }

  // `GEOSHAPE`: a WKT point or polygon, queried with `within`/`contains`/
  // `intersects`/`disjoint`; see `GeoShapeOptions`.
  export geoShape(name: string, opts: GeoShapeOptions = GeoShapeOptions{}): Schema {
    let t = fieldHead(name, opts.alias, "GEOSHAPE")
    if (opts.coords == Coords.Flat) {
      t = append(t, "FLAT")
    } else {
      t = append(t, "SPHERICAL")
    }
    return this.plus(append(t, ...flagIf(opts.indexMissing, "INDEXMISSING")))
  }

  // `VECTOR`: `dim` components compared as `opts.metric` says; see
  // `VectorOptions`.
  export vector(name: string, dim: i64, opts: VectorOptions = VectorOptions{}): Schema {
    let attrs = [
      "TYPE",
      vecTypeName(opts.elem),
      "DIM",
      "${dim}",
      "DISTANCE_METRIC",
      metricName(opts.metric),
    ]
    attrs = append(attrs, ...optPos("INITIAL_CAP", opts.initialCap))
    attrs = append(attrs, ...optPos("BLOCK_SIZE", opts.blockSize))
    if (opts.algo == VecAlgo.Hnsw) {
      attrs = append(attrs, ...optPos("M", opts.m))
      attrs = append(attrs, ...optPos("EF_CONSTRUCTION", opts.efConstruction))
      attrs = append(attrs, ...optPos("EF_RUNTIME", opts.efRuntime))
    }
    if (opts.algo == VecAlgo.SvsVamana) {
      attrs = append(attrs, ...optPos("CONSTRUCTION_WINDOW_SIZE", opts.constructionWindowSize))
      attrs = append(attrs, ...optPos("GRAPH_MAX_DEGREE", opts.graphMaxDegree))
      attrs = append(attrs, ...optPos("SEARCH_WINDOW_SIZE", opts.searchWindowSize))
    }
    if ((opts.algo == VecAlgo.Hnsw || opts.algo == VecAlgo.SvsVamana) && opts.epsilon > 0.0) {
      attrs = append(attrs, "EPSILON", "${opts.epsilon}")
    }
    let t = fieldHead(name, opts.alias, "VECTOR")
    t = append(t, algoName(opts.algo), "${len(attrs)}")
    t = append(t, ...attrs)
    return this.plus(append(t, ...flagIf(opts.indexMissing, "INDEXMISSING")))
  }

  // The `SCHEMA` tokens, one field after the other.
  export args(): []string {
    let out = []string(0)
    for t of this.tokens {
      out = append(out, ...t)
    }
    return out
  }

  // How many fields the schema holds.
  export size(): int { return len(this.tokens) }

  plus(t: []string): Schema {
    return Schema{ tokens = append(this.tokens, t) }
  }
}

// An empty schema, to add fields to.
export fn schema(): Schema { return Schema{ tokens = [][]string(0) } }

// `FT.CREATE`'s options besides the schema; unset leaves the server's default.
// `prefixes` limits the index to keys that start with one of them (every key
// when empty); `filter` is an expression over a hash's fields
// (`@stock>0`); `language`/`languageField` and `score`/`scoreField` set the
// defaults a document can override; `temporary` drops the index after that
// many idle seconds; `noOffsets`, `noHl`, `noFields` and `noFreqs` trade
// query features for memory; `stopwords` replaces the default list (an empty
// list disables stopwords); `skipInitialScan` indexes only documents written
// from now on.
export class CreateOptions {
  export over: IndexOn = IndexOn.Hash,
  export prefixes: []string = []string(0),
  export filter: Option<string> = Option.None,
  export language: Option<string> = Option.None,
  export languageField: Option<string> = Option.None,
  export score: Option<f64> = Option.None,
  export scoreField: Option<string> = Option.None,
  export payloadField: Option<string> = Option.None,
  export maxTextFields: bool = false,
  export temporary: Option<i64> = Option.None,
  export noOffsets: bool = false,
  export noHl: bool = false,
  export noFields: bool = false,
  export noFreqs: bool = false,
  export stopwords: Option<[]string> = Option.None,
  export skipInitialScan: bool = false,
}

fn fieldHead(name: string, alias: string, kind: string): []string {
  if (alias == "") {
    return [name, kind]
  }
  return [name, "AS", alias, kind]
}

fn flagIf(set: bool, name: string): []string {
  if (set) {
    return [name]
  }
  return []string(0)
}

fn optPos(name: string, n: i64): []string {
  if (n > 0) {
    return [name, "${n}"]
  }
  return []string(0)
}

fn sortArgs(sortable: bool, unf: bool): []string {
  if (unf) {
    return ["SORTABLE", "UNF"]
  }
  return flagIf(sortable, "SORTABLE")
}

fn phoneticArgs(p: Phonetic): []string {
  match (p) {
    Off => return []string(0)
    English => return ["PHONETIC", "dm:en"]
    French => return ["PHONETIC", "dm:fr"]
    Portuguese => return ["PHONETIC", "dm:pt"]
    Spanish => return ["PHONETIC", "dm:es"]
  }
}

fn metricName(m: VecMetric): string {
  match (m) {
    L2 => return "L2"
    InnerProduct => return "IP"
    Cosine => return "COSINE"
  }
}

fn vecTypeName(t: VecType): string {
  match (t) {
    Float32 => return "FLOAT32"
    Float64 => return "FLOAT64"
    Bfloat16 => return "BFLOAT16"
    Float16 => return "FLOAT16"
  }
}

fn algoName(a: VecAlgo): string {
  match (a) {
    Flat => return "FLAT"
    Hnsw => return "HNSW"
    SvsVamana => return "SVS-VAMANA"
  }
}

fn tokensOpt(name: string, v: Option<string>): []string {
  match (v) {
    Some(s) => return [name, s]
    None => return []string(0)
  }
}

fn createHead(opts: CreateOptions): []string {
  let args = []string(0)
  if (opts.over == IndexOn.Json) {
    args = ["ON", "JSON"]
  }
  if (len(opts.prefixes) > 0) {
    args = append(args, "PREFIX", "${len(opts.prefixes)}")
    args = append(args, ...opts.prefixes)
  }
  args = append(args, ...tokensOpt("FILTER", opts.filter))
  args = append(args, ...tokensOpt("LANGUAGE", opts.language))
  args = append(args, ...tokensOpt("LANGUAGE_FIELD", opts.languageField))
  args = append(args, ...optFloat("SCORE", opts.score))
  args = append(args, ...tokensOpt("SCORE_FIELD", opts.scoreField))
  return append(args, ...tokensOpt("PAYLOAD_FIELD", opts.payloadField))
}

fn createTail(opts: CreateOptions): []string {
  let args = flagIf(opts.maxTextFields, "MAXTEXTFIELDS")
  args = append(args, ...optInt("TEMPORARY", opts.temporary))
  args = append(args, ...flagIf(opts.noOffsets, "NOOFFSETS"))
  args = append(args, ...flagIf(opts.noHl, "NOHL"))
  args = append(args, ...flagIf(opts.noFields, "NOFIELDS"))
  args = append(args, ...flagIf(opts.noFreqs, "NOFREQS"))
  match (opts.stopwords) {
    Some(words) => {
      args = append(args, "STOPWORDS", "${len(words)}")
      args = append(args, ...words)
    }
    None => {}
  }
  return append(args, ...flagIf(opts.skipInitialScan, "SKIPINITIALSCAN"))
}

fn createArgs(index: string, s: Schema, opts: CreateOptions): []string {
  let args = append(["FT.CREATE", index], ...createHead(opts))
  args = append(args, ...createTail(opts))
  args = append(args, "SCHEMA")
  return append(args, ...s.args())
}

fn ftAlterArgs(index: string, s: Schema, skipInitialScan: bool): []string {
  let args = append(["FT.ALTER", index], ...flagIf(skipInitialScan, "SKIPINITIALSCAN"))
  args = append(args, "SCHEMA", "ADD")
  return append(args, ...s.args())
}
