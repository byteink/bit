// pkg/redis/hash.bit — `r.hash(key)`: every hash command, `HSET` through
// field expiry. Epic #6013, #6028, #6029. Follows `cmd.bit`'s HOW-TO header
// and `counter.bit`'s reference shape: one `Cmd<T>` factory per command, an
// immediate method on `Hash`, a queued method on `HashBatch`.
//
// `Hash` HOLDS `runner: Runner` (`cmd.bit`'s HOW-TO header, #6029):
// `r.hash(key)` runs over the pool, `tx.read.hash(key)` over a transaction
// attempt's own pinned connection (`tx.bit`'s header), where the read
// commands (`get`, `getMany`, `all`, `has`, `keys`, `values`, `len`,
// `strLen`, `random`, `scan`, `ttl`, `pttl`, ...) see the keys the
// transaction `WATCH`es. A write there is refused (`runPinnedCmd`,
// `cmd.bit`): queue it with `tx.hash(key)`.
//
// FIELD-EXPIRY CONDITION FLAGS (`NX`/`XX`/`GT`/`LT` on `HEXPIRE`/
// `HPEXPIRE`/`HEXPIREAT`; `FNX`/`FXX` on `HSETEX`) are a plain `when: string
// = ""` parameter, not an enum — a `param`'s default value must be a bare
// literal (int, float, string, bool, or `nil`; SPEC §10.3), and an enum
// variant constructor (`ExpireWhen.None`) is not one. An empty string omits
// the flag; the server rejects an unrecognised one with a normal
// `RedisError`, so there is nothing to validate client-side.
//
// `HSCAN` HAS NO `HashBatch` METHOD — `Batch.queue` hands back one
// `Future<T>` per queued command, but a SCAN cursor is inherently several
// round trips; there is no single reply for a `Future` to resolve to.
// `scan()` lives only on the immediate handle.

import { Millisecond } from "std/time"

export class Hash {
  runner: Runner
  key: string

  export set(fields: map<string, string>): i64!RedisError {
    return this.runner.runCmd(hashSetCmd(this.key, fields))?
  }
  export setField(field: string, value: string): bool!RedisError {
    return this.runner.runCmd(hashSetFieldCmd(this.key, field, value))?
  }
  export get(field: string): Option<string>!RedisError {
    return this.runner.runCmd(hashGetCmd(this.key, field))?
  }
  export getMany(...fields: string): []Option<string>!RedisError {
    return this.runner.runCmd(hashGetManyCmd(this.key, fields))?
  }
  export all(): map<string, string>!RedisError {
    return this.runner.runCmd(hashAllCmd(this.key))?
  }
  export del(...fields: string): i64!RedisError {
    return this.runner.runCmd(hashDelCmd(this.key, fields))?
  }
  export has(field: string): bool!RedisError {
    return this.runner.runCmd(hashHasCmd(this.key, field))?
  }
  export incrBy(field: string, delta: i64): i64!RedisError {
    return this.runner.runCmd(hashIncrByCmd(this.key, field, delta))?
  }
  export incrByFloat(field: string, delta: f64): f64!RedisError {
    return this.runner.runCmd(hashIncrByFloatCmd(this.key, field, delta))?
  }
  export keys(): []string!RedisError {
    return this.runner.runCmd(hashKeysCmd(this.key))?
  }
  export values(): []string!RedisError {
    return this.runner.runCmd(hashValuesCmd(this.key))?
  }
  export len(): i64!RedisError {
    return this.runner.runCmd(hashLenCmd(this.key))?
  }
  export setIfAbsent(field: string, value: string): bool!RedisError {
    return this.runner.runCmd(hashSetIfAbsentCmd(this.key, field, value))?
  }
  export strLen(field: string): i64!RedisError {
    return this.runner.runCmd(hashStrLenCmd(this.key, field))?
  }
  // `HRANDFIELD key count [WITHVALUES]` — the single-field, no-count form
  // (a different reply shape, a bare bulk string) is not exposed here;
  // `count` is always sent, matching this ticket's own wording.
  export random(count: int, withValues: bool = false): []string!RedisError {
    return this.runner.runCmd(hashRandomCmd(this.key, count, withValues))?
  }
  // Lazily follows `HSCAN`'s cursor — see `HashScanIterator` below.
  export scan(pattern: string = "", count: int = 0): HashScanIterator {
    return HashScanIterator{
      runner = this.runner,
      key = this.key,
      pattern = pattern,
      count = count,
      cursor = "0",
      page = []string(0),
      started = false,
    }
  }
  // `ttl` is nanoseconds (`std/time`'s `Second`/`Millisecond`), converted to
  // each wire command's own unit — this file's header.
  export expire(fields: []string, ttl: int, when: string = ""): []i64!RedisError {
    return this.runner.runCmd(hashExpireCmd(this.key, fields, ttl, when))?
  }
  export pexpire(fields: []string, ttl: int, when: string = ""): []i64!RedisError {
    return this.runner.runCmd(hashPexpireCmd(this.key, fields, ttl, when))?
  }
  // `at` is nanoseconds since the Unix epoch (`std/time.now().ns`), not a
  // relative TTL — `HEXPIREAT` wants an absolute unix-time-seconds.
  export expireAt(fields: []string, at: int, when: string = ""): []i64!RedisError {
    return this.runner.runCmd(hashExpireAtCmd(this.key, fields, at, when))?
  }
  // Each field's TTL in seconds, or -1 (no TTL) / -2 (no such field) —
  // Redis's own `HTTL` sentinels, passed through unconverted: turning -1/-2
  // into nanoseconds would misrepresent a sentinel as a duration.
  export ttl(fields: []string): []i64!RedisError {
    return this.runner.runCmd(hashTtlCmd(this.key, fields))?
  }
  export pttl(fields: []string): []i64!RedisError {
    return this.runner.runCmd(hashPttlCmd(this.key, fields))?
  }
  export persist(fields: []string): []i64!RedisError {
    return this.runner.runCmd(hashPersistCmd(this.key, fields))?
  }
  // `HGETEX` — `ttl > 0` sends `EX seconds`; `persist` sends `PERSIST`
  // instead; neither reads the field values without changing their TTL.
  export getEx(fields: []string, ttl: int = 0, persist: bool = false): []Option<string>!RedisError {
    return this.runner.runCmd(hashGetExCmd(this.key, fields, ttl, persist))?
  }
  // `HSETEX` — `keepTtl` sends `KEEPTTL` instead of `EX seconds`, keeping
  // whatever TTL the fields already had.
  export setEx(
    fields: map<string, string>,
    ttl: int,
    when: string = "",
    keepTtl: bool = false,
  ): bool!RedisError {
    return this.runner.runCmd(hashSetExCmd(this.key, fields, ttl, when, keepTtl))?
  }
  export getDel(...fields: string): []Option<string>!RedisError {
    return this.runner.runCmd(hashGetDelCmd(this.key, fields))?
  }
}

// The queued view `Pipeline.hash`/`Tx.hash` both return — `cmd.bit`'s
// `Batch` is the ONE client-side queue the two executors share, so this
// is the ONLY queued view Hash needs (`cmd.bit`'s header, point 2). Every
// method mirrors `Hash`'s own, one command definition shared both ways
// (`cmd.bit`'s header) — except `scan`, this file's header explains why.
export class HashBatch {
  batch: Batch
  key: string

  export set(fields: map<string, string>): Future<i64> {
    return this.batch.queue(hashSetCmd(this.key, fields))
  }
  export setField(field: string, value: string): Future<bool> {
    return this.batch.queue(hashSetFieldCmd(this.key, field, value))
  }
  export get(field: string): Future<Option<string>> {
    return this.batch.queue(hashGetCmd(this.key, field))
  }
  export getMany(...fields: string): Future<[]Option<string>> {
    return this.batch.queue(hashGetManyCmd(this.key, fields))
  }
  export all(): Future<map<string, string>> {
    return this.batch.queue(hashAllCmd(this.key))
  }
  export del(...fields: string): Future<i64> {
    return this.batch.queue(hashDelCmd(this.key, fields))
  }
  export has(field: string): Future<bool> {
    return this.batch.queue(hashHasCmd(this.key, field))
  }
  export incrBy(field: string, delta: i64): Future<i64> {
    return this.batch.queue(hashIncrByCmd(this.key, field, delta))
  }
  export incrByFloat(field: string, delta: f64): Future<f64> {
    return this.batch.queue(hashIncrByFloatCmd(this.key, field, delta))
  }
  export keys(): Future<[]string> {
    return this.batch.queue(hashKeysCmd(this.key))
  }
  export values(): Future<[]string> {
    return this.batch.queue(hashValuesCmd(this.key))
  }
  export len(): Future<i64> {
    return this.batch.queue(hashLenCmd(this.key))
  }
  export setIfAbsent(field: string, value: string): Future<bool> {
    return this.batch.queue(hashSetIfAbsentCmd(this.key, field, value))
  }
  export strLen(field: string): Future<i64> {
    return this.batch.queue(hashStrLenCmd(this.key, field))
  }
  export random(count: int, withValues: bool = false): Future<[]string> {
    return this.batch.queue(hashRandomCmd(this.key, count, withValues))
  }
  export expire(fields: []string, ttl: int, when: string = ""): Future<[]i64> {
    return this.batch.queue(hashExpireCmd(this.key, fields, ttl, when))
  }
  export pexpire(fields: []string, ttl: int, when: string = ""): Future<[]i64> {
    return this.batch.queue(hashPexpireCmd(this.key, fields, ttl, when))
  }
  export expireAt(fields: []string, at: int, when: string = ""): Future<[]i64> {
    return this.batch.queue(hashExpireAtCmd(this.key, fields, at, when))
  }
  export ttl(fields: []string): Future<[]i64> {
    return this.batch.queue(hashTtlCmd(this.key, fields))
  }
  export pttl(fields: []string): Future<[]i64> {
    return this.batch.queue(hashPttlCmd(this.key, fields))
  }
  export persist(fields: []string): Future<[]i64> {
    return this.batch.queue(hashPersistCmd(this.key, fields))
  }
  export getEx(fields: []string, ttl: int = 0, persist: bool = false): Future<[]Option<string>> {
    return this.batch.queue(hashGetExCmd(this.key, fields, ttl, persist))
  }
  export setEx(
    fields: map<string, string>,
    ttl: int,
    when: string = "",
    keepTtl: bool = false,
  ): Future<bool> {
    return this.batch.queue(hashSetExCmd(this.key, fields, ttl, when, keepTtl))
  }
  export getDel(...fields: string): Future<[]Option<string>> {
    return this.batch.queue(hashGetDelCmd(this.key, fields))
  }
}

// Lazily follows `HSCAN`'s cursor, one page at a time, yielding (field,
// value) pairs - `Hash.scan()` above. `next(): Option<T>!` is the fallible
// iterator shape (docs/development/iterator-trait.md, spec section on
// `for_of`): a page fetch that fails (network, timeout, server error) comes
// back as the error and the loop, written `for pair of it?`, returns it.
export class HashScanIterator {
  runner: Runner
  key: string
  pattern: string
  count: int
  cursor: string
  page: []string
  started: bool

  export next(): Option<(string, string)>! {
    while (len(this.page) == 0 && (!this.started || this.cursor != "0")) {
      this.fetch()?
    }
    if (len(this.page) == 0) {
      return Option.None
    }
    let field = this.page[0]
    let value = this.page[1]
    this.page = this.page[2:len(this.page)]
    return Option.Some((field, value))
  }

  fetch(): ()!RedisError {
    this.started = true
    let (cursor, fields) = this.runner.runCmd(
      hashScanCmd(this.key, this.cursor, this.pattern, this.count),
    )?
    this.cursor = cursor
    this.page = fields
  }
}

fn hashSetArgs(key: string, fields: map<string, string>): []string {
  let args = ["HSET", key]
  for (field, value) of fields {
    args = append(args, field)
    args = append(args, value)
  }
  return args
}

fn hashSetCmd(key: string, fields: map<string, string>): Cmd<i64> {
  return Cmd<i64>{
    args = hashSetArgs(key, fields),
    decode = (r) => asInt(r, "HSET"),
    readOnly = false,
  }
}

fn hashSetFieldCmd(key: string, field: string, value: string): Cmd<bool> {
  return Cmd<bool>{
    args = ["HSET", key, field, value],
    decode = (r) => asBool(r, "HSET"),
    readOnly = false,
  }
}

fn hashGetCmd(key: string, field: string): Cmd<Option<string>> {
  return Cmd<Option<string>>{
    args = ["HGET", key, field],
    decode = (r) => asOptString(r, "HGET"),
    readOnly = true,
  }
}

// `args` followed by every element of `fields`, in order — the shared tail
// every multi-field command below builds its wire form from. Copies into a
// fresh backing array rather than appending onto `args` directly: `args` is
// a caller's parameter, and `append` may grow in place when it has spare
// capacity, silently mutating memory the caller still holds a reference to.
fn hashAppendFields(args: []string, fields: []string): []string {
  let out = []string(0)
  let i = 0
  while (i < len(args)) {
    out = append(out, args[i])
    i = i + 1
  }
  i = 0
  while (i < len(fields)) {
    out = append(out, fields[i])
    i = i + 1
  }
  return out
}

// `CMD key field [field ...]` — `HMGET`, `HDEL`: no `FIELDS`/count wrapper,
// unlike the field-expiry family below.
fn hashKeyFieldsArgs(cmd: string, key: string, fields: []string): []string {
  let args = [cmd, key]
  return hashAppendFields(args, fields)
}

fn hashGetManyCmd(key: string, fields: []string): Cmd<[]Option<string>> {
  return Cmd<[]Option<string>>{
    args = hashKeyFieldsArgs("HMGET", key, fields),
    decode = (r) => asOptStrings(r, "HMGET"),
    readOnly = true,
  }
}

fn hashAllCmd(key: string): Cmd<map<string, string>> {
  return Cmd<map<string, string>>{
    args = ["HGETALL", key],
    decode = (r) => asMap(r, "HGETALL"),
    readOnly = true,
  }
}

fn hashDelCmd(key: string, fields: []string): Cmd<i64> {
  return Cmd<i64>{
    args = hashKeyFieldsArgs("HDEL", key, fields),
    decode = (r) => asInt(r, "HDEL"),
    readOnly = false,
  }
}

fn hashHasCmd(key: string, field: string): Cmd<bool> {
  return Cmd<bool>{
    args = ["HEXISTS", key, field],
    decode = (r) => asBool(r, "HEXISTS"),
    readOnly = true,
  }
}

fn hashIncrByCmd(key: string, field: string, delta: i64): Cmd<i64> {
  return Cmd<i64>{
    args = ["HINCRBY", key, field, "${delta}"],
    decode = (r) => asInt(r, "HINCRBY"),
    readOnly = false,
  }
}

fn hashIncrByFloatCmd(key: string, field: string, delta: f64): Cmd<f64> {
  return Cmd<f64>{
    args = ["HINCRBYFLOAT", key, field, "${delta}"],
    decode = (r) => asDouble(r, "HINCRBYFLOAT"),
    readOnly = false,
  }
}

fn hashKeysCmd(key: string): Cmd<[]string> {
  return Cmd<[]string>{
    args = ["HKEYS", key],
    decode = (r) => asStrings(r, "HKEYS"),
    readOnly = true,
  }
}

fn hashValuesCmd(key: string): Cmd<[]string> {
  return Cmd<[]string>{
    args = ["HVALS", key],
    decode = (r) => asStrings(r, "HVALS"),
    readOnly = true,
  }
}

fn hashLenCmd(key: string): Cmd<i64> {
  return Cmd<i64>{ args = ["HLEN", key], decode = (r) => asInt(r, "HLEN"), readOnly = true }
}

fn hashSetIfAbsentCmd(key: string, field: string, value: string): Cmd<bool> {
  return Cmd<bool>{
    args = ["HSETNX", key, field, value],
    decode = (r) => asBool(r, "HSETNX"),
    readOnly = false,
  }
}

fn hashStrLenCmd(key: string, field: string): Cmd<i64> {
  return Cmd<i64>{
    args = ["HSTRLEN", key, field],
    decode = (r) => asInt(r, "HSTRLEN"),
    readOnly = true,
  }
}

fn hashRandomArgs(key: string, count: int, withValues: bool): []string {
  let args = ["HRANDFIELD", key, "${count}"]
  if (withValues) {
    args = append(args, "WITHVALUES")
  }
  return args
}

fn hashRandomCmd(key: string, count: int, withValues: bool): Cmd<[]string> {
  return Cmd<[]string>{
    args = hashRandomArgs(key, count, withValues),
    decode = (r) => asHashRandomFields(r, "HRANDFIELD"),
    readOnly = true,
  }
}

// `CMD key FIELDS numfields field [field ...]` — `HTTL`, `HPTTL`,
// `HPERSIST`, `HGETDEL`: no leading TTL/option argument, unlike
// `hashExpireArgs` below.
fn hashFieldsArgs(cmd: string, key: string, fields: []string): []string {
  let args = [cmd, key, "FIELDS", "${len(fields)}"]
  return hashAppendFields(args, fields)
}

// `CMD key ttlArg [when] FIELDS numfields field [field ...]` — `HEXPIRE`,
// `HPEXPIRE`, `HEXPIREAT`.
fn hashExpireArgs(
  cmd: string,
  key: string,
  ttlArg: string,
  when: string,
  fields: []string,
): []string {
  let args = [cmd, key, ttlArg]
  if (when != "") {
    args = append(args, when)
  }
  args = append(args, "FIELDS")
  args = append(args, "${len(fields)}")
  return hashAppendFields(args, fields)
}

fn hashExpireCmd(key: string, fields: []string, ttl: int, when: string): Cmd<[]i64> {
  return Cmd<[]i64>{
    args = hashExpireArgs("HEXPIRE", key, "${ttl / Second}", when, fields),
    decode = (r) => asInts(r, "HEXPIRE"),
    readOnly = false,
  }
}

fn hashPexpireCmd(key: string, fields: []string, ttl: int, when: string): Cmd<[]i64> {
  return Cmd<[]i64>{
    args = hashExpireArgs("HPEXPIRE", key, "${ttl / Millisecond}", when, fields),
    decode = (r) => asInts(r, "HPEXPIRE"),
    readOnly = false,
  }
}

fn hashExpireAtCmd(key: string, fields: []string, at: int, when: string): Cmd<[]i64> {
  return Cmd<[]i64>{
    args = hashExpireArgs("HEXPIREAT", key, "${at / Second}", when, fields),
    decode = (r) => asInts(r, "HEXPIREAT"),
    readOnly = false,
  }
}

fn hashTtlCmd(key: string, fields: []string): Cmd<[]i64> {
  return Cmd<[]i64>{
    args = hashFieldsArgs("HTTL", key, fields),
    decode = (r) => asInts(r, "HTTL"),
    readOnly = true,
  }
}

fn hashPttlCmd(key: string, fields: []string): Cmd<[]i64> {
  return Cmd<[]i64>{
    args = hashFieldsArgs("HPTTL", key, fields),
    decode = (r) => asInts(r, "HPTTL"),
    readOnly = true,
  }
}

fn hashPersistCmd(key: string, fields: []string): Cmd<[]i64> {
  return Cmd<[]i64>{
    args = hashFieldsArgs("HPERSIST", key, fields),
    decode = (r) => asInts(r, "HPERSIST"),
    readOnly = false,
  }
}

fn hashGetExArgs(key: string, fields: []string, ttl: int, persist: bool): []string {
  let args = ["HGETEX", key]
  if (persist) {
    args = append(args, "PERSIST")
  } else {
    if (ttl > 0) {
      args = append(args, "EX")
      args = append(args, "${ttl / Second}")
    }
  }
  args = append(args, "FIELDS")
  args = append(args, "${len(fields)}")
  return hashAppendFields(args, fields)
}

fn hashGetExCmd(key: string, fields: []string, ttl: int, persist: bool): Cmd<[]Option<string>> {
  return Cmd<[]Option<string>>{
    args = hashGetExArgs(key, fields, ttl, persist),
    decode = (r) => asOptStrings(r, "HGETEX"),
    readOnly = false,
  }
}

fn hashSetExArgs(
  key: string,
  fields: map<string, string>,
  ttl: int,
  when: string,
  keepTtl: bool,
): []string {
  let args = ["HSETEX", key]
  if (when != "") {
    args = append(args, when)
  }
  if (keepTtl) {
    args = append(args, "KEEPTTL")
  } else {
    args = append(args, "EX")
    args = append(args, "${ttl / Second}")
  }
  args = append(args, "FIELDS")
  args = append(args, "${len(fields)}")
  for (field, value) of fields {
    args = append(args, field)
    args = append(args, value)
  }
  return args
}

fn hashSetExCmd(
  key: string,
  fields: map<string, string>,
  ttl: int,
  when: string,
  keepTtl: bool,
): Cmd<bool> {
  return Cmd<bool>{
    args = hashSetExArgs(key, fields, ttl, when, keepTtl),
    decode = (r) => asBool(r, "HSETEX"),
    readOnly = false,
  }
}

fn hashGetDelCmd(key: string, fields: []string): Cmd<[]Option<string>> {
  return Cmd<[]Option<string>>{
    args = hashFieldsArgs("HGETDEL", key, fields),
    decode = (r) => asOptStrings(r, "HGETDEL"),
    readOnly = false,
  }
}

fn hashScanArgs(key: string, cursor: string, pattern: string, count: int): []string {
  let args = ["HSCAN", key, cursor]
  if (pattern != "") {
    args = append(args, "MATCH")
    args = append(args, pattern)
  }
  if (count > 0) {
    args = append(args, "COUNT")
    args = append(args, "${count}")
  }
  return args
}

fn hashScanCmd(key: string, cursor: string, pattern: string, count: int): Cmd<(string, []string)> {
  return Cmd<(string, []string)>{
    args = hashScanArgs(key, cursor, pattern, count),
    decode = (r) => asScanPage(r, "HSCAN"),
    readOnly = true,
  }
}

// `HRANDFIELD ... WITHVALUES` flattened to `[field, value, field, value,
// ...]` regardless of protocol — RESP2 replies with that flat array
// already; RESP3 nests each pair as its own 2-element `Array`, unwrapped
// here so callers see one shape either way.
fn asHashRandomFields(r: Reply, cmd: string): []string!RedisError {
  match (r) {
    Array(items) => return hashRandomFromOpt(items, cmd)?
    _ => fail RedisError.Unexpected(cmd, shapeName(r))
  }
}

fn hashRandomFromOpt(items: Option<[]Reply>, cmd: string): []string!RedisError {
  match (items) {
    Some(list) => return hashRandomFromList(list, cmd)?
    None => return []string(0)
  }
}

// `out` is always a fresh `[]string(0)`-rooted backing array here, never a
// parameter — `hashRandomEntryFields` below hands back a small, independent
// slice (0-2 elements) for `out` to absorb, rather than appending onto a
// caller-owned array itself (the aliasing hazard `hashAppendFields` above
// avoids the same way).
fn hashRandomFromList(list: []Reply, cmd: string): []string!RedisError {
  let out = []string(0)
  let i = 0
  while (i < len(list)) {
    let entry = hashRandomEntryFields(list[i], cmd)?
    let j = 0
    while (j < len(entry)) {
      out = append(out, entry[j])
      j = j + 1
    }
    i = i + 1
  }
  return out
}

// One `HRANDFIELD ... WITHVALUES` reply element as its own fresh slice: a
// bare field (`[field]`), a RESP3 field/value pair (`[field, value]`), or
// nothing (a null pair, `[]string(0)`).
fn hashRandomEntryFields(r: Reply, cmd: string): []string!RedisError {
  match (r) {
    Array(items) => return hashRandomPairFields(items, cmd)?
    _ => {
      let s = replyToString(r, cmd)?
      return [s]
    }
  }
}

fn hashRandomPairFields(items: Option<[]Reply>, cmd: string): []string!RedisError {
  match (items) {
    Some(pair) => return hashRandomPairFieldsFrom(pair, cmd)?
    None => return []string(0)
  }
}

fn hashRandomPairFieldsFrom(pair: []Reply, cmd: string): []string!RedisError {
  if (len(pair) != 2) {
    fail RedisError.Unexpected(cmd, "Array")
  }
  let field = replyToString(pair[0], cmd)?
  let value = replyToString(pair[1], cmd)?
  return [field, value]
}
