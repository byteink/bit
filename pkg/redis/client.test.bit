// pkg/redis/client.test.bit — the connection path against a FAKE local
// server (#3466's constraint: no test may open a connection to a host it did
// not itself start). Redis speaks raw RESP over TCP, not HTTP, so
// stdlib/http/http.bit's `serve` (the pattern _tests_/bit/pmvanity.bit uses for
// its vanity-document fixture) does not apply here — this copies its SHAPE
// instead, over plain `std/net`: bind port 0, `spawn` one accept-and-reply,
// then dial it. `_tests_/imports/nettcp/main.bit` is the same
// listen/spawn/accept/dial shape, unmodified.

import { listen, Listener } from "std/net"

// Accepts up to TWO connections. `connect` (#6022) dials one connection to
// validate `Options` eagerly (`HELLO`, then closed — see `client.bit`'s own
// header on why) before the pool dials the one it actually hands commands
// over, so every `connect` this fake server serves is TWO physical
// connections, not one. Both get the same `HELLO` handshake, acked with an
// empty RESP3 map (`%0\r\n`) never read for content; the probe connection
// closes right after with no further request, the real one sends the
// command under test next, replied to with `reply` verbatim. `done` reports
// how many bytes that real request was, so a test can confirm the client
// wrote a real command before asserting on the reply it got back. Bounded:
// at most 2 accepted connections.
fn serveOnce(l: Listener, reply: string, done: chan<int>) {
  let i = 0
  while (i < 2) {
    i = i + 1
    let c = l.accept() catch _ {
      done <- 0
      return
    }
    c.read(4096)
    c.write("%0\r\n") catch _ {
      c.close()
      done <- 0
      return
    }
    let req = c.read(4096)
    if (len(req) == 0) {
      c.close()
      continue
    }
    c.write(reply) catch _ {
      c.close()
      done <- 0
      return
    }
    c.close()
    done <- len(req)
    return
  }
  done <- 0
}

fn dialFake(reply: string): (Client, chan<int>, Listener) {
  let l = listen("127.0.0.1", 0) catch e {
    panic("listen: ${e.message()}")
  }
  let port = l.port() catch e {
    panic("port: ${e.message()}")
  }
  let done = chan<int>(1)
  spawn serveOnce(l, reply, done)
  let client = connect(Options{ host = "127.0.0.1", port = port }) catch e {
    panic("connect: ${e.message()}")
  }
  return client, done, l
}

// Acceptance clause 3 (#3466): a fake local server replays a GET reply and
// the client returns it.
test "GET returns the value the server replies with" {
  let (client, done, l) = dialFake("\$5\r\nhello\r\n")
  let got = client.get("k") catch e {
    panic("get: ${e.message()}")
  }
  client.close()
  let reqLen = <- done
  l.close()

  assert(reqLen > 0, "server never saw a request")
  assert(isSome(got), "GET k: expected Some, got None")
  assert(unwrap(got) == "hello", "GET k: got '${unwrap(got)}'")
}

// The null-vs-empty distinction (#3466's core requirement), end to end
// through the real client and a real socket, not just the codec directly.
test "GET on a missing key returns None" {
  let (client, done, l) = dialFake("\$-1\r\n")
  let got = client.get("missing") catch e {
    panic("get: ${e.message()}")
  }
  client.close()
  <- done
  l.close()

  assert(isNone(got), "GET missing: expected None, got Some")
}

// The generic escape hatch (#3466): a command this package never named still
// reaches the server and its raw reply comes back untouched.
test "the command escape hatch returns the raw reply untouched" {
  let (client, done, l) = dialFake("*2\r\n\$4\r\nPONG\r\n\$0\r\n\r\n")
  let r = client.command(["CUSTOMCMD", "arg"]) catch e {
    panic("command: ${e.message()}")
  }
  client.close()
  <- done
  l.close()

  match (r) {
    Array(v) => assert(len(unwrap(v)) == 2, "expected a 2-element array reply")
    _ => panic("expected Array, got a different reply type")
  }
}

// A `-ERR` reply is surfaced as a failure, not a silently-wrong value.
test "a -ERR reply surfaces as a failure" {
  let (client, done, l) = dialFake("-ERR unknown command\r\n")
  let failed = false
  let _ = client.get("k") catch _ {
    failed = true
    Option.None
  }
  client.close()
  <- done
  l.close()

  assert(failed, "expected GET to fail on a -ERR reply")
}
