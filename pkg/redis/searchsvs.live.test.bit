// The live controls require the stock harness to provide a real server;
// the schema tuning controls also run offline in the ordinary package gate.
fn searchSvsClient(protocol: int): Client {
  let u = liveUrl("REDIS_TEST_URL")
  assert(u != "", "SVS-VAMANA requires REDIS_TEST_URL from the stock live harness")
  return searchProtocolClient(u, protocol) catch e {
    panic("SVS-VAMANA RESP${protocol}: ${e.message()}")
  }
}

fn searchSvsLive(protocol: int, tuned: bool = false) {
  if (liveUrl("REDIS_TEST_URL") == "") {
    return
  }
  let c = searchSvsClient(protocol)
  defer c.close()
  let index = "bit:live:ft:svs:${protocol}"
  if (tuned) {
    index = "${index}:tuned"
  }
  let prefix = "${index}:"
  let keys = searchKeys(prefix, 4)
  searchClean(c, index, keys)
  defer searchClean(c, index, keys)
  searchSeed(c, prefix)
  let s = c.search(index)
  let opts = VectorOptions{ algo = VecAlgo.SvsVamana }
  if (tuned) {
    opts = searchSvsTunedOptions()
  }
  s.create(
    schema().vector("embedding", 2, opts),
    CreateOptions{ prefixes = [prefix] },
  ) catch e {
    panic("SVS-VAMANA create: ${e.message()}")
  }
  searchWait(s)
  if (tuned) {
    searchSvsTuningInfo(c, index) catch e {
      panic("SVS tuning info: ${e.message()}")
    }
  }
  let near = s.find(
    knn("embedding", [1.0, 0.0], 2, score = "dist"),
    SearchOptions{
      sortBy = Option.Some(SortBy{ field = "dist" }),
      returns = [Returned{ field = "dist" }],
    },
  ) catch e {
    panic("SVS-VAMANA find: ${e.message()}")
  }
  assert(near.total == 2 && len(near.hits) == 2, "SVS-VAMANA two nearest")
  assert(near.hits[0].id == "${prefix}1", "SVS-VAMANA exact nearest id")
  assert(near.hits[1].id == "${prefix}2", "SVS-VAMANA second nearest id")
  assert(near.hits[0].field("dist") == Option.Some("0"), "SVS-VAMANA exact zero score")
}

test "live: RESP2 SVS-VAMANA create and typed KNN" {
  searchSvsLive(2)
}

test "live: RESP3 SVS-VAMANA create and typed KNN" {
  searchSvsLive(3)
}

test "live: SVS-VAMANA rejects FLOAT64 and leaves no usable index" {
  if (liveUrl("REDIS_TEST_URL") == "") {
    return
  }
  let c = searchSvsClient(3)
  defer c.close()
  let index = "bit:live:ft:svs:float64"
  searchClean(c, index, ["${index}:unused"])
  defer searchClean(c, index, ["${index}:unused"])
  let s = c.search(index)
  let refused = false
  s.create(
    schema().vector(
      "embedding",
      2,
      VectorOptions{ algo = VecAlgo.SvsVamana, elem = VecType.Float64 },
    ),
  ) catch e {
    match (e) {
      Server(code, text) => {
        assert(code == "SEARCH_PARSE_ARGS", "SVS-VAMANA FLOAT64 server error code")
        assert(contains(text, "Expected: FLOAT16, FLOAT32"), "SVS-VAMANA FLOAT64 server detail")
        refused = true
      }
      _ => panic("SVS-VAMANA FLOAT64 unexpected failure: ${e.message()}")
    }
  }
  assert(refused, "SVS-VAMANA FLOAT64 rejected by server")
  let listed = s.list() catch e {
    panic(e.message())
  }
  for name of listed {
    assert(name != index, "SVS-VAMANA invalid index absent")
  }
  s.find(everything()) catch _ {
    return
  }
  panic("SVS-VAMANA FLOAT64 left a usable index")
}

fn searchSvsTunedOptions(): VectorOptions {
  return VectorOptions{
    algo = VecAlgo.SvsVamana, constructionWindowSize = 250, graphMaxDegree = 40,
    searchWindowSize = 20, epsilon = 0.02,
  }
}

test "SVS tuning emits each individual option and counts all fourteen combined attributes" {
  let options = [
    VectorOptions{ algo = VecAlgo.SvsVamana, constructionWindowSize = 250 },
    VectorOptions{ algo = VecAlgo.SvsVamana, graphMaxDegree = 40 },
    VectorOptions{ algo = VecAlgo.SvsVamana, searchWindowSize = 20 },
    VectorOptions{ algo = VecAlgo.SvsVamana, epsilon = 0.02 },
  ]
  let names = ["CONSTRUCTION_WINDOW_SIZE", "GRAPH_MAX_DEGREE", "SEARCH_WINDOW_SIZE", "EPSILON"]
  let values = ["250", "40", "20", "0.02"]
  let expected = [
    "v",
    "VECTOR",
    "SVS-VAMANA",
    "8",
    "TYPE",
    "FLOAT32",
    "DIM",
    "2",
    "DISTANCE_METRIC",
    "COSINE",
  ]
  let i = 0
  while (i < 4) {
    assertArgs(schema().vector("v", 2, options[i]).args(), append(expected, names[i], values[i]))
    i = i + 1
  }
  assertArgs(
    schema().vector("v", 2, searchSvsTunedOptions()).args(),
    [
      "v", "VECTOR", "SVS-VAMANA", "14", "TYPE", "FLOAT32", "DIM", "2", "DISTANCE_METRIC", "COSINE",
      "CONSTRUCTION_WINDOW_SIZE", "250", "GRAPH_MAX_DEGREE", "40", "SEARCH_WINDOW_SIZE", "20", "EPSILON", "0.02",
    ],
  )
}

test "SVS tuning omits every zero and negative optional value" {
  for negative of [false, true] {
    let n: i64 = 0
    let epsilon: f64 = 0.0
    if (negative) {
      n = -1
      epsilon = -0.5
    }
    let options = [
      VectorOptions{ algo = VecAlgo.SvsVamana, constructionWindowSize = n },
      VectorOptions{ algo = VecAlgo.SvsVamana, graphMaxDegree = n },
      VectorOptions{ algo = VecAlgo.SvsVamana, searchWindowSize = n },
      VectorOptions{ algo = VecAlgo.SvsVamana, epsilon = epsilon },
    ]
    for opts of options {
      assertArgs(
        schema().vector("v", 2, opts).args(),
        [
          "v",
          "VECTOR",
          "SVS-VAMANA",
          "6",
          "TYPE",
          "FLOAT32",
          "DIM",
          "2",
          "DISTANCE_METRIC",
          "COSINE",
        ],
      )
    }
  }
}

fn searchSvsTuningInfo(c: Client, index: string): ()!RedisError {
  let info = sketchPairs(c.command(["FT.INFO", index])?, "FT.INFO")?
  let fields = replyItems(infoFind(info, "attributes"), "FT.INFO")?
  assert(len(fields) == 1, "SVS tuning has one vector field")
  let attrs = sketchPairs(fields[0], "FT.INFO")?
  let names = ["construction_window_size", "graph_max_degree", "search_window_size"]
  let values: []i64 = [250, 40, 20]
  let i = 0
  while (i < 3) {
    let value = infoFind(attrs, names[i])
    match (value) {
      Null => {
        assert(i == 2, "SVS tuning construction and graph options reported")
        println("SVS tuning FT.INFO ${names[i]} not reported")
      }
      _ => {
        assert(
          asInt(value, "FT.INFO")? == values[i],
          "SVS tuning ${names[i]} exact configured value",
        )
        println("SVS tuning FT.INFO ${names[i]}=${values[i]}")
      }
    }
    i = i + 1
  }
  let epsilon = infoFind(attrs, "epsilon")
  match (epsilon) {
    Null => println("SVS tuning FT.INFO epsilon not reported")
    _ => {
      assert(asDouble(epsilon, "FT.INFO")? == 0.02, "SVS tuning epsilon exact configured value")
      println("SVS tuning FT.INFO epsilon=0.02")
    }
  }
}

test "live: RESP2 tuned SVS-VAMANA create and typed KNN" {
  searchSvsLive(2, true)
}

test "live: RESP3 tuned SVS-VAMANA create and typed KNN" {
  searchSvsLive(3, true)
}
