// pkg/redis/bitmap.bit — `r.bitmap(key)`: the bitmap handle. Epic
// #6013, #6028: SCAFFOLD ONLY, no commands wired yet (`SETBIT, GETBIT, BITCOUNT, BITFIELD`, a
// follow-up ticket) — this file exists so later family tickets touch only
// their own file, never `client.bit`. `cmd.bit`'s header is the template:
// one `Cmd<T>` factory per command, called from a method here.
export class Bitmap {
  client: Client,
  key: string,
}

// The queued view `Pipeline.bitmap`/`Tx.bitmap` both return — `cmd.bit`'s
// `Batch` is the ONE client-side queue the two executors share, so this
// is the ONLY queued view Bitmap needs (`cmd.bit`'s header, point 2).
export class BitmapBatch {
  batch: Batch,
  key: string,
}
