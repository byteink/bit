// Bit toml package — tree.bit, the document tree `parse.bit` builds and the
// redefinition rules that govern it (TOML 1.0.0, #5484, epic #1481).
//
// Split out of `parse.bit`: that file owns the token-level grammar — key/
// value lines, headers, the iterative array/inline-table machine — while
// this one owns the SHAPE a key path resolves to, which redefinitions are
// errors, and how the working tree becomes the `Toml` `tomlParse` returns.
//
// A PATH SEGMENT ARRIVES HERE AS `name` PLUS `offset`, never as an object.
// The offset is only ever a diagnostic's byte position, and `parse.bit`'s
// `KeyPath` holds an undotted key's one segment inline, so a segment object
// in these signatures would be one allocation per key/value pair to carry a
// string and an integer the caller already has (#5583).
//
// ONE TREE, NOT TWO. Every key/value pair in a document costs exactly one
// `TomlEntry`: the one `setLeaf` allocates, appended to the `[]TomlEntry`
// its table accumulates, which IS the slice `finalizeTable` hands to
// `Toml.TomlTable` — no per-entry copy on the way out. Before #5576 a
// parallel `WEntry`/`WNode.WLeaf` spine was built first and converted pair
// by pair, three allocations and two growing arrays per pair instead of one
// and one.
//
// WHAT STILL NEEDS A MUTABLE HALF is the one thing a finished `[]TomlEntry`
// cannot say: which children are STILL OPEN for extension, sometimes long
// after they were first created. That is `WTable.open` — one `WOpen` per
// child that is a table or an array of tables, and none at all for a leaf:
//
//   enum WNode { WSub(WTable), WArr([]WTable) }
//
// A `WOpen` holds the very `TomlEntry` it stands for, whose `value` is a
// placeholder until `finalizeTable` overwrites it in place with the closed
// table.
//
// A key in `entries` with no `WOpen` is therefore a value that can never be
// extended: every ordinary scalar, every `TomlArray`, and — critically — a
// closed inline table, which becomes a plain `TomlTable` entry the instant
// its `}` is seen. Reaching one while resolving any later path (a header, a
// dotted key) is always an error, and that ONE check — `findOpen` empty,
// `hasEntry` true — is what implements three of the spec's separate rules at
// once: colliding with a plain value, redefining an intermediate as a
// non-table, and extending an inline table. They are the same case here.
//
// EXPLICIT VS IMPLICIT. `WTable.explicit` is true exactly when a `[header]`
// (not `[[...]]`) has claimed this exact table. A dotted key's intermediate
// segments only ever create `explicit: false` tables (TOML's grammar never
// lets a dotted key's non-terminal segment be anything else), and
// descending an EXISTING table — by dotted key or as a header's own
// intermediate segment — never checks or sets this flag: TOML allows
// `[a]` followed by `b.c = 1` to extend `a` with a new implicit `b` freely.
// The flag matters at exactly one place, `reopenTableHeader`: a `[header]`
// whose full path already resolves to a table that is already `explicit`
// is the spec's "you cannot define a table more than once". `[[array]]`
// headers never redefine — a repeated `[[x]]` always appends — so array
// elements carry no such flag at all.
//
// `finalizeTable` IS mutual recursion, unlike `parse.bit`'s deliberately
// iterative value nesting — but it runs only after the whole document is
// already built, and `newChildTable` refused every table past
// `tomlMaxDepth` on the way in, so its worst case is a compile-time-bounded
// 128 frames, not input-driven.

// --- the mutable half of the working tree ------------------------------

// A child that is still open for extension.
enum WNode {
  WSub(WTable),
  WArr([]WTable),
}

// The mutable half of ONE child entry: `entry` is the very `TomlEntry` the
// parent's `entries` already holds, and `finalizeTable` writes the closed
// table straight into its `value`. A leaf has no `WOpen` at all.
class WOpen { entry: TomlEntry, node: WNode }

// `entries` is the table's final `[]TomlEntry`, in source order, built in
// place; `open` is the subset of those entries still extensible. `depth` is
// this table's distance from the root, checked by `newChildTable` against
// `tomlMaxDepth` so `finalizeTable`'s recursion is bounded by a constant
// rather than by how many dots a header or key chain contains.
//
// `slots` is the table's key index, an open-addressed hash table over
// the keys in `entries`. It stays empty until a lookup finds the table
// `keyIndexMin` wide (`useIndex`); below that `hasEntry`/`findOpen` scan,
// and a narrow table never pays for an index. Without one every key a
// table gains is compared against every key it already has, so a table
// of N children costs N^2/2 string compares — the 1000-wide
// `[service.*]` table in bench/data/config.toml spent 15% of the whole
// parse in those compares (#6052). A slot is 0 when empty, `i + 1` for
// the leaf `entries[i]` and `-(j + 1)` for the open child `open[j]`, so
// one probe answers both `hasEntry` and `findOpen`. A slot holds no key:
// a probe compares against the key the `TomlEntry` already holds.
//
// `depth` is an `i32` so it packs beside `explicit` and `slots` still
// fits a 32-byte object: as an `int` it pushed every table, wide or not,
// into the next allocation size class, +1.2% bytes allocated and 3-5%
// more cycles on bench/data/fixture.toml, whose tables never index.
class WTable {
  entries: []TomlEntry,
  open: []WOpen,
  explicit: bool,
  depth: i32,
  slots: []i32,
}

// The width from which a lookup builds and then uses `slots`. A scan
// costs one string compare per key already present; the index costs one
// hash and one probe per lookup, one more per new key, and one hash and
// insert per key the table holds when it is built.
const keyIndexMin = 32

// The widest table `useIndex` builds an index for; a wider one scans. It
// keeps a slot value, at most `keyIndexMax + 1` before growth drops the
// index (`indexLast`), inside an `i32`.
const keyIndexMax = 1 << 28

// The value an open child's entry carries until its table closes. Never
// observable: `finalizeTable` overwrites every one of them before the tree
// leaves `tomlParse`.
fn wPending(): Toml {
  return Toml.TomlBool(false)
}

fn newRootTable(): WTable {
  return WTable{ entries = []TomlEntry(0), open = []WOpen(0), explicit = true, depth = 0 }
}

// A new child of `parent`, refusing once nesting would exceed
// `tomlMaxDepth` — the one place table depth is bounded, shared by dotted
// keys, `[header]`, and `[[header]]` alike.
fn newChildTable(parent: WTable, explicit: bool, offset: int): WTable! {
  if (int(parent.depth) + 1 > tomlMaxDepth) {
    fail tomlParseError("table nesting exceeds maximum depth", offset)
  }
  return WTable{
    entries = []TomlEntry(0),
    open = []WOpen(0),
    explicit = explicit,
    depth = parent.depth + 1,
  }
}

// Whether `t` already holds any entry — leaf or table — under `key` (not
// recursive). A bool, not an `Option<TomlEntry>`: this runs once per
// key/value pair in the document and no caller needs the entry itself.
fn hasEntry(t: WTable, key: string): bool {
  if (len(t.entries) >= keyIndexMin && useIndex(t)) {
    return t.slots[keySlot(t, key)] != 0
  }
  let i = 0
  while (i < len(t.entries)) {
    if (t.entries[i].key == key) {
      return true
    }
    i = i + 1
  }
  return false
}

// The still-open child named `key`, or none — which means either no such
// key at all or a key whose entry is a leaf; `hasEntry` tells those apart.
fn findOpen(t: WTable, key: string): Option<WOpen> {
  if (len(t.entries) >= keyIndexMin && useIndex(t)) {
    let v = t.slots[keySlot(t, key)]
    if (v >= 0) {
      return Option<WOpen>.None
    }
    return Option<WOpen>.Some(t.open[-int(v) - 1])
  }
  let i = 0
  while (i < len(t.open)) {
    if (t.open[i].entry.key == key) {
      return Option<WOpen>.Some(t.open[i])
    }
    i = i + 1
  }
  return Option<WOpen>.None
}

// Appends one open child: its `TomlEntry` takes its place in `t.entries` in
// source order now, and `finalizeTable` fills in the value later.
fn addOpen(t: WTable, key: string, node: WNode) {
  let entry = TomlEntry{ key = key, value = wPending() }
  t.entries = append(t.entries, entry)
  t.open = append(t.open, WOpen{ entry = entry, node = node })
  if (indexed(t)) {
    indexLast(t, key, -i32(len(t.open)))
  }
}

fn indexed(t: WTable): bool {
  return len(t.slots) != 0
}

// Whether a lookup in `t`, already `keyIndexMin` wide, goes through
// `slots`, building it first if `t` has none. Every append to a table is
// preceded by a lookup in it, so the build replaces a scan over the same
// entries: a table that stops growing at `keyIndexMin` never builds one,
// and one that grows past it pays a hash per entry where it would have
// paid a compare (#6471).
fn useIndex(t: WTable): bool {
  if (indexed(t)) {
    return true
  }
  if (len(t.entries) > keyIndexMax) {
    return false
  }
  let count = 4 * keyIndexMin
  while (count < 2 * len(t.entries)) {
    count = 2 * count
  }
  buildIndex(t, count)
  return true
}

// FNV-1a over `key`'s bytes, the high half folded into the low one so the
// low bits a probe masks off depend on every byte.
fn keyHash(key: string): int {
  let h: u64 = 0xcbf29ce484222325
  let i = 0
  while (i < len(key)) {
    h = (h ^ u64(key[i])) * 0x100000001b3
    i = i + 1
  }
  return int(h ^ (h >> 32))
}

// The slot holding `key` in an `indexed` table, or the empty slot that
// ends its probe run when `t` has no such key. `slots` is never more than
// half full, so the run always ends inside one lap.
fn keySlot(t: WTable, key: string): int {
  let mask = len(t.slots) - 1
  let i = keyHash(key) & mask
  let n = 0
  while (n <= mask) {
    let v = t.slots[i]
    if (v == 0 || slotKey(t, v) == key) {
      return i
    }
    i = (i + 1) & mask
    n = n + 1
  }
  panic("pkg/toml: key index has no empty slot")
}

// The key of the entry a non-empty slot names.
fn slotKey(t: WTable, v: i32): string {
  if (v > 0) {
    return t.entries[int(v) - 1].key
  }
  return t.open[-int(v) - 1].entry.key
}

// The first empty slot on the probe run of hash `h`, where a key the table
// does not hold yet goes.
fn emptySlot(t: WTable, h: int): int {
  let mask = len(t.slots) - 1
  let i = h & mask
  let n = 0
  while (n <= mask) {
    if (t.slots[i] == 0) {
      return i
    }
    i = (i + 1) & mask
    n = n + 1
  }
  panic("pkg/toml: key index has no empty slot")
}

// Records `key`, the entry just appended to an `indexed` table, as slot
// value `v`. A record that would fill more than half the slots drops the
// index instead, and the lookup that precedes the next append rebuilds it
// at least twice as large. Callers test `indexed` first, so a narrow
// table's append pays one compare, not a call.
fn indexLast(t: WTable, key: string, v: i32) {
  if (2 * len(t.entries) > len(t.slots)) {
    t.slots = []i32(0)
    return
  }
  t.slots[emptySlot(t, keyHash(key))] = v
}

// Every key `t` holds, in a fresh index of `count` slots. `open` holds the
// open children in the order `entries` does, and a key occurs once per
// table, so walking the two together tells a leaf from an open child with
// one compare instead of a second probe.
fn buildIndex(t: WTable, count: int) {
  t.slots = []i32(count)
  let j = 0
  let i = 0
  while (i < len(t.entries)) {
    let key = t.entries[i].key
    let v = i32(i + 1)
    if (j < len(t.open) && t.open[j].entry.key == key) {
      v = -i32(j + 1)
      j = j + 1
    }
    t.slots[emptySlot(t, keyHash(key))] = v
    i = i + 1
  }
}

// Descends one INTERMEDIATE path segment (never the terminal one) from `t`:
// creates an implicit sub-table the first time `name` is seen, otherwise
// descends into an existing table — or, per TOML's array-of-tables
// extension rule, the LAST element of an existing array of tables. A leaf
// here is always an error: the segment already names a value, not a table.
fn descendIntermediate(t: WTable, name: string, offset: int): WTable! {
  let open = findOpen(t, name)
  match (open) {
    Some(o) => { return descendIntoExisting(o) }
    None => {
      if (hasEntry(t, name)) {
        fail tomlParseError("'${name}' is already defined and is not a table", offset)
      }
      let sub = newChildTable(t, false, offset)?
      addOpen(t, name, WNode.WSub(sub))
      return sub
    }
  }
}

fn descendIntoExisting(o: WOpen): WTable {
  match (o.node) {
    WSub(sub) => { return sub }
    WArr(tables) => { return tables[len(tables) - 1] }
  }
}

// The terminal segment of a `[header]` (never `[[...]]`): creates a new
// explicit table, or claims an existing implicit one, or fails — a table
// already explicit, an array of tables, or a plain value are all
// redefinitions.
fn openTableHeader(t: WTable, name: string, offset: int): WTable! {
  let open = findOpen(t, name)
  match (open) {
    Some(o) => { return reopenTableHeader(o, name, offset)? }
    None => {
      if (hasEntry(t, name)) {
        fail tomlParseError("'${name}' is already defined", offset)
      }
      let sub = newChildTable(t, true, offset)?
      addOpen(t, name, WNode.WSub(sub))
      return sub
    }
  }
}

fn reopenTableHeader(o: WOpen, name: string, offset: int): WTable! {
  match (o.node) {
    WSub(sub) => {
      if (sub.explicit) {
        fail tomlParseError("table '${name}' redefined", offset)
      }
      sub.explicit = true
      return sub
    }
    WArr(_) => { fail tomlParseError("'${name}' is already an array of tables", offset) }
  }
}

// The terminal segment of a `[[header]]`: always appends a fresh table to
// the array (or creates a one-element array the first time), unless `key`
// already names a plain table or a value.
fn openArrayTableHeader(t: WTable, name: string, offset: int): WTable! {
  let open = findOpen(t, name)
  match (open) {
    Some(o) => { return appendArrayTable(t, o, name, offset)? }
    None => {
      if (hasEntry(t, name)) {
        fail tomlParseError("'${name}' is already defined", offset)
      }
      let fresh = newChildTable(t, true, offset)?
      addOpen(t, name, WNode.WArr([fresh]))
      return fresh
    }
  }
}

fn appendArrayTable(t: WTable, o: WOpen, name: string, offset: int): WTable! {
  match (o.node) {
    WArr(tables) => {
      let fresh = newChildTable(t, true, offset)?
      o.node = WNode.WArr(append(tables, fresh))
      return fresh
    }
    WSub(_) => { fail tomlParseError("'${name}' is already a table", offset) }
  }
}

// Sets a terminal key/value pair on `t`: any existing entry under this
// exact name — leaf, table, or array of tables — is a duplicate key. The
// `TomlEntry` appended here is the one the caller of `tomlParse` gets back,
// never a copy of it (see this file's header).
fn setLeaf(t: WTable, name: string, offset: int, value: Toml): ()! {
  if (hasEntry(t, name)) {
    fail tomlParseError("duplicate key '${name}'", offset)
  }
  t.entries = append(t.entries, TomlEntry{ key = name, value = value })
  if (indexed(t)) {
    indexLast(t, name, i32(len(t.entries)))
  }
  return
}

// --- closing the open children -----------------------------------------
//
// Safe as ordinary (mutual) recursion: `newChildTable` already refused any
// table past `tomlMaxDepth` on the way in, so this walk is bounded by that
// same compile-time constant, not by anything still under an attacker's
// control (see this file's header).

// Overwrites each open child's placeholder value with its closed table and
// boxes `t.entries` as it already stands — no per-entry copy: leaves have
// been in their final form since `setLeaf` built them.
fn finalizeTable(t: WTable): Toml {
  let i = 0
  while (i < len(t.open)) {
    let o = t.open[i]
    o.entry.value = finalizeNode(o.node)
    i = i + 1
  }
  return Toml.TomlTable(t.entries)
}

fn finalizeNode(n: WNode): Toml {
  match (n) {
    WSub(sub) => { return finalizeTable(sub) }
    WArr(tables) => { return Toml.TomlArray(finalizeArray(tables)) }
  }
}

fn finalizeArray(tables: []WTable): []Toml {
  let out = []Toml(0, len(tables))
  let i = 0
  while (i < len(tables)) {
    out = append(out, finalizeTable(tables[i]))
    i = i + 1
  }
  return out
}
