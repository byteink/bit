// pkg/toml/tree.test.bit — #6052's key index: a table at least
// `keyIndexMin` wide answers `hasEntry`/`findOpen` from `WTable.index`
// instead of a scan, and every redefinition rule and the source order of
// its entries must come out exactly as the scan gave them.
//
// `parseOk`, `parseErrOffset`, `asTable` and `findKey` are parse.test.bit's
// own helpers, module-wide like everything else in this package.

// `n` key/value lines `k0 = 0` .. `k<n-1> = <n-1>`.
fn wideKeys(n: int): string {
  let s = ""
  let i = 0
  while (i < n) {
    s = s + "k${i} = ${i}\n"
    i = i + 1
  }
  return s
}

test "a table past keyIndexMin keeps every key, in source order" {
  let n = keyIndexMin + 9
  let t = asTable(findKey(asTable(parseOk("[t]\n" + wideKeys(n))), "t"))
  assert(len(t) == n, "want ${n} entries, got ${len(t)}")
  let i = 0
  while (i < n) {
    assert(t[i].key == "k${i}", "entry ${i} is '${t[i].key}'")
    assert(unwrap(tomlAsInt(t[i].value)) == i, "value of k${i}")
    i = i + 1
  }
}

test "a duplicate key past keyIndexMin fails at its own offset" {
  let head = "[t]\n" + wideKeys(keyIndexMin + 4)
  assert(parseErrOffset(head + "k3 = 9\n") == len(head), "duplicate k3")
}

test "an open child created before the index is built is found through it" {
  let src = "[t.early]\na = 1\n[t]\n" + wideKeys(keyIndexMin + 4) + "[t.early.deep]\nb = 2\n"
  let t = asTable(findKey(asTable(parseOk(src)), "t"))
  let deep = asTable(findKey(asTable(findKey(t, "early")), "deep"))
  assert(unwrap(tomlAsInt(findKey(deep, "b"))) == 2, "t.early.deep.b")
  assert(t[0].key == "early", "the open child keeps its source position")
}

test "a leaf past keyIndexMin still refuses a header that reopens it" {
  let head = "[t]\n" + wideKeys(keyIndexMin + 4)
  assert(parseErrOffset(head + "[t.k5]\n") == len(head) + 3, "[t.k5] over a leaf")
}

test "[[array]] headers past keyIndexMin append to the same array" {
  let src = "[t]\n" + wideKeys(keyIndexMin + 4) + "[[t.items]]\nx = 1\n[[t.items]]\nx = 2\n"
  let t = asTable(findKey(asTable(parseOk(src)), "t"))
  let items = unwrap(tomlAsArray(findKey(t, "items")))
  assert(len(items) == 2, "want 2 elements, got ${len(items)}")
  assert(unwrap(tomlAsInt(findKey(asTable(items[1]), "x"))) == 2, "second element")
}

test "a [header] past keyIndexMin cannot redefine an explicit sub-table" {
  let head = "[t]\n" + wideKeys(keyIndexMin + 4) + "[t.sub]\n"
  assert(parseErrOffset(head + "[t.sub]\n") == len(head) + 3, "[t.sub] twice")
}

// `[a.a. ... .a]` with `n` segments: every segment is a table, the last
// one `n` levels below the root.
fn deepHeader(n: int): string {
  let s = "[a"
  let i = 1
  while (i < n) {
    s = s + ".a"
    i = i + 1
  }
  return s + "]\n"
}

test "a header exactly tomlMaxDepth deep opens; one more segment fails at that segment" {
  let t = parseOk(deepHeader(tomlMaxDepth) + "x = 1\n")
  assert(len(asTable(t)) == 1, "the root holds one table")
  assert(
    parseErrOffset(deepHeader(tomlMaxDepth + 1)) == 1 + 2 * tomlMaxDepth,
    "segment ${tomlMaxDepth + 1}",
  )
}
