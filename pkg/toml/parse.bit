// Bit toml package — parse.bit, the document parser and the package's main
// entry point: `tomlParse` (TOML 1.0.0, #5484, epic #1481).
//
// This file owns the STRUCTURAL half of TOML: key/value lines, dotted keys,
// `[table]` and `[[array of tables]]` headers, inline tables and arrays, and
// every redefinition rule. It drives `pkg/toml/lex.bit`'s streaming
// `lexNext` (never `lex`, which materializes `[]Token`) and calls
// `tomlDecodeString`/`tomlDecodeNumber`/`tomlDecodeDateTime` for every
// scalar — no string, number or date-time grammar is re-implemented here.
//
// THE WORKING DOCUMENT TREE — `WTable`, every redefinition rule, and the
// conversion to `Toml` — lives next door in `pkg/toml/tree.bit`. Nothing in
// this file decides what a key path means; it resolves one through
// `descendIntermediate`/`openTableHeader`/`openArrayTableHeader`/`setLeaf`
// and lets that file answer.
//
// NO RECURSION FOR VALUE NESTING. `parseCompoundValue` drives an explicit
// stack of `Ctx` frames for arrays and inline tables, never a function
// calling itself, so a maliciously deep run of `[`/`{` cannot grow the Bit
// call stack — `pushContainer` refuses once `frames.n >= tomlMaxDepth`
// (`lex.bit`'s own bracket-depth cap, reused here as this parser's own flat
// counter).
//
// INLINE TABLES ROUTE THROUGH THE SAME WTABLE PATH. TOML 1.0.0 permits
// dotted keys inside `{ }` (`{ a.b = 1 }`): an inline table's `Ctx` (below)
// holds its own `WTable`, and each `key = value` — dotted or not — is
// applied with the same `applyKeyValue` a document-level key/value line
// uses, so intermediate segments get the same implicit-table and
// already-defined checks. The inline table still closes to an immutable
// `Toml` the instant its `}` is seen (`finalizeTable(top.table)`, in
// `stepObject`/`readInlineKey`): a dotted key just means more structure gets
// built before that one closing conversion, never a way around it.
//
// KEY TOKENS THAT AREN'T `BareKey`. `lex.bit`'s scanner reclassifies the
// bare words `true`/`false`/`inf`/`nan` and any all-digit run as
// `Bool`/`Number` even in key position (its own header: a key-position digit
// run has no way to tell itself apart from a value at the scanner level).
// `readKeyName` accepts those tokens back as bare-key text too. A
// `Number` span that is a plain `digits '.' digits` float — no sign, no
// exponent — is TOML's "numeric dotted key" (`1.2 = 3` meaning table `1`
// key `2`): `numericKeySplit`/`numericKeyDot` re-split it into two
// segments here, at the layer that knows a key path is expected, without
// touching `lex.bit`'s own — correct — classification of that span as a
// number. A sign or an exponent in a `Number` key span has no bare-key
// spelling either way and stays rejected.

// --- the parser ----------------------------------------------------------

// `boolTrue`/`boolFalse` are the document's two `TomlBool` values, built
// once here and handed to every `true`/`false` in it. A `Toml` is immutable
// once built and carries no identity a caller can observe, so one box per
// spelling is indistinguishable from one box per occurrence — and a boxed
// `Toml` is 32 bytes, which a bool-heavy document pays on every line
// (13,004 of them on pkg/toml/bench/data/fixture.toml, #5581).
class Parser {
  src: string,
  lx: Lexer,
  root: WTable,
  current: WTable,
  boolTrue: Toml,
  boolFalse: Toml,
}

fn newTomlParser(src: string): Parser {
  let root = newRootTable()
  let p = Parser{
    src: src,
    lx: newLexer(src),
    root: root,
    current: root,
    boolTrue: Toml.TomlBool(true),
    boolFalse: Toml.TomlBool(false),
  }
  lexNext(p.lx)
  return p
}

// Moves past the token under the cursor. At `Eof` it stays put, mirroring
// `stdlib/json/parse.bit`'s own `advance`.
fn advance(p: Parser) {
  if (p.lx.kind != TokenKind.Eof) {
    lexNext(p.lx)
  }
}

// An upper bound on the tokens `p.src` can still yield: every token
// consumes at least one source byte, plus a guard slot.
fn tokenBound(p: Parser): int {
  return len(p.src) + 2
}

fn tomlParseError(msg: string, offset: int): error {
  return TomlError{ offset: offset, msg: msg }
}

export fn tomlParse(src: string): Toml! {
  let p = newTomlParser(src)
  parseDocument(p)?
  return finalizeTable(p.root)
}

// Consumes a run of `Newline`/`Comment` tokens. Bounded implicitly: every
// token consumed strictly advances `p.lx`'s cursor over a finite source,
// the same argument `lex.bit`'s own scanners rely on for their unguarded
// `while (lx.i < len(lx.src))` loops.
fn skipBlankLines(p: Parser) {
  while (p.lx.kind == TokenKind.Newline || p.lx.kind == TokenKind.Comment) {
    advance(p)
  }
}

fn parseDocument(p: Parser): ()! {
  let guard = 0
  let bound = tokenBound(p)
  while (guard <= bound) {
    skipBlankLines(p)
    if (p.lx.kind == TokenKind.Eof) {
      return
    }
    if (p.lx.kind == TokenKind.LBracket) {
      parseHeaderLine(p)?
    } else {
      parseKeyValueLine(p)?
    }
    guard = guard + 1
  }
  fail tomlParseError("document exceeds token bound", p.lx.start)
}

fn expectRBracket(p: Parser): ()! {
  if (p.lx.kind != TokenKind.RBracket) {
    fail tomlParseError("expected ']'", p.lx.start)
  }
  advance(p)
  return
}

// A line's own end: an optional trailing comment, then a newline or EOF.
// Anything else — a second value, a stray token — is TOML 1.0.0's "each
// key/value pair (and each header) is its own line" rule.
fn expectLineEnd(p: Parser): ()! {
  if (p.lx.kind == TokenKind.Comment) {
    advance(p)
  }
  if (p.lx.kind == TokenKind.Newline) {
    advance(p)
    return
  }
  if (p.lx.kind == TokenKind.Eof) {
    return
  }
  fail tomlParseError("expected newline after value", p.lx.start)
}

// `[a.b.c]` / `[[a.b.c]]`: one `[` already confirmed by the caller.
fn parseHeaderLine(p: Parser): ()! {
  advance(p)
  let isArray = p.lx.kind == TokenKind.LBracket
  if (isArray) {
    advance(p)
  }
  let path = parseKeyPath(p)?
  expectRBracket(p)?
  if (isArray) {
    expectRBracket(p)?
  }
  expectLineEnd(p)?
  p.current = resolveHeader(p, path, isArray)?
  return
}

// A header's own path resolution. `path` always carries at least its first
// segment — `parseKeyPath` reads one or fails — so `[]` is `readKeyName`'s
// own "expected a key", never an empty path this has to answer for.
fn resolveHeader(p: Parser, path: KeyPath, isArray: bool): WTable! {
  let t = descendPrefix(p.root, path)?
  if (isArray) {
    return openArrayTableHeader(t, lastName(path), lastOffset(path))?
  }
  return openTableHeader(t, lastName(path), lastOffset(path))?
}

fn parseKeyValueLine(p: Parser): ()! {
  let path = parseKeyPath(p)?
  if (p.lx.kind != TokenKind.Equals) {
    fail tomlParseError("expected '=' after key", p.lx.start)
  }
  advance(p)
  let value = parseValue(p)?
  expectLineEnd(p)?
  applyKeyValue(p.current, path, value)?
  return
}

fn applyKeyValue(t: WTable, path: KeyPath, value: Toml): ()! {
  let cur = descendPrefix(t, path)?
  setLeaf(cur, lastName(path), lastOffset(path), value)?
  return
}

// Descends every segment of `path` but the last, creating implicit tables on
// the way — the prefix walk a `[header]` and a dotted key/value line share.
// An undotted path has no prefix at all, which is the common case.
fn descendPrefix(t: WTable, path: KeyPath): WTable! {
  let n = len(path.rest)
  if (n == 0) {
    return t
  }
  let cur = descendIntermediate(t, path.name, path.offset)?
  let i = 0
  while (i < n - 1) {
    cur = descendIntermediate(cur, path.rest[i].name, path.rest[i].offset)?
    i = i + 1
  }
  return cur
}

// The terminal segment — the one `setLeaf`/`openTableHeader`/
// `openArrayTableHeader` acts on. Its name and its offset are read
// separately so an undotted path never has to materialize a segment object
// for a name and an offset `KeyPath` already holds inline.
fn lastName(path: KeyPath): string {
  let n = len(path.rest)
  if (n == 0) {
    return path.name
  }
  return path.rest[n - 1].name
}

fn lastOffset(path: KeyPath): int {
  let n = len(path.rest)
  if (n == 0) {
    return path.offset
  }
  return path.rest[n - 1].offset
}

// A parsed key path: the first segment's name and the byte offset of its own
// token, held INLINE — the only segment an undotted key has, which is nearly
// every key in a document — with `rest` left at its zero value (SPEC §13.4:
// an omitted slice field IS the empty slice, no allocation) until a `.` is
// actually seen. Before #5583 a path was a `[]KeySeg`, so every key in the
// document paid a slice header, a one-element element buffer and a `KeySeg`
// object to say one name and one offset.
class KeyPath { name: string, offset: int, rest: []KeySeg }

// One path segment past the first, paired with the byte offset of its own
// token — `TomlError.offset` names the failing construct, not the whole line.
class KeySeg { name: string, offset: int }

// One or more `.`-separated key segments. Bounded by `tokenBound`: each
// extra segment consumes at least a `.` and a key token.
fn parseKeyPath(p: Parser): KeyPath! {
  let path = startKeyPath(p)?
  let guard = 0
  let bound = tokenBound(p)
  while (p.lx.kind == TokenKind.Dot && guard <= bound) {
    advance(p)
    extendKeyPath(p, path)?
    guard = guard + 1
  }
  return path
}

// The path's first segment — or its first TWO, for a numeric dotted key,
// the one token that stands for two segments (see this file's header).
fn startKeyPath(p: Parser): KeyPath! {
  let start = p.lx.start
  let end = p.lx.end
  let split = numericKeySplit(p)
  match (split) {
    Some(d) => {
      advance(p)
      let path = KeyPath{ name: p.src[start:d], offset: start }
      path.rest = append(path.rest, KeySeg{ name: p.src[d + 1:end], offset: d + 1 })
      return path
    }
    None => { return KeyPath{ name: readKeyName(p)?, offset: start } }
  }
}

// One more segment appended to `path` — or two, for a numeric dotted key.
fn extendKeyPath(p: Parser, path: KeyPath): ()! {
  let start = p.lx.start
  let end = p.lx.end
  let split = numericKeySplit(p)
  match (split) {
    Some(d) => {
      advance(p)
      path.rest = append(path.rest, KeySeg{ name: p.src[start:d], offset: start })
      path.rest = append(path.rest, KeySeg{ name: p.src[d + 1:end], offset: d + 1 })
      return
    }
    None => {
      path.rest = append(path.rest, KeySeg{ name: readKeyName(p)?, offset: start })
      return
    }
  }
}

// The offset of the `.` inside the token under the cursor when that token is
// TOML's numeric dotted key — a `Number` span that is a plain
// `digits '.' digits` float, no sign and no exponent. None for every other
// token, other `Number` spans included, which is what lets the readers below
// treat one token as exactly one segment.
fn numericKeySplit(p: Parser): Option<int> {
  if (p.lx.kind != TokenKind.Number) {
    return Option<int>.None
  }
  return numericKeyDot(p.src, p.lx.start, p.lx.end)
}

// One key segment's text, consumed: a bare key, `true`/`false` (lexed as
// `Bool` even in key position), a quoted key, or a `Number`/`DateTime` span
// that stays inside the bare-key charset. The segment's own OFFSET is
// `p.lx.start`, which every caller reads before calling — a second return
// value would allocate a pair to carry an integer the caller already has.
fn readKeyName(p: Parser): string! {
  let kind = p.lx.kind
  let start = p.lx.start
  let end = p.lx.end
  switch (kind) {
    case TokenKind.BareKey, TokenKind.Bool:
      advance(p)
      return p.src[start:end]
    case TokenKind.BasicString, TokenKind.LiteralString:
      advance(p)
      return tomlDecodeString(p.src, kind, start, end)?
    case TokenKind.Number:
      return numericKeyName(p, start, end)?
    case TokenKind.DateTime:
      return dateTimeKeyName(p, start, end)?
    default:
      fail tomlParseError("expected a key", start)
  }
}

// A key segment the lexer read as `Number`, `numericKeySplit` having already
// ruled out the dotted form — `A-Za-z0-9_-` is the bare-key charset (TOML
// 1.0.0 §Keys), a strict superset of digits, so any Number span that never
// leaves that charset is a bare key re-read as text (`-1`, `10e3`, `34-11`,
// a lone `-`), never a hard error; `inf`/`nan` are checked ahead of the
// fallback for the same reason `scanWordOrBareKey` checks them ahead of
// `BareKey` — both are this package's ONLY unquoted-numeric-word literals.
fn numericKeyName(p: Parser, start: int, end: int): string! {
  let text = p.src[start:end]
  if (text == "inf" || text == "nan" || isAllBareKeyChars(p.src, start, end)) {
    advance(p)
    return text
  }
  fail tomlParseError("unsupported numeric key form", start)
}

// A key segment the lexer read as `DateTime` (e.g. a bare `2001-02-03`,
// whose digits-then-dash shape happens to match TOML's date-time grammar)
// — the same bare-key-charset fallback as `numericKeyName`, since
// `isDateTimeChar` permits `:`/`.`/`+`, which are never legal in a bare
// key, so a genuine date-time-shaped SPAN (not just its digit-and-dash
// prefix) in key position still correctly falls through to the error.
fn dateTimeKeyName(p: Parser, start: int, end: int): string! {
  if (isAllBareKeyChars(p.src, start, end)) {
    advance(p)
    return p.src[start:end]
  }
  fail tomlParseError("expected a key", start)
}

// Whether every byte in `[start, end)` is a bare-key character
// (`A-Za-z0-9_-`, TOML 1.0.0 §Keys) — the grammar a key position accepts
// unquoted regardless of how the context-free lexer classified the span.
fn isAllBareKeyChars(src: string, start: int, end: int): bool {
  let i = start
  while (i < end) {
    if (!isBareKeyChar(src[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

// The offset of `.` within `[start,end)` when the span is a plain
// `digits '.' digits` float — no sign, no exponent — none for `inf`/`nan`,
// a bare digit run, or anything a sign/exponent character would produce.
fn numericKeyDot(src: string, start: int, end: int): Option<int> {
  let i = start
  while (i < end) {
    if (src[i] == '.') {
      return validNumericDot(src, start, i, end)
    }
    i = i + 1
  }
  return Option<int>.None
}

fn validNumericDot(src: string, start: int, dot: int, end: int): Option<int> {
  if (dot == start || dot == end - 1) {
    return Option<int>.None
  }
  if (!isAllDigits(src, start, dot) || !isAllDigits(src, dot + 1, end)) {
    return Option<int>.None
  }
  return Option<int>.Some(dot)
}

fn isAllDigits(src: string, start: int, end: int): bool {
  let i = start
  while (i < end) {
    if (!isDigit(src[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

// --- values: scalars, plus the iterative array/inline-table machine -----

fn parseValue(p: Parser): Toml! {
  if (atContainerStart(p)) {
    return parseCompoundValue(p)?
  }
  return readScalar(p)?
}

// Whether the cursor sits on `[`/`{` — every value position's cue to open a
// container instead of reading a scalar. A predicate rather than a scalar
// reader answering `Option<Toml>`, which is how this file did it before
// #5576: that shape boxed an `Option` around every scalar in the document,
// one allocation per key/value pair, to report a decision that reads one
// token kind.
fn atContainerStart(p: Parser): bool {
  return p.lx.kind == TokenKind.LBracket || p.lx.kind == TokenKind.LBrace
}

// One scalar token, consumed and decoded. Callers rule out `[`/`{` with
// `atContainerStart` first; anything else in value position is a hard
// error, containers included.
fn readScalar(p: Parser): Toml! {
  let kind = p.lx.kind
  let start = p.lx.start
  let end = p.lx.end
  switch (kind) {
    case TokenKind.BasicString,
      TokenKind.LiteralString,
      TokenKind.MlBasicString,
      TokenKind.MlLiteralString:
      advance(p)
      return Toml.TomlString(tomlDecodeString(p.src, kind, start, end)?)
    case TokenKind.Number:
      advance(p)
      return tomlDecodeNumber(p.src, start, end)?
    case TokenKind.Bool:
      advance(p)
      if (p.src[start] == 't') {
        return p.boolTrue
      }
      return p.boolFalse
    case TokenKind.DateTime:
      advance(p)
      return tomlDecodeDateTime(p.src, start, end)?
    default:
      fail tomlParseError("expected a value", start)
  }
}

// One open array or inline table, in progress.
enum CKind { CArr, CObj }

// `table` is a `CObj`'s working tree, built through the same
// `descendIntermediate`/`setLeaf` a document-level key/value line uses (see
// this file's header) — unused for a `CArr`, same as `items` is unused for
// a `CObj`.
class Ctx {
  kind: CKind,
  items: []Toml,
  table: WTable,
  pendingKey: Option<KeyPath>,
  expectSeparator: bool,
}

// Only `table` is built up front: every other field's zero value (SPEC
// §13.4) is already the state a fresh frame is in — an omitted slice field
// IS the empty slice and an omitted `Option` IS `None` — so a frame
// allocates nothing for a field it has not been given anything to hold.
fn newCtx(kind: CKind): Ctx {
  return Ctx{ kind: kind, table: newRootTable() }
}

// What one token-driven step of the innermost open container did. One
// payload word carried by one payload-carrying variant is SPEC §14.7's
// VALUE form: two machine words, no heap object, nothing allocated to
// report a step. Opening a container is deliberately NOT an outcome —
// `pushContainer` grows the frame stack itself and reports `Continue` —
// because a second payload type here would box every step (#5583).
enum StepOutcome {
  Continue,
  Close(Toml),
}

// The open containers, innermost last: `items[0:n]`. A class rather than a
// bare `[]Ctx` local so a step that opens a container can grow the stack in
// place instead of handing a new slice value back through a result object —
// that shape cost an `ApplyResult` plus its `Option<Toml>` on every step of
// every array and inline table (#5583). `n` is the live depth rather than
// `len(items)` so a pop keeps the buffer instead of reslicing it.
class Frames { items: []Ctx, n: int }

fn pushFrame(f: Frames, ctx: Ctx) {
  if (f.n < len(f.items)) {
    f.items[f.n] = ctx
  } else {
    f.items = append(f.items, ctx)
  }
  f.n = f.n + 1
}

fn topFrame(f: Frames): Ctx {
  return f.items[f.n - 1]
}

// Reads one whole array or inline table (`p.lx` already confirmed to sit on
// `[`/`{`) without ever calling itself: nesting is an explicit frame stack,
// so an arbitrarily deep run of open brackets grows Bit heap memory, never
// the call stack (see this file's header). `Close` pops, and either hands
// the finished value to the frame below or — with none left — reports it as
// the whole compound value.
fn parseCompoundValue(p: Parser): Toml! {
  let firstKind = CKind.CArr
  if (p.lx.kind == TokenKind.LBrace) {
    firstKind = CKind.CObj
  }
  advance(p)
  let frames = Frames{}
  pushFrame(frames, newCtx(firstKind))
  let guard = 0
  let bound = tokenBound(p)
  while (guard <= bound) {
    let outcome = stepFrame(p, topFrame(frames), frames)?
    match (outcome) {
      Continue => {}
      Close(v) => {
        frames.n = frames.n - 1
        if (frames.n == 0) {
          return v
        }
        attachValue(topFrame(frames), v)?
      }
    }
    guard = guard + 1
  }
  fail tomlParseError("value nesting exceeds token bound", p.lx.start)
}

fn stepFrame(p: Parser, top: Ctx, frames: Frames): StepOutcome! {
  if (top.kind == CKind.CArr) {
    return stepArray(p, top, frames)?
  }
  return stepObject(p, top, frames)?
}

// Attaches a just-closed nested value to its parent frame — the array-
// append case, or the pending path's terminal `setLeaf` through the same
// `applyKeyValue` a document-level key/value line uses, matching
// `readArrayElement`/`readInlineValue`'s own scalar handling exactly.
fn attachValue(parent: Ctx, v: Toml): ()! {
  if (parent.kind == CKind.CArr) {
    parent.items = append(parent.items, v)
    parent.expectSeparator = true
    return
  }
  let pending = parent.pendingKey
  match (pending) {
    Some(path) => { applyKeyValue(parent.table, path, v)? }
    // A `CObj` frame opens a nested container only from `readInlineValue`,
    // which runs with a key already pending, so this arm is an invariant
    // this parser holds, never a document it can be handed.
    None => { panic("pkg/toml: inline table closed a nested value with no key pending") }
  }
  parent.pendingKey = Option<KeyPath>.None
  parent.expectSeparator = true
  return
}

// Opens a new container, refusing once `frames.n` already sits at
// `tomlMaxDepth` — this parser's own flat depth counter, independent of
// `lex.bit`'s own bracket-depth cap. The frame is pushed here rather than
// returned, which is what keeps `StepOutcome` unboxed (above).
fn pushContainer(p: Parser, frames: Frames): StepOutcome! {
  if (frames.n >= tomlMaxDepth) {
    fail tomlParseError("value nesting exceeds maximum depth", p.lx.start)
  }
  let kind = CKind.CArr
  if (p.lx.kind == TokenKind.LBrace) {
    kind = CKind.CObj
  }
  advance(p)
  pushFrame(frames, newCtx(kind))
  return StepOutcome.Continue
}

// Newlines and comments are insignificant inside `[ ]` (TOML 1.0.0
// "Array") — never inside `{ }`, so `stepObject` never calls this.
fn skipArrayFiller(p: Parser) {
  skipBlankLines(p)
}

fn stepArray(p: Parser, top: Ctx, frames: Frames): StepOutcome! {
  skipArrayFiller(p)
  if (top.expectSeparator) {
    if (p.lx.kind == TokenKind.RBracket) {
      advance(p)
      return StepOutcome.Close(Toml.TomlArray(top.items))
    }
    if (p.lx.kind != TokenKind.Comma) {
      fail tomlParseError("expected ',' or ']' in array", p.lx.start)
    }
    advance(p)
    top.expectSeparator = false
    skipArrayFiller(p)
  }
  if (p.lx.kind == TokenKind.RBracket) {
    advance(p)
    return StepOutcome.Close(Toml.TomlArray(top.items))
  }
  return readArrayElement(p, top, frames)?
}

fn readArrayElement(p: Parser, top: Ctx, frames: Frames): StepOutcome! {
  if (atContainerStart(p)) {
    return pushContainer(p, frames)?
  }
  top.items = append(top.items, readScalar(p)?)
  top.expectSeparator = true
  return StepOutcome.Continue
}

// No trailing comma, no newline (TOML 1.0.0 "Inline Table": both illegal).
fn stepObject(p: Parser, top: Ctx, frames: Frames): StepOutcome! {
  if (p.lx.kind == TokenKind.Newline) {
    fail tomlParseError("newline not allowed in inline table", p.lx.start)
  }
  let pending = top.pendingKey
  match (pending) {
    Some(path) => { return readInlineValue(p, top, path, frames)? }
    None => {}
  }
  if (top.expectSeparator) {
    if (p.lx.kind == TokenKind.RBrace) {
      advance(p)
      return StepOutcome.Close(finalizeTable(top.table))
    }
    if (p.lx.kind != TokenKind.Comma) {
      fail tomlParseError("expected ',' or '}' in inline table", p.lx.start)
    }
    advance(p)
    top.expectSeparator = false
  }
  return readInlineKey(p, top)?
}

// A dotted path is read with `parseKeyPath`, the same as a document-level
// key/value line — duplicate-key and already-defined-as-a-value rejection
// come from `applyKeyValue`'s own `descendIntermediate`/`setLeaf` once the
// value is read (`readInlineValue`), not from a separate check here.
fn readInlineKey(p: Parser, top: Ctx): StepOutcome! {
  if (p.lx.kind == TokenKind.RBrace && len(top.table.entries) == 0) {
    advance(p)
    return StepOutcome.Close(finalizeTable(top.table))
  }
  let path = parseKeyPath(p)?
  if (p.lx.kind != TokenKind.Equals) {
    fail tomlParseError("expected '=' after key", p.lx.start)
  }
  advance(p)
  top.pendingKey = Option<KeyPath>.Some(path)
  return StepOutcome.Continue
}

fn readInlineValue(p: Parser, top: Ctx, path: KeyPath, frames: Frames): StepOutcome! {
  if (atContainerStart(p)) {
    return pushContainer(p, frames)?
  }
  let v = readScalar(p)?
  applyKeyValue(top.table, path, v)?
  top.pendingKey = Option<KeyPath>.None
  top.expectSeparator = true
  return StepOutcome.Continue
}
