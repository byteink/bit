// Bit toml package — value.bit, the Toml value sum type and TomlEntry
// (#5479, epic #1481).
//
// The one value primitive the rest of the package is built on: no parser,
// no encoder, no I/O — just the type and pure accessors, modeled on
// stdlib/json/value.bit and carrying over its two decisions. `TomlTable` is
// `[]TomlEntry`, not `map<string, Toml>`: TOML tables have a defined source
// order and duplicate-key detection is the parser's job, both of which a
// map would destroy.
//
// Accessors are free functions, mirroring stdlib/core/option.bit's style
// (methods on generic types don't parse yet, and every accessor here
// returns the generic `Option<T>`) rather than methods on `Toml`.
//
// The four temporal arms reuse std/time's existing types rather than
// defining new ones: `DateTime` for an offset date-time, `NaiveDateTime`
// for a local date-time, `Date` for a local date, `Time` for a local time
// (TOML 1.0.0, "Offset Date-Time" / "Local Date-Time" / "Local Date" /
// "Local Time"). TOML 1.0.0 has no null, so there is no null arm here.
//
// Ten arms means an exhaustive per-variant match (json/value.bit's shape,
// one arm per variant naming every other variant `false`/`None`) scores
// complexity 11 against E0204's 10-arm ceiling on every accessor below. Each
// one instead matches only the variant it answers for and covers the other
// nine with `_`, the same reshaping stdlib/quic/frameclass.bit already uses
// for this exact problem — no behavior change, since every wildcarded arm
// answered `false`/`None` either way.

import { DateTime, NaiveDateTime, Date, Time } from "std/time"

// One key/value pair of a TOML table, in source order.
export class TomlEntry { export key: string, export value: Toml }

// A TOML value (TOML 1.0.0).
export enum Toml {
  TomlString(string),
  TomlInt(i64),
  TomlFloat(f64),
  TomlBool(bool),
  TomlOffsetDateTime(DateTime),
  TomlLocalDateTime(NaiveDateTime),
  TomlLocalDate(Date),
  TomlLocalTime(Time),
  TomlArray([]Toml),
  TomlTable([]TomlEntry),
}

export fn tomlIsString(t: Toml): bool {
  match (t) {
    TomlString(_) => { return true }
    _ => { return false }
  }
}

export fn tomlIsInt(t: Toml): bool {
  match (t) {
    TomlInt(_) => { return true }
    _ => { return false }
  }
}

export fn tomlIsFloat(t: Toml): bool {
  match (t) {
    TomlFloat(_) => { return true }
    _ => { return false }
  }
}

export fn tomlIsBool(t: Toml): bool {
  match (t) {
    TomlBool(_) => { return true }
    _ => { return false }
  }
}

export fn tomlIsOffsetDateTime(t: Toml): bool {
  match (t) {
    TomlOffsetDateTime(_) => { return true }
    _ => { return false }
  }
}

export fn tomlIsLocalDateTime(t: Toml): bool {
  match (t) {
    TomlLocalDateTime(_) => { return true }
    _ => { return false }
  }
}

export fn tomlIsLocalDate(t: Toml): bool {
  match (t) {
    TomlLocalDate(_) => { return true }
    _ => { return false }
  }
}

export fn tomlIsLocalTime(t: Toml): bool {
  match (t) {
    TomlLocalTime(_) => { return true }
    _ => { return false }
  }
}

export fn tomlIsArray(t: Toml): bool {
  match (t) {
    TomlArray(_) => { return true }
    _ => { return false }
  }
}

export fn tomlIsTable(t: Toml): bool {
  match (t) {
    TomlTable(_) => { return true }
    _ => { return false }
  }
}

// The string payload, or None when `t` is not a TomlString.
export fn tomlAsString(t: Toml): Option<string> {
  match (t) {
    TomlString(s) => { return Option<string>.Some(s) }
    _ => { return Option<string>.None }
  }
}

// The int payload, or None when `t` is not a TomlInt.
export fn tomlAsInt(t: Toml): Option<i64> {
  match (t) {
    TomlInt(i) => { return Option<i64>.Some(i) }
    _ => { return Option<i64>.None }
  }
}

// The float payload, or None when `t` is not a TomlFloat.
export fn tomlAsFloat(t: Toml): Option<f64> {
  match (t) {
    TomlFloat(f) => { return Option<f64>.Some(f) }
    _ => { return Option<f64>.None }
  }
}

// The bool payload, or None when `t` is not a TomlBool.
export fn tomlAsBool(t: Toml): Option<bool> {
  match (t) {
    TomlBool(b) => { return Option<bool>.Some(b) }
    _ => { return Option<bool>.None }
  }
}

// The offset date-time payload, or None when `t` is not a
// TomlOffsetDateTime.
export fn tomlAsOffsetDateTime(t: Toml): Option<DateTime> {
  match (t) {
    TomlOffsetDateTime(d) => { return Option<DateTime>.Some(d) }
    _ => { return Option<DateTime>.None }
  }
}

// The local date-time payload, or None when `t` is not a TomlLocalDateTime.
export fn tomlAsLocalDateTime(t: Toml): Option<NaiveDateTime> {
  match (t) {
    TomlLocalDateTime(d) => { return Option<NaiveDateTime>.Some(d) }
    _ => { return Option<NaiveDateTime>.None }
  }
}

// The local date payload, or None when `t` is not a TomlLocalDate.
export fn tomlAsLocalDate(t: Toml): Option<Date> {
  match (t) {
    TomlLocalDate(d) => { return Option<Date>.Some(d) }
    _ => { return Option<Date>.None }
  }
}

// The local time payload, or None when `t` is not a TomlLocalTime.
export fn tomlAsLocalTime(t: Toml): Option<Time> {
  match (t) {
    TomlLocalTime(v) => { return Option<Time>.Some(v) }
    _ => { return Option<Time>.None }
  }
}

// The array payload, or None when `t` is not a TomlArray.
export fn tomlAsArray(t: Toml): Option<[]Toml> {
  match (t) {
    TomlArray(a) => { return Option<[]Toml>.Some(a) }
    _ => { return Option<[]Toml>.None }
  }
}

// The entries of a TomlTable, in source order, or None when `t` is not a
// TomlTable. Returns the same `[]TomlEntry` the value already stores — no
// copy — so duplicate keys and insertion order are both preserved exactly
// as parsed.
export fn tomlAsTable(t: Toml): Option<[]TomlEntry> {
  match (t) {
    TomlTable(entries) => { return Option<[]TomlEntry>.Some(entries) }
    _ => { return Option<[]TomlEntry>.None }
  }
}
