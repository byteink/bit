// pkg/toml/corpus.test.bit — runs the vendored toml-test compliance corpus
// (_tests_/corpus/toml-test/, #5487, epic #1481) through `tomlParse`.
//
// Same flat module as parse.bit/encode.bit/value.bit etc (pkg/README.md):
// `Toml`, `TomlEntry`, `tomlParse`, and every `tomlIs*`/`tomlAs*` accessor
// are all reached unqualified, no import, no redeclaration.
//
// NOT encode.test.bit's OWN `tomlEqual` — this file's own `corpusEqual`
// reuses its SCALAR leaves (`tomlEqualString`/`tomlEqualInt`/
// `tomlEqualFloatArm`/`tomlEqualBool`/`tomlEqualTemporal`, all
// variant-safe: each returns false on a mismatched arm rather than
// unwrapping blind) but writes its OWN table comparison, because
// `tomlEqual`'s is POSITIONAL by design (encode.test.bit's own header: a
// property of TOML's text grammar, correct for a round-trip fixture built
// scalars-before-sub-tables). toml-test's own `.json` files are a JSON
// object per TOML table, and JSON object key order carries no meaning —
// `valid/array/array.json` lists its five keys alphabetically while the
// `.toml` source declares them `ints, floats, strings, dates, comments`.
// Comparing that pair positionally fails EVERY multi-key table in this
// corpus, which is a bug in the comparison, not the parser. Arrays stay
// positional (`corpusEqualArray`) — TOML array order is significant.
//
// BIT_REPO IS REQUIRED, never "." — `_tests_/bit/packagesgate.bit` documents
// it the same way: a "." fallback resolves against the test runner's cwd,
// not the repo, and a corpus walk over the wrong directory reads as zero
// fixtures found, which `corpusRunHalf` treats as a hard failure (asserted
// non-zero BEFORE anything about pass/fail results), never a silent green.
//
// EACH HALF'S OWN QUESTION (this ticket's own instruction — "did not error"
// alone passes a parser that returns an empty table for everything):
//   valid/   — parses, AND the value structurally equals the sibling
//              .json's toml-test-tagged encoding (`corpusJsonToToml`
//              decodes that tagging onto `Toml`, `corpusEqual` compares).
//   invalid/ — every fixture is REJECTED; a parser that accepts an invalid
//              file is exactly the defect this half exists to catch.
//
// EXCLUSIONS carry a `Reason`, never a bare path — an unexplained exclusion
// is indistinguishable from a silently failing case (this ticket's own
// constraint). Each excluded case is a real, currently-open gap in this
// package's OWN `pkg/toml/*.bit` (parse.bit/lex.bit/etc, none of which
// this ticket owns or edits — see smash #5487's ticket comment for the
// filed follow-up), not a corpus-vendoring choice, so the prose reason
// lives on the ticket, not restated in every comment here.

import { env } from "std/os"
import { readFile, walk } from "std/fs"
import { Json, JsonEntry, jsonParse, jsonAsObject, jsonAsArray, jsonAsString } from "std/json"
import { hasSuffix, parseInt } from "std/strings"

// A case this corpus cannot pass without a change to this package's own
// `*.bit` files (constraints forbid that here); `path` is corpus-root-
// relative, e.g. `"invalid/string/..."`.
class CorpusExclusion { path: string, reason: string }

// A slice literal is not a `const_expr` (SPEC S11.2), so this is a
// function, not a top-level `const` — same reason parse.bit's own
// `newRootTable`/`newCtx` build their zero-valued slices in a function
// body rather than a const.
//
// Every entry here is a REAL gap in pkg/toml/lex.bit, parse.bit or
// number.bit (none of which this ticket owns or edits), filed and grouped
// by root cause on smash #5514. Shrink this list in the SAME commit that
// fixes each area — never leave a fixed case excluded.
fn corpusExclusionList(): []CorpusExclusion {
  let reasonFloatPrecision = "#5514: decimal float decode loses precision (naive digit accumulation, not correctly-rounded decimal-to-binary)"
  let reasonRedefinition = "#5514: table redefinition rules are too permissive — non-adjacent [[ ]] brackets, and reopening/extending a table a dotted key already gave leaf content or array-of-tables membership"
  let reasonBadUtf8 = "#5514: an invalid UTF-8 byte sequence (surrogate codepoint, overlong or truncated encoding) is not rejected"
  return [
    CorpusExclusion{ path: "valid/comment/tricky.toml", reason: reasonFloatPrecision },
    CorpusExclusion{ path: "valid/spec-1.0.0/float-0.toml", reason: reasonFloatPrecision },
    CorpusExclusion{ path: "valid/key/dotted-03.toml", reason: reasonFloatPrecision },
    CorpusExclusion{ path: "invalid/table/llbrace.toml", reason: reasonRedefinition },
    CorpusExclusion{ path: "invalid/table/rrbrace.toml", reason: reasonRedefinition },
    CorpusExclusion{ path: "invalid/table/duplicate-key-04.toml", reason: reasonRedefinition },
    CorpusExclusion{ path: "invalid/table/duplicate-key-05.toml", reason: reasonRedefinition },
    CorpusExclusion{ path: "invalid/spec-1.0.0/table-9-0.toml", reason: reasonRedefinition },
    CorpusExclusion{ path: "invalid/spec-1.0.0/table-9-1.toml", reason: reasonRedefinition },
    CorpusExclusion{ path: "invalid/table/redefine-02.toml", reason: reasonRedefinition },
    CorpusExclusion{ path: "invalid/table/redefine-03.toml", reason: reasonRedefinition },
    CorpusExclusion{
      path: "invalid/table/append-with-dotted-keys-01.toml",
      reason: reasonRedefinition,
    },
    CorpusExclusion{
      path: "invalid/table/append-with-dotted-keys-02.toml",
      reason: reasonRedefinition,
    },
    CorpusExclusion{
      path: "invalid/table/append-with-dotted-keys-03.toml",
      reason: reasonRedefinition,
    },
    CorpusExclusion{
      path: "invalid/table/append-with-dotted-keys-08.toml",
      reason: reasonRedefinition,
    },
    CorpusExclusion{ path: "invalid/array/extend-defined-aot.toml", reason: reasonRedefinition },
    CorpusExclusion{ path: "invalid/encoding/bad-codepoint.toml", reason: reasonBadUtf8 },
    CorpusExclusion{ path: "invalid/encoding/bad-utf8-in-comment.toml", reason: reasonBadUtf8 },
    CorpusExclusion{
      path: "invalid/encoding/bad-utf8-in-multiline-literal.toml",
      reason: reasonBadUtf8,
    },
    CorpusExclusion{ path: "invalid/encoding/bad-utf8-in-multiline.toml", reason: reasonBadUtf8 },
    CorpusExclusion{
      path: "invalid/encoding/bad-utf8-in-string-literal.toml",
      reason: reasonBadUtf8,
    },
    CorpusExclusion{ path: "invalid/encoding/bad-utf8-in-string.toml", reason: reasonBadUtf8 },
  ]
}

fn corpusIsExcluded(rel: string): bool {
  let exclusions = corpusExclusionList()
  let i = 0
  while (i < len(exclusions)) {
    if (exclusions[i].path == rel) {
      return true
    }
    i = i + 1
  }
  return false
}

fn corpusRepoRoot(): string {
  let r = env("BIT_REPO")
  if (len(r) == 0) {
    panic("toml corpus: BIT_REPO is not set — run this through `./make test-package-toml`")
  }
  return r
}

fn corpusRoot(): string {
  return "${corpusRepoRoot()}/_tests_/corpus/toml-test"
}

fn corpusDir(kind: string): string {
  return "${corpusRoot()}/${kind}"
}

// `full` is always `corpusRoot()` plus `/` plus the relative path — every
// caller derives it from a `walk(corpusDir(kind))` result.
fn corpusRelPath(full: string): string {
  let root = corpusRoot()
  return full[len(root) + 1:len(full)]
}

// `path` ends in ".toml" (caller-filtered); both suffixes are 5 bytes.
fn corpusJsonSibling(path: string): string {
  return path[0:len(path) - 5] + ".json"
}

// --- toml-test's tagged JSON encoding -> Toml ---------------------------

class CorpusTag { tag: string, value: string }

fn corpusFindEntry(entries: []JsonEntry, key: string): Option<Json> {
  let i = 0
  while (i < len(entries)) {
    if (entries[i].key == key) {
      return Option<Json>.Some(entries[i].value)
    }
    i = i + 1
  }
  return Option<Json>.None
}

// An object is a tagged scalar exactly when it has two entries named
// "type" and "value", both strings (toml-test's own convention) — anything
// else, including a table that happens to hold a key literally named
// "type", falls through to `corpusObjectToToml`'s table arm.
fn corpusTaggedValue(entries: []JsonEntry): Option<CorpusTag> {
  if (len(entries) != 2) {
    return Option<CorpusTag>.None
  }
  let typeJ = corpusFindEntry(entries, "type")
  let valueJ = corpusFindEntry(entries, "value")
  if (!isSome(typeJ) || !isSome(valueJ)) {
    return Option<CorpusTag>.None
  }
  let tag = jsonAsString(unwrap(typeJ))
  let val = jsonAsString(unwrap(valueJ))
  if (!isSome(tag) || !isSome(val)) {
    return Option<CorpusTag>.None
  }
  return Option<CorpusTag>.Some(CorpusTag{ tag: unwrap(tag), value: unwrap(val) })
}

// "inf"/"-inf"/"nan" (toml-test's own float spelling) via this package's
// own `specialFloat` (number.bit), never re-derived here. Anything else
// goes through the predeclared `parseFloat` builtin (SPEC S5.3, not
// fallible) directly — no import, and NaN out of it (never produced by a
// genuine "nan" fixture, already routed through `specialFloat` above) is
// the builtin's own failure signal.
fn corpusParseFloat(text: string): f64! {
  let special = specialFloat(text, 0, len(text))
  match (special) {
    Some(v) => { return v }
    None => {}
  }
  let v = parseFloat(text)
  if (v != v) {
    fail corpusError("invalid float '${text}'")
  }
  return v
}

fn corpusScalarFromTag(tag: string, value: string): Toml! {
  if (tag == "string") {
    return Toml.TomlString(value)
  }
  if (tag == "integer") {
    return Toml.TomlInt(parseInt(value)?)
  }
  if (tag == "float") {
    return Toml.TomlFloat(corpusParseFloat(value)?)
  }
  if (tag == "bool") {
    return Toml.TomlBool(value == "true")
  }
  return corpusTemporalFromTag(tag, value)?
}

// The four temporal tags, each via std/time's own parser (value.bit's own
// import) — toml-test's json "value" text is already canonical RFC 3339,
// so no separator/zone normalization is needed here the way
// `pkg/toml/datetime.bit` needs it for raw TOML source text.
fn corpusTemporalFromTag(tag: string, value: string): Toml! {
  if (tag == "datetime") {
    return Toml.TomlOffsetDateTime(parseDateTime(value)?)
  }
  if (tag == "datetime-local") {
    return Toml.TomlLocalDateTime(parseNaiveDateTime(value)?)
  }
  if (tag == "date-local") {
    return Toml.TomlLocalDate(parseDate(value)?)
  }
  if (tag == "time-local") {
    return Toml.TomlLocalTime(parseTime(value)?)
  }
  fail corpusError("unknown toml-test tag '${tag}'")
}

fn corpusJsonEntriesToToml(entries: []JsonEntry): []TomlEntry! {
  let out = []TomlEntry(0, len(entries))
  let i = 0
  while (i < len(entries)) {
    let v = corpusJsonToToml(entries[i].value)?
    out = append(out, TomlEntry{ key: entries[i].key, value: v })
    i = i + 1
  }
  return out
}

fn corpusJsonArrayToToml(items: []Json): []Toml! {
  let out = []Toml(0, len(items))
  let i = 0
  while (i < len(items)) {
    out = append(out, corpusJsonToToml(items[i])?)
    i = i + 1
  }
  return out
}

fn corpusObjectToToml(entries: []JsonEntry): Toml! {
  let tagged = corpusTaggedValue(entries)
  match (tagged) {
    Some(t) => { return corpusScalarFromTag(t.tag, t.value)? }
    None => { return Toml.TomlTable(corpusJsonEntriesToToml(entries)?) }
  }
}

fn corpusJsonToToml(j: Json): Toml! {
  let obj = jsonAsObject(j)
  match (obj) {
    Some(entries) => { return corpusObjectToToml(entries)? }
    None => {}
  }
  let arr = jsonAsArray(j)
  match (arr) {
    Some(items) => { return Toml.TomlArray(corpusJsonArrayToToml(items)?) }
    None => { fail corpusError("expected-json fixture is neither an object nor an array") }
  }
}

fn corpusError(msg: string): error {
  return newError("toml corpus: ${msg}")
}

// --- structural equality against the expected fixture --------------------
//
// Own comparison, not encode.test.bit's `tomlEqual` (this file's header
// explains why: JSON object key order carries no meaning, but `tomlEqual`'s
// table comparison is positional on purpose for its own round-trip
// fixtures). The five scalar/temporal leaves below ARE reused —
// `tomlEqualString`/`tomlEqualInt`/`tomlEqualFloatArm`/`tomlEqualBool`/
// `tomlEqualTemporal` (encode.test.bit) are pure value comparisons, each
// already returns false on a mismatched arm, nothing round-trip-specific
// about any of them.

fn corpusEqual(a: Toml, b: Toml): bool {
  if (tomlIsString(a)) {
    return tomlEqualString(a, b)
  }
  if (tomlIsInt(a)) {
    return tomlEqualInt(a, b)
  }
  if (tomlIsFloat(a)) {
    return tomlEqualFloatArm(a, b)
  }
  if (tomlIsBool(a)) {
    return tomlEqualBool(a, b)
  }
  if (tomlIsArray(a)) {
    return corpusEqualArray(a, b)
  }
  if (tomlIsTable(a)) {
    return corpusEqualTable(a, b)
  }
  return tomlEqualTemporal(a, b)
}

// Positional — TOML array order is significant.
fn corpusEqualArray(a: Toml, b: Toml): bool {
  if (!tomlIsArray(b)) {
    return false
  }
  let xa = unwrap(tomlAsArray(a))
  let xb = unwrap(tomlAsArray(b))
  if (len(xa) != len(xb)) {
    return false
  }
  let i = 0
  while (i < len(xa)) {
    if (!corpusEqual(xa[i], xb[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

// Key-set comparison, NOT positional — see this file's header.
fn corpusEqualTable(a: Toml, b: Toml): bool {
  if (!tomlIsTable(b)) {
    return false
  }
  let ea = unwrap(tomlAsTable(a))
  let eb = unwrap(tomlAsTable(b))
  if (len(ea) != len(eb)) {
    return false
  }
  let i = 0
  while (i < len(ea)) {
    let found = corpusFindTomlEntry(eb, ea[i].key)
    let ok = corpusEntryMatches(found, ea[i].value)
    if (!ok) {
      return false
    }
    i = i + 1
  }
  return true
}

fn corpusEntryMatches(found: Option<Toml>, want: Toml): bool {
  match (found) {
    None => { return false }
    Some(v) => { return corpusEqual(want, v) }
  }
}

fn corpusFindTomlEntry(entries: []TomlEntry, key: string): Option<Toml> {
  let i = 0
  while (i < len(entries)) {
    if (entries[i].key == key) {
      return Option<Toml>.Some(entries[i].value)
    }
    i = i + 1
  }
  return Option<Toml>.None
}

// --- running one half -----------------------------------------------------
//
// `present` is every fixture found on disk, INCLUDING excluded ones — the
// denominator toml-test's own numbers are read against. `passed`/`failed`
// only ever count a fixture `check` actually ran (an excluded fixture is
// neither): `present == passed + failed + excluded` always, asserted below
// rather than left implicit, so a future change to this file cannot make
// the printed line quietly stop meaning what it says.
class CorpusResult { present: int, passed: int, failed: int, excluded: int, failures: string }

enum CorpusOutcome {
  CorpusPassed,
  CorpusExcluded,
  CorpusFailed(string),
}

fn corpusCheckOne(path: string, check: (string) => Option<string>): CorpusOutcome {
  if (corpusIsExcluded(corpusRelPath(path))) {
    return CorpusOutcome.CorpusExcluded
  }
  let result = check(path)
  match (result) {
    None => { return CorpusOutcome.CorpusPassed }
    Some(reason) => { return CorpusOutcome.CorpusFailed(reason) }
  }
}

// None on success; the failing reason otherwise.
fn corpusValidCheck(path: string): Option<string> {
  let text = readFile(path) catch e {
    return Option<string>.Some("cannot read: ${e.message()}")
  }
  let parsed = tomlParse(text) catch e {
    return Option<string>.Some("parse failed: ${e.message()}")
  }
  let jsonText = readFile(corpusJsonSibling(path)) catch e {
    return Option<string>.Some("cannot read expected json: ${e.message()}")
  }
  let expectedJson = jsonParse(jsonText) catch e {
    return Option<string>.Some("expected json is invalid: ${e.message()}")
  }
  let expected = corpusJsonToToml(expectedJson) catch e {
    return Option<string>.Some("cannot decode expected json fixture: ${e.message()}")
  }
  if (!corpusEqual(parsed, expected)) {
    return Option<string>.Some("parsed value does not match the expected json")
  }
  return Option<string>.None
}

// A parse that FAILS is the pass here; a parse that succeeds on an invalid
// fixture is the failure — mirrors parse.test.bit's own `parseErrOffset`
// catch shape (a dummy `Toml` value in the catch block, since `tomlParse`
// returns `Toml!` and the catch arm must still type-check).
fn corpusInvalidCheck(path: string): Option<string> {
  let text = readFile(path) catch e {
    return Option<string>.Some("cannot read: ${e.message()}")
  }
  let rejected = false
  tomlParse(text) catch _ {
    rejected = true
    Toml.TomlBool(false)
  }
  if (!rejected) {
    return Option<string>.Some("accepted an invalid document")
  }
  return Option<string>.None
}

fn corpusRunValid(): CorpusResult {
  return corpusRunHalf("valid", corpusValidCheck)
}

fn corpusRunInvalid(): CorpusResult {
  return corpusRunHalf("invalid", corpusInvalidCheck)
}

fn corpusRunHalf(kind: string, check: (string) => Option<string>): CorpusResult {
  let dir = corpusDir(kind)
  let files = walk(dir) catch e {
    panic("toml corpus: cannot walk ${dir}: ${e.message()}")
  }
  let present = 0
  let passed = 0
  let failed = 0
  let excluded = 0
  let failures = newBuilder()
  let i = 0
  while (i < len(files)) {
    if (hasSuffix(files[i], ".toml")) {
      present = present + 1
      let outcome = corpusCheckOne(files[i], check)
      match (outcome) {
        CorpusPassed => { passed = passed + 1 }
        CorpusExcluded => { excluded = excluded + 1 }
        CorpusFailed(reason) => {
          failed = failed + 1
          failures = failures.write("  ${corpusRelPath(files[i])}: ${reason}\n")
        }
      }
    }
    i = i + 1
  }
  return CorpusResult{
    present: present,
    passed: passed,
    failed: failed,
    excluded: excluded,
    failures: failures.toString(),
  }
}

// --- the gate ---------------------------------------------------------

test "toml-test corpus (vendored, TOML 1.0.0, pinned SHA — see _tests_/corpus/toml-test/README.md)" {
  let validResult = corpusRunValid()
  let invalidResult = corpusRunInvalid()
  print("toml-test: valid ${validResult.passed}/${validResult.present} (${validResult.excluded} excluded), invalid ${invalidResult.passed}/${invalidResult.present} (${invalidResult.excluded} excluded)\n")
  assert(
    validResult.present > 0,
    "toml corpus: 0 valid fixtures found under ${corpusDir("valid")} — corpus not vendored or BIT_REPO wrong",
  )
  assert(
    invalidResult.present > 0,
    "toml corpus: 0 invalid fixtures found under ${corpusDir("invalid")} — corpus not vendored or BIT_REPO wrong",
  )
  // The denominator (`present`) and the three outcomes that add up to it
  // must never drift apart silently — asserted, not just true by
  // construction, so a future change to this file cannot make the printed
  // line quietly stop meaning what it says (the bug this test itself was
  // reopened over: excluded cases previously left both sides of the ratio).
  assert(
    validResult.passed + validResult.failed + validResult.excluded == validResult.present,
    "toml corpus: valid half's passed+failed+excluded does not equal present",
  )
  assert(
    invalidResult.passed + invalidResult.failed + invalidResult.excluded == invalidResult.present,
    "toml corpus: invalid half's passed+failed+excluded does not equal present",
  )
  assert(
    validResult.failed == 0,
    "toml corpus: ${validResult.failed} valid fixture(s) failed:\n${validResult.failures}",
  )
  assert(
    invalidResult.failed == 0,
    "toml corpus: ${invalidResult.failed} invalid fixture(s) were wrongly accepted:\n${invalidResult.failures}",
  )
}
