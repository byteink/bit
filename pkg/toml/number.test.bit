// pkg/toml/number.test.bit — #5482's acceptance: decimal/hex/octal/binary
// integers, underscore placement, leading-zero rejection, i64 overflow
// rejection, the three float forms, `1e2` decoding as a float, rejection of
// `1.`/`.5`, and all six inf/nan spellings.
//
// `tomlDecodeNumber`, `lex`, `TokenKind`, `Toml`, `tomlAsInt`, `tomlAsFloat`
// are all module-wide (this package's own files) — used here directly, not
// imported (pkg/toml/ is one flat module, pkg/README.md).
//
// Float assertions compare with a tolerance, not `==`: this file's decoder
// accumulates via Horner's method plus one `pow` call (number.bit's own
// header explains why), which is not guaranteed bit-identical to the
// correctly-rounded value a literal like `3.14` compiles to — TOML's Float
// grammar has no correctly-rounded requirement, only a grammar one.

import { abs } from "std/math"

fn approxEq(got: f64, want: f64): bool {
  return abs(got - want) < 1e-9
}

// Decodes `src` as a whole `Number` token, mirroring how the parser (a
// later ticket) will hand `tomlDecodeNumber` a real lexer span rather than a
// hand-counted one.
fn decodeNum(src: string): Toml! {
  let toks = lex(src)
  return tomlDecodeNumber(src, toks[0].start, toks[0].end)?
}

fn intOf(src: string): i64 {
  let v = decodeNum(src) catch e {
    panic("decode '${src}' failed: ${e.message()}")
  }
  return unwrap(tomlAsInt(v))
}

fn floatOf(src: string): f64 {
  let v = decodeNum(src) catch e {
    panic("decode '${src}' failed: ${e.message()}")
  }
  return unwrap(tomlAsFloat(v))
}

fn failsToDecode(src: string): bool {
  decodeNum(src) catch _ {
    return true
  }
  return false
}

test "decimal integers: zero, positive, signed, and underscore grouping" {
  assert(intOf("0") == 0, "0")
  assert(intOf("42") == 42, "42")
  assert(intOf("+99") == 99, "+99")
  assert(intOf("-17") == -17, "-17")
  assert(intOf("1_000") == 1000, "1_000")
  assert(intOf("5_349_221") == 5349221, "5_349_221")
}

test "decimal integers: leading, trailing, and doubled underscores reject" {
  assert(failsToDecode("_1"), "leading underscore must reject")
  assert(failsToDecode("1_"), "trailing underscore must reject")
  assert(failsToDecode("1__0"), "doubled underscore must reject")
}

test "decimal integers: a leading zero rejects, bare zero does not" {
  assert(failsToDecode("01"), "01 must reject")
  assert(failsToDecode("007"), "007 must reject")
  assert(intOf("0") == 0, "bare 0 must still decode")
}

test "decimal integers: i64 MIN/MAX are accepted, one past either overflows" {
  assert(intOf("9223372036854775807") == 9223372036854775807, "i64 MAX")
  assert(intOf("-9223372036854775808") == -9223372036854775808, "i64 MIN")
  assert(failsToDecode("9223372036854775808"), "one past i64 MAX must reject")
  assert(failsToDecode("-9223372036854775809"), "one past i64 MIN must reject")
}

test "hex, octal, and binary integers decode, with underscores" {
  assert(intOf("0xDEADBEEF") == 3735928559, "0xDEADBEEF")
  assert(intOf("0xdeadbeef") == 3735928559, "lowercase hex digits")
  assert(intOf("0xdead_beef") == 3735928559, "underscore in hex")
  assert(intOf("0o755") == 493, "0o755")
  assert(intOf("0o01234567") == 342391, "octal leading zero is allowed")
  assert(intOf("0b11010110") == 214, "0b11010110")
}

test "prefixed bases: no sign allowed, and a magnitude past i64 MAX overflows" {
  assert(failsToDecode("+0x1"), "a sign on 0x must reject")
  assert(failsToDecode("-0o1"), "a sign on 0o must reject")
  assert(failsToDecode("0xFFFFFFFFFFFFFFFF"), "a hex magnitude past i64 MAX must reject")
}

test "float: fraction, exponent, and both forms" {
  assert(approxEq(floatOf("3.14"), 3.14), "fraction")
  assert(approxEq(floatOf("1e10"), 1e10), "exponent")
  assert(approxEq(floatOf("1.5e2"), 150.0), "fraction and exponent")
  assert(approxEq(floatOf("-2.5"), -2.5), "negative fraction")
}

test "1e2 decodes as a TomlFloat, not a TomlInt" {
  let v = decodeNum("1e2") catch e {
    panic("decode failed: ${e.message()}")
  }
  assert(tomlIsFloat(v), "1e2 must be a float")
  assert(!tomlIsInt(v), "1e2 must not be an int")
  assert(approxEq(unwrap(tomlAsFloat(v)), 100.0), "1e2 == 100.0")
}

test "float: a trailing dot and a bare fraction both reject" {
  assert(failsToDecode("1."), "1. must reject")
  assert(failsToDecode(".5"), "bare .5 must reject")
}

test "float: underscores follow the same between-digits rule" {
  assert(approxEq(floatOf("9_224.445_991"), 9224.445991), "underscored fraction")
  assert(failsToDecode("1._5"), "underscore right after the dot must reject")
}

test "the six inf/nan spellings all decode, lowercase only" {
  assert(floatOf("inf") == 1.0 / 0.0, "inf")
  assert(floatOf("+inf") == 1.0 / 0.0, "+inf")
  assert(floatOf("-inf") == 0.0 - 1.0 / 0.0, "-inf")
  let n1 = floatOf("nan")
  assert(n1 != n1, "nan is NaN")
  let n2 = floatOf("+nan")
  assert(n2 != n2, "+nan is NaN")
  let n3 = floatOf("-nan")
  assert(n3 != n3, "-nan is NaN")
}

test "capitalised Inf/NaN spellings reject" {
  assert(failsToDecode("Inf"), "Inf must reject")
  assert(failsToDecode("NaN"), "NaN must reject")
  assert(failsToDecode("INF"), "INF must reject")
}

fn failureOffset(src: string): i64 {
  decodeNum(src) catch e {
    let (te, ok) = e.(TomlError)
    if (!ok) {
      panic("not a TomlError: ${e.message()}")
    }
    return te.offset
  }
  panic("decode of '${src}' unexpectedly succeeded")
}

test "an out-of-range decode names the offending byte offset" {
  assert(failureOffset("9223372036854775808") >= 0, "offset is set")
}
