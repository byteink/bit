// pkg/toml/datetime.test.bit — the four temporal `Toml` arms
// (./datetime.bit, #5483). Same module as ./datetime.bit and ./value.bit
// (pkg/README.md): `tomlDecodeDateTime` and `Toml`'s four temporal arms
// are reached here directly, no import.
//
// One test per row of the mapping table (TOML 1.0.0, "Offset Date-Time" /
// "Local Date-Time" / "Local Date" / "Local Time"), plus the `T`/`t`/space
// separator and lowercase `z` variants, fractional seconds (including
// truncation past nine digits, which TOML permits and std/time does not),
// a `-00:00` offset, rejection of an out-of-range month, day and hour, and
// that a reported error carries the caller's own byte offset.

// The decode of `s`, read as one whole span starting at byte 0, printed by
// matching on the arm it landed in — or the failure message prefixed
// `ERR:`. No canonical rendering below starts with `ERR:`, so a test
// expecting a failure cannot pass on a success (stdlib/time/
// ldmlparse.test.bit's own pattern).
fn tomlDtTest(s: string): string {
  let v = tomlDecodeDateTime(s, 0, len(s)) catch e {
    return "ERR:" + e.message()
  }
  match (v) {
    TomlOffsetDateTime(d) => { return "offset:" + d.toString() }
    TomlLocalDateTime(d) => { return "local-dt:" + d.toString() }
    TomlLocalDate(d) => { return "local-date:" + d.toString() }
    TomlLocalTime(d) => { return "local-time:" + d.toString() }
    _ => { return "ERR:unexpected arm" }
  }
}

// Whether `tomlDtTest`'s result names a failure.
fn tomlDtIsErr(s: string): bool {
  return len(s) >= 4 && s[0:4] == "ERR:"
}

// True when `tomlDecodeDateTime(s, 0, len(s))` fails.
fn tomlDtFails(s: string): bool {
  return tomlDtIsErr(tomlDtTest(s))
}

// The failure message from decoding `src[start:end]`, or `"ok"` on
// success — used only to inspect the byte offset a failure reports.
fn tomlDtMessageAt(src: string, start: int, end: int): string {
  tomlDecodeDateTime(src, start, end) catch e {
    return e.message()
  }
  return "ok"
}

test "Offset Date-Time: TomlOffsetDateTime over a DateTime" {
  assert(
    tomlDtTest("1979-05-27T07:32:00Z") == "offset:1979-05-27T07:32:00+00:00",
    "offset date-time did not round-trip",
  )
}

test "Local Date-Time: TomlLocalDateTime over a NaiveDateTime" {
  assert(
    tomlDtTest("1979-05-27T07:32:00") == "local-dt:1979-05-27T07:32:00",
    "local date-time did not round-trip",
  )
}

test "Local Date: TomlLocalDate over a Date" {
  assert(tomlDtTest("1979-05-27") == "local-date:1979-05-27", "local date did not round-trip")
}

test "Local Time: TomlLocalTime over a Time" {
  assert(tomlDtTest("07:32:00") == "local-time:07:32:00", "local time did not round-trip")
}

test "separator: T, t and a space all decode as the same local date-time" {
  let want = "local-dt:1979-05-27T07:32:00"
  assert(tomlDtTest("1979-05-27T07:32:00") == want, "T separator")
  assert(tomlDtTest("1979-05-27t07:32:00") == want, "lowercase t separator")
  assert(tomlDtTest("1979-05-27 07:32:00") == want, "space separator")
}

test "zone letter: lowercase z decodes as offset date-time, same as Z" {
  assert(
    tomlDtTest("1979-05-27t07:32:00z") == "offset:1979-05-27T07:32:00+00:00",
    "lowercase t/z did not decode as UTC offset date-time",
  )
}

test "fractional seconds: kept up to nine digits, truncated past nine" {
  assert(
    tomlDtTest("07:32:00.5") == "local-time:07:32:00.500000000",
    "1-digit fraction did not zero-pad to nanoseconds",
  )
  assert(
    tomlDtTest("1979-05-27T07:32:00.999999999Z") == "offset:1979-05-27T07:32:00.999999999+00:00",
    "9-digit fraction did not round-trip",
  )
  assert(
    tomlDtTest("07:32:00.1234567890123") == "local-time:07:32:00.123456789",
    "fraction past nine digits was not truncated, not rejected",
  )
}

test "-00:00 offset means the same zero offset as Z" {
  assert(
    tomlDtTest("1979-05-27T07:32:00-00:00") == "offset:1979-05-27T07:32:00+00:00",
    "-00:00 did not normalize to the same offset as Z",
  )
}

test "rejects an out-of-range month, day and hour rather than normalizing" {
  assert(tomlDtFails("2026-13-01"), "month 13 succeeded, want fail")
  assert(tomlDtFails("2026-01-32"), "day 32 succeeded, want fail")
  assert(tomlDtFails("2026-01-01T25:00:00"), "hour 25 succeeded, want fail")
}

test "errors carry the caller's absolute byte offset, not the isolated span's" {
  let src = "x = 2026-13-01"
  let msg = tomlDtMessageAt(src, 4, 14)
  assert(msg != "ok", "expected month 13 to fail")
  let n = len(msg)
  assert(
    n >= 10 && msg[n - 10:n] == " at byte 4",
    "error did not carry the caller's byte offset: " + msg,
  )
}
