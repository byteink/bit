// pkg/toml/parse.test.bit — #5484's acceptance: dotted keys, `[table]`,
// `[[array of tables]]`, inline tables and arrays (including a trailing
// comma) all parse; each rejection this ticket lists under "THE ERROR CASES
// ARE THE SPEC" fails with the failing construct's own byte offset; and a
// deeply nested input errors instead of crashing the process.
//
// `tomlParse`, `Toml`, `TomlEntry`, `TomlError`, and every `tomlIs*`/
// `tomlAs*` accessor are all module-wide (this package's own declarations,
// pkg/README.md) — used here directly, not imported. `newBuilder` is
// `strings.bit`'s own import (`std/strings`), reached the same way, used
// here to build the depth-cap test's source without the O(n^2) cost of
// repeated string concatenation.

fn parseOk(src: string): Toml {
  return tomlParse(src) catch e {
    panic("parse failed: ${e.message()}")
  }
}

// The offset `tomlParse(src)` fails with, asserting it fails at all and
// that the error is this package's own `TomlError` — never a bare `error`.
fn parseErrOffset(src: string): int {
  let failed = false
  let offset = -1
  tomlParse(src) catch e {
    failed = true
    let (te, ok) = e.(TomlError)
    assert(ok, "want a TomlError, got '${e.message()}'")
    offset = te.offset
    Toml.TomlBool(false)
  }
  assert(failed, "want a parse error for '${src}'")
  return offset
}

fn asTable(t: Toml): []TomlEntry {
  let ot = tomlAsTable(t)
  assert(isSome(ot), "expected a table")
  return unwrap(ot)
}

fn findKey(entries: []TomlEntry, key: string): Toml {
  let i = 0
  while (i < len(entries)) {
    if (entries[i].key == key) {
      return entries[i].value
    }
    i = i + 1
  }
  panic("key '${key}' not found")
}

// --- structural shapes ----------------------------------------------------

test "dotted keys: siblings extend the same implicit intermediate table" {
  let root = asTable(parseOk("physical.color = \"orange\"\nphysical.shape = \"round\"\n"))
  let physical = asTable(findKey(root, "physical"))
  assert(unwrap(tomlAsString(findKey(physical, "color"))) == "orange", "color")
  assert(unwrap(tomlAsString(findKey(physical, "shape"))) == "round", "shape")
}

test "[table] header opens a table subsequent key/value lines populate" {
  let root = asTable(parseOk("[server]\nhost = \"localhost\"\nport = 8080\n"))
  let server = asTable(findKey(root, "server"))
  assert(unwrap(tomlAsString(findKey(server, "host"))) == "localhost", "host")
  assert(unwrap(tomlAsInt(findKey(server, "port"))) == 8080, "port")
}

test "[[array of tables]] appends a new element each time the header repeats" {
  let root = asTable(parseOk("[[fruit]]\nname = \"apple\"\n[[fruit]]\nname = \"banana\"\n"))
  let arr = unwrap(tomlAsArray(findKey(root, "fruit")))
  assert(len(arr) == 2, "two elements, got ${len(arr)}")
  assert(unwrap(tomlAsString(findKey(asTable(arr[0]), "name"))) == "apple", "first")
  assert(unwrap(tomlAsString(findKey(asTable(arr[1]), "name"))) == "banana", "second")
}

test "a [[array of tables]] element is extended by a dotted sub-header" {
  let src = "[[fruit]]\nname = \"apple\"\n[fruit.physical]\ncolor = \"red\"\n"
  let root = asTable(parseOk(src))
  let arr = unwrap(tomlAsArray(findKey(root, "fruit")))
  let physical = asTable(findKey(asTable(arr[0]), "physical"))
  assert(unwrap(tomlAsString(findKey(physical, "color"))) == "red", "color")
}

test "an explicit [header] may claim a table an earlier dotted key created implicitly" {
  let src = "fruit.color = \"red\"\n\n[fruit.apple]\ntexture = \"smooth\"\n"
  let root = asTable(parseOk(src))
  let fruit = asTable(findKey(root, "fruit"))
  assert(unwrap(tomlAsString(findKey(fruit, "color"))) == "red", "color")
  let apple = asTable(findKey(fruit, "apple"))
  assert(unwrap(tomlAsString(findKey(apple, "texture"))) == "smooth", "texture")
}

test "inline table: { a = 1, b = 2 } parses as a table value" {
  let root = asTable(parseOk("point = { x = 1, y = 2 }\n"))
  let point = asTable(findKey(root, "point"))
  assert(unwrap(tomlAsInt(findKey(point, "x"))) == 1, "x")
  assert(unwrap(tomlAsInt(findKey(point, "y"))) == 2, "y")
}

test "inline table: dotted keys build an intermediate table before closing" {
  let root = asTable(parseOk("point = { coord.x = 1, coord.y = 2 }\n"))
  let point = asTable(findKey(root, "point"))
  let coord = asTable(findKey(point, "coord"))
  assert(unwrap(tomlAsInt(findKey(coord, "x"))) == 1, "x")
  assert(unwrap(tomlAsInt(findKey(coord, "y"))) == 2, "y")
}

test "a Number-lexed key with a single dot splits into two segments" {
  let root = asTable(parseOk("1.2 = \"x\"\n"))
  let one = asTable(findKey(root, "1"))
  assert(unwrap(tomlAsString(findKey(one, "2"))) == "x", "table 1's key 2")
}

test "array: trailing comma, embedded newlines/comments, and mixed element types" {
  let src = "mixed = [\n  1, # a comment\n  \"two\",\n  true,\n]\n"
  let root = asTable(parseOk(src))
  let arr = unwrap(tomlAsArray(findKey(root, "mixed")))
  assert(len(arr) == 3, "three elements, got ${len(arr)}")
  assert(unwrap(tomlAsInt(arr[0])) == 1, "first")
  assert(unwrap(tomlAsString(arr[1])) == "two", "second")
  assert(unwrap(tomlAsBool(arr[2])) == true, "third")
}

test "a nested array of inline tables parses without recursion limits" {
  let root = asTable(parseOk("points = [{ x = 1 }, { x = 2 }]\n"))
  let arr = unwrap(tomlAsArray(findKey(root, "points")))
  assert(len(arr) == 2, "two elements")
  assert(unwrap(tomlAsInt(findKey(asTable(arr[0]), "x"))) == 1, "first x")
  assert(unwrap(tomlAsInt(findKey(asTable(arr[1]), "x"))) == 2, "second x")
}

test "an empty document parses to an empty root table" {
  let root = asTable(parseOk(""))
  assert(len(root) == 0, "no entries")
}

// --- THE ERROR CASES ARE THE SPEC -----------------------------------------

test "rejects a duplicate key" {
  let src = "a = 1\na = 2\n"
  assert(parseErrOffset(src) == 6, "offset should be the second key's 'a'")
}

test "rejects [a] after [a] (duplicate table header)" {
  let src = "[a]\n[a]\n"
  assert(parseErrOffset(src) == 5, "offset should be the second header's key")
}

test "rejects a [table] header colliding with a key already defined as a value" {
  let src = "a = 1\n[a]\n"
  assert(parseErrOffset(src) == 7, "offset should be the header's key")
}

test "rejects a [table] header extending a table already defined by [[array of tables]]" {
  let src = "[[a]]\n[a]\n"
  assert(parseErrOffset(src) == 7, "offset should be the header's key")
}

test "rejects extending a closed inline table" {
  let src = "a = { b = 1 }\n[a.c]\n"
  assert(parseErrOffset(src) == 15, "offset should be the header's first segment")
}

test "rejects a closed inline table reopened by a later dotted key" {
  let src = "a = { b = 1 }\na.c = 2\n"
  assert(parseErrOffset(src) == 14, "offset should be the second line's 'a'")
}

test "rejects a closed inline table built via a dotted key, reopened by a header" {
  let src = "point = { coord.x = 1 }\n[point.coord]\n"
  assert(parseErrOffset(src) == 25, "offset should be the header's 'point'")
}

test "rejects a duplicate key created via a dotted path inside an inline table" {
  let src = "point = { coord.x = 1, coord.x = 2 }\n"
  assert(parseErrOffset(src) == 29, "offset should be the second 'x'")
}

test "rejects a key/value line that does not end in a newline or EOF" {
  let src = "a = 1 b = 2\n"
  assert(parseErrOffset(src) == 6, "offset should be the stray token after the value")
}

test "rejects a dotted key that redefines an intermediate as a non-table" {
  let src = "a = 1\na.b = 2\n"
  assert(parseErrOffset(src) == 6, "offset should be the intermediate segment")
}

// --- depth cap -------------------------------------------------------------

test "a deeply nested input (10000 open brackets) errors instead of crashing" {
  let b = newBuilder()
  let i = 0
  while (i < 10000) {
    b = b.writeByte('[')
    i = i + 1
  }
  let src = b.toString()
  let failed = false
  tomlParse(src) catch _ {
    failed = true
    Toml.TomlBool(false)
  }
  assert(failed, "want a parse error, not a crash")
}
