// pkg/toml/strings.test.bit — #5481's acceptance: all four TOML string
// forms decode correctly, including the newline-after-opener rule, the
// line-ending-backslash rule, and up to two unescaped quotes before a
// multi-line closer; and decoding rejects an unknown escape, a lone
// surrogate, a scalar past U+10FFFF, and a raw control character.
//
// `tomlDecodeString`, `TomlError`, `TokenKind`, `lex` are all module-wide
// (strings.bit / lex.bit's own declarations) — used here directly, not
// imported (pkg/toml/ is one flat module, pkg/README.md).

// --- basic strings ("...") -------------------------------------------------

test "BasicString: no escapes returns the body verbatim, no builder needed" {
  let src = "\"hello world\""
  let toks = lex(src)
  let s = tomlDecodeString(src, toks[0].kind, toks[0].start, toks[0].end) catch e {
    panic("decode failed: ${e.message()}")
  }
  assert(s == "hello world", "got '${s}'")
}

test "BasicString: \\b \\t \\n \\f \\r \\\" \\\\ each decode to their control byte" {
  let src = "\"\\b\\t\\n\\f\\r\\\"\\\\\""
  let toks = lex(src)
  let s = tomlDecodeString(src, toks[0].kind, toks[0].start, toks[0].end) catch e {
    panic("decode failed: ${e.message()}")
  }
  assert(len(s) == 7, "seven decoded bytes, got ${len(s)}")
  assert(s[0] == '\x08', "\\b")
  assert(s[1] == '\t', "\\t")
  assert(s[2] == '\n', "\\n")
  assert(s[3] == '\x0C', "\\f")
  assert(s[4] == '\r', "\\r")
  assert(s[5] == '"', "\\\"")
  assert(s[6] == '\\', "\\\\")
}

test "BasicString: \\u0041 decodes to a single-byte scalar" {
  let src = "\"\\u0041\""
  let toks = lex(src)
  let s = tomlDecodeString(src, toks[0].kind, toks[0].start, toks[0].end) catch e {
    panic("decode failed: ${e.message()}")
  }
  assert(s == "A", "got '${s}'")
}

test "BasicString: \\U0001F600 decodes to its 4-byte UTF-8 encoding" {
  let src = "\"\\U0001F600\""
  let toks = lex(src)
  let s = tomlDecodeString(src, toks[0].kind, toks[0].start, toks[0].end) catch e {
    panic("decode failed: ${e.message()}")
  }
  assert(len(s) == 4, "four UTF-8 bytes, got ${len(s)}")
  assert(
    s[0] == '\xF0' && s[1] == '\x9F' && s[2] == '\x98' && s[3] == '\x80',
    "wrong bytes for U+1F600",
  )
}

test "BasicString: an unknown escape is rejected, naming the backslash's offset" {
  let src = "\"\\q\""
  let failed = false
  let s = tomlDecodeString(src, TokenKind.BasicString, 0, len(src)) catch e {
    failed = true
    let (te, ok) = e.(TomlError)
    assert(ok, "want a TomlError, got '${e.message()}'")
    assert(te.offset == 1, "offset should be the backslash, got ${te.offset}")
    ""
  }
  assert(failed, "want rejection, got '${s}'")
}

test "BasicString: a lone surrogate \\uD800 is rejected, never replaced" {
  let src = "\"\\uD800\""
  let failed = false
  tomlDecodeString(src, TokenKind.BasicString, 0, len(src)) catch e {
    failed = true
    let (te, ok) = e.(TomlError)
    assert(ok, "want a TomlError, got '${e.message()}'")
    assert(te.offset == 1, "offset should be the backslash, got ${te.offset}")
    ""
  }
  assert(failed, "want rejection")
}

test "BasicString: a scalar above U+10FFFF is rejected, never replaced" {
  let src = "\"\\U00110000\""
  let failed = false
  tomlDecodeString(src, TokenKind.BasicString, 0, len(src)) catch e {
    failed = true
    let (te, ok) = e.(TomlError)
    assert(ok, "want a TomlError, got '${e.message()}'")
    assert(te.offset == 1, "offset should be the backslash, got ${te.offset}")
    ""
  }
  assert(failed, "want rejection")
}

test "BasicString: a raw control character other than tab is rejected" {
  let src = "\"a\x01b\""
  let failed = false
  tomlDecodeString(src, TokenKind.BasicString, 0, len(src)) catch e {
    failed = true
    let (te, ok) = e.(TomlError)
    assert(ok, "want a TomlError, got '${e.message()}'")
    assert(te.offset == 2, "offset should be the control byte, got ${te.offset}")
    ""
  }
  assert(failed, "want rejection")
}

// --- literal strings ('...') ------------------------------------------------

test "LiteralString: a backslash is ordinary content, never an escape" {
  let src = "'a\\nb'"
  let toks = lex(src)
  let s = tomlDecodeString(src, toks[0].kind, toks[0].start, toks[0].end) catch e {
    panic("decode failed: ${e.message()}")
  }
  assert(s == "a\\nb", "backslash and n survive literally, got '${s}'")
}

// --- multi-line basic strings ("""...""") -----------------------------------

test "MlBasicString: a newline immediately after the opener is removed" {
  let src = "\"\"\"\nhi\"\"\""
  let toks = lex(src)
  let s = tomlDecodeString(src, toks[0].kind, toks[0].start, toks[0].end) catch e {
    panic("decode failed: ${e.message()}")
  }
  assert(s == "hi", "leading newline stripped, got '${s}'")
}

test "MlBasicString: a line-ending backslash trims the newline and the next line's leading whitespace" {
  let src = "\"\"\"a\\\n   b\"\"\""
  let toks = lex(src)
  let s = tomlDecodeString(src, toks[0].kind, toks[0].start, toks[0].end) catch e {
    panic("decode failed: ${e.message()}")
  }
  assert(s == "ab", "the backslash, newline and leading spaces are all trimmed, got '${s}'")
}

test "MlBasicString: up to two unescaped quotes may appear before the real closing delimiter" {
  let src = "\"\"\"a\"\"b\"\"\""
  let toks = lex(src)
  assert(toks[0].kind == TokenKind.MlBasicString, "want MlBasicString")
  let s = tomlDecodeString(src, toks[0].kind, toks[0].start, toks[0].end) catch e {
    panic("decode failed: ${e.message()}")
  }
  assert(s == "a\"\"b", "embedded quotes survive unescaped, got '${s}'")
}

// --- multi-line literal strings ('''...''') ---------------------------------

test "MlLiteralString: the opener's newline is removed, no escapes are decoded" {
  let src = "'''\nraw\\nvalue'''"
  let toks = lex(src)
  let s = tomlDecodeString(src, toks[0].kind, toks[0].start, toks[0].end) catch e {
    panic("decode failed: ${e.message()}")
  }
  assert(s == "raw\\nvalue", "leading newline stripped, backslash literal, got '${s}'")
}
