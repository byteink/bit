// pkg/toml/value.test.bit — #5479's acceptance: every `tomlIs*`/`tomlAs*`
// pair agrees with the arm it was built from and disagrees with the other
// nine, and a TomlTable's entries come back in source order.
//
// `DateTime`, `NaiveDateTime`, `Date` and `Time` are already bound
// module-wide (value.bit's own import) — reused here, not re-imported
// (E0042). `date`, `time` and `utc` are new to the module and are here to
// build the four temporal test fixtures.

import { date, time, utc } from "std/time"

fn offsetDateTime(): DateTime {
  let d = date(2026, 9, 17) catch e {
    panic("date failed: ${e.message()}")
  }
  return d.atStartOfDay(utc())
}

fn localDateTime(): NaiveDateTime {
  let d = date(2026, 9, 17) catch e {
    panic("date failed: ${e.message()}")
  }
  return d.atTime(9, 30, 0) catch e {
    panic("atTime failed: ${e.message()}")
  }
}

fn localDate(): Date {
  return date(2026, 9, 17) catch e {
    panic("date failed: ${e.message()}")
  }
}

fn localTime(): Time {
  return time(9, 30, 0) catch e {
    panic("time failed: ${e.message()}")
  }
}

test "TomlString: tomlIsString true, every other tomlIs false, tomlAsString round-trips" {
  let t = Toml.TomlString("hello")
  assert(tomlIsString(t), "tomlIsString must be true")
  assert(!tomlIsInt(t) && !tomlIsFloat(t) && !tomlIsBool(t), "must not be int/float/bool")
  assert(!tomlIsOffsetDateTime(t) && !tomlIsLocalDateTime(t), "must not be a date-time")
  assert(!tomlIsLocalDate(t) && !tomlIsLocalTime(t), "must not be a date or time")
  assert(!tomlIsArray(t) && !tomlIsTable(t), "must not be array/table")
  let s = tomlAsString(t)
  assert(isSome(s), "tomlAsString must be Some")
  assert(unwrap(s) == "hello", "round-trips the payload")
  assert(!isSome(tomlAsInt(t)), "tomlAsInt must be None")
}

test "TomlInt: tomlIsInt true, tomlAsInt round-trips" {
  let t = Toml.TomlInt(42)
  assert(tomlIsInt(t), "tomlIsInt must be true")
  assert(!tomlIsString(t) && !tomlIsFloat(t) && !tomlIsBool(t), "must not be string/float/bool")
  let i = tomlAsInt(t)
  assert(isSome(i), "tomlAsInt must be Some")
  assert(unwrap(i) == 42, "round-trips the payload")
  assert(!isSome(tomlAsFloat(t)), "tomlAsFloat must be None")
}

test "TomlFloat: tomlIsFloat true, tomlAsFloat round-trips" {
  let t = Toml.TomlFloat(3.5)
  assert(tomlIsFloat(t), "tomlIsFloat must be true")
  assert(!tomlIsInt(t) && !tomlIsBool(t), "must not be int/bool")
  let f = tomlAsFloat(t)
  assert(isSome(f), "tomlAsFloat must be Some")
  assert(unwrap(f) == 3.5, "round-trips the payload")
  assert(!isSome(tomlAsBool(t)), "tomlAsBool must be None")
}

test "TomlBool: tomlIsBool true, tomlAsBool round-trips" {
  let t = Toml.TomlBool(true)
  assert(tomlIsBool(t), "tomlIsBool must be true")
  assert(!tomlIsInt(t) && !tomlIsFloat(t), "must not be int/float")
  let b = tomlAsBool(t)
  assert(isSome(b), "tomlAsBool must be Some")
  assert(unwrap(b) == true, "round-trips the payload")
  assert(!isSome(tomlAsString(t)), "tomlAsString must be None")
}

test "TomlOffsetDateTime: tomlIsOffsetDateTime true, tomlAsOffsetDateTime round-trips" {
  let dt = offsetDateTime()
  let t = Toml.TomlOffsetDateTime(dt)
  assert(tomlIsOffsetDateTime(t), "tomlIsOffsetDateTime must be true")
  assert(
    !tomlIsLocalDateTime(t) && !tomlIsLocalDate(t) && !tomlIsLocalTime(t),
    "must not be a local date/time/date-time",
  )
  let got = tomlAsOffsetDateTime(t)
  assert(isSome(got), "tomlAsOffsetDateTime must be Some")
  assert(
    unwrap(got).year() == 2026 && unwrap(got).month() == 9 && unwrap(got).day() == 17,
    "round-trips the payload",
  )
  assert(!isSome(tomlAsLocalDateTime(t)), "tomlAsLocalDateTime must be None")
}

test "TomlLocalDateTime: tomlIsLocalDateTime true, tomlAsLocalDateTime round-trips" {
  let ndt = localDateTime()
  let t = Toml.TomlLocalDateTime(ndt)
  assert(tomlIsLocalDateTime(t), "tomlIsLocalDateTime must be true")
  assert(
    !tomlIsOffsetDateTime(t) && !tomlIsLocalDate(t) && !tomlIsLocalTime(t),
    "must not be an offset date-time, local date or local time",
  )
  let got = tomlAsLocalDateTime(t)
  assert(isSome(got), "tomlAsLocalDateTime must be Some")
  assert(unwrap(got).hour() == 9 && unwrap(got).minute() == 30, "round-trips the payload")
  assert(!isSome(tomlAsLocalDate(t)), "tomlAsLocalDate must be None")
}

test "TomlLocalDate: tomlIsLocalDate true, tomlAsLocalDate round-trips" {
  let d = localDate()
  let t = Toml.TomlLocalDate(d)
  assert(tomlIsLocalDate(t), "tomlIsLocalDate must be true")
  assert(
    !tomlIsOffsetDateTime(t) && !tomlIsLocalDateTime(t) && !tomlIsLocalTime(t),
    "must not be a date-time or local time",
  )
  let got = tomlAsLocalDate(t)
  assert(isSome(got), "tomlAsLocalDate must be Some")
  assert(unwrap(got).year() == 2026 && unwrap(got).day() == 17, "round-trips the payload")
  assert(!isSome(tomlAsLocalTime(t)), "tomlAsLocalTime must be None")
}

test "TomlLocalTime: tomlIsLocalTime true, tomlAsLocalTime round-trips" {
  let tm = localTime()
  let t = Toml.TomlLocalTime(tm)
  assert(tomlIsLocalTime(t), "tomlIsLocalTime must be true")
  assert(
    !tomlIsOffsetDateTime(t) && !tomlIsLocalDateTime(t) && !tomlIsLocalDate(t),
    "must not be a date-time or local date",
  )
  let got = tomlAsLocalTime(t)
  assert(isSome(got), "tomlAsLocalTime must be Some")
  assert(unwrap(got).hour() == 9 && unwrap(got).minute() == 30, "round-trips the payload")
  assert(!isSome(tomlAsArray(t)), "tomlAsArray must be None")
}

test "TomlArray: tomlIsArray true, tomlAsArray round-trips" {
  let t = Toml.TomlArray([Toml.TomlInt(1), Toml.TomlInt(2)])
  assert(tomlIsArray(t), "tomlIsArray must be true")
  assert(!tomlIsTable(t), "must not be a table")
  let a = tomlAsArray(t)
  assert(isSome(a), "tomlAsArray must be Some")
  assert(len(unwrap(a)) == 2, "round-trips the payload length")
  assert(!isSome(tomlAsTable(t)), "tomlAsTable must be None")
}

test "TomlTable: tomlIsTable true, tomlAsTable preserves source order" {
  let entries = [
    TomlEntry{ key: "b", value: Toml.TomlInt(2) },
    TomlEntry{ key: "a", value: Toml.TomlInt(1) },
  ]
  let t = Toml.TomlTable(entries)
  assert(tomlIsTable(t), "tomlIsTable must be true")
  assert(!tomlIsArray(t), "must not be an array")
  let got = tomlAsTable(t)
  assert(isSome(got), "tomlAsTable must be Some")
  let out = unwrap(got)
  assert(len(out) == 2, "keeps both entries, including the duplicate-friendly shape")
  assert(out[0].key == "b" && out[1].key == "a", "keeps source order, not sorted")
  assert(!isSome(tomlAsString(t)), "tomlAsString must be None")
}
