// pkg/toml/encode.test.bit — #5485's acceptance: `tomlParse(tomlEncode(v))`
// equals `v` for a fixture spanning all four date-time forms, nested
// tables, an array of tables and keys needing quoting; a float whose
// shortest representation needs full precision to round-trip; the
// scalar-keys-before-sub-tables table layout rule; and that an unencodable
// root is rejected rather than silently emitting invalid TOML.
//
// Same module as encode.bit, value.bit, parse.bit and datetime.bit
// (pkg/README.md): `Toml`, `TomlEntry`, `tomlEncode`, `tomlDecodeDateTime`
// and parse.test.bit's own `parseOk`/`asTable`/`findKey` are all reached
// directly here, no import, no redeclaration.
//
// STRUCTURAL EQUALITY, NOT TEXT COMPARISON (this ticket's own instruction:
// asserting on generated text tests the formatter's whitespace choices, not
// correctness). `value.bit` has no `Toml` equality helper and this file
// does not add one there — a sibling ticket may be editing that file
// concurrently — so `tomlEqual` is hand-rolled here instead, the same call
// #5495 made for `yamlEqual` in pkg/yaml/flow.bit. Split into one function
// per value shape (`tomlEqualTemporal` pulled out of `tomlEqual` itself) to
// stay under E0204's complexity ceiling the same way encode.bit's own
// `encodeScalar`/`encodeTemporal` split does: `Toml` has ten arms, and a
// single `if`-chain over all of them would score complexity 11.
//
// ORDER-SENSITIVE ON PURPOSE. `tomlEqualTable` compares `[]TomlEntry`
// positionally, which is the strongest check available and is intentional:
// every fixture below keeps each table's own scalar entries before its
// sub-table entries (encode.bit's own header explains why an interleaved
// table cannot round-trip position-for-position — that is a property of
// TOML's text grammar, not a gap in `tomlEqual`).
//
// `unwrap` is std/core's own prelude export (spec/SPEC.md §17.5, no import
// needed, same as parse.test.bit's own `asTable`/`findKey` already rely
// on). Each arm below is its own function, not a `&&` chained onto an
// `if` in one shared dispatcher: cyclomatic complexity counts a match
// arm/`if`/`&&` alike (spec/LINT.md), and `Toml`'s ten arms folded into
// one function the way a first draft of this file did scored complexity
// 13 against E0204's ceiling of 10.

fn tomlEqual(a: Toml, b: Toml): bool {
  if (tomlIsString(a)) {
    return tomlEqualString(a, b)
  }
  if (tomlIsInt(a)) {
    return tomlEqualInt(a, b)
  }
  if (tomlIsFloat(a)) {
    return tomlEqualFloatArm(a, b)
  }
  if (tomlIsBool(a)) {
    return tomlEqualBool(a, b)
  }
  if (tomlIsArray(a)) {
    return tomlEqualArrayArm(a, b)
  }
  if (tomlIsTable(a)) {
    return tomlEqualTableArm(a, b)
  }
  return tomlEqualTemporal(a, b)
}

fn tomlEqualString(a: Toml, b: Toml): bool {
  if (!tomlIsString(b)) {
    return false
  }
  return unwrap(tomlAsString(a)) == unwrap(tomlAsString(b))
}

fn tomlEqualInt(a: Toml, b: Toml): bool {
  if (!tomlIsInt(b)) {
    return false
  }
  return unwrap(tomlAsInt(a)) == unwrap(tomlAsInt(b))
}

fn tomlEqualFloatArm(a: Toml, b: Toml): bool {
  if (!tomlIsFloat(b)) {
    return false
  }
  return tomlEqualFloat(unwrap(tomlAsFloat(a)), unwrap(tomlAsFloat(b)))
}

fn tomlEqualBool(a: Toml, b: Toml): bool {
  if (!tomlIsBool(b)) {
    return false
  }
  return unwrap(tomlAsBool(a)) == unwrap(tomlAsBool(b))
}

fn tomlEqualArrayArm(a: Toml, b: Toml): bool {
  if (!tomlIsArray(b)) {
    return false
  }
  return tomlEqualArray(unwrap(tomlAsArray(a)), unwrap(tomlAsArray(b)))
}

fn tomlEqualTableArm(a: Toml, b: Toml): bool {
  if (!tomlIsTable(b)) {
    return false
  }
  return tomlEqualTable(unwrap(tomlAsTable(a)), unwrap(tomlAsTable(b)))
}

// The four date-time arms, compared with each type's own `isSame`
// (std/time, ./compare.bit) rather than a hand-rolled field comparison.
fn tomlEqualTemporal(a: Toml, b: Toml): bool {
  if (tomlIsOffsetDateTime(a)) {
    return tomlEqualOffsetDateTime(a, b)
  }
  if (tomlIsLocalDateTime(a)) {
    return tomlEqualLocalDateTime(a, b)
  }
  if (tomlIsLocalDate(a)) {
    return tomlEqualLocalDate(a, b)
  }
  if (tomlIsLocalTime(a)) {
    return tomlEqualLocalTime(a, b)
  }
  return false
}

fn tomlEqualOffsetDateTime(a: Toml, b: Toml): bool {
  if (!tomlIsOffsetDateTime(b)) {
    return false
  }
  return unwrap(tomlAsOffsetDateTime(a)).isSame(unwrap(tomlAsOffsetDateTime(b)))
}

fn tomlEqualLocalDateTime(a: Toml, b: Toml): bool {
  if (!tomlIsLocalDateTime(b)) {
    return false
  }
  return unwrap(tomlAsLocalDateTime(a)).isSame(unwrap(tomlAsLocalDateTime(b)))
}

fn tomlEqualLocalDate(a: Toml, b: Toml): bool {
  if (!tomlIsLocalDate(b)) {
    return false
  }
  return unwrap(tomlAsLocalDate(a)).isSame(unwrap(tomlAsLocalDate(b)))
}

fn tomlEqualLocalTime(a: Toml, b: Toml): bool {
  if (!tomlIsLocalTime(b)) {
    return false
  }
  return unwrap(tomlAsLocalTime(a)).isSame(unwrap(tomlAsLocalTime(b)))
}

// `x == y`, with both-NaN also counted equal — NaN's own IEEE-754 `!=
// itself` would otherwise make a NaN fixture unable to ever compare equal
// to its own round-trip.
fn tomlEqualFloat(x: f64, y: f64): bool {
  if (x == y) {
    return true
  }
  return x != x && y != y
}

fn tomlEqualArray(x: []Toml, y: []Toml): bool {
  if (len(x) != len(y)) {
    return false
  }
  let i = 0
  while (i < len(x)) {
    if (!tomlEqual(x[i], y[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

fn tomlEqualTable(x: []TomlEntry, y: []TomlEntry): bool {
  if (len(x) != len(y)) {
    return false
  }
  let i = 0
  while (i < len(x)) {
    if (x[i].key != y[i].key || !tomlEqual(x[i].value, y[i].value)) {
      return false
    }
    i = i + 1
  }
  return true
}

// `tomlEncode(v)`, panicking with the failure message on an encode error —
// every fixture below is expected to encode successfully.
fn encodeOk(v: Toml): string {
  return tomlEncode(v) catch e {
    panic("encode failed: ${e.message()}")
  }
}

// `tomlParse(tomlEncode(v))`, panicking (with the generated text) on either
// a failed encode or a failed re-parse.
fn roundTrip(v: Toml): Toml {
  let text = encodeOk(v)
  return tomlParse(text) catch e {
    panic("re-parse failed: ${e.message()}\n--- generated text ---\n${text}")
  }
}

fn dt(s: string): Toml {
  return tomlDecodeDateTime(s, 0, len(s)) catch e {
    panic("fixture date-time '${s}' failed to decode: ${e.message()}")
  }
}

// --- the combined fixture (acceptance line 1) -------------------------

// One root table exercising all four date-time forms, nested tables (a
// plain sub-table and an empty one), an array of tables (with one element
// itself holding a nested sub-table), keys needing quoting (a space, a
// dot), a string needing escapes, a multi-line string's decoded content,
// an empty array, and a float whose shortest text is not short at all.
fn bigFixture(): Toml {
  let server = Toml.TomlTable(
    [
      TomlEntry{ key: "host", value: Toml.TomlString("localhost") },
      TomlEntry{ key: "empty", value: Toml.TomlTable([]) },
    ],
  )
  let appleTable = Toml.TomlTable(
    [
      TomlEntry{ key: "name", value: Toml.TomlString("apple") },
      TomlEntry{
        key: "physical",
        value: Toml.TomlTable([TomlEntry{ key: "color", value: Toml.TomlString("red") }]),
      },
    ],
  )
  let bananaTable = Toml.TomlTable([TomlEntry{ key: "name", value: Toml.TomlString("banana") }])
  let fruit = Toml.TomlArray([appleTable, bananaTable])
  return Toml.TomlTable(
    [
      TomlEntry{ key: "title", value: Toml.TomlString("say \"hi\"\\bye") },
      TomlEntry{ key: "offset_dt", value: dt("1979-05-27T07:32:00-07:00") },
      TomlEntry{ key: "local_dt", value: dt("1979-05-27T07:32:00") },
      TomlEntry{ key: "local_date", value: dt("1979-05-27") },
      TomlEntry{ key: "local_time", value: dt("07:32:00") },
      TomlEntry{ key: "pi", value: Toml.TomlFloat(0.1 + 0.2) },
      TomlEntry{ key: "empty_arr", value: Toml.TomlArray([]) },
      TomlEntry{ key: "multiline", value: Toml.TomlString("line one\nline two\n") },
      TomlEntry{ key: "has space", value: Toml.TomlInt(1) },
      TomlEntry{ key: "a.b", value: Toml.TomlInt(2) },
      TomlEntry{ key: "server", value: server },
      TomlEntry{ key: "fruit", value: fruit },
    ],
  )
}

test "round-trips a fixture covering all four date-time forms, nested tables, an array of tables and quoted keys" {
  let v = bigFixture()
  let out = roundTrip(v)
  assert(tomlEqual(v, out), "round-trip mismatch:\n${encodeOk(v)}")
}

// --- float precision (acceptance line 2) --------------------------------

test "a float whose shortest representation needs full precision round-trips exactly" {
  // 0.1 and 0.2 each lack an exact f64 representation, so their sum is
  // 0.30000000000000004 — 17 significant digits, not the "0.3" a low-
  // precision formatter would silently produce. Wrapped in a table: the
  // root itself must be a table (this file's other test covers that rule).
  let f = 0.1 + 0.2
  let v = Toml.TomlTable([TomlEntry{ key: "f", value: Toml.TomlFloat(f) }])
  let out = asTable(roundTrip(v))
  let got = unwrap(tomlAsFloat(findKey(out, "f")))
  assert(got == f, "want ${f}, got ${got}")
}

// --- table layout (acceptance line 3) -----------------------------------

test "a table's scalar keys are emitted before its sub-tables, and stay on the parent" {
  // `[]TomlEntry` order deliberately interleaves a sub-table BETWEEN two
  // scalars — the shape encode.bit's own header names as the real bug this
  // rule guards against: naively re-emitting entries in this order would
  // write `b`'s value after the `[sub]` header, moving it into `sub`.
  let src = Toml.TomlTable(
    [
      TomlEntry{ key: "a", value: Toml.TomlInt(1) },
      TomlEntry{
        key: "sub",
        value: Toml.TomlTable([TomlEntry{ key: "x", value: Toml.TomlInt(9) }]),
      },
      TomlEntry{ key: "b", value: Toml.TomlInt(2) },
    ],
  )
  let text = encodeOk(src)
  let root = asTable(parseOk(text))
  assert(unwrap(tomlAsInt(findKey(root, "a"))) == 1, "a stayed on the parent:\n${text}")
  assert(
    unwrap(tomlAsInt(findKey(root, "b"))) == 2,
    "b stayed on the parent, not under [sub]:\n${text}",
  )
  let sub = asTable(findKey(root, "sub"))
  assert(unwrap(tomlAsInt(findKey(sub, "x"))) == 9, "sub kept its own key:\n${text}")
}

// --- root must be a table -------------------------------------------------

test "rejects a non-table root rather than emitting an unparseable document" {
  let failed = false
  tomlEncode(Toml.TomlString("bare")) catch _ {
    failed = true
    ""
  }
  assert(failed, "want tomlEncode to fail on a non-table root")
}
