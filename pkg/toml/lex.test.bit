// pkg/toml/lex.test.bit — #5480's acceptance: every `TokenKind` is exercised
// at least once, a maliciously deep `[`/`{` nesting reports `Invalid`
// instead of crashing, and `lexNext` (the streaming entry point) agrees
// token-for-token with `lex` (the `[]Token` entry point) over one source
// carrying every kind — proving the two share one grammar rather than two
// forked scanners.
//
// `TokenKind`, `Token`, `lex`, and the unexported `Lexer`/`newLexer`/
// `lexNext` are all module-wide (lex.bit's own declarations) — used here
// directly, not imported (pkg/toml/ is one flat module, pkg/README.md).

test "BareKey: an unquoted key scans as one span over the whole word" {
  let toks = lex("hello_world-1")
  assert(toks[0].kind == TokenKind.BareKey, "want BareKey")
  assert(toks[0].start == 0 && toks[0].end == 13, "spans the whole word")
  assert(toks[1].kind == TokenKind.Eof, "terminates at Eof")
}

test "BasicString: an escaped quote does not end the string early" {
  let src = "\"a\\\"b\""
  let toks = lex(src)
  assert(toks[0].kind == TokenKind.BasicString, "want BasicString")
  assert(toks[0].start == 0 && toks[0].end == len(src), "spans quotes and escape raw")
  assert(toks[1].kind == TokenKind.Eof, "terminates at Eof")
}

test "LiteralString: a backslash is ordinary content, not an escape" {
  let src = "'a\\nb'"
  let toks = lex(src)
  assert(toks[0].kind == TokenKind.LiteralString, "want LiteralString")
  assert(toks[0].start == 0 && toks[0].end == len(src), "spans the whole literal")
}

test "MlBasicString: a triple-quoted string spans an embedded newline" {
  let src = "\"\"\"\nhi\"\"\""
  let toks = lex(src)
  assert(toks[0].kind == TokenKind.MlBasicString, "want MlBasicString")
  assert(toks[0].start == 0 && toks[0].end == len(src), "spans opener through closer")
  assert(toks[1].kind == TokenKind.Eof, "no separate Newline inside the string")
}

test "MlLiteralString: a triple-quoted literal string spans an embedded newline" {
  let src = "'''\nhi'''"
  let toks = lex(src)
  assert(toks[0].kind == TokenKind.MlLiteralString, "want MlLiteralString")
  assert(toks[0].start == 0 && toks[0].end == len(src), "spans opener through closer")
}

test "Number: int, negative, float, hex, and the inf/nan words all scan as Number" {
  assert(lex("42")[0].kind == TokenKind.Number, "plain int")
  assert(lex("-17")[0].kind == TokenKind.Number, "signed int")
  assert(lex("3.14")[0].kind == TokenKind.Number, "float")
  assert(lex("0x1A")[0].kind == TokenKind.Number, "hex")
  assert(lex("inf")[0].kind == TokenKind.Number, "unquoted inf")
  assert(lex("nan")[0].kind == TokenKind.Number, "unquoted nan")
}

test "Bool: true and false scan as Bool" {
  assert(lex("true")[0].kind == TokenKind.Bool, "true")
  assert(lex("false")[0].kind == TokenKind.Bool, "false")
}

test "DateTime: an offset date-time, a local date, and a local time each scan as one span" {
  let odt = "1979-05-27T07:32:00Z"
  let toksOdt = lex(odt)
  assert(toksOdt[0].kind == TokenKind.DateTime, "offset date-time")
  assert(toksOdt[0].start == 0 && toksOdt[0].end == len(odt), "spans the whole literal")

  let date = "1979-05-27"
  assert(lex(date)[0].kind == TokenKind.DateTime, "local date")

  let time = "07:32:00"
  assert(lex(time)[0].kind == TokenKind.DateTime, "local time")
}

test "punctuation: Dot, Equals, Comma, LBracket, RBracket, LBrace, RBrace each scan as one byte" {
  let toks = lex(".=,[]{}")
  let want = [
    TokenKind.Dot, TokenKind.Equals, TokenKind.Comma, TokenKind.LBracket,
    TokenKind.RBracket, TokenKind.LBrace, TokenKind.RBrace, TokenKind.Eof,
  ]
  assert(len(toks) == len(want), "one token per byte plus Eof")
  let i = 0
  while (i < len(want)) {
    assert(toks[i].kind == want[i], "token ${i} kind mismatch")
    i = i + 1
  }
}

test "Newline: both \\n and \\r\\n scan as one Newline token" {
  let lf = lex("\n")
  assert(lf[0].kind == TokenKind.Newline, "want Newline")
  assert(lf[0].start == 0 && lf[0].end == 1, "one byte for \\n")

  let crlf = lex("\r\n")
  assert(crlf[0].kind == TokenKind.Newline, "want Newline")
  assert(crlf[0].start == 0 && crlf[0].end == 2, "one token spanning both bytes")
}

test "Comment: # runs to end of source, not into a following Newline" {
  let src = "# hi\n"
  let toks = lex(src)
  assert(toks[0].kind == TokenKind.Comment, "want Comment")
  assert(toks[0].start == 0 && toks[0].end == 4, "excludes the line ending")
  assert(toks[1].kind == TokenKind.Newline, "the newline is its own token")
}

test "Eof: an empty source is exactly one Eof token at offset 0" {
  let toks = lex("")
  assert(len(toks) == 1, "only Eof")
  assert(toks[0].kind == TokenKind.Eof, "want Eof")
  assert(toks[0].start == 0 && toks[0].end == 0, "zero-width at offset 0")
}

test "Invalid: a raw control character inside a string aborts the string" {
  let toks = lex("\"a\x01b\"")
  assert(toks[0].kind == TokenKind.Invalid, "control byte inside a string is Invalid")
}

test "Invalid: nesting past tomlMaxDepth reports Invalid instead of crashing" {
  let deep = ""
  let n = 0
  while (n < tomlMaxDepth + 72) {
    deep = deep + "["
    n = n + 1
  }
  let toks = lex(deep)
  assert(len(toks) == tomlMaxDepth + 72 + 1, "one token per byte plus Eof, no crash")
  assert(toks[tomlMaxDepth].kind == TokenKind.Invalid, "the open past the cap is Invalid")
  assert(toks[tomlMaxDepth - 1].kind == TokenKind.LBracket, "the cap itself still opens")
  assert(toks[len(toks) - 1].kind == TokenKind.Eof, "the scan still reaches Eof")
}

// Drives `lexNext` by hand over a `Lexer`, mirroring exactly what the parser
// (a later ticket) will do, and asserts it produces the identical
// kind/start/end sequence `lex` does over the same source — proving
// `scanToken` is the only place a `Token` is built and the two entry points
// cannot drift apart (this file's own header, lex.bit's header).
fn driveLexNext(source: string): []Token {
  let lx = newLexer(source)
  let out = []Token(0)
  let guard = 0
  let bound = len(source) * 2 + 2
  while (guard <= bound) {
    lexNext(lx)
    out = append(out, Token{ kind: lx.kind, start: lx.start, end: lx.end })
    if (lx.kind == TokenKind.Eof) {
      break
    }
    guard = guard + 1
  }
  return out
}

test "lexNext and lex agree token-for-token over a source covering every TokenKind" {
  let src = "a.b = 1979-05-27T07:32:00Z\n" +
    "c = \"basic \\\"str\\\"\"\n" +
    "d = 'lit \\n raw'\n" +
    "e = \"\"\"\nml basic\"\"\"\n" +
    "f = '''\nml raw'''\n" +
    "g = 3.14\n" +
    "h = true\n" +
    "[i]\n" +
    "[[j]]\n" +
    "k = [1, 2]\n" +
    "l = {m = 1}\n" +
    "\x01\n" +
    "# trailing comment"

  let viaLex = lex(src)
  let viaNext = driveLexNext(src)
  assert(len(viaLex) == len(viaNext), "same token count")

  let seenKinds = []TokenKind(0)
  let i = 0
  while (i < len(viaLex)) {
    assert(viaLex[i].kind == viaNext[i].kind, "token ${i} kind mismatch")
    assert(viaLex[i].start == viaNext[i].start, "token ${i} start mismatch")
    assert(viaLex[i].end == viaNext[i].end, "token ${i} end mismatch")
    seenKinds = append(seenKinds, viaLex[i].kind)
    i = i + 1
  }

  let allKinds = [
    TokenKind.BareKey, TokenKind.BasicString, TokenKind.LiteralString,
    TokenKind.MlBasicString, TokenKind.MlLiteralString, TokenKind.Number,
    TokenKind.Bool, TokenKind.DateTime, TokenKind.Dot, TokenKind.Equals,
    TokenKind.Comma, TokenKind.LBracket, TokenKind.RBracket, TokenKind.LBrace,
    TokenKind.RBrace, TokenKind.Newline, TokenKind.Comment, TokenKind.Eof,
    TokenKind.Invalid,
  ]
  let k = 0
  while (k < len(allKinds)) {
    let found = false
    let j = 0
    while (j < len(seenKinds)) {
      if (seenKinds[j] == allKinds[k]) {
        found = true
      }
      j = j + 1
    }
    assert(found, "TokenKind ${k} never appears in the combined source")
    k = k + 1
  }
}
