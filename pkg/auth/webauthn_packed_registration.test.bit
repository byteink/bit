// Public registration applies its attestation policy independently of conveyance.
import { ecdsaPrivateKey } from "std/crypto"

class PackedStore {
  inner: MemoryCredentialStore
  adds: int = 0
  binds: int = 0

  init() { this.inner = MemoryCredentialStore() }

  export add(c: Credential): ()! {
    this.adds += 1
    this.inner.add(c)?
  }
  export byId(id: []byte): Option<Credential>! { return this.inner.byId(id)? }
  export forUser(id: string): []Credential! { return this.inner.forUser(id)? }
  export update(c: Credential): ()! { this.inner.update(c)? }
  export remove(id: []byte): ()! { this.inner.remove(id)? }
  export handleFor(id: string): Option<[]byte>! { return this.inner.handleFor(id)? }
  export userForHandle(handle: []byte): Option<string>! { return this.inner.userForHandle(handle)? }
  export bindHandle(id: string, handle: []byte): []byte! {
    this.binds += 1
    return this.inner.bindHandle(id, handle)?
  }
}

fn packedError(wa: WebAuthn, c: Ctx, response: Json): string {
  wa.finishRegistration(c, response) catch e {
    return e.message()
  }
  return ""
}

fn packedResponse(options: Json, mode: int): Json! {
  let key = ecdsaPrivateKey(nistecP256(), []byte{ 1 })?
  let id = []byte("packed-credential")
  let cd = regClientData("webauthn.create", regChallenge(options), regOrigin)
  let ad = buildAd(regRpId, 0x45, 5, id, coseKeyBytes(key))
  let message = append([]byte(0), ...ad)
  message = append(message, ...digest(Sha256(), cd))
  let signature = ecdsaSignatureToDer(ecdsaSign(key, digest(Sha256(), message), HashAlg.Sha256)?)
  let alg = Cbor.Negative(6)
  let fmt = "packed"
  if (mode == 1) {
    cd = append(cd, 0x20)
  }
  if (mode == 2) {
    signature[len(signature) - 1] ^= 1
  }
  if (mode == 3) {
    ad[36] ^= 1
  }
  if (mode == 4) {
    alg = Cbor.Negative(7)
  }
  if (mode == 6) {
    fmt = "tpm"
  }
  let entries = [
    CborEntry{ key = Cbor.Text("alg"), value = alg },
    CborEntry{ key = Cbor.Text("sig"), value = Cbor.Bytes(signature) },
  ]
  if (mode == 5) {
    entries = append(
      entries,
      CborEntry{ key = Cbor.Text("x5c"), value = Cbor.Array([Cbor.Bytes([]byte("certificate"))]) },
    )
  }
  return regResponse(id, cd, attObj(fmt, Cbor.Map(entries), ad))
}

test "packed registration restrictive policy refuses self regardless of conveyance" {
  for conveyance of [AttestationConveyance.None, AttestationConveyance.Direct] {
    let store = PackedStore()
    let wa = regWa(
      store,
      WebAuthnOptions{
        attestation = conveyance,
        attestationPolicy = AttestationPolicy{ formats = ["none"] },
      },
    )
    let got = inCtx((c) => {
      let options = begun(wa, c, regUser())
      let response = packedResponse(options, 0) catch e {
        return e.message()
      }
      return packedError(wa, c, response)
    })
    assert(contains(got, "not allowed"), got)
    assert(store.adds == 0 && store.binds == 0, "default refusal has no store writes")
  }
}

test "packed registration default policy stores once and spends challenge" {
  let store = PackedStore()
  let wa = regWa(store, WebAuthnOptions{})
  let got = inCtx((c) => {
    let options = begun(wa, c, regUser())
    let response = packedResponse(options, 0) catch e {
      return e.message()
    }
    let first = packedError(wa, c, response)
    if (first != "") {
      return first
    }
    return packedError(wa, c, response)
  })
  assert(contains(got, "no registration is in progress"), got)
  assert(store.adds == 1 && store.binds == 1, "exactly one successful registration")
  let rows = store.forUser(regUser().id) catch e {
    panic(e.message())
  }
  assert(len(rows) == 1 && rows[0].alg == -7, "credential key and algorithm stored")
}

fn packedRejected(mode: int) {
  let store = PackedStore()
  let wa = regWa(store, WebAuthnOptions{ allowPackedSelfAttestation = true })
  let got = inCtx((c) => {
    let options = begun(wa, c, regUser())
    let response = packedResponse(options, mode) catch e {
      return e.message()
    }
    let first = packedError(wa, c, response)
    if (first == "") {
      return "incorrectly accepted"
    }
    let replay = packedError(wa, c, response)
    if (!contains(replay, "no registration is in progress")) {
      return replay
    }
    return first
  })
  assert(contains(got, "attestation"), "mode ${mode}: ${got}")
  assert(store.adds == 0 && store.binds == 0, "mode ${mode}: failure never writes the store")
}

test "packed registration refuses raw client hash signature authdata alg x5c and unknown format" {
  for mode of [1, 2, 3, 4, 5, 6] {
    packedRejected(mode)
  }
}

test "none registration remains accepted with either packed self policy" {
  for enabled of [false, true] {
    let store = PackedStore()
    let wa = regWa(store, WebAuthnOptions{ allowPackedSelfAttestation = enabled })
    let got = inCtx((c) => regRun(wa, c, regOk()))
    assert(got == "", got)
    assert(store.adds == 1 && store.binds == 1, "none keeps existing store order")
  }
}

// W3C Level 3 section16.3 published packed-self vector; preserve raw JSON.
fn packedPublishedClient(): []byte {
  return waHex("")
}

test "packed registration published vector reaches public finish over exact raw bytes" {
  let store = PackedStore()
  let rp = RelyingParty{ id = "example.org", name = "Example", origins = ["https://example.org"] }
  let wa = WebAuthn(rp, store, WebAuthnOptions{ allowPackedSelfAttestation = true }) catch e {
    panic(e.message())
  }
  let raw = packedPublishedClient()
  assert(ctEq(digest(Sha256(), raw), waSelfHash()), "published raw clientData hash")
  let cd = parseClientData(raw) catch e {
    panic(e.message())
  }
  let obj = waSelfVector()
  let ac = unwrap(obj.authData.attested)
  let response = regResponse(ac.credentialId, raw, attObj(obj.fmt, obj.attStmt, obj.authData.raw))
  let got = inCtx((c) => {
    let seed = regSeed(c, cd.challenge, now().ns / Second + 300)
    if (seed != "") {
      return seed
    }
    return packedError(wa, c, response)
  })
  assert(got == "", got)
  assert(store.adds == 1 && store.binds == 1, "published credential stored once")
}
