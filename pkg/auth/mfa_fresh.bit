// A session cookie proves continuity, not a new authentication event (#8433).
// Ordinary middleware rebinding must not extend the age of a verified proof.

const authenticatedAtKey = "auth:authenticated-at"
const authenticatedFactorKey = "auth:authenticated-factor"
const reauthenticationCode = "reauthentication_required"

fn writeFreshProof(session: Session, factor: string) {
  session.set(authenticatedAtKey, "${now().ns / Second}")
  setFreshValue(session, authenticatedFactorKey, factor)
}

fn setFreshValue(session: Session, key: string, value: string) {
  if (value == "") {
    session.delete(key)
    return
  }
  session.set(key, value)
}

fn clearFreshProof(session: Session) {
  session.delete(authenticatedAtKey)
  session.delete(authenticatedFactorKey)
}

fn rebindSession(c: Ctx, id: Identity): ()! {
  let raw = c.session()?.get(identitySessionKey)
  let proof = Option<string>.Some("")
  if (raw != "" && decodeIdentity(raw)?.id == id.id) {
    proof = Option<string>.None
  }
  bindSessionProof(c, id, BindOptions{}, proof)?
}

fn freshProofAt(raw: string, at: i64, maxAge: i64): bool {
  if (maxAge < 0 || raw == "") {
    return false
  }
  let parsed = parseInt(raw) catch _ {
    return false
  }
  let verified = i64(parsed)
  if (verified < 0 || verified > at) {
    return false
  }
  return at - verified <= maxAge
}

fn freshFactorMatches(session: Session, factor: Option<SecondFactor>): bool {
  match (factor) {
    None => return true
    Some(required) => {
      let name = required.name()
      return name != "" && session.get(authenticatedFactorKey) == name
    }
  }
}

fn freshCurrentIdentity(c: Ctx): Identity! {
  let _ = c.session()?
  let id = currentIdentity(c) catch _ {
    fail unauthorized(reauthenticationCode)
  }
  if (id.id == "") {
    fail unauthorized(reauthenticationCode)
  }
  return id
}

// Require a recent verified login or reauthentication before a sensitive action.
// A factor also requires that named factor to be the latest verified proof.
// This middleware never verifies input, rotates a session, or refreshes its age.
export fn requireFresh(maxAge: i64, factor: Option<SecondFactor> = Option.None): Middleware {
  let middleware: Middleware = (c, next) => {
    let _ = freshCurrentIdentity(c)?
    let session = c.session()?
    if (!freshProofAt(session.get(authenticatedAtKey), now().ns / Second, maxAge) ||
      !freshFactorMatches(session, factor)) {
      fail unauthorized(reauthenticationCode)
    }
    return next(c)?
  }
  return middleware
}

// Refresh only proof metadata for the current identity. The factor must throttle
// its own attempts, as TotpFactor does; a wrong proof or store error fails closed.
export fn reauthenticate(c: Ctx, factor: SecondFactor, input: string): ()! {
  let id = freshCurrentIdentity(c)?
  let name = factor.name()
  if (name == "") {
    fail newError("auth: reauthenticate(): the factor name is empty")
  }
  if (!factor.verify(c, id.id, input)?) {
    fail unauthorized(reauthenticationCode)
  }
  let session = c.session()?
  let previousAt = session.get(authenticatedAtKey)
  let previousFactor = session.get(authenticatedFactorKey)
  writeFreshProof(session, name)
  session.save() catch e {
    setFreshValue(session, authenticatedAtKey, previousAt)
    setFreshValue(session, authenticatedFactorKey, previousFactor)
    fail e
  }
}
