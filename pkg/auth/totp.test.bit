// pkg/auth/totp.test.bit — #6076's acceptance: RFC 4226 Appendix D's HOTP
// vectors and RFC 6238 Appendix B's TOTP vectors (all three hash variants),
// exactly, plus `verify`'s skew window, a bad code, and replay protection.
//
// `HashAlg`, `decodeBase32`, `encodeBase32` and `hmacTag` (totp.bit) are already
// bound module-wide (SPEC §17.1); re-importing any of them here is E0042.

fn rfc4226Secret(): Secret { return Secret{ key = []byte("12345678901234567890") } }
fn rfc6238Sha1Secret(): Secret { return Secret{ key = []byte("12345678901234567890") } }
fn rfc6238Sha256Secret(): Secret {
  return Secret{ key = []byte("12345678901234567890123456789012") }
}
fn rfc6238Sha512Secret(): Secret {
  return Secret{ key = []byte("1234567890123456789012345678901234567890123456789012345678901234") }
}

test "hotp: RFC 4226 Appendix D test vectors" {
  let want = []string{
    "755224", "287082", "359152", "969429", "338314",
    "254676", "287922", "162583", "399871", "520489",
  }
  let secret = rfc4226Secret()
  let counter: uint = 0
  let i = 0
  while (i < len(want)) {
    let got = hotp(secret, counter, 6)
    assert(got == want[i], "hotp(counter=${counter}) = ${got}, want ${want[i]}")
    counter = counter + 1
    i = i + 1
  }
}

// Each row is (unixSeconds, SHA-1 code, SHA-256 code, SHA-512 code), all at
// 8 digits and the default 30-second period — RFC 6238 Appendix B, exactly.
class Rfc6238Row {
  time: int,
  sha1: string,
  sha256: string,
  sha512: string,
}

fn rfc6238Rows(): []Rfc6238Row {
  return []Rfc6238Row{
    Rfc6238Row{ time = 59, sha1 = "94287082", sha256 = "46119246", sha512 = "90693936" },
    Rfc6238Row{ time = 1111111109, sha1 = "07081804", sha256 = "68084774", sha512 = "25091201" },
    Rfc6238Row{ time = 1111111111, sha1 = "14050471", sha256 = "67062674", sha512 = "99943326" },
    Rfc6238Row{ time = 1234567890, sha1 = "89005924", sha256 = "91819424", sha512 = "93441116" },
    Rfc6238Row{ time = 2000000000, sha1 = "69279037", sha256 = "90698825", sha512 = "38618901" },
    Rfc6238Row{ time = 20000000000, sha1 = "65353130", sha256 = "77737706", sha512 = "47863826" },
  }
}

test "totp: RFC 6238 Appendix B test vectors, SHA-1" {
  let secret = rfc6238Sha1Secret()
  let algo = sha1(8, 30)
  for row of rfc6238Rows() {
    let got = algo.totp(secret, row.time)
    assert(got == row.sha1, "totp(SHA-1, t=${row.time}) = ${got}, want ${row.sha1}")
  }
}

test "totp: RFC 6238 Appendix B test vectors, SHA-256" {
  let secret = rfc6238Sha256Secret()
  let algo = Algorithm{ hash = HashAlg.Sha256, digits = 8, period = 30 }
  for row of rfc6238Rows() {
    let got = algo.totp(secret, row.time)
    assert(got == row.sha256, "totp(SHA-256, t=${row.time}) = ${got}, want ${row.sha256}")
  }
}

test "totp: RFC 6238 Appendix B test vectors, SHA-512" {
  let secret = rfc6238Sha512Secret()
  let algo = Algorithm{ hash = HashAlg.Sha512, digits = 8, period = 30 }
  for row of rfc6238Rows() {
    let got = algo.totp(secret, row.time)
    assert(got == row.sha512, "totp(SHA-512, t=${row.time}) = ${got}, want ${row.sha512}")
  }
}

test "generateSecret/parseSecret round trip through base32" {
  let secret = generateSecret()
  assert(len(secret.key) == 20, "generateSecret: key is ${len(secret.key)} bytes, want 20")
  let parsed = parseSecret(secret.base32()) catch e {
    panic("parseSecret(${secret.base32()}): ${e.message()}")
  }
  assert(ctEq(parsed.key, secret.key), "parseSecret(secret.base32()) did not round trip")
}

test "parseSecret: tolerant of lowercase and missing padding" {
  let secret = Secret{ key = []byte("12345678901234567890") }
  // Google Authenticator's own display convention: lowercase, no padding.
  let noPad = strLower(trimEquals(secret.base32()))
  let parsed = parseSecret(noPad) catch e {
    panic("parseSecret(${noPad}): ${e.message()}")
  }
  assert(ctEq(parsed.key, secret.key), "parseSecret did not tolerate lowercase/unpadded input")
}

fn trimEquals(s: string): string {
  let n = len(s)
  while (n > 0 && s[n - 1] == '=') {
    n = n - 1
  }
  return s[0:n]
}

fn strLower(s: string): string {
  let out = []byte(len(s))
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c >= 'A' && c <= 'Z') {
      out[i] = c + 32
    } else {
      out[i] = c
    }
    i = i + 1
  }
  return string(out)
}

test "provisioningUri: otpauth URI carries the secret, issuer, account, digits and period" {
  let secret = Secret{ key = []byte("12345678901234567890") }
  let uri = provisioningUri(secret, "Inkwell", "ada@example.com") catch e {
    panic("provisioningUri with default options failed: ${e.message()}")
  }
  assert(hasPrefixT(uri, "otpauth://totp/Inkwell:ada%40example.com?"), "uri = ${uri}")
  assert(containsT(uri, "secret=GEZDGNBVGY3TQOJQ"), "uri missing base32 secret: ${uri}")
  assert(containsT(uri, "issuer=Inkwell"), "uri missing issuer: ${uri}")
  assert(containsT(uri, "algorithm=SHA1"), "uri missing algorithm: ${uri}")
  assert(containsT(uri, "digits=6"), "uri missing digits: ${uri}")
  assert(containsT(uri, "period=30"), "uri missing period: ${uri}")
}

test "provisioningUri: default options give the exact pre-options URI" {
  let secret = Secret{ key = []byte("12345678901234567890") }
  let want = "otpauth://totp/Inkwell:ada%40example.com?secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ" +
    "&issuer=Inkwell&algorithm=SHA1&digits=6&period=30"
  let plain = provisioningUri(secret, "Inkwell", "ada@example.com") catch e {
    panic("default failed: ${e.message()}")
  }
  let explicit = provisioningUri(
    secret, "Inkwell", "ada@example.com", ProvisioningOptions{ digits = 6, period = 30 },
  ) catch e {
    panic("explicit defaults failed: ${e.message()}")
  }
  assert(plain == want, "default uri = ${plain}")
  assert(explicit == want, "explicit-default uri = ${explicit}")
}

test "provisioningUri: ProvisioningOptions sets digits and period" {
  let secret = Secret{ key = []byte("12345678901234567890") }
  let uri = provisioningUri(
    secret, "Inkwell", "ada@example.com", ProvisioningOptions{ digits = 8, period = 60 },
  ) catch e {
    panic("digits=8 period=60 failed: ${e.message()}")
  }
  let want = "otpauth://totp/Inkwell:ada%40example.com?secret=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ" +
    "&issuer=Inkwell&algorithm=SHA1&digits=8&period=60"
  assert(uri == want, "uri = ${uri}")
}

fn provisioningFailure(digits: int, period: int): string {
  let secret = Secret{ key = []byte("12345678901234567890") }
  let uri = provisioningUri(
    secret, "Inkwell", "ada@example.com", ProvisioningOptions{ digits = digits, period = period },
  ) catch e {
    return e.message()
  }
  panic("digits=${digits} period=${period} should have failed, got ${uri}")
}

test "provisioningUri: digits outside 6..8 and a non-positive period fail loudly" {
  let low = provisioningFailure(5, 30)
  assert(low == "auth: provisioningUri(): digits must be 6..8, got 5", "digits 5: ${low}")
  let high = provisioningFailure(9, 30)
  assert(high == "auth: provisioningUri(): digits must be 6..8, got 9", "digits 9: ${high}")
  let zero = provisioningFailure(6, 0)
  assert(zero == "auth: provisioningUri(): period must be > 0, got 0", "period 0: ${zero}")
}

fn hasPrefixT(s: string, prefix: string): bool {
  return len(s) >= len(prefix) && s[0:len(prefix)] == prefix
}

fn containsT(s: string, sub: string): bool {
  let n = len(s)
  let m = len(sub)
  if (m == 0) {
    return true
  }
  let i = 0
  while (i + m <= n) {
    if (s[i:i + m] == sub) {
      return true
    }
    i = i + 1
  }
  return false
}

// `verify`'s tests run `Algorithm.verify` at RFC 6238 Appendix B's own
// 8-digit vectors, so the codes below are the exact ones proven against
// `totp` above rather than a second hand-computed set.

test "verify: accepts the current code with zero skew" {
  let secret = rfc6238Sha1Secret()
  let counter = sha1(8, 30).verify(secret, "94287082", 59, 0, 0) catch e {
    panic("verify: ${e.message()}")
  }
  assert(counter == 1, "verify returned counter ${counter}, want 1 (59 / 30)")
}

test "verify: a code one period stale is rejected at skew 0 but accepted at skew 1" {
  let secret = rfc6238Sha1Secret()
  // The code for T=1 (unixSeconds=59) checked against a clock now at
  // T=2 (unixSeconds=89, one period later).
  let rejected = sha1(8, 30).verify(secret, "94287082", 89, 0, 0) catch _ {
    return
  }
  panic("verify at skew 0 should have rejected a stale code, got counter ${rejected}")
}

test "verify: skew 1 accepts a code one period behind" {
  let secret = rfc6238Sha1Secret()
  let counter = sha1(8, 30).verify(secret, "94287082", 89, 0, 1) catch e {
    panic("verify at skew 1: ${e.message()}")
  }
  assert(counter == 1, "verify returned counter ${counter}, want 1")
}

test "verify: rejects a code that does not match any step in the window" {
  let secret = rfc6238Sha1Secret()
  let result = sha1(8, 30).verify(secret, "00000000", 59, 0, 1) catch _ {
    return
  }
  panic("verify should have rejected a bad code, got counter ${result}")
}

test "verify: replay protection rejects a counter already at or below lastCounter" {
  let secret = rfc6238Sha1Secret()
  // The code for T=1 (unixSeconds=59) is real and correct, but the caller
  // already accepted counter 1 on a previous login.
  let result = sha1(8, 30).verify(secret, "94287082", 59, 1, 0) catch _ {
    return
  }
  panic("verify should have rejected an already-used counter, got counter ${result}")
}

test "verify: a fresh code after the last accepted counter succeeds and advances it" {
  let secret = rfc6238Sha1Secret()
  let algo = sha1(8, 30)
  let first = algo.verify(secret, "94287082", 59, 0, 0) catch e {
    panic("first verify: ${e.message()}")
  }
  assert(first == 1, "first verify returned ${first}, want 1")
  // A later login, one period on: T=2 (unixSeconds=89).
  let code = algo.totp(secret, 89)
  let second = algo.verify(secret, code, 89, first, 0) catch e {
    panic("second verify: ${e.message()}")
  }
  assert(second == 2, "second verify returned ${second}, want 2")
}

test "verify: the module-level convenience wraps sha1(6, 30)" {
  let secret = rfc6238Sha1Secret()
  let code = totp(secret, 59)
  let counter = verify(secret, code, 59, 0, 0) catch e {
    panic("verify: ${e.message()}")
  }
  assert(counter == 1, "verify returned counter ${counter}, want 1")
}
