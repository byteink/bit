// pkg/auth/webauthn_bad.test.bit — #6956's acceptance for webauthn_parse.bit,
// part 2 (helpers are in webauthn_parse.test.bit): a packed and a none
// attestation object built from a generated P-256 key, whose parsed key
// verifies the packed signature; 15 of 15 malformed authenticatorData (the 12
// required and 3 more); every truncation, every one-byte extension and 4096
// seeded random mutations of a valid authenticatorData return a value or an
// error and never panic; 10 of 10 malformed attestation objects.

// ---------------------------------------------------------------------------
// Self-made vectors
// ---------------------------------------------------------------------------

fn coseKeyBytes(priv: EcdsaPrivateKey): []byte {
  let sec1 = nistecPointEncode(priv.curve, priv.q, false) catch e {
    panic("nistecPointEncode: ${e.message()}")
  }
  let m = Cbor.Map(
    [
      CborEntry{ key = Cbor.Uint(1), value = Cbor.Uint(2) },
      CborEntry{ key = Cbor.Uint(3), value = Cbor.Negative(6) },
      CborEntry{ key = Cbor.Negative(0), value = Cbor.Uint(1) },
      CborEntry{ key = Cbor.Negative(1), value = Cbor.Bytes(sec1[1:33]) },
      CborEntry{ key = Cbor.Negative(2), value = Cbor.Bytes(sec1[33:65]) },
    ],
  )
  return encode(m) catch e {
    panic("encode: ${e.message()}")
  }
}

fn be16(n: int): []byte {
  return []byte{ byte(n >> 8), byte(n & 255) }
}

// rpIdHash, flags, signCount, then attested data (aaguid of 16 sevens, the
// credentialId, `key`) when `at`.
fn buildAd(rp: string, flags: byte, count: uint, credId: []byte, key: []byte): []byte {
  let out = []byte(0)
  out = append(out, ...rpSha(rp))
  out = append(out, flags)
  out = append(out, byte(count >> 24), byte(count >> 16), byte(count >> 8), byte(count))
  if ((flags & 0x40) != 0) {
    let i = 0
    while (i < 16) {
      out = append(out, 7)
      i = i + 1
    }
    out = append(out, ...be16(len(credId)))
    out = append(out, ...credId)
    out = append(out, ...key)
  }
  return out
}

fn attObj(fmt: string, stmt: Cbor, ad: []byte): []byte {
  let m = Cbor.Map(
    [
      CborEntry{ key = Cbor.Text("fmt"), value = Cbor.Text(fmt) },
      CborEntry{ key = Cbor.Text("attStmt"), value = stmt },
      CborEntry{ key = Cbor.Text("authData"), value = Cbor.Bytes(ad) },
    ],
  )
  return encode(m) catch e {
    panic("encode: ${e.message()}")
  }
}

test "self-made packed attestation: the parsed key verifies the packed signature" {
  let priv = ecdsaGenerateKey(nistecP256())
  let ad = buildAd("example.com", 0x45, 7, []byte("credential-id-01"), coseKeyBytes(priv))
  let cdHash = rpSha("client data stand-in")
  let msg = append([]byte(0), ...ad)
  msg = append(msg, ...cdHash)
  let sig = ecdsaSign(priv, digest(Sha256(), msg), HashAlg.Sha256) catch e {
    panic("ecdsaSign: ${e.message()}")
  }
  let stmt = Cbor.Map(
    [
      CborEntry{ key = Cbor.Text("alg"), value = Cbor.Negative(6) },
      CborEntry{ key = Cbor.Text("sig"), value = Cbor.Bytes(ecdsaSignatureToDer(sig)) },
    ],
  )
  let a = parseAttestationObject(attObj("packed", stmt, ad)) catch e {
    panic("parseAttestationObject: ${e.message()}")
  }
  assert(a.fmt == "packed", "fmt")
  assert(a.authData.up && a.authData.uv && a.authData.signCount == 7, "flags")
  assert(ctEq(a.authData.raw, ad), "raw is the exact authData")
  let ac = unwrap(a.authData.attested)
  assert(ctEq(ac.credentialId, []byte("credential-id-01")), "credentialId")
  let ok = coseVerify(ac.publicKey, -7, msg, ecdsaSignatureToDer(sig)) catch e {
    panic("coseVerify: ${e.message()}")
  }
  assert(ok, "the parsed key must verify the packed signature")
  checkRpIdHash(a.authData, "example.com") catch e {
    panic("rpIdHash: ${e.message()}")
  }
  assert(contains(rpIdError(a.authData, "example.org"), "rpIdHash"), "wrong rpId must fail")
  assert(contains(rpIdError(a.authData, ""), "empty"), "empty rpId must fail")
}

fn rpIdError(ad: AuthenticatorData, rp: string): string {
  checkRpIdHash(ad, rp) catch e {
    return e.message()
  }
  panic("checkRpIdHash accepted '${rp}'")
}

test "self-made none attestation, flags BE and BS, and an extensions map" {
  let priv = ecdsaGenerateKey(nistecP256())
  let key = coseKeyBytes(priv)
  let ad = buildAd("example.com", 0xDD, 9, []byte("id"), key)
  // ED set: the extensions map {"credProtect": 2} follows the key.
  let ext = encode(Cbor.Map([CborEntry{ key = Cbor.Text("credProtect"), value = Cbor.Uint(2) }])) catch e {
    panic("encode: ${e.message()}")
  }
  let withExt = append(ad, ...ext)
  let a = parseAttestationObject(attObj("none", Cbor.Map([]), withExt)) catch e {
    panic("parseAttestationObject: ${e.message()}")
  }
  let d = a.authData
  assert(d.up && d.uv && d.be && d.bs, "flags up uv be bs")
  assert(isSome(d.attested) && isSome(d.extensions), "attested data and extensions")
  assert(ctEq(unwrap(d.attested).publicKeyBytes, key), "key bytes verbatim")
  // BE without BS is valid, and so is neither.
  assert(waParses(buildAd("example.com", 0x09, 0, []byte(0), []byte(0))), "BE only")
  assert(waParses(buildAd("example.com", 0x01, 0, []byte(0), []byte(0))), "UP only")
}

fn waParses(data: []byte): bool {
  parseAuthenticatorData(data) catch _ {
    return false
  }
  return true
}

// ---------------------------------------------------------------------------
// Malformed authenticatorData: 12 of 12
// ---------------------------------------------------------------------------

class BadAd {
  name: string,
  data: []byte,
  want: string,
}

// The 37-byte header alone, whatever `flags` promises after it.
fn headerOnly(flags: byte): []byte {
  let h = buildAd("acme.com", 0x01, 1, []byte(0), []byte(0))
  h[32] = flags
  return h
}

fn badAdRows(): []BadAd {
  let good = waHex(vecChromeMake())
  let idLenBeyond = append([]byte(0), ...good)
  idLenBeyond[53] = 0x03
  idLenBeyond[54] = 0xFF
  let idLenHuge = append([]byte(0), ...good)
  idLenHuge[53] = 0xFF
  idLenHuge[54] = 0xFF
  let badKey = append([]byte(0), ...good[0:55 + 16])
  badKey = append(badKey, 0xFF)
  let truncKey = append([]byte(0), ...good[0:55 + 16 + 10])
  let atCleared = append([]byte(0), ...good)
  atCleared[32] = 0x01
  let ed = headerOnly(0x81)
  let hugeMap = append(
    append([]byte(0), ...ed),
    0xBB,
    0xFF,
    0xFF,
    0xFF,
    0xFF,
    0xFF,
    0xFF,
    0xFF,
    0xFF,
  )
  let afterExt = append(append([]byte(0), ...ed), 0xA1, 0x61, 0x61, 0x01, 0x00)
  let extNotMap = append(append([]byte(0), ...ed), 0x01)
  return []BadAd{
    BadAd{ name = "length under 37", data = good[0:36], want = "want at least 37" },
    BadAd{ name = "AT set with no attested data", data = headerOnly(0x41), want = "AT flag" },
    BadAd{
      name = "AT clear with attested data present",
      data = atCleared,
      want = "trailing bytes",
    },
    BadAd{
      name = "truncated credentialId",
      data = good[0:55 + 8],
      want = "ends inside the credentialId",
    },
    BadAd{
      name = "credentialIdLength beyond the input",
      data = idLenBeyond,
      want = "ends inside the credentialId",
    },
    BadAd{
      name = "credentialIdLength over 1023",
      data = idLenHuge,
      want = "credentialIdLength is 65535",
    },
    BadAd{ name = "BS without BE", data = headerOnly(0x11), want = "BS without BE" },
    BadAd{
      name = "trailing bytes without ED",
      data = append(append([]byte(0), ...good), 0x00),
      want = "trailing bytes",
    },
    BadAd{ name = "credentialPublicKey is not CBOR", data = badKey, want = "credentialPublicKey" },
    BadAd{ name = "oversized extensions map", data = hugeMap, want = "extensions" },
    BadAd{ name = "truncated signCount", data = good[0:35], want = "want at least 37" },
    BadAd{ name = "truncated credentialPublicKey", data = truncKey, want = "credentialPublicKey" },
    BadAd{ name = "bytes after the extensions map", data = afterExt, want = "extensions" },
    BadAd{ name = "ED set with no extensions", data = ed, want = "no extensions" },
    BadAd{ name = "extensions are not a map", data = extNotMap, want = "not a CBOR map" },
  }
}

test "authenticator data: 15 malformed inputs rejected with a typed error (12 required)" {
  let rows = badAdRows()
  assert(len(rows) == 15, "rows ${len(rows)}")
  let i = 0
  while (i < len(rows)) {
    let msg = adError(rows[i].data)
    assert(contains(msg, rows[i].want), "${rows[i].name}: '${msg}' lacks '${rows[i].want}'")
    i = i + 1
  }
}

test "authenticator data: every truncation of a valid input is an error, every extension is an error" {
  let good = waHex(vecChromeMake())
  assert(waParses(good), "the base input is valid")
  let n = 0
  while (n < len(good)) {
    assert(!waParses(good[0:n]), "a ${n}-byte prefix of ${len(good)} parsed")
    n = n + 1
  }
  let extra = 1
  while (extra <= 8) {
    let longer = append([]byte(0), ...good)
    let k = 0
    while (k < extra) {
      longer = append(longer, 0xA5)
      k = k + 1
    }
    assert(!waParses(longer), "${extra} trailing bytes parsed")
    extra = extra + 1
  }
}

test "authenticator data: 4096 seeded random mutations return a value or an error, never a panic" {
  let seeds = []string{ vecChromeMake(), vecAd187(), vecChromeSign(), vecChromeGet() }
  let state: uint = 88172645463325252
  let ok = 0
  let bad = 0
  let iter = 0
  while (iter < 4096) {
    let data = append([]byte(0), ...waHex(seeds[iter % len(seeds)]))
    let flips = 1 + iter % 3
    let f = 0
    while (f < flips) {
      state = state ^ (state << 13)
      state = state ^ (state >> 7)
      state = state ^ (state << 17)
      let at = int(state % uint(len(data)))
      data[at] = byte((state >> 32) & 255)
      f = f + 1
    }
    if (iter % 5 == 0) {
      data = data[0:int((state >> 8) % uint(len(data) + 1))]
    }
    if (waParses(data)) {
      ok = ok + 1
    } else {
      bad = bad + 1
    }
    iter = iter + 1
  }
  assert(ok + bad == 4096, "ok ${ok} bad ${bad}")
  assert(bad > 0 && ok > 0, "the mutations must hit both outcomes: ok ${ok} bad ${bad}")
}

// ---------------------------------------------------------------------------
// Malformed attestation objects: 8 of 8
// ---------------------------------------------------------------------------

test "attestation object: 10 of 10 malformed inputs rejected" {
  let ad = waHex(vecChromeSign())
  let stmt = Cbor.Map([])
  let good = attObj("none", stmt, ad)
  assert(waAttOk(good), "base object parses")
  assert(contains(attError(good[0:len(good) - 1]), "attestationObject"), "truncated")
  assert(contains(attError(append(append([]byte(0), ...good), 0x00)), "trailing"), "trailing byte")
  assert(contains(attError([]byte{ 0x80 }), "not a CBOR map"), "array")
  assert(
    contains(
      attError(waEnc(Cbor.Map([waEnt("fmt", Cbor.Text("none")), waEnt("attStmt", stmt)]))),
      "want exactly",
    ),
    "two members",
  )
  assert(
    contains(
      attError(
        waEnc(
          Cbor.Map(
            [
              waEnt("fmt", Cbor.Text("none")),
              waEnt("attStmt", stmt),
              waEnt("authData", Cbor.Bytes(ad)),
              waEnt("x", Cbor.Null),
            ],
          ),
        ),
      ),
      "want exactly",
    ),
    "four members",
  )
  assert(contains(attError(dupFmt(ad)), "repeats the key 'fmt'"), "duplicate fmt")
  assert(
    contains(
      attError(
        waEnc(
          Cbor.Map(
            [waEnt("fmt", Cbor.Uint(1)), waEnt("attStmt", stmt), waEnt("authData", Cbor.Bytes(ad))],
          ),
        ),
      ),
      "'fmt' is not text",
    ),
    "fmt type",
  )
  assert(
    contains(
      attError(
        waEnc(
          Cbor.Map(
            [
              waEnt("fmt", Cbor.Text("none")),
              waEnt("attStmt", stmt),
              waEnt("authData", Cbor.Text("x")),
            ],
          ),
        ),
      ),
      "'authData' is not a byte string",
    ),
    "authData type",
  )
  assert(
    contains(attError(attObj("none", stmt, ad[0:20])), "want at least 37"),
    "authData too short is reported",
  )
  assert(
    contains(
      attError(
        waEnc(
          Cbor.Map(
            [
              waEnt("fmt", Cbor.Text("none")),
              waEnt("attStmt", Cbor.Uint(0)),
              waEnt("authData", Cbor.Bytes(ad)),
            ],
          ),
        ),
      ),
      "'attStmt' is not a map",
    ),
    "attStmt type",
  )
}

// A three-member map whose first two keys are both "fmt"; `encode` refuses to
// write that, so the bytes are joined by hand.
fn dupFmt(ad: []byte): []byte {
  let out = []byte{ 0xA3 }
  out = append(out, ...waEnc(Cbor.Text("fmt")))
  out = append(out, ...waEnc(Cbor.Text("none")))
  out = append(out, ...waEnc(Cbor.Text("fmt")))
  out = append(out, ...waEnc(Cbor.Text("packed")))
  out = append(out, ...waEnc(Cbor.Text("authData")))
  out = append(out, ...waEnc(Cbor.Bytes(ad)))
  return out
}

fn waEnc(m: Cbor): []byte {
  return encode(m) catch e {
    panic("encode: ${e.message()}")
  }
}

fn waEnt(k: string, v: Cbor): CborEntry {
  return CborEntry{ key = Cbor.Text(k), value = v }
}

fn waAttOk(data: []byte): bool {
  parseAttestationObject(data) catch _ {
    return false
  }
  return true
}

test "attestation object: authData bytes are re-checked, so a bad credential key inside is rejected" {
  let good = waHex(vecChromeMake())
  let bad = append([]byte(0), ...good[0:55 + 16])
  bad = append(bad, 0xFF)
  assert(
    contains(attError(attObj("none", Cbor.Map([]), bad)), "credentialPublicKey"),
    "bad key inside an attestation object",
  )
}
