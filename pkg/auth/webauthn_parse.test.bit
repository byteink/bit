// pkg/auth/webauthn_parse.test.bit — #6956's acceptance for webauthn_parse.bit,
// part 1: published vectors (webauthn_vectors.test.bit, real authenticator
// output) and the clientData checks. Part 2 is webauthn_bad.test.bit.
//
// Published vectors: 6 of 6 attestation objects parse and 1 of 1 whose ES512
// key is refused, 4 of 4 authenticator data, 9 of 9 clientDataJSON, each to the
// values stated beside it. clientData: 6 required rejections (wrong type,
// challenge mismatch, origin not listed, topOrigin unlisted, duplicate keys,
// invalid base64url) and 7 more.
//
// `decodeHex`, `HashAlg` and the `std/cbor` names are bound module-wide
// (SPEC §17.1); re-importing any of them here is E0042.

// (SPEC §17.1); re-importing any of them here is E0042.

import {
  EcdsaPrivateKey,
  coseVerify,
  coseAlg,
  ecdsaGenerateKey,
  ecdsaSign,
  ecdsaSignatureToDer,
  nistecP256,
  nistecPointEncode,
} from "std/crypto"
import { contains } from "std/strings"
import { encode } from "std/cbor"

fn waHex(s: string): []byte {
  return decodeHex(s) catch e {
    panic("bad hex in webauthn_parse.test.bit: ${e.message()}")
  }
}

fn waAd(hex: string): AuthenticatorData {
  return parseAuthenticatorData(waHex(hex)) catch e {
    panic("parseAuthenticatorData: ${e.message()}")
  }
}

fn waAtt(hex: string): AttestationObject {
  return parseAttestationObject(waHex(hex)) catch e {
    panic("parseAttestationObject: ${e.message()}")
  }
}

fn waCd(hex: string): ClientData {
  return parseClientData(waHex(hex)) catch e {
    panic("parseClientData: ${e.message()}")
  }
}

fn adError(data: []byte): string {
  let ad = parseAuthenticatorData(data) catch e {
    return e.message()
  }
  panic("authenticatorData parsed, signCount ${ad.signCount}")
}

fn attError(data: []byte): string {
  let a = parseAttestationObject(data) catch e {
    return e.message()
  }
  panic("attestationObject parsed, fmt ${a.fmt}")
}

fn cdError(json: string): string {
  let cd = parseClientData([]byte(json)) catch e {
    return e.message()
  }
  panic("clientData parsed, origin ${cd.origin}")
}

fn rpSha(rp: string): []byte {
  return digest(Sha256(), []byte(rp))
}

fn credLen(ad: AuthenticatorData): int {
  if (!isSome(ad.attested)) {
    return -1
  }
  return len(unwrap(ad.attested).credentialId)
}

// ---------------------------------------------------------------------------
// Published vectors
// ---------------------------------------------------------------------------

class AttRow {
  name: string,
  hex: string,
  fmt: string,
  uv: bool,
  signCount: uint,
  rpId: string,
  idLen: int,
  err: string,
}

fn attRows(): []AttRow {
  return []AttRow{
    AttRow{
      name = "go-webauthn packed 297",
      hex = vecAtt297(),
      fmt = "packed",
      uv = true,
      signCount = 1553021388,
      rpId = "localhost",
      idLen = 51,
      err = "",
    },
    AttRow{
      name = "go-webauthn fido-u2f 909",
      hex = vecAtt909(),
      fmt = "fido-u2f",
      uv = false,
      signCount = 0,
      rpId = "webauthn.io",
      idLen = 64,
      err = "",
    },
    AttRow{
      name = "go-webauthn none 226",
      hex = vecAtt226(),
      fmt = "none",
      uv = false,
      signCount = 0,
      rpId = "webauthn.io",
      idLen = 64,
      err = "",
    },
    AttRow{
      name = "go-webauthn packed 1045",
      hex = vecAtt1045(),
      fmt = "packed",
      uv = true,
      signCount = 1,
      rpId = "",
      idLen = 274,
      err = "",
    },
    AttRow{
      name = "go-webauthn packed 415",
      hex = vecAtt415(),
      fmt = "packed",
      uv = false,
      signCount = 102,
      rpId = "localhost",
      idLen = 32,
      err = "cose: unsupported alg -36",
    },
    AttRow{
      name = "go-webauthn packed 1172",
      hex = vecAtt1172(),
      fmt = "packed",
      uv = false,
      signCount = 39,
      rpId = "",
      idLen = 268,
      err = "",
    },
    AttRow{
      name = "chromium none",
      hex = vecChromeNone(),
      fmt = "none",
      uv = false,
      signCount = 11,
      rpId = "acme.com",
      idLen = 16,
      err = "",
    },
  }
}

test "attestation objects: 6 of 6 published vectors parse to the stated values, 1 of 1 ES512 key is refused" {
  let rows = attRows()
  assert(len(rows) == 7, "rows ${len(rows)}")
  let i = 0
  while (i < len(rows)) {
    let r = rows[i]
    if (r.err != "") {
      let msg = attError(waHex(r.hex))
      assert(contains(msg, r.err), "${r.name}: '${msg}' lacks '${r.err}'")
      i = i + 1
      continue
    }
    let a = waAtt(r.hex)
    assert(a.fmt == r.fmt, "${r.name}: fmt ${a.fmt}")
    assert(a.authData.up, "${r.name}: up")
    assert(a.authData.uv == r.uv, "${r.name}: uv ${a.authData.uv}")
    assert(a.authData.signCount == r.signCount, "${r.name}: signCount ${a.authData.signCount}")
    assert(isSome(a.authData.attested), "${r.name}: no attested credential data")
    assert(credLen(a.authData) == r.idLen, "${r.name}: credentialId ${credLen(a.authData)} bytes")
    if (r.rpId != "") {
      checkRpIdHash(a.authData, r.rpId) catch e {
        panic("${r.name}: ${e.message()}")
      }
    }
    i = i + 1
  }
}

test "attestation objects: the parsed credential key is an ES256 key and its bytes are kept verbatim" {
  let a = waAtt(vecChromeNone())
  let ac = unwrap(a.authData.attested)
  assert(coseAlg(ac.publicKey) == -7, "alg ${coseAlg(ac.publicKey)}")
  assert(len(ac.publicKeyBytes) == 77, "publicKeyBytes ${len(ac.publicKeyBytes)}")
  assert(len(ac.aaguid) == 16, "aaguid ${len(ac.aaguid)}")
  assert(
    encodeHex(ac.aaguid) == "00000000000000000000000000000000",
    "aaguid ${encodeHex(ac.aaguid)}",
  )
  let again = parseCoseKey(ac.publicKeyBytes) catch e {
    panic("publicKeyBytes: ${e.message()}")
  }
  assert(coseAlg(again) == -7, "reparsed alg")
}

test "authenticator data: 4 of 4 published vectors" {
  let sign = waAd(vecChromeSign())
  assert(sign.up && !sign.uv && !sign.be && !sign.bs, "sign flags")
  assert(sign.signCount == 59, "sign count ${sign.signCount}")
  assert(
    !isSome(sign.attested) && !isSome(sign.extensions),
    "sign has no attested data or extensions",
  )
  checkRpIdHash(sign, "acme.com") catch e {
    panic("sign rpIdHash: ${e.message()}")
  }
  let make = waAd(vecChromeMake())
  assert(
    make.up && make.signCount == 11 && credLen(make) == 16,
    "make: count ${make.signCount} id ${credLen(make)}",
  )
  let get = waAd(vecChromeGet())
  assert(get.up && get.signCount == 17 && !isSome(get.attested), "get: count ${get.signCount}")
  let a187 = waAd(vecAd187())
  assert(a187.up && a187.uv && a187.signCount == 1553097241, "ad187: count ${a187.signCount}")
  assert(len(a187.raw) == 187, "raw ${len(a187.raw)}")
  checkRpIdHash(a187, "webauthn.io") catch e {
    panic("ad187 rpIdHash: ${e.message()}")
  }
}

class CdRow {
  name: string,
  hex: string,
  kind: string,
  origin: string,
  challengeLen: int,
}

fn cdRows(): []CdRow {
  return []CdRow{
    CdRow{
      name = "go-webauthn 117",
      hex = vecCd117(),
      kind = "webauthn.create",
      origin = "http://localhost:9005",
      challengeLen = 32,
    },
    CdRow{
      name = "go-webauthn 115",
      hex = vecCd115a(),
      kind = "webauthn.create",
      origin = "https://webauthn.io",
      challengeLen = 32,
    },
    CdRow{
      name = "go-webauthn 184 crossOrigin false and an unknown member",
      hex = vecCd184(),
      kind = "webauthn.create",
      origin = "https://gramthanos.github.io",
      challengeLen = 16,
    },
    CdRow{
      name = "go-webauthn 98",
      hex = vecCd98(),
      kind = "webauthn.create",
      origin = "https://localhost:44329",
      challengeLen = 16,
    },
    CdRow{
      name = "go-webauthn 148",
      hex = vecCd148(),
      kind = "webauthn.create",
      origin = "https://webauthn.firstyear.id.au",
      challengeLen = 32,
    },
    CdRow{
      name = "go-webauthn 210 nested clientExtensions",
      hex = vecCd210(),
      kind = "webauthn.create",
      origin = "https://localhost:44329",
      challengeLen = 64,
    },
    CdRow{
      name = "go-webauthn 234 whitespace and tokenBinding",
      hex = vecCd234(),
      kind = "webauthn.create",
      origin = "https://localhost:44329",
      challengeLen = 64,
    },
    CdRow{
      name = "go-webauthn 219 get",
      hex = vecCd219(),
      kind = "webauthn.get",
      origin = "https://webauthn.io",
      challengeLen = 32,
    },
    CdRow{
      name = "chromium",
      hex = encodeHex([]byte(vecChromeCdText())),
      kind = "webauthn.create",
      origin = "https://google.com",
      challengeLen = 4,
    },
  }
}

fn vecChromeCdText(): string {
  return string(waHex(vecChromeCd()))
}

test "clientDataJSON: 9 of 9 published vectors parse" {
  let rows = cdRows()
  assert(len(rows) == 9, "rows ${len(rows)}")
  let i = 0
  while (i < len(rows)) {
    let r = rows[i]
    let cd = waCd(r.hex)
    assert(cd.kind == r.kind, "${r.name}: type ${cd.kind}")
    assert(cd.origin == r.origin, "${r.name}: origin ${cd.origin}")
    assert(len(cd.challenge) == r.challengeLen, "${r.name}: challenge ${len(cd.challenge)} bytes")
    assert(!cd.crossOrigin && !isSome(cd.topOrigin), "${r.name}: cross-origin")
    i = i + 1
  }
}

// ---------------------------------------------------------------------------
// clientData rejections and checks
// ---------------------------------------------------------------------------

const goodChallenge = "AAECAwQFBgcICQoLDA0ODw"

fn cdJson(kind: string, extra: string): string {
  return "{\"type\":\"${kind}\",\"challenge\":\"${goodChallenge}\",\"origin\":\"https://example.com\"${extra}}"
}

fn cdJsonChallenge(challenge: string): string {
  return "{\"type\":\"webauthn.create\",\"challenge\":\"${challenge}\",\"origin\":\"https://example.com\"}"
}

fn goodChallengeBytes(): []byte {
  return waHex("000102030405060708090a0b0c0d0e0f")
}

fn checkErr(
  cd: ClientData,
  expectType: string,
  challenge: []byte,
  origins: []string,
  tops: []string,
): string {
  checkClientData(cd, expectType, challenge, origins, tops) catch e {
    return e.message()
  }
  panic("checkClientData accepted ${cd.origin}")
}

test "clientData: 6 required rejections plus 7 more" {
  let json = cdJson("webauthn.create", "")
  let cd = parseClientData([]byte(json)) catch e {
    panic("parse: ${e.message()}")
  }
  assert(ctEq(cd.challenge, goodChallengeBytes()), "challenge decoded")
  let origins = []string{ "https://example.com" }
  let none = []string{}
  checkClientData(cd, "webauthn.create", goodChallengeBytes(), origins, none) catch e {
    panic("valid client data rejected: ${e.message()}")
  }
  // 1: wrong type.
  let m1 = checkErr(cd, "webauthn.get", goodChallengeBytes(), origins, none)
  assert(contains(m1, "type"), "type: ${m1}")
  // 2: challenge mismatch, of equal length and of different length.
  let other = waHex("000102030405060708090a0b0c0d0e0e")
  assert(
    contains(checkErr(cd, "webauthn.create", other, origins, none), "challenge"),
    "challenge mismatch",
  )
  assert(
    contains(checkErr(cd, "webauthn.create", other[0:15], origins, none), "challenge"),
    "challenge length",
  )
  // 3: origin not in the list, and no wildcard or prefix match.
  let m3 = checkErr(
    cd,
    "webauthn.create",
    goodChallengeBytes(),
    []string{ "https://example.org", "https://*.example.com", "https://example.com:8443" },
    none,
  )
  assert(contains(m3, "not an allowed origin"), "origin: ${m3}")
  // 4: a cross-origin ceremony whose topOrigin is not listed, and one with none at all.
  let cross = parseClientData(
    []byte(cdJson("webauthn.create", ",\"crossOrigin\":true,\"topOrigin\":\"https://top.example\"")),
  ) catch e {
    panic("cross parse: ${e.message()}")
  }
  assert(cross.crossOrigin && isSome(cross.topOrigin), "cross-origin parsed")
  let m4 = checkErr(
    cross,
    "webauthn.create",
    goodChallengeBytes(),
    origins,
    []string{ "https://other.example" },
  )
  assert(contains(m4, "topOrigin"), "topOrigin: ${m4}")
  assert(
    contains(checkErr(cross, "webauthn.create", goodChallengeBytes(), origins, none), "topOrigin"),
    "no allowed top origins",
  )
  checkClientData(
    cross,
    "webauthn.create",
    goodChallengeBytes(),
    origins,
    []string{ "https://top.example" },
  ) catch e {
    panic("listed topOrigin rejected: ${e.message()}")
  }
  let crossNoTop = parseClientData([]byte(cdJson("webauthn.create", ",\"crossOrigin\":true"))) catch e {
    panic("crossNoTop parse: ${e.message()}")
  }
  assert(
    contains(
      checkErr(
        crossNoTop,
        "webauthn.create",
        goodChallengeBytes(),
        origins,
        []string{ "https://top.example" },
      ),
      "topOrigin",
    ),
    "cross-origin with no topOrigin",
  )
  // 5: duplicate keys.
  let m5 = cdError("{\"type\":\"webauthn.create\",\"type\":\"webauthn.get\",\"challenge\":\"${goodChallenge}\",\"origin\":\"https://example.com\"}")
  assert(contains(m5, "repeats the key 'type'"), "duplicate: ${m5}")
  // 6: invalid base64url, in three shapes.
  assert(contains(cdError(cdJsonChallenge("AAEC+wQF")), "base64url"), "plus sign")
  assert(contains(cdError(cdJsonChallenge("AAECAwQFBgcICQoLDA0ODw==")), "base64url"), "padding")
  assert(contains(cdError(cdJsonChallenge("A")), "base64url"), "one character")
  // Beyond the six: shapes.
  assert(contains(cdError("not json"), "not JSON"), "not json")
  assert(contains(cdError("[1]"), "not a JSON object"), "array")
  assert(contains(cdError("{\"type\":\"webauthn.create\"}"), "no 'challenge'"), "missing challenge")
  assert(
    contains(cdError(cdJson("webauthn.create", ",\"crossOrigin\":\"yes\"")), "crossOrigin"),
    "crossOrigin type",
  )
  assert(
    contains(
      cdError(cdJson("webauthn.create", ",\"topOrigin\":\"https://top.example\"")),
      "'crossOrigin' is not true",
    ),
    "topOrigin alone",
  )
  assert(contains(cdError(""), "want 1 to"), "empty")
  assert(
    contains(checkErr(cd, "webauthn.create", []byte(0), origins, none), "no challenge was issued"),
    "empty issued challenge",
  )
}
