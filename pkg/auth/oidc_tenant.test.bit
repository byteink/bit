// pkg/auth/oidc_tenant.test.bit — #5810's acceptance: `verifyIdToken` over a
// multi-tenant `OidcConfig` (Microsoft Entra's `common`, `organizations` and
// `consumers`, providers.bit) accepts a signed token whose `iss` is the
// issuer template with the token's own `tid` substituted, and rejects a
// tid/iss mismatch, a non-GUID `tid`, a missing `tid`, and a `tid` outside
// `OidcConfig.allowedTenants`. A single-tenant config stays an exact match.
//
// Every token is signed for real (`signIdToken`, oidc_verify.test.bit, HS256
// under that file's test JWKS); only the claims differ. `fixedNow`,
// `clientId`, `testKid`, `testNonce`, `newCache`, `defaultOpts`,
// `signIdToken`, `verifyIdTokenErrorMsg`, `OidcConfig`, `Json`, `JsonEntry`
// are already bound module-wide (SPEC §17.1); re-importing any is E0042.

const orgTenant = "72f988bf-86f1-41af-91ab-2d7cd011db47"
const otherTenant = "11111111-2222-3333-4444-555555555555"
const msaTenantId = "9188040d-6c67-4c5b-b112-36a304b66dad"

fn issuerOf(tid: string): string {
  return "https://login.microsoftonline.com/${tid}/v2.0"
}

// What `Provider.Microsoft("common" or "organizations")` discovers into, with
// `allowed` as the application's tenant allow-list.
fn templateConfig(allowed: []string): OidcConfig {
  return OidcConfig{
    issuer = "https://login.microsoftonline.com/{tenantid}/v2.0",
    authorizationEndpoint = "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
    tokenEndpoint = "https://login.microsoftonline.com/common/oauth2/v2.0/token",
    jwksUri = testJwksUri,
    multiTenant = true,
    allowedTenants = allowed,
  }
}

// What `Provider.Microsoft("consumers")` discovers into: a fixed issuer, the
// MSA tenant's.
fn consumersConfig(): OidcConfig {
  return OidcConfig{
    issuer = issuerOf(msaTenantId),
    authorizationEndpoint = "https://login.microsoftonline.com/consumers/oauth2/v2.0/authorize",
    tokenEndpoint = "https://login.microsoftonline.com/consumers/oauth2/v2.0/token",
    jwksUri = testJwksUri,
    multiTenant = false,
    allowedTenants = []string{},
  }
}

// A token over the standard claims plus `iss` and, when `tid` is `Some`, a
// `tid` claim.
fn tenantToken(iss: string, tid: Option<Json>): string {
  let entries = []JsonEntry{
    JsonEntry{ key = "iss", value = Json.JsonString(iss) },
    JsonEntry{ key = "aud", value = Json.JsonString(clientId) },
    JsonEntry{ key = "sub", value = Json.JsonString("user-1") },
    JsonEntry{ key = "exp", value = Json.JsonInt(i64(fixedNow + 3600)) },
    JsonEntry{ key = "iat", value = Json.JsonInt(i64(fixedNow - 10)) },
    JsonEntry{ key = "nonce", value = Json.JsonString(testNonce) },
  }
  if (isSome(tid)) {
    entries = append(entries, JsonEntry{ key = "tid", value = unwrap(tid) })
  }
  return signIdToken(testKid, Json.JsonObject(entries))
}

fn tidToken(tid: string): string {
  return tenantToken(issuerOf(tid), Option.Some(Json.JsonString(tid)))
}

fn verifyErr(token: string, config: OidcConfig): string {
  return verifyIdTokenErrorMsg(token, config, newCache(), testNonce, defaultOpts())
}

fn assertAccepts(token: string, config: OidcConfig, what: string) {
  let msg = verifyErr(token, config)
  assert(msg == "", "${what}: want accepted, got '${msg}'")
}

fn assertRejects(token: string, config: OidcConfig, what: string, want: string) {
  let msg = verifyErr(token, config)
  assert(msg != "", "${what}: was accepted")
  assert(contains(msg, want), "${what}: want '${want}', got '${msg}'")
}

test "common/organizations: a token whose iss is the template with its own tid verifies, any tenant" {
  assertAccepts(tidToken(orgTenant), templateConfig([]string{}), "common, org tenant")
  assertAccepts(tidToken(otherTenant), templateConfig([]string{}), "organizations, other tenant")
}

test "common: a personal-account (MSA) tid verifies against the same template" {
  assertAccepts(tidToken(msaTenantId), templateConfig([]string{}), "common, MSA tenant")
}

test "consumers: a token with the MSA tenant's issuer verifies against the fixed config" {
  assertAccepts(tidToken(msaTenantId), consumersConfig(), "consumers")
}

test "consumers: an organizational tenant's token is rejected, the issuer is pinned" {
  assertRejects(tidToken(orgTenant), consumersConfig(), "consumers, org token", "issuer")
}

test "a tid that disagrees with the token's iss is rejected" {
  let token = tenantToken(issuerOf(orgTenant), Option.Some(Json.JsonString(otherTenant)))
  assertRejects(token, templateConfig([]string{}), "tid/iss mismatch", "does not match its tid")
}

test "an iss that is the unsubstituted template is rejected" {
  let token = tenantToken(
    "https://login.microsoftonline.com/{tenantid}/v2.0",
    Option.Some(Json.JsonString(orgTenant)),
  )
  assertRejects(token, templateConfig([]string{}), "literal template iss", "does not match its tid")
}

test "an iss that merely extends the substituted issuer is rejected, never a prefix match" {
  let token = tenantToken(
    issuerOf(orgTenant) + "/extra",
    Option.Some(Json.JsonString(orgTenant)),
  )
  assertRejects(token, templateConfig([]string{}), "extended iss", "does not match its tid")
}

test "a non-GUID tid is rejected before any issuer is built from it" {
  let bad = [
    "contoso.onmicrosoft.com",
    "72f988bf-86f1-41af-91ab-2d7cd011db4",
    "72f988bf-86f1-41af-91ab-2d7cd011db47x",
    "72f988bf186f1-41af-91ab-2d7cd011db47",
    "72f988bf-86f1-41af-91ab-2d7cd011dbzz",
    "../evil",
    "",
  ]
  for tid of bad {
    let token = tenantToken(issuerOf(tid), Option.Some(Json.JsonString(tid)))
    assertRejects(token, templateConfig([]string{}), "tid '${tid}'", "not a GUID")
  }
}

test "a missing or non-string tid is rejected" {
  assertRejects(
    tenantToken(issuerOf(orgTenant), Option.None),
    templateConfig([]string{}),
    "no tid",
    "missing 'tid'",
  )
  let token = tenantToken(issuerOf(orgTenant), Option.Some(Json.JsonInt(i64(7))))
  assertRejects(token, templateConfig([]string{}), "numeric tid", "not a string")
}

test "allowedTenants: a tid in the list verifies, case-insensitively" {
  let allowed = []string{ otherTenant, "72F988BF-86F1-41AF-91AB-2D7CD011DB47" }
  assertAccepts(tidToken(orgTenant), templateConfig(allowed), "allowlist hit, upper-case entry")
  assertAccepts(tidToken(otherTenant), templateConfig(allowed), "allowlist hit")
}

test "allowedTenants: a tid outside the list is rejected even with a matching iss" {
  let allowed = []string{ otherTenant }
  assertRejects(
    tidToken(orgTenant),
    templateConfig(allowed),
    "allowlist miss",
    "not in the allowed tenants",
  )
}

test "a template config without the placeholder fails closed" {
  let cfg = templateConfig([]string{})
  cfg.issuer = "https://login.microsoftonline.com/common/v2.0"
  assertRejects(tidToken(orgTenant), cfg, "no placeholder", "placeholder")
}

test "a single-tenant config stays an exact match: the template and a tid-substituted iss are both rejected" {
  let fixed = OidcConfig{
    issuer = issuerOf(orgTenant),
    authorizationEndpoint = issuerOf(orgTenant) + "/authorize",
    tokenEndpoint = issuerOf(orgTenant) + "/token",
    jwksUri = testJwksUri,
    multiTenant = false,
    allowedTenants = []string{},
  }
  assertAccepts(tidToken(orgTenant), fixed, "single tenant, own issuer")
  assertRejects(tidToken(otherTenant), fixed, "single tenant, other tenant's token", "issuer")
  fixed.allowedTenants = []string{ otherTenant }
  assertRejects(tidToken(otherTenant), fixed, "allowlist ignored on a fixed config", "issuer")
}

test "isGuid: canonical 8-4-4-4-12 hex only" {
  assert(isGuid(orgTenant) && isGuid("72F988BF-86F1-41AF-91AB-2D7CD011DB47"), "valid GUIDs refused")
  assert(!isGuid("") && !isGuid("not-a-guid") && !isGuid(orgTenant + "0"), "invalid GUIDs accepted")
}
