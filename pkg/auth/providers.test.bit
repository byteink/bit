// pkg/auth/providers.test.bit — #5774's acceptance: each preset builds an
// `OidcStrategy` with the expected issuer URL, proven via a STUBBED
// `discover()` and never a live network call.
//
// `googleStrategy`/`microsoftStrategy`/`genericOidcStrategy` all end in
// `newOidcStrategy(issuer, ...)` (oidc_authorize.bit), which calls
// `discover(issuer, tls)` with NO fetch seam of its own — `oidc_authorize.
// test.bit`'s own `testStrategy()` hand-builds an `OidcStrategy{...}` for
// the identical reason, rather than calling `newOidcStrategy()`. This file
// follows the same shape: it exercises the ISSUER each preset builds
// (`googleIssuer()`/`microsoftIssuer()`, module-private in `providers.bit`)
// against `discoverFetch` (`oidc_discovery.bit`'s test seam, already bound
// module-wide by `oidc_discovery.test.bit`) with a canned discovery
// document, which is exactly what `discover()` would do against the real
// endpoint with no network access anywhere in this file.
//
// `discoverFetch`, `tlsStub`, `oneCallFetch`, `OidcConfig` are already
// bound module-wide by `oidc_discovery.bit`/`oidc_discovery.test.bit` (an
// import binds per MODULE, SPEC §17.1); re-importing any of them here is
// E0042.

fn docWithIssuer(issuer: string): string {
  return "{\"issuer\":\"" +
    issuer +
    "\"," +
    "\"authorization_endpoint\":\"" +
    issuer +
    "/authorize\"," +
    "\"token_endpoint\":\"" +
    issuer +
    "/token\"," +
    "\"jwks_uri\":\"" +
    issuer +
    "/jwks\"}"
}

// Runs `discoverFetch` against a document whose own `issuer` matches
// `issuer`, exactly the shape a real provider's discovery endpoint would
// answer with. Panics (rather than failing the assertion silently) if
// `discover()` itself would reject the issuer a preset built.
fn discoveredIssuer(issuer: string): string {
  let cfg = discoverFetch(issuer, tlsStub(), oneCallFetch(200, docWithIssuer(issuer))) catch e {
    panic("discoverFetch(${issuer}): ${e.message()}")
  }
  return cfg.issuer
}

test "googleStrategy: issuer is Google's fixed OIDC issuer, accepted by discover()" {
  let issuer = googleIssuer()
  assert(
    issuer == "https://accounts.google.com",
    "want Google's documented issuer, got '${issuer}'",
  )
  assert(
    discoveredIssuer(issuer) == "https://accounts.google.com",
    "discover() must accept the issuer googleStrategy builds",
  )
}

test "microsoftStrategy: a single real tenant builds the per-tenant v2.0 issuer, accepted by discover()" {
  let tenant = "9188040d-6c67-4c5b-b112-36a304b66dad"
  let issuer = microsoftIssuer(tenant) catch e {
    panic("microsoftIssuer(${tenant}): ${e.message()}")
  }
  assert(
    issuer == "https://login.microsoftonline.com/${tenant}/v2.0",
    "want the tenant-scoped v2.0 issuer, got '${issuer}'",
  )
  assert(
    discoveredIssuer(issuer) == issuer,
    "discover() must accept a single-tenant issuer byte-for-byte (OIDC Discovery 1.0 4.3)",
  )
}

test "microsoftStrategy: a verified-domain tenant builds the per-tenant v2.0 issuer" {
  let tenant = "contoso.onmicrosoft.com"
  let issuer = microsoftIssuer(tenant) catch e {
    panic("microsoftIssuer(${tenant}): ${e.message()}")
  }
  assert(
    issuer == "https://login.microsoftonline.com/contoso.onmicrosoft.com/v2.0",
    "want the domain-scoped v2.0 issuer, got '${issuer}'",
  )
}

// `common`/`organizations`/`consumers` all serve a discovery document
// `discover()`'s byte-for-byte issuer check can never accept — see
// providers.bit's file header and #5810. Case-insensitive: Microsoft treats
// the tenant path segment as case-insensitive.
test "microsoftStrategy: common/organizations/consumers tenants are refused, case-insensitively" {
  let aliases = ["common", "Common", "ORGANIZATIONS", "consumers"]
  let i = 0
  while (i < len(aliases)) {
    microsoftIssuer(aliases[i]) catch _ {
      i = i + 1
      continue
    }
    panic("microsoftIssuer('${aliases[i]}') must be refused, discover() can never validate it")
  }
}

test "microsoftStrategy: a tenant merely containing 'common' as a substring is not refused" {
  let tenant = "commonwealth.onmicrosoft.com"
  microsoftIssuer(tenant) catch e {
    panic("microsoftIssuer(${tenant}) must not be refused: ${e.message()}")
  }
}

test "genericOidcStrategy: the issuer passes through discover() unchanged, with no transformation" {
  let issuer = "https://idp.example.com/tenant42"
  assert(
    discoveredIssuer(issuer) == issuer,
    "genericOidcStrategy must not alter the issuer it is given",
  )
}
