// pkg/auth/providers.test.bit — #5774's acceptance, as reshaped by #6921:
// each `Provider` variant builds an `OidcStrategy` through the one
// constructor, and every construction failure (no tls, scopes without
// openid, a Microsoft multi-tenant alias) is an `Error`, never a half-built
// strategy.
//
// `Provider.Google`/`Microsoft`/`Generic` discover over TLS, so their happy
// paths run through the one constructor with `OidcOptions.discoveryFetch`
// serving the discovery document and the JWKS (#7252): no `tls`, no network.
// The issuer tests below pin the issuer each provider builds against
// `discoverFetch` (`oidc_discovery.bit`) with a canned discovery document.
//
// `discoverFetch`, `tlsStub`, `oneCallFetch`, `OidcConfig`, `testJwks`,
// `testAuthEndpoint` are already bound module-wide by `oidc_discovery.bit`/
// `oidc_discovery.test.bit`/`oidc_authorize.test.bit` (an import binds per
// MODULE, SPEC §17.1); re-importing any of them here is E0042.

fn docWithIssuer(issuer: string): string {
  return "{\"issuer\":\"" +
    issuer +
    "\"," +
    "\"authorization_endpoint\":\"" +
    issuer +
    "/authorize\"," +
    "\"token_endpoint\":\"" +
    issuer +
    "/token\"," +
    "\"jwks_uri\":\"" +
    issuer +
    "/jwks\"}"
}

// Runs `discoverFetch` against a document whose own `issuer` matches
// `issuer`, exactly the shape a real provider's discovery endpoint would
// answer with. Panics (rather than failing the assertion silently) if
// `discover()` itself would reject the issuer a preset built.
fn discoveredIssuer(issuer: string): string {
  let cfg = discoverFetch(issuer, tlsStub(), oneCallFetch(200, docWithIssuer(issuer))) catch e {
    panic("discoverFetch(${issuer}): ${e.message()}")
  }
  return cfg.issuer
}

test "Provider.Google: issuer is Google's fixed OIDC issuer, accepted by discover()" {
  let issuer = googleIssuer()
  assert(
    issuer == "https://accounts.google.com",
    "want Google's documented issuer, got '${issuer}'",
  )
  assert(
    discoveredIssuer(issuer) == "https://accounts.google.com",
    "discover() must accept the issuer Provider.Google builds",
  )
}

test "Provider.Microsoft: a single real tenant builds the per-tenant v2.0 issuer, accepted by discover()" {
  let tenant = "9188040d-6c67-4c5b-b112-36a304b66dad"
  let issuer = microsoftIssuer(tenant)
  assert(
    issuer == "https://login.microsoftonline.com/${tenant}/v2.0",
    "want the tenant-scoped v2.0 issuer, got '${issuer}'",
  )
  assert(
    discoveredIssuer(issuer) == issuer,
    "discover() must accept a single-tenant issuer byte-for-byte (OIDC Discovery 1.0 4.3)",
  )
}

test "Provider.Microsoft: a verified-domain tenant builds the per-tenant v2.0 issuer" {
  let tenant = "contoso.onmicrosoft.com"
  let issuer = microsoftIssuer(tenant)
  assert(
    issuer == "https://login.microsoftonline.com/contoso.onmicrosoft.com/v2.0",
    "want the domain-scoped v2.0 issuer, got '${issuer}'",
  )
}

const msaTenant = "9188040d-6c67-4c5b-b112-36a304b66dad"
const contosoTenant = "72f988bf-86f1-41af-91ab-2d7cd011db47"

// The URL `microsoftDiscover` fetched from, recorded by `urlFetch`.
class UrlBox {
  url: string,
}

// An `HttpFetch` answering `body` and recording the URL it was asked for.
fn urlFetch(box: UrlBox, body: string): HttpFetch {
  let f: HttpFetch = (url) => {
    box.url = url
    return body
  }
  return f
}

fn msTemplate(): string {
  return "https://login.microsoftonline.com/{tenantid}/v2.0"
}

// `microsoftDiscover(tenant, allowed)` over a document `body`, recording the
// URL fetched in `box`.
fn msDiscover(tenant: string, allowed: []string, body: string, box: UrlBox): OidcConfig! {
  return microsoftDiscover(tenant, allowed, tlsStub(), urlFetch(box, body))?
}

fn msDiscoverErr(tenant: string, body: string): string {
  msDiscover(tenant, []string{}, body, UrlBox{ url = "" }) catch e {
    return e.message()
  }
  return ""
}

// `common` and `organizations` serve the literal `{tenantid}` template as
// their issuer (verified 2026-09-24, providers.bit's file header); the
// config keeps it as the template, flagged multi-tenant, fetched from the
// lowercase alias URL however the caller spelled it.
test "Provider.Microsoft: common/organizations discover into a multi-tenant config holding the template" {
  let aliases = ["common", "Common", "organizations", "ORGANIZATIONS"]
  for tenant of aliases {
    let box = UrlBox{ url = "" }
    let cfg = msDiscover(tenant, []string{ contosoTenant }, docWithIssuer(msTemplate()), box) catch e {
      panic("microsoftDiscover(${tenant}): ${e.message()}")
    }
    assert(cfg.multiTenant, "${tenant}: want a multi-tenant config")
    assert(cfg.issuer == msTemplate(), "${tenant}: want the template issuer, got '${cfg.issuer}'")
    assert(
      len(cfg.allowedTenants) == 1 && cfg.allowedTenants[0] == contosoTenant,
      "${tenant}: want allowedTenants carried onto the config",
    )
    let want = "https://login.microsoftonline.com/" +
      toLower(tenant) +
      "/v2.0/.well-known/openid-configuration"
    assert(box.url == want, "${tenant}: fetched '${box.url}', want '${want}'")
  }
}

test "Provider.Microsoft: common/organizations still reject a document naming any other issuer" {
  let msg = msDiscoverErr(
    "common",
    docWithIssuer("https://login.microsoftonline.com/${msaTenant}/v2.0"),
  )
  assert(contains(msg, "issuer mismatch"), "want an issuer mismatch, got '${msg}'")
  let msg2 = msDiscoverErr("organizations", docWithIssuer("https://evil.example.com"))
  assert(contains(msg2, "issuer mismatch"), "want an issuer mismatch, got '${msg2}'")
}

// `consumers` serves the personal-account tenant's own issuer; the config is
// an ordinary fixed-issuer one pinned to it.
test "Provider.Microsoft: consumers discovers into a fixed-issuer config pinned to the MSA tenant" {
  let box = UrlBox{ url = "" }
  let issuer = "https://login.microsoftonline.com/${msaTenant}/v2.0"
  let cfg = msDiscover("consumers", []string{}, docWithIssuer(issuer), box) catch e {
    panic("microsoftDiscover(consumers): ${e.message()}")
  }
  assert(!cfg.multiTenant, "consumers: want a fixed-issuer config")
  assert(cfg.issuer == issuer, "consumers: want the MSA issuer, got '${cfg.issuer}'")
  assert(
    box.url == "https://login.microsoftonline.com/consumers/v2.0/.well-known/openid-configuration",
    "consumers: fetched '${box.url}'",
  )
}

test "Provider.Microsoft: consumers rejects a document naming a different tenant" {
  let msg = msDiscoverErr(
    "consumers",
    docWithIssuer("https://login.microsoftonline.com/${contosoTenant}/v2.0"),
  )
  assert(contains(msg, "issuer mismatch"), "want an issuer mismatch, got '${msg}'")
}

test "Provider.Microsoft: a single tenant keeps the exact-match path, no multi-tenant flag" {
  let issuer = microsoftIssuer(contosoTenant)
  let cfg = msDiscover(contosoTenant, []string{}, docWithIssuer(issuer), UrlBox{ url = "" }) catch e {
    panic("microsoftDiscover(single): ${e.message()}")
  }
  assert(!cfg.multiTenant && cfg.issuer == issuer, "single tenant must stay fixed-issuer")
  let msg = msDiscoverErr(contosoTenant, docWithIssuer(msTemplate()))
  assert(contains(msg, "issuer mismatch"), "single tenant must reject the template, got '${msg}'")
}

test "Provider.Generic: the issuer passes through discover() unchanged, with no transformation" {
  let issuer = "https://idp.example.com/tenant42"
  assert(
    discoveredIssuer(issuer) == issuer,
    "Provider.Generic must not alter the issuer it is given",
  )
}

fn endpointsProvider(): Provider {
  return Provider.Endpoints(
    OidcConfig{
      issuer = "https://idp.example.com",
      authorizationEndpoint = testAuthEndpoint,
      tokenEndpoint = "https://idp.example.com/token",
      jwksUri = "https://idp.example.com/jwks",
    },
    testJwks(),
  )
}

fn withTls(): OidcOptions {
  return OidcOptions{ tls = Option.Some(tlsStub()) }
}

// The constructor's failure message, or a panic when it built a strategy.
fn constructionError(provider: Provider, opts: OidcOptions): string {
  OidcStrategy(provider, "client", "secret", "https://app.example.com/callback", opts) catch e {
    return e.message()
  }
  panic("OidcStrategy(...) must fail, it built a strategy")
}

// Serves `docWithIssuer(issuer)` at `issuer`'s discovery URL and an empty key
// set at its `/jwks`, and fails on any other URL.
fn discoveryFetchFor(issuer: string): HttpFetch {
  let f: HttpFetch = (url) => {
    if (url == issuer + "/.well-known/openid-configuration") {
      return docWithIssuer(issuer)
    }
    if (url == issuer + "/jwks") {
      return "{\"keys\":[]}"
    }
    fail newError("unexpected GET ${url}")
  }
  return f
}

fn discovered(provider: Provider, issuer: string): OidcStrategy {
  let opts = OidcOptions{ discoveryFetch = discoveryFetchFor(issuer) }
  return OidcStrategy(provider, "client", "secret", "https://app.example.com/callback", opts) catch e {
    panic("OidcStrategy(${issuer}): ${e.message()}")
  }
}

test "OidcOptions.discoveryFetch: Google, Generic and a single Microsoft tenant build through the constructor with no tls" {
  let google = googleIssuer()
  assert(discovered(Provider.Google, google).config.issuer == google, "Google")
  let generic = "https://idp.example.com"
  assert(
    discovered(Provider.Generic(generic), generic).config.tokenEndpoint == generic + "/token",
    "Generic",
  )
  let ms = microsoftIssuer(msaTenant)
  assert(discovered(Provider.Microsoft(msaTenant), ms).config.issuer == ms, "Microsoft")
}

test "Provider.Endpoints: builds with no network call, the config and cache as given, default scopes" {
  let s = OidcStrategy(endpointsProvider(), "client", "secret", "https://app.example.com/callback") catch e {
    panic("OidcStrategy(Endpoints): ${e.message()}")
  }
  assert(
    s.config.issuer == "https://idp.example.com",
    "want the config as given, got '${s.config.issuer}'",
  )
  assert(
    s.clientId == "client" && s.clientSecret == "secret",
    "want the credentials carried through",
  )
  assert(s.tokenFetch == nil, "want the real network (nil tokenFetch) by default")
  let got = join(s.scopes, " ")
  assert(
    got == "openid email profile",
    "want 'openid email profile' (OIDC Core 1.0 5.4), got '${got}'",
  )
}

test "OidcOptions: scopes and tokenFetch are carried onto the strategy" {
  let f: TokenFetch = (url, headers, body) => "{}"
  let opts = OidcOptions{ scopes = ["openid", "email"], tokenFetch = f }
  let s = OidcStrategy(
    endpointsProvider(),
    "client",
    "secret",
    "https://app.example.com/callback",
    opts,
  ) catch e {
    panic("OidcStrategy(Endpoints, opts): ${e.message()}")
  }
  assert(
    join(s.scopes, " ") == "openid email",
    "want the given scopes, got '${join(s.scopes, " ")}'",
  )
  assert(s.tokenFetch != nil, "want the given tokenFetch")
}

test "OidcStrategy: Provider.Google, Microsoft and Generic without opts.tls fail naming the option" {
  let providers = [
    Provider.Google,
    Provider.Microsoft("9188040d-6c67-4c5b-b112-36a304b66dad"),
    Provider.Generic("https://idp.example.com"),
  ]
  for p of providers {
    let msg = constructionError(p, OidcOptions{})
    assert(contains(msg, "OidcOptions.tls"), "want an OidcOptions.tls complaint, got '${msg}'")
  }
}

test "OidcStrategy: scopes without openid fail, on every provider variant (OIDC Core 1.0 3.1.2.1)" {
  let opts = OidcOptions{ scopes = ["email", "profile"], tls = Option.Some(tlsStub()) }
  let providers = [
    Provider.Google,
    Provider.Generic("https://idp.example.com"),
    endpointsProvider(),
  ]
  for p of providers {
    let msg = constructionError(p, opts)
    assert(contains(msg, "openid"), "want an openid complaint, got '${msg}'")
  }
}

// #6979: the field default carries the standard scopes, so an explicit empty
// list is a list without `openid`, not a request for the default.
test "OidcStrategy: an explicit empty scopes list is refused like any list without openid" {
  let opts = OidcOptions{ scopes = []string(0), tls = Option.Some(tlsStub()) }
  let msg = constructionError(Provider.Generic("https://idp.example.com"), opts)
  assert(contains(msg, "openid"), "want an openid complaint, got '${msg}'")
}

// `allowedTenants` only means something for the two many-tenant aliases;
// anywhere else it would silently restrict nothing, so it fails (#5810).
test "OidcStrategy: allowedTenants is refused on every provider but Microsoft common/organizations" {
  let opts = OidcOptions{ tls = Option.Some(tlsStub()), allowedTenants = [contosoTenant] }
  let providers = [
    Provider.Google,
    Provider.Generic("https://idp.example.com"),
    Provider.Microsoft(contosoTenant),
    Provider.Microsoft("consumers"),
    endpointsProvider(),
  ]
  for p of providers {
    let msg = constructionError(p, opts)
    assert(contains(msg, "allowedTenants"), "want an allowedTenants complaint, got '${msg}'")
  }
}

test "OidcStrategy: an allowedTenants entry that is not a GUID is refused for common/organizations" {
  let opts = OidcOptions{
    tls = Option.Some(tlsStub()),
    allowedTenants = [contosoTenant, "contoso.com"],
  }
  let msg = constructionError(Provider.Microsoft("common"), opts)
  assert(
    contains(msg, "contoso.com") && contains(msg, "GUID"),
    "want a GUID complaint, got '${msg}'",
  )
}

test "checkAllowedTenants: common/organizations accept GUID entries, empty is always fine" {
  checkAllowedTenants(Provider.Microsoft("Common"), [contosoTenant, msaTenant]) catch e {
    panic("checkAllowedTenants(common): ${e.message()}")
  }
  checkAllowedTenants(Provider.Microsoft("organizations"), [contosoTenant]) catch e {
    panic("checkAllowedTenants(organizations): ${e.message()}")
  }
  checkAllowedTenants(Provider.Google, []string{}) catch e {
    panic("checkAllowedTenants(empty): ${e.message()}")
  }
}

test "OidcStrategy: Provider.Generic with a non-https issuer fails in discover(), before any network call" {
  let msg = constructionError(Provider.Generic("http://idp.example.com"), withTls())
  assert(contains(msg, "https"), "want an https complaint, got '${msg}'")
}

test "OidcOptions.scopes defaults to the standard OIDC scopes, 'openid email profile' (OIDC Core 1.0 5.4)" {
  let got = join(OidcOptions{}.scopes, " ")
  assert(got == "openid email profile", "want 'openid email profile', got '${got}'")
}
