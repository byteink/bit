// pkg/auth/bearer.test.bit — #6947's acceptance: AccessTokens issue/verify
// (RFC 7519, 8725, 9068) and BearerStrategy's RFC 6750 401, on a hand-moved
// clock. Every rejection test forges its token with `sign` (std/jwt)
// under a key the verifier trusts, so only the ONE property under test is
// wrong and the verdict cannot come from a bad signature by accident.
//
// The RS256 key is the std/crypto known-answer key std/jwt's own tests use
// (`stdlib/jwt/jwt.test.bit`). `decodeHex`, `contains` and the std/jwt and
// std/json names bearer.bit and the other files bind are module-wide
// (SPEC section 17.1); only names new to the module are imported here.
import { RsaPrivateKey, decodeHex, rsaParsePrivateKey, rsaParsePublicKey } from "std/crypto"

const issuerName = "https://auth.example.com"
const audienceName = "https://api.example.com"

fn rsaPrivDerHex(): string {
  return ""
}

fn rsaPubDerHex(): string {
  return ""
}

class BtClock {
  t: i64,
}

fn btSecret(tag: string): []byte {
  return []byte("bearer-test-secret-${tag}-32-bytes!!")
}

fn hsKeySet(): KeySet {
  return KeySet{
    signing = SigningKey.Hs256Key(btSecret("one")),
    signingKid = "k1",
    verify = []Jwk{ Jwk{ kid = "k1", key = VerifyKey.Hs256Key(btSecret("one")) } },
  }
}

fn hsOptions(clock: BtClock): TokenOptions {
  let read: () => i64 = () => clock.t
  return TokenOptions{
    issuer = issuerName,
    audience = audienceName,
    algorithm = "HS256",
    clock = read,
  }
}

fn btTokens(keys: KeySet, opts: TokenOptions): AccessTokens {
  return AccessTokens(keys, opts) catch e {
    panic("AccessTokens: ${e.message()}")
  }
}

fn btIssue(t: AccessTokens, subject: string): string {
  return t.issue(subject) catch e {
    panic("issue: ${e.message()}")
  }
}

// `AccessTokens(keys, opts)`'s failure message, or "" when it was built.
fn buildError(keys: KeySet, opts: TokenOptions): string {
  AccessTokens(keys, opts) catch e {
    return e.message()
  }
  return ""
}

// `verify`'s failure message (the log-only reason), or "" when it accepted.
fn reasonOf(t: AccessTokens, token: string): string {
  t.verify(token) catch e {
    return e.message()
  }
  return ""
}

fn num(n: i64): Json {
  return Json.JsonInt(n)
}

fn str(s: string): Json {
  return Json.JsonString(s)
}

// A payload `verify` accepts at time `now`, as an entry list so a test can
// replace one member.
fn goodMembers(now: i64): []JsonEntry {
  return []JsonEntry{
    JsonEntry{ key = "iss", value = str(issuerName) },
    JsonEntry{ key = "sub", value = str("u1") },
    JsonEntry{ key = "aud", value = str(audienceName) },
    JsonEntry{ key = "iat", value = num(now) },
    JsonEntry{ key = "exp", value = num(now + 900) },
    JsonEntry{ key = "jti", value = str("j1") },
  }
}

fn replaceMember(members: []JsonEntry, key: string, value: Json): []JsonEntry {
  let out = []JsonEntry(0)
  for m of members {
    if (m.key == key) {
      out = append(out, JsonEntry{ key = key, value = value })
    } else {
      out = append(out, m)
    }
  }
  return out
}

fn withoutMember(members: []JsonEntry, key: string): []JsonEntry {
  let out = []JsonEntry(0)
  for m of members {
    if (m.key != key) {
      out = append(out, m)
    }
  }
  return out
}

fn forge(key: SigningKey, typ: string, kid: string, members: []JsonEntry): string {
  return sign(key, Json.JsonObject(members), typ = typ, kid = kid) catch e {
    panic("sign: ${e.message()}")
  }
}

fn hsForge(typ: string, kid: string, members: []JsonEntry): string {
  return forge(SigningKey.Hs256Key(btSecret("one")), typ, kid, members)
}

// A compact token whose header says `alg: none`, with a non-empty signature
// segment so it passes the structural checks and only the alg can stop it.
fn noneToken(now: i64): string {
  let header = encodeBase64Url([]byte("{\"alg\":\"none\",\"typ\":\"at+jwt\",\"kid\":\"k1\"}"))
  let payload = encodeBase64Url([]byte(jsonEncode(Json.JsonObject(goodMembers(now)))))
  return header + "." + payload + ".c2ln"
}

fn rsaPrivate(): RsaPrivateKey {
  let der = decodeHex(rsaPrivDerHex()) catch _ {
    panic("bad RSA fixture")
  }
  return rsaParsePrivateKey(der) catch _ {
    panic("bad RSA fixture")
  }
}

fn rsaVerifyKey(): VerifyKey {
  let der = decodeHex(rsaPubDerHex()) catch _ {
    panic("bad RSA fixture")
  }
  return VerifyKey.Rs256Key(
    rsaParsePublicKey(der) catch _ {
      panic("bad RSA fixture")
    },
  )
}

fn rsaKeySet(): KeySet {
  return KeySet{
    signing = SigningKey.Rs256Key(rsaPrivate()),
    signingKid = "r1",
    verify = []Jwk{ Jwk{ kid = "r1", key = rsaVerifyKey() } },
  }
}

fn rsaOptions(clock: BtClock): TokenOptions {
  let opts = hsOptions(clock)
  opts.algorithm = "RS256"
  return opts
}

fn headerOf(token: string): string {
  let raw = decodeBase64Url(split(token, ".")[0]) catch _ {
    return ""
  }
  return string(raw)
}

// --- issue / verify ---------------------------------------------------------

test "round trip: issue then verify returns the subject and every claim" {
  let clock = BtClock{ t = 1_000_000 }
  let t = btTokens(hsKeySet(), hsOptions(clock))
  let extra = Json.JsonObject([]JsonEntry{ JsonEntry{ key = "client_id", value = str("web") } })
  let token = t.issue("u42", extra, "read write") catch e {
    panic("issue: ${e.message()}")
  }
  let id = t.verify(token) catch e {
    panic("verify: ${e.message()}")
  }

  assert(id.id == "u42", "want id u42, got '${id.id}'")
  assert(memberString(id.claims, "iss") == issuerName, "iss lost")
  assert(memberString(id.claims, "aud") == audienceName, "aud lost")
  assert(memberString(id.claims, "scope") == "read write", "scope lost")
  assert(memberString(id.claims, "client_id") == "web", "client_id lost")
  assert(memberString(id.claims, "jti") != "", "jti missing")
  let exp = jsonAsInt(unwrap(jsonGet(id.claims, "exp")))
  assert(isSome(exp) && unwrap(exp) == 1_000_900, "default ttl must be 900s")
}

test "issue writes typ at+jwt and the signing kid into the header" {
  let t = btTokens(hsKeySet(), hsOptions(BtClock{ t = 5 }))
  let header = headerOf(btIssue(t, "u1"))

  assert(contains(header, "\"typ\":\"at+jwt\""), "header lacks typ at+jwt: ${header}")
  assert(contains(header, "\"kid\":\"k1\""), "header lacks kid k1: ${header}")
  assert(contains(header, "\"alg\":\"HS256\""), "header lacks alg HS256: ${header}")
}

test "every token carries a fresh jti" {
  let t = btTokens(hsKeySet(), hsOptions(BtClock{ t = 5 }))
  let a = t.verify(btIssue(t, "u1")) catch _ {
    panic("verify a")
  }
  let b = t.verify(btIssue(t, "u1")) catch _ {
    panic("verify b")
  }

  assert(memberString(a.claims, "jti") != memberString(b.claims, "jti"), "two tokens share a jti")
}

test "issue refuses claims that set a registered name and a non-object claims" {
  let t = btTokens(hsKeySet(), hsOptions(BtClock{ t = 5 }))
  let exp = Json.JsonObject([]JsonEntry{ JsonEntry{ key = "exp", value = num(9) } })
  let refusedExp = false
  t.issue("u1", exp) catch _ {
    refusedExp = true
  }
  let refusedArray = false
  t.issue("u1", Json.JsonArray([]Json{ str("x") })) catch _ {
    refusedArray = true
  }
  let refusedSubject = false
  t.issue("") catch _ {
    refusedSubject = true
  }

  assert(refusedExp, "claims may not set exp")
  assert(refusedArray, "claims must be an object")
  assert(refusedSubject, "an empty subject must be refused")
}

test "RS256 round trip with the typed RSA key" {
  let t = btTokens(rsaKeySet(), rsaOptions(BtClock{ t = 77 }))
  let id = t.verify(btIssue(t, "u9")) catch e {
    panic("verify: ${e.message()}")
  }

  assert(id.id == "u9", "want u9, got '${id.id}'")
}

// --- the eight rejections ---------------------------------------------------

test "reject 1/8: alg none" {
  let t = btTokens(hsKeySet(), hsOptions(BtClock{ t = 1000 }))
  let reason = reasonOf(t, noneToken(1000))

  assert(contains(reason, "pinned"), "want the pinned-alg refusal, got '${reason}'")
}

test "reject 2/8: RS256 pinned, HS256 token signed with the public key as the secret" {
  let t = btTokens(rsaKeySet(), rsaOptions(BtClock{ t = 1000 }))
  let pubDer = decodeHex(rsaPubDerHex()) catch _ {
    panic("bad RSA fixture")
  }
  let forged = forge(SigningKey.Hs256Key(pubDer), "at+jwt", "r1", goodMembers(1000))
  let reason = reasonOf(t, forged)

  assert(contains(reason, "pinned"), "want the pinned-alg refusal, got '${reason}'")
}

test "reject 3/8: unknown kid" {
  let t = btTokens(hsKeySet(), hsOptions(BtClock{ t = 1000 }))
  let reason = reasonOf(t, hsForge("at+jwt", "other", goodMembers(1000)))

  assert(contains(reason, "kid"), "want the kid refusal, got '${reason}'")
}

test "reject 4/8: wrong typ, including an ID token's JWT" {
  let t = btTokens(hsKeySet(), hsOptions(BtClock{ t = 1000 }))
  let reason = reasonOf(t, hsForge("JWT", "k1", goodMembers(1000)))

  assert(contains(reason, "typ"), "want the typ refusal, got '${reason}'")
}

test "reject 5/8: wrong iss" {
  let t = btTokens(hsKeySet(), hsOptions(BtClock{ t = 1000 }))
  let members = replaceMember(goodMembers(1000), "iss", str("https://evil.example"))
  let reason = reasonOf(t, hsForge("at+jwt", "k1", members))

  assert(contains(reason, "issuer"), "want the issuer refusal, got '${reason}'")
}

test "reject 6/8: wrong aud" {
  let t = btTokens(hsKeySet(), hsOptions(BtClock{ t = 1000 }))
  let members = replaceMember(goodMembers(1000), "aud", str("https://other.example"))
  let reason = reasonOf(t, hsForge("at+jwt", "k1", members))

  assert(contains(reason, "audience"), "want the audience refusal, got '${reason}'")
}

test "reject 7/8: expired past the skew" {
  let clock = BtClock{ t = 1000 }
  let t = btTokens(hsKeySet(), hsOptions(clock))
  let token = btIssue(t, "u1")
  clock.t = 1000 + 900 + 61
  let reason = reasonOf(t, token)

  assert(contains(reason, "expired"), "want the expiry refusal, got '${reason}'")
}

test "reject 8/8: nbf in the future past the skew" {
  let t = btTokens(hsKeySet(), hsOptions(BtClock{ t = 1000 }))
  let members = append(goodMembers(1000), JsonEntry{ key = "nbf", value = num(1000 + 61) })
  let reason = reasonOf(t, hsForge("at+jwt", "k1", members))

  assert(contains(reason, "not yet valid"), "want the not-yet-valid refusal, got '${reason}'")
}

test "a token with no exp, or no sub, or no jti is refused" {
  let t = btTokens(hsKeySet(), hsOptions(BtClock{ t = 1000 }))
  for name of []string{ "exp", "sub", "jti", "iat" } {
    let token = hsForge("at+jwt", "k1", withoutMember(goodMembers(1000), name))
    let reason = reasonOf(t, token)
    assert(contains(reason, "'${name}'"), "missing ${name}: got '${reason}'")
  }
}

test "a tampered payload is refused" {
  let t = btTokens(hsKeySet(), hsOptions(BtClock{ t = 1000 }))
  let parts = split(btIssue(t, "u1"), ".")
  let other = encodeBase64Url(
    []byte(jsonEncode(Json.JsonObject(replaceMember(goodMembers(1000), "sub", str("admin"))))),
  )

  assert(reasonOf(t, parts[0] + "." + other + "." + parts[2]) != "", "a tampered payload must fail")
}

// --- rotation and skew ------------------------------------------------------

test "rotation: a retired kid verifies while listed and fails once removed" {
  let clock = BtClock{ t = 1000 }
  let oldTokens = btTokens(hsKeySet(), hsOptions(clock))
  let token = btIssue(oldTokens, "u1")
  let k2 = SigningKey.Hs256Key(btSecret("two"))
  let both = KeySet{
    signing = k2,
    signingKid = "k2",
    verify = []Jwk{
      Jwk{ kid = "k2", key = VerifyKey.Hs256Key(btSecret("two")) },
      Jwk{ kid = "k1", key = VerifyKey.Hs256Key(btSecret("one")) },
    },
  }
  let rotated = btTokens(both, hsOptions(clock))
  let afterOnly = KeySet{
    signing = k2,
    signingKid = "k2",
    verify = []Jwk{ Jwk{ kid = "k2", key = VerifyKey.Hs256Key(btSecret("two")) } },
  }
  let removed = btTokens(afterOnly, hsOptions(clock))

  assert(reasonOf(rotated, token) == "", "a token from the retired kid must verify while listed")
  assert(reasonOf(rotated, btIssue(rotated, "u2")) == "", "the new key must verify its own tokens")
  assert(contains(reasonOf(removed, token), "kid"), "the retired kid must fail once removed")
}

test "skew: exp accepted at exactly skew, refused at skew + 1; nbf likewise" {
  let clock = BtClock{ t = 1000 }
  let t = btTokens(hsKeySet(), hsOptions(clock))
  let token = btIssue(t, "u1")
  let exp = 1000 + 900
  clock.t = exp + 60
  assert(reasonOf(t, token) == "", "exp + skew must be accepted")
  clock.t = exp + 61
  assert(reasonOf(t, token) != "", "exp + skew + 1 must be refused")

  clock.t = 1000
  let nbfToken = hsForge(
    "at+jwt",
    "k1",
    append(goodMembers(1000), JsonEntry{ key = "nbf", value = num(1060) }),
  )
  assert(reasonOf(t, nbfToken) == "", "nbf - skew must be accepted")
  let late = hsForge(
    "at+jwt",
    "k1",
    append(goodMembers(1000), JsonEntry{ key = "nbf", value = num(1061) }),
  )
  assert(reasonOf(t, late) != "", "nbf - skew - 1 must be refused")
}

// --- BearerStrategy ---------------------------------------------------------

fn bearerApp(t: AccessTokens): App {
  return bearerAppOn(t, MemoryStore(1000))
}

fn bearerAppOn(t: AccessTokens, sessions: MemoryStore): App {
  let app = App(Config{ secret = "test-secret", sessions = sessions })
  app.use(requireAuth([]Strategy{ BearerStrategy(t) }))
  app.get("/x", (c) => {
    let identity = currentIdentity(c) catch e {
      panic("currentIdentity: ${e.message()}")
    }
    return c.text(identity.id)
  })
  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  return app
}

fn bearerReq(authorization: string): Request {
  if (authorization == "") {
    return Request{ method = "GET", path = "/x", headers = "", body = "" }
  }
  return Request{
    method = "GET",
    path = "/x",
    headers = "Authorization: " + authorization,
    body = "",
  }
}

test "BearerStrategy: a valid token reaches the handler with the identity" {
  let t = btTokens(hsKeySet(), hsOptions(BtClock{ t = 1000 }))
  let res = bearerApp(t).handle(bearerReq("Bearer " + btIssue(t, "u7")))

  assert(res.status == 200, "want 200, got ${res.status}")
  assert(res.body == "u7", "want u7, got '${res.body}'")
}

test "BearerStrategy: a failed token is a 401 with the RFC 6750 header and none of the 8 reasons" {
  let t = btTokens(hsKeySet(), hsOptions(BtClock{ t = 1000 }))
  let rsa = btTokens(rsaKeySet(), rsaOptions(BtClock{ t = 1000 }))
  let pubDer = decodeHex(rsaPubDerHex()) catch _ {
    panic("bad RSA fixture")
  }
  let late = append(goodMembers(1000), JsonEntry{ key = "nbf", value = num(2000) })
  let tokens = []string{
    noneToken(1000),
    forge(SigningKey.Hs256Key(pubDer), "at+jwt", "r1", goodMembers(1000)),
    hsForge("at+jwt", "other", goodMembers(1000)),
    hsForge("JWT", "k1", goodMembers(1000)),
    hsForge("at+jwt", "k1", replaceMember(goodMembers(1000), "iss", str("x"))),
    hsForge("at+jwt", "k1", replaceMember(goodMembers(1000), "aud", str("x"))),
    hsForge("at+jwt", "k1", replaceMember(goodMembers(1000), "exp", num(10))),
    hsForge("at+jwt", "k1", late),
  }
  let reasons = []string{ "pinned", "kid", "typ", "issuer", "audience", "expired", "not yet valid" }
  let app = bearerApp(t)
  let rsaApp = bearerApp(rsa)
  let i = 0
  while (i < len(tokens)) {
    let target = app
    if (i == 1) {
      target = rsaApp
    }
    let res = target.handle(bearerReq("Bearer " + tokens[i]))
    assert(res.status == 401, "token ${i}: want 401, got ${res.status}")
    assert(
      res.getHeader("WWW-Authenticate") == "Bearer error=\"invalid_token\"",
      "token ${i}: got '${res.getHeader("WWW-Authenticate")}'",
    )
    for r of reasons {
      assert(!contains(res.body, r), "token ${i}: the body echoes '${r}'")
      assert(
        !contains(res.getHeader("WWW-Authenticate"), r),
        "token ${i}: the header echoes '${r}'",
      )
    }
    i = i + 1
  }
}

test "BearerStrategy: no credential is a 401 with the bare Bearer challenge" {
  let t = btTokens(hsKeySet(), hsOptions(BtClock{ t = 1000 }))
  let none = bearerApp(t).handle(bearerReq(""))
  let basic = bearerApp(t).handle(bearerReq("Basic dXNlcjpwYXNz"))

  assert(none.status == 401, "want 401, got ${none.status}")
  assert(
    none.getHeader("WWW-Authenticate") == "Bearer",
    "got '${none.getHeader("WWW-Authenticate")}'",
  )
  assert(basic.status == 401, "want 401 for Basic, got ${basic.status}")
  assert(
    basic.getHeader("WWW-Authenticate") == "Bearer",
    "got '${basic.getHeader("WWW-Authenticate")}'",
  )
}

test "BearerStrategy: the scheme is case-insensitive and an empty token is invalid_token" {
  let t = btTokens(hsKeySet(), hsOptions(BtClock{ t = 1000 }))
  let ok = bearerApp(t).handle(bearerReq("bearer " + btIssue(t, "u1")))
  let empty = bearerApp(t).handle(bearerReq("Bearer "))

  assert(ok.status == 200, "want 200 for 'bearer', got ${ok.status}")
  assert(empty.status == 401, "want 401, got ${empty.status}")
}

test "BearerStrategy is named bearer and keeps no session of its own" {
  let t = btTokens(hsKeySet(), hsOptions(BtClock{ t = 1000 }))

  assert(BearerStrategy(t).name() == "bearer", "name must be bearer")
}

// --- construction fails loudly ----------------------------------------------

test "construction 1/4: an HMAC key shorter than 32 bytes is refused" {
  let short = KeySet{
    signing = SigningKey.Hs256Key([]byte("too-short")),
    signingKid = "k1",
    verify = []Jwk{ Jwk{ kid = "k1", key = VerifyKey.Hs256Key([]byte("too-short")) } },
  }
  let msg = buildError(short, hsOptions(BtClock{ t = 0 }))

  assert(contains(msg, "shorter than 32"), "got '${msg}'")
}

test "construction 2/4: an empty issuer or audience is refused" {
  let clock = BtClock{ t = 0 }
  let noIss = hsOptions(clock)
  noIss.issuer = ""
  let noAud = hsOptions(clock)
  noAud.audience = ""

  assert(contains(buildError(hsKeySet(), noIss), "issuer"), "empty issuer must be refused")
  assert(contains(buildError(hsKeySet(), noAud), "audience"), "empty audience must be refused")
}

test "construction 3/4: a ttl of zero or below is refused" {
  let zero = hsOptions(BtClock{ t = 0 })
  zero.ttl = 0
  let negative = hsOptions(BtClock{ t = 0 })
  negative.ttl = -5

  assert(contains(buildError(hsKeySet(), zero), "ttl"), "ttl 0 must be refused")
  assert(contains(buildError(hsKeySet(), negative), "ttl"), "ttl -5 must be refused")
}

test "construction 4/4: an algorithm that is not the key's is refused" {
  let wrong = hsOptions(BtClock{ t = 0 })
  wrong.algorithm = "RS256"
  let none = hsOptions(BtClock{ t = 0 })
  none.algorithm = "none"

  assert(
    contains(buildError(hsKeySet(), wrong), "pinned"),
    "RS256 over an HS256 key must be refused",
  )
  assert(contains(buildError(hsKeySet(), none), "pinned"), "none must be refused")
  assert(
    contains(buildError(rsaKeySet(), hsOptions(BtClock{ t = 0 })), "pinned"),
    "HS256 over an RSA key must be refused",
  )
}

test "construction: a signing kid that verify does not list, or a negative skew, is refused" {
  let unlisted = hsKeySet()
  unlisted.signingKid = "k9"
  let skew = hsOptions(BtClock{ t = 0 })
  skew.skew = -1

  assert(
    contains(buildError(unlisted, hsOptions(BtClock{ t = 0 })), "signingKid"),
    "unlisted signing kid",
  )
  assert(contains(buildError(hsKeySet(), skew), "skew"), "negative skew")
}
