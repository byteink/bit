// pkg/auth/webauthn_login.bit — passkey login (#6959, epic #3960): the server
// side of W3C Web Authentication Level 3 section 7.2, as a `Strategy`
// (strategy.bit) that logs a user in with a credential `WebAuthn`
// (webauthn.bit) registered.
//
//   let passkeys = WebAuthnStrategy(wa, (userId) => loadIdentity(userId))?
//   let options = passkeys.beginLogin(c, Option<string>.Some("user-1"))?     // or None
//   ... the browser runs navigator.credentials.get() and posts the result ...
//   let identity = passkeys.authenticate(c)?
//
// `beginLogin` returns the request options JSON and keeps a 32-byte challenge in
// the session, single use and good for 5 minutes. With a user id the options
// carry `allowCredentials` (that user's credential ids and transports); with
// `None` they carry an empty list, for a discoverable (usernameless) login and
// conditional UI (section 5.1.4), where the authenticator picks the account. A
// user id nobody has, or one with no passkeys, gets a plausible list with one
// decoy id (a SHA-256 of a per-process salt and the id, stable across calls), so
// the options do not say whether the account exists.
//
// `authenticate` reads the browser's `PublicKeyCredential.toJSON()` from the
// request body and consumes the challenge FIRST, on every attempt. It then runs
// section 7.2: the credential by id, whose owner must be the asked-for user
// (step 5) and, when the authenticator sent a `userHandle`, the user that
// handle belongs to (step 6; a discoverable login requires one); the clientData
// type, challenge and origin; the rpIdHash; UP, and UV when the options asked
// for it; that BE is the one stored (6.1.3); the signature over
// `authenticatorData || SHA-256(clientDataJSON)` with the stored COSE key
// (`coseVerify`, ES256, EdDSA, RS256 and the other algorithms it supports); and
// the signature counter (step 21): when either the stored or the reported count
// is not zero, the reported one must be greater, and otherwise the
// authenticator may be cloned. A synced passkey that always reports 0 is
// accepted. A suspected clone is refused (`CloneAction.Reject`, the default) or
// let through (`Allow`); either way `onEvent` hears "login.clone".
//
// Every failure the client can cause is the same `unauthorized()`, whichever
// step refused it. A verified login stores the new signature counter and backup
// state, regenerates the session id, and binds the session through
// `bindFirstFactor` (mfa.bit), so `PasskeyLoginOptions.second` works like the
// one on every other first-factor strategy.
//
// `Ctx`, `Session`, `unauthorized`, `Identity`, `bindFirstFactor`,
// `SecondRequired`, `LoginThrottle`, `Throttled`, `AuthEvent`, `AuthEventHook`,
// `accountHash`, `wallSeconds`, `runRecovering`, `randomBytes`, `now`,
// `Second`, `isSome`, `unwrap`, `jsonGet`, `jsonAsString`, `digest`, `Sha256`,
// `parseCoseKey`, `parseClientData`, `checkClientData`, `parseAuthenticatorData`
// and `checkRpIdHash` are bound module-wide (SPEC §17.1); `coseVerify` is the
// one new name.
import { coseVerify } from "std/crypto"

// Where the pending login lives in the session.
const loginSessionKey = "webauthn.login"

// The audit event kind for a suspected cloned authenticator; the other kinds are
// the ones `PasswordStrategy` reports (password.bit).
const eventClone = "login.clone"

// What to do when the signature counter says the authenticator may have been
// cloned (section 7.2 step 21). `Reject` fails the login closed; `Allow` lets
// it through and still reports it through `PasskeyLoginOptions.onEvent`.
export enum CloneAction {
  Reject,
  Allow,
}

// The optional knobs of `WebAuthnStrategy(wa, resolve, opts)`, all defaulting.
// `userVerification` is what this login asks of the authenticator (section
// 5.5): `Required` fails an assertion without the UV flag. `onCloneSuspected`
// is the `CloneAction` above. `throttle` is the `LoginThrottle` to consult and
// feed (`None`: none): each attempt counts under `passkey:<credential id the
// client named>`, so a wrong guess at one credential does not lock another, and
// the address counter is the shared one. `onEvent` is the audit hook, told
// "login.success", "login.failure", "login.locked" and "login.clone"
// (`nil`: none). `second` is asked, with the verified `Identity`, whether the
// user still owes a second factor, exactly as `PasswordOptions.second` is.
export class PasskeyLoginOptions {
  export userVerification: UserVerification = UserVerification.Preferred,
  export onCloneSuspected: CloneAction = CloneAction.Reject,
  export throttle: Option<LoginThrottle>,
  export onEvent: AuthEventHook,
  export second: Option<SecondRequired>,
}

// A `Strategy` that logs a user in with a passkey. `WebAuthnStrategy(wa,
// resolve, opts)` takes the `WebAuthn` that holds the relying party and the
// credential store, and `resolve(userId)`, which turns the user id the
// credential was registered under into the `Identity` to bind (a failure, for a
// user who was deleted or disabled since, refuses the login). Fails at
// construction for a nil `resolve`, so a mistake stops the app at startup.
export class WebAuthnStrategy {
  wa: WebAuthn
  resolve: (string) => Identity!
  opts: PasskeyLoginOptions
  decoySalt: []byte

  init(
    wa: WebAuthn,
    resolve: (string) => Identity!,
    opts: PasskeyLoginOptions = PasskeyLoginOptions{},
  )! {
    if (resolve == nil) {
      fail newError("auth: WebAuthnStrategy(): `resolve` is nil — pass the function that returns the Identity of a user id")
    }
    this.wa = wa
    this.resolve = resolve
    this.opts = opts
    this.decoySalt = randomBytes(waChallengeBytes)
  }

  export name(): string {
    return "passkey"
  }

  // The options for `navigator.credentials.get({ publicKey })` (hand them to
  // `PublicKeyCredential.parseRequestOptionsFromJSON`), and a fresh single-use
  // challenge in the session. `userId` is your id for the user (the one the
  // credentials were registered under): the options then list that user's
  // credentials. `None` asks for a discoverable login. Fails only when the
  // session or the store is unavailable.
  export beginLogin(c: Ctx, userId: Option<string> = Option<string>.None): Json! {
    let allow = this.allowList(userId)?
    let pending = PendingLogin{
      challenge = randomBytes(waChallengeBytes),
      expiresAt = now().ns / Second + waChallengeTtl,
      userId = userId,
    }
    let session = c.session()?
    session.set(loginSessionKey, encodePendingLogin(pending))
    session.save()?
    return requestOptions(
      this.wa.rp,
      this.opts.userVerification,
      this.wa.opts.timeoutMs,
      pending.challenge,
      allow,
    )
  }

  // `allowCredentials`: empty for a discoverable login, the user's credentials
  // for a user who has some, one decoy descriptor for one who has none.
  allowList(userId: Option<string>): Json! {
    match (userId) {
      None => return Json.JsonArray([]Json(0))
      Some(id) => {
        let have = this.wa.store.forUser(id)?
        if (len(have) == 0) {
          return waDecoyDescriptors(this.decoySalt, id)
        }
        return waDescriptors(have)
      }
    }
  }

  // Verifies the assertion in the request body against the challenge
  // `beginLogin` issued, per this file's header, and binds the session. The
  // challenge is spent whether this succeeds or not. Fails with `unauthorized()`
  // for every refusal, a `Throttled` (429) when the throttle holds the client,
  // and a plain error when the session or the throttle's store is down.
  export authenticate(c: Ctx): Identity! {
    let ip = c.peer()
    let pending = takeLogin(c.session()?)?
    let body = c.bodyJson()?
    let account = "passkey:" + claimedId(body)
    this.admit(account, ip)?
    let identity = this.verified(body, pending, ip) catch _ {
      this.failed(account, ip)?
      fail unauthorized()
    }
    this.succeeded(account, identity.id, ip)?
    c.session()?.regenerate()?
    bindFirstFactor(c, identity, this.opts.second)?
    return identity
  }

  // Section 7.2 on `body` and the Identity of the credential's owner. Any
  // failure is an error here; `authenticate` shows the client none of them.
  verified(body: Json, pending: Option<PendingLogin>, ip: string): Identity! {
    if (!isSome(pending)) {
      fail newError("auth: webauthn: no login is in progress for this session, or it expired")
    }
    let p = unwrap(pending)
    let r = parseAssertionResponse(body)?
    let cred = this.credentialFor(r, p)?
    let ad = this.checkAssertion(r, p, cred)?
    let clone = ad.signCount <= cred.signCount && (ad.signCount != 0 || cred.signCount != 0)
    if (clone) {
      this.cloneSuspected(cred, ip)?
    }
    let identity = this.resolve(cred.userId)?
    this.recordAssertion(cred, ad)?
    return identity
  }

  // Section 7.2 steps 5 and 6: the credential the browser named, owned by the
  // user the options were asked for, and by the user the handle names.
  credentialFor(r: AssertionResponse, p: PendingLogin): Credential! {
    let found = this.wa.store.byId(r.id)?
    if (!isSome(found)) {
      fail newError("auth: webauthn: no credential has this id")
    }
    let cred = unwrap(found)
    if (isSome(p.userId) && unwrap(p.userId) != cred.userId) {
      fail newError("auth: webauthn: the credential is not one of the asked-for user's")
    }
    if (!isSome(r.userHandle)) {
      if (!isSome(p.userId)) {
        fail newError("auth: webauthn: a discoverable login needs the userHandle, the response has none")
      }
      return cred
    }
    let owner = this.wa.store.userForHandle(unwrap(r.userHandle))?
    if (!isSome(owner) || unwrap(owner) != cred.userId) {
      fail newError("auth: webauthn: the userHandle is not the credential owner's")
    }
    return cred
  }

  // Section 7.2 steps 11 to 20: clientData, rpIdHash, flags, backup eligibility
  // and the signature. Returns the parsed authenticator data for the counter.
  checkAssertion(r: AssertionResponse, p: PendingLogin, cred: Credential): AuthenticatorData! {
    let rp = this.wa.rp
    let cd = parseClientData(r.clientData)?
    checkClientData(cd, "webauthn.get", p.challenge, rp.origins, rp.topOrigins)?
    let ad = parseAuthenticatorData(r.authData)?
    checkRpIdHash(ad, rp.id)?
    if (!ad.up) {
      fail newError("auth: webauthn: authenticatorData does not have the UP flag (user presence)")
    }
    if (this.opts.userVerification.wire() == "required" && !ad.uv) {
      fail newError("auth: webauthn: user verification is required and authenticatorData does not have the UV flag")
    }
    if (ad.be != cred.backupEligible) {
      fail newError("auth: webauthn: the BE flag changed since registration (section 6.1.3)")
    }
    checkSignature(cred, ad, r)?
    return ad
  }

  // Section 7.2 step 21 found a counter that did not advance: tell the hook,
  // and refuse unless the app chose `Allow`.
  cloneSuspected(cred: Credential, ip: string): ()! {
    this.emit(eventClone, cred.userId, ip)
    match (this.opts.onCloneSuspected) {
      Reject => fail newError("auth: webauthn: the signature counter did not advance, the authenticator may be cloned")
      Allow => {}
    }
  }

  // Stores the counter and the backup state this assertion reported. The
  // counter never goes down, so an allowed regression does not make the next
  // genuine assertion look like a clone.
  recordAssertion(cred: Credential, ad: AuthenticatorData): ()! {
    if (ad.signCount > cred.signCount) {
      cred.signCount = ad.signCount
    }
    cred.backupState = ad.bs
    this.wa.store.update(cred)?
  }

  // The throttle's say, before any signature is checked.
  admit(account: string, ip: string): ()! {
    match (this.opts.throttle) {
      None => return
      Some(t) => {
        t.check(account, ip) catch e {
          let (_, locked) = e.(Throttled)
          if (!locked) {
            fail passkeyThrottleDown(e)
          }
          this.emit(eventLocked, account, ip)
          fail e
        }
      }
    }
  }

  // Tells the hook, then counts the failure against the account and address.
  failed(account: string, ip: string): ()! {
    this.emit(eventFailure, account, ip)
    match (this.opts.throttle) {
      None => return
      Some(t) => {
        t.recordFailure(account, ip) catch e {
          fail passkeyThrottleDown(e)
        }
      }
    }
  }

  // Clears the account's failures, then tells the hook, which sees the user's
  // own id (hashed) rather than the credential id the client named.
  succeeded(account: string, userId: string, ip: string): ()! {
    match (this.opts.throttle) {
      None => {}
      Some(t) => {
        t.recordSuccess(account) catch e {
          fail passkeyThrottleDown(e)
        }
      }
    }
    this.emit(eventSuccess, userId, ip)
  }

  // Hands the hook one event; whatever the hook does, the login goes on.
  emit(kind: string, who: string, ip: string) {
    let hook = this.opts.onEvent
    if (hook == nil) {
      return
    }
    let ev = AuthEvent{ kind = kind, account = accountHash(who), ip = ip, at = wallSeconds() }
    let (_, _) = runRecovering(() => {
      hook(ev)
    })
  }
}

// The login refused because the throttle's store failed: not a `Throttled`, so
// the client sees a 500 and the cause stays in the server's log.
fn passkeyThrottleDown(e: error): error {
  return newError("auth: WebAuthnStrategy: the login throttle failed, refusing the login: ${e.message()}")
}

// Reads and DELETES the pending login, saving the session before anything else
// happens: the session store's compare-and-set makes two concurrent attempts at
// one challenge race here, and only one gets it. `None` for no login in
// progress, an expired one, or one the session holds malformed.
fn takeLogin(session: Session): Option<PendingLogin>! {
  let raw = session.get(loginSessionKey)
  if (raw == "") {
    return Option<PendingLogin>.None
  }
  session.delete(loginSessionKey)
  session.save()?
  let p = decodePendingLogin(raw) catch _ {
    return Option<PendingLogin>.None
  }
  if (p.expiresAt <= now().ns / Second) {
    return Option<PendingLogin>.None
  }
  return Option<PendingLogin>.Some(p)
}

// The credential id the body names, as the client spelled it: the key the
// throttle counts the attempt under, valid or not. Empty when the body has none.
fn claimedId(body: Json): string {
  let m = jsonGet(body, "id")
  if (!isSome(m)) {
    return ""
  }
  let s = jsonAsString(unwrap(m))
  if (!isSome(s)) {
    return ""
  }
  return unwrap(s)
}

// Section 7.2 steps 19 and 20: the signature over `authenticatorData ||
// SHA-256(clientDataJSON)` under the stored key.
fn checkSignature(cred: Credential, ad: AuthenticatorData, r: AssertionResponse): ()! {
  let key = parseCoseKey(cred.publicKey)?
  let message = append([]byte(0), ...ad.raw)
  message = append(message, ...digest(Sha256(), r.clientData))
  if (!coseVerify(key, cred.alg, message, r.signature)?) {
    fail newError("auth: webauthn: the assertion signature does not verify")
  }
}
