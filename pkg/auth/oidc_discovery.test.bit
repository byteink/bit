// pkg/auth/oidc_discovery.test.bit — #5772's acceptance: `discover()`
// parses a well-known document and fails on a non-200 response, an
// https-only issuer check, byte-for-byte issuer matching (OIDC Discovery
// 1.0 §4.3), a JWKS cache hit with NO HTTP call, exactly one refetch on an
// unknown `kid`, and a refetch cooldown that survives 100 unknown-kid
// lookups with at most one more HTTP call. #5788's acceptance: two tasks
// racing an unknown `kid` under real parallelism claim the refetch cooldown
// at most once between them.
//
// Every test goes through a `FetchCounter`-backed `HttpFetch` fake — never
// `getTls` — so nothing here touches the network or a TLS handshake. The
// fake still runs every response through `checkStatus` (oidc_discovery.bit),
// the same status-rejection code the real path uses, so the non-200 case is
// proven against production logic and not a re-implementation of it.
//
// `Response` and `getTls` are already bound module-wide by
// `oidc_discovery.bit`; `TlsConfig` likewise. `contains`, `parseInt`,
// `env`, `AtomicI64` and `AtomicI64` are new to the module (E0042 governs
// the rest); `emptyTrustStore` is bound by `providers.bit`.
import { contains, parseInt } from "std/strings"
import { envOr, selfExe } from "std/os"
import { output } from "std/process"
import { AtomicI64 } from "std/sync"

// The cooldown-claim race (#5788): with no synchronization, two concurrent
// misses on the same unknown `kid` can both read `hasRefetched == false`
// before either sets it, so both claim the refetch. Reproducing that needs
// genuine hardware parallelism, not just interleaved green threads on one
// OS thread — a channel park always lets a cooperative scheduler resume the
// other task, never letting both execute the check-then-set at once. The
// runtime boots ONE worker by default, so the race trials only count when
// `BIT_WORKERS>=2`. The test therefore never trusts the ambient setting
// (#7097): below two workers it re-runs ITSELF in a child pinned to
// `raceWorkers` and asserts that child passed, so a bare `bit test pkg/auth`
// exercises the real race instead of failing on the environment. The child
// still runs the `hasRealParallelism` guard, which fails (never skips) if the
// pin did not take. `./make test-package-auth` also sets `BIT_WORKERS=4`
// (`packageWorkers`, tools/build/gates.bit) and takes the direct path.
const raceWorkers = 4
const raceChildTimeoutMs = 25000

fn hasRealParallelism(): bool {
  let raw = envOr("BIT_WORKERS", "1")
  let workers = parseInt(raw) catch _ {
    panic("BIT_WORKERS='${raw}' is not a number")
  }
  return workers >= 2
}

// Re-runs this very test (`selfExe()` under `bit test` is the per-test child
// binary, and the inherited `BIT_TEST_INDEX` selects the same test) with
// `BIT_WORKERS=raceWorkers`, and fails with the child's stderr unless it
// exits 0. `/usr/bin/env` sets the variable because `std/process` children
// inherit the environment and cannot override it; `BIT_RACE_CHILD` stops the
// child re-running itself again if the pin ever fails to take (a fork bomb).
fn runRaceAtPinnedWorkers(): bool {
  let r = output(
    "/usr/bin/env",
    ["BIT_WORKERS=${raceWorkers}", "BIT_RACE_CHILD=1", selfExe()],
    raceChildTimeoutMs,
  )
  assert(
    r.exitCode == 0,
    "the race test failed in its BIT_WORKERS=${raceWorkers} child, rc=${r.exitCode}: ${r.stderr}${r.stdout}",
  )
  return true
}

const testIssuer = "https://idp.example.com"

const discoveryDoc = "{\"issuer\":\"https://idp.example.com\"," +
  "\"authorization_endpoint\":\"https://idp.example.com/authorize\"," +
  "\"token_endpoint\":\"https://idp.example.com/token\"," +
  "\"jwks_uri\":\"https://idp.example.com/jwks\"}"

const discoveryDocWrongIssuer = "{\"issuer\":\"https://evil.example.com\"," +
  "\"authorization_endpoint\":\"https://idp.example.com/authorize\"," +
  "\"token_endpoint\":\"https://idp.example.com/token\"," +
  "\"jwks_uri\":\"https://idp.example.com/jwks\"}"

// `kty: "oct"` (RFC 7518 §6.4) needs only `k`, a base64url secret — the
// simplest JWK this fixture can parse with, since these tests never verify
// a signature, only key SELECTION by `kid`.
const jwksOneKey = "{\"keys\":[{\"kty\":\"oct\",\"kid\":\"k1\",\"k\":\"a2V5\"}]}"
const jwksTwoKeys = "{\"keys\":[{\"kty\":\"oct\",\"kid\":\"k1\",\"k\":\"a2V5\"}," +
  "{\"kty\":\"oct\",\"kid\":\"k2\",\"k\":\"a2V5\"}]}"

// A `TlsConfig` no test here ever dials with — every fake `HttpFetch` skips
// `getTls` entirely (`fetchGet`, oidc_discovery.bit), so this exists only to
// satisfy the parameter.
fn tlsStub(): TlsConfig {
  return TlsConfig(emptyTrustStore())
}

// One HTTP call's canned answer, and the call counter every fake shares —
// a class, because the closure below must keep seeing the current value
// (classes are reference types, SPEC §13.3), the same shape
// `pkg/web/ratelimit.test.bit`'s `RlClock` uses for its test clock.
class FetchCounter {
  calls: int,
  statuses: []int,
  bodies: []string,
}

// An `HttpFetch` answering from `box.statuses[box.calls]`/`box.bodies[box.calls]`
// and incrementing `box.calls` on every call — through `checkStatus`, so a
// canned non-200 status fails exactly as the real `getTls` path would.
fn fakeFetch(box: FetchCounter): HttpFetch {
  let f: HttpFetch = (url) => {
    let i = box.calls
    box.calls = box.calls + 1
    return checkStatus(
      url,
      Response{ status = box.statuses[i], contentType = "", headers = "", body = box.bodies[i] },
    )?
  }
  return f
}

fn oneCallFetch(status: int, body: string): HttpFetch {
  return fakeFetch(FetchCounter{ calls = 0, statuses = [status], bodies = [body] })
}

fn discoverErr(issuer: string, fetch: HttpFetch): string {
  discoverFetch(issuer, tlsStub(), fetch) catch e {
    return e.message()
  }
  return ""
}

fn findErr(cache: JwksCache, kid: string): string {
  cache.find(kid) catch e {
    return e.message()
  }
  return ""
}

test "discover() parses a well-known document into OidcConfig" {
  let cfg = discoverFetch(testIssuer, tlsStub(), oneCallFetch(200, discoveryDoc)) catch e {
    panic("discover: ${e.message()}")
  }
  assert(cfg.issuer == testIssuer, "want issuer '${testIssuer}', got '${cfg.issuer}'")
  assert(
    cfg.authorizationEndpoint == "https://idp.example.com/authorize",
    "wrong authorization_endpoint: '${cfg.authorizationEndpoint}'",
  )
  assert(
    cfg.tokenEndpoint == "https://idp.example.com/token",
    "wrong token_endpoint: '${cfg.tokenEndpoint}'",
  )
  assert(cfg.jwksUri == "https://idp.example.com/jwks", "wrong jwks_uri: '${cfg.jwksUri}'")
}

fn docWithEndSession(value: string): string {
  return "{\"issuer\":\"https://idp.example.com\"," +
    "\"authorization_endpoint\":\"https://idp.example.com/authorize\"," +
    "\"token_endpoint\":\"https://idp.example.com/token\"," +
    "\"jwks_uri\":\"https://idp.example.com/jwks\"," +
    "\"end_session_endpoint\":" +
    value +
    "}"
}

test "discover() reads end_session_endpoint, and leaves it None when the document has none" {
  let with = discoverFetch(
    testIssuer,
    tlsStub(),
    oneCallFetch(200, docWithEndSession("\"https://idp.example.com/logout\"")),
  ) catch e {
    panic("discover: ${e.message()}")
  }
  assert(
    with.endSessionEndpoint == Option.Some("https://idp.example.com/logout"),
    "end_session_endpoint not parsed",
  )
  let without = discoverFetch(testIssuer, tlsStub(), oneCallFetch(200, discoveryDoc)) catch e {
    panic("discover: ${e.message()}")
  }
  assert(!isSome(without.endSessionEndpoint), "a document without one must give None")
}

test "discover() rejects an http:// or non-string end_session_endpoint" {
  let http = discoverErr(
    testIssuer,
    oneCallFetch(200, docWithEndSession("\"http://idp.example.com/logout\"")),
  )
  assert(contains(http, "end_session_endpoint"), "http must be refused, got '${http}'")
  let num = discoverErr(testIssuer, oneCallFetch(200, docWithEndSession("42")))
  assert(contains(num, "end_session_endpoint"), "non-string must be refused, got '${num}'")
}

test "discover() fails on a non-200 response" {
  let msg = discoverErr(testIssuer, oneCallFetch(500, "internal error"))
  assert(contains(msg, "500"), "want the status in the error, got '${msg}'")
}

test "discover() rejects a non-https issuer before any HTTP call" {
  // `nil` fetch: a real HTTP call here would prove nothing was skipped.
  let msg = discoverErr("http://idp.example.com", nil)
  assert(contains(msg, "https"), "want an https complaint, got '${msg}'")
}

test "discover() rejects a discovery document whose issuer disagrees" {
  let msg = discoverErr(testIssuer, oneCallFetch(200, discoveryDocWrongIssuer))
  assert(contains(msg, "issuer mismatch"), "want an issuer-mismatch error, got '${msg}'")
}

test "JwksCache.find() returns a key present in the initial fetch without a second HTTP call" {
  let box = FetchCounter{ calls = 0, statuses = [200], bodies = [jwksOneKey] }
  let cache = JwksCache("https://idp.example.com/jwks", tlsStub(), fetch = fakeFetch(box)) catch e {
    panic("JwksCache: ${e.message()}")
  }
  cache.find("k1") catch e {
    panic("find('k1') must succeed from the initial fetch: ${e.message()}")
  }
  assert(box.calls == 1, "want exactly the initial fetch, got ${box.calls} calls")
}

test "JwksCache.find() on an unknown kid triggers exactly one refetch and succeeds" {
  let box = FetchCounter{ calls = 0, statuses = [200, 200], bodies = [jwksOneKey, jwksTwoKeys] }
  let cache = JwksCache("https://idp.example.com/jwks", tlsStub(), fetch = fakeFetch(box)) catch e {
    panic("JwksCache: ${e.message()}")
  }
  cache.find("k2") catch e {
    panic("find('k2') must succeed after exactly one refetch: ${e.message()}")
  }
  assert(box.calls == 2, "want the initial fetch plus exactly one refetch, got ${box.calls} calls")
}

// #5772's security requirement: a sustained attack spraying unknown `kid`s
// costs the JWKS endpoint at most one refetch inside the cooldown window,
// never one per lookup.
test "100 unknown-kid lookups inside the cooldown window cause at most one refetch" {
  let box = FetchCounter{ calls = 0, statuses = [200, 200], bodies = [jwksOneKey, jwksOneKey] }
  let cache = JwksCache("https://idp.example.com/jwks", tlsStub(), fetch = fakeFetch(box)) catch e {
    panic("JwksCache: ${e.message()}")
  }
  let i = 0
  while (i < 100) {
    cache.find("unknown-${i}") catch _ {
      i = i + 1
      continue
    }
    panic("find(unknown-${i}): an unknown kid must never succeed")
  }
  assert(box.calls == 2, "want the initial fetch plus at most one refetch, got ${box.calls} calls")
}

test "a lookup inside the cooldown window returns the prior refetch's failure" {
  let box = FetchCounter{ calls = 0, statuses = [200, 200], bodies = [jwksOneKey, jwksOneKey] }
  let cache = JwksCache("https://idp.example.com/jwks", tlsStub(), fetch = fakeFetch(box)) catch e {
    panic("JwksCache: ${e.message()}")
  }
  let first = findErr(cache, "unknown-a")
  let second = findErr(cache, "unknown-b")
  assert(box.calls == 2, "want exactly one refetch across both lookups, got ${box.calls} calls")
  assert(
    first == second,
    "want the cooldown to return the SAME failure, got '${first}' then '${second}'",
  )
}

// One `HttpFetch` shared by both racing tasks below. `calls` is an atomic
// index, never a plain `int` — a plain `box.calls = box.calls + 1` (like
// `FetchCounter` above) is itself racy under the exact concurrent calls
// this test forces, which would silently undercount the very bug under
// test. Call index 0 is the cache's own constructor fetch, made before any
// race starts; every later call announces itself on `entered` and then
// parks on `proceed`, so the test can see exactly how many calls are in
// flight before letting any of them finish.
class RaceFetch {
  calls: AtomicI64,
  entered: chan<bool>,
  proceed: chan<bool>,
  statuses: []int,
  bodies: []string,
}

fn raceFetchFn(rc: RaceFetch): HttpFetch {
  let f: HttpFetch = (url) => {
    let i = rc.calls.add(1) - 1
    if (i > 0) {
      rc.entered <- true
      <- rc.proceed
    }
    return checkStatus(
      url,
      Response{ status = rc.statuses[i], contentType = "", headers = "", body = rc.bodies[i] },
    )?
  }
  return f
}

fn raceTask(cache: JwksCache, kid: string, gate: chan<bool>, results: chan<string>) {
  <- gate
  results <- findErr(cache, kid)
}

// One trial of #5788's reproduction: two tasks miss the same unknown `kid`
// at once. Both are parked on `gate` until `close(gate)` releases them
// together (SPEC §16.2 — close broadcasts to every waiter), so neither's
// check-then-claim gets a head start on the other's. Whichever task(s) pass
// the cooldown check park inside `raceFetchFn` on `rc.proceed`; this
// classifies both tasks — claim winner or claim loser — through a fair
// `select` before releasing the winner(s)' fetch, so it never assumes which
// one runs first. Returns how many tasks won the claim: on the branch
// (`claimRefetch` under `refetchLock`) that is always exactly 1,
// deterministically, because the claim is one atomic step; on main (no lock
// around the check-and-set) it is occasionally 2.
fn raceOneTrial(): int {
  let rc = RaceFetch{
    calls = AtomicI64(0),
    entered = chan<bool>(2),
    proceed = chan<bool>(),
    statuses = [200, 200, 200],
    bodies = [jwksOneKey, jwksOneKey, jwksOneKey],
  }
  let cache = JwksCache("https://idp.example.com/jwks", tlsStub(), fetch = raceFetchFn(rc)) catch e {
    panic("JwksCache: ${e.message()}")
  }

  let gate = chan<bool>()
  let results = chan<string>(2)
  spawn raceTask(cache, "unknown", gate, results)
  spawn raceTask(cache, "unknown", gate, results)
  close(gate)

  // A claim loser fails with `newError(this.lastError)`, and `lastError`'s
  // zero value is itself "" until a refetch has completed once — so an
  // empty `results` message here is a legitimate loser, not a success, and
  // is not asserted on; `find()` returning a real key for "unknown" is
  // impossible given `jwksOneKey`, so no separate check is needed.
  let winners = 0
  let i = 0
  while (i < 2) {
    select {
      case _ = <- rc.entered:
        winners = winners + 1
      case _ = <- results:
        {}
    }
    i = i + 1
  }
  close(rc.proceed)

  // Drain the winner(s)' results now that their fetch has been released.
  let j = 0
  while (j < winners) {
    <- results
    j = j + 1
  }
  return winners
}

// The check-then-claim window main leaves open is a couple of unguarded
// instructions wide, so a single trial catches it only some of the time —
// measured empirically against pre-fix main (10 of 300 trials, ~3%) before
// this test was written this way. Running 300 independent trials (a fresh
// cache each time), a static and provably bounded loop, drives the chance
// of a false pass on main below 1 in 10000 ((1 - 0.03)^300 ≈ 5e-5) while
// staying exact and deterministic on the branch: `claimRefetch` guarantees
// every single trial is exactly 1, so 300 of them cannot flip that.
test "two tasks racing the same unknown kid claim the refetch cooldown at most once, over 300 trials (#5788)" {
  if (!hasRealParallelism() && envOr("BIT_RACE_CHILD", "") == "") {
    let _ = runRaceAtPinnedWorkers()
    return
  }
  assert(
    hasRealParallelism(),
    "this race needs BIT_WORKERS>=2 (one worker never runs both tasks at once, so every trial would pass)",
  )

  let trials = 300
  let t = 0
  while (t < trials) {
    let winners = raceOneTrial()
    assert(
      winners == 1,
      "trial ${t}/${trials}: want exactly one concurrent refetch claim between the two racing tasks, got ${winners}",
    )
    t = t + 1
  }
}
