// pkg/auth/recovery.test.bit — #6930's acceptance: generated codes are distinct
// and well formed, each redeems exactly once, formatting variants redeem,
// invalid options are refused, regenerating retires the old set, no plaintext
// code reaches `hashes`, storage is Argon2id, redeeming costs exactly one
// Argon2id run however many codes are stored, and the throttle counts and
// refuses redemption attempts.
//
// `contains` is already bound module-wide by oidc_discovery.test.bit;
// `repeat` and `toUpper` are new to it. `Throttled` (throttle.bit),
// `FakeClock`, `fakeStore`, `throttleOn` and `freshClock` (throttle.test.bit),
// `VerifyCounter`, `countingVerify` and `matchingVerify` (password.test.bit)
// are bound module-wide already.
import { repeat, toUpper } from "std/strings"

fn recoveryIsCodeChar(c: byte): bool {
  let i = 0
  while (i < len(recoveryAlphabet)) {
    if (recoveryAlphabet[i] == c) {
      return true
    }
    i = i + 1
  }
  return false
}

// A 4-character id group, then `groups` groups of `groupLen` alphabet
// characters, all joined with `-`.
fn recoveryWellFormed(code: string, groups: int, groupLen: int): bool {
  if (len(code) != recoveryIdLen + 1 + groups * groupLen + groups - 1) {
    return false
  }
  let i = 0
  while (i < len(code)) {
    let dash = i == recoveryIdLen ||
      (i > recoveryIdLen && (i - recoveryIdLen - 1) % (groupLen + 1) == groupLen)
    if (dash && code[i] != '-') {
      return false
    }
    if (!dash && !recoveryIsCodeChar(code[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

fn recoveryMustGenerate(opts: RecoveryOptions): RecoverySet {
  let set: RecoverySet = generateRecoveryCodes(opts) catch e {
    panic("generateRecoveryCodes: ${e.message()}")
  }
  return set
}

fn recoveryRedeems(hashes: []string, input: string): bool {
  redeemRecoveryCode(hashes, input) catch _ {
    return false
  }
  return true
}

fn recoveryRejects(opts: RecoveryOptions): bool {
  generateRecoveryCodes(opts) catch _ {
    return true
  }
  return false
}

// `n` stored entries `aaa0`..`aaa<n-1>` that all carry the dummy PHC string:
// real entries cost an Argon2id run each to make, and the tests that count
// verifier calls replace the verifier anyway.
fn recoveryFakeEntries(n: int): []string {
  let out = []string(0)
  let i = 0
  while (i < n) {
    out = append(out, "aaa${i}" + dummyEncodedHash)
    i = i + 1
  }
  return out
}

test "generate: ten distinct codes of the default shape, one hash each" {
  let set = recoveryMustGenerate(RecoveryOptions{})
  assert(len(set.codes) == 10, "codes: ${len(set.codes)}")
  assert(len(set.hashes) == 10, "hashes: ${len(set.hashes)}")
  let seen = map<string, bool>()
  let ids = map<string, bool>()
  for code of set.codes {
    assert(recoveryWellFormed(code, 2, 5), "malformed code ${code}")
    let (_, dup) = seen[code]
    assert(!dup, "duplicate code ${code}")
    seen[code] = true
    let (_, idDup) = ids[code[0:recoveryIdLen]]
    assert(!idDup, "duplicate lookup id in ${code}")
    ids[code[0:recoveryIdLen]] = true
  }
}

test "generate: custom shape follows the options" {
  let set = recoveryMustGenerate(RecoveryOptions{ count = 3, groups = 3, groupLen = 4 })
  assert(len(set.codes) == 3, "count")
  for code of set.codes {
    assert(recoveryWellFormed(code, 3, 4), "malformed code ${code}")
  }
}

test "redeem: every code works exactly once" {
  let set = recoveryMustGenerate(RecoveryOptions{})
  let hashes = set.hashes
  for code of set.codes {
    let used: RecoveryRedeem = redeemRecoveryCode(hashes, code) catch e {
      panic("first use of ${code}: ${e.message()}")
    }
    assert(len(used.remaining) == len(hashes) - 1, "remaining: ${len(used.remaining)}")
    assert(!recoveryRedeems(used.remaining, code), "second use of ${code} accepted")
    hashes = used.remaining
  }
  assert(len(hashes) == 0, "hashes left: ${len(hashes)}")
}

test "redeem: only the used hash leaves the list" {
  let set = recoveryMustGenerate(RecoveryOptions{ count = 4 })
  let used: RecoveryRedeem = redeemRecoveryCode(set.hashes, set.codes[2]) catch e {
    panic(e.message())
  }
  assert(len(used.remaining) == 3, "remaining: ${len(used.remaining)}")
  assert(used.remaining[0] == set.hashes[0], "entry 0 changed")
  assert(used.remaining[1] == set.hashes[1], "entry 1 changed")
  assert(used.remaining[2] == set.hashes[3], "entry 3 not kept in place of 2")
}

test "redeem: case, spaces and dashes do not matter" {
  let set = recoveryMustGenerate(RecoveryOptions{ count = 3 })
  let code = set.codes[0]
  let secret = code[5:16]
  let upper = toUpper(code)
  let noDash = code[0:4] + secret[0:5] + secret[6:11]
  let spaced = " " + code[0:4] + "  " + secret[0:5] + " " + secret[6:11] + " "
  assert(recoveryRedeems(set.hashes, upper), "upper case: ${upper}")
  assert(recoveryRedeems(set.hashes, noDash), "missing dashes: ${noDash}")
  assert(recoveryRedeems(set.hashes, spaced), "spaces: ${spaced}")
}

test "redeem: look-alike characters fold onto the alphabet" {
  let hashes = []string{ hashRecoveryCode("1ab0", "10-110") }
  assert(recoveryRedeems(hashes, "lAbO-lo-ilO"), "l, O, i did not fold to 1, 0, 1")
}

test "redeem: wrong, empty and oversized input fail with one message" {
  let set = recoveryMustGenerate(RecoveryOptions{ count = 2 })
  let right = set.codes[0]
  let inputs = []string{
    "zzzz-zzzzz-zzzzz",
    "",
    "-",
    repeat("a", 5000),
    right + "x",
    right[0:4] + "-zzzzz-zzzzz",
  }
  let msgs = []string(0)
  for input of inputs {
    redeemRecoveryCode(set.hashes, input) catch e {
      msgs = append(msgs, e.message())
      continue
    }
    panic("accepted ${input}")
  }
  assert(len(msgs) == len(inputs), "failures: ${len(msgs)}")
  for m of msgs {
    assert(m == msgs[0], "messages differ: ${m} vs ${msgs[0]}")
  }
}

test "redeem: an empty or malformed stored list never matches" {
  assert(!recoveryRedeems([]string(0), "abcd-efghj-kmnpq"), "empty list matched")
  assert(
    !recoveryRedeems([]string{ "garbage", "", "$", "abcd" }, "abcd-efghj-kmnpq"),
    "malformed entry matched",
  )
  assert(
    !recoveryRedeems([]string{ "abcdgarbage" }, "abcd-efghj-kmnpq"),
    "id with a broken hash matched",
  )
}

test "options: invalid shapes are refused at construction" {
  assert(recoveryRejects(RecoveryOptions{ count = 0 }), "count 0")
  assert(recoveryRejects(RecoveryOptions{ count = 33 }), "count 33")
  assert(recoveryRejects(RecoveryOptions{ groups = 2, groupLen = 4 }), "40 bits")
  assert(recoveryRejects(RecoveryOptions{ groups = 0 }), "groups 0")
  assert(recoveryRejects(RecoveryOptions{ groups = 9 }), "groups 9")
  assert(recoveryRejects(RecoveryOptions{ groupLen = 17 }), "groupLen 17")
  assert(
    !recoveryRejects(RecoveryOptions{ count = 1, groups = 1, groupLen = 10 }),
    "50 bits in one group is valid",
  )
}

test "regenerate: storing the new hashes retires all ten old codes" {
  let old = recoveryMustGenerate(RecoveryOptions{})
  let fresh = recoveryMustGenerate(RecoveryOptions{})
  let dead = 0
  for code of old.codes {
    if (!recoveryRedeems(fresh.hashes, code)) {
      dead = dead + 1
    }
  }
  assert(dead == 10, "old codes still valid: ${10 - dead}")
  for code of fresh.codes {
    assert(recoveryRedeems(fresh.hashes, code), "new code ${code} rejected")
  }
}

test "hashes: id then an Argon2id string, no plaintext code, a salt per entry" {
  let set = recoveryMustGenerate(RecoveryOptions{ count = 3 })
  let i = 0
  while (i < len(set.codes)) {
    let code = set.codes[i]
    let secret = normalizeRecoveryCode(code)[recoveryIdLen:14]
    assert(
      set.hashes[i][0:recoveryIdLen] == code[0:recoveryIdLen],
      "entry ${i} does not start with its id",
    )
    assert(
      set.hashes[i][recoveryIdLen:recoveryIdLen + 10] == "$argon2id$",
      "entry ${i} is not Argon2id",
    )
    assert(!contains(set.hashes[i], secret), "secret in ${set.hashes[i]}")
    i = i + 1
  }
  let a = hashRecoveryCode("abcd", "efghj-kmnpq")
  let b = hashRecoveryCode("abcd", "EFGHJ KMNPQ")
  assert(a != b, "equal secrets share a salt")
  assert(recoveryRedeems([]string{ a }, "abcd-efghj-kmnpq"), "a does not redeem")
  assert(recoveryRedeems([]string{ b }, "abcd-efghj-kmnpq"), "b does not redeem")
}

test "redeem: exactly one verifier run for a hit, a wrong secret, an unknown id, junk and no entries" {
  let entries = recoveryFakeEntries(10)
  let inputs = []string{ "aaa7-secret", "aaa7-wrong", "zzzz-secret", "", "-", "aa" }
  let hitBox = VerifyCounter{ calls = 0 }
  let hit = redeemWith(entries, inputs[0], RedeemOptions{}, matchingVerify(hitBox, "secret")) catch e {
    panic("hit: ${e.message()}")
  }
  assert(len(hit.remaining) == 9, "remaining: ${len(hit.remaining)}")
  assert(hitBox.calls == 1, "hit ran the verifier ${hitBox.calls} times with 10 entries")
  let k = 1
  while (k < len(inputs)) {
    let box = VerifyCounter{ calls = 0 }
    redeemWith(entries, inputs[k], RedeemOptions{}, matchingVerify(box, "secret")) catch _ {
      assert(box.calls == 1, "miss ${inputs[k]} ran the verifier ${box.calls} times")
      k = k + 1
      continue
    }
    panic("accepted ${inputs[k]}")
  }
  let emptyBox = VerifyCounter{ calls = 0 }
  redeemWith([]string(0), "aaa7-secret", RedeemOptions{}, countingVerify(emptyBox)) catch _ {
    assert(emptyBox.calls == 1, "empty list ran the verifier ${emptyBox.calls} times")
    return
  }
  panic("empty list accepted a code")
}

fn recoveryThrottleOpts(t: LoginThrottle): RedeemOptions {
  return RedeemOptions{ throttle = Option<LoginThrottle>.Some(t), account = "ada", ip = "10.0.0.1" }
}

// A throttle on a hand-moved clock: every failure starts a backoff wait, so a
// test steps the clock past it between attempts (throttle.test.bit's fakes).
fn recoveryThrottle(clock: FakeClock, failures: int): LoginThrottle {
  return throttleOn(fakeStore(clock), clock, ThrottleOptions{ accountFailures = failures })
}

// One wrong code through `opts`; returns whether the throttle refused it.
fn recoveryWrongCode(
  entries: []string,
  opts: RedeemOptions,
  box: VerifyCounter,
  clock: FakeClock,
): bool {
  clock.t = clock.t + 100
  redeemWith(entries, "aaa1-wrong", opts, matchingVerify(box, "secret")) catch e {
    let (_, locked) = e.(Throttled)
    return locked
  }
  panic("a wrong code was accepted")
}

test "throttle: misses lock the account, a locked attempt still costs one run and is a Throttled" {
  let entries = recoveryFakeEntries(3)
  let clock = freshClock()
  let opts = recoveryThrottleOpts(recoveryThrottle(clock, 3))
  let box = VerifyCounter{ calls = 0 }
  let k = 0
  while (k < 3) {
    assert(
      !recoveryWrongCode(entries, opts, box, clock),
      "miss ${k} was refused instead of counted",
    )
    k = k + 1
  }
  assert(box.calls == 3, "three misses ran the verifier ${box.calls} times")
  // The right code is refused too while the account is locked, and the
  // refusal pays one dummy run so it costs what a miss costs.
  redeemWith(entries, "aaa1-secret", opts, matchingVerify(box, "secret")) catch e {
    let (_, locked) = e.(Throttled)
    assert(locked, "the locked attempt was not a Throttled: ${e.message()}")
    assert(box.calls == 4, "the refusal ran the verifier ${box.calls - 3} times")
    return
  }
  panic("the locked account redeemed a code")
}

test "throttle: a hit clears the account's failures" {
  let entries = recoveryFakeEntries(3)
  let clock = freshClock()
  let opts = recoveryThrottleOpts(recoveryThrottle(clock, 3))
  let box = VerifyCounter{ calls = 0 }
  assert(!recoveryWrongCode(entries, opts, box, clock), "first miss refused")
  assert(!recoveryWrongCode(entries, opts, box, clock), "second miss refused")
  clock.t = clock.t + 100
  redeemWith(entries, "aaa1-secret", opts, matchingVerify(box, "secret")) catch e {
    panic("hit before the lockout: ${e.message()}")
  }
  // Two more misses would have locked "ada" had the hit not cleared the count.
  assert(!recoveryWrongCode(entries, opts, box, clock), "third miss refused")
  assert(!recoveryWrongCode(entries, opts, box, clock), "fourth miss refused")
}

test "throttle: an empty address fails closed and none means no counting" {
  let entries = recoveryFakeEntries(2)
  let clock = freshClock()
  let t = recoveryThrottle(clock, 3)
  let blind = RedeemOptions{ throttle = Option<LoginThrottle>.Some(t), account = "ada", ip = "" }
  let box = VerifyCounter{ calls = 0 }
  redeemWith(entries, "aaa1-secret", blind, matchingVerify(box, "secret")) catch e {
    let (_, locked) = e.(Throttled)
    assert(!locked, "an empty ip is a configuration error, not a lockout")
    assert(box.calls == 0, "refused before any hash")
    let k = 0
    while (k < 10) {
      redeemWith(entries, "aaa1-wrong", RedeemOptions{}, matchingVerify(box, "secret")) catch _ {
        k = k + 1
        continue
      }
      panic("a wrong code was accepted")
    }
    redeemWith(entries, "aaa1-secret", RedeemOptions{}, matchingVerify(box, "secret")) catch e2 {
      panic("without a throttle nothing locks: ${e2.message()}")
    }
    return
  }
  panic("an empty ip was accepted")
}
