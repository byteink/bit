// pkg/auth/recovery.test.bit — #6930's acceptance: generated codes are distinct
// and well formed, each redeems exactly once, formatting variants redeem,
// invalid options are refused, regenerating retires the old set, and no
// plaintext code reaches `hashes`.
//
// `contains` is already bound module-wide by oidc_discovery.test.bit;
// `repeat` and `toUpper` are new to it. `ctEq`, `randomBytes` and the hashing names by the sources — re-importing
// any is E0042.
import { repeat, toUpper } from "std/strings"

fn recoveryIsCodeChar(c: byte): bool {
  let i = 0
  while (i < len(recoveryAlphabet)) {
    if (recoveryAlphabet[i] == c) {
      return true
    }
    i = i + 1
  }
  return false
}

// `groups` groups of `groupLen` alphabet characters joined with `-`.
fn recoveryWellFormed(code: string, groups: int, groupLen: int): bool {
  if (len(code) != groups * groupLen + groups - 1) {
    return false
  }
  let i = 0
  while (i < len(code)) {
    let dash = i % (groupLen + 1) == groupLen
    if (dash && code[i] != '-') {
      return false
    }
    if (!dash && !recoveryIsCodeChar(code[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

fn recoveryMustGenerate(opts: RecoveryOptions): RecoverySet {
  let set: RecoverySet = generateRecoveryCodes(opts) catch e {
    panic("generateRecoveryCodes: ${e.message()}")
  }
  return set
}

fn recoveryRedeems(hashes: []string, input: string): bool {
  redeemRecoveryCode(hashes, input) catch _ {
    return false
  }
  return true
}

fn recoveryRejects(opts: RecoveryOptions): bool {
  generateRecoveryCodes(opts) catch _ {
    return true
  }
  return false
}

test "generate: ten distinct codes of the default shape, one hash each" {
  let set = recoveryMustGenerate(RecoveryOptions{})
  assert(len(set.codes) == 10, "codes: ${len(set.codes)}")
  assert(len(set.hashes) == 10, "hashes: ${len(set.hashes)}")
  let seen = map<string, bool>()
  for code of set.codes {
    assert(recoveryWellFormed(code, 2, 5), "malformed code ${code}")
    let (_, dup) = seen[code]
    assert(!dup, "duplicate code ${code}")
    seen[code] = true
  }
}

test "generate: custom shape follows the options" {
  let set = recoveryMustGenerate(RecoveryOptions{ count = 3, groups = 3, groupLen = 4 })
  assert(len(set.codes) == 3, "count")
  for code of set.codes {
    assert(recoveryWellFormed(code, 3, 4), "malformed code ${code}")
  }
}

test "redeem: every code works exactly once" {
  let set = recoveryMustGenerate(RecoveryOptions{})
  let hashes = set.hashes
  for code of set.codes {
    let used: RecoveryRedeem = redeemRecoveryCode(hashes, code) catch e {
      panic("first use of ${code}: ${e.message()}")
    }
    assert(len(used.remaining) == len(hashes) - 1, "remaining: ${len(used.remaining)}")
    assert(!recoveryRedeems(used.remaining, code), "second use of ${code} accepted")
    hashes = used.remaining
  }
  assert(len(hashes) == 0, "hashes left: ${len(hashes)}")
}

test "redeem: only the used hash leaves the list" {
  let set = recoveryMustGenerate(RecoveryOptions{ count = 4 })
  let used: RecoveryRedeem = redeemRecoveryCode(set.hashes, set.codes[2]) catch e {
    panic(e.message())
  }
  assert(len(used.remaining) == 3, "remaining: ${len(used.remaining)}")
  assert(used.remaining[0] == set.hashes[0], "entry 0 changed")
  assert(used.remaining[1] == set.hashes[1], "entry 1 changed")
  assert(used.remaining[2] == set.hashes[3], "entry 3 not kept in place of 2")
}

test "redeem: case, spaces and dashes do not matter" {
  let set = recoveryMustGenerate(RecoveryOptions{ count = 3 })
  let code = set.codes[0]
  let upper = toUpper(code)
  let noDash = code[0:5] + code[6:11]
  let spaced = " " + code[0:5] + "  " + code[6:11] + " "
  assert(recoveryRedeems(set.hashes, upper), "upper case: ${upper}")
  assert(recoveryRedeems(set.hashes, noDash), "missing dash: ${noDash}")
  assert(recoveryRedeems(set.hashes, spaced), "spaces: ${spaced}")
}

test "redeem: look-alike characters fold onto the alphabet" {
  let hashes = []string{ hashRecoveryCode("10-110") }
  assert(recoveryRedeems(hashes, "lo-ilO"), "l, o, i, O did not fold to 1, 0, 1, 0")
}

test "redeem: wrong, empty and oversized input fail with one message" {
  let set = recoveryMustGenerate(RecoveryOptions{ count = 2 })
  let long = repeat("a", 5000)
  let inputs = []string{ "zzzzz-zzzzz", "", "-", long, set.codes[0] + "x" }
  let msgs = []string(0)
  for input of inputs {
    redeemRecoveryCode(set.hashes, input) catch e {
      msgs = append(msgs, e.message())
      continue
    }
    panic("accepted ${input}")
  }
  assert(len(msgs) == 5, "failures: ${len(msgs)}")
  for m of msgs {
    assert(m == msgs[0], "messages differ: ${m} vs ${msgs[0]}")
  }
}

test "redeem: an empty or malformed stored list never matches" {
  assert(!recoveryRedeems([]string(0), "abcde-fghjk"), "empty list matched")
  assert(!recoveryRedeems([]string{ "garbage", "", "$" }, "abcde-fghjk"), "malformed entry matched")
}

test "options: five invalid shapes are refused at construction" {
  assert(recoveryRejects(RecoveryOptions{ count = 0 }), "count 0")
  assert(recoveryRejects(RecoveryOptions{ count = 33 }), "count 33")
  assert(recoveryRejects(RecoveryOptions{ groups = 2, groupLen = 4 }), "40 bits")
  assert(recoveryRejects(RecoveryOptions{ groups = 0 }), "groups 0")
  assert(recoveryRejects(RecoveryOptions{ groups = 9 }), "groups 9")
  assert(recoveryRejects(RecoveryOptions{ groupLen = 17 }), "groupLen 17")
  assert(
    !recoveryRejects(RecoveryOptions{ groups = 1, groupLen = 10 }),
    "50 bits in one group is valid",
  )
}

test "regenerate: storing the new hashes retires all ten old codes" {
  let old = recoveryMustGenerate(RecoveryOptions{})
  let fresh = recoveryMustGenerate(RecoveryOptions{})
  let dead = 0
  for code of old.codes {
    if (!recoveryRedeems(fresh.hashes, code)) {
      dead = dead + 1
    }
  }
  assert(dead == 10, "old codes still valid: ${10 - dead}")
  for code of fresh.codes {
    assert(recoveryRedeems(fresh.hashes, code), "new code ${code} rejected")
  }
}

test "hashes: no plaintext code, salted per code, salt differs for equal codes" {
  let set = recoveryMustGenerate(RecoveryOptions{})
  let i = 0
  while (i < len(set.codes)) {
    let plain = normalizeRecoveryCode(set.codes[i])
    assert(!contains(set.hashes[i], plain), "plain code in ${set.hashes[i]}")
    assert(!contains(set.hashes[i], set.codes[i]), "code in ${set.hashes[i]}")
    i = i + 1
  }
  let a = hashRecoveryCode("abcde-fghjk")
  let b = hashRecoveryCode("ABCDE FGHJK")
  assert(a != b, "equal codes share a salt")
  assert(recoveryRedeems([]string{ a }, "abcdefghjk"), "a does not redeem")
  assert(recoveryRedeems([]string{ b }, "abcdefghjk"), "b does not redeem")
}
