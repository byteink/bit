// W3C Web Authentication Level 3 (2026-08-25), section 16.3 registration.
// https://www.w3.org/TR/2026/REC-webauthn-3-20260825/#sctn-test-vectors-packed-self-es256
fn waSelfVector(): AttestationObject {
  return waAtt("")
}

fn waSelfHash(): []byte {
  return digest(
    Sha256(),
    waHex(""),
  )
}

fn waSelfError(obj: AttestationObject, hash: []byte): string {
  verifyPackedSelfAttestation(obj, hash) catch e {
    return e.message()
  }
  return "accepted"
}

fn waSelfStmt(alg: Cbor, sig: Cbor): Cbor {
  return Cbor.Map(
    [
      CborEntry{ key = Cbor.Text("alg"), value = alg },
      CborEntry{ key = Cbor.Text("sig"), value = sig },
    ],
  )
}

fn waSelfValidSignature(obj: AttestationObject): Cbor {
  let entries = waSelfEntries(obj.attStmt) catch e {
    panic(e.message())
  }
  return waRequire(entries, "sig") catch e {
    panic(e.message())
  }
}

test "packed self published registration vector verifies exact signed bytes" {
  let obj = waSelfVector()
  verifyPackedSelfAttestation(obj, waSelfHash()) catch e {
    panic(e.message())
  }
  assert(isSome(obj.authData.attested), "published registration carries a credential")
  assert(coseAlg(unwrap(obj.authData.attested).publicKey) == -7, "published ES256 key")
}

test "packed self refuses tampered raw authenticator data and client hash" {
  let obj = waSelfVector()
  obj.authData.raw[0] = obj.authData.raw[0] ^ 1
  assert(waSelfError(obj, waSelfHash()) == waSelfFailure, "raw signed byte tamper")
  let hash = waSelfHash()
  hash[0] = hash[0] ^ 1
  assert(waSelfError(waSelfVector(), hash) == waSelfFailure, "client hash tamper")
  assert(waSelfError(waSelfVector(), []byte(31)) == waSelfFailure, "hash length")
}

test "packed self refuses signature tamper and malformed signature" {
  let obj = waSelfVector()
  let value = waSelfValidSignature(obj)
  match (value) {
    Bytes(sig) => {
      sig[len(sig) - 1] = sig[len(sig) - 1] ^ 1
      obj.attStmt = waSelfStmt(Cbor.Negative(6), Cbor.Bytes(sig))
    }
    _ => panic("published signature is bytes")
  }
  assert(waSelfError(obj, waSelfHash()) == waSelfFailure, "signature tamper")
  for sig of [Cbor.Text("private signature"), Cbor.Bytes([]byte(0)), Cbor.Bytes([]byte(1025))] {
    let malformed = waSelfVector()
    malformed.attStmt = waSelfStmt(Cbor.Negative(6), sig)
    assert(
      waSelfError(malformed, waSelfHash()) == waSelfFailure,
      "signature shape and bounded redacted error",
    )
  }
}

test "packed self refuses algorithm mismatch unsupported and malformed algorithms" {
  for alg of [
    Cbor.Negative(7),
    Cbor.Negative(8),
    Cbor.Negative(999),
    Cbor.Uint(7),
    Cbor.Text("secret algorithm"),
  ] {
    let obj = waSelfVector()
    obj.attStmt = waSelfStmt(alg, waSelfValidSignature(obj))
    assert(waSelfError(obj, waSelfHash()) == waSelfFailure, "algorithm refusal is redacted")
  }
}

test "packed self refuses missing duplicate and nontext statement fields" {
  let sig = waSelfValidSignature(waSelfVector())
  let statements = [
    Cbor.Text("secret statement"),
    Cbor.Map([]CborEntry(0)),
    Cbor.Map([CborEntry{ key = Cbor.Text("alg"), value = Cbor.Negative(6) }]),
    Cbor.Map(
      [
        CborEntry{ key = Cbor.Text("alg"), value = Cbor.Negative(6) },
        CborEntry{ key = Cbor.Text("alg"), value = Cbor.Negative(6) },
      ],
    ),
    Cbor.Map(
      [
        CborEntry{ key = Cbor.Text("sig"), value = sig },
        CborEntry{ key = Cbor.Text("sig"), value = sig },
      ],
    ),
    Cbor.Map(
      [
        CborEntry{ key = Cbor.Uint(1), value = Cbor.Negative(6) },
        CborEntry{ key = Cbor.Text("sig"), value = sig },
      ],
    ),
  ]
  for stmt of statements {
    let obj = waSelfVector()
    obj.attStmt = stmt
    assert(waSelfError(obj, waSelfHash()) == waSelfFailure, "invalid statement shape")
  }
}

test "packed self refuses x5c format confusion and absent attested key" {
  let obj = waSelfVector()
  let sig = waSelfValidSignature(obj)
  obj.attStmt = Cbor.Map(
    [
      CborEntry{ key = Cbor.Text("alg"), value = Cbor.Negative(6) },
      CborEntry{ key = Cbor.Text("sig"), value = sig },
      CborEntry{ key = Cbor.Text("x5c"), value = Cbor.Array([Cbor.Bytes([]byte("certificate"))]) },
    ],
  )
  assert(waSelfError(obj, waSelfHash()) == waSelfFailure, "x5c belongs to a different verifier")
  let wrong = waSelfVector()
  wrong.fmt = "none"
  assert(waSelfError(wrong, waSelfHash()) == waSelfFailure, "format confusion")
  let absent = waSelfVector()
  absent.authData.attested = Option<AttestedCredential>.None
  assert(waSelfError(absent, waSelfHash()) == waSelfFailure, "no credential")
}
