// The byte length of each vector, taken from the source files the hex was cut
// from, so a damaged paste is caught here and not as a parser failure.
class VecLen {
  name: string,
  hex: string,
  bytes: int,
}

test "vectors: 21 of 21 are well-formed hex of the stated length" {
  let rows = []VecLen{
    VecLen{ name = "vecAtt297", hex = vecAtt297(), bytes = 297 },
    VecLen{ name = "vecAtt909", hex = vecAtt909(), bytes = 909 },
    VecLen{ name = "vecAtt226", hex = vecAtt226(), bytes = 226 },
    VecLen{ name = "vecAtt1045", hex = vecAtt1045(), bytes = 1045 },
    VecLen{ name = "vecAtt415", hex = vecAtt415(), bytes = 415 },
    VecLen{ name = "vecAtt1172", hex = vecAtt1172(), bytes = 1172 },
    VecLen{ name = "vecCd117", hex = vecCd117(), bytes = 117 },
    VecLen{ name = "vecCd115a", hex = vecCd115a(), bytes = 115 },
    VecLen{ name = "vecCd184", hex = vecCd184(), bytes = 184 },
    VecLen{ name = "vecCd98", hex = vecCd98(), bytes = 98 },
    VecLen{ name = "vecCd148", hex = vecCd148(), bytes = 148 },
    VecLen{ name = "vecCd210", hex = vecCd210(), bytes = 210 },
    VecLen{ name = "vecCd234", hex = vecCd234(), bytes = 234 },
    VecLen{ name = "vecCd219", hex = vecCd219(), bytes = 219 },
    VecLen{ name = "vecAd187", hex = vecAd187(), bytes = 187 },
    VecLen{ name = "vecChromeSign", hex = vecChromeSign(), bytes = 37 },
    VecLen{ name = "vecChromeMake", hex = vecChromeMake(), bytes = 148 },
    VecLen{ name = "vecChromeGet", hex = vecChromeGet(), bytes = 37 },
    VecLen{ name = "vecChromeNone", hex = vecChromeNone(), bytes = 178 },
    VecLen{ name = "vecChromeCose", hex = vecChromeCose(), bytes = 77 },
    VecLen{ name = "vecChromeCd", hex = vecChromeCd(), bytes = 184 },
  }
  assert(len(rows) == 21, "rows ${len(rows)}")
  let i = 0
  while (i < len(rows)) {
    let b = decodeHex(rows[i].hex) catch e {
      panic("${rows[i].name}: ${e.message()}")
    }
    assert(len(b) == rows[i].bytes, "${rows[i].name}: ${len(b)} bytes, want ${rows[i].bytes}")
    i = i + 1
  }
}
