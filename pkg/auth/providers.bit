// pkg/auth/providers.bit — the identity providers `OidcStrategy`'s constructor
// (oidc_authorize.bit, #5776) accepts (#5774, #6921): the `Provider` enum,
// the `OidcOptions` class, and the checks behind them — building the issuer
// URL and, for Microsoft, discovering the three multi-tenant aliases whose
// documents `discover()`'s byte-for-byte issuer check (OIDC Discovery 1.0
// §4.3, oidc_discovery.bit) cannot accept as published (#5810). One
// constructor plus a typed option, never one function per provider.
//
// `OidcOptions.tls` is a required option for the three discovery-based
// providers, not a package default, for the identical reason #5776 made it
// explicit on `OidcStrategy`'s constructor: neither `std/http`/`std/tls` nor
// this package exports a way to build a secure-by-default `TlsConfig` from
// outside those modules (see `oidc_discovery.bit`'s file header). It is an
// `Option<TlsConfig>` because a class-typed field has no zero value (E0083,
// SPEC §13.4) and `OidcOptions{}` must compile; `None` fails at construction
// with a message naming the option (#6921).
//
// Scopes (#5811, #6921, #6979): `OidcOptions.scopes` left out requests the
// standard OIDC scopes, `openid email profile` (OIDC Core 1.0 §5.4), for
// every provider; the field default says so directly. A list given
// explicitly replaces it and must include `openid`, so `scopes = []` is
// refused like any other list without it.
// #3960's ruling that this package owns no users table and no
// provider-specific claim MAPPING is about storage; it says nothing about
// which claims a provider returns. Requesting `email`/`profile` stores
// nothing here — it lets the application's own callback see the email
// address and profile claims, which is what almost every "Sign in with
// Google" integration needs. Both providers' live discovery documents list
// all three in `scopes_supported`, confirmed 2026-09-24:
//   $ curl -s https://accounts.google.com/.well-known/openid-configuration
//   {"scopes_supported": ["openid", "email", "profile"], ...}
//   $ curl -s https://login.microsoftonline.com/9188040d-6c67-4c5b-b112-36a304b66dad/v2.0/.well-known/openid-configuration
//   {"scopes_supported":["openid","profile","email","offline_access"],...}
// An application overrides the scopes with `OidcOptions{ scopes = [...] }`.
//
// Google — fetched 2026-09-24:
//   $ curl -s https://accounts.google.com/.well-known/openid-configuration
//   {"issuer": "https://accounts.google.com", ...}
// matching Google's own docs (developers.google.com/identity/openid-connect/openid-connect#discovery).
//
// Microsoft Entra ID (v2.0) issues one discovery document per tenant path
// segment, `https://login.microsoftonline.com/{tenant}/v2.0` (Microsoft
// identity platform, "v2.0 protocols - OpenID Connect",
// learn.microsoft.com/en-us/entra/identity-platform/v2-protocols-oidc). For
// a real, single tenant (a tenant id or verified domain) the document's own
// `issuer` echoes that exact URL back, so `discover()`'s byte-for-byte check
// accepts it. Verified directly, fetched 2026-09-24:
//   $ curl -s https://login.microsoftonline.com/9188040d-6c67-4c5b-b112-36a304b66dad/v2.0/.well-known/openid-configuration
//   {"issuer":"https://login.microsoftonline.com/9188040d-6c67-4c5b-b112-36a304b66dad/v2.0", ...}
//
// The three multi-tenant ALIASES Microsoft documents — `common`,
// `organizations`, `consumers` — do not echo their own URL back.
// `common` and `organizations` serve a document whose `issuer` is the
// LITERAL template string `"https://login.microsoftonline.com/{tenantid}/v2.0"`
// (the placeholder text itself, never substituted); `consumers` serves a
// fixed real tenant GUID, Microsoft's personal-account tenant, that never
// equals the `.../consumers/v2.0` URL it was fetched from. Verified
// directly, fetched 2026-09-24:
//   $ curl -s https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration
//   {"issuer":"https://login.microsoftonline.com/{tenantid}/v2.0", ...}
//   $ curl -s https://login.microsoftonline.com/consumers/v2.0/.well-known/openid-configuration
//   {"issuer":"https://login.microsoftonline.com/9188040d-6c67-4c5b-b112-36a304b66dad/v2.0", ...}
//
// `Provider.Microsoft` handles them without loosening `discover()`'s check
// for anyone else (#5810): each alias passes the one issuer its document is
// known to carry (`discoverAt`, oidc_discovery.bit), and the strictness
// moves to verification time, per Microsoft's own multi-tenant rule
// ("Validate the ID token", learn.microsoft.com/en-us/entra/identity-platform/v2-protocols-oidc):
//
//   - `common`/`organizations`: the resulting `OidcConfig` is `multiTenant`
//     with the template as its `issuer`; `verifyIdToken` substitutes each
//     token's `tid` and requires `iss` to equal it (oidc_tenant.bit), and
//     `OidcOptions.allowedTenants` optionally restricts which tenants may
//     sign in (empty means any tenant).
//   - `consumers`: the document's fixed issuer is the personal-account
//     tenant, so the config is an ordinary fixed-issuer one — every token
//     must carry exactly that issuer, which pins the tenant.
//
// `OidcStrategy`, `OidcConfig`, `JwksCache`, `TokenFetch` and `TlsConfig` are
// already bound module-wide by `oidc_authorize.bit`/`oidc_discovery.bit` (an
// import binds per MODULE, SPEC §17.1); re-importing any of them here is E0042.
import { equalFold, toLower } from "std/strings"
import { emptyTrustStore } from "std/tls"

// The identity provider an `OidcStrategy` signs users in with. `Google` is
// Google's fixed issuer; `Microsoft(tenant)` is Microsoft Entra ID for one
// real tenant (a tenant id or verified domain), or one of the multi-tenant
// aliases `common`/`organizations`/`consumers` (see the file header and
// #5810);
// `Generic(issuer)` is any other conformant OIDC provider, discovered at
// `issuer` with no transformation. All three run `discover` over
// `OidcOptions.tls`. `Apple(key)` is Sign in with Apple, discovered the same
// way and signed with the `AppleKey` from apple.bit (#6946); it needs
// `OidcOptions.stateStore`. `Endpoints(config, jwks)` takes a provider the caller
// already holds, with no network call: a `config` literal and a `JwksCache`
// built from a parsed `Jwks` (`docs/testing.md`).
export enum Provider {
  Google,
  Microsoft(string),
  Generic(string),
  Endpoints(OidcConfig, JwksCache),
  Apple(AppleKey),
}

// The optional knobs of `OidcStrategy(...)`, all defaulting: `scopes` is the
// OIDC Core 1.0 §3.1.2.1 `scope` request, defaulting to `openid email
// profile` (see the file header; a list given must include `openid`);
// `tls` is the `TlsConfig` the discovery-based providers fetch under,
// required for `Google`/`Microsoft`/`Generic`/`Apple` and unused by `Endpoints`;
// `tokenFetch` (#6150) is `handleCallback`'s seam over the token-exchange
// POST, `nil` meaning the real network; `discoveryFetch` (#7252) is the same
// kind of seam over the GETs construction makes (the discovery document, and
// the JWKS the document names, which the strategy refetches on a key
// rotation) for `Google`/`Microsoft`/`Generic`/`Apple`, `nil` meaning the real
// TLS fetch, and when it is set `tls` is not required, the way `tls` is not
// for `OAuth2Options` with a `tokenFetch`; `allowedTenants` (#5810) is the
// list of Entra tenant ids (GUIDs) a `Provider.Microsoft("common")` or
// `Provider.Microsoft("organizations")` strategy accepts sign-ins from, empty
// meaning any tenant. It is refused on every other provider, where it would
// silently do nothing. `postLogoutRedirectUris` (#6951) lists the URIs
// `endSession` (oidc_logout.bit) may send the browser back to after a
// provider-side logout: each https (http only on localhost/127.0.0.1/[::1]),
// no userinfo or fragment, else construction fails; empty means `endSession`
// accepts no `postLogoutRedirectUri` at all.
// `stateStore` (#6946) is where `Provider.Apple` keeps the
// `state` and `nonce` of a login in flight, because Apple's callback is a
// cross-site POST that carries no session cookie: required for Apple, refused
// for every other provider. `second` (#7311) is asked, with the `Identity` the
// ID token makes, whether this user still owes a second factor (`None`: no
// one does); when it says yes the login is bound pending and `handleCallback`
// fails with the 401 `second_factor_required` (mfa.bit).
export class OidcOptions {
  export scopes: []string = ["openid", "email", "profile"],
  export tls: Option<TlsConfig>,
  export tokenFetch: TokenFetch,
  export discoveryFetch: HttpFetch,
  export allowedTenants: []string,
  export postLogoutRedirectUris: []string,
  export stateStore: Option<OneTimeStore>,
  export second: Option<SecondRequired>,
}

// The three Microsoft multi-tenant aliases — see the file header. Compared
// case-insensitively (`equalFold`): Microsoft treats the tenant path segment
// as case-insensitive, and the discovery URL is built from the lowercase
// form.
const msTenantCommon = "common"
const msTenantOrganizations = "organizations"
const msTenantConsumers = "consumers"

// Microsoft's personal-account (MSA) tenant, the issuer tenant of every
// `consumers` token — see the file header.
const msConsumersTenantId = "9188040d-6c67-4c5b-b112-36a304b66dad"

// Whether `tenant` is `common` or `organizations`, the two aliases whose
// tokens carry each user's own tenant id.
fn isMsTemplateTenant(tenant: string): bool {
  return equalFold(tenant, msTenantCommon) || equalFold(tenant, msTenantOrganizations)
}

// The issuer template the `common`/`organizations` documents publish.
fn msIssuerTemplate(): string {
  return "https://login.microsoftonline.com/" + tenantPlaceholder + "/v2.0"
}

// `https://appleid.apple.com`, Apple's OIDC issuer (apple.bit, #6946).
fn appleIssuer(): string {
  return appleIssuerUrl
}

// `https://accounts.google.com`, Google's fixed OIDC issuer — see the file
// header.
fn googleIssuer(): string {
  return "https://accounts.google.com"
}

// `https://login.microsoftonline.com/{tenant}/v2.0`: the issuer of a single
// real tenant, and the URL the three aliases' documents are fetched from.
fn microsoftIssuer(tenant: string): string {
  return "https://login.microsoftonline.com/" + tenant + "/v2.0"
}

// `OidcOptions.allowedTenants` is only meaningful for the two aliases that
// serve many tenants: a failure when it is set for any other provider, or
// holds something that is not a tenant id (GUID) — a typo'd entry would
// otherwise lock every user out, or worse, match nothing and read as
// "restricted" while restricting nothing.
fn checkAllowedTenants(provider: Provider, allowed: []string): ()! {
  if (len(allowed) == 0) {
    return
  }
  match (provider) {
    Microsoft(tenant) => {
      if (!isMsTemplateTenant(tenant)) {
        fail newError("auth: OidcStrategy(): OidcOptions.allowedTenants applies only to Provider.Microsoft(\"common\" or \"organizations\"), not tenant '${tenant}'")
      }
    }
    Google => fail newError("auth: OidcStrategy(): OidcOptions.allowedTenants applies only to Provider.Microsoft(\"common\" or \"organizations\")")
    Generic(issuer) => fail newError("auth: OidcStrategy(): OidcOptions.allowedTenants applies only to Provider.Microsoft(\"common\" or \"organizations\"), not '${issuer}'")
    Endpoints(_, _) => fail newError("auth: OidcStrategy(): OidcOptions.allowedTenants applies only to Provider.Microsoft(\"common\" or \"organizations\"); set OidcConfig.allowedTenants on the config instead")
    Apple(_) => fail newError("auth: OidcStrategy(): OidcOptions.allowedTenants applies only to Provider.Microsoft(\"common\" or \"organizations\"), not Provider.Apple")
  }
  for t of allowed {
    if (!isGuid(t)) {
      fail newError("auth: OidcStrategy(): OidcOptions.allowedTenants entry '${t}' is not a tenant id (GUID)")
    }
  }
}

// Discovery for `Provider.Microsoft(tenant)` over `tls` — see the file
// header. A single real tenant takes the ordinary `discover()` path
// unchanged; `consumers` and `common`/`organizations` fetch from their alias
// URL and expect the one issuer their document publishes. `fetch` is
// `discoverAt`'s test seam (`nil`, the real network, from the constructor).
fn microsoftDiscover(
  tenant: string,
  allowed: []string,
  tls: TlsConfig,
  fetch: HttpFetch,
): OidcConfig! {
  if (equalFold(tenant, msTenantConsumers)) {
    let url = microsoftIssuer(msTenantConsumers)
    return discoverAt(url, microsoftIssuer(msConsumersTenantId), tls, fetch)?
  }
  if (!isMsTemplateTenant(tenant)) {
    return discoverFetch(microsoftIssuer(tenant), tls, fetch)?
  }
  let url = microsoftIssuer(toLower(tenant))
  let doc = discoverAt(url, msIssuerTemplate(), tls, fetch)?
  return OidcConfig{
    issuer = doc.issuer,
    authorizationEndpoint = doc.authorizationEndpoint,
    tokenEndpoint = doc.tokenEndpoint,
    jwksUri = doc.jwksUri,
    endSessionEndpoint = doc.endSessionEndpoint,
    multiTenant = true,
    allowedTenants = allowed,
  }
}

// The `TlsConfig` inside `opts.tls`, or a failure naming the option: the
// discovery-based providers never guess one (see the file header). With
// `opts.discoveryFetch` set no connection is ever opened, so a missing `tls`
// becomes an empty one that nothing dials.
fn requireTls(opts: OidcOptions): TlsConfig! {
  match (opts.tls) {
    Some(cfg) => return cfg
    None => {
      if (opts.discoveryFetch != nil) {
        return TlsConfig(emptyTrustStore())
      }
      fail newError("auth: OidcStrategy(): OidcOptions.tls is required for Provider.Google, Provider.Microsoft, Provider.Generic and Provider.Apple unless OidcOptions.discoveryFetch is set (discovery runs over an explicit TlsConfig, see oidc_discovery.bit)")
    }
  }
}

// A list missing `"openid"` fails (OIDC Core 1.0 §3.1.2.1: "Scope... MUST
// contain the openid scope value" — `beginAuthorization`'s whole flow is
// OpenID Connect, never bare OAuth2).
fn checkScopes(scopes: []string): ()! {
  for scope of scopes {
    if (scope == "openid") {
      return
    }
  }
  fail newError("auth: OidcStrategy(): OidcOptions.scopes '${join(scopes, " ")}' must include \"openid\" (OIDC Core 1.0 §3.1.2.1)")
}
