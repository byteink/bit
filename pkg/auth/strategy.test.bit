// pkg/auth/strategy.test.bit — Identity's Json claims, and the private
// encode/decode round trip requireAuth/currentIdentity (middleware.bit)
// share. `jsonIsNull` is new to the module; every other `std/json` name
// used here is already imported module-wide by strategy.bit (E0042).
import { jsonIsNull } from "std/json"

fn sampleClaims(): Json {
  return Json.JsonObject(
    []JsonEntry{
      JsonEntry{ key = "aud", value = Json.JsonArray([]Json{ Json.JsonString("api") }) },
      JsonEntry{ key = "sub", value = Json.JsonString("u1") },
    },
  )
}

fn mustDecodeIdentity(s: string): Identity {
  return decodeIdentity(s) catch e {
    panic("decodeIdentity: ${e.message()}")
  }
}

// Whether `decodeIdentity(s)` failed. A real function, not a bare
// statement, so the `catch` block's `return true` can divert — the same
// shape session.test.bit's `sessionError` uses.
fn decodeIdentityFails(s: string): bool {
  decodeIdentity(s) catch _ {
    return true
  }
  return false
}

test "encodeIdentity/decodeIdentity round-trips id and structured claims" {
  let id = Identity{ id = "u1", claims = sampleClaims() }
  let decoded = mustDecodeIdentity(encodeIdentity(id))

  assert(decoded.id == "u1", "want id 'u1', got '${decoded.id}'")
  assert(
    jsonEncode(decoded.claims) == jsonEncode(sampleClaims()),
    "claims must round-trip unchanged",
  )
}

test "decodeIdentity round-trips a JsonNull claims value" {
  let id = Identity{ id = "u2", claims = Json.JsonNull }
  let decoded = mustDecodeIdentity(encodeIdentity(id))

  assert(decoded.id == "u2", "want id 'u2', got '${decoded.id}'")
  assert(jsonIsNull(decoded.claims), "want JsonNull claims, got a value")
}

test "decodeIdentity fails on malformed input" {
  assert(decodeIdentityFails("not json"), "decodeIdentity must fail on non-JSON input")
}

// --- bindSession's BindOptions (#6954) ----------------------------------------
//
// `App`, `Config`, `MemoryStore` and `Request` are bound module-wide by
// middleware.test.bit. Each case is one route that binds twice on one session
// and answers what `currentIdentity` then says.

fn stApp(handler: (Ctx) => Res!): App {
  let app = App(Config{ secret = "test-secret", sessions = MemoryStore(1000) })
  app.get("/x", handler)
  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  return app
}

fn stReq(): Request {
  return Request{ method = "GET", path = "/x", headers = "", body = "" }
}

fn stId(): Identity {
  return Identity{ id = "u1", claims = Json.JsonNull }
}

test "bindSession with second demotes a bound session: currentIdentity answers second_factor_required" {
  let app = stApp((c) => {
    bindSession(c, stId())?
    bindSession(c, stId(), BindOptions{ second = true })?
    return c.text(currentIdentity(c)?.id)
  })
  let res = app.handle(stReq())
  assert(res.status == 401, "want 401, got ${res.status}")
  assert(contains(res.body, "second_factor_required"), "want the code, got '${res.body}'")
}

test "a full bindSession over a pending one clears the pending state" {
  let app = stApp((c) => {
    bindSession(c, stId(), BindOptions{ second = true })?
    bindSession(c, stId())?
    return c.text(currentIdentity(c)?.id)
  })
  let res = app.handle(stReq())
  assert(res.status == 200 && res.body == "u1", "want 200 u1, got ${res.status} '${res.body}'")
}

test "bindSession with second rejects a pendingTtl below 1 second and an empty id" {
  let ttlFailed = false
  let idFailed = false
  let app = stApp((c) => {
    bindSession(c, stId(), BindOptions{ second = true, pendingTtl = 0 }) catch _ {
      ttlFailed = true
    }
    bindSession(c, Identity{ id = "", claims = Json.JsonNull }, BindOptions{ second = true }) catch _ {
      idFailed = true
    }
    return c.text("done")
  })
  app.handle(stReq())
  assert(ttlFailed, "pendingTtl = 0 must fail")
  assert(idFailed, "an empty id must fail on the pending path too")
}

test "a pending bind files the session under the subject index, so logoutEverywhere reaches it" {
  let store = MemoryStore(1000)
  let app = App(Config{ secret = "test-secret", sessions = store })
  app.get("/x", (c) => {
    bindSession(c, stId(), BindOptions{ second = true })?
    return c.text("pending")
  })
  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  app.handle(stReq())
  let n = logoutEverywhere(store, "u1") catch e {
    panic("logoutEverywhere: ${e.message()}")
  }
  assert(n == 1, "want 1 pending session revoked, got ${n}")
}
