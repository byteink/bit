// pkg/auth/oidc_tenant.bit — the multi-tenant half of ID token validation
// (#5810): checking a token's `iss` against an issuer TEMPLATE whose
// `{tenantid}` placeholder is filled from the token's own `tid` claim,
// instead of one fixed string.
//
// Why a fixed `iss` cannot work for Microsoft Entra's `common` and
// `organizations` endpoints: one discovery document serves every tenant, and
// its `issuer` member is the literal template
// `https://login.microsoftonline.com/{tenantid}/v2.0`, while each token's
// `iss` carries the signing-in user's real tenant id. Microsoft's own rule
// (Microsoft identity platform, "v2.0 protocols - OpenID Connect", "Validate
// the ID token", learn.microsoft.com/en-us/entra/identity-platform/v2-protocols-oidc;
// and "Validate tokens", .../identity-platform/access-tokens#validate-tokens):
// for a multi-tenant app, replace `{tenantid}` in the discovery document's
// issuer with the `tid` claim and compare that with the token's `iss`.
// OIDC Core 1.0 §3.1.3.7 rule 2 (the Issuer Identifier MUST exactly match
// the `iss` claim) is satisfied by the exact comparison below; the template
// is how this provider's issuer identifier is parameterised, not a looser
// match.
//
// Three things make this safe, all enforced by `checkTenantIssuer` AFTER
// `verifyToken` (std/jwt) has verified the signature (no claim is trusted
// before that, see oidc_verify.bit):
//
//   - `tid` must be a GUID (`isGuid`): hex digits and dashes in the 8-4-4-4-12
//     layout, so nothing a token carries can add a path segment, a query or
//     a second placeholder to the issuer built from it;
//   - `iss` must equal the template with that exact `tid` substituted,
//     byte-for-byte — never a prefix, suffix or case-folded match;
//   - when `OidcConfig.allowedTenants` is non-empty, the `tid` must be one of
//     them (an app that serves only some customers' tenants), compared
//     case-insensitively because a GUID's hex case carries no meaning.
//
// `Json`, `isSome`, `unwrap`, `jsonGet`, `jsonAsString`, `equalFold` and
// `OidcConfig` are already bound module-wide by
// `strategy.bit`/`oidc_discovery.bit`/`providers.bit`/`oidc_verify.bit` (an
// import binds per MODULE, SPEC §17.1); re-importing any of them here is
// E0042. `contains` and `replace` are new to this module.
import { contains, replace } from "std/strings"

// The literal placeholder Microsoft's `common`/`organizations` discovery
// documents put where the tenant id goes (verified 2026-09-24, see
// providers.bit's file header).
const tenantPlaceholder = "{tenantid}"

// Whether `s` is a GUID in the canonical 8-4-4-4-12 form (RFC 9562 §4's
// textual layout, hex digits of either case) — the shape of every Entra
// tenant id.
fn isGuid(s: string): bool {
  if (len(s) != 36) {
    return false
  }
  let i = 0
  while (i < 36) {
    if (!guidByteOk(i, s[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

// Whether byte `c` is valid at offset `i` of a GUID: a dash at the four
// group boundaries, a hex digit everywhere else.
fn guidByteOk(i: int, c: u8): bool {
  if (i == 8 || i == 13 || i == 18 || i == 23) {
    return c == '-'
  }
  return isHexDigit(c)
}

fn isHexDigit(c: u8): bool {
  return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}

// Whether `tid` is in `allowed`, or `allowed` is empty (any tenant).
fn tenantAllowed(tid: string, allowed: []string): bool {
  if (len(allowed) == 0) {
    return true
  }
  for t of allowed {
    if (equalFold(t, tid)) {
      return true
    }
  }
  return false
}

// The string claim `name` of `payload`, or a failure naming it.
fn requireStringClaim(payload: Json, name: string): string! {
  let claim = jsonGet(payload, name)
  if (!isSome(claim)) {
    fail newError("auth: verifyIdToken(): missing '${name}' claim")
  }
  let v = jsonAsString(unwrap(claim))
  if (!isSome(v)) {
    fail newError("auth: verifyIdToken(): '${name}' claim is not a string")
  }
  return unwrap(v)
}

// The multi-tenant `iss` check for a signature-verified `payload` against
// `config` (`config.multiTenant`, `config.issuer` the template) — see the
// file header for the three rules.
fn checkTenantIssuer(payload: Json, config: OidcConfig): ()! {
  if (!contains(config.issuer, tenantPlaceholder)) {
    fail newError("auth: verifyIdToken(): multi-tenant issuer '${config.issuer}' has no ${tenantPlaceholder} placeholder")
  }
  let tid = requireStringClaim(payload, "tid")?
  if (!isGuid(tid)) {
    fail newError("auth: verifyIdToken(): 'tid' claim is not a GUID")
  }
  let iss = requireStringClaim(payload, "iss")?
  let want = replace(config.issuer, tenantPlaceholder, tid)
  if (iss != want) {
    fail newError("auth: verifyIdToken(): unexpected issuer: token iss '${iss}' does not match its tid '${tid}'")
  }
  if (!tenantAllowed(tid, config.allowedTenants)) {
    fail newError("auth: verifyIdToken(): tenant '${tid}' is not in the allowed tenants")
  }
}
