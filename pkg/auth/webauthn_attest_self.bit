// Packed self attestation verifies possession of the credential key, not identity
// or trust. The registration ceremony and policy remain separate (#6960).
// W3C Web Authentication Level 3 section 8.2, self-attestation procedure.
const waSelfFailure = "auth: webauthn: invalid packed self attestation"

fn waSelfEntries(stmt: Cbor): []CborEntry! {
  match (stmt) {
    Map(entries) => {
      if (len(entries) == 2) {
        return entries
      }
    }
    _ => {}
  }
  fail newError(waSelfFailure)
}

fn waSelfAlg(value: Cbor): int! {
  match (value) {
    Negative(n) => {
      if (n <= 256) {
        return -1 - int(n)
      }
    }
    _ => {}
  }
  fail newError(waSelfFailure)
}

fn waSelfSignature(value: Cbor): []byte! {
  match (value) {
    Bytes(sig) => {
      if (len(sig) > 0 && len(sig) <= 1024) {
        return sig
      }
    }
    _ => {}
  }
  fail newError(waSelfFailure)
}

fn waCheckPackedSelf(obj: AttestationObject, clientDataHash: []byte): ()! {
  if (obj.fmt != "packed" || len(clientDataHash) != 32) {
    fail newError(waSelfFailure)
  }
  if (!isSome(obj.authData.attested) || len(obj.authData.raw) > 262144) {
    fail newError(waSelfFailure)
  }
  // Exactly alg and sig excludes x5c and ambiguous duplicate statement fields.
  let entries = waSelfEntries(obj.attStmt)?
  let alg = waSelfAlg(waRequire(entries, "alg")?)?
  let sig = waSelfSignature(waRequire(entries, "sig")?)?
  let credential = unwrap(obj.authData.attested)
  if (alg != coseAlg(credential.publicKey)) {
    fail newError(waSelfFailure)
  }
  let message = append([]byte(0), ...obj.authData.raw)
  message = append(message, ...clientDataHash)
  if (!coseVerify(credential.publicKey, alg, message, sig)?) {
    fail newError(waSelfFailure)
  }
}

// The parser retains the signed bytes verbatim; do not reconstruct authData.
fn verifyPackedSelfAttestation(obj: AttestationObject, clientDataHash: []byte): ()! {
  waCheckPackedSelf(obj, clientDataHash) catch _ {
    fail newError(waSelfFailure)
  }
}
