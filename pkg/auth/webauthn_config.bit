// pkg/auth/webauthn_config.bit — what a relying party decides once, at
// startup, before it serves a passkey ceremony (#6958): its identity, its
// allowed origins and its policy. Everything here is checked when `WebAuthn(...)`
// is built, so a mistake (an RP ID no origin can match, a plain-http origin, an
// algorithm nothing can verify) stops the app when it starts and does not turn
// into a registration that silently never works.
//
// W3C Web Authentication Level 3: section 5.1.3 and 13.4.2 (the RP ID is the
// origin's effective domain or a registrable suffix of it), 5.4 and 5.4.3 to
// 5.4.6 (the policy values), 13.4.3 (challenge length) and 7.1 (the ceremony).
//
// `hasPrefix`, `hasSuffix`, `indexOf`, `parseInt` and `Option` are already
// bound module-wide (SPEC §17.1); re-importing any of them here is E0042.

// Whether the authenticator must verify the user (PIN, biometric) during the
// ceremony: section 5.4.6.
export enum UserVerification {
  Required
  Preferred
  Discouraged

  // The value section 5.4.6 puts on the wire.
  export wire(): string {
    match (this) {
      Required => return "required"
      Preferred => return "preferred"
      Discouraged => return "discouraged"
    }
  }
}

// Whether the credential must be a discoverable one (a passkey the browser can
// offer without a username): section 5.4.4.
export enum ResidentKey {
  Required
  Preferred
  Discouraged

  // The value section 5.4.4 puts on the wire.
  export wire(): string {
    match (this) {
      Required => return "required"
      Preferred => return "preferred"
      Discouraged => return "discouraged"
    }
  }
}

// Which kind of authenticator may be used: section 5.4.5. `Any` leaves it to
// the user and omits the member.
export enum Attachment {
  Any
  Platform
  CrossPlatform

  // The value section 5.4.5 puts on the wire; empty for `Any`.
  export wire(): string {
    match (this) {
      Any => return ""
      Platform => return "platform"
      CrossPlatform => return "cross-platform"
    }
  }
}

// What the relying party asks the authenticator to say about itself: section
// 5.4.7. `finishRegistration` accepts the `none` format only; asking for more
// is allowed (a client may still answer `none`), and a response in another
// format fails naming it.
export enum AttestationConveyance {
  None
  Indirect
  Direct
  Enterprise

  // The value section 5.4.7 puts on the wire.
  export wire(): string {
    match (this) {
      None => return "none"
      Indirect => return "indirect"
      Direct => return "direct"
      Enterprise => return "enterprise"
    }
  }
}

// The relying party. `id` is the domain credentials are scoped to (the
// authenticator hashes it into every `rpIdHash`): the host of every origin or a
// parent domain of it, for example `example.com` for `https://login.example.com`.
// `name` is shown to the user by the browser. `origins` are the exact origins
// (`https://example.com`, with a port when it is not 443) a ceremony may come
// from; `topOrigins` are the embedding pages a cross-origin ceremony may come
// from, empty when you embed nowhere.
export class RelyingParty {
  export id: string,
  export name: string,
  export origins: []string,
  export topOrigins: []string = [],
}

// The user being registered. `id` is YOUR stable identifier for them, the
// "user handle": opaque, at most 64 bytes, never an e-mail address or anything
// else a person could read or that changes. It is the same string `Credential.userId`
// and `CredentialStore.forUser` use. `name` is what the browser shows to pick
// an account (an e-mail or a handle) and `displayName` a friendlier label.
export class UserEntity {
  export id: string,
  export name: string,
  export displayName: string,
}

// The policy of a `WebAuthn`. `algorithms` are COSE algorithm numbers in order
// of preference: -7 ES256, -8 EdDSA, -257 RS256 by default; -35 ES384 and -37
// PS256 are accepted too. `timeoutMs` is the hint the browser gets for how long
// the user has; the challenge itself lives 5 minutes whatever it says.
export class WebAuthnOptions {
  export algorithms: []int = [-7, -8, -257],
  export userVerification: UserVerification = UserVerification.Preferred,
  export residentKey: ResidentKey = ResidentKey.Preferred,
  export attachment: Attachment = Attachment.Any,
  export attestation: AttestationConveyance = AttestationConveyance.None,
  export timeoutMs: int = 300000,
}

// The COSE algorithms `parseCoseKey` and `coseVerify` (std/crypto, cose.bit)
// can verify: ES256, ES384, EdDSA, PS256, RS256.
fn webAuthnKnownAlg(alg: int): bool {
  return alg == -7 || alg == -35 || alg == -8 || alg == -37 || alg == -257
}

// A non-empty list with no duplicate, every entry one `coseVerify` can check.
fn checkAlgorithms(algs: []int): ()! {
  if (len(algs) == 0) {
    fail newError("auth: WebAuthn(): `algorithms` is empty — list at least one, for example [-7, -257]")
  }
  let i = 0
  while (i < len(algs)) {
    if (!webAuthnKnownAlg(algs[i])) {
      fail newError("auth: WebAuthn(): algorithm ${algs[i]} cannot be verified — use -7 ES256, -35 ES384, -8 EdDSA, -37 PS256 or -257 RS256")
    }
    let j = i + 1
    while (j < len(algs)) {
      if (algs[j] == algs[i]) {
        fail newError("auth: WebAuthn(): algorithm ${algs[i]} is listed twice")
      }
      j = j + 1
    }
    i = i + 1
  }
}

// Whether every byte of `host` is a lower-case hostname character.
fn webAuthnHostChars(host: string): bool {
  let b = []byte(host)
  let i = 0
  while (i < len(b)) {
    let ch = b[i]
    let ok = (ch >= 0x61 && ch <= 0x7a) || (ch >= 0x30 && ch <= 0x39) || ch == 0x2d || ch == 0x2e
    if (!ok) {
      return false
    }
    i = i + 1
  }
  return len(b) > 0
}

// The `:port` at the end of an origin's authority: 1 to 5 digits, 1 to 65535.
fn webAuthnPortOk(port: string): bool {
  if (len(port) == 0 || len(port) > 5) {
    return false
  }
  let n = parseInt(port) catch _ {
    return false
  }
  return n >= 1 && n <= 65535 && !hasPrefix(port, "0")
}

// What follows the scheme of `origin`: `https://` for any host, `http://` only
// when the host is `localhost` (checked by the caller once it has the host).
fn webAuthnAuthority(origin: string, what: string): string! {
  if (hasPrefix(origin, "https://")) {
    return origin[8:]
  }
  if (hasPrefix(origin, "http://localhost")) {
    return origin[7:]
  }
  fail newError("auth: WebAuthn(): ${what} '${origin}' must be https://host[:port] (http only for localhost)")
}

// The host in `authority` (`host[:port]`), with the port checked.
fn webAuthnSplitPort(authority: string, origin: string, what: string): string! {
  let colon = indexOf(authority, ":")
  if (colon < 0) {
    return authority
  }
  if (!webAuthnPortOk(authority[colon + 1:])) {
    fail newError("auth: WebAuthn(): ${what} '${origin}' has a bad port")
  }
  return authority[:colon]
}

// The host of `origin`, a serialised origin (section 5.1.3, RFC 6454 section 6):
// `https://host[:port]`, or `http://localhost[:port]` for development, with no
// path, query, user information or upper-case. `what` names the setting for the
// error message.
fn webAuthnOriginHost(origin: string, what: string): string! {
  let host = webAuthnSplitPort(webAuthnAuthority(origin, what)?, origin, what)?
  if (!webAuthnHostChars(host) ||
    hasPrefix(host, ".") ||
    hasSuffix(host, ".") ||
    hasPrefix(host, "-")) {
    fail newError("auth: WebAuthn(): ${what} '${origin}' is not a lower-case scheme://host[:port] origin")
  }
  if (!hasPrefix(origin, "https://") && host != "localhost") {
    fail newError("auth: WebAuthn(): ${what} '${origin}' must be https (http only for localhost)")
  }
  return host
}

// Section 5.1.3 / 13.4.2: the RP ID is the origin's host or a dot-bounded
// suffix of it. A one-label RP ID (`com`) would be a suffix of every `.com`
// host, so only `localhost` may have one. The public suffix list is not
// consulted: the browser refuses an RP ID that is one, so registration would
// fail there.
fn webAuthnCheckRpId(rp: RelyingParty, host: string, origin: string): ()! {
  let ok = host == rp.id || hasSuffix(host, "." + rp.id)
  if (!ok) {
    fail newError("auth: WebAuthn(): RelyingParty.id '${rp.id}' is not the host of origin '${origin}' or a parent domain of it")
  }
}

// The RP ID alone: a bare lower-case domain of at least two labels.
fn webAuthnCheckId(id: string): ()! {
  if (!webAuthnHostChars(id) || hasPrefix(id, ".") || hasSuffix(id, ".")) {
    fail newError("auth: WebAuthn(): RelyingParty.id '${id}' must be a bare lower-case domain, no scheme, port or path")
  }
  if (indexOf(id, ".") < 0 && id != "localhost") {
    fail newError("auth: WebAuthn(): RelyingParty.id '${id}' is a single label; use your registrable domain, for example example.com")
  }
}

// The relying party as given: an id, a name, at least one origin, every origin
// well-formed and under the id, every top origin well-formed.
fn checkRelyingParty(rp: RelyingParty): ()! {
  if (rp.id == "" || rp.name == "") {
    fail newError("auth: WebAuthn(): RelyingParty needs a non-empty `id` and `name`")
  }
  webAuthnCheckId(rp.id)?
  if (len(rp.origins) == 0) {
    fail newError("auth: WebAuthn(): RelyingParty.origins is empty — list the origin the browser sends, for example https://${rp.id}")
  }
  for origin of rp.origins {
    webAuthnCheckRpId(rp, webAuthnOriginHost(origin, "origin")?, origin)?
  }
  for top of rp.topOrigins {
    let _ = webAuthnOriginHost(top, "top origin")?
  }
}
