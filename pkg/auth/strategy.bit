// pkg/auth/strategy.bit — the Strategy every authentication method
// implements (#3960), and the Identity a successful one produces.
//
// `Strategy` is an INTERFACE, not the trait #3960's body first spelled: a
// trait is never a type (SPEC §10.7) — it supplies method BODIES to a class
// and cannot appear as a parameter, so `requireAuth(strategies: []Strategy)`
// (middleware.bit) could not have been declared with one. `pkg/web`'s
// `SessionStore` (session.bit) made the identical correction for
// `Config.sessions`, for the same reason. A structural `interface` (§14.3)
// needs no `implements` declaration, so a password strategy, an OIDC
// strategy and a test's own stub all satisfy it by having the two methods.
import { Ctx } from "../web"
import {
  Json,
  JsonEntry,
  jsonDecMember,
  jsonDecObject,
  jsonDecString,
  jsonEncode,
  jsonGet,
  jsonParse,
} from "std/json"
import { isSome, unwrap } from "std/core"

export interface Strategy {
  name(): string,
  authenticate(c: Ctx): Identity!,
}

// A verified caller. `claims` is a `Json` value (std/json) rather than a
// `[string]string` map — DECIDED before dispatch (integrator, #5770): an
// OIDC ID token's claims hold arrays (`aud`) and nested objects a string
// map would truncate, and a password lookup's callback already builds a
// JSON object. `Json` fits both without either strategy reshaping what it
// found.
export class Identity {
  export id: string,
  export claims: Json,
}

// The session key `requireAuth` (middleware.bit) stores an authenticated
// Identity's encoding under, and `currentIdentity` reads it back from.
// Fixed rather than configurable: a second key is a second place a stale
// identity could be read from, and no ticket has asked for more than one.
const identitySessionKey = "auth:identity"

// `id` as the session stores it. `encodeIdentity`/`decodeIdentity` are each
// other's exact inverse, which is the whole reason `claims` is `Json` and
// not a map: a `Json` value already knows how to round-trip itself through
// `jsonEncode`/`jsonParse` with no truncation.
fn encodeIdentity(id: Identity): string {
  let fields = []JsonEntry{
    JsonEntry{ key = "id", value = Json.JsonString(id.id) },
    JsonEntry{ key = "claims", value = id.claims },
  }
  return jsonEncode(Json.JsonObject(fields))
}

// The inverse of `encodeIdentity`. Fails on anything that is not that
// shape: not JSON, no "id" key, or "id" not a string. `claims` is read
// with `jsonGet` rather than `jsonDecMember`, which treats an explicit
// JSON `null` the same as a missing key — a `Json.JsonNull` claims value is
// a legitimate encoding this function must still round-trip, the same
// presence/emptiness line `session.bit`'s own `SessionStore` doc draws.
fn decodeIdentity(s: string): Identity! {
  let j = jsonParse(s)?
  let entries = jsonDecObject(j, "auth:identity", 0)?
  let idField = jsonDecMember(entries, "auth:identity", "id")?
  let id = jsonDecString(idField, "auth:identity.id")?
  let claims = jsonGet(j, "claims")
  if (isSome(claims)) {
    return Identity{ id = id, claims = unwrap(claims) }
  }
  return Identity{ id = id, claims = Json.JsonNull }
}
