// pkg/auth/strategy.bit — the Strategy every authentication method
// implements (#3960), and the Identity a successful one produces.
//
// `Strategy` is an INTERFACE, not the trait #3960's body first spelled: a
// trait is never a type (SPEC §10.7) — it supplies method BODIES to a class
// and cannot appear as a parameter, so `requireAuth(strategies: []Strategy)`
// (middleware.bit) could not have been declared with one. `pkg/web`'s
// `SessionStore` (session.bit) made the identical correction for
// `Config.sessions`, for the same reason. A structural `interface` (§14.3)
// needs no `implements` declaration, so a password strategy, an OIDC
// strategy and a test's own stub all satisfy it by having the two methods.
import { Ctx } from "web"
import {
  Json,
  JsonEntry,
  jsonDecMember,
  jsonDecObject,
  jsonDecString,
  jsonEncode,
  jsonGet,
  jsonParse,
} from "std/json"
import { isSome, unwrap } from "std/core"
import { now, Second } from "std/time"

// CONTRACT (#6093, #6953): a successful `authenticate(c)` regenerates the
// session id (`Session.regenerate()`, pkg/web/session.bit) exactly once, and
// then calls `bindSession(c, identity)` before returning its `Identity` —
// session fixation (#5795, `docs/security.md`) closes at the first, and
// "log out everywhere" (`logoutEverywhere`, revoke.bit) can only find the
// session if the second ran. `bindSession` is the ONLY place an Identity is
// written to a session, so a strategy never calls `session.set` with
// `identitySessionKey` itself. `PasswordStrategy` (password.bit),
// `MagicLinkStrategy` (magiclink.bit), `OAuth2Strategy` (oauth2.bit) and
// `handleCallback` (oidc_callback.bit, Apple included) all follow this; a
// new `Strategy` must too. The exception is a STATELESS strategy:
// `BearerStrategy` (bearer.bit) carries its credential on every request, so
// it creates and regenerates no session — there is no login step for a
// fixated session id to survive (#6947). `requireAuth` (middleware.bit)
// still binds what such a strategy returned, so the session it makes is
// revocable too.
export interface Strategy {
  name(): string,
  authenticate(c: Ctx): Identity!,
}

// A verified caller. `claims` is a `Json` value (std/json) rather than a
// `[string]string` map — DECIDED before dispatch (integrator, #5770): an
// OIDC ID token's claims hold arrays (`aud`) and nested objects a string
// map would truncate, and a password lookup's callback already builds a
// JSON object. `Json` fits both without either strategy reshaping what it
// found.
export class Identity {
  export id: string,
  export claims: Json,
}

// The session key `requireAuth` (middleware.bit) stores an authenticated
// Identity's encoding under, and `currentIdentity` reads it back from.
// Fixed rather than configurable: a second key is a second place a stale
// identity could be read from, and no ticket has asked for more than one.
const identitySessionKey = "auth:identity"

// The session index key (`Session.index`, pkg/web/session.bit) every
// authenticated session is filed under, with the Identity's `id` as the
// value. `logoutEverywhere` (revoke.bit) is the one call that uses it; an
// app that holds its own `SessionStore` can pass it to `destroyIndexed`
// directly, which is what the call does.
export const subjectIndexKey = "auth:sub"

// The session keys of a half-logged-in session (#6954): the Identity the
// first factor verified, and the unix second it stops counting. Written
// ONLY by `bindSession` with `BindOptions.second`, and read only by
// `pendingIdentity` (mfa.bit) and `pendingActive`. They are separate keys
// from `identitySessionKey` on purpose: every reader of the session identity
// (`currentIdentity`, `requireAuth`, a custom strategy) looks at that one key,
// so a password-only session has nothing there to find (NIST SP 800-63B
// section 4.2: no access at AAL2 before both factors).
const pendingSessionKey = "auth:pending"
const pendingExpiryKey = "auth:pending-exp"

// How long a half-logged-in session waits for its second factor, in seconds.
const pendingDefaultTtl: i64 = 300

// What `bindSession` is asked to do with the Identity. `BindOptions{}` is a
// full login. `second = true` is the first half of a two-factor login: the
// Identity is held under a pending key that `requireAuth` and
// `currentIdentity` refuse with 401 `second_factor_required` until
// `completeSecondFactor` (mfa.bit) promotes it, and for `pendingTtl` seconds
// at most (default 300; a user who walked away is signed out of the half
// login, not left one code short of an account for a day). Binding with
// `second = true` over a session that is already fully bound demotes it. A
// first-factor strategy does not need that: give it `second` in its options
// (`PasswordOptions.second` and the like, #7311) and it binds pending itself,
// so no full session exists first.
export class BindOptions {
  export second: bool = false,
  export pendingTtl: i64 = pendingDefaultTtl,
}

// The ONLY writer of `identitySessionKey` and of the pending keys: stores
// `id` on `c`'s session (under the pending keys when `opts.second`, under
// `identitySessionKey` otherwise, and removes it from the other place, so the
// two never both hold a login), files the session under `subjectIndexKey` ->
// `id.id` so it can be revoked with the user's other sessions, and saves, so
// the index is in the store when this returns rather than at the request's
// autosave. Call it after `Session.regenerate()`, which carries the index to
// the new id. An empty `id.id` fails: `Session.index` would panic, and an
// Identity with no subject is a login no one could ever be logged out of. So
// does a `pendingTtl` below 1 second on a `second` bind: a half login that is
// born expired could never be completed.
export fn bindSession(c: Ctx, id: Identity, opts: BindOptions = BindOptions{}): ()! {
  if (id.id == "") {
    fail newError("auth: bindSession(): the Identity has an empty id, so its session could not be revoked by subject")
  }
  if (opts.second && opts.pendingTtl < 1) {
    fail newError("auth: bindSession(): `pendingTtl` is ${opts.pendingTtl} second(s) — it must be at least 1")
  }
  let session = c.session()?
  if (opts.second) {
    session.set(pendingSessionKey, encodeIdentity(id))
    session.set(pendingExpiryKey, "${now().ns / Second + opts.pendingTtl}")
    session.delete(identitySessionKey)
  } else {
    session.set(identitySessionKey, encodeIdentity(id))
    session.delete(pendingSessionKey)
    session.delete(pendingExpiryKey)
  }
  session.index(subjectIndexKey, id.id)
  session.save()?
}

// `id` as the session stores it. `encodeIdentity`/`decodeIdentity` are each
// other's exact inverse, which is the whole reason `claims` is `Json` and
// not a map: a `Json` value already knows how to round-trip itself through
// `jsonEncode`/`jsonParse` with no truncation.
fn encodeIdentity(id: Identity): string {
  let fields = []JsonEntry{
    JsonEntry{ key = "id", value = Json.JsonString(id.id) },
    JsonEntry{ key = "claims", value = id.claims },
  }
  return jsonEncode(Json.JsonObject(fields))
}

// The inverse of `encodeIdentity`. Fails on anything that is not that
// shape: not JSON, no "id" key, or "id" not a string. `claims` is read
// with `jsonGet` rather than `jsonDecMember`, which treats an explicit
// JSON `null` the same as a missing key — a `Json.JsonNull` claims value is
// a legitimate encoding this function must still round-trip, the same
// presence/emptiness line `session.bit`'s own `SessionStore` doc draws.
fn decodeIdentity(s: string): Identity! {
  let j = jsonParse(s)?
  let entries = jsonDecObject(j, "auth:identity", 0)?
  let idField = jsonDecMember(entries, "auth:identity", "id")?
  let id = jsonDecString(idField, "auth:identity.id")?
  let claims = jsonGet(j, "claims")
  if (isSome(claims)) {
    return Identity{ id = id, claims = unwrap(claims) }
  }
  return Identity{ id = id, claims = Json.JsonNull }
}
