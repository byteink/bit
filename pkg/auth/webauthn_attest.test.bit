// W3C REC 2026-08-25 sections 16.1 and 16.7, exact published DER and CBOR.
// https://www.w3.org/TR/2026/REC-webauthn-3-20260825/#sctn-test-vectors-packed-es256
import { asn1BigInteger } from "std/crypto"

fn waBasicVector(): AttestationObject {
  return waAtt("")
}
fn waBasicClient(): []byte {
  return waHex("")
}
fn waBasicHash(): []byte { return digest(Sha256(), waBasicClient()) }
fn waBasicRoot(): Certificate {
  return x509Parse(waHex("")) catch e {
    panic(e.message())
  }
}
fn waAttestError(
  obj: AttestationObject,
  hash: []byte,
  policy: AttestationPolicy = AttestationPolicy{},
): string {
  verifyAttestation(obj, hash, policy) catch e {
    return e.message()
  }
  return "accepted"
}

fn waBasicWithCert(tree: Element): AttestationObject {
  let obj = waBasicVector()
  let entries = waPackedEntries(obj.attStmt) catch e {
    panic(e.message())
  }
  entries[2] = CborEntry{
    key = Cbor.Text("x5c"),
    value = Cbor.Array([Cbor.Bytes(asn1Encode(tree))]),
  }
  obj.attStmt = Cbor.Map(entries)
  return obj
}

test "attestation official self and basic vectors verify with distinct results" {
  let self = verifyAttestation(waSelfVector(), waSelfHash(), AttestationPolicy{}) catch e {
    panic(e.message())
  }
  assert(
    self.fmt == "packed" && self.kind == "self" && !self.trusted && len(self.chain) == 0,
    "self result",
  )
  let basic = verifyAttestation(waBasicVector(), waBasicHash(), AttestationPolicy{}) catch e {
    panic(e.message())
  }
  assert(
    basic.kind == "basic" && !basic.trusted && len(basic.chain) == 1,
    "ignored trust is never trusted",
  )
}

test "attestation official basic vector chains to configured W3C root" {
  let policy = AttestationPolicy{ trust = AttestationTrust.Verify, roots = [waBasicRoot()] }
  let result = verifyAttestation(waBasicVector(), waBasicHash(), policy) catch e {
    panic(e.message())
  }
  assert(result.trusted && result.kind == "basic", "validated trust path")
}

test "attestation rejects invalid basic signature" {
  let obj = waBasicVector()
  obj.authData.raw[36] ^= 1
  assert(waAttestError(obj, waBasicHash()) != "accepted", "signed authData")
}

test "attestation rejects self algorithm mismatch" {
  let obj = waSelfVector()
  obj.attStmt = waSelfStmt(Cbor.Negative(7), waSelfValidSignature(obj))
  assert(waAttestError(obj, waSelfHash()) != "accepted", "self alg mismatch")
}

test "attestation rejects certificate version other than v3" {
  let tree = waCertTree()
  tree.children[0].children[0] = asn1ExplicitTag(0, asn1Integer(0))
  assert(contains(waAttestError(waBasicWithCert(tree), waBasicHash()), "certificate"), "v1 refused")
}

test "attestation rejects CA leaf" {
  let tree = waCertTree()
  tree.children[0].children[7].children[0].children[0] = asn1Sequence(
    [
      oid([2, 5, 29, 19]), asn1OctetString(asn1Encode(asn1Sequence([asn1Boolean(true)]))),
    ],
  )
  assert(
    contains(waAttestError(waBasicWithCert(tree), waBasicHash()), "certificate"),
    "CA leaf refused",
  )
}

test "attestation rejects AAGUID mismatch" {
  let tree = waCertWithExt(waCertExt(asn1OctetString([]byte(16)), false))
  assert(
    contains(waAttestError(waBasicWithCert(tree), waBasicHash()), "certificate"),
    "AAGUID refused",
  )
}

test "attestation rejects chain outside configured roots" {
  let root = waBasicRoot()
  root.subject = "unrelated root"
  let policy = AttestationPolicy{ trust = AttestationTrust.Verify, roots = [root] }
  assert(
    contains(waAttestError(waBasicVector(), waBasicHash(), policy), "trusted root"),
    "no matching root",
  )
}

test "attestation rejects format outside policy" {
  let policy = AttestationPolicy{ formats = ["none"] }
  assert(
    contains(waAttestError(waBasicVector(), waBasicHash(), policy), "not allowed"),
    "format allow list",
  )
}

test "attestation rejects self when policy disallows self" {
  let policy = AttestationPolicy{ allowSelf = false }
  assert(
    contains(waAttestError(waSelfVector(), waSelfHash(), policy), "not allowed"),
    "self policy",
  )
}

test "attestation future formats fail with their names" {
  for fmt of ["fido-u2f", "apple", "android-key", "tpm"] {
    let obj = waBasicVector()
    obj.fmt = fmt
    let policy = AttestationPolicy{ formats = [fmt] }
    assert(contains(waAttestError(obj, waBasicHash(), policy), "'${fmt}' is not supported"), fmt)
  }
}

test "attestation Verify without roots fails at WebAuthn construction" {
  let opts = WebAuthnOptions{ attestationPolicy = AttestationPolicy{ trust = AttestationTrust.Verify } }
  let message = badRp(regRp(), opts)
  assert(contains(message, "requires roots"), message)
}

test "attestation none has no trusted result even with Verify" {
  let obj = waBasicVector()
  obj.fmt = "none"
  obj.attStmt = Cbor.Map([]CborEntry(0))
  let policy = AttestationPolicy{ trust = AttestationTrust.Verify, roots = [waBasicRoot()] }
  let result = verifyAttestation(obj, waBasicHash(), policy) catch e {
    panic(e.message())
  }
  assert(result.kind == "none" && !result.trusted && len(result.chain) == 0, "none result")
}

test "attestation basic registration stores policy result without aliasing its result fields" {
  let store = PackedStore()
  let rp = RelyingParty{ id = "example.org", name = "Example", origins = ["https://example.org"] }
  let policy = AttestationPolicy{ trust = AttestationTrust.Verify, roots = [waBasicRoot()] }
  let wa = WebAuthn(rp, store, WebAuthnOptions{ attestationPolicy = policy }) catch e {
    panic(e.message())
  }
  let raw = waBasicClient()
  let cd = parseClientData(raw) catch e {
    panic(e.message())
  }
  let obj = waBasicVector()
  let ac = unwrap(obj.authData.attested)
  let response = regResponse(ac.credentialId, raw, attObj(obj.fmt, obj.attStmt, obj.authData.raw))
  let got = inCtx((c) => {
    let seed = regSeed(c, cd.challenge, now().ns / Second + 300)
    if (seed != "") {
      return seed
    }
    let credential = wa.finishRegistration(c, response) catch e {
      return e.message()
    }
    credential.attestation.trusted = false
    credential.attestation.chain[0].subject = "changed by caller"
    return ""
  })
  assert(got == "", got)
  let rows = store.forUser(regUser().id) catch e {
    panic(e.message())
  }
  assert(len(rows) == 1 && rows[0].attestation.trusted, "stored result survives caller mutation")
  assert(
    rows[0].attestation.chain[0].subject != "changed by caller",
    "stored certificate fields are isolated",
  )
}

test "attestation x5c shape and bounds fail closed" {
  for value of [
    Cbor.Array([]Cbor(0)),
    Cbor.Array([]Cbor(9)),
    Cbor.Text("certificate"),
    Cbor.Array([Cbor.Text("certificate")]),
  ] {
    let obj = waBasicVector()
    let entries = waPackedEntries(obj.attStmt) catch e {
      panic(e.message())
    }
    entries[2] = CborEntry{ key = Cbor.Text("x5c"), value = value }
    obj.attStmt = Cbor.Map(entries)
    assert(waAttestError(obj, waBasicHash()) != "accepted", "malformed x5c")
  }
}

fn waAttestationKeyError(cert: Certificate, alg: int): string {
  waPackedKey(cert, alg) catch e {
    return e.message()
  }
  return "accepted"
}

test "attestation key algorithm and RSA work limits reject attacker inputs" {
  let cert = waBasicRoot()
  assert(waAttestationKeyError(cert, -8) != "accepted", "EC key cannot assert EdDSA")
  cert.pubKeyAlg = x509KeyRSA
  cert.pubKeyBytes = asn1Encode(asn1Sequence([asn1Integer(17), asn1Integer(65537)]))
  assert(waAttestationKeyError(cert, -257) != "accepted", "weak modulus")
  let modulus = []byte(256)
  modulus[0] = 128
  modulus[255] = 1
  let exponent = []byte(9)
  exponent[0] = 1
  exponent[8] = 1
  cert.pubKeyBytes = asn1Encode(asn1Sequence([asn1BigInteger(modulus), asn1BigInteger(exponent)]))
  assert(waAttestationKeyError(cert, -257) != "accepted", "excessive exponent")
  modulus[255] = 0
  cert.pubKeyBytes = asn1Encode(asn1Sequence([asn1BigInteger(modulus), asn1Integer(65537)]))
  assert(waAttestationKeyError(cert, -257) != "accepted", "even modulus")
}
