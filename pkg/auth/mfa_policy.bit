export enum SecondFactorPolicy {
  Off,
  Required,
  Optional,
}

// An enrollment-store failure refuses login; it is not an empty factor list.
export type FactorsFor = (string) => []SecondFactor!

export fn needsSecondFactor(policy: SecondFactorPolicy, enrolled: []SecondFactor): bool {
  match (policy) {
    Off => return false
    Required => return true
    Optional => return len(enrolled) > 0
  }
}

// Call only after verifying the first credential, before any full session bind.
// This entry owns the initial rotation; the caller must not rotate separately.
export fn beginSession(c: Ctx, id: Identity, policy: SecondFactorPolicy, factors: FactorsFor): ()! {
  if (id.id == "") {
    fail newError("auth: beginSession(): the Identity has an empty id")
  }
  let enrolled = []SecondFactor(0)
  if (policy != SecondFactorPolicy.Off) {
    if (factors == nil) {
      fail newError("auth: beginSession(): `factors` is required for this policy")
    }
    enrolled = factors(id.id)?
  }
  let needed = needsSecondFactor(policy, enrolled)
  let kind = pendingVerifyKind
  if (needed && len(enrolled) == 0) {
    kind = pendingEnrollKind
  }
  c.session()?.regenerate()?
  bindSessionProof(c, id, BindOptions{ second = needed }, Option<string>.Some(""), kind)?
  if (needed) {
    fail secondFactorRequired()
  }
}

const pendingVerifyKind = "verify"
const pendingEnrollKind = "enroll"

fn pendingSessionKind(raw: string): string! {
  let stored = jsonParse(raw) catch _ {
    fail secondFactorRequired()
  }
  let field = jsonGet(stored, "kind")
  if (!isSome(field)) {
    return pendingVerifyKind
  }
  let kind = jsonDecString(unwrap(field), "auth:pending.kind") catch _ {
    fail secondFactorRequired()
  }
  if (kind != pendingVerifyKind && kind != pendingEnrollKind) {
    fail secondFactorRequired()
  }
  return kind
}

fn requirePendingKind(raw: string, enrollment: bool): ()! {
  let kind = pendingSessionKind(raw)?
  if (kind == pendingEnrollKind && !enrollment) {
    fail secondFactorRequired()
  }
  if (kind == pendingVerifyKind && enrollment) {
    fail secondFactorRequired()
  }
}
