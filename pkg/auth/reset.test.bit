// pkg/auth/reset.test.bit — #6932's acceptance: PasswordReset request and
// confirm on an injected clock, an in-memory token store and a `MemoryStore` of
// real sessions. The same answer for a known and an unknown identifier, single
// use, expiry, a policy refusal leaving the token live, the user's sessions
// (and no one else's) destroyed, a second request killing the first token, a
// delivery failure reaching the hook and not the caller, and construction
// failing for each missing option.
//
// `WaitGroup` is bound module-wide by onetime.test.bit; `App`, `MemoryStore`,
// `revokeApp`, `revokeLogin`, `live` and `logoutOrPanic` by revoke.test.bit
// (alice is "u1", bob is "u2", both with the password "s3cr3t").

// The hand-moved clock the tokens share.
class RsClock {
  t: i64,
}

// The app the reset is wired to: the record of what `deliver` and
// `setPassword` were called with.
class RsApp {
  tokens: []string,
  sentTo: []string,
  expiries: []i64,
  setFor: []string,
  hashes: []string,
  reported: []string,
  deliverFails: bool,
  setFails: bool,
}

fn rsApp(): RsApp {
  return RsApp{
    tokens = []string{},
    sentTo = []string{},
    expiries = []i64{},
    setFor = []string{},
    hashes = []string{},
    reported = []string{},
    deliverFails = false,
    setFails = false,
  }
}

fn rsTokens(clock: RsClock): OneTimeTokens {
  let read: () => i64 = () => clock.t
  return OneTimeTokens(MemoryOneTimeStore(), OneTimeOptions{ clock = read }) catch e {
    panic("OneTimeTokens: ${e.message()}")
  }
}

// An identifier is an address; "ada@example.com" is "u1" and "bob@example.com"
// is "u2". Anything else has no account.
fn rsOptions(app: RsApp, sessions: MemoryStore): ResetOptions {
  let lookup: (string) => Option<string> = (identifier) => {
    if (identifier == "ada@example.com") {
      return Option<string>.Some("u1")
    }
    if (identifier == "bob@example.com") {
      return Option<string>.Some("u2")
    }
    return Option<string>.None
  }
  let deliver: Deliver = (to, token, expiresAt) => {
    app.tokens = append(app.tokens, token)
    app.sentTo = append(app.sentTo, to)
    app.expiries = append(app.expiries, expiresAt)
    if (app.deliverFails) {
      fail newError("smtp down")
    }
  }
  let set: (string, string) => ()! = (userId, hash) => {
    if (app.setFails) {
      fail newError("users table down")
    }
    app.setFor = append(app.setFor, userId)
    app.hashes = append(app.hashes, hash)
  }
  let hook: ResetErrorHook = (e) => {
    app.reported = append(app.reported, e.message())
  }
  return ResetOptions{
    lookup = lookup,
    deliver = deliver,
    setPassword = set,
    sessions = sessions,
    onError = hook,
  }
}

fn rsBuild(clock: RsClock, opts: ResetOptions): PasswordReset {
  return PasswordReset(rsTokens(clock), opts) catch e {
    panic("PasswordReset: ${e.message()}")
  }
}

fn rsPolicy(): Option<PasswordPolicy> {
  let p = PasswordPolicy() catch e {
    panic("PasswordPolicy: ${e.message()}")
  }
  return Option<PasswordPolicy>.Some(p)
}

// What `request` answers, as text: "ok" or the failure's message.
fn rsOutcome(r: PasswordReset, identifier: string): string {
  r.request(identifier) catch e {
    return e.message()
  }
  return "ok"
}

fn rsRequest(r: PasswordReset, identifier: string) {
  r.request(identifier) catch e {
    panic("request: ${e.message()}")
  }
}

// What `confirm` fails with: "invalid" for `InvalidToken`, "policy" for
// `PolicyViolations`, else the message; "" when it succeeds.
fn rsConfirm(r: PasswordReset, token: string, password: string): string {
  r.confirm(token, password) catch e {
    let (_, invalid) = e.(InvalidToken)
    if (invalid) {
      return "invalid"
    }
    let (_, refused) = e.(PolicyViolations)
    if (refused) {
      return "policy"
    }
    return e.message()
  }
  return ""
}

const rsGood: string = "correct horse battery staple"

test "request answers a known and an unknown identifier alike and delivers 1 of 2 times" {
  let app = rsApp()
  let r = rsBuild(RsClock{ t = 1000 }, rsOptions(app, MemoryStore(100)))
  let known = rsOutcome(r, "ada@example.com")
  let unknown = rsOutcome(r, "nobody@example.com")
  assert(known == unknown, "known and unknown results differ")
  assert(len(app.tokens) == 1, "deliver ran ${len(app.tokens)} time(s) for 2 requests, want 1")
  assert(app.sentTo[0] == "ada@example.com", "sent to ${app.sentTo[0]}")
  assert(len(app.tokens[0]) == 43, "token length ${len(app.tokens[0])}")
  assert(app.expiries[0] == 1000 + 3600, "expiry ${app.expiries[0]}")
}

test "a token resets the password once and the second confirm fails" {
  let app = rsApp()
  let r = rsBuild(RsClock{ t = 0 }, rsOptions(app, MemoryStore(100)))
  rsRequest(r, "ada@example.com")
  assert(rsConfirm(r, app.tokens[0], rsGood) == "", "the first confirm must succeed")
  assert(rsConfirm(r, app.tokens[0], rsGood) == "invalid", "the second confirm must fail")
  assert(
    len(app.setFor) == 1 && app.setFor[0] == "u1",
    "setPassword ran ${len(app.setFor)} time(s)",
  )
}

test "the stored hash is an Argon2id string that verifies the new password" {
  let app = rsApp()
  let r = rsBuild(RsClock{ t = 0 }, rsOptions(app, MemoryStore(100)))
  rsRequest(r, "ada@example.com")
  assert(rsConfirm(r, app.tokens[0], rsGood) == "", "confirm must succeed")
  assert(hasPrefix(app.hashes[0], "$argon2id$"), "hash is ${app.hashes[0]}")
  assert(!contains(app.hashes[0], rsGood), "the hash holds the password")
}

test "an expired token fails and sets nothing" {
  let clock = RsClock{ t = 1000 }
  let app = rsApp()
  let r = rsBuild(clock, rsOptions(app, MemoryStore(100)))
  rsRequest(r, "ada@example.com")
  clock.t = 1000 + 3600
  assert(rsConfirm(r, app.tokens[0], rsGood) == "invalid", "an expired token must fail")
  assert(len(app.setFor) == 0, "setPassword ran ${len(app.setFor)} time(s)")
}

test "a malformed token and a token of another purpose fail" {
  let clock = RsClock{ t = 0 }
  let app = rsApp()
  let tokens = rsTokens(clock)
  let r = PasswordReset(tokens, rsOptions(app, MemoryStore(100))) catch e {
    panic("PasswordReset: ${e.message()}")
  }
  assert(rsConfirm(r, "not-a-token", rsGood) == "invalid", "noise must fail")
  let other = tokens.issue("verify-email", "u1", 600) catch e {
    panic("issue: ${e.message()}")
  }
  assert(rsConfirm(r, other, rsGood) == "invalid", "a verification token must not reset a password")
  assert(len(app.setFor) == 0, "setPassword ran ${len(app.setFor)} time(s)")
}

test "a password the policy refuses leaves the token live and a good one then works" {
  let app = rsApp()
  let opts = rsOptions(app, MemoryStore(100))
  opts.policy = rsPolicy()
  let r = rsBuild(RsClock{ t = 0 }, opts)
  rsRequest(r, "ada@example.com")
  assert(rsConfirm(r, app.tokens[0], "short") == "policy", "a short password must be refused")
  assert(len(app.setFor) == 0, "setPassword ran for a refused password")
  assert(rsConfirm(r, app.tokens[0], rsGood) == "", "the same token must still work")
  assert(rsConfirm(r, app.tokens[0], rsGood) == "invalid", "and only once")
}

test "a refused password does not extend the token's life" {
  let clock = RsClock{ t = 0 }
  let app = rsApp()
  let opts = rsOptions(app, MemoryStore(100))
  opts.policy = rsPolicy()
  let r = rsBuild(clock, opts)
  rsRequest(r, "ada@example.com")
  clock.t = 3000
  assert(rsConfirm(r, app.tokens[0], "short") == "policy", "a short password must be refused")
  clock.t = 3600
  assert(rsConfirm(r, app.tokens[0], rsGood) == "invalid", "the restored token keeps its expiry")
}

test "the policy hashes with the normalization it records" {
  let app = rsApp()
  let opts = rsOptions(app, MemoryStore(100))
  opts.policy = rsPolicy()
  let r = rsBuild(RsClock{ t = 0 }, opts)
  rsRequest(r, "ada@example.com")
  assert(rsConfirm(r, app.tokens[0], rsGood) == "", "confirm must succeed")
  assert(contains(app.hashes[0], "n=nfkc"), "hash does not record NFKC: ${app.hashes[0]}")
}

test "an empty password is refused and the token is not spent" {
  let app = rsApp()
  let r = rsBuild(RsClock{ t = 0 }, rsOptions(app, MemoryStore(100)))
  rsRequest(r, "ada@example.com")
  assert(rsConfirm(r, app.tokens[0], "") != "", "an empty password must be refused")
  assert(rsConfirm(r, app.tokens[0], rsGood) == "", "the token must still work")
}

test "confirm destroys all 3 sessions of the user and leaves another user's" {
  let store = MemoryStore(1000)
  let web = revokeApp(store, hashPassword("s3cr3t"))
  let a1 = revokeLogin(web, "alice")
  let a2 = revokeLogin(web, "alice")
  let a3 = revokeLogin(web, "alice")
  let b1 = revokeLogin(web, "bob")
  let app = rsApp()
  let r = rsBuild(RsClock{ t = 0 }, rsOptions(app, store))
  rsRequest(r, "ada@example.com")
  assert(live(store, a1) && live(store, a2) && live(store, a3), "alice's sessions were not stored")
  assert(rsConfirm(r, app.tokens[0], rsGood) == "", "confirm must succeed")
  assert(
    !live(store, a1) && !live(store, a2) && !live(store, a3),
    "an alice session survived the reset",
  )
  assert(live(store, b1), "bob's session was destroyed")
}

test "a refused password leaves the user's sessions alone" {
  let store = MemoryStore(1000)
  let web = revokeApp(store, hashPassword("s3cr3t"))
  let a1 = revokeLogin(web, "alice")
  let app = rsApp()
  let opts = rsOptions(app, store)
  opts.policy = rsPolicy()
  let r = rsBuild(RsClock{ t = 0 }, opts)
  rsRequest(r, "ada@example.com")
  assert(rsConfirm(r, app.tokens[0], "short") == "policy", "a short password must be refused")
  assert(live(store, a1), "a refused reset destroyed a session")
}

test "a second request invalidates the first token" {
  let app = rsApp()
  let r = rsBuild(RsClock{ t = 0 }, rsOptions(app, MemoryStore(100)))
  rsRequest(r, "ada@example.com")
  rsRequest(r, "ada@example.com")
  assert(len(app.tokens) == 2 && app.tokens[0] != app.tokens[1], "two different tokens")
  assert(rsConfirm(r, app.tokens[0], rsGood) == "invalid", "the first token must be dead")
  assert(rsConfirm(r, app.tokens[1], rsGood) == "", "the second token must work")
}

test "a request for one user leaves another user's token alone" {
  let app = rsApp()
  let r = rsBuild(RsClock{ t = 0 }, rsOptions(app, MemoryStore(100)))
  rsRequest(r, "ada@example.com")
  rsRequest(r, "bob@example.com")
  rsRequest(r, "bob@example.com")
  assert(rsConfirm(r, app.tokens[0], rsGood) == "", "ada's token must still work")
  assert(app.setFor[0] == "u1", "reset user ${app.setFor[0]}")
}

test "a failed delivery is not the caller's: the same result, the token revoked, the hook told" {
  let app = rsApp()
  app.deliverFails = true
  let r = rsBuild(RsClock{ t = 0 }, rsOptions(app, MemoryStore(100)))
  let known = rsOutcome(r, "ada@example.com")
  let unknown = rsOutcome(r, "nobody@example.com")
  assert(known == unknown, "a delivery failure reached the caller")
  assert(
    len(app.reported) == 1 && app.reported[0] == "smtp down",
    "hook heard ${len(app.reported)} error(s)",
  )
  assert(rsConfirm(r, app.tokens[0], rsGood) == "invalid", "the unsent token must be revoked")
}

test "a failing setPassword is returned and the token is spent" {
  let app = rsApp()
  app.setFails = true
  let r = rsBuild(RsClock{ t = 0 }, rsOptions(app, MemoryStore(100)))
  rsRequest(r, "ada@example.com")
  assert(
    rsConfirm(r, app.tokens[0], rsGood) == "users table down",
    "the store failure must come back as it came",
  )
  assert(rsConfirm(r, app.tokens[0], rsGood) == "invalid", "the token must be spent")
}

fn rsBuildFails(opts: ResetOptions): bool {
  let _ = PasswordReset(rsTokens(RsClock{ t = 0 }), opts) catch _ {
    return true
  }
  return false
}

test "each of the 4 missing options is rejected at construction" {
  let app = rsApp()
  let store = MemoryStore(100)
  let full = rsOptions(app, store)
  assert(!rsBuildFails(full), "a full option set must construct")

  let noLookup = rsOptions(app, store)
  noLookup.lookup = nil
  assert(rsBuildFails(noLookup), "lookup missing must fail")

  let noDeliver = rsOptions(app, store)
  noDeliver.deliver = nil
  assert(rsBuildFails(noDeliver), "deliver missing must fail")

  let noSet = rsOptions(app, store)
  noSet.setPassword = nil
  assert(rsBuildFails(noSet), "setPassword missing must fail")

  let noSessions = rsOptions(app, store)
  noSessions.sessions = nil
  assert(rsBuildFails(noSessions), "sessions missing must fail")
}

test "a ttl of 0 and a ttl above the tokens' maxTtl are rejected at construction" {
  let app = rsApp()
  let zero = rsOptions(app, MemoryStore(100))
  zero.ttl = 0
  assert(rsBuildFails(zero), "ttl 0 must fail")
  let huge = rsOptions(app, MemoryStore(100))
  huge.ttl = 2_592_001
  assert(rsBuildFails(huge), "a ttl above maxTtl must fail")
}

fn rsRequestWorker(r: PasswordReset, wg: WaitGroup) {
  defer wg.done()
  rsRequest(r, "ada@example.com")
}

test "50 concurrent requests for one user leave exactly 1 live token" {
  let sent = chan<string>(50)
  let app = rsApp()
  let opts = rsOptions(app, MemoryStore(100))
  let deliver: Deliver = (to, token, expiresAt) => {
    sent <- token
  }
  opts.deliver = deliver
  let r = rsBuild(RsClock{ t = 0 }, opts)
  let wg = WaitGroup()
  wg.add(50)
  let i = 0
  while (i < 50) {
    spawn rsRequestWorker(r, wg)
    i = i + 1
  }
  wg.wait()
  let winners = 0
  let n = 0
  while (n < 50) {
    let token = <- sent
    if (rsConfirm(r, token, rsGood) == "") {
      winners = winners + 1
    }
    n = n + 1
  }
  assert(winners == 1, "${winners} of 50 concurrent requests left a live token, want 1")
}
