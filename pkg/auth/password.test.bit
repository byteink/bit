// pkg/auth/password.test.bit — #5771's acceptance: a correct password
// succeeds; a wrong password for a known user and a lookup that reports
// "not found" return the identical error; and both failure paths run the
// verifier the same number of times, proven with a counting test double
// rather than wall-clock timing (flaky under load).
//
// Every test goes through `app.handle(req)`, the same seam
// `middleware.test.bit` uses — the real router, the real `Ctx`
// construction, the real failure mapping. `App`, `Config`, `MemoryStore`
// (from "web") and `Request` (from "std/http") are already bound
// module-wide by `middleware.test.bit`; re-importing either is E0042.
// `randomSessionId` is new to the module.

import { randomSessionId } from "web"

// A `Lookup` for exactly one user, "alice", whose stored hash is `hash`.
// Any other username fails, the same shape a real application's lookup
// takes for a user that does not exist.
fn knownUserLookup(hash: string): Lookup {
  let l: Lookup = (username) => {
    if (username != "alice") {
      fail newError("lookup: user not found")
    }
    return LookupResult{ hash = hash, id = "u1", claims = Json.JsonNull }
  }
  return l
}

// A `Lookup` that reports every username as not found.
fn unknownUserLookup(): Lookup {
  let l: Lookup = (username) => {
    fail newError("lookup: user not found")
  }
  return l
}

// Counts calls to a `Verify` fake and always reports "does not match" — the
// call COUNT is what a timing test can prove without a clock; the real
// mismatch-detection is `argon2Verify`'s own and is not under test here.
class VerifyCounter {
  calls: int,
}

// A `Verify` seam sharing `box`, the same shape
// `oidc_discovery.test.bit`'s `fakeFetch`/`FetchCounter` uses for its own
// call-counting fake.
fn countingVerify(box: VerifyCounter): Verify {
  let f: Verify = (password, encoded) => {
    box.calls = box.calls + 1
    return false
  }
  return f
}

// An app with one POST route running `strategy.authenticate(c)` directly
// and answering the resulting identity's id — so a test reads the outcome
// off `Res.status`/`Res.body` instead of reaching into `PasswordStrategy`.
fn loginApp(strategy: Strategy): App {
  let app = App(Config{ secret = "test-secret", sessions = MemoryStore(1000) })
  app.post("/login", (c) => {
    let identity = strategy.authenticate(c)?
    return c.text(identity.id)
  })
  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  return app
}

fn loginReq(body: string): Request {
  return Request{
    method = "POST",
    path = "/login",
    headers = "Content-Type: application/json",
    body = body,
  }
}

test "a correct password succeeds and returns an Identity" {
  let hash = hashPassword("s3cr3t")
  let app = loginApp(PasswordStrategy(knownUserLookup(hash)))
  let res = app.handle(loginReq("{\"username\":\"alice\",\"password\":\"s3cr3t\"}"))

  assert(res.status == 200, "want 200, got ${res.status}")
  assert(res.body == "u1", "want the looked-up id 'u1', got '${res.body}'")
}

test "a wrong password for a known user and an unknown user return the identical error" {
  let hash = hashPassword("s3cr3t")
  let wrongPwApp = loginApp(PasswordStrategy(knownUserLookup(hash)))
  let unknownApp = loginApp(PasswordStrategy(unknownUserLookup()))

  let wrongPwRes = wrongPwApp.handle(loginReq("{\"username\":\"alice\",\"password\":\"WRONG\"}"))
  let unknownRes = unknownApp.handle(loginReq("{\"username\":\"ghost\",\"password\":\"whatever\"}"))

  assert(wrongPwRes.status == 401, "want 401 for a wrong password, got ${wrongPwRes.status}")
  assert(unknownRes.status == 401, "want 401 for an unknown user, got ${unknownRes.status}")
  assert(
    wrongPwRes.body == unknownRes.body,
    "want the identical error body, got '${wrongPwRes.body}' vs '${unknownRes.body}'",
  )
}

test "a successful login regenerates the session id, closing fixation (#5795)" {
  let hash = hashPassword("s3cr3t")
  let store = MemoryStore(1000)
  let app = App(Config{ secret = "test-secret", sessions = store })
  app.post("/login", (c) => {
    let identity = PasswordStrategy(knownUserLookup(hash)).authenticate(c)?
    return c.text(identity.id)
  })
  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }

  // A REAL, previously-adopted session id - the fixation shape: an id
  // already present in the store before login runs, the way an earlier
  // anonymous visit (or an attacker who set the victim's cookie) leaves
  // one there. An id the store has never seen would be replaced anyway
  // (session.bit's `loadSession`), which would prove nothing about login.
  let preSid = randomSessionId()
  store.compareAndSet(preSid, 0, map<string, string>(), map<string, string>(), 86400) catch e {
    panic("compareAndSet: ${e.message()}")
  }

  let req = Request{
    method = "POST",
    path = "/login",
    headers = "Content-Type: application/json\r\nCookie: sid=" + preSid,
    body = "{\"username\":\"alice\",\"password\":\"s3cr3t\"}",
  }
  let res = app.handle(req)

  assert(res.status == 200, "want 200, got ${res.status}")
  let setCookie = res.getHeader("Set-Cookie")
  assert(len(setCookie) > 0, "a successful login must issue a Set-Cookie")
  assert(
    !contains(setCookie, preSid),
    "the pre-set session id was reused after login: '${setCookie}'",
  )
}

test "a wrong password and an unknown user each call the verifier exactly once" {
  let knownBox = VerifyCounter{ calls = 0 }
  let knownApp = loginApp(
    PasswordStrategy{
      lookup = knownUserLookup(hashPassword("s3cr3t")),
      verify = countingVerify(knownBox),
    },
  )
  knownApp.handle(loginReq("{\"username\":\"alice\",\"password\":\"WRONG\"}"))

  let unknownBox = VerifyCounter{ calls = 0 }
  let unknownApp = loginApp(
    PasswordStrategy{ lookup = unknownUserLookup(), verify = countingVerify(unknownBox) },
  )
  unknownApp.handle(loginReq("{\"username\":\"ghost\",\"password\":\"whatever\"}"))

  assert(
    knownBox.calls == 1,
    "want exactly one verify call for a wrong password, got ${knownBox.calls}",
  )
  assert(
    unknownBox.calls == 1,
    "want exactly one verify call for an unknown user, got ${unknownBox.calls}",
  )
}

// --- PasswordOptions: the login throttle and the audit hook (#6927) ---------
//
// `FakeStore`, `FakeClock`, `fakeStore`, `freshClock` and `throttleOn` come from
// throttle.test.bit (one module); the clock is moved by hand, so no test sleeps.

const clientIp = "10.0.0.1"

// A `Verify` fake that counts its calls and accepts exactly `want`.
fn matchingVerify(box: VerifyCounter, want: string): Verify {
  let f: Verify = (password, encoded) => {
    box.calls = box.calls + 1
    return string(password) == want
  }
  return f
}

fn throttleOption(t: LoginThrottle): PasswordOptions {
  return PasswordOptions{ throttle = Option<LoginThrottle>.Some(t) }
}

// A throttled strategy for "alice" / "s3cr3t" whose verifier is `box`.
fn throttledStrategy(box: VerifyCounter, opts: PasswordOptions): PasswordStrategy {
  let s = PasswordStrategy(knownUserLookup("stored"), opts)
  s.verify = matchingVerify(box, "s3cr3t")
  return s
}

// The same strategy over a lookup that finds nobody.
fn throttledUnknown(box: VerifyCounter, opts: PasswordOptions): PasswordStrategy {
  let s = PasswordStrategy(unknownUserLookup(), opts)
  s.verify = matchingVerify(box, "s3cr3t")
  return s
}

// An app whose `/login` is `requireAuth([s])`, the documented wiring: a
// `Throttled` becomes a 429 with `Retry-After`.
fn guardedApp(s: Strategy): App {
  let app = App(Config{ secret = "test-secret", sessions = MemoryStore(1000) })
  let login = app.group("/login")
  login.use(requireAuth([]Strategy{ s }))
  login.post("/", (c) => c.text("welcome"))
  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  return app
}

fn attemptReq(user: string, password: string): Request {
  return Request{
    method = "POST",
    path = "/login",
    headers = "Content-Type: application/json",
    body = "{\"username\":\"${user}\",\"password\":\"${password}\"}",
    peer = clientIp,
  }
}

fn guardedReq(user: string, password: string): Request {
  let r = attemptReq(user, password)
  return r
}

// The status of each of `n` wrong-password attempts, the clock moving 20 s
// between them so the backoff never refuses before the lockout does.
fn wrongRun(app: App, clock: FakeClock, user: string, n: int): []int {
  let out = []int{}
  let i = 0
  while (i < n) {
    out = append(out, app.handle(attemptReq(user, "WRONG")).status)
    clock.t = clock.t + 20
    i = i + 1
  }
  return out
}

// `a` as "401,401,429", for one comparison and one failure message.
fn codes(a: []int): string {
  let out = ""
  for n of a {
    out = out + "${n},"
  }
  return out
}

class Events {
  kinds: []string,
  accounts: []string,
  ips: []string,
  ats: []i64,
}

fn eventSink(e: Events): AuthEventHook {
  let h: AuthEventHook = (ev) => {
    e.kinds = append(e.kinds, ev.kind)
    e.accounts = append(e.accounts, ev.account)
    e.ips = append(e.ips, ev.ip)
    e.ats = append(e.ats, ev.at)
  }
  return h
}

fn newEvents(): Events {
  return Events{ kinds = []string{}, accounts = []string{}, ips = []string{}, ats = []i64{} }
}

test "throttled: a wrong password and an unknown user answer with the same status, body and headers" {
  let clock = freshClock()
  let known = loginApp(
    throttledStrategy(
      VerifyCounter{ calls = 0 },
      throttleOption(throttleOn(fakeStore(clock), clock, ThrottleOptions{})),
    ),
  )
  let unknown = loginApp(
    throttledUnknown(
      VerifyCounter{ calls = 0 },
      throttleOption(throttleOn(fakeStore(clock), clock, ThrottleOptions{})),
    ),
  )

  let a = known.handle(attemptReq("alice", "WRONG"))
  let b = unknown.handle(attemptReq("ghost", "WRONG"))

  assert(a.status == 401 && b.status == 401, "want 401 both, got ${a.status} and ${b.status}")
  assert(a.body == b.body, "bodies differ: '${a.body}' vs '${b.body}'")
  assert(a.headers == b.headers, "headers differ: '${a.headers}' vs '${b.headers}'")
}

test "throttled: the same attempts get the same statuses for a real and an invented account, through the lockout" {
  let clock = freshClock()
  let known = loginApp(
    throttledStrategy(
      VerifyCounter{ calls = 0 },
      throttleOption(throttleOn(fakeStore(clock), clock, ThrottleOptions{})),
    ),
  )
  let unknown = loginApp(
    throttledUnknown(
      VerifyCounter{ calls = 0 },
      throttleOption(throttleOn(fakeStore(clock), clock, ThrottleOptions{})),
    ),
  )

  let a = wrongRun(known, clock, "alice", 7)
  let b = wrongRun(unknown, clock, "ghost", 7)

  assert(codes(a) == codes(b), "status runs differ: ${codes(a)} vs ${codes(b)}")
  assert(a[0] == 401 && a[4] == 401 && a[5] == 429, "want 401 x5 then 429, got ${codes(a)}")
}

test "throttled: verify runs exactly once on success, wrong password, unknown user and a locked account" {
  let clock = freshClock()
  let store = fakeStore(clock)
  let t = throttleOn(store, clock, ThrottleOptions{ accountFailures = 1 })

  let okBox = VerifyCounter{ calls = 0 }
  loginApp(throttledStrategy(okBox, throttleOption(t))).handle(attemptReq("alice", "s3cr3t"))

  let wrongBox = VerifyCounter{ calls = 0 }
  loginApp(throttledStrategy(wrongBox, throttleOption(t))).handle(attemptReq("alice", "WRONG"))

  let ghostBox = VerifyCounter{ calls = 0 }
  loginApp(throttledUnknown(ghostBox, throttleOption(t))).handle(attemptReq("ghost", "x"))

  // "alice" is locked now (accountFailures = 1 and the wrong password above).
  let lockedBox = VerifyCounter{ calls = 0 }
  let res = loginApp(throttledStrategy(lockedBox, throttleOption(t))).handle(
    attemptReq("alice", "s3cr3t"),
  )

  assert(res.status == 429, "the locked attempt must be refused, got ${res.status}")
  assert(okBox.calls == 1, "success: ${okBox.calls} verify calls")
  assert(wrongBox.calls == 1, "wrong password: ${wrongBox.calls} verify calls")
  assert(ghostBox.calls == 1, "unknown user: ${ghostBox.calls} verify calls")
  assert(lockedBox.calls == 1, "locked: ${lockedBox.calls} verify calls")
}

test "throttled: 5 failures lock the account and requireAuth answers 429 with Retry-After" {
  let clock = freshClock()
  let t = throttleOn(fakeStore(clock), clock, ThrottleOptions{})
  let app = guardedApp(throttledStrategy(VerifyCounter{ calls = 0 }, throttleOption(t)))

  let i = 0
  while (i < 5) {
    let r = app.handle(guardedReq("alice", "WRONG"))
    assert(r.status == 401, "attempt ${i + 1}: want 401, got ${r.status}")
    clock.t = clock.t + 20
    i = i + 1
  }
  let locked = app.handle(guardedReq("alice", "s3cr3t"))

  assert(locked.status == 429, "want 429 once locked, got ${locked.status}")
  assert(
    locked.getHeader("Retry-After") == "900",
    "want Retry-After 900, got '${locked.getHeader("Retry-After")}'",
  )
}

test "throttled: a Throttled that escapes authenticate is a 429 and the wrong password a 401" {
  let clock = freshClock()
  let t = throttleOn(fakeStore(clock), clock, ThrottleOptions{ accountFailures = 1 })
  let app = loginApp(throttledStrategy(VerifyCounter{ calls = 0 }, throttleOption(t)))

  assert(app.handle(attemptReq("alice", "WRONG")).status == 401, "the first failure is a 401")
  assert(app.handle(attemptReq("alice", "s3cr3t")).status == 429, "a locked account is a 429")
}

test "throttled: a success resets the account's failures" {
  let clock = freshClock()
  let t = throttleOn(fakeStore(clock), clock, ThrottleOptions{})
  let app = loginApp(throttledStrategy(VerifyCounter{ calls = 0 }, throttleOption(t)))

  let _ = wrongRun(app, clock, "alice", 4)
  assert(app.handle(attemptReq("alice", "s3cr3t")).status == 200, "4 failures are under the limit")
  clock.t = clock.t + 20
  let _ = wrongRun(app, clock, "alice", 4)
  let last = app.handle(attemptReq("alice", "s3cr3t"))

  assert(
    last.status == 200,
    "without the reset the 9th attempt would be locked, got ${last.status}",
  )
}

test "throttled: the hook sees success, failure and locked, with the hashed account" {
  let clock = freshClock()
  let t = throttleOn(fakeStore(clock), clock, ThrottleOptions{ accountFailures = 1 })
  let seen = newEvents()
  let app = loginApp(
    throttledStrategy(
      VerifyCounter{ calls = 0 },
      PasswordOptions{ throttle = Option<LoginThrottle>.Some(t), onEvent = eventSink(seen) },
    ),
  )

  app.handle(attemptReq("alice", "s3cr3t"))
  app.handle(attemptReq("alice", "WRONG"))
  app.handle(attemptReq("alice", "s3cr3t"))

  assert(
    join(seen.kinds, ",") == "login.success,login.failure,login.locked",
    "kinds: ${join(seen.kinds, ",")}",
  )
  assert(seen.ips[0] == clientIp && seen.ips[2] == clientIp, "ips: ${join(seen.ips, ",")}")
  assert(seen.ats[0] > 0, "at must be the time of the event, got ${seen.ats[0]}")
  assert(seen.accounts[0] == seen.accounts[1], "the same account must hash the same")
  assert(!contains(seen.accounts[0], "lice"), "the event carries the raw name: ${seen.accounts[0]}")
  assert(len(seen.accounts[0]) == 64, "want a SHA-256 hex, got '${seen.accounts[0]}'")
}

test "a hook alone, with no throttle, still hears the logins" {
  let seen = newEvents()
  let s = PasswordStrategy(knownUserLookup("stored"), PasswordOptions{ onEvent = eventSink(seen) })
  s.verify = matchingVerify(VerifyCounter{ calls = 0 }, "s3cr3t")
  let app = loginApp(s)

  assert(app.handle(attemptReq("alice", "WRONG")).status == 401, "wrong password is a 401")
  assert(app.handle(attemptReq("alice", "s3cr3t")).status == 200, "right password is a 200")
  assert(join(seen.kinds, ",") == "login.failure,login.success", "kinds: ${join(seen.kinds, ",")}")
}

test "a panicking hook leaves the login result unchanged" {
  let clock = freshClock()
  let t = throttleOn(fakeStore(clock), clock, ThrottleOptions{ accountFailures = 1 })
  let boom: AuthEventHook = (ev) => {
    panic("audit sink is down")
  }
  let app = loginApp(
    throttledStrategy(
      VerifyCounter{ calls = 0 },
      PasswordOptions{ throttle = Option<LoginThrottle>.Some(t), onEvent = boom },
    ),
  )

  assert(
    app.handle(attemptReq("alice", "s3cr3t")).status == 200,
    "a success survives a panicking hook",
  )
  assert(
    app.handle(attemptReq("alice", "WRONG")).status == 401,
    "a failure survives a panicking hook",
  )
  assert(
    app.handle(attemptReq("alice", "s3cr3t")).status == 429,
    "a refusal survives a panicking hook",
  )
}

test "a throttle store failure refuses the login, even a correct password" {
  let clock = freshClock()
  let store = fakeStore(clock)
  let t = throttleOn(store, clock, ThrottleOptions{})
  let app = loginApp(throttledStrategy(VerifyCounter{ calls = 0 }, throttleOption(t)))
  store.broken = true

  let res = app.handle(attemptReq("alice", "s3cr3t"))

  assert(res.status == 500, "want a refused login (500), got ${res.status}")
  assert(res.body != "u1", "the login must not succeed")
  assert(!contains(res.body, "store down"), "the cause leaked to the client: '${res.body}'")
}

test "a throttle with no client address refuses the login rather than share one bucket" {
  let clock = freshClock()
  let t = throttleOn(fakeStore(clock), clock, ThrottleOptions{})
  let app = loginApp(throttledStrategy(VerifyCounter{ calls = 0 }, throttleOption(t)))
  let req = attemptReq("alice", "s3cr3t")
  req.peer = ""

  assert(app.handle(req).status == 500, "an empty peer must refuse the login")
}

test "the recorded failures key on the lower-cased account: Alice and alice share a counter" {
  let clock = freshClock()
  let t = throttleOn(fakeStore(clock), clock, ThrottleOptions{ accountFailures = 2 })
  let app = loginApp(throttledUnknown(VerifyCounter{ calls = 0 }, throttleOption(t)))

  app.handle(attemptReq("Ghost", "x"))
  clock.t = clock.t + 20
  app.handle(attemptReq("ghost", "x"))
  clock.t = clock.t + 20

  assert(
    app.handle(attemptReq("GHOST", "x")).status == 429,
    "the invented account must be locked after 2 failures",
  )
}

// #7311: `PasswordOptions.second`. A strategy for "alice" / "s3cr3t" whose
// `second` is `f`; the verifier is a fake that accepts exactly that password.
fn secondStrategy(f: SecondRequired): PasswordStrategy {
  let s = PasswordStrategy(
    knownUserLookup("stored"),
    PasswordOptions{ second = Option<SecondRequired>.Some(f) },
  )
  s.verify = matchingVerify(VerifyCounter{ calls = 0 }, "s3cr3t")
  return s
}

fn holdAll(): SecondRequired {
  let f: SecondRequired = (id) => true
  return f
}

fn holdNone(): SecondRequired {
  let f: SecondRequired = (id) => false
  return f
}

fn holdBroken(): SecondRequired {
  let f: SecondRequired = (id) => {
    fail newError("enrollment store is down")
  }
  return f
}

// `/login` runs the strategy directly, `/g` is behind `requireAuth([s])`, `/me`
// reads `currentIdentity`, `/state` shows what the session holds, `/login/code`
// is the second step with a factor that accepts "123456".
fn secondApp(s: Strategy): App {
  let app = App(Config{ secret = "test-secret", sessions = MemoryStore(1000) })
  app.post("/login", (c) => {
    let identity = s.authenticate(c)?
    return c.text(identity.id)
  })
  let guarded = app.group("/g")
  guarded.use(requireAuth([]Strategy{ s }))
  guarded.post("/", (c) => c.text("welcome"))
  app.post("/login/code", (c) => {
    let form = c.body<MfCode>()?
    let id = completeSecondFactor(c, MfStub{ want = "123456", asked = 0 }, form.code)?
    return c.text(id.id)
  })
  app.get("/me", (c) => c.text(currentIdentity(c)?.id))
  app.get("/state", (c) => {
    let session = c.session()?
    return c.text("identity=[${session.get(identitySessionKey)}] pending=[${session.get(pendingSessionKey)}]")
  })
  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  return app
}

fn secondReq(method: string, path: string, cookie: string, body: string): Request {
  return Request{
    method = method,
    path = path,
    headers = "Content-Type: application/json\r\nCookie: ${cookie}",
    body = body,
  }
}

const aliceBody = "{\"username\":\"alice\",\"password\":\"s3cr3t\"}"

test "second = true: a correct password binds only a pending session, never a full login (#7311)" {
  let app = secondApp(secondStrategy(holdAll()))
  let res = app.handle(secondReq("POST", "/login", "", aliceBody))
  assert(res.status == 401, "want 401, got ${res.status}")
  assert(
    contains(res.body, "second_factor_required"),
    "want second_factor_required, got '${res.body}'",
  )
  let cookie = mfCookie(res)
  assert(cookie != "", "the pending session must be armed with a cookie")

  let state = app.handle(secondReq("GET", "/state", cookie, ""))
  assert(contains(state.body, "identity=[]"), "no full identity may exist, got '${state.body}'")
  assert(
    !contains(state.body, "pending=[]"),
    "the identity must be held pending, got '${state.body}'",
  )
  let me = app.handle(secondReq("GET", "/me", cookie, ""))
  assert(me.status == 401, "currentIdentity: want 401, got ${me.status}")
  assert(contains(me.body, "second_factor_required"), "currentIdentity: got '${me.body}'")
}

test "second = true behind requireAuth: the middleware cannot turn the half login into a full one" {
  let app = secondApp(secondStrategy(holdAll()))
  let res = app.handle(secondReq("POST", "/g", "", aliceBody))
  assert(res.status == 401, "want 401, got ${res.status}")
  assert(
    contains(res.body, "second_factor_required"),
    "want second_factor_required, got '${res.body}'",
  )
  let me = app.handle(secondReq("GET", "/me", mfCookie(res), ""))
  assert(me.status == 401, "no full session may exist after requireAuth, got ${me.status}")
}

test "second = false: the same password is a full login" {
  let app = secondApp(secondStrategy(holdNone()))
  let res = app.handle(secondReq("POST", "/login", "", aliceBody))
  assert(res.status == 200, "want 200, got ${res.status}")
  let me = app.handle(secondReq("GET", "/me", mfCookie(res), ""))
  assert(me.status == 200 && me.body == "u1", "want u1, got ${me.status} '${me.body}'")
}

test "second = true: completeSecondFactor promotes the pending login, a wrong code does not" {
  let app = secondApp(secondStrategy(holdAll()))
  let cookie = mfCookie(app.handle(secondReq("POST", "/login", "", aliceBody)))
  let bad = app.handle(secondReq("POST", "/login/code", cookie, "{\"code\":\"000000\"}"))
  assert(bad.status == 401, "a wrong code: want 401, got ${bad.status}")
  let still = app.handle(secondReq("GET", "/me", cookie, ""))
  assert(still.status == 401, "still pending after a wrong code, got ${still.status}")

  let done = app.handle(secondReq("POST", "/login/code", cookie, "{\"code\":\"123456\"}"))
  assert(done.status == 200 && done.body == "u1", "want u1, got ${done.status} '${done.body}'")
  let fresh = mfCookie(done)
  assert(fresh != "" && fresh != cookie, "the session id must be regenerated on promotion")
  let me = app.handle(secondReq("GET", "/me", fresh, ""))
  assert(me.status == 200 && me.body == "u1", "want a full login, got ${me.status} '${me.body}'")
}

test "second that fails refuses the login: no session of either kind (#7311)" {
  let app = secondApp(secondStrategy(holdBroken()))
  let res = app.handle(secondReq("POST", "/login", "", aliceBody))
  assert(res.status != 200, "a failing `second` must not let the login through")
  let state = app.handle(secondReq("GET", "/state", mfCookie(res), ""))
  assert(contains(state.body, "identity=[]"), "no full identity, got '${state.body}'")
  assert(contains(state.body, "pending=[]"), "no pending identity either, got '${state.body}'")
}
