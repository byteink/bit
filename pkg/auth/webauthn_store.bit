// pkg/auth/webauthn_store.bit — what a relying party keeps for every passkey
// it registered (#6958, W3C Web Authentication Level 3 section 7.1 step 25 and
// section 6.4.1: the credential record), the store interface the ceremonies
// talk to, and an in-process store for tests and development.
//
// `Mutex`, `Option`, `isSome`, `unwrap`, `encodeBase64Url` are already bound
// module-wide (SPEC §17.1); re-importing any of them here is E0042.

// One registered credential. `publicKey` is the COSE_Key exactly as the
// authenticator sent it (`parseCoseKey`, std/crypto, reads it back); `alg` is
// the COSE algorithm it verifies with. `signCount`, `backupEligible` and
// `backupState` are the values the last ceremony reported, for the
// authentication ceremony to compare against. `transports` are the hints the
// browser gave at registration; they only steer which authenticator the next
// ceremony offers and carry no trust. `createdAt` is seconds since the epoch;
// `name` is the label the user gave the passkey, empty until they do.
export class Credential {
  export id: []byte,
  export userId: string,
  export publicKey: []byte,
  export alg: int,
  export signCount: uint,
  export aaguid: []byte,
  export backupEligible: bool,
  export backupState: bool,
  export transports: []string,
  export createdAt: i64,
  export name: string,
}

// Where credentials live. Structural (§14.3): any type with these five methods
// is a store, so a database table fits with no declaration.
//
// `add` MUST be one atomic step that fails when a credential with the same
// `id` is already stored (a UNIQUE constraint): two registrations racing to
// store one id must not both succeed, and the ceremony's own `byId` check
// before it is only a courtesy. `byId` answers `Option.None` for an id that is
// not there. `forUser` lists the credentials of one user in the order they
// were added (empty for a user with none). `update` and `remove` fail for an id
// that is not stored: the caller believed something that is false.
export interface CredentialStore {
  add(c: Credential): ()!,
  byId(id: []byte): Option<Credential>!,
  forUser(userId: string): []Credential!,
  update(c: Credential): ()!,
  remove(id: []byte): ()!,
}

// The default number of credentials a `MemoryCredentialStore` holds.
const memoryCredentialCapacity: int = 10_000

// An in-process store, for tests, development and a single-process app. Its
// credentials die with the process, so a restart locks every user out of their
// passkeys: use a database store in production.
//
// Bounded: at `capacity` credentials `add` fails. It never evicts, because a
// dropped credential is a user locked out of their account, which is worse than
// a refused registration.
export class MemoryCredentialStore {
  entries: map<string, Credential>
  order: []string
  capacity: int
  mu: Mutex

  // A capacity below 1 could hold nothing, so it panics, as
  // `MemoryOneTimeStore` does: a mistake at startup, not a runtime condition.
  init(capacity: int = memoryCredentialCapacity) {
    if (capacity < 1) {
      panic("auth: MemoryCredentialStore(): `capacity` is ${capacity} — it must be at least 1")
    }
    this.entries = map<string, Credential>()
    this.order = []string(0)
    this.capacity = capacity
    this.mu = Mutex()
  }

  export add(c: Credential): ()! {
    this.mu.lock()
    defer this.mu.unlock()
    let key = encodeBase64Url(c.id)
    let (_, present) = this.entries[key]
    if (present) {
      fail newError("auth: credential store: a credential with this id is already stored")
    }
    if (len(this.entries) >= this.capacity) {
      fail newError("auth: credential store: full (${this.capacity} credentials)")
    }
    this.entries[key] = cloneCredential(c)
    this.order = append(this.order, key)
  }

  export byId(id: []byte): Option<Credential>! {
    this.mu.lock()
    defer this.mu.unlock()
    let (c, ok) = this.entries[encodeBase64Url(id)]
    if (!ok) {
      return Option<Credential>.None
    }
    return Option<Credential>.Some(cloneCredential(c))
  }

  export forUser(userId: string): []Credential! {
    this.mu.lock()
    defer this.mu.unlock()
    let out = []Credential(0)
    for key of this.order {
      let (c, _) = this.entries[key]
      if (c.userId == userId) {
        out = append(out, cloneCredential(c))
      }
    }
    return out
  }

  export update(c: Credential): ()! {
    this.mu.lock()
    defer this.mu.unlock()
    let key = encodeBase64Url(c.id)
    let (_, present) = this.entries[key]
    if (!present) {
      fail newError("auth: credential store: update of a credential that is not stored")
    }
    this.entries[key] = cloneCredential(c)
  }

  export remove(id: []byte): ()! {
    this.mu.lock()
    defer this.mu.unlock()
    let key = encodeBase64Url(id)
    let (_, present) = this.entries[key]
    if (!present) {
      fail newError("auth: credential store: remove of a credential that is not stored")
    }
    delete(this.entries, key)
    let kept = []string(0)
    for k of this.order {
      if (k != key) {
        kept = append(kept, k)
      }
    }
    this.order = kept
  }
}

// A copy a caller can change without changing what the store holds. The byte
// and string slices are never written to in place by this package, so they are
// shared.
fn cloneCredential(c: Credential): Credential {
  return Credential{
    id = c.id,
    userId = c.userId,
    publicKey = c.publicKey,
    alg = c.alg,
    signCount = c.signCount,
    aaguid = c.aaguid,
    backupEligible = c.backupEligible,
    backupState = c.backupState,
    transports = c.transports,
    createdAt = c.createdAt,
    name = c.name,
  }
}
