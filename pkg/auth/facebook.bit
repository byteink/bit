// Facebook Login (#6945) uses the existing OAuth2Strategy profile step.
// Meta's changelog and secure-requests guide, checked 2026-10-14:
// https://developers.facebook.com/docs/graph-api/changelog/
// https://developers.facebook.com/docs/graph-api/guides/secure-requests/
const facebookVersionChecked = "2026-10-14"

// One Graph GET; the test seam preserves the HTTP status and body.
export type FacebookFetch = (string, []Header) => Response!

export class FacebookOptions {
  export appId: string,
  export appSecret: string,
  export apiVersion: string = "v26.0",
  export fields: []string = ["id", "name", "email"],
  export tls: Option<TlsConfig>,
  export apiFetch: FacebookFetch,
}

fn facebookHttp(tls: TlsConfig): FacebookFetch {
  let f: FacebookFetch = (url, headers) => {
    return Client(tls = tls).requestWith("GET", url, headers, "")?
  }
  return f
}

fn facebookFetch(opts: FacebookOptions): FacebookFetch! {
  if (opts.apiFetch != nil) {
    return opts.apiFetch
  }
  match (opts.tls) {
    Some(cfg) => return facebookHttp(cfg)
    None => fail newError("auth: facebook(): tls is required unless apiFetch is set")
  }
}

fn facebookProof(secret: string, token: string): string {
  return encodeHex(hmacTag(HashAlg.Sha256, []byte(secret), []byte(token)))
}

fn facebookGraphError(doc: Json): ()! {
  let err = jsonGet(doc, "error")
  if (!isSome(err)) {
    return
  }
  let code = jsonGet(unwrap(err), "code")
  if (isSome(code)) {
    let n = jsonAsInt(unwrap(code))
    if (isSome(n)) {
      fail newError("auth: facebook: Graph error ${unwrap(n)}")
    }
  }
  fail newError("auth: facebook: Graph error")
}

// URLs and provider text can contain credentials; neither escapes this boundary.
fn facebookDocument(fetch: FacebookFetch, url: string, headers: []Header): Json! {
  let res = fetch(url, headers) catch _ {
    fail newError("auth: facebook: Graph request failed")
  }
  let doc = jsonParse(res.body) catch _ {
    fail newError("auth: facebook: invalid Graph response")
  }
  facebookGraphError(doc)?
  if (res.status != 200) {
    fail newError("auth: facebook: Graph HTTP ${res.status}")
  }
  return doc
}

fn facebookUser(fetch: FacebookFetch, api: string, opts: FacebookOptions, token: string): string! {
  let appToken = opts.appId + "|" + opts.appSecret
  let url = api +
    "/debug_token?input_token=" +
    percentEncode(token) +
    "&appsecret_proof=" +
    facebookProof(opts.appSecret, appToken)
  let headers = []Header{
    Header{ name = "Authorization", value = "Bearer " + appToken },
    Header{ name = "Accept", value = "application/json" },
  }
  let doc = facebookDocument(fetch, url, headers)?
  let data = jsonGet(doc, "data")
  if (!isSome(data)) {
    fail newError("auth: facebook: invalid token inspection")
  }
  let valid = jsonGet(unwrap(data), "is_valid")
  if (!isSome(valid) || !isSome(jsonAsBool(unwrap(valid))) || !unwrap(jsonAsBool(unwrap(valid)))) {
    fail newError("auth: facebook: invalid token")
  }
  let user = oauth2Field(unwrap(data), "user_id")
  if (oauth2Field(unwrap(data), "app_id") != opts.appId || user == "") {
    fail newError("auth: facebook: token identity mismatch")
  }
  return user
}

fn facebookIdentity(doc: Json, user: string): Identity! {
  let id = oauth2Field(doc, "id")
  if (id == "" || id != user) {
    fail newError("auth: facebook: profile identity mismatch")
  }
  return Identity{
    id = id,
    claims = Json.JsonObject(
      []JsonEntry{
        JsonEntry{ key = "name", value = Json.JsonString(oauth2Field(doc, "name")) },
        JsonEntry{ key = "email", value = Json.JsonString(oauth2Field(doc, "email")) },
        JsonEntry{ key = "email_verified", value = Json.JsonBool(false) },
      },
    ),
  }
}

fn facebookProfile(fetch: FacebookFetch, opts: FacebookOptions): ProfileFetch {
  let api = "https://graph.facebook.com/" + opts.apiVersion
  let f: ProfileFetch = (token) => {
    let user = facebookUser(fetch, api, opts, token)?
    let url = api +
      "/me?fields=" +
      percentEncode(join(opts.fields, ",")) +
      "&appsecret_proof=" +
      facebookProof(opts.appSecret, token)
    let headers = []Header{
      Header{ name = "Authorization", value = "Bearer " + token },
      Header{ name = "Accept", value = "application/json" },
    }
    return facebookIdentity(facebookDocument(fetch, url, headers)?, user)?
  }
  return f
}

// Use the same appId in the preset and OAuth2Strategy.
export fn facebook(opts: FacebookOptions = FacebookOptions{}): OAuth2Endpoints! {
  if (opts.appId == "" || opts.appSecret == "") {
    fail newError("auth: facebook(): appId and appSecret are required")
  }
  if (!hasPrefix(opts.apiVersion, "v") ||
    contains(opts.apiVersion, "/") ||
    contains(opts.apiVersion, "?") ||
    contains(opts.apiVersion, "#")) {
    fail newError("auth: facebook(): invalid apiVersion")
  }
  let fetch = facebookFetch(opts)?
  return OAuth2Endpoints{
    authorize = "https://www.facebook.com/" + opts.apiVersion + "/dialog/oauth",
    token = "https://graph.facebook.com/" + opts.apiVersion + "/oauth/access_token",
    profile = facebookProfile(fetch, opts),
    defaultScopes = ["public_profile", "email"],
  }
}
