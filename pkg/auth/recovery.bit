// pkg/auth/recovery.bit — one-time recovery codes for a TOTP second factor
// (#6930): what a user types when the authenticator phone is lost.
//
// NIST SP 800-63B §5.1.2 calls these look-up secrets: generated by an
// approved random source, single use, and at least 20 bits of entropy when
// stored hashed. These are 50 bits by default (OWASP's MFA cheat sheet asks
// for the same: random, long enough to resist online guessing, single use).
//
// FORMAT: a code is `groups` groups of `groupLen` characters joined with
// `-`, e.g. `k3x9a-7qm2p`. Each character is 5 random bits mapped through
// Crockford's base32 alphabet (`0-9a-z` without `i`, `l`, `o`, `u`) — 32
// symbols, so masking a random byte to its low 5 bits is exactly uniform.
// The characters people confuse are folded on input (`o` reads as `0`, `i`
// and `l` as `1`), case and separators are ignored, so a code read off a
// printout redeems however it is retyped.
//
// STORAGE: only `RecoverySet.hashes` is persisted. Each entry is
// `<salt>$<digest>`: a fresh 16-byte random salt (hex) and the hex SHA-256
// of the salt text followed by the normalised code. A salted fast hash is
// the right tool here, not a password hash: the input is 50+ random bits,
// not a human-chosen secret, so there is no dictionary to walk and a slow
// KDF buys nothing against an attacker who already holds the database; the
// per-code salt only defeats a precomputed table and cross-code batching.
// The code is single use, so the work an offline attacker would spend is
// worth nothing once the owner redeems it. Every check hashes under the
// stored salt and compares with `ctEq`, so a miss leaks nothing about which
// stored code was close.
//
// REGENERATING: there is no server-side state to clear. Store a new
// `RecoverySet.hashes` over the old list; the old codes hash under salts
// that are no longer stored and so fail `redeemRecoveryCode`.
//
// `ctEq` (oidc_verify.bit), `randomBytes` (password.bit), and `digest`,
// `encodeHex`, `Sha256` (oidc_authorize.bit, throttle.bit) are already
// imported in this module; an identical import binds the same symbol
// (SPEC §17.1), so this file repeats them and still compiles standalone.
import { ctEq, digest, encodeHex, randomBytes, Sha256 } from "std/crypto"

// Crockford's base32 alphabet, lower case: 32 symbols, no `i l o u`.
const recoveryAlphabet = "0123456789abcdefghjkmnpqrstvwxyz"

// NIST SP 800-63B §5.1.2 lower bound, with margin over the 20-bit floor.
const recoveryMinBits = 50
const recoveryBitsPerChar = 5
const recoveryMaxCount = 32
const recoveryMaxGroups = 8
const recoveryMaxGroupLen = 16
const recoverySaltLen = 16

// Longest input worth hashing: the widest valid code is 8 x 16 characters
// plus 7 separators; anything past this much padding cannot be a code.
const recoveryMaxInput = 256

// How many codes to make and how each looks. The defaults give ten codes of
// `groups x groupLen` = 10 characters = 50 bits each.
export class RecoveryOptions {
  export count: int = 10,
  export groups: int = 2,
  export groupLen: int = 5,
}

// A freshly generated batch. `codes` is shown to the user once and never
// stored; `hashes` is what the application persists and passes back to
// `redeemRecoveryCode`.
export class RecoverySet {
  export codes: []string,
  export hashes: []string,
}

// What a successful redemption leaves behind: the stored hashes minus the
// one that was just used. The caller persists `remaining` in place of the
// old list, which is what makes a code single use.
export class RecoveryRedeem {
  export remaining: []string,
}

// The reason `opts` is unusable, or "" when it is fine.
fn recoveryOptionsProblem(opts: RecoveryOptions): string {
  if (opts.count < 1 || opts.count > recoveryMaxCount) {
    return "auth: generateRecoveryCodes(): count ${opts.count} must be 1 to ${recoveryMaxCount}"
  }
  if (opts.groups < 1 || opts.groups > recoveryMaxGroups) {
    return "auth: generateRecoveryCodes(): groups ${opts.groups} must be 1 to ${recoveryMaxGroups}"
  }
  if (opts.groupLen < 1 || opts.groupLen > recoveryMaxGroupLen) {
    return "auth: generateRecoveryCodes(): groupLen ${opts.groupLen} must be 1 to ${recoveryMaxGroupLen}"
  }
  let bits = opts.groups * opts.groupLen * recoveryBitsPerChar
  if (bits < recoveryMinBits) {
    return "auth: generateRecoveryCodes(): ${bits} bits per code is below the ${recoveryMinBits}-bit minimum"
  }
  return ""
}

// One code in display form, `groups` groups of `groupLen` characters.
fn newRecoveryCode(opts: RecoveryOptions): string {
  let raw = randomBytes(opts.groups * opts.groupLen)
  let out = []byte(0)
  let i = 0
  while (i < len(raw)) {
    if (i > 0 && i % opts.groupLen == 0) {
      out = append(out, '-')
    }
    out = append(out, recoveryAlphabet[int(raw[i] & 31)])
    i = i + 1
  }
  return string(out)
}

// The canonical form a code is hashed and compared in: lower case, no
// spaces or dashes, and the look-alike characters folded onto their
// alphabet symbol.
fn normalizeRecoveryCode(input: string): string {
  let out = []byte(0)
  let i = 0
  while (i < len(input)) {
    let c = input[i]
    if (c >= 'A' && c <= 'Z') {
      c = c + 32
    }
    if (c == 'o') {
      c = '0'
    }
    if (c == 'i' || c == 'l') {
      c = '1'
    }
    if (c != ' ' && c != '-') {
      out = append(out, c)
    }
    i = i + 1
  }
  return string(out)
}

// SHA-256 over the salt text then the canonical code, as lower-case hex.
fn recoveryDigest(salt: string, canonical: string): string {
  return encodeHex(digest(Sha256(), []byte(salt + canonical)))
}

fn hashRecoveryCode(code: string): string {
  let salt = encodeHex(randomBytes(recoverySaltLen))
  return salt + "$" + recoveryDigest(salt, normalizeRecoveryCode(code))
}

// Index of the `$` separating salt from digest in a stored entry, or -1.
fn saltEnd(stored: string): int {
  let i = 0
  while (i < len(stored)) {
    if (stored[i] == '$') {
      return i
    }
    i = i + 1
  }
  return 0 - 1
}

// Does `canonical` hash to the stored entry? A malformed entry never matches
// but still costs one hash, like a well-formed one.
fn recoveryMatches(stored: string, canonical: string): bool {
  let at = saltEnd(stored)
  if (at < 0) {
    return ctEq([]byte(recoveryDigest("", canonical)), []byte(stored))
  }
  let want = []byte(stored[at + 1:len(stored)])
  return ctEq([]byte(recoveryDigest(stored[0:at], canonical)), want)
}

// A batch of single-use recovery codes. Show `codes` to the user once and
// store `hashes`; to regenerate, store the hashes of a new call over the old
// list, and every old code stops working. Fails on options outside the
// documented bounds (1 to 32 codes, at least 50 bits each).
export fn generateRecoveryCodes(opts: RecoveryOptions = RecoveryOptions{}): RecoverySet! {
  let problem = recoveryOptionsProblem(opts)
  if (problem != "") {
    fail newError(problem)
  }
  let codes = []string(0)
  let hashes = []string(0)
  let n = 0
  while (n < opts.count) {
    let code = newRecoveryCode(opts)
    codes = append(codes, code)
    hashes = append(hashes, hashRecoveryCode(code))
    n = n + 1
  }
  return RecoverySet{ codes = codes, hashes = hashes }
}

// Redeems `input` against the stored `hashes`. Case, spaces and dashes in
// `input` do not matter. On a match, returns the list without the used
// entry for the caller to persist; on any miss, one error for every cause
// (wrong code, used code, malformed input). Every stored entry is checked,
// so the time taken does not say which one matched or whether any did.
export fn redeemRecoveryCode(hashes: []string, input: string): RecoveryRedeem! {
  let canonical = normalizeRecoveryCode(input)
  let used = 0 - 1
  if (len(input) <= recoveryMaxInput) {
    let i = 0
    while (i < len(hashes)) {
      if (recoveryMatches(hashes[i], canonical) && used < 0) {
        used = i
      }
      i = i + 1
    }
  }
  if (used < 0) {
    fail newError("auth: recovery code not recognised")
  }
  let remaining = []string(0)
  let j = 0
  while (j < len(hashes)) {
    if (j != used) {
      remaining = append(remaining, hashes[j])
    }
    j = j + 1
  }
  return RecoveryRedeem{ remaining = remaining }
}
