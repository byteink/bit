// pkg/auth/recovery.bit — one-time recovery codes for a TOTP second factor
// (#6930): what a user types when the authenticator phone is lost.
//
// NIST SP 800-63B §5.1.2 calls these look-up secrets: generated by an
// approved random source and single use. Its storage rule splits on
// entropy: a look-up secret with at least 112 bits may be kept as a salted
// approved hash, one with LESS SHALL be salted and hashed with a password
// hashing scheme. These codes are typed by people, so the
// floor here is 50 bits, well under 112, and storage is therefore the
// package's own Argon2id (`hashPassword`, password.bit: the same OWASP-cited
// cost as a password). 2^50 guesses at that cost is out of reach for a thief
// who copied the table; at salted-SHA-256 speed it would be a day of GPU time.
//
// FORMAT: `<id>-<secret groups>`, e.g. `a3k9-k3x9a-7qm2p`. The first group is
// a 4-character LOOKUP ID, random, unique within the set, stored in the clear
// beside the hash and NOT counted toward the 50 bits (whoever holds the table
// knows it). The rest is the secret: `groups` groups of `groupLen` characters,
// 5 random bits each, Crockford base32 lower case (`0-9a-z` without `i l o u`,
// 32 symbols, so the low 5 bits of a random byte are exactly uniform). People
// confuse characters, so on input `o` reads as `0` and `i`/`l` as `1`; case,
// spaces and dashes are ignored.
//
// WHY AN ID: a stored entry is `<id><argon2id PHC string>`. Redeeming reads
// the first group, picks the one entry with that id, and runs Argon2id ONCE
// against the rest. Without the id the verifier would have to try every
// stored hash, an N-fold (up to 32x) cost per guess that hands an attacker a
// cheap way to exhaust the server. With it a guess costs one run, like a
// password check, and an id that matches nothing runs against
// `dummyEncodedHash` (password.bit), so hit, wrong secret and unknown id all
// cost one run and look the same. The id is not secret and the branch on it
// leaks nothing an attacker without the table could use: a miss and a hit
// take the same time, and `argon2Verify` compares the tag in constant time.
//
// THROTTLING: `RedeemOptions.throttle` takes the same `LoginThrottle` as
// `PasswordStrategy` (#6927), consulted before the hash, fed on every miss
// and cleared on a hit. Counters are kept under the account name prefixed
// `recovery:`, so a flood of wrong recovery codes cannot lock the password
// login and vice versa. With no throttle nothing is counted: the application
// then owes the throttling itself (docs/totp.md).
//
// REGENERATING: there is no server-side state to clear. Store a new
// `RecoverySet.hashes` over the old list; old codes name ids and hashes that
// are no longer stored and fail `redeemRecoveryCode`.
//
// `randomBytes` (password.bit), `Verify`/`runVerify`/`hashPassword`/
// `dummyEncodedHash` (password.bit), `LoginThrottle`/`Throttled`
// (throttle.bit) are module-wide already; an import binds per MODULE
// (SPEC §17.1) and an identical one repeats harmlessly.
import { randomBytes } from "std/crypto"

// Crockford's base32 alphabet, lower case: 32 symbols, no `i l o u`.
const recoveryAlphabet = "0123456789abcdefghjkmnpqrstvwxyz"

// Lower bound on the SECRET part of a code (the lookup id is not counted).
const recoveryMinBits = 50
const recoveryBitsPerChar = 5
const recoveryMaxCount = 32
const recoveryMaxGroups = 8
const recoveryMaxGroupLen = 16

// The lookup id: 4 characters (20 bits), so 32 codes collide with
// probability about 5e-4 per set, and the redraw below makes it zero.
const recoveryIdLen = 4
const recoveryIdTries = 64

// Longest input worth looking at: the widest valid code is a 4-character
// id, 8 x 16 secret characters and 8 separators; more than this cannot be one.
const recoveryMaxInput = 256

// The throttle key prefix that keeps recovery attempts off the password
// login's counters.
const recoveryThrottlePrefix = "recovery:"

const recoveryMiss = "auth: recovery code not recognised"

// How many codes to make and how the secret part of each looks. The defaults
// give ten codes with a 4-character id and `groups x groupLen` = 10 secret
// characters = 50 bits each.
export class RecoveryOptions {
  export count: int = 10,
  export groups: int = 2,
  export groupLen: int = 5,
}

// A freshly generated batch. `codes` is shown to the user once and never
// stored; `hashes` is what the application persists and passes back to
// `redeemRecoveryCode`.
export class RecoverySet {
  export codes: []string,
  export hashes: []string,
}

// What a successful redemption leaves behind: the stored hashes minus the
// one that was just used. The caller persists `remaining` in place of the
// old list, which is what makes a code single use.
export class RecoveryRedeem {
  export remaining: []string,
}

// The optional knobs of `redeemRecoveryCode`. `throttle` is the
// `LoginThrottle` to consult and feed (`None`: no throttle, and `account` and
// `ip` are ignored). `account` is the user the codes belong to and `ip` the
// client address (`c.peer()`), the same pair `PasswordStrategy` gives it.
export class RedeemOptions {
  export throttle: Option<LoginThrottle>,
  export account: string,
  export ip: string,
}

// The reason `opts` is unusable, or "" when it is fine.
fn recoveryOptionsProblem(opts: RecoveryOptions): string {
  if (opts.count < 1 || opts.count > recoveryMaxCount) {
    return "auth: generateRecoveryCodes(): count ${opts.count} must be 1 to ${recoveryMaxCount}"
  }
  if (opts.groups < 1 || opts.groups > recoveryMaxGroups) {
    return "auth: generateRecoveryCodes(): groups ${opts.groups} must be 1 to ${recoveryMaxGroups}"
  }
  if (opts.groupLen < 1 || opts.groupLen > recoveryMaxGroupLen) {
    return "auth: generateRecoveryCodes(): groupLen ${opts.groupLen} must be 1 to ${recoveryMaxGroupLen}"
  }
  let bits = opts.groups * opts.groupLen * recoveryBitsPerChar
  if (bits < recoveryMinBits) {
    return "auth: generateRecoveryCodes(): ${bits} secret bits per code is below the ${recoveryMinBits}-bit minimum"
  }
  return ""
}

// `n` random alphabet characters.
fn randomRecoveryChars(n: int): string {
  let raw = randomBytes(n)
  let out = []byte(0)
  let i = 0
  while (i < len(raw)) {
    out = append(out, recoveryAlphabet[int(raw[i] & 31)])
    i = i + 1
  }
  return string(out)
}

// The secret part of one code in display form, `groups` groups of
// `groupLen` characters joined with `-`.
fn newRecoverySecret(opts: RecoveryOptions): string {
  let out = ""
  let g = 0
  while (g < opts.groups) {
    if (g > 0) {
      out = out + "-"
    }
    out = out + randomRecoveryChars(opts.groupLen)
    g = g + 1
  }
  return out
}

// A lookup id not yet in `taken`. Fails only after `recoveryIdTries`
// collisions in a row, which a working CSPRNG does not produce.
fn newRecoveryId(taken: []string): string! {
  let tries = 0
  while (tries < recoveryIdTries) {
    let id = randomRecoveryChars(recoveryIdLen)
    let free = true
    for t of taken {
      if (t == id) {
        free = false
      }
    }
    if (free) {
      return id
    }
    tries = tries + 1
  }
  fail newError("auth: generateRecoveryCodes(): no unused lookup id after ${recoveryIdTries} draws")
}

// The canonical form a code is hashed and compared in: lower case, no
// spaces or dashes, and the look-alike characters folded onto their
// alphabet symbol.
fn normalizeRecoveryCode(input: string): string {
  let out = []byte(0)
  let i = 0
  while (i < len(input)) {
    let c = input[i]
    if (c >= 'A' && c <= 'Z') {
      c = c + 32
    }
    if (c == 'o') {
      c = '0'
    }
    if (c == 'i' || c == 'l') {
      c = '1'
    }
    if (c != ' ' && c != '-') {
      out = append(out, c)
    }
    i = i + 1
  }
  return string(out)
}

// The stored form of one code: its id, then the Argon2id PHC string of the
// canonical secret.
fn hashRecoveryCode(id: string, secret: string): string {
  return id + hashPassword(normalizeRecoveryCode(secret))
}

// A batch of single-use recovery codes. Show `codes` to the user once and
// store `hashes`; to regenerate, store the hashes of a new call over the old
// list, and every old code stops working. Every code costs one Argon2id run
// to make. Fails on options outside the documented bounds (1 to 32 codes, at
// least 50 secret bits each).
export fn generateRecoveryCodes(opts: RecoveryOptions = RecoveryOptions{}): RecoverySet! {
  let problem = recoveryOptionsProblem(opts)
  if (problem != "") {
    fail newError(problem)
  }
  let codes = []string(0)
  let hashes = []string(0)
  let ids = []string(0)
  let n = 0
  while (n < opts.count) {
    let id = newRecoveryId(ids)?
    let secret = newRecoverySecret(opts)
    ids = append(ids, id)
    codes = append(codes, id + "-" + secret)
    hashes = append(hashes, hashRecoveryCode(id, secret))
    n = n + 1
  }
  return RecoverySet{ codes = codes, hashes = hashes }
}

// Index of the stored entry whose id is `id`, or -1. Ids are not secret.
fn recoveryEntryFor(hashes: []string, id: string): int {
  let i = 0
  while (i < len(hashes)) {
    if (len(hashes[i]) > recoveryIdLen && hashes[i][0:recoveryIdLen] == id) {
      return i
    }
    i = i + 1
  }
  return 0 - 1
}

// Which stored entry `canonical` redeems, or -1, with exactly ONE Argon2id
// run through `verify` whatever the answer: the id picks the entry, and an id
// that picks nothing verifies against the dummy hash instead.
fn recoveryMatch(hashes: []string, canonical: string, verify: Verify): int {
  let id = canonical
  let secret = ""
  if (len(canonical) > recoveryIdLen) {
    id = canonical[0:recoveryIdLen]
    secret = canonical[recoveryIdLen:len(canonical)]
  }
  let at = recoveryEntryFor(hashes, id)
  let encoded = dummyEncodedHash
  if (at >= 0) {
    encoded = hashes[at][recoveryIdLen:len(hashes[at])]
  }
  let ok = runVerify(verify, []byte(secret), encoded)
  if (ok && at >= 0) {
    return at
  }
  return 0 - 1
}

fn throttleAccount(opts: RedeemOptions): string {
  return recoveryThrottlePrefix + opts.account
}

fn recoveryThrottleDown(e: error): error {
  return newError("auth: redeemRecoveryCode(): the throttle failed, refusing the code: ${e.message()}")
}

// The throttle's say, before any hash. A refused client pays one dummy
// Argon2id run first, so a refusal costs what a wrong code costs.
fn admitRecovery(opts: RedeemOptions, verify: Verify): ()! {
  match (opts.throttle) {
    None => return
    Some(t) => {
      t.check(throttleAccount(opts), opts.ip) catch e {
        let (_, locked) = e.(Throttled)
        if (!locked) {
          fail recoveryThrottleDown(e)
        }
        let _ = runVerify(verify, []byte(""), dummyEncodedHash)
        fail e
      }
    }
  }
}

// Counts the outcome against the throttle: a miss is a failure, a hit clears
// the account. A store that cannot record it refuses the code (fail closed).
fn recordRecovery(opts: RedeemOptions, hit: bool): ()! {
  match (opts.throttle) {
    None => return
    Some(t) => {
      if (hit) {
        t.recordSuccess(throttleAccount(opts)) catch e {
          fail recoveryThrottleDown(e)
        }
        return
      }
      t.recordFailure(throttleAccount(opts), opts.ip) catch e {
        fail recoveryThrottleDown(e)
      }
    }
  }
}

fn without(hashes: []string, used: int): []string {
  let remaining = []string(0)
  let j = 0
  while (j < len(hashes)) {
    if (j != used) {
      remaining = append(remaining, hashes[j])
    }
    j = j + 1
  }
  return remaining
}

// `redeemRecoveryCode` with the verifier as a parameter: `nil` is the real
// `argon2Verify`, a test passes a call-counting fake (see `Verify`,
// password.bit).
fn redeemWith(
  hashes: []string,
  input: string,
  opts: RedeemOptions,
  verify: Verify,
): RecoveryRedeem! {
  admitRecovery(opts, verify)?
  let canonical = ""
  if (len(input) <= recoveryMaxInput) {
    canonical = normalizeRecoveryCode(input)
  }
  let used = recoveryMatch(hashes, canonical, verify)
  recordRecovery(opts, used >= 0)?
  if (used < 0) {
    fail newError(recoveryMiss)
  }
  return RecoveryRedeem{ remaining = without(hashes, used) }
}

// Redeems `input` against the stored `hashes`. Case, spaces and dashes in
// `input` do not matter. On a match, returns the list without the used
// entry for the caller to persist; on any miss, one error for every cause
// (wrong code, used code, malformed input). Costs exactly one Argon2id run
// however many codes are stored. With `opts.throttle` set, a locked account
// or address is refused first with the throttle's `Throttled` (429), and
// every miss counts against it.
export fn redeemRecoveryCode(
  hashes: []string,
  input: string,
  opts: RedeemOptions = RedeemOptions{},
): RecoveryRedeem! {
  return redeemWith(hashes, input, opts, nil)?
}
