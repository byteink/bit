// pkg/auth/password.bit — PasswordStrategy (#5771): a `Strategy`
// (strategy.bit) over `std/crypto`'s Argon2id, with no users table of its
// own. The application supplies a `Lookup` callback that finds a user by
// username and returns the stored Argon2id hash; this file only verifies
// it and builds the `Identity`.
//
// CREDENTIALS CONVENTION: a JSON body, `{"username": "...", "password":
// "..."}`, read with `c.body<Credentials>()` — the same convention every
// other route in `pkg/web` and this package's own OIDC callback (#5777)
// reads its input with, so this package needs no second body parser. A
// form-encoded body is not accepted.
//
// THE TIMING REQUIREMENT (#5771): a wrong password for a real user and a
// lookup that finds no such user must return the identical error and do
// the same work. `authenticate` never learns "not found" is different from
// "found, wrong password" before it has already run a full Argon2id
// verification — on `lookup`'s own failure it runs one against
// `dummyEncodedHash` instead of short-circuiting, then returns the same
// `unauthorized()` (pkg/web/errors.bit:160) either path takes. `verify` is
// a seam (`Verify`, below) so a test can prove BOTH paths call it exactly
// once, the call-counting shape `oidc_discovery.bit`'s `HttpFetch` already
// uses for its own network seam.
//
// THE LOGIN THROTTLE (#6927): `PasswordOptions.throttle` is an optional
// `LoginThrottle` (throttle.bit). With none, nothing below changes. With one,
// `authenticate` asks it BEFORE the lookup, records every failure and every
// success, and keeps the two properties above on every path: a client the
// throttle refuses still pays one Argon2id run (against `dummyEncodedHash`)
// before it is told so, so the time a refused request takes does not say
// whether the account exists or is locked, and the throttle counts every
// account string, real or not, so a refusal looks the same for both. A
// refusal is the throttle's own `Throttled` (429); a throttle store failure
// refuses the login with a plain error (500), never lets it through.
//
// THE AUDIT HOOK: `PasswordOptions.onEvent` is told every success, failure and
// refusal as an `AuthEvent`. The strategy logs nothing itself. A hook that
// panics is caught (`std/runtime`'s `runRecovering`) and ignored, so no hook
// can change a login's outcome.
//
// NORMALIZATION LIVES IN THE STORED HASH (#7157). A hash made by
// `PasswordPolicy.hash` (policy.bit) over an NFKC-normalized password carries
// the extra PHC parameter `n=nfkc` after the Argon2 ones:
// `$argon2id$v=19$m=19456,t=2,p=1,n=nfkc$<salt>$<tag>`. `authenticate` applies
// NFKC to the typed password exactly when the stored hash says so, so verify
// can never disagree with how the password was set, whatever the application's
// policy says today and whether it hashed with `hashPassword` or `policy.hash`.
// A hash without the parameter (every hash before #7157, and `hashPassword`'s)
// is verified as typed. The parameter is removed before `argon2Verify` sees the
// string, so `std/crypto` keeps its strict three-parameter parser.
//
// `argon2Verify` already compares the computed tag in constant time via
// `std/crypto`'s `ctEq` — this file does not duplicate that comparison,
// only the "always verify" discipline around it.
//
// `unauthorized` is already bound module-wide by `middleware.bit`, `Json`/
// `Ctx` by `strategy.bit`, and `Strategy`/`Identity` are declared (not
// imported) in this module — an import binds per MODULE (SPEC §17.1), so
// re-importing any of them here is E0042.
import { argon2Hash, argon2Verify, randomBytes } from "std/crypto"
import { runRecovering } from "std/runtime"

// Argon2id cost parameters: OWASP Password Storage Cheat Sheet, "Argon2id"
// (https://cheatsheetseries.owasp.org/cheatsheets/Password_Storage_Cheat_Sheet.html#argon2id),
// the m=19456 (19 MiB) / t=2 / p=1 row — one of five configurations the
// cheat sheet states "provide an equal level of defense", trading memory
// against CPU; this is the row it leads its own summary with.
const argon2MemoryKiB = 19456
const argon2Iterations = 2
const argon2Parallelism = 1
const argon2OutLen = 32
const argon2SaltLen = 16

// A fixed, well-formed Argon2id PHC string at the SAME cost parameters as
// `hashPassword`, below — so verifying against it costs the same
// computation as a real lookup, and no password was ever hashed to
// produce it. `authenticate` verifies against this whenever `lookup`
// reports the user does not exist; it carries `n=nfkc` so that path normalizes
// the password too, like a policy-hashed account's. Generated once, offline,
// from 16 arbitrary salt bytes and 32 arbitrary tag bytes; the exact bytes do
// not matter; only that the string is a structurally valid encoding
// `argon2Verify` will run a full computation against before failing.
const dummyEncodedHash = "$argon2id$v=19$m=19456,t=2,p=1,n=nfkc$AAECAwQFBgcICQoLDA0ODw$AwoRGB8mLTQ7QklQV15lbHN6gYiPlp2kq7K5wMfO1dw"

// Hashes `password` into a stored Argon2id PHC string, at this file's
// OWASP-cited cost parameters and a fresh random salt. What an application
// calls when it creates or resets a password; the result is what `Lookup`
// hands back as `LookupResult.hash`. The password is hashed as given: the hash
// records no normalization, so `PasswordStrategy` verifies it as typed. For NFKC
// use `PasswordPolicy.hash` (policy.bit).
export fn hashPassword(password: string): string {
  return argon2Hash(
    []byte(password),
    randomBytes(argon2SaltLen),
    argon2Iterations,
    argon2MemoryKiB,
    argon2Parallelism,
    argon2OutLen,
  )
}

// The PHC parameter that records NFKC normalization, and where it sits: the
// `$`-separated fields of a PHC string are `["", type, version, params, salt,
// tag]`, and the params field is `m=..,t=..,p=..` with `n=nfkc` appended.
const normParam = "n=nfkc"
const phcParamsField = 3
const phcFieldCount = 6
const argon2ParamCount = 3

// `password` NFKC-normalized and hashed like `hashPassword`, with `n=nfkc`
// added to the parameters so verify normalizes the typed password too.
// `PasswordPolicy.hash` is its only caller.
fn hashNormalized(password: string): string {
  let parts = split(hashPassword(normalize(password, Form.Nfkc)), "$")
  return phcString(parts, parts[phcParamsField] + "," + normParam)
}

// The PHC string `parts` (as `split(s, "$")` cut it) with its params field
// replaced by `params`.
fn phcString(parts: []string, params: string): string {
  return "$" + parts[1] + "$" + parts[2] + "$" + params + "$" + parts[4] + "$" + parts[5]
}

// Splits a stored hash into the plain Argon2 PHC string `argon2Verify` parses
// and whether it carries `n=nfkc`. Anything else, including a string of another
// shape or a different `n=` value, comes back untouched and not normalized, so
// `argon2Verify` refuses it: an unknown normalization never verifies.
fn storedForm(encoded: string): (string, bool) {
  let parts = split(encoded, "$")
  if (len(parts) != phcFieldCount) {
    return (encoded, false)
  }
  let params = split(parts[phcParamsField], ",")
  if (len(params) != argon2ParamCount + 1 || params[argon2ParamCount] != normParam) {
    return (encoded, false)
  }
  return (phcString(parts, params[0] + "," + params[1] + "," + params[2]), true)
}

// Checks `password` as typed against `encoded`, normalizing it exactly when
// `encoded` says it was normalized at set time (`storedForm`).
fn verifyStored(v: Verify, password: string, encoded: string): bool {
  let (plain, normalized) = storedForm(encoded)
  if (normalized) {
    return runVerify(v, []byte(normalize(password, Form.Nfkc)), plain)
  }
  return runVerify(v, []byte(password), plain)
}

// The JSON body `authenticate` reads: `{"username": "...", "password": "..."}`.
@json class Credentials {
  username: string,
  password: string,
}

// What `Lookup` returns for a username it recognizes: the stored Argon2id
// hash to verify against, and enough to build the `Identity` a successful
// verification produces.
export class LookupResult {
  export hash: string,
  export id: string,
  export claims: Json,
}

// Finds a user by username, or fails when there is no such user. The
// application supplies this; `pkg/auth` holds no users table (owner
// ruling, #3960).
export type Lookup = (string) => LookupResult!

// The verifier seam `authenticate` calls to check a password against an
// encoded hash: `nil` means the real `argon2Verify` (std/crypto); a test
// substitutes a call-counting fake to prove the wrong-password and
// unknown-user paths call it exactly once each (#5771's timing
// requirement). Production code always passes `nil`.
type Verify = ([]byte, string) => bool

fn runVerify(v: Verify, password: []byte, encoded: string): bool {
  if (v == nil) {
    return argon2Verify(password, encoded)
  }
  return v(password, encoded)
}

// The audit event kinds `AuthEvent.kind` takes.
const eventSuccess = "login.success"
const eventFailure = "login.failure"
const eventLocked = "login.locked"

// What an audit hook is told: `kind` is "login.success", "login.failure" or
// "login.locked" (the throttle refused the attempt). `account` is the SHA-256
// hash of the lower-cased username, the same value `ThrottleEvent.account`
// carries, never the name typed into the form: people type passwords into
// username fields and a log is the last place for one. `ip` is `c.peer()`,
// `at` is seconds since the epoch.
export class AuthEvent {
  export kind: string,
  export account: string,
  export ip: string,
  export at: i64,
}

// Called synchronously for every event; it cannot fail, and a panic in it is
// caught and ignored (see this file's header).
export type AuthEventHook = (AuthEvent) => ()

// The optional knobs of `PasswordStrategy(lookup, opts)`, all defaulting:
// `throttle` is the `LoginThrottle` to consult and feed (`None`: no throttle),
// `onEvent` is the audit hook (`nil`: none). `second` (#7311) is asked, with the
// verified `Identity`, whether this user still owes a second factor (`None`: no
// one does); when it answers true the login is bound pending straight away and
// `authenticate` fails with the 401 `second_factor_required` (mfa.bit), so no
// full session exists before `completeSecondFactor`. Normalization is not an
// option: the stored hash says whether the password was normalized (this file's
// header).
export class PasswordOptions {
  export throttle: Option<LoginThrottle>,
  export onEvent: AuthEventHook,
  export second: Option<SecondRequired>,
}

// The login refused because the throttle's store failed: not a `Throttled`, so
// the client sees a 500 and the cause stays in the server's log.
fn throttleDown(e: error): error {
  return newError("auth: PasswordStrategy: the login throttle failed, refusing the login: ${e.message()}")
}

// A `Strategy` (strategy.bit) that authenticates a request's `Credentials`
// body against whatever `lookup` reports, per this file's header:
// `PasswordStrategy(lookup)`, or `PasswordStrategy(lookup, PasswordOptions{
// throttle = Option<LoginThrottle>.Some(throttle) })` to throttle it. `verify`
// is the test seam, `nil` (the real Argon2id check) from the constructor; a
// test in this module sets it with a composite literal. The options live as
// two fields, not a `PasswordOptions` field, so that literal still compiles
// (a class-typed field has no zero value, E0083).
export class PasswordStrategy {
  lookup: Lookup
  verify: Verify
  throttle: Option<LoginThrottle>
  onEvent: AuthEventHook
  second: Option<SecondRequired>

  init(lookup: Lookup, opts: PasswordOptions = PasswordOptions{}) {
    this.lookup = lookup
    this.verify = nil
    this.throttle = opts.throttle
    this.onEvent = opts.onEvent
    this.second = opts.second
  }

  export name(): string {
    return "password"
  }

  // Reads `Credentials` from the body, asks the throttle (when there is one),
  // looks the username up, and verifies the password against the stored hash.
  // `lookup` failing is not treated as a different case from a verified-but-
  // wrong password: both run exactly one `runVerify` call and both fail with
  // the same `unauthorized()`, per this file's header.
  //
  // A verified login regenerates the session id (`Session.regenerate()`,
  // pkg/web/session.bit — #5795, session fixation) before handing back the
  // Identity (or, for a user `PasswordOptions.second` holds back, before binding
  // the pending half login and failing with `second_factor_required`): this runs whether the caller is `requireAuth` or, as
  // `password.test.bit`'s own harness does, a dedicated `/login` route
  // calling `authenticate` directly — the shape a real password login uses,
  // where `requireAuth`'s own regeneration is never reached.
  export authenticate(c: Ctx): Identity! {
    let creds = c.body<Credentials>()?
    let ip = c.peer()
    this.admit(creds, ip)?
    let result = this.lookup(creds.username) catch _ {
      let _ = verifyStored(this.verify, creds.password, dummyEncodedHash)
      this.failed(creds.username, ip)?
      fail unauthorized()
    }
    if (!verifyStored(this.verify, creds.password, result.hash)) {
      this.failed(creds.username, ip)?
      fail unauthorized()
    }
    this.succeeded(creds.username, ip)?
    c.session()?.regenerate()?
    let identity = Identity{ id = result.id, claims = result.claims }
    bindFirstFactor(c, identity, this.second)?
    return identity
  }

  // The throttle's say, before any lookup. A refused client pays one dummy
  // Argon2id run first, so refusal costs the same time as a wrong password.
  admit(creds: Credentials, ip: string): ()! {
    match (this.throttle) {
      None => return
      Some(t) => {
        t.check(creds.username, ip) catch e {
          let (_, locked) = e.(Throttled)
          if (!locked) {
            fail throttleDown(e)
          }
          let _ = verifyStored(this.verify, creds.password, dummyEncodedHash)
          this.emit(eventLocked, creds.username, ip)
          fail e
        }
      }
    }
  }

  // Tells the hook, then counts the failure against the account and address.
  failed(username: string, ip: string): ()! {
    this.emit(eventFailure, username, ip)
    match (this.throttle) {
      None => return
      Some(t) => {
        t.recordFailure(username, ip) catch e {
          fail throttleDown(e)
        }
      }
    }
  }

  // Resets the account's failures, then tells the hook: a login the throttle
  // could not record is refused, so it is not reported as a success.
  succeeded(username: string, ip: string): ()! {
    match (this.throttle) {
      None => {}
      Some(t) => {
        t.recordSuccess(username) catch e {
          fail throttleDown(e)
        }
      }
    }
    this.emit(eventSuccess, username, ip)
  }

  // Hands the hook one event; whatever the hook does, the login goes on.
  emit(kind: string, username: string, ip: string) {
    let hook = this.onEvent
    if (hook == nil) {
      return
    }
    let ev = AuthEvent{ kind = kind, account = accountHash(username), ip = ip, at = wallSeconds() }
    let (_, _) = runRecovering(() => {
      hook(ev)
    })
  }
}
