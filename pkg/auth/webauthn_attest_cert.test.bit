import { asn1Set, asn1Utf8String, asn1PrintableString, asn1ExplicitTag, asn1Boolean } from "std/crypto"

// W3C REC 2026-08-25 section 16.7. Country AA is a synthetic vector.
fn waCertVector(): []byte {
  return waHex("")
}
fn waCertGuid(): []byte { return waHex("876ca4f52071c3e9b25509ef2cdf7ed6") }
fn waCertTree(): Element {
  return asn1Parse(waCertVector()) catch e {
    panic(e.message())
  }
}
fn waCertError(der: []byte, guid: []byte): string {
  waCheckPackedCertificate(der, guid) catch e {
    return e.message()
  }
  return "accepted"
}
fn waCertCheck(tree: Element): string { return waCertError(asn1Encode(tree), waCertGuid()) }
fn waCertRdn(arc: int, value: Element): Element {
  return asn1Set([asn1Sequence([oid([2, 5, 4, arc]), value])])
}
fn waCertName(): []Element {
  return [
    waCertRdn(6, asn1PrintableString("AA")), waCertRdn(10, asn1Utf8String("W3C")),
    waCertRdn(11, asn1Utf8String("Authenticator Attestation")), waCertRdn(
      3,
      asn1Utf8String("Test"),
    ),
  ]
}
fn waCertWithName(name: []Element): Element {
  let tree = waCertTree()
  tree.children[0].children[5] = asn1Sequence(name)
  return tree
}
fn waCertExt(value: Element, critical: bool): Element {
  return asn1Sequence(
    [
      oid([1, 3, 6, 1, 4, 1, 45724, 1, 1, 4]), asn1Boolean(critical),
      asn1OctetString(asn1Encode(value)),
    ],
  )
}
fn waCertWithExt(ext: Element): Element {
  let tree = waCertTree()
  let extensions = tree.children[0].children[7].children[0].children
  extensions = append(extensions, ext)
  tree.children[0].children[7] = asn1ExplicitTag(3, asn1Sequence(extensions))
  return tree
}

// Altered DER fixtures check only the profile. Their signatures are not valid.
test "packed certificate accepts official profile and matching optional AAGUID" {
  assert(waCertError(waCertVector(), waCertGuid()) == "accepted", "official absent AAGUID")
  let tree = waCertWithExt(waCertExt(asn1OctetString(waCertGuid()), false))
  assert(waCertCheck(tree) == "accepted", "matching optional AAGUID")
}

test "packed certificate refuses mismatched malformed and critical AAGUID" {
  let wrong = waCertGuid()
  wrong[0] = wrong[0] ^ 1
  let tree = waCertWithExt(waCertExt(asn1OctetString(wrong), false))
  assert(waCertCheck(tree) == waCertFailure, "mismatched AAGUID rejected")
  for value of [
    asn1OctetString([]byte(15)),
    asn1OctetString([]byte(17)),
    asn1Utf8String("not an OCTET STRING"),
  ] {
    assert(
      waCertCheck(waCertWithExt(waCertExt(value, false))) == waCertFailure,
      "inner tag or length",
    )
  }
  assert(
    waCertCheck(waCertWithExt(waCertExt(asn1OctetString(waCertGuid()), true))) == waCertFailure,
    "critical AAGUID",
  )
}

test "packed certificate refuses absent duplicate and forged subject attributes" {
  let name = waCertName()
  let i = 0
  while (i < 4) {
    let missing = []Element(0)
    let j = 0
    while (j < 4) {
      if (j != i) {
        missing = append(missing, name[j])
      }
      j = j + 1
    }
    assert(waCertCheck(waCertWithName(missing)) == waCertFailure, "missing required attribute")
    assert(
      waCertCheck(waCertWithName(append(waCertName(), name[i]))) == waCertFailure,
      "duplicate attribute",
    )
    i = i + 1
  }
  let forged = [
    waCertRdn(6, asn1PrintableString("AA")),
    waCertRdn(10, asn1Utf8String("Vendor,OU=Authenticator Attestation")),
    waCertRdn(3, asn1Utf8String("Test")),
  ]
  assert(
    waCertCheck(waCertWithName(forged)) == waCertFailure,
    "rendered DN delimiters cannot forge OU",
  )
}

test "packed certificate checks subject encodings and UTF8" {
  for value of [asn1PrintableString("aA"), asn1PrintableString("AAA"), asn1Utf8String("AA")] {
    let name = waCertName()
    name[0] = waCertRdn(6, value)
    assert(waCertCheck(waCertWithName(name)) == waCertFailure, "country encoding and shape")
  }
  let arcs = [10, 11, 3]
  let k = 0
  while (k < 3) {
    let name = waCertName()
    name[k + 1] = waCertRdn(arcs[k], asn1PrintableString("Wrong"))
    assert(waCertCheck(waCertWithName(name)) == waCertFailure, "required UTF8String encoding")
    k = k + 1
  }
  let bad = asn1Utf8String("bad")
  bad.bytes = [byte(255)]
  let name = waCertName()
  name[1] = waCertRdn(10, bad)
  assert(waCertCheck(waCertWithName(name)) == waCertFailure, "invalid UTF8")
  name[1] = waCertRdn(10, asn1Utf8String(""))
  assert(waCertCheck(waCertWithName(name)) == waCertFailure, "empty organization")
  name = waCertName()
  name[2] = waCertRdn(11, asn1Utf8String("Authenticator Attestation CA"))
  assert(waCertCheck(waCertWithName(name)) == waCertFailure, "exact OU")
}

test "packed certificate refuses CA missing constraints and wrong version" {
  let tree = waCertTree()
  tree.children[0].children[0] = asn1ExplicitTag(0, asn1Integer(0))
  assert(waCertCheck(tree) == waCertFailure, "version must be v3")
  let missing = waCertTree()
  missing.children[0].children[7] = asn1ExplicitTag(3, asn1Sequence([]Element(0)))
  assert(waCertCheck(missing) == waCertFailure, "constraints must be present")
  let ca = waCertTree()
  ca.children[0].children[7] = asn1ExplicitTag(
    3,
    asn1Sequence(
      [
        asn1Sequence(
          [oid([2, 5, 29, 19]), asn1OctetString(asn1Encode(asn1Sequence([asn1Boolean(true)])))],
        ),
      ],
    ),
  )
  assert(waCertCheck(ca) == waCertFailure, "CA must be false")
}

test "packed certificate refuses duplicate extensions and extension sections" {
  let ext = waCertExt(asn1OctetString(waCertGuid()), false)
  let tree = waCertWithExt(ext)
  let extensions = tree.children[0].children[7].children[0].children
  tree.children[0].children[7] = asn1ExplicitTag(3, asn1Sequence(append(extensions, ext)))
  assert(waCertCheck(tree) == waCertFailure, "duplicate AAGUID extension")
  let sections = waCertTree()
  sections.children[0].children = append(
    sections.children[0].children,
    sections.children[0].children[7],
  )
  assert(waCertCheck(sections) == waCertFailure, "duplicate extension sections")
}

test "packed certificate bounds framing and redacts parser failures" {
  for der of [[]byte(0), []byte(65537), append(waCertVector(), byte(0)), waHex("3000")] {
    assert(waCertError(der, waCertGuid()) == waCertFailure, "fixed parser failure")
  }
  assert(waCertError(waCertVector(), []byte(15)) == waCertFailure, "AAGUID argument length")
}

test "packed certificate refuses malformed BasicConstraints inner schema" {
  for fields of [
    [asn1Utf8String("junk")],
    [asn1Boolean(false), asn1Boolean(true)],
    [asn1Integer(0)],
    [asn1Boolean(false), asn1Integer(0)],
  ] {
    let tree = waCertTree()
    let ext = asn1Sequence([oid([2, 5, 29, 19]), asn1OctetString(asn1Encode(asn1Sequence(fields)))])
    tree.children[0].children[7] = asn1ExplicitTag(3, asn1Sequence([ext]))
    assert(waCertCheck(tree) == waCertFailure, "malformed BasicConstraints rejected")
  }
}
