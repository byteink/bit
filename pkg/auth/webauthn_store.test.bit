// pkg/auth/webauthn_store.test.bit — #6958: `MemoryCredentialStore` keeps
// credentials in the order they were added, hands out copies, refuses a
// duplicate id and a full store, and fails `update` and `remove` for an id it
// does not hold. `contains` is bound module-wide (SPEC §17.1).

fn addErr(s: MemoryCredentialStore, c: Credential): string {
  s.add(c) catch e {
    return e.message()
  }
  return ""
}

fn removeErr(s: MemoryCredentialStore, id: []byte): string {
  s.remove(id) catch e {
    return e.message()
  }
  return ""
}

fn updateErr(s: MemoryCredentialStore, c: Credential): string {
  s.update(c) catch e {
    return e.message()
  }
  return ""
}

test "MemoryCredentialStore: add, byId, forUser order, update, remove, capacity" {
  let store = MemoryCredentialStore(2)
  let a = Credential{
    id = []byte("a"),
    userId = "u1",
    publicKey = []byte("k"),
    alg = -7,
    signCount = 1,
    aaguid = []byte(0),
    backupEligible = false,
    backupState = false,
    transports = []string(0),
    createdAt = 1,
    name = "",
  }
  store.add(a) catch e {
    panic("add: ${e.message()}")
  }
  let dup = addErr(store, a)
  assert(contains(dup, "already stored"), "duplicate add: ${dup}")
  let b = Credential{
    id = []byte("b"), userId = "u1", publicKey = []byte("k"), alg = -7, signCount = 0, aaguid = []byte(0),
    backupEligible = false, backupState = false, transports = []string(0), createdAt = 2, name = "",
  }
  store.add(b) catch e {
    panic("add b: ${e.message()}")
  }
  let full = addErr(
    store,
    Credential{
      id = []byte("c"), userId = "u2", publicKey = []byte("k"), alg = -7, signCount = 0, aaguid = []byte(0),
      backupEligible = false, backupState = false, transports = []string(0), createdAt = 3, name = "",
    },
  )
  assert(contains(full, "full"), "capacity: ${full}")
  let mine = store.forUser("u1") catch e {
    panic("forUser: ${e.message()}")
  }
  assert(
    len(mine) == 2 && mine[0].id[0] == 0x61 && mine[1].id[0] == 0x62,
    "forUser keeps insertion order",
  )
  mine[0].signCount = 99
  let again = unwrap(
    store.byId([]byte("a")) catch e {
      panic("byId: ${e.message()}")
    },
  )
  assert(again.signCount == 1, "a returned copy does not change the store")
  again.signCount = 7
  again.name = "laptop"
  store.update(again) catch e {
    panic("update: ${e.message()}")
  }
  assert(
    unwrap(
      store.byId([]byte("a")) catch e {
        panic("byId: ${e.message()}")
      },
    ).signCount == 7,
    "update stored",
  )
  store.remove([]byte("a")) catch e {
    panic("remove: ${e.message()}")
  }
  let gone = removeErr(store, []byte("a"))
  assert(contains(gone, "not stored"), "second remove: ${gone}")
  let missing = updateErr(store, a)
  assert(contains(missing, "not stored"), "update of a removed credential: ${missing}")
  assert(
    len(
      store.forUser("u1") catch e {
        panic("forUser: ${e.message()}")
      },
    ) == 1,
    "one left for u1",
  )
}

test "MemoryCredentialStore: handles bind once per user, look up both ways, refuse a bad one" {
  let store = MemoryCredentialStore(2)
  let none = store.handleFor("u1") catch e {
    panic("handleFor: ${e.message()}")
  }
  assert(!isSome(none), "no handle before a bind")
  let h1 = randomBytes(64)
  let got = store.bindHandle("u1", h1) catch e {
    panic("bindHandle: ${e.message()}")
  }
  assert(ctEq(got, h1), "the first bind stores the handle")
  let again = store.bindHandle("u1", randomBytes(64)) catch e {
    panic("bindHandle again: ${e.message()}")
  }
  assert(ctEq(again, h1), "a second bind answers the handle the user already has")
  let back = store.userForHandle(h1) catch e {
    panic("userForHandle: ${e.message()}")
  }
  assert(isSome(back) && unwrap(back) == "u1", "userForHandle finds the user")
  let miss = store.userForHandle(randomBytes(64)) catch e {
    panic("userForHandle: ${e.message()}")
  }
  assert(!isSome(miss), "an unknown handle finds nobody")
  let shared = bindErr(store, "u2", h1)
  assert(contains(shared, "already bound"), "same handle for another user: ${shared}")
  assert(contains(bindErr(store, "u2", []byte(0)), "1 to 64 bytes"), "empty handle")
  assert(contains(bindErr(store, "u2", randomBytes(65)), "1 to 64 bytes"), "65-byte handle")
  let h2 = randomBytes(64)
  let _ = store.bindHandle("u2", h2) catch e {
    panic("bindHandle u2: ${e.message()}")
  }
  let full = bindErr(store, "u3", randomBytes(64))
  assert(contains(full, "full"), "capacity: ${full}")
}

fn bindErr(s: MemoryCredentialStore, userId: string, h: []byte): string {
  s.bindHandle(userId, h) catch e {
    return e.message()
  }
  return ""
}
