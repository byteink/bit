// pkg/auth/webauthn_handle.test.bit — #7375: the WebAuthn user handle is 64
// random bytes the store keeps per user (W3C Web Authentication Level 3 section
// 14.6.1), not the app's user id: sent as `user.id`, stable across a user's
// registrations, distinct between users, and mapped back to the app user id by
// the store. Helpers (`regWa`, `regUser`, `regOk`, `regRun`, `regFinish`,
// `inCtx`) come from webauthn.test.bit (one module).

fn begun(wa: WebAuthn, c: Ctx, user: UserEntity): Json {
  return wa.beginRegistration(c, user) catch e {
    panic("begin: ${e.message()}")
  }
}

// The `user.id` of the options `beginRegistration` returns for `user`.
fn optionsHandle(wa: WebAuthn, c: Ctx, user: UserEntity): []byte {
  return handleOf(begun(wa, c, user))
}

fn handleOf(o: Json): []byte {
  let u = unwrap(jsonGet(o, "user"))
  return decodeBase64Url(unwrap(jsonAsString(unwrap(jsonGet(u, "id"))))) catch e {
    panic("user.id: ${e.message()}")
  }
}

test "user handle: 64 random bytes, not the app id, stable per user, distinct between users" {
  let store = MemoryCredentialStore()
  let wa = regWa(store)
  let out = inCtx((c) => {
    let ada = regUser()
    let bob = UserEntity{ id = "user-2", name = "bob", displayName = "Bob" }
    let h1 = optionsHandle(wa, c, ada)
    if (len(h1) != 64) {
      return "handle is ${len(h1)} bytes"
    }
    if (ctEq(h1, []byte(ada.id))) {
      return "handle is the app user id"
    }
    // Nothing is stored until a registration succeeds: this one binds the
    // handle it sent, and a second registration of the same user reuses it.
    let o1 = begun(wa, c, ada)
    let sent = handleOf(o1)
    let reg = regFinish(wa, c, o1, regOk())
    if (reg != "") {
      return reg
    }
    let second = regOk()
    second.credId = []byte("credential-id-02")
    let reg2 = regRun(wa, c, second)
    if (reg2 != "") {
      return reg2
    }
    let kept = unwrap(
      store.handleFor("user-1") catch e {
        return e.message()
      },
    )
    if (len(kept) != 64 || !ctEq(kept, sent)) {
      return "stored handle is not the 64 bytes sent"
    }
    if (!ctEq(optionsHandle(wa, c, ada), kept)) {
      return "a registered user's handle changed"
    }
    if (ctEq(optionsHandle(wa, c, bob), kept)) {
      return "two users share a handle"
    }
    return ""
  })
  assert(out == "", out)
}

test "a registration stores the handle and the credential maps back to the app user id" {
  let store = MemoryCredentialStore()
  let wa = regWa(store)
  let out = inCtx((c) => {
    let o = begun(wa, c, regUser())
    let sent = handleOf(o)
    let reg = regFinish(wa, c, o, regOk())
    if (reg != "") {
      return reg
    }
    let id = unwrap(
      store.userForHandle(sent) catch e {
        return e.message()
      },
    )
    if (id != "user-1") {
      return "userForHandle gave ${id}"
    }
    let cred = unwrap(
      store.byId([]byte("credential-id-01")) catch e {
        return e.message()
      },
    )
    if (cred.userId != "user-1") {
      return "credential maps to ${cred.userId}"
    }
    return ""
  })
  assert(out == "", out)
}
