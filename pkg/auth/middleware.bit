// pkg/auth/middleware.bit — requireAuth and currentIdentity (#5770): the
// `pkg/web` middleware that runs a request through this package's
// strategies, and the accessor a downstream handler reads the result with.

import { Middleware, Res, unauthorized } from "web"

// Runs each of `strategies` in order until one authenticates the request,
// stores the resulting Identity on the session under `identitySessionKey`
// (strategy.bit), then calls `next(c)`. When every strategy fails it raises
// `unauthorized()` (pkg/web/errors.bit:160) WITHOUT calling `next` — the
// onion short-circuit `pkg/web/middleware.bit`'s own doc comment describes.
//
// Session fixation (#5795) is closed by the STRATEGY, not here:
// `Strategy.authenticate(c)` regenerates the session id (`docs/security.md`,
// `Session.regenerate()` — pkg/web/session.bit) the moment it has a
// verified identity, before returning it — `password.bit`'s
// `PasswordStrategy.authenticate` and `oidc_callback.bit`'s
// `handleCallback` both do this. `requireAuth` calling `regenerate()` a
// second time here would rotate the session id AFTER the strategy already
// wrote to it, discarding what `authenticate` just stored (#6093) — every
// `Strategy` this package ships regenerates exactly once per successful
// login, so this middleware must not regenerate at all.
//
// `session.set()` here needs no paired `save()` call (#6093 originally
// added one): pkg/web ^0.7.0 autosaves a dirty session at the end of every
// request (#6110, pkg/web/session.bit), so the adapter itself calls
// `save()` once the handler returns, success or failure. Before #6110,
// `Session.set()` only updated the in-memory object ("takes effect in the
// store at save(), not here", pkg/web/session.bit) and neither
// `Ctx.finish` nor the adapter's `sealSession` ever called it, so the
// Identity `.set()` just wrote lived only for the rest of THIS request —
// that gap is now closed by the framework, not by this function.
export fn requireAuth(strategies: []Strategy): Middleware {
  let mw: Middleware = (c, next) => {
    let identity = authenticate(strategies, c) catch e {
      return refusal(c, e)?
    }
    let session = c.session()?
    session.set(identitySessionKey, encodeIdentity(identity))
    return next(c)?
  }
  return mw
}

// The first strategy in `strategies` whose `authenticate(c)` succeeds, or
// `unauthorized()` when every one of them failed. A strategy's own error (bad
// password, expired token) is not this function's concern — it is not
// `requireAuth`'s job to say WHY every strategy declined, only whether one
// of them accepted. The one exception is a `Throttled` (throttle.bit): the
// client was told to wait, so no later strategy is tried and `requireAuth`
// answers 429 (#6927).
fn authenticate(strategies: []Strategy, c: Ctx): Identity! {
  for s of strategies {
    let id = s.authenticate(c) catch e {
      let (_, throttled) = e.(Throttled)
      if (throttled) {
        fail e
      }
      continue
    }
    return id
  }
  fail unauthorized()
}

// What `requireAuth` answers when `authenticate` failed: the 429 with
// `Retry-After` for a `Throttled`, an empty body like the throttle's own docs
// show, and every other failure as it came (the 401).
fn refusal(c: Ctx, e: error): Res! {
  let (t, throttled) = e.(Throttled)
  if (!throttled) {
    fail e
  }
  return c.status(429).header("Retry-After", "${t.retryAfter}")
}

// Reads the Identity `requireAuth` stored on this request's session, or
// fails when none is set — the check a downstream handler makes to learn
// who is calling. Reads through the same session (`c.session()?`) rather
// than a bespoke lookup, so an app with no session store configured gets
// that failure's message, not a silent "not authenticated".
export fn currentIdentity(c: Ctx): Identity! {
  let raw = c.session()?.get(identitySessionKey)
  if (raw == "") {
    fail newError("auth: currentIdentity(): no identity stored on this session")
  }
  return decodeIdentity(raw)?
}
