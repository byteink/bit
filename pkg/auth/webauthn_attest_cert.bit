// W3C Web Authentication Level 3 section 8.2.1. This checks the leaf
// profile only; signature, validity, chain and trust remain the caller's job.
import {
  Certificate, x509Parse, asn1ReadSet, asn1ReadString, asn1ReadExplicit,
  asn1ReadBoolean, classUniversal, classContext, tagUtf8String, tagPrintableString,
} from "std/crypto"

const waCertFailure = "auth: webauthn: invalid packed attestation certificate"
const waCertAaguidOid = "1.3.6.1.4.1.45724.1.1.4"

fn waCertAttrIndex(name: string): int {
  let names = ["2.5.4.6", "2.5.4.10", "2.5.4.11", "2.5.4.3"]
  let i = 0
  while (i < len(names)) {
    if (name == names[i]) {
      return i
    }
    i = i + 1
  }
  return -1
}

fn waCertCountry(value: string): bool {
  if (len(value) != 2) {
    return false
  }
  let bytes = []byte(value)
  return bytes[0] >= 65 && bytes[0] <= 90 && bytes[1] >= 65 && bytes[1] <= 90
}

fn waCertAttr(value: Element, index: int): ()! {
  if (value.cls != classUniversal || value.constructed) {
    fail newError(waCertFailure)
  }
  let text = asn1ReadString(value)?
  if (index == 0) {
    if (value.tag != tagPrintableString || !waCertCountry(text)) {
      fail newError(waCertFailure)
    }
    return
  }
  waCertText(value, text, index)?
}

fn waCertText(value: Element, text: string, index: int): ()! {
  if (value.tag != tagUtf8String || len(text) == 0 || !isValidUtf8(text)) {
    fail newError(waCertFailure)
  }
  if (index == 2 && text != "Authenticator Attestation") {
    fail newError(waCertFailure)
  }
}

fn waCertSubject(subject: Element): ()! {
  let seen = []bool(4)
  for rdn of asn1ReadSequence(subject)? {
    for item of asn1ReadSet(rdn)? {
      let attr = asn1ReadSequence(item)?
      if (len(attr) != 2) {
        fail newError(waCertFailure)
      }
      let index = waCertAttrIndex(asn1OidString(asn1ReadOid(attr[0])?))
      if (index < 0) {
        continue
      }
      if (seen[index]) {
        fail newError(waCertFailure)
      }
      waCertAttr(attr[1], index)?
      seen[index] = true
    }
  }
  for present of seen {
    if (!present) {
      fail newError(waCertFailure)
    }
  }
}

fn waCertAaguid(ext: []Element, aaguid: []byte): ()! {
  let index = 1
  if (len(ext) == 3) {
    if (asn1ReadBoolean(ext[1])?) {
      fail newError(waCertFailure)
    }
    index = 2
  }
  let inner = asn1ReadOctetString(ext[index])?
  let value = asn1ReadOctetString(asn1Parse(inner)?)?
  if (len(value) != 16) {
    fail newError(waCertFailure)
  }
  let i = 0
  while (i < 16) {
    if (value[i] != aaguid[i]) {
      fail newError(waCertFailure)
    }
    i = i + 1
  }
}

fn waCertBasicConstraints(ext: []Element): ()! {
  let inner = asn1ReadOctetString(ext[len(ext) - 1])?
  let fields = asn1ReadSequence(asn1Parse(inner)?)?
  // With CA=false, pathLenConstraint is forbidden by RFC 5280 section 4.2.1.9.
  if (len(fields) > 1) {
    fail newError(waCertFailure)
  }
  if (len(fields) == 1 && asn1ReadBoolean(fields[0])?) {
    fail newError(waCertFailure)
  }
}

fn waCertExtensionList(extensions: []Element, aaguid: []byte): ()! {
  let seen = map<string, bool>()
  for item of extensions {
    let ext = asn1ReadSequence(item)?
    if (len(ext) < 2 || len(ext) > 3) {
      fail newError(waCertFailure)
    }
    let name = asn1OidString(asn1ReadOid(ext[0])?)
    let (_, duplicate) = seen[name]
    if (duplicate) {
      fail newError(waCertFailure)
    }
    seen[name] = true
    if (name == "2.5.29.19") {
      waCertBasicConstraints(ext)?
    }
    if (name == waCertAaguidOid) {
      waCertAaguid(ext, aaguid)?
    }
  }
}

fn waCertExtensions(tbs: []Element, aaguid: []byte): ()! {
  let found = false
  let i = 7
  while (i < len(tbs)) {
    let tail = tbs[i]
    i = i + 1
    if (tail.cls != classContext || tail.tag != 3) {
      continue
    }
    if (found) {
      fail newError(waCertFailure)
    }
    found = true
    waCertExtensionList(asn1ReadSequence(asn1ReadExplicit(tail, 3)?)?, aaguid)?
  }
}

fn waCertProfile(der: []byte, aaguid: []byte): Certificate! {
  // Local allocation bound, separate from the W3C certificate requirements.
  if (len(der) > 65536 || len(aaguid) != 16) {
    fail newError(waCertFailure)
  }
  let cert = x509Parse(der)?
  if (cert.version != 2 || !cert.hasBasicConstraints || cert.isCa) {
    fail newError(waCertFailure)
  }
  let tbs = asn1ReadSequence(asn1Parse(cert.tbs)?)?
  waCertSubject(tbs[5])?
  waCertExtensions(tbs, aaguid)?
  return cert
}

fn waCheckPackedCertificate(der: []byte, aaguid: []byte): Certificate! {
  return waCertProfile(der, aaguid) catch _ {
    fail newError(waCertFailure)
  }
}
