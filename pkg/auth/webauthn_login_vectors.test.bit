  }
}

fn lgVecPackedEdDSA(): LgVector {
  return LgVector{
    name = "PackedEdDSA",
    authData = "bfabc37432958b063360d3ad6461c9c4735ae7f8edd46592a5e0f01452b2e4b50100000000",
    clientData = "7b2274797065223a22776562617574686e2e676574222c226368616c6c656e6765223a2269566c583442786a4f6d6d44534b4c596f7870557439736e364d48454f7943413135726947514a6e763949222c226f726967696e223a2268747470733a2f2f6578616d706c652e6f7267222c2263726f73734f726967696e223a66616c73657d",
    signature = "f5c59c7e46c34f6f8cc197101ddf9934fa2595f68eb1913a637e8419eb9ba4cfdfc48f85393bc0d40b011f0d6fecb097d6607525713223a0dc0d453993dae00b",
    credId = "ce9f840ed96599580cd140fbc7bb3230633f50f61041aff73308ae71caa8a2bd",
    challenge = "895957e01c633a698348a2d8a31a54b7db27e8c1c43b2080d79ae2190267bfd2",
    publicKey = "a401010327200621582044e06ddd331c36a8dc667bab52bcae63486c916aa5e339e6acebaa84934bf832",
  }
}

fn lgAllVectors(): []LgVector {
  return [lgVecNoneES256(), lgVecPackedSelfES256(), lgVecPackedRS256(), lgVecPackedEdDSA()]
}

test "login vectors: 4 of 4 are well-formed hex, each authenticatorData for rpId example.org" {
  let want = digest(Sha256(), []byte("example.org"))
  for v of lgAllVectors() {
    let ad = decodeHex(v.authData) catch e {
      panic("${v.name}: authData: ${e.message()}")
    }
    assert(
      len(ad) == 37,
      "${v.name}: authenticatorData is ${len(ad)} bytes, want 37 (no AT, no ED)",
    )
    assert(ctEq(ad[0:32], want), "${v.name}: rpIdHash is not SHA-256('example.org')")
    for hex of [v.clientData, v.signature, v.credId, v.challenge, v.publicKey] {
      decodeHex(hex) catch e {
        panic("${v.name}: ${e.message()}")
      }
    }
  }
}
