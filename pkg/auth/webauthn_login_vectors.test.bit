// pkg/auth/webauthn_login_vectors.test.bit — the W3C Web Authentication Level 3
// section 16 test vectors for the authentication ceremony (#6959), as hex, taken
// from go-webauthn/webauthn protocol/specification_vectors_e2e_test.go
// (BSD-3-Clause), which carries them verbatim from the specification. Relying
// party id `example.org`, origin `https://example.org`; each is one assertion a
// real authenticator signed: authenticatorData, clientDataJSON, the signature,
// the credential id, the challenge and the credential's COSE public key.

// One vector: every value is lower-case hex.
class LgVector {
  name: string,
  authData: string,
  clientData: string,
  signature: string,
  credId: string,
  challenge: string,
  publicKey: string,
}

fn lgVecNoneES256(): LgVector {
  return LgVector{
    name = "NoneES256",
    authData = "bfabc37432958b063360d3ad6461c9c4735ae7f8edd46592a5e0f01452b2e4b51900000000",
    clientData = "7b2274797065223a22776562617574686e2e676574222c226368616c6c656e6765223a224f63446e55685158756c5455506f334a5558543049393770767a7a59425039745a63685879617630314167222c226f726967696e223a2268747470733a2f2f6578616d706c652e6f7267222c2263726f73734f726967696e223a66616c73657d",
    signature = "3046022100f50a4e2e4409249c4a853ba361282f09841df4dd4547a13a87780218deffcd380221008480ac0f0b93538174f575bf11a1dd5d78c6e486013f937295ea13653e331e87",
    credId = "f91f391db4c9b2fde0ea70189cba3fb63f579ba6122b33ad94ff3ec330084be4",
    challenge = "39c0e7521417ba54d43e8dc95174f423dee9bf3cd804ff6d65c857c9abf4d408",
    publicKey = "a5010203262001215820afefa16f97ca9b2d23eb86ccb64098d20db90856062eb249c33a9b672f26df61225820930a56b87a2fca66334b03458abf879717c12cc68ed73290af2e2664796b9220",
  }
}

