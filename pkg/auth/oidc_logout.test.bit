// pkg/auth/oidc_logout.test.bit — #6951's acceptance: RP-Initiated Logout 1.0.
// The redirect carries id_token_hint, post_logout_redirect_uri, client_id and
// state; a post_logout_redirect_uri the app did not register is refused (other
// host, scheme downgrade, userinfo trick) before anything is destroyed; the
// local session is gone when the redirect is returned; a provider without an
// end_session_endpoint logs out locally; `handleLogoutCallback` accepts only
// the `state` it issued, once; and a registration that is not https (outside
// localhost), or has userinfo or a fragment, fails at construction.
//
// Every test goes through `app.handle(req)` against in-test fakes, no network.
// `callbackStrategy`, `callbackReq`, `newBox`, `tokenFetchFor`, `TokenCallBox`
// (oidc_callback.test.bit), `authReq`, `queryFrom`, `paramOrPanic`
// (oidc_authorize.test.bit), `testIssuer`, `clientId`, `testKid`,
// `signIdToken`, `split`, `contains`, `now`, `Second` are already bound.

const appHome = "https://app.example.com/signed-out"
const opEndSession = "https://idp.example.com/logout"
const loggedInSub = "user-42"

fn logoutStrategy(endpoint: Option<string>): OidcStrategy {
  let config = callbackConfig()
  config.endSessionEndpoint = endpoint
  return callbackStrategyWith(config, [appHome])
}

// An ID token for `loggedInSub` naming `nonce` and carrying `sid`.
fn tokenWithSid(nonce: string): string {
  let t = now().ns / Second
  let payload = Json.JsonObject(
    [
      JsonEntry{ key = "iss", value = Json.JsonString(testIssuer) },
      JsonEntry{ key = "aud", value = Json.JsonString(clientId) },
      JsonEntry{ key = "sub", value = Json.JsonString(loggedInSub) },
      JsonEntry{ key = "sid", value = Json.JsonString("op-session-7") },
      JsonEntry{ key = "exp", value = Json.JsonInt(i64(t + 3600)) },
      JsonEntry{ key = "iat", value = Json.JsonInt(i64(t - 10)) },
      JsonEntry{ key = "nonce", value = Json.JsonString(nonce) },
    ],
  )
  return signIdToken(testKid, payload)
}

fn logoutApp(s: OidcStrategy, box: TokenCallBox): App {
  let app = App(Config{ secret = "test-secret", sessions = MemoryStore(1000) })
  app.get("/begin", (c) => beginAuthorization(s, c))
  app.get("/peek", (c) => {
    let session = c.session() catch e {
      panic("session: ${e.message()}")
    }
    return c.text(
        session.get(stateSessionKey) +
        "|" +
        session.get(nonceSessionKey) +
        "|" +
        session.get(idTokenSessionKey) +
        "|" +
        session.get(sidSessionKey),
    )
  })
  app.get("/callback", (c) => {
    let identity = handleCallbackFetch(s, c, tokenFetchFor(box))?
    return c.text(identity.id)
  })
  app.get("/whoami", (c) => {
    let identity = currentIdentity(c)?
    return c.text(identity.id)
  })
  app.get("/logout", (c) => {
    let o = LogoutOptions{
      postLogoutRedirectUri = c.query("to"),
      logoutHint = c.query("hint"),
      uiLocales = c.query("loc"),
    }
    return endSession(s, c, o)?
  })
  app.get("/signed-out", (c) => handleLogoutCallback(c, c.text("bye"))?)
  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  return app
}

// Runs begin + callback and returns the logged-in session cookie.
fn loginCookie(app: App, box: TokenCallBox): string {
  let begin = app.handle(authReq("/begin", "")).getHeader("Set-Cookie")
  let stored = split(app.handle(authReq("/peek", begin)).body, "|")
  box.token = tokenWithSid(stored[1])
  let res = app.handle(callbackReq(begin, "code", stored[0]))
  assert(res.status == 200, "login failed: ${res.status} ${res.body}")
  return res.getHeader("Set-Cookie")
}

// `/whoami` fails (no identity on the session the old cookie now maps to) once
// the session is destroyed: anything but a 200 carrying the subject.
fn assertLoggedOut(app: App, cookie: string) {
  let res = app.handle(authReq("/whoami", cookie))
  assert(res.status != 200 && res.body != loggedInSub, "old cookie still logged in: ${res.status}")
}

fn pairOf(setCookie: string): string {
  return split(setCookie, ";")[0]
}

fn logoutReq(cookie: string, query: string): Request {
  return authReq("/logout?" + query, cookie)
}

fn newApp(endpoint: Option<string>): (App, TokenCallBox) {
  let box = newBox()
  return (logoutApp(logoutStrategy(endpoint), box), box)
}

test "handleCallback keeps the raw id_token and the sid claim for logout" {
  let (app, box) = newApp(Option.Some(opEndSession))
  let cookie = loginCookie(app, box)
  let stored = split(app.handle(authReq("/peek", cookie)).body, "|")
  assert(stored[2] == box.token, "id_token not stored: '${stored[2]}'")
  assert(stored[3] == "op-session-7", "sid not stored: '${stored[3]}'")
}

test "endSession redirects with 4 of 4 parameters: id_token_hint, post_logout_redirect_uri, client_id, state" {
  let (app, box) = newApp(Option.Some(opEndSession))
  let cookie = loginCookie(app, box)
  let res = app.handle(logoutReq(cookie, "to=" + percentEncode(appHome)))
  assert(res.status == 302, "want 302, got ${res.status}: ${res.body}")
  let loc = res.getHeader("Location")
  assert(hasPrefix(loc, opEndSession + "?"), "wrong target: '${loc}'")
  let q = queryFrom(loc)
  assert(paramOrPanic(q, "id_token_hint") == box.token, "wrong id_token_hint")
  assert(paramOrPanic(q, "post_logout_redirect_uri") == appHome, "wrong post_logout_redirect_uri")
  assert(paramOrPanic(q, "client_id") == clientId, "wrong client_id")
  let state = paramOrPanic(q, "state")
  assert(len(state) == 32, "want a 128-bit hex state, got '${state}'")
  let sc = res.getHeader("Set-Cookie")
  assert(
    hasPrefix(sc, "bit_oidc_logout_state=" + state + ";"),
    "state must ride in the logout cookie: '${sc}'",
  )
  assert(contains(sc, "HttpOnly") && contains(sc, "Secure") && contains(sc, "SameSite=Lax"), sc)
}

test "endSession without a post-logout URI sends no post_logout_redirect_uri, no state, no cookie" {
  let (app, box) = newApp(Option.Some(opEndSession))
  let cookie = loginCookie(app, box)
  let res = app.handle(logoutReq(cookie, ""))
  assert(res.status == 302, "want 302, got ${res.status}")
  let q = queryFrom(res.getHeader("Location"))
  assert(paramOrPanic(q, "client_id") == clientId, "client_id missing")
  assert(paramOrPanic(q, "id_token_hint") == box.token, "id_token_hint missing")
  assert(!contains(res.getHeader("Location"), "post_logout_redirect_uri"), "uri leaked")
  assert(!contains(res.getHeader("Location"), "state="), "state without a return URI")
  assert(res.getHeader("Set-Cookie") == "", "no state cookie without a return URI")
}

test "endSession forwards logout_hint and ui_locales, and extends an existing query" {
  let box = newBox()
  let s = logoutStrategy(Option.Some(opEndSession + "?tenant=a"))
  let app = logoutApp(s, box)
  let cookie = loginCookie(app, box)
  let res = app.handle(logoutReq(cookie, "hint=ada%40example.com&loc=de"))
  let loc = res.getHeader("Location")
  assert(hasPrefix(loc, opEndSession + "?tenant=a&"), "query not extended with &: '${loc}'")
  let q = queryFrom(loc)
  assert(paramOrPanic(q, "logout_hint") == "ada@example.com", "logout_hint missing")
  assert(paramOrPanic(q, "ui_locales") == "de", "ui_locales missing")
}

fn refusedUnregistered(to: string) {
  let (app, box) = newApp(Option.Some(opEndSession))
  let cookie = loginCookie(app, box)
  let res = app.handle(logoutReq(cookie, "to=" + percentEncode(to)))
  assert(res.status == 500, "'${to}' must be refused, got ${res.status}")
  assert(res.getHeader("Location") == "", "'${to}' must not redirect")
  let still = app.handle(authReq("/whoami", cookie))
  assert(still.body == loggedInSub, "a refused logout must not destroy the session")
}

test "endSession refuses an unregistered post_logout_redirect_uri: other host" {
  refusedUnregistered("https://evil.example/signed-out")
}

test "endSession refuses an unregistered post_logout_redirect_uri: scheme downgrade" {
  refusedUnregistered("http://app.example.com/signed-out")
}

test "endSession refuses an unregistered post_logout_redirect_uri: userinfo trick" {
  refusedUnregistered("https://app.example.com@evil.example/signed-out")
}

test "the local session is destroyed by the time the redirect is returned" {
  let (app, box) = newApp(Option.Some(opEndSession))
  let cookie = loginCookie(app, box)
  assert(app.handle(authReq("/whoami", cookie)).body == loggedInSub, "not logged in")
  let res = app.handle(logoutReq(cookie, "to=" + percentEncode(appHome)))
  assert(res.status == 302, "want 302, got ${res.status}")
  assertLoggedOut(app, cookie)
}

test "a provider without end_session_endpoint logs out locally and returns to the post-logout URI" {
  let (app, box) = newApp(Option.None)
  let cookie = loginCookie(app, box)
  let res = app.handle(logoutReq(cookie, "to=" + percentEncode(appHome)))
  assert(res.status == 302, "want 302, got ${res.status}")
  let loc = res.getHeader("Location")
  assert(hasPrefix(loc, appHome + "?state="), "must go straight to the post-logout URI: '${loc}'")
  assert(!contains(loc, "id_token_hint"), "no provider call without an endpoint: '${loc}'")
  assertLoggedOut(app, cookie)
}

test "no end_session_endpoint and no post-logout URI: local logout, back to /" {
  let (app, box) = newApp(Option.None)
  let cookie = loginCookie(app, box)
  let res = app.handle(logoutReq(cookie, ""))
  assert(res.getHeader("Location") == "/", "want /, got '${res.getHeader("Location")}'")
  assertLoggedOut(app, cookie)
}

test "handleLogoutCallback accepts the issued state once and clears the cookie" {
  let (app, box) = newApp(Option.Some(opEndSession))
  let cookie = loginCookie(app, box)
  let out = app.handle(logoutReq(cookie, "to=" + percentEncode(appHome)))
  let state = paramOrPanic(queryFrom(out.getHeader("Location")), "state")
  let back = app.handle(authReq("/signed-out?state=" + state, pairOf(out.getHeader("Set-Cookie"))))
  assert(back.status == 200 && back.body == "bye", "want the done response, got ${back.status}")
  assert(contains(back.getHeader("Set-Cookie"), "Max-Age=0"), "cookie must be cleared")
}

test "handleLogoutCallback refuses a wrong, missing or cookie-less state" {
  let (app, box) = newApp(Option.Some(opEndSession))
  let cookie = loginCookie(app, box)
  let out = app.handle(logoutReq(cookie, "to=" + percentEncode(appHome)))
  let pair = pairOf(out.getHeader("Set-Cookie"))
  assert(app.handle(authReq("/signed-out?state=forged", pair)).status == 401, "wrong state")
  assert(app.handle(authReq("/signed-out", pair)).status == 401, "missing state")
  let state = paramOrPanic(queryFrom(out.getHeader("Location")), "state")
  assert(app.handle(authReq("/signed-out?state=" + state, "")).status == 401, "no cookie")
  assert(app.handle(authReq("/signed-out", "bit_oidc_logout_state=")).status == 401, "empty both")
}

fn registrationError(uris: []string): string {
  OidcStrategy(
    Provider.Endpoints(callbackConfig(), callbackJwks()),
    clientId,
    "secret",
    "https://app.example.com/callback",
    OidcOptions{ postLogoutRedirectUris = uris },
  ) catch e {
    return e.message()
  }
  return ""
}

test "OidcStrategy refuses a post-logout registration that is http outside localhost, has userinfo, a fragment, or no scheme" {
  for bad of []string{
    "http://app.example.com/bye",
    "https://app.example.com@evil.example/bye",
    "https://app.example.com/bye#frag",
    "app.example.com/bye",
    "https:///bye",
  } {
    assert(contains(registrationError([bad]), "postLogoutRedirectUris"), "must refuse '${bad}'")
  }
}

test "OidcStrategy accepts https and loopback http post-logout registrations" {
  let ok = []string{
    "https://app.example.com/bye",
    "http://localhost:3000/bye",
    "http://127.0.0.1/bye",
    "http://[::1]:8080/bye",
  }
  assert(registrationError(ok) == "", "valid registrations refused: ${registrationError(ok)}")
}
