// pkg/auth/github.test.bit — #6944's acceptance for `github(...)`
// (github.bit): the `Identity` id is the numeric GitHub id, never the login;
// the email is the one entry with `primary` AND `verified` and nothing
// else, chosen out of a fixture holding verified non-primary and unverified
// primary decoys; a missing verified primary fails when required and yields
// `email` "" with `email_verified` false when not; `enterpriseHost` moves all
// three URLs; a bad host or a missing `tls` is an `Error` at startup; the
// requests carry GitHub's headers; /user/emails is paged; and a full
// begin -> callback round trip through `OAuth2Strategy` runs on the fakes. No
// test touches the network: `GithubOptions.apiFetch` and
// `OAuth2Options.tokenFetch` stand in for GitHub. `O2Box`, `o2Box`,
// `o2TokenFetch`, `o2App`, `o2Begin`, `o2CallbackReq`, `o2Ok`
// (oauth2.test.bit), `authReq` (oidc_authorize.test.bit) are already bound
// module-wide (an import binds per MODULE, SPEC §17.1).

const ghUser = "{\"id\":583231,\"login\":\"octocat\",\"name\":\"The Octocat\",\"avatar_url\":\"https://avatars.githubusercontent.com/u/583231\",\"email\":\"public@example.com\"}"

// Two verified non-primary addresses, a primary that is NOT verified, and the
// one primary verified address last.
const ghEmails = "[{\"email\":\"alt1@example.com\",\"primary\":false,\"verified\":true},{\"email\":\"unproven@example.com\",\"primary\":true,\"verified\":false},{\"email\":\"alt2@example.com\",\"primary\":false,\"verified\":true},{\"email\":\"octocat@example.com\",\"primary\":true,\"verified\":true}]"

// The same account with no verified primary: the primary is unverified.
const ghEmailsUnverified = "[{\"email\":\"alt1@example.com\",\"primary\":false,\"verified\":true},{\"email\":\"unproven@example.com\",\"primary\":true,\"verified\":false},{\"email\":\"alt2@example.com\",\"primary\":false,\"verified\":true}]"

// No primary entry at all.
const ghEmailsNoPrimary = "[{\"email\":\"alt1@example.com\",\"primary\":false,\"verified\":true}]"

// What the fake GitHub saw and answers.
class GhBox {
  urls: []string,
  headers: []Header,
  user: string,
  emails: string,
  page2: string,
  failUrl: string,
}

fn ghBox(emails: string): GhBox {
  return GhBox{
    urls = []string{},
    headers = []Header(0),
    user = ghUser,
    emails = emails,
    page2 = "[]",
    failUrl = "",
  }
}

fn ghFetch(box: GhBox): GithubFetch {
  let f: GithubFetch = (url, headers) => {
    box.urls = append(box.urls, url)
    box.headers = headers
    if (box.failUrl != "" && contains(url, box.failUrl)) {
      fail newError("GET ${url}: HTTP 403")
    }
    if (contains(url, "/user/emails")) {
      if (contains(url, "page=2")) {
        return box.page2
      }
      return box.emails
    }
    return box.user
  }
  return f
}

fn ghEndpoints(box: GhBox, require: bool, host: string): OAuth2Endpoints {
  let opts = GithubOptions{
    enterpriseHost = host,
    requireVerifiedEmail = require,
    apiFetch = ghFetch(box),
  }
  return github(opts) catch e {
    panic("github(): ${e.message()}")
  }
}

fn ghProfile(box: GhBox, require: bool): Identity! {
  let profile = ghEndpoints(box, require, "").profile
  return profile("gho_token")?
}

fn ghStr(id: Identity, key: string): string {
  return oauth2Field(id.claims, key)
}

fn ghVerified(id: Identity): bool {
  let v = jsonAsBool(unwrap(jsonGet(id.claims, "email_verified")))
  return unwrap(v)
}

fn ghProfileErr(box: GhBox, require: bool): string {
  ghProfile(box, require) catch e {
    return e.message()
  }
  return ""
}

fn ghStartupErr(opts: GithubOptions): string {
  github(opts) catch e {
    return e.message()
  }
  return ""
}

test "Identity id is the numeric GitHub id, not the login; claims carry login, name, avatar_url" {
  let box = ghBox(ghEmails)
  let id = ghProfile(box, true) catch e {
    panic(e.message())
  }
  assert(id.id == "583231", "want the numeric id, got '${id.id}'")
  assert(ghStr(id, "login") == "octocat", "login claim: '${ghStr(id, "login")}'")
  assert(ghStr(id, "name") == "The Octocat", "name claim: '${ghStr(id, "name")}'")
  assert(
    ghStr(id, "avatar_url") == "https://avatars.githubusercontent.com/u/583231",
    "avatar_url claim: '${ghStr(id, "avatar_url")}'",
  )
}

test "a renamed login keeps the same Identity id" {
  let box = ghBox(ghEmails)
  box.user = "{\"id\":583231,\"login\":\"octocat-renamed\",\"name\":null,\"avatar_url\":\"\"}"
  let id = ghProfile(box, true) catch e {
    panic(e.message())
  }
  assert(id.id == "583231", "the id moved with the login: '${id.id}'")
  assert(ghStr(id, "name") == "", "a null name must be \"\", got '${ghStr(id, "name")}'")
}

test "the primary verified email is chosen over two verified non-primary and one unverified primary" {
  let box = ghBox(ghEmails)
  let id = ghProfile(box, true) catch e {
    panic(e.message())
  }
  assert(ghStr(id, "email") == "octocat@example.com", "email claim: '${ghStr(id, "email")}'")
  assert(ghVerified(id), "email_verified must be true for a verified primary")
}

test "the public email of /user is never used" {
  let box = ghBox(ghEmailsUnverified)
  let id = ghProfile(box, false) catch e {
    panic(e.message())
  }
  assert(ghStr(id, "email") == "", "an email came from somewhere but a verified primary")
}

test "an unverified primary fails when a verified email is required" {
  let msg = ghProfileErr(ghBox(ghEmailsUnverified), true)
  assert(
    contains(msg, "no verified primary email"),
    "want the verified-email failure, got '${msg}'",
  )
}

test "no primary entry at all fails when a verified email is required" {
  let msg = ghProfileErr(ghBox(ghEmailsNoPrimary), true)
  assert(
    contains(msg, "no verified primary email"),
    "want the verified-email failure, got '${msg}'",
  )
}

test "requireVerifiedEmail = false: unverified primary and no primary both give email \"\" and email_verified false" {
  for body of [ghEmailsUnverified, ghEmailsNoPrimary] {
    let id = ghProfile(ghBox(body), false) catch e {
      panic(e.message())
    }
    assert(id.id == "583231", "the id is still the numeric one: '${id.id}'")
    assert(ghStr(id, "email") == "", "an unverified email leaked: '${ghStr(id, "email")}'")
    assert(!ghVerified(id), "email_verified must be false")
  }
}

test "github.com URLs: authorize, token, /user and /user/emails" {
  let box = ghBox(ghEmails)
  let ep = ghEndpoints(box, true, "")
  assert(ep.authorize == "https://github.com/login/oauth/authorize", "authorize '${ep.authorize}'")
  assert(ep.token == "https://github.com/login/oauth/access_token", "token '${ep.token}'")
  let profile = ep.profile
  profile("t") catch e {
    panic(e.message())
  }
  assert(box.urls[0] == "https://api.github.com/user", "first GET '${box.urls[0]}'")
  assert(
    hasPrefix(box.urls[1], "https://api.github.com/user/emails?"),
    "second GET '${box.urls[1]}'",
  )
}

test "enterpriseHost rewrites the authorize URL, the token URL and the API URLs, 3 of 3" {
  let box = ghBox(ghEmails)
  let ep = ghEndpoints(box, true, "ghe.example.com:8443")
  assert(
    ep.authorize == "https://ghe.example.com:8443/login/oauth/authorize",
    "authorize '${ep.authorize}'",
  )
  assert(
    ep.token == "https://ghe.example.com:8443/login/oauth/access_token",
    "token '${ep.token}'",
  )
  let profile = ep.profile
  profile("t") catch e {
    panic(e.message())
  }
  assert(box.urls[0] == "https://ghe.example.com:8443/api/v3/user", "API user '${box.urls[0]}'")
  assert(
    hasPrefix(box.urls[1], "https://ghe.example.com:8443/api/v3/user/emails?"),
    "API emails '${box.urls[1]}'",
  )
  assert(
    ghHeader(box.headers, "X-GitHub-Api-Version") == "2022-11-28",
    "Enterprise Server sends the version every release knows",
  )
}

fn ghHeader(headers: []Header, name: string): string {
  for h of headers {
    if (h.name == name) {
      return h.value
    }
  }
  return ""
}

test "the profile requests carry the token, GitHub's media type, the API version and a User-Agent" {
  let box = ghBox(ghEmails)
  ghProfile(box, true) catch e {
    panic(e.message())
  }
  assert(ghHeader(box.headers, "Authorization") == "Bearer gho_token", "Authorization header")
  assert(
    ghHeader(box.headers, "Accept") == "application/vnd.github+json",
    "Accept '${ghHeader(box.headers, "Accept")}'",
  )
  assert(
    ghHeader(box.headers, "X-GitHub-Api-Version") == "2026-03-10",
    "version '${ghHeader(box.headers, "X-GitHub-Api-Version")}'",
  )
  assert(ghHeader(box.headers, "User-Agent") != "", "GitHub rejects a request with no User-Agent")
}

test "invalid enterpriseHost values are an Error at startup" {
  let bad = [
    "https://ghe.example.com",
    "ghe.example.com/",
    "ghe.example.com/api",
    "ghe.example.com?x=1",
    "user@ghe.example.com",
    "ghe example.com",
    "ghe.example.com:",
    "ghe.example.com:port",
    "ghe.example.com:123456",
    ".example.com",
    "ghe..example.com",
    "ghe.example.com.",
    "-ghe.example.com",
    "ghe.example.com#frag",
    "ghe.example.com\\x",
  ]
  for host of bad {
    let msg = ghStartupErr(GithubOptions{ enterpriseHost = host, apiFetch = ghFetch(ghBox("[]")) })
    assert(contains(msg, "enterpriseHost"), "'${host}' was accepted or mis-reported: '${msg}'")
  }
}

test "no tls and no apiFetch is an Error at startup naming the option" {
  let msg = ghStartupErr(GithubOptions{})
  assert(contains(msg, "GithubOptions.tls"), "want the tls failure, got '${msg}'")
}

test "a failing /user/emails fails the sign-in even when the email is not required" {
  let box = ghBox(ghEmails)
  box.failUrl = "/user/emails"
  let msg = ghProfileErr(box, false)
  assert(contains(msg, "HTTP 403"), "the 403 was swallowed: '${msg}'")
}

test "a /user with no numeric id fails" {
  for body of ["{\"login\":\"octocat\"}", "{\"id\":\"583231\"}", "{\"id\":0}", "[]"] {
    let box = ghBox(ghEmails)
    box.user = body
    assert(ghProfileErr(box, true) != "", "'${body}' produced an Identity")
  }
}

test "a /user/emails that is not an array fails" {
  let msg = ghProfileErr(ghBox("{\"message\":\"Not Found\"}"), true)
  assert(contains(msg, "array"), "want the array failure, got '${msg}'")
}

test "/user/emails is paged: a verified primary on page 2 is found" {
  let filler = []string{}
  for (let i = 0; i < 100; i++) {
    filler = append(filler, "{\"email\":\"n${i}@example.com\",\"primary\":false,\"verified\":true}")
  }
  let box = ghBox("[" + join(filler, ",") + "]")
  box.page2 = "[{\"email\":\"late@example.com\",\"primary\":true,\"verified\":true}]"
  let id = ghProfile(box, true) catch e {
    panic(e.message())
  }
  assert(ghStr(id, "email") == "late@example.com", "page 2 not read: '${ghStr(id, "email")}'")
  assert(len(box.urls) == 3, "want /user plus two pages, got ${len(box.urls)} requests")
}

test "a short first page stops the paging" {
  let box = ghBox(ghEmails)
  ghProfile(box, true) catch e {
    panic(e.message())
  }
  assert(len(box.urls) == 2, "want /user plus one page, got ${len(box.urls)} requests")
}

fn ghLocation(opts: OAuth2Options): string {
  let tbox = o2Box()
  opts.tokenFetch = o2TokenFetch(tbox)
  let s = OAuth2Strategy(
    ghEndpoints(ghBox(ghEmails), true, ""),
    "client-1",
    "sec",
    "https://app.example.com/callback",
    opts,
  ) catch e {
    panic("OAuth2Strategy: ${e.message()}")
  }
  return o2Begin(o2App(s)).location
}

test "the default strategy requests read:user user:email, and OAuth2Options.scopes overrides them" {
  let dflt = ghLocation(OAuth2Options{})
  assert(contains(dflt, "scope=read%3Auser%20user%3Aemail"), "default scopes in '${dflt}'")
  let own = ghLocation(OAuth2Options{ scopes = ["read:user"] })
  assert(contains(own, "scope=read%3Auser&"), "overridden scopes in '${own}'")
  assert(!contains(own, "user%3Aemail"), "the override kept user:email: '${own}'")
}

test "round trip through OAuth2Strategy: the numeric id comes back and whoami sees it" {
  let tbox = o2Box()
  let gbox = ghBox(ghEmails)
  let opts = OAuth2Options{ tokenFetch = o2TokenFetch(tbox), name = "github" }
  let s = OAuth2Strategy(
    ghEndpoints(gbox, true, ""),
    "client-1",
    "sec",
    "https://app.example.com/callback",
    opts,
  ) catch e {
    panic("OAuth2Strategy: ${e.message()}")
  }
  let app = o2App(s)
  let b = o2Begin(app)
  assert(
    hasPrefix(b.location, "https://github.com/login/oauth/authorize?"),
    "redirect '${b.location}'",
  )
  assert(contains(b.location, "scope=read%3Auser%20user%3Aemail"), "scopes in '${b.location}'")
  assert(contains(b.location, "code_challenge_method=S256"), "no S256 in '${b.location}'")

  let res = app.handle(o2CallbackReq("/callback", b.cookie, o2Ok(b)))
  assert(res.status == 200, "want 200, got ${res.status}: ${res.body}")
  assert(res.body == "583231", "want the numeric id, got '${res.body}'")
  assert(ghHeader(gbox.headers, "Authorization") == "Bearer at-1", "the access token was not used")
  let who = app.handle(authReq("/whoami", res.getHeader("Set-Cookie")))
  assert(who.body == "583231", "the Identity was not stored: '${who.body}'")
}
