// A recovery code is a second factor only after its removal commits. The
// application owns that atomic comparison; a local lock cannot protect
// requests served by different processes.
export class RecoveryFactor {
  hashesFor: (string) => []string!
  save: (string, []string, []string) => bool!
  throttle: LoginThrottle

  // `save` atomically replaces the persisted list only if it still equals
  // `expected`. False means another attempt changed it. An error refuses
  // authentication, including an ambiguous error after a committed write.
  init(
    hashesFor: (string) => []string!,
    save: (string, []string, []string) => bool!,
    throttle: LoginThrottle,
  )! {
    if (hashesFor == nil || save == nil) {
      fail newError("auth: RecoveryFactor(): `hashesFor` and atomic `save` are required")
    }
    this.hashesFor = hashesFor
    this.save = save
    this.throttle = throttle
  }

  export name(): string {
    return "recovery"
  }

  // Self-throttled: leave CompleteOptions.throttle empty to count once.
  export verify(c: Ctx, userId: string, input: string): bool! {
    return this.verifyWith(c, userId, input, nil)?
  }

  // Reuse the existing verifier seam without changing the public factor.
  verifyWith(c: Ctx, userId: string, input: string, verify: Verify): bool! {
    let account = recoveryThrottlePrefix + userId
    let ip = c.peer()
    this.throttle.check(account, ip)?
    let hit = this.consume(userId, input, verify)?
    this.record(account, ip, hit)?
    return hit
  }

  consume(userId: string, input: string, verify: Verify): bool! {
    if (userId == "") {
      return false
    }
    let load = this.hashesFor
    let hashes = load(userId)?
    if (len(hashes) > recoveryMaxCount) {
      fail newError("auth: RecoveryFactor: stored hashes exceed ${recoveryMaxCount}")
    }
    // Keep the expected value independent of the store's mutable array.
    let expected = []string(0)
    for hash of hashes {
      expected = append(expected, hash)
    }
    let redeemed = redeemWith(expected, input, RedeemOptions{}, verify) catch _ {
      return false
    }
    let save = this.save
    return save(userId, expected, redeemed.remaining)?
  }

  record(account: string, ip: string, hit: bool): ()! {
    if (hit) {
      this.throttle.recordSuccess(account)?
      return
    }
    this.throttle.recordFailure(account, ip)?
  }
}
