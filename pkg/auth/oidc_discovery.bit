// pkg/auth/oidc_discovery.bit — OIDC discovery (#5772) and a JWKS cache with
// key-rotation and a rate-limited refetch-on-miss, independent of
// `PasswordStrategy`.
//
// `discover`/`JwksCache` both take an explicit `TlsConfig` rather than
// reaching for a package default: `stdlib/http/client.bit`'s own
// `defaultClientConfig`/`defaultRoots` are module-private, and nothing in
// `std/http`/`std/tls` exports a way to build a secure-by-default config from
// outside those modules. `pkg/postgres/tlsnegotiate.bit` and
// `pkg/mysql/tlsnegotiate.bit` hit the identical gap and made the same call —
// `roots`/`TlsConfig` is the caller's to supply, never guessed by the package.
//
// Two OIDC Discovery 1.0 requirements this file enforces, not merely
// documents (#5772 security requirements):
//
//   - the issuer is only ever fetched over https (§2, §4.3) — checked before
//     any network access, not left to `requestTls`'s own https-only check,
//     so the error names the issuer rather than a generic "not https" one;
//   - the discovery document's own `issuer` member must equal the configured
//     issuer BYTE-FOR-BYTE (§4.3) — a provider whose document disagrees with
//     the issuer the caller configured is rejected outright, which is what
//     stops a compromised or misconfigured discovery endpoint from vouching
//     for a different issuer than the one the application trusts.
//
// `HttpFetch` is the one seam between this file and the network, exactly the
// shape `pkg/web/ratelimit.bit`'s `RateClock` uses for its clock: `nil`
// means "the real one" (`httpsGetTls`, which calls `std/http`'s `getTls`),
// and a test substitutes a call-counting fake so the rate limiter and the
// HTTP-call counts in this file's tests are provable with NO real network
// and no TLS handshake. `discoverFetch` itself stays module-private — see
// #6150's revision below for why the exported seam lives elsewhere.
//
// #6150, REVISED: exporting `discoverFetch`/`handleCallbackFetch`
// (oidc_callback.bit) directly made a downstream
// app's callback ROUTE call a different function in a test than in
// production (`handleCallbackFetch` vs `handleCallback`) — exactly the
// per-request ceremony a seam should remove; a route's own code must be
// byte-for-byte identical in both. `HttpFetch` stays exported (a downstream
// test still needs to name the type to write a fake), but the injection
// point moves to construction time: `JwksCache(..., JwksSource.Parsed(jwks))`
// (below) builds a `JwksCache` from an already-known `Jwks` — no network
// call, real or local, at all — and `OidcStrategy.tokenFetch` (oidc_authorize.bit) carries
// the callback's own seam on the STRATEGY VALUE, so `handleCallback(s, c)`
// is the one call site in both production and a downstream app's test; only
// how `s` was built differs, the same way a discovered `Provider` in
// production and a hand-built fake strategy in a test already differ. See
// `docs/testing.md`'s "Testing your sign-in routes".
//
// `isSome`, `unwrap`, `Json`, `JsonEntry`, `jsonDecMember`, `jsonDecObject`,
// `jsonDecString`, `jsonEncode`, `jsonGet` and `jsonParse` are already bound
// module-wide by `strategy.bit` (an import binds per MODULE, SPEC §17.1), so
// re-importing any of them here is E0042.
import { TlsConfig } from "std/tls"
import { Response, getTls } from "std/http"
import { hasPrefix } from "std/strings"
import { Mono, Second, monotonic, since } from "std/time"
import { Jwks, VerifyKey, jwksFindByKid, parseJwks, refreshJwks } from "std/jwt"
import { Mutex, RWMutex } from "std/sync"

// The path every OIDC provider serves its discovery document at (RFC 8414 /
// OIDC Discovery 1.0 §4.1), appended to the issuer with no separator: the
// issuer itself must carry no trailing slash for the concatenation to be the
// canonical URL, which is the same requirement the spec places on the
// issuer identifier.
const wellKnownPath = "/.well-known/openid-configuration"

// How long `JwksCache.find` waits after a refetch — successful or not —
// before it will attempt another one for a still-unknown `kid`. 60 seconds:
// long enough that a sustained attack spraying unknown `kid`s costs the
// JWKS endpoint at most one request per minute per cache, short enough that
// a genuine key rotation is picked up well inside any reasonable token
// lifetime. Documented here rather than left a bare literal because #5772's
// security requirement is that this number exists and is deliberate, not
// whatever `since` happened to return first.
const jwksRefetchCooldownNs: int = 60 * Second

// One HTTP GET, returning the response body on success. Exported and
// injectable — see the file header. Production code always passes `nil`.
export type HttpFetch = (string) => string!

// `fetch(url)` when a test supplied one, else a real `getTls` GET under
// `tls`, treating any non-200 status as a failure (`Response.status`,
// `stdlib/http/http.bit`).
fn fetchGet(fetch: HttpFetch, tls: TlsConfig, url: string): string! {
  if (fetch == nil) {
    return httpsGetTls(url, tls)?
  }
  return fetch(url)?
}

fn httpsGetTls(url: string, tls: TlsConfig): string! {
  let res = getTls(url, tls)?
  return checkStatus(url, res)?
}

// `res.body` on a 200, else a failure naming `url` and the status. Split out
// of `httpsGetTls` so a test can prove the non-200 rejection against an
// in-memory `Response` (`std/http`) with no real network and no TLS
// handshake — `oidc_discovery.test.bit`'s fake `HttpFetch` calls this same
// function, so the fake and the real path share the one rejection rule.
fn checkStatus(url: string, res: Response): string! {
  if (res.status != 200) {
    fail newError("GET ${url}: HTTP ${res.status}")
  }
  return res.body
}

// The fields `OidcStrategy` (#5776) needs out of a discovery document
// (the four endpoints, plus the optional `end_session_endpoint`, #6951),
// plus the multi-tenant switch (#5810). `multiTenant` false (the zero value,
// and what every `discover()` result carries) means `issuer` is the one
// issuer every token must carry, byte-for-byte. `multiTenant` true means
// `issuer` is a TEMPLATE holding the literal placeholder `{tenantid}` (what
// Microsoft's `common`/`organizations` documents publish) and
// `verifyIdToken` (oidc_verify.bit) substitutes each token's own `tid`
// claim into it, then checks the token's `iss` against the result;
// `allowedTenants`, when non-empty, further restricts which `tid` values
// verify (oidc_tenant.bit).
export class OidcConfig {
  export issuer: string,
  export authorizationEndpoint: string,
  export tokenEndpoint: string,
  export jwksUri: string,
  // The provider's `end_session_endpoint` (OIDC RP-Initiated Logout 1.0 §2.1),
  // `None` when its document publishes none; `endSession` (oidc_logout.bit)
  // then logs out locally only. Always https when present.
  export endSessionEndpoint: Option<string>,
  export multiTenant: bool,
  export allowedTenants: []string,
}

// Fetches `issuer + "/.well-known/openid-configuration"` over TLS under
// `tls` and parses it into an `OidcConfig`. Fails, naming `issuer`, on a
// non-https issuer, a non-200 response, a malformed document, or a document
// whose own `issuer` member disagrees with `issuer` (OIDC Discovery 1.0
// §4.3 — see the file header).
export fn discover(issuer: string, tls: TlsConfig): OidcConfig! {
  return discoverFetch(issuer, tls, nil)?
}

// `discover` against an injected `HttpFetch` — the test seam. Module-private:
// a downstream test builds an `OidcConfig` literal directly instead (every
// field is exported, and discovery has nothing left to prove once the
// values are already known — see docs/testing.md).
fn discoverFetch(issuer: string, tls: TlsConfig, fetch: HttpFetch): OidcConfig! {
  return discoverAt(issuer, issuer, tls, fetch)?
}

// `discoverFetch` with the discovery URL's base and the issuer the document
// must name split apart: the document is fetched from `base` and its own
// `issuer` member must equal `wantIssuer` byte-for-byte. They are the same
// string for every ordinary provider; Microsoft's `common`/`organizations`/
// `consumers` aliases publish a document whose issuer is NOT its own URL
// (providers.bit, #5810), and say so here by passing the exact issuer they
// expect instead of loosening the comparison. `base` is https-checked, not
// `wantIssuer`: `base` is where the fetch goes.
fn discoverAt(base: string, wantIssuer: string, tls: TlsConfig, fetch: HttpFetch): OidcConfig! {
  if (!hasPrefix(base, "https://")) {
    fail newError("auth: discover(): issuer '${base}' must be an https URL (OIDC Discovery 1.0 §4.3)")
  }
  let url = base + wellKnownPath
  let body = fetchGet(fetch, tls, url) catch e {
    fail newError("auth: discover(): fetching ${url}: ${e.message()}")
  }
  let cfg = parseOidcConfig(body, wantIssuer) catch e {
    fail newError("auth: discover(): ${base}: ${e.message()}")
  }
  return cfg
}

// The one required string member `path` of the parsed discovery document
// `entries`, or a `parseOidcConfig`-shaped failure naming it.
fn discoveryMember(entries: []JsonEntry, path: string): string! {
  return jsonDecString(
    jsonDecMember(entries, "oidc discovery document", path)?,
    "oidc discovery document.${path}",
  )?
}

// The optional `end_session_endpoint` member of the discovery document `j`:
// `None` when absent, a failure when present but not an https URL string
// (OIDC Discovery 1.0 §4.3 applies to every endpoint this package redirects a
// browser to).
fn endSessionMember(j: Json): Option<string>! {
  let field = jsonGet(j, "end_session_endpoint")
  if (!isSome(field)) {
    return Option.None
  }
  let url = jsonAsString(unwrap(field))
  if (!isSome(url) || !hasPrefix(unwrap(url), "https://")) {
    fail newError("end_session_endpoint must be an https URL string (OIDC Discovery 1.0 §4.3)")
  }
  return Option.Some(unwrap(url))
}

fn parseOidcConfig(body: string, issuer: string): OidcConfig! {
  let j = jsonParse(body)?
  let entries = jsonDecObject(j, "oidc discovery document", 0)?
  let docIssuer = discoveryMember(entries, "issuer")?
  if (docIssuer != issuer) {
    fail newError("issuer mismatch: configured '${issuer}', document says '${docIssuer}'")
  }
  return OidcConfig{
    issuer = docIssuer,
    authorizationEndpoint = discoveryMember(entries, "authorization_endpoint")?,
    tokenEndpoint = discoveryMember(entries, "token_endpoint")?,
    jwksUri = discoveryMember(entries, "jwks_uri")?,
    endSessionEndpoint = endSessionMember(j)?,
    multiTenant = false,
    allowedTenants = []string{},
  }
}

// Where a `JwksCache` gets its first key set: `Remote` fetches `jwksUri`
// over TLS under `tls` and parses it, `Parsed(jwks)` takes an already-known
// `Jwks` with no HTTP call, real or local, at all.
export enum JwksSource { Remote, Parsed(Jwks) }

// A `Jwks` (`std/jwt`) kept fresh across key rotation, with a rate-limited
// refetch on a `kid` miss (#5772's security requirement).
//
// `JwksCache(jwksUri, tls)` fetches `jwksUri` over TLS under `tls` and parses
// it into a cache ready for `find`. `JwksCache(jwksUri, tls,
// JwksSource.Parsed(jwks))` builds one already holding `jwks` — the exported
// seam #6150 asks for: a downstream app's own test parses a canned JWKS body
// with `std/jwt`'s public `parseJwks` and passes the result straight in, so
// building a fake provider's key set needs no network access at all, not even
// to a local server. Either way a future cache miss refetches through `fetch`
// (`nil` meaning the real network, exactly like every other `HttpFetch` in
// this file), and `find`/`doRefetch` (below) treat the result identically —
// the rate-limited refetch-on-miss logic (#5772, #5788) is not a different
// code path for a hand-built cache.
//
// BOUNDED: exactly one `Jwks` is ever held — `doRefetch` REPLACES `this.jwks`
// wholesale, never appends to it — so the cache's size is the size of one
// JWKS document, however many times `find` refetches over the cache's
// lifetime.
//
// CONCURRENCY (#5788): one cache is shared by every request handler, and
// `pkg/web` runs handlers as concurrent tasks, so `find` must be safe under
// concurrent calls. Two locks, deliberately not one:
//
//   - `refetchLock` (`std/sync.Mutex`) makes "is the cooldown over, and if
//     so claim this fetch" ONE atomic step (`claimRefetch`) — only the
//     caller that flips `hasRefetched`/`lastRefetch` under this lock goes on
//     to fetch; every other concurrent miss loses the claim and fails with
//     `lastError`, exactly as it would inside a real cooldown window. The
//     lock is held only across the check-and-set, never across the network
//     call in `doRefetch` — holding it there would serialize every
//     verification behind one slow provider round-trip.
//   - `jwksLock` (`std/sync.RWMutex`) guards `this.jwks` itself: `find`
//     reads it under `rLock`, `doRefetch` replaces it under `lock` after the
//     fetch completes, so a concurrent reader always sees a complete `Jwks`
//     — the old one or the new one, never a torn write in between.
export class JwksCache {
  jwksUri: string
  tls: TlsConfig
  jwks: Jwks
  jwksLock: RWMutex
  // Whether a refetch (beyond the constructor's initial fetch) has ever run.
  // `false` lets the FIRST unknown-`kid` miss always refetch, regardless of
  // how recently the cache was constructed — the cooldown below is about
  // consecutive REFETCHES, not about the initial fetch.
  hasRefetched: bool
  lastRefetch: Mono
  // The error a refetch produced (a fetch failure, or "kid not found" after
  // a clean reparse) — returned verbatim to every miss inside the cooldown
  // window, so a caller sees why the KEY is unavailable rather than a
  // generic "try later" that hides a real outage. Read and written only
  // under `refetchLock`, the same lock that decides whether a miss claims a
  // fetch, so a concurrent reader never observes a half-written message.
  lastError: string
  refetchLock: Mutex
  fetch: HttpFetch

  init(
    jwksUri: string,
    tls: TlsConfig,
    source: JwksSource = JwksSource.Remote,
    fetch: HttpFetch = nil,
  )! {
    this.jwksUri = jwksUri
    this.tls = tls
    this.jwks = initialJwks(jwksUri, tls, source, fetch)?
    this.jwksLock = RWMutex()
    this.hasRefetched = false
    this.lastRefetch = Mono{ ns = 0 }
    this.lastError = ""
    this.refetchLock = Mutex()
    this.fetch = fetch
  }

  // The key for `kid`: a cache hit returns it with no HTTP call; a miss
  // refetches at most once per `jwksRefetchCooldownNs`.
  export find(kid: string): VerifyKey! {
    this.jwksLock.rLock()
    let key = jwksFindByKid(this.jwks, kid) catch _ {
      this.jwksLock.rUnlock()
      return this.refetchAndFind(kid)?
    }
    this.jwksLock.rUnlock()
    return key
  }

  // Atomically checks the cooldown and, if it has passed, claims the fetch
  // by flipping `hasRefetched`/`lastRefetch` before releasing `refetchLock`
  // — the check and the claim are one critical section, so two concurrent
  // callers can never both read "cooldown over" before either has claimed
  // it (#5788).
  claimRefetch(): bool {
    this.refetchLock.lock()
    if (this.hasRefetched && since(this.lastRefetch) < jwksRefetchCooldownNs) {
      this.refetchLock.unlock()
      return false
    }
    this.hasRefetched = true
    this.lastRefetch = monotonic()
    this.refetchLock.unlock()
    return true
  }

  refetchAndFind(kid: string): VerifyKey! {
    if (!this.claimRefetch()) {
      this.refetchLock.lock()
      let err = this.lastError
      this.refetchLock.unlock()
      fail newError(err)
    }
    let key = this.doRefetch(kid) catch e {
      this.refetchLock.lock()
      this.lastError = e.message()
      this.refetchLock.unlock()
      fail e
    }
    return key
  }

  doRefetch(kid: string): VerifyKey! {
    let body = fetchGet(this.fetch, this.tls, this.jwksUri)?
    let refreshed = refreshJwks(body)?
    this.jwksLock.lock()
    this.jwks = refreshed
    this.jwksLock.unlock()
    return jwksFindByKid(refreshed, kid)?
  }
}

// The key set `JwksCache`'s `init` starts from: `source`'s own `Jwks`, or the
// document at `jwksUri` fetched through `fetch` and parsed.
fn initialJwks(jwksUri: string, tls: TlsConfig, source: JwksSource, fetch: HttpFetch): Jwks! {
  match (source) {
    Parsed(jwks) => return jwks
    Remote => {
      let body = fetchGet(fetch, tls, jwksUri) catch e {
        fail newError("auth: JwksCache(): fetching ${jwksUri}: ${e.message()}")
      }
      return parseJwks(body) catch e {
        fail newError("auth: JwksCache(): parsing ${jwksUri}: ${e.message()}")
      }
    }
  }
}
