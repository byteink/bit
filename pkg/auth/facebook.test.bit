const fbToken = "The quick brown fox jumps over the lazy dog"
const fbUser = "{\"id\":\"42\",\"name\":\"Ada\",\"email\":\"ada@example.com\"}"
const fbDebug = "{\"data\":{\"app_id\":\"123\",\"user_id\":\"42\",\"is_valid\":true}}"
const fbUserProof = "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8"
const fbAppProof = "368245e18c8a74eef09d2ca9bd3bda35faa9273327027bab6fc1a4f0622c51e2"

class FbBox {
  urls: []string,
  headers: [][]Header,
  debug: string = fbDebug,
  user: string = fbUser,
  status: int = 200,
  userStatus: int = 200,
  failRequest: bool = false,
}

fn fbFetch(box: FbBox): FacebookFetch {
  let f: FacebookFetch = (url, headers) => {
    box.urls = append(box.urls, url)
    box.headers = append(box.headers, headers)
    if (box.failRequest) {
      fail newError(url + " 123|key " + fbToken)
    }
    let body = box.user
    let status = box.userStatus
    if (contains(url, "/debug_token?")) {
      body = box.debug
      status = box.status
    }
    return Response{
      status = status,
      contentType = "application/json",
      headers = "",
      body = body,
    }
  }
  return f
}

fn fbOptions(box: FbBox): FacebookOptions {
  return FacebookOptions{ appId = "123", appSecret = "key", apiFetch = fbFetch(box) }
}

fn fbProfile(box: FbBox): Identity! {
  let ep = facebook(fbOptions(box))?
  let profile = ep.profile
  return profile(fbToken)?
}

fn fbError(box: FbBox): string {
  fbProfile(box) catch e {
    return e.message()
  }
  return ""
}

fn fbStartup(opts: FacebookOptions): string {
  facebook(opts) catch e {
    return e.message()
  }
  return ""
}

fn fbRedacted(msg: string) {
  assert(msg != "", "must fail")
  assert(!contains(msg, fbToken), "user token leaked")
  assert(!contains(msg, "123|key"), "app token leaked")
  assert(!contains(msg, "key"), "app secret leaked")
}

test "Facebook HMAC matches the known SHA256 key and quick brown fox vector" {
  assert(facebookProof("key", fbToken) == fbUserProof, "HMAC vector")
}

test "Facebook both Graph calls prove the credential used by their bearer header" {
  let box = FbBox{}
  fbProfile(box) catch e {
    panic(e.message())
  }
  assert(len(box.urls) == 2, "two Graph calls")
  assert(contains(box.urls[0], "&appsecret_proof=" + fbAppProof), "app-token proof")
  assert(contains(box.urls[1], "&appsecret_proof=" + fbUserProof), "user-token proof")
  assert(box.headers[0][0].value == "Bearer 123|key", "debug credential")
  assert(box.headers[1][0].value == "Bearer " + fbToken, "profile credential")
  assert(contains(box.urls[0], "input_token=" + percentEncode(fbToken)), "encoded input token")
  assert(contains(box.urls[1], "fields=id%2Cname%2Cemail"), "encoded fields")
}

test "Facebook profile preserves id and email without asserting verification" {
  let id = fbProfile(FbBox{}) catch e {
    panic(e.message())
  }
  assert(id.id == "42", "app-scoped id")
  assert(oauth2Field(id.claims, "name") == "Ada", "name")
  assert(oauth2Field(id.claims, "email") == "ada@example.com", "email")
  assert(!unwrap(jsonAsBool(unwrap(jsonGet(id.claims, "email_verified")))), "unverified email")
}

test "Facebook missing email is empty and unverified" {
  let id = fbProfile(FbBox{ user = "{\"id\":\"42\"}" }) catch e {
    panic(e.message())
  }
  assert(oauth2Field(id.claims, "email") == "", "absent email")
  assert(
    !unwrap(jsonAsBool(unwrap(jsonGet(id.claims, "email_verified")))),
    "absent email unverified",
  )
}

test "Facebook construction rejects missing secret and app id" {
  let opts = fbOptions(FbBox{})
  opts.appSecret = ""
  assert(contains(fbStartup(opts), "required"), "secret required")
  opts.appSecret = "key"
  opts.appId = ""
  assert(contains(fbStartup(opts), "required"), "app id required")
}

test "Facebook construction requires TLS unless fetch is injected" {
  assert(
    contains(fbStartup(FacebookOptions{ appId = "123", appSecret = "key" }), "tls"),
    "explicit TLS",
  )
}

test "Facebook Graph error bodies on HTTP 200 and 403 expose only the numeric code" {
  for status of [200, 403] {
    for step of [0, 1] {
      let box = FbBox{ status = status }
      let body = "{\"error\":{\"code\":190,\"message\":\"" + fbToken + " 123|key\"}}"
      if (step == 0) {
        box.debug = body
      } else {
        box.user = body
        box.status = 200
        box.userStatus = status
      }
      let msg = fbError(box)
      fbRedacted(msg)
      assert(msg == "auth: facebook: Graph error 190", "numeric code only")
    }
  }
}

test "Facebook Graph arbitrary error codes and parse failures never echo credentials" {
  for body of ["{\"error\":{\"code\":\"123|key\",\"message\":\"secret\"}}", "123|key invalid-json"] {
    fbRedacted(fbError(FbBox{ debug = body }))
    fbRedacted(fbError(FbBox{ user = body }))
  }
}

test "Facebook Graph transport and HTTP failures never echo request URLs or tokens" {
  fbRedacted(fbError(FbBox{ failRequest = true }))
  let msg = fbError(FbBox{ status = 403 })
  fbRedacted(msg)
  assert(msg == "auth: facebook: Graph HTTP 403", "HTTP status")
}

test "Facebook rejects invalid token inspection before fetching a profile" {
  for data of [
    "{}",
    "{\"data\":{\"is_valid\":false}}",
    "{\"data\":{\"is_valid\":\"true\"}}",
    "{\"data\":{\"is_valid\":true,\"app_id\":\"other\",\"user_id\":\"42\"}}",
    "{\"data\":{\"is_valid\":true,\"app_id\":\"123\"}}",
  ] {
    let box = FbBox{ debug = data }
    fbRedacted(fbError(box))
    assert(len(box.urls) == 1, "invalid debug stops profile fetch")
  }
}

test "Facebook rejects missing or mismatched profile identity" {
  for body of ["{}", "{\"id\":\"other\"}", "{\"id\":42}"] {
    fbRedacted(fbError(FbBox{ user = body }))
  }
}

test "Facebook version override changes all four endpoints" {
  let box = FbBox{}
  let opts = fbOptions(box)
  opts.apiVersion = "v25.0"
  opts.fields = ["id", "name"]
  let ep = facebook(opts) catch e {
    panic(e.message())
  }
  assert(ep.authorize == "https://www.facebook.com/v25.0/dialog/oauth", "authorize")
  assert(ep.token == "https://graph.facebook.com/v25.0/oauth/access_token", "token")
  let profile = ep.profile
  profile(fbToken) catch e {
    panic(e.message())
  }
  for url of box.urls {
    assert(hasPrefix(url, "https://graph.facebook.com/v25.0/"), "Graph version")
  }
}

test "Facebook rejects version path and query injection" {
  for version of ["", "v26.0/evil", "v26.0?token=", "v26.0#fragment"] {
    let opts = fbOptions(FbBox{})
    opts.apiVersion = version
    assert(contains(fbStartup(opts), "apiVersion"), "version rejected")
  }
}
