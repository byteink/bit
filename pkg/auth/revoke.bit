// pkg/auth/revoke.bit — "log out everywhere" (#6953): destroy every session
// a user holds, from any device, in one call.
//
// Every login this package performs files its session under the user's id
// (`bindSession`, strategy.bit, under `subjectIndexKey`), so the session
// store can find them all without scanning: `SessionStore.destroyIndexed`
// (pkg/web/session.bit, #6928) tombstones each one exactly as
// `Session.destroy()` does, and the next request on any of those cookies is
// a stranger. Use it when the user asks for it, when a password or recovery
// codes change (OWASP ASVS v5 V7: end the other sessions on a credential
// change), and when an admin disables an account.
//
// `Ctx`, `SessionStore` (import below), `subjectIndexKey` and `newError` are
// already bound module-wide (an import binds per MODULE, SPEC §17.1).
import { SessionStore } from "web"

// A destroyed session id stays refused for the lifetime of a live one, so a
// request still holding the pre-destroy snapshot cannot write it back
// (#5794). This is `sessionTTLSeconds` in pkg/web/session.bit, which that
// package does not export; a store keeping tombstones for less than a session
// lives would let a concurrent save resurrect one.
const sessionTombstoneTtl: i64 = 86400

// Which of the subject's sessions `logoutEverywhere` leaves alone.
export enum Keep {
  // None: every session of the subject is destroyed, the caller's own
  // included. After this, the request's session is gone and a later write to
  // it fails; answer with a redirect to the sign-in page, as for any logout.
  Nobody,
  // The session of the request `c`: "sign out my other devices" after a
  // password change. Fails when the app configured no session store.
  Current(Ctx),
}

// Destroys every session `subject` (an `Identity.id`) holds in `sessions`,
// except those `keep` names, and returns how many it destroyed. `sessions` is
// the store the app passed to `Config`; the same value is shared, so the
// sessions of every server process behind it are revoked together.
//
// Fails for an empty `subject`: the store refuses an empty value, and
// "log out the user with no id" is a bug in the caller.
export fn logoutEverywhere(
  sessions: SessionStore,
  subject: string,
  keep: Keep = Keep.Nobody,
): int! {
  if (subject == "") {
    fail newError("auth: logoutEverywhere(): subject is empty")
  }
  let except = ""
  match (keep) {
    Nobody => {}
    Current(c) => { except = c.session()?.id() }
  }
  return sessions.destroyIndexed(subjectIndexKey, subject, except, sessionTombstoneTtl)?
}
