// pkg/auth/oidc_logout.bit — OpenID Connect RP-Initiated Logout 1.0 (final,
// 2022, #6951): `endSession` signs the user out of this application AND of the
// identity provider, `handleLogoutCallback` closes the round trip.
//
// Without it, "log out" is `Session.destroy()` alone: the provider's own
// session stays, and the next "Sign in" silently logs the user straight back
// in without a password prompt.
//
// THE REQUEST (§2). `endSession` redirects the browser (a GET, §2) to
// `OidcConfig.endSessionEndpoint` — the `end_session_endpoint` member of the
// discovery document, OIDC Session Management 1.0 §2.1 / RP-Initiated Logout
// §2.1 — with these query parameters, each percent-encoded:
//
//   id_token_hint             the raw ID token `handleCallback` kept in the
//                             session (`idTokenSessionKey`); omitted when the
//                             session has none, e.g. it already expired
//   client_id                 always sent, so the OP can tell which client is
//                             logging out even without a hint
//   post_logout_redirect_uri  only when the app asked for one
//   state                     only together with post_logout_redirect_uri
//
// §2 says `post_logout_redirect_uri` is only honoured with `id_token_hint` or
// `client_id`; `client_id` is always present, so that holds by construction. A
// `post_logout_redirect_uri` reaches the OP only if it is byte-for-byte one of
// `OidcStrategy.postLogoutRedirectUris` (§3: the OP matches a pre-registered
// value exactly; this package refuses first, so a typo or an attacker-chosen
// value is a loud `Error` in the app, never an open redirect through the OP).
// An `endSessionEndpoint` query component is kept and extended (§2.1).
//
// ORDER. The local session is destroyed BEFORE the redirect leaves
// (`Session.destroy()`, pkg/web/session.bit): if building or sending the
// redirect fails, the user is not left logged in. Only an invalid argument
// (an unregistered `postLogoutRedirectUri`) fails earlier, and it fails before
// anything is destroyed because it is a programming error, not a runtime one.
//
// WHY `state` LIVES IN A COOKIE, NOT THE SESSION. `destroy()` tombstones the
// session and every later `set` on it panics, so a value cannot ride in the
// session across a destroy-first logout. `state` therefore goes in a short-
// lived `HttpOnly; Secure; SameSite=Lax` cookie (`logoutStateCookie`):
// SameSite=Lax is sent on the OP's top-level GET back to the app, which is the
// only request that needs it. `handleLogoutCallback` compares it with the
// returned `state` in constant time (`ctEq`) and clears it, so a replayed
// callback fails like a forged one.
//
// NO `end_session_endpoint`. A provider that does not publish one cannot end
// its own session from here (Google, for one, publishes none): `endSession`
// then logs out LOCALLY ONLY and sends the browser straight to
// `postLogoutRedirectUri` (still with `state`, so one `handleLogoutCallback`
// route serves both kinds of provider) or "/" when none was asked for. The
// user's provider session, and so a passwordless re-login, survives; an app
// that needs more must send users to the provider's own sign-out page.
//
// `Ctx`, `Res`, `Session`, `Header`, `percentEncode`, `newAuthToken`,
// `unauthorized`, `ctEq`, `split`, `indexOf`, `trimSpace`, `hasPrefix`,
// `isSome`, `unwrap`, `jsonGet`, `jsonAsString` are already bound module-wide.

// Fixed session keys `handleCallback` (oidc_callback.bit) writes after a
// verified login and `endSession` reads. `auth:oidc-sid` is the OP session id
// (OIDC Back-Channel Logout 1.0 §2.1) a later back-channel ticket indexes by.
const idTokenSessionKey = "auth:oidc-id-token"
const sidSessionKey = "auth:oidc-sid"

// The cookie carrying the logout `state` across the provider round trip, and
// how long it may live: ten minutes, ample for a provider's confirmation
// page, short enough that an abandoned logout leaves nothing behind.
const logoutStateCookie = "bit_oidc_logout_state"
const logoutStateMaxAge = 600

// Where a logout with nothing to return to, and no `post_logout_redirect_uri`,
// lands after a local-only logout.
const logoutHome = "/"

// What `endSession` may be asked for beyond signing out. `postLogoutRedirectUri`
// is where the provider sends the browser afterwards: "" (the default) leaves
// that to the provider, a value must be one of
// `OidcOptions.postLogoutRedirectUris` exactly. `logoutHint` and `uiLocales`
// are RP-Initiated Logout 1.0 §2's optional `logout_hint` and `ui_locales`,
// sent only when non-empty.
export class LogoutOptions {
  export postLogoutRedirectUri: string = "",
  export logoutHint: string = "",
  export uiLocales: string = "",
}

// The URL's authority component: what follows `scheme://` up to the first
// `/`, `?` or `#`.
fn authorityOf(rest: string): string {
  let n = len(rest)
  let i = 0
  while (i < n) {
    let ch = rest[i:i + 1]
    if (ch == "/" || ch == "?" || ch == "#") {
      return rest[0:i]
    }
    i = i + 1
  }
  return rest
}

// The host part of `authority` with any `:port` removed; an IPv6 literal keeps
// its brackets.
fn hostOf(authority: string): string {
  if (hasPrefix(authority, "[")) {
    let end = indexOf(authority, "]")
    if (end < 0) {
      return authority
    }
    return authority[0:end + 1]
  }
  let colon = indexOf(authority, ":")
  if (colon < 0) {
    return authority
  }
  return authority[0:colon]
}

fn isLoopbackHost(host: string): bool {
  return host == "localhost" || host == "127.0.0.1" || host == "[::1]"
}

// Fails unless `uri` is an absolute https URL, or an http one on a loopback
// host (local development), with no userinfo and no fragment. Run at
// construction, so a bad registration never starts an app.
fn checkPostLogoutUri(uri: string): ()! {
  let problem = "auth: OidcStrategy(): OidcOptions.postLogoutRedirectUris: '${uri}' must be an https URL " +
    "(http only for localhost, 127.0.0.1 or [::1]) with no userinfo or fragment (OIDC RP-Initiated Logout 1.0 §3)"
  let plain = hasPrefix(uri, "http://")
  let rest = uri[7:len(uri)]
  if (!plain) {
    if (!hasPrefix(uri, "https://")) {
      fail newError(problem)
    }
    rest = uri[8:len(uri)]
  }
  let authority = authorityOf(rest)
  if (authority == "" || indexOf(authority, "@") >= 0 || indexOf(uri, "#") >= 0) {
    fail newError(problem)
  }
  if (plain && !isLoopbackHost(hostOf(authority))) {
    fail newError(problem)
  }
}

// `OidcStrategy`'s construction check over the whole registered list.
fn checkPostLogoutUris(uris: []string): ()! {
  for uri of uris {
    checkPostLogoutUri(uri)?
  }
}

// Fails unless `uri` is "" (nothing requested) or exactly one of the strategy's
// registered post-logout URIs: an exact string match, no normalisation, which
// is what rules out another host, a scheme downgrade and a userinfo trick
// (`https://app.example.com@evil.example/`) alike.
fn requireRegistered(s: OidcStrategy, uri: string): ()! {
  if (uri == "") {
    return
  }
  for registered of s.postLogoutRedirectUris {
    if (registered == uri) {
      return
    }
  }
  fail newError("auth: endSession(): post_logout_redirect_uri '${uri}' is not in OidcOptions.postLogoutRedirectUris")
}

// `base` with `query` appended, as `?` or, when `base` already has a query
// component, `&` (RP-Initiated Logout 1.0 §2.1).
fn appendQuery(base: string, query: string): string {
  if (indexOf(base, "?") >= 0) {
    return base + "&" + query
  }
  return base + "?" + query
}

fn param(name: string, value: string): string {
  return name + "=" + percentEncode(value)
}

// The logout query string, parameters joined by `&`; see the file header for
// which are sent when.
fn logoutQuery(s: OidcStrategy, idToken: string, o: LogoutOptions, state: string): string {
  let parts = []string{}
  if (idToken != "") {
    parts = append(parts, param("id_token_hint", idToken))
  }
  parts = append(parts, param("client_id", s.clientId))
  if (o.postLogoutRedirectUri != "") {
    parts = append(parts, param("post_logout_redirect_uri", o.postLogoutRedirectUri))
    parts = append(parts, param("state", state))
  }
  if (o.logoutHint != "") {
    parts = append(parts, param("logout_hint", o.logoutHint))
  }
  if (o.uiLocales != "") {
    parts = append(parts, param("ui_locales", o.uiLocales))
  }
  return join(parts, "&")
}

fn stateCookie(state: string): string {
  return logoutStateCookie +
    "=" +
    state +
    "; HttpOnly; SameSite=Lax; Secure; Path=/; Max-Age=" +
    "${logoutStateMaxAge}"
}

fn clearedStateCookie(): string {
  return logoutStateCookie + "=; HttpOnly; SameSite=Lax; Secure; Path=/; Max-Age=0"
}

// The value of the cookie `name` among every `Cookie` header line `raws`, or ""
// (the same walk `sessionIdFromCookies`, pkg/web/session.bit, makes).
fn cookieValue(raws: []string, name: string): string {
  for raw of raws {
    for pair of split(raw, ";") {
      let eq = indexOf(pair, "=")
      if (eq > 0 && trimSpace(pair[0:eq]) == name) {
        return trimSpace(pair[eq + 1:len(pair)])
      }
    }
  }
  return ""
}

// What `handleCallback` keeps for logout: the raw ID token (the
// `id_token_hint`) and its `sid` claim, when the provider issued one.
fn rememberLogoutHints(session: Session, idToken: string, payload: Json) {
  session.set(idTokenSessionKey, idToken)
  let sid = jsonGet(payload, "sid")
  if (!isSome(sid)) {
    return
  }
  let value = jsonAsString(unwrap(sid))
  if (isSome(value) && unwrap(value) != "") {
    session.set(sidSessionKey, unwrap(value))
  }
}

// The redirect target and whether it carries a `state`: the provider's
// `end_session_endpoint` with the logout query, or, with none published, the
// post-logout URI itself (local-only logout, see the file header).
fn logoutTarget(s: OidcStrategy, idToken: string, o: LogoutOptions, state: string): string {
  match (s.config.endSessionEndpoint) {
    Some(endpoint) => return appendQuery(endpoint, logoutQuery(s, idToken, o, state))
    None => {
      if (o.postLogoutRedirectUri == "") {
        return logoutHome
      }
      return appendQuery(o.postLogoutRedirectUri, param("state", state))
    }
  }
}

// Signs the user out of this application and of the provider: validates
// `opts`, destroys the local session, and redirects the browser to the
// provider's `end_session_endpoint` — see the file header for the parameters,
// the order, the `state` cookie and the no-endpoint fallback. Fails, before
// destroying anything, when `opts.postLogoutRedirectUri` is not one of
// `OidcOptions.postLogoutRedirectUris`.
export fn endSession(s: OidcStrategy, c: Ctx, opts: LogoutOptions = LogoutOptions{}): Res! {
  requireRegistered(s, opts.postLogoutRedirectUri)?
  let session = c.session()?
  let idToken = session.get(idTokenSessionKey)
  session.destroy()?
  let state = newAuthToken()
  let res = c.redirect(logoutTarget(s, idToken, opts, state))
  if (opts.postLogoutRedirectUri == "") {
    return res
  }
  return res.header("Set-Cookie", stateCookie(state))
}

// The post-logout route: verifies that the `state` the provider returned is the
// one `endSession` issued to this browser (constant time, single use — the
// cookie is cleared on `done`) and returns `done`, the response the app wants
// shown once signed out. A missing, wrong or replayed `state` is `unauthorized`.
export fn handleLogoutCallback(c: Ctx, done: Res): Res! {
  let want = cookieValue(c.headers("cookie"), logoutStateCookie)
  let got = c.query("state")
  if (want == "" || got == "" || !ctEq([]byte(want), []byte(got))) {
    fail unauthorized("state mismatch")
  }
  return done.header("Set-Cookie", clearedStateCookie())
}
