// pkg/webredis/idempotency.bit - `RedisIdempotencyStore`: pkg/web's
// `IdempotencyStore` (pkg/web/idempotency.bit) for an app that runs on more than
// one process. Epic #6061, #6097; its own package since #7861.
//
//     let store = RedisIdempotencyStore(r)
//     app.use(idempotency(IdempotencyPolicy{ store = store, ttl = 86400 }))
//
// WHY THIS IS ITS OWN PACKAGE. `IdempotencyStore.begin` returns an
// `IdempotencyClaim`, and `IdempotencyClaim`/`IdempotencyEntry`/
// `CachedResponse` are classes `web` owns; an interface is satisfied
// structurally (SPEC 14.3), but only by the same types, so the store needs
// `web`'s types AND `redis`'s client. Put in `redis`, every consumer of the
// client (`jobs`, `mail`) would resolve a web framework; put in `web`, every
// web app would resolve a Redis client (#7861). The adapter depends on both
// and neither depends on it, as connect-redis does for express. `bit.json`
// names `web` and `redis`; the names imported below are the only things this
// file takes from them.
//
// ONE KEY PER IDEMPOTENCY KEY, ONE STRING PER KEY. The value is
//
//     I<n>:<fingerprint><token>                       reserved, handler running
//     D<n>:<fingerprint><status>\n<h>\n<headers><body>   finished, response stored
//
// `<token>` is the reservation token `begin` minted (web's
// `newReservationToken`, 32 hex characters): it runs to the end of the value,
// so it needs no length of its own. A `D` value carries none, because a
// finished response has no owner left to protect.
//
// `<n>` is the byte length of the fingerprint, `<h>` the header count, each
// header `<nlen>:<name><vlen>:<value>`, and the body is whatever bytes are
// left, so it is never escaped, quoted or copied twice (JSON would have
// escaped every quote in it and bloated binary bodies by a factor of up to
// six). Redis strings are binary-safe, so any body round-trips.
//
// `begin` IS ONE COMMAND. `SET key <reserved> PX <ms> NX GET` writes the
// reservation only when the key is absent, and answers with the value that
// was there before, or a null when there was none (`NX` and `GET` together
// need Redis 7.0 or Valkey 7.2). Redis runs a command to completion before
// the next one starts, so of N callers racing one never-seen key exactly one
// gets the null reply; every other gets the winner's value back, in the same
// round trip. There is no get-then-set window to lose a race in.
//
// `finish` AND `abandon` ARE ONE SCRIPT EACH (#7832), because each must act
// only while the key still holds THEIR reservation: a handler that outlives
// `ttl` has lost it, a later request may have begun a new one under the same
// key, and a plain `DEL` or `SET` would destroy that request's reservation
// (the compare-and-delete of the redis.io distributed-lock pattern). Both
// scripts compare the stored token to the one `begin` returned, in the same
// step as the write, and do nothing when it differs or the key is gone or
// `Done`. `finish` also keeps the fingerprint `begin` stored (the interface
// hands it only the response) and rewrites the key with a fresh `ttl`; a
// client-side `GET` then `SET` would let an expiry slip between them. The
// scripts read the length-prefixed head, so they never parse the response.
//
// A FAILED `begin` IS NEVER RETRIED by the client (a write is not repeated
// on a dropped connection, `client.bit`): if the `SET` ran and its reply was
// lost, the key stays reserved until `ttl` runs out and a retry sees
// `InFlight`, the safe direction (`409`) rather than a second run.
//
// A STORED ENTRY THAT DOES NOT PARSE is `RedisError.Protocol`, not a silent
// "absent": treating garbage as no reservation would run the handler twice.
// An `Idempotency-Key` is client-supplied, so it is only ever appended to
// `prefix`; whatever bytes it holds, it names one key under that prefix.

import {
  CachedResponse,
  Header,
  IdempotencyClaim,
  IdempotencyEntry,
  IdempotencyState,
  newReservationToken,
} from "web"
import { Client, InfoSection, RedisError, Script, luaInt } from "redis"
import { indexOf, parseInt } from "std/strings"
import { Second } from "std/time"

// Seconds a key may be remembered: the largest `ttl * Second` that fits an
// `int` of nanoseconds, so the conversion below cannot wrap.
const maxIdempotencyTtl: i64 = 9_000_000_000

// Digits read for one length or count. 18 digits always fit an `int`.
const maxIdempotencyDigits: int = 18

// The shared head of both scripts: leaves `v`, `c` and `n` set when KEYS[1]
// holds an `I` value whose token is ARGV[1], and returns 0 otherwise.
const idempotencyOwnedSrc: string = `
local v = redis.call('GET', KEYS[1])
if not v or string.sub(v, 1, 1) ~= 'I' then return 0 end
local c = string.find(v, ':', 2, true)
local n = c and tonumber(string.sub(v, 2, c - 1))
if not n or string.sub(v, c + n + 1) ~= ARGV[1] then return 0 end
`

// ARGV: token, encoded response, ttl in milliseconds.
const idempotencyFinishSrc: string = idempotencyOwnedSrc +
  `
redis.call('SET', KEYS[1], 'D' .. string.sub(v, 2, c + n) .. ARGV[2], 'PX', ARGV[3])
return 1
`

// ARGV: token.
const idempotencyAbandonSrc: string = idempotencyOwnedSrc +
  `
return redis.call('DEL', KEYS[1])
`

// The store. `prefix` namespaces its keys: the default `idem:` keeps them
// apart from everything else in the database, and a second app sharing the
// server picks its own.
export class RedisIdempotencyStore {
  client: Client
  prefix: string
  finishScript: Script
  abandonScript: Script

  // Fails when the server is older than Redis 7.0 (`NX` with `GET` is a
  // syntax error there), so a server `begin` cannot run on never gets a
  // store, instead of failing every request that carries a key.
  init(client: Client, prefix: string = "idem:")! {
    requireNxGet(client)?
    this.client = client
    this.prefix = prefix
    this.finishScript = Script(idempotencyFinishSrc)
    this.abandonScript = Script(idempotencyAbandonSrc)
  }

  // Reserves `key` for `ttl` seconds and returns the reservation token to the
  // one caller that created it; every other caller gets the entry as it
  // stands, with an empty token.
  export begin(key: string, fingerprint: string, ttl: i64): IdempotencyClaim! {
    checkIdempotencyTtl(ttl)?
    let token = newReservationToken()
    let reserved = encodeInFlight(fingerprint, token)
    let prev = this.client.setGet(this.prefix + key, reserved, ttl = ttl * Second, ifAbsent = true)?
    if (isNone(prev)) {
      return IdempotencyClaim{ token = token }
    }
    return IdempotencyClaim{ existing = Option.Some(decodeEntry(unwrap(prev))?) }
  }

  // Stores `resp` under `key` for `ttl` seconds counted from this call, with
  // the fingerprint `begin` recorded, but only while the key still holds the
  // reservation `token` names. A reservation that expired, was freed or was
  // taken over by a later `begin` is left alone and the call succeeds
  // without writing: caching under a key with no reservation would store a
  // response with no fingerprint.
  export finish(key: string, token: string, resp: CachedResponse, ttl: i64): ()! {
    checkIdempotencyTtl(ttl)?
    let args = [token, encodeResponse(resp), "${ttl * 1000}"]
    this.finishScript.run(this.client, luaInt, keys = [this.prefix + key], args = args)?
  }

  // Deletes the reservation `token` names so a retry can run at once; a key
  // holding anyone else's reservation, or a finished response, is left alone.
  export abandon(key: string, token: string): ()! {
    this.abandonScript.run(this.client, luaInt, keys = [this.prefix + key], args = [token])?
  }
}

// The leading number of `redis_version:` in `INFO server`, 0 when absent.
// Valkey reports it too (7.2 and later).
fn serverMajor(info: string): int {
  let tag = "redis_version:"
  let at = indexOf(info, tag)
  if (at < 0) {
    return 0
  }
  let rest = info[at + len(tag):len(info)]
  let dot = indexOf(rest, ".")
  if (dot <= 0) {
    return 0
  }
  return parseInt(rest[0:dot]) catch _ {
    return 0
  }
}

fn requireNxGet(client: Client): ()!RedisError {
  let major = serverMajor(client.info(InfoSection.Server)?)
  if (major < 7) {
    fail RedisError.Invalid("redis: RedisIdempotencyStore needs Redis 7 or newer (SET with NX and GET); the server reported major version ${major}")
  }
}

fn checkIdempotencyTtl(ttl: i64): ()!RedisError {
  if (ttl < 1 || ttl > maxIdempotencyTtl) {
    fail RedisError.Invalid("redis: idempotency ttl is ${ttl} second(s), want 1..${maxIdempotencyTtl}")
  }
}

fn encodeInFlight(fingerprint: string, token: string): string {
  return "I${len(fingerprint)}:${fingerprint}${token}"
}

// The status line, the header block, then the body untouched.
fn encodeResponse(r: CachedResponse): string {
  let out = "${r.status}\n${len(r.headers)}\n"
  for h of r.headers {
    out = out + "${len(h.name)}:${h.name}${len(h.value)}:${h.value}"
  }
  return out + r.body
}

fn badEntry(why: string): RedisError {
  return RedisError.Protocol("redis: idempotency entry is corrupt: ${why}")
}

// A cursor over one stored value; every read is bounds-checked, so a
// truncated or foreign value is an error, never a panic.
class EntryReader {
  src: string
  pos: int

  // A decimal number ended by `stop`, the cursor left after it.
  num(stop: int): int!RedisError {
    let n = 0
    let digits = 0
    while (this.pos < len(this.src)) {
      let b = int(this.src[this.pos])
      this.pos = this.pos + 1
      if (b == stop) {
        if (digits == 0) {
          fail badEntry("empty number")
        }
        return n
      }
      if (b < 48 || b > 57 || digits >= maxIdempotencyDigits) {
        fail badEntry("bad number")
      }
      n = n * 10 + (b - 48)
      digits = digits + 1
    }
    fail badEntry("truncated number")
  }

  // The next `n` bytes.
  take(n: int): string!RedisError {
    if (n > len(this.src) - this.pos) {
      fail badEntry("truncated text")
    }
    let s = this.src[this.pos:this.pos + n]
    this.pos = this.pos + n
    return s
  }

  // One `<len>:<text>` field.
  field(): string!RedisError {
    let n = this.num(58)?
    return this.take(n)?
  }

  rest(): string {
    return this.src[this.pos:len(this.src)]
  }
}

fn decodeEntry(v: string): IdempotencyEntry!RedisError {
  if (len(v) == 0) {
    fail badEntry("empty value")
  }
  let rd = EntryReader{ src = v, pos = 1 }
  let fp = rd.field()?
  if (v[0] == 73) {
    return IdempotencyEntry{
      state = IdempotencyState.InFlight,
      fingerprint = fp,
      response = CachedResponse{},
    }
  }
  if (v[0] != 68) {
    fail badEntry("unknown state")
  }
  return IdempotencyEntry{
    state = IdempotencyState.Done,
    fingerprint = fp,
    response = decodeResponse(rd)?,
  }
}

fn decodeResponse(rd: EntryReader): CachedResponse!RedisError {
  let status = rd.num(10)?
  let count = rd.num(10)?
  // A header takes at least 4 bytes (`0:0:`), so a count the rest cannot
  // hold is corruption caught before it drives a loop.
  if (count > (len(rd.src) - rd.pos) / 4) {
    fail badEntry("header count")
  }
  let headers = []Header(0)
  let i = 0
  while (i < count) {
    let name = rd.field()?
    let value = rd.field()?
    headers = append(headers, Header{ name = name, value = value })
    i = i + 1
  }
  return CachedResponse{ status = status, body = rd.rest(), headers = headers }
}
