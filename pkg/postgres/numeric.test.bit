// pkg/postgres/numeric.test.bit — `decodeNumeric` (numeric.bit) proven two
// ways (#3989).
//
// FIRST, OFFLINE: hand-traced binary bodies for the cases the ticket names
// by name (a digit-group boundary, an internal zero group, leading and
// trailing zero groups, the maximum scale, NaN/Infinity/an out-of-range
// magnitude) — no server needed, every push runs these.
//
// SECOND, LIVE: `numericCorpus` (below), read from a real Postgres BOTH
// ways — `select amount` in binary and `select amount::text` in text — for
// every value. The binary side goes through `decodeNumeric`; the text side
// goes through `parseDecimal` directly on what the SERVER rendered. Neither
// side is generated by this package, so a bug in `decodeNumeric` that just
// reproduces what it was tested against cannot pass this: the oracle is
// Postgres's own `numeric_out`, not anything in `pkg/postgres`. Skipped
// when `PG_TEST_TRUST_URI` is unset, same convention as `live.test.bit`.

// Builds the binary `numeric` body `decodeNumeric` reads: ndigits, weight,
// sign, dscale, then the digit groups, exactly NumericSend's wire shape —
// written independently of `numeric.bit`'s own decode loop so a bug shared
// between encoder and decoder in this file cannot hide a real one.
fn numericBody(digits: []int, weight: int, sign: int, dscale: int): string {
  let b = []byte(8 + len(digits) * 2)
  putBe16(b, 0, len(digits))
  putBe16(b, 2, weight)
  putBe16(b, 4, sign)
  putBe16(b, 6, dscale)
  let i = 0
  while (i < len(digits)) {
    putBe16(b, 8 + i * 2, digits[i])
    i = i + 1
  }
  return string(b)
}

fn putBe16(b: []byte, off: int, v: int) {
  let u = v
  if (u < 0) {
    u = u + 65536
  }
  b[off] = byte(u / 256 % 256)
  b[off + 1] = byte(u % 256)
}

fn mustDecode(digits: []int, weight: int, sign: int, dscale: int): string {
  let body = numericBody(digits, weight, sign, dscale)
  let d = decodeNumeric(body, "amount") catch e {
    panic("decodeNumeric: ${e.message()}")
  }
  return toString(d)
}

test "9999.9999: no zero groups, weight 0" {
  // 9999 + .9999, two digit groups, neither zero.
  assert(
    mustDecode([]int{ 9999, 9999 }, 0, 0, 4) == "9999.9999",
    "digit-group boundary below the roll-over",
  )
}

test "10000.0001: an internal zero group is kept, not trimmed" {
  // 1*10000 + 0*1 + .0001: weight 1, three groups, the middle one zero.
  assert(
    mustDecode([]int{ 1, 0, 1 }, 1, 0, 4) == "10000.0001",
    "digit-group boundary above the roll-over",
  )
}

test "0.00001: a leading zero fractional group is implied, not stored" {
  // Postgres trims the all-zero group at position -1 and stores only
  // position -2 (value 1000), shifting weight to -2.
  assert(mustDecode([]int{ 1000 }, 0 - 2, 0, 5) == "0.00001", "implied leading zero group")
}

test "1.50: a trailing zero fractional group is implied, scale survives" {
  // dscale 8 asks for 8 fractional digits; only position -1 (5000) is
  // stored, position -2 is an implied trailing zero.
  assert(
    mustDecode([]int{ 1, 5000 }, 0, 0, 8) == "1.50000000",
    "implied trailing zero group keeps dscale",
  )
  assert(
    mustDecode([]int{ 1, 5000 }, 0, 0, 2) == "1.50",
    "dscale 2 keeps exactly one trailing zero",
  )
}

test "negative zero decodes without failing, and collapses to plain zero" {
  // decimal has no signed zero (verified against parseDecimal("-0.00")
  // directly); the codec must not choke on the sign bit either way.
  assert(
    mustDecode([]int(0), 0, 16384, 2) == "0.00",
    "negative zero, sign bit set, no stored digits",
  )
}

test "the maximum scale, 28, round-trips exactly" {
  // "1.9228162514264337593543950335": weight 0 (the "1" is a single
  // integer digit group), then 7 fractional groups of 4 digits each,
  // exactly covering scale 28.
  assert(
      mustDecode([]int{ 1, 9228, 1625, 1426, 4337, 5935, 4395, 335 }, 0, 0, 28) ==
      "1.9228162514264337593543950335",
    "scale 28",
  )
}

test "NaN, Infinity and -Infinity each fail naming the column and the condition" {
  let nanBody = numericBody([]int(0), 0, 49152, 0)
  decodeNumeric(nanBody, "amount") catch e {
    assert(contains(e.message(), "amount"), "NaN error names the column: ${e.message()}")
    assert(contains(e.message(), "NaN"), "NaN error names the condition: ${e.message()}")
    0
  }
  let infBody = numericBody([]int(0), 0, 53248, 0)
  decodeNumeric(infBody, "amount") catch e {
    assert(contains(e.message(), "amount"), "Infinity error names the column: ${e.message()}")
    assert(contains(e.message(), "Infinity"), "Infinity error names the condition: ${e.message()}")
    0
  }
  let ninfBody = numericBody([]int(0), 0, 61440, 0)
  decodeNumeric(ninfBody, "amount") catch e {
    assert(contains(e.message(), "amount"), "-Infinity error names the column: ${e.message()}")
    assert(
      contains(e.message(), "-Infinity"),
      "-Infinity error names the condition: ${e.message()}",
    )
    0
  }
}

test "a magnitude past decimal's 96-bit range errors naming the column, never rounds" {
  // 30 nines, one digit past decimal's 29-digit ceiling.
  let digits = []int{ 999, 9999, 9999, 9999, 9999, 9999, 9999, 9999 }
  decodeNumeric(numericBody(digits, 7, 0, 0), "amount") catch e {
    assert(contains(e.message(), "amount"), "overflow error names the column: ${e.message()}")
    0
  }
}

