fn rawConnect(uri: string): pgConn! {
  let a = newPgAdapter()
  let t = targetOf(Datasource{ uri = uri })?
  let (s, _) = openStream(t, a.warn, a.trustRoots()?)?
  let c = pgConn{ r = pgReader{ s = s, buf = "" }, s = s, closed = false, cache = newStmtCache(0) }
  startup(c.r, s, t, a.warn) catch e {
    s.shut()
    fail e
  }
  return c
}

// The binary body of one column of one row — `select $sql` is expected to
// return exactly one row, one column, non-NULL.
fn oneBinaryColumn(c: pgConn, sqlText: string): string! {
  let rows = queryBinary(c, sqlText, []Value(0))?
  if (len(rows) != 1 || len(rows[0]) != 1) {
    fail newError("expected one row of one column from '${sqlText}', got ${len(rows)} rows")
  }
  if (rows[0][0].isNull) {
    fail newError("'${sqlText}' returned NULL")
  }
  return rows[0][0].bytes
}

test "live: numeric — binary decode matches Postgres's own ::text for a 220-value corpus" {
  let uri = env("PG_TEST_TRUST_URI")
  if (uri == "") {
    print("  skipped: PG_TEST_TRUST_URI is unset, no live server to talk to")
    return
  }
  let c = rawConnect(uri) catch e {
    panic("rawConnect(${uri}): ${e.message()}")
  }
  let corpus = numericCorpus()
  assert(len(corpus) >= 200, "corpus has ${len(corpus)} entries, want at least 200")
  let i = 0
  while (i < len(corpus)) {
    let text = corpus[i]
    let sqlText = "select ${text}::numeric"
    let binBody = oneBinaryColumn(c, sqlText) catch e {
      panic("binary select of ${text}: ${e.message()}")
    }
    let fromBinary = decodeNumeric(binBody, "amount") catch e {
      panic("decodeNumeric(${text}): ${e.message()}")
    }
    let textRows = queryBinary(c, "select (${text}::numeric)::text", []Value(0)) catch e {
      panic("text select of ${text}: ${e.message()}")
    }
    let fromText = parseDecimal(textRows[0][0].bytes) catch e {
      panic("parseDecimal(server text of ${text}): ${e.message()}")
    }
    assert(
      toString(fromBinary) == toString(fromText),
      "${text}: binary decoded ${toString(fromBinary)}, server ::text was ${toString(fromText)}",
    )
    i = i + 1
  }
  c.close()
}
