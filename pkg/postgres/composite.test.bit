// pkg/postgres/composite.test.bit — json/jsonb and array round trips
// (#5452, epic #5449) proven against a real server.
//
// `row.test.bit` (#5457) already proves the ordinary case end to end: a
// populated int array, a jsonb tree, a jsonb document decoded into a class.
// This file proves the specific traps #5452's acceptance names that
// `row.test.bit` does not: byte-identical jsonb/json round trips for a
// document with a nested object, an array, a JSON null and an embedded
// quote; an empty array; a single-element array; an array containing a
// NULL element; and a text array element containing a comma and a brace.
// `composite.bit`'s own header explains why none of this needs a second
// decode path — `sqlReqJson`/`sqlReqArray`/`sqlElemInt`/`sqlElemText`
// (`std/sql`, already imported at module scope by `row.test.bit` except
// `sqlReqText`/`sqlElemText`, imported below) already do the work.
//
// Skipped when `PG_TEST_TRUST_URI` is unset, same convention as
// `live.test.bit`/`row.test.bit`.

import { sqlReqText, sqlElemText } from "std/sql"

fn composite5452Uri(): string {
  let uri = env("PG_TEST_TRUST_URI")
  if (uri == "") {
    print("  skipped: PG_TEST_TRUST_URI is unset, no live server to talk to")
  }
  return uri
}

test "live: a jsonb document with a nested object, an array, a JSON null and an embedded quote round-trips byte-identical, and the same document in a json column does too" {
  let uri = composite5452Uri()
  if (uri == "") {
    return
  }
  let a = newPgAdapter()
  let db = pool(a, Datasource{ uri = uri }) catch e {
    panic("pool: ${e.message()}")
  }
  db.exec("drop table if exists t5452json", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  db.exec(
    "create table t5452json (id int primary key, doc_jsonb jsonb, doc_json json)",
    []Value(0),
  ) catch e {
    panic("create: ${e.message()}")
  }
  // jsonb's own canonical spacing (a space after every `:` and `,`) —
  // written already in that form so both columns come back byte-identical:
  // `json` preserves whatever text is inserted, and `jsonb` normalizes TO
  // this shape regardless of the input's own spacing, so a compact input
  // would round-trip through `json` unchanged but get reformatted by
  // `jsonb`, failing the byte-identical claim for one column or the other.
  let doc = "{\"a\": {\"b\": 1, \"c\": [1, 2, null, \"x\\\"y\"]}, \"d\": null}"
  db.exec(
    "insert into t5452json (id, doc_jsonb, doc_json) values ($1, $2::jsonb, $3::json)",
    []Value{ Value.Int(1), Value.Text(doc), Value.Text(doc) },
  ) catch e {
    panic("insert: ${e.message()}")
  }
  let rows = db.query(
    "select doc_jsonb, doc_json from t5452json where id = $1", []Value{ Value.Int(1) },
  ) catch e {
    panic("select: ${e.message()}")
  }
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "no row")
  let cols = rows.columns()

  let jsonbText = sqlReqText(rows, cols, "doc_jsonb") catch e {
    panic("sqlReqText(doc_jsonb): ${e.message()}")
  }
  assert(jsonbText == doc, "jsonb round-trip: got '${jsonbText}', want '${doc}'")
  sqlReqJson(rows, cols, "doc_jsonb") catch e {
    panic("sqlReqJson(doc_jsonb): ${e.message()}")
  }

  let jsonText = sqlReqText(rows, cols, "doc_json") catch e {
    panic("sqlReqText(doc_json): ${e.message()}")
  }
  assert(jsonText == doc, "json round-trip: got '${jsonText}', want '${doc}'")
  sqlReqJson(rows, cols, "doc_json") catch e {
    panic("sqlReqJson(doc_json): ${e.message()}")
  }

  rows.close()
  db.exec("drop table t5452json", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  db.close()
}

test "live: an int array round-trips for the empty case, the single-element case, and one containing a NULL element" {
  let uri = composite5452Uri()
  if (uri == "") {
    return
  }
  let a = newPgAdapter()
  let db = pool(a, Datasource{ uri = uri }) catch e {
    panic("pool: ${e.message()}")
  }
  let rows = db.query(
    "select '{}'::int4[] as empty, '{7}'::int4[] as one, " + "'{1,NULL,3}'::int4[] as withnull",
    []Value(0),
  ) catch e {
    panic("select: ${e.message()}")
  }
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "no row")
  let cols = rows.columns()

  let empty = sqlReqArray<i64>(rows, cols, "empty", sqlElemInt) catch e {
    panic("sqlReqArray(empty): ${e.message()}")
  }
  assert(len(empty) == 0, "empty array decoded as len=${len(empty)}")

  let one = sqlReqArray<i64>(rows, cols, "one", sqlElemInt) catch e {
    panic("sqlReqArray(one): ${e.message()}")
  }
  assert(
    len(one) == 1 && one[0] == 7,
    "single-element array decoded as len=${len(one)}, [0]=${one[0]}",
  )

  sqlReqArray<i64>(rows, cols, "withnull", sqlElemInt) catch e {
    assert(contains(e.message(), "withnull"), "a NULL element names the column: ${e.message()}")
    rows.close()
    db.close()
    return
  }
  panic("an array with a NULL element must fail sqlElemInt (int has no NULL representation)")
}

test "live: a text array with an embedded comma and brace round-trips" {
  let uri = composite5452Uri()
  if (uri == "") {
    return
  }
  let a = newPgAdapter()
  let db = pool(a, Datasource{ uri = uri }) catch e {
    panic("pool: ${e.message()}")
  }
  let rows = db.query(
    "select array['a,b', 'c}d', 'plain']::text[] as vals", []Value(0),
  ) catch e {
    panic("select: ${e.message()}")
  }
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "no row")
  let cols = rows.columns()

  let vals = sqlReqArray<string>(rows, cols, "vals", sqlElemText) catch e {
    panic("sqlReqArray(vals): ${e.message()}")
  }
  assert(
    len(vals) == 3 && vals[0] == "a,b" && vals[1] == "c}d" && vals[2] == "plain",
    "text array decoded as len=${len(vals)}",
  )
  rows.close()
  db.close()
}

// The trap #5452's brief calls "the single most important case": a bare
// `NULL` token is the SQL NULL element (`Value.Null`, no decoder can turn
// it into a string), while a quoted `"NULL"` is the ordinary four-character
// string. A splitter that does not special-case the bare token before
// unquoting would decode both the same way.
test "live: a bare NULL array element is SQL NULL, a quoted \"NULL\" is the four-character string" {
  let uri = composite5452Uri()
  if (uri == "") {
    return
  }
  let a = newPgAdapter()
  let db = pool(a, Datasource{ uri = uri }) catch e {
    panic("pool: ${e.message()}")
  }
  let rows = db.query(
    "select '{NULL}'::text[] as bare, '{\"NULL\"}'::text[] as quoted", []Value(0),
  ) catch e {
    panic("select: ${e.message()}")
  }
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "no row")
  let cols = rows.columns()

  sqlReqArray<string>(rows, cols, "bare", sqlElemText) catch e {
    assert(
      contains(e.message(), "NULL"),
      "a bare NULL element must fail as SQL NULL, got: ${e.message()}",
    )
    let quoted = sqlReqArray<string>(rows, cols, "quoted", sqlElemText) catch e2 {
      panic("sqlReqArray(quoted): ${e2.message()}")
    }
    assert(
      len(quoted) == 1 && quoted[0] == "NULL",
      "quoted \"NULL\" must decode to the string NULL, got len=${len(quoted)}",
    )
    rows.close()
    db.close()
    return
  }
  panic("a bare NULL array element must fail sqlElemText (SQL NULL has no string form)")
}
