// pkg/postgres/wire.bit — the Postgres v3 frontend/backend protocol framing.
//
// Two message shapes exist on this wire. Every message the *backend* sends,
// and every one the frontend sends after the connection is up, is a one-byte
// tag followed by a four-byte big-endian length THAT COUNTS ITSELF but not
// the tag. The two messages sent before the connection exists — StartupMessage
// and SSLRequest — have no tag at all, because at that point the backend has
// not yet decided which protocol it is speaking.
//
// EVERYTHING IS BEHIND `pgStream`. A connection is a plain socket before the
// SSLRequest answer and a TLS connection after it, and the auth exchange is
// identical either way; a test drives the same code over a scripted transcript
// with no socket at all. That is one interface, not three copies of the framing.

import { Conn as NetConn } from "std/net"
import { TlsConn } from "std/tls"
import { monotonic } from "std/time"

// How long the rest of a message may take once its first bytes have arrived.
// A server that sent half a message and stalled is a lost connection, not a
// reason to park the reader forever.
const messageGraceNs: int = 30000000000

// How many bytes one wait reads. Any leftover stays in `pgReader.buf`.
const waitChunkBytes: int = 4096

// The v3 protocol version, 3.0 as a packed major/minor pair: 3 * 65536.
const protocolVersion: int = 196608

// The SSLRequest "version" — a reserved code point in the same field, which is
// how a v3 server tells the request apart from a startup packet.
const sslRequestCode: int = 80877103

// A byte source and sink. `readUp` returns at most `n` bytes and an empty
// string at end of stream (never a failure — a closed peer is a condition, not
// an error, exactly as `std/net.Conn.read` reports it); `writeAll` writes
// every byte or fails.
interface pgStream {
  readUp(n: int): string!,
  writeAll(s: string): ()!,
  shut(),
}

// A `pgStream` whose reads may be bounded: the
// listener (listen.bit) waits for the next message against a deadline and
// must tell "nothing arrived in time" from "the peer closed". Asked for by
// shape (`s.(pgDeadline)`, so it repeats `pgStream`'s methods: an assertion
// needs the target to satisfy the source) and a scripted stream that never
// times out need not implement it. `setDeadline` takes an absolute `std/time.monotonic()`
// nanosecond instant, `0` for none; `timedOut` is true when the most recent
// `readUp` returned empty because that deadline elapsed.
interface pgDeadline {
  readUp(n: int): string!,
  writeAll(s: string): ()!,
  shut(),
  setDeadline(ns: int),
  timedOut(): bool,
}

// `pgStream` over a cleartext socket.
class plainStream {
  c: NetConn
  readUp(n: int): string! {
    return this.c.read(n)
  }

  setDeadline(ns: int) {
    this.c.setDeadline(ns)
  }

  timedOut(): bool {
    return this.c.readTimedOut()
  }

  writeAll(s: string): ()! {
    this.c.write(s)?
  }

  shut() {
    this.c.close()
  }
}

// `pgStream` over a TLS connection, after `SSLRequest` was answered `S` and
// `std/tls.client` ran the handshake on the same socket.
class tlsStream {
  c: TlsConn
  readUp(n: int): string! {
    return string(this.c.read(n)?)
  }

  setDeadline(ns: int) {
    this.c.setDeadline(ns)
  }

  timedOut(): bool {
    return this.c.readTimedOut()
  }

  writeAll(s: string): ()! {
    this.c.write([]byte(s))?
  }

  shut() {
    this.c.close()
  }
}

// One backend message: its tag and its body, the body being everything after
// the four length bytes.
class pgMessage {
  tag: string,
  body: string,
}

// A framing reader over a `pgStream`. `buf` holds bytes pulled off the stream
// that the current message did not need — a single `read` can return any
// mixture of whole and partial messages, so the leftover has to live somewhere
// that outlives one call.
//
// ASYNCHRONOUS NOTIFICATIONS PASS THROUGH `next`. A NotificationResponse ('A')
// may arrive at any message boundary — between a CommandComplete and its
// ReadyForQuery, or while the connection is idle — so the one place every
// message goes through is the one place that can keep it. With `keep` set
// (a listener's own connection, listen.bit) `next` appends it to `notes` and
// still returns it, so every existing caller skips it exactly as it skips any
// tag it does not read. With `keep` unset (every pooled connection) it is
// dropped without error, and a pooled connection that ran `LISTEN` by hand
// cannot grow an unbounded queue nobody drains.
class pgReader {
  s: pgStream
  buf: string
  keep: bool = false
  notes: []Notification = []Notification(0)
  // Exactly `n` bytes. Fails if the peer closes first: the length prefix
  // promised them, so a short read is a truncated message, not an end of
  // stream.
  //
  // Bounded: every iteration either returns or adds at least one byte, so at
  // most `n` iterations.
  take(n: int): string! {
    let guard = 0
    while (len(this.buf) < n && guard <= n) {
      guard = guard + 1
      let chunk = this.s.readUp(n - len(this.buf))?
      if (len(chunk) == 0) {
        fail newError("postgres: server closed the connection mid-message")
      }
      this.buf = this.buf + chunk
    }
    let out = this.buf[0:n]
    this.buf = this.buf[n:len(this.buf)]
    return out
  }

  // The next message, or `None` if none began arriving before `deadlineNs`
  // (`std/time.monotonic()` nanoseconds). The deadline bounds only the wait
  // for a message's FIRST byte: once one is here the rest gets
  // `messageGraceNs`, so a timeout can never land mid-message and leave
  // `buf` split at an offset no later call could recover. A closed peer
  // fails, as it does in `take`. The stream must be a `pgDeadline`.
  nextWithin(deadlineNs: int): Option<pgMessage>! {
    let (d, ok) = this.s.(pgDeadline)
    if (!ok) {
      fail newError("postgres: this stream cannot bound a read")
    }
    if (len(this.buf) == 0) {
      d.setDeadline(deadlineNs)
      let chunk = this.s.readUp(waitChunkBytes)?
      if (len(chunk) == 0) {
        if (d.timedOut()) {
          return Option.None
        }
        fail newError("postgres: server closed the connection")
      }
      this.buf = chunk
    }
    d.setDeadline(monotonic().ns + messageGraceNs)
    let m = this.next()?
    d.setDeadline(0)
    return Option.Some(m)
  }

  // The next tagged message. A length below 4 does not even cover its own
  // field and is refused rather than used to size a slice.
  next(): pgMessage! {
    let tag = this.take(1)?
    let size = readBe32(this.take(4)?, 0)?
    if (size < 4) {
      fail newError("postgres: message '${tag}' declares a length of ${size}")
    }
    let m = pgMessage{ tag = tag, body = this.take(size - 4)? }
    if (tag == "A" && this.keep) {
      this.notes = append(this.notes, decodeNotification(m.body)?)
    }
    return m
  }
}

// A NotificationResponse body: the notifying backend's process ID (an Int32),
// the channel name and the payload, the two `\0`-terminated. The payload is
// empty, not absent, for a bare `NOTIFY chan`. Bytes after the payload's
// terminator mean the length field lied, so they fail rather than being read
// past.
fn decodeNotification(body: string): Notification! {
  let pid = readBe32(body, 0)?
  let (channel, next) = readCstr(body, 4)?
  let (payload, end) = readCstr(body, next)?
  if (end != len(body)) {
    fail newError("postgres: NotificationResponse has ${len(body) - end} bytes after the payload")
  }
  return Notification{ pid = pid, channel = channel, payload = payload }
}

// A four-byte big-endian integer.
fn be32(n: int): string {
  let b = []byte(4)
  b[0] = byte(n / 16777216 % 256)
  b[1] = byte(n / 65536 % 256)
  b[2] = byte(n / 256 % 256)
  b[3] = byte(n % 256)
  return string(b)
}

// A two-byte big-endian integer. The protocol's counts — parameters, columns,
// format codes — are all this width.
fn be16(n: int): string {
  let b = []byte(2)
  b[0] = byte(n / 256 % 256)
  b[1] = byte(n % 256)
  return string(b)
}

// The four-byte big-endian integer at `off`. Signed values do not occur in the
// fields this driver reads (lengths, auth codes, column counts), so the result
// is the plain unsigned value.
fn readBe32(s: string, off: int): int! {
  if (off + 4 > len(s)) {
    fail newError("postgres: truncated message: wanted 4 bytes at ${off}, " + "have ${len(s)}")
  }
  let b = []byte(s)
  return int(b[off]) * 16777216 + int(b[off + 1]) * 65536 + int(b[off + 2]) * 256 + int(b[off + 3])
}

// A NUL-terminated string, the protocol's only string framing. `[]byte(1)` is
// a one-element zero-filled slice, which is the NUL — Bit string literals
// carry no `\0` escape.
fn cstr(s: string): string {
  return s + string([]byte(1))
}

// The `\0`-terminated string starting at `off`, and the offset just past its
// terminator. An unterminated string fails rather than running to the end of
// the buffer.
fn readCstr(s: string, off: int): (string, int)! {
  let b = []byte(s)
  let i = off
  while (i < len(b)) {
    if (b[i] == 0) {
      return (s[off:i], i + 1)
    }
    i = i + 1
  }
  fail newError("postgres: unterminated string in a server message")
}

// A tagged frontend message: tag, then the length counting itself. Returned as
// bytes rather than written, because the extended protocol builds five of them
// into one write (query.bit).
fn frame(tag: string, body: string): string {
  return tag + be32(len(body) + 4) + body
}

// Send one tagged frontend message.
fn writeMessage(s: pgStream, tag: string, body: string): ()! {
  s.writeAll(frame(tag, body))?
}

// The StartupMessage: no tag, the protocol version, then `\0`-terminated
// key/value pairs closed by one more `\0`.
//
// `database` is omitted when empty, which makes the server default it to the
// user name — libpq's own rule, and what a URI with no path means.
fn startupMessage(user: string, database: string): string {
  let body = be32(protocolVersion) + cstr("user") + cstr(user)
  if (database != "") {
    body = body + cstr("database") + cstr(database)
  }
  body = body + string([]byte(1))
  return be32(len(body) + 4) + body
}

// The SSLRequest packet: a length of exactly 8 and the reserved code point.
// Sent before anything else on a fresh socket; the server answers with one
// bare byte, `S` (proceed with the handshake) or `N` (no TLS here).
fn sslRequestMessage(): string {
  return be32(8) + be32(sslRequestCode)
}
