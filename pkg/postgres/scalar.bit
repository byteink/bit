// pkg/postgres/scalar.bit — uuid, float4/float8 and bytea decoded from
// Postgres's own text rendering (#5451, epic #5449), sibling of
// `pkg/postgres/temporal.bit` (#5450, landed 3a0a45f7): same correction,
// same shape, same driver.
//
// TEXT, NOT BINARY. The ticket this shipped against assumed the binary wire
// format this file's callers would see — 16 raw uuid bytes, IEEE-754
// float4/float8, raw bytea — but `query.bit`'s `bindFrame` sends one
// `fmtText` result-format code for every column (`codec.bit`'s own header),
// so every value reaching this file is already `Value.Text`: a uuid is
// `00112233-4455-6677-8899-aabbccddeeff`, a float is Postgres's rendered
// number, and bytea is `\x`-prefixed hex under the default `bytea_output`.
// `queryBinary` (codec.bit) genuinely does request true binary, but only as
// this package's own decode-and-compare proof (numeric.test.bit,
// codec.test.bit) — nothing on the ordinary `Conn.query` path reaches it,
// confirmed independently twice (epic #5449, comment 1; #5421's
// `decodeNumeric` finding). This file therefore parses server text, like
// `temporal.bit`, not wire bytes, and needs no `queryBinary`.
//
// UUID MATCHES `pkg/mysql`'s SHAPE. `pgUuid`/`pgOptUuid` return
// `std/uuid.UUID` via `std/uuid.parse`, the same call `mysqlUuid` makes on
// MariaDB's native UUID text — one uuid vocabulary across drivers.
// `std/uuid.parse` is already case-insensitive (its hex-nibble reader
// accepts both cases), which is what this decoder needs: Postgres always
// renders lowercase but its input rule accepts either.
//
// FLOAT4/FLOAT8 AND BYTEA CANNOT "FEED sqlReqFloat/sqlReqBlob UNCHANGED",
// a deviation from this ticket's own text, recorded here and on #5451.
// Those accessors (stdlib/sql/row.bit) match only `Value.Float`/
// `Value.Blob`, and nothing on the ordinary decode path (`conn.bit`'s
// `decodeRow`) ever produces those variants for Postgres — every column is
// `Value.Text` regardless of its SQL type, the same fact that forced
// #5421's `sqlReqDecimal` to be a new accessor rather than reusing
// `sqlReqFloat`. Turning a `Value.Text` into `Value.Float`/`Value.Blob`
// before it reaches a generic accessor would mean editing `conn.bit` or
// `stdlib/sql/row.bit`, both outside this ticket's files (`Do not grow
// codec.bit`, "Your files are scalar.bit and scalar.test.bit"). So
// `pgFloat4`/`pgOptFloat4`/`pgFloat8`/`pgOptFloat8`/`pgBytea`/`pgOptBytea`
// below are driver-level accessors in `temporal.bit`'s/`mysqlUuid`'s shape
// — `(col, v) -> T!`/`Option<T>!` — returning the exact `f64`/`[]byte`
// types `sqlReqFloat`/`sqlReqBlob` already return, so calling code reads
// the same type regardless of which accessor produced it.
//
// BYTEA IS HEX-ONLY. Postgres's default `bytea_output` renders `\x` then
// lowercase hex; the legacy `escape` format (doubled backslashes, `\ooo`
// octal for non-printable bytes) is refused by name rather than guessed —
// the two formats share no marker a decoder could use to fall back safely,
// and silently reading one as the other produces plausible garbage, not a
// loud failure.
//
// FLOAT TEXT IS PARSED WITH THE PREDECLARED `parseFloat` (SPEC §5.3):
// correctly rounded (round-to-nearest-even on the exact value), so a value
// Postgres rendered with enough digits to round-trip exactly (its default
// `extra_float_digits`) comes back exactly, never truncated by a narrower
// parse. `Infinity`/`-Infinity`/`NaN` are checked before `parseFloat` runs,
// because `parseFloat`'s own failure sentinel IS a quiet NaN and could not
// otherwise be told apart from a genuine `NaN` column value.
//
// `pgText`/`pgIsNull` (temporal.bit) are reused rather than redeclared: a
// second `fn pgText`/`fn pgIsNull` here would be a duplicate declaration
// (SPEC §17.1, per-module declarations) — the same reason temporal.bit
// itself gives for not re-importing `std/sql`'s `asText`/`isNull`.

import { UUID, parse as parseUuid } from "std/uuid"

// uuid's own OID (`pg_type.typname = 'uuid'`). `oidFloat4`/`oidFloat8`
// already exist in `codec.bit`; `oidBytea` in `query.bit` — neither
// repeated here, and this ticket does not grow `codec.bit` further.
export const oidUuid: int = 2950

// `uuid`: Postgres's canonical `8-4-4-4-12` hex text, case-insensitive on
// input, same as `pkg/mysql`'s `mysqlUuid`.
export fn pgUuid(col: string, v: Value): UUID! {
  let s = pgText(v, col, "uuid")?
  return parseUuid(s) catch e {
    fail newError("postgres: column ${col}: ${e.message()}")
  }
}

// As `pgUuid`, but a SQL NULL decodes to `None` rather than failing.
export fn pgOptUuid(col: string, v: Value): Option<UUID>! {
  if (pgIsNull(v)) {
    return Option<UUID>.None
  }
  return Option<UUID>.Some(pgUuid(col, v)?)
}

// `float4` (`real`).
export fn pgFloat4(col: string, v: Value): f64! {
  let s = pgText(v, col, "float4")?
  return pgParseFloatText(s, col, "float4")?
}

// As `pgFloat4`, but a SQL NULL decodes to `None` rather than failing.
export fn pgOptFloat4(col: string, v: Value): Option<f64>! {
  if (pgIsNull(v)) {
    return Option<f64>.None
  }
  return Option<f64>.Some(pgFloat4(col, v)?)
}

// `float8` (`double precision`).
export fn pgFloat8(col: string, v: Value): f64! {
  let s = pgText(v, col, "float8")?
  return pgParseFloatText(s, col, "float8")?
}

// As `pgFloat8`, but a SQL NULL decodes to `None` rather than failing.
export fn pgOptFloat8(col: string, v: Value): Option<f64>! {
  if (pgIsNull(v)) {
    return Option<f64>.None
  }
  return Option<f64>.Some(pgFloat8(col, v)?)
}

// `s` (a float4 or float8 column's rendered text) as the `f64` it denotes.
// Shared by `pgFloat4`/`pgFloat8`: the parse itself does not depend on the
// column's declared width, only the error message does.
fn pgParseFloatText(s: string, col: string, kind: string): f64! {
  if (s == "Infinity") {
    return 1.0 / 0.0
  }
  if (s == "-Infinity") {
    return 0.0 - 1.0 / 0.0
  }
  if (s == "NaN") {
    return 0.0 / 0.0
  }
  let v = parseFloat(s)
  if (v != v) {
    fail newError("postgres: column ${col}: '${s}' is not a valid ${kind} value")
  }
  return v
}

// `bytea`.
export fn pgBytea(col: string, v: Value): []byte! {
  let s = pgText(v, col, "bytea")?
  return pgParseBytea(s, col)?
}

// As `pgBytea`, but a SQL NULL decodes to `None` rather than failing.
export fn pgOptBytea(col: string, v: Value): Option<[]byte>! {
  if (pgIsNull(v)) {
    return Option<[]byte>.None
  }
  return Option<[]byte>.Some(pgBytea(col, v)?)
}

// `\x`-prefixed lowercase hex, Postgres's default `bytea_output`. Any other
// leading bytes — including the legacy `escape` format — are refused by
// name; see the header comment.
fn pgParseBytea(s: string, col: string): []byte! {
  if (len(s) < 2 || s[0] != 0x5c || s[1] != 0x78) {
    fail newError(
        "postgres: column ${col}: bytea is not in \\x hex form — this driver " +
        "requires the default bytea_output=hex, not the legacy escape format",
    )
  }
  let hex = s[2:len(s)]
  if (len(hex) % 2 != 0) {
    fail newError("postgres: column ${col}: bytea hex has an odd digit count")
  }
  let out = []byte(len(hex) / 2)
  let i = 0
  while (i < len(hex)) {
    let hi = pgHexNibble(hex[i], col)?
    let lo = pgHexNibble(hex[i + 1], col)?
    out[i / 2] = hi * 16 + lo
    i = i + 2
  }
  return out
}

// The value 0..15 of hex digit `c`, lowercase or uppercase. Fails on
// anything else, naming `col`.
fn pgHexNibble(c: u8, col: string): u8! {
  if (c >= 48 && c <= 57) {
    return c - 48
  }
  if (c >= 97 && c <= 102) {
    return c - 97 + 10
  }
  if (c >= 65 && c <= 70) {
    return c - 65 + 10
  }
  fail newError("postgres: column ${col}: invalid bytea hex digit")
}
