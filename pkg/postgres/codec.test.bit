// pkg/postgres/codec.test.bit — the fixed-width scalar decoders (codec.bit),
// offline: each is a plain big-endian integer or a single byte, so a
// hand-built body is enough to pin the shape (#3989). `decodeNumeric`'s own
// proof lives in numeric.test.bit; `queryBinary` is exercised there too,
// against a live server.

fn be(width: int, v: int): string {
  let u = v
  if (u < 0) {
    u = u + pow256(width)
  }
  let b = []byte(width)
  let i = width - 1
  while (i >= 0) {
    b[i] = byte(u % 256)
    u = u / 256
    i = i - 1
  }
  return string(b)
}

fn pow256(width: int): int {
  let p = 1
  let i = 0
  while (i < width) {
    p = p * 256
    i = i + 1
  }
  return p
}

test "int2 decodes a signed 2-byte big-endian value, positive and negative" {
  let v = decodeInt2(be(2, 12345), "n") catch e {
    panic("decodeInt2: ${e.message()}")
  }
  assert(v == 12345, "int2 12345 decoded as ${v}")
  let neg = decodeInt2(be(2, 0 - 1), "n") catch e {
    panic("decodeInt2: ${e.message()}")
  }
  assert(neg == 0 - 1, "int2 -1 decoded as ${neg}")
}

test "int4 decodes a signed 4-byte big-endian value" {
  let v = decodeInt4(be(4, 2147483647), "n") catch e {
    panic("decodeInt4: ${e.message()}")
  }
  assert(v == 2147483647, "int4 max decoded as ${v}")
  let neg = decodeInt4(be(4, 0 - 2147483648), "n") catch e {
    panic("decodeInt4: ${e.message()}")
  }
  assert(neg == 0 - 2147483648, "int4 min decoded as ${neg}")
}

test "int8 decodes a signed 8-byte big-endian value" {
  let v = decodeInt8(be(8, 9223372036854775807), "n") catch e {
    panic("decodeInt8: ${e.message()}")
  }
  assert(v == 9223372036854775807, "int8 max decoded as ${v}")
}

test "bool decodes exactly one byte, 0 or 1, and rejects anything else" {
  let t = decodeBool(string([]byte{ 1 }), "flag") catch e {
    panic("decodeBool(1): ${e.message()}")
  }
  assert(t, "byte 1 decoded false")
  let f = decodeBool(string([]byte{ 0 }), "flag") catch e {
    panic("decodeBool(0): ${e.message()}")
  }
  assert(!f, "byte 0 decoded true")
  decodeBool(string([]byte{ 2 }), "flag") catch e {
    assert(contains(e.message(), "flag"), "bad bool byte names the column: ${e.message()}")
    false
  }
  decodeBool("", "flag") catch e {
    assert(contains(e.message(), "flag"), "empty bool body names the column: ${e.message()}")
    false
  }
}

test "text passes the bytes through unchanged, binary format equalling text" {
  let v = decodeText("hello world", "name") catch e {
    panic("decodeText: ${e.message()}")
  }
  assert(v == "hello world", "text roundtrip produced ${v}")
}

test "a timestamp without time zone column is refused, naming the column and timestamptz" {
  refuseTimestamp("created_at") catch e {
    assert(contains(e.message(), "created_at"), "refusal names the column: ${e.message()}")
    assert(contains(e.message(), "timestamptz"), "refusal names the fix: ${e.message()}")
  }
}

test "a truncated int4 body fails naming the column rather than reading past it" {
  decodeInt4(string([]byte{ 1, 2 }), "n") catch e {
    assert(contains(e.message(), "n"), "truncated int4 names the column: ${e.message()}")
    0
  }
}
