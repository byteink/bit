// pkg/postgres/temporal.test.bit — `decodeDate`/`decodeTime`/
// `decodeTimestamp`/`decodeTimestamptz` (temporal.bit), proven two ways
// (#5450), same split as numeric.test.bit:
//
// FIRST, OFFLINE: hand-built wire bodies with an INDEPENDENTLY computed
// expected value — the pgEpoch-to-Unix-epoch offset (946684800 seconds) is
// restated here from the ticket's own number, not read off `temporal.bit`,
// so a wrong offset in the implementation cannot also be wrong the same way
// in the test. Every timestamp/timestamptz case includes one before
// 2000-01-01: a Unix-epoch mistake (treating the wire micros as already
// relative to 1970) still produces a plausible-looking date for a value
// after 2000, but a value before 2000 lands about 30 years further wrong,
// which these fixed expected values catch either way.
//
// SECOND, LIVE: one row, every column, read back through `decodeDate`
// through `decodeTimestamptz` against a real server and compared to the
// literal values the row was inserted with — `uses to_timestamp(seconds)`
// with an exact binary fraction (`.5`, `.25`) so the expected nanoseconds
// are plain integer arithmetic, never a float rounding question. Skipped
// when `PG_TEST_TRUST_URI` is unset, same convention as `live.test.bit`
// and `numeric.test.bit`.

// `pgEpoch` (2000-01-01T00:00:00Z) as Unix seconds — restated, not
// imported, per the file header.
const testPgEpochUnixSeconds: int = 946684800

// A `Date`/`Time`/`Timestamp` value for the unused arm of an expected-failure
// `catch`, where discarding the result still leaves the `catch` block's own
// type to satisfy. `date(1, 1, 1)`, `timeNs(0, 0, 0, 0)` and `pgEpoch` cannot
// actually fail, so a failure here is a broken invariant, not something a
// test should handle.
fn dummyDate(): Date {
  return date(1, 1, 1) catch e {
    panic("dummyDate: ${e.message()}")
  }
}

fn dummyTime(): Time {
  return timeNs(0, 0, 0, 0) catch e {
    panic("dummyTime: ${e.message()}")
  }
}

fn dummyTimestamp(): Timestamp {
  return pgEpoch().toTimestamp() catch e {
    panic("dummyTimestamp: ${e.message()}")
  }
}

// An 8-byte signed big-endian encoding of `v`, negative values included.
// `codec.test.bit`'s own `be`/`pow256` build the two's-complement form by
// adding `256^width` to a negative value first, which overflows a signed
// 64-bit int at `width == 8` (`256^8 == 2^64`) and was never exercised at
// that width by any existing test. This shifts and truncates instead —
// `byte(v >> shift)` keeps only the low 8 bits of the (correctly
// sign-extended) shifted value, so it never forms an intermediate
// magnitude bigger than `v` itself.
fn be8(v: int): string {
  let b = []byte(8)
  let i = 7
  while (i >= 0) {
    b[i] = byte(v >> (8 * (7 - i)))
    i = i - 1
  }
  return string(b)
}

test "decodeDate: the wire epoch itself, one day either side, and a leap-year year boundary" {
  let epoch = decodeDate(be(4, 0), "d") catch e {
    panic("decodeDate(0): ${e.message()}")
  }
  assert(
    epoch.year() == 2000 && epoch.month() == 1 && epoch.day() == 1,
    "epoch decoded as ${epoch.toString()}",
  )

  let dayAfter = decodeDate(be(4, 1), "d") catch e {
    panic("decodeDate(1): ${e.message()}")
  }
  assert(dayAfter.toString() == "2000-01-02", "epoch+1 decoded as ${dayAfter.toString()}")

  let dayBefore = decodeDate(be(4, 0 - 1), "d") catch e {
    panic("decodeDate(-1): ${e.message()}")
  }
  assert(dayBefore.toString() == "1999-12-31", "epoch-1 decoded as ${dayBefore.toString()}")

  // 2000 is a leap year (366 days), so day 366 past the epoch is the next
  // January 1st, not December 31st.
  let nextYear = decodeDate(be(4, 366), "d") catch e {
    panic("decodeDate(366): ${e.message()}")
  }
  assert(nextYear.toString() == "2001-01-01", "epoch+366 decoded as ${nextYear.toString()}")

  decodeDate("", "d") catch e {
    assert(contains(e.message(), "d"), "truncated date names the column: ${e.message()}")
    dummyDate()
  }
}

test "decodeTime: midnight, an ordinary clock reading, sub-second precision, the max valid value, and out-of-range rejection" {
  let midnight = decodeTime(be(8, 0), "t") catch e {
    panic("decodeTime(0): ${e.message()}")
  }
  assert(midnight.toString() == "00:00:00", "midnight decoded as ${midnight.toString()}")

  // 3661 seconds = 1h 1m 1s.
  let ordinary = decodeTime(be(8, 3661000000), "t") catch e {
    panic("decodeTime(3661s): ${e.message()}")
  }
  assert(ordinary.toString() == "01:01:01", "3661s decoded as ${ordinary.toString()}")

  // 45296.789123s = 12:34:56.789123 — a decoder that truncates microseconds
  // reads this as 12:34:56 with no fraction.
  let subSecond = decodeTime(be(8, 45296789123), "t") catch e {
    panic("decodeTime(sub-second): ${e.message()}")
  }
  assert(
      subSecond.hour() == 12 &&
      subSecond.minute() == 34 &&
      subSecond.second() == 56 &&
      subSecond.nanosecond() == 789123000,
    "sub-second decoded as ${subSecond.toString()}",
  )

  let lastMicro = decodeTime(be(8, 86399999999), "t") catch e {
    panic("decodeTime(max): ${e.message()}")
  }
  assert(lastMicro.toString() == "23:59:59.999999000", "max decoded as ${lastMicro.toString()}")

  decodeTime(be(8, 86400000000), "t") catch e {
    assert(contains(e.message(), "t"), "one full day out of range names the column: ${e.message()}")
    dummyTime()
  }
  decodeTime(be8(0 - 1), "t") catch e {
    assert(contains(e.message(), "t"), "negative time names the column: ${e.message()}")
    dummyTime()
  }
  decodeTime("", "t") catch e {
    assert(contains(e.message(), "t"), "truncated time names the column: ${e.message()}")
    dummyTime()
  }
}

test "decodeTimestamp: the wire epoch, a sub-second value before 2000-01-01, and one day past the epoch" {
  let atEpoch = decodeTimestamp(be(8, 0), "ts") catch e {
    panic("decodeTimestamp(0): ${e.message()}")
  }
  assert(
    atEpoch.ns == testPgEpochUnixSeconds * 1000000000,
    "epoch decoded as ${atEpoch.ns}ns, wanted ${testPgEpochUnixSeconds * 1000000000}",
  )

  // -500000 microseconds is 1999-12-31T23:59:59.5Z: half a second before
  // 2000-01-01, sub-second precision AND before the epoch in one value.
  let preEpoch = decodeTimestamp(be8(0 - 500000), "ts") catch e {
    panic("decodeTimestamp(pre-epoch): ${e.message()}")
  }
  let wantPre = (testPgEpochUnixSeconds - 1) * 1000000000 + 500000000
  assert(preEpoch.ns == wantPre, "pre-epoch decoded as ${preEpoch.ns}ns, wanted ${wantPre}")

  // One day and one microsecond past the epoch.
  let pastEpoch = decodeTimestamp(be(8, 86400000001), "ts") catch e {
    panic("decodeTimestamp(past-epoch): ${e.message()}")
  }
  let wantPast = (testPgEpochUnixSeconds + 86400) * 1000000000 + 1000
  assert(pastEpoch.ns == wantPast, "past-epoch decoded as ${pastEpoch.ns}ns, wanted ${wantPast}")

  decodeTimestamp("", "ts") catch e {
    assert(contains(e.message(), "ts"), "truncated timestamp names the column: ${e.message()}")
    dummyTimestamp()
  }
}

test "decodeTimestamptz: identical bytes to decodeTimestamp, sub-second and before 2000-01-01" {
  let preEpoch = decodeTimestamptz(be8(0 - 500000), "tstz") catch e {
    panic("decodeTimestamptz(pre-epoch): ${e.message()}")
  }
  let wantPre = (testPgEpochUnixSeconds - 1) * 1000000000 + 500000000
  assert(preEpoch.ns == wantPre, "pre-epoch decoded as ${preEpoch.ns}ns, wanted ${wantPre}")

  decodeTimestamptz("", "tstz") catch e {
    assert(contains(e.message(), "tstz"), "truncated timestamptz names the column: ${e.message()}")
    dummyTimestamp()
  }
}

// One row, `date`/`time`/`timestamp`/`timestamptz` together, inserted with
// literal casts and `to_timestamp` so the expected values are plain
// arithmetic, then read back through `queryBinary` and every decoder in
// this file — Postgres's own encoder is the oracle, not this package.
test "live: date, time, timestamp and timestamptz round-trip a row, including a value before 2000-01-01" {
  let uri = liveUri("PG_TEST_TRUST_URI")
  if (uri == "") {
    return
  }
  let c = rawConnect(uri) catch e {
    panic("rawConnect(${uri}): ${e.message()}")
  }
  // Every session starts on the server's own default TimeZone, which is not
  // guaranteed to be UTC; pinned here so `to_timestamp(...)::timestamp`'s
  // wall-clock reading is deterministic, the same reason MySQL's adapter
  // pins `time_zone` at connect (codec.bit's header).
  c.exec("set time zone 'UTC'", []Value(0)) catch e {
    panic("set time zone: ${e.message()}")
  }
  c.exec("drop table if exists t5450temporal", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.exec(
    "create table t5450temporal (d date, t time, ts timestamp, tstz timestamptz)",
    []Value(0),
  ) catch e {
    panic("create: ${e.message()}")
  }
  c.exec(
      "insert into t5450temporal (d, t, ts, tstz) values (" +
      "'1999-12-25'::date, '12:34:56.789123'::time, " +
      "to_timestamp(946684799.5)::timestamp, to_timestamp(1758113696.25))",
    []Value(0),
  ) catch e {
    panic("insert: ${e.message()}")
  }
  let rows = queryBinary(c, "select d, t, ts, tstz from t5450temporal", []Value(0)) catch e {
    panic("select: ${e.message()}")
  }
  assert(
    len(rows) == 1 && len(rows[0]) == 4,
    "expected one row of 4 columns, got ${len(rows)}x${len(rows[0])}",
  )
  checkLiveDate(rows[0][0].bytes)
  checkLiveTime(rows[0][1].bytes)
  checkLiveTimestamp(rows[0][2].bytes)
  checkLiveTimestamptz(rows[0][3].bytes)
  c.exec("drop table t5450temporal", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.close()
}

fn checkLiveDate(body: string) {
  let d = decodeDate(body, "d") catch e {
    panic("live decodeDate: ${e.message()}")
  }
  assert(d.toString() == "1999-12-25", "live date decoded as ${d.toString()}")
}

fn checkLiveTime(body: string) {
  let t = decodeTime(body, "t") catch e {
    panic("live decodeTime: ${e.message()}")
  }
  assert(
    t.hour() == 12 && t.minute() == 34 && t.second() == 56 && t.nanosecond() == 789123000,
    "live time decoded as ${t.toString()}",
  )
}

fn checkLiveTimestamp(body: string) {
  let ts = decodeTimestamp(body, "ts") catch e {
    panic("live decodeTimestamp: ${e.message()}")
  }
  let want = 946684799 * 1000000000 + 500000000
  assert(
    ts.ns == want,
    "live timestamp decoded as ${ts.ns}ns, wanted ${want} (1999-12-31T23:59:59.5Z)",
  )
}

fn checkLiveTimestamptz(body: string) {
  let tstz = decodeTimestamptz(body, "tstz") catch e {
    panic("live decodeTimestamptz: ${e.message()}")
  }
  let want = 1758113696 * 1000000000 + 250000000
  assert(tstz.ns == want, "live timestamptz decoded as ${tstz.ns}ns, wanted ${want}")
}
