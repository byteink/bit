// pkg/postgres/temporal.test.bit — `pgDate`/`pgTime`/`pgTimestamp`/
// `pgInstant` (temporal.bit), proven two ways (#5450), same split as
// `pkg/mysql/decimal.test.bit`:
//
// FIRST, OFFLINE: hand-built `Value.Text` cases pinning the ISO text shape
// Postgres actually sends — variable-width fractional seconds (none, one
// digit, six digits), and `pgInstant`'s zone-offset arithmetic checked by
// comparing two DIFFERENT text renderings of the SAME real instant, never
// by re-deriving a Unix timestamp by hand.
//
// SECOND, LIVE: one row, every column, read back through the ORDINARY
// `Pool`/`Rows` path — never `queryBinary` (that path is binary-only and
// architecturally unreachable from a real caller here, `temporal.bit`'s
// own header) — with the session `TimeZone` set to a non-UTC zone so the
// `timestamptz` column actually renders with a non-zero offset, proving
// the offset arithmetic against the server's own rendering rather than a
// UTC-only case. Skipped when `PG_TEST_TRUST_URI` is unset, same
// convention as `live.test.bit`.

test "pgDate: an ISO date, a year needing zero-padding, a non-ISO string, and infinity" {
  let d = pgDate("d", Value.Text("2026-09-17")) catch e {
    panic("pgDate: ${e.message()}")
  }
  assert(d.year() == 2026 && d.month() == 9 && d.day() == 17, "decoded as ${d.toString()}")

  let padded = pgDate("d", Value.Text("0100-01-01")) catch e {
    panic("pgDate(padded): ${e.message()}")
  }
  assert(padded.year() == 100, "zero-padded year decoded as ${padded.year()}")

  pgDate("d", Value.Text("09/17/2026")) catch e {
    assert(contains(e.message(), "d"), "non-ISO date names the column: ${e.message()}")
    dummyDate()
  }
  pgDate("d", Value.Text("infinity")) catch e {
    assert(contains(e.message(), "d"), "infinity names the column: ${e.message()}")
    dummyDate()
  }
}

test "pgOptDate: NULL decodes to None, a value decodes to Some" {
  let none = pgOptDate("d", Value.Null) catch e {
    panic("pgOptDate(NULL): ${e.message()}")
  }
  assert(isNoneDate(none), "NULL decoded as Some")

  let some = pgOptDate("d", Value.Text("2026-09-17")) catch e {
    panic("pgOptDate: ${e.message()}")
  }
  assert(!isNoneDate(some), "a value decoded as None")
}

test "pgTime: no fractional part, one digit, six digits, and a malformed body" {
  let whole = pgTime("t", Value.Text("12:34:56")) catch e {
    panic("pgTime(whole): ${e.message()}")
  }
  assert(
    whole.hour() == 12 && whole.minute() == 34 && whole.second() == 56 && whole.nanosecond() == 0,
    "whole-second decoded as ${whole.toString()}",
  )

  let oneDigit = pgTime("t", Value.Text("12:34:56.1")) catch e {
    panic("pgTime(1 digit): ${e.message()}")
  }
  assert(oneDigit.nanosecond() == 100000000, "0.1s decoded as ${oneDigit.nanosecond()}ns")

  let sixDigit = pgTime("t", Value.Text("12:34:56.123456")) catch e {
    panic("pgTime(6 digits): ${e.message()}")
  }
  assert(sixDigit.nanosecond() == 123456000, "0.123456s decoded as ${sixDigit.nanosecond()}ns")

  pgTime("t", Value.Text("12:34")) catch e {
    assert(contains(e.message(), "t"), "truncated time names the column: ${e.message()}")
    dummyTime()
  }
  pgTime("t", Value.Text("12:34:56.")) catch e {
    assert(contains(e.message(), "t"), "empty fraction names the column: ${e.message()}")
    dummyTime()
  }
}

test "pgTimestamp: date and time combined, and a value with no time of day" {
  let ts = pgTimestamp("ts", Value.Text("2026-09-17 12:34:56.5")) catch e {
    panic("pgTimestamp: ${e.message()}")
  }
  let wall = ts.inZone(utc())
  assert(
      wall.year() == 2026 &&
      wall.month() == 9 &&
      wall.day() == 17 &&
      wall.hour() == 12 &&
      wall.minute() == 34 &&
      wall.second() == 56 &&
      wall.time().nanosecond() == 500000000,
    "decoded as ${ts.toString()}",
  )

  pgTimestamp("ts", Value.Text("2026-09-17")) catch e {
    assert(contains(e.message(), "ts"), "date with no time names the column: ${e.message()}")
    dummyTimestamp()
  }
}

test "pgInstant: a UTC offset and an equivalent non-UTC offset name the same instant" {
  let atUtc = pgInstant("tstz", Value.Text("2024-01-15 10:30:00.123456+00")) catch e {
    panic("pgInstant(+00): ${e.message()}")
  }
  let atPlus530 = pgInstant("tstz", Value.Text("2024-01-15 16:00:00.123456+05:30")) catch e {
    panic("pgInstant(+05:30): ${e.message()}")
  }
  assert(
    atUtc.ns == atPlus530.ns,
    "+00 gave ${atUtc.ns}ns, +05:30 gave ${atPlus530.ns}ns for the same instant",
  )

  let atMinus530 = pgInstant("tstz", Value.Text("2024-01-15 05:00:00.123456-05:30")) catch e {
    panic("pgInstant(-05:30): ${e.message()}")
  }
  assert(
    atUtc.ns == atMinus530.ns,
    "+00 gave ${atUtc.ns}ns, -05:30 gave ${atMinus530.ns}ns for the same instant",
  )

  // A rare seconds-in-offset zone (Postgres emits this for a handful of
  // pre-1883 zones): the offset carries the wall clock back across a day
  // boundary, checked against an equivalent +00 rendering of that same
  // earlier instant.
  let withSeconds = pgInstant("tstz", Value.Text("2024-01-01 00:00:00+00:00:15")) catch e {
    panic("pgInstant(+00:00:15): ${e.message()}")
  }
  let equivalent = pgInstant("tstz", Value.Text("2023-12-31 23:59:45+00")) catch e {
    panic("pgInstant(equivalent): ${e.message()}")
  }
  assert(
    withSeconds.ns == equivalent.ns,
    "+00:00:15 gave ${withSeconds.ns}ns, the equivalent +00 rendering gave ${equivalent.ns}ns",
  )

  pgInstant("tstz", Value.Text("2024-01-15 10:30:00.123456")) catch e {
    assert(contains(e.message(), "tstz"), "a missing offset names the column: ${e.message()}")
    dummyTimestamp()
  }
}

fn isNoneDate(o: Option<Date>): bool {
  match (o) {
    None => return true
    Some(_) => return false
  }
}

fn dummyDate(): Date {
  return date(1, 1, 1) catch e {
    panic("dummyDate: ${e.message()}")
  }
}

fn dummyTime(): Time {
  return timeNs(0, 0, 0, 0) catch e {
    panic("dummyTime: ${e.message()}")
  }
}

fn dummyTimestamp(): Timestamp {
  // 2000-01-01, not `dummyDate`'s 0001-01-01: `Timestamp.ns` is int64
  // nanoseconds since the Unix epoch, and year 1 is before what that range
  // can represent (`toTimestamp`'s own range check).
  let d = date(2000, 1, 1) catch e {
    panic("dummyTimestamp: ${e.message()}")
  }
  return d.atStartOfDay(utc()).toTimestamp() catch e {
    panic("dummyTimestamp: ${e.message()}")
  }
}

// One row, `date`/`time`/`timestamp`/`timestamptz` together, inserted with
// literal casts and `to_timestamp`, then read back through the ORDINARY
// TEXT-protocol `Conn.query`/`Rows` path (`conn.bit`'s `query`, the same
// method a pooled connection uses) — never `queryBinary`, which is
// binary-only and architecturally unreachable from a real caller
// (`temporal.bit`'s own header). One raw connection (`rawConnect`, shared
// with `numeric.test.bit`, same module) rather than a `Pool`, so the
// session zone pinned below is guaranteed to apply to every statement
// that follows it — a `Pool` could hand a later call a different physical
// connection with no such pin. The session's `TimeZone` is set to a
// non-UTC zone first, so the `timestamptz` column actually renders with a
// `+05:30` offset rather than `+00`, exercising the non-UTC branch of
// `pgInstant`'s offset parsing.
test "live: date, time, timestamp and timestamptz round-trip a row through the ordinary Rows path, with a non-UTC session zone" {
  let uri = liveUri("PG_TEST_TRUST_URI")
  if (uri == "") {
    return
  }
  let c = rawConnect(uri) catch e {
    panic("rawConnect(${uri}): ${e.message()}")
  }
  c.exec("set time zone 'Asia/Kolkata'", []Value(0)) catch e {
    panic("set time zone: ${e.message()}")
  }
  c.exec("drop table if exists t5450temporal", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.exec(
    "create table t5450temporal (d date, t time, ts timestamp, tstz timestamptz)",
    []Value(0),
  ) catch e {
    panic("create: ${e.message()}")
  }
  c.exec(
      "insert into t5450temporal (d, t, ts, tstz) values (" +
      "'2026-09-17'::date, '12:34:56.123456'::time, " +
      "'1999-12-25 08:15:30.5'::timestamp, to_timestamp(1758113696.25))",
    []Value(0),
  ) catch e {
    panic("insert: ${e.message()}")
  }
  let rows = c.query("select d, t, ts, tstz from t5450temporal", []Value(0)) catch e {
    panic("select: ${e.message()}")
  }
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "no row")
  checkLiveDate(rows.value(0))
  checkLiveTime(rows.value(1))
  checkLiveTimestamp(rows.value(2))
  checkLiveInstant(rows.value(3))
  rows.close()
  c.exec("drop table t5450temporal", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.close()
}

fn checkLiveDate(v: Value) {
  let d = pgDate("d", v) catch e {
    panic("live pgDate: ${e.message()}")
  }
  assert(d.toString() == "2026-09-17", "live date decoded as ${d.toString()}")
}

fn checkLiveTime(v: Value) {
  let t = pgTime("t", v) catch e {
    panic("live pgTime: ${e.message()}")
  }
  assert(
    t.hour() == 12 && t.minute() == 34 && t.second() == 56 && t.nanosecond() == 123456000,
    "live time decoded as ${t.toString()}",
  )
}

// A plain `timestamp` column's stored value is unaffected by the session's
// `TimeZone` — only `timestamptz` rendering uses it — so this is still the
// exact wall clock inserted, `Asia/Kolkata` notwithstanding.
fn checkLiveTimestamp(v: Value) {
  let ts = pgTimestamp("ts", v) catch e {
    panic("live pgTimestamp: ${e.message()}")
  }
  let wall = ts.inZone(utc())
  assert(
      wall.year() == 1999 &&
      wall.month() == 12 &&
      wall.day() == 25 &&
      wall.hour() == 8 &&
      wall.minute() == 15 &&
      wall.second() == 30 &&
      wall.time().nanosecond() == 500000000,
    "live timestamp decoded as ${ts.toString()}",
  )
}

fn checkLiveInstant(v: Value) {
  let instant = pgInstant("tstz", v) catch e {
    panic("live pgInstant: ${e.message()}")
  }
  let want = 1758113696 * 1000000000 + 250000000
  assert(instant.ns == want, "live timestamptz decoded as ${instant.ns}ns, wanted ${want}")
}
