// pkg/postgres/uri.test.bit — `Datasource` in, `target` out (#3987).
//
// Nothing here opens a socket: `targetOf` is a pure function of the
// configuration, which is exactly why the strictness rules — an unrecognised
// `sslmode` rejected rather than defaulted, an explicit one recorded as a pin
// — can be pinned without a server.

fn mustTarget(uri: string): target {
  return targetOf(Datasource{ uri: uri }) catch e {
    panic("targetOf(${uri}): ${e.message()}")
  }
}

fn refuses(uri: string): string {
  let t = targetOf(Datasource{ uri: uri }) catch e {
    return e.message()
  }
  panic("targetOf(${uri}) was accepted, host ${t.host}")
}

test "parses a full postgres:// URI" {
  let t = mustTarget("postgres://app:pw@db.internal:6543/erp")
  assert(t.host == "db.internal", "host: ${t.host}")
  assert(t.port == 6543, "port: ${t.port}")
  assert(t.user == "app", "user: ${t.user}")
  assert(t.password == "pw", "password: ${t.password}")
  assert(t.database == "erp", "database: ${t.database}")
  assert(!t.pinned, "no sslmode was written, so nothing is pinned")
}

test "postgresql:// is the same scheme" {
  let a = mustTarget("postgres://app:pw@localhost:5432/dev")
  let b = mustTarget("postgresql://app:pw@localhost:5432/dev")
  assert(a.host == b.host && a.port == b.port && a.user == b.user,
    "postgresql:// parsed differently from postgres://")
  assert(b.database == "dev", "database: ${b.database}")
}

test "a URI with no port takes 5432" {
  let t = mustTarget("postgres://app@localhost/dev")
  assert(t.port == defaultPort, "port: ${t.port}")
}

test "port 0 in the field form takes 5432, identically to the uri form" {
  let byField = targetOf(Datasource{
    host: "localhost", user: "app", database: "dev",
  }) catch e {
    panic(e.message())
  }
  let byUri = mustTarget("postgres://app@localhost/dev")
  assert(byField.port == defaultPort, "field port: ${byField.port}")
  assert(byField.port == byUri.port, "the two forms disagree on the port")
  assert(byField.host == byUri.host && byField.user == byUri.user,
    "the two forms disagree on host or user")
  assert(!byField.pinned, "an omitted sslmode field is not a pin")
}

test "every accepted sslmode spelling is a pin" {
  let cases = ["disable", "require", "verify-ca", "verify-full"]
  let want = [SslMode.Disable, SslMode.Require, SslMode.VerifyCa, SslMode.VerifyFull]
  let i = 0
  while (i < len(cases)) {
    let t = mustTarget("postgres://app@localhost/dev?sslmode=${cases[i]}")
    assert(t.mode == want[i], "sslmode=${cases[i]} parsed to ${sslModeName(t.mode)}")
    assert(t.pinned, "sslmode=${cases[i]} must be a pin")
    i = i + 1
  }
}

test "an unrecognised sslmode value is rejected, not defaulted" {
  let msg = refuses("postgres://app@localhost/dev?sslmode=verify-fulll")
  assert(contains(msg, "unrecognised sslmode value 'verify-fulll'"),
    "message: ${msg}")
}

test "libpq's prefer and allow are rejected by the same line" {
  assert(contains(refuses("postgres://a@h/d?sslmode=prefer"), "unrecognised"),
    "prefer was accepted")
  assert(contains(refuses("postgres://a@h/d?sslmode=allow"), "unrecognised"),
    "allow was accepted")
}

test "a non-postgres scheme is refused by scheme" {
  let msg = refuses("mysql://app@localhost/dev")
  assert(contains(msg, "must start with postgres://"), "message: ${msg}")
}

test "an unsupported query parameter fails naming itself" {
  let msg = refuses("postgres://app@localhost/dev?application_name=x")
  assert(contains(msg, "'application_name' is not supported"), "message: ${msg}")
}

test "a percent-escaped password survives the parse" {
  let t = mustTarget("postgres://app:p%40ss%2Fword@localhost/dev")
  assert(t.password == "p@ss/word", "password: ${t.password}")
}

test "a broken percent-escape fails rather than being passed through" {
  let msg = refuses("postgres://app:p%zz@localhost/dev")
  assert(contains(msg, "percent-escape"), "message: ${msg}")
}

test "a non-numeric or out-of-range port fails" {
  assert(contains(refuses("postgres://a@h:5432x/d"), "not a number"),
    "a non-numeric port was accepted")
  assert(contains(refuses("postgres://a@h:70000/d"), "out of range"),
    "an out-of-range port was accepted")
}

test "a URI naming no host is refused" {
  assert(contains(refuses("postgres:///dev"), "names no host"),
    "a hostless URI was accepted")
}
