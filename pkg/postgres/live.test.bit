// pkg/postgres/live.test.bit — the acceptance that needs a real server (#3987).
//
// EACH TEST IS SKIPPED WHEN ITS URI IS UNSET, and says so. `test-package-postgres`
// runs on a machine with no database, so a hard dependency on one would make
// the gate unrunnable; the URIs are supplied by whoever has a server, one per
// authentication method:
//
//   PG_TEST_TRUST_URI     pg_hba.conf: trust
//   PG_TEST_SCRAM_URI     pg_hba.conf: scram-sha-256
//   PG_TEST_MD5_URI       pg_hba.conf: md5
//   PG_TEST_PASSWORD_URI  pg_hba.conf: password (cleartext)
//   PG_TEST_TLS_URI       ssl=on with a SELF-SIGNED certificate
//
// `pkg/postgres/README.md` has the four `docker run` lines that produce them.
//
// The adapter is built with `newPgAdapter` rather than `adapter()` so these can
// read `warn.sslLines`/`warn.authLines` — the counts ARE the claim "one warning
// line per pool, not one per connection", and an `Adapter` has no fields.

import { pool, Pool, asText } from "std/sql"
import { env } from "std/os"

// The URI under `name`, or "" — printed once so a skipped run is visible as a
// skip rather than as a silent pass.
fn liveUri(name: string): string {
  let uri = env(name)
  if (uri == "") {
    print("  skipped: ${name} is unset, no live server to talk to")
  }
  return uri
}

// Open a pool, run `select 1` `times` times, and assert every run returned the
// single row `1`. Returns the adapter so the caller can read its warn counts.
fn selectOne(uri: string, times: int): pgAdapter {
  let a = newPgAdapter()
  let db = pool(a, Datasource{ uri: uri }) catch e {
    panic("pool(${uri}): ${e.message()}")
  }
  let i = 0
  while (i < times) {
    checkOne(db.query("select 1", []Value(0)) catch e {
      panic("select 1 (attempt ${i}): ${e.message()}")
    })
    i = i + 1
  }
  db.close()
  return a
}

// Exactly one row, one column, the text `1`.
fn checkOne(rows: Rows) {
  let more = rows.next() catch e {
    panic("select 1 returned no row: ${e.message()}")
  }
  assert(more, "select 1 returned no row")
  let got = asText(rows.value(0)) catch e {
    panic("select 1 column 0: ${e.message()}")
  }
  assert(got == "1", "select 1 returned '${got}'")
  rows.close()
}

test "live: a stock Postgres with no TLS connects, and warns once for ten connections" {
  let uri = liveUri("PG_TEST_TRUST_URI")
  if (uri == "") {
    return
  }
  let a = selectOne(uri, 10)
  assert(a.warn.sslLines == 1,
    "ten connections emitted ${a.warn.sslLines} sslmode warning lines")
  assert(a.warn.authLines == 1,
    "ten connections emitted ${a.warn.authLines} auth warning lines")
}

// The failure `select 1` produced, or "" if it succeeded. A helper because a
// `catch` on a value-producing call has to divert (E0067).
fn queryError(db: Pool): string {
  let rows = db.query("select 1", []Value(0)) catch e {
    return e.message()
  }
  rows.close()
  return ""
}

test "live: sslmode=verify-full against a server with no TLS fails rather than downgrading" {
  let uri = liveUri("PG_TEST_TRUST_URI")
  if (uri == "") {
    return
  }
  let db = pool(newPgAdapter(), Datasource{ uri: "${uri}?sslmode=verify-full" }) catch e {
    panic("pool: ${e.message()}")
  }
  let err = queryError(db)
  db.close()
  assert(contains(err, "sslmode=verify-full"), "the failure does not name the pin: ${err}")
  assert(contains(err, "answered the SSLRequest with N"),
    "the failure does not name what the server did: ${err}")
}

test "live: scram-sha-256 connects and warns about nothing but the TLS mode" {
  let uri = liveUri("PG_TEST_SCRAM_URI")
  if (uri == "") {
    return
  }
  let a = selectOne(uri, 3)
  assert(a.warn.authLines == 0,
    "scram-sha-256 emitted ${a.warn.authLines} auth warning lines")
}

test "live: md5 connects and warns once" {
  let uri = liveUri("PG_TEST_MD5_URI")
  if (uri == "") {
    return
  }
  let a = selectOne(uri, 3)
  assert(a.warn.authLines == 1, "md5 emitted ${a.warn.authLines} auth warning lines")
}

test "live: cleartext password connects and warns once" {
  let uri = liveUri("PG_TEST_PASSWORD_URI")
  if (uri == "") {
    return
  }
  let a = selectOne(uri, 3)
  assert(a.warn.authLines == 1,
    "cleartext password emitted ${a.warn.authLines} auth warning lines")
}

test "live: a self-signed certificate connects at require and warns once naming it" {
  let uri = liveUri("PG_TEST_TLS_URI")
  if (uri == "") {
    return
  }
  let a = selectOne(uri, 3)
  assert(a.warn.sslLines == 1,
    "three connections emitted ${a.warn.sslLines} sslmode warning lines")
  assert(contains(a.warn.sslLine, "sslmode=require"),
    "the warning does not name require: ${a.warn.sslLine}")
}

test "live: sslmode=verify-full against a self-signed certificate fails" {
  let uri = liveUri("PG_TEST_TLS_URI")
  if (uri == "") {
    return
  }
  let db = pool(newPgAdapter(), Datasource{ uri: "${uri}?sslmode=verify-full" }) catch e {
    panic("pool: ${e.message()}")
  }
  let err = queryError(db)
  db.close()
  assert(err != "", "verify-full accepted a self-signed certificate")
}

test "live: the field form with port 0 connects identically to the uri form" {
  let uri = liveUri("PG_TEST_TRUST_URI")
  if (uri == "") {
    return
  }
  let t = targetOf(Datasource{ uri: uri }) catch e {
    panic(e.message())
  }
  if (t.port != defaultPort) {
    print("  skipped: the live server is on ${t.port}, not 5432")
    return
  }
  let db = pool(newPgAdapter(), Datasource{
    host: t.host, user: t.user, password: t.password, database: t.database,
  }) catch e {
    panic("pool by fields: ${e.message()}")
  }
  checkOne(db.query("select 1", []Value(0)) catch e {
    panic("select 1 by fields: ${e.message()}")
  })
  db.close()
}
