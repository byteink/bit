// pkg/postgres/row.test.bit — `std/sql`'s `sqlReqDecimal`/`sqlOptDecimal`
// (#5421) proven end to end against a real server: a `numeric` column,
// inserted through the ordinary parameterised `query` path (never
// `queryBinary`, numeric.bit's own proof harness) and read back through the
// accessor, the same route any caller of this package takes. This is
// deliberately NOT `decodeNumeric` — Postgres's normal query path always
// requests text (codec.bit's own header comment), so a `numeric` column
// reaches `Rows.value` as `Value.Text` and the accessor's job is exactly
// `pkg/mysql`'s `mysqlDecimal`: `asText` then `parseDecimal`, no binary
// decode involved.
//
// Skipped when `PG_TEST_TRUST_URI` is unset, same convention as
// `live.test.bit`/`numeric.test.bit`.

import { sqlReqDecimal, sqlOptDecimal } from "std/sql"

fn row5421Uri(): string {
  let uri = env("PG_TEST_TRUST_URI")
  if (uri == "") {
    print("  skipped: PG_TEST_TRUST_URI is unset, no live server to talk to")
  }
  return uri
}

test "live: sqlReqDecimal/sqlOptDecimal reach a numeric column end to end" {
  let uri = row5421Uri()
  if (uri == "") {
    return
  }
  let a = newPgAdapter()
  let db = pool(a, Datasource{ uri: uri }) catch e {
    panic("pool: ${e.message()}")
  }
  db.exec("drop table if exists t5421dec", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  db.exec(
    "create table t5421dec (id int primary key, amount numeric(12,4), refunded numeric(12,4))",
    []Value(0),
  ) catch e {
    panic("create: ${e.message()}")
  }
  db.exec(
    "insert into t5421dec (id, amount, refunded) values ($1, $2, $3)",
    []Value{ Value.Int(1), Value.Text("1234.5678"), Value.Null },
  ) catch e {
    panic("insert: ${e.message()}")
  }
  let rows = db.query(
    "select amount, refunded from t5421dec where id = $1", []Value{ Value.Int(1) },
  ) catch e {
    panic("select: ${e.message()}")
  }
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "no row")
  let cols = rows.columns()
  let amount = sqlReqDecimal(rows, cols, "amount") catch e {
    panic("sqlReqDecimal: ${e.message()}")
  }
  assert(toString(amount) == "1234.5678", "amount decoded as '${toString(amount)}'")
  let refunded = sqlOptDecimal(rows, cols, "refunded") catch e {
    panic("sqlOptDecimal: ${e.message()}")
  }
  assert(!isSome(refunded), "a SQL NULL must decode to None, got Some")
  rows.close()
  db.exec("drop table t5421dec", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  db.close()
}
