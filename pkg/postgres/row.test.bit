// pkg/postgres/row.test.bit — `std/sql`'s `sqlReqDecimal`/`sqlOptDecimal`
// (#5421) proven end to end against a real server: a `numeric` column,
// inserted through the ordinary parameterised `query` path (never
// `queryBinary`, numeric.bit's own proof harness) and read back through the
// accessor, the same route any caller of this package takes. This is
// deliberately NOT `decodeNumeric` — Postgres's normal query path always
// requests text (codec.bit's own header comment), so a `numeric` column
// reaches `Rows.value` as `Value.Text` and the accessor's job is exactly
// `pkg/mysql`'s `mysqlDecimal`: `asText` then `parseDecimal`, no binary
// decode involved.
//
// #5456 ADDS `sqlReqInt`/`sqlReqFloat`/`sqlReqBool`/`sqlReqBlob` below, the
// bug this file is named for: `decodeRow` (conn.bit) used to wrap every
// Postgres column as `Value.Text`, so those four accessors — which match
// only `Value.Int`/`Value.Float`/`Value.Blob` — failed on every column,
// always. `decodeRow` now types a column from its OID; the mapped-OID test
// proves the four accessors work directly, and the unmapped-OID test proves
// the fallback the fix depends on: a type this driver has never heard of
// still arrives as `Value.Text` and does not error.
//
// Skipped when `PG_TEST_TRUST_URI` is unset, same convention as
// `live.test.bit`/`numeric.test.bit`.

import { sqlReqDecimal, sqlOptDecimal, sqlReqInt, sqlReqFloat, sqlReqBool, sqlReqBlob } from "std/sql"

fn row5421Uri(): string {
  let uri = env("PG_TEST_TRUST_URI")
  if (uri == "") {
    print("  skipped: PG_TEST_TRUST_URI is unset, no live server to talk to")
  }
  return uri
}

test "live: sqlReqDecimal/sqlOptDecimal reach a numeric column end to end" {
  let uri = row5421Uri()
  if (uri == "") {
    return
  }
  let a = newPgAdapter()
  let db = pool(a, Datasource{ uri: uri }) catch e {
    panic("pool: ${e.message()}")
  }
  db.exec("drop table if exists t5421dec", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  db.exec(
    "create table t5421dec (id int primary key, amount numeric(12,4), refunded numeric(12,4))",
    []Value(0),
  ) catch e {
    panic("create: ${e.message()}")
  }
  db.exec(
    "insert into t5421dec (id, amount, refunded) values ($1, $2, $3)",
    []Value{ Value.Int(1), Value.Text("1234.5678"), Value.Null },
  ) catch e {
    panic("insert: ${e.message()}")
  }
  let rows = db.query(
    "select amount, refunded from t5421dec where id = $1", []Value{ Value.Int(1) },
  ) catch e {
    panic("select: ${e.message()}")
  }
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "no row")
  let cols = rows.columns()
  let amount = sqlReqDecimal(rows, cols, "amount") catch e {
    panic("sqlReqDecimal: ${e.message()}")
  }
  assert(toString(amount) == "1234.5678", "amount decoded as '${toString(amount)}'")
  let refunded = sqlOptDecimal(rows, cols, "refunded") catch e {
    panic("sqlOptDecimal: ${e.message()}")
  }
  assert(!isSome(refunded), "a SQL NULL must decode to None, got Some")
  rows.close()
  db.exec("drop table t5421dec", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  db.close()
}

test "live: sqlReqInt/sqlReqFloat/sqlReqBool/sqlReqBlob each read their column type" {
  let uri = row5421Uri()
  if (uri == "") {
    return
  }
  let a = newPgAdapter()
  let db = pool(a, Datasource{ uri: uri }) catch e {
    panic("pool: ${e.message()}")
  }
  let rows = db.query(
    "select $1::int4 as n, $2::float8 as f, $3::bool as ok, $4::bytea as raw",
    []Value{ Value.Int(42), Value.Float(3.5), Value.Text("t"), Value.Blob([]byte{ 0x68, 0x69 }) },
  ) catch e {
    panic("select: ${e.message()}")
  }
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "no row")
  let cols = rows.columns()
  let n = sqlReqInt(rows, cols, "n") catch e {
    panic("sqlReqInt: ${e.message()}")
  }
  assert(n == 42, "n (int4) decoded as ${n}")
  let f = sqlReqFloat(rows, cols, "f") catch e {
    panic("sqlReqFloat: ${e.message()}")
  }
  assert(f == 3.5, "f (float8) decoded as ${f}")
  let ok = sqlReqBool(rows, cols, "ok") catch e {
    panic("sqlReqBool: ${e.message()}")
  }
  assert(ok, "ok (bool) decoded as false")
  let raw = sqlReqBlob(rows, cols, "raw") catch e {
    panic("sqlReqBlob: ${e.message()}")
  }
  assert(string(raw) == "hi", "raw (bytea) decoded as '${string(raw)}'")
  rows.close()
  db.close()
}

// #5456's fallback guarantee: `inet` has no dedicated converter and is not
// on `decodeRow`'s mapped-OID list, so it must still decode as `Value.Text`
// — `asText` itself is the assertion, since it fails on every other variant.
test "live: an OID this driver does not map still arrives as Text and does not error" {
  let uri = row5421Uri()
  if (uri == "") {
    return
  }
  let a = newPgAdapter()
  let db = pool(a, Datasource{ uri: uri }) catch e {
    panic("pool: ${e.message()}")
  }
  let rows = db.query("select '10.0.0.1'::inet as addr", []Value(0)) catch e {
    panic("select: ${e.message()}")
  }
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "no row")
  let addr = asText(rows.value(0)) catch e {
    panic("an unmapped OID did not fall back to Text: ${e.message()}")
  }
  assert(addr == "10.0.0.1", "unmapped OID column decoded as '${addr}'")
  rows.close()
  db.close()
}
