// pkg/postgres/conn.bit — the `std/sql.Conn` an authenticated session becomes.
//
// EVERY STATEMENT TAKES THE EXTENDED PROTOCOL (query.bit), parameters or not.
// The simple query protocol has no field a parameter could travel in, so using
// it for anything the caller supplied a value for would mean building the SQL
// text around that value; running it for the parameterless case too would be a
// second code path whose only merit is saving a message on `select 1`.
//
// VALUES COME BACK IN THE PROTOCOL'S TEXT FORMAT, so every non-NULL column
// arrives as server-rendered text. `decodeRow` (#5456) types it from the
// column's OID — `Value.Int` for int2/int4/int8, `Value.Float` for
// float4/float8, `Value.Int(0/1)` for bool (`stdlib/sql/row.bit` has no
// separate boolean wire type), `Value.Blob` for bytea, reusing the same text
// parsers `scalar.bit`'s `pgFloat4`/`pgFloat8`/`pgBytea` are built on rather
// than a second copy of them. AN OID NOT ON THAT LIST — including
// timestamp/date/time/uuid/numeric, which keep their own dedicated
// text-expecting converters — FALLS BACK TO `Value.Text`, unconditionally:
// `decodeRow` cannot fail on a column type it does not recognize, only on a
// malformed wire response for one it does.
//
// `begin` STILL FAILS. Transactions are the rest of epic #3986: `std/sql` runs
// them through a closure (stdlib/sql/tx.bit) and a half-working `begin` would
// be worse than one that says so.

// The column length a DataRow uses for SQL NULL: -1, read out of an unsigned
// four-byte field.
const nullColumn: int = 4294967295

// One physical connection, idle at `ReadyForQuery`.
class pgConn {
  r: pgReader
  s: pgStream
  closed: bool
  // The named statements this connection is holding. Per connection, never
  // shared, and empty unless `Datasource.statementCache` asked for it
  // (stmtcache.bit).
  cache: stmtCache
  // A statement expected to produce rows.
  //
  // A failure BELOW the write is a `transportError` — `std/sql`'s marker for
  // "do not hand this connection out again" (stdlib/sql/config.bit) — because
  // the message stream is then at an unknown offset. A failure the SERVER
  // reported is not: the batch's `Sync` means the exchange ended at
  // `ReadyForQuery` and the connection is as usable as it was before.
  query(sqlText: string, params: []Value): Rows! {
    if (this.closed) {
      fail transportError("query on a closed connection")
    }
    return runExtended(this, sqlText, params)?.rows
  }

  // A statement expected only to change rows. The count comes from the
  // server's own CommandComplete tag, never from counting anything here.
  exec(sqlText: string, params: []Value): int! {
    if (this.closed) {
      fail transportError("exec on a closed connection")
    }
    return runExtended(this, sqlText, params)?.affected
  }

  // A statement handle. It holds the text, not a server-side name — see
  // `pgStmt` (query.bit).
  prepare(sqlText: string): Stmt! {
    if (this.closed) {
      fail transportError("prepare on a closed connection")
    }
    return pgStmt{ c: this, text: sqlText }
  }

  begin(): Tx! {
    fail newError("postgres: begin is not implemented yet (epic #3986)")
  }

  // Best effort: tell the server we are going (`Terminate`), then drop the
  // socket. A write failure here is ignored — the socket is being closed
  // either way and `Conn.close` cannot report anything. The cache goes with
  // the connection; a statement name means nothing without it.
  close() {
    if (this.closed) {
      return
    }
    this.closed = true
    writeMessage(this.s, "X", "") catch _ {
      this.s.shut()
      return
    }
    this.s.shut()
  }
}

// `RowDescription`: a two-byte field count, then per field a `\0`-terminated
// name and eighteen bytes of type information, of which this driver reads the
// four that are the type OID (bytes 6..10: the table OID and the column's
// attribute number come first). The OID is what #3989's decoder will dispatch
// on, and reading it here is why `Describe` is in every batch.
//
// Bounded by the field count the server declared.
fn describeColumns(body: string): []pgColumn! {
  let count = readBe16(body, 0)?
  let out = []pgColumn(0)
  let off = 2
  let i = 0
  while (i < count) {
    let (name, next) = readCstr(body, off)?
    out = append(out, pgColumn{ name: name, oid: readBe32(body, next + 6)? })
    off = next + 18
    i = i + 1
  }
  return out
}

// `DataRow`: a two-byte column count, then per column a four-byte length and
// that many bytes. A length of -1 is SQL NULL and carries no bytes at all —
// the distinction `Value.Null` exists to keep, and the one an empty string
// would erase.
//
// `cols` is the `RowDescription` `Describe` already returned for this
// statement — the extended protocol's own order (Parse/Bind/Describe/
// Execute/Sync) puts it before any `DataRow`, so it is populated by the time
// this runs. An index past `cols` (a response shorter than expected) types
// that column as if its OID were unknown: `Value.Text`, never a failure.
fn decodeRow(body: string, cols: []pgColumn): []Value! {
  let count = readBe16(body, 0)?
  let out = []Value(0)
  let off = 2
  let i = 0
  while (i < count) {
    let size = readBe32(body, off)?
    off = off + 4
    if (size == nullColumn) {
      out = append(out, Value.Null)
      i = i + 1
      continue
    }
    if (off + size > len(body)) {
      fail newError("postgres: DataRow column ${i} runs past the message")
    }
    let col = columnAt(cols, i)
    out = append(out, valueForColumn(col.oid, col.name, body[off:off + size])?)
    off = off + size
    i = i + 1
  }
  return out
}

// `cols[i]`, or a name-less, OID-less column when `i` is out of range —
// `valueForColumn` reads an unmapped OID as `Value.Text`, so this is where
// "the RowDescription was short" and "the OID is genuinely unmapped" fall
// back to the same, always-safe behaviour.
fn columnAt(cols: []pgColumn, i: int): pgColumn {
  if (i < len(cols)) {
    return cols[i]
  }
  return pgColumn{ name: "", oid: -1 }
}

// `text`, the server's rendering of column `col` typed `oid`, as the `Value`
// its SQL type denotes. See the header comment for the mapped OIDs and the
// fallback guarantee. `pgParseFloatText`/`pgParseBytea` (scalar.bit) are
// reused rather than redeclared (SPEC §17.1, per-module declarations) — the
// same text parse `pgFloat4`/`pgFloat8`/`pgBytea` already prove.
fn valueForColumn(oid: int, col: string, text: string): Value! {
  if (oid == oidInt2 || oid == oidInt4 || oid == oidInt8) {
    let n = parseInt(text) catch e {
      fail newError("postgres: column ${col}: ${e.message()}")
    }
    return Value.Int(n)
  }
  if (oid == oidFloat4 || oid == oidFloat8) {
    return Value.Float(pgParseFloatText(text, col, "float")?)
  }
  if (oid == oidBool) {
    return Value.Int(pgParseBoolText(text, col)?)
  }
  if (oid == oidBytea) {
    return Value.Blob(pgParseBytea(text, col)?)
  }
  return Value.Text(text)
}

// Postgres's text rendering of `bool`: exactly `t` or `f`. `stdlib/sql/row.bit`
// has no `Value.Bool` variant (SQL itself has no universal one), so this
// returns 0/1 the way `sqlReqBool`/`sqlOptBool` already read an `Int` column.
fn pgParseBoolText(text: string, col: string): int! {
  if (text == "t") {
    return 1
  }
  if (text == "f") {
    return 0
  }
  fail newError("postgres: column ${col}: bool value '${text}' is neither 't' nor 'f'")
}

// A two-byte big-endian integer. Only unsigned counts are read with it.
fn readBe16(s: string, off: int): int! {
  if (off + 2 > len(s)) {
    fail newError("postgres: truncated message: wanted 2 bytes at ${off}, " + "have ${len(s)}")
  }
  let b = []byte(s)
  return int(b[off]) * 256 + int(b[off + 1])
}

// A materialized result set. `Execute` was sent with no row limit, so the
// whole response is already in memory by the time `query` returns: `next` is a
// walk over rows already read, and `close` has nothing to release.
class pgRows {
  cols: []pgColumn
  rows: [][]Value
  at: int
  next(): bool! {
    this.at = this.at + 1
    return this.at < len(this.rows)
  }

  columns(): []string {
    let out = []string(0)
    for c of this.cols {
      out = append(out, c.name)
    }
    return out
  }

  // The PostgreSQL type OID of each column, in the same order as `columns`.
  // Not part of `std/sql.Rows` — a caller that wants it asks for the shape:
  //
  //     interface TypedRows { oids(): []int }
  //
  // which is how #3989's codec will reach it, and how this package's own
  // tests assert what the server said a column is.
  oids(): []int {
    let out = []int(0)
    for c of this.cols {
      out = append(out, c.oid)
    }
    return out
  }

  value(col: int): Value {
    if (this.at < 0 || this.at >= len(this.rows)) {
      return Value.Null
    }
    let row = this.rows[this.at]
    if (col < 0 || col >= len(row)) {
      return Value.Null
    }
    return row[col]
  }

  close() {}
}
