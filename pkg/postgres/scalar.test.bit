// pkg/postgres/scalar.test.bit — `pgUuid`/`pgFloat4`/`pgFloat8`/`pgBytea`
// (scalar.bit), proven two ways (#5451), same split as
// `pkg/postgres/temporal.test.bit` (#5450):
//
// FIRST, OFFLINE: hand-built `Value.Text` cases pinning the text shapes
// Postgres actually sends — a lowercase and an uppercase uuid, ordinary
// and `Infinity`/`-Infinity`/`NaN` float text, `\x`-hex bytea and the
// legacy `escape` format refused by name — plus every `SQL NULL -> None`
// case.
//
// SECOND, LIVE: one row, every column, read back through the ORDINARY
// `pgConn.query` text-protocol path — never `queryBinary`, architecturally
// unreachable from a real caller (scalar.bit's own header) — proving a
// uuid with non-palindromic bytes, a float8 whose decimal form is long
// enough to expose precision loss, and a bytea containing 0x00 and a
// non-UTF8 byte all round-trip exactly. `rawConnect`/`liveUri` are reused
// from numeric.test.bit/live.test.bit (same module), not redeclared.

import { equals, nilUUID } from "std/uuid"

test "pgUuid decodes canonical text, case-insensitively, and refuses malformed text" {
  let lower = pgUuid("ucol", Value.Text("00112233-4455-6677-8899-aabbccddeeff")) catch e {
    panic("pgUuid(lower): ${e.message()}")
  }
  let upper = pgUuid("ucol", Value.Text("00112233-4455-6677-8899-AABBCCDDEEFF")) catch e {
    panic("pgUuid(upper): ${e.message()}")
  }
  assert(equals(lower, upper), "the same uuid in upper and lower hex decoded unequal")

  pgUuid("ucol", Value.Text("not-a-uuid")) catch e {
    assert(contains(e.message(), "ucol"), "malformed uuid names the column: ${e.message()}")
    nilUUID()
  }
}

test "pgOptUuid: SQL NULL decodes to None, a value decodes to Some" {
  let none = pgOptUuid("ucol", Value.Null) catch e {
    panic("pgOptUuid(NULL): ${e.message()}")
  }
  assert(!isSome(none), "NULL uuid must decode to None")
  let some = pgOptUuid("ucol", Value.Text("00112233-4455-6677-8899-aabbccddeeff")) catch e {
    panic("pgOptUuid: ${e.message()}")
  }
  assert(isSome(some), "a real uuid must decode to Some")
}

test "pgFloat4/pgFloat8 decode ordinary decimal text and the three special tokens" {
  let f4 = pgFloat4("f4col", Value.Text("3.5")) catch e {
    panic("pgFloat4: ${e.message()}")
  }
  assert(f4 == 3.5, "float4 '3.5' decoded as ${f4}")

  let f8 = pgFloat8("f8col", Value.Text("0.12345678901234567")) catch e {
    panic("pgFloat8: ${e.message()}")
  }
  assert(f8 == parseFloat("0.12345678901234567"), "float8 lost precision: ${f8}")

  let posInf = pgFloat8("f8col", Value.Text("Infinity")) catch e {
    panic("pgFloat8(Infinity): ${e.message()}")
  }
  assert(posInf > 1.0e300, "Infinity did not decode as a large positive value: ${posInf}")

  let negInf = pgFloat8("f8col", Value.Text("-Infinity")) catch e {
    panic("pgFloat8(-Infinity): ${e.message()}")
  }
  assert(negInf < 0.0 - 1.0e300, "-Infinity did not decode as a large negative value: ${negInf}")

  let nan = pgFloat8("f8col", Value.Text("NaN")) catch e {
    panic("pgFloat8(NaN): ${e.message()}")
  }
  assert(nan != nan, "NaN did not decode as a NaN value")

  pgFloat8("f8col", Value.Text("not-a-number")) catch e {
    assert(contains(e.message(), "f8col"), "bad float text names the column: ${e.message()}")
    0.0
  }
}

test "pgOptFloat4/pgOptFloat8: SQL NULL decodes to None, a value decodes to Some" {
  let none4 = pgOptFloat4("f4col", Value.Null) catch e {
    panic("pgOptFloat4(NULL): ${e.message()}")
  }
  assert(!isSome(none4), "NULL float4 must decode to None")
  let none8 = pgOptFloat8("f8col", Value.Null) catch e {
    panic("pgOptFloat8(NULL): ${e.message()}")
  }
  assert(!isSome(none8), "NULL float8 must decode to None")
}

test "pgBytea decodes \\x hex and refuses anything else" {
  let b = pgBytea("bcol", Value.Text("\\x00ff48656c6c6f")) catch e {
    panic("pgBytea: ${e.message()}")
  }
  let want = []byte{ 0x00, 0xff, 0x48, 0x65, 0x6c, 0x6c, 0x6f }
  assert(string(b) == string(want), "bytea hex decoded to the wrong bytes")

  let empty = pgBytea("bcol", Value.Text("\\x")) catch e {
    panic("pgBytea(empty): ${e.message()}")
  }
  assert(len(empty) == 0, "empty bytea decoded to ${len(empty)} bytes")

  pgBytea("bcol", Value.Text("Hello world")) catch e {
    assert(
      contains(e.message(), "bcol") && contains(e.message(), "escape"),
      "escape-format bytea is refused by name: ${e.message()}",
    )
    []byte(0)
  }
  pgBytea("bcol", Value.Text("\\x0")) catch e {
    assert(contains(e.message(), "bcol"), "odd hex digit count names the column: ${e.message()}")
    []byte(0)
  }
  pgBytea("bcol", Value.Text("\\xzz")) catch e {
    assert(contains(e.message(), "bcol"), "invalid hex digit names the column: ${e.message()}")
    []byte(0)
  }
}

test "pgOptBytea: SQL NULL decodes to None, a value decodes to Some" {
  let none = pgOptBytea("bcol", Value.Null) catch e {
    panic("pgOptBytea(NULL): ${e.message()}")
  }
  assert(!isSome(none), "NULL bytea must decode to None")
}

// One row, `uuid`/`float4`/`float8`/`bytea` together, inserted with literal
// casts (never a bound parameter, so the exact server text this asserts
// against is controlled by the literal, not by this driver's own
// `bindParam` rendering), then read back through the ORDINARY TEXT-protocol
// `Conn.query`/`Rows` path. The uuid's bytes are deliberately
// non-palindromic (#5451's own acceptance example), the float8 carries 17
// significant decimal digits — long enough that a narrower parse would
// drop its last bits — and the bytea holds a 0x00 and a non-UTF8 0xff byte,
// so neither a string-shaped nor an ASCII-only bug could pass by accident.
test "live: uuid, float4, float8 and bytea round-trip a row through the ordinary Rows path" {
  let uri = liveUri("PG_TEST_TRUST_URI")
  if (uri == "") {
    return
  }
  let c = rawConnect(uri) catch e {
    panic("rawConnect(${uri}): ${e.message()}")
  }
  c.exec("drop table if exists t5451scalar", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.exec(
    "create table t5451scalar (u uuid, f4 float4, f8 float8, b bytea)",
    []Value(0),
  ) catch e {
    panic("create: ${e.message()}")
  }
  c.exec(
      "insert into t5451scalar (u, f4, f8, b) values (" +
      "'00112233-4455-6677-8899-aabbccddeeff'::uuid, 3.5::float4, " +
      "0.12345678901234567::float8, '\\x00ff48656c6c6f'::bytea)",
    []Value(0),
  ) catch e {
    panic("insert: ${e.message()}")
  }
  let rows = c.query("select u, f4, f8, b from t5451scalar", []Value(0)) catch e {
    panic("select: ${e.message()}")
  }
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "no row")

  let wantU = pgUuid("u", Value.Text("00112233-4455-6677-8899-aabbccddeeff")) catch e {
    panic("reference pgUuid: ${e.message()}")
  }
  let gotU = pgUuid("u", rows.value(0)) catch e {
    panic("live pgUuid: ${e.message()}")
  }
  assert(equals(gotU, wantU), "live uuid decoded to the wrong value")

  let gotF4 = pgFloat4("f4", rows.value(1)) catch e {
    panic("live pgFloat4: ${e.message()}")
  }
  assert(gotF4 == 3.5, "live float4 decoded as ${gotF4}")

  let gotF8 = pgFloat8("f8", rows.value(2)) catch e {
    panic("live pgFloat8: ${e.message()}")
  }
  let wantF8 = parseFloat("0.12345678901234567")
  assert(gotF8 == wantF8, "live float8 decoded as ${gotF8}, wanted ${wantF8} (precision lost)")

  let gotB = pgBytea("b", rows.value(3)) catch e {
    panic("live pgBytea: ${e.message()}")
  }
  let wantB = []byte{ 0x00, 0xff, 0x48, 0x65, 0x6c, 0x6c, 0x6f }
  assert(string(gotB) == string(wantB), "live bytea decoded to the wrong bytes")

  rows.close()
  c.exec("drop table t5451scalar", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.close()
}
