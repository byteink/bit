// pkg/postgres/temporal.bit — binary wire decoders for `date`, `time`,
// `timestamp` and `timestamptz` (#5450, epic #5449), sibling of codec.bit's
// scalar decoders and split into its own file for the same reason
// numeric.bit is: one concern per file, none of them near the 800-line
// ceiling.
//
// THE WIRE EPOCH IS 2000-01-01, NOT THE UNIX EPOCH. `date` is a signed
// int4 count of DAYS since 2000-01-01 (`DateADTGetDatum`); `time` is a
// signed int8 of microseconds since midnight, no date, no zone
// (`TimeADTGetDatum`); `timestamp` and `timestamptz` are both a signed int8
// of MICROSECONDS since 2000-01-01 (`TimestampGetDatum`). Every decoder
// below is built on `pgEpoch`, a single `DateTime` at 2000-01-01T00:00:00Z,
// rather than a bare `946684800`-second literal added by hand: the offset
// falls out of `std/time`'s own calendar arithmetic instead of being
// restated, and mutating `pgEpochYear` alone is enough to break every
// decoder here at once (temporal.test.bit's proof).
//
// `timestamp` AND `timestamptz` DECODE FROM IDENTICAL BYTES. Postgres puts
// no zone on the wire for either — a `timestamptz` column's session
// `TimeZone` affects only how the server renders it as TEXT, never what is
// sent in binary. What differs between the two is MEANING, not bytes: a
// `timestamptz` value is a true instant, always UTC, and the `Timestamp`
// `decodeTimestamptz` returns is exactly that instant. A `timestamp` value
// is a wall-clock reading Postgres stored with no zone attached at all —
// `decodeTimestamp` returns the same kind of `Timestamp`, but it is only
// that wall-clock reading labeled UTC, correct as an instant only when the
// caller already knows (or does not care) what zone the writer meant by it.
//
// RETURNS `std/time`'s OWN TYPES, never a package-local one: `Date` for
// `date`, `Time` for `time`, `Timestamp` for both temporal columns —
// exactly what `pkg/mysql`'s `mysqlInstant`/`mysqlOptInstant` (codec.bit)
// already return, so this driver and that one share one temporal
// vocabulary rather than two. `beSigned`, from codec.bit, same module, is
// reused unqualified for the signed big-endian fields, same as
// `decodeInt2`/`decodeInt4`/`decodeInt8` already do.

import { Date, DateTime, Time, Timestamp, date, timeNs, utc, Microsecond } from "std/time"

// 2000-01-01, Postgres's own zero point for `date`/`timestamp`/`timestamptz`
// (`POSTGRES_EPOCH_JDATE`), named as three fields rather than folded into
// one constant so each is independently visible — and independently
// breakable, for the mutation proof in temporal.test.bit.
const pgEpochYear: int = 2000
const pgEpochMonth: int = 1
const pgEpochDay: int = 1

// Midnight UTC on the wire epoch. `date(pgEpochYear, ...)` cannot actually
// fail — the literals are a valid calendar date — so a failure here is a
// broken invariant, not a runtime condition callers should handle.
fn pgEpoch(): DateTime {
  let d = date(pgEpochYear, pgEpochMonth, pgEpochDay) catch e {
    panic("postgres: pgEpoch: ${e.message()}")
  }
  return d.atStartOfDay(utc())
}

// `date`: a signed int4 count of days since `pgEpoch`.
export fn decodeDate(body: string, column: string): Date! {
  let days = beSigned(body, 0, 4, column)?
  return pgEpoch().date().addDays(days)
}

// `time`: a signed int8 of microseconds since midnight, no date, no zone.
// Postgres never sends one outside `0..86399999999` (`24:00:00` is not a
// valid `time`), so anything past that range is a malformed column rather
// than a value this decoder should try to interpret.
export fn decodeTime(body: string, column: string): Time! {
  let micros = beSigned(body, 0, 8, column)?
  if (micros < 0 || micros >= 86400000000) {
    fail newError("postgres: column ${column}: time value ${micros}us is out of range for one day")
  }
  let hour = micros / 3600000000
  let minute = micros / 60000000 % 60
  let second = micros / 1000000 % 60
  let nanosecond = micros % 1000000 * 1000
  return timeNs(hour, minute, second, nanosecond) catch e {
    fail newError("postgres: column ${column}: ${e.message()}")
  }
}

// Shared by `decodeTimestamp` and `decodeTimestamptz`: `micros` since
// `pgEpoch`, as the `Timestamp` that instant names. `addNanoseconds` on a
// `DateTime` (stdlib/time/calarith.bit) carries across day boundaries
// through Hinnant's civil-from-days conversion, so this is exact for a
// value on either side of `pgEpoch`, not just after it.
fn pgInstant(micros: int, column: string): Timestamp! {
  return pgEpoch().addNanoseconds(micros * Microsecond).toTimestamp() catch e {
    fail newError("postgres: column ${column}: ${e.message()}")
  }
}

// `timestamp` (`timestamp without time zone`): see the file header for what
// the returned `Timestamp` does and does not mean.
export fn decodeTimestamp(body: string, column: string): Timestamp! {
  let micros = beSigned(body, 0, 8, column)?
  return pgInstant(micros, column)?
}

// `timestamptz`: a true UTC instant.
export fn decodeTimestamptz(body: string, column: string): Timestamp! {
  let micros = beSigned(body, 0, 8, column)?
  return pgInstant(micros, column)?
}
