// pkg/yaml/flowanchor.bit — yaml module, a flow node's own `&anchor`/`!tag`
// prefix and `*alias` reference (#5555, epic #1482). Split out of flow.bit
// purely to stay under spec/LINT.md's 800-line ceiling, the same reason
// properties.bit was split out of parse.bit at #5549: `consumeFlowNodeProperties`/
// `applyFlowAnchor`/`parseFlowAlias` are called only from flow.bit's
// `parseFlowNode`, against the `FlowCtx` that file defines (module-private,
// same flat namespace, pkg/README.md).
//
// REGISTERED, NOT DROPPED. Before this ticket, `FlowCtx` carried no
// `AnchorTable` at all and a flow-context anchor was consumed and silently
// discarded (flow.bit's own OLD header: "a nested flow anchor is dropped").
// `FlowCtx.anchors` is now the SAME `AnchorTable` the enclosing block-context
// `Parser` carries (`yamlParseFlow`'s own `anchors` parameter, threaded from
// `parse.bit`'s `parseBlockFlow`) — anchors and aliases never cross a `---`
// document boundary either way, so one table per document, shared, is
// correct whether a name is defined or resolved from block or flow context
// (X38W: `{ &a [a, &b b]: *b, *a : [c, *b, d]}` defines AND aliases entirely
// inside one flow mapping, needing both directions in the SAME table).

// Optional `&anchor`/`!tag` properties directly prefixing a flow value,
// either order (the core grammar allows both — YAML 1.2.2 §8.2). Returns the
// anchor name and the resolved tag text (`properties.bit`'s
// `resolveTagText`) bundled as `PendingProps` (properties.bit) so
// `parseFlowNode` can both define the anchor and wrap the eventual value
// with `yamlDecorate` (value.bit) — the same contract `applyAnchor` already
// gives block context.
fn consumeFlowNodeProperties(ctx: FlowCtx): PendingProps {
  let anchor = Option<string>.None
  let tag = Option<string>.None
  let guard = 0
  let bound = flowLoopBound(ctx)
  while ((ctx.s.kind == TokenKind.Anchor || ctx.s.kind == TokenKind.Tag) && guard <= bound) {
    if (ctx.s.kind == TokenKind.Anchor) {
      anchor = Option<string>.Some(ctx.s.src[ctx.s.start + 1:ctx.s.end])
    } else {
      tag = Option<string>.Some(resolveTagText(ctx.s.src[ctx.s.start:ctx.s.end]))
    }
    advanceFlow(ctx)
    guard = guard + 1
  }
  return PendingProps{ anchor: anchor, tag: tag }
}

// Defines `props.anchor` (when present) against the PLAIN `value` in
// `ctx.anchors` and returns `value` decorated — the flow-context twin of
// `properties.bit`'s `applyAnchor`, over `FlowCtx` instead of `Parser`. The
// table always stores the plain value, never a decorated one, for the same
// reason `applyAnchor` does (properties.bit's own header): a later alias
// wraps it as its OWN `alias` decoration, never inheriting this node's
// `anchor`/`tag`.
fn applyFlowAnchor(ctx: FlowCtx, props: PendingProps, value: Yaml): Yaml! {
  match (props.anchor) {
    Some(n) => {
      chargeNode(ctx, ctx.s.start)?
      yamlAnchorDefine(ctx.anchors, n, value)?
    }
    None => {}
  }
  return yamlDecorate(value, props.anchor, props.tag, Option<string>.None)
}

// `*name` in flow context — the flow-context twin of `properties.bit`'s
// `resolveAliasToken`, over `FlowCtx.anchors` instead of `Parser.anchors`.
// §7.5: an alias node has no properties production, so this is reached only
// once `parseFlowNode` has already confirmed none were pending.
fn parseFlowAlias(ctx: FlowCtx): Yaml! {
  let start = ctx.s.start
  let end = ctx.s.end
  let name = ctx.s.src[start + 1:end]
  advanceFlow(ctx)
  let value = yamlAnchorResolve(ctx.anchors, name, ctx.limits)?
  chargeNode(ctx, start)?
  return yamlDecorate(value, Option<string>.None, Option<string>.None, Option<string>.Some(name))
}
