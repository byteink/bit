// pkg/yaml/corpusevents.test.bit — the base-grammar test.event oracle for
// `corpusExclusionsNoJson` (#5542, epic #5524, split off #5536's staleness
// detector and #5535's `corpusCompareMulti`, both left untouched).
//
// Same flat module as corpus.test.bit / corpusexclusions.test.bit
// (pkg/README.md), so `corpusEventCheck` is called from `corpusParseCheck`
// (corpus.test.bit) unqualified, no import.
//
// WHY A SECOND ORACLE. `corpusExclusionsNoJson`'s 29 ids ship no `in.json`
// because their value uses a non-scalar (or empty) mapping key — JSON has no
// object-key syntax for that at all — so `corpusCompareOne`/`corpusCompareMulti`
// (corpus.test.bit) have nothing to compare against and these ids sat
// excluded rather than counted as passing on parse success alone. Every case
// still ships `test.event`, upstream's own canonical event-stream ground
// truth (`_tests_/corpus/yaml-test-suite/README.md`), and that format's
// `+MAP`/`+SEQ`/`=VAL` events already express a non-scalar key directly (a
// nested `+MAP`/`+SEQ` in key position) — this file serialises the parsed
// `Yaml` back to that grammar and compares.
//
// SCOPE IS THE BASE GRAMMAR ONLY (this ticket's own boundary): +STR/+DOC/
// +MAP/+SEQ/=VAL and their closers. `pkg/yaml`'s `Yaml` value (value.bit)
// carries no anchor, alias, tag, flow-vs-block style or explicit-document-
// marker information — none of that survives parsing today — so a case
// whose `test.event` uses `&anchor`, `=ALI *alias` or a `<tag>` cannot be
// compared here at all; `corpusEventTextInScope` refuses those outright
// rather than silently comparing a stripped-down view of them. The anchor/
// alias/tag forms are the follow-up ticket #5542 itself names.
//
// NORMALIZED, NOT BYTE-EXACT, even for the base grammar. `+MAP {}`/`+SEQ []`
// (flow style) and `+DOC ---`/`-DOC ...` (explicit markers) are dropped from
// BOTH sides before comparing, for the same reason as the constructs above:
// `Yaml` retains no style or marker bit to reproduce them by, and JSON's own
// oracle (corpusCompareOne) never distinguished flow from block either — this
// file holds parity with that, not a stricter bar. What IS compared, and can
// fail: event KIND and NESTING (a MAP/SEQ opened, closed, in the right
// place), key/value/item ORDER, and every `=VAL`'s decoded scalar content —
// exactly the structure JSON could not express for these ids.
//
// ESCAPE DECODING. `test.event`'s `=VAL` content is C-escaped (`\n` for a
// literal newline, `\\` for a literal backslash, ...) so a block-scalar
// value's embedded newline round-trips through the text file at all.
// `corpusUnescapeEventText` decodes the handful of escapes this corpus's
// base-grammar ids actually use and FAILS on an unrecognized one rather than
// dropping or mis-decoding it — a silently wrong decode would make this
// oracle pass a case it should fail, exactly the defect class #5536 exists
// to catch.

import { hasPrefix, split } from "std/strings"

// --- scope: base grammar only ----------------------------------------------

// True when `text` (a whole `test.event` file) never uses an anchor
// (`&name`), an alias event (`=ALI ...`) or an explicit tag (`<...>`) —
// this file's own header explains why those stay out of reach. Conservative
// by construction: it scans the raw file for the substrings those
// constructs are spelled with, so a scalar VALUE that happens to itself
// contain `&`, `<` or `=ALI` text would (safely) read as out of scope too,
// never as a false match — no id in `corpusExclusionsNoJson` does today.
fn corpusEventTextInScope(text: string): bool {
  return !contains(text, "&") && !contains(text, "<") && !contains(text, "=ALI")
}

// --- decoding upstream's escaped =VAL content -------------------------

fn corpusUnescapeEventText(s: string): string! {
  let b = newBuilder()
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c != '\\') {
      b.writeByte(c)
      i = i + 1
      continue
    }
    if (i + 1 >= len(s)) {
      fail corpusError("test.event: scalar content ends with a bare backslash")
    }
    let next = s[i + 1]
    if (next == 'n') {
      b.writeByte('\n')
    } else if (next == 't') {
      b.writeByte('\t')
    } else if (next == 'r') {
      b.writeByte('\r')
    } else if (next == '"') {
      b.writeByte('"')
    } else if (next == '\\') {
      b.writeByte('\\')
    } else {
      fail corpusError("test.event: unsupported scalar escape at byte ${i} — extend corpusUnescapeEventText")
    }
    i = i + 2
  }
  return b.toString()
}

// --- normalizing upstream's raw event lines ---------------------------

// An `=VAL` line's decoded content, dropping the leading style character
// (this file's header — no style bit is preserved). Split out of
// `corpusNormalizeEventLine` to keep that dispatcher under spec/LINT.md's
// complexity ceiling.
fn corpusNormalizeValLine(line: string): string! {
  let body = line[5:len(line)]
  if (len(body) == 0) {
    fail corpusError("test.event: '=VAL' line has no style/content")
  }
  let content = corpusUnescapeEventText(body[1:len(body)])?
  return "=VAL ${content}"
}

// An opener line (`+STR`/`+DOC`/`+MAP`/`+SEQ`, each possibly carrying a
// dropped suffix — this file's header), stripped to the bare keyword. Split
// out of `corpusNormalizeEventLine` to keep that dispatcher under
// spec/LINT.md's complexity ceiling.
fn corpusNormalizeOpener(line: string): string! {
  if (line == "+STR") {
    return line
  }
  if (hasPrefix(line, "+DOC")) {
    return "+DOC"
  }
  if (hasPrefix(line, "+MAP")) {
    return "+MAP"
  }
  if (hasPrefix(line, "+SEQ")) {
    return "+SEQ"
  }
  fail corpusError("test.event: unrecognized opener event line '${line}'")
}

// A closer line (`-STR`/`-MAP`/`-SEQ`, exact; `-DOC`, possibly carrying a
// dropped `...` suffix — this file's header). Same reason as
// `corpusNormalizeOpener`.
fn corpusNormalizeCloser(line: string): string! {
  if (line == "-STR" || line == "-MAP" || line == "-SEQ") {
    return line
  }
  if (hasPrefix(line, "-DOC")) {
    return "-DOC"
  }
  fail corpusError("test.event: unrecognized closer event line '${line}'")
}

// One `test.event` line, stripped to the base grammar this file compares
// (this file's header). The scope check above already guarantees `line`
// carries no anchor/alias/tag.
fn corpusNormalizeEventLine(line: string): string! {
  if (hasPrefix(line, "+")) {
    return corpusNormalizeOpener(line)?
  }
  if (hasPrefix(line, "-")) {
    return corpusNormalizeCloser(line)?
  }
  if (hasPrefix(line, "=VAL ")) {
    return corpusNormalizeValLine(line)?
  }
  fail corpusError("test.event: unrecognized event line '${line}'")
}

// `text` normalized to one line per event, `\n`-joined — see this file's
// header for exactly what is and is not preserved. Assumes
// `corpusEventTextInScope(text)` already returned true; the caller checks
// that first so a genuinely out-of-scope construct is reported as "needs
// anchor/alias/tag", never as a normalization failure.
fn corpusNormalizeEventText(text: string): string! {
  let lines = split(text, "\n")
  let b = newBuilder()
  let i = 0
  while (i < len(lines)) {
    if (len(lines[i]) == 0) {
      i = i + 1
      continue
    }
    let normalized = corpusNormalizeEventLine(lines[i])?
    b.write(normalized)
    b.writeByte('\n')
    i = i + 1
  }
  return b.toString()
}

// --- serializing a parsed Yaml to the same normalized grammar ---------

// A scalar's `=VAL` content text. `YamlNull` and an empty/implicit key both
// upstream and `Yaml` represent as an empty plain scalar, so both take the
// same `""` arm as `YamlString("")` would (this file's header: no style bit
// to distinguish them by, and none is needed here).
fn corpusEventScalarText(y: Yaml): string {
  if (yamlIsNull(y)) {
    return ""
  }
  if (yamlIsBool(y)) {
    if (unwrap(yamlAsBool(y))) {
      return "true"
    }
    return "false"
  }
  if (yamlIsInt(y)) {
    return "${unwrap(yamlAsInt(y))}"
  }
  if (yamlIsFloat(y)) {
    return encodeFloatText(unwrap(yamlAsFloat(y)))
  }
  return unwrap(yamlAsString(y))
}

// Depth-first: a mapping's `+MAP`/entries (key then value, source order)/
// `-MAP`, a sequence's `+SEQ`/items/`-SEQ`, or one `=VAL` leaf — the same
// walk `corpusEqualMapping`/`corpusEqualSequence` (corpus.test.bit) do for
// the JSON oracle, over the SAME `Yaml` recursion `yamlParseAll` already
// bounded by `YamlLimits.maxDepth`, so no separate depth guard is needed
// here either.
fn corpusEventsForNode(b: Builder, y: Yaml) {
  if (yamlIsMapping(y)) {
    b.write("+MAP\n")
    let entries = unwrap(yamlAsMapping(y))
    let i = 0
    while (i < len(entries)) {
      corpusEventsForNode(b, entries[i].key)
      corpusEventsForNode(b, entries[i].value)
      i = i + 1
    }
    b.write("-MAP\n")
    return
  }
  if (yamlIsSequence(y)) {
    b.write("+SEQ\n")
    let items = unwrap(yamlAsSequence(y))
    let i = 0
    while (i < len(items)) {
      corpusEventsForNode(b, items[i])
      i = i + 1
    }
    b.write("-SEQ\n")
    return
  }
  b.write("=VAL ${corpusEventScalarText(y)}\n")
}

// `docs` (from `yamlParseAll`) as one normalized event stream, wrapping
// every document between a single `+STR`/`-STR` pair the way upstream's own
// stream does — a multi-document `test.event` (e.g. `NKF9`, 4 documents)
// still gets one `+STR`/`-STR` around all of them, not one pair each.
fn corpusEventsForDocs(docs: []Yaml): string {
  let b = newBuilder()
  b.write("+STR\n")
  let i = 0
  while (i < len(docs)) {
    b.write("+DOC\n")
    corpusEventsForNode(b, docs[i])
    b.write("-DOC\n")
    i = i + 1
  }
  b.write("-STR\n")
  return b.toString()
}

// --- the comparison itself ---------------------------------------------

// `docs` against `leafFull`'s own `test.event`, base grammar only. Returns
// `None` (a real pass, not parse-success-alone — this file's header and
// this ticket's own hard boundary) only when the case is in scope AND the
// normalized streams match exactly; otherwise `Some(reason)`, which
// `corpusCheckOne` (corpus.test.bit) treats identically to any other
// failure — an id still listed in `corpusExclusionsNoJson` stays counted as
// excluded, one no longer listed there is a real failure.
fn corpusEventCheck(leafFull: string, docs: []Yaml): Option<string> {
  let text = readFile("${leafFull}/test.event") catch e {
    return Option<string>.Some("cannot read test.event: ${e.message()}")
  }
  if (!corpusEventTextInScope(text)) {
    return Option<string>.Some(
      "test.event uses an anchor, alias or explicit tag — out of #5542's base-grammar scope, needs the anchor/alias/tag follow-up",
    )
  }
  let expected = corpusNormalizeEventText(text) catch e {
    return Option<string>.Some("cannot normalize test.event: ${e.message()}")
  }
  let actual = corpusEventsForDocs(docs)
  if (actual != expected) {
    return Option<string>.Some("parsed value's event stream does not match test.event (base grammar):\n--- expected ---\n${expected}--- got ---\n${actual}")
  }
  return Option<string>.None
}

// --- unit coverage, independent of the corpus fixtures -----------------

// Every call below sends well-formed input; a failure here is this file's
// own bug, mirroring block.test.bit's/anchor.test.bit's own `must*` helpers.
fn mustUnescape(s: string): string {
  return corpusUnescapeEventText(s) catch e {
    panic(e.message())
  }
}

fn mustNormalize(text: string): string {
  return corpusNormalizeEventText(text) catch e {
    panic(e.message())
  }
}

test "corpusEventTextInScope rejects anchor, alias and tag, accepts base grammar" {
  assert(
    corpusEventTextInScope("+STR\n+DOC\n+MAP\n=VAL :a\n-MAP\n-DOC\n-STR\n"),
    "plain base grammar must be in scope",
  )
  assert(!corpusEventTextInScope("+MAP &m\n"), "an anchor must be out of scope")
  assert(!corpusEventTextInScope("=ALI *m\n"), "an alias event must be out of scope")
  assert(
    !corpusEventTextInScope("=VAL <tag:yaml.org,2002:str> :a\n"),
    "an explicit tag must be out of scope",
  )
}

test "corpusUnescapeEventText decodes the escapes this corpus's base ids use" {
  assert(mustUnescape("a") == "a", "plain text needs no decoding")
  assert(mustUnescape("b\\n") == "b\n", "\\n decodes to a real newline")
  assert(mustUnescape("a\\\\b") == "a\\b", "\\\\ decodes to one backslash")
}

test "corpusEventsForDocs serializes a non-scalar key the way 2JQS's own test.event does" {
  let doc = Yaml.YamlMapping(
    [
      YamlEntry{ key: Yaml.YamlString(""), value: Yaml.YamlString("a") },
      YamlEntry{ key: Yaml.YamlString(""), value: Yaml.YamlString("b") },
    ],
  )
  let got = corpusEventsForDocs([doc])
  assert(
    got == "+STR\n+DOC\n+MAP\n=VAL \n=VAL a\n=VAL \n=VAL b\n-MAP\n-DOC\n-STR\n",
    "expected 2JQS's own normalized event stream (style character dropped — this file's header), got: ${got}",
  )
}

test "corpusNormalizeEventText drops flow style and document markers, keeps structure" {
  let got = mustNormalize("+STR\n+DOC ---\n+MAP {}\n=VAL :a\n-MAP\n-DOC ...\n-STR\n")
  assert(
    got == "+STR\n+DOC\n+MAP\n=VAL a\n-MAP\n-DOC\n-STR\n",
    "flow/marker suffixes and the style character must be dropped, structure kept: ${got}",
  )
}

// The mutation this ticket's own acceptance requires: one event stream vs.
// upstream's own 2JQS structure, differing by exactly one event (an added
// `=VAL :extra`), must be REJECTED by name, not silently accepted.
test "corpusEventsForDocs differs from 2JQS's own stream when a value is wrong" {
  let mutated = Yaml.YamlMapping(
    [
      YamlEntry{ key: Yaml.YamlString(""), value: Yaml.YamlString("a") },
      YamlEntry{ key: Yaml.YamlString(""), value: Yaml.YamlString("WRONG") },
    ],
  )
  let got = corpusEventsForDocs([mutated])
  assert(
    got != "+STR\n+DOC\n+MAP\n=VAL \n=VAL a\n=VAL \n=VAL b\n-MAP\n-DOC\n-STR\n",
    "a one-scalar mutation must change the serialized stream",
  )
}
