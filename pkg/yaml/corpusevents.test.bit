// pkg/yaml/corpusevents.test.bit — the base-grammar test.event oracle for
// `corpusExclusionsNoJson` (#5542, epic #5524, split off #5536's staleness
// detector and #5535's `corpusCompareMulti`, both left untouched).
//
// Same flat module as corpus.test.bit / corpusexclusions.test.bit
// (pkg/README.md), so `corpusEventCheck` is called from `corpusParseCheck`
// (corpus.test.bit) unqualified, no import.
//
// WHY A SECOND ORACLE. `corpusExclusionsNoJson`'s 29 ids ship no `in.json`
// because their value uses a non-scalar (or empty) mapping key — JSON has no
// object-key syntax for that at all — so `corpusCompareOne`/`corpusCompareMulti`
// (corpus.test.bit) have nothing to compare against and these ids sat
// excluded rather than counted as passing on parse success alone. Every case
// still ships `test.event`, upstream's own canonical event-stream ground
// truth (`_tests_/corpus/yaml-test-suite/README.md`), and that format's
// `+MAP`/`+SEQ`/`=VAL` events already express a non-scalar key directly (a
// nested `+MAP`/`+SEQ` in key position) — this file serialises the parsed
// `Yaml` back to that grammar and compares.
//
// SCOPE (#5555 extends this past the base grammar): +STR/+DOC/+MAP/+SEQ/
// =VAL and their closers, PLUS `&anchor`/`<tag>` decoration on any opener or
// `=VAL`, PLUS a bare `=ALI *name` alias event. `value.bit`'s `Yaml` now
// carries anchor/tag/alias identity via `YamlDecorated`/`yamlDecorationOf`
// (#5548's ruling), so this file no longer needs to refuse a decorated
// case outright the way it did before this ticket — it reproduces the
// decoration and compares it like any other event content, which is what
// makes a WRONG anchor, alias target or tag a real, name-able failure here
// rather than the always-agrees gap #5536 exists to catch (this file's own
// mutation test, below, proves the extended comparator still catches one).
//
// NORMALIZED, NOT BYTE-EXACT, even for the base grammar. `+MAP {}`/`+SEQ []`
// (flow style) and `+DOC ---`/`-DOC ...` (explicit markers) are dropped from
// BOTH sides before comparing, for the same reason as the constructs above:
// `Yaml` retains no style or marker bit to reproduce them by, and JSON's own
// oracle (corpusCompareOne) never distinguished flow from block either — this
// file holds parity with that, not a stricter bar. What IS compared, and can
// fail: event KIND and NESTING (a MAP/SEQ opened, closed, in the right
// place), key/value/item ORDER, and every `=VAL`'s decoded scalar content —
// exactly the structure JSON could not express for these ids.
//
// ESCAPE DECODING. `test.event`'s `=VAL` content is C-escaped (`\n` for a
// literal newline, `\\` for a literal backslash, ...) so a block-scalar
// value's embedded newline round-trips through the text file at all.
// `corpusUnescapeEventText` decodes the handful of escapes this corpus's
// base-grammar ids actually use and FAILS on an unrecognized one rather than
// dropping or mis-decoding it — a silently wrong decode would make this
// oracle pass a case it should fail, exactly the defect class #5536 exists
// to catch.

import { hasPrefix, split } from "std/strings"

// --- decoding upstream's escaped =VAL content -------------------------

fn corpusUnescapeEventText(s: string): string! {
  let b = newBuilder()
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c != '\\') {
      b.writeByte(c)
      i = i + 1
      continue
    }
    if (i + 1 >= len(s)) {
      fail corpusError("test.event: scalar content ends with a bare backslash")
    }
    let next = s[i + 1]
    if (next == 'n') {
      b.writeByte('\n')
    } else if (next == 't') {
      b.writeByte('\t')
    } else if (next == 'r') {
      b.writeByte('\r')
    } else if (next == '"') {
      b.writeByte('"')
    } else if (next == '\\') {
      b.writeByte('\\')
    } else {
      fail corpusError("test.event: unsupported scalar escape at byte ${i} — extend corpusUnescapeEventText")
    }
    i = i + 2
  }
  return b.toString()
}

// --- normalizing upstream's raw event lines ---------------------------

// Byte offset of `c` in `s` at or after `from`, or -1. A tiny local scan,
// matching this file's siblings' own style (scalar.bit's `indexOfChar`,
// schema.bit's `indexOfByte`) rather than importing `std/strings`' `indexOf`
// — `hasPrefix`/`split` are already this file's own import (this file's
// top), and a second search helper does not earn a second import.
fn corpusByteIndex(s: string, startAt: i64, c: u8): i64 {
  let i = startAt
  while (i < len(s)) {
    if (s[i] == c) {
      return i
    }
    i = i + 1
  }
  return -1
}

// The canonical decoration prefix both sides of the comparison build from —
// `corpusSplitValDecorations` below (parsing upstream's raw line) and
// `corpusEventsForNode` (serializing the parsed `Yaml`) both call this, so
// neither can drift from the other's ordering. Tag before anchor always:
// none of the 8 ids `#5555` closes combine both on one node, so no upstream
// fixture exercises the other order, but a canonical order lets both sides
// agree regardless.
fn corpusEventDecoPrefix(tag: Option<string>, anchor: Option<string>): string {
  let s = ""
  match (tag) {
    Some(t) => { s = "${s} <${t}>" }
    None => {}
  }
  match (anchor) {
    Some(a) => { s = "${s} &${a}" }
    None => {}
  }
  return s
}

// Splits a `=VAL` line's body (everything after `"=VAL "`) into its leading
// `<tag>`/`&anchor` decoration tokens — reordered into this file's own
// canonical prefix (`corpusEventDecoPrefix`) — and the remaining, still-raw
// STYLECHAR+content tail. Bounded to 2 iterations: YAML permits at most one
// tag and one anchor per node (properties.bit's own `consumeNodeProperties`
// carries the identical bound on the parsing side).
fn corpusSplitValDecorations(body: string): (string, string)! {
  let s = body
  let tag = Option<string>.None
  let anchor = Option<string>.None
  let guard = 0
  while (guard < 2) {
    guard = guard + 1
    if (len(s) > 0 && s[0] == '<') {
      let closeAt = corpusByteIndex(s, 1, '>')
      if (closeAt < 0) {
        fail corpusError("test.event: '=VAL' tag has no closing '>'")
      }
      tag = Option<string>.Some(s[1:closeAt])
      s = s[closeAt + 2:len(s)]
      continue
    }
    if (len(s) > 0 && s[0] == '&') {
      let sp = corpusByteIndex(s, 1, ' ')
      if (sp < 0) {
        fail corpusError("test.event: '=VAL' anchor has no following style/content")
      }
      anchor = Option<string>.Some(s[1:sp])
      s = s[sp + 1:len(s)]
      continue
    }
    break
  }
  return (corpusEventDecoPrefix(tag, anchor), s)
}

// An `=VAL` line's decoration prefix plus decoded content, dropping only the
// style character (this file's header — no style bit is preserved). Split
// out of `corpusNormalizeEventLine` to keep that dispatcher under
// spec/LINT.md's complexity ceiling.
fn corpusNormalizeValLine(line: string): string! {
  let body = line[5:len(line)]
  if (len(body) == 0) {
    fail corpusError("test.event: '=VAL' line has no style/content")
  }
  let (prefix, tail) = corpusSplitValDecorations(body)?
  if (len(tail) == 0) {
    fail corpusError("test.event: '=VAL' line has no style/content")
  }
  let content = corpusUnescapeEventText(tail[1:len(tail)])?
  return "=VAL${prefix} ${content}"
}

// The `&anchor`/`<tag>` decoration tokens among an opener's space-separated
// remainder (`rest`), ignoring every other token (`[]`/`{}` flow style,
// `---`/`...` document markers — this file's header, dropped on both sides
// exactly as before this ticket).
fn corpusExtractOpenerDeco(rest: string): string {
  let tokens = split(rest, " ")
  let tag = Option<string>.None
  let anchor = Option<string>.None
  let i = 0
  while (i < len(tokens)) {
    let t = tokens[i]
    if (len(t) >= 2 && t[0] == '<' && t[len(t) - 1] == '>') {
      tag = Option<string>.Some(t[1:len(t) - 1])
    }
    if (len(t) > 1 && t[0] == '&') {
      anchor = Option<string>.Some(t[1:len(t)])
    }
    i = i + 1
  }
  return corpusEventDecoPrefix(tag, anchor)
}

// An opener line (`+STR`/`+DOC`/`+MAP`/`+SEQ`, each possibly carrying a
// flow-style/doc-marker suffix and now also `&anchor`/`<tag>` — this file's
// header), stripped to the bare keyword plus any decoration. Split out of
// `corpusNormalizeEventLine` to keep that dispatcher under spec/LINT.md's
// complexity ceiling.
fn corpusNormalizeOpener(line: string): string! {
  if (line == "+STR") {
    return line
  }
  if (hasPrefix(line, "+DOC")) {
    return "+DOC${corpusExtractOpenerDeco(line[4:len(line)])}"
  }
  if (hasPrefix(line, "+MAP")) {
    return "+MAP${corpusExtractOpenerDeco(line[4:len(line)])}"
  }
  if (hasPrefix(line, "+SEQ")) {
    return "+SEQ${corpusExtractOpenerDeco(line[4:len(line)])}"
  }
  fail corpusError("test.event: unrecognized opener event line '${line}'")
}

// A closer line (`-STR`/`-MAP`/`-SEQ`, exact; `-DOC`, possibly carrying a
// dropped `...` suffix — this file's header). Never carries `&anchor`/
// `<tag>` — YAML's grammar puts a node's properties on its OPENER, never
// its closer.
fn corpusNormalizeCloser(line: string): string! {
  if (line == "-STR" || line == "-MAP" || line == "-SEQ") {
    return line
  }
  if (hasPrefix(line, "-DOC")) {
    return "-DOC"
  }
  fail corpusError("test.event: unrecognized closer event line '${line}'")
}

// One `test.event` line, stripped to this file's normalized grammar (this
// file's header): base structure, decoration kept, flow style and document
// markers dropped. `=ALI *name` (an alias event) needs no normalization at
// all — it carries no style character and no flow/marker suffix to drop.
fn corpusNormalizeEventLine(line: string): string! {
  if (hasPrefix(line, "+")) {
    return corpusNormalizeOpener(line)?
  }
  if (hasPrefix(line, "-")) {
    return corpusNormalizeCloser(line)?
  }
  if (hasPrefix(line, "=VAL ")) {
    return corpusNormalizeValLine(line)?
  }
  if (hasPrefix(line, "=ALI ")) {
    return line
  }
  fail corpusError("test.event: unrecognized event line '${line}'")
}

// `text` normalized to one line per event, `\n`-joined — see this file's
// header for exactly what is and is not preserved.
fn corpusNormalizeEventText(text: string): string! {
  let lines = split(text, "\n")
  let b = newBuilder()
  let i = 0
  while (i < len(lines)) {
    if (len(lines[i]) == 0) {
      i = i + 1
      continue
    }
    let normalized = corpusNormalizeEventLine(lines[i])?
    b.write(normalized)
    b.writeByte('\n')
    i = i + 1
  }
  return b.toString()
}

// --- serializing a parsed Yaml to the same normalized grammar ---------

// A scalar's `=VAL` content text. `YamlNull` and an empty/implicit key both
// upstream and `Yaml` represent as an empty plain scalar, so both take the
// same `""` arm as `YamlString("")` would (this file's header: no style bit
// to distinguish them by, and none is needed here).
fn corpusEventScalarText(y: Yaml): string {
  if (yamlIsNull(y)) {
    return ""
  }
  if (yamlIsBool(y)) {
    if (unwrap(yamlAsBool(y))) {
      return "true"
    }
    return "false"
  }
  if (yamlIsInt(y)) {
    return "${unwrap(yamlAsInt(y))}"
  }
  if (yamlIsFloat(y)) {
    return encodeFloatText(unwrap(yamlAsFloat(y)))
  }
  return unwrap(yamlAsString(y))
}

// A `YamlDecorated` node's own alias name, or `None` — the ONE case
// `corpusEventsForNode` never recurses past: an alias event stands for the
// SAME node its anchor already emitted a full `+MAP`/`+SEQ`/`=VAL` for
// (§3.2.2), so re-walking the shared value here would double-emit it and
// could never match upstream's own single `=ALI *name` line either way.
fn corpusEventAliasName(d: YamlDecoration): Option<string> {
  return d.alias
}

// Depth-first: a mapping's `+MAP`/entries (key then value, source order)/
// `-MAP`, a sequence's `+SEQ`/items/`-SEQ`, or one `=VAL` leaf, each opener
// or leaf carrying its own `&anchor`/`<tag>` prefix when `yamlDecorationOf`
// (value.bit) reports one — the same walk `corpusEqualMapping`/
// `corpusEqualSequence` (corpus.test.bit) do for the JSON oracle, over the
// SAME `Yaml` recursion `yamlParseAll` already bounded by
// `YamlLimits.maxDepth`, so no separate depth guard is needed here either.
fn corpusEventsForNode(b: Builder, y: Yaml) {
  match (yamlDecorationOf(y)) {
    Some(d) => {
      match (corpusEventAliasName(d)) {
        Some(name) => {
          b.write("=ALI *${name}\n")
          return
        }
        None => {}
      }
      corpusEventsForDecorated(b, yamlUndecorated(y), d.tag, d.anchor)
      return
    }
    None => {}
  }
  corpusEventsForDecorated(b, y, Option<string>.None, Option<string>.None)
}

// The undecorated `y` written with `tag`/`anchor`'s decoration prefix on its
// own opener or `=VAL` line. Split out of `corpusEventsForNode` to keep that
// dispatcher under spec/LINT.md's complexity ceiling.
fn corpusEventsForDecorated(b: Builder, y: Yaml, tag: Option<string>, anchor: Option<string>) {
  let prefix = corpusEventDecoPrefix(tag, anchor)
  if (yamlIsMapping(y)) {
    b.write("+MAP${prefix}\n")
    let entries = unwrap(yamlAsMapping(y))
    let i = 0
    while (i < len(entries)) {
      corpusEventsForNode(b, entries[i].key)
      corpusEventsForNode(b, entries[i].value)
      i = i + 1
    }
    b.write("-MAP\n")
    return
  }
  if (yamlIsSequence(y)) {
    b.write("+SEQ${prefix}\n")
    let items = unwrap(yamlAsSequence(y))
    let i = 0
    while (i < len(items)) {
      corpusEventsForNode(b, items[i])
      i = i + 1
    }
    b.write("-SEQ\n")
    return
  }
  b.write("=VAL${prefix} ${corpusEventScalarText(y)}\n")
}

// `docs` (from `yamlParseAll`) as one normalized event stream, wrapping
// every document between a single `+STR`/`-STR` pair the way upstream's own
// stream does — a multi-document `test.event` (e.g. `NKF9`, 4 documents)
// still gets one `+STR`/`-STR` around all of them, not one pair each.
fn corpusEventsForDocs(docs: []Yaml): string {
  let b = newBuilder()
  b.write("+STR\n")
  let i = 0
  while (i < len(docs)) {
    b.write("+DOC\n")
    corpusEventsForNode(b, docs[i])
    b.write("-DOC\n")
    i = i + 1
  }
  b.write("-STR\n")
  return b.toString()
}

// --- the comparison itself ---------------------------------------------

// `docs` against `leafFull`'s own `test.event`, base grammar only. Returns
// `None` (a real pass, not parse-success-alone — this file's header and
// this ticket's own hard boundary) only when the case is in scope AND the
// normalized streams match exactly; otherwise `Some(reason)`, which
// `corpusCheckOne` (corpus.test.bit) treats identically to any other
// failure — an id still listed in `corpusExclusionsNoJson` stays counted as
// excluded, one no longer listed there is a real failure.
fn corpusEventCheck(leafFull: string, docs: []Yaml): Option<string> {
  let text = readFile("${leafFull}/test.event") catch e {
    return Option<string>.Some("cannot read test.event: ${e.message()}")
  }
  let expected = corpusNormalizeEventText(text) catch e {
    return Option<string>.Some("cannot normalize test.event: ${e.message()}")
  }
  let actual = corpusEventsForDocs(docs)
  if (actual != expected) {
    return Option<string>.Some("parsed value's event stream does not match test.event (base grammar):\n--- expected ---\n${expected}--- got ---\n${actual}")
  }
  return Option<string>.None
}

// --- unit coverage, independent of the corpus fixtures -----------------

// Every call below sends well-formed input; a failure here is this file's
// own bug, mirroring block.test.bit's/anchor.test.bit's own `must*` helpers.
fn mustUnescape(s: string): string {
  return corpusUnescapeEventText(s) catch e {
    panic(e.message())
  }
}

fn mustNormalize(text: string): string {
  return corpusNormalizeEventText(text) catch e {
    panic(e.message())
  }
}

test "corpusNormalizeEventText keeps an anchor, alias event and tag, drops style/markers" {
  let got = mustNormalize(
    "+STR\n+DOC\n+MAP &m\n=VAL &a :x\n=ALI *a\n=VAL <tag:yaml.org,2002:str> :y\n-MAP\n-DOC\n-STR\n",
  )
  assert(
      got ==
      "+STR\n+DOC\n+MAP &m\n=VAL &a x\n=ALI *a\n=VAL <tag:yaml.org,2002:str> y\n-MAP\n-DOC\n-STR\n",
    "anchor/tag/alias must survive normalization, style character still dropped: ${got}",
  )
}

test "corpusUnescapeEventText decodes the escapes this corpus's base ids use" {
  assert(mustUnescape("a") == "a", "plain text needs no decoding")
  assert(mustUnescape("b\\n") == "b\n", "\\n decodes to a real newline")
  assert(mustUnescape("a\\\\b") == "a\\b", "\\\\ decodes to one backslash")
}

test "corpusEventsForDocs serializes a non-scalar key the way 2JQS's own test.event does" {
  let doc = Yaml.YamlMapping(
    [
      YamlEntry{ key = Yaml.YamlString(""), value = Yaml.YamlString("a") },
      YamlEntry{ key = Yaml.YamlString(""), value = Yaml.YamlString("b") },
    ],
  )
  let got = corpusEventsForDocs([doc])
  assert(
    got == "+STR\n+DOC\n+MAP\n=VAL \n=VAL a\n=VAL \n=VAL b\n-MAP\n-DOC\n-STR\n",
    "expected 2JQS's own normalized event stream (style character dropped — this file's header), got: ${got}",
  )
}

test "corpusNormalizeEventText drops flow style and document markers, keeps structure" {
  let got = mustNormalize("+STR\n+DOC ---\n+MAP {}\n=VAL :a\n-MAP\n-DOC ...\n-STR\n")
  assert(
    got == "+STR\n+DOC\n+MAP\n=VAL a\n-MAP\n-DOC\n-STR\n",
    "flow/marker suffixes and the style character must be dropped, structure kept: ${got}",
  )
}

// The mutation this ticket's own acceptance requires: one event stream vs.
// upstream's own 2JQS structure, differing by exactly one event (an added
// `=VAL :extra`), must be REJECTED by name, not silently accepted.
test "corpusEventsForDocs differs from 2JQS's own stream when a value is wrong" {
  let mutated = Yaml.YamlMapping(
    [
      YamlEntry{ key = Yaml.YamlString(""), value = Yaml.YamlString("a") },
      YamlEntry{ key = Yaml.YamlString(""), value = Yaml.YamlString("WRONG") },
    ],
  )
  let got = corpusEventsForDocs([mutated])
  assert(
    got != "+STR\n+DOC\n+MAP\n=VAL \n=VAL a\n=VAL \n=VAL b\n-MAP\n-DOC\n-STR\n",
    "a one-scalar mutation must change the serialized stream",
  )
}

// THE MUTATION THIS TICKET'S ACCEPTANCE REQUIRES, on a real closed id (not
// the JSON-side unit fixture above): parses 6M2F for real, confirms the
// baseline passes, then renames the SECOND entry's alias target (`*a` in
// `? &a a\n: &b b\n: *a`) to a name nothing defines, and shows
// `corpusEventCheck` rejects it BY NAME rather than silently accepting a
// wrong alias — exactly the always-agrees defect class #5536 exists to
// catch, applied to the extended (not just base-grammar) comparator. The
// mutation is built in memory from the real parsed value, never on
// `_tests_/corpus/yaml-test-suite/6M2F` itself (that tree is vendored at a
// pinned SHA and untouched).
test "corpusEventCheck rejects a wrong alias target on 6M2F, mutation proof" {
  let leafFull = "${corpusRoot()}/6M2F"
  let text = readFile("${leafFull}/in.yaml") catch e {
    panic(e.message())
  }
  let docs = yamlParseAll(text) catch e {
    panic(e.message())
  }
  match (corpusEventCheck(leafFull, docs)) {
    None => {}
    Some(reason) => panic("baseline (unmutated) must pass before mutating: ${reason}")
  }
  let entries = unwrap(yamlAsMapping(docs[0]))
  assert(len(entries) == 2, "6M2F's own mapping has exactly 2 entries")
  let realAliasValue = entries[1].value
  let realDeco = unwrap(yamlDecorationOf(realAliasValue))
  assert(isSome(realDeco.alias), "6M2F's second entry's value must be an alias")
  let mutatedValue = yamlDecorate(
    yamlUndecorated(realAliasValue),
    realDeco.anchor,
    realDeco.tag,
    Option<string>.Some("wrong-target-name"),
  )
  let mutatedEntries = [
    entries[0],
    YamlEntry{ key = entries[1].key, value = mutatedValue },
  ]
  let mutatedDocs = [Yaml.YamlMapping(mutatedEntries)]
  match (corpusEventCheck(leafFull, mutatedDocs)) {
    None => panic("a wrong alias target must be rejected, not silently accepted")
    Some(reason) => assert(contains(reason, "does not match"), reason)
  }
}
