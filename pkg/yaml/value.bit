// pkg/yaml/value.bit — yaml module, Yaml value sum type + YamlEntry, plus
// the resource budget every later file in this package reads.
//
// No parser, no scanner, no encoder, no I/O — just the value type, its pure
// accessors, and the DoS budget the parser is bound by (#5491, epic #1482).
// Modeled on stdlib/json/value.bit, carrying over both of its decisions:
// `YamlMapping` is `[]YamlEntry`, not `map<string, Yaml>` — YAML mappings
// have a source order, and duplicate-key detection is the parser's job,
// both destroyed by a map — and accessors are free functions, mirroring
// stdlib/core/option.bit's style, rather than methods on `Yaml`.
//
// `YamlEntry.key` is a `Yaml`, not a `string`: unlike JSON and TOML, YAML
// permits a non-scalar key (a sequence or mapping used as a key). Typing it
// `string` here would make that unrepresentable and force a breaking change
// once the parser needs it.
//
// ANCHOR IDENTITY AND TAG TEXT (#5548, #5555). YAML 1.2.2 makes a tag part
// of what a node IS (§3.2.1.1) and an alias refer to the SAME node as its
// anchor, not an equal one (§3.2.2, §7.1) — a value model that drops both
// cannot represent what it parsed. `YamlDecorated` carries that: an
// `Option<string>` anchor name, an `Option<string>` resolved tag URI (`!!str`
// becomes `tag:yaml.org,2002:str`, a bare `!` stays `!` — see properties.bit's
// `resolveTagText`), and an `Option<string>` alias target name, wrapping
// whichever `Yaml` variant the node actually is. Opt-in, not universal: a
// node with no anchor, tag or alias is never wrapped, so every document that
// uses none of the three parses to the exact same `Yaml` shape as before this
// ticket — zero cost, zero risk, for the overwhelming majority of documents.
//
// TRANSPARENT TO EVERY EXISTING ACCESSOR. `yamlIsBool`/`yamlAsInt`/etc. below
// see straight through a `YamlDecorated` wrapper to the value beneath it, so
// every caller that only cares about VALUE (schema.bit's resolver, encode.bit,
// the JSON-comparison half of the corpus oracle) keeps working unchanged
// whether or not the node it is reading happens to be decorated.
// `yamlDecorationOf` is the one new accessor that does NOT see through the
// wrapper — it is how a caller that cares about anchor/tag/alias identity
// (corpusevents.test.bit's extended serializer, this file's own identity
// test) reads it.
//
// NO TYPE-TAG-DRIVEN INSTANTIATION (epic #1482, restated for this file since
// this is where a tag first becomes reachable data). A tag carried here is
// TEXT a caller may read, never a dispatch key: `schema.bit`'s `yamlResolve`/
// `yamlResolveScalar` decide a scalar's type from its own spelling under the
// YAML 1.2 core schema alone, exactly as before this ticket, and never
// inspect `YamlDecoration.tag` to pick a different representation. Nothing in
// this package instantiates a type FROM a tag string; carrying the text is
// not acting on it.
//
// AN ALIAS NEVER DOUBLES AS AN ANCHOR OR TAG TARGET. `properties.bit`'s
// `rejectAnchorMisplaced` already enforces that an alias node carries no
// property of its own (§7.5), so `YamlDecoration.alias` and
// (`YamlDecoration.anchor`/`.tag`) are mutually exclusive on every node this
// package builds — never both, so a decorated node is wrapped exactly once,
// never nested.
export class YamlDecoration {
  export anchor: Option<string>,
  export tag: Option<string>,
  export alias: Option<string>,
}

// One key/value pair of a YAML mapping, in source order. `key` is `Yaml`,
// not `string` — see this file's header.
export class YamlEntry { export key: Yaml, export value: Yaml }

// A YAML value: the scalar and collection kinds every later file in this
// package builds on.
export enum Yaml {
  YamlNull,
  YamlBool(bool),
  YamlInt(i64),
  YamlFloat(f64),
  YamlString(string),
  YamlSequence([]Yaml),
  YamlMapping([]YamlEntry),
  // Wraps any of the seven arms above with anchor/tag/alias identity — see
  // this file's header. Never constructed directly outside this file;
  // `yamlDecorate` is the one place that builds it, so it is always either
  // absent or carrying at least one of its three fields.
  YamlDecorated(YamlDecoration, Yaml),
}

// Wraps `value` in a `YamlDecorated` when at least one of `anchor`/`tag`/
// `alias` is present, otherwise returns `value` unchanged — the one
// constructor for the eighth arm (this file's header), so a plain node with
// no property never pays for a wrapper it does not need. Unexported:
// `properties.bit` and `flow.bit` are this file's siblings in the same flat
// module (pkg/README.md) and call it unqualified.
fn yamlDecorate(
  value: Yaml,
  anchor: Option<string>,
  tag: Option<string>,
  alias: Option<string>,
): Yaml {
  if (isNone(anchor) && isNone(tag) && isNone(alias)) {
    return value
  }
  return Yaml.YamlDecorated(YamlDecoration{ anchor: anchor, tag: tag, alias: alias }, value)
}

// The decoration on `y`, or `None` when `y` is not a `YamlDecorated` node —
// the one accessor that does NOT see through the wrapper (this file's
// header). `corpusevents.test.bit`'s extended serializer is this
// function's reason to exist.
export fn yamlDecorationOf(y: Yaml): Option<YamlDecoration> {
  match (y) {
    YamlDecorated(d, _) => return Option<YamlDecoration>.Some(d)
    _ => return Option<YamlDecoration>.None
  }
}

// The value beneath any `YamlDecorated` wrapper, or `y` itself when it is
// not decorated — one layer only (this file's header: a node is wrapped at
// most once, never nested), which is all `yamlIs*`/`yamlAs*` below ever
// need to see through.
fn yamlUndecorated(y: Yaml): Yaml {
  match (y) {
    YamlDecorated(_, inner) => return inner
    _ => return y
  }
}

export fn yamlIsNull(y: Yaml): bool {
  match (yamlUndecorated(y)) {
    YamlNull => return true
    YamlBool(_) => return false
    YamlInt(_) => return false
    YamlFloat(_) => return false
    YamlString(_) => return false
    YamlSequence(_) => return false
    YamlMapping(_) => return false
    YamlDecorated(_, _) => panic("yaml: internal: yamlUndecorated leaked a YamlDecorated")
  }
}

export fn yamlIsBool(y: Yaml): bool {
  match (yamlUndecorated(y)) {
    YamlNull => return false
    YamlBool(_) => return true
    YamlInt(_) => return false
    YamlFloat(_) => return false
    YamlString(_) => return false
    YamlSequence(_) => return false
    YamlMapping(_) => return false
    YamlDecorated(_, _) => panic("yaml: internal: yamlUndecorated leaked a YamlDecorated")
  }
}

export fn yamlIsInt(y: Yaml): bool {
  match (yamlUndecorated(y)) {
    YamlNull => return false
    YamlBool(_) => return false
    YamlInt(_) => return true
    YamlFloat(_) => return false
    YamlString(_) => return false
    YamlSequence(_) => return false
    YamlMapping(_) => return false
    YamlDecorated(_, _) => panic("yaml: internal: yamlUndecorated leaked a YamlDecorated")
  }
}

export fn yamlIsFloat(y: Yaml): bool {
  match (yamlUndecorated(y)) {
    YamlNull => return false
    YamlBool(_) => return false
    YamlInt(_) => return false
    YamlFloat(_) => return true
    YamlString(_) => return false
    YamlSequence(_) => return false
    YamlMapping(_) => return false
    YamlDecorated(_, _) => panic("yaml: internal: yamlUndecorated leaked a YamlDecorated")
  }
}

export fn yamlIsString(y: Yaml): bool {
  match (yamlUndecorated(y)) {
    YamlNull => return false
    YamlBool(_) => return false
    YamlInt(_) => return false
    YamlFloat(_) => return false
    YamlString(_) => return true
    YamlSequence(_) => return false
    YamlMapping(_) => return false
    YamlDecorated(_, _) => panic("yaml: internal: yamlUndecorated leaked a YamlDecorated")
  }
}

export fn yamlIsSequence(y: Yaml): bool {
  match (yamlUndecorated(y)) {
    YamlNull => return false
    YamlBool(_) => return false
    YamlInt(_) => return false
    YamlFloat(_) => return false
    YamlString(_) => return false
    YamlSequence(_) => return true
    YamlMapping(_) => return false
    YamlDecorated(_, _) => panic("yaml: internal: yamlUndecorated leaked a YamlDecorated")
  }
}

export fn yamlIsMapping(y: Yaml): bool {
  match (yamlUndecorated(y)) {
    YamlNull => return false
    YamlBool(_) => return false
    YamlInt(_) => return false
    YamlFloat(_) => return false
    YamlString(_) => return false
    YamlSequence(_) => return false
    YamlMapping(_) => return true
    YamlDecorated(_, _) => panic("yaml: internal: yamlUndecorated leaked a YamlDecorated")
  }
}

// The bool payload, or None when `y` is not a YamlBool — a shape mismatch
// while decoding untrusted YAML is data, not a crash. `YamlNull` has no
// payload to return, so unlike the other five arms it gets no `yamlAsNull`,
// mirroring stdlib/json/value.bit's `jsonAsBool`..`jsonAsObject` set, which
// omits `jsonAsNull` for the same reason.
export fn yamlAsBool(y: Yaml): Option<bool> {
  match (yamlUndecorated(y)) {
    YamlBool(b) => return Option<bool>.Some(b)
    YamlNull => return Option<bool>.None
    YamlInt(_) => return Option<bool>.None
    YamlFloat(_) => return Option<bool>.None
    YamlString(_) => return Option<bool>.None
    YamlSequence(_) => return Option<bool>.None
    YamlMapping(_) => return Option<bool>.None
    YamlDecorated(_, _) => panic("yaml: internal: yamlUndecorated leaked a YamlDecorated")
  }
}

// The int payload, or None when `y` is not a YamlInt.
export fn yamlAsInt(y: Yaml): Option<i64> {
  match (yamlUndecorated(y)) {
    YamlInt(i) => return Option<i64>.Some(i)
    YamlNull => return Option<i64>.None
    YamlBool(_) => return Option<i64>.None
    YamlFloat(_) => return Option<i64>.None
    YamlString(_) => return Option<i64>.None
    YamlSequence(_) => return Option<i64>.None
    YamlMapping(_) => return Option<i64>.None
    YamlDecorated(_, _) => panic("yaml: internal: yamlUndecorated leaked a YamlDecorated")
  }
}

// The float payload, or None when `y` is not a YamlFloat.
export fn yamlAsFloat(y: Yaml): Option<f64> {
  match (yamlUndecorated(y)) {
    YamlFloat(f) => return Option<f64>.Some(f)
    YamlNull => return Option<f64>.None
    YamlBool(_) => return Option<f64>.None
    YamlInt(_) => return Option<f64>.None
    YamlString(_) => return Option<f64>.None
    YamlSequence(_) => return Option<f64>.None
    YamlMapping(_) => return Option<f64>.None
    YamlDecorated(_, _) => panic("yaml: internal: yamlUndecorated leaked a YamlDecorated")
  }
}

// The string payload, or None when `y` is not a YamlString.
export fn yamlAsString(y: Yaml): Option<string> {
  match (yamlUndecorated(y)) {
    YamlString(s) => return Option<string>.Some(s)
    YamlNull => return Option<string>.None
    YamlBool(_) => return Option<string>.None
    YamlInt(_) => return Option<string>.None
    YamlFloat(_) => return Option<string>.None
    YamlSequence(_) => return Option<string>.None
    YamlMapping(_) => return Option<string>.None
    YamlDecorated(_, _) => panic("yaml: internal: yamlUndecorated leaked a YamlDecorated")
  }
}

// The sequence payload, or None when `y` is not a YamlSequence.
export fn yamlAsSequence(y: Yaml): Option<[]Yaml> {
  match (yamlUndecorated(y)) {
    YamlSequence(s) => return Option<[]Yaml>.Some(s)
    YamlNull => return Option<[]Yaml>.None
    YamlBool(_) => return Option<[]Yaml>.None
    YamlInt(_) => return Option<[]Yaml>.None
    YamlFloat(_) => return Option<[]Yaml>.None
    YamlString(_) => return Option<[]Yaml>.None
    YamlMapping(_) => return Option<[]Yaml>.None
    YamlDecorated(_, _) => panic("yaml: internal: yamlUndecorated leaked a YamlDecorated")
  }
}

// The entries of a YamlMapping, in source order, or None when `y` is not a
// YamlMapping. Returns the same `[]YamlEntry` the value already stores — no
// copy — so source order and any duplicate keys the parser chose to keep
// are both preserved exactly as parsed.
export fn yamlAsMapping(y: Yaml): Option<[]YamlEntry> {
  match (yamlUndecorated(y)) {
    YamlMapping(m) => return Option<[]YamlEntry>.Some(m)
    YamlNull => return Option<[]YamlEntry>.None
    YamlBool(_) => return Option<[]YamlEntry>.None
    YamlInt(_) => return Option<[]YamlEntry>.None
    YamlFloat(_) => return Option<[]YamlEntry>.None
    YamlString(_) => return Option<[]YamlEntry>.None
    YamlSequence(_) => return Option<[]YamlEntry>.None
    YamlDecorated(_, _) => panic("yaml: internal: yamlUndecorated leaked a YamlDecorated")
  }
}

// THE SECURITY BUDGET. Every later file in this package — the scanner, the
// parser, anchor/alias resolution — reads these limits rather than
// inventing its own number; this package carries a `security` label for
// exactly this reason. Anchor and alias expansion is a denial-of-service
// vector, the "billion-laughs" attack, where a handful of chained anchors
// expand a few hundred bytes of input into gigabytes of materialized
// nodes. None of these fields may be unbounded or optional-by-default.
export class YamlLimits {
  // Nesting levels a document's mappings and sequences may reach, combined.
  // stdlib/json's own `jsonMaxDepth` (stdlib/json/lex.bit) is 128 for the
  // same reason: real documents (Kubernetes manifests, nested Helm values
  // files) rarely exceed 20-30 levels of container nesting, so 128 leaves
  // generous headroom while still bounding recursion depth against a
  // pathologically deep chain of single-entry mappings or sequences.
  export maxDepth: i64,
  // Total alias resolutions permitted across one document. The
  // billion-laughs shape chains anchors so each level multiplies the
  // reference count of the level below it — 9 levels referencing the prior
  // level 9 times each is 387,420,489 expansions from well under a
  // kilobyte of source. Real reuse (a Kubernetes manifest set or a Helm
  // values file referencing a handful of common anchors a few dozen times
  // each) stays in the low thousands. 100,000 rejects an exponential chain
  // by its sixth multiplicative level while leaving an order of magnitude
  // of headroom over any legitimate count observed.
  export maxAliasExpansions: i64,
  // Scalar and collection nodes materialized for one document, counting
  // every alias expansion's copies. This is the actual memory bound:
  // `maxAliasExpansions` alone caps resolution COUNT, not the size of what
  // each resolution copies, so a single large aliased sequence replayed
  // near the expansion ceiling would still be unbounded without this.
  // 1,000,000 nodes covers even a large generated manifest bundle (tens of
  // thousands of nodes) with orders of magnitude to spare, while a
  // document that reaches it is charged a bounded, predictable amount of
  // memory before it is rejected.
  export maxTotalNodes: i64,
  // Raw input size, in bytes, a document may be before parsing starts.
  // Hand-written configuration and CI manifests are near-universally under
  // 1 MB; generated multi-document bundles (a Helm chart's rendered
  // templates, a kustomize build) can run into low single-digit megabytes.
  // 10,000,000 (10 MB) covers that with headroom while rejecting a
  // multi-gigabyte payload before a single byte is scanned.
  export maxDocumentBytes: i64,
}

// The limits every yaml decode uses unless a caller overrides them. Every
// field here is checked to be greater than zero in value.test.bit: a zero
// or negative limit is indistinguishable from "unbounded" to a guard like
// `depth >= limits.maxDepth`, so a default that could reach zero would
// silently disable the budget this file exists to enforce.
export fn yamlDefaultLimits(): YamlLimits {
  return YamlLimits{
    maxDepth: 128,
    maxAliasExpansions: 100_000,
    maxTotalNodes: 1_000_000,
    maxDocumentBytes: 10_000_000,
  }
}
