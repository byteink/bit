// pkg/yaml/value.test.bit — Yaml/YamlEntry accessors and the YamlLimits
// budget, beside the file they test (pkg/README.md's layout rule).
//
// #5818: `isSome`/`isNone`/`unwrap` are imported by value.bit now, not here —
// a name bound only by a `.test.bit` sibling's import is invisible to the
// rest of the module (SPEC §17.1), and this module's own non-test files call
// them directly.

test "yamlIsNull is true only for YamlNull" {
  assert(yamlIsNull(Yaml.YamlNull), "YamlNull must report yamlIsNull")
  assert(!yamlIsNull(Yaml.YamlBool(true)), "YamlBool must not report yamlIsNull")
}

test "yamlAsBool returns the payload for YamlBool, None otherwise" {
  let got = yamlAsBool(Yaml.YamlBool(true))
  assert(isSome(got), "YamlBool must yield Some")
  assert(unwrap(got) == true, "expected the bool payload back unchanged")
  assert(isNone(yamlAsBool(Yaml.YamlNull)), "YamlNull must yield None")
}

test "yamlAsInt and yamlAsFloat round-trip their own arm only" {
  assert(unwrap(yamlAsInt(Yaml.YamlInt(7))) == 7, "YamlInt payload")
  assert(isNone(yamlAsInt(Yaml.YamlFloat(7.0))), "YamlFloat is not a YamlInt")
  assert(unwrap(yamlAsFloat(Yaml.YamlFloat(1.5))) == 1.5, "YamlFloat payload")
  assert(isNone(yamlAsFloat(Yaml.YamlInt(1))), "YamlInt is not a YamlFloat")
}

test "yamlAsString round-trips the payload" {
  let got = yamlAsString(Yaml.YamlString("hi"))
  assert(isSome(got), "YamlString must yield Some")
  assert(unwrap(got) == "hi", "expected the string payload back unchanged")
}

test "yamlAsSequence preserves order, no copy of identity" {
  let seq = [Yaml.YamlInt(1), Yaml.YamlInt(2), Yaml.YamlInt(3)]
  let got = yamlAsSequence(Yaml.YamlSequence(seq))
  assert(isSome(got), "YamlSequence must yield Some")
  let back = unwrap(got)
  assert(len(back) == 3, "expected 3 elements, got ${len(back)}")
  assert(unwrap(yamlAsInt(back[0])) == 1, "element 0")
  assert(unwrap(yamlAsInt(back[2])) == 3, "element 2")
}

// A non-scalar key (a sequence used as a mapping key) is exactly what
// `YamlEntry.key: Yaml` exists to represent — a `string` key could not hold
// this at all (this file's own header, and #5491).
test "YamlEntry.key accepts a non-scalar Yaml, not just a string" {
  let key = Yaml.YamlSequence([Yaml.YamlInt(1), Yaml.YamlInt(2)])
  let entry = YamlEntry{ key = key, value = Yaml.YamlString("v") }
  let gotKey = yamlAsSequence(entry.key)
  assert(isSome(gotKey), "entry.key must still be the sequence it was built with")
  assert(len(unwrap(gotKey)) == 2, "entry.key sequence length")
  assert(unwrap(yamlAsString(entry.value)) == "v", "entry.value")
}

test "yamlAsMapping preserves source order and entry count" {
  let entries = [
    YamlEntry{ key = Yaml.YamlString("a"), value = Yaml.YamlInt(1) },
    YamlEntry{ key = Yaml.YamlString("b"), value = Yaml.YamlInt(2) },
  ]
  let got = yamlAsMapping(Yaml.YamlMapping(entries))
  assert(isSome(got), "YamlMapping must yield Some")
  let back = unwrap(got)
  assert(len(back) == 2, "expected 2 entries, got ${len(back)}")
  assert(unwrap(yamlAsString(back[0].key)) == "a", "entry 0 key, source order")
  assert(unwrap(yamlAsInt(back[1].value)) == 2, "entry 1 value, source order")
}

// The whole point of this file's second half: no field of the default
// budget may be zero (or negative), because a zero limit reads as
// "unbounded" to a `>=` guard and would silently disable the very defense
// against billion-laughs this file exists to ship (#5491).
test "every yamlDefaultLimits() field is greater than zero" {
  let limits = yamlDefaultLimits()
  assert(limits.maxDepth > 0, "maxDepth must be > 0, got ${limits.maxDepth}")
  assert(
    limits.maxAliasExpansions > 0,
    "maxAliasExpansions must be > 0, got ${limits.maxAliasExpansions}",
  )
  assert(limits.maxTotalNodes > 0, "maxTotalNodes must be > 0, got ${limits.maxTotalNodes}")
  assert(
    limits.maxDocumentBytes > 0,
    "maxDocumentBytes must be > 0, got ${limits.maxDocumentBytes}",
  )
}
