// pkg/yaml/anchor.bit — yaml module, anchor/alias resolution under the
// package's expansion budget (#5497, epic #1482). `value.bit` and
// `scan.bit` are siblings in this same flat module (pkg/README.md).
//
// THE ATTACK. YAML lets a node be named (`&a`) and referenced (`*a`).
// Because an alias may point at an anchor that itself contains aliases,
// expansion is MULTIPLICATIVE: nine anchors each referencing the previous
// one nine times is 9 levels of 9-ary nesting, and the node count the last
// level stands for is 9^9 — 387,420,489 — from well under a kilobyte of
// source (`value.bit`'s own `maxAliasExpansions` comment does the exact
// arithmetic). This file is the only place in the package that resolves an
// alias, so it is the only place that can stop that multiplication.
//
// A DOCUMENT-WIDE RUNNING BUDGET, NOT A PER-NODE ONE. `AnchorTable` carries
// `aliasExpansions`/`totalNodes`/`materializedBytes` as mutable state that
// accumulates across every `yamlAnchorResolve` call for the whole document —
// never reset per anchor, per call, or per node — because a cap that resets
// cannot bound a multiplicative total. All three are checked against `YamlLimits`
// (`value.bit`, #5491): this file reads that budget, it never invents its
// own number.
//
// COUNTING NODES AND BYTES, NOT JUST RESOLUTIONS, AND WHY EACH IS BOUNDED WORK.
// `yamlAnchorResolve` never deep-copies the value stored under an anchor —
// it hands back the same object, so resolving an alias costs this table
// only a shared reference, not new memory. What it DOES cost, and what a
// caller that goes on to walk or re-serialize the substituted tree WOULD
// pay in full, is however many nodes that subtree logically stands for —
// which for a chained alias is the very count the attack multiplies. This
// file charges that cost up front, at resolve time, via `countMaterialized`
// below: a walk that aborts the instant the running total would exceed the
// budget remaining, rather than ever completing a full walk of a subtree
// the multiplication has made enormous. That early abort is what keeps
// resolving deep into a bomb bounded, exactly as cheap as the budget it is
// bounded by, however many levels the document still has left to offer —
// `anchor.test.bit`'s bomb proves this by timing it.
//
// UNDEFINED AND RECURSIVE ANCHORS ARE THE SAME CHECK, ON PURPOSE. `Yaml`
// (value.bit) has no alias arm: an alias is resolved and substituted before
// the value containing it is ever built, so a caller can only reach
// `yamlAnchorDefine(t, name, ...)` for `name` once every alias inside that
// value has already resolved successfully. An anchor that references
// itself (`&a [*a]`) therefore always tries to resolve `a` before `a`'s own
// `yamlAnchorDefine` call has happened — indistinguishable, at this table,
// from `a` never having been defined at all. No separate recursion check is
// needed or added; the ordering this table requires makes one impossible to
// reach without the other already having failed.
//
// NO TYPE-DRIVEN CONSTRUCTION. This file resolves names to already-built
// `Yaml` values; it has no notion of a YAML type indicator at all, so there
// is no path here from untrusted input to selecting or constructing a type.

// One document's anchor table: the most recent `Yaml` recorded under each
// anchor name, plus the three running budgets `yamlAnchorResolve` charges
// against for the whole document (see this file's header).
export class AnchorTable {
  entries: map<string, Yaml>,
  aliasExpansions: i64,
  totalNodes: i64,
  materializedBytes: i64,
}

// A fresh table for one document: no anchors defined yet, all three running
// budgets at zero.
export fn newAnchorTable(): AnchorTable {
  return AnchorTable{
    entries = map<string, Yaml>(),
    aliasExpansions = 0,
    totalNodes = 0,
    materializedBytes = 0,
  }
}

// Records `node` — already fully resolved, with no unresolved alias inside
// it (see this file's header) — under `name`. YAML permits an anchor name
// to be redefined later in a document; a later alias always takes the most
// recent definition, so this simply overwrites any earlier entry.
export fn yamlAnchorDefine(t: AnchorTable, name: string, node: Yaml): ()! {
  if (len(name) == 0) {
    fail newError("yaml: anchor name must not be empty")
  }
  t.entries[name] = node
}

// The outcome of walking a `Yaml` subtree to price a `yamlAnchorResolve`
// call: `count` nodes and `bytes` string bytes visited, `ok` when the whole
// subtree fit inside the budgets it was walked with, and `depthExceeded` /
// `bytesExceeded` distinguishing a nesting or byte failure from a node-count
// failure so the caller can name the right limit. Unexported: internal to
// this file's counting, never returned to a caller.
class CountResult { count: i64, bytes: i64, ok: bool, depthExceeded: bool, bytesExceeded: bool }

fn countOk(count: i64, bytes: i64): CountResult {
  return CountResult{
    count = count,
    bytes = bytes,
    ok = true,
    depthExceeded = false,
    bytesExceeded = false,
  }
}

fn countFail(): CountResult {
  return CountResult{
    count = 0,
    bytes = 0,
    ok = false,
    depthExceeded = false,
    bytesExceeded = false,
  }
}

fn countDepthFail(): CountResult {
  return CountResult{
    count = 0,
    bytes = 0,
    ok = false,
    depthExceeded = true,
    bytesExceeded = false,
  }
}

fn countBytesFail(): CountResult {
  return CountResult{
    count = 0,
    bytes = 0,
    ok = false,
    depthExceeded = false,
    bytesExceeded = true,
  }
}

// Exactly one node carrying `n` bytes of text (0 for every scalar arm but
// `YamlString`): the scalar arms of `Yaml` have no children to recurse into.
fn countLeaf(budget: i64, bytesBudget: i64, n: i64): CountResult {
  if (budget < 1) {
    return countFail()
  }
  if (n > bytesBudget) {
    return countBytesFail()
  }
  return countOk(1, n)
}

// `items`'s own sequence node, plus every element, each charged against
// whatever budgets remain after its predecessors — so a violation partway
// through stops the walk immediately rather than finishing it.
fn countChildren(
  items: []Yaml,
  budget: i64,
  bytesBudget: i64,
  depth: i64,
  maxDepth: i64,
): CountResult {
  let total: i64 = 1
  let bytes: i64 = 0
  if (total > budget) {
    return countFail()
  }
  let i = 0
  while (i < len(items)) {
    let r = countMaterialized(items[i], budget - total, bytesBudget - bytes, depth + 1, maxDepth)
    if (!r.ok) {
      return r
    }
    total = total + r.count
    bytes = bytes + r.bytes
    if (total > budget) {
      return countFail()
    }
    i = i + 1
  }
  return countOk(total, bytes)
}

// One mapping entry: its key, then its value, each charged in turn against
// whatever budgets the previous one left.
fn countPair(e: YamlEntry, budget: i64, bytesBudget: i64, depth: i64, maxDepth: i64): CountResult {
  let kr = countMaterialized(e.key, budget, bytesBudget, depth, maxDepth)
  if (!kr.ok) {
    return kr
  }
  let vr = countMaterialized(e.value, budget - kr.count, bytesBudget - kr.bytes, depth, maxDepth)
  if (!vr.ok) {
    return vr
  }
  return countOk(kr.count + vr.count, kr.bytes + vr.bytes)
}

// `entries`'s own mapping node, plus every key/value pair.
fn countEntries(
  entries: []YamlEntry,
  budget: i64,
  bytesBudget: i64,
  depth: i64,
  maxDepth: i64,
): CountResult {
  let total: i64 = 1
  let bytes: i64 = 0
  if (total > budget) {
    return countFail()
  }
  let i = 0
  while (i < len(entries)) {
    let r = countPair(entries[i], budget - total, bytesBudget - bytes, depth, maxDepth)
    if (!r.ok) {
      return r
    }
    total = total + r.count
    bytes = bytes + r.bytes
    if (total > budget) {
      return countFail()
    }
    i = i + 1
  }
  return countOk(total, bytes)
}

fn optionBytes(o: Option<string>): i64 {
  if (isSome(o)) {
    return len(unwrap(o))
  }
  return 0
}

// A decoration's own text: anchor, tag and alias name.
fn decorationBytes(d: YamlDecoration): i64 {
  return optionBytes(d.anchor) + optionBytes(d.tag) + optionBytes(d.alias)
}

// `r`, the count of a decorated node's wrapped value, plus the `own` bytes of
// the decoration around it; a failed `r` passes through unchanged.
fn withDecoration(r: CountResult, own: i64): CountResult {
  if (!r.ok) {
    return r
  }
  return countOk(r.count, r.bytes + own)
}

// Walks `y`, pricing every node and string byte it and its descendants
// stand for against `budget` and `bytesBudget`, bounded to `maxDepth`
// nesting levels — `depth` is the level `y` itself sits at, 1 for whatever
// `yamlAnchorResolve` is charging. An alias chain is depth too (this file's
// ticket): a value stored under one anchor and then aliased into another
// may already carry nesting from an earlier expansion, so this checks `y`'s
// own depth on every call, not only at the document's top level. Recursion
// here is bounded by `maxDepth` itself (at most `YamlLimits.maxDepth`, 128
// by default) — never by `y`'s size, which is exactly the quantity this
// function exists to bound instead of trust.
fn countMaterialized(
  y: Yaml,
  budget: i64,
  bytesBudget: i64,
  depth: i64,
  maxDepth: i64,
): CountResult {
  if (depth > maxDepth) {
    return countDepthFail()
  }
  match (y) {
    YamlSequence(items) => return countChildren(items, budget, bytesBudget, depth, maxDepth)
    YamlMapping(entries) => return countEntries(entries, budget, bytesBudget, depth, maxDepth)
    YamlDecorated(d, inner) => {
      // Decoration (#5555) is not a node of its own, so it costs no extra
      // depth and no extra node budget, but its anchor, tag and alias text is
      // repeated by every alias to it exactly as a string leaf's is, so those
      // bytes are charged first. The wrapped value is always counted by its
      // own contents, never as a leaf: a decorated SEQUENCE or MAPPING
      // (`&anchor [huge, sequence, ...]`) must still be priced by what it
      // holds, or the budget would undercount exactly the shape it bounds.
      let own = decorationBytes(d)
      if (own > bytesBudget) {
        return countBytesFail()
      }
      return withDecoration(
        countMaterialized(inner, budget, bytesBudget - own, depth, maxDepth),
        own,
      )
    }
    YamlString(s) => return countLeaf(budget, bytesBudget, len(s))
    _ => return countLeaf(budget, bytesBudget, 0)
  }
}

// Resolves `name` to the `Yaml` most recently defined under it, charging
// the whole-document running budgets in `t` against `limits` (see this
// file's header for why each is checked and why neither resets). Fails
// naming whichever single limit was hit: `maxAliasExpansions` before doing
// any walk (so a call that was always going to be refused for its own sake
// never pays for counting), then `maxDepth`, `maxTotalNodes` or
// `maxDocumentBytes` (the string and decoration bytes the alias repeats:
// 2,000 aliases to one 1 MB string are 2 GB to any walk though only 2,000
// nodes), whichever `countMaterialized` reports first. The byte total is
// added to `t` only when the resolve succeeds, like the node total.
export fn yamlAnchorResolve(t: AnchorTable, name: string, limits: YamlLimits): Yaml! {
  let (node, found) = t.entries[name]
  if (!found) {
    fail newError("yaml: alias references undefined anchor '${name}'")
  }
  if (t.aliasExpansions + 1 > limits.maxAliasExpansions) {
    fail newError("yaml: alias '${name}' exceeds maxAliasExpansions limit of ${limits.maxAliasExpansions}")
  }
  let remaining = limits.maxTotalNodes - t.totalNodes
  let bytesRemaining = limits.maxDocumentBytes - t.materializedBytes
  let r = countMaterialized(node, remaining, bytesRemaining, 1, limits.maxDepth)
  if (!r.ok) {
    if (r.depthExceeded) {
      fail newError("yaml: alias '${name}' exceeds maxDepth limit of ${limits.maxDepth}")
    }
    if (r.bytesExceeded) {
      fail newError("yaml: alias '${name}' materializes past maxDocumentBytes limit of ${limits.maxDocumentBytes}")
    }
    fail newError("yaml: alias '${name}' materializes past maxTotalNodes limit of ${limits.maxTotalNodes}")
  }
  t.aliasExpansions = t.aliasExpansions + 1
  t.totalNodes = t.totalNodes + r.count
  t.materializedBytes = t.materializedBytes + r.bytes
  return node
}
