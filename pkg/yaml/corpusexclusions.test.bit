// pkg/yaml/corpusexclusions.test.bit - the yaml-test-suite exclusion registry,
// split out of corpus.test.bit when that file passed spec/LINT.md's 800-line
// limit (#5538). Pure move: the harness that walks the corpus, converts
// upstream's JSON and compares stays in corpus.test.bit; this file holds only
// which ids are excluded and why.
//
// Same flat module as corpus.test.bit (pkg/README.md), so `CorpusExclusion`
// and `corpusIsExcluded` are reached unqualified from there, no import.
//
// EVERY LIST HERE IS A PAYDOWN QUEUE TO ZERO, never a place to add. An id
// leaves its list in the SAME commit as the fix that makes it pass, and each
// `reason` names the file that owes the work - several were established by
// hand against the fixture, so shortening one loses the evidence.

// A case this corpus cannot pass without a change to this package's own
// `*.bit` files, or one the corpus itself gives no ground truth for. `id` is
// corpus-root-relative, e.g. `"229Q"` or `"Y79Y/000"`.
class CorpusExclusion { id: string, reason: string }

// Builds one reason-group's worth of entries — kept as its own function so
// `corpusExclusionList` stays a short list of calls (spec/LINT.md's 80-line
// ceiling) instead of one long literal.
fn corpusExclusionsFor(ids: []string, reason: string): []CorpusExclusion {
  let out = []CorpusExclusion(0, len(ids))
  let i = 0
  while (i < len(ids)) {
    out = append(out, CorpusExclusion{ id = ids[i], reason = reason })
    i = i + 1
  }
  return out
}

fn corpusAppendAll(dst: []CorpusExclusion, src: []CorpusExclusion): []CorpusExclusion {
  let i = 0
  while (i < len(src)) {
    dst = append(dst, src[i])
    i = i + 1
  }
  return dst
}

// #5542 gave every id in this group a real oracle: `corpusEventCheck`
// (corpusevents.test.bit) serializes the parsed value to upstream's own
// `test.event` base grammar (+STR/+DOC/+MAP/+SEQ/=VAL and their closers) and
// compares. Only 4 of the original 29 closed that way (4FJ6, 6PBE, KK5P,
// SBG9 — their non-scalar key is exactly what that grammar can express and
// JSON cannot, AND every other construct in their document already parses
// today). The 25 that remain split into two real causes, neither of which
// this ticket owns a fix for (constraint: parse.bit/flow.bit/scalar.bit are
// three sibling agents' files):
//
// 2 remain, needing a construct `#5542` scoped OUT of this oracle entirely.
// #5555 implemented the value-model change #5547/#5548 called for
// (`value.bit`'s `YamlDecorated`/`yamlDecorationOf`, carrying anchor/tag/
// alias identity through parsing) and closed 4 of the original 8 on it:
// RZP5, XW4D (an anchor on a SEQ node), 6M2F (an anchor AND an alias
// referencing it) and UKK6/02 (the bare `!` non-specific tag). #5557 closed
// a 5th: X38W — `{ &a [a, &b b]: *b, *a : [c, *b, d]}` needed duplicate-key
// detection itself to follow alias IDENTITY, not resolved structure
// (`flow.bit`'s new `flowKeySame`, YAML 1.2.2 §3.2.1.1/§3.2.2/§7.1: keys
// are unique over representation-graph NODES — `*a` denotes the exact node
// `&a` defined, but that is the SAME node its own anchor occurrence already
// IS, not a second reference to it, so the pair is not a duplicate key,
// while a merely structurally-identical but separately anchored node still
// would not be either). #5556 closed a 6th, 6BFJ: `applyAnchorChain`
// (properties.bit) now splits a 2-name chain collapsed onto a mapping —
// `names[0]` decorates the CONTAINER, `names[len-1]` decorates the
// container's own first KEY (never the same node twice) — matching YAML
// 1.2.2 §6.9 (a property belongs to the node it immediately precedes).
// `&mapping\n&key [ &item a, b, c ]: value` now emits `+MAP &mapping` /
// `+SEQ &key` exactly as `test.event` does. #5558 closed the last 2, both in
// `parse.bit`, neither `6BFJ`'s chain-attribution shape (verified by
// isolating each of `PW8X`'s 6 items and diffing alone):
//   PW8X/FH7J item 1 (`- &a` / `- !!str`, nothing else on its own line,
//     followed by a SIBLING `-` at the identical column) — `dispatchBlockNode`'s
//     `SeqEntry` case was reading the sibling as nesting a new sequence
//     under this item instead of ending it empty and returning to
//     `parseBlockSequence`'s own loop. Fixed by requiring a pending
//     property AND `col <= foldFloor` (`NodeCtx.seqItem`'s own header):
//     dedented (or same-column, sequence-item-only, §8.19 exempts only a
//     MAPPING value) can never be this node's own nested sequence.
//   PW8X items 3/4/5 (`&a : a`, `&c : &a`, `? &e\n: &a`) — `dispatchImplicitEmptyKey`
//     was decorating the WHOLE synthesized mapping (`applyAnchor` wrapped
//     around `parseBlockMapping`'s return) instead of just the bare-`:`
//     empty KEY itself (YAML 1.2.2 §6.9), and item 5's explicit key read
//     (`readExplicitEntry`) additionally needed the same dedented-past-my-
//     own-floor guard as the `SeqEntry` fix above, gated on a pending
//     property so `M2N8/00`'s unrelated `- ? : x` (no property at all) is
//     untouched.
//
// 17 were real, currently-open parse.bit/flow.bit gaps the base-grammar
// oracle now SURFACES rather than masks (previously any non-empty failure
// reason read as "still excluded", parse bug or not — #5536's own staleness
// check cannot see a wrong reason, only a right one). #5552 closed the 5
// that were genuinely flow.bit's (CFD4, DFF7, FRK4, 9MMW, 4ABK, all below)
// and split the remaining 12 by which file actually owns the fix — the
// split itself, not just the fix, is #5552's own deliverable, filed back
// onto the parse.bit sibling ticket:
//   2JQS, NHX8, SM9W/01 — a bare ':' starting a block-context line (an
//     implicit, empty key) is rejected outright ("unexpected token in
//     block context"). parse.bit.
//   UKK6/00, M2N8/00 — the same implicit-empty-key shape as a compact
//     sequence-item mapping ('- :', '- ? : x'). parse.bit.
//   NKF9 — a 4-document stream exercising that same shape in both block
//     AND flow context: #5552 closed its own flow-context documents (2 and
//     4, both `{ ... }`), so this id now needs only parse.bit's fix for its
//     remaining two BLOCK-context documents (1 and 3, bare ':' at the
//     document root) to pass as a whole — confirmed by hand
//     (BIT_REPO=$PWD ./bit-out/bin/bit run against just document 2 or 4 in
//     isolation, each `{ key: value, : empty key }` / `{ : }`, parses
//     clean on this branch).
//   S3PD — an ordinary entry followed by a bare ':' line (2JQS's shape),
//     then a compact quoted-key block-sequence value. parse.bit.
//   LX3P, Q9WF — a flow collection ('[flow]', '{ first: Sammy, last: Sosa
//     }') used directly as an IMPLICIT (no '?') block-mapping key has no
//     accepted grammar path today — the flow collection itself already
//     parses; what is missing is threading it into `readImplicitEntry`'s
//     own block-mapping-key detection. parse.bit.
//   (M5DY, an explicit '?' key whose own node was a multi-line BLOCK
//     SEQUENCE, closed by #5549's `corpusExclusionsCompactNesting` fix —
//     `readExplicitEntry`'s key call now threads the sequence's real
//     column the same way its value call does.)
//   M2N8/01 — a compact single-entry mapping used AS a key ('? []: x') is
//     flattened into the outer mapping instead of nesting a second '+MAP'
//     the way test.event requires. (V9D5 was this same shape, '? earth:
//     blue' / ': moon: white'; #5544's multi-line plain scalar fold closed
//     it — the value side, not the key side, was the actual blocker.)
//     parse.bit (the root's own explicit-key/compact-mapping handling, not
//     the flow node `[]` inside it, which already parses standalone).
// #5552 closed the flow.bit half of this group:
//   CFD4 — a flow SEQUENCE entry spelled as a bare ':' (implicit empty
//     key), spaced ('[ : empty key ]') or glued ('[: another empty key]').
//   DFF7, FRK4 — the flow MAPPING counterpart of CFD4's gap, plus FRK4's
//     own second shape: an explicit '? key :' whose PLAIN key absorbed the
//     trailing ' :' into its own text instead of splitting there (no
//     separating blank after the ':', scan.bit's own `isColonBoundary`
//     boundary rule).
//   9MMW — a flow SEQUENCE compact-pair with a JSON-like (quoted or flow
//     collection) key glued with zero gap to its own trailing ':value'
//     ('{JSON: like}:adjacent') was rejected outright
//     ("expected ',' or closing bracket") rather than accepted the way a
//     flow MAPPING's own entry already was.
//   4ABK — a flow-mapping PLAIN-scalar key glued directly to its trailing
//     ':' before a flow terminator ('omitted value:,') absorbed the ':'
//     into the scalar's own text instead of splitting at it.
fn corpusExclusionsNoJson(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["2JQS"],
    "upstream ships no in.json for this valid case (its value is not representable in JSON — a non-scalar or empty mapping key), and #5542's base-grammar test.event oracle (corpusEventCheck, corpusevents.test.bit) cannot pass it either: it is a real, currently-open parse.bit gap, not a harness limitation — see this function's own header for which construct each id needs",
  )
}

// #5549 (this ticket's own required side-fix, not its own scope, same
// reason as `corpusExclusionsRootIndentation`'s own header): RZT7's THIRD
// document's 'Stack:' was exactly `corpusExclusionsCompactNesting`'s own
// gap (a block sequence of compact nested mappings, '- file: ...\n  line:
// ...\n  code: |...'); that group's fix closes this one too.
fn corpusExclusionsMultiDoc(): []CorpusExclusion {
  return corpusExclusionsFor(
    [],
    "empty: RZT7, this group's only id, closed by #5549's compact-nesting fix (corpusExclusionsCompactNesting's own header)",
  )
}

// Every function below groups a real, currently-open gap in this package's
// own parse.bit/scan.bit/scalar.bit/block.bit/flow.bit/anchor.bit files
// (none of which this ticket owns or edits), found by running the corpus and
// reading the fixture behind every failure — grouped by the construct that
// trips it, filed on smash #5500 for a compiler engineer to split into
// per-file follow-up tickets. Shrink the relevant list in the SAME commit
// that fixes each area — never leave a fixed case excluded.

// #5528 fixed the single-level case (properties alone on their own line,
// value starting exactly one line deeper — root, mapping value or block
// sequence item): 2AUY/4RWC/F2C7/57H4/6JWB/7BMT/U3XV now pass. #5549 closed
// eight more:
//   BU8L — THREE chained indentation levels (`&anchor` inline, `!!map`
//     alone one line down, the mapping body a further line down still) —
//     `consumePropertyChain` (properties.bit) generalizes `parseBlockNode`'s
//     old exactly-once `Indent` re-entry into a bounded loop.
//   SKE5 — an anchor alone on its own line immediately before a sequence
//     `-` at a SHALLOWER column (not a mapping value) left a `Dedent`
//     pending that nothing drained before `dispatchBlockNode`'s switch (no
//     `Dedent` case there); `consumePropertyChain` drains it, same as
//     `parseBlockMapping`/`parseBlockSequence`'s own loops already did.
//   26DV/E76Z/HMQ5/ZWK4 — an alias or a property-bearing scalar used
//     directly as a compact mapping key (`*alias1 : scalar3`, `&anchor6
//     b6: 2`) needed the SAME key/value column threading `readImplicitEntry`
//     already gave an ordinary scalar key: `readImplicitKey`/`readKeyPrimary`
//     (properties.bit) extend it to one wrapped in properties or produced by
//     `parseAlias`, and `parseScalarOrMapping`'s new `pendingAnchor`
//     parameter (plainfold.bit) applies a SAME-LINE anchor to the key
//     immediately, before it is known to be one, rather than deferring to
//     whatever the enclosing dispatch returns (E76Z's `&a a: &b b` needs
//     `*a`, read later, to resolve to the scalar `"a"`, not to the mapping
//     `{"a":"b"}`). Incidentally closed 2SXE (`corpusExclusionsAliasUndefined`,
//     same mechanism — `&a: key: &a value` is an anchored KEY, not a
//     malformed anchor NAME scan).
//   M5C3 — `!foo\n>1\n value` chains a TAG (own line) into a BLOCK SCALAR
//     header on a SHALLOWER line still (`folded:`'s own column, not the
//     tag's) — `dispatchBlockNode`'s `BlockScalarHeader` case was passing
//     the property chain's own (now stale) `indent` as `parentIndent`
//     instead of `foldFloor`, the enclosing node's true baseline
//     `parseAfterIndicator` already threads down for exactly this reason.
//     Also gave `dispatchBlockNode` an `Eof`/`DocStart`/`DocEnd`/`Dedent`
//     case (a property with NOTHING after it at all resolves to an empty
//     plain scalar, the same as an ordinary `key:` with no value already
//     does) — needed by LE5A below, not this group, but discovered fixing
//     it (LE5A's own last item, `- !!str` at end of stream, used to crash
//     `dispatchBlockNode`'s `default` arm instead).
//   9KAX — a chained anchor/tag past what ONE `consumeNodeProperties` call
//     can hold (YAML's own one-anchor-one-tag-per-node limit) needs a
//     SECOND node's own properties read too, and unlike BU8L's, this one's
//     second line sits at the SAME column as the first (this file's own
//     root, never indented further) — no `Indent` token separates them at
//     all. `consumePropertyChain`'s own loop now re-enters on a bare
//     `Anchor`/`Tag` token, not only `Indent`.
// What remains excluded needs a wider mechanism, past this ticket's own
// scope (parse.bit's tag handling is "consumed and ignored" by design,
// epic constraint — `corpusExclusionsExplicitTagType`'s own S4JQ names the
// same boundary):
//   LE5A — `- !!str` (last item, no value) now parses as an empty PLAIN
//     scalar (M5C3's own Eof/Dedent fix above), but resolves through the
//     SAME core-schema null/empty rule any untagged empty scalar does —
//     `""` (a forced string) needs tag-driven typing this package does
//     not implement, the same gap S4JQ's own group already tracks.
//   735Y/C4HZ (#5536) — paid down: both already parse without error AND
//     structurally match in.json, so the "fidelity gap" this comment used to
//     name them for no longer exists; #5536's own detector (corpus.test.bit)
//     is what caught them still sitting here, still excluded, silently
//     passing.
fn corpusExclusionsAnchorTagNewline(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["LE5A"],
    "parse.bit: a node's anchor and/or tag, spanning multiple property-only lines or interacting with an alias/sequence/multi-document shape beyond the single-level case #5528 closed, is not threaded through correctly — see this function's own header for the mechanism each remaining id needs",
  )
}

// #5549 (this ticket's own required side-fix, not its own scope — this
// file's own top-of-file paydown-queue rule and #5536's staleness gate,
// which fails on ANY stale id regardless of which function holds it): 93JH
// combined a non-zero root indentation with a compact nested block
// collection, exactly `corpusExclusionsCompactNesting`'s own gap; that
// group's fix (see its own header) closes this one too.
fn corpusExclusionsRootIndentation(): []CorpusExclusion {
  return corpusExclusionsFor(
    [],
    "empty: 93JH, this group's only id, closed by #5549's compact-nesting fix (corpusExclusionsCompactNesting's own header)",
  )
}

// #5544 closed both: NB6Z/UV7Q needed exactly the same fold
// corpusExclusionsPlainScalarFold's own group tracked (parse.bit's
// `extendPlainFold`, driven off `Scanner.col` regardless of whether a tab
// or a space measured it) — the tab in each was already legal separator
// whitespace on its own, per #5530. Kept as a function (not deleted, this
// file's own header on `corpusExclusionsEscapeTable`) so a future
// tab-specific gap has a named home.
fn corpusExclusionsTabSeparator(): []CorpusExclusion {
  return corpusExclusionsFor(
    [],
    "empty: NB6Z/UV7Q, this group's only ids, both closed by #5544's multi-line plain scalar fold",
  )
}

// #5550 closed 7FWL: `scan.bit` now recognizes the verbatim tag syntax
// `!<...>` (`scanVerbatimTag`, dispatched from `scanTag`), scanning through
// to the matching `>` instead of stopping at the first byte
// `isIndicatorNameChar` would otherwise exclude from an ordinary name (`:`,
// `,` — a URI's own separators). UGM3 stays excluded: its own verbatim tags
// (`!<tag:clarkevans.com,2002:invoice>`) now scan and parse correctly too,
// but the fixture separately hits `corpusExclusionsCompactNesting`'s own gap
// at its `product:` sequence (`- sku: ...` continuing the mapping on the
// lines after the `-`, byte 341) — confirmed by hand (BIT_REPO=$PWD
// ./bit-out/bin/bit run against UGM3/in.yaml: "unexpected content after
// document (missing '---'?) at byte 341", the first byte of "- sku").
// #5554 confirmed by hand: UGM3's own byte-341 parse error is gone
// (corpusExclusionsCompactNesting's fix, #5549, already covers its
// '- sku: ...' shape too) — it now parses cleanly, but its two
// two-decimal-place prices ('450.00'/'2392.00') resolve to `YamlFloat`
// while `in.json` prints them as bare integers ('450'/'2392'), and
// `corpus.test.bit`'s own `yamlEqualFloat` (flow.bit) calls `yamlAsFloat`
// on the expected side, which returns `None` for a `YamlInt` — a harness
// type-coercion gap in corpus.test.bit/value.bit, not a parse.bit one.
fn corpusExclusionsVerbatimTag(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["UGM3"],
    "corpus.test.bit/value.bit: UGM3 now parses cleanly (#5549's compact-nesting fix already covers its own gap), but its 'price: 450.00'/'price: 2392.00' resolve to YamlFloat while in.json's matching numbers print with no decimal point, and yamlEqualFloat/yamlAsFloat (flow.bit/value.bit) never coerces an expected YamlInt to compare against — a harness/value-model numeric-comparison gap, not this file's",
  )
}

// #5544 closed 9 of 11: a bare multi-line plain scalar now folds correctly
// at the top level, as an explicit key/value, and as a mapping value
// (parse.bit's `extendPlainFold`, called from `parseScalarOrMapping`).
// #5550 closed the last two, FBC9/XLQ9: `scan.bit` tracks
// `Scanner.lastWasPlainScalar` (set only by `scanPlainScalar`, untouched by
// `Indent`/`Dedent`, cleared by every other token kind), and
// `dispatchIndicatorsFoldSensitive` now falls through to plain-scalar
// content for a fresh `!`/`%` reached while it is still set — matching
// spec's `ns-plain-char` (far more permissive mid-scalar than the first
// line's own `ns-plain-first`, which does exclude both). This signal cannot
// tell a bare root scalar's own floor (-1) from an enclosing mapping's (its
// own column) — that distinction is `plainfold.bit`'s `floor` parameter,
// parse.bit's own state — so a '%'/'!' this lets through onto a sibling
// mapping key's column (not deeper than the mapping's own floor) is not
// folded there either: `extendPlainFold`'s existing `col <= floor` check
// stops before consuming it, and the un-consumed token still fails the
// parse one level up (a stray scalar where a key's ':' was expected),
// never silently accepted as content. Verified against the nine
// directive-rejection ids #5532 closed (H7TQ, MUS6/00, MUS6/01, RHX7, SF5V,
// 9HCY, B63P, 9MMA, EB22): none has a bare PlainScalar as the token
// immediately preceding its own `!`/`%` (each is either the very first
// token, or preceded by a Tag/quoted-scalar/Comment/DocStart, all of which
// clear `lastWasPlainScalar`), so `dispatchIndicatorsFoldSensitive` leaves
// every one of them dispatching to `Tag`/`Directive` exactly as before.
fn corpusExclusionsPlainScalarFold(): []CorpusExclusion {
  return corpusExclusionsFor(
    [],
    "empty: FBC9/XLQ9, this group's last two ids, both closed by #5550's dispatchIndicatorsFoldSensitive",
  )
}

// #5549 closed all 8: two distinct parse.bit gaps, both column-threading.
// `compactContinuation` (parse.bit, `parseBlockMapping`/`parseBlockSequence`'s
// own shared loop) drains an `Indent` token sharing the collection's own
// `col`, not only `Dedent` — a compact collection's SECOND member is the
// first genuine line-start at a column the scanner's own indent stack never
// pushed (the first member began inline), so the scanner reads it as a
// fresh deeper level instead of a sibling (3ALJ/4WA9/6BCT/9U5K/W42U).
// `columnOf`/`parseInlineValue` (parse.bit, `parseAfterIndicator`) thread a
// compact sequence VALUE's real inline column, for an explicit `?`/`:`
// entry only (A2M4, 5WE3 "Explicit compact") — 5U3A proved an ordinary
// IMPLICIT `key: - a` must still be REJECTED, now a direct check rather
// than an incidental collision. `extendPlainFold` (plainfold.bit) swallows
// a qualifying-column `SeqEntry` into an already-open plain-scalar fold
// rather than stopping it (AB8U — spec 7.3.3's `ns-plain-char` allows a
// bare `-` on a scalar's CONTINUATION line, unlike its own first line).
fn corpusExclusionsCompactNesting(): []CorpusExclusion {
  return corpusExclusionsFor(
    [],
    "empty: 3ALJ/4WA9/5WE3/6BCT/9U5K/A2M4/AB8U/W42U, this group's only ids, all closed by #5549 (see this function's own header)",
  )
}

// #5544 (this ticket's own required side-fix, not its own scope — see
// corpusexclusions.test.bit's own top-of-file paydown-queue rule and
// `bit test pkg/yaml`'s own staleness gate, which fails on ANY stale id
// regardless of which function holds it): 35KP's third document ('--- !!str\nd\ne')
// was the same bare multi-line plain scalar fold this ticket's own
// corpusExclusionsPlainScalarFold group tracked, just misfiled here by
// whatever '!!str' prefix made it LOOK like a tag-prefix gap; #5544's
// `extendPlainFold` fold now folds 'd'/'e' regardless of what precedes it.
//
// #5554 confirmed both remaining ids by hand, neither a parse.bit fix:
//   3MYT — `k:#foo\n &a !t s` is ONE plain scalar (`extendPlainFold`
//     already folds "k:#foo" into its continuation); `&a`/`!t` on that
//     continuation line must stay ordinary scalar TEXT, never become
//     Anchor/Tag tokens at all — `scan.bit`'s own `lastWasPlainScalar`
//     fold-sensitive dispatch (#5550) covers '!'/'%' only, never '&'/'*';
//     a scan.bit change, not parse.bit's.
//   74H7 — `!!str 23: !!bool false`'s KEY needs the explicit `!!str` to
//     FORCE string typing over "23"'s own implicit int resolution
//     (confirmed: `corpusFindYamlEntry`, corpus.test.bit, looks up the
//     expected `in.json` key "23" as a `YamlString`, never finds our
//     `YamlInt(23)` — every other entry in this fixture already matches).
//     That is tag-driven typing, the same epic #1482 boundary
//     `corpusExclusionsExplicitTagType`'s own S4JQ and
//     `corpusExclusionsAnchorTagNewline`'s own LE5A already track, not a
//     "consumed and ignored" gap this file's tag policy can close.
fn corpusExclusionsTagPrefixValue(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["3MYT", "74H7"],
    "parse.bit/scan.bit: 3MYT needs scan.bit's fold-sensitive dispatch extended to '&'/'*' (a scan.bit change, out of this ticket's own file); 74H7 needs tag-driven typing (an explicit '!!str' forcing string over an otherwise-int implicit resolution) that epic #1482 rules out — see this function's own header",
  )
}

// #5544 (same required side-fix as corpusExclusionsTagPrefixValue above):
// 82AN/EXG3 are each a bare document-root plain scalar whose first line
// happens to start with '---' with no following whitespace ('---word1',
// never a real marker — `isDocMarker` already required whitespace/EOF
// after it) continuing onto a second line ('word2'); the real blocker was
// always the multi-line fold, not marker misdetection — #5544's
// `extendPlainFold` closes both.
fn corpusExclusionsDocMarkerSeparator(): []CorpusExclusion {
  return corpusExclusionsFor(
    [],
    "empty: 82AN/EXG3, this group's only ids, both closed by #5544's multi-line plain scalar fold",
  )
}

fn corpusExclusionsQuotedScalarFold(): []CorpusExclusion {
  return corpusExclusionsFor(
    [],
    "block.bit: empty — MJS9, this group's last id, closed by #5551's `blockLineMoreIndented` (spec 8.1.3's `s-nb-spaced-text(n)`: spaces landing exactly on `blockIndent` with the next byte a tab is still more-indented, folding-literal content); kept as a function (not deleted) so a future block-scalar fold gap has a named home, per this file's own per-area grouping",
  )
}

fn corpusExclusionsExplicitTagType(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["S4JQ"],
    "parse.bit: the bare non-specific tag '!' is meant to force implicit typing off (resolving the scalar as a plain string) per the core schema, but this file's tag handling treats every tag identically (consumed and ignored), so a scalar under '! 12' still resolves through implicit typing to an int",
  )
}

fn corpusExclusionsEscapeTable(): []CorpusExclusion {
  return corpusExclusionsFor(
    [],
    "scalar.bit: every escape spelling the core grammar accepts now decodes (a literal TAB or SPACE byte directly after the backslash, spec 5.7's ns-esc-horizontal-tab/ns-esc-space — KH5V/01, the one fixture that needed only this, already passed); the six ids this group used to also need (3RLN/01, 3RLN/04, DE56/02, DE56/03, NP9H, Q8AD) needed corpusExclusionsQuotedScalarFold's fold-trim fix too, which #5531 closed, so this group is now empty — kept as a function (not deleted) so a future escape-table gap has a named home, per this file's own per-area grouping",
  )
}

// #5545 closed UT92 (#5540 reproduced the mechanism and confirmed the fix
// but could not land it: scan.bit was at the 800-line ceiling; #5537 split
// the file first). `dispatchIndicatorsMarked`'s '%' branch now requires
// `s.flowDepth == 0` before tokenizing `Directive`, so a '%' reached inside
// an open flow collection falls through to `scanPlainScalar` as an ordinary
// `ns-plain-char` continuing the already-open scalar, matching YAML 1.2.2
// §7.3.3 (`%` is a `c-indicator`, excluded from starting a new plain scalar,
// not from continuing one already open). Nothing else excluded here now;
// kept as a function (not deleted) so a future flow-grammar gap has a named
// home, per this file's own per-area grouping.
fn corpusExclusionsFlowGrammarGap(): []CorpusExclusion {
  return corpusExclusionsFor(
    [],
    "scan.bit: reserved for a flow-grammar gap distinct from UT92 (#5545 closed, see this function's own comment)",
  )
}

// #5550 re-traced both (scan.bit was that ticket's own scope; neither id's
// root cause turned out to live there). `scan.bit` already tokenizes `&a:`/
// `*a:` correctly as one Anchor/Alias span each, trailing `:` included
// (`isIndicatorNameChar` does not exclude it) — confirmed by hand
// (BIT_REPO=$PWD ./bit-out/bin/bit run, a scan-only probe dumping
// `scan()`'s own token list for 2SXE's source: `Anchor [0:3] = '&a:'` and
// `Alias [25:28] = '*a:'`, matching names). The real bug was parse.bit's own
// anchor-application ordering: `applyAnchor` registered a name only once
// the ENTIRE value it decorates had been fully built and returned by
// `dispatchBlockNode` — 2SXE's `&a:` decorates what looks like a single
// scalar key ("key") but is only discovered, after the fact, to have
// started a whole block mapping (`parseScalarOrMapping`'s own
// ValueIndicator peek), so the anchor ended up applied to the WHOLE mapping
// (including its second entry, "foo"'s alias) rather than just the key
// scalar. #5549's `pendingAnchor` (`corpusExclusionsAnchorTagNewline`'s own
// header) closes exactly this: the key/value column threading it gives an
// anchored key applies the anchor IMMEDIATELY, before the ValueIndicator
// peek, so 2SXE now resolves "key" before "foo"'s `*a` needs it.
//
// 6KGN's `&anchor` decorates an empty/null node with a SIBLING key at the
// same column right after it, a case `parseAfterIndicator` already
// special-cases (`sameLine`/`Dedent` check) but `parseBlockNode` itself
// still does not, so it tries to parse the next sibling key ("b: *anchor")
// as if it were "a"'s own nested value instead — a parse.bit gap outside
// this ticket's own two functions (constraint: parse.bit's `parseBlockNode`
// beyond `corpusExclusionsCompactNesting`/`corpusExclusionsAnchorTagNewline`
// is out of scope), stays excluded.
// #5554 tried a fresh-line/column check in parseBlockNode's non-descended
// branch (resolve to empty the moment the next token sits at or above
// `indent`) and reverted: `3R3P`'s `&sequence\n- a` shares the identical
// shape (no real `Indent` between the anchor and its own SeqEntry, same
// column) but the anchor there decorates the WHOLE sequence, not an empty
// node — the same ambiguity `compactContinuation`'s own header names for
// `SeqEntry` sharing a collection's column. Broke 5 previously-passing ids
// (3R3P/9KAX/FTA2/SKE5/U3XV) when tried broadly. 6KGN needs a check
// narrower than "any fresh-line sibling column", one that also tells a
// legitimate same-column SeqEntry continuation apart from an actual
// sibling mapping key — still open.
fn corpusExclusionsAliasUndefined(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["6KGN"],
    "parse.bit: parseBlockNode has no same-line/dedent empty-value check the way parseAfterIndicator does, so an anchored empty/null node followed by a sibling key at the same column is not recognized as empty — see this function's own header for the narrower check still needed and the regression a broad one caused",
  )
}

// #5532 closed 6 of 11 (3HFZ/62EZ/9JBA/JY7Z/P2EQ/SU5Z — the document-end
// marker, closed-flow-collection, and unseparated-comment shapes, all
// catchable from parse.bit's own token stream). What remains needs
// flow.bit/scan.bit changes this ticket's scope excludes (its own
// constraint names parse.bit only):
//   9C9N — a flow sequence continuing on a line at the SAME column as its
//     own parent key ("Wrong indented flow sequence") needs an indentation
//     floor threaded into `yamlParseFlow` itself (flow.bit).
//   DK4H/VJP3/00 — a flow mapping's key and `:`, or its `{`/entries, split
//     across lines entirely inside flow.bit's own multi-line handling.
//   N782 — `---`/`...` used as plain scalar content inside a flow
//     collection; flow.bit's scanning, not parse.bit's block-level checks.
//   X4QW — a block scalar header's own trailing `#comment` with no
//     separating space (`>#comment`) is validated inside `yamlDecodeBlockScalar`
//     (block.bit), never reaching parse.bit's token stream as a `Comment`.
fn corpusExclusionsTrailingContent(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["9C9N", "X4QW", "VJP3/00", "DK4H", "N782"],
    "parse.bit/scan.bit: content is accepted after a construct that should already be complete — a closed flow collection, a closed quoted scalar, a document-end ('...') marker, or a '#' that starts a comment without the required preceding whitespace — instead of being rejected as trailing garbage",
  )
}

// #5541 closed the document-marker half — 5TRB/RXY3/9MQT/01 (`'---'`/`'...'`
// at column 0 no longer protected by an open quote, `indexOfDocMarkerLine`
// in scalar.bit). #5551 confirmed the remaining 4 have no block.bit
// mechanism at all (block.bit is block SCALARS only, `|`/`>` headers and
// bodies — it never recognizes a mapping key or a flow-in-block value).
// #5554 closed 7LBH/D49Q/JKF3 (the implicit-key single-line half —
// `readKeyPrimary`'s new `rejectMultilineImplicitKey`, properties.bit,
// rejects a quoted implicit key spanning a raw break before decoding, spec
// 7.4.2). QB6E remains, a different mechanism: a genuine minimum-
// indentation gap, the mapping VALUE's continuation lines ('b'/'c') sit at
// column 0 while the flow-in-block value context requires column >= n+1
// (here 1, the "quoted:" key's own indentation + 1) — scalar.bit's decode
// functions take no such "n"; every caller (parse.bit:474/567, flow.bit:311)
// would need a new parameter threading the current block indentation down,
// and scalar.bit is a sibling ticket's file this week.
fn corpusExclusionsScalarBoundary(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["QB6E"],
    "scalar.bit/parse.bit/flow.bit: a multi-line quoted VALUE's continuation is accepted below the block context's own minimum indentation (n+1) — scalar.bit's decode functions take no key/indentation context from any caller (parse.bit:474/567, flow.bit:311) to enforce it, and none of those three files is this ticket's alone to change",
  )
}

// #5532 closed 9 of 10 (H7TQ/MUS6-00/MUS6-01/RHX7/SF5V/9HCY/B63P/9MMA/EB22).
// QLJ7 stays: its `%TAG !prefix! ...` directive is syntactically WELL-FORMED
// (the four checks this reason names all pass it) — its actual defect is
// that a %TAG handle's scope does not carry past the document it was
// declared in, so `--- !prefix!B` in QLJ7's second/third document uses an
// UNDEFINED handle; catching that needs a per-document declared-handle
// table checked against every tag reference, a materially bigger mechanism
// than validating one directive line's own syntax.
fn corpusExclusionsDirectiveValidation(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["QLJ7"],
    "parse.bit: a malformed '%YAML'/'%TAG' directive (trailing garbage on the directive line, the same directive repeated for one document, a directive placed after a document's own content, or a directive with no document to follow it) is accepted instead of rejected",
  )
}

// Y79Y/000 closed (#5551): `collectBlockLines`'s new `blockLineTabAsIndent`
// rejects a blank body line whose real spaces fall short of `blockIndent`
// but still has a byte (the tab) sitting in the gap before its break —
// exactly the shape `blockLineContent`'s byte-offset cut used to absorb
// silently as if it were legitimate indentation.
//
// Y79Y/003 closed (#5546). #5540 tried YAML 1.2.2 §6.5 `s-flow-line-prefix(n)`
// confined to flow.bit and reverted: the only floor computable purely from
// `Scanner`/`FlowCtx` state is a flow collection's own opening bracket's
// column, and that is NOT `n` - it is systematically too strict (`a:
// [b,\n  c]`'s "]" needs only >n, not >= its own bracket's column) and
// broke 30 previously-passing ids (87E4/L9U5/EHF6/8KB6/JR7V among them,
// `bit test pkg/yaml` with the rule in place: parse dropped 232->202).
//
// #5546 threaded the real `n` instead: `parse.bit`'s `NodeCtx.foldFloor` -
// already correct at every one of its own call sites (`-1` at the document
// root, `parseSeqItemValue`'s `itemCol`, `readMappingEntry`'s own `col`) -
// was simply never passed to `yamlParseFlow`. `dispatchBlockNode` now
// threads it through `parseFlowOrMapping`/`parseBlockFlow` into
// `FlowCtx.n`, and `flow.bit`'s `advanceFlow` rejects a literal tab found
// within the mandatory `n+1` `s-indent` positions of a continuation line
// (`violatesFlowLinePrefix`) - exactly Y79Y/003's shape (`- [\n\tfoo,\n
// foo\n]`, dash at column 0, so `n=0` and byte 0 of the second line must be
// a space). Deliberately narrower than the full rule: a NUMERIC shortfall
// (real content starting before `n+1` spaces are seen at all, with no tab
// involved) is left alone, so `corpusExclusionsTrailingContent`'s 9C9N
// stays exactly as excluded as before - `bit test pkg/yaml`'s own
// excluded-id staleness check confirms only Y79Y/003 flipped.
fn corpusExclusionsTabValidation(): []CorpusExclusion {
  return corpusExclusionsFor(
    [],
    "empty: Y79Y/003, this group's only id, closed by #5546's FlowCtx.n threading (see this function's own header)",
  )
}

// #5554 closed both: `NodeCtx.allowCompact` (parse.bit, false only for an
// ordinary implicit entry's own inline VALUE) now rejects ZCZ6/ZL4Z's
// colon chain the same way 5U3A already rejected a compact SEQUENCE there.
fn corpusExclusionsColonChain(): []CorpusExclusion {
  return corpusExclusionsFor(
    [],
    "empty: ZCZ6/ZL4Z, this group's only ids, both closed by #5554's NodeCtx.allowCompact",
  )
}

// A slice literal is not a `const_expr` (SPEC S11.2), so this is a function,
// not a top-level `const` — same reason toml/corpus.test.bit's own list is a
// function. Split across the many `corpusExclusions*` groups above (each
// under spec/LINT.md's 80-line-per-function ceiling); this just concatenates
// them.
fn corpusExclusionList(): []CorpusExclusion {
  let out = []CorpusExclusion(0)
  out = corpusAppendAll(out, corpusExclusionsNoJson())
  out = corpusAppendAll(out, corpusExclusionsMultiDoc())
  out = corpusAppendAll(out, corpusExclusionsAnchorTagNewline())
  out = corpusAppendAll(out, corpusExclusionsRootIndentation())
  out = corpusAppendAll(out, corpusExclusionsTabSeparator())
  out = corpusAppendAll(out, corpusExclusionsVerbatimTag())
  out = corpusAppendAll(out, corpusExclusionsPlainScalarFold())
  out = corpusAppendAll(out, corpusExclusionsCompactNesting())
  out = corpusAppendAll(out, corpusExclusionsTagPrefixValue())
  out = corpusAppendAll(out, corpusExclusionsDocMarkerSeparator())
  out = corpusAppendAll(out, corpusExclusionsQuotedScalarFold())
  out = corpusAppendAll(out, corpusExclusionsExplicitTagType())
  out = corpusAppendAll(out, corpusExclusionsEscapeTable())
  out = corpusAppendAll(out, corpusExclusionsFlowGrammarGap())
  out = corpusAppendAll(out, corpusExclusionsAliasUndefined())
  out = corpusAppendAll(out, corpusExclusionsTrailingContent())
  out = corpusAppendAll(out, corpusExclusionsScalarBoundary())
  out = corpusAppendAll(out, corpusExclusionsDirectiveValidation())
  out = corpusAppendAll(out, corpusExclusionsTabValidation())
  out = corpusAppendAll(out, corpusExclusionsColonChain())
  return out
}

fn corpusIsExcluded(id: string): bool {
  let exclusions = corpusExclusionList()
  let i = 0
  while (i < len(exclusions)) {
    if (exclusions[i].id == id) {
      return true
    }
    i = i + 1
  }
  return false
}

// The registry's own well-formedness. corpus.test.bit asserts that the list
// LENGTH matches the cases actually skipped; this asserts the list itself is
// sane, which that count cannot see: a duplicated id inflates the length and
// the excluded count together, so the two agree while one id is listed twice
// under two different reasons.
test "the exclusion registry has no duplicate id and no empty reason" {
  let exclusions = corpusExclusionList()
  assert(
    len(exclusions) > 0,
    "yaml corpus: the exclusion registry is empty — corpusExclusionList() wired up wrong, not a corpus at 100%",
  )
  let i = 0
  while (i < len(exclusions)) {
    assert(
      len(exclusions[i].id) > 0,
      "yaml corpus: exclusion at index ${i} has an empty id",
    )
    assert(
      len(exclusions[i].reason) > 0,
      "yaml corpus: exclusion '${exclusions[i].id}' has an empty reason — every id records what it needs",
    )
    let j = i + 1
    while (j < len(exclusions)) {
      assert(
        exclusions[i].id != exclusions[j].id,
        "yaml corpus: id '${exclusions[i].id}' is listed twice (index ${i} and ${j}) — two groups both claim it",
      )
      j = j + 1
    }
    i = i + 1
  }
  print("yaml exclusion registry: ${len(exclusions)} entries, no duplicate id, no empty reason\n")
}
