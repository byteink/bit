// pkg/yaml's side of the parse-throughput comparison against goccy/go-yaml
// and gopkg.in/yaml.v3 (#5501). Not part of the pkg/yaml module — a
// subdirectory of pkg/<name> is a separate module (pkg/README.md), which is
// why this driver lives under bench/apps/bit/ rather than beside parse.bit.
//
// Reads the fixture path from argv[1], parses it once with yamlParseAll, and
// prints one line: "docs=<N> nodes=<N> crc=<u32>". bench/run.sh times the
// whole process externally (the same /usr/bin/time -l technique bench/run.sh
// already uses for the language benchmarks) and computes MB/s and peak RSS
// from that — this program does no timing of its own.
//
// THE CHECKSUM IS THE AGREEMENT PROOF (#5501's own acceptance: "do not
// publish a number without first proving all sides parse the fixture to the
// same checksum"). `canonicalWalk` below and its Go twins in
// ../goccy/main.go / ../yamlv3/main.go must stay byte-for-byte the same
// encoding, or a real disagreement (e.g. implicit-typing "no" vs the string
// "no") would go unnoticed instead of failing run.sh's verify step.
import { arg, argc, exit } from "std/os"
import { readFile } from "std/fs"
import { crc32c } from "std/hash"
import { Builder, newBuilder } from "std/strings"
import {
  Yaml,
  yamlAsBool,
  yamlAsFloat,
  yamlAsInt,
  yamlAsMapping,
  yamlAsSequence,
  yamlAsString,
  yamlIsNull,
  yamlParseAll,
} from "yaml"

// Canonical, order-preserving token encoding of one node's keys and scalar
// values, written into `b`. Returns the number of nodes visited (this node
// plus every descendant), so the caller can sum a document-count-independent
// total across the whole stream.
//
// LENGTH-PREFIXED STRINGS ("S<len>:<bytes>;"), not delimiter-separated: a
// scalar's own text can contain ";" or ":" and must not be able to forge a
// token boundary. Ints and bools are fixed, unambiguous spellings. Floats are
// not exercised by the checked-in fixture (see bench/data/generate.py) — the
// branch below exists so a future fixture addition fails loudly instead of
// silently miscounting, not because today's checksum depends on it.
fn canonicalWalk(y: Yaml, b: Builder): i64 {
  match (yamlAsMapping(y)) {
    Some(entries) => {
      b.write("M").write("${len(entries)}").write(";")
      let count: i64 = 1
      for e of entries {
        count = count + canonicalWalk(e.key, b)
        count = count + canonicalWalk(e.value, b)
      }
      return count
    }
    None => {}
  }
  match (yamlAsSequence(y)) {
    Some(items) => {
      b.write("Q").write("${len(items)}").write(";")
      let count: i64 = 1
      for it of items {
        count = count + canonicalWalk(it, b)
      }
      return count
    }
    None => {}
  }
  return canonicalWalkScalar(y, b)
}

// The scalar half of canonicalWalk, split out to stay under this repo's
// per-function complexity ceiling (spec/LINT.md) — every branch here writes
// exactly one token and returns 1, so splitting costs nothing but a call.
fn canonicalWalkScalar(y: Yaml, b: Builder): i64 {
  match (yamlAsString(y)) {
    Some(s) => {
      b.write("S").write("${len(s)}").write(":").write(s).write(";")
      return 1
    }
    None => {}
  }
  if (yamlIsNull(y)) {
    b.write("N;")
    return 1
  }
  return canonicalWalkNumericLike(y, b)
}

// bool/int/float, plus the "cannot happen on this fixture" fallback — split
// from canonicalWalkScalar for the same complexity-ceiling reason.
fn canonicalWalkNumericLike(y: Yaml, b: Builder): i64 {
  match (yamlAsBool(y)) {
    Some(v) => {
      if (v) {
        b.write("Bt;")
      } else {
        b.write("Bf;")
      }
      return 1
    }
    None => {}
  }
  match (yamlAsInt(y)) {
    Some(v) => {
      b.write("I").write("${v}").write(";")
      return 1
    }
    None => {}
  }
  match (yamlAsFloat(y)) {
    Some(v) => {
      b.write("F").write("${v}").write(";")
      return 1
    }
    None => {}
  }
  b.write("?;")
  return 1
}

fn main(): ()! {
  if (argc() < 2) {
    println("usage: bitbench <path-to-yaml-file>")
    exit(2)
    return
  }
  let path = arg(1)
  let src = readFile(path)?
  let docs = yamlParseAll(src)?

  let b = newBuilder()
  let nodes: i64 = 0
  for d of docs {
    nodes = nodes + canonicalWalk(d, b)
  }
  let sum = crc32c([]byte(b.toString()))
  println("docs=${len(docs)} nodes=${nodes} crc=${sum}")
  return
}
