// pkg/yaml/scalar.bit — yaml module, plain/single-quoted/double-quoted
// scalar decoding (#5493, epic #1482; the flow-fold fix is #5531). Turns the
// raw `[start, end)` spans `pkg/yaml/scan.bit` produces into decoded
// `string` values; `value.bit` and `scan.bit` are siblings in this same
// flat module (pkg/README.md).
//
// THREE STYLES, three rule sets — see `yamlDecodeScalar` for the dispatch:
//
//   - PLAIN has no delimiters and no escapes: a single-line span decodes to
//     itself with leading/trailing space/tab trimmed (spec 6.5/7.3.3 — the
//     scanner hands this file a raw greedy span that still carries that
//     whitespace, e.g. the run before a flow `,`/`]`/`}`/`:` or a same-line
//     `#` comment). A multi-line span (this file's caller may hand one in
//     directly — the scanner itself never emits a `PlainScalar` token
//     crossing a line, `scanPlainScalar` stops at every `\n`/`\r`, but this
//     function's contract is "decode whatever span you are given") folds
//     per `foldContent` below, which trims every line the same way.
//   - SINGLE-QUOTED has exactly one escape, `''` for a literal `'`; no
//     backslash escapes at all (`decodeEscaped`'s table does not apply
//     here). Line folding IS applied (spec 7.3: single-quoted is a flow
//     scalar style, and 6.5's flow folding applies to all three): `''` is
//     collapsed to `'` first, which never writes a `\n`/`\r` byte of its
//     own, so the collapsed content's raw bytes fold exactly like plain's
//     (`foldContent` below), with none of double-quoted's escape-vs-break
//     ambiguity.
//   - DOUBLE-QUOTED is the only style with backslash escapes, and the only
//     one that mixes escapes with line folding: an escaped line break
//     (`\` immediately before `\n`/`\r\n`) is a continuation that removes
//     the break entirely (no space, no fold — though the resumed line's own
//     leading indentation is still trimmed, same as any other line's), and
//     every OTHER embedded break folds too. Because a decoded escape can
//     itself be a whitespace byte (spec 5.7's ns-esc-horizontal-tab/
//     ns-esc-space — DE56/00's trailing `\t` must survive as content, not
//     get trimmed away as if it were indentation), double-quoted trims
//     against the RAW source bytes before decoding any escape
//     (`decodeDoubleQuotedLines` below) rather than sharing plain and
//     single-quoted's decode-then-trim `foldContent`.
//
// LINE FOLDING (spec 6.5's core-grammar rule — no more-indented exception:
// that one is spec 6.5's own `>`-style block-scalar rule, which belongs to
// `block.bit`'s `foldSeparator` call, not to any of the three styles here,
// #5531): split content into physical lines. A single break between two
// lines becomes one space. A run of N consecutive breaks (extra breaks come
// from blank lines in between) becomes N-1 literal newlines. Every line's
// leading AND trailing space/tab is trimmed, uniformly, with exactly two
// exceptions: the whole scalar's own first byte (never trimmed on its
// leading side — it is the content's own boundary, not a fold edge) and its
// own last byte (never trimmed on its trailing side). `foldLines` (plain,
// single-quoted) and `decodeDoubleQuotedLines` (double-quoted) each trim
// their own lines this way; `foldJoin` does the shared joining.
//
// TYPES ARE NOT RESOLVED HERE. Every style decodes to a `string`; whether
// `no` is a boolean or `123` is an int is `pkg/yaml/schema.bit`'s decision.
//
// PERFORMANCE. The common case is a scalar needing no work: `yamlDecodeScalar`
// and each style's decoder scan once for the first byte that needs handling
// (an escape, a doubled quote, a line break) and return the slice directly
// when there is none — no `Builder`, no allocation — mirroring
// `stdlib/json/escape.bit`'s `decodeStringLiteral` fast path.

// `repeat` is already imported into this module by scan.test.bit (same
// module, importing it again here would be E0042 — pkg/README.md's flat
// namespace).
import { Builder, newBuilder, trim, trimLeft, trimRight } from "std/strings"

// This package's own error convention for this file: a message plus the
// byte offset it happened at, mirroring `stdlib/json/parse.bit`'s
// `posError` without that file's line:column pass — this package's callers
// slice by byte offset, so that alone is the load-bearing part.
fn scalarError(msg: string, offset: i64): error {
  return newError("${msg} at byte ${offset}")
}

// --- small byte-scanning helpers, shared by every style's fast path -------

// The offset of `c` in `s[start:end)`, or -1 when absent.
fn indexOfChar(s: string, start: i64, end: i64, c: u8): i64 {
  let i = start
  while (i < end) {
    if (s[i] == c) {
      return i
    }
    i = i + 1
  }
  return -1
}

// `s[i]` is `\r` immediately followed by `\n`, within `[i, end)` — the one
// shape a `\r\n` break takes, shared by `splitRawLines`, the double-quoted
// escape loop and its line-continuation check so none of the three drift
// apart on how a Windows line ending is recognized.
fn isCRLFAt(s: string, i: i64, end: i64): bool {
  return s[i] == '\r' && i + 1 < end && s[i + 1] == '\n'
}

// The offset of the first `\n` or `\r` in `s[start:end)`, or -1.
fn indexOfBreak(s: string, start: i64, end: i64): i64 {
  let i = start
  while (i < end) {
    let c = s[i]
    if (c == '\n' || c == '\r') {
      return i
    }
    i = i + 1
  }
  return -1
}

// The offset of the first `\`, `\n` or `\r` in `s[start:end)`, or -1 — the
// double-quoted fast-path test: either one means this span needs the escape
// loop, neither means the slice is the answer.
fn indexOfEscapeOrBreak(s: string, start: i64, end: i64): i64 {
  let i = start
  while (i < end) {
    let c = s[i]
    if (c == '\\' || c == '\n' || c == '\r') {
      return i
    }
    i = i + 1
  }
  return -1
}

// --- document markers inside a multi-line quoted scalar (spec's
// c-forbidden shape) -------------------------------------------------------

// `src[at:end)` begins with the 3-byte document marker `mark` (`"---"` or
// `"..."`) followed by whitespace/a break/end of content — the same shape
// `scan.bit`'s own `isDocMarker` tests via a live `Scanner`, restated here
// on a raw `src`/offset pair: this file never has a `Scanner` to hand, only
// the byte span a caller already handed it (a bare `----` or `...x` is
// content, not a marker).
fn isDocMarkerAt(src: string, at: i64, end: i64, mark: string): bool {
  if (at + 3 > end) {
    return false
  }
  if (src[at] != mark[0] || src[at + 1] != mark[1] || src[at + 2] != mark[2]) {
    return false
  }
  return at + 3 >= end || isSpaceOrNewline(src[at + 3])
}

// The offset right after the first internal line break in `src[start:end)`
// whose line begins with `---` or `...`, or -1 when none does. A document
// boundary is recognized at column 0 of ANY line regardless of nesting or
// quoting (spec's c-forbidden production) — a quoted scalar's own delimiter
// cannot protect a line from being read as the marker that ends the
// document, so a greedily-scanned span crossing one is not a valid scalar
// at all, no matter where its closing quote turned up.
fn indexOfDocMarkerLine(src: string, start: i64, end: i64): i64 {
  let i = start
  while (i < end) {
    if (src[i] == '\n') {
      let lineStart = i + 1
      if (isDocMarkerAt(src, lineStart, end, "---") || isDocMarkerAt(src, lineStart, end, "...")) {
        return lineStart
      }
      i = lineStart
      continue
    }
    if (isCRLFAt(src, i, end)) {
      let lineStart = i + 2
      if (isDocMarkerAt(src, lineStart, end, "---") || isDocMarkerAt(src, lineStart, end, "...")) {
        return lineStart
      }
      i = lineStart
      continue
    }
    i = i + 1
  }
  return -1
}

// --- line folding (plain and double-quoted, see this file's header) ------

// `content` split into physical lines on `\n`/`\r\n`, terminators removed.
// A blank line (including a trailing one, when `content` ends on a break)
// becomes an empty string, never dropped — `foldContent` needs every blank
// line to count consecutive breaks correctly.
fn splitRawLines(content: string): []string {
  let n = len(content)
  let lines = []string(0)
  let lineStart = 0
  let i = 0
  while (i < n) {
    let c = content[i]
    if (c == '\n') {
      lines = append(lines, content[lineStart:i])
      i = i + 1
      lineStart = i
      continue
    }
    if (isCRLFAt(content, i, n)) {
      lines = append(lines, content[lineStart:i])
      i = i + 2
      lineStart = i
      continue
    }
    i = i + 1
  }
  lines = append(lines, content[lineStart:n])
  return lines
}

// `line` with its leading and trailing space/tab stripped — every interior
// folded line's content, per this file's header.
fn trimEdges(line: string): string {
  return trim(line, " \t")
}

// The separator folding emits before a content line: block.bit's own
// more-indented lines (spec 6.5's `>`-style rule, absent from every style in
// this file, #5531) get their break run preserved literally via
// `moreIndented`; flow's own `foldJoin` below never passes `true`. Otherwise
// one break folds to a space and N breaks fold to N-1 newlines.
fn foldSeparator(breakCount: i64, moreIndented: bool): string {
  if (moreIndented) {
    return repeat("\n", breakCount)
  }
  if (breakCount <= 1) {
    return " "
  }
  return repeat("\n", breakCount - 1)
}

// Joins already-trimmed `lines` — each one's own leading/trailing edge
// already handled by the caller (`foldLines` below for plain/single-quoted,
// `decodeDoubleQuotedLines` for double-quoted) — with spec 6.5's flow line
// folding: a single break becomes one space, a run of N breaks becomes N-1
// literal newlines, and an empty entry (a blank line, or nothing left past
// the content's last real break) contributes only its share of the break
// count, never text of its own. Shared by every style; none of them ever
// passes `foldSeparator` a `moreIndented` of `true` (that is block.bit's
// rule alone).
fn foldJoin(lines: []string): string {
  let last = len(lines) - 1
  let b = newBuilder().write(lines[0])
  let breakCount = 1
  let i = 1
  while (i < len(lines)) {
    let blank = lines[i] == ""
    if (blank && i < last) {
      breakCount = breakCount + 1
      i = i + 1
      continue
    }
    b = b.write(foldSeparator(breakCount, false))
    if (!blank) {
      b = b.write(lines[i])
    }
    breakCount = 1
    i = i + 1
  }
  return b.toString()
}

// Trims already-split `lines` per this file's header — every line's leading
// AND trailing edge, except the content's own first leading edge and its
// own last trailing edge — then joins them with `foldJoin`. Plain and
// single-quoted only: neither has a backslash escape (single-quoted's only
// one, `''`, is already collapsed before this is called), so trimming can
// run directly on their text; double-quoted trims before decoding instead
// (`decodeDoubleQuotedLines`, this file's header explains why).
fn foldLines(lines: []string): string {
  let last = len(lines) - 1
  let trimmed = []string(0)
  trimmed = append(trimmed, trimRight(lines[0], " \t"))
  let i = 1
  while (i < len(lines)) {
    if (i == last) {
      trimmed = append(trimmed, trimLeft(lines[i], " \t"))
    } else {
      trimmed = append(trimmed, trimEdges(lines[i]))
    }
    i = i + 1
  }
  return foldJoin(trimmed)
}

// Folds `content`'s embedded line breaks per this file's header. Callers
// only reach this once they have already confirmed `content` contains at
// least one break (each style's own fast path) — a single-line `content`
// still folds correctly (the loop below never runs), but skipping the call
// entirely is what keeps the no-op case allocation-free. Plain and
// single-quoted only (see `foldLines`).
fn foldContent(content: string): string {
  return foldLines(splitRawLines(content))
}

// --- single-quoted -----------------------------------------------------

// `content[firstQuote:]` with every `''` collapsed to one literal `'`.
// `content[0:firstQuote]` needs no copy of its own quotes (there are none
// before `firstQuote` by construction) so it is written once, whole.
fn collapseDoubledQuotes(content: string, firstQuote: i64): string {
  let n = len(content)
  let b = newBuilder().write(content[0:firstQuote])
  let i = firstQuote
  while (i < n) {
    if (content[i] == '\'') {
      b = b.writeByte('\'')
      i = i + 2
      continue
    }
    b = b.writeByte(content[i])
    i = i + 1
  }
  return b.toString()
}

// `'...'`: strips the surrounding quotes, collapses `''` to `'`, then folds
// any embedded line break the same way plain scalars do — see this file's
// header. A continuation line starting with a document marker (`---`/
// `...`) is rejected rather than folded: the quotes never protected it (see
// `indexOfDocMarkerLine`), so a span crossing one is not this scalar at
// all, however far its greedily-scanned closing quote reached.
fn decodeSingleQuoted(src: string, start: i64, end: i64): string! {
  let inner0 = start + 1
  let inner1 = end - 1
  let content = src[inner0:inner1]
  let firstQuote = indexOfChar(content, 0, len(content), '\'')
  if (firstQuote >= 0) {
    content = collapseDoubledQuotes(content, firstQuote)
  }
  if (indexOfBreak(content, 0, len(content)) < 0) {
    return content
  }
  let marker = indexOfDocMarkerLine(src, inner0, inner1)
  if (marker >= 0) {
    fail scalarError("yaml: document marker ends multi-line scalar", marker)
  }
  return foldContent(content)
}

// --- double-quoted -------------------------------------------------------

fn hexDigitVal(src: string, at: i64, escStart: i64): i64! {
  let c = src[at]
  if (c >= '0' && c <= '9') {
    return i64(c - '0')
  }
  if (c >= 'a' && c <= 'f') {
    return i64(c - 'a') + 10
  }
  if (c >= 'A' && c <= 'F') {
    return i64(c - 'A') + 10
  }
  fail scalarError("yaml: invalid hex escape digit", escStart)
}

// The `width`-hex-digit codepoint starting at `src[at]`.
fn accumulateHex(src: string, at: i64, width: i64, escStart: i64): i64! {
  let v = i64(0)
  let k = 0
  while (k < width) {
    let d = hexDigitVal(src, at + k, escStart)?
    v = v * 16 + d
    k = k + 1
  }
  return v
}

// Encodes Unicode scalar value `cp` as UTF-8 into `b`. Hand-rolled because
// `string(rune)` is not implemented yet (SPEC §12.9) — `stdlib/json/escape.bit`
// and `stdlib/regex/litscan.bit` each carry the identical small local copy
// for the same reason (litscan.bit's own comment explains why a shared
// export is not worth it for a function this size).
fn writeUtf8Rune(b: Builder, cp: i64) {
  if (cp < 0x80) {
    b.writeByte(u8(cp))
    return
  }
  if (cp < 0x800) {
    b.writeByte(u8(0xC0 | (cp >> 6)))
    b.writeByte(u8(0x80 | (cp & 0x3F)))
    return
  }
  if (cp < 0x10000) {
    b.writeByte(u8(0xE0 | (cp >> 12)))
    b.writeByte(u8(0x80 | ((cp >> 6) & 0x3F)))
    b.writeByte(u8(0x80 | (cp & 0x3F)))
    return
  }
  b.writeByte(u8(0xF0 | (cp >> 18)))
  b.writeByte(u8(0x80 | ((cp >> 12) & 0x3F)))
  b.writeByte(u8(0x80 | ((cp >> 6) & 0x3F)))
  b.writeByte(u8(0x80 | (cp & 0x3F)))
}

// `\xXX`/`\uXXXX`/`\UXXXXXXXX`: `width` hex digits starting right after the
// escape letter at `src[i]`, rejecting a surrogate (U+D800..U+DFFF) or
// anything past U+10FFFF rather than substituting a replacement character
// (ticket constraint). Returns the position just past the escape.
// `escStart` (the backslash's own offset, for error messages) is `i - 1`
// rather than a sixth parameter — max-params' limit is 5 (E0202) — every
// caller reaches this function with `i` pointing right after that backslash.
fn decodeFixedHexEscape(src: string, i: i64, end: i64, b: Builder, width: i64): i64! {
  let escStart = i - 1
  if (i + 1 + width > end) {
    fail scalarError("yaml: invalid escape", escStart)
  }
  let cp = accumulateHex(src, i + 1, width, escStart)?
  if (cp >= 0xD800 && cp <= 0xDFFF) {
    fail scalarError("yaml: surrogate codepoint in escape", escStart)
  }
  if (cp > 0x10FFFF) {
    fail scalarError("yaml: codepoint above U+10FFFF in escape", escStart)
  }
  writeUtf8Rune(b, cp)
  return i + 1 + width
}

// The single-byte escapes: `\0 \a \b \t \n \v \f \r \e \" \/ \\`, aligned
// index-for-index between the two strings/array below, plus the two core
// grammar oddities (spec 5.7's `ns-esc-horizontal-tab` and `ns-esc-space`):
// a backslash directly followed by a literal TAB (0x09) or SPACE (0x20)
// byte — appended last so the letters above keep their original order —
// decodes to that same byte, the only escapes where the escaped character
// need not follow the backslash as a letter at all. -1 means `e` is not one
// of these (the caller checks the multi-byte table next).
fn simpleEscapeByte(e: u8): i64 {
  let letters = "0abtnvfre\"/\\\t "
  let bytes = [0, 7, 8, 9, 10, 11, 12, 13, 27, 34, 47, 92, 9, 32]
  let i = 0
  while (i < len(letters)) {
    if (letters[i] == e) {
      return bytes[i]
    }
    i = i + 1
  }
  return -1
}

// The fixed-codepoint escapes: `\N` (U+0085), `\_` (U+00A0), `\L` (U+2028),
// `\P` (U+2029) — each multi-byte in UTF-8, so `writeUtf8Rune` encodes them
// rather than a single `writeByte`. -1 means `e` is not one of these.
fn namedEscapeCodepoint(e: u8): i64 {
  let letters = "N_LP"
  let points = [0x85, 0xA0, 0x2028, 0x2029]
  let i = 0
  while (i < len(letters)) {
    if (letters[i] == e) {
      return points[i]
    }
    i = i + 1
  }
  return -1
}

// `src[i]` is the byte right after a `\` (the escape letter itself). Decodes
// exactly one escape into `b` and returns the position just past it. An
// escape letter matching none of the four tables above is an error — never
// a silently-ignored or replacement-charactered byte (ticket constraint).
fn decodeOneEscape(src: string, i: i64, end: i64, escStart: i64, b: Builder): i64! {
  let e = src[i]
  if (e == '\n') {
    return i + 1
  }
  if (isCRLFAt(src, i, end)) {
    return i + 2
  }
  if (e == 'x') {
    return decodeFixedHexEscape(src, i, end, b, 2)?
  }
  if (e == 'u') {
    return decodeFixedHexEscape(src, i, end, b, 4)?
  }
  if (e == 'U') {
    return decodeFixedHexEscape(src, i, end, b, 8)?
  }
  let simple = simpleEscapeByte(e)
  if (simple >= 0) {
    b.writeByte(u8(simple))
    return i + 1
  }
  let cp = namedEscapeCodepoint(e)
  if (cp >= 0) {
    writeUtf8Rune(b, cp)
    return i + 1
  }
  fail scalarError("yaml: unknown escape character", escStart)
}

// Writes `src[pendingStart:at)` into `b` and returns the cleared (`-1`)
// pending-start — the raw space/tab run `decodeDoubleQuotedLines` buffered
// turns out NOT to be trailing whitespace (an ordinary byte or an escape
// follows it, so it is real content after all), unlike the one place that
// discards the run instead: right at a real line break.
fn flushPendingSpan(src: string, b: Builder, pendingStart: i64, at: i64): i64 {
  if (pendingStart >= 0) {
    b.write(src[pendingStart:at])
  }
  return -1
}

// `c` is a byte the RAW-source trim in `decodeDoubleQuotedLines` treats as
// indentation (never a decoded escape's payload, which is written directly
// and never passes through this check).
fn isRawWsByte(c: u8): bool {
  return c == ' ' || c == '\t'
}

// `src[i]` starts a `\n` or `\r\n` break — shared by `decodeDoubleQuotedLines`'s
// two uses: a plain (real) break, and the one byte right after a backslash,
// where the same shape means an escaped continuation instead.
fn isBreakAt(src: string, i: i64, end: i64): bool {
  return src[i] == '\n' || isCRLFAt(src, i, end)
}

// `i` moved past the one real break `isBreakAt(src, i, end)` already
// confirmed starts there — one byte for a bare `\n`, two for `\r\n`.
fn advancePastBreak(src: string, i: i64, end: i64): i64 {
  if (src[i] == '\n') {
    return i + 1
  }
  return i + 2
}

// One un-escaped space/tab byte at `i`: skipped outright (never buffered)
// while still at a line's own leading edge, buffered as an open pending
// span (its raw start offset) otherwise — an already-open span keeps its
// original start.
fn bufferWsByte(i: i64, atLineStart: bool, pendingStart: i64): i64 {
  if (atLineStart) {
    return pendingStart
  }
  if (pendingStart < 0) {
    return i
  }
  return pendingStart
}

// `src[start:end)` (the double-quoted span's inside, no quotes) split into
// already fold-trimmed, escape-decoded strings, one per RAW (un-escaped)
// source line. Trimming runs against the RAW bytes, before any escape
// decodes — this file's header explains why a post-decode trim cannot tell
// a decoded whitespace escape apart from real indentation.
//
// A run of un-escaped space/tab bytes is buffered (`pendingStart`, the raw
// offset it began at, or `-1` when none is open) rather than written
// immediately: an ordinary byte or an escape that follows it means the run
// was genuine content and gets flushed (`flushPendingSpan`), while a REAL
// break means it was trailing indentation and gets discarded instead —
// the one place trimming actually removes anything, since leading
// indentation (`atLineStart`) is simply never buffered at all. `atLineStart`
// starts `false`, so the content's own first byte is never leading-trimmed,
// and is set back to `true` after every real break AND every escaped
// continuation (spec 5.7's line-continuation escape resumes on a new line
// too — 565N's continuation lines need their own leading space trimmed
// exactly like any other line's). An escaped continuation itself never
// trims around itself — NP9H's tab survives immediately before its own
// `\<break>` — only a REAL break discards what came before it. End of
// content flushes whatever is still pending, preserving the content's own
// last byte on its trailing side.
fn decodeDoubleQuotedLines(src: string, start: i64, end: i64): []string! {
  let lines = []string(0)
  let b = newBuilder()
  let pendingStart = i64(-1)
  let atLineStart = false
  let i = start
  while (i < end) {
    let c = src[i]
    if (isRawWsByte(c)) {
      pendingStart = bufferWsByte(i, atLineStart, pendingStart)
      i = i + 1
      continue
    }
    if (isBreakAt(src, i, end)) {
      pendingStart = -1
      lines = append(lines, b.toString())
      b = newBuilder()
      atLineStart = true
      i = advancePastBreak(src, i, end)
      continue
    }
    if (c == '\\') {
      if (i + 1 >= end) {
        fail scalarError("yaml: unterminated escape", i)
      }
      let continuesLine = isBreakAt(src, i + 1, end)
      pendingStart = flushPendingSpan(src, b, pendingStart, i)
      i = decodeOneEscape(src, i + 1, end, i, b)?
      atLineStart = continuesLine
      continue
    }
    pendingStart = flushPendingSpan(src, b, pendingStart, i)
    atLineStart = false
    b.writeByte(c)
    i = i + 1
  }
  pendingStart = flushPendingSpan(src, b, pendingStart, end)
  lines = append(lines, b.toString())
  return lines
}

// `"..."`: strips the surrounding quotes, decodes every escape, and folds
// any real (un-escaped) line break across the resulting lines. A
// continuation line starting with a document marker (`---`/`...`) is
// rejected once decoding confirms the span is genuinely multi-line — see
// `decodeSingleQuoted`'s comment and `indexOfDocMarkerLine`.
fn decodeDoubleQuoted(src: string, start: i64, end: i64): string! {
  let inner0 = start + 1
  let inner1 = end - 1
  if (indexOfEscapeOrBreak(src, inner0, inner1) < 0) {
    return src[inner0:inner1]
  }
  let lines = decodeDoubleQuotedLines(src, inner0, inner1)?
  if (len(lines) == 1) {
    return lines[0]
  }
  let marker = indexOfDocMarkerLine(src, inner0, inner1)
  if (marker >= 0) {
    fail scalarError("yaml: document marker ends multi-line scalar", marker)
  }
  return foldJoin(lines)
}

// --- plain -----------------------------------------------------------

// No delimiters, no escapes, but leading/trailing white space is never
// content (spec 6.5/7.3.3) — `scanPlainScalar`'s own comment says so
// explicitly: it hands this file a greedy raw span up to the next
// delimiter with "no escape handling, no line folding — later files own
// the grammar above this span", so a flow scalar's trailing run of spaces
// before `,`/`]`/`}`/`:` (or a block scalar's trailing run before a
// same-line comment) rides along in the span and is this function's job to
// strip.
//
// The span's OWN outer edges are stripped here, before the fold, so the
// single-line and the multi-line path state the same rule once. `foldLines`
// cannot do it: it deliberately preserves the content's own first leading
// and last trailing edge (this file's header, #5531), which is right for
// single-quoted — those blanks sit INSIDE the quotes and are content — and
// wrong for plain, which has no delimiter for them to sit inside. Plain's
// multi-line path is not hypothetical: `scanPlainScalar` never emits a
// token crossing a line, so it fires only when a caller joins several
// tokens' spans deliberately, which `flow.bit`'s `scanFlowPlainSpan`
// (#5529) does for a flow plain scalar spanning a break — and that span
// ends at whatever stopped the last line, trailing blank run included
// (CT4Q's `? foo\n bar : baz`, #5534).
fn decodePlain(src: string, start: i64, end: i64): string {
  let content = trim(src[start:end], " \t")
  if (indexOfBreak(content, 0, len(content)) < 0) {
    return content
  }
  return foldContent(content)
}

// --- entry point -----------------------------------------------------

// Decodes the scalar `[start, end)` names in `src`, dispatching on `kind`.
// `switch` (not `match`) deliberately: only three of `TokenKind`'s twenty-two
// variants are scalar styles, and `switch`'s `default` — unlike `match`,
// which has none (SPEC §10.1) — lets this function reject every other kind
// without naming all nineteen.
export fn yamlDecodeScalar(src: string, kind: TokenKind, start: i64, end: i64): string! {
  switch (kind) {
    case TokenKind.PlainScalar:
      return decodePlain(src, start, end)
    case TokenKind.SingleQuoted:
      return decodeSingleQuoted(src, start, end)?
    case TokenKind.DoubleQuoted:
      return decodeDoubleQuoted(src, start, end)?
    default:
      fail scalarError("yaml: not a scalar token", start)
  }
}
