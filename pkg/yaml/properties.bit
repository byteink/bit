// pkg/yaml/properties.bit — yaml module, a block node's own `&anchor`/`!tag`
// prefix (#5498, epic #1482). Split out of parse.bit purely to stay under
// spec/LINT.md's 800-line ceiling (#5549, the same reason plainfold.bit was
// split at #5544): `consumeNodeProperties`/`applyAnchor`/
// `rejectAnchorMisplaced` are called only from parse.bit's `parseBlockNode`,
// against the `Parser`/`Scanner` that file defines (module-private, same
// flat namespace, pkg/README.md).

// --- node properties: anchor and tag prefixes -----------------------------

// A raw `!...` tag token span resolved to the text `test.event`/every other
// implementation displays it with (#5555): `!` alone (the non-specific tag,
// YAML 1.2.2 §6.9.1.1) stays `!`; `!!name` (the secondary `!!` handle,
// §6.8.2.2 — the only handle this package pre-declares, since it declares no
// `%TAG` directive handling of its own, #5498's own scope) expands to the
// `tag:yaml.org,2002:` prefix; any other `!name` (the primary handle) or
// `!<...>` (already a full URI, `scanVerbatimTag`, scan.bit) is carried
// through exactly as scanned — there is no declared handle to expand it
// against. Never used to choose a type (this file's header, epic #1482):
// purely a display/round-trip transform on text a caller may read.
fn resolveTagText(raw: string): string {
  if (raw == "!") {
    return "!"
  }
  if (len(raw) >= 2 && raw[0] == '!' && raw[1] == '!') {
    return "tag:yaml.org,2002:${raw[2:len(raw)]}"
  }
  return raw
}

// `&name` and/or `!tag`, in either order, before a node. Tag text is
// captured (`resolveTagText`) as DATA a caller may read via
// `yamlDecorationOf` (value.bit) — never as a dispatch key: `yamlResolve`/
// `yamlResolveScalar` (schema.bit) still decide a scalar's type from its own
// spelling under the YAML 1.2 core schema alone, epic #1482's own
// constraint, untouched by this. Bounded to two iterations: YAML permits at
// most one anchor and one tag per node.
//
// `indent` is the column a SECOND property (the tag after an anchor, or
// vice versa) must clear once it starts a fresh line — the first property
// is always accepted at whatever column the caller placed the cursor at.
// "Clear" means STRICTLY past `indent`, or AT LEAST, depending on
// `descended`: callers that just consumed an `Indent` token (`descended`
// true) already validated `indent` as one level deeper than the true
// parent — `top4: \n  &node4\n  &k4 key4: four` (U3XV) has both properties
// AT that column, fine. A caller that has NOT just descended (`indent` is
// still the untouched parent's own column, e.g. same-line `key: &x`)
// requires the second property STRICTLY deeper — `key: &x\n!!map\n  a: b`
// (H7J7): `!!map` sits at `key:`'s own column, never `&x`'s tag.
//
// Also returns `prevEnd`, the last property's end — no token alone tells
// "same line" from "merely precedes" (3R3P: `&sequence\n- a`, same column,
// no `Indent`, yet two lines; only raw `hasLineBreak` knows).
//
// Split out of `consumeNodeProperties` to keep that function's cyclomatic
// complexity under spec/LINT.md's ceiling.
fn rejectShallowSecondProperty(p: Parser, indent: i64, descended: bool): ()! {
  let tooShallow = p.s.col <= indent
  if (descended) {
    tooShallow = p.s.col < indent
  }
  if (tooShallow) {
    fail parseError("yaml: node property is not indented past its parent", p.s.start)
  }
}

fn consumeNodeProperties(
  p: Parser,
  indent: i64,
  descended: bool,
): (Option<string>, Option<string>, i64)! {
  let anchorName = Option<string>.None
  let tagText = Option<string>.None
  let i = 0
  let prevEnd = p.s.start
  while (i < 2) {
    // A SECOND anchor (or tag) — not a tag after an anchor or vice versa —
    // belongs to a DIFFERENT node, never this one (YAML permits at most one
    // of each per node, this function's own header): `&mapping\n&key [...]`
    // must leave `&key` for `consumePropertyChain`'s own outer loop to pick
    // up as the next chain link, not silently overwrite `anchorName` here
    // and drop `mapping` entirely — the bug this check closes.
    let isAnchor = p.s.kind == TokenKind.Anchor && isNone(anchorName)
    let isTag = p.s.kind == TokenKind.Tag && isNone(tagText)
    if (isAnchor || isTag) {
      if (i > 0 && hasLineBreak(p.src, prevEnd, p.s.start)) {
        rejectShallowSecondProperty(p, indent, descended)?
      }
      if (isAnchor) {
        anchorName = Option<string>.Some(p.src[p.s.start + 1:p.s.end])
      } else {
        tagText = Option<string>.Some(resolveTagText(p.src[p.s.start:p.s.end]))
      }
      prevEnd = p.s.end
      advance(p)
    } else {
      return (anchorName, tagText, prevEnd)
    }
    i = i + 1
  }
  return (anchorName, tagText, prevEnd)
}

// An anchor name and/or tag text pending application to whatever node is
// dispatched next — bundled into one value so `DispatchCtx`/
// `parseScalarOrMapping`/`parseFlowOrMapping` each carry one field instead
// of two, keeping every one of them under spec/LINT.md's max-param ceiling.
class PendingProps { anchor: Option<string>, tag: Option<string> }

fn noPendingProps(): PendingProps {
  return PendingProps{ anchor = Option<string>.None, tag = Option<string>.None }
}

// Defines `name` (when present) against the PLAIN, undecorated `value` and
// returns `value` decorated with `name`/`tag` (value.bit's `yamlDecorate`,
// a no-op when both are `None`) — the tail every `parseBlockNode` exit path
// shares, whether the node's own properties were consumed right here or one
// recursive level down (`parseBlockNode`'s own `Indent` branch). The anchor
// TABLE always stores the plain value, never a decorated one: a later alias
// must be free to wrap it as its OWN `alias` decoration
// (`resolveAliasToken` below) rather than inheriting this node's `anchor`/
// `tag` (value.bit's header: the two are mutually exclusive per node).
fn applyAnchor(p: Parser, props: PendingProps, value: Yaml): Yaml! {
  match (props.anchor) {
    Some(n) => {
      chargeBlockNode(p, p.s.start)?
      yamlAnchorDefine(p.anchors, n, value)?
    }
    None => {}
  }
  return yamlDecorate(value, props.anchor, props.tag, Option<string>.None)
}

// §8.2.3: a sequence needs a comment-only rest of line after properties —
// only `here`, sharing `p.s.start`'s line, can (SY6V) — a property on an
// OUTER, different-nesting-level line never shares this line at all, so
// only `here` (never `far`) is meaningful for this check.
fn rejectSeqOnAnchorLine(p: Parser, here: Option<string>, end: i64): ()! {
  let sameLine = isSome(here) && !hasLineBreak(p.src, end, p.s.start)
  if (sameLine && p.s.kind == TokenKind.SeqEntry) {
    fail parseError("yaml: a block sequence cannot start on its anchor's own line", p.s.start)
  }
}

// §7.5: alias/properties are different `ns-flow-node` alternatives, so
// `far`/`here` (any unapplied anchor) never lands on an `Alias` (SR86:
// `key2: &b *a`) — PLUS `rejectSeqOnAnchorLine` below. Only for a SAME-LEVEL
// call (`readImplicitKey`'s own key read: no enclosing mapping could ever
// claim the anchor instead). `consumePropertyChain`'s own cross-level loop
// (a REAL `Indent` between the anchor's line and the alias) does NOT call
// this — 26DV's `top3: &node3\n  *alias1 : scalar3` has `&node3` decorate
// the MAPPING `*alias1` becomes the first KEY of, not the bare alias node;
// `parseAlias`'s own `hadAnchor` check (parse.bit) is what catches the
// genuinely bare case there instead (an alias with NO following `:`).
fn rejectAnchorMisplaced(p: Parser, far: Option<string>, here: Option<string>, end: i64): ()! {
  if ((isSome(far) || isSome(here)) && p.s.kind == TokenKind.Alias) {
    fail parseError("yaml: an alias node cannot carry an anchor property", p.s.start)
  }
  rejectSeqOnAnchorLine(p, here, end)?
}

// `consumePropertyChain`'s own result: every anchor name seen across the
// whole chain (usually 0 or 1; more than 1 only when several
// property-only lines each carried one), the last property's end (for
// `rejectAnchorMisplaced`'s "same line" check, same as `consumeNodeProperties`'s
// own `prevEnd`), the FINAL line's own column, and whether the chain ever
// found a SECOND line's worth of properties at all (`parseBlockNode`
// dispatches differently either way, same as before this function existed).
// `tag` is the LAST tag text seen across the chain (`None` when none was):
// valid YAML carries at most one tag per node, and this file's own scope
// (#5555) is the single-line, single-node case those anchor/tag ids need —
// a tag on an OUTER chain level, several property-only lines up from the
// node it actually decorates, is left uncaptured here exactly as before
// this ticket (`applyAnchor`'s own tag-consuming call sites below are all
// same-line).
class PropertyChain {
  names: []string,
  tag: Option<string>,
  lastEnd: i64,
  col: i64,
  descended: bool,
}

// Chases a node's own `&anchor`/`!tag` prefix across every property-only
// LINE it spans, not just one: `consumeNodeProperties` reads at most one
// anchor and one tag per call (YAML's own per-node limit) and stops at the
// next `Indent`/`Dedent`, but a chain of SEVERAL nodes, each contributing
// its own anchor/tag before the real content, can span more lines than
// that single call ever sees (BU8L: `key: &anchor\n !!map\n  a: b` — the
// anchor inline, `!!map` a further line down, the mapping body a further
// line down still — three levels; `parseBlockNode`'s own recursion used to
// re-enter exactly once). A further line's properties do not always cost
// an `Indent` token either — 9KAX's `&a4 !!map\n&a5 !!str key5: value4`
// sits at the SAME column both lines (this file's own root, never
// indented further), so the scanner emits neither `Indent` nor `Dedent`
// between them; the loop below re-enters on a bare `Anchor`/`Tag` token
// too, not only `Indent`, `Scanner.col` already being valid for it
// (re-measured once per physical line regardless of what token starts it,
// `hasLineBreak`'s own comment in parse.bit). Also drains a `Dedent` a
// property-only line can leave pending before content that is actually
// SHALLOWER than it (SKE5: `seq:\n &anchor\n- a\n- b` — the anchor's own
// line sits one column past the sequence dash it precedes) —
// `dispatchBlockNode`'s switch has no `Dedent` case, and no caller drained
// it before this existed. Bounded by `Scanner.indentStack`'s own
// `maxDepth` ceiling, the same bound this file's `parseBlockNode` caller
// already claims for the recursion this replaces.
fn consumePropertyChain(p: Parser, indent: i64, descended: bool): PropertyChain! {
  let (first, firstTag, firstEnd) = consumeNodeProperties(p, indent, descended)?
  skipComments(p)?
  let names = []string(0)
  match (first) {
    Some(n) => { names = append(names, n) }
    None => {}
  }
  let tag = firstTag
  let lastEnd = firstEnd
  let col = indent
  let sawMore = false
  while (p.s.kind == TokenKind.Dedent) {
    advance(p)
  }
  let guard = 0
  let bound = p.s.srcLen + 8
  while (isChainContinuation(p.s.kind) && guard <= bound) {
    guard = guard + 1
    sawMore = true
    if (p.s.kind == TokenKind.Indent) {
      advance(p)
    }
    col = p.s.col
    let (next, nextTag, nextEnd) = consumeNodeProperties(p, col, true)?
    rejectSeqOnAnchorLine(p, next, nextEnd)?
    match (next) {
      Some(n) => { names = append(names, n) }
      None => {}
    }
    tag = mergeChainTag(tag, nextTag)
    lastEnd = nextEnd
    while (p.s.kind == TokenKind.Dedent) {
      advance(p)
    }
  }
  return PropertyChain{
    names = names,
    tag = tag,
    lastEnd = lastEnd,
    col = col,
    descended = sawMore,
  }
}

// The chain's running tag after a further line's own `consumeNodeProperties`
// call: `next` when it saw one, else whatever the chain already had. Split
// out of `consumePropertyChain` purely to keep that function's cyclomatic
// complexity under spec/LINT.md's ceiling.
fn mergeChainTag(tag: Option<string>, next: Option<string>): Option<string> {
  if (isSome(next)) {
    return next
  }
  return tag
}

// A further property-only line, reached either by a genuine `Indent`
// (deeper column) or directly by its own `Anchor`/`Tag` token (SAME
// column — 9KAX, this function's own header).
fn isChainContinuation(k: TokenKind): bool {
  return k == TokenKind.Indent || k == TokenKind.Anchor || k == TokenKind.Tag
}

// YAML 1.2.2 §6.9 (node properties): a `&anchor`/`!tag` prefix belongs to
// the node it immediately precedes, and nothing else — never to a node one
// level further in. Two names collapsed into one chain (`consumePropertyChain`'s
// own header) are two DIFFERENT nodes' properties read back to back with no
// scalar/indicator between them yet: the first precedes the CONTAINER this
// function is handed as `value` (`&node1` in U3XV's `top1: &node1\n  &k1
// key1: one`, immediately preceding the block mapping that is `top1:`'s own
// value), and the last precedes whatever THAT container's body opens
// with — its first KEY (`&k1`, immediately preceding `key1`) — never the
// container a second time. `parseBlockNode`'s own guard (parse.bit,
// "a node cannot carry two distinct anchors") already rejects `len(names) >
// 1` whenever `value` is not a mapping, so a real first-key node to split
// the last name onto always exists here.
fn applyAnchorChain(p: Parser, names: []string, tag: Option<string>, value: Yaml): Yaml! {
  if (len(names) >= 2 && yamlIsMapping(value)) {
    return applyAnchorChainToMapping(p, names, tag, value)?
  }
  let i = 0
  while (i < len(names)) {
    chargeBlockNode(p, p.s.start)?
    yamlAnchorDefine(p.anchors, names[i], value)?
    i = i + 1
  }
  if (len(names) == 0) {
    return yamlDecorate(value, Option<string>.None, tag, Option<string>.None)
  }
  return yamlDecorate(value, Option<string>.Some(names[len(names) - 1]), tag, Option<string>.None)
}

// The two-node split `applyAnchorChain` needs whenever its chain collapsed
// onto a mapping: `names[0]` decorates `value` itself (the CONTAINER,
// registered under its own PLAIN, undecorated form — `applyAnchor`'s own
// "the anchor table always stores the plain value" contract, so a later
// alias to it wraps the alias decoration itself rather than inheriting this
// container's own anchor); the LAST name decorates `value`'s own first
// entry's KEY specifically (6BFJ: `&mapping\n&key [ &item a, b, c ]: value`
// needs `&mapping` on the `+MAP` and `&key` on the flow sequence that is its
// own first key, `+SEQ &key` — never the same `+MAP` twice). `tag` follows
// the last name to the same key node — no corpus fixture combines a tag
// with a 2-name container/key split, so this is the minimal-risk choice,
// consistent with `mergeChainTag`'s own "closest to the actual node"
// preference. A chain of more than two names (never seen in this corpus)
// still registers every name before the last against the CONTAINER for
// alias resolution, same open imprecision this function's own former single
// body already accepted for anything past the two well-evidenced slots.
fn applyAnchorChainToMapping(p: Parser, names: []string, tag: Option<string>, value: Yaml): Yaml! {
  let entries = unwrap(yamlAsMapping(value))
  let i = 0
  while (i < len(names) - 1) {
    chargeBlockNode(p, p.s.start)?
    yamlAnchorDefine(p.anchors, names[i], value)?
    i = i + 1
  }
  let keyName = names[len(names) - 1]
  chargeBlockNode(p, p.s.start)?
  yamlAnchorDefine(p.anchors, keyName, entries[0].key)?
  let newFirstKey = yamlDecorate(
    entries[0].key,
    Option<string>.Some(keyName),
    tag,
    Option<string>.None,
  )
  let newEntries = [YamlEntry{ key = newFirstKey, value = entries[0].value }]
  let j = 1
  while (j < len(entries)) {
    newEntries = append(newEntries, entries[j])
    j = j + 1
  }
  return yamlDecorate(
    Yaml.YamlMapping(newEntries),
    Option<string>.Some(names[0]),
    Option<string>.None,
    Option<string>.None,
  )
}

// --- a mapping key wrapped in properties, or an alias --------------------

// The raw `*name` lookup, shared by `parse.bit`'s `parseAlias` (which peeks
// past it for a `:`, turning the alias into a compact mapping's first key —
// E76Z) and `readKeyPrimary` below (whose own caller, `readImplicitEntry`,
// runs that same `:` check itself). Returns the token's own `start`/`end`
// too — both callers need them (`hasLineBreak`'s "same line" check;
// `chargeBlockNode`'s offset).
fn resolveAliasToken(p: Parser): (Yaml, i64, i64)! {
  let start = p.s.start
  let end = p.s.end
  let name = p.src[start + 1:end]
  advance(p)
  let value = yamlAnchorResolve(p.anchors, name, p.limits)?
  let decorated = yamlDecorate(
    value,
    Option<string>.None,
    Option<string>.None,
    Option<string>.Some(name),
  )
  return (decorated, start, end)
}

// A mapping key's own primary token: a bare scalar (as `readImplicitEntry`
// always read before) or an alias used directly as a key (E76Z's `*b :
// *a` is the OTHER shape, an alias with no anchor of its own — this is the
// same lookup reached from inside `readImplicitKey` once any properties
// are already consumed).
// `isMultilineQuoted` (parse.bit) is spec 7.4.2's single-line implicit-key
// rule; `readImplicitEntry` is the ONLY caller of this function, never an
// explicit `?` key, which has no such restriction. `7LBH`/`D49Q`
// (`"c\n d"`/`'c\n d'` as a top-level implicit key) and `JKF3` (the same
// shape as a nested sequence entry's implicit key) all fail this check.
fn readKeyPrimary(p: Parser): Yaml! {
  if (p.s.kind == TokenKind.Alias) {
    let (value, start, _) = resolveAliasToken(p)?
    chargeBlockNode(p, start)?
    return value
  }
  let kind = p.s.kind
  if (isMultilineQuoted(p.src, kind, p.s.start, p.s.end)) {
    fail parseError("yaml: an implicit mapping key must be a single line", p.s.start)
  }
  let text = yamlDecodeScalar(p.src, kind, p.s.start, p.s.end)?
  advance(p)
  return resolveByKind(text, kind, p.resolver)
}

// A mapping key that may itself carry `&anchor`/`!tag` properties before
// its own scalar or alias (HMQ5: `!!str &a1 "foo":`; ZWK4: `&anchor c: 3`;
// 26DV: `&anchor6 'key6' :`) — the SAME key/value column threading
// `readImplicitEntry` already gave a bare scalar key, extended to one
// wrapped in properties. Single-line only (`consumeNodeProperties`, not
// the multi-line `consumePropertyChain`) — none of this group's ids chain
// a KEY's own properties across more than one line.
fn readImplicitKey(p: Parser, col: i64): (Yaml, i64)! {
  let keyStart = p.s.start
  let (anchorName, tagText, anchorEnd) = consumeNodeProperties(p, col, false)?
  rejectAnchorMisplaced(p, Option<string>.None, anchorName, anchorEnd)?
  let key = readKeyPrimary(p)?
  let named = applyAnchor(p, PendingProps{ anchor = anchorName, tag = tagText }, key)?
  return (named, keyStart)
}
