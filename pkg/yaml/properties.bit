// pkg/yaml/properties.bit — yaml module, a block node's own `&anchor`/`!tag`
// prefix (#5498, epic #1482). Split out of parse.bit purely to stay under
// spec/LINT.md's 800-line ceiling (#5549, the same reason plainfold.bit was
// split at #5544): `consumeNodeProperties`/`applyAnchor`/
// `rejectAnchorMisplaced` are called only from parse.bit's `parseBlockNode`,
// against the `Parser`/`Scanner` that file defines (module-private, same
// flat namespace, pkg/README.md).

// --- node properties: anchor and tag prefixes -----------------------------

// `&name` and/or `!tag`, in either order, before a node. Tags are consumed
// and otherwise ignored — the epic forbids type-tag-driven construction, so
// this file has no notion of tag-driven typing to wire up. Bounded to two
// iterations: YAML permits at most one anchor and one tag per node.
//
// `indent` is the column a SECOND property (the tag after an anchor, or
// vice versa) must clear once it starts a fresh line — the first property
// is always accepted at whatever column the caller placed the cursor at.
// "Clear" means STRICTLY past `indent`, or AT LEAST, depending on
// `descended`: callers that just consumed an `Indent` token (`descended`
// true) already validated `indent` as one level deeper than the true
// parent — `top4: \n  &node4\n  &k4 key4: four` (U3XV) has both properties
// AT that column, fine. A caller that has NOT just descended (`indent` is
// still the untouched parent's own column, e.g. same-line `key: &x`)
// requires the second property STRICTLY deeper — `key: &x\n!!map\n  a: b`
// (H7J7): `!!map` sits at `key:`'s own column, never `&x`'s tag.
//
// Also returns `prevEnd`, the last property's end — no token alone tells
// "same line" from "merely precedes" (3R3P: `&sequence\n- a`, same column,
// no `Indent`, yet two lines; only raw `hasLineBreak` knows).
fn consumeNodeProperties(p: Parser, indent: i64, descended: bool): (Option<string>, i64)! {
  let anchorName = Option<string>.None
  let i = 0
  let prevEnd = p.s.start
  while (i < 2) {
    if (p.s.kind == TokenKind.Anchor || p.s.kind == TokenKind.Tag) {
      if (i > 0 && hasLineBreak(p.src, prevEnd, p.s.start)) {
        let tooShallow = p.s.col <= indent
        if (descended) {
          tooShallow = p.s.col < indent
        }
        if (tooShallow) {
          fail parseError("yaml: node property is not indented past its parent", p.s.start)
        }
      }
      if (p.s.kind == TokenKind.Anchor) {
        anchorName = Option<string>.Some(p.src[p.s.start + 1:p.s.end])
      }
      prevEnd = p.s.end
      advance(p)
    } else {
      return (anchorName, prevEnd)
    }
    i = i + 1
  }
  return (anchorName, prevEnd)
}

// Defines `name` (when present) against `value` and returns `value`
// unchanged — the tail every `parseBlockNode` exit path shares, whether the
// node's own properties were consumed right here or one recursive level
// down (`parseBlockNode`'s own `Indent` branch).
fn applyAnchor(p: Parser, name: Option<string>, value: Yaml): Yaml! {
  match (name) {
    Some(n) => {
      chargeBlockNode(p, p.s.start)?
      yamlAnchorDefine(p.anchors, n, value)?
    }
    None => {}
  }
  return value
}

// §8.2.3: a sequence needs a comment-only rest of line after properties —
// only `here`, sharing `p.s.start`'s line, can (SY6V) — a property on an
// OUTER, different-nesting-level line never shares this line at all, so
// only `here` (never `far`) is meaningful for this check.
fn rejectSeqOnAnchorLine(p: Parser, here: Option<string>, end: i64): ()! {
  let sameLine = isSome(here) && !hasLineBreak(p.src, end, p.s.start)
  if (sameLine && p.s.kind == TokenKind.SeqEntry) {
    fail parseError("yaml: a block sequence cannot start on its anchor's own line", p.s.start)
  }
}

// §7.5: alias/properties are different `ns-flow-node` alternatives, so
// `far`/`here` (any unapplied anchor) never lands on an `Alias` (SR86:
// `key2: &b *a`) — PLUS `rejectSeqOnAnchorLine` below. Only for a SAME-LEVEL
// call (`readImplicitKey`'s own key read: no enclosing mapping could ever
// claim the anchor instead). `consumePropertyChain`'s own cross-level loop
// (a REAL `Indent` between the anchor's line and the alias) does NOT call
// this — 26DV's `top3: &node3\n  *alias1 : scalar3` has `&node3` decorate
// the MAPPING `*alias1` becomes the first KEY of, not the bare alias node;
// `parseAlias`'s own `hadAnchor` check (parse.bit) is what catches the
// genuinely bare case there instead (an alias with NO following `:`).
fn rejectAnchorMisplaced(p: Parser, far: Option<string>, here: Option<string>, end: i64): ()! {
  if ((isSome(far) || isSome(here)) && p.s.kind == TokenKind.Alias) {
    fail parseError("yaml: an alias node cannot carry an anchor property", p.s.start)
  }
  rejectSeqOnAnchorLine(p, here, end)?
}

// `consumePropertyChain`'s own result: every anchor name seen across the
// whole chain (usually 0 or 1; more than 1 only when several
// property-only lines each carried one), the last property's end (for
// `rejectAnchorMisplaced`'s "same line" check, same as `consumeNodeProperties`'s
// own `prevEnd`), the FINAL line's own column, and whether an `Indent` was
// ever crossed at all (`parseBlockNode` dispatches differently either way,
// same as before this function existed).
class PropertyChain { names: []string, lastEnd: i64, col: i64, descended: bool }

// Chases a node's own `&anchor`/`!tag` prefix across every property-only
// LINE it spans, not just one: `consumeNodeProperties` reads a single
// line's worth and stops at the next `Indent`/`Dedent`, but a property can
// be alone on its own line for more than one line in a row before the
// node's real content (BU8L: `key: &anchor\n !!map\n  a: b` — the anchor
// inline, `!!map` a further line down, the mapping body a further line
// down still — three levels; `parseBlockNode`'s own recursion used to
// re-enter exactly once). Also drains a `Dedent` a property-only line can
// leave pending before content that is actually SHALLOWER than it (SKE5:
// `seq:\n &anchor\n- a\n- b` — the anchor's own line sits one column past
// the sequence dash it precedes) — `dispatchBlockNode`'s switch has no
// `Dedent` case, and no caller drained it before this existed. Bounded by
// `Scanner.indentStack`'s own `maxDepth` ceiling, the same bound this
// file's `parseBlockNode` caller already claims for the recursion this
// replaces.
fn consumePropertyChain(p: Parser, indent: i64, descended: bool): PropertyChain! {
  let (first, firstEnd) = consumeNodeProperties(p, indent, descended)?
  skipComments(p)?
  let names = []string(0)
  match (first) {
    Some(n) => { names = append(names, n) }
    None => {}
  }
  let lastEnd = firstEnd
  let col = indent
  let sawIndent = false
  while (p.s.kind == TokenKind.Dedent) {
    advance(p)
  }
  let guard = 0
  let bound = p.s.srcLen + 8
  while (p.s.kind == TokenKind.Indent && guard <= bound) {
    guard = guard + 1
    sawIndent = true
    advance(p)
    col = p.s.col
    let (next, nextEnd) = consumeNodeProperties(p, col, true)?
    rejectSeqOnAnchorLine(p, next, nextEnd)?
    match (next) {
      Some(n) => { names = append(names, n) }
      None => {}
    }
    lastEnd = nextEnd
    while (p.s.kind == TokenKind.Dedent) {
      advance(p)
    }
  }
  return PropertyChain{ names: names, lastEnd: lastEnd, col: col, descended: sawIndent }
}

// Applies every anchor name the chain collected, outermost last (matching
// `applyAnchor`'s own nesting order when there were exactly two: the
// caller passed the OUTER name last so it wraps the inner one) — order
// only matters if `yamlAnchorDefine` rejected a re-bind, which it does
// not (last write wins is already this table's own contract, anchor.bit).
fn applyAnchorChain(p: Parser, names: []string, value: Yaml): Yaml! {
  let result = value
  let i = 0
  while (i < len(names)) {
    result = applyAnchor(p, Option<string>.Some(names[i]), result)?
    i = i + 1
  }
  return result
}

// --- a mapping key wrapped in properties, or an alias --------------------

// The raw `*name` lookup, shared by `parse.bit`'s `parseAlias` (which peeks
// past it for a `:`, turning the alias into a compact mapping's first key —
// E76Z) and `readKeyPrimary` below (whose own caller, `readImplicitEntry`,
// runs that same `:` check itself). Returns the token's own `start`/`end`
// too — both callers need them (`hasLineBreak`'s "same line" check;
// `chargeBlockNode`'s offset).
fn resolveAliasToken(p: Parser): (Yaml, i64, i64)! {
  let start = p.s.start
  let end = p.s.end
  let name = p.src[start + 1:end]
  advance(p)
  let value = yamlAnchorResolve(p.anchors, name, p.limits)?
  return (value, start, end)
}

// A mapping key's own primary token: a bare scalar (as `readImplicitEntry`
// always read before) or an alias used directly as a key (E76Z's `*b :
// *a` is the OTHER shape, an alias with no anchor of its own — this is the
// same lookup reached from inside `readImplicitKey` once any properties
// are already consumed).
fn readKeyPrimary(p: Parser): Yaml! {
  if (p.s.kind == TokenKind.Alias) {
    let (value, start, _) = resolveAliasToken(p)?
    chargeBlockNode(p, start)?
    return value
  }
  let kind = p.s.kind
  let text = yamlDecodeScalar(p.src, kind, p.s.start, p.s.end)?
  advance(p)
  return resolveByKind(text, kind, p.resolver)
}

// A mapping key that may itself carry `&anchor`/`!tag` properties before
// its own scalar or alias (HMQ5: `!!str &a1 "foo":`; ZWK4: `&anchor c: 3`;
// 26DV: `&anchor6 'key6' :`) — the SAME key/value column threading
// `readImplicitEntry` already gave a bare scalar key, extended to one
// wrapped in properties. Single-line only (`consumeNodeProperties`, not
// the multi-line `consumePropertyChain`) — none of this group's ids chain
// a KEY's own properties across more than one line.
fn readImplicitKey(p: Parser, col: i64): (Yaml, i64)! {
  let keyStart = p.s.start
  let (anchorName, anchorEnd) = consumeNodeProperties(p, col, false)?
  rejectAnchorMisplaced(p, Option<string>.None, anchorName, anchorEnd)?
  let key = readKeyPrimary(p)?
  let named = applyAnchor(p, anchorName, key)?
  return (named, keyStart)
}
