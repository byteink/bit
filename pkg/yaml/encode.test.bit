// pkg/yaml/encode.test.bit — yamlEncode/yamlEncodeAll's round-trip and
// quoting contract (#5499), beside the file they test (pkg/README.md's
// layout rule).
//
// `mustParse`/`mustParseAll`/`intOf` are already defined by parse.test.bit;
// `yamlEqual` is already defined (module-private) by flow.bit — same flat
// module (pkg/README.md), redefining any of them here would be E0042.

fn mustEncode(y: Yaml): string {
  return yamlEncode(y) catch e {
    panic(e.message())
  }
}

fn mustEncodeAll(docs: []Yaml): string {
  return yamlEncodeAll(docs) catch e {
    panic(e.message())
  }
}

// THE deliverable: parse what was just encoded and compare the VALUE,
// structurally and by type, against the original — never generated text
// against a hand-written string (the ticket's own wording for why).
fn assertRoundTrip(y: Yaml, label: string) {
  let text = mustEncode(y)
  let back = mustParse(text)
  assert(yamlEqual(y, back), "${label}: round trip changed the value, got:\n${text}")
}

// Every string this ticket's own hard requirement, and the wider indicator
// set `encode.bit`'s header derives from `scan.bit`, calls out by name: a
// spelling the core schema would retype, a leading/trailing space, an
// empty string, every reserved leading byte, the two structural colon/hash
// traps, the two document markers, and the deliberately-NOT-retyped 1.1
// spellings (`no`/`off`/`on`/`yes`/`y`/`n`/`010`) that must survive as
// plain, unquoted strings.
fn adversarialStrings(): []string {
  return [
    "true", "True", "TRUE", "false", "False", "FALSE",
    "null", "Null", "NULL", "~",
    "123", "-123", "+123", "0", "0x1f", "0o17",
    "1.5", "-1.5", ".5", "1e10",
    ".inf", "-.inf", ".nan",
    "",
    " leading", "trailing ", " both ",
    "no", "off", "on", "yes", "y", "n", "010",
    "1.20",
    "- x", "- ", "-",
    "? key", "?",
    ": value", "ends:",
    "a: b", "a #b", "a b #c",
    "[flow]", "{flow}", "a,b",
    "&anchor", "*alias", "!tag", "#comment", "|literal", ">folded",
    "'single'", "\"double\"", "%directive", "@at", "`tick`",
    "line\nbreak", "cr\rreturn", "tab\ttab",
    "---", "...",
    "hello world", "plain-ish_text.123",
  ]
}

test "every adversarial string round-trips as a string, typed correctly" {
  let strs = adversarialStrings()
  let i = 0
  while (i < len(strs)) {
    assertRoundTrip(Yaml.YamlString(strs[i]), "adversarial string ${i} (\"${strs[i]}\")")
    i = i + 1
  }
}

// The ticket's own acceptance example: these five specific strings must
// come back as `YamlString`, not retyped.
test "the ticket's five named strings survive as strings" {
  let named = ["no", "1.20", "", "~", "- x"]
  let i = 0
  while (i < len(named)) {
    let text = mustEncode(Yaml.YamlString(named[i]))
    let back = mustParse(text)
    assert(yamlIsString(back), "\"${named[i]}\" must decode back to a string, got: ${text}")
    assert(strOfLocal(back) == named[i], "\"${named[i]}\" must decode back unchanged, got: ${text}")
    i = i + 1
  }
}

fn strOfLocal(y: Yaml): string {
  return unwrap(yamlAsString(y))
}

// Deliberately NOT quoted: quoting a 1.1 spelling the 1.2 core schema
// never resolves is noise, not safety (encode.bit's header, and the
// ticket's own "inverse Norway trap" wording).
test "1.1 spellings and a leading-zero octal are emitted bare, not quoted" {
  let bareOk = ["no", "off", "on", "yes", "y", "n", "010"]
  let i = 0
  while (i < len(bareOk)) {
    let text = mustEncode(Yaml.YamlString(bareOk[i]))
    assert(text == "${bareOk[i]}\n", "\"${bareOk[i]}\" must be emitted bare, got: ${text}")
    i = i + 1
  }
}

test "round trip: every scalar Yaml variant, nested with a non-scalar key" {
  assertRoundTrip(Yaml.YamlNull, "null")
  assertRoundTrip(Yaml.YamlBool(true), "bool true")
  assertRoundTrip(Yaml.YamlBool(false), "bool false")
  assertRoundTrip(Yaml.YamlInt(0), "int 0")
  assertRoundTrip(Yaml.YamlInt(-9223372036854775808), "int min")
  assertRoundTrip(Yaml.YamlInt(9223372036854775807), "int max")
  assertRoundTrip(Yaml.YamlFloat(1.5), "float 1.5")
  assertRoundTrip(Yaml.YamlFloat(100000.0), "float integer-valued")
  assertRoundTrip(Yaml.YamlSequence([]Yaml(0)), "empty sequence")
  assertRoundTrip(Yaml.YamlMapping([]YamlEntry(0)), "empty mapping")

  let inner = Yaml.YamlMapping(
    [
      YamlEntry{ key = Yaml.YamlString("no"), value = Yaml.YamlString("1.20") },
      YamlEntry{ key = Yaml.YamlString("empty"), value = Yaml.YamlString("") },
      YamlEntry{
        key = Yaml.YamlSequence([Yaml.YamlInt(1), Yaml.YamlInt(2)]),
        value = Yaml.YamlBool(true),
      },
    ],
  )
  let outer = Yaml.YamlSequence(
    [
      Yaml.YamlString("- x"),
      inner,
      Yaml.YamlSequence([Yaml.YamlSequence([Yaml.YamlString("~")])]),
      Yaml.YamlMapping([]YamlEntry(0)),
    ],
  )
  assertRoundTrip(outer, "nested structure with a non-scalar key")
}

// The one that actually catches regressions: round-trip a value that came
// from PARSING real source, not from a hand-built fixture — the ticket's
// own wording for why this matters.
test "parse(encode(parse(src))) equals parse(src)" {
  let src = "name: yaml\n" +
    "version: 1\n" +
    "tags:\n" +
    "- a\n" +
    "- b\n" +
    "nested:\n" +
    "  x: 1\n" +
    "  y:\n" +
    "  - 1\n" +
    "  - 2\n" +
    "flag: true\n" +
    "note: \"no\"\n" +
    "empty: \"\"\n"
  let original = mustParse(src)
  let text = mustEncode(original)
  let reparsed = mustParse(text)
  assert(yamlEqual(original, reparsed), "re-encoded parse result changed:\n${text}")
}

test "yamlEncodeAll separates documents with ---" {
  let docs = [Yaml.YamlInt(1), Yaml.YamlString("no"), Yaml.YamlMapping([]YamlEntry(0))]
  let text = mustEncodeAll(docs)
  let back = yamlParseAll(text) catch e {
    panic(e.message())
  }
  assert(len(back) == 3, "expected 3 documents back, got ${len(back)}: ${text}")
  let i = 0
  while (i < len(back)) {
    assert(yamlEqual(docs[i], back[i]), "document ${i} changed, got:\n${text}")
    i = i + 1
  }
}

// Float round-tripping, including a value whose shortest decimal form is
// long enough that a naive fixed-precision formatter would drop digits —
// shortest-round-trip printing (encode.bit's header) never does. `.inf`
// and `.nan` are the YAML 1.2 spellings, not `inf`/`nan`.
test "float round-tripping is exact, and .inf/.nan are the spellings emitted" {
  let precise = 0.1 + 0.2
  let text = mustEncode(Yaml.YamlFloat(precise))
  let back = unwrap(yamlAsFloat(mustParse(text)))
  assert(back == precise, "float lost precision: encoded ${text}, decoded back ${back}")

  let posInf = 1.0 / 0.0
  let negInf = 0.0 - 1.0 / 0.0
  let nan = 0.0 / 0.0
  let infText = mustEncode(Yaml.YamlFloat(posInf))
  let negInfText = mustEncode(Yaml.YamlFloat(negInf))
  let nanText = mustEncode(Yaml.YamlFloat(nan))
  assert(infText == ".inf\n", "expected '.inf', got ${infText}")
  assert(negInfText == "-.inf\n", "expected '-.inf', got ${negInfText}")
  assert(nanText == ".nan\n", "expected '.nan', got ${nanText}")

  let backInf = unwrap(yamlAsFloat(mustParse(infText)))
  let backNegInf = unwrap(yamlAsFloat(mustParse(negInfText)))
  let backNan = unwrap(yamlAsFloat(mustParse(nanText)))
  assert(backInf == posInf, "+.inf did not round-trip")
  assert(backNegInf == negInf, "-.inf did not round-trip")
  assert(backNan != backNan, "expected .nan to decode back to NaN")
}

// A genuinely cyclic value (a slice holding itself — arrays are reference
// types, so this is constructible) must fail fast at the depth ceiling,
// never hang. Proven by running to completion, per the ticket.
test "a cyclic value returns an error instead of hanging" {
  let inner = append([]Yaml(0), Yaml.YamlNull)
  inner[0] = Yaml.YamlSequence(inner)
  let failed = false
  yamlEncode(inner[0]) catch e {
    failed = true
    assert(contains(e.message(), "maxDepth"), e.message())
    return
  }
  assert(failed, "expected yamlEncode to fail on a cyclic value, not hang or succeed")
}
