// pkg/yaml/block.test.bit — yamlDecodeBlockScalar's chomping (clip/strip/keep,
// for both `|` and `>`), the folded more-indented-line trap, and the two
// header-indicator orderings, beside the file it tests (pkg/README.md's
// layout rule).
//
// `isDigit`/`isBlockHeaderChar` (scan.bit) are already in this module;
// importing anything from `std/strings` again here would be E0042
// (pkg/README.md's flat namespace) — `scalar.bit` already imports
// `Builder`/`newBuilder`/`trim`/`trimRight`, and `scan.test.bit` already
// imports `repeat`.

// The `[headerStart, headerEnd)` span `scan.bit`'s `scanBlockScalarHeader`
// would have produced for the first `|`/`>` at or after `startAt` — reusing
// its own `isBlockHeaderChar` so this can never drift from what the real
// scanner emits.
fn findHeader(src: string, startAt: i64): (i64, i64) {
  let n = len(src)
  let i = startAt
  while (i < n && src[i] != '|' && src[i] != '>') {
    i = i + 1
  }
  let start = i
  i = i + 1
  while (i < n && isBlockHeaderChar(src[i])) {
    i = i + 1
  }
  return (start, i)
}

// `yamlDecodeBlockScalar` is fallible only for malformed input; every call
// below sends well-formed input, so a failure here is a decoder bug.
fn mustDecodeBlock(
  src: string,
  headerStart: i64,
  headerEnd: i64,
  parentIndent: i64,
): (string, i64) {
  return yamlDecodeBlockScalar(src, headerStart, headerEnd, parentIndent) catch e {
    panic(e.message())
  }
}

// Decodes the block scalar found at `src`'s first `|`/`>`, at top-level
// (`parentIndent` 0) — the shape every test below except the explicit
// `parentIndent` one needs.
fn decodeTop(src: string): (string, i64) {
  let (hs, he) = findHeader(src, 0)
  return mustDecodeBlock(src, hs, he, 0)
}

// --- chomping: literal ------------------------------------------------------

test "literal clip keeps exactly one trailing newline" {
  let (text, _) = decodeTop("|\n  a\n  b\n")
  assert(text == "a\nb\n", "literal clip content")
}

test "literal strip keeps no trailing newline" {
  let (text, _) = decodeTop("|-\n  a\n  b\n")
  assert(text == "a\nb", "literal strip content")
}

test "literal keep keeps every trailing newline and blank line" {
  let (text, _) = decodeTop("|+\n  a\n  b\n\n\n")
  assert(text == "a\nb\n\n\n", "literal keep content")
}

// --- chomping: folded --------------------------------------------------------

test "folded clip folds the single break to a space and keeps one trailing newline" {
  let (text, _) = decodeTop(">\n  a\n  b\n")
  assert(text == "a b\n", "folded clip content")
}

test "folded strip folds the single break to a space and keeps no trailing newline" {
  let (text, _) = decodeTop(">-\n  a\n  b\n")
  assert(text == "a b", "folded strip content")
}

test "folded keep folds the single break but keeps every trailing blank line" {
  let (text, _) = decodeTop(">+\n  a\n  b\n\n\n")
  assert(text == "a b\n\n\n", "folded keep content")
}

// --- the folded more-indented trap -------------------------------------------

test "a more-indented line in a folded scalar is not folded, and neither is the break either side of it" {
  let (text, _) = decodeTop(">\n  aaa\n    more\n  bbb\n")
  // A naive implementation keys "more indented" off only the CURRENT line
  // at each separator, so the break AFTER "more" (back down to "bbb", which
  // is not itself more-indented) gets folded to a space, producing
  // "aaa\n  more bbb\n" instead. Both breaks around the more-indented line
  // must stay literal newlines.
  assert(text == "aaa\n  more\nbbb\n", "more-indented line must not fold on either side")
}

// --- explicit indentation indicator, either order ----------------------------

test "|2- and |-2 decode identically" {
  let src2Dash = "|2-\n   x\n  y\n"
  let srcDash2 = "|-2\n   x\n  y\n"
  let (textA, _) = decodeTop(src2Dash)
  let (textB, _) = decodeTop(srcDash2)
  assert(textA == textB, "|2- and |-2 must decode identically")
  assert(textA == " x\ny", "explicit indent 2, strip chomping")
}

test "an explicit indentation indicator preserves leading whitespace as content" {
  // blockIndent is 2 (explicit); "   x" has 3 leading spaces, so one space
  // survives the strip as content instead of being consumed as indentation.
  let (text, _) = decodeTop("|2-\n   x\n  y\n")
  assert(text == " x\ny", "leading whitespace beyond the explicit indent is content")
}

// --- resume offset and empty body --------------------------------------------

test "yamlDecodeBlockScalar returns the offset just past the block for the scanner to resume" {
  let prefix = "|\n  a\n  b\n"
  let src = prefix + "next: 1\n"
  let (text, resumeAt) = decodeTop(src)
  assert(text == "a\nb\n", "literal clip content before the sibling line")
  assert(resumeAt == len(prefix), "resume offset must land just past the block body")
}

test "a tab short of the explicit indent ends the block instead of counting as indentation" {
  // blockIndent is 2; the body's only line has a tab where two spaces
  // would be needed, so `countLeadingSpaces` sees 0 spaces (never counts
  // the tab) and the line ends the (empty) block rather than joining it.
  let header = "|2\n"
  let src = header + "\tx\n"
  let (hs, he) = findHeader(src, 0)
  let (text, resumeAt) = mustDecodeBlock(src, hs, he, 0)
  assert(text == "", "a tab can never satisfy the required indentation")
  assert(resumeAt == len(header), "the tab-led line is left for the caller, not consumed")
}
