// pkg/yaml/plainfold.bit — yaml module, the bare multi-line plain scalar
// fold (#5544, epic #1482). Split out of parse.bit purely to stay under
// spec/LINT.md's 800-line ceiling; `parseScalarOrMapping` is called only
// from `parse.bit`'s `dispatchBlockNode`, against the `Parser`/`Scanner`
// that file defines (module-private, same flat namespace, pkg/README.md).
//
// `scan.bit`'s `scanPlainScalar` never emits a `PlainScalar` token crossing
// a line (that file's own header), so this is the one place a block-context
// plain scalar's span is extended across MULTIPLE physical lines before
// `scalar.bit`'s `decodePlain`/`foldContent` fold it — mirroring what
// `flow.bit`'s `scanFlowPlainSpan` already does for a flow-context plain
// scalar, but column-aware instead of relying on flow's suppressed
// indentation.

// Extends a `PlainScalar` span across every deeper line, after a token
// already ruled out as a same-line mapping key. `Scanner.col` is
// re-measured once per physical line and stays valid for every token on
// it regardless of `Indent`/`Dedent` (`hasLineBreak`'s comment in
// parse.bit), so one upfront `p.s.col <= floor` covers a deeper `Indent`,
// a `Dedent` that may still clear `floor`, and a same-column repeat with
// no signal at all — an inline value whose column never left `floor`
// stops here rather than folding in the next sibling key. NOT the
// block-scalar more-indented rule (#5531).
//
// A `SeqEntry` at a qualifying (deeper-than-`floor`) column is swallowed
// into the fold rather than stopping it (AB8U: `- single multiline\n -
// sequence entry` — spec 7.3.3's `ns-plain-char` allows a bare `-` on a
// plain scalar's CONTINUATION line unconditionally; only `ns-plain-first`,
// a scalar's own opening character, excludes it before whitespace). Safe
// here specifically because `scan.bit`'s `SeqEntry` token is always the
// single `-` byte, never truncated or re-decoded the way `!`/`%` are
// (`corpusExclusionsPlainScalarFold`'s own FBC9/XLQ9 reason, a scan.bit
// gap this is not) — swallowing it costs one byte and the loop's next
// pass picks the rest of that line back up as an ordinary `PlainScalar`.
fn extendPlainFold(p: Parser, floor: i64, initialEnd: i64): i64 {
  let end = initialEnd
  let guard = 0
  let bound = p.s.srcLen + 8
  while (guard <= bound) {
    guard = guard + 1
    if (p.s.col <= floor) {
      return end
    }
    if (p.s.kind == TokenKind.Indent || p.s.kind == TokenKind.Dedent) {
      advance(p)
    }
    if (p.s.kind == TokenKind.SeqEntry) {
      end = p.s.end
      advance(p)
      continue
    }
    if (p.s.kind != TokenKind.PlainScalar) {
      return end
    }
    end = p.s.end
    advance(p)
  }
  return end
}

// A plain/quoted scalar that might turn out to be a mapping's first key
// (`ValueIndicator` on the SAME line, `hasLineBreak`). `rejectImplicitKey`
// is CXX2's root-shares-`---`-line case (§8.2.3); ruled out, a `PlainScalar`
// goes through `extendPlainFold` first.
//
// `pendingAnchor` (`parseBlockNode`'s own same-line branch, parse.bit —
// see its header) applies IMMEDIATELY to this scalar's own resolved value,
// before the key-or-value decision below, never deferred to whatever this
// call ends up returning: E76Z's `&a a: &b b` needs `*a`, read later, to
// resolve to the scalar `"a"` — the KEY this call is about to wrap into a
// mapping — not to that enclosing mapping itself, and `parseBlockMapping`
// below would already have resolved that later alias, inside this same
// call, before a deferred apply after return ever ran.
fn parseScalarOrMapping(
  p: Parser,
  col: i64,
  rejectImplicitKey: bool,
  floor: i64,
  pendingProps: PendingProps,
): Yaml! {
  let kind = p.s.kind
  let start = p.s.start
  let end = p.s.end
  advance(p)
  if (p.s.kind == TokenKind.ValueIndicator && !hasLineBreak(p.src, end, p.s.start)) {
    if (rejectImplicitKey) {
      fail parseError("yaml: a mapping cannot start on the document marker's own line", start)
    }
    // Spec 7.4.2: a quoted scalar's OWN span can contain a raw break even
    // though nothing yet separates it from the ':' that follows (JKF3:
    // `"bar\nbar": x` — `isMultilineQuoted`, parse.bit; same rule
    // `properties.bit`'s `readKeyPrimary` enforces for every entry after
    // this one, which never reaches this same-line peek at all).
    if (isMultilineQuoted(p.src, kind, start, end)) {
      fail parseError("yaml: an implicit mapping key must be a single line", start)
    }
    let text = yamlDecodeScalar(p.src, kind, start, end)?
    let key = applyAnchor(p, pendingProps, resolveByKind(text, kind, p.resolver))?
    checkNotMergeKey(key, start)?
    return parseBlockMapping(p, col, Option<Yaml>.Some(key), start)?
  }
  let finalEnd = kind == TokenKind.PlainScalar ? extendPlainFold(p, floor, end) : end
  let text = yamlDecodeScalar(p.src, kind, start, finalEnd)?
  chargeBlockNode(p, start)?
  return applyAnchor(p, pendingProps, resolveByKind(text, kind, p.resolver))?
}

// A flow collection that might turn out to be a mapping's first key —
// `hasLineBreak` from the flow's own OPENING bracket (`start`) to the
// `ValueIndicator` that follows covers both halves of spec 7.4.2's
// single-line implicit-key rule at once (C2SP's `[23\n]: 42` must still
// error: leaving `value` unconsumed here lets `parseDocumentContent`'s own
// "unexpected content after document" check, parse.bit, reject the
// un-claimed ':'). The SAME key-or-value decision `parseScalarOrMapping`
// above makes for a bare scalar, extended to LX3P/Q9WF (both single-line)
// and M2N8/01's compact-mapping-as-key shape (reached through
// `readExplicitEntry`'s own key read, blockmapping.bit, no separate
// mechanism needed). `rejectImplicitKey` is `dispatchBlockNode`'s own
// `ValueIndicator` case's twin (parse.bit, `NodeCtx.allowCompact`'s own
// header) — ZCZ6/ZL4Z's shape, just with a flow collection instead of a
// scalar.
fn parseFlowOrMapping(
  p: Parser,
  col: i64,
  pendingProps: PendingProps,
  rejectImplicitKey: bool,
): Yaml! {
  let start = p.s.start
  let flow = parseBlockFlow(p)?
  let value = applyAnchor(p, pendingProps, flow)?
  let isKey = p.s.kind == TokenKind.ValueIndicator && !hasLineBreak(p.src, start, p.s.start)
  if (isKey && rejectImplicitKey) {
    fail parseError("yaml: unexpected token in block context", p.s.start)
  }
  if (isKey) {
    return parseBlockMapping(p, col, Option<Yaml>.Some(value), start)?
  }
  return value
}
