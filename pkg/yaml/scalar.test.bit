// pkg/yaml/scalar.test.bit — yamlDecodeScalar's three styles: every
// double-quoted escape in the ticket's set, the fold rule (single break to a
// space, N breaks to N-1 newlines, a more-indented line not folding) for
// both plain and double-quoted, and single-quoted's `''` collapse, beside
// the file it tests (pkg/README.md's layout rule).
//
// `Builder`/`newBuilder`/`trim`/`trimRight` and `contains` are already
// imported into this module by scalar.bit and scan.test.bit respectively —
// importing any of them again here would be E0042 (pkg/README.md's flat
// namespace).

// A one-byte string holding `c` — used both to build a raw YAML escape
// sequence byte-for-byte and to state an expected single-byte decode result,
// without a second, separate escaping convention to keep in sync with the
// one `simpleEscapeByte` (scalar.bit) actually implements.
fn byteStr(c: u8): string {
  return newBuilder().writeByte(c).toString()
}

// `cp`'s own UTF-8 encoding — reuses `writeUtf8Rune` (scalar.bit, same
// module) so an expected value here can never drift from what the decoder
// itself emits for the same codepoint.
fn runeUtf8(cp: i64): string {
  let b = newBuilder()
  writeUtf8Rune(b, cp)
  return b.toString()
}

// `yamlDecodeScalar` is fallible only for malformed input; every call below
// a `*Error*`-named test sends well-formed input, so a failure here is a
// decoder bug, not an expected path.
fn mustDecode(src: string, kind: TokenKind): string {
  return yamlDecodeScalar(src, kind, 0, len(src)) catch e {
    panic(e.message())
  }
}

// The error message `yamlDecodeScalar` fails with for `src`, or `""` when
// it unexpectedly succeeds — callers assert `msg != ""` first so a wrongly
// successful decode fails loudly instead of an empty-string message reading
// as "no complaint".
fn decodeErrorMessage(src: string, kind: TokenKind): string {
  let msg = ""
  yamlDecodeScalar(src, kind, 0, len(src)) catch e {
    msg = e.message()
    return msg
  }
  return ""
}

// --- double-quoted: every escape in the ticket's set ----------------------

test "double-quoted decodes every single-byte escape in the ticket's set" {
  // Aligned with `simpleEscapeByte` (scalar.bit) index-for-index.
  let letters = "0abtnvfre\"/\\"
  let bytes = [0, 7, 8, 9, 10, 11, 12, 13, 27, 34, 47, 92]
  let i = 0
  while (i < len(letters)) {
    let letter = byteStr(letters[i])
    let src = "\"\\" + letter + "\""
    let got = mustDecode(src, TokenKind.DoubleQuoted)
    assert(got == byteStr(u8(bytes[i])), "escape \\${letter} decoded to the wrong byte")
    i = i + 1
  }
}

test "double-quoted decodes the fixed-codepoint escapes \\N \\_ \\L \\P" {
  // Aligned with `namedEscapeCodepoint` (scalar.bit) index-for-index.
  let letters = "N_LP"
  let points = [0x85, 0xA0, 0x2028, 0x2029]
  let i = 0
  while (i < len(letters)) {
    let letter = byteStr(letters[i])
    let src = "\"\\" + letter + "\""
    let got = mustDecode(src, TokenKind.DoubleQuoted)
    assert(got == runeUtf8(points[i]), "escape \\${letter} decoded to the wrong codepoint")
    i = i + 1
  }
}

test "double-quoted decodes \\x \\u \\U hex escapes" {
  assert(mustDecode("\"\\x41\"", TokenKind.DoubleQuoted) == "A", "\\x41 must decode to 'A'")
  assert(
    mustDecode("\"\\u00e9\"", TokenKind.DoubleQuoted) == runeUtf8(0xe9),
    "\\u00e9 must decode to U+00E9",
  )
  assert(
    mustDecode("\"\\U0001F600\"", TokenKind.DoubleQuoted) == runeUtf8(0x1F600),
    "\\U0001F600 must decode to U+1F600",
  )
}

test "double-quoted with no escape decodes to exactly the literal text" {
  assert(
    mustDecode("\"hello world\"", TokenKind.DoubleQuoted) == "hello world",
    "no-escape fast path",
  )
}

test "double-quoted rejects an unknown escape" {
  let msg = decodeErrorMessage("\"\\q\"", TokenKind.DoubleQuoted)
  assert(msg != "", "an unknown escape must fail")
  assert(contains(msg, "unknown escape"), msg)
}

test "double-quoted rejects a lone (unpaired) surrogate \\u escape" {
  let msg = decodeErrorMessage("\"\\uD800\"", TokenKind.DoubleQuoted)
  assert(msg != "", "a lone surrogate must fail")
  assert(contains(msg, "surrogate"), msg)
}

test "double-quoted rejects a codepoint above U+10FFFF" {
  let msg = decodeErrorMessage("\"\\U00110000\"", TokenKind.DoubleQuoted)
  assert(msg != "", "a codepoint above U+10FFFF must fail")
  assert(contains(msg, "10FFFF"), msg)
}

test "double-quoted rejects a trailing unterminated escape" {
  let msg = decodeErrorMessage("\"abc\\\"", TokenKind.DoubleQuoted)
  assert(msg != "", "a backslash with nothing after it must fail")
  assert(contains(msg, "unterminated"), msg)
}

test "double-quoted: a backslash before a line break removes the break entirely" {
  let src = "\"line one\\\nline two\""
  assert(
    mustDecode(src, TokenKind.DoubleQuoted) == "line oneline two",
    "escaped break must fold away, not to a space",
  )
}

// --- line folding: plain and double-quoted -------------------------------

test "plain folds a single line break to one space" {
  assert(
    mustDecode("line one\nline two", TokenKind.PlainScalar) == "line one line two",
    "single break folds to a space",
  )
}

test "plain folds N consecutive breaks to N-1 newlines" {
  // "line one" \n "" \n "" \n "line two": 3 breaks, 2 blank lines between.
  let got = mustDecode("line one\n\n\nline two", TokenKind.PlainScalar)
  assert(got == "line one\n\nline two", "3 breaks must fold to 2 newlines, got: ${got}")
}

test "plain: a break adjacent to a more-indented line does not fold" {
  // "line two" (indent 0) sets the baseline; "line three" (indent 2) is
  // more-indented, so its break stays literal and its extra indentation
  // beyond the baseline is kept as content (this file's own header).
  let got = mustDecode("line one\nline two\n  line three", TokenKind.PlainScalar)
  assert(got == "line one line two\n  line three", "more-indented break must not fold, got: ${got}")
}

test "plain single-line scalar decodes to exactly its span" {
  let src = "just one line, no break at all"
  assert(mustDecode(src, TokenKind.PlainScalar) == src, "single-line plain must be untouched")
}

test "double-quoted folds a single line break to one space" {
  let got = mustDecode("\"line one\nline two\"", TokenKind.DoubleQuoted)
  assert(got == "line one line two", "single break folds to a space")
}

test "double-quoted folds N consecutive breaks to N-1 newlines" {
  let got = mustDecode("\"line one\n\n\nline two\"", TokenKind.DoubleQuoted)
  assert(got == "line one\n\nline two", "3 breaks must fold to 2 newlines, got: ${got}")
}

test "double-quoted: a break adjacent to a more-indented line does not fold" {
  let got = mustDecode("\"line one\nline two\n  line three\"", TokenKind.DoubleQuoted)
  assert(got == "line one line two\n  line three", "more-indented break must not fold, got: ${got}")
}

// --- single-quoted: only `''`, no backslash escapes ------------------------

test "single-quoted collapses '' to one literal apostrophe" {
  assert(mustDecode("'it''s'", TokenKind.SingleQuoted) == "it's", "'' must collapse to a single '")
}

test "single-quoted treats backslash as a literal byte, never an escape" {
  let src = "'a\\b'"
  assert(mustDecode(src, TokenKind.SingleQuoted) == "a\\b", "backslash must pass through literally")
}

test "single-quoted with no '' decodes to exactly the literal text" {
  assert(mustDecode("'hello world'", TokenKind.SingleQuoted) == "hello world", "no-'' fast path")
}

// --- dispatch ---------------------------------------------------------

test "double-quoted decodes a literal \\n escape without treating it as a fold-worthy break" {
  // A decoded `\n` escape is a real LF BYTE — indistinguishable from a
  // source line break once it is sitting in the output string — so this
  // guards against re-folding it (the bug `decodeDoubleQuotedSegments`'s
  // own header explains).
  let got = mustDecode("\"a\\nb\"", TokenKind.DoubleQuoted)
  assert(
    got == "a" + byteStr(10) + "b",
    "a \\n escape must decode to one literal LF byte, got: ${len(got)} bytes",
  )
}

test "yamlDecodeScalar rejects a non-scalar token kind" {
  let msg = decodeErrorMessage("# comment", TokenKind.Comment)
  assert(msg != "", "a non-scalar kind must fail")
}
