// pkg/yaml/directive.bit — yaml module, `%YAML`/`%TAG` directive-line syntax
// validation (#5532, epic #1482). Split out of parse.bit purely to stay
// under spec/LINT.md's 800-line ceiling — every function here is called
// only from parse.bit's `skipStreamNoise` (module-private, same flat
// namespace, pkg/README.md), on the raw span of one `Directive` token
// (`scan.bit`'s span covers the whole line, comment included).
//
// SYNTAX ONLY. These checks reject the four shapes
// `corpusExclusionsDirectiveValidation`'s own reason string names —
// trailing garbage on the line, a malformed version, a malformed tag
// handle/prefix — never a directive's SEMANTIC scope (a `%TAG` handle used
// in a later document than the one that declared it, QLJ7's own remaining
// gap, stays excluded: that needs a per-document declared-handle table,
// not a syntax check).

// The whitespace run `s-separate-in-line` requires: one or more spaces or
// tabs (spec 6.1 — `MUS6/02`'s double space, `MUS6/03`'s tab both use this).
fn isDirectiveBlank(c: u8): bool {
  return c == ' ' || c == '\t'
}

fn skipDirectiveBlanks(text: string, i: i64): i64 {
  let n = len(text)
  while (i < n && isDirectiveBlank(text[i])) {
    i = i + 1
  }
  return i
}

// Whatever follows a directive's own required fields: nothing, blanks only,
// or blanks then a `#` comment running to the token's own end (the token
// already stops at the line break, `scan.bit`'s own span). `MUS6/00`'s
// `1.1#...` (no separating blank before `#`) and `H7TQ`'s `1.2 foo` (a
// non-blank, non-`#` word) are both rejected here.
fn checkDirectiveTrailer(text: string, i: i64, offset: i64): ()! {
  let n = len(text)
  if (i >= n) {
    return
  }
  if (!isDirectiveBlank(text[i])) {
    fail parseError("yaml: unexpected content on directive line", offset)
  }
  let j = skipDirectiveBlanks(text, i)
  if (j < n && text[j] != '#') {
    fail parseError("yaml: unexpected content on directive line", offset)
  }
}

// `%YAML` followed by exactly one MAJOR.MINOR version (spec 9.1.3) and
// nothing else but blanks/a comment. The version's own digits are never
// range-checked against 1.2 — a minor-version mismatch is a warning per
// spec, not a syntax error (`BEC7`'s `%YAML 1.3` must keep parsing).
fn checkYamlDirective(text: string, offset: i64): ()! {
  let n = len(text)
  let i = skipDirectiveBlanks(text, 5)
  let majorStart = i
  while (i < n && isDigit(text[i])) {
    i = i + 1
  }
  if (i == majorStart || i >= n || text[i] != '.') {
    fail parseError("yaml: malformed %YAML directive: expected a MAJOR.MINOR version", offset)
  }
  i = i + 1
  let minorStart = i
  while (i < n && isDigit(text[i])) {
    i = i + 1
  }
  if (i == minorStart) {
    fail parseError("yaml: malformed %YAML directive: expected a MAJOR.MINOR version", offset)
  }
  checkDirectiveTrailer(text, i, offset)?
}

// Scans a %TAG handle (`!`, `!!`, or `!name!`) starting at `i`, already
// confirmed to be `!` — the index right past it, never failing (the two
// legal shapes cover every byte run `isDirectiveBlank`/`!` bounds).
fn scanTagHandleEnd(text: string, i: i64): i64 {
  let n = len(text)
  let j = i + 1
  while (j < n && !isDirectiveBlank(text[j]) && text[j] != '!') {
    j = j + 1
  }
  if (j < n && text[j] == '!') {
    j = j + 1
  }
  return j
}

// `%TAG` followed by a handle (`!`, `!!`, or `!name!`) and a non-blank
// prefix (spec 6.8.2), then nothing else but blanks/a comment.
fn checkTagDirective(text: string, offset: i64): ()! {
  let n = len(text)
  let i = skipDirectiveBlanks(text, 4)
  if (i >= n || text[i] != '!') {
    fail parseError(
      "yaml: malformed %TAG directive: expected a tag handle starting with '!'",
      offset,
    )
  }
  let handleEnd = scanTagHandleEnd(text, i)
  let afterHandle = skipDirectiveBlanks(text, handleEnd)
  if (afterHandle == handleEnd) {
    fail parseError("yaml: malformed %TAG directive: missing separator before prefix", offset)
  }
  let prefixStart = afterHandle
  let j = prefixStart
  while (j < n && !isDirectiveBlank(text[j])) {
    j = j + 1
  }
  if (j == prefixStart) {
    fail parseError("yaml: malformed %TAG directive: missing tag prefix", offset)
  }
  checkDirectiveTrailer(text, j, offset)?
}

// `name` is `%YAML`/`%TAG` when the directive's fifth/fourth byte is itself
// a blank — a longer or different name (`MUS6/06`'s `%YAMLL 1.1`) is a
// reserved directive, spec-required to be accepted and ignored, never
// version/tag validated. Returns whether this was specifically the `%YAML`
// directive — `skipStreamNoise` (parse.bit) uses that to reject a second
// one before the next document boundary (`SF5V`).
fn checkDirective(text: string, offset: i64): bool! {
  let n = len(text)
  if (n >= 6 && text[0:5] == "%YAML" && isDirectiveBlank(text[5])) {
    checkYamlDirective(text, offset)?
    return true
  }
  if (n >= 5 && text[0:4] == "%TAG" && isDirectiveBlank(text[4])) {
    checkTagDirective(text, offset)?
    return false
  }
  return false
}
