// pkg/yaml/parse.test.bit — yamlParse/yamlParseAll/yamlParseWith's block
// mappings, block sequences, the stream, and the scalar-style contract
// (#5498), beside the file they test (pkg/README.md's layout rule).
//
// `unwrap`/`contains` are already imported into this module by
// value.test.bit/scan.test.bit (pkg/README.md's flat namespace — importing
// either again here would be E0042). `mapOf`/`seqOf`/`strOf` are already
// defined by flow.test.bit (same reason — a second definition would be
// E0042 too), reused here as-is.

fn mustParse(src: string): Yaml {
  return yamlParse(src) catch e {
    panic(e.message())
  }
}

fn mustParseAll(src: string): []Yaml {
  return yamlParseAll(src) catch e {
    panic(e.message())
  }
}

fn mustFailParse(src: string): error {
  yamlParse(src) catch e {
    return e
  }
  panic("expected a parse error, but yamlParse succeeded")
}

fn intOf(y: Yaml): i64 {
  return unwrap(yamlAsInt(y))
}

// --- block mappings ---------------------------------------------------------

test "a block mapping of scalar keys and values parses in source order" {
  let m = mapOf(mustParse("a: 1\nb: 2\n"))
  assert(len(m) == 2, "expected 2 entries, got ${len(m)}")
  assert(strOf(m[0].key) == "a" && intOf(m[0].value) == 1, "entry 0")
  assert(strOf(m[1].key) == "b" && intOf(m[1].value) == 2, "entry 1")
}

test "an empty value after 'key:' is YamlNull" {
  let m = mapOf(mustParse("a:\nb: 1\n"))
  assert(yamlIsNull(m[0].value), "empty value must be YamlNull")
  assert(intOf(m[1].value) == 1, "the following entry must still parse")
}

test "duplicate keys in a block mapping are rejected" {
  let e = mustFailParse("a: 1\na: 2\n")
  assert(contains(e.message(), "duplicate"), "error must name the duplicate: ${e.message()}")
}

test "an explicit '? key' / ': value' pair parses like an implicit mapping entry" {
  let m = mapOf(mustParse("? a\n: 1\n"))
  assert(strOf(m[0].key) == "a" && intOf(m[0].value) == 1, "explicit key/value")
}

test "an explicit key with no ': value' resolves to YamlNull" {
  let m = mapOf(mustParse("? a\nb: 1\n"))
  assert(yamlIsNull(m[0].value), "explicit key alone must be YamlNull")
  assert(intOf(m[1].value) == 1, "a following implicit entry must still parse")
}

// --- block sequences ---------------------------------------------------------

test "a block sequence of scalars parses in source order" {
  let s = seqOf(mustParse("- a\n- b\n- c\n"))
  assert(len(s) == 3, "expected 3 items, got ${len(s)}")
  assert(strOf(s[0]) == "a" && strOf(s[1]) == "b" && strOf(s[2]) == "c", "sequence order")
}

test "a sequence nested at the same indentation as its parent key parses as that key's value" {
  let m = mapOf(mustParse("items:\n- a\n- b\n"))
  assert(strOf(m[0].key) == "items", "key")
  let items = seqOf(m[0].value)
  assert(
    len(items) == 2 && strOf(items[0]) == "a" && strOf(items[1]) == "b",
    "same-indent sequence value",
  )
}

test "a sequence indented deeper than its parent key also parses as that key's value" {
  let m = mapOf(mustParse("items:\n  - a\n  - b\n"))
  let items = seqOf(m[0].value)
  assert(len(items) == 2, "deeper-indented sequence value, got ${len(items)}")
}

// --- the stream ---------------------------------------------------------

test "a multi-document stream with --- and ... parses every document" {
  let docs = mustParseAll("---\na: 1\n...\n---\nb: 2\n...\n")
  assert(len(docs) == 2, "expected 2 documents, got ${len(docs)}")
  assert(intOf(mapOf(docs[0])[0].value) == 1, "document 0")
  assert(intOf(mapOf(docs[1])[0].value) == 2, "document 1")
}

test "an empty stream returns zero documents" {
  let docs = mustParseAll("")
  assert(len(docs) == 0, "expected 0 documents, got ${len(docs)}")
}

// #5539 W4TN: a document-root block scalar's implicit indent resolves to 0
// (flush-left content, no enclosing key/dash to indent past) — block.bit's
// collectBlockLines must still stop at the next document's own boundary
// marker even though `spaces < blockIndent` can never fire at 0. Before the
// fix this swallowed everything through EOF, including the second
// document's own directive and '---', dropping it: yamlParseAll returned 1
// document, not 2.
test "a document-root block scalar does not swallow the next document" {
  let docs = mustParseAll("--- |\nhello\n...\n---\n# Empty\n...\n")
  assert(len(docs) == 2, "expected 2 documents, got ${len(docs)}")
  assert(strOf(docs[0]) == "hello\n", "document 0 block scalar")
  assert(yamlIsNull(docs[1]), "document 1 is an empty (comment-only) document")
}

test "yamlParse errors on a two-document stream instead of returning the first" {
  let e = mustFailParse("---\na: 1\n---\nb: 2\n")
  assert(
    contains(e.message(), "one document"),
    "error must name the document count: ${e.message()}",
  )
}

// --- scalar style: the default resolver types, yamlResolveRaw does not ------

test "yamlResolveRaw keeps every scalar a string where the default resolver would type it" {
  // The ticket's own acceptance example resolves "no" — but schema.bit
  // deliberately pins the YAML 1.2 core schema (its own header: a
  // yes/no/on/off table "must never" be added, the Norway-problem fix), so
  // "no" is YamlString under BOTH resolvers and cannot demonstrate the
  // raw-vs-typed distinction this test exists to prove. "true" is a real
  // 1.2 bool spelling and does.
  let typedDoc = mustParse("a: true\n")
  assert(yamlIsBool(mapOf(typedDoc)[0].value), "default resolver must type a bare 'true' as bool")

  let rawOpts = YamlOptions{ limits = yamlDefaultLimits(), resolver = yamlResolveRaw }
  let rawDocs = yamlParseWith("a: true\n", rawOpts) catch e {
    panic(e.message())
  }
  let rawValue = mapOf(rawDocs[0])[0].value
  assert(
    yamlIsString(rawValue) && strOf(rawValue) == "true",
    "yamlResolveRaw must keep 'true' a string",
  )
}

// --- unsupported constructs ---------------------------------------------------

test "a merge key '<<' returns a named error instead of being mis-parsed" {
  let e = mustFailParse("<<: *base\nname: a\n")
  assert(contains(e.message(), "merge"), "error must name merge keys: ${e.message()}")
}

// --- duplicate keys in a wide block mapping (#6059) ------------------------
//
// `mapKeysInsert` (mapkeys.bit) scans a mapping's first `mapKeysScanMax`
// string keys and hashes every key after them, so each duplicate below sits
// past twenty earlier keys: a test with fewer would pass against the scan
// alone and never reach the map.

// `n` block entries `k0: 0` .. `k<n-1>: <n-1>`, one per line.
fn blockKeys(n: i64): string {
  let b = newBuilder()
  let i = 0
  while (i < n) {
    b.write("k${i}: ${i}\n")
    i = i + 1
  }
  return b.toString()
}

fn expectBlockDuplicate(src: string, offset: i64) {
  let e = mustFailParse(src)
  assert(
    e.message() == "yaml: duplicate key in block mapping at byte ${offset}",
    "got: ${e.message()}",
  )
}

test "a block mapping of 50,000 distinct keys parses to 50,000 entries" {
  let m = mapOf(mustParse(blockKeys(50_000)))
  assert(len(m) == 50_000, "expected 50000 entries, got ${len(m)}")
  assert(strOf(m[49_999].key) == "k49999" && intOf(m[49_999].value) == 49_999, "last entry")
}

test "a duplicate plain key past the scanned prefix is rejected at its own offset" {
  let prefix = blockKeys(20)
  expectBlockDuplicate("${prefix}k3: x\n", len(prefix))
}

test "a quoted key duplicates the plain key with the same text" {
  let prefix = blockKeys(20)
  expectBlockDuplicate("${prefix}\"k3\": x\n", len(prefix))
  expectBlockDuplicate("'a': 1\na: 2\n", 7)
}

test "two aliases of one anchor are one key in a wide block mapping" {
  // "v: &x 1\n*x : 2\n" is 15 bytes, so the second '*x' starts 15 bytes
  // past the prefix.
  let prefix = blockKeys(20)
  expectBlockDuplicate("${prefix}v: &x 1\n*x : 2\n*x : 3\n", len(prefix) + 15)
}

test "an anchored key and an equal undecorated key are two keys, in either order" {
  let m = mapOf(mustParse("&a k3: first\n${blockKeys(20)}&b k3: last\n"))
  assert(len(m) == 22, "expected 22 entries, got ${len(m)}")
  assert(strOf(m[21].value) == "last", "the anchored repeat must be kept")
}

test "int keys are compared by value, past the scanned prefix too" {
  let b = newBuilder()
  let i = 0
  while (i < 20) {
    b.write("${i}: x\n")
    i = i + 1
  }
  let prefix = b.toString()
  expectBlockDuplicate("${prefix}0x3: y\n", len(prefix))
}

test "float keys follow ==: 0.0 and -0.0 are one key, two NaNs are two" {
  expectBlockDuplicate("0.0: a\n-0.0: b\n", 7)
  let m = mapOf(mustParse(".nan: a\n.nan: b\n"))
  assert(len(m) == 2, "expected 2 entries, got ${len(m)}")
}

// --- collection keys in a wide block mapping (#6346) ------------------------
//
// Undecorated sequence and mapping keys are found through `keyEncode`'s
// exact encoding (mapkeys.bit) rather than compared against every earlier
// key, so these pin that the encoding draws the same line `yamlEqual` does.

// `n` block entries `? [k0]` / `: 0` .. `? [k<n-1>]` / `: <n-1>`.
fn blockSeqKeys(n: i64): string {
  let b = newBuilder()
  let i = 0
  while (i < n) {
    b.write("? [k${i}]\n: ${i}\n")
    i = i + 1
  }
  return b.toString()
}

test "a block mapping of 20,000 distinct sequence keys parses to 20,000 entries" {
  let m = mapOf(mustParse(blockSeqKeys(20_000)))
  assert(len(m) == 20_000, "expected 20000 entries, got ${len(m)}")
  let last = seqOf(m[19_999].key)
  assert(strOf(last[0]) == "k19999" && intOf(m[19_999].value) == 19_999, "last entry")
}

test "a repeated sequence key past twenty others is rejected at its own offset" {
  let prefix = blockSeqKeys(20)
  expectBlockDuplicate("${prefix}? [k3]\n: x\n", len(prefix))
}

test "collection keys follow ==: a NaN anywhere makes two keys, 0.0 and -0.0 one" {
  let m = mapOf(mustParse("? [.nan]\n: a\n? [.nan]\n: b\n? {a: .nan}\n: c\n? {a: .nan}\n: d\n"))
  assert(len(m) == 4, "expected 4 entries, got ${len(m)}")
  expectBlockDuplicate("? [0.0]\n: a\n? [-0.0]\n: b\n", 12)
}

test "mapping keys compare every key and every value, in order" {
  expectBlockDuplicate("? {a: 1}\n: x\n? {a: 1}\n: y\n", 13)
  let src = "? {a: 1}\n: x\n? {a: 2}\n: y\n? {b: 1}\n: z\n? {a: 1, b: 2}\n: v\n? {b: 2, a: 1}\n: w\n"
  let m = mapOf(mustParse(src))
  assert(len(m) == 5, "expected 5 entries, got ${len(m)}")
}

test "collection keys of different arms or shapes are different keys" {
  let scalars = "? [1]\n: a\n? [1.0]\n: b\n? ['1']\n: c\n? [null]\n: d\n? ['null']\n: e\n"
  let shapes = "? [true]\n: f\n? [false]\n: g\n? [[a], b]\n: h\n? [[a, b]]\n: i\n? []\n: j\n? {}\n: k\n"
  let m = mapOf(mustParse("${scalars}${shapes}"))
  assert(len(m) == 11, "expected 11 entries, got ${len(m)}")
}

test "decorations inside a collection key are read through, as yamlEqual reads them" {
  expectBlockDuplicate("? [&x k3]\n: a\n? [k3]\n: b\n", 14)
  expectBlockDuplicate("? [&x k3]\n: a\n? [*x]\n: b\n", 14)
  expectBlockDuplicate("? [!!str k3]\n: a\n? [k3]\n: b\n", 17)
}

test "long strings and multi-byte ints inside a collection key keep their identity" {
  // Forty bytes is past the length a key's string is written out in full,
  // so these two are told apart by id; 300 and 44 share their low seven bits.
  let a = repeat("a", 40)
  let head = "? [${a}]\n: 1\n"
  expectBlockDuplicate("${head}? [${a}]\n: 2\n", len(head))
  let ints = "? [300]\n: a\n? [44]\n: b\n? [-1]\n: c\n? [-129]\n: d\n? [9223372036854775807]\n: e\n"
  let m = mapOf(mustParse("${head}? [${repeat("a", 39)}b]\n: 2\n${ints}"))
  assert(len(m) == 7, "expected 7 entries, got ${len(m)}")
  expectBlockDuplicate("? [300]\n: a\n? [300]\n: b\n", 12)
}

// --- collection keys against `yamlEqual` itself (#6346) ---------------------
//
// Generated keys, each checked against the answer a scan of every earlier
// key with `yamlEqual` gives: the oracle the encoding replaced.

// A fixed-seed LCG, so every run draws the same keys.
class KeyRng { state: u64 }

fn keyRngNext(r: KeyRng, n: i64): i64 {
  r.state = r.state * 6364136223846793005 + 1442695040888963407
  return i64((r.state >> 33) % u64(n))
}

// A leaf, anchored one time in four: a decoration inside a key is read
// through, so it must not change the answer.
fn keyGenLeaf(r: KeyRng, leaves: []Yaml): Yaml {
  let leaf = leaves[keyRngNext(r, len(leaves))]
  if (keyRngNext(r, 4) != 0) {
    return leaf
  }
  return yamlDecorate(leaf, Option<string>.Some("x"), Option<string>.None, Option<string>.None)
}

fn keyGenNode(r: KeyRng, leaves: []Yaml, depth: i64): Yaml {
  let pick = keyRngNext(r, 8)
  if (depth == 0 || pick < 4) {
    return keyGenLeaf(r, leaves)
  }
  if (pick < 6) {
    return Yaml.YamlSequence(keyGenItems(r, leaves, depth - 1))
  }
  return Yaml.YamlMapping(keyGenEntries(r, leaves, depth - 1))
}

fn keyGenItems(r: KeyRng, leaves: []Yaml, depth: i64): []Yaml {
  let out = []Yaml(0)
  let n = keyRngNext(r, 3)
  let i = 0
  while (i < n) {
    out = append(out, keyGenNode(r, leaves, depth))
    i = i + 1
  }
  return out
}

fn keyGenEntries(r: KeyRng, leaves: []Yaml, depth: i64): []YamlEntry {
  let out = []YamlEntry(0)
  let n = keyRngNext(r, 3)
  let i = 0
  while (i < n) {
    let key = keyGenNode(r, leaves, depth)
    out = append(out, YamlEntry{ key = key, value = keyGenNode(r, leaves, depth) })
    i = i + 1
  }
  return out
}

// A top-level key: a sequence or a mapping, the arms the encoding serves.
fn keyGenTop(r: KeyRng, leaves: []Yaml): Yaml {
  if (keyRngNext(r, 2) == 0) {
    return Yaml.YamlSequence(keyGenItems(r, leaves, 2))
  }
  return Yaml.YamlMapping(keyGenEntries(r, leaves, 2))
}

fn keySeenByScan(entries: []YamlEntry, key: Yaml): bool {
  for e of entries {
    if (yamlEqual(e.key, key)) {
      return true
    }
  }
  return false
}

test "collection-key duplicates agree with a yamlEqual scan on 2,000 generated keys" {
  let long = repeat("x", 40)
  let src = "[~, true, false, 0, 1, -1, 300, 0.0, -0.0, .nan, 1.0, a, '${long}', '${long}y']"
  let leaves = seqOf(mustParse(src))
  let r = KeyRng{ state = 1 }
  let ks = newMapKeys()
  let entries = []YamlEntry(0)
  let dups = 0
  let i = 0
  while (i < 2000) {
    let key = keyGenTop(r, leaves)
    let fresh = !keySeenByScan(entries, key)
    assert(mapKeysInsert(ks, entries, key) == fresh, "key ${i}: the scan says fresh=${fresh}")
    if (fresh) {
      entries = append(entries, YamlEntry{ key = key, value = Yaml.YamlNull })
    } else {
      dups = dups + 1
    }
    i = i + 1
  }
  assert(
    dups >= 200 && len(entries) >= 200,
    "too few of either answer: ${dups} duplicates, ${len(entries)} fresh",
  )
}
