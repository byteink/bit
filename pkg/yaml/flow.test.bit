// pkg/yaml/flow.test.bit — yamlParseFlow's grammar (flow.bit, #5495), beside
// the file it tests (pkg/README.md's layout rule).
//
// Every byte offset asserted below was hand-derived from the literal source
// string in its own test (indices commented inline), not guessed — the
// acceptance criterion is the offset itself, so a wrong one would pass a
// weaker check and hide a real bug.

// `unwrap` is already imported into this module by value.test.bit (same
// module, importing it again here would be E0042 — pkg/README.md's flat
// namespace).

// Positions `s` on its first token and parses one flow value from `limits`
// and `depth`, panicking on an unexpected parse error — every call site
// below the error-path tests sends well-formed flow source, so a failure
// here is this file's own bug, not an expected path (scan.test.bit's
// `mustScan` mirrors the same convention).
fn mustParseFlow(source: string, limits: YamlLimits, depth: i64): Yaml {
  let s = newScanner(source, limits)
  scanNext(s)
  return yamlParseFlow(s, limits, depth) catch e {
    panic(e.message())
  }
}

fn parseFlow(source: string, limits: YamlLimits): Yaml {
  return mustParseFlow(source, limits, 0)
}

// The error from parsing `source`, panicking if it unexpectedly succeeds —
// every call site is a deliberately malformed input.
fn mustFailFlow(source: string, limits: YamlLimits): error {
  let s = newScanner(source, limits)
  scanNext(s)
  yamlParseFlow(s, limits, 0) catch e {
    return e
  }
  panic("expected a parse error, but flow parsing succeeded")
}

fn defaultLimits(): YamlLimits {
  return yamlDefaultLimits()
}

fn seqOf(y: Yaml): []Yaml {
  return unwrap(yamlAsSequence(y))
}

fn mapOf(y: Yaml): []YamlEntry {
  return unwrap(yamlAsMapping(y))
}

fn strOf(y: Yaml): string {
  return unwrap(yamlAsString(y))
}

// --- empty collections ---------------------------------------------------

test "an empty flow sequence and flow mapping parse to zero entries" {
  let seq = seqOf(parseFlow("[]", defaultLimits()))
  assert(len(seq) == 0, "[] must hold zero elements, got ${len(seq)}")
  let m = mapOf(parseFlow("{}", defaultLimits()))
  assert(len(m) == 0, "{} must hold zero entries, got ${len(m)}")
}

// --- plain sequences and mappings -----------------------------------------

test "a flow sequence of plain scalars parses in source order" {
  let seq = seqOf(parseFlow("[a, b]", defaultLimits()))
  assert(len(seq) == 2, "expected 2 elements, got ${len(seq)}")
  assert(strOf(seq[0]) == "a", "element 0")
  assert(strOf(seq[1]) == "b", "element 1")
}

test "a flow mapping of plain scalar entries parses in source order" {
  let m = mapOf(parseFlow("{a: 1, b: 2}", defaultLimits()))
  assert(len(m) == 2, "expected 2 entries, got ${len(m)}")
  assert(strOf(m[0].key) == "a" && strOf(m[0].value) == "1", "entry 0")
  assert(strOf(m[1].key) == "b" && strOf(m[1].value) == "2", "entry 1")
}

// --- omitted values --------------------------------------------------------

test "{a} is {a: null}: a flow mapping entry may omit its value" {
  let m = mapOf(parseFlow("{a}", defaultLimits()))
  assert(len(m) == 1, "expected 1 entry, got ${len(m)}")
  assert(strOf(m[0].key) == "a", "key")
  assert(yamlIsNull(m[0].value), "an omitted value must be YamlNull")
}

test "{a: } is also {a: null}: a colon with nothing after it is the same as no colon" {
  let m = mapOf(parseFlow("{a: }", defaultLimits()))
  assert(len(m) == 1, "expected 1 entry, got ${len(m)}")
  assert(strOf(m[0].key) == "a", "key")
  assert(yamlIsNull(m[0].value), "value after a bare ':' must be YamlNull")
}

// --- bare pair inside a flow sequence --------------------------------------

test "[a: 1] is a sequence holding one single-entry mapping, not a mapping itself" {
  let seq = seqOf(parseFlow("[a: 1]", defaultLimits()))
  assert(len(seq) == 1, "expected 1 element, got ${len(seq)}")
  let inner = mapOf(seq[0])
  assert(len(inner) == 1, "the element must be a 1-entry mapping, got ${len(inner)}")
  assert(strOf(inner[0].key) == "a" && strOf(inner[0].value) == "1", "the pair's key/value")
}

// --- explicit key indicator -------------------------------------------------

test "an explicit '?' key is legal in flow context" {
  // "{? a: 1}": 0='{' 1='?' 2=' ' 3='a' 4=':' 5=' ' 6='1' 7='}'
  let m = mapOf(parseFlow("{? a: 1}", defaultLimits()))
  assert(len(m) == 1, "expected 1 entry, got ${len(m)}")
  assert(strOf(m[0].key) == "a" && strOf(m[0].value) == "1", "the explicit-key pair")
}

test "an explicit '?' key with no value is null, same as the implicit form" {
  let m = mapOf(parseFlow("{? a}", defaultLimits()))
  assert(len(m) == 1, "expected 1 entry, got ${len(m)}")
  assert(strOf(m[0].key) == "a", "key")
  assert(yamlIsNull(m[0].value), "value")
}

// --- non-scalar keys ---------------------------------------------------

test "a flow mapping key may itself be a sequence, not just a scalar" {
  let m = mapOf(parseFlow("{[a,b]: c}", defaultLimits()))
  assert(len(m) == 1, "expected 1 entry, got ${len(m)}")
  let key = seqOf(m[0].key)
  assert(len(key) == 2, "the key sequence must hold 2 elements, got ${len(key)}")
  assert(strOf(key[0]) == "a" && strOf(key[1]) == "b", "key elements")
  assert(strOf(m[0].value) == "c", "value")
}

// --- line breaks fold as whitespace inside flow ----------------------------

test "a flow collection may span line breaks; indentation carries no meaning inside it" {
  let seq = seqOf(parseFlow("[a,\n  b]", defaultLimits()))
  assert(len(seq) == 2, "expected 2 elements, got ${len(seq)}")
  assert(strOf(seq[0]) == "a" && strOf(seq[1]) == "b", "elements across the line break")
}

// --- trailing comma: permitted, per YAML 1.2.2 (not a JSON5/TOML rule) ----

test "a trailing comma is permitted in a flow sequence: [a, b,] parses like [a, b]" {
  let seq = seqOf(parseFlow("[a, b,]", defaultLimits()))
  assert(len(seq) == 2, "expected 2 elements, got ${len(seq)}")
  assert(strOf(seq[0]) == "a" && strOf(seq[1]) == "b", "elements")
}

test "a trailing comma is permitted in a flow mapping: {a: 1, b: 2,} parses like {a: 1, b: 2}" {
  let m = mapOf(parseFlow("{a: 1, b: 2,}", defaultLimits()))
  assert(len(m) == 2, "expected 2 entries, got ${len(m)}")
  assert(strOf(m[0].key) == "a" && strOf(m[0].value) == "1", "entry 0")
  assert(strOf(m[1].key) == "b" && strOf(m[1].value) == "2", "entry 1")
}

// --- rejections, each asserting the error's byte offset --------------------

test "an empty entry (a doubled comma) is rejected: [a,, b] does not parse" {
  // "[a,, b]": 0='[' 1='a' 2=',' 3=',' 4=' ' 5='b' 6=']'
  let e = mustFailFlow("[a,, b]", defaultLimits())
  assert(e.message() == "yaml: expected a flow value at byte 3", "got: ${e.message()}")
}

test "a leading comma is rejected: [, a] does not parse" {
  // "[, a]": 0='[' 1=',' 2=' ' 3='a' 4=']'
  let e = mustFailFlow("[, a]", defaultLimits())
  assert(e.message() == "yaml: expected a flow value at byte 1", "got: ${e.message()}")
}

test "a duplicate flow-mapping key is rejected, naming the repeat's own offset" {
  // "{a: 1, a: 2}": second key 'a' starts at byte 7.
  let e = mustFailFlow("{a: 1, a: 2}", defaultLimits())
  assert(
    e.message() == "yaml: duplicate key in flow mapping at byte 7",
    "got: ${e.message()}",
  )
}

test "a plain scalar cannot contain a flow indicator: [x[y]] is rejected, not absorbed" {
  // "[x[y]]": 0='[' 1='x' 2='[' 3='y' 4=']' 5=']'. The scanner already stops
  // the plain scalar 'x' the moment it reaches '[' (scan.bit's
  // isFlowStopperChar, checked because flowDepth > 0) rather than reading
  // "x[y]" as one scalar, so the parser sees an unexpected '[' at byte 2
  // where ',' or ']' was required — a naive, JSON-derived scalar reader
  // that kept scanning through '[' would have accepted this input instead.
  let e = mustFailFlow("[x[y]]", defaultLimits())
  assert(
    e.message() == "yaml: expected ',' or closing bracket in flow collection at byte 2",
    "got: ${e.message()}",
  )
}

// --- the DoS guards, proven by running to completion, not crashing --------

fn limitsWithDepth(maxDepth: i64): YamlLimits {
  return YamlLimits{
    maxDepth: maxDepth,
    maxAliasExpansions: yamlDefaultLimits().maxAliasExpansions,
    maxTotalNodes: yamlDefaultLimits().maxTotalNodes,
    maxDocumentBytes: yamlDefaultLimits().maxDocumentBytes,
  }
}

fn limitsWithTotalNodes(maxTotalNodes: i64): YamlLimits {
  return YamlLimits{
    maxDepth: yamlDefaultLimits().maxDepth,
    maxAliasExpansions: yamlDefaultLimits().maxAliasExpansions,
    maxTotalNodes: maxTotalNodes,
    maxDocumentBytes: yamlDefaultLimits().maxDocumentBytes,
  }
}

// Calls `yamlParseFlow` directly with `depth` already at the caller's own
// (simulated block-context) nesting level — proving THIS FILE's own
// explicit `depth` counter rejects the collection, independent of
// scan.bit's separate bracket-count guard on `flowDepth`, which a shallow
// "[]" would never trip on its own.
fn mustFailFlowAtDepth(source: string, limits: YamlLimits, depth: i64): error {
  let s = newScanner(source, limits)
  scanNext(s)
  yamlParseFlow(s, limits, depth) catch e {
    return e
  }
  panic("expected a parse error, but flow parsing succeeded")
}

test "depth already at the caller's ceiling rejects a shallow flow collection, not a crash" {
  let e = mustFailFlowAtDepth("[]", limitsWithDepth(2), 2)
  assert(e.message() == "yaml: nesting exceeds maxDepth at byte 0", "got: ${e.message()}")
}

// A document actually built past maxDepth via bracket nesting: proves the
// composed system (scanner's own flowDepth cap, or this file's depth
// counter, whichever trips first) rejects it and the process still runs to
// completion instead of hanging or crashing.
test "a flow collection nested past maxDepth returns an error rather than crashing" {
  let limits = limitsWithDepth(4)
  let e = mustFailFlow("[[[[[[]]]]]]", limits)
  assert(len(e.message()) > 0, "must carry a non-empty error message")
}

test "a flow sequence wider than maxTotalNodes returns an error rather than crashing" {
  // "[a,b,c,d,e]": 0='[' 1='a' 3='b' 5='c' 7='d' 9='e' 10=']'. Three scalars
  // (a, b, c) charge the budget to exactly 3; the fourth ('d', byte 7) is
  // where the running count crosses maxTotalNodes.
  let limits = limitsWithTotalNodes(3)
  let e = mustFailFlow("[a,b,c,d,e]", limits)
  assert(
    e.message() == "yaml: too many nodes: maxTotalNodes exceeded at byte 7",
    "got: ${e.message()}",
  )
}
