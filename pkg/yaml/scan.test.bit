// pkg/yaml/scan.test.bit — scan.bit's token-kind coverage, the
// YAML-specific scanning rules, the `scan`/`scanNext` grammar parity, and
// the `maxDepth` DoS guard, beside the file they test (pkg/README.md's
// layout rule).

fn hasKind(toks: []Token, k: TokenKind): bool {
  let i = 0
  while (i < len(toks)) {
    if (toks[i].kind == k) {
      return true
    }
    i = i + 1
  }
  return false
}

fn countKind(toks: []Token, k: TokenKind): int {
  let n = 0
  let i = 0
  while (i < len(toks)) {
    if (toks[i].kind == k) {
      n = n + 1
    }
    i = i + 1
  }
  return n
}

// One document exercising every token kind except `Invalid` (which has its
// own dedicated tab/maxDepth tests below, so it is never provoked here by
// accident). Shared by the coverage test and the `scanNext` parity test so
// both prove the same claim over the same input.
fn coverageSource(): string {
  return "%YAML 1.2\n" +
    "---\n" +
    "? key\n" +
    ": value\n" +
    "a: 1\n" +
    "b:\n" +
    "  - item1\n" +
    "  - &anchor item2\n" +
    "c: *anchor\n" +
    "d: !!str tagged\n" +
    "e: 'it''s'\n" +
    "f: \"hi\"\n" +
    "g: |-\n" +
    "  block\n" +
    "h: [x, y]\n" +
    "i: {j: k}\n" +
    "# trailing comment\n" +
    "...\n"
}

test "scan() produces every token kind the scanner defines, but Invalid" {
  let toks = scan(coverageSource(), yamlDefaultLimits())
  assert(hasKind(toks, TokenKind.Indent), "Indent")
  assert(hasKind(toks, TokenKind.Dedent), "Dedent")
  assert(hasKind(toks, TokenKind.KeyIndicator), "KeyIndicator")
  assert(hasKind(toks, TokenKind.ValueIndicator), "ValueIndicator")
  assert(hasKind(toks, TokenKind.SeqEntry), "SeqEntry")
  assert(hasKind(toks, TokenKind.Anchor), "Anchor")
  assert(hasKind(toks, TokenKind.Alias), "Alias")
  assert(hasKind(toks, TokenKind.Tag), "Tag")
  assert(hasKind(toks, TokenKind.Comment), "Comment")
  assert(hasKind(toks, TokenKind.DocStart), "DocStart")
  assert(hasKind(toks, TokenKind.DocEnd), "DocEnd")
  assert(hasKind(toks, TokenKind.Directive), "Directive")
  assert(hasKind(toks, TokenKind.PlainScalar), "PlainScalar")
  assert(hasKind(toks, TokenKind.SingleQuoted), "SingleQuoted")
  assert(hasKind(toks, TokenKind.DoubleQuoted), "DoubleQuoted")
  assert(hasKind(toks, TokenKind.BlockScalarHeader), "BlockScalarHeader")
  assert(hasKind(toks, TokenKind.FlowSeqStart), "FlowSeqStart")
  assert(hasKind(toks, TokenKind.FlowSeqEnd), "FlowSeqEnd")
  assert(hasKind(toks, TokenKind.FlowMapStart), "FlowMapStart")
  assert(hasKind(toks, TokenKind.FlowMapEnd), "FlowMapEnd")
  assert(hasKind(toks, TokenKind.FlowEntry), "FlowEntry")
  assert(hasKind(toks, TokenKind.Eof), "Eof")
}

test "scanNext drives the identical kind/start/end sequence scan() returns" {
  let source = coverageSource()
  let limits = yamlDefaultLimits()
  let want = scan(source, limits)
  let s = newScanner(source, limits)
  let i = 0
  while (i < len(want)) {
    scanNext(s)
    assert(s.kind == want[i].kind, "token ${i}: kind mismatch")
    assert(s.start == want[i].start, "token ${i}: start mismatch")
    assert(s.end == want[i].end, "token ${i}: end mismatch")
    i = i + 1
  }
}

// --- YAML-specific facts, one test each ---------------------------------

test "a tab used for indentation is rejected as Invalid, not silently accepted" {
  let source = "a:\n\tb: 1\n"
  let toks = scan(source, yamlDefaultLimits())
  assert(hasKind(toks, TokenKind.Invalid), "the tab-indented line must yield Invalid")
  let i = 0
  let found = false
  while (i < len(toks)) {
    if (toks[i].kind == TokenKind.Invalid) {
      assert(
        toks[i].start == 3,
        "Invalid must span the tab byte itself, got start ${toks[i].start}",
      )
      assert(toks[i].end == 4, "Invalid must be one byte wide, got end ${toks[i].end}")
      found = true
    }
    i = i + 1
  }
  assert(found, "the Invalid token must have been inspected")
}

test "a colon not followed by space/newline/EOF does not end a key: http://x is one scalar" {
  let toks = scan("http://x\n", yamlDefaultLimits())
  assert(toks[0].kind == TokenKind.PlainScalar, "first token must be PlainScalar")
  assert(
    toks[0].start == 0 && toks[0].end == 8,
    "must span the whole 'http://x', got [${toks[0].start},${toks[0].end})",
  )
  assert(
    !hasKind(toks, TokenKind.ValueIndicator),
    "the embedded colons must not split into ValueIndicator",
  )
}

test "a dash not followed by space/newline is scalar content: -3 is not SeqEntry" {
  let toks = scan("-3\n", yamlDefaultLimits())
  assert(toks[0].kind == TokenKind.PlainScalar, "first token must be PlainScalar")
  assert(
    toks[0].start == 0 && toks[0].end == 2,
    "must span '-3', got [${toks[0].start},${toks[0].end})",
  )
  assert(!hasKind(toks, TokenKind.SeqEntry), "-3 must not be read as a SeqEntry")
}

test "a hash with no preceding whitespace does not start a comment: a#b is one scalar" {
  let toks = scan("a#b\n", yamlDefaultLimits())
  assert(toks[0].kind == TokenKind.PlainScalar, "first token must be PlainScalar")
  assert(
    toks[0].start == 0 && toks[0].end == 3,
    "must span 'a#b', got [${toks[0].start},${toks[0].end})",
  )
  assert(!hasKind(toks, TokenKind.Comment), "a#b must not split off a Comment")
}

test "flow context suppresses Indent/Dedent regardless of column changes inside it" {
  let source = "[\n  a,\n    b\n]\n"
  let toks = scan(source, yamlDefaultLimits())
  assert(hasKind(toks, TokenKind.FlowSeqStart), "must still open the flow sequence")
  assert(hasKind(toks, TokenKind.FlowSeqEnd), "must still close the flow sequence")
  assert(hasKind(toks, TokenKind.FlowEntry), "must still see the flow entry comma")
  assert(!hasKind(toks, TokenKind.Indent), "no Indent may fire while flowDepth > 0")
  assert(!hasKind(toks, TokenKind.Dedent), "no Dedent may fire while flowDepth > 0")
}

test "a blank line between two block entries carries no indentation signal" {
  let source = "a:\n  b: 1\n\nc: 2\n"
  let toks = scan(source, yamlDefaultLimits())
  assert(hasKind(toks, TokenKind.Indent), "the 'b: 1' line must still indent")
  assert(
    countKind(toks, TokenKind.Dedent) == 1,
    "exactly one Dedent (from 'c: 2'), the blank line must add none; got ${countKind(
      toks,
      TokenKind.Dedent,
    )}",
  )
}

// --- the DoS guard --------------------------------------------------------

test "nesting past maxDepth yields Invalid and returns rather than crashing" {
  let limits = YamlLimits{
    maxDepth: 3,
    maxAliasExpansions: yamlDefaultLimits().maxAliasExpansions,
    maxTotalNodes: yamlDefaultLimits().maxTotalNodes,
    maxDocumentBytes: yamlDefaultLimits().maxDocumentBytes,
  }
  let source = "x\n x\n  x\n   x\n    x\n     x\n"
  let toks = scan(source, limits)
  assert(hasKind(toks, TokenKind.Invalid), "a document nested past maxDepth must yield Invalid")
  assert(hasKind(toks, TokenKind.Eof), "scanning must still terminate with Eof, not hang or crash")
}
