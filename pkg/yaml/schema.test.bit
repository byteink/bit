// pkg/yaml/schema.test.bit — YAML 1.2 core schema implicit typing: every
// accepted null/bool/int/float spelling, the 1.1 spellings that must stay
// strings (the Norway problem this file's own header names), the quoted/
// escape-hatch paths, and the overflow-is-a-string rule, beside the file it
// tests (pkg/README.md's layout rule).
//
// `isSome`/`isNone`/`unwrap` are already imported into this module by
// value.test.bit — importing any of them again here would be E0042
// (pkg/README.md's flat namespace).

// --- the Norway problem: 1.1 boolean spellings must stay strings ----------

test "1.1 boolean spellings (yes/no/on/off/y/n) resolve to YamlString, not bool" {
  let spellings = ["no", "yes", "on", "off", "y", "n"]
  let i = 0
  while (i < len(spellings)) {
    let got = yamlResolveScalar(spellings[i], ScalarStyle.Plain)
    assert(yamlIsString(got), "'${spellings[i]}' must stay a string under the 1.2 core schema")
    assert(
      unwrap(yamlAsString(got)) == spellings[i],
      "'${spellings[i]}' text must round-trip unchanged",
    )
    i = i + 1
  }
}

// --- null ------------------------------------------------------------

test "every accepted null spelling resolves to YamlNull" {
  let spellings = ["null", "Null", "NULL", "~", ""]
  let i = 0
  while (i < len(spellings)) {
    assert(
      yamlIsNull(yamlResolveScalar(spellings[i], ScalarStyle.Plain)),
      "'${spellings[i]}' must resolve null",
    )
    i = i + 1
  }
}

test "a near-miss null spelling stays a string" {
  assert(
    yamlIsString(yamlResolveScalar("Nul", ScalarStyle.Plain)),
    "'Nul' is not one of the four null spellings",
  )
}

// --- bool --------------------------------------------------------------

test "every accepted bool spelling resolves to its YamlBool value" {
  let trues = ["true", "True", "TRUE"]
  let falses = ["false", "False", "FALSE"]
  let i = 0
  while (i < len(trues)) {
    assert(
      unwrap(yamlAsBool(yamlResolveScalar(trues[i], ScalarStyle.Plain))) == true,
      "'${trues[i]}' must resolve true",
    )
    assert(
      unwrap(yamlAsBool(yamlResolveScalar(falses[i], ScalarStyle.Plain))) == false,
      "'${falses[i]}' must resolve false",
    )
    i = i + 1
  }
}

// --- int -----------------------------------------------------------------

test "decimal int spellings, including sign and zero" {
  assert(unwrap(yamlAsInt(yamlResolveScalar("0", ScalarStyle.Plain))) == 0, "'0'")
  assert(unwrap(yamlAsInt(yamlResolveScalar("123", ScalarStyle.Plain))) == 123, "'123'")
  assert(unwrap(yamlAsInt(yamlResolveScalar("-123", ScalarStyle.Plain))) == 0 - 123, "'-123'")
  assert(unwrap(yamlAsInt(yamlResolveScalar("+123", ScalarStyle.Plain))) == 123, "'+123'")
}

test "0o is the 1.2 octal spelling; a bare leading zero is a string, not octal" {
  assert(
    unwrap(yamlAsInt(yamlResolveScalar("0o10", ScalarStyle.Plain))) == 8,
    "'0o10' must be octal 8",
  )
  assert(
    unwrap(yamlAsInt(yamlResolveScalar("0o17", ScalarStyle.Plain))) == 15,
    "'0o17' must be octal 15",
  )
  let leadingZero = yamlResolveScalar("010", ScalarStyle.Plain)
  assert(yamlIsString(leadingZero), "'010' must be a string, not octal 8 or decimal 10")
  assert(unwrap(yamlAsString(leadingZero)) == "010", "'010' text must round-trip unchanged")
}

test "0x hex int spellings, upper and lower digit case" {
  assert(unwrap(yamlAsInt(yamlResolveScalar("0x1A", ScalarStyle.Plain))) == 26, "'0x1A'")
  assert(unwrap(yamlAsInt(yamlResolveScalar("0xff", ScalarStyle.Plain))) == 255, "'0xff'")
  assert(unwrap(yamlAsInt(yamlResolveScalar("0x0", ScalarStyle.Plain))) == 0, "'0x0'")
}

test "an integer beyond i64 range resolves to a string, never a wrapped number" {
  let decOverflow = yamlResolveScalar("99999999999999999999", ScalarStyle.Plain)
  assert(yamlIsString(decOverflow), "a 20-digit decimal past i64::MAX must stay a string")
  assert(
    unwrap(yamlAsString(decOverflow)) == "99999999999999999999",
    "overflowed decimal text must round-trip unchanged",
  )

  let hexOverflow = yamlResolveScalar("0xFFFFFFFFFFFFFFFF", ScalarStyle.Plain)
  assert(
    yamlIsString(hexOverflow),
    "a hex literal past i64::MAX (but within u64) must stay a string",
  )
}

// --- float -----------------------------------------------------------

test "general float spellings: leading dot, trailing dot, exponent, sign" {
  assert(unwrap(yamlAsFloat(yamlResolveScalar(".5", ScalarStyle.Plain))) == 0.5, "'.5'")
  assert(unwrap(yamlAsFloat(yamlResolveScalar("5.", ScalarStyle.Plain))) == 5.0, "'5.'")
  assert(unwrap(yamlAsFloat(yamlResolveScalar("5.5", ScalarStyle.Plain))) == 5.5, "'5.5'")
  assert(unwrap(yamlAsFloat(yamlResolveScalar("5e2", ScalarStyle.Plain))) == 500.0, "'5e2'")
  assert(
    unwrap(yamlAsFloat(yamlResolveScalar("-5.5e-1", ScalarStyle.Plain))) == 0.0 - 0.55,
    "'-5.5e-1'",
  )
}

test "a bare digit run with no dot and no exponent is int's territory, not float's" {
  let got = yamlResolveScalar("123", ScalarStyle.Plain)
  assert(yamlIsInt(got), "'123' must resolve as YamlInt, never YamlFloat")
}

test "every case variant of .inf/-.inf/.nan resolves to the right float" {
  let posInf = 1.0 / 0.0
  let negInf = 0.0 - 1.0 / 0.0
  let posSpellings = [".inf", "+.inf", ".Inf", "+.Inf", ".INF", "+.INF"]
  let i = 0
  while (i < len(posSpellings)) {
    assert(
      unwrap(yamlAsFloat(yamlResolveScalar(posSpellings[i], ScalarStyle.Plain))) == posInf,
      "'${posSpellings[i]}' must be +Inf",
    )
    i = i + 1
  }
  let negSpellings = ["-.inf", "-.Inf", "-.INF"]
  let j = 0
  while (j < len(negSpellings)) {
    assert(
      unwrap(yamlAsFloat(yamlResolveScalar(negSpellings[j], ScalarStyle.Plain))) == negInf,
      "'${negSpellings[j]}' must be -Inf",
    )
    j = j + 1
  }
  let nanSpellings = [".nan", ".NaN", ".NAN"]
  let k = 0
  while (k < len(nanSpellings)) {
    let v = unwrap(yamlAsFloat(yamlResolveScalar(nanSpellings[k], ScalarStyle.Plain)))
    assert(v != v, "'${nanSpellings[k]}' must be NaN")
    k = k + 1
  }
}

test "a signed nan spelling is not nan; nan never takes a sign" {
  assert(
    yamlIsString(yamlResolveScalar("-.nan", ScalarStyle.Plain)),
    "'-.nan' is not a core-schema spelling",
  )
  assert(
    yamlIsString(yamlResolveScalar("+.nan", ScalarStyle.Plain)),
    "'+.nan' is not a core-schema spelling",
  )
}

// --- quoting and the raw escape hatch --------------------------------

test "a quoted scalar is never implicitly typed" {
  let asQuoted = yamlResolveScalar("true", ScalarStyle.Quoted)
  assert(yamlIsString(asQuoted), "quoted 'true' must stay a string")
  assert(unwrap(yamlAsString(asQuoted)) == "true", "quoted 'true' text must round-trip unchanged")

  let numeric = yamlResolveScalar("123", ScalarStyle.Quoted)
  assert(yamlIsString(numeric), "quoted '123' must stay a string")
}

test "a block scalar is never implicitly typed" {
  let asBlock = yamlResolveScalar("no", ScalarStyle.Block)
  assert(yamlIsString(asBlock), "block-style 'no' must stay a string")
}

test "yamlResolveRaw returns YamlString for every null/bool/int/float spelling" {
  let inputs = ["null", "~", "true", "false", "123", "-5", "0x1A", "0o17", "5.5", ".inf", ".nan"]
  let i = 0
  while (i < len(inputs)) {
    let got = yamlResolveRaw(inputs[i], ScalarStyle.Plain)
    assert(yamlIsString(got), "yamlResolveRaw('${inputs[i]}') must be a string")
    assert(
      unwrap(yamlAsString(got)) == inputs[i],
      "yamlResolveRaw('${inputs[i]}') text must round-trip unchanged",
    )
    i = i + 1
  }
}

test "yamlResolveRaw ignores style just as yamlResolveRaw always returns a string" {
  let quoted = yamlResolveRaw("no", ScalarStyle.Quoted)
  let plain = yamlResolveRaw("no", ScalarStyle.Plain)
  assert(unwrap(yamlAsString(quoted)) == "no", "raw quoted")
  assert(unwrap(yamlAsString(plain)) == "no", "raw plain")
}

// --- anything else is a string, the default outcome ----------------------

test "an ordinary word is a string, the default outcome, not an error" {
  assert(yamlIsString(yamlResolveScalar("hello", ScalarStyle.Plain)), "'hello' must be a string")
  assert(
    yamlIsString(yamlResolveScalar("1.20.3", ScalarStyle.Plain)),
    "'1.20.3' is not a valid float shape",
  )
  assert(
    yamlIsString(yamlResolveScalar("-", ScalarStyle.Plain)),
    "a bare '-' has no digits at all",
  )
}
