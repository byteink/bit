// pkg/yaml/flow.bit — yaml module, flow sequences and flow mappings, where
// indentation stops mattering (#5495, epic #1482). `value.bit`, `scan.bit`
// and `scalar.bit` are siblings in this same flat module (pkg/README.md);
// `yamlParseFlow` is the one door a block-context parser (#5498, #5494)
// drives once it sees a `FlowSeqStart`/`FlowMapStart` token — everything in
// this file is unreachable from outside a `[`/`{`.
//
// A TRAILING COMMA IS PERMITTED (YAML 1.2.2 §7.4/§7.5: flow entries are
// comma-separated, and the grammar's own `s-l+flow-in-block` production
// allows the last entry's `,` before the closer). What is forbidden is an
// EMPTY NODE ENTRY — a doubled comma (`[a,, b]`) or a leading one
// (`[, a]`) — never a JSON/JSON5 rule to borrow from by analogy.
// `flowAfterEntry` is the one place this is decided: a `,` immediately
// followed by the closer is consumed as a legal trailing comma and closes
// the collection right there; a `,` followed by anything else (including
// another `,`) falls through to the ordinary `parseFlowNode` value check,
// which is what actually rejects a doubled or leading comma (neither is a
// valid flow value) — see `parseFlowNode`'s own comment.
//
// TYPING IS THE CALLER'S CHOICE, THREADED THROUGH — never decided here.
// `FlowCtx.resolver` is the same `(string, ScalarStyle) => Yaml` function
// `pkg/yaml/parse.bit`'s `Parser.resolver` carries (`YamlOptions`, that
// file's own header), passed down from `yamlParseFlow`'s own `resolver`
// parameter. `parseFlowScalar` calls it with `ScalarStyle.Plain` for a
// `PlainScalar` token and `ScalarStyle.Quoted` for `SingleQuoted`/
// `DoubleQuoted` — `resolveFlowScalar` below, matching `parse.bit`'s own
// `resolveByKind` exactly. A caller that reaches `yamlResolveScalar` gets
// `[true, 123]` typed; one that passes `yamlResolveRaw` (`schema.bit`'s own
// escape hatch) gets `YamlString` regardless of shape — this file never
// picks a default of its own, so the two contexts can never disagree about
// the same document (#5515).
//
// PLAIN SCALAR TERMINATION IS THE SCANNER'S JOB, NOT RE-CHECKED HERE.
// `scan.bit`'s `scanPlainScalar` already stops a `PlainScalar` token at `,`,
// `[`, `]`, `{`, `}` whenever `flowDepth > 0` (`isFlowStopperChar`), and at
// the identical `:` boundary rule block context uses (`isColonBoundary`) —
// so a `PlainScalar` token this file receives can never itself contain a raw
// flow indicator; `yamlDecodeScalar` (scalar.bit) decodes whatever span it
// is handed with no flow-awareness of its own, and needs none. An unquoted
// attempt to write a flow indicator into what looks like a single scalar —
// `[x[y]]`, intending the plain scalar `x[y]` — is what the scanner's rule
// turns into a syntax error instead: `x` closes as its own token the moment
// `[` is reached, leaving the parser looking at an unexpected `[` where a
// `,` or the closer was required. See flow.test.bit's rejection test.
//
// NESTING DEPTH is `depth`, an explicit counter threaded through every
// recursive call — never Bit's own call stack, which would turn a
// pathologically deep `[[[[...` into a crash instead of a rejection
// (`checkDepth`). `depth` starts wherever the caller's own block nesting
// already stands (0 for a document that opens directly with `[`/`{`), so a
// flow collection nested inside deep block content is bounded against the
// SAME `limits.maxDepth` ceiling, combined — not a second, flow-only budget.
// The scanner's own `flowDepth` (scan.bit) is a separate, narrower guard
// (bracket count alone, no block depth) that already protects `scanNext`
// itself; this file's counter is the one that sees the whole picture.
//
// TOTAL NODE COUNT is `FlowCtx.nodes`, incremented by `chargeNode` for every
// `Yaml` value this file builds — leaf scalars, `YamlNull`, and each
// sequence/mapping itself — and checked against `limits.maxTotalNodes` on
// every charge, so a wide flow collection (many siblings, no extra depth) is
// bounded exactly like a deep one.
//
// PERFORMANCE. This file drives `scanNext` exclusively, never `scan` — a
// parse never materializes `[]Token`, matching scan.bit's own two-entry-point
// design (that file's header explains the allocation this avoids).

// Bundles the scanner cursor, the budget, and the running node count that
// `chargeNode` mutates across every recursive call inside one top-level
// `yamlParseFlow` invocation. Not exported: only this file's functions drive
// it.
class FlowCtx {
  s: Scanner,
  limits: YamlLimits,
  nodes: i64,
  resolver: (string, ScalarStyle) => Yaml,
  anchors: AnchorTable,
}

fn newFlowCtx(
  s: Scanner,
  limits: YamlLimits,
  resolver: (string, ScalarStyle) => Yaml,
  anchors: AnchorTable,
): FlowCtx {
  return FlowCtx{ s: s, limits: limits, nodes: 0, resolver: resolver, anchors: anchors }
}

// This file's own error convention, matching scalar.bit's `scalarError`: a
// message plus the byte offset it happened at.
fn flowError(msg: string, offset: int): error {
  return newError("${msg} at byte ${offset}")
}

// Charges one more built `Yaml` node against `limits.maxTotalNodes`, failing
// once the running count exceeds it — checked on every call, so a wide
// collection is rejected as soon as its width crosses the budget rather than
// after every element has already been materialized.
fn chargeNode(ctx: FlowCtx, offset: int): ()! {
  ctx.nodes = ctx.nodes + 1
  if (ctx.nodes > ctx.limits.maxTotalNodes) {
    fail flowError("yaml: too many nodes: maxTotalNodes exceeded", offset)
  }
}

// Rejects the collection about to open at `depth` (its own nesting level,
// zero-based) once it would reach `limits.maxDepth` — an explicit counter,
// not Bit's call stack (this file's header).
fn checkDepth(ctx: FlowCtx, depth: i64, offset: int): ()! {
  if (depth >= ctx.limits.maxDepth) {
    fail flowError("yaml: nesting exceeds maxDepth", offset)
  }
}

// --- token stream: a comment is noise anywhere a flow token is expected --
//
// `parse.bit`'s own `skipComments`/block context runs this between every
// node it reads (that file's own comment: "the only noise token block
// context ever produces"); flow.bit never had the equivalent, so a `#`
// anywhere inside a flow collection — after an opening bracket, after a
// key, after a comma — left the scanner sitting on a `Comment` token no
// caller here knew to skip, surfacing as "expected a flow value" or
// "expected ',' or closing bracket" at the comment's own position.

// A `#` is only a real comment when whitespace (or the start of input)
// precedes it — `dispatchIndicatorsMarked` (scan.bit) does not enforce that
// itself, unconditionally emitting `Comment` for ANY `#` reached at a fresh
// dispatch (`isCommentAhead`'s own check only stops a scalar EARLY when a
// `#` is coming up, it is not re-checked once dispatch already lands on
// one) — so `c,#invalid` hands this file a `Comment` token exactly where a
// space-preceded one would sit. Skipping it regardless would silently
// accept trailing garbage the core grammar rejects (spec 6.9's own
// requirement, and the SAME already-tracked gap
// `corpusExclusionsTrailingContent` names for parse.bit/scan.bit — CVW2).
// Leaving it unskipped instead lets the normal "expected a flow value" /
// "expected ',' or closing bracket" checks reject it exactly as they did
// before this file understood comments at all.
fn isLegitFlowComment(ctx: FlowCtx): bool {
  let start = ctx.s.start
  if (start == 0) {
    return true
  }
  let p = ctx.s.src[start - 1]
  return p == ' ' || p == '\t' || p == '\n' || p == '\r'
}

fn skipFlowComments(ctx: FlowCtx) {
  let guard = 0
  let bound = flowLoopBound(ctx)
  while (ctx.s.kind == TokenKind.Comment && isLegitFlowComment(ctx) && guard <= bound) {
    scanNext(ctx.s)
    guard = guard + 1
  }
}

// `scanNext` plus a comment skip — the one place this file advances the
// scanner and expects to land on a real token afterward. `scanFlowPlainSpan`
// below deliberately calls raw `scanNext` instead: a comment there must stop
// a multi-line plain scalar's span, never be swallowed into it.
fn advanceFlow(ctx: FlowCtx) {
  scanNext(ctx.s)
  skipFlowComments(ctx)
}

// --- key equality, for duplicate-key detection --------------------------

// Structural equality between two `Yaml` values (`YamlEntry.key` is a full
// `Yaml`, not a `string` — value.bit's own header — so a non-scalar key
// like `[a,b]` needs real comparison, not a string match): the round-trip
// checks `encode.test.bit` runs, and `flowKeySame`'s own undecorated-key
// fallback below. Split one arm per function to keep `yamlEqual` itself
// under the complexity ceiling (E0204); mapping equality is by
// source-order entries, not as an unordered set.
fn yamlEqual(a: Yaml, b: Yaml): bool {
  match (yamlUndecorated(a)) {
    YamlNull => return yamlIsNull(b)
    YamlBool(x) => return yamlEqualBool(x, b)
    YamlInt(x) => return yamlEqualInt(x, b)
    YamlFloat(x) => return yamlEqualFloat(x, b)
    YamlString(x) => return yamlEqualString(x, b)
    YamlSequence(x) => return yamlEqualSequence(x, b)
    YamlMapping(x) => return yamlEqualMapping(x, b)
    YamlDecorated(_, _) => panic("yaml: internal: yamlUndecorated leaked a YamlDecorated")
  }
}

fn yamlEqualBool(x: bool, b: Yaml): bool {
  match (yamlAsBool(b)) {
    Some(y) => return x == y
    None => return false
  }
}

fn yamlEqualInt(x: i64, b: Yaml): bool {
  match (yamlAsInt(b)) {
    Some(y) => return x == y
    None => return false
  }
}

fn yamlEqualFloat(x: f64, b: Yaml): bool {
  match (yamlAsFloat(b)) {
    Some(y) => return x == y
    None => return false
  }
}

fn yamlEqualString(x: string, b: Yaml): bool {
  match (yamlAsString(b)) {
    Some(y) => return x == y
    None => return false
  }
}

fn yamlEqualItems(x: []Yaml, y: []Yaml): bool {
  if (len(x) != len(y)) {
    return false
  }
  let i = 0
  while (i < len(x)) {
    if (!yamlEqual(x[i], y[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

fn yamlEqualSequence(x: []Yaml, b: Yaml): bool {
  match (yamlAsSequence(b)) {
    None => return false
    Some(y) => return yamlEqualItems(x, y)
  }
}

fn yamlEqualEntries(x: []YamlEntry, y: []YamlEntry): bool {
  if (len(x) != len(y)) {
    return false
  }
  let i = 0
  while (i < len(x)) {
    if (!yamlEqual(x[i].key, y[i].key) || !yamlEqual(x[i].value, y[i].value)) {
      return false
    }
    i = i + 1
  }
  return true
}

fn yamlEqualMapping(x: []YamlEntry, b: Yaml): bool {
  match (yamlAsMapping(b)) {
    None => return false
    Some(y) => return yamlEqualEntries(x, y)
  }
}

// The `alias` name of `y`'s own decoration, or `None` when undecorated or
// decorated by an anchor/tag instead (mutually exclusive, value.bit's header).
fn flowKeyAliasName(y: Yaml): Option<string> {
  match (yamlDecorationOf(y)) {
    Some(d) => return d.alias
    None => return Option<string>.None
  }
}

// Whether `y` carries ANY anchor/tag/alias decoration at all.
fn flowKeyDecorated(y: Yaml): bool {
  return isSome(yamlDecorationOf(y))
}

// Whether `a` and `b` are the SAME mapping key, for duplicate-key detection
// only — `yamlEqual` itself stays pure structural comparison for the
// round-trip/encode checks that still need it. YAML 1.2.2 §3.2.1.1: keys
// are unique over NODES of the representation graph (§3.2.2, §7.1), not
// resolved content — an alias denotes the exact same node as its anchor, so
// two aliases naming one anchor are one key (`flowKeyAliasName` matching),
// while an anchor definition and any OTHER separately anchored node are
// distinct graph nodes even when structurally identical, never the same key
// by content alone. An undecorated key carries no identity beyond its
// content, so it still falls back to `yamlEqual` — the one thing #5548's
// alias-identity ruling changed underneath duplicate-key detection.
fn flowKeySame(a: Yaml, b: Yaml): bool {
  let aliasA = flowKeyAliasName(a)
  let aliasB = flowKeyAliasName(b)
  if (isSome(aliasA) && isSome(aliasB)) {
    return unwrap(aliasA) == unwrap(aliasB)
  }
  if (flowKeyDecorated(a) || flowKeyDecorated(b)) {
    return false
  }
  return yamlEqual(a, b)
}

fn flowKeyPresent(entries: []YamlEntry, key: Yaml): bool {
  let i = 0
  while (i < len(entries)) {
    if (flowKeySame(entries[i].key, key)) {
      return true
    }
    i = i + 1
  }
  return false
}

// --- one flow value, scalar or nested collection -------------------------

// The `ScalarStyle` a decoded flow scalar's own `TokenKind` maps to —
// Plain for `PlainScalar`, Quoted for either quote form. Mirrors
// `parse.bit`'s own `resolveByKind` exactly (this file's header): the two
// call sites must agree on the mapping, not just on calling a resolver at
// all.
fn resolveFlowScalar(text: string, kind: TokenKind, resolver: (string, ScalarStyle) => Yaml): Yaml {
  if (kind == TokenKind.PlainScalar) {
    return resolver(text, ScalarStyle.Plain)
  }
  return resolver(text, ScalarStyle.Quoted)
}

// `scanPlainScalar` (scan.bit) stops at every `\n`/`\r` unconditionally, so
// a plain scalar spanning a line break — legal in flow context exactly as
// in block, since flow ignores indentation as a signal either way (this
// file's header) — arrives as several consecutive `PlainScalar` tokens
// with nothing between them but the break: nothing else can produce that
// adjacency, since a comma, a colon followed by blank, a flow bracket or a
// comment each end their OWN token first (`scanPlainScalar`'s own boundary
// checks). Folds the same way `scalar.bit`'s `foldLines` already folds a
// block plain scalar — that function reads only the raw text it is handed,
// nothing about block vs. flow — so merging the spans and decoding once is
// the whole fix. Bounded by `flowLoopBound` like every other flow loop.
fn scanFlowPlainSpan(ctx: FlowCtx): int! {
  let end = ctx.s.end
  let guard = 0
  let bound = flowLoopBound(ctx)
  while (guard <= bound) {
    guard = guard + 1
    scanNext(ctx.s)
    if (ctx.s.kind != TokenKind.PlainScalar) {
      return end
    }
    end = ctx.s.end
  }
  fail flowError("yaml: unterminated flow plain scalar", end)
}

// Decodes, charges and resolves the span `[start, end)` of `kind` — the
// shared tail end of both an ordinary scalar token (`parseFlowScalar`) and
// a key-position scalar `parseFlowKeyScalar` has already re-spanned to
// exclude a trailing glued `:` (that function's own header).
fn finishFlowScalar(ctx: FlowCtx, kind: TokenKind, start: int, end: int): Yaml! {
  skipFlowComments(ctx)
  let text = yamlDecodeScalar(ctx.s.src, kind, start, end)?
  chargeNode(ctx, start)?
  return resolveFlowScalar(text, kind, ctx.resolver)
}

fn parseFlowScalar(ctx: FlowCtx): Yaml! {
  let start = ctx.s.start
  let kind = ctx.s.kind
  let end = ctx.s.end
  if (kind == TokenKind.PlainScalar) {
    end = scanFlowPlainSpan(ctx)?
  } else {
    scanNext(ctx.s)
  }
  return finishFlowScalar(ctx, kind, start, end)?
}

// A flow scalar's first byte reserves `-`/`?`/`:` for ambiguity with a
// block construct (YAML 1.2.2 §7.3.3's `ns-plain-first` exception list):
// each is a legal plain-scalar start only when NOT immediately followed by
// whatever would make it a real indicator instead — `isColonBoundary` and
// `followedByBlank` (scan.bit) already cover `:`/`?`, and a `-` followed by
// blank already becomes its own `SeqEntry` token, never reaching here. The
// one shape those rules let through is a BARE `-`, alone, directly abutting
// a flow indicator (`scanDash`'s fallback, scan.bit) — a one-byte
// `PlainScalar` this file cannot tell apart from the block sequence
// indicator it is reserved for, so the grammar rejects it instead.
fn isBareDashIndicator(ctx: FlowCtx): bool {
  return ctx.s.end - ctx.s.start == 1 && ctx.s.src[ctx.s.start] == '-'
}

// Any single flow value at the current token: a nested `[`/`{` collection
// (recursing at `depth + 1`) or a scalar. Anything else — the collection's
// own closer, a stray `,`, an `Invalid` token, `Eof` — is not a value; this
// is the one place that rejection fires, which is what actually rejects a
// doubled or leading comma (`flowAfterEntry` already accepted a true
// trailing comma before this function is ever reached again — this file's
// header).
// A scalar value at the current token — plain, single- or double-quoted —
// decorated with whatever properties `parseFlowNode` already consumed.
// Split out purely to keep that function's cyclomatic complexity under
// spec/LINT.md's ceiling.
fn parseFlowScalarValue(ctx: FlowCtx, props: PendingProps): Yaml! {
  if (isBareDashIndicator(ctx)) {
    fail flowError(
      "yaml: a bare '-' is reserved for the block sequence indicator, not a plain scalar",
      ctx.s.start,
    )
  }
  let scalar = parseFlowScalar(ctx)?
  return applyFlowAnchor(ctx, props, scalar)?
}

fn parseFlowNode(ctx: FlowCtx, depth: i64): Yaml! {
  let props = consumeFlowNodeProperties(ctx)
  if (ctx.s.kind == TokenKind.Alias) {
    if (isSome(props.anchor) || isSome(props.tag)) {
      fail flowError("yaml: an alias node cannot carry an anchor or tag property", ctx.s.start)
    }
    return parseFlowAlias(ctx)?
  }
  if (ctx.s.kind == TokenKind.FlowSeqStart || ctx.s.kind == TokenKind.FlowMapStart) {
    let collection = parseFlowCollection(ctx, depth + 1)?
    return applyFlowAnchor(ctx, props, collection)?
  }
  if (ctx.s.kind == TokenKind.PlainScalar) {
    return parseFlowScalarValue(ctx, props)?
  }
  if (ctx.s.kind == TokenKind.SingleQuoted || ctx.s.kind == TokenKind.DoubleQuoted) {
    let quoted = parseFlowScalar(ctx)?
    return applyFlowAnchor(ctx, props, quoted)?
  }
  if (isSome(props.tag)) {
    chargeNode(ctx, ctx.s.start)?
    return applyFlowAnchor(ctx, props, ctx.resolver("", ScalarStyle.Quoted))?
  }
  fail flowError("yaml: expected a flow value", ctx.s.start)
}

// The value half of a `key: value` entry, where the value may be omitted —
// `{a: }` is `{a: null}` exactly like `{a}` (ticket): a terminator token
// right after the `:` means "no value", not "parse whatever comes next".
fn parseFlowValueOrNull(ctx: FlowCtx, depth: i64): Yaml! {
  let k = ctx.s.kind
  if (k == TokenKind.FlowEntry || k == TokenKind.FlowSeqEnd || k == TokenKind.FlowMapEnd) {
    chargeNode(ctx, ctx.s.start)?
    return Yaml.YamlNull
  }
  return parseFlowNode(ctx, depth)?
}

// A key's value glued directly onto its `:` with no separating space —
// legal straight after a JSON-like key (a quoted scalar or a flow
// collection; YAML 1.2.2's JSON-compatible flow-mapping production needs no
// `s-separate` around that `:`). `isColonBoundary` (scan.bit) only turns
// `:` into its own `ValueIndicator` token when it IS followed by blank, so
// a glued `:value` instead scans as one `PlainScalar` token starting with
// `:` (`scanPlainScalar`'s own boundary check fires on THAT colon needing a
// following blank too, so it is folded into the very token it starts) —
// detected here, not in scan.bit, because interpreting what a leading `:`
// inside a raw span means is this file's grammar layer, not the scanner's
// (this file's header: the scanner only says where a span ends).
fn isGluedValueToken(ctx: FlowCtx): bool {
  return ctx.s.kind == TokenKind.PlainScalar &&
    ctx.s.end > ctx.s.start &&
    ctx.s.src[ctx.s.start] == ':'
}

// `scanPlainScalar` stops exactly AT the boundary that ends a token (a
// comma, a closer, a comment) without trimming back over any blank bytes
// that sat before it — this construct is the only place in this file that
// slices a token's span by hand (everywhere else hands the token's own
// `start`/`end` straight to `yamlDecodeScalar`), so it is the one place
// that dangling trailing blank needs stripping before decoding.
fn trimTrailingFlowBlank(ctx: FlowCtx, floor: int, end: int): int {
  let e = end
  while (e > floor && (ctx.s.src[e - 1] == ' ' || ctx.s.src[e - 1] == '\t')) {
    e = e - 1
  }
  return e
}

// Decodes a glued `:value` token's value half — everything past the one
// leading `:` the scanner folded in — exactly like `parseFlowScalar` decodes
// an ordinary `PlainScalar`, just shifted one byte past the indicator and
// trimmed of any trailing blank `trimTrailingFlowBlank` left dangling.
fn parseGluedFlowValue(ctx: FlowCtx): Yaml! {
  let start = ctx.s.start
  let end = trimTrailingFlowBlank(ctx, start + 1, ctx.s.end)
  let text = yamlDecodeScalar(ctx.s.src, TokenKind.PlainScalar, start + 1, end)?
  advanceFlow(ctx)
  chargeNode(ctx, start)?
  return ctx.resolver(text, ScalarStyle.Plain)
}

// Whether a value follows the key/entry just parsed — a real `ValueIndicator`
// token, or a glued `:value` `PlainScalar` (`isGluedValueToken`'s own
// comment) — shared by both `parseFlowSeqEntry` and `parseFlowMapEntry` so
// neither special-cases the glued spelling on its own.
fn flowHasValueIndicator(ctx: FlowCtx): bool {
  return ctx.s.kind == TokenKind.ValueIndicator || isGluedValueToken(ctx)
}

// Consumes whichever shape `flowHasValueIndicator` found true and returns
// the value — callers must not call this unless that check already passed.
fn consumeFlowValue(ctx: FlowCtx, depth: i64): Yaml! {
  if (ctx.s.kind == TokenKind.ValueIndicator) {
    advanceFlow(ctx)
    return parseFlowValueOrNull(ctx, depth)?
  }
  return parseGluedFlowValue(ctx)?
}

// --- implicit/omitted keys ---------------------------------------------

// The entry's own KEY position starts with a real `ValueIndicator` — a `:`
// the scanner already confirmed is followed by blank (`isColonBoundary`,
// scan.bit) — meaning the key itself is empty (`e-node`, YAML 1.2.2's own
// name for an omitted node): `[: x]`/`{: x}`'s leading `:` and `{a, : x}`'s
// second entry are this shape. Deliberately NOT `isGluedValueToken` too: a
// PlainScalar that merely starts with `:` and is glued straight to
// non-blank content (`::vector`, `HM87/00`'s `[:x]`) is ordinary scalar
// content, not an omitted key — `isGluedValueToken` only means "omitted
// key" once a key has already been read and this token sits in VALUE
// position (`flowHasValueIndicator`'s own use of it); at entry START, where
// no key has been read yet, it cannot tell the two shapes apart, so this
// function does not use it. Shared by both `parseFlowSeqEntry` and
// `parseFlowMapEntry` so neither special-cases the omitted-key spelling on
// its own.
fn startsImplicitFlowKey(ctx: FlowCtx): bool {
  return ctx.s.kind == TokenKind.ValueIndicator
}

// The token right after a bare `?` is already this entry's own terminator
// (a `,` or `closeKind`, the collection's own closer) — the explicit key
// itself is empty, with no node to parse at all, exactly as
// `parseFlowValueOrNull`'s own bare-terminator check means an omitted
// VALUE. `{ ? \n }`'s trailing `?` is this shape.
fn flowExplicitKeyOmitted(ctx: FlowCtx, closeKind: TokenKind): bool {
  return ctx.s.kind == TokenKind.FlowEntry || ctx.s.kind == closeKind
}

// The result of `parseFlowKeyScalar`: the key itself, plus whether its own
// trailing glued `:` already supplied (and consumed) an implicit null
// value, so the caller must not look for a second value indicator.
class FlowKeyOut { key: Yaml, valueOmitted: bool }

// The node in KEY position of one entry: identical to `parseFlowNode`
// except a bare PLAIN scalar ending in a `:` glued directly to the flow
// terminator that follows it (`omitted value:,`, `? foo :,` — no
// separating blank, the mirror image of `isGluedValueToken`'s LEADING
// glued `:`) is split here instead of folded whole into the key's own
// text: `scanPlainScalar` (scan.bit) only stops AT a `:` that is itself
// followed by blank, so a `:` glued to what comes after it never breaks
// the span, and keeps consuming until the next real stopper — a `PlainScalar`
// token ending in `:` can therefore only arise this way (this file's own
// PLAIN SCALAR TERMINATION header). A tag/anchor-prefixed key or a
// non-plain key (quoted, a flow collection) is untouched: those go through
// `parseFlowNode` exactly as before.
fn parseFlowKeyScalar(ctx: FlowCtx, depth: i64): FlowKeyOut! {
  if (ctx.s.kind != TokenKind.PlainScalar) {
    return FlowKeyOut{ key: parseFlowNode(ctx, depth)?, valueOmitted: false }
  }
  let start = ctx.s.start
  let end = scanFlowPlainSpan(ctx)?
  if (end > start && ctx.s.src[end - 1] == ':') {
    let trimmed = trimTrailingFlowBlank(ctx, start, end - 1)
    return FlowKeyOut{
      key: finishFlowScalar(ctx, TokenKind.PlainScalar, start, trimmed)?,
      valueOmitted: true,
    }
  }
  return FlowKeyOut{
    key: finishFlowScalar(ctx, TokenKind.PlainScalar, start, end)?,
    valueOmitted: false,
  }
}

// A JSON-like key (a quoted scalar or a flow collection — the two node
// kinds YAML 1.2.2's `ns-flow-pair-json-key-entry` names) directly, with
// ZERO gap, abutted by a glued `:value` (`isGluedValueToken`): legal in a
// flow SEQUENCE's own compact-pair position exactly when nothing at all —
// not even a line break — separates the key from its `:`.
// `ctx.s.src[ctx.s.start - 1]` is the one byte right before the glued
// colon token, so it names the key's own closing byte when truly adjacent,
// a blank or line break otherwise: `{JSON: like}:adjacent` (9MMW) is
// legal, `"key"\n  :value` (ZXT5, this file's own canary) stays rejected —
// a blank byte never matches any of the four closers below.
fn isJsonKeyGluedValue(ctx: FlowCtx): bool {
  if (!isGluedValueToken(ctx) || ctx.s.start == 0) {
    return false
  }
  let before = ctx.s.src[ctx.s.start - 1]
  return before == '"' || before == '\'' || before == ']' || before == '}'
}

// --- shared close/comma handling ------------------------------------------

// After one entry: `closeKind` alone closes the collection. A `,` is
// consumed either way; if `closeKind` immediately follows, that `,` was a
// legal trailing comma and the collection closes right here — otherwise the
// loop continues to the next entry, and `parseFlowNode` is what rejects a
// `,` followed by another `,` (or by nothing parseable at all) as an empty
// node entry (this file's header). Anything else after an entry, with no
// `,` at all, is a syntax error.
fn flowAfterEntry(ctx: FlowCtx, closeKind: TokenKind): bool! {
  if (ctx.s.kind == closeKind) {
    advanceFlow(ctx)
    return true
  }
  if (ctx.s.kind == TokenKind.FlowEntry) {
    advanceFlow(ctx)
    if (ctx.s.kind == closeKind) {
      advanceFlow(ctx)
      return true
    }
    return false
  }
  fail flowError("yaml: expected ',' or closing bracket in flow collection", ctx.s.start)
}

// A loop bound on entry count: every iteration of a flow sequence/mapping
// loop consumes at least one source byte (flow context never emits a
// zero-width token — Indent/Dedent are suppressed whenever flowDepth > 0,
// scan.bit's own header), so remaining source bytes is a generous, provable
// ceiling on remaining iterations.
fn flowLoopBound(ctx: FlowCtx): int {
  return ctx.s.srcLen + 4
}

// --- flow sequence ---------------------------------------------------------

// One `[...]` entry: a bare flow value, an implicit-empty-key pair
// (`startsImplicitFlowKey` — `[: x]`), or a `key: value` / `? key [: value]`
// pair, which becomes a single-entry `YamlMapping` (`[a: 1]` is a sequence
// holding one mapping — ticket). `?` is legal here exactly as in a flow
// mapping entry; sharing the same shape is why `parseFlowMapEntry` (below)
// and this function both start with the same explicit-key check. A glued
// `key:value` spelling is accepted here ONLY when `key` is JSON-like
// (quoted or a flow collection) AND truly adjacent to its `:`
// (`isJsonKeyGluedValue`) — `{JSON: like}:adjacent` (9MMW). A PLAIN-scalar
// key never reaches that branch: `scanPlainScalar` (scan.bit) folds a
// glued `:` straight into the plain scalar's own span, so it is never a
// separate token here. A JSON-like key with real separating whitespace
// before its `:` stays rejected (ZXT5, this file's own canary) — that is
// exactly what `isJsonKeyGluedValue`'s adjacency byte-check enforces.
fn parseFlowSeqEntry(ctx: FlowCtx, depth: i64): Yaml! {
  let entryStart = ctx.s.start
  let explicit = ctx.s.kind == TokenKind.KeyIndicator
  if (explicit) {
    advanceFlow(ctx)
  }
  if (!explicit && startsImplicitFlowKey(ctx)) {
    let value = consumeFlowValue(ctx, depth)?
    chargeNode(ctx, entryStart)?
    return Yaml.YamlMapping([YamlEntry{ key: Yaml.YamlNull, value: value }])
  }
  let first = parseFlowNode(ctx, depth)?
  if (ctx.s.kind == TokenKind.ValueIndicator) {
    let value = consumeFlowValue(ctx, depth)?
    chargeNode(ctx, entryStart)?
    return Yaml.YamlMapping([YamlEntry{ key: first, value: value }])
  }
  if (isJsonKeyGluedValue(ctx)) {
    let value = parseGluedFlowValue(ctx)?
    chargeNode(ctx, entryStart)?
    return Yaml.YamlMapping([YamlEntry{ key: first, value: value }])
  }
  if (explicit) {
    chargeNode(ctx, entryStart)?
    return Yaml.YamlMapping([YamlEntry{ key: first, value: Yaml.YamlNull }])
  }
  return first
}

fn parseFlowSeq(ctx: FlowCtx, depth: i64): Yaml! {
  let start = ctx.s.start
  advanceFlow(ctx)
  if (ctx.s.kind == TokenKind.FlowSeqEnd) {
    advanceFlow(ctx)
    chargeNode(ctx, start)?
    return Yaml.YamlSequence([]Yaml(0))
  }
  let items = []Yaml(0)
  let guard = 0
  let bound = flowLoopBound(ctx)
  while (guard <= bound) {
    guard = guard + 1
    let item = parseFlowSeqEntry(ctx, depth)?
    items = append(items, item)
    let closed = flowAfterEntry(ctx, TokenKind.FlowSeqEnd)?
    if (closed) {
      chargeNode(ctx, start)?
      return Yaml.YamlSequence(items)
    }
  }
  fail flowError("yaml: unterminated flow sequence", start)
}

// --- flow mapping ------------------------------------------------------

// The result of parsing one `{...}` entry: the entry itself, plus the byte
// offset its key started at — needed for the duplicate-key error, which
// must name the REPEATED key's own position, not the mapping's.
class FlowMapEntryOut { entry: YamlEntry, keyStart: int }

// One `{...}` entry: `? key [: value]` or `key [: value]`, where a missing
// `:` means an implicit null value (`{a}` is `{a: null}` — ticket) rather
// than the bare-node-only shape a flow sequence entry allows. `key` itself
// may be empty too — a bare `:` (`startsImplicitFlowKey`, `{: x}`) or a
// bare `?` with nothing after it (`flowExplicitKeyOmitted`, `{?, a: b}`) —
// and a PLAIN key ending in a `:` glued to its own trailing terminator
// (`parseFlowKeyScalar`, `{omitted value:,}`) already supplies the value
// itself, so the ordinary `flowHasValueIndicator` check below must be
// skipped for that shape.
fn parseFlowMapEntry(ctx: FlowCtx, depth: i64): FlowMapEntryOut! {
  let keyStart = ctx.s.start
  let explicit = ctx.s.kind == TokenKind.KeyIndicator
  if (explicit) {
    advanceFlow(ctx)
  }
  if (!explicit && startsImplicitFlowKey(ctx)) {
    let value = consumeFlowValue(ctx, depth)?
    chargeNode(ctx, keyStart)?
    return FlowMapEntryOut{
      entry: YamlEntry{ key: Yaml.YamlNull, value: value },
      keyStart: keyStart,
    }
  }
  if (explicit && flowExplicitKeyOmitted(ctx, TokenKind.FlowMapEnd)) {
    chargeNode(ctx, keyStart)?
    return FlowMapEntryOut{
      entry: YamlEntry{ key: Yaml.YamlNull, value: Yaml.YamlNull },
      keyStart: keyStart,
    }
  }
  let keyResult = parseFlowKeyScalar(ctx, depth)?
  let key = keyResult.key
  let value = Yaml.YamlNull
  if (keyResult.valueOmitted) {
    chargeNode(ctx, keyStart)?
  } else if (flowHasValueIndicator(ctx)) {
    value = consumeFlowValue(ctx, depth)?
  } else {
    chargeNode(ctx, keyStart)?
  }
  return FlowMapEntryOut{ entry: YamlEntry{ key: key, value: value }, keyStart: keyStart }
}

fn parseFlowMap(ctx: FlowCtx, depth: i64): Yaml! {
  let start = ctx.s.start
  advanceFlow(ctx)
  if (ctx.s.kind == TokenKind.FlowMapEnd) {
    advanceFlow(ctx)
    chargeNode(ctx, start)?
    return Yaml.YamlMapping([]YamlEntry(0))
  }
  let entries = []YamlEntry(0)
  let guard = 0
  let bound = flowLoopBound(ctx)
  while (guard <= bound) {
    guard = guard + 1
    let out = parseFlowMapEntry(ctx, depth)?
    if (flowKeyPresent(entries, out.entry.key)) {
      fail flowError("yaml: duplicate key in flow mapping", out.keyStart)
    }
    entries = append(entries, out.entry)
    let closed = flowAfterEntry(ctx, TokenKind.FlowMapEnd)?
    if (closed) {
      chargeNode(ctx, start)?
      return Yaml.YamlMapping(entries)
    }
  }
  fail flowError("yaml: unterminated flow mapping", start)
}

// --- entry point -----------------------------------------------------

fn parseFlowCollection(ctx: FlowCtx, depth: i64): Yaml! {
  checkDepth(ctx, depth, ctx.s.start)?
  if (ctx.s.kind == TokenKind.FlowSeqStart) {
    return parseFlowSeq(ctx, depth)?
  }
  if (ctx.s.kind == TokenKind.FlowMapStart) {
    return parseFlowMap(ctx, depth)?
  }
  fail flowError("yaml: not a flow collection", ctx.s.start)
}

// Parses one flow sequence or flow mapping starting at `s`'s CURRENT token
// (`FlowSeqStart` or `FlowMapStart`, already produced by the caller's own
// `scanNext` — the same "peeked, not yet consumed" convention
// `stdlib/json/parse.bit`'s `parseObject`/`parseArray` use), leaving `s`
// positioned on the token right after the collection's closing bracket.
// `depth` is the nesting level this collection itself opens at (0 for a
// flow collection reached directly from a document's top level); `limits`
// is read for both `maxDepth` and `maxTotalNodes`, never a second budget.
// `resolver` is the caller's own scalar resolver (`YamlOptions.resolver` in
// `parse.bit`, `yamlResolveScalar` by default) — this file never defaults
// it independently, so a caller who opted into `yamlResolveRaw` gets raw
// values here exactly as it does in block context (this file's header).
fn yamlParseFlow(
  s: Scanner,
  limits: YamlLimits,
  depth: i64,
  resolver: (string, ScalarStyle) => Yaml,
  anchors: AnchorTable,
): Yaml! {
  let ctx = newFlowCtx(s, limits, resolver, anchors)
  return parseFlowCollection(ctx, depth)?
}
