// pkg/yaml/anchor.test.bit — anchor.bit's budget enforcement, beside the
// file it tests (pkg/README.md's layout rule). `contains` is already
// imported into this module by scan.test.bit; importing it again here
// would be E0042 (pkg/README.md's flat namespace, scalar.bit's own header
// makes the same call).

import { monotonic, since, Second } from "std/time"

fn mustDefine(t: AnchorTable, name: string, node: Yaml) {
  yamlAnchorDefine(t, name, node) catch e {
    panic(e.message())
  }
}

test "yamlAnchorResolve refuses an alias to an undefined anchor" {
  let t = newAnchorTable()
  let failed = false
  yamlAnchorResolve(t, "missing", yamlDefaultLimits()) catch e {
    failed = true
    assert(contains(e.message(), "undefined anchor"), e.message())
    return
  }
  assert(failed, "an alias to a name never defined must be refused")
}

// `&a [*a]` reduces, at this table's own boundary, to exactly this: nothing
// can call `yamlAnchorDefine(t, "a", ...)` until the sequence literal it is
// defining has finished building, and building it requires resolving `*a`
// first — so the resolve this test drives is the SAME resolve a real
// parser would drive while still constructing `a`'s own value, before `a`
// exists in the table. See anchor.bit's header for why this is not a
// separate code path from "undefined".
test "a self-referential anchor (&a [*a]) is refused, not followed" {
  let t = newAnchorTable()
  let failed = false
  yamlAnchorResolve(t, "a", yamlDefaultLimits()) catch e {
    failed = true
    assert(contains(e.message(), "undefined anchor"), e.message())
    return
  }
  assert(failed, "a recursive anchor must never resolve, not even to itself")
}

test "a later redefinition of an anchor name wins over the earlier one" {
  let t = newAnchorTable()
  mustDefine(t, "a", Yaml.YamlInt(1))
  mustDefine(t, "a", Yaml.YamlInt(2))
  let got = yamlAnchorResolve(t, "a", yamlDefaultLimits()) catch e {
    panic(e.message())
  }
  assert(unwrapInt(got) == 2, "an alias must take the most recent definition")
}

fn unwrapInt(y: Yaml): i64 {
  match (y) {
    YamlInt(i) => return i
    _ => panic("expected a YamlInt")
  }
}

// A budget small enough that exactly one field is the binding constraint;
// the other two stay at their generous defaults so a failure here cannot
// be mistaken for one of them — mirrors scan.test.bit's own
// `tinyByteLimits` isolation of a single field under test.
fn oneTinyLimit(maxDepth: i64, maxAliasExpansions: i64, maxTotalNodes: i64): YamlLimits {
  return YamlLimits{
    maxDepth: maxDepth,
    maxAliasExpansions: maxAliasExpansions,
    maxTotalNodes: maxTotalNodes,
    maxDocumentBytes: yamlDefaultLimits().maxDocumentBytes,
  }
}

test "resolving past maxAliasExpansions is refused, naming only that limit" {
  let t = newAnchorTable()
  mustDefine(t, "a", Yaml.YamlInt(1))
  let limits = oneTinyLimit(
    yamlDefaultLimits().maxDepth,
    2,
    yamlDefaultLimits().maxTotalNodes,
  )
  yamlAnchorResolve(t, "a", limits) catch e {
    panic(e.message())
  }
  yamlAnchorResolve(t, "a", limits) catch e {
    panic(e.message())
  }
  let failed = false
  yamlAnchorResolve(t, "a", limits) catch e {
    failed = true
    let msg = e.message()
    assert(contains(msg, "maxAliasExpansions"), msg)
    assert(!contains(msg, "maxTotalNodes"), msg)
    assert(!contains(msg, "maxDepth"), msg)
    return
  }
  assert(failed, "the third resolve must exceed maxAliasExpansions of 2")
}

test "resolving a subtree past maxTotalNodes is refused, naming only that limit" {
  let t = newAnchorTable()
  let items: []Yaml = [
    Yaml.YamlInt(1),
    Yaml.YamlInt(2),
    Yaml.YamlInt(3),
    Yaml.YamlInt(4),
    Yaml.YamlInt(5),
    Yaml.YamlInt(6),
    Yaml.YamlInt(7),
    Yaml.YamlInt(8),
    Yaml.YamlInt(9),
    Yaml.YamlInt(10),
  ]
  mustDefine(t, "a", Yaml.YamlSequence(items))
  let limits = oneTinyLimit(
    yamlDefaultLimits().maxDepth,
    yamlDefaultLimits().maxAliasExpansions,
    5,
  )
  let failed = false
  yamlAnchorResolve(t, "a", limits) catch e {
    failed = true
    let msg = e.message()
    assert(contains(msg, "maxTotalNodes"), msg)
    assert(!contains(msg, "maxAliasExpansions"), msg)
    assert(!contains(msg, "maxDepth"), msg)
    return
  }
  assert(failed, "an 11-node subtree (the sequence plus its 10 elements) must exceed a budget of 5")
}

test "resolving a subtree past maxDepth is refused, naming only that limit" {
  let t = newAnchorTable()
  let nested = Yaml.YamlSequence(
    [
      Yaml.YamlSequence([Yaml.YamlSequence([Yaml.YamlInt(1)])]),
    ],
  )
  mustDefine(t, "a", nested)
  let limits = oneTinyLimit(
    2,
    yamlDefaultLimits().maxAliasExpansions,
    yamlDefaultLimits().maxTotalNodes,
  )
  let failed = false
  yamlAnchorResolve(t, "a", limits) catch e {
    failed = true
    let msg = e.message()
    assert(contains(msg, "maxDepth"), msg)
    assert(!contains(msg, "maxTotalNodes"), msg)
    assert(!contains(msg, "maxAliasExpansions"), msg)
    return
  }
  assert(failed, "4 levels of nesting must exceed a maxDepth of 2")
}

// Builds one more level of the chain: a 9-element sequence, each element
// resolved fresh from the anchor one level down. Propagates a budget
// failure straight to the caller via `?` rather than swallowing it — that
// failure IS the property this test proves.
fn buildLevel(t: AnchorTable, prevName: string, limits: YamlLimits): Yaml! {
  let items = []Yaml(0)
  let i = 0
  while (i < 9) {
    let v = yamlAnchorResolve(t, prevName, limits)?
    items = append(items, v)
    i = i + 1
  }
  return Yaml.YamlSequence(items)
}

// THE BOMB. Level 1 is 9 plain leaves. Every level after it is 9 aliases to
// the level below, so an unbounded engine would reach 9^9 =
// 387,420,489 materialized nodes by level 9 (this file's own header does
// the arithmetic per level) — from a document this test builds in a
// microsecond and that `yamlDefaultLimits().maxTotalNodes` (1,000,000)
// makes impossible to ever finish materializing. THIS is the assertion the
// ticket is about: not that an error comes back, but that it comes back
// fast, and specifically because `maxTotalNodes` — not `maxAliasExpansions`
// — caught it; `maxAliasExpansions` alone would never fire here (72 total
// resolutions across all 9 levels, far under its 100,000 default), which is
// exactly why counting resolutions is not sufficient on its own.
test "a 9-level, 9-ary alias chain is refused in bounded time, by maxTotalNodes" {
  let t = newAnchorTable()
  let limits = yamlDefaultLimits()
  mustDefine(
    t,
    "L1",
    Yaml.YamlSequence(
      [
        Yaml.YamlString("x"),
        Yaml.YamlString("x"),
        Yaml.YamlString("x"),
        Yaml.YamlString("x"),
        Yaml.YamlString("x"),
        Yaml.YamlString("x"),
        Yaml.YamlString("x"),
        Yaml.YamlString("x"),
        Yaml.YamlString("x"),
      ],
    ),
  )

  let start = monotonic()
  let refused = false
  let refusalMsg = ""
  let prevName = "L1"
  let level = 2
  while (level <= 9) {
    let name = "L${level}"
    let value = buildLevel(t, prevName, limits) catch e {
      refused = true
      refusalMsg = e.message()
      break
    }
    mustDefine(t, name, value)
    prevName = name
    level = level + 1
  }
  let elapsedNs = since(start)

  assert(refused, "a 9-level 9-ary alias chain must be refused before it fully expands")
  assert(
    level < 9,
    "must be refused strictly before completing level 9, stopped at level ${level}",
  )
  assert(contains(refusalMsg, "maxTotalNodes"), refusalMsg)
  assert(
    elapsedNs < Second,
    "must be refused in well under 1 second, took ${elapsedNs}ns",
  )
  // The budget itself is the memory bound: `yamlAnchorResolve` never lets
  // `t.totalNodes` exceed `limits.maxTotalNodes` (1,000,000) before
  // refusing, and never deep-copies a resolved value (this file's header),
  // so the actual heap cost of every `Yaml` node this table ever charged
  // for is bounded by that many small, fixed-shape class allocations — on
  // the order of tens of bytes each, so `maxTotalNodes`'s own 1,000,000
  // ceiling (`value.bit`'s comment on the field) is sized to stay under the
  // 100 MB this ticket names, not a second, independently-chosen number.
  assert(
    t.totalNodes <= limits.maxTotalNodes,
    "the running node budget must never be allowed past its own ceiling",
  )
}

// YAML 1.2.2 SS3.2.2: an alias refers to the SAME node its anchor names, not
// an equal one. `yamlAnchorResolve`'s own header already claims this ("never
// deep-copies... hands back the same object") — this test is the proof:
// mutating the resolved alias's own backing array through one view must be
// observable through the ORIGINAL slice, which a merely-equal COPY could
// never produce. The independent control sequence shows the assertion is
// really testing sharing, not some accidental global mutation.
test "an alias shares its anchor's own sequence identity, not merely equal value (YAML 1.2.2 SS3.2.2)" {
  let t = newAnchorTable()
  let original: []Yaml = [Yaml.YamlInt(1), Yaml.YamlInt(2)]
  mustDefine(t, "a", Yaml.YamlSequence(original))
  let resolved = yamlAnchorResolve(t, "a", yamlDefaultLimits()) catch e {
    panic(e.message())
  }
  let resolvedItems = unwrap(yamlAsSequence(resolved))
  resolvedItems[0] = Yaml.YamlInt(999)
  assert(
    unwrapInt(original[0]) == 999,
    "an alias must share its anchor's own backing storage, not a copy of it",
  )

  let independent: []Yaml = [Yaml.YamlInt(1), Yaml.YamlInt(2)]
  assert(
    unwrapInt(independent[0]) == 1,
    "an independently-built, merely-equal sequence must not be affected — the control this test's own sharing assertion needs",
  )
}
