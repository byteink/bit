// pkg/yaml/mapkeys.bit — yaml module, duplicate-key detection for one
// mapping under construction (#6059, epic #1482). `parseBlockMapping`
// (blockmapping.bit) and `parseFlowMap` (flow.bit) each keep one `MapKeys`
// per mapping and ask `mapKeysInsert` about every key before appending it.
//
// WHICH KEYS ARE THE SAME KEY. YAML 1.2.2 §3.2.1.1: keys are unique over
// NODES of the representation graph (§3.2.2, §7.1), not resolved content.
// An alias denotes the exact node its anchor defined, so two aliases naming
// one anchor are one key (#5557), while an anchored or tagged node is its own
// graph node: never the same key as any other, even a structurally identical
// one. An undecorated key carries no identity beyond its content, so two
// undecorated keys are the same key exactly when `yamlEqual` (flow.bit) says
// so — and `yamlEqual` never equates two different `Yaml` arms, so keys of
// different arms never collide either.
//
// AMORTIZED O(1) PER KEY. Comparing every new key against every earlier one
// made a mapping of N keys cost O(N²), and a document of one wide mapping
// stayed inside every `YamlLimits` budget while costing minutes. So the
// classes above are kept apart and every one is hashed: undecorated strings,
// ints and floats by value, aliases by anchor name, and every other
// undecorated key (null, bool, sequence, mapping) by `keyEncode`'s encoding
// below. Each map is allocated only when its class first needs one, so a
// mapping of string keys pays for one map at most.
//
// OTHER KEYS ARE ENCODED, NOT COMPARED (#6346). A null, bool, sequence or
// mapping key is written as bytes that two keys share exactly when
// `yamlEqual` calls them equal, and those bytes are the map key. Every node
// is a tag byte and a LEB128 word (a bool's 0 or 1, an int's bits, a
// float's `floatKeyBits`, a collection's length, a string's length followed
// by its bytes or, past `keyInlineMax`, its id in `ids`), then a
// collection's children in order: the encoding is prefix-free, so it reads
// back as exactly one structure. Decorations are read through at every
// level, as `yamlEqual` reads them. A NaN anywhere makes a key equal to no
// key, itself included, so such a key is accepted and never stored. A long
// string enters by id, not by its bytes, because an alias repeats a node
// without repeating its text: a key of 100,000 aliases to one long string
// would otherwise hold 100,000 copies of it. Exact bytes, not a 64-bit hash
// confirmed by `yamlEqual`: a document chooses its own ints, and an unkeyed
// hash can be steered to put every key in one bucket, which is the O(N²)
// scan again. The only hash here is the runtime map's, the one every plain
// string key already goes through.
//
// SMALL MAPPINGS ARE SCANNED, NOT HASHED. Nearly every real mapping has a
// handful of string keys, where building a map and hashing each key costs
// more than comparing it against its few predecessors. So string keys are
// compared directly against the caller's `entries` — which holds exactly
// the keys accepted so far — until the mapping reaches `mapKeysScanMax`
// entries, and only then loaded into `strs` once.

const mapKeysScanMax: i64 = 8

class MapKeys {
  strs: map<string, bool>,
  ints: map<i64, bool>,
  floats: map<u64, bool>,
  aliases: map<string, bool>,
  others: map<string, bool>,
  ids: map<string, i64>,
  enc: []byte,
}

fn newMapKeys(): MapKeys {
  return MapKeys{
    strs = nil,
    ints = nil,
    floats = nil,
    aliases = nil,
    others = nil,
    ids = nil,
    enc = []byte(0),
  }
}

// Records `key` in `ks`, returning false when an earlier key of the same
// mapping is the same key (this file's header) — the caller's duplicate.
// `entries` is every key accepted so far, in which the caller appends `key`
// once this returns true.
fn mapKeysInsert(ks: MapKeys, entries: []YamlEntry, key: Yaml): bool {
  match (key) {
    YamlString(s) => return mapKeysString(ks, entries, s)
    YamlInt(i) => return mapKeysInt(ks, i)
    YamlFloat(f) => return mapKeysFloat(ks, f)
    YamlDecorated(d, _) => return mapKeysAlias(ks, d.alias)
    _ => return mapKeysOther(ks, key)
  }
}

fn mapKeysString(ks: MapKeys, entries: []YamlEntry, s: string): bool {
  if (ks.strs == nil) {
    if (len(entries) < mapKeysScanMax) {
      return !stringKeyIn(entries, s)
    }
    ks.strs = stringKeysOf(entries)
  }
  if (ks.strs[s]) {
    return false
  }
  ks.strs[s] = true
  return true
}

fn stringKeyIn(entries: []YamlEntry, s: string): bool {
  let i = 0
  while (i < len(entries)) {
    match (entries[i].key) {
      YamlString(k) => {
        if (k == s) {
          return true
        }
      }
      _ => {}
    }
    i = i + 1
  }
  return false
}

fn stringKeysOf(entries: []YamlEntry): map<string, bool> {
  let m = map<string, bool>(len(entries) * 2)
  for e of entries {
    match (e.key) {
      YamlString(k) => m[k] = true
      _ => {}
    }
  }
  return m
}

fn mapKeysInt(ks: MapKeys, i: i64): bool {
  if (ks.ints[i]) {
    return false
  }
  if (ks.ints == nil) {
    ks.ints = map<i64, bool>()
  }
  ks.ints[i] = true
  return true
}

// `yamlEqual` compares floats with `==`: a NaN equals no key, itself
// included, and `-0.0` equals `0.0`. Every other pair of doubles is `==`
// exactly when their bits are equal, so the bits are the hash key.
fn mapKeysFloat(ks: MapKeys, f: f64): bool {
  if (f != f) {
    return true
  }
  let bits = floatKeyBits(f)
  if (ks.floats[bits]) {
    return false
  }
  if (ks.floats == nil) {
    ks.floats = map<u64, bool>()
  }
  ks.floats[bits] = true
  return true
}

// A decorated key is an alias (`alias` set) or an anchored/tagged node
// (`alias` unset — value.bit's header makes the two exclusive). Only an
// alias can be the same key as another, and only as an alias of the same
// anchor; an anchored or tagged node is never recorded, because nothing
// can ever match it.
fn mapKeysAlias(ks: MapKeys, alias: Option<string>): bool {
  match (alias) {
    None => return true
    Some(name) => {
      if (ks.aliases[name]) {
        return false
      }
      if (ks.aliases == nil) {
        ks.aliases = map<string, bool>()
      }
      ks.aliases[name] = true
      return true
    }
  }
}

// The bits of a non-NaN `f` that `==` agrees with: `-0.0` folds onto `0.0`.
fn floatKeyBits(f: f64): u64 {
  return f == 0.0 ? u64(0) : floatBits(f)
}

fn mapKeysOther(ks: MapKeys, key: Yaml): bool {
  if (cap(ks.enc) == 0) {
    ks.enc = []byte(0, 64)
  }
  ks.enc = ks.enc[0:0]
  if (!keyEncode(ks, key)) {
    return true
  }
  let enc = string(ks.enc)
  if (ks.others[enc]) {
    return false
  }
  if (ks.others == nil) {
    ks.others = map<string, bool>()
  }
  ks.others[enc] = true
  return true
}

// `keyEncode`'s tag bytes, one per undecorated `Yaml` arm.
const keyTagNull: u8 = 0
const keyTagBool: u8 = 1
const keyTagInt: u8 = 2
const keyTagFloat: u8 = 3
const keyTagString: u8 = 4
const keyTagStringId: u8 = 5
const keyTagSequence: u8 = 6
const keyTagMapping: u8 = 7

// The longest string `keyEncodeString` writes out rather than naming by id.
const keyInlineMax: i64 = 32

// Appends `y`'s encoding (this file's header) to `ks.enc`. False when `y`
// holds a NaN, which makes it equal to no key; `ks.enc` is then partial.
fn keyEncode(ks: MapKeys, y: Yaml): bool {
  match (yamlUndecorated(y)) {
    YamlNull => keyWord(ks, keyTagNull, 0)
    YamlBool(b) => keyWord(ks, keyTagBool, b ? u64(1) : u64(0))
    YamlInt(i) => keyWord(ks, keyTagInt, u64(i))
    YamlFloat(f) => return keyEncodeFloat(ks, f)
    YamlString(s) => keyEncodeString(ks, s)
    YamlSequence(items) => return keyEncodeItems(ks, items)
    YamlMapping(entries) => return keyEncodeEntries(ks, entries)
    YamlDecorated(_, _) => panic("yaml: internal: yamlUndecorated leaked a YamlDecorated")
  }
  return true
}

fn keyEncodeFloat(ks: MapKeys, f: f64): bool {
  if (f != f) {
    return false
  }
  keyWord(ks, keyTagFloat, floatKeyBits(f))
  return true
}

fn keyEncodeItems(ks: MapKeys, items: []Yaml): bool {
  keyWord(ks, keyTagSequence, u64(len(items)))
  for it of items {
    if (!keyEncode(ks, it)) {
      return false
    }
  }
  return true
}

fn keyEncodeEntries(ks: MapKeys, entries: []YamlEntry): bool {
  keyWord(ks, keyTagMapping, u64(len(entries)))
  for e of entries {
    if (!keyEncode(ks, e.key) || !keyEncode(ks, e.value)) {
      return false
    }
  }
  return true
}

fn keyEncodeString(ks: MapKeys, s: string) {
  if (len(s) > keyInlineMax) {
    keyWord(ks, keyTagStringId, keyStringId(ks, s))
    return
  }
  keyWord(ks, keyTagString, u64(len(s)))
  ks.enc = append(ks.enc, s)
}

// `s`'s id: the number of distinct strings this mapping's other keys had
// already named when `s` first appeared, so equal strings share one id.
fn keyStringId(ks: MapKeys, s: string): u64 {
  let (id, found) = ks.ids[s]
  if (found) {
    return u64(id)
  }
  if (ks.ids == nil) {
    ks.ids = map<string, i64>()
  }
  let next = len(ks.ids)
  ks.ids[s] = next
  return u64(next)
}

// `tag`, then `w` as LEB128: seven bits a byte, low first, the high bit set
// on every byte but the last, so a word is at most ten bytes and marks its
// own end.
fn keyWord(ks: MapKeys, tag: u8, w: u64) {
  let buf = append(ks.enc, tag)
  let v = w
  while (v >= 0x80) {
    buf = append(buf, u8(v & 0x7f) | 0x80)
    v = v >> 7
  }
  ks.enc = append(buf, u8(v))
}
