// pkg/yaml/corpus.test.bit — runs the vendored yaml-test-suite compliance
// corpus (_tests_/corpus/yaml-test-suite/, #5500, epic #1482) through
// `yamlParseAll`.
//
// Same flat module as parse.bit/schema.bit/value.bit etc (pkg/README.md):
// `Yaml`, `YamlEntry`, `yamlParseAll` and every `yamlIs*`/`yamlAs*` accessor
// are all reached unqualified, no import, no redeclaration.
//
// THIS FILE WRITES ITS OWN `corpusYamlEqual`, NOT flow.bit's module-private
// `yamlEqual`. A first pass spot-checked several multi-key `in.yaml`/
// `in.json` pairs, saw source order preserved, and reused `yamlEqual`
// (positional) directly — but smash #5500's own `RR7F` fixture
// (`a: 4.2` then explicit `? d\n: 23`) ships `in.json` as `{"d":23,"a":4.2}`,
// reversed from source order, and disproved that assumption. `corpusEqual*`
// below mirrors toml/corpus.test.bit's own shape instead: mappings compare
// by KEY LOOKUP, not position — this corpus's JSON key order carries no
// contract either, same conclusion toml/corpus.test.bit's header reaches for
// toml-test's own JSON. Sequences stay positional (YAML sequence order is
// significant).
//
// WHAT A CASE LOOKS LIKE — different from toml-test, not a `.toml`/`.json`
// pair. Vendored at `_tests_/corpus/yaml-test-suite/README.md` explains the
// full layout; the short version: a *leaf* case is any directory holding
// `in.yaml` (some upstream test IDs bundle several as numbered
// subdirectories, e.g. `Y79Y/000/`), carrying `in.json` (expected value,
// only when JSON can represent it), `error` (present exactly when the
// document must be REJECTED) and `test.event` (upstream's own canonical
// event-stream ground truth, not parsed by this file — out of scope, named
// in the corpus README).
//
// BIT_REPO IS REQUIRED, never "." — same reason toml/corpus.test.bit and
// `_tests_/bit/packagesgate.bit` give: a "." fallback resolves against the
// test runner's cwd, not the repo, and a corpus walk over the wrong
// directory reads as zero fixtures found, which `corpusRun` treats as a
// hard failure (asserted non-zero BEFORE anything about pass/fail results),
// never a silent green.
//
// EACH HALF'S OWN QUESTION (this ticket's own instruction — "did not error"
// alone passes a parser that returns an empty mapping for everything):
//   parse cases (no `error` marker) — parses, AND the value structurally
//     equals the sibling `in.json`'s decoded value.
//   error cases (`error` marker present) — every fixture is REJECTED; a
//     parser that accepts an invalid document is exactly the defect this
//     half exists to catch.
//
// EXCLUSIONS carry a `Reason`, never a bare path — an unexplained exclusion
// is indistinguishable from a silently failing case (this ticket's own
// constraint). Most entries are real, currently-open gaps in this package's
// own `pkg/yaml/*.bit` files (none of which this ticket owns or edits); a
// smaller group is the corpus's own oracle limitation (no `in.json` to
// compare against, or a multi-document stream whose `in.json` concatenates
// one JSON text per document with no separator this file parses as a
// stream) — see smash #5500's ticket comment for the full grouping.

import { env } from "std/os"
import { readFile, walk, exists } from "std/fs"
import {
  Json,
  JsonEntry,
  jsonParse,
  jsonAsBool,
  jsonAsInt,
  jsonAsFloat,
  jsonAsString,
  jsonAsArray,
  jsonAsObject,
  jsonIsNull,
  jsonIsBool,
  jsonIsInt,
  jsonIsFloat,
  jsonIsString,
} from "std/json"

// A case this corpus cannot pass without a change to this package's own
// `*.bit` files, or one the corpus itself gives no ground truth for. `id` is
// corpus-root-relative, e.g. `"229Q"` or `"Y79Y/000"`.
class CorpusExclusion { id: string, reason: string }

// Builds one reason-group's worth of entries — kept as its own function so
// `corpusExclusionList` stays a short list of calls (spec/LINT.md's 80-line
// ceiling) instead of one long literal.
fn corpusExclusionsFor(ids: []string, reason: string): []CorpusExclusion {
  let out = []CorpusExclusion(0, len(ids))
  let i = 0
  while (i < len(ids)) {
    out = append(out, CorpusExclusion{ id: ids[i], reason: reason })
    i = i + 1
  }
  return out
}

fn corpusAppendAll(dst: []CorpusExclusion, src: []CorpusExclusion): []CorpusExclusion {
  let i = 0
  while (i < len(src)) {
    dst = append(dst, src[i])
    i = i + 1
  }
  return dst
}

fn corpusExclusionsNoJson(): []CorpusExclusion {
  return corpusExclusionsFor(
    [
      "2JQS", "4ABK", "4FJ6", "6BFJ", "6M2F", "6PBE", "9MMW", "CFD4", "DFF7", "FH7J",
      "FRK4", "KK5P", "LX3P", "M2N8/00", "M2N8/01", "M5DY", "NHX8", "NKF9", "PW8X", "Q9WF",
      "RZP5", "S3PD", "SBG9", "SM9W/01", "UKK6/00", "UKK6/02", "V9D5", "X38W", "XW4D",
    ],
    "upstream ships no in.json for this valid case: its value is not representable in JSON (anchors/aliases producing a shared, not merely equal, subtree; a non-scalar mapping key; or another construct JSON has no syntax for) — see the case's own test.event for its real expected structure; no ground truth to assert against beyond parse success, which this harness does not accept as a pass",
  )
}

fn corpusExclusionsMultiDoc(): []CorpusExclusion {
  return corpusExclusionsFor(
    [
      "5TYM", "6WLZ", "6XDY", "6ZKB", "7Z25", "8G76", "98YD", "9DXL", "9WXW", "AVM7",
      "HWV9", "JHB9", "KSS4", "L383", "PUW8", "QT73", "U9NS", "W4TN", "RZT7",
    ],
    "multi-document stream: upstream's in.json for a multi-document case concatenates one JSON text per document with no separator, which this harness's single jsonParse call cannot split into per-document values; comparing only single-document cases against in.json is this ticket's scope",
  )
}

// Every function below groups a real, currently-open gap in this package's
// own parse.bit/scan.bit/scalar.bit/block.bit/flow.bit/anchor.bit files
// (none of which this ticket owns or edits), found by running the corpus and
// reading the fixture behind every failure — grouped by the construct that
// trips it, filed on smash #5500 for a compiler engineer to split into
// per-file follow-up tickets. Shrink the relevant list in the SAME commit
// that fixes each area — never leave a fixed case excluded.

fn corpusExclusionsAnchorTagNewline(): []CorpusExclusion {
  return corpusExclusionsFor(
    [
      "26DV", "57H4", "6JWB", "735Y", "7BMT", "U3XV", "9KAX", "BU8L", "C4HZ", "LE5A",
      "M5C3", "SKE5", "HMQ5", "E76Z", "ZWK4",
    ],
    "parse.bit: a node's anchor and/or tag, alone on its own line with the actual value (a scalar or a block collection) starting on the following, more-indented line, is not threaded through — consumeNodeProperties consumes the Anchor/Tag tokens but dispatchBlockNode does not know how to resume from the Indent token that follows",
  )
}

fn corpusExclusionsRootIndentation(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["2AUY", "4RWC", "93JH", "F2C7"],
    "parse.bit: a document (or a top-level flow collection) whose first token is not at column 0 — legal when the whole document body is uniformly indented — is not accepted; parseDocumentContent always starts at indent 0",
  )
}

fn corpusExclusionsTabSeparator(): []CorpusExclusion {
  return corpusExclusionsFor(
    [
      "6CA3", "DK95/03", "DK95/07", "Q5MG", "DK95/00", "DK95/04", "DK95/05", "NB6Z",
      "UV7Q", "Y79Y/010", "DC7X", "J3BT",
    ],
    "scan.bit: a tab byte used as ordinary separator/indentation whitespace (after a sequence '-', before a mapping ':', on an otherwise-blank continuation line, or before a block scalar header) is not accepted the way a space is",
  )
}

fn corpusExclusionsVerbatimTag(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["7FWL", "UGM3"],
    "scan.bit: the verbatim tag syntax '!<...>' is not recognized by the tag scanner",
  )
}

fn corpusExclusionsPlainScalarFold(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["36F6", "4CQQ", "4ZYM", "9YRD", "A984", "EX5H", "FBC9", "HS5T", "JTV5", "M7A3", "XLQ9"],
    "parse.bit's own documented scope gap (this file's header): a bare multi-line plain scalar with no explicit quoting — 'hello\\nworld' folded into one scalar, at the top level, as an explicit key/value, or as a mapping value — is not implemented",
  )
}

fn corpusExclusionsCompactNesting(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["3ALJ", "6BCT", "A2M4", "5WE3", "9U5K", "AB8U", "4WA9", "W42U"],
    "parse.bit: a compact nested block collection continuing on the line(s) after a '-' or 'key:' (e.g. '- - x', '- key: |\\n  ...\\n  key2: ...') is not threaded to the inner collection's own column, ending the outer parse early",
  )
}

fn corpusExclusionsTagPrefixValue(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["35KP", "3MYT", "74H7"],
    "parse.bit: an explicit '!!tag' (or a custom tag) directly prefixing a scalar or block collection value is consumed and ignored per this file's own tag policy, but several such fixtures fail to parse at all rather than falling back to implicit typing",
  )
}

fn corpusExclusionsDocMarkerSeparator(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["82AN", "EXG3"],
    "scan.bit: '---'/'...' are recognized as document markers even when not followed by whitespace or end-of-line, misreading a plain scalar that merely starts with three dashes (e.g. '---word1') as a marker",
  )
}

fn corpusExclusionsQuotedScalarFold(): []CorpusExclusion {
  return corpusExclusionsFor(
    [
      "3RLN/00", "3RLN/03", "565N", "6WPF", "7A4E", "9TFX", "DE56/00", "DE56/01",
      "DK95/08", "MJS9", "NAT4", "PRH3", "T4YY", "TL85",
    ],
    "scalar.bit: a double- or single-quoted scalar spanning multiple lines does not fold blank/continuation lines per the spec's line-folding rule (a run of blank lines becomes that many newlines, a single line break becomes one space, and a trailing backslash at end-of-line suppresses the fold entirely) — this package returns the literal, unfolded lines instead",
  )
}

fn corpusExclusionsWhitespaceTrim(): []CorpusExclusion {
  return corpusExclusionsFor(
    [
      "5C5M", "5KJE", "DBG4", "L9U5", "LP6E", "Q88A", "UDM2", "YD5X", "UDR7", "R52L",
      "SYW4", "S9E8", "JR7V", "JQ4R",
    ],
    "scalar.bit: a plain scalar's decoder does not trim trailing (or, in flow context, surrounding) whitespace before the token that ends it (':', ',', ']', '}', or end of line), so the decoded key or value keeps the extra space(s) upstream's own JSON does not",
  )
}

fn corpusExclusionsExplicitTagType(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["S4JQ"],
    "parse.bit: the bare non-specific tag '!' is meant to force implicit typing off (resolving the scalar as a plain string) per the core schema, but this file's tag handling treats every tag identically (consumed and ignored), so a scalar under '! 12' still resolves through implicit typing to an int",
  )
}

fn corpusExclusionsEscapeTable(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["3RLN/01", "3RLN/04", "DE56/02", "DE56/03", "KH5V/01", "NP9H", "Q8AD"],
    "scalar.bit: the double-quoted escape table does not recognize every escape spelling the core grammar accepts (e.g. a backslash directly followed by a literal tab byte), rejecting the fixture as an unknown escape character instead of decoding it",
  )
}

fn corpusExclusionsFlowGrammarGap(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["6HB6", "8UDB", "CN3R", "WZ62", "UT92"],
    "6HB6/8UDB/CN3R/WZ62 are NOT a flow.bit gap: flow.bit now handles every construct this group originally named (comments, multi-line plain-scalar folding, explicit '? key : value', a glued 'key:value' with no separating space, and an anchor/tag prefixing a nested entry — #5529); these 4 fail only because scalar.bit's decodePlain still returns an ORDINARY (non-glued) plain scalar's single-line span untrimmed, the exact bug #5526 already fixed on main after this branch's own base commit — expect all 4 to pass with no further flow.bit change once this branch lands past that commit. UT92 is a 2-document stream ('---'...'...' twice) whose in.json is two concatenated JSON texts with no separator between them — corpusExclusionsMultiDoc's own oracle-limitation reason, not a flow.bit gap; misfiled into this group by #5500",
  )
}

fn corpusExclusionsAliasUndefined(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["2SXE", "6KGN"],
    "scan.bit/anchor.bit: an alias reports 'undefined anchor' for a genuinely-defined anchor in two distinct edge cases — an anchor name scan that absorbs a trailing ':' that should instead terminate it, and an anchor bound to an empty/null value (no inline scalar, no indented child) that is never registered in the anchor table",
  )
}

fn corpusExclusionsTrailingContent(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["3HFZ", "62EZ", "9C9N", "9JBA", "JY7Z", "P2EQ", "SU5Z", "X4QW", "VJP3/00", "DK4H", "N782"],
    "parse.bit/scan.bit: content is accepted after a construct that should already be complete — a closed flow collection, a closed quoted scalar, a document-end ('...') marker, or a '#' that starts a comment without the required preceding whitespace — instead of being rejected as trailing garbage",
  )
}

fn corpusExclusionsScalarBoundary(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["5TRB", "7LBH", "D49Q", "QB6E", "RXY3", "9MQT/01", "JKF3"],
    "scalar.bit: a multi-line quoted scalar's continuation, or a quoted scalar spanning past where a document boundary ('...'/'---') should end it, is accepted without enforcing the spec's minimum-indentation/boundary rule",
  )
}

fn corpusExclusionsDirectiveValidation(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["H7TQ", "MUS6/00", "MUS6/01", "QLJ7", "RHX7", "SF5V", "9HCY", "B63P", "9MMA", "EB22"],
    "parse.bit: a malformed '%YAML'/'%TAG' directive (trailing garbage on the directive line, the same directive repeated for one document, a directive placed after a document's own content, or a directive with no document to follow it) is accepted instead of rejected",
  )
}

fn corpusExclusionsAnchorAliasInvalid(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["SR86", "SY6V", "CXX2"],
    "anchor.bit: an anchor attached to an alias node, an anchor with no required separating space before a following sequence '-', or an anchor attached to a mapping key at the very start of a document is accepted when the spec requires each to be rejected",
  )
}

fn corpusExclusionsTabValidation(): []CorpusExclusion {
  return corpusExclusionsFor(
    [
      "Y79Y/000", "Y79Y/003", "Y79Y/004", "Y79Y/005", "Y79Y/006", "Y79Y/008", "Y79Y/009",
      "DK95/01",
    ],
    "scan.bit: a tab byte immediately after a block/flow indicator that specifically requires a space (not any whitespace) — e.g. '-<tab>-', '?<tab>-', or a tab starting a block scalar's line — is accepted as if it were a legal separator",
  )
}

fn corpusExclusionsColonChain(): []CorpusExclusion {
  return corpusExclusionsFor(
    ["ZCZ6", "ZL4Z"],
    "parse.bit: a chain of colons on one line ('a: b: c: d', \"a: 'b': c\") is accepted as an implicitly nested mapping; only a compact 'key: value' directly after a block sequence '-' is legal that way, not a bare mapping value",
  )
}

// A slice literal is not a `const_expr` (SPEC S11.2), so this is a function,
// not a top-level `const` — same reason toml/corpus.test.bit's own list is a
// function. Split across the many `corpusExclusions*` groups above (each
// under spec/LINT.md's 80-line-per-function ceiling); this just concatenates
// them.
fn corpusExclusionList(): []CorpusExclusion {
  let out = []CorpusExclusion(0)
  out = corpusAppendAll(out, corpusExclusionsNoJson())
  out = corpusAppendAll(out, corpusExclusionsMultiDoc())
  out = corpusAppendAll(out, corpusExclusionsAnchorTagNewline())
  out = corpusAppendAll(out, corpusExclusionsRootIndentation())
  out = corpusAppendAll(out, corpusExclusionsTabSeparator())
  out = corpusAppendAll(out, corpusExclusionsVerbatimTag())
  out = corpusAppendAll(out, corpusExclusionsPlainScalarFold())
  out = corpusAppendAll(out, corpusExclusionsCompactNesting())
  out = corpusAppendAll(out, corpusExclusionsTagPrefixValue())
  out = corpusAppendAll(out, corpusExclusionsDocMarkerSeparator())
  out = corpusAppendAll(out, corpusExclusionsQuotedScalarFold())
  out = corpusAppendAll(out, corpusExclusionsWhitespaceTrim())
  out = corpusAppendAll(out, corpusExclusionsExplicitTagType())
  out = corpusAppendAll(out, corpusExclusionsEscapeTable())
  out = corpusAppendAll(out, corpusExclusionsFlowGrammarGap())
  out = corpusAppendAll(out, corpusExclusionsAliasUndefined())
  out = corpusAppendAll(out, corpusExclusionsTrailingContent())
  out = corpusAppendAll(out, corpusExclusionsScalarBoundary())
  out = corpusAppendAll(out, corpusExclusionsDirectiveValidation())
  out = corpusAppendAll(out, corpusExclusionsAnchorAliasInvalid())
  out = corpusAppendAll(out, corpusExclusionsTabValidation())
  out = corpusAppendAll(out, corpusExclusionsColonChain())
  return out
}

fn corpusIsExcluded(id: string): bool {
  let exclusions = corpusExclusionList()
  let i = 0
  while (i < len(exclusions)) {
    if (exclusions[i].id == id) {
      return true
    }
    i = i + 1
  }
  return false
}

fn corpusRepoRoot(): string {
  let r = env("BIT_REPO")
  if (len(r) == 0) {
    panic("yaml corpus: BIT_REPO is not set — run this through `./make test-package-yaml`")
  }
  return r
}

fn corpusRoot(): string {
  return "${corpusRepoRoot()}/_tests_/corpus/yaml-test-suite"
}

// `full` is always `corpusRoot()` plus `/` plus the relative path — every
// caller derives it from a `walk(corpusRoot())` result.
fn corpusRelPath(full: string): string {
  let root = corpusRoot()
  return full[len(root) + 1:len(full)]
}

const inYamlSuffix: string = "/in.yaml"

// The leaf case id for a walked path ending in `/in.yaml` — the relative
// directory holding it, e.g. `"229Q"` or `"Y79Y/000"`.
fn corpusLeafId(relPath: string): string {
  return relPath[0:len(relPath) - len(inYamlSuffix)]
}

// Every leaf case id under the corpus root, sorted (`walk`'s own guarantee,
// sorted depth-first at each level) — a leaf is any directory `walk` finds
// an `in.yaml` inside, whatever depth it sits at (a plain top-level id, or
// one of its numbered sub-case children).
fn corpusLeafIds(): []string {
  let root = corpusRoot()
  let files = walk(root) catch e {
    panic("yaml corpus: cannot walk ${root}: ${e.message()}")
  }
  let out = []string(0)
  let i = 0
  while (i < len(files)) {
    if (hasSuffix(files[i], inYamlSuffix)) {
      out = append(out, corpusLeafId(corpusRelPath(files[i])))
    }
    i = i + 1
  }
  return out
}

fn corpusError(msg: string): error {
  return newError("yaml corpus: ${msg}")
}

// --- upstream's plain JSON encoding -> Yaml -------------------------------
//
// Unlike toml-test, yaml-test-suite's `in.json` carries no type tagging —
// JSON's own seven shapes already distinguish everything the core schema
// (`schema.bit`) can produce except int-vs-float, which `std/json` itself
// already keeps apart (`jsonIsInt`/`jsonIsFloat`).

fn corpusJsonEntriesToYaml(entries: []JsonEntry): []YamlEntry! {
  let out = []YamlEntry(0, len(entries))
  let i = 0
  while (i < len(entries)) {
    let v = corpusJsonToYaml(entries[i].value)?
    out = append(out, YamlEntry{ key: Yaml.YamlString(entries[i].key), value: v })
    i = i + 1
  }
  return out
}

fn corpusJsonArrayToYaml(items: []Json): []Yaml! {
  let out = []Yaml(0, len(items))
  let i = 0
  while (i < len(items)) {
    out = append(out, corpusJsonToYaml(items[i])?)
    i = i + 1
  }
  return out
}

fn corpusJsonScalarToYaml(j: Json): Option<Yaml> {
  if (jsonIsNull(j)) {
    return Option<Yaml>.Some(Yaml.YamlNull)
  }
  if (jsonIsBool(j)) {
    return Option<Yaml>.Some(Yaml.YamlBool(unwrap(jsonAsBool(j))))
  }
  if (jsonIsInt(j)) {
    return Option<Yaml>.Some(Yaml.YamlInt(unwrap(jsonAsInt(j))))
  }
  if (jsonIsFloat(j)) {
    return Option<Yaml>.Some(Yaml.YamlFloat(unwrap(jsonAsFloat(j))))
  }
  if (jsonIsString(j)) {
    return Option<Yaml>.Some(Yaml.YamlString(unwrap(jsonAsString(j))))
  }
  return Option<Yaml>.None
}

fn corpusJsonToYaml(j: Json): Yaml! {
  let scalar = corpusJsonScalarToYaml(j)
  match (scalar) {
    Some(y) => { return y }
    None => {}
  }
  let arr = jsonAsArray(j)
  match (arr) {
    Some(items) => { return Yaml.YamlSequence(corpusJsonArrayToYaml(items)?) }
    None => {}
  }
  let obj = jsonAsObject(j)
  match (obj) {
    Some(entries) => { return Yaml.YamlMapping(corpusJsonEntriesToYaml(entries)?) }
    None => { fail corpusError("expected-json fixture is not a recognized JSON shape") }
  }
}

// --- structural equality against the expected fixture ----------------------
//
// See this file's header for why this is not `yamlEqual` (flow.bit,
// positional). The four scalar leaves are reused from there — `yamlEqualBool`
// / `yamlEqualInt` / `yamlEqualFloat` / `yamlEqualString` are pure value
// comparisons, nothing round-trip- or order-specific about any of them.

fn corpusEqualSequence(a: Yaml, b: Yaml): bool {
  if (!yamlIsSequence(b)) {
    return false
  }
  let xa = unwrap(yamlAsSequence(a))
  let xb = unwrap(yamlAsSequence(b))
  if (len(xa) != len(xb)) {
    return false
  }
  let i = 0
  while (i < len(xa)) {
    if (!corpusYamlEqual(xa[i], xb[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

fn corpusFindYamlEntry(entries: []YamlEntry, key: Yaml): Option<Yaml> {
  let i = 0
  while (i < len(entries)) {
    if (corpusYamlEqual(entries[i].key, key)) {
      return Option<Yaml>.Some(entries[i].value)
    }
    i = i + 1
  }
  return Option<Yaml>.None
}

fn corpusEntryMatches(found: Option<Yaml>, want: Yaml): bool {
  match (found) {
    None => { return false }
    Some(v) => { return corpusYamlEqual(want, v) }
  }
}

// Key-set comparison, NOT positional — see this file's header.
fn corpusEqualMapping(a: Yaml, b: Yaml): bool {
  if (!yamlIsMapping(b)) {
    return false
  }
  let ea = unwrap(yamlAsMapping(a))
  let eb = unwrap(yamlAsMapping(b))
  if (len(ea) != len(eb)) {
    return false
  }
  let i = 0
  while (i < len(ea)) {
    if (!corpusEntryMatches(corpusFindYamlEntry(eb, ea[i].key), ea[i].value)) {
      return false
    }
    i = i + 1
  }
  return true
}

fn corpusYamlEqual(a: Yaml, b: Yaml): bool {
  if (yamlIsBool(a)) {
    return yamlEqualBool(unwrap(yamlAsBool(a)), b)
  }
  if (yamlIsInt(a)) {
    return yamlEqualInt(unwrap(yamlAsInt(a)), b)
  }
  if (yamlIsFloat(a)) {
    return yamlEqualFloat(unwrap(yamlAsFloat(a)), b)
  }
  if (yamlIsString(a)) {
    return yamlEqualString(unwrap(yamlAsString(a)), b)
  }
  if (yamlIsSequence(a)) {
    return corpusEqualSequence(a, b)
  }
  if (yamlIsMapping(a)) {
    return corpusEqualMapping(a, b)
  }
  return yamlIsNull(b)
}

// --- running one case ------------------------------------------------------

enum CorpusOutcome {
  CorpusPassed,
  CorpusExcluded,
  CorpusFailed(string),
}

// A document that must parse, and whose parsed value must structurally
// equal `in.json`'s decoded value. A multi-document stream (`len(docs) !=
// 1`) is reported as its own failure reason rather than silently compared
// against `docs[0]` — this file's header explains why that case is excluded
// where it occurs upstream.
fn corpusParseCheck(leafFull: string): Option<string> {
  let text = readFile("${leafFull}/in.yaml") catch e {
    return Option<string>.Some("cannot read in.yaml: ${e.message()}")
  }
  let docs = yamlParseAll(text) catch e {
    return Option<string>.Some("parse failed: ${e.message()}")
  }
  if (len(docs) != 1) {
    return Option<string>.Some("expected exactly one document, found ${len(docs)}")
  }
  let jsonText = readFile("${leafFull}/in.json") catch e {
    return Option<string>.Some("cannot read in.json: ${e.message()}")
  }
  let expectedJson = jsonParse(jsonText) catch e {
    return Option<string>.Some("in.json is invalid: ${e.message()}")
  }
  let expected = corpusJsonToYaml(expectedJson) catch e {
    return Option<string>.Some("cannot decode in.json: ${e.message()}")
  }
  if (!corpusYamlEqual(docs[0], expected)) {
    return Option<string>.Some("parsed value does not match in.json")
  }
  return Option<string>.None
}

// A document that must be REJECTED. Mirrors toml/corpus.test.bit's own
// `corpusInvalidCheck` catch shape: a dummy `[]Yaml` value in the catch arm,
// since `yamlParseAll` returns `[]Yaml!` and the catch block must still
// type-check.
fn corpusErrorCheck(leafFull: string): Option<string> {
  let text = readFile("${leafFull}/in.yaml") catch e {
    return Option<string>.Some("cannot read in.yaml: ${e.message()}")
  }
  let rejected = false
  yamlParseAll(text) catch _ {
    rejected = true
    []Yaml(0)
  }
  if (!rejected) {
    return Option<string>.Some("accepted a document tagged 'error'")
  }
  return Option<string>.None
}

fn corpusCheckOne(leafFull: string, leafId: string, isError: bool): CorpusOutcome {
  if (corpusIsExcluded(leafId)) {
    return CorpusOutcome.CorpusExcluded
  }
  let result = Option<string>.None
  if (isError) {
    result = corpusErrorCheck(leafFull)
  } else {
    result = corpusParseCheck(leafFull)
  }
  match (result) {
    None => { return CorpusOutcome.CorpusPassed }
    Some(reason) => { return CorpusOutcome.CorpusFailed(reason) }
  }
}

// --- aggregating both halves -----------------------------------------------
//
// `present` is every leaf case found on disk for this half, INCLUDING
// excluded ones — the denominator toml/corpus.test.bit's own comment
// explains the same way. `present == passed + failed + excluded` always,
// asserted below rather than left implicit, so a future change to this file
// cannot make the printed line quietly stop meaning what it says.
class CorpusResult { present: int, passed: int, failed: int, excluded: int, failures: string }

fn corpusRun(wantError: bool): CorpusResult {
  let ids = corpusLeafIds()
  let present = 0
  let passed = 0
  let failed = 0
  let excluded = 0
  let failures = newBuilder()
  let i = 0
  while (i < len(ids)) {
    let leafFull = "${corpusRoot()}/${ids[i]}"
    let isError = exists("${leafFull}/error")
    if (isError == wantError) {
      present = present + 1
      let outcome = corpusCheckOne(leafFull, ids[i], isError)
      match (outcome) {
        CorpusPassed => { passed = passed + 1 }
        CorpusExcluded => { excluded = excluded + 1 }
        CorpusFailed(reason) => {
          failed = failed + 1
          failures = failures.write("  ${ids[i]}: ${reason}\n")
        }
      }
    }
    i = i + 1
  }
  return CorpusResult{
    present: present,
    passed: passed,
    failed: failed,
    excluded: excluded,
    failures: failures.toString(),
  }
}

// --- the gate ---------------------------------------------------------

test "yaml-test-suite corpus (vendored, pinned SHA — see _tests_/corpus/yaml-test-suite/README.md)" {
  let parseResult = corpusRun(false)
  let errorResult = corpusRun(true)
  let totalPresent = parseResult.present + errorResult.present
  let totalExcluded = parseResult.excluded + errorResult.excluded
  print("yaml-test-suite: parse ${parseResult.passed}/${parseResult.present}, error ${errorResult.passed}/${errorResult.present}, excluded ${totalExcluded}/${totalPresent}\n")
  assert(
    parseResult.present > 0,
    "yaml corpus: 0 parse-half fixtures found under ${corpusRoot()} — corpus not vendored or BIT_REPO wrong",
  )
  assert(
    errorResult.present > 0,
    "yaml corpus: 0 error-half fixtures found under ${corpusRoot()} — corpus not vendored or BIT_REPO wrong",
  )
  // The denominator (`present`) and the three outcomes that add up to it
  // must never drift apart silently — see toml/corpus.test.bit's own
  // comment for the bug class this guards (excluded cases previously left
  // both sides of a ratio, reporting a perfect score over a shrunk corpus).
  assert(
    parseResult.passed + parseResult.failed + parseResult.excluded == parseResult.present,
    "yaml corpus: parse half's passed+failed+excluded does not equal present",
  )
  assert(
    errorResult.passed + errorResult.failed + errorResult.excluded == errorResult.present,
    "yaml corpus: error half's passed+failed+excluded does not equal present",
  )
  assert(
    len(corpusExclusionList()) == totalExcluded,
    "yaml corpus: exclusion list length does not equal the excluded count actually observed",
  )
  assert(
    parseResult.failed == 0,
    "yaml corpus: ${parseResult.failed} parse fixture(s) failed:\n${parseResult.failures}",
  )
  assert(
    errorResult.failed == 0,
    "yaml corpus: ${errorResult.failed} error fixture(s) were wrongly accepted:\n${errorResult.failures}",
  )
}
