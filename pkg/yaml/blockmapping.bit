// pkg/yaml/blockmapping.bit — yaml module, the block mapping entry loop
// (#5498, epic #1482). Split out of parse.bit purely to stay under
// spec/LINT.md's 800-line ceiling (#5549, the same reason plainfold.bit
// was split at #5544 and properties.bit at #5549 itself): every function
// here is called only from parse.bit's `dispatchBlockNode`/`parseAlias`/
// `parseScalarOrMapping`, against the `Parser`/`Scanner` that file defines
// (module-private, same flat namespace, pkg/README.md). Never confused
// with block.bit — this package's SIBLING-owned file for the scanner's
// own block-context token dispatch, an entirely different concern.

// The real column of `pos`, counted in raw bytes since the preceding line
// break (or the source's own start). `Scanner.col` only measures a genuine
// line start (`hasLineBreak`'s own comment, parse.bit); a `:`/`?` value
// starting INLINE, on the same physical line, is never measured at all —
// the same gap `parseSeqItemValue`'s own `dashCol`-relative `inlineCol`
// (parse.bit) already closes for a `-`'s inline value, needed here too
// (`? a\n: -\tb` — A2M4 — threads a compact sequence value's real column
// the identical way). Leading indentation is always spaces (a tab there is
// `Invalid`, indent.bit's own rule), so a raw byte count matches
// `Scanner.col`'s own convention exactly. Bounded by `pos` itself: each
// iteration strictly decreases `i`.
fn columnOf(src: string, pos: i64): i64 {
  let i = pos
  while (i > 0 && src[i - 1] != '\n') {
    i = i - 1
  }
  return pos - i
}

// Shared by an implicit `key: value`'s value, an explicit `? key`'s key, and
// `: value`'s value: an inline continuation on the same line, a nested node
// on a strictly deeper line (`Indent`), or nothing at all (`YamlNull`).
// `afterOffset` is the byte offset right past the `:`/`?` token that led
// here, needed only to resolve the same-line-vs-new-line ambiguity above.
// The same-column sequence case (parse.bit's own header): `SeqEntry` falls
// through to `parseBlockNode`, which finds it waiting at `indent`.
//
// `allowInlineSeq` gates a SECOND, narrower case: a compact block sequence
// starting INLINE, right after the indicator on its own line (`? a\n:
// -\tb` — A2M4; `? |\n  block key\n: - one` — 5WE3, "Explicit compact";
// `? - a` — KK5P, a sequence used AS an explicit key). True for both of
// `readExplicitEntry`'s own calls (key after `?`, value after `:`) — 5U3A
// ("Sequence on same Line as Mapping Key") is upstream's own proof this is
// NOT general: `key: - a` for an ordinary IMPLICIT key is REJECTED
// outright, a direct check rather than relying on some other mechanism
// (a stale column, say) to collide into an error incidentally — anything
// that later made the stale path parse further would silently turn this
// rejection into acceptance. When allowed, the value's real column comes
// from `columnOf` rather than `-1`, the same gap `parseSeqItemValue`'s own
// `dashCol`-relative `inlineCol` already closes for a `-`'s inline value.
// `allowInlineSeq` also doubles as `NodeCtx.allowCompact` (parse.bit's own
// header) — ZCZ6/ZL4Z's colon chain is exactly this same compact-nesting
// door, just for a bare scalar/flow value instead of a sequence.
fn parseInlineValue(p: Parser, indent: i64, allowInlineSeq: bool): Yaml! {
  if (!allowInlineSeq && p.s.kind == TokenKind.SeqEntry) {
    fail parseError(
      "yaml: a block sequence cannot start on the same line as an implicit mapping key's ':'",
      p.s.start,
    )
  }
  let inlineSeq = allowInlineSeq && p.s.kind == TokenKind.SeqEntry
  let colHint = inlineSeq ? columnOf(p.src, p.s.start) : -1
  return parseBlockNode(
    p,
    indent,
    colHint,
    false,
    NodeCtx{ atMarker: false, foldFloor: indent, allowCompact: allowInlineSeq, seqItem: false },
  )?
}

fn parseAfterIndicator(p: Parser, indent: i64, afterOffset: i64, allowInlineSeq: bool): Yaml! {
  skipComments(p)?
  if (p.s.kind == TokenKind.Indent) {
    advance(p)
    let childCol = p.s.col
    return parseBlockNode(
      p,
      childCol,
      -1,
      true,
      NodeCtx{ atMarker: false, foldFloor: indent, allowCompact: true, seqItem: false },
    )?
  }
  if (isDocBoundary(p.s.kind) || p.s.kind == TokenKind.Dedent) {
    return Yaml.YamlNull
  }
  let sameLine = !hasLineBreak(p.src, afterOffset, p.s.start)
  if (!sameLine && p.s.kind != TokenKind.SeqEntry) {
    return Yaml.YamlNull
  }
  if (!sameLine) {
    return parseBlockNode(
      p,
      indent,
      -1,
      false,
      NodeCtx{ atMarker: false, foldFloor: indent, allowCompact: true, seqItem: false },
    )?
  }
  return parseInlineValue(p, indent, allowInlineSeq)?
}

// A bare ':' starting a node's own content is an implicit, empty (null)
// mapping key (2JQS/NHX8/SM9W-01/UKK6-00; `readMappingEntry`'s own
// `ValueIndicator` branch below handles every entry after the first) —
// UNLESS `rejectImplicitKey` (ZCZ6's `a: b: c: d`, chaining with no
// indentation, `NodeCtx.allowCompact`'s own header, parse.bit) OR a PENDING
// PROPERTY dedented past its own floor to reach this `:` (PW8X item 5's
// `? &e\n: &a`: `&e`'s dedent lands back on `readExplicitEntry`'s own
// column, where its `:` is the EXPLICIT entry's own value separator, not a
// second implicit key — same "dedented past my own floor is never mine"
// rule `dispatchBlockNode`'s `SeqEntry` case uses (parse.bit), minus its
// mapping-value exemption, §8.19 exempts no colon). Gated on a pending
// property, not `col <= foldFloor` alone: `Scanner.col` is never measured
// for a `:` starting INLINE (`columnOf`'s own header above) — M2N8/00's
// `- ? : x` reaches here with a STALE `col` and no property pending; that
// staleness is `readMappingEntry`'s own problem, and it must still open
// `{null: x}`. Split out of `dispatchBlockNode`'s own switch (parse.bit) for
// that function's own complexity.
//
// YAML 1.2.2 §6.9: a property decorates the node it immediately precedes —
// here, the bare `:`'s own empty KEY, never the mapping it opens (PW8X
// items 3/4: `&a : a`, `&c : &a`). `readMappingEntry`'s own `isSome(pending)`
// branch below is the SAME "key already read, now consume the ':'" shape
// every other key-reading path uses, so passing the decorated key through
// as `firstKey` reuses it rather than wrapping `applyAnchor` around
// `parseBlockMapping`'s WHOLE return value.
fn dispatchImplicitEmptyKey(p: Parser, col: i64, foldFloor: i64, ctx: DispatchCtx): Yaml! {
  if (ctx.rejectImplicitKey) {
    fail parseError("yaml: unexpected token in block context", p.s.start)
  }
  let pendingProp = isSome(ctx.pendingProps.anchor) || isSome(ctx.pendingProps.tag)
  if (pendingProp && col <= foldFloor) {
    return applyAnchor(p, ctx.pendingProps, resolveByKind("", TokenKind.PlainScalar, p.resolver))?
  }
  let keyStart = p.s.start
  let key = applyAnchor(p, ctx.pendingProps, Yaml.YamlNull)?
  return parseBlockMapping(p, col, Option<Yaml>.Some(key), keyStart)?
}

class MapEntryOut { key: Yaml, keyStart: i64, value: Yaml }

fn readMappingEntry(p: Parser, col: i64, pending: Option<Yaml>, pendingStart: i64): MapEntryOut! {
  if (isSome(pending)) {
    let afterColon = p.s.end
    advance(p)
    let value = parseAfterIndicator(p, col, afterColon, false)?
    return MapEntryOut{ key: unwrap(pending), keyStart: pendingStart, value: value }
  }
  if (p.s.kind == TokenKind.KeyIndicator) {
    return readExplicitEntry(p, col)?
  }
  // A bare ':' at this mapping's own column is an implicit, empty (null)
  // key (2JQS's second line, S3PD's second entry — `dispatchBlockNode`'s
  // own `ValueIndicator` case, parse.bit, is this same branch's twin for
  // an entry's own FIRST token, before any mapping exists to loop
  // through). `readImplicitEntry` cannot handle it: `readKeyPrimary`
  // expects a scalar or alias token, never a bare indicator.
  if (p.s.kind == TokenKind.ValueIndicator) {
    let keyStart = p.s.start
    let afterColon = p.s.end
    advance(p)
    let value = parseAfterIndicator(p, col, afterColon, false)?
    return MapEntryOut{ key: Yaml.YamlNull, keyStart: keyStart, value: value }
  }
  return readImplicitEntry(p, col)?
}

// `? key` with an optional `: value` — the value indicator, if present,
// must sit back at this mapping's own column (a nested key that itself
// contains a colon-bearing scalar must not be mistaken for one).
fn readExplicitEntry(p: Parser, col: i64): MapEntryOut! {
  let keyStart = p.s.start
  let afterQ = p.s.end
  advance(p)
  let key = parseAfterIndicator(p, col, afterQ, true)?
  checkNotMergeKey(key, keyStart)?
  skipComments(p)?
  while (p.s.kind == TokenKind.Dedent) {
    advance(p)
  }
  if (p.s.col == col && p.s.kind == TokenKind.ValueIndicator) {
    let afterColon = p.s.end
    advance(p)
    let value = parseAfterIndicator(p, col, afterColon, true)?
    return MapEntryOut{ key: key, keyStart: keyStart, value: value }
  }
  return MapEntryOut{ key: key, keyStart: keyStart, value: Yaml.YamlNull }
}

// `readImplicitKey` (properties.bit) reads the key itself — a bare scalar,
// an alias, or either wrapped in its own `&anchor`/`!tag` prefix
// (26DV/E76Z/HMQ5/ZWK4) — so this only owns the `:` that must follow it.
fn readImplicitEntry(p: Parser, col: i64): MapEntryOut! {
  let (key, keyStart) = readImplicitKey(p, col)?
  if (p.s.kind != TokenKind.ValueIndicator) {
    fail parseError("yaml: expected ':' after mapping key", p.s.start)
  }
  checkNotMergeKey(key, keyStart)?
  let afterColon = p.s.end
  advance(p)
  let value = parseAfterIndicator(p, col, afterColon, false)?
  return MapEntryOut{ key: key, keyStart: keyStart, value: value }
}

fn finishMapping(p: Parser, entries: []YamlEntry): Yaml! {
  chargeBlockNode(p, p.s.start)?
  return Yaml.YamlMapping(entries)
}

// True when `p.s.kind` could start another mapping entry sharing `col`: an
// explicit `?`, a bare scalar key, or a key wrapped in its own properties
// (`isKeyProperty` — 26DV/E76Z/HMQ5/ZWK4).
fn mappingEntryContinues(p: Parser): bool {
  return p.s.kind == TokenKind.KeyIndicator ||
    isScalarStart(p.s.kind) ||
    isKeyProperty(p.s.kind) ||
    p.s.kind == TokenKind.ValueIndicator
}

// One block mapping, all entries at exactly `col`. `firstKey`, when present,
// is a scalar key `dispatchBlockNode` already consumed while checking for a
// `:` — `readMappingEntry` folds it into the very first loop iteration so
// every entry after it goes through the identical path.
fn parseBlockMapping(p: Parser, col: i64, firstKey: Option<Yaml>, firstKeyStart: i64): Yaml! {
  let entries = []YamlEntry(0)
  let pending = firstKey
  let pendingStart = firstKeyStart
  let guard = 0
  let bound = p.s.srcLen + 8
  while (guard <= bound) {
    guard = guard + 1
    let out = readMappingEntry(p, col, pending, pendingStart)?
    pending = Option<Yaml>.None
    if (flowKeyPresent(entries, out.key)) {
      fail parseError("yaml: duplicate key in block mapping", out.keyStart)
    }
    entries = append(entries, YamlEntry{ key: out.key, value: out.value })
    skipComments(p)?
    if (p.s.col != col) {
      return finishMapping(p, entries)?
    }
    if (p.s.kind != TokenKind.Eof && !startsOnFreshLine(p.src, p.s.start)) {
      fail parseError("yaml: unexpected content after mapping entry", p.s.start)
    }
    while (p.s.kind == TokenKind.Dedent || compactContinuation(p, col)) {
      advance(p)
    }
    if (!mappingEntryContinues(p)) {
      return finishMapping(p, entries)?
    }
  }
  fail parseError("yaml: block mapping scan did not terminate", p.s.start)
}
