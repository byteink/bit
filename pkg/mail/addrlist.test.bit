// pkg/mail/addrlist.test.bit — parseAddressList, and what error messages are
// allowed to echo.

import { contains, repeat } from "std/strings"

fn parsedList(input: string): []Address {
  return parseAddressList(input) catch e {
    panic("parseAddressList(${input}) failed: ${e.message()}")
  }
}

fn listRefusal(input: string): string {
  parseAddressList(input) catch e {
    return e.message()
  }
  return ""
}

test "a list keeps its order and splits only on commas outside quotes and brackets" {
  let list = parsedList("sara@example.com, \"Ali, Sara\" <sara.ali@example.com>,Tom <tom@example.com> ,<kim@example.com>")
  assert(len(list) == 4, "got ${len(list)} addresses")
  assert(list[0].email == "sara@example.com" && list[0].name == "")
  assert(list[1].name == "Ali, Sara" && list[1].email == "sara.ali@example.com")
  assert(list[2].name == "Tom" && list[2].email == "tom@example.com")
  assert(list[3].name == "" && list[3].email == "kim@example.com")
}

test "a list of one is a list of one" {
  let list = parsedList("Sara <sara@example.com>")
  assert(len(list) == 1)
  assert(list[0].name == "Sara")
}

test "a list refuses an empty element, naming it" {
  assert(contains(listRefusal("a@example.com,,b@example.com"), "empty address"))
  assert(contains(listRefusal("a@example.com,"), "empty address"))
  assert(contains(listRefusal(",a@example.com"), "empty address"))
  assert(contains(listRefusal(""), "empty"))
}

test "a list refuses the same things a single address does, naming the mailbox at fault" {
  let msg = listRefusal("a@example.com, b@@example.com")
  assert(contains(msg, "\"b@@example.com\""), msg)
  assert(contains(msg, "more than one @"), msg)
  assert(contains(listRefusal("team: a@example.com, b@example.com;"), "group syntax"))
  assert(contains(listRefusal("a@example.com, b@example.com\r\nBcc: x@example.net"), "CR"))
}

test "a list of valid mailboxes round-trips through toString" {
  let list = parsedList("\"Ali, Sara\" <sara@example.com>, Zoë <zoe@example.com>, kim@example.com")
  let parts: []string = []
  for a of list {
    parts = append(parts, a.toString())
  }
  let again = parsedList(parts[0] + ", " + parts[1] + ", " + parts[2])
  assert(len(again) == 3)
  let i = 0
  while (i < 3) {
    assert(again[i].name == list[i].name && again[i].email == list[i].email)
    i = i + 1
  }
}

test "an error message never carries a raw CR, LF or NUL, and cuts a long input" {
  let msg = listRefusal("a@example.com\r\nBcc: evil@example.net")
  assert(!contains(msg, "\r") && !contains(msg, "\n"), "raw line break in the message")
  assert(contains(msg, "\\r\\n"), msg)
  let long = listRefusal(repeat("x", 5000))
  assert(len(long) < 300, "message is ${len(long)} bytes")
  assert(contains(long, "..."), long)
}

test "MailError.Invalid carries the text after the package prefix" {
  let e = MailError.Invalid("nope")
  assert(e.message() == "mail: nope")
}
