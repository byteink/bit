import { Certificate, pemDecode, x509Parse } from "std/crypto"
import { hasPrefix, indexOf, trimSpace } from "std/strings"

fn snsParseCertificate(pem: string): Certificate!MailError {
  if (len(pem) > snsCertMaxBytes) {
    fail webhookRejected("SNS signing certificate PEM is invalid")
  }
  let text = trimSpace(pem)
  let end = "-----END CERTIFICATE-----"
  // pemDecode permits explanatory text; SNS supplies exactly one certificate.
  if (!hasPrefix(text, "-----BEGIN CERTIFICATE-----") ||
    indexOf(text, end) != len(text) - len(end)) {
    fail webhookRejected("SNS signing certificate PEM is invalid")
  }
  let blocks = pemDecode(text) catch _ {
    fail webhookRejected("SNS signing certificate PEM is invalid")
  }
  if (len(blocks) != 1 || blocks[0].label != "CERTIFICATE") {
    fail webhookRejected("SNS signing certificate PEM is invalid")
  }
  return x509Parse(blocks[0].der) catch _ {
    fail webhookRejected("SNS signing certificate PEM is invalid")
  }
}
