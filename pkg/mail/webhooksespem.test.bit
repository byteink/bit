import { encodeHex, pemEncode, x509KeyRSA } from "std/crypto"
import { repeat, replace } from "std/strings"

fn spPem(): string {
  return pemEncode("CERTIFICATE", svBytes(svLeaf))
}

fn spVerdict(text: string): string {
  snsParseCertificate(text) catch e {
    match (e) {
      Signature(why) => return why
      _ => return "wrong error type"
    }
  }
  return "ok"
}

fn spRejected(text: string, why: string) {
  assert(spVerdict(text) == "SNS signing certificate PEM is invalid", why)
}

test "SNS certificate PEM parses the existing signer without adding TLS purpose" {
  let leaf = snsParseCertificate(" \r\n\t" + spPem() + "\r\n \t") catch e {
    panic(e.message())
  }
  assert(leaf.subject == "CN=Bit SNS Signing Fixture", "existing signer subject")
  assert(encodeHex(leaf.serial) == "04", "existing signer serial")
  assert(leaf.pubKeyAlg == x509KeyRSA, "existing RSA public key")
  assert(len(leaf.dnsNames) == 0 && !leaf.hasExtKeyUsage, "no TLS identity or purpose")
}

test "SNS certificate PEM requires one complete certificate and no explanatory text" {
  let pem = spPem()
  spRejected("", "empty input")
  spRejected(" \r\n\t", "whitespace only")
  spRejected(pemEncode("PUBLIC KEY", svBytes(svLeaf)), "wrong label")
  spRejected(pem + pem, "multiple certificates")
  spRejected("secret-value\n" + pem, "leading text")
  spRejected(pem + "secret-value", "trailing text")
  spRejected(pem + "-----END CERTIFICATE-----", "duplicate END rejected")
  spRejected(pem + "secret-value\n-----END CERTIFICATE-----", "junk and duplicate END rejected")
  spRejected("-----BEGIN CERTIFICATE-----\nAA==\n", "missing END")
  spRejected(replace(pem, "END CERTIFICATE", "END PUBLIC KEY"), "mismatched END label")
}

test "SNS certificate PEM bounds the complete response before decoding" {
  let pem = spPem()
  let atLimit = pem + repeat(" ", snsCertMaxBytes - len(pem))
  assert(len(atLimit) == snsCertMaxBytes && spVerdict(atLimit) == "ok", "inclusive limit")
  spRejected(atLimit + " ", "oversized surrounding whitespace")
  spRejected(repeat("A", snsCertMaxBytes + 1), "oversized body")
}

test "SNS certificate PEM redacts decoder and DER errors" {
  spRejected(
    "-----BEGIN CERTIFICATE-----\nsecret-value!\n-----END CERTIFICATE-----",
    "base64 error",
  )
  spRejected(pemEncode("CERTIFICATE", []byte(0)), "empty DER")
  spRejected(pemEncode("CERTIFICATE", []byte{ 0x30, 0x00 }), "invalid certificate DER")
}
