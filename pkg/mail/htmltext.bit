// pkg/mail/htmltext.bit — the text/plain alternative of an HTML mail, so a
// message written once as HTML still reads in a text client and does not look
// like a lone-HTML mail to a spam filter.
//
// The markup half is htmltag.bit, the tag table htmlkinds.bit and the character
// references htmlents.bit.
//
// One pass over the bytes, no tree: a tag is read, acted on and forgotten.
// Every byte is looked at a bounded number of times, so the time is linear in
// the input; the output is one growing byte buffer. Nothing fails: markup that
// does not parse becomes text (a stray `<`) or is read the way a browser would
// (a comment or script that never ends runs to the end).
//
// What comes out:
//   * Comments, `<!DOCTYPE>`, `<![CDATA[..]]>` and `<?..>` are skipped, and so
//     is the content of `<script>`, `<style>`, `<title>` and `<head>`.
//   * Whitespace (HTML's five bytes) collapses to one space; a space is kept
//     only between two words, never at a line's edge.
//   * A block-level element (the "display: block" list of the WHATWG
//     rendering section, htmlkinds.bit) starts and ends a line. `<p>`, a
//     heading and `<blockquote>` also leave a blank line. Blank lines never
//     pile up, and nothing leads or trails the text. Headings keep their case.
//   * `<li>` starts with `- `. `<td>` and `<th>` are separated by a space.
//   * `<a href="u">label</a>` is `label (u)`, or `u` when the label is empty or
//     equal; `mailto:` shows the bare address. `<img alt="x">` is `x`.
//   * Character references are decoded (htmlents.bit).
//   * Lines are never re-wrapped; std/smtp's encoder handles a long one.
//
// A tag cut off by the end of the input (`<a href="x`) cannot be told from
// text, so from its `<` on the rest of the input is text.

const bang: u8 = 33
const slash: u8 = 47
const question: u8 = 63
const newline: u8 = 10
const dash: u8 = 45

// The conversion in progress: the output, what is owed to it, and the link or
// attribute being read.
class Conv {
  html: string,
  out: []byte,
  // Line breaks owed before the next text: 0 none, 1 a line, 2 a blank line.
  brk: int,
  // A space owed before the next text.
  sp: bool,
  // Where the open link's label starts in `out`, or -1 with no link open.
  linkAt: int,
  href: string,
  // The wanted attribute of the tag being read, decoded.
  val: string,
  ref: Ref,
}

fn newConv(html: string): Conv {
  return Conv{
    html = html,
    out = [],
    brk = 0,
    sp = false,
    linkAt = -1,
    href = "",
    val = "",
    ref = Ref{ cp = 0, next = 0 },
  }
}

// HTML's ASCII whitespace: tab, LF, FF, CR, space.
fn isHtmlSpace(c: u8): bool {
  return c == space || c == tab || c == newline || c == u8(12) || c == u8(13)
}

fn isAlpha(c: u8): bool {
  return (c >= u8(65) && c <= u8(90)) || (c >= u8(97) && c <= u8(122))
}

// `c` in lowercase when it is an ASCII capital.
fn lowerByte(c: u8): u8 {
  if (c >= u8(65) && c <= u8(90)) {
    return c + u8(32)
  }
  return c
}

// Whether `s[at:]` starts with `pat`, exactly.
fn matchAt(s: string, at: int, pat: string): bool {
  if (at + len(pat) > len(s)) {
    return false
  }
  let k = 0
  while (k < len(pat)) {
    if (s[at + k] != pat[k]) {
      return false
    }
    k = k + 1
  }
  return true
}

// The index of the first `pat` in `s` at or after `from`, or -1.
fn findStr(s: string, from: int, pat: string): int {
  let i = from
  while (i + len(pat) <= len(s)) {
    if (matchAt(s, i, pat)) {
      return i
    }
    i = i + 1
  }
  return -1
}

// Whether `s[a:b]` is `lower` (lowercase), whatever the case in `s`.
fn eqFold(s: string, a: int, b: int, lower: string): bool {
  if (b - a != len(lower)) {
    return false
  }
  let k = 0
  while (k < len(lower)) {
    if (lowerByte(s[a + k]) != lower[k]) {
      return false
    }
    k = k + 1
  }
  return true
}

// Owes at least `n` line breaks before the next text.
fn setBreak(c: Conv, n: int) {
  if (c.brk < n) {
    c.brk = n
  }
}

// Pays what is owed. Nothing is written at the start of the output, a space
// never follows a line break or another space, and a line break wins over a
// space.
fn flush(c: Conv) {
  if (c.brk == 0 && !c.sp) {
    return
  }
  let n = len(c.out)
  if (n > 0 && c.brk > 0) {
    let k = 0
    while (k < c.brk) {
      c.out = append(c.out, newline)
      k = k + 1
    }
  } else if (n > 0 && c.sp && c.out[n - 1] != space && c.out[n - 1] != newline) {
    c.out = append(c.out, space)
  }
  c.brk = 0
  c.sp = false
}

fn putByte(c: Conv, b: u8) {
  flush(c)
  c.out = append(c.out, b)
}

// `cp`, a Unicode scalar value, as UTF-8.
fn utf8String(cp: int): string {
  let b: []byte = []
  if (cp < 0x80) {
    b = append(b, u8(cp))
  } else if (cp < 0x800) {
    b = append(b, u8(0xC0 | (cp >> 6)))
    b = append(b, u8(0x80 | (cp & 0x3F)))
  } else if (cp < 0x10000) {
    b = append(b, u8(0xE0 | (cp >> 12)))
    b = append(b, u8(0x80 | ((cp >> 6) & 0x3F)))
    b = append(b, u8(0x80 | (cp & 0x3F)))
  } else {
    b = append(b, u8(0xF0 | (cp >> 18)))
    b = append(b, u8(0x80 | ((cp >> 12) & 0x3F)))
    b = append(b, u8(0x80 | ((cp >> 6) & 0x3F)))
    b = append(b, u8(0x80 | (cp & 0x3F)))
  }
  return string(b)
}

// A decoded character: whitespace collapses like typed whitespace.
fn putCp(c: Conv, cp: int) {
  if (cp < 0x80 && isHtmlSpace(u8(cp))) {
    c.sp = true
    return
  }
  flush(c)
  c.out = append(c.out, utf8String(cp))
}

// `s` as text: whitespace collapsed, other bytes as they are.
fn putString(c: Conv, s: string) {
  let i = 0
  while (i < len(s)) {
    if (isHtmlSpace(s[i])) {
      c.sp = true
    } else {
      putByte(c, s[i])
    }
    i = i + 1
  }
}

// One unit of text at `i`, which is not `<` unless the caller means it as text:
// a character reference, a whitespace byte or any other byte. Returns the
// index after it.
fn textUnit(c: Conv, i: int): int {
  let b = c.html[i]
  if (b == refAmp && charRef(c.html, i, false, c.ref)) {
    putCp(c, c.ref.cp)
    return c.ref.next
  }
  if (isHtmlSpace(b)) {
    c.sp = true
  } else {
    putByte(c, b)
  }
  return i + 1
}

// Everything from `i` on as text, tags and all.
fn restAsText(c: Conv, i: int) {
  while (i < len(c.html)) {
    i = textUnit(c, i)
  }
}

// The index after the next `>` at or after `from`, or the end of the input.
fn skipPastGt(s: string, from: int): int {
  let i = from
  while (i < len(s)) {
    if (s[i] == gt) {
      return i + 1
    }
    i = i + 1
  }
  return len(s)
}

// The index after the comment whose text starts at `from`, or the end of the
// input. `-->` and `--!>` end one; so do the empty forms `<!-->` and `<!--->`.
fn skipComment(s: string, from: int): int {
  if (matchAt(s, from, ">")) {
    return from + 1
  }
  if (matchAt(s, from, "->")) {
    return from + 2
  }
  let i = from
  while (i + 2 < len(s)) {
    if (s[i] == dash && s[i + 1] == dash) {
      if (s[i + 2] == gt) {
        return i + 3
      }
      if (s[i + 2] == bang && matchAt(s, i + 3, ">")) {
        return i + 4
      }
    }
    i = i + 1
  }
  return len(s)
}

// The index after a `<!...>` or `<?...>` construct at `i`.
fn skipDecl(s: string, i: int): int {
  if (matchAt(s, i, "<!--")) {
    return skipComment(s, i + 4)
  }
  if (matchAt(s, i, "<![CDATA[")) {
    let end = findStr(s, i + 9, "]]>")
    if (end < 0) {
      return len(s)
    }
    return end + 3
  }
  return skipPastGt(s, i + 2)
}

// Whether `s[at:]` is the tag name `name` followed by a name boundary.
fn tagNameAt(s: string, at: int, name: string): bool {
  let end = at + len(name)
  if (end > len(s) || !eqFold(s, at, end, name)) {
    return false
  }
  return end == len(s) || isHtmlSpace(s[end]) || s[end] == slash || s[end] == gt
}

// Where the content dropped after `<name ...>` ends: the next `</name`, or for
// `<head>` also the first `<body`, or the end of the input.
fn skipContent(s: string, from: int, name: string, orBody: bool): int {
  let i = from
  while (i < len(s)) {
    if (s[i] == lt) {
      if (matchAt(s, i + 1, "/") && tagNameAt(s, i + 2, name)) {
        return i
      }
      if (orBody && tagNameAt(s, i + 1, "body")) {
        return i
      }
    }
    i = i + 1
  }
  return len(s)
}

// The text/plain alternative of `html`: what a reader sees, as lines. Total: any
// input gives an answer, in time linear in its length.
fn htmlToText(html: string): string {
  let c = newConv(html)
  let i = 0
  while (i < len(html)) {
    if (html[i] == lt) {
      i = markupAt(c, i)
    } else {
      i = textUnit(c, i)
    }
  }
  return string(c.out)
}
