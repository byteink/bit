import { jsonEncode } from "std/json"

const snsTestTopic: string = "arn:aws:sns:us-east-1:123456789012:mail"
const snsTestTime: string = "2026-10-22T00:00:00Z"
const snsTestUrl: string = "https://sns.us-east-1.amazonaws.com/SimpleNotificationService-test.pem"

fn snsTestBody(kind: string, extra: string): string {
  return "{\"Message\":\"line\\n雪\",\"MessageId\":\"delivery-1\",\"Timestamp\":\"" +
    snsTestTime +
    "\",\"TopicArn\":\"" +
    snsTestTopic +
    "\",\"Type\":\"" +
    kind +
    "\",\"SignatureVersion\":\"2\",\"Signature\":\"AQID\",\"SigningCertURL\":\"" +
    snsTestUrl +
    "\"" +
    extra +
    "}"
}

fn snsTestAt(): Timestamp {
  return parseRfc3339(snsTestTime) catch e {
    panic(e.message())
  }
}

fn snsTestEnvelope(body: string): SnsEnvelope {
  return snsEnvelope(body, snsTestTopic, snsTestAt()) catch e {
    panic(e.message())
  }
}

fn snsTestVerdict(body: string, topic: string, at: Timestamp): string {
  snsEnvelope(body, topic, at) catch e {
    match (e) {
      Signature(_) => return "Signature"
      Invalid(_) => return "Invalid"
      _ => return "other"
    }
  }
  return "ok"
}

fn snsTestField(key: string, value: string): string {
  return "," + jsonEncode(Json.JsonString(key)) + ":" + jsonEncode(Json.JsonString(value))
}

test "SNS Notification canonical bytes preserve decoded escapes and exclude absent Subject" {
  let envelope = snsTestEnvelope(snsTestBody("Notification", ""))
  let expected = "Message\nline\n雪\nMessageId\ndelivery-1\nTimestamp\n" +
    snsTestTime +
    "\nTopicArn\n" +
    snsTestTopic +
    "\nType\nNotification\n"
  assert(envelope.canonical == expected, "SNS canonical Notification bytes")
  assert(envelope.version == "2" && envelope.certificate == snsTestUrl)
  assert(len(envelope.signature) == 3 && envelope.signature[2] == 3)
}

test "SNS Subject is signed when present including an empty value" {
  for subject of ["", "subject\n雪"] {
    let envelope = snsTestEnvelope(snsTestBody("Notification", snsTestField("Subject", subject)))
    let expected = "Message\nline\n雪\nMessageId\ndelivery-1\nSubject\n" +
      subject +
      "\nTimestamp\n" +
      snsTestTime +
      "\nTopicArn\n" +
      snsTestTopic +
      "\nType\nNotification\n"
    assert(envelope.canonical == expected, "SNS canonical Subject bytes")
  }
}

test "SNS confirmations sign SubscribeURL and Token in AWS field order" {
  for kind of ["SubscriptionConfirmation", "UnsubscribeConfirmation"] {
    let extra = snsTestField("SubscribeURL", "https://sns.us-east-1.amazonaws.com/?Token=x") +
      snsTestField("Token", "token")
    let envelope = snsTestEnvelope(snsTestBody(kind, extra))
    let expected = "Message\nline\n雪\nMessageId\ndelivery-1\nSubscribeURL\n" +
      "https://sns.us-east-1.amazonaws.com/?Token=x\nTimestamp\n" +
      snsTestTime +
      "\nToken\ntoken\nTopicArn\n" +
      snsTestTopic +
      "\nType\n" +
      kind +
      "\n"
    assert(envelope.canonical == expected, "SNS canonical confirmation bytes")
  }
}

test "SNS URL allowlist admits regional AWS partitions and rejects authority tricks" {
  for host of [
    "sns.us-east-1.amazonaws.com",
    "sns.us-gov-west-1.amazonaws.com",
    "sns.cn-north-1.amazonaws.com.cn",
  ] {
    assert(snsCertificateUrl("https://" + host + "/certificate.pem"), host)
  }
  for url of [
    "http://sns.us-east-1.amazonaws.com/cert.pem",
    "https://evil.example.com/cert.pem", "https://sns.us-east-1.amazonaws.com.evil/cert.pem",
    "https://user@sns.us-east-1.amazonaws.com/cert.pem", "https://sns.us-east-1.amazonaws.com:443/cert.pem",
    "https://sns..amazonaws.com/cert.pem", "https://sns.US-east-1.amazonaws.com/cert.pem",
    "https://sns.us-east-1.amazonaws.com/cert.pem?x=.pem", "https://sns.us-east-1.amazonaws.com/cert.pem#.pem",
    "https://sns.us-east-1.amazonaws.com/cert\n.pem", "https://sns.us-east-1.amazonaws.com/cert\\name.pem",
    "https://sns.us-east-1.amazonaws.com/cert", "https://sns.us-east-1.amazonaws.com@evil.example.com/cert.pem",
  ] {
    assert(!snsCertificateUrl(url), url)
  }
}

test "SNS envelope rejects mismatched topic configuration and duplicate decoded keys" {
  let body = snsTestBody("Notification", "")
  assert(snsTestVerdict(body, "", snsTestAt()) == "Invalid")
  assert(snsTestVerdict(body, "other-topic", snsTestAt()) == "Signature")
  for extra of [
    snsTestField("TopicArn", snsTestTopic),
    ",\"\\u0054opicArn\":\"other\"",
    ",\"Subject\":\"a\",\"Subject\":\"b\"",
  ] {
    assert(snsTestVerdict(snsTestBody("Notification", extra), snsTestTopic, snsTestAt()) == "Signature")
  }
}

test "SNS required fields and supported types stay strict" {
  let data = snsObject(snsTestBody("Notification", "")) catch e {
    panic(e.message())
  }
  for key of [
    "Message",
    "MessageId",
    "Timestamp",
    "TopicArn",
    "Type",
    "Signature",
    "SignatureVersion",
    "SigningCertURL",
  ] {
    let changed = replace(jsonEncode(data), "\"" + key + "\":", "\"missing" + key + "\":")
    assert(snsTestVerdict(changed, snsTestTopic, snsTestAt()) == "Signature", key)
  }
  assert(snsTestVerdict(snsTestBody("Other", ""), snsTestTopic, snsTestAt()) == "Signature")
  assert(
      snsTestVerdict(snsTestBody("SubscriptionConfirmation", ""), snsTestTopic, snsTestAt()) ==
      "Signature",
  )
  for extra of [",\"Subject\":null", ",\"Subject\":123"] {
    assert(snsTestVerdict(snsTestBody("Notification", extra), snsTestTopic, snsTestAt()) == "Signature")
  }
  for body of ["null", "[]", "not-json"] {
    assert(snsTestVerdict(body, snsTestTopic, snsTestAt()) == "Invalid")
  }
}

test "SNS signature metadata accepts v1 and rejects unsupported versions and malformed base64" {
  let body = snsTestBody("Notification", "")
  let v1 = replace(body, "\"SignatureVersion\":\"2\"", "\"SignatureVersion\":\"1\"")
  assert(snsTestEnvelope(v1).version == "1")
  for text of ["\"3\"", "2", "null", "\"\""] {
    let changed = replace(body, "\"SignatureVersion\":\"2\"", "\"SignatureVersion\":" + text)
    assert(snsTestVerdict(changed, snsTestTopic, snsTestAt()) == "Signature")
  }
  for text of ["", "!", "AQID\n", "AB==", repeat("A", 1372)] {
    let changed = replace(body, "\"AQID\"", jsonEncode(Json.JsonString(text)))
    assert(snsTestVerdict(changed, snsTestTopic, snsTestAt()) == "Signature", "signature text")
  }
}

test "SNS contract accepts one hour inclusive and rejects outside either boundary" {
  let body = snsTestBody("Notification", "")
  for delta of [0 - Hour, Hour] {
    assert(snsTestVerdict(body, snsTestTopic, Timestamp{ ns = snsTestAt().ns + delta }) == "ok")
  }
  for delta of [0 - Hour - 1, Hour + 1] {
    assert(snsTestVerdict(body, snsTestTopic, Timestamp{ ns = snsTestAt().ns + delta }) == "Signature")
  }
  for text of ["bad-time", "9999-01-01T00:00:00Z", "1600-01-01T00:00:00Z"] {
    let changed = replace(body, snsTestTime, text)
    assert(snsTestVerdict(changed, snsTestTopic, snsTestAt()) == "Signature")
  }
}

fn sesTestJson(text: string): Json {
  return jsonParse(text) catch e {
    panic(e.message())
  }
}

fn sesTestRecipients(kind: EventKind, text: string): []string {
  return sesPayloadRecipients(kind, sesTestJson(text)) catch e {
    panic(e.message())
  }
}

fn sesTestRecipientError(kind: EventKind, text: string): string {
  sesPayloadRecipients(kind, sesTestJson(text)) catch e {
    match (e) {
      Invalid(why) => return "Invalid: " + why
      _ => return "other"
    }
  }
  return "ok"
}

test "SES payload kind strings map known events and ignore extensions" {
  let names = ["Bounce", "Complaint", "Delivery", "Reject", "DeliveryDelay"]
  let kinds = [
    EventKind.Bounced,
    EventKind.Complained,
    EventKind.Delivered,
    EventKind.Rejected,
    EventKind.Deferred,
  ]
  let i = 0
  while (i < len(names)) {
    let kind = sesPayloadKind(names[i])
    assert(isSome(kind) && unwrap(kind) == kinds[i], names[i])
    i = i + 1
  }
  for name of ["", "bounce", "Send", "NewEvent"] {
    assert(!isSome(sesPayloadKind(name)), name)
  }
}

test "SES payload selects reported recipients in order without destination fallback" {
  let objects = "[{\"emailAddress\":\"b@example.test\"},{\"emailAddress\":\"a@example.test\"},{\"emailAddress\":\"b@example.test\"}]"
  let strings = "[\"b@example.test\",\"a@example.test\",\"b@example.test\"]"
  let data = sesTestJson(
      "{\"bounce\":{\"bounceType\":\"Permanent\",\"bouncedRecipients\":" +
      objects +
      "}," +
      "\"complaint\":{\"complainedRecipients\":" +
      objects +
      "}," +
      "\"delivery\":{\"recipients\":" +
      strings +
      "}," +
      "\"deliveryDelay\":{\"delayedRecipients\":" +
      objects +
      "}," +
      "\"mail\":{\"destination\":[\"unrelated@example.test\"]},\"future\":true}",
  )
  for kind of [EventKind.Bounced, EventKind.Complained, EventKind.Delivered, EventKind.Deferred] {
    let recipients = sesPayloadRecipients(kind, data) catch e {
      panic(e.message())
    }
    assert(len(recipients) == 3, "SES reported recipient count")
    assert(
        recipients[0] == "b@example.test" &&
        recipients[1] == "a@example.test" &&
        recipients[2] == "b@example.test",
      "SES reported recipient order",
    )
  }
  let rejected = sesPayloadRecipients(EventKind.Rejected, data) catch e {
    panic(e.message())
  }
  assert(len(rejected) == 1 && rejected[0] == "unrelated@example.test")
  assert(sesPayloadPermanent(EventKind.Bounced, data))
  let two = sesTestRecipients(
    EventKind.Bounced,
    "{\"bounce\":{\"bounceType\":\"Permanent\",\"bouncedRecipients\":[{\"emailAddress\":\"a@example.test\"},{\"emailAddress\":\"b@example.test\"}]}}",
  )
  assert(len(two) == 2 && two[0] == "a@example.test" && two[1] == "b@example.test")
}

test "SES payload accepts empty lists and does not inspect unrelated event kinds" {
  let data = sesTestJson("{\"bounce\":{\"bouncedRecipients\":[]},\"complaint\":{\"complainedRecipients\":[]},\"delivery\":{\"recipients\":[]},\"deliveryDelay\":{\"delayedRecipients\":[]},\"mail\":{\"destination\":[]}}")
  for kind of [
    EventKind.Bounced,
    EventKind.Complained,
    EventKind.Delivered,
    EventKind.Rejected,
    EventKind.Deferred,
    EventKind.Opened,
  ] {
    let recipients = sesPayloadRecipients(kind, data) catch e {
      panic(e.message())
    }
    assert(len(recipients) == 0)
  }
}

fn sesTestMalformed(kind: EventKind, owner: string, key: string, element: string) {
  let fallback = "\"mail\":{\"destination\":[\"unrelated@example.test\"]}"
  for body of ["{}", "null", "{\"" + owner + "\":null}", "{\"" + owner + "\":{}}"] {
    assert(sesTestRecipientError(kind, body) == "Invalid: SES recipient list is invalid")
  }
  for value of [
    "null",
    "{}",
    "123",
    "[null]",
    "[\"\"]",
    "[{}]",
    "[{\"emailAddress\":123}]",
    element,
  ] {
    let body = "{\"" + owner + "\":{\"" + key + "\":" + value + "}"
    if (owner != "mail") {
      body = body + "," + fallback
    }
    assert(
      sesTestRecipientError(kind, body + "}") == "Invalid: SES recipient list is invalid",
      "SES malformed list is redacted",
    )
  }
}

test "SES payload malformed reported lists fail redacted Invalid without fallback" {
  sesTestMalformed(
    EventKind.Bounced,
    "bounce",
    "bouncedRecipients",
    "[{\"emailAddress\":\"secret@example.test\"},{}]",
  )
  sesTestMalformed(
    EventKind.Complained,
    "complaint",
    "complainedRecipients",
    "[\"secret@example.test\"]",
  )
  sesTestMalformed(
    EventKind.Delivered,
    "delivery",
    "recipients",
    "[{\"emailAddress\":\"secret@example.test\"}]",
  )
  sesTestMalformed(
    EventKind.Rejected,
    "mail",
    "destination",
    "[{\"emailAddress\":\"secret@example.test\"}]",
  )
  sesTestMalformed(
    EventKind.Deferred,
    "deliveryDelay",
    "delayedRecipients",
    "[\"secret@example.test\"]",
  )
}

test "SES payload permanence is limited to Permanent bounces" {
  for name of ["Permanent", "Transient", "Undetermined", "", "permanent"] {
    let data = sesTestJson("{\"bounce\":{\"bounceType\":\"" + name + "\"}}")
    assert(sesPayloadPermanent(EventKind.Bounced, data) == (name == "Permanent"))
    for kind of [EventKind.Complained, EventKind.Delivered, EventKind.Rejected, EventKind.Deferred] {
      assert(!sesPayloadPermanent(kind, data))
    }
  }
  for text of ["{}", "{\"bounce\":{}}", "{\"bounce\":null}", "{\"bounce\":{\"bounceType\":123}}"] {
    assert(!sesPayloadPermanent(EventKind.Bounced, sesTestJson(text)))
  }
}
