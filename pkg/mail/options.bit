// pkg/mail/options.bit — `Options`, what a `Mailer` is set up with. Every field
// has a default, so `Options{}` is a valid setup and a program names only what
// it changes. The checks run in `Mailer(...)` (`checkOptions`, below), so a
// mistake here fails when the program starts and not on its first send.

import { Second } from "std/time"

// How a `Mailer` behaves. Later parts of this package add their fields here.
export class Options {
  // The sender for a message that sets no `from`, `Inkwell <hello@inkwell.dev>`.
  // Empty means every message must name its own.
  export from: string = "",
  // The Reply-To for a message that sets no `replyTo`. Empty means none.
  export replyTo: string = "",
  // How long one delivery may take, in nanoseconds (`std/time`'s `Second` is
  // one second of them). It must be positive. A transport that talks to a
  // network enforces it; `Outbox` never waits, so it ignores it.
  export timeout: int = 30 * Second,
  // The DKIM identities every message is signed with (RFC 6376). Keys are
  // loaded once by `Mailer(...)`; see `Dkim` and docs/dkim.md. Give an RSA key
  // of 2048 bits or more; an Ed25519 key (RFC 8463) is added beside it, never
  // alone. Each `d=` must align with the domain of `from`, or of the message's
  // own From. Empty means unsigned. A transport that builds the message at the
  // provider (a JSON API) refuses a non-empty list.
  export dkim: []Dkim = [],
}

// `parseAddress` of `s` with a refusal reported as a `Config` naming `field`.
fn checkAddress(field: string, s: string): ()!MailError {
  parseAddress(s) catch e {
    match (e) {
      Invalid(why) => fail MailError.Config("${field}: ${why}")
      _ => fail e
    }
  }
}

// Refuses an `Options` that cannot work, with a `MailError.Config` naming the
// field. Empty `from` and `replyTo` are valid: they mean "not set".
fn checkOptions(o: Options): ()!MailError {
  if (o.from != "") {
    checkAddress("Options.from", o.from)?
  }
  if (o.replyTo != "") {
    checkAddress("Options.replyTo", o.replyTo)?
  }
  if (o.timeout <= 0) {
    fail MailError.Config("Options.timeout must be positive, got ${o.timeout}")
  }
}
