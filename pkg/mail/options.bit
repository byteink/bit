// pkg/mail/options.bit — `Options`, what a `Mailer` is set up with. Every field
// has a default, so `Options{}` is a valid setup and a program names only what
// it changes. The checks run in `Mailer(...)` (`checkOptions`, below), so a
// mistake here fails when the program starts and not on its first send.

import { Second } from "std/time"

// How a `Mailer` behaves. Later parts of this package add their fields here.
export class Options {
  // The sender for a message that sets no `from`, `Inkwell <hello@inkwell.dev>`.
  // Empty means every message must name its own.
  export from: string = "",
  // The Reply-To for a message that sets no `replyTo`. Empty means none.
  export replyTo: string = "",
  // How long one delivery may take, in nanoseconds (`std/time`'s `Second` is
  // one second of them). It must be positive. A transport that talks to a
  // network enforces it; `Outbox` never waits, so it ignores it.
  export timeout: int = 30 * Second,
  // The DKIM identities every message is signed with (RFC 6376). Keys are
  // loaded once by `Mailer(...)`; see `Dkim` and docs/dkim.md. Give an RSA key
  // of 2048 bits or more; an Ed25519 key (RFC 8463) is added beside it, never
  // alone. Each `d=` must align with the domain of `from`, or of the message's
  // own From. Empty means unsigned. A transport that builds the message at the
  // provider (a JSON API) refuses a non-empty list.
  export dkim: []Dkim = [],
  // How a delivery the server only postponed (`MailError.Transient`) is
  // repeated; see `Retry` and docs/retry.md. `Retry{ attempts = 1 }` never
  // repeats.
  export retry: Retry = Retry{},
  // The most messages a second this `Mailer` delivers, however many tasks send
  // through it. A send waits its turn, never longer than `timeout`, and then
  // fails `Transient`. 0, the default, is no cap; the highest is 1000000.
  export rate: int = 0,
  // The most SMTP sessions a `Mailer` holds open to its server, 1 to 100. Each
  // is logged in once and carries many mails one after another, so a run of
  // ten thousand mails is not ten thousand logins; `Mailer.send` calls from
  // many tasks share them and one that finds all busy waits, never longer than
  // `timeout`. 1 keeps one session, reused. A transport that is not SMTP
  // ignores it. See docs/pool.md.
  export pool: int = 4,
  // For staging: every mail is delivered to this one address, `QA <qa@inkwell.dev>`,
  // and to nobody else. To, Cc and Bcc are never delivered to; the To and Cc
  // lines stay as written and `X-Original-To` lists them, and the Subject starts
  // with `[redirected] `. A Bcc address appears in no header. Empty means mail
  // goes where it says. See docs/redirect.md.
  export redirect: string = "",
}

// The highest `Options.pool`. A provider that lets one login hold more
// connections than this does not exist; a larger number is a typo.
const maxPool: int = 100

// `parseAddress` of `s` with a refusal reported as a `Config` naming `field`.
fn checkAddress(field: string, s: string): ()!MailError {
  parseAddress(s) catch e {
    match (e) {
      Invalid(why) => fail MailError.Config("${field}: ${why}")
      _ => fail e
    }
  }
}

// The bare address of `o.redirect`, "" when it is not set. `checkOptions` has
// already accepted it.
fn redirectEmail(o: Options): string {
  if (o.redirect == "") {
    return ""
  }
  let a = parseAddress(o.redirect) catch _ {
    return ""
  }
  return a.email
}

// Refuses an `Options` that cannot work, with a `MailError.Config` naming the
// field. Empty `from`, `replyTo` and `redirect` are valid: they mean "not set".
fn checkOptions(o: Options): ()!MailError {
  if (o.from != "") {
    checkAddress("Options.from", o.from)?
  }
  if (o.replyTo != "") {
    checkAddress("Options.replyTo", o.replyTo)?
  }
  if (o.redirect != "") {
    checkAddress("Options.redirect", o.redirect)?
  }
  if (o.timeout <= 0) {
    fail MailError.Config("Options.timeout must be positive, got ${o.timeout}")
  }
  checkRetry(o)?
  if (o.pool < 1 || o.pool > maxPool) {
    fail MailError.Config("Options.pool must be 1 to ${maxPool} sessions, got ${o.pool}")
  }
}
