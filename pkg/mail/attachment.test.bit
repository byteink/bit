// pkg/mail/attachment.test.bit — `Attachment`: reading a file, the MIME type
// table, how attachments render (downloads and inline images), the five checks
// that tie `cid`s to the HTML each with its own message, and the 25 MiB limit.

import { remove, writeFile } from "std/fs"
import { envOr } from "std/os"
import { contains, indexOf } from "std/strings"

fn atMessage(html: string, files: []Attachment): Message {
  return Message{
    from = "Inkwell <hello@inkwell.dev>",
    to = ["Sara Ali <sara@example.com>"],
    subject = "Your invoice",
    text = "See the attachment.",
    html = html,
    attachments = files,
  }
}

fn atNoDefaults(): Defaults {
  return Defaults{ from = "", replyTo = [] }
}

// "ok" for a message that renders, else the refusal's text.
fn atVerdict(m: Message): string {
  renderMessage(m, atNoDefaults()) catch e {
    return e.message()
  }
  return "ok"
}

// "ok" for a file that loads, else the refusal's text.
fn atFileVerdict(path: string): string {
  Attachment.file(path) catch e {
    return e.message()
  }
  return "ok"
}

// "ok" when `checkAttachments` takes `m`, else the refusal's text.
fn atChecked(m: Message): string {
  checkAttachments(m) catch e {
    return e.message()
  }
  return "ok"
}

fn atRendered(m: Message): string {
  let r = renderMessage(m, atNoDefaults()) catch e {
    panic("unexpected refusal: ${e.message()}")
  }
  return r.data
}

fn atLogo(cid: string): Attachment {
  return Attachment{ name = "logo.png", data = [u8(137), u8(80), u8(78), u8(71)], cid = cid }
}

fn atScratch(name: string): string {
  return "${envOr("TMPDIR", "/tmp")}/bit-mail-attach-${timeUnixNs()}-${name}"
}

test "Attachment.file reads the bytes, names the file and types .PDF" {
  let path = atScratch("Invoice-7.PDF")
  writeFile(path, "%PDF-1.7\n") catch e {
    panic("write: ${e.message()}")
  }
  let a = Attachment.file(path) catch e {
    panic("file: ${e.message()}")
  }
  remove(path) catch e {
    panic("remove: ${e.message()}")
  }
  assert(contains(a.name, "Invoice-7.PDF") && !contains(a.name, "/"), "name ${a.name}")
  assert(a.contentType == "application/pdf", "type ${a.contentType}")
  assert(a.cid == "", "cid ${a.cid}")
  assert(len(a.data) == 9 && a.data[0] == u8(37) && a.data[8] == u8(10), "bytes ${len(a.data)}")
}

test "Attachment.file with a cid makes it inline" {
  let path = atScratch("logo.png")
  writeFile(path, "png") catch e {
    panic("write: ${e.message()}")
  }
  let a = Attachment.file(path, "logo") catch e {
    panic("file: ${e.message()}")
  }
  remove(path) catch e {
    panic("remove: ${e.message()}")
  }
  assert(a.cid == "logo" && a.contentType == "image/png", "cid ${a.cid} type ${a.contentType}")
}

test "Attachment.file of a missing file names the path" {
  let path = atScratch("missing.pdf")
  let why = atFileVerdict(path)
  assert(contains(why, "mail: attachment ${path}: "), why)
}

test "Attachment.file refuses a path holding a line break" {
  let why = atFileVerdict("a\r\nb.pdf")
  assert(why == "mail: attachment \"a\\r\\nb.pdf\": the path contains a CR, LF or NUL", why)
}

test "the type table, by extension in any case" {
  let want = [
    "a.pdf application/pdf",
    "a.PNG image/png",
    "a.jpg image/jpeg",
    "a.jpeg image/jpeg",
    "a.gif image/gif",
    "a.webp image/webp",
    "a.svg image/svg+xml",
    "a.ics text/calendar",
    "a.csv text/csv",
    "a.txt text/plain",
    "a.html text/html",
    "a.json application/json",
    "a.xml application/xml",
    "a.zip application/zip",
    "a.tar.gz application/gzip",
    "a.doc application/msword",
    "a.docx application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    "a.xls application/vnd.ms-excel",
    "a.xlsx application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    "a.ppt application/vnd.ms-powerpoint",
    "a.pptx application/vnd.openxmlformats-officedocument.presentationml.presentation",
    "a.odt application/vnd.oasis.opendocument.text",
    "a.ods application/vnd.oasis.opendocument.spreadsheet",
    "a.mp3 audio/mpeg",
    "a.mp4 video/mp4",
    "a.wav audio/vnd.wave",
    "a.eml message/rfc822",
    "a.bin application/octet-stream",
    "README application/octet-stream",
    "a. application/octet-stream",
  ]
  for line of want {
    let sp = indexOf(line, " ")
    let got = guessType(line[0:sp])
    assert(got == line[sp + 1:], "${line[0:sp]}: ${got}")
  }
}

test "a download renders multipart/mixed with its type, name and base64" {
  let pdf = Attachment{ name = "invoice.pdf", data = [u8(1), u8(2), u8(3)] }
  let data = atRendered(atMessage("", [pdf]))
  assert(contains(data, "Content-Type: multipart/mixed"), data)
  assert(contains(data, "Content-Type: application/pdf; name=\"invoice.pdf\"\r\n"), data)
  assert(contains(data, "Content-Disposition: attachment; filename=\"invoice.pdf\"\r\n"), data)
  assert(
    contains(
      data,
      "Content-Transfer-Encoding: base64\r\nContent-Disposition: attachment; filename=\"invoice.pdf\"\r\n\r\nAQID\r\n",
    ),
    data,
  )
}

test "an explicit type wins over the extension" {
  let a = Attachment{ name = "data.bin", data = [u8(1)], contentType = "application/x-invoice" }
  assert(contains(atRendered(atMessage("", [a])), "Content-Type: application/x-invoice;"), "type")
}

test "a cid attachment renders inline in a multipart/related with its Content-ID" {
  let data = atRendered(atMessage("<p><img src=\"cid:logo\"></p>", [atLogo("logo")]))
  assert(contains(data, "Content-Type: multipart/related"), data)
  assert(contains(data, "Content-ID: <logo>\r\n"), data)
  assert(contains(data, "Content-Disposition: inline; filename=\"logo.png\"\r\n"), data)
  assert(contains(data, "Content-Type: image/png; name=\"logo.png\"\r\n"), data)
}

test "an inline image and a download travel together" {
  let pdf = Attachment{ name = "invoice.pdf", data = [u8(1)] }
  let data = atRendered(atMessage("<img src='cid:logo'>", [atLogo("logo"), pdf]))
  assert(contains(data, "Content-ID: <logo>\r\n"), data)
  assert(contains(data, "Content-Disposition: attachment; filename=\"invoice.pdf\"\r\n"), data)
}

test "a cid reference is found in CSS, unquoted, in any case, and percent-encoded" {
  let cid = Attachment{ name = "a.png", data = [u8(1)], cid = "a@b.c" }
  assert(
    atVerdict(atMessage("<div style=\"background:url(cid:a@b.c)\"></div>", [cid])) == "ok",
    "css",
  )
  assert(atVerdict(atMessage("<img src=cid:a@b.c>", [cid])) == "ok", "unquoted")
  assert(atVerdict(atMessage("<IMG SRC=\"CID:a@b.c\">", [cid])) == "ok", "case")
  assert(atVerdict(atMessage("<img src=\"cid:a%40b.c\">", [cid])) == "ok", "percent")
}

test "check 1: a cid attachment with no html" {
  let why = atVerdict(atMessage("", [atLogo("logo")]))
  assert(
    why == "mail: attachments[0]: cid \"logo\" is inline and the message has no html to show it in",
    why,
  )
}

test "check 2: an html cid reference with no attachment behind it" {
  let why = atVerdict(atMessage("<img src=\"cid:logo\"><img src=\"cid:hero\">", [atLogo("logo")]))
  assert(
    why == "mail: html: refers to cid:\"hero\" and no attachment has that cid; set Attachment.cid",
    why,
  )
}

test "check 2: a reference with no attachments at all" {
  let why = atVerdict(atMessage("<img src=\"cid:logo\">", []))
  assert(contains(why, "refers to cid:\"logo\""), why)
}

test "check 3: a cid attachment the html never references" {
  let why = atVerdict(atMessage("<p>Hello</p>", [atLogo("logo")]))
  assert(
      why ==
      "mail: attachments[0]: cid \"logo\" is never referenced: write cid:logo in the html, or clear Attachment.cid",
    why,
  )
}

test "check 3: a word ending in cid is not a reference" {
  let why = atVerdict(atMessage("<p>an acid:logo test</p>", [atLogo("logo")]))
  assert(contains(why, "is never referenced"), why)
}

test "check 4: a duplicate cid" {
  let two = [atLogo("logo"), atLogo("logo")]
  let why = atVerdict(atMessage("<img src=\"cid:logo\">", two))
  assert(why == "mail: attachments[1]: duplicate cid \"logo\", already on attachments[0]", why)
}

test "check 5: an empty name" {
  let a = Attachment{ name = "", data = [u8(1)] }
  assert(atVerdict(atMessage("", [a])) == "mail: attachments[0]: name is empty", "name")
}

test "check 5: empty data" {
  let a = Attachment{ name = "a.pdf", data = [] }
  let why = atVerdict(atMessage("", [Attachment{ name = "ok.pdf", data = [u8(1)] }, a]))
  assert(why == "mail: attachments[1]: data is empty (\"a.pdf\" has no bytes)", why)
}

test "a line break in the name, type or cid is refused" {
  let n = Attachment{ name = "a\r\nBcc: x", data = [u8(1)] }
  assert(
    contains(atVerdict(atMessage("", [n])), "attachments[0]: name contains a CR, LF or NUL"),
    "name",
  )
  let t = Attachment{ name = "a", data = [u8(1)], contentType = "x/y\nz" }
  assert(contains(atVerdict(atMessage("", [t])), "attachments[0]: contentType contains"), "type")
  let c = Attachment{ name = "a", data = [u8(1)], cid = "x\ny" }
  assert(
    contains(atVerdict(atMessage("<img src=\"cid:x\">", [c])), "attachments[0]: cid contains"),
    "cid",
  )
}

test "attachments over 25 MiB are refused, in total" {
  let a = Attachment{ name = "a.bin", data = []byte(13 * mib) }
  let b = Attachment{ name = "b.bin", data = []byte(13 * mib) }
  let why = atVerdict(atMessage("", [a, b]))
  assert(why == "mail: attachments total 26 MiB; most providers refuse more than 25 MiB", why)
}

test "exactly 25 MiB passes the check and one byte more does not" {
  let at = atMessage("", [Attachment{ name = "a.bin", data = []byte(25 * mib) }])
  assert(atChecked(at) == "ok", atChecked(at))
  let over = atMessage("", [Attachment{ name = "a.bin", data = []byte(25 * mib + 1) }])
  let why = atChecked(over)
  assert(why == "mail: attachments total 26 MiB; most providers refuse more than 25 MiB", why)
}
