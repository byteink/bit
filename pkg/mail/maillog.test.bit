// pkg/mail/maillog.test.bit — `Options.logger`: the INFO `mail sent`, WARN
// `mail retry`, ERROR `mail failed` and WARN `mail refused` records over a
// capture sink, and that no record holds an address, a subject or a body, not
// even one a server's reply or a refusal echoes.
//
// `ObScript`, `obMessage`, `obMailer` and `obRetry` are observe.test.bit's.
// `TextHandler` and `LevelDebug` are bound here for the module's other test
// files; `Logger`, `LevelWarn` and `LevelError` by maillog.bit.

import { TextHandler, LevelDebug } from "std/log"

// A std/log `Sink` that keeps each finished record, trailing newline dropped.
class LgSink {
  lines: []string
  export write(s: string): ()! {
    this.lines = append(this.lines, trimRight(s, "\n"))
  }
}

fn lgSink(): LgSink {
  return LgSink{ lines = []string(0) }
}

// A text handler without timestamps, so a record reads back byte for byte.
fn lgLogger(sink: LgSink, level: int): Logger {
  return Logger(TextHandler(sink, level, false))
}

fn lgOptions(sink: LgSink): Options {
  return Options{ retry = obRetry, logger = Option.Some(lgLogger(sink, LevelDebug)) }
}

// Everything the sink got, as one string.
fn lgAll(sink: LgSink): string {
  return join(sink.lines, "\n")
}

// The records are about the mail and never in it: none of the message's three
// private strings, nor the domain of its recipient, is in `all`.
fn lgNoSecrets(all: string) {
  for secret of ["sara@example.com", "Sara", "example.com", "Welcome to Inkwell", "Hello Sara"] {
    assert(!contains(all, secret), "${secret} is in the log:\n${all}")
  }
}

test "a send writes one INFO mail sent line with the scheme, the recipient count and the duration" {
  let sink = lgSink()
  let m = obMailer(Outbox(), lgOptions(sink))
  obSend(m)
  assert(len(sink.lines) == 1, "want one record, got:\n${lgAll(sink)}")
  let want = "level=INFO msg=\"mail sent\" transport=outbox recipients=1 took="
  assert(hasPrefix(sink.lines[0], want), "got ${sink.lines[0]}")
  lgNoSecrets(lgAll(sink))
}

test "a failing transport writes one ERROR mail failed line, and the reply's address is gone" {
  let sink = lgSink()
  let reply = Reply{
    code = 550,
    enhanced = "5.1.1",
    text = "<sara@example.com>: Recipient address rejected",
  }
  let m = obMailer(ObScript([MailError.Rejected(reply)]), lgOptions(sink))
  obSend(m)
  let want = "level=ERROR msg=\"mail failed\" transport=custom error=\"mail: rejected: 550 5.1.1 <[address]>: Recipient address rejected\""
  assert(len(sink.lines) == 1, "want one record, got:\n${lgAll(sink)}")
  assert(sink.lines[0] == want, "got ${sink.lines[0]}")
  lgNoSecrets(lgAll(sink))
}

test "a retried send writes a WARN mail retry line, then INFO mail sent" {
  let sink = lgSink()
  let slow = MailError.Transient(
    Reply{ code = 451, enhanced = "4.7.1", text = "Greylisted, try again" },
  )
  let m = obMailer(ObScript([slow]), lgOptions(sink))
  obSend(m)
  assert(len(sink.lines) == 2, "want two records, got:\n${lgAll(sink)}")
  let retry = "level=WARN msg=\"mail retry\" transport=custom attempt=1 error=\"mail: temporary failure: 451 4.7.1 Greylisted, try again\""
  assert(sink.lines[0] == retry, "got ${sink.lines[0]}")
  assert(
    hasPrefix(sink.lines[1], "level=INFO msg=\"mail sent\" transport=custom recipients=1 took="),
    "got ${sink.lines[1]}",
  )
}

test "a send that fails after its retries writes a retry line per repeat and one mail failed line" {
  let sink = lgSink()
  let slow = MailError.Transient(Reply{ code = 451, text = "busy" })
  let m = obMailer(ObScript([slow, slow, slow]), lgOptions(sink))
  obSend(m)
  assert(len(sink.lines) == 3, "want three records, got:\n${lgAll(sink)}")
  assert(
    contains(sink.lines[0], "msg=\"mail retry\" transport=custom attempt=1 "),
    "got ${sink.lines[0]}",
  )
  assert(
    contains(sink.lines[1], "msg=\"mail retry\" transport=custom attempt=2 "),
    "got ${sink.lines[1]}",
  )
  assert(
    hasPrefix(sink.lines[2], "level=ERROR msg=\"mail failed\" transport=custom error="),
    "got ${sink.lines[2]}",
  )
}

test "a message refused before any transport writes a WARN mail refused line" {
  let sink = lgSink()
  let m = obMailer(Outbox(), lgOptions(sink))
  m.send(Message{ to = ["Sara Ali <sara@example.com>"], subject = "", text = "Hello Sara." }) catch _ {}
  let want = "level=WARN msg=\"mail refused\" transport=outbox reason=\"mail: Message.subject is empty\""
  assert(len(sink.lines) == 1, "want one record, got:\n${lgAll(sink)}")
  assert(sink.lines[0] == want, "got ${sink.lines[0]}")
}

test "a refused address is not in the mail refused line, with or without an @" {
  for bad of ["sara@@example.com", "sara example"] {
    let sink = lgSink()
    let m = obMailer(Outbox(), lgOptions(sink))
    m.send(Message{ to = [bad], subject = "Welcome to Inkwell", text = "Hello Sara." }) catch _ {}
    assert(len(sink.lines) == 1, "want one record for ${bad}, got:\n${lgAll(sink)}")
    assert(
      hasPrefix(sink.lines[0], "level=WARN msg=\"mail refused\" transport=outbox reason="),
      "got ${sink.lines[0]}",
    )
    assert(contains(sink.lines[0], "[address]"), "got ${sink.lines[0]}")
    lgNoSecrets(lgAll(sink))
  }
}

test "a logger alone turns the observer on, and no logger wraps no transport" {
  let sink = lgSink()
  let on = obMailer(Outbox(), lgOptions(sink))
  let (_, wrapped) = on.t.(Observed)
  assert(wrapped, "Options.logger alone must wrap the transport")
  let off = obMailer(Outbox(), Options{})
  let (_, offWrapped) = off.t.(Observed)
  assert(!offWrapped, "no logger, metrics or tracer must wrap nothing")
}

test "a logger whose level is above a record's writes nothing for it" {
  let sink = lgSink()
  let o = Options{ logger = Option.Some(lgLogger(sink, LevelError)) }
  let m = obMailer(Outbox(), o)
  obSend(m)
  m.send(Message{ to = ["sara@example.com"], subject = "", text = "x" }) catch _ {}
  assert(len(sink.lines) == 0, "want nothing at ERROR, got:\n${lgAll(sink)}")
}

test "redactAddresses replaces each word that holds an @ and keeps the rest" {
  assert(redactAddresses("550 <a@b.example>: no such user") == "550 <[address]>: no such user")
  assert(redactAddresses("to a@b.example, c@d.example; ok") == "to [address], [address]; ok")
  assert(redactAddresses("no address here") == "no address here")
  assert(redactAddresses("") == "")
  assert(redactAddresses("@") == "[address]")
}

test "redactEcho takes the whole quoted input of a refused address, escapes and all" {
  assert(redactEcho("invalid address \"a b\": whitespace") == "invalid address [address]: whitespace")
  assert(redactEcho("invalid address \"a\\\"b\": x") == "invalid address [address]: x")
  assert(redactEcho("invalid address \"long...\": x") == "invalid address [address]: x")
  assert(redactEcho("invalid address \"cut") == "invalid address [address]")
  assert(redactEcho("invalid address \"back\\") == "invalid address [address]")
  assert(redactEcho("Message.subject is empty") == "Message.subject is empty")
}
