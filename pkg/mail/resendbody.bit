// pkg/mail/resendbody.bit — the JSON a `resend://` transport posts to Resend's
// `POST /emails` (https://resend.com/docs/api-reference/emails/send-email):
// one object with `from`, `to`, `cc`, `bcc`, `reply_to`, `subject`, `text`,
// `html`, `headers`, `attachments` and `tags`, in that order, a field left out
// when it is empty.
//
// Resend builds the MIME message itself, so this file maps fields and never
// bytes: `Delivery.raw` is not sent. What the SMTP path gets from the renderer
// is reproduced from the same functions, so both transports agree on it: the
// text part made from the HTML (`textBody`), the threading and `Auto-Submitted`
// headers (`extraFields`), the attachment type (`guessType`).

import { Json, JsonEntry, jsonEncode } from "std/json"
import { encodeBase64 } from "std/crypto"
import { keys } from "std/seq"
import { sorted } from "std/sort"

// Tag names and values: letters, digits, `_` and `-`, up to this many bytes.
const resendMaxTag: int = 256

// An `Idempotency-Key` is at most this many bytes.
const resendMaxKey: int = 256

// Whether `c` may appear in a tag name or value: a letter, a digit, `_` or `-`.
fn resendTagByte(c: byte): bool {
  if (c >= 65 && c <= 90) {
    return true
  }
  if (c >= 97 && c <= 122) {
    return true
  }
  return (c >= 48 && c <= 57) || c == 95 || c == 45
}

// Whether `s` is 1 to `resendMaxTag` bytes of `[A-Za-z0-9_-]`.
fn resendTagOk(s: string): bool {
  if (len(s) == 0 || len(s) > resendMaxTag) {
    return false
  }
  for c of []byte(s) {
    if (!resendTagByte(c)) {
      return false
    }
  }
  return true
}

// `Message.tags` as Resend's `[{name, value}]`, sorted by name. Resend limits
// both halves to `[A-Za-z0-9_-]`; a tag it would refuse is refused here, before
// the request, naming the tag.
fn resendTags(m: Message): []Json!MailError {
  let out: []Json = []
  for name of sorted(keys(m.tags), (a, b) => a < b) {
    let value = m.tags[name]
    if (!resendTagOk(name) || !resendTagOk(value)) {
      fail MailError.Invalid("tags[${echoInput(name)}]: Resend takes tag names and values of 1 to ${resendMaxTag} letters, digits, '_' and '-'")
    }
    out = append(
      out,
      Json.JsonObject(
        [apiEntry("name", Json.JsonString(name)), apiEntry("value", Json.JsonString(value))],
      ),
    )
  }
  return out
}

// `Message.headers` plus the threading pair and `Auto-Submitted`, as the SMTP
// renderer writes them, sorted by name.
fn resendHeaders(m: Message): []JsonEntry!MailError {
  let out: []JsonEntry = []
  for f of sortFields(extraFields(m)?)? {
    out = append(out, apiEntry(f.name, Json.JsonString(f.value)))
  }
  return out
}

fn resendAttachment(a: Attachment): Json {
  let t = apiAttachType(a)
  let e = [
    apiEntry("filename", Json.JsonString(a.name)),
    apiEntry("content", Json.JsonString(encodeBase64(a.data))),
    apiEntry("content_type", Json.JsonString(t)),
  ]
  if (a.cid != "") {
    e = append(e, apiEntry("content_id", Json.JsonString(a.cid)))
  }
  return Json.JsonObject(e)
}

fn resendAttachments(m: Message): []Json {
  let out: []Json = []
  for a of m.attachments {
    out = append(out, resendAttachment(a))
  }
  return out
}

// The request body for `d`. `from` and `replyTo` are the mailer's defaults, for
// a message that sets none.
fn resendPayload(d: Delivery, from: string, replyTo: []string): string!MailError {
  apiCheck(d, "Resend", apiMaxRecipients)?
  let m = d.message
  let sender = apiSender(m, from)
  let reply = apiReplyTo(m, replyTo)
  let f = ApiFields{}
  f.put("from", Json.JsonString(parseField("from", sender)?.toString()))
  f.putList("to", apiAddresses("to", m.to)?)
  f.putList("cc", apiAddresses("cc", m.cc)?)
  f.putList("bcc", apiAddresses("bcc", m.bcc)?)
  f.putList("reply_to", apiAddresses("replyTo", reply)?)
  f.put("subject", Json.JsonString(m.subject))
  f.putText("html", m.html)
  f.putText("text", textBody(m))
  let headers = resendHeaders(m)?
  if (len(headers) > 0) {
    f.put("headers", Json.JsonObject(headers))
  }
  let files = resendAttachments(m)
  if (len(files) > 0) {
    f.put("attachments", Json.JsonArray(files))
  }
  let tags = resendTags(m)?
  if (len(tags) > 0) {
    f.put("tags", Json.JsonArray(tags))
  }
  return jsonEncode(Json.JsonObject(f.entries))
}

// The `Idempotency-Key`: `Message.id` when it is set, else the local part of
// the Message-ID the renderer made. The `Mailer` renders once and retries the
// same `Delivery`, so every attempt carries the same key.
fn resendKey(d: Delivery): string!MailError {
  let key = d.message.id
  if (key == "") {
    let id = d.messageId
    let at = lastIndexOf(id, "@")
    if (len(id) < 3 || at < 2) {
      fail MailError.Invalid("the Message-ID ${echoInput(id)} has no local part to use as an Idempotency-Key")
    }
    key = id[1:at]
  }
  if (len(key) > resendMaxKey) {
    fail MailError.Invalid("the Idempotency-Key is ${len(key)} bytes; Resend takes at most ${resendMaxKey}")
  }
  return key
}
