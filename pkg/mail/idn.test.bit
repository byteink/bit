// pkg/mail/idn.test.bit — IDNA at send and permanent SMTP capability refusals.

import { Dsn, Notify } from "std/smtp"

class InCapture {
  inner: Transport
  raw: string = ""

  deliver(d: Delivery): Receipt!MailError {
    this.raw = d.raw
    return this.inner.deliver(d)?
  }

  signs(): bool {
    return this.inner.signs()
  }

  check(): ()!MailError {
    this.inner.check()?
  }

  close() {
    this.inner.close()
  }
}

class InRun {
  wire: string,
  raw: string,
  accepted: []string,
}

fn inOptions(): Options {
  return Options{
    from = "Sender <Sender@Bücher.example>",
    replyTo = "Reply <Reply@Bücher.example>",
    pool = 1,
    timeout = 10 * Second,
    retry = Retry{ attempts = 1 },
  }
}

fn inMessage(): Message {
  return Message{
    to = ["Sara <Sara@Bücher.example>"],
    subject = "Welcome",
    text = ".Hello.\r\n",
    id = "idn-1",
  }
}

fn inWire(m: Message, o: Options, caps: string, count: int): InRun {
  let replies = []string(0)
  let i = 0
  while (i < count) {
    replies = append(replies, "250 recipient\r\n")
    i = i + 1
  }
  let (port, log) = smStartPlain(smHappy(smEhlo(caps), false, replies)) catch e {
    panic(e.message())
  }
  let mailer = open("smtp://127.0.0.1:${port}?tls=off", o) catch e {
    panic(e.message())
  }
  let capture = InCapture{ inner = mailer.t }
  mailer.t = capture
  let receipt = mailer.send(m) catch e {
    mailer.close()
    panic(e.message())
  }
  mailer.close()
  let wire = <- log
  println("IDNA wire:\n${wire}")
  return InRun{ wire = wire, raw = capture.raw, accepted = receipt.accepted }
}

fn inData(wire: string): string {
  let start = indexOf(wire, "DATA\r\n") + 6
  let end = indexOf(wire[start:], "\r\n.\r\n")
  assert(start >= 6 && end >= 0, wire)
  return replace(wire[start:start + end + 2], "\r\n..", "\r\n.")
}

test "IDNA A-label wire includes defaults and preserves the caller" {
  let o = inOptions()
  let m = inMessage()
  let r = inWire(m, o, "", 1)
  assert(contains(r.wire, "EHLO xn--bcher-kva.example\r\n"), r.wire)
  assert(contains(r.wire, "MAIL FROM:<Sender@xn--bcher-kva.example>"), r.wire)
  assert(contains(r.wire, "RCPT TO:<Sara@xn--bcher-kva.example>\r\n"), r.wire)
  assert(contains(r.raw, "To: \"Sara\" <Sara@xn--bcher-kva.example>\r\n"), r.raw)
  assert(contains(r.raw, "Reply-To: \"Reply\" <Reply@xn--bcher-kva.example>\r\n"), r.raw)
  assert(r.accepted[0] == "Sara@xn--bcher-kva.example", r.accepted[0])
  assert(!contains(r.wire, "SMTPUTF8") && !contains(r.wire, "BODY=8BITMIME"), r.wire)
  assert(inData(r.wire) == r.raw, "DATA changed the rendered bytes")
  assert(m.to[0] == "Sara <Sara@Bücher.example>", m.to[0])
  assert(o.from == "Sender <Sender@Bücher.example>", o.from)
  assert(o.replyTo == "Reply <Reply@Bücher.example>", o.replyTo)
}

fn inAllAddresses(): Message {
  let m = inMessage()
  m.from = "Zoë <From@Bücher.example>"
  m.cc = ["Cc@Bücher.example"]
  m.bcc = ["Bcc@Bücher.example"]
  m.replyTo = ["Reply@Bücher.example"]
  return m
}

test "IDNA all address slots and generated IDs share the checked domain" {
  let m = inAllAddresses()
  let r = inWire(m, inOptions(), "", 3)
  for name of ["From", "Sara", "Cc", "Bcc"] {
    assert(contains(r.wire, "<${name}@xn--bcher-kva.example>"), r.wire)
  }
  assert(contains(r.raw, "Cc: <Cc@xn--bcher-kva.example>"), r.raw)
  assert(contains(r.raw, "Reply-To: <Reply@xn--bcher-kva.example>"), r.raw)
  assert(contains(r.raw, "Message-ID: <idn-1@xn--bcher-kva.example>"), r.raw)
  assert(!contains(r.raw, "Bcc@"), r.raw)
  assert(contains(r.raw, "=?UTF-8?B?"), "the display name was not encoded")
  assert(inData(r.wire) == r.raw, "DATA changed")
  assert(contains(r.wire, " SIZE=${len(r.raw)}\r\n"), r.wire)
  assert(
    m.from == "Zoë <From@Bücher.example>" && m.cc[0] == "Cc@Bücher.example",
    "caller changed",
  )
  m.id = ""
  assert(contains(render(m).messageId, "@xn--bcher-kva.example>"), "generated ID domain")
}

test "IDNA public parsing keeps spelling and quoted at signs stay local" {
  let original = "\"Odd@Local\"@Bücher.Example"
  let a = parseAddress(original) catch e {
    panic(e.message())
  }
  let b = parseField("to[0]", original) catch e {
    panic(e.message())
  }
  assert(a.email == original, a.email)
  assert(b.email == "\"Odd@Local\"@xn--bcher-kva.example", b.email)
  assert(a.email == original, "the parser's Address changed")
  let ascii = parseField("to[0]", "UPPER@Example.COM") catch e {
    panic(e.message())
  }
  assert(ascii.email == "UPPER@example.com", ascii.email)
}

fn inInvalid(domain: string, reason: string) {
  let m = inMessage()
  m.to = ["a@${domain}"]
  let box = Outbox()
  let mailer = Mailer(box, inOptions()) catch e {
    panic(e.message())
  }
  let why = mailer.send(m) catch e {
    match (e) {
      Invalid(text) => {
        assert(contains(text, "to[0]: domain ") && contains(text, domain), text)
        assert(contains(text, reason), text)
      }
      _ => panic(e.message())
    }
    assert(len(box.sent()) == 0, "invalid IDNA reached the transport")
    return
  }
  panic("bad IDNA was delivered: ${why.id}")
}

test "IDNA invalid labels and Bidi fail before transport" {
  inInvalid("ab--c.example", "third and fourth")
  inInvalid("à\u{05d0}.example", "Bidi")
  inInvalid(repeat("a", 56) + "é.example", "63")
}

test "IDNA expansion rechecks the whole address octet limit" {
  let label = repeat("a", 55) + "é"
  let domain = join([label, label, label], ".")
  let local = repeat("L", 63)
  let original = "${local}@${domain}"
  parseAddress(original) catch e {
    panic("the original must parse: ${e.message()}")
  }
  let box = Outbox()
  let mailer = Mailer(box, inOptions()) catch e {
    panic(e.message())
  }
  let m = inMessage()
  m.bcc = [original]
  mailer.send(m) catch e {
    assert(contains(e.message(), "bcc[0]: domain "), e.message())
    assert(contains(e.message(), "255 octets after IDNA, over 254"), e.message())
    assert(len(box.sent()) == 0, "expanded address reached the transport")
    return
  }
  panic("expanded address accepted")
}

test "IDNA redirect canonicalizes its envelope and preserves its settings" {
  let o = inOptions()
  o.redirect = "QA <QA@Bücher.example>"
  let m = inAllAddresses()
  let r = inWire(m, o, "", 1)
  assert(contains(r.wire, "RCPT TO:<QA@xn--bcher-kva.example>\r\n"), r.wire)
  assert(!contains(r.wire, "RCPT TO:<Sara@"), r.wire)
  assert(
    contains(r.raw, "X-Original-To: Sara@xn--bcher-kva.example, Cc@xn--bcher-kva.example"),
    r.raw,
  )
  assert(
    o.redirect == "QA <QA@Bücher.example>" && m.to[0] == "Sara <Sara@Bücher.example>",
    "caller changed",
  )
}

fn inNoError(err: Option<MailError>) {
  match (err) {
    Some(e) => panic(e.message())
    None => {}
  }
}

fn inProviderAddresses(request: string) {
  for name of ["From", "josé", "Cc", "Bcc", "Reply"] {
    assert(contains(request, "${name}@xn--bcher-kva.example"), request)
  }
  assert(!contains(request, "Bücher.example"), request)
}

test "IDNA native provider requests preserve UTF8 local parts" {
  let m = inAllAddresses()
  m.to = ["josé@Bücher.example"]
  let rs = rsSend(rsOk(), m)
  inNoError(rs.err)
  inProviderAddresses(rsBody(rs.seen))
  let pm = pmSend(pmOk(), m, "")
  inNoError(pm.err)
  inProviderAddresses(rsBody(pm.seen))
  let sg = sgSend(sgAccepted(), m)
  inNoError(sg.err)
  inProviderAddresses(rsBody(sg.seen))
  let mg = mgSend(mgAccepted(), m)
  inNoError(mg.err)
  assert(contains(mg.seen, "josé@xn--bcher-kva.example"), mg.seen)
  assert(contains(mg.seen, mg.raw), "Mailgun changed Raw")
  assert(
    m.to[0] == "josé@Bücher.example" && m.replyTo[0] == "Reply@Bücher.example",
    "provider mutated caller",
  )
}

test "IDNA provider defaults use the same conversion" {
  let m = inMessage()
  let mailer = Mailer(Outbox(), inOptions()) catch e {
    panic(e.message())
  }
  let d = mailer.prepare(m) catch e {
    panic(e.message())
  }
  let from = inOptions().from
  let reply = [inOptions().replyTo]
  let rs = resendPayload(d, from, reply) catch e {
    panic(e.message())
  }
  let pm = pmPayload(d, from, reply, "outbound") catch e {
    panic(e.message())
  }
  let sg = sgPayload(d, from, reply) catch e {
    panic(e.message())
  }
  for payload of [rs, pm, sg] {
    assert(contains(payload, "Sender@xn--bcher-kva.example"), payload)
    assert(contains(payload, "Reply@xn--bcher-kva.example"), payload)
  }
  assert(d.message.from == "" && m.from == "", "provider filled the caller's default")
}

test "IDNA calendar organizer and attendees keep caller objects" {
  let inv = icInvite()
  inv.organizer = "Organizer@Bücher.example"
  inv.attendees = ["Attendee@Bücher.example"]
  let m = inAllAddresses()
  m.invite = Option.Some(inv)
  let from = fromAddress(m, noDefaults()) catch e {
    panic(e.message())
  }
  let resolved = resolveInvite(m, inv, from) catch e {
    panic(e.message())
  }
  let ics = icUnfold(buildIcs(inv, resolved, icAt("2026-10-12T09:00:00Z")))
  assert(contains(ics, "mailto:Organizer@xn--bcher-kva.example"), ics)
  assert(contains(ics, "mailto:Attendee@xn--bcher-kva.example"), ics)
  assert(
    inv.organizer == "Organizer@Bücher.example" && inv.attendees[0] == "Attendee@Bücher.example",
    "Invite changed",
  )
  inv.organizer = ""
  inv.attendees = []
  let defaults = resolveInvite(m, inv, from) catch e {
    panic(e.message())
  }
  assert(defaults.organizer.email == "From@xn--bcher-kva.example", defaults.organizer.email)
  assert(defaults.attendees[0].email == "Sara@xn--bcher-kva.example", defaults.attendees[0].email)
}

test "IDNA default DKIM alignment signs the exact native DATA" {
  let o = inOptions()
  o.dkim = [Dkim{ domain = "xn--bcher-kva.example", selector = "rsa1", key = rsaPkcs8Pem }]
  let r = inWire(inMessage(), o, "", 1)
  assert(contains(r.raw, "DKIM-Signature: "), r.raw)
  assert(contains(r.raw, "d=xn--bcher-kva.example;"), r.raw)
  assert(inData(r.wire) == r.raw, "signed bytes changed")
}

fn inUnicodeSlot(slot: string, m: Message, o: Options) {
  let address = "josé@example.com"
  if (slot == "from") {
    m.from = address
  } else if (slot == "to") {
    m.to = [address]
  } else if (slot == "cc") {
    m.cc = [address]
  } else if (slot == "bcc") {
    m.bcc = [address]
  } else if (slot == "replyTo") {
    m.replyTo = [address]
  } else if (slot == "defaultFrom") {
    m.from = ""
    o.from = address
  } else {
    o.replyTo = address
  }
}

fn inRejected(mailer: Mailer, d: Delivery, rawOnly: bool, capability: string) {
  let r = inAttempt(mailer, d, rawOnly) catch e {
    match (e) {
      Rejected(reply) => {
        assert(reply.code == 0, reply.toString())
        assert(
          contains(reply.text, capability) && contains(reply.text, "josé@example.com"),
          reply.text,
        )
        return
      }
      _ => panic("want Rejected: ${e.message()}")
    }
  }
  panic("Unicode address delivered: ${r.id}")
}

fn inAttempt(mailer: Mailer, d: Delivery, rawOnly: bool): Receipt!MailError {
  if (rawOnly) {
    d.message = Message{}
    return mailer.t.deliver(d)?
  }
  return mailer.send(d.message)?
}

fn inCount(s: string, word: string): int {
  return len(split(s, word)) - 1
}

fn inMissing(capabilities: string, slot: string, rawOnly: bool = false) {
  let m = welcome()
  let o = smOpts()
  o.pool = 1
  o.retry = Retry{ attempts = 3 }
  inUnicodeSlot(slot, m, o)
  if (rawOnly) {
    o.replyTo = "${repeat("LongName ", 12)}<josé@example.com>"
  }
  let (port, log) = smStartPlain(smHappy(smEhlo(capabilities), false, ["250 recipient\r\n"])) catch e {
    panic(e.message())
  }
  let mailer = open("smtp://127.0.0.1:${port}?tls=off", o) catch e {
    panic(e.message())
  }
  let fallback = foScript([])
  mailer.t = Failover(
    [mailer.t, fallback],
    ["smtp://test", "fallback://test"],
    false,
    FoClock{ t = 0 },
  )
  let d = mailer.prepare(m) catch e {
    panic(e.message())
  }
  let capability = "SMTPUTF8"
  if (contains(capabilities, "SMTPUTF8")) {
    capability = "8BITMIME"
  }
  inRejected(mailer, d, rawOnly, capability)
  let ascii = welcome()
  ascii.replyTo = ["reply@example.com"]
  mailer.send(ascii) catch e {
    panic("same-session recovery: ${e.message()}")
  }
  mailer.close()
  let wire = <- log
  println("IDNA refusal/recovery ${slot} ${capability}:\n${wire}")
  assert(inCount(wire, "EHLO ") == 1 && inCount(wire, "MAIL FROM:") == 1, wire)
  assert(inCount(wire, "RCPT TO:") == 1 && inCount(wire, "DATA\r\n") == 1, wire)
  assert(!contains(wire, "josé@example.com"), wire)
  assert(foCalls(fallback) == 0, "permanent refusal fell back")
}

test "IDNA SMTP missing either capability is permanent for every slot" {
  for offered of ["", "250-8BITMIME\r\n", "250-SMTPUTF8\r\n"] {
    for slot of ["from", "to", "cc", "bcc", "replyTo", "defaultFrom", "defaultReplyTo"] {
      inMissing(offered, slot)
    }
  }
}

test "IDNA SMTP raw-only queued and redirected header context survives" {
  inMissing("250-8BITMIME\r\n", "defaultReplyTo", true)
  inMissing("250-SMTPUTF8\r\n", "defaultReplyTo", true)
  let m = welcome()
  m.to = ["josé@example.com"]
  let mailer = Mailer(Outbox(), Options{ redirect = "qa@example.com" }) catch e {
    panic(e.message())
  }
  let d = mailer.prepare(m) catch e {
    panic(e.message())
  }
  assert(d.envelope.to[0] == "qa@example.com", d.envelope.to[0])
  assert(internationalDeliveryAddress(d) == "josé@example.com", "redirect lost header context")
}

test "IDNA SMTP both capabilities preserve Unicode address and exact DATA" {
  for slot of ["from", "to", "cc", "bcc", "replyTo", "defaultFrom", "defaultReplyTo"] {
    let m = welcome()
    let o = smOpts()
    inUnicodeSlot(slot, m, o)
    let count = len(m.to) + len(m.cc) + len(m.bcc)
    let r = inWire(m, o, "250-SMTPUTF8\r\n250-8BITMIME\r\n", count)
    assert(contains(r.wire, " SMTPUTF8 BODY=8BITMIME\r\n"), r.wire)
    assert(contains(r.wire, "josé@example.com"), r.wire)
    assert(inData(r.wire) == r.raw, "Unicode DATA changed")
  }
}

test "IDNA SMTP other validate errors remain Invalid" {
  let t = SmtpTransport(
    parseTarget("smtp://127.0.0.1:1?tls=off") catch e {
      panic(e.message())
    },
    "localhost",
    smOpts(),
  )
  let d = Delivery{
    message = Message{},
    envelope = Envelope{ from = "", to = [] },
    raw = "",
    messageId = "",
  }
  for text of [
    "message headers are not valid UTF-8",
    "message is 10 octets, the server accepts at most 9",
  ] {
    let e = t.deliveryError(d, t.lift(SmtpError{ command = "validate", text = text }))
    match (e) {
      Invalid(why) => assert(why == text, why)
      _ => panic(e.message())
    }
  }
  t.close()
}

fn inValidate(t: Transport, d: Delivery, reason: string) {
  t.deliver(d) catch e {
    match (e) {
      Invalid(why) => {
        assert(contains(why, reason), why)
        return
      }
      _ => panic(e.message())
    }
  }
  panic("invalid delivery accepted")
}

test "IDNA native other Invalid checks send nothing and keep the session" {
  let (port, log) = smStartPlain(
    smHappy("250-fake\r\n250 SIZE 500\r\n", false, ["250 recipient\r\n"]),
  ) catch e {
    panic(e.message())
  }
  let mailer = open("smtp://127.0.0.1:${port}?tls=off", smOpts()) catch e {
    panic(e.message())
  }
  let m = welcome()
  m.text = repeat("hello\r\n", 100)
  let large = mailer.prepare(m) catch e {
    panic(e.message())
  }
  inValidate(mailer.t, large, "server accepts at most 500")
  let d = mailer.prepare(welcome()) catch e {
    panic(e.message())
  }
  d.envelope.dsn = Dsn{ notify = [Notify.Failure] }
  let refused = false
  mailer.t.deliver(d) catch e {
    match (e) {
      Rejected(r) => refused = contains(r.text, "does not offer DSN")
      _ => panic(e.message())
    }
  }
  assert(refused, "missing DSN was not a permanent capability refusal")
  d.envelope.dsn = Dsn{}
  d.raw = "From: hello@inkwell.dev\r\nX-Test: ${bytesOf([0xc0])}\r\n\r\nbody\r\n"
  inValidate(mailer.t, d, "headers are not valid UTF-8")
  mailer.send(welcome()) catch e {
    panic(e.message())
  }
  mailer.close()
  let wire = <- log
  println("IDNA Invalid recovery:\n${wire}")
  assert(inCount(wire, "EHLO ") == 1 && inCount(wire, "MAIL FROM:") == 1, wire)
  assert(inCount(wire, "DATA\r\n") == 1 && !contains(wire, "NOTIFY"), wire)
}

fn inCredentialError(mailer: Mailer, m: Message): (bool, string) {
  mailer.send(m) catch e {
    match (e) {
      Rejected(reply) => return (reply.code == 0, e.message())
      _ => return (false, e.message())
    }
  }
  return (false, "Unicode address delivered")
}

fn inCredentialRefusal(password: string, offered: string) {
  let ca = smCaFile() catch e {
    panic(e.message())
  }
  let (port, log) = smStartTls(
    smHappy(smEhlo("250-AUTH PLAIN\r\n${offered}"), true, ["250 recipient\r\n"]),
  ) catch e {
    panic(e.message())
  }
  let mailer = open(smTlsUrl(port, ca, "hello:${password}@"), smOpts()) catch e {
    panic(e.message())
  }
  let m = welcome()
  m.to = ["josé@example.com"]
  let (permanent, why) = inCredentialError(mailer, m)
  mailer.send(welcome()) catch e {
    panic(e.message())
  }
  mailer.close()
  let wire = <- log
  remove(ca) catch e {
    panic(e.message())
  }
  println("IDNA credential refusal recovery:\n${wire}")
  assert(permanent && contains(why, "josé@example.com"), why)
  assert(!contains(why, password), why)
  assert(inCount(wire, "EHLO ") == 1 && inCount(wire, "AUTH ") == 1, wire)
  assert(inCount(wire, "MAIL FROM:") == 1 && inCount(wire, "DATA\r\n") == 1, wire)
  assert(!contains(wire, "josé@example.com"), wire)
}

test "IDNA credential redaction preserves permanent capability refusal" {
  inCredentialRefusal("SMTPUTF8", "250-8BITMIME\r\n")
  inCredentialRefusal("8BITMIME", "250-SMTPUTF8\r\n")
}
