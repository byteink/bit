// pkg/mail/dkimcanon.test.bit — RFC 6376 §3.4.5's examples byte for byte, and
// the cases the RFC leaves to the implementation: the empty body, trailing
// empty lines, folded values, and what splitMessage refuses.

import { encodeBase64, digest, Sha256 } from "std/crypto"
import { repeat } from "std/strings"

// The body of RFC 6376 §3.4.5's example.
const rfcBody: string = " C \r\nD \t E\r\n\r\n\r\n"

fn bodyHash(canon: string): string {
  return encodeBase64(digest(Sha256(), []byte(canon)))
}

fn mustSplit(data: string): ([](string, string), string) {
  return splitMessage(data) catch e {
    panic("splitMessage failed: ${e.message()}")
  }
}

// The message of `data` split, or the refusal text when it cannot be.
fn splitRefusal(data: string): string {
  splitMessage(data) catch e {
    return e.message()
  }
  return "accepted"
}

test "RFC 6376 3.4.5: relaxed header canonicalization" {
  assert(relaxedHeader("A", " X") == "a:X\r\n")
  assert(relaxedHeader("B ", " Y\t\r\n\tZ  ") == "b:Y Z\r\n")
}

test "RFC 6376 3.4.5: relaxed body canonicalization" {
  assert(relaxedBody(rfcBody) == " C\r\nD E\r\n")
}

test "the RFC message splits into its two fields and its body" {
  let parts = mustSplit("A: X\r\nB : Y\t\r\n\tZ  \r\n\r\n C \r\nD \t E\r\n\r\n\r\n")
  assert(len(parts.0) == 2)
  assert(parts.0[0].0 == "A")
  assert(parts.0[0].1 == " X")
  assert(parts.0[1].0 == "B ")
  assert(parts.0[1].1 == " Y\t\r\n\tZ  ")
  assert(parts.1 == rfcBody)
  assert(relaxedHeader(parts.0[1].0, parts.0[1].1) == "b:Y Z\r\n")
}

test "an empty body canonicalizes to empty and hashes as sha256 of nothing" {
  assert(relaxedBody("") == "")
  assert(bodyHash(relaxedBody("")) == "47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=")
}

test "a body of nothing but empty lines or WSP lines is empty" {
  assert(relaxedBody("\r\n") == "")
  assert(relaxedBody("\r\n\r\n\r\n") == "")
  assert(relaxedBody(" \t\r\n \r\n") == "")
}

test "trailing blank lines do not change the canonical body" {
  assert(relaxedBody("hi\r\n\r\n\r\n\r\n") == relaxedBody("hi\r\n"))
  assert(relaxedBody("hi\r\n \t\r\n\r\n") == "hi\r\n")
  assert(relaxedBody("hi\r\n\r\n\r\n\r\n") == "hi\r\n")
}

test "a body with no final CRLF gets one" {
  assert(relaxedBody("hi") == "hi\r\n")
  assert(relaxedBody("hi  ") == "hi\r\n")
  assert(relaxedBody("a\r\nb") == "a\r\nb\r\n")
}

test "blank lines between text are kept, leading WSP collapses to one SP" {
  assert(relaxedBody("a\r\n\r\n\r\nb\r\n") == "a\r\n\r\n\r\nb\r\n")
  assert(relaxedBody("\r\nb\r\n") == "\r\nb\r\n")
  assert(relaxedBody("  \t a \t b\t\r\n") == " a b\r\n")
}

test "a bare CR and a bare LF are ordinary text" {
  assert(relaxedBody("a\rb\nc\r\n") == "a\rb\nc\r\n")
}

test "header: names lower-case, WSP around the colon and at the end goes" {
  assert(relaxedHeader("Subject", "  Hello   World \t") == "subject:Hello World\r\n")
  assert(relaxedHeader("X-MiXed", "") == "x-mixed:\r\n")
  assert(relaxedHeader("To", " \t ") == "to:\r\n")
  assert(relaxedHeader("DKIM-Signature", "a=b;\r\n c=d") == "dkim-signature:a=b; c=d\r\n")
}

test "header: a CRLF not followed by WSP is not a fold and stays" {
  assert(relaxedHeader("A", "x\r\ny") == "a:x\r\ny\r\n")
}

test "header: a fold at the start or the end of the value leaves no space" {
  assert(relaxedHeader("A", "\r\n x") == "a:x\r\n")
  assert(relaxedHeader("A", "x\r\n ") == "a:x\r\n")
}

test "header: a name's non-ASCII bytes are not lowered" {
  assert(relaxedHeader("X-É", "v") == "x-É:v\r\n")
}

test "splitMessage: no body and no blank line" {
  let parts = mustSplit("A: 1\r\nB: 2\r\n")
  assert(len(parts.0) == 2)
  assert(parts.1 == "")
}

test "splitMessage: no fields, only a body" {
  let parts = mustSplit("\r\nbody")
  assert(len(parts.0) == 0)
  assert(parts.1 == "body")
  assert(len(mustSplit("").0) == 0)
}

test "splitMessage: the body keeps every CRLF CRLF after the first" {
  let parts = mustSplit("A: 1\r\n\r\nx\r\n\r\ny\r\n\r\n")
  assert(parts.1 == "x\r\n\r\ny\r\n\r\n")
}

test "splitMessage: a field keeps its colons and its continuation lines" {
  let parts = mustSplit("Date: Mon, 1 Jan 2026 10:00:00 +0000\r\nSubject: a\r\n b\r\n\tc\r\n\r\n")
  assert(parts.0[0].1 == " Mon, 1 Jan 2026 10:00:00 +0000")
  assert(parts.0[1].1 == " a\r\n b\r\n\tc")
}

test "splitMessage refuses what no signer can canonicalize" {
  assert(splitRefusal("A 1\r\n\r\n") == "mail: a header field has no colon")
  assert(splitRefusal(": 1\r\n\r\n") == "mail: a header field has no name")
  assert(
      splitRefusal(" a: 1\r\n\r\n") ==
      "mail: a header field name has a byte that is not printable ASCII",
  )
  assert(splitRefusal("A: 1") == "mail: a header field does not end in CRLF")
  assert(splitRefusal("A: 1\r\n b") == "mail: a header field does not end in CRLF")
  assert(
      splitRefusal("A\x01B: 1\r\n\r\n") ==
      "mail: a header field name has a byte that is not printable ASCII",
  )
  assert(splitRefusal("A: 1\r\n\r\n") == "accepted")
}

test "a large body canonicalizes in one pass" {
  let line = "word \t word  \r\n"
  let body = repeat(line, 20000) + repeat("\r\n", 20000)
  let got = relaxedBody(body)
  assert(len(got) == 20000 * 11)
  assert(relaxedBody(got) == got)
}
