// pkg/mail/htmlkinds.bit — what htmlToText (htmltext.bit) does with each tag
// name. A name not in `tagKinds` is inline and changes nothing.
//
// The block list is the elements the WHATWG HTML Standard's rendering section
// (§15.3 "Rendering", "Flow content" and the tables, lists and sections that
// follow it) gives `display: block`, `list-item`, `table`, `table-row` or
// `table-caption`. `<br>` and `<hr>` are there too; `<hr>` is a line of its own.

// A name with no effect.
const kindInline: int = 0
// Starts and ends a line.
const kindBlock: int = 1
// Starts and ends a line and leaves a blank one: `<p>`, headings, `<blockquote>`.
const kindPara: int = 2
const kindBr: int = 3
const kindLi: int = 4
// `<td>` and `<th>`: a space between neighbours.
const kindCell: int = 5
const kindLink: int = 6
const kindImg: int = 7
// Content dropped up to the matching end tag: `<script>`, `<style>`, `<title>`.
const kindRaw: int = 8
// Content dropped up to `</head>` or `<body`.
const kindHead: int = 9

const tagKinds: map<string, int> = {
  "address": 1,
  "article": 1,
  "aside": 1,
  "caption": 1,
  "center": 1,
  "dd": 1,
  "details": 1,
  "dialog": 1,
  "div": 1,
  "dl": 1,
  "dt": 1,
  "fieldset": 1,
  "figcaption": 1,
  "figure": 1,
  "footer": 1,
  "form": 1,
  "header": 1,
  "hgroup": 1,
  "hr": 1,
  "legend": 1,
  "listing": 1,
  "main": 1,
  "menu": 1,
  "nav": 1,
  "ol": 1,
  "pre": 1,
  "search": 1,
  "section": 1,
  "summary": 1,
  "table": 1,
  "tr": 1,
  "ul": 1,
  "xmp": 1,
  "blockquote": 2,
  "h1": 2,
  "h2": 2,
  "h3": 2,
  "h4": 2,
  "h5": 2,
  "h6": 2,
  "p": 2,
  "br": 3,
  "li": 4,
  "td": 5,
  "th": 5,
  "a": 6,
  "img": 7,
  "script": 8,
  "style": 8,
  "title": 8,
  "head": 9,
}
