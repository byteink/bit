// pkg/mail/httpapi.bit — what the HTTPS-API transports share (resend.bit,
// postmark.bit, sendgrid.bit, mailgun.bit): the `scheme://SECRET@host[?...]` URL, the client, the way a
// failed request and a `Retry-After` become a `MailError`, and the pieces of
// the JSON each of them posts. A provider keeps what is its own: the endpoint,
// the headers, the body and what each of its answers means.
//
// The request is always TLS: there is no URL that sends the secret over
// plaintext, and `insecureSkipVerify` is refused for a provider's real host, so
// only a stand-in can be left unverified. The secret is never in an error, a
// `Receipt` or the text of a transport.

import { Client as HttpClient, RequestError, Response as HttpResponse, header as httpHeader } from "std/http"
import { HandshakeError, HandshakeFailure, TlsConfig, emptyTrustStore } from "std/tls"
import { Json, JsonEntry, jsonAsInt, jsonAsString, jsonGet, jsonParse } from "std/json"
import { hasPrefix, join, parseInt, replace, trimSpace } from "std/strings"
import { Second } from "std/time"
import { keys } from "std/seq"

// The longest `Retry-After` taken at its word, in seconds: a day. A larger
// number is a misread or an attack, and `Options.retry.max` caps the wait anyway.
const apiMaxRetryAfter: int = 86400

// The longest server text kept in an error.
const apiMaxText: int = 500

// What a provider's URL looks like: `scheme` with its `://`, the host `default`
// stands for, the other names that stand for a host of the provider's own
// (SendGrid's `eu`), what the secret is called in an error and as a placeholder
// in the form shown to the caller, and the query parameters it takes besides
// `insecureSkipVerify`. `second` names a second part of the userinfo, written
// `SECRET:second@host` (Mailgun's sending domain); "" means the userinfo is the
// secret alone.
class ApiSpec {
  scheme: string,
  defaultHost: string,
  regions: map<string, string> = {},
  secret: string,
  placeholder: string,
  params: []string = [],
  second: string = "",
}

// What a provider's URL names.
class ApiTarget {
  secret: string = "",
  // `https://host[:port]`, no path.
  base: string = "",
  insecure: bool = false,
  // The URL as an error shows it: `resend://***@default`.
  display: string = "",
  // The values of `ApiSpec.params` the URL set.
  params: map<string, string> = {},
  // The part after the `:` in the userinfo, when `ApiSpec.second` names one.
  second: string = "",
}

fn apiUrlError(s: ApiSpec, why: string): MailError {
  return MailError.Config("${s.scheme}: ${why}")
}

// Whether `url` starts with `scheme`, whatever follows and in any case.
fn hasScheme(url: string, scheme: string): bool {
  return hasPrefix(toLower(url), scheme)
}

// A secret that is printable ASCII, so it can be written into a header.
fn apiSecretOk(secret: string): bool {
  for c of []byte(secret) {
    if (c <= 32 || c >= 127) {
      return false
    }
  }
  return len(secret) > 0
}

// The host of the provider's own that `name` stands for (`default`, or one of
// `ApiSpec.regions`), "" for any other name.
fn apiNamed(s: ApiSpec, name: string): string {
  if (name == "default") {
    return s.defaultHost
  }
  return s.regions[name]
}

// Whether `host` is one of the provider's own, which is always verified.
fn apiReal(s: ApiSpec, host: string): bool {
  if (host == s.defaultHost) {
    return true
  }
  for name of keys(s.regions) {
    if (s.regions[name] == host) {
      return true
    }
  }
  return false
}

// `host[:port]` as it is written after `@`, with the default host resolved.
fn apiHost(s: ApiSpec, hostport: string): string!MailError {
  if (indexOf(hostport, "[") >= 0 || indexOf(hostport, "/") >= 0) {
    fail apiUrlError(s, "the host is a name with an optional port, `default` or host[:port]")
  }
  let host = hostport
  let port = ""
  let colon = lastIndexOf(hostport, ":")
  if (colon >= 0) {
    host = hostport[0:colon]
    parsePort(hostport[colon + 1:])?
    port = hostport[colon:]
  }
  if (host == "") {
    fail apiUrlError(s, "the URL names no host; use ${s.scheme}${s.placeholder}@default")
  }
  let named = apiNamed(s, host)
  if (named != "") {
    if (port != "") {
      fail apiUrlError(s, "`${host}` is ${named} and takes no port")
    }
    return named
  }
  return pctDecode(host, "the host")? + port
}

// What the query parameters may be, as an error says it.
fn apiParamHint(s: ApiSpec): string {
  if (len(s.params) == 0) {
    return "the only query parameter is insecureSkipVerify=true|false"
  }
  return "the query parameters are ${join(s.params, ", ")} and insecureSkipVerify=true|false"
}

// Whether `key` is one of the parameters `s` takes besides `insecureSkipVerify`.
fn apiKnown(s: ApiSpec, key: string): bool {
  for k of s.params {
    if (k == key) {
      return true
    }
  }
  return false
}

// Sets `t` from one `key=value` of the query.
fn apiParam(s: ApiSpec, t: ApiTarget, part: string, host: string): ()!MailError {
  let eq = indexOf(part, "=")
  if (eq < 0) {
    fail apiUrlError(s, apiParamHint(s))
  }
  let key = part[0:eq]
  let value = part[eq + 1:]
  if (key != "insecureSkipVerify") {
    if (!apiKnown(s, key)) {
      fail apiUrlError(s, apiParamHint(s))
    }
    if (value == "") {
      fail apiUrlError(s, "the query parameter '${key}' has no value")
    }
    if (t.params[key] != "") {
      fail apiUrlError(s, "the query parameter '${key}' is given twice")
    }
    t.params[key] = value
    return
  }
  if (value != "true" && value != "false") {
    fail apiUrlError(s, apiParamHint(s))
  }
  if (apiReal(s, host)) {
    fail apiUrlError(
      s,
      "insecureSkipVerify is for a stand-in host; the real ${host} is always verified",
    )
  }
  t.insecure = value == "true"
}

// The userinfo `info` as a target holding the secret and, for a spec with a
// `second`, the part after the first `:`. Without one, a `:` is a password,
// which these URLs do not have.
fn apiCredentials(s: ApiSpec, info: string): ApiTarget!MailError {
  let colon = indexOf(info, ":")
  let t = ApiTarget{}
  let secret = info
  if (colon >= 0 && s.second == "") {
    fail apiUrlError(
      s,
      "the ${s.secret} goes before the @ alone, as ${s.scheme}${s.placeholder}@host; there is no password",
    )
  }
  if (s.second != "") {
    if (colon < 0) {
      fail apiUrlError(
        s,
        "the URL has no ${s.second}; use ${s.scheme}${s.placeholder}:${s.second}@default",
      )
    }
    t.second = pctDecode(info[colon + 1:], "the ${s.second}")?
    secret = info[0:colon]
  }
  t.secret = pctDecode(secret, "the ${s.secret}")?
  if (!apiSecretOk(t.secret)) {
    fail apiUrlError(s, "the ${s.secret} is empty or not printable ASCII")
  }
  return t
}

// `:second` as an error shows the URL, "" when the spec has no second part.
fn apiShownSecond(t: ApiTarget): string {
  if (t.second == "") {
    return ""
  }
  return ":${t.second}"
}

// `url` as a target, or a `Config` that never repeats the secret.
fn parseApiUrl(s: ApiSpec, url: string): ApiTarget!MailError {
  let rest = url[len(s.scheme):]
  let query = ""
  let q = indexOf(rest, "?")
  if (q >= 0) {
    query = rest[q + 1:]
    rest = rest[0:q]
  }
  let at = lastIndexOf(rest, "@")
  if (at < 0) {
    fail apiUrlError(s, "the URL has no ${s.secret}; use ${s.scheme}${s.placeholder}@default")
  }
  let t = apiCredentials(s, rest[0:at])?
  let host = apiHost(s, rest[at + 1:])?
  t.base = "https://${host}"
  t.display = "${s.scheme}***${apiShownSecond(t)}@${host}"
  if (query != "") {
    for part of split(query, "&") {
      apiParam(s, t, part, host)?
    }
  }
  return t
}

// A fresh client per send: its headers carry this send's secret, and the
// `Mailer` may call `deliver` from many tasks at once.
fn apiClient(insecure: bool): HttpClient {
  if (insecure) {
    return HttpClient(TlsConfig(emptyTrustStore(), insecureSkipVerify = true))
  }
  return HttpClient()
}

// A request that got no answer. A certificate or protocol failure of the
// handshake is the same next time, so it is `Rejected`. A request that never
// left (a refused connection, a failed connect) is `Transient`. One that was
// written and then cut off (a reset, a timeout) is `Transient` only when the
// provider takes an idempotency key (`idempotent`), so a repeat is the same
// request to it; otherwise the mail may have been taken and the outcome is
// `Unknown`, which is not repeated (RFC 9110 §9.2.2). `text` is already scrubbed
// of the secret.
fn apiNetError(text: string, e: error, idempotent: bool): MailError {
  let r = Reply{ text = text }
  let cause = e
  let sent = false
  let (q, wrapped) = e.(RequestError)
  if (wrapped) {
    cause = q.cause
    sent = q.sent
  }
  let (h, ok) = cause.(HandshakeError)
  if (ok && h.kind != HandshakeFailure.Io) {
    return MailError.Rejected(r)
  }
  if (sent && !idempotent) {
    return MailError.Unknown(r)
  }
  return MailError.Transient(r)
}

// The provider's cheapest authenticated read at `url`, for `check`. A GET is
// safe to repeat, so a request cut off after it was written is `Transient`,
// never `Unknown`. `provider` and `secret` shape the error text only.
fn apiGet(
  c: HttpClient,
  url: string,
  timeoutMs: int,
  provider: string,
  secret: string,
): HttpResponse!MailError {
  return c.requestTimeout("GET", url, "", timeoutMs) catch e {
    fail apiNetError("${provider}: ${apiScrub(e.message(), secret)}", e, true)
  }
}

// Whether `status` is a 2xx.
fn apiOk(status: int): bool {
  return status >= 200 && status < 300
}

// The `MailError` for a read the provider answered with anything but a 2xx:
// 401 and 403 are `Auth`, 429 and 5xx `Transient`, the rest `Rejected`. `text`
// is the provider's own words, already scrubbed of the secret.
fn apiReadError(status: int, headers: string, text: string): MailError {
  let why = apiClip(text)
  if (why == "") {
    why = "HTTP ${status}"
  }
  let r = Reply{ code = status, text = why, retryAfter = apiRetryAfter(headers) }
  if (status == 401 || status == 403) {
    return MailError.Auth(r)
  }
  if (status == 429 || status >= 500) {
    return MailError.Transient(r)
  }
  return MailError.Rejected(r)
}

// `Retry-After` in nanoseconds: delta-seconds only (RFC 9110 §10.2.3); an HTTP
// date, a negative or an unreadable value is 0, no hint.
fn apiRetryAfter(headers: string): int {
  let v = trimSpace(httpHeader(headers, "retry-after"))
  let n = parseInt(v) catch _ {
    return 0
  }
  if (n < 0 || n > apiMaxRetryAfter) {
    return 0
  }
  return n * Second
}

// `text` with every copy of `secret` hidden.
fn apiScrub(text: string, secret: string): string {
  return replace(text, secret, "***")
}

// `text` cut to `apiMaxText` bytes.
fn apiClip(text: string): string {
  if (len(text) > apiMaxText) {
    return text[0:apiMaxText]
  }
  return text
}

// The member `name` of the JSON object `body`, `None` when `body` is not JSON
// or has no such member.
fn apiMember(body: string, name: string): Option<Json> {
  let j = jsonParse(body) catch _ {
    return Option<Json>.None
  }
  return jsonGet(j, name)
}

// A string member of a provider's reply, "" when it is absent or not a string.
fn apiField(body: string, name: string): string {
  match (apiMember(body, name)) {
    Some(v) => return unwrapOr(jsonAsString(v), "")
    None => return ""
  }
}

// An integer member of a provider's reply, `fallback` when it is absent or not
// an integer.
fn apiIntField(body: string, name: string, fallback: int): int {
  match (apiMember(body, name)) {
    Some(v) => return unwrapOr(jsonAsInt(v), fallback)
    None => return fallback
  }
}

fn apiEntry(key: string, value: Json): JsonEntry {
  return JsonEntry{ key = key, value = value }
}

fn apiStrings(list: []string): Json {
  let out: []Json = []
  for s of list {
    out = append(out, Json.JsonString(s))
  }
  return Json.JsonArray(out)
}

// `list` parsed as `field[i]` and written back as `Name <email>`.
fn apiAddresses(field: string, list: []string): []string!MailError {
  let out: []string = []
  for a of parseFields(field, list)? {
    out = append(out, a.toString())
  }
  return out
}

// More than `max` envelope recipients, refused before anything is sent. An API
// that takes the raw message (Mailgun) carries an invite as it is and needs this
// check alone.
fn apiCheckRecipients(d: Delivery, provider: string, max: int): ()!MailError {
  if (len(d.envelope.to) > max) {
    fail MailError.Invalid("${len(d.envelope.to)} recipients; ${provider} takes at most ${max} across to, cc and bcc, so send in batches")
  }
}

// What an API that builds the mail itself cannot carry, refused before anything
// is sent: more than `max` addresses across `to`, `cc` and `bcc` (`apiMaxRecipients`
// for Resend and Postmark), and an invite. `provider` is its name as an error
// says it.
fn apiCheck(d: Delivery, provider: string, max: int): ()!MailError {
  apiCheckRecipients(d, provider, max)?
  match (d.message.invite) {
    Some(_) => fail MailError.Invalid("Message.invite: ${provider} has no calendar alternative; send an invite through smtp:// or attach the .ics yourself")
    None => return
  }
}

// Resend and Postmark take at most this many addresses across `to`, `cc` and `bcc`.
const apiMaxRecipients: int = 50

// Characters in `s`: the bytes that do not continue a multi-byte sequence.
fn apiChars(s: string): int {
  let n = 0
  for c of []byte(s) {
    if (c < 128 || c >= 192) {
      n = n + 1
    }
  }
  return n
}

// The From of `m`, else the mailer's default `from`.
fn apiSender(m: Message, from: string): string {
  if (m.from != "") {
    return m.from
  }
  return from
}

// The Reply-To list of `m`, else the mailer's default `replyTo`.
fn apiReplyTo(m: Message, replyTo: []string): []string {
  if (len(m.replyTo) > 0) {
    return m.replyTo
  }
  return replyTo
}

// The MIME type of `a`: the one it names, else the one its file name implies.
fn apiAttachType(a: Attachment): string {
  if (a.contentType == "") {
    return guessType(a.name)
  }
  return a.contentType
}

// The object being built: fields in the order they are written, a field with
// nothing to say left out.
class ApiFields {
  entries: []JsonEntry = []

  put(name: string, value: Json) {
    this.entries = append(this.entries, apiEntry(name, value))
  }

  putList(name: string, list: []string) {
    if (len(list) > 0) {
      this.put(name, apiStrings(list))
    }
  }

  // `list` as one string, its addresses joined by `, `.
  putJoined(name: string, list: []string) {
    if (len(list) > 0) {
      this.put(name, Json.JsonString(join(list, ", ")))
    }
  }

  putText(name: string, text: string) {
    if (text != "") {
      this.put(name, Json.JsonString(text))
    }
  }
}
