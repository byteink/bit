test "OAuth redaction masks original overlapping raw and encoded credential spans" {
  for secrets of [["abc", "abcdef"], ["abcdef", "abc"]] {
    assert(oauthScrub("before abcdef after", secrets) == "before *** after")
  }
  assert(oauthScrub("before ${percentEncode("a%")} after", ["a%"]) == "before *** after")
  for secrets of [["abc", "bcd"], ["bcd", "abc"]] {
    assert(oauthScrub("before abcd after", secrets) == "before *** after")
  }
  assert(oauthScrub("ababa", ["aba", "bab"]) == "***")
  assert(oauthScrub("clear", ["", "missing", "missing"]) == "clear")
  assert(oauthScrub("abc", ["", "abc", "abc"]) == "***")
  assert(oauthScrub("", ["abc"]) == "")
}

test "OAuth redaction retains only current response and grant credentials across refreshes" {
  let access = ["first-access", "second-access", "third-access"]
  let rotated = ["first-rotated", "second-rotated", "third-rotated"]
  let (port, requests) = rsStart(
    [
      otAnswer(access[0], rotated[0]),
      otAnswer(access[1], rotated[1]),
      otAnswer(access[2], rotated[2]),
    ],
  ) catch e {
    panic(e.message())
  }
  let source = otSource(port)
  let clock = OtClock{ at = 1000 * Second }
  source.cache.clock = () => clock.read()
  let grant = otRefresh
  for (let i = 0; i < 3; i = i + 1) {
    let token = otToken(source)
    assert(token.generation == i + 1 && len(token.secrets) == 4)
    assert(token.secrets[0] == access[i] && token.secrets[1] == rotated[i])
    assert(token.secrets[2] == otSecret && token.secrets[3] == grant)
    assert(contains(<- requests, "refresh_token=${percentEncode(grant)}"))
    grant = rotated[i]
    clock.at = clock.at + 60 * Second
  }
}

test "OAuth redaction preserves password refusal codes and masks encoded credentials before later layers" {
  let target = parseTarget("smtps://hello:a%25@mail.example.com") catch e {
    panic(e.message())
  }
  let transport = SmtpTransport(target, "inkwell.dev", smOpts())
  defer transport.close()
  let refusal = SmtpError{
    code = 535, enhanced = "5.7.8", text = "refused ${percentEncode("a%")}", command = "AUTH PLAIN",
  }
  match (transport.lift(refusal)) {
    Auth(r) => {
      assert(r.code == 535 && r.enhanced == "5.7.8")
      assert(r.text == "refused ***", r.text)
    }
    _ => panic("password refusal changed category")
  }
}

test "OAuth redaction forwards an attempted bearer after the shared cache has moved to a different token" {
  let body = "{\"error\":\"invalid_grant\",\"error_description\":\"refused abcdef\"}"
  let (port, requests) = rsStart([otAnswer("abcdef"), otAnswer("cachedabc"), rsReply(400, "", body)]) catch e {
    panic(e.message())
  }
  let source = otSource(port)
  source.clientSecret = "abc"
  let first = sourceToken(source, 10 * Second) catch e {
    panic(e.message())
  }
  let second = sourceToken(source, 10 * Second, first.generation) catch e {
    panic(e.message())
  }
  assert(second.value == "cachedabc" && len(second.secrets) == 4)
  assert(!contains(join(second.secrets, "|"), first.value))
  sourceToken(source, 10 * Second, second.generation, [first.value]) catch e {
    match (e) {
      Auth(r) => assert(r.code == 400 && r.text == "invalid_grant: refused ***", r.text)
      _ => panic(e.message())
    }
    for (let i = 0; i < 3; i = i + 1) {
      assert(contains(<- requests, "POST /token"))
    }
    return
  }
  panic("OAuth accepted the refused grant")
}
