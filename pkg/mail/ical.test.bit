// pkg/mail/ical.test.bit — `Invite`: the exact iCalendar text for a REQUEST and
// a CANCEL, RFC 5545 line folding at 75 octets (a multi-byte character never
// split, Arabic text unfolding back to the input), TEXT escaping, UTC times,
// the iMIP parts a rendered message carries, and the refusals.

import { decodeBase64 } from "std/crypto"
import { contains, hasPrefix, indexOf, indexOfFrom, join, repeat, replace, split } from "std/strings"
import { Minute, Timestamp, parseRfc3339 } from "std/time"

const icFrom: string = "Inkwell <hello@inkwell.dev>"

fn icAt(s: string): Timestamp {
  return parseRfc3339(s) catch _ {
    panic("bad time ${s}")
  }
}

// The invite every test starts from: 30 minutes on 2026-10-12.
fn icInvite(): Invite {
  return Invite{
    uid = "standup-1@inkwell.dev",
    start = icAt("2026-10-12T09:00:00Z"),
    end = icAt("2026-10-12T09:30:00Z"),
    summary = "Editorial standup, week 41",
    location = "Room 4; 2nd floor",
    description = "Bring the draft.\nSee notes\\here",
  }
}

fn icMessage(inv: Invite): Message {
  return Message{
    from = icFrom,
    to = ["Sara Ali <sara@example.com>"],
    cc = ["kim@example.com"],
    bcc = ["audit@inkwell.dev"],
    subject = "Editorial standup",
    text = "Join us.",
    invite = Option<Invite>.Some(inv),
  }
}

fn icNoDefaults(): Defaults {
  return Defaults{ from = "", replyTo = [] }
}

fn icRender(m: Message): string {
  let r = renderMessage(m, icNoDefaults()) catch e {
    panic("render: ${e.message()}")
  }
  return r.data
}

// The refusal of `m`, or "ok".
fn icVerdict(m: Message): string {
  renderMessage(m, icNoDefaults()) catch e {
    return e.message()
  }
  return "ok"
}

// The iCalendar text of `m.invite` with a fixed DTSTAMP.
fn icText(m: Message): string {
  let from = parseAddress(m.from) catch _ {
    panic("from")
  }
  let inv = Invite{
    uid = "",
    start = icAt("2026-01-01T00:00:00Z"),
    end = icAt("2026-01-01T00:00:00Z"),
    summary = "",
  }
  match (m.invite) {
    Some(i) => inv = i
    None => panic("no invite")
  }
  let r = resolveInvite(m, inv, from) catch e {
    panic("resolve: ${e.message()}")
  }
  return buildIcs(inv, r, icAt("2026-10-05T08:00:00Z"))
}

fn icLines(lines: []string): string {
  return join(lines, "\r\n") + "\r\n"
}

// `ics` with every fold removed (RFC 5545 §3.1).
fn icUnfold(ics: string): string {
  return replace(ics, "\r\n ", "")
}

test "a REQUEST is written exactly: UID, UTC times, escaped text, organizer and attendees" {
  let want = icLines(
    [
      "BEGIN:VCALENDAR",
      "VERSION:2.0",
      "PRODID:-//bitlang.org//pkg mail//EN",
      "METHOD:REQUEST",
      "BEGIN:VEVENT",
      "UID:standup-1@inkwell.dev",
      "DTSTAMP:20261005T080000Z",
      "DTSTART:20261012T090000Z",
      "DTEND:20261012T093000Z",
      "SEQUENCE:0",
      "SUMMARY:Editorial standup\\, week 41",
      "LOCATION:Room 4\\; 2nd floor",
      "DESCRIPTION:Bring the draft.\\nSee notes\\\\here",
      "STATUS:CONFIRMED",
      "ORGANIZER;CN=\"Inkwell\":mailto:hello@inkwell.dev",
      "ATTENDEE;CN=\"Sara Ali\";ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;RSVP=TRUE",
      " :mailto:sara@example.com",
      "ATTENDEE;ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;RSVP=TRUE:mailto:kim@ex",
      " ample.com",
      "END:VEVENT",
      "END:VCALENDAR",
    ],
  )
  assert(icText(icMessage(icInvite())) == want, icText(icMessage(icInvite())))
}

test "a CANCEL keeps the UID, raises the sequence, and asks for no reply" {
  let inv = icInvite()
  inv.method = Method.Cancel
  inv.sequence = 1
  let ics = icText(icMessage(inv))
  assert(contains(ics, "\r\nMETHOD:CANCEL\r\n"), ics)
  assert(contains(ics, "\r\nUID:standup-1@inkwell.dev\r\n"), ics)
  assert(contains(ics, "\r\nSEQUENCE:1\r\n"), ics)
  assert(contains(ics, "\r\nSTATUS:CANCELLED\r\n"), ics)
  assert(!contains(ics, "RSVP"), ics)
  assert(!contains(icUnfold(ics), "STATUS:CONFIRMED"), ics)
  assert(
    contains(
      icUnfold(ics),
      "ATTENDEE;ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION:mailto:kim@example.com\r\n",
    ),
    ics,
  )
}

test "a 200-character Arabic description folds at 75 octets and unfolds to the input" {
  let arabic = repeat("سلام ", 40)
  assert(len(arabic) > 200, "the text is bytes, not 200 octets")
  let inv = icInvite()
  inv.description = arabic
  let ics = icText(icMessage(inv))
  let lines = split(ics, "\r\n")
  let folded = 0
  for line of lines {
    assert(len(line) <= 75, "a line is ${len(line)} octets: ${line}")
    if (hasPrefix(line, " ")) {
      folded = folded + 1
      assert(!(line[1] >= u8(128) && line[1] < u8(192)), "a piece starts inside a character")
    }
  }
  assert(folded >= 5, "the description was not folded: ${folded} continuation lines")
  assert(
    contains(icUnfold(ics), "\r\nDESCRIPTION:${arabic}\r\n"),
    "unfolding did not give the input back",
  )
}

test "a line of exactly 75 octets is not folded, 76 folds into 75 and a one-octet piece" {
  let l75 = repeat("a", 75)
  assert(foldLine(l75) == l75, "75 octets were folded")
  assert(foldLine(l75 + "b") == l75 + "\r\n b", "76 octets are not 75 + CRLF + space + 1")
}

test "a multi-byte character at the cut moves whole to the next line" {
  let line = repeat("a", 74) + "é"
  assert(len(line) == 76, "setup")
  assert(foldLine(line) == repeat("a", 74) + "\r\n é", "the é was split or the cut is wrong")
  let three = repeat("a", 73) + "€"
  assert(foldLine(three) == repeat("a", 73) + "\r\n €", "a 3-octet character was split")
  let four = repeat("a", 72) + "😀"
  assert(foldLine(four) == repeat("a", 72) + "\r\n 😀", "a 4-octet character was split")
}

test "a continuation line holds 74 octets of content, the space making 75" {
  let line = repeat("a", 75) + repeat("b", 74) + "c"
  assert(
    foldLine(line) == repeat("a", 75) + "\r\n " + repeat("b", 74) + "\r\n c",
    "second piece is not 74",
  )
}

test "TEXT escapes backslash, semicolon, comma and every kind of line break" {
  assert(escapeText("a\\b;c,d") == "a\\\\b\\;c\\,d", escapeText("a\\b;c,d"))
  assert(
    escapeText("one\r\ntwo\nthree\rfour") == "one\\ntwo\\nthree\\nfour",
    escapeText("one\r\ntwo\nthree\rfour"),
  )
  assert(escapeText("") == "", "empty")
  assert(escapeText("نص;عربي") == "نص\\;عربي", "non-ASCII bytes must pass untouched")
}

test "times are UTC with a Z, padded, and a fraction of a second is dropped" {
  assert(
    icsTime(icAt("2026-03-01T04:05:06Z")) == "20260301T040506Z",
    icsTime(icAt("2026-03-01T04:05:06Z")),
  )
  assert(icsTime(icAt("2026-03-01T04:05:06.987Z")) == "20260301T040506Z", "fraction kept")
  assert(
    icsTime(icAt("2026-03-01T06:05:06+02:00")) == "20260301T040506Z",
    "offset not converted to UTC",
  )
  assert(zeroPad(7, 4) == "0007" && zeroPad(12345, 4) == "12345", "zero padding")
}

test "a name with a quote or a caret is one CN value" {
  let m = icMessage(icInvite())
  m.from = "\"Kim ^Lee, Inkwell\" <kim@inkwell.dev>"
  let ics = icText(m)
  assert(contains(ics, "ORGANIZER;CN=\"Kim ^^Lee, Inkwell\":mailto:kim@inkwell.dev"), ics)
}

test "a rendered message ends its alternatives with the calendar part and attaches invite.ics" {
  let raw = icRender(icMessage(icInvite()))
  let cal = indexOf(raw, "Content-Type: text/calendar; method=REQUEST; charset=UTF-8\r\n")
  let plain = indexOf(raw, "Content-Type: text/plain; charset=utf-8")
  let file = indexOf(raw, "Content-Type: application/ics")
  assert(plain > 0 && cal > plain, "the calendar part is not after the text part")
  assert(file > cal, "invite.ics is not after the alternatives")
  assert(contains(raw, "Content-Type: multipart/mixed;"), "no multipart/mixed for the attachment")
  assert(contains(raw, "Content-Type: multipart/alternative;"), "no multipart/alternative")
  assert(contains(raw, "filename=\"invite.ics\""), "the attachment has no name")
  let closing = indexOfFrom(raw, "\r\n--", cal)
  assert(closing > cal, "the calendar part is not closed")
}

test "the attached invite.ics is the same object as the calendar part" {
  let raw = icRender(icMessage(icInvite()))
  let calAt = indexOf(raw, "METHOD:REQUEST\r\nBEGIN:VEVENT")
  assert(calAt > 0, "no calendar text in the message")
  let start = indexOf(raw, "BEGIN:VCALENDAR")
  let end = indexOf(raw[start:], "END:VCALENDAR\r\n") + start + 15
  let ics = raw[start:end]
  let head = raw[indexOf(raw, "Content-Type: application/ics"):]
  let body = head[indexOf(head, "\r\n\r\n") + 4:]
  let b64 = replace(body[0:indexOf(body, "\r\n--")], "\r\n", "")
  let decoded = decodeBase64(b64) catch e {
    panic("base64: ${e.message()}")
  }
  assert(string(decoded) == ics, "the attachment differs from the alternative part")
}

test "a CANCEL names its method in the part's Content-Type" {
  let inv = icInvite()
  inv.method = Method.Cancel
  inv.sequence = 2
  let raw = icRender(icMessage(inv))
  assert(contains(raw, "Content-Type: text/calendar; method=CANCEL; charset=UTF-8\r\n"), raw)
  assert(contains(raw, "METHOD:CANCEL\r\n"), raw)
  assert(!contains(raw, "method=REQUEST"), raw)
}

test "the organizer is the From, the attendees are to and cc, and never bcc" {
  let ics = icUnfold(icRender(icMessage(icInvite())))
  assert(contains(ics, "ORGANIZER;CN=\"Inkwell\":mailto:hello@inkwell.dev"), ics)
  assert(contains(ics, ":mailto:sara@example.com"), ics)
  assert(contains(ics, ":mailto:kim@example.com"), ics)
  assert(!contains(ics, "audit@inkwell.dev\r\n"), "a bcc recipient is in the attendee list")
}

test "organizer and attendees can be set on the invite" {
  let inv = icInvite()
  inv.organizer = "Kim Lee <kim@inkwell.dev>"
  inv.attendees = ["Lee <lee@example.com>"]
  let ics = icText(icMessage(inv))
  assert(contains(ics, "ORGANIZER;CN=\"Kim Lee\":mailto:kim@inkwell.dev"), ics)
  assert(
    contains(
      icUnfold(ics),
      "ATTENDEE;CN=\"Lee\";ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;RSVP=TRUE:mailto:lee@example.com",
    ),
    ics,
  )
  assert(!contains(ics, "sara@example.com"), "to was used although attendees is set")
}

test "empty LOCATION and DESCRIPTION are left out" {
  let inv = icInvite()
  inv.location = ""
  inv.description = ""
  let ics = icText(icMessage(inv))
  assert(!contains(ics, "LOCATION"), ics)
  assert(!contains(ics, "DESCRIPTION"), ics)
}

test "the method defaults to REQUEST" {
  let inv = Invite{
    uid = "x@inkwell.dev",
    start = icAt("2026-10-12T09:00:00Z"),
    end = icAt("2026-10-12T09:00:00Z").add(Minute),
    summary = "Quick sync",
  }
  assert(contains(icText(icMessage(inv)), "METHOD:REQUEST\r\n"), "default method is not REQUEST")
}

test "a message with no invite has no calendar part" {
  let m = icMessage(icInvite())
  m.invite = Option<Invite>.None
  let raw = icRender(m)
  assert(!contains(raw, "text/calendar"), raw)
  assert(!contains(raw, "invite.ics"), raw)
}

// The refusal for `inv`, minus the "mail: invite." prefix.
fn icRefusal(inv: Invite): string {
  let got = icVerdict(icMessage(inv))
  assert(hasPrefix(got, "mail: invite."), "not an invite refusal: ${got}")
  return got
}

test "an empty uid is refused" {
  let inv = icInvite()
  inv.uid = ""
  assert(hasPrefix(icRefusal(inv), "mail: invite.uid: is empty"), icRefusal(inv))
}

test "a CANCEL with no uid is refused the same way" {
  let inv = icInvite()
  inv.uid = ""
  inv.method = Method.Cancel
  inv.sequence = 1
  assert(hasPrefix(icRefusal(inv), "mail: invite.uid: is empty"), icRefusal(inv))
}

test "a CR or LF in the uid is refused" {
  let inv = icInvite()
  inv.uid = "a@b\r\nATTENDEE:mailto:evil@x"
  assert(icRefusal(inv) == "mail: invite.uid: contains a CR, LF or NUL", icRefusal(inv))
}

test "an empty summary is refused" {
  let inv = icInvite()
  inv.summary = "  "
  assert(icRefusal(inv) == "mail: invite.summary: is empty", icRefusal(inv))
}

test "an end that is not after the start is refused" {
  let inv = icInvite()
  inv.end = inv.start
  assert(hasPrefix(icRefusal(inv), "mail: invite.end: is not after start"), icRefusal(inv))
  inv.end = inv.start.add(0 - Minute)
  assert(hasPrefix(icRefusal(inv), "mail: invite.end: is not after start"), icRefusal(inv))
}

test "a negative sequence is refused" {
  let inv = icInvite()
  inv.sequence = -1
  assert(icRefusal(inv) == "mail: invite.sequence: is -1; it counts from 0", icRefusal(inv))
}

test "a CANCEL with sequence 0 is refused, a REQUEST with 0 is not" {
  let inv = icInvite()
  inv.method = Method.Cancel
  assert(hasPrefix(icRefusal(inv), "mail: invite.sequence: is 0 on a CANCEL"), icRefusal(inv))
  inv.method = Method.Request
  assert(icVerdict(icMessage(inv)) == "ok", icVerdict(icMessage(inv)))
}

test "an invite with nobody to invite is refused" {
  let m = icMessage(icInvite())
  m.to = []
  m.cc = []
  assert(
      icVerdict(m) ==
      "mail: invite.attendees: is empty and the message has no to or cc; list who is invited",
    icVerdict(m),
  )
}

test "a bad organizer or attendee names its field" {
  let inv = icInvite()
  inv.organizer = "not an address"
  assert(
    hasPrefix(icVerdict(icMessage(inv)), "mail: invite.organizer: invalid address"),
    icVerdict(icMessage(inv)),
  )
  inv.organizer = ""
  inv.attendees = ["a@b.example", "nope"]
  assert(
    hasPrefix(icVerdict(icMessage(inv)), "mail: invite.attendees[1]: invalid address"),
    icVerdict(icMessage(inv)),
  )
}

test "a control byte in a text field is refused" {
  let inv = icInvite()
  inv.location = "Room\u{0}4"
  assert(
    hasPrefix(icRefusal(inv), "mail: invite.location: it contains the control byte 0"),
    icRefusal(inv),
  )
}
