// pkg/mail/errors.bit — `MailError`, the one error type every fallible
// function in this package returns (`T!MailError`), so a caller can `match` on
// the kind of failure instead of parsing text.
//
// The variants split by what the caller can do about them:
//   * `Invalid` and `Config` are mistakes in the program: the input or the
//     setup is wrong, and sending again will not make it right.
//   * `Auth` and `Rejected` are the server's permanent answer: a refused login,
//     a refused message or recipient. Retrying the same thing fails again.
//   * `Signature` is the same kind of answer for a webhook posted to the
//     program: the request is not a genuine, recent one from its provider.
//   * `Transient` is the server's temporary answer (a 4xx): the same send may
//     succeed later, which is the one variant a retry is for.

// What a mail server said: the numeric `code` (`550`), the enhanced status code
// (`5.1.1`, "" when the server sent none) and the human text after them.
export class Reply {
  export code: int = 0
  export enhanced: string = ""
  export text: string = ""
  // How long the server asks the sender to wait before trying again, in
  // nanoseconds: an HTTP `Retry-After` a provider transport carried over.
  // 0 means it asked for nothing. `Options.retry` honours it.
  export retryAfter: int = 0

  // The reply as a log line: `550 5.1.1 No such user`. A reply the package made
  // itself, not a server (code 0), is its text alone.
  export toString(): string {
    if (this.code == 0) {
      return this.text
    }
    if (this.enhanced == "") {
      return "${this.code} ${this.text}"
    }
    return "${this.code} ${this.enhanced} ${this.text}"
  }
}

// One failure this package can report. It satisfies the predeclared `error`
// interface through `message()`, so `?` carries it through any `()!` caller.
export enum MailError {
  // The input is not acceptable. The text names the input and the reason, and
  // never contains a raw CR, LF or NUL even when the input did.
  Invalid(string)
  // The setup is not acceptable. The text names the `Options` field and why;
  // it is raised by `Mailer(...)`, before the first send.
  Config(string)
  // The server refused the login.
  Auth(Reply)
  // The server refused the message or a recipient for good.
  Rejected(Reply)
  // A webhook request failed its signature check (webhook.bit): a header is
  // missing, the timestamp is stale or the signature does not match. The text
  // names which, and never holds the secret or the body. Answer the request
  // with 401.
  Signature(string)
  // The server could not take the message now; sending it again may work.
  Transient(Reply)

  export message(): string {
    match (this) {
      Invalid(why) => return "mail: ${why}"
      Config(why) => return "mail: configuration: ${why}"
      Auth(r) => return "mail: login refused: ${r.toString()}"
      Rejected(r) => return "mail: rejected: ${r.toString()}"
      Signature(why) => return "mail: webhook rejected: ${why}"
      Transient(r) => return "mail: temporary failure: ${r.toString()}"
    }
  }
}
