// pkg/mail/redirect.test.bit — `Options.redirect`: the envelope is the redirect
// address alone, the To and Cc lines stay and `X-Original-To` lists them, a Bcc
// address is in no header, the Subject is prefixed, the DKIM signature covers
// the redirected bytes, a transport that builds the mail itself sees only the
// redirect address, and a bad address fails at `Mailer()` and `open()`.

import { contains, hasPrefix, indexOf, join, toLower } from "std/strings"
import { values } from "std/seq"

const rdQa: string = "qa@inkwell.dev"

fn rdOptions(): Options {
  return Options{ from = inkwell, redirect = rdQa }
}

// Two To, one Cc and one Bcc: the case the redirect exists for.
fn rdFour(): Message {
  return Message{
    to = ["Sara Ali <sara@example.com>", "lee@example.com"],
    cc = ["Kim <kim@example.com>"],
    bcc = ["audit@example.com"],
    subject = "Welcome to Inkwell",
    text = "Hello.",
    id = "welcome-1",
  }
}

// The header fields of `raw` named `name`, folds removed.
fn rdField(raw: string, name: string): string {
  for h of dwNamed(dwHeaders(raw), toLower(name)) {
    return collapse(h[indexOf(h, ":") + 1:])
  }
  return ""
}

// A provider API that builds the mail from `Delivery.message`: it keeps what a
// JSON body would carry.
class RdApi {
  to: []string
  cc: []string
  bcc: []string
  headers: map<string, string>
  subject: string
  envelope: []string

  deliver(d: Delivery): Receipt!MailError {
    this.to = d.message.to
    this.cc = d.message.cc
    this.bcc = d.message.bcc
    this.headers = d.message.headers
    this.subject = d.message.subject
    this.envelope = d.envelope.to
    return Receipt{ id = d.messageId, accepted = d.envelope.to }
  }

  signs(): bool {
    return false
  }

  close() {}
}

fn rdMailer(t: Transport, o: Options): Mailer {
  return Mailer(t, o) catch e {
    panic("Mailer: ${e.message()}")
  }
}

fn rdSend(box: Outbox, m: Message): Sent {
  let mailer = mbMailer(box, rdOptions())
  mailer.send(m) catch e {
    panic("send: ${e.message()}")
  }
  return box.sent()[0]
}

test "the envelope is the redirect address alone and the receipt says so" {
  let sent = rdSend(Outbox(), rdFour())
  assert(join(sent.receipt.accepted, ",") == rdQa, join(sent.receipt.accepted, ","))
}

test "X-Original-To lists To and Cc, the To and Cc lines stay, the Subject is prefixed" {
  let raw = rdSend(Outbox(), rdFour()).raw
  assert(
    rdField(raw, "X-Original-To") == "sara@example.com, lee@example.com, kim@example.com",
    rdField(raw, "X-Original-To"),
  )
  assert(contains(raw, "\r\nTo: \"Sara Ali\" <sara@example.com>, <lee@example.com>\r\n"), raw)
  assert(contains(raw, "\r\nCc: \"Kim\" <kim@example.com>\r\n"), raw)
  assert(contains(raw, "\r\nSubject: [redirected] Welcome to Inkwell\r\n"), raw)
}

test "a Bcc address is in no header and nowhere in the bytes" {
  let box = Outbox()
  let raw = rdSend(box, rdFour()).raw
  assert(!contains(raw, "audit@example.com"), "the Bcc address leaked into the message")
  assert(!contains(raw, "Bcc"), "a Bcc line was written")
  let mailer = mbMailer(Outbox(), rdOptions())
  let rendered = mailer.render(rdFour()) catch e {
    panic("render: ${e.message()}")
  }
  assert(!contains(rendered, "audit@example.com"), "render leaked the Bcc address")
}

test "a message with only a Bcc is delivered to the redirect and has no X-Original-To" {
  let m = Message{ bcc = ["audit@example.com"], subject = "Digest", text = "Hello.", id = "d-1" }
  let sent = rdSend(Outbox(), m)
  assert(join(sent.receipt.accepted, ",") == rdQa, join(sent.receipt.accepted, ","))
  assert(!contains(sent.raw, "X-Original-To"), sent.raw)
  assert(!contains(sent.raw, "audit@example.com"), sent.raw)
}

test "a provider API sees the redirect address in every recipient field and the originals only in the header" {
  let api = RdApi{}
  let mailer = rdMailer(api, rdOptions())
  mailer.send(rdFour()) catch e {
    panic("send: ${e.message()}")
  }
  assert(join(api.envelope, ",") == rdQa, join(api.envelope, ","))
  assert(join(api.to, ",") == rdQa, join(api.to, ","))
  assert(
    len(api.cc) == 0 && len(api.bcc) == 0,
    "cc or bcc survived: ${join(api.cc, ",")} ${join(api.bcc, ",")}",
  )
  assert(api.subject == "[redirected] Welcome to Inkwell", api.subject)
  assert(
    api.headers["X-Original-To"] == "sara@example.com, lee@example.com, kim@example.com",
    api.headers["X-Original-To"],
  )
  assert(
    !contains(join(values(api.headers), "\n"), "audit@example.com"),
    "the Bcc address is in a header",
  )
}

test "the caller's message is not changed" {
  let m = rdFour()
  m.headers["X-Run"] = "7"
  let _ = rdSend(Outbox(), m)
  assert(m.subject == "Welcome to Inkwell", m.subject)
  assert(len(m.to) == 2 && len(m.cc) == 1 && len(m.bcc) == 1, "recipients changed")
  assert(len(m.headers) == 1, "headers changed")
}

test "the DKIM signature covers the redirected Subject and header" {
  let box = Outbox()
  let mailer = mbMailer(box, Options{ from = inkwell, redirect = rdQa, dkim = [dwRsa()] })
  mailer.send(rdFour()) catch e {
    panic("send: ${e.message()}")
  }
  let hs = dwHeaders(box.sent()[0].raw)
  let sigs = dwNamed(hs, "dkim-signature")
  assert(len(sigs) == 1, "${len(sigs)} signatures")
  let rest = dwUnsigned(hs)
  let fields = dwSelect(rest, hList(sigs[0]))
  assert(contains(fields, "subject:[redirected] Welcome to Inkwell"), fields)
  assert(rsaVerifies(rsaPkcs8Pem, sigs[0], fields), "the signature does not verify")
  let bad = dwSelect(dwTampered(rest), hList(sigs[0]))
  assert(!rsaVerifies(rsaPkcs8Pem, sigs[0], bad), "the verifier accepted a changed Subject")
}

test "an incomplete message is refused as without a redirect" {
  let mailer = mbMailer(Outbox(), rdOptions())
  let got = dwSend(mailer, Message{ to = ["sara@example.com"], subject = " ", text = "Hello." })
  assert(got == "mail: Message.subject is empty", got)
  let bad = dwSend(mailer, Message{ to = ["not an address"], subject = "Hi", text = "Hello." })
  assert(hasPrefix(bad, "mail: to[0]: invalid address"), bad)
}

test "a caller's own X-Original-To is refused, not overwritten" {
  let mailer = mbMailer(Outbox(), rdOptions())
  let m = rdFour()
  m.headers["x-original-to"] = "boss@example.com"
  let got = dwSend(mailer, m)
  assert(contains(got, "set twice"), got)
}

test "a mailer without a redirect delivers where the message says" {
  let box = Outbox()
  let mailer = mbMailer(box, Options{ from = inkwell })
  mailer.send(rdFour()) catch e {
    panic("send: ${e.message()}")
  }
  let sent = box.sent()[0]
  assert(len(sent.receipt.accepted) == 4, join(sent.receipt.accepted, ","))
  assert(!contains(sent.raw, "X-Original-To"), sent.raw)
  assert(!contains(sent.raw, "[redirected]"), sent.raw)
}

test "an unparseable redirect fails at Mailer() naming Options.redirect" {
  let got = mbSetup(Options{ redirect = "not an address" })
  assert(hasPrefix(got, "mail: configuration: Options.redirect: invalid address"), got)
  assert(
    hasPrefix(mbSetup(Options{ redirect = "a@b@c" }), "mail: configuration: Options.redirect: "),
    "a@b@c",
  )
}

test "open refuses an unparseable redirect before connecting" {
  open("smtps://mail.example.com", Options{ redirect = "nope" }) catch e {
    match (e) {
      Config(why) => assert(hasPrefix(why, "Options.redirect: invalid address"), why)
      _ => assert(false, "want Config, got ${e.message()}")
    }
    return
  }
  assert(false, "open succeeded")
}

test "a redirect with a display name delivers to its bare address" {
  let box = Outbox()
  let mailer = mbMailer(box, Options{ from = inkwell, redirect = "QA <qa@inkwell.dev>" })
  mailer.send(rdFour()) catch e {
    panic("send: ${e.message()}")
  }
  assert(
    join(box.sent()[0].receipt.accepted, ",") == rdQa,
    join(box.sent()[0].receipt.accepted, ","),
  )
}
