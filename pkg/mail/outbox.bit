// pkg/mail/outbox.bit — `Outbox`, the transport for tests: it delivers nothing
// and keeps every mail it was given, so a test sends through the real
// `Mailer` and then reads what would have gone out.

import { Mutex } from "std/sync"

// One mail an `Outbox` took.
export class Sent {
  export message: Message,
  // The exact bytes a real transport would have sent.
  export raw: string,
  export receipt: Receipt,
}

// A `Transport` that records instead of sending. Any number of tasks may send
// through it at once.
export class Outbox {
  mu: Mutex
  log: []Sent

  init() {
    this.mu = Mutex()
    this.log = []
  }

  // Records `d` and accepts every envelope recipient.
  export deliver(d: Delivery): Receipt!MailError {
    let r = Receipt{ id = d.messageId, accepted = d.envelope.to }
    this.mu.lock()
    this.log = append(this.log, Sent{ message = d.message, raw = d.raw, receipt = r })
    this.mu.unlock()
    return r
  }

  // Everything sent so far, oldest first. A copy: mail sent later does not
  // appear in a list already returned.
  export sent(): []Sent {
    this.mu.lock()
    let out: []Sent = []
    for s of this.log {
      out = append(out, s)
    }
    this.mu.unlock()
    return out
  }

  // The bytes it records are the bytes a real transport would send.
  export signs(): bool {
    return true
  }

  // Always ready: nothing is connected.
  export check(): ()!MailError {}

  // Nothing to release.
  export close() {}
}
