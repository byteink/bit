// pkg/mail/message.bit — `Message`, the one mail a program composes: who it is
// from and to, what it says, and the few headers that make it a good citizen
// of a mailbox. It is plain data, built as `Message{...}`; nothing is checked
// until it is rendered (render.bit), so one failure names the whole message.
//
// Addresses are written as people write them (`Sara Ali <sara@example.com>`)
// and go through `parseAddress` when rendered; a field that holds a list names
// the failing element as `to[1]`.

// One outgoing mail. Every field may be left out, so a message sets only what
// it uses. An omitted list is empty and an omitted map is an empty map, so a key
// can be written straight into a fresh message (`m.headers["X-Run"] = "7"`).
export class Message {
  // The sender, `Inkwell <hello@inkwell.dev>`. Empty means the mailer's default
  // From; with neither the message is refused.
  export from: string = "",
  // Visible recipients. At least one of `to`, `cc` and `bcc` must be set.
  export to: []string = [],
  export cc: []string = [],
  // Blind recipients: delivered to, and never written into any header.
  export bcc: []string = [],
  // Where a reply goes instead of to `from`. Empty means the mailer's default.
  export replyTo: []string = [],
  // Required. Non-ASCII text is sent as an RFC 2047 encoded word.
  export subject: string = "",
  // The plain-text body, and the HTML alternative. At least one is required.
  export text: string = "",
  export html: string = "",
  // Files sent with the mail. One with a `cid` is shown inside `html` as
  // `<img src="cid:...">`; the others are downloads. Together they may not
  // exceed 25 MiB. See attachment.bit.
  export attachments: []Attachment = [],
  // Extra header fields, written sorted by name. The names this package or the
  // sending library own (`From`, `To`, `Date`, `Message-ID`, `Content-*`...)
  // are refused. `Auto-Submitted: auto-generated` is added unless set here.
  export headers: map<string, string> = {},
  // How a recipient leaves the list: an https `url` for one-click unsubscribe
  // (RFC 8058), a `mailto` fallback, or both. Written as `List-Unsubscribe` and
  // `List-Unsubscribe-Post`, which are always DKIM-signed, so `headers` may set
  // neither. Gmail and Yahoo require the one-click form on bulk mail. See
  // unsubscribe.bit.
  export unsubscribe: Unsubscribe = Unsubscribe{},
  // Labels for your own bookkeeping (a campaign, a user id). They are never
  // written into the message.
  export tags: map<string, string> = {},
  // The Message-ID of the mail this one answers, with or without `<>`. Sets
  // `In-Reply-To` and puts the id last in `References`.
  export inReplyTo: string = "",
  // The Message-IDs of the thread so far, oldest first.
  export references: []string = [],
  // A name for this message's own Message-ID: `welcome-7` becomes
  // `<welcome-7@inkwell.dev>`, at the From address's domain. Empty means a
  // fresh unique id.
  export id: string = "",
  // A calendar event sent with the mail: the invite for it to appear in the
  // recipients' calendars with Yes / No / Maybe buttons, or its cancellation.
  // See ical.bit.
  export invite: Option<Invite>,
}
