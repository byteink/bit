// pkg/mail/mailer.test.bit — `Mailer`: the setup checks and their exact words,
// the defaults it fills in, that `send` hands the transport the bytes `render`
// returns, what the `Outbox` records, the transport errors a send passes on,
// and 100 sends at once.

import { contains, hasPrefix, join, split } from "std/strings"
import { WaitGroup } from "std/sync"

const inkwell: string = "Inkwell <hello@inkwell.dev>"

// A complete message that names no sender, so the mailer's default is used.
fn mbWelcome(): Message {
  return Message{
    to = ["Sara Ali <sara@example.com>"],
    subject = "Welcome to Inkwell",
    text = "Hello Sara.",
    id = "welcome-1",
  }
}

fn mbMailer(box: Outbox, o: Options): Mailer {
  return Mailer(box, o) catch e {
    panic("Mailer: ${e.message()}")
  }
}

// `s` without its `Date:` line, which changes with the clock.
fn mbNoDate(s: string): string {
  let out: []string = []
  for line of split(s, "\r\n") {
    if (!hasPrefix(line, "Date: ")) {
      out = append(out, line)
    }
  }
  return join(out, "\r\n")
}

// The text of the failure `Mailer(Outbox(), o)` reports, or "ok".
fn mbSetup(o: Options): string {
  Mailer(Outbox(), o) catch e {
    return e.message()
  }
  return "ok"
}

test "Options{} is a valid setup" {
  assert(mbSetup(Options{}) == "ok", mbSetup(Options{}))
}

test "an unparseable from is a Config naming Options.from" {
  let got = mbSetup(Options{ from = "not an address" })
  assert(hasPrefix(got, "mail: configuration: Options.from: invalid address"), got)
}

test "a bad setup is the Config variant" {
  Mailer(Outbox(), Options{ timeout = 0 }) catch e {
    match (e) {
      Config(why) => assert(contains(why, "Options.timeout"), why)
      _ => assert(false, "want Config, got ${e.message()}")
    }
    return
  }
  assert(false, "Mailer succeeded")
}

test "an unparseable replyTo is a Config naming Options.replyTo" {
  let got = mbSetup(Options{ replyTo = "a@b@c" })
  assert(hasPrefix(got, "mail: configuration: Options.replyTo: invalid address"), got)
}

test "a timeout of zero or less is a Config naming Options.timeout" {
  assert(
      mbSetup(Options{ timeout = 0 }) ==
      "mail: configuration: Options.timeout must be positive, got 0",
    mbSetup(Options{ timeout = 0 }),
  )
  assert(
      mbSetup(Options{ timeout = -5 }) ==
      "mail: configuration: Options.timeout must be positive, got -5",
    mbSetup(Options{ timeout = -5 }),
  )
}

test "the default timeout is 30 seconds in nanoseconds" {
  assert(Options{}.timeout == 30000000000, "${Options{}.timeout}")
}

test "send fills in the mailer's From and the Outbox keeps the rendered bytes" {
  let box = Outbox()
  let mailer = mbMailer(box, Options{ from = inkwell })
  let rcpt = mailer.send(mbWelcome()) catch e {
    panic("send: ${e.message()}")
  }
  let sent = box.sent()
  assert(len(sent) == 1, "recorded ${len(sent)}")
  let want = mailer.render(mbWelcome()) catch e {
    panic("render: ${e.message()}")
  }
  assert(
    mbNoDate(sent[0].raw) == mbNoDate(want),
    "raw differs from render:\n${sent[0].raw}\n${want}",
  )
  assert(contains(sent[0].raw, "From: \"Inkwell\" <hello@inkwell.dev>\r\n"), sent[0].raw)
  assert(rcpt.id == "<welcome-1@inkwell.dev>", rcpt.id)
  assert(sent[0].receipt.id == rcpt.id, sent[0].receipt.id)
  assert(sent[0].message.subject == "Welcome to Inkwell", sent[0].message.subject)
  assert(sent[0].message.from == "", "the caller's message is kept as written")
}

test "a Message's own From wins over Options.from" {
  let box = Outbox()
  let m = mbWelcome()
  m.from = "Billing <billing@inkwell.dev>"
  mbMailer(box, Options{ from = inkwell }).send(m) catch e {
    panic("send: ${e.message()}")
  }
  assert(
    contains(box.sent()[0].raw, "From: \"Billing\" <billing@inkwell.dev>\r\n"),
    box.sent()[0].raw,
  )
}

test "Options.replyTo is the Reply-To unless the message sets its own" {
  let box = Outbox()
  let mailer = mbMailer(box, Options{ from = inkwell, replyTo = "Support <support@inkwell.dev>" })
  mailer.send(mbWelcome()) catch e {
    panic("send: ${e.message()}")
  }
  let own = mbWelcome()
  own.replyTo = ["kim@example.com"]
  mailer.send(own) catch e {
    panic("send: ${e.message()}")
  }
  let sent = box.sent()
  assert(contains(sent[0].raw, "Reply-To: \"Support\" <support@inkwell.dev>\r\n"), sent[0].raw)
  assert(contains(sent[1].raw, "Reply-To: <kim@example.com>\r\n"), sent[1].raw)
  assert(!contains(sent[1].raw, "support@inkwell.dev"), sent[1].raw)
}

test "a message with no From and no Options.from is refused" {
  let box = Outbox()
  let mailer = mbMailer(box, Options{})
  mailer.send(mbWelcome()) catch e {
    assert(
      e.message() == "mail: Message.from is empty and Options.from is not set",
      e.message(),
    )
    assert(len(box.sent()) == 0, "recorded a refused message")
    return
  }
  assert(false, "send succeeded")
}

test "a message with no recipient is Invalid and the Outbox records nothing" {
  let box = Outbox()
  let mailer = mbMailer(box, Options{ from = inkwell })
  let m = mbWelcome()
  m.to = []
  mailer.send(m) catch e {
    match (e) {
      Invalid(why) => assert(contains(why, "no recipient"), why)
      _ => assert(false, "want Invalid, got ${e.message()}")
    }
    assert(len(box.sent()) == 0, "recorded ${len(box.sent())}")
    return
  }
  assert(false, "send succeeded")
}

test "render refuses what send refuses" {
  let mailer = mbMailer(Outbox(), Options{ from = inkwell })
  let m = mbWelcome()
  m.subject = ""
  mailer.render(m) catch e {
    assert(e.message() == "mail: Message.subject is empty", e.message())
    return
  }
  assert(false, "render succeeded")
}

test "the receipt accepts every envelope recipient, bcc included" {
  let box = Outbox()
  let m = mbWelcome()
  m.bcc = ["audit@inkwell.dev"]
  let r = mbMailer(box, Options{ from = inkwell }).send(m) catch e {
    panic("send: ${e.message()}")
  }
  assert(join(r.accepted, ",") == "sara@example.com,audit@inkwell.dev", join(r.accepted, ","))
  assert(len(r.rejected) == 0 && !r.queued && r.providerId == "", "the other fields are empty")
  assert(!contains(box.sent()[0].raw, "audit@inkwell.dev"), "bcc reached the bytes")
}

test "sent returns a copy" {
  let box = Outbox()
  let mailer = mbMailer(box, Options{ from = inkwell })
  mailer.send(mbWelcome()) catch e {
    panic("send: ${e.message()}")
  }
  let first = box.sent()
  mailer.send(mbWelcome()) catch e {
    panic("send: ${e.message()}")
  }
  assert(len(first) == 1 && len(box.sent()) == 2, "${len(first)} and ${len(box.sent())}")
}

// A transport that counts closes and answers with whatever it was told to.
class MbScript {
  closed: int
  answer: MailError
  refuse: bool

  deliver(d: Delivery): Receipt!MailError {
    if (this.refuse) {
      fail this.answer
    }
    return Receipt{ id = d.messageId, accepted = d.envelope.to }
  }

  signs(): bool {
    return true
  }

  check(): ()!MailError {}

  close() {
    this.closed = this.closed + 1
  }
}

test "close closes the transport" {
  let t = MbScript{ closed = 0, answer = MailError.Invalid(""), refuse = false }
  let mailer = Mailer(t, Options{ from = inkwell }) catch e {
    panic("Mailer: ${e.message()}")
  }
  mailer.close()
  assert(t.closed == 1, "closed ${t.closed} times")
}

test "a transport's refusal comes back as the same variant" {
  let r = Reply{ code = 550, enhanced = "5.1.1", text = "No such user" }
  let errs = [MailError.Auth(r), MailError.Rejected(r), MailError.Transient(r)]
  let want = [
    "mail: login refused: 550 5.1.1 No such user",
    "mail: rejected: 550 5.1.1 No such user",
    "mail: temporary failure: 550 5.1.1 No such user",
  ]
  let i = 0
  while (i < len(errs)) {
    let t = MbScript{ closed = 0, answer = errs[i], refuse = true }
    let mailer = Mailer(t, Options{ from = inkwell }) catch e {
      panic("Mailer: ${e.message()}")
    }
    mailer.send(mbWelcome()) catch e {
      assert(e.message() == want[i], e.message())
      i = i + 1
      continue
    }
    assert(false, "send succeeded")
  }
}

test "a Reply with no enhanced code prints without it" {
  assert(Reply{ code = 421, text = "Try later" }.toString() == "421 Try later", "toString")
  assert(MailError.Config("x").message() == "mail: configuration: x", "Config")
}

fn mbWorker(mailer: Mailer, n: int, wg: WaitGroup) {
  defer wg.done()
  let m = mbWelcome()
  m.id = "run-${n}"
  mailer.send(m) catch e {
    panic("send ${n}: ${e.message()}")
  }
}

test "100 concurrent sends are all recorded" {
  let box = Outbox()
  let mailer = mbMailer(box, Options{ from = inkwell })
  let wg = WaitGroup()
  wg.add(100)
  let i = 0
  while (i < 100) {
    spawn mbWorker(mailer, i, wg)
    i = i + 1
  }
  wg.wait()
  let sent = box.sent()
  assert(len(sent) == 100, "recorded ${len(sent)}")
  let seen = map<string, bool>()
  for s of sent {
    seen[s.receipt.id] = true
  }
  assert(len(seen) == 100, "${len(seen)} distinct Message-IDs")
}
