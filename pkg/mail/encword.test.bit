// pkg/mail/encword.test.bit — decodeWords: which tokens are encoded words,
// what happens to the whitespace around them, and what is refused.

fn decoded(text: string): string {
  return decodeWords(text) catch e {
    panic("decodeWords(${text}) failed: ${e.message()}")
  }
}

test "text with no encoded word comes back untouched, spacing included" {
  assert(decoded("Sara   Ali") == "Sara   Ali")
  assert(decoded("") == "")
}

test "a token that only resembles an encoded word stays literal" {
  assert(decoded("=?foo") == "=?foo")
  assert(decoded("a=?UTF-8?B?QQ==?=") == "a=?UTF-8?B?QQ==?=")
  assert(decoded("=?UTF-8?B?QQ==?=b") == "=?UTF-8?B?QQ==?=b")
  assert(decoded("=?a?=") == "=?a?=")
}

test "an encoded word between plain words keeps the spacing around it" {
  assert(decoded("Hi =?UTF-8?Q?Jos=C3=A9?=  and Sara") == "Hi José  and Sara")
}

test "whitespace between two encoded words is dropped, between a word and text is kept" {
  assert(decoded("=?UTF-8?Q?Sa?= \t =?UTF-8?Q?ra?=") == "Sara")
  assert(decoded("=?UTF-8?Q?Sara?= Ali") == "Sara Ali")
  assert(decoded("Sara =?UTF-8?Q?Ali?=") == "Sara Ali")
}

test "B words decode with and without padding, in either case" {
  assert(decoded("=?utf-8?b?U2FyYQ==?=") == "Sara")
  assert(decoded("=?UTF-8?B?U2FyYQ?=") == "Sara")
  assert(decoded("=?UTF-8?B?U2FyYSBBbGk?=") == "Sara Ali")
}

test "Q words decode underscores and escapes in either hex case" {
  assert(decoded("=?UTF-8?Q?a_b=3d=3D?=") == "a b==")
}

test "ISO-8859-1 and Windows-1252 decode to UTF-8" {
  assert(decoded("=?ISO-8859-1?Q?Fran=E7ois?=") == "François")
  assert(decoded("=?latin1?Q?=FC?=") == "ü")
  assert(decoded("=?windows-1252?Q?=93hi=94?=") == "\u{201c}hi\u{201d}")
}

test "a Windows-1252 byte the code page leaves undefined is refused" {
  let r = decodeWords("=?windows-1252?Q?=81?=") catch e {
    e.message()
  }
  assert(r == "mail: an encoded word has a byte undefined in Windows-1252")
}
