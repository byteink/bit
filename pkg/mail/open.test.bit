// pkg/mail/open.test.bit — `open(url, opts)`: what a URL may name and how each
// mistake is refused, all before any connection exists. Every URL here that
// can carry a password carries `s3cret-pw`, and every refusal is checked for
// it.

import { remove, writeFile } from "std/fs"
import { envOr } from "std/os"

const opPass: string = "s3cret-pw"

// The text of the failure `open(url)` reports, or "ok". Asserts the failure is
// a `Config` and that it never repeats the password.
fn opSetup(url: string): string {
  open(url) catch e {
    match (e) {
      Config(_) => {}
      _ => assert(false, "want Config, got ${e.message()}")
    }
    assert(!contains(e.message(), opPass), "the error repeated the password: ${e.message()}")
    return e.message()
  }
  return "ok"
}

fn opRefused(url: string, want: string) {
  let got = opSetup(url)
  assert(contains(got, want), "wanted '${want}' in: ${got}")
}

test "the smtp and smtps forms open" {
  assert(opSetup("smtps://hello%40inkwell.dev:${opPass}@smtp.example.com") == "ok", "smtps")
  assert(opSetup("smtp://hello:${opPass}@smtp.example.com:2525") == "ok", "smtp with a port")
  assert(opSetup("smtp://localhost:1025?tls=off") == "ok", "tls=off")
  assert(opSetup("smtp://smtp.example.com/") == "ok", "a trailing slash")
  assert(
      opSetup("SMTPS://smtp.example.com?serverName=mail.example.com&insecureSkipVerify=false") ==
      "ok",
    "params",
  )
}

test "an empty url, a missing scheme and an unknown scheme are refused naming the form" {
  opRefused("", "open needs a URL like smtps://user:pass@smtp.example.com; got an empty string")
  opRefused("smtp.example.com", "open needs a URL like smtps://user:pass@smtp.example.com")
  opRefused("imap://hello:${opPass}@mail.example.com", "unknown URL scheme 'imap'")
  opRefused("hello:${opPass}@x://mail.example.com", "unknown URL scheme '?'")
}

test "a missing host, a bad port and a path are refused" {
  opRefused("smtps://", "names no host")
  opRefused("smtps://hello:${opPass}@", "names no host")
  opRefused("smtps://hello:${opPass}@mail.example.com:0", "port 0 is outside 1..65535")
  opRefused("smtps://hello:${opPass}@mail.example.com:65536", "port 65536 is outside 1..65535")
  opRefused("smtps://hello:${opPass}@mail.example.com:${opPass}", "the port is not a number")
  opRefused("smtps://hello:${opPass}@mail.example.com:", "the port is not a number")
  opRefused("smtps://hello:${opPass}@mail.example.com/inbox", "has a path")
  opRefused("smtps://:${opPass}@mail.example.com", "empty username")
  opRefused("smtps://hello:${opPass}@[::1]:465", "bracketed")
}

test "an unknown or repeated query parameter and a bad value are refused" {
  opRefused(
    "smtps://hello:${opPass}@mail.example.com?starttls=1",
    "unknown query parameter 'starttls'",
  )
  opRefused("smtps://hello:${opPass}@mail.example.com?tls=opportunistic", "tls must be 'off'")
  opRefused("smtps://hello:${opPass}@mail.example.com?tls=on", "tls must be 'off'")
  opRefused("smtp://mail.example.com?tls=off&tls=off", "'tls' is given twice")
  opRefused(
    "smtps://hello:${opPass}@mail.example.com?insecureSkipVerify=yes",
    "must be 'true' or 'false'",
  )
  opRefused("smtps://hello:${opPass}@mail.example.com?serverName=", "no value")
  opRefused("smtps://hello:${opPass}@mail.example.com?&", "empty parameter")
}

test "tls=off with credentials, with smtps or with a TLS parameter fails at open" {
  opRefused(
    "smtp://hello:${opPass}@localhost:1025?tls=off",
    "smtp://hello:***@localhost:1025 carries credentials with tls=off",
  )
  opRefused(
    "smtp://hello@localhost:1025?tls=off",
    "smtp://hello@localhost:1025 carries credentials",
  )
  opRefused("smtps://localhost?tls=off", "tls=off is for smtp:// only")
  opRefused(
    "smtp://localhost?tls=off&insecureSkipVerify=true",
    "insecureSkipVerify has no effect with tls=off",
  )
}

test "userinfo is percent-decoded and a bad or control escape is refused" {
  opRefused("smtps://hello%4:${opPass}@mail.example.com", "cut-short percent-escape")
  opRefused("smtps://hello:${opPass}%zz@mail.example.com", "the password has a bad percent-escape")
  opRefused("smtps://hello:${opPass}%0d%0a@mail.example.com", "the password has a control byte")
}

test "caFile is read at open: a missing file and a file with no certificate are refused" {
  opRefused(
    "smtps://hello:${opPass}@mail.example.com?caFile=/no/such/ca.pem",
    "caFile /no/such/ca.pem cannot be read",
  )
  let path = "${envOr("TMPDIR", "/tmp")}/bit-mail-open-${timeUnixNs()}.pem"
  writeFile(path, "not a certificate\n") catch e {
    assert(false, "writeFile: ${e.message()}")
    return
  }
  let got = opSetup("smtps://hello:${opPass}@mail.example.com?caFile=${path}")
  remove(path) catch _ {}
  assert(contains(got, "holds no usable certificate"), got)
}

test "an Options mistake still fails at open, as Config" {
  open("smtps://mail.example.com", Options{ timeout = 0 }) catch e {
    match (e) {
      Config(why) => assert(contains(why, "Options.timeout"), why)
      _ => assert(false, "want Config, got ${e.message()}")
    }
    return
  }
  assert(false, "a zero timeout was accepted")
}

test "the transport prints the URL with the password hidden" {
  let t = parseTarget("smtp://hello%40inkwell.dev:${opPass}@mail.example.com") catch e {
    assert(false, "parse: ${e.message()}")
    return
  }
  let tr = SmtpTransport(t, "inkwell.dev", Options{})
  assert(tr.toString() == "smtp://hello%40inkwell.dev:***@mail.example.com:587", tr.toString())
  assert(t.user == "hello@inkwell.dev" && t.pass == opPass, "userinfo was not decoded")
}
