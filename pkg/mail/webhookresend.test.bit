// pkg/mail/webhookresend.test.bit — Resend webhooks: the Standard Webhooks
// published vector, the Svix signature checks (flipped byte, clock, missing and
// rotated signatures), the event mapping, and the errors that must never echo
// the secret.

import { contains, repeat, replace } from "std/strings"
import { decodeBase64, encodeBase64, hmac, HashAlg } from "std/crypto"
import { Timestamp, Second, Minute, now } from "std/time"

// The secret, message id, time and body of the Standard Webhooks reference
// libraries' own sign test (standard-webhooks/libraries/go/webhook_test.go,
// TestWebhookSign), and the signature they expect for them.
const whSecret: string = "whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw"
const whVecId: string = "msg_p5jXN8AQM9LWM0D4loKWxJek"
const whVecTs: int = 1614265330
const whVecBody: string = "{\"test\": 2432232314}"
const whVecSig: string = "v1,g0hM9SsE+OTPJTGt/tmIKtSyZlE3uFJELVlNIOLJ1OE="

// `v1,<base64 HMAC>` for a request, made the way a sender makes it.
fn whSign(secret: string, id: string, ts: string, body: string): string {
  let key = decodeBase64(secret[6:]) catch e {
    panic("test secret: ${e.message()}")
  }
  return "v1," + encodeBase64(hmac(HashAlg.Sha256, key, []byte("${id}.${ts}.${body}")))
}

// Request headers as a lookup, like the server's.
class WhReq {
  names: []string,
  values: []string,
}

fn whReq(id: string, ts: string, sig: string): WhReq {
  return WhReq{ names = ["svix-id", "svix-timestamp", "svix-signature"], values = [id, ts, sig] }
}

fn whHeader(r: WhReq): (string) => string {
  return (name) => {
    let i = 0
    while (i < len(r.names)) {
      if (r.names[i] == name) {
        return r.values[i]
      }
      i = i + 1
    }
    return ""
  }
}

// The instant `secs` seconds after the Unix epoch.
fn whAt(secs: int): Timestamp {
  return Timestamp{ ns = secs * Second }
}

// The events of a request signed for `ts`, judged at `at`.
fn whRun(body: string, ts: int, at: Timestamp): []Event!MailError {
  let sig = whSign(whSecret, whVecId, "${ts}", body)
  return webhookEvents(Provider.Resend, whHeader(whReq(whVecId, "${ts}", sig)), body, whSecret, at)?
}

// "ok" when `webhookEvents` accepts the request, else the variant name and the
// text of its failure.
fn whVerdict(
  p: Provider,
  h: (string) => string,
  body: string,
  secret: string,
  at: Timestamp,
): string {
  webhookEvents(p, h, body, secret, at) catch e {
    match (e) {
      Auth(rep) => return "Auth: ${rep.text}"
      Invalid(why) => return "Invalid: ${why}"
      Config(why) => return "Config: ${why}"
      _ => return "other: ${e.message()}"
    }
  }
  return "ok"
}

// The verdict for `body` signed correctly for `ts` and judged at `at`.
fn whRunV(body: string, ts: int, at: Timestamp): string {
  let sig = whSign(whSecret, whVecId, "${ts}", body)
  return whVerdict(Provider.Resend, whHeader(whReq(whVecId, "${ts}", sig)), body, whSecret, at)
}

const whBounced: string = "{\"type\":\"email.bounced\",\"created_at\":\"2026-11-22T23:41:12.126Z\",\"data\":{\"email_id\":\"56761188-7520-42d8-8898-ff6fc54ce618\",\"message_id\":\"<111-222-333@email.example.com>\",\"from\":\"Inkwell <hello@inkwell.dev>\",\"to\":[\"sara@example.com\",\"omar@example.com\"],\"subject\":\"Welcome\",\"bounce\":{\"message\":\"mailbox unavailable\",\"type\":\"Permanent\",\"subType\":\"General\"}}}"

fn whEvents(body: string): []Event {
  return whRun(body, 1700000000, whAt(1700000000)) catch e {
    panic("whEvents: ${e.message()}")
  }
}

test "the Standard Webhooks reference vector is the signature this test signs with" {
  let got = whSign(whSecret, whVecId, "${whVecTs}", whVecBody)
  assert(got == whVecSig, got)
}

test "the reference vector verifies, under svix- and under webhook- header names" {
  // The vector body is not Resend JSON, so "ok" cannot come from the parser:
  // it is `[]`, an unmapped type, and only after the signature matched.
  let svix = whHeader(whReq(whVecId, "${whVecTs}", whVecSig))
  let r1 = whVerdict(Provider.Resend, svix, whVecBody, whSecret, whAt(whVecTs))
  assert(r1 == "ok", r1)
  let bad = whVerdict(Provider.Resend, svix, whVecBody + " ", whSecret, whAt(whVecTs))
  assert(bad == "Auth: the webhook signature does not match", bad)

  let std = WhReq{
    names = ["webhook-id", "webhook-timestamp", "webhook-signature"],
    values = [whVecId, "${whVecTs}", whVecSig],
  }
  let r2 = whVerdict(Provider.Resend, whHeader(std), whVecBody, whSecret, whAt(whVecTs))
  assert(r2 == "ok", r2)
}

test "a signed bounce parses into one Event per recipient" {
  let evs = whEvents(whBounced)
  assert(len(evs) == 2, "events: ${len(evs)}")
  let e = evs[0]
  assert(e.kind == EventKind.Bounced, "kind")
  assert(e.recipient == "sara@example.com", e.recipient)
  assert(evs[1].recipient == "omar@example.com", evs[1].recipient)
  assert(e.messageId == "<111-222-333@email.example.com>", e.messageId)
  assert(e.providerId == "56761188-7520-42d8-8898-ff6fc54ce618", e.providerId)
  assert(e.deliveryId == whVecId, e.deliveryId)
  assert(e.permanent, "Permanent is permanent")
  assert(e.reason == "mailbox unavailable", e.reason)
  assert(e.provider == Provider.Resend, "provider")
  assert(e.at.toString() == "2026-11-22T23:41:12.126000000Z", e.at.toString())
}

test "a Temporary bounce is not permanent and a bounce with no type is" {
  let temp = whEvents(replace(whBounced, "Permanent", "Temporary"))
  assert(!temp[0].permanent, "Temporary")
  let typeless = whEvents("{\"type\":\"email.bounced\",\"data\":{\"to\":[\"a@example.com\"]}}")
  assert(typeless[0].permanent, "no bounce object")
}

test "every mapped type becomes its kind and an unknown type yields no events" {
  let types = [
    "email.delivered", "email.delivery_delayed", "email.bounced", "email.complained", "email.failed",
    "email.suppressed", "email.opened", "email.clicked",
  ]
  let kinds = [
    EventKind.Delivered, EventKind.Deferred, EventKind.Bounced, EventKind.Complained, EventKind.Rejected,
    EventKind.Rejected, EventKind.Opened, EventKind.Clicked,
  ]
  let i = 0
  while (i < len(types)) {
    let evs = whEvents("{\"type\":\"${types[i]}\",\"data\":{\"to\":[\"a@example.com\"]}}")
    assert(len(evs) == 1 && evs[0].kind == kinds[i], types[i])
    i = i + 1
  }
  assert(len(whEvents("{\"type\":\"contact.created\",\"data\":{}}")) == 0, "contact.created")
  assert(len(whEvents("{\"type\":\"domain.updated\"}")) == 0, "no data on an unmapped type")
}

test "a failed event carries its reason and only a bounce is ever permanent" {
  let f = whEvents("{\"type\":\"email.failed\",\"data\":{\"to\":[\"a@example.com\"],\"failed\":{\"reason\":\"reached_daily_quota\"}}}")
  assert(f[0].reason == "reached_daily_quota", f[0].reason)
  assert(!f[0].permanent, "failed")
}

test "the Message-ID falls back to the headers list" {
  let evs = whEvents("{\"type\":\"email.delivered\",\"data\":{\"to\":[\"a@example.com\"],\"headers\":[{\"name\":\"X-A\",\"value\":\"1\"},{\"name\":\"Message-Id\",\"value\":\"<m@x>\"}]}}")
  assert(evs[0].messageId == "<m@x>", evs[0].messageId)
}

test "a missing or bad created_at falls back to the delivery time" {
  let evs = whEvents("{\"type\":\"email.delivered\",\"created_at\":\"yesterday\",\"data\":{\"to\":[\"a@example.com\"]}}")
  assert(evs[0].at.ns == 1700000000 * Second, "${evs[0].at.ns}")
}

test "a flipped body byte fails Auth" {
  let sig = whSign(whSecret, whVecId, "1700000000", whBounced)
  let flipped = replace(whBounced, "sara", "sarb")
  let r = whVerdict(
    Provider.Resend,
    whHeader(whReq(whVecId, "1700000000", sig)),
    flipped,
    whSecret,
    whAt(1700000000),
  )
  assert(r == "Auth: the webhook signature does not match", r)
}

test "a changed id or timestamp fails Auth" {
  let sig = whSign(whSecret, whVecId, "1700000000", whBounced)
  let r1 = whVerdict(
    Provider.Resend,
    whHeader(whReq("msg_other", "1700000000", sig)),
    whBounced,
    whSecret,
    whAt(1700000000),
  )
  assert(r1 == "Auth: the webhook signature does not match", r1)
  let r2 = whVerdict(
    Provider.Resend,
    whHeader(whReq(whVecId, "1700000001", sig)),
    whBounced,
    whSecret,
    whAt(1700000000),
  )
  assert(r2 == "Auth: the webhook signature does not match", r2)
}

test "a timestamp 6 minutes old or 6 minutes ahead fails Auth" {
  let want = "Auth: the webhook timestamp is more than 5 minutes from now"
  let stale = whRunV(whBounced, 1700000000, Timestamp{ ns = 1700000000 * Second + 6 * Minute })
  assert(stale == want, stale)
  let ahead = whRunV(whBounced, 1700000000 + 360, whAt(1700000000))
  assert(ahead == want, ahead)
}

test "the window is exactly 5 minutes either way" {
  assert(whRunV(whBounced, 1700000000, whAt(1700000300)) == "ok", "300 s old")
  assert(whRunV(whBounced, 1700000300, whAt(1700000000)) == "ok", "300 s ahead")
  assert(whRunV(whBounced, 1700000000, whAt(1700000301)) != "ok", "301 s old")
  assert(whRunV(whBounced, 1700000301, whAt(1700000000)) != "ok", "301 s ahead")
}

test "a missing header is Auth naming it" {
  let sig = whSign(whSecret, whVecId, "1700000000", whBounced)
  let at = whAt(1700000000)
  let a = whVerdict(
    Provider.Resend,
    whHeader(whReq(whVecId, "1700000000", "")),
    whBounced,
    whSecret,
    at,
  )
  assert(a == "Auth: the svix-signature header is missing", a)
  let b = whVerdict(
    Provider.Resend,
    whHeader(whReq("", "1700000000", sig)),
    whBounced,
    whSecret,
    at,
  )
  assert(b == "Auth: the svix-id header is missing", b)
  let c = whVerdict(Provider.Resend, whHeader(whReq(whVecId, "", sig)), whBounced, whSecret, at)
  assert(c == "Auth: the svix-timestamp header is missing", c)
}

test "a timestamp that is not plain digits fails Auth" {
  let sig = whSign(whSecret, whVecId, "1700000000", whBounced)
  for ts of ["+1700000000", " 1700000000", "1700000000.5", "0x66", "-1", "17000000000"] {
    let r = whVerdict(
      Provider.Resend,
      whHeader(whReq(whVecId, ts, sig)),
      whBounced,
      whSecret,
      whAt(1700000000),
    )
    assert(r == "Auth: the webhook timestamp is not a Unix time in seconds", "${ts}: ${r}")
  }
}

test "two v1 signatures where only the second matches pass" {
  let good = whSign(whSecret, whVecId, "1700000000", whBounced)
  let old = whSign(
    "whsec_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
    whVecId,
    "1700000000",
    whBounced,
  )
  let both = old + " " + good
  let r = whVerdict(
    Provider.Resend,
    whHeader(whReq(whVecId, "1700000000", both)),
    whBounced,
    whSecret,
    whAt(1700000000),
  )
  assert(r == "ok", r)
  let first = whVerdict(
    Provider.Resend,
    whHeader(whReq(whVecId, "1700000000", good + " " + old)),
    whBounced,
    whSecret,
    whAt(1700000000),
  )
  assert(first == "ok", first)
}

test "only v1 entries count, and junk entries are skipped" {
  let good = whSign(whSecret, whVecId, "1700000000", whBounced)
  let b64 = good[3:]
  let at = whAt(1700000000)
  for sigs of [
    "v2," + b64,
    "v1a," + b64,
    b64,
    "v1," + b64 + "x",
    "v1,",
    "v1,!!!",
    "v1,a,b",
    ",",
    "  ",
  ] {
    let r = whVerdict(
      Provider.Resend,
      whHeader(whReq(whVecId, "1700000000", sigs)),
      whBounced,
      whSecret,
      at,
    )
    assert(r != "ok", "accepted '${sigs}'")
  }
  let mixed = "v2,${b64} v1,AAAA  ${good}"
  let ok = whVerdict(
    Provider.Resend,
    whHeader(whReq(whVecId, "1700000000", mixed)),
    whBounced,
    whSecret,
    at,
  )
  assert(ok == "ok", ok)
}

test "the signature is checked before the JSON is read" {
  let r = whVerdict(
    Provider.Resend,
    whHeader(whReq(whVecId, "1700000000", "v1,AAAA")),
    "not json",
    whSecret,
    whAt(1700000000),
  )
  assert(r == "Auth: the webhook signature does not match", r)
  let signed = whRunV("not json", 1700000000, whAt(1700000000))
  assert(signed == "Invalid: Resend webhook body is not valid JSON", signed)
}

test "a signed payload whose data or to is malformed is Invalid" {
  let nodata = whRunV("{\"type\":\"email.bounced\"}", 1700000000, whAt(1700000000))
  assert(nodata == "Invalid: Resend webhook has no data object", nodata)
  let badto = whRunV(
    "{\"type\":\"email.bounced\",\"data\":{\"to\":\"a@example.com\"}}",
    1700000000,
    whAt(1700000000),
  )
  assert(badto == "Invalid: Resend webhook data.to is not a list", badto)
  let badaddr = whRunV(
    "{\"type\":\"email.bounced\",\"data\":{\"to\":[7]}}",
    1700000000,
    whAt(1700000000),
  )
  assert(contains(badaddr, "not an address"), badaddr)
}

test "a secret that cannot be a signing secret is a Config that never echoes it" {
  let h = whHeader(whReq(whVecId, "1700000000", whVecSig))
  for secret of ["", "whsec_", "MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw", "whsec_not base64!"] {
    let v = whVerdict(Provider.Resend, h, whBounced, secret, whAt(1700000000))
    assert(contains(v, "Config: "), "'${secret}': ${v}")
    assert(!contains(v, "not base64!") && !contains(v, "MfKQ9r8"), v)
  }
}

test "no error text holds the secret" {
  let key = whSecret[6:]
  let h = whHeader(whReq(whVecId, "1700000000", "v1,AAAA"))
  let v = whVerdict(Provider.Resend, h, whBounced, whSecret, whAt(1700000000))
  assert(v == "Auth: the webhook signature does not match", v)
  assert(!contains(v, key), v)
  parseEvents(Provider.Resend, h, whBounced, whSecret) catch e {
    assert(!contains(e.message(), key), e.message())
    return
  }
  assert(false, "accepted a bad signature")
}

test "a body over 1 MiB is Invalid before it is hashed" {
  let big = repeat("a", 1048577)
  let r = whVerdict(
    Provider.Resend,
    whHeader(whReq(whVecId, "1700000000", "v1,AAAA")),
    big,
    whSecret,
    whAt(1700000000),
  )
  assert(r == "Invalid: webhook body is over 1 MiB", r)
  let edge = whRunV(repeat(" ", 1048576), 1700000000, whAt(1700000000))
  assert(edge == "Invalid: Resend webhook body is not valid JSON", edge)
}

test "the other providers are not supported yet" {
  let h = whHeader(whReq(whVecId, "1700000000", whVecSig))
  let names = [
    "Postmark webhooks are not supported yet", "SES webhooks are not supported yet",
    "SendGrid webhooks are not supported yet", "Mailgun webhooks are not supported yet",
  ]
  let ps = [Provider.Postmark, Provider.Ses, Provider.SendGrid, Provider.Mailgun]
  let i = 0
  while (i < len(ps)) {
    let r = whVerdict(ps[i], h, whBounced, whSecret, whAt(1700000000))
    assert(r == "Invalid: ${names[i]}", r)
    i = i + 1
  }
}

test "parseEvents reads the real clock" {
  let ts = "${now().ns / Second}"
  let sig = whSign(whSecret, whVecId, ts, whBounced)
  let evs = parseEvents(Provider.Resend, whHeader(whReq(whVecId, ts, sig)), whBounced, whSecret) catch e {
    panic("parseEvents: ${e.message()}")
  }
  assert(len(evs) == 2, "events: ${len(evs)}")
  let stale = "${now().ns / Second - 600}"
  let old = whSign(whSecret, whVecId, stale, whBounced)
  parseEvents(Provider.Resend, whHeader(whReq(whVecId, stale, old)), whBounced, whSecret) catch e {
    match (e) {
      Auth(rep) => {
        assert(rep.text == "the webhook timestamp is more than 5 minutes from now", rep.text)
        return
      }
      _ => panic(e.message())
    }
  }
  assert(false, "a 10 minute old request was accepted")
}
