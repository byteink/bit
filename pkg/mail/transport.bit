// pkg/mail/transport.bit — what a `Mailer` hands to the thing that moves mail,
// and what comes back. A transport is any class with `deliver` and `close`
// (SPEC §14.3, structural): `Outbox` records mail for tests, and a network
// transport speaks to a server. The `Mailer` has already checked and rendered
// the message, so a transport only moves bytes and reports what happened.

// One address a server refused while accepting the others, and why.
export class Rejection {
  export address: string,
  export reply: Reply,
}

// What the transport reports for one delivery.
export class Receipt {
  // The Message-ID of the mail as written in its header, `<welcome-7@inkwell.dev>`.
  export id: string = "",
  // The provider's own id for the mail, "" when the transport has none.
  export providerId: string = "",
  // The envelope recipients that took the mail.
  export accepted: []string = [],
  // The recipients that did not, with the server's reason for each.
  export rejected: []Rejection = [],
  // True when the transport only took the mail to send later.
  export queued: bool = false,
  // Which transport delivered it when `Options.fallback` is set: its URL as
  // `smtps://***@smtp.example.com`, the userinfo and query left out. "" when
  // `open` was given one URL.
  export transport: string = "",
}

// One mail ready to go, as the `Mailer` hands it to a transport.
export class Delivery {
  // The message as the caller wrote it. Under `Options.redirect` it is the
  // redirected one: `to` is the redirect address alone, `cc` and `bcc` are
  // empty and the original addresses are in the `X-Original-To` header.
  export message: Message,
  // Who it is from and every address it goes to, `bcc` included; under
  // `Options.redirect`, the redirect address alone.
  export envelope: Envelope,
  // The Message-ID of `raw`, as written in its header.
  export messageId: string,
  // The final bytes to send, headers and body. A transport sends them as they
  // are, so a signature over them stays valid.
  export raw: string,
}

// Whatever delivers a `Delivery`. `deliver` may be called from many tasks at
// once and must be safe for that.
export interface Transport {
  deliver(d: Delivery): Receipt!MailError,
  // True when the bytes in `Delivery.raw` are the bytes that reach the
  // recipient, so a DKIM signature over them stays valid: SMTP, `Outbox`, a
  // file, an API that takes the raw MIME. False for an API that takes fields
  // and builds the message itself; `Mailer(...)` then refuses `Options.dkim`,
  // because the provider's own signature is the one that counts.
  signs(): bool,
  close(),
}
