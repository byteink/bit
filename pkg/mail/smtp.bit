// pkg/mail/smtp.bit — the SMTP `Transport` `open` returns (open.bit parses the
// URL). Sessions come from a pool (smtppool.bit): connect, EHLO, TLS and login
// happen once per session, then `Client.send` runs once per transaction, and a
// session is quit when it is retired or the mailer is closed.
//
// The TLS rule: `smtps://` is TLS from the first byte; `smtp://` runs STARTTLS
// and a server that does not offer it fails the send with a `Config` error.
// There is no path from here to a plaintext session except `?tls=off`, which
// open.bit only allows without credentials.

import { Auth, Client, Delivery as SmtpDelivery, SmtpError, dial, dialTls } from "std/smtp"

const smtpUtf8Refusal: string = "the message needs SMTPUTF8, which the server does not offer"
const smtpBodyRefusal: string = "the message has 8-bit data and the server does not offer 8BITMIME"
const smtpDsnRefusal: string = "delivery notifications were requested and the server does not offer DSN"
const smtpTlsRefusal: string = "REQUIRETLS was requested and the server does not offer REQUIRETLS"
const smtpTlsPlain: string = "REQUIRETLS was requested and the connection is not TLS"
const smtpTlsUnverified: string = "REQUIRETLS was requested and the server certificate was not verified"

class SmtpTransport {
  t: Target
  hello: string
  sessions: SessionPool

  // `opts.pool` sessions at most, `opts.timeout` for every wait. Nothing is
  // connected until the first `deliver`.
  init(t: Target, hello: string, opts: Options, idleAfter: int = idleProbeAfter) {
    this.t = t
    this.hello = hello
    let dialIt: () => Client!MailError = () => {
      return this.connect()?
    }
    let liftIt: (SmtpError) => MailError = (e) => {
      return this.lift(e)
    }
    this.sessions = SessionPool(dialIt, liftIt, opts, idleAfter)
  }

  // Sends `d` over a pooled session. A refusal from the server maps to
  // `MailError`: 535, 534 and 530 to `Auth`, a 4xx or a network failure to
  // `Transient`, a local input refusal to `Invalid`, and a missing required
  // international-mail capability or other permanent failure to `Rejected`.
  // Recipients the server refused while taking
  // the rest are in `Receipt.rejected`. More recipients than the server's
  // `RCPTMAX` go in several transactions; the `Receipt` merges them, and a
  // transaction that fails after another took the mail lists its recipients,
  // and every later one, as rejected rather than failing the send.
  export deliver(d: Delivery): Receipt!MailError {
    let rest = d.envelope.to
    if (len(rest) == 0) {
      fail MailError.Invalid("the envelope has no recipients")
    }
    let r = Receipt{ id = d.messageId }
    while (len(rest) > 0) {
      let p = this.sessions.send(d.envelope, rest, d.raw) catch e {
        let why = this.deliveryError(d, e)
        if (len(r.accepted) == 0 && len(r.rejected) == 0) {
          fail why
        }
        for x of rejectAll(rest, why) {
          r.rejected = append(r.rejected, x)
        }
        return r
      }
      mergeReceipt(r, this.receipt(d, p.out))
      rest = rest[p.n:]
    }
    return r
  }

  // The server gets `Delivery.raw` as it is.
  export signs(): bool {
    return true
  }

  // Connects, negotiates TLS, says EHLO, logs in and quits, on a session of its
  // own that is not taken from the pool: the same steps and the same errors as
  // the first send, with no message. A QUIT the server answers badly is not a
  // problem with the setup.
  export check(): ()!MailError {
    let c = this.connect()?
    c.quit() catch _ {}
  }

  // Quits the idle sessions; later sends fail `Invalid("mailer is closed")`.
  export close() {
    this.sessions.close()
  }

  // The URL with the password hidden, `smtp://user:***@host:587`.
  export toString(): string {
    return this.t.display
  }

  // A connection that is greeted, encrypted and logged in, or an error with
  // the socket closed.
  connect(): Client!MailError {
    let c = this.dialServer()?
    this.prepare(c) catch e {
      c.close()
      fail e
    }
    return c
  }

  dialServer(): Client!MailError {
    if (this.t.implicit) {
      return dialTls(this.t.host, this.t.port, this.t.tls) catch e {
        fail this.lift(e)
      }
    }
    return dial(this.t.host, this.t.port, this.t.tls) catch e {
      fail this.lift(e)
    }
  }

  // EHLO, STARTTLS (required unless `tls=off`), EHLO again, login.
  prepare(c: Client): ()!MailError {
    c.ehlo(this.hello) catch e {
      fail this.lift(e)
    }
    if (!this.t.implicit && !this.t.plain) {
      this.upgrade(c)?
    }
    if (this.t.hasUser) {
      let a = this.chooseAuth(c.authMechanisms())?
      c.auth(a) catch e {
        fail this.lift(e)
      }
    }
  }

  upgrade(c: Client): ()!MailError {
    if (!c.supports("STARTTLS")) {
      fail MailError.Config("${this.t.display} does not offer STARTTLS; for a local test server use smtp://${this.t.host}:${this.t.port}?tls=off")
    }
    c.startTls(this.t.tls) catch e {
      fail this.lift(e)
    }
    c.ehlo(this.hello) catch e {
      fail this.lift(e)
    }
  }

  // PLAIN when the server offers it, else LOGIN.
  chooseAuth(offered: []string): Auth!MailError {
    if (hasMech(offered, "PLAIN")) {
      return Auth.Plain(this.t.user, this.t.pass)
    }
    if (hasMech(offered, "LOGIN")) {
      return Auth.Login(this.t.user, this.t.pass)
    }
    let list = "nothing"
    if (len(offered) > 0) {
      list = join(offered, " ")
    }
    fail MailError.Config("${this.t.display}: the server offers AUTH ${list}; this package logs in with PLAIN or LOGIN")
  }

  // `e` as a `MailError`. The text carries no password even if a server echoed
  // one.
  lift(e: SmtpError): MailError {
    let r = this.reply(e)
    if (e.command == "validate") {
      if (extensionRefusal(e.text)) {
        return MailError.Rejected(r)
      }
      return MailError.Invalid(r.text)
    }
    if (e.code == 535 || e.code == 534 || e.code == 530) {
      return MailError.Auth(r)
    }
    if (e.transient()) {
      return MailError.Transient(r)
    }
    return MailError.Rejected(r)
  }

  // Server capability limits are permanent refusals; other local checks stay Invalid.
  deliveryError(d: Delivery, e: MailError): MailError {
    match (e) {
      Rejected(reply) => {
        if (reply.code != 0 || !this.capabilityText(reply.text)) {
          return e
        }
        let address = internationalDeliveryAddress(d)
        let context = reply.text
        if (address != "") {
          context = "${reply.text}: address ${echoInput(address)}"
        }
        return MailError.Rejected(
          Reply{
            code = reply.code, enhanced = reply.enhanced, text = this.scrub(context),
          },
        )
      }
      _ => return e
    }
  }

  // Redaction can replace a capability name when the password equals that name.
  capabilityText(text: string): bool {
    return text == this.scrub(smtpUtf8Refusal) || text == this.scrub(smtpBodyRefusal)
  }

  // The `Reply` for `e`; with no reply code the text names the step that failed.
  reply(e: SmtpError): Reply {
    let text = e.text
    if (e.code == 0 && e.command != "validate") {
      text = "${e.command}: ${e.text}"
    }
    return Reply{ code = e.code, enhanced = e.enhanced, text = this.scrub(text) }
  }

  scrub(s: string): string {
    if (this.t.pass == "") {
      return s
    }
    return replace(s, this.t.pass, "***")
  }

  receipt(d: Delivery, out: SmtpDelivery): Receipt {
    let no: []Rejection = []
    for r of out.rejected {
      no = append(no, Rejection{ address = r.address, reply = this.reply(r.error) })
    }
    return Receipt{
      id = d.messageId,
      providerId = out.queueId,
      accepted = out.accepted,
      rejected = no,
    }
  }
}

// These are the extension refusals, after the sole std/smtp classifier.
fn extensionRefusal(text: string): bool {
  return text == smtpUtf8Refusal ||
    text == smtpBodyRefusal ||
    text == smtpDsnRefusal ||
    text == smtpTlsRefusal ||
    text == smtpTlsPlain ||
    text == smtpTlsUnverified
}

fn internationalEmail(email: string): bool {
  for c of []byte(email) {
    if (c >= u8(128)) {
      return true
    }
  }
  return false
}

// Read the final envelope first; headers also cover a default Reply-To or raw queue job.
fn internationalDeliveryAddress(d: Delivery): string {
  if (internationalEmail(d.envelope.from)) {
    return d.envelope.from
  }
  for a of d.envelope.to {
    if (internationalEmail(a)) {
      return a
    }
  }
  return internationalHeaderAddress(d.raw)
}

fn addressHeader(name: string): bool {
  let lower = toLower(name)
  return lower == "from" || lower == "to" || lower == "cc" || lower == "reply-to"
}

// Only folds are removed for parsing; the signed bytes themselves are never changed.
fn internationalHeaderAddress(raw: string): string {
  let parts = splitMessage(raw) catch _ {
    return ""
  }
  for f of parts.0 {
    if (addressHeader(f.0)) {
      let addresses = parseAddressList(replace(f.1, "\r\n", "")) catch _ {
        continue
      }
      for a of addresses {
        if (internationalEmail(a.email)) {
          return a.email
        }
      }
    }
  }
  return ""
}

// `to`, each with the reply `e` stands for.
fn rejectAll(to: []string, e: MailError): []Rejection {
  let why = Reply{ text = e.message() }
  match (e) {
    Auth(r) => why = r
    Rejected(r) => why = r
    Transient(r) => why = r
    _ => why = Reply{ text = e.message() }
  }
  let out: []Rejection = []
  for a of to {
    out = append(out, Rejection{ address = a, reply = why })
  }
  return out
}

// Adds what `p`, one transaction's receipt, says to `r`; the first one's
// provider id stands for the message.
fn mergeReceipt(r: Receipt, p: Receipt) {
  if (r.providerId == "") {
    r.providerId = p.providerId
  }
  for a of p.accepted {
    r.accepted = append(r.accepted, a)
  }
  for x of p.rejected {
    r.rejected = append(r.rejected, x)
  }
}

fn hasMech(offered: []string, want: string): bool {
  for m of offered {
    if (m == want) {
      return true
    }
  }
  return false
}
