// pkg/mail/dkimwire.bit — `Options.dkim` inside a `Mailer`: the keys loaded
// and checked once when the mailer opens, and the per-message choice of which
// of them sign. The signer itself is dkim.bit.
//
// What is refused at open, all as `MailError.Config`: a key that does not load,
// two identities with one DNS name, an Ed25519 key with no RSA key for its
// domain (Gmail, Outlook and Yahoo verify RSA only, RFC 8463 leaves Ed25519
// optional for a verifier), a `d=` that DMARC cannot align with `Options.from`
// (RFC 7489 section 3.1.1, relaxed alignment: equal, or From a subdomain of
// `d=`), and a transport that does not send the bytes it is given.

// Whether `k` is an Ed25519 key.
fn isEd25519(k: DkimKey): bool {
  match (k.material) {
    Ed25519(_) => return true
    Rsa(_) => return false
  }
}

// `selector._domainkey.domain` of `k`, the way an error names it.
fn dkimName(k: DkimKey): string {
  return "${shown(k.selector)}._domainkey.${toLower(shown(k.domain))}"
}

// Whether a message From `from` aligns with a signature `d=` `d` under DMARC's
// relaxed mode: the same domain, or `from` a subdomain of `d`. Both are
// compared in lower case, as DNS names are.
fn dkimAligned(from: string, d: string): bool {
  let f = toLower(from)
  let k = toLower(d)
  return f == k || hasSuffix(f, ".${k}")
}

// Whether `list` already holds the DNS name of `k`.
fn dkimTaken(list: []DkimKey, k: DkimKey): bool {
  for o of list {
    if (toLower(o.domain) == toLower(k.domain) && o.selector == k.selector) {
      return true
    }
  }
  return false
}

// Whether `list` holds an RSA key signing for `domain`.
fn hasRsaFor(list: []DkimKey, domain: string): bool {
  for k of list {
    if (!isEd25519(k) && toLower(k.domain) == toLower(domain)) {
      return true
    }
  }
  return false
}

// Parses every identity in `list` once. The result keeps RSA first and Ed25519
// second, each in the order given: a verifier that reads only the first
// signature it understands then reads the one every receiver supports.
fn loadDkimKeys(list: []Dkim): []DkimKey!MailError {
  let all: []DkimKey = []
  let rsa: []DkimKey = []
  let ed: []DkimKey = []
  for d of list {
    let k = loadDkim(d)?
    if (dkimTaken(all, k)) {
      fail MailError.Config("Options.dkim: ${dkimName(k)} is listed twice; each key needs its own selector")
    }
    all = append(all, k)
    if (isEd25519(k)) {
      ed = append(ed, k)
    } else {
      rsa = append(rsa, k)
    }
  }
  for k of ed {
    if (!hasRsaFor(rsa, k.domain)) {
      fail MailError.Config("Options.dkim: ${dkimName(k)}: an Ed25519 DKIM key needs an RSA key beside it: Gmail, Outlook and Yahoo do not verify Ed25519 signatures")
    }
  }
  for k of ed {
    rsa = append(rsa, k)
  }
  return rsa
}

// The startup checks that need the transport and `Options.from` beside the
// keys. An empty `from` skips the alignment check: every message then names
// its own sender, and `dkimKeysFor` checks each one.
fn checkDkimWire(keys: []DkimKey, from: string, t: Transport): ()!MailError {
  if (len(keys) == 0) {
    return
  }
  if (!t.signs()) {
    fail MailError.Config(
      "Options.dkim: this transport hands the message to a provider that builds it itself and signs with its own DKIM key; configure DKIM with the provider and remove Options.dkim",
    )
  }
  if (from == "") {
    return
  }
  let domain = domainOf(parseAddress(from)?.email)
  for k of keys {
    if (!dkimAligned(domain, k.domain)) {
      fail MailError.Config("Options.dkim: ${dkimName(k)} signs d=${shown(k.domain)}, which does not align with the domain of Options.from (${shown(domain)}); DMARC would fail")
    }
  }
}

// The keys that sign a message From `domain`, in key order. Empty when none
// aligns, which `Mailer` reports as `Invalid`.
fn dkimKeysFor(keys: []DkimKey, domain: string): []DkimKey {
  let out: []DkimKey = []
  for k of keys {
    if (dkimAligned(domain, k.domain)) {
      out = append(out, k)
    }
  }
  return out
}
