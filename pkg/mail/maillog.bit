// pkg/mail/maillog.bit — `Options.logger`: the four records a `Mailer` writes
// to std/log, see docs/observe.md. `Observer` (observe.bit) calls these; each
// takes the `Logger` it writes to.
//
//   INFO  mail sent     transport=smtps recipients=2 took=41ms
//   WARN  mail retry    transport=smtps attempt=1 error="mail: temporary failure: 451 4.7.1 Greylisted"
//   ERROR mail failed   transport=smtps error="mail: rejected: 550 5.1.1 ..."
//   WARN  mail refused  transport=smtps reason="mail: Message.subject is empty"
//
// NO ADDRESS, SUBJECT OR BODY IS EVER LOGGED. A record holds the transport
// scheme (observe.bit's `schemeOf`), counts, durations and an error message,
// and an error message can echo what the caller or the server was given: the
// refusal of an address quotes it (`address.bit`'s `refuse`), and a server
// replies `550 5.1.1 <sara@example.com>: Recipient address rejected`. So every
// message goes through `logText` first, which replaces each address with
// `[address]`. There is no switch that turns the redaction off.
//
// A level the logger has off costs nothing: std/log hands back one shared
// record that keeps no attribute, and the two records that build a string
// (`logText`) ask `enabled` first, so a disabled `mail retry` allocates
// nothing either.

import { Logger, LevelWarn, LevelError } from "std/log"

// The bytes that end a word when `redactAddresses` looks for an `@`.
const addrBreaks: string = "<>,;:\"'()[]"

// `logRefused`'s and `logFailed`'s text for `e`: its message with every address
// replaced by `[address]`.
fn logText(e: MailError): string {
  return redactAddresses(redactEcho(e.message()))
}

// `refuse` (address.bit) writes `invalid address "<input>": <reason>` for an
// input that may hold no `@` at all, so the quoted echo goes whole.
fn redactEcho(s: string): string {
  let lead = "invalid address \""
  let at = indexOf(s, lead)
  if (at < 0) {
    return s
  }
  let start = at + len(lead) - 1
  let i = start + 1
  while (i < len(s) && s[i] != dq) {
    if (s[i] == backslash) {
      i = i + 1
    }
    i = i + 1
  }
  i = i + 1
  if (i > len(s)) {
    i = len(s)
  }
  return s[0:start] + "[address]" + s[i:]
}

fn endsWord(c: u8): bool {
  return c <= space || indexOf(addrBreaks, string([c])) >= 0
}

// `s` with every word that holds an `@` replaced by `[address]`. A word runs
// to the next space or bracket, quote, comma, semicolon or colon, so
// `<sara@example.com>:` loses the address and keeps its punctuation.
fn redactAddresses(s: string): string {
  let out = Builder()
  let n = len(s)
  let i = 0
  while (i < n) {
    let j = i
    while (j < n && !endsWord(s[j])) {
      j = j + 1
    }
    if (contains(s[i:j], "@")) {
      out.write("[address]")
    } else {
      out.write(s[i:j])
    }
    if (j < n) {
      out.writeByte(s[j])
      j = j + 1
    }
    i = j
  }
  return out.toString()
}

// One delivery the transport took: how many recipients it was for, never who.
fn logSent(lg: Logger, scheme: string, recipients: int, tookNs: int) {
  lg.info().str("transport", scheme).int("recipients", recipients).duration("took", tookNs).log("mail sent")
}

// A try that failed `Transient` and will be repeated; `attempt` counts from 1.
fn logRetry(lg: Logger, scheme: string, attempt: int, e: MailError) {
  if (!lg.enabled(LevelWarn)) {
    return
  }
  lg.warn().str("transport", scheme).int("attempt", attempt).err(newError(logText(e))).log("mail retry")
}

// A send that ended in failure: the last try's error, after any retries.
fn logFailed(lg: Logger, scheme: string, e: MailError) {
  if (!lg.enabled(LevelError)) {
    return
  }
  lg.error().str("transport", scheme).err(newError(logText(e))).log("mail failed")
}

// A message turned away before any transport saw it, and why.
fn logRefused(lg: Logger, scheme: string, e: MailError) {
  if (!lg.enabled(LevelWarn)) {
    return
  }
  lg.warn().str("transport", scheme).str("reason", logText(e)).log("mail refused")
}
