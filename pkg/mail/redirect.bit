// pkg/mail/redirect.bit — `Options.redirect`, staging's safety net: every mail
// goes to one address, and nothing in the message can reach a real customer.
//
// What a redirected message is:
//   * the envelope (`RCPT TO`) is exactly the redirect address, so To, Cc and
//     Bcc are never delivered to;
//   * the `To:` and `Cc:` header lines stay as written, for realism, and
//     `X-Original-To` lists those same addresses, so a tester can see who the
//     mail would have gone to;
//   * `Bcc` is in no header, as ever, and so not in `X-Original-To` either: a
//     blind recipient stays blind in staging too;
//   * the Subject starts with `[redirected] `.
//
// It is applied by `Mailer.send` and `Mailer.render` before the DKIM signature,
// so the signature covers the bytes that are delivered, and before the
// `Delivery` reaches the transport, so a transport that builds the mail from
// `Delivery.message` (a JSON API) sees the redirect address as its only
// recipient. A mailer that sits behind a queue applies it at send time, so a
// job enqueued on staging cannot reach an original recipient.

// The Subject prefix of a redirected message.
const redirectPrefix: string = "[redirected] "

// The header that keeps the original To and Cc addresses.
const originalToHeader: string = "X-Original-To"

// A message ready to deliver: what the transport is told, and its bytes.
class Staged {
  message: Message,
  rendered: Rendered,
}

// A copy of `m` that can be changed without touching the caller's message.
fn copyMessage(m: Message): Message {
  let headers = map<string, string>()
  for name of keys(m.headers) {
    headers[name] = m.headers[name]
  }
  return Message{
    from = m.from,
    to = m.to,
    cc = m.cc,
    bcc = m.bcc,
    replyTo = m.replyTo,
    subject = m.subject,
    text = m.text,
    html = m.html,
    attachments = m.attachments,
    headers = headers,
    tags = m.tags,
    inReplyTo = m.inReplyTo,
    references = m.references,
    id = m.id,
    invite = m.invite,
  }
}

// The To and Cc addresses of `m` as `X-Original-To` lists them, each once, or
// "" when `m` has neither. A bad address fails as `to[1]` does at render.
fn originalList(m: Message): string!MailError {
  let out: []string = []
  for a of parseFields("to", m.to)? {
    out = appendNew(out, a.email)
  }
  for a of parseFields("cc", m.cc)? {
    out = appendNew(out, a.email)
  }
  return join(out, ", ")
}

// `m` rendered for delivery to `redirect` alone (its bare address). The message
// kept for the transport has `redirect` as its one recipient and the original
// To and Cc only in `X-Original-To`. A message that is incomplete is refused
// as it would be without a redirect, before the Subject gets its prefix.
fn stage(m: Message, d: Defaults, redirect: string): Staged!MailError {
  if (redirect == "") {
    return Staged{ message = m, rendered = renderMessage(m, d)? }
  }
  checkComplete(m, d)?
  let s = copyMessage(m)
  s.subject = redirectPrefix + m.subject
  let originals = originalList(m)?
  if (originals != "") {
    s.headers[originalToHeader] = originals
  }
  let r = renderMessage(s, d)?
  r.envelope.to = [redirect]
  let sent = copyMessage(s)
  sent.to = [redirect]
  sent.cc = []
  sent.bcc = []
  return Staged{ message = sent, rendered = r }
}
