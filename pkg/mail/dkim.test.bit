// RFC 8463 A.3's message: five fields and a body.
const rfcMsg: string = "From: Joe SixPack <joe@football.example.com>\r\n" +
  "To: Suzie Q <suzie@shopping.example.net>\r\n" +
  "Subject: Is dinner ready?\r\n" +
  "Date: Fri, 11 Jul 2003 21:00:37 -0700 (PDT)\r\n" +
  "Message-ID: <20030712040037.46341.5F8J@football.example.com>\r\n" +
  "\r\n" +
  "Hi.\r\n\r\nWe lost the game.  Are you hungry yet?\r\n\r\nJoe.\r\n"

const rfcBh: string = "2jUSOH9NhtVGCQWNr9BrIAPreKQjO6Sn7XIkfJVOzv8="

// The two signature headers of A.3 up to and including the empty `b=`, with the
// RFC's own folds. They carry `i=` and `q=`, which `dkimSign` never writes, so
// they are the input of `dkimSignature` and not of `dkimSign`.
const rfcEdHeader: string = "DKIM-Signature: v=1; a=ed25519-sha256; c=relaxed/relaxed;\r\n" +
  " d=football.example.com; i=@football.example.com;\r\n" +
  " q=dns/txt; s=brisbane; t=1528637909; h=from : to :\r\n" +
  " subject : date : message-id : from : subject : date;\r\n" +
  " bh=2jUSOH9NhtVGCQWNr9BrIAPreKQjO6Sn7XIkfJVOzv8=;\r\n" +
  " b="
const rfcRsaHeader: string = "DKIM-Signature: v=1; a=rsa-sha256; c=relaxed/relaxed;\r\n" +
  " d=football.example.com; i=@football.example.com;\r\n" +
  " q=dns/txt; s=test; t=1528637909; h=from : to : subject :\r\n" +
  " date : message-id : from : subject : date;\r\n" +
  " bh=2jUSOH9NhtVGCQWNr9BrIAPreKQjO6Sn7XIkfJVOzv8=;\r\n" +
  " b="
const rfcEdB: string = "/gCrinpcQOoIfuHNQIbq4pgh9kyIK3AQUdt9OdqQehSwhEIug4D11Bus" +
  "Fa3bT3FY5OsU7ZbnKELq+eXdp1Q1Dw=="
const rfcRsaB: string = "F45dVWDfMbQDGHJFlXUNB2HKfbCeLRyhDXgFpEL8GwpsRe0IeIixNTe3" +
  "DhCVlUrSjV4BwcVcOF6+FF3Zo9Rpo1tFOeS9mPYQTnGdaSGsgeefOsk2Jz" +
  "dA+L10TeYt9BgDfQNZtKdN1WO//KgIqXP7OdEFE4LjFYNcUxZQ4FADY+8="

fn rfcH(): []string {
  return []string{ "from", "to", "subject", "date", "message-id", "from", "subject", "date" }
}

// The same message with a second line of text in the body: a different bh.
const rfcMsgEdited: string = "From: Joe SixPack <joe@football.example.com>\r\n" +
  "To: Suzie Q <suzie@shopping.example.net>\r\n" +
  "Subject: Is dinner ready?\r\n" +
  "Date: Fri, 11 Jul 2003 21:00:37 -0700 (PDT)\r\n" +
  "Message-ID: <20030712040037.46341.5F8J@football.example.com>\r\n" +
  "\r\n" +
  "Hi.\r\n\r\nWe lost the game.  Are you hungry yet?\r\n\r\nJoe.\r\nP.S. hello\r\n"

// What a verifier hashes first for rfcMsg: each field relaxed, written out by
// hand, keyed by the lower-case name it is listed under.
fn rfcCanonField(name: string): string {
  if (name == "from") {
    return "from:Joe SixPack <joe@football.example.com>\r\n"
  }
  if (name == "to") {
    return "to:Suzie Q <suzie@shopping.example.net>\r\n"
  }
  if (name == "subject") {
    return "subject:Is dinner ready?\r\n"
  }
  if (name == "date") {
    return "date:Fri, 11 Jul 2003 21:00:37 -0700 (PDT)\r\n"
  }
  if (name == "message-id") {
    return "message-id:<20030712040037.46341.5F8J@football.example.com>\r\n"
  }
  return ""
}

fn mustLoad(domain: string, selector: string, key: string): DkimKey {
  return loadOf(Dkim{ domain = domain, selector = selector, key = key })
}

fn loadOf(d: Dkim): DkimKey {
  return loadDkim(d) catch e {
    panic("loadDkim failed: ${e.message()}")
  }
}

fn canonOf(data: string): DkimCanon {
  return dkimCanon(data) catch e {
    panic("dkimCanon failed: ${e.message()}")
  }
}

fn signOf(data: string, keys: []DkimKey): string {
  return dkimSign(data, keys, at("1528637909")) catch e {
    panic("dkimSign failed: ${e.message()}")
  }
}

fn sigOf(c: DkimCanon, h: []string, header: string, m: DkimMaterial): string {
  return dkimSignature(c, h, header, m) catch e {
    panic("dkimSignature failed: ${e.message()}")
  }
}

fn at(seconds: string): Timestamp {
  return parseEpochSeconds(seconds) catch _ {
    panic("bad epoch ${seconds}")
  }
}

fn loadRefusal(d: Dkim): string {
  loadDkim(d) catch e {
    return e.message()
  }
  return "accepted"
}

fn signRefusal(data: string, keys: []DkimKey): string {
  dkimSign(data, keys, at("1528637909")) catch e {
    return e.message()
  }
  return "accepted"
}

// `s` with every run of spaces made one and the line breaks removed: the form
// a verifier hashes a folded header in (RFC 6376 section 3.4.2).
fn collapse(s: string): string {
  let flat = replace(s, "\r\n", "")
  let out = ""
  let i = 0
  while (i < len(flat)) {
    if (flat[i] != u8(32) || (len(out) > 0 && out[len(out) - 1] != u8(32))) {
      out = out + flat[i:i + 1]
    }
    i = i + 1
  }
  return trimSpace(out)
}

// The header name and value of a signature header, folds and all, up to `b=`.
fn upToB(header: string): string {
  return header[:indexOf(header, "b=") + 2]
}

// The `h=` list of a signature header.
fn hList(header: string): []string {
  let from = indexOf(header, "h=") + 2
  let to = indexOfFrom(header, ";", from)
  return split(replace(replace(header[from:to], "\r\n", ""), " ", ""), ":")
}

// The `b=` value of a signature header with its folds removed.
fn bValue(header: string): string {
  let from = indexOf(header, "b=") + 2
  return replace(replace(header[from:], "\r\n", ""), " ", "")
}

// The bytes a verifier hashes: the fields `h` selects from `fieldsFor`, then
// the signature header relaxed, with `b=` empty and no final CRLF.
fn verifierData(fields: string, header: string): string {
  let value = collapse(upToB(header)[len("DKIM-Signature:"):])
  return fields + "dkim-signature:" + value
}

fn rfcFields(h: []string): string {
  let out = ""
  let seen = []string(0)
  let i = 0
  while (i < len(h)) {
    if (!listHas(seen, h[i])) {
      out = out + rfcCanonField(h[i])
      seen = append(seen, h[i])
    }
    i = i + 1
  }
  return out
}

fn edPublic(): []byte {
  return decodeBase64(rfcEdPublic) catch _ {
    panic("bad public key")
  }
}

fn edVerifies(signed: string, header: string, fields: string): bool {
  let data = verifierData(fields, header)
  let sig = decodeBase64(bValue(header)) catch _ {
    return false
  }
  return ed25519Verify(edPublic(), digest(Sha256(), []byte(data)), sig)
}

fn rsaPub(pem: string): RsaPublicKey {
  let der = pemDecode(pem) catch _ {
    panic("bad pem")
  }
  let key = rsaParsePrivateKey(der[0].der) catch _ {
    return rsaPubPkcs1(der[0].der)
  }
  return RsaPublicKey{ n = key.n, e = key.e }
}

fn rsaPubPkcs1(der: []byte): RsaPublicKey {
  let key = rsaParsePkcs1PrivateKey(der) catch _ {
    panic("bad rsa key")
  }
  return RsaPublicKey{ n = key.n, e = key.e }
}

fn rsaVerifies(pem: string, header: string, fields: string): bool {
  let data = verifierData(fields, header)
  let sig = decodeBase64(bValue(header)) catch _ {
    return false
  }
  return rsaVerifyPkcs1v15(rsaPub(pem), HashAlg.Sha256, rsaDigestInfoSha256(), []byte(data), sig)
}

// The header `dkimSign` put in front of `msg`.
fn headerOf(signed: string, msg: string): string {
  return signed[:len(signed) - len(msg)]
}

// The most that one line of `s` holds, CRLF not counted.
fn longestLine(s: string): int {
  let longest = 0
  let lines = split(s, "\r\n")
  let i = 0
  while (i < len(lines)) {
    if (len(lines[i]) > longest) {
      longest = len(lines[i])
    }
    i = i + 1
  }
  return longest
}

test "RFC 8463 Appendix A: the body hash is bh=" {
  assert(canonOf(rfcMsg).bh == rfcBh)
}

test "RFC 8463 Appendix A: the Ed25519 key is the RFC's public key" {
  assert(
      encodeBase64(
        ed25519PublicKey(
          decodeBase64("nWGxne/9WmC6hEr0kuwsxERJxWl7MmkZcDusAxyuf2A=") catch _ {
            panic("bad")
          },
        ),
      ) ==
      rfcEdPublic,
  )
}

test "RFC 8463 Appendix A: the Ed25519 b= is reproduced byte for byte" {
  let k = mustLoad("football.example.com", "brisbane", rfcEdPem)
  assert(k.material.alg() == "ed25519-sha256")
  let c = canonOf(rfcMsg)
  assert(sigOf(c, rfcH(), rfcEdHeader, k.material) == rfcEdB)
}

test "RFC 8463 Appendix A: the RSA b= is reproduced byte for byte" {
  let der = pemDecode(rfcRsaPem) catch _ {
    panic("bad pem")
  }
  let key = rsaParsePkcs1PrivateKey(der[0].der) catch _ {
    panic("bad key")
  }
  let c = canonOf(rfcMsg)
  assert(sigOf(c, rfcH(), rfcRsaHeader, DkimMaterial.Rsa(key)) == rfcRsaB)
}

test "a changed body changes the body hash and the signature" {
  let k = mustLoad("football.example.com", "brisbane", rfcEdPem)
  let edited = canonOf(rfcMsgEdited)
  assert(edited.bh != rfcBh)
  let header = replace(rfcEdHeader, rfcBh, edited.bh)
  assert(sigOf(edited, rfcH(), header, k.material) != rfcEdB)
}

test "dkimSign's Ed25519 signature has the tags in order and verifies over hand-made data" {
  let k = mustLoad("football.example.com", "brisbane", rfcEdPem)
  let signed = signOf(rfcMsg, [k])
  assert(hasSuffix(signed, rfcMsg))
  let header = headerOf(signed, rfcMsg)
  assert(hasPrefix(header, "DKIM-Signature: v=1; a=ed25519-sha256; c=relaxed/relaxed;"))
  let flat = replace(replace(header, "\r\n", ""), " ", "")
  let want = "DKIM-Signature:v=1;a=ed25519-sha256;c=relaxed/relaxed;d=football.example.com;" +
    "s=brisbane;t=1528637909;h=from:from:to:to:subject:subject:date:date:message-id:message-id;" +
    "bh=${rfcBh};b="
  assert(hasPrefix(flat, want))
  assert(len(flat) == len(want) + 88)
  assert(edVerifies(signed, header, rfcFields(hList(header))))
}

test "dkimSign's RSA signature verifies over hand-made data, from PKCS#8 and from PKCS#1" {
  let pems = []string{ rsaPkcs8Pem, rsaPkcs1Pem }
  let i = 0
  while (i < len(pems)) {
    let k = mustLoad("football.example.com", "test", pems[i])
    assert(k.material.alg() == "rsa-sha256")
    let signed = signOf(rfcMsg, [k])
    let header = headerOf(signed, rfcMsg)
    assert(hasPrefix(header, "DKIM-Signature: v=1; a=rsa-sha256; c=relaxed/relaxed;"))
    assert(len(bValue(header)) == 344)
    assert(rsaVerifies(pems[i], header, rfcFields(hList(header))))
    i = i + 1
  }
}

test "a second From added after signing breaks the signature, because From was oversigned" {
  let k = mustLoad("football.example.com", "test", rsaPkcs8Pem)
  let signed = signOf(rfcMsg, [k])
  let header = headerOf(signed, rfcMsg)
  assert(rsaVerifies(rsaPkcs8Pem, header, rfcFields(hList(header))))
  let tampered = "From: Mallory <mallory@example.net>\r\n" + rfcMsg
  let c = canonOf(tampered)
  let fields = selectFields(c, hList(header))
  assert(fields != rfcFields(hList(header)))
  assert(!rsaVerifies(rsaPkcs8Pem, header, fields))
}

test "the same signature fails for an Ed25519 key too once From is added" {
  let k = mustLoad("football.example.com", "brisbane", rfcEdPem)
  let signed = signOf(rfcMsg, [k])
  let header = headerOf(signed, rfcMsg)
  let c = canonOf("From: Mallory <mallory@example.net>\r\n" + rfcMsg)
  assert(!edVerifies(signed, header, selectFields(c, hList(header))))
}

test "headers present are listed once per occurrence and once more, absent ones are left out" {
  let msg = "From: a@example.com\r\nReceived: x\r\nSubject: one\r\nSubject: two\r\nX-Other: y\r\n\r\nbody\r\n"
  let c = canonOf(msg)
  let h = oversigned(c, defaultHeaders())
  assert(join(h, ":") == "from:from:subject:subject:subject")
  let two = canonOf("From: a@example.com\r\nFrom: b@example.com\r\n\r\nx\r\n")
  assert(join(oversigned(two, defaultHeaders()), ":") == "from:from:from")
}

test "the header lists survive a signature round trip: the oversigned names are in h=" {
  let k = mustLoad("football.example.com", "test", rsaPkcs8Pem)
  let msg = "From: a@example.com\r\nSubject: one\r\nSubject: two\r\nList-Id: <l.example.com>\r\n\r\nbody\r\n"
  let signed = signOf(msg, [k])
  let header = headerOf(signed, msg)
  assert(join(hList(header), ":") == "from:from:subject:subject:subject:list-id:list-id")
}

test "a custom header list replaces the default, in lower case, and still oversigns" {
  let k = loadOf(
    Dkim{
      domain = "football.example.com", selector = "test", key = rfcEdPem,
      headers = []string{ "From", "SUBJECT", "subject", "X-Custom" },
    },
  )
  let signed = signOf(rfcMsg, [k])
  let header = headerOf(signed, rfcMsg)
  assert(join(hList(header), ":") == "from:from:subject:subject")
}

test "expire adds x= after t=, and none is written without it" {
  let k = loadOf(
    Dkim{
      domain = "football.example.com", selector = "brisbane", key = rfcEdPem, expire = 3600,
    },
  )
  let header = headerOf(signOf(rfcMsg, [k]), rfcMsg)
  assert(contains(replace(header, "\r\n ", " "), "t=1528637909; x=1528641509; h=from"))
  let plain = mustLoad("football.example.com", "brisbane", rfcEdPem)
  assert(!contains(headerOf(signOf(rfcMsg, [plain]), rfcMsg), "x="))
}

test "never l=, z= or sha1, and no line passes 78 columns" {
  let keys = [
    mustLoad("football.example.com", "test", rsaPkcs8Pem),
    mustLoad("football.example.com", "brisbane", rfcEdPem),
  ]
  let signed = signOf(rfcMsg, keys)
  let header = headerOf(signed, rfcMsg)
  let flat = replace(header, "\r\n ", " ")
  assert(!contains(flat, " l="))
  assert(!contains(flat, " z="))
  assert(!contains(toLower(flat), "sha1"))
  assert(longestLine(header) <= 78)
  assert(hasSuffix(header, "\r\n"))
  assert(!contains(header, "\r\n\r\n"))
  let lines = split(header, "\r\n")
  let i = 1
  while (i < len(lines) - 1) {
    assert(hasPrefix(lines[i], " ") || hasPrefix(lines[i], "DKIM-Signature:"))
    i = i + 1
  }
}

test "two keys give two signatures in key order, each over the message without the other" {
  let rsa = mustLoad("football.example.com", "test", rsaPkcs8Pem)
  let ed = mustLoad("football.example.com", "brisbane", rfcEdPem)
  let signed = signOf(rfcMsg, [rsa, ed])
  assert(hasSuffix(signed, rfcMsg))
  let sigs = headerOf(signed, rfcMsg)
  let second = indexOfFrom(sigs, "DKIM-Signature:", 1)
  let first = sigs[:second]
  let last = sigs[second:]
  assert(contains(first, "a=rsa-sha256"))
  assert(contains(last, "a=ed25519-sha256"))
  assert(rsaVerifies(rsaPkcs8Pem, first, rfcFields(hList(first))))
  assert(edVerifies(signed, last, rfcFields(hList(last))))
  // The same signatures as when each key signs alone.
  assert(first == headerOf(signOf(rfcMsg, [rsa]), rfcMsg))
  assert(last == headerOf(signOf(rfcMsg, [ed]), rfcMsg))
}

test "no keys leaves the message as it was" {
  assert(signOf(rfcMsg, []DkimKey(0)) == rfcMsg)
}

test "a 1024-bit RSA key is refused at load with the openssl hint" {
  let why = loadRefusal(Dkim{ domain = "example.com", selector = "s1", key = rsa1024Pem })
  assert(contains(why, "dkim s1._domainkey.example.com"), why)
  assert(contains(why, "1024 bits"), why)
  assert(contains(why, "openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048"), why)
  let rfc = loadRefusal(Dkim{ domain = "example.com", selector = "s1", key = rfcRsaPem })
  assert(contains(rfc, "rsa_keygen_bits:2048"), rfc)
}

test "a refusal names the identity and never carries key bytes" {
  let bodies = []string{
    rsa1024Pem, rfcRsaPem, encryptedPem, "not a key\n",
    "-----BEGIN PUBLIC KEY-----\nAAAA\n-----END PUBLIC KEY-----\n",
    "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIJ1hsZ3v\n-----END PRIVATE KEY-----\n",
  }
  let i = 0
  while (i < len(bodies)) {
    let why = loadRefusal(Dkim{ domain = "example.com", selector = "s1", key = bodies[i] })
    assert(contains(why, "dkim s1._domainkey.example.com"), why)
    assert(!contains(why, "MIIC"), why)
    assert(!contains(why, "MC4CAQ"), why)
    assert(!contains(why, "MIIF"), why)
    assert(!contains(why, "Y/J16"), why)
    i = i + 1
  }
}

test "an encrypted key is refused and the way out is named" {
  let why = loadRefusal(Dkim{ domain = "example.com", selector = "s1", key = encryptedPem })
  assert(contains(why, "encrypted"), why)
  assert(contains(why, "openssl pkey"), why)
}

test "an Ed25519 key from openssl loads and signs" {
  let k = mustLoad("example.com", "ed", edOsslPem)
  assert(k.material.alg() == "ed25519-sha256")
  let signed = signOf(rfcMsg, [k])
  assert(contains(signed, "a=ed25519-sha256"))
}

test "the key, the domain and the selector are checked at load" {
  let ok = Dkim{ domain = "example.com", selector = "s1", key = rfcEdPem }
  assert(loadRefusal(ok) == "accepted")
  assert(
    contains(
      loadRefusal(Dkim{ domain = "example.com", selector = "mail.2026", key = rfcEdPem }),
      "accepted",
    ),
  )
  let bad = []string{
    "",
    "a b",
    "a..b",
    "-a.com",
    "a-.com",
    "a.com.",
    "a;b.com",
    "exa\r\nmple.com",
    "localhost",
  }
  let i = 0
  while (i < len(bad)) {
    let why = loadRefusal(Dkim{ domain = bad[i], selector = "s1", key = rfcEdPem })
    assert(contains(why, "the domain is not a DNS name"), why)
    assert(!contains(why, "\r"), why)
    assert(!contains(why, "\n"), why)
    i = i + 1
  }
  assert(
    contains(
      loadRefusal(Dkim{ domain = "example.com", selector = "s;1", key = rfcEdPem }),
      "the selector is not a DNS name",
    ),
  )
  assert(
    contains(
      loadRefusal(Dkim{ domain = "example.com", selector = "", key = rfcEdPem }),
      "the selector is not a DNS name",
    ),
  )
  assert(
    contains(
      loadRefusal(Dkim{ domain = "example.com", selector = "s1", key = rfcEdPem, expire = -1 }),
      "expire",
    ),
  )
}

test "a header list without From is refused, and a bad name too" {
  let why = loadRefusal(
    Dkim{
      domain = "example.com",
      selector = "s1",
      key = rfcEdPem,
      headers = []string{ "To", "Subject" },
    },
  )
  assert(contains(why, "headers must include From"), why)
  let bad = loadRefusal(
    Dkim{
      domain = "example.com",
      selector = "s1",
      key = rfcEdPem,
      headers = []string{ "From", "Sub:ject" },
    },
  )
  assert(contains(bad, "not a header field name"), bad)
}

test "a message with no From, or that does not split, is refused" {
  let k = mustLoad("example.com", "s1", rfcEdPem)
  assert(contains(signRefusal("Subject: x\r\n\r\nbody\r\n", [k]), "no From header"))
  assert(
    contains(signRefusal("From: a@example.com\nSubject: x\n\nbody\n", [k]), "does not end in CRLF"),
  )
}
