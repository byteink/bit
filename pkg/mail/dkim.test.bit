// pkg/mail/dkim.test.bit — the DKIM signer: RFC 8463 Appendix A reproduced
// byte for byte (the body hash and both signatures), the signatures checked by
// a verifier written here from the RFC's rules and hand-made canonical data,
// oversigning, several keys, and every way `loadDkim` refuses a key. The RSA
// and Ed25519 test keys are throwaway ones made for this file; none has ever
// signed anything else.

import { decodeBase64, digest, ed25519PublicKey, ed25519Verify, encodeBase64, pemDecode } from "std/crypto"
import { HashAlg, RsaPublicKey, Sha256, rsaDigestInfoSha256, rsaParsePkcs1PrivateKey } from "std/crypto"
import { rsaParsePrivateKey, rsaVerifyPkcs1v15 } from "std/crypto"
import {
  contains,
  hasPrefix,
  hasSuffix,
  indexOf,
  indexOfFrom,
  join,
  replace,
  split,
  toLower,
  trimSpace,
} from "std/strings"
import { Timestamp, parseEpochSeconds } from "std/time"

