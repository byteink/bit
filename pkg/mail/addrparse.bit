// pkg/mail/addrparse.bit — the mailbox grammar behind `parseAddress`.
//
// A mailbox is `[phrase] <addr-spec>` or a bare `addr-spec`. One pass
// (`scanShape`) finds the `<` and refuses what no sender needs: comments,
// group syntax, domain literals, a second `<`. Then the phrase becomes the
// display name (`parsePhrase`) and the addr-spec becomes the email
// (`parseSpec`: local part, `@`, domain).
//
// Every function here fails with `MailError.Invalid(reason)`; address.bit adds
// the input to the message. A reason says what is wrong in words someone
// fixing a form field can act on.

import { join, trimRight } from "std/strings"

const maxLocal: int = 64
const maxAddress: int = 254
const maxLabel: int = 63

// The reason for a byte that has no place anywhere outside quotes: a comment
// bracket, a group colon or semicolon, a domain literal's bracket. "" for any
// other byte.
fn shapeFault(c: u8): string {
  if (c == u8(40) || c == u8(41)) {
    return "comments (...) are not accepted"
  }
  if (c == u8(58) || c == u8(59)) {
    return "group syntax (name: a@b;) and source routes are not accepted"
  }
  if (c == u8(91)) {
    return "a domain literal like [1.2.3.4] is not accepted"
  }
  return ""
}

// The reason `s` cannot be a mailbox or a list of them whatever its words are:
// a quote that never closes, a comment, group syntax, a domain literal. "" when
// none. Checked on a whole list too, so `team: a@x.com, b@x.com;` is named as a
// group and not as two addresses.
fn shapeProblem(s: string): string {
  let i = 0
  while (i < len(s)) {
    if (s[i] == dq) {
      i = skipQuoted(s, i)
      if (i < 0) {
        return "unterminated quoted string"
      }
    } else if (shapeFault(s[i]) != "") {
      return shapeFault(s[i])
    }
    i = i + 1
  }
  return ""
}

// Index of the single `<` outside quotes, or -1 for a bare address.
fn scanShape(s: string): int!MailError {
  let why = shapeProblem(s)
  if (why != "") {
    fail MailError.Invalid(why)
  }
  let angle = -1
  let i = 0
  while (i < len(s)) {
    if (s[i] == dq) {
      i = skipQuoted(s, i)
    } else if (s[i] == lt && angle >= 0) {
      fail MailError.Invalid("more than one '<'")
    } else if (s[i] == lt) {
      angle = i
    }
    i = i + 1
  }
  return angle
}

// The pieces of `s` between commas that are outside quotes and outside `<...>`.
// Unbalanced quotes are left for `scanShape` to name.
fn splitList(s: string): []string {
  let parts: []string = []
  let start = 0
  let inAngle = false
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == dq) {
      i = skipQuoted(s, i)
      if (i < 0) {
        break
      }
    } else if (c == lt) {
      inAngle = true
    } else if (c == gt) {
      inAngle = false
    } else if (c == comma && !inAngle) {
      parts = append(parts, s[start:i])
      start = i + 1
    }
    i = i + 1
  }
  return append(parts, s[start:])
}

// One mailbox, already trimmed and free of control bytes.
fn parseMailbox(s: string): Address!MailError {
  let angle = scanShape(s)?
  if (angle < 0) {
    return bareMailbox(s)?
  }
  return angleMailbox(s, angle)?
}

// `local@domain` with no display name. Whitespace in it means the person
// wrote a name without the brackets; saying so beats "invalid character".
fn bareMailbox(s: string): Address!MailError {
  let end = localEnd(s)
  if (end < len(s) && firstSpace(s) >= 0) {
    fail MailError.Invalid("whitespace in an address: put a display name before the address in <angle brackets>")
  }
  return Address{ name = "", email = parseSpec(s)? }
}

// `phrase <local@domain>`.
fn angleMailbox(s: string, angle: int): Address!MailError {
  let name = parsePhrase(s[:angle])?
  let rest = trimRight(s[angle + 1:], " \t")
  if (rest == "" || rest[len(rest) - 1] != gt) {
    if (indexOf(rest, ">") >= 0) {
      fail MailError.Invalid("text after the closing '>'")
    }
    fail MailError.Invalid("missing the closing '>'")
  }
  return Address{ name = name, email = parseSpec(rest[:len(rest) - 1])? }
}

// Index of the first space or tab outside quotes, or -1.
fn firstSpace(s: string): int {
  let i = 0
  while (i < len(s)) {
    if (s[i] == dq) {
      i = skipQuoted(s, i)
    } else if (isWs(s[i])) {
      return i
    }
    i = i + 1
  }
  return -1
}

// The display name of `p`, the text before `<`: atoms and quoted strings
// joined by single spaces, encoded words decoded, checked again for control
// bytes once decoded.
fn parsePhrase(p: string): string!MailError {
  let words: []string = []
  let i = 0
  while (i < len(p)) {
    if (isWs(p[i])) {
      i = i + 1
    } else if (p[i] == dq) {
      let shut = skipQuoted(p, i)
      words = append(words, unquote(p[i:shut + 1])?)
      i = shut + 1
    } else {
      let end = atomEnd(p, i)?
      words = append(words, p[i:end])
      i = end
    }
  }
  return cleanName(decodeWords(join(words, " "))?)?
}

// End of the unquoted word starting at `p[from]`; every byte must be one a
// display name may carry unquoted.
fn atomEnd(p: string, from: int): int!MailError {
  let i = from
  while (i < len(p) && !isWs(p[i]) && p[i] != dq) {
    let c = p[i]
    if (c == atSign) {
      fail MailError.Invalid("an unquoted display name cannot contain '@'; put the name in double quotes")
    }
    if (!isAtext(c) && c != dot) {
      fail MailError.Invalid("the character '${string([c])}' needs the display name in double quotes")
    }
    i = i + 1
  }
  return i
}

// A decoded display name, trimmed, or the reason it cannot be used.
fn cleanName(name: string): string!MailError {
  let why = inputFault(name)
  if (why != "") {
    fail MailError.Invalid("the display name ${why}")
  }
  if (indexOf(name, "\t") >= 0) {
    fail MailError.Invalid("the display name contains a tab")
  }
  return trimSpace(name)
}

// Index just past the local part of `s`: the closing quote of a quoted one,
// else the first `@` (`len(s)` when there is none).
fn localEnd(s: string): int {
  if (s != "" && s[0] == dq) {
    let shut = skipQuoted(s, 0)
    if (shut >= 0) {
      return shut + 1
    }
    return len(s)
  }
  let at = indexOf(s, "@")
  if (at < 0) {
    return len(s)
  }
  return at
}

// The email of the addr-spec `s`: `local@domain` with the local part in its
// shortest valid spelling and the domain as written.
fn parseSpec(s: string): string!MailError {
  if (s == "") {
    fail MailError.Invalid("empty address")
  }
  let end = localEnd(s)
  if (end >= len(s)) {
    fail MailError.Invalid("no @ sign")
  }
  if (s[end] != atSign) {
    fail MailError.Invalid("text after the quoted local part, before the '@'")
  }
  let local = parseLocal(s[:end])?
  checkDomain(s[end + 1:])?
  let email = local + "@" + s[end + 1:]
  if (len(email) > maxAddress) {
    fail MailError.Invalid("the address is ${len(email)} octets, over the limit of ${maxAddress}")
  }
  return email
}

// Why `s` is not a dot-atom, or "": empty, a dot first, last or doubled, or a
// byte outside atext.
fn dotAtomFault(s: string): string {
  if (s == "") {
    return "empty"
  }
  if (s[0] == dot || s[len(s) - 1] == dot || indexOf(s, "..") >= 0) {
    return "a dot at the start, at the end or doubled"
  }
  let i = 0
  while (i < len(s)) {
    if (!isAtext(s[i]) && s[i] != dot) {
      return "the character '${string([s[i]])}' needs the local part in double quotes"
    }
    i = i + 1
  }
  return ""
}

// The local part `raw` (quoted or a dot-atom) in its shortest valid spelling.
fn parseLocal(raw: string): string!MailError {
  if (raw == "") {
    fail MailError.Invalid("empty local part")
  }
  let content = raw
  if (raw[0] == dq) {
    content = unquote(raw) catch _ {
      fail MailError.Invalid("the local part contains a tab")
    }
  }
  if (content == "") {
    fail MailError.Invalid("empty local part")
  }
  let spelled = content
  if (dotAtomFault(content) != "") {
    if (raw[0] != dq) {
      fail MailError.Invalid("local part: ${dotAtomFault(content)}")
    }
    spelled = quoteString(content)
  }
  if (len(spelled) > maxLocal) {
    fail MailError.Invalid("the local part is ${len(spelled)} octets, over the limit of ${maxLocal}")
  }
  return spelled
}

// The reason `label` is not a domain label, or "". Non-ASCII bytes pass: the
// IDNA rules for them apply when the message is sent, not here.
fn labelFault(label: string): string {
  if (label == "") {
    return "the domain has an empty label (a dot at the start or end, or two in a row)"
  }
  if (len(label) > maxLabel) {
    return "a domain label is ${len(label)} octets, over the limit of ${maxLabel}"
  }
  if (label[0] == u8(45) || label[len(label) - 1] == u8(45)) {
    return "a domain label starts or ends with a hyphen"
  }
  let i = 0
  while (i < len(label)) {
    if (label[i] < u8(128) && !isAlnum(label[i]) && label[i] != u8(45)) {
      return "the character '${string([label[i]])}' is not allowed in a domain"
    }
    i = i + 1
  }
  return ""
}

fn checkDomain(domain: string): ()!MailError {
  if (domain == "") {
    fail MailError.Invalid("empty domain")
  }
  if (indexOf(domain, "@") >= 0) {
    fail MailError.Invalid("more than one @ sign")
  }
  for label of split(domain, ".") {
    let why = labelFault(label)
    if (why != "") {
      fail MailError.Invalid(why)
    }
  }
}
