// The caller must obtain this certificate through the pinned SNS URL.
// Path trust and the message signature do not establish that URL provenance.

import {
  Certificate, HashAlg, rsaDigestInfoSha256, rsaParsePkcs1PublicKey,
  RsaPublicKey, rsaVerifyPkcs1v15, x509KeyRSA, x509VerifyPath,
} from "std/crypto"

class SnsTrust { intermediates: []Certificate, roots: []Certificate, nowUnix: int }

fn snsSigningKey(leaf: Certificate, trust: SnsTrust): RsaPublicKey!MailError {
  x509VerifyPath(leaf, trust.intermediates, trust.roots, trust.nowUnix) catch _ {
    fail webhookRejected("SNS certificate path is not trusted")
  }
  if (leaf.pubKeyAlg != x509KeyRSA) {
    fail webhookRejected("SNS signing certificate is not RSA")
  }
  // RFC 5280 section 4.2.1.3 assigns digitalSignature to KeyUsage bit zero.
  if (leaf.hasKeyUsage && (leaf.keyUsage & 1) == 0) {
    fail webhookRejected("SNS signing certificate cannot sign messages")
  }
  return rsaParsePkcs1PublicKey(leaf.pubKeyBytes) catch _ {
    fail webhookRejected("SNS signing public key is invalid")
  }
}

fn snsVerifySignature(
  canonical: string,
  version: string,
  signature: []byte,
  leaf: Certificate,
  trust: SnsTrust,
): ()!MailError {
  let alg = HashAlg.Sha256
  let prefix = rsaDigestInfoSha256()
  if (version == "1") {
    alg = HashAlg.Sha1
    // RFC 8017 section 9.2 Note 1: the SHA-1 DigestInfo DER prefix.
    prefix = []byte{
      0x30, 0x21, 0x30, 0x09, 0x06, 0x05, 0x2b, 0x0e,
      0x03, 0x02, 0x1a, 0x05, 0x00, 0x04, 0x14,
    }
  } else {
    if (version != "2") {
      fail webhookRejected("SNS signature version is not supported")
    }
  }
  let key = snsSigningKey(leaf, trust)?
  if (!rsaVerifyPkcs1v15(key, alg, prefix, []byte(canonical), signature)) {
    fail webhookRejected("SNS signature does not match")
  }
}
