// pkg/mail/postmark.test.bit — the `postmark://` transport against the in-test
// HTTPS server resend.test.bit starts (`rsStart`: a `std/tls` listener
// answering HTTP/1.1 from a script), pinned with a non-default host and
// `insecureSkipVerify=true`. No test reaches the network.
//
// What the server saw is the whole request text, so a test reads the request
// line, the headers and the exact JSON body. Every error a test provokes goes
// through `pmClean`, which fails when its text holds the server token.

import { repeat } from "std/strings"
import { Millisecond, Second } from "std/time"

const pmToken: string = "pm-test-token-4c1"

// The body a full message must produce: every field Postmark takes, in the order
// postmarkbody.bit writes them, field for field.
const pmFullBody: string = "{\"From\":\"Inkwell <hello@inkwell.dev>\",\"To\":\"Sara Ali <sara@example.com>\",\"Cc\":\"lee@example.com\",\"Bcc\":\"audit@example.com\",\"Subject\":\"Welcome to Inkwell\",\"Tag\":\"welcome-mail\",\"HtmlBody\":\"<p>Hello <img src=\\\"cid:logo\\\"></p>\",\"TextBody\":\"Hello Sara.\",\"ReplyTo\":\"support@inkwell.dev\",\"Headers\":[{\"Name\":\"Auto-Submitted\",\"Value\":\"auto-generated\"},{\"Name\":\"In-Reply-To\",\"Value\":\"<thread-1@inkwell.dev>\"},{\"Name\":\"References\",\"Value\":\"<thread-1@inkwell.dev>\"},{\"Name\":\"X-Run\",\"Value\":\"7\"}],\"Attachments\":[{\"Name\":\"logo.png\",\"Content\":\"AQID\",\"ContentType\":\"image/png\",\"ContentID\":\"cid:logo\"},{\"Name\":\"invoice.pdf\",\"Content\":\"UERG\",\"ContentType\":\"application/pdf\"}],\"Metadata\":{\"campaign\":\"welcome\",\"user\":\"7\"},\"MessageStream\":\"broadcasts\"}"

fn pmOk(): string {
  return rsReply(
    200,
    "",
    "{\"To\":\"sara@example.com\",\"SubmittedAt\":\"2026-10-05T07:25:01.4178645-05:00\",\"MessageID\":\"0a129aee-e1cd-480d-b08d-4f48548ff48d\",\"ErrorCode\":0,\"Message\":\"OK\"}",
  )
}

// A Postmark error answer: `status` with `{"ErrorCode", "Message"}`.
fn pmError(status: int, extra: string, code: int, message: string): string {
  return rsReply(status, extra, "{\"ErrorCode\":${code},\"Message\":\"${message}\"}")
}

fn pmUrl(port: int, query: string): string {
  return "postmark://${pmToken}@127.0.0.1:${port}?insecureSkipVerify=true${query}"
}

fn pmMsg(): Message {
  return Message{
    to = ["Sara Ali <sara@example.com>"],
    subject = "Welcome to Inkwell",
    text = "Hello Sara.",
    id = "welcome-1",
  }
}

fn pmFull(): Message {
  return Message{
    to = ["Sara Ali <sara@example.com>"],
    cc = ["lee@example.com"],
    bcc = ["audit@example.com"],
    replyTo = ["support@inkwell.dev"],
    subject = "Welcome to Inkwell",
    text = "Hello Sara.",
    html = "<p>Hello <img src=\"cid:logo\"></p>",
    attachments = [
      Attachment{ name = "logo.png", data = [u8(1), u8(2), u8(3)], cid = "logo" },
      Attachment{ name = "invoice.pdf", data = []byte("PDF") },
    ],
    headers = { "X-Run": "7" },
    tags = { "user": "7", "campaign": "welcome", "tag": "welcome-mail" },
    inReplyTo = "<thread-1@inkwell.dev>",
    id = "welcome-1",
  }
}

fn pmClean(e: MailError) {
  assert(!contains(e.message(), pmToken), "an error repeated the server token: ${e.message()}")
}

// What one send came to: the request the server saw, and either the receipt or
// the error.
class PmRun {
  seen: string,
  receipt: Receipt,
  err: Option<MailError>,
}

// Sends `m` to a server that answers `reply` once, on the stream `query` names.
fn pmSend(reply: string, m: Message, query: string): PmRun {
  let (port, log) = rsStart([reply]) catch e {
    panic("fake: ${e.message()}")
  }
  let mailer = open(pmUrl(port, query), rsOpts()) catch e {
    panic("open: ${e.message()}")
  }
  defer mailer.close()
  let run = PmRun{ seen = "", receipt = Receipt{}, err = Option<MailError>.None }
  let r = mailer.send(m) catch e {
    run.err = Option<MailError>.Some(e)
    run.seen = <- log
    return run
  }
  run.receipt = r
  run.seen = <- log
  return run
}

// The error a send fails with; panics when it succeeds.
fn pmFail(reply: string): MailError {
  match (pmSend(reply, pmMsg(), "").err) {
    Some(e) => {
      pmClean(e)
      return e
    }
    None => panic("the send succeeded against a server scripted to refuse")
  }
}

test "a full message is posted as the exact JSON Postmark documents, with the token, stream and cid" {
  let run = pmSend(pmOk(), pmFull(), "&stream=broadcasts")
  assert(isNone(run.err), "the send failed")
  let seen = run.seen
  assert(hasPrefix(seen, "POST /email HTTP/1.1\r\n"), "request line: ${seen}")
  assert(
    contains(seen, "X-Postmark-Server-Token: ${pmToken}\r\n"),
    "no X-Postmark-Server-Token: ${seen}",
  )
  assert(contains(seen, "Content-Type: application/json\r\n"), "no content type: ${seen}")
  assert(contains(seen, "Accept: application/json\r\n"), "no Accept: ${seen}")
  assert(!contains(seen, "Authorization"), "an Authorization header was sent: ${seen}")
  assert(rsBody(seen) == pmFullBody, "body:\n${rsBody(seen)}\nwant:\n${pmFullBody}")
  let receipt = run.receipt
  assert(
    receipt.providerId == "0a129aee-e1cd-480d-b08d-4f48548ff48d",
    "providerId: ${receipt.providerId}",
  )
  assert(receipt.id == "<welcome-1@inkwell.dev>", "id: ${receipt.id}")
  assert(len(receipt.accepted) == 3, "accepted: ${join(receipt.accepted, ",")}")
}

test "the stream is outbound by default, recipients are joined, Options fill From and Reply-To" {
  let (port, log) = rsStart([pmOk()]) catch e {
    assert(false, "fake: ${e.message()}")
    return
  }
  let opts = rsOpts()
  opts.replyTo = "Help <help@inkwell.dev>"
  let mailer = open(pmUrl(port, ""), opts) catch e {
    assert(false, "open: ${e.message()}")
    return
  }
  let m = pmMsg()
  m.to = ["Sara Ali <sara@example.com>", "\"Lee, Jr.\" <lee@example.com>"]
  mailer.send(m) catch e {
    assert(false, "send: ${e.message()}")
    return
  }
  let body = rsBody(<- log)
  assert(
    hasPrefix(
      body,
      "{\"From\":\"Inkwell <hello@inkwell.dev>\",\"To\":\"Sara Ali <sara@example.com>, \\\"Lee, Jr.\\\" <lee@example.com>\",\"Subject\":",
    ),
    body,
  )
  assert(contains(body, "\"ReplyTo\":\"Help <help@inkwell.dev>\""), body)
  assert(contains(body, "\"MessageStream\":\"outbound\"}"), body)
  assert(
    !contains(body, "\"Cc\"") && !contains(body, "\"Tag\"") && !contains(body, "\"Metadata\""),
    body,
  )
}

test "a message with no tag key has Metadata and no Tag; only the key tag is the Tag" {
  let m = pmMsg()
  m.tags = { "Plan": "pro" }
  let run = pmSend(pmOk(), m, "")
  assert(isNone(run.err), "the send failed")
  let body = rsBody(run.seen)
  assert(contains(body, "\"Metadata\":{\"Plan\":\"pro\"}"), body)
  assert(!contains(body, "\"Tag\""), body)
}

test "ErrorCode 406 is Rejected with postmark:406 kept in Reply.enhanced" {
  let e = pmFail(
    pmError(422, "", 406, "You tried to send to a recipient that has been marked as inactive."),
  )
  match (e) {
    Rejected(r) => {
      assert(r.code == 422 && r.enhanced == "postmark:406", r.toString())
      assert(contains(r.text, "marked as inactive"), r.toString())
      assert(r.toString() == "422 postmark:406 ${r.text}", r.toString())
    }
    _ => assert(false, "want Rejected, got ${e.message()}")
  }
}

test "the other 422 codes are Rejected with their code" {
  let a = pmFail(pmError(422, "", 300, "Invalid email request"))
  match (a) {
    Rejected(r) => assert(
      r.enhanced == "postmark:300" && contains(r.text, "Invalid email"),
      r.toString(),
    )
    _ => assert(false, "want Rejected, got ${a.message()}")
  }
  let b = pmFail(pmError(422, "", 1235, "The stream provided does not exist on this server."))
  match (b) {
    Rejected(r) => assert(r.enhanced == "postmark:1235", r.toString())
    _ => assert(false, "want Rejected, got ${b.message()}")
  }
  let c = pmFail(pmError(413, "", 0, "Payload too large"))
  match (c) {
    Rejected(r) => assert(r.code == 413 && r.enhanced == "", r.toString())
    _ => assert(false, "want Rejected, got ${c.message()}")
  }
}

test "a 200 that carries an ErrorCode is Rejected, not a Receipt" {
  let e = pmFail(pmError(200, "", 300, "Zero recipients specified"))
  match (e) {
    Rejected(r) => assert(r.enhanced == "postmark:300", r.toString())
    _ => assert(false, "want Rejected, got ${e.message()}")
  }
}

test "503 is Transient" {
  let e = pmFail(pmError(503, "", 100, "Postmark API is offline for maintenance."))
  match (e) {
    Transient(r) => assert(
      r.code == 503 && r.enhanced == "postmark:100" && r.retryAfter == 0,
      r.toString(),
    )
    _ => assert(false, "want Transient, got ${e.message()}")
  }
}

test "500 and 429 are Transient, 429 carries Retry-After" {
  let a = pmFail(pmError(500, "", 101, "Internal error"))
  match (a) {
    Transient(r) => assert(r.code == 500 && r.enhanced == "postmark:101", r.toString())
    _ => assert(false, "want Transient, got ${a.message()}")
  }
  let b = pmFail(pmError(429, "Retry-After: 3\r\n", 0, "Too many requests"))
  match (b) {
    Transient(r) => assert(r.code == 429 && r.retryAfter == 3 * Second, r.toString())
    _ => assert(false, "want Transient, got ${b.message()}")
  }
}

test "401 is Auth" {
  let e = pmFail(
    pmError(401, "", 10, "No Account or Server API tokens were supplied in the HTTP headers."),
  )
  match (e) {
    Auth(r) => assert(r.code == 401 && r.enhanced == "postmark:10", r.toString())
    _ => assert(false, "want Auth, got ${e.message()}")
  }
}

test "a server that echoes the token in its message does not leak it" {
  let e = pmFail(pmError(422, "", 403, "bad token ${pmToken} here"))
  match (e) {
    Rejected(r) => assert(contains(r.text, "bad token *** here"), r.text)
    _ => assert(false, "want Rejected, got ${e.message()}")
  }
}

test "a body that is not JSON still maps by status" {
  let e = pmFail(rsReply(502, "", "<html>bad gateway</html>"))
  match (e) {
    Transient(r) => assert(r.code == 502 && r.text == "HTTP 502" && r.enhanced == "", r.toString())
    _ => assert(false, "want Transient, got ${e.message()}")
  }
}

// A send that must fail before any request: nothing listens on the port, so a
// send that tried would be Transient.
fn pmInvalid(m: Message, want: string) {
  let mailer = open("postmark://${pmToken}@127.0.0.1:1?insecureSkipVerify=true", rsOpts()) catch e {
    assert(false, "open: ${e.message()}")
    return
  }
  mailer.send(m) catch e {
    match (e) {
      Invalid(why) => assert(contains(why, want), "wanted '${want}' in: ${why}")
      _ => assert(false, "want Invalid, got ${e.message()}")
    }
    return
  }
  assert(false, "a message with ${want} was accepted")
}

test "what Postmark would refuse is Invalid before any request" {
  let many: []string = []
  let i = 0
  while (i < 51) {
    many = append(many, "u${i}@example.com")
    i = i + 1
  }
  let a = pmMsg()
  a.to = many
  pmInvalid(a, "51 recipients")
  let b = pmMsg()
  b.tags = { "tag": repeat("x", 1001) }
  pmInvalid(b, "Tag of at most 1000")
  let c = pmMsg()
  c.tags = { "a-name-that-is-over-twenty": "x" }
  pmInvalid(c, "Metadata name of 1 to 20")
  let d = pmMsg()
  d.tags = { "k": repeat("v", 81) }
  pmInvalid(d, "Metadata value of at most 80")
  let e = pmMsg()
  e.tags = { "User": "1", "user": "2" }
  pmInvalid(e, "case-insensitive")
  let f = pmMsg()
  let tags: map<string, string> = {}
  let n = 0
  while (n < 11) {
    tags["k${n}"] = "v"
    n = n + 1
  }
  f.tags = tags
  pmInvalid(f, "at most 10 Metadata entries")
}

test "an unreachable host is Transient" {
  let mailer = open("postmark://${pmToken}@127.0.0.1:1?insecureSkipVerify=true", rsOpts()) catch e {
    assert(false, "open: ${e.message()}")
    return
  }
  mailer.send(pmMsg()) catch e {
    pmClean(e)
    match (e) {
      Transient(_) => return
      _ => assert(false, "want Transient, got ${e.message()}")
    }
  }
  assert(false, "a send to a closed port succeeded")
}

test "a certificate that does not verify is Rejected and sends nothing" {
  let (port, log) = rsStart([pmOk()]) catch e {
    assert(false, "fake: ${e.message()}")
    return
  }
  let mailer = open("postmark://${pmToken}@127.0.0.1:${port}", rsOpts()) catch e {
    assert(false, "open: ${e.message()}")
    return
  }
  mailer.send(pmMsg()) catch e {
    pmClean(e)
    match (e) {
      Rejected(r) => assert(r.code == 0 && hasPrefix(r.text, "postmark: "), r.toString())
      _ => assert(false, "want Rejected, got ${e.message()}")
    }
    let seen = <- log
    assert(!contains(seen, "POST /email"), "the request was sent anyway: ${seen}")
    return
  }
  assert(false, "an unverifiable certificate was accepted")
}

fn pmRefused(url: string, want: string) {
  open(url) catch e {
    match (e) {
      Config(why) => {
        assert(contains(why, want), "wanted '${want}' in: ${why}")
        assert(!contains(e.message(), pmToken), "the error repeated the token: ${e.message()}")
      }
      _ => assert(false, "want Config, got ${e.message()}")
    }
    return
  }
  assert(false, "${url} opened")
}

test "the real host opens and every URL mistake fails at open" {
  open("postmark://${pmToken}@default") catch e {
    assert(false, "default: ${e.message()}")
    return
  }
  open("POSTMARK://${pmToken}@default?stream=broadcasts-2") catch e {
    assert(false, "stream: ${e.message()}")
    return
  }
  open("postmark://${pmToken}@proxy.internal:8443?stream=a&insecureSkipVerify=false") catch e {
    assert(false, "proxy: ${e.message()}")
    return
  }
  pmRefused("postmark://default", "no server token")
  pmRefused("postmark://@default", "server token is empty")
  pmRefused("postmark://${pmToken}:pw@default", "no password")
  pmRefused("postmark://${pmToken}@", "names no host")
  pmRefused("postmark://${pmToken}@default:443", "takes no port")
  pmRefused(
    "postmark://${pmToken}@default?insecureSkipVerify=true",
    "real api.postmarkapp.com is always verified",
  )
  pmRefused("postmark://${pmToken}@proxy.internal?tls=off", "the query parameters are stream")
  pmRefused("postmark://${pmToken}@proxy.internal/email", "host is a name")
  pmRefused("postmark://%0d%0a@default", "control byte")
}

test "an invalid message stream fails at open" {
  pmRefused("postmark://${pmToken}@default?stream=", "has no value")
  pmRefused("postmark://${pmToken}@default?stream=Broadcast", "message stream ID")
  pmRefused("postmark://${pmToken}@default?stream=my_stream", "message stream ID")
  pmRefused("postmark://${pmToken}@default?stream=a%2Fb", "message stream ID")
  pmRefused("postmark://${pmToken}@default?stream=${repeat("a", 31)}", "1 to 30")
  pmRefused("postmark://${pmToken}@default?stream=a&stream=b", "given twice")
  open("postmark://${pmToken}@default?stream=${repeat("a", 30)}") catch e {
    assert(false, "30 characters: ${e.message()}")
    return
  }
}

test "Options.dkim is refused at open: Postmark signs with its own key" {
  let opts = rsOpts()
  opts.dkim = [dwRsa()]
  open("postmark://${pmToken}@default", opts) catch e {
    match (e) {
      Config(why) => assert(contains(why, "builds it itself and signs with its own DKIM key"), why)
      _ => assert(false, "want Config, got ${e.message()}")
    }
    return
  }
  assert(false, "Options.dkim was accepted by a transport that cannot carry the signature")
}

test "a 5xx is retried with the same body, a Postmark acceptance ends the retries" {
  let (port, log) = rsStart([pmError(503, "", 100, "offline"), pmOk()]) catch e {
    assert(false, "fake: ${e.message()}")
    return
  }
  let opts = rsOpts()
  opts.retry = Retry{ attempts = 2, base = Millisecond, max = 5 * Millisecond }
  let mailer = open(pmUrl(port, ""), opts) catch e {
    assert(false, "open: ${e.message()}")
    return
  }
  let r = mailer.send(pmMsg()) catch e {
    assert(false, "send: ${e.message()}")
    return
  }
  let first = <- log
  let second = <- log
  assert(rsBody(first) == rsBody(second), "the retry sent a different body")
  assert(r.providerId != "", "no providerId after the retry")
}
