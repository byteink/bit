// pkg/mail/addrchars.bit — byte and rune classes shared by the address
// parser, and the one place an input is screened for bytes that could end a
// header line.
//
// The screen runs on the raw input BEFORE anything is trimmed or decoded, and
// again on every display name after its encoded words are decoded: a CRLF
// smuggled inside `=?UTF-8?B?DQo=?=` is exactly as dangerous as a literal one.

import { Builder, decodeRuneAt } from "std/strings"

const tab: u8 = 9
const space: u8 = 32
const dq: u8 = 34
const comma: u8 = 44
const dot: u8 = 46
const lt: u8 = 60
const gt: u8 = 62
const atSign: u8 = 64
const backslash: u8 = 92

// RFC 5322 §3.2.3 `atext`, minus the letters and digits `isAlnum` covers.
const atextSymbols: string = "!#$%&'*+-/=?^_`{|}~"

const hexDigits: string = "0123456789ABCDEF"

fn isWs(c: u8): bool {
  return c == space || c == tab
}

fn isAlnum(c: u8): bool {
  if (c >= u8(48) && c <= u8(57)) {
    return true
  }
  if (c >= u8(65) && c <= u8(90)) {
    return true
  }
  return c >= u8(97) && c <= u8(122)
}

fn inSet(c: u8, set: string): bool {
  let i = 0
  while (i < len(set)) {
    if (set[i] == c) {
      return true
    }
    i = i + 1
  }
  return false
}

// A byte allowed in an unquoted word: `atext`, plus every byte of a non-ASCII
// character (RFC 6532). Callers have already proved the input is valid UTF-8.
fn isAtext(c: u8): bool {
  return c >= u8(128) || isAlnum(c) || inSet(c, atextSymbols)
}

// `0x07` style spelling of one byte, for a message about a control byte.
fn hexByte(c: u8): string {
  return "0x" + string([hexDigits[int(c >> 4)], hexDigits[int(c & 0x0f)]])
}

// `00A0` style spelling of a code point below U+10000.
fn hex4(cp: int): string {
  let d = [
    hexDigits[(cp >> 12) & 0xf],
    hexDigits[(cp >> 8) & 0xf],
    hexDigits[(cp >> 4) & 0xf],
    hexDigits[cp & 0xf],
  ]
  return string(d)
}

fn controlFault(c: u8): string {
  if (c == u8(0)) {
    return "contains a NUL byte (header injection)"
  }
  if (c == u8(10)) {
    return "contains a LF (header injection)"
  }
  if (c == u8(13)) {
    return "contains a CR (header injection)"
  }
  return "contains the control byte ${hexByte(c)}"
}

// The first control byte in `s` as a reason, or "". A tab is whitespace, not a
// control, and is allowed here; the callers that cannot take one check for it.
fn byteFault(s: string): string {
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if ((c < space && c != tab) || c == u8(127)) {
      return controlFault(c)
    }
    i = i + 1
  }
  return ""
}

// Unicode code points a line-oriented reader may treat as a line break or a
// control: the C1 block (U+0080 to U+009F, which holds NEL) and U+2028/U+2029.
fn isUnicodeBreak(cp: int): bool {
  return (cp >= 0x80 && cp <= 0x9f) || cp == 0x2028 || cp == 0x2029
}

fn runeFault(s: string): string {
  let i = 0
  while (i < len(s)) {
    let (cp, size) = decodeRuneAt(s, i)
    if (size == 1 && int(cp) == 0xfffd) {
      return "is not valid UTF-8"
    }
    if (isUnicodeBreak(int(cp))) {
      return "contains a Unicode control or line separator (U+${hex4(int(cp))})"
    }
    i = i + size
  }
  return ""
}

// "" when `s` is safe to parse, else the reason it is not: a control byte
// (CR, LF and NUL named), a byte sequence that is not UTF-8, or a Unicode
// line separator.
fn inputFault(s: string): string {
  let why = byteFault(s)
  if (why != "") {
    return why
  }
  return runeFault(s)
}

// Index of the quote that closes the quoted string opening at `s[open]`, or -1
// when it never closes. A backslash escapes the next byte.
fn skipQuoted(s: string, open: int): int {
  let i = open + 1
  while (i < len(s)) {
    if (s[i] == backslash) {
      i = i + 1
    } else if (s[i] == dq) {
      return i
    }
    i = i + 1
  }
  return -1
}

// The content of the quoted string `q` (quotes included, balanced), with
// quoted-pairs resolved. A tab is refused: the display name and the local
// part have no use for one, and it is the byte a header folder moves.
fn unquote(q: string): string!MailError {
  let out = Builder()
  let i = 1
  while (i < len(q) - 1) {
    if (q[i] == backslash) {
      i = i + 1
    }
    if (q[i] == tab) {
      fail MailError.Invalid("a quoted string contains a tab")
    }
    out.writeByte(q[i])
    i = i + 1
  }
  return out.toString()
}

// `s` as a quoted string, escaping only the two bytes that need it.
fn quoteString(s: string): string {
  let out = Builder()
  out.writeByte(dq)
  let i = 0
  while (i < len(s)) {
    if (s[i] == dq || s[i] == backslash) {
      out.writeByte(backslash)
    }
    out.writeByte(s[i])
    i = i + 1
  }
  out.writeByte(dq)
  return out.toString()
}
