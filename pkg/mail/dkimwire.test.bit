// pkg/mail/dkimwire.test.bit — `Options.dkim` in a `Mailer` and in `open`: two
// signatures in the right order and the RSA one verified over a copy of the
// message canonicalized here, every refusal at startup with its words, and the
// per-message alignment check. The keys are dkim.test.bit's throwaway ones.

import { contains, hasPrefix, indexOf, split, toLower } from "std/strings"

fn dwRsa(): Dkim {
  return Dkim{ domain = "inkwell.dev", selector = "rsa1", key = rsaPkcs8Pem }
}

fn dwEd(): Dkim {
  return Dkim{ domain = "inkwell.dev", selector = "ed1", key = edOsslPem }
}

fn dwMailer(box: Outbox, o: Options): Mailer {
  return Mailer(box, o) catch e {
    panic("Mailer: ${e.message()}")
  }
}

// The text of the `Config` failure of `Mailer(t, o)`, or "ok".
fn dwSetup(t: Transport, o: Options): string {
  Mailer(t, o) catch e {
    match (e) {
      Config(_) => return e.message()
      _ => return "not Config: ${e.message()}"
    }
  }
  return "ok"
}

// The text of the failure of `mailer.send(m)`, or "ok".
fn dwSend(mailer: Mailer, m: Message): string {
  mailer.send(m) catch e {
    match (e) {
      Invalid(_) => return e.message()
      _ => return "not Invalid: ${e.message()}"
    }
  }
  return "ok"
}

// The header fields of `raw`, each as written: folds kept, no final CRLF.
fn dwHeaders(raw: string): []string {
  let block = raw[:indexOf(raw, "\r\n\r\n")]
  let out: []string = []
  for line of split(block, "\r\n") {
    if ((hasPrefix(line, " ") || hasPrefix(line, "\t")) && len(out) > 0) {
      out[len(out) - 1] = "${out[len(out) - 1]}\r\n${line}"
    } else {
      out = append(out, line)
    }
  }
  return out
}

fn dwName(h: string): string {
  return toLower(h[:indexOf(h, ":")])
}

// The fields of `hs` named `name`.
fn dwNamed(hs: []string, name: string): []string {
  let out: []string = []
  for h of hs {
    if (dwName(h) == name) {
      out = append(out, h)
    }
  }
  return out
}

// `hs` without the DKIM-Signature fields.
fn dwUnsigned(hs: []string): []string {
  let out: []string = []
  for h of hs {
    if (dwName(h) != "dkim-signature") {
      out = append(out, h)
    }
  }
  return out
}

// RFC 6376 section 3.4.2: the name in lower case, the value with folds
// removed and runs of spaces made one, then CRLF.
fn dwRelaxed(h: string): string {
  return "${dwName(h)}:${collapse(h[indexOf(h, ":") + 1:])}\r\n"
}

// Section 5.4.2: for each name in `h`, the last field of that name not taken yet.
fn dwSelect(hs: []string, h: []string): string {
  let taken = []bool(len(hs))
  let out = ""
  for name of h {
    let i = len(hs) - 1
    while (i >= 0) {
      if (!taken[i] && dwName(hs[i]) == name) {
        taken[i] = true
        out = out + dwRelaxed(hs[i])
        break
      }
      i = i - 1
    }
  }
  return out
}

// `hs` with the Subject field replaced.
fn dwTampered(hs: []string): []string {
  let out: []string = []
  for h of hs {
    if (dwName(h) == "subject") {
      out = append(out, "Subject: something else")
    } else {
      out = append(out, h)
    }
  }
  return out
}

test "two keys give two signatures, RSA first, and the RSA one verifies over a re-canonicalized copy" {
  let box = Outbox()
  let mailer = dwMailer(box, Options{ from = inkwell, dkim = [dwEd(), dwRsa()] })
  mailer.send(mbWelcome()) catch e {
    panic("send: ${e.message()}")
  }
  let raw = box.sent()[0].raw
  let hs = dwHeaders(raw)
  let sigs = dwNamed(hs, "dkim-signature")
  assert(len(sigs) == 2, "${len(sigs)} signatures")
  assert(contains(sigs[0], "a=rsa-sha256") && contains(sigs[0], "s=rsa1"), sigs[0])
  assert(contains(sigs[1], "a=ed25519-sha256") && contains(sigs[1], "s=ed1"), sigs[1])
  assert(hasPrefix(raw, "DKIM-Signature: v=1; a=rsa-sha256;"), "the RSA signature is not first")
  let rest = dwUnsigned(hs)
  let fields = dwSelect(rest, hList(sigs[0]))
  assert(contains(fields, "from:"), "h= did not select From: ${fields}")
  assert(rsaVerifies(rsaPkcs8Pem, sigs[0], fields), "the RSA signature does not verify")
  // The same check must be able to fail: a changed Subject is not what was signed.
  let bad = dwSelect(dwTampered(rest), hList(sigs[0]))
  assert(!rsaVerifies(rsaPkcs8Pem, sigs[0], bad), "the verifier accepted a changed Subject")
}

test "render signs too, and a mailer without keys signs nothing" {
  let box = Outbox()
  let signed = dwMailer(box, Options{ from = inkwell, dkim = [dwRsa()] })
  let raw = signed.render(mbWelcome()) catch e {
    panic("render: ${e.message()}")
  }
  assert(hasPrefix(raw, "DKIM-Signature: "), "render did not sign")
  let plain = dwMailer(box, Options{ from = inkwell })
  let bare = plain.render(mbWelcome()) catch e {
    panic("render: ${e.message()}")
  }
  assert(!contains(bare, "DKIM-Signature"), "an unsigned mailer signed")
}

test "an Ed25519 key with no RSA key fails at Mailer() with the reason" {
  let got = dwSetup(Outbox(), Options{ from = inkwell, dkim = [dwEd()] })
  let want = "an Ed25519 DKIM key needs an RSA key beside it: Gmail, Outlook and Yahoo do not verify Ed25519 signatures"
  assert(hasPrefix(got, "mail: configuration: Options.dkim: ed1._domainkey.inkwell.dev: "), got)
  assert(contains(got, want), got)
  let other = Dkim{ domain = "other.com", selector = "rsa1", key = rsaPkcs8Pem }
  let apart = dwSetup(Outbox(), Options{ dkim = [dwEd(), other] })
  assert(contains(apart, want), "an RSA key for another domain does not pair: ${apart}")
}

test "open takes Options.dkim and refuses the same mistakes before connecting" {
  open("smtps://mail.example.com", Options{ from = inkwell, dkim = [dwEd()] }) catch e {
    match (e) {
      Config(why) => assert(contains(why, "needs an RSA key beside it"), why)
      _ => assert(false, "want Config, got ${e.message()}")
    }
    return
  }
  assert(false, "open accepted an Ed25519 key alone")
}

test "open accepts a valid pair" {
  let m = open("smtps://mail.example.com", Options{ from = inkwell, dkim = [dwRsa(), dwEd()] }) catch e {
    panic("open: ${e.message()}")
  }
  m.close()
}

test "a From that does not align with d= fails send and nothing is delivered" {
  let box = Outbox()
  let mailer = dwMailer(box, Options{ from = inkwell, dkim = [dwRsa()] })
  let m = mbWelcome()
  m.from = "Other <hi@other.com>"
  let got = dwSend(mailer, m)
  assert(hasPrefix(got, "mail: from: the domain other.com aligns with no Options.dkim domain"), got)
  assert(len(box.sent()) == 0, "a mail was delivered")
  m.from = "Inkwell <hi@notinkwell.dev>"
  assert(
    contains(dwSend(mailer, m), "notinkwell.dev"),
    "a name that only ends the same way was accepted",
  )
  let r = mailer.render(m) catch e {
    assert(contains(e.message(), "aligns with no Options.dkim domain"), e.message())
    return
  }
  assert(false, "render signed an unaligned From: ${r}")
}

test "a subdomain From aligns and is signed" {
  let box = Outbox()
  let mailer = dwMailer(box, Options{ from = inkwell, dkim = [dwRsa()] })
  let m = mbWelcome()
  m.from = "News <news@Mail.Inkwell.dev>"
  assert(dwSend(mailer, m) == "ok", "a subdomain was refused")
  assert(contains(box.sent()[0].raw, "d=inkwell.dev"), "not signed for inkwell.dev")
}

test "with no Options.from each message is checked against the keys, and only aligned keys sign" {
  let box = Outbox()
  let other = Dkim{ domain = "other.com", selector = "o1", key = rsaPkcs1Pem }
  let mailer = dwMailer(box, Options{ dkim = [dwRsa(), other] })
  let m = mbWelcome()
  m.from = "Other <hi@other.com>"
  assert(dwSend(mailer, m) == "ok", "other.com was refused")
  let sigs = dwNamed(dwHeaders(box.sent()[0].raw), "dkim-signature")
  assert(len(sigs) == 1 && contains(sigs[0], "d=other.com"), "${len(sigs)} signatures")
  m.from = "X <x@third.org>"
  assert(contains(dwSend(mailer, m), "third.org"), "an unaligned From was accepted")
}

test "a key whose d= does not align with Options.from fails at Mailer()" {
  let o = Options{ from = "Other <hi@other.com>", dkim = [dwRsa()] }
  let got = dwSetup(Outbox(), o)
  assert(
    contains(got, "rsa1._domainkey.inkwell.dev signs d=inkwell.dev, which does not align"),
    got,
  )
  assert(contains(got, "other.com"), got)
}

test "two entries with one domain and selector fail at Mailer()" {
  let again = Dkim{ domain = "Inkwell.dev", selector = "rsa1", key = rsaPkcs1Pem }
  let got = dwSetup(Outbox(), Options{ from = inkwell, dkim = [dwRsa(), again] })
  assert(contains(got, "rsa1._domainkey.inkwell.dev is listed twice"), got)
}

test "a key that does not load fails at Mailer() naming the identity" {
  let bad = Dkim{ domain = "inkwell.dev", selector = "x1", key = "not a key" }
  let got = dwSetup(Outbox(), Options{ from = inkwell, dkim = [bad] })
  assert(hasPrefix(got, "mail: configuration: dkim x1._domainkey.inkwell.dev: "), got)
}

// A transport whose provider builds the message itself.
class DwApi {
  deliver(d: Delivery): Receipt!MailError {
    return Receipt{ id = d.messageId }
  }

  signs(): bool {
    return false
  }

  close() {}
}

test "a transport that does not carry the bytes fails at Mailer() when keys are given" {
  let got = dwSetup(DwApi{}, Options{ from = inkwell, dkim = [dwRsa()] })
  assert(contains(got, "builds it itself and signs with its own DKIM key"), got)
  assert(contains(got, "remove Options.dkim"), got)
  assert(dwSetup(DwApi{}, Options{ from = inkwell }) == "ok", "a keyless mailer was refused")
}
