// #6931: inspect what stock Mailpit received, not only the client's receipt.

test "live: MIME alternatives, PDF and inline image preserve UTF-8 filenames" {
  let s = mlScope("PLAIN")
  if (s.url == "") {
    return
  }
  defer s.clean()
  let m = mlOpen(s.url, mlOptions())
  defer m.close()
  let msg = s.message("mime")
  msg.html = "<p>live body</p><img src=\"cid:logo\">"
  msg.attachments = [
    Attachment{ name = "فاتورة.pdf", data = []byte("%PDF-1.4\nfixture\n%%EOF\n") },
    Attachment{
      name = "logo.png", cid = "logo",
      data = mlBytes("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAAAAAA6fptVAAAACklEQVR42mNgAAAAAgAB5Sfe/AAAAABJRU5ErkJggg=="),
    },
  ]
  mlSend(m, msg)
  let got = s.received(msg.subject)
  assert(contains(mlString(got, "Text"), "live body"), "text alternative lost")
  assert(contains(mlString(got, "HTML"), "cid:logo"), "HTML alternative lost")
  let attachments = mlArray(got, "Attachments")
  let inline = mlArray(got, "Inline")
  assert(len(attachments) == 1 && len(inline) == 1, "wrong MIME part counts")
  assert(mlString(attachments[0], "FileName") == "فاتورة.pdf", "UTF-8 filename changed")
  assert(mlString(attachments[0], "ContentType") == "application/pdf", "wrong PDF type")
  assert(mlString(inline[0], "FileName") == "logo.png", "inline filename changed")
  assert(mlString(inline[0], "ContentID") == "logo", "inline ContentID changed")
}

test "live: Arabic subject and display name survive IDN delivery" {
  let s = mlScope("PLAIN")
  if (s.url == "") {
    return
  }
  defer s.clean()
  let m = mlOpen(s.url, mlOptions())
  defer m.close()
  let msg = s.message("مرحبا")
  msg.to = ["سارة <sara@bücher.example>"]
  mlSend(m, msg)
  let got = s.received(msg.subject)
  assert(mlString(got, "Subject") == msg.subject, "Arabic subject changed")
  let to = mlArray(got, "To")
  assert(len(to) == 1, "wrong To count")
  assert(mlString(to[0], "Address") == "sara@xn--bcher-kva.example", "IDN was not an A-label")
  assert(mlString(to[0], "Name") == "سارة", "Arabic display name changed")
}

test "live: HTTPS unsubscribe has a valid one-click header" {
  let s = mlScope("PLAIN")
  if (s.url == "") {
    return
  }
  defer s.clean()
  let m = mlOpen(s.url, mlOptions())
  defer m.close()
  let msg = s.message("unsubscribe")
  msg.unsubscribe = Unsubscribe{ url = "https://inkwell.dev/unsubscribe/live" }
  mlSend(m, msg)
  let got = mlField(s.received(msg.subject), "ListUnsubscribe")
  assert(mlString(got, "HeaderPost") == "List-Unsubscribe=One-Click", "wrong one-click header")
  assert(mlString(got, "Errors") == "", "Mailpit rejected unsubscribe headers")
  let links = mlArray(got, "Links")
  assert(len(links) == 1, "wrong unsubscribe link count")
  assert(unwrap(mlAsString(links[0])) == msg.unsubscribe.url, "unsubscribe link changed")
}

test "live: RSA and Ed25519 DKIM verify over Mailpit raw bytes" {
  let s = mlScope("PLAIN")
  if (s.url == "") {
    return
  }
  defer s.clean()
  let o = mlOptions()
  o.dkim = [dwRsa(), Dkim{ domain = "inkwell.dev", selector = "ed1", key = rfcEdPem }]
  let m = mlOpen(s.url, o)
  defer m.close()
  let msg = s.message("dkim")
  mlSend(m, msg)
  let raw = s.raw(s.received(msg.subject))
  let canon = canonOf(raw)
  let sigs = dwNamed(dwHeaders(raw), "dkim-signature")
  assert(len(sigs) == 2, "wrong DKIM signature count")
  assert(contains(sigs[0], "a=rsa-sha256"), "RSA signature must be first")
  assert(contains(sigs[1], "a=ed25519-sha256"), "Ed25519 signature missing")
  for sig of sigs {
    assert(contains(collapse(sig), "bh=${canon.bh};"), "received body hash differs")
  }
  let rsaFields = selectFields(canon, hList(sigs[0]))
  let edFields = selectFields(canon, hList(sigs[1]))
  assert(rsaVerifies(rsaPkcs8Pem, sigs[0], rsaFields), "received RSA signature failed")
  assert(edVerifies(raw, sigs[1], edFields), "received Ed25519 signature failed")
  let changed = canonOf(replace(raw, "live body", "changed body"))
  assert(changed.bh != canon.bh, "body hash oracle accepted changed bytes")
  let bad = dwSelect(dwTampered(dwUnsigned(dwHeaders(raw))), hList(sigs[0]))
  assert(!rsaVerifies(rsaPkcs8Pem, sigs[0], bad), "RSA oracle accepted changed Subject")
  assert(!edVerifies(raw, sigs[1], bad), "Ed25519 oracle accepted changed Subject")
}

test "live: Bcc is delivered but absent from raw headers" {
  let s = mlScope("PLAIN")
  if (s.url == "") {
    return
  }
  defer s.clean()
  // Mailpit v1.31.4 adds Bcc to stored raw; inspect the unchanged SMTP input.
  let (m, attempts) = mlRetryMailer(s.url, mlOptions())
  defer m.close()
  let msg = s.message("bcc")
  msg.bcc = ["blind@live.test"]
  mlSend(m, msg)
  assert(attempts.calls == 1, "Bcc did not make one real SMTP attempt")
  let got = s.received(msg.subject)
  let bcc = mlArray(got, "Bcc")
  assert(len(bcc) == 1, "Mailpit did not record envelope Bcc")
  assert(mlString(bcc[0], "Address") == "blind@live.test", "Bcc address changed")
}
