import { Client as HttpClient, Redirects, Response as HttpResponse } from "std/http"

// A certificate is small; use the mail credential-response budget and bound
// the network request made by one cold certificate lookup.
const snsCertMaxBytes: int = 65536
const snsCertTimeoutMs: int = 5000

class SnsCertTransport {
  get: (string, int) => HttpResponse!,
  close: () => (),
}

fn snsCertificateTransport(): SnsCertTransport {
  // A fresh default client verifies the URL hostname with system/bundled
  // roots and has no learned Alt-Svc destination or caller TLS override.
  let client = HttpClient()
  client.setRedirects(Redirects.None)
  client.setMaxBodyBytes(snsCertMaxBytes)
  let get: (string, int) => HttpResponse! = (url, timeoutMs) => {
    return client.getTimeout(url, timeoutMs)?
  }
  return SnsCertTransport{ get = get, close = () => client.close() }
}

fn snsCertificateAnswer(res: HttpResponse, url: string): string!MailError {
  if (res.status != 200) {
    fail webhookRejected("SNS certificate response is not successful")
  }
  if (res.redirects != 0 || res.url != url) {
    fail webhookRejected("SNS certificate response changed its URL")
  }
  if (len(res.body) == 0 || len(res.body) > snsCertMaxBytes) {
    fail webhookRejected("SNS certificate response body is outside its limit")
  }
  return res.body
}

// shortcut: defer a declared helper until deferred callback calls work (#8479).
fn snsCloseCertificateTransport(transport: SnsCertTransport) {
  transport.close()
}

// A supplied transport is private test input. The real adapter above owns a
// Client; its shared HTTP/2 pool remains managed by std/http's own limits.
fn snsFetchCertificate(url: string, open: () => SnsCertTransport): string!MailError {
  if (!snsCertificateUrl(url)) {
    fail webhookRejected("SNS certificate URL is not allowed")
  }
  let transport = open()
  defer snsCloseCertificateTransport(transport)
  let res = transport.get(url, snsCertTimeoutMs) catch _ {
    fail webhookRejected("SNS certificate request failed")
  }
  return snsCertificateAnswer(res, url)?
}
