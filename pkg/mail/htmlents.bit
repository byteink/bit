// pkg/mail/htmlents.bit — HTML character references for htmlToText
// (htmltext.bit): `&amp;`, `&copy`, `&#8212;`, `&#x1F600;`.
//
// Follows the WHATWG HTML Standard's "character reference state" machine
// (§13.2.5.72 onward): names are case-sensitive; a few legacy names also match
// without the `;` (`&copy 2026`), except in an attribute value, where a legacy
// name followed by `=` or a letter or digit is left as typed so `?a=1&copy=2`
// stays a URL; a numeric reference without digits is not a reference; NUL, a
// surrogate or a value past U+10FFFF becomes U+FFFD; 0x80..0x9F is read as
// Windows-1252, as browsers do.
//
// The named table is the part of the standard's 2231 names that mail carries,
// every code point copied from the standard's table.

// Longest name in `namedRefs`, in bytes.
const maxRefName: int = 6

// Longest name in `legacyRefs`, in bytes.
const maxLegacyName: int = 5

const refAmp: u8 = 38
const refHash: u8 = 35
const refSemi: u8 = 59
const refEq: u8 = 61

const replacementChar: int = 0xFFFD
const maxCodePoint: int = 0x10FFFF

const namedRefs: map<string, int> = {
  "amp": 0x26,
  "AMP": 0x26,
  "lt": 0x3C,
  "LT": 0x3C,
  "gt": 0x3E,
  "GT": 0x3E,
  "quot": 0x22,
  "QUOT": 0x22,
  "apos": 0x27,
  "nbsp": 0xA0,
  "copy": 0xA9,
  "COPY": 0xA9,
  "reg": 0xAE,
  "REG": 0xAE,
  "trade": 0x2122,
  "hellip": 0x2026,
  "mdash": 0x2014,
  "ndash": 0x2013,
  "lsquo": 0x2018,
  "rsquo": 0x2019,
  "ldquo": 0x201C,
  "rdquo": 0x201D,
  "euro": 0x20AC,
  "pound": 0xA3,
}

// The names the standard also matches without the closing `;`.
const legacyRefs: map<string, int> = {
  "amp": 0x26,
  "AMP": 0x26,
  "lt": 0x3C,
  "LT": 0x3C,
  "gt": 0x3E,
  "GT": 0x3E,
  "quot": 0x22,
  "QUOT": 0x22,
  "nbsp": 0xA0,
  "copy": 0xA9,
  "COPY": 0xA9,
  "reg": 0xAE,
  "REG": 0xAE,
  "pound": 0xA3,
}

// Where a character reference ended and what it stands for.
class Ref {
  cp: int,
  next: int,
}

fn isDigit(c: u8): bool {
  return c >= u8(48) && c <= u8(57)
}

// The number of letters and digits at `s[at:]`, counting no further than `limit`.
fn alnumRun(s: string, at: int, limit: int): int {
  let n = 0
  while (n < limit && at + n < len(s) && isAlnum(s[at + n])) {
    n = n + 1
  }
  return n
}

// What the standard makes of a numeric value: the Windows-1252 reading of the
// C1 range, U+FFFD for what is not a Unicode scalar value.
fn fixNumeric(v: int): int {
  if (v == 0 || v > maxCodePoint || (v >= 0xD800 && v <= 0xDFFF)) {
    return replacementChar
  }
  if (v < 0x80 || v > 0x9F) {
    return v
  }
  let mapped = cp1252High()[v - 0x80]
  if (mapped == 0) {
    return v
  }
  return mapped
}

// The digits in `base` at `s[at:]`: how many, with their value in `r.cp` and
// the index after them in `r.next`. They keep being read past the maximum so a
// long run is consumed whole; the value stops growing at U+110000.
fn readDigits(s: string, at: int, base: int, r: Ref): int {
  let v = 0
  let digits = 0
  while (at < len(s)) {
    let d = hexVal(s[at])
    if (d < 0 || d >= base) {
      break
    }
    v = v * base + d
    if (v > maxCodePoint) {
      v = maxCodePoint + 1
    }
    digits = digits + 1
    at = at + 1
  }
  r.cp = v
  r.next = at
  return digits
}

// `&#...` or `&#x...` at `s[i]`: true with `r` set, or false when no digit
// follows.
fn numericRef(s: string, i: int, r: Ref): bool {
  let at = i + 2
  let base = 10
  if (at < len(s) && (s[at] == u8(120) || s[at] == u8(88))) {
    base = 16
    at = at + 1
  }
  if (readDigits(s, at, base, r) == 0) {
    return false
  }
  at = r.next
  if (at < len(s) && s[at] == refSemi) {
    at = at + 1
  }
  r.cp = fixNumeric(r.cp)
  r.next = at
  return true
}

// A name closed by `;` at `s[i+1:]`.
fn namedWithSemicolon(s: string, i: int, r: Ref): bool {
  let n = alnumRun(s, i + 1, maxRefName + 1)
  let end = i + 1 + n
  if (n == 0 || n > maxRefName || end >= len(s) || s[end] != refSemi) {
    return false
  }
  let cp = namedRefs[s[i + 1:end]]
  if (cp == 0) {
    return false
  }
  r.cp = cp
  r.next = end + 1
  return true
}

// A legacy name with no `;`, the longest that matches. In an attribute the
// byte after it must not be `=` or a letter or digit.
fn legacyNamed(s: string, i: int, inAttr: bool, r: Ref): bool {
  let n = alnumRun(s, i + 1, maxLegacyName)
  let k = n
  while (k >= 2) {
    let end = i + 1 + k
    let cp = legacyRefs[s[i + 1:end]]
    let after = end < len(s) && (s[end] == refEq || isAlnum(s[end]))
    if (cp != 0 && !(inAttr && after)) {
      r.cp = cp
      r.next = end
      return true
    }
    k = k - 1
  }
  return false
}

// The character reference at `s[i]`, which is `&`: true with `r.cp` and
// `r.next` (the index after it) set, or false when `&` is just a `&`.
fn charRef(s: string, i: int, inAttr: bool, r: Ref): bool {
  if (i + 1 >= len(s)) {
    return false
  }
  if (s[i + 1] == refHash) {
    return numericRef(s, i, r)
  }
  return namedWithSemicolon(s, i, r) || legacyNamed(s, i, inAttr, r)
}
