// pkg/mail/htmltag.bit — the markup half of htmlToText (htmltext.bit): reading
// a tag, its attributes and the few things a tag does to the text.

import { indexOf, toLower, trimSpace } from "std/strings"

const sq: u8 = 39

// The index of the first non-whitespace byte of `s` at or after `i`.
fn skipSpace(s: string, i: int): int {
  while (i < len(s) && isHtmlSpace(s[i])) {
    i = i + 1
  }
  return i
}

// The index of the first byte of `s[from:]` that is `b`, or -1.
fn findByte(s: string, from: int, b: u8): int {
  let i = from
  while (i < len(s)) {
    if (s[i] == b) {
      return i
    }
    i = i + 1
  }
  return -1
}

// The end of a tag name that starts at `from`.
fn tagNameEnd(s: string, from: int): int {
  let i = from
  while (i < len(s) && !isHtmlSpace(s[i]) && s[i] != slash && s[i] != gt) {
    i = i + 1
  }
  return i
}

// `s[a:b]` with its character references decoded, and trimmed.
fn attrValue(c: Conv, a: int, b: int): string {
  let s = c.html
  let out: []byte = []
  let i = a
  while (i < b) {
    if (s[i] == refAmp && charRef(s, i, true, c.ref)) {
      out = append(out, utf8String(c.ref.cp))
      i = c.ref.next
    } else {
      out = append(out, s[i])
      i = i + 1
    }
  }
  return trimSpace(string(out))
}

// The index after the attribute value at `j`, quotes included, or -1 when a
// quote is never closed. Unquoted, the value ends at whitespace or `>`.
fn valueEnd(s: string, j: int): int {
  if (s[j] == dq || s[j] == sq) {
    let stop = findByte(s, j + 1, s[j])
    if (stop < 0) {
      return -1
    }
    return stop + 1
  }
  let i = j
  while (i < len(s) && !isHtmlSpace(s[i]) && s[i] != gt) {
    i = i + 1
  }
  return i
}

// The end of an attribute name that starts at `i`. The first byte belongs to the
// name even when it is `=`.
fn attrNameEnd(s: string, i: int): int {
  let end = i + 1
  while (end < len(s) &&
    !isHtmlSpace(s[end]) &&
    s[end] != slash &&
    s[end] != gt &&
    s[end] != refEq) {
    end = end + 1
  }
  return end
}

// The decoded value of the attribute value spanning `s[j:next]`, quotes
// included when there are any.
fn valueText(c: Conv, j: int, next: int): string {
  if (c.html[j] == dq || c.html[j] == sq) {
    return attrValue(c, j + 1, next - 1)
  }
  return attrValue(c, j, next)
}

// One attribute at `i`; the index after it, or -1 when the input ends inside
// it. When the name is `want` and no value was kept yet, `c.val` takes the
// decoded value.
fn attr(c: Conv, i: int, want: string): int {
  let s = c.html
  let nameEnd = attrNameEnd(s, i)
  let j = skipSpace(s, nameEnd)
  if (j >= len(s) || s[j] != refEq) {
    return nameEnd
  }
  j = skipSpace(s, j + 1)
  if (j >= len(s)) {
    return -1
  }
  let next = valueEnd(s, j)
  if (next < 0) {
    return -1
  }
  if (want != "" && c.val == "" && eqFold(s, i, nameEnd, want)) {
    c.val = valueText(c, j, next)
  }
  return next
}

// The attributes of a tag whose name ends at `i`: the index after its `>`, or
// -1 when the input ends first. The decoded value of the attribute `want` (""
// for none) is left in `c.val`, "" when the tag has none.
fn scanAttrs(c: Conv, i: int, want: string): int {
  let s = c.html
  c.val = ""
  while (i < len(s)) {
    if (isHtmlSpace(s[i]) || s[i] == slash) {
      i = i + 1
    } else if (s[i] == gt) {
      return i + 1
    } else {
      i = attr(c, i, want)
      if (i < 0) {
        return -1
      }
    }
  }
  return -1
}

// What a link shows after its label: the URL, or for `mailto:` the address.
fn linkTarget(href: string): string {
  if (len(href) < 7 || !eqFold(href, 0, 7, "mailto:")) {
    return href
  }
  let rest = href[7:]
  let q = indexOf(rest, "?")
  if (q >= 0) {
    rest = rest[0:q]
  }
  return trimSpace(rest)
}

// `<a href=...>`: the label starts here. A link with no href is plain text.
fn openLink(c: Conv) {
  c.linkAt = -1
  if (c.val == "") {
    return
  }
  c.href = c.val
  c.linkAt = len(c.out)
}

// `</a>`: `label (u)`, or `u` for an empty label, or the label alone when it
// already is the target.
fn closeLink(c: Conv) {
  if (c.linkAt < 0) {
    return
  }
  let label = trimSpace(string(c.out[c.linkAt:]))
  let target = linkTarget(c.href)
  c.linkAt = -1
  if (target == "" || target == label) {
    return
  }
  if (label == "") {
    putString(c, target)
    return
  }
  c.sp = true
  putString(c, "(${target})")
}

// What the line-and-space tags do, on open (`<p>`) or close (`</p>`). `<br>` is
// one more line break, so two make a blank line.
fn flowTag(c: Conv, kind: int, opening: bool) {
  if (kind == kindBlock || kind == kindLi) {
    setBreak(c, 1)
  } else if (kind == kindPara) {
    setBreak(c, 2)
  } else if (kind == kindBr) {
    if (c.brk < 2) {
      c.brk = c.brk + 1
    }
  } else if (kind == kindCell) {
    c.sp = true
  }
  if (kind == kindLi && opening) {
    putString(c, "-")
    c.sp = true
  }
}

// A start tag of `kind` whose `>` ends just before `end`. Returns where reading
// goes on: after the tag, or after the content a raw-text tag drops.
fn openTag(c: Conv, kind: int, name: string, end: int): int {
  if (kind == kindLink) {
    openLink(c)
  } else if (kind == kindImg) {
    putString(c, c.val)
  } else if (kind == kindRaw) {
    return skipContent(c.html, end, name, false)
  } else if (kind == kindHead) {
    return skipContent(c.html, end, name, true)
  } else {
    flowTag(c, kind, true)
  }
  return end
}

// A start tag at `i`, whose first name byte is a letter.
fn startTag(c: Conv, i: int): int {
  let s = c.html
  let nameEnd = tagNameEnd(s, i + 1)
  let name = toLower(s[i + 1:nameEnd])
  let kind = tagKinds[name]
  let want = ""
  if (kind == kindLink) {
    want = "href"
  } else if (kind == kindImg) {
    want = "alt"
  }
  let end = scanAttrs(c, nameEnd, want)
  if (end < 0) {
    restAsText(c, i)
    return len(s)
  }
  return openTag(c, kind, name, end)
}

// An end tag at `i`, whose first name byte, at `i + 2`, is a letter.
fn endTag(c: Conv, i: int): int {
  let s = c.html
  let nameEnd = tagNameEnd(s, i + 2)
  let kind = tagKinds[toLower(s[i + 2:nameEnd])]
  let end = scanAttrs(c, nameEnd, "")
  if (end < 0) {
    restAsText(c, i)
    return len(s)
  }
  if (kind == kindLink) {
    closeLink(c)
  } else {
    flowTag(c, kind, false)
  }
  return end
}

// What starts with `</` at `i`: an end tag, `</>` (dropped), or a bogus comment
// that runs to the next `>`. At the end of the input it is text.
fn endMarkup(c: Conv, i: int): int {
  let s = c.html
  if (i + 2 >= len(s)) {
    restAsText(c, i)
    return len(s)
  }
  if (isAlpha(s[i + 2])) {
    return endTag(c, i)
  }
  return skipPastGt(s, i + 2)
}

// What starts with `<` at `i`; returns the index after it. A `<` that starts no
// markup is text.
fn markupAt(c: Conv, i: int): int {
  let s = c.html
  if (i + 1 >= len(s)) {
    putByte(c, lt)
    return i + 1
  }
  let b = s[i + 1]
  if (b == bang || b == question) {
    return skipDecl(s, i)
  }
  if (b == slash) {
    return endMarkup(c, i)
  }
  if (isAlpha(b)) {
    return startTag(c, i)
  }
  putByte(c, lt)
  return i + 1
}
