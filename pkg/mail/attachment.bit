// pkg/mail/attachment.bit — `Attachment`, a file that travels with a mail, and
// the MIME type table that names what kind of file it is.
//
// An attachment with a `cid` is inline: the HTML body shows it as
// `<img src="cid:logo">` (RFC 2392) and it is sent in a `multipart/related` with
// the HTML (RFC 2387). One without is an ordinary download. The checks that tie
// the two together are in attachcheck.bit and run when the message is rendered.

import { open as fileOpen } from "std/fs"
import { base } from "std/path"
import { lastIndexOf, toLower } from "std/strings"

// The type of a file whose extension is not in `mimeTypes` (RFC 2046 §4.5.1).
const unknownType: string = "application/octet-stream"

// Bytes in one MiB.
const mib: int = 1048576

// The most attachment bytes one message carries: the practical limit of Gmail,
// Outlook and Resend. A message over it is refused at render, because the
// provider would refuse it later with a worse message.
const maxAttachmentBytes: int = 25 * mib

// Media types by lowercase file extension, as IANA registers them
// (https://www.iana.org/assignments/media-types). The table is built in so the
// type of a file is the same on every machine; no operating system database is
// asked.
const mimeTypes: map<string, string> = {
  "pdf": "application/pdf",
  "png": "image/png",
  "jpg": "image/jpeg",
  "jpeg": "image/jpeg",
  "gif": "image/gif",
  "webp": "image/webp",
  "svg": "image/svg+xml",
  "ics": "text/calendar",
  "csv": "text/csv",
  "txt": "text/plain",
  "html": "text/html",
  "json": "application/json",
  "xml": "application/xml",
  "zip": "application/zip",
  "gz": "application/gzip",
  "doc": "application/msword",
  "docx": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
  "xls": "application/vnd.ms-excel",
  "xlsx": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
  "ppt": "application/vnd.ms-powerpoint",
  "pptx": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
  "odt": "application/vnd.oasis.opendocument.text",
  "ods": "application/vnd.oasis.opendocument.spreadsheet",
  "mp3": "audio/mpeg",
  "mp4": "video/mp4",
  "wav": "audio/vnd.wave",
  "eml": "message/rfc822",
}

// A file sent with a mail. `data` is the file's bytes as they are; the base64
// is written when the message is rendered, and the bytes are not copied before
// that.
//
//   let logo = Attachment{ name = "logo.png", data = png, cid = "logo" }
//   let invoice = Attachment.file("/var/invoices/7.pdf")?
export class Attachment {
  // The file name the recipient sees. Required.
  export name: string
  // The file's bytes. Required: an empty file is refused, since it is a bug
  // upstream far more often than a wish.
  export data: []byte
  // The MIME type. Empty means the one for `name`'s extension, and
  // `application/octet-stream` when the extension is not one this package knows.
  export contentType: string = ""
  // Set to show the file inside the HTML body, referenced there as
  // `cid:<cid>`. Empty means a plain attachment.
  export cid: string = ""

  // Reads the file at `path`. The name is the last component of the path, the
  // type is guessed from its extension, and `cid` makes it inline. Fails with
  // `MailError.Invalid` naming the path when the file cannot be read or is
  // larger than a message can carry.
  export static file(path: string, cid: string = ""): Attachment!MailError {
    let bytes = readBytes(path)?
    let name = base(path)
    return Attachment{ name = name, data = bytes, contentType = guessType(name), cid = cid }
  }
}

// The `Invalid` for a failure to read `path`.
fn readError(path: string, why: string): MailError {
  return MailError.Invalid("attachment ${path}: ${why}")
}

// The MIME type for a file called `name`, by its extension in any case.
fn guessType(name: string): string {
  let dot = lastIndexOf(name, ".")
  if (dot < 0) {
    return unknownType
  }
  let t = mimeTypes[toLower(name[dot + 1:])]
  if (t == "") {
    return unknownType
  }
  return t
}

// The whole of `path` in one buffer, read once into its final place. The size
// is known first so a file no message could carry is refused before it is read.
fn readBytes(path: string): []byte!MailError {
  if (hasLineByte(path)) {
    fail MailError.Invalid("attachment ${echoInput(path)}: the path contains a CR, LF or NUL")
  }
  let f = fileOpen(path) catch e {
    fail readError(path, e.message())
  }
  defer f.close()
  let size = f.size() catch e {
    fail readError(path, e.message())
  }
  if (size > i64(maxAttachmentBytes)) {
    fail readError(path, sizeFault(int(size)))
  }
  let buf = []byte(int(size))
  let got = 0
  while (got < len(buf)) {
    let n = f.readAt(buf[got:], i64(got)) catch e {
      fail readError(path, e.message())
    }
    if (n == 0) {
      fail readError(path, "the file ended after ${got} of ${len(buf)} bytes")
    }
    got = got + n
  }
  return buf
}

// The reason `n` attachment bytes are too many, in whole MiB rounded up so the
// figure is always over the limit it is compared with.
fn sizeFault(n: int): string {
  return "attachments total ${(n + mib - 1) / mib} MiB; most providers refuse more than ${maxAttachmentBytes /
    mib} MiB"
}
