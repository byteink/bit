// pkg/mail/htmltext.test.bit — htmlToText: one table of exact input and output
// per rule, then the properties no table can show: linear time on a megabyte,
// no input that fails, and a Message with only HTML rendering the same text part
// as one that carries that text.

import { Builder, contains, indexOf, repeat, replace } from "std/strings"
import { monotonic, since } from "std/time"

class TextCase {
  name: string,
  html: string,
  want: string,
}

fn tc(name: string, html: string, want: string): TextCase {
  return TextCase{ name = name, html = html, want = want }
}

fn structureCases(): []TextCase {
  return [
    tc("plain text", "Hello", "Hello"),
    tc("whitespace runs collapse", "  a \n\t b\r\n\u{c}c  ", "a b c"),
    tc("paragraphs leave a blank line", "<p>One</p><p>Two</p>", "One\n\nTwo"),
    tc("divs end the line", "<div>a</div><div>b</div>", "a\nb"),
    tc("br is a line break, two a blank line", "a<br>b<br/><br />c", "a\nb\n\nc"),
    tc("br runs stop at one blank line", "a<br><br><br><br>b", "a\n\nb"),
    tc("blank lines collapse", "<p>a</p><p></p><p> </p><p>b</p>", "a\n\nb"),
    tc("nothing leads or trails", "<br><div><p>a</p></div><br><br>", "a"),
    tc("hr is a line of its own", "a<hr>b", "a\nb"),
    tc("blockquote", "<blockquote>q</blockquote>after", "q\n\nafter"),
    tc(
      "a heading keeps its case and a blank line follows",
      "<h1>Welcome To Inkwell</h1><p>Hi</p>",
      "Welcome To Inkwell\n\nHi",
    ),
    tc(
      "a heading mid-text has one on each side",
      "text<h2>\u{dc}ber \u{645}\u{631}\u{62d}\u{628}\u{627}</h2>after",
      "text\n\n\u{dc}ber \u{645}\u{631}\u{62d}\u{628}\u{627}\n\nafter",
    ),
    tc("inline tags change nothing", "a<b>b</b> <i>c</i><span>d</span>", "ab cd"),
    tc("tag names are case-insensitive", "<P>A</P><BR><SCRIPT>x</SCRIPT>B", "A\n\nB"),
    tc(
      "non-ASCII text passes through",
      "<p>Caf\u{e9} \u{2014} \u{65e5}\u{672c}\u{8a9e}</p>",
      "Caf\u{e9} \u{2014} \u{65e5}\u{672c}\u{8a9e}",
    ),
  ]
}

fn dropCases(): []TextCase {
  return [
    tc("script content is dropped", "a<script>var x = '<p>hi</p>'; if (a < b) {}</script>b", "ab"),
    tc(
      "script, style and title are dropped with their spacing",
      "a <script>x</script> <style>p{}</style> <title>T</title> b",
      "a b",
    ),
    tc(
      "a head is dropped",
      "<html><head><meta charset=utf-8><title>T</title><style>p{}</style></head><body><p>Hi</p></body></html>",
      "Hi",
    ),
    tc("a head with no end stops at body", "<head><title>x</title><body>Hi", "Hi"),
    tc(
      "comment, doctype and CDATA are skipped",
      "<!DOCTYPE html><!-- c <p>no</p> --><p>x</p><![CDATA[ <p>y</p> ]]>z",
      "x\n\nz",
    ),
    tc("empty comments end at once", "a<!-->b<!--->c<!---->d", "abcd"),
    tc("a processing instruction is skipped", "<?xml version=\"1.0\"?>a", "a"),
  ]
}

fn linkCases(): []TextCase {
  return [
    tc(
      "a link shows its URL after the label",
      "<a href=\"https://e.com/x\">Site</a>",
      "Site (https://e.com/x)",
    ),
    tc(
      "a link whose label is the URL shows it once",
      "<a href=\"https://e.com\">https://e.com</a>",
      "https://e.com",
    ),
    tc(
      "a link with no label is its URL",
      "see <a href=\"https://e.com\"></a>",
      "see https://e.com",
    ),
    tc(
      "a mailto link shows the address",
      "<a href=\"mailto:sara@example.com\">Mail Sara</a>",
      "Mail Sara (sara@example.com)",
    ),
    tc(
      "a mailto link labelled with the address shows it once",
      "<a href=\"MAILTO:sara@example.com\">sara@example.com</a>",
      "sara@example.com",
    ),
    tc(
      "a mailto query is not shown",
      "<a href=\"mailto:a@b.co?subject=Hi\">write</a>",
      "write (a@b.co)",
    ),
    tc("an href with a quoted > and single quotes", "<a title=\"a>b\" href='u'>L</a>", "L (u)"),
    tc("an unquoted href", "<a href=u>L</a> <a class=x href=v>M</a>", "L (u) M (v)"),
    tc("an a with no href is plain text", "<a name=top>Top</a>", "Top"),
    tc(
      "an href's references are decoded",
      "<a href=\"https://e.com/?a=1&amp;b=2&copy=3\">x</a>",
      "x (https://e.com/?a=1&b=2&copy=3)",
    ),
    tc("an image gives its alt", "<img src=\"a.png\" alt=\"Logo\"> Inkwell", "Logo Inkwell"),
    tc(
      "an image with an empty alt or none gives nothing",
      "x<img src=a.png alt=\"\">y<img src=b.png>z",
      "xyz",
    ),
  ]
}

fn listAndTableCases(): []TextCase {
  return [
    tc(
      "list items start with a dash",
      "<ul><li>One</li><li>\n  Two  <b>bold</b></li></ul>",
      "- One\n- Two bold",
    ),
    tc(
      "nested lists stay one line per item",
      "<ul><li>a<ul><li>b</li></ul></li><li>c</li></ul>",
      "- a\n- b\n- c",
    ),
    tc("an ordered list is dashes too", "<ol><li>a</li><li>b</li></ol>", "- a\n- b"),
    tc(
      "table cells are spaced, rows are lines",
      "<table><tr><td>a</td><td>b</td></tr><tr><th>c</th><td>d</td></tr></table>",
      "a b\nc d",
    ),
    tc(
      "a nested table starts its own line",
      "<table><tr><td>a</td><td><table><tr><td>b</td></tr></table></td></tr></table>",
      "a\nb",
    ),
  ]
}

fn entityCases(): []TextCase {
  return [
    tc("the markup characters", "&amp; &lt;b&gt; &quot;q&quot; &apos;s&apos;", "& <b> \"q\" 's'"),
    tc("a non-breaking space is kept as one", "a&nbsp;&nbsp;b", "a\u{a0}\u{a0}b"),
    tc(
      "symbol names",
      "&copy; &reg; &trade; &hellip; &euro;5 &pound;3",
      "\u{a9} \u{ae} \u{2122} \u{2026} \u{20ac}5 \u{a3}3",
    ),
    tc(
      "dashes and quotes",
      "&mdash; &ndash; &lsquo;x&rsquo; &ldquo;y&rdquo;",
      "\u{2014} \u{2013} \u{2018}x\u{2019} \u{201c}y\u{201d}",
    ),
    tc(
      "numeric decimal and hex, either X",
      "&#65;&#x42;&#X43;&#8212;&#x1F600;",
      "ABC\u{2014}\u{1f600}",
    ),
    tc(
      "an invalid code point is U+FFFD",
      "&#0;&#xD800;&#x110000;&#99999999999999999999;",
      "\u{fffd}\u{fffd}\u{fffd}\u{fffd}",
    ),
    tc("a C1 number is read as Windows-1252", "&#150;&#x93;x&#x81;", "\u{2013}\u{201c}x\u{81}"),
    tc("a number needs no semicolon", "&#65B", "AB"),
    tc("an entity for whitespace collapses", "a&#32;&#32;b&#10;c", "a b c"),
    tc(
      "what is no reference stays as typed",
      "&foo; & AT&T &#; &#x; &hellip &AMP;",
      "&foo; & AT&T &#; &#x; &hellip &",
    ),
    tc("legacy names need no semicolon", "&copy 2026 &ampx &lt3", "\u{a9} 2026 &x <3"),
    tc("names are case-sensitive", "&Amp; &COPY;", "&Amp; \u{a9}"),
    tc("a reference is text, not markup", "&lt;script&gt;x&lt;/script&gt;", "<script>x</script>"),
  ]
}

fn malformedCases(): []TextCase {
  return [
    tc("an unclosed element", "<p>Hello <b>world", "Hello world"),
    tc("end tags with no start", "a</p></div></b>b", "a\n\nb"),
    tc("a stray <", "a < b and 1<2 and <3 <", "a < b and 1<2 and <3 <"),
    tc("a tag cut off by the end is text", "Hello <b", "Hello <b"),
    tc("an unclosed quote makes the rest text", "<a href=\"x>t</a>", "<a href=\"x>t</a>"),
    tc("an unclosed comment runs to the end", "a<!-- b <p>c", "a"),
    tc("an unclosed script runs to the end", "a<script>b</p>c", "a"),
    tc("</> is dropped, </ with no name is a comment", "a</>b</ x>c", "abc"),
    tc("junk in a tag", "<p =x \"y\" / / class>a</p>", "a"),
    tc("end of input after </", "a</", "a</"),
  ]
}

fn check(cases: []TextCase) {
  for k of cases {
    let got = htmlToText(k.html)
    assert(got == k.want, "${k.name}: ${k.html} gave ${got}, want ${k.want}")
  }
}

test "structure: lines, spacing, headings" {
  check(structureCases())
}

test "what is dropped" {
  check(dropCases())
}

test "links and images" {
  check(linkCases())
}

test "lists and tables" {
  check(listAndTableCases())
}

test "character references" {
  check(entityCases())
}

test "malformed HTML degrades, it never fails" {
  check(malformedCases())
}

test "a long line is not re-wrapped" {
  let line = repeat("word ", 400)
  let got = htmlToText("<p>${line}</p>")
  assert(!contains(got, "\n"), "a newline was added")
  assert(len(got) == len(line) - 1, "length ${len(got)}")
}

// One block of mixed markup, about 100 bytes.
fn sample(k: int): string {
  return "<div class=\"c\"><p>Item ${k} &amp; <a href=\"https://e.com/${k}\">more</a></p><ul><li>x</li><li>y</li></ul></div>\n"
}

fn megabyte(): string {
  let b = Builder()
  let k = 0
  while (b.length() < 1000000) {
    b.write(sample(k))
    k = k + 1
  }
  return b.toString()
}

test "a megabyte of HTML converts in under 200 ms" {
  let html = megabyte()
  assert(len(html) >= 1000000, "input ${len(html)}")
  let t = monotonic()
  let got = htmlToText(html)
  let ms = since(t) / 1000000
  assert(len(got) > 100000, "output ${len(got)}")
  assert(ms < 200, "took ${ms} ms")
}

// Input that makes a scanner quadratic if it rescans: many openers that never
// close. Each must still be linear, so 200000 of them stay far under a second.
test "unclosed constructs are linear" {
  let openers = ["<a href=\"", "<!--", "<script>", "<![CDATA[", "<p x='", "&#", "&amp", "<", "</"]
  for o of openers {
    let html = repeat(o, 200000)
    let t = monotonic()
    let got = htmlToText(html)
    let ms = since(t) / 1000000
    assert(ms < 1000, "${o} took ${ms} ms, output ${len(got)}")
  }
}

// A deterministic stream of tag-soup pieces.
fn soup(seed: int, pieces: int): string {
  let parts = [
    "<",
    ">",
    "</",
    "/>",
    "<p>",
    "</p>",
    "<a href=\"",
    "\"",
    "'",
    "=",
    "&",
    "&amp;",
    "&#x",
    ";",
    "<!--",
    "-->",
    "<script>",
    "</script>",
    "<br>",
    "<li>",
    "x",
    " ",
    "\n",
    "<td>",
    "<![CDATA[",
    "]]>",
    "<head>",
    "<body>",
    "<img alt=",
    "\u{e9}",
  ]
  let b = Builder()
  let state = seed
  let k = 0
  while (k < pieces) {
    state = (state * 1103515245 + 12345) % 2147483648
    b.write(parts[state / 65536 % len(parts)])
    k = k + 1
  }
  return b.toString()
}

test "no tag soup fails, and the output is always trimmed with no triple newline" {
  let seed = 1
  while (seed <= 300) {
    let got = htmlToText(soup(seed, 60))
    assert(!contains(got, "\n\n\n"), "seed ${seed}: triple newline")
    assert(got == "" || (got[0] != u8(10) && got[0] != u8(32)), "seed ${seed}: leading space")
    assert(
      got == "" || (got[len(got) - 1] != u8(10) && got[len(got) - 1] != u8(32)),
      "seed ${seed}: trailing space",
    )
    seed = seed + 1
  }
}

fn htmlOnly(html: string): Message {
  return Message{
    from = "Inkwell <hello@inkwell.dev>",
    to = ["Sara Ali <sara@example.com>"],
    subject = "Welcome to Inkwell",
    html = html,
    id = "welcome-7",
  }
}

// The text/plain part of rendered `data`: its body up to the next boundary.
fn textPart(data: string): string {
  let at = indexOf(data, "text/plain")
  assert(at >= 0, "no text/plain part")
  let rest = data[at:]
  let body = rest[indexOf(rest, "\r\n\r\n") + 4:]
  return body[0:indexOf(body, "\r\n--")]
}

test "a message with only html renders a text part equal to htmlToText(html)" {
  let html = "<h1>Welcome</h1><p>Hi Sara, <a href=\"https://inkwell.dev/start\">start here</a>.</p><ul><li>One</li><li>Two</li></ul>"
  let want = htmlToText(html)
  assert(
    want == "Welcome\n\nHi Sara, start here (https://inkwell.dev/start).\n\n- One\n- Two",
    want,
  )
  let data = render(htmlOnly(html)).data
  assert(textPart(data) == replace(want, "\n", "\r\n"), textPart(data))
  assert(contains(data, "text/html"), "html part")
}

test "an explicit text is never replaced by the html's reading" {
  let m = htmlOnly("<p>From html</p>")
  m.text = "From text"
  let data = render(m).data
  assert(textPart(data) == "From text", textPart(data))
}
