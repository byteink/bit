// pkg/mail/address.test.bit — parseAddress and parseAddressList: a table of
// accepted mailboxes with the (name, email) each must produce, a table of
// refused inputs with the reason each must name, the round trip through
// `Address.toString`, and the guarantees about what an error message echoes.

import { contains, repeat } from "std/strings"

class Valid {
  input: string,
  name: string,
  email: string,
}

fn valid(input: string, name: string, email: string): Valid {
  return Valid{ input = input, name = name, email = email }
}

// Every row is one mailbox the parser must accept.
fn validRows(): []Valid {
  return [
    valid("sara@example.com", "", "sara@example.com"),
    valid("Sara <sara@example.com>", "Sara", "sara@example.com"),
    valid("\"Ali, Sara\" <sara@example.com>", "Ali, Sara", "sara@example.com"),
    valid("\"odd local\"@example.com", "", "\"odd local\"@example.com"),
    valid("<sara@example.com>", "", "sara@example.com"),
    valid("  sara@example.com \t", "", "sara@example.com"),
    valid("Sara Ali <sara@example.com>", "Sara Ali", "sara@example.com"),
    valid("Sara    Ali  \t <sara@example.com>", "Sara Ali", "sara@example.com"),
    valid(
      "\"Sara \\\"The Pen\\\" Ali\" <sara@example.com>",
      "Sara \"The Pen\" Ali",
      "sara@example.com",
    ),
    valid("\"Sara \\\\ Ali\" <sara@example.com>", "Sara \\ Ali", "sara@example.com"),
    valid("Dr. Sara Ali <sara@example.com>", "Dr. Sara Ali", "sara@example.com"),
    valid("O'Brien <obrien@example.com>", "O'Brien", "obrien@example.com"),
    valid("José García <jose@example.com>", "José García", "jose@example.com"),
    valid("\"José García\" <jose@example.com>", "José García", "jose@example.com"),
    valid("用户@例え.jp", "", "用户@例え.jp"),
    valid("Zoë <zoë@bücher.example>", "Zoë", "zoë@bücher.example"),
    valid("=?UTF-8?B?U2FyYSBBbGk=?= <sara@example.com>", "Sara Ali", "sara@example.com"),
    valid("=?UTF-8?Q?Jos=C3=A9?= <jose@example.com>", "José", "jose@example.com"),
    valid("=?utf-8?q?Sara_Ali?= <sara@example.com>", "Sara Ali", "sara@example.com"),
    valid("=?ISO-8859-1?Q?Andr=E9?= <andre@example.com>", "André", "andre@example.com"),
    valid("=?windows-1252?Q?=80uro?= <euro@example.com>", "€uro", "euro@example.com"),
    valid(
      "=?UTF-8?B?U2Fy?= =?UTF-8?B?YSBBbGk=?= <sara@example.com>",
      "Sara Ali",
      "sara@example.com",
    ),
    valid("=?UTF-8?B?U2FyYQ?= <sara@example.com>", "Sara", "sara@example.com"),
    valid("\"=?UTF-8?B?U2FyYQ==?=\" <sara@example.com>", "Sara", "sara@example.com"),
    valid("=?UTF-8*en?Q?Sara?= <sara@example.com>", "Sara", "sara@example.com"),
    valid("sara.ali+news@example.com", "", "sara.ali+news@example.com"),
    valid("sara@localhost", "", "sara@localhost"),
    valid("Sara <sara@sub.example.co.uk>", "Sara", "sara@sub.example.co.uk"),
    valid("\"\" <sara@example.com>", "", "sara@example.com"),
    valid("\"a@b\" <sara@example.com>", "a@b", "sara@example.com"),
    valid("\"sara\"@example.com", "", "sara@example.com"),
    valid("\"a\\\"b\"@example.com", "", "\"a\\\"b\"@example.com"),
    valid("sara@xn--bcher-kva.example", "", "sara@xn--bcher-kva.example"),
    valid("Sara <SARA@Example.COM>", "Sara", "SARA@Example.COM"),
    valid("\"Ali < Sara\" <sara@example.com>", "Ali < Sara", "sara@example.com"),
    valid("\"Ali > Sara, Jr\" <sara@example.com>", "Ali > Sara, Jr", "sara@example.com"),
    valid("\"Tom (the boss)\" <tom@example.com>", "Tom (the boss)", "tom@example.com"),
    valid("\"list: x;\" <list@example.com>", "list: x;", "list@example.com"),
    valid("Sara<sara@example.com>", "Sara", "sara@example.com"),
    valid("Sara <sara@example.com>  ", "Sara", "sara@example.com"),
    valid("=?UTF-8?B?PEFsaT4=?= <sara@example.com>", "<Ali>", "sara@example.com"),
    valid(repeat("a", 64) + "@example.com", "", repeat("a", 64) + "@example.com"),
    valid("a@" + repeat("b", 63) + ".com", "", "a@" + repeat("b", 63) + ".com"),
  ]
}

fn parsed(input: string): Address {
  return parseAddress(input) catch e {
    panic("parseAddress(${input}) failed: ${e.message()}")
  }
}

test "every valid row parses to its name and email" {
  for r of validRows() {
    let a = parsed(r.input)
    assert(a.name == r.name, "name of ${r.input}: got '${a.name}', want '${r.name}'")
    assert(a.email == r.email, "email of ${r.input}: got '${a.email}', want '${r.email}'")
  }
}

test "there are at least 25 valid rows" {
  assert(len(validRows()) >= 25, "table too small")
}

test "toString round-trips through parseAddress for every valid row" {
  for r of validRows() {
    let a = parsed(r.input)
    let again = parsed(a.toString())
    assert(
      again.name == a.name,
      "name after round trip of ${r.input}: '${again.name}' vs '${a.name}'",
    )
    assert(
      again.email == a.email,
      "email after round trip of ${r.input}: '${again.email}' vs '${a.email}'",
    )
  }
}

test "toString spells the common shapes" {
  assert(
      Address{ name = "Sara Ali", email = "sara@example.com" }.toString() ==
      "Sara Ali <sara@example.com>",
  )
  assert(Address{ name = "", email = "sara@example.com" }.toString() == "sara@example.com")
  assert(
      Address{ name = "Ali, Sara", email = "sara@example.com" }.toString() ==
      "\"Ali, Sara\" <sara@example.com>",
  )
  assert(
      Address{ name = "Sara \"S\" Ali", email = "s@example.com" }.toString() ==
      "\"Sara \\\"S\\\" Ali\" <s@example.com>",
  )
  assert(Address{ name = "José", email = "jose@example.com" }.toString() == "José <jose@example.com>")
}

test "a name that spells an encoded word travels as one and reads back unchanged" {
  let a = Address{ name = "=?UTF-8?B?QQ==?=", email = "s@example.com" }
  let back = parsed(a.toString())
  assert(back.name == "=?UTF-8?B?QQ==?=", "got '${back.name}'")
}

class Invalid {
  input: string,
  reason: string,
}

fn invalid(input: string, reason: string): Invalid {
  return Invalid{ input = input, reason = reason }
}

fn bytesOf(parts: []int): string {
  let b: []byte = []
  for p of parts {
    b = append(b, u8(p))
  }
  return string(b)
}

// Every row is one input the parser must refuse, with a substring of why.
fn invalidRows(): []Invalid {
  return [
    invalid("", "empty"),
    invalid("   \t ", "empty"),
    invalid("sara.example.com", "no @"),
    invalid("Sara Ali", "no @"),
    invalid("a@b.com, c@d.com", "more than one address"),
    invalid("Ali, Sara <sara@example.com>", "more than one address"),
    invalid("sara@example.com,", "more than one address"),
    invalid("list: a@b.com;", "group syntax"),
    invalid("Team: a@b.com, c@d.com;", "group syntax"),
    invalid("<@a.com:b@c.com>", "group syntax"),
    invalid("Sara (work) <sara@example.com>", "comments"),
    invalid("sara@example.com (Sara)", "comments"),
    invalid("sara@example.com\r\nBcc: evil@example.net", "CR"),
    invalid("sara@example.com\nBcc: evil@example.net", "LF"),
    invalid("sara@example.com" + bytesOf([0]), "NUL"),
    invalid("\"Sara\r\" <sara@example.com>", "CR"),
    invalid("=?UTF-8?B?DQo=?= <sara@example.com>", "display name contains a CR"),
    invalid("=?UTF-8?Q?a=00b?= <sara@example.com>", "display name contains a NUL"),
    invalid("Sara" + bytesOf([7]) + " <sara@example.com>", "control byte 0x07"),
    invalid("sara@example.com" + bytesOf([0xe2, 0x80, 0xa8]), "Unicode control or line separator"),
    invalid("Sara" + bytesOf([0xc2, 0x85]) + " <sara@example.com>", "U+0085"),
    invalid("sara" + bytesOf([0xff]) + "@example.com", "not valid UTF-8"),
    invalid(repeat("a", 65) + "@example.com", "over the limit of 64"),
    invalid(
      repeat("a", 60) + "@" + repeat(repeat("b", 60) + ".", 4) + "com",
      "over the limit of 254",
    ),
    invalid("a@b..com", "empty label"),
    invalid("a@.com", "empty label"),
    invalid("a@com.", "empty label"),
    invalid("a@" + repeat("b", 64) + ".com", "over the limit of 63"),
    invalid("a@[1.2.3.4]", "domain literal"),
    invalid("a@[IPv6:::1]", "domain literal"),
    invalid("<>", "empty address"),
    invalid("a@b@example.com", "more than one @"),
    invalid("@example.com", "empty local part"),
    invalid("a@", "empty domain"),
    invalid("Sara <sara@example.com", "missing the closing '>'"),
    invalid("Sara <sara@example.com> junk", "text after the closing '>'"),
    invalid("<<sara@example.com>", "more than one '<'"),
    invalid("\"unterminated <sara@example.com>", "unterminated quoted string"),
    invalid("sara@exa mple.com", "whitespace"),
    invalid("Sara sara@example.com", "whitespace"),
    invalid(".sara@example.com", "a dot at the start"),
    invalid("sara.@example.com", "a dot at the start"),
    invalid("sa..ra@example.com", "doubled"),
    invalid("sa ra@example.com", "whitespace"),
    invalid("sara@-bad.example", "hyphen"),
    invalid("sara@exam_ple.com", "'_' is not allowed in a domain"),
    invalid("sa,ra@example.com", "more than one address"),
    invalid("<sa,ra@example.com>", "the character ','"),
    invalid("\"a\"b@example.com", "after the quoted local part"),
    invalid("sara@example.com <sara@example.com>", "unquoted display name cannot contain '@'"),
    invalid("Sa\\ra <sara@example.com>", "the character"),
    invalid("=?UTF-8?B?!!!?= <sara@example.com>", "not valid base64"),
    invalid("=?KOI8-R?B?QQ==?= <sara@example.com>", "unsupported charset 'koi8-r'"),
    invalid("=?UTF-8?X?QQ?= <sara@example.com>", "not B or Q"),
    invalid("=?UTF-8?Q?a=4?= <sara@example.com>", "bad =XX escape"),
    invalid("=?US-ASCII?Q?=E9?= <sara@example.com>", "non-ASCII"),
    invalid("=?UTF-8?Q?=FF?= <sara@example.com>", "display name is not valid UTF-8"),
    invalid("\"a\tb\"@example.com", "tab"),
  ]
}

// The message `parseAddress` refuses `input` with, "" when it accepts it.
fn refusal(input: string): string {
  parseAddress(input) catch e {
    return e.message()
  }
  return ""
}

test "there are at least 20 invalid rows" {
  assert(len(invalidRows()) >= 20, "table too small")
}

test "every invalid row is refused with its reason, naming the input" {
  for r of invalidRows() {
    let msg = refusal(r.input)
    assert(msg != "", "accepted ${r.input}")
    assert(contains(msg, r.reason), "reason for ${r.input}: want '${r.reason}' in '${msg}'")
    assert(contains(msg, "invalid address"), "message does not name the input: ${msg}")
  }
}
