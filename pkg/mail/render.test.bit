// pkg/mail/render.test.bit — `renderMessage`: what a full message renders to,
// the four developer mistakes and their exact words, the address and id
// refusals naming their field, threading, Auto-Submitted, the envelope, and
// the guarantee that `tags` and `bcc` never reach the bytes.

import { contains, hasPrefix, indexOf, join, split, toLower } from "std/strings"

fn noDefaults(): Defaults {
  return Defaults{ from = "", replyTo = [] }
}

// A complete, valid message every test starts from.
fn welcome(): Message {
  return Message{
    from = "Inkwell <hello@inkwell.dev>",
    to = ["Sara Ali <sara@example.com>"],
    subject = "Welcome to Inkwell",
    text = "Hello Sara.",
  }
}

// `m` rendered, or "ERR <message>".
fn outcome(m: Message, d: Defaults): string {
  let r = renderMessage(m, d) catch e {
    return "ERR ${e.message()}"
  }
  return r.data
}

fn refused(m: Message): string {
  return outcome(m, noDefaults())
}

fn render(m: Message): Rendered {
  return renderMessage(m, noDefaults()) catch e {
    assert(false, "unexpected refusal: ${e.message()}")
    return Rendered{ envelope = Envelope{ from = "", to = [] }, data = "", messageId = "" }
  }
}

// The header lines of `data`, one per entry, folds included.
fn headerBlock(data: string): []string {
  return split(data[0:indexOf(data, "\r\n\r\n")], "\r\n")
}

// `data` without its `Date:` line, which changes with the clock.
fn withoutDate(data: string): string {
  let out: []string = []
  for line of split(data, "\r\n") {
    if (!hasPrefix(line, "Date: ")) {
      out = append(out, line)
    }
  }
  return join(out, "\r\n")
}

fn fullMessage(): Message {
  return Message{
    from = "Inkwell <hello@inkwell.dev>",
    to = ["Sara Ali <sara@example.com>", "kim@example.com"],
    cc = ["lee@example.com"],
    bcc = ["audit@inkwell.dev", "SARA@example.com"],
    replyTo = ["Support <support@inkwell.dev>"],
    subject = "Welcome to Inkwell",
    text = "Hello Sara.",
    headers = { "X-Run": "7", "X-Campaign": "welcome", "Precedence": "bulk" },
    inReplyTo = "<signup-1@inkwell.dev>",
    references = ["<thread-0@inkwell.dev>", "<signup-1@inkwell.dev>"],
    id = "welcome-7",
  }
}

test "a full message renders every header the ticket lists" {
  let r = render(fullMessage())
  let head = headerBlock(r.data)
  assert(contains(r.data, "From: \"Inkwell\" <hello@inkwell.dev>\r\n"), "From: ${r.data}")
  assert(
    contains(r.data, "To: \"Sara Ali\" <sara@example.com>, <kim@example.com>\r\n"),
    "To: ${r.data}",
  )
  assert(contains(r.data, "Cc: <lee@example.com>\r\n"), "Cc")
  assert(contains(r.data, "Reply-To: \"Support\" <support@inkwell.dev>\r\n"), "Reply-To")
  assert(contains(r.data, "Subject: Welcome to Inkwell\r\n"), "Subject")
  assert(contains(r.data, "Message-ID: <welcome-7@inkwell.dev>\r\n"), "Message-ID")
  assert(contains(r.data, "In-Reply-To: <signup-1@inkwell.dev>\r\n"), "In-Reply-To")
  assert(
    contains(r.data, "References: <thread-0@inkwell.dev> <signup-1@inkwell.dev>\r\n"),
    "References",
  )
  assert(contains(r.data, "Auto-Submitted: auto-generated\r\n"), "Auto-Submitted")
  assert(r.messageId == "<welcome-7@inkwell.dev>", "messageId ${r.messageId}")
  assert(len(head) > 8, "headers: ${r.data}")
}

test "no Bcc line and no blind address in the bytes" {
  let r = render(fullMessage())
  assert(!contains(toLower(r.data), "bcc"), "Bcc leaked: ${r.data}")
  assert(!contains(r.data, "audit@inkwell.dev"), "blind recipient in the bytes")
}

test "custom headers are written sorted by name" {
  let r = render(fullMessage())
  let a = indexOf(r.data, "\r\nAuto-Submitted: ")
  let b = indexOf(r.data, "\r\nPrecedence: bulk")
  let c = indexOf(r.data, "\r\nX-Campaign: welcome")
  let d = indexOf(r.data, "\r\nX-Run: 7")
  assert(a > 0 && b > a && c > b && d > c, "order ${a} ${b} ${c} ${d} in ${r.data}")
}

// #7094: an omitted map is a live empty map, so a key can be written into a
// fresh message and two messages never share one.
test "a header and a tag can be written into a fresh Message" {
  let m = welcome()
  let other = welcome()
  m.headers["X-Run"] = "7"
  m.tags["campaign"] = "welcome"
  assert(contains(render(m).data, "\r\nX-Run: 7"), "X-Run missing from ${render(m).data}")
  assert(len(other.headers) == 0 && len(other.tags) == 0, "defaults were shared")
}

test "the envelope holds every recipient once, case-insensitively" {
  let r = render(fullMessage())
  assert(r.envelope.from == "hello@inkwell.dev", "from ${r.envelope.from}")
  let want = ["sara@example.com", "kim@example.com", "lee@example.com", "audit@inkwell.dev"]
  assert(len(r.envelope.to) == len(want), "to ${join(r.envelope.to, ",")}")
  let i = 0
  while (i < len(want)) {
    assert(r.envelope.to[i] == want[i], "to[${i}] ${r.envelope.to[i]}")
    i = i + 1
  }
}

test "tags change no byte" {
  let plain = welcome()
  plain.id = "t-1"
  let tagged = welcome()
  tagged.id = "t-1"
  tagged.tags = { "a": "b", "campaign": "welcome" }
  assert(
    withoutDate(render(plain).data) == withoutDate(render(tagged).data),
    "tags reached the bytes",
  )
  assert(!contains(render(tagged).data, "campaign"), "tag name in the bytes")
}

test "the four developer mistakes each fail in their own words" {
  let noFrom = welcome()
  noFrom.from = ""
  assert(
    refused(noFrom) == "ERR mail: Message.from is empty and Options.from is not set",
    refused(noFrom),
  )
  let noTo = welcome()
  noTo.to = []
  assert(refused(noTo) == "ERR mail: Message has no recipient: set to, cc or bcc", refused(noTo))
  let noBody = welcome()
  noBody.text = ""
  assert(refused(noBody) == "ERR mail: Message has no body: set text or html", refused(noBody))
  let noSubject = welcome()
  noSubject.subject = ""
  assert(refused(noSubject) == "ERR mail: Message.subject is empty", refused(noSubject))
  noSubject.subject = "  "
  assert(refused(noSubject) == "ERR mail: Message.subject is empty", "blank subject")
}

test "a recipient only in bcc is enough" {
  let m = welcome()
  m.to = []
  m.bcc = ["audit@inkwell.dev"]
  assert(render(m).envelope.to[0] == "audit@inkwell.dev", "bcc-only")
}

test "the mailer defaults fill an empty From and Reply-To" {
  let m = welcome()
  m.from = ""
  let d = Defaults{ from = "Inkwell <hello@inkwell.dev>", replyTo = ["support@inkwell.dev"] }
  let data = outcome(m, d)
  assert(contains(data, "From: \"Inkwell\" <hello@inkwell.dev>\r\n"), data)
  assert(contains(data, "Reply-To: <support@inkwell.dev>\r\n"), data)
  m.replyTo = ["me@example.com"]
  assert(contains(outcome(m, d), "Reply-To: <me@example.com>\r\n"), "own Reply-To wins")
  d.from = "nonsense"
  assert(
    contains(
      outcome(Message{ to = ["a@b.com"], subject = "s", text = "t" }, d),
      "ERR mail: Options.from: invalid address",
    ),
    "bad default",
  )
}

test "a bad address names its field and index" {
  let m = welcome()
  m.to = ["a@example.com", "no-at-sign"]
  assert(contains(refused(m), "ERR mail: to[1]: invalid address \"no-at-sign\""), refused(m))
  m = welcome()
  m.cc = ["bad"]
  assert(contains(refused(m), "ERR mail: cc[0]: "), refused(m))
  m = welcome()
  m.bcc = ["ok@example.com", "ok2@example.com", "x"]
  assert(contains(refused(m), "ERR mail: bcc[2]: "), refused(m))
  m = welcome()
  m.replyTo = ["x"]
  assert(contains(refused(m), "ERR mail: replyTo[0]: "), refused(m))
  m = welcome()
  m.from = "nope"
  assert(contains(refused(m), "ERR mail: from: "), refused(m))
}

test "header injection through an address is refused with no raw line break" {
  let m = welcome()
  m.to = ["a@example.com\r\nBcc: evil@example.net"]
  let r = refused(m)
  assert(contains(r, "ERR mail: to[0]: "), r)
  assert(!contains(r, "\r") && !contains(r, "\n"), "raw break in the error")
}

test "an id becomes the left side of the Message-ID at the From domain" {
  let m = welcome()
  m.id = "welcome-7"
  assert(render(m).messageId == "<welcome-7@inkwell.dev>", "id")
  m.id = "a.b+c"
  assert(render(m).messageId == "<a.b+c@inkwell.dev>", "dot-atom-text")
}

test "an id that is not dot-atom-text is refused" {
  for bad of ["a b", "a@b", ".a", "a.", "a..b", "café", "a\r\nBcc: x@y.com", "<a>"] {
    let m = welcome()
    m.id = bad
    let r = refused(m)
    assert(contains(r, "ERR mail: id: "), "${bad}: ${r}")
    assert(!contains(r, "\r") && !contains(r, "\n"), "raw break in the error")
  }
}

test "without an id the Message-ID is generated at the From domain and differs each time" {
  let a = render(welcome()).messageId
  let b = render(welcome()).messageId
  assert(hasPrefix(a, "<") && contains(a, "@inkwell.dev>"), a)
  assert(a != b, "ids repeat")
}

test "In-Reply-To alone sets References to the same id" {
  let m = welcome()
  m.inReplyTo = "signup-1@inkwell.dev"
  let data = outcome(m, noDefaults())
  assert(contains(data, "In-Reply-To: <signup-1@inkwell.dev>\r\n"), data)
  assert(contains(data, "References: <signup-1@inkwell.dev>\r\n"), data)
}

test "References are deduplicated, order kept, with In-Reply-To last" {
  let m = welcome()
  m.references = ["<a@x.com>", "<b@x.com>", "<a@x.com>", "c@x.com"]
  m.inReplyTo = "<b@x.com>"
  let data = outcome(m, noDefaults())
  assert(contains(data, "References: <a@x.com> <b@x.com> <c@x.com>\r\n"), data)
}

test "a message with no inReplyTo and no references has neither header" {
  let data = outcome(welcome(), noDefaults())
  assert(!contains(data, "In-Reply-To"), data)
  assert(!contains(data, "References"), data)
}

test "a message id that is not an RFC 5322 msg-id is refused" {
  for bad of ["no-at", "a@b@c", "<a@b", "a b@x.com", "@x.com", "a@", "a@[1.2.3.4]", "<>"] {
    let m = welcome()
    m.references = ["<ok@x.com>", bad]
    let r = refused(m)
    assert(contains(r, "ERR mail: references[1]: "), "${bad}: ${r}")
  }
  let m = welcome()
  m.inReplyTo = "nope"
  assert(contains(refused(m), "ERR mail: inReplyTo: "), refused(m))
}

test "Auto-Submitted is auto-generated unless the caller set it" {
  assert(
    contains(outcome(welcome(), noDefaults()), "Auto-Submitted: auto-generated\r\n"),
    "default",
  )
  let m = welcome()
  m.headers = { "auto-submitted": "auto-replied" }
  let data = outcome(m, noDefaults())
  assert(contains(data, "auto-submitted: auto-replied\r\n"), data)
  assert(!contains(data, "auto-generated"), "both written: ${data}")
}

test "a header name set twice is refused, not silently merged" {
  let m = welcome()
  m.headers = { "X-A": "1", "x-a": "2" }
  assert(contains(refused(m), "ERR mail: headers[\""), refused(m))
  assert(contains(refused(m), "\"]: set twice"), refused(m))
  m = welcome()
  m.inReplyTo = "<a@x.com>"
  m.headers = { "In-Reply-To": "<b@x.com>" }
  assert(contains(refused(m), "set twice"), refused(m))
}

test "a header with an unusable name or value is refused" {
  let m = welcome()
  m.headers = { "X Bad": "1" }
  assert(contains(refused(m), "ERR mail: headers[\"X Bad\"]: "), refused(m))
  m.headers = { "X-A": "1\r\nBcc: evil@example.net" }
  let r = refused(m)
  assert(contains(r, "ERR mail: headers[\"X-A\"]: the value contains a CR, LF or NUL"), r)
  assert(!contains(r, "\r") && !contains(r, "\n"), "raw break in the error")
  m.headers = { "X\r\nBcc": "1" }
  r = refused(m)
  assert(contains(r, "ERR mail: headers["), r)
  assert(!contains(r, "\r") && !contains(r, "\n"), "raw break in the name error")
}

test "a structural header name is refused" {
  for name of ["From", "to", "Date", "Message-ID", "Content-Type", "Bcc"] {
    let m = welcome()
    m.headers = { name: "x" }
    assert(contains(refused(m), "ERR mail: "), "${name} accepted")
  }
}

test "html alone is a body" {
  let m = welcome()
  m.text = ""
  m.html = "<p>Hello</p>"
  assert(contains(outcome(m, noDefaults()), "text/html"), "html")
}

test "a non-ASCII subject is encoded, not sent raw" {
  let m = welcome()
  m.subject = "Bienvenue à Inkwell"
  let data = outcome(m, noDefaults())
  assert(contains(data, "Subject: =?UTF-8?B?"), data)
  assert(!contains(data, "à"), "raw non-ASCII in the header block")
}
