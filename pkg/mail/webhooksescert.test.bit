import { repeat } from "std/strings"

const scUrl: string = "https://sns.us-east-1.amazonaws.com/certificate.pem"

class ScCall {
  response: HttpResponse,
  raises: bool = false,
  opens: int = 0,
  gets: int = 0,
  closes: int = 0,
  url: string = "",
  timeoutMs: int = 0,
}

fn scResponse(status: int, body: string): HttpResponse {
  return HttpResponse{ status = status, body = body, url = scUrl, redirects = 0 }
}

fn scTransport(call: ScCall): SnsCertTransport {
  call.opens = call.opens + 1
  let get: (string, int) => HttpResponse! = (url, timeoutMs) => {
    call.gets = call.gets + 1
    call.url = url
    call.timeoutMs = timeoutMs
    if (call.raises) {
      fail newError("private transport detail must not escape")
    }
    return call.response
  }
  return SnsCertTransport{
    get = get,
    close = () => {
      call.closes = call.closes + 1
    },
  }
}

fn scVerdict(url: string, call: ScCall): string {
  snsFetchCertificate(url, () => scTransport(call)) catch e {
    match (e) {
      Signature(why) => return why
      _ => return "wrong error type"
    }
  }
  return "ok"
}

fn scClosed(call: ScCall) {
  assert(call.opens == 1 && call.gets == 1 && call.closes == 1, "one owned transport closes once")
}

test "SNS certificate transport forwards an approved URL and finite deadline then closes" {
  let call = ScCall{ response = scResponse(200, "opaque certificate bytes") }
  let body = snsFetchCertificate(scUrl, () => scTransport(call)) catch e {
    panic(e.message())
  }
  assert(body == "opaque certificate bytes")
  assert(call.url == scUrl && call.timeoutMs == 5000, "one finite request to the exact URL")
  scClosed(call)
}

test "SNS certificate transport rejects an invalid URL before allocation" {
  for url of [
    "http://sns.us-east-1.amazonaws.com/cert.pem",
    "https://evil.example.com/cert.pem",
    "https://sns.us-east-1.amazonaws.com:443/cert.pem",
  ] {
    let call = ScCall{ response = scResponse(200, "certificate") }
    assert(scVerdict(url, call) == "SNS certificate URL is not allowed")
    assert(call.opens == 0 && call.gets == 0 && call.closes == 0, "no transport allocated")
  }
}

test "SNS certificate transport refuses every redirect status" {
  for status of [301, 302, 303, 307, 308] {
    let call = ScCall{ response = scResponse(status, "certificate") }
    assert(
      scVerdict(scUrl, call) == "SNS certificate response is not successful",
      "redirect is not a certificate",
    )
    scClosed(call)
  }
}

test "SNS certificate transport refuses redirect history and changed final URL" {
  let redirected = scResponse(200, "certificate")
  redirected.redirects = 1
  let changed = scResponse(200, "certificate")
  changed.url = "https://sns.us-east-1.amazonaws.com/other.pem"
  for response of [redirected, changed] {
    let call = ScCall{ response = response }
    assert(scVerdict(scUrl, call) == "SNS certificate response changed its URL")
    scClosed(call)
  }
}

test "SNS certificate transport accepts only status 200" {
  for status of [201, 204, 400, 404, 500] {
    let call = ScCall{ response = scResponse(status, "certificate") }
    assert(scVerdict(scUrl, call) == "SNS certificate response is not successful")
    scClosed(call)
  }
}

test "SNS certificate transport enforces its response byte boundary" {
  let exact = ScCall{ response = scResponse(200, repeat("A", 65536)) }
  assert(scVerdict(scUrl, exact) == "ok", "inclusive body budget")
  scClosed(exact)
  for body of ["", repeat("A", 65537)] {
    let call = ScCall{ response = scResponse(200, body) }
    assert(scVerdict(scUrl, call) == "SNS certificate response body is outside its limit")
    scClosed(call)
  }
}

test "SNS certificate transport redacts errors and closes its failed request" {
  let call = ScCall{ response = scResponse(200, "certificate"), raises = true }
  assert(scVerdict(scUrl, call) == "SNS certificate request failed", "fixed redacted error")
  scClosed(call)
}

test "SNS certificate adapter can be created and closed without a request" {
  let transport = snsCertificateTransport()
  transport.close()
}
