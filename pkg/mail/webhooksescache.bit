class SnsCertificateEntry {
  url: string,
  certificate: Certificate,
  insertedAt: int,
}

class SnsCertificateCache {
  slots: []Option<SnsCertificateEntry>
  next: int
  mu: Mutex

  init() {
    this.slots = []Option<SnsCertificateEntry>(16)
    this.next = 0
    this.mu = Mutex()
  }

  find(url: string, at: int): Option<Certificate> {
    this.mu.lock()
    defer this.mu.unlock()
    for slot of this.slots {
      if (isSome(slot)) {
        let entry = unwrap(slot)
        if (entry.url == url && at >= entry.insertedAt && at - entry.insertedAt < 3600) {
          return Option.Some(entry.certificate)
        }
      }
    }
    return Option.None
  }

  save(entry: SnsCertificateEntry) {
    this.mu.lock()
    defer this.mu.unlock()
    let i = 0
    while (i < len(this.slots)) {
      let slot = this.slots[i]
      if (isSome(slot) && unwrap(slot).url == entry.url) {
        this.slots[i] = Option.Some(entry)
        return
      }
      i = i + 1
    }
    this.slots[this.next] = Option.Some(entry)
    this.next = (this.next + 1) % 16
  }

  get(url: string, trust: SnsTrust, open: () => SnsCertTransport): Certificate!MailError {
    if (!snsCertificateUrl(url)) {
      fail webhookRejected("SNS certificate URL is not allowed")
    }
    let at = trust.nowUnix
    if (at < 0) {
      fail webhookRejected("SNS certificate cache time is invalid")
    }
    let cached = this.find(url, at)
    if (isSome(cached)) {
      let certificate = unwrap(cached)
      snsSigningKey(certificate, trust)?
      return certificate
    }
    let certificate = snsParseCertificate(snsFetchCertificate(url, open)?)?
    snsSigningKey(certificate, trust)?
    // Use lookup time so a slow fetch cannot extend the one-hour lifetime.
    this.save(SnsCertificateEntry{ url = url, certificate = certificate, insertedAt = at })
    return certificate
  }

  authenticate(
    envelope: SnsEnvelope,
    trust: SnsTrust,
    open: () => SnsCertTransport,
  ): Json!MailError {
    let certificate = this.get(envelope.certificate, trust, open)?
    snsVerifySignature(envelope.canonical, envelope.version, envelope.signature, certificate, trust)?
    return envelope.data
  }
}
