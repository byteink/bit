// pkg/mail/mailgun.bit — the `Transport` `open("mailgun://KEY:domain@default")`
// returns: one `POST https://api.mailgun.net/v3/<domain>/messages.mime` per
// message with HTTP basic auth `api:KEY`
// (https://documentation.mailgun.com/docs/mailgun/api-reference/send/mailgun/messages/post-v3--domain-name--messages-mime).
// The multipart body is made by std/http's `FormBuilder`; the URL and the client
// are shared with the other HTTPS-API transports (httpapi.bit); this file is the
// request and what each answer means.
//
//   mailgun://KEY:domain@default                  api.mailgun.net, the sending domain `domain`
//   mailgun://KEY:domain@eu                       api.eu.mailgun.net, for a domain in Mailgun's EU region
//   mailgun://KEY:domain@host[:port]              https://host[:port], for a proxy or a test
//   mailgun://KEY:domain@host[:port]?insecureSkipVerify=true   ... without checking its certificate
//
// `domain` is the domain the account sends from, a DNS name with at least one
// dot (`mg.inkwell.dev`). The key is never in an error, a `Receipt` or the text
// of the transport.
//
// Mailgun is sent the message as the `Mailer` rendered it: the file part
// `message` is `Delivery.raw`, so `Options.dkim` signs what Mailgun forwards, and
// the recipients are the envelope's `to` fields, which is how a `bcc` address is
// delivered to without being in a header.
//
// `Message.tags` has names and values, Mailgun has `o:tag` (names only, at most
// 3) and `v:` variables (a name and a value, returned in its events and
// webhooks): the tag named `tag` holds the tags, separated by commas, and every
// other entry is a `v:<name>` variable.
//
// What Mailgun answers, and what the caller gets:
//   200                          `Receipt.providerId` is the `id` it returns, without its `<>`
//   401                          `Auth`
//   429                          `Transient`, `Reply.retryAfter` from `Retry-After`
//   5xx                          `Transient`
//   a failed TLS handshake       `Rejected`: the same certificate is presented next time
//   a request that never left     `Transient`: a refused or failed connect
//   a request cut off after it    `Unknown`: a reset or a timeout once it was
//   was written                   written; Mailgun may have taken the mail, so it
//                                 is not repeated
//   400, 404 and any other 4xx   `Rejected` with Mailgun's `message`
//
// Mailgun has no idempotency key, so a send is repeated only when the mail was
// not taken: a refused connection, a 429 or a 5xx. A request cut off after it was
// written may or may not have been taken, and repeating it can send the mail
// twice (RFC 9110 §9.2.2), so it is `Unknown` and `Options.retry` leaves it alone.

import { Body, Client as HttpClient, FormBuilder, FormBody } from "std/http"
import { encodeBase64 } from "std/crypto"
import { trimSpace } from "std/strings"
import { keys } from "std/seq"
import { sorted } from "std/sort"
import { Millisecond } from "std/time"

fn mailgunSpec(): ApiSpec {
  return ApiSpec{
    scheme = "mailgun://",
    defaultHost = "api.mailgun.net",
    regions = { "eu": "api.eu.mailgun.net" },
    secret = "API key",
    placeholder = "KEY",
    second = "domain",
  }
}

// Whether `url` is a `mailgun://` URL, whatever follows.
fn isMailgunUrl(url: string): bool {
  return hasScheme(url, "mailgun://")
}

// `url` as a target whose `second` is the sending domain, or a `Config` that
// never repeats the key.
fn parseMailgun(url: string): ApiTarget!MailError {
  let t = parseApiUrl(mailgunSpec(), url)?
  if (!isDnsName(t.second) || indexOf(t.second, ".") < 0) {
    fail apiUrlError(
      mailgunSpec(),
      "the domain is the sending domain, a DNS name such as mg.inkwell.dev; got ${shown(t.second)}",
    )
  }
  return t
}

class MailgunTransport {
  t: ApiTarget
  timeoutMs: int

  init(t: ApiTarget, opts: Options) {
    this.t = t
    // Rounded up: `Client.request` reads 0 as no deadline, and `Options`
    // guarantees a positive timeout.
    this.timeoutMs = (opts.timeout + Millisecond - 1) / Millisecond
  }

  // Posts `d` as one Mailgun message. See the top of this file for what each
  // answer becomes.
  export deliver(d: Delivery): Receipt!MailError {
    let req = mgRequest(d)?
    let c = apiClient(this.t.insecure)
    defer c.close()
    this.setHeaders(c, req.contentType)?
    let res = c.request("POST", this.endpoint(), Body.Bytes(req.body), this.timeoutMs) catch e {
      fail apiNetError("mailgun: ${this.scrub(e.message())}", e, false)
    }
    return this.answer(res.status, res.headers, res.body, d)?
  }

  // The URL every send is posted to.
  endpoint(): string {
    return "${this.t.base}/v3/${this.t.second}/messages.mime"
  }

  // What leaves is `Delivery.raw`, so a signature over it stays valid.
  export signs(): bool {
    return true
  }

  // `GET /v4/domains/<domain>` with the API key: the sending domain's own
  // record, which exists only in the region the URL names, so a wrong key, a
  // wrong region and a misspelt domain each fail here
  // (https://documentation.mailgun.com/docs/mailgun/api-reference/send/mailgun/domains).
  // Any non-2xx is what `apiReadError` makes of it.
  export check(): ()!MailError {
    let c = apiClient(this.t.insecure)
    defer c.close()
    this.setAuth(c)?
    let res = apiGet(
      c,
      "${this.t.base}/v4/domains/${this.t.second}",
      this.timeoutMs,
      "mailgun",
      this.t.secret,
    )?
    if (apiOk(res.status)) {
      return
    }
    fail apiReadError(res.status, res.headers, this.scrub(apiField(res.body, "message")))
  }

  // Nothing is held between sends.
  export close() {}

  // `mailgun://***:mg.inkwell.dev@api.mailgun.net`, the key hidden.
  export toString(): string {
    return this.t.display
  }

  // The headers every send carries. The key was checked at `open`, so a refusal
  // here is a bug, reported and never with the value.
  setHeaders(c: HttpClient, contentType: string): ()!MailError {
    this.setAuth(c)?
    c.setHeader("Content-Type", contentType) catch _ {
      fail MailError.Config("mailgun://: Content-Type cannot be set")
    }
  }

  // HTTP basic auth `api:KEY` and the JSON answer every call asks for.
  setAuth(c: HttpClient): ()!MailError {
    let login = encodeBase64([]byte("api:${this.t.secret}"))
    c.setHeader("Authorization", "Basic ${login}") catch _ {
      fail MailError.Config("mailgun://: the API key cannot be sent as a header")
    }
    c.setHeader("Accept", "application/json") catch _ {
      fail MailError.Config("mailgun://: Accept cannot be set")
    }
  }

  scrub(s: string): string {
    return apiScrub(s, this.t.secret)
  }

  // The `Receipt` for a 200, else the `MailError` for the answer.
  answer(status: int, headers: string, body: string, d: Delivery): Receipt!MailError {
    if (status == 200) {
      return Receipt{
        id = d.messageId,
        providerId = mgId(apiField(body, "id")),
        accepted = d.envelope.to,
      }
    }
    let text = apiClip(this.scrub(apiField(body, "message")))
    if (text == "") {
      text = "HTTP ${status}"
    }
    fail mailgunError(
      status,
      Reply{ code = status, text = text, retryAfter = apiRetryAfter(headers) },
    )
  }
}

// `id` without the angle brackets Mailgun writes around a Message-ID.
fn mgId(id: string): string {
  if (len(id) >= 2 && id[0] == '<' && id[len(id) - 1] == '>') {
    return id[1:len(id) - 1]
  }
  return id
}

// The `MailError` for an answer that is not a 200; the table is at the top of
// this file.
fn mailgunError(status: int, r: Reply): MailError {
  if (status == 401) {
    return MailError.Auth(r)
  }
  if (status == 429 || status >= 500) {
    return MailError.Transient(r)
  }
  return MailError.Rejected(r)
}

// The `Message.tags` name that becomes Mailgun's `o:tag` fields.
const mgTagKey: string = "tag"

// A request carries at most this many recipients, `to` fields counted one each.
const mgMaxRecipients: int = 1000

// A message carries at most this many tags, each of 1 to 128 ASCII characters.
const mgMaxTags: int = 3

const mgMaxTag: int = 128

// A `v:` name is 1 to this many of `A-Za-z0-9_.-`.
const mgMaxName: int = 64

// Mailgun reads the `o:`, `h:` and `v:` fields of a request up to this many
// bytes of names and values together.
const mgMaxOptions: int = 16384

// Whether `s` is 1 to `mgMaxTag` printable ASCII bytes.
fn mgTagOk(s: string): bool {
  if (len(s) < 1 || len(s) > mgMaxTag) {
    return false
  }
  for c of []byte(s) {
    if (c < 32 || c >= 127) {
      return false
    }
  }
  return true
}

// The tags in `Message.tags["tag"]`, split on commas. A tag Mailgun would
// refuse, a fourth one or a repeat is refused here, before the request.
fn mgTags(m: Message): []string!MailError {
  let text = m.tags[mgTagKey]
  let out: []string = []
  if (text == "") {
    return out
  }
  for part of split(text, ",") {
    let tag = trimSpace(part)
    if (!mgTagOk(tag)) {
      fail MailError.Invalid("tags[\"tag\"]: Mailgun takes tags of 1 to ${mgMaxTag} printable ASCII characters separated by commas; got ${echoInput(tag)}")
    }
    for seen of out {
      if (toLower(seen) == toLower(tag)) {
        fail MailError.Invalid("tags[\"tag\"]: Mailgun tags are case-insensitive and ${echoInput(tag)} is given twice")
      }
    }
    out = append(out, tag)
  }
  if (len(out) > mgMaxTags) {
    fail MailError.Invalid("${len(out)} tags in tags[\"tag\"]; Mailgun takes at most ${mgMaxTags} per message")
  }
  return out
}

// Whether `s` is a name of 1 to `mgMaxName` bytes of `[A-Za-z0-9_.-]`.
fn mgNameOk(s: string): bool {
  if (len(s) < 1 || len(s) > mgMaxName) {
    return false
  }
  for c of []byte(s) {
    if (!isAlnum(c) && c != 95 && c != 46 && c != 45) {
      return false
    }
  }
  return true
}

// Adds the `o:tag` and `v:<name>` fields of `m` to `b`, tags first, variables
// sorted by name. The total of their names and values is held under what
// Mailgun reads.
fn mgOptions(b: FormBuilder, m: Message): ()!MailError {
  let size = 0
  for tag of mgTags(m)? {
    mgField(b, "o:tag", tag)?
    size = size + len("o:tag") + len(tag)
  }
  for name of sorted(keys(m.tags), (x, y) => x < y) {
    if (name == mgTagKey) {
      continue
    }
    if (!mgNameOk(name)) {
      fail MailError.Invalid("tags[${echoInput(name)}]: Mailgun takes a variable name of 1 to ${mgMaxName} letters, digits, '_', '.' and '-'")
    }
    mgField(b, "v:${name}", m.tags[name])?
    size = size + len(name) + 2 + len(m.tags[name])
  }
  if (size > mgMaxOptions) {
    fail MailError.Invalid("tags hold ${size} bytes of options; Mailgun reads at most ${mgMaxOptions} bytes of o: and v: fields")
  }
}

// Adds the field `name` to `b`; the names here are fixed or checked, so a
// refusal is the builder's own and is reported as it is.
fn mgField(b: FormBuilder, name: string, value: string): ()!MailError {
  b.field(name, value) catch e {
    fail MailError.Invalid("mailgun: ${e.message()}")
  }
}

// The request for `d`, or an `Invalid` for what Mailgun would refuse: one `to`
// field for every recipient of the envelope, `bcc` included, the options, then
// `Delivery.raw` as the file part `message`.
fn mgRequest(d: Delivery): FormBody!MailError {
  apiCheckRecipients(d, "Mailgun", mgMaxRecipients)?
  let b = FormBuilder()
  for a of d.envelope.to {
    mgField(b, "to", a)?
  }
  mgOptions(b, d.message)?
  b.file("message", "message.mime", "application/octet-stream", []byte(d.raw)) catch e {
    fail MailError.Invalid("mailgun: ${e.message()}")
  }
  return b.build() catch e {
    fail MailError.Invalid("mailgun: ${e.message()}")
  }
}
