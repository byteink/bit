// pkg/mail/smoke.live.test.bit — the acceptance that needs a real SMTP server
// (#6929, epic #6855). Every test is SKIPPED WHEN ITS URL IS UNSET and says so,
// because this file also runs under `bit test pkg/mail` on a machine with no
// Docker; `./make test-package-mail-live` (_tests_/bit/maillive.bit) provisions
// three Mailpit containers and sets the variables, and fails if any test here
// skipped.
//
// What the live server proves that no in-test fake can: smtp.test.bit covers
// every way a STARTTLS upgrade is refused, but std/tls has no server-side
// upgrade of an accepted connection, so the upgrade that SUCCEEDS is only
// reachable here. Each of the six tests sends one message with a unique
// subject and finds it again through Mailpit's own API, so a send that the
// client believes succeeded but the server never stored fails.
//
// Variables (all set by the harness):
//   MAIL_TEST_PLAIN_URL     smtp://127.0.0.1:PORT?tls=off
//   MAIL_TEST_STARTTLS_URL  smtp://bit:live@127.0.0.1:PORT?serverName=localhost
//   MAIL_TEST_TLS_URL       smtps://bit:live@127.0.0.1:PORT?serverName=localhost
//   MAIL_TEST_CA            PEM file of the CA that signed the two TLS servers
//   MAIL_TEST_API_PLAIN / _STARTTLS / _TLS   http base URL of each Mailpit API

import { env, envOr } from "std/os"
import { readFile } from "std/fs"
import { sleep, Millisecond } from "std/time"
import { TrustStore as MlTrustStore, fromPem as mlFromPem } from "std/crypto"
import { get as mlGet } from "std/http"
import {
  Auth as MlAuth, Envelope as MlEnvelope, Options as MlSmtpOptions, Raw as MlRaw,
  dial as mlDial, dialTls as mlDialTls,
} from "std/smtp"

const mlFindAttempts: int = 50
const mlFindDelayMs: int = 100
const mlFrom: string = "sender@live.test"
const mlTo: string = "rcpt@live.test"
const mlUser: string = "bit"
const mlPass: string = "live"

// The value of `name`, or "": printed once so a skipped run is visible as a
// skip rather than a silent pass. The harness fails on any such line.
fn mlVar(name: string): string {
  let v = env(name)
  if (v == "") {
    print("  skipped: ${name} is unset, no live server to talk to\n")
  }
  return v
}

fn mlSubject(kind: string): string {
  return "bit-live-${kind}-${timeUnixNs()}"
}

// True when the Mailpit API at `base` lists a message with `subject`. Polls,
// because a server may take a moment to index what it just accepted.
fn mlFound(base: string, subject: string): bool {
  let i = 0
  while (i < mlFindAttempts) {
    let r = mlGet("${base}/api/v1/messages") catch _ {
      sleep(mlFindDelayMs * Millisecond)
      i = i + 1
      continue
    }
    if (r.status == 200 && contains(r.body, subject)) {
      return true
    }
    sleep(mlFindDelayMs * Millisecond)
    i = i + 1
  }
  return false
}

fn mlRaw(subject: string): MlRaw {
  let ev = MlEnvelope{ from = mlFrom, to = [mlTo] }
  let data = "From: ${mlFrom}\r\nTo: ${mlTo}\r\nSubject: ${subject}\r\n\r\nlive body\r\n"
  return MlRaw(ev, data)
}

fn mlRoots(): MlTrustStore {
  let pem = readFile(envOr("MAIL_TEST_CA", "")) catch e {
    panic("MAIL_TEST_CA: ${e.message()}")
  }
  return mlFromPem(pem) catch e {
    panic("MAIL_TEST_CA: ${e.message()}")
  }
}

// `host:port` of an `smtp://` / `smtps://` URL's authority, userinfo and query
// stripped: std/smtp takes them as two arguments.
fn mlHostPort(url: string): string {
  let rest = url[indexOf(url, "://") + 3:]
  let at = indexOf(rest, "@")
  if (at >= 0) {
    rest = rest[at + 1:]
  }
  let q = indexOf(rest, "?")
  if (q >= 0) {
    rest = rest[0:q]
  }
  return rest
}

fn mlHost(url: string): string {
  let hp = mlHostPort(url)
  return hp[0:lastIndexOf(hp, ":")]
}

fn mlPort(url: string): int {
  let hp = mlHostPort(url)
  return parseInt(hp[lastIndexOf(hp, ":") + 1:]) catch e {
    panic("port of ${url}: ${e.message()}")
  }
}

test "live: std/smtp sends in plaintext to a server that offers no TLS" {
  let url = mlVar("MAIL_TEST_PLAIN_URL")
  let api = mlVar("MAIL_TEST_API_PLAIN")
  if (url == "" || api == "") {
    return
  }
  let subject = mlSubject("plain")
  let c = mlDial(mlHost(url), mlPort(url)) catch e {
    panic("dial: ${e.message()}")
  }
  defer c.close()
  c.ehlo("live.test") catch e {
    panic("ehlo: ${e.message()}")
  }
  c.send(mlRaw(subject)) catch e {
    panic("send: ${e.message()}")
  }
  c.quit() catch _ {}
  assert(mlFound(api, subject), "Mailpit never listed '${subject}'")
}

test "live: std/smtp upgrades with STARTTLS, authenticates and sends" {
  let url = mlVar("MAIL_TEST_STARTTLS_URL")
  let api = mlVar("MAIL_TEST_API_STARTTLS")
  if (url == "" || api == "") {
    return
  }
  let subject = mlSubject("starttls")
  let tls = MlSmtpOptions(serverName = "localhost", roots = mlRoots())
  let c = mlDial(mlHost(url), mlPort(url), tls) catch e {
    panic("dial: ${e.message()}")
  }
  defer c.close()
  c.ehlo("live.test") catch e {
    panic("ehlo: ${e.message()}")
  }
  c.startTls(tls) catch e {
    panic("startTls: ${e.message()}")
  }
  c.ehlo("live.test") catch e {
    panic("ehlo after STARTTLS: ${e.message()}")
  }
  c.auth(MlAuth.Plain(mlUser, mlPass)) catch e {
    panic("auth: ${e.message()}")
  }
  c.send(mlRaw(subject)) catch e {
    panic("send: ${e.message()}")
  }
  c.quit() catch _ {}
  assert(mlFound(api, subject), "Mailpit never listed '${subject}'")
}

test "live: std/smtp sends over implicit TLS" {
  let url = mlVar("MAIL_TEST_TLS_URL")
  let api = mlVar("MAIL_TEST_API_TLS")
  if (url == "" || api == "") {
    return
  }
  let subject = mlSubject("tls")
  let tls = MlSmtpOptions(serverName = "localhost", roots = mlRoots())
  let c = mlDialTls(mlHost(url), mlPort(url), tls) catch e {
    panic("dialTls: ${e.message()}")
  }
  defer c.close()
  c.ehlo("live.test") catch e {
    panic("ehlo: ${e.message()}")
  }
  c.auth(MlAuth.Plain(mlUser, mlPass)) catch e {
    panic("auth: ${e.message()}")
  }
  c.send(mlRaw(subject)) catch e {
    panic("send: ${e.message()}")
  }
  c.quit() catch _ {}
  assert(mlFound(api, subject), "Mailpit never listed '${subject}'")
}

// Sends one message through `mailer` and finds it at `api`.
fn mlSendThrough(mailer: Mailer, api: string, kind: string) {
  let subject = mlSubject(kind)
  let m = Message{ to = [mlTo], subject = subject, text = "live body\n" }
  let r = mailer.send(m) catch e {
    panic("send through ${kind}: ${e.message()}")
  }
  assert(len(r.accepted) == 1, "accepted ${len(r.accepted)} recipients")
  assert(mlFound(api, subject), "Mailpit never listed '${subject}' sent through ${kind}")
}

fn mlOpen(url: string): Mailer {
  let full = "${url}&caFile=${envOr("MAIL_TEST_CA", "")}"
  return open(full, Options{ from = mlFrom }) catch e {
    panic("open: ${e.message()}")
  }
}

test "live: open() on smtp:// completes the STARTTLS upgrade and sends" {
  let url = mlVar("MAIL_TEST_STARTTLS_URL")
  let api = mlVar("MAIL_TEST_API_STARTTLS")
  if (url == "" || api == "") {
    return
  }
  mlSendThrough(mlOpen(url), api, "open-starttls")
}

test "live: open() on smtps:// sends over implicit TLS" {
  let url = mlVar("MAIL_TEST_TLS_URL")
  let api = mlVar("MAIL_TEST_API_TLS")
  if (url == "" || api == "") {
    return
  }
  mlSendThrough(mlOpen(url), api, "open-tls")
}

test "live: open() on smtp://?tls=off sends in plaintext" {
  let url = mlVar("MAIL_TEST_PLAIN_URL")
  let api = mlVar("MAIL_TEST_API_PLAIN")
  if (url == "" || api == "") {
    return
  }
  let mailer = open(url, Options{ from = mlFrom }) catch e {
    panic("open: ${e.message()}")
  }
  mlSendThrough(mailer, api, "open-plain")
}
