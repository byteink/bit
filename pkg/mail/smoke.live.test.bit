// #6931: the gate supplies three isolated, stock Mailpit servers.

test "live: open sends over plaintext, STARTTLS and implicit TLS" {
  for kind of ["PLAIN", "STARTTLS", "TLS"] {
    let s = mlScope(kind)
    if (s.url == "") {
      return
    }
    defer s.clean()
    let m = mlOpen(s.url, mlOptions())
    defer m.close()
    let msg = s.message("schemes-${kind}")
    mlSend(m, msg)
    let got = s.received(msg.subject)
    assert(mlString(got, "Subject") == msg.subject, "subject changed over ${kind}")
  }
}

test "live: fifty sends through pool two all arrive" {
  let s = mlScope("STARTTLS")
  if (s.url == "") {
    return
  }
  defer s.clean()
  let o = mlOptions()
  o.pool = 2
  let m = mlOpen(s.url, o)
  defer m.close()
  let subjects: []string = []
  let i = 0
  while (i < 50) {
    let msg = s.message("pool-${i}")
    subjects = append(subjects, msg.subject)
    mlSend(m, msg)
    i = i + 1
  }
  for subject of subjects {
    let got = s.received(subject)
    assert(mlString(got, "Subject") == subject, "pool lost ${subject}")
  }
}
