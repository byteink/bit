// pkg/mail/encword.bit — RFC 2047 encoded words in a display name:
// `=?UTF-8?B?U2FyYQ==?=` and `=?ISO-8859-1?Q?Andr=E9?=` decode to UTF-8 text.
//
// A word is recognised only as a whole whitespace-delimited token of the exact
// shape `=?charset?B-or-Q?text?=`; anything else stays literal text, as RFC
// 2047 §6.3 asks. A token that has the shape and then fails to decode is
// REFUSED rather than passed through: a name that half-decodes would show one
// thing here and another in the recipient's client.
//
// Charsets: UTF-8, US-ASCII, ISO-8859-1 and Windows-1252, which between them
// cover what real mail clients write. Any other charset is refused by name.

import { decodeBase64 } from "std/crypto"
import { count, hasPrefix, hasSuffix, indexOf, split, toLower } from "std/strings"

// Whether `tok` has the shape of one encoded word: `=?` x `?` y `?` z `?=`.
fn looksEncoded(tok: string): bool {
  if (len(tok) < 5 || !hasPrefix(tok, "=?") || !hasSuffix(tok, "?=")) {
    return false
  }
  return count(tok[2:len(tok) - 2], "?") == 2
}

fn hexVal(c: u8): int {
  if (c >= u8(48) && c <= u8(57)) {
    return int(c) - 48
  }
  if (c >= u8(65) && c <= u8(70)) {
    return int(c) - 55
  }
  if (c >= u8(97) && c <= u8(102)) {
    return int(c) - 87
  }
  return -1
}

// RFC 2047 §4.2 "Q": `_` is a space, `=XX` a byte, anything else itself.
fn decodeQ(p: string): []byte!MailError {
  let out: []byte = []
  let i = 0
  while (i < len(p)) {
    if (p[i] == u8(95)) {
      out = append(out, space)
    } else if (p[i] == u8(61)) {
      let hi = qDigit(p, i + 1)
      let lo = qDigit(p, i + 2)
      if (hi < 0 || lo < 0) {
        fail MailError.Invalid("an encoded word has a bad =XX escape")
      }
      out = append(out, u8(hi * 16 + lo))
      i = i + 2
    } else {
      out = append(out, p[i])
    }
    i = i + 1
  }
  return out
}

// The hex value of `p[at]`, or -1 past the end or off the alphabet.
fn qDigit(p: string, at: int): int {
  if (at >= len(p)) {
    return -1
  }
  return hexVal(p[at])
}

// RFC 2047 §4.1 "B": base64, with the `=` padding put back when a producer
// left it off.
fn decodeB(p: string): []byte!MailError {
  let padded = p
  if (len(p) % 4 == 2) {
    padded = p + "=="
  } else if (len(p) % 4 == 3) {
    padded = p + "="
  }
  return decodeBase64(padded) catch _ {
    fail MailError.Invalid("an encoded word is not valid base64")
  }
}

// One Unicode code point as UTF-8 onto `out` (code points up to U+FFFF).
fn writeCodePoint(out: Builder, cp: int) {
  if (cp < 0x80) {
    out.writeByte(u8(cp))
  } else if (cp < 0x800) {
    out.writeByte(u8(0xc0 | (cp >> 6)))
    out.writeByte(u8(0x80 | (cp & 0x3f)))
  } else {
    out.writeByte(u8(0xe0 | (cp >> 12)))
    out.writeByte(u8(0x80 | ((cp >> 6) & 0x3f)))
    out.writeByte(u8(0x80 | (cp & 0x3f)))
  }
}

// Windows-1252 code points for bytes 0x80..0x9F; 0 marks the five bytes the
// code page leaves undefined.
fn cp1252High(): []int {
  return [
    0x20ac, 0, 0x201a, 0x0192, 0x201e, 0x2026, 0x2020, 0x2021,
    0x02c6, 0x2030, 0x0160, 0x2039, 0x0152, 0, 0x017d, 0,
    0, 0x2018, 0x2019, 0x201c, 0x201d, 0x2022, 0x2013, 0x2014,
    0x02dc, 0x2122, 0x0161, 0x203a, 0x0153, 0, 0x017e, 0x0178,
  ]
}

// Bytes in ISO-8859-1 (every byte is its own code point) or Windows-1252 as UTF-8.
fn fromSingleByte(raw: []byte, win1252: bool): string!MailError {
  let table = cp1252High()
  let out = Builder()
  for b of raw {
    let cp = int(b)
    if (win1252 && cp >= 0x80 && cp <= 0x9f) {
      cp = table[cp - 0x80]
      if (cp == 0) {
        fail MailError.Invalid("an encoded word has a byte undefined in Windows-1252")
      }
    }
    writeCodePoint(out, cp)
  }
  return out.toString()
}

fn fromAscii(raw: []byte): string!MailError {
  for b of raw {
    if (b >= u8(128)) {
      fail MailError.Invalid("an encoded word labelled US-ASCII holds a non-ASCII byte")
    }
  }
  return string(raw)
}

// `raw` in the named charset (already lowercased, language tag removed) as UTF-8.
fn toUtf8(charset: string, raw: []byte): string!MailError {
  switch (charset) {
    case "utf-8", "utf8":
      return string(raw)
    case "us-ascii", "ascii":
      return fromAscii(raw)?
    case "iso-8859-1", "latin1":
      return fromSingleByte(raw, false)?
    case "windows-1252", "cp1252":
      return fromSingleByte(raw, true)?
    default:
      fail MailError.Invalid("an encoded word uses the unsupported charset '${charset}'")
  }
}

// The text of one encoded word token (`looksEncoded` is true for it).
fn decodeWord(tok: string): string!MailError {
  let parts = split(tok[2:len(tok) - 2], "?")
  let charset = toLower(parts[0])
  let star = indexOf(charset, "*")
  if (star >= 0) {
    charset = charset[:star]
  }
  let kind = toLower(parts[1])
  if (kind == "b") {
    return toUtf8(charset, decodeB(parts[2])?)?
  }
  if (kind == "q") {
    return toUtf8(charset, decodeQ(parts[2])?)?
  }
  fail MailError.Invalid("an encoded word has the encoding '${parts[1]}', not B or Q")
}

// `text` with every encoded word decoded. Whitespace between two encoded words
// is dropped (RFC 2047 §6.2), so a long name split across words rejoins; every
// other run of whitespace is kept as written.
fn decodeWords(text: string): string!MailError {
  if (indexOf(text, "=?") < 0) {
    return text
  }
  let out = Builder()
  let i = 0
  let prevWord = false
  while (i < len(text)) {
    let sepEnd = skipWs(text, i)
    let tokEnd = skipToken(text, sepEnd)
    let tok = text[sepEnd:tokEnd]
    let word = looksEncoded(tok)
    if (!(word && prevWord)) {
      out.write(text[i:sepEnd])
    }
    if (word) {
      out.write(decodeWord(tok)?)
    } else {
      out.write(tok)
    }
    prevWord = word
    i = tokEnd
  }
  return out.toString()
}

fn skipWs(s: string, from: int): int {
  let i = from
  while (i < len(s) && isWs(s[i])) {
    i = i + 1
  }
  return i
}

fn skipToken(s: string, from: int): int {
  let i = from
  while (i < len(s) && !isWs(s[i])) {
    i = i + 1
  }
  return i
}
