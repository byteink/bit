// pkg/mail/unsubscribe.bit — `Unsubscribe`, how a recipient leaves a mailing
// list in one click (RFC 8058) or by mail (RFC 2369), and the two header
// fields that carry it.
//
// RFC 8058 §3.1 wants ONE `List-Unsubscribe` field holding at least one https
// URI and MAY hold others such as `mailto:`, plus `List-Unsubscribe-Post:
// List-Unsubscribe=One-Click`, both covered by the DKIM signature. A `mailto:`
// alone is a valid RFC 2369 field and carries no Post field, because without
// an https URI there is nothing for a mail client to POST to.
//
// The URI checks run when the message is rendered (render.bit), like every
// other check in this package, so the failure names the field: `unsubscribe.url`
// or `unsubscribe.mailto`.

import { hasPrefix, indexOf, join, toLower } from "std/strings"

// The header fields this file writes. Both are signed by default (dkim.bit),
// and `Message.headers` may set neither.
const listUnsubscribeName: string = "List-Unsubscribe"
const listUnsubscribePostName: string = "List-Unsubscribe-Post"

// The value RFC 8058 §3.1 fixes for `List-Unsubscribe-Post`.
const oneClickValue: string = "List-Unsubscribe=One-Click"

// The longest URI accepted, in bytes. Mailbox providers read the header from a
// bounded window of the message, and a longer address is a bug upstream.
const maxUnsubscribeUri: int = 2000

// The ways to leave the list a message came from. Set `url` for one-click
// unsubscribe, `mailto` as a fallback for a mail client, or both; both empty
// means the message carries no unsubscribe header.
//
//   Unsubscribe{ url = "https://inkwell.dev/u/7f3a9c", mailto = "unsubscribe@inkwell.dev" }
export class Unsubscribe {
  // An https URL a mailbox provider POSTs to (RFC 8058). It must identify the
  // recipient and the list on its own, so give it an unguessable token. It must
  // not redirect. Gmail and Yahoo require one on bulk mail.
  export url: string = "",
  // An address or `mailto:` URI, `unsubscribe@inkwell.dev` or
  // `mailto:unsubscribe@inkwell.dev?subject=stop`. It is written as a mailto
  // URI beside the URL, or alone when `url` is empty; alone it does not satisfy
  // the one-click rule.
  export mailto: string = "",
}

// Whether `u` sets neither way out.
fn unsubscribeEmpty(u: Unsubscribe): bool {
  return u.url == "" && u.mailto == ""
}

// Why `uri` cannot sit between `<` and `>` in a header field, or "".
fn uriFault(uri: string): string {
  if (len(uri) > maxUnsubscribeUri) {
    return "it is ${len(uri)} bytes and the longest is ${maxUnsubscribeUri}"
  }
  let i = 0
  while (i < len(uri)) {
    if (uri[i] <= space || uri[i] >= u8(127) || uri[i] == u8(60) || uri[i] == u8(62)) {
      return "it must be printable ASCII with no space, '<' or '>'; percent-encode the rest"
    }
    i = i + 1
  }
  return ""
}

// The checked `url`, or its refusal.
fn checkUnsubscribeUrl(url: string): ()!MailError {
  let lower = toLower(url)
  if (hasPrefix(lower, "http://")) {
    fail fieldError("unsubscribe.url", "must be https for one-click (RFC 8058)")
  }
  if (!hasPrefix(lower, "https://") || len(url) == len("https://")) {
    fail fieldError("unsubscribe.url", "${echoInput(url)} is not an https URL")
  }
  let why = uriFault(url)
  if (why != "") {
    fail fieldError("unsubscribe.url", why)
  }
}

// `mailto` as a `mailto:` URI, or its refusal. A bare address gets the scheme.
fn mailtoUri(mailto: string): string!MailError {
  let uri = mailto
  if (!hasPrefix(toLower(mailto), "mailto:")) {
    uri = "mailto:" + mailto
  }
  let why = uriFault(uri)
  if (why != "") {
    fail fieldError("unsubscribe.mailto", why)
  }
  let rest = uri[len("mailto:"):]
  let q = indexOf(rest, "?")
  if (q >= 0) {
    rest = rest[0:q]
  }
  parseAddress(rest) catch e {
    match (e) {
      Invalid(w) => fail fieldError("unsubscribe.mailto", w)
      _ => fail e
    }
  }
  return uri
}

// The `List-Unsubscribe` and `List-Unsubscribe-Post` fields for `u`: none when
// it is empty, only the first for a `mailto` alone.
fn unsubscribeFields(u: Unsubscribe): []Field!MailError {
  let out: []Field = []
  if (unsubscribeEmpty(u)) {
    return out
  }
  let uris: []string = []
  if (u.url != "") {
    checkUnsubscribeUrl(u.url)?
    uris = append(uris, "<${u.url}>")
  }
  if (u.mailto != "") {
    uris = append(uris, "<${mailtoUri(u.mailto)?}>")
  }
  out = append(out, Field{ name = listUnsubscribeName, value = join(uris, ", ") })
  if (u.url != "") {
    out = append(out, Field{ name = listUnsubscribePostName, value = oneClickValue })
  }
  return out
}

// Whether `lower` (a lower-case header name) is one `Message.unsubscribe` owns.
fn isUnsubscribeName(lower: string): bool {
  return lower == "list-unsubscribe" || lower == "list-unsubscribe-post"
}
