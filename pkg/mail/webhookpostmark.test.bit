// Official Postmark webhook shapes; request helpers are shared with the
// Resend sibling tests. Credentials and ids here are local fixtures.

const pwhSecret: string = "inkwell:webhook-local-password"
const pwhTime: string = "2026-11-05T16:33:54.9070259Z"
const pwhId: string = "883953f4-6105-42a2-a16a-77a8eac79483"
const pwhBounce: string = "{\"RecordType\":\"Bounce\",\"MessageStream\":\"outbound\",\"ID\":692560173,\"Type\":\"HardBounce\",\"TypeCode\":1,\"Name\":\"Hard bounce\",\"Tag\":\"Test\",\"MessageID\":\"883953f4-6105-42a2-a16a-77a8eac79483\",\"Metadata\":{\"PropA\":\"some value\",\"PropB\":\"some value\"},\"ServerID\":23,\"Description\":\"mailbox not found\",\"Details\":\"Test bounce details\",\"Email\":\"sara@example.com\",\"From\":\"hello@inkwell.dev\",\"BouncedAt\":\"2026-11-05T16:33:54.9070259Z\",\"DumpAvailable\":true,\"Inactive\":true,\"CanActivate\":true,\"Subject\":\"Welcome\",\"Content\":\"bounce dump\"}"
const pwhComplaint: string = "{\"RecordType\":\"SpamComplaint\",\"MessageStream\":\"outbound\",\"ID\":692560174,\"Type\":\"SpamComplaint\",\"TypeCode\":100001,\"Name\":\"Spam complaint\",\"Tag\":\"welcome-email\",\"MessageID\":\"883953f4-6105-42a2-a16a-77a8eac79483\",\"Metadata\":{\"PropA\":\"some value\"},\"ServerID\":23,\"Description\":\"reported as spam\",\"Details\":\"Test complaint details\",\"Email\":\"sara@example.com\",\"From\":\"hello@inkwell.dev\",\"BouncedAt\":\"2026-11-05T16:33:54.9070259Z\",\"DumpAvailable\":true,\"Inactive\":true,\"CanActivate\":false,\"Subject\":\"Welcome\",\"Content\":\"abuse report\"}"
const pwhDelivery: string = "{\"RecordType\":\"Delivery\",\"ServerID\":23,\"MessageStream\":\"outbound\",\"MessageID\":\"883953f4-6105-42a2-a16a-77a8eac79483\",\"Recipient\":\"sara@example.com\",\"Tag\":\"welcome-email\",\"DeliveredAt\":\"2026-11-05T16:33:54.9070259Z\",\"Details\":\"smtp;250 accepted\",\"Metadata\":{\"PropA\":\"some value\"}}"
const pwhSubscription: string = "{\"RecordType\":\"SubscriptionChange\",\"MessageID\":\"883953f4-6105-42a2-a16a-77a8eac79483\",\"ServerID\":23,\"MessageStream\":\"outbound\",\"ChangedAt\":\"2026-11-05T16:33:54.9070259Z\",\"Recipient\":\"sara@example.com\",\"Origin\":\"Recipient\",\"SuppressSending\":true,\"SuppressionReason\":\"HardBounce\",\"Tag\":\"welcome-email\",\"Metadata\":{\"PropA\":\"some value\"}}"

fn pwhHeaders(auth: string): (string) => string {
  return whHeader(
    WhReq{
      names = ["authorization", "x-pm-webhook-trace-id"],
      values = [auth, "postmark-delivery-7"],
    },
  )
}

fn pwhAuth(secret: string): string {
  return "Basic " + encodeBase64([]byte(secret))
}

fn pwhEvents(body: string): []Event {
  return webhookEvents(
    Provider.Postmark,
    pwhHeaders(pwhAuth(pwhSecret)),
    body,
    pwhSecret,
    whAt(1700000000),
  ) catch e {
    panic("pwhEvents: ${e.message()}")
  }
}

fn pwhVerdict(auth: string, body: string, secret: string): string {
  webhookEvents(Provider.Postmark, pwhHeaders(auth), body, secret, whAt(1700000000)) catch e {
    match (e) {
      Auth(r) => {
        assert(r.code == 401, "webhook credential refusal is HTTP 401")
        return "Auth: ${r.text}"
      }
      Invalid(why) => return "Invalid: ${why}"
      _ => return "other: ${e.message()}"
    }
  }
  return "ok"
}

fn pwhOne(body: string, kind: EventKind, reason: string): Event {
  let events = pwhEvents(body)
  assert(len(events) == 1, "${len(events)} events")
  let e = events[0]
  assert(e.kind == kind && e.provider == Provider.Postmark, "kind and provider")
  assert(e.recipient == "sara@example.com", e.recipient)
  assert(e.providerId == pwhId && e.deliveryId == "postmark-delivery-7", "ids")
  assert(e.messageId == "", e.messageId)
  assert(e.reason == reason, e.reason)
  let expected = parseRfc3339(pwhTime) catch err {
    panic(err.message())
  }
  assert(e.at.ns == expected.ns, e.at.toString())
  return e
}

test "Postmark documented bounce complaint delivery and subscription payloads" {
  assert(pwhOne(pwhBounce, EventKind.Bounced, "mailbox not found").permanent, "hard bounce")
  assert(!pwhOne(pwhComplaint, EventKind.Complained, "reported as spam").permanent, "complaint")
  assert(!pwhOne(pwhDelivery, EventKind.Delivered, "smtp;250 accepted").permanent, "delivery")
  assert(!pwhOne(pwhSubscription, EventKind.Unsubscribed, "HardBounce").permanent, "suppression")
}

test "Postmark open and click use ReceivedAt and a single recipient" {
  for t of ["Open", "Click"] {
    let kind = EventKind.Opened
    if (t == "Click") {
      kind = EventKind.Clicked
    }
    let body = "{\"RecordType\":\"${t}\",\"MessageID\":\"${pwhId}\",\"ReceivedAt\":\"${pwhTime}\",\"Recipient\":\"sara@example.com\"}"
    assert(!pwhOne(body, kind, "").permanent, t)
  }
}

test "Postmark suppression reactivation accepts null optional fields" {
  let body = "{\"RecordType\":\"SubscriptionChange\",\"MessageID\":null,\"Metadata\":null,\"SuppressionReason\":null,\"Tag\":null,\"Recipient\":\"sara@example.com\",\"SuppressSending\":false}"
  let e = pwhEvents(body)[0]
  assert(e.kind == EventKind.Subscribe, "reactivated")
  assert(e.providerId == "" && e.messageId == "" && e.reason == "", "null fields")
  assert(!e.permanent && e.at.ns == whAt(1700000000).ns, "fallback")
  let suppressed = pwhEvents(replace(body, "false", "true"))[0]
  assert(
    suppressed.kind == EventKind.Unsubscribed && suppressed.providerId == "",
    "manual suppression",
  )
}

test "Postmark all 22 documented bounce types follow the package suppression policy" {
  let permanent = [
    "HardBounce",
    "Unsubscribe",
    "AddressChange",
    "SpamNotification",
    "Unknown",
    "BadEmailAddress",
    "SpamComplaint",
    "ManuallyDeactivated",
    "Unconfirmed",
  ]
  let temporary = [
    "Transient",
    "Subscribe",
    "AutoResponder",
    "DnsError",
    "OpenRelayTest",
    "SoftBounce",
    "VirusNotification",
    "ChallengeVerification",
    "Blocked",
    "SMTPApiError",
    "InboundError",
    "DMARCPolicy",
    "TemplateRenderingFailed",
  ]
  assert(len(permanent) + len(temporary) == 22, "complete table")
  for t of permanent {
    assert(pwhEvents(replace(pwhBounce, "HardBounce", t))[0].permanent, t)
  }
  for t of temporary {
    assert(!pwhEvents(replace(pwhBounce, "HardBounce", t))[0].permanent, t)
  }
  for t of ["", "FutureBounceType"] {
    assert(pwhEvents(replace(pwhBounce, "HardBounce", t))[0].permanent, "unknown ${t}")
  }
}

test "Postmark original message id comes from metadata then mail headers" {
  let meta = replace(
    pwhDelivery,
    "\"PropA\":\"some value\"",
    "\"message_id\":\"<welcome-7@inkwell.dev>\"",
  )
  assert(pwhEvents(meta)[0].messageId == "<welcome-7@inkwell.dev>", "metadata")
  let headers = ",\"Headers\":[{\"Name\":\"mEsSaGe-Id\",\"Value\":\"<header@inkwell.dev>\"}]"
  let body = pwhDelivery[:len(pwhDelivery) - 1] + headers + "}"
  assert(pwhEvents(body)[0].messageId == "<header@inkwell.dev>", "headers")
  let both = meta[:len(meta) - 1] + headers + "}"
  assert(pwhEvents(both)[0].messageId == "<welcome-7@inkwell.dev>", "metadata wins")
  let nullMeta = replace(body, "{\"PropA\":\"some value\"}", "null")
  assert(pwhEvents(nullMeta)[0].messageId == "<header@inkwell.dev>", "null metadata")
}

test "Postmark recipient and clock fallback and absent delivery identity" {
  let email = replace(pwhDelivery, "Recipient", "Email")
  assert(pwhEvents(email)[0].recipient == "sara@example.com", "Email fallback")
  let badTime = replace(pwhDelivery, pwhTime, "bad timestamp")
  assert(pwhEvents(badTime)[0].at.ns == whAt(1700000000).ns, "clock fallback")
  let h = whHeader(WhReq{ names = ["authorization"], values = [pwhAuth(pwhSecret)] })
  let events = parseEvents(Provider.Postmark, h, pwhDelivery, pwhSecret) catch e {
    panic(e.message())
  }
  assert(events[0].deliveryId == "", "absent trace id")
}

test "Postmark rejects absent wrong and malformed credentials before parsing JSON" {
  for auth of [
    "",
    pwhAuth("inkwell:wrong-password"),
    pwhAuth("different-user:webhook-local-password"),
    "Bearer token",
    "Basic !!!!",
    "Basic",
    "Basic " + repeat("A", 1000),
  ] {
    let v = pwhVerdict(auth, "not json", pwhSecret)
    assert(v == "Auth: Postmark webhook credentials do not match", v)
    assert(!contains(v, pwhSecret), "secret disclosure")
  }
  let empty = pwhVerdict(pwhAuth(pwhSecret), pwhDelivery, "")
  assert(
      empty ==
      "Invalid: postmark webhooks need the basic-auth user:password configured in the webhook URL",
    empty,
  )
  assert(
    pwhVerdict("bAsIc " + encodeBase64([]byte(pwhSecret)), pwhDelivery, pwhSecret) == "ok",
    "scheme case",
  )
}

test "Postmark refuses wrong equal-length decoded credentials" {
  let v = pwhVerdict(pwhAuth("inkwell:webhook-local-passwore"), pwhDelivery, pwhSecret)
  assert(v == "Auth: Postmark webhook credentials do not match", v)
}

test "Postmark refuses malformed authenticated records" {
  for body of [
    "not json",
    "[]",
    "null",
    "{}",
    "{\"RecordType\":17}",
    "{\"RecordType\":\"Delivery\"}",
    "{\"RecordType\":\"Delivery\",\"Recipient\":17}",
    "{\"RecordType\":\"SubscriptionChange\",\"Recipient\":\"sara@example.com\"}",
    "{\"RecordType\":\"SubscriptionChange\",\"Recipient\":\"sara@example.com\",\"SuppressSending\":null}",
    "{\"RecordType\":\"SubscriptionChange\",\"Recipient\":\"sara@example.com\",\"SuppressSending\":\"false\"}",
  ] {
    let v = pwhVerdict(pwhAuth(pwhSecret), body, pwhSecret)
    assert(contains(v, "Invalid:"), v)
  }
  assert(len(pwhEvents("{\"RecordType\":\"FutureEvent\"}")) == 0, "unmapped")
}

test "Postmark shares the 1 MiB bound and authenticates at the exact bound" {
  let big = pwhVerdict("", repeat(" ", 1048577), pwhSecret)
  assert(big == "Invalid: webhook body is over 1 MiB", big)
  let edge = pwhVerdict("", repeat(" ", 1048576), pwhSecret)
  assert(edge == "Auth: Postmark webhook credentials do not match", edge)
}
