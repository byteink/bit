// pkg/mail/webhook.bit — `parseEvents`, the one function a webhook endpoint
// calls to turn a provider's signed POST into `Event`s: bounces and complaints
// that must feed a suppression list, deliveries and clicks that feed analytics.
//
// The signature is verified over the raw body BEFORE any JSON is parsed, so an
// unauthenticated request never reaches the parser. Each provider signs its own
// way and posts its own JSON; this file owns the shared types and the dispatch,
// and one file per provider owns the rest (webhookresend.bit for Resend).

import { Timestamp, now } from "std/time"

// The most body bytes `parseEvents` reads: 1 MiB. Providers post a few KiB; a
// bigger body is refused before it is hashed, so a flood of large requests
// cannot make the endpoint spend time on them.
const maxWebhookBody: int = 1048576

// Who posted the webhook. One value per provider, so the provider is data, not
// a different function to call. A provider is added here in the same change
// that parses its webhooks, so every value is one `parseEvents` can read.
export enum Provider {
  Resend,
}

// What happened to one message for one recipient, in the provider's words
// reduced to the set every provider shares.
export enum EventKind {
  // The recipient's server accepted the message.
  Delivered,
  // The recipient's server could not take it yet; the provider retries.
  Deferred,
  // The recipient's server refused it. `Event.permanent` says whether for good.
  Bounced,
  // The recipient marked it as spam. Stop sending to this address.
  Complained,
  // The recipient unsubscribed.
  Unsubscribed,
  // The recipient opened it.
  Opened,
  // The recipient followed a link in it.
  Clicked,
  // The provider refused to send it: a quota, a suppression list, a bad domain.
  Rejected,
  // The recipient subscribed.
  Subscribe,
}

// One thing that happened to one message, for one recipient. A webhook that
// names three recipients yields three events.
export class Event {
  export kind: EventKind,
  // The address the event is about, as the provider reports it.
  export recipient: string,
  // The Message-ID of the mail as written, `<...>`, or "" when the provider did
  // not report it. It matches `Receipt.messageId`.
  export messageId: string,
  // The provider's own id for the message (Resend: `data.email_id`).
  export providerId: string,
  // The provider's id for this webhook delivery. It is the same on every retry
  // of the same delivery, so an app de-duplicates on it (Resend: `svix-id`).
  export deliveryId: string,
  // When it happened, as the provider reports it.
  export at: Timestamp,
  // For `Bounced`: whether the refusal is for good. Always false for the other
  // kinds. A bounce whose type the provider does not state counts as permanent.
  export permanent: bool,
  // The provider's explanation, "" when it gave none. It is the provider's
  // text, not this package's: never put it in a page unescaped.
  export reason: string,
  // Who posted it.
  export provider: Provider,
}

// The `Event`s in the webhook `p` posted. `header` returns the request header
// of that name (it is called with lower-case names) or "" when it is absent;
// `body` is the request body exactly as received, never parsed and written back
// out, because the signature covers its bytes. `secret` is the signing secret
// the provider's dashboard shows.
//
//   let events = parseEvents(Provider.Resend, h, body, secret)?
//
// A signature that does not match, a missing signature header or a timestamp
// more than 5 minutes from now fails with `MailError.Signature`, whose text
// names the reason and never contains the secret; answer such a request with
// 401. A body over 1 MiB or one that is not the provider's
// JSON fails with `MailError.Invalid`, and a `secret` that cannot be a signing
// secret with `MailError.Config` on every call, so a wrong setup is found by
// the first request. A webhook of a kind this package does not map is not an
// error: it yields `[]`.
export fn parseEvents(
  p: Provider,
  header: (string) => string,
  body: string,
  secret: string,
): []Event!MailError {
  return webhookEvents(p, header, body, secret, now())?
}

// `parseEvents` at the instant `at`, which is what lets a test replay a request
// from the past.
fn webhookEvents(
  p: Provider,
  header: (string) => string,
  body: string,
  secret: string,
  at: Timestamp,
): []Event!MailError {
  match (p) {
    Resend => {
      if (len(body) > maxWebhookBody) {
        fail MailError.Invalid("webhook body is over 1 MiB")
      }
      return resendEvents(header, body, secret, at)?
    }
  }
}
