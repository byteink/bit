// pkg/mail/mailer.bit — `Mailer`, the one object a program sends mail through.
// It owns a `Transport` and the defaults from `Options`, checks the message,
// renders it (render.bit), signs it (dkimwire.bit) and hands the result to the
// transport.

import { lookupTxt } from "std/net"
import { now } from "std/time"

// Sends mail through a transport. Build it once at startup:
//
//   let mailer = Mailer(Outbox(), Options{ from = "Inkwell <hello@inkwell.dev>" })?
//
// Construction fails with `MailError.Config` when `Options` cannot work, so a
// wrong setup stops the program there and not at its first send.
export class Mailer {
  t: Transport
  d: Defaults
  keys: []DkimKey
  pace: Pacer
  // The bare address `Options.redirect` names, "" when mail is not redirected.
  redirect: string
  // Reads a DKIM record for `verify`: `lookupTxt`, replaced in a test.
  lookup: TxtLookup
  // What `verify` calls the transport: the URL `open` was given with the
  // secrets hidden, `transport` for one handed to `Mailer(...)` directly.
  name: string

  init(t: Transport, opts: Options = Options{})!MailError {
    checkOptions(opts)?
    checkComposed(t, opts)?
    let keys = loadDkimKeys(opts.dkim)?
    checkDkimWire(keys, opts.from, t)?
    let reply: []string = []
    if (opts.replyTo != "") {
      reply = [opts.replyTo]
    }
    this.t = t
    this.redirect = redirectEmail(opts)
    this.d = Defaults{ from = opts.from, replyTo = reply }
    this.keys = keys
    this.pace = Pacer(opts)
    this.lookup = lookupTxt
    this.name = "transport"
  }

  // Renders `m`, signs it with `Options.dkim` and delivers it. A message that
  // is incomplete or holds a value that is not acceptable fails with
  // `MailError.Invalid` before the transport is called, and so does one whose
  // From aligns with no DKIM key. A delivery the server only postponed is
  // repeated per `Options.retry` and paced by `Options.rate`, always with the
  // bytes rendered and signed here; the transport's own refusals come back as
  // it reports them. With `Options.redirect` the transport gets the redirected
  // message (redirect.bit) and the `Receipt` lists the redirect address only.
  export send(m: Message): Receipt!MailError {
    let s = stage(m, this.d, this.redirect)?
    let r = s.rendered
    let raw = this.sign(r)?
    // The one place retries and rate apply: a queue that owns its own retries
    // (pkg/jobs) hands the transport the Delivery without going through `pace`.
    return this.pace.run(
      this.t,
      Delivery{
        message = s.message,
        envelope = r.envelope,
        messageId = r.messageId,
        raw = raw,
      },
    )?
  }

  // The bytes `send` would hand to the transport for `m`, without sending them.
  // `Date` and, unless `Message.id` is set, `Message-ID` are made fresh on every
  // render, so two renders of one message differ in those lines only; with
  // `Options.dkim` the `DKIM-Signature` lines differ with them.
  export render(m: Message): string!MailError {
    let s = stage(m, this.d, this.redirect)?
    return this.sign(s.rendered)?
  }

  // `r.data` with one `DKIM-Signature` per key whose `d=` aligns with the From
  // domain, RSA first. A From that aligns with none would pass SPF or DKIM and
  // still fail DMARC, so it is refused here, before any delivery.
  sign(r: Rendered): string!MailError {
    if (len(this.keys) == 0) {
      return r.data
    }
    let domain = domainOf(r.envelope.from)
    let keys = dkimKeysFor(this.keys, domain)
    if (len(keys) == 0) {
      fail MailError.Invalid("from: the domain ${shown(domain)} aligns with no Options.dkim domain, so DMARC would reject the mail")
    }
    return dkimSign(r.data, keys, now())?
  }

  // The one call for a program's boot or health check: proves the mail setup
  // works without sending any. Every transport connects and logs in, or makes
  // its provider's cheapest authenticated read (`Transport.check`), and the
  // DNS record of every `Options.dkim` key is read and compared with the key
  // that signs. It does not stop at the first problem: it fails with one
  // `MailError.Config` that lists every problem on a line of its own, and for a
  // DKIM record that is wrong, the TXT value to publish. See docs/verify.md.
  export verify(): ()!MailError {
    verifyMailer(this.name, this.t, this.keys, this.lookup)?
  }

  // Releases the transport. Call it once, when no send is running.
  export close() {
    this.t.close()
  }
}
