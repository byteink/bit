// pkg/mail/resend.bit — the `Transport` `open("resend://KEY@default")` returns:
// one `POST https://api.resend.com/emails` per message with the API key as a
// Bearer token (https://resend.com/docs/api-reference/emails/send-email). The
// JSON is made in resendbody.bit; this file is the URL, the request and what
// each answer means.
//
//   resend://KEY@default                        api.resend.com
//   resend://KEY@host[:port]                    https://host[:port], for a proxy or a test
//   resend://KEY@host[:port]?insecureSkipVerify=true     ... without checking its certificate
//
// The URL, the client and the reading of `Retry-After` are shared with the other
// HTTPS-API transports (httpapi.bit). The request is always TLS: there is no URL
// that sends the key over plaintext, and `insecureSkipVerify` is refused for the
// real host, so only a stand-in can be left unverified. The key is never in an
// error, a `Receipt` or the text of the transport.
//
// What Resend answers, and what the caller gets:
//   2xx                          `Receipt.providerId` is the `id` it returns
//   401, 403 (but see below)     `Auth`
//   403 `validation_error`       `Rejected`: an unverified domain is not a bad key
//   409 concurrent/locked        `Transient`: the same key is in flight, try later
//   409 otherwise                `Invalid`: the key was used with another payload
//   429 and 5xx                  `Transient`, `Reply.retryAfter` from `Retry-After`
//   a failed TLS handshake       `Rejected`: the same certificate is presented next time
//   any other network failure    `Transient`, even one after the request was
//                                written: the `Idempotency-Key` makes a repeat safe
//   any other 4xx                `Rejected` with Resend's `message`

import { Client as HttpClient } from "std/http"
import { Millisecond } from "std/time"

fn resendSpec(): ApiSpec {
  return ApiSpec{
    scheme = "resend://",
    defaultHost = "api.resend.com",
    secret = "API key",
    placeholder = "KEY",
  }
}

// Whether `url` is a `resend://` URL, whatever follows.
fn isResendUrl(url: string): bool {
  return hasScheme(url, "resend://")
}

// `url` as a target, or a `Config` that never repeats the key.
fn parseResend(url: string): ApiTarget!MailError {
  return parseApiUrl(resendSpec(), url)?
}

class ResendTransport {
  t: ApiTarget
  from: string
  replyTo: []string
  timeoutMs: int

  init(t: ApiTarget, opts: Options) {
    this.t = t
    this.from = opts.from
    this.replyTo = []
    if (opts.replyTo != "") {
      this.replyTo = [opts.replyTo]
    }
    this.timeoutMs = opts.timeout / Millisecond
  }

  // Posts `d` as one Resend email. See the top of this file for what each
  // answer becomes.
  export deliver(d: Delivery): Receipt!MailError {
    let body = resendPayload(d, this.from, this.replyTo)?
    let key = resendKey(d)?
    let c = apiClient(this.t.insecure)
    defer c.close()
    this.setHeaders(c, key)?
    let res = c.requestTimeout("POST", "${this.t.base}/emails", body, this.timeoutMs) catch e {
      fail apiNetError("resend: ${this.scrub(e.message())}", e, true)
    }
    return this.answer(res.status, res.headers, res.body, d)?
  }

  // The mail is built at Resend, so what leaves is not `Delivery.raw`.
  export signs(): bool {
    return false
  }

  // `GET /domains?limit=1` with the API key, the read Resend documents for
  // listing domains (https://resend.com/docs/api-reference/domains/list-domains).
  // A key that may only send mail is answered 401 `restricted_api_key`
  // (https://resend.com/docs/api-reference/errors): Resend knew the key, so it
  // counts as working. Any other refusal is what `apiReadError` makes of it.
  export check(): ()!MailError {
    let c = apiClient(this.t.insecure)
    defer c.close()
    this.setAuth(c)?
    let res = apiGet(c, "${this.t.base}/domains?limit=1", this.timeoutMs, "resend", this.t.secret)?
    if (apiOk(res.status) ||
      (res.status == 401 && apiField(res.body, "name") == "restricted_api_key")) {
      return
    }
    fail apiReadError(res.status, res.headers, this.scrub(apiField(res.body, "message")))
  }

  // Nothing is held between sends.
  export close() {}

  // `resend://***@api.resend.com`, the key hidden.
  export toString(): string {
    return this.t.display
  }

  // The headers every send carries. The key was checked at `open` and the
  // Idempotency-Key at `resendKey`, so a refusal here is a bug, reported and
  // never with either value.
  setHeaders(c: HttpClient, key: string): ()!MailError {
    this.setAuth(c)?
    c.setHeader("Content-Type", "application/json") catch _ {
      fail MailError.Config("resend://: Content-Type cannot be set")
    }
    c.setHeader("Idempotency-Key", key) catch _ {
      fail MailError.Invalid("the Idempotency-Key ${echoInput(key)} cannot be sent as a header")
    }
  }

  // The API key as a Bearer token.
  setAuth(c: HttpClient): ()!MailError {
    c.setHeader("Authorization", "Bearer ${this.t.secret}") catch _ {
      fail MailError.Config("resend://: the API key cannot be sent as a header")
    }
  }

  scrub(s: string): string {
    return apiScrub(s, this.t.secret)
  }

  // The `Receipt` for a 2xx, else the `MailError` for the answer.
  answer(status: int, headers: string, body: string, d: Delivery): Receipt!MailError {
    if (status >= 200 && status < 300) {
      return Receipt{
        id = d.messageId,
        providerId = apiField(body, "id"),
        accepted = d.envelope.to,
      }
    }
    let name = apiField(body, "name")
    let text = apiClip(this.scrub(apiField(body, "message")))
    if (text == "") {
      text = "HTTP ${status}"
    }
    let r = Reply{ code = status, text = text, retryAfter = apiRetryAfter(headers) }
    fail resendError(status, name, r)
  }
}

// The `MailError` for a non-2xx answer; the table is at the top of this file.
fn resendError(status: int, name: string, r: Reply): MailError {
  if (status == 401 || (status == 403 && name != "validation_error")) {
    return MailError.Auth(r)
  }
  if (status == 409) {
    if (name == "concurrent_idempotent_requests" || name == "resource_locked") {
      return MailError.Transient(r)
    }
    return MailError.Invalid(r.text)
  }
  if (status == 429 || status >= 500) {
    return MailError.Transient(r)
  }
  return MailError.Rejected(r)
}
