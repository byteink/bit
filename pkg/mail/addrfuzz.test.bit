// pkg/mail/addrfuzz.test.bit — the parser must never panic and never accept
// something it cannot hand back. Every valid row of address.test.bit is cut,
// grown and mutated at every position with the bytes the grammar treats
// specially; each result is either refused or an Address that is free of
// control bytes, within the length limits and stable through `toString`.

// Bytes the grammar treats specially, plus a CR, an LF, a NUL and a lone
// continuation byte (invalid UTF-8 on its own).
fn specials(): []string {
  return [
    "\"",
    "\\",
    "<",
    ">",
    "(",
    ")",
    ",",
    ";",
    ":",
    "@",
    "[",
    "]",
    " ",
    "\t",
    ".",
    "=",
    "?",
    "_",
    "\r",
    "\n",
    bytesOf([0]),
    bytesOf([0x80]),
    "é",
  ]
}

// Every input derived from `s`: prefixes, suffixes, and `s` with each special
// inserted or substituted at each byte offset.
fn derived(s: string): []string {
  let out: []string = []
  let i = 0
  while (i <= len(s)) {
    out = append(out, s[:i])
    out = append(out, s[i:])
    for sp of specials() {
      out = append(out, s[:i] + sp + s[i:])
      if (i < len(s)) {
        out = append(out, s[:i] + sp + s[i + 1:])
      }
    }
    i = i + 1
  }
  return out
}

fn hasControl(s: string): bool {
  for c of []byte(s) {
    if (c < u8(32) || c == u8(127)) {
      return true
    }
  }
  return false
}

// Whether `a` is what an accepted address must be: clean, bounded, stable.
fn sound(a: Address): string {
  if (hasControl(a.name) || hasControl(a.email)) {
    return "control byte in the result"
  }
  if (len(a.email) > 254 || len(a.email) < 3) {
    return "email length ${len(a.email)}"
  }
  let again = parseAddress(a.toString()) catch e {
    return "toString does not parse: ${e.message()}"
  }
  if (again.name != a.name || again.email != a.email) {
    return "toString changed it to '${again.name}' / '${again.email}'"
  }
  return ""
}

test "no mutation of a valid row panics, and every accepted one is sound" {
  let tried = 0
  let accepted = 0
  for r of validRows() {
    for input of derived(r.input) {
      tried = tried + 1
      let a = parseAddress(input) catch _ {
        continue
      }
      accepted = accepted + 1
      let why = sound(a)
      assert(why == "", "${why} for input '${input}'")
    }
  }
  assert(tried > 20000, "only ${tried} inputs tried")
  assert(accepted > 1000, "only ${accepted} accepted; the sweep stopped reaching the accept path")
}
