// pkg/mail/unsubscribe.test.bit — `Message.unsubscribe`: the exact header
// fields for an https URL, a mailto alone and both, the DKIM coverage of both
// fields, every refusal with its words, and the fields on each provider API.

import { Envelope } from "std/smtp"
import { contains, hasPrefix, indexOf, join, repeat, replace, split } from "std/strings"

const unUrl: string = "https://inkwell.dev/u/7f3a9c"

fn unMessage(u: Unsubscribe): Message {
  return Message{
    from = "Inkwell <hello@inkwell.dev>",
    to = ["Sara Ali <sara@example.com>"],
    subject = "Your weekly Inkwell digest",
    text = "Three new posts this week.",
    id = "digest-41",
    unsubscribe = u,
  }
}

fn unRender(m: Message, o: Options): string {
  let mailer = Mailer(Outbox(), o) catch e {
    panic("Mailer: ${e.message()}")
  }
  return mailer.render(m) catch e {
    panic("render: ${e.message()}")
  }
}

// The text of the failure of rendering `m`, or "ok".
fn unRefusal(m: Message): string {
  let mailer = Mailer(Outbox(), Options{}) catch e {
    panic("Mailer: ${e.message()}")
  }
  mailer.render(m) catch e {
    match (e) {
      Invalid(_) => return e.message()
      _ => return "not Invalid: ${e.message()}"
    }
  }
  return "ok"
}

// The header lines of `raw` that start with `name` and a colon, unfolded: a
// long field is wrapped at its `, ` (RFC 5322 section 2.2.3).
fn unLines(raw: string, name: string): []string {
  let out: []string = []
  for line of split(replace(raw, "\r\n ", " "), "\r\n") {
    if (hasPrefix(line, "${name}: ")) {
      out = append(out, line)
    }
  }
  return out
}

// The lines `unLines` finds, joined with `|`, so one comparison states both
// how many there are and what they say.
fn unJoined(raw: string, name: string): string {
  return join(unLines(raw, name), "|")
}

test "an https url writes both fields exactly" {
  let raw = unRender(unMessage(Unsubscribe{ url = unUrl }), Options{})
  assert(unJoined(raw, "List-Unsubscribe") == "List-Unsubscribe: <${unUrl}>", raw)
  assert(
    unJoined(raw, "List-Unsubscribe-Post") == "List-Unsubscribe-Post: List-Unsubscribe=One-Click",
    raw,
  )
}

test "a url and a mailto share one List-Unsubscribe, the url first" {
  let raw = unRender(
    unMessage(Unsubscribe{ url = unUrl, mailto = "unsubscribe@inkwell.dev?subject=stop" }),
    Options{},
  )
  let want = "List-Unsubscribe: <${unUrl}>, <mailto:unsubscribe@inkwell.dev?subject=stop>"
  assert(unJoined(raw, "List-Unsubscribe") == want, raw)
  assert(len(unLines(raw, "List-Unsubscribe-Post")) == 1, raw)
}

test "a mailto alone writes one field and no Post field" {
  let raw = unRender(unMessage(Unsubscribe{ mailto = "mailto:unsubscribe@inkwell.dev" }), Options{})
  assert(
    unJoined(raw, "List-Unsubscribe") == "List-Unsubscribe: <mailto:unsubscribe@inkwell.dev>",
    raw,
  )
  assert(!contains(raw, "List-Unsubscribe-Post"), raw)
}

test "a bare address gets the mailto scheme" {
  let raw = unRender(unMessage(Unsubscribe{ mailto = "unsubscribe@inkwell.dev" }), Options{})
  assert(contains(raw, "List-Unsubscribe: <mailto:unsubscribe@inkwell.dev>\r\n"), raw)
}

test "a message without unsubscribe has neither field" {
  let raw = unRender(unMessage(Unsubscribe{}), Options{})
  assert(!contains(raw, "List-Unsubscribe"), raw)
}

test "the DKIM signature lists both fields for an https url" {
  let o = Options{ dkim = [Dkim{ domain = "inkwell.dev", selector = "rsa1", key = rsaPkcs8Pem }] }
  let raw = unRender(unMessage(Unsubscribe{ url = unUrl }), o)
  let sig = raw[:indexOf(raw, "\r\nFrom: ")]
  assert(hasPrefix(sig, "DKIM-Signature: "), sig)
  let names = hList(sig)
  assert(listHas(names, "list-unsubscribe"), sig)
  assert(listHas(names, "list-unsubscribe-post"), sig)
}

test "http is refused for one-click" {
  let got = unRefusal(unMessage(Unsubscribe{ url = "http://inkwell.dev/u/7f3a9c" }))
  assert(
    got == "mail: unsubscribe.url: must be https for one-click (RFC 8058)",
    got,
  )
}

test "a url that is not https, has a space or an angle bracket, or is too long is refused" {
  assert(contains(unRefusal(unMessage(Unsubscribe{ url = "ftp://x.dev/u" })), "is not an https URL"))
  assert(contains(unRefusal(unMessage(Unsubscribe{ url = "https://" })), "is not an https URL"))
  let space = unRefusal(unMessage(Unsubscribe{ url = "https://inkwell.dev/u 7" }))
  assert(contains(space, "unsubscribe.url: it must be printable ASCII"), space)
  let angle = unRefusal(unMessage(Unsubscribe{ url = "https://inkwell.dev/u>7" }))
  assert(contains(angle, "unsubscribe.url: it must be printable ASCII"), angle)
  let crlf = unRefusal(unMessage(Unsubscribe{ url = "https://inkwell.dev/u\r\nBcc: x@y.dev" }))
  assert(contains(crlf, "unsubscribe.url"), crlf)
  assert(!contains(crlf, "\r"), crlf)
  let long = unRefusal(unMessage(Unsubscribe{ url = "https://inkwell.dev/" + repeat("a", 2000) }))
  assert(contains(long, "the longest is 2000"), long)
}

test "a mailto that is no address is refused" {
  let got = unRefusal(unMessage(Unsubscribe{ mailto = "mailto:no-at-sign" }))
  assert(contains(got, "unsubscribe.mailto: "), got)
  let angle = unRefusal(unMessage(Unsubscribe{ mailto = "a@inkwell.dev>" }))
  assert(contains(angle, "unsubscribe.mailto: it must be printable ASCII"), angle)
}

test "headers may set neither unsubscribe field, in any case" {
  for name of ["List-Unsubscribe", "list-unsubscribe-post"] {
    let m = unMessage(Unsubscribe{})
    m.headers[name] = "x"
    let got = unRefusal(m)
    assert(contains(got, "set Message.unsubscribe instead"), got)
    assert(contains(got, "headers[\"${name}\"]"), got)
  }
}

// The text of the failure `Mailer(Outbox(), o)` reports, or "ok".
fn unSetup(o: Options): string {
  Mailer(Outbox(), o) catch e {
    return e.message()
  }
  return "ok"
}

test "a custom Dkim.headers list must name both unsubscribe fields" {
  for names of [][]string{
    []string{ "From", "List-Unsubscribe" },
    []string{ "From", "list-unsubscribe-post" },
    []string{ "From" },
  } {
    let o = Options{
      dkim = [Dkim{ domain = "inkwell.dev", selector = "rsa1", key = rsaPkcs8Pem, headers = names }],
    }
    let got = unSetup(o)
    assert(
      hasPrefix(
        got,
        "mail: configuration: dkim rsa1._domainkey.inkwell.dev: headers must include List-Unsubscribe and List-Unsubscribe-Post",
      ),
      got,
    )
  }
  let ok = Options{
    dkim = [
      Dkim{
        domain = "inkwell.dev",
        selector = "rsa1",
        key = rsaPkcs8Pem,
        headers = ["From", "List-Unsubscribe", "List-Unsubscribe-Post"],
      },
    ],
  }
  assert(unSetup(ok) == "ok", unSetup(ok))
}

test "Outbox keeps the unsubscribe the message was sent with" {
  let box = Outbox()
  let mailer = Mailer(box, Options{}) catch e {
    panic("Mailer: ${e.message()}")
  }
  mailer.send(unMessage(Unsubscribe{ url = unUrl })) catch e {
    panic("send: ${e.message()}")
  }
  assert(box.sent()[0].message.unsubscribe.url == unUrl)
  assert(len(unLines(box.sent()[0].raw, "List-Unsubscribe")) == 1)
}

test "a redirected message keeps its unsubscribe fields" {
  let raw = unRender(
    unMessage(Unsubscribe{ url = unUrl }),
    Options{ redirect = "QA <qa@inkwell.dev>" },
  )
  assert(len(unLines(raw, "List-Unsubscribe")) == 1, raw)
}

// A delivery of `m` to a provider API: the transport reads the message, so no
// bytes are rendered.
fn unDelivery(m: Message): Delivery {
  return Delivery{
    message = m,
    envelope = Envelope{ from = "hello@inkwell.dev", to = ["sara@example.com"] },
    messageId = "<digest-41@inkwell.dev>",
    raw = "",
  }
}

// The value `List-Unsubscribe-Post` holds.
const unPostJson: string = "List-Unsubscribe=One-Click"

test "Resend, Postmark and SendGrid carry both fields as custom headers" {
  let d = unDelivery(unMessage(Unsubscribe{ url = unUrl, mailto = "unsubscribe@inkwell.dev" }))
  let from = "Inkwell <hello@inkwell.dev>"
  let uri = "<${unUrl}>, <mailto:unsubscribe@inkwell.dev>"
  let resend = resendPayload(d, from, []) catch e {
    panic("resend: ${e.message()}")
  }
  assert(contains(resend, "\"List-Unsubscribe\":\"${uri}\""), resend)
  assert(contains(resend, "\"List-Unsubscribe-Post\":\"${unPostJson}\""), resend)
  let pm = pmPayload(d, from, [], "outbound") catch e {
    panic("postmark: ${e.message()}")
  }
  assert(contains(pm, "\"Name\":\"List-Unsubscribe\",\"Value\":\"${uri}\""), pm)
  assert(contains(pm, "\"Name\":\"List-Unsubscribe-Post\",\"Value\":\"${unPostJson}\""), pm)
  let sg = sgPayload(d, from, []) catch e {
    panic("sendgrid: ${e.message()}")
  }
  assert(contains(sg, "\"List-Unsubscribe\":\"${uri}\""), sg)
  assert(contains(sg, "\"List-Unsubscribe-Post\":\"${unPostJson}\""), sg)
}

test "a provider API gets no Post field for a mailto alone" {
  let d = unDelivery(unMessage(Unsubscribe{ mailto = "unsubscribe@inkwell.dev" }))
  let body = resendPayload(d, "Inkwell <hello@inkwell.dev>", []) catch e {
    panic("resend: ${e.message()}")
  }
  assert(contains(body, "\"List-Unsubscribe\":\"<mailto:unsubscribe@inkwell.dev>\""), body)
  assert(!contains(body, "List-Unsubscribe-Post"), body)
}
