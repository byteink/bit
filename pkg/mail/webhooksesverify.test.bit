// Frozen OpenSSL 4.0.3 fixtures: P-256 issuer, RSA-2048 signer, no TLS identity.
// v1/v2 signatures were verified independently with OpenSSL before this code.
import { decodeHex, x509Parse } from "std/crypto"

const svRoot: string = ""
const svNotCa: string = ""
const svNotCertSign: string = ""
const svLeaf: string = ""
const svWrongKey: string = ""
const svWrongUsage: string = ""
const svNoUsage: string = ""
const svEcLeaf: string = ""
const svSha1: string = ""
const svSha256: string = ""
const svNow: int = 1792676581
const svCanonical: string = "Message\nfixture-body\nMessageId\nfixture-delivery\nTimestamp\n2026-10-22T13:40:00Z\nTopicArn\narn:aws:sns:us-east-1:123456789012:mail\nType\nNotification\n"

fn svBytes(hex: string): []byte {
  return decodeHex(hex) catch e {
    panic(e.message())
  }
}

fn svCert(hex: string): Certificate {
  return x509Parse(svBytes(hex)) catch e {
    panic(e.message())
  }
}

fn svTrust(roots: []Certificate, at: int): SnsTrust {
  return SnsTrust{ intermediates = []Certificate(0), roots = roots, nowUnix = at }
}

fn svVerdict(
  body: string,
  version: string,
  sig: []byte,
  leaf: Certificate,
  trust: SnsTrust,
): string {
  snsVerifySignature(body, version, sig, leaf, trust) catch e {
    match (e) {
      Signature(why) => return why
      _ => return "wrong error type"
    }
  }
  return "ok"
}

fn svVerify(version: string, sig: []byte, leaf: Certificate): string {
  return svVerdict(svCanonical, version, sig, leaf, svTrust([svCert(svRoot)], svNow))
}

test "SNS RSA verification accepts independent v1 and v2 fixtures without TLS identity" {
  let leaf = svCert(svLeaf)
  assert(len(leaf.dnsNames) == 0 && !leaf.hasExtKeyUsage, "fixture has no TLS identity or purpose")
  assert(svVerify("1", svBytes(svSha1), leaf) == "ok", "OpenSSL SHA1 signature")
  assert(svVerify("2", svBytes(svSha256), leaf) == "ok", "OpenSSL SHA256 signature")
  assert(svVerify("2", svBytes(svSha256), svCert(svNoUsage)) == "ok", "undeclared KeyUsage")
}

test "SNS RSA verification rejects changed canonical bytes and signatures" {
  let sig = svBytes(svSha256)
  let leaf = svCert(svLeaf)
  assert(
      svVerdict(svCanonical + "x", "2", sig, leaf, svTrust([svCert(svRoot)], svNow)) ==
      "SNS signature does not match",
  )
  sig[0] = sig[0] ^ 1
  assert(svVerify("2", sig, leaf) == "SNS signature does not match", "flipped signature")
  sig[0] = sig[0] ^ 1
  assert(svVerify("2", sig, leaf) == "ok", "restored signature")
  assert(svVerify("2", []byte(0), leaf) == "SNS signature does not match", "empty signature")
  assert(
    svVerify("2", sig[:len(sig) - 1], leaf) == "SNS signature does not match",
    "short signature",
  )
  assert(
    svVerify("2", sig, svCert(svWrongKey)) == "SNS signature does not match",
    "different trusted signer",
  )
}

test "SNS RSA verification binds each signature version to its hash" {
  let leaf = svCert(svLeaf)
  assert(svVerify("1", svBytes(svSha256), leaf) == "SNS signature does not match")
  assert(svVerify("2", svBytes(svSha1), leaf) == "SNS signature does not match")
  for version of ["", "0", "3", "02"] {
    assert(svVerify(version, svBytes(svSha256), leaf) == "SNS signature version is not supported")
  }
}

test "SNS RSA verification requires trusted valid certificate paths" {
  let leaf = svCert(svLeaf)
  let sig = svBytes(svSha256)
  assert(
      svVerdict(svCanonical, "2", sig, leaf, svTrust([]Certificate(0), svNow)) ==
      "SNS certificate path is not trusted",
    "missing anchor",
  )
  assert(
      svVerdict(svCanonical, "2", sig, leaf, svTrust([svCert(svWrongKey)], svNow)) ==
      "SNS certificate path is not trusted",
    "unrelated anchor",
  )
  for at of [leaf.notBefore - 1, leaf.notAfter + 1] {
    assert(
        svVerdict(svCanonical, "2", sig, leaf, svTrust([svCert(svRoot)], at)) ==
        "SNS certificate path is not trusted",
      "validity",
    )
  }
  let der = svBytes(svLeaf)
  der[len(der) - 1] = der[len(der) - 1] ^ 1
  let changed = x509Parse(der) catch e {
    panic(e.message())
  }
  assert(
    svVerify("2", sig, changed) == "SNS certificate path is not trusted",
    "invalid issuer signature",
  )
  for root of [svNotCa, svNotCertSign] {
    assert(
        svVerdict(svCanonical, "2", sig, leaf, svTrust([svCert(root)], svNow)) ==
        "SNS certificate path is not trusted",
      "issuer constraint",
    )
  }
}

test "SNS RSA verification checks signing key type and declared KeyUsage" {
  assert(
      svVerify("2", svBytes(svSha256), svCert(svWrongUsage)) ==
      "SNS signing certificate cannot sign messages",
  )
  assert(svVerify("2", svBytes(svSha256), svCert(svEcLeaf)) == "SNS signing certificate is not RSA")
  let invalid = svCert(svLeaf)
  // This isolates the public-key adapter; real signed DER controls remain above.
  invalid.pubKeyBytes = []byte{ 0 }
  assert(svVerify("2", svBytes(svSha256), invalid) == "SNS signing public key is invalid")
}
