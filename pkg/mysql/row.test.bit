// pkg/mysql/row.test.bit — `std/sql`'s `sqlReqDecimal`/`sqlOptDecimal`
// (#5421) proven end to end against a real server, on the SAME accessor
// `pkg/postgres/row.test.bit` proves: a DECIMAL column, inserted and read
// back through the ordinary `query` path, decoded by `sqlReqDecimal` rather
// than this package's own `mysqlDecimal` (decimal.bit) — the point of this
// test is that `std/sql`'s accessor needs no MySQL-specific mechanism, not
// that this package's own codec still works (decimal.test.bit already
// covers that).
//
// #5456's `sqlReqInt`/`sqlReqFloat`/`sqlReqBool`/`sqlReqBlob` regression test
// below is the symmetric half of `pkg/postgres/row.test.bit`'s own: that
// fix retypes what Postgres sends, so it must not change what MySQL's
// genuinely binary protocol already produces.
//
// Skipped when `MY_TEST_MARIADB_URI` is unset, same convention as
// `live.test.bit`/`decimal.test.bit`.

import { sqlReqDecimal, sqlOptDecimal, sqlReqFloat, sqlReqBlob } from "std/sql"
import { toString } from "std/decimal"

fn row5421Uri(): string {
  let uri = env("MY_TEST_MARIADB_URI")
  if (uri == "") {
    print("  skipped: MY_TEST_MARIADB_URI is unset, no live server to talk to")
  }
  return uri
}

test "live: sqlReqDecimal/sqlOptDecimal reach a DECIMAL column end to end" {
  let uri = row5421Uri()
  if (uri == "") {
    return
  }
  let a = newMyAdapter()
  let db = pool(a, Datasource{ uri = uri }) catch e {
    panic("pool: ${e.message()}")
  }
  db.exec("drop table if exists t5421dec", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  db.exec(
    "create table t5421dec (id int primary key, amount decimal(12,4), refunded decimal(12,4))",
    []Value(0),
  ) catch e {
    panic("create: ${e.message()}")
  }
  db.exec(
    "insert into t5421dec (id, amount, refunded) values ($1, $2, $3)",
    []Value{ Value.Int(1), Value.Text("1234.5678"), Value.Null },
  ) catch e {
    panic("insert: ${e.message()}")
  }
  let rows = db.query(
    "select amount, refunded from t5421dec where id = $1", []Value{ Value.Int(1) },
  ) catch e {
    panic("select: ${e.message()}")
  }
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "no row")
  let cols = rows.columns()
  let amount = sqlReqDecimal(rows, cols, "amount") catch e {
    panic("sqlReqDecimal: ${e.message()}")
  }
  assert(toString(amount) == "1234.5678", "amount decoded as '${toString(amount)}'")
  let refunded = sqlOptDecimal(rows, cols, "refunded") catch e {
    panic("sqlOptDecimal: ${e.message()}")
  }
  assert(!isSome(refunded), "a SQL NULL must decode to None, got Some")
  rows.close()
  db.exec("drop table t5421dec", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  db.close()
}

test "live: sqlReqInt/sqlReqFloat/sqlReqBool/sqlReqBlob each read their column type" {
  let uri = row5421Uri()
  if (uri == "") {
    return
  }
  let a = newMyAdapter()
  let db = pool(a, Datasource{ uri = uri }) catch e {
    panic("pool: ${e.message()}")
  }
  db.exec("drop table if exists t5456types", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  db.exec(
    "create table t5456types (id int primary key, n int, f double, ok bool, raw varbinary(16))",
    []Value(0),
  ) catch e {
    panic("create: ${e.message()}")
  }
  db.exec(
    "insert into t5456types (id, n, f, ok, raw) values ($1, $2, $3, $4, $5)",
    []Value{
      Value.Int(1),
      Value.Int(42),
      Value.Float(3.5),
      Value.Int(1),
      Value.Blob([]byte{ 0x68, 0x69 }),
    },
  ) catch e {
    panic("insert: ${e.message()}")
  }
  let rows = db.query(
    "select n, f, ok, raw from t5456types where id = $1", []Value{ Value.Int(1) },
  ) catch e {
    panic("select: ${e.message()}")
  }
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "no row")
  let cols = rows.columns()
  let n = sqlReqInt(rows, cols, "n") catch e {
    panic("sqlReqInt: ${e.message()}")
  }
  assert(n == 42, "n (int) decoded as ${n}")
  let f = sqlReqFloat(rows, cols, "f") catch e {
    panic("sqlReqFloat: ${e.message()}")
  }
  assert(f == 3.5, "f (double) decoded as ${f}")
  let ok = sqlReqBool(rows, cols, "ok") catch e {
    panic("sqlReqBool: ${e.message()}")
  }
  assert(ok, "ok (bool) decoded as false")
  let raw = sqlReqBlob(rows, cols, "raw") catch e {
    panic("sqlReqBlob: ${e.message()}")
  }
  assert(string(raw) == "hi", "raw (varbinary) decoded as '${string(raw)}'")
  rows.close()
  db.exec("drop table t5456types", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  db.close()
}
