// pkg/mysql/adapter.test.bit — plugin-specific nonce framing (#8352).

fn checkedScramble(plugin: string, data: string): string {
  return switchScramble(plugin, data) catch e {
    panic(e.message())
  }
}

test "ed25519 switch preserves all binary bytes including trailing zeros" {
  let nonce = "0123456789abcdef0123456789abc" + string([]byte(3))
  assert(len(nonce) == 32, "fixture length")
  assert(checkedScramble("client_ed25519", nonce) == nonce, "binary nonce changed")
  assert(checkedScramble("ed25519", nonce) == nonce, "alias nonce changed")
  let nonzero = "0123456789abcdef0123456789abcdef"
  assert(checkedScramble("client_ed25519", nonzero) == nonzero, "nonzero nonce changed")
}

test "ed25519 switch rejects malformed nonce lengths before signing" {
  let lengths = [0, 1, 31, 33, 34]
  for n of lengths {
    let rejected = false
    switchScramble("client_ed25519", string([]byte(n))) catch e {
      rejected = contains(e.message(), "32-byte authentication nonce")
    }
    assert(rejected, "accepted ${n} nonce bytes")
  }
}

test "other switch plugins retain one trailing terminator removal" {
  let nonce = "01234567890123456789"
  let plugins = ["mysql_native_password", "caching_sha2_password", "mysql_old_password"]
  for plugin of plugins {
    assert(checkedScramble(plugin, cstr(nonce)) == nonce, "terminator retained")
    assert(checkedScramble(plugin, nonce) == nonce, "unterminated data changed")
    assert(checkedScramble(plugin, "") == "", "empty data changed")
    assert(checkedScramble(plugin, cstr(cstr(nonce))) == cstr(nonce), "removed two zeros")
  }
}
