// pkg/mysql/uri.test.bit — the URI parser and the ssl-mode table (#3993).

// The target `uri` parses to, or a panic naming the failure: every case here is
// a URI that must parse.
fn parsed(uri: string): target {
  return parseUri(uri) catch e {
    panic("${uri}: ${e.message()}")
  }
}

// The failure `uri` produced, or "" when it parsed.
fn parseFailure(uri: string): string {
  let t = parseUri(uri) catch e {
    return e.message()
  }
  assert(t.port > 0, "a parsed target must carry a port")
  return ""
}

test "both schemes are accepted and parse identically" {
  let a = parsed("mysql://app:pw@db.internal:3307/erp")
  let b = parsed("mariadb://app:pw@db.internal:3307/erp")
  assert(a.host == "db.internal" && b.host == "db.internal", "host: ${a.host}/${b.host}")
  assert(a.port == 3307 && b.port == 3307, "port: ${a.port}/${b.port}")
  assert(a.user == "app" && b.user == "app", "user: ${a.user}/${b.user}")
  assert(a.password == "pw" && b.password == "pw", "password: ${a.password}/${b.password}")
  assert(a.database == "erp" && b.database == "erp", "database: ${a.database}/${b.database}")
  assert(!a.pinned && !b.pinned, "an absent ssl-mode was read as a pin")
}

test "a scheme this driver does not speak is refused by scheme" {
  let err = parseFailure("postgres://app@localhost/dev")
  assert(contains(err, "mysql:// or mariadb://"), "message: ${err}")
}

test "port 0 and an omitted port both mean 3306, in either form of Datasource" {
  assert(parsed("mysql://app@localhost/dev").port == 3306, "the URI form defaulted elsewhere")
  let fields = targetOf(
    Datasource{ host: "localhost", user: "app", database: "dev" },
  ) catch e {
    panic("targetOf: ${e.message()}")
  }
  assert(fields.port == 3306, "the field form defaulted to ${fields.port}")
  assert(fields.host == "localhost", "host is ${fields.host}")
  assert(!fields.pinned, "an omitted sslmode field was read as a pin")
}

test "the MySQL ssl-mode spellings map onto SslMode and pin it" {
  assert(
    parsed("mysql://a@h/d?ssl-mode=VERIFY_IDENTITY").mode == SslMode.VerifyFull,
    "VERIFY_IDENTITY",
  )
  assert(parsed("mysql://a@h/d?ssl-mode=VERIFY_CA").mode == SslMode.VerifyCa, "VERIFY_CA")
  assert(parsed("mysql://a@h/d?ssl-mode=REQUIRED").mode == SslMode.Require, "REQUIRED")
  assert(parsed("mysql://a@h/d?ssl-mode=DISABLED").mode == SslMode.Disable, "DISABLED")
  assert(parsed("mysql://a@h/d?ssl-mode=required").mode == SslMode.Require, "lower case")
  assert(parsed("mysql://a@h/d?ssl-mode=REQUIRED").pinned, "an explicit ssl-mode is not a pin")
}

test "an unrecognised ssl-mode value is rejected, never defaulted" {
  let err = parseFailure("mysql://a@h/d?ssl-mode=VERIFY_IDENTITYY")
  assert(contains(err, "VERIFY_IDENTITYY"), "the failure does not name the value: ${err}")
  assert(contains(err, "VERIFY_IDENTITY"), "the failure does not name the accepted set: ${err}")
}

test "PREFERRED is rejected with everything else, not treated as the ladder" {
  let err = parseFailure("mysql://a@h/d?ssl-mode=PREFERRED")
  assert(contains(err, "PREFERRED"), "message: ${err}")
}

test "an unsupported query parameter fails naming itself" {
  let err = parseFailure("mysql://a@h/d?charset=utf8mb4")
  assert(contains(err, "charset"), "message: ${err}")
}

test "a percent-escaped password and a bad escape" {
  assert(parsed("mysql://app:p%40ss%2Fw@h/d").password == "p@ss/w", "percent-decoding")
  assert(contains(parseFailure("mysql://app:p%zz@h/d"), "percent-escape"), "a bad escape parsed")
}

test "a port that is not a number, or out of range, is refused" {
  assert(contains(parseFailure("mysql://a@h:3306x/d"), "not a number"), "3306x parsed")
  assert(contains(parseFailure("mysql://a@h:70000/d"), "out of range"), "70000 parsed")
}

test "a URI with no host is refused rather than dialled empty" {
  assert(contains(parseFailure("mysql:///dev"), "names no host"), "an empty host parsed")
}

test "the mode names used in warnings are the MySQL spellings" {
  assert(sslModeName(SslMode.VerifyFull) == "VERIFY_IDENTITY", "VerifyFull")
  assert(sslModeName(SslMode.Disable) == "DISABLED", "Disable")
}
