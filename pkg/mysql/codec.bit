// pkg/mysql/codec.bit — the rest of the MySQL/MariaDB -> Bit type table
// (#3995), the layer above binary.bit's wire codec.
//
// `binary.bit` turns wire bytes into a `Value` (std/sql's five-variant sum
// type: Null/Int/Float/Text/Blob); this file turns the `Value` a TIMESTAMP or
// a MariaDB UUID column produces into the richer Bit type the table promises
// — `std/time.Timestamp`, `std/uuid.UUID`. `decimal.bit` is this file's
// sibling for DECIMAL/NUMERIC, split out because it is the one codec the
// ticket requires proven against the server's own text form.
//
// THREE ROWS OF THE TABLE NEED NO CODE HERE.
//   TINYINT(1) -> bool or i64: already decodes to `Value.Int` (binary.bit,
//     unchanged), and std/sql/row.bit's `sqlReqBool`/`sqlReqInt` already read
//     an Int as zero/nonzero or as-is. "The field's type decides" is exactly
//     the caller picking which of those two to call — the same rule JSON
//     gets from the field it is read into.
//   JSON -> the field's own type: no MySQL-specific decoding; the field's
//     type decides via the ordinary Value accessors, same as above.
//   INET4/INET6 (MariaDB) -> string: the unmapped-type rule. Neither type is
//     named in binary.bit's fixed-width or temporal lists, so it already
//     falls through to the generic length-encoded string and decodes to
//     `Value.Text` with no change needed.
//   DATETIME's refusal lives in binary.bit itself (`binaryValue`), not here:
//     only that function knows the column's kind by the time a value would
//     be produced, and a `Value` carries no such distinction afterward.
//
// TIMESTAMP is the zone-aware type (#3995 — the reverse of Postgres's naming,
// a trap for anyone porting by analogy). `adapter.bit`'s `connect` pins the
// session to `time_zone = '+00:00'`, so the text this parses is always UTC
// regardless of server configuration — never trust the server's own setting.
import { date, utc, Timestamp } from "std/time"
import { UUID, equals as uuidEquals, nilUUID, parse as parseUuid } from "std/uuid"

// The value of a TIMESTAMP column named `col`, as the instant it names.
// `v` must be `Value.Text` in the fixed-width form `binary.bit`'s
// `temporalText` produces — `"YYYY-MM-DD"` or
// `"YYYY-MM-DD HH:MM:SS"`/`"YYYY-MM-DD HH:MM:SS.ffffff"` — never anything a
// DATETIME column could have produced, since that kind fails before a Value
// exists.
export fn mysqlInstant(col: string, v: Value): Timestamp! {
  let s = asText(v) catch _ {
    fail newError("mysql: column '${col}' is not a TIMESTAMP value")
  }
  return parseMysqlTimestamp(s) catch e {
    fail newError("mysql: column '${col}': ${e.message()}")
  }
}

// As `mysqlInstant`, but a SQL NULL decodes to `None` rather than failing.
export fn mysqlOptInstant(col: string, v: Value): Option<Timestamp>! {
  if (isNull(v)) {
    return Option<Timestamp>.None
  }
  return Option<Timestamp>.Some(mysqlInstant(col, v)?)
}

// The value of a MariaDB UUID column named `col`. MariaDB's native UUID type
// (10.7+) is sent over this protocol in its canonical 36-character text form
// — nothing in `binary.bit` special-cases it, so it already decodes to
// `Value.Text` and this is exactly `std/uuid.parse` on that text.
export fn mysqlUuid(col: string, v: Value): UUID! {
  let s = asText(v) catch _ {
    fail newError("mysql: column '${col}' is not a UUID value")
  }
  return parseUuid(s) catch e {
    fail newError("mysql: column '${col}': ${e.message()}")
  }
}

// As `mysqlUuid`, but a SQL NULL decodes to `None` rather than failing.
export fn mysqlOptUuid(col: string, v: Value): Option<UUID>! {
  if (isNull(v)) {
    return Option<UUID>.None
  }
  return Option<UUID>.Some(mysqlUuid(col, v)?)
}

// `"YYYY-MM-DD"`, optionally followed by `" HH:MM:SS"` and `.ffffff`, as the
// instant it names in UTC. Every field is fixed-width (`binary.bit`'s `pad`),
// so this reads digits at known offsets rather than scanning.
fn parseMysqlTimestamp(s: string): Timestamp! {
  let b = []byte(s)
  if (len(b) < 10) {
    fail newError("not a date: '${s}'")
  }
  let d = date(digit4(b, 0), digit2(b, 5), digit2(b, 8))?
  let (hour, minute, second, nanos) = mysqlClock(b)
  return d.atTime(hour, minute, second)?.addNanoseconds(nanos).inZone(utc()).toTimestamp()?
}

// The clock portion of a `parseMysqlTimestamp` body, or all zeros when the
// value is date-only (a TIMESTAMP at exact midnight with no fraction sends no
// time component at all — `binary.bit`'s `dateText`).
fn mysqlClock(b: []byte): (int, int, int, int) {
  if (len(b) < 19) {
    return (0, 0, 0, 0)
  }
  let hour = digit2(b, 11)
  let minute = digit2(b, 14)
  let second = digit2(b, 17)
  if (len(b) < 26) {
    return (hour, minute, second, 0)
  }
  return (hour, minute, second, digit6(b, 20) * 1000)
}

// The two ASCII digits at `b[i:i+2]`, as an int.
fn digit2(b: []byte, i: int): int {
  return (int(b[i]) - 48) * 10 + (int(b[i + 1]) - 48)
}

// The four ASCII digits at `b[i:i+4]`, as an int.
fn digit4(b: []byte, i: int): int {
  return digit2(b, i) * 100 + digit2(b, i + 2)
}

// The six ASCII digits at `b[i:i+6]` (microseconds), as an int.
fn digit6(b: []byte, i: int): int {
  return digit2(b, i) * 10000 + digit2(b, i + 2) * 100 + digit2(b, i + 4)
}
