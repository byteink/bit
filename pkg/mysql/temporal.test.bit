// pkg/mysql/temporal.test.bit — `mysqlDate`/`mysqlTime` proven against a real
// server (#5453, epic #5449): DATE's 0/4-byte forms, TIME's sign byte and day
// count (negative, and past 24 hours), and the null/malformed error paths.
// DATETIME/TIMESTAMP's 7/11-byte forms (h/m/s, then microseconds) are already
// proven by `codec.test.bit`'s TIMESTAMP coverage through the same
// `binary.bit` decode this file's DATE/TIME share — DATE itself has no time
// component in MySQL, so an 11-byte DATE cannot exist to test.

test "mysqlDate/mysqlTime round-trip DATE's zero form, TIME negative and past 24 hours" {
  let uri = liveUri("MY_TEST_MARIADB_URI")
  if (uri == "") {
    return
  }
  let c = liveConn(uri)
  c.exec("drop table if exists t5453temporal", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.exec("create table t5453temporal (id int primary key, d date, t time(6))", []Value(0)) catch e {
    panic("create: ${e.message()}")
  }
  c.exec("set sql_mode = ''", []Value(0)) catch e {
    panic("set sql_mode: ${e.message()}")
  }
  insertTemporalRows(c)
  checkTemporalRows(c)
  c.exec("drop table t5453temporal", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.close()
}

// Row 0: an ordinary DATE (the 4-byte form) and a positive TIME under 24h.
// Row 1: DATE's zero value (the 0-byte form, `set sql_mode=''` above allows
// storing it). Row 2: TIME negative. Row 3: TIME past 24 hours (34h),
// exercising the day-count field `timeText` (binary.bit) folds into the hour.
fn insertTemporalRows(c: myConn) {
  c.exec(
    "insert into t5453temporal (id, d, t) values (0, '2026-09-11', '10:20:30.500000')",
    []Value(0),
  ) catch e {
    panic("insert row 0: ${e.message()}")
  }
  c.exec("insert into t5453temporal (id, d, t) values (1, '0000-00-00', '00:00:00')", []Value(0)) catch e {
    panic("insert row 1: ${e.message()}")
  }
  c.exec(
    "insert into t5453temporal (id, d, t) values (2, '2026-01-01', '-12:30:45.250000')",
    []Value(0),
  ) catch e {
    panic("insert row 2: ${e.message()}")
  }
  c.exec(
    "insert into t5453temporal (id, d, t) values (3, '2026-01-01', '34:00:00')",
    []Value(0),
  ) catch e {
    panic("insert row 3: ${e.message()}")
  }
}

fn checkTemporalRows(c: myConn) {
  let rows = liveQuery(
    c, "select id, d, t from t5453temporal where id >= $1 order by id", []Value{ Value.Int(0) },
  )
  checkOrdinaryDateTime(rows)
  checkZeroDate(rows)
  checkNegativeTime(rows)
  checkOver24HourTime(rows)
  assert(
    !(rows.next() catch e {
      panic("next: ${e.message()}")
    }),
    "more rows than expected",
  )
  rows.close()
}

fn checkOrdinaryDateTime(rows: Rows) {
  let more = rows.next() catch e {
    panic("next row 0: ${e.message()}")
  }
  assert(more, "row 0 missing")
  let d = mysqlDate("d", rows.value(1)) catch e {
    panic("row 0 date: ${e.message()}")
  }
  assert(d.toString() == "2026-09-11", "row 0 date = ${d.toString()}")
  let t = mysqlTime("t", rows.value(2)) catch e {
    panic("row 0 time: ${e.message()}")
  }
  let want = (10 * 3600 + 20 * 60 + 30) * 1000000000 + 500000000
  assert(t == want, "row 0 time = ${t}, want ${want}")
}

fn checkZeroDate(rows: Rows) {
  let more = rows.next() catch e {
    panic("next row 1: ${e.message()}")
  }
  assert(more, "row 1 missing")
  let failed = false
  let msg = ""
  let got = mysqlDate("d", rows.value(1)) catch e {
    failed = true
    msg = e.message()
    dummyDate()
  }
  assert(failed, "0000-00-00 did not error, decoded ${got.toString()}")
  assert(contains(msg, "d"), "the error does not name the column: ${msg}")
}

fn checkNegativeTime(rows: Rows) {
  let more = rows.next() catch e {
    panic("next row 2: ${e.message()}")
  }
  assert(more, "row 2 missing")
  let t = mysqlTime("t", rows.value(2)) catch e {
    panic("row 2 time: ${e.message()}")
  }
  let want = 0 - ((12 * 3600 + 30 * 60 + 45) * 1000000000 + 250000000)
  assert(t == want, "row 2 time = ${t}, want ${want}")
}

fn checkOver24HourTime(rows: Rows) {
  let more = rows.next() catch e {
    panic("next row 3: ${e.message()}")
  }
  assert(more, "row 3 missing")
  let t = mysqlTime("t", rows.value(2)) catch e {
    panic("row 3 time: ${e.message()}")
  }
  let want = 34 * 3600 * 1000000000
  assert(t == want, "row 3 time = ${t}, want ${want}")
}

test "mysqlOptDate/mysqlOptTime on NULL return None without erroring" {
  let d = mysqlOptDate("d", Value.Null) catch e {
    panic("mysqlOptDate(Null): ${e.message()}")
  }
  match (d) {
    None => {}
    Some(_) => panic("NULL date decoded as Some")
  }
  let t = mysqlOptTime("t", Value.Null) catch e {
    panic("mysqlOptTime(Null): ${e.message()}")
  }
  match (t) {
    None => {}
    Some(_) => panic("NULL time decoded as Some")
  }
}

test "mysqlDate/mysqlTime on a non-Text value fail naming the column" {
  let dFailed = false
  let dMsg = ""
  mysqlDate("d", Value.Int(5)) catch e {
    dFailed = true
    dMsg = e.message()
    dummyDate()
  }
  assert(dFailed, "an Int value was accepted as DATE text")
  assert(contains(dMsg, "d"), "the error does not name the column: ${dMsg}")

  let tFailed = false
  let tMsg = ""
  mysqlTime("t", Value.Int(5)) catch e {
    tFailed = true
    tMsg = e.message()
    0
  }
  assert(tFailed, "an Int value was accepted as TIME text")
  assert(contains(tMsg, "t"), "the error does not name the column: ${tMsg}")
}

// A placeholder `Date` for a `catch` arm that already recorded the failure —
// `pkg/postgres/temporal.test.bit`'s own `dummyDate` convention.
fn dummyDate(): Date {
  return date(1, 1, 1) catch e {
    panic("dummyDate: ${e.message()}")
  }
}
