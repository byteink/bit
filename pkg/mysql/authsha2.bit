// pkg/mysql/authsha2.bit — `caching_sha2_password`'s second half, and the one
// place this driver refuses to do something a server asked for.
//
// The plugin has two paths. The FAST path is the scramble in auth.bit, which the
// server can check against its in-memory cache of the password. The FULL path
// runs when the cache has no entry — after a server restart, or the first time a
// user connects — and sends THE PASSWORD ITSELF, protected only by an RSA public
// key the server hands over on the same connection.
//
// THAT KEY EXCHANGE IS IMPLEMENTED ONLY OVER TLS, and not as a preference.
// Fetching a public key from the party you are about to authenticate to, and
// trusting it because it arrived, is not a weaker rung on the same ladder: it is
// a key exchange with NO authentication, so a man in the middle sends its own
// key, decrypts the password, re-encrypts under the server's and forwards. The
// encryption buys nothing it does not also buy the attacker. Under TLS the key
// arrives over an authenticated channel and the property is real.
//
// Without TLS this driver therefore sends NOTHING further — no public-key
// request, no RSA operation — and fails naming TLS. The fast path is still
// tried first, so a cached password over a plain socket connects exactly as it
// does with any other client; only the full path is refused.

// The three bytes that can follow an AuthMoreData header in this plugin.
const sha2FastSuccess: int = 3
const sha2FullAuth: int = 4

// One AuthMoreData packet. `payload[0]` is the 0x01 header; `payload[1]` is the
// plugin's own byte.
//
// Returns true when the exchange is finished as far as this client is concerned
// and the next packet is the server's OK or ERR.
fn cachingSha2More(w: myWire, password: string, payload: string, tlsOn: bool): ()! {
  let what = sha2Status(payload)?
  if (what == sha2FastSuccess) {
    return
  }
  if (what != sha2FullAuth) {
    fail newError(
        "mysql: caching_sha2_password sent status byte ${what}, " +
        "which is neither fast_auth_success (3) nor perform_full_authentication (4)",
    )
  }
  if (!tlsOn) {
    fail newError(
        "mysql: the server requires caching_sha2_password full " +
        "authentication, which sends the password protected only by a public key " +
        "the server itself supplies — this driver performs that exchange over TLS " +
        "only, and this connection has none. Connect with TLS (drop ssl-mode=DISABLED, " +
        "or configure the server for TLS), or run 'ALTER USER ... IDENTIFIED WITH " +
        "caching_sha2_password BY ...' once while connected over TLS so the server " +
        "caches the password and the fast path applies",
    )
  }
  w.send(cstr(password))?
}

// The plugin's status byte, or a failure naming a packet too short to have one.
fn sha2Status(payload: string): int! {
  if (len(payload) < 2) {
    fail newError("mysql: caching_sha2_password sent an AuthMoreData packet " + "with no status byte")
  }
  return int([]byte(payload)[1])
}
