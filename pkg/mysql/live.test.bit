// pkg/mysql/live.test.bit — the acceptance that needs a real server (#3993).
//
// EACH TEST IS SKIPPED WHEN ITS URI IS UNSET, and says so. `test-package-mysql`
// runs on a machine with no database, so a hard dependency on one would make the
// gate unrunnable; the URIs are supplied by whoever has a server:
//
//   MY_TEST_MYSQL_URI      MySQL 8, caching_sha2_password, its auto-generated
//                          self-signed certificate
//   MY_TEST_MARIADB_URI    stock MariaDB, no TLS configured at all
//   MY_TEST_NATIVE_URI     an account created WITH mysql_native_password
//   MY_TEST_ED25519_URI    a MariaDB account created WITH ed25519
//   MY_TEST_STRICT_URI     any server with NO TLS, in a URI that pins
//                          ssl-mode=VERIFY_IDENTITY — this one must FAIL
//   MY_TEST_FIELDS_HOST    the same server as MY_TEST_MARIADB_URI, addressed by
//   MY_TEST_FIELDS_USER    individual fields with the port left 0
//   MY_TEST_FIELDS_PASSWORD
//   MY_TEST_FIELDS_DATABASE
//
// `pkg/mysql/README.md` has the `docker run` lines that produce them.
//
// The adapter is built with `newMyAdapter` rather than `adapter()` so these can
// read `warn.sslLines`/`warn.authLines` — the counts ARE the claim "one warning
// line per pool, not one per connection", and an `Adapter` has no fields.

import { pool } from "std/sql"
import { env } from "std/os"

// The URI under `name`, or "" — printed once so a skipped run is visible as a
// skip rather than as a silent pass.
fn liveUri(name: string): string {
  let uri = env(name)
  if (uri == "") {
    print("  skipped: ${name} is unset, no live server to talk to")
  }
  return uri
}

// Open a pool on `cfg`, run `select 1` `times` times, and assert every run
// returned the single row `1`. Returns the adapter so the caller can read its
// warning counts.
fn selectOne(cfg: Datasource, times: int): myAdapter {
  let a = newMyAdapter()
  let db = pool(a, cfg) catch e {
    panic("pool: ${e.message()}")
  }
  let i = 0
  while (i < times) {
    checkOne(
      db.query("select 1", []Value(0)) catch e {
        panic("select 1 (attempt ${i}): ${e.message()}")
      },
    )
    i = i + 1
  }
  db.close()
  return a
}

// Exactly one row, one column, the text `1`.
fn checkOne(rows: Rows) {
  let more = rows.next() catch e {
    panic("select 1 returned no row: ${e.message()}")
  }
  assert(more, "select 1 returned no row")
  let got = asText(rows.value(0)) catch e {
    panic("select 1 column 0: ${e.message()}")
  }
  assert(got == "1", "select 1 returned '${got}'")
  rows.close()
}

// One authenticated session, outside the pool, so a test can read what the
// server said about itself and which TLS rung was reached.
fn liveSession(uri: string): session {
  let t = parseUri(uri) catch e {
    panic("${uri}: ${e.message()}")
  }
  let sys = systemRoots() catch e {
    panic("systemRoots: ${e.message()}")
  }
  let s = openSession(t, newWarnOnce(), TrustStore{ roots: sys.roots }) catch e {
    panic("openSession(${uri}): ${e.message()}")
  }
  authenticate(s, t, newWarnOnce()) catch e {
    panic("authenticate(${uri}): ${e.message()}")
  }
  return s
}

// The failure `uri` produced, or "" when it connected — for the cases whose
// whole point is that they must not connect.
fn connectFailure(uri: string): string {
  let a = newMyAdapter()
  let c = a.connect(Datasource{ uri: uri }) catch e {
    return e.message()
  }
  c.close()
  return ""
}

test "live: a stock MariaDB with no TLS connects, warning once for ten connections" {
  let uri = liveUri("MY_TEST_MARIADB_URI")
  if (uri == "") {
    return
  }
  let a = selectOne(Datasource{ uri: uri }, 10)
  assert(a.warn.sslLines == 1, "ten connections emitted ${a.warn.sslLines} ssl-mode warning lines")
  assert(
    contains(a.warn.sslLine, "DISABLED"),
    "the warning does not name the mode: ${a.warn.sslLine}",
  )
}

test "live: MariaDB reports its family and a version of 10 or 11, never 5.5.5" {
  let uri = liveUri("MY_TEST_MARIADB_URI")
  if (uri == "") {
    return
  }
  let s = liveSession(uri)
  assert(s.info.family == "MariaDB", "family is ${s.info.family}")
  assert(s.info.versionMajor >= 10, "version major is ${s.info.versionMajor} (${s.info.version})")
  assert(!hasPrefix(s.info.version, "5.5.5"), "version reads ${s.info.version}")
  s.w.s.shut()
}

test "live: a Datasource of fields with port 0 connects exactly as the URI does" {
  let host = liveUri("MY_TEST_FIELDS_HOST")
  if (host == "") {
    return
  }
  let a = selectOne(
    Datasource{
      host: host, user: env("MY_TEST_FIELDS_USER"),
      password: env("MY_TEST_FIELDS_PASSWORD"),
      database: env("MY_TEST_FIELDS_DATABASE"),
    },
    1,
  )
  assert(a.warn.sslLines == 1, "the field form emitted ${a.warn.sslLines} ssl-mode lines")
}

test "live: MySQL 8 with its self-signed certificate connects one rung down, warning once" {
  let uri = liveUri("MY_TEST_MYSQL_URI")
  if (uri == "") {
    return
  }
  let a = selectOne(Datasource{ uri: uri }, 10)
  assert(a.warn.sslLines == 1, "ten connections emitted ${a.warn.sslLines} ssl-mode warning lines")
  assert(
    a.warn.authLines == 0,
    "caching_sha2_password emitted ${a.warn.authLines} auth warning lines",
  )
  let s = liveSession(uri)
  assert(s.tlsOn, "the connection is not encrypted")
  assert(s.mode != SslMode.VerifyFull, "a self-signed certificate verified at VERIFY_IDENTITY")
  assert(s.mode != SslMode.Disable, "a server offering TLS was downgraded to cleartext")
  assert(s.info.family == "MySQL", "family is ${s.info.family}")
  s.w.s.shut()
}

test "live: a URI pinning a strict ssl-mode against a server with no TLS fails" {
  let uri = liveUri("MY_TEST_STRICT_URI")
  if (uri == "") {
    return
  }
  let err = connectFailure(uri)
  assert(err != "", "a pinned VERIFY_IDENTITY connected to a server with no TLS")
  assert(contains(err, "rather than downgrading"), "message: ${err}")
}

test "live: mysql_native_password connects and warns once, naming the plugin" {
  let uri = liveUri("MY_TEST_NATIVE_URI")
  if (uri == "") {
    return
  }
  let a = selectOne(Datasource{ uri: uri }, 10)
  assert(a.warn.authLines == 1, "ten connections emitted ${a.warn.authLines} auth warning lines")
  assert(
    contains(a.warn.authLine, "mysql_native_password"),
    "the warning does not name the plugin: ${a.warn.authLine}",
  )
}

test "live: ed25519 connects to MariaDB and warns not at all" {
  let uri = liveUri("MY_TEST_ED25519_URI")
  if (uri == "") {
    return
  }
  let a = selectOne(Datasource{ uri: uri }, 1)
  assert(a.warn.authLines == 0, "ed25519 emitted ${a.warn.authLines} auth warning lines")
}

test "live: caching_sha2_password full authentication without TLS fails naming TLS" {
  let uri = liveUri("MY_TEST_SHA2_NOTLS_URI")
  if (uri == "") {
    return
  }
  let err = connectFailure(uri)
  assert(err != "", "full authentication completed with no TLS")
  assert(contains(err, "TLS"), "the refusal does not name TLS: ${err}")
}
