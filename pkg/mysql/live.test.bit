// pkg/mysql/live.test.bit — the acceptance that needs a real server (#3993).
//
// EACH TEST IS SKIPPED WHEN ITS URI IS UNSET, and says so. `test-package-mysql`
// runs on a machine with no database, so a hard dependency on one would make the
// gate unrunnable; the URIs are supplied by whoever has a server:
//
//   MY_TEST_MYSQL_URI      MySQL 8, caching_sha2_password, its auto-generated
//                          self-signed certificate
//   MY_TEST_MARIADB_URI    stock MariaDB 11.4, its auto-generated self-signed
//                          certificate
//   MY_TEST_NATIVE_URI     an account created WITH mysql_native_password
//   MY_TEST_ED25519_URI    a MariaDB account created WITH ed25519
//   MY_TEST_STRICT_URI     a server that never offers TLS (a MariaDB started
//                          with `--skip-ssl`, NOT a stock image — those have a
//                          certificate), in a URI that pins
//                          ssl-mode=VERIFY_IDENTITY — this one must FAIL, on
//                          the refusal to downgrade rather than on the
//                          certificate
//   MY_TEST_FIELDS_HOST    the same server as MY_TEST_MARIADB_URI, addressed by
//   MY_TEST_FIELDS_USER    individual fields with the port left 0
//   MY_TEST_FIELDS_PASSWORD
//   MY_TEST_FIELDS_DATABASE
//
// `pkg/mysql/README.md` has the `docker run` lines that produce them.
//
// The adapter is built with `newMyAdapter` rather than `adapter()` so these can
// read `warn.sslLines`/`warn.authLines` — the counts ARE the claim "one warning
// line per pool, not one per connection", and an `Adapter` has no fields.

import { pool, Pool } from "std/sql"
import { env } from "std/os"

// The URI under `name`, or "" — printed once so a skipped run is visible as a
// skip rather than as a silent pass.
fn liveUri(name: string): string {
  let uri = env(name)
  if (uri == "") {
    print("  skipped: ${name} is unset, no live server to talk to")
  }
  return uri
}

// Open a pool on `cfg`, run `select 1` `times` times, and assert every run
// returned the single row `1`. Returns the adapter so the caller can read its
// warning counts.
fn selectOne(cfg: Datasource, times: int): myAdapter {
  let a = newMyAdapter()
  let db = pool(a, cfg) catch e {
    panic("pool: ${e.message()}")
  }
  let i = 0
  while (i < times) {
    checkOne(
      db.query("select 1", []Value(0)) catch e {
        panic("select 1 (attempt ${i}): ${e.message()}")
      },
    )
    i = i + 1
  }
  db.close()
  return a
}

// Exactly one row, one column, the text `1`.
fn checkOne(rows: Rows) {
  let more = rows.next() catch e {
    panic("select 1 returned no row: ${e.message()}")
  }
  assert(more, "select 1 returned no row")
  let got = asText(rows.value(0)) catch e {
    panic("select 1 column 0: ${e.message()}")
  }
  assert(got == "1", "select 1 returned '${got}'")
  rows.close()
}

// One authenticated session, outside the pool, so a test can read what the
// server said about itself and which TLS rung was reached.
fn liveSession(uri: string): session {
  let t = parseUri(uri) catch e {
    panic("${uri}: ${e.message()}")
  }
  let sys = systemRoots() catch e {
    panic("systemRoots: ${e.message()}")
  }
  let s = openSession(t, newWarnOnce(), TrustStore{ roots: sys.roots }) catch e {
    panic("openSession(${uri}): ${e.message()}")
  }
  authenticate(s, t, newWarnOnce()) catch e {
    panic("authenticate(${uri}): ${e.message()}")
  }
  return s
}

// The failure `uri` produced, or "" when it connected — for the cases whose
// whole point is that they must not connect.
fn connectFailure(uri: string): string {
  let a = newMyAdapter()
  let c = a.connect(Datasource{ uri: uri }) catch e {
    return e.message()
  }
  c.close()
  return ""
}

test "live: a stock MariaDB connects one rung down, warning once for ten connections" {
  let uri = liveUri("MY_TEST_MARIADB_URI")
  if (uri == "") {
    return
  }
  let a = selectOne(Datasource{ uri: uri }, 10)
  assert(a.warn.sslLines == 1, "ten connections emitted ${a.warn.sslLines} ssl-mode warning lines")
  assert(
    contains(a.warn.sslLine, "REQUIRED"),
    "the warning does not name the mode: ${a.warn.sslLine}",
  )
}

test "live: MariaDB reports its family and a version of 10 or 11, never 5.5.5" {
  let uri = liveUri("MY_TEST_MARIADB_URI")
  if (uri == "") {
    return
  }
  let s = liveSession(uri)
  assert(s.info.family == "MariaDB", "family is ${s.info.family}")
  assert(s.info.versionMajor >= 10, "version major is ${s.info.versionMajor} (${s.info.version})")
  assert(!hasPrefix(s.info.version, "5.5.5"), "version reads ${s.info.version}")
  s.w.s.shut()
}

test "live: a Datasource of fields with port 0 connects exactly as the URI does" {
  let host = liveUri("MY_TEST_FIELDS_HOST")
  if (host == "") {
    return
  }
  let a = selectOne(
    Datasource{
      host: host, user: env("MY_TEST_FIELDS_USER"),
      password: env("MY_TEST_FIELDS_PASSWORD"),
      database: env("MY_TEST_FIELDS_DATABASE"),
    },
    1,
  )
  assert(a.warn.sslLines == 1, "the field form emitted ${a.warn.sslLines} ssl-mode lines")
}

test "live: MySQL 8 with its self-signed certificate connects one rung down, warning once" {
  let uri = liveUri("MY_TEST_MYSQL_URI")
  if (uri == "") {
    return
  }
  let a = selectOne(Datasource{ uri: uri }, 10)
  assert(a.warn.sslLines == 1, "ten connections emitted ${a.warn.sslLines} ssl-mode warning lines")
  assert(
    a.warn.authLines == 0,
    "caching_sha2_password emitted ${a.warn.authLines} auth warning lines",
  )
  let s = liveSession(uri)
  assert(s.tlsOn, "the connection is not encrypted")
  assert(s.mode != SslMode.VerifyFull, "a self-signed certificate verified at VERIFY_IDENTITY")
  assert(s.mode != SslMode.Disable, "a server offering TLS was downgraded to cleartext")
  assert(s.info.family == "MySQL", "family is ${s.info.family}")
  s.w.s.shut()
}

test "live: a URI pinning a strict ssl-mode against a server with no TLS fails" {
  let uri = liveUri("MY_TEST_STRICT_URI")
  if (uri == "") {
    return
  }
  let err = connectFailure(uri)
  assert(err != "", "a pinned VERIFY_IDENTITY connected to a server with no TLS")
  assert(contains(err, "rather than downgrading"), "message: ${err}")
}

test "live: mysql_native_password connects and warns once, naming the plugin" {
  let uri = liveUri("MY_TEST_NATIVE_URI")
  if (uri == "") {
    return
  }
  let a = selectOne(Datasource{ uri: uri }, 10)
  assert(a.warn.authLines == 1, "ten connections emitted ${a.warn.authLines} auth warning lines")
  assert(
    contains(a.warn.authLine, "mysql_native_password"),
    "the warning does not name the plugin: ${a.warn.authLine}",
  )
}

test "live: ed25519 connects to MariaDB and warns not at all" {
  let uri = liveUri("MY_TEST_ED25519_URI")
  if (uri == "") {
    return
  }
  let a = selectOne(Datasource{ uri: uri }, 1)
  assert(a.warn.authLines == 0, "ed25519 emitted ${a.warn.authLines} auth warning lines")
}

test "live: caching_sha2_password full authentication without TLS fails naming TLS" {
  let uri = liveUri("MY_TEST_SHA2_NOTLS_URI")
  if (uri == "") {
    return
  }
  let err = connectFailure(uri)
  assert(err != "", "full authentication completed with no TLS")
  assert(contains(err, "TLS"), "the refusal does not name TLS: ${err}")
}

// The rewriter's end-to-end acceptance (#3994): a `$1` reused twice must select
// exactly the rows the hand-written `?` form selects. The `?` form goes through
// `prepared`/`executeStmt` directly — the same COM_STMT_PREPARE/COM_STMT_EXECUTE
// path, with the rewriter as the only difference — so a mismatch can only be the
// rewriting.
fn liveConn(uri: string): myConn {
  let a = newMyAdapter()
  let c = a.connect(Datasource{ uri: uri }) catch e {
    panic("connect: ${e.message()}")
  }
  let (my, ok) = c.(myConn)
  assert(ok, "connect returned something other than a myConn")
  return my
}

// Every `id` in `rows`, in order, as one string to compare.
fn idsOf(rows: Rows): string {
  let out = ""
  let seen = 0
  while ((rows.next() catch e {
      panic("next: ${e.message()}")
    }) &&
    seen < 64) {
    seen = seen + 1
    match (rows.value(0)) {
      Int(n) => out = out + " ${n}"
      Text(s) => out = out + " ${s}"
      _ => panic("an id came back as neither Int nor Text")
    }
  }
  rows.close()
  return out
}

// Run `sqlText` on `c`, panicking with the statement on failure.
fn liveQuery(c: myConn, sqlText: string, params: []Value): Rows {
  return c.query(sqlText, params) catch e {
    panic("${sqlText}: ${e.message()}")
  }
}

test "a reused $1 selects exactly what the hand-written ? form selects" {
  let uri = liveUri("MY_TEST_MYSQL_URI")
  if (uri == "") {
    return
  }
  let c = liveConn(uri)
  c.exec("drop table if exists t3994", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.exec("create table t3994 (id int primary key, a varchar(8), b varchar(8))", []Value(0)) catch e {
    panic("create: ${e.message()}")
  }
  let inserted = c.exec(
    "insert into t3994 (id, a, b) values ($1, $2, $3), ($4, $5, $6), ($7, $8, $9)",
    []Value{
      Value.Int(1), Value.Text("x"), Value.Text("q"),
      Value.Int(2), Value.Text("q"), Value.Text("x"),
      Value.Int(3), Value.Text("q"), Value.Text("q"),
    },
  ) catch e {
    panic("insert: ${e.message()}")
  }
  assert(inserted == 3, "insert reported ${inserted} affected rows")
  let got = idsOf(
    liveQuery(
      c,
      "select id from t3994 where a = $1 or b = $1 order by id",
      []Value{ Value.Text("x") },
    ),
  )
  let st = prepared(c, "select id from t3994 where a = ? or b = ? order by id") catch e {
    panic("prepare: ${e.message()}")
  }
  let handWritten = executeStmt(c, st, []Value{ Value.Text("x"), Value.Text("x") }) catch e {
    panic("execute: ${e.message()}")
  }
  let want = idsOf(handWritten.rows)
  assert(got == want, "the rewritten form selected '${got}', the ? form '${want}'")
  assert(got == " 1 2", "the rewritten form selected '${got}', wanted ' 1 2'")
  c.exec("drop table t3994", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.close()
}

test "a duplicate key arrives as 1062 with its SQLSTATE, and a count mismatch sends nothing" {
  let uri = liveUri("MY_TEST_MYSQL_URI")
  if (uri == "") {
    return
  }
  let c = liveConn(uri)
  c.exec("drop table if exists t3994b", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.exec("create table t3994b (id int primary key)", []Value(0)) catch e {
    panic("create: ${e.message()}")
  }
  c.exec("insert into t3994b (id) values ($1)", []Value{ Value.Int(1) }) catch e {
    panic("insert: ${e.message()}")
  }
  let (code, state) = execFailure(c, "insert into t3994b (id) values ($1)", []Value{ Value.Int(1) })
  assert(code == 1062, "duplicate key reported code ${code}")
  assert(state == "23000", "duplicate key reported SQLSTATE '${state}'")
  let err = queryFailure(
    c,
    "select id from t3994b where id = $1 or id = $2",
    []Value{ Value.Int(1) },
  )
  assert(contains(err, "2 parameter") && contains(err, "1 value"), "count mismatch: ${err}")
  // The connection is still usable, which is the proof nothing was sent: a
  // half-sent statement would have desynced the packet stream.
  let ids = idsOf(liveQuery(c, "select id from t3994b where id = $1", []Value{ Value.Int(1) }))
  assert(ids == " 1", "the connection after a count mismatch returned '${ids}'")
  c.exec("drop table t3994b", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.close()
}

// The code and SQLSTATE of the error `sqlText` produced, or (0, "") when it ran.
fn execFailure(c: myConn, sqlText: string, params: []Value): (int, string) {
  c.exec(sqlText, params) catch e {
    let (my, ok) = e.(liveSqlError)
    if (!ok) {
      panic("a server error came back without a code: ${e.message()}")
    }
    return (my.errorCode(), my.sqlState())
  }
  return (0, "")
}

// The message `sqlText` failed with, or "" when it ran.
fn queryFailure(c: myConn, sqlText: string, params: []Value): string {
  let rows = c.query(sqlText, params) catch e {
    return e.message()
  }
  rows.close()
  return ""
}

// What a caller declares to read a MySQL error's number — the same shape
// `query.test.bit` asserts, here against a real server's ERR packet.
interface liveSqlError {
  message(): string,
  errorCode(): int,
  sqlState(): string,
}

// #5422: a DATETIME refusal used to leave the rest of that result set unread
// on the socket, so the NEXT query on the same connection parsed those
// leftover bytes as its own reply. Two tables with disjoint, known rows make
// a desync visible as a WRONG row rather than a second error: if the second
// query's reply is really the first one's undrained bytes, `idsOf` reads
// garbage or the wrong id, not " 2".
test "#5422: a DATETIME refusal drains its response, so the next query on the same connection is not desynced" {
  let uri = liveUri("MY_TEST_MARIADB_URI")
  if (uri == "") {
    return
  }
  let c = liveConn(uri)
  c.exec("drop table if exists t5422a", []Value(0)) catch e {
    panic("drop a: ${e.message()}")
  }
  c.exec("drop table if exists t5422b", []Value(0)) catch e {
    panic("drop b: ${e.message()}")
  }
  c.exec("create table t5422a (id int primary key, d datetime, tag varchar(8))", []Value(0)) catch e {
    panic("create a: ${e.message()}")
  }
  c.exec("create table t5422b (id int primary key, tag varchar(8))", []Value(0)) catch e {
    panic("create b: ${e.message()}")
  }
  c.exec(
    "insert into t5422a (id, d, tag) values (1, '2026-01-01 10:00:00', 'first')",
    []Value(0),
  ) catch e {
    panic("insert a: ${e.message()}")
  }
  c.exec("insert into t5422b (id, tag) values (2, 'second')", []Value(0)) catch e {
    panic("insert b: ${e.message()}")
  }
  let err = queryFailure(c, "select id, d, tag from t5422a where id = $1", []Value{ Value.Int(1) })
  assert(contains(err, "d") && contains(err, "TIMESTAMP"), "DATETIME refusal message: ${err}")
  // The SAME connection, not a fresh one: the proof is that this second,
  // unrelated query returns ITS OWN row rather than whatever the first
  // query's undrained bytes happen to parse as.
  let rows = liveQuery(c, "select id, tag from t5422b where id = $1", []Value{ Value.Int(2) })
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "the second query returned no row")
  let id = asInt(rows.value(0)) catch e {
    panic("id: ${e.message()}")
  }
  let tag = asText(rows.value(1)) catch e {
    panic("tag: ${e.message()}")
  }
  assert(id == 2, "the second query returned id ${id}, wanted 2")
  assert(tag == "second", "the second query returned tag '${tag}', wanted 'second'")
  rows.close()
  c.exec("drop table t5422a", []Value(0)) catch e {
    panic("drop a: ${e.message()}")
  }
  c.exec("drop table t5422b", []Value(0)) catch e {
    panic("drop b: ${e.message()}")
  }
  c.close()
}

// #5431: VARBINARY/BINARY arrive as type 253/254 (VAR_STRING/STRING) with a
// binary collation, not through the dedicated BLOB codes 249-252, so the old
// `blobKind` never fired for them and they decoded as `Value.Text`.
//
// ASCII bytes cannot tell `Value.Blob` from `Value.Text` apart: both variants
// carry the same bytes, so an all-ASCII payload would pass either way. `want`
// therefore includes a 0x00 (a valid Bit string byte, but a value no C-string
// based codec would round-trip) and 0x80/0xff (not valid UTF-8 on their own),
// so a wrong decode is either the wrong variant or corrupted bytes, not a
// coincidentally-equal string.
//
// `bl` is a real BLOB column (type 252, already inside `blobKind` before this
// fix) queried the same way, to prove the widened predicate did not stop
// matching the family it already covered.
test "#5431: VARBINARY decodes to Value.Blob with exact bytes, and BLOB still does too" {
  let uri = liveUri("MY_TEST_MARIADB_URI")
  if (uri == "") {
    return
  }
  let c = liveConn(uri)
  c.exec("drop table if exists t5431", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.exec(
    "create table t5431 (id int primary key, vb varbinary(16), bl blob)",
    []Value(0),
  ) catch e {
    panic("create: ${e.message()}")
  }
  let wantVarbinary = []byte{ 0x00, 0x41, 0xff, 0x80, 0x00, 0x42 }
  let wantBlob = []byte{ 0x00, 0x99, 0xc1, 0x80, 0x7a }
  c.exec(
    "insert into t5431 (id, vb, bl) values ($1, $2, $3)",
    []Value{ Value.Int(1), Value.Blob(wantVarbinary), Value.Blob(wantBlob) },
  ) catch e {
    panic("insert: ${e.message()}")
  }
  let rows = liveQuery(c, "select vb, bl from t5431 where id = $1", []Value{ Value.Int(1) })
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "select returned no row")
  match (rows.value(0)) {
    Blob(b) => assert(
      string(b) == string(wantVarbinary),
      "varbinary decoded to Value.Blob with the wrong bytes",
    )
    Text(_) => panic("varbinary(16) decoded to Value.Text, not Value.Blob (#5431)")
    _ => panic("varbinary(16) decoded to neither Value.Blob nor Value.Text")
  }
  match (rows.value(1)) {
    Blob(b) => assert(
      string(b) == string(wantBlob),
      "blob decoded to Value.Blob with the wrong bytes",
    )
    Text(_) => panic("blob decoded to Value.Text, not Value.Blob")
    _ => panic("blob decoded to neither Value.Blob nor Value.Text")
  }
  rows.close()
  c.exec("drop table t5431", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.close()
}

// #5587: `Conn.begin` sends a real `START TRANSACTION`/`COMMIT`/`ROLLBACK`, so
// `pool.tx` works against a real server rather than only against
// `pool.test.bit`'s stub. The three tests below are the acceptance for that
// fix.

// A pool on the live server, maxOpen 1 so a later query can only land on the
// exact connection a transaction just ran on, or a panic naming why not.
fn livePool(uri: string): Pool {
  return pool(newMyAdapter(), Datasource{ uri: uri, maxOpen: 1 }) catch e {
    panic("pool(${uri}): ${e.message()}")
  }
}

// A statement run for its effect, failing the test if the server refused it.
fn setUp(db: Pool, sqlText: string) {
  db.exec(sqlText, []Value(0)) catch e {
    panic("${sqlText}: ${e.message()}")
  }
}

test "live: pool.tx commits, visible from a second connection" {
  let uri = liveUri("MY_TEST_MARIADB_URI")
  if (uri == "") {
    return
  }
  let db = livePool(uri)
  setUp(db, "drop table if exists t5587_commit")
  setUp(db, "create table t5587_commit (id int primary key)")
  db.tx((t) => {
    t.exec("insert into t5587_commit (id) values (1)", []Value(0))?
  }) catch e {
    panic("tx: ${e.message()}")
  }
  // A second, independent connection: the commit must be durable, not just
  // visible on the connection that made it.
  let other = livePool(uri)
  let rows = other.query("select id from t5587_commit", []Value(0)) catch e {
    panic("select: ${e.message()}")
  }
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "the committed row is not visible from a second connection")
  rows.close()
  other.close()
  setUp(db, "drop table t5587_commit")
  db.close()
}

test "live: pool.tx rolls back on error, and the connection stays usable" {
  let uri = liveUri("MY_TEST_MARIADB_URI")
  if (uri == "") {
    return
  }
  let db = livePool(uri)
  setUp(db, "drop table if exists t5587_rollback")
  setUp(db, "create table t5587_rollback (id int primary key)")
  let boom = newError("t5587: rollback me")
  db.tx((t) => {
    t.exec("insert into t5587_rollback (id) values (1)", []Value(0))?
    fail boom
  }) catch e {
    assert(e.message() == boom.message(), "tx failed with the wrong error: ${e.message()}")
  }
  let rows = db.query("select id from t5587_rollback", []Value(0)) catch e {
    panic("select after rollback: ${e.message()}")
  }
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(!more, "the rolled-back row is visible")
  rows.close()
  checkOne(
    db.query("select 1", []Value(0)) catch e {
      panic("select 1 after rollback: ${e.message()}")
    },
  )
  setUp(db, "drop table t5587_rollback")
  db.close()
}

test "live: pool.txValue returns its value once committed" {
  let uri = liveUri("MY_TEST_MARIADB_URI")
  if (uri == "") {
    return
  }
  let db = livePool(uri)
  // A parameterless query goes out over the text protocol (COM_QUERY), which
  // answers every column as Value.Text regardless of its real type - the
  // same reason `checkOne` above reads "1" rather than asInt-ing it.
  let n = db.txValue<int>((t) => {
    let rows = t.query("select 42", []Value(0))?
    rows.next()?
    let v = asText(rows.value(0))?
    rows.close()
    return parseInt(v)?
  }) catch e {
    panic("txValue: ${e.message()}")
  }
  assert(n == 42, "txValue returned ${n}, not 42")
  db.close()
}
