// pkg/mysql/json.test.bit — `mysqlJson` proven against BOTH servers (#5453,
// epic #5449), because the whole point of this codec is the divergence
// between them: MariaDB's `JSON` is `LONGTEXT` (always text on the wire, on
// either protocol), MySQL's is a native type (MySQL's own binary tag format
// on the bound-parameter path, text on the parameterless one). Every live
// test below decodes the SAME stored document TWO independent ways from the
// SAME row — `mysqlJson` on the plain column, and `jsonParse` on
// `cast(col as char)` — and asserts they agree, the same non-self-referential
// proof `decimal.test.bit`'s live test uses.
import { jsonEncode } from "std/json"

// A document covering the acceptance's three traps: a nested object, a JSON
// `null` inside it, and a string value with an embedded `"`.
fn testDocument(): string {
  return "{\"outer\":{\"inner\":null,\"note\":\"has \\\"quotes\\\" in it\"},\"list\":[1,2,3]}"
}

test "mysqlJson decodes a MariaDB JSON (LONGTEXT) column matching cast(...as char)" {
  let uri = liveUri("MY_TEST_MARIADB_URI")
  if (uri == "") {
    return
  }
  checkJsonAgainstCast(uri, "t5453jsonmaria")
}

test "mysqlJson decodes a MySQL native JSON column matching cast(...as char), bound and parameterless" {
  let uri = liveUri("MY_TEST_MYSQL_URI")
  if (uri == "") {
    return
  }
  checkJsonAgainstCast(uri, "t5453jsonmysql")
  checkJsonTextProtocol(uri, "t5453jsonmysql2")
}

// Insert the test document, then read it back via the BOUND-parameter path
// (`where id = $1` forces COM_STMT_EXECUTE, binary protocol — MySQL's native
// tag format for a real `JSON` column, plain text for MariaDB's LONGTEXT
// one) and assert `mysqlJson`'s decode agrees with `jsonParse` on the
// server's own `cast(...as char)` rendering of the same row.
fn checkJsonAgainstCast(uri: string, table: string) {
  let c = liveConn(uri)
  c.exec("drop table if exists ${table}", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.exec("create table ${table} (id int primary key, doc json)", []Value(0)) catch e {
    panic("create: ${e.message()}")
  }
  c.exec("insert into ${table} (id, doc) values (1, $1)", []Value{ Value.Text(testDocument()) }) catch e {
    panic("insert: ${e.message()}")
  }
  let rows = liveQuery(
    c, "select doc, cast(doc as char) from ${table} where id = $1", []Value{ Value.Int(1) },
  )
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "no row")
  let binVal = mysqlJson("doc", rows.value(0)) catch e {
    panic("binary decode: ${e.message()}")
  }
  let textVal = mysqlJson("doc", rows.value(1)) catch e {
    panic("text decode: ${e.message()}")
  }
  rows.close()
  assertSameDocument(binVal, textVal, table)
  c.exec("drop table ${table}", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.close()
}

// The same document read back through a PARAMETERLESS query (COM_QUERY,
// always text — even for MySQL's native JSON, per `conn.bit`'s own rule)
// and asserted equal to the bound-parameter read, proving `mysqlJson`
// handles both wire shapes for the same server and column type.
fn checkJsonTextProtocol(uri: string, table: string) {
  let c = liveConn(uri)
  c.exec("drop table if exists ${table}", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.exec("create table ${table} (id int primary key, doc json)", []Value(0)) catch e {
    panic("create: ${e.message()}")
  }
  c.exec("insert into ${table} (id, doc) values (1, $1)", []Value{ Value.Text(testDocument()) }) catch e {
    panic("insert: ${e.message()}")
  }
  let bound = liveQuery(c, "select doc from ${table} where id = $1", []Value{ Value.Int(1) })
  let more1 = bound.next() catch e {
    panic("next (bound): ${e.message()}")
  }
  assert(more1, "no row (bound)")
  let binVal = mysqlJson("doc", bound.value(0)) catch e {
    panic("binary decode: ${e.message()}")
  }
  bound.close()

  let text = c.query("select doc from ${table}", []Value(0)) catch e {
    panic("query (text protocol): ${e.message()}")
  }
  let more2 = text.next() catch e {
    panic("next (text): ${e.message()}")
  }
  assert(more2, "no row (text)")
  let textVal = mysqlJson("doc", text.value(0)) catch e {
    panic("text-protocol decode: ${e.message()}")
  }
  text.close()
  assertSameDocument(binVal, textVal, table)
  c.exec("drop table ${table}", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.close()
}

fn assertSameDocument(a: Json, b: Json, label: string) {
  let ea = jsonEncode(a)
  let eb = jsonEncode(b)
  assert(ea == eb, "${label}: ${ea} != ${eb}")
  assert(contains(ea, "\"inner\":null"), "${label}: missing nested null: ${ea}")
  assert(contains(ea, "quotes"), "${label}: missing embedded-quote string: ${ea}")
}

test "mysqlJson on MariaDB LONGTEXT-style text decodes without a live server" {
  let got = mysqlJson("doc", Value.Text(testDocument())) catch e {
    panic("mysqlJson: ${e.message()}")
  }
  let re = jsonEncode(got)
  assert(contains(re, "\"inner\":null"), "missing nested null: ${re}")
  assert(contains(re, "quotes"), "missing embedded-quote string: ${re}")
}

test "mysqlOptJson on NULL returns None without erroring" {
  let got = mysqlOptJson("doc", Value.Null) catch e {
    panic("mysqlOptJson(Null): ${e.message()}")
  }
  match (got) {
    None => {}
    Some(_) => panic("NULL decoded as Some")
  }
}

test "mysqlJson on malformed text fails naming the column" {
  let failed = false
  let msg = ""
  mysqlJson("doc", Value.Text("{not json")) catch e {
    failed = true
    msg = e.message()
    Json.JsonNull
  }
  assert(failed, "malformed JSON text did not error")
  assert(contains(msg, "doc"), "the error does not name the column: ${msg}")
}

test "mysqlJson on a non-Text value fails naming the column" {
  let failed = false
  let msg = ""
  mysqlJson("doc", Value.Int(5)) catch e {
    failed = true
    msg = e.message()
    Json.JsonNull
  }
  assert(failed, "an Int value was accepted as JSON")
  assert(contains(msg, "doc"), "the error does not name the column: ${msg}")
}
