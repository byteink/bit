// pkg/mysql/begin.test.bit — what `begin` puts on the wire (#7437). A recording
// stream stands in for the server: it keeps every COM_QUERY text the client
// sends, in order, and answers each with an OK packet, so the claim is about the
// statements themselves and not about a flag that was set.

import { join } from "std/strings"

// A server that records the SQL of every COM_QUERY and says OK to all of them.
class recordingServer {
  out: string
  seq: int
  sent: []string
  readUp(n: int): string! {
    let take = n
    if (take > len(this.out)) {
      take = len(this.out)
    }
    let head = this.out[0:take]
    this.out = this.out[take:len(this.out)]
    return head
  }

  writeAll(s: string): ()! {
    this.seq = int([]byte(s)[3]) + 1
    let payload = s[4:len(s)]
    this.sent = append(this.sent, payload[1:len(payload)])
    // OK: header byte, affected rows, last insert id, status flags, warnings.
    this.out = this.out + framePacket(writeLe(0, 1) + writeLe(0, 6), this.seq)
  }

  shut() {}
}

fn recordedConn(s: recordingServer): myConn {
  return myConn{
    w = myWire{ r = myReader{ s = s, buf = "" }, s = s, seq = 0 },
    info = serverInfo{
      family = "mysql", version = "8.4.0", versionMajor = 8, capabilities = 0, scramble = "",
      plugin = "",
    },
    closed = false,
    cache = newStmtCache(0),
    ansi = false,
  }
}

// The statements a begin with `opts` sent, then `commit`, in order.
fn beginThenCommit(opts: TxOptions): []string {
  let s = recordingServer{ out = "", seq = 0, sent = []string(0) }
  let c = recordedConn(s)
  let t = c.begin(opts) catch e {
    panic("begin: ${e.message()}")
  }
  t.commit() catch e {
    panic("commit: ${e.message()}")
  }
  return s.sent
}

fn sameSql(got: []string, want: []string): bool {
  if (len(got) != len(want)) {
    return false
  }
  let i = 0
  while (i < len(got)) {
    if (got[i] != want[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

test "begin with no options is one START TRANSACTION, nothing before it" {
  let got = beginThenCommit(TxOptions{})
  assert(sameSql(got, ["START TRANSACTION", "COMMIT"]), "sent: ${join(got, " | ")}")
}

test "a level is set BEFORE START TRANSACTION, with no empty commit between" {
  let got = beginThenCommit(TxOptions{ isolation = Isolation.RepeatableRead })
  assert(
    sameSql(
      got,
      ["SET TRANSACTION ISOLATION LEVEL REPEATABLE READ", "START TRANSACTION", "COMMIT"],
    ),
    "sent: ${join(got, " | ")}",
  )
}

test "read-only is START TRANSACTION READ ONLY, and composes with a level" {
  let got = beginThenCommit(TxOptions{ isolation = Isolation.Serializable, readOnly = true })
  assert(
    sameSql(
      got,
      ["SET TRANSACTION ISOLATION LEVEL SERIALIZABLE", "START TRANSACTION READ ONLY", "COMMIT"],
    ),
    "sent: ${join(got, " | ")}",
  )
  let only = beginThenCommit(TxOptions{ readOnly = true })
  assert(sameSql(only, ["START TRANSACTION READ ONLY", "COMMIT"]), "sent: ${join(only, " | ")}")
}
