// 200 DECIMAL(29,9)-safe values, assembled from the three parts above.
fn decimalCorpus(): []string {
  let out = []string(0)
  for v of decimalCorpusA() {
    out = append(out, v)
  }
  for v of decimalCorpusB() {
    out = append(out, v)
  }
  for v of decimalCorpusC() {
    out = append(out, v)
  }
  return out
}

test "mysqlDecimal decodes a DECIMAL column matching cast(...as char), 200 values" {
  let uri = liveUri("MY_TEST_MARIADB_URI")
  if (uri == "") {
    return
  }
  let c = liveConn(uri)
  c.exec("drop table if exists t3995dec", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.exec("create table t3995dec (id int primary key, amount decimal(29,9))", []Value(0)) catch e {
    panic("create: ${e.message()}")
  }
  let corpus = decimalCorpus()
  let i = 0
  while (i < len(corpus)) {
    c.exec(
      "insert into t3995dec (id, amount) values ($1, $2)",
      []Value{ Value.Int(i), Value.Text(corpus[i]) },
    ) catch e {
      panic("insert row ${i} (${corpus[i]}): ${e.message()}")
    }
    i = i + 1
  }
  // A `$1` forces `query` down the COM_STMT_PREPARE/EXECUTE path (query.bit:
  // parameterless queries stay on COM_QUERY, text protocol) — the point of
  // this test is `amount`'s BINARY-protocol decode against `cast(...as
  // char)`'s own text, and `id >= 0` picks every row without narrowing the
  // result.
  let rows = liveQuery(
    c,
    "select id, amount, cast(amount as char) from t3995dec where id >= $1 order by id",
    []Value{ Value.Int(0) },
  )
  let checked = 0
  while (rows.next() catch e {
    panic("next: ${e.message()}")
  }) {
    let id = asInt(rows.value(0)) catch e {
      panic("id: ${e.message()}")
    }
    let binVal = mysqlDecimal("amount", rows.value(1)) catch e {
      panic("row ${id} binary decode: ${e.message()}")
    }
    let textVal = mysqlDecimal("amount", rows.value(2)) catch e {
      panic("row ${id} text decode: ${e.message()}")
    }
    assert(
      binVal == textVal,
      "row ${id} (${corpus[id]}): binary ${binVal} != cast-as-char ${textVal}",
    )
    checked = checked + 1
  }
  rows.close()
  assert(checked == len(corpus), "checked ${checked} of ${len(corpus)} rows")
  c.exec("drop table t3995dec", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.close()
}

test "a DECIMAL(10,2) column keeps 1.50 at scale 2, never collapsing to 1.5" {
  let uri = liveUri("MY_TEST_MARIADB_URI")
  if (uri == "") {
    return
  }
  let c = liveConn(uri)
  c.exec("drop table if exists t3995dec2", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.exec("create table t3995dec2 (amount decimal(10,2))", []Value(0)) catch e {
    panic("create: ${e.message()}")
  }
  c.exec("insert into t3995dec2 (amount) values ($1)", []Value{ Value.Text("1.50") }) catch e {
    panic("insert: ${e.message()}")
  }
  let rows = liveQuery(c, "select amount from t3995dec2 where 1 = $1", []Value{ Value.Int(1) })
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "no row")
  let got = mysqlDecimal("amount", rows.value(0)) catch e {
    panic("decode: ${e.message()}")
  }
  rows.close()
  assert("${got}" == "1.50", "1.50 round-tripped as '${got}'")
  c.exec("drop table t3995dec2", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.close()
}

test "a DECIMAL(65,30) value past Bit's decimal range errors naming the column" {
  let uri = liveUri("MY_TEST_MARIADB_URI")
  if (uri == "") {
    return
  }
  let c = liveConn(uri)
  c.exec("drop table if exists t3995dec3", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.exec("create table t3995dec3 (amount decimal(65,30))", []Value(0)) catch e {
    panic("create: ${e.message()}")
  }
  c.exec(
    "insert into t3995dec3 (amount) values ($1)",
    []Value{ Value.Text("12345678901234567890123456789012345.1234") },
  ) catch e {
    panic("insert: ${e.message()}")
  }
  let rows = liveQuery(c, "select amount from t3995dec3 where 1 = $1", []Value{ Value.Int(1) })
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "no row")
  let failed = false
  let msg = ""
  let got = mysqlDecimal("amount", rows.value(0)) catch e {
    failed = true
    msg = e.message()
    0
  }
  rows.close()
  assert(failed, "a 40-digit DECIMAL(65,30) value did not error, decoded ${got}")
  assert(contains(msg, "amount"), "the error does not name the column: ${msg}")
  c.exec("drop table t3995dec3", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.close()
}

test "mysqlDecimal on a non-Text value fails naming the column" {
  let failed = false
  let msg = ""
  let got = mysqlDecimal("amount", Value.Int(5)) catch e {
    failed = true
    msg = e.message()
    0
  }
  assert(failed, "an Int value was accepted as DECIMAL text, decoded ${got}")
  assert(contains(msg, "amount"), "the error does not name the column: ${msg}")
}

test "mysqlOptDecimal on NULL returns None without erroring" {
  let got = mysqlOptDecimal("amount", Value.Null) catch e {
    panic("mysqlOptDecimal(Null): ${e.message()}")
  }
  match (got) {
    None => {}
    Some(_) => panic("NULL decoded as Some")
  }
}
