// pkg/mysql/decimal.bit — the DECIMAL/NUMERIC codec (#3995).
//
// MySQL's binary protocol never gives DECIMAL a dedicated binary layout: it
// is one of the types `binary.bit`'s `binaryValue` falls through to the
// generic length-encoded string for (see that file's "EVERY TYPE NOT NAMED
// HERE" comment). So decoding is exactly `parseDecimal` (std/decimal, #3983)
// on the text the server already sent — there is no bespoke wire format here
// to get wrong, and this file owns none of the framing.
//
// PROVEN AGAINST THE SERVER'S OWN TEXT, NOT SELF-REFERENTIAL. `decimal.test.bit`'s
// live test requests the same column two ways from the same row — the plain
// binary value and `cast(col as char)` — and asserts this codec's decode of
// the first equals `parseDecimal` on the second, unparsed. A codec checked
// only against values it produced itself proves nothing (#3995's own words).
//
// OVERFLOW IS AN ERROR NAMING THE COLUMN, NEVER A SILENT ROUND. DECIMAL(65,30)
// exceeds Bit's 128-bit `decimal`; `parseDecimal` already refuses a value with
// more digits than the type holds (#3983), so this file adds nothing but the
// column name to that refusal — never a pre-round on write, never a truncation
// on read.
import { parseDecimal } from "std/decimal"

// The value of a DECIMAL/NUMERIC column named `col`. `v` must be `Value.Text`
// — every DECIMAL column decodes to one (binary.bit) — anything else is a
// caller passing the wrong column's value, not a server response this
// function can make sense of.
export fn mysqlDecimal(col: string, v: Value): decimal! {
  let s = asText(v) catch _ {
    fail newError("mysql: column '${col}' is not a DECIMAL/NUMERIC value")
  }
  return parseDecimal(s) catch e {
    fail newError("mysql: column '${col}': ${e.message()}")
  }
}

// As `mysqlDecimal`, but a SQL NULL decodes to `None` rather than failing —
// the shape every nullable-column accessor in this package follows.
export fn mysqlOptDecimal(col: string, v: Value): Option<decimal>! {
  if (isNull(v)) {
    return Option<decimal>.None
  }
  return Option<decimal>.Some(mysqlDecimal(col, v)?)
}
