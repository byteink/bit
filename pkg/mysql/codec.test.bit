// pkg/mysql/codec.test.bit — the rest of the type table, live (#3995):
// TIMESTAMP against a server whose OWN default is not UTC (proving the
// session override in adapter.bit actually does something), DATETIME's
// refusal, TINYINT(1) read both ways, and the two MariaDB-only types.
//
// TINYINT(1), FLOAT/DOUBLE/VARCHAR/BLOB and JSON need no dedicated codec
// (codec.bit's header explains why); the assertions below are still the
// acceptance's proof that each one decodes to the stated Bit type, not a
// claim about code that does not exist.

test "the type table: TIMESTAMP (against a non-UTC server default), DATETIME refusal, TINYINT(1), FLOAT/DOUBLE/VARCHAR/BLOB, MariaDB UUID and INET4" {
  let uri = liveUri("MY_TEST_MARIADB_URI")
  if (uri == "") {
    return
  }
  let c = liveConn(uri)
  c.exec("drop table if exists t3995types", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.exec(
      "create table t3995types (" +
      "id int primary key, ts timestamp, dt datetime, flag tinyint(1), " +
      "f float, d double, v varchar(16), b blob, j json, " +
      "u uuid, addr inet4, addr6 inet6)",
    []Value(0),
  ) catch e {
    panic("create: ${e.message()}")
  }
  // The epoch this row's TIMESTAMP names: 2023-11-14T22:13:20Z. Built with
  // from_unixtime, whose result is independent of the SERVER's default
  // time_zone (set to +05:00, below) and depends only on THIS session's —
  // which adapter.bit's connect() already pinned to +00:00, before this
  // test ever ran a statement.
  c.exec(
      "insert into t3995types (id, ts, dt, flag, f, d, v, b, j, u, addr, addr6) " +
      "values (1, from_unixtime($1), '2026-01-02 03:04:05', 1, 1.5, 2.5, " +
      "'hi', $2, '{\"k\":1}', uuid(), '10.0.0.1', '2001:db8::1')",
    []Value{ Value.Int(1700000000), Value.Blob([]byte("bytes")) },
  ) catch e {
    panic("insert: ${e.message()}")
  }
  checkTimestampAndScalars(c)
  checkTinyintBothWays(c)
  checkUuidAndInet(c)
  // Its own connection, last: this one asserts the refusal ITSELF (the
  // message names the column and TIMESTAMP), which needs nothing from `c`'s
  // state. `checkUuidAndInet` above already proved a DATETIME refusal on `c`
  // does not poison the next query on it (#5422).
  checkDatetimeRefusal(uri)
  c.exec("drop table t3995types", []Value(0)) catch e {
    panic("drop: ${e.message()}")
  }
  c.close()
}

// TIMESTAMP, FLOAT, DOUBLE, VARCHAR, BLOB, JSON — one row, one column each.
fn checkTimestampAndScalars(c: myConn) {
  let rows = liveQuery(
    c, "select ts, f, d, v, b, j from t3995types where id = $1", []Value{ Value.Int(1) },
  )
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "no row")
  let ts = mysqlInstant("ts", rows.value(0)) catch e {
    panic("ts: ${e.message()}")
  }
  assert(ts.ns == 1700000000 * 1000000000, "ts read ${ts.ns}ns, wanted the 1700000000s epoch")
  let f = asFloat(rows.value(1)) catch e {
    panic("f: ${e.message()}")
  }
  assert(f == 1.5, "float read ${f}")
  let d = asFloat(rows.value(2)) catch e {
    panic("d: ${e.message()}")
  }
  assert(d == 2.5, "double read ${d}")
  let v = asText(rows.value(3)) catch e {
    panic("v: ${e.message()}")
  }
  assert(v == "hi", "varchar read '${v}'")
  let b = asBlob(rows.value(4)) catch e {
    panic("b: ${e.message()}")
  }
  assert(string(b) == "bytes", "blob read '${string(b)}'")
  let j = asText(rows.value(5)) catch e {
    panic("j: ${e.message()}")
  }
  assert(contains(j, "\"k\""), "json read '${j}'")
  rows.close()
}

// TINYINT(1): the same column, read as bool and as i64 — "the field's type
// decides" is the caller's choice of accessor, not a guess from the width.
fn checkTinyintBothWays(c: myConn) {
  let rows = liveQuery(c, "select flag from t3995types where id = $1", []Value{ Value.Int(1) })
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "no row")
  let cols = rows.columns()
  let asBool = sqlReqBool(rows, cols, "flag") catch e {
    panic("bool: ${e.message()}")
  }
  assert(asBool, "TINYINT(1)=1 read as bool false")
  rows.close()
  let rows2 = liveQuery(c, "select flag from t3995types where id = $1", []Value{ Value.Int(1) })
  rows2.next() catch e {
    panic("next: ${e.message()}")
  }
  let asI64 = sqlReqInt(rows2, rows2.columns(), "flag") catch e {
    panic("int: ${e.message()}")
  }
  assert(asI64 == 1, "TINYINT(1)=1 read as i64 ${asI64}")
  rows2.close()
}

// DATETIME has no zone; the codec refuses it outright, naming the column
// and pointing at TIMESTAMP.
fn checkDatetimeRefusal(uri: string) {
  let c = liveConn(uri)
  let rows = c.query("select dt from t3995types where id = $1", []Value{ Value.Int(1) }) catch e {
    let msg = e.message()
    assert(contains(msg, "dt") && contains(msg, "TIMESTAMP"), "message: ${msg}")
    c.close()
    return
  }
  rows.close()
  c.close()
  panic("a DATETIME column decoded without error")
}

// MariaDB's native UUID, INET4 and INET6 — none needs a wire-level change
// (codec.bit's header), so this is `mysqlUuid` plus the unmapped-type rule.
//
// A DATETIME REFUSAL RUNS FIRST, ON THE SAME `c` (#5423). Prepared column
// definitions for UUID/INET4 used to read as `transport error: ... packet
// type 254`, which looked like a binary-protocol gap in MariaDB's extended
// column metadata for those two types. It was not: `t3995types` was queried
// through a DATETIME column earlier in this same test file's history, on
// the same connection, and that refusal (binary.bit's `binaryValue`) left
// its result set undrained (#5422) — the next bound statement's own reply
// was really the previous query's leftover bytes, and `254` is the first
// byte of an EOF packet. With #5422 fixed, the identical bound query below
// — preceded by a fresh DATETIME refusal on `c` to prove it — decodes UUID,
// INET4 and INET6 correctly, each followed by a column (`v`) whose value is
// known, so a wrong offset would be visible rather than merely "an error".
// INET6 is the only other MariaDB-only type this server ships; there is no
// third one to survey.
fn checkUuidAndInet(c: myConn) {
  let refusal = queryFailure(c, "select dt from t3995types where id = $1", []Value{ Value.Int(1) })
  assert(contains(refusal, "dt") && contains(refusal, "TIMESTAMP"), "datetime refusal: ${refusal}")
  let rows = liveQuery(
    c, "select u, addr, addr6, v from t3995types where id = $1", []Value{ Value.Int(1) },
  )
  let more = rows.next() catch e {
    panic("next: ${e.message()}")
  }
  assert(more, "no row")
  let u = mysqlUuid("u", rows.value(0)) catch e {
    panic("uuid: ${e.message()}")
  }
  assert(!uuidEquals(u, nilUUID()), "uuid() decoded as the nil UUID")
  let addr = asText(rows.value(1)) catch e {
    panic("inet4: ${e.message()}")
  }
  assert(addr == "10.0.0.1", "inet4 read '${addr}'")
  let addr6 = asText(rows.value(2)) catch e {
    panic("inet6: ${e.message()}")
  }
  assert(addr6 == "2001:db8::1", "inet6 read '${addr6}'")
  let v = asText(rows.value(3)) catch e {
    panic("the column after inet6: ${e.message()}")
  }
  assert(v == "hi", "the column after inet6 read '${v}', which is the offset #5423 named")
  rows.close()
  // The parameterless (text-protocol) form is not regressed by any of this.
  let rows2 = liveQuery(c, "select u, addr, addr6, v from t3995types where id = 1", []Value(0))
  let more2 = rows2.next() catch e {
    panic("next (text protocol): ${e.message()}")
  }
  assert(more2, "no row (text protocol)")
  rows2.close()
}
