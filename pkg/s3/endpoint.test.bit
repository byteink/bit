// pkg/s3/endpoint.test.bit — `resolveEndpoint` (endpoint.bit) against the
// operation inputs of the 393 endpoint tests of the S3 model: each case's
// built-in and client parameters become an `EndpointConfig`, its operation name
// and parameters an `EndpointInput`, and the URL, the backend, the auth schemes
// or the error text the walk gives must be what the case expects (a URL as
// `sdkUrl` in gen_endpoint.test.bit writes it).

class OperationVectors {
  passed: int,
  total: int,
  failures: []string,
}

fn flagOf(j: Json, key: string, dflt: bool): bool {
  return coalesce(jsonFlag(field(j, key)), dflt)
}

fn optionalFlagOf(j: Json, key: string): Option<bool> {
  return jsonFlag(field(j, key))
}

// The configuration of an operation input: its built-in parameters and client parameters.
fn inputConfig(oi: Json): EndpointConfig {
  let b = field(oi, "builtInParams")
  let c = field(oi, "clientParams")
  let cfg = defaultEndpointConfig()
  cfg.region = textOf(field(b, "AWS::Region"))
  cfg.endpoint = textOf(field(b, "SDK::Endpoint"))
  cfg.useFIPS = flagOf(b, "AWS::UseFIPS", false)
  cfg.useDualStack = flagOf(b, "AWS::UseDualStack", false)
  cfg.forcePathStyle = flagOf(b, "AWS::S3::ForcePathStyle", false)
  cfg.accelerate = flagOf(b, "AWS::S3::Accelerate", false)
  cfg.useGlobalEndpoint = flagOf(b, "AWS::S3::UseGlobalEndpoint", false)
  cfg.disableMultiRegionAccessPoints = flagOf(b, "AWS::S3::DisableMultiRegionAccessPoints", false)
  cfg.useArnRegion = optionalFlagOf(b, "AWS::S3::UseArnRegion")
  cfg.disableS3ExpressSessionAuth = optionalFlagOf(c, "DisableS3ExpressSessionAuth")
  return cfg
}

fn inputOf(oi: Json): EndpointInput {
  let p = field(oi, "operationParams")
  return EndpointInput{
    bucket = jsonText(field(p, "Bucket")),
    key = jsonText(field(p, "Key")),
    prefix = jsonText(field(p, "Prefix")),
    copySource = jsonText(field(p, "CopySource")),
  }
}

// "" when the walk of operation input `oi` of case `i` matches `want`, else what differed.
fn operationProblem(i: int, oi: Json, want: Json): string {
  let op = textOf(field(oi, "operationName"))
  let got = resolveEndpoint(inputConfig(oi), op, inputOf(oi)) catch e {
    if (e.message() == textOf(field(want, "error"))) {
      return ""
    }
    return "${op}: error ${e.message()}"
  }
  if (endpointOkFor(i, got, field(want, "endpoint"))) {
    return ""
  }
  return "${op}: got ${got.url} ${join(walkSchemes(got), " ")}"
}

test "every operation input of the S3 endpoint tests resolves to the expected endpoint" {
  let t = OperationVectors{ passed = 0, total = 0, failures = []string(0) }
  let i = 0
  for c of parsedCases() {
    for oi of jsonList(field(c, "operationInputs")) {
      let why = operationProblem(i, oi, field(c, "expect"))
      t.total = t.total + 1
      if (why == "") {
        t.passed = t.passed + 1
      } else {
        t.failures = append(t.failures, "${caseDoc(c)}: ${why}")
      }
    }
    i = i + 1
  }
  println("endpoint: ${t.passed} of ${t.total} operation inputs of the model endpoint tests")
  assert(t.total == 215, "215 operation inputs, saw ${t.total}")
  assert(len(t.failures) == 0, "failed: ${join(t.failures, "; ")}")
}

test "an operation's static context parameters override the client's and bind only what it has" {
  let cfg = defaultEndpointConfig()
  cfg.region = "us-west-2"
  cfg.disableS3ExpressSessionAuth = Option<bool>.Some(false)
  let input = EndpointInput{
    bucket = Option<string>.Some("b"),
    key = Option<string>.Some("k"),
    prefix = Option<string>.Some("p"),
    copySource = Option<string>.Some("c"),
  }
  let copy = endpointParamsFor(cfg, "CopyObject", input) catch e {
    panic("CopyObject: ${e.message()}")
  }
  assert(coalesce(copy.disableS3ExpressSessionAuth, false), "CopyObject turns session auth off")
  assert(
    isSet(copy.copySource) && isSet(copy.key) && !isSet(copy.prefix),
    "CopyObject binds Key and CopySource",
  )
  let create = endpointParamsFor(cfg, "CreateBucket", input) catch e {
    panic("CreateBucket: ${e.message()}")
  }
  assert(
    coalesce(create.useS3ExpressControlEndpoint, false),
    "CreateBucket uses the control endpoint",
  )
  assert(coalesce(create.disableAccessPoints, false), "CreateBucket disables access points")
  assert(!isSet(create.key) && !isSet(create.copySource), "CreateBucket binds only Bucket")
  let list = endpointParamsFor(cfg, "ListBuckets", input) catch e {
    panic("ListBuckets: ${e.message()}")
  }
  assert(!isSet(list.bucket), "ListBuckets binds no Bucket")
  assert(
    !coalesce(list.disableS3ExpressSessionAuth, true),
    "the client's session auth setting stays",
  )
  let none = endpointParamsFor(cfg, "NoSuchOperation", input) catch e {
    assert(e.message() == "s3: unknown operation NoSuchOperation", e.message())
    return
  }
  assert(false, "an unknown operation resolved, region ${coalesce(none.region, "")}")
}

test "an unset region is the rule set's error" {
  let r = resolveEndpoint(defaultEndpointConfig(), "ListBuckets", emptyEndpointInput()) catch e {
    assert(e.message() == "A region must be set when sending requests to S3.", e.message())
    return
  }
  assert(false, "resolved ${r.url} without a region")
}

test "the operation table holds the 112 operations of the model" {
  assert(len(endpointOperations) == 112, "operations ${len(endpointOperations)}")
}
