// pkg/s3/stsendpoint.bit — where STS requests go: the endpoint rules of the STS
// model (aws-sdk-js-v3 054298b1520fc45a7017966674a5ac3aa6f32a04,
// clients/client-sts/src/endpoint/bdd.ts) and the partition table they read
// (packages-internal/util-endpoints/src/lib/aws/partitions.json, version 1.1).
// sts.bit uses it; the S3 endpoint walker (#6623) replaces the partition table
// here with the generated one.

import { contains, hasPrefix, hasSuffix } from "std/strings"
import { mustCompile } from "std/regex"

// Where STS requests go, and the region the SigV4 signature is scoped to (the
// global endpoint is signed for us-east-1 whatever region the client has).
class StsEndpoint {
  url: string,
  signingRegion: string,
}

// One partition's DNS suffixes and the region it signs global services for
// (aws:packages-internal/util-endpoints/src/lib/aws/partitions.json, version
// 1.1). Every partition supports FIPS and dual stack.
class partitionInfo {
  id: string,
  pattern: string,
  dnsSuffix: string,
  dualStackDnsSuffix: string,
  implicitGlobalRegion: string,
}

fn partitionRow(
  id: string,
  pattern: string,
  dnsSuffix: string,
  dualStackDnsSuffix: string,
  implicitGlobalRegion: string,
): partitionInfo {
  return partitionInfo{
    id = id,
    pattern = pattern,
    dnsSuffix = dnsSuffix,
    dualStackDnsSuffix = dualStackDnsSuffix,
    implicitGlobalRegion = implicitGlobalRegion,
  }
}

fn partitions(): []partitionInfo {
  let out = publicPartitions()
  for p of restrictedPartitions() {
    out = append(out, p)
  }
  return out
}

fn publicPartitions(): []partitionInfo {
  let out = []partitionInfo(0)
  out = append(
    out,
    partitionRow(
      "aws",
      "^(us|eu|ap|sa|ca|me|af|il|mx)\\-\\w+\\-\\d+$",
      "amazonaws.com",
      "api.aws",
      "us-east-1",
    ),
  )
  out = append(
    out,
    partitionRow(
      "aws-cn",
      "^cn\\-\\w+\\-\\d+$",
      "amazonaws.com.cn",
      "api.amazonwebservices.com.cn",
      "cn-northwest-1",
    ),
  )
  out = append(
    out,
    partitionRow(
      "aws-eusc",
      "^eusc\\-(de)\\-\\w+\\-\\d+$",
      "amazonaws.eu",
      "api.amazonwebservices.eu",
      "eusc-de-east-1",
    ),
  )
  return out
}

fn restrictedPartitions(): []partitionInfo {
  let out = []partitionInfo(0)
  out = append(
    out,
    partitionRow(
      "aws-iso",
      "^us\\-iso\\-\\w+\\-\\d+$",
      "c2s.ic.gov",
      "api.aws.ic.gov",
      "us-iso-east-1",
    ),
  )
  out = append(
    out,
    partitionRow(
      "aws-iso-b",
      "^us\\-isob\\-\\w+\\-\\d+$",
      "sc2s.sgov.gov",
      "api.aws.scloud",
      "us-isob-east-1",
    ),
  )
  out = append(
    out,
    partitionRow(
      "aws-iso-e",
      "^eu\\-isoe\\-\\w+\\-\\d+$",
      "cloud.adc-e.uk",
      "api.cloud-aws.adc-e.uk",
      "eu-isoe-west-1",
    ),
  )
  out = append(
    out,
    partitionRow(
      "aws-iso-f",
      "^us\\-isof\\-\\w+\\-\\d+$",
      "csp.hci.ic.gov",
      "api.aws.hci.ic.gov",
      "us-isof-south-1",
    ),
  )
  out = append(
    out,
    partitionRow(
      "aws-us-gov",
      "^us\\-gov\\-\\w+\\-\\d+$",
      "amazonaws.com",
      "api.aws",
      "us-gov-west-1",
    ),
  )
  return out
}

// The partition id of the `*-global` pseudo regions the regex does not match,
// "" for any other region.
fn globalRegionPartition(region: string): string {
  if (region == "aws-global") {
    return "aws"
  }
  if (hasPrefix(region, "aws-") && hasSuffix(region, "-global")) {
    return region[0:len(region) - 7]
  }
  return ""
}

// `aws.partition(region)`: a `*-global` pseudo region by name, else the first
// partition whose regex matches, else the `aws` partition.
fn partitionOf(region: string): partitionInfo {
  let all = partitions()
  let named = globalRegionPartition(region)
  for p of all {
    if (p.id == named || (named == "" && mustCompile(p.pattern).matches(region))) {
      return p
    }
  }
  return all[0]
}

// The regions the endpoint rules send to the global endpoint when the legacy
// switch `useGlobalEndpoint` is on (bdd.ts conditions 7 to 23).
fn legacyGlobalRegion(region: string): bool {
  let names = ",aws-global,eu-central-1,ap-south-1,eu-north-1,eu-west-1,eu-west-2,eu-west-3,sa-east-1,us-east-1,us-east-2,us-west-2,us-west-1,ca-central-1,ap-southeast-1,ap-northeast-1,ap-southeast-2,"
  return region != "" && contains(names, "," + region + ",")
}

// A custom endpoint is `http(s)://host[:port][/]`: the SDK sends the request to
// that URL as it is, and this client builds its request line from the host, so a
// path would be dropped without a word. Refused instead. Returns the endpoint
// without a trailing slash.
fn checkCustomEndpoint(endpoint: string): string! {
  let rest = ""
  if (hasPrefix(endpoint, "https://")) {
    rest = endpoint[8:len(endpoint)]
  } else if (hasPrefix(endpoint, "http://")) {
    rest = endpoint[7:len(endpoint)]
  } else {
    fail newError("s3: sts: endpoint must start with http:// or https://")
  }
  let bare = rest
  if (hasSuffix(rest, "/")) {
    bare = rest[0:len(rest) - 1]
  }
  if (bare == "" ||
    contains(bare, "/") ||
    contains(bare, "?") ||
    contains(bare, "#") ||
    contains(bare, "@")) {
    fail newError("s3: sts: endpoint must be a scheme and a host with an optional port, no path, query or credentials")
  }
  return endpoint[0:len(endpoint) - (len(rest) - len(bare))]
}

// A custom endpoint is taken as it is; the rules refuse it next to FIPS or dual
// stack. The signing region stays the client's.
fn customEndpoint(url: string, region: string, useFips: bool, useDualStack: bool): StsEndpoint! {
  if (useFips) {
    fail newError("s3: sts: FIPS and a custom endpoint are not supported together")
  }
  if (useDualStack) {
    fail newError("s3: sts: dual stack and a custom endpoint are not supported together")
  }
  return StsEndpoint{ url = checkCustomEndpoint(url)?, signingRegion = region }
}

// FIPS and dual stack pick the host; the partition picks the suffix. A FIPS
// endpoint in GovCloud is the ordinary one.
fn hostedEndpoint(region: string, useFips: bool, useDualStack: bool): string {
  let p = partitionOf(region)
  if (useFips && useDualStack) {
    return "https://sts-fips.${region}.${p.dualStackDnsSuffix}"
  }
  if (useFips && p.id == "aws-us-gov") {
    return "https://sts.${region}.amazonaws.com"
  }
  if (useFips) {
    return "https://sts-fips.${region}.${p.dnsSuffix}"
  }
  if (useDualStack) {
    return "https://sts.${region}.${p.dualStackDnsSuffix}"
  }
  return "https://sts.${region}.${p.dnsSuffix}"
}

// The endpoint rules of the STS model (endpoint/bdd.ts), in the order they
// decide. Fails on the combinations the rules reject. A custom endpoint needs no
// region here; `StsClient` asks for one anyway, it scopes the signature.
fn resolveStsEndpoint(
  region: string,
  custom: Option<string>,
  useFips: bool,
  useDualStack: bool,
  useGlobalEndpoint: bool,
): StsEndpoint! {
  match (custom) {
    Some(url) => return customEndpoint(url, region, useFips, useDualStack)?
    None => {}
  }
  if (region == "") {
    fail newError("s3: sts: a region is required")
  }
  let plain = !useFips && !useDualStack
  if (plain && (region == "aws-global" || (useGlobalEndpoint && legacyGlobalRegion(region)))) {
    return StsEndpoint{ url = "https://sts.amazonaws.com", signingRegion = "us-east-1" }
  }
  return StsEndpoint{ url = hostedEndpoint(region, useFips, useDualStack), signingRegion = region }
}
