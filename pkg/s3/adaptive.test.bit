  [0.0000000025, 0.0],
  [0.000000005, 0.00000001],
  [0.00000001, 0.00000001],
  [0.000000015, 0.00000001],
  [0.5, 0.5],
  [7.0, 7.0],
  [10.45328452, 10.45328452],
  [36.425998525, 36.42599852],
  [13.103080969303846, 13.10308097],
  [6.096286773681641, 6.09628677],
  [12.649669647216797, 12.64966965],
  [19.917621612548828, 19.91762161],
  [13.589229583740234, 13.58922958],
  [13.462467193603516, 13.46246719],
  [3.453960418701172, 3.45396042],
  [17.66344130039215, 17.6634413],
