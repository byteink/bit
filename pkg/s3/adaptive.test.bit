  [-1.005, -1.005],
  [-36.425998525, -36.42599852],
]

test "precise rounds as toFixed(8) does: every vector exact" {
  let ok = 0
  for v of preciseVectors {
    let got = precise(v[0])
    if (got == v[1]) {
      ok = ok + 1
    } else {
      println("precise(${v[0]}) = ${got}, want ${v[1]}")
    }
  }
  println("precise vectors: ${ok} of ${len(preciseVectors)}")
  assert(ok == len(preciseVectors), "precise ${ok} of ${len(preciseVectors)}")
  assert(precise(0.0) == 0.0, "zero")
  let nan = precise(0.0 / 0.0)
  assert(nan != nan, "NaN stays NaN")
}

test "nothing is limited before the first throttling answer" {
  let tick = adAt(0)
  let lim = adLimiter(tick)
  let sleeps = 0
  lim.sleeper = (ns: int) => {
    sleeps = sleeps + 1
    tick.ns = tick.ns + ns
  }
  let i = 0
  while (i < 50) {
    tick.ns = tick.ns + 20 * Millisecond
    lim.updateClientSendingRate(false)
    lim.getSendToken()
    i = i + 1
  }
  assert(!lim.active(), "still off after 50 successes")
  assert(sleeps == 0, "no waits, got ${sleeps}")
  tick.ns = tick.ns + 20 * Millisecond
  lim.updateClientSendingRate(true)
  assert(lim.active(), "on after a throttling answer")
}

test "the fill rate never drops below 0.5 and the bucket keeps one token of room" {
  let tick = adAt(0)
  let lim = adLimiter(tick)
  let i = 0
  let low = 1000.0
  while (i < 200) {
    tick.ns = tick.ns + 10 * Millisecond
    lim.updateClientSendingRate(true)
    if (lim.fillRate < low) {
      low = lim.fillRate
    }
    assert(lim.maxCapacity >= 1.0, "capacity ${lim.maxCapacity}")
    assert(lim.availableTokens <= lim.maxCapacity, "tokens above capacity")
    i = i + 1
  }
  assert(low == 0.5, "floor reached and held: ${low}")
}

test "acquire never leaves a negative balance after a sleep" {
  let tick = adAt(0)
  let lim = adLimiter(tick)
  tick.ns = 1000 * Millisecond
  lim.updateClientSendingRate(true)
  lim.availableTokens = 0.1
  lim.fillRate = 10.0
  lim.lastTimestamp = 1.0
  lim.sleeper = (ns: int) => {
    tick.ns = tick.ns + 200 * Millisecond
  }
  lim.getSendToken()
  assert(lim.availableTokens >= 0.0, "tokens ${lim.availableTokens}")
}

test "acquire loops when the fill rate falls during the sleep" {
  let tick = adAt(0)
  let lim = adLimiter(tick)
  tick.ns = 1000 * Millisecond
  lim.updateClientSendingRate(true)
  lim.availableTokens = 0.0
  lim.fillRate = 10.0
  lim.maxCapacity = 10.0
  lim.lastTimestamp = 1.0
  let calls = 0
  lim.sleeper = (ns: int) => {
    calls = calls + 1
    tick.ns = tick.ns + 50 * Millisecond
    if (calls == 1) {
      lim.fillRate = 0.5
      lim.maxCapacity = 1.0
    }
  }
  lim.getSendToken()
  assert(calls > 1, "one sleep was not enough, got ${calls}")
  assert(lim.availableTokens >= 0.0, "tokens ${lim.availableTokens}")
}

test "acquire refills once after its sleep and takes the token" {
  let tick = adAt(0)
  let lim = adLimiter(tick)
  tick.ns = 1000 * Millisecond
  lim.updateClientSendingRate(true)
  lim.availableTokens = 0.0
  lim.fillRate = 2.0
  lim.maxCapacity = 2.0
  lim.lastTimestamp = 1.0
  let slept: []int = []
  lim.sleeper = (ns: int) => {
    slept = append(slept, ns)
    tick.ns = tick.ns + 600 * Millisecond
  }
  lim.getSendToken()
  assert(len(slept) == 1, "one sleep, got ${len(slept)}")
  assert(slept[0] == 500 * Millisecond, "half a second for one token at 2 a second: ${slept[0]}")
  assert(adNear(lim.availableTokens, 0.2), "1.2 earned, 1 taken: ${lim.availableTokens}")
}

test "a clock that steps back earns no tokens" {
  let tick = adAt(0)
  let lim = adLimiter(tick)
  tick.ns = 5000 * Millisecond
  lim.updateClientSendingRate(true)
  lim.availableTokens = 0.5
  lim.fillRate = 2.0
  lim.lastTimestamp = 5.0
  tick.ns = 4000 * Millisecond
  lim.refill(4.0)
  assert(lim.availableTokens == 0.5, "tokens ${lim.availableTokens}")
}

fn adRefused(
  beta: f64,
  minCapacity: f64,
  minFillRate: f64,
  scaleConstant: f64,
  smooth: f64,
): string {
  RateLimiter(RateLimiterOptions(beta, minCapacity, minFillRate, scaleConstant, smooth)) catch e {
    return e.message()
  }
  return ""
}

test "refused options: 9 of 9 name the option, and the defaults are accepted" {
  let nan = 0.0 / 0.0
  let cases: []string = [
    adRefused(0.0, 1.0, 0.5, 0.4, 0.8),
    adRefused(1.0, 1.0, 0.5, 0.4, 0.8),
    adRefused(nan, 1.0, 0.5, 0.4, 0.8),
    adRefused(0.7, 0.5, 0.5, 0.4, 0.8),
    adRefused(0.7, 1.0, 0.0, 0.4, 0.8),
    adRefused(0.7, 1.0, 0.5, 0.0, 0.8),
    adRefused(0.7, 1.0, 0.5, 0.4, 0.0),
    adRefused(0.7, 1.0, 0.5, 0.4, 1.5),
    adRefused(0.7, 1.0, -1.0, 0.4, 0.8),
  ]
  let names: []string = [
    "beta",
    "beta",
    "beta",
    "minCapacity",
    "minFillRate",
    "scaleConstant",
    "smooth",
    "smooth",
    "minFillRate",
  ]
  let ok = 0
  let i = 0
  while (i < len(cases)) {
    if (contains(cases[i], names[i])) {
      ok = ok + 1
    }
    i = i + 1
  }
  println("refused options: ${ok} of ${len(cases)}")
  assert(ok == len(cases), "refused ${ok} of ${len(cases)}")
  assert(adRefused(0.7, 1.0, 0.5, 0.4, 0.8) == "", "the SDK's defaults")
  assert(adRefused(0.5, 2.0, 0.25, 0.2, 1.0) == "", "other valid values")
}

// --- in the strategy ----------------------------------------------------------

// An adaptive strategy whose limiter runs on `tick`, with every sleep logged in
// `log` ("token" for the limiter's wait, "delay" for the retry's).
fn adStrategy(tick: AdTick, maxAttempts: int, log: AdLog): RetryStrategy {
  let lim = adLimiter(tick)
  let s = RetryStrategy(RetryMode.Adaptive, maxAttempts) catch _ {
    panic("strategy")
  }
  s.limiter = lim
  s.random = () => 0.0
  s.clock = () => 1000 * Second
  s.sleeper = (ns: int) => {
    log.items = append(log.items, "delay")
  }
  lim.sleeper = (ns: int) => {
    log.items = append(log.items, "token")
    tick.ns = tick.ns + ns
  }
  return s
}

test "adaptive mode is a RetryMode of the one strategy, standard never touches the limiter" {
  let tick = adAt(0)
  let lim = adLimiter(tick)
  let s = RetryStrategy(RetryMode.Standard, 5) catch _ {
    panic("strategy")
  }
  s.limiter = lim
  s.sleeper = (ns: int) => {}
  let call = s.begin()
  tick.ns = 500 * Millisecond
  call.decide(errOf("SlowDown", 503))
  call.pause(1)
  call.succeeded()
  assert(!lim.active(), "standard mode left the limiter off")
  assert(lim.measuredTxRate == 0.0, "and unmeasured")
  assert(s.mode == RetryMode.Standard, "mode")
  let a = RetryStrategy(RetryMode.Adaptive) catch _ {
    panic("strategy")
  }
  assert(a.mode == RetryMode.Adaptive, "mode")
  assert(a.maxAttempts == 3, "default attempts")
}

test "a throttled failure switches the limiter on before the decision and the retry waits for a token first" {
  let tick = adAt(0)
  let log = AdLog{ items = [] }
  let s = adStrategy(tick, 5, log)
  let call = s.begin()
  tick.ns = 500 * Millisecond
  let step = call.decide(errOf("SlowDown", 503))
  assert(isRetry(step), "throttling is retried")
  assert(adLim(s).active(), "limiter on")
  assert(adNear(adLim(s).rate(), 1.12), "rate ${adLim(s).rate()}")
  call.pause(delayOf(step))
  assert(
    len(log.items) == 2 && log.items[0] == "token" && log.items[1] == "delay",
    "order of ${len(log.items)} sleeps",
  )
}

test "the limiter hears every failed attempt, even the one that ends the call" {
  let tick = adAt(0)
  let log = AdLog{ items = [] }
  let s = adStrategy(tick, 2, log)
  let call = s.begin()
  tick.ns = 500 * Millisecond
  assert(isRetry(call.decide(errOf("SlowDown", 503))), "first retry")
  tick.ns = 700 * Millisecond
  let before = adLim(s).requestCount + adLim(s).measuredTxRate
  assert(
    stopsWith(call.decide(errOf("SlowDown", 503)), StopReason.AttemptsExhausted),
    "attempts spent",
  )
  assert(
    adLim(s).requestCount + adLim(s).measuredTxRate != before,
    "the last failure was counted",
  )
  let t2 = adAt(0)
  let s2 = adStrategy(t2, 5, log)
  let c2 = s2.begin()
  t2.ns = 500 * Millisecond
  c2.decide(errOf("AccessDenied", 403))
  assert(!adLim(s2).active(), "a client error is not throttling")
  assert(adLim(s2).requestCount + adLim(s2).measuredTxRate > 0.0, "but it is an attempt")
}

test "a body that cannot be replayed never reaches the limiter" {
  let tick = adAt(0)
  let log = AdLog{ items = [] }
  let s = adStrategy(tick, 5, log)
  let call = s.begin()
  tick.ns = 500 * Millisecond
  assert(stopsWith(call.decide(errOf("SlowDown", 503), false), StopReason.NotReplayable), "refused")
  assert(!adLim(s).active(), "limiter untouched")
  assert(adLim(s).requestCount == 0.0, "no attempt counted")
}

test "a success moves the rate up the curve and begin takes a token once throttled" {
  let tick = adAt(0)
  let log = AdLog{ items = [] }
  let s = adStrategy(tick, 5, log)
  let first = s.begin()
  assert(len(log.items) == 0, "off: begin does not wait")
  tick.ns = 500 * Millisecond
  first.decide(errOf("SlowDown", 503))
  let atThrottle = adLim(s).rate()
  tick.ns = 4000 * Millisecond
  first.succeeded()
  // Measured: 2 requests in the 4 s since the start, smoothed to 0.54857143;
  // the climb is capped at twice that.
  assert(adNear(atThrottle, 1.12), "at the throttle ${atThrottle}")
  assert(adNear(adLim(s).rate(), 1.09714286), "after the success ${adLim(s).rate()}")
  assert(adNear(adLim(s).lastMaxRate, 1.6), "the throttle's rate is kept")
  let second = s.begin()
  assert(second.attempt() == 1, "a fresh call")
  adLim(s).availableTokens = 0.0
  adLim(s).lastTimestamp = f64(tick.ns) / f64(Second)
  let third = s.begin()
  assert(
    len(log.items) == 1 && log.items[0] == "token",
    "begin waited for its token: ${len(log.items)} sleeps",
  )
  assert(third.attempt() == 1, "fresh")
}

// One task: take send tokens.
fn adHammer(lim: RateLimiter, rounds: int, done: chan<int>) {
  let i = 0
  while (i < rounds) {
    lim.getSendToken()
    i = i + 1
  }
  done <- rounds
}

test "tasks sharing a starved limiter all get their tokens and never overdraw" {
  let lim = RateLimiter() catch _ {
    panic("limiter")
  }
  lim.updateClientSendingRate(true)
  lim.fillRate = 4000.0
  lim.maxCapacity = 4000.0
  lim.availableTokens = 0.0
  let tasks = 8
  let done = chan<int>(tasks)
  let i = 0
  while (i < tasks) {
    spawn adHammer(lim, 25, done)
    i = i + 1
  }
  let total = 0
  let j = 0
  while (j < tasks) {
    total = total + <- done
    j = j + 1
  }
  assert(total == 200, "tokens taken ${total}")
  assert(
    lim.availableTokens >= 0.0 && lim.availableTokens <= lim.maxCapacity,
    "tokens ${lim.availableTokens}",
  )
}

// --- a limiter of the caller's own (#6845) ------------------------------------

// A `SendLimiter` that only counts: tokens asked for, answers heard and how many
// of them were throttling ones.
class AdCount {
  sends: int
  updates: int
  throttles: int

  getSendToken() {
    this.sends = this.sends + 1
  }

  updateClientSendingRate(throttling: bool) {
    this.updates = this.updates + 1
    if (throttling) {
      this.throttles = this.throttles + 1
    }
  }
}

fn adCounter(): AdCount {
  return AdCount{ sends = 0, updates = 0, throttles = 0 }
}

fn adCounted(mode: RetryMode, limiter: SendLimiter): RetryStrategy {
  let s = RetryStrategy(mode, 5, limiter = limiter) catch _ {
    panic("strategy")
  }
  s.random = () => 0.0
  s.clock = () => 1000 * Second
  s.sleeper = (ns: int) => {}
  return s
}

test "a limiter given to the strategy gets one token per attempt and one update per response" {
  let c = adCounter()
  let s = adCounted(RetryMode.Adaptive, c)
  let call = s.begin()
  assert(c.sends == 1 && c.updates == 0, "attempt 1 took its token: ${c.sends} sends")
  let step = call.decide(errOf("SlowDown", 503))
  assert(isRetry(step), "throttling is retried")
  assert(c.updates == 1 && c.throttles == 1, "heard the throttle: ${c.updates} updates")
  call.pause(delayOf(step))
  assert(c.sends == 2, "attempt 2 took its token: ${c.sends} sends")
  let step2 = call.decide(errOf("InternalError", 500))
  assert(isRetry(step2), "a server error is retried")
  assert(
    c.updates == 2 && c.throttles == 1,
    "an error that is not throttling: ${c.updates} updates",
  )
  call.pause(delayOf(step2))
  call.succeeded()
  assert(
    c.sends == 3 && c.updates == 3 && c.throttles == 1,
    "${c.sends} sends, ${c.updates} updates",
  )
  let denied = s.begin()
  denied.decide(errOf("AccessDenied", 403))
  assert(c.sends == 4 && c.updates == 4, "the answer that ends a call is heard too")
  let body = s.begin()
  body.decide(errOf("SlowDown", 503), false)
  assert(c.sends == 5 && c.updates == 4, "a body that cannot be sent again is never an answer")
}

test "standard mode never asks the limiter it was given" {
  let c = adCounter()
  let s = adCounted(RetryMode.Standard, c)
  let call = s.begin()
  call.pause(delayOf(call.decide(errOf("SlowDown", 503))))
  call.succeeded()
  assert(c.sends == 0 && c.updates == 0, "${c.sends} sends, ${c.updates} updates")
  s.limiter.getSendToken()
  assert(c.sends == 1, "and the strategy holds the very object")
}

test "a strategy without a limiter option builds its own, one each" {
  let a = adCounted(RetryMode.Adaptive, nil)
  let b = adCounted(RetryMode.Adaptive, nil)
  assert(a.limiter != nil && b.limiter != nil, "both have one")
  assert(adLim(a).rate() == 0.5 && !adLim(a).active(), "with the SDK's constants, off")
  adLim(a).updateClientSendingRate(true)
  assert(adLim(a).active() && !adLim(b).active(), "not the same one")
}

test "one limiter given to two strategies hears both of their throttles" {
  let c = adCounter()
  let a = adCounted(RetryMode.Adaptive, c)
  let b = adCounted(RetryMode.Adaptive, c)
  let ca = a.begin()
  let cb = b.begin()
  ca.decide(errOf("SlowDown", 503))
  assert(c.throttles == 1, "first client's throttle")
  cb.decide(errOf("SlowDown", 503))
  assert(c.throttles == 2, "second client's throttle")
  cb.succeeded()
  assert(
    c.sends == 2 && c.updates == 3 && c.throttles == 2,
    "${c.sends} sends, ${c.updates} updates",
  )
}

test "the built-in limiter shared by two strategies is cut by either one's throttle" {
  let tick = adAt(0)
  let shared = adLimiter(tick)
  shared.sleeper = (ns: int) => {
    tick.ns = tick.ns + ns
  }
  let a = adCounted(RetryMode.Adaptive, shared)
  let b = adCounted(RetryMode.Adaptive, shared)
  let ca = a.begin()
  tick.ns = 500 * Millisecond
  assert(!shared.active(), "nothing throttled yet")
  ca.decide(errOf("SlowDown", 503))
  assert(shared.active(), "the first client's throttle switched it on")
  assert(adNear(shared.rate(), 1.12), "rate ${shared.rate()}")
  let cb = b.begin()
  tick.ns = 1000 * Millisecond
  let before = shared.rate()
  cb.decide(errOf("SlowDown", 503))
  assert(shared.rate() < before, "the second client's throttle cut it again: ${shared.rate()}")
  assert(shared.requestCount + shared.measuredTxRate > 0.0, "and both attempts were measured")
}
