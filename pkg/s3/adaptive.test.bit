// pkg/s3/adaptive.test.bit — #6587. The adaptive retry mode: the CUBIC rate
// limiter and its place in `RetryStrategy`.
//
// Vectors are the SDK's own, copied from smithy-typescript commit
// 5d104567b7180c8a4055eb2f04c91854026a01c2, packages/core/src/submodules/retry/
// util-retry/DefaultRateLimiter.spec.ts: the `getSendToken` delays, the
// `cubicSuccess` and `cubicThrottle` tables, the 17-row `updateClientSendingRate`
// sequence and the three "acquireTokenBucket re-checks after sleep" cases. The
// wiring cases follow AdaptiveRetryStrategy.spec.ts in the same directory (the
// limiter is told before the retry decision, a send token is taken after it, a
// success tells the limiter) and middleware-retry/retryMiddleware.ts (a body
// that cannot be replayed never reaches the strategy). The spec's clock is
// `Date.now()` in milliseconds; here a fake nanosecond clock reads the same
// instants. @aws-sdk/client-s3 3.1146.0 is aws-sdk-js-v3 054298b1520f.
//
// `precise` is checked against `parseFloat(x.toFixed(8))` run in Node on the
// values listed in `preciseVectors`.

import { contains } from "std/strings"
import { Millisecond, Second } from "std/time"

// 1e-9, the tolerance the vectors are held to.
const adTol: f64 = 0.000000001

// Sleeps in the order they happened.
class AdLog {
  items: []string,
}

// The clock a test moves by hand.
class AdTick {
  ns: int,
}

fn adAt(ms: int): AdTick {
  return AdTick{ ns = ms * Millisecond }
}

fn adAbs(x: f64): f64 {
  if (x < 0.0) {
    return -x
  }
  return x
}

fn adNear(got: f64, want: f64): bool {
  return adAbs(got - want) <= adTol
}

// A limiter built at time 0 on `tick`, as the spec builds one with `Date.now()`
// mocked to 0.
fn adLimiter(tick: AdTick): RateLimiter {
  return RateLimiter(clock = () => tick.ns) catch _ {
    panic("limiter")
  }
}

// The built-in limiter behind a strategy's `limiter`, for the tests that read
// its state.
fn adLim(s: RetryStrategy): RateLimiter {
  return s.limiter.(RateLimiter)
}

// `parseFloat(x.toFixed(6))`, for rows the spec states to 6 decimals.
fn adSix(x: f64): f64 {
  return f64(int(x * 1000000.0 + 0.5)) / 1000000.0
}

// ms, expected delay in ms (the number the spec passes to setTimeout).
const delayVectors: [][]f64 = [
  [500.0, 892.8571428571428],
  [1000.0, 1785.7142857142856],
  [2000.0, 2000.0],
]

test "getSendToken delays: 3 of 3 as the SDK's setTimeout arguments" {
  let ok = 0
  for v of delayVectors {
    let tick = adAt(0)
    let lim = adLimiter(tick)
    tick.ns = int(v[0]) * Millisecond
    lim.updateClientSendingRate(true)
    let waitMs = lim.tryTake(1.0)
    if (adNear(waitMs, v[1])) {
      ok = ok + 1
    }
  }
  println("getSendToken delays: ${ok} of ${len(delayVectors)}")
  assert(ok == len(delayVectors), "delays ${ok} of ${len(delayVectors)}")
}

test "getSendToken sleeps the delay in whole nanoseconds, rounded up" {
  let tick = adAt(0)
  let lim = adLimiter(tick)
  let slept: []int = []
  lim.sleeper = (ns: int) => {
    slept = append(slept, ns)
    tick.ns = tick.ns + ns
  }
  tick.ns = 500 * Millisecond
  lim.updateClientSendingRate(true)
  lim.getSendToken()
  assert(len(slept) == 1, "one sleep, got ${len(slept)}")
  // 892.8571428571428 ms is 892857142.857 ns.
  assert(slept[0] == 892857143, "slept ${slept[0]} ns")
}

// timestamp (s), the SDK's calculatedRate.
const successVectors: [][]f64 = [
  [5.0, 7.0],
  [6.0, 9.64893601],
  [7.0, 10.00003085],
  [8.0, 10.45328452],
  [9.0, 13.40869703],
  [10.0, 21.26626836],
  [11.0, 36.42599853],
]

test "cubicSuccess: 7 of 7 as the SDK's table" {
  let ok = 0
  for v of successVectors {
    let tick = adAt(0)
    let lim = adLimiter(tick)
    lim.lastMaxRate = 10.0
    lim.lastThrottleTime = 5.0
    let got = lim.calculate(v[0], false)
    if (adNear(got, v[1])) {
      ok = ok + 1
    }
  }
  println("cubicSuccess: ${ok} of ${len(successVectors)}")
  assert(ok == len(successVectors), "cubicSuccess ${ok} of ${len(successVectors)}")
}

const throttleVectors: [][]f64 = [
  [5.0, 0.112],
  [6.0, 0.09333333],
  [7.0, 0.08],
  [8.0, 0.07],
  [9.0, 0.06222222],
]

test "cubicThrottle: 5 of 5 as the SDK's table" {
  let ok = 0
  for v of throttleVectors {
    let tick = adAt(0)
    let lim = adLimiter(tick)
    lim.lastMaxRate = 10.0
    lim.lastThrottleTime = 5.0
    let got = lim.calculate(v[0], true)
    if (adNear(got, v[1])) {
      ok = ok + 1
    }
  }
  println("cubicThrottle: ${ok} of ${len(throttleVectors)}")
  assert(ok == len(throttleVectors), "cubicThrottle ${ok} of ${len(throttleVectors)}")
}

// throttled, ms, measuredTxRate, fillRate (to 6 decimals).
const sequence: [][]f64 = [
  [0.0, 200.0, 0.0, 0.5],
  [0.0, 400.0, 0.0, 0.5],
  [0.0, 600.0, 4.8, 0.5],
  [0.0, 800.0, 4.8, 0.5],
  [0.0, 1000.0, 4.16, 0.5],
  [0.0, 1200.0, 4.16, 0.6912],
  [0.0, 1400.0, 4.16, 1.0976],
  [0.0, 1600.0, 5.632, 1.6384],
  [0.0, 1800.0, 5.632, 2.3328],
  [1.0, 2000.0, 4.3264, 3.02848],
  [0.0, 2200.0, 4.3264, 3.486639],
  [0.0, 2400.0, 4.3264, 3.821874],
  [0.0, 2600.0, 5.66528, 4.053386],
  [0.0, 2800.0, 5.66528, 4.200373],
  [0.0, 3000.0, 4.333056, 4.282037],
  [1.0, 3200.0, 4.333056, 2.997426],
  [0.0, 3400.0, 4.333056, 3.452226],
]

test "updateClientSendingRate: 17 of 17 steps of the SDK's sequence" {
  let tick = adAt(0)
  let lim = adLimiter(tick)
  let ok = 0
  for row of sequence {
    tick.ns = int(row[1]) * Millisecond
    lim.updateClientSendingRate(row[0] == 1.0)
    if (adNear(lim.measuredTxRate, row[2]) && adNear(adSix(lim.fillRate), row[3])) {
      ok = ok + 1
    }
  }
  println("updateClientSendingRate: ${ok} of ${len(sequence)}")
  assert(ok == len(sequence), "sequence ${ok} of ${len(sequence)}")
}

// x, parseFloat(x.toFixed(8)) from Node: exact binary ties, values whose text
// ends in 5, a spread of rates, and magnitudes where 1e-8 steps are finer than
// the doubles themselves.
