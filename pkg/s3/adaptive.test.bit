  [15.87792158126831, 15.87792158],
  [3.8442015647888184, 3.84420156],
  [57987.15651035309, 57987.15651035],
  [23376.20258331299, 23376.20258331],
  [20894.840359687805, 20894.84035969],
  [78757.3516368866, 78757.35163689],
  [40000000.87130642, 40000000.87130642],
  [60000000.00000001, 60000000.00000001],
