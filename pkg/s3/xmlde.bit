// pkg/s3/xmlde.bit — what the generated XML response deserializers
// (gen_xmlde_*.bit, #6628) read: the document, then elements, attributes and
// scalars as typed values, on std/xml's element tree.
//
// Rules every deserializer shares, so they are written once, here:
//
//   - An element the model does not name is never read, so an unknown element
//     is ignored wherever it sits.
//   - A scalar that does not parse (an integer, a boolean, a timestamp) fails
//     naming the element; it is never read as zero or as unset.
//   - A string is the element's text exactly as sent. Nothing is trimmed: an
//     object key may start or end with a space.
//   - An absent element is `None`. A present empty element is a value: `""`, an
//     empty list, an empty map.
//   - Names match by local name in any namespace: S3 sends its default
//     namespace, a compatible server may send none.

import { Element, parse } from "std/xml"
import { parseInt } from "std/strings"
import { Timestamp, parseEpochSeconds, parseHttpDate, parseRfc3339 } from "std/time"

// The root element of the response body. A body that is not well-formed XML
// fails with the parser's reason; an empty body has no root and fails too.
fn xmlRoot(h: ResponseHead): Element! {
  return parse([]byte(h.text)) catch e {
    fail newError("response body is not valid XML: ${e.message()}")
  }
}

// An element's text, as a string.
fn xmlStr(e: Element): string! {
  return e.text()
}

fn xmlInt(e: Element): int! {
  let s = e.text()
  return parseInt(s) catch _ {
    fail newError("element ${e.local}: \"${s}\" is not an integer")
  }
}

// `true` or `false`, nothing else.
fn xmlBool(e: Element): bool! {
  let s = e.text()
  if (s == "true") {
    return true
  }
  if (s == "false") {
    return false
  }
  fail newError("element ${e.local}: \"${s}\" is not true or false")
}

// A timestamp in RFC 3339 `date-time` form, the Smithy default of an XML body.
fn xmlDateTime(e: Element): Timestamp! {
  let s = e.text()
  return parseRfc3339(s) catch _ {
    fail newError("element ${e.local}: \"${s}\" is not an RFC 3339 date-time")
  }
}

fn xmlEpoch(e: Element): Timestamp! {
  let s = e.text()
  return parseEpochSeconds(s) catch _ {
    fail newError("element ${e.local}: \"${s}\" is not epoch seconds")
  }
}

fn xmlHttpDate(e: Element): Timestamp! {
  let s = e.text()
  return parseHttpDate(s) catch _ {
    fail newError("element ${e.local}: \"${s}\" is not an HTTP date")
  }
}

// The first child element of `e` read by `read`, None when there is none.
fn xmlOpt<T>(e: Element, name: string, read: (Element) => T!): Option<T>! {
  match (e.child(name)) {
    Some(c) => return Option.Some(read(c)?)
    None => return Option.None
  }
}

// An unwrapped output's root read by `read`, None when the root has no text:
// GetBucketLocation answers `<LocationConstraint/>` for us-east-1, and the
// SDK leaves LocationConstraint undefined there rather than an empty value.
fn xmlRootOpt<T>(e: Element, read: (Element) => T!): Option<T>! {
  if (e.text() == "") {
    return Option.None
  }
  return Option.Some(read(e)?)
}

// An enum child: the wire text through `parse`, which never fails (a value the
// model does not name becomes the enum's `Unknown`).
fn xmlEnum<T>(e: Element, name: string, parse: (string) => T): Option<T> {
  match (e.child(name)) {
    Some(c) => return Option.Some(parse(c.text()))
    None => return Option.None
  }
}

// A member the model requires and has no zero value for: absent is a failure
// naming `at`, never a made-up value.
fn xmlNeed<T>(o: Option<T>, at: string): T! {
  match (o) {
    Some(v) => return v
    None => fail newError("${at}: the element is missing")
  }
}

// Every child named `name`, each read by `read`, in document order.
fn xmlItems<T>(e: Element, name: string, read: (Element) => T!): []T! {
  let out = []T(0)
  for c of e.children(name) {
    out = append(out, read(c)?)
  }
  return out
}

// A wrapped list: the child `name` holding the items named `item`. None when
// the wrapper is absent, empty when it is present and holds no item.
fn xmlList<T>(e: Element, name: string, item: string, read: (Element) => T!): Option<[]T>! {
  match (e.child(name)) {
    Some(c) => return Option.Some(xmlItems(c, item, read)?)
    None => return Option.None
  }
}

// A flattened list: the children named `name` are the items. None when there
// is no such child.
fn xmlFlat<T>(e: Element, name: string, read: (Element) => T!): Option<[]T>! {
  let items = xmlItems(e, name, read)?
  if (len(items) == 0) {
    return Option.None
  }
  return Option.Some(items)
}

// One `entry` of a map: its `key` and `value` children, both required.
fn xmlEntry<V>(c: Element, key: string, value: string, read: (Element) => V!): (string, V)! {
  let k = xmlNeed(xmlOpt(c, key, xmlStr)?, "map entry ${c.local}: key ${key}")?
  let v = xmlNeed(xmlOpt(c, value, read)?, "map entry ${c.local}: value ${value}")?
  return (k, v)
}

// The map held by `entries` elements, each with a `key` and a `value`. A key
// that repeats keeps the last value.
fn xmlPairs<V>(
  entries: []Element,
  key: string,
  value: string,
  read: (Element) => V!,
): map<string, V>! {
  let m = map<string, V>()
  for c of entries {
    let (k, v) = xmlEntry(c, key, value, read)?
    m[k] = v
  }
  return m
}

// A wrapped map: the children `entry` of `e` itself (the reader of a map shape).
fn xmlMap<V>(e: Element, key: string, value: string, read: (Element) => V!): map<string, V>! {
  return xmlPairs(e.children("entry"), key, value, read)?
}

// A flattened map: the children named `name` are the entries. None when there
// is no such child.
fn xmlFlatMap<V>(
  e: Element,
  name: string,
  key: string,
  value: string,
  read: (Element) => V!,
): Option<map<string, V>>! {
  let entries = e.children(name)
  if (len(entries) == 0) {
    return Option.None
  }
  return Option.Some(xmlPairs(entries, key, value, read)?)
}

// The attribute `local` in namespace `space` ("" for none) as its text.
fn xmlAttr(e: Element, local: string, space: string): Option<string> {
  return e.attr(local, space)
}

// An enum attribute, as `xmlEnum` reads a child.
fn xmlAttrEnum<T>(e: Element, local: string, space: string, parse: (string) => T): Option<T> {
  match (e.attr(local, space)) {
    Some(s) => return Option.Some(parse(s))
    None => return Option.None
  }
}

// The first child element of a union's element, the member that is set.
fn xmlFirst(e: Element): Element! {
  for n of e.nodes {
    match (n) {
      Elem(c) => return c
      Text(_) => {}
    }
  }
  fail newError("element ${e.local}: a union holds no member")
}
