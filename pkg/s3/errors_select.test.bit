test "SELECT Object Content: 111 of 111 source rows map to the exact kind, status and retry class" {
  assert(
    len(selectErrorReferenceRows) == 111,
    "SELECT source rows: ${len(selectErrorReferenceRows)} of 111",
  )
  for row of selectErrorReferenceRows {
    assertSourceError(row.code, row.kind, row.status, row.retry)
  }
  println("SELECT Object Content: 111 of 111 source rows")
}
