// pkg/s3/credentials.bit — who the client signs as: the credential value, the
// `Credentials` choice a `Client` is configured with, the environment provider
// and the expiring cache every provider sits behind.
//
// Rules this file keeps, for a process that runs unattended:
//   - A mistake in a hand-written credential (empty key, a trailing newline
//     read from a secrets file, an empty session token) fails when the value
//     is built, never as a signature the server rejects at 02:00.
//   - The secret and the session token appear in no error text and in no
//     `show()`; a credential prints as its access key id only.
//   - Concurrent callers during a refresh share ONE provider call and its
//     outcome (single flight). A caller holding still-valid credentials is
//     not made to wait behind a refresh somebody else is running.
//   - Expiry follows the AWS SDK for JS v3 (`memoizeIdentityProvider`,
//     EXPIRATION_MS): credentials are refreshed once they expire within five
//     minutes. When that refresh fails and the credentials in hand have not
//     expired yet, they are served and the next call tries again.

import { env } from "std/os"
import { Mutex } from "std/sync"
import { Minute, Timestamp, now, parseRfc3339 } from "std/time"

// The environment variables `envCredentials` reads (the SDK's fromEnv).
const envKey: string = "AWS_ACCESS_KEY_ID"
const envSecret: string = "AWS_SECRET_ACCESS_KEY"
const envSession: string = "AWS_SESSION_TOKEN"
const envExpiration: string = "AWS_CREDENTIAL_EXPIRATION"
const envAccount: string = "AWS_ACCOUNT_ID"

// Credentials are refreshed once they expire within this window, nanoseconds
// (SDK EXPIRATION_MS = 300_000).
const refreshWindow: int = 5 * Minute

// A bound strictly larger than any `expiration - now` a real credential has,
// standing for "never expires".
const neverExpires: int = 9223372036854775807

fn hasEdgeSpace(b: []byte): bool {
  let first = b[0]
  let last = b[len(b) - 1]
  return first == ' ' || last == ' '
}

fn hasControl(b: []byte): bool {
  let i = 0
  while (i < len(b)) {
    if (b[i] < 0x20 || b[i] == 0x7f) {
      return true
    }
    i = i + 1
  }
  return false
}

// Fails when `v` could not travel in a signed header intact. Names the field,
// never quotes the value: it is a secret or sits next to one.
fn checkField(field: string, v: string): ()! {
  if (v == "") {
    fail newError("s3: credentials: ${field} must not be empty")
  }
  let b = []byte(v)
  if (hasControl(b)) {
    fail newError("s3: credentials: ${field} contains a control character (a trailing newline from a file?)")
  }
  if (hasEdgeSpace(b)) {
    fail newError("s3: credentials: ${field} has leading or trailing whitespace")
  }
}

fn checkOptional(field: string, v: Option<string>): ()! {
  match (v) {
    Some(s) => checkField(field, s)?
    None => return
  }
}

// One resolved identity: the access key, its secret and, for temporary
// credentials, a session token and the instant they expire. Built with
// `AwsCredential(accessKeyId = ..., secretAccessKey = ...)`, which fails on a
// malformed value. The secret and the token have no accessor outside this
// package; `sigV4Config` hands them to the signer.
export class AwsCredential {
  export accessKeyId: string
  secretAccessKey: string
  sessionToken: Option<string>
  export expiration: Option<Timestamp>
  export accountId: Option<string>

  // Fails with a message naming the field when `accessKeyId` or
  // `secretAccessKey` is empty, or any text field has a control character or
  // leading/trailing whitespace, or an optional text is given empty.
  init(
    accessKeyId: string,
    secretAccessKey: string,
    sessionToken: Option<string> = Option.None,
    expiration: Option<Timestamp> = Option.None,
    accountId: Option<string> = Option.None,
  )! {
    checkField("accessKeyId", accessKeyId)?
    checkField("secretAccessKey", secretAccessKey)?
    checkOptional("sessionToken", sessionToken)?
    checkOptional("accountId", accountId)?
    this.accessKeyId = accessKeyId
    this.secretAccessKey = secretAccessKey
    this.sessionToken = sessionToken
    this.expiration = expiration
    this.accountId = accountId
  }

  // The access key id only, so a credential in a log line or an error
  // message leaks nothing a signature does not already carry.
  export show(): string {
    return "AwsCredential(${this.accessKeyId})"
  }

  // The signer's view of this credential for `region` and `service` ("s3",
  // "s3express", "s3-object-lambda"). S3 always signs `x-amz-content-sha256`.
  export sigV4Config(region: string, service: string = "s3"): SigV4Config {
    return SigV4Config{
      accessKeyId = this.accessKeyId,
      secretKey = this.secretAccessKey,
      sessionToken = this.token(),
      region = region,
      service = service,
      contentSha256Header = true,
    }
  }

  token(): string {
    match (this.sessionToken) {
      Some(t) => return t
      None => return ""
    }
  }

  // Nanoseconds until `expiration` at wall-clock `t` (negative once past),
  // or `neverExpires` for a credential that does not expire.
  remaining(t: int): int {
    match (this.expiration) {
      Some(e) => return e.ns - t
      None => return neverExpires
    }
  }
}

// Which credentials a `Client` signs with.
//   Default          the default provider chain
//   Static(c)        exactly `c`
//   Profile(name)    the named profile of the shared config files
//   Provider(fn)     whatever `fn` returns, called whenever a refresh is due
export enum Credentials {
  Default
  Static(AwsCredential)
  Profile(string)
  Provider(() => AwsCredential!)

  // The cache a `Client` resolves through. Fails on a malformed choice, at
  // construction.
  export resolver(): CredentialCache! {
    match (this) {
      Default => return CredentialCache(envCredentials)
      Static(c) => return CredentialCache(constantProvider(c))
      Provider(p) => return CredentialCache(p)
      Profile(name) => {
        if (name == "") {
          fail newError("s3: credentials: Profile needs a profile name")
        }
        fail newError("s3: credentials: Profile(\"${name}\") needs the shared config file reader, which this build does not have")
      }
    }
  }
}

// Whether `resolve` may serve a cached credential or must fetch a new one
// (after the server answered ExpiredToken, for instance).
export enum Refresh { IfNeeded, Force }

// What one caller does after looking at the cache under the lock.
enum Step {
  Use(AwsCredential),
  Wait(Flight),
  Lead(Flight),
}

// One provider call in progress. Waiters block on `done`, which the leader
// closes after it has written the outcome, so every waiter reads the same
// result.
class Flight {
  done: chan<bool>
  cred: Option<AwsCredential>
  // The credential that was cached when the call failed, if it had not
  // expired yet.
  fallback: Option<AwsCredential>
  // "" on success; otherwise the whole error message.
  failure: string

  init() {
    this.done = chan<bool>()
    this.cred = Option<AwsCredential>.None
    this.fallback = Option<AwsCredential>.None
    this.failure = ""
  }

  // What a caller in `refresh` mode gets from the finished call.
  outcome(refresh: Refresh): AwsCredential! {
    match (this.cred) {
      Some(c) => return c
      None => {}
    }
    match (this.fallback) {
      Some(c) => {
        if (refresh == Refresh.IfNeeded) {
          return c
        }
      }
      None => {}
    }
    fail newError(this.failure)
  }
}

fn wallNs(): int {
  return now().ns
}

// A provider behind a cache with single-flight refresh. Safe to share
// between tasks.
export class CredentialCache {
  provider: () => AwsCredential!
  // Wall clock in unix nanoseconds; replaced in tests.
  clock: () => int
  mu: Mutex
  current: Option<AwsCredential>
  flight: Option<Flight>

  init(provider: () => AwsCredential!) {
    this.provider = provider
    this.clock = wallNs
    this.mu = Mutex()
    this.current = Option<AwsCredential>.None
    this.flight = Option<Flight>.None
  }

  // The credential to sign with. Returns the cached one while it is more than
  // five minutes from expiry; otherwise one task calls the provider while
  // every other caller waits for that call's outcome. Fails when the provider
  // fails (unless `IfNeeded` can serve a credential that has not expired) or
  // hands back a malformed or already expired credential.
  export resolve(refresh: Refresh = Refresh.IfNeeded): AwsCredential! {
    this.mu.lock()
    let step = this.plan(refresh)
    this.mu.unlock()
    match (step) {
      Use(c) => return c
      Wait(f) => {
        <- f.done
        return f.outcome(refresh)?
      }
      Lead(f) => return this.lead(f, refresh)?
    }
  }

  // The cached credential if it still has more than `margin` nanoseconds to
  // live and the caller accepts a cached one.
  cached(refresh: Refresh, t: int, margin: int): Option<AwsCredential> {
    if (refresh == Refresh.Force) {
      return Option<AwsCredential>.None
    }
    match (this.current) {
      Some(c) => {
        if (c.remaining(t) > margin) {
          return Option<AwsCredential>.Some(c)
        }
      }
      None => {}
    }
    return Option<AwsCredential>.None
  }

  // Decides what the caller does. Holds the lock. A caller whose cached
  // credential is merely inside the refresh window leads the refresh; one that
  // arrives while a refresh runs keeps using a credential that is still valid.
  plan(refresh: Refresh): Step {
    let t = this.clock()
    match (this.cached(refresh, t, refreshWindow - 1)) {
      Some(c) => return Step.Use(c)
      None => {}
    }
    match (this.flight) {
      Some(f) => {
        match (this.cached(refresh, t, 0)) {
          Some(c) => return Step.Use(c)
          None => return Step.Wait(f)
        }
      }
      None => {}
    }
    let f = Flight()
    this.flight = Option<Flight>.Some(f)
    return Step.Lead(f)
  }

  // Runs the provider, publishes the outcome to the cache and to the waiters.
  lead(f: Flight, refresh: Refresh): AwsCredential! {
    this.fetch(f)
    this.mu.lock()
    this.settle(f)
    this.flight = Option<Flight>.None
    this.mu.unlock()
    close(f.done)
    return f.outcome(refresh)?
  }

  // Stores the credential in the cache, or notes the cached one as the
  // fallback. Holds the lock.
  settle(f: Flight) {
    match (f.cred) {
      Some(c) => this.current = Option<AwsCredential>.Some(c)
      None => f.fallback = this.cached(Refresh.IfNeeded, this.clock(), 0)
    }
  }

  // Calls the provider outside the lock and writes the outcome into `f`.
  fetch(f: Flight) {
    let c = this.provider() catch e {
      f.failure = "s3: credentials: provider failed: ${e.message()}"
      return
    }
    if (c.remaining(this.clock()) <= 0) {
      f.failure = "s3: credentials: the provider returned credentials for ${c.accessKeyId} that have already expired"
      return
    }
    f.cred = Option<AwsCredential>.Some(c)
  }
}

fn optionalText(s: string): Option<string> {
  if (s == "") {
    return Option<string>.None
  }
  return Option<string>.Some(s)
}

fn expirationFrom(s: string): Option<Timestamp>! {
  if (s == "") {
    return Option<Timestamp>.None
  }
  let t = parseRfc3339(s) catch _ {
    fail newError("s3: credentials: ${envExpiration} is not an RFC 3339 timestamp: ${s}")
  }
  return Option<Timestamp>.Some(t)
}

// The SDK's fromEnv: reads the five variables through `get`. An unset and an
// empty variable read the same, so both mean "not set".
fn credentialsFromLookup(get: (string) => string): AwsCredential! {
  let id = get(envKey)
  let secret = get(envSecret)
  if (id == "" || secret == "") {
    fail newError("s3: credentials: ${envKey} and ${envSecret} are not both set")
  }
  return AwsCredential(
    accessKeyId = id,
    secretAccessKey = secret,
    sessionToken = optionalText(get(envSession)),
    expiration = expirationFrom(get(envExpiration))?,
    accountId = optionalText(get(envAccount)),
  )?
}

// Credentials from AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and optionally
// AWS_SESSION_TOKEN, AWS_CREDENTIAL_EXPIRATION (RFC 3339), and
// AWS_ACCOUNT_ID. Fails when the key or the secret is not set, or a
// value is malformed. Usable as `Credentials.Provider(envCredentials)`.
export fn envCredentials(): AwsCredential! {
  return credentialsFromLookup(env)?
}

fn constantProvider(c: AwsCredential): () => AwsCredential! {
  return () => c
}
