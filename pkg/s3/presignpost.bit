// Browser POST policies: bounded fields and conditions, signed over base64 JSON.
import { jsonAppendString } from "std/json"
import { parseRfc3339 } from "std/time"

export enum PostCondition {
  Exact(string, string),
  StartsWith(string, string),
  ContentLengthRange(int, int),
}

export class PostOptions {
  export fields: [](string, string) = [](string, string)(0),
  export conditions: []PostCondition = []PostCondition(0),
  // Empty uses the current UTC time; otherwise YYYYMMDDTHHMMSSZ.
  export signingDate: string = "",
  export sessionToken: string = "",
}

export class PresignedPost {
  export url: string,
  export fields: [](string, string),
}

const postMaxEntries: int = 128
const postMaxPolicyBytes: int = 16384
const postMaxValueBytes: int = 4096

fn postQuote(s: string): string {
  return string(jsonAppendString([]byte(0), s))
}

fn postExact(name: string, value: string): string {
  return "{" + postQuote(name) + ":" + postQuote(value) + "}"
}

fn postReserved(name: string): bool {
  for reserved of [
    "bucket", "key", "policy", "file", "x-amz-algorithm", "x-amz-credential",
    "x-amz-date", "x-amz-security-token", "x-amz-signature",
  ] {
    if (toLower(name) == reserved) {
      return true
    }
  }
  return false
}

fn postCheckText(name: string, value: string): ()! {
  if (name == "" || len(name) > 256 || len(value) > postMaxValueBytes) {
    fail newError("s3 POST: invalid field name or value size")
  }
  if (!isValidUtf8(name) || !isValidUtf8(value)) {
    fail newError("s3 POST: field must be UTF-8")
  }
}

fn postCheckFields(fields: [](string, string)): ()! {
  for (name, value) of fields {
    postCheckText(name, value)?
    if (postReserved(name)) {
      fail newError("s3 POST: reserved field conflict")
    }
    let count = 0
    for (other, _) of fields {
      if (toLower(name) == toLower(other)) {
        count = count + 1
      }
    }
    if (count != 1) {
      fail newError("s3 POST: duplicate field")
    }
  }
}

fn postConditionField(name: string, value: string): ()! {
  postCheckText(name, value)?
  if (postReserved(name) && name != "key") {
    fail newError("s3 POST: reserved condition conflict")
  }
}

fn postConditionText(c: PostCondition): string! {
  match (c) {
    Exact(name, value) => {
      postConditionField(name, value)?
      return postExact(name, value)
    }
    StartsWith(name, value) => {
      postConditionField(name, value)?
      return "[\"starts-with\"," + postQuote("$" + name) + "," + postQuote(value) + "]"
    }
    ContentLengthRange(minimum, maximum) => {
      if (minimum < 0 || maximum < minimum) {
        fail newError("s3 POST: invalid content-length-range")
      }
      return "[\"content-length-range\",${minimum},${maximum}]"
    }
  }
}

fn postDate(date: string): Timestamp! {
  if (len(date) != 16 || date[8] != 'T' || date[15] != 'Z') {
    fail newError("s3 POST: signingDate must be YYYYMMDDTHHMMSSZ")
  }
  let parsed = parseRfc3339("${date[0:4]}-${date[4:6]}-${date[6:8]}T${date[9:11]}:${date[11:13]}:${date[13:15]}Z") catch _ {
    fail newError("s3 POST: invalid signingDate")
  }
  return parsed
}

fn postExpiration(date: string, seconds: int): string! {
  let start = postDate(date)?
  let delta = seconds * Second
  if (start.ns > 9223372036854775807 - delta) {
    fail newError("s3 POST: expiration is out of range")
  }
  return start.add(delta).toString()
}

fn postPolicyFields(cfg: Config, key: string, date: string, token: string): [](string, string) {
  let scope = credentialScope(date[0:8], cfg.region, "s3")
  let fields = [
    ("bucket", cfg.bucket), ("key", key),
    ("x-amz-algorithm", "AWS4-HMAC-SHA256"),
    ("x-amz-credential", "${cfg.accessKeyId}/${scope}"), ("x-amz-date", date),
  ]
  if (token != "") {
    fields = append(fields, ("x-amz-security-token", token))
  }
  return fields
}

fn postEncodePolicy(cfg: Config, date: string, policy: string): (string, string)! {
  if (len(policy) > postMaxPolicyBytes) {
    fail newError("s3 POST: policy exceeds 16384 bytes")
  }
  let encoded = encodeBase64([]byte(policy))
  let key = signingKey(cfg.secretKey, date[0:8], cfg.region, "s3")
  return (encoded, signature(key, encoded))
}

fn postCheckConfig(cfg: Config, key: string, opts: PostOptions): ()! {
  postCheckText("session token", opts.sessionToken)?
  for (name, value) of [
    ("bucket", cfg.bucket), ("key", key),
    ("secret key", cfg.secretKey), ("region", cfg.region), ("access key", cfg.accessKeyId),
  ] {
    postCheckText(name, value)?
    if (value == "") {
      fail newError("s3 POST: bucket, key, region and credentials are required")
    }
  }
  if (len(cfg.bucket) > 255 ||
    len(key) > 1024 ||
    len(cfg.region) > 256 ||
    len(cfg.accessKeyId) > 256) {
    fail newError("s3 POST: configuration exceeds size limit")
  }
}

fn postKeyCondition(key: string): string {
  let marker = "$" + "{filename}"
  if (hasSuffix(key, marker)) {
    return "[\"starts-with\",\"$key\"," + postQuote(key[0:len(key) - len(marker)]) + "]"
  }
  return postExact("key", key)
}

fn postPolicyEntries(fields: [](string, string), conditions: []PostCondition): []string! {
  let entries = []string(0)
  for c of conditions {
    entries = append(entries, postConditionText(c)?)
  }
  for (name, value) of fields {
    if (name == "key") {
      entries = append(entries, postKeyCondition(value))
    } else {
      entries = append(entries, postExact(name, value))
    }
  }
  return entries
}

// Fields receive exact-match conditions automatically. Additional conditions
// restrict them further; key's filename placeholder receives a prefix condition.
export fn presignPost(
  cfg: Config,
  key: string,
  expiresSeconds: int,
  opts: PostOptions = PostOptions{},
): PresignedPost! {
  if (expiresSeconds < 1 || expiresSeconds > 604800) {
    fail newError("s3 POST: expiresSeconds must be 1..604800")
  }
  if (len(opts.fields) + len(opts.conditions) > postMaxEntries) {
    fail newError("s3 POST: fields and conditions exceed 128 entries")
  }
  postCheckConfig(cfg, key, opts)?
  postCheckFields(opts.fields)?
  let date = opts.signingDate
  if (date == "") {
    let (_, current) = amzTimestamps()
    date = current
  }
  let expiration = postExpiration(date, expiresSeconds)?
  let parts = parseEndpoint(cfg.endpoint)?
  let allFields = postPolicyFields(cfg, key, date, opts.sessionToken)
  for pair of opts.fields {
    allFields = append(allFields, pair)
  }
  let entries = postPolicyEntries(allFields, opts.conditions)?
  let policy = "{\"expiration\":" +
    postQuote(expiration) +
    ",\"conditions\":[" +
    join(entries, ",") +
    "]}"
  let (encoded, sig) = postEncodePolicy(cfg, date, policy)?
  allFields = append(allFields, ("policy", encoded))
  allFields = append(allFields, ("x-amz-signature", sig))
  return PresignedPost{ url = requestUrl(parts, "/${cfg.bucket}", ""), fields = allFields }
}
