// pkg/s3/endpointfns.test.bit — endpointfns.bit against the examples of the
// Smithy rules-engine specification (smithy.io/2.0/additional-specs/rules-engine/
// standard-library.html and smithy.io/2.0/aws/rules-engine/library-functions.html,
// pages last modified 2026-09-25, smithy-aws-endpoints 1.74.0), the three ARN
// families S3 resolves and malformed ARNs. endpointmodel.test.bit sweeps the hosts,
// buckets and ARNs of the S3 model's own endpoint tests through the same functions.

import { awsPartition } from "aws"
import { indexOf, join, lastIndexOf, parseInt, repeat, split } from "std/strings"

// Counts the vectors run and keeps the ones that failed, so a red run names
// them all and a green one can say "N of N".
class Vectors {
  passed: int,
  total: int,
  failures: []string,
}

fn vectors(): Vectors {
  return Vectors{ passed = 0, total = 0, failures = []string(0) }
}

fn check(t: Vectors, ok: bool, what: string) {
  t.total = t.total + 1
  if (ok) {
    t.passed = t.passed + 1
    return
  }
  t.failures = append(t.failures, what)
}

fn finish(t: Vectors, name: string) {
  println("${name}: ${t.passed} of ${t.total} vectors")
  assert(len(t.failures) == 0, "failed: ${join(t.failures, "; ")}")
}

fn flagText(b: bool): string {
  if (b) {
    return "T"
  }
  return "F"
}

// A document value as text: None is "<none>", a list is comma joined.
fn render(d: Option<Doc>): string {
  match (d) {
    None => return "<none>"
    Some(v) => return renderDoc(v)
  }
}

fn renderDoc(d: Doc): string {
  match (d) {
    Text(s) => return s
    Flag(b) => return flagText(b)
    Texts(items) => return "[" + join(items, ",") + "]"
    Fields(_) => return "<fields>"
  }
}

fn some(s: string): Option<string> {
  return Option<string>.Some(s)
}

fn none(): Option<string> {
  return Option<string>.None
}

fn text(o: Option<string>): string {
  match (o) {
    Some(s) => return s
    None => return "<none>"
  }
}

fn urlText(o: Option<EndpointUrl>): string {
  match (o) {
    Some(u) => return "${u.scheme}|${u.authority}|${u.path}|${u.normalizedPath}|${flagText(u.isIp)}"
    None => return "<none>"
  }
}

fn arnText(o: Option<Arn>): string {
  match (o) {
    Some(a) => return "${a.partition}|${a.service}|${a.region}|${a.accountId}|${join(
      a.resourceId,
      ",",
    )}"
    None => return "<none>"
  }
}

fn equalityVectors(t: Vectors) {
  check(t, booleanEquals(true, true), "booleanEquals true true")
  check(t, booleanEquals(false, false), "booleanEquals false false")
  check(t, !booleanEquals(true, false), "booleanEquals true false")
  check(t, !booleanEquals(false, true), "booleanEquals false true")
  check(t, stringEquals("something", "something"), "stringEquals equal")
  check(t, !stringEquals("something", "other"), "stringEquals differ")
  check(t, !stringEquals("something", "Something"), "stringEquals case")
  check(t, stringEquals("", ""), "stringEquals empty")
}

fn notAndIsSetVectors(t: Vectors) {
  check(t, not(false), "not false")
  check(t, !not(true), "not true")
  check(t, isSet(some("x")), "isSet some")
  check(t, isSet(some("")), "isSet empty string")
  check(t, !isSet(none()), "isSet none")
  check(t, isSet(Option<bool>.Some(false)), "isSet is presence, not truth")
  check(t, not(isSet(none())), "not(isSet(none))")
  check(t, !not(isSet(some("x"))), "not(isSet(some))")
}

fn listDoc(): Doc {
  let m = map<string, Doc>()
  m["list"] = Doc.Texts(["a", "b", "c"])
  m["name"] = Doc.Text("n")
  m["on"] = Doc.Flag(true)
  return Doc.Fields(m)
}

fn nestedDoc(): Doc {
  let inner = map<string, Doc>()
  inner["leaf"] = Doc.Text("deep")
  let m = map<string, Doc>()
  m["inner"] = Doc.Fields(inner)
  return Doc.Fields(m)
}

fn getAttrVectors(t: Vectors) {
  let url = match (parseURL("https://example.com")) {
    Some(u) => urlDoc(u)
    None => Doc.Text("")
  }
  check(t, render(getAttr(url, "scheme")) == "https", "getAttr scheme of a parsed URL")
  check(t, render(getAttr(url, "isIp")) == "F", "getAttr isIp")
  check(t, render(getAttr(url, "normalizedPath")) == "/", "getAttr normalizedPath")
  check(t, render(getAttr(url, "nope")) == "<none>", "getAttr missing key")
  check(t, render(getAttr(url, "scheme.x")) == "<none>", "getAttr key into a text")
  let d = listDoc()
  let cases = [
    "list[0]|a", "list[1]|b", "list[2]|c", "list[3]|<none>", "list[-1]|c", "list[-2]|b",
    "list[-3]|a", "list[-4]|<none>", "list|[a,b,c]", "list[0].x|<none>", "list[x]|<none>",
    "list[0|<none>", "name[0]|<none>", "on|T", "|<none>", "a..b|<none>", "name.|<none>",
    ".name|<none>", "[0]|<none>",
  ]
  for c of cases {
    let at = lastIndexOf(c, "|")
    check(t, render(getAttr(d, c[0:at])) == c[at + 1:len(c)], "getAttr ${c}")
  }
  check(t, render(getAttr(nestedDoc(), "inner.leaf")) == "deep", "getAttr nested key path")
  check(t, render(getAttr(nestedDoc(), "inner.missing")) == "<none>", "getAttr nested missing")
}

fn hostLabelVectors(t: Vectors) {
  let long63 = "a" + repeat("b", 61) + "c"
  let rows = [
    "example|F|T", "a-b|F|T", "-a|F|F", "a-|F|F", "|F|F", "a.b|F|F", "a.b|T|T", "a..b|T|F",
    "a.-b|T|F", "a.b-|T|F", "Ab1|F|T", "a_b|F|F", "a b|F|F", "é|F|F", "-|F|F", "0|F|T", "|T|F",
    ".|T|F", "a.|T|F", ".a|T|F", "${long63}|F|T", "${long63}b|F|F", "${long63}.${long63}|T|T",
    "${long63}b.a|T|F",
  ]
  for r of rows {
    let parts = split(r, "|")
    check(
      t,
      isValidHostLabel(parts[0], parts[1] == "T") == (parts[2] == "T"),
      "isValidHostLabel ${r}",
    )
  }
}

// The rows of the `parseURL` table in the specification, in its order.
fn parseUrlVectors(t: Vectors) {
  let rows = [
    "https://example.com|https|example.com|/|/|F",
    "https://example.com:8443?foo=bar&faz=baz|<none>",
    "http://example.com:80/foo/bar|http|example.com:80|/foo/bar|/foo/bar/|F",
    "https://127.0.0.1|https|127.0.0.1|/|/|T",
    "https://[fe80::1]|https|[fe80::1]|/|/|T",
  ]
  for r of rows {
    let at = indexOf(r, "|")
    let want = r[at + 1:len(r)]
    check(t, urlText(parseURL(r[0:at])) == want, "parseURL ${r}")
  }
}

// What the specification leaves to the implementation, pinned: IPv6 forms, ports,
// userinfo, case, and every reason to return None.
fn parseUrlEdgeVectors(t: Vectors) {
  let rows = [
    "https://[::1]:8080/p|https|[::1]:8080|/p|/p/|T",
    "http://[2001:DB8::1]|http|[2001:db8::1]|/|/|T",
    "https://[::ffff:192.0.2.1]/|https|[::ffff:192.0.2.1]|/|/|T",
    "https://[::1]:|https|[::1]|/|/|T",
    "https://[::1|<none>",
    "https://[fe80::1%25eth0]|<none>",
    "https://[:::1]|<none>",
    "https://[::1]x|<none>",
    "https://[::1]:99999|<none>",
    "HTTPS://Example.COM/A/b/|https|example.com|/A/b/|/A/b/|F",
    "https://u:p@example.com/x|https|example.com|/x|/x/|F",
    "https://example.com:8080|https|example.com:8080|/|/|F",
    "https://example.com:0443|https|example.com:443|/|/|F",
    "https://example.com:|https|example.com|/|/|F",
    "https://example.com:65535|https|example.com:65535|/|/|F",
    "https://example.com:65536|<none>",
    "https://example.com:80a|<none>",
    "https://10.0.1.12:433/foo//bar|https|10.0.1.12:433|/foo//bar|/foo//bar/|T",
    "https://256.1.1.1|<none>",
    "https://127.1|<none>",
    "https://010.0.0.1|<none>",
    "https://example.com.|https|example.com.|/|/|F",
    "https://exa_mple.com/|https|exa_mple.com|/|/|F",
    "http://example.com//a|http|example.com|//a|//a/|F",
    "ftp://files.example.com/x|ftp|files.example.com|/x|/x/|F",
    "example.com|<none>",
    "://example.com|<none>",
    "1ttp://example.com|<none>",
    "ht tp://example.com|<none>",
    "https://|<none>",
    "https:///x|<none>",
    "https://exa mple.com|<none>",
    "https://example.com/a b|<none>",
    "https://example.com/#x|<none>",
    "https://example.com/?|<none>",
    "https://exa%41mple.com|<none>",
    "https://é.com|<none>",
    "https://example.com\\x|<none>",
  ]
  for r of rows {
    let at = indexOf(r, "|")
    let want = r[at + 1:len(r)]
    check(t, urlText(parseURL(r[0:at])) == want, "parseURL ${r}")
  }
}

fn substringVectors(t: Vectors) {
  let rows = [
    "abcdefg|0|4|F|abcd", "abcdefg|0|4|T|defg", "abcdefg|3|5|F|de", "abcdefg|3|5|T|cd",
    "abcdefg|0|7|F|abcdefg", "abcdefg|0|7|T|abcdefg", "abcdefg|6|7|F|g", "abcdefg|6|7|T|a",
    "abc|0|4|F|<none>", "abc|0|4|T|<none>", "abc|2|2|F|<none>", "abc|3|2|F|<none>",
    "abc|0|0|F|<none>", "abc|-1|2|F|<none>", "|0|1|F|<none>", "aé|0|1|F|<none>",
    "é|0|1|F|<none>", "mybucket--x-s3|0|6|T|--x-s3", "mybucket--op-s3|0|7|T|--op-s3",
    "mybucket--xa-s3|0|7|T|--xa-s3", "mybucket|0|6|T|bucket",
  ]
  for r of rows {
    let parts = split(r, "|")
    let got = substring(parts[0], parseOrPanic(parts[1]), parseOrPanic(parts[2]), parts[3] == "T")
    check(t, text(got) == parts[4], "substring ${r}")
  }
}

fn parseOrPanic(s: string): int {
  return parseInt(s) catch e {
    panic(e.message())
  }
}

// RFC 3986 section 2.3: A-Z a-z 0-9 - _ . ~ stay, every other byte is %XX.
fn uriEncodeVectors(t: Vectors) {
  let keep = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~"
  check(t, uriEncode(keep) == keep, "uriEncode keeps the unreserved set")
  check(t, uriEncode("") == "", "uriEncode empty")
  // The characters the specification lists, in its order, with their escapes.
  let listed = "/:,?#[]{}|@! $&'()*+;=%<>\"^`\\"
  let escapes = [
    "%2F", "%3A", "%2C", "%3F", "%23", "%5B", "%5D", "%7B", "%7D", "%7C", "%40", "%21", "%20",
    "%24", "%26", "%27", "%28", "%29", "%2A", "%2B", "%3B", "%3D", "%25", "%3C", "%3E", "%22",
    "%5E", "%60", "%5C",
  ]
  check(t, len(listed) == len(escapes), "the listed characters")
  let i = 0
  while (i < len(listed) && i < len(escapes)) {
    check(t, uriEncode(listed[i:i + 1]) == escapes[i], "uriEncode ${escapes[i]}")
    i = i + 1
  }
  check(t, uriEncode("é") == "%C3%A9", "uriEncode two byte")
  check(t, uriEncode("€") == "%E2%82%AC", "uriEncode three byte")
  check(t, uriEncode("my bucket/key+1") == "my%20bucket%2Fkey%2B1", "uriEncode mixed")
  check(t, uriEncode("a%2Fb") == "a%252Fb", "uriEncode never decodes")
}

// The rows of the `aws.parseArn` table in the specification, in its order.
fn parseArnSpecVectors(t: Vectors) {
  let rows = [
    "arn:aws:sns:us-west-2:012345678910:example-sns-topic-name|aws|sns|us-west-2|012345678910|example-sns-topic-name",
    "11111111-2222-3333-4444-555555555555|<none>",
    "arn:aws:ec2:us-east-1:012345678910:vpc/vpc-0e9801d129EXAMPLE|aws|ec2|us-east-1|012345678910|vpc,vpc-0e9801d129EXAMPLE",
    "arn:aws:iam::012345678910:user/johndoe|aws|iam||012345678910|user,johndoe",
    "arn:aws:s3:::bucket_name|aws|s3|||bucket_name",
  ]
  for r of rows {
    let at = indexOf(r, "|")
    check(t, arnText(awsParseArn(r[0:at])) == r[at + 1:len(r)], "aws.parseArn ${r}")
  }
}

// The ARN families S3 resolves (access point, Outposts, Object Lambda), each in
// the `:` and the `/` spelling, and the shapes that are not ARNs.
fn parseArnFamilyVectors(t: Vectors) {
  let rows = [
    "arn:aws:s3:us-west-2:123456789012:accesspoint:myendpoint|aws|s3|us-west-2|123456789012|accesspoint,myendpoint",
    "arn:aws:s3:us-west-2:123456789012:accesspoint/myendpoint|aws|s3|us-west-2|123456789012|accesspoint,myendpoint",
    "arn:aws-cn:s3:cn-north-1:123456789012:accesspoint:ap|aws-cn|s3|cn-north-1|123456789012|accesspoint,ap",
    "arn:aws:s3::123456789012:accesspoint:mfzwi23gnjvgw.mrap|aws|s3||123456789012|accesspoint,mfzwi23gnjvgw.mrap",
    "arn:aws:s3-outposts:us-west-2:123456789012:outpost:op-01234567890123456:accesspoint:reports|aws|s3-outposts|us-west-2|123456789012|outpost,op-01234567890123456,accesspoint,reports",
    "arn:aws:s3-outposts:us-west-2:123456789012:outpost/op-01234567890123456/accesspoint/reports|aws|s3-outposts|us-west-2|123456789012|outpost,op-01234567890123456,accesspoint,reports",
    "arn:aws:s3-object-lambda:us-west-2:123456789012:accesspoint/my-olap|aws|s3-object-lambda|us-west-2|123456789012|accesspoint,my-olap",
    "arn:aws:s3-object-lambda:us-west-2:123456789012:accesspoint:my-olap|aws|s3-object-lambda|us-west-2|123456789012|accesspoint,my-olap",
    "arn:aws:s3:us-west-2:123456789012:accesspoint:a:b:c|aws|s3|us-west-2|123456789012|accesspoint,a,b,c",
    "arn:aws:s3:us-west-2:123456789012:accesspoint/|aws|s3|us-west-2|123456789012|accesspoint,",
    "arn:aws:s3:us-west-2:123456789012:accesspoint|aws|s3|us-west-2|123456789012|accesspoint",
    "arn:aws:s3:us-west-2:123456789012|<none>",
    "arn:aws:s3:us-west-2:123456789012:|<none>",
    "arn::s3:us-west-2:123456789012:accesspoint:x|<none>",
    "arn:aws::us-west-2:123456789012:accesspoint:x|<none>",
    "ARN:aws:s3:us-west-2:123456789012:accesspoint:x|<none>",
    "arn:aws:s3|<none>",
    "arn|<none>",
    "|<none>",
    "bucket|<none>",
    "my-bucket:with:colons|<none>",
  ]
  for r of rows {
    let at = indexOf(r, "|")
    check(t, arnText(awsParseArn(r[0:at])) == r[at + 1:len(r)], "aws.parseArn ${r}")
  }
}

// The inputs of the JS SDK's `parseArn` (aws-sdk-js-v3 at 054298b1520f,
// packages-internal/core/src/submodules/client/util-endpoints/lib/aws/parseArn.ts).
// It splits on `:` and returns null only when there are fewer than six parts, the
// first is not `arn`, the partition or service is empty, or the resource parts
// joined with `:` are empty. A resource that starts with an empty segment
// (`::x`) is therefore accepted, with `resourceId` `["", "x"]`. Expected rows
// are the output of that function run on each input.
fn parseArnJsVectors(t: Vectors) {
  let rows = [
    "arn:aws:s3:us-east-1:123456789012::x|aws|s3|us-east-1|123456789012|,x",
    "arn:aws:s3:us-west-2:123456789012::myendpoint|aws|s3|us-west-2|123456789012|,myendpoint",
    "arn:aws:s3:us-west-2:123456789012::|aws|s3|us-west-2|123456789012|,",
    "arn:aws:s3:us-west-2:123456789012:/|aws|s3|us-west-2|123456789012|,",
    "arn:aws:s3:us-west-2:123456789012:/x|aws|s3|us-west-2|123456789012|,x",
    "arn:aws:s3:us-west-2:123456789012:a//b|aws|s3|us-west-2|123456789012|a,,b",
    "arn:aws:s3:us-west-2:123456789012:a:|aws|s3|us-west-2|123456789012|a,",
    "arn:aws:s3::::|aws|s3|||,",
    "arn:aws:sns:::myTopic|aws|sns|||myTopic",
    "arn:aws:s3:us-west-2:123456789012:my:folder/my:file|aws|s3|us-west-2|123456789012|my,folder,my,file",
    "arn:aws:s3:us-west-2:123456789012|<none>",
    "arn:aws:s3:us-west-2:123456789012:|<none>",
    "arn:aws:::::x|<none>",
    "arn:aws::us-west-2:123456789012:x|<none>",
    "arn::s3:us-west-2:123456789012:x|<none>",
    "some:random:string:separated:by:colons|<none>",
    "arn:aws:too:short|<none>",
  ]
  for r of rows {
    let at = indexOf(r, "|")
    check(t, arnText(awsParseArn(r[0:at])) == r[at + 1:len(r)], "aws.parseArn js ${r}")
  }
}

fn bucketVectors(t: Vectors) {
  let long63 = repeat("b", 63)
  let rows = [
    "mybucket|F|T", "my-bucket-1|F|T", "my.bucket|F|F", "my.bucket|T|F", "my-bucket.example|T|T", "ab|F|F", "abc|F|T",
    "MyBucket|F|F", "mybuckeT|T|F", "192.168.0.1|F|F", "192.168.0.1|T|F", "-abc|F|F", "abc-|F|F",
    "${long63}|F|T", "${long63}b|F|F", "[::1]|F|F", "a.bcd|T|F", "abc.def.ghi|T|T", "abc..def|T|F",
    "|F|F", "|T|F", "bucket_name|F|F", "1.2.3|T|F", "123|F|T",
  ]
  for r of rows {
    let parts = split(r, "|")
    check(
      t,
      awsIsVirtualHostableS3Bucket(parts[0], parts[1] == "T") == (parts[2] == "T"),
      "aws.isVirtualHostableS3Bucket ${r}",
    )
  }
}

fn partitionVectors(t: Vectors) {
  let doc = partitionDoc(awsPartition("cn-north-1"))
  check(t, render(getAttr(doc, "name")) == "aws-cn", "getAttr partition name")
  check(t, render(getAttr(doc, "supportsFIPS")) == "T", "getAttr supportsFIPS")
  check(
    t,
    render(getAttr(doc, "implicitGlobalRegion")) == "cn-northwest-1",
    "getAttr implicitGlobalRegion",
  )
}

fn arnDocVectors(t: Vectors) {
  let doc = match (awsParseArn("arn:aws:s3-outposts:us-west-2:123456789012:outpost/op-0123/accesspoint/reports")) {
    Some(a) => arnDoc(a)
    None => Doc.Text("")
  }
  let rows = [
    "partition|aws", "service|s3-outposts", "region|us-west-2", "accountId|123456789012",
    "resourceId[0]|outpost", "resourceId[1]|op-0123", "resourceId[2]|accesspoint",
    "resourceId[3]|reports", "resourceId[4]|<none>", "resourceId[-1]|reports", "resourceId[-4]|outpost",
    "resourceId[-5]|<none>",
  ]
  for r of rows {
    let at = indexOf(r, "|")
    check(t, render(getAttr(doc, r[0:at])) == r[at + 1:len(r)], "getAttr ${r}")
  }
}

test "the specification examples, ARN families and malformed ARNs" {
  let t = vectors()
  equalityVectors(t)
  notAndIsSetVectors(t)
  getAttrVectors(t)
  hostLabelVectors(t)
  parseUrlVectors(t)
  parseUrlEdgeVectors(t)
  substringVectors(t)
  uriEncodeVectors(t)
  parseArnSpecVectors(t)
  parseArnFamilyVectors(t)
  parseArnJsVectors(t)
  bucketVectors(t)
  partitionVectors(t)
  arnDocVectors(t)
  finish(
    t,
    "endpointfns (smithy.io rules-engine pages modified 2026-09-25, smithy-aws-endpoints 1.74.0)",
  )
}
