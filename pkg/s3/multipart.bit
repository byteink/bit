// pkg/s3/multipart.bit — the three calls a multipart upload needs
// (AWS's own three-call shape: initiate, upload each part, complete), for
// an object too large — or too slow to produce as one buffer — to send as
// a single PUT. `createMultipartUpload`/`uploadPart`/`completeMultipartUpload`/
// `abortMultipartUpload` are injected onto `Client` (client.bit, same
// module, SPEC §19) via trait injection (SPEC §10.7, `use ClientMultipart`
// in `Client`'s own body): Bit has no extension-method syntax, and `Client`
// cannot be redeclared here (a second `class Client` is E0042) — the same
// mechanism `stdlib/time/calarith.bit` uses to add `Timestamp.add` and
// friends from a sibling file.

// One part already uploaded: its 1-based part number and the quoted ETag
// `uploadPart` returned for it — `completeMultipartUpload` needs both, in
// part-number order, to assemble the final object.
export class UploadedPart {
  partNumber: int,
  etag: string,
}

fn completeRequestBody(parts: []UploadedPart): string {
  let body = "<CompleteMultipartUpload>"
  let i = 0
  while (i < len(parts)) {
    body = body +
      "<Part><PartNumber>${parts[i].partNumber}</PartNumber>" +
      "<ETag>${parts[i].etag}</ETag></Part>"
    i = i + 1
  }
  return body + "</CompleteMultipartUpload>"
}

// Starts a multipart upload of `key` and returns the upload ID every later
// call (`uploadPart`/`completeMultipartUpload`/`abortMultipartUpload`)
// needs. Mirrors S3's `InitiateMultipartUploadResult` response.
trait ClientMultipart {
  export createMultipartUpload(key: string, contentType: string): string! {
    let path = objectPath(this.cfg.bucket, key)
    let params = [("uploads", "")]
    let (url, headers) = signedRequest(this.cfg, "POST", path, params, sha256Hex(""))?
    let sendHeaders = headers
    if (contentType != "") {
      sendHeaders = append(headers, Header{ name = "Content-Type", value = contentType })
    }
    let res = requestWith("POST", url, sendHeaders, "")?
    checkOk(res)?
    let uploadId = xmlTagOr(res.body, "UploadId", 0, "")
    if (uploadId == "") {
      fail newError("s3: createMultipartUpload: no UploadId in response")
    }
    return uploadId
  }

  // Uploads `body` as part `partNumber` (1-based, AWS's own numbering) of
  // `uploadId`, and returns the ETag `completeMultipartUpload` must be told
  // about it.
  export uploadPart(key: string, uploadId: string, partNumber: int, body: string): string! {
    let path = objectPath(this.cfg.bucket, key)
    let params = [("partNumber", "${partNumber}"), ("uploadId", uploadId)]
    let (url, headers) = signedRequest(this.cfg, "PUT", path, params, sha256Hex(body))?
    let res = requestWith("PUT", url, headers, body)?
    checkOk(res)?
    let etag = httpHeader(res.headers, "etag")
    if (etag == "") {
      fail newError("s3: uploadPart: no ETag in response")
    }
    return etag
  }

  // Assembles the final object from every part previously uploaded under
  // `uploadId`, in `parts`' order (S3 requires ascending `PartNumber`,
  // which is the caller's responsibility — this sends the list exactly as
  // given).
  export completeMultipartUpload(key: string, uploadId: string, parts: []UploadedPart): ()! {
    let path = objectPath(this.cfg.bucket, key)
    let params = [("uploadId", uploadId)]
    let body = completeRequestBody(parts)
    let (url, headers) = signedRequest(this.cfg, "POST", path, params, sha256Hex(body))?
    let res = requestWith("POST", url, headers, body)?
    checkOk(res)?
  }

  // Cancels `uploadId` and discards every part already uploaded under it —
  // the cleanup call for an upload abandoned partway through.
  export abortMultipartUpload(key: string, uploadId: string): ()! {
    let path = objectPath(this.cfg.bucket, key)
    let params = [("uploadId", uploadId)]
    let (url, headers) = signedRequest(this.cfg, "DELETE", path, params, sha256Hex(""))?
    let res = requestWith("DELETE", url, headers, "")?
    checkOk(res)?
  }
}
