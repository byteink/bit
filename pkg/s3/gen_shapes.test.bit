// pkg/s3/gen_shapes.test.bit — #6614. The generated shapes as a caller meets
// them: an input names only what it sets, a required member is a plain field,
// an optional one is an Option, an enum carries a value the server may add
// later, an output carries its response metadata.

import { now } from "std/time"

test "PutObjectInput is built from bucket, key and body alone" {
  let input = PutObjectInput{ bucket = "photos", key = "cats/mine.jpg", body = Body.Text("raw") }
  assert(input.bucket == "photos", "bucket ${input.bucket}")
  assert(input.key == "cats/mine.jpg", "key ${input.key}")
  match (input.body) {
    Text(t) => assert(t == "raw", "body ${t}")
    _ => panic("body is not the text it was built with")
  }
  match (input.contentType) {
    None => {}
    Some(_) => panic("an unset optional member is not None")
  }
  match (input.storageClass) {
    None => {}
    Some(_) => panic("an unset optional enum member is not None")
  }
}

test "optional members take Option.Some, plain members their value" {
  let input = PutObjectInput{
    bucket = "b",
    key = "k",
    contentType = Option.Some("image/jpeg"),
    storageClass = Option.Some(StorageClass.StandardIa),
    metadata = Option.Some(map<string, string>{ "a": "1" }),
  }
  match (input.storageClass) {
    Some(c) => assert(c == StorageClass.StandardIa, "storage class")
    None => panic("storageClass was set")
  }
  match (input.metadata) {
    Some(m) => assert(m["a"] == "1", "user metadata")
    None => panic("metadata was set")
  }
}

test "an enum carries a value the model does not know" {
  let c = StorageClass.Unknown("COLD_FUTURE")
  match (c) {
    Unknown(v) => assert(v == "COLD_FUTURE", "unknown value ${v}")
    _ => panic("not Unknown")
  }
  assert(c != StorageClass.Standard, "Unknown equals Standard")
}

test "a union holds one member, an output its response metadata" {
  let f = AnalyticsFilter.Prefix("logs/")
  match (f) {
    Prefix(p) => assert(p == "logs/", "prefix ${p}")
    _ => panic("not Prefix")
  }
  let out = HeadObjectOutput{ lastModified = Option.Some(now()) }
  assert(
    out.responseMetadata.httpStatusCode == 0,
    "metadata status ${out.responseMetadata.httpStatusCode}",
  )
  assert(out.responseMetadata.requestId == "", "metadata request id")
}

interface EnumWire { wire(): string }

fn checkEnumWire<T: EnumWire>(values: [](T, string), parse: (string) => T, unknown: T) {
  for (v, wire) of values {
    assert(v.wire() == wire, "modeled wire value")
    assert(parse(wire) == v, "modeled enum roundtrip")
  }
  assert(parse("FUTURE_VALUE_6801") == unknown, "unknown enum variant")
  assert(unknown.wire() == "FUTURE_VALUE_6801", "unknown enum wire value")
}

test "AnalyticsS3ExportFileFormat: every modeled wire value and Unknown" {
  checkEnumWire(
    [
      (AnalyticsS3ExportFileFormat.Csv, "CSV"),
    ],
    (s: string) => AnalyticsS3ExportFileFormat.fromWire(s),
    AnalyticsS3ExportFileFormat.Unknown("FUTURE_VALUE_6801"),
  )
}

