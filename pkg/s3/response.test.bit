// pkg/s3/response.test.bit — #6622. The generated response deserializers
// (gen_resp_ops_*.bit) and the readers they are written in (response.bit)
// against the S3 API reference's HeadObject response (the day of Last-Modified
// zero-padded, the one change: HTTP-date writes two digits) with user metadata
// added, and against the headers a bucket owner can make awkward: an Expires
// that is not a date, a Content-Length that is not a number, repeated fields.
// The restXml protocol response vectors are gen_respvec.test.bit.

import { contains, toLower } from "std/strings"
import { Timestamp } from "std/time"
import { exists, readDir } from "std/fs"

const nsPerSecond: int = 1000000000

// `got` is set and equals `want`.
fn vecSome<T>(got: Option<T>, want: T, what: string) {
  match (got) {
    Some(v) => assert(v == want, "${what}: not the expected value")
    None => panic("${what}: unset")
  }
}

fn vecNone<T>(got: Option<T>, what: string) {
  match (got) {
    Some(_) => panic("${what}: set, want unset")
    None => {}
  }
}

// `got` is set to the instant `epoch` seconds after 1970.
fn vecStamp(got: Option<Timestamp>, epoch: int, what: string) {
  match (got) {
    Some(t) => assert(t.ns == epoch * nsPerSecond, "${what}: ${t.ns} ns, want ${epoch} s")
    None => panic("${what}: unset")
  }
}

// `got` is a map holding exactly the pairs `keys[i]: values[i]`.
fn vecMap(got: Option<map<string, string>>, keys: []string, values: []string, what: string) {
  match (got) {
    Some(m) => {
      assert(len(m) == len(keys), "${what}: ${len(m)} entries, want ${len(keys)}")
      let i = 0
      while (i < len(keys)) {
        assert(m[keys[i]] == values[i], "${what}: entry ${keys[i]}")
        i = i + 1
      }
    }
    None => panic("${what}: unset")
  }
}

const headSample: string = "x-amz-id-2: ef8yU9AS1ed4OpIszj7UDNEHGran\r\n" +
  "x-amz-request-id: 318BC8BC143432E5\r\n" +
  "x-amz-version-id: 3HL4kqtJlcpXroDTDmjVBH40Nrjfkd\r\n" +
  "Date: Wed, 28 Oct 2009 22:32:00 GMT\r\n" +
  "Last-Modified: Sun, 01 Jan 2006 12:00:00 GMT\r\n" +
  "ETag: \"fba9dede5f27731c9771645a39863328\"\r\n" +
  "Content-Length: 434234\r\n" +
  "Content-Type: text/plain\r\n" +
  "Connection: close\r\n" +
  "Server: AmazonS3\r\n"

fn headOf(extra: string): HeadObjectOutput {
  let h = responseHead(200, headSample + extra)
  return deserializeHeadObjectOutput(h) catch e {
    panic("deserializeHeadObjectOutput: ${e.message()}")
  }
}

test "HeadObject sample with x-amz-meta-a: 1 yields metadata {a: \"1\"}" {
  let out = headOf("x-amz-meta-a: 1\r\n")
  vecMap(out.metadata, ["a"], ["1"], "metadata")
  vecSome(out.contentLength, 434234, "contentLength")
  vecSome(out.contentType, "text/plain", "contentType")
  vecSome(out.eTag, "\"fba9dede5f27731c9771645a39863328\"", "eTag")
  vecSome(out.versionId, "3HL4kqtJlcpXroDTDmjVBH40Nrjfkd", "versionId")
  vecStamp(out.lastModified, 1136116800, "lastModified")
  assert(out.responseMetadata.httpStatusCode == 200, "status")
  assert(out.responseMetadata.requestId == "318BC8BC143432E5", "requestId")
  assert(
    out.responseMetadata.extendedRequestId == "ef8yU9AS1ed4OpIszj7UDNEHGran",
    "extendedRequestId",
  )
}

test "metadata keys are lower-cased, repeated fields join, no metadata headers is an empty map" {
  let out = headOf("X-Amz-Meta-Mixed-Case: v\r\nx-amz-meta-r: one\r\nx-amz-meta-r: two\r\n")
  vecMap(out.metadata, ["mixed-case", "r"], ["v", "one, two"], "metadata")
  vecMap(headOf("").metadata, [], [], "empty metadata")
}

test "Expires keeps the raw text and parses a date" {
  let out = headOf("Expires: Thu, 01 Dec 1994 16:00:00 GMT\r\n")
  vecSome(out.expiresString, "Thu, 01 Dec 1994 16:00:00 GMT", "expiresString")
  vecStamp(out.expires, 786297600, "expires")
}

test "an Expires that is not a date leaves expires unset and expiresString raw, never fails" {
  let out = headOf("Expires: never, ever\r\n")
  vecNone(out.expires, "expires")
  vecSome(out.expiresString, "never, ever", "expiresString")
  let none = headOf("")
  vecNone(none.expires, "absent expires")
  vecNone(none.expiresString, "absent expiresString")
}

test "an enum header takes its variant, an unknown value Unknown(value)" {
  let a = headOf("x-amz-storage-class: STANDARD_IA\r\n")
  vecSome(a.storageClass, StorageClass.StandardIa, "storageClass")
  let b = headOf("x-amz-storage-class: FUTURE_CLASS\r\n")
  vecSome(b.storageClass, StorageClass.Unknown("FUTURE_CLASS"), "unknown storageClass")
}

test "a malformed integer, boolean or date header fails naming the header" {
  for pair of [
    ("Content-Length: ten\r\n", "content-length"),
    ("x-amz-delete-marker: yes\r\n", "x-amz-delete-marker"),
    ("Last-Modified: yesterday\r\n", "last-modified"),
    (
      "x-amz-object-lock-retain-until-date: Mon, 16 Dec 2019 23:48:18 GMT\r\n",
      "x-amz-object-lock-retain-until-date",
    ),
  ] {
    let (line, name) = pair
    let _ = deserializeHeadObjectOutput(responseHead(200, line)) catch e {
      assert(contains(e.message(), name), "error ${e.message()} does not name ${name}")
      continue
    }
    panic("${name}: accepted a malformed value")
  }
}

fn abcSource(n: int): string! {
  return "abc"
}

test "a streaming output hands the body to its ByteStream, a string payload reads the text" {
  let h = responseHead(200, "Content-Length: 3\r\n")
  h.stream = Option.Some(abcSource)
  let obj = deserializeGetObjectOutput(h) catch e {
    panic("deserializeGetObjectOutput: ${e.message()}")
  }
  match (obj.body.source) {
    Some(_) => {}
    None => panic("the stream was not handed to the ByteStream")
  }
  vecSome(obj.contentLength, 3, "contentLength")
  let p = responseHead(200, "")
  p.text = "{\"Version\":\"2012-10-17\"}"
  let policy = deserializeGetBucketPolicyOutput(p) catch e {
    panic("deserializeGetBucketPolicyOutput: ${e.message()}")
  }
  vecSome(policy.policy, "{\"Version\":\"2012-10-17\"}", "policy")
}

test "attempts and retry delay travel into the metadata" {
  let h = responseHead(200, "x-amz-cf-id: cf1\r\n")
  h.attempts = 3
  h.totalRetryDelay = 250
  let out = deserializeHeadObjectOutput(h) catch e {
    panic("deserializeHeadObjectOutput: ${e.message()}")
  }
  assert(out.responseMetadata.attempts == 3, "attempts")
  assert(out.responseMetadata.totalRetryDelay == 250, "totalRetryDelay")
  assert(out.responseMetadata.cfId == "cf1", "cfId")
}

// Adds the header `name: value` to `h`, its name lower-cased as `responseHead` keeps it.
fn vecAdd(h: ResponseHead, name: string, value: string) {
  h.fields = append(h.fields, HeaderField{ name = toLower(name), value = value })
}

fn responseTestBody(route: int, h: ResponseHead): ByteStream! {
  if (route == 0) {
    return deserializeGetObjectOutput(h)?.body
  }
  if (route == 1) {
    return deserializeGetObjectAnnotationOutput(h)?.annotationPayload
  }
  return deserializeGetObjectTorrentOutput(h)?.body
}

fn responseTestReject(status: int, headers: string) {
  for route of [0, 1, 2] {
    let pulls = 0
    let closes = 0
    let h = responseHead(status, headers)
    h.stream = Option.Some((n) => {
      pulls = pulls + 1
      return "abc"
    })
    h.streamClose = Option.Some(() => {
      closes = closes + 1
    })
    let refused = false
    let _ = responseTestBody(route, h) catch _ {
      refused = true
      emptyStream()
    }
    closeResponseHead(h)
    assert(refused, "route ${route} accepted status ${status}, headers ${headers}")
    assert(pulls == 0 && closes == 1, "rejection never pulls and releases exactly once")
  }
}

fn responseTestSave(h: ResponseHead, path: string): ()! {
  let body = deserializeGetObjectOutput(h)?.body
  body.saveTo(path)?
}

test "header-only streaming errors preserve redirect region and support IDs without a body pull" {
  for status of [301, 404] {
    for route of [0, 1, 2] {
      let pulls = 0
      let closes = 0
      let h = responseHead(
        status,
          "X-Amz-Request-Id: support-request\r\nX-Amz-Id-2: support-host\r\n" +
          "X-Amz-Bucket-Region: eu-west-1\r\n",
      )
      h.stream = Option.Some((n) => {
        pulls = pulls + 1
        return "abc"
      })
      h.streamClose = Option.Some(() => {
        closes = closes + 1
      })
      let refused = false
      let _ = responseTestBody(route, h) catch e {
        let service = e.(S3Error)
        assert(service.status == status, "service status survives")
        assert(service.requestId == "support-request", "request ID survives")
        assert(service.extendedId == "support-host", "extended ID survives")
        assert(service.bucketRegion == "eu-west-1", "redirect region survives")
        refused = true
        emptyStream()
      }
      closeResponseHead(h)
      assert(refused && pulls == 0 && closes == 1, "error preserves lazy read and single release")
    }
  }
}

test "streaming deserializers reject error status before pulling or saving object bytes" {
  bodyTestRun(() => {
    let dir = bodyTestDir()?
    defer bodyTestCleanup(dir)
    for status of [199, 300, 404, 500] {
      responseTestReject(status, "Content-Length: 3\r\n")
      let h = responseHead(status, "Content-Length: 3\r\n")
      h.stream = Option.Some(bodyTestSource("abc"))
      let refused = false
      responseTestSave(h, dir + "/cover") catch _ {
        refused = true
      }
      assert(refused, "error status cannot produce a saveable output")
      assert(!exists(dir + "/cover") && len(readDir(dir)?) == 0, "no object or temporary file")
    }
  })
}

test "streaming construction rejects invalid lengths and checksum headers without a pull" {
  for header of [
    "Content-Length: ten\r\n",
    "Content-Length: -1\r\n",
    "Content-Length: ${maxStreamGetBytes + 1}\r\n",
    "Content-Length: 3\r\nContent-Length: 3\r\n",
    "x-amz-checksum-crc32: \r\n",
    "x-amz-checksum-crc32: !!!!!!!!\r\n",
    "x-amz-checksum-crc32: YWJj\r\n",
    "x-amz-checksum-crc32: NSRBwh==\r\n",
    "x-amz-checksum-crc32: NSRBwg==\r\nx-amz-checksum-crc32: NSRBwg==\r\n",
    "x-amz-checksum-crc32: NSRBwg==\r\nx-amz-checksum-type: COMPOSITE\r\n",
    "x-amz-checksum-crc32: NSRBwg==\r\nx-amz-checksum-type: UNKNOWN\r\n",
  ] {
    responseTestReject(200, header)
  }
}

test "a header failure after stream construction releases the response once" {
  let closes = 0
  let h = responseHead(200, "Content-Length: 3\r\nx-amz-delete-marker: invalid\r\n")
  h.stream = Option.Some(bodyTestSource("abc"))
  h.streamClose = Option.Some(() => {
    closes = closes + 1
  })
  let refused = false
  let _ = deserializeGetObjectOutput(h) catch _ {
    refused = true
    GetObjectOutput{ body = emptyStream() }
  }
  closeResponseHead(h)
  assert(refused && closes == 1, "later typed header failure closes once")
}

test "generated streaming responses validate length and checksum at EOF and release once" {
  bodyTestRun(() => {
    for route of [0, 1, 2] {
      let closes = 0
      let h = bodyTestHead("abc", "NSRBwg==")
      h.streamClose = Option.Some(() => {
        closes = closes + 1
      })
      let body = responseTestBody(route, h)?
      assert(closes == 0, "successful construction retains the source")
      assert(body.text(3)? == "abc", "validated response data")
      body.close()
      closeResponseHead(h)
      assert(closes == 1, "EOF and explicit close share one release")
    }
  })
}

test "generated response EOF failures reach the caller and close the source" {
  bodyTestRun(() => {
    for headers of [
      "Content-Length: 4\r\n",
      "Content-Length: 2\r\n",
      "Content-Length: 3\r\nx-amz-checksum-crc32: AAAAAA==\r\n",
    ] {
      let closes = 0
      let h = responseHead(200, headers)
      h.stream = Option.Some(bodyTestSource("abc"))
      h.streamClose = Option.Some(() => {
        closes = closes + 1
      })
      let body = deserializeGetObjectOutput(h)?.body
      let refused = false
      let _ = body.text(4) catch _ {
        refused = true
        ""
      }
      body.close()
      assert(refused && body.failed && closes == 1, "EOF failure reaches caller and closes once")
    }
  })
}
