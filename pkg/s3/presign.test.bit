// pkg/s3/presign.test.bit — presign.bit's query-string shape and signature,
// checked by recomputing the same AWS-vector-checked primitives
// (sigv4.test.bit) independently from the URL `presignGet`/`presignPut`
// produced, rather than by re-deriving the expected signature from
// presign.bit's own code path. AWS's public docs describe this query
// shape (`sigv4-query-string-auth.html`) but publish no worked numeric
// example the way the header-signing test suite does — sigv4.test.bit is
// where the numeric AWS vectors live.

test "presignGet carries the five X-Amz-* query parameters, plus the signature, in that sorted order" {
  let cfg = testConfig("http://127.0.0.1:9000")
  let url = presignGet(cfg, "cat.jpg", 3600) catch e {
    assert(false, "presignGet: ${e.message()}")
    return
  }
  assert(hasPrefix(url, "http://127.0.0.1:9000/photos/cat.jpg?"), "url = ${url}")
  assert(indexOf(url, "X-Amz-Algorithm=AWS4-HMAC-SHA256") >= 0, "url = ${url}")
  assert(indexOf(url, "X-Amz-Credential=AKIDEXAMPLE%2F") >= 0, "url = ${url}")
  assert(indexOf(url, "X-Amz-Expires=3600") >= 0, "url = ${url}")
  assert(indexOf(url, "X-Amz-SignedHeaders=host") >= 0, "url = ${url}")
  assert(indexOf(url, "X-Amz-Signature=") >= 0, "url = ${url}")
  // Sorted by encoded key, byte order: Algorithm < Credential < Date <
  // Expires < Signature < SignedHeaders ('a' < 'e' right after the shared
  // "X-Amz-Sign" prefix).
  assert(indexOf(url, "X-Amz-Algorithm") < indexOf(url, "X-Amz-Credential"), "sort order")
  assert(indexOf(url, "X-Amz-Expires") < indexOf(url, "X-Amz-Signature="), "sort order")
  assert(indexOf(url, "X-Amz-Signature=") < indexOf(url, "X-Amz-SignedHeaders"), "sort order")
}

test "presignPut signs method PUT, not GET, so a GET would fail against it" {
  let cfg = testConfig("http://127.0.0.1:9000")
  let getUrl = presignGet(cfg, "cat.jpg", 60) catch e {
    assert(false, "presignGet: ${e.message()}")
    return
  }
  let putUrl = presignPut(cfg, "cat.jpg", 60) catch e {
    assert(false, "presignPut: ${e.message()}")
    return
  }
  let getSig = getUrl[indexOf(getUrl, "X-Amz-Signature="):len(getUrl)]
  let putSig = putUrl[indexOf(putUrl, "X-Amz-Signature="):len(putUrl)]
  assert(getSig != putSig, "GET and PUT presigned the same object to the same signature")
}
