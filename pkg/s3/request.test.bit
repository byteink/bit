// pkg/s3/request.test.bit — #6620. The generated request serializers
// (gen_req_ops_*.bit) and the writers they are built from (request.bit):
// first the assertion helpers the restXml request vectors (gen_reqvec.test.bit)
// call, then the SDK behaviours the vectors do not cover: the path encoding of
// a key with `/`, a space and `+`, user metadata as `x-amz-meta-*` headers,
// `Expires` as an HTTP-date, an enum list header, the idempotency token, the
// literal query of the URI, the host prefix, and the refusals (an empty label,
// a CR or LF in a header value, a host label that is not one label).

import { contains, hasPrefix, join, split, toLower } from "std/strings"
import { sortInPlace } from "std/sort"
import { Timestamp } from "std/time"

const secondNs: int = 1000000000

fn vecMethod(req: RequestHead, want: string) {
  assert(req.method == want, "method ${req.method}, want ${want}")
}

fn vecPath(req: RequestHead, want: string) {
  assert(req.path == want, "path ${req.path}, want ${want}")
}

// `name=value` pairs of the rendered query string; a bare `name` is `name=`.
fn queryPairs(req: RequestHead): []string {
  let out = []string(0)
  let q = queryString(req)
  if (q == "") {
    return out
  }
  return split(q, "&")
}

fn normalizedPair(s: string): string {
  if (contains(s, "=")) {
    return s
  }
  return s + "="
}

fn sortedPairs(items: []string): []string {
  let out = []string(0)
  for s of items {
    out = append(out, normalizedPair(s))
  }
  sortInPlace(out, (a: string, b: string) => a < b)
  return out
}

// The query string holds exactly the listed pairs (a bare `name` is `name=`).
fn vecQuery(req: RequestHead, want: []string) {
  let got = join(sortedPairs(queryPairs(req)), "&")
  let exp = join(sortedPairs(want), "&")
  assert(got == exp, "query ${got}, want ${exp}")
}

fn queryKeys(req: RequestHead): []string {
  let keys = []string(0)
  for f of req.query {
    keys = append(keys, f.name)
  }
  return keys
}

fn hasQueryKey(keys: []string, key: string): bool {
  for k of keys {
    if (k == key) {
      return true
    }
  }
  return false
}

fn vecQueryHas(req: RequestHead, key: string) {
  assert(hasQueryKey(queryKeys(req), key), "query has no ${key}")
}

fn vecQueryLacks(req: RequestHead, key: string) {
  assert(!hasQueryKey(queryKeys(req), key), "query has ${key}, want none")
}

fn vecHeader(req: RequestHead, name: string, want: string) {
  match (sentHeader(req, toLower(name))) {
    Some(v) => assert(v == want, "header ${name}: \"${v}\", want \"${want}\"")
    None => panic("header ${name}: not sent")
  }
}

fn vecHeaderHas(req: RequestHead, name: string) {
  match (sentHeader(req, toLower(name))) {
    Some(_) => {}
    None => panic("header ${name}: not sent")
  }
}

fn vecHeaderLacks(req: RequestHead, name: string) {
  match (sentHeader(req, toLower(name))) {
    Some(v) => panic("header ${name}: sent as \"${v}\", want none")
    None => {}
  }
}

fn bodyText(b: Body): string {
  return match (b) {
    Empty => ""
    Text(t) => t
    Bytes(bs) => string(bs)
    _ => "<file or stream>"
  }
}

fn vecBody(req: RequestHead, want: string) {
  let got = bodyText(req.body)
  assert(got == want, "body \"${got}\", want \"${want}\"")
}

// The host prefix put in front of `host` makes `resolved`.
fn vecHost(req: RequestHead, host: string, resolved: string) {
  let got = req.hostPrefix + host
  assert(got == resolved, "host ${got}, want ${resolved}")
}

fn serialized(input: PutObjectInput): RequestHead {
  return serializePutObjectInput(input) catch e {
    panic("PutObject: ${e.message()}")
  }
}

test "a key with a slash, a space and a plus is encoded as the SDK writes it" {
  let req = serialized(PutObjectInput{ bucket = "photos", key = "cats/my cat+dog.jpg" })
  vecPath(req, "/photos/cats/my%20cat%2Bdog.jpg")
  vecMethod(req, "PUT")
  vecQuery(req, ["x-id=PutObject"])
}

test "a key with a unicode character, a percent sign and a leading slash" {
  let req = serialized(PutObjectInput{ bucket = "b", key = "/a%b/\xC3\xA9" })
  vecPath(req, "/b//a%25b/%C3%A9")
}

test "user metadata is sent as x-amz-meta headers, lower-cased, in key order" {
  let req = serialized(
    PutObjectInput{
      bucket = "b",
      key = "k",
      metadata = Option.Some(map<string, string>{ "b": "2", "A": "1" }),
    },
  )
  vecHeader(req, "x-amz-meta-a", "1")
  vecHeader(req, "x-amz-meta-b", "2")
  assert(
    req.fields[0].name == "x-amz-meta-A" || req.fields[0].name == "x-amz-meta-a",
    "first field",
  )
}

test "metadata {a: 1} emits the header x-amz-meta-a: 1" {
  let req = serialized(
    PutObjectInput{
      bucket = "b",
      key = "k",
      metadata = Option.Some(map<string, string>{ "a": "1" }),
    },
  )
  vecHeader(req, "x-amz-meta-a", "1")
}

test "Expires is written as an HTTP-date, a streaming body travels as the body" {
  let req = serialized(
    PutObjectInput{
      bucket = "b",
      key = "k",
      body = Body.Text("hello"),
      expires = Option.Some(Timestamp{ ns = 1576540098 * secondNs }),
      contentType = Option.Some("text/plain"),
      contentLength = Option.Some(5),
      storageClass = Option.Some(StorageClass.StandardIa),
    },
  )
  vecHeader(req, "expires", "Mon, 16 Dec 2019 23:48:18 GMT")
  vecHeader(req, "content-type", "text/plain")
  vecHeader(req, "content-length", "5")
  vecHeader(req, "x-amz-storage-class", "STANDARD_IA")
  vecBody(req, "hello")
}

test "an enum the model does not know is sent as the server named it" {
  let req = serialized(
    PutObjectInput{
      bucket = "b",
      key = "k",
      storageClass = Option.Some(StorageClass.Unknown("COLD_FUTURE")),
    },
  )
  vecHeader(req, "x-amz-storage-class", "COLD_FUTURE")
}

test "a long enum is written through its chained writers, first and last variant" {
  assert(wireChecksumAlgorithm(ChecksumAlgorithm.Crc32) == "CRC32", "first")
  assert(wireChecksumAlgorithm(ChecksumAlgorithm.Xxhash64) == "XXHASH64", "last")
  assert(wireChecksumAlgorithm(ChecksumAlgorithm.Unknown("X")) == "X", "unknown")
}

test "a list of enums is one header, the values joined with a comma and a space" {
  let req = serializeGetObjectAttributesInput(
    GetObjectAttributesInput{
      bucket = "b",
      key = "k",
      objectAttributes = [ObjectAttributes.Etag, ObjectAttributes.ObjectSize],
    },
  ) catch e {
    panic("GetObjectAttributes: ${e.message()}")
  }
  vecHeader(req, "x-amz-object-attributes", "ETag, ObjectSize")
  vecQuery(req, ["attributes="])
}

test "an unset idempotency token is a fresh UUID, a set one is sent as it is" {
  let a = serializeRenameObjectInput(
    RenameObjectInput{ bucket = "b", key = "k", renameSource = "s" },
  ) catch e {
    panic("RenameObject: ${e.message()}")
  }
  let token = unwrapOr(sentHeader(a, "x-amz-client-token"), "")
  assert(len(token) == 36 && token[14] == '4', "token ${token} is not a UUID v4")
  let b = serializeRenameObjectInput(
    RenameObjectInput{ bucket = "b", key = "k", renameSource = "s" },
  ) catch e {
    panic("RenameObject: ${e.message()}")
  }
  assert(
    sentHeader(b, "x-amz-client-token") != sentHeader(a, "x-amz-client-token"),
    "two tokens equal",
  )
  let c = serializeRenameObjectInput(
    RenameObjectInput{
      bucket = "b",
      key = "k",
      renameSource = "s",
      clientToken = Option.Some("mine"),
    },
  ) catch e {
    panic("RenameObject: ${e.message()}")
  }
  vecHeader(c, "x-amz-client-token", "mine")
}

test "the host prefix of WriteGetObjectResponse carries its label" {
  let req = serializeWriteGetObjectResponseInput(
    WriteGetObjectResponseInput{ requestRoute = "route-1", requestToken = "tok" },
  ) catch e {
    panic("WriteGetObjectResponse: ${e.message()}")
  }
  vecHost(
    req,
    "s3-object-lambda.us-east-1.amazonaws.com",
    "route-1.s3-object-lambda.us-east-1.amazonaws.com",
  )
  vecHeader(req, "x-amz-request-route", "route-1")
}

test "a host label that is not one DNS label is refused" {
  let _ = serializeWriteGetObjectResponseInput(
    WriteGetObjectResponseInput{ requestRoute = "evil.example.com/", requestToken = "tok" },
  ) catch e {
    assert(contains(e.message(), "host label"), "error ${e.message()}")
    return
  }
  panic("a host label with a dot and a slash was accepted")
}

test "an empty label is refused, never written as a double slash" {
  let _ = serializePutObjectInput(PutObjectInput{ bucket = "", key = "k" }) catch e {
    assert(
      contains(e.message(), "empty value provided for input HTTP label: Bucket"),
      "error ${e.message()}",
    )
    return
  }
  panic("an empty bucket was accepted")
}

test "a CR or LF in a header value is refused" {
  let _ = serializePutObjectInput(
    PutObjectInput{
      bucket = "b",
      key = "k",
      contentType = Option.Some("text/plain\r\nx-injected: 1"),
    },
  ) catch e {
    assert(contains(e.message(), "content-type"), "error ${e.message()}")
    return
  }
  panic("a header value with CR LF was accepted")
}

test "a metadata value with a line break is refused too" {
  let _ = serializePutObjectInput(
    PutObjectInput{
      bucket = "b",
      key = "k",
      metadata = Option.Some(map<string, string>{ "a": "1\nx-injected: 1" }),
    },
  ) catch e {
    assert(contains(e.message(), "x-amz-meta-a"), "error ${e.message()}")
    return
  }
  panic("a metadata value with LF was accepted")
}

test "timestamps by format: date-time drops a zero fraction, keeps milliseconds; epoch seconds" {
  let whole = Timestamp{ ns = 1576540098 * secondNs }
  let frac = Timestamp{ ns = 1576540098 * secondNs + 500000000 }
  let micro = Timestamp{ ns = 1576540098 * secondNs + 120456789 }
  assert(dateTimeText(whole) == "2019-12-16T23:48:18Z", "whole ${dateTimeText(whole)}")
  assert(dateTimeText(frac) == "2019-12-16T23:48:18.5Z", "half ${dateTimeText(frac)}")
  assert(dateTimeText(micro) == "2019-12-16T23:48:18.12Z", "milli ${dateTimeText(micro)}")
  assert(epochSecondsText(whole) == "1576540098", "epoch ${epochSecondsText(whole)}")
  assert(epochSecondsText(frac) == "1576540098.5", "epoch frac ${epochSecondsText(frac)}")
  assert(httpDateText(whole) == "Mon, 16 Dec 2019 23:48:18 GMT", "http ${httpDateText(whole)}")
}

test "the query string is rendered encoded, a literal key without a value as name=" {
  let req = requestHead("GET")
  queryLiteral(req, "uploads", "")
  queryLiteral(req, "prefix", "a b&c")
  assert(queryString(req) == "uploads=&prefix=a%20b%26c", "query ${queryString(req)}")
}

test "a literal query of the URI template is sent on every request of the operation" {
  let req = serializeCreateMultipartUploadInput(
    CreateMultipartUploadInput{ bucket = "b", key = "k" },
  ) catch e {
    panic("CreateMultipartUpload: ${e.message()}")
  }
  vecPath(req, "/b/k")
  assert(hasPrefix(queryString(req), "uploads="), "query ${queryString(req)}")
}
