// pkg/s3/response.bit — what the generated response deserializers
// (gen_resp_ops_*.bit, #6622) read: one response's status, header fields and
// body hand-off, plus the typed header readers they are written in. A
// deserializer fills every member of an output that travels in the status line
// or a header (and the metadata); the XML body of an output is not here, the
// XML deserializer fills those members from `text` after it.

import { BodySource } from "std/http"
import { hasPrefix, join, parseInt, split, toLower, trimSpace } from "std/strings"
import { Timestamp, parseEpochSeconds, parseHttpDate, parseRfc3339 } from "std/time"

// One response header, its name lower-cased.
class HeaderField {
  name: string,
  value: string,
}

// A response as the deserializers see it. `text` is the buffered body (the XML
// document, or a string payload); `stream` is the open body of a streaming
// output, handed to the output's `ByteStream` untouched. `attempts` and
// `totalRetryDelay` (milliseconds) come from the request pipeline.
class ResponseHead {
  status: int,
  fields: []HeaderField,
  text: string,
  stream: Option<BodySource>,
  attempts: int,
  totalRetryDelay: int,
}

// A head from a status and a raw header block ("Name: value\r\n" lines, as
// std/http hands them over). A line without a colon is not a header and is
// skipped; names are lower-cased and values trimmed.
fn responseHead(status: int, headers: string): ResponseHead {
  let fields = []HeaderField(0)
  for line of split(headers, "\n") {
    let at = colonAt(line)
    if (at > 0) {
      let name = toLower(trimSpace(line[0:at]))
      fields = append(fields, HeaderField{ name = name, value = trimSpace(line[at + 1:len(line)]) })
    }
  }
  return ResponseHead{
    status = status,
    fields = fields,
    text = "",
    stream = Option.None,
    attempts = 0,
    totalRetryDelay = 0,
  }
}

fn colonAt(line: string): int {
  let i = 0
  while (i < len(line)) {
    if (line[i] == ':') {
      return i
    }
    i = i + 1
  }
  return -1
}

// The value of header `name` (lower-case), None when absent. A field sent more
// than once reads as its values joined with ", ", the way HTTP defines it and
// the SDK's Node transport hands it over.
fn headerText(h: ResponseHead, name: string): Option<string> {
  let values = []string(0)
  for f of h.fields {
    if (f.name == name) {
      values = append(values, f.value)
    }
  }
  if (len(values) == 0) {
    return Option.None
  }
  return Option.Some(join(values, ", "))
}

// An integer header; a value that is not an integer fails, naming the header.
fn headerInt(h: ResponseHead, name: string): Option<int>! {
  let text = headerText(h, name)
  match (text) {
    None => return Option.None
    Some(s) => {
      let n = parseInt(s) catch _ {
        fail newError("header ${name}: \"${s}\" is not an integer")
      }
      return Option.Some(n)
    }
  }
}

// A boolean header: `true` or `false`, nothing else.
fn headerBool(h: ResponseHead, name: string): Option<bool>! {
  let text = headerText(h, name)
  match (text) {
    None => return Option.None
    Some(s) => {
      if (s == "true") {
        return Option.Some(true)
      }
      if (s == "false") {
        return Option.Some(false)
      }
      fail newError("header ${name}: \"${s}\" is not true or false")
    }
  }
}

// A timestamp header in HTTP-date form (the Smithy default for a header).
fn headerHttpDate(h: ResponseHead, name: string): Option<Timestamp>! {
  let text = headerText(h, name)
  match (text) {
    None => return Option.None
    Some(s) => {
      let t = parseHttpDate(s) catch _ {
        fail newError("header ${name}: \"${s}\" is not an HTTP date")
      }
      return Option.Some(t)
    }
  }
}

// A timestamp header in RFC 3339 `date-time` form.
fn headerDateTime(h: ResponseHead, name: string): Option<Timestamp>! {
  let text = headerText(h, name)
  match (text) {
    None => return Option.None
    Some(s) => {
      let t = parseRfc3339(s) catch _ {
        fail newError("header ${name}: \"${s}\" is not an RFC 3339 date-time")
      }
      return Option.Some(t)
    }
  }
}

// A timestamp header in epoch-seconds form.
fn headerEpoch(h: ResponseHead, name: string): Option<Timestamp>! {
  let text = headerText(h, name)
  match (text) {
    None => return Option.None
    Some(s) => {
      let t = parseEpochSeconds(s) catch _ {
        fail newError("header ${name}: \"${s}\" is not epoch seconds")
      }
      return Option.Some(t)
    }
  }
}

// The `Expires` header as a date, None when it is absent or is not an HTTP
// date. The SDK's s3-expires step keeps the raw text in `expiresString` and
// drops a value it cannot parse instead of failing the response (a bucket
// owner can put any text in Expires), so this never fails.
fn headerExpires(h: ResponseHead): Option<Timestamp> {
  let text = headerText(h, "expires")
  match (text) {
    None => return Option.None
    Some(s) => {
      let t = parseHttpDate(s) catch _ {
        return Option.None
      }
      return Option.Some(t)
    }
  }
}

// The headers named `prefix`* as a map from the rest of the name (lower-case)
// to the value. Always a map, empty when none matched, as the SDK returns
// `Metadata: {}`.
fn prefixedHeaders(h: ResponseHead, prefix: string): map<string, string> {
  let m = map<string, string>()
  for f of h.fields {
    if (hasPrefix(f.name, prefix)) {
      let key = f.name[len(prefix):len(f.name)]
      let merged = headerText(h, f.name)
      match (merged) {
        Some(v) => m[key] = v
        None => {}
      }
    }
  }
  return m
}

// The SDK's `$metadata` for this response.
fn responseMetadataOf(h: ResponseHead): ResponseMetadata {
  return ResponseMetadata{
    httpStatusCode = h.status,
    requestId = unwrapOr(headerText(h, "x-amz-request-id"), ""),
    extendedRequestId = unwrapOr(headerText(h, "x-amz-id-2"), ""),
    cfId = unwrapOr(headerText(h, "x-amz-cf-id"), ""),
    attempts = h.attempts,
    totalRetryDelay = h.totalRetryDelay,
  }
}

// The body of a streaming output that has not been handed one yet: the value a
// deserializer builds an output with before `fill*` sets the real stream.
fn emptyStream(): ByteStream {
  return ByteStream{ source = Option.None }
}

// An enum-valued header: `parse` turns the wire text into the variant, an
// unrecognised value into the enum's `Unknown`.
fn headerEnum<T>(h: ResponseHead, name: string, parse: (string) => T): Option<T> {
  let text = headerText(h, name)
  match (text) {
    None => return Option.None
    Some(s) => return Option.Some(parse(s))
  }
}
