// pkg/s3/metadata.bit — what every generated output carries beside its modeled
// members, the SDK's `$metadata`.

// Response-level facts. `attempts` and `totalRetryDelay` (milliseconds) are
// filled by the request pipeline; 0 / "" mean the response never carried them.
export class ResponseMetadata {
  export httpStatusCode: int,
  export requestId: string,
  export extendedRequestId: string,
  export cfId: string,
  export attempts: int,
  export totalRetryDelay: int,
}
