// pkg/s3/body.bit — the request and response body types the generated shapes
// name (gen_shapes_*.bit): `Body` on every input, `ByteStream` on every
// output. #6605 gives both their full behaviour (retry rules, lazy reads,
// checksum validation, atomic saveTo); until then they carry the data and
// nothing else, so the generated surface compiles and tests can build inputs.

import { BodySource } from "std/http"

// A request body. Text, Bytes and File are re-readable, so a retry can send
// them again; a Stream is pulled once. Empty is the zero value.
export enum Body {
  Empty,
  Text(string),
  Bytes([]byte),
  File(string),
  Stream(BodySource, Option<int>),
}

// A response body, delivered by the response deserializer.
export class ByteStream {
  export source: Option<BodySource>,
}
