// pkg/s3/checksum.test.bit — #6619. checksum.bit's decision and hashers.
//
// The vectors are the checksums of the ASCII bytes "Hello world" under every
// value of the model's ChecksumAlgorithm enum, in the base64 form S3 sends them.
// They were computed outside this repository, with CPython's hashlib and zlib,
// awscrt (CRC32C and CRC64NVME) and python-xxhash (the three xxHash values), so
// the implementation under test cannot vouch for itself.
//
// The table of operations is the SDK's: the 25 operations that require a
// checksum, the 6 that take an optional one and the 2 that only validate a
// response, written out here by name from the SDK's command definitions and then
// checked against the generated `checksumOperations` in both directions.

import { hasPrefix } from "std/strings"

const hello: string = "Hello world"

fn noBytes(n: int): string! {
  return ""
}

fn plan(
  op: string,
  mode: Checksums,
  requested: Option<ChecksumAlgorithm>,
  headers: []SigHeader,
  body: Body,
): ChecksumPlan {
  return planChecksum(op, mode, requested, headers, body) catch e {
    panic("planChecksum ${op}: ${e.message()}")
  }
}

fn simple(op: string, mode: Checksums): ChecksumPlan {
  return plan(op, mode, Option<ChecksumAlgorithm>.None, []SigHeader(0), Body.Text("x"))
}

fn valueOf(alg: ChecksumAlgorithm, data: []byte): string {
  return checksumOf(alg, data) catch e {
    panic("checksumOf: ${e.message()}")
  }
}

fn idOf(alg: ChecksumAlgorithm): string {
  return checksumAlgorithmId(alg) catch e {
    panic("id: ${e.message()}")
  }
}

fn skips(p: ChecksumPlan): bool {
  match (p.placement) {
    Skip => return true
    _ => return false
  }
}

fn isHeader(p: ChecksumPlan): bool {
  match (p.placement) {
    Header => return true
    _ => return false
  }
}

fn isTrailer(p: ChecksumPlan): bool {
  match (p.placement) {
    Trailer => return true
    _ => return false
  }
}

fn expectInvalid(
  op: string,
  requested: Option<ChecksumAlgorithm>,
  body: Body,
  want: string,
) {
  let _ = planChecksum(op, Checksums.WhenSupported, requested, []SigHeader(0), body) catch e {
    assert(contains(e.message(), want), "error ${e.message()} does not contain ${want}")
    match (e.kind) {
      InvalidInput(_) => return
      _ => panic("kind is not InvalidInput: ${e.message()}")
    }
  }
  panic("accepted, want an InvalidInput error containing ${want}")
}

const requiredOps: []string = [
  "CreateBucketMetadataConfiguration",
  "CreateBucketMetadataTableConfiguration",
  "DeleteObjects",
  "PutBucketAcl",
  "PutBucketCors",
  "PutBucketEncryption",
  "PutBucketLifecycleConfiguration",
  "PutBucketLogging",
  "PutBucketOwnershipControls",
  "PutBucketPolicy",
  "PutBucketReplication",
  "PutBucketRequestPayment",
  "PutBucketTagging",
  "PutBucketVersioning",
  "PutBucketWebsite",
  "PutObjectAcl",
  "PutObjectLegalHold",
  "PutObjectLockConfiguration",
  "PutObjectRetention",
  "PutObjectTagging",
  "PutPublicAccessBlock",
  "UpdateBucketMetadataAnnotationTableConfiguration",
  "UpdateBucketMetadataInventoryTableConfiguration",
  "UpdateBucketMetadataJournalTableConfiguration",
  "UpdateObjectEncryption",
]

const optionalOps: []string = [
  "PutBucketAbac",
  "PutBucketAccelerateConfiguration",
  "PutObject",
  "PutObjectAnnotation",
  "RestoreObject",
  "UploadPart",
]

const validateOps: []string = ["GetObject", "GetObjectAnnotation"]

test "Hello world checksums match the reference values for all ten algorithms" {
  let want = [
    (ChecksumAlgorithm.Crc32, "i9aeUg=="),
    (ChecksumAlgorithm.Crc32c, "crUfeA=="),
    (ChecksumAlgorithm.Crc64nvme, "OOJZ0D8xKts="),
    (ChecksumAlgorithm.Sha1, "e1AsOh9IyGCa4hLN+2Od7jlnP14="),
    (ChecksumAlgorithm.Sha256, "ZOyIygCyaOW6GjVnihtTFtIS9PNmskdyMlNKiuyjfzw="),
    (
      ChecksumAlgorithm.Sha512,
      "t/eDuu2Cl/DbkXRiGE/08I5pwtXl95qUJgD5cl9Yzh8pwYE5v4CwbA//K900c4RS7PQMSIwip+PYDN9vnBwNRw==",
    ),
    (ChecksumAlgorithm.Md5, "PiWWCnnbxptnTNTsZ6csYg=="),
    (ChecksumAlgorithm.Xxhash64, "xQCwyRKzdtg="),
    (ChecksumAlgorithm.Xxhash3, "tqy52Eo4/3Q="),
    (ChecksumAlgorithm.Xxhash128, "c1H4mBL5c4K5HQWzHgTdfw=="),
  ]
  let ok = 0
  for (alg, value) of want {
    let got = valueOf(alg, []byte(hello))
    assert(got == value, "${idOf(alg)} of Hello world: ${got}, want ${value}")
    ok = ok + 1
  }
  assert(ok == 10, "vectors ${ok} of 10")
  println("Hello world vectors: ${ok} of 10")
}

test "every algorithm of the model enum is implemented, in the model's list" {
  assert(len(checksumAlgorithms()) == 10, "algorithms ${len(checksumAlgorithms())}")
  assert(len(checksumIds) == 10, "ids ${len(checksumIds)}")
  let i = 0
  while (i < 10) {
    assert(
      parseChecksumAlgorithm(checksumIds[i]) == checksumAlgorithms()[i],
      "${checksumIds[i]} does not parse to its algorithm",
    )
    assert(idOf(checksumAlgorithms()[i]) == checksumIds[i], "id of ${i}")
    i = i + 1
  }
}

test "a chunked hash equals the one-shot hash, whatever the chunks, and reset starts over" {
  let data = []byte(1000)
  let i = 0
  while (i < 1000) {
    data[i] = byte((i * 31 + 7) % 251)
    i = i + 1
  }
  let checked = 0
  for alg of checksumAlgorithms() {
    let whole = valueOf(alg, data)
    let h = checksumHasher(alg) catch e {
      panic("hasher: ${e.message()}")
    }
    let at = 0
    while (at < 1000) {
      let n = 1 + at * 7 % 97
      if (at + n > 1000) {
        n = 1000 - at
      }
      h.write(data[at:at + n])
      at = at + n
    }
    assert(checksumValue(h) == whole, "chunked ${idOf(alg)} differs from one-shot")
    assert(checksumValue(h) == whole, "reading the value changed the hasher")
    h.reset()
    h.write(data)
    assert(checksumValue(h) == whole, "reset ${idOf(alg)} did not start over")
    checked = checked + 1
  }
  assert(checked == 10, "checked ${checked} of 10")
}

test "an Unknown algorithm is an InvalidInput error, never a wrong hash" {
  let u = ChecksumAlgorithm.Unknown("CRC128")
  let _ = checksumOf(u, []byte(hello)) catch e {
    assert(contains(e.message(), "not supported"), "error ${e.message()}")
    return
  }
  panic("an Unknown algorithm was calculated")
}

test "the SDK's operation table: 33 operations under both modes, 66 of 66 cells" {
  assert(len(requiredOps) == 25 && len(optionalOps) == 6 && len(validateOps) == 2, "table sizes")
  assert(len(checksumOperations) == 33, "generated rows ${len(checksumOperations)}")
  let cells = 0
  for op of requiredOps {
    for mode of [Checksums.WhenSupported, Checksums.WhenRequired] {
      let p = simple(op, mode)
      assert(isHeader(p) && p.header == "x-amz-checksum-crc32", "${op} required: ${p.header}")
      cells = cells + 1
    }
  }
  for op of optionalOps {
    let on = simple(op, Checksums.WhenSupported)
    assert(isHeader(on) && on.header == "x-amz-checksum-crc32", "${op} supported: ${on.header}")
    let off = simple(op, Checksums.WhenRequired)
    assert(skips(off) && off.header == "", "${op} WhenRequired: ${off.header}")
    cells = cells + 2
  }
  for op of validateOps {
    assert(skips(simple(op, Checksums.WhenSupported)), "${op} WhenSupported")
    assert(skips(simple(op, Checksums.WhenRequired)), "${op} WhenRequired")
    cells = cells + 2
  }
  assert(cells == 66, "cells ${cells} of 66")
  println("operation cells: ${cells} of 66")
}

test "the SDK's lists and the generated table name the same operations" {
  let named = 0
  for row of checksumOperations {
    let name = split(row, "|")[0]
    let found = 0
    for lists of [requiredOps, optionalOps, validateOps] {
      for op of lists {
        if (op == name) {
          found = found + 1
        }
      }
    }
    assert(found == 1, "${name} is in ${found} of the SDK's lists")
    named = named + 1
  }
  assert(named == 33, "named ${named} of 33")
}

test "an operation with no checksum member carries none, whatever the caller asks" {
  let want = Option<ChecksumAlgorithm>.Some(ChecksumAlgorithm.Sha256)
  for op of ["ListBuckets", "GetObject", "NoSuchOperation"] {
    let p = plan(op, Checksums.WhenSupported, want, []SigHeader(0), Body.Text("x"))
    assert(skips(p), "${op} got a checksum")
  }
}

test "the caller's algorithm wins, under both modes, even where the checksum is optional" {
  let want = Option<ChecksumAlgorithm>.Some(ChecksumAlgorithm.Sha256)
  for mode of [Checksums.WhenSupported, Checksums.WhenRequired] {
    let p = plan("PutObject", mode, want, []SigHeader(0), Body.Text("x"))
    assert(isHeader(p), "PutObject placement")
    assert(p.header == "x-amz-checksum-sha256", "header ${p.header}")
    assert(p.algorithmId == "SHA256", "algorithm ${p.algorithmId}")
  }
}

test "every algorithm's header is x-amz-checksum- and its lower-case name" {
  let want = [
    "x-amz-checksum-crc32",
    "x-amz-checksum-crc32c",
    "x-amz-checksum-crc64nvme",
    "x-amz-checksum-sha1",
    "x-amz-checksum-sha256",
    "x-amz-checksum-sha512",
    "x-amz-checksum-md5",
    "x-amz-checksum-xxhash64",
    "x-amz-checksum-xxhash3",
    "x-amz-checksum-xxhash128",
  ]
  let i = 0
  for alg of checksumAlgorithms() {
    let p = plan(
      "PutObject",
      Checksums.WhenRequired,
      Option<ChecksumAlgorithm>.Some(alg),
      []SigHeader(0),
      Body.Empty,
    )
    assert(p.header == want[i], "header of ${checksumIds[i]}: ${p.header}")
    assert(p.algorithmId == checksumIds[i], "id of ${checksumIds[i]}: ${p.algorithmId}")
    i = i + 1
  }
  assert(i == 10, "algorithms ${i} of 10")
}

test "a request that already has a checksum header is left alone, in any case" {
  let names = ["x-amz-checksum-crc32", "X-Amz-Checksum-SHA256", "x-amz-checksum-xxhash3"]
  for name of names {
    let headers = [SigHeader{ name = name, value = "AAAAAA==" }]
    let p = plan(
      "PutObject",
      Checksums.WhenSupported,
      Option<ChecksumAlgorithm>.None,
      headers,
      Body.Text("x"),
    )
    assert(skips(p), "${name} was not left alone")
    let r = plan(
      "DeleteObjects",
      Checksums.WhenRequired,
      Option<ChecksumAlgorithm>.None,
      headers,
      Body.Text("x"),
    )
    assert(skips(r), "${name} on a required operation was not left alone")
  }
  let other = [
    SigHeader{ name = "x-amz-checksum", value = "v" },
    SigHeader{ name = "content-md5", value = "v" },
  ]
  let p = plan(
    "PutObject",
    Checksums.WhenSupported,
    Option<ChecksumAlgorithm>.None,
    other,
    Body.Text("x"),
  )
  assert(isHeader(p), "headers that are not x-amz-checksum-* stopped the checksum")
}

test "a body in memory gets a header, a file or a stream a trailer" {
  let none = Option<ChecksumAlgorithm>.None
  let src = Body.Stream(noBytes, Option<int>.Some(5))
  assert(
    isHeader(plan("PutObject", Checksums.WhenSupported, none, []SigHeader(0), Body.Empty)),
    "empty",
  )
  assert(
    isHeader(plan("PutObject", Checksums.WhenSupported, none, []SigHeader(0), Body.Text("x"))),
    "text",
  )
  assert(
    isHeader(plan("PutObject", Checksums.WhenSupported, none, []SigHeader(0), Body.Bytes([1, 2]))),
    "bytes",
  )
  assert(
    isTrailer(plan("PutObject", Checksums.WhenSupported, none, []SigHeader(0), Body.File("/data/x"))),
    "file",
  )
  assert(
    isTrailer(plan("PutObject", Checksums.WhenSupported, none, []SigHeader(0), src)),
    "stream",
  )
}

test "a stream of unknown length that needs a checksum is an InvalidInput error" {
  let src = Body.Stream(noBytes, Option<int>.None)
  let none = Option<ChecksumAlgorithm>.None
  expectInvalid("PutObject", none, src, "needs the length")
  assert(
    skips(plan("PutObject", Checksums.WhenRequired, none, []SigHeader(0), src)),
    "WhenRequired sends none",
  )
  assert(
    skips(plan("ListBuckets", Checksums.WhenSupported, none, []SigHeader(0), src)),
    "no member, no error",
  )
}

test "an Unknown algorithm named by the caller fails the plan" {
  let u = Option<ChecksumAlgorithm>.Some(ChecksumAlgorithm.Unknown("CRC128"))
  expectInvalid("PutObject", u, Body.Text("x"), "not supported")
}

test "a header plan adds the algorithm and the checksum of the body" {
  let p = simple("DeleteObjects", Checksums.WhenSupported)
  let body = Body.Text(hello)
  let hs = checksumHeaders(p, body) catch e {
    panic("checksumHeaders: ${e.message()}")
  }
  assert(len(hs) == 2, "headers ${len(hs)}")
  assert(hs[0].name == "x-amz-sdk-checksum-algorithm" && hs[0].value == "CRC32", "algorithm header")
  assert(
    hs[1].name == "x-amz-checksum-crc32" && hs[1].value == "i9aeUg==",
    "checksum ${hs[1].value}",
  )
  let empty = plan(
    "PutObject",
    Checksums.WhenSupported,
    Option<ChecksumAlgorithm>.None,
    []SigHeader(0),
    Body.Empty,
  )
  let es = checksumHeaders(empty, Body.Empty) catch e {
    panic("checksumHeaders: ${e.message()}")
  }
  assert(es[1].value == "AAAAAA==", "empty body ${es[1].value}")
  let bs = Body.Bytes([]byte(hello))
  let ms = plan(
    "PutObject",
    Checksums.WhenSupported,
    Option<ChecksumAlgorithm>.Some(ChecksumAlgorithm.Md5),
    []SigHeader(0),
    bs,
  )
  let mh = checksumHeaders(ms, bs) catch e {
    panic("checksumHeaders: ${e.message()}")
  }
  assert(
    mh[1].name == "x-amz-checksum-md5" && mh[1].value == "PiWWCnnbxptnTNTsZ6csYg==",
    "md5 ${mh[1].name}",
  )
}

test "a trailer plan adds the algorithm and names the trailer, hashing nothing yet" {
  let src = Body.File("/data/x")
  let p = plan(
    "PutObject",
    Checksums.WhenSupported,
    Option<ChecksumAlgorithm>.None,
    []SigHeader(0),
    src,
  )
  let hs = checksumHeaders(p, src) catch e {
    panic("checksumHeaders: ${e.message()}")
  }
  assert(len(hs) == 2, "headers ${len(hs)}")
  assert(hs[0].name == "x-amz-sdk-checksum-algorithm" && hs[0].value == "CRC32", "algorithm header")
  assert(hs[1].name == "x-amz-trailer" && hs[1].value == "x-amz-checksum-crc32", "trailer header")
  let none = plan(
    "PutObject",
    Checksums.WhenRequired,
    Option<ChecksumAlgorithm>.None,
    []SigHeader(0),
    src,
  )
  let ns = checksumHeaders(none, src) catch e {
    panic("checksumHeaders: ${e.message()}")
  }
  assert(len(ns) == 0, "a Skip plan added ${len(ns)} headers")
}

test "the trailer path is driven through the hasher the plan names" {
  let src = Body.File("/data/x")
  let p = plan(
    "PutObject",
    Checksums.WhenSupported,
    Option<ChecksumAlgorithm>.Some(ChecksumAlgorithm.Crc64nvme),
    []SigHeader(0),
    src,
  )
  let h = checksumHasher(p.algorithm) catch e {
    panic("hasher: ${e.message()}")
  }
  h.write([]byte("Hello "))
  h.write([]byte("world"))
  assert(checksumValue(h) == "OOJZ0D8xKts=", "trailer value ${checksumValue(h)}")
  assert(hasPrefix(p.header, "x-amz-checksum-"), "trailer name ${p.header}")
}

test "the calculation mode reads the environment spellings and refuses the rest" {
  let a = parseChecksums("WHEN_SUPPORTED") catch e {
    panic("parse: ${e.message()}")
  }
  let b = parseChecksums("when_required") catch e {
    panic("parse: ${e.message()}")
  }
  assert(a == Checksums.WhenSupported, "WHEN_SUPPORTED")
  assert(b == Checksums.WhenRequired, "when_required")
  let _ = parseChecksums("always") catch e {
    assert(contains(e.message(), "WHEN_SUPPORTED or WHEN_REQUIRED"), "error ${e.message()}")
    return
  }
  panic("parseChecksums accepted always")
}
