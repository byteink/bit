  xmlPutEnum(w, "Frequency", xmlNoAttrs(), v.frequency, wireInventoryFrequency)?
  w.end()?
}

// com.amazonaws.s3#InventoryTableConfiguration
fn xmlPutInventoryTableConfiguration(
  w: Writer,
  name: string,
  attrs: []Attr,
  v: InventoryTableConfiguration,
): ()! {
  w.start(name, attrs)?
  xmlPutEnum(
    w,
    "ConfigurationState",
    xmlNoAttrs(),
    v.configurationState,
    wireInventoryConfigurationState,
  )?
  xmlPutSome(
    w,
    "EncryptionConfiguration",
    xmlNoAttrs(),
    v.encryptionConfiguration,
    xmlPutMetadataTableEncryptionConfiguration,
  )?
  w.end()?
}

// com.amazonaws.s3#InventoryTableConfigurationUpdates
fn xmlPutInventoryTableConfigurationUpdates(
  w: Writer,
