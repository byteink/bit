    xmlPutMetadataTableEncryptionConfiguration,
  )?
  w.end()?
}

// com.amazonaws.s3#JSONInput
fn xmlPutJSONInput(w: Writer, name: string, attrs: []Attr, v: JSONInput): ()! {
  w.start(name, attrs)?
  xmlPutEnumSome(w, "Type", xmlNoAttrs(), v.type_, wireJSONType)?
  w.end()?
}

// com.amazonaws.s3#JSONOutput
fn xmlPutJSONOutput(w: Writer, name: string, attrs: []Attr, v: JSONOutput): ()! {
  w.start(name, attrs)?
  xmlPutSome(w, "RecordDelimiter", xmlNoAttrs(), v.recordDelimiter, xmlPutStr)?
  w.end()?
}

// com.amazonaws.s3#JournalTableConfiguration
fn xmlPutJournalTableConfiguration(
  w: Writer,
  name: string,
  attrs: []Attr,
  v: JournalTableConfiguration,
): ()! {
  w.start(name, attrs)?
  xmlPutSome(
    w,
    "EncryptionConfiguration",
    xmlNoAttrs(),
    v.encryptionConfiguration,
    xmlPutMetadataTableEncryptionConfiguration,
  )?
  xmlPutRecordExpiration(w, "RecordExpiration", xmlNoAttrs(), v.recordExpiration)?
  w.end()?
}
