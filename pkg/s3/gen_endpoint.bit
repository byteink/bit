// One scheme the endpoint is signed with. An absent signing region is "" and
// an absent region set is empty. Every scheme of the rule set carries
// disableDoubleEncoding, which S3 signs with (the path is encoded once).
class EndpointAuthScheme {
  name: string,
  signingName: string,
  signingRegion: string,
  signingRegionSet: []string,
  disableDoubleEncoding: bool,
}

// The endpoint a walk resolves to: the URL, the "backend" property ("" when
// absent) and the auth schemes in the order the rule lists them.
class EndpointResult {
  url: string,
  backend: string,
  authSchemes: []EndpointAuthScheme,
}

fn endpointAuth(
  name: string,
  signingName: string,
  signingRegion: string,
  signingRegionSet: []string,
): EndpointAuthScheme {
  return EndpointAuthScheme{
    name = name,
    signingName = signingName,
    signingRegion = signingRegion,
    signingRegionSet = signingRegionSet,
    disableDoubleEncoding = true,
  }
}

fn endpointOk(url: string, backend: string, authSchemes: []EndpointAuthScheme): EndpointResult {
  return EndpointResult{ url = url, backend = backend, authSchemes = authSchemes }
}

// The next reference after node ref: the high edge when the condition holds
// and the edge is not complemented, or fails and is; the low edge otherwise.
fn endpointNext(ref: int, passed: bool, at: int): int {
  let forward = ref > 0
  if (forward == passed) {
    return endpointBddNodes[at + 1]
  }
  return endpointBddNodes[at + 2]
}

// Walks the decision diagram for p: the endpoint, or the error text of the
// rule that matched. At most endpointBddNodeCount steps, never a recursion.
fn endpointDecide(p: EndpointParams): EndpointResult! {
  let s = endpointStateInit()
  let ref = endpointBddRoot
  let steps = 0
  while (ref != 1 && ref != -1 && ref < endpointResultBase) {
    steps = steps + 1
    if (steps > endpointBddNodeCount) {
      fail newError("endpoint: the decision diagram walk exceeded its node count")
    }
    let node = ref
    if (node < 0) {
      node = -node
    }
    let at = 3 * (node - 1)
    ref = endpointNext(ref, endpointCondAt(endpointBddNodes[at], p, s), at)
  }
  if (ref > endpointResultBase) {
    return endpointResultAt(ref - endpointResultBase, p, s)?
  }
  fail newError("No matching endpoint.")
}
