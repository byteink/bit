// pkg/s3/presign.bit — presigned GET/PUT URLs: a URL that carries its own
// SigV4 signature in the query string (AWS's query-string signing variant,
// distinct from the header-based signing `client.bit`'s `signedRequest`
// uses) valid for `expiresSeconds` from the moment it is generated. Handing
// this URL to a browser lets it PUT/GET directly against the bucket
// without the object's bytes ever passing through this process.
//
// Reuses the exact same four SigV4 primitives `signedRequest` does
// (`canonicalRequest`/`stringToSign`/`signingKey`/`signature`, sigv4.bit,
// checked against AWS's own test suite there) — only which parameters
// carry the signature differs: a query string here, an `Authorization`
// header there. The payload hash is always `unsignedPayload`
// (`UNSIGNED-PAYLOAD`), AWS's own documented placeholder for a presigned
// URL, since the body is not known — or does not exist yet — when the URL
// is generated.

import {
  amzTimestamps,
  canonicalQueryString,
  canonicalRequest,
  credentialScope,
  parseEndpoint,
  SigHeader,
  signature,
  signedHostValue,
  signingKey,
  stringToSign,
  unsignedPayload,
} from "aws"

const presignedSignedHeaders: string = "host"

fn presignedUrl(cfg: Config, method: string, key: string, expiresSeconds: int): string! {
  let parts = parseEndpoint(cfg.endpoint)?
  let (dateStamp, amzDate) = amzTimestamps()
  let scope = credentialScope(dateStamp, cfg.region, "s3")
  let path = objectPath(cfg.bucket, key)
  let host = signedHostValue(parts)

  let params = [
    ("X-Amz-Algorithm", "AWS4-HMAC-SHA256"),
    ("X-Amz-Credential", "${cfg.accessKeyId}/${scope}"),
    ("X-Amz-Date", amzDate),
    ("X-Amz-Expires", "${expiresSeconds}"),
    ("X-Amz-SignedHeaders", presignedSignedHeaders),
  ]
  let sigHeaders = [SigHeader{ name = "host", value = host }]
  let creq = canonicalRequest(method, path, params, sigHeaders, unsignedPayload)
  let sts = stringToSign(amzDate, scope, creq)
  let signingKeyBytes = signingKey(cfg.secretKey, dateStamp, cfg.region, "s3")
  let sig = signature(signingKeyBytes, sts)

  let signedParams = append(params, ("X-Amz-Signature", sig))
  return requestUrl(parts, path, canonicalQueryString(signedParams))
}

// A URL that lets its holder GET `key` without any credential of their own,
// until `expiresSeconds` after generation.
export fn presignGet(cfg: Config, key: string, expiresSeconds: int): string! {
  return presignedUrl(cfg, "GET", key, expiresSeconds)?
}

// A URL that lets its holder PUT `key` (with any body — the presigned URL
// does not pin a payload hash, `unsignedPayload`) without any credential of
// their own, until `expiresSeconds` after generation.
export fn presignPut(cfg: Config, key: string, expiresSeconds: int): string! {
  return presignedUrl(cfg, "PUT", key, expiresSeconds)?
}
