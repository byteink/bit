// pkg/s3/streaming.test.bit — putStream/getStream at the unit level:
// proving the signed request `signedRequest` builds for a streaming call
// carries `unsignedPayload`, the way client.test.bit already proves it for
// the in-memory calls. The actual streamed bytes over a real connection are
// client.live.test.bit's job (a 200+ MiB object, peak RSS asserted well
// under that).

test "a streaming PUT signs with unsignedPayload, not a real content hash" {
  let cfg = Config{
    endpoint = "http://127.0.0.1:9000",
    region = "us-east-1",
    bucket = "photos",
    accessKeyId = "AKIDEXAMPLE",
    secretKey = "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
  }
  let (url, headers) = signedRequest(
    cfg,
    "PUT",
    objectPath(cfg.bucket, "big.bin"),
    [](string, string)(0),
    unsignedPayload,
  ) catch e {
    assert(false, "signedRequest: ${e.message()}")
    return
  }
  assert(url == "http://127.0.0.1:9000/photos/big.bin", "url = ${url}")
  let sha = headers[0]
  assert(sha.name == "x-amz-content-sha256", "unexpected header ${sha.name}")
  assert(sha.value == "UNSIGNED-PAYLOAD", "value = ${sha.value}")
}

test "BodySource/BodySink pull and push bounded chunks (fake, no network)" {
  let data = "0123456789"
  let pos = 0
  let source: BodySource = (n) => {
    if (pos >= len(data)) {
      return ""
    }
    let end = pos + n
    if (end > len(data)) {
      end = len(data)
    }
    let out = data[pos:end]
    pos = end
    return out
  }
  let collected = ""
  let sink: BodySink = (chunk) => {
    collected = collected + chunk
  }
  let first = source(4) catch e {
    assert(false, "source: ${e.message()}")
    return
  }
  let second = source(4) catch e {
    assert(false, "source: ${e.message()}")
    return
  }
  let rest = source(4) catch e {
    assert(false, "source: ${e.message()}")
    return
  }
  sink(first) catch e {
    assert(false, "sink: ${e.message()}")
    return
  }
  sink(second) catch e {
    assert(false, "sink: ${e.message()}")
    return
  }
  sink(rest) catch e {
    assert(false, "sink: ${e.message()}")
    return
  }
  assert(collected == data, "collected = ${collected}")
}
