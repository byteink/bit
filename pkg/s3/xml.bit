// pkg/s3/xml.bit — minimal, S3-response-shaped XML text extraction. Not a
// general XML parser: every S3-compatible response this package reads
// (ListObjectsV2, InitiateMultipartUpload, CompleteMultipartUpload, the
// <Error> body) is flat, well-formed UTF-8 with no CDATA and no sibling
// elements sharing a tag name within the same block — a full parser is a
// real follow-up if a server is ever found that needs one (#6078's own gap
// list), not built here.

import { indexOfFrom, replace } from "std/strings"

// The five XML-reserved characters, unescaped — S3 element text (an object
// key with a literal `&` or `<` in it, for instance) is escaped on the way
// out and must be reversed on the way back.
fn xmlUnescape(s: string): string {
  let out = replace(s, "&lt;", "<")
  out = replace(out, "&gt;", ">")
  out = replace(out, "&quot;", "\"")
  out = replace(out, "&apos;", "'")
  return replace(out, "&amp;", "&")
}

// The text between the first `<tag>...</tag>` in `xml` at or after
// `startAt`, and the byte offset just past `</tag>` — `("", -1)` if the tag
// is not found at or after `startAt`. Unescaped on the way out.
fn xmlFindTag(xml: string, tag: string, startAt: int): (string, int) {
  let openTag = "<${tag}>"
  let closeTag = "</${tag}>"
  let start = indexOfFrom(xml, openTag, startAt)
  if (start < 0) {
    return ("", -1)
  }
  let contentStart = start + len(openTag)
  let end = indexOfFrom(xml, closeTag, contentStart)
  if (end < 0) {
    return ("", -1)
  }
  return (xmlUnescape(xml[contentStart:end]), end + len(closeTag))
}

// As `xmlFindTag`, but "" (not a failure) when the tag is absent — some
// child elements (e.g. `NextContinuationToken`) are only present some of
// the time.
fn xmlTagOr(xml: string, tag: string, startAt: int, fallback: string): string {
  let (text, end) = xmlFindTag(xml, tag, startAt)
  if (end < 0) {
    return fallback
  }
  return text
}
