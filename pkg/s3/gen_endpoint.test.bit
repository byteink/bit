// pkg/s3/gen_endpoint.test.bit — the generated endpoint walker (gen_endpoint*.bit,
// #6592) against the 393 endpoint tests of the S3 model, which gen_endpoint_cases.bit
// carries as data: every case's params go through `endpointDecide`, and the URL,
// the auth schemes and the "backend" property it returns, or the error text it
// fails with, must be what the case expects. The operation inputs of a case
// (client config and operation parameters turned into rule parameters) are
// #6623's, not read here.

import { Json, JsonEntry, jsonGet, jsonParse } from "std/json"
import { join } from "std/strings"

class WalkVectors {
  passed: int,
  total: int,
  failures: []string,
}

fn walkVectors(): WalkVectors {
  return WalkVectors{ passed = 0, total = 0, failures = []string(0) }
}

fn field(j: Json, key: string): Json {
  return match (jsonGet(j, key)) {
    Some(v) => v
    None => Json.JsonNull
  }
}

fn jsonText(j: Json): Option<string> {
  return match (j) {
    JsonString(s) => Option<string>.Some(s)
    _ => Option<string>.None
  }
}

fn jsonFlag(j: Json): Option<bool> {
  return match (j) {
    JsonBool(b) => Option<bool>.Some(b)
    _ => Option<bool>.None
  }
}

fn jsonList(j: Json): []Json {
  return match (j) {
    JsonArray(items) => items
    _ => []Json(0)
  }
}

fn jsonEntries(j: Json): []JsonEntry {
  return match (j) {
    JsonObject(entries) => entries
    _ => []JsonEntry(0)
  }
}

fn textOf(j: Json): string {
  return coalesce(jsonText(j), "")
}

// Sets string parameter `key` of `p`; false when `key` is not one.
fn setStringParam(p: EndpointParams, key: string, v: string): bool {
  let some = Option<string>.Some(v)
  if (key == "Bucket") {
    p.bucket = some
  } else if (key == "Region") {
    p.region = some
  } else if (key == "Endpoint") {
    p.endpoint = some
  } else if (key == "Key") {
    p.key = some
  } else if (key == "Prefix") {
    p.prefix = some
  } else if (key == "CopySource") {
    p.copySource = some
  } else {
    return false
  }
  return true
}

// Sets the required boolean parameter `key` of `p`; false when `key` is not one.
fn setRequiredFlag(p: EndpointParams, key: string, v: bool): bool {
  if (key == "UseFIPS") {
    p.useFIPS = v
  } else if (key == "UseDualStack") {
    p.useDualStack = v
  } else if (key == "ForcePathStyle") {
    p.forcePathStyle = v
  } else if (key == "Accelerate") {
    p.accelerate = v
  } else if (key == "UseGlobalEndpoint") {
    p.useGlobalEndpoint = v
  } else if (key == "DisableMultiRegionAccessPoints") {
    p.disableMultiRegionAccessPoints = v
  } else {
    return false
  }
  return true
}

// Sets the optional boolean parameter `key` of `p`; false when `key` is not one.
fn setOptionalFlag(p: EndpointParams, key: string, v: bool): bool {
  let some = Option<bool>.Some(v)
  if (key == "UseObjectLambdaEndpoint") {
    p.useObjectLambdaEndpoint = some
  } else if (key == "DisableAccessPoints") {
    p.disableAccessPoints = some
  } else if (key == "UseArnRegion") {
    p.useArnRegion = some
  } else if (key == "UseS3ExpressControlEndpoint") {
    p.useS3ExpressControlEndpoint = some
  } else if (key == "DisableS3ExpressSessionAuth") {
    p.disableS3ExpressSessionAuth = some
  } else {
    return false
  }
  return true
}

// Sets parameter `e.key` of `p` from its JSON value; false when the key or the value's type is unknown.
fn setParam(p: EndpointParams, e: JsonEntry): bool {
  match (e.value) {
    JsonString(s) => return setStringParam(p, e.key, s)
    JsonBool(b) => return setRequiredFlag(p, e.key, b) || setOptionalFlag(p, e.key, b)
    _ => return false
  }
}

fn caseParams(c: Json): EndpointParams {
  let p = defaultEndpointParams()
  for e of jsonEntries(field(c, "params")) {
    assert(setParam(p, e), "unknown parameter ${e.key}")
  }
  return p
}

fn schemeText(a: EndpointAuthScheme): string {
  return "${a.name}|${a.signingName}|${a.signingRegion}|${join(a.signingRegionSet, ",")}|${a.disableDoubleEncoding}"
}

// The scheme of the model's `authSchemes` entry `j`, as `schemeText` writes it.
fn expectedScheme(j: Json): string {
  let set = []string(0)
  for r of jsonList(field(j, "signingRegionSet")) {
    set = append(set, textOf(r))
  }
  let dde = coalesce(jsonFlag(field(j, "disableDoubleEncoding")), false)
  return "${textOf(field(j, "name"))}|${textOf(field(j, "signingName"))}|${textOf(
    field(j, "signingRegion"),
  )}|${join(set, ",")}|${dde}"
}

fn schemesOk(got: EndpointResult, want: Json): bool {
  let items = jsonList(field(want, "authSchemes"))
  if (len(items) != len(got.authSchemes)) {
    return false
  }
  let i = 0
  while (i < len(items)) {
    if (schemeText(got.authSchemes[i]) != expectedScheme(items[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

// `url` without one trailing "/". `parseURL` gives an empty path as "/" (the
// Smithy rules-engine page and the SDK's `pathname`), so a rule that ends a URL
// with `{url#path}` yields `https://example.com/` where the case expects
// `https://example.com`; the Smithy reference engine, which wrote the cases,
// gives an empty path. Both readings must meet the case, so the trailing "/" is
// not compared. 4 of the 393 cases (an S3 Express bucket on a custom IP
// endpoint, the path-style result) differ by it, listed on #6623.
fn withoutRootSlash(url: string): string {
  if (len(url) > 0 && url[len(url) - 1] == '/') {
    return url[0:len(url) - 1]
  }
  return url
}

// Whether the endpoint a case expects is the one the walk returned.
fn endpointOkFor(got: EndpointResult, want: Json): bool {
  let props = field(want, "properties")
  return withoutRootSlash(got.url) == withoutRootSlash(textOf(field(want, "url"))) &&
    got.backend == textOf(field(props, "backend")) &&
    schemesOk(got, props)
}

// "" when the walk of case `c` matches its expectation, else what differed.
fn caseProblem(c: Json): string {
  let want = field(c, "expect")
  let got = endpointDecide(caseParams(c)) catch e {
    if (e.message() == textOf(field(want, "error"))) {
      return ""
    }
    return "error ${e.message()}"
  }
  if (endpointOkFor(got, field(want, "endpoint"))) {
    return ""
  }
  return "got ${got.url} ${join(walkSchemes(got), " ")}"
}

fn walkSchemes(got: EndpointResult): []string {
  let out = []string(0)
  for a of got.authSchemes {
    out = append(out, schemeText(a))
  }
  return out
}

fn caseDoc(c: Json): string {
  return textOf(field(c, "documentation"))
}

fn parsedCases(): []Json {
  let out = []Json(0)
  for row of endpointCaseRows {
    out = append(
      out,
      jsonParse(row) catch e {
        panic("case row: ${e.message()}")
      },
    )
  }
  return out
}

test "the generated walker resolves every endpoint test of the S3 model" {
  let t = walkVectors()
  for c of parsedCases() {
    let why = caseProblem(c)
    t.total = t.total + 1
    if (why == "") {
      t.passed = t.passed + 1
    } else {
      t.failures = append(t.failures, "${caseDoc(c)}: ${why}")
    }
  }
  println("gen_endpoint: ${t.passed} of ${t.total} model endpoint tests")
  assert(t.total == 393, "393 endpoint tests, saw ${t.total}")
  assert(len(t.failures) == 0, "failed: ${join(t.failures, "; ")}")
}

test "the node table holds the declared node count" {
  assert(len(endpointBddNodes) == 3 * endpointBddNodeCount, "nodes ${len(endpointBddNodes)}")
  assert(endpointBddNodeCount == 553, "node count ${endpointBddNodeCount}")
}
