fn postMultipart(post: PresignedPost, body: string): Response! {
  let boundary = "bit-s3-post-policy-boundary"
  let form = ""
  for (name, value) of post.fields {
    form = form +
      "--${boundary}\r\nContent-Disposition: form-data; name=\"${name}\"\r\n\r\n${value}\r\n"
  }
  form = form +
    "--${boundary}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"cover.txt\"\r\nContent-Type: text/plain\r\n\r\n${body}\r\n--${boundary}--\r\n"
  return requestWith(
    "POST",
    post.url,
    [Header{ name = "Content-Type", value = "multipart/form-data; boundary=${boundary}" }],
    form,
  )?
}

fn livePost(cfg: Config, key: string): PresignedPost! {
  return presignPost(
    cfg,
    key,
    300,
    PostOptions{ conditions = [PostCondition.ContentLengthRange(1, 5)] },
  )?
}

test "live: POST policy accepts valid multipart upload" {
  let (cfg, ready) = liveConfigOrSkip()
  if (!ready) {
    return
  }
  let key = "live/post-accepted.txt"
  let post = livePost(cfg, key) catch e {
    panic(e.message())
  }
  let res = postMultipart(post, "hello") catch e {
    panic(e.message())
  }
  assert(res.status >= 200 && res.status < 300, "POST ${res.status}: ${res.body}")
  let client = Client(cfg)
  let got = client.get(key) catch e {
    panic(e.message())
  }
  assert(got == "hello", "uploaded bytes differ")
  client.delete(key) catch e {
    panic(e.message())
  }
}

test "live: POST policy refuses content above content-length-range" {
  let (cfg, ready) = liveConfigOrSkip()
  if (!ready) {
    return
  }
  let key = "live/post-refused.txt"
  let post = livePost(cfg, key) catch e {
    panic(e.message())
  }
  let res = postMultipart(post, "toolong") catch e {
    panic(e.message())
  }
  assert(res.status == 400, "over-limit POST ${res.status}: ${res.body}")
  assert(contains(res.body, "EntityTooLarge"), res.body)
  let client = Client(cfg)
  client.head(key) catch _ {
    return
  }
  panic("refused POST created an object")
}
