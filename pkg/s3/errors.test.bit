// pkg/s3/errors.test.bit — #6624. S3Error and the rules that build one from a
// response. The error bodies are the samples of the S3 API reference
// ("Error responses", docs.aws.amazon.com/AmazonS3/latest/API/ErrorResponses.html
// and the per-operation examples), the 2xx cases are the throw200Exceptions
// behaviour of aws-sdk-js-v3 commit 054298b1520fc45a7017966674a5ac3aa6f32a04
// (packages-internal/middleware-sdk-s3, with trailing whitespace skipped), and every code of the generated error
// table is sent through the parser once.

import { Response } from "std/http"
import { contains, hasPrefix, repeat } from "std/strings"

fn resp(status: int, headers: string, body: string): Response {
  return Response{ status = status, contentType = "", headers = headers, body = body }
}

fn found(o: Option<S3Error>): bool {
  match (o) {
    Some(_) => return true
    None => return false
  }
}

fn failsWith404(): ()!S3Error {
  fail errorFromResponse(resp(404, idHeaders, noSuchKey))
}

fn errBody(code: string, message: string): string {
  return "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Error>\n  <Code>${code}</Code>\n  <Message>${message}</Message>\n  <RequestId>4442587FB7D0A2F9</RequestId>\n</Error>\n"
}

const noSuchKey: string = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" +
  "<Error>\n" +
  "  <Code>NoSuchKey</Code>\n" +
  "  <Message>The resource you requested does not exist</Message>\n" +
  "  <Resource>/mybucket/myfoto.jpg</Resource>\n" +
  "  <RequestId>4442587FB7D0A2F9</RequestId>\n" +
  "</Error>\n"

const slowDown: string = "<Error><Code>SlowDown</Code><Message>Please reduce your request rate.</Message>" +
  "<RequestId>K2H6N7ZGQT6WHCEG</RequestId><HostId>WWoZlnK5RCIyX3kjk2zF5Ae+xLy9m47Hhs4sBPgn0hAD+Q3pc6wwI4wCxq5wDemb8gwkAc1xDxw=</HostId></Error>"

const completeFails: string = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" +
  "<Error>\n" +
  "<Code>InternalError</Code>\n" +
  "<Message>We encountered an internal error. Please try again.</Message>\n" +
  "<RequestId>656c76696e6727732072657175657374</RequestId>\n" +
  "<HostId>Uuag1LuByRx9e6j5Onimru9pO4ZVKnJ2Qz7/C1NPcfTWAtRPfTaOFg==</HostId>\n" +
  "</Error>\n"

const copyOk: string = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" +
  "<CopyObjectResult><LastModified>2009-10-12T17:50:30.000Z</LastModified>" +
  "<ETag>&quot;9b2cf535f27731c974343645a3985328&quot;</ETag></CopyObjectResult>"

const idHeaders: string = "x-amz-request-id: 4442587FB7D0A2F9\r\nx-amz-id-2: ZmFrZS1leHRlbmRlZC1pZA==\r\nx-amz-bucket-region: eu-west-1\r\n"

test "an S3 reference error body fills every field" {
  let e = errorFromResponse(resp(404, idHeaders, noSuchKey))
  assert(e.kind == ErrorKind.NoSuchKey, "kind")
  assert(e.code == "NoSuchKey", "code ${e.code}")
  assert(e.message == "The resource you requested does not exist", "message ${e.message}")
  assert(e.status == 404, "status")
  assert(e.requestId == "4442587FB7D0A2F9", "requestId ${e.requestId}")
  assert(e.extendedId == "ZmFrZS1leHRlbmRlZC1pZA==", "extendedId ${e.extendedId}")
  assert(e.bucketRegion == "eu-west-1", "bucketRegion ${e.bucketRegion}")
  assert(e.resource == "/mybucket/myfoto.jpg", "resource ${e.resource}")
  assert(contains(e.snippet, "<Code>NoSuchKey</Code>"), "snippet keeps the body")
  assert(!e.retryable, "NoSuchKey is not retried")
  assert(e.attempts == 0, "the retry loop sets attempts")
}

test "the body ids are the fallback when a header is absent, the header wins when both are there" {
  let e = errorFromResponse(resp(503, "", slowDown))
  assert(e.requestId == "K2H6N7ZGQT6WHCEG", "requestId from the body: ${e.requestId}")
  assert(hasPrefix(e.extendedId, "WWoZlnK5RCIy"), "HostId from the body: ${e.extendedId}")
  let h = errorFromResponse(resp(503, idHeaders, slowDown))
  assert(h.requestId == "4442587FB7D0A2F9", "header request id wins: ${h.requestId}")
}

test "an error is matchable on its kind and usable as the failure of a call" {
  let got = ""
  failsWith404() catch e {
    match (e.kind) {
      NoSuchKey => got = "default cover"
      _ => got = "other"
    }
  }
  assert(got == "default cover", "got ${got}")
}

test "message() reads on one line with the status and the request id" {
  let e = errorFromResponse(resp(404, idHeaders, noSuchKey))
  assert(
      e.message() ==
      "s3: NoSuchKey: The resource you requested does not exist (status 404, request id 4442587FB7D0A2F9)",
    "message() = ${e.message()}",
  )
  let r: error = e
  assert(r.message() == e.message(), "S3Error is an error")
}

test "entities and CDATA in a message are decoded" {
  let e = errorFromResponse(
    resp(400, "", errBody("InvalidArgument", "x &lt; y &amp; <![CDATA[a < b]]>")),
  )
  assert(e.message == "x < y & a < b", "message ${e.message}")
  assert(e.kind == ErrorKind.InvalidArgument, "kind")
}

test "a wrapper element and a bare Code are read as the SDK reads them" {
  let wrapped = errorFromResponse(
    resp(
      409,
      "",
      "<ErrorResponse><Error><Code>BucketNotEmpty</Code><Message>m</Message></Error></ErrorResponse>",
    ),
  )
  assert(wrapped.kind == ErrorKind.BucketNotEmpty, "wrapped kind")
  assert(wrapped.message == "m", "wrapped message")
  let bare = errorFromResponse(
    resp(404, "", "<Response><Code>NoSuchBucket</Code><Message>gone</Message></Response>"),
  )
  assert(bare.kind == ErrorKind.NoSuchBucket, "bare Code kind")
}

test "an error body without a Code takes the code of its status" {
  let e = errorFromResponse(resp(404, "", "<Error><Message>nothing here</Message></Error>"))
  assert(e.kind == ErrorKind.NotFound, "404 with no Code is NotFound")
  assert(e.code == "NotFound", "code ${e.code}")
  assert(e.message == "nothing here", "message kept")
}

test "a HEAD answer has no body: the status says what happened" {
  let nf = errorFromResponse(resp(404, idHeaders, ""))
  assert(nf.kind == ErrorKind.NotFound, "404 HEAD is NotFound")
  assert(nf.status == 404 && nf.code == "NotFound", "status and code")
  assert(nf.requestId == "4442587FB7D0A2F9", "ids still come off the headers")
  assert(!nf.retryable, "NotFound is not retried")
  assert(errorFromResponse(resp(403, "", "")).kind == ErrorKind.AccessDenied, "403 HEAD")
  assert(
      errorFromResponse(resp(301, "x-amz-bucket-region: us-west-2\r\n", "")).kind ==
      ErrorKind.PermanentRedirect,
    "301 HEAD",
  )
  assert(
      errorFromResponse(resp(301, "x-amz-bucket-region: us-west-2\r\n", "")).bucketRegion ==
      "us-west-2",
    "301 region",
  )
  assert(errorFromResponse(resp(304, "", "")).kind == ErrorKind.NotModified, "304")
  assert(errorFromResponse(resp(412, "", "")).kind == ErrorKind.PreconditionFailed, "412")
  assert(errorFromResponse(resp(416, "", "")).kind == ErrorKind.InvalidRange, "416")
  assert(errorFromResponse(resp(405, "", "")).kind == ErrorKind.MethodNotAllowed, "405")
  match (errorFromResponse(resp(400, "", "")).kind) {
    Unknown(c) => assert(c == "", "a status with no code of its own: ${c}")
    _ => panic("400 with no body is not Unknown")
  }
}

test "an HTML 502 from a proxy is Unknown with the status, no panic, and retryable" {
  let html = "<html><head><title>502 Bad Gateway</title></head>\n<body><center><h1>502 Bad Gateway</h1></center><hr><center>nginx</center></body></html>"
  let e = errorFromResponse(resp(502, "", html))
  match (e.kind) {
    Unknown(c) => assert(c == "", "code ${c}")
    _ => panic("not Unknown")
  }
  assert(e.status == 502, "status")
  assert(e.code == "", "no wire code")
  assert(e.retryable, "502 is transient")
  assert(contains(e.snippet, "502 Bad Gateway"), "snippet")
  assert(contains(e.message(), "(status 502)"), "message() ${e.message()}")
  assert(contains(e.message(), "502 Bad Gateway"), "message() shows the body ${e.message()}")
}

test "a body that is not XML, truncated XML, a binary body and a huge body never fail" {
  let bodies = [
    "plain text",
    "<Error><Code>NoSuch",
    "<Error><Code>NoSuchKey</Code>",
    "\x00\x01\x02<<<>>>&&&",
    "<a><b></a></b>",
    "<!DOCTYPE x [<!ENTITY y \"z\">]><Error><Code>NoSuchKey</Code></Error>",
    repeat("<a>", 5000),
    repeat("x", 200000),
  ]
  let n = 0
  for b of bodies {
    let e = errorFromResponse(resp(500, "", b))
    assert(e.status == 500, "status survives")
    assert(len(e.snippet) <= 512, "snippet is bounded: ${len(e.snippet)}")
    assert(e.retryable, "500 is retried")
    n = n + 1
  }
  assert(n == 8, "bodies ${n}")
}

test "the snippet is bounded and never ends inside a UTF-8 character" {
  let body = repeat("é", 400)
  let e = errorFromResponse(resp(500, "", body))
  assert(len(e.snippet) <= 512, "length ${len(e.snippet)}")
  assert(len(e.snippet) % 2 == 0, "cut inside a two-byte character: ${len(e.snippet)}")
  assert(hasPrefix(body, e.snippet), "a prefix of the body")
}

test "retry verdicts follow the SDK classes and statuses" {
  assert(errorFromResponse(resp(503, "", slowDown)).retryable, "SlowDown")
  assert(
    errorFromResponse(resp(400, "", errBody("RequestTimeout", "t"))).retryable,
    "RequestTimeout is transient at 400",
  )
  assert(
    errorFromResponse(resp(500, "", errBody("InternalError", "t"))).retryable,
    "InternalError",
  )
  assert(errorFromResponse(resp(429, "", "")).retryable, "429")
  assert(errorFromResponse(resp(504, "", "")).retryable, "504")
  assert(
    !errorFromResponse(resp(501, "", errBody("NotImplemented", "t"))).retryable,
    "NotImplemented",
  )
  assert(!errorFromResponse(resp(403, "", errBody("AccessDenied", "t"))).retryable, "AccessDenied")
  assert(
    !errorFromResponse(resp(400, "", errBody("EntityTooSmall", "t"))).retryable,
    "EntityTooSmall",
  )
  assert(clientError(ErrorKind.Timeout, "deadline").retryable, "a timeout is transient")
  assert(
    clientError(ErrorKind.Connection, "refused").retryable,
    "a refused connection is transient",
  )
  assert(!clientError(ErrorKind.InvalidInput("empty key"), "empty key").retryable, "InvalidInput")
  assert(!clientError(ErrorKind.ChecksumMismatch, "crc").retryable, "ChecksumMismatch")
}

test "an error the client raises itself has no code and no status" {
  let e = clientError(ErrorKind.InvalidInput("key"), "sigv4: the request has no host header")
  assert(e.code == "" && e.status == 0, "code and status")
  assert(
    e.message() == "s3: InvalidInput: sigv4: the request has no host header",
    "message() ${e.message()}",
  )
  assert(
    clientError(ErrorKind.Timeout, "after 30000 ms").message() == "s3: Timeout: after 30000 ms",
    "Timeout",
  )
}

// --- a 2xx that is an error ----------------------------------------------------

test "a 200 CompleteMultipartUpload with an <Error> body is an error and retryable" {
  match (hiddenError(resp(200, idHeaders, completeFails), true)) {
    Some(e) => {
      assert(e.kind == ErrorKind.InternalError, "kind")
      assert(e.code == "InternalError", "code")
      assert(e.status == 503, "the SDK rewrites the status to 503, got ${e.status}")
      assert(e.retryable, "retryable")
      assert(e.requestId == "4442587FB7D0A2F9", "request id")
      assert(
        e.message == "We encountered an internal error. Please try again.",
        "message ${e.message}",
      )
    }
    None => panic("the hidden error was not found")
  }
}

test "a 200 CopyObject or UploadPartCopy with an empty body is InternalError, S3 aborted request" {
  match (hiddenError(resp(200, idHeaders, ""), true)) {
    Some(e) => {
      assert(e.kind == ErrorKind.InternalError && e.code == "InternalError", "kind")
      assert(e.message == "S3 aborted request", "message ${e.message}")
      assert(e.status == 503 && e.retryable, "status and retry")
      assert(e.requestId == "4442587FB7D0A2F9", "ids from the headers")
    }
    None => panic("an empty 200 body was accepted")
  }
}

test "the generic check: any 2xx whose body ends in </Error>" {
  match (hiddenError(resp(200, "", errBody("SlowDown", "slow")), false)) {
    Some(e) => assert(
      e.kind == ErrorKind.SlowDown && e.retryable && e.status == 503,
      "kind ${e.code}",
    )
    None => panic("a ListObjectsV2 200 with an <Error> body was accepted")
  }
  match (hiddenError(resp(206, "", errBody("NoSuchKey", "k")), false)) {
    Some(e) => assert(e.kind == ErrorKind.NoSuchKey && e.retryable, "a 206 is checked too")
    None => panic("a 206 was not checked")
  }
  let bare = "<Error><Code>InternalError</Code></Error>"
  assert(found(hiddenError(resp(200, "", bare), false)), "no trailing byte")
  assert(
    found(hiddenError(resp(200, "", bare + " \r\n\t"), false)),
    "trailing whitespace is skipped",
  )
  assert(
    !found(hiddenError(resp(200, "", bare + "x"), false)),
    "text after the root is not the tag at the end",
  )
}

test "a 2xx that is a success is not an error" {
  assert(!found(hiddenError(resp(200, "", copyOk), true)), "CopyObjectResult")
  assert(
    !found(hiddenError(resp(200, "", ""), false)),
    "an empty body is fine for the other operations",
  )
  assert(!found(hiddenError(resp(204, "", ""), false)), "204")
  let mid = "<ListBucketResult><Key>a</Key><Error>x</Error><Key>b</Key></ListBucketResult>"
  assert(
    !found(hiddenError(resp(200, "", mid), false)),
    "<Error> inside a document is not at its end",
  )
}

test "a status outside 2xx is never read as a hidden error" {
  assert(!found(hiddenError(resp(404, "", noSuchKey), true)), "404")
  assert(!found(hiddenError(resp(301, "", ""), true)), "301")
}

// --- the table ---------------------------------------------------------------------

test "every code of the error table maps to its kind through the parser" {
  let n = 0
  let transient = 0
  for row of wireErrors {
    let status = row.status
    if (status == 0) {
      status = 400
    }
    let e = errorFromResponse(resp(status, "", errBody(row.code, "m")))
    assert(e.code == row.code, "code of ${row.code}: ${e.code}")
    assert(e.kind == row.kind, "kind of ${row.code}")
    assert(e.status == status, "status of ${row.code}")
    assert(e.message == "m" && e.requestId == "4442587FB7D0A2F9", "fields of ${row.code}")
    match (row.retry) {
      Throttling => assert(e.retryable, "${row.code} is throttling and must retry")
      Transient => assert(e.retryable, "${row.code} is transient and must retry")
      _ => {}
    }
    if (e.retryable) {
      transient = transient + 1
    }
    n = n + 1
  }
  assert(n == 145, "table rows: ${n} of 145")
  println("codes mapped through the parser: ${n} of ${n} (${transient} retryable)")
}

test "a code the table does not name keeps its code" {
  let e = errorFromResponse(resp(400, "", errBody("BrandNewServerError", "m")))
  match (e.kind) {
    Unknown(c) => assert(c == "BrandNewServerError", "code ${c}")
    _ => panic("not Unknown")
  }
  assert(e.code == "BrandNewServerError", "code field")
  assert(!e.retryable, "a 400 of an unknown code is not retried")
}

test "checkOk fails with the S3Error of the response, and a 2xx passes" {
  checkOk(resp(200, "", "")) catch e {
    panic("a 200 failed: ${e.message()}")
  }
  let msg = ""
  checkOk(resp(404, idHeaders, noSuchKey)) catch e {
    msg = e.message()
  }
  assert(contains(msg, "NoSuchKey") && contains(msg, "status 404"), "message ${msg}")
}

test "a client-side validation failure is an S3Error of kind InvalidInput" {
  let e = invalidInput("sigv4: request method must be set")
  match (e.kind) {
    InvalidInput(m) => assert(m == "sigv4: request method must be set", "payload ${m}")
    _ => panic("not InvalidInput")
  }
  assert(
    e.message() == "s3: InvalidInput: sigv4: request method must be set",
    "message() ${e.message()}",
  )
}
