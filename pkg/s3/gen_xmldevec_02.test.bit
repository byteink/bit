      assert(a3 == "string", "vector XmlUnionsWithStructMember.unionValue.StructValue.stringValue")
      let a4 = vecGot(
        u2.booleanValue,
        "vector XmlUnionsWithStructMember.unionValue.StructValue.booleanValue",
