      let a5 = vecGot(
        u2.integerValue,
        "vector XmlUnionsWithStructMember.unionValue.StructValue.integerValue",
      )
      assert(a5 == 3, "vector XmlUnionsWithStructMember.unionValue.StructValue.integerValue")
      let a6 = vecGot(
        u2.longValue,
        "vector XmlUnionsWithStructMember.unionValue.StructValue.longValue",
      )
      assert(a6 == 4, "vector XmlUnionsWithStructMember.unionValue.StructValue.longValue")
    }
    _ => panic("vector XmlUnionsWithStructMember.unionValue: not the expected variant")
  }
  println("restXml body vector 32 of 48: XmlUnionsWithStructMember")
}
