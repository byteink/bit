  }
  assert(out.responseMetadata.httpStatusCode == 200, "status")
  let a1 = vecGot(out.unionValue, "vector XmlUnionsWithStructMember.unionValue")
  match (a1) {
    StructValue(u2) => {
      let a3 = vecGot(
        u2.stringValue,
        "vector XmlUnionsWithStructMember.unionValue.StructValue.stringValue",
