test "restXml body vector 17 of 48: SimpleScalarPropertiesWithXMLPreamble (XvSimpleScalarProperties)" {
  let h = responseHead(200, "")
  vecAdd(h, "Content-Type", "application/xml")
  vecAdd(h, "X-Foo", "Foo")
  h.text = "<?xml version = \"1.0\" encoding = \"UTF-8\"?>\n<SimpleScalarPropertiesResponse>\n    <![CDATA[characters representing CDATA]]>\n    <stringValue>string</stringValue>\n    <!--xml comment-->\n</SimpleScalarPropertiesResponse>\n"
  let out = deserializeXvSimpleScalarPropertiesOutput(h) catch e {
    panic("SimpleScalarPropertiesWithXMLPreamble: ${e.message()}")
  }
  assert(out.responseMetadata.httpStatusCode == 200, "status")
  let a1 = vecGot(out.foo, "vector SimpleScalarPropertiesWithXMLPreamble.foo")
  assert(a1 == "Foo", "vector SimpleScalarPropertiesWithXMLPreamble.foo")
  let a2 = vecGot(out.stringValue, "vector SimpleScalarPropertiesWithXMLPreamble.stringValue")
  assert(a2 == "string", "vector SimpleScalarPropertiesWithXMLPreamble.stringValue")
  println("restXml body vector 17 of 48: SimpleScalarPropertiesWithXMLPreamble")
}

