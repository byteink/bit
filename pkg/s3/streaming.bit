// pkg/s3/streaming.bit — put/get through std/http's bounded-memory
// streaming primitives (stdlib/http/streambody.bit, built for this ticket,
// #4027/#6078) rather than `Client.put`/`Client.get`'s in-memory `string`
// body. `putStream`/`getStream` are injected onto `Client` via trait
// injection (SPEC §10.7, same mechanism multipart.bit uses) since `Client`
// cannot be redeclared here.
//
// The payload hash for `putStream` is always `unsignedPayload`
// (`UNSIGNED-PAYLOAD`, client.bit's own const): computing a real SHA-256 of
// the body up front would mean reading it once to hash it and again to
// send it, defeating the whole point of streaming a body whose size alone
// is known ahead of time. AWS documents this value for exactly this case
// (`presign.bit`'s own header has the same reasoning for presigned URLs).

import { BodySink, BodySource, StreamBody, getStreaming, requestWithStreamingBody } from "std/http"

// The Content-Length ceiling `getStream` accepts before it even starts —
// generous (100 GiB) rather than std/http's own 32 MiB `request`/
// `requestWith` default, because streaming never holds more than one
// bounded chunk in memory regardless of the object's declared size; this
// bound exists only to refuse an obviously-malformed or hostile response
// header before trusting it, not to cap real memory use (#6104: a 220 MiB
// live object hit the 32 MiB default and failed before this existed).
const maxStreamGetBytes: int = 100 * 1024 * 1024 * 1024

// The free-function bodies `ClientStreaming`'s two trait methods below
// delegate to, split out because the compiler's unused-import check does
// not walk into a `trait` body (verified: `bit lint` flagged `getStreaming`/
// `requestWithStreamingBody` as unused with the calls inline in the trait,
// even though they were the only calls in the file) — real top-level
// functions is a normal split, not a workaround for the check itself.
fn doPutStream(
  cfg: Config,
  key: string,
  contentLength: int,
  contentType: string,
  source: BodySource,
): ()! {
  let path = objectPath(cfg.bucket, key)
  let (url, headers) = signedRequest(cfg, "PUT", path, [](string, string)(0), unsignedPayload)?
  let sendHeaders = headers
  if (contentType != "") {
    sendHeaders = append(headers, Header{ name = "Content-Type", value = contentType })
  }
  let res = requestWithStreamingBody(
    "PUT",
    url,
    sendHeaders,
    StreamBody{ source = source, length = Option.Some(contentLength) },
  )?
  checkOk(res)?
}

fn doGetStream(cfg: Config, key: string, sink: BodySink): ObjectMeta! {
  let path = objectPath(cfg.bucket, key)
  let (url, headers) = signedRequest(cfg, "GET", path, [](string, string)(0), sha256Hex(""))?
  let res = getStreaming(url, headers, sink, maxStreamGetBytes)?
  checkOk(res)?
  return ObjectMeta{
    contentLength = atoi(httpHeader(res.headers, "content-length")),
    contentType = httpHeader(res.headers, "content-type"),
    etag = httpHeader(res.headers, "etag"),
  }
}

trait ClientStreaming {
  // Uploads exactly `contentLength` bytes pulled from `source` as `key`,
  // never holding the whole object in memory — see the file header for why
  // the payload hash is `unsignedPayload` rather than a real digest.
  export putStream(key: string, contentLength: int, contentType: string, source: BodySource): ()! {
    doPutStream(this.cfg, key, contentLength, contentType, source)?
  }

  // Downloads `key`, delivering the body to `sink` in bounded chunks
  // instead of returning it whole, and returns the same metadata `head`
  // does.
  export getStream(key: string, sink: BodySink): ObjectMeta! {
    return doGetStream(this.cfg, key, sink)?
  }
}
