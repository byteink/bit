test "Unit operation outputs carry only response metadata" {
  assert(
    CreateBucketMetadataConfigurationOutput{}.responseMetadata.httpStatusCode == 0,
    "CreateBucketMetadataConfigurationOutput metadata",
  )
  assert(
    CreateBucketMetadataTableConfigurationOutput{}.responseMetadata.httpStatusCode == 0,
    "CreateBucketMetadataTableConfigurationOutput metadata",
  )
  assert(DeleteBucketOutput{}.responseMetadata.httpStatusCode == 0, "DeleteBucketOutput metadata")
  assert(
    DeleteBucketAnalyticsConfigurationOutput{}.responseMetadata.httpStatusCode == 0,
    "DeleteBucketAnalyticsConfigurationOutput metadata",
  )
  assert(
    DeleteBucketCorsOutput{}.responseMetadata.httpStatusCode == 0,
    "DeleteBucketCorsOutput metadata",
  )
  assert(
    DeleteBucketEncryptionOutput{}.responseMetadata.httpStatusCode == 0,
    "DeleteBucketEncryptionOutput metadata",
  )
