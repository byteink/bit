import { exists, mkdir, readDir, readFile, remove, stat, writeFile } from "std/fs"
import { envOr } from "std/os"
import { contains, repeat } from "std/strings"
import { uuidV4, format as uuidFormat } from "std/uuid"

fn bodyTestSource(data: string): BodySource {
  let at = 0
  return (n) => {
    let size = len(data) - at
    if (size > n) {
      size = n
    }
    let part = data[at:at + size]
    at = at + size
    return part
  }
}

fn bodyTestDir(): string! {
  let path = envOr("TMPDIR", "/tmp") + "/bit-s3-body-" + uuidFormat(uuidV4())
  mkdir(path)?
  return path
}

fn bodyTestCleanup(path: string) {
  let names = readDir(path) catch e {
    panic(e.message())
  }
  for name of names {
    remove(path + "/" + name) catch e {
      panic(e.message())
    }
  }
  remove(path) catch e {
    panic(e.message())
  }
}

fn bodyTestHead(data: string, checksum: string): ResponseHead {
  let h = responseHead(200, "Content-Length: ${len(data)}\r\nx-amz-checksum-crc32: ${checksum}\r\n")
  h.stream = Option.Some(bodyTestSource(data))
  return h
}

fn bodyTestRun(checkBody: () => ()!) {
  checkBody() catch e {
    panic(e.message())
  }
}

test "body request variants open one bounded attempt and files reopen for retries" {
  bodyTestRun(() => {
    for input of [Body.Empty, Body.Text("abc"), Body.Bytes([]byte("abc"))] {
      let stream = bodyStream(input)?
      let data = stream.text()?
      assert(data == "" || data == "abc", "memory body")
      assert(isReplayable(input), "memory bodies replay")
    }
    let dir = bodyTestDir()?
    defer bodyTestCleanup(dir)
    let path = dir + "/cover"
    writeFile(path, "article-cover")?
    let input = Body.File(path)
    let first = bodyStream(input)?
    let second = bodyStream(input)?
    assert(first.text()? == "article-cover", "first attempt")
    assert(second.text()? == "article-cover", "second attempt starts from byte zero")
    assert(isReplayable(input), "files replay")
    let streamed = Body.Stream(bodyTestSource("abc"), Option.Some(3))
    assert(!isReplayable(streamed), "caller streams do not replay")
    assert(bodyStream(streamed)?.text()? == "abc", "known-length stream")
  })
}

test "body lazy bounded reads and close release the source once" {
  bodyTestRun(() => {
    let pulls = 0
    let closes = 0
    let source: BodySource = (n) => {
      pulls = pulls + 1
      assert(n <= bodyChunkBytes, "source request remains bounded")
      return repeat("a", n)
    }
    let stream = checkedBodyStream(source, Option<int>.None)?
    stream.onClose = Option.Some(() => {
      closes = closes + 1
    })
    assert(pulls == 0, "no eager pull")
    assert(len(stream.read(bodyChunkBytes + 1)?) == bodyChunkBytes, "read is capped")
    stream.close()
    stream.close()
    assert(closes == 1 && pulls == 1, "one release")
    assert(len(stream.read(1)?) == 0, "closed stream stays closed")
  })
}

test "body explicit buffer ceiling includes empty and exact-size boundaries" {
  bodyTestRun(() => {
    assert(len(bodyStream(Body.Empty)?.bytes(0)?) == 0, "empty zero-byte limit")
    assert(bodyStream(Body.Text("abc"))?.text(3)? == "abc", "exact limit")
    let stream = bodyStream(Body.Text("abcd"))?
    let refused = false
    let _ = stream.bytes(3) catch e {
      refused = contains(e.message(), "buffered byte limit")
      []byte(0)
    }
    assert(refused, "one byte over the limit fails")
    let invalid = false
    let _ = bodyStream(Body.Empty)?.bytes(-1) catch _ {
      invalid = true
      []byte(0)
    }
    assert(invalid, "negative ceiling fails")
  })
}

test "body length mismatch and oversized source fail closed" {
  bodyTestRun(() => {
    for input of [
      Body.Stream(bodyTestSource("ab"), Option.Some(3)),
      Body.Stream(bodyTestSource("abcd"), Option.Some(3)),
    ] {
      let stream = bodyStream(input)?
      let refused = false
      let _ = stream.bytes(10) catch e {
        refused = contains(e.message(), "content length mismatch")
        []byte(0)
      }
      assert(refused, "declared length is enforced")
      assert(stream.failed && stream.closed, "failure closes the source")
    }
    let bad: BodySource = (n) => {
      return repeat("x", n + 1)
    }
    let stream = checkedBodyStream(bad, Option<int>.None)?
    let refused = false
    let _ = stream.read(1) catch _ {
      refused = true
      []byte(0)
    }
    assert(refused && stream.closed, "oversized source fails")
  })
}

test "body save validates checksum before atomic replacement" {
  bodyTestRun(() => {
    let dir = bodyTestDir()?
    defer bodyTestCleanup(dir)
    let path = dir + "/cover"
    writeFile(path, "old-cover")?
    let stream = deserializeGetObjectOutput(bodyTestHead("abc", "NSRBwg=="))?.body
    stream.saveTo(path)?
    assert(readFile(path)? == "abc", "validated replacement")
    assert(len(readDir(dir)?) == 1, "no successful temporary file remains")
    let invalid = deserializeGetObjectOutput(bodyTestHead("abc", "AAAAAA=="))?.body
    let refused = false
    invalid.saveTo(path) catch e {
      refused = contains(e.message(), "response checksum mismatch")
    }
    assert(refused, "bad checksum fails at EOF")
    assert(readFile(path)? == "abc", "previous target survives checksum failure")
    assert(len(readDir(dir)?) == 1, "checksum failure removes its temporary file")
  })
}

test "body disconnect removes temporary file and preserves absent or existing target" {
  bodyTestRun(() => {
    let dir = bodyTestDir()?
    defer bodyTestCleanup(dir)
    for existing of [false, true] {
      let path = dir + "/cover"
      if (existing) {
        writeFile(path, "old-cover")?
      }
      let pulls = 0
      let source: BodySource = (n) => {
        pulls = pulls + 1
        if (pulls == 1) {
          return "abc"
        }
        fail newError("disconnected")
      }
      let stream = checkedBodyStream(source, Option<int>.None)?
      let refused = false
      stream.saveTo(path) catch e {
        refused = contains(e.message(), "disconnected")
      }
      assert(refused, "disconnect reaches caller")
      if (existing) {
        assert(readFile(path)? == "old-cover", "old target survives")
        assert(len(readDir(dir)?) == 1, "only old target remains")
      } else {
        assert(!exists(path) && len(readDir(dir)?) == 0, "no target or temporary file")
      }
    }
  })
}

test "body 300 MiB save uses bounded chunks" {
  bodyTestRun(() => {
    let dir = bodyTestDir()?
    defer bodyTestCleanup(dir)
    let total = 300 * 1024 * 1024
    let sent = 0
    let chunk = repeat("c", bodyChunkBytes)
    let source: BodySource = (n) => {
      assert(n == bodyChunkBytes, "fixed bounded demand")
      if (sent == total) {
        return ""
      }
      sent = sent + len(chunk)
      return chunk
    }
    let stream = checkedBodyStream(source, Option.Some(total))?
    let path = dir + "/cover"
    stream.saveTo(path)?
    assert(sent == total && stat(path)?.size == total, "all bytes saved")
    assert(len(readDir(dir)?) == 1, "only final target remains")
  })
}

test "body sink failure closes once and cannot become a successful empty read" {
  bodyTestRun(() => {
    let closes = 0
    let body = checkedBodyStream(bodyTestSource("abc"), Option.Some(3))?
    body.onClose = Option.Some(() => {
      closes = closes + 1
    })
    let refused = false
    body.pipeTo((part) => {
      fail newError("sink refused")
    }) catch e {
      refused = contains(e.message(), "sink refused")
    }
    let failedRead = false
    let _ = body.read(1) catch _ {
      failedRead = true
      []byte(0)
    }
    body.close()
    assert(refused && failedRead && closes == 1, "sink failure remains a failure and releases once")
  })
}

test "body save cannot create a temporary file and still releases its source" {
  bodyTestRun(() => {
    let dir = bodyTestDir()?
    defer bodyTestCleanup(dir)
    let pulls = 0
    let closes = 0
    let source: BodySource = (n) => {
      pulls = pulls + 1
      return "abc"
    }
    let body = checkedBodyStream(source, Option.Some(3))?
    body.onClose = Option.Some(() => {
      closes = closes + 1
    })
    let refused = false
    body.saveTo(dir + "/missing/cover") catch _ {
      refused = true
    }
    body.close()
    assert(refused && pulls == 0 && closes == 1, "open failure releases without pulling")
    assert(len(readDir(dir)?) == 0, "no temporary file remains")
  })
}

test "body save refuses a closed stream and preserves the target" {
  bodyTestRun(() => {
    let dir = bodyTestDir()?
    defer bodyTestCleanup(dir)
    let path = dir + "/cover"
    writeFile(path, "old-cover")?
    let closes = 0
    let body = bodyStream(Body.Text("new-cover"))?
    body.onClose = Option.Some(() => {
      closes = closes + 1
    })
    body.close()
    let refused = false
    body.saveTo(path) catch e {
      refused = contains(e.message(), "closed")
    }
    assert(readFile(path)? == "old-cover", "closed save must preserve the target")
    assert(refused, "closed body save must fail")
    assert(closes == 1, "closed save releases its source once")
    assert(len(readDir(dir)?) == 1, "closed save leaves no temporary file")
  })
}

fn bodyTestChecked(
  source: BodySource,
  length: Option<int>,
  alg: ChecksumAlgorithm,
  expected: string,
): ByteStream! {
  let body = checkedBodyStream(source, length)?
  body.checksums = [bodyChecksum{ hash = checksumHasher(alg)?, expected = expected }]
  return body
}

fn bodyTestChecksumFailure(body: ByteStream, max: int) {
  let refused = false
  let _ = body.read(max) catch e {
    match (e.(S3Error).kind) {
      ChecksumMismatch => refused = true
      _ => panic("wrong checksum error: ${e.message()}")
    }
    []byte(0)
  }
  assert(refused && body.failed && body.closed, "checksum failure closes the body")
  assert(body.pending == "", "failed final data is discarded")
}

test "body checked final chunk is withheld for every checksum algorithm" {
  bodyTestRun(() => {
    for alg of checksumAlgorithms() {
      let closes = 0
      let body = bodyTestChecked(
        bodyTestSource("Hello worle"), Option.Some(11), alg, valueOf(alg, []byte(hello)),
      )?
      body.onClose = Option.Some(() => {
        closes = closes + 1
      })
      assert(string(body.read(6)?) == "Hello ", "only a nonfinal chunk escapes")
      assert(body.consumed == 11 && !body.closed, "known length alone is not EOF")
      bodyTestChecksumFailure(body, 6)
      body.close()
      assert(closes == 1, "one checksum-failure release")
    }
  })
}

test "body checked valid and empty streams hash every byte once under changing reads" {
  bodyTestRun(() => {
    for alg of checksumAlgorithms() {
      for data of ["", hello] {
        let at = 0
        let eof = false
        let source: BodySource = (n) => {
          let size = minBodyRead(n)
          if (size > 3) {
            size = 3
          }
          if (size > len(data) - at) {
            size = len(data) - at
          }
          let part = data[at:at + size]
          at = at + size
          eof = part == ""
          return part
        }
        let body = bodyTestChecked(source, Option<int>.None, alg, valueOf(alg, []byte(data)))?
        let out = ""
        for max of [8, 1, 7, 2, 1, 20, 1, 8, 8, 8, 8, 8] {
          let part = body.read(max)?
          assert(len(part) <= max, "changing demand remains a ceiling")
          assert(len(body.pending) <= bodyChunkBytes, "pending remains one bounded chunk")
          out = out + string(part)
        }
        assert(out == data && eof && body.verified, "valid data only finishes after true EOF")
        assert(body.consumed == len(data) && body.closed, "exact byte count and successful close")
      }
    }
  })
}

test "body checked exact length still waits for source EOF and catches a late disconnect" {
  bodyTestRun(() => {
    let pulls = 0
    let closes = 0
    let source: BodySource = (n) => {
      pulls = pulls + 1
      if (pulls == 1) {
        return "abc"
      }
      fail newError("late disconnect")
    }
    let body = bodyTestChecked(source, Option.Some(3), ChecksumAlgorithm.Crc32, "NSRBwg==")?
    body.onClose = Option.Some(() => {
      closes = closes + 1
    })
    let refused = false
    let _ = body.read(3) catch e {
      refused = contains(e.message(), "late disconnect")
      []byte(0)
    }
    assert(refused && pulls == 2 && closes == 1, "EOF failure cannot expose final data")
    assert(body.failed && body.pending == "", "disconnect discards pending data")
  })
}

test "body checked known length cannot hide extra bytes or a short body" {
  bodyTestRun(() => {
    for length of [2, 4] {
      let closes = 0
      let body = bodyTestChecked(
        bodyTestSource("abc"), Option.Some(length), ChecksumAlgorithm.Crc32, "NSRBwg==",
      )?
      body.onClose = Option.Some(() => {
        closes = closes + 1
      })
      let refused = false
      let _ = body.read(3) catch e {
        refused = contains(e.message(), "content length mismatch")
        []byte(0)
      }
      body.close()
      assert(
        refused && body.failed && body.pending == "" && closes == 1,
        "length failure closes once",
      )
    }
  })
}

test "body checked lookahead rejects an oversized source and explicit close discards pending" {
  bodyTestRun(() => {
    let pulls = 0
    let bad: BodySource = (n) => {
      pulls = pulls + 1
      if (pulls == 1) {
        return "a"
      }
      return repeat("b", n + 1)
    }
    let body = bodyTestChecked(bad, Option<int>.None, ChecksumAlgorithm.Crc32, "AAAAAA==")?
    let refused = false
    let _ = body.read(1) catch _ {
      refused = true
      []byte(0)
    }
    assert(
      refused && body.failed && body.closed && body.pending == "",
      "oversize lookahead fails closed",
    )
    let closes = 0
    let pending = bodyTestChecked(
      bodyTestSource(hello),
      Option.Some(11),
      ChecksumAlgorithm.Crc32,
      "i9aeUg==",
    )?
    pending.onClose = Option.Some(() => {
      closes = closes + 1
    })
    assert(
      string(pending.read(6)?) == "Hello " && pending.pending == "world",
      "one final chunk pending",
    )
    pending.close()
    pending.close()
    assert(
      closes == 1 && pending.pending == "" && len(pending.read(1)?) == 0,
      "abandonment releases once",
    )
  })
}

test "body checked pipe and atomic save cannot expose a corrupt final chunk" {
  bodyTestRun(() => {
    let delivered = ""
    let body = deserializeGetObjectOutput(bodyTestHead("abc", "AAAAAA=="))?.body
    let refused = false
    body.pipeTo((part) => {
      delivered = delivered + part
    }) catch e {
      refused = contains(e.message(), "response checksum mismatch")
    }
    assert(refused && delivered == "" && body.pending == "", "pipe withholds corrupt final data")
    let dir = bodyTestDir()?
    defer bodyTestCleanup(dir)
    let path = dir + "/cover"
    writeFile(path, "previous")?
    let saved = deserializeGetObjectOutput(bodyTestHead("abc", "AAAAAA=="))?.body
    refused = false
    saved.saveTo(path) catch _ {
      refused = true
    }
    assert(refused && readFile(path)? == "previous", "atomic save preserves its target")
    assert(saved.pending == "" && len(readDir(dir)?) == 1, "no failed final data or temporary file")
  })
}

test "body checked sink failure discards pending and releases once" {
  bodyTestRun(() => {
    let closes = 0
    let source: BodySource = (n) => {
      return "abc"
    }
    let body = bodyTestChecked(source, Option<int>.None, ChecksumAlgorithm.Crc32, "AAAAAA==")?
    body.onClose = Option.Some(() => {
      closes = closes + 1
    })
    let refused = false
    body.pipeTo((part) => {
      fail newError("checked sink refused")
    }) catch e {
      refused = contains(e.message(), "checked sink refused")
    }
    body.close()
    assert(
      refused && closes == 1 && body.failed && body.pending == "",
      "sink failure discards lookahead",
    )
  })
}

fn bodyTestLargeChecked(): ()! {
  let total = 50 * 1024 * 1024
  let chunk = repeat("c", bodyChunkBytes)
  let hash = checksumHasher(ChecksumAlgorithm.Crc32)?
  let chunks = total / bodyChunkBytes
  let i = 0
  while (i < chunks) {
    hash.write([]byte(chunk))
    i = i + 1
  }
  let sent = 0
  let received = 0
  let eof = false
  let source: BodySource = (n) => {
    assert(n == bodyChunkBytes, "fixed bounded source demand")
    if (sent == total) {
      eof = true
      return ""
    }
    sent = sent + len(chunk)
    return chunk
  }
  let body = bodyTestChecked(
    source,
    Option.Some(total),
    ChecksumAlgorithm.Crc32,
    checksumValue(hash),
  )?
  body.pipeTo((part) => {
    received = received + len(part)
    assert(len(body.pending) <= bodyChunkBytes, "pending storage is independent of object size")
    if (received == total) {
      assert(eof && body.verified, "the final chunk follows true EOF and checksum validation")
    }
  })?
  assert(
    sent == total && received == total && body.consumed == total,
    "50 MiB counted exactly once",
  )
  assert(body.closed && body.pending == "", "successful stream releases pending storage")
}

test "body checked 50 MiB stream retains only fixed chunks" {
  bodyTestRun(() => {
    bodyTestLargeChecked()?
  })
}
