// pkg/s3/multipart.test.bit — the request/response bodies multipart.bit
// builds and parses, at the unit level. The three calls against a real
// server are client.live.test.bit's job.

test "createMultipartUpload reads UploadId out of InitiateMultipartUploadResult" {
  let body = "<?xml version=\"1.0\" encoding=\"UTF-8\"?><InitiateMultipartUploadResult>" +
    "<Bucket>photos</Bucket><Key>a.jpg</Key><UploadId>abc-123</UploadId>" +
    "</InitiateMultipartUploadResult>"
  assert(xmlTagOr(body, "UploadId", 0, "") == "abc-123", "UploadId not found")
}

test "completeRequestBody lists every part, in the order given, with its ETag" {
  let parts = [
    UploadedPart{ partNumber = 1, etag = "\"etag-one\"" },
    UploadedPart{ partNumber = 2, etag = "\"etag-two\"" },
  ]
  let body = completeRequestBody(parts)
  let want = "<CompleteMultipartUpload>" +
    "<Part><PartNumber>1</PartNumber><ETag>\"etag-one\"</ETag></Part>" +
    "<Part><PartNumber>2</PartNumber><ETag>\"etag-two\"</ETag></Part>" +
    "</CompleteMultipartUpload>"
  assert(body == want, "body = ${body}")
}

test "completeRequestBody on zero parts is an empty element" {
  let body = completeRequestBody([]UploadedPart(0))
  assert(body == "<CompleteMultipartUpload></CompleteMultipartUpload>", "body = ${body}")
}
