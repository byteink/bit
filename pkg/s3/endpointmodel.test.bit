fn modelPartitionRows(): []string {
  let out = blockRows(modelPartitionRows0())
  return out
}

fn urlRowOk(row: string): bool {
  let p = split(row, "|")
  match (parseURL(p[0])) {
    None => return p[1] == "ERR"
    Some(u) => return len(p) == 5 &&
      u.scheme == p[1] &&
      u.authority == p[2] &&
      u.path == p[3] &&
      flagText(u.isIp) == p[4]
  }
}

fn urlSweep(t: Vectors, rows: []string, what: string) {
  for r of rows {
    check(t, urlRowOk(r), "${what} ${r}")
  }
}

fn arnRowOk(row: string): bool {
  let p = split(row, "|")
  match (awsParseArn(p[0])) {
    None => return p[1] == "ERR"
    Some(a) => return len(p) == 6 &&
      a.partition == p[1] &&
      a.service == p[2] &&
      a.region == p[3] &&
      a.accountId == p[4] &&
      join(a.resourceId, ",") == p[5]
  }
}

fn bucketRowOk(row: string): bool {
  let p = split(row, "|")
  return awsIsVirtualHostableS3Bucket(p[0], false) == (p[1] == "T") &&
    awsIsVirtualHostableS3Bucket(p[0], true) == (p[2] == "T")
}

fn partitionRowOk(row: string): bool {
  let p = split(row, "|")
  let got = awsPartition(p[0])
  return got.name == p[1] &&
    got.dnsSuffix == p[2] &&
    got.dualStackDnsSuffix == p[3] &&
    got.implicitGlobalRegion == p[4]
}

test "every URL the S3 endpoint tests expect parses to its parts" {
  let t = vectors()
  urlSweep(t, modelUrlRows(), "expected url")
  finish(t, "endpointmodel expected URLs")
}

test "every custom endpoint the S3 endpoint tests pass parses, or is refused, as the SDK does" {
  let t = vectors()
  let eps = modelEndpointRows()
  urlSweep(t, eps, "endpoint")
  check(t, len(eps) == 25, "25 distinct custom endpoints, saw ${len(eps)}")
  finish(t, "endpointmodel custom endpoints")
}

test "every bucket name of the S3 endpoint tests classifies as the SDK does" {
  let t = vectors()
  for r of modelBucketRows() {
    check(t, bucketRowOk(r), "bucket ${r}")
  }
  finish(t, "endpointmodel buckets")
}

test "every ARN bucket of the S3 endpoint tests parses to its parts or is refused" {
  let t = vectors()
  for r of modelArnRows() {
    check(t, arnRowOk(r), "arn ${r}")
  }
  finish(t, "endpointmodel ARNs")
}

test "every region of partitions.json resolves to its partition" {
  let t = vectors()
  for r of modelPartitionRows() {
    check(t, partitionRowOk(r), "partition ${r}")
  }
  finish(t, "endpointmodel regions")
}
