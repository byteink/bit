// pkg/s3/endpointmodel.test.bit — the functions of endpointfns.bit against the
// S3 model's own endpoint tests (aws-models/s3.json, trait
// `smithy.rules#endpointTests`, 393 cases, aws-sdk-js-v3
// 054298b1520fc45a7017966674a5ac3aa6f32a04): every URL an endpoint case expects, every
// custom endpoint and bucket it passes, every ARN bucket, and every region of
// partitions.json (version 1.1, same commit). Rows are copied; the expectation of
// each was computed by a separate implementation of the SDK's functions
// (util-endpoints parseURL, isVirtualHostableS3Bucket and the Smithy ARN split).
// Row shapes: `url|scheme|authority|path|isIp` or `url|ERR`;
// `bucket|virtualHostable|virtualHostableSubdomains`;
// `arn|partition|service|region|account|resource,resource` or `arn|ERR`;
// `region|partition|dnsSuffix|dualStackDnsSuffix|implicitGlobalRegion`.

import { awsPartition } from "aws"
import { join, split } from "std/strings"

// The non-empty lines of `block`.
fn blockRows(block: string): []string {
  let out = []string(0)
  for line of split(block, "\n") {
    if (line != "") {
      out = append(out, line)
    }
  }
  return out
}

