  "GetBucketTagging|BX",
  "GetBucketVersioning|BX",
  "GetBucketWebsite|BX",
  "GetObject|BK",
  "GetObjectAcl|BK",
  "GetObjectAnnotation|BK",
  "GetObjectAttributes|B",
  "GetObjectLegalHold|B",
  "GetObjectLockConfiguration|B",
  "GetObjectRetention|B",
  "GetObjectTagging|B",
  "GetObjectTorrent|B",
  "GetPublicAccessBlock|BX",
  "HeadBucket|B",
  "HeadObject|BK",
  "ListBucketAnalyticsConfigurations|BX",
  "ListBucketIntelligentTieringConfigurations|BX",
  "ListBucketInventoryConfigurations|BX",
  "ListBucketMetricsConfigurations|BX",
  "ListBuckets|",
  "ListDirectoryBuckets|X",
  "ListMultipartUploads|BP",
  "ListObjectAnnotations|B",
  "ListObjectVersions|BP",
  "ListObjects|BP",
  "ListObjectsV2|BP",
  "ListParts|BK",
  "PutBucketAbac|B",
  "PutBucketAccelerateConfiguration|BX",
  "PutBucketAcl|BX",
  "PutBucketAnalyticsConfiguration|BX",
  "PutBucketCors|BX",
  "PutBucketEncryption|BX",
  "PutBucketIntelligentTieringConfiguration|BX",
  "PutBucketInventoryConfiguration|BX",
  "PutBucketLifecycleConfiguration|BX",
