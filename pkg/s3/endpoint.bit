// The flags of operation `name`, or None when the model has no such operation.
fn operationFlags(name: string): Option<string> {
  let prefix = name + "|"
  for row of endpointOperations {
    if (hasPrefix(row, prefix)) {
      return Option<string>.Some(row[len(prefix):len(row)])
    }
  }
  return Option<string>.None
}

fn bound(flags: string, flag: string, v: Option<string>): Option<string> {
  if (indexOf(flags, flag) < 0) {
    return Option<string>.None
  }
  return v
}

fn staticFlag(flags: string, flag: string): Option<bool> {
  if (indexOf(flags, flag) < 0) {
    return Option<bool>.None
  }
  return Option<bool>.Some(true)
}

fn configParams(cfg: EndpointConfig): EndpointParams {
  let p = defaultEndpointParams()
  if (cfg.region != "") {
    p.region = Option<string>.Some(cfg.region)
  }
  if (cfg.endpoint != "") {
    p.endpoint = Option<string>.Some(cfg.endpoint)
  }
  p.useFIPS = cfg.useFIPS
  p.useDualStack = cfg.useDualStack
  p.forcePathStyle = cfg.forcePathStyle
  p.accelerate = cfg.accelerate
  p.useGlobalEndpoint = cfg.useGlobalEndpoint
  p.disableMultiRegionAccessPoints = cfg.disableMultiRegionAccessPoints
  p.useArnRegion = cfg.useArnRegion
  p.disableS3ExpressSessionAuth = cfg.disableS3ExpressSessionAuth
  return p
}

// The rule set's parameters for operation `op` with input `input` under `cfg`: the
// client settings, the members the operation binds, and its static parameters,
// which override a client setting of the same name. An unknown operation is an error.
fn endpointParamsFor(cfg: EndpointConfig, op: string, input: EndpointInput): EndpointParams! {
  let known = operationFlags(op)
  if (!isSet(known)) {
    fail newError("s3: unknown operation ${op}")
  }
  let flags = coalesce(known, "")
  let p = configParams(cfg)
  p.bucket = bound(flags, "B", input.bucket)
  p.key = bound(flags, "K", input.key)
  p.prefix = bound(flags, "P", input.prefix)
  p.copySource = bound(flags, "C", input.copySource)
  let control = staticFlag(flags, "X")
  if (isSet(control)) {
    p.useS3ExpressControlEndpoint = control
  }
  let session = staticFlag(flags, "S")
  if (isSet(session)) {
    p.disableS3ExpressSessionAuth = session
  }
  let lambda = staticFlag(flags, "L")
  if (isSet(lambda)) {
    p.useObjectLambdaEndpoint = lambda
  }
  let access = staticFlag(flags, "A")
  if (isSet(access)) {
    p.disableAccessPoints = access
  }
  return p
}

// The endpoint operation `op` resolves to under `cfg`, or the error text of the rule that matched.
fn resolveEndpoint(cfg: EndpointConfig, op: string, input: EndpointInput): EndpointResult! {
  return endpointDecide(endpointParamsFor(cfg, op, input)?)?
}
