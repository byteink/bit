// pkg/s3/endpoint.bit — endpoint resolution for one S3 operation: the client
// configuration and the operation's input turned into the rule set's parameters
// (`endpointParamsFor`), then the generated decision diagram walked
// (`endpointDecide`, gen_endpoint.bit), giving the URL, the "backend" property and
// the auth schemes (sigv4, sigv4a, sigv4-s3express) with their signing name and
// region or region set, or the error text of the rule that matched.
//
// The parameters an operation binds come from the model's `contextParam` traits
// (Bucket, Key, Prefix, CopySource) and `staticContextParams`
// (UseS3ExpressControlEndpoint, DisableS3ExpressSessionAuth,
// UseObjectLambdaEndpoint, DisableAccessPoints), listed per operation in
// `endpointOperations` below. The S3 rule set has no `headers`, so a result carries
// none.

// The client settings that are rule parameters (the model's `clientContextParams`
// and the built-ins AWS::Region, AWS::UseFIPS, AWS::UseDualStack, SDK::Endpoint,
// AWS::S3::UseGlobalEndpoint). An empty `region` or `endpoint` is unset.
class EndpointConfig {
  region: string,
  endpoint: string,
  useFIPS: bool,
  useDualStack: bool,
  forcePathStyle: bool,
  accelerate: bool,
  useGlobalEndpoint: bool,
  disableMultiRegionAccessPoints: bool,
  useArnRegion: Option<bool>,
  disableS3ExpressSessionAuth: Option<bool>,
}

// A configuration with every setting off and no region.
fn defaultEndpointConfig(): EndpointConfig {
  return EndpointConfig{
    region = "",
    endpoint = "",
    useFIPS = false,
    useDualStack = false,
    forcePathStyle = false,
    accelerate = false,
    useGlobalEndpoint = false,
    disableMultiRegionAccessPoints = false,
    useArnRegion = Option<bool>.None,
    disableS3ExpressSessionAuth = Option<bool>.None,
  }
}

// The members of one operation's input that the rule set reads. A member the
// operation does not have is never read, whatever it holds.
class EndpointInput {
  bucket: Option<string>,
  key: Option<string>,
  prefix: Option<string>,
  copySource: Option<string>,
}

fn emptyEndpointInput(): EndpointInput {
  return EndpointInput{
    bucket = Option<string>.None,
    key = Option<string>.None,
    prefix = Option<string>.None,
    copySource = Option<string>.None,
  }
}

// Every operation of the model as `Name|flags`. B, K, P and C: the operation
// binds its Bucket, Key, Prefix and CopySource member to the parameter of that
// name. X, S, L and A: its static context parameters UseS3ExpressControlEndpoint,
// DisableS3ExpressSessionAuth, UseObjectLambdaEndpoint and DisableAccessPoints
// are true.
const endpointOperations: []string = [
  "AbortMultipartUpload|BK",
  "CompleteMultipartUpload|BK",
  "CopyObject|BKCS",
  "CreateBucket|BXA",
  "CreateBucketMetadataConfiguration|BX",
  "CreateBucketMetadataTableConfiguration|BX",
  "CreateMultipartUpload|BK",
  "CreateSession|BS",
  "DeleteBucket|BX",
  "DeleteBucketAnalyticsConfiguration|BX",
  "DeleteBucketCors|BX",
  "DeleteBucketEncryption|BX",
  "DeleteBucketIntelligentTieringConfiguration|BX",
  "DeleteBucketInventoryConfiguration|BX",
  "DeleteBucketLifecycle|BX",
  "DeleteBucketMetadataConfiguration|BX",
  "DeleteBucketMetadataTableConfiguration|BX",
  "DeleteBucketMetricsConfiguration|BX",
