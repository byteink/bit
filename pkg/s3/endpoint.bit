  "DeleteBucketPolicy|BX",
  "DeleteBucketReplication|BX",
  "DeleteBucketTagging|BX",
  "DeleteBucketWebsite|BX",
  "DeleteObject|BK",
  "DeleteObjectAnnotation|B",
  "DeleteObjectTagging|B",
  "DeleteObjects|B",
  "DeletePublicAccessBlock|BX",
  "GetBucketAbac|B",
  "GetBucketAccelerateConfiguration|BX",
  "GetBucketAcl|BX",
  "GetBucketAnalyticsConfiguration|BX",
