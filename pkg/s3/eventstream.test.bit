fn eventBytes(text: string): []byte {
  return decodeBase64(text) catch e {
    panic(e.message())
  }
}

test "event stream truncates each nonboolean header type" {
  eventMustFail(eventBytes("AAAAEwAAAAPba2OBAXgCanC3CA=="), "truncated header")
  eventMustFail(eventBytes("AAAAFAAAAAT3LyoyAXgDAL0XQss="), "truncated header")
  eventMustFail(eventBytes("AAAAFgAAAAZj4Rh+AXgEAAAAYD4KfA=="), "truncated header")
  eventMustFail(eventBytes("AAAAGgAAAAqvp7lUAXgFAAAAAAAAABrsbro="), "truncated header")
  eventMustFail(eventBytes("AAAAFAAAAAT3LyoyAXgGAMBgto4="), "truncated header")
  eventMustFail(eventBytes("AAAAFAAAAAT3LyoyAXgHANl7h88="), "truncated header")
  eventMustFail(eventBytes("AAAAGgAAAAqvp7lUAXgIAAAAAAAAAIHpe2s="), "truncated header")
  eventMustFail(eventBytes("AAAAIgAAABItmtJFAXgJAAAAAAAAAAAAAAAAAAAA+CuqrA=="), "truncated header")
  println("event stream truncated typed headers 8 of 8")
}

fn selectMustFail(data: []byte, reason: string) {
  let _ = decodeSelectEvent(data) catch e {
    assert(contains(e.message(), reason), e.message())
    return
  }
  panic("accepted malformed Select")
}

test "event stream invalid Select envelope and statistics" {
  selectMustFail(eventBytes("AAAAEAAAAAAFwkjrfZjI/w=="), "missing :message-type")
  selectMustFail(
    eventBytes("AAAAJAAAABRLuYLQDTptZXNzYWdlLXR5cGUHAANvZGQqp/hw"),
    "unknown message type",
  )
  selectMustFail(
    eventBytes("AAAAJgAAABbfd7CcDTptZXNzYWdlLXR5cGUHAAVldmVudAgHxwQ="),
    "missing :event-type",
  )
  selectMustFail(eventBytes("AAAAHwAAAA8XLcKrDTptZXNzYWdlLXR5cGUAjA5CJQ=="), "is not a string")
  selectMustFail(
    eventBytes("AAAAQQAAACrbCmdGDTptZXNzYWdlLXR5cGUHAAVldmVudAs6ZXZlbnQtdHlwZQcABVN0YXRzbm90IFhNTIR1wx8="),
    "invalid statistics XML",
  )
  selectMustFail(
    eventBytes("AAAAQgAAACqcqh2WDTptZXNzYWdlLXR5cGUHAAVldmVudAs6ZXZlbnQtdHlwZQcABVN0YXRzPE90aGVyLz6I/xMA"),
    "wrong statistics root",
  )
  selectMustFail(
    eventBytes("AAAAfQAAACq/2zLBDTptZXNzYWdlLXR5cGUHAAVldmVudAs6ZXZlbnQtdHlwZQcABVN0YXRzPFN0YXRzPjxEZXRhaWxzPjxCeXRlc1NjYW5uZWQ+b29wczwvQnl0ZXNTY2FubmVkPjwvRGV0YWlscz48L1N0YXRzPoYSnUs="),
    "invalid BytesScanned",
  )
}

test "event stream future Select event is preserved" {
  let event = decodeSelectEvent(eventBytes("AAAAOwAAACsfb6++DTptZXNzYWdlLXR5cGUHAAVldmVudAs6ZXZlbnQtdHlwZQcABkZ1dHVyZSChUD8=")) catch e {
    panic(e.message())
  }
  match (event) {
    Unknown(name) => assert(name == "Future", "future name")
    _ => panic("future event")
  }
}

test "event stream signed network integers preserve minima" {
  let message = decodeEventMessage(eventBytes("AAAANgAAACaZTheyAWICgAFzA4AAAWkEgAAAAAFsBYAAAAAAAAAAAXQI///////////qOU0n")) catch e {
    panic(e.message())
  }
  match (eventValue(message, "b")) {
    Byte(n) => assert(n == -128, "signed Byte")
    _ => panic("Byte type")
  }
  match (eventValue(message, "s")) {
    Short(n) => assert(n == -32768, "signed Short")
    _ => panic("Short type")
  }
  match (eventValue(message, "i")) {
    Integer(n) => assert(n == -2147483648, "signed Integer")
    _ => panic("Integer type")
  }
  match (eventValue(message, "l")) {
    Long(n) => assert(n == -9223372036854775808, "signed Long")
    _ => panic("Long type")
  }
  match (eventValue(message, "t")) {
    Timestamp(n) => assert(n == -1, "signed Timestamp")
    _ => panic("Timestamp type")
  }
}

// AWS Select response appendix uses direct counters; modeled responses use Details.
test "event stream direct statistics frames" {
  let stats = decodeSelectEvent(eventBytes("AAAAqwAAACq5brg4DTptZXNzYWdlLXR5cGUHAAVldmVudAs6ZXZlbnQtdHlwZQcABVN0YXRzPFN0YXRzPjxCeXRlc1NjYW5uZWQ+NDI8L0J5dGVzU2Nhbm5lZD48Qnl0ZXNQcm9jZXNzZWQ+MzA8L0J5dGVzUHJvY2Vzc2VkPjxCeXRlc1JldHVybmVkPjc8L0J5dGVzUmV0dXJuZWQ+PC9TdGF0cz5s+lMi")) catch e {
    panic(e.message())
  }
  match (stats) {
    Stats(event) => {
      let details = xmlNeed(event.details, "details") catch _ {
        panic("details")
      }
      assert(
          (xmlNeed(details.bytesScanned, "scanned") catch _ {
            panic("scanned")
          }) ==
          42,
        "scanned",
      )
      assert(
          (xmlNeed(details.bytesProcessed, "processed") catch _ {
            panic("processed")
          }) ==
          30,
        "processed",
      )
      assert(
          (xmlNeed(details.bytesReturned, "returned") catch _ {
            panic("returned")
          }) ==
          7,
        "returned",
      )
    }
    _ => panic("Stats type")
  }
}

