test "event stream Select Stats" {
  let event = decodeSelectEvent(eventBytes("AAAAvgAAACoRbqDKDTptZXNzYWdlLXR5cGUHAAVldmVudAs6ZXZlbnQtdHlwZQcABVN0YXRzPFN0YXRzPjxEZXRhaWxzPjxCeXRlc1NjYW5uZWQ+NDI8L0J5dGVzU2Nhbm5lZD48Qnl0ZXNQcm9jZXNzZWQ+MzA8L0J5dGVzUHJvY2Vzc2VkPjxCeXRlc1JldHVybmVkPjc8L0J5dGVzUmV0dXJuZWQ+PC9EZXRhaWxzPjwvU3RhdHM+8dR2Gw==")) catch e {
    panic(e.message())
  }
  match (event) {
    Stats(_event) => {
      let d = xmlNeed(_event.details, "details") catch _ {
        panic("missing")
      }
      assert(
          (xmlNeed(d.bytesScanned, "scanned") catch _ {
            panic("missing")
          }) ==
          42,
        "scanned",
      )
      assert(
          (xmlNeed(d.bytesProcessed, "processed") catch _ {
            panic("missing")
          }) ==
          30,
        "processed",
      )
      assert(
          (xmlNeed(d.bytesReturned, "returned") catch _ {
            panic("missing")
          }) ==
          7,
        "returned",
      )
    }
    _ => panic("Stats type")
  }
}

