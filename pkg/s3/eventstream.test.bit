test "event stream error typed" {
  let _ = decodeSelectEvent(eventBytes("AAAAbgAAAE+lQ0pEDTptZXNzYWdlLXR5cGUHAAVlcnJvcgs6ZXJyb3ItY29kZQcACU5vU3VjaEtleQ46ZXJyb3ItbWVzc2FnZQcAD21pc3NpbmcgYXJ0aWNsZW1pc3NpbmcgYXJ0aWNsZThG5tg=")) catch e {
    assert(e.code == "NoSuchKey" && e.message == "missing article", "service detail")
    match (e.kind) {
      NoSuchKey => {}
      _ => panic("service kind")
    }
    return
  }
  panic("service error accepted")
}

