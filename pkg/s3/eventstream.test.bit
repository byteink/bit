// Exact nine vectors: smithy-typescript 5d104567b718, packages/core/src/
// submodules/event-streams/eventstream-codec/TestVectors.fixture.ts.
import { decodeBase64 } from "std/crypto"
import { contains } from "std/strings"

class EventVector {
  name: string,
  data: []byte,
  success: bool,
}

fn eventVectors(): []EventVector {
  return [
    EventVector{
      name = "all_headers",
      data = eventBytes("AAAAzAAAAK8PrmTKCmV2ZW50LXR5cGUEAACgDAxjb250ZW50LXR5cGUHABBhcHBsaWNhdGlvbi9qc29uCmJvb2wgZmFsc2UBCWJvb2wgdHJ1ZQAEYnl0ZQLPCGJ5dGUgYnVmBgAUSSdtIGEgbGl0dGxlIHRlYXBvdCEJdGltZXN0YW1wCAAAAAAAhF/tBWludDE2AwAqBWludDY0BQAAAAACh1eyBHV1aWQJAQIDBAUGBwgJCgsMDQ4PEHsnZm9vJzonYmFyJ32rpfEM"),
      success = true,
    },
    EventVector{
      name = "empty_message",
      data = eventBytes("AAAAEAAAAAAFwkjrfZjI/w=="),
      success = true,
    },
    EventVector{
      name = "int32_header",
      data = eventBytes("AAAALQAAABBBxCS4CmV2ZW50LXR5cGUEAACgDHsnZm9vJzonYmFyJ3029ICg"),
      success = true,
    },
    EventVector{
      name = "payload_no_headers",
      data = eventBytes("AAAAHQAAAAD9Uoxaeydmb28nOidiYXInfcNlOTY="),
      success = true,
    },
    EventVector{
      name = "payload_one_str_header",
      data = eventBytes("AAAAPQAAACAH/YOWDGNvbnRlbnQtdHlwZQcAEGFwcGxpY2F0aW9uL2pzb257J2Zvbyc6J2Jhcid9jZwIsQ=="),
      success = true,
    },
    EventVector{
      name = "corrupted_headers",
      data = eventBytes("AAAAPQAAACAH/YOWDGNvbnRlbnQtdHlwZQcAEGFwcGxpY2F0aW9uL2pzb257YWZvbyc6J2Jhcid9jZwIsQ=="),
      success = false,
    },
    EventVector{
      name = "corrupted_header_len",
      data = eventBytes("AAAAPQAAACEH/YOWDGNvbnRlbnQtdHlwZQcAEGFwcGxpY2F0aW9uL2pzb257J2Zvbyc6J2Jhcid9jZwIsQ=="),
      success = false,
    },
    EventVector{
      name = "corrupted_length",
      data = eventBytes("AAAAPgAAACAH/YOWDGNvbnRlbnQtdHlwZQcAEGFwcGxpY2F0aW9uL2pzb257J2Zvbyc6J2Jhcid9jZwIsQ=="),
      success = false,
    },
    EventVector{
      name = "corrupted_payload",
      data = eventBytes("AAAAHQAAAAD9UoxaWydmb28nOidiYXInfcNlOTY="),
      success = false,
    },
  ]
}

fn eventValue(message: EventMessage, name: string): EventHeaderValue {
  let (value, exists) = message.headers[name]
  assert(exists, "header ${name}")
  return value
}

fn eventMustFail(data: []byte, reason: string) {
  let _ = decodeEventMessage(data) catch e {
    assert(contains(e.message(), reason), "${reason}: ${e.message()}")
    if (reason == "CRC mismatch") {
      match (e.kind) {
        ChecksumMismatch => return
        _ => panic("wrong CRC error kind")
      }
    }
    match (e.kind) {
      InvalidInput(_) => return
      _ => panic("wrong framing error kind")
    }
  }
  panic("accepted ${reason}")
}

test "event stream upstream nine vectors and exact values" {
  let vectors = eventVectors()
  assert(len(vectors) == 9, "nine upstream vectors")
  let passed = 0
  for row of vectors {
    if (!row.success) {
      eventMustFail(row.data, "CRC mismatch")
      passed = passed + 1
      continue
    }
    let message = decodeEventMessage(row.data) catch e {
      panic(e.message())
    }
    let expected = "{'foo':'bar'}"
    if (row.name == "empty_message") {
      expected = ""
    }
    assert(string(message.payload) == expected, "payload ${row.name}")
    assert(len(message.headers) == vectorHeaderCount(row.name), "headers ${row.name}")
    if (row.name == "int32_header" || row.name == "all_headers") {
      match (eventValue(message, "event-type")) {
        Integer(n) => assert(n == 40972, "int32")
        _ => panic("integer type")
      }
    }
    if (row.name == "payload_one_str_header" || row.name == "all_headers") {
      match (eventValue(message, "content-type")) {
        Text(s) => assert(s == "application/json", "string")
        _ => panic("string type")
      }
    }
    passed = passed + 1
  }
  println("event stream vectors ${passed} of ${len(vectors)}")
}

fn vectorHeaderCount(name: string): int {
  if (name == "all_headers") {
    return 10
  }
  if (name == "int32_header" || name == "payload_one_str_header") {
    return 1
  }
  return 0
}

test "event stream all header types preserve their values" {
  let message = decodeEventMessage(eventVectors()[0].data) catch e {
    panic(e.message())
  }
  assert(len(message.headers) == 10, "header count")
  match (eventValue(message, "bool true")) {
    Bool(v) => assert(v, "true")
    _ => panic("bool")
  }
  match (eventValue(message, "bool false")) {
    Bool(v) => assert(!v, "false")
    _ => panic("bool")
  }
  match (eventValue(message, "byte")) {
    Byte(v) => assert(v == -49, "signed byte")
    _ => panic("byte")
  }
  match (eventValue(message, "int16")) {
    Short(v) => assert(v == 42, "short")
    _ => panic("short")
  }
}

test "event stream binary long timestamp uuid headers" {
  let message = decodeEventMessage(eventVectors()[0].data) catch e {
    panic(e.message())
  }
  match (eventValue(message, "int64")) {
    Long(v) => assert(v == 42424242, "long")
    _ => panic("long")
  }
  match (eventValue(message, "timestamp")) {
    Timestamp(v) => assert(v == 8675309, "millis")
    _ => panic("timestamp")
  }
  match (eventValue(message, "byte buf")) {
    Binary(v) => assert(string(v) == "I'm a little teapot!", "binary")
    _ => panic("binary")
  }
  match (eventValue(message, "uuid")) {
    Uuid(v) => {
      assert(len(v) == 16, "uuid size")
      let i = 0
      while (i < 16) {
        assert(v[i] == byte(i + 1), "uuid byte")
        i = i + 1
      }
    }
    _ => panic("uuid")
  }
}

test "event stream every single byte flip is rejected" {
  let original = eventVectors()[0].data
  let rejected = 0
  let i = 0
  while (i < len(original)) {
    let changed = []byte(len(original))
    let j = 0
    while (j < len(original)) {
      changed[j] = original[j]
      j = j + 1
    }
    changed[i] = changed[i] ^ 1
    eventMustFail(changed, "CRC mismatch")
    rejected = rejected + 1
    i = i + 1
  }
  println("event stream CRC sweep ${rejected} of ${len(original)}")
}

// Synthetic malformed frames: independently computed zlib CRC-32.
test "event stream malformed boundaries and resource policy" {
  eventMustFail(eventBytes("AAAAEwAAAAPba2OBAAAAYlpP7Q=="), "empty header name")
  eventMustFail(eventBytes("AAAAEwAAAAPba2OBAXgKZKs/Og=="), "unknown header type")
  eventMustFail(eventBytes("AAAAGAAAAAg7aYsYAXgHABBhYmN3HNcO"), "truncated header")
  eventMustFail(eventBytes("AAAAFgAAAAZj4Rh+AXgAAXgBfn80dA=="), "duplicate header name")
  eventMustFail(eventBytes("AAAAEwAAAAPba2OBAf8A8LzYqA=="), "invalid UTF-8 header")
  eventMustFail(eventBytes("AAAAEgAAAAKRDHqnAXg8BP5R"), "truncated header")
  eventMustFail(eventBytes("AAAAFgAAAAZj4Rh+AXgHAAH/RpJ7Xg=="), "invalid UTF-8 header")
  eventMustFail(eventBytes("AQAAAQAAAACU6PZH"), "local 16 MiB limit")
  eventMustFail(eventBytes("AAAAEAAAAAFyxXh9AAAAAA=="), "invalid message length")
  eventMustFail(eventBytes(""), "truncated prelude")
  eventMustFail(eventBytes("AAAAEAAAAAAFwkjrfZjI/wA="), "invalid message length")
  println("event stream negative vectors 11 of 11")
}

test "event stream Select Records" {
  let event = decodeSelectEvent(eventBytes("AAAARAAAACz6iU0DDTptZXNzYWdlLXR5cGUHAAVldmVudAs6ZXZlbnQtdHlwZQcAB1JlY29yZHNwYXJ0aWFsLFBx8G0=")) catch e {
    panic(e.message())
  }
  match (event) {
    Records(_event) => {
      let bytes = xmlNeed(_event.payload, "payload") catch _ {
        panic("missing")
      }
      assert(string(bytes) == "partial,", "fragment")
    }
    _ => panic("Records type")
  }
}

