// pkg/s3/profilefile.test.bit — profilefile.bit: the shared AWS config and
// credentials file parser against the vectors of the SDK's own tests.
//
// Vectors are translated one for one from smithy-typescript
// (commit 5d104567b718, packages/core/src/submodules/config/shared-ini-file-loader):
//   parseIni.spec.ts, getConfigData.spec.ts, mergeConfigFiles.spec.ts,
//   getProfileName.spec.ts, getConfigFilepath.spec.ts,
//   getCredentialsFilepath.spec.ts, loadSharedConfigFiles.spec.ts
// and the static-credentials profile of aws-sdk-js-v3
// packages-internal/credential-provider-ini (resolveProfileData.ts,
// resolveStaticCredentials.ts). Cases tagged `own:` are not from the SDK: they
// pin the parts of the SDK's behaviour its tests leave implicit (comments,
// CRLF, a byte-order mark, the quoted-name rule, the `profile.x` collision).
// The SDK swallows read and parse errors; here they are typed errors, so its
// "swallows error" cases are replaced by the error cases at the end.

import { envOr } from "std/os"
import { contains } from "std/strings"
import { mkdir, remove, writeFile } from "std/fs"
import { now } from "std/time"

// A passing vector count: every `eq` and `fails` asserts, so `n` of `n`
// printed at the end is by construction, and a failing one stops the test.
class Tally {
  n: int

  init() {
    this.n = 0
  }
}

fn sameMap(a: map<string, string>, b: map<string, string>): bool {
  if (len(a) != len(b)) {
    return false
  }
  for (k, v) of a {
    let (w, ok) = b[k]
    if (!ok || w != v) {
      return false
    }
  }
  return true
}

fn same(a: IniData, b: IniData): bool {
  if (len(a.order) != len(b.order)) {
    return false
  }
  for name of a.order {
    let (x, _) = a.sections[name]
    let (y, ok) = b.sections[name]
    if (!ok || !sameMap(x, y)) {
      return false
    }
  }
  return true
}

fn show(d: IniData): string {
  let out = ""
  for name of d.order {
    out = out + "[${name}]"
    let (m, _) = d.sections[name]
    for (k, v) of m {
      out = out + " ${k}=${v}"
    }
    out = out + "; "
  }
  return out
}

fn eq(t: Tally, label: string, got: IniData, want: IniData) {
  assert(same(got, want), "${label}: got ${show(got)}, want ${show(want)}")
  t.n = t.n + 1
}

fn parsed(text: string): IniData {
  return parseIni("mock", text) catch e {
    panic("parseIni: ${e.message()}")
  }
}

// The message `parseIni` fails with, "" when it succeeds.
fn parseError(text: string): string {
  parseIni("mock", text) catch e {
    return e.message()
  }
  return ""
}

fn one(section: string, key: string, value: string): IniData {
  let d = IniData()
  d.set(section, key, value)
  return d
}

// ---- parseIni.spec.ts ------------------------------------------------------

test "parseIni vectors (parseIni.spec.ts)" {
  let t = Tally()
  // throws error if profile name is '%s'
  assert(
      parseError("[__proto__]\nfoo = not_exist") ==
      "s3: shared config: mock:1: invalid profile name \"__proto__\"",
    "proto",
  )
  assert(
      parseError("[profile __proto__]\nfoo = not_exist") ==
      "s3: shared config: mock:1: invalid profile name \"profile __proto__\"",
    "profile proto",
  )
  t.n = t.n + 2
  // trims data from key/value
  eq(
    t,
    "trim",
    parsed("[mock_profile_name]\n   key = value "),
    one("mock_profile_name", "key", "value"),
  )
  // returns value with equals sign
  eq(
    t,
    "equals",
    parsed("[mock_profile_name]\nkey=value=value\n"),
    one("mock_profile_name", "key", "value=value"),
  )
  // returns data for section '%s' with separator, for each IniSectionType
  eq(
    t,
    "profile",
    parsed("[profile mock_section_name]\nkey=value\n"),
    one("profile.mock_section_name", "key", "value"),
  )
  eq(
    t,
    "sso-session",
    parsed("[sso-session mock_section_name]\nkey=value\n"),
    one("sso-session.mock_section_name", "key", "value"),
  )
  eq(
    t,
    "services",
    parsed("[services mock_section_name]\nkey=value\n"),
    one("services.mock_section_name", "key", "value"),
  )
  // returns data for character '%s' in profile name
  let chars = ["-", "_", "@", "+", ".", "/", "%", ":"]
  for c of chars {
    let name = "profile" + c + "stage"
    eq(
      t,
      "char ${c}",
      parsed("[profile ${name}]\nkey=value\n"),
      one("profile.${name}", "key", "value"),
    )
  }
  // returns data for two profiles
  let two = one("mock_profile_name", "key", "value")
  two.set("mock_profile_name_2", "key2", "value2")
  eq(t, "two", parsed("[mock_profile_name]\nkey=value\n[mock_profile_name_2]\nkey2=value2\n"), two)
  // skip section if data is not present
  eq(
    t,
    "skip after",
    parsed("[mock_profile_name]\nkey=value\n[mock_profile_name_without_data]"),
    one("mock_profile_name", "key", "value"),
  )
  eq(
    t,
    "skip before",
    parsed("[mock_profile_name_without_data]\n[mock_profile_name]\nkey=value\n"),
    one("mock_profile_name", "key", "value"),
  )
  // returns data for profile containing multiple entries
  let many = one("mock_profile_name", "key1", "value1")
  many.set("mock_profile_name", "key2", "value2")
  many.set("mock_profile_name", "key3", "value3")
  eq(t, "multiple", parsed("[mock_profile_name]\nkey1=value1\nkey2=value2\nkey3=value3\n"), many)
  // returns data from main section, and not subsection: subsection after section
  let after = one("mock_profile_name", "key", "keyValue")
  after.set("mock_profile_name", "subSection.key", "keyValueInSubSection")
  after.set("mock_profile_name", "subSection.subKey", "subKeyValue")
  let first = "[mock_profile_name]\nkey=keyValue\nsubSection=\n    key=keyValueInSubSection\n    subKey=subKeyValue\n"
  eq(t, "subsection after", parsed(first), after)
  let after2 = IniData()
  after2.put("mock_profile_name", sectionOf(after, "mock_profile_name"))
  after2.set("mock_profile_name_2", "key", "keyValue2")
  after2.set("mock_profile_name_2", "subSection.key", "keyValue2InSubSection")
  after2.set("mock_profile_name_2", "subSection.subKey", "subKeyValue2")
  let second = "[mock_profile_name_2]\nkey=keyValue2\nsubSection=\n    key=keyValue2InSubSection\n    subKey=subKeyValue2\n"
  eq(t, "subsection after, two profiles", parsed(first + second), after2)
  // ... and subsection before section
  let before = one("mock_profile_name", "subSection.key", "keyValueInSubSection")
  before.set("mock_profile_name", "subSection.subKey", "subKeyValue")
  before.set("mock_profile_name", "key", "keyValue")
  eq(
    t,
    "subsection before",
    parsed("[mock_profile_name]\nsubSection=\n    key=keyValueInSubSection\n    subKey=subKeyValue\nkey=keyValue\n"),
    before,
  )
  println("parseIni.spec.ts vectors: ${t.n} of ${t.n}")
  assert(t.n == 22, "vector count")
}

fn sectionOf(d: IniData, name: string): map<string, string> {
  let (m, _) = d.sections[name]
  return m
}

// ---- getConfigData.spec.ts -------------------------------------------------

fn dotted(prefix: string, name: string, key: string, value: string): IniData {
  return one(prefix + "." + name, key, value)
}

test "configData vectors (getConfigData.spec.ts)" {
  let t = Tally()
  // returns empty for no data
  eq(t, "empty", configData(IniData()), IniData())
  // returns default profile if present
  eq(t, "default", configData(one("default", "key", "value")), one("default", "key", "value"))
  // skips profiles without prefix profile
  eq(t, "no prefix", configData(one("test", "key", "value")), IniData())
  // includes sections with 'sso-session' / 'services' prefix, also with a dotted name
  for prefix of ["sso-session", "services"] {
    let a = dotted(prefix, "test", "key", "value")
    eq(t, "${prefix}", configData(a), a)
    let b = dotted(prefix, "foo.bar", "key", "value")
    eq(t, "${prefix} dotted", configData(b), b)
  }
  // normalizes profile names: containing the separator, one, two, three
  for names of [["foo.bar"], ["one"], ["one", "two"], ["one", "two", "three"]] {
    let input = IniData()
    let want = IniData()
    for n of names {
      for k of [1, 2, 3] {
        input.set("profile." + n, "key_${n}_${k}", "value_${n}_${k}")
        want.set(n, "key_${n}_${k}", "value_${n}_${k}")
      }
    }
    eq(t, "profiles ${len(names)}", configData(input), want)
  }
  // with default
  let withDefault = one("default", "key", "value")
  withDefault.set("profile.one", "key_one_1", "value_one_1")
  let wantDefault = one("default", "key", "value")
  wantDefault.set("one", "key_one_1", "value_one_1")
  eq(t, "with default", configData(withDefault), wantDefault)
  // with profileName without prefix
  let unprefixed = one("test", "key", "value")
  unprefixed.set("profile.one", "key_one_1", "value_one_1")
  eq(t, "unprefixed dropped", configData(unprefixed), one("one", "key_one_1", "value_one_1"))
  println("getConfigData.spec.ts vectors: ${t.n} of ${t.n}")
  assert(t.n == 13, "vector count")
}

// ---- mergeConfigFiles.spec.ts, parseKnownFiles.spec.ts ---------------------

test "mergeFiles vectors (mergeConfigFiles.spec.ts, parseKnownFiles.spec.ts)" {
  let t = Tally()
  let config = one("profileName1", "configKey", "configValue1")
  let creds = one("profileName1", "credsKey", "configValue1")
  creds.set("profileName2", "credsKey", "credsValue1")
  let want = one("profileName1", "configKey", "configValue1")
  want.set("profileName1", "credsKey", "configValue1")
  want.set("profileName2", "credsKey", "credsValue1")
  eq(t, "merges profiles in multiple files", mergeFiles([config, creds]), want)
  // parseKnownFiles.spec.ts
  let c2 = one("profileName1", "configKey1", "configValue1")
  c2.set("profileName2", "configKey2", "configValue2")
  let k2 = one("profileName1", "credsKey1", "credsValue1")
  k2.set("profileName2", "credsKey2", "credsValue2")
  let w2 = one("profileName1", "configKey1", "configValue1")
  w2.set("profileName1", "credsKey1", "credsValue1")
  w2.set("profileName2", "configKey2", "configValue2")
  w2.set("profileName2", "credsKey2", "credsValue2")
  eq(t, "parseKnownFiles merge", mergeFiles([c2, k2]), w2)
  // own: the credentials file wins for the same key, and no input is altered
  let loser = one("p", "aws_access_key_id", "FROM_CONFIG")
  let winner = one("p", "aws_access_key_id", "FROM_CREDENTIALS")
  eq(t, "own: credentials file wins", mergeFiles([loser, winner]), winner)
  eq(t, "own: config untouched", loser, one("p", "aws_access_key_id", "FROM_CONFIG"))
  println("mergeConfigFiles.spec.ts, parseKnownFiles.spec.ts vectors: ${t.n} of ${t.n}")
  assert(t.n == 4, "vector count")
}

// ---- getProfileName.spec.ts, getConfigFilepath.spec.ts, getCredentialsFilepath.spec.ts

test "profile name and file location vectors" {
  // returns profile if present in param
  assert(profileNameFor("mockProfile", "mockProfileNameFromEnv") == "mockProfile", "param")
  // returns profile from env var AWS_PROFILE if present
  assert(profileNameFor("", "mockProfileNameFromEnv") == "mockProfileNameFromEnv", "env")
  // returns profile 'default' as default
  assert(profileNameFor("", "") == "default", "default")
  // getConfigFilepath / getCredentialsFilepath: the location from the environment wins as is
  let cfg = locate("/mock/file/path/config", "~/.aws/config") catch e {
    panic(e.message())
  }
  assert(cfg == "/mock/file/path/config", "config from environment")
  // ... else <home>/.aws/config, <home>/.aws/credentials (loadSharedConfigFiles.spec.ts expands "~/")
  let home = expandHome("~/") catch e {
    panic(e.message())
  }
  let dc = locate("", "~/.aws/config") catch e {
    panic(e.message())
  }
  assert(dc == pathJoinTest(home, ".aws/config"), "default config ${dc}")
  let dk = locate("", "~/.aws/credentials") catch e {
    panic(e.message())
  }
  assert(dk == pathJoinTest(home, ".aws/credentials"), "default credentials ${dk}")
  let ex = expandHome("~/path/credentials") catch e {
    panic(e.message())
  }
  assert(ex == pathJoinTest(home, "path/credentials"), "expanded ${ex}")
  let plain = expandHome("/users/alias/path/config") catch e {
    panic(e.message())
  }
  assert(plain == "/users/alias/path/config", "not expanded")
  println("profile name and file location vectors: 8 of 8")
}

fn pathJoinTest(home: string, rest: string): string {
  if (home[len(home) - 1] == '/') {
    return home + rest
  }
  return home + "/" + rest
}

// ---- own: the parser's behaviour the SDK's tests leave implicit ------------

test "own: comments, CRLF, byte-order mark and ignored lines" {
  let t = Tally()
  let want = one("default", "region", "eu-west-1")
  eq(t, "hash comment", parsed("# top\n[default] # c\nregion = eu-west-1 # c\n"), want)
  eq(t, "semicolon comment", parsed("; top\n[default] ; c\nregion = eu-west-1 ; c\n"), want)
  eq(
    t,
    "hash needs leading space",
    parsed("[default]\nregion = eu#west\n"),
    one("default", "region", "eu#west"),
  )
  eq(t, "comment after tab", parsed("[default]\nregion = eu-west-1\t#c\n"), want)
  eq(t, "CRLF", parsed("[default]\r\nregion = eu-west-1\r\n"), want)
  eq(t, "BOM", parsed("\xEF\xBB\xBF[default]\nregion = eu-west-1\n"), want)
  eq(t, "line before a section", parsed("region = x\n[default]\nregion = eu-west-1\n"), want)
  eq(t, "line without equals", parsed("[default]\nnonsense\nregion = eu-west-1\n"), want)
  eq(t, "line starting with equals", parsed("[default]\n= x\nregion = eu-west-1\n"), want)
  eq(t, "unknown prefix skipped", parsed("[foo bar]\nk = v\n[default]\nregion = eu-west-1\n"), want)
  eq(
    t,
    "repeated section merges",
    parsed("[default]\na = 1\n[x]\nb = 2\n[default]\na = 3\n"),
    mergedAB(),
  )
  eq(
    t,
    "NBSP around key",
    parsed("[default]\n\xC2\xA0region\xC2\xA0=\xC2\xA0eu-west-1\xC2\xA0\n"),
    want,
  )
  println("own comment/whitespace vectors: ${t.n} of ${t.n}")
  assert(t.n == 12, "vector count")
}

fn mergedAB(): IniData {
  let d = one("default", "a", "3")
  d.set("x", "b", "2")
  return d
}

test "own: section names" {
  let t = Tally()
  eq(
    t,
    "quoted profile",
    parsed("[profile \"my-prof\"]\nk = v\n"),
    one("profile.my-prof", "k", "v"),
  )
  eq(
    t,
    "single-quoted profile",
    parsed("[profile 'my-prof']\nk = v\n"),
    one("profile.my-prof", "k", "v"),
  )
  eq(
    t,
    "unclosed quote is a plain name",
    parsed("[profile \"x]\nk = v\n"),
    one("profile \"x", "k", "v"),
  )
  eq(
    t,
    "mismatched quote is a plain name",
    parsed("[profile \"x']\nk = v\n"),
    one("profile \"x'", "k", "v"),
  )
  eq(t, "two spaces is a plain name", parsed("[profile  x]\nk = v\n"), one("profile  x", "k", "v"))
  eq(
    t,
    "spaces inside brackets are kept",
    parsed("[ default ]\nk = v\n"),
    one(" default ", "k", "v"),
  )
  eq(t, "empty name is skipped", parsed("[]\nk = v\n"), IniData())
  eq(t, "profile.x is profile x", parsed("[profile.x]\nk = v\n"), one("profile.x", "k", "v"))
  eq(
    t,
    "sso-session quoted",
    parsed("[sso-session \"s1\"]\nsso_region = us-east-1\n"),
    one("sso-session.s1", "sso_region", "us-east-1"),
  )
  println("own section-name vectors: ${t.n} of ${t.n}")
  assert(t.n == 9, "vector count")
}

test "own: the config file's profile and the credentials file's section are the same profile" {
  let t = Tally()
  let config = configData(parsed("[default]\nregion = us-east-1\n[profile dev]\nregion = eu-west-1\n[sso-session s]\nsso_region = us-east-1\n[services svc]\nx = y\n[bare]\nz = 1\n"))
  let want = one("default", "region", "us-east-1")
  want.set("dev", "region", "eu-west-1")
  want.set("sso-session.s", "sso_region", "us-east-1")
  want.set("services.svc", "x", "y")
  eq(t, "config file", config, want)
  // the credentials file has no prefix handling: `[profile dev]` there is "profile.dev"
  let creds = parsed("[dev]\naws_access_key_id = AKIA\n[profile other]\nk = v\n")
  let both = mergeFiles([config, creds])
  assert(sectionOf(both, "dev")["region"] == "eu-west-1", "config key kept")
  assert(sectionOf(both, "dev")["aws_access_key_id"] == "AKIA", "credentials key merged")
  assert(sectionOf(both, "profile.other")["k"] == "v", "credentials-file prefix is not stripped")
  // [default] and [profile default] both present: the profile section wins, in the SDK's position
  let clash = configData(parsed("[default]\na = 1\n[profile default]\na = 2\n"))
  eq(t, "profile default wins", clash, one("default", "a", "2"))
  println("own normalisation vectors: ${t.n} of ${t.n}")
}

// ---- errors: files, lines, secrets -----------------------------------------

fn scratchDir(tag: string): string {
  let dir = envOr("TMPDIR", "/tmp") + "/t6609-${tag}-${now().ns}"
  mkdir(dir) catch e {
    panic("mkdir ${dir}: ${e.message()}")
  }
  return dir
}

fn write(path: string, text: string) {
  writeFile(path, text) catch e {
    panic("write ${path}: ${e.message()}")
  }
}

fn loadError(configPath: string, credentialsPath: string): string {
  loadProfiles(configPath, credentialsPath) catch e {
    return e.message()
  }
  return ""
}

test "a missing file is not an error, an unreadable or malformed one is, naming file and line" {
  let dir = scratchDir("files")
  let cfg = dir + "/config"
  let cred = dir + "/credentials"
  let none = loadProfiles(cfg, cred) catch e {
    panic("missing files: ${e.message()}")
  }
  assert(len(none.order) == 0, "both missing reads empty")
  write(cred, "[default]\naws_access_key_id = AKIDEXAMPLE\naws_secret_access_key = SECRETVALUE\n")
  let only = loadProfiles(cfg, cred) catch e {
    panic("credentials only: ${e.message()}")
  }
  assert(len(only.order) == 1, "credentials file alone")
  // a directory where a file should be: exists, cannot be read
  let msg = loadError(dir, cred)
  assert(msg != "" && contains(msg, dir) && contains(msg, "cannot be read"), "directory: ${msg}")
  // a malformed section name: file and line
  write(cfg, "[default]\nregion = x\n\n[profile __proto__]\nk = SECRETVALUE\n")
  let bad = loadError(cfg, cred)
  assert(
    bad == "s3: shared config: ${cfg}:4: invalid profile name \"profile __proto__\"",
    "line: ${bad}",
  )
  assert(!contains(bad, "SECRETVALUE"), "no value in the error")
  let typed = loadProfiles(cfg, cred) catch e {
    let pe = e.(ProfileFileError)
    assert(pe.line == 4 && pe.path == cfg, "typed error carries path and line")
    remove(cfg) catch _ {}
    remove(cred) catch _ {}
    remove(dir) catch _ {}
    return
  }
  assert(false, "expected a ProfileFileError, got ${show(typed)}")
}

test "an oversized file is refused before it is read" {
  let dir = scratchDir("big")
  let big = dir + "/config"
  let chunk = "# " + padding(1023) + "\n"
  let text = ""
  let i = 0
  while (i < 4097) {
    text = text + chunk
    i = i + 1
  }
  write(big, text)
  let msg = loadError(big, dir + "/credentials")
  assert(contains(msg, "is larger than 4194304 bytes"), "oversized: ${msg}")
  remove(big) catch _ {}
  remove(dir) catch _ {}
}

fn padding(n: int): string {
  let out = ""
  let i = 0
  while (i < n) {
    out = out + "x"
    i = i + 1
  }
  return out
}

// ---- credentials from a profile --------------------------------------------

fn credError(profiles: IniData, name: string): string {
  credentialsOf(name, profiles) catch e {
    return e.message()
  }
  return ""
}

test "a static-keys profile resolves, the credentials file wins over the config file" {
  let profiles = mergeFiles(
    [
      configData(parsed("[profile dev]\naws_access_key_id = AKIA_FROM_CONFIG\naws_secret_access_key = S1\nregion = eu-west-1\n")),
      parsed("[dev]\naws_access_key_id = AKIA_FROM_CREDENTIALS\naws_session_token = TOKEN\naws_account_id = 123456789012\n"),
    ],
  )
  let c = credentialsOf("dev", profiles) catch e {
    panic(e.message())
  }
  assert(c.accessKeyId == "AKIA_FROM_CREDENTIALS", "credentials file value wins")
  assert(c.token() == "TOKEN", "session token")
  match (c.accountId) {
    Some(a) => assert(a == "123456789012", "account id")
    None => assert(false, "account id missing")
  }
  assert(c.show() == "AwsCredential(AKIA_FROM_CREDENTIALS)", "prints the key id only")
}

test "a profile that cannot give static keys fails loudly, naming the ticket that implements it" {
  let profiles = parsed(
      "[default]\naws_access_key_id = A\naws_secret_access_key = S\n" +
      "[role]\nrole_arn = arn:aws:iam::1:role/r\nsource_profile = default\n" +
      "[rolecs]\nrole_arn = arn:aws:iam::1:role/r\ncredential_source = Environment\n" +
      "[rolestatic]\nrole_arn = arn:aws:iam::1:role/r\nsource_profile = default\naws_access_key_id = A\naws_secret_access_key = S\n" +
      "[web]\nweb_identity_token_file = /t\nrole_arn = arn:aws:iam::1:role/r\n" +
      "[proc]\ncredential_process = /bin/true\n" +
      "[sso]\nsso_session = s\n" +
      "[ssolegacy]\nsso_start_url = https://x\n" +
      "[login]\nlogin_session = arn\n" +
      "[half]\naws_access_key_id = A\n" +
      "[empty]\nregion = x\n",
  )
  assert(contains(credError(profiles, "role"), "(#6626)"), "role")
  assert(contains(credError(profiles, "rolecs"), "(#6626)"), "credential_source")
  assert(
    contains(credError(profiles, "rolestatic"), "(#6626)"),
    "role beats static keys on the first hop",
  )
  assert(contains(credError(profiles, "web"), "(#6625)"), "web identity")
  assert(contains(credError(profiles, "proc"), "(#6616)"), "credential_process")
  assert(contains(credError(profiles, "sso"), "(#6617)"), "sso_session")
  assert(contains(credError(profiles, "ssolegacy"), "(#6617)"), "sso_start_url")
  assert(contains(credError(profiles, "login"), "login_session"), "login")
  assert(
    contains(credError(profiles, "half"), "no aws_access_key_id and aws_secret_access_key pair"),
    "half a pair",
  )
  assert(
    contains(credError(profiles, "empty"), "no aws_access_key_id and aws_secret_access_key pair"),
    "no keys",
  )
  assert(contains(credError(profiles, "missing"), "[missing] is in neither"), "unknown profile")
  assert(credError(profiles, "default") == "", "the static profile still resolves")
}

test "no error text carries a credential value" {
  let secret = "SUPERSECRETKEYVALUE"
  let profiles = parsed("[a]\naws_access_key_id = AK\x01ID\naws_secret_access_key = ${secret}\n[b]\naws_access_key_id = A\naws_secret_access_key = ${secret}\naws_session_token = TOK\x02EN\n")
  for name of ["a", "b"] {
    let msg = credError(profiles, name)
    assert(msg != "", "${name} is refused")
    assert(!contains(msg, secret) && !contains(msg, "TOK"), "no value in: ${msg}")
  }
}

test "Credentials.Profile fails at construction for an unknown profile and an empty name" {
  let _ = Credentials.Profile("t6609-no-such-profile").resolver() catch e {
    assert(contains(e.message(), "t6609-no-such-profile"), "names the profile")
    return
  }
  assert(false, "expected a failure")
}
