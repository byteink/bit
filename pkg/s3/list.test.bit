// pkg/s3/list.test.bit — ListObjectsV2 XML parsing at the unit level
// (`parseListObjectsV2`, `parseContentsBlock`). The iterator's paging
// against a real server is client.live.test.bit's job.

fn sampleBody(truncated: string, nextToken: string): string {
  let tail = ""
  if (nextToken != "") {
    tail = "<NextContinuationToken>${nextToken}</NextContinuationToken>"
  }
  return "<?xml version=\"1.0\" encoding=\"UTF-8\"?><ListBucketResult>" +
    "<Name>photos</Name><Prefix>a/</Prefix><IsTruncated>${truncated}</IsTruncated>" +
    "<Contents><Key>a/one.jpg</Key><LastModified>2024-01-02T03:04:05.000Z</LastModified>" +
    "<ETag>\"abc123\"</ETag><Size>1024</Size><StorageClass>STANDARD</StorageClass></Contents>" +
    "<Contents><Key>a/two &amp; three.jpg</Key><LastModified>2024-01-02T03:05:00.000Z</LastModified>" +
    "<ETag>\"def456\"</ETag><Size>2048</Size><StorageClass>STANDARD</StorageClass></Contents>" +
    tail +
    "</ListBucketResult>"
}

test "parseListObjectsV2 reads every Contents block, unescaped" {
  let body = sampleBody("false", "")
  let (entries, truncated, nextToken) = parseListObjectsV2(body)
  assert(len(entries) == 2, "entries = ${len(entries)}")
  assert(entries[0].key == "a/one.jpg", "key0 = ${entries[0].key}")
  assert(entries[0].size == 1024, "size0 = ${entries[0].size}")
  assert(entries[0].etag == "\"abc123\"", "etag0 = ${entries[0].etag}")
  assert(
    entries[0].lastModified == "2024-01-02T03:04:05.000Z",
    "lastModified0 = ${entries[0].lastModified}",
  )
  assert(entries[1].key == "a/two & three.jpg", "key1 = ${entries[1].key}")
  assert(!truncated, "expected not truncated")
  assert(nextToken == "", "expected no continuation token")
}

test "parseListObjectsV2 reports IsTruncated and NextContinuationToken" {
  let body = sampleBody("true", "token-2")
  let (entries, truncated, nextToken) = parseListObjectsV2(body)
  assert(len(entries) == 2, "entries = ${len(entries)}")
  assert(truncated, "expected truncated")
  assert(nextToken == "token-2", "nextToken = ${nextToken}")
}

test "parseListObjectsV2 returns no entries for an empty bucket" {
  let body = "<ListBucketResult><IsTruncated>false</IsTruncated></ListBucketResult>"
  let (entries, truncated, nextToken) = parseListObjectsV2(body)
  assert(len(entries) == 0, "entries = ${len(entries)}")
  assert(!truncated, "expected not truncated")
  assert(nextToken == "", "expected no continuation token")
}

test "ObjectIterator.next drains two pre-loaded pages and then returns None" {
  let it = ObjectIterator{
    cfg = Config{ endpoint = "", region = "", bucket = "", accessKeyId = "", secretKey = "" },
    prefix = "",
    entries = [
      ObjectEntry{ key = "a", size = 1, etag = "", lastModified = "" },
      ObjectEntry{ key = "b", size = 2, etag = "", lastModified = "" },
    ],
    pos = 0,
    continuationToken = "",
    fetchedFirstPage = true,
    morePages = false,
  }
  let first = it.next() catch e {
    assert(false, "next: ${e.message()}")
    return
  }
  let second = it.next() catch e {
    assert(false, "next: ${e.message()}")
    return
  }
  let third = it.next() catch e {
    assert(false, "next: ${e.message()}")
    return
  }
  match (first) {
    Some(e) => assert(e.key == "a", "first entry key = ${e.key}")
    None => assert(false, "expected Some for the first entry")
  }
  match (second) {
    Some(e) => assert(e.key == "b", "second entry key = ${e.key}")
    None => assert(false, "expected Some for the second entry")
  }
  match (third) {
    Some(e) => assert(false, "expected None once entries are exhausted, got '${e.key}'")
    None => return
  }
}
