test "restXml body vector 12 of 48: NestedXmlMapWithXmlNameDeserializes (XvNestedXmlMapWithXmlName)" {
  let h = responseHead(200, "")
  vecAdd(h, "Content-Type", "application/xml")
  h.text = "    <NestedXmlMapWithXmlNameResponse>\n        <nestedXmlMapWithXmlNameMap>\n            <entry>\n                <OuterKey>foo</OuterKey>\n                <value>\n                    <entry>\n                        <InnerKey>bar</InnerKey>\n                        <InnerValue>Baz</InnerValue>\n                    </entry>\n                    <entry>\n                        <InnerKey>fizz</InnerKey>\n                        <InnerValue>Buzz</InnerValue>\n                    </entry>\n                </value>\n            </entry>\n            <entry>\n                <OuterKey>qux</OuterKey>\n                <value>\n                    <entry>\n                        <InnerKey>foobar</InnerKey>\n                        <InnerValue>Bar</InnerValue>\n                    </entry>\n                    <entry>\n                        <InnerKey>fizzbuzz</InnerKey>\n                        <InnerValue>Buzz</InnerValue>\n                    </entry>\n                </value>\n            </entry>\n        </nestedXmlMapWithXmlNameMap>\n    </NestedXmlMapWithXmlNameResponse>\n"
  let out = deserializeXvNestedXmlMapWithXmlNameOutput(h) catch e {
    panic("NestedXmlMapWithXmlNameDeserializes: ${e.message()}")
  }
  assert(out.responseMetadata.httpStatusCode == 200, "status")
  let a1 = vecGot(
    out.nestedXmlMapWithXmlNameMap,
    "vector NestedXmlMapWithXmlNameDeserializes.nestedXmlMapWithXmlNameMap",
  )
  assert(
    len(a1) == 2,
    "vector NestedXmlMapWithXmlNameDeserializes.nestedXmlMapWithXmlNameMap length",
  )
  assert(
    len(a1["foo"]) == 2,
    "vector NestedXmlMapWithXmlNameDeserializes.nestedXmlMapWithXmlNameMap.foo length",
  )
  assert(
    a1["foo"]["bar"] == "Baz",
    "vector NestedXmlMapWithXmlNameDeserializes.nestedXmlMapWithXmlNameMap.foo.bar",
  )
  assert(
    a1["foo"]["fizz"] == "Buzz",
    "vector NestedXmlMapWithXmlNameDeserializes.nestedXmlMapWithXmlNameMap.foo.fizz",
  )
  assert(
    len(a1["qux"]) == 2,
    "vector NestedXmlMapWithXmlNameDeserializes.nestedXmlMapWithXmlNameMap.qux length",
  )
  assert(
    a1["qux"]["foobar"] == "Bar",
    "vector NestedXmlMapWithXmlNameDeserializes.nestedXmlMapWithXmlNameMap.qux.foobar",
  )
  assert(
    a1["qux"]["fizzbuzz"] == "Buzz",
    "vector NestedXmlMapWithXmlNameDeserializes.nestedXmlMapWithXmlNameMap.qux.fizzbuzz",
  )
  println("restXml body vector 12 of 48: NestedXmlMapWithXmlNameDeserializes")
}

