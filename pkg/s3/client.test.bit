// pkg/s3/client.test.bit — endpoint parsing, host-header derivation and
// path building, at the unit level (no network). The signed request against
// a real S3-compatible server is client.live.test.bit's job (a throwaway
// MinIO container, _tests_/bit/s3live.bit).

fn testConfig(endpoint: string): Config {
  return Config{
    endpoint = endpoint,
    region = "us-east-1",
    bucket = "photos",
    accessKeyId = "AKIDEXAMPLE",
    secretKey = "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
  }
}

test "parseEndpoint reads scheme, host and an explicit port" {
  let parts = parseEndpoint("http://127.0.0.1:9000") catch e {
    assert(false, "parseEndpoint: ${e.message()}")
    return
  }
  assert(!parts.https, "expected cleartext")
  assert(parts.host == "127.0.0.1", "host = ${parts.host}")
  assert(parts.port == 9000, "port = ${parts.port}")
}

test "parseEndpoint defaults the port per scheme when none is given" {
  let http = parseEndpoint("http://s3.example.com") catch e {
    assert(false, "parseEndpoint: ${e.message()}")
    return
  }
  assert(http.port == 80, "http default port = ${http.port}")

  let https = parseEndpoint("https://s3.example.com") catch e {
    assert(false, "parseEndpoint: ${e.message()}")
    return
  }
  assert(https.port == 443, "https default port = ${https.port}")
}

test "parseEndpoint fails without an http:// or https:// scheme" {
  parseEndpoint("s3.example.com:9000") catch e {
    assert(indexOf(e.message(), "http://") >= 0, "message = ${e.message()}")
    return
  }
  assert(false, "parseEndpoint accepted a schemeless endpoint")
}

test "signedHostValue omits the port only at the scheme's default" {
  let custom = parseEndpoint("http://127.0.0.1:9000") catch e {
    assert(false, "parseEndpoint: ${e.message()}")
    return
  }
  assert(signedHostValue(custom) == "127.0.0.1:9000", "custom port = ${signedHostValue(custom)}")

  let defaultHttps = parseEndpoint("https://s3.amazonaws.com") catch e {
    assert(false, "parseEndpoint: ${e.message()}")
    return
  }
  assert(
    signedHostValue(defaultHttps) == "s3.amazonaws.com",
    "default port = ${signedHostValue(defaultHttps)}",
  )
}

test "objectPath joins bucket and key with a single leading slash each" {
  assert(objectPath("photos", "cats/mine.jpg") == "/photos/cats/mine.jpg", "path mismatch")
}

test "signedRequest signs host, x-amz-content-sha256 and x-amz-date, and nothing else" {
  let cfg = testConfig("http://127.0.0.1:9000")
  let (url, headers) = signedRequest(
    cfg,
    "GET",
    objectPath(cfg.bucket, "a.txt"),
    [](string, string)(0),
    sha256Hex(""),
  ) catch e {
    assert(false, "signedRequest: ${e.message()}")
    return
  }
  assert(url == "http://127.0.0.1:9000/photos/a.txt", "url = ${url}")
  assert(len(headers) == 3, "expected 3 headers, got ${len(headers)}")
  let authz = headers[2].value
  assert(
    indexOf(authz, "SignedHeaders=host;x-amz-content-sha256;x-amz-date") >= 0,
    "authz = ${authz}",
  )
  assert(indexOf(authz, "Credential=AKIDEXAMPLE/") >= 0, "authz = ${authz}")
}
