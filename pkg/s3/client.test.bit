// pkg/s3/client.test.bit — path building and request signing, at the unit
// level (no network). The signed request against a real S3-compatible server
// is client.live.test.bit's job (a throwaway MinIO container,
// _tests_/bit/s3live.bit).

fn testConfig(endpoint: string): Config {
  return Config{
    endpoint = endpoint,
    region = "us-east-1",
    bucket = "photos",
    accessKeyId = "AKIDEXAMPLE",
    secretKey = "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
  }
}

test "objectPath joins bucket and key with a single leading slash each" {
  assert(objectPath("photos", "cats/mine.jpg") == "/photos/cats/mine.jpg", "path mismatch")
}

test "signedRequest signs host, x-amz-content-sha256 and x-amz-date, and nothing else" {
  let cfg = testConfig("http://127.0.0.1:9000")
  let (url, headers) = signedRequest(
    cfg,
    "GET",
    objectPath(cfg.bucket, "a.txt"),
    [](string, string)(0),
    sha256Hex(""),
  ) catch e {
    assert(false, "signedRequest: ${e.message()}")
    return
  }
  assert(url == "http://127.0.0.1:9000/photos/a.txt", "url = ${url}")
  assert(len(headers) == 3, "expected 3 headers, got ${len(headers)}")
  let authz = headers[2].value
  assert(
    indexOf(authz, "SignedHeaders=host;x-amz-content-sha256;x-amz-date") >= 0,
    "authz = ${authz}",
  )
  assert(indexOf(authz, "Credential=AKIDEXAMPLE/") >= 0, "authz = ${authz}")
}
