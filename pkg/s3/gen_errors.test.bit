// pkg/s3/gen_errors.test.bit — #6615. The generated error table as the rest of
// the package uses it: a wire code becomes a kind a caller matches on, every
// row is found again by its own code (so the table is sorted and unique), and a
// code the table does not name is carried, not lost.

test "a modeled and an unmodeled code map to their kinds" {
  assert(kindForCode("NoSuchKey") == ErrorKind.NoSuchKey, "NoSuchKey")
  assert(kindForCode("NoSuchBucket") == ErrorKind.NoSuchBucket, "NoSuchBucket")
  assert(kindForCode("SlowDown") == ErrorKind.SlowDown, "SlowDown")
  assert(kindForCode("EntityTooSmall") == ErrorKind.EntityTooSmall, "EntityTooSmall")
  assert(kindForCode("KMS.NotFoundException") == ErrorKind.KMSNotFoundException, "KMS code")
}

test "a code the table does not name is Unknown and keeps the code" {
  match (kindForCode("TotallyNewServerError")) {
    Unknown(c) => assert(c == "TotallyNewServerError", "code ${c}")
    _ => panic("not Unknown")
  }
  match (kindForCode("")) {
    Unknown(c) => assert(c == "", "code ${c}")
    _ => panic("the empty code is not Unknown")
  }
  assert(kindForCode("nosuchkey") != ErrorKind.NoSuchKey, "codes are case sensitive")
}

test "every row is found by its own code, with its kind, status and class" {
  let n = 0
  for row of wireErrors {
    match (lookupError(row.code)) {
      Some(found) => {
        assert(found.code == row.code && found.kind == row.kind, "row ${row.code}")
        assert(found.status == row.status, "status of ${row.code}")
      }
      None => panic("${row.code} is not found by its own code")
    }
    n = n + 1
  }
  assert(n == 266, "wire rows: ${n} of 266")
  println("wire rows found by their own code: ${n} of ${n}")
}

test "the table is sorted by code with no duplicate" {
  let i = 1
  while (i < len(wireErrors)) {
    assert(wireErrors[i - 1].code < wireErrors[i].code, "${wireErrors[i].code} is out of order")
    i = i + 1
  }
}

test "retry classes: throttling and transient are retried, the rest is not" {
  assert(retryClassOf(ErrorKind.SlowDown) == RetryClass.Throttling, "SlowDown")
  assert(retryClassOf(ErrorKind.InternalError) == RetryClass.Transient, "InternalError")
  assert(retryClassOf(ErrorKind.RequestTimeout) == RetryClass.Transient, "RequestTimeout")
  assert(retryClassOf(ErrorKind.NotImplemented) == RetryClass.Server, "NotImplemented")
  assert(retryClassOf(ErrorKind.NoSuchKey) == RetryClass.Client, "NoSuchKey")
  assert(retryClassOf(ErrorKind.Timeout) == RetryClass.Transient, "client Timeout")
  assert(retryClassOf(ErrorKind.Connection) == RetryClass.Transient, "client Connection")
  assert(retryClassOf(ErrorKind.ChecksumMismatch) == RetryClass.Client, "ChecksumMismatch")
  assert(retryClassOf(ErrorKind.InvalidInput("empty key")) == RetryClass.Client, "InvalidInput")
  assert(retryClassOf(ErrorKind.Unknown("X")) == RetryClass.Client, "Unknown")
}

test "documented statuses ride with the rows" {
  match (lookupError("NoSuchKey")) {
    Some(r) => assert(r.status == 404, "NoSuchKey status ${r.status}")
    None => panic("no row")
  }
  match (lookupError("SlowDown")) {
    Some(r) => assert(r.status == 503, "SlowDown status ${r.status}")
    None => panic("no row")
  }
  match (lookupError("NotFound")) {
    Some(r) => assert(r.status == 0, "NotFound has no modeled status, got ${r.status}")
    None => panic("no row")
  }
}

fn assertSourceError(code: string, kind: ErrorKind, status: int, retry: RetryClass) {
  match (lookupError(code)) {
    Some(row) => {
      assert(row.kind == kind && kindForCode(code) == kind, "kind of ${code}")
      assert(row.status == status, "status of ${code}: ${row.status}")
      assert(row.retry == retry && retryClassOf(kind) == retry, "retry of ${code}")
    }
    None => panic("source code ${code} is absent")
  }
}

// Rows extracted from the approved #6823 capture, including repeated codes.
test "Replication: 3 of 3 source rows map to the exact kind, status and retry class" {
  assertSourceError("InvalidArgument", ErrorKind.InvalidArgument, 400, RetryClass.Client)
  assertSourceError("InvalidRequest", ErrorKind.InvalidRequest, 400, RetryClass.Client)
  assertSourceError(
    "ReplicationConfigurationNotFoundError",
    ErrorKind.ReplicationConfigurationNotFoundError,
    404,
    RetryClass.Client,
  )
  println("Replication: 3 of 3 source rows")
}

// Rows extracted from the approved #6823 capture, including repeated codes.
test "Object Lambda: 9 of 9 source rows map to the exact kind, status and retry class" {
  assertSourceError(
    "LambdaInvalidResponse",
    ErrorKind.LambdaInvalidResponse,
    400,
    RetryClass.Client,
  )
  assertSourceError(
    "LambdaInvocationFailed",
    ErrorKind.LambdaInvocationFailed,
    400,
    RetryClass.Client,
  )
  assertSourceError("LambdaNotFound", ErrorKind.LambdaNotFound, 404, RetryClass.Client)
  assertSourceError(
    "LambdaPermissionError",
    ErrorKind.LambdaPermissionError,
    403,
    RetryClass.Client,
  )
  assertSourceError(
    "LambdaResponseNotReceived",
    ErrorKind.LambdaResponseNotReceived,
    500,
    RetryClass.Transient,
  )
  assertSourceError("LambdaRuntimeError", ErrorKind.LambdaRuntimeError, 500, RetryClass.Transient)
  assertSourceError("LambdaTimeout", ErrorKind.LambdaTimeout, 500, RetryClass.Transient)
  assertSourceError("SlowDown", ErrorKind.SlowDown, 503, RetryClass.Throttling)
  assertSourceError("ValidationError", ErrorKind.ValidationError, 400, RetryClass.Client)
  println("Object Lambda: 9 of 9 source rows")
}

// Rows extracted from the approved #6823 capture, including repeated codes.
test "FSx through S3 access points: 4 of 4 source rows map to the exact kind, status and retry class" {
  assertSourceError("AccessDenied", ErrorKind.AccessDenied, 403, RetryClass.Client)
  assertSourceError("InsufficientCapacity", ErrorKind.InsufficientCapacity, 507, RetryClass.Server)
  assertSourceError("InvalidKey", ErrorKind.InvalidKey, 400, RetryClass.Client)
  assertSourceError("SlowDown", ErrorKind.SlowDown, 503, RetryClass.Throttling)
  println("FSx through S3 access points: 4 of 4 source rows")
}

test "the reference duplicate status and typo keep their documented canonical row" {
  // The base table's second EntityTooLarge row says 405 for a download; #6615 keeps 400.
  assertSourceError("EntityTooLarge", ErrorKind.EntityTooLarge, 400, RetryClass.Client)
  // The base table's "503 SlowDown" cell repeats SlowDown, rather than adding a wire code.
  assertSourceError("SlowDown", ErrorKind.SlowDown, 503, RetryClass.Throttling)
  match (lookupError("503 SlowDown")) {
    None => {}
    Some(_) => panic("source typo is not a wire code")
  }
}

// #6823 includes the two uncertain Outposts codes conservatively, with documented statuses.
test "Outposts: 3 of 3 included source rows map to the exact kind, status and retry class" {
  assertSourceError("InvalidOutpostState", ErrorKind.InvalidOutpostState, 409, RetryClass.Client)
  assertSourceError("UnsupportedOperation", ErrorKind.UnsupportedOperation, 404, RetryClass.Client)
  assertSourceError("InsufficientCapacity", ErrorKind.InsufficientCapacity, 507, RetryClass.Server)
  println("Outposts: 3 of 3 included source rows")
}

