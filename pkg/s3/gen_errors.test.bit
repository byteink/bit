// pkg/s3/gen_errors.test.bit — #6615. The generated error table as the rest of
// the package uses it: a wire code becomes a kind a caller matches on, every
// row is found again by its own code (so the table is sorted and unique), and a
// code the table does not name is carried, not lost.

test "a modeled and an unmodeled code map to their kinds" {
  assert(kindForCode("NoSuchKey") == ErrorKind.NoSuchKey, "NoSuchKey")
  assert(kindForCode("NoSuchBucket") == ErrorKind.NoSuchBucket, "NoSuchBucket")
  assert(kindForCode("SlowDown") == ErrorKind.SlowDown, "SlowDown")
  assert(kindForCode("EntityTooSmall") == ErrorKind.EntityTooSmall, "EntityTooSmall")
  assert(kindForCode("KMS.NotFoundException") == ErrorKind.KMSNotFoundException, "KMS code")
}

test "a code the table does not name is Unknown and keeps the code" {
  match (kindForCode("TotallyNewServerError")) {
    Unknown(c) => assert(c == "TotallyNewServerError", "code ${c}")
    _ => panic("not Unknown")
  }
  match (kindForCode("")) {
    Unknown(c) => assert(c == "", "code ${c}")
    _ => panic("the empty code is not Unknown")
  }
  assert(kindForCode("nosuchkey") != ErrorKind.NoSuchKey, "codes are case sensitive")
}

test "every row is found by its own code, with its kind, status and class" {
  let n = 0
  for row of wireErrors {
    match (lookupError(row.code)) {
      Some(found) => {
        assert(found.code == row.code && found.kind == row.kind, "row ${row.code}")
        assert(found.status == row.status, "status of ${row.code}")
      }
      None => panic("${row.code} is not found by its own code")
    }
    n = n + 1
  }
  assert(n == 145, "wire rows: ${n} of 145")
  println("wire rows found by their own code: ${n} of ${n}")
}

test "the table is sorted by code with no duplicate" {
  let i = 1
  while (i < len(wireErrors)) {
    assert(wireErrors[i - 1].code < wireErrors[i].code, "${wireErrors[i].code} is out of order")
    i = i + 1
  }
}

test "retry classes: throttling and transient are retried, the rest is not" {
  assert(retryClassOf(ErrorKind.SlowDown) == RetryClass.Throttling, "SlowDown")
  assert(retryClassOf(ErrorKind.InternalError) == RetryClass.Transient, "InternalError")
  assert(retryClassOf(ErrorKind.RequestTimeout) == RetryClass.Transient, "RequestTimeout")
  assert(retryClassOf(ErrorKind.NotImplemented) == RetryClass.Server, "NotImplemented")
  assert(retryClassOf(ErrorKind.NoSuchKey) == RetryClass.Client, "NoSuchKey")
  assert(retryClassOf(ErrorKind.Timeout) == RetryClass.Transient, "client Timeout")
  assert(retryClassOf(ErrorKind.Connection) == RetryClass.Transient, "client Connection")
  assert(retryClassOf(ErrorKind.ChecksumMismatch) == RetryClass.Client, "ChecksumMismatch")
  assert(retryClassOf(ErrorKind.InvalidInput("empty key")) == RetryClass.Client, "InvalidInput")
  assert(retryClassOf(ErrorKind.Unknown("X")) == RetryClass.Client, "Unknown")
}

test "documented statuses ride with the rows" {
  match (lookupError("NoSuchKey")) {
    Some(r) => assert(r.status == 404, "NoSuchKey status ${r.status}")
    None => panic("no row")
  }
  match (lookupError("SlowDown")) {
    Some(r) => assert(r.status == 503, "SlowDown status ${r.status}")
    None => panic("no row")
  }
  match (lookupError("NotFound")) {
    Some(r) => assert(r.status == 0, "NotFound has no modeled status, got ${r.status}")
    None => panic("no row")
  }
}
