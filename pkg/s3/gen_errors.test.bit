fn assertBaseReferenceRow(line: string) {
  let parts = split(line, " ")
  assert(len(parts) == 3, "source fixture row: ${line}")
  let code = parts[0]
  match (lookupError(code)) {
    Some(row) => {
      assert("${row.status}" == parts[1], "source status of ${code}")
      let retry = match (row.retry) {
        Client => "Client"
        Server => "Server"
        Throttling => "Throttling"
        Transient => "Transient"
      }
      assert(retry == parts[2], "source retry of ${code}")
      match (row.kind) {
        Unknown(_) => panic("unknown source kind: ${code}")
        _ => assert(kindForCode(code) == row.kind, "source kind of ${code}")
      }
    }
    None => panic("source code ${code} is absent")
  }
}

test "List of error codes: 134 of 134 source rows map to a known kind, status and retry class" {
  let rows = split(baseErrorReferenceRows, "\n")
  assert(len(rows) == 134, "base reference rows: ${len(rows)} of 134")
  for row of rows {
    assertBaseReferenceRow(row)
  }
  println("List of error codes: 134 of 134 source rows")
}
