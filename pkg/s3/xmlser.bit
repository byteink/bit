// pkg/s3/xmlser.bit — what the generated XML request serializers
// (gen_xmlser_*.bit, #6621) write against: std/xml's Writer, one writer per
// scalar, the list, map and attribute shapes, and the hand-off that sets the
// request's body.
//
// Rules every serializer shares, so they are written once, here:
//
//   - Nothing is escaped by hand. Every name, attribute and text goes through
//     the Writer, which refuses what XML cannot carry (a NUL, a bad name) and
//     keeps its first failure: a body is never half written and sent.
//   - An unset member (`None`) writes no element. A set one writes its element
//     even when empty: an empty string is `<Name></Name>`, an empty wrapped
//     list is its wrapper alone, an empty flattened list nothing.
//   - A map is written in key order, so two runs send the same bytes.
//   - A timestamp is `date-time` unless the member or its target says
//     otherwise; a blob is base64; a boolean is `true` or `false`.
//   - The body is the compact document (no declaration, no indentation) with
//     `Content-Type: application/xml`, unless the input set a Content-Type.

import { Attr, Writer } from "std/xml"
import { encodeBase64 } from "std/crypto"
import { Timestamp } from "std/time"
import { sortInPlace } from "std/sort"

// The one writer for a body.
fn xmlWriter(): Writer! {
  return Writer()?
}

// No attributes.
fn xmlNoAttrs(): []Attr {
  return []Attr(0)
}

// The declaration of namespace `uri`: the default namespace for an empty
// `prefix`, `xmlns:prefix` otherwise.
fn xmlNs(prefix: string, uri: string): []Attr {
  if (prefix == "") {
    return [Attr{ name = "xmlns", value = uri }]
  }
  return [Attr{ name = "xmlns:${prefix}", value = uri }]
}

// `attrs` and one more attribute, `name="value"`, in a slice of its own so the
// caller's is never written through.
fn xmlAttrAdd(attrs: []Attr, name: string, value: string): []Attr {
  let out = []Attr(0)
  out = append(out, ...attrs)
  return append(out, Attr{ name = name, value = value })
}

// As `xmlAttrAdd`, nothing added when `v` is unset.
fn xmlAttrOpt(attrs: []Attr, name: string, v: Option<string>): []Attr {
  match (v) {
    Some(s) => return xmlAttrAdd(attrs, name, s)
    None => return attrs
  }
}

// As `xmlAttrAdd` for an enum, by its wire value.
fn xmlAttrPutEnum<T>(attrs: []Attr, name: string, v: T, wire: (T) => string): []Attr {
  return xmlAttrAdd(attrs, name, wire(v))
}

// As `xmlAttrOpt` for an enum.
fn xmlAttrPutEnumOpt<T>(attrs: []Attr, name: string, v: Option<T>, wire: (T) => string): []Attr {
  match (v) {
    Some(e) => return xmlAttrAdd(attrs, name, wire(e))
    None => return attrs
  }
}

// `<name attrs>text</name>`.
fn xmlLeaf(w: Writer, name: string, attrs: []Attr, text: string): ()! {
  w.start(name, attrs)?
  w.text(text)?
  w.end()?
}

fn xmlPutStr(w: Writer, name: string, attrs: []Attr, v: string): ()! {
  xmlLeaf(w, name, attrs, v)?
}

fn xmlPutInt(w: Writer, name: string, attrs: []Attr, v: int): ()! {
  xmlLeaf(w, name, attrs, "${v}")?
}

fn xmlPutBool(w: Writer, name: string, attrs: []Attr, v: bool): ()! {
  if (v) {
    xmlLeaf(w, name, attrs, "true")?
    return
  }
  xmlLeaf(w, name, attrs, "false")?
}

// A blob as base64 text.
fn xmlPutBlob(w: Writer, name: string, attrs: []Attr, v: []byte): ()! {
  xmlLeaf(w, name, attrs, encodeBase64(v))?
}

fn xmlPutDateTime(w: Writer, name: string, attrs: []Attr, v: Timestamp): ()! {
  xmlLeaf(w, name, attrs, dateTimeText(v))?
}

fn xmlPutEpoch(w: Writer, name: string, attrs: []Attr, v: Timestamp): ()! {
  xmlLeaf(w, name, attrs, epochSecondsText(v))?
}

fn xmlPutHttpDate(w: Writer, name: string, attrs: []Attr, v: Timestamp): ()! {
  xmlLeaf(w, name, attrs, httpDateText(v))?
}

// An enum by its wire value (`Unknown(v)` is `v`).
fn xmlPutEnum<T>(w: Writer, name: string, attrs: []Attr, v: T, wire: (T) => string): ()! {
  xmlLeaf(w, name, attrs, wire(v))?
}

// `v` through `put` when it is set.
fn xmlPutSome<T>(
  w: Writer,
  name: string,
  attrs: []Attr,
  v: Option<T>,
  put: (Writer, string, []Attr, T) => ()!,
): ()! {
  match (v) {
    Some(x) => put(w, name, attrs, x)?
    None => {}
  }
}

// As `xmlPutSome` for an enum.
fn xmlPutEnumSome<T>(
  w: Writer,
  name: string,
  attrs: []Attr,
  v: Option<T>,
  wire: (T) => string,
): ()! {
  match (v) {
    Some(x) => xmlPutEnum(w, name, attrs, x, wire)?
    None => {}
  }
}

// An element's name and the attributes it opens with.
class XmlName {
  name: string,
  attrs: []Attr,
}

fn xmlTag(name: string, attrs: []Attr): XmlName {
  return XmlName{ name = name, attrs = attrs }
}

// A wrapped list: `tag` holding one `item` element per value; nothing when the
// list is unset.
fn xmlPutList<T>(
  w: Writer,
  tag: XmlName,
  item: XmlName,
  items: Option<[]T>,
  put: (Writer, string, []Attr, T) => ()!,
): ()! {
  match (items) {
    Some(xs) => {
      w.start(tag.name, tag.attrs)?
      for x of xs {
        put(w, item.name, item.attrs, x)?
      }
      w.end()?
    }
    None => {}
  }
}

// A flattened list: one `name` element per value.
fn xmlPutFlat<T>(
  w: Writer,
  name: string,
  attrs: []Attr,
  items: Option<[]T>,
  put: (Writer, string, []Attr, T) => ()!,
): ()! {
  match (items) {
    Some(xs) => {
      for x of xs {
        put(w, name, attrs, x)?
      }
    }
    None => {}
  }
}

// The elements of a map's entries: the entry itself (a wrapped map's `entry`),
// its key and its value.
class XmlMapNames {
  entry: XmlName,
  key: XmlName,
  value: XmlName,
}

fn xmlMapNames(entry: XmlName, key: XmlName, value: XmlName): XmlMapNames {
  return XmlMapNames{ entry = entry, key = key, value = value }
}

fn xmlSortedKeys<V>(m: map<string, V>): []string {
  let keys = []string(0)
  for (k, _) of m {
    keys = append(keys, k)
  }
  sortInPlace(keys, (a: string, b: string) => a < b)
  return keys
}

// One entry as the element `tag`: `<tag><key>k</key><value>v</value></tag>`.
fn xmlPutEntry<V>(
  w: Writer,
  tag: XmlName,
  names: XmlMapNames,
  kv: (string, V),
  put: (Writer, string, []Attr, V) => ()!,
): ()! {
  let (k, v) = kv
  w.start(tag.name, tag.attrs)?
  xmlLeaf(w, names.key.name, names.key.attrs, k)?
  put(w, names.value.name, names.value.attrs, v)?
  w.end()?
}

// A wrapped map: `tag` holding one `entry` per key, in key order; nothing when
// unset.
fn xmlPutMap<V>(
  w: Writer,
  tag: XmlName,
  names: XmlMapNames,
  m: Option<map<string, V>>,
  put: (Writer, string, []Attr, V) => ()!,
): ()! {
  match (m) {
    Some(entries) => {
      w.start(tag.name, tag.attrs)?
      for k of xmlSortedKeys(entries) {
        xmlPutEntry(w, names.entry, names, (k, entries[k]), put)?
      }
      w.end()?
    }
    None => {}
  }
}

// A flattened map: one `tag` element per key, each holding a key and a value.
fn xmlPutFlatMap<V>(
  w: Writer,
  tag: XmlName,
  names: XmlMapNames,
  m: Option<map<string, V>>,
  put: (Writer, string, []Attr, V) => ()!,
): ()! {
  match (m) {
    Some(entries) => {
      for k of xmlSortedKeys(entries) {
        xmlPutEntry(w, tag, names, (k, entries[k]), put)?
      }
    }
    None => {}
  }
}

// A union member the model does not name cannot be written: there is no element
// for it.
fn xmlUnknownMember(union: string, wire: string): ()! {
  fail newError("${union}: the member ${wire} is not one the model names, it cannot be written")
}

// Finishes `w` and sets it as the body of `req`, with the Content-Type the
// protocol defaults to unless the input set one.
fn xmlSetBody(req: RequestHead, w: Writer): ()! {
  req.body = Body.Bytes(w.finish()?)
  defaultContentType(req, "application/xml")?
}
