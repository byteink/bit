// pkg/s3/endpointfns.bit — the functions an endpoint rule set calls: the Smithy
// rules-engine standard library (smithy.io/2.0/additional-specs/rules-engine/
// standard-library.html) and the AWS library functions (smithy.io/2.0/aws/
// rules-engine/library-functions.html, smithy-aws-endpoints 1.74.0), as typed
// Bit functions. #6623 walks the S3 rule set with them; the generated walker
// reads the fields of `EndpointUrl`, `Arn` and `Partition` directly, and
// `getAttr` serves a rule that names an attribute by path.
//
// Option parameters stay `Option<T>`; "empty optional" results are `None`, so
// `isSet` is the one place a rule asks whether a value exists.

import { percentEncode } from "std/http"
import { mustCompile } from "std/regex"
import { isIpv4Literal, isIpv6Literal } from "std/net"
import { hasPrefix, hasSuffix, indexOf, lastIndexOf, parseInt, split, splitN, toLower } from "std/strings"

// `isSet`: whether an optional value is present. Presence only, never truth.
fn isSet<T>(v: Option<T>): bool {
  return match (v) {
    Some(_) => true
    None => false
  }
}

// `not`.
fn not(v: bool): bool {
  return !v
}

// `stringEquals`.
fn stringEquals(a: string, b: string): bool {
  return a == b
}

// `booleanEquals`.
fn booleanEquals(a: bool, b: bool): bool {
  return a == b
}

// `coalesce`: `first` when it is set, else `fallback`.
fn coalesce<T>(first: Option<T>, fallback: T): T {
  return match (first) {
    Some(v) => v
    None => fallback
  }
}

// The string of `v`, "" when unset. A rule reads a parameter this way only
// after an `isSet` condition on it has held.
fn orEmpty(v: Option<string>): string {
  return coalesce(v, "")
}

// `ite`: `a` when `cond`, else `b`.
fn ite<T>(cond: bool, a: T, b: T): T {
  if (cond) {
    return a
  }
  return b
}

// `getAttr(list, "[i]")`: item `i` of `items`, counted from the end when
// negative; None when out of range.
fn listAt(items: []string, i: int): Option<string> {
  let at = i
  if (at < 0) {
    at = len(items) + at
  }
  if (at < 0 || at >= len(items)) {
    return Option<string>.None
  }
  return Option<string>.Some(items[at])
}

fn isAscii(s: string): bool {
  let i = 0
  while (i < len(s)) {
    if (s[i] >= 0x80) {
      return false
    }
    i = i + 1
  }
  return true
}

// `substring`: bytes `start` (inclusive) to `end` (exclusive), counted from the
// end of `input` when `reverse` is set. None when the string is too short, the
// range is empty or inverted, or the input holds a non-ASCII byte.
fn substring(input: string, start: int, end: int, reverse: bool): Option<string> {
  if (start < 0 || start >= end || end > len(input) || !isAscii(input)) {
    return Option<string>.None
  }
  if (reverse) {
    return Option<string>.Some(input[len(input) - end:len(input) - start])
  }
  return Option<string>.Some(input[start:end])
}

// `uriEncode`: RFC 3986 section 2.1 percent-encoding of every byte outside the
// unreserved set (A-Z a-z 0-9 - _ . ~), uppercase hex. `percentEncode` is that
// exact function (a space is `%20`, never `+`; multi-byte UTF-8 is encoded per
// byte).
fn uriEncode(value: string): string {
  return percentEncode(value)
}

// One RFC 1123 host label: 1 to 63 of letters, digits and hyphen, no leading or
// trailing hyphen.
fn isHostLabel(label: string): bool {
  let n = len(label)
  if (n < 1 || n > 63 || label[0] == '-' || label[n - 1] == '-') {
    return false
  }
  let i = 0
  while (i < n) {
    if (!isAlnum(label[i]) && label[i] != '-') {
      return false
    }
    i = i + 1
  }
  return true
}

// `isValidHostLabel`: one RFC 1123 label, or with `allowSubDomains` a dot
// separated run of them.
fn isValidHostLabel(value: string, allowSubDomains: bool): bool {
  if (!allowSubDomains) {
    return isHostLabel(value)
  }
  for label of split(value, ".") {
    if (!isHostLabel(label)) {
      return false
    }
  }
  return true
}

// The text form of an IP address as a rule sees it: a dotted quad or a bracketed
// literal.
fn isIpText(s: string): bool {
  return isIpv4Literal(s) || (hasPrefix(s, "[") && hasSuffix(s, "]"))
}

fn isBucketLabel(label: string): bool {
  return isHostLabel(label) && len(label) >= 3 && toLower(label) == label && !isIpText(label)
}

// `aws.isVirtualHostableS3Bucket`: a host label of 3 to 63 lowercase characters
// that is not an IP address; with `allowSubDomains` every dot separated label
// must be one.
fn awsIsVirtualHostableS3Bucket(value: string, allowSubDomains: bool): bool {
  if (!allowSubDomains) {
    return isBucketLabel(value)
  }
  for label of split(value, ".") {
    if (!isBucketLabel(label)) {
      return false
    }
  }
  return true
}

// The `Partition` structure of `aws.partition`.
class Partition {
  name: string,
  dnsSuffix: string,
  dualStackDnsSuffix: string,
  supportsFIPS: bool,
  supportsDualStack: bool,
  implicitGlobalRegion: string,
}

fn regionListed(regions: []string, region: string): bool {
  for r of regions {
    if (r == region) {
      return true
    }
  }
  return false
}

// The `Partition` a table row describes.
fn partitionOfRow(row: PartitionRow): Partition {
  return Partition{
    name = row.name,
    dnsSuffix = row.dnsSuffix,
    dualStackDnsSuffix = row.dualStackDnsSuffix,
    supportsFIPS = row.supportsFIPS,
    supportsDualStack = row.supportsDualStack,
    implicitGlobalRegion = row.implicitGlobalRegion,
  }
}

// The zero `Partition`: what a walk's state holds before a condition stores one.
fn emptyPartition(): Partition {
  return Partition{
    name = "",
    dnsSuffix = "",
    dualStackDnsSuffix = "",
    supportsFIPS = false,
    supportsDualStack = false,
    implicitGlobalRegion = "",
  }
}

// `aws.partition`: the partition that lists `region` by name, else the first
// whose pattern matches it, else `aws`, as in every AWS SDK
// (aws-sdk-js-v3 054298b1520f, util-endpoints `partition`), so the rule that
// checks the region name (S3's "region was not a valid DNS name") still runs.
// The table is `partitionRows` (gen_partitions.bit, partitions.json 1.1).
fn awsPartition(region: string): Partition {
  let rows = partitionRows()
  for row of rows {
    if (regionListed(row.regions, region)) {
      return partitionOfRow(row)
    }
  }
  for row of rows {
    if (mustCompile(row.regionRegex).matches(region)) {
      return partitionOfRow(row)
    }
  }
  for row of rows {
    if (row.name == "aws") {
      return partitionOfRow(row)
    }
  }
  panic("partitions.json has no aws partition")
}

// The `ARN` structure of `aws.parseArn`. `resourceId` is the resource part split
// on `:` and `/`.
class Arn {
  partition: string,
  service: string,
  region: string,
  accountId: string,
  resourceId: []string,
}

// The zero `Arn`: what a walk's state holds before a condition stores one.
fn emptyArn(): Arn {
  return Arn{ partition = "", service = "", region = "", accountId = "", resourceId = []string(0) }
}

// `s` split on every `:` and `/`; empty parts are kept.
fn splitResource(s: string): []string {
  let out = []string(0)
  let start = 0
  let i = 0
  while (i < len(s)) {
    if (s[i] == ':' || s[i] == '/') {
      out = append(out, s[start:i])
      start = i + 1
    }
    i = i + 1
  }
  return append(out, s[start:len(s)])
}

// `aws.parseArn`: `arn:partition:service:region:account:resource`, with the
// resource kept whole through any further colons. None unless the string has all
// six parts, starts with `arn`, and has a partition, service and resource.
fn awsParseArn(value: string): Option<Arn> {
  let seg = splitN(value, ":", 6)
  if (len(seg) != 6 || seg[0] != "arn" || seg[1] == "" || seg[2] == "" || seg[5] == "") {
    return Option<Arn>.None
  }
  return Option<Arn>.Some(
    Arn{
      partition = seg[1],
      service = seg[2],
      region = seg[3],
      accountId = seg[4],
      resourceId = splitResource(seg[5]),
    },
  )
}

// The `URL` structure of `parseURL`. `authority` is the host and an explicit
// port, never userinfo; `path` is as written ("/" when empty); `normalizedPath`
// ends in "/".
class EndpointUrl {
  scheme: string,
  authority: string,
  path: string,
  normalizedPath: string,
  isIp: bool,
}

// The zero `EndpointUrl`: what a walk's state holds before a condition stores one.
fn emptyEndpointUrl(): EndpointUrl {
  return EndpointUrl{ scheme = "", authority = "", path = "", normalizedPath = "", isIp = false }
}

// The authority of a URL: its text and whether the host is an IP address.
class urlAuthority {
  text: string,
  isIp: bool,
}

// A byte a URL may not carry unescaped: control, space, DEL, backslash, and
// anything outside ASCII (an internationalised host would need punycode, which a
// rule has no use for).
fn isForbiddenUrlByte(c: byte): bool {
  return c <= 0x20 || c >= 0x7f || c == '\\'
}

fn isCleanUrl(s: string): bool {
  let i = 0
  while (i < len(s)) {
    if (isForbiddenUrlByte(s[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

fn isScheme(s: string): bool {
  if (len(s) == 0 || !isAlnum(s[0]) || (s[0] >= '0' && s[0] <= '9')) {
    return false
  }
  let i = 1
  while (i < len(s)) {
    if (!isAlnum(s[i]) && s[i] != '+' && s[i] != '-' && s[i] != '.') {
      return false
    }
    i = i + 1
  }
  return true
}

// A non-empty run of ASCII digits (`isDigits` in sigv4.bit checks a range).
fn isDecimal(s: string): bool {
  return len(s) > 0 && isDigits(s, 0, len(s))
}

// The `:port` suffix of an authority: "" for no port or an empty one, else the
// port without leading zeros; None when it is not 0 to 65535.
fn portSuffix(tail: string): Option<string> {
  if (tail == "" || tail == ":") {
    return Option<string>.Some("")
  }
  let digits = tail[1:len(tail)]
  if (tail[0] != ':' || !isDecimal(digits) || len(digits) > 5) {
    return Option<string>.None
  }
  let n = parseInt(digits) catch _ {
    return Option<string>.None
  }
  if (n > 65535) {
    return Option<string>.None
  }
  return Option<string>.Some(":${n}")
}

// The characters of a registered name host: what a DNS name can hold.
fn isHostName(host: string): bool {
  if (len(host) == 0) {
    return false
  }
  let i = 0
  while (i < len(host)) {
    let c = host[i]
    if (!isAlnum(c) && c != '.' && c != '-' && c != '_' && c != '~') {
      return false
    }
    i = i + 1
  }
  return true
}

// A host whose last label is all digits is an address; one that is not a strict
// dotted quad ("127.1", "010.0.0.1") is refused, not guessed at.
fn isMalformedAddress(host: string): bool {
  let dot = lastIndexOf(host, ".")
  return isDecimal(host[dot + 1:len(host)]) && !isIpv4Literal(host)
}

fn bracketAuthority(hostPort: string): Option<urlAuthority> {
  let end = indexOf(hostPort, "]")
  if (end < 0 || !isIpv6Literal(hostPort[1:end])) {
    return Option<urlAuthority>.None
  }
  match (portSuffix(hostPort[end + 1:len(hostPort)])) {
    Some(port) => return Option<urlAuthority>.Some(
      urlAuthority{ text = "[${toLower(hostPort[1:end])}]${port}", isIp = true },
    )
    None => return Option<urlAuthority>.None
  }
}

fn nameAuthority(hostPort: string): Option<urlAuthority> {
  let colon = lastIndexOf(hostPort, ":")
  let host = hostPort
  let tail = ""
  if (colon >= 0) {
    host = hostPort[0:colon]
    tail = hostPort[colon:len(hostPort)]
  }
  if (!isHostName(host) || isMalformedAddress(host)) {
    return Option<urlAuthority>.None
  }
  match (portSuffix(tail)) {
    Some(port) => return Option<urlAuthority>.Some(
      urlAuthority{ text = toLower(host) + port, isIp = isIpv4Literal(host) },
    )
    None => return Option<urlAuthority>.None
  }
}

// The authority part of a URL, userinfo dropped, host lowercased.
fn parseAuthority(raw: string): Option<urlAuthority> {
  let hostPort = raw[lastIndexOf(raw, "@") + 1:len(raw)]
  if (hasPrefix(hostPort, "[")) {
    return bracketAuthority(hostPort)
  }
  return nameAuthority(hostPort)
}

// `parseURL`: `scheme://authority[/path]` with no query and no fragment, or None.
// IPv4 and bracketed IPv6 hosts set `isIp`. An explicit port stays in the
// authority whatever it is, the default one included.
fn parseURL(value: string): Option<EndpointUrl> {
  let sep = indexOf(value, "://")
  if (sep < 0 ||
    indexOf(value, "?") >= 0 ||
    indexOf(value, "#") >= 0 ||
    !isCleanUrl(value) ||
    !isScheme(value[0:sep])) {
    return Option<EndpointUrl>.None
  }
  let rest = value[sep + 3:len(value)]
  let slash = indexOf(rest, "/")
  let path = "/"
  let raw = rest
  if (slash >= 0) {
    raw = rest[0:slash]
    path = rest[slash:len(rest)]
  }
  match (parseAuthority(raw)) {
    Some(a) => {
      let normalized = path
      if (!hasSuffix(path, "/")) {
        normalized = path + "/"
      }
      return Option<EndpointUrl>.Some(
        EndpointUrl{
          scheme = toLower(value[0:sep]),
          authority = a.text,
          path = path,
          normalizedPath = normalized,
          isIp = a.isIp,
        },
      )
    }
    None => return Option<EndpointUrl>.None
  }
}

// A value `getAttr` reads into: the shape of a rule's `document`.
enum Doc {
  Text(string),
  Flag(bool),
  Texts([]string),
  Fields(map<string, Doc>),
}

// One step of an attribute path: a key, or an index into a list.
class AttrStep {
  key: string,
  index: int,
  isIndex: bool,
}

// The index step for the text between `[` and `]`, negative counting from the end.
fn indexStep(text: string): Option<AttrStep> {
  let n = parseInt(text) catch _ {
    return Option<AttrStep>.None
  }
  return Option<AttrStep>.Some(AttrStep{ key = "", index = n, isIndex = true })
}

// The steps of one dot-separated part of a path: `key`, `key[2]` or `[2]`.
// None for an empty key or a bracket that does not close the part.
fn partSteps(part: string): Option<[]AttrStep> {
  let steps = []AttrStep(0)
  let open = indexOf(part, "[")
  let key = part
  if (open >= 0) {
    key = part[0:open]
  }
  if (key != "") {
    steps = append(steps, AttrStep{ key = key, index = 0, isIndex = false })
  } else if (open < 0) {
    return Option<[]AttrStep>.None
  }
  if (open < 0) {
    return Option<[]AttrStep>.Some(steps)
  }
  if (!hasSuffix(part, "]")) {
    return Option<[]AttrStep>.None
  }
  match (indexStep(part[open + 1:len(part) - 1])) {
    Some(s) => return Option<[]AttrStep>.Some(append(steps, s))
    None => return Option<[]AttrStep>.None
  }
}

// The steps of a whole path. An index returns an optional, so it may only end
// the path.
fn attrSteps(path: string): Option<[]AttrStep> {
  let steps = []AttrStep(0)
  for part of split(path, ".") {
    if (len(steps) > 0 && steps[len(steps) - 1].isIndex) {
      return Option<[]AttrStep>.None
    }
    match (partSteps(part)) {
      Some(more) => {
        for s of more {
          steps = append(steps, s)
        }
      }
      None => return Option<[]AttrStep>.None
    }
  }
  return Option<[]AttrStep>.Some(steps)
}

fn stepInto(cur: Doc, step: AttrStep): Option<Doc> {
  match (cur) {
    Fields(m) => {
      if (step.isIndex) {
        return Option<Doc>.None
      }
      let (v, ok) = m[step.key]
      if (!ok) {
        return Option<Doc>.None
      }
      return Option<Doc>.Some(v)
    }
    Texts(items) => {
      let at = step.index
      if (at < 0) {
        at = at + len(items)
      }
      if (!step.isIndex || at < 0 || at >= len(items)) {
        return Option<Doc>.None
      }
      return Option<Doc>.Some(Doc.Text(items[at]))
    }
    _ => return Option<Doc>.None
  }
}

// `getAttr`: the value at `path` (`key.key`, `list[2]`, `list[-1]`) of a
// document, None when any step is missing or does not fit the value.
fn getAttr(doc: Doc, path: string): Option<Doc> {
  let steps = []AttrStep(0)
  match (attrSteps(path)) {
    Some(s) => steps = s
    None => return Option<Doc>.None
  }
  let cur = doc
  for step of steps {
    match (stepInto(cur, step)) {
      Some(next) => cur = next
      None => return Option<Doc>.None
    }
  }
  return Option<Doc>.Some(cur)
}

// The document of a parsed URL, for `getAttr`.
fn urlDoc(u: EndpointUrl): Doc {
  let m = map<string, Doc>()
  m["scheme"] = Doc.Text(u.scheme)
  m["authority"] = Doc.Text(u.authority)
  m["path"] = Doc.Text(u.path)
  m["normalizedPath"] = Doc.Text(u.normalizedPath)
  m["isIp"] = Doc.Flag(u.isIp)
  return Doc.Fields(m)
}

// The document of a parsed ARN, for `getAttr`.
fn arnDoc(a: Arn): Doc {
  let m = map<string, Doc>()
  m["partition"] = Doc.Text(a.partition)
  m["service"] = Doc.Text(a.service)
  m["region"] = Doc.Text(a.region)
  m["accountId"] = Doc.Text(a.accountId)
  m["resourceId"] = Doc.Texts(a.resourceId)
  return Doc.Fields(m)
}

// The document of a partition, for `getAttr`.
fn partitionDoc(p: Partition): Doc {
  let m = map<string, Doc>()
  m["name"] = Doc.Text(p.name)
  m["dnsSuffix"] = Doc.Text(p.dnsSuffix)
  m["dualStackDnsSuffix"] = Doc.Text(p.dualStackDnsSuffix)
  m["supportsFIPS"] = Doc.Flag(p.supportsFIPS)
  m["supportsDualStack"] = Doc.Flag(p.supportsDualStack)
  m["implicitGlobalRegion"] = Doc.Text(p.implicitGlobalRegion)
  return Doc.Fields(m)
}
