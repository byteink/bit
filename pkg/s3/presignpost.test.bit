// Exact bytes from the official S3 browser POST example, including CRLF.
// https://docs.aws.amazon.com/AmazonS3/latest/developerguide/sigv4-post-example.html
const postExamplePolicy: string = "{ \"expiration\": \"2015-12-30T12:00:00.000Z\",\r\n  \"conditions\": [\r\n    {\"bucket\": \"sigv4examplebucket\"},\r\n    [\"starts-with\", \"$key\", \"user/user1/\"],\r\n    {\"acl\": \"public-read\"},\r\n    {\"success_action_redirect\": \"http://sigv4examplebucket.s3.amazonaws.com/successful_upload.html\"},\r\n    [\"starts-with\", \"$Content-Type\", \"image/\"],\r\n    {\"x-amz-meta-uuid\": \"14365123651274\"},\r\n    {\"x-amz-server-side-encryption\": \"AES256\"},\r\n    [\"starts-with\", \"$x-amz-meta-tag\", \"\"],\r\n\r\n    {\"x-amz-credential\": \"AKIAIOSFODNN7EXAMPLE/20151229/us-east-1/s3/aws4_request\"},\r\n    {\"x-amz-algorithm\": \"AWS4-HMAC-SHA256\"},\r\n    {\"x-amz-date\": \"20151229T000000Z\" }\r\n  ]\r\n}"
const postExampleBase64: string = ""
fn postField(post: PresignedPost, want: string): string {
  for (name, value) of post.fields {
    if (name == want) {
      return value
    }
  }
  return ""
}

fn postTestOptions(): PostOptions {
  return PostOptions{ signingDate = "20260131T235959Z", sessionToken = "token+/=" }
}

fn postTestPolicy(post: PresignedPost): string! {
  return string(decodeBase64(postField(post, "policy"))?)
}

test "POST policy: official CRLF base64 and signature" {
  let cfg = testConfig("https://s3.amazonaws.com")
  cfg.secretKey = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
  cfg.region = "us-east-1"
  let (encoded, sig) = postEncodePolicy(cfg, "20151229T000000Z", postExamplePolicy) catch e {
    panic(e.message())
  }
  assert(encoded == postExampleBase64, "official CRLF base64 differs")
  assert(
    sig == "8afdbf4008c03f22c2cd3cdb72e4afbb1f6a588f3255ac628749a66d7f09699e",
    "official signature differs",
  )
}

test "POST policy: deterministic URL fields token expiry and escaped conditions" {
  let cfg = testConfig("https://s3.example.test")
  let fields = [("Content-Type", "image/jpeg"), ("x-amz-meta-note", "a\"\\\n\t$é")]
  let conditions = [
    PostCondition.Exact("acl", "private"),
    PostCondition.StartsWith("key", "articles/"),
    PostCondition.ContentLengthRange(1, 1024),
  ]
  let opts = postTestOptions()
  opts.fields = fields
  opts.conditions = conditions
  let post = presignPost(cfg, "articles/42.jpg", 2, opts) catch e {
    panic(e.message())
  }
  let policy = postTestPolicy(post) catch e {
    panic(e.message())
  }
  assert(post.url == "https://s3.example.test/photos", post.url)
  assert(postField(post, "key") == "articles/42.jpg", "key")
  assert(postField(post, "x-amz-security-token") == "token+/=", "token field")
  assert(contains(policy, "2026-02-01T00:00:01Z"), policy)
  assert(contains(policy, postExact("x-amz-security-token", "token+/=")), policy)
  assert(contains(policy, "[\"content-length-range\",1,1024]"), policy)
  assert(contains(policy, "a\\\"\\\\\\n\\t$é"), policy)
  let again = presignPost(cfg, "articles/42.jpg", 2, opts) catch e {
    panic(e.message())
  }
  assert(
    postField(post, "x-amz-signature") == postField(again, "x-amz-signature"),
    "nondeterministic",
  )
}

fn postFailure(
  expiry: int,
  fields: [](string, string),
  conditions: []PostCondition,
  opts: PostOptions,
): string {
  opts.fields = fields
  opts.conditions = conditions
  presignPost(testConfig("http://localhost:8333"), "cover.jpg", expiry, opts) catch e {
    return e.message()
  }
  return ""
}

test "POST policy: invalid expiry date ranges reserved fields duplicates and caps fail" {
  let empty = [](string, string)(0)
  let none = []PostCondition(0)
  for expiry of [0, -1, 604801] {
    assert(postFailure(expiry, empty, none, postTestOptions()) != "", "expiry accepted")
  }
  for date of ["bad", "20260230T000000Z", "20260101X000000Z", "22620411T234716Z"] {
    assert(postFailure(1, empty, none, PostOptions{ signingDate = date }) != "", "date accepted")
  }
  for name of ["KEY", "policy", "X-Amz-Signature", "file", "x-amz-security-token"] {
    assert(postFailure(1, [(name, "bad")], none, postTestOptions()) != "", "reserved accepted")
  }
  assert(postFailure(1, [("acl", "a"), ("ACL", "b")], none, postTestOptions()) != "", "duplicate")
  for c of [
    PostCondition.ContentLengthRange(-1, 1),
    PostCondition.ContentLengthRange(2, 1),
    PostCondition.Exact("x-amz-date", "bad"),
  ] {
    assert(postFailure(1, empty, [c], postTestOptions()) != "", "condition accepted")
  }
  assert(postFailure(1, [("acl", repeat("x", 4097))], none, postTestOptions()) != "", "value cap")
  let many = []PostCondition(0)
  for (let i = 0; i < 129; i = i + 1) {
    many = append(many, PostCondition.ContentLengthRange(0, 1))
  }
  assert(postFailure(1, empty, many, postTestOptions()) != "", "count cap")
  let big = [
    ("a", repeat("x", 4096)),
    ("b", repeat("x", 4096)),
    ("c", repeat("x", 4096)),
    ("d", repeat("x", 4096)),
  ]
  assert(postFailure(1, big, none, postTestOptions()) != "", "policy cap")
}

test "POST policy: expiry endpoints and invalid UTF-8" {
  let cfg = testConfig("https://s3.example.test")
  for expiry of [1, 604800] {
    presignPost(cfg, "cover.jpg", expiry, PostOptions{ signingDate = "20260101T000000Z" }) catch e {
      panic(e.message())
    }
  }
  let invalid = string([byte(255)])
  assert(
    postFailure(1, [("x-amz-meta-note", invalid)], []PostCondition(0), postTestOptions()) != "",
    "invalid UTF-8 accepted",
  )
}

test "POST policy: filename expansion uses prefix and absent token is omitted" {
  let post = presignPost(
    testConfig("http://localhost:8333"),
    "articles/" + "$" + "{filename}",
    1,
    PostOptions{ signingDate = "20260101T000000Z" },
  ) catch e {
    panic(e.message())
  }
  let policy = postTestPolicy(post) catch e {
    panic(e.message())
  }
  assert(contains(policy, "[\"starts-with\",\"$key\",\"articles/\"]"), policy)
  assert(!contains(policy, "x-amz-security-token"), policy)
}
