// pkg/web/realtimeh2.test.bit — #6153: a WebSocket over HTTP/2 (RFC 8441
// extended CONNECT), end to end through `App.serveTls()` with ALPN "h2".
//
// The route under test is `tlsMixedApp()`'s `/ws/echo` (realtimetls.test.bit),
// the very route that test drives over an HTTP/1.1 Upgrade: it is not changed
// for h2, which is the claim — one `wsUpgrade(c, limits)` serves both. The
// client is Bit's own (`std/http2` `connect` + `std/websocket`'s `dialH2`), an
// independent implementation of RFC 8441 §4-5 from the server's: it only opens
// the tunnel if the server advertised SETTINGS_ENABLE_CONNECT_PROTOCOL, and it
// speaks RFC 6455 framing, masked, over the stream's DATA frames.
//
// `tlsMixedApp`/`tlsRawDial`/`clientCfg`/`wsDefaultLimits` are module siblings
// (realtimetls.test.bit, servetls.test.bit, ctx.test.bit, SPEC §17.2).
import {
  connect as h2Connect, defaultConfig as h2Config, Transport as H2Transport, Request as H2Request,
  HeaderField as H2HeaderField,
} from "std/http2"
import { dialH2 as wsDialH2, MessageText } from "std/websocket"

// The http2 engine's byte transport over a raw `TlsConn`; the engine's reads are
// not fallible, so a TLS read failure is end-of-stream.
fn h2TransportOf(conn: TlsConn): H2Transport {
  return H2Transport(
    (n) => {
      let b = conn.read(n) catch _ {
        return []byte(0)
      }
      return b
    },
    (b) => {
      h2WriteConn(conn, b)
    },
    () => {
      conn.close()
    },
  )
}

// Best-effort write for the transport shim: an arrow closure cannot be fallible,
// and a failed write is seen by the engine's reader as the closed connection.
fn h2WriteConn(conn: TlsConn, b: []byte) {
  conn.write(b) catch _ {
    return
  }
}

test "a WebSocket route written for HTTP/1.1 echoes over HTTP/2 extended CONNECT" {
  let app = tlsMixedApp()
  let ts = app.serveTls() catch e {
    assert(false, "serveTls: ${e.message()}")
    return
  }
  let port = ts.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let tc = tlsRawDial("127.0.0.1", port, clientCfg(["h2"])) catch e {
    ts.shutdown(2000) catch _ {}
    assert(false, "tlsRawDial: ${e.message()}")
    return
  }
  assert(tc.alpnProtocol() == "h2", "negotiated '${tc.alpnProtocol()}', want h2")
  let hc = h2Connect(h2TransportOf(tc), h2Config(), 0) catch e {
    tc.close()
    ts.shutdown(2000) catch _ {}
    assert(false, "h2 connect: ${e.message()}")
    return
  }
  let ws = wsDialH2(hc, "localhost:${port}", "/ws/echo", "", wsDefaultLimits()) catch e {
    hc.close()
    tc.close()
    ts.shutdown(2000) catch _ {}
    assert(false, "dialH2: ${e.message()}")
    return
  }
  ws.sendText("hello over h2") catch e {
    assert(false, "sendText: ${e.message()}")
    return
  }
  let msg = ws.receive() catch e {
    assert(false, "receive: ${e.message()}")
    return
  }
  assert(msg.kind == MessageText, "kind = ${msg.kind}, want text")
  assert(msg.data == "hello over h2", "echo = '${msg.data}', want 'hello over h2'")
  // The route returns after one echo, ending the tunnel: the next read sees the
  // orderly END_STREAM (RFC 8441 §5) as a closed connection, not a hang.
  ws.receive() catch _ {
    hc.close()
    tc.close()
    ts.shutdown(2000) catch _ {}
    return
  }
  assert(false, "a second receive succeeded after the route returned")
}

test "an ordinary request on the same h2 connection is still served" {
  let app = tlsMixedApp()
  let ts = app.serveTls() catch e {
    assert(false, "serveTls: ${e.message()}")
    return
  }
  let port = ts.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let tc = tlsRawDial("127.0.0.1", port, clientCfg(["h2"])) catch e {
    ts.shutdown(2000) catch _ {}
    assert(false, "tlsRawDial: ${e.message()}")
    return
  }
  let hc = h2Connect(h2TransportOf(tc), h2Config(), 0) catch e {
    tc.close()
    ts.shutdown(2000) catch _ {}
    assert(false, "h2 connect: ${e.message()}")
    return
  }
  let res = hc.roundTrip(H2Request("GET", "localhost:${port}", "/plain")) catch e {
    hc.close()
    tc.close()
    ts.shutdown(2000) catch _ {}
    assert(false, "roundTrip: ${e.message()}")
    return
  }
  assert(res.status == 200, "status = ${res.status}")
  assert(string(res.body) == "ok", "body = '${string(res.body)}'")
  hc.close()
  tc.close()
  ts.shutdown(2000) catch _ {}
}

test "a WebSocket request with the wrong Sec-WebSocket-Version is refused, not tunnelled" {
  let app = tlsMixedApp()
  let ts = app.serveTls() catch e {
    assert(false, "serveTls: ${e.message()}")
    return
  }
  let port = ts.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let tc = tlsRawDial("127.0.0.1", port, clientCfg(["h2"])) catch e {
    ts.shutdown(2000) catch _ {}
    assert(false, "tlsRawDial: ${e.message()}")
    return
  }
  let hc = h2Connect(h2TransportOf(tc), h2Config(), 0) catch e {
    tc.close()
    ts.shutdown(2000) catch _ {}
    assert(false, "h2 connect: ${e.message()}")
    return
  }
  let req = H2Request("CONNECT", "localhost:${port}", "/ws/echo")
  req.protocol = "websocket"
  req.headers = append(
    req.headers,
    H2HeaderField{ name = "sec-websocket-version", value = "8", sensitive = false },
  )
  // The route answers 400 for a failed `wsUpgrade`; the engine refuses the tunnel.
  hc.openTunnel(req) catch e {
    assert(
      e.message() == "http2: extended CONNECT refused with status 400",
      "refusal = '${e.message()}'",
    )
    hc.close()
    tc.close()
    ts.shutdown(2000) catch _ {}
    return
  }
  assert(false, "a version-8 WebSocket request was tunnelled")
}
