// pkg/web/node.bit — the view primitive (#3887): a `Node` tree, a small set
// of element constructors, and `render`, which flattens a tree into HTML.
//
// There is no template engine (#3888 closed wontfix, epic #3875's "Views"
// section) — a component is a plain Bit function returning `Node`, and JSX
// (epic #3942) desugars into exactly the constructors below, so this file is
// the contract JSX will target, not a placeholder for it. Until JSX lands,
// `el(tag, ...kids)` is the way to build an element with a dynamic or
// uncommon tag name; `div`/`a` are the two named conveniences this ticket
// asks for on top of it.
//
// ATTRIBUTES AND CHILDREN SHARE ONE LIST. `Elem(tag, kids)` does not split
// its `kids` at construction time — `Attr` is just another `Node` variant
// that can appear anywhere in the list, interleaved with the real children
// exactly as the caller wrote them (`div(Attr("class", "x"), text("hi"),
// Attr("id", "y"))` reads in source order). `render` is what sorts them out:
// every `Attr` becomes part of the opening tag, in the order it appears
// among the OTHER attrs; every other node becomes part of the body, in the
// order it appears among the OTHER children. Two independent orderings
// preserved from one flat list, not a second list a constructor would have
// to build.
//
// ESCAPING IS NOT THIS FILE'S JOB, with one exception. `Text` and `Raw`
// nodes already carry their final string — `text()`/`raw()` (escape.bit)
// decide what goes in them, and `render` only ever appends what it is
// given. The one place `render` escapes anything itself is an `Attr`'s
// VALUE, because `Attr(key, value)` is the only Node variant with no
// escaping step of its own in the public API (there is no `attr()`
// wrapper) — leaving it unescaped would make a quote in an ordinary
// attribute value a byte-for-byte HTML injection with no `raw()` in sight.
// Escaping it unconditionally, every time, is the safe default (epic
// #3875's rule 1); a caller who also ran the value through `url()` gets
// that check IN ADDITION, not instead of this one.
//
// RENDERS INTO ONE BUFFER, PER THE TICKET'S OWN ACCEPTANCE. `render`
// allocates exactly one `Builder` and threads it through the whole
// recursion; nothing here builds a fragment with `+` and nothing slices a
// span out of an already-materialized string only to copy it again. Two
// open epics (#2945, #3115) are about exactly this cost, and a component
// tree is precisely the shape that turns a concatenating renderer into
// hundreds of allocations for one page.

import { Builder, newBuilder } from "std/strings"

// A view fragment. `Elem(tag, kids)` is an element and its (attributes +
// children) list; `Attr(key, value)` is one attribute, legal only inside an
// `Elem`'s `kids`; `Text(s)` is already-escaped element text (built by
// `text()`, escape.bit); `Raw(s)` is unescaped markup, passed through
// byte-for-byte by `render` — the one deliberate escape hatch (`raw()`,
// escape.bit).
export enum Node {
  Elem(string, []Node),
  Attr(string, string),
  Text(string),
  Raw(string),
}

// A element with an explicit tag name — the escape hatch for anything not
// named below, and what JSX (epic #3942) is expected to desugar into.
export fn el(tag: string, ...kids: Node): Node {
  return Node.Elem(tag, kids)
}

export fn div(...kids: Node): Node {
  return el("div", ...kids)
}

export fn a(...kids: Node): Node {
  return el("a", ...kids)
}

// `n` as an HTML string, built by appending into exactly one growable
// buffer (see the file header) rather than by concatenation.
export fn render(n: Node): string {
  let b = newBuilder()
  appendNode(b, n)
  return b.toString()
}

// Appends one node's own markup. An `Attr` reached here (i.e. not inside
// some `Elem`'s `kids`, where `appendChildren` already strips it) renders
// as nothing — there is no attribute-shaped output outside a tag.
fn appendNode(b: Builder, n: Node) {
  match (n) {
    Elem(tag, kids) => appendElem(b, tag, kids)
    Text(s) => b.write(s)
    Raw(s) => b.write(s)
    Attr(_, _) => {}
  }
}

fn appendElem(b: Builder, tag: string, kids: []Node) {
  b.write("<").write(tag)
  appendAttrs(b, kids)
  b.write(">")
  appendChildren(b, kids)
  b.write("</").write(tag).write(">")
}

// Every `Attr` in `kids`, in the order it appears among the other `Attr`s,
// as ` key="value"` — `value` is HTML-attribute-escaped unconditionally
// (see the file header for why `render`, not the caller, owns this one).
fn appendAttrs(b: Builder, kids: []Node) {
  for k of kids {
    match (k) {
      Attr(key, value) => {
        b.write(" ").write(key).write("=\"")
        appendHtmlEscaped(b, value)
        b.write("\"")
      }
      Elem(_, _) => {}
      Text(_) => {}
      Raw(_) => {}
    }
  }
}

// Every non-`Attr` node in `kids`, in the order it appears among the other
// children.
fn appendChildren(b: Builder, kids: []Node) {
  for k of kids {
    match (k) {
      Attr(_, _) => {}
      _ => appendNode(b, k)
    }
  }
}
