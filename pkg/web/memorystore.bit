// pkg/web/memorystore.bit — the in-process `SessionStore` (#3947).
//
// It ships, and it is never the default. `App(Config{ secret = s })` has no
// session store at all; an app gets this one only by writing
// `Config{ secret = s, sessions = MemoryStore(10_000) }`, which is the whole
// design: the store that cannot survive a second process is a deliberate
// line in the app's own source, not something the framework arranged
// silently.
//
// What it is honestly for: development, tests, and a single-process service
// that is content to log everyone out on restart. What it is not: anything
// with two processes in front of a load balancer.
//
// It is BOUNDED (#4541). `maxEntries` has no default and is the hard ceiling
// on how many sessions this store holds: a write that would cross it evicts
// the oldest-expiring entry first, so the map never holds more than the cap
// and a write never fails because the store is full. Expired entries are
// also swept every `memoryStoreSweepEvery` writes, so an id nobody ever
// presents again does not hold its bytes until the process exits.
//
// The bound matters because `Ctx.csrfToken()` (ctx.bit) writes a session for
// an ANONYMOUS visitor — a public form page therefore mints one store entry
// per visitor, with no authentication anywhere in front of it. Unbounded,
// that is a memory-growth vector reachable by anyone who can request the
// page. Eviction is not a substitute for a rate limit: at the cap, a flood
// evicts real sessions, so a form page still wants `rateLimit()` in front of
// it (README, "Sessions, CSRF and anonymous visitors"). What the cap buys is
// that the failure is bounded memory and lost sessions rather than the
// process growing until it is killed.
//
// A store that must do better than "evict the oldest-expiring" — LRU, or
// spilling to disk — is a `SqlStore` or a `RedisStore`, which is exactly why
// `SessionStore` is an interface.

import { Mutex, newMutex } from "std/sync"
import { now } from "std/time"

const nsPerSecond: i64 = 1_000_000_000

// How many writes pass between sweeps of expired entries. A sweep is O(n)
// over the map, so doing one on every write would make a write O(n); doing
// it every Nth amortises that to O(n/N) per write while bounding how long a
// dead entry can outlive its ttl to N writes. 64 rather than a round 100
// only because it is what the tests count to.
const memoryStoreSweepEvery: int = 64

const memoryStoreCapMessage = "web: MemoryStore(maxEntries): the cap must be " +
  "at least 1, for example `MemoryStore(10_000)`. It is the largest number " +
  "of sessions this store will hold; a write past it evicts the " +
  "oldest-expiring entry rather than failing."

// One stored session. `expiresAtNs` is absolute (nanoseconds since the
// epoch, `now().ns`) rather than a ttl plus a write time, so expiry is one
// comparison and no arithmetic can drift between the two fields.
//
// `version` (#5794) is the compare-and-set counter: it starts at 1 on the
// entry's first write and increments on every later `compareAndSet` or
// `destroy`. `tombstone` marks an entry `destroy()` left behind rather than
// one holding live session data — `load` reports it as a miss like any
// expired entry, but `compareAndSet` refuses it unconditionally, which is
// what stops a stale writer from resurrecting a destroyed session. A
// tombstone is bounded the same way a live entry is: it carries its own
// `expiresAtNs` and is swept and evicted exactly like one.
class MemoryEntry {
  data: map<string, string>,
  expiresAtNs: i64,
  version: i64,
  tombstone: bool,
}

export class MemoryStore {
  entries: map<string, MemoryEntry>
  // The ceiling on `len(entries)`, from the constructor. No default: how
  // much memory a process may spend on sessions is a fact about a
  // deployment, and a framework that guesses it silently is how a store
  // grows until the box does something worse than evict.
  maxEntries: int
  // Writes since the last sweep of expired entries. Reset by the sweep.
  writesSinceSweep: int
  // A store is shared by every request, and requests are concurrent. The
  // map is not safe for concurrent use, so every method takes the lock —
  // including `load`, which mutates on the expiry path.
  mu: Mutex

  init(maxEntries: int) {
    // A panic rather than a fallible `init`, for `App.init`'s reason
    // (app.bit): a store built with a cap of 0 or a negative one is a
    // programming error at startup, not a runtime condition the caller
    // could answer — and a cap below 1 would mean every write evicts the
    // entry it just wrote, i.e. a store that silently holds nothing.
    if (maxEntries < 1) {
      panic(memoryStoreCapMessage)
    }
    this.entries = map<string, MemoryEntry>()
    this.maxEntries = maxEntries
    this.writesSinceSweep = 0
    this.mu = newMutex()
  }

  // `Option.None` is a miss; `Option.Some((data, version))` is a hit,
  // whether or not `data` has any keys (#4483). Emptiness is a property of
  // the session, not an encoding of absence. A tombstoned id is a miss too —
  // `load` never distinguishes "never written" from "destroyed"; only
  // `compareAndSet` needs to, and only it sees the tombstone.
  export load(sid: string): Option<(map<string, string>, i64)>! {
    return this.loadAt(sid, now().ns)
  }

  // Writes `data` only when `expectedVersion` still matches this id's
  // current version and the id is not tombstoned; returns the new version.
  // Fails with a conflict, naming what changed, otherwise — the caller
  // decides whether to reload and retry, this store never overwrites a
  // version it was not handed (#5794).
  export compareAndSet(
    sid: string,
    expectedVersion: i64,
    data: map<string, string>,
    ttl: i64,
  ): i64! {
    return this.compareAndSetAt(sid, expectedVersion, data, ttl, now().ns)?
  }

  // Unconditional: tombstones `sid` so no `compareAndSet` holding an older
  // version can resurrect it, bounded by `tombstoneTtl` the same way a live
  // entry is bounded by its own ttl (#5794).
  export destroy(sid: string, tombstoneTtl: i64): ()! {
    this.destroyAt(sid, tombstoneTtl, now().ns)
  }

  // `compareAndSet` against a caller-supplied clock, module-private for
  // `readAt`'s original reason: it is what lets a test drive the sweep and
  // the eviction order deterministically instead of racing the wall clock.
  //
  // Order is load-bearing. The sweep runs BEFORE the cap is tested, so a
  // store full of expired entries makes room from the dead rather than
  // evicting a live session; the version check runs before the cap is
  // touched at all, so a losing writer never pays for a slot it will not
  // get.
  compareAndSetAt(
    sid: string,
    expectedVersion: i64,
    data: map<string, string>,
    ttl: i64,
    nowNs: i64,
  ): i64! {
    this.mu.lock()
    defer this.mu.unlock()
    this.writesSinceSweep = this.writesSinceSweep + 1
    if (this.writesSinceSweep >= memoryStoreSweepEvery) {
      this.writesSinceSweep = 0
      this.sweepExpired(nowNs)
    }
    let (e, present) = this.entries[sid]
    if (present && e.tombstone) {
      fail conflictError(sid, expectedVersion, "the id was destroyed")
    }
    let liveVersion: i64 = 0
    if (present && e.expiresAtNs > nowNs) {
      liveVersion = e.version
    }
    if (liveVersion != expectedVersion) {
      fail conflictError(sid, expectedVersion, "the store has version ${liveVersion}")
    }
    if (!present && len(this.entries) >= this.maxEntries) {
      this.evictOldestExpiring()
    }
    let newVersion = expectedVersion + 1
    // The caller's map is copied, not aliased. A store is a persistence
    // boundary: a real one serialises here, so an in-memory one that kept
    // handing back the very map a previous request is still mutating would
    // make `MemoryStore` behave differently from every other implementation
    // of the interface — the one thing a dev store must not do.
    this.entries[sid] = MemoryEntry{
      data = copyData(data),
      expiresAtNs = nowNs + ttl * nsPerSecond,
      version = newVersion,
      tombstone = false,
    }
    return newVersion
  }

  // `destroy` against a caller-supplied clock, `compareAndSetAt`'s reason.
  // Shares its cap-eviction rule — a tombstone for an id this store has
  // never seen still takes a slot — so tombstones are bounded by the exact
  // same mechanism live entries are, nothing new to keep in sync.
  destroyAt(sid: string, tombstoneTtl: i64, nowNs: i64) {
    this.mu.lock()
    defer this.mu.unlock()
    let (e, present) = this.entries[sid]
    let currentVersion: i64 = 0
    if (present) {
      currentVersion = e.version
    }
    if (!present && len(this.entries) >= this.maxEntries) {
      this.evictOldestExpiring()
    }
    this.entries[sid] = MemoryEntry{
      data = map<string, string>(),
      expiresAtNs = nowNs + tombstoneTtl * nsPerSecond,
      version = currentVersion + 1,
      tombstone = true,
    }
  }

  // Drops every entry whose ttl has passed at `nowNs`. Ids are collected
  // first and deleted after: mutating a map while iterating it is not a
  // thing to rely on.
  //
  // The LOCK IS ALREADY HELD by `compareAndSetAt`, the only caller. `Mutex`
  // is not reentrant, so this must not take it.
  sweepExpired(nowNs: i64) {
    let dead = []string(0)
    for (sid, e) of this.entries {
      if (e.expiresAtNs <= nowNs) {
        dead = append(dead, sid)
      }
    }
    for sid of dead {
      delete(this.entries, sid)
    }
  }

  // Drops the entry that expires soonest — already-expired entries first,
  // since an expired one has the smallest `expiresAtNs` of all. That is why
  // the eviction rule is "oldest-expiring" and not "oldest-written": it
  // spends the entry with the least life left, and reaches a live session
  // only when there is no dead one to take.
  //
  // O(n) per eviction, which is the honest cost of not keeping a second
  // index. A store where that matters is a `RedisStore`.
  //
  // The LOCK IS ALREADY HELD by `compareAndSetAt` or `destroyAt`, its only
  // callers.
  evictOldestExpiring() {
    let victim = ""
    let victimNs: i64 = 0
    let found = false
    for (sid, e) of this.entries {
      if (!found || e.expiresAtNs < victimNs) {
        victim = sid
        victimNs = e.expiresAtNs
        found = true
      }
    }
    if (found) {
      delete(this.entries, victim)
    }
  }

  // `load` against a caller-supplied clock. Module-private: it exists so a
  // test can prove a POSITIVE ttl really expires, deterministically, without
  // sleeping — the only alternatives being a flaky timed test or a ttl the
  // store was never asked to hold.
  //
  // An entry found expired is deleted here rather than merely reported
  // absent: the id has just been proven dead, and this is the one moment the
  // store is certain of it. An expired entry is a MISS, not a present-but-
  // empty session — its id is dead and must not be adopted. A live tombstone
  // is ALSO a miss, but is deliberately NOT deleted here (#5794): the next
  // request presenting a just-destroyed cookie calls exactly this path, and
  // deleting the tombstone on that read would remove the very guard that
  // stops a still-in-flight stale `compareAndSet` from resurrecting it.
  //
  // Not fallible: an in-memory map cannot fail. `load` is, only because the
  // interface says so for the stores that do I/O.
  loadAt(sid: string, nowNs: i64): Option<(map<string, string>, i64)> {
    this.mu.lock()
    defer this.mu.unlock()
    let (e, ok) = this.entries[sid]
    if (!ok) {
      return Option.None
    }
    // `<=`, not `<`: a ttl of 0 means the entry is already expired at the
    // instant it was written. That is the same rule a positive ttl obeys,
    // one second later, rather than a special case meaning "never expires".
    if (e.expiresAtNs <= nowNs) {
      delete(this.entries, sid)
      return Option.None
    }
    if (e.tombstone) {
      return Option.None
    }
    return Option.Some((copyData(e.data), e.version))
  }
}

// An independent copy of `m`. Maps are reference types (SPEC §13.3), so
// without this both `compareAndSet` and `load` would hand out an alias into
// the store's own state.
fn copyData(m: map<string, string>): map<string, string> {
  let out = map<string, string>()
  for (k, v) of m {
    out[k] = v
  }
  return out
}

// A `compareAndSet` refusal: `sid`'s current state no longer matches
// `expectedVersion` — either another writer's version already moved past it
// (`detail` names the version actually found) or the id was tombstoned by
// `destroy`. The caller reloads and retries, or gives up; this store never
// picks a winner on its own (#5794).
fn conflictError(sid: string, expectedVersion: i64, detail: string): error {
  return newError(
      "web: session: compareAndSet(${sid}): conflict, expected version " +
      "${expectedVersion}, ${detail}",
  )
}
