// pkg/web/body.bit — reading the request body into a type the route declared
// (#3877). The decoding itself is std/json's `jsonDecode<T>` (#3977); what
// this file owns is the three refusals around it (413, 415, 400), the
// unknown-field policy, and turning every decode failure into a client error
// that NAMES the field rather than a single useless "invalid body".
//
// --- THE TRAP THIS CLOSES: MASS ASSIGNMENT ---------------------------------
//
// Binding client JSON straight into the type that reaches the database is how
// a client makes itself an admin. Given `class User { name, email, isAdmin }`,
// a payload of `{"name":"Ali","isAdmin":true}` sets `isAdmin`, and no line of
// the handler looks wrong. Laravel invented `$fillable` and Rails invented
// strong parameters for exactly this.
//
// Rejecting unknown fields is the SECOND layer and it is not the real
// protection. The real protection is a separate input type — `NewUser { name,
// email }`, with no `id` and no `isAdmin` — mapped across explicitly, so a
// field the payload must never reach does not EXIST on the bound type. Under
// either policy a client then cannot reach it. README.md leads with that
// pattern, and it leads on purpose: a reader who learns only `Reject` will put
// the database entity in the type parameter and believe it is safe.
//
// --- THE TYPE ARGUMENT IS WRITTEN OUT, AT EVERY HOP -------------------------
//
//     let input = c.body<NewUser>()?
//
// The type is named once, by the route, and this file calls `jsonDecode<T>`
// itself. That the wrapper resolves at all is per-instantiation work in the
// compiler: `jsonDecode<T>`'s specialisation is chosen from the type argument
// as SPELLED, and it is carried backwards along `Ctx.body<T>` ->
// `bindJson<T>` -> `decodeUnder<T>` -> `jsonDecode<T>` one hop at a time.
//
// So every call in that chain spells its type argument out — `bindJson<T>(j,
// u)`, not `bindJson(j, u)`. `T` appears only in the RESULT of each of them,
// and a type argument nothing spells binds to nothing:
//
//     error[E0145]: 'jsonDecode' cannot decode into an unbound type
//     parameter: this call binds it to nothing
//
// That is not ceremony to be tidied away later. Dropping one `<T>` here is a
// compile error, not a silent change, but the message names the call it landed
// on rather than the hop that omitted it.
//
// --- WHAT IS NOT BOUNDED HERE ----------------------------------------------
//
// `Config.maxBody` is a cap on what this framework will PARSE, and the read
// itself is bounded separately: `readMessage` (stdlib/http/message.bit)
// refuses a `Content-Length` — or a running total of chunk sizes — over its
// own budget BEFORE the bytes are read, 32 MiB by default and settable with
// `Server.setMaxBodyBytes` (#4565, which closed the gap this comment used to
// describe). The two are independent. A 413 from here still means "I will not
// decode this"; a body above the SERVER's budget never reaches this code at
// all, and is answered 400 by std/http. Set the server budget as well as
// `maxBody` if you want the refusal to happen before the allocation.
//
// --- IMPORT ALIASES --------------------------------------------------------
//
// `pkg/web` is ONE module, so a name imported in any file is bound in every
// file and importing it twice is E0042. `JsonEntry`, `jsonAsObject`,
// `jsonAsArray` and `jsonParse` are already imported by `res.test.bit` and
// `errors.test.bit` — TEST files, which are absent from a non-test build of
// this package, so this file cannot rely on those bindings and cannot repeat
// them either. Renaming on import (SPEC §17.2) binds them here independently,
// the same way `errors.bit` binds `JsonEntry as JsonPair`.
//
// `jsonDecode` needs no alias, and that is the same rule seen from the other
// side: it is bound HERE, once, for the whole module, so no test file may
// import it again.

import {
  JsonDecodeError,
  jsonDecode,
  jsonDecodeLenient,
  jsonParse as parseBodyJson,
} from "std/json"

// The two statuses this file adds to the table in res.bit. 413 is the body
// over `Config.maxBody`; 415 is a body this route will not try to parse.
const statusPayloadTooLarge = 413
const statusUnsupportedMediaType = 415

// The RFC 6839 §3.5 structured-syntax suffix: `application/vnd.api+json` and
// every other `+json` type is JSON.
const jsonTypeSuffix = "+json"

// How much of a client-controlled string a diagnostic repeats back. The value
// goes out through `errorJson` (errors.bit), which builds the body through
// `Json` and never by pasting, so this is a size bound and not an escaping
// one: a `Content-Type` header can be kilobytes and the 415 that names it
// should not be.
const maxEchoBytes = 64

// What to do with a key in the body that no field of the bound type claims.
//
// `Reject` is a 400 NAMING THE FIELD, never a silent drop: a dropped field
// means the client believes it set something it did not, and the two outcomes
// are indistinguishable to whoever sent it.
export enum Unknown {
  Reject,
  Ignore,
}

// The per-call override of the app-level default (`Config.rejectUnknownFields`,
// config.bit):
//
//     let loose = c.bodyWith<Legacy>(Bind{ unknown: Unknown.Ignore })?
//
// `Reject` is declared FIRST so that the zero value of this field is the safe
// one and `Bind{}` rejects. That ordering is load-bearing rather than
// cosmetic: an enum variant is not a compile-time constant expression (E0064),
// so this field cannot carry `= Unknown.Reject` as a default the way
// `Config.rejectUnknownFields` carries `= true`, and the variant order is the
// only thing left that decides what an omitted field means.
export class Bind {
  export unknown: Unknown,
}

// --- the three refusals -----------------------------------------------------

// The raw request body, refused above `Config.maxBody`.
//
// This is the only place the body is read, so nothing in this package can get
// at it without passing the cap — see the file header for what the cap does
// and does not bound.
fn requestBody(c: Ctx): string! {
  let n = i64(len(c.req.body))
  if (n > c.config.maxBody) {
    fail httpError(
      statusPayloadTooLarge,
      "web: request body is ${n} byte(s), over the ${c.config.maxBody}-byte cap",
    )
  }
  return c.req.body
}

// The body as a `Json` tree: over the cap is a 413, a `Content-Type` that is
// not JSON is a 415, and a body that does not parse is a 400 carrying the
// parser's own message, which names the offset.
//
// The size cap is checked BEFORE the media type: a body too large to decode is
// refused whatever it claims to be, and the answer does not depend on a header
// the client also chose.
fn requestJson(c: Ctx): Json! {
  let raw = requestBody(c)?
  let media = mediaTypeOf(c.header(contentTypeName))
  if (!isJsonContentType(media)) {
    fail httpError(
      statusUnsupportedMediaType,
      "web: Content-Type '${clipEcho(media)}' is not JSON; this route reads ${jsonContentType}",
    )
  }
  return parseBodyJson(raw) catch e {
    fail badRequest("web: request body is not valid JSON: ${e.message()}")
  }
}

// The media type of a `Content-Type` value: everything before the first `;`,
// trimmed and lowercased, so `application/json; charset=utf-8` is
// `application/json`. Parameters are dropped rather than parsed — nothing here
// reads one, and `charset` on JSON is meaningless (RFC 8259 §8.1: JSON is
// UTF-8).
fn mediaTypeOf(v: string): string {
  let semi = indexOf(v, ";")
  if (semi < 0) {
    return toLower(trimSpace(v))
  }
  return toLower(trimSpace(v[0:semi]))
}

// Whether `media` is JSON: `application/json`, or any `+json` structured
// syntax suffix.
//
// AN ABSENT `Content-Type` IS NOT JSON and gets the 415. A framework that
// guessed would parse whatever a client posted with no declared type, which is
// precisely the request an attacker controls most completely.
fn isJsonContentType(media: string): bool {
  if (media == jsonContentType) {
    return true
  }
  let n = len(media)
  let k = len(jsonTypeSuffix)
  if (n <= k) {
    return false
  }
  return media[n - k:n] == jsonTypeSuffix
}

// `s` clipped to `maxEchoBytes`, for a diagnostic that repeats a header the
// client chose.
fn clipEcho(s: string): string {
  if (len(s) <= maxEchoBytes) {
    return s
  }
  return s[0:maxEchoBytes] + "..."
}

// --- the policy -------------------------------------------------------------

// The app-level default as a policy value.
fn bodyPolicy(cfg: Config): Unknown {
  if (cfg.rejectUnknownFields) {
    return Unknown.Reject
  }
  return Unknown.Ignore
}

fn ignoresUnknown(u: Unknown): bool {
  match (u) {
    Reject => return false
    Ignore => return true
  }
}

// --- binding ----------------------------------------------------------------

// The whole of binding a body: decode it under policy `u`, then run whatever
// value rules the bound type declares (#3880, validate.bit).
//
// THE TWO STEPS ANSWER WITH DIFFERENT STATUSES AND THE ORDER IS WHY. A decode
// failure is a 400 — the document did not match the type this route declared,
// so there is no value to check rules against. A rule failure is a 422: the
// document WAS a `NewUser`, and the values in it are unacceptable. Validation
// therefore cannot run first and cannot be folded into the decode.
//
// Both `c.body` and `c.bodyWith` reach here, so neither is the lenient one:
// the unknown-field policy is a per-call choice and validation is not.
fn bindJson<T>(j: Json, u: Unknown): T! {
  let bound = decodeUnder<T>(j, u)?
  validateBound(bound)?
  return bound
}

// Decodes `j` into `T` under policy `u`, mapping whatever std/json fails with
// into a client error.
//
// ONE DECODE EITHER WAY (#4567). `Ignore` used to be a retry loop — decode,
// read the `UnknownKey` failure, rebuild the document without the one key its
// path named, decode again — because `jsonDecode` had no lenient mode and this
// package cannot know the bound type's key set: `T` is a type parameter here
// and Bit has no reflection. That cost a whole decode and a whole tree rebuild
// per unknown key, which is quadratic on attacker-chosen input, so it was
// bounded at 32 keys and answered 400 past it — refusing a legitimate client
// that sent 33 fields this version does not know.
//
// `jsonDecodeLenient<T>` skips the check inside the decoder, which is the one
// place the key set exists, so there is no bound left to exceed and nothing to
// rebuild. `withoutUnknownKey`, `withoutPath`, `unknownKeyPath` and
// `maxIgnoredKeys` are gone with it.
fn decodeUnder<T>(j: Json, u: Unknown): T! {
  if (ignoresUnknown(u)) {
    return jsonDecodeLenient<T>(j) catch e {
      fail bodyFailure(e)
    }
  }
  return jsonDecode<T>(j) catch e {
    fail bodyFailure(e)
  }
}

// --- the error mapping ------------------------------------------------------

// Every failure std/json's typed decode produces is a CLIENT error: the
// document did not match the type this route declared. Each one already names
// the field and the full dotted path (`addr.zip`), the expected type and what
// was found, so the message goes out as-is — a single "invalid body" would
// leave the caller nothing to act on.
//
// It is a 400 for all four causes. A missing field, a wrong type, an unknown
// key and a document nested past the decode depth bound are all the same fact
// about the request: it is malformed against this route's contract. 422 is
// reserved for a document that is well-formed against the TYPE and fails a
// domain rule, which is #3880's validation and not this file's.
//
// Anything that is NOT a `JsonDecodeError` comes back untouched rather than
// being called a client error on the strength of where it was raised: it keeps
// whatever mapping it already had, and one that opted into nothing stays a 500
// with its message logged and not sent (errors.bit).
fn bodyFailure(e: error): error {
  let (de, ok) = e.(JsonDecodeError)
  if (!ok) {
    return e
  }
  return badRequest(de.message())
}
