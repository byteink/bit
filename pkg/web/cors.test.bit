// pkg/web/cors.test.bit — #3955's acceptance, one named test per assertion.
//
// Every behavioural test drives `app.handle(req)` (app.bit), the in-process
// seam #3885 established, so the middleware under test is composed into the
// real chain by `freeze()` and reached exactly the way a served request
// reaches it. Calling `cors()`'s arrow by hand would pass just as well against
// a middleware registered on the wrong scope.
//
// The preflight tests register `OPTIONS` through the exported
// `route(method, path, h)` (app.bit, #4516) — the same call an application
// makes. They used to reach through the module-private `Group.register`,
// which meant preflight handling was proven only from inside this module and
// was unreachable for any app that used the package.
//
// `req`, `adapterApp`, `newSink`, `freezeOrPanic` (adapter.test.bit),
// `contains`/`countOccurrences` (router.test.bit) and `readFile`/`locateBit`
// (node.test.bit) are already bound module-wide (SPEC §17.1) — reused, never
// re-imported (E0042). This file adds no import.

const allowedOrigin = "https://app.example.com"
const secondOrigin = "https://admin.example.com"
const foreignOrigin = "https://evil.example.net"

// The `Cors` every test starts from: two origins, an explicit method and
// header list, a preflight cache lifetime, no credentials.
fn corsCfg(): Cors {
  return Cors{
    origins: []string{ allowedOrigin, secondOrigin },
    methods: []string{ "GET", "POST" },
    headers: []string{ "Content-Type", "Authorization" },
    maxAge: 600,
  }
}

fn corsApp(cfg: Cors): App {
  let app = adapterApp(newSink())
  app.use(cors(cfg))
  return app
}

fn corsReq(method: string, path: string, headers: string): Request {
  return Request{ method: method, path: path, headers: headers, body: "" }
}

// The two-line header block a browser sends on a preflight.
fn preflightHeaders(origin: string): string {
  return "Origin: ${origin}\r\nAccess-Control-Request-Method: POST"
}

// Every `Access-Control-*` field on a response, as the raw block. The
// disallowed-origin assertions search THIS rather than naming the three
// headers they expect to be missing: a fourth one added later would slip past
// a named list and cannot slip past this.
fn accessControlHeaders(res: Response): string {
  let out = []string(0)
  for line of split(res.headers, "\r\n") {
    if (contains(toLower(line), "access-control-")) {
      out = append(out, line)
    }
  }
  return join(out, " | ")
}

// --- an allowed origin ----------------------------------------------------

test "an allowed origin is echoed exactly, with Vary: Origin" {
  let app = corsApp(corsCfg())
  app.get(
    "/data",
    (c) => {
      return c.text("ok")
    },
  )
  freezeOrPanic(app)

  let res = app.handle(corsReq("GET", "/data", "Origin: ${allowedOrigin}"))

  assert(res.status == 200, "want 200, got ${res.status}")
  assert(res.body == "ok", "the handler's body must survive, got '${res.body}'")
  assert(
    res.getHeader("Access-Control-Allow-Origin") == allowedOrigin,
    "want the request's own origin echoed, got '${res.getHeader("Access-Control-Allow-Origin")}'",
  )
  assert(
    res.getHeader("Vary") == "Origin",
    "want 'Vary: Origin', got '${res.getHeader("Vary")}'",
  )
}

// The echo is the REQUEST's origin, not the first list entry and not the list
// itself — so a second allowed origin must come back as itself.
test "the echoed origin is the requesting one, never the list or its first entry" {
  let app = corsApp(corsCfg())
  app.get(
    "/data",
    (c) => {
      return c.text("ok")
    },
  )
  freezeOrPanic(app)

  let res = app.handle(corsReq("GET", "/data", "Origin: ${secondOrigin}"))

  let got = res.getHeader("Access-Control-Allow-Origin")
  assert(got == secondOrigin, "want '${secondOrigin}', got '${got}'")
  assert(!contains(got, allowedOrigin), "the other allowed origin leaked into the echo: '${got}'")
}

// --- a disallowed origin --------------------------------------------------

test "a disallowed origin gets no Access-Control-* header and still reaches the handler" {
  let ran = false
  let app = corsApp(corsCfg())
  app.get(
    "/data",
    (c) => {
      ran = true
      return c.text("ok")
    },
  )
  freezeOrPanic(app)

  let res = app.handle(corsReq("GET", "/data", "Origin: ${foreignOrigin}"))

  assert(res.status == 200, "a disallowed origin is not an error status, got ${res.status}")
  assert(ran, "the handler must still run for a disallowed origin")
  assert(res.body == "ok", "want the handler's body, got '${res.body}'")
  assert(
    accessControlHeaders(res) == "",
    "no Access-Control-* header may be sent, got '${accessControlHeaders(res)}'",
  )
  assert(!contains(res.headers, foreignOrigin), "the origin was echoed back: '${res.headers}'")
}

test "Vary: Origin is on the disallowed-origin response too" {
  let app = corsApp(corsCfg())
  app.get(
    "/data",
    (c) => {
      return c.text("ok")
    },
  )
  freezeOrPanic(app)

  let res = app.handle(corsReq("GET", "/data", "Origin: ${foreignOrigin}"))

  assert(
    res.getHeader("Vary") == "Origin",
    "a cache must key on Origin here too, got '${res.getHeader("Vary")}'",
  )
}

test "a request carrying no Origin gets Vary: Origin and no Access-Control-* header" {
  let app = corsApp(corsCfg())
  app.get(
    "/data",
    (c) => {
      return c.text("ok")
    },
  )
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/data"))

  assert(res.status == 200, "want 200, got ${res.status}")
  assert(
    res.getHeader("Vary") == "Origin",
    "want 'Vary: Origin', got '${res.getHeader("Vary")}'",
  )
  assert(
    accessControlHeaders(res) == "",
    "a request with no Origin must get no CORS headers, got '${accessControlHeaders(res)}'",
  )
}

// `Res.set` (res.bit) REPLACES, so adding `Vary` naively would delete a
// handler's own. This is the test that pins the append.
test "Vary: Origin is added to the handler's own Vary, never substituted for it" {
  let app = corsApp(corsCfg())
  app.get(
    "/data",
    (c) => {
      return c.text("ok").header("Vary", "Accept-Encoding")
    },
  )
  freezeOrPanic(app)

  let res = app.handle(corsReq("GET", "/data", "Origin: ${allowedOrigin}"))

  assert(
    res.getHeader("Vary") == "Accept-Encoding, Origin",
    "want 'Accept-Encoding, Origin', got '${res.getHeader("Vary")}'",
  )
}

test "Vary is not duplicated when the handler already listed Origin" {
  let app = corsApp(corsCfg())
  app.get(
    "/data",
    (c) => {
      return c.text("ok").header("Vary", "origin")
    },
  )
  freezeOrPanic(app)

  let res = app.handle(corsReq("GET", "/data", "Origin: ${allowedOrigin}"))

  assert(
    res.getHeader("Vary") == "origin",
    "an existing Origin token must be left alone, got '${res.getHeader("Vary")}'",
  )
}

// --- the preflight --------------------------------------------------------

test "a preflight from an allowed origin is 204 with methods, headers and max-age, handler unrun" {
  let ran = false
  let app = corsApp(corsCfg())
  let _ = app.route(
    "OPTIONS",
    "/data",
    (c) => {
      ran = true
      return c.text("the handler ran")
    },
  )
  freezeOrPanic(app)

  let res = app.handle(corsReq("OPTIONS", "/data", preflightHeaders(allowedOrigin)))

  assert(res.status == 204, "want 204, got ${res.status}")
  assert(!ran, "a matched preflight must not reach the handler")
  assert(res.body == "", "a 204 carries no body, got '${res.body}'")
  assert(
    res.getHeader("Access-Control-Allow-Origin") == allowedOrigin,
    "want the origin echoed, got '${res.getHeader("Access-Control-Allow-Origin")}'",
  )
  assert(
    res.getHeader("Access-Control-Allow-Methods") == "GET, POST",
    "want the configured methods, got '${res.getHeader("Access-Control-Allow-Methods")}'",
  )
  assert(
    res.getHeader("Access-Control-Allow-Headers") == "Content-Type, Authorization",
    "want the configured headers, got '${res.getHeader("Access-Control-Allow-Headers")}'",
  )
  assert(
    res.getHeader("Access-Control-Max-Age") == "600",
    "want the configured max-age, got '${res.getHeader("Access-Control-Max-Age")}'",
  )
  assert(res.getHeader("Vary") == "Origin", "want 'Vary: Origin', got '${res.getHeader("Vary")}'")
}

test "a preflight from a disallowed origin reaches the handler and gets no CORS headers" {
  let ran = false
  let app = corsApp(corsCfg())
  let _ = app.route(
    "OPTIONS",
    "/data",
    (c) => {
      ran = true
      return c.text("the handler ran")
    },
  )
  freezeOrPanic(app)

  let res = app.handle(corsReq("OPTIONS", "/data", preflightHeaders(foreignOrigin)))

  assert(ran, "an unmatched preflight is an ordinary request and must reach the handler")
  assert(res.status == 200, "want the handler's 200, got ${res.status}")
  assert(
    accessControlHeaders(res) == "",
    "no CORS headers for a disallowed origin, got '${accessControlHeaders(res)}'",
  )
}

// A bare `OPTIONS` with no `Access-Control-Request-Method` is a legitimate
// capability query, not a preflight, and must not be swallowed.
test "a bare OPTIONS without Access-Control-Request-Method reaches the handler" {
  let ran = false
  let app = corsApp(corsCfg())
  let _ = app.route(
    "OPTIONS",
    "/data",
    (c) => {
      ran = true
      return c.text("the handler ran")
    },
  )
  freezeOrPanic(app)

  let res = app.handle(corsReq("OPTIONS", "/data", "Origin: ${allowedOrigin}"))

  assert(ran, "a bare OPTIONS is not a preflight and must reach the handler")
  assert(res.status == 200, "want the handler's 200, got ${res.status}")
  assert(res.body == "the handler ran", "want the handler's body, got '${res.body}'")
  assert(
    res.getHeader("Access-Control-Allow-Origin") == allowedOrigin,
    "it is still a cross-origin response, so the echo applies",
  )
}

// A preflight with no `methods`/`headers`/`maxAge` configured sends only what
// it can stand behind: the echo and `Vary`. Fail-closed — the browser then
// permits only the simple methods.
test "a preflight configured with no methods, headers or max-age sends none of those fields" {
  let app = corsApp(Cors{ origins: []string{ allowedOrigin } })
  let _ = app.route("OPTIONS", "/data", okHandler)
  freezeOrPanic(app)

  let res = app.handle(corsReq("OPTIONS", "/data", preflightHeaders(allowedOrigin)))

  assert(res.status == 204, "want 204, got ${res.status}")
  assert(
    res.getHeader("Access-Control-Allow-Origin") == allowedOrigin,
    "the echo is unconditional on a matched preflight",
  )
  assert(len(res.getHeader("Access-Control-Allow-Methods")) == 0, "no methods were configured")
  assert(len(res.getHeader("Access-Control-Allow-Headers")) == 0, "no headers were configured")
  assert(len(res.getHeader("Access-Control-Max-Age")) == 0, "maxAge 0 means send no field")
}

// --- credentials ----------------------------------------------------------

test "credentials: true emits Access-Control-Allow-Credentials only alongside an echoed origin" {
  let app = corsApp(Cors{ origins: []string{ allowedOrigin }, credentials: true })
  app.get(
    "/data",
    (c) => {
      return c.text("ok")
    },
  )
  freezeOrPanic(app)

  let allowed = app.handle(corsReq("GET", "/data", "Origin: ${allowedOrigin}"))
  assert(
    allowed.getHeader("Access-Control-Allow-Credentials") == "true",
    "want 'true', got '${allowed.getHeader("Access-Control-Allow-Credentials")}'",
  )
  assert(
    allowed.getHeader("Access-Control-Allow-Origin") == allowedOrigin,
    "credentials are only ever sent with a specific echoed origin",
  )

  let denied = app.handle(corsReq("GET", "/data", "Origin: ${foreignOrigin}"))
  assert(
    accessControlHeaders(denied) == "",
    "a disallowed origin gets no credentials field, got '${accessControlHeaders(denied)}'",
  )
}

test "credentials: false sends no Access-Control-Allow-Credentials at all" {
  let app = corsApp(corsCfg())
  app.get(
    "/data",
    (c) => {
      return c.text("ok")
    },
  )
  freezeOrPanic(app)

  let res = app.handle(corsReq("GET", "/data", "Origin: ${allowedOrigin}"))

  assert(
    len(res.getHeader("Access-Control-Allow-Credentials")) == 0,
    "want no credentials field, got '${res.getHeader("Access-Control-Allow-Credentials")}'",
  )
}

// --- a failing chain ------------------------------------------------------

// The middleware calls the chain with `catch` + `rethrow` (#4504), so a
// failure must come back out unchanged and reach `failureRes` (adapter.bit).
// Nothing may be decorated on the way — there is no `Res` to decorate.
test "a failing chain propagates through cors() to the adapter's 500" {
  let app = corsApp(corsCfg())
  app.get("/boom", (c) => rethrow(newError("downstream blew up")))
  freezeOrPanic(app)

  let res = app.handle(corsReq("GET", "/boom", "Origin: ${allowedOrigin}"))

  assert(res.status == 500, "want the adapter's 500, got ${res.status}")
  assert(
    accessControlHeaders(res) == "",
    "a failure has no Res to decorate, got '${accessControlHeaders(res)}'",
  )
}

// --- registration refuses a configuration that grants nothing -------------

test "testpanic_cors_with_an_empty_origins_list_is_refused" {
  let _ = cors(Cors{ origins: []string(0) })
}

// `[]T`'s zero value is a live EMPTY slice (SPEC §13.4), so omitting
// `origins` is not `E0083` — it compiles and yields the empty list. This test
// is the proof that the registration panic is what actually catches it, and
// the reason cors.bit's header corrects the ticket on that point.
test "testpanic_cors_with_origins_omitted_entirely_is_refused" {
  let _ = cors(Cors{})
}

test "testpanic_cors_refuses_an_origin_with_no_scheme" {
  let _ = cors(Cors{ origins: []string{ "app.example.com" } })
}

test "testpanic_cors_refuses_a_wildcard_origin" {
  let _ = cors(Cors{ origins: []string{ "*" } })
}

test "testpanic_cors_refuses_an_origin_with_a_trailing_slash" {
  let _ = cors(Cors{ origins: []string{ "https://app.example.com/" } })
}

test "testpanic_cors_refuses_an_origin_carrying_a_path" {
  let _ = cors(Cors{ origins: []string{ "https://app.example.com/api" } })
}

test "testpanic_cors_refuses_an_uppercase_origin" {
  let _ = cors(Cors{ origins: []string{ "https://App.Example.com" } })
}

test "testpanic_cors_refuses_a_negative_maxAge" {
  let _ = cors(Cors{ origins: []string{ allowedOrigin }, maxAge: 0 - 1 })
}

// A valid configuration must NOT panic — the inverse control for the seven
// tests above, without which they would all pass against a `cors()` that
// panics unconditionally.
test "a well-formed Cors registers without panicking" {
  let app = corsApp(corsCfg())
  app.get("/data", okHandler)
  freezeOrPanic(app)

  let res = app.handle(corsReq("GET", "/data", "Origin: ${allowedOrigin}"))

  assert(res.status == 200, "want 200, got ${res.status}")
}

// --- the source-level half of "no wildcard" -------------------------------

// The ticket's own grep, run as a test so it cannot rot: the literal `"*"`
// must not appear in cors.bit, in any position — not as a value, not as a
// default, not as a case in the matcher. The needle is spelled with escapes
// here so that this file does not itself contain the sequence.
//
// It asserts on source it actually READ: the byte count is checked first, so
// a failed or empty read cannot pass as "no wildcard found".
test "source check: cors.bit contains no wildcard origin literal" {
  let loc = locateBit()
  if (len(loc.repo) == 0) {
    print("cors source check: repo not locatable (set BIT_REPO) — skipping\n")
    return
  }
  let src = readFile("${loc.repo}/pkg/web/cors.bit") catch e {
    panic("read cors.bit: ${e.message()}")
  }
  assert(len(src) > 1000, "cors.bit read back ${len(src)} byte(s) — the read failed")

  let wildcard = "\"" + "*" + "\""
  assert(
    countOccurrences(src, wildcard) == 0,
    "cors.bit names a wildcard origin ${countOccurrences(src, wildcard)} time(s)",
  )
  // The control: the needle CAN be found, so a 0 above is a real absence
  // rather than a broken search.
  assert(
    countOccurrences("origins: []string{ ${wildcard} }", wildcard) == 1,
    "the wildcard search itself is broken — it finds nothing in a string that has one",
  )
}
