// pkg/web/servetls.test.bit — App.listenTls()/App.serveTls() (#6073): the
// same app, the same route, answered over three wire protocols stdlib/tls,
// stdlib/http2 and stdlib/http3 already implement — TLS 1.3 plain HTTP/1.1,
// HTTP/2 negotiated by ALPN on the same TLS listener, and HTTP/3 over QUIC on
// the paired UDP port `bindTls` (tls.bit) binds alongside it.
//
// `testApp`/`okHandler` (app.test.bit) are module-wide already. `getTls`,
// `TlsConfig`, `emptyTrustStore`, `h3DialTls`, `H3Request`,
// `HeaderField` and `pemEncode` are new to this module. `decodeHex` is
// already bound to every `.test.bit` file by `session.test.bit`'s own
// import (SPEC §17.2: an import bound only by test files is visible to every
// test file of the module) — importing it again here would be E0042.
import { getTls } from "std/http"
import { TlsConfig, emptyTrustStore } from "std/tls"
import { h3DialTls, H3Conn, H3Request, HeaderField } from "std/http3"
import { pemEncode, fromPem } from "std/crypto"

// The same throwaway self-signed test leaf and key (SAN: localhost,
// example.com), generated once for the test suite, that `stdlib/http/tls.test.bit`,
// `stdlib/smtp/tls.test.bit`, `stdlib/tls`'s own test files and several
// `_tests_/imports` fixtures all already decode from hex at test time rather
// than trust a checked-in PEM file — see any of those files' own comment.
const webTlsLeafHex: string = ""
const webTlsKeyHex: string = ""

fn webTlsPem(label: string, h: string): string {
  let b = decodeHex(h) catch _ {
    return ""
  }
  return pemEncode(label, b)
}

// An App with a real cert/key configured and one route, shared by every wire
// test below.
fn tlsTestApp(): App {
  let app = App(
    Config{
      secret = "test-secret",
      certPem = webTlsPem("CERTIFICATE", webTlsLeafHex),
      keyPem = webTlsPem("PRIVATE KEY", webTlsKeyHex),
    },
  )
  app.get("/doc", (c) => {
    return c.text("secure root")
  })
  return app
}

// A client `TlsConfig` that trusts nothing (this leaf's issuing CA is a
// throwaway test root no client here holds) and offers exactly `alpn` — the
// same shape `stdlib/http`'s own `_tests_/imports/http2e2e` uses to prove
// HTTP/2 is genuinely negotiated rather than silently downgraded.
fn clientCfg(alpn: []string): TlsConfig {
  let cfg = TlsConfig(emptyTrustStore())
  cfg.insecureSkipVerify = true
  cfg.serverName = "localhost"
  cfg.alpn = alpn
  return cfg
}

// `bindTls` (tls.bit) spawns the HTTP/3 UDP listener on the same port right
// after `tlsServe` binds the TCP one, so it can still be finishing its own
// bind by the time a test's very first dial runs. `h3DialTls` has no retry of
// its own, unlike `stdlib`'s own h3 fixtures — this is that retry, bounded
// the same way `_tests_/imports/http2e2e`'s `fetchTls` bounds its own.
// `config` is this leaf's client-side `TlsConfig` (#6235: `dialQuic` verifies
// by default now) — `clientCfg` at this test's call site.
fn dialH3Retry(host: string, port: int, serverName: string, config: TlsConfig): H3Conn! {
  let attempt = 0
  while (attempt < 200) {
    let conn = h3DialTls(host, port, serverName, config) catch _ {
      sleep(10 * Millisecond)
      attempt = attempt + 1
      continue
    }
    return conn
  }
  fail newError("h3DialTls: server did not come up on port ${port}")
}

test "listenTls()/serveTls() fail without Config.certPem/keyPem, naming both fields" {
  let app = testApp()
  let ts = app.serveTls() catch e {
    assert(contains(e.message(), "certPem"), "error names certPem: '${e.message()}'")
    assert(contains(e.message(), "keyPem"), "error names keyPem: '${e.message()}'")
    return
  }
  ts.shutdown(2000) catch _ {
    return
  }
  assert(false, "serveTls() must fail when Config carries no certificate")
}

test "serveTls() answers a request over HTTP/1.1-over-TLS" {
  let app = tlsTestApp()
  let ts = app.serveTls() catch e {
    assert(false, "serveTls: ${e.message()}")
    return
  }
  let port = ts.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }

  let res = getTls("https://127.0.0.1:${port}/doc", clientCfg(["http/1.1"])) catch e {
    assert(false, "getTls: ${e.message()}")
    ts.shutdown(2000) catch _ {
      return
    }
    return
  }
  assert(
    res.status == 200 && res.body == "secure root",
    "want 200 'secure root', got ${res.status} '${res.body}'",
  )
  ts.shutdown(2000) catch _ {
    return
  }
}

test "serveTls() answers a request over HTTP/2, ALPN-negotiated" {
  let app = tlsTestApp()
  let ts = app.serveTls() catch e {
    assert(false, "serveTls: ${e.message()}")
    return
  }
  let port = ts.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }

  // The server ABORTS a disjoint ALPN offer (RFC 7301 §3.2) rather than
  // downgrading it (`serveTlsConn`, stdlib/http/server.bit), so a client that
  // offers ONLY "h2" and still gets its 200 back proves the h2 engine served
  // it — no separate "was this really HTTP/2" probe is needed.
  let res = getTls("https://127.0.0.1:${port}/doc", clientCfg(["h2"])) catch e {
    assert(false, "getTls over h2: ${e.message()}")
    ts.shutdown(2000) catch _ {
      return
    }
    return
  }
  assert(
    res.status == 200 && res.body == "secure root",
    "want 200 'secure root' over h2, got ${res.status} '${res.body}'",
  )
  ts.shutdown(2000) catch _ {
    return
  }
}

test "serveTls() answers a request over HTTP/3 (QUIC), on the port TLS advertises via Alt-Svc" {
  let app = tlsTestApp()
  let ts = app.serveTls() catch e {
    assert(false, "serveTls: ${e.message()}")
    return
  }
  let port = ts.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }

  let h3 = dialH3Retry("127.0.0.1", port, "localhost", clientCfg([]string(0))) catch e {
    assert(false, "h3DialTls: ${e.message()}")
    ts.shutdown(2000) catch _ {
      return
    }
    return
  }
  let resp = h3.request(
    H3Request{
      method = "GET", scheme = "https", authority = "127.0.0.1:${port}",
      path = "/doc", headers = []HeaderField(0), body = []byte(0),
    },
  ) catch e {
    assert(false, "h3 request: ${e.message()}")
    ts.shutdown(2000) catch _ {
      return
    }
    return
  }
  assert(
    resp.status == 200 && string(resp.body) == "secure root",
    "want 200 'secure root' over h3, got ${resp.status} '${string(resp.body)}'",
  )
  ts.shutdown(2000) catch _ {
    return
  }
}

const webTlsCaHex: string = ""

fn verifiedWebSocketConfig(): TlsConfig! {
  return TlsConfig(
    fromPem(webTlsPem("CERTIFICATE", webTlsCaHex))?,
    serverName = "localhost", nowUnix = 1800000000,
  )
}
