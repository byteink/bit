// pkg/web: the helpers `Ctx.route` uses to build a named route's URL,
// split out of ctx.bit when it passed the 800-line limit. A pure move;
// both functions are module-scoped, so ctx.bit calls them unchanged.

// Every name currently recorded in `r`, sorted and comma-joined, or
// "none registered" if there are none — the list an unknown-name failure
// names. `r.names` is an unexported field of an unexported class
// (app.bit's `NameRegistry`); both are module-private, not file-private
// (SPEC §17.3), so reading it here from a sibling file in the same module
// is legal, the same seam app.test.bit already reaches through.
fn registeredNames(r: NameRegistry): string {
  let names = []string(0)
  for (k, _) of r.names {
    names = append(names, k)
  }
  if (len(names) == 0) {
    return "none registered"
  }
  return join(sorted(names, (a, b) => a < b), ", ")
}

// Substitutes `args` positionally into `pattern`'s param (`:x`) and
// wildcard (`*x`) segments, reusing router.bit's own segment splitter and
// segment-kind predicates rather than re-parsing pattern syntax a second
// way. `pattern` is always a router-registered, fully-prefixed pattern (it
// came out of `NameRegistry.lookup`), so its dynamic-segment count is fixed
// before this ever runs — this only reconciles it against what the caller
// supplied.
fn fillRoutePattern(name: string, pattern: string, args: []string): string! {
  let segs = splitSegments(pattern)
  let want = 0
  for seg of segs {
    if (isParamSeg(seg) || isWildcardSeg(seg)) {
      want = want + 1
    }
  }
  if (want != len(args)) {
    fail newError("web: c.route: '${name}' (pattern '${pattern}') takes ${want} argument(s), got ${len(args)}")
  }
  let out = []string(0)
  let ai = 0
  for seg of segs {
    if (isParamSeg(seg) || isWildcardSeg(seg)) {
      out = append(out, args[ai])
      ai = ai + 1
    } else {
      out = append(out, seg)
    }
  }
  if (len(out) == 0) {
    return "/"
  }
  return "/" + join(out, "/")
}
