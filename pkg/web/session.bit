// pkg/web/session.bit — server-side sessions (#3947). The cookie carries a
// 128-bit random id and NOTHING else; every byte of session data lives in a
// store the app supplies.
//
// ## There is no default store, and that is the point
//
// `Config.sessions` (config.bit) has no default. An app that touches
// `c.session()` without one gets a failure naming the `sessions` field
// rather than a working in-memory session — Express's in-memory default is
// the most famous footgun in Node ("not designed for a production
// environment, as it will leak memory, and will not scale past a single
// process") and everyone ignores it, because it works perfectly on a laptop
// and randomly logs users out the day a second server appears. `MemoryStore`
// (memorystore.bit) still ships; it is just written down at the call site.
//
// The refusal cannot be a startup check: nothing static can tell whether a
// handler body ever reaches `c.session()`, and this package has no `listen()`
// that runs handlers (#3885). So the FIRST access is where it fires, loudly.
// It is a `fail`, not a `panic`, for one reason: the acceptance is about the
// MESSAGE, and a message can only be asserted in-process if the caller can
// catch it. `c.session()` is fallible regardless — a real store does I/O —
// so the misconfiguration rides a channel that already exists rather than
// adding a second failure mode to the signature.
//
// ## Why an id and not a signed cookie carrying the data
//
// A signed cookie needs no infrastructure but cannot be revoked and caps out
// near 4 KB. With an id plus a store, revocation is `store.destroy(sid)`.
// `Config.secret` is therefore NOT used here and this file signs nothing: a
// forged id is simply an id that misses in the store. Signing it would buy
// nothing and would tie every live session's validity to one value.
//
// ## `SessionStore` is an `interface`, not a `trait`
//
// #3947 was filed writing `trait SessionStore`. A trait is never a type in
// Bit (SPEC §10.7) — it supplies method BODIES to a class and cannot be a
// field's type — so `Config.sessions` could not have been declared with one.
// A structural `interface` (§14.3) is a value type with dynamic dispatch and
// needs no `implements` declaration, so `MemoryStore`, a future `SqlStore`
// and a user's own store all satisfy it by having the methods.
//
// That choice also solves the omission problem for free: an interface's zero
// value is `nil` (§13.4), so `sessions` can be left out of a `Config` literal
// — every existing test writes `Config{ secret = "x" }` — while a class-typed
// field could be neither omitted (E0083) nor defaulted (a default must be a
// constant expression, §15.4, and no class value is one).

import { encodeHex, randomBytes } from "std/crypto"

// 16 bytes = 128 bits, the ticket's floor. Straight from the OS CSPRNG
// (`randomBytes`, stdlib/crypto/rand.bit, ABI.md §21) — never a counter, a
// timestamp, a hash of anything about the user, or a userspace PRNG.
const sessionIdBytes = 16

// The cookie's name. Deliberately not configurable: a name is not a security
// property, and every knob a framework offers is a knob an app has to have
// an opinion about.
const sessionCookieName = "sid"

// How long a written session stays readable, in seconds. A module const
// rather than a `Config` field, because #3947 adds exactly one field
// (`sessions`) and a setting for work no ticket has asked for is a promise
// the framework cannot keep.
//
// Expiry is ABSOLUTE, not sliding: `save()` refreshes the window, a plain
// read does not, so a session dies 24h after the last write whatever the
// traffic. That is the safer of the two and the simpler one to reason about.
const sessionTTLSeconds: i64 = 86400

// The bound on `Session.takeAtomic`'s load-then-compareAndSet retry loop
// (Power-of-10: no loop without a static limit). Not tuned against any
// measurement — it only has to be small and fixed, since a real conflict
// resolves in the very next attempt and this is purely the ceiling that
// keeps the loop provably bounded.
const sessionCasMaxAttempts: int = 8

// A store of session data, keyed by session id. Structural (§14.3): a type
// satisfies this by having the three methods, with no declaration anywhere.
//
// Every write is a versioned compare-and-set (#5794, TOCTOU: two concurrent
// requests sharing one cookie — one `destroy()`s while the other still holds
// the pre-destroy snapshot — otherwise let the loser's `write` resurrect a
// destroyed session or silently overwrite the winner's update). The store
// holds one version counter per id; a `compareAndSet` whose `expectedVersion`
// no longer matches, or whose id was destroyed, fails rather than writing.
//
// `load` answers `Option.None` for a miss — an unknown, forged, destroyed or
// expired id is the normal case on a public endpoint, not an error — and
// `Option.Some((data, version))` for a hit, INCLUDING a hit whose map has no
// keys. Presence and emptiness are separate facts and the type has to keep
// them apart: #4483, where a miss WAS the empty map, so `loadSession` could
// not tell a stored keyless session from an id that was never written and
// rotated its id. Anything bound to the id itself rather than to the data —
// #3948's CSRF token is `HMAC(secret, session id)` — is silently invalidated
// by that rotation.
//
// `destroy` is unconditional — it always succeeds and always bumps the
// version — and leaves a TOMBSTONE rather than merely removing the id: a
// stale `compareAndSet` still holding the pre-destroy version must fail
// forever, not merely until some other write reuses the version number. The
// tombstone is bounded, not permanent: `tombstoneTtl` is the same window a
// live entry gets, so it expires and is swept exactly like one (#5794).
//
// The `!` is for the store itself failing (a dropped SQL connection, a Redis
// timeout); reporting that as a miss would silently log every user out
// during an outage.
export interface SessionStore {
  load(sid: string): Option<(map<string, string>, i64)>!,
  compareAndSet(sid: string, expectedVersion: i64, data: map<string, string>, ttl: i64): i64!,
  destroy(sid: string, tombstoneTtl: i64): ()!,
}

// One request's session. Obtained from `Ctx.session()` (ctx.bit), which
// builds at most one per request and hands the same object back on every
// later call — so `set` in a middleware is visible to the handler.
export class Session {
  sid: string
  data: map<string, string>
  store: SessionStore
  // The store's version for `data` as of the last load or successful write.
  // 0 means "this id has never been written" — the version a brand-new,
  // never-seen id starts at, and what `persist()` sends as `compareAndSet`'s
  // `expectedVersion` for a session this object never loaded from the store.
  version: i64
  // True when this id was minted during THIS request: either no cookie
  // arrived, or the one that did missed in the store. #3884/#3885 use it to
  // decide whether the response needs a `Set-Cookie` at all.
  fresh: bool
  // Set by `set`/`delete`. `save()` writes only when it is true, so a
  // read-only request costs the store nothing and issues no write.
  dirty: bool
  destroyed: bool

  // This session's id — the value in the cookie, and the key in the store.
  export id(): string {
    return this.sid
  }

  // Whether this id was minted during this request (see `fresh`).
  export isNew(): bool {
    return this.fresh
  }

  // The value stored under `key`, or "" when it is absent. Never fallible:
  // the data is already in memory, and an absent key is not an error.
  export get(key: string): string {
    let (v, ok) = this.data[key]
    if (ok) {
      return v
    }
    return ""
  }

  // Records `key` = `value` for this session. Takes effect in the store at
  // `save()`, not here.
  export set(key: string, value: string) {
    this.mustBeLive("set")
    this.data[key] = value
    this.dirty = true
  }

  // Forgets `key`. Absent is not an error — the post-condition is the same
  // either way.
  export delete(key: string) {
    this.mustBeLive("delete")
    delete(this.data, key)
    this.dirty = true
  }

  // Persists this session's data, if anything changed. A no-op on a
  // destroyed session — the framework's end-of-request save must not
  // resurrect what the handler deliberately revoked.
  export save(): ()! {
    if (!this.dirty) {
      return
    }
    this.persist()?
  }

  // Writes this session to the store whether or not anything changed. The
  // one store write in this file; `save()` is this plus the dirty check.
  //
  // It exists because a session's ID is itself a value other things bind
  // to — #3948's CSRF token is `HMAC(secret, session id)` — and an id that
  // is not IN the store is one the next request replaces (`loadSession`
  // below adopts nothing it cannot find, deliberately: adopting an unknown
  // id is session fixation). A first-time visitor sets no keys, so `save()`
  // alone would never write, and every token issued to such a visitor would
  // fail its own check on submission.
  //
  // Writing a keyless session only became meaningful with #4483: before it,
  // `SessionStore.read` reported a miss AS the empty map, so an empty write
  // read back as a miss and this method could not have worked.
  //
  // A CONDITIONAL write (#5794): `compareAndSet` sends `this.version`, the
  // version this object last saw, and fails rather than overwriting when the
  // store's version has moved since — another request updated this same
  // session, or destroyed it — or errors for any other reason. The caller
  // gets that error back; this method never retries and never silently
  // drops the conflict, because guessing which side should win is exactly
  // the bug this exists to close. A caller that wants to retry reloads the
  // session first, so its next `compareAndSet` starts from the current
  // version.
  //
  // Module-private: the framework decides when an id must survive. A no-op
  // on a destroyed session, for `save()`'s reason.
  persist(): ()! {
    if (this.destroyed) {
      return
    }
    this.version = this.store.compareAndSet(this.sid, this.version, this.data, sessionTTLSeconds)?
    this.dirty = false
  }

  // Revokes this session: the store tombstones the id (bounded — the
  // tombstone expires after `sessionTTLSeconds`, the same window a live
  // entry gets), the in-memory data is dropped, and every later
  // `set`/`delete` on this object panics. A subsequent request presenting
  // the same cookie misses in the store and is issued a fresh id.
  //
  // Unconditional on purpose, unlike `persist()`: a logout must win over
  // whatever another request is doing with this session, never merely
  // "win if nobody else touched it since". It is the tombstone this leaves,
  // not a version check here, that stops a concurrent `persist()` still
  // holding the pre-destroy version from resurrecting the session (#5794).
  export destroy(): ()! {
    if (this.destroyed) {
      return
    }
    this.store.destroy(this.sid, sessionTTLSeconds)?
    this.data = map<string, string>()
    this.dirty = false
    this.destroyed = true
  }

  // Session fixation defence (#5795, OWASP Session Management Cheat Sheet:
  // renew the session id after any privilege change): moves this session's
  // data to a freshly minted CSPRNG id and tombstones the old one, so an id
  // set before login (or before any other privilege change) is invalid the
  // instant this call returns — including to a concurrent request that
  // loaded the old id before this ran. That is the tombstone's job (#5794),
  // not this object's: a sibling `Session` still holding the pre-regenerate
  // version has its next `save()`/`persist()` fail as a destroyed-id
  // conflict, the same guard `destroy()` above already relies on.
  //
  // Order is load-bearing. The data is written under the NEW id first,
  // unconditionally (`compareAndSet` with `expectedVersion = 0` — the
  // version a brand-new id starts at); only once that succeeds is the old
  // id tombstoned. A failure on the new write (the id is fresh CSPRNG
  // output, so only a store-level fault makes this happen) therefore
  // leaves the old id live rather than destroyed with the data gone. The
  // write cannot be skipped even when nothing is `dirty`: the new id must
  // exist in the store the instant this returns, or the very next
  // request's `loadSession` treats it as unknown and replaces it — the
  // exact fixation this method exists to close, just moved one id over.
  //
  // `fresh = true` afterwards reuses `loadSession`'s field for the sense
  // `Ctx.finish`/`sealSession` (ctx.bit) already read it in: this id has
  // not been told to the client yet, so the response owes a `Set-Cookie`.
  export regenerate(): ()! {
    this.mustBeLive("regenerate")
    let oldSid = this.sid
    let newSid = newSessionId()
    let newVersion = this.store.compareAndSet(newSid, 0, this.data, sessionTTLSeconds)?
    this.store.destroy(oldSid, sessionTTLSeconds)?
    this.sid = newSid
    this.version = newVersion
    this.fresh = true
    this.dirty = false
  }

  // Atomically reads and removes `key`, for a value that must be consumed
  // at most once — an OTP, an OIDC `state`/`nonce` (#5777) — even when two
  // requests race the same cookie. Unlike `get`/`delete`/`save`, it never
  // reads this object's own in-memory snapshot: it always starts from the
  // store's CURRENT version, because the whole point is a sibling `Session`
  // object on another request holding the same id. Two racing calls for the
  // same key: exactly one sees `Option.Some(value)`, the other
  // `Option.None`, whether it lost the value to this call or the key was
  // never there.
  //
  // Retries the load-then-compareAndSet on a losing race against a THIRD
  // writer, bounded by `sessionCasMaxAttempts` (Power-of-10: no unbounded
  // loop) — losing that many races in a row to unrelated writers on one
  // session id is not a case this method serves; it fails naming the key.
  export takeAtomic(key: string): Option<string>! {
    this.mustBeLive("takeAtomic")
    let attempt = 0
    while (attempt < sessionCasMaxAttempts) {
      let found = this.store.load(this.sid)?
      if (!isSome(found)) {
        return Option.None
      }
      let (data, version) = unwrap(found)
      let (value, ok) = data[key]
      if (!ok) {
        return Option.None
      }
      delete(data, key)
      let newVersion = this.store.compareAndSet(this.sid, version, data, sessionTTLSeconds) catch _ {
        attempt = attempt + 1
        continue
      }
      this.data = data
      this.version = newVersion
      this.dirty = false
      return Option.Some(value)
    }
    fail newError(
        "web: session: takeAtomic(${key}): lost the compare-and-set race " +
        "${sessionCasMaxAttempts} times in a row",
    )
  }

  // The `Set-Cookie` VALUE for this session — what #3884's response layer
  // puts after `Set-Cookie: `. All four attributes are mandatory and none is
  // configurable:
  //
  //   HttpOnly       script cannot read the id, so an XSS cannot steal it
  //   SameSite=Lax   blocks cross-site POSTs; the first half of the CSRF story
  //   Secure         never sent over plaintext HTTP
  //   Path=/         one session for the whole app, not one per subtree
  //
  // The id is hex, so it needs no quoting or percent-encoding to be a legal
  // cookie value.
  export cookie(): string {
    return sessionCookieName + "=" + this.sid + "; HttpOnly; SameSite=Lax; Secure; Path=/"
  }

  // Panics on use after `destroy()`. A caller-contract violation, handled
  // exactly the way app.bit handles registration after `listen()`: the
  // alternative is mutating a map that will never be written, which loses
  // data in silence.
  mustBeLive(what: string) {
    if (this.destroyed) {
      panic("web: session: ${what}() after destroy()")
    }
  }
}

// A fresh session id: `sessionIdBytes` bytes from the OS CSPRNG, hex-encoded.
// Hex rather than base64url purely so the value is unambiguous — both are
// cookie-safe, and hex has no padding or alphabet variants to get wrong. The
// encoding is reversible on purpose: a test decodes an issued id back to
// prove the entropy is really there, which a bare string comparison cannot.
export fn newSessionId(): string {
  return encodeHex(randomBytes(sessionIdBytes))
}

// Loads the session `sid` names, or starts a new one.
//
// An id that arrives but misses in the store (unknown, expired, destroyed,
// forged) is REPLACED, never adopted. Adopting one would be session
// fixation: an attacker who can set a victim's cookie would then know the id
// the victim's login lands on.
//
// PRESENCE in the store is the whole test (#4483). A stored session with no
// keys is adopted like any other: an id is itself a value other things bind
// to, so rotating it is never free, whatever the map holds.
fn loadSession(store: SessionStore, sid: string): Session! {
  if (len(sid) > 0) {
    let found = store.load(sid)?
    if (isSome(found)) {
      let (data, version) = unwrap(found)
      return Session{
        sid = sid,
        data = data,
        store = store,
        version = version,
        fresh = false,
        dirty = false,
        destroyed = false,
      }
    }
  }
  return Session{
    sid = newSessionId(),
    data = map<string, string>(),
    store = store,
    version = 0,
    fresh = true,
    dirty = false,
    destroyed = false,
  }
}

// The session id carried by the request's `Cookie` header(s), or "" when
// there is none. `raws` is every value of the header, in arrival order
// (`Ctx.headers("cookie")`) — a client may legally split its cookies across
// several `Cookie` lines, and reading only the first would drop a session at
// random depending on how the client packed them.
//
// A pair whose name does not match is skipped rather than rejected: the
// header is shared with every other cookie the site has ever set, so a
// malformed neighbour must not cost the user their session.
fn sessionIdFromCookies(raws: []string): string {
  for raw of raws {
    for pair of split(raw, ";") {
      let eq = indexOf(pair, "=")
      if (eq <= 0) {
        continue
      }
      if (trimSpace(pair[0:eq]) == sessionCookieName) {
        return trimSpace(pair[eq + 1:len(pair)])
      }
    }
  }
  return ""
}
