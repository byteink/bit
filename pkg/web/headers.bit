// pkg/web/headers.bit — `app.use(secureHeaders(Headers{}))`: the standard
// security response headers, set on every response the middleware chain
// produces (#3956).
//
// Named `secureHeaders`, not `helmet`: helmet is a package brand from another
// ecosystem, and a reader of this codebase should not have to know Node to
// understand the call.
//
// --- why the options argument is not optional ------------------------------
//
// The ticket spells the default call `secureHeaders()` and the configured one
// `secureHeaders(Headers{ csp: "..." })`. Bit has neither overloading nor
// default arguments — SPEC §10.3's `param = [ "..." ] IDENT ":" type .` has no
// default-value production, and §4190 lists default arguments as unshipped — so
// exactly one of those two spellings can exist. This file takes the one
// argument and asks for `Headers{}` at the default call site, rather than
// shipping a second entry point whose behaviour can drift from the first.
// Every field of `Headers` is omittable, so `Headers{}` IS the documented
// defaults.
//
// --- what this middleware does NOT cover -----------------------------------
//
// It runs on the way OUT, on the `Res` the rest of the chain returned. Three
// responses never pass through it, by construction, and no comment here can
// change that:
//
//   * a 404 for a path no route matched, and a 405 — both are answered by
//     `missResponse` (adapter.bit) before any chain is entered;
//   * a response built from a FAILURE — `failureRes` (adapter.bit) is the
//     single mapping site and it sits outside and after the chain.
//
// That is the shape of the seam #3885 established, not an oversight. The
// bodies those three paths send are the framework's own fixed strings, never
// handler output, so the headers below have nothing to defend on them.
//
// `Header`, `Res` and `Res.set` are res.bit's; `Middleware`, `Next` and
// `rethrow` are middleware.bit's. Both are the same MODULE (SPEC §17.1), so
// nothing here is imported and this file adds no `import` line at all —
// `set` is module-private rather than file-private (SPEC §17.3), the same
// seam `missResponse` (adapter.bit) already writes `Allow` through.

// `Content-Security-Policy`. `default-src 'self'` blocks inline `<script>` and
// inline `<style>`, and blocks every third-party origin. That is the whole
// point of CSP and it WILL break a page the first time somebody writes an
// inline script — which is why it is documented here and at the call site
// rather than discovered.
//
// The field is replaced WHOLESALE (see `Headers.csp`): there is no merging of
// directives anywhere in this file, because a partial override that silently
// merges is how a permissive policy gets assembled by accident.
const defaultCsp = "default-src 'self'"

// One year, subdomains included. Emitted only when the app declares HTTPS —
// see `Headers.https` for why that is a declaration and not a detection.
const hstsValue = "max-age=31536000; includeSubDomains"

const cspName = "Content-Security-Policy"
const hstsName = "Strict-Transport-Security"

// What `secureHeaders` sends, and the two decisions an app can make about it.
// Both fields are omittable, so `Headers{}` is every default in this file.
export class Headers {
  // The `Content-Security-Policy` value, replacing the default exactly — no
  // merging, no builder, no per-directive override. The empty string omits
  // the header entirely, which is the right setting for an app that serves
  // an API only and never returns a document a browser will render.
  export csp: string = defaultCsp,
  // Whether every request reaching this app arrived over TLS. It is the app's
  // DECLARATION about its own deployment, not something the framework detects,
  // and `Strict-Transport-Security` is emitted if and only if it is true.
  //
  // There is nothing to detect. `Request` (stdlib/http/http.bit:164) is
  // `{ method, path, headers, body }` — no scheme, no connection, no TLS
  // state — `Ctx` (ctx.bit) exposes nothing about the transport either, and
  // `listenAndServe` (stdlib/http/server.bit) serves plaintext TCP: this
  // framework cannot itself terminate TLS today. A deployment that serves
  // HTTPS does it in a proxy in front, and the proxy is the only party that
  // knows.
  //
  // `X-Forwarded-Proto` is deliberately NOT read, and not as a fallback
  // either. Nothing in this package establishes that a request came from a
  // trusted proxy, so that header is client-controlled input like any other:
  // one request carrying `X-Forwarded-Proto: https` would pin a one-year
  // `includeSubDomains` HSTS policy onto the whole domain in every browser
  // that saw it. A client-triggered outage of every subdomain for a year is a
  // worse failure than not sending the header, so the signal has to be one the
  // client cannot reach. Reading it would need a trusted-proxy allowlist this
  // package does not have (there is no such field on `Config`, config.bit).
  //
  // False by default, so an app that says nothing never emits HSTS over a
  // connection that might be plaintext.
  export https: bool = false,
}

// The eight headers that are the same on every response. A TABLE, not eight
// branches: adding or removing one is an edit to this list and nothing else,
// and the two conditional headers (`csp`, HSTS) are the only reason any
// branch exists in this file at all.
//
// Two of helmet's headers are DELIBERATELY ABSENT, and this is the record
// that it was a decision rather than an oversight:
//
//   * `X-Download-Options: noopen` is IE8-only.
//   * `X-Permitted-Cross-Domain-Policies: none` governs the Adobe Flash and
//     Acrobat cross-domain policy file.
//
// Both target software no supported browser runs. Shipping a dead header is
// superstition, not defence, and each one is a line a future reader has to
// research before they may touch this list.
fn fixedSecureHeaders(): []Header {
  return []Header{
    Header{ name: "X-Content-Type-Options", value: "nosniff" },
    Header{ name: "X-Frame-Options", value: "DENY" },
    Header{ name: "Referrer-Policy", value: "no-referrer" },
    Header{ name: "Cross-Origin-Opener-Policy", value: "same-origin" },
    Header{ name: "Cross-Origin-Resource-Policy", value: "same-origin" },
    Header{ name: "Origin-Agent-Cluster", value: "?1" },
    Header{ name: "X-DNS-Prefetch-Control", value: "off" },
    // SET TO `0`, NOT OMITTED, AND NEVER `1` — READ THIS BEFORE CHANGING IT
    // IN EITHER DIRECTION.
    //
    // This header controls the legacy XSS auditor, which current browsers have
    // removed. Omitting it is not equivalent to disabling it: an older browser
    // that sees no header falls back to its own default, and that default was
    // historically the filter ENABLED — and the enabled filter introduced its
    // own vulnerabilities, because it rewrote pages it judged to be under
    // attack. `0` turns it off explicitly, on every browser that still has it.
    // `1` and `1; mode=block` turn on the vulnerable thing; leaving the header
    // out is a weaker version of the same mistake.
    Header{ name: "X-XSS-Protection", value: "0" },
  }
}

// Every header this middleware would set for `o`, conditionals resolved:
// `fixedSecureHeaders()` plus the CSP when it is non-empty, plus HSTS when the
// app declared HTTPS. Built per response rather than once per registration
// because the list is eight to ten small values and `Res.set` consumes it
// immediately — there is nothing here worth the risk of a shared mutable
// slice living across requests.
fn secureHeaderList(o: Headers): []Header {
  let out = fixedSecureHeaders()
  if (len(o.csp) > 0) {
    out = append(out, Header{ name: cspName, value: o.csp })
  }
  if (o.https) {
    out = append(out, Header{ name: hstsName, value: hstsValue })
  }
  return out
}

// Sets every header from `secureHeaderList` that `r` does not already carry.
//
// THE HANDLER WINS. A handler that set `X-Frame-Options: SAMEORIGIN` for one
// route meant it, and a middleware registered app-wide that silently replaced
// it would make that route's own decision unreachable — the app author would
// have no spelling left for it. `headerValue` (res.bit) is case-insensitive,
// so `x-frame-options` from a handler is seen as the same header.
//
// A header the handler set to the empty string counts as unset, because
// `headerValue` returns "" for both. That collapse is res.bit's, and the two
// cases are indistinguishable from here; an empty security header carries no
// policy anyway, so filling it in is the safe reading of the ambiguity.
fn applySecureHeaders(r: Res, o: Headers): Res {
  for h of secureHeaderList(o) {
    if (len(r.headerValue(h.name)) > 0) {
      continue
    }
    // `set`, not `header()`: `header()` returns `Res` for chaining, and
    // discarding a return value is E0215.
    r.set(h.name, h.value)
  }
  return r
}

// The middleware. Registered like any other — `app.use(secureHeaders(Headers{}))`
// — and it acts on the way OUT, so it sees the final `Res` of everything
// registered after it on the same scope.
//
// A block body with `rethrow` rather than `next(c)?`: `?` and `fail` are both
// rejected inside an arrow today (E0061/E0060, #4504), and `rethrow`
// (middleware.bit:35) is the spelling this package standardized on until that
// lands. A failure passes straight through untouched — there is no `Res` to
// put a header on yet, and `failureRes` (adapter.bit) is the one place that
// decides what a failure becomes.
//
// The arrow is bound to an annotated `let` and THEN returned, rather than
// written straight into the `return`, because of #4513: an arrow in return
// position is given no expected type, so its unannotated parameters stay
// untyped and `next(c)` becomes `error[E0092]: cannot lower a call whose callee
// does not resolve to a function` — at LOWERING, after `bit check` has already
// exited 0. The annotated `let` is one of the four positions the expectation IS
// seeded from (compiler/checkarrow.bit). Delete the local when #4513 lands.
export fn secureHeaders(o: Headers): Middleware {
  let mw: Middleware = (c, next) => {
    let r = next(c) catch e {
      return rethrow(e)
    }
    return applySecureHeaders(r, o)
  }
  return mw
}
