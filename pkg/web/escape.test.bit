// pkg/web/escape.test.bit — the four escaping entry points (#3887's own
// acceptance): `text` against a live-tag payload, `safeUrl` against all three
// refused schemes plus every allowed form, `js` against a `</script>`
// breakout, `raw` against byte-for-byte passthrough.
//
// `contains` is already imported module-wide by router.test.bit — reused
// here, not re-imported (E0042).

// Runs `safeUrl(s)` and returns its error message, panicking if it unexpectedly
// succeeds — every refused-scheme case below shares this shape (mirrors
// router.test.bit's own `freezeErr`).
fn safeUrlErr(s: string): string {
  let msg = ""
  let _ = safeUrl(s) catch e {
    msg = e.message()
    ""
  }
  assert(len(msg) > 0, "safeUrl(${s}): expected a refusal, got none")
  return msg
}

fn safeUrlOk(s: string): string {
  return safeUrl(s) catch e {
    panic("safeUrl(${s}): expected success, got: ${e.message()}")
  }
}

test "text() escapes a hostile payload with no live tag" {
  let out = render(div(text("<script>alert(1)</script>")))
  assert(!contains(out, "<script>"), "a live <script> tag leaked through: ${out}")
  assert(
    contains(out, "&lt;script&gt;alert(1)&lt;/script&gt;"),
    "expected the escaped payload verbatim, got: ${out}",
  )
}

test "text() escapes the other three HTML-significant bytes" {
  let out = render(div(text("a & b > \"c\" 'd'")))
  assert(out == "<div>a &amp; b &gt; &quot;c&quot; &#39;d&#39;</div>", "got: ${out}")
}

test "safeUrl() returns http, https, mailto and a relative path unchanged" {
  assert(safeUrlOk("http://example.com/x") == "http://example.com/x", "http")
  assert(safeUrlOk("https://example.com/x") == "https://example.com/x", "https")
  assert(safeUrlOk("mailto:a@example.com") == "mailto:a@example.com", "mailto")
  assert(safeUrlOk("/a/b?c=1#d") == "/a/b?c=1#d", "relative (absolute path)")
  assert(safeUrlOk("a/b") == "a/b", "relative (bare)")
  assert(safeUrlOk("?x=1") == "?x=1", "relative (query only)")
  assert(safeUrlOk("#frag") == "#frag", "relative (fragment only)")
}

test "safeUrl() refuses javascript:, data:, vbscript: and an unrecognised scheme" {
  let m1 = safeUrlErr("javascript:alert(1)")
  assert(contains(m1, "javascript"), "expected the scheme named in: ${m1}")

  let m2 = safeUrlErr("data:text/html,<script>alert(1)</script>")
  assert(contains(m2, "data"), "expected the scheme named in: ${m2}")

  let m3 = safeUrlErr("vbscript:msgbox(1)")
  assert(contains(m3, "vbscript"), "expected the scheme named in: ${m3}")

  let m4 = safeUrlErr("ftp://example.com/x")
  assert(contains(m4, "ftp"), "expected the scheme named in: ${m4}")
}

test "safeUrl() folds scheme case, so JavaScript: is refused too" {
  let _ = safeUrlErr("JavaScript:alert(1)")
  let _ = safeUrlErr("JAVASCRIPT:alert(1)")
}

test "js() output cannot terminate an enclosing script block" {
  let hostile = "</script><script>alert(1)</script>"
  let out = render(el("script", raw("const x = " + js(hostile) + ";")))
  // Exactly one <script> open and one </script> close: the whole payload,
  // hostile close tags included, stayed inside the JS string literal.
  assert(!contains(out, "</script><script>"), "the payload broke out: ${out}")
  assert(
    out == "<script>const x = \"\\u003c/script>\\u003cscript>alert(1)\\u003c/script>\";</script>",
    "got: ${out}",
  )
}

test "raw() passes its input through byte-for-byte" {
  let hostile = "<b>&not escaped</b> \" ' \\ \n"
  let out = render(div(raw(hostile)))
  assert(out == "<div>${hostile}</div>", "raw() altered its input: ${out}")
}
