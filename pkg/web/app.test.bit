// pkg/web/app.test.bit — App, Group and the Routes interface (#3882).
//
// `mount(r: Routes)` is written once and called with an App, a Group and a
// nested Group with no declaration anywhere naming which — the structural
// satisfaction the whole ticket exists to prove (SPEC §14.3: `S` satisfies
// `I` if it has every method `I` names, checked at the call site, never
// declared).
//
// `app.root.registry.lookup(...)` and `app.root.router.lookup(...)` reach
// module-private fields/methods directly — legal because this file is in
// the SAME module as app.bit/router.bit (SPEC §17.3: unexported means
// module-private, not file-private), and it is the same seam #3883's `Ctx`
// will use.
//
// `contains` is already imported module-wide by router.test.bit — reused
// here, not re-imported (E0042).

fn mount(r: Routes) {
  r.get("/x", () => {})
}

// Every test whose subject is NOT configuration builds its App through this,
// so a new required `Config` field (#3946) costs one line here instead of one
// per test. `secret` is the only field with no default, so it is the only one
// spelled; config.test.bit is where the defaults themselves are asserted.
fn testApp(): App {
  return App(Config{ secret: "test-secret" })
}

test "App and Group both satisfy Routes structurally, with no declaration" {
  let app = testApp()
  mount(app)

  let g = app.group("/api/v1")
  mount(g)

  app.listen() catch e {
    panic("listen: ${e.message()}")
  }

  app.root.router.lookup("GET", "/x") catch e {
    panic("expected /x to be registered: ${e.message()}")
  }
  app.root.router.lookup("GET", "/api/v1/x") catch e {
    panic("expected /api/v1/x to be registered: ${e.message()}")
  }
}

test "a nested group prepends both prefixes" {
  let app = testApp()
  let api = app.group("/api/v1")
  let admin = api.group("/admin")
  mount(admin)

  app.listen() catch e {
    panic("listen: ${e.message()}")
  }

  app.root.router.lookup("GET", "/api/v1/admin/x") catch e {
    panic("expected /api/v1/admin/x to be registered: ${e.message()}")
  }
}

test "name() on a grouped route records the fully-prefixed pattern" {
  let app = testApp()
  let api = app.group("/api/v1")
  api.get("/y", () => {}).name("api.users.show")

  app.listen() catch e {
    panic("listen: ${e.message()}")
  }

  let pattern = app.root.registry.lookup("api.users.show") catch e {
    panic("expected 'api.users.show' to be recorded: ${e.message()}")
  }
  assert(pattern == "/api/v1/y", "recorded pattern: got '${pattern}', want '/api/v1/y'")
}

test "two routes given the same name fail at freeze, naming both" {
  let app = testApp()
  app.get("/a", () => {}).name("dup")
  app.get("/b", () => {}).name("dup")

  let failed = false
  app.listen() catch e {
    failed = true
    let msg = e.message()
    assert(contains(msg, "dup"), "error names the duplicate: '${msg}'")
    assert(contains(msg, "/a"), "error names the first pattern: '${msg}'")
    assert(contains(msg, "/b"), "error names the second pattern: '${msg}'")
  }
  assert(failed, "listen() must fail on a duplicate route name")
}

test "testpanic_get_after_listen" {
  let app = testApp()
  app.listen() catch e {
    panic("listen: ${e.message()}")
  }
  app.get("/late", () => {})
}
