// pkg/web/app.test.bit — App, Group and the Routes interface (#3882).
//
// `mount(r: Routes)` is written once and called with an App, a Group and a
// nested Group with no declaration anywhere naming which — the structural
// satisfaction the whole ticket exists to prove (SPEC §14.3: `S` satisfies
// `I` if it has every method `I` names, checked at the call site, never
// declared).
//
// `app.root.registry.lookup(...)` and `app.root.router.lookup(...)` reach
// module-private fields/methods directly — legal because this file is in
// the SAME module as app.bit/router.bit (SPEC §17.3: unexported means
// module-private, not file-private), and it is the same seam #3883's `Ctx`
// will use.
//
// `contains` is already imported module-wide by router.test.bit — reused
// here, not re-imported (E0042).

// `route` is in `Routes` alongside the four verb methods, so a feature that
// needs `PATCH`, `HEAD` or `OPTIONS` mounts at the root or under a group with
// the same one line — the whole point of the interface. Registering it on the
// SAME path as the `GET` proves the two are distinct entries rather than one
// overwriting the other.
fn mount(r: Routes) {
  r.get("/x", okHandler)
  r.route("PATCH", "/x", okHandler)
}

// Every test whose subject is NOT configuration builds its App through this,
// so a new required `Config` field (#3946) costs one line here instead of one
// per test. `secret` is the only field with no default, so it is the only one
// spelled; config.test.bit is where the defaults themselves are asserted.
fn testApp(): App {
  return App(Config{ secret: "test-secret" })
}

test "App and Group both satisfy Routes structurally, with no declaration" {
  let app = testApp()
  mount(app)

  let g = app.group("/api/v1")
  mount(g)

  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }

  app.root.router.lookup("GET", "/x") catch e {
    panic("expected /x to be registered: ${e.message()}")
  }
  app.root.router.lookup("GET", "/api/v1/x") catch e {
    panic("expected /api/v1/x to be registered: ${e.message()}")
  }
  app.root.router.lookup("PATCH", "/x") catch e {
    panic("expected PATCH /x to be registered through Routes.route: ${e.message()}")
  }
  app.root.router.lookup("PATCH", "/api/v1/x") catch e {
    panic("expected PATCH /api/v1/x to be registered: ${e.message()}")
  }
}

test "a nested group prepends both prefixes" {
  let app = testApp()
  let api = app.group("/api/v1")
  let admin = api.group("/admin")
  mount(admin)

  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }

  app.root.router.lookup("GET", "/api/v1/admin/x") catch e {
    panic("expected /api/v1/admin/x to be registered: ${e.message()}")
  }
}

test "name() on a grouped route records the fully-prefixed pattern" {
  let app = testApp()
  let api = app.group("/api/v1")
  api.get("/y", okHandler).name("api.users.show")

  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }

  let pattern = app.root.registry.lookup("api.users.show") catch e {
    panic("expected 'api.users.show' to be recorded: ${e.message()}")
  }
  assert(pattern == "/api/v1/y", "recorded pattern: got '${pattern}', want '/api/v1/y'")
}

test "two routes given the same name fail at freeze, naming both" {
  let app = testApp()
  app.get("/a", okHandler).name("dup")
  app.get("/b", okHandler).name("dup")

  let failed = false
  app.listen() catch e {
    failed = true
    let msg = e.message()
    assert(contains(msg, "dup"), "error names the duplicate: '${msg}'")
    assert(contains(msg, "/a"), "error names the first pattern: '${msg}'")
    assert(contains(msg, "/b"), "error names the second pattern: '${msg}'")
  }
  assert(failed, "listen() must fail on a duplicate route name")
}

test "testpanic_get_after_freeze" {
  let app = testApp()
  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  app.get("/late", okHandler)
}

// One row per shape a group prefix can arrive in. The root group — the exact
// spelling `app.group("/")` — is the case #4482 was filed for: a prefix of
// "/" and a prefix of "" name the same place, so joining either with "/save"
// must give "/save". The trailing-slash rows are reachable rather than
// hypothetical (`app.group("/pages/")` stores the slash), and `router.bit`'s
// `splitSegments` makes a trailing slash significant, so a doubled or a
// leaked slash is a genuinely different, unreachable pattern.
class JoinCase {
  prefix: string,
  path: string,
  want: string,
}

test "joinPath: a root prefix is the identity, and no join doubles a slash" {
  let cases = []JoinCase{
    JoinCase{ prefix: "", path: "/", want: "/" },
    JoinCase{ prefix: "", path: "/pages", want: "/pages" },
    JoinCase{ prefix: "/pages", path: "/save", want: "/pages/save" },
    JoinCase{ prefix: "/pages", path: "save", want: "/pages/save" },
    JoinCase{ prefix: "/pages", path: "/", want: "/pages" },
    JoinCase{ prefix: "/", path: "/save", want: "/save" },
    JoinCase{ prefix: "/", path: "/", want: "/" },
    JoinCase{ prefix: "/pages/", path: "/save", want: "/pages/save" },
  }
  for c of cases {
    let got = joinPath(c.prefix, c.path)
    assert(
      got == c.want,
      "joinPath('${c.prefix}', '${c.path}') = '${got}', want '${c.want}'",
    )
  }
}

test "a route registered on the root group is reachable at its own path" {
  let app = testApp()
  let pages = app.group("/")
  let r = pages.post("/save", okHandler)
  assert(
    r.pattern == "/save",
    "registered pattern: got '${r.pattern}', want '/save'",
  )

  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }

  app.root.router.lookup("POST", "/save") catch e {
    panic("expected POST /save to be registered: ${e.message()}")
  }
}

// --- route(): the methods the four verb helpers cannot reach ---------------

// The `OPTIONS` case is the one #3955 needs: a preflight is an `OPTIONS`
// request, a middleware runs only for a MATCHED route, and `Router.lookup`
// matches the method by exact string equality — so with no way to register
// `OPTIONS`, `cors()`'s preflight branch was unreachable for every app
// outside this module. This registers it the way an app does and drives it
// through `handle()`, the served path.
test "route() registers OPTIONS and handle() answers it, not a 405" {
  let app = testApp()
  app.route("OPTIONS", "/data", (c) => {
    return c.text("options ran").status(204)
  })
  freezeOrPanic(app)

  let res = app.handle(req("OPTIONS", "/data"))

  assert(res.status == 204, "want the OPTIONS handler's 204, got ${res.status}")
}

// Every method the allowlist accepts, registered on its own path and reached
// through `handle()`. A row here failing means `register` rejected a method
// the framework claims to support; a row MISSING means the list and this test
// have drifted, which is why `knownMethods()` is asserted against it below.
test "route() accepts every method in knownMethods(), and each is reachable" {
  let app = testApp()
  for m of knownMethods() {
    app.route(m, "/m/${m}", okHandler)
  }
  freezeOrPanic(app)

  for m of knownMethods() {
    let res = app.handle(req(m, "/m/${m}"))
    assert(res.status == 200, "${m} /m/${m}: want 200, got ${res.status}")
  }
}

test "knownMethods() is exactly RFC 9110 §9.3 minus CONNECT and TRACE" {
  let got = join(knownMethods(), " ")
  assert(
    got == "GET HEAD POST PUT PATCH DELETE OPTIONS",
    "the registrable method list changed: got '${got}'",
  )
}

// A method outside the list registers a route no request can ever match,
// because `Router.lookup` compares the method byte for byte. Panicking here
// turns a silent permanent 404 into a startup failure.
test "testpanic_route_unknown_method" {
  let app = testApp()
  app.route("GTE", "/typo", okHandler)
}

// Case matters: HTTP methods are case-sensitive tokens (RFC 9110 §9.1), and
// `"Get"` is not `"GET"`.
test "testpanic_route_wrong_case_method" {
  let app = testApp()
  app.route("Get", "/typo", okHandler)
}

test "testpanic_route_empty_method" {
  let app = testApp()
  app.route("", "/typo", okHandler)
}

// `App.missHandler` (app.bit) is the app-root chain composed around the
// framework's own 404/405 (#4515). It is composed in `init` as well as in
// `freeze()`, and this is what that buys: `handle()` on an app that was never
// frozen answers, instead of calling a `nil` function value.
//
// The 404 is the right answer rather than a lucky one — `Router.lookup`
// refuses before `freeze()` ("router: lookup() called before freeze()",
// router.bit:226), which reaches `missResponse` exactly as a real miss does.
test "handle() on an app that was never frozen answers 404 rather than calling nil" {
  let app = adapterApp(newSink())
  app.get("/known", okHandler)

  let res = app.handle(req("GET", "/known"))

  assert(res.status == 404, "want 404, got ${res.status}")
  assert(res.body == "Not Found", "want the framework's own body, got '${res.body}'")
}
