// pkg/web/realtimetls.test.bit — #6152: WebSocket/SSE/Stream hijack over
// TLS+HTTP/1.1. `webTlsPem`/`webTlsLeafHex`/`webTlsKeyHex`/`clientCfg`
// (servetls.test.bit) and `contains` (router.test.bit) are `.test.bit`-only
// module siblings (SPEC §17.2). `dial` (std/net) is already bound
// module-wide (adapterhead.test.bit) — `std/tls`'s own `dial` needs an
// alias to avoid E0042.
import { dial as tlsRawDial, listen as wsTlsListen, TlsListener, TlsServerConfig } from "std/tls"
import { acceptKey as wsAcceptKey } from "std/websocket"

fn tlsMixedApp(): App {
  let app = App(
    Config{
      secret = "test-secret",
      port = 0,
      certPem = webTlsPem("CERTIFICATE", webTlsLeafHex),
      keyPem = webTlsPem("PRIVATE KEY", webTlsKeyHex),
    },
  )
  app.get("/plain", (c) => c.text("ok"))
  app.get("/ws/echo", (c) => {
    let conn = wsUpgrade(c, wsDefaultLimits()) catch _ {
      return c.status(400)
    }
    let msg = conn.receive() catch _ {
      return c.noContent()
    }
    conn.sendText(msg.data) catch _ {}
    return c.noContent()
  }).hijackable()
  app.get("/events", (c) => {
    let sse = SSE(c) catch _ {
      return c.status(500)
    }
    sse.send("greeting", "hello") catch _ {}
    sse.close() catch _ {}
    return c.noContent()
  }).hijackable()
  return app
}

// Reads until `conn` closes (the ordinary end of a `Connection: close`
// response) or the loop bound is hit — the TLS mirror of
// `realtime.test.bit`'s own wire-reading tests, over a raw `TlsConn`
// instead of a plain one.
fn tlsReadAll(conn: TlsConn): string {
  let out = ""
  let n = 0
  while (n < 1000) {
    let piece = string(conn.read(65536) catch "")
    if (len(piece) == 0) {
      return out
    }
    out = out + piece
    n = n + 1
  }
  return out
}

test "an SSE stream over TLS+HTTP/1.1 is delivered as framed text/event-stream chunks" {
  let app = tlsMixedApp()
  let ts = app.serveTls() catch e {
    assert(false, "serveTls: ${e.message()}")
    return
  }
  let port = ts.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let conn = tlsRawDial("127.0.0.1", port, clientCfg(["http/1.1"])) catch e {
    ts.shutdown(2000) catch _ {}
    assert(false, "tlsRawDial: ${e.message()}")
    return
  }
  conn.write([]byte("GET /events HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) catch e {
    conn.close()
    ts.shutdown(2000) catch _ {}
    assert(false, "write: ${e.message()}")
    return
  }
  let wire = tlsReadAll(conn)
  conn.close()
  ts.shutdown(2000) catch _ {}

  assert(
    contains(wire, "Content-Type: text/event-stream"),
    "want the SSE Content-Type, got:\n${wire}",
  )
  assert(contains(wire, "Transfer-Encoding: chunked"), "want chunked framing, got:\n${wire}")
  assert(
    contains(wire, "event: greeting\ndata: hello\n\n"),
    "want the named event framed as one event/data pair, got:\n${wire}",
  )
}

test "a mixed app over TLS keeps an ordinary route's connection open for a second request" {
  let app = tlsMixedApp()
  let ts = app.serveTls() catch e {
    assert(false, "serveTls: ${e.message()}")
    return
  }
  let port = ts.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let conn = tlsRawDial("127.0.0.1", port, clientCfg(["http/1.1"])) catch e {
    ts.shutdown(2000) catch _ {}
    assert(false, "tlsRawDial: ${e.message()}")
    return
  }
  conn.write([]byte("GET /plain HTTP/1.1\r\nHost: x\r\n\r\n")) catch e {
    conn.close()
    ts.shutdown(2000) catch _ {}
    assert(false, "write 1: ${e.message()}")
    return
  }
  let first = string(
    conn.read(4096) catch e {
      conn.close()
      ts.shutdown(2000) catch _ {}
      assert(false, "read 1: ${e.message()}")
      return
    },
  )
  assert(
    contains(first, "connection: close") == false,
    "response 1 carried Connection: close:\n${first}",
  )

  // The SAME TLS connection, a second ordinary request.
  conn.write([]byte("GET /plain HTTP/1.1\r\nHost: x\r\n\r\n")) catch e {
    conn.close()
    ts.shutdown(2000) catch _ {}
    assert(false, "write 2: ${e.message()}")
    return
  }
  let second = string(
    conn.read(4096) catch e {
      conn.close()
      ts.shutdown(2000) catch _ {}
      assert(false, "read 2: ${e.message()}")
      return
    },
  )
  assert(contains(second, "200"), "response 2 was not a 200:\n${second}")

  conn.close()
  ts.shutdown(2000) catch _ {}
}

test "WebSocket dial authenticates TLS and echoes both ways" {
  let cfg = verifiedWebSocketConfig() catch e {
    assert(false, e.message())
    return
  }
  cfg.alpn = ["h2"]
  let ts = tlsMixedApp().serveTls() catch e {
    assert(false, e.message())
    return
  }
  let port = ts.port() catch e {
    ts.shutdown(2000) catch _ {}
    assert(false, e.message())
    return
  }
  let conn = wsDial("wss://127.0.0.1:${port}/ws/echo", config = Option.Some(cfg)) catch e {
    ts.shutdown(2000) catch _ {}
    assert(false, e.message())
    return
  }
  conn.sendText("hi") catch e {
    conn.close(1000, "") catch _ {}
    ts.shutdown(2000) catch _ {}
    assert(false, e.message())
    return
  }
  let echoed = conn.receive() catch e {
    conn.close(1000, "") catch _ {}
    ts.shutdown(2000) catch _ {}
    assert(false, e.message())
    return
  }
  conn.close(1000, "") catch e {
    assert(false, e.message())
  }
  ts.shutdown(2000) catch e {
    assert(false, e.message())
  }
  assert(echoed.kind == MessageText && echoed.data == "hi", "authenticated echo")
  assert(cfg.alpn[0] == "h2", "dial must not mutate caller ALPN")
}

fn rejectedWebSocketTls(cfg: TlsConfig, needle: string) {
  let ts = tlsMixedApp().serveTls() catch e {
    assert(false, e.message())
    return
  }
  let port = ts.port() catch e {
    ts.shutdown(2000) catch _ {}
    assert(false, e.message())
    return
  }
  let conn = wsDial("wss://127.0.0.1:${port}/ws/echo", config = Option.Some(cfg)) catch e {
    let message = e.message()
    ts.shutdown(2000) catch cleanupError {
      assert(false, cleanupError.message())
    }
    assert(contains(message, needle), message)
    return
  }
  conn.close(1000, "") catch _ {}
  ts.shutdown(2000) catch _ {}
  assert(false, "untrusted TLS accepted")
}

test "WebSocket dial rejects an empty trust store and wrong server name" {
  let empty = TlsConfig(emptyTrustStore(), serverName = "localhost", nowUnix = 1800000000)
  rejectedWebSocketTls(empty, "trusted root")
  let wrong = verifiedWebSocketConfig() catch e {
    assert(false, e.message())
    return
  }
  wrong.serverName = "wrong.example"
  rejectedWebSocketTls(wrong, "hostname")
}

fn serveWebSocketWithoutAlpn(listener: TlsListener) {
  let c = listener.accept() catch _ {
    return
  }
  let request = readWebSocketTlsRequest(c) catch _ {
    c.close()
    return
  }
  assert(c.alpnProtocol() == "", "server must omit ALPN")
  let key = wsAcceptKey(rawHeader(request, "Sec-WebSocket-Key"))
  c.write(
    []byte(
        "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\n" +
        "Connection: Upgrade\r\nSec-WebSocket-Accept: ${key}\r\n\r\n\x88\x02\x03\xe8",
    ),
  ) catch _ {}
  c.close()
}

fn readWebSocketTlsRequest(c: TlsConn): string! {
  let request = ""
  while (len(request) <= 65536) {
    let part = string(c.read(4096)?)
    if (part == "") {
      fail newError("EOF in test handshake")
    }
    request = request + part
    if (indexOf(request, "\r\n\r\n") >= 0) {
      return request
    }
  }
  fail newError("test handshake too large")
}

test "WebSocket dial accepts a TLS server that omits ALPN" {
  let serverCfg = TlsServerConfig(
    webTlsPem("CERTIFICATE", webTlsLeafHex),
    webTlsPem("PRIVATE KEY", webTlsKeyHex), []string(0),
  ) catch e {
    assert(false, e.message())
    return
  }
  let cfg = verifiedWebSocketConfig() catch e {
    assert(false, e.message())
    return
  }
  let listener = wsTlsListen("127.0.0.1", 0, serverCfg) catch e {
    assert(false, e.message())
    return
  }
  let port = listener.port() catch e {
    listener.close()
    assert(false, e.message())
    return
  }
  spawn serveWebSocketWithoutAlpn(listener)
  let c = wsDial("wss://127.0.0.1:${port}/notes", config = Option.Some(cfg)) catch e {
    listener.close()
    assert(false, e.message())
    return
  }
  let closed = c.receive() catch e {
    c.close(1000, "") catch _ {}
    listener.close()
    assert(false, e.message())
    return
  }
  c.close(1000, "") catch e {
    assert(false, e.message())
  }
  listener.close()
  assert(closed.kind == MessageClose && closed.code == 1000, "peer close over TLS without ALPN")
}
