// pkg/web/realtimetls.test.bit — #6152: WebSocket/SSE/Stream hijack over
// TLS+HTTP/1.1. `webTlsPem`/`webTlsLeafHex`/`webTlsKeyHex`/`clientCfg`
// (servetls.test.bit) and `contains` (router.test.bit) are `.test.bit`-only
// module siblings (SPEC §17.2). `dial` (std/net) is already bound
// module-wide (adapterhead.test.bit) — `std/tls`'s own `dial` needs an
// alias to avoid E0042.
import { dial as tlsRawDial } from "std/tls"
import { encodeBase64 } from "std/crypto"

fn tlsMixedApp(): App {
  let app = App(
    Config{
      secret = "test-secret",
      certPem = webTlsPem("CERTIFICATE", webTlsLeafHex),
      keyPem = webTlsPem("PRIVATE KEY", webTlsKeyHex),
    },
  )
  app.get("/plain", (c) => c.text("ok"))
  app.get("/ws/echo", (c) => {
    let conn = wsUpgrade(c, wsDefaultLimits()) catch _ {
      return c.status(400)
    }
    let msg = conn.receive() catch _ {
      return c.noContent()
    }
    conn.sendText(msg.data) catch _ {}
    return c.noContent()
  }).hijackable()
  app.get("/events", (c) => {
    let sse = newSSE(c) catch _ {
      return c.status(500)
    }
    sse.send("greeting", "hello") catch _ {}
    sse.close() catch _ {}
    return c.noContent()
  }).hijackable()
  return app
}

// Reads until `conn` closes (the ordinary end of a `Connection: close`
// response) or the loop bound is hit — the TLS mirror of
// `realtime.test.bit`'s own wire-reading tests, over a raw `TlsConn`
// instead of a plain one.
fn tlsReadAll(conn: TlsConn): string {
  let out = ""
  let n = 0
  while (n < 1000) {
    let piece = string(conn.read(65536) catch "")
    if (len(piece) == 0) {
      return out
    }
    out = out + piece
    n = n + 1
  }
  return out
}

test "an SSE stream over TLS+HTTP/1.1 is delivered as framed text/event-stream chunks" {
  let app = tlsMixedApp()
  let ts = app.serveTls() catch e {
    assert(false, "serveTls: ${e.message()}")
    return
  }
  let port = ts.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let conn = tlsRawDial("127.0.0.1", port, clientCfg(["http/1.1"])) catch e {
    ts.shutdown(2000) catch _ {}
    assert(false, "tlsRawDial: ${e.message()}")
    return
  }
  conn.write([]byte("GET /events HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")) catch e {
    conn.close()
    ts.shutdown(2000) catch _ {}
    assert(false, "write: ${e.message()}")
    return
  }
  let wire = tlsReadAll(conn)
  conn.close()
  ts.shutdown(2000) catch _ {}

  assert(
    contains(wire, "Content-Type: text/event-stream"),
    "want the SSE Content-Type, got:\n${wire}",
  )
  assert(contains(wire, "Transfer-Encoding: chunked"), "want chunked framing, got:\n${wire}")
  assert(
    contains(wire, "event: greeting\ndata: hello\n\n"),
    "want the named event framed as one event/data pair, got:\n${wire}",
  )
}

test "a mixed app over TLS keeps an ordinary route's connection open for a second request" {
  let app = tlsMixedApp()
  let ts = app.serveTls() catch e {
    assert(false, "serveTls: ${e.message()}")
    return
  }
  let port = ts.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let conn = tlsRawDial("127.0.0.1", port, clientCfg(["http/1.1"])) catch e {
    ts.shutdown(2000) catch _ {}
    assert(false, "tlsRawDial: ${e.message()}")
    return
  }
  conn.write([]byte("GET /plain HTTP/1.1\r\nHost: x\r\n\r\n")) catch e {
    conn.close()
    ts.shutdown(2000) catch _ {}
    assert(false, "write 1: ${e.message()}")
    return
  }
  let first = string(
    conn.read(4096) catch e {
      conn.close()
      ts.shutdown(2000) catch _ {}
      assert(false, "read 1: ${e.message()}")
      return
    },
  )
  assert(
    contains(first, "connection: close") == false,
    "response 1 carried Connection: close:\n${first}",
  )

  // The SAME TLS connection, a second ordinary request.
  conn.write([]byte("GET /plain HTTP/1.1\r\nHost: x\r\n\r\n")) catch e {
    conn.close()
    ts.shutdown(2000) catch _ {}
    assert(false, "write 2: ${e.message()}")
    return
  }
  let second = string(
    conn.read(4096) catch e {
      conn.close()
      ts.shutdown(2000) catch _ {}
      assert(false, "read 2: ${e.message()}")
      return
    },
  )
  assert(contains(second, "200"), "response 2 was not a 200:\n${second}")

  conn.close()
  ts.shutdown(2000) catch _ {}
}

// #6172: a WebSocket over TLS+HTTP/1.1, driven by hand (`std/websocket`'s
// own client `dial` does not support `wss://` yet — a separate gap, this
// test's own header comment) rather than a WS client library: the RFC 6455
// handshake request/response, then one masked client text frame (§5.2) with
// an all-zero mask key so the masked bytes equal the payload unchanged (a
// zero mask is a valid mask, just not one a real client would pick), echoed
// back unmasked by the server per this app's own `/ws/echo` route
// (`tlsMixedApp`, above).
test "a WebSocket handshake and echo work end to end over TLS+HTTP/1.1" {
  let app = tlsMixedApp()
  let ts = app.serveTls() catch e {
    assert(false, "serveTls: ${e.message()}")
    return
  }
  let port = ts.port() catch e {
    assert(false, "port: ${e.message()}")
    return
  }
  let conn = tlsRawDial("127.0.0.1", port, clientCfg(["http/1.1"])) catch e {
    ts.shutdown(2000) catch _ {}
    assert(false, "tlsRawDial: ${e.message()}")
    return
  }
  let key = encodeBase64([]byte("0123456789abcdef"))
  conn.write(
    []byte(
        "GET /ws/echo HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\n" +
        "Connection: Upgrade\r\nSec-WebSocket-Key: ${key}\r\n" +
        "Sec-WebSocket-Version: 13\r\n\r\n",
    ),
  ) catch e {
    conn.close()
    ts.shutdown(2000) catch _ {}
    assert(false, "write handshake: ${e.message()}")
    return
  }
  let resp = string(
    conn.read(4096) catch e {
      conn.close()
      ts.shutdown(2000) catch _ {}
      assert(false, "read handshake response: ${e.message()}")
      return
    },
  )
  assert(contains(resp, "101"), "want a 101 Switching Protocols, got:\n${resp}")
  assert(contains(resp, "Upgrade: websocket"), "want Upgrade: websocket, got:\n${resp}")

  conn.write([]byte("\x81\x82\x00\x00\x00\x00hi")) catch e {
    conn.close()
    ts.shutdown(2000) catch _ {}
    assert(false, "write frame: ${e.message()}")
    return
  }
  let echoed = string(
    conn.read(64) catch e {
      conn.close()
      ts.shutdown(2000) catch _ {}
      assert(false, "read frame: ${e.message()}")
      return
    },
  )
  conn.close()
  ts.shutdown(2000) catch _ {}
  assert(
    echoed == "\x81\x02hi",
    "want the server's unmasked echo frame, got ${len(echoed)} byte(s)",
  )
}
