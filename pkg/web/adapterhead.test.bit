// pkg/web/adapterhead.test.bit — every assertion about what the adapter does
// to a HEAD, split out of adapter.test.bit when that file reached the 800-line
// ceiling (spec/LINT.md E0200). A sibling file of the same directory module,
// so `adapterApp`, `newSink`, `req` and `freezeOrPanic` (adapter.test.bit) and
// `contains` (router.test.bit) are bound module-wide already and re-declaring
// or re-importing any of them here is E0042.
//
// Two rules meet here. RFC 9110 §9.3.2 — HEAD is identical to GET except that
// the response carries no content — is answered in two places: `unmatched`
// falls back to the GET route when nothing is registered for HEAD, and
// `dispatch` drops the content of EVERY HEAD response at the adapter's single
// exit, whether it came from a registered HEAD route or from that fallback.

// --- HEAD served from the GET route (RFC 9110 §9.3.2) ----------------------

const headBody = "twelve bytes"

// A GET route that answers with a body and one header of its own, so the HEAD
// assertions can name what a GET would have sent instead of asserting a shape.
fn headFixtureApp(): App {
  let app = adapterApp(newSink())
  app.get(
    "/doc",
    (c) => {
      return c.text(headBody).header("X-Marker", "get")
    },
  )
  return app
}

test "HEAD on a GET-only path runs the GET handler and returns its status and headers" {
  let app = headFixtureApp()
  freezeOrPanic(app)

  let res = app.handle(req("HEAD", "/doc"))

  assert(res.status == 200, "want the GET handler's 200, got ${res.status}")
  assert(
    res.getHeader("X-Marker") == "get",
    "want the GET handler's own header, got '${res.getHeader("X-Marker")}'",
  )
  assert(
    res.contentType == "text/plain; charset=utf-8",
    "want the GET handler's Content-Type, got '${res.contentType}'",
  )
}

// The two halves RFC 9110 §9.3.2 names: no content, and the length the GET
// would have sent. `Content-Length: 0` here would tell a client the resource
// is empty, which is the failure this assertion exists to catch.
test "HEAD on a GET-only path carries no body and the GET body's Content-Length" {
  let app = headFixtureApp()
  freezeOrPanic(app)

  let res = app.handle(req("HEAD", "/doc"))

  assert(res.body == "", "a HEAD response carries no content, got '${res.body}'")
  assert(
    res.getHeader("Content-Length") == "12",
    "want the GET body's length 12, got '${res.getHeader("Content-Length")}'",
  )
}

// The fallback is reached only after the lookup for the request's OWN method
// failed, so a registered HEAD route is never displaced by it. Distinguished
// by status, not by body: both answers have an empty body.
test "a registered HEAD route wins over the GET fallback" {
  let app = headFixtureApp()
  app.route(
    "HEAD",
    "/doc",
    (c) => {
      return c.status(204).header("X-Marker", "head")
    },
  )
  freezeOrPanic(app)

  let res = app.handle(req("HEAD", "/doc"))

  assert(res.status == 204, "want the registered HEAD route's 204, got ${res.status}")
  assert(
    res.getHeader("X-Marker") == "head",
    "want the HEAD route's own header, got '${res.getHeader("X-Marker")}'",
  )
  assert(
    len(res.getHeader("Content-Length")) == 0,
    "a registered HEAD route owns its own framing, got '${res.getHeader("Content-Length")}'",
  )
}

// #4536: RFC 9110 §9.3.2 — "the server MUST NOT send content in the
// response" — binds a REGISTERED HEAD route exactly as it binds the GET
// fallback. The strip is at `dispatch`, the adapter's one exit, which is why
// the handler's own status and headers come back untouched. No
// `Content-Length` is derived from what was dropped: a handler answering HEAD
// knows the representation's real length and the adapter does not
// (static.bit's HEAD branch is the live case).
test "a registered HEAD route sends no content, with its status and headers intact" {
  let app = adapterApp(newSink())
  app.route(
    "HEAD",
    "/doc",
    (c) => {
      return c.text("body bytes").status(203).header("X-Marker", "head")
    },
  )
  freezeOrPanic(app)

  let res = app.handle(req("HEAD", "/doc"))

  assert(res.body == "", "a HEAD response carries no content, got '${res.body}'")
  assert(res.status == 203, "want the handler's own 203, got ${res.status}")
  assert(
    res.getHeader("X-Marker") == "head",
    "want the handler's own header, got '${res.getHeader("X-Marker")}'",
  )
  assert(
    len(res.getHeader(contentLengthName)) == 0,
    "no length may be derived from the stripped body, got '${res.getHeader(contentLengthName)}'",
  )
}

// The fallback must not invent a match. A path that exists only under POST is
// still a 405, and `Allow` still lists what is really registered — not GET,
// and not HEAD.
test "HEAD on a path registered only for POST is still a 405 listing POST" {
  let app = adapterApp(newSink())
  app.post("/submit", okHandler)
  freezeOrPanic(app)

  let res = app.handle(req("HEAD", "/submit"))

  assert(res.status == 405, "want 405, got ${res.status}")
  assert(res.getHeader("Allow") == "POST", "want 'Allow: POST', got '${res.getHeader("Allow")}'")
}

test "HEAD on a path that is not registered at all is a 404" {
  let app = headFixtureApp()
  freezeOrPanic(app)

  let res = app.handle(req("HEAD", "/nothing"))

  assert(res.status == 404, "want 404, got ${res.status}")
}

// A chain that already answered the HEAD itself (static.bit does: it skips
// the file read and returns an empty body) knows the representation's real
// length and this fallback does not. Claiming `Content-Length: 0` there would
// be a wrong answer rather than a missing one, so no claim is made.
test "the fallback makes no Content-Length claim when the chain produced no body" {
  let app = adapterApp(newSink())
  app.get(
    "/empty",
    (c) => {
      return c.status(200)
    },
  )
  freezeOrPanic(app)

  let res = app.handle(req("HEAD", "/empty"))

  assert(res.status == 200, "want 200, got ${res.status}")
  assert(
    len(res.getHeader("Content-Length")) == 0,
    "want no Content-Length, got '${res.getHeader("Content-Length")}'",
  )
}
