// pkg/web/body.test.bit — #3877's acceptance, one named test per assertion.
//
// Everything goes through `app.handle(req)` (adapter.bit), the seam #3885
// established: the real router, the real chain, the real `Ctx` construction and
// the real failure mapping, with only the socket left out. A test that called
// `bindJson` directly would pass just as well against a 400 that never reaches
// a response — the statuses ARE the acceptance here, so the status has to come
// off a real response.
//
// `contains` (router.test.bit), `jsonParse`/`jsonAsInt`/`jsonAsString`
// (errors.test.bit), `jsonGet` (res.test.bit), `Request` (ctx.bit),
// `isSome`/`unwrap` (ctx.bit), `jsonEncode` (escape.bit) and `freezeOrPanic`
// (adapter.test.bit) are already bound module-wide — reused, not re-imported
// (E0042). `jsonDecode` is new to the module.
//
// It is imported HERE, in a test file, and not by body.bit, which never names
// it: the type argument has to be a concrete `@json` class at the call site
// (#4563, body.bit's header), so every `jsonDecode<T>` in this package is in
// the position an APPLICATION writes it — which is what makes these tests
// exercise the shape a reader of README.md will type.

import { jsonDecode } from "std/json"

// --- the types a route declares --------------------------------------------

// THE INPUT TYPE. It has no `id` and no `isAdmin`, so no payload can reach
// either — under `Reject` or `Ignore`. This is the pattern README.md leads
// with, and the one the tests below are built on.
@json class NewUser {
  name: string,
  email: string,
}

// THE ENTITY, standing in for the class that reaches a database. Binding a
// payload straight into this is the mass-assignment trap #3877 exists to
// close, and the test named for it drives exactly that route.
@json class UserRow {
  name: string,
  email: string,
  isAdmin: bool,
}

@json class Addr {
  city: string,
  zip: i64,
}

// Two levels deep, for the dotted-path assertions.
@json class Profile {
  name: string,
  addr: Addr,
}

// An array of objects, for the path an unknown key takes through an index.
@json class Trip {
  stops: []Addr,
}

// --- fixtures ---------------------------------------------------------------

fn createUser(c: Ctx): Res! {
  let input = c.body((j) => jsonDecode<NewUser>(j))?
  return c.json(input)
}

fn createUserLoose(c: Ctx): Res! {
  let input = c.bodyWith(Bind{ unknown: Unknown.Ignore }, (j) => jsonDecode<NewUser>(j))?
  return c.json(input)
}

// `Bind{}` with the field omitted — the assertion that the zero value of an
// `Unknown` field is `Reject` and not `Ignore`.
fn createUserBareBind(c: Ctx): Res! {
  let input = c.bodyWith(Bind{}, (j) => jsonDecode<NewUser>(j))?
  return c.json(input)
}

fn createEntity(c: Ctx): Res! {
  let u = c.body((j) => jsonDecode<UserRow>(j))?
  return c.json(u)
}

fn createProfile(c: Ctx): Res! {
  let p = c.body((j) => jsonDecode<Profile>(j))?
  return c.json(p)
}

fn createProfileLoose(c: Ctx): Res! {
  let p = c.bodyWith(Bind{ unknown: Unknown.Ignore }, (j) => jsonDecode<Profile>(j))?
  return c.json(p)
}

fn createTripLoose(c: Ctx): Res! {
  let t = c.bodyWith(Bind{ unknown: Unknown.Ignore }, (j) => jsonDecode<Trip>(j))?
  return c.json(t)
}

fn echoRawBody(c: Ctx): Res! {
  return c.text(c.rawBody()?)
}

fn echoBodyTree(c: Ctx): Res! {
  let j = c.bodyJson()?
  return c.text(jsonEncode(j))
}

// One app, every route, frozen — so a test differs from its neighbour only in
// the request it sends.
fn bodyApp(cfg: Config): App {
  let app = App(cfg)
  app.post("/users", createUser)
  app.post("/users/loose", createUserLoose)
  app.post("/users/bare", createUserBareBind)
  app.post("/entities", createEntity)
  app.post("/profiles", createProfile)
  app.post("/profiles/loose", createProfileLoose)
  app.post("/trips/loose", createTripLoose)
  app.post("/raw", echoRawBody)
  app.post("/tree", echoBodyTree)
  freezeOrPanic(app)
  return app
}

fn defaultBodyApp(): App {
  return bodyApp(Config{ secret: "test-secret" })
}

// A POST declaring `application/json`.
fn jsonPost(target: string, payload: string): Request {
  return Request{
    method: "POST",
    path: target,
    headers: "Content-Type: application/json",
    body: payload,
  }
}

// A POST declaring whatever `ct` says; `ct` of "" sends no `Content-Type` at
// all, which is its own case.
fn typedPost(target: string, ct: string, payload: string): Request {
  let headers = "Content-Type: ${ct}"
  if (len(ct) == 0) {
    headers = ""
  }
  return Request{ method: "POST", path: target, headers: headers, body: payload }
}

// The string value of top-level key `key` in a JSON document, or a marker
// naming what went wrong instead — so a failing assertion prints why rather
// than an empty string that could mean three different things.
fn stringField(doc: string, key: string): string {
  let j = jsonParse(doc) catch e {
    return "<unparsable: ${e.message()}>"
  }
  let v = jsonGet(j, key)
  if (!isSome(v)) {
    return "<absent>"
  }
  let s = jsonAsString(unwrap(v))
  if (!isSome(s)) {
    return "<not a string>"
  }
  return unwrap(s)
}

// The `error` field of one of this framework's JSON error bodies
// (`errorJson`, errors.bit) — the message the client is allowed to read.
fn errorText(res: Response): string {
  return stringField(res.body, "error")
}

// A body of `n` bytes that is also a well-formed JSON object, so a size test
// is testing the size and not the shape.
fn paddedPayload(n: int): string {
  let pad = repeat("x", n)
  return "{\"name\":\"${pad}\",\"email\":\"b\"}"
}

// --- the happy path ---------------------------------------------------------

test "a payload binds into the declared type and every field matches" {
  let res = defaultBodyApp().handle(jsonPost("/users", "{\"name\":\"Ali\",\"email\":\"a@b.c\"}"))

  assert(res.status == 200, "want 200, got ${res.status}: '${res.body}'")
  assert(stringField(res.body, "name") == "Ali", "name: got '${stringField(res.body, "name")}'")
  assert(
    stringField(res.body, "email") == "a@b.c",
    "email: got '${stringField(res.body, "email")}'",
  )
}

// --- the trap ---------------------------------------------------------------

test "an unknown field is a 400 naming it under the default policy" {
  let payload = "{\"name\":\"Ali\",\"email\":\"a@b.c\",\"isAdmin\":true}"
  let res = defaultBodyApp().handle(jsonPost("/users", payload))

  assert(res.status == 400, "want 400, got ${res.status}: '${res.body}'")
  assert(
    contains(errorText(res), "isAdmin"),
    "the 400 must name the offending field, got '${errorText(res)}'",
  )
}

// The rule the ticket states in one line: a dropped field and an accepted
// field are indistinguishable to whoever sent it, so the default drops
// nothing silently. This asserts the OTHER half of the same fact — the
// rejection is total, no part of the payload was applied.
test "a rejected unknown field yields no body of its own, not a partial bind" {
  let payload = "{\"name\":\"Ali\",\"email\":\"a@b.c\",\"isAdmin\":true}"
  let res = defaultBodyApp().handle(jsonPost("/users", payload))

  assert(res.status == 400, "want 400, got ${res.status}")
  assert(
    stringField(res.body, "name") == "<absent>",
    "a refused bind must not echo the bound value, got '${res.body}'",
  )
}

test "an unknown field is ignored under Bind{ unknown: Ignore } and leaves no trace" {
  let payload = "{\"name\":\"Ali\",\"email\":\"a@b.c\",\"isAdmin\":true}"
  let res = defaultBodyApp().handle(jsonPost("/users/loose", payload))

  assert(res.status == 200, "want 200, got ${res.status}: '${res.body}'")
  assert(stringField(res.body, "name") == "Ali", "name: got '${res.body}'")
  assert(stringField(res.body, "email") == "a@b.c", "email: got '${res.body}'")
  assert(
    !contains(res.body, "isAdmin"),
    "the ignored field must leave no trace on the bound value, got '${res.body}'",
  )
}

// THE SECOND LAYER IS NOT THE PROTECTION, and this is the test that says so.
// The same payload that is refused into `NewUser` is ACCEPTED into `User`,
// which has the field — under the strict default, because rejecting unknown
// fields cannot help when the field is known. Only the input type does.
test "the strict default does not stop mass assignment into a type that has the field" {
  let payload = "{\"name\":\"Ali\",\"email\":\"a@b.c\",\"isAdmin\":true}"
  let app = defaultBodyApp()

  let entity = app.handle(jsonPost("/entities", payload))
  assert(entity.status == 200, "binding into the entity succeeds: got ${entity.status}")
  assert(
    contains(entity.body, "\"isAdmin\":true"),
    "the client set isAdmin on the entity, which is the trap: '${entity.body}'",
  )

  let input = app.handle(jsonPost("/users", payload))
  assert(input.status == 400, "the input type refuses the same payload: got ${input.status}")
}

test "Bind{} with the field omitted rejects, so an omitted policy is the safe one" {
  let payload = "{\"name\":\"Ali\",\"email\":\"a@b.c\",\"isAdmin\":true}"
  let res = defaultBodyApp().handle(jsonPost("/users/bare", payload))

  assert(res.status == 400, "an omitted Unknown field must mean Reject, got ${res.status}")
}

test "the app-level policy decides when no Bind is given" {
  let loose = bodyApp(Config{ secret: "s", rejectUnknownFields: false })
  let payload = "{\"name\":\"Ali\",\"email\":\"a@b.c\",\"isAdmin\":true}"

  let res = loose.handle(jsonPost("/users", payload))
  assert(
    res.status == 200,
    "rejectUnknownFields: false must ignore, got ${res.status}: '${res.body}'",
  )
  assert(!contains(res.body, "isAdmin"), "still no trace of the ignored field: '${res.body}'")

  let strict = defaultBodyApp().handle(jsonPost("/users", payload))
  assert(strict.status == 400, "the default app rejects the same payload, got ${strict.status}")
}

// --- the four distinct 400s -------------------------------------------------

test "a missing required field is a 400 naming the field" {
  let res = defaultBodyApp().handle(jsonPost("/users", "{\"name\":\"Ali\"}"))

  assert(res.status == 400, "want 400, got ${res.status}: '${res.body}'")
  assert(contains(errorText(res), "email"), "must name the missing field, got '${errorText(res)}'")
  assert(contains(errorText(res), "missing"), "must say what is wrong, got '${errorText(res)}'")
}

test "a type mismatch is a 400 naming the field and both types" {
  let res = defaultBodyApp().handle(
    jsonPost("/profiles", "{\"name\":42,\"addr\":{\"city\":\"c\",\"zip\":1}}"),
  )

  assert(res.status == 400, "want 400, got ${res.status}: '${res.body}'")
  let msg = errorText(res)
  assert(contains(msg, "name"), "must name the field, got '${msg}'")
  assert(contains(msg, "a string"), "must name the expected type, got '${msg}'")
  assert(contains(msg, "a number"), "must name what was found, got '${msg}'")
}

test "malformed JSON is a 400 carrying the parser's own complaint" {
  let res = defaultBodyApp().handle(jsonPost("/users", "{\"name\":"))

  assert(res.status == 400, "want 400, got ${res.status}: '${res.body}'")
  assert(
    contains(errorText(res), "not valid JSON"),
    "must say the body did not parse, got '${errorText(res)}'",
  )
}

// The ticket's own words: a single "invalid body" is not acceptable, because
// the caller cannot act on it. Four failures, four different sentences.
test "the four client-error causes produce four distinct messages" {
  let app = defaultBodyApp()
  let unknown = errorText(app.handle(jsonPost("/users", "{\"name\":\"a\",\"email\":\"b\",\"x\":1}")))
  let missing = errorText(app.handle(jsonPost("/users", "{\"name\":\"a\"}")))
  let mismatch = errorText(app.handle(jsonPost("/users", "{\"name\":1,\"email\":\"b\"}")))
  let malformed = errorText(app.handle(jsonPost("/users", "{")))

  assert(unknown != missing, "unknown vs missing: both '${unknown}'")
  assert(unknown != mismatch, "unknown vs mismatch: both '${unknown}'")
  assert(unknown != malformed, "unknown vs malformed: both '${unknown}'")
  assert(missing != mismatch, "missing vs mismatch: both '${missing}'")
  assert(missing != malformed, "missing vs malformed: both '${missing}'")
  assert(mismatch != malformed, "mismatch vs malformed: both '${mismatch}'")
}

// --- nesting ----------------------------------------------------------------

test "a failure inside a nested object names the full dotted path" {
  let payload = "{\"name\":\"Ali\",\"addr\":{\"city\":\"cairo\",\"zip\":\"11511\"}}"
  let res = defaultBodyApp().handle(jsonPost("/profiles", payload))

  assert(res.status == 400, "want 400, got ${res.status}: '${res.body}'")
  assert(
    contains(errorText(res), "addr.zip"),
    "the full dotted path, not the leaf, got '${errorText(res)}'",
  )
}

test "an unknown key nested inside an object is named by its full path, and dropped under Ignore" {
  let payload = "{\"name\":\"Ali\",\"addr\":{\"city\":\"cairo\",\"zip\":1,\"county\":\"x\"}}"

  let strict = defaultBodyApp().handle(jsonPost("/profiles", payload))
  assert(strict.status == 400, "want 400, got ${strict.status}: '${strict.body}'")
  assert(
    contains(errorText(strict), "addr.county"),
    "the nested unknown key by full path, got '${errorText(strict)}'",
  )

  let loose = defaultBodyApp().handle(jsonPost("/profiles/loose", payload))
  assert(loose.status == 200, "Ignore must bind it, got ${loose.status}: '${loose.body}'")
  assert(!contains(loose.body, "county"), "no trace of the dropped key: '${loose.body}'")
  assert(contains(loose.body, "cairo"), "the sibling keys survive: '${loose.body}'")
}

test "an unknown key inside an array element is dropped under Ignore" {
  let payload = "{\"stops\":[{\"city\":\"a\",\"zip\":1},{\"city\":\"b\",\"zip\":2,\"nope\":3}]}"

  let strict = defaultBodyApp().handle(jsonPost("/trips/loose", payload))
  assert(strict.status == 200, "Ignore must bind it, got ${strict.status}: '${strict.body}'")
  assert(!contains(strict.body, "nope"), "no trace of the dropped key: '${strict.body}'")
  assert(contains(strict.body, "\"city\":\"b\""), "the element itself survives: '${strict.body}'")
}

// The bound on the retry loop, which is what keeps `Ignore` from being
// quadratic work on attacker-chosen input. `maxIgnoredKeys` is 32; 40 unknown
// keys is a 400 rather than 40 decodes of a 40-key document.
test "more unknown fields than the ignore bound is a 400, not unbounded work" {
  let junk = ""
  let i = 0
  while (i < 40) {
    junk = junk + ",\"k${i}\":1"
    i = i + 1
  }
  let payload = "{\"name\":\"Ali\",\"email\":\"b\"${junk}}"

  let res = defaultBodyApp().handle(jsonPost("/users/loose", payload))
  assert(res.status == 400, "want 400, got ${res.status}: '${res.body}'")
  assert(
    contains(errorText(res), "unknown field"),
    "the 400 must say why it stopped, got '${errorText(res)}'",
  )
}

// The other side of that bound: a body just under it still binds, so the
// refusal above is the bound firing and not `Ignore` being broken.
test "unknown fields up to the ignore bound still bind" {
  let junk = ""
  let i = 0
  while (i < 32) {
    junk = junk + ",\"k${i}\":1"
    i = i + 1
  }
  let payload = "{\"name\":\"Ali\",\"email\":\"b\"${junk}}"

  let res = defaultBodyApp().handle(jsonPost("/users/loose", payload))
  assert(res.status == 200, "want 200, got ${res.status}: '${res.body}'")
  assert(stringField(res.body, "name") == "Ali", "name: got '${res.body}'")
}

// --- Content-Type -----------------------------------------------------------

test "a non-JSON Content-Type is a 415 and the body is never parsed" {
  let res = defaultBodyApp().handle(
    typedPost("/users", "application/x-www-form-urlencoded", "name=a&email=b"),
  )

  assert(res.status == 415, "want 415, got ${res.status}: '${res.body}'")
  assert(
    contains(errorText(res), "application/x-www-form-urlencoded"),
    "the 415 must name what was sent, got '${errorText(res)}'",
  )
}

test "an absent Content-Type is a 415, never a guess" {
  let res = defaultBodyApp().handle(typedPost("/users", "", "{\"name\":\"a\",\"email\":\"b\"}"))

  assert(res.status == 415, "want 415, got ${res.status}: '${res.body}'")
}

test "a JSON Content-Type with parameters is accepted, and a +json suffix too" {
  let payload = "{\"name\":\"Ali\",\"email\":\"b\"}"

  let withCharset = defaultBodyApp().handle(
    typedPost("/users", "Application/JSON; charset=utf-8", payload),
  )
  assert(
    withCharset.status == 200,
    "parameters and case must not matter, got ${withCharset.status}",
  )

  let suffixed = defaultBodyApp().handle(typedPost("/users", "application/vnd.api+json", payload))
  assert(suffixed.status == 200, "a +json suffix is JSON, got ${suffixed.status}")
}

// --- the size cap -----------------------------------------------------------

test "a body over Config.maxBody is a 413" {
  let app = bodyApp(Config{ secret: "s", maxBody: 40 })
  let res = app.handle(jsonPost("/users", paddedPayload(64)))

  assert(res.status == 413, "want 413, got ${res.status}: '${res.body}'")
  assert(contains(errorText(res), "cap"), "the 413 must say why, got '${errorText(res)}'")
}

test "a body at the cap still binds, so the 413 is the cap and not the route" {
  let payload = paddedPayload(8)
  let app = bodyApp(Config{ secret: "s", maxBody: i64(len(payload)) })
  let res = app.handle(jsonPost("/users", payload))

  assert(res.status == 200, "want 200 at exactly the cap, got ${res.status}: '${res.body}'")
}

test "the size cap is checked before the Content-Type, so an over-large body is a 413" {
  let app = bodyApp(Config{ secret: "s", maxBody: 40 })
  let res = app.handle(typedPost("/users", "text/plain", paddedPayload(64)))

  assert(res.status == 413, "want 413 rather than 415, got ${res.status}: '${res.body}'")
}

// --- the raw and the tree ---------------------------------------------------

test "rawBody() returns the unparsed body and is capped" {
  let app = defaultBodyApp()
  let res = app.handle(typedPost("/raw", "text/plain", "not json at all"))
  assert(res.status == 200, "rawBody() does not care about Content-Type, got ${res.status}")
  assert(res.body == "not json at all", "want the bytes as sent, got '${res.body}'")

  let capped = bodyApp(Config{ secret: "s", maxBody: 4 })
  let over = capped.handle(typedPost("/raw", "text/plain", "more than four"))
  assert(over.status == 413, "rawBody() is capped too, got ${over.status}")
}

test "bodyJson() gives the parsed tree for a payload that is not a class" {
  let res = defaultBodyApp().handle(jsonPost("/tree", "{\"a\":[1,2],\"b\":null}"))

  assert(res.status == 200, "want 200, got ${res.status}: '${res.body}'")
  assert(contains(res.body, "\"a\":[1,2]"), "the tree round-trips, got '${res.body}'")
}

// --- the removed receiver form ----------------------------------------------
//
// #3877's own acceptance: `grep -c 'fn (' pkg/web/body.bit` is 0. Asserted in
// source rather than only in a shell, so it stays asserted.
test "body.bit declares no method in the receiver form removed in 0.2.0" {
  let repo = locateBit().repo
  assert(len(repo) > 0, "cannot locate the repo: run this from the repo root or set BIT_REPO")
  let src = readFile("${repo}/pkg/web/body.bit") catch e {
    panic("read body.bit: ${e.message()}")
  }
  assert(!contains(src, "fn ("), "body.bit must contain no 'fn (' — E0103 since 0.2.0")
}
