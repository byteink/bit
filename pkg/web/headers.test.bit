// pkg/web/headers.test.bit — #3956's acceptance, one named test per assertion.
//
// Every test drives `app.handle(req)` (app.bit), the in-process seam #3885
// established, so the middleware under test is composed into the real chain by
// `freeze()` and is reached the way a served request reaches it — and the
// headers are read off the raw block of the `Response` that actually leaves
// the framework, not off the `Res` the middleware happened to hand back.
// Calling `applySecureHeaders` directly would pass just as well against a
// middleware that never runs.
//
// The expected values below are written out as LITERALS and never read from
// headers.bit's own constants: a test that imported the constant it is
// checking would pass after any edit to it, which is the whole failure this
// table exists to prevent.
//
// `adapterApp`, `newSink`, `req` and `freezeOrPanic` are adapter.test.bit's,
// `contains` is router.test.bit's — already bound module-wide (SPEC §17.1),
// so re-importing any of them is E0042. `header` is std/http's raw-block
// reader and is NOT yet bound in this module; it comes in under an alias so
// it can never be confused with `Ctx.header` (a request header) or
// `Res.header` (a chainable setter).
import { header as rawHeader } from "std/http"

// One expected response header. A LIST of these, not ten assertions: the
// table is data on this side too, so a header added to the middleware is one
// line here and a header removed from it fails on the line naming it.
class Expect {
  name: string,
  value: string,
}

// The ticket's table, all ten, in its order. `Strict-Transport-Security` is
// index 1 and is the only conditional one — `defaultsWithoutHsts()` drops it
// for the plain-HTTP case.
fn defaultTable(): []Expect {
  return []Expect{
    Expect{ name: "Content-Security-Policy", value: "default-src 'self'" },
    Expect{ name: "Strict-Transport-Security", value: "max-age=31536000; includeSubDomains" },
    Expect{ name: "X-Content-Type-Options", value: "nosniff" },
    Expect{ name: "X-Frame-Options", value: "DENY" },
    Expect{ name: "Referrer-Policy", value: "no-referrer" },
    Expect{ name: "Cross-Origin-Opener-Policy", value: "same-origin" },
    Expect{ name: "Cross-Origin-Resource-Policy", value: "same-origin" },
    Expect{ name: "Origin-Agent-Cluster", value: "?1" },
    Expect{ name: "X-DNS-Prefetch-Control", value: "off" },
    Expect{ name: "X-XSS-Protection", value: "0" },
  }
}

const hstsHeaderName = "Strict-Transport-Security"

fn defaultsWithoutHsts(): []Expect {
  let out = []Expect(0)
  for e of defaultTable() {
    if (e.name == hstsHeaderName) {
      continue
    }
    out = append(out, e)
  }
  return out
}

// A response from an app whose only middleware is `secureHeaders(o)`, with one
// ordinary handler that sets nothing itself.
fn secured(o: Headers): Response {
  return securedBy(o, (c) => {
    return c.text("ok")
  })
}

// The same, with the handler supplied — so the handler-wins test differs from
// the others by exactly the handler and nothing else.
fn securedBy(o: Headers, h: Handler): Response {
  let app = adapterApp(newSink())
  app.use(secureHeaders(o))
  app.get("/x", h)
  freezeOrPanic(app)
  return app.handle(req("GET", "/x"))
}

fn assertHeader(res: Response, e: Expect) {
  let got = rawHeader(res.headers, e.name)
  assert(got == e.value, "${e.name}: want '${e.value}', got '${got}' in '${res.headers}'")
}

// Absent means the field is not in the block at all — not merely that its
// value reads empty. `rawHeader` returns "" for both an absent field and one
// present with an empty value, so the name is checked against the raw block
// too; otherwise a middleware that set `X-Download-Options: ` would pass.
fn assertNoHeader(res: Response, name: string) {
  let got = rawHeader(res.headers, name)
  assert(got == "", "${name} must be absent, got value '${got}'")
  assert(!contains(res.headers, name + ":"), "${name} must not appear at all in '${res.headers}'")
}

// --- the table: all ten, by name and by value ------------------------------

test "all ten default headers are present by name and value" {
  let res = secured(Headers{ https: true })

  assert(res.status == 200, "want the handler's 200, got ${res.status}")
  assert(len(defaultTable()) == 10, "the table must carry all ten headers, got ${len(defaultTable())}")
  for e of defaultTable() {
    assertHeader(res, e)
  }
}

test "the nine unconditional defaults are present on a plain HTTP response" {
  let res = secured(Headers{})

  assert(len(defaultsWithoutHsts()) == 9, "want nine unconditional headers, got ${len(defaultsWithoutHsts())}")
  for e of defaultsWithoutHsts() {
    assertHeader(res, e)
  }
}

// --- ruling one: X-XSS-Protection is `0`, not omitted and never `1` --------

test "X-XSS-Protection is present with the value exactly 0" {
  let res = secured(Headers{})
  let got = rawHeader(res.headers, "X-XSS-Protection")

  assert(got == "0", "want exactly '0', got '${got}'")
  assert(got != "1", "1 enables the legacy filter that this header exists to disable")
  assert(got != "1; mode=block", "1; mode=block enables it too")
}

// --- ruling two: the two dead headers are not shipped ----------------------

test "X-Download-Options and X-Permitted-Cross-Domain-Policies are not shipped" {
  let res = secured(Headers{ https: true })

  assertNoHeader(res, "X-Download-Options")
  assertNoHeader(res, "X-Permitted-Cross-Domain-Policies")
}

// --- HSTS: on when the app declares HTTPS, off otherwise ------------------

test "Strict-Transport-Security is emitted when the app declares HTTPS" {
  let res = secured(Headers{ https: true })
  let got = rawHeader(res.headers, hstsHeaderName)

  assert(got == "max-age=31536000; includeSubDomains", "want the one-year policy, got '${got}'")
}

test "Strict-Transport-Security is absent when the app has not declared HTTPS" {
  assertNoHeader(secured(Headers{}), hstsHeaderName)
}

// A client-supplied `X-Forwarded-Proto` must not be able to turn HSTS on: it
// is the exact attack `Headers.https` documents refusing, and the only test
// here that can catch a future "helpful" fallback being added.
test "a client's X-Forwarded-Proto header does not turn HSTS on" {
  let app = adapterApp(newSink())
  app.use(secureHeaders(Headers{}))
  app.get("/x", (c) => {
    return c.text("ok")
  })
  freezeOrPanic(app)

  let r = Request{
    method: "GET",
    path: "/x",
    headers: "X-Forwarded-Proto: https",
    body: "",
  }
  let res = app.handle(r)

  assert(res.status == 200, "want 200, got ${res.status}")
  assertNoHeader(res, hstsHeaderName)
}

// --- CSP: replaced wholesale, or omitted -----------------------------------

test "a custom csp replaces the default wholesale, with no merging" {
  let custom = "default-src 'none'; img-src 'self' data:"
  let res = secured(Headers{ csp: custom })
  let got = rawHeader(res.headers, "Content-Security-Policy")

  assert(got == custom, "want the custom policy verbatim, got '${got}'")
  assert(!contains(got, "default-src 'self'"), "the default must not be merged in: '${got}'")
  assert(
    !contains(res.headers, "Content-Security-Policy: default-src 'self'"),
    "the default policy must not appear as a second field: '${res.headers}'",
  )
}

test "an empty csp omits the Content-Security-Policy header entirely" {
  let res = secured(Headers{ csp: "" })

  assertNoHeader(res, "Content-Security-Policy")
  // The rest of the table is unaffected: omitting CSP is not a way to opt out
  // of everything else.
  assertHeader(res, Expect{ name: "X-Content-Type-Options", value: "nosniff" })
  assertHeader(res, Expect{ name: "X-Frame-Options", value: "DENY" })
}

// --- the handler wins ------------------------------------------------------

test "a header the handler set is not overwritten by the middleware" {
  let res = securedBy(Headers{ https: true }, (c) => {
    return c.text("ok").header("X-Frame-Options", "SAMEORIGIN")
  })
  let got = rawHeader(res.headers, "X-Frame-Options")

  assert(got == "SAMEORIGIN", "the handler's value must survive, got '${got}'")
  assert(
    !contains(res.headers, "X-Frame-Options: DENY"),
    "the middleware's default must not appear as a second field: '${res.headers}'",
  )
  // Everything the handler did NOT set is still applied.
  assertHeader(res, Expect{ name: "X-Content-Type-Options", value: "nosniff" })
  assertHeader(res, Expect{ name: hstsHeaderName, value: "max-age=31536000; includeSubDomains" })
}

// `Res.headerValue` is case-insensitive (res.bit), so the handler's own
// spelling of a header name must be honoured too — a middleware that compared
// names byte for byte would set a second, conflicting field here.
test "the handler wins whatever case it spelled the header name in" {
  let res = securedBy(Headers{}, (c) => {
    return c.text("ok").header("x-frame-options", "SAMEORIGIN")
  })
  let got = rawHeader(res.headers, "X-Frame-Options")

  assert(got == "SAMEORIGIN", "the handler's value must survive, got '${got}'")
  assert(!contains(res.headers, "DENY"), "the middleware's default must not be added: '${res.headers}'")
}
