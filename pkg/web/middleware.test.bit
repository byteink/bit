// pkg/web/middleware.test.bit — App/Group-scoped middleware (#3886), rewritten
// by #3885 against the real shapes: `Handler` is `(Ctx) => Res!` and
// `Middleware` is `(Ctx, Next) => Res!`, so "the response" every assertion
// here reads is a real `Res` returned out of the chain rather than the
// captured variable this file had to use while `Ctx` and `Res` did not exist.
//
// Ordering assertions still use a captured `[]string` — function values are
// not comparable (E0052, same reason router.test.bit gives), and a list
// appended to on the way in and on the way out is the only thing that can
// show the onion.
//
// `runRoute` looks the route up through the FROZEN router, so the chain under
// test is the one `freeze()` composed (`flushPending`/`buildChain`,
// middleware.bit), never one this file built by hand.

// The `Res` the composed chain the app stored for `method path` returns.
// Panics rather than failing: a fixture whose own route will not match, or
// whose chain fails when the test expects success, is broken rather than red.
fn runRoute(app: App, method: string, path: string): Res {
  return chainRes(app, method, path) catch e {
    panic("${method} ${path} failed: ${e.message()}")
  }
}

// The same call, kept fallible, for the tests whose subject IS the failure.
fn chainRes(app: App, method: string, path: string): Res! {
  let m = app.root.router.lookup(method, path) catch e {
    panic("lookup ${method} ${path}: ${e.message()}")
  }
  let req = Request{ method: method, path: path, headers: "", body: "" }
  let c = newCtx(req, m.params, app.root.registry, app.config, m.pattern) catch e {
    panic("newCtx: ${e.message()}")
  }
  return m.handler(c)?
}

fn freezeApp(app: App) {
  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
}

// --- order-independence: THE requirement this ticket exists for ----------

// route registered, THEN use() on the SAME Group — the harder direction,
// and the one Express gets wrong.
test "route-then-use: middleware registered after the route still applies" {
  let handlerRan = false

  let app = testApp()
  let g = app.group("/api")
  g.get("/x", (c) => {
    handlerRan = true
    return c.status(200)
  })
  let reject: Middleware = (c, next) => {
    return c.status(401)
  }
  g.use(reject)

  freezeApp(app)
  let r = runRoute(app, "GET", "/api/x")

  assert(r.statusCode() == 401, "want 401, got ${r.statusCode()}")
  assert(!handlerRan, "handler must not run: middleware never called next()")
}

// use() THEN the route — the direction that already worked positionally,
// kept as the control: it must produce the IDENTICAL result to the test
// above, proving order genuinely does not matter.
test "use-then-route: identical result to route-then-use" {
  let handlerRan = false

  let app = testApp()
  let g = app.group("/api")
  let reject: Middleware = (c, next) => {
    return c.status(401)
  }
  g.use(reject)
  g.get("/x", (c) => {
    handlerRan = true
    return c.status(200)
  })

  freezeApp(app)
  let r = runRoute(app, "GET", "/api/x")

  assert(r.statusCode() == 401, "want 401, got ${r.statusCode()}")
  assert(!handlerRan, "handler must not run: middleware never called next()")
}

// middleware on a Group must never leak to a sibling Group.
test "middleware on a Group does not leak to a sibling Group" {
  let aRan = false
  let bRan = false

  let app = testApp()
  let a = app.group("/a")
  let b = app.group("/b")
  a.use((c, next) => {
    // never calls next() — /a is fully closed off
    return c.status(403)
  })
  a.get("/x", (c) => {
    aRan = true
    return c.status(200)
  })
  b.get("/y", (c) => {
    bRan = true
    return c.status(200)
  })

  freezeApp(app)
  let ra = runRoute(app, "GET", "/a/x")
  let rb = runRoute(app, "GET", "/b/y")

  assert(!aRan, "a's own middleware must short-circuit a's route")
  assert(ra.statusCode() == 403, "/a/x: want the middleware's 403, got ${ra.statusCode()}")
  assert(bRan, "a's middleware must not leak into sibling b")
  assert(rb.statusCode() == 200, "/b/y: want the handler's 200, got ${rb.statusCode()}")
}

// --- execution order: outer scope first, then inner -----------------------

test "App-level middleware runs outermost, before the Group's own, before the handler" {
  let order = []string(0)

  let app = testApp()
  app.use((c, next) => {
    order = append(order, "app")
    return next(c)
  })
  let g = app.group("/api")
  g.use((c, next) => {
    order = append(order, "group")
    return next(c)
  })
  g.get("/x", (c) => {
    order = append(order, "handler")
    return c.status(200)
  })

  freezeApp(app)
  let r = runRoute(app, "GET", "/api/x")

  assert(len(order) == 3, "want 3 entries, got ${len(order)}")
  assert(order[0] == "app", "want 'app' first, got '${order[0]}'")
  assert(order[1] == "group", "want 'group' second, got '${order[1]}'")
  assert(order[2] == "handler", "want 'handler' last, got '${order[2]}'")
  assert(r.statusCode() == 200, "the handler's Res must come back out: ${r.statusCode()}")
}

test "within one scope, middleware runs in registration order" {
  let order = []string(0)

  let app = testApp()
  app.use((c, next) => {
    order = append(order, "first")
    return next(c)
  })
  app.use((c, next) => {
    order = append(order, "second")
    return next(c)
  })
  app.get("/x", (c) => {
    order = append(order, "handler")
    return c.status(200)
  })

  freezeApp(app)
  let _ = runRoute(app, "GET", "/x")

  assert(len(order) == 3, "want 3 entries, got ${len(order)}")
  assert(order[0] == "first", "want 'first' first, got '${order[0]}'")
  assert(order[1] == "second", "want 'second' second, got '${order[1]}'")
}

// --- short-circuit and on-the-way-out modification -------------------------

test "a middleware that omits next() short-circuits so the handler never runs" {
  let handlerRan = false

  let app = testApp()
  app.use((c, next) => {
    // deliberately never calls next()
    return c.status(401)
  })
  app.get("/x", (c) => {
    handlerRan = true
    return c.status(200)
  })

  freezeApp(app)
  let r = runRoute(app, "GET", "/x")

  assert(!handlerRan, "the handler must not run when middleware never calls next()")
  assert(r.statusCode() == 401, "the short-circuiting Res must be the answer: ${r.statusCode()}")
}

// The way-out half of the onion, and it is now a real one: the middleware
// receives the handler's own `Res` back from `next(c)` and rewrites it,
// rather than reading a variable the handler happened to set.
test "a middleware reading the result of next() can modify the response on the way out" {
  let app = testApp()
  app.use((c, next) => {
    let inner = next(c) catch e {
      return rethrow(e)
    }
    return inner.status(inner.statusCode() + 1).header("X-Out", "yes")
  })
  app.get("/x", (c) => {
    return c.status(200)
  })

  freezeApp(app)
  let r = runRoute(app, "GET", "/x")

  assert(
    r.statusCode() == 201,
    "want 201 (200 from the handler, then +1 on the way out), got ${r.statusCode()}",
  )
  assert(
    r.headerValue("X-Out") == "yes",
    "the way-out header must be set: '${r.headerValue("X-Out")}'",
  )
}

// --- failure propagation ---------------------------------------------------

// The property #3886 could only assert about a PANIC, now re-proved under
// the real mechanism: `Handler` is fallible, so a handler can `fail`, and
// `wrap`'s `(c) => mw(c, inner)` hands the failure straight back out
// (middleware.bit). Two separate claims, both asserted: the failure reaches
// the caller of the composed chain carrying the handler's own message, and
// NOTHING after a middleware's `next(c)` runs on that path — which is what
// "propagates" has to mean, and what a `wrap` that swallowed and re-raised
// would silently break.
test "a fail from the handler propagates out through every middleware" {
  let reachedAfterNext = false
  let enteredOuter = false

  let app = testApp()
  app.use((c, next) => {
    enteredOuter = true
    let inner = next(c)?
    reachedAfterNext = true
    return inner
  })
  app.get(
    "/boom",
    (c) => rethrow(newError("handler said no")),
  )

  freezeApp(app)
  let failed = false
  let _ = chainRes(app, "GET", "/boom") catch e {
    failed = true
    assert(
      e.message() == "handler said no",
      "the handler's own error must arrive intact, got '${e.message()}'",
    )
    Res{ code: 200, bodyText: "", pairs: []Header(0) }
  }

  assert(enteredOuter, "the outer middleware must have run at all")
  assert(failed, "the handler's fail must reach the caller of the chain")
  assert(!reachedAfterNext, "nothing after `next(c)` may run once the chain has failed")
}

// A middleware that WANTS the failure can still take it — `catch` is a local
// expression (SPEC §18.3), so handling one is opt-in and visible, which is
// what makes the propagating default safe. This is the mechanism #3951's
// recover() and #3876's mapping are both built on.
test "a middleware that catches a failure answers with its own Res" {
  let app = testApp()
  app.use((c, next) => {
    return next(c) catch e {
      c.status(503).header("X-Caught", e.message())
    }
  })
  app.get(
    "/boom",
    (c) => rethrow(newError("handler said no")),
  )

  freezeApp(app)
  let r = runRoute(app, "GET", "/boom")

  assert(r.statusCode() == 503, "want the middleware's 503, got ${r.statusCode()}")
  assert(
    r.headerValue("X-Caught") == "handler said no",
    "the caught message: '${r.headerValue("X-Caught")}'",
  )
}

// A panic is still not a failure, and this app never installs pkg/web's
// `recover()` (recover.bit, #3951) — the one construct that turns a handler
// panic into a 500, by arming the runtime's panic boundary (`runRecovering`)
// around the rest of the middleware chain. Without it, the chain built by
// `wrap`/`buildChain` never intercepts one. A `testpanic_` verdict-inversion
// test: it PASSES only if the process exits with the panic exit code.
test "testpanic_panic_from_the_handler_is_not_swallowed" {
  let app = testApp()
  app.use((c, next) => {
    return next(c)
  })
  app.get("/boom", (c) => {
    panic("boom")
  })
  freezeApp(app)
  let _ = runRoute(app, "GET", "/boom")
}

// --- freeze -----------------------------------------------------------------

test "testpanic_use_after_freeze" {
  let app = testApp()
  freezeApp(app)
  app.use((c, next) => {
    return next(c)
  })
}
