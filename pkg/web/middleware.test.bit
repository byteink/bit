// pkg/web/middleware.test.bit — App/Group-scoped middleware (#3886).
//
// `Handler`/`Next` are `() => ()` and function values are not comparable
// (E0052, same reason router.test.bit gives), so every assertion here works
// the way router.test.bit's own do: a closure writes into a test-local
// `let` it captures, and the assertion reads that variable back after
// calling the matched `Handler`. "The response" and "the shared list" the
// ticket's acceptance text names are exactly this — there is no `Res` yet
// (#3884) for a middleware to return.

// --- order-independence: THE requirement this ticket exists for ----------

// route registered, THEN use() on the SAME Group — the harder direction,
// and the one Express gets wrong.
test "route-then-use: middleware registered after the route still applies" {
  let status = 0
  let handlerRan = false

  let app = App()
  let g = app.group("/api")
  g.get(
    "/x",
    () => {
      handlerRan = true
      status = 200
    },
  )
  let reject: Middleware = (next) => {
    status = 401
  }
  g.use(reject)

  app.listen() catch e {
    panic("listen: ${e.message()}")
  }
  let m = app.root.router.lookup("GET", "/api/x") catch e {
    panic("lookup: ${e.message()}")
  }
  m.handler()

  assert(status == 401, "want 401, got ${status}")
  assert(!handlerRan, "handler must not run: middleware never called next()")
}

// use() THEN the route — the direction that already worked positionally,
// kept as the control: it must produce the IDENTICAL result to the test
// above, proving order genuinely does not matter.
test "use-then-route: identical result to route-then-use" {
  let status = 0
  let handlerRan = false

  let app = App()
  let g = app.group("/api")
  let reject: Middleware = (next) => {
    status = 401
  }
  g.use(reject)
  g.get(
    "/x",
    () => {
      handlerRan = true
      status = 200
    },
  )

  app.listen() catch e {
    panic("listen: ${e.message()}")
  }
  let m = app.root.router.lookup("GET", "/api/x") catch e {
    panic("lookup: ${e.message()}")
  }
  m.handler()

  assert(status == 401, "want 401, got ${status}")
  assert(!handlerRan, "handler must not run: middleware never called next()")
}

// middleware on a Group must never leak to a sibling Group.
test "middleware on a Group does not leak to a sibling Group" {
  let aRan = false
  let bRan = false

  let app = App()
  let a = app.group("/a")
  let b = app.group("/b")
  a.use(
    (next) => {
      // never calls next() — /a is fully closed off
    },
  )
  a.get(
    "/x",
    () => {
      aRan = true
    },
  )
  b.get(
    "/y",
    () => {
      bRan = true
    },
  )

  app.listen() catch e {
    panic("listen: ${e.message()}")
  }
  let ma = app.root.router.lookup("GET", "/a/x") catch e {
    panic("lookup /a/x: ${e.message()}")
  }
  ma.handler()
  let mb = app.root.router.lookup("GET", "/b/y") catch e {
    panic("lookup /b/y: ${e.message()}")
  }
  mb.handler()

  assert(!aRan, "a's own middleware must short-circuit a's route")
  assert(bRan, "a's middleware must not leak into sibling b")
}

// --- execution order: outer scope first, then inner -----------------------

test "App-level middleware runs outermost, before the Group's own, before the handler" {
  let order = []string(0)

  let app = App()
  app.use(
    (next) => {
      order = append(order, "app")
      next()
    },
  )
  let g = app.group("/api")
  g.use(
    (next) => {
      order = append(order, "group")
      next()
    },
  )
  g.get(
    "/x",
    () => {
      order = append(order, "handler")
    },
  )

  app.listen() catch e {
    panic("listen: ${e.message()}")
  }
  let m = app.root.router.lookup("GET", "/api/x") catch e {
    panic("lookup: ${e.message()}")
  }
  m.handler()

  assert(len(order) == 3, "want 3 entries, got ${len(order)}")
  assert(order[0] == "app", "want 'app' first, got '${order[0]}'")
  assert(order[1] == "group", "want 'group' second, got '${order[1]}'")
  assert(order[2] == "handler", "want 'handler' last, got '${order[2]}'")
}

test "within one scope, middleware runs in registration order" {
  let order = []string(0)

  let app = App()
  app.use(
    (next) => {
      order = append(order, "first")
      next()
    },
  )
  app.use(
    (next) => {
      order = append(order, "second")
      next()
    },
  )
  app.get(
    "/x",
    () => {
      order = append(order, "handler")
    },
  )

  app.listen() catch e {
    panic("listen: ${e.message()}")
  }
  let m = app.root.router.lookup("GET", "/x") catch e {
    panic("lookup: ${e.message()}")
  }
  m.handler()

  assert(len(order) == 3, "want 3 entries, got ${len(order)}")
  assert(order[0] == "first", "want 'first' first, got '${order[0]}'")
  assert(order[1] == "second", "want 'second' second, got '${order[1]}'")
}

// --- short-circuit and on-the-way-out modification -------------------------

test "a middleware that omits next() short-circuits so the handler never runs" {
  let handlerRan = false

  let app = App()
  app.use(
    (next) => {
      // deliberately never calls next()
    },
  )
  app.get(
    "/x",
    () => {
      handlerRan = true
    },
  )

  app.listen() catch e {
    panic("listen: ${e.message()}")
  }
  let m = app.root.router.lookup("GET", "/x") catch e {
    panic("lookup: ${e.message()}")
  }
  m.handler()

  assert(!handlerRan, "the handler must not run when middleware never calls next()")
}

test "a middleware reading the result of next() can modify the response on the way out" {
  let status = 0

  let app = App()
  app.use(
    (next) => {
      next()
      // acts on the way OUT, after the handler (and any inner middleware)
      // has already run and set status.
      status = status + 1
    },
  )
  app.get(
    "/x",
    () => {
      status = 200
    },
  )

  app.listen() catch e {
    panic("listen: ${e.message()}")
  }
  let m = app.root.router.lookup("GET", "/x") catch e {
    panic("lookup: ${e.message()}")
  }
  m.handler()

  assert(status == 201, "want 201 (200 set by the handler, then +1 on the way out), got ${status}")
}

// --- failure propagation ---------------------------------------------------

// `Handler`/`Next` are not fallible yet (`Res!` is #3884), so the only way
// a handler "fails" today is a panic — and Bit has no catch for one, so
// this is a `testpanic_` verdict-inversion test (SPEC §18.4, the same
// convention app.test.bit's own `testpanic_get_after_listen` uses): it
// PASSES only if the process exits with the panic exit code, proving the
// chain built by `wrap`/`buildChain` never intercepts it.
test "testpanic_panic_from_the_handler_is_not_swallowed" {
  let app = App()
  app.use(
    (next) => {
      next()
    },
  )
  app.get(
    "/boom",
    () => {
      panic("boom")
    },
  )
  app.listen() catch e {
    panic("listen: ${e.message()}")
  }
  let m = app.root.router.lookup("GET", "/boom") catch e {
    panic("lookup: ${e.message()}")
  }
  m.handler()
}

// --- freeze -----------------------------------------------------------------

test "testpanic_use_after_listen" {
  let app = App()
  app.listen() catch e {
    panic("listen: ${e.message()}")
  }
  app.use(
    (next) => {
      next()
    },
  )
}
