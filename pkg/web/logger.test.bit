// pkg/web/logger.test.bit — #3952's acceptance, one named test per assertion.
//
// Every test drives `app.handle(req)` (app.bit), the in-process seam #3885
// established, so the logger under test is composed into the real chain by
// `freeze()` and reached the way a served request reaches it — not called by
// hand. That is what catches a logger registered on the wrong scope or
// wrapped in the wrong order, which calling the middleware directly cannot.
//
// The sink is adapter.test.bit's `RecordingSink`/`newSink`/`sinkText` and the
// app is its `adapterApp` — the SAME sink the framework's 5xx logging already
// writes through (`logLine`, adapter.bit:97), reused rather than duplicated,
// which is the whole point of the ticket's "one destination, not two".
// `req`, `freezeOrPanic` (adapter.test.bit) and `contains` (router.test.bit)
// are likewise already bound module-wide (SPEC §17.1).
import { parseInt } from "std/strings"
import { Millisecond, sleep } from "std/time"

// An app whose only middleware is the logger, on the root scope.
fn loggedApp(sink: RecordingSink): App {
  let app = adapterApp(sink)
  app.use(logger())
  return app
}

// The five fields of one log line. Panics rather than asserting: a line this
// file can no longer split into exactly five parts is a broken fixture, and
// the shape claim itself is made by the named test below.
fn fieldsOf(line: string): []string {
  let f = split(line, " ")
  if (len(f) != 5) {
    panic("want five space-separated fields, got ${len(f)} in '${line}'")
  }
  return f
}

// The fields of the single line `s` recorded.
fn soleFields(s: RecordingSink): []string {
  if (len(s.lines) != 1) {
    panic("want exactly one log line, got ${len(s.lines)}: '${sinkText(s)}'")
  }
  return fieldsOf(s.lines[0])
}

// The duration field ("25ms") back as nanoseconds, so an interval assertion
// compares numbers rather than strings.
fn durationNs(field: string): int {
  if (len(field) < 3 || field[len(field) - 2:len(field)] != "ms") {
    panic("duration field '${field}' does not end in 'ms'")
  }
  let n = parseInt(field[0:len(field) - 2]) catch e {
    panic("duration field '${field}': ${e.message()}")
  }
  return n * Millisecond
}

// "2026-08-30T10:22:01Z" — 20 characters, UTC, whole seconds. Split in two so
// neither half approaches the complexity limit, and ordered so the length
// check in `rfc3339Punctuation` runs before anything indexes `s`.
fn isRfc3339UtcSeconds(s: string): bool {
  return rfc3339Punctuation(s) && rfc3339Digits(s)
}

fn rfc3339Punctuation(s: string): bool {
  return len(s) == 20 &&
    s[4] == '-' &&
    s[7] == '-' &&
    s[10] == 'T' &&
    s[13] == ':' &&
    s[16] == ':' &&
    s[19] == 'Z'
}

fn rfc3339Digits(s: string): bool {
  for p of []int{ 0, 1, 2, 3, 5, 6, 8, 9, 11, 12, 14, 15, 17, 18 } {
    if (s[p] < '0' || s[p] > '9') {
      return false
    }
  }
  return true
}

// --- the line: five fields, in order --------------------------------------

test "one request logs one line carrying timestamp, method, path, status and duration" {
  let sink = newSink()
  let app = loggedApp(sink)
  app.get(
    "/users",
    (c) => {
      return c.text("ok")
    },
  )
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/users"))

  assert(res.status == 200, "want 200, got ${res.status}")
  assert(len(sink.lines) == 1, "want exactly one line, got ${len(sink.lines)}: '${sinkText(sink)}'")

  let f = soleFields(sink)
  assert(isRfc3339UtcSeconds(f[0]), "field 1 must be RFC 3339 UTC seconds, got '${f[0]}'")
  assert(f[1] == "GET", "field 2 must be the method, got '${f[1]}'")
  assert(f[2] == "/users", "field 3 must be the route, got '${f[2]}'")
  assert(f[3] == "200", "field 4 must be the status, got '${f[3]}'")
  assert(durationNs(f[4]) >= 0, "field 5 must be a duration, got '${f[4]}'")
}

test "three requests log three lines: one per request, never one per app" {
  let sink = newSink()
  let app = loggedApp(sink)
  app.get("/a", okHandler)
  app.post("/a", okHandler)
  freezeOrPanic(app)

  let _ = app.handle(req("GET", "/a"))
  let _ = app.handle(req("POST", "/a"))
  let _ = app.handle(req("GET", "/a"))

  assert(len(sink.lines) == 3, "want three lines, got ${len(sink.lines)}: '${sinkText(sink)}'")
}

test "the status field is the response's own status, not a constant" {
  let sink = newSink()
  let app = loggedApp(sink)
  app.post(
    "/users",
    (c) => {
      return c.text("nope").status(422)
    },
  )
  freezeOrPanic(app)

  let res = app.handle(req("POST", "/users"))

  assert(res.status == 422, "want 422, got ${res.status}")
  let f = soleFields(sink)
  assert(f[1] == "POST", "want POST, got '${f[1]}'")
  assert(f[3] == "422", "want the handler's 422, got '${f[3]}'")
}

// --- what must never be logged --------------------------------------------

test "the query string never reaches the log line" {
  let sink = newSink()
  let app = loggedApp(sink)
  app.get(
    "/users",
    (c) => {
      return c.text("ok")
    },
  )
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/users?token=secret123"))

  assert(res.status == 200, "want 200, got ${res.status}")
  let line = sink.lines[0]
  assert(!contains(line, "secret123"), "the query VALUE leaked: '${line}'")
  assert(!contains(line, "token"), "the query KEY leaked: '${line}'")
  assert(!contains(line, "?"), "the line carries a query string: '${line}'")
}

// The decision the ticket asked to be made and documented: the path field is
// the matched route PATTERN. This is the test that makes it load-bearing
// rather than incidental — a credential in a path SEGMENT is beyond the reach
// of any query strip, and only the pattern is safe from it.
test "the path field is the matched route pattern, so a path segment cannot leak" {
  let sink = newSink()
  let app = loggedApp(sink)
  app.get(
    "/reset/:token",
    (c) => {
      return c.text("ok")
    },
  )
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/reset/tok-secret-7"))

  assert(res.status == 200, "want 200, got ${res.status}")
  let f = soleFields(sink)
  assert(f[2] == "/reset/:token", "want the pattern, got '${f[2]}'")
  assert(!contains(sink.lines[0], "tok-secret-7"), "the path segment leaked: '${sink.lines[0]}'")
}

test "a Cookie and an Authorization header never reach the log line" {
  let sink = newSink()
  let app = loggedApp(sink)
  app.get(
    "/users",
    (c) => {
      return c.text("ok")
    },
  )
  freezeOrPanic(app)

  let res = app.handle(
    Request{
      method: "GET",
      path: "/users",
      headers: "Cookie: session=cookie-secret-42\r\nAuthorization: Bearer bearer-secret-99",
      body: "",
    },
  )

  assert(res.status == 200, "want 200, got ${res.status}")
  let line = sink.lines[0]
  assert(!contains(line, "cookie-secret-42"), "the cookie VALUE leaked: '${line}'")
  assert(!contains(line, "bearer-secret-99"), "the credential leaked: '${line}'")
  assert(!contains(line, "Bearer"), "the Authorization scheme leaked: '${line}'")
  assert(!contains(line, "Cookie"), "the Cookie header name leaked: '${line}'")
  assert(!contains(line, "Authorization"), "the Authorization header name leaked: '${line}'")
}

// --- the duration ---------------------------------------------------------

test "the logged duration is at least the interval the handler slept" {
  let nap = 25 * Millisecond
  let sink = newSink()
  let app = loggedApp(sink)
  app.get(
    "/slow",
    (c) => {
      sleep(nap)
      return c.text("ok")
    },
  )
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/slow"))

  assert(res.status == 200, "want 200, got ${res.status}")
  let f = soleFields(sink)
  assert(
    durationNs(f[4]) >= nap,
    "want at least ${nap}ns, logged '${f[4]}' (${durationNs(f[4])}ns)",
  )
}

// The sleeping middleware is registered AFTER the logger, so it is INSIDE it
// in the onion — the handler itself sleeps nothing. A duration that only
// timed the handler would read 0ms here, which is what makes this the test
// for "the whole downstream chain" rather than a second sleep test.
test "the duration covers the whole downstream chain, not just the handler" {
  let nap = 25 * Millisecond
  let sink = newSink()
  let app = loggedApp(sink)
  app.use(
    (c, next) => {
      sleep(nap)
      return next(c)
    },
  )
  app.get(
    "/x",
    (c) => {
      return c.text("ok")
    },
  )
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/x"))

  assert(res.status == 200, "want 200, got ${res.status}")
  let f = soleFields(sink)
  assert(
    durationNs(f[4]) >= nap,
    "a middleware inside the logger slept ${nap}ns; logged '${f[4]}'",
  )
}

// --- a failed chain -------------------------------------------------------

// A middleware sits inside the chain, so a failure reaching it has no status
// yet — `failureRes` (adapter.bit) decides that afterwards. The line records
// `-` rather than guessing 500, and carries no part of the message: the real
// message is `failureRes`'s own line on this same sink, and this file
// deliberately does not pin how many lines that adds.
test "a failing chain is still logged, with an unknown status and no error message" {
  let sink = newSink()
  let app = loggedApp(sink)
  app.get("/boom", (c) => rethrow(newError("connection string: postgres://u:p@h/db")))
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/boom"))

  assert(res.status == 500, "want 500, got ${res.status}")
  assert(len(sink.lines) > 0, "a failed request must still be logged")
  let line = sink.lines[0]
  let f = fieldsOf(line)
  assert(f[1] == "GET", "want the method, got '${f[1]}'")
  assert(f[2] == "/boom", "want the route, got '${f[2]}'")
  assert(f[3] == "-", "a chain that failed has no status yet, got '${f[3]}'")
  assert(!contains(line, "postgres://"), "the logger must not log the message: '${line}'")
}

// Honest documentation of the limit: a middleware only runs for a MATCHED
// route (`matchedResponse`, adapter.bit), so a 404 never reaches this logger.
// Anyone who wants misses logged has to log them where the miss is decided.
test "an unmatched path logs nothing: a middleware runs only for a matched route" {
  let sink = newSink()
  let app = loggedApp(sink)
  app.get("/known", okHandler)
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/nowhere"))

  assert(res.status == 404, "want 404, got ${res.status}")
  assert(len(sink.lines) == 0, "nothing should have been logged: '${sinkText(sink)}'")
}
