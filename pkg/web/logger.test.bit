// pkg/web/logger.test.bit — #3952's acceptance, one named test per assertion.
//
// Every test drives `app.handle(req)` (app.bit), the in-process seam #3885
// established, so the logger under test is composed into the real chain by
// `freeze()` and reached the way a served request reaches it — not called by
// hand. That is what catches a logger registered on the wrong scope or
// wrapped in the wrong order, which calling the middleware directly cannot.
//
// The sink is adapter.test.bit's `RecordingSink`/`newSink`/`sinkText` and the
// app is its `adapterApp` — the SAME Logger the framework's 5xx logging
// already writes through (`emitError`, adapter.bit), reused rather than
// duplicated, which is the whole point of the ticket's "one destination, not
// two". `testLogger`/`jsonTestLogger` (adapter.test.bit) build `Config.logger`
// over it. `req`, `freezeOrPanic` (adapter.test.bit) and `contains`
// (router.test.bit) are likewise already bound module-wide (SPEC §17.1).
// `parseInt` (std/strings) is now imported by static.bit (#6074) — a
// production file, so `parseInt` stays bound when this module is loaded as a
// dependency and .test.bit files are excluded (the #5569 class of bug, see
// res.bit); re-importing it here is E0042.
import { Millisecond, sleep } from "std/time"

// An app whose only middleware is the logger, on the root scope.
fn loggedApp(sink: RecordingSink): App {
  let app = adapterApp(sink)
  app.use(logger())
  return app
}

// The same, writing JSON, so `took` is an integer of nanoseconds.
fn jsonLoggedApp(sink: RecordingSink): App {
  let app = App(Config{ secret = "test-secret", logger = jsonTestLogger(sink) })
  app.use(logger())
  return app
}

// The value of `key=` in a text record: bare up to the next space, or the
// whole JSON-quoted string when it starts with a quote. "" when absent, which
// no test below can mistake for a value because none expects an empty one.
fn attrValue(line: string, key: string): string {
  let needle = " ${key}="
  let at = indexOf(line, needle)
  if (at < 0) {
    return ""
  }
  let rest = line[at + len(needle):]
  let end = indexOf(rest, " ")
  if (end < 0) {
    return rest
  }
  return rest[0:end]
}

// The only record `s` holds; a fixture that cannot say so is broken, so it
// panics rather than asserts.
fn soleLine(s: RecordingSink): string {
  if (len(s.lines) != 1) {
    panic("want exactly one log record, got ${len(s.lines)}: '${sinkText(s)}'")
  }
  return s.lines[0]
}

// The integer after `"key":` in the sole JSON record, so an interval
// assertion compares numbers rather than strings.
fn recordInt(s: RecordingSink, key: string): int {
  let line = soleLine(s)
  let needle = "\"${key}\":"
  let at = indexOf(line, needle)
  if (at < 0) {
    panic("no \"${key}\" in '${line}'")
  }
  let rest = line[at + len(needle):]
  let end = 0
  while (end < len(rest) && rest[end] >= '0' && rest[end] <= '9') {
    end = end + 1
  }
  let n = parseInt(rest[0:end]) catch e {
    panic("\"${key}\" in '${line}': ${e.message()}")
  }
  return n
}

// --- the record: level, method, route, status, duration -------------------

test "one request logs one INFO record carrying method, path, status and took" {
  let sink = newSink()
  let app = loggedApp(sink)
  app.get("/users", (c) => {
    return c.text("ok")
  })
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/users"))

  assert(res.status == 200, "want 200, got ${res.status}")
  assert(len(sink.lines) == 1, "want exactly one line, got ${len(sink.lines)}: '${sinkText(sink)}'")
  let line = sink.lines[0]
  assert(contains(line, "level=INFO"), "want an INFO record, got '${line}'")
  assert(contains(line, "msg=request"), "want the message `request`, got '${line}'")
  assert(attrValue(line, "method") == "GET", "want method=GET, got '${line}'")
  assert(attrValue(line, "path") == "/users", "want path=/users, got '${line}'")
  assert(attrValue(line, "status") == "200", "want status=200, got '${line}'")
  assert(attrValue(line, "took") != "", "want a took= duration, got '${line}'")
}

test "three requests log three records: one per request, never one per app" {
  let sink = newSink()
  let app = loggedApp(sink)
  app.get("/a", okHandler)
  app.post("/a", okHandler)
  freezeOrPanic(app)

  let _ = app.handle(req("GET", "/a"))
  let _ = app.handle(req("POST", "/a"))
  let _ = app.handle(req("GET", "/a"))

  assert(len(sink.lines) == 3, "want three lines, got ${len(sink.lines)}: '${sinkText(sink)}'")
}

test "the status attribute is the response's own status, not a constant" {
  let sink = newSink()
  let app = loggedApp(sink)
  app.post("/users", (c) => {
    return c.text("nope").status(422)
  })
  freezeOrPanic(app)

  let res = app.handle(req("POST", "/users"))

  assert(res.status == 422, "want 422, got ${res.status}")
  let line = soleLine(sink)
  assert(attrValue(line, "method") == "POST", "want POST, got '${line}'")
  assert(attrValue(line, "status") == "422", "want the handler's 422, got '${line}'")
}

// --- what must never be logged --------------------------------------------

test "the query string never reaches the log record" {
  let sink = newSink()
  let app = loggedApp(sink)
  app.get("/users", (c) => {
    return c.text("ok")
  })
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/users?token=secret123"))

  assert(res.status == 200, "want 200, got ${res.status}")
  let line = soleLine(sink)
  assert(!contains(line, "secret123"), "the query VALUE leaked: '${line}'")
  assert(!contains(line, "token"), "the query KEY leaked: '${line}'")
  assert(!contains(line, "?"), "the line carries a query string: '${line}'")
}

// The decision the ticket asked to be made and documented: the path field is
// the matched route PATTERN. This is the test that makes it load-bearing
// rather than incidental — a credential in a path SEGMENT is beyond the reach
// of any query strip, and only the pattern is safe from it.
test "the path attribute is the matched route pattern, so a path segment cannot leak" {
  let sink = newSink()
  let app = loggedApp(sink)
  app.get("/reset/:token", (c) => {
    return c.text("ok")
  })
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/reset/tok-secret-7"))

  assert(res.status == 200, "want 200, got ${res.status}")
  let line = soleLine(sink)
  assert(attrValue(line, "path") == "/reset/:token", "want the pattern, got '${line}'")
  assert(!contains(line, "tok-secret-7"), "the path segment leaked: '${line}'")
}

test "a Cookie and an Authorization header never reach the log record" {
  let sink = newSink()
  let app = loggedApp(sink)
  app.get("/users", (c) => {
    return c.text("ok")
  })
  freezeOrPanic(app)

  let res = app.handle(
    Request{
      method = "GET",
      path = "/users",
      headers = "Cookie: session=cookie-secret-42\r\nAuthorization: Bearer bearer-secret-99",
      body = "",
    },
  )

  assert(res.status == 200, "want 200, got ${res.status}")
  let line = soleLine(sink)
  assert(!contains(line, "cookie-secret-42"), "the cookie VALUE leaked: '${line}'")
  assert(!contains(line, "bearer-secret-99"), "the credential leaked: '${line}'")
  assert(!contains(line, "Bearer"), "the Authorization scheme leaked: '${line}'")
  assert(!contains(line, "Cookie"), "the Cookie header name leaked: '${line}'")
  assert(!contains(line, "Authorization"), "the Authorization header name leaked: '${line}'")
}

// --- the duration ---------------------------------------------------------

test "the logged duration is at least the interval the handler slept" {
  let nap = 25 * Millisecond
  let sink = newSink()
  let app = jsonLoggedApp(sink)
  app.get("/slow", (c) => {
    sleep(nap)
    return c.text("ok")
  })
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/slow"))

  assert(res.status == 200, "want 200, got ${res.status}")
  let took = recordInt(sink, "took")
  assert(took >= nap, "want at least ${nap}ns, logged ${took}ns")
}

// The sleeping middleware is registered AFTER the logger, so it is INSIDE it
// in the onion — the handler itself sleeps nothing. A duration that only
// timed the handler would read 0ms here, which is what makes this the test
// for "the whole downstream chain" rather than a second sleep test.
test "the duration covers the whole downstream chain, not just the handler" {
  let nap = 25 * Millisecond
  let sink = newSink()
  let app = jsonLoggedApp(sink)
  app.use((c, next) => {
    sleep(nap)
    return next(c)
  })
  app.get("/x", (c) => {
    return c.text("ok")
  })
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/x"))

  assert(res.status == 200, "want 200, got ${res.status}")
  let took = recordInt(sink, "took")
  assert(took >= nap, "a middleware inside the logger slept ${nap}ns; logged ${took}ns")
}

// --- a failed chain -------------------------------------------------------

// A middleware sits inside the chain, so a failure reaching it has no status
// yet — `failureRes` (adapter.bit) decides that afterwards. The record has no
// `status` and says `failed=true` rather than guessing 500, and carries no
// part of the message: the real message is `failureRes`'s own ERROR record on
// this same logger, so this test reads the logger's INFO record only.
test "a failing chain is still logged, with no status and no error message" {
  let sink = newSink()
  let app = loggedApp(sink)
  app.get("/boom", (c) => rethrow(newError("connection string: postgres://u:p@h/db")))
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/boom"))

  assert(res.status == 500, "want 500, got ${res.status}")
  let line = sink.lines[0]
  assert(contains(line, "level=INFO"), "the request record comes first, got '${line}'")
  assert(attrValue(line, "method") == "GET", "want the method, got '${line}'")
  assert(attrValue(line, "path") == "/boom", "want the route, got '${line}'")
  assert(attrValue(line, "failed") == "true", "want failed=true, got '${line}'")
  assert(attrValue(line, "status") == "", "a chain that failed has no status yet, got '${line}'")
  assert(!contains(line, "postgres://"), "the logger must not log the message: '${line}'")
}

// A miss is a request and gets a line. The app-root chain runs around the
// framework's own 404 (#4515), so a logger registered with `app.use()` sees
// it — which is the case a request log is most often read for, a scanner
// walking paths that do not exist.
//
// The path attribute is the PATH, not the pattern: there is no pattern, and
// `logTarget` (logger.bit) says so by falling back rather than by leaving
// the attribute empty.
test "an unmatched path is logged with its 404 and the path it asked for" {
  let sink = newSink()
  let app = loggedApp(sink)
  app.get("/known", okHandler)
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/nowhere"))

  assert(res.status == 404, "want 404, got ${res.status}")
  let line = soleLine(sink)
  assert(attrValue(line, "method") == "GET", "want the method, got '${line}'")
  assert(attrValue(line, "path") == "/nowhere", "want the requested path, got '${line}'")
  assert(attrValue(line, "status") == "404", "want the status the client got, got '${line}'")
}

// The control for the fallback above: a MATCHED route still logs its
// pattern, so the path attribute groups a million requests into one identity
// rather than becoming a path for every record.
test "a matched route still logs its pattern, not the request path" {
  let sink = newSink()
  let app = loggedApp(sink)
  app.get("/users/:id", okHandler)
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/users/77"))

  assert(res.status == 200, "want 200, got ${res.status}")
  let line = soleLine(sink)
  assert(attrValue(line, "path") == "/users/:id", "want the pattern, got '${line}'")
}

// --- Config.logger: the framework's own records and the level -------------

// The acceptance for #7429 in one place: a 200 is one INFO record with
// method, path and status, and a handler fault is one ERROR record that names
// the cause — which the response body never carries.
test "a 200 logs an INFO record and a handler fault logs an ERROR record without leaking the cause" {
  let sink = newSink()
  let app = adapterApp(sink)
  app.get("/ok", okHandler)
  app.get("/boom", (c) => rethrow(newError("pool exhausted: db-7.internal")))
  app.use(logger())
  freezeOrPanic(app)

  let ok = app.handle(req("GET", "/ok"))
  let bad = app.handle(req("GET", "/boom"))

  assert(ok.status == 200, "want 200, got ${ok.status}")
  assert(bad.status == 500, "want 500, got ${bad.status}")
  assert(!contains(bad.body, "pool exhausted"), "the cause reached the client: '${bad.body}'")
  assert(!contains(bad.body, "db-7.internal"), "the cause reached the client: '${bad.body}'")
  let first = sink.lines[0]
  assert(contains(first, "level=INFO"), "want an INFO record for the 200, got '${first}'")
  assert(attrValue(first, "method") == "GET", "want method=GET, got '${first}'")
  assert(attrValue(first, "path") == "/ok", "want path=/ok, got '${first}'")
  assert(attrValue(first, "status") == "200", "want status=200, got '${first}'")
  let errs = 0
  for line of sink.lines {
    if (contains(line, "level=ERROR")) {
      errs = errs + 1
      assert(
        contains(line, "pool exhausted: db-7.internal"),
        "the ERROR record names the cause: '${line}'",
      )
      assert(attrValue(line, "method") == "GET", "the ERROR record names the method: '${line}'")
      assert(attrValue(line, "path") == "/boom", "the ERROR record names the path: '${line}'")
    }
  }
  assert(errs == 1, "want exactly one ERROR record, got ${errs}: '${sinkText(sink)}'")
}

// A level above INFO silences the request records and keeps the 5xx ones:
// the request logger is `info`, the framework's own failures are `error`.
test "a Logger set to WARN drops the request records and still gets the 5xx ERROR" {
  let sink = newSink()
  let lg = Option.Some(Logger(TextHandler(sink, LevelWarn, false)))
  let app = App(Config{ secret = "test-secret", logger = lg })
  app.use(logger())
  app.get("/ok", okHandler)
  app.get("/boom", (c) => rethrow(newError("pool exhausted")))
  freezeOrPanic(app)

  let ok = app.handle(req("GET", "/ok"))
  let bad = app.handle(req("GET", "/boom"))

  assert(
    ok.status == 200 && bad.status == 500,
    "want 200 and 500, got ${ok.status} and ${bad.status}",
  )
  assert(
    len(sink.lines) == 1,
    "want only the ERROR record, got ${len(sink.lines)}: '${sinkText(sink)}'",
  )
  assert(contains(sink.lines[0], "level=ERROR"), "got '${sink.lines[0]}'")
}
