// pkg/web/router.test.bit — precedence, conflict detection, the awkward
// paths, and a measurement of the short-circuit claim (#3881's acceptance:
// "prove the precedence, do not assert it").
//
// Handler is `(Ctx) => Res!` (router.bit, widened from the `() => ()`
// placeholder by #3885) and function values are not comparable (E0052), so
// "which handler matched" is proven by CALLING the matched handler
// (`callHandler`) and observing which closure wrote to its own test-local
// `called` variable — never by comparing handler references.
//
// Nothing in this file is about the request: `Router` never builds or reads
// a `Ctx`, it only stores and returns a function value. `callHandler` hands
// the matched handler a throwaway `Ctx` so the closure can return a `Res`,
// and every assertion still reads the `called` variable, exactly as before.

import { contains } from "std/strings"
// `monotonic` and `since` (the lookup-cost test at the bottom) are imported by
// logger.bit, which needs the same monotonic clock to time a request. An
// import binds per MODULE (SPEC §17.1), so importing them again here is E0042.

// A `Ctx` good enough to CALL a matched handler with. These tests are about
// the trie, so nothing here reads the request: the registry is a fresh empty
// one (`newNameRegistry`, app.bit) and the pattern is the root.
fn routerCtx(): Ctx {
  return newCtx(
    Request{ method = "GET", path = "/", headers = "", body = "" },
    map<string, string>(),
    newNameRegistry(),
    Config{ secret = "test-secret" },
    "/",
  ) catch e {
    panic("newCtx: ${e.message()}")
  }
}

// Runs the handler `m` matched, discarding its `Res` — every assertion in
// this file reads the `called` variable the handler wrote, not what it
// returned. A handler that FAILS here is a broken fixture, not a result.
fn callHandler(m: Match) {
  let _ = m.handler(routerCtx()) catch e {
    panic("handler: ${e.message()}")
  }
}

// The handler for a route whose body no test ever observes: 200, no body.
// A real `Handler`, so these routes are the routes a served request meets.
fn okHandler(c: Ctx): Res! {
  return c.status(200)
}

// --- precedence, distinguished rather than merely exercised ---------------

// Registers `:id` BEFORE `new`, on purpose — precedence must come from the
// segment KIND, never from registration order.
test "static beats param beats wildcard, order-independent of registration" {
  let called = ""
  let hId: Handler = (c) => {
    called = "id"
    return c.status(200)
  }
  let hNew: Handler = (c) => {
    called = "new"
    return c.status(200)
  }
  let hList: Handler = (c) => {
    called = "list"
    return c.status(200)
  }
  let hFiles: Handler = (c) => {
    called = "files"
    return c.status(200)
  }

  let r = Router()
  r.add("GET", "/users/:id", hId)
  r.add("GET", "/users/new", hNew)
  r.add("GET", "/users", hList)
  r.add("GET", "/files/*path", hFiles)
  r.freeze() catch e {
    panic("freeze: ${e.message()}")
  }

  let m1 = r.lookup("GET", "/users/new") catch e {
    panic("lookup /users/new: ${e.message()}")
  }
  callHandler(m1)
  assert(called == "new", "/users/new must take the STATIC route, not :id (got '${called}')")

  called = ""
  let m2 = r.lookup("GET", "/users/42") catch e {
    panic("lookup /users/42: ${e.message()}")
  }
  callHandler(m2)
  assert(called == "id", "/users/42 must take the param route (got '${called}')")
  let (id, idOk) = m2.params["id"]
  assert(idOk, "expected an 'id' param")
  assert(id == "42", "id param: got '${id}'")

  let m3 = r.lookup("GET", "/files/a/b/c") catch e {
    panic("lookup /files/a/b/c: ${e.message()}")
  }
  let (path, pathOk) = m3.params["path"]
  assert(pathOk, "expected a 'path' param")
  assert(path == "a/b/c", "wildcard param: got '${path}'")
}

// #5863: a zero-param route's `Match.params` is `nil` — `finishMatch` never
// allocates a map it has nothing to put in — and a route that DID capture a
// param still gets one, unchanged from before.
test "a zero-param route's Match carries a nil params map, a param route's does not" {
  let r = Router()
  r.add("GET", "/health", okHandler)
  r.add("GET", "/users/:id", okHandler)
  r.freeze() catch e {
    panic("freeze: ${e.message()}")
  }

  let mStatic = r.lookup("GET", "/health") catch e {
    panic("lookup /health: ${e.message()}")
  }
  assert(mStatic.params == nil, "zero-param route must not allocate a params map")

  let mParam = r.lookup("GET", "/users/42") catch e {
    panic("lookup /users/42: ${e.message()}")
  }
  assert(mParam.params != nil, "a route with a :param must still build the map")
  let (id, ok) = mParam.params["id"]
  assert(ok && id == "42", "id param: got '${id}'")
}

// A path that could resolve through EITHER a param edge or a wildcard edge
// at the same position must take the param — the case a suite that only
// tests static-vs-param can miss entirely.
test "param beats wildcard when both could match" {
  let called = ""
  let hRest: Handler = (c) => {
    called = "rest"
    return c.status(200)
  }
  let hId: Handler = (c) => {
    called = "id"
    return c.status(200)
  }

  let r = Router()
  r.add("GET", "/x/*rest", hRest)
  r.add("GET", "/x/:id", hId)
  r.freeze() catch e {
    panic("freeze: ${e.message()}")
  }

  let m = r.lookup("GET", "/x/hello") catch e {
    panic("lookup /x/hello: ${e.message()}")
  }
  callHandler(m)
  assert(called == "id", "/x/hello must take :id, not *rest (got '${called}')")
  let (v, ok) = m.params["id"]
  assert(ok && v == "hello", "id param: got '${v}'")
}

// A static route several segments deeper than a wildcard's own edge must
// still win — the wildcard must not "swallow" a later static match just
// because it is reachable first.
test "a deep static route beats a shallower wildcard" {
  let called = ""
  let hWild: Handler = (c) => {
    called = "wild"
    return c.status(200)
  }
  let hStatic: Handler = (c) => {
    called = "static"
    return c.status(200)
  }

  let r = Router()
  r.add("GET", "/assets/*path", hWild)
  r.add("GET", "/assets/special/report", hStatic)
  r.freeze() catch e {
    panic("freeze: ${e.message()}")
  }

  let m1 = r.lookup("GET", "/assets/special/report") catch e {
    panic("lookup /assets/special/report: ${e.message()}")
  }
  callHandler(m1)
  assert(called == "static", "the fully-static path must win over the wildcard (got '${called}')")

  called = ""
  let m2 = r.lookup("GET", "/assets/other/thing") catch e {
    panic("lookup /assets/other/thing: ${e.message()}")
  }
  callHandler(m2)
  assert(
    called == "wild",
    "a non-static path must still fall through to the wildcard (got '${called}')",
  )
  let (rest, ok) = m2.params["path"]
  assert(ok && rest == "other/thing", "wildcard param: got '${rest}'")
}

// A static branch that only exists as a PREFIX of some deeper pattern (no
// handler of its own at this depth) must not block precedence from falling
// through to a param that DOES have a handler here — the trie's own
// internal bookkeeping (a node with children but no handlers) must never
// leak into the caller as a false miss.
test "a static prefix with no handler at this depth falls through to param" {
  let called = ""
  let hParam: Handler = (c) => {
    called = "param"
    return c.status(200)
  }
  let hDeep: Handler = (c) => {
    called = "deep"
    return c.status(200)
  }

  let r = Router()
  r.add("GET", "/a/b/c", hDeep)
  r.add("GET", "/a/:x", hParam)
  r.freeze() catch e {
    panic("freeze: ${e.message()}")
  }

  let m = r.lookup("GET", "/a/b") catch e {
    panic("lookup /a/b: ${e.message()}")
  }
  callHandler(m)
  assert(
    called == "param",
    "/a/b must fall through to :x, 'b' alone has no handler (got '${called}')",
  )
  let (x, ok) = m.params["x"]
  assert(ok && x == "b", "x param: got '${x}'")
}

// --- 404 vs 405, distinguishable by TYPE, not by message text -------------

test "a method mismatch is reported distinguishably from no match at all" {
  let hId: Handler = okHandler

  let r = Router()
  r.add("GET", "/users/:id", hId)
  r.freeze() catch e {
    panic("freeze: ${e.message()}")
  }

  let sawMethodNotAllowed = false
  let allowed = []string(0)
  let _ = r.lookup("DELETE", "/users/42") catch e {
    let (mna, ok) = e.(MethodNotAllowed)
    if (ok) {
      sawMethodNotAllowed = true
      allowed = mna.allowed
    }
    Match{ handler = hId, params = map<string, string>(), pattern = "" }
  }
  assert(sawMethodNotAllowed, "DELETE /users/42 must fail as MethodNotAllowed, not a plain miss")
  assert(len(allowed) == 1 && allowed[0] == "GET", "allowed methods: got ${len(allowed)}")

  let sawPlainMiss = false
  let _ = r.lookup("GET", "/nope") catch e {
    let (_, ok) = e.(MethodNotAllowed)
    sawPlainMiss = !ok
    Match{ handler = hId, params = map<string, string>(), pattern = "" }
  }
  assert(sawPlainMiss, "GET /nope must NOT be reported as MethodNotAllowed")
}

// --- freeze() conflict detection, each naming the offending pattern(s) ----

test "freeze reports a duplicate method and pattern, naming it" {
  let h: Handler = okHandler
  let r = Router()
  r.add("GET", "/x", h)
  r.add("GET", "/x", h)
  let msg = freezeErr(r)
  assert(contains(msg, "GET"), "message must name the method: ${msg}")
  assert(contains(msg, "/x"), "message must name the pattern: ${msg}")
}

test "freeze reports a :id vs :userId clash, naming both patterns" {
  let h: Handler = okHandler
  let r = Router()
  r.add("GET", "/users/:id", h)
  r.add("POST", "/users/:userId", h)
  let msg = freezeErr(r)
  assert(contains(msg, "/users/:id"), "message must name the first pattern: ${msg}")
  assert(contains(msg, "/users/:userId"), "message must name the second pattern: ${msg}")
}

test "freeze reports a non-final wildcard" {
  let h: Handler = okHandler
  let r = Router()
  r.add("GET", "/files/*path/extra", h)
  let msg = freezeErr(r)
  assert(contains(msg, "/files/*path/extra"), "message must name the pattern: ${msg}")
  assert(contains(msg, "wildcard"), "message must say why: ${msg}")
}

// --- awkward paths, each with a specified (not incidental) behaviour ------

// "" and "/" both mean the root, and are the SAME lookup target.
test "an empty path and a bare slash both mean the root" {
  let called = ""
  let h: Handler = (c) => {
    called = "root"
    return c.status(200)
  }
  let r = Router()
  r.add("GET", "/", h)
  r.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  let m1 = r.lookup("GET", "/") catch e {
    panic("lookup '/': ${e.message()}")
  }
  callHandler(m1)
  assert(called == "root", "'/' must match the root route")

  called = ""
  let m2 = r.lookup("GET", "") catch e {
    panic("lookup '': ${e.message()}")
  }
  callHandler(m2)
  assert(called == "root", "'' must match the root route exactly like '/'")
}

// A trailing slash is a real, distinct, EMPTY final segment — never
// collapsed — so "/users/" only matches a pattern registered with that
// trailing segment, never "/users" itself.
test "a trailing slash is significant, not collapsed" {
  let called = ""
  let hPlain: Handler = (c) => {
    called = "plain"
    return c.status(200)
  }
  let hSlash: Handler = (c) => {
    called = "slash"
    return c.status(200)
  }
  let r = Router()
  r.add("GET", "/users", hPlain)
  r.add("GET", "/users/", hSlash)
  r.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  let m1 = r.lookup("GET", "/users") catch e {
    panic("lookup /users: ${e.message()}")
  }
  callHandler(m1)
  assert(called == "plain", "/users must take the no-slash route")

  called = ""
  let m2 = r.lookup("GET", "/users/") catch e {
    panic("lookup /users/: ${e.message()}")
  }
  callHandler(m2)
  assert(called == "slash", "/users/ must take the trailing-slash route, a DIFFERENT one")
}

test "a param may sit at the root, and two params may follow each other" {
  let h: Handler = okHandler

  let r1 = Router()
  r1.add("GET", "/:only", h)
  r1.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  let m1 = r1.lookup("GET", "/hello") catch e {
    panic("lookup /hello: ${e.message()}")
  }
  let (only, onlyOk) = m1.params["only"]
  assert(onlyOk && only == "hello", "root param: got '${only}'")

  let r2 = Router()
  r2.add("GET", "/:a/:b", h)
  r2.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  let m2 = r2.lookup("GET", "/x/y") catch e {
    panic("lookup /x/y: ${e.message()}")
  }
  let (a, aOk) = m2.params["a"]
  let (b, bOk) = m2.params["b"]
  assert(aOk && a == "x", "first param: got '${a}'")
  assert(bOk && b == "y", "second param: got '${b}'")
}

// No percent-decoding happens anywhere in this module: a captured segment
// comes back byte-for-byte as it appeared in the request path.
test "a percent-encoded segment is captured literally, not decoded" {
  let h: Handler = okHandler
  let r = Router()
  r.add("GET", "/search/:term", h)
  r.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  let m = r.lookup("GET", "/search/hello%20world") catch e {
    panic("lookup: ${e.message()}")
  }
  let (term, ok) = m.params["term"]
  assert(ok && term == "hello%20world", "term param: got '${term}', expected the raw encoded text")
}

// --- scale: correctness and cost among a large route table ----------------

// 1000 unrelated static routes plus one 4-segment target — the target must
// still resolve correctly.
test "a table of 1000 registered routes still matches a 4-segment path" {
  let h: Handler = okHandler
  let r = Router()
  let i = 0
  while (i < 1000) {
    r.add("GET", "/r${i}", h)
    i = i + 1
  }
  r.add("GET", "/api/v1/users/:id", h)
  r.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  let m = r.lookup("GET", "/api/v1/users/777") catch e {
    panic("lookup: ${e.message()}")
  }
  let (id, ok) = m.params["id"]
  assert(ok && id == "777", "id param amid 1000 routes: got '${id}'")
}

// The short-circuit claim, measured rather than asserted: looking up the
// SAME 4-segment path costs about the same whether it is the only route
// registered or one of 1001. A route COUNT that mattered (an O(n) scan)
// would show roughly a 1000x gap between these two; a per-segment radix
// walk shows close to 1x. 5000 lookups per router, to average out clock
// noise; the tolerance (8x, plus a fixed 1ms floor) is generous on purpose
// since this runs on a shared, often-contended build box (see
// bitlang-ws/CLAUDE.md's timing notes) — the point is ruling out O(n)
// growth, not a tight benchmark.
test "lookup cost does not grow with the number of registered routes" {
  let h: Handler = okHandler
  let target = "/api/v1/users/777"
  let iterations = 5000

  let small = Router()
  small.add("GET", "/api/v1/users/:id", h)
  small.freeze() catch e {
    panic("freeze small: ${e.message()}")
  }

  let big = Router()
  let i = 0
  while (i < 1000) {
    big.add("GET", "/r${i}", h)
    i = i + 1
  }
  big.add("GET", "/api/v1/users/:id", h)
  big.freeze() catch e {
    panic("freeze big: ${e.message()}")
  }

  let smallNs = timeLookups(small, target, iterations)
  let bigNs = timeLookups(big, target, iterations)
  print("router bench: 1 route = ${smallNs}ns, 1001 routes = ${bigNs}ns, over ${iterations} lookups each\n")

  assert(
    bigNs < smallNs * 8 + 1000000,
    "1001-route lookup (${bigNs}ns) should not scale with route count vs. the 1-route baseline (${smallNs}ns)",
  )
}

fn timeLookups(r: Router, path: string, iterations: int): int {
  let start = monotonic()
  let i = 0
  while (i < iterations) {
    let _ = r.lookup("GET", path) catch e {
      panic("lookup: ${e.message()}")
    }
    i = i + 1
  }
  return since(start)
}

// Runs freeze() on a router already known to hold a conflict and returns
// the error message, panicking if freeze() unexpectedly succeeds — every
// conflict-detection test in this file shares this shape.
fn freezeErr(r: Router): string {
  let msg = ""
  let _ = r.freeze() catch e {
    msg = e.message()
  }
  assert(len(msg) > 0, "expected freeze() to fail")
  return msg
}

// --- staticRoutes (#5899): the map must answer exactly as the walk does ----

// Which handler a Match carries, observable without comparing function
// values (E0052): each `tagged` handler writes its own tag here when called.
class Recorder {
  last: string,
}

fn tagged(rec: Recorder, tag: string): Handler {
  return (c) => {
    rec.last = tag
    return c.status(200)
  }
}

// The reference: today's segment walk, with `staticRoutes` never consulted.
fn walkLookup(r: Router, method: string, path: string): Match! {
  match (matchNode(r.root, splitSegments(path), 0)) {
    None => fail newError("no route matches ${method} ${path}")
    Some(mi) => return finishMatch(mi.node, paramsMap(mi.params), method, path)?
  }
}

// One outcome as text: the handler's tag, the pattern and every param for a
// match (`nil` params spelled apart from an empty map); the error kind, the
// allowed list and the message for a miss.
fn matchText(rec: Recorder, m: Match): string {
  rec.last = ""
  callHandler(m)
  if (m.params == nil) {
    return "ok ${rec.last} ${m.pattern} params=nil"
  }
  let keys = []string(0)
  for (k, _) of m.params {
    keys = append(keys, k)
  }
  let pairs = []string(0)
  for k of sorted(keys, (a, b) => a < b) {
    let (v, _) = m.params[k]
    pairs = append(pairs, "${k}=${v}")
  }
  return "ok ${rec.last} ${m.pattern} params=${join(pairs, ",")}"
}

fn missText(e: error): string {
  let (mna, ok) = e.(MethodNotAllowed)
  if (ok) {
    return "405 ${join(mna.allowed, ",")} ${e.message()}"
  }
  return "404 ${e.message()}"
}

fn lookupText(r: Router, rec: Recorder, method: string, path: string): string {
  let m = r.lookup(method, path) catch e {
    return missText(e)
  }
  return matchText(rec, m)
}

fn walkText(r: Router, rec: Recorder, method: string, path: string): string {
  let m = walkLookup(r, method, path) catch e {
    return missText(e)
  }
  return matchText(rec, m)
}

// A router and the recorder its `tagged` handlers write to.
class Probe {
  r: Router,
  rec: Recorder,
}

// Asserts `lookup` and the walk agree on `method path`, that `path` took the
// map (`wantHit`) or the walk, and that the shared answer is `want`, so a
// map that is never built or never consulted cannot pass by agreeing.
fn expectSame(p: Probe, method: string, path: string, wantHit: bool, want: string) {
  let r = p.r
  let rec = p.rec
  let (_, hit) = r.staticRoutes[staticKey(path)]
  assert(hit == wantHit, "${method} '${path}': staticRoutes hit=${hit}, want ${wantHit}")
  let got = lookupText(r, rec, method, path)
  let ref = walkText(r, rec, method, path)
  assert(got == ref, "${method} '${path}': lookup '${got}' != walk '${ref}'")
  assert(got == want, "${method} '${path}': got '${got}', want '${want}'")
}

fn mixedRouter(rec: Recorder): Router {
  let r = Router()
  r.add("GET", "/", tagged(rec, "root"))
  r.add("GET", "/users", tagged(rec, "users"))
  r.add("GET", "/users/:id", tagged(rec, "user"))
  r.add("GET", "/users/me", tagged(rec, "me"))
  r.add("DELETE", "/users/me", tagged(rec, "meDel"))
  r.add("GET", "/files/*rest", tagged(rec, "files"))
  r.add("GET", "/files/readme", tagged(rec, "readme"))
  r.add("GET", "/a", tagged(rec, "a"))
  r.add("GET", "/a/", tagged(rec, "aSlash"))
  r.add("GET", "/deep/x/y", tagged(rec, "deep"))
  r.add("GET", "/items/:id", tagged(rec, "item"))
  r.add("POST", "/items/new", tagged(rec, "itemNew"))
  r.add("GET", "/p/:id/edit", tagged(rec, "edit"))
  r.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  return r
}

test "staticRoutes answers precedence, the root and trailing slashes exactly as the walk" {
  let rec = Recorder{ last = "" }
  let p = Probe{ r = mixedRouter(rec), rec = rec }
  expectSame(p, "GET", "/", true, "ok root / params=nil")
  expectSame(p, "GET", "", true, "ok root / params=nil")
  expectSame(p, "GET", "/users", true, "ok users /users params=nil")
  expectSame(p, "GET", "users", true, "ok users /users params=nil")
  expectSame(p, "GET", "/users/me", true, "ok me /users/me params=nil")
  expectSame(p, "DELETE", "/users/me", true, "ok meDel /users/me params=nil")
  expectSame(p, "GET", "/users/42", false, "ok user /users/:id params=id=42")
  expectSame(p, "GET", "/users/", false, "ok user /users/:id params=id=")
  expectSame(p, "GET", "/files/readme", true, "ok readme /files/readme params=nil")
  expectSame(p, "GET", "/files/a/b", false, "ok files /files/*rest params=rest=a/b")
  expectSame(p, "GET", "/a", true, "ok a /a params=nil")
  expectSame(p, "GET", "/a/", true, "ok aSlash /a/ params=nil")
  expectSame(p, "GET", "/deep/x/y", true, "ok deep /deep/x/y params=nil")
  expectSame(p, "GET", "/p/7/edit", false, "ok edit /p/:id/edit params=id=7")
}

test "staticRoutes answers 404 and 405 exactly as the walk" {
  let rec = Recorder{ last = "" }
  let p = Probe{ r = mixedRouter(rec), rec = rec }
  expectSame(p, "GET", "/nope", false, "404 no route matches GET /nope")
  expectSame(p, "GET", "/files", false, "404 no route matches GET /files")
  expectSame(p, "GET", "/deep/x", false, "404 no route matches GET /deep/x")
  expectSame(p, "GET", "/a//", false, "404 no route matches GET /a//")
  expectSame(p, "GET", "//a", false, "404 no route matches GET //a")
  expectSame(p, "GET", "/users/me/", false, "404 no route matches GET /users/me/")
  expectSame(
    p,
    "POST",
    "/users/me",
    true,
    "405 DELETE,GET 405: POST /users/me not allowed (allowed: DELETE, GET)",
  )
  expectSame(
    p,
    "DELETE",
    "/users/42",
    false,
    "405 GET 405: DELETE /users/42 not allowed (allowed: GET)",
  )
  // The static node wins before the method is read: GET /items/new is a
  // 405, never a fall-through to the GET-able `/items/:id`.
  expectSame(
    p,
    "GET",
    "/items/new",
    true,
    "405 POST 405: GET /items/new not allowed (allowed: POST)",
  )
}

test "a static route registered for GET only answers POST with MethodNotAllowed" {
  let r = Router()
  r.add("GET", "/plaintext", okHandler)
  r.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  let (_, hit) = r.staticRoutes["plaintext"]
  assert(hit, "/plaintext must be in staticRoutes")
  let allowed = []string(0)
  let _ = r.lookup("POST", "/plaintext") catch e {
    let (mna, ok) = e.(MethodNotAllowed)
    assert(ok, "POST /plaintext must fail as MethodNotAllowed: ${e.message()}")
    allowed = mna.allowed
    Match{ handler = okHandler, params = nil, pattern = "" }
  }
  assert(len(allowed) == 1 && allowed[0] == "GET", "allowed: got ${join(allowed, ",")}")
}

// `Router.add` itself does not refuse a route after `freeze()` (App does,
// app.bit's `Group.register`). Such a route is absent from staticRoutes and
// the walk finds it; a method added to an indexed node is seen through the
// map, which holds the node itself, not a copy of its handlers.
test "a route added to the Router after freeze still matches" {
  let rec = Recorder{ last = "" }
  let r = Router()
  r.add("GET", "/x", tagged(rec, "x"))
  r.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  r.add("GET", "/late", tagged(rec, "late"))
  r.add("POST", "/x", tagged(rec, "xPost"))
  let p = Probe{ r = r, rec = rec }
  expectSame(p, "GET", "/late", false, "ok late /late params=nil")
  expectSame(p, "POST", "/x", true, "ok xPost /x params=nil")
}

// A failed freeze builds no map: every lookup is the walk's.
test "a router whose freeze failed never consults staticRoutes" {
  let rec = Recorder{ last = "" }
  let r = Router()
  r.add("GET", "/x", tagged(rec, "x"))
  r.add("GET", "/x", tagged(rec, "x2"))
  let _ = freezeErr(r)
  let p = Probe{ r = r, rec = rec }
  expectSame(p, "GET", "/x", false, "ok x /x params=nil")
}

fn mountTagged(g: Group, rec: Recorder) {
  g.get("/", (c) => {
    rec.last = "home"
    return c.status(200)
  })
  g.get("/x", (c) => {
    rec.last = "x"
    return c.status(200)
  })
  g.get("/u/:id", (c) => {
    rec.last = "u"
    return c.status(200)
  })
}

test "group prefixes reach staticRoutes exactly as they reach the walk" {
  let rec = Recorder{ last = "" }
  let app = testApp()
  mountTagged(app.root, rec)
  let api = app.group("/api/v1")
  mountTagged(api, rec)
  mountTagged(api.group("/admin"), rec)
  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  let p = Probe{ r = app.root.router, rec = rec }
  expectSame(p, "GET", "/", true, "ok home / params=nil")
  expectSame(p, "GET", "/x", true, "ok x /x params=nil")
  expectSame(p, "GET", "/api/v1", true, "ok home /api/v1 params=nil")
  expectSame(p, "GET", "/api/v1/x", true, "ok x /api/v1/x params=nil")
  expectSame(p, "GET", "/api/v1/admin/x", true, "ok x /api/v1/admin/x params=nil")
  expectSame(p, "GET", "/api/v1/u/9", false, "ok u /api/v1/u/:id params=id=9")
  expectSame(p, "GET", "/api/v1/", false, "404 no route matches GET /api/v1/")
}
