// pkg/web/adapter.bit — the boundary between pkg/web and stdlib/http (#3885),
// and the one place in the framework where a request becomes a response.
//
// It exists because the two handler types do not match and cannot be made to.
// `stdlib/http/server.bit:152` declares
// `listenAndServe(host, port, handler: (Request) => Response): ()!` — the
// stdlib handler is NOT fallible. Ours is `(Ctx) => Res!` (router.bit). So
// something has to sit between them, and that something is necessarily the
// single site where a failure becomes a response.
//
// `dispatch` is that seam, and `App.handle` (app.bit) is a one-line forward
// onto it. `App.listen` serves `App.serveHandler()`, which is
// `(req) => app.handle(req)` and nothing else — so the path a test exercises
// in process and the path a socket exercises are the SAME code, not two
// copies that can drift. That is the load-bearing constraint of this file:
// `listenAndServe` appears exactly once in this package, in `listen()`, and
// its handler argument is `this.serveHandler()`.
//
// Order of work, all of it here:
//   1. split the query off the target (std/http's `splitTarget`)
//   2. match method+path against the frozen trie (router.bit)
//   3. no match -> 404; matched under another method -> 405 with `Allow`
//   4. build the `Ctx` (ctx.bit) from the request, params and matched pattern
//   5. call the composed chain — middleware outermost, handler innermost,
//      composed ONCE at `freeze()` (middleware.bit), never per request. On a
//      MISS the innermost is step 3's own 404/405 and the chain around it is
//      the app-root one (#4515), so `app.use()` middleware runs for every
//      request whether or not the router matched anything
//   6. seal the session (#4496), then convert the `Res` to a `Response`
//   7. any failure at 4 or 5 goes through `failureRes`, the single mapping
//      site, which logs the real message and sends a generic one
//
// `Request`, `splitTarget`, `toLower` and `join` are already imported
// module-wide by ctx.bit/escape.bit/router.bit (an import binds per MODULE —
// SPEC §17.1), so re-importing them here is E0042.
import { Response, respond, listenAndServe } from "std/http"

// Where the framework writes what it refuses to SEND. An interface, so its
// zero value is `nil` (SPEC §13.4) and `Config.logs` is omittable exactly the
// way `Config.sessions` is; absent means stderr (`logLine`), never silence.
//
// A test sets its own sink and reads the lines back — which is the only way
// to assert the security property this design turns on: the real message is
// recorded somewhere, and it is not the response body.
export interface LogSink {
  log(line: string),
}

const statusNotFound = 404
const statusMethodNotAllowed = 405
const statusServerError = 500

const allowHeaderName = "Allow"
const acceptHeaderName = "Accept"
const contentLengthName = "Content-Length"

// The bodies the framework sends when it is answering for itself rather than
// for a handler. They carry a status and nothing else — no error message, no
// path, no stack — for the reason #3876 is filed under: a message the app
// author did not mark as client-facing must never reach a client.
const notFoundBody = "Not Found"
const methodNotAllowedBody = "Method Not Allowed"
const serverErrorBody = "Internal Server Error"

const contentTypeLower = "content-type"
const contentLengthLower = "content-length"

// Everything the failure-to-response mapping is allowed to see, as one value
// rather than four parameters — so #3876 can widen the mapping without
// touching a single call site here. `accept` is already carried for exactly
// that reason: content negotiation is #3876's rule, and this is where it will
// read the header from.
class Failure {
  err: error,
  method: string,
  path: string,
  accept: string,
}

// THE single failure-to-response site. Every `fail` that leaves the
// middleware chain, and every failure the adapter itself raises building a
// `Ctx`, becomes a response HERE and nowhere else.
//
// The rule itself is #3876's and lives in errors.bit: `mapFailure` decides
// the status and what the client may read, `errorRes` negotiates the body.
// The default is the security property — an error that did not opt into
// `HttpError` is a 500 with a generic body, and its real message goes to the
// log and never to the client.
//
// A GROUP'S OWN RENDERER (#3950) CHANGES ONLY THE LAST STEP. `splitFailure`
// takes the real error back out of the carrier a route under an `onError`
// group wraps its failures in (errors.bit) — so the mapping, the 5xx test
// and the log line below all see exactly what they saw before, and only
// `mappedRes` differs from `errorRes`. The unwrapping happens HERE, at the
// one site, which is why no other caller has to know the carrier exists.
//
// THE LOG LINE IS THE FRAMEWORK'S, not the app's, and it fires on every 5xx
// — including one an `HttpError` asked for: a server error the app named is
// still a server error somebody has to see. Below 500 there is nothing to
// report: the response IS the report, and logging every 404 a crawler earns
// is how a log stops being read.
fn failureRes(app: App, f: Failure): Res {
  let (err, renderer) = splitFailure(f.err)
  let m = mapFailure(err)
  if (m.code >= statusServerError) {
    logLine(app.config.logs, "web: ${f.method} ${f.path}: ${err.message()}")
  }
  return mappedRes(f.accept, renderer, m)
}

// `line` to the app's sink, or to stderr when it configured none. A write to
// stderr cannot be checked usefully — there is nobody left to tell that
// telling somebody failed — and `eprint` is the builtin that does it without
// a return value to discard (E0215).
fn logLine(sink: LogSink, line: string) {
  if (sink == nil) {
    eprint(line + "\n")
    return
  }
  sink.log(line)
}

fn requestFailure(req: Request, e: error): Failure {
  return Failure{ err: e, method: req.method, path: req.path, accept: "" }
}

fn ctxFailure(c: Ctx, e: error): Failure {
  return Failure{
    err: e,
    method: c.method(),
    path: c.path(),
    accept: c.header(acceptHeaderName),
  }
}

// The whole request path except the socket: everything `listen()` does per
// request, minus accepting the connection and writing the bytes. `App.handle`
// forwards to it, so a test that calls `app.handle(req)` runs the real
// router, the real chain, the real `Ctx` construction and the real failure
// mapping — which is what catches a route registered at the wrong path or
// sitting behind the wrong middleware, and what calling a handler function
// directly cannot.
fn dispatch(app: App, req: Request): Response {
  let out = routed(app, req)
  if (req.method != methodHead) {
    return out
  }
  return withoutContent(app, out)
}

// Steps 1-7 above. Separated from `dispatch` only so that the HEAD rule has
// exactly one response to apply itself to, however the request was answered.
fn routed(app: App, req: Request): Response {
  let (path, _) = splitTarget(req.path)
  let m = app.root.router.lookup(req.method, path) catch e {
    return unmatched(app, req, path, e)
  }
  return matchedResponse(app, req, m)
}

// RFC 9110 §9.3.2: "The HEAD method is identical to GET except that the server
// MUST NOT send content in the response." EVERY HEAD passes through here — a
// registered HEAD route (#4536), the GET fallback below, a 404, a 405, a
// failure — so no route and no middleware can put content on one, and a
// handler written for GET and registered for HEAD cannot leak a body.
//
// Content only: the status and every header are the handler's and stay its
// own.
//
// The `Content-Length` of what is about to be dropped is declared here, and
// this is the one site that can do it — after this returns, the number is
// gone. RFC 9110 §9.3.2 asks for "the same header fields ... as it would have
// sent if the request method had been GET"; `serializeResponse` (stdlib/http)
// honours a single well-formed declared field on a HEAD whose body is already
// empty for exactly this reason (#4635) and counts the bytes whenever there
// are any to count (#4640), so this is the only way the real length reaches
// the wire once the bytes are gone.
//
// Claimed ONLY when there was content. A chain that answered the HEAD itself
// with an empty body (static.bit does) knows the representation's real length
// and this function does not, so `Content-Length: 0` here would be a wrong
// answer rather than a missing one.
//
// The `setHeader` can only fail on a malformed field name or value; the name
// is a constant and the value is `${n}`, digits. A framework bug is worth the
// log line rather than a dropped response — and the failure is recorded, not
// discarded (E0215).
fn withoutContent(app: App, out: Response): Response {
  let n = len(out.body)
  out.body = ""
  if (n == 0) {
    return out
  }
  out.setHeader(contentLengthName, "${n}") catch e {
    logLine(app.config.logs, "web: HEAD: ${e.message()}")
  }
  return out
}

// Nothing is registered for this request's own method. A `HEAD` gets one more
// attempt against the `GET` route (RFC 9110 §9.3.2: HEAD is identical to GET
// except that the response carries no content, so a server that answers GET
// on a resource answers HEAD on it); every other method is a miss now.
//
// This runs only AFTER the lookup for the request's own method failed, which
// is what makes a registered `HEAD` route win: it was found above and never
// reached here. The fallback is not a second route table and adds no entry —
// the trie is untouched, so `Allow` on a real 405 still lists exactly what
// was registered.
//
// `e` — the ORIGINAL failure — is what a failed fallback reports, not the
// GET lookup's: the client asked for HEAD, and the `Allow` header on a 405
// must name the methods this path really has.
//
// The GET chain runs on the request exactly as it arrived — `c.method()` is
// still "HEAD", so a middleware that distinguishes the two (`static`,
// static.bit) keeps doing so — and the response goes back through
// `matchedResponse` unchanged. Both halves of RFC 9110 §9.3.2, dropping the
// content and declaring the length it had, are `withoutContent`'s on the way
// out of `dispatch`: a registered HEAD route needs the identical treatment,
// and one rule is better than two that can drift.
fn unmatched(app: App, req: Request, path: string, e: error): Response {
  if (req.method != methodHead) {
    return missResponse(app, req, e)
  }
  let m = app.root.router.lookup(methodGet, path) catch _ {
    return missResponse(app, req, e)
  }
  return matchedResponse(app, req, m)
}

// Nothing matched, so the framework answers for itself. 405 — with the
// `Allow` header RFC 9110 §15.5.6 makes mandatory, listing every method
// registered at this exact path — when the path IS registered under other
// methods (`MethodNotAllowed`, router.bit); 404 otherwise. Never 404 for a
// path that exists under another method: that hides a route from a client
// that could have used it correctly, and turns a fixable 405 into a bug
// report.
//
// A `Res`, not a `Response`: it is the INNERMOST handler of the app-root
// middleware chain (below), so it has to be the same kind of value a route's
// handler returns or the chain could not wrap it.
fn missRes(e: error): Res {
  let (na, ok) = e.(MethodNotAllowed)
  if (!ok) {
    return newRes(statusNotFound, textContentType, notFoundBody)
  }
  let r = newRes(statusMethodNotAllowed, textContentType, methodNotAllowedBody)
  r.set(allowHeaderName, join(na.allowed, ", "))
  return r
}

// The innermost handler of the app-root chain (`missHandlerFor`,
// middleware.bit), reading the per-request lookup failure `missResponse`
// recorded on the `Ctx`. A named function rather than a closure so the chain
// composed at `freeze()` captures nothing per request.
fn missFinal(c: Ctx): Res! {
  return missRes(c.routeMiss)
}

// A request that matched no route. The APP-ROOT middleware chain runs around
// the framework's own 404/405 exactly as it runs around a matched handler
// (#4515): `App.use` means "every request reaching this app", so a logger
// sees the miss, a compressor compresses it, and `static()` can answer a
// path that has no route at all. Group-scoped `use()` is route-only and
// stays so — `missHandlerFor` reads the ROOT group's list and nothing else.
//
// The chain is `app.missHandler`, composed once at `freeze()`. The only
// per-request part is `e`, which travels on the `Ctx` (`routeMiss`,
// ctx.bit) because the composed chain hands its innermost handler nothing
// else. There are no params and no matched pattern, so both are empty: a
// miss has no route, and saying it has one would make `c.created()` derive a
// `Location` from the client's spelling of a path the server does not serve.
fn missResponse(app: App, req: Request, e: error): Response {
  let c = newCtx(req, map<string, string>(), app.root.registry, app.config, "") catch ce {
    return frame(app, failureRes(app, requestFailure(req, ce)))
  }
  c.routeMiss = e
  return chainResponse(app, c, app.missHandler)
}

// A matched route.
fn matchedResponse(app: App, req: Request, m: Match): Response {
  let c = newCtx(req, m.params, app.root.registry, app.config, m.pattern) catch e {
    return frame(app, failureRes(app, requestFailure(req, e)))
  }
  return chainResponse(app, c, m.handler)
}

// Runs one composed chain and converts whatever comes back. Both exits seal
// the session (#4496) and both go through `frame`, so there is one
// conversion and one cookie decision however the request ends — and the
// matched path and the miss path share them rather than carrying two copies
// that can drift.
fn chainResponse(app: App, c: Ctx, h: Handler): Response {
  let r = h(c) catch e {
    return frame(app, c.sealSession(failureRes(app, ctxFailure(c, e))))
  }
  return frame(app, c.sealSession(r))
}

// The one place a `Res` becomes a `Response` (named `frame`, not `render` —
// node.bit already exports `render(Node)` and a module has one declaration
// namespace, SPEC §17.1). A `Res` std/http refuses to FRAME becomes a logged
// 500 carrying no headers at all — not a panic on the response path, and not
// a header smuggled onto the wire. `Res.set` (res.bit)
// already refused CR, LF and NUL at the write; this is std's own narrower
// RFC 9110 token check on top, and the two disagreeing is a framework bug
// worth a log line rather than a dropped connection.
fn frame(app: App, r: Res): Response {
  let out = toResponse(r) catch e {
    logLine(app.config.logs, "web: refusing to frame a response: ${e.message()}")
    return respond(statusServerError, serverErrorBody)
  }
  return out
}

// `Res` -> stdlib `Response`. `Content-Type` moves into the dedicated
// `Response.contentType` field rather than staying among the other headers,
// because `serializeResponse` (stdlib/http/http.bit) emits that field on
// every response unconditionally — leaving ours in `headers` would put a
// second `Content-Type` on the wire. A `Res` that carries none keeps
// `respond`'s own default, which is the only spelling std/http offers: the
// field is not omittable.
//
// `Content-Length` is DROPPED rather than lifted, because there is no field
// to lift it into and no value here that could be right (#4530). The framing
// layer owns it: `serializeResponse` writes exactly one, counted from the
// bytes it is about to write, and discards any other (#4535). An app-set
// length therefore never reaches a client, and carrying it in
// `Response.headers` would only tell an in-process caller of `app.handle`
// something about the wire that is not true. The framework's own claim on a
// HEAD (`withoutContent`) is set on the `Response` AFTER this conversion and
// is not affected: a `Content-Length` in `Response.headers` is the
// framework's, never the app's.
//
// `Res.declaredLen` (res.bit) is the other half of that rule and the reason
// the drop above can be unconditional. A framework middleware that answers a
// HEAD without reading the representation — `static()` — knows a length no
// later layer can recover, and writes it to that module-private field rather
// than to a header app code could also set. It becomes the response's
// `Content-Length` here, once, after every app header has been through the
// loop.
//
// Every other header goes through `addHeader`, not `setHeader`: `Set-Cookie`
// legitimately repeats, and `Res.set` already collapsed the ones that must
// not.
fn toResponse(r: Res): Response! {
  let out = respond(r.statusCode(), r.body())
  for h of r.headerList() {
    let name = toLower(h.name)
    if (name == contentTypeLower) {
      out.contentType = h.value
      continue
    }
    if (name == contentLengthLower) {
      continue
    }
    out.addHeader(h.name, h.value)?
  }
  if (r.declaredLen > 0) {
    out.setHeader(contentLengthName, "${r.declaredLen}")?
  }
  return out
}

// The handler value `App.listen` hands to `listenAndServe`, built here so
// that file's `listen()` has nothing in it but a freeze and one call. It
// forwards to `app.handle` and does nothing else — the served path IS the
// tested path.
fn serveHandlerFor(app: App): (Request) => Response {
  return (req) => app.handle(req)
}
