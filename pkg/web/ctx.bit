// pkg/web/ctx.bit — Ctx (#3883): the input side handed to every handler and
// every middleware. Response helpers are #3884; this owns the request,
// parsed headers, route params, query and named-route resolution.
//
// Header parsing is THIS package's job: stdlib/http/http.bit's `Request`
// carries `headers` as one raw, unparsed field ("Name: value\r\n" repeated,
// no CRLF after the LAST line — see `readMessage` in http.bit). `newCtx`
// parses it once, on construction, into a case-insensitive multi-value
// lookup (`parseHeaders` below), independent of whatever std/http itself
// already bounds at the wire level — a `Request` can be built by hand (a
// test, a future non-HTTP adapter) as easily as by std/http.
//
// Route params come from the router (#3881's `Match.params`), passed in by
// the caller — never re-parsed from the path here.
//
// The name registry cannot be module state (`let S = R{...}` at module
// scope is `E0082`), so `Ctx` holds a reference to the SAME `NameRegistry`
// `App`/`Group` already share (app.bit) — `c.route()` is `NameRegistry.
// lookup()` plus positional param substitution against the pattern's own
// segments, reusing router.bit's `splitSegments`/`isParamSeg`/
// `isWildcardSeg` rather than re-parsing pattern syntax a second way.

import { isSome, unwrap } from "std/core"
import { Request, splitTarget, parseQuery } from "std/http"
import { indexOf, trimSpace } from "std/strings"

// Independent of std/http's own wire-level `maxHeaderBytes` (which bounds
// bytes read off the socket, not what `Ctx` is willing to parse): a request
// cannot make this parser allocate without bound, however it was built.
// 8 KiB / 100 lines is generous for ordinary headers and matches the order
// of magnitude other servers cap at (nginx: 8 KiB per line; this is a
// total-block cap, not per-line).
const maxHeaderBytes = 8192
const maxHeaderCount = 100

// Parses a raw header block into a case-insensitive, multi-value lookup
// keyed by lowercased name. Fails outright — never truncates — when either
// cap is exceeded, since a truncated parse would silently drop a header a
// handler goes on to trust. A line with no colon, or an empty name (a
// colon at position 0), is dropped rather than guessed at: it is never
// recorded as a name with an empty value, so `headers(name)` on a dropped
// line's text returns an empty slice, not a one-element slice holding "".
fn parseHeaders(raw: string): map<string, []string>! {
  if (len(raw) > maxHeaderBytes) {
    fail newError("web: header block is ${len(raw)} byte(s), exceeds the ${maxHeaderBytes}-byte cap")
  }
  let out = map<string, []string>()
  if (len(raw) == 0) {
    return out
  }
  let lines = split(raw, "\r\n")
  if (len(lines) > maxHeaderCount) {
    fail newError("web: request has ${len(lines)} header line(s), exceeds the ${maxHeaderCount}-line cap")
  }
  for line of lines {
    if (len(line) == 0) {
      continue
    }
    let colon = indexOf(line, ":")
    if (colon <= 0) {
      // No colon at all (-1), or an empty name (":x" -> colon == 0): dropped.
      continue
    }
    let name = toLower(line[0:colon])
    let value = trimSpace(line[colon + 1:len(line)])
    let (existing, ok) = out[name]
    if (ok) {
      out[name] = append(existing, value)
    } else {
      out[name] = []string{ value }
    }
  }
  return out
}

export class Ctx {
  req: Request
  reqPath: string
  queryValues: map<string, string>
  params: map<string, string>
  registry: NameRegistry
  headerValues: map<string, []string>
  // The fully-prefixed pattern the router matched for this request
  // (`Match.pattern`, router.bit) — `/api/v1/users`, never `/users`, because
  // `Group.register` folds every group prefix in before the router sees it.
  //
  // It is what `c.created(id)` derives a `Location` from. Held as the
  // SERVER's spelling of the route rather than being re-derived from
  // `reqPath`, which is the client's: see `routeLocation` (res.bit).
  routePattern: string
  // The settings the app handed to `App` (config.bit). Held, never copied
  // field by field: a `Ctx` that took only the settings it needs today
  // would have to be re-plumbed by every ticket that adds one.
  config: Config
  // At most one `Session` per request (#3947). `Option` rather than a plain
  // `Session` field because a class has no `nil` (SPEC §13.4) and so could
  // be neither omitted nor left empty; `Option.None` IS the zero value of
  // this field, so `newCtx` never has to spell it.
  sessionCache: Option<Session>
  // The router's own lookup failure, on a request that matched NO route
  // (#4515). `nil` — `error` is an interface, so that is its zero value
  // (SPEC §13.4) — on every matched request, which is why `newCtx` never
  // spells it.
  //
  // It is here because the app-root middleware chain is composed ONCE, at
  // `freeze()` (`missHandlerFor`, middleware.bit), and its innermost handler
  // receives nothing but this `Ctx`: the 404-or-405 answer is a per-REQUEST
  // fact, so it travels on the per-request value. `missFinal` (adapter.bit)
  // is the only reader.
  routeMiss: error

  // A route param by name, or "" if `name` is not one of this route's
  // params. Never fallible — an absent param is not an error (SPEC-level
  // decision recorded on #3883: anything that must be present is validated
  // where its type is bound, #3877/#3880, not by making every accessor
  // fallible).
  export param(name: string): string {
    let (v, ok) = this.params[name]
    if (ok) {
      return v
    }
    return ""
  }

  // A decoded query-string value by name, or "" if absent. Percent-decoding
  // and the last-wins duplicate policy are std/http's own (`parseQuery`,
  // stdlib/http/query.bit) — reused here, not reimplemented.
  export query(name: string): string {
    let (v, ok) = this.queryValues[name]
    if (ok) {
      return v
    }
    return ""
  }

  // The first value of header `name` (case-insensitive), or "" if absent.
  export header(name: string): string {
    let all = this.headers(name)
    if (len(all) == 0) {
      return ""
    }
    return all[0]
  }

  // Every value of header `name` (case-insensitive), in the order they
  // appeared. A repeated header is never overwritten — this is the only
  // accessor that can see a repeat; `header()` returns just the first.
  export headers(name: string): []string {
    let (v, ok) = this.headerValues[toLower(name)]
    if (ok) {
      return v
    }
    return []string(0)
  }

  export method(): string {
    return this.req.method
  }

  export path(): string {
    return this.reqPath
  }

  // The address of the socket this request arrived on (`Request.peer`,
  // #4527), or "" when there is none — a `Request` built by hand, an
  // in-process call through `App.handle`, or the HTTP/3 path, which runs
  // over a bound UDP socket with no connected peer to name (#4555).
  //
  // This reads NO request header, and it never will: every forwarding
  // header is a client-supplied string, so keying a rate limit, a ban or an
  // audit record on one keys it on what the attacker chose to type. What
  // this returns is what the kernel says the other end of the socket is,
  // which is the only address in this stack a client cannot forge.
  //
  // Behind a reverse proxy that address is the PROXY. That is correct, not
  // a defect in this method: preferring a forwarding header is a
  // deployment-specific decision that is only sound when the proxy is known
  // to overwrite it and the app is unreachable except through the proxy, so
  // it belongs in an opt-in middleware carrying the operator's trusted
  // proxy list. See "The client address" in the README.
  export peer(): string {
    return this.req.peer
  }

  // --- the request body (#3877, body.bit) ------------------------------
  //
  // Four one-line forwards onto body.bit, HERE for the same reason the ten
  // response forwards below are here: since 0.2.0 a method may only be
  // declared in the class body (SPEC §10.4). Every rule they carry — the
  // `Config.maxBody` cap, the `Content-Type` refusal, the unknown-field
  // policy and the mapping of a decode failure onto a status — lives in
  // body.bit, in one copy.

  // The unparsed body, refused above `Config.maxBody` with a 413.
  export rawBody(): string! {
    return requestBody(this)?
  }

  // The body parsed into a `Json` tree: 413 over the cap, 415 for a
  // `Content-Type` that is not JSON, 400 for a body that does not parse.
  // The escape hatch for a payload whose shape is not a class.
  export bodyJson(): Json! {
    return requestJson(this)?
  }

  // The body bound into the type `decode` names, under the app-level
  // unknown-field policy (`Config.rejectUnknownFields`, default Reject):
  //
  //     let input = c.body((j) => jsonDecode<NewUser>(j))?
  //
  // `T` is inferred from the arrow, so the type is written exactly once.
  // The decoder is a PARAMETER rather than a type argument on this method
  // because `jsonDecode<T>` cannot be called with a type parameter today —
  // #4563, and body.bit's header has the diagnostic and the repro.
  export body<T>(decode: (Json) => T!): T! {
    let j = requestJson(this)?
    return bindJson(j, bodyPolicy(this.config), decode)?
  }

  // The same, with the unknown-field policy overridden for this one call:
  //
  //     let loose = c.bodyWith(Bind{ unknown: Unknown.Ignore }, (j) => jsonDecode<Legacy>(j))?
  //
  // Two names rather than one because Bit has no overloading.
  export bodyWith<T>(o: Bind, decode: (Json) => T!): T! {
    let j = requestJson(this)?
    return bindJson(j, o.unknown, decode)?
  }

  // This request's session (#3947, session.bit), built on the first call and
  // handed back unchanged on every later one — so a value `set` by a
  // middleware is visible to the handler, and one request never mints two
  // ids.
  //
  // It FAILS, naming the `sessions` config field, when the app configured no
  // store. That refusal cannot happen at startup: nothing static can tell
  // whether a handler body ever reaches here. Making the first access fail
  // is the loudest place left, and it is far better than the alternative the
  // ticket exists to reject — quietly handing back a working in-memory
  // session that stops working the day a second process appears.
  //
  // The load is lazy for the same reason: a request that never asks for a
  // session must not touch the store or mint an id it will never use.
  export session(): Session! {
    if (isSome(this.sessionCache)) {
      return unwrap(this.sessionCache)
    }
    let store = this.config.sessions
    if (store == nil) {
      fail newError(
          "web: c.session(): no session store is configured — set the `sessions` " +
          "field on Config, for example `Config{ secret: s, sessions: MemoryStore() }`. " +
          "This framework ships no default session store on purpose.",
      )
    }
    let s = loadSession(store, sessionIdFromCookies(this.headers("cookie")))?
    this.sessionCache = Option.Some(s)
    return s
  }

  // --- the response side (#3884, res.bit) ------------------------------
  //
  // Ten one-line forwards onto res.bit's constructors. They are HERE, in
  // the class body, because since 0.2.0 that is the only place a method may
  // be declared (SPEC §10.4); every rule they carry lives in res.bit, in one
  // copy. `header(name, value)` is deliberately NOT among them — it is a
  // `Res` method, since `Ctx.header(name)` above already reads a request
  // header and Bit has no overloading. See res.bit's header for both.

  // `v` as `application/json`, 200. `v` must carry `@json` (#3976), which is
  // what synthesizes the `toJson()` the `Jsonable` parameter requires; a
  // type without it is refused by the checker at this call site, naming the
  // missing method.
  export json(v: Jsonable): Res {
    return this.finish(jsonRes(v))
  }

  // A LIST of `@json` values as a JSON array, 200 (#4011). A separate name
  // rather than an overload of `json`, which Bit does not have — and `[]User`
  // could not satisfy the `Jsonable` parameter above in any case, since a list
  // is not a class, carries no attribute, and so cannot be converted to an
  // interface however marked its element is.
  //
  // The `T: Jsonable` bound IS the acceptance rule: it is the same consent
  // `json` asks for, applied one level down at the element, which is why
  // pkg/web declares no second "may this be rendered as JSON" predicate. A
  // `[]i64` or a list of an unmarked class is refused by the checker at the
  // call site (E0051; `_tests_/bit/checkercases/check_json_list_*`).
  //
  // An EMPTY list renders `[]`, never `null`: the array is whatever the
  // elements built, and for no elements that is `[]`. There is no empty
  // special case here that could decide otherwise, which is the point — the
  // two are different to a client, and a framework choosing silently between
  // them is how a client breaks.
  //
  // The loop is HERE and not in res.bit because a generic free function that
  // does a `.` on its bounded type parameter does not lower when it is
  // reached from a generic method's body (#4523, still open after #4495). The
  // status and `Content-Type` still come from res.bit's `jsonValueRes`, in
  // one copy. See res.bit's own comment there.
  export jsonList<T: Jsonable>(xs: []T): Res {
    let items = []Json(0)
    for x of xs {
      items = append(items, x.toJson())
    }
    return this.finish(jsonValueRes(Json.JsonArray(items)))
  }

  // An `Option` as its value, or `null` when it is absent (#4011) — the rule
  // `@json` already applies to an absent FIELD (#3976), applied to a whole
  // body. Absent is a JSON null with a 200, never a 404: the status belongs to
  // the handler, which is the only party that knows whether a missing row is an
  // error, and it chains `.status(404)` to say so.
  //
  // Generic, like `jsonList` beside it. It spent one merge cycle as
  // `jsonOpt(o: Option<Jsonable>)` because a generic method taking an
  // `Option<T>` stopped lowering — `error[E0092]: cannot lower a call whose
  // target could not be resolved`, at `isSome(o)` — as soon as any other
  // function anywhere in the module declared a parameter with the SAME NAME
  // (headers.bit's `secureHeaderList(o: Headers)` merged and the module stopped
  // building). That is #4531, fixed: `declTypeNodes` is keyed by decl node now,
  // not by name.
  //
  // The interface form is not merely unnecessary now, it is unsound and has to
  // go: it rested on `Option<User>` converting to `Option<Jsonable>` at the call
  // site, which SPEC §14.2 does not permit (assignability is identity, interface
  // satisfaction, an untyped constant, or `nil` — and `Option<Jsonable>` is an
  // enum, not an interface). It compiled only because `sameNominalDecl` ignored
  // type arguments, the same hole that let a declared `Hold<f64>` take a
  // `Hold<i64>` and read it back as a denormal (#4562). With arguments compared,
  // `c.jsonOpt(maybeUser)` against an `Option<Jsonable>` parameter is E0041 —
  // exactly as `[]User` against `[]Jsonable` always was.
  export jsonOpt<T: Jsonable>(o: Option<T>): Res {
    if (!isSome(o)) {
      return this.finish(jsonValueRes(Json.JsonNull))
    }
    return this.finish(jsonValueRes(unwrap(o).toJson()))
  }

  export text(s: string): Res {
    return this.finish(textRes(s))
  }

  // Takes a `Node` (#3887), never a string: building the tree escapes as it
  // goes, so user input cannot reach the page as live markup by accident.
  // `c.html(raw(s))` is how a trusted string gets in.
  export html(n: Node): Res {
    return this.finish(htmlRes(n))
  }

  // A bare status with no body. Everything that is only a number is written
  // this way — there is no helper per status, on purpose (see the ticket:
  // nobody remembers whether it is `unprocessable` or `unprocessableEntity`).
  export status(n: int): Res {
    return this.finish(statusRes(n))
  }

  // 201 with `Location` derived from the route this request matched, plus
  // `id`. Under `app.group("/api/v1")` a route `/users` gives
  // `/api/v1/users/42` — a handler never concatenates that itself, which is
  // the whole reason this method exists: a concatenated Location is WRONG
  // under a group prefix, not merely duplicated, and it breaks again on any
  // remount.
  export created(id: string): Res {
    return this.finish(createdRes(routeLocation(this.routePattern, this.params, id)))
  }

  // The escape hatch for a resource that lives somewhere other than the
  // route that created it.
  export createdUrl(target: string): Res {
    return this.finish(createdUrlRes(target))
  }

  export noContent(): Res {
    return this.finish(noContentRes())
  }

  // 302; `c.redirect(u).status(301)` is a permanent one.
  export redirect(target: string): Res {
    return this.finish(redirectRes(target))
  }

  // The one place a response picks up state the REQUEST owns. Today that is
  // exactly one thing: a session minted during this request (#3947) owes the
  // client a `Set-Cookie`, and `Session.isNew()` is what says so. A session
  // that arrived on a cookie already has one and is not re-sent.
  //
  // It reads `sessionCache` directly rather than calling `this.session()`,
  // which would MINT a session for every response on an app that has a store
  // configured and never uses it.
  //
  // The cookie is decided when the response is BUILT, so this alone cannot
  // cover a handler that first touches `c.session()` AFTER building its
  // `Res` (#4496). `sealSession` below is the close-out the adapter runs
  // once the handler has returned, when the answer is finally known.
  finish(r: Res): Res {
    if (isSome(this.sessionCache)) {
      let s = unwrap(this.sessionCache)
      if (s.isNew()) {
        return r.header(setCookieName, s.cookie())
      }
    }
    return r
  }

  // The session close-out, run by the adapter (adapter.bit) after the
  // handler has returned and before the response is framed — #4496.
  //
  // `finish()` above attaches the cookie when a response is BUILT, which is
  // the wrong moment for a handler written in this order:
  //
  //     let r = c.text("hi")        // sessionCache is still None here
  //     c.session()?.set("k", "v")  // minted AFTER the response was built
  //     return r
  //
  // That response was well-formed and the store write succeeded; only the
  // client never learned the id, so the session was lost on the next
  // request — silently, which is the whole reason it needed closing. The
  // adapter is the only layer that sees the `Ctx` after the handler is
  // finished, so this is where the question can be asked once and answered
  // correctly.
  //
  // It ADDS, never overwrites: a handler that set its own `Set-Cookie` on
  // this response made an explicit choice, and a framework that quietly
  // replaced it would be the same class of bug in the other direction.
  sealSession(r: Res): Res {
    if (!isSome(this.sessionCache)) {
      return r
    }
    let s = unwrap(this.sessionCache)
    if (!s.isNew()) {
      return r
    }
    if (len(r.headerValue(setCookieName)) > 0) {
      return r
    }
    return r.header(setCookieName, s.cookie())
  }

  // The CSRF token for this request's session (#3948, csrf.bit) — the value
  // to put in a form's hidden `_csrf` field or an `X-CSRF-Token` header.
  // `HMAC-SHA256(Config.secret, session id)`, hex.
  //
  // A session minted during THIS request is written to the store here, and
  // that write is not an optimisation to remove: the token is bound to the
  // session ID, and an id that is not in the store is one `loadSession`
  // replaces on the next request (session.bit, deliberately — adopting an
  // unknown id is session fixation). So without the write, every token
  // issued to a first-time visitor would fail its own check on submission.
  // `persist()` and not `save()` because a first-time visitor's session
  // holds no data and `save()` writes only what is dirty; since #4483 an
  // empty stored session is distinguishable from a store miss, which is
  // what makes writing an empty one meaningful and what removed the marker
  // key this used to write instead.
  //
  // Fails naming the `Config` field to fix when the app configured no
  // session store (`sessions`, through `session()`) or left `secret` empty.
  export csrfToken(): string! {
    let s = this.session()?
    if (s.isNew()) {
      s.persist()?
    }
    return csrfTokenOf(this.config, s)?
  }

  // Resolves a registered name (`App`/`Group`'s `.name()`, app.bit) to a
  // URL with `args` filled positionally into the pattern's own param/
  // wildcard segments, in registration order, and every group prefix
  // already applied — the pattern stored against the name IS the
  // fully-prefixed one (app.bit's `Route.name`). An unknown name fails
  // naming every currently-registered name; a wrong argument count fails
  // naming the pattern and the count it expected.
  //
  // `args` is `[]string`, not the ticket's original `...args: string` —
  // a VARIADIC parameter on a class METHOD miscompiles here, filed as
  // #4439: calling it at two different arities from different call sites
  // fails IR verification (`bit: IR verification failed ... calls @route
  // with N argument(s), but @route declares M parameter(s)`), and
  // spreading a slice into it (`c.route(name, ...xs)`) does not lower at
  // all (`E0092`). A free FUNCTION's variadic parameter has neither
  // problem — the bug is method-specific, proven with a standalone
  // repro on #4439. `[]string` sidesteps both: `c.route("x", []string(0))`,
  // `c.route("x", []string{ "42" })`.
  export route(name: string, args: []string): string! {
    let pattern = this.registry.lookup(name) catch e {
      fail newError("web: c.route: ${e.message()} (registered: ${registeredNames(this.registry)})")
    }
    return fillRoutePattern(name, pattern, args)?
  }
}

// Every name currently recorded in `r`, sorted and comma-joined, or
// "none registered" if there are none — the list an unknown-name failure
// names. `r.names` is an unexported field of an unexported class
// (app.bit's `NameRegistry`); both are module-private, not file-private
// (SPEC §17.3), so reading it here from a sibling file in the same module
// is legal, the same seam app.test.bit already reaches through.
fn registeredNames(r: NameRegistry): string {
  let names = []string(0)
  for (k, _) of r.names {
    names = append(names, k)
  }
  if (len(names) == 0) {
    return "none registered"
  }
  return join(sorted(names, (a, b) => a < b), ", ")
}

// Substitutes `args` positionally into `pattern`'s param (`:x`) and
// wildcard (`*x`) segments, reusing router.bit's own segment splitter and
// segment-kind predicates rather than re-parsing pattern syntax a second
// way. `pattern` is always a router-registered, fully-prefixed pattern (it
// came out of `NameRegistry.lookup`), so its dynamic-segment count is fixed
// before this ever runs — this only reconciles it against what the caller
// supplied.
fn fillRoutePattern(name: string, pattern: string, args: []string): string! {
  let segs = splitSegments(pattern)
  let want = 0
  for seg of segs {
    if (isParamSeg(seg) || isWildcardSeg(seg)) {
      want = want + 1
    }
  }
  if (want != len(args)) {
    fail newError("web: c.route: '${name}' (pattern '${pattern}') takes ${want} argument(s), got ${len(args)}")
  }
  let out = []string(0)
  let ai = 0
  for seg of segs {
    if (isParamSeg(seg) || isWildcardSeg(seg)) {
      out = append(out, args[ai])
      ai = ai + 1
    } else {
      out = append(out, seg)
    }
  }
  if (len(out) == 0) {
    return "/"
  }
  return "/" + join(out, "/")
}

// Builds a `Ctx` for one request: splits `req.path` into the matched path
// and the raw query once (std/http's `splitTarget`), decodes the query
// (`parseQuery`), and parses `req.headers` (`parseHeaders`, above) —
// failing rather than constructing a `Ctx` on a request whose header block
// breaks either cap. `params` is the router's own `Match.params` (#3881);
// `registry` is the App's `NameRegistry` (app.bit) that named this route,
// if any; `routePattern` is that same `Match`'s `pattern` — the fully
// prefixed route the request matched, which `c.created(id)` derives a
// `Location` from. It is passed in rather than looked up here because the
// router is the only thing that knows WHICH pattern matched, and it already
// returns it.
export fn newCtx(
  req: Request,
  params: map<string, string>,
  registry: NameRegistry,
  config: Config,
  routePattern: string,
): Ctx! {
  let (path, rawQuery) = splitTarget(req.path)
  let headerValues = parseHeaders(req.headers)?
  return Ctx{
    req: req,
    reqPath: path,
    queryValues: parseQuery(rawQuery),
    params: params,
    registry: registry,
    headerValues: headerValues,
    config: config,
    routePattern: routePattern,
  }
}
