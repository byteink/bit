// pkg/web's side of the TechEmpower tier 1-2 comparison (#5418). The five
// other servers under ../ answer the same two routes with byte-identical
// bodies and Content-Types; bench/remote.sh proves that before it times
// anything.
import { App, Config, Ctx, Res } from "web"
// `@json` desugars to calls on `Json`/`JsonEntry`, resolved by ordinary scope
// rules, so the generated `toJson` needs both names imported here.
import { Json, JsonEntry } from "std/json"

@json
class Message {
  message: string,
}

fn plaintext(c: Ctx): Res! {
  return c.text("Hello, World!")
}

fn jsonMsg(c: Ctx): Res! {
  return c.json(Message{ message: "Hello, World!" })
}

fn main(): ()! {
  let app = App(Config{ secret: "bench", host: "0.0.0.0", port: 8081 })
  app.get("/plaintext", plaintext)
  app.get("/json", jsonMsg)
  app.listen()?
}
