// pkg/web/memorystoreindex.test.bit — the session index (#6928): per-subject
// revocation through `SessionStore.destroyIndexed`, tested against
// `MemoryStore` on a caller-supplied clock (`compareAndSetAt`,
// `destroyIndexedAt`, `loadAt`) so expiry is deterministic, and through
// `Session.index` for the three paths that must carry the index along —
// a plain save, `takeAtomic` and `regenerate`.

const idxKey = "auth:sub"

fn rotationRefused(s: MemoryStore, source: (string, i64), destination: string, t: i64): bool {
  s.rotateAt(source, destination, newEntry(noIndex(), noIndex(), 3600, t), t) catch _ {
    return true
  }
  return false
}

fn mustRotate(s: MemoryStore, source: (string, i64), destination: string, t: i64) {
  let version = s.rotateAt(source, destination, newEntry(noIndex(), noIndex(), 3600, t), t) catch e {
    panic("rotateAt: ${e.message()}")
  }
  assert(version == 1, "successor must start at version one")
}

test "atomic rotation rejects revoked stale missing and expired snapshots without writes" {
  let t: i64 = 1_000_000_000
  let s = MemoryStore(10)
  writeIndexed(s, "revoked", "alice", 3600, t)
  s.destroyAt("revoked", 3600, t)
  writeIndexed(s, "updated", "alice", 3600, t)
  writeIndexed(s, "updated", "bob", 3600, t)
  writeIndexed(s, "expired", "alice", 1, t)
  for sid of []string{ "revoked", "updated", "expired", "missing" } {
    let count = len(s.entries)
    let slots = len(s.byIndex)
    assert(rotationRefused(s, (sid, 1), "new", t + nsPerSecond), "stale source accepted")
    assert(len(s.entries) == count && len(s.byIndex) == slots, "refusal mutated store")
    let (_, found) = s.entries["new"]
    assert(!found, "refusal created a destination")
  }
  assert(s.entries["updated"].version == 2, "updated source changed")
  assert(s.entries["revoked"].tombstone, "revoked source changed")
  assert(!s.entries["expired"].tombstone, "expired source changed")
}

test "atomic rotation refuses occupied destinations and zero-version stored sources" {
  let t: i64 = 1_000_000_000
  let s = MemoryStore(10)
  writeIndexed(s, "source", "alice", 3600, t)
  writeIndexed(s, "live", "bob", 3600, t)
  writeIndexed(s, "expired", "bob", 1, t)
  s.destroyAt("tombstone", 3600, t)
  for sid of []string{ "live", "expired", "tombstone", "source" } {
    assert(rotationRefused(s, ("source", 1), sid, t + nsPerSecond), "occupied id accepted")
    assert(s.entries["source"].version == 1, "collision changed source")
  }
  for sid of []string{ "source", "expired", "tombstone" } {
    assert(rotationRefused(s, (sid, 0), "new", t + nsPerSecond), "zero adopted stored id")
  }
  assert(len(s.entries) == 4, "refusal changed entries")
}

test "atomic rotation refuses a present live version-zero source without changes" {
  let s = MemoryStore(2)
  let t: i64 = 1_000_000_000
  let data = storeData([]string{ "cart", "book" })
  let index = storeData([]string{ idxKey, "alice" })
  // Exercise the exact store boundary independently of version producers.
  s.putEntry("source", newEntry(data, index, 3600, t))
  assert(rotationRefused(s, ("source", 0), "new", t), "present source adopted as fresh")
  let (source, found) = s.entries["source"]
  assert(found && !source.tombstone && source.version == 0, "refusal changed source")
  assert(source.data["cart"] == "book" && source.index[idxKey] == "alice", "maps changed")
  let (_, destination) = s.entries["new"]
  assert(!destination && len(s.entries) == 1, "refusal created destination")
  assert(len(s.byIndex[indexSlot(idxKey, "alice")]) == 1, "refusal changed reverse index")
}

test "atomic rotation preserves dirty data index flags and independent map ownership" {
  let s = MemoryStore(10)
  let session = newIndexedSession(s, "alice")
  let old = session.id()
  session.set("cart", "book")
  session.index(idxKey, "bob")
  session.regenerate() catch e {
    panic("regenerate: ${e.message()}")
  }
  assert(session.version == 1 && !session.dirty && session.fresh, "rotation flags/version")
  assert(s.entries[old].tombstone && len(s.entries[old].index) == 0, "old id not tombstoned")
  session.set("cart", "changed")
  session.index(idxKey, "carol")
  let saved = s.load(session.id()) catch e {
    panic("load: ${e.message()}")
  }
  let (data, version, index) = unwrap(saved)
  assert(version == 1 && data["cart"] == "book" && index[idxKey] == "bob", "maps aliased")
  data["cart"] = "also changed"
  index[idxKey] = "dave"
  assert(mustRead(s, session.id())["cart"] == "book", "load data aliases store")
  assert(destroyAllOf(s, "alice", "") == 0, "old index survived")
  assert(destroyAllOf(s, "dave", "") == 0, "load index aliases store")
  assert(destroyAllOf(s, "bob", "") == 1, "new index missing")
}

test "atomic rotation supports fresh unsaved sessions and refuses cap one without changes" {
  let s = MemoryStore(2)
  let fresh = loadSession(s, "") catch e {
    panic("load: ${e.message()}")
  }
  let old = fresh.id()
  fresh.set("cart", "book")
  fresh.regenerate() catch e {
    panic("regenerate: ${e.message()}")
  }
  assert(len(s.entries) == 2 && s.entries[old].tombstone, "fresh tombstone missing")
  assert(mustRead(s, fresh.id())["cart"] == "book", "fresh data lost")
  let tiny = MemoryStore(1)
  let t: i64 = 1_000_000_000
  assert(rotationRefused(tiny, ("absent", 0), "new", t), "cap one accepted")
  assert(len(tiny.entries) == 0, "failed fresh rotation mutated store")
  writeIndexed(tiny, "old", "alice", 3600, t)
  assert(rotationRefused(tiny, ("old", 1), "new", t), "cap one evicted source")
  assert(len(tiny.entries) == 1 && !tiny.entries["old"].tombstone, "source changed")
}

test "atomic rotation evicts unrelated oldest expiry and preserves the source tombstone" {
  let s = MemoryStore(3)
  let t: i64 = 1_000_000_000
  writeIndexed(s, "old", "alice", 1, t)
  writeIndexed(s, "victim", "bob", 10, t)
  writeIndexed(s, "keep", "carol", 20, t)
  mustRotate(s, ("old", 1), "new", t)
  let (_, victim) = s.entries["victim"]
  assert(!victim && s.entries["old"].tombstone, "eviction must skip source")
  assert(isSome(s.loadAt("keep", t)), "wrong victim")
  assert(len(s.entries) == 3 && len(s.byIndex) == 1, "bounded entry/index count")
  let fresh = MemoryStore(2)
  writeIndexed(fresh, "a", "alice", 10, t)
  writeIndexed(fresh, "b", "bob", 20, t)
  mustRotate(fresh, ("unsaved", 0), "new", t)
  assert(len(fresh.entries) == 2 && len(fresh.byIndex) == 0, "fresh needs two slots")
}

fn raceRotation(s: MemoryStore, destination: string, start: chan<bool>, done: chan<bool>) {
  <- start
  s.rotate(("old", 1), destination, noIndex(), noIndex(), sessionTTLSeconds) catch _ {
    done <- false
    return
  }
  done <- true
}

test "atomic rotation concurrent snapshots produce exactly one live successor" {
  let workers = parseInt(envOr("BIT_WORKERS", "1")) catch e {
    panic("invalid worker count: ${e.message()}")
  }
  assert(workers >= 2, "rotation race requires BIT_WORKERS>=2")
  let s = MemoryStore(10)
  mustWrite(s, "old", noIndex(), 3600)
  let start = chan<bool>(2)
  let done = chan<bool>(2)
  spawn raceRotation(s, "a", start, done)
  spawn raceRotation(s, "b", start, done)
  start <- true
  start <- true
  let a = <- done
  let b = <- done
  assert(a != b, "exactly one rotation must succeed")
  assert(isLive(s, "a") != isLive(s, "b"), "exactly one destination must exist")
  assert(s.entries["old"].tombstone && len(s.entries) == 2, "source or count wrong")
}

test "atomic rotation validates ids expiry and version boundaries before mutation" {
  let s = MemoryStore(10)
  let t: i64 = 1_000_000_000
  for pair of [](string, i64){ ("", 0), ("old", -1), ("old", 9223372036854775807) } {
    assert(rotationRefused(s, pair, "new", t), "invalid source accepted")
  }
  assert(rotationRefused(s, ("old", 0), "", t), "empty destination accepted")
  for ttl of []i64{ 0, -1, 9223372036854775807 } {
    let refused = false
    s.rotate(("old", 0), "new", noIndex(), noIndex(), ttl) catch _ {
      refused = true
    }
    assert(refused, "invalid ttl accepted")
  }
  assert(len(s.entries) == 0 && len(s.byIndex) == 0, "boundary failure mutated store")
  mustRotate(s, ("old", 0), "new", t)
  assert(isSome(s.loadAt("new", t + 3600 * nsPerSecond - 1)), "expired early")
  assert(!isSome(s.loadAt("new", t + 3600 * nsPerSecond)), "must expire at boundary")
}

fn noIndex(): map<string, string> {
  return map<string, string>()
}

// Writes `sid` at its next version holding `idxKey` = `value`.
fn writeIndexed(s: MemoryStore, sid: string, value: string, ttl: i64, nowNs: i64) {
  let write = newEntry(noIndex(), storeData([]string{ idxKey, value }), ttl, nowNs)
  s.compareAndSetAt(sid, currentVersion(s, sid, nowNs), write, nowNs) catch e {
    panic("compareAndSetAt: ${e.message()}")
  }
}

fn destroyIndexedAtOrPanic(s: MemoryStore, value: string, except: string, nowNs: i64): int {
  let n = s.destroyIndexedAt(idxKey, value, except, 3600, nowNs) catch e {
    panic("destroyIndexedAt: ${e.message()}")
  }
  return n
}

fn threeForOneSubject(): MemoryStore {
  let s = MemoryStore(100)
  let t0 = now().ns
  writeIndexed(s, "s1", "alice", 3600, t0)
  writeIndexed(s, "s2", "alice", 3600, t0)
  writeIndexed(s, "s3", "alice", 3600, t0)
  writeIndexed(s, "other", "bob", 3600, t0)
  return s
}

test "destroyIndexed with except keeps 1 of 3 sessions and returns 2" {
  let s = threeForOneSubject()
  let t0 = now().ns
  let n = destroyIndexedAtOrPanic(s, "alice", "s2", t0)
  assert(n == 2, "want 2 destroyed, got ${n}")
  assert(isSome(s.loadAt("s2", t0)), "the excepted session must survive")
  assert(!isSome(s.loadAt("s1", t0)), "s1 must be destroyed")
  assert(!isSome(s.loadAt("s3", t0)), "s3 must be destroyed")
  assert(isSome(s.loadAt("other", t0)), "another subject's session must be untouched")
}

test "a stale compareAndSet on a destroyed session fails for 3 of 3" {
  let s = threeForOneSubject()
  let t0 = now().ns
  let sids = []string{ "s1", "s2", "s3" }
  let versions = []i64{ 1, 1, 1 }
  let n = destroyIndexedAtOrPanic(s, "alice", "", t0)
  assert(n == 3, "want 3 destroyed, got ${n}")
  let refused = 0
  let i = 0
  while (i < len(sids)) {
    s.compareAndSetAt(sids[i], versions[i], newEntry(noIndex(), noIndex(), 3600, t0), t0) catch _ {
      refused = refused + 1
    }
    i = i + 1
  }
  assert(refused == 3, "a stale write must be refused on all 3, refused ${refused}")
}

test "an expired entry is neither counted nor tombstoned" {
  let s = MemoryStore(100)
  let t0 = now().ns
  writeIndexed(s, "live", "alice", 3600, t0)
  writeIndexed(s, "dead", "alice", 10, t0)
  let later = t0 + 60 * 1_000_000_000
  let n = destroyIndexedAtOrPanic(s, "alice", "", later)
  assert(n == 1, "an expired session must not be counted, got ${n}")
  assert(!s.entries["dead"].tombstone, "an expired session must not be given a tombstone")
}

test "re-indexing replaces the value, it does not add a second one" {
  let s = MemoryStore(100)
  let t0 = now().ns
  writeIndexed(s, "s1", "alice", 3600, t0)
  writeIndexed(s, "s1", "bob", 3600, t0)
  assert(destroyIndexedAtOrPanic(s, "alice", "", t0) == 0, "the old value must no longer match")
  assert(len(s.byIndex) == 1, "one pair must be indexed, got ${len(s.byIndex)}")
  assert(destroyIndexedAtOrPanic(s, "bob", "", t0) == 1, "the new value must match exactly once")
}

test "the reverse index shrinks with the entries: overwrite, destroy, expiry, eviction" {
  let s = MemoryStore(2)
  let t0 = now().ns
  writeIndexed(s, "a", "alice", 3600, t0)
  s.compareAndSetAt("a", 1, newEntry(noIndex(), noIndex(), 3600, t0), t0) catch e {
    panic("compareAndSetAt: ${e.message()}")
  }
  assert(len(s.byIndex) == 0, "dropping the index in a write must drop its slot")
  writeIndexed(s, "a", "alice", 3600, t0)
  s.destroyAt("a", 3600, t0)
  assert(len(s.byIndex) == 0, "a tombstone carries no index")
  writeIndexed(s, "b", "bob", 10, t0)
  assert(!isSome(s.loadAt("b", t0 + 20 * 1_000_000_000)), "b must have expired")
  assert(len(s.byIndex) == 0, "expiry on read must drop the slot")
  writeIndexed(s, "c", "carol", 3600, t0)
  writeIndexed(s, "d", "dave", 7200, t0)
  writeIndexed(s, "e", "erin", 7200, t0)
  assert(len(s.entries) == 2, "the cap must hold, got ${len(s.entries)}")
  assert(len(s.byIndex) <= 2, "the reverse index must not outgrow the cap, got ${len(s.byIndex)}")
}

test "destroyIndexed refuses an empty key or value" {
  let s = MemoryStore(10)
  let t0 = now().ns
  let failedValue = false
  s.destroyIndexedAt(idxKey, "", "", 3600, t0) catch _ {
    failedValue = true
  }
  assert(failedValue, "an empty value must be refused")
  let failedKey = false
  s.destroyIndexedAt("", "alice", "", 3600, t0) catch _ {
    failedKey = true
  }
  assert(failedKey, "an empty key must be refused")
}

test "keys and values that run together do not collide in the reverse index" {
  let s = MemoryStore(10)
  let t0 = now().ns
  s.compareAndSetAt("x", 0, newEntry(noIndex(), storeData([]string{ "ab", "c" }), 3600, t0), t0) catch e {
    panic("compareAndSetAt: ${e.message()}")
  }
  let n = s.destroyIndexedAt("a", "bc", "", 3600, t0) catch e {
    panic("destroyIndexedAt: ${e.message()}")
  }
  assert(n == 0, "(a, bc) must not match (ab, c), got ${n}")
}

fn newIndexedSession(store: MemoryStore, value: string): Session {
  let s = loadSession(store, "") catch e {
    panic("loadSession: ${e.message()}")
  }
  s.index(idxKey, value)
  s.persist() catch e {
    panic("persist: ${e.message()}")
  }
  return s
}

fn isLive(store: MemoryStore, sid: string): bool {
  let got = store.load(sid) catch e {
    panic("load: ${e.message()}")
  }
  return isSome(got)
}

fn destroyAllOf(store: MemoryStore, value: string, except: string): int {
  let n = store.destroyIndexed(idxKey, value, except, 3600) catch e {
    panic("destroyIndexed: ${e.message()}")
  }
  return n
}

test "Session.index is written with the data and reaches destroyIndexed" {
  let store = MemoryStore(10)
  let a = newIndexedSession(store, "alice")
  let b = newIndexedSession(store, "alice")
  assert(destroyAllOf(store, "alice", b.id()) == 1, "exactly the other session must be destroyed")
  assert(!isLive(store, a.id()), "a must be gone")
  assert(isLive(store, b.id()), "b must remain")
}

test "Session.unindex ignores an absent key and still marks the session dirty" {
  let store = MemoryStore(10)
  let s = newIndexedSession(store, "alice")
  s.unindex("absent")
  assert(s.dirty, "unindex must mark even an absent key dirty")
  mustSave(s)
  assert(!s.dirty && s.version == 2, "save must persist and clear the dirty flag")
  assert(destroyAllOf(store, "alice", "") == 1, "unrelated index must remain")
}

test "Session.unindex save removes only the named index and preserves data" {
  let store = MemoryStore(10)
  let s = newIndexedSession(store, "alice")
  s.set(idxKey, "cart")
  s.index("inkwell:role", "author")
  mustSave(s)
  s.unindex(idxKey)
  assert(s.dirty, "removing an index must mark the session dirty")
  assert(len(store.byIndex) == 2, "unindex must wait for save")
  mustSave(s)
  let loaded = loadSession(store, s.id()) catch e {
    panic("loadSession: ${e.message()}")
  }
  assert(loaded.get(idxKey) == "cart", "index removal changed same-named session data")
  assert(len(loaded.indexes) == 1, "save did not remove the index")
  assert(loaded.indexes["inkwell:role"] == "author", "unrelated index changed")
  assert(destroyAllOf(store, "alice", "") == 0, "removed index still revokes the session")
  let n = store.destroyIndexed("inkwell:role", "author", "", sessionTTLSeconds) catch e {
    panic("destroyIndexed: ${e.message()}")
  }
  assert(n == 1, "unrelated reverse index must remain")
}

test "Session.unindex removal survives rotation with remaining data and indexes" {
  let store = MemoryStore(10)
  let s = newIndexedSession(store, "alice")
  let old = s.id()
  s.set("cart", "book")
  s.index("inkwell:role", "author")
  mustSave(s)
  s.unindex(idxKey)
  s.regenerate() catch e {
    panic("regenerate: ${e.message()}")
  }
  assert(s.id() != old && !isLive(store, old), "rotation must revoke the old id")
  assert(!s.dirty, "rotation must persist the index removal")
  let loaded = loadSession(store, s.id()) catch e {
    panic("loadSession: ${e.message()}")
  }
  assert(loaded.get("cart") == "book", "rotation lost session data")
  assert(len(loaded.indexes) == 1, "rotation restored the removed index")
  assert(loaded.indexes["inkwell:role"] == "author", "rotation lost unrelated index")
  assert(destroyAllOf(store, "alice", "") == 0, "removed index survived rotation")
  assert(len(store.byIndex) == 1, "rotation must retain only the remaining reverse index")
}

test "testpanic_Session_unindex_after_destroy" {
  let store = MemoryStore(10)
  let s = newIndexedSession(store, "alice")
  s.destroy() catch e {
    panic("destroy: ${e.message()}")
  }
  s.unindex(idxKey)
}

test "a later save, takeAtomic and regenerate keep the session indexed" {
  let store = MemoryStore(10)
  let first = newIndexedSession(store, "alice")
  let sid = first.id()
  first.set("otp", "123456")
  first.persist() catch e {
    panic("persist: ${e.message()}")
  }
  let sibling = loadSession(store, sid) catch e {
    panic("loadSession: ${e.message()}")
  }
  sibling.set("theme", "dark")
  sibling.save() catch e {
    panic("save: ${e.message()}")
  }
  let taken = sibling.takeAtomic("otp") catch e {
    panic("takeAtomic: ${e.message()}")
  }
  assert(isSome(taken), "the otp must be taken")
  sibling.regenerate() catch e {
    panic("regenerate: ${e.message()}")
  }
  assert(sibling.id() != sid, "regenerate must mint a new id")
  assert(destroyAllOf(store, "alice", "") == 1, "the regenerated session must still be indexed")
  assert(!isLive(store, sibling.id()), "and now destroyed")
}

test "Session.destroy takes the session out of the index" {
  let store = MemoryStore(10)
  let s = newIndexedSession(store, "alice")
  s.destroy() catch e {
    panic("destroy: ${e.message()}")
  }
  assert(
    destroyAllOf(store, "alice", "") == 0,
    "destroy must have taken the session out of the index",
  )
}

test "testpanic_Session_index_refuses_an_empty_value" {
  let store = MemoryStore(10)
  let s = loadSession(store, "") catch e {
    panic("loadSession: ${e.message()}")
  }
  s.index(idxKey, "")
}
