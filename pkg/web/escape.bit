// pkg/web/escape.bit — the four escaping entry points (#3887): `text`,
// `url`, `js`, `raw`. `appendHtmlEscaped` also backs `render`'s attribute-value
// escaping (node.bit) — `Builder`/`newBuilder` are already imported into this
// module by node.bit (an import binds module-wide, not per file — SPEC
// §17.1/§17.2); reused here, not re-imported (E0042).
//
// `raw` IS THE ONLY ESCAPE HATCH, ON PURPOSE. There is no flag on `text()`
// that turns escaping off — a flag reads as harmless in a security review,
// `raw` does not, and `raw` is also the whole answer to "return unescaped
// HTML from a handler": no second unescaped path, no `c.raw()` beside
// `c.html()` (epic #3875).

import { toLower } from "std/strings"
import { Json, jsonEncode } from "std/json"

// `s`, safe as HTML element text: `text("<script>alert(1)</script>")`
// renders as the literal characters `&lt;script&gt;...`, never a live tag.
export fn text(s: string): Node {
  let b = newBuilder()
  appendHtmlEscaped(b, s)
  return Node.Text(b.toString())
}

// `s`, unescaped, byte-for-byte. The one deliberate escape hatch (see the
// file header) — never reachable through `text()`.
export fn raw(s: string): Node {
  return Node.Raw(s)
}

// `s` for use as an `href`/`src`/`action` value, refused (not stripped or
// rewritten — a rewrite hides the attack) unless its scheme is on the
// allowlist. A relative reference — no scheme at all, i.e. `/path`,
// `path`, `?query`, `#fragment` — is always allowed unchanged.
export fn url(s: string): string! {
  let colon = schemeColonIndex(s)
  if (colon < 0) {
    return s
  }
  let scheme = toLower(s[0:colon])
  if (isAllowedScheme(scheme)) {
    return s
  }
  fail newError("pkg/web: url() refused scheme '${scheme}' in '${s}'")
}

// `s` as a JSON string literal, safe to embed inside a `<script>` block —
// `const data = ${js(s)};`. JSON-encoding alone handles quotes, backslashes
// and control bytes; it does NOT escape `/` or `<`, and an HTML parser
// looks for the literal byte sequence `</script` regardless of JS
// string-literal context, so a hostile `s` containing `</script>` would
// still close the block. Escaping every `<` byte as the six-byte sequence
// backslash-u-0-0-3-c — a valid JSON/JS string escape for `<` — removes the
// literal `<` from the output unconditionally, so `</script` cannot occur.
export fn js(s: string): string {
  let encoded = jsonEncode(Json.JsonString(s))
  let b = newBuilder()
  let i = 0
  while (i < len(encoded)) {
    let c = encoded[i]
    if (c == '<') {
      b.write("\\u003c")
    } else {
      b.writeByte(c)
    }
    i = i + 1
  }
  return b.toString()
}

// The offset of the colon ending `s`'s scheme, or -1 when `s` has none — a
// `/`, `?` or `#` reached before any `:` means `s` is a relative reference,
// and a `:` reached first means everything before it is the scheme. Same
// heuristic RFC 3986-aware sanitizers (DOMPurify, sanitize-html) use.
fn schemeColonIndex(s: string): int {
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == ':') {
      return i
    }
    if (c == '/' || c == '?' || c == '#') {
      return -1
    }
    i = i + 1
  }
  return -1
}

fn isAllowedScheme(scheme: string): bool {
  return scheme == "http" || scheme == "https" || scheme == "mailto"
}

// Appends `s` to `b` with `&`, `<`, `>`, `"` and `'` HTML-entity-escaped —
// the one rule shared by element text (`text()`, above) and an attribute
// value (`render`'s `appendAttrs`, node.bit). Module-private: neither
// caller needs it exported.
fn appendHtmlEscaped(b: Builder, s: string) {
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == '&') {
      b.write("&amp;")
    } else if (c == '<') {
      b.write("&lt;")
    } else if (c == '>') {
      b.write("&gt;")
    } else if (c == '"') {
      b.write("&quot;")
    } else if (c == 39) { // '
      b.write("&#39;")
    } else {
      b.writeByte(c)
    }
    i = i + 1
  }
}
