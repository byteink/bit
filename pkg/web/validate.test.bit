// pkg/web/validate.test.bit — #3880's acceptance, one named test per clause,
// plus one test per shipped rule.
//
// The status is half of what this ticket asserts, so every framework-level
// test drives `app.handle(req)` (adapter.bit) — the real router, the real
// `Ctx`, the real failure mapping — rather than calling `validateBound`
// directly, which would pass just as well against a 422 that never becomes a
// response. The eight rules are also called DIRECTLY, because a rule is an
// ordinary function an application may call itself and its message is part of
// what this package ships.
//
// `jsonPost`, `errorText`, `stringField` (body.test.bit), `contains`
// (router.test.bit), `freezeOrPanic` (adapter.test.bit) and `jsonDecode`
// (body.test.bit) are already bound module-wide — reused, not re-imported
// (E0042).

// --- the types a route declares --------------------------------------------

// Two attributed fields AND a hand-written cross-field rule, which is the
// composition #3879 split the two member names for: `validateFields()` is
// synthesized from the attributes, `validate()` is written by hand, and both
// run.
@json class Signup {
  @minLen(3)
  @maxLen(12)
  name: string

  @email
  email: string

  password: string
  confirm: string

  export validate(): ()! {
    if (this.password != this.confirm) {
      fail unprocessable("password and confirm must match")
    }
  }
}

// The numeric rules, which are named apart from the string ones because Bit
// has no overloading (#3880: `min`/`max` are values, `minLen`/`maxLen` are
// lengths).
@json class Ranged {
  @min(18)
  @max(120)
  age: i64
}

// A type with NEITHER member. It must bind with no validation and no error —
// that is a type with no rules, not a mistake.
@json class Plain {
  label: string,
}

// A rule an APPLICATION defines, used as an attribute with no change to
// pkg/web and no change to the compiler. This is the reason the design was
// chosen over a fixed rule set, so it is a fixture and not a comment.
fn iban(v: string): ()! {
  if (len(v) < 15 || v[0:2] != "GB") {
    fail unprocessable("must be an IBAN")
  }
}

@json class Payment {
  @iban
  account: string
}

// A cross-field rule that fails with an error carrying NO status — the shape
// a raw `stdlib/sql` failure has. Its message must never reach the client
// (errors.bit's rule, which validation does not get to bypass).
@json class Leaky {
  token: string

  export validate(): ()! {
    fail newError("postgres://u:p@host/db refused the connection")
  }
}

// A FIELD rule that fails with an error carrying no status, beside one that
// does. The pair is what makes it a test: the safe rule's message is fit for a
// client and the unsafe one's is not, and they arrive in ONE `validateFields()`
// error, so the rule (errors.bit's) has to be applied per failure and not per
// call.
fn secret(v: string): ()! {
  fail newError("postgres://u:p@host/db refused the connection")
}

@json class LeakyField {
  @minLen(3)
  label: string

  @secret
  token: string
}

// A cross-field rule that deliberately chooses a status other than 422, to
// pin that a single failure is passed through and not rewritten.
@json class Unique {
  handle: string

  export validate(): ()! {
    if (this.handle == "taken") {
      fail conflict("handle already registered")
    }
  }
}

// --- fixtures ---------------------------------------------------------------

fn postSignup(c: Ctx): Res! {
  let input = c.body((j) => jsonDecode<Signup>(j))?
  return c.json(input)
}

fn postRanged(c: Ctx): Res! {
  let input = c.body((j) => jsonDecode<Ranged>(j))?
  return c.json(input)
}

fn postPlain(c: Ctx): Res! {
  let input = c.body((j) => jsonDecode<Plain>(j))?
  return c.json(input)
}

fn postPayment(c: Ctx): Res! {
  let input = c.body((j) => jsonDecode<Payment>(j))?
  return c.json(input)
}

fn postLeaky(c: Ctx): Res! {
  let input = c.body((j) => jsonDecode<Leaky>(j))?
  return c.json(input)
}

fn postLeakyField(c: Ctx): Res! {
  let input = c.body((j) => jsonDecode<LeakyField>(j))?
  return c.json(input)
}

fn postUnique(c: Ctx): Res! {
  let input = c.body((j) => jsonDecode<Unique>(j))?
  return c.json(input)
}

// The lenient unknown-field policy over a validated type, to pin that the
// per-call override changes what is DECODED and never whether the rules run.
fn postSignupLoose(c: Ctx): Res! {
  let input = c.bodyWith(Bind{ unknown: Unknown.Ignore }, (j) => jsonDecode<Signup>(j))?
  return c.json(input)
}

fn validateApp(): App {
  let app = App(Config{ secret: "test-secret" })
  app.post("/signup", postSignup)
  app.post("/signup/loose", postSignupLoose)
  app.post("/ranged", postRanged)
  app.post("/plain", postPlain)
  app.post("/payments", postPayment)
  app.post("/leaky", postLeaky)
  app.post("/leaky/field", postLeakyField)
  app.post("/unique", postUnique)
  freezeOrPanic(app)
  return app
}

// A well-formed `Signup` payload with the four fields spelled out, so a test
// differs from its neighbour only in the values it is asserting on.
fn signupBody(name: string, mail: string, pw: string, confirm: string): string {
  return "{\"name\":\"${name}\",\"email\":\"${mail}\",\"password\":\"${pw}\",\"confirm\":\"${confirm}\"}"
}

// The message a rule failed with, or "" when it passed. Every rule is
// `(...) => ()!`, so this is the whole of what one can report.
//
// TWO COMPILER DEFECTS SHAPE THE CALLS BELOW, both found here and both filed
// with a repro:
//
//   #4571 — every call is written `ruleFailure(() => { minLen("ab", 3)? })`
//   with a BLOCK body. The natural expression body, `() => minLen("ab", 3)?`,
//   panics the compiler ("panic: assertion failed", rc=2, no diagnostic). The
//   block form is the workaround and goes when that lands.
//
//   #4570 — this parameter is named `rule` and not `run`, because a
//   function-typed parameter's name resolves MODULE-WIDE: named `run` it broke
//   `static.test.bit`'s `run` (std/os) with an error reported in THAT file.
fn ruleFailure(rule: () => ()!): string {
  rule() catch e {
    return e.message()
  }
  return ""
}

// --- the happy path ---------------------------------------------------------

test "a valid body passes with validateFields never surfacing an error" {
  let res = validateApp().handle(
    jsonPost("/signup", signupBody("alice", "a@b.co", "pw", "pw")),
  )

  assert(res.status == 200, "want 200, got ${res.status}: '${res.body}'")
  assert(stringField(res.body, "name") == "alice", "name: '${res.body}'")
  assert(stringField(res.body, "email") == "a@b.co", "email: '${res.body}'")
}

test "a type declaring neither validateFields nor validate binds with no validation" {
  let res = validateApp().handle(jsonPost("/plain", "{\"label\":\"x\"}"))

  assert(res.status == 200, "want 200, got ${res.status}: '${res.body}'")
  assert(stringField(res.body, "label") == "x", "label: '${res.body}'")
}

// --- accumulation: the clause this ticket exists for ------------------------

test "a field rule and a cross-field rule both fail and the 422 names both" {
  let res = validateApp().handle(
    jsonPost("/signup", signupBody("ab", "a@b.co", "pw", "other")),
  )

  assert(res.status == 422, "want 422, got ${res.status}: '${res.body}'")
  assert(
    contains(errorText(res), "at least 3"),
    "the field rule must be reported: '${errorText(res)}'",
  )
  assert(
    contains(errorText(res), "password and confirm"),
    "the cross-field rule must be reported TOO, not just the first failure: '${errorText(res)}'",
  )
}

test "a failing field rule alone is a 422 naming that field" {
  let res = validateApp().handle(
    jsonPost("/signup", signupBody("ab", "a@b.co", "pw", "pw")),
  )

  assert(res.status == 422, "want 422, got ${res.status}: '${res.body}'")
  assert(
    errorText(res) == "name: must be at least 3 character(s)",
    "the field's name comes from the synthesis, not the rule: '${errorText(res)}'",
  )
}

test "a fixture whose cross-field rule ALONE fails proves validate() runs" {
  let res = validateApp().handle(
    jsonPost("/signup", signupBody("alice", "a@b.co", "pw", "other")),
  )

  assert(res.status == 422, "want 422, got ${res.status}: '${res.body}'")
  assert(errorText(res) == "password and confirm must match", "got '${errorText(res)}'")
}

// #3880'S HEADLINE CLAUSE. Two failing ATTRIBUTES come back in one 422, each
// naming its field: `validateFields()` runs every attribute and fails once
// with all of them (#4572), and this file reads the failures out of that one
// error rather than the first of them.
//
// The exact message is asserted, not merely the two fragments: the order is
// declaration order (`name` is declared above `email`) and the separator is
// the one this package joins with everywhere else.
test "two failing field attributes are both reported, each naming its field" {
  let res = validateApp().handle(
    jsonPost("/signup", signupBody("ab", "not-an-email", "pw", "pw")),
  )

  assert(res.status == 422, "want 422, got ${res.status}: '${res.body}'")
  assert(
    errorText(res) == "name: must be at least 3 character(s); email: must be an email address",
    "both fields, each named, in declaration order: '${errorText(res)}'",
  )
}

// --- an application's own rule ----------------------------------------------

test "a user-defined @iban rule produces a 422 with no change to pkg/web" {
  let res = validateApp().handle(jsonPost("/payments", "{\"account\":\"FR761234567890\"}"))

  assert(res.status == 422, "want 422, got ${res.status}: '${res.body}'")
  assert(errorText(res) == "account: must be an IBAN", "got '${errorText(res)}'")
}

test "a user-defined @iban rule passes a value it accepts" {
  let res = validateApp().handle(jsonPost("/payments", "{\"account\":\"GB33BUKB20201555555555\"}"))

  assert(res.status == 200, "want 200, got ${res.status}: '${res.body}'")
}

// --- the status boundary ----------------------------------------------------

test "a value failure is 422 while a shape failure on the same route is 400" {
  let app = validateApp()
  let value = app.handle(jsonPost("/signup", signupBody("ab", "a@b.co", "pw", "pw")))
  let shape = app.handle(
    jsonPost("/signup", "{\"name\":\"alice\",\"email\":\"a@b.co\",\"password\":\"p\"}"),
  )

  assert(value.status == 422, "value rule: want 422, got ${value.status}")
  assert(shape.status == 400, "missing field: want 400, got ${shape.status}: '${shape.body}'")
}

test "the numeric rules answer 422 below the minimum and above the maximum" {
  let app = validateApp()
  let low = app.handle(jsonPost("/ranged", "{\"age\":12}"))
  let high = app.handle(jsonPost("/ranged", "{\"age\":130}"))
  let ok = app.handle(jsonPost("/ranged", "{\"age\":30}"))

  assert(low.status == 422 && errorText(low) == "age: must be at least 18", "low: '${low.body}'")
  assert(
    high.status == 422 && errorText(high) == "age: must be at most 120",
    "high: '${high.body}'",
  )
  assert(ok.status == 200, "30 is in range: ${ok.status} '${ok.body}'")
}

test "a single failure keeps the status its own rule chose" {
  let res = validateApp().handle(jsonPost("/unique", "{\"handle\":\"taken\"}"))

  assert(res.status == 409, "want the rule's own 409, got ${res.status}: '${res.body}'")
  assert(errorText(res) == "handle already registered", "got '${errorText(res)}'")
}

// --- the security property --------------------------------------------------

test "a rule failing with an error that carries no status is a 500 that says nothing" {
  let res = validateApp().handle(jsonPost("/leaky", "{\"token\":\"t\"}"))

  assert(res.status == 500, "want 500, got ${res.status}: '${res.body}'")
  assert(
    !contains(res.body, "postgres://"),
    "a rule failure that did not opt into HttpError must not reach the client: '${res.body}'",
  )
}

test "a field rule with no status is a 500, and takes the safe rule beside it down" {
  let res = validateApp().handle(jsonPost("/leaky/field", "{\"label\":\"x\",\"token\":\"t\"}"))

  assert(res.status == 500, "want 500, got ${res.status}: '${res.body}'")
  assert(
    !contains(res.body, "postgres://"),
    "a rule failure that did not opt into HttpError must not reach the client: '${res.body}'",
  )
  assert(
    !contains(res.body, "at least"),
    "and nothing is joined onto it: '${res.body}'",
  )
}

// --- validation is not a per-call choice ------------------------------------

test "the lenient unknown-field policy does not turn validation off" {
  let res = validateApp().handle(
    jsonPost(
      "/signup/loose",
      "{\"name\":\"ab\",\"email\":\"a@b.co\",\"password\":\"pw\",\"confirm\":\"pw\",\"x\":1}",
    ),
  )

  assert(res.status == 422, "want 422, got ${res.status}: '${res.body}'")
  assert(contains(errorText(res), "at least 3"), "got '${errorText(res)}'")
}

// --- the eight rules, called directly ---------------------------------------

test "minLen counts characters, not bytes" {
  assert(
      ruleFailure(
        () => {
          minLen("ab", 3)?
        },
      ) ==
      "must be at least 3 character(s)",
    "under",
  )
  assert(
      ruleFailure(
        () => {
          minLen("abc", 3)?
        },
      ) ==
      "",
    "at the bound",
  )
  // Three code points, six bytes: a byte length would wrongly reject this.
  assert(
      ruleFailure(
        () => {
          minLen("åäö", 3)?
        },
      ) ==
      "",
    "three non-ASCII characters",
  )
}

test "maxLen counts characters, not bytes" {
  assert(
      ruleFailure(
        () => {
          maxLen("abcd", 3)?
        },
      ) ==
      "must be at most 3 character(s)",
    "over",
  )
  assert(
      ruleFailure(
        () => {
          maxLen("abc", 3)?
        },
      ) ==
      "",
    "at the bound",
  )
  assert(
      ruleFailure(
        () => {
          maxLen("åäö", 3)?
        },
      ) ==
      "",
    "three non-ASCII characters",
  )
}

test "min and max bound a number" {
  assert(
      ruleFailure(
        () => {
          min(17, 18)?
        },
      ) ==
      "must be at least 18",
    "under",
  )
  assert(
      ruleFailure(
        () => {
          min(18, 18)?
        },
      ) ==
      "",
    "at the bound",
  )
  assert(
      ruleFailure(
        () => {
          max(121, 120)?
        },
      ) ==
      "must be at most 120",
    "over",
  )
  assert(
      ruleFailure(
        () => {
          max(120, 120)?
        },
      ) ==
      "",
    "at the bound",
  )
}

test "email accepts an address and refuses the ways one is usually wrong" {
  assert(
      ruleFailure(
        () => {
          email("a@b.co")?
        },
      ) ==
      "",
    "a plain address",
  )
  assert(
      ruleFailure(
        () => {
          email("first.last@sub.example.com")?
        },
      ) ==
      "",
    "dots either side",
  )
  assert(
      ruleFailure(
        () => {
          email("nope")?
        },
      ) ==
      "must be an email address",
    "no @",
  )
  assert(
      ruleFailure(
        () => {
          email("a@@b.co")?
        },
      ) !=
      "",
    "two @",
  )
  assert(
      ruleFailure(
        () => {
          email("@b.co")?
        },
      ) !=
      "",
    "empty local part",
  )
  assert(
      ruleFailure(
        () => {
          email("a@")?
        },
      ) !=
      "",
    "empty domain",
  )
  assert(
      ruleFailure(
        () => {
          email("a@bco")?
        },
      ) !=
      "",
    "no dot in the domain",
  )
  assert(
      ruleFailure(
        () => {
          email("a@b.")?
        },
      ) !=
      "",
    "a trailing dot",
  )
  assert(
      ruleFailure(
        () => {
          email(" a@b.co")?
        },
      ) !=
      "",
    "a leading space",
  )
}

test "httpUrl accepts http and https and refuses every other scheme" {
  assert(
      ruleFailure(
        () => {
          httpUrl("https://example.com")?
        },
      ) ==
      "",
    "https",
  )
  assert(
      ruleFailure(
        () => {
          httpUrl("http://example.com/a?b=1#c")?
        },
      ) ==
      "",
    "http with a path",
  )
  assert(
      ruleFailure(
        () => {
          httpUrl("HTTPS://Example.com")?
        },
      ) ==
      "",
    "the scheme is case-insensitive",
  )
  assert(
      ruleFailure(
        () => {
          httpUrl("javascript:alert(1)")?
        },
      ) ==
      "must be an http:// or https:// URL",
    "javascript:",
  )
  assert(
      ruleFailure(
        () => {
          httpUrl("ftp://example.com")?
        },
      ) !=
      "",
    "ftp",
  )
  assert(
      ruleFailure(
        () => {
          httpUrl("/relative")?
        },
      ) !=
      "",
    "a relative reference",
  )
  assert(
      ruleFailure(
        () => {
          httpUrl("https://")?
        },
      ) !=
      "",
    "no host",
  )
  assert(
      ruleFailure(
        () => {
          httpUrl("https://ex ample.com")?
        },
      ) !=
      "",
    "a space",
  )
}

test "uuid accepts the canonical spelling in either case" {
  assert(
      ruleFailure(
        () => {
          uuid("f81d4fae-7dec-11d0-a765-00a0c91e6bf6")?
        },
      ) ==
      "",
    "lowercase",
  )
  assert(
      ruleFailure(
        () => {
          uuid("F81D4FAE-7DEC-11D0-A765-00A0C91E6BF6")?
        },
      ) ==
      "",
    "uppercase",
  )
  assert(
      ruleFailure(
        () => {
          uuid("f81d4fae7dec11d0a76500a0c91e6bf6")?
        },
      ) ==
      "must be a UUID",
    "no hyphens",
  )
  assert(
      ruleFailure(
        () => {
          uuid("")?
        },
      ) !=
      "",
    "empty",
  )
  assert(
      ruleFailure(
        () => {
          uuid("f81d4fae-7dec-11d0-a765-00a0c91e6bfz")?
        },
      ) !=
      "",
    "a non-hex digit",
  )
}

test "nonEmpty refuses a value that is only whitespace" {
  assert(
      ruleFailure(
        () => {
          nonEmpty("a")?
        },
      ) ==
      "",
    "a value",
  )
  assert(
      ruleFailure(
        () => {
          nonEmpty("")?
        },
      ) ==
      "must not be blank",
    "empty",
  )
  assert(
      ruleFailure(
        () => {
          nonEmpty("   ")?
        },
      ) ==
      "must not be blank",
    "three spaces",
  )
  assert(
      ruleFailure(
        () => {
          nonEmpty("\t\n")?
        },
      ) !=
      "",
    "a tab and a newline",
  )
}
