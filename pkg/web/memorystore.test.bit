// pkg/web/memorystore.test.bit — the store's own contract (#3947), tested
// directly against `MemoryStore` rather than through a `Ctx`: a miss is
// `Option.None` and never a failure, a stored session with no keys is a HIT
// and not a miss (#4483), `destroy` really removes, a positive ttl really
// expires, and neither `write` nor `read` hands out an alias into the store's
// own state — and, since #4541, that the store is BOUNDED: the entry count
// never exceeds the cap, a write past it evicts rather than failing, and
// expired entries are swept on a schedule instead of waiting for their own
// id to be read again.
//
// The expiry tests drive the module-private `readAt(sid, nowNs)` rather than
// sleeping. A timed test would be both slow and flaky, and a store whose only
// testable ttl were 0 would leave the arithmetic behind a positive one
// unexercised — which is where an off-by-a-billion would live.

fn storeData(pairs: []string): map<string, string> {
  let m = map<string, string>()
  let i = 0
  while (i + 1 < len(pairs)) {
    m[pairs[i]] = pairs[i + 1]
    i = i + 2
  }
  return m
}

fn mustWrite(s: MemoryStore, sid: string, data: map<string, string>, ttl: i64) {
  s.write(sid, data, ttl) catch e {
    panic("write: ${e.message()}")
  }
}

// The data behind `sid`, for the tests whose subject is the DATA. A miss
// panics rather than reading as an empty map: `len(mustRead(...)) == 0` was
// how a miss used to be asserted, and it would keep passing against a store
// that had stopped reporting presence at all (#4483). The tests about
// absence use `readIsMiss`.
fn mustRead(s: MemoryStore, sid: string): map<string, string> {
  let got = s.read(sid) catch e {
    panic("read: ${e.message()}")
  }
  if (!isSome(got)) {
    panic("read('${sid}'): expected a stored session, got a miss")
  }
  return unwrap(got)
}

// Whether `sid` is absent from the store. `Option.None` is the only spelling
// of absent; a hit carrying no keys is NOT one.
fn readIsMiss(s: MemoryStore, sid: string): bool {
  let got = s.read(sid) catch e {
    panic("read: ${e.message()}")
  }
  return !isSome(got)
}

test "write then read round-trips every key" {
  let s = MemoryStore(1000)
  mustWrite(s, "abc", storeData([]string{ "userId", "42", "theme", "dark" }), 3600)
  let got = mustRead(s, "abc")
  assert(len(got) == 2, "expected 2 key(s), got ${len(got)}")
  assert(got["userId"] == "42", "userId: got '${got["userId"]}'")
  assert(got["theme"] == "dark", "theme: got '${got["theme"]}'")
}

test "an unknown id reads as a miss, not a failure" {
  // A miss is the normal case on a public endpoint — a forged, expired or
  // long-destroyed id — so it must not look like a store outage.
  let s = MemoryStore(1000)
  let got = s.read("never-written") catch e {
    panic("a miss must not fail: ${e.message()}")
  }
  assert(!isSome(got), "a never-written id must read as Option.None")
}

test "a stored session with no keys reads as present, not as a miss" {
  // #4483: the store's own half of the fix. `Option.Some(empty)` and
  // `Option.None` are different answers; an empty map is not an encoding of
  // absence. The negative control is the test above — a store that reported
  // `Some` for everything would fail it.
  let s = MemoryStore(1000)
  mustWrite(s, "abc", map<string, string>(), 3600)
  let got = s.read("abc") catch e {
    panic("read: ${e.message()}")
  }
  assert(isSome(got), "a stored session with no keys read as a miss")
  assert(
    len(unwrap(got)) == 0,
    "the stored session must still be empty, got ${len(unwrap(got))} key(s)",
  )
}

test "destroy removes the entry, and a second destroy is not an error" {
  let s = MemoryStore(1000)
  mustWrite(s, "abc", storeData([]string{ "userId", "42" }), 3600)
  assert(len(mustRead(s, "abc")) == 1, "precondition: the entry must exist first")
  s.destroy("abc") catch e {
    panic("destroy: ${e.message()}")
  }
  assert(readIsMiss(s, "abc"), "destroy left the entry readable")
  s.destroy("abc") catch e {
    panic("destroying an absent id must be a no-op: ${e.message()}")
  }
  s.destroy("never-written") catch e {
    panic("destroying an unknown id must be a no-op: ${e.message()}")
  }
}

test "destroy removes only the id it names" {
  let s = MemoryStore(1000)
  mustWrite(s, "a", storeData([]string{ "k", "1" }), 3600)
  mustWrite(s, "b", storeData([]string{ "k", "2" }), 3600)
  s.destroy("a") catch e {
    panic("destroy: ${e.message()}")
  }
  assert(readIsMiss(s, "a"), "'a' should be gone")
  assert(mustRead(s, "b")["k"] == "2", "'b' must be untouched, got '${mustRead(s, "b")["k"]}'")
}

test "a positive ttl is honoured: alive inside the window, gone past it" {
  let s = MemoryStore(1000)
  let writtenAt = now().ns
  mustWrite(s, "abc", storeData([]string{ "userId", "42" }), 60)

  // Both sides, so a store that always expired — or never did — fails one.
  let inside = s.readAt("abc", writtenAt + 59 * nsPerSecond)
  assert(isSome(inside), "the entry must still be readable 59s into a 60s ttl")
  assert(len(unwrap(inside)) == 1, "expected 1 key inside the window, got ${len(unwrap(inside))}")
  let past = s.readAt("abc", writtenAt + 61 * nsPerSecond)
  assert(!isSome(past), "a 60s ttl must have expired at 61s")
}

test "an expired entry reads as a miss, not as a present-but-empty session" {
  // The sharp case for #4483's encoding: the entry that expires holds NO
  // keys, so under the old one it and a live keyless session gave the same
  // answer. An expired id is dead and must not be adopted.
  let s = MemoryStore(1000)
  let writtenAt = now().ns
  mustWrite(s, "abc", map<string, string>(), 60)
  // The control: while it is alive it is a hit, keyless or not.
  assert(isSome(s.readAt("abc", writtenAt + 59 * nsPerSecond)), "precondition: alive at 59s")
  assert(!isSome(s.readAt("abc", writtenAt + 61 * nsPerSecond)), "an expired entry must be a miss")
}

test "an expired entry is dropped, not merely hidden" {
  let s = MemoryStore(1000)
  mustWrite(s, "abc", storeData([]string{ "userId", "42" }), 60)
  assert(len(s.entries) == 1, "precondition: one entry")
  let _ = s.readAt("abc", now().ns + 61 * nsPerSecond)
  assert(len(s.entries) == 0, "the expired entry is still held: ${len(s.entries)}")
}

test "a ttl of zero is already expired when it is written" {
  // One rule, not a special case: an entry dies at write time + ttl, and a
  // ttl of 0 makes that instant the write itself. There is no ttl spelling
  // that means "never".
  let s = MemoryStore(1000)
  mustWrite(s, "abc", storeData([]string{ "userId", "42" }), 0)
  assert(readIsMiss(s, "abc"), "a ttl of 0 must not be readable")
}

test "write copies the caller's map instead of aliasing it" {
  let s = MemoryStore(1000)
  let data = storeData([]string{ "userId", "42" })
  mustWrite(s, "abc", data, 3600)
  // Maps are reference types (SPEC §13.3). A store that kept the caller's
  // map would let a later mutation rewrite history — and would behave
  // differently from every store that serialises, which is the one thing a
  // dev store must not do.
  data["userId"] = "99"
  assert(mustRead(s, "abc")["userId"] == "42", "the write aliased the caller's map")
}

test "read hands back a copy, so a caller cannot mutate the store through it" {
  let s = MemoryStore(1000)
  mustWrite(s, "abc", storeData([]string{ "userId", "42" }), 3600)
  let got = mustRead(s, "abc")
  got["userId"] = "99"
  assert(mustRead(s, "abc")["userId"] == "42", "read handed out an alias into the store")
}

test "a second write to the same id replaces the entry and refreshes the window" {
  let s = MemoryStore(1000)
  let t0 = now().ns
  mustWrite(s, "abc", storeData([]string{ "userId", "42" }), 60)
  mustWrite(s, "abc", storeData([]string{ "theme", "dark" }), 3600)
  let got = mustRead(s, "abc")
  assert(len(got) == 1, "the second write must replace, not merge: ${len(got)} key(s)")
  assert(got["theme"] == "dark", "theme: got '${got["theme"]}'")
  let refreshed = s.readAt("abc", t0 + 61 * nsPerSecond)
  assert(isSome(refreshed), "the second write must refresh the expiry window")
  assert(
    len(unwrap(refreshed)) == 1,
    "the refreshed entry must still hold its key, got ${len(unwrap(refreshed))}",
  )
}

// --- the bound (#4541) ------------------------------------------------------
//
// `Ctx.csrfToken()` writes a session for an ANONYMOUS visitor, so a public
// form page mints one entry per visitor with nothing authenticated in front
// of it. These tests are the store's half of the answer: a hard cap, eviction
// of the oldest-expiring entry when a write would cross it, and a sweep of
// expired entries every `memoryStoreSweepEvery` writes. They drive the
// module-private `writeAt(sid, data, ttl, nowNs)` for `readAt`'s reason —
// eviction order is decided by expiry times, and two writes racing the wall
// clock cannot be ordered deterministically.

// One entry, written against a caller-supplied clock.
fn writeAtNs(s: MemoryStore, sid: string, value: string, ttl: i64, nowNs: i64) {
  s.writeAt(sid, storeData([]string{ "k", value }), ttl, nowNs)
}

test "a write past the cap evicts the oldest-expiring entry instead of failing" {
  let s = MemoryStore(3)
  let t0 = now().ns
  // The ttls are deliberately NOT in write order: "a" is written first and
  // also expires first, but "b" is written second and expires LAST. A store
  // evicting the oldest-WRITTEN entry would agree with this test only by
  // accident, so the ttls are what pick the victim, not the order.
  writeAtNs(s, "a", "1", 3600, t0)
  writeAtNs(s, "b", "2", 7200, t0)
  writeAtNs(s, "c", "3", 5400, t0)
  assert(len(s.entries) == 3, "precondition: the store must be full, got ${len(s.entries)}")

  writeAtNs(s, "d", "4", 9000, t0)

  assert(len(s.entries) == 3, "the cap was crossed: ${len(s.entries)} entries under a cap of 3")
  assert(!isSome(s.readAt("a", t0)), "the oldest-expiring entry must be the one evicted")
  assert(isSome(s.readAt("b", t0)), "b expires last and must survive")
  assert(isSome(s.readAt("c", t0)), "c must survive")
  // The write itself must have landed — an implementation that "bounded" the
  // store by dropping the incoming write would satisfy every line above.
  let got = s.readAt("d", t0)
  assert(isSome(got), "the write past the cap must still land")
  assert(unwrap(got)["k"] == "4", "d: got '${unwrap(got)["k"]}'")
}

test "the entry count never exceeds the cap, however many distinct ids are written" {
  let s = MemoryStore(5)
  let t0 = now().ns
  let i = 0
  while (i < 100) {
    writeAtNs(s, "sid-${i}", "${i}", 3600, t0)
    assert(
      len(s.entries) <= 5,
      "the cap was crossed after ${i + 1} write(s): ${len(s.entries)} entries",
    )
    i = i + 1
  }
  // The other side: a store that bounded itself by holding nothing would
  // pass the loop above.
  assert(len(s.entries) == 5, "a full store must hold its cap, got ${len(s.entries)}")
}

test "at the cap, an expired entry is spent before a live one" {
  // Eviction picks the smallest `expiresAtNs`, and an expired entry has the
  // smallest of all — so "evict the oldest-expiring" reaches a live session
  // only when there is no dead one to take. That is a property of the rule,
  // and this pins it.
  let s = MemoryStore(2)
  let t0 = now().ns
  writeAtNs(s, "dead", "1", 60, t0)
  writeAtNs(s, "live", "2", 3600, t0)
  let later = t0 + 61 * nsPerSecond

  writeAtNs(s, "new", "3", 3600, later)

  assert(len(s.entries) == 2, "the cap was crossed: ${len(s.entries)} entries under a cap of 2")
  assert(isSome(s.readAt("live", later)), "a live session was evicted while a dead one was held")
  assert(isSome(s.readAt("new", later)), "the new entry must be present")
}

test "a write to an id already present replaces it and evicts nothing" {
  // Replacing an entry cannot grow the map, so the cap must not be tested
  // for an id that is already there. The ttls are arranged so the two
  // behaviours differ: "b" expires first, so an implementation that evicted
  // before every write — present or not — would drop "b" here.
  let s = MemoryStore(2)
  let t0 = now().ns
  writeAtNs(s, "a", "1", 7200, t0)
  writeAtNs(s, "b", "2", 3600, t0)

  writeAtNs(s, "a", "9", 7200, t0)

  assert(len(s.entries) == 2, "a replacement must not change the count: ${len(s.entries)}")
  assert(isSome(s.readAt("b", t0)), "replacing 'a' evicted 'b'")
  let got = s.readAt("a", t0)
  assert(isSome(got), "'a' must still be present after its replacement")
  assert(unwrap(got)["k"] == "9", "the replacement must win: got '${unwrap(got)["k"]}'")
}

test "expired entries are swept every Nth write, not held until their id is read again" {
  // The complaint this answers: without a sweeper an id nobody presents
  // again holds its bytes until the process exits, because expiry was only
  // ever noticed on a read of that same id. Nothing reads these three ids
  // after they die; the sweep is the only thing that can remove them.
  let s = MemoryStore(1000)
  let t0 = now().ns
  writeAtNs(s, "dead-a", "1", 60, t0)
  writeAtNs(s, "dead-b", "2", 60, t0)
  writeAtNs(s, "dead-c", "3", 60, t0)

  let later = t0 + 61 * nsPerSecond
  let i = 0
  while (i < memoryStoreSweepEvery - 4) {
    writeAtNs(s, "live-${i}", "${i}", 3600, later)
    i = i + 1
  }

  // The control, one write short of the sweep: the dead entries are still
  // there, so the assertion below is about the sweep and not about expiry
  // having quietly removed them somewhere else.
  assert(
    len(s.entries) == memoryStoreSweepEvery - 1,
    "before the sweep the dead entries must still be held, got ${len(s.entries)}",
  )

  writeAtNs(s, "live-last", "last", 3600, later)

  assert(
    len(s.entries) == memoryStoreSweepEvery - 3,
      "the sweep must have dropped 3 dead entries, leaving " +
      "${memoryStoreSweepEvery - 3}; got ${len(s.entries)}",
  )
}

// A cap below 1 would mean every write evicts the entry it just wrote — a
// store that silently holds nothing. `testpanic_` inverts the verdict (SPEC
// §18.4): these PASS only if the process really dies.
test "testpanic_a_MemoryStore_with_a_cap_of_zero_is_refused" {
  let _ = MemoryStore(0)
}

test "testpanic_a_MemoryStore_with_a_negative_cap_is_refused" {
  let _ = MemoryStore(-1)
}

// The inverse control. Without it both tests above would pass against an
// `init` that panicked unconditionally.
test "a cap of one constructs, and the store then holds exactly one entry" {
  let s = MemoryStore(1)
  let t0 = now().ns
  writeAtNs(s, "a", "1", 3600, t0)
  writeAtNs(s, "b", "2", 3600, t0)
  assert(len(s.entries) == 1, "a cap of 1 must hold exactly one entry, got ${len(s.entries)}")
  assert(isSome(s.readAt("b", t0)), "the most recent write must be the entry that is held")
}

// `testpanic_` reads the child's exit status only and cannot see the
// message, so the text is asserted against the `const` the store panics
// with. That pins what the message says; the two tests above pin that the
// panic fires.
test "the cap refusal names the argument and shows a usable value" {
  assert(
    contains(memoryStoreCapMessage, "maxEntries"),
    "the refusal must name `maxEntries`: '${memoryStoreCapMessage}'",
  )
  assert(
    contains(memoryStoreCapMessage, "MemoryStore(10_000)"),
    "the refusal must show a usable cap: '${memoryStoreCapMessage}'",
  )
}
