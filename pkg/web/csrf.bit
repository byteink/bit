// pkg/web/csrf.bit — the opt-in CSRF middleware (#3948), layer two of two.
//
// Layer one is always on and already shipped: the session cookie carries
// `SameSite=Lax` (session.bit's `Session.cookie`), which every current
// browser enforces against a cross-site form POST at no cost to anyone.
// This file is the part an app asks for, on the groups that serve HTML
// forms:
//
//     let pages = app.group("/")
//     pages.use(csrf())             // HTML forms
//     let api = app.group("/api")   // a bearer-token API: untouched
//
// ## Why opt-in rather than global with exemptions
//
// A global check breaks every JSON client until someone finds the exemption
// switch, and the switch people actually reach for is the app-level one. A
// safe default that is routinely disabled wholesale is less safe than a
// check applied deliberately to the routes that need it. There is therefore
// no per-route exemption flag here and no global default: a group without
// the middleware IS the exemption, and that is visible at the `use()` call
// rather than buried in a config field.
//
// ## The token
//
// `HMAC-SHA256(Config.secret, session id)`, hex. This is the only use
// `Config.secret` has anywhere in the framework (config.bit says so).
//
// It is bound to the SESSION, so a token minted for one visitor is worthless
// to another — that is the property `_csrf` must have and a random per-form
// nonce in a hidden field alone does not. It is derived rather than stored,
// so it needs no second store, no expiry of its own and no cleanup: the
// session id already has all three.
//
// The comparison goes through `constantTimeEq` below and never `==`. A
// byte-by-byte early-return compare on a security token is a timing oracle
// that lets a token be forged one byte at a time.
//
// ## Where a token is read from, and where it is NOT
//
// The `_csrf` form field, or the `X-CSRF-Token` header. NEVER the query
// string: a URL lands in browser history, in `Referer`, in every proxy and
// server access log, and in a screenshot — so a token accepted there is a
// token routinely disclosed. `Ctx.query` is not called anywhere in this
// file, which is what makes that a property of the code rather than a
// promise in a comment.
//
// The body is parsed only when the request declares one of the two content
// types an HTML `<form>` can actually send — `application/x-www-form-
// urlencoded`, and `multipart/form-data` for a form with a file input
// (#4485). A JSON body, or any other, is never scanned for a field it cannot
// contain.
//
// The multipart walk is `std/http`'s `multipartField` (RFC 7578,
// stdlib/http/multipart.bit) — `parseMultipart`'s own walk, entered where
// it costs no copy of a file part nobody wants. This file has no parser of
// its own: a second implementation of a format whose failure mode is
// request smuggling is not something a CSRF check should carry. A body that
// walk refuses is a request with no token, which is the same 403 a missing
// token gets and never a 500.
//
// ## What `Config.maxBody` bounds here, and what it does NOT
//
// The body is read through body.bit's `requestBody`, so the cap that bounds
// `c.body<T>()` bounds what this file will parse — one cap helper in the
// package, not a second one — and an over-cap body is a request with no
// token.
//
// That cap is a limit on what is PARSED, not on what was READ. `std/http`'s
// `readRequestBody` reads a `Content-Length` body with no limit of its own
// (#4565), so the bytes are already resident before any `Ctx` exists. This
// file refusing to parse them is not a defence against an over-large upload,
// and nothing here should be read as claiming one.
//
// ## The refusal
//
// `c.status(403)` — the status and NOTHING else: no body, no header, no
// content type. It is built by the same call for a missing token and for a
// wrong one, so the two responses are byte-identical and the response
// cannot be used as an oracle for which check fired. csrf.test.bit asserts
// that identity field by field on two real `app.handle` responses rather
// than asserting that a body is absent.

import { hmac, newSha256 } from "std/crypto"
import { defaultLimits, multipartField } from "std/http"

// The hidden form field an HTML form carries the token in. The de-facto
// name; not configurable, for `sessionCookieName`'s reason — a name is not
// a security property, and every knob is one an app must have an opinion
// about.
const csrfFieldName = "_csrf"

// The header a fetch/XHR caller carries the token in. Matched
// case-insensitively by `Ctx.header`, as HTTP requires.
const csrfHeaderName = "X-CSRF-Token"

// The two content types whose body is parsed for `csrfFieldName`: exactly
// the two an HTML `<form>` can send, the second being what a form with a
// file input uses.
const csrfUrlencodedContentType = "application/x-www-form-urlencoded"
const csrfMultipartContentType = "multipart/form-data"

// The `Content-Type` parameter that carries the multipart delimiter
// (RFC 7578 §4.1, RFC 2046 §5.1.1). Matched case-insensitively, as HTTP
// requires of a parameter name.
const csrfBoundaryParam = "boundary"

// The status a refused request gets. One status for BOTH failures — absent
// and wrong — through one `c.status()` call, so the two responses are the
// same bytes and the response cannot be used as an oracle for which it was.
// See `csrf`.
const csrfForbidden = 403

// The middleware an HTML group installs. A request that passes the check
// goes on down the chain and this file adds nothing to its response; one
// that fails is answered with `csrfForbidden` here and `next` is never
// called, so the handler does not run.
//
// A MISCONFIGURED app panics rather than being refused: no session store
// (`Config.sessions`) and an empty `Config.secret` are both programming
// errors, and answering them with the same 403 a hostile request gets would
// turn a deployment mistake into a site that is merely, silently broken.
// This is the loudest place the failure can surface — nothing static can
// tell whether a group is ever reached — and it is the same call this
// package already makes for `use()` after `listen()` (app.bit) and `set()`
// after `destroy()` (session.bit).
export fn csrf(): Middleware {
  return (c, next) => {
    let allowed = csrfAllows(c) catch e {
      panic("web: csrf(): ${e.message()}")
    }
    if (!allowed) {
      return c.status(csrfForbidden)
    }
    return next(c)?
  }
}

// Whether this request may proceed. Fails ONLY on misconfiguration, and
// names the `Config` field to fix — a refusal is `false`, never a failure,
// so the two can never be confused by a caller.
//
// A method not in the exempt set is checked, whatever it is: `PUT`,
// `DELETE`, `PATCH` and anything a client invents all go through the same
// path. There is no arm here that names a method to skip.
fn csrfAllows(c: Ctx): bool! {
  if (csrfMethodIsExempt(c.method())) {
    return true
  }
  let expected = csrfExpectedToken(c)?
  // Either carrier is accepted; both are compared over their full length.
  // A request that gets a match from the form field costs one comparison
  // and one that does not costs two — a difference in the count of PUBLIC
  // comparisons, not in where either of them stopped, and the response
  // itself already says which way the request went.
  if (constantTimeEq(csrfFormToken(c), expected)) {
    return true
  }
  return constantTimeEq(c.header(csrfHeaderName), expected)
}

// The methods that carry no check. Exactly the three HTTP defines as safe
// (RFC 9110 §9.2.1) and that a browser will issue cross-site without a
// form: they are the ones a handler must not use to change state, so a
// forged one has nothing to forge.
//
// Compared case-SENSITIVELY on purpose. An HTTP method is a case-sensitive
// token (RFC 9110 §9.1), so `get` is not `GET` — it is an unregistered
// method, and the safe reading of an unregistered method is that it is not
// exempt.
fn csrfMethodIsExempt(method: string): bool {
  return method == "GET" || method == "HEAD" || method == "OPTIONS"
}

// The token this request's session must present, or a failure naming the
// `Config` field that is missing. Never mints anything durable: `session()`
// on a request with no cookie hands back a fresh, unsaved id whose token
// the client cannot have known, so an unauthenticated POST is refused
// without the store being written at all.
fn csrfExpectedToken(c: Ctx): string! {
  return csrfTokenOf(c.config, c.session()?)?
}

// `HMAC-SHA256(secret, session id)`, hex. The one derivation — `Ctx.
// csrfToken` (ctx.bit) and the check above both come through here, so the
// value a form is given and the value the check expects cannot drift.
//
// Hex rather than base64url so the value needs no escaping in an HTML
// attribute, a header or a form body, and has no alphabet variant to get
// wrong. `std/crypto`'s `hmac` is the implementation; this file hashes
// nothing itself.
fn csrfTokenOf(config: Config, session: Session): string! {
  if (len(config.secret) == 0) {
    fail newError(
        "web: csrf(): Config.secret is empty — set it to a high-entropy value the " +
        "app reads from its own environment, for example " +
        "`Config{ secret: mustEnv(\"APP_SECRET\"), sessions: MemoryStore(10_000) }`. " +
        "A CSRF token signed under an empty key is forgeable by anyone.",
    )
  }
  return encodeHex(hmac(newSha256, []byte(config.secret), []byte(session.id())))
}

// The `_csrf` field of the request body, or "" when the body is not a form,
// is over `Config.maxBody`, does not parse, carries no such field, or the
// field is empty. Never fails: every one of those is an ordinary refused
// request, not an error — a malformed multipart body included, which is
// therefore a 403 and never a 500.
fn csrfFormToken(c: Ctx): string {
  let raw = c.header(contentTypeName)
  let media = mediaTypeOf(raw)
  if (!csrfIsFormBody(media)) {
    return ""
  }
  // body.bit's cap helper rather than a second one, so the body this file
  // parses is bounded by the same `Config.maxBody` as every other read in
  // the package. See the file header for what that cap does and does not
  // bound.
  let body = requestBody(c) catch _ {
    return ""
  }
  if (media == csrfMultipartContentType) {
    return csrfMultipartToken(body, raw, c.config.maxBody)
  }
  let (v, ok) = parseQuery(body)[csrfFieldName]
  if (ok) {
    return v
  }
  return ""
}

// Whether `media` — a `Content-Type` media type, already stripped of its
// parameters and folded to lower case by body.bit's `mediaTypeOf` — is a
// form body this file reads the token out of.
//
// Both of the two an HTML `<form>` can send are accepted. `multipart/form-
// data` is here because a form with a file input sends nothing else, and
// refusing it would mean every upload page had to carry `X-CSRF-Token` with
// no way for the developer to see why (the refusal is deliberately silent).
// Anything else — a JSON body, a bare upload — is not scanned at all: a
// field cannot be found in a body that has no field syntax.
fn csrfIsFormBody(media: string): bool {
  return media == csrfUrlencodedContentType || media == csrfMultipartContentType
}

// The `_csrf` text field of a `multipart/form-data` body, or "" when the
// boundary is missing or malformed, the body does not parse, or no part
// carries that name.
//
// `std/http`'s `multipartField` does the walk. It refuses the WHOLE body on
// the first problem and never answers out of a partly-read one, so nothing
// here has to decide what a half-read body means: it is a request with no
// token. `found` is dropped because an absent field and a present-but-empty
// one are the same thing to this check — neither is a token — and `""` is
// what `csrfFormToken` returns for both.
//
// The limits are std/http's own defaults with both byte ceilings pulled down
// to `Config.maxBody`. `maxFileBytes` matters as much as `maxBodyBytes`: at
// its 10 MiB default, an app that raised `maxBody` past that would have its
// legitimate uploads refused here and get a 403 it did not ask for.
//
// #4581 removed what this used to cost. `parseMultipart` built the whole
// `Form`, so an upload was copied out of the body to find a 64-byte token
// that is never in it; `multipartField` runs the same walk, applies the same
// limits to the same parts, and materialises only the field it returns.
fn csrfMultipartToken(body: string, contentType: string, maxBody: i64): string {
  let limits = defaultLimits()
  limits.maxBodyBytes = maxBody
  limits.maxFileBytes = maxBody
  let (value, _) = multipartField(
    []byte(body), csrfBoundaryOf(contentType), csrfFieldName, limits,
  ) catch _ {
    return ""
  }
  return value
}

// The `boundary` parameter of a `Content-Type` value, or "" when there is
// none. An empty or malformed result is not special-cased here: std/http's
// own `validBoundary` refuses it, which is one rejection site rather than
// two that could disagree.
//
// Splitting on `;` is safe because RFC 2046 §5.1.1's boundary alphabet
// contains no `;`, so a value this splits wrongly is one that gets refused
// there rather than one that gets accepted here. The FIRST `=` separates the
// name from the value: `=` IS a legal boundary byte, so `boundary=a=b` must
// keep its `a=b`.
fn csrfBoundaryOf(contentType: string): string {
  let params = split(contentType, ";")
  // From 1: index 0 is the media type, which carries no parameter.
  let i = 1
  while (i < len(params)) {
    let p = trimSpace(params[i])
    let eq = indexOf(p, "=")
    if (eq > 0 && toLower(p[0:eq]) == csrfBoundaryParam) {
      return csrfUnquote(trimSpace(p[eq + 1:len(p)]))
    }
    i = i + 1
  }
  return ""
}

// A parameter value with its surrounding quotes removed, if it has a pair of
// them. There is no escape to decode: RFC 2046's boundary alphabet contains
// neither `"` nor `\`, so a quoted boundary is exactly its bytes and a value
// carrying anything else is refused by `multipartField`.
fn csrfUnquote(v: string): string {
  let n = len(v)
  if (n >= 2 && v[0] == '"' && v[n - 1] == '"') {
    return v[1:n - 1]
  }
  return v
}

// Constant-time string equality: the full length is always scanned, so the
// time taken does not say WHERE two values first differed. `==` may stop at
// the first differing byte, and that timing oracle is enough to forge a
// token one byte at a time.
//
// This is `std/crypto`'s `ctEq` over `[]byte`, and csrf.test.bit asserts the
// two agree. It is written out here rather than delegated for one reason:
// the every-byte property is not observable from outside a function that
// returns only a `bool`, so the loop below reports its own comparison count
// and `constantTimeEq` discards it. That count is `len(a)` whenever the
// lengths match, whatever the contents — which is exactly the invariant, and
// exactly what the test asserts.
fn constantTimeEq(a: string, b: string): bool {
  let (equal, _) = constantTimeEqCounted(a, b)
  return equal
}

// `(equal, bytes compared)`. The count is public information — it is
// `len(a)` for every equal-length pair and 0 for a length mismatch, and
// depends on nothing secret.
//
// The length check is the one length-dependent branch, and it leaks only a
// length. A token's length is fixed by the hash, so an attacker learns
// nothing from it that the algorithm did not already tell them.
fn constantTimeEqCounted(a: string, b: string): (bool, int) {
  let x = []byte(a)
  let y = []byte(b)
  if (len(x) != len(y)) {
    return false, 0
  }
  let acc: byte = 0
  let i = 0
  while (i < len(x)) {
    acc = acc | (x[i] ^ y[i])
    i = i + 1
  }
  return acc == 0, i
}
