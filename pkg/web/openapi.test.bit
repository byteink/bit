// pkg/web/openapi.test.bit — #6075's acceptance: a small app, path params,
// a request body and two response statuses (one success, one error),
// rendered by `App.openApi()` and read back off the real `Json` tree —
// never off a re-serialized string, so a test failure names the exact key
// that is wrong instead of a diff of two documents.
//
// `jsonGet`/`jsonAsObject`/`jsonAsArray`/`jsonAsString`/`jsonAsInt` are
// already imported module-wide by res.test.bit/errors.test.bit; `unwrap`/
// `isSome` by ctx.bit; `contains` by router.test.bit — reused here, not
// re-imported (E0042). `testApp()` (app.test.bit), `okHandler`
// (router.test.bit) and `field(j, key)` (tracing.test.bit) are already
// bound module-wide too. `jsonAsBool` and `hasPrefix` are new to this
// module — bound here, once, the same way `validate.bit` binds
// `runeCount`.

import { jsonAsBool } from "std/json"
import { hasPrefix } from "std/strings"

@json class ArticleView {
  id: string,
  title: string,
  tags: []string,
}

@json class CreateArticleInput {
  title: string,
  body: string,
}

@json class ErrorBody {
  message: string,
}

fn getArticle(c: Ctx): Res! {
  return c.json(ArticleView{ id = c.param("id"), title = "", tags = []string(0) })
}

fn createArticle(c: Ctx): Res! {
  let input = c.body<CreateArticleInput>()?
  return c.json(ArticleView{ id = "1", title = input.title, tags = []string(0) }).status(201)
}

// One field of every kind `.requestBody()`/`.responds()` are asked to
// document: a path param, a request body, a success response and an error
// response — the shapes the ticket's acceptance names.
fn articlesApp(): App {
  let app = testApp()
  app.get("/health", okHandler)
  let show = app.get("/articles/:id", getArticle)
  show.responds(200, ArticleView{ id = "", title = "", tags = []string(0) })
  show.responds(404, ErrorBody{ message = "" })
  let create = app.post("/articles", createArticle)
  create.requestBody(CreateArticleInput{ title = "", body = "" })
  create.responds(201, ArticleView{ id = "", title = "", tags = []string(0) })
  return app
}

test "openApi() fails before the router is frozen" {
  let app = testApp()
  app.get("/x", okHandler)
  let failed = false
  let msg = ""
  app.openApi(OpenApiInfo{ title = "x", version = "1.0.0", description = "" }) catch e {
    failed = true
    msg = e.message()
    Json.JsonNull
  }
  assert(failed, "openApi() must fail before freeze()")
  assert(contains(msg, "not frozen"), "expected an unfrozen-router message, got: ${msg}")
}

test "openApi() renders openapi/info and a 3.1.x version" {
  let app = articlesApp()
  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  let doc = app.openApi(OpenApiInfo{ title = "Inkwell", version = "1.0.0", description = "A blogging API" }) catch e {
    panic("openApi: ${e.message()}")
  }
  let version = unwrap(jsonAsString(field(doc, "openapi")))
  assert(hasPrefix(version, "3.1."), "expected a 3.1.x OpenAPI version, got ${version}")
  let title = unwrap(jsonAsString(field(field(doc, "info"), "title")))
  assert(title == "Inkwell", "info.title must be the app's own title")
}

test "a route with a path param documents a required string path parameter" {
  let app = articlesApp()
  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  let doc = app.openApi(OpenApiInfo{ title = "x", version = "1", description = "" }) catch e {
    panic("openApi: ${e.message()}")
  }
  let paths = field(doc, "paths")
  let item = field(paths, "/articles/{id}")
  let op = field(item, "get")
  let params = unwrap(jsonAsArray(field(op, "parameters")))
  assert(len(params) == 1, "expected exactly one path parameter, got ${len(params)}")
  let p = params[0]
  assert(unwrap(jsonAsString(field(p, "name"))) == "id", "the parameter must be named 'id'")
  assert(unwrap(jsonAsString(field(p, "in"))) == "path", "the parameter must be in 'path'")
  assert(unwrap(jsonAsBool(field(p, "required"))), "a matched path segment is always required")
}

test "requestBody() documents the real CreateArticleInput fields, no hand duplicate" {
  let app = articlesApp()
  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  let doc = app.openApi(OpenApiInfo{ title = "x", version = "1", description = "" }) catch e {
    panic("openApi: ${e.message()}")
  }
  let op = field(field(field(doc, "paths"), "/articles"), "post")
  let body = field(op, "requestBody")
  assert(unwrap(jsonAsBool(field(body, "required"))), "a declared request body is required")
  let schema = field(field(field(body, "content"), "application/json"), "schema")
  assert(unwrap(jsonAsString(field(schema, "type"))) == "object", "the body schema's top type must be object")
  let props = field(schema, "properties")
  assert(
      unwrap(jsonAsString(field(field(props, "title"), "type"))) == "string",
      "CreateArticleInput.title is a string field",
  )
  assert(
      unwrap(jsonAsString(field(field(props, "body"), "type"))) == "string",
      "CreateArticleInput.body is a string field",
  )
}

test "responds() documents a success and an error status, each with its own schema" {
  let app = articlesApp()
  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  let doc = app.openApi(OpenApiInfo{ title = "x", version = "1", description = "" }) catch e {
    panic("openApi: ${e.message()}")
  }
  let op = field(field(field(doc, "paths"), "/articles/{id}"), "get")
  let responses = field(op, "responses")
  let ok = field(responses, "200")
  assert(unwrap(jsonAsString(field(ok, "description"))) == "OK", "200 must describe as OK")
  let notFound = field(responses, "404")
  assert(
      unwrap(jsonAsString(field(notFound, "description"))) == "Not Found",
      "404 must describe as Not Found",
  )
  let errSchema = field(field(field(notFound, "content"), "application/json"), "schema")
  let _ = field(field(errSchema, "properties"), "message")
}

test "a route with no responds() still gets a schema-valid default 200" {
  let app = articlesApp()
  app.freeze() catch e {
    panic("freeze: ${e.message()}")
  }
  let doc = app.openApi(OpenApiInfo{ title = "x", version = "1", description = "" }) catch e {
    panic("openApi: ${e.message()}")
  }
  let op = field(field(field(doc, "paths"), "/health"), "get")
  let responses = jsonAsObject(field(op, "responses"))
  assert(len(unwrap(responses)) == 1, "an undocumented route documents exactly the one default response")
  let ok = field(field(op, "responses"), "200")
  assert(unwrap(jsonAsString(field(ok, "description"))) == "OK", "the default response describes as OK")
}
