// pkg/web/recover.test.bit — #3951's acceptance.
//
// `RecordingSink`/`newSink`/`sinkText`/`adapterApp`/`req`/`freezeOrPanic`
// (adapter.test.bit) and `okHandler` (router.test.bit) are already declared
// in this module — an import/declaration binds per MODULE, not per file
// (SPEC §17.1), and every test file here is part of pkg/web's module — so
// redeclaring any of them would be E0042.
//
// EVERY TEST HERE CALLS `app.handle(req(...))` AND KEEPS RUNNING AFTERWARD.
// That is the proof this ticket asks for that is easy to get by accident:
// `bit test`'s `testpanic_` prefix inverts the verdict of a whole CHILD
// PROCESS (adapter.test.bit's own panic test uses it, for a handler with NO
// `recover()` installed — a panic must still abort when nobody caught it).
// A test that reaches its own `assert` calls after a panicking handler is
// itself the demonstration that the panic did not take the worker down: an
// aborting process would never run them, so a false pass here is not
// possible the way it would be if this asserted on a `testpanic_` exit code
// instead of on a returned `Response`.

fn panicHandler(c: Ctx): Res! {
  panic("db: connection to 10.0.0.9:5432 refused")
}

test "a panicking handler behind recover() yields 500, message logged, not sent, worker still serving" {
  let sink = newSink()
  let app = adapterApp(sink)
  app.use(recover())
  app.get("/boom", panicHandler)
  app.get("/ok", okHandler)
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/boom?trace=1"))

  assert(res.status == 500, "want 500, got ${res.status}")
  assert(
    !contains(res.body, "10.0.0.9"),
    "the panic message must NOT reach the client, body was '${res.body}'",
  )

  let logged = sinkText(sink)
  assert(
    contains(logged, "db: connection to 10.0.0.9:5432 refused"),
    "the panic message must be logged: '${logged}'",
  )
  assert(contains(logged, "GET"), "the log line must carry the method: '${logged}'")
  assert(contains(logged, "/boom"), "the log line must carry the path: '${logged}'")

  // The SAME worker, right after the panic: a boundary that left the task
  // wedged, or that only worked once, would fail this and not the assertion
  // above.
  let second = app.handle(req("GET", "/ok"))
  assert(
    second.status == 200,
    "a request after the panic must be served normally, got ${second.status}",
  )
}

test "recover() outermost also catches a panic raised by a later middleware" {
  let sink = newSink()
  let app = adapterApp(sink)
  app.use(recover())
  app.use((c, next) => {
    panic("middleware exploded")
  })
  app.get("/mid", okHandler)
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/mid"))

  assert(res.status == 500, "want 500, got ${res.status}")
  assert(
    !contains(res.body, "middleware exploded"),
    "the panic message must NOT reach the client, body was '${res.body}'",
  )
  assert(
    contains(sinkText(sink), "middleware exploded"),
    "the panic message must be logged: '${sinkText(sink)}'",
  )
}

test "recover() leaves an ordinary fail behaving exactly as it did without it" {
  let sink = newSink()
  let app = adapterApp(sink)
  app.use(recover())
  app.get("/fail", (c) => rethrow(newError("plain failure")))
  freezeOrPanic(app)

  let res = app.handle(req("GET", "/fail"))

  assert(res.status == 500, "want 500, got ${res.status}")
  assert(!contains(res.body, "plain failure"), "body leaked the message: '${res.body}'")
  assert(contains(sinkText(sink), "plain failure"), "logged: '${sinkText(sink)}'")
}
