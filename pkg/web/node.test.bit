// pkg/web/node.test.bit — the tree and `render` (#3887's own acceptance): a
// mixed attributes+children tree renders to an exact markup string, and a
// benchmark reports the allocation count of rendering a ~200-node tree so a
// future regression is visible.

import { exists, mkdir, readFile, writeFile } from "std/fs"
import { envOr } from "std/os"

test "renders a tree mixing attributes and children to exact markup" {
  let tree = div(
    Node.Attr("class", "card"),
    a(Node.Attr("href", "/x"), text("Link")),
    text(" trailing"),
  )
  let out = render(tree)
  assert(out == "<div class=\"card\"><a href=\"/x\">Link</a> trailing</div>", "got: ${out}")
}

test "el() builds an element with a dynamic tag name" {
  let out = render(el("nav", Node.Attr("aria-label", "main"), text("Home")))
  assert(out == "<nav aria-label=\"main\">Home</nav>", "got: ${out}")
}

test "attributes and children each keep their own source order" {
  let out = render(
    div(
      Node.Attr("id", "first"),
      text("a"),
      Node.Attr("class", "second"),
      text("b"),
    ),
  )
  assert(out == "<div id=\"first\" class=\"second\">ab</div>", "got: ${out}")
}

test "an Attr's value is HTML-escaped even without url() or text()" {
  let out = render(div(Node.Attr("title", "a \"quote\" & more")))
  assert(out == "<div title=\"a &quot;quote&quot; &amp; more\"></div>", "got: ${out}")
}

// --- allocation benchmark (#3887's acceptance: "a future regression is
// visible") -----------------------------------------------------------------
//
// GC allocation counts are only observable from OUTSIDE a process: the
// runtime prints `[bit-gc] ... swept=N live=N` to stderr, gated on
// `BIT_GC_STATS=1` (runtime/stw/stwstats.bit) — there is no in-process
// introspection call. So this builds a small standalone fixture as a real
// subprocess with `BIT_GC_STATS=1`, the same technique
// stdlib/compress/bench.test.bit uses for `gzip`. `pkg/web` is not `std/*`,
// so the fixture cannot just `import` it the way that test imports
// "std/compress" — instead this copies the REAL `node.bit`/`escape.bit`
// source into a scratch module alongside a generated `main.bit`, so the
// measurement exercises the actual implementation, not a stand-in.
//
// `BIT_BIN`/`BIT_STDLIB`/`BIT_REPO` are exactly the env `test-package-web`'s
// own Gate sets (tools/build/gates.bit's `packageGates()`), inherited down
// to this test process because `packagesgate.bit` shells to `bit test <dir>`
// with no env clearing. A developer running `bit test pkg/web` by hand from
// the repo root is covered by the cwd-relative fallback; anything else
// degrades to a skip, never a failure — same contract as compress's own
// `locateBit`.

class BitLocation {
  bin: string,
  stdlib: string,
  repo: string,
}

fn locateBit(): BitLocation {
  let bin = envOr("BIT_BIN", "")
  let stdlib = envOr("BIT_STDLIB", "")
  let repo = envOr("BIT_REPO", "")
  let fromEnv = len(bin) > 0 && exists(bin) && len(stdlib) > 0 && exists(stdlib)
  fromEnv = fromEnv && len(repo) > 0 && exists("${repo}/pkg/web/node.bit")
  if (fromEnv) {
    return BitLocation{ bin: bin, stdlib: stdlib, repo: repo }
  }
  if (exists("bit-out/bin/bit") && exists("stdlib") && exists("pkg/web/node.bit")) {
    return BitLocation{ bin: "bit-out/bin/bit", stdlib: "stdlib", repo: "." }
  }
  return BitLocation{ bin: "", stdlib: "", repo: "" }
}

// Nonce'd per call (bitlang-ws/CLAUDE.md: `$TMPDIR` is shared by every
// concurrent agent, and a plain name is the bug this rule exists for).
fn scratchDir(tag: string): string {
  return "${envOr("TMPDIR", "/tmp")}/bit-pkgweb-${tag}-${timeUnixNs()}"
}

// Writes `script` to `path`, makes it executable, and runs it through
// /bin/sh — same shape stdlib/compress/deflate.test.bit's own `shellRun`
// uses.
fn shellRun(path: string, script: string, timeoutMs: int): int {
  writeFile(path, script) catch _ {
    return -999
  }
  if (fsChmod(path, 448) != 0) { // 0o700: owner rwx only
    return -998
  }
  return osRunBounded(path, timeoutMs)
}

// The fixture's own `main.bit`: builds a table of `rows` rows, two `<td>`
// cells each, and renders it. `table + rows*(tr + 2*td + 2*text)` — at
// `rows = 40` that is `1 + 40*5 = 201` nodes, the "~200-node tree" the
// ticket's acceptance names. `\${...}` (escaped `$`) is deliberate: this is
// a Bit string LITERAL held by the test, and the `${i}` inside it must
// interpolate in the GENERATED program, not in this one.
fn benchFixtureMain(): string {
  return "fn main(): ()! {\n" +
    "  let rows = 40\n" +
    "  let items = []Node(0)\n" +
    "  let i = 0\n" +
    "  while (i < rows) {\n" +
    "    items = append(\n" +
    "      items,\n" +
    "      el(\"tr\", el(\"td\", text(\"row \${i}\")), el(\"td\", text(\"value \${i}\"))),\n" +
    "    )\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  let tree = el(\"table\", ...items)\n" +
    "  let out = render(tree)\n" +
    "  println(\"\${len(out)}\")\n" +
    "  return\n" +
    "}\n"
}

fn writeFixtureModule(loc: BitLocation, dir: string) {
  let nodeSrc = readFile("${loc.repo}/pkg/web/node.bit") catch e {
    panic("bench: read node.bit: ${e.message()}")
  }
  let escapeSrc = readFile("${loc.repo}/pkg/web/escape.bit") catch e {
    panic("bench: read escape.bit: ${e.message()}")
  }
  writeFile("${dir}/node.bit", nodeSrc) catch e {
    panic("bench: write node.bit: ${e.message()}")
  }
  writeFile("${dir}/escape.bit", escapeSrc) catch e {
    panic("bench: write escape.bit: ${e.message()}")
  }
  writeFile("${dir}/main.bit", benchFixtureMain()) catch e {
    panic("bench: write main.bit: ${e.message()}")
  }
}

// Finds the first `key` followed by decimal digits in `s`, or -1 — same
// shape stdlib/compress/bench.test.bit's own `intAfter`/`digitsAt` use to
// read a `BIT_GC_STATS` summary line.
fn intAfter(s: string, key: string): int {
  let klen = len(key)
  let i = 0
  while (i + klen <= len(s)) {
    if (s[i:i + klen] == key) {
      return digitsAt(s, i + klen)
    }
    i = i + 1
  }
  return 0 - 1
}

fn digitsAt(s: string, start: int): int {
  let j = start
  let v = 0
  let digits = 0
  while (j < len(s) && s[j] >= byte('0') && s[j] <= byte('9')) {
    v = v * 10 + (int(s[j]) - int(byte('0')))
    digits = digits + 1
    j = j + 1
  }
  if (digits == 0) {
    return 0 - 1
  }
  return v
}

// Builds and runs the fixture with `BIT_GC_STATS=1`, returning its
// `swept+live` object count.
fn buildAndMeasureAlloc(loc: BitLocation): int {
  let dir = scratchDir("nodebench")
  mkdir(dir) catch e {
    panic("bench: mkdir ${dir}: ${e.message()}")
  }
  writeFixtureModule(loc, dir)
  let prog = "${dir}/fixture"
  let buildScript = "#!/bin/sh\nset -e\nBIT_STDLIB='${loc.stdlib}'\nexport BIT_STDLIB\n" +
    "'${loc.bin}' build '${dir}' -o '${prog}'\n"
  let buildCode = shellRun("${dir}/build.sh", buildScript, 60000)
  if (buildCode != 0) {
    panic("bench: building the fixture exited ${buildCode} — see ${dir}")
  }
  let runScript = "#!/bin/sh\nBIT_GC_STATS=1\nexport BIT_GC_STATS\n" +
    "exec '${prog}' > '${dir}/out.txt' 2> '${dir}/err.txt'\n"
  let runCode = shellRun("${dir}/run.sh", runScript, 30000)
  if (runCode != 0) {
    panic("bench: running the fixture exited ${runCode} — see ${dir}")
  }
  let err = readFile("${dir}/err.txt") catch _ {
    ""
  }
  let swept = intAfter(err, "swept=")
  let live = intAfter(err, "live=")
  if (swept < 0 || live < 0) {
    panic("bench: no 'swept=N live=N' summary in ${dir}/err.txt (got: ${err})")
  }
  return swept + live
}

test "rendering a ~200-node tree reports its allocation count" {
  let loc = locateBit()
  if (len(loc.bin) == 0 || len(loc.repo) == 0) {
    println(
        "pkg/web bench: no usable bit binary + BIT_STDLIB + BIT_REPO found " +
        "(run via ./make test-package-web, or set BIT_BIN/BIT_STDLIB/BIT_REPO) — skipping",
    )
    return
  }
  let objects = buildAndMeasureAlloc(loc)
  println("pkg/web bench: rendering a 201-node tree allocated ${objects} objects (swept+live)")
  assert(objects > 0, "pkg/web bench: expected at least one allocation, got ${objects}")
  // Generous on purpose — a regression tripwire against an accidental
  // per-byte or per-attribute-escape allocation creeping into render()'s
  // hot path, not a tight pin.
  assert(
    objects < 5000,
    "pkg/web bench: ${objects} objects for a 201-node tree looks like a regression",
  )
}
