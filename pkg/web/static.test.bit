// pkg/web/static.test.bit — #3954's acceptance, one named test per assertion.
//
// Everything goes through `app.handle(req)`, the seam #3885 established: the
// real router, the real composed chain, the real `Ctx` and the real failure
// mapping, with only the socket left out. Calling the middleware value
// directly would pass just as well against a mount wired to the wrong prefix.
//
// THE FIXTURE IS SHAPED FOR THE SECURITY CLAIM. The served root is
// `<scratch>/public`, and its PARENT holds `secret.txt`, whose content is
// `sentinelBody`. Every rejection test asserts both the 404 and that
// `sentinelBody` is nowhere in the response — so "no filesystem read outside
// the root" is not asserted by reading the source, it is asserted by the
// fact that a read outside the root would be visible in the body. That the
// guard is what prevents it is proved by deleting the guard: with the
// `safePath` call removed from `staticServe`, `serves-a-traversal` returns
// 200 carrying `sentinelBody`. The four mutations are recorded on #3954.
//
// `contains` (router.test.bit), `mkdir`/`writeFile`/`readFile` (node.test.bit),
// `scratchDir` (node.test.bit), `freezeOrPanic` (adapter.test.bit) and
// `Request` (ctx.bit) are already bound module-wide — reused, never
// re-imported (E0042).
import { isSymlink } from "std/fs"
import { run } from "std/os"

const sentinelBody = "SENTINEL-OUTSIDE-THE-ROOT-DO-NOT-SERVE"
const cssBody = "body { color: red }\n"
const cssType = "text/css; charset=utf-8"
const truncationBait = "TRUNCATED-AT-THE-NUL"
const fallthroughBody = "fell-through"
const mountPrefix = "/assets"

// RFC 9110 §5.6.7's own example date, and the Unix second it names.
const sampleHttpDate = "Sun, 06 Nov 1994 08:49:37 GMT"
const sampleUnixSec: i64 = 784111777

// The scratch parent, the root served below it, and an App with the mount
// plus a catch-all route under it — the wiring #3954 shipped with, kept
// because the catch-all is the fall-through every "static declined" test
// asserts against. `staticAppNoRoutes` below is the same mount with NO route
// at all, which is what #4515 made work.
class StaticFixture {
  dir: string,
  root: string,
  app: App,
}

fn mustMkdir(path: string) {
  mkdir(path) catch e {
    panic("static.test: mkdir ${path}: ${e.message()}")
  }
}

fn writeFixture(path: string, content: string) {
  writeFile(path, content) catch e {
    panic("static.test: write ${path}: ${e.message()}")
  }
}

// `<scratch>/secret.txt` (the sentinel, OUTSIDE the root), `<scratch>/public`
// (the root) holding `app.css`, `data.bin`, the bare name `a`, an empty
// `sub/` directory and `nested/page.css`. `a` is not decoration: it is the
// file a path truncated at a NUL byte would resolve to, so the NUL test can
// prove the truncation hazard is real rather than assert an ENOENT that
// would happen anyway. `nested/page.css` is the positive control for the
// per-component symlink walk (#4517): a real intermediate directory must
// still be served through.
fn newStaticFixture(tag: string): StaticFixture {
  let dir = scratchDir(tag)
  mustMkdir(dir)
  writeFixture("${dir}/secret.txt", sentinelBody)
  let root = "${dir}/public"
  mustMkdir(root)
  writeFixture("${root}/app.css", cssBody)
  writeFixture("${root}/data.bin", "\x01\x02\x03")
  writeFixture("${root}/a", truncationBait)
  mustMkdir("${root}/sub")
  mustMkdir("${root}/nested")
  writeFixture("${root}/nested/page.css", cssBody)
  return StaticFixture{ dir: dir, root: root, app: staticApp(root) }
}

// `/bin/ln -s`, used rather than a stdlib call because std/fs has no symlink
// creator. The link's existence is asserted, so a missing or failing `ln`
// fails the test loudly instead of turning it into a vacuous pass.
fn mustLink(target: string, link: string) {
  let rc = run("/bin/ln", ["-s", target, link])
  assert(rc == 0, "/bin/ln -s ${target} ${link} exited ${rc} — the fixture could not be built")
  assert(isSymlink(link), "the fixture did not create a symlink at ${link}")
}

// The mount plus every route a test needs the router to match. `/assetsx` is
// the component-boundary case: it shares the mount's bytes and must NOT be
// served from it. The HEAD route is registered through the exported
// `route(method, path, h)` (#4516) — it used to reach through the
// module-private `Group.register`, which an app outside this module cannot
// call, so the middleware's HEAD support was proven only from inside.
fn staticApp(root: string): App {
  let app = App(Config{ secret: "test-secret" })
  app.use(static(mountPrefix, root))
  let _ = app.get("/assets/*path", fallthroughHandler)
  let _ = app.post("/assets/*path", fallthroughHandler)
  let _ = app.get("/assetsx/*path", fallthroughHandler)
  let _ = app.get("/elsewhere", fallthroughHandler)
  let _ = app.route("HEAD", "/assets/*path", fallthroughHandler)
  freezeOrPanic(app)
  return app
}

// The mount and nothing else: no route is registered anywhere in this app.
// `App.use` middleware runs for every request the app answers, a path with
// no route included (#4515), so the mount serves on its own.
fn staticAppNoRoutes(root: string): App {
  let app = App(Config{ secret: "test-secret" })
  app.use(static(mountPrefix, root))
  freezeOrPanic(app)
  return app
}

fn fallthroughHandler(c: Ctx): Res! {
  return c.text(fallthroughBody)
}

fn staticReq(method: string, target: string, headers: string): Request {
  return Request{ method: method, path: target, headers: headers, body: "" }
}

// Asserts the shape every rejection must have: the adapter's own 404, and
// nothing anywhere in the body that came from outside the served root.
fn assertRejected(res: Response, what: string) {
  assert(res.status == 404, "${what}: want 404, got ${res.status}")
  assert(
    !contains(res.body, sentinelBody),
    "${what}: the response carried content from OUTSIDE the served root",
  )
  assert(
    res.body == "Not Found",
    "${what}: body must be the framework's own 404, got '${res.body}'",
  )
}

// --- serving --------------------------------------------------------------

test "serves a file under the mount with its exact bytes and Content-Type" {
  let f = newStaticFixture("serve")

  let res = f.app.handle(staticReq("GET", "/assets/app.css", ""))

  assert(res.status == 200, "want 200, got ${res.status}")
  assert(res.body == cssBody, "want the file's bytes, got '${res.body}'")
  assert(res.contentType == cssType, "Content-Type: got '${res.contentType}'")
  assert(len(res.getHeader("ETag")) > 0, "a served file must carry an ETag")
  assert(len(res.getHeader("Last-Modified")) > 0, "a served file must carry Last-Modified")
}

test "an unknown extension is application/octet-stream and carries nosniff" {
  let f = newStaticFixture("mime")

  let res = f.app.handle(staticReq("GET", "/assets/data.bin", ""))

  assert(res.status == 200, "want 200, got ${res.status}")
  assert(res.contentType == "application/octet-stream", "Content-Type: got '${res.contentType}'")
  assert(
    res.getHeader("X-Content-Type-Options") == "nosniff",
    "nosniff: got '${res.getHeader("X-Content-Type-Options")}'",
  )
}

test "HEAD is served with the file's headers and no body" {
  let f = newStaticFixture("head")

  let res = f.app.handle(staticReq("HEAD", "/assets/app.css", ""))

  assert(res.status == 200, "want 200, got ${res.status}")
  assert(res.body == "", "HEAD must carry no body, got '${res.body}'")
  assert(res.contentType == cssType, "Content-Type: got '${res.contentType}'")
  assert(len(res.getHeader("ETag")) > 0, "HEAD must carry the same ETag a GET would")
}

// --- traversal ------------------------------------------------------------

test "a traversal below the mount is 404 and never reads the parent's sentinel" {
  let f = newStaticFixture("traversal")

  let res = f.app.handle(staticReq("GET", "/assets/../../etc/passwd", ""))
  let up = f.app.handle(staticReq("GET", "/assets/../secret.txt", ""))

  assertRejected(res, "/assets/../../etc/passwd")
  assertRejected(up, "/assets/../secret.txt")
  assert(!contains(res.body, "root:"), "the response carried /etc/passwd content")
}

// The remainder below the mount is itself an absolute path. This is the case
// `path.join(root, rel)` would get wrong — `join` returns its second argument
// whole when that argument is absolute (stdlib/path/path.bit:24), discarding
// the root — which is why static.bit concatenates instead.
test "an absolute path below the mount is 404" {
  let f = newStaticFixture("absolute")

  let res = f.app.handle(staticReq("GET", "/assets//etc/passwd", ""))

  assertRejected(res, "/assets//etc/passwd")
  assert(!contains(res.body, "root:"), "the response carried /etc/passwd content")
}

// The bait file `<root>/a` exists, so this fails only if the NUL is refused:
// a path handed to a syscall truncates at the first NUL, and without the
// check `/assets/a\0b.css` would open `<root>/a` and serve `truncationBait`.
test "a NUL byte in the path is 404, not a read of the truncated name" {
  let f = newStaticFixture("nul")

  let res = f.app.handle(staticReq("GET", "/assets/a\x00b.css", ""))

  assert(res.status == 404, "want 404, got ${res.status}")
  assert(
    !contains(res.body, truncationBait),
    "the NUL truncated the path and served '${res.body}'",
  )
}

test "a directory below the mount is 404, with no listing" {
  let f = newStaticFixture("dir")

  let sub = f.app.handle(staticReq("GET", "/assets/sub", ""))
  let slash = f.app.handle(staticReq("GET", "/assets/", ""))

  assert(sub.status == 404, "/assets/sub: want 404, got ${sub.status}")
  assert(!contains(sub.body, "app.css"), "/assets/sub: the body listed the directory")
  assert(slash.status == 404, "/assets/: want 404, got ${slash.status}")
}

// A symlink is the one traversal `safePath` cannot see, and its own comment
// says so (stdlib/path/path.bit:270). This is the FINAL component: `lstat`
// on the requested path itself sees it.
test "a symlink below the mount is 404 even when its target is readable" {
  let f = newStaticFixture("symlink")
  let link = "${f.root}/link.txt"
  mustLink("${f.dir}/secret.txt", link)

  let res = f.app.handle(staticReq("GET", "/assets/link.txt", ""))

  assertRejected(res, "/assets/link.txt")
}

// The case `lstat` on the final component alone cannot see (#4517): the
// kernel resolves `away` on the way to `secret.txt`, so the final `lstat`
// reports a plain readable file and the sentinel is served from OUTSIDE the
// root. Only a stat of `away` itself refuses it.
test "a symlinked intermediate directory below the mount is 404" {
  let f = newStaticFixture("linkdir")
  mustLink(f.dir, "${f.root}/away")

  let res = f.app.handle(staticReq("GET", "/assets/away/secret.txt", ""))

  assertRejected(res, "/assets/away/secret.txt")
}

// The same escape one level deeper, so the check is a walk of every
// component below the root and not a check of the first one.
test "a symlinked directory two components below the mount is 404" {
  let f = newStaticFixture("linkdeep")
  mustMkdir("${f.root}/hop")
  mustLink(f.dir, "${f.root}/hop/deeper")

  let res = f.app.handle(staticReq("GET", "/assets/hop/deeper/secret.txt", ""))

  assertRejected(res, "/assets/hop/deeper/secret.txt")
}

// The positive control for the walk itself: a real intermediate directory is
// not a symlink, so it must still be served through.
test "a file in a real subdirectory below the mount is served" {
  let f = newStaticFixture("nested")

  let res = f.app.handle(staticReq("GET", "/assets/nested/page.css", ""))

  assert(res.status == 200, "want 200, got ${res.status}")
  assert(res.body == cssBody, "want the file's bytes, got '${res.body}'")
  assert(res.contentType == cssType, "Content-Type: got '${res.contentType}'")
}

// The other positive control, and the reason the walk starts at the served
// root rather than at `/`: components AT OR ABOVE the root are the
// operator's own choice and are never stat'd. Here the root is reached
// through `via`, a symlink — the shape `$TMPDIR` itself has on macOS, where
// `/var` is a symlink to `/private/var`.
test "a root reached through a symlinked parent still serves its files" {
  let dir = scratchDir("linkroot")
  mustMkdir(dir)
  mustMkdir("${dir}/real")
  mustMkdir("${dir}/real/public")
  writeFixture("${dir}/real/public/app.css", cssBody)
  mustLink("${dir}/real", "${dir}/via")
  let app = staticApp("${dir}/via/public")

  let res = app.handle(staticReq("GET", "/assets/app.css", ""))

  assert(res.status == 200, "want 200, got ${res.status}")
  assert(res.body == cssBody, "want the file's bytes, got '${res.body}'")
}

// --- falling through ------------------------------------------------------

test "a POST below the mount falls through to the next handler" {
  let f = newStaticFixture("post")

  let res = f.app.handle(staticReq("POST", "/assets/app.css", ""))

  assert(res.status == 200, "want 200, got ${res.status}")
  assert(res.body == fallthroughBody, "want the next handler, got '${res.body}'")
}

test "a request outside the mount prefix reaches the next handler" {
  let f = newStaticFixture("outside")

  let res = f.app.handle(staticReq("GET", "/elsewhere", ""))

  assert(res.status == 200, "want 200, got ${res.status}")
  assert(res.body == fallthroughBody, "want the next handler, got '${res.body}'")
}

// `/assetsx` starts with the mount's bytes but not with its component, so it
// is outside the mount and must reach the next handler untouched.
test "a path that merely starts with the mount's bytes reaches the next handler" {
  let f = newStaticFixture("boundary")

  let res = f.app.handle(staticReq("GET", "/assetsx/app.css", ""))

  assert(res.status == 200, "want 200, got ${res.status}")
  assert(res.body == fallthroughBody, "want the next handler, got '${res.body}'")
}

// --- conditional requests -------------------------------------------------

test "a second request carrying the ETag gets a 304 with no body" {
  let f = newStaticFixture("etag")
  let first = f.app.handle(staticReq("GET", "/assets/app.css", ""))
  let etag = first.getHeader("ETag")
  assert(len(etag) > 0, "the first response carried no ETag")

  let second = f.app.handle(staticReq("GET", "/assets/app.css", "If-None-Match: ${etag}"))

  assert(second.status == 304, "want 304, got ${second.status}")
  assert(second.body == "", "a 304 must carry no body, got '${second.body}'")
  assert(second.getHeader("ETag") == etag, "a 304 must repeat the ETag")
}

test "a non-matching If-None-Match is served, and ignores If-Modified-Since" {
  let f = newStaticFixture("etagmiss")
  let fresh = f.app.handle(staticReq("GET", "/assets/app.css", ""))
  let lastMod = fresh.getHeader("Last-Modified")

  let headers = "If-None-Match: \"nope\"\r\nIf-Modified-Since: ${lastMod}"
  let res = f.app.handle(staticReq("GET", "/assets/app.css", headers))

  assert(res.status == 200, "want 200 (If-None-Match wins and misses), got ${res.status}")
  assert(res.body == cssBody, "want the file's bytes, got '${res.body}'")
}

test "If-Modified-Since is honoured, and an older date still serves the file" {
  let f = newStaticFixture("ims")
  let first = f.app.handle(staticReq("GET", "/assets/app.css", ""))
  let lastMod = first.getHeader("Last-Modified")
  assert(len(lastMod) > 0, "the first response carried no Last-Modified")

  let same = f.app.handle(staticReq("GET", "/assets/app.css", "If-Modified-Since: ${lastMod}"))
  let older = f.app.handle(
    staticReq("GET", "/assets/app.css", "If-Modified-Since: ${sampleHttpDate}"),
  )

  assert(same.status == 304, "the file's own Last-Modified must give 304, got ${same.status}")
  assert(same.body == "", "a 304 must carry no body, got '${same.body}'")
  assert(older.status == 200, "a 1994 date must serve the file, got ${older.status}")
  assert(older.body == cssBody, "want the file's bytes, got '${older.body}'")
}

// --- the date format itself -----------------------------------------------

test "httpDate emits IMF-fixdate and parseHttpDate reads it back" {
  assert(httpDate(sampleUnixSec) == sampleHttpDate, "httpDate: got '${httpDate(sampleUnixSec)}'")

  let (back, ok) = parseHttpDate(sampleHttpDate)

  assert(ok, "parseHttpDate refused its own output")
  assert(back == sampleUnixSec, "want ${sampleUnixSec}, got ${back}")
}

test "parseHttpDate refuses everything that is not an IMF-fixdate" {
  let (_, empty) = parseHttpDate("")
  let (_, rfc850) = parseHttpDate("Sunday, 06-Nov-94 08:49:37 GMT")
  let (_, noZone) = parseHttpDate("Sun, 06 Nov 1994 08:49:37 UTC")
  let (_, badMonth) = parseHttpDate("Sun, 06 Xxx 1994 08:49:37 GMT")
  let (_, badDay) = parseHttpDate("Sun, 32 Nov 1994 08:49:37 GMT")

  assert(!empty, "an empty string parsed")
  assert(!rfc850, "an RFC 850 date parsed")
  assert(!noZone, "a non-GMT zone parsed")
  assert(!badMonth, "an unknown month name parsed")
  assert(!badDay, "day 32 parsed")
}

// --- #4515: no catch-all route needed -------------------------------------

// The headline example of #3954, working as written: the mount alone, with
// nothing registered on the router at all. Before #4515 this served nothing
// — a path with no route was a 404 built before any middleware ran — and
// static.bit's header documented a catch-all route as required.
test "a mount with no route under it serves a file, and a path outside it is still 404" {
  let f = newStaticFixture("nocatchall")
  let app = staticAppNoRoutes(f.root)

  let res = app.handle(staticReq("GET", "/assets/app.css", ""))
  assert(res.status == 200, "want 200, got ${res.status}")
  assert(res.body == cssBody, "want the file's bytes, got '${res.body}'")
  assert(res.contentType == cssType, "Content-Type: got '${res.contentType}'")

  let outside = app.handle(staticReq("GET", "/elsewhere", ""))
  assert(outside.status == 404, "outside the mount: want 404, got ${outside.status}")

  let missing = app.handle(staticReq("GET", "/assets/nope.css", ""))
  assert(missing.status == 404, "a missing file under the mount: want 404, got ${missing.status}")
}

// The security property is the mount's, not the catch-all route's: with no
// route registered anywhere, a traversal below the mount must still be a 404
// that read nothing outside the served root.
test "a traversal is 404 with no route registered under the mount either" {
  let f = newStaticFixture("nocatchall-traversal")
  let app = staticAppNoRoutes(f.root)

  assertRejected(app.handle(staticReq("GET", "/assets/../secret.txt", "")), "up one")
  assertRejected(app.handle(staticReq("GET", "/assets/../../etc/passwd", "")), "up two")
}

// --- a failing chain --------------------------------------------------------

// The mount plus one route the mount DECLINES, whose handler fails. `static()`
// forwards that failure with `next(c)?` (#4580, was
// `catch e { return rethrow(e) }`).
fn staticFailApp(root: string): App {
  let app = App(Config{ secret: "test-secret" })
  app.use(static(mountPrefix, root))
  let _ = app.get("/elsewhere", (c) => rethrow(newError("downstream blew up")))
  freezeOrPanic(app)
  return app
}

// A request outside the mount runs the rest of the chain, and a failure from
// it must come back out of `static()` unchanged to `failureRes` (adapter.bit)
// — never turned into the mount's own 404, which is what a swallowed failure
// would look like here.
test "a failing chain outside the mount propagates through static() to the adapter's 500" {
  let f = newStaticFixture("failing-chain")
  let app = staticFailApp(f.root)

  let res = app.handle(staticReq("GET", "/elsewhere", ""))

  assert(res.status == 500, "want the adapter's 500, got ${res.status}")
  assert(res.body != fallthroughBody, "the failing handler's route must not have served a body")
}

// The other half: a failure raised INSIDE the mount, by `staticServe`, is
// forwarded with the same `?`. `readFile` is the only thing under
// `staticServe` that fails — every rejection it decides itself is a 404 `Res`,
// not a failure — so the fixture makes one file unreadable.
//
// If this suite is ever run as root the chmod is not enforced, the file reads
// back and this test FAILS on the 200. That is deliberate: a skip would make
// the site look pinned when nothing checked it.
test "a read failure under the mount propagates out of static() as the adapter's 500" {
  let f = newStaticFixture("unreadable")
  let locked = "${f.root}/locked.css"
  writeFixture(locked, cssBody)
  let rc = run("/bin/chmod", ["000", locked])
  assert(rc == 0, "/bin/chmod 000 ${locked} exited ${rc} — the fixture could not be built")

  let res = f.app.handle(staticReq("GET", "/assets/locked.css", ""))

  assert(
    res.status == 500,
    "an unreadable file must fail out to the adapter's 500, got ${res.status}",
  )
  assert(
    !contains(res.body, cssBody),
    "the response must carry no file content, got '${res.body}'",
  )
}
